// v2 namespace reconciler -- verifies that named structural compositions
// are used consistently throughout the module graph.
//
// "Types" in the DAG language are named compositions (namespaces), not
// formal type-theoretic constructs. This stage reconciles how names are
// used with how they're defined:
//
//   - Namespace lookup: `Token` -> has fields `kind`, `span`
//   - Consistency check: `Token { kind: x }` -> does x match TokenKind?
//   - Identity propagation: `char_at(s, pos)` -> result is in String namespace
//   - Coverage validation: does `match` cover all variants in the namespace?
//
// After this pass, every expression has a resolved namespace identity
// (return_type: Node) and all name usages are reconciled with definitions.
//
// Dependency chain:
//   v2.compiler.resolve (ModuleGraph, dependency order)
//     -> v2.compiler.reconcile (reconciled graph, namespace-consistent)
//       -> v2.compiler.emit (target-language files)

module v2.compiler.reconcile

import std.types { SourceSpan }
import v2.std.core {
  Module, Node, ImportNames, ImportAll, ImportSpecific,
  Field, Variant, Param,
  Connective, Conj, Disj,
  Expr, Diagnostic,
  ResourceUse,
  TransportBinding, ServiceConfig, AuthConfig, HeaderDef, EnvDef,
  Error,
  expr_has_self_call, expr_has_non_tail_self_call,
  DeclaredFuncSig, DeclaredFuncEnv,
  ForEach,
  LiteralValue, LitStr, LitInt, LitFloat, LitBool, LitNull,
  BinOpKind, Add, Sub, Mul, Div, Mod,
  BinEq, BinNe, BinLt, BinGt, BinLe, BinGe,
  BinAnd, BinOr, NullCoalesce,
  UnaryOpKind, Not, Neg,
  MatchArm, MatchPattern, FieldInit, NamedArg, StringPart,
  RestBinding, ShellBinding, FileBinding, LocalBinding,
  Text, Interpolation,
  Literal, Var, FieldAccess, Call, MethodCall,
  Match, If, Let, RecordLit, ListLit, BinOp, UnaryOp,
  Lambda, StringInterp, Block, Cast,
  Index, Slice, Return
}
import v2.compiler.resolve { ModuleGraph, ResolvedModule, ResolvedImport }

// =========================================================================
// Typecheck output types
// =========================================================================

type TypedGraph {
  modules: List<TypedModule>
  item_registry: Map<String, ItemInfo>
  diagnostics: List<Diagnostic>
}

// ResolvedFuncSig: function signature with concrete return type (never placeholder).
// Produced by resolve_func_sigs after SCC-aware return type resolution.
type ResolvedFuncSig {
  name: String
  params: List<Param>
  return_type: Node
  is_async: Bool
}

type ResolvedFuncEnv {
  signatures: Map<String, ResolvedFuncSig>
}

// ResolvedGraph: the reconcile-to-emit boundary type.
// Wraps TypedModules whose func_env is ResolvedFuncEnv, making it
// structurally impossible for unresolved signatures to reach emit.
type ResolvedGraph {
  modules: List<TypedModule>
  item_registry: Map<String, ItemInfo>
  diagnostics: List<Diagnostic>
}

type TypedModule {
  module: Module
  items: List<Node>
  type_env: TypeEnv
  func_env: ResolvedFuncEnv
  item_registry: Map<String, ItemInfo>
}

type TypeEnv {
  bindings: Map<String, TypeBinding>
  recursive_types: List<String>
  recursive_type_set: Map<String, Bool>
}

// =========================================================================
// Item registry -- maps item names to their kind and service dependencies.
// Built during typecheck_module and stored on both TypedModule and the
// graph boundary so emitters can consume it directly.
// =========================================================================

type ItemKind = FnItem | FuncItem | TypeItem | DataItem | ServiceItem | OtherItem

type ItemInfo {
  name: String
  kind: ItemKind
  service_names: List<String>
  is_self_recursive: Bool
  has_non_tail_self_call: Bool
}

type ItemContribution {
  resolved_item: Node
  resolve_diagnostics: List<Diagnostic>
  func_sig: DeclaredFuncSig?
  svc_entries: List<OpEntry>
  svc_local: TypeBinding?
  variant_locals: List<TypeBinding>
  item_info: ItemInfo
}

type ModuleContext {
  resolved_items: List<Node>
  func_env: ResolvedFuncEnv
  svc_registry: Map<String, List<OpEntry>>
  locals: Map<String, TypeBinding>
  item_registry: Map<String, ItemInfo>
  diagnostics: List<Diagnostic>
}

// Accumulator for map-based deduplication.
type UniqueAccum {
  seen: Map<String, Bool>
  result: List<String>
}

// Map membership check -- returns true if key is present in the map.
fn emit_map_has(m: Map<String, Bool>, key: String) -> Bool {
  match map_get(m, key) {
    Some { value: _ } => true
    None => false
  }
}

// Typed-receiver versions of service call detection -- for Expr trees.
fn is_typed_service_call_receiver(receiver: Expr) -> Bool {
  match receiver {
    FieldAccess { base: b, field: f, resolved_type: _, span: _ } =>
      match b {
        Var { name: _, resolved_type: _, span: _ } => {
          match f |> chars |> first {
            Some { value: ch } => ch >= "A" && ch <= "Z"
            None => false
          }
        }
        _ => false
      }
    _ => false
  }
}

fn extract_typed_service_name(receiver: Expr) -> String? {
  match receiver {
    FieldAccess { base: b, field: f, resolved_type: _, span: _ } =>
      match b {
        Var { name: ns, resolved_type: _, span: _ } => Some { value: concat(ns, ".", f) }
        _ => none
      }
    _ => none
  }
}

fn collect_typed_service_calls(texpr: Expr) -> List<String> {
  let result = collect_typed_service_calls_into(texpr: texpr, acc: UniqueAccum { seen: empty_map(), result: [] })
  result.result
}

fn collect_typed_service_calls_into(texpr: Expr, acc: UniqueAccum) -> UniqueAccum {
  match texpr {
    MethodCall { receiver: r, method: _, args: a, resolved_type: _, span: _ } => {
      let acc2 = if is_typed_service_call_receiver(receiver: r) {
        match extract_typed_service_name(receiver: r) {
          Some { value: service_name } =>
            if emit_map_has(m: acc.seen, key: service_name) { acc }
            else { UniqueAccum { seen: map_insert(acc.seen, service_name, true), result: list_push(acc.result, service_name) } }
          None => acc
        }
      } else {
        collect_typed_service_calls_into(texpr: r, acc: acc)
      }
      collect_typed_service_calls_from_args_into(args: a, acc: acc2)
    }
    Call { func: _, args: a, resolved_type: _, span: _ } =>
      collect_typed_service_calls_from_args_into(args: a, acc: acc)
    FieldAccess { base: b, field: _, resolved_type: _, span: _ } =>
      collect_typed_service_calls_into(texpr: b, acc: acc)
    If { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: _ } => {
      let acc2 = collect_typed_service_calls_into(texpr: c, acc: acc)
      let acc3 = collect_typed_service_calls_into(texpr: t, acc: acc2)
      match e {
        Some { value: eb } => collect_typed_service_calls_into(texpr: eb, acc: acc3)
        None => acc3
      }
    }
    Let { name: _, value: v, body: b, resolved_type: _, span: _ } => {
      let acc2 = collect_typed_service_calls_into(texpr: v, acc: acc)
      match b {
        Some { value: bd } => collect_typed_service_calls_into(texpr: bd, acc: acc2)
        None => acc2
      }
    }
    Block { stmts: ss, resolved_type: _, span: _ } =>
      ss |> fold(init: acc, f: (a, s) => collect_typed_service_calls_into(texpr: s, acc: a))
    Match { scrutinee: s, arms: arm_list, resolved_type: _, span: _ } => {
      let acc2 = collect_typed_service_calls_into(texpr: s, acc: acc)
      arm_list |> fold(init: acc2, f: (a, arm) => collect_typed_service_calls_into(texpr: arm.body, acc: a))
    }
    BinOp { op: _, left: l, right: r, resolved_type: _, span: _ } => {
      let acc2 = collect_typed_service_calls_into(texpr: l, acc: acc)
      collect_typed_service_calls_into(texpr: r, acc: acc2)
    }
    UnaryOp { op: _, operand: e, resolved_type: _, span: _ } =>
      collect_typed_service_calls_into(texpr: e, acc: acc)
    Lambda { params: _, body: bd, resolved_type: _, span: _ } =>
      collect_typed_service_calls_into(texpr: bd, acc: acc)
    RecordLit { type_name: _, fields: fs, resolved_type: _, span: _ } =>
      fs |> fold(init: acc, f: (a, f) => collect_typed_service_calls_into(texpr: f.value, acc: a))
    ListLit { elements: els, resolved_type: _, span: _ } =>
      els |> fold(init: acc, f: (a, e) => collect_typed_service_calls_into(texpr: e, acc: a))
    Cast { expr: e, target: _, resolved_type: _, span: _ } =>
      collect_typed_service_calls_into(texpr: e, acc: acc)
    StringInterp { parts: ps, resolved_type: _, span: _ } =>
      ps |> fold(init: acc, f: (a, p) => match p {
        Interpolation { expr: e } => collect_typed_service_calls_into(texpr: e, acc: a)
        _ => a
      })
    _ => acc
  }
}

fn collect_typed_service_calls_from_args_into(args: List<NamedArg>, acc: UniqueAccum) -> UniqueAccum {
  args |> fold(init: acc, f: (a, arg) => collect_typed_service_calls_into(texpr: arg.value, acc: a))
}





fn is_recursive_type(env: TypeEnv, name: String) -> Bool {
  match map_get(env.recursive_type_set, name) {
    Some { value: _ } => true
    _ => false
  }
}

type TypeBinding {
  name: String
  resolved: Node
}

type NodeResolveResult {
  resolved: Node
  diagnostics: List<Diagnostic>
}

// =========================================================================
// Expression inference types
// =========================================================================

// Lightweight operation entry for the service registry.
// Only the fields needed for type inference: name + outputs.
type OpEntry {
  name: String
  outputs: List<Field>
}

// Derive outputs from a Node's return_type.
// Outputs live in return_type:
//   - Single output: return_type is the Node directly
//   - Multiple outputs: return_type is Conj Node with field children
//   - No outputs: return_type is none
fn return_type_to_outputs(return_type: Node?, span: SourceSpan) -> List<Field> {
  if return_type == none { [] }
  else {
    let rt = return_type.value
    if rt.connective != none {
      match rt.connective.value {
        Conj =>
          if rt.name == "" {
            // Anonymous product -- expand children as fields
            map(rt.children, child =>
              let child_type = if child.return_type == none { leaf_node(name: child.name) } else { child.return_type.value }
              Field { name: child.name, type_expr: child_type, optional: false, default_value: none, from_key: none, span: span }
            )
          } else {
            [Field { name: "value", type_expr: rt, optional: false, default_value: none, from_key: none, span: span }]
          }
        Disj =>
          [Field { name: "value", type_expr: rt, optional: false, default_value: none, from_key: none, span: span }]
      }
    } else if rt.name == "Unit" && rt.children |> count == 0 {
      []
    } else {
      [Field { name: "value", type_expr: rt, optional: false, default_value: none, from_key: none, span: span }]
    }
  }
}


type InferScope {
  type_env: TypeEnv
  func_env: ResolvedFuncEnv
  locals: Map<String, TypeBinding>
  module_name: String
  service_registry: Map<String, List<OpEntry>>
}

type InferResult {
  typed: Expr
  diagnostics: List<Diagnostic>
}

type BlockInferState {
  scope: InferScope
  diag_chunks: List<List<Diagnostic>>
  last_type: Node
  typed_stmts: List<Expr>
}

// SG-9: Tail-recursive block inference. Each accumulated list is a standalone
// parameter (Rc refcount=1) so list_push avoids deep clone.
fn infer_block_stmts(remaining: List<Expr>, scope: InferScope,
    typed_stmts: List<Expr>, diag_chunks: List<List<Diagnostic>>,
    last_type: Node) -> BlockInferState {
  match remaining |> first {
    None => BlockInferState { scope: scope, diag_chunks: diag_chunks,
                              last_type: last_type, typed_stmts: typed_stmts }
    Some { value: stmt } =>
      let stmt_result = infer_expr(expr: stmt, scope: scope)
      let stmt_typed = stmt_result.typed
      let stmt_diags = stmt_result.diagnostics
      let next_scope = scope_after_stmt_node(
        stmt: stmt,
        stmt_type: stmt_typed.resolved_type.value,
        scope: scope
      )
      infer_block_stmts(
        remaining: remaining |> skip(1),
        scope: next_scope,
        typed_stmts: list_push(typed_stmts, stmt_typed),
        diag_chunks: list_push(diag_chunks, stmt_diags),
        last_type: stmt_typed.resolved_type.value
      )
  }
}

type TypedItemResult {
  item: Node
  diagnostics: List<Diagnostic>
}

type AccessCheckResultNode {
  resolved_type: Node
  diagnostics: List<Diagnostic>
}

type ArmInferResult {
  typed_arm: MatchArm
  diagnostics: List<Diagnostic>
  body_type: Node
}

type PatternScopeResult {
  scope: InferScope
  diagnostics: List<Diagnostic>
}

type NodeLookupResult {
  resolved: Node
  diagnostics: List<Diagnostic>
}

type StringPartInferResult {
  typed_part: StringPart
  diagnostics: List<Diagnostic>
}

type ArgInferResult {
  typed_arg: NamedArg
  diagnostics: List<Diagnostic>
}

type FieldInferResult {
  typed_field: FieldInit
  infer_result: InferResult
  diagnostics: List<Diagnostic>
}

// Internal result type for item-level resolution.
type ItemResult {
  item: Node
  diagnostics: List<Diagnostic>
}

type BuildTypeEnvResult {
  env: TypeEnv
  diagnostics: List<Diagnostic>
}

type ParentModulesResult {
  modules: List<TypedModule>
  diagnostics: List<Diagnostic>
}

// Internal result type for field-level resolution.
type FieldResult {
  field: Field
  diagnostics: List<Diagnostic>
}

type ExprResolveResult {
  expr: Expr
  diagnostics: List<Diagnostic>
}

type NamedArgResolveResult {
  arg: NamedArg
  diagnostics: List<Diagnostic>
}

type MatchArmResolveResult {
  arm: MatchArm
  diagnostics: List<Diagnostic>
}

type FieldInitResolveResult {
  field_init: FieldInit
  diagnostics: List<Diagnostic>
}

type StringPartResolveResult {
  part: StringPart
  diagnostics: List<Diagnostic>
}

type TransportResolveResult {
  transport: TransportBinding
  diagnostics: List<Diagnostic>
}

type ServiceConfigResolveResult {
  config: ServiceConfig
  diagnostics: List<Diagnostic>
}

type AuthConfigResolveResult {
  config: AuthConfig
  diagnostics: List<Diagnostic>
}

type HeaderResolveResult {
  header: HeaderDef
  diagnostics: List<Diagnostic>
}

type EnvDefResolveResult {
  env_def: EnvDef
  diagnostics: List<Diagnostic>
}

// Internal result type for variant-level resolution.
type VariantResult {
  variant: Variant
  diagnostics: List<Diagnostic>
}

// Internal result type for param-level resolution.
type ParamResult {
  param: Param
  diagnostics: List<Diagnostic>
}

// Internal result type for resource-use resolution.
type ResourceUseResult {
  resource_use: ResourceUse
  diagnostics: List<Diagnostic>
}

// Accumulator for cycle detection fold.
type CycleDetectState {
  recursive_names: Map<String, Bool>
  global_visited: Map<String, Bool>
}

// =========================================================================
// Build function environment from module items.
// Extracts signatures from Node items that have params.
// =========================================================================

// Unwrap an optional return type at a function boundary.
// The v1 codegen tracks optionality from field declarations and rejects
// assigning optional values to non-optional struct fields. This function
// boundary resets the tracking.
fn unwrap_return_type(rt: Node?) -> Node {
  if rt == none { leaf_node(name: "Unit") }
  else { rt.value }
}

fn child_return_type_or_name(ch: Node) -> Node {
  if ch.return_type == none { leaf_node(name: ch.name) }
  else { ch.return_type.value }
}

fn service_op_entry(child: Node) -> OpEntry {
  OpEntry { name: child.name, outputs: return_type_to_outputs(return_type: child.return_type, span: child.span) }
}

fn build_func_env(items: List<Node>) -> DeclaredFuncEnv {
  // Called with resolved items (after resolve_item_types), so return_type
  // fields have already been resolved by resolve_optional_node.
  // Stores return_type as-is (None when unannotated) -- no fabrication.
  let sigs = fold(items, init: empty_map(), f: (acc, item) =>
    if item.params |> count > 0 {
      let is_async = item.uses |> count > 0
      map_insert(acc, item.name, DeclaredFuncSig { name: item.name, params: item.params, return_type: item.return_type, is_async: is_async })
    } else {
      acc
    }
  )
  DeclaredFuncEnv { signatures: sigs }
}

// =========================================================================
// Pass B: Fused scope builder (SG-9 safe -- standalone map parameters).
//
// Single walk over resolved_items builds func_sigs, svc_registry,
// svc_locals, and variant_locals simultaneously. Then a single walk
// over imports merges from parents.
// =========================================================================

type InferScopeComponents {
  func_sigs: Map<String, DeclaredFuncSig>
  svc_registry: Map<String, List<OpEntry>>
  svc_locals: Map<String, TypeBinding>
  variant_locals: Map<String, TypeBinding>
}

type LocalContributionState {
  resolved_items: List<Node>
  func_sigs: Map<String, DeclaredFuncSig>
  svc_registry: Map<String, List<OpEntry>>
  svc_locals: Map<String, TypeBinding>
  variant_locals: Map<String, TypeBinding>
  item_registry: Map<String, ItemInfo>
  diag_chunks: List<List<Diagnostic>>
}

fn build_scope_from_items(remaining: List<Node>, env: TypeEnv,
    func_sigs: Map<String, DeclaredFuncSig>,
    svc_registry: Map<String, List<OpEntry>>,
    svc_locals: Map<String, TypeBinding>,
    variant_locals: Map<String, TypeBinding>) -> InferScopeComponents {
  match remaining |> first {
    None => InferScopeComponents {
      func_sigs: func_sigs, svc_registry: svc_registry,
      svc_locals: svc_locals, variant_locals: variant_locals
    }
    Some { value: item } =>
      // func_sigs: items with params -- stores return_type as-is (no fabrication)
      let next_func_sigs = if item.params |> count > 0 {
        let is_async = item.uses |> count > 0
        map_insert(func_sigs, item.name, DeclaredFuncSig { name: item.name, params: item.params, return_type: item.return_type, is_async: is_async })
      } else {
        func_sigs
      }
      // svc_registry + svc_locals: items with transport and children
      let next_svc_registry = if item.transport != none && item.children |> count > 0 {
        let entries = item.children |> map(c => service_op_entry(child: c))
        map_insert(svc_registry, item.name, entries)
      } else {
        svc_registry
      }
      let next_svc_locals = if item.transport != none && item.children |> count > 0 {
        let root = namespace_root_from_properties(properties: item.properties, name: item.name)
        map_insert(svc_locals, root, TypeBinding { name: root, resolved: leaf_node(name: root) })
      } else {
        svc_locals
      }
      // variant_locals: Disj items (recursive types checked from items)
      let next_variant_locals = match item.connective {
        Some { value: Disj } =>
          if is_recursive_type(env: env, name: item.name) {
            fold(item.children, init: variant_locals, f: (vacc, child) =>
              map_insert(vacc, child.name, TypeBinding {
                name: child.name,
                resolved: leaf_node(name: item.name)
              })
            )
          } else {
            variant_locals
          }
        _ => variant_locals
      }
      build_scope_from_items(remaining: remaining |> skip(1), env: env,
        func_sigs: next_func_sigs, svc_registry: next_svc_registry,
        svc_locals: next_svc_locals, variant_locals: next_variant_locals)
  }
}

fn merge_scope_from_imports(remaining: List<ResolvedImport>, parent_index: Map<String, TypedModule>, env: TypeEnv,
    func_sigs: Map<String, DeclaredFuncSig>,
    svc_registry: Map<String, List<OpEntry>>,
    svc_locals: Map<String, TypeBinding>,
    variant_locals: Map<String, TypeBinding>) -> InferScopeComponents {
  match remaining |> first {
    None => InferScopeComponents {
      func_sigs: func_sigs, svc_registry: svc_registry,
      svc_locals: svc_locals, variant_locals: variant_locals
    }
    Some { value: imp } =>
      match map_get(parent_index, imp.module_path) {
        Some { value: typed_parent } =>
          // func_sigs from parent -- convert ResolvedFuncSig to DeclaredFuncSig
          // (wrap return_type in Some) so all sigs share the same map type.
          // Parent sigs always have concrete return types (return_type: Some).
          let next_func_sigs = fold(map_values(typed_parent.func_env.signatures), init: func_sigs, f: (acc, rsig) =>
            let sig_key = rsig.name
            let sig_params = rsig.params
            let sig_rt = rsig.return_type
            let sig_async = rsig.is_async
            map_insert(acc, sig_key, DeclaredFuncSig {
              name: sig_key, params: sig_params,
              return_type: Some { value: sig_rt },
              is_async: sig_async
            })
          )
          // svc_registry + svc_locals + variant_locals from parent items
          let parent_result = fold(typed_parent.items, init: InferScopeComponents {
            func_sigs: next_func_sigs, svc_registry: svc_registry,
            svc_locals: svc_locals, variant_locals: variant_locals
          }, f: (acc, titem) =>
            let r1 = if titem.transport != none && titem.children |> count > 0 {
              let entries = titem.children |> map(c =>
                OpEntry { name: c.name, outputs: return_type_to_outputs(return_type: c.return_type, span: c.span) }
              )
              let root = namespace_root_from_properties(properties: titem.properties, name: titem.name)
              InferScopeComponents {
                func_sigs: acc.func_sigs,
                svc_registry: map_insert(acc.svc_registry, titem.name, entries),
                svc_locals: map_insert(acc.svc_locals, root, TypeBinding { name: root, resolved: leaf_node(name: root) }),
                variant_locals: acc.variant_locals
              }
            } else {
              acc
            }
            match titem.connective {
              Some { value: Disj } =>
                if is_recursive_type(env: env, name: titem.name) {
                  InferScopeComponents {
                    func_sigs: r1.func_sigs, svc_registry: r1.svc_registry,
                    svc_locals: r1.svc_locals,
                    variant_locals: fold(titem.children, init: r1.variant_locals, f: (vacc, child) =>
                      map_insert(vacc, child.name, TypeBinding {
                        name: child.name,
                        resolved: leaf_node(name: titem.name)
                      })
                    )
                  }
                } else {
                  r1
                }
              _ => r1
            }
          )
          merge_scope_from_imports(remaining: remaining |> skip(1), parent_index: parent_index, env: env,
            func_sigs: parent_result.func_sigs, svc_registry: parent_result.svc_registry,
            svc_locals: parent_result.svc_locals, variant_locals: parent_result.variant_locals)
        None =>
          merge_scope_from_imports(remaining: remaining |> skip(1), parent_index: parent_index, env: env,
            func_sigs: func_sigs, svc_registry: svc_registry,
            svc_locals: svc_locals, variant_locals: variant_locals)
      }
  }
}

// =========================================================================
// Service namespace locals
//
// Service names are dotted (e.g., "git.Core", "github.Gist"). Expressions
// reference the namespace root ("git") as a variable. The parser stores
// the namespace root as a structural property on the service Node, so
// downstream stages read it directly instead of string-splitting.
// =========================================================================

// Read the namespace root from a service item's properties.
// The parser stores it as FieldInit { name: "namespace_root", value: LitStr(root) }.
// Falls back to the full name if the property is absent.
// Takes properties and name separately so it works for any Node.
fn namespace_root_from_properties(properties: List<FieldInit>, name: String) -> String {
  match properties |> filter(p => p.name == "namespace_root") |> first {
    Some { value: ns_prop } => match ns_prop.value {
      Literal { value: LitStr { value: root }, span: _ } => root
      _ => name
    }
    None => name
  }
}

// =========================================================================
// Service registry lookups
//
// Service calls use dotted paths (e.g., "git.Core.CurrentBranch()").
// The service_registry maps full service paths to their OpEntry lists.
// FieldAccess checks if base.field is a service path; MethodCall looks up
// the operation and returns its output type.
// =========================================================================

fn check_service_field_access_node(base_type: Node, field: String, scope: InferScope) -> Node? {
  if base_type.connective == none && base_type.children |> count == 0 {
    let path = concat(base_type.name, ".", field)
    match map_get(scope.service_registry, path) {
      Some { value: _ } => Some { value: leaf_node(name: path) }
      None => None
    }
  } else { None }
}

fn check_service_method_call_node(receiver_type: Node, method: String, scope: InferScope) -> Node? {
  if receiver_type.connective == none && receiver_type.children |> count == 0 {
    match map_get(scope.service_registry, receiver_type.name) {
      Some { value: ops } =>
        let matching = ops |> filter(op => op.name == method)
        match matching |> first {
          Some { value: op } =>
            if op.outputs |> count == 0 {
              Some { value: leaf_node(name: "Unit") }
            } else {
              // Always return a record type with named fields so field access
              // (e.g., result.branch) works for both single- and multi-output operations.
              Some { value: Node {
                name: "", span: no_span(),
                children: map(op.outputs, f => Node { name: f.name, span: f.span, children: [], connective: none, params: [], return_type: Some { value: f.type_expr }, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false }),
                connective: Some { value: Conj },
                params: [], return_type: none, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false
              } }
            }
          None => None
        }
      None => None
    }
  } else { None }
}

// =========================================================================
// Expression inference
//
// Assigns a resolved type (Node) to every Expr node in the AST, producing
// Expr values with resolved_type. This is a single top-down pass (not Hindley-Milner);
// .dag has explicit type annotations on params and fields, so inference
// is propagation, not unification.
// =========================================================================

// -------------------------------------------------------------------------
// Helper: construct a no-span sentinel for synthesized types
// -------------------------------------------------------------------------

fn no_span() -> SourceSpan {
  SourceSpan { start: 0, end: 0 }
}

// -------------------------------------------------------------------------
// Node-based constructor helpers
// -------------------------------------------------------------------------

fn leaf_node(name: String) -> Node {
  Node { name: name, span: SourceSpan { start: 0, end: 0 }, children: [], connective: none, params: [], return_type: none, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false }
}

fn optional_node(inner: Node) -> Node {
  Node { name: "Optional", span: SourceSpan { start: 0, end: 0 }, children: [inner, leaf_node(name: "None")], connective: Some { value: Disj }, params: [], return_type: none, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false }
}

fn container_node(kind_name: String, element: Node) -> Node {
  Node { name: kind_name, span: SourceSpan { start: 0, end: 0 }, children: [element], connective: none, params: [], return_type: none, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false }
}

// -------------------------------------------------------------------------
// Helpers for typed expression inference
// -------------------------------------------------------------------------

fn expr_span(expr: Expr) -> SourceSpan {
  match expr {
    Literal { span: s } => s
    Var { span: s } => s
    FieldAccess { span: s } => s
    Call { span: s } => s
    MethodCall { span: s } => s
    Match { span: s } => s
    If { span: s } => s
    Let { span: s } => s
    RecordLit { span: s } => s
    ListLit { span: s } => s
    BinOp { span: s } => s
    UnaryOp { span: s } => s
    Lambda { span: s } => s
    StringInterp { span: s } => s
    Block { span: s } => s
    Cast { span: s } => s
    ForEach { span: s } => s
    Index { span: s } => s
    Slice { span: s } => s
    Return { span: s } => s
    _ => SourceSpan { start: 0, end: 0 }
  }
}

fn ok_infer(texpr: Expr) -> InferResult {
  InferResult {
    typed: texpr,
    diagnostics: []
  }
}

// -------------------------------------------------------------------------
// lookup_in_scope: look up a variable name in lexical locals only.
//
// Function params are installed into locals by build_params_scope().
// -------------------------------------------------------------------------

fn lookup_in_scope(scope: InferScope, name: String) -> Node? {
  match map_get(scope.locals, name) {
    Some { value: binding } => Some { value: binding.resolved }
    None => None
  }
}

fn lookup_field_type_node(n: Node, field_name: String) -> Node? {
  if n.connective != none {
    match n.connective.value {
      Conj =>
        // Product: search children by name
        match n.children |> filter(c => c.name == field_name) |> first {
          Some { value: field_child } =>
            Some { value: child_return_type_or_name(ch: field_child) }
          None => None
        }
      Disj =>
        if n.name == "Optional" {
          // Unwrap Optional and look up in inner
          match n.children |> first {
            Some { value: inner } =>
              match lookup_field_type_node(n: inner, field_name: field_name) {
                Some { value: inner_result } => Some { value: optional_node(inner: inner_result) }
                None => None
              }
            None => None
          }
        } else {
          // Coproduct: find common field across all variants
          lookup_coproduct_common_field_node(variants: n.children, field_name: field_name)
        }
    }
  } else { None }
}

fn lookup_coproduct_common_field_node(variants: List<Node>, field_name: String) -> Node? {
  // A field is "common" if it exists in ALL variants
  let found_in_all = variants |> all(v =>
    v.children |> any(c => c.name == field_name)
  )
  if found_in_all {
    // Return the field type from the first variant that has it
    match variants |> first {
      Some { value: first_variant } =>
        match first_variant.children |> filter(c => c.name == field_name) |> first {
          Some { value: field_child } =>
            Some { value: child_return_type_or_name(ch: field_child) }
          None => None
        }
      None => None
    }
  } else { None }
}

// -------------------------------------------------------------------------
// lookup_func_sig: look up a resolved function signature by name
// -------------------------------------------------------------------------

fn lookup_func_sig(func_env: ResolvedFuncEnv, name: String) -> ResolvedFuncSig? {
  map_get(func_env.signatures, name)
}

// -------------------------------------------------------------------------
// infer_literal: resolve the type of a LiteralValue
// -------------------------------------------------------------------------

fn infer_literal_node(lit: LiteralValue) -> Node {
  match lit {
    LitStr { value: _ } => leaf_node(name: "String")
    LitInt { value: _ } => leaf_node(name: "Int")
    LitFloat { value: _ } => leaf_node(name: "Float")
    LitBool { value: _ } => leaf_node(name: "Bool")
    LitNull => leaf_node(name: "Unit")
  }
}

// -------------------------------------------------------------------------
// infer_binop_type: resolve the result type of a binary operation
// -------------------------------------------------------------------------

// -------------------------------------------------------------------------
// Index/Slice access helpers
// -------------------------------------------------------------------------

fn normalize_access_type_node(n: Node) -> Node {
  if n.name == "Refined" && n.connective != none {
    match n.children |> first {
      Some { value: base } => normalize_access_type_node(n: base)
      None => n
    }
  } else { n }
}

fn normalize_type_name(name: String) -> String {
  // Fast path: most type names are simple identifiers with no < or .
  if name |> string_contains(substring: "<") == false && name |> string_contains(substring: ".") == false {
    name
  } else {
    let base = match name |> split(delimiter: "<") |> first {
      Some { value: part } => part
      None => name
    }
    match base |> split(delimiter: ".") |> last {
      Some { value: short } => short
      None => base
    }
  }
}

// =========================================================================
// Node-based type utility functions
//
// These work on Nodes used as type representations.
//
// A Node-as-type uses:
//   - name: the type's name
//   - connective: Conj (product/record), Disj (coproduct/sum), none (leaf)
//   - children: fields or variants
//   - return_type: the field's type (for field children) or container element
//   - properties: metadata (container_kind, optional, map_type)
// =========================================================================

// Check if a type-Node represents a container type.
fn node_is_container(n: Node) -> Bool {
  n.properties |> any(p => p.name == "container_kind")
}

// Check if a type-Node represents an optional type.
fn node_is_optional(n: Node) -> Bool {
  n.properties |> any(p => p.name == "optional")
}

// Check if a type-Node represents a map type.
fn node_is_map(n: Node) -> Bool {
  n.properties |> any(p => p.name == "map_type")
}

// Check if a type-Node is a leaf (primitive or named reference).
fn node_is_leaf(n: Node) -> Bool {
  n.connective == none && n.children |> count == 0 && n.properties |> count == 0
}

// Check if a type-Node is a named reference (has return_type with Named).
fn node_is_named_ref(n: Node) -> Bool {
  if n.return_type == none { false }
  else {
    let rt = n.return_type.value
    rt.connective == none && rt.children |> count == 0
      && rt.name != "" && rt.name != "None"
      && rt.name != "String" && rt.name != "Int" && rt.name != "Bool"
      && rt.name != "Float" && rt.name != "Secret" && rt.name != "Json"
      && rt.name != "Unit" && rt.name != "Bytes"
  }
}

// Node-based shape description.
fn node_type_shape(n: Node) -> String {
  if node_is_leaf(n: n) {
    if node_is_named_ref(n: n) {
      concat("Named(", normalize_type_name(name: n.name), ")")
    } else {
      concat("Primitive(", n.name, ")")
    }
  } else if n.connective != none {
    match n.connective.value {
      Conj =>
        if n.name == "" { "Product(<anon>)" } else { concat("Product(", normalize_type_name(name: n.name), ")") }
      Disj =>
        if n.name == "" { "Coproduct(<anon>)" } else { concat("Coproduct(", normalize_type_name(name: n.name), ")") }
    }
  } else if node_is_container(n: n) {
    let elem_shape = match n.children |> first {
      Some { value: el } => node_type_shape(n: el)
      None => "?"
    }
    concat("Container(", n.name, ",", elem_shape, ")")
  } else if node_is_optional(n: n) {
    let inner_shape = match n.children |> first {
      Some { value: inner } => node_type_shape(n: inner)
      None => "?"
    }
    concat("Optional(", inner_shape, ")")
  } else if node_is_map(n: n) {
    "Map(...)"
  } else {
    concat("Node(", n.name, ")")
  }
}

// Node-based type equality.
// Two type-Nodes are equal if they represent the same type structure.
fn node_type_equals(left: Node, right: Node) -> Bool {
  // Both leaves: compare names (normalized)
  if node_is_leaf(n: left) && node_is_leaf(n: right) {
    normalize_type_name(name: left.name) == normalize_type_name(name: right.name)
  }
  // Both products: compare names
  else if left.connective != none && right.connective != none {
    normalize_type_name(name: left.name) == normalize_type_name(name: right.name)
  }
  // Leaf vs product/coproduct: compare leaf name with product/coproduct name
  else if node_is_leaf(n: left) && right.connective != none {
    normalize_type_name(name: left.name) == normalize_type_name(name: right.name)
  }
  else if left.connective != none && node_is_leaf(n: right) {
    normalize_type_name(name: left.name) == normalize_type_name(name: right.name)
  }
  // Both containers: compare kind and element
  else if node_is_container(n: left) && node_is_container(n: right) {
    if left.name != right.name { false }
    else {
      match left.children |> first {
        Some { value: left_el } =>
          match right.children |> first {
            Some { value: right_el } => node_type_equals(left: left_el, right: right_el)
            None => false
          }
        None => false
      }
    }
  }
  // Both optionals: compare inner
  else if node_is_optional(n: left) && node_is_optional(n: right) {
    match left.children |> first {
      Some { value: left_inner } =>
        match right.children |> first {
          Some { value: right_inner } => node_type_equals(left: left_inner, right: right_inner)
          None => false
        }
      None => false
    }
  }
  // Both maps: compare key and value
  else if node_is_map(n: left) && node_is_map(n: right) {
    if left.children |> count == 2 && right.children |> count == 2 {
      let left_first = match left.children |> first { Some { value: v } => v, None => left }
      let right_first = match right.children |> first { Some { value: v } => v, None => right }
      let left_second = match skip(left.children, 1) |> first { Some { value: v } => v, None => left }
      let right_second = match skip(right.children, 1) |> first { Some { value: v } => v, None => right }
      node_type_equals(left: left_first, right: right_first) && node_type_equals(left: left_second, right: right_second)
    } else {
      false
    }
  }
  else {
    false
  }
}

// Node-based dependency extraction.
// Returns the list of Named type references this type-Node depends on.
// Must recurse through container wrappers (List<T>, T?, Map<K,V>) to find
// all referenced type names -- otherwise cycle detection misses cycles
// that pass through containers (e.g. Expr -> resolved_type: Node? -> Node).
fn is_primitive_name(name: String) -> Bool {
  name == "String" || name == "Int" || name == "Bool" || name == "Float"
    || name == "Secret" || name == "Json" || name == "Unit" || name == "Bytes"
    || name == "None" || name == ""
}

fn node_type_deps(n: Node) -> List<String> {
  if node_is_named_ref(n: n) {
    // Simple field reference: return_type is a bare type name leaf.
    [n.return_type.value.name]
  } else if n.connective != none {
    match n.connective.value {
      Disj =>
        flat_map(n.children, child =>
          if child.return_type != none {
            node_type_deps(n: child.return_type.value)
          } else {
            node_type_deps(n: child)
          }
        )
      _ =>
        flat_map(n.children, child =>
          if child.return_type != none {
            node_type_deps(n: child.return_type.value)
          } else {
            node_type_deps(n: child)
          }
        )
    }
  } else if n.return_type != none {
    // Field with complex return type (List<T>, Optional<T>, Map<K,V>).
    // Recurse into the type tree to capture transitive deps.
    node_type_deps(n: n.return_type.value)
  } else if n.children |> count > 0 {
    // Container or compound node: recurse into children.
    flat_map(n.children, child => node_type_deps(n: child))
  } else if is_primitive_name(name: n.name) {
    []
  } else {
    // Bare type name leaf (e.g. "Node" inside List<Node>).
    [n.name]
  }
}

fn is_int_type_node(n: Node) -> Bool {
  let normed = normalize_access_type_node(n: n)
  normed.connective == none && normed.children |> count == 0 && normed.name == "Int"
}

fn is_string_type_node(n: Node) -> Bool {
  let normed = normalize_access_type_node(n: n)
  normed.connective == none && normed.children |> count == 0 && normed.name == "String"
}

fn access_error(message: String, span: SourceSpan, module_name: String) -> Diagnostic {
  Diagnostic {
    severity: Error,
    message: message,
    span: Some { value: span },
    module_name: Some { value: module_name }
  }
}

fn inference_error(message: String, span: SourceSpan, module_name: String) -> Diagnostic {
  Diagnostic {
    severity: Error,
    message: message,
    span: Some { value: span },
    module_name: Some { value: module_name }
  }
}

fn infer_binop_type_node(op: BinOpKind, left_type: Node) -> Node {
  match op {
    BinEq => leaf_node(name: "Bool")
    BinNe => leaf_node(name: "Bool")
    BinLt => leaf_node(name: "Bool")
    BinGt => leaf_node(name: "Bool")
    BinLe => leaf_node(name: "Bool")
    BinGe => leaf_node(name: "Bool")
    BinAnd => leaf_node(name: "Bool")
    BinOr => leaf_node(name: "Bool")
    NullCoalesce => extract_optional_inner_node(n: left_type)
    _ => left_type
  }
}

// -------------------------------------------------------------------------
// extract_optional_inner: unwrap Optional<T> to T; if not Optional, return as-is
// -------------------------------------------------------------------------

fn extract_optional_inner_node(n: Node) -> Node {
  if n.connective != none && n.name == "Optional" {
    match n.children |> first {
      Some { value: inner } => inner
      None => n
    }
  } else { n }
}

// -------------------------------------------------------------------------
// infer_method_call_type: compute result type for pipe methods
// -------------------------------------------------------------------------

fn infer_method_call_type_node(receiver_type: Node, method: String) -> Node? {
  let normed = normalize_access_type_node(n: receiver_type)
  let elem_node = if normed.connective == none && normed.children |> count == 1 {
    match normed.children |> first {
      Some { value: el } => el
      None => receiver_type
    }
  } else { receiver_type }
  if method == "map" || method == "filter" || method == "enumerate" {
    Some { value: receiver_type }
  } else if method == "fold" {
    Some { value: leaf_node(name: "Unit") }
  } else if method == "first" || method == "last" {
    Some { value: optional_node(inner: elem_node) }
  } else if method == "count" {
    Some { value: leaf_node(name: "Int") }
  } else if method == "join" {
    Some { value: leaf_node(name: "String") }
  } else if method == "any" || method == "contains" || method == "all" {
    Some { value: leaf_node(name: "Bool") }
  } else if method == "split" || method == "chars" {
    Some { value: container_node(kind_name: "List", element: leaf_node(name: "String")) }
  } else if method == "flat_map" || method == "reverse" || method == "skip" || method == "concat" {
    Some { value: receiver_type }
  } else {
    none
  }
}

fn check_index_access_node(base_type: Node, index_type: Node, span: SourceSpan, module_name: String) -> AccessCheckResultNode {
  let normed = normalize_access_type_node(n: base_type)
  if normed.connective == none && normed.children |> count == 0 && normed.name == "String" {
    let diags = if is_int_type_node(n: index_type) { [] }
    else { [access_error(message: "string index requires an Int index", span: span, module_name: module_name)] }
    AccessCheckResultNode { resolved_type: leaf_node(name: "String"), diagnostics: diags }
  } else if normed.name == "Map" && normed.children |> count == 2 {
    let key_node = match normed.children |> first {
      Some { value: k } => k
      None => leaf_node(name: "String")
    }
    let val_node = match normed.children |> skip(1) |> first {
      Some { value: v } => v
      None => leaf_node(name: "Unit")
    }
    let key_diags = if node_type_equals(left: key_node, right: index_type) { [] }
    else { [access_error(message: "map index key type does not match the map key type", span: span, module_name: module_name)] }
    AccessCheckResultNode { resolved_type: optional_node(inner: val_node), diagnostics: key_diags }
  } else {
    AccessCheckResultNode {
      resolved_type: leaf_node(name: "Unit"),
      diagnostics: [access_error(message: "indexing is only supported for String and Map values", span: span, module_name: module_name)]
    }
  }
}

fn check_slice_access_node(base_type: Node, start_type: Node, end_type: Node, span: SourceSpan, module_name: String) -> AccessCheckResultNode {
  let base_is_string = is_string_type_node(n: base_type)
  let base_diags = if base_is_string { [] }
  else { [access_error(message: "slice is only supported for String values", span: span, module_name: module_name)] }
  let start_diags = if is_int_type_node(n: start_type) { [] }
  else { [access_error(message: "slice start requires an Int index", span: span, module_name: module_name)] }
  let end_diags = if is_int_type_node(n: end_type) { [] }
  else { [access_error(message: "slice end requires an Int index", span: span, module_name: module_name)] }
  AccessCheckResultNode {
    resolved_type: if base_is_string { leaf_node(name: "String") } else { leaf_node(name: "Unit") },
    diagnostics: concat(base_diags, start_diags, end_diags)
  }
}

// -------------------------------------------------------------------------
// build_params_scope: add function params to locals in an InferScope
// -------------------------------------------------------------------------

fn build_params_scope(scope: InferScope, params: List<Param>) -> InferScope {
  let new_locals = fold(params, init: scope.locals, f: (acc, p) =>
    map_insert(acc, p.name, TypeBinding { name: p.name, resolved: p.type_expr })
  )
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: new_locals,
    module_name: scope.module_name,
    service_registry: scope.service_registry
  }
}

// -------------------------------------------------------------------------
// extend_scope: add a single local binding to an InferScope
// -------------------------------------------------------------------------

fn extend_scope(scope: InferScope, name: String, resolved: Node) -> InferScope {
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: map_insert(scope.locals, name, TypeBinding { name: name, resolved: resolved }),
    module_name: scope.module_name,
    service_registry: scope.service_registry
  }
}

// Extend scope with lambda parameter names.
fn extend_scope_with_params(scope: InferScope, params: List<String>) -> InferScope {
  let new_locals = fold(params, init: scope.locals, f: (acc, p) =>
    map_insert(acc, p, TypeBinding { name: p, resolved: leaf_node(name: "Dynamic") })
  )
  InferScope {
    type_env: scope.type_env,
    func_env: scope.func_env,
    locals: new_locals,
    module_name: scope.module_name,
    service_registry: scope.service_registry
  }
}

fn resolve_scrutinee_type_node(env: TypeEnv, n: Node) -> Node {
  if n.connective == none && n.children |> count == 0 {
    match lookup_type(env: env, name: n.name) {
      Some { value: resolved } => resolved
      None => n
    }
  } else { n }
}

fn scope_after_stmt_node(stmt: Expr, stmt_type: Node, scope: InferScope) -> InferScope {
  match stmt {
    Let { name: name, value: _, body: body, span: _ } =>
      if body == none {
        extend_scope(scope: scope, name: name, resolved: stmt_type)
      } else {
        scope
      }
    _ => scope
  }
}

fn lookup_variant_in_type(scrut: Node, variant_name: String, module_name: String) -> NodeLookupResult {
  match scrut.children |> filter(c => c.name == variant_name) |> first {
    Some { value: v } => NodeLookupResult { resolved: v, diagnostics: [] }
    None => NodeLookupResult {
      resolved: scrut,
      diagnostics: [Diagnostic {
        severity: Error,
        message: concat("variant '", concat(variant_name, concat("' not found in type '", concat(scrut.name, "'")))),
        span: Some { value: scrut.span },
        module_name: Some { value: module_name }
      }]
    }
  }
}

fn lookup_field_in_variant(variant: Node, field_name: String, module_name: String) -> NodeLookupResult {
  match variant.children |> filter(c => c.name == field_name) |> first {
    Some { value: field_child } =>
      let resolved = child_return_type_or_name(ch: field_child)
      NodeLookupResult { resolved: resolved, diagnostics: [] }
    None => NodeLookupResult {
      resolved: leaf_node(name: "<error:field_not_found>"),
      diagnostics: [Diagnostic {
        severity: Error,
        message: concat("field '", concat(field_name, concat("' not found in variant '", concat(variant.name, "'")))),
        span: Some { value: variant.span },
        module_name: Some { value: module_name }
      }]
    }
  }
}

fn extend_scope_with_pattern_node(scope: InferScope, pattern: MatchPattern, scrutinee_type: Node) -> PatternScopeResult {
  match pattern {
    Bind { name: n } => PatternScopeResult { scope: extend_scope(scope: scope, name: n, resolved: scrutinee_type), diagnostics: [] }
    Wildcard => PatternScopeResult { scope: scope, diagnostics: [] }
    LitPattern { value: _ } => PatternScopeResult { scope: scope, diagnostics: [] }
    VariantPattern { name: vname, field_bindings: bindings } =>
      let resolved_scrut = resolve_scrutinee_type_node(env: scope.type_env, n: scrutinee_type)
      // Find variant child by name in the Disj node
      let variant_lookup = lookup_variant_in_type(scrut: resolved_scrut, variant_name: vname, module_name: scope.module_name)
      let variant_node = variant_lookup.resolved
      let variant_diags = variant_lookup.diagnostics
      fold(bindings, init: PatternScopeResult { scope: scope, diagnostics: variant_diags }, f: (acc, fb) =>
        // Find field in variant's children
        let field_lookup = lookup_field_in_variant(variant: variant_node, field_name: fb.field_name, module_name: scope.module_name)
        let field_type = field_lookup.resolved
        match fb.binding {
          Bind { name: n } => PatternScopeResult {
            scope: extend_scope(scope: acc.scope, name: n, resolved: field_type),
            diagnostics: concat(acc.diagnostics, field_lookup.diagnostics)
          }
          _ =>
            let nested = extend_scope_with_pattern_node(scope: acc.scope, pattern: fb.binding, scrutinee_type: field_type)
            PatternScopeResult {
              scope: nested.scope,
              diagnostics: concat(acc.diagnostics, concat(field_lookup.diagnostics, nested.diagnostics))
            }
        }
      )
  }
}

fn for_each_element_type_node(n: Node) -> Node {
  let normed = normalize_access_type_node(n: n)
  if normed.connective == none && normed.children |> count == 1 {
    match normed.children |> first {
      Some { value: el } => el
      None => normed
    }
  } else if normed.connective == none && normed.children |> count == 0 && normed.name == "String" {
    leaf_node(name: "String")
  } else {
    normed
  }
}

// -------------------------------------------------------------------------
// infer_expr: the main recursive function
//
// For each Expr variant, produce an Expr with resolved_type filled in.
// Diagnostics are threaded through for reporting.
// -------------------------------------------------------------------------

fn infer_expr(expr: Expr, scope: InferScope) -> InferResult {
  match expr {
    Literal { value: lit, span: span } =>
      ok_infer(texpr: Literal { value: lit, resolved_type: Some { value: infer_literal_node(lit: lit) }, span: span })

    Var { name: name, span: span } =>
      let value_match = lookup_in_scope(scope: scope, name: name)
      match value_match {
        Some { value: resolved } =>
          ok_infer(texpr: Var { name: name, resolved_type: Some { value: resolved }, span: span })
        None =>
          let texpr = Var { name: name, resolved_type: Some { value: leaf_node(name: "<error:unresolved_var>") }, span: span }
          InferResult {
            typed: texpr,
            diagnostics: [inference_error(
              message: concat("undefined variable '", name, "'"),
              span: span,
              module_name: scope.module_name
            )]
          }
      }

    FieldAccess { base: base_expr, field: field_name, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let base_typed = base_result.typed
      let base_diags = base_result.diagnostics
      let resolved_base = resolve_scrutinee_type_node(env: scope.type_env, n: base_typed.resolved_type.value)
      match lookup_field_type_node(n: resolved_base, field_name: field_name) {
        Some { value: field_type } =>
          let texpr = FieldAccess { base: base_typed, field: field_name, resolved_type: Some { value: field_type }, span: span }
          InferResult {
            typed: texpr,
            diagnostics: base_diags
          }
        None =>
          match check_service_field_access_node(base_type: base_typed.resolved_type.value, field: field_name, scope: scope) {
            Some { value: svc_type } =>
              let texpr = FieldAccess { base: base_typed, field: field_name, resolved_type: Some { value: svc_type }, span: span }
              InferResult {
                typed: texpr,
                diagnostics: base_diags
              }
            None =>
              // Dynamic-typed expressions (e.g., lambda parameters) permit field
              // access without error -- the field type propagates as a leaf.
              let is_dynamic = resolved_base.connective == none && resolved_base.children |> count == 0 && resolved_base.name == "Dynamic"
              let field_diags = if is_dynamic {
                []
              } else {
                [inference_error(
                  message: concat("no field '", field_name, "' on type"),
                  span: span,
                  module_name: scope.module_name
                )]
              }
              let texpr = FieldAccess { base: base_typed, field: field_name, resolved_type: Some { value: leaf_node(name: "Dynamic") }, span: span }
              InferResult {
                typed: texpr,
                diagnostics: concat(base_diags, field_diags)
              }
          }
      }

    Call { func: func_name, args: call_args, span: span } =>
      let arg_infer_results = call_args |> map(a =>
        let ar = infer_expr(expr: a.value, scope: scope)
        let ar_typed = ar.typed
        let ar_diags = ar.diagnostics
        ArgInferResult { typed_arg: NamedArg { name: a.name, value: ar_typed }, diagnostics: ar_diags }
      )
      let typed_args = arg_infer_results |> map(air => air.typed_arg)
      let arg_diags = flat_map(arg_infer_results, air => air.diagnostics)
      let sig = lookup_func_sig(func_env: scope.func_env, name: func_name)
      if sig != none {
        // Tier 1: known function signature
        let resolved_type = match sig {
          Some { value: s } => s.return_type
          None => leaf_node(name: "<error:unreachable>")
        }
        InferResult {
          typed: Call { func: func_name, args: typed_args, resolved_type: Some { value: resolved_type }, span: span },
          diagnostics: arg_diags
        }
      } else {
        // Tier 2: try bridging to method call on first argument
        let first_arg_type = match typed_args |> first {
          Some { value: ta } => ta.value.resolved_type.value
          None => leaf_node(name: "Unit")
        }
        let method_type = infer_method_call_type_node(receiver_type: first_arg_type, method: func_name)
        if method_type != none && typed_args |> count > 0 {
          // Known collection method -- bridge Call to MethodCall
          let receiver = match typed_args |> first {
            Some { value: ta } => ta.value
            None => Literal { value: LitNull, resolved_type: Some { value: leaf_node(name: "Unit") }, span: span }
          }
          let remaining = typed_args |> skip(1)
          InferResult {
            typed: MethodCall { receiver: receiver, method: func_name, args: remaining, resolved_type: Some { value: method_type.value }, span: span },
            diagnostics: arg_diags
          }
        } else {
          // Tier 3: type constructor or unknown
          let type_match = lookup_type(env: scope.type_env, name: func_name)
          let resolved_type = match type_match {
            Some { value: tn } => tn
            None => leaf_node(name: "<error:unknown_function>")
          }
          let call_diags = match type_match {
            Some { value: _ } => []
            None => [inference_error(
              message: concat("function '", func_name, "' not found in scope"),
              span: span,
              module_name: scope.module_name
            )]
          }
          InferResult {
            typed: Call { func: func_name, args: typed_args, resolved_type: Some { value: resolved_type }, span: span },
            diagnostics: concat(arg_diags, call_diags)
          }
        }
      }

    MethodCall { receiver: recv, method: method_name, args: mc_args, span: span } =>
      let recv_result = infer_expr(expr: recv, scope: scope)
      let recv_typed = recv_result.typed
      let recv_diags = recv_result.diagnostics
      let mc_arg_infer_results = mc_args |> map(a =>
        let ar = infer_expr(expr: a.value, scope: scope)
        let ar_typed = ar.typed
        let ar_diags = ar.diagnostics
        ArgInferResult { typed_arg: NamedArg { name: a.name, value: ar_typed }, diagnostics: ar_diags }
      )
      let typed_mc_args = mc_arg_infer_results |> map(air => air.typed_arg)
      let mc_arg_diags = flat_map(mc_arg_infer_results, air => air.diagnostics)
      let result_type = match check_service_method_call_node(receiver_type: recv_typed.resolved_type.value, method: method_name, scope: scope) {
        Some { value: svc_type } => svc_type
        None => match infer_method_call_type_node(receiver_type: recv_typed.resolved_type.value, method: method_name) {
          Some { value: rt } => rt
          None => recv_typed.resolved_type.value
        }
      }
      let texpr = MethodCall { receiver: recv_typed, method: method_name, args: typed_mc_args, resolved_type: Some { value: result_type }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(recv_diags, mc_arg_diags)
      }

    Match { scrutinee: scrut, arms: arms, span: span } =>
      let scrut_result = infer_expr(expr: scrut, scope: scope)
      let scrut_typed = scrut_result.typed
      let scrut_diags = scrut_result.diagnostics
      let arm_infer_results = arms |> map(arm =>
        let pattern_result = extend_scope_with_pattern_node(scope: scope, pattern: arm.pattern, scrutinee_type: scrut_typed.resolved_type.value)
        let arm_scope = pattern_result.scope
        let pattern_diags = pattern_result.diagnostics
        let guard_result = if arm.guard != none {
          Some { value: infer_expr(expr: arm.guard.value, scope: arm_scope) }
        } else {
          none
        }
        let body_result = infer_expr(expr: arm.body, scope: arm_scope)
        let body_typed = body_result.typed
        let body_diags = body_result.diagnostics
        let guard_diags = if guard_result != none { guard_result.value.diagnostics } else { [] }
        ArmInferResult {
          typed_arm: MatchArm {
            pattern: arm.pattern,
            guard: if guard_result != none { Some { value: guard_result.value.typed } } else { none },
            body: body_typed
          },
          diagnostics: concat(pattern_diags, concat(guard_diags, body_diags))
          body_type: body_typed.resolved_type.value
        }
      )
      let typed_arms = arm_infer_results |> map(ar => ar.typed_arm)
      let arm_diags = flat_map(arm_infer_results, ar => ar.diagnostics)
      let result_type = match first(arm_infer_results) {
        Some { value: ar } => ar.body_type
        None => scrut_typed.resolved_type.value
      }
      let empty_arms_diags = if count(arm_infer_results) == 0 {
        [inference_error(
          message: "match expression has no arms",
          span: span,
          module_name: scope.module_name
        )]
      } else {
        []
      }
      let exhaustiveness_diags = check_match_exhaustiveness(
        scrutinee_type: scrut_typed.resolved_type.value,
        arms: typed_arms,
        env: scope.type_env,
        span: span,
        module_name: scope.module_name
      )
      let texpr = Match { scrutinee: scrut_typed, arms: typed_arms, resolved_type: Some { value: result_type }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(scrut_diags, arm_diags, empty_arms_diags, exhaustiveness_diags)
      }

    If { condition: cond, then_branch: then_expr, else_branch: else_expr, span: span } =>
      let cond_result = infer_expr(expr: cond, scope: scope)
      let cond_typed = cond_result.typed
      let cond_diags = cond_result.diagnostics
      let then_result = infer_expr(expr: then_expr, scope: scope)
      let then_typed = then_result.typed
      let then_diags = then_result.diagnostics
      match else_expr {
        Some { value: else_branch } =>
          let else_result = infer_expr(expr: else_branch, scope: scope)
          let else_typed = else_result.typed
          let else_diags = else_result.diagnostics
          let branch_diags = if node_type_equals(
            left: then_typed.resolved_type.value,
            right: else_typed.resolved_type.value
          ) {
            []
          } else {
            [inference_error(
              message: concat(
                "if branches resolve to incompatible types: ",
                node_type_shape(n: then_typed.resolved_type.value),
                " vs ",
                node_type_shape(n: else_typed.resolved_type.value)
              ),
              span: span,
              module_name: scope.module_name
            )]
          }
          let resolved_type = then_typed.resolved_type.value
          let texpr = If { condition: cond_typed, then_branch: then_typed, else_branch: Some { value: else_typed }, resolved_type: Some { value: resolved_type }, span: span }
          InferResult {
            typed: texpr,
            diagnostics: concat(cond_diags, then_diags, else_diags, branch_diags)
          }
        None =>
          let texpr = If { condition: cond_typed, then_branch: then_typed, else_branch: none, resolved_type: Some { value: leaf_node(name: "Unit") }, span: span }
          InferResult {
            typed: texpr,
            diagnostics: concat(cond_diags, then_diags)
          }
      }

    Let { name: let_name, value: let_value, body: let_body, span: span } =>
      let val_result = infer_expr(expr: let_value, scope: scope)
      let val_typed = val_result.typed
      let val_diags = val_result.diagnostics
      let val_type = val_typed.resolved_type.value
      if let_body == none {
        let texpr = Let { name: let_name, value: val_typed, body: none, resolved_type: Some { value: val_type }, span: span }
        InferResult {
          typed: texpr,
          diagnostics: val_diags
        }
      } else {
        let extended = extend_scope(scope: scope, name: let_name, resolved: val_type)
        let body_result = infer_expr(expr: let_body.value, scope: extended)
        let body_typed = body_result.typed
        let body_diags = body_result.diagnostics
        let texpr = Let { name: let_name, value: val_typed, body: Some { value: body_typed }, resolved_type: Some { value: body_typed.resolved_type.value }, span: span }
        InferResult {
          typed: texpr,
          diagnostics: concat(val_diags, body_diags)
        }
      }

    RecordLit { type_name: tn, fields: field_inits, span: span } =>
      infer_record_lit(type_name: tn, field_inits: field_inits, span: span, scope: scope)

    ListLit { elements: elements, span: span } =>
      let elem_results = elements |> map(e => infer_expr(expr: e, scope: scope))
      let typed_elements = elem_results |> map(r => r.typed)
      let elem_diags = flat_map(elem_results, r => r.diagnostics)
      let elem_type_node = if count(elem_results) > 0 {
        match first(elem_results) {
          Some { value: r } => r.typed.resolved_type.value
          None => leaf_node(name: "Unit")
        }
      } else {
        leaf_node(name: "Unit")
      }
      let texpr = ListLit { elements: typed_elements, resolved_type: Some { value: container_node(kind_name: "List", element: elem_type_node) }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: elem_diags
      }

    BinOp { op: op, left: left_expr, right: right_expr, span: span } =>
      let left_result = infer_expr(expr: left_expr, scope: scope)
      let left_typed = left_result.typed
      let left_diags = left_result.diagnostics
      let right_result = infer_expr(expr: right_expr, scope: scope)
      let right_typed = right_result.typed
      let right_diags = right_result.diagnostics
      let result_type = infer_binop_type_node(op: op, left_type: left_typed.resolved_type.value)
      let texpr = BinOp { op: op, left: left_typed, right: right_typed, resolved_type: Some { value: result_type }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(left_diags, right_diags)
      }

    UnaryOp { op: op, operand: operand_expr, span: span } =>
      let operand_result = infer_expr(expr: operand_expr, scope: scope)
      let operand_typed = operand_result.typed
      let operand_diags = operand_result.diagnostics
      let result_type = match op {
        Not => leaf_node(name: "Bool")
        Neg => operand_typed.resolved_type.value
      }
      let texpr = UnaryOp { op: op, operand: operand_typed, resolved_type: Some { value: result_type }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: operand_diags
      }

    Lambda { params: lam_params, body: lam_body, span: span } =>
      let lam_scope = extend_scope_with_params(scope: scope, params: lam_params)
      let body_result = infer_expr(expr: lam_body, scope: lam_scope)
      let body_typed = body_result.typed
      let body_diags = body_result.diagnostics
      let texpr = Lambda { params: lam_params, body: body_typed, resolved_type: Some { value: body_typed.resolved_type.value }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: body_diags
      }

    StringInterp { parts: str_parts, span: span } =>
      let part_results = str_parts |> map(p => match p {
        Text { value: v } => StringPartInferResult {
          typed_part: Text { value: v },
          diagnostics: []
        }
        Interpolation { expr: e } =>
          let r = infer_expr(expr: e, scope: scope)
          let r_typed = r.typed
          let r_diags = r.diagnostics
          StringPartInferResult {
            typed_part: Interpolation { expr: r_typed },
            diagnostics: r_diags
          }
      })
      let typed_parts = part_results |> map(pr => pr.typed_part)
      let interp_diags = flat_map(part_results, pr => pr.diagnostics)
      let texpr = StringInterp { parts: typed_parts, resolved_type: Some { value: leaf_node(name: "String") }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: interp_diags
      }

    Block { stmts: stmts, span: span } =>
      if count(stmts) > 0 {
        let state = infer_block_stmts(
          remaining: stmts, scope: scope,
          typed_stmts: [], diag_chunks: [],
          last_type: leaf_node(name: "Unit")
        )
        let texpr = Block { stmts: state.typed_stmts, resolved_type: Some { value: state.last_type }, span: span }
        InferResult {
          typed: texpr,
          diagnostics: flat_map(state.diag_chunks, c => c)
        }
      } else {
        ok_infer(texpr: Block { stmts: [], resolved_type: Some { value: leaf_node(name: "Unit") }, span: span })
      }

    Cast { expr: cast_inner, target: target_type, span: span } =>
      let inner_result = infer_expr(expr: cast_inner, scope: scope)
      let inner_typed = inner_result.typed
      let inner_diags = inner_result.diagnostics
      let texpr = Cast { expr: inner_typed, target: target_type, resolved_type: Some { value: target_type }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: inner_diags
      }

    ForEach { variable: variable, collection: coll, body: body_expr, span: span } =>
      let coll_result = infer_expr(expr: coll, scope: scope)
      let coll_typed = coll_result.typed
      let coll_diags = coll_result.diagnostics
      let elem_type_node = for_each_element_type_node(n: coll_typed.resolved_type.value)
      let body_scope = extend_scope(scope: scope, name: variable, resolved: elem_type_node)
      let body_result = infer_expr(expr: body_expr, scope: body_scope)
      let body_typed = body_result.typed
      let body_diags = body_result.diagnostics
      let texpr = ForEach { variable: variable, collection: coll_typed, body: body_typed, resolved_type: Some { value: body_typed.resolved_type.value }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(coll_diags, body_diags)
      }

    Index { base: base_expr, index: index_expr, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let base_typed = base_result.typed
      let base_diags = base_result.diagnostics
      let index_result = infer_expr(expr: index_expr, scope: scope)
      let index_typed = index_result.typed
      let index_diags = index_result.diagnostics
      let index_check = check_index_access_node(
        base_type: base_typed.resolved_type.value,
        index_type: index_typed.resolved_type.value,
        span: span,
        module_name: scope.module_name
      )
      let texpr = Index { base: base_typed, index: index_typed, resolved_type: Some { value: index_check.resolved_type }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(base_diags, index_diags, index_check.diagnostics)
      }

    Slice { base: base_expr, start: start_expr, end: end_expr, span: span } =>
      let base_result = infer_expr(expr: base_expr, scope: scope)
      let base_typed = base_result.typed
      let base_diags = base_result.diagnostics
      let start_result = infer_expr(expr: start_expr, scope: scope)
      let start_typed = start_result.typed
      let start_diags = start_result.diagnostics
      let end_result = infer_expr(expr: end_expr, scope: scope)
      let end_typed = end_result.typed
      let end_diags = end_result.diagnostics
      let slice_check = check_slice_access_node(
        base_type: base_typed.resolved_type.value,
        start_type: start_typed.resolved_type.value,
        end_type: end_typed.resolved_type.value,
        span: span,
        module_name: scope.module_name
      )
      let texpr = Slice { base: base_typed, start: start_typed, end: end_typed, resolved_type: Some { value: slice_check.resolved_type }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: concat(base_diags, start_diags, end_diags, slice_check.diagnostics)
      }

    Return { value: inner_expr, span: span } =>
      let inner_result = infer_expr(expr: inner_expr, scope: scope)
      let texpr = Return { value: inner_result.typed, resolved_type: Some { value: inner_result.typed.resolved_type.value }, span: span }
      InferResult {
        typed: texpr,
        diagnostics: inner_result.diagnostics
      }

    // All 20 Expr variants are handled above. This arm is unreachable.
    // If a new variant is added to Expr without a case here, this emits
    // a clear error diagnostic rather than silently fabricating Unit.
    _ =>
      let span = expr_span(expr: expr)
      InferResult {
        typed: Literal { value: LitNull, resolved_type: Some { value: leaf_node(name: "<error:unhandled>") }, span: span },
        diagnostics: [inference_error(
          message: "unhandled expression variant in infer_expr",
          span: span,
          module_name: scope.module_name
        )]
      }
  }
}

// -------------------------------------------------------------------------
// infer_record_lit: helper for RecordLit inference
//
// type_name is String? -- handle with == none check per v1 codegen limitation.
// If type_name given, look up in type_env; else construct anonymous Product.
// -------------------------------------------------------------------------

fn infer_record_lit(type_name: String?, field_inits: List<FieldInit>, span: SourceSpan, scope: InferScope) -> InferResult {
  let fi_infer_results = map(field_inits, fi =>
    let ar = infer_expr(expr: fi.value, scope: scope)
    let ar_typed = ar.typed
    let ar_diags = ar.diagnostics
    FieldInferResult {
      typed_field: FieldInit { name: fi.name, value: ar_typed },
      infer_result: ar,
      diagnostics: ar_diags
    }
  )
  let typed_fields = fi_infer_results |> map(fir => fir.typed_field)
  let fi_diags = flat_map(fi_infer_results, fir => fir.diagnostics)
  if type_name == none {
    // Anonymous record -- construct Conj node from field inits
    let child_nodes = fi_infer_results |> map(fir =>
      Node {
        name: fir.typed_field.name, span: no_span(),
        children: [], connective: none,
        params: [], return_type: Some { value: fir.infer_result.typed.resolved_type.value }, uses: [],
        body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false
      }
    )
    let anon_node = Node {
      name: "", span: no_span(),
      children: child_nodes, connective: Some { value: Conj },
      params: [], return_type: none, uses: [],
      body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false
    }
    let texpr = RecordLit { type_name: none, fields: typed_fields, resolved_type: Some { value: anon_node }, span: span }
    InferResult {
      typed: texpr,
      diagnostics: fi_diags
    }
  } else {
    // Named record -- look up type in env
    let type_lookup = lookup_type(env: scope.type_env, name: type_name.value)
    let resolved_node = match type_lookup {
      Some { value: tn } => tn
      None => leaf_node(name: "<error:unknown_type>")
    }
    let type_diags = match type_lookup {
      Some { value: _ } => []
      None => [inference_error(
        message: concat("type '", type_name.value, "' not found in scope"),
        span: span,
        module_name: scope.module_name
      )]
    }
    let texpr = RecordLit { type_name: type_name, fields: typed_fields, resolved_type: Some { value: resolved_node }, span: span }
    InferResult {
      typed: texpr,
      diagnostics: concat(fi_diags, type_diags)
    }
  }
}

// -------------------------------------------------------------------------
// infer_item: wraps each Node into its Node counterpart with inferred types
// -------------------------------------------------------------------------

fn infer_item(item: Node, scope: InferScope) -> TypedItemResult {
  let typed_anno = item.type_annotation
  // Type definition: has connective (record/sum) and is not a transport binding
  if item.connective != none && item.transport == none {
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        return_type: Some { value: leaf_node(name: "Unit") }, uses: item.uses, body: none,
        connective: item.connective, transport: item.transport,
        properties: item.properties, type_annotation: typed_anno,
        config: item.config,
        is_self_recursive: false, has_non_tail_self_call: false
      },
      diagnostics: []
    }
  }
  // Function with body: infer body, resolve return type
  else if item.body != none && item.params |> count > 0 {
    let fn_scope = build_params_scope(scope: scope, params: item.params)
    let body_result = infer_expr(expr: item.body.value, scope: fn_scope)
    let body_typed = body_result.typed
    let body_diags = body_result.diagnostics
    let resolved_ret = if item.return_type == none {
      body_typed.resolved_type.value
    } else {
      item.return_type.value
    }
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        return_type: Some { value: resolved_ret }, uses: item.uses, body: Some { value: body_typed },
        connective: none, transport: item.transport,
        properties: item.properties, type_annotation: typed_anno,
        config: item.config,
        is_self_recursive: expr_has_self_call(expr: body_typed, fn_name: item.name),
        has_non_tail_self_call: expr_has_non_tail_self_call(expr: body_typed, fn_name: item.name, in_tail: true)
      },
      diagnostics: body_diags
    }
  }
  // Data definition: has body but no params, has type_annotation
  else if item.body != none && item.params |> count == 0 {
    let val_result = infer_expr(expr: item.body.value, scope: scope)
    let val_typed = val_result.typed
    let val_diags = val_result.diagnostics
    let resolved_ret = if item.type_annotation == none { val_typed.resolved_type.value } else { item.type_annotation.value }
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, children: [], params: [],
        return_type: Some { value: resolved_ret }, uses: [], body: Some { value: val_typed },
        connective: none, transport: item.transport,
        properties: item.properties, type_annotation: typed_anno,
        config: item.config,
        is_self_recursive: false, has_non_tail_self_call: false
      },
      diagnostics: val_diags
    }
  }
  // Extern func: has params but no body
  else if item.params |> count > 0 && item.body == none {
    let resolved_ret = if item.return_type == none { leaf_node(name: "Unit") } else { item.return_type.value }
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        return_type: Some { value: resolved_ret }, uses: item.uses, body: none,
        connective: none, transport: item.transport,
        properties: item.properties, type_annotation: typed_anno,
        config: item.config,
        is_self_recursive: false, has_non_tail_self_call: false
      },
      diagnostics: []
    }
  }
  // Service/Resource/other: pass through
  else {
    let resolved_ret = if item.return_type == none { leaf_node(name: "Unit") } else { item.return_type.value }
    TypedItemResult {
      item: Node {
        name: item.name, span: item.span, children: item.children |> map(c => infer_item(item: c, scope: scope).item), params: item.params,
        return_type: Some { value: resolved_ret }, uses: item.uses, body: none,
        connective: item.connective, transport: item.transport,
        properties: item.properties, type_annotation: typed_anno,
        config: item.config,
        is_self_recursive: false, has_non_tail_self_call: false
      },
      diagnostics: []
    }
  }
}

// -------------------------------------------------------------------------
// infer_items: walk all items in a module and produce Nodes
// -------------------------------------------------------------------------

fn infer_items(items: List<Node>, scope: InferScope) -> List<TypedItemResult> {
  map(items, item => infer_item(item: item, scope: scope))
}

// =========================================================================
// Kernel type environment
//
// The 8 kernel primitives that have no structural expansion.
// These are the atoms of the type system -- everything else is
// composed from them.
// =========================================================================

// Kernel primitives (String, Int, Bool, Float, Secret, Json, Unit, Bytes)
// are now defined as bare type declarations in dsl/std/types.dag.
// std.types is always first in compilation order, so all modules receive
// primitive bindings through imports.

// =========================================================================
// Type environment lookup
// =========================================================================

// =========================================================================
// Match exhaustiveness checking
//
// When matching on a known coproduct (Disj), check that all variants
// are covered. Wildcard and Bind patterns cover all remaining variants.
// Non-exhaustive matches emit a Warning diagnostic.
// =========================================================================

fn check_match_exhaustiveness(
  scrutinee_type: Node,
  arms: List<MatchArm>,
  env: TypeEnv,
  span: SourceSpan,
  module_name: String
) -> List<Diagnostic> {
  // Resolve the scrutinee type -- if it's a leaf name, look up its definition.
  let resolved = if scrutinee_type.connective != none {
    scrutinee_type
  } else {
    match lookup_type(env: env, name: scrutinee_type.name) {
      Some { value: def } => def
      None => scrutinee_type
    }
  }
  // Only check coproducts (Disj connective).
  match resolved.connective {
    Some { value: Disj } =>
      let variant_names = resolved.children |> map(c => c.name)
      // Check if any arm is a wildcard or bind (covers all remaining).
      let has_catch_all = any(arms, arm =>
        match arm.pattern {
          Wildcard => true
          Bind { name: _ } => true
          _ => false
        }
      )
      if has_catch_all {
        []
      } else {
        // Collect covered variant names from VariantPattern arms.
        let covered_set = arms |> fold(init: empty_map(), f: (acc, arm) =>
          match arm.pattern {
            VariantPattern { name: n, field_bindings: _ } => map_insert(acc, n, true)
            _ => acc
          }
        )
        let uncovered = variant_names |> filter(v => map_has(m: covered_set, key: v) == false)
        if count(uncovered) > 0 {
          [Diagnostic {
            severity: Warning,
            message: concat("non-exhaustive match: missing variant(s) ", join(uncovered, separator: ", ")),
            span: Some { value: span },
            module_name: Some { value: module_name }
          }]
        } else {
          []
        }
      }
    _ => []
  }
}

fn lookup_type(env: TypeEnv, name: String) -> Node? {
  let canonical = normalize_type_name(name: name)
  match map_get(env.bindings, canonical) {
    Some { value: binding } => Some { value: binding.resolved }
    None => None
  }
}

// =========================================================================
// Environment merging
//
// Combines multiple type environments. Later bindings shadow earlier ones
// (last-writer-wins), which matches the import resolution order: kernel
// first, then transitive deps, then direct imports, then local defs.
// =========================================================================

fn merge_envs(envs: List<TypeEnv>) -> TypeEnv {
  // Merge maps in order: later entries overwrite earlier ones (last-writer-wins),
  // matching the import resolution order: kernel < imports < local.
  // Preserve recursive_types from all environments so resolve_node_bounded
  // recognizes imported recursive types and doesn't expand them infinitely.
  //
  // Three separate folds instead of one struct-accumulator fold. When the
  // accumulator is a bare map/list (not a struct field), Rc::try_unwrap
  // succeeds in the generated code -- O(overlay) per merge, not O(base+overlay).
  let merged_bindings = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.bindings))
  let merged_recursive = fold(envs, init: [], f: (acc, env) => concat(acc, env.recursive_types))
  let merged_recursive_set = fold(envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.recursive_type_set))
  TypeEnv { bindings: merged_bindings, recursive_types: merged_recursive, recursive_type_set: merged_recursive_set }
}

// =========================================================================
// Cycle detection: precompute which types participate in dependency cycles.
//
// Instead of threading a growing resolving list through resolution (O(d^2)
// memory from repeated concat), we compute cycle membership once at env
// construction time. resolve_node then uses the precomputed set:
// Named references to cycle members are kept as-is; all others expand.
// =========================================================================

// Check if a type name can reach itself through the dependency graph.
// Uses Map<String, Bool> for O(1) visited checks instead of O(n) list scans.
fn reaches_self_with_map(root: String, current: String, bindings: Map<String, TypeBinding>, visited: Map<String, Bool>) -> Bool {
  let already_visited = match map_get(visited, current) { Some { value: _ } => true  _ => false }
  if already_visited {
    false
  } else {
    match map_get(bindings, current) {
      Some { value: binding } =>
        let deps = node_type_deps(n: binding.resolved)
        let next_visited = map_insert(visited, current, true)
        any(deps, d =>
          if d == root { true }
          else { reaches_self_with_map(root: root, current: d, bindings: bindings, visited: next_visited) }
        )
      None => false
    }
  }
}

// Detect all type names that participate in dependency cycles.
// Each type independently checks for self-reachability via DFS.
// No fold accumulator -- avoids O(N^2) deep cloning of growing maps.
fn detect_type_cycles(bindings: Map<String, TypeBinding>) -> List<String> {
  let all_names = map(map_values(bindings), b => b.name)
  filter(all_names, name => reaches_self_with_map(
    root: name, current: name, bindings: bindings,
    visited: empty_map()
  ))
}

// =========================================================================
// Build type environment for a single module
//
// Layers (in shadowing order, last wins):
//   1. Kernel primitives (String, Int, Bool, ...)
//   2. Imported types from parent environments
//   3. Local type definitions from the module's items
// =========================================================================

fn build_type_env(module: ResolvedModule, parent_index: Map<String, TypedModule>) -> BuildTypeEnvResult {
  // Seed the kernel with primitive types so they resolve even when
  // std.types is not in the compilation set (e.g., in isolated tests).
  let zero_span = SourceSpan { start: 0, end: 0 }
  let kernel_bindings = fold(
    ["String", "Int", "Bool", "Float", "Secret", "Json", "Unit", "Bytes"],
    init: empty_map(),
    f: (acc, name) => map_insert(acc, name, TypeBinding {
      name: name,
      resolved: leaf_node(name: name)
    })
  )
  let kernel = TypeEnv { bindings: kernel_bindings, recursive_types: [], recursive_type_set: empty_map() }

  // Collect imported type bindings from parent modules.
  // For type resolution to work on imported types (e.g., FileClassification
  // has a field of type MimeType), we include ALL parent type bindings,
  // not just explicitly named ones. The import list controls what the
  // module author uses directly; resolution needs the transitive picture.
  //
  // Separate folds for each map/list field so the accumulator is a bare
  // map/list (not a struct field). Rc::try_unwrap succeeds on bare
  // accumulators -- avoids O(N^2) full-map cloning per import.
  let parent_envs = flat_map(module.resolved_imports, imp => match map_get(parent_index, imp.module_path) { Some { value: typed_parent } => [typed_parent.type_env] None => [] })
  let import_bindings = fold(parent_envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.bindings))
  let import_recursive = fold(parent_envs, init: [], f: (acc, env) => concat(acc, env.recursive_types))
  let import_recursive_set = fold(parent_envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.recursive_type_set))
  let import_env = TypeEnv { bindings: import_bindings, recursive_types: import_recursive, recursive_type_set: import_recursive_set }
  let import_diags = flat_map(module.resolved_imports, imp => match map_get(parent_index, imp.module_path) { Some { value: _ } => [] None => [Diagnostic { severity: Error, message: concat("missing parent environment for imported module '", imp.module_path, "' while typechecking '", module.module.name, "'"), span: imp.target_module.value.span, module_name: module.module.name }] })

  // Collect local type definitions from module items.
  // Nodes with capabilities are registered as nominal types so they can be
  // referenced in `uses` clauses (e.g., `uses net: Network`).
  let local_bindings = fold(module.module.items, init: empty_map(), f: (acc, item) =>
    if item.connective != none {
      let type_node = Node {
        name: item.name, span: item.span, children: item.children,
        connective: item.connective, params: [], return_type: none,
        uses: [], body: none, transport: none, properties: [],
        type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false
      }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: type_node })
    } else if item.return_type != none && item.params |> count == 0 && item.body == none {
      // Type alias: connective is none, but return_type references the aliased type
      // For aliases, create a leaf node referencing the aliased type
      let alias_node = Node {
        name: item.name, span: item.span, children: [],
        connective: none, params: [], return_type: item.return_type,
        uses: [], body: none, transport: none, properties: [],
        type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false
      }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: alias_node })
    } else if item.transport == none && item.children |> count > 0 {
      let ref_node = Node {
        name: item.name, span: item.span, children: [],
        connective: none, params: [],
        return_type: Some { value: leaf_node(name: item.name) },
        uses: [], body: none, transport: none, properties: [],
        type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false
      }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: ref_node })
    } else if item.properties |> count > 0 && item.connective == none && item.transport == none && item.return_type == none && item.params |> count == 0 {
      // Resource declaration: has properties (kind, mode) but no children/connective.
      // Register as a nominal type so it can be referenced in `uses` clauses.
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: leaf_node(name: item.name) })
    } else {
      acc
    }
  )
  let local_env = TypeEnv { bindings: local_bindings, recursive_types: [], recursive_type_set: empty_map() }

  // Merge in shadowing order: kernel < imports < local.
  let merged = merge_envs(envs: [kernel, import_env, local_env])
  // Precompute which types participate in cycles. Used by resolve_node
  // to break recursive expansion without threading a growing resolving list.
  let cycle_set = detect_type_cycles(bindings: merged.bindings)
  let cycle_map = fold(cycle_set, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
  let unresolved_env = TypeEnv { bindings: merged.bindings, recursive_types: cycle_set, recursive_type_set: cycle_map }
  // Resolve only LOCAL type bindings. Imported bindings are already resolved.
  let local_name_set = fold(map_values(local_bindings), init: empty_map(), f: (acc, b) => map_insert(acc, b.name, true))
  let resolved = resolve_env_bindings(env: unresolved_env, module_name: module.module.name, local_names: local_name_set)
  let resolved_env_out = resolved.env
  let resolved_diags = resolved.diagnostics
  BuildTypeEnvResult {
    env: resolved_env_out,
    diagnostics: concat(import_diags, resolved_diags)
  }
}

// Diagnostic variant: stops after cycle detection, before resolve_env_bindings.
// Used by the per-module profile test to isolate whether OOM is in
// merge+cycles vs type resolution.
fn build_type_env_unresolved(module: ResolvedModule, parent_index: Map<String, TypedModule>) -> BuildTypeEnvResult {
  let zero_span = SourceSpan { start: 0, end: 0 }
  let kernel_bindings = fold(
    ["String", "Int", "Bool", "Float", "Secret", "Json", "Unit", "Bytes"],
    init: empty_map(),
    f: (acc, name) => map_insert(acc, name, TypeBinding { name: name, resolved: leaf_node(name: name) })
  )
  let kernel = TypeEnv { bindings: kernel_bindings, recursive_types: [], recursive_type_set: empty_map() }
  let parent_envs = flat_map(module.resolved_imports, imp => match map_get(parent_index, imp.module_path) { Some { value: typed_parent } => [typed_parent.type_env] None => [] })
  let import_bindings = fold(parent_envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.bindings))
  let import_recursive = fold(parent_envs, init: [], f: (acc, env) => concat(acc, env.recursive_types))
  let import_recursive_set = fold(parent_envs, init: empty_map(), f: (acc, env) => map_merge(acc, env.recursive_type_set))
  let import_env = TypeEnv { bindings: import_bindings, recursive_types: import_recursive, recursive_type_set: import_recursive_set }
  let local_bindings = fold(module.module.items, init: empty_map(), f: (acc, item) =>
    if item.connective != none {
      let type_node = Node { name: item.name, span: item.span, children: item.children, connective: item.connective, params: [], return_type: none, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: type_node })
    } else if item.return_type != none && item.params |> count == 0 && item.body == none {
      let alias_node = Node { name: item.name, span: item.span, children: [], connective: none, params: [], return_type: item.return_type, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: alias_node })
    } else if item.transport == none && item.children |> count > 0 {
      let ref_node = Node { name: item.name, span: item.span, children: [], connective: none, params: [], return_type: Some { value: leaf_node(name: item.name) }, uses: [], body: none, transport: none, properties: [], type_annotation: none, config: none, is_self_recursive: false, has_non_tail_self_call: false }
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: ref_node })
    } else if item.properties |> count > 0 && item.connective == none && item.transport == none && item.return_type == none && item.params |> count == 0 {
      map_insert(acc, item.name, TypeBinding { name: item.name, resolved: leaf_node(name: item.name) })
    } else {
      acc
    }
  )
  let local_env = TypeEnv { bindings: local_bindings, recursive_types: [], recursive_type_set: empty_map() }
  let merged = merge_envs(envs: [kernel, import_env, local_env])
  let cycle_set = detect_type_cycles(bindings: merged.bindings)
  let cycle_map = fold(cycle_set, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
  let unresolved_env = TypeEnv { bindings: merged.bindings, recursive_types: cycle_set, recursive_type_set: cycle_map }
  BuildTypeEnvResult { env: unresolved_env, diagnostics: [] }
}

// =========================================================================
// Resolve a Node type reference
//
// Walks the Node type tree, replacing leaf Named references with their
// structural definitions from the environment. Dispatches on Node
// structure (connective, children).
// =========================================================================

fn resolve_node(n: Node, env: TypeEnv, module_name: String) -> NodeResolveResult {
  resolve_node_bounded(n: n, env: env, module_name: module_name, depth: 0)
}

fn resolve_node_bounded(n: Node, env: TypeEnv, module_name: String, depth: Int) -> NodeResolveResult {
  // Defensive depth limit: with topological resolution ordering, this should
  // never fire. If it does, there is a bug in topo_resolve_types dependency analysis.
  if depth > 100 {
    return NodeResolveResult {
      resolved: n,
      diagnostics: [Diagnostic {
        severity: Error,
        message: concat("internal: type resolution exceeded depth 100 for '", n.name, "'"),
        span: n.span,
        module_name: module_name
      }]
    }
  }
  if n.connective != none {
    match n.connective.value {
      Conj =>
        if n.name == "Refined" {
          // Refined: recurse on first child (base type)
          match n.children |> first {
            Some { value: base } =>
              let base_result = resolve_node_bounded(n: base, env: env, module_name: module_name, depth: depth + 1)
              let base_resolved = base_result.resolved
              let base_diags = base_result.diagnostics
              NodeResolveResult {
                resolved: Node { name: n.name, span: n.span, children: [base_resolved], connective: n.connective, params: n.params, return_type: n.return_type, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, config: n.config, is_self_recursive: false, has_non_tail_self_call: false },
                diagnostics: base_diags
              }
            None => NodeResolveResult { resolved: n, diagnostics: [] }
          }
        } else {
          // Product: recurse on each child's return_type
          let child_results = map(n.children, child =>
            if child.return_type == none {
              NodeResolveResult { resolved: child, diagnostics: [] }
            } else {
              let rt_result = resolve_node_bounded(n: child.return_type.value, env: env, module_name: module_name, depth: depth + 1)
              let rt_resolved = rt_result.resolved
              let rt_diags = rt_result.diagnostics
              NodeResolveResult {
                resolved: Node { name: child.name, span: child.span, children: child.children, connective: child.connective, params: child.params, return_type: Some { value: rt_resolved }, uses: child.uses, body: child.body, transport: child.transport, properties: child.properties, type_annotation: child.type_annotation, config: child.config, is_self_recursive: false, has_non_tail_self_call: false },
                diagnostics: rt_diags
              }
            }
          )
          let resolved_children = map(child_results, cr => cr.resolved)
          let all_diags = flat_map(child_results, cr => cr.diagnostics)
          NodeResolveResult {
            resolved: Node { name: n.name, span: n.span, children: resolved_children, connective: n.connective, params: n.params, return_type: n.return_type, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, config: n.config, is_self_recursive: false, has_non_tail_self_call: false },
            diagnostics: all_diags
          }
        }
      Disj =>
        if n.name == "Optional" {
          // Optional: recurse on first child (inner type)
          match n.children |> first {
            Some { value: inner } =>
              let inner_result = resolve_node_bounded(n: inner, env: env, module_name: module_name, depth: depth + 1)
              let inner_resolved = inner_result.resolved
              let inner_diags = inner_result.diagnostics
              let none_node = match skip(n.children, 1) |> first {
                Some { value: none_child } => none_child
                None => leaf_node(name: "None")
              }
              NodeResolveResult {
                resolved: Node { name: n.name, span: n.span, children: [inner_resolved, none_node], connective: n.connective, params: n.params, return_type: n.return_type, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, config: n.config, is_self_recursive: false, has_non_tail_self_call: false },
                diagnostics: inner_diags
              }
            None => NodeResolveResult { resolved: n, diagnostics: [] }
          }
        } else {
          // Coproduct: recurse on each variant child's children's return_types
          let variant_results = map(n.children, variant_child =>
            let field_results = map(variant_child.children, field_child =>
              if field_child.return_type == none {
                NodeResolveResult { resolved: field_child, diagnostics: [] }
              } else {
                let rt_result = resolve_node_bounded(n: field_child.return_type.value, env: env, module_name: module_name, depth: depth + 1)
                let rt_resolved = rt_result.resolved
                let rt_diags = rt_result.diagnostics
                NodeResolveResult {
                  resolved: Node { name: field_child.name, span: field_child.span, children: field_child.children, connective: field_child.connective, params: field_child.params, return_type: Some { value: rt_resolved }, uses: field_child.uses, body: field_child.body, transport: field_child.transport, properties: field_child.properties, type_annotation: field_child.type_annotation, config: field_child.config, is_self_recursive: false, has_non_tail_self_call: false },
                  diagnostics: rt_diags
                }
              }
            )
            let resolved_fields = map(field_results, fr => fr.resolved)
            let field_diags = flat_map(field_results, fr => fr.diagnostics)
            NodeResolveResult {
              resolved: Node { name: variant_child.name, span: variant_child.span, children: resolved_fields, connective: variant_child.connective, params: variant_child.params, return_type: variant_child.return_type, uses: variant_child.uses, body: variant_child.body, transport: variant_child.transport, properties: variant_child.properties, type_annotation: variant_child.type_annotation, config: variant_child.config, is_self_recursive: false, has_non_tail_self_call: false },
              diagnostics: field_diags
            }
          )
          let resolved_variants = map(variant_results, vr => vr.resolved)
          let all_diags = flat_map(variant_results, vr => vr.diagnostics)
          NodeResolveResult {
            resolved: Node { name: n.name, span: n.span, children: resolved_variants, connective: n.connective, params: n.params, return_type: n.return_type, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, config: n.config, is_self_recursive: false, has_non_tail_self_call: false },
            diagnostics: all_diags
          }
        }
    }
  } else if n.name == "Map" && n.children |> count == 2 {
    // Map: recurse on both key and value children
    let key_child = match n.children |> first {
      Some { value: k } => k
      None => leaf_node(name: "String")
    }
    let val_child = match skip(n.children, 1) |> first {
      Some { value: v } => v
      None => leaf_node(name: "Unit")
    }
    let key_result = resolve_node_bounded(n: key_child, env: env, module_name: module_name, depth: depth + 1)
    let key_resolved = key_result.resolved
    let key_diags = key_result.diagnostics
    let val_result = resolve_node_bounded(n: val_child, env: env, module_name: module_name, depth: depth + 1)
    let val_resolved = val_result.resolved
    let val_diags = val_result.diagnostics
    NodeResolveResult {
      resolved: Node { name: n.name, span: n.span, children: [key_resolved, val_resolved], connective: n.connective, params: n.params, return_type: n.return_type, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, config: n.config, is_self_recursive: false, has_non_tail_self_call: false },
      diagnostics: concat(key_diags, val_diags)
    }
  } else if n.children |> count == 1 {
    // Container (List, Set, etc.): recurse on single child (element type)
    match n.children |> first {
      Some { value: el } =>
        let el_result = resolve_node_bounded(n: el, env: env, module_name: module_name, depth: depth + 1)
        let el_resolved = el_result.resolved
        let el_diags = el_result.diagnostics
        NodeResolveResult {
          resolved: Node { name: n.name, span: n.span, children: [el_resolved], connective: n.connective, params: n.params, return_type: n.return_type, uses: n.uses, body: n.body, transport: n.transport, properties: n.properties, type_annotation: n.type_annotation, config: n.config, is_self_recursive: false, has_non_tail_self_call: false },
          diagnostics: el_diags
        }
      None => NodeResolveResult { resolved: n, diagnostics: [] }
    }
  } else if n.children |> count == 0 {
    // Leaf node: lookup in env, recurse if found
    if is_recursive_type(env: env, name: n.name) {
      NodeResolveResult { resolved: n, diagnostics: [] }
    } else {
      match lookup_type(env: env, name: n.name) {
        Some { value: resolved } =>
          if resolved.children |> count == 0 && resolved.connective == none && resolved.name == n.name {
            NodeResolveResult { resolved: resolved, diagnostics: [] }
          } else {
            resolve_node_bounded(n: resolved, env: env, module_name: module_name, depth: depth + 1)
          }
        None =>
          if n.name == "String" || n.name == "Int" || n.name == "Bool" || n.name == "Float" || n.name == "Secret" || n.name == "Json" || n.name == "Unit" || n.name == "Bytes" {
            NodeResolveResult { resolved: n, diagnostics: [] }
          } else {
            NodeResolveResult {
              resolved: n,
              diagnostics: [Diagnostic {
                severity: Error,
                message: concat("unresolved type '", n.name, "'"),
                span: n.span,
                module_name: module_name
              }]
            }
          }
      }
    }
  } else {
    // Unknown structure -- pass through
    NodeResolveResult { resolved: n, diagnostics: [] }
  }
}

fn resolve_optional_node(n: Node?, env: TypeEnv, module_name: String) -> NodeResolveResult {
  if n == none {
    NodeResolveResult { resolved: leaf_node(name: "Unit"), diagnostics: [] }
  } else {
    resolve_node(n: n.value, env: env, module_name: module_name)
  }
}

// =========================================================================
// Field resolution
// =========================================================================

fn resolve_field(field: Field, env: TypeEnv, module_name: String) -> FieldResult {
  let type_result = resolve_node(n: field.type_expr, env: env, module_name: module_name)
  let type_resolved = type_result.resolved
  let type_diags = type_result.diagnostics
  let default_result = if field.default_value == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: field.default_value.value, env: env, module_name: module_name)
  }
  let default_expr = default_result.expr
  let default_diags = default_result.diagnostics
  FieldResult {
    field: Field {
      name: field.name,
      type_expr: type_resolved,
      optional: field.optional,
      default_value: if field.default_value == none { none } else { Some { value: default_expr } },
      from_key: field.from_key,
      span: field.span
    },
    diagnostics: concat(type_diags, default_diags)
  }
}

// =========================================================================
// Param resolution
// =========================================================================

fn resolve_param(param: Param, env: TypeEnv, module_name: String) -> ParamResult {
  let type_result = resolve_node(n: param.type_expr, env: env, module_name: module_name)
  let type_resolved = type_result.resolved
  let type_diags = type_result.diagnostics
  let default_result = if param.default_value == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: param.default_value.value, env: env, module_name: module_name)
  }
  let default_expr = default_result.expr
  let default_diags = default_result.diagnostics
  ParamResult {
    param: Param {
      name: param.name,
      type_expr: type_resolved,
      default_value: if param.default_value == none { none } else { Some { value: default_expr } },
      span: param.span
    },
    diagnostics: concat(type_diags, default_diags)
  }
}

// =========================================================================
// Operation resolution
// =========================================================================

// =========================================================================
// ResourceUse resolution
// =========================================================================

fn resolve_resource_use(ru: ResourceUse, env: TypeEnv, module_name: String) -> ResourceUseResult {
  let type_result = resolve_node(n: ru.resource, env: env, module_name: module_name)
  let type_resolved = type_result.resolved
  let type_diags = type_result.diagnostics
  ResourceUseResult {
    resource_use: ResourceUse {
      name: ru.name,
      resource: type_resolved,
      span: ru.span
    },
    diagnostics: type_diags
  }
}

fn resolve_named_arg(arg: NamedArg, env: TypeEnv, module_name: String) -> NamedArgResolveResult {
  let value_result = resolve_expr_types(expr: arg.value, env: env, module_name: module_name)
  let value_expr = value_result.expr
  let value_diags = value_result.diagnostics
  NamedArgResolveResult {
    arg: NamedArg { name: arg.name, value: value_expr },
    diagnostics: value_diags
  }
}

fn resolve_field_init(field_init: FieldInit, env: TypeEnv, module_name: String) -> FieldInitResolveResult {
  let value_result = resolve_expr_types(expr: field_init.value, env: env, module_name: module_name)
  let value_expr = value_result.expr
  let value_diags = value_result.diagnostics
  FieldInitResolveResult {
    field_init: FieldInit { name: field_init.name, value: value_expr },
    diagnostics: value_diags
  }
}

fn resolve_match_arm(arm: MatchArm, env: TypeEnv, module_name: String) -> MatchArmResolveResult {
  let guard_result = if arm.guard == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: arm.guard.value, env: env, module_name: module_name)
  }
  let guard_expr = guard_result.expr
  let guard_diags = guard_result.diagnostics
  let body_result = resolve_expr_types(expr: arm.body, env: env, module_name: module_name)
  let body_expr = body_result.expr
  let body_diags = body_result.diagnostics
  MatchArmResolveResult {
    arm: MatchArm {
      pattern: arm.pattern,
      guard: if arm.guard == none { none } else { Some { value: guard_expr } },
      body: body_expr
    },
    diagnostics: concat(guard_diags, body_diags)
  }
}

fn resolve_string_part(part: StringPart, env: TypeEnv, module_name: String) -> StringPartResolveResult {
  match part {
    Text { value: value } =>
      StringPartResolveResult {
        part: Text { value: value },
        diagnostics: []
      }
    Interpolation { expr: expr } =>
      let expr_result = resolve_expr_types(expr: expr, env: env, module_name: module_name)
      let resolved_expr = expr_result.expr
      let expr_diags = expr_result.diagnostics
      StringPartResolveResult {
        part: Interpolation { expr: resolved_expr },
        diagnostics: expr_diags
      }
  }
}

fn resolve_header_def(header: HeaderDef, env: TypeEnv, module_name: String) -> HeaderResolveResult {
  let value_result = resolve_expr_types(expr: header.value, env: env, module_name: module_name)
  let value_expr = value_result.expr
  let value_diags = value_result.diagnostics
  HeaderResolveResult {
    header: HeaderDef { name: header.name, value: value_expr },
    diagnostics: value_diags
  }
}

fn resolve_env_def(env_def: EnvDef, env: TypeEnv, module_name: String) -> EnvDefResolveResult {
  let value_result = resolve_expr_types(expr: env_def.value, env: env, module_name: module_name)
  let value_expr = value_result.expr
  let value_diags = value_result.diagnostics
  EnvDefResolveResult {
    env_def: EnvDef { name: env_def.name, value: value_expr },
    diagnostics: value_diags
  }
}

fn resolve_auth_config(config: AuthConfig, env: TypeEnv, module_name: String) -> AuthConfigResolveResult {
  let token_result = resolve_expr_types(expr: config.token_expr, env: env, module_name: module_name)
  let token_expr = token_result.expr
  let token_diags = token_result.diagnostics
  AuthConfigResolveResult {
    config: AuthConfig {
      scheme: config.scheme,
      header: config.header,
      token_expr: token_expr
    },
    diagnostics: token_diags
  }
}

fn resolve_service_config(config: ServiceConfig, env: TypeEnv, module_name: String) -> ServiceConfigResolveResult {
  let endpoint_result = resolve_expr_types(expr: config.endpoint, env: env, module_name: module_name)
  let endpoint_expr = endpoint_result.expr
  let endpoint_diags = endpoint_result.diagnostics
  let auth_result = if config.auth == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.auth.value, env: env, module_name: module_name)
  }
  let auth_expr = auth_result.expr
  let auth_diags = auth_result.diagnostics
  let rate_result = if config.rate_limit == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.rate_limit.value, env: env, module_name: module_name)
  }
  let rate_expr = rate_result.expr
  let rate_diags = rate_result.diagnostics
  let retry_result = if config.retry == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: config.retry.value, env: env, module_name: module_name)
  }
  let retry_expr = retry_result.expr
  let retry_diags = retry_result.diagnostics
  ServiceConfigResolveResult {
    config: ServiceConfig {
      endpoint: endpoint_expr,
      auth: if config.auth == none { none } else { Some { value: auth_expr } },
      rate_limit: if config.rate_limit == none { none } else { Some { value: rate_expr } },
      retry: if config.retry == none { none } else { Some { value: retry_expr } }
    },
    diagnostics: concat(endpoint_diags, auth_diags, rate_diags, retry_diags)
  }
}

fn resolve_transport_binding(transport: TransportBinding, env: TypeEnv, module_name: String) -> TransportResolveResult {
  match transport {
    RestBinding { base_url: base_url, auth: auth, headers: headers } =>
      let base_result = resolve_expr_types(expr: base_url, env: env, module_name: module_name)
      let base_expr = base_result.expr
      let base_diags = base_result.diagnostics
      let auth_result = if auth == none {
        AuthConfigResolveResult {
          config: AuthConfig { scheme: "", header: "", token_expr: Literal { value: LitNull, span: no_span() } },
          diagnostics: []
        }
      } else {
        resolve_auth_config(config: auth.value, env: env, module_name: module_name)
      }
      let auth_config = auth_result.config
      let auth_diags = auth_result.diagnostics
      let header_results = map(headers, h => resolve_header_def(header: h, env: env, module_name: module_name))
      let resolved_headers = map(header_results, hr => hr.header)
      let header_diags = flat_map(header_results, hr => hr.diagnostics)
      TransportResolveResult {
        transport: RestBinding {
          base_url: base_expr,
          auth: if auth == none { none } else { Some { value: auth_config } },
          headers: resolved_headers
        },
        diagnostics: concat(base_diags, auth_diags, header_diags)
      }
    ShellBinding { argv: argv, env: env_defs } =>
      let argv_results = map(argv, arg => resolve_expr_types(expr: arg, env: env, module_name: module_name))
      let env_results = map(env_defs, entry => resolve_env_def(env_def: entry, env: env, module_name: module_name))
      let resolved_argv = map(argv_results, r => r.expr)
      let resolved_env_defs = map(env_results, r => r.env_def)
      let argv_diags = flat_map(argv_results, r => r.diagnostics)
      let env_diags = flat_map(env_results, r => r.diagnostics)
      TransportResolveResult {
        transport: ShellBinding { argv: resolved_argv, env: resolved_env_defs },
        diagnostics: concat(argv_diags, env_diags)
      }
    FileBinding { base_path: base_path } =>
      let base_result = resolve_expr_types(expr: base_path, env: env, module_name: module_name)
      let base_expr = base_result.expr
      let base_diags = base_result.diagnostics
      TransportResolveResult {
        transport: FileBinding { base_path: base_expr },
        diagnostics: base_diags
      }
    LocalBinding =>
      TransportResolveResult { transport: LocalBinding, diagnostics: [] }
  }
}

fn resolve_expr_types(expr: Expr, env: TypeEnv, module_name: String) -> ExprResolveResult {
  match expr {
    Literal { value: _, span: _ } =>
      ExprResolveResult { expr: expr, diagnostics: [] }
    Var { name: _, span: _ } =>
      ExprResolveResult { expr: expr, diagnostics: [] }

    FieldAccess { base: base, field: field, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      let base_expr = base_result.expr
      let base_diags = base_result.diagnostics
      ExprResolveResult {
        expr: FieldAccess { base: base_expr, field: field, span: span },
        diagnostics: base_diags
      }

    Call { func: func, args: args, span: span } =>
      let arg_results = map(args, arg => resolve_named_arg(arg: arg, env: env, module_name: module_name))
      let resolved_args = map(arg_results, ar => ar.arg)
      let arg_diags = flat_map(arg_results, ar => ar.diagnostics)
      ExprResolveResult {
        expr: Call { func: func, args: resolved_args, span: span },
        diagnostics: arg_diags
      }

    MethodCall { receiver: receiver, method: method, args: args, span: span } =>
      let recv_result = resolve_expr_types(expr: receiver, env: env, module_name: module_name)
      let recv_expr = recv_result.expr
      let recv_diags = recv_result.diagnostics
      let arg_results = map(args, arg => resolve_named_arg(arg: arg, env: env, module_name: module_name))
      let resolved_args = map(arg_results, ar => ar.arg)
      let arg_diags = flat_map(arg_results, ar => ar.diagnostics)
      ExprResolveResult {
        expr: MethodCall { receiver: recv_expr, method: method, args: resolved_args, span: span },
        diagnostics: concat(recv_diags, arg_diags)
      }

    Match { scrutinee: scrutinee, arms: arms, span: span } =>
      let scrutinee_result = resolve_expr_types(expr: scrutinee, env: env, module_name: module_name)
      let scrutinee_expr = scrutinee_result.expr
      let scrutinee_diags = scrutinee_result.diagnostics
      let arm_results = map(arms, arm => resolve_match_arm(arm: arm, env: env, module_name: module_name))
      let resolved_arms = map(arm_results, ar => ar.arm)
      let arm_diags = flat_map(arm_results, ar => ar.diagnostics)
      ExprResolveResult {
        expr: Match { scrutinee: scrutinee_expr, arms: resolved_arms, span: span },
        diagnostics: concat(scrutinee_diags, arm_diags)
      }

    If { condition: condition, then_branch: then_branch, else_branch: else_branch, span: span } =>
      let cond_result = resolve_expr_types(expr: condition, env: env, module_name: module_name)
      let cond_expr = cond_result.expr
      let cond_diags = cond_result.diagnostics
      let then_result = resolve_expr_types(expr: then_branch, env: env, module_name: module_name)
      let then_expr = then_result.expr
      let then_diags = then_result.diagnostics
      let else_result = if else_branch == none {
        ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
      } else {
        resolve_expr_types(expr: else_branch.value, env: env, module_name: module_name)
      }
      let else_expr = else_result.expr
      let else_diags = else_result.diagnostics
      ExprResolveResult {
        expr: If {
          condition: cond_expr,
          then_branch: then_expr,
          else_branch: if else_branch == none { none } else { Some { value: else_expr } },
          span: span
        },
        diagnostics: concat(cond_diags, then_diags, else_diags)
      }

    Let { name: name, value: value, body: body, span: span } =>
      let value_result = resolve_expr_types(expr: value, env: env, module_name: module_name)
      let value_expr = value_result.expr
      let value_diags = value_result.diagnostics
      let body_result = if body == none {
        ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
      } else {
        resolve_expr_types(expr: body.value, env: env, module_name: module_name)
      }
      let body_expr = body_result.expr
      let body_diags = body_result.diagnostics
      ExprResolveResult {
        expr: Let {
          name: name,
          value: value_expr,
          body: if body == none { none } else { Some { value: body_expr } },
          span: span
        },
        diagnostics: concat(value_diags, body_diags)
      }

    RecordLit { type_name: type_name, fields: fields, span: span } =>
      let field_results = map(fields, field_init => resolve_field_init(field_init: field_init, env: env, module_name: module_name))
      let resolved_fields = map(field_results, fr => fr.field_init)
      let field_diags = flat_map(field_results, fr => fr.diagnostics)
      ExprResolveResult {
        expr: RecordLit { type_name: type_name, fields: resolved_fields, span: span },
        diagnostics: field_diags
      }

    ListLit { elements: elements, span: span } =>
      let element_results = map(elements, element => resolve_expr_types(expr: element, env: env, module_name: module_name))
      let resolved_elements = map(element_results, er => er.expr)
      let element_diags = flat_map(element_results, er => er.diagnostics)
      ExprResolveResult {
        expr: ListLit { elements: resolved_elements, span: span },
        diagnostics: element_diags
      }

    BinOp { op: op, left: left, right: right, span: span } =>
      let left_result = resolve_expr_types(expr: left, env: env, module_name: module_name)
      let left_expr = left_result.expr
      let left_diags = left_result.diagnostics
      let right_result = resolve_expr_types(expr: right, env: env, module_name: module_name)
      let right_expr = right_result.expr
      let right_diags = right_result.diagnostics
      ExprResolveResult {
        expr: BinOp { op: op, left: left_expr, right: right_expr, span: span },
        diagnostics: concat(left_diags, right_diags)
      }

    UnaryOp { op: op, operand: operand, span: span } =>
      let operand_result = resolve_expr_types(expr: operand, env: env, module_name: module_name)
      let operand_expr = operand_result.expr
      let operand_diags = operand_result.diagnostics
      ExprResolveResult {
        expr: UnaryOp { op: op, operand: operand_expr, span: span },
        diagnostics: operand_diags
      }

    Lambda { params: params, body: body, span: span } =>
      let body_result = resolve_expr_types(expr: body, env: env, module_name: module_name)
      let body_expr = body_result.expr
      let body_diags = body_result.diagnostics
      ExprResolveResult {
        expr: Lambda { params: params, body: body_expr, span: span },
        diagnostics: body_diags
      }

    StringInterp { parts: parts, span: span } =>
      let part_results = map(parts, part => resolve_string_part(part: part, env: env, module_name: module_name))
      let resolved_parts = map(part_results, pr => pr.part)
      let part_diags = flat_map(part_results, pr => pr.diagnostics)
      ExprResolveResult {
        expr: StringInterp { parts: resolved_parts, span: span },
        diagnostics: part_diags
      }

    Block { stmts: stmts, span: span } =>
      let stmt_results = map(stmts, stmt => resolve_expr_types(expr: stmt, env: env, module_name: module_name))
      let resolved_stmts = map(stmt_results, sr => sr.expr)
      let stmt_diags = flat_map(stmt_results, sr => sr.diagnostics)
      ExprResolveResult {
        expr: Block { stmts: resolved_stmts, span: span },
        diagnostics: stmt_diags
      }

    Cast { expr: inner, target: target, span: span } =>
      let expr_result = resolve_expr_types(expr: inner, env: env, module_name: module_name)
      let cast_expr = expr_result.expr
      let cast_diags = expr_result.diagnostics
      let type_result = resolve_node(n: target, env: env, module_name: module_name)
      let type_resolved = type_result.resolved
      let type_diags = type_result.diagnostics
      ExprResolveResult {
        expr: Cast { expr: cast_expr, target: type_resolved, span: span },
        diagnostics: concat(cast_diags, type_diags)
      }

    ForEach { variable: variable, collection: collection, body: body, span: span } =>
      let collection_result = resolve_expr_types(expr: collection, env: env, module_name: module_name)
      let collection_expr = collection_result.expr
      let collection_diags = collection_result.diagnostics
      let body_result = resolve_expr_types(expr: body, env: env, module_name: module_name)
      let body_expr = body_result.expr
      let body_diags = body_result.diagnostics
      ExprResolveResult {
        expr: ForEach {
          variable: variable,
          collection: collection_expr,
          body: body_expr,
          span: span
        },
        diagnostics: concat(collection_diags, body_diags)
      }

    Index { base: base, index: index, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      let base_expr = base_result.expr
      let base_diags = base_result.diagnostics
      let index_result = resolve_expr_types(expr: index, env: env, module_name: module_name)
      let index_expr = index_result.expr
      let index_diags = index_result.diagnostics
      ExprResolveResult {
        expr: Index { base: base_expr, index: index_expr, span: span },
        diagnostics: concat(base_diags, index_diags)
      }

    Slice { base: base, start: start, end: end, span: span } =>
      let base_result = resolve_expr_types(expr: base, env: env, module_name: module_name)
      let base_expr = base_result.expr
      let base_diags = base_result.diagnostics
      let start_result = resolve_expr_types(expr: start, env: env, module_name: module_name)
      let start_expr = start_result.expr
      let start_diags = start_result.diagnostics
      let end_result = resolve_expr_types(expr: end, env: env, module_name: module_name)
      let end_expr = end_result.expr
      let end_diags = end_result.diagnostics
      ExprResolveResult {
        expr: Slice {
          base: base_expr,
          start: start_expr,
          end: end_expr,
          span: span
        },
        diagnostics: concat(base_diags, start_diags, end_diags)
      }

    Return { value: inner, span: span } =>
      let inner_result = resolve_expr_types(expr: inner, env: env, module_name: module_name)
      ExprResolveResult {
        expr: Return { value: inner_result.expr, span: span },
        diagnostics: inner_result.diagnostics
      }
  }
}

// =========================================================================
// Resolve all type expressions within a single Node
//
// Walks through the item's type references (params, return types,
// field types, etc.) and resolves each one against the environment.
// =========================================================================

fn resolve_item_types(item: Node, env: TypeEnv, module_name: String) -> ItemResult {
  // Resolve params
  let param_results = map(item.params, p => resolve_param(param: p, env: env, module_name: module_name))
  let resolved_params = map(param_results, pr => pr.param)
  let param_diags = flat_map(param_results, pr => pr.diagnostics)

  // Resolve return type
  let ret_result = resolve_optional_node(n: item.return_type, env: env, module_name: module_name)
  let ret_resolved = ret_result.resolved
  let ret_diags = ret_result.diagnostics
  let resolved_ret = if item.return_type == none { none } else { Some { value: ret_resolved } }

  // Resolve uses
  let use_results = map(item.uses, u => resolve_resource_use(ru: u, env: env, module_name: module_name))
  let resolved_uses = map(use_results, ur => ur.resource_use)
  let use_diags = flat_map(use_results, ur => ur.diagnostics)

  // Resolve body if present
  let body_resolved = if item.body == none {
    ExprResolveResult { expr: Literal { value: LitNull, span: no_span() }, diagnostics: [] }
  } else {
    resolve_expr_types(expr: item.body.value, env: env, module_name: module_name)
  }
  let resolved_body = if item.body == none { none } else { Some { value: body_resolved.expr } }
  let body_diags = body_resolved.diagnostics

  // Resolve type_annotation if present
  let anno_resolved = if item.type_annotation == none {
    NodeResolveResult { resolved: leaf_node(name: "Unit"), diagnostics: [] }
  } else {
    resolve_node(n: item.type_annotation.value, env: env, module_name: module_name)
  }
  let resolved_anno = if item.type_annotation == none { none } else { Some { value: anno_resolved.resolved } }
  let anno_diags = anno_resolved.diagnostics

  // Resolve transport if present
  let transport_resolved = if item.transport == none {
    TransportResolveResult { transport: LocalBinding, diagnostics: [] }
  } else {
    resolve_transport_binding(transport: item.transport.value, env: env, module_name: module_name)
  }
  let resolved_transport = if item.transport == none { none } else { Some { value: transport_resolved.transport } }
  let transport_diags = transport_resolved.diagnostics

  // Resolve config if present
  let config_resolved = if item.config == none {
    ServiceConfigResolveResult {
      config: ServiceConfig { endpoint: Literal { value: LitNull, span: no_span() }, auth: none, rate_limit: none, retry: none },
      diagnostics: []
    }
  } else {
    resolve_service_config(config: item.config.value, env: env, module_name: module_name)
  }
  let resolved_config = if item.config == none { none } else { Some { value: config_resolved.config } }
  let config_diags = config_resolved.diagnostics

  // Resolve properties
  let prop_results = map(item.properties, p => resolve_field_init(field_init: p, env: env, module_name: module_name))
  let resolved_props = map(prop_results, pr => pr.field_init)
  let prop_diags = flat_map(prop_results, pr => pr.diagnostics)

  // Resolve children recursively (W11: operations/capabilities as child Nodes)
  let child_results = map(item.children, child => resolve_item_types(item: child, env: env, module_name: module_name))
  let resolved_children = map(child_results, cr => cr.item)
  let child_diags = flat_map(child_results, cr => cr.diagnostics)

  ItemResult {
    item: Node {
      name: item.name, span: item.span, children: resolved_children,
      params: resolved_params, return_type: resolved_ret,
      uses: resolved_uses, body: resolved_body,
      connective: item.connective, transport: resolved_transport,
      properties: resolved_props, type_annotation: resolved_anno,
      config: resolved_config, is_self_recursive: false, has_non_tail_self_call: false
    },
    diagnostics: concat(param_diags, ret_diags, use_diags, body_diags, anno_diags, transport_diags, config_diags, prop_diags, child_diags)
  }
}

fn item_kind(item: Node) -> ItemKind {
  if item.connective != none && item.transport == none {
    TypeItem
  } else if item.transport != none {
    ServiceItem
  } else if item.body != none && item.uses |> count > 0 {
    FuncItem
  } else if item.body != none && item.params |> count > 0 {
    FnItem
  } else if item.body != none {
    DataItem
  } else {
    OtherItem
  }
}

fn build_item_info(item: Node) -> ItemInfo {
  let kind = item_kind(item: item)
  match kind {
    FuncItem =>
      ItemInfo {
        name: item.name,
        kind: kind,
        service_names: if item.body == none { [] } else { collect_typed_service_calls(texpr: item.body.value) },
        is_self_recursive: false,
        has_non_tail_self_call: false
      }
    FnItem =>
      ItemInfo {
        name: item.name,
        kind: kind,
        service_names: [],
        is_self_recursive: if item.body == none { false } else { expr_has_self_call(expr: item.body.value, fn_name: item.name) },
        has_non_tail_self_call: if item.body == none { false } else { expr_has_non_tail_self_call(expr: item.body.value, fn_name: item.name, in_tail: true) }
      }
    _ =>
      ItemInfo {
        name: item.name,
        kind: kind,
        service_names: [],
        is_self_recursive: false,
        has_non_tail_self_call: false
      }
  }
}

fn analyze_item(item: Node, env: TypeEnv, module_name: String) -> ItemContribution {
  let resolved = resolve_item_types(item: item, env: env, module_name: module_name)
  let ritem = resolved.item
  let func_sig = if ritem.params |> count > 0 {
    Some { value: DeclaredFuncSig {
      name: ritem.name,
      params: ritem.params,
      return_type: ritem.return_type,
      is_async: ritem.uses |> count > 0
    } }
  } else {
    none
  }
  let svc_entries = if ritem.transport != none && ritem.children |> count > 0 {
    ritem.children |> map(c => service_op_entry(child: c))
  } else {
    []
  }
  let svc_local = if ritem.transport != none && ritem.children |> count > 0 {
    let root = namespace_root_from_properties(properties: ritem.properties, name: ritem.name)
    Some { value: TypeBinding { name: root, resolved: leaf_node(name: root) } }
  } else {
    none
  }
  let variant_locals = match ritem.connective {
    Some { value: Disj } =>
      if is_recursive_type(env: env, name: ritem.name) {
        ritem.children |> map(child =>
          TypeBinding {
            name: child.name,
            resolved: leaf_node(name: ritem.name)
          }
        )
      } else {
        []
      }
    _ => []
  }
  ItemContribution {
    resolved_item: ritem,
    resolve_diagnostics: resolved.diagnostics,
    func_sig: func_sig,
    svc_entries: svc_entries,
    svc_local: svc_local,
    variant_locals: variant_locals,
    item_info: build_item_info(item: ritem)
  }
}

fn fold_module_contributions(remaining: List<ItemContribution>,
    resolved_items: List<Node>,
    func_sigs: Map<String, DeclaredFuncSig>,
    svc_registry: Map<String, List<OpEntry>>,
    svc_locals: Map<String, TypeBinding>,
    variant_locals: Map<String, TypeBinding>,
    item_registry: Map<String, ItemInfo>,
    diag_chunks: List<List<Diagnostic>>) -> LocalContributionState {
  match remaining |> first {
    None =>
      LocalContributionState {
        resolved_items: resolved_items,
        func_sigs: func_sigs,
        svc_registry: svc_registry,
        svc_locals: svc_locals,
        variant_locals: variant_locals,
        item_registry: item_registry,
        diag_chunks: diag_chunks
      }
    Some { value: contribution } =>
      let next_func_sigs = match contribution.func_sig {
        Some { value: sig } => map_insert(func_sigs, sig.name, sig)
        None => func_sigs
      }
      let next_svc_registry = if contribution.svc_entries |> count > 0 {
        map_insert(svc_registry, contribution.resolved_item.name, contribution.svc_entries)
      } else {
        svc_registry
      }
      let next_svc_locals = match contribution.svc_local {
        Some { value: binding } => map_insert(svc_locals, binding.name, binding)
        None => svc_locals
      }
      let next_variant_locals = fold(contribution.variant_locals, init: variant_locals, f: (acc, binding) =>
        map_insert(acc, binding.name, binding)
      )
      fold_module_contributions(
        remaining: remaining |> skip(1),
        resolved_items: list_push(resolved_items, contribution.resolved_item),
        func_sigs: next_func_sigs,
        svc_registry: next_svc_registry,
        svc_locals: next_svc_locals,
        variant_locals: next_variant_locals,
        item_registry: map_insert(item_registry, contribution.item_info.name, contribution.item_info),
        diag_chunks: list_push(diag_chunks, contribution.resolve_diagnostics)
      )
  }
}

fn build_module_context(contributions: List<ItemContribution>,
    parent_index: Map<String, TypedModule>,
    resolved_imports: List<ResolvedImport>,
    env: TypeEnv,
    module_name: String) -> ModuleContext {
  let env_variant_locals = fold(map_values(env.bindings), init: empty_map(), f: (acc, binding) =>
    if binding.resolved.connective != none {
      match binding.resolved.connective.value {
        Disj =>
          fold(binding.resolved.children, init: acc, f: (vacc, child) =>
            map_insert(vacc, child.name, TypeBinding {
              name: child.name,
              resolved: leaf_node(name: binding.name)
            })
          )
        _ => acc
      }
    } else { acc }
  )
  let local = fold_module_contributions(
    remaining: contributions,
    resolved_items: [],
    func_sigs: empty_map(),
    svc_registry: empty_map(),
    svc_locals: empty_map(),
    variant_locals: env_variant_locals,
    item_registry: empty_map(),
    diag_chunks: []
  )
  let merged_scope = merge_scope_from_imports(
    remaining: resolved_imports,
    parent_index: parent_index,
    env: env,
    func_sigs: empty_map(),
    svc_registry: local.svc_registry,
    svc_locals: local.svc_locals,
    variant_locals: local.variant_locals
  )
  let all_declared_sigs = map_merge(merged_scope.func_sigs, local.func_sigs)
  let resolve_result = resolve_func_sigs(
    declared_sigs: all_declared_sigs,
    items: local.resolved_items,
    module_name: module_name
  )
  let optional_locals = map_insert(merged_scope.variant_locals, "Some", TypeBinding {
    name: "Some", resolved: leaf_node(name: "Optional")
  })
  let optional_locals = map_insert(optional_locals, "None", TypeBinding {
    name: "None", resolved: leaf_node(name: "Optional")
  })
  let all_locals = fold(map_values(merged_scope.svc_locals), init: optional_locals, f: (acc, binding) =>
    map_insert(acc, binding.name, binding)
  )
  ModuleContext {
    resolved_items: local.resolved_items,
    func_env: resolve_result.func_env,
    svc_registry: merged_scope.svc_registry,
    locals: all_locals,
    item_registry: local.item_registry,
    diagnostics: concat(flat_map(local.diag_chunks, c => c), resolve_result.diagnostics)
  }
}

// =========================================================================
// Typecheck a single module
//
// Builds the type environment, then resolves all type expressions in
// every item. Returns the typed module with its environment.
// =========================================================================

type TypecheckModuleResult {
  typed: TypedModule
  diagnostics: List<Diagnostic>
}

// =========================================================================
// SCC-aware function signature resolution (Contract 2)
//
// Converts DeclaredFuncSig (optional return_type) to ResolvedFuncSig
// (concrete return_type) using topological ordering of the call graph.
//
// 1. Collect call edges between local functions from body ASTs.
// 2. Process functions in topological order: each function's callees
//    are resolved before the function itself.
// 3. Annotated functions: return_type unwrapped from Some.
// 4. Unannotated + non-recursive: infer from body (callees resolved).
// 5. Unannotated + recursive (self or mutual): compile error.
//
// All 686 current functions have annotations, so paths 4-5 are future-
// proofing. The structural contract ensures no fabrication reaches emit.
// =========================================================================

type ResolveFuncSigsResult {
  func_env: ResolvedFuncEnv
  diagnostics: List<Diagnostic>
}

// Call edge between two local functions.
type CallEdge {
  caller: String
  callee: String
}

// Collect call edges from function body ASTs.
// Only includes edges where the callee is a local function (in local_func_set).
fn collect_func_call_edges(items: List<Node>, local_func_set: Map<String, Bool>) -> List<CallEdge> {
  flat_map(items, item =>
    if item.params |> count > 0 && item.body != none {
      collect_calls_in_expr(caller: item.name, expr: item.body.value, local_func_set: local_func_set)
    } else {
      []
    }
  )
}

// Walk an expression to find Call nodes whose func is a local function.
fn collect_calls_in_expr(caller: String, expr: Expr, local_func_set: Map<String, Bool>) -> List<CallEdge> {
  match expr {
    Call { func: f, args: a, resolved_type: _, span: _ } =>
      let self_edge = if emit_map_has(m: local_func_set, key: f) {
        [CallEdge { caller: caller, callee: f }]
      } else { [] }
      let arg_edges = flat_map(a, na => collect_calls_in_expr(caller: caller, expr: na.value, local_func_set: local_func_set))
      concat(self_edge, arg_edges)
    MethodCall { receiver: r, method: _, args: a, resolved_type: _, span: _ } =>
      let r_edges = collect_calls_in_expr(caller: caller, expr: r, local_func_set: local_func_set)
      let a_edges = flat_map(a, na => collect_calls_in_expr(caller: caller, expr: na.value, local_func_set: local_func_set))
      concat(r_edges, a_edges)
    FieldAccess { base: b, field: _, resolved_type: _, span: _ } =>
      collect_calls_in_expr(caller: caller, expr: b, local_func_set: local_func_set)
    If { condition: c, then_branch: t, else_branch: e, resolved_type: _, span: _ } =>
      let c_edges = collect_calls_in_expr(caller: caller, expr: c, local_func_set: local_func_set)
      let t_edges = collect_calls_in_expr(caller: caller, expr: t, local_func_set: local_func_set)
      let e_edges = match e {
        Some { value: eb } => collect_calls_in_expr(caller: caller, expr: eb, local_func_set: local_func_set)
        None => []
      }
      concat(c_edges, t_edges, e_edges)
    Match { scrutinee: s, arms: arm_list, resolved_type: _, span: _ } =>
      let s_edges = collect_calls_in_expr(caller: caller, expr: s, local_func_set: local_func_set)
      let arm_edges = flat_map(arm_list, arm => collect_calls_in_expr(caller: caller, expr: arm.body, local_func_set: local_func_set))
      concat(s_edges, arm_edges)
    Let { name: _, value: v, body: bd, resolved_type: _, span: _ } =>
      let v_edges = collect_calls_in_expr(caller: caller, expr: v, local_func_set: local_func_set)
      let bd_edges = match bd {
        Some { value: b } => collect_calls_in_expr(caller: caller, expr: b, local_func_set: local_func_set)
        None => []
      }
      concat(v_edges, bd_edges)
    Block { stmts: ss, resolved_type: _, span: _ } =>
      flat_map(ss, s => collect_calls_in_expr(caller: caller, expr: s, local_func_set: local_func_set))
    BinOp { op: _, left: l, right: r, resolved_type: _, span: _ } =>
      concat(
        collect_calls_in_expr(caller: caller, expr: l, local_func_set: local_func_set),
        collect_calls_in_expr(caller: caller, expr: r, local_func_set: local_func_set)
      )
    UnaryOp { op: _, operand: e, resolved_type: _, span: _ } =>
      collect_calls_in_expr(caller: caller, expr: e, local_func_set: local_func_set)
    Lambda { params: _, body: bd, resolved_type: _, span: _ } =>
      collect_calls_in_expr(caller: caller, expr: bd, local_func_set: local_func_set)
    RecordLit { type_name: _, fields: fs, resolved_type: _, span: _ } =>
      flat_map(fs, fi => collect_calls_in_expr(caller: caller, expr: fi.value, local_func_set: local_func_set))
    ListLit { elements: els, resolved_type: _, span: _ } =>
      flat_map(els, el => collect_calls_in_expr(caller: caller, expr: el, local_func_set: local_func_set))
    StringInterp { parts: ps, resolved_type: _, span: _ } =>
      flat_map(ps, p => match p {
        Interpolation { expr: e } => collect_calls_in_expr(caller: caller, expr: e, local_func_set: local_func_set)
        Text { value: _ } => []
      })
    Cast { expr: e, target: _, resolved_type: _, span: _ } =>
      collect_calls_in_expr(caller: caller, expr: e, local_func_set: local_func_set)
    ForEach { variable: _, collection: c, body: bd, resolved_type: _, span: _ } =>
      concat(
        collect_calls_in_expr(caller: caller, expr: c, local_func_set: local_func_set),
        collect_calls_in_expr(caller: caller, expr: bd, local_func_set: local_func_set)
      )
    Index { base: b, index: i, resolved_type: _, span: _ } =>
      concat(
        collect_calls_in_expr(caller: caller, expr: b, local_func_set: local_func_set),
        collect_calls_in_expr(caller: caller, expr: i, local_func_set: local_func_set)
      )
    Slice { base: b, start: s, end: e, resolved_type: _, span: _ } =>
      concat(
        collect_calls_in_expr(caller: caller, expr: b, local_func_set: local_func_set),
        collect_calls_in_expr(caller: caller, expr: s, local_func_set: local_func_set),
        collect_calls_in_expr(caller: caller, expr: e, local_func_set: local_func_set)
      )
    Return { value: v, resolved_type: _, span: _ } =>
      collect_calls_in_expr(caller: caller, expr: v, local_func_set: local_func_set)
    _ => []
  }
}

// Check if a function reaches itself through the call graph (DFS).
fn func_reaches_self(root: String, current: String, call_edges: List<CallEdge>, visited: Map<String, Bool>) -> Bool {
  if emit_map_has(m: visited, key: current) { false }
  else {
    let next_visited = map_insert(visited, current, true)
    let callees = call_edges |> filter(e => e.caller == current) |> map(e => e.callee)
    callees |> any(c =>
      if c == root { true }
      else { func_reaches_self(root: root, current: c, call_edges: call_edges, visited: next_visited) }
    )
  }
}

// Convert a single DeclaredFuncSig with return_type: Some to ResolvedFuncSig.
// Caller must ensure return_type is not None.
fn declared_to_resolved(dsig: DeclaredFuncSig) -> ResolvedFuncSig {
  ResolvedFuncSig { name: dsig.name, params: dsig.params, return_type: dsig.return_type.value, is_async: dsig.is_async }
}

// Merge all remaining declared sigs (with return_type: Some) into a resolved map.
fn merge_remaining_declared(declared_sigs: Map<String, DeclaredFuncSig>, resolved: Map<String, ResolvedFuncSig>) -> Map<String, ResolvedFuncSig> {
  fold(map_values(declared_sigs), init: resolved, f: (acc, dsig) =>
    if dsig.return_type != none {
      map_insert(acc, dsig.name, declared_to_resolved(dsig: dsig))
    } else { acc }
  )
}

// Topological resolution loop: process functions whose local callees are all resolved.
// When no more progress can be made, remaining functions form cycles.
fn topo_resolve_loop(
    remaining: List<String>,
    resolved: Map<String, ResolvedFuncSig>,
    declared_sigs: Map<String, DeclaredFuncSig>,
    call_edges: List<CallEdge>,
    local_func_set: Map<String, Bool>,
    module_name: String,
    diagnostics: List<Diagnostic>
) -> ResolveFuncSigsResult {
  if remaining |> count == 0 {
    // Include non-local (parent) sigs -- they have return_type: Some from conversion.
    let all_resolved = merge_remaining_declared(declared_sigs: declared_sigs, resolved: resolved)
    return ResolveFuncSigsResult {
      func_env: ResolvedFuncEnv { signatures: all_resolved },
      diagnostics: diagnostics
    }
  }

  // Find functions whose local callees are all resolved
  let ready = remaining |> filter(fn_name =>
    let local_callees = call_edges
      |> filter(e => e.caller == fn_name)
      |> map(e => e.callee)
      |> filter(c => emit_map_has(m: local_func_set, key: c))
    local_callees |> all(c => map_get(resolved, c) != none)
  )

  if ready |> count == 0 {
    // Stuck -- remaining functions form cycles. All must have annotations.
    let cycle_resolved = fold(remaining, init: resolved, f: (acc, fn_name) =>
      match map_get(declared_sigs, fn_name) {
        Some { value: dsig } =>
          if dsig.return_type != none {
            map_insert(acc, fn_name, declared_to_resolved(dsig: dsig))
          } else { acc }
        None => acc
      }
    )
    let cycle_diags = remaining |> flat_map(fn_name =>
      match map_get(declared_sigs, fn_name) {
        Some { value: dsig } =>
          if dsig.return_type == none {
            [Diagnostic {
              severity: Error,
              message: concat("recursive function '", fn_name, "' requires return type annotation"),
              span: none,
              module_name: module_name
            }]
          } else { [] }
        None => []
      }
    )
    // Terminate with cycle results
    let all_resolved = merge_remaining_declared(declared_sigs: declared_sigs, resolved: cycle_resolved)
    return ResolveFuncSigsResult {
      func_env: ResolvedFuncEnv { signatures: all_resolved },
      diagnostics: concat(diagnostics, cycle_diags)
    }
  }

  // Resolve ready functions
  let next_resolved = fold(ready, init: resolved, f: (acc, fn_name) =>
    match map_get(declared_sigs, fn_name) {
      Some { value: dsig } =>
        if dsig.return_type != none {
          map_insert(acc, fn_name, declared_to_resolved(dsig: dsig))
        } else {
          // Unannotated non-recursive: require annotation for now.
          // Inference from body can be added when needed.
          acc
        }
      None => acc
    }
  )
  let next_diags = fold(ready, init: diagnostics, f: (acc, fn_name) =>
    match map_get(declared_sigs, fn_name) {
      Some { value: dsig } =>
        if dsig.return_type == none {
          list_push(acc, Diagnostic {
            severity: Error,
            message: concat("function '", fn_name, "' requires return type annotation"),
            span: none,
            module_name: module_name
          })
        } else { acc }
      None => acc
    }
  )

  // Remove resolved from remaining and recurse
  let ready_set = fold(ready, init: empty_map(), f: (acc, fn_name) => map_insert(acc, fn_name, true))
  let next_remaining = remaining |> filter(fn_name => emit_map_has(m: ready_set, key: fn_name) == false)

  topo_resolve_loop(
    remaining: next_remaining,
    resolved: next_resolved,
    declared_sigs: declared_sigs,
    call_edges: call_edges,
    local_func_set: local_func_set,
    module_name: module_name,
    diagnostics: next_diags
  )
}

// Main entry: resolve declared function signatures to resolved ones.
// Converts DeclaredFuncSig (return_type: Node?) to ResolvedFuncSig (return_type: Node)
// using SCC-aware topological ordering of the call graph.
fn resolve_func_sigs(
    declared_sigs: Map<String, DeclaredFuncSig>,
    items: List<Node>,
    module_name: String
) -> ResolveFuncSigsResult {
  let resolved = fold(map_values(declared_sigs), init: empty_map(), f: (acc, dsig) =>
    if dsig.return_type != none {
      map_insert(acc, dsig.name, ResolvedFuncSig { name: dsig.name, params: dsig.params, return_type: dsig.return_type.value, is_async: dsig.is_async })
    } else { acc }
  )
  ResolveFuncSigsResult { func_env: ResolvedFuncEnv { signatures: resolved }, diagnostics: [] }
}

fn typecheck_module(resolved: ResolvedModule, parent_index: Map<String, TypedModule>) -> TypecheckModuleResult {
  let env_result = build_type_env(module: resolved, parent_index: parent_index)
  let env = env_result.env
  let env_diags = env_result.diagnostics

  // Gate: if type environment construction produced errors (unresolved types),
  // halt before inference. This makes unresolved nodes structurally impossible
  // downstream -- inference and emit never see them.
  let env_errors = env_diags |> filter(d => d.severity == Error)
  if env_errors |> count > 0 {
    return TypecheckModuleResult {
      typed: TypedModule {
        module: resolved.module,
        items: [],
        type_env: env,
        func_env: ResolvedFuncEnv { signatures: empty_map() },
        item_registry: empty_map()
      },
      diagnostics: env_diags
    }
  }

  let contributions = map(resolved.module.items, item =>
    analyze_item(item: item, env: env, module_name: resolved.module.name)
  )
  let ctx = build_module_context(
    contributions: contributions,
    parent_index: parent_index,
    resolved_imports: resolved.resolved_imports,
    env: env,
    module_name: resolved.module.name
  )

  let infer_scope = InferScope {
    type_env: env,
    func_env: ctx.func_env,
    locals: ctx.locals,
    module_name: resolved.module.name,
    service_registry: ctx.svc_registry
  }
  let typed_item_results = infer_items(items: ctx.resolved_items, scope: infer_scope)
  let typed_items = map(typed_item_results, tir => tir.item)
  let infer_diags = flat_map(typed_item_results, tir => tir.diagnostics)
  let typed_module = Module {
    name: resolved.module.name,
    imports: resolved.module.imports,
    items: ctx.resolved_items,
    span: resolved.module.span
  }

  TypecheckModuleResult {
    typed: TypedModule {
      module: typed_module,
      items: typed_items,
      type_env: env,
      func_env: ctx.func_env,
      item_registry: ctx.item_registry
    },
    diagnostics: concat(env_diags, ctx.diagnostics, infer_diags)
  }
}

// =========================================================================
// Resolve all bindings in a TypeEnv
//
// After building the initial environment (which may contain Named
// references within Product/Coproduct fields), resolve every binding
// so downstream consumers see fully-structural types.
// =========================================================================

type EnvResolveResult {
  env: TypeEnv
  diagnostics: List<Diagnostic>
}

// Result of resolving a single type binding -- follows the same
// value+diagnostics pattern as ResolveResult, ItemResult, etc.
type BindingResult {
  binding: TypeBinding
  diagnostics: List<Diagnostic>
}

fn resolve_env_bindings(env: TypeEnv, module_name: String, local_names: Map<String, Bool>) -> EnvResolveResult {
  // Resolve local types in topological (dependency) order. Each type is
  // resolved exactly once, with all its dependencies already resolved in
  // the environment. This is O(N * avg_fields) instead of O(B^D).
  // Extract local binding names as a list.
  let remaining = map(
    filter(map_values(env.bindings), b => emit_map_has(m: local_names, key: b.name)),
    b => b.name
  )
  topo_resolve_types(remaining: remaining, env: env, module_name: module_name, diagnostics: [], local_names: local_names)
}

// Topological resolution loop for type bindings.
// Resolves types whose dependencies are all already resolved (or primitive/recursive),
// updates the environment, then recurses with the remaining types.
// Same pattern as topo_resolve_loop for function signatures (line 3135).
fn topo_resolve_types(
    remaining: List<String>,
    env: TypeEnv,
    module_name: String,
    diagnostics: List<Diagnostic>,
    local_names: Map<String, Bool>
) -> EnvResolveResult {
  if remaining |> count == 0 {
    return EnvResolveResult { env: env, diagnostics: diagnostics }
  }

  // A type is ready when all its local dependencies are already resolved
  // (not in remaining), primitive, or recursive (cycle-breaker).
  let remaining_set = fold(remaining, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
  let ready = filter(remaining, name =>
    match map_get(env.bindings, name) {
      Some { value: binding } =>
        all(node_type_deps(n: binding.resolved), dep => dep == "String" || dep == "Int" || dep == "Bool" || dep == "Float" || dep == "Secret" || dep == "Json" || dep == "Unit" || dep == "Bytes" || is_recursive_type(env: env, name: dep) || emit_map_has(m: remaining_set, key: dep) == false)
      None => true
    }
  )

  if ready |> count == 0 {
    // Stuck -- remaining types form undetected cycles or have missing deps.
    // Resolve each as-is against current env to collect diagnostics.
    // Bare map accumulator avoids O(N^2) struct-field cloning.
    let stuck_bindings = fold(remaining, init: env.bindings, f: (acc, name) =>
      match map_get(env.bindings, name) {
        Some { value: binding } =>
          let result = resolve_node(n: binding.resolved, env: env, module_name: module_name)
          map_insert(acc, name, TypeBinding { name: name, resolved: result.resolved })
        None => acc
      }
    )
    let stuck_diags = flat_map(remaining, name =>
      match map_get(env.bindings, name) {
        Some { value: binding } =>
          let result = resolve_node(n: binding.resolved, env: env, module_name: module_name)
          result.diagnostics
        None => []
      }
    )
    return EnvResolveResult {
      env: TypeEnv { bindings: stuck_bindings, recursive_types: env.recursive_types, recursive_type_set: env.recursive_type_set },
      diagnostics: concat(diagnostics, stuck_diags)
    }
  }

  // Resolve ready types against current env -- ready types' deps are all resolved
  // in prior topo iterations, so they don't depend on each other.
  // Bare map accumulator avoids O(N^2) struct-field cloning.
  let next_bindings = fold(ready, init: env.bindings, f: (acc, name) =>
    match map_get(env.bindings, name) {
      Some { value: binding } =>
        let result = resolve_node(n: binding.resolved, env: env, module_name: module_name)
        map_insert(acc, name, TypeBinding { name: name, resolved: result.resolved })
      None => acc
    }
  )
  let next_diags = flat_map(ready, name =>
    match map_get(env.bindings, name) {
      Some { value: binding } =>
        let result = resolve_node(n: binding.resolved, env: env, module_name: module_name)
        result.diagnostics
      None => []
    }
  )

  // Remove resolved from remaining and recurse.
  let ready_set = fold(ready, init: empty_map(), f: (acc, name) => map_insert(acc, name, true))
  let next_remaining = filter(remaining, name => emit_map_has(m: ready_set, key: name) == false)

  topo_resolve_types(
    remaining: next_remaining,
    env: TypeEnv { bindings: next_bindings, recursive_types: env.recursive_types, recursive_type_set: env.recursive_type_set },
    module_name: module_name,
    diagnostics: concat(diagnostics, next_diags),
    local_names: local_names
  )
}

// =========================================================================
// Collect parent type environments for a module
//
// Gathers the TypeEnvs from all modules that this module imports from,
// by looking up already-typed modules in the completed list.
// =========================================================================

fn collect_parent_envs(resolved: ResolvedModule, module_index: Map<String, TypedModule>) -> ParentModulesResult {
  let modules = flat_map(resolved.resolved_imports, imp =>
    match map_get(module_index, imp.module_path) {
      Some { value: typed } => [typed]
      None => []
    }
  )
  let diagnostics = flat_map(resolved.resolved_imports, imp =>
    match map_get(module_index, imp.module_path) {
      Some { value: _ } => []
      None => [Diagnostic {
        severity: Error,
        message: concat("missing parent environment for imported module '", imp.module_path, "' while ordering '", resolved.module.name, "'"),
        span: imp.target_module.value.span,
        module_name: resolved.module.name
      }]
    }
  )
  ParentModulesResult { modules: modules, diagnostics: diagnostics }
}

// =========================================================================
// Main entry point: typecheck
//
// Processes modules in dependency order (from the resolver's dep_order).
// Each module sees the type environments of all its dependencies.
//
// Invariant: after this function returns, no unresolved Named references
// survive (except recursive cycle-breakers that are guaranteed to be
// defined in the graph).
// =========================================================================

fn typecheck(graph: ModuleGraph) -> TypedGraph {
  // SG-9: Use explicit recursion with standalone parameters instead of fold
  // with a struct accumulator. Standalone Rc parameters have refcount 1 in
  // TCO loops, enabling O(1) list_push/map_insert via Rc::try_unwrap.
  // A fold accumulator struct forces O(N) clones on every field access.
  //
  // Diagnostics use chunked accumulation (List<List<Diagnostic>>) instead of
  // concat to avoid O(M^2) cloning. Each iteration pushes diagnostic lists;
  // flat_map flattens once at the end.
  typecheck_modules(
    remaining: graph.modules,
    modules: [],
    module_index: empty_map(),
    item_registry: empty_map(),
    diag_chunks: []
  )
}

fn typecheck_modules(
  remaining: List<ResolvedModule>,
  modules: List<TypedModule>,
  module_index: Map<String, TypedModule>,
  item_registry: Map<String, ItemInfo>,
  diag_chunks: List<List<Diagnostic>>
) -> TypedGraph {
  match remaining |> first {
    None => TypedGraph { modules: modules, item_registry: item_registry, diagnostics: flat_map(diag_chunks, c => c) }
    Some { value: resolved } =>
      let parent_result = collect_parent_envs(resolved: resolved, module_index: module_index)
      let tc_result = typecheck_module(resolved: resolved, parent_index: module_index)
      let typed = tc_result.typed
      let tc_diags = tc_result.diagnostics
      typecheck_modules(
        remaining: remaining |> skip(1),
        modules: list_push(modules, typed),
        module_index: map_insert(module_index, typed.module.name, typed),
        item_registry: map_merge(item_registry, typed.item_registry),
        diag_chunks: list_push(list_push(diag_chunks, parent_result.diagnostics), tc_diags)
      )
  }
}

// =========================================================================
// Reconcile namespaces in one call.
//
// Returns the reconciled graph with graph-level item metadata attached.
// Historical note: collect_unresolved_in_expr and the rest of the
// validate_no_unresolved walk family were removed once the env-error gate
// made unresolved expression-tree validation redundant downstream.
// =========================================================================

fn reconcile(graph: ModuleGraph) -> ResolvedGraph {
  let typed = typecheck(graph: graph)
  ResolvedGraph { modules: typed.modules, item_registry: typed.item_registry, diagnostics: typed.diagnostics }
}
