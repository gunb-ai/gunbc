import v2.compiler.eval {
  EvalContext,
  effect_io_roundtrip_transform,
  eval_context_with_effect_io,
  eval_diagnostic,
  eval_with_context,
  inputs_root_only
}
import v2.compiler.infer { InferredFacts, InferredTree }
import v2.extdeps.languages.dag {
  dag_pick_if_body_from_arms,
  dag_type_atom_node
}
import v2.extdeps.runtimes.v2_effect_io_pure {
  FileResourceBackend,
  effect_io_pure_empty_fixture_store,
  effect_io_pure_unit_type_node
}
import v2.std.cardinality { RankingComponent, TerminationProof }

import std.optional {
  Optional,
  Absent,
  Present,
  optional_present,
  optional_absent
}
