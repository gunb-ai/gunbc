module v2.program


fn program_atom(s: v2.std.node.Symbol) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: s } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn program_byte() -> v2.std.machine.Byte {
  v2.std.machine.Byte { bits: [true] }
}

fn program_bool_type() -> v2.std.node.Node {
  program_atom(s: ^program_bool_type_sym)
}

fn program_i64_type() -> v2.std.node.Node {
  program_atom(s: ^program_i64_sym)
}

fn program_unit_type() -> v2.std.node.Node {
  effect_io_pure_unit_type_node()
}

fn program_bool_value(is_true: Bool) -> v2.std.runtime.RuntimeValue {
  if is_true {
    v2.std.runtime.RuntimePrimitive {
      value: v2.std.runtime.RuntimePrimitiveValue {
        primitive_type: program_bool_type(),
        bytes: [program_byte()]
      }
    }
  } else {
    v2.std.runtime.RuntimePrimitive {
      value: v2.std.runtime.RuntimePrimitiveValue {
        primitive_type: program_bool_type(),
        bytes: std.algebra.Empty
      }
    }
  }
}

fn program_int_one_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimePrimitive {
    value: v2.std.runtime.RuntimePrimitiveValue {
      primitive_type: program_i64_type(),
      bytes: [program_byte()]
    }
  }
}

fn program_unit_value() -> v2.std.runtime.RuntimeValue {
  v2.std.runtime.RuntimeUnit {
    value: v2.std.runtime.RuntimeUnitValue {
      unit_type: program_unit_type()
    }
  }
}

fn program_literal_one() -> v2.std.node.Node {
  dag_type_atom_node(identity: ^dag_pick_lit_one)
}

fn program_literal_two() -> v2.std.node.Node {
  dag_type_atom_node(identity: ^dag_pick_lit_two)
}

fn program_kw_true() -> v2.std.node.Node {
  dag_type_atom_node(identity: ^dag_token_kw_true)
}

fn program_kw_false() -> v2.std.node.Node {
  dag_type_atom_node(identity: ^dag_token_kw_false)
}

data program_locator_literal: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Value },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data program_payload_literal: Node = v2.std.node.Node {
  kind: v2.std.node.ComputationNode { behavior: Value },
  children: [],
  occurrence_id: SyntheticOccurrence
}

data program_effect_io_roundtrip: Node = effect_io_roundtrip_transform(
  locator: program_locator_literal,
  payload: program_payload_literal
)

data program_pick_if_branch_with_effect_io: Node = dag_pick_if_body_from_arms(
  condition: program_kw_true(),
  then_arm: program_effect_io_roundtrip,
  else_arm: program_literal_two()
)

fn program_termination_proof() -> v2.std.cardinality.TerminationProof {
  v2.std.cardinality.TerminationProof {
    non_increasing: [],
    strict: v2.std.cardinality.RankingDimension { measured: ^program_descent_dimension }
  }
}

fn program_allocate_literal(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  if node == program_literal_one() {
    v2.std.diagnostic.Accepted { value: program_int_one_value(), diagnostics: None }
  } else if node == program_literal_two() {
    v2.std.diagnostic.Accepted {
      value: v2.std.runtime.RuntimePrimitive {
        value: v2.std.runtime.RuntimePrimitiveValue {
          primitive_type: program_i64_type(),
          bytes: [program_byte(), program_byte()]
        }
      },
      diagnostics: None
    }
  } else if node == program_kw_true() {
    v2.std.diagnostic.Accepted { value: program_bool_value(is_true: true), diagnostics: None }
  } else if node == program_kw_false() {
    v2.std.diagnostic.Accepted { value: program_bool_value(is_true: false), diagnostics: None }
  } else if node == program_locator_literal || node == program_payload_literal {
    v2.std.diagnostic.Accepted { value: program_unit_value(), diagnostics: None }
  } else {
    v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(
        d: eval_diagnostic(reason: ^program_allocate_rejected, node: node)
      )
    }
  }
}

fn program_nth_child(node: v2.std.node.Node, wanted: Int) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  match list_at_optional(xs: node.children, index: wanted) {
    Present { value: child } =>
      match child {
        Edge { label: _, target: arm } =>
          v2.std.diagnostic.Accepted { value: arm, diagnostics: None }
      }
    Absent =>
      v2.std.diagnostic.Rejected {
        diagnostics: diagnostics_singleton(
          d: eval_diagnostic(reason: ^program_branch_shape_rejected, node: node)
        )
      }
  }
}

fn program_choose_branch(
  node: v2.std.node.Node,
  condition: v2.std.runtime.RuntimeValue,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.node.Node> {
  if count(node.children) == 3 {
    if program_runtime_bool_true(value: condition) {
      program_nth_child(node: node, wanted: 1)
    } else if program_runtime_bool_false(value: condition) {
      program_nth_child(node: node, wanted: 2)
    } else {
      v2.std.diagnostic.Rejected {
        diagnostics: diagnostics_singleton(
          d: eval_diagnostic(reason: ^program_branch_condition_rejected, node: node)
        )
      }
    }
  } else {
    v2.std.diagnostic.Rejected {
      diagnostics: diagnostics_singleton(
        d: eval_diagnostic(reason: ^program_branch_shape_rejected, node: node)
      )
    }
  }
}

fn program_runtime_bool_true(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == program_bool_type()) && (count(p.bytes) == 1)
    _ => false
  }
}

fn program_runtime_bool_false(value: v2.std.runtime.RuntimeValue) -> Bool {
  match value {
    RuntimePrimitive { value: p } =>
      (p.primitive_type == program_bool_type()) && (count(p.bytes) == 0)
    _ => false
  }
}

fn program_reject_primitive(
  node: v2.std.node.Node,
  _args: List<v2.std.runtime.RuntimeValue>,
  _env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  v2.std.diagnostic.Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^program_primitive_rejected, node: node)
    )
  }
}

fn program_step_loop(node: v2.std.node.Node, _env: v2.std.runtime.EvaluationEnvironment) -> v2.std.diagnostic.Outcome<v2.std.runtime.ControlTransfer> {
  v2.std.diagnostic.Rejected {
    diagnostics: diagnostics_singleton(
      d: eval_diagnostic(reason: ^program_primitive_rejected, node: node)
    )
  }
}

fn program_bind_value(
  _key: v2.std.runtime.EnvironmentBindingKey,
  _value: v2.std.runtime.RuntimeValue,
  env: v2.std.runtime.EvaluationEnvironment
) -> v2.std.diagnostic.Outcome<v2.std.runtime.EvaluationEnvironment> {
  v2.std.diagnostic.Accepted { value: env, diagnostics: None }
}

fn program_interpretation() -> v2.std.runtime.InterpretationAlgebra {
  v2.std.runtime.InterpretationAlgebra {
    value: v2.std.runtime.ValueInterpreter { allocate_literal: program_allocate_literal },
    transform: v2.std.runtime.TransformInterpreter { call_primitive: program_reject_primitive },
    branch: v2.std.runtime.BranchInterpreter { choose_branch: program_choose_branch },
    loop: v2.std.runtime.LoopInterpreter { step_loop: program_step_loop },
    bind: v2.std.runtime.BindInterpreter { bind_value: program_bind_value },
    match: v2.std.runtime.MatchInterpreter { choose_arm: runtime_reject_match_arm }
  }
}

fn program_structure_witness() -> v2.std.runtime.InterpretationStructureWitness {
  v2.std.runtime.InterpretationStructureWitness {
    allocate_literal: ^program_allocate_literal_sym,
    call_primitive: ^program_reject_primitive_sym,
    choose_branch: ^program_choose_branch_sym,
    step_loop: ^program_step_loop_sym,
    bind_value: ^program_bind_value_sym,
    choose_arm: ^runtime_reject_match_arm
  }
}

fn program_context_with_effect_io() -> v2.compiler.eval.EvalContext {
  eval_context_with_effect_io(
    runtime_identity: ^program_runtime_id,
    interpretation: program_interpretation(),
    structure_witness: program_structure_witness(),
    backend: FileResourceBackend,
    store: effect_io_pure_empty_fixture_store(backend: FileResourceBackend)
  )
}

fn program_facts_for(node: v2.std.node.Node) -> v2.compiler.infer.InferredFacts {
  claim_inferred_facts_from_nodes(
    resolved: node,
    algebra: program_unit_type(),
    descent: v2.std.witness.Holds { value: program_termination_proof() }
  )
}

fn program_facts_lookup(node: v2.std.node.Node) -> Optional<v2.compiler.infer.InferredFacts> {
  if node == program_pick_if_branch_with_effect_io {
    optional_present(value: program_facts_for(node: program_pick_if_branch_with_effect_io))
  } else if node == program_effect_io_roundtrip {
    optional_present(value: program_facts_for(node: program_effect_io_roundtrip))
  } else if node == program_locator_literal {
    optional_present(value: program_facts_for(node: program_locator_literal))
  } else if node == program_payload_literal {
    optional_present(value: program_facts_for(node: program_payload_literal))
  } else if node == program_kw_true() {
    optional_present(value: program_facts_for(node: program_kw_true()))
  } else if node == program_literal_two() {
    optional_present(value: program_facts_for(node: program_literal_two()))
  } else {
    optional_absent()
  }
}

fn program_tree(root: v2.std.node.Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: root,
    facts: std.types.Map { lookup: program_facts_lookup }
  }
}

fn program_eval_root(root: v2.std.node.Node) -> v2.std.diagnostic.Outcome<v2.std.runtime.RuntimeValue> {
  eval_with_context(
    tree: program_tree(root: root),
    context: program_context_with_effect_io(),
    inputs: inputs_root_only(root: root)
  )
}

fn program_branch_effect_io_holds() -> Bool {
  match program_eval_root(root: program_pick_if_branch_with_effect_io) {
    v2.std.diagnostic.Accepted { value: v, diagnostics: None } => v == program_unit_value()
    _ => false
  }
}

fn program_pick_if_call(callee: v2.std.node.Node) -> v2.std.node.Node {
  v2.std.node.Node {
    kind: v2.std.node.ComputationNode { behavior: Transform },
    children: [v2.std.node.Edge { label: Positional, target: callee }],
    occurrence_id: SyntheticOccurrence
  }
}

fn program_pick_if_arrow_facts_lookup(node: v2.std.node.Node) -> Optional<v2.compiler.infer.InferredFacts> {
  optional_present(value: claim_inferred_facts_from_nodes(
      resolved: node,
      algebra: program_i64_type(),
      descent: v2.std.witness.Holds { value: program_termination_proof() }
    ))
}

fn program_pick_if_arrow_tree(callee: v2.std.node.Node) -> v2.compiler.infer.InferredTree {
  v2.compiler.infer.InferredTree {
    root: callee,
    facts: std.types.Map { lookup: program_pick_if_arrow_facts_lookup }
  }
}

fn program_pick_if_arrow_holds() -> Bool {
  match ingested_pick_if_arrow_with_body() {
    v2.std.diagnostic.Accepted { value: arrow, diagnostics: _ } => {
      let call = program_pick_if_call(callee: arrow)
      match eval_with_context(
        tree: program_pick_if_arrow_tree(callee: arrow),
        context: program_context_with_effect_io(),
        inputs: inputs_root_only(root: call)
      ) {
        v2.std.diagnostic.Accepted { value: v, diagnostics: None } => v == program_int_one_value()
        _ => false
      }
    }
    Rejected { diagnostics: _ } => false
  }
}

data program_run_branch_gate: Node = program_kw_true()

data program_run_io_step: Node = program_effect_io_roundtrip

data program_run_branch_to_io: v2.std.dependency.DependencyView = v2.std.dependency.DependencyView {
  source: program_run_branch_gate,
  dependent: program_run_io_step,
  kind: DataDependsOn,
  usage_site: program_run_io_step
}

data program_run_nodes: List<Node> = [program_run_branch_gate, program_run_io_step]

data program_run_dependencies: List<v2.std.dependency.DependencyView> = [program_run_branch_to_io]

fn program_runtime_run_holds() -> Bool {
  match runtime_run(
    nodes: program_run_nodes,
    dependencies: program_run_dependencies,
    tree: program_tree(root: program_effect_io_roundtrip),
    context: program_context_with_effect_io()
  ) {
    RuntimeRunComplete { log: log, scheduled: scheduled } =>
      length(xs: log.entries) == 2
        && length(xs: scheduled) == 2
        && program_branch_effect_io_holds()
    RuntimeRunBlocked { evidence: _, log: _, scheduled: _, remaining: _ } => false
  }
}

fn program_runs_holds() -> Bool {
  program_branch_effect_io_holds()
    && program_pick_if_arrow_holds()
    && program_runtime_run_holds()
}

data unified_claim_program_runs: v2.std.verification.UnifiedTestClaim = v2.std.verification.BoolWitnessClaim {
  witness: v2.std.verification.BoolWitness {
    entry: "src/v2/program.dag",
    function: program_runs_holds
  }
}
