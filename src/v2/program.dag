  Accepted,
  Diagnostic,
  Diagnostics,
  ExternalContractUnknown,
  Outcome,
  Rejected,
  Unavailable,
  diagnostics_singleton,
  invariant_port_locus
}
import std.algebra { Empty, length, list_at_optional }
import v2.std.machine { Byte }
