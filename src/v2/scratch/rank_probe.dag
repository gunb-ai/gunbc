module v2.scratch.rank_probe

import v2.compiler.self_host.frontier {
  compiler_frontier_sweep_order,
  compiler_frontier_tractability_rank_for_path
}
import v2.std.collection { List, map_list }
import v2.std.text { String }

fn sweep_order_ranks() -> List<Int> {
  map_list(
    xs: compiler_frontier_sweep_order,
    f: fn(p) { compiler_frontier_tractability_rank_for_path(target: p) }
  )
}
