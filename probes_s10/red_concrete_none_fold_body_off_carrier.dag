module gunbc.s10_red_concrete_none_fold_body_off_carrier

import std.types { String, Bool, List, Int }
import std.optional { Optional, Present, Absent }

type KRow<K, V> {
  row_key: K
  value: V
}

fn probe(rows: List<KRow<Int, String>>, wanted_key: Int) -> KRow<Int, String>? {
  fold(rows, init: none, f: fn(acc, row) {
    if row.row_key == wanted_key { Present { value: "x" } } else { acc }
  })
}

fn zz_control_after(x: Int) -> Bool {
  let n: Bool = x
  n
}
