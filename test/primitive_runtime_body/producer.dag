module v1.compiler.primitive_runtime_body

import std.primitive_identity {
  PrimitiveRuntimeBodyCensus, PrimitiveRuntimeBodyCheck,
  PrimitiveRuntimeBodiesObserved, PrimitiveRuntimeBodiesMissing,
  PrimitiveRuntimeBodyScanRefused,
  RuntimeBody, EmitHandler, BuiltinRegistry,
  surface_rows_carry_symbol_on,
  primitive_runtime_body_check_in,
  primitive_identity_for_symbol,
  surface_row,
  DerivedFromAuthority,
  PrimitiveSurfaceRow,
}
import std.process { ProcessExit, ExitSuccess, ExitFailure }
import std.types { List, String }
import std.algebra { trim, Cons, Empty }
import std.optional { Absent, Present }
import std.decl_ref { decl_ref }
import gunbc.primitive_runtime_body_gate { runtime_body_required_check_census_in }
import gunbc.primitive_egress.d0_census { primitive_surface_census_with_runtime }
import gunbc.rust_item_scan { scan_rust_source, RustFileScanned, RustFileScanRefused }
import gunbc.rust_item_identity { RustFunction, RustItemIdentity }
import extdeps.languages.rust.emit { RuntimeFunction, rt_function_registry }
import v1.compiler.runtime_rust { rust_runtime_source }

fn drop_prefix<T>(xs: List<T>, n: Int) -> List<T> {
  if n <= 0 {
    xs
  } else {
    match xs {
      Empty => Empty
      Cons { head: _, tail: t } => drop_prefix(xs: t, n: n - 1)
    }
  }
}

fn primitive_runtime_item_has_body(item: RustItemIdentity, lines: List<String>) -> Bool {
  match drop_prefix(xs: lines, n: item.start_line + item.loc - 2) |> first {
    Present { value: line } => ends_with(s: trim(s: line), suffix: "}")
    Absent => false
  }
}

fn primitive_runtime_body_rows_for_symbol(
  registry: List<RuntimeFunction>, symbol: String,
) -> List<PrimitiveSurfaceRow> {
  let bridges = registry |> filter(entry => entry.bridge_name == symbol)
  let identities = if count(bridges) == 0 { [none] } else {
    bridges |> map(entry => primitive_identity_for_symbol(authority: EmitHandler, authored_symbol: entry.name))
  }
  identities |> map(identity => surface_row(
    authority: RuntimeBody,
    authored_symbol: symbol,
    authority_ref: decl_ref(module_path: "v1_rt", decl_name: symbol),
    primitive: identity,
    provenance: DerivedFromAuthority,
  ))
}

fn primitive_runtime_body_census_in(
  registry: List<RuntimeFunction>,
  source: String,
) -> PrimitiveRuntimeBodyCensus {
  let lines = split(s: source, delimiter: "\n")
  match scan_rust_source(repo_path: "v1_rt.rs", content: source) {
    RustFileScanRefused { repo_path: _, line: line, line_text: text, detail: detail } =>
      PrimitiveRuntimeBodyScanRefused { line: line, detail: concat(detail, concat(": ", text)) }
    RustFileScanned { repo_path: _, items: items, macro_regions: _, line_count: _ } =>
      PrimitiveRuntimeBodiesObserved {
        rows: items
          |> filter(item => item.kind == RustFunction && item.enclosing_module == ""
            && primitive_runtime_item_has_body(item: item, lines: lines))
          |> flat_map(item => primitive_runtime_body_rows_for_symbol(
            registry: registry, symbol: item.name as String
          ))
      }
  }
}

fn runtime_body_required_check_in(registry: List<RuntimeFunction>, source: String) -> ProcessExit {
  let census = primitive_runtime_body_census_in(registry: registry, source: source)
  runtime_body_required_check_census_in(registry: registry, census: census)
}

// Read the bytes the runtime producer emits, never its checked-in bootstrap mirror.
fn rust_primitive_runtime_body_census() -> PrimitiveRuntimeBodyCensus {
  primitive_runtime_body_census_in(
    registry: rt_function_registry,
    source: rust_runtime_source()
  )
}

fn rust_primitive_runtime_body_check() -> PrimitiveRuntimeBodyCheck {
  primitive_runtime_body_check_in(
    registry: rt_function_registry,
    census: rust_primitive_runtime_body_census()
  )
}

// These live-producer controls belong to the required phase, whose subject includes src/v1.
// They are not orphan test declarations outside the ordinary floor's discovery roots. The
// complete legacy surface census is also measured here, rather than making a small fixture
// witness repeatedly derive the corpus-wide population under the new-witness step ceiling.
fn runtime_body_producer_controls(registry: List<RuntimeFunction>, census: PrimitiveRuntimeBodyCensus) -> ProcessExit {
  let surface_join = match primitive_surface_census_with_runtime(runtime: census) {
    PrimitiveRuntimeBodiesObserved { rows: rows } => registry
      |> filter(row => row.name == "map_insert")
      |> all(row =>
        surface_rows_carry_symbol_on(rows: rows, authority: RuntimeBody, authored_symbol: row.bridge_name)
          && surface_rows_carry_symbol_on(rows: rows, authority: EmitHandler, authored_symbol: row.name)
          && surface_rows_carry_symbol_on(rows: rows, authority: BuiltinRegistry, authored_symbol: row.name))
    _ => false
  }
  if !surface_join {
    ExitFailure { code: 1, reason: "runtime-body combined-surface control lost a bridge or body authority" }
  } else {
    let expanded = concat(registry, [RuntimeFunction {
      name: "runtime_body_missing_control", bridge_name: "runtime_body_missing_control",
      passes_by_ref: false, wraps_result: false
    }])
    match primitive_runtime_body_check_in(registry: expanded, census: census) {
      PrimitiveRuntimeBodiesMissing { violations: rows } =>
        if count(rows) == 1 && (rows |> all(row =>
          row.authored_symbol == "runtime_body_missing_control" && row.bridge_name == "runtime_body_missing_control"
        )) { ExitSuccess } else {
          ExitFailure { code: 1, reason: "runtime-body new-bridge control refused the wrong population" }
        }
      _ => ExitFailure { code: 1, reason: "runtime-body new-bridge control did not refuse the appended missing body" }
    }
  }
}

// One census feeds standing admission, the permanent map_insert mutation, surface composition,
// and the appended-bridge control. The host transports ProcessExit, not admission decisions.
fn check() -> ProcessExit {
  let census = rust_primitive_runtime_body_census()
  let standing = runtime_body_required_check_census_in(registry: rt_function_registry, census: census)
  match standing {
    ExitFailure { code: _, reason: _ } => standing
    ExitSuccess => runtime_body_producer_controls(registry: rt_function_registry, census: census)
  }
}
