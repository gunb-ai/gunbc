module fixture.text_string_importer_census.mixed
import v2.std.text { String, string_head, string_join, string_is_empty }
fn joined_is_empty(xs: List<String>, sep: String) -> Bool {
  string_is_empty(s: string_join(fields: xs, separator: sep))
}
fn joined(xs: List<String>, sep: String) -> Int {
  let j = string_join(fields: xs, separator: sep)
  string_length(s: sep)
}
