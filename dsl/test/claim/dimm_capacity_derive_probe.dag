// TEMP PROBE — verify a DIMM capacity_bytes can be DERIVED from
// (die_density_gbit x chips_per_rank x rank_count) on the v1/v2 interpreter,
// via std.measure ByteSize + raw Int arithmetic, and that a wrong decode goes RED.
module test.claim.dimm_capacity_derive_probe

import std.measure { ByteSize, byte_size, byte_size_count }
import std.types { Int }
import std.logic { Bool }

// A 32 GiB DDR4 RDIMM, 2 ranks of 8 x16-organized 16 Gbit chips:
//   die_density_gbit = 16, chips_per_rank = 16, rank_count = 2
//   bits  = 16 * 16 * 2 * 1_000_000_000 (Gbit = 10^9 bit, decimal probe)
//   bytes = bits / 8
// Use a clean decimal model so the arithmetic is auditable by hand.
fn derive_capacity_bytes(die_density_gbit: Int, chips_per_rank: Int, rank_count: Int) -> ByteSize {
  let total_gbit = die_density_gbit * chips_per_rank * rank_count
  let total_bits = total_gbit * 1000000000
  byte_size(total_bits / 8)
}

// 16 Gbit * 16 chips * 2 ranks = 512 Gbit = 512e9 bit = 64e9 bytes = 64_000_000_000.
fn dimm_capacity_derive_holds() -> Bool {
  byte_size_count(derive_capacity_bytes(16, 16, 2)) == 64000000000
}

// RED control — the SAME derivation asserted against a WRONG stored value.
// Must return false: proves the claim discriminates a bad decode.
fn dimm_capacity_wrong_decode_is_red() -> Bool {
  byte_size_count(derive_capacity_bytes(16, 16, 2)) == 32000000000
}
