// Authority probe — BraceGroup + Pipe{AndOr} serialization for slice 5b keystone.
module test.claim.bash_slice5b_pipe_probe

import extdeps.languages.bash.program {
  ShellProgram, ShellStmt,
  Command, AndOr, Pipe, BraceGroup,
  Lit, AndThen,
  lit, command, serialize_bash
}

fn probe_pipe_and_or_brace_grouped() -> String {
  serialize_bash(p: ShellProgram {
    set_e: false,
    statements: [
      Pipe {
        left: BraceGroup {
          body: [
            AndOr {
              left: command(words: [lit(text: "true")]),
              op: AndThen,
              right: command(words: [lit(text: "false")])
            }
          ]
        },
        right: command(words: [lit(text: "true")])
      }
    ]
  })
}

fn probe_pipe_and_or_flat_wrong() -> String {
  serialize_bash(p: ShellProgram {
    set_e: false,
    statements: [
      Pipe {
        left: AndOr {
          left: command(words: [lit(text: "true")]),
          op: AndThen,
          right: command(words: [lit(text: "false")])
        },
        right: command(words: [lit(text: "true")])
      }
    ]
  })
}

test fn bash_slice5b_pipe_probe_holds() -> Bool {
  probe_pipe_and_or_brace_grouped() == "{ 'true' && 'false'; } | 'true'\n" &&
    probe_pipe_and_or_flat_wrong() == "'true' && 'false' | 'true'\n" &&
    probe_pipe_and_or_brace_grouped() != probe_pipe_and_or_flat_wrong()
}
