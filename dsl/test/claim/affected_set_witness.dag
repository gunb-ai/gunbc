// By-execution witness for the affected-set lens (std/graph.dag affected_set /
// dependents). Reverse-reachability over a dependency graph: "if I change node
// N, which nodes downstream are affected?" — the substrate form of the retired
// #5056 CI-timings crate, as a pure lens.
//
// Run:
//   gunbc run --source-root dsl/std --source-root dsl/test \
//     --entry dsl/test/claim/affected_set_witness.dag --function main
//
// Demo dependency graph (edge caller DEPENDS ON callee):
//
//   cpu ──▶ algebra ──▶ integer        text ──▶ freemonoid
//
// So changing `integer` affects {integer, algebra, cpu}; the `text/freemonoid`
// branch is independent and MUST be excluded (the discriminating red).

module test.claim.affected_set_witness

import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_code_general_error }
import std.graph { CallGraph, GraphEdge, affected_set, dependents }

fn demo_names() -> List<String> {
  ["integer", "algebra", "cpu", "freemonoid", "text"]
}

fn demo_graph() -> CallGraph {
  CallGraph {
    edges: [
      GraphEdge { caller: "algebra", callee: "integer" },
      GraphEdge { caller: "cpu",     callee: "algebra" },
      GraphEdge { caller: "text",    callee: "freemonoid" },
    ]
  }
}

fn has(xs: List<String>, x: String) -> Bool {
  xs |> any(e => e == x)
}

fn join(xs: List<String>) -> String {
  xs |> fold(init: "", f: (acc, e) => if acc == "" { e } else { concat(acc, ", ", e) })
}

// affected_set("integer") must contain its transitive dependents and exclude
// the unrelated branch.
fn w_integer_reaches_cpu() -> Bool {
  has(affected_set(names: demo_names(), graph: demo_graph(), n: "integer"), "cpu")
}
fn w_integer_includes_self_and_direct() -> Bool {
  let a = affected_set(names: demo_names(), graph: demo_graph(), n: "integer")
  has(a, "integer") && has(a, "algebra")
}
// DISCRIMINATING: the independent text/freemonoid branch is NOT affected by
// integer. Goes red if the lens ever folds over forward (not reverse) edges,
// or returns the whole graph.
fn w_integer_excludes_unrelated() -> Bool {
  let a = affected_set(names: demo_names(), graph: demo_graph(), n: "integer")
  (has(a, "text") == false) && (has(a, "freemonoid") == false)
}
// A top node nothing depends on: affected set is just itself (minimal blast radius).
fn w_cpu_affects_only_self() -> Bool {
  let a = affected_set(names: demo_names(), graph: demo_graph(), n: "cpu")
  has(a, "cpu") && (has(a, "algebra") == false) && (has(a, "integer") == false)
}
// dependents is 1-hop only: integer's direct dependent is algebra, NOT cpu.
fn w_dependents_one_hop() -> Bool {
  let d = dependents(names: demo_names(), graph: demo_graph(), n: "integer")
  has(d, "algebra") && (has(d, "cpu") == false)
}
// Directionality cross-check: the other branch is symmetric and disjoint.
fn w_other_branch_isolated() -> Bool {
  let a = affected_set(names: demo_names(), graph: demo_graph(), n: "freemonoid")
  has(a, "text") && (has(a, "integer") == false) && (has(a, "cpu") == false)
}

fn keystone() -> Bool {
  w_integer_reaches_cpu()
    && w_integer_includes_self_and_direct()
    && w_integer_excludes_unrelated()
    && w_cpu_affects_only_self()
    && w_dependents_one_hop()
    && w_other_branch_isolated()
}

func main() -> ProcessExit {
  if keystone() {
    ExitSuccess
  } else {
    let integer_blast = affected_set(names: demo_names(), graph: demo_graph(), n: "integer")
    ExitFailure { code: exit_code_general_error, reason: concat(
      "affected-set witness FAILED. change 'integer' -> got {", join(integer_blast), "}") }
  }
}

// Visibility readout: the affected set for each node, surfaced via the typed
// reason (no modeled stdout yet). Always "fails" — it's a printout, not a gate.
func show() -> ProcessExit {
  let ns = demo_names()
  let g = demo_graph()
  let report = ns |> fold(init: "affected-set per node (change X -> re-realize):", f: (acc, x) =>
    concat(acc, "\n  change '", x, "'  -> {", join(affected_set(names: ns, graph: g, n: x)), "}"))
  ExitFailure { code: exit_code_general_error, reason: report }
}
