module test.claim.fleet_host_budget

import std.types { Int, List, String, Bool }
import std.measure { ByteSize, byte_size, byte_size_count, HardwareThreadCount, hardware_thread_count, hardware_thread_count_value }
import product.budget_tree { BudgetNode, node_conserves }
import extdeps.ctrl.jobserver {
  CtrlJobserverConfig,
  CtrlJobserverCitation,
  CtrlJobserverCited,
  CtrlJobserverAbsent,
  ctrl_jobserver_config,
  ctrl_jobserver_flip_values_marker,
  derive_jobserver_tokens,
  jobserver_build_pool_bytes,
}
import gunbc.fleet_container {
  FleetContainerType,
  GhaRunnerContainer,
  AgentSessionContainer,
  ContainerBaseline,
  ContainerBaselineMeasured,
  ContainerBaselineUnmeasured,
  BaselineResolution,
  BaselineResolved,
  BaselineUnmeasured,
  container_baseline_bytes,
  idle_memory_envelope,
  gha_runner_container,
  agent_session_container,
  fleet_container_baseline_provenance,
}
import gunbc.fleet_host_budget {
  HeadroomPolicy,
  HeadroomSet,
  HeadroomUnset,
  HeadroomResolution,
  HeadroomResolved,
  HeadroomUnsound,
  resolve_headroom,
  oomd_actuation_floor,
  FleetHostPlan,
  FleetHostPlanDerived,
  FleetHostPlanUnsound,
  fleet_host_plan,
  fleet_host_plan_for,
  fleet_host_budget_tree,
  capped_build_pool,
  baselines_sum,
  nominal_build_pool,
  runner_slice_cap,
  runner_slice_cap_drifted,
  fleet_build_realization_marker,
  gunbc_fleet_oomd_floor_basis,
  gunbc_fleet_runner_slice_dropin_marker,
  gunbc_fleet_capped_build_pool_marker,
  gunbc_fleet_runner_slice_drift_marker,
}
import gunbc.ci_floor_measurement {
  OomdEnforcementEvidence,
  OomdEnforced,
  OomdUnverified,
  RunnerSliceCapEffectiveness,
  CapEffective,
  CapUnbounded,
  gunbc_ci_regime2_aggregate_dissolution_marker,
}

fn fixture_cfg() -> CtrlJobserverConfig {
  CtrlJobserverConfig {
    margin: hardware_thread_count(count: 8),
    mem_reserve: byte_size(8589934592),
    mib_per_job: byte_size(1879048192),
  }
}

fn fixture_citation() -> CtrlJobserverCitation {
  CtrlJobserverCited { config: fixture_cfg(), provenance: "fixture: parent-supplied installer knobs" }
}

fn runner_idle_bytes() -> ByteSize {
  byte_size(314572800)
}

fn session_idle_bytes() -> ByteSize {
  byte_size(471859200)
}

fn fixture_runner_measured() -> FleetContainerType {
  GhaRunnerContainer { baseline: ContainerBaselineMeasured { idle: idle_memory_envelope(min_bytes: runner_idle_bytes()) } }
}

fn fixture_session_measured() -> FleetContainerType {
  AgentSessionContainer { baseline: ContainerBaselineMeasured { idle: idle_memory_envelope(min_bytes: session_idle_bytes()) } }
}

fn fixture_baselines() -> ByteSize {
  baselines_sum(runner_baseline: runner_idle_bytes(), session_baseline: session_idle_bytes())
}

fn fixture_runner_unmeasured() -> FleetContainerType {
  GhaRunnerContainer { baseline: ContainerBaselineUnmeasured }
}

fn host_125gib() -> ByteSize {
  byte_size(134217728000)
}

fn overhead_16gib() -> ByteSize {
  byte_size(17179869184)
}

fn fitting_headroom() -> HeadroomPolicy {
  HeadroomSet { bytes: byte_size(16106127360) }
}

fn is_unsound(plan: FleetHostPlan) -> Bool {
  match plan {
    FleetHostPlanUnsound { reason: _ } => true
    FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: _, effective_build_tokens: _, build_step: _ } => false
  }
}

fn full_plan(
  citation: CtrlJobserverCitation,
  runner: FleetContainerType,
  session: FleetContainerType,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  fleet_host_plan_for(
    name: "fixture",
    host: host_125gib(),
    overhead: overhead_16gib(),
    nproc: hardware_thread_count(count: 128),
    runner: runner,
    session: session,
    citation: citation,
    policy: policy,
    oomd: oomd
  )
}

fn witness_live_plan_fail_closed() -> Bool {
  is_unsound(plan: fleet_host_plan())
}

fn witness_jobserver_absent_unsound() -> Bool {
  is_unsound(plan: full_plan(citation: CtrlJobserverAbsent, runner: fixture_runner_measured(), session: fixture_session_measured(), policy: fitting_headroom(), oomd: OomdEnforced))
}

fn witness_baseline_unmeasured_unsound() -> Bool {
  is_unsound(plan: full_plan(citation: fixture_citation(), runner: fixture_runner_unmeasured(), session: fixture_session_measured(), policy: fitting_headroom(), oomd: OomdEnforced))
}

fn witness_headroom_unset_unsound() -> Bool {
  is_unsound(plan: full_plan(citation: fixture_citation(), runner: fixture_runner_measured(), session: fixture_session_measured(), policy: HeadroomUnset, oomd: OomdEnforced))
}

fn witness_oomd_unverified_unsound() -> Bool {
  is_unsound(plan: full_plan(citation: fixture_citation(), runner: fixture_runner_measured(), session: fixture_session_measured(), policy: fitting_headroom(), oomd: OomdUnverified))
}

fn witness_headroom_below_floor_unsound() -> Bool {
  let floor = oomd_actuation_floor(host: host_125gib())
  match resolve_headroom(policy: HeadroomSet { bytes: byte_size(1073741824) }, floor: floor) {
    HeadroomUnsound { reason: _ } => true
    HeadroomResolved { bytes: _ } => false
  }
}

fn witness_headroom_at_or_above_floor_resolved() -> Bool {
  let floor = oomd_actuation_floor(host: host_125gib())
  match resolve_headroom(policy: HeadroomSet { bytes: floor }, floor: floor) {
    HeadroomResolved { bytes: b } => byte_size_count(b: b) == byte_size_count(b: floor)
    HeadroomUnsound { reason: _ } => false
  }
}

fn witness_tokens_memory_bound_binds() -> Bool {
  let cfg = fixture_cfg()
  let tokens = hardware_thread_count_value(t: derive_jobserver_tokens(nproc: hardware_thread_count(count: 128), mem_total: host_125gib(), cfg: cfg))
  tokens > 0 && tokens < 120
}

fn oversized_margin_cfg() -> CtrlJobserverConfig {
  CtrlJobserverConfig {
    margin: hardware_thread_count(count: 64),
    mem_reserve: byte_size(8589934592),
    mib_per_job: byte_size(1879048192),
  }
}

fn witness_margin_exceeds_nproc_saturates() -> Bool {
  let tokens = hardware_thread_count_value(t: derive_jobserver_tokens(nproc: hardware_thread_count(count: 8), mem_total: host_125gib(), cfg: oversized_margin_cfg()))
  tokens == 0
}

fn witness_plan_derives_and_conserves() -> Bool {
  match full_plan(citation: fixture_citation(), runner: fixture_runner_measured(), session: fixture_session_measured(), policy: fitting_headroom(), oomd: OomdEnforced) {
    FleetHostPlanDerived { name: _, tree: t, runner_slice_cap: _, effective_build_tokens: tk, build_step: _ } =>
      node_conserves(node: t) && hardware_thread_count_value(t: tk) > 0
    FleetHostPlanUnsound { reason: _ } => false
  }
}

fn witness_uncapped_build_pool_overcommits() -> Bool {
  let cfg = fixture_cfg()
  let headroom = byte_size(16106127360)
  let nominal = nominal_build_pool(nproc: hardware_thread_count(count: 128), mem_total: host_125gib(), cfg: cfg)
  let bloated = byte_size(byte_size_count(b: nominal) * 4)
  let tree = fleet_host_budget_tree(name: "overcommit", host: host_125gib(), overhead: overhead_16gib(), runner_baseline: runner_idle_bytes(), session_baseline: session_idle_bytes(), build_pool: bloated, headroom: headroom)
  !node_conserves(node: tree)
}

fn witness_capped_build_pool_positive_and_bounded() -> Bool {
  let cfg = fixture_cfg()
  let baselines = fixture_baselines()
  let headroom = byte_size(16106127360)
  let nominal = nominal_build_pool(nproc: hardware_thread_count(count: 128), mem_total: host_125gib(), cfg: cfg)
  let pool = capped_build_pool(host: host_125gib(), overhead: overhead_16gib(), baselines: baselines, headroom: headroom, nominal: nominal)
  let room = byte_size_count(b: host_125gib()) - byte_size_count(b: overhead_16gib()) - byte_size_count(b: baselines) - byte_size_count(b: headroom)
  byte_size_count(b: pool) > 0 && byte_size_count(b: pool) <= room
}

fn witness_runner_slice_cap_conserves() -> Bool {
  let cfg = fixture_cfg()
  let baselines = fixture_baselines()
  let headroom = byte_size(16106127360)
  let nominal = nominal_build_pool(nproc: hardware_thread_count(count: 128), mem_total: host_125gib(), cfg: cfg)
  let pool = capped_build_pool(host: host_125gib(), overhead: overhead_16gib(), baselines: baselines, headroom: headroom, nominal: nominal)
  let cap = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), baselines: baselines, build_pool: pool, headroom: headroom)
  let total = byte_size_count(b: overhead_16gib()) + byte_size_count(b: baselines) + byte_size_count(b: pool) + byte_size_count(b: headroom) + byte_size_count(b: cap)
  total <= byte_size_count(b: host_125gib())
}

fn witness_runner_slice_cap_drift_red_receipt() -> Bool {
  let disk = byte_size(70391285350)
  runner_slice_cap_drifted(disk_cap: disk, effective: CapUnbounded)
    && !runner_slice_cap_drifted(disk_cap: disk, effective: CapEffective { bytes: disk })
    && runner_slice_cap_drifted(disk_cap: disk, effective: CapEffective { bytes: byte_size(55307438489) })
}

fn witness_5650_marker_dissolution() -> Bool {
  let baselines = fixture_baselines()
  let headroom = byte_size(16106127360)
  let cfg = fixture_cfg()
  let nominal = nominal_build_pool(nproc: hardware_thread_count(count: 128), mem_total: host_125gib(), cfg: cfg)
  let pool = capped_build_pool(host: host_125gib(), overhead: overhead_16gib(), baselines: baselines, headroom: headroom, nominal: nominal)
  let cap = runner_slice_cap(host: host_125gib(), overhead: overhead_16gib(), baselines: baselines, build_pool: pool, headroom: headroom)
  let whole = byte_size_count(b: overhead_16gib()) + byte_size_count(b: baselines) + byte_size_count(b: pool) + byte_size_count(b: headroom) + byte_size_count(b: cap)
  byte_size_count(b: baselines) > 0
    && byte_size_count(b: pool) > 0
    && !(byte_size_count(b: baselines) == byte_size_count(b: pool))
    && whole == byte_size_count(b: host_125gib())
    && gunbc_ci_regime2_aggregate_dissolution_marker != ""
}

fn witness_markers_documented() -> Bool {
  ctrl_jobserver_flip_values_marker != ""
    && fleet_container_baseline_provenance != ""
    && fleet_build_realization_marker != ""
    && gunbc_fleet_oomd_floor_basis != ""
    && gunbc_fleet_runner_slice_dropin_marker != ""
    && gunbc_fleet_capped_build_pool_marker != ""
    && gunbc_fleet_runner_slice_drift_marker != ""
}

test fn fleet_model_holds() -> Bool {
  witness_live_plan_fail_closed()
    && witness_jobserver_absent_unsound()
    && witness_baseline_unmeasured_unsound()
    && witness_headroom_unset_unsound()
    && witness_oomd_unverified_unsound()
    && witness_headroom_below_floor_unsound()
    && witness_headroom_at_or_above_floor_resolved()
    && witness_tokens_memory_bound_binds()
    && witness_margin_exceeds_nproc_saturates()
    && witness_plan_derives_and_conserves()
    && witness_uncapped_build_pool_overcommits()
    && witness_capped_build_pool_positive_and_bounded()
    && witness_runner_slice_cap_conserves()
    && witness_runner_slice_cap_drift_red_receipt()
    && witness_5650_marker_dissolution()
    && witness_markers_documented()
}
