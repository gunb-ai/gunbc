module test.claim.execution_receipt_digest

import std.types { Bool }
import product.compute_fabric {
  WorkUnitId,
  example_feasible_resource_work_demand,
  example_memory_work_demand,
  example_thread_work_demand,
  witness_execution_receipt_digest_differs_by_demand,
  witness_execution_receipt_digest_not_raw_work_id,
}

data sample_work_id: WorkUnitId = "witness:execution-receipt-digest"

test fn execution_receipt_digest_witnesses() -> Bool {
  witness_execution_receipt_digest_not_raw_work_id(
    work_id: sample_work_id,
    demand: example_feasible_resource_work_demand,
  )
    && witness_execution_receipt_digest_differs_by_demand(
      work_id: sample_work_id,
      left: example_feasible_resource_work_demand,
      right: example_thread_work_demand,
    )
    && witness_execution_receipt_digest_differs_by_demand(
      work_id: sample_work_id,
      left: example_feasible_resource_work_demand,
      right: example_memory_work_demand,
    )
}
