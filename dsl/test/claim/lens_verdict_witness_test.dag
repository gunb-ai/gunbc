module test.claim.lens_verdict_witness

import std.lens_verdict {
  Holds,
  LensVerdict,
  LensVerdictDiagnostic,
  NotApplicable,
  Unrealized,
  Violation,
  ModuleWholeFile,
}

data witness_module: String = "test.claim.lens_verdict_witness"

fn sample_diagnostic(reason: String) -> LensVerdictDiagnostic {
  LensVerdictDiagnostic {
    reason: reason,
    at: ModuleWholeFile { module_name: witness_module }
  }
}

fn sample_violation() -> LensVerdict {
  Violation { diagnostic: sample_diagnostic(reason: "lens_verdict_witness_violation") }
}

fn sample_unrealized() -> LensVerdict {
  Unrealized { diagnostic: sample_diagnostic(reason: "lens_verdict_witness_unrealized") }
}

fn sample_holds() -> LensVerdict {
  Holds
}

fn witness_fail_closed_green_on_unrealized() -> Bool {
  match sample_unrealized() {
    Unrealized { diagnostic: _ } => true
    _ => false
  }
}

fn witness_fail_closed_red_on_holds() -> Bool {
  match sample_holds() {
    Unrealized { diagnostic: _ } => false
    _ => true
  }
}

fn witness_is_violation_green_on_violation() -> Bool {
  match sample_violation() {
    Violation { diagnostic: _ } => true
    _ => false
  }
}

fn witness_is_violation_red_on_holds() -> Bool {
  match sample_holds() {
    Violation { diagnostic: _ } => false
    _ => true
  }
}

fn witness_locus_green_on_violation() -> Bool {
  match sample_violation() {
    Violation { diagnostic: d } => match d.at {
      ModuleWholeFile { module_name: m } => m == witness_module
    }
    _ => false
  }
}

fn witness_locus_red_on_perturbed_module() -> Bool {
  let perturbed = Violation {
    diagnostic: LensVerdictDiagnostic {
      reason: "lens_verdict_witness_perturbed",
      at: ModuleWholeFile { module_name: "test.claim.lens_verdict_witness_wrong_module" }
    }
  }
  match perturbed {
    Violation { diagnostic: d } => match d.at {
      ModuleWholeFile { module_name: m } => m != witness_module
    }
    _ => false
  }
}

test fn lens_verdict_witnesses() -> Bool {
  witness_fail_closed_green_on_unrealized()
    && witness_fail_closed_red_on_holds()
    && witness_is_violation_green_on_violation()
    && witness_is_violation_red_on_holds()
    && witness_locus_green_on_violation()
    && witness_locus_red_on_perturbed_module()
}
