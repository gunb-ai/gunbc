// dsl/test/claim/medium_witness_test.dag — by-execution witnesses for std.medium Cut 2.
//
// GREEN: DecodeFidelity variants discriminate via match; TextMedium carries fidelity.
// RED controls: wrong arm must not satisfy the green witness.
//
// Run: gunbc run --source-root dsl --entry <this> --function medium_witnesses --claim-run

module test.claim.medium_witness

import std.medium {
  DecodeFidelity,
  Lossless,
  Lossy,
  Medium,
  TextMedium,
}
import std.types { String }
import std.logic { Bool }

fn witness_lossless_arm() -> Bool {
  let f = Lossless
  match f {
    Lossless => true
    Lossy => false
  }
}

fn witness_lossy_arm() -> Bool {
  let f = Lossy
  match f {
    Lossy => true
    Lossless => false
  }
}

fn witness_lossless_not_lossy_red_control() -> Bool {
  let f = Lossless
  match f {
    Lossy => true
    Lossless => false
  }
}

fn witness_text_medium_lossless_carries_lossless_fidelity() -> Bool {
  let m = TextMedium { fidelity: Lossless }
  match m.fidelity {
    Lossless => true
    Lossy => false
  }
}

fn witness_text_medium_lossy_carries_lossy_fidelity() -> Bool {
  let m = TextMedium { fidelity: Lossy }
  match m.fidelity {
    Lossy => true
    Lossless => false
  }
}

fn string_medium_lossless() -> Medium<String> {
  Medium { fidelity: Lossless }
}

fn witness_generic_medium_string_instantiation() -> Bool {
  let m = string_medium_lossless()
  match m.fidelity {
    Lossless => true
    Lossy => false
  }
}

test fn medium_witnesses() -> Bool {
  witness_lossless_arm()
    && witness_lossy_arm()
    && !witness_lossless_not_lossy_red_control()
    && witness_text_medium_lossless_carries_lossless_fidelity()
    && witness_text_medium_lossy_carries_lossy_fidelity()
    && witness_generic_medium_string_instantiation()
}
