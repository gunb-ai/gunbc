// dsl/test/claim/medium_witness_test.dag — by-execution witnesses for std.medium Cut 2.
//
// GREEN: DecodeFidelity variants discriminate; lossless/lossy predicates are exact.
// RED controls: inverted predicate must not satisfy the green witness.
//
// Run: gunbc run --source-root dsl --entry <this> --function medium_witnesses --claim-run

module test.claim.medium_witness

import std.medium {
  Lossless,
  Lossy,
  decode_fidelity_is_lossless,
  decode_fidelity_is_lossy,
}
import std.logic { Bool }

fn witness_lossless_predicate_holds() -> Bool {
  decode_fidelity_is_lossless(f: Lossless)
    && !decode_fidelity_is_lossy(f: Lossless)
}

fn witness_lossy_predicate_holds() -> Bool {
  decode_fidelity_is_lossy(f: Lossy)
    && !decode_fidelity_is_lossless(f: Lossy)
}

fn witness_lossless_predicate_red_on_lossy() -> Bool {
  decode_fidelity_is_lossless(f: Lossy)
}

fn witness_lossy_predicate_red_on_lossless() -> Bool {
  decode_fidelity_is_lossy(f: Lossless)
}

test fn medium_witnesses() -> Bool {
  witness_lossless_predicate_holds()
    && witness_lossy_predicate_holds()
    && !witness_lossless_predicate_red_on_lossy()
    && !witness_lossy_predicate_red_on_lossless()
}
