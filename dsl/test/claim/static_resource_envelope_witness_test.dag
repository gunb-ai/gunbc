module test.claim.static_resource_envelope

import std.static_resource_envelope {
  witness_envelope_fits_when_all_axes_within_cap,
  witness_envelope_red_on_memory_over_cap,
  witness_derived_width_memory_limited,
  witness_declared_sizes_derive_memory_peak,
  witness_zero_demand_axis_does_not_bind,
  runnable_static_peak,
  derive_spawn_width,
  ResourceCap,
  static_peak,
  envelope_fits_cap,
  EnvelopeOverCap,
  envelope_reconciled,
  MemoryAxis,
}
import std.realization_schedule {
  RunnableSingleClaim,
  runnable_resource_profile,
  runnable_memory_substantial,
}
import std.measure {
  byte_size,
  byte_size_count,
  hardware_thread_count,
  hardware_thread_count_value,
  watt,
}
import gunbc.ci_static_resource_envelope {
  witness_ci_corpus_envelope_derives_peak,
  witness_envelope_unknown_refuses_peak_derivation,
  ci_floor_resolve_peak,
}

test fn static_resource_envelope_reconciliation_witnesses() -> Bool {
  witness_envelope_fits_when_all_axes_within_cap()
    && witness_envelope_red_on_memory_over_cap()
}

test fn static_resource_envelope_width_derivation_witnesses() -> Bool {
  witness_derived_width_memory_limited()
    && witness_zero_demand_axis_does_not_bind()
}

test fn static_resource_envelope_declared_input_witnesses() -> Bool {
  witness_declared_sizes_derive_memory_peak()
}

test fn static_resource_envelope_runnable_peak_witnesses() -> Bool {
  let r = RunnableSingleClaim {
    entry: "e"
    function: "f"
    profile: runnable_resource_profile(
      heavy_whole_tree_resolve: false,
      spawns_host_compiler: false,
      memory: runnable_memory_substantial(predicted_peak: byte_size(count: 42))
    )
  }
  byte_size_count(b: runnable_static_peak(r: r).memory) == 42
}

test fn static_resource_envelope_ci_bridge_witnesses() -> Bool {
  witness_ci_corpus_envelope_derives_peak()
    && witness_envelope_unknown_refuses_peak_derivation()
    && byte_size_count(b: ci_floor_resolve_peak().memory) > 0
}

test fn static_resource_envelope_red_on_cap_shrink() -> Bool {
  let peak = static_peak(
    memory: byte_size(count: 5000),
    compute: hardware_thread_count(count: 1),
    storage: byte_size(count: 0),
    energy: watt(count: 0)
  )
  let fits = envelope_fits_cap(
    peak: peak,
    cap: ResourceCap {
      memory: byte_size(count: 10000)
      compute: hardware_thread_count(count: 128)
      storage: byte_size(count: 0)
      energy: watt(count: 0)
    }
  )
  let over = match envelope_reconciled(
    peak: peak,
    cap: ResourceCap {
      memory: byte_size(count: 1000)
      compute: hardware_thread_count(count: 128)
      storage: byte_size(count: 0)
      energy: watt(count: 0)
    }
  ) {
    EnvelopeOverCap { axis: a } => a == MemoryAxis
    _ => false
  }
  fits && over
}
