module test.claim.live_deploy_emit

import std.types { Bool, String }
import gunbc.live_deploy {
  DeploymentSpec,
  DeploymentEnsuredStep,
  TailscalePackage,
  NodeJsPackage,
  deployment_spec_srv1,
  deployment_plan_host_identity,
  deployment_package_manager_is_apt,
  deployment_plan_listen_port,
  deployment_ensure_dependency_script,
  deployment_step_is_owned,
  deployment_step_is_ensured,
  deployment_retract_includes_ensured,
  deployment_owned_steps_retract_order,
  gunbc_roadmap_unit_name,
  gunbc_roadmap_server_path,
}
import gunbc.live_deploy_emit {
  expected_live_deploy_apply_script,
  expected_live_deploy_retract_script,
  live_deploy_apply_script_drifted,
  live_deploy_retract_script_drifted,
  live_deploy_systemd_unit_for,
}
import extdeps.apt { package_tailscale, package_nodejs }

fn witness_spec_targets_srv1() -> Bool {
  deployment_plan_host_identity(spec: deployment_spec_srv1()) == "srv1"
}

fn witness_spec_uses_apt_package_manager() -> Bool {
  deployment_package_manager_is_apt(spec: deployment_spec_srv1())
}

fn witness_spec_listen_port_is_8080() -> Bool {
  deployment_plan_listen_port(spec: deployment_spec_srv1()) == 8080
}

fn witness_owned_vs_ensured_typed() -> Bool {
  let spec = deployment_spec_srv1()
  let has_owned = fold(spec.steps, init: false, f: (acc, s) => acc || deployment_step_is_owned(step: s))
  let has_ensured = fold(spec.steps, init: false, f: (acc, s) => acc || deployment_step_is_ensured(step: s))
  has_owned && has_ensured
}

fn witness_retract_owned_only() -> Bool {
  fold(
    deployment_owned_steps_retract_order(),
    init: true,
    f: (acc, s) => acc && !deployment_retract_includes_ensured(step: s)
  )
}

fn witness_dependency_ensure_is_idempotent() -> Bool {
  let tailscale = deployment_ensure_dependency_script(
    dep: DeploymentEnsuredStep { kind: TailscalePackage, package: package_tailscale }
  )
  let nodejs = deployment_ensure_dependency_script(
    dep: DeploymentEnsuredStep { kind: NodeJsPackage, package: package_nodejs }
  )
  string_contains(s: tailscale, pattern: "dpkg -s tailscale")
    && string_contains(s: tailscale, pattern: "apt-get install -y tailscale")
    && string_contains(s: nodejs, pattern: "dpkg -s nodejs")
    && string_contains(s: nodejs, pattern: "apt-get install -y nodejs")
}

fn witness_apply_script_contains_systemd_and_tailscale() -> Bool {
  let sh = expected_live_deploy_apply_script()
  string_contains(s: sh, pattern: "gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "[Service]")
    && string_contains(s: sh, pattern: "systemctl enable --now gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "tailscale serve --bg 8080")
    && string_contains(s: sh, pattern: "ensure_apt_package \"tailscale\"")
    && string_contains(s: sh, pattern: "ensure_apt_package \"nodejs\"")
    && string_contains(s: sh, pattern: "fold=apply verdict=converged")
}

fn witness_retract_script_owned_only() -> Bool {
  let sh = expected_live_deploy_retract_script()
  string_contains(s: sh, pattern: "tailscale serve reset")
    && string_contains(s: sh, pattern: "systemctl disable --now gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "rm -f /opt/gunbc/server.js")
    && string_contains(s: sh, pattern: "rm -f /etc/systemd/system/gunbc-roadmap.service")
    && string_contains(s: sh, pattern: "fold=retract verdict=converged")
    && !string_contains(s: sh, pattern: "apt-get remove")
    && !string_contains(s: sh, pattern: "apt-get purge")
}

fn witness_apply_script_contains_node_server() -> Bool {
  string_contains(s: expected_live_deploy_apply_script(), pattern: "require('http').createServer")
}

fn witness_systemd_unit_emitted() -> Bool {
  let unit = live_deploy_systemd_unit_for(spec: deployment_spec_srv1())
  string_contains(s: unit, pattern: "ExecStart=/usr/bin/node /opt/gunbc/server.js")
    && string_contains(s: unit, pattern: "Environment=PORT=8080")
}

fn witness_drift_gates() -> Bool {
  !live_deploy_apply_script_drifted(committed: expected_live_deploy_apply_script())
    && live_deploy_apply_script_drifted(committed: concat(expected_live_deploy_apply_script(), "x"))
    && !live_deploy_retract_script_drifted(committed: expected_live_deploy_retract_script())
    && live_deploy_retract_script_drifted(committed: concat(expected_live_deploy_retract_script(), "x"))
}

test fn live_deploy_emit_holds() -> Bool {
  witness_spec_targets_srv1()
    && witness_spec_uses_apt_package_manager()
    && witness_spec_listen_port_is_8080()
    && witness_owned_vs_ensured_typed()
    && witness_retract_owned_only()
    && witness_dependency_ensure_is_idempotent()
    && witness_apply_script_contains_systemd_and_tailscale()
    && witness_retract_script_owned_only()
    && witness_apply_script_contains_node_server()
    && witness_systemd_unit_emitted()
    && witness_drift_gates()
}
