module test.claim.realization_reconcile_witness

import std.types { Bool, String, List }
import std.effects { CreateEffect, CreateIfAbsent, PostAlways, InputField }
import std.realization {
  RealizedStep, LocalInProcess,
  Materialization, Recompute, Memoize, Share,
  reconcile,
}
import std.realization_schedule { cost_account_predicted_zero }

fn is_share(m: Materialization) -> Bool {
  match m {
    Share => true
    Recompute => false
    Memoize => false
  }
}

fn step_create_if_absent(field: String) -> RealizedStep {
  RealizedStep {
    shape: CreateEffect { cause: CreateIfAbsent { key_source: InputField { field: field } } },
    placement: LocalInProcess,
    materialization: Recompute,
    cost: cost_account_predicted_zero()
  }
}

fn step_post_always() -> RealizedStep {
  RealizedStep {
    shape: CreateEffect { cause: PostAlways },
    placement: LocalInProcess,
    materialization: Recompute,
    cost: cost_account_predicted_zero()
  }
}

fn has_exactly_one_share(steps: List<RealizedStep>) -> Bool {
  (steps |> filter(e => is_share(m: e.materialization)) |> length) == 1
}

fn has_no_share(steps: List<RealizedStep>) -> Bool {
  (steps |> filter(e => is_share(m: e.materialization)) |> length) == 0
}

fn witness_same_keysource_collapses_to_share() -> Bool {
  let out = reconcile(steps: [
    step_create_if_absent(field: "id"),
    step_create_if_absent(field: "id")
  ])
  (out |> length) == 1 && has_exactly_one_share(steps: out)
}

fn witness_different_keysource_does_not_collapse() -> Bool {
  let out = reconcile(steps: [
    step_create_if_absent(field: "id"),
    step_create_if_absent(field: "other")
  ])
  (out |> length) == 2 && has_no_share(steps: out)
}

fn witness_post_always_never_collapses() -> Bool {
  let out = reconcile(steps: [ step_post_always(), step_post_always() ])
  (out |> length) == 2 && has_no_share(steps: out)
}

test fn reconcile_share_collapse_witnesses() -> Bool {
  witness_same_keysource_collapses_to_share()
    && witness_different_keysource_does_not_collapse()
    && witness_post_always_never_collapses()
}
