// dsl/test/claim/http_pilot_rest_witness.dag
//
// By-execution witnesses for REST hermetic pilot (extdeps/test/http_pilot.dag).
//
// End-state hermetic behaviors (pilot op has dissolved inline mock_response):
//   1. --record --fixture-store     → wet capture (fixture born by execution)
//   2. --hermetic --fixture-store   → RecordedFixture replay ([hermetic:fixture])
//   3. --hermetic (no store)        → eval_mock_response finds no mock_response →
//      FAIL CLOSED ("no mock_response ... refusing to fabricate") — NOT a stub value
//
// Hermetic replay (Phase 2):
//   CI floor: committed fixture at dsl/extdeps/test/fixtures/http_pilot (no live host).
//   Wet record (opt-in, not every-push floor):
//     claim_batch --source-root . --source-root dsl \
//       --entry dsl/test/claim/http_pilot_rest_witness.dag \
//       --function http_pilot_rest_keystone_holds --record --fixture-store /tmp/http-pilot-fixtures
//   Copy captured files into dsl/extdeps/test/fixtures/http_pilot/ to refresh the seed.
//   Also: v1-compiler-tests interp_recorded_fixture_test::http_pilot_rest_record_then_hermetic_replay_holds
//
// Discriminators (v1-compiler-tests `interp_recorded_fixture_test`):
//   * http_pilot_rest_record_then_hermetic_replay_holds — behaviors 1+2
//   * hermetic_http_pilot_without_fixture_store_fails_closed — behavior 3 (strongest stub-gone proof)
//   * hermetic_http_pilot_fixture_staleness_fails_closed — staleness fail-closed

module test.claim.http_pilot_rest_witness

import extdeps.test.http_pilot

func witness_get_post_title_nonempty() -> Bool {
  let r = test.HttpPilot.GetPost(post_id: 1)
  return (r.title != "") && (r.post_id == 1)
}

fn http_pilot_rest_keystone_holds() -> Bool {
  witness_get_post_title_nonempty()
}
