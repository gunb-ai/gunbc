// dsl/test/claim/roadmap_status_test.dag
//
// §5 discriminating proof for gunbc.roadmap_status — the PR→checkbox status derivation, first slice
// of inverting the hand-maintained ROADMAP (docs/plans/invert-hand-maintained.md). Proven BY
// EXECUTION over the derivation folds, not by typecheck or grep.
//
// The non-tautology proof is the DERIVABLE-vs-AUTHORED boundary, now STRUCTURAL (the slice-3b fold):
// a roadmap line is a closed `RoadmapItem` sum, so drift keys on a DerivableLine's binding, NOT on any
// mentioned PR. The decisive witness is `witness_partial_evidence_merged_mention_stays_green` — an
// AuthoredLine that cites a MERGED PR in its prose while correctly `[ ]` (the real ROADMAP §0
// "rust-gate coverage" / #5456 case) evaluates GREEN, because an AuthoredLine has no `prs` to derive
// from — the bad "mention ⇒ derived box" state is UNWRITABLE (§5 construction over validation). A
// blanket "mentions a merged PR + `[ ]` ⇒ drift" rule would turn that RED. Flip the boundary and that
// witness goes red; flip the drift compare and the `*_drifts` witnesses go red.
//
// Run: gunbc run --source-root dsl --entry dsl/test/claim/roadmap_status_test.dag \
//        --function roadmap_status_witnesses --claim-run

module test.claim.roadmap_status

import extdeps.github.pulls { PullRequest, PullRequestRef, Open }
import extdeps.github.github { GitHubUser, User }
import gunbc.roadmap_status {
  RoadmapItem, DerivableLine, AuthoredLine,
  DriftVerdict, Drifted, Clean, Underivable,
  pr_merged, merged_pr_numbers, prs_all_merged,
  item_is_done, status_drift, item_drifted, item_drifts_against_prs,
}

// --- Fixtures: two PRs, one merged one open -----------------------------------

data witness_user: GitHubUser = { login: "gunbai-bot", id: 1, type: User }
data witness_ref: PullRequestRef = { ref: "feature", sha: "deadbeef", label: "gunb:feature" }

// A merged PR (merged_at populated) and an open one (merged_at: none). String->Timestamp coercion is
// accepted in record-field position, so these are built as direct literals.
data pr_5445: PullRequest = {
  number: 5445,
  title: "merged witness pr",
  body: none,
  state: Open,
  html_url: "https://github.com/gunb/gunbc/pull/5445",
  user: witness_user,
  head: witness_ref,
  base: witness_ref,
  created_at: "2026-06-21T00:00:00",
  updated_at: "2026-06-21T00:00:00",
  merged_at: "2026-06-20T00:00:00",
  draft: false,
}
data pr_open_9999: PullRequest = {
  number: 9999,
  title: "open witness pr",
  body: none,
  state: Open,
  html_url: "https://github.com/gunb/gunbc/pull/9999",
  user: witness_user,
  head: witness_ref,
  base: witness_ref,
  created_at: "2026-06-21T00:00:00",
  updated_at: "2026-06-21T00:00:00",
  merged_at: none,
  draft: false,
}

// --- Verdict matchers ---------------------------------------------------------

fn is_drifted(v: DriftVerdict) -> Bool {
  match v { Drifted => true  Clean => false  Underivable => false }
}
fn is_clean(v: DriftVerdict) -> Bool {
  match v { Clean => true  Drifted => false  Underivable => false }
}
fn is_underivable(v: DriftVerdict) -> Bool {
  match v { Underivable => true  Drifted => false  Clean => false }
}

// Line constructors: a derivable line (box derived from `prs`, empty fenced tail) and an authored line
// (box hand-set, content verbatim).
fn derivable(prs: List<Int>, title: String) -> RoadmapItem {
  DerivableLine { prs: prs, title: title, description: "" }
}
fn authored(done: Bool, content: String) -> RoadmapItem {
  AuthoredLine { done: done, content: content }
}

// === Authority: pr_merged reads merged_at =====================================

fn witness_merged_pr_is_merged() -> Bool {
  pr_merged(pr: pr_5445)
}
fn witness_open_pr_not_merged() -> Bool {
  !pr_merged(pr: pr_open_9999)
}
fn witness_merged_numbers_projection() -> Bool {
  let nums = merged_pr_numbers(prs: [pr_5445, pr_open_9999])
  count(nums) == 1 && (nums |> any(n => n == 5445))
}

// === Derivation: prs_all_merged ===============================================

// All bound PRs merged -> done.
fn witness_all_merged_derives_done() -> Bool {
  prs_all_merged(prs: [5445], merged: [5445])
}
// A single unmerged bound PR -> not done (not yet landed).
fn witness_one_unmerged_derives_todo() -> Bool {
  !prs_all_merged(prs: [5445, 9999], merged: [5445])
}
// An empty binding -> not done (no merge evidence; fail-closed).
fn witness_empty_binding_derives_todo() -> Bool {
  !prs_all_merged(prs: [], merged: [5445])
}

// === The done-authority fold: item_is_done over both arms =====================

// A DerivableLine's box is DERIVED — done iff every bound PR merged (the inversion).
fn witness_derivable_done_from_merge() -> Bool {
  item_is_done(item: derivable(prs: [5445], title: "bound + landed"), merged: [5445])
    && !item_is_done(item: derivable(prs: [9999], title: "bound + open"), merged: [5445])
}
// An AuthoredLine's box is the AUTHORED Bool — merge state is irrelevant (honest residue).
fn witness_authored_done_is_authored() -> Bool {
  item_is_done(item: authored(done: true, content: "hand-checked done"), merged: [])
    && !item_is_done(item: authored(done: false, content: "hand-checked todo, cites #5445"), merged: [5445])
}

// === Drift verdict: only a DerivableLine can drift ============================

// THE soundness witness (parent-required): an AuthoredLine whose CONTENT cites a MERGED PR (#5445 is
// in the live merged set) while correctly `[ ]` — a partial-evidence mention — is UNDERIVABLE, never
// Drifted. It has no `prs`, so the "mention ⇒ derived box" state is unwritable. Real ROADMAP §0
// "rust-gate coverage" (#5456) shape. A blanket mention rule would flag it RED.
fn witness_partial_evidence_merged_mention_stays_green() -> Bool {
  let item = authored(done: false, content: "rust-gate coverage — cites merged #5445 as partial evidence, not done")
  is_underivable(v: status_drift(item: item, committed_box: false, merged: [5445]))
    && !item_drifted(item: item, committed_box: false, merged: [5445])
}

// An AuthoredLine `[x]` is also out of the gate's reach (operator's call, no binding to check).
fn witness_authored_done_underivable() -> Bool {
  let item = authored(done: true, content: "audit done, no PR")
  is_underivable(v: status_drift(item: item, committed_box: true, merged: []))
}

// The genuine stale-checkbox: a line EXPLICITLY bound to complete iff #5445 merges, #5445 merged,
// box still `[ ]` -> Drifted (the #5445/#5453 realization-vocab-guard case the plan cites).
fn witness_derivable_merged_box_todo_drifts() -> Bool {
  let item = derivable(prs: [5445], title: "bound + stale")
  is_drifted(v: status_drift(item: item, committed_box: false, merged: [5445]))
    && item_drifted(item: item, committed_box: false, merged: [5445])
}
// Premature `[x]`: bound to complete iff #9999 merges, #9999 unmerged -> Drifted.
fn witness_derivable_unmerged_box_done_drifts() -> Bool {
  let item = derivable(prs: [9999], title: "bound + premature")
  is_drifted(v: status_drift(item: item, committed_box: true, merged: [5445]))
}
// Correctly-marked `[x]` on a satisfied binding -> Clean.
fn witness_derivable_merged_box_done_clean() -> Bool {
  let item = derivable(prs: [5445], title: "bound + honest done")
  is_clean(v: status_drift(item: item, committed_box: true, merged: [5445]))
    && !item_drifted(item: item, committed_box: true, merged: [5445])
}
// Correctly-marked `[ ]` on an unsatisfied binding -> Clean.
fn witness_derivable_unmerged_box_todo_clean() -> Bool {
  let item = derivable(prs: [9999], title: "bound + honest todo")
  is_clean(v: status_drift(item: item, committed_box: false, merged: [5445]))
}
// Multi-PR binding, one ref still unmerged, box `[ ]` -> Clean (not all landed).
fn witness_derivable_partial_multi_todo_clean() -> Bool {
  let item = derivable(prs: [5445, 9999], title: "bound + multi partial")
  is_clean(v: status_drift(item: item, committed_box: false, merged: [5445]))
}

// The host/gate edge: bound to complete iff #5445 merges; the live PR set has #5445 merged; box
// `[ ]` -> drift.
fn item_against_prs_drifts() -> Bool {
  let item = derivable(prs: [5445], title: "live-edge stale")
  item_drifts_against_prs(item: item, committed_box: false, prs: [pr_5445, pr_open_9999])
}

test fn roadmap_status_witnesses() -> Bool {
  witness_merged_pr_is_merged()
    && witness_open_pr_not_merged()
    && witness_merged_numbers_projection()
    && witness_all_merged_derives_done()
    && witness_one_unmerged_derives_todo()
    && witness_empty_binding_derives_todo()
    && witness_derivable_done_from_merge()
    && witness_authored_done_is_authored()
    && witness_partial_evidence_merged_mention_stays_green()
    && witness_authored_done_underivable()
    && witness_derivable_merged_box_todo_drifts()
    && witness_derivable_unmerged_box_done_drifts()
    && witness_derivable_merged_box_done_clean()
    && witness_derivable_unmerged_box_todo_clean()
    && witness_derivable_partial_multi_todo_clean()
    && item_against_prs_drifts()
}
