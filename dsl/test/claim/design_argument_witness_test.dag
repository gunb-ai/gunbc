module test.claim.design_argument_witness

import gunbc.design_argument { design_section_1_argument, design_argument, design_axioms }
import std.syllogism {
  Axiom, NonLogicalAxiom, Proposition, Argument,
  argument_has_no_orphan, argument_is_acyclic,
  argument_axiom_set_is_closed, argument_form_is_valid, argument_is_non_vacuous
}

test fn design_s1_argument_form_is_valid() -> Bool {
  argument_form_is_valid(design_section_1_argument)
}

test fn design_s1_argument_is_non_vacuous() -> Bool {
  argument_is_non_vacuous(design_section_1_argument)
}

test fn design_full_argument_form_is_valid() -> Bool {
  argument_form_is_valid(design_argument)
}

test fn design_full_argument_has_no_orphan() -> Bool {
  argument_has_no_orphan(design_argument)
}

test fn design_full_argument_is_acyclic() -> Bool {
  argument_is_acyclic(design_argument)
}

test fn design_full_argument_axiom_set_is_closed() -> Bool {
  argument_axiom_set_is_closed(design_argument)
}

fn orphaned_variant() -> Argument {
  Argument {
    axioms: design_axioms,
    propositions: [
      Proposition { id: "s1.minimal-safe-efficient", statement: "mse", premises: ["s1.grounding-intersubjective"] },
      Proposition { id: "s1.grounding-intersubjective", statement: "gi", premises: ["s1.minimal-safe-efficient"] }
    ]
  }
}

test fn orphan_is_detected() -> Bool {
  argument_has_no_orphan(orphaned_variant()) == false
}

fn cyclic_variant() -> Argument {
  Argument {
    axioms: design_axioms,
    propositions: [
      Proposition { id: "p", statement: "x", premises: ["A1", "q"] },
      Proposition { id: "q", statement: "y", premises: ["p"] }
    ]
  }
}

test fn cycle_is_detected() -> Bool {
  argument_is_acyclic(cyclic_variant()) == false
}

fn smuggled_axiom_variant() -> Argument {
  Argument {
    axioms: design_axioms,
    propositions: [
      Proposition { id: "s1.minimal-safe-efficient", statement: "mse", premises: ["A1", "A2"] },
      Proposition { id: "A4", statement: "a smuggled fourth axiom", premises: [] }
    ]
  }
}

test fn smuggled_axiom_is_detected() -> Bool {
  argument_axiom_set_is_closed(smuggled_axiom_variant()) == false
}

fn empty_variant() -> Argument {
  Argument { axioms: [], propositions: [] }
}

test fn vacuous_argument_is_rejected() -> Bool {

  (argument_is_non_vacuous(empty_variant()) == false)
    && (argument_form_is_valid(empty_variant()) == false)
}
