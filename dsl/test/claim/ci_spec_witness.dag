// dsl/test/claim/ci_spec_witness.dag
//
// Prove CiSpec fields drive emitted scripts (not decorative literals).

module test.claim.ci_spec_witness

import gunbc.ci_spec {
  CiSpec, WitnessRoot, DiffPolicy, DiffMergeBase,
  gunbc_ci_spec, ci_release_features,
  claim_batch_script, gunbc_ci_run_script, git_fetch_script, ci_gates_invoke,
  ci_release_build_script, gunbc_ci_workflow_run
}

data spec_alternate_root: CiSpec = {
  witness_roots: [{ root: "Z9Z9Z9-witness-root", scan_subtrees: [] }],
  witness_entries: [],
  gates: [],
  diff_policy: {
    base: "upstream/dev",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "alt-notice"
}

data spec_with_scan_subtree: CiSpec = {
  witness_roots: [{ root: "src/v2", scan_subtrees: ["test"] }],
  witness_entries: [],
  gates: [],
  diff_policy: gunbc_ci_spec.diff_policy,
  notice_title: "scan-test"
}

fn witness_roots_fold_into_claim_batch() -> Bool {
  let script = claim_batch_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: " --source-root src/v2") &&
    string_contains(s: script, pattern: " --source-root dsl")
}

fn witness_edit_witness_root_changes_claim_batch() -> Bool {
  let base = claim_batch_script(spec: gunbc_ci_spec)
  let alt = claim_batch_script(spec: spec_alternate_root)
  (base != alt) &&
    string_contains(s: alt, pattern: "Z9Z9Z9-witness-root") &&
    !string_contains(s: alt, pattern: " --source-root src/v2")
}

fn witness_scan_subtree_emits_scan_dir() -> Bool {
  string_contains(
    s: claim_batch_script(spec: spec_with_scan_subtree),
    pattern: " --scan-dir src/v2/test"
  )
}

fn witness_diff_policy_drives_fetch() -> Bool {
  let fetch = git_fetch_script(policy: gunbc_ci_spec.diff_policy)
  string_contains(s: fetch, pattern: "git fetch --no-tags origin main") &&
    (git_fetch_script(policy: spec_alternate_root.diff_policy) != fetch) &&
    string_contains(
      s: git_fetch_script(policy: spec_alternate_root.diff_policy),
      pattern: "git fetch --no-tags upstream dev"
    )
}

fn witness_notice_title_from_spec() -> Bool {
  string_contains(
    s: claim_batch_script(spec: gunbc_ci_spec),
    pattern: concat(concat(" --notice-title \"", gunbc_ci_spec.notice_title), "\"")
  )
}

fn witness_run_script_composes_from_spec() -> Bool {
  let script = gunbc_ci_run_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: git_fetch_script(policy: gunbc_ci_spec.diff_policy)) &&
    string_contains(s: script, pattern: claim_batch_script(spec: gunbc_ci_spec)) &&
    string_contains(s: script, pattern: ci_gates_invoke(spec: gunbc_ci_spec))
}

fn witness_release_build_unifies_features() -> Bool {
  string_contains(
    s: ci_release_build_script(),
    pattern: concat("--features ", ci_release_features)
  )
}

fn witness_claim_batch_uses_release_binary() -> Bool {
  string_contains(
    s: claim_batch_script(spec: gunbc_ci_spec),
    pattern: "$ROOT/target/release/claim_batch"
  ) &&
    !string_contains(s: claim_batch_script(spec: gunbc_ci_spec), pattern: "cargo run")
}

fn witness_ci_gates_use_release_binary() -> Bool {
  string_contains(
    s: ci_gates_invoke(spec: gunbc_ci_spec),
    pattern: "$ROOT/target/release/gunbc"
  ) &&
    !string_contains(s: ci_gates_invoke(spec: gunbc_ci_spec), pattern: "cargo run")
}

fn witness_release_build_eagain_cold_retry() -> Bool {
  let script = ci_release_build_script()
  string_contains(s: script, pattern: "Resource temporarily unavailable|failed to spawn") &&
    string_contains(s: script, pattern: "unset RUSTC_WRAPPER") &&
    string_contains(s: script, pattern: "CARGO_BUILD_JOBS=1") &&
    string_contains(s: script, pattern: "sccache --show-stats")
}

fn witness_workflow_run_is_collapsed_script() -> Bool {
  gunbc_ci_workflow_run(spec: gunbc_ci_spec) == gunbc_ci_run_script(spec: gunbc_ci_spec)
}

fn ci_spec_witnesses() -> Bool {
  witness_roots_fold_into_claim_batch() &&
    witness_edit_witness_root_changes_claim_batch() &&
    witness_scan_subtree_emits_scan_dir() &&
    witness_diff_policy_drives_fetch() &&
    witness_notice_title_from_spec() &&
    witness_run_script_composes_from_spec() &&
    witness_release_build_unifies_features() &&
    witness_release_build_eagain_cold_retry() &&
    witness_claim_batch_uses_release_binary() &&
    witness_ci_gates_use_release_binary() &&
    witness_workflow_run_is_collapsed_script()
}
