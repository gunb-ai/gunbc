// dsl/test/claim/ci_spec_witness.dag
//
// Prove CiSpec fields drive the scheduler invocation `gunbc ci` runs (not
// decorative literals), and that the run script invokes the dependency-ordered
// scheduler — NOT a flat claim_batch + gates lane (DESIGN §3, the operator's
// "default runtime, not a parallel dogfood lane").

module test.claim.ci_spec_witness

import gunbc.ci_spec {
  CiSpec, WitnessRoot, DiffPolicy, DiffMergeBase,
  gunbc_ci_spec, ci_release_features,
  scheduler_invoke, gunbc_ci_run_script, gunbc_ci_workflow_run, git_fetch_script,
  ci_release_build_script
}

data spec_alternate_root: CiSpec = {
  witness_roots: [{ root: "Z9Z9Z9-witness-root", scan_subtrees: [] }],
  witness_entries: [],
  gates: [],
  diff_policy: {
    base: "upstream/dev",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "alt-notice"
}

data spec_with_scan_subtree: CiSpec = {
  witness_roots: [{ root: "src/v2", scan_subtrees: ["test"] }],
  witness_entries: [],
  gates: [],
  diff_policy: gunbc_ci_spec.diff_policy,
  notice_title: "scan-test"
}

fn witness_roots_fold_into_scheduler() -> Bool {
  let script = scheduler_invoke(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: " --source-root src/v2") &&
    string_contains(s: script, pattern: " --source-root dsl")
}

fn witness_edit_witness_root_changes_scheduler() -> Bool {
  let base = scheduler_invoke(spec: gunbc_ci_spec)
  let alt = scheduler_invoke(spec: spec_alternate_root)
  (base != alt) &&
    string_contains(s: alt, pattern: "Z9Z9Z9-witness-root") &&
    !string_contains(s: alt, pattern: " --source-root src/v2")
}

// `claim_executor` has no `--scan-dir` flag (it hard-errors on unknown args), so a
// spec with `scan_subtrees` must NOT leak `--scan-dir` onto the scheduler argv —
// the scan dir is carried by the plan (`corpus_scan_dirs`, proven in
// `ci_floor_plan_witness`). Discriminating: the source-root is still emitted; only
// the harmful scan-dir flag is gone.
fn witness_scan_subtree_not_in_scheduler_argv() -> Bool {
  let script = scheduler_invoke(spec: spec_with_scan_subtree)
  !string_contains(s: script, pattern: " --scan-dir") &&
    string_contains(s: script, pattern: " --source-root src/v2")
}

fn witness_diff_policy_drives_fetch() -> Bool {
  let fetch = git_fetch_script(policy: gunbc_ci_spec.diff_policy)
  string_contains(s: fetch, pattern: "git fetch --no-tags origin main") &&
    (git_fetch_script(policy: spec_alternate_root.diff_policy) != fetch) &&
    string_contains(
      s: git_fetch_script(policy: spec_alternate_root.diff_policy),
      pattern: "git fetch --no-tags upstream dev"
    )
}

fn witness_notice_title_from_spec() -> Bool {
  string_contains(
    s: scheduler_invoke(spec: gunbc_ci_spec),
    pattern: concat(concat(" --notice-title \"", gunbc_ci_spec.notice_title), "\"")
  )
}

// The run script invokes the scheduler over the floor plan — and does NOT
// flat-invoke claim_batch (the parallel lane is gone, not shadowed).
fn witness_run_script_invokes_scheduler() -> Bool {
  let script = gunbc_ci_run_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: git_fetch_script(policy: gunbc_ci_spec.diff_policy)) &&
    string_contains(s: script, pattern: scheduler_invoke(spec: gunbc_ci_spec)) &&
    string_contains(s: script, pattern: "--plan-function gunbc_ci_floor_batches") &&
    !string_contains(s: script, pattern: "--bin claim_batch") &&
    !string_contains(s: script, pattern: "cargo run -p v1-compiler --release --bin claim_executor")
}

fn witness_release_build_unifies_features() -> Bool {
  string_contains(
    s: ci_release_build_script(),
    pattern: concat("--features ", ci_release_features)
  )
}

fn witness_release_build_eagain_cold_retry() -> Bool {
  let script = ci_release_build_script()
  string_contains(s: script, pattern: "Resource temporarily unavailable|failed to spawn") &&
    string_contains(s: script, pattern: "CARGO_BUILD_JOBS=1") &&
    string_contains(s: script, pattern: "keep sccache") &&
    string_contains(s: script, pattern: "without RUSTC_WRAPPER") &&
    string_contains(s: script, pattern: "env -u RUSTC_WRAPPER") &&
    string_contains(s: script, pattern: "sccache --show-stats")
}

fn witness_scheduler_uses_release_binary() -> Bool {
  string_contains(
    s: scheduler_invoke(spec: gunbc_ci_spec),
    pattern: "$ROOT/target/release/claim_executor"
  ) &&
    !string_contains(s: scheduler_invoke(spec: gunbc_ci_spec), pattern: "cargo run")
}

fn witness_workflow_run_is_collapsed_script() -> Bool {
  gunbc_ci_workflow_run(spec: gunbc_ci_spec) == gunbc_ci_run_script(spec: gunbc_ci_spec)
}

fn ci_spec_witnesses() -> Bool {
  witness_roots_fold_into_scheduler() &&
    witness_edit_witness_root_changes_scheduler() &&
    witness_scan_subtree_not_in_scheduler_argv() &&
    witness_diff_policy_drives_fetch() &&
    witness_notice_title_from_spec() &&
    witness_run_script_invokes_scheduler() &&
    witness_release_build_unifies_features() &&
    witness_release_build_eagain_cold_retry() &&
    witness_scheduler_uses_release_binary() &&
    witness_workflow_run_is_collapsed_script()
}
