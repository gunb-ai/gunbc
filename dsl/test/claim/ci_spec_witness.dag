// dsl/test/claim/ci_spec_witness.dag
//
// Prove CiSpec fields drive emitted scripts (not decorative literals).

module test.claim.ci_spec_witness

import v2.std.algebra { length }
import v2.std.collection { List }
import v2.std.verification { BoolWitness, BoolWitnessClaim, UnifiedTestClaim }
import gunbc.ci_spec {
  CiSpec, DiffPolicy, DiffMergeBase,
  gunbc_ci_spec, witness_layer_roots, witness_discovery_scan_dirs,
  claim_batch_script, gunbc_ci_run_script, git_fetch_script, ci_gates_invoke,
  gate_roster_matches_coproduct_arms,
  witness_layer_source_flags, witness_layer_scan_flags
}

data spec_alternate_notice: CiSpec = {
  gates: [],
  diff_policy: {
    base: "upstream/dev",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "alt-notice"
}

data alternate_witness_layer_roots: List<String> = ["Z9Z9Z9-witness-root"]

fn witness_layers_fold_into_claim_batch() -> Bool {
  let script = claim_batch_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: " --source-root src/v2") &&
    string_contains(s: script, pattern: " --source-root dsl") &&
    string_contains(s: script, pattern: " --scan-dir dsl/test/claim") &&
    string_contains(s: script, pattern: " --scan-dir src/v2/test/claim/layering_imports")
}

fn witness_layer_authority_drives_source_flags() -> Bool {
  let flags = witness_layer_source_flags(roots: witness_layer_roots)
  (flags != witness_layer_source_flags(roots: alternate_witness_layer_roots)) &&
    string_contains(s: flags, pattern: " --source-root src/v2") &&
    !string_contains(s: flags, pattern: "Z9Z9Z9-witness-root")
}

fn witness_discovery_scan_dirs_emit_scan_flags() -> Bool {
  string_contains(
    s: witness_layer_scan_flags(),
    pattern: " --scan-dir dsl/test/claim"
  ) && string_contains(
    s: witness_layer_scan_flags(),
    pattern: " --scan-dir src/v2/test/claim/layering_imports"
  ) && (length(xs: witness_discovery_scan_dirs) == 2)
}

fn witness_diff_policy_drives_fetch() -> Bool {
  let fetch = git_fetch_script(policy: gunbc_ci_spec.diff_policy)
  string_contains(s: fetch, pattern: "git fetch --no-tags origin main") &&
    (git_fetch_script(policy: spec_alternate_notice.diff_policy) != fetch) &&
    string_contains(
      s: git_fetch_script(policy: spec_alternate_notice.diff_policy),
      pattern: "git fetch --no-tags upstream dev"
    )
}

fn witness_notice_title_from_spec() -> Bool {
  string_contains(
    s: claim_batch_script(spec: gunbc_ci_spec),
    pattern: concat(concat(" --notice-title \"", gunbc_ci_spec.notice_title), "\"")
  ) && string_contains(
    s: claim_batch_script(spec: spec_alternate_notice),
    pattern: concat(concat(" --notice-title \"", spec_alternate_notice.notice_title), "\"")
  )
}

fn witness_run_script_composes_from_spec() -> Bool {
  let script = gunbc_ci_run_script(spec: gunbc_ci_spec)
  string_contains(s: script, pattern: git_fetch_script(policy: gunbc_ci_spec.diff_policy)) &&
    string_contains(s: script, pattern: claim_batch_script(spec: gunbc_ci_spec)) &&
    string_contains(s: script, pattern: ci_gates_invoke(spec: gunbc_ci_spec))
}

fn witness_gate_roster_matches_coproduct() -> Bool {
  gate_roster_matches_coproduct_arms()
}

fn ci_spec_witnesses() -> Bool {
  witness_layers_fold_into_claim_batch() &&
    witness_layer_authority_drives_source_flags() &&
    witness_discovery_scan_dirs_emit_scan_flags() &&
    witness_diff_policy_drives_fetch() &&
    witness_notice_title_from_spec() &&
    witness_run_script_composes_from_spec() &&
    witness_gate_roster_matches_coproduct()
}

data unified_claim_ci_spec: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "dsl/test/claim/ci_spec_witness.dag",
    function: ci_spec_witnesses
  }
}
