module test.claim.ci_failure_class_witness

import std.process { ProcessExit, ExitSuccess, ExitFailure }
import gunbc.ci_failure_class {
  InfraSignature, RunnerLost,
  FloorFailureClass, Infra, Structural,
  FloorOutcome, NoFailure, FloorFailed,
  classify_failure_reason, classify_floor_exit,
  floor_failure_blocks_merge, floor_outcome_blocks_merge, floor_exit_blocks_merge,
  infra_retry_grep_alternation, build_retry_infra_signatures,
  verdict_infra_signatures, infra_signature_match_substring,
  infra_signature_origin,
  MergeGatingStatus, GatingEnforced,
  merge_freshness_gating_status, gating_is_enforced,
  merge_freshness_verdict_is_consumed_to_block
}

fn class_is_infra(c: FloorFailureClass) -> Bool {
  match c {
    Infra { signature: _ } => true
    Structural { reason: _ } => false
  }
}

fn class_is_structural(c: FloorFailureClass) -> Bool {
  match c {
    Infra { signature: _ } => false
    Structural { reason: _ } => true
  }
}

fn outcome_is_structural(o: FloorOutcome) -> Bool {
  match o {
    NoFailure => false
    FloorFailed { class: c } => class_is_structural(c: c)
  }
}

fn outcome_is_no_failure(o: FloorOutcome) -> Bool {
  match o {
    NoFailure => true
    FloorFailed { class: _ } => false
  }
}

fn reason_classifies_infra(reason: String) -> Bool {
  class_is_infra(c: classify_failure_reason(reason: reason))
}

fn reason_blocks_merge(reason: String) -> Bool {
  class_is_structural(c: classify_failure_reason(reason: reason))
    && floor_failure_blocks_merge(c: classify_failure_reason(reason: reason))
    && floor_exit_blocks_merge(e: ExitFailure { code: 1, reason: reason })
}

fn list_len(xs: List<InfraSignature>) -> Int {
  fold(xs, init: 0, f: fn(acc, _) { acc + 1 })
}

fn list_has_signature(xs: List<InfraSignature>, target: InfraSignature) -> Bool {
  fold(xs, init: false, f: fn(acc, sig) { acc || (sig == target) })
}

fn witness_real_infra_reasons_are_non_blocking() -> Bool {
  let eagain = "error: failed to run custom build command\nResource temporarily unavailable (os error 11)"
  let spawn = "error: could not compile; caused by: failed to spawn process"
  let sccache = "sccache: encountered fatal error\nsccache: error: Connection refused (os error 111)"
  let sccache254 = "process didn't exit successfully: `sccache /usr/bin/rustc ...` (exit status: 254)"
  let sccache_exec = "sccache: error: failed to execute compile\nerror: could not compile `v1-compiler` (bin \"gunbc\")"
  let runner = "The runner has received a shutdown signal. Stopping current job."
  reason_classifies_infra(reason: eagain)
    && reason_classifies_infra(reason: spawn)
    && reason_classifies_infra(reason: sccache)
    && reason_classifies_infra(reason: sccache254)
    && reason_classifies_infra(reason: sccache_exec)
    && reason_classifies_infra(reason: runner)
    && (floor_failure_blocks_merge(c: classify_failure_reason(reason: eagain)) == false)
    && (floor_failure_blocks_merge(c: classify_failure_reason(reason: sccache)) == false)
    && (floor_failure_blocks_merge(c: classify_failure_reason(reason: sccache254)) == false)
    && (floor_failure_blocks_merge(c: classify_failure_reason(reason: sccache_exec)) == false)
}

fn witness_structural_not_swallowed_as_infra() -> Bool {
  let compile_err = "error[E0599]: no method named `frobnicate` found for type `Node`"
  let inference = "type inference failed: cannot unify Int with String at dsl/gunbc/foo.dag:42"
  let assertion = "witness layering_imports_clean returned false (1 upward import)"
  let layering = "layering_imports gate: upward import std -> extdeps at dsl/std/credentials.dag:7"
  let drift = "generated_artifact_drift gate: .github/workflows/ci.yml differs from gunbc ci output"
  let oom_structural = "thread 'main' panicked: index out of bounds; aborting (exit code 137)"
  reason_blocks_merge(reason: compile_err)
    && reason_blocks_merge(reason: inference)
    && reason_blocks_merge(reason: assertion)
    && reason_blocks_merge(reason: layering)
    && reason_blocks_merge(reason: drift)
    && reason_blocks_merge(reason: oom_structural)
    && outcome_is_structural(o: classify_floor_exit(e: ExitFailure { code: 137, reason: oom_structural }))
    && floor_exit_blocks_merge(e: ExitFailure { code: 137, reason: oom_structural })
}

fn witness_bare_exit_137_fails_closed() -> Bool {
  let bare = ExitFailure { code: 137, reason: "Process completed with exit code 137." }
  outcome_is_structural(o: classify_floor_exit(e: bare))
    && floor_exit_blocks_merge(e: bare)
}

fn witness_unknown_reason_fails_closed() -> Bool {
  let unknown = "some entirely novel failure mode we have never grounded"
  class_is_structural(c: classify_failure_reason(reason: unknown))
    && floor_exit_blocks_merge(e: ExitFailure { code: 1, reason: unknown })
}

fn witness_floor_green_does_not_block() -> Bool {
  (floor_exit_blocks_merge(e: ExitSuccess) == false)
    && outcome_is_no_failure(o: classify_floor_exit(e: ExitSuccess))
}

fn witness_grep_alternation_is_single_authority() -> Bool {
  let expected = "Resource temporarily unavailable|failed to spawn|sccache: encountered fatal error|(exit status: 254)|sccache: error: failed to execute compile"
  (infra_retry_grep_alternation() == expected)
    && string_contains(s: infra_retry_grep_alternation(), pattern: "Resource temporarily unavailable|failed to spawn")
}

fn witness_build_retry_subset_excludes_job_signals() -> Bool {
  let build = build_retry_infra_signatures()
  (list_len(xs: build) == 5)
    && (list_len(xs: verdict_infra_signatures) == 6)
    && (list_has_signature(xs: build, target: RunnerLost) == false)
    && (string_contains(s: infra_retry_grep_alternation(), pattern: infra_signature_match_substring(sig: RunnerLost)) == false)
}

fn witness_every_signature_is_grounded() -> Bool {
  fold(verdict_infra_signatures, init: true, f: fn(acc, sig) {
    acc
      && (infra_signature_origin(sig: sig) != "")
      && (infra_signature_match_substring(sig: sig) != "")
  })
}

fn witness_gating_enforced_and_consumes_verdict() -> Bool {
  (merge_freshness_gating_status == GatingEnforced)
    && (gating_is_enforced(s: merge_freshness_gating_status) == true)
    && (merge_freshness_verdict_is_consumed_to_block() == true)
}

test fn ci_failure_class_witnesses() -> Bool {
  witness_every_signature_is_grounded()
    && witness_real_infra_reasons_are_non_blocking()
    && witness_structural_not_swallowed_as_infra()
    && witness_bare_exit_137_fails_closed()
    && witness_unknown_reason_fails_closed()
    && witness_floor_green_does_not_block()
    && witness_grep_alternation_is_single_authority()
    && witness_build_retry_subset_excludes_job_signals()
    && witness_gating_enforced_and_consumes_verdict()
}
