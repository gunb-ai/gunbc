module test.claim.js_site_emit

import examples.js_site {
  js_site_pages,
  js_site_page_count,
  Home,
  About,
  Browse,
}
import examples.js_site_emit {
  js_site_page_html,
  js_site_page_tsx,
  js_site_html_artifact_path,
  js_site_tsx_artifact_path,
  js_site_boundary_names_three_layers,
}
import std.markup_jsx_boundary {
  markup_jsx_vocabulary_boundary,
  markup_jsx_static_only_honesty,
  markup_jsx_interactivity_exhaustion,
}
import extdeps.filesystem.filesystem_io { Filesystem }

data expected_home_html: String = "<html><head><title>gunbc — Home</title></head><body><header><h1>gunbc</h1><nav><a href=\"/\">Home</a><a href=\"/about\">About</a><a href=\"/browse\">Browse</a></nav></header><main><p>DAG-modeled compiler. One MarkupNode source, two realizations.</p></main></body></html>"

data expected_browse_html: String = "<html><head><title>gunbc — Browse</title></head><body><header><h1>gunbc</h1><nav><a href=\"/\">Home</a><a href=\"/about\">About</a><a href=\"/browse\">Browse</a></nav></header><main><ul><li><a href=\"/dsl\">dsl</a></li><li><a href=\"/src\">src</a></li><li><a href=\"/DESIGN.md\">DESIGN.md</a></li><li><a href=\"/ROADMAP.md\">ROADMAP.md</a></li></ul></main></body></html>"

data expected_about_html: String = "<html><head><title>gunbc — About</title></head><body><header><h1>gunbc</h1><nav><a href=\"/\">Home</a><a href=\"/about\">About</a><a href=\"/browse\">Browse</a></nav></header><main><p>gunbc models programs as dependency graphs. Rust is bootstrap seed.</p></main></body></html>"

data expected_home_tsx: String = "export function JsSiteHomePage(): JSX.Element { return <html><head><title>gunbc — Home</title></head><body><header><h1>gunbc</h1><nav><a href=\"/\">Home</a><a href=\"/about\">About</a><a href=\"/browse\">Browse</a></nav></header><main><p>DAG-modeled compiler. One MarkupNode source, two realizations.</p></main></body></html>; }"

data expected_browse_tsx: String = "export function JsSiteBrowsePage(): JSX.Element { return <html><head><title>gunbc — Browse</title></head><body><header><h1>gunbc</h1><nav><a href=\"/\">Home</a><a href=\"/about\">About</a><a href=\"/browse\">Browse</a></nav></header><main><ul><li><a href=\"/dsl\">dsl</a></li><li><a href=\"/src\">src</a></li><li><a href=\"/DESIGN.md\">DESIGN.md</a></li><li><a href=\"/ROADMAP.md\">ROADMAP.md</a></li></ul></main></body></html>; }"

data expected_about_tsx: String = "export function JsSiteAboutPage(): JSX.Element { return <html><head><title>gunbc — About</title></head><body><header><h1>gunbc</h1><nav><a href=\"/\">Home</a><a href=\"/about\">About</a><a href=\"/browse\">Browse</a></nav></header><main><p>gunbc models programs as dependency graphs. Rust is bootstrap seed.</p></main></body></html>; }"

fn witness_three_page_source() -> Bool {
  js_site_page_count() == 3
}

fn witness_home_html_emit() -> Bool {
  js_site_page_html(page: js_site_pages().first()) == expected_home_html
}

fn witness_browse_html_emit() -> Bool {
  js_site_page_html(page: js_site_pages().skip(n: 1).first()) == expected_browse_html
}

fn witness_about_html_emit() -> Bool {
  js_site_page_html(page: js_site_pages().skip(n: 2).first()) == expected_about_html
}

fn witness_home_tsx_emit() -> Bool {
  js_site_page_tsx(page: js_site_pages().first()) == expected_home_tsx
}

fn witness_browse_tsx_emit() -> Bool {
  js_site_page_tsx(page: js_site_pages().skip(n: 1).first()) == expected_browse_tsx
}

fn witness_about_tsx_emit() -> Bool {
  js_site_page_tsx(page: js_site_pages().skip(n: 2).first()) == expected_about_tsx
}

fn artifact_matches_emit(path: String, expected: String) -> Bool {
  let r = Filesystem.Read(path: path)
  r.success && r.content == expected
}

fn witness_committed_home_html() -> Bool {
  artifact_matches_emit(path: js_site_html_artifact_path(id: Home), expected: expected_home_html)
}

fn witness_committed_browse_html() -> Bool {
  artifact_matches_emit(path: js_site_html_artifact_path(id: Browse), expected: expected_browse_html)
}

fn witness_committed_about_html() -> Bool {
  artifact_matches_emit(path: js_site_html_artifact_path(id: About), expected: expected_about_html)
}

fn witness_committed_home_tsx() -> Bool {
  artifact_matches_emit(path: js_site_tsx_artifact_path(id: Home), expected: expected_home_tsx)
}

fn witness_committed_browse_tsx() -> Bool {
  artifact_matches_emit(path: js_site_tsx_artifact_path(id: Browse), expected: expected_browse_tsx)
}

fn witness_committed_about_tsx() -> Bool {
  artifact_matches_emit(path: js_site_tsx_artifact_path(id: About), expected: expected_about_tsx)
}

fn witness_markup_jsx_boundary_named() -> Bool {
  js_site_boundary_names_three_layers()
    && markup_jsx_vocabulary_boundary ==
      "MarkupNode tree (std.markup) | html_markup_medium bracket+escape (extdeps.languages.html) | JSX.Component export envelope (extdeps.languages.react_jsx)"
}

fn witness_static_only_honesty_boundary() -> Bool {
  markup_jsx_static_only_honesty ==
    "static structure only: no props, no state, no hooks, no event handlers, no client logic, no bundler"
}

fn witness_interactivity_exhaustion_boundary() -> Bool {
  starts_with(
    s: markup_jsx_interactivity_exhaustion,
    prefix: "onClick or any JSX expression-valued prop:"
  )
}

test fn js_site_emit_keystone_holds() -> Bool {
  witness_three_page_source()
    && witness_home_html_emit()
    && witness_browse_html_emit()
    && witness_about_html_emit()
    && witness_home_tsx_emit()
    && witness_browse_tsx_emit()
    && witness_about_tsx_emit()
    && witness_committed_home_html()
    && witness_committed_browse_html()
    && witness_committed_about_html()
    && witness_committed_home_tsx()
    && witness_committed_browse_tsx()
    && witness_committed_about_tsx()
    && witness_markup_jsx_boundary_named()
    && witness_static_only_honesty_boundary()
    && witness_interactivity_exhaustion_boundary()
}
