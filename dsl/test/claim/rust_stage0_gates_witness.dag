// By-execution witnesses for the coarse Rust-monolith gate selector (tools.rust_stage0_gates).
// Run via: gunbc run --source-root dsl --entry <this> --function rust_stage0_gates_witnesses --claim-run
//
// Positive witnesses prove a Rust-touching path fires the gates; the *_no_* witnesses are RED
// contracts — they go red if the selector over-fires on a non-Rust path or degrades `ends_with`
// to a substring match. The fail-closed witness proves an undeterminable diff fires the gates.

module test.claim.rust_stage0_gates_witness

import v2.std.verification { BoolWitness, BoolWitnessClaim, UnifiedTestClaim }
import tools.rust_stage0_gates { path_is_rust_monolith, should_run_gates }

// POSITIVE — each Rust-marker tail selects (suffix match, including nested paths).
fn w_rs_selects() -> Bool { path_is_rust_monolith(path: "src/v1/stage0/src/lib.rs") }
fn w_cargo_toml_selects() -> Bool { path_is_rust_monolith(path: "src/v1/stage0/Cargo.toml") }
fn w_toolchain_selects() -> Bool { path_is_rust_monolith(path: "rust-toolchain.toml") }
fn w_clippy_toml_selects() -> Bool { path_is_rust_monolith(path: "clippy.toml") }
fn w_cargo_config_selects() -> Bool { path_is_rust_monolith(path: ".cargo/config.toml") }
fn w_cargo_lock_selects() -> Bool { path_is_rust_monolith(path: "Cargo.lock") }

// POSITIVE (the any-semantics) — one Rust path among non-Rust paths still fires.
fn w_mixed_fires() -> Bool {
  should_run_gates(paths: ["src/v2/std/text.dag", "src/v1/stage0/src/main.rs", "README.md"], git_success: true)
}

// RED CONTRACT — a `.dag`-only change does NOT fire.
fn w_dag_only_no_fire() -> Bool {
  should_run_gates(paths: ["src/v2/std/text.dag"], git_success: true) == false
}

// RED CONTRACT — `.rs` must be a true suffix, not a substring (`docs/notes.rs.md` → no).
fn w_rs_substring_no_select() -> Bool {
  path_is_rust_monolith(path: "docs/notes.rs.md") == false
}

// RED CONTRACT — a generic `config.toml` (not `.cargo/config.toml`) does NOT select.
fn w_generic_config_no_select() -> Bool {
  path_is_rust_monolith(path: "docs/config.toml") == false
}

// An empty change-set with a successful diff does NOT fire.
fn w_empty_no_fire() -> Bool {
  should_run_gates(paths: [], git_success: true) == false
}

// FAIL-CLOSED — an undeterminable diff (git_success == false) DOES fire, even with no paths.
fn w_git_fail_fires() -> Bool {
  should_run_gates(paths: [], git_success: false) == true
}

// Conjunction keystone — the single fn the CI corpus runs (--claim-run; false → exit 1).
fn rust_stage0_gates_witnesses() -> Bool {
  w_rs_selects() &&
  w_cargo_toml_selects() &&
  w_toolchain_selects() &&
  w_clippy_toml_selects() &&
  w_cargo_config_selects() &&
  w_cargo_lock_selects() &&
  w_mixed_fires() &&
  w_dag_only_no_fire() &&
  w_rs_substring_no_select() &&
  w_generic_config_no_select() &&
  w_empty_no_fire() &&
  w_git_fail_fires()
}

data unified_claim_rust_stage0_gates: UnifiedTestClaim = BoolWitnessClaim {
  witness: BoolWitness {
    entry: "dsl/test/claim/rust_stage0_gates_witness.dag",
    function: rust_stage0_gates_witnesses
  }
}
