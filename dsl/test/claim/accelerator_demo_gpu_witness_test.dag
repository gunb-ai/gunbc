module test.claim.accelerator_demo_gpu_witness

import gunbc.accelerator_demo_gpu {
  witness_oracle_integer_differential_would_red_on_wrong_golden,
  witness_gpu_float_device_precision_named,
  witness_gpu_float_fidelity_declaration_is_lossy_for_device_precision,
  witness_gpu_target_medium_is_wgsl_row,
  witness_gpu_device_rows_grounded,
  witness_gpu_epilogue_scaffold_documented,
  witness_operator_receipt_is_honestly_dormant,
}
import extdeps.languages.gpu.wgsl.kernel {
  witness_wgsl_kernel_surface_fused_op_count,
  witness_wgsl_op_codes_share_simd_authority,
  witness_wgsl_kernel_sources_scaffold_documented,
}
import extdeps.gpu.devices {
  witness_apple_m5_grounds_on_vendor,
  witness_apple_m5_has_metal_runtime,
  witness_apple_m5_dispatch_label_grounded,
  witness_rtx_5090_grounds_on_vendor,
  witness_rtx_5090_compute_capability_sm_10_0,
  witness_rtx_5090_has_cuda_runtime,
  witness_rtx_5090_dispatch_label_grounded,
}

test fn accelerator_demo_gpu_epilogue_witnesses() -> Bool {
  witness_wgsl_kernel_surface_fused_op_count()
    && witness_wgsl_op_codes_share_simd_authority()
    && witness_wgsl_kernel_sources_scaffold_documented()
    && witness_apple_m5_grounds_on_vendor()
    && witness_apple_m5_has_metal_runtime()
    && witness_apple_m5_dispatch_label_grounded()
    && witness_rtx_5090_grounds_on_vendor()
    && witness_rtx_5090_compute_capability_sm_10_0()
    && witness_rtx_5090_has_cuda_runtime()
    && witness_rtx_5090_dispatch_label_grounded()
    && witness_gpu_device_rows_grounded()
    && witness_gpu_target_medium_is_wgsl_row()
    && witness_gpu_float_device_precision_named()
    && witness_gpu_float_fidelity_declaration_is_lossy_for_device_precision()
    && witness_gpu_epilogue_scaffold_documented()
    && witness_oracle_integer_differential_would_red_on_wrong_golden()
    && witness_operator_receipt_is_honestly_dormant()
}
