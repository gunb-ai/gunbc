module test.claim.roadmap_authority

import extdeps.languages.markdown { serialize_markdown_source }
import gunbc.roadmap_document { project_roadmap_to_markdown }
import gunbc.roadmap_authority { roadmap_authority, authored_merged_prs }

fn merged() -> List<Int> { authored_merged_prs() }

fn emit_with(m: List<Int>) -> String {
  serialize_markdown_source(doc: project_roadmap_to_markdown(doc: roadmap_authority(), merged: m))
}
fn out() -> String { emit_with(m: merged()) }

fn witness_frame_all_sections() -> Bool {
  let o = out()
  string_contains(s: o, pattern: "# gunbc — Roadmap")
    && string_contains(s: o, pattern: "## 0. Fail-closed lock-down")
    && string_contains(s: o, pattern: "## 1. CI as the substrate integration dogfood")
    && string_contains(s: o, pattern: "## 2. Minimal work")
    && string_contains(s: o, pattern: "## 3. Complexity budget gate")
    && string_contains(s: o, pattern: "## 4. Testgen as the bug-class oracle")
    && string_contains(s: o, pattern: "## 5. Self-host v2")
    && string_contains(s: o, pattern: "## 6. idea → idea compiler")
    && string_contains(s: o, pattern: "## 7. HTML / React rendering")
    && string_contains(s: o, pattern: "## 8. Session dashboard on `.dag` (SHELVED)")
}

fn witness_subgroup_labels() -> Bool {
  let o = out()
  string_contains(s: o, pattern: "**Audits (done):**")
    && string_contains(s: o, pattern: "**In-scope this window:**")
    && string_contains(s: o, pattern: "**Fenced OUT (after stability):**")
    && string_contains(s: o, pattern: "**Meta — lock down the reasoning (§7 recursion):**")
}

fn witness_emit_refs_from_binding() -> Bool {
  let o = out()
  string_contains(s: o, pattern: "**numeric-tower grounding** (#5428)")
    && string_contains(s: o, pattern: "**realization-vocabulary containment guard** (#5445/#5453)")
}

fn witness_c1_measure_rows() -> Bool {
  string_contains(s: out(),
    pattern: "- [ ] **Section 1 spawn-width foundation — std.measure expressibility** (#5470/#5478)")
    && string_contains(s: out(), pattern: "⏳ awaiting sign-off")
}

fn witness_c2_roundtrip_law() -> Bool {
  let o = out()
  string_contains(s: o, pattern: "- [ ] **round-trip law (ingest∘emit = id, DecodeFidelity-bounded)** (#5525/#5527)")
    && string_contains(s: o, pattern: "- [ ] **medium axis** —")
    && string_contains(s: o, pattern: "per-medium round-trips are v1-seed interim")
    && string_contains(s: o, pattern: "⏳ awaiting sign-off")
}

fn witness_c3_inversion_subrows() -> Bool {
  string_contains(s: out(),
    pattern: "- [ ] **PR→checkbox status + section-emit + projection layer** (#5491/#5508/#5520)")
    && string_contains(s: out(), pattern: "⏳ awaiting sign-off")
}

fn witness_c4_selfhost_no_overclaim() -> Bool {
  let o = out()
  string_contains(s: o, pattern: "class-3 corpus-coherence + cargo-green seed ✓ (#5481)")
    && string_contains(s: o, pattern: "§7 regen-fixpoint deferred, #5514; src/v1 NOT yet deletable")
    && string_contains(s: o, pattern: "**TERMINAL: `src/v1` deleted**")
}

fn witness_c4_cargo_green_landed() -> Bool {
  string_contains(s: out(),
    pattern: "- [ ] **emitted crate `cargo build`s green (Route-A last mile) ✓ LANDED (#5777/#5873)**")
    && string_contains(s: out(), pattern: "⏳ awaiting sign-off")
}

fn witness_c5_rust_gate_not_greenlit() -> Bool {
  string_contains(s: out(), pattern: "- [ ] **rust-gate coverage** (shared §1)")
}

fn witness_a_prose_verbatim() -> Bool {
  string_contains(s: out(),
    pattern: "**◆ Milestones:** key-by-construction ✓ (#5425) → **▸ warm==cold purity proven (616/616, #5429)**")
}

fn witness_b_ordered_interleaving() -> Bool {
  let o = out()
  string_contains(s: o, pattern: "([DESIGN §5](DESIGN.md)).\n\n→ [audit + checklist](docs/plans/fail-closed-lockdown.md)")
    && string_contains(s: o, pattern: "[audit + checklist](docs/plans/fail-closed-lockdown.md)\n\nThis window = a few days of STABILITY")
    && string_contains(s: o, pattern: "[fork plan](docs/plans/model-realization-fork.md) §3).\n\n**◆ Milestones:** fail-open audited")
    && string_contains(s: o, pattern: "`Value::Null` split *(deep root)*\n\n**Audits (done):**")
}

fn witness_b_order_discriminator() -> Bool {
  !string_contains(s: out(), pattern: "**Audits (done):**\n\nThis window = a few days of STABILITY")
}

fn witness_merge_perturb_does_not_flip_boxes() -> Bool {
  let full = out()
  let dropped = emit_with(m: [5445, 5453, 5433, 5476, 5473, 5456, 5421, 5425])
  let pat = "- [ ] **numeric-tower grounding** (#5428)"
  string_contains(s: full, pattern: pat)
    && string_contains(s: dropped, pattern: pat)
    && !string_contains(s: full, pattern: "- [x] **numeric-tower grounding** (#5428)")
    && !string_contains(s: dropped, pattern: "- [x] **numeric-tower grounding** (#5428)")
}

test fn roadmap_authority_witnesses() -> Bool {
  witness_frame_all_sections()
    && witness_subgroup_labels()
    && witness_emit_refs_from_binding()
    && witness_c1_measure_rows()
    && witness_c2_roundtrip_law()
    && witness_c3_inversion_subrows()
    && witness_c4_selfhost_no_overclaim()
    && witness_c4_cargo_green_landed()
    && witness_c5_rust_gate_not_greenlit()
    && witness_a_prose_verbatim()
    && witness_b_ordered_interleaving()
    && witness_b_order_discriminator()
    && witness_merge_perturb_does_not_flip_boxes()
}
