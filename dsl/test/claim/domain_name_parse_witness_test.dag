module test.claim.domain_name_parse

import std.logic { Bool }
import std.error_primitives { Ok, Err }
import extdeps.dns.domain_name {
  parse_host_name,
  host_name_eq,
  host_name_label_count,
  FullyQualified,
  PartiallyQualified,
  EmptyName,
  LabelTooLong,
  NameTooLong,
  BadLabelChar,
  EdgeHyphen,
}
import std.render { repeat_string }

test fn domain_name_parse_fqdn_srv1_tailnet() -> Bool {
  match parse_host_name(raw: "srv1.tailecbe08.ts.net.") {
    Ok { value: host } =>
      host.qualification == FullyQualified
        && host_name_label_count(host: host) == 4
    Err { value: _ } => false
  }
}

test fn domain_name_parse_partial_single_label() -> Bool {
  match parse_host_name(raw: "altrad8ud-1l2t") {
    Ok { value: host } =>
      host.qualification == PartiallyQualified
        && host_name_label_count(host: host) == 1
    Err { value: _ } => false
  }
}

test fn domain_name_parse_rejects_empty() -> Bool {
  match parse_host_name(raw: "") {
    Err { value: EmptyName } => true
    Ok { value: _ } => false
  }
}

test fn domain_name_parse_rejects_edge_hyphen() -> Bool {
  match parse_host_name(raw: "-bad") {
    Err { value: BadLabelChar } => true
    Err { value: EdgeHyphen } => true
    Ok { value: _ } => false
  }
}

test fn domain_name_parse_rejects_label_too_long() -> Bool {
  let long_label = repeat_string(s: "a", n: 64)
  match parse_host_name(raw: long_label) {
    Err { value: LabelTooLong } => true
    Ok { value: _ } => false
  }
}

test fn domain_name_parse_case_fold_equality() -> Bool {
  match parse_host_name(raw: "SRV1") {
    Ok { value: upper } =>
      match parse_host_name(raw: "srv1") {
        Ok { value: lower } => host_name_eq(a: upper, b: lower)
        Err { value: _ } => false
      }
    Err { value: _ } => false
  }
}
