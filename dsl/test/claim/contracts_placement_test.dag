module test.claim.contracts_placement

import std.logic { Bool }
import extdeps.llm.llm_contracts { llm_snake_wire_contract }
import extdeps.llm.anthropic_contracts { anthropic_chat_message_wire_contract, wire_contract }
import extdeps.github.pulls_contracts { pull_request_state_wire_contract, review_state_wire_contract }

test fn anthropic_chat_message_contract_targets_correct_coproduct() -> Bool {
  anthropic_chat_message_wire_contract.coproduct.decl_name == "AnthropicChatMessage"
}

test fn pull_request_state_contract_targets_correct_coproduct() -> Bool {
  pull_request_state_wire_contract.coproduct.decl_name == "PullRequestState"
}

test fn review_state_contract_targets_correct_coproduct() -> Bool {
  review_state_wire_contract.coproduct.decl_name == "ReviewState"
}

test fn llm_snake_wire_contract_is_variant_encoding() -> Bool {
  llm_snake_wire_contract == wire_contract
}
