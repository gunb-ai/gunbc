module test.claim.docker_container_stats_witness

import extdeps.docker.container_stats { CpuStats, CpuUsage, MemoryStats, ContainerStats, PidStats, NetworkStats, NetworkInterface, Networks, container_stats_memory_usage, container_stats_cpu_usage_total, container_stats_online_cpus }
import extdeps.docker.container_inspect { ContainerState, ContainerStateDetail, HostConfig, ContainerConfig, ContainerInspect, NetworkSettings, container_inspect_memory_limit, container_inspect_cpu_quota, container_inspect_cpu_period, parse_container_state, container_state_wire_label, Running, Exited, Paused, Dead, Restarting }
import std.measure { byte_size, nanosecond, microsecond }

data sample_cpu_usage: CpuUsage = CpuUsage {
  total_usage: nanosecond(1234567890)
  percpu_usage: [nanosecond(1000000), nanosecond(234567890)]
  usage_in_kernelmode: nanosecond(100000000)
  usage_in_usermode: nanosecond(1134567890)
}

data sample_memory_stats: MemoryStats = MemoryStats {
  usage: byte_size(536870912)
  max_usage: byte_size(1073741824)
  limit: byte_size(2147483648)
  failcnt: none
}

data sample_cpu_stats: CpuStats = CpuStats {
  cpu_usage: sample_cpu_usage
  system_cpu_usage: nanosecond(9876543210)
  online_cpus: 4
  cpu_percent: none
}

data sample_pids_stats: PidStats = PidStats {
  current: 25
}

data sample_network_stats: NetworkStats = NetworkStats {
  rx_bytes: byte_size(1024000)
  rx_packets: 256
  rx_errors: 0
  rx_dropped: 0
  tx_bytes: byte_size(512000)
  tx_packets: 128
  tx_errors: 0
  tx_dropped: 0
}

data sample_networks: Networks = Networks {
  interfaces: [NetworkInterface { name: "eth0", stats: sample_network_stats }]
}

data sample_container_stats: ContainerStats = ContainerStats {
  read: "2026-06-23T15:30:00Z"
  pids_stats: Present { value: sample_pids_stats }
  blkio_stats: none
  cpu_stats: sample_cpu_stats
  memory_stats: sample_memory_stats
  networks: Present { value: sample_networks }
}

data sample_host_config: HostConfig = HostConfig {
  cpu_shares: none
  memory: Present { value: byte_size(2147483648) }
  memory_reservation: none
  memory_swap: none
  cpu_period: Present { value: microsecond(100000) }
  cpu_quota: Present { value: microsecond(400000) }
  cpuset_cpus: none
  cpuset_mems: none
  blkio_weight: none
  blkio_weight_device: none
  network_mode: "bridge"
  pid_mode: none
  ipc_mode: none
  uts_mode: none
  cap_add: none
  cap_drop: none
  exposed_ports: none
  port_bindings: none
  volumes: none
  volumes_from: none
  device_requests: none
}

data sample_container_config: ContainerConfig = ContainerConfig {
  hostname: "mycontainer"
  domainname: none
  user: "root"
  attach_stdin: false
  attach_stdout: true
  attach_stderr: true
  tty: false
  open_stdin: false
  stdin_once: false
  env: ["PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"]
  cmd: none
  image: "ubuntu:22.04"
  volumes: none
  working_dir: none
  entrypoint: none
  labels: none
  mac_address: none
  exposed_ports: none
  network_disabled: false
}

data sample_container_state: ContainerStateDetail = ContainerStateDetail {
  status: Running
  running: true
  paused: false
  restarting: false
  oom_killed: false
  dead: false
  pid: Present { value: 12345 }
  exit_code: none
  error: none
  started_at: Present { value: "2026-06-23T15:25:00Z" }
  finished_at: none
}

data sample_network_settings: NetworkSettings = NetworkSettings {
  bridge: "docker0"
  gateway: "172.17.0.1"
  ip_address: "172.17.0.2"
  ip_prefix_len: 16
  mac_address: "02:42:ac:11:00:02"
  networks: none
}

data sample_container_inspect: ContainerInspect = ContainerInspect {
  id: "abc123def456"
  created: "2026-06-23T15:25:00Z"
  path: none
  args: none
  state: sample_container_state
  image: "sha256:abc123..."
  resolv_conf_path: none
  hostname: "mycontainer"
  name: "/mycontainer"
  restart_count: 0
  driver: "overlay2"
  platform: "linux/amd64"
  config: Present { value: sample_container_config }
  network_settings: Present { value: sample_network_settings }
  host_config: Present { value: sample_host_config }
}

test fn container_stats_memory_usage_returns_correct_bytes() -> Bool {
  let usage = container_stats_memory_usage(sample_container_stats)
  usage == byte_size(536870912)
}

test fn container_stats_cpu_usage_total_returns_correct_nanoseconds() -> Bool {
  let total = container_stats_cpu_usage_total(sample_container_stats)
  total == nanosecond(1234567890)
}

test fn container_stats_online_cpus_returns_correct_count() -> Bool {
  let cpus = container_stats_online_cpus(sample_container_stats)
  cpus == 4
}

test fn container_inspect_memory_limit_extracts_from_host_config() -> Bool {
  match container_inspect_memory_limit(sample_container_inspect) {
    Present { value: limit } => limit == byte_size(2147483648)
    Absent => false
  }
}

test fn container_inspect_cpu_quota_extracts_from_host_config() -> Bool {
  match container_inspect_cpu_quota(sample_container_inspect) {
    Present { value: quota } => quota == microsecond(400000)
    Absent => false
  }
}

test fn container_inspect_cpu_period_extracts_from_host_config() -> Bool {
  match container_inspect_cpu_period(sample_container_inspect) {
    Present { value: period } => period == microsecond(100000)
    Absent => false
  }
}

test fn container_inspect_memory_limit_returns_absent_when_no_host_config() -> Bool {
  let inspect_no_hc = ContainerInspect {
    id: "test"
    created: "2026-06-23T00:00:00Z"
    path: none
    args: none
    state: sample_container_state
    image: "test:latest"
    resolv_conf_path: none
    hostname: "test"
    name: "/test"
    restart_count: 0
    driver: "overlay2"
    platform: "linux/amd64"
    config: none
    network_settings: none
    host_config: none
  }
  match container_inspect_memory_limit(inspect_no_hc) {
    Present { value: _ } => false
    Absent => true
  }
}

test fn sample_stats_has_realistic_timestamp() -> Bool {
  sample_container_stats.read == "2026-06-23T15:30:00Z"
}

test fn sample_inspect_has_running_state() -> Bool {
  sample_container_inspect.state.status == Running
}

test fn parse_container_state_running() -> Bool {
  match parse_container_state("running") {
    Present { value: Running } => true
    _ => false
  }
}

test fn parse_container_state_exited() -> Bool {
  match parse_container_state("exited") {
    Present { value: Exited } => true
    _ => false
  }
}

test fn parse_container_state_paused() -> Bool {
  match parse_container_state("paused") {
    Present { value: Paused } => true
    _ => false
  }
}

test fn parse_container_state_dead() -> Bool {
  match parse_container_state("dead") {
    Present { value: Dead } => true
    _ => false
  }
}

test fn parse_container_state_restarting() -> Bool {
  match parse_container_state("restarting") {
    Present { value: Restarting } => true
    _ => false
  }
}

test fn parse_container_state_invalid_returns_none() -> Bool {
  match parse_container_state("invalid") {
    Absent => true
    _ => false
  }
}

test fn parse_container_state_case_sensitive() -> Bool {
  match parse_container_state("RUNNING") {
    Absent => true
    _ => false
  }
}

test fn container_state_wire_label_running() -> Bool {
  container_state_wire_label(Running) == "running"
}

test fn container_state_wire_label_exited() -> Bool {
  container_state_wire_label(Exited) == "exited"
}

test fn container_state_roundtrip_preserves_value() -> Bool {
  let roundtrip_running = (parse_container_state(container_state_wire_label(Running))) == Present { value: Running }
  let roundtrip_paused = (parse_container_state(container_state_wire_label(Paused))) == Present { value: Paused }
  let roundtrip_exited = (parse_container_state(container_state_wire_label(Exited))) == Present { value: Exited }
  let roundtrip_dead = (parse_container_state(container_state_wire_label(Dead))) == Present { value: Dead }
  let roundtrip_restarting = (parse_container_state(container_state_wire_label(Restarting))) == Present { value: Restarting }
  roundtrip_running && roundtrip_paused && roundtrip_exited && roundtrip_dead && roundtrip_restarting
}
