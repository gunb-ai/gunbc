// dsl/test/claim/react_markup_witness.dag
//
// By-execution witnesses for the gunbhub R1 React/TSX consumer (std/react_markup.dag).
// Run via: gunbc run --source-root dsl --entry <this> --function <fn> --claim-run
//
// Evidence:
//   * MarkupNode reduces to std.markup.Fragment and serializes through the ONE
//     convergent serialize_fragment fold (CoC=1 with markup_serializer_witness);
//   * XSS reject-witness — javascript:/data: href values are rejected before emit,
//     and the rejection surfaces the offending URL;
//   * trusted relative URLs and REQ-A hostile href composition still emit correctly.
//
// The href/src scheme gate itself (validate_href's allowlist table) is now the
// single std.markup authority shared with html_markup; its scheme-by-scheme
// witnesses live in html_markup_xss_witness.dag — not re-minted here.

module test.claim.react_markup_witness

import std.markup {
  ElementNode,
  TextNode,
  MarkupAttr,
  MarkupNode,
  serialize_markup_node,
}
import std.react_markup {
  EmitOk,
  EmitRejected,
  UntrustedUrlScheme,
  serialize_react_markup,
}

fn sample_button() -> MarkupNode {
  ElementNode {
    tag: "button",
    attrs: [ MarkupAttr { name: "class", value: "primary" } ],
    children: [ TextNode { text: "Go" } ],
  }
}

fn witness_react_consumer_reduces_and_serializes() -> Bool {
  match serialize_react_markup(node: sample_button()) {
    EmitOk { html: h } => h == "<button class=\"primary\">Go</button>"
    EmitRejected { reason: _ } => false
  }
}

fn witness_react_fragment_matches_markup_fold() -> Bool {
  match serialize_react_markup(node: sample_button()) {
    EmitOk { html: h } => h == serialize_markup_node(node: sample_button())
    EmitRejected { reason: _ } => false
  }
}

// -- XSS reject-witness: the shared scheme gate before emit -------------------

fn hostile_javascript_href() -> MarkupNode {
  ElementNode {
    tag: "a",
    attrs: [ MarkupAttr { name: "href", value: "javascript:alert(1)" } ],
    children: [ TextNode { text: "click" } ],
  }
}

fn hostile_data_href() -> MarkupNode {
  ElementNode {
    tag: "a",
    attrs: [ MarkupAttr { name: "href", value: "data:text/html,<script>alert(1)</script>" } ],
    children: [],
  }
}

// Discriminating: reject is NOT char-escape-only — the unchecked fold passes the
// dangerous scheme through escape_url intact (std/markup.dag SECURITY SCOPE), so
// only the scheme gate blocks it.
fn witness_javascript_reject_discriminates_from_char_escape() -> Bool {
  match serialize_react_markup(node: hostile_javascript_href()) {
    EmitRejected { reason: _ } => {
      let unchecked = serialize_markup_node(node: hostile_javascript_href())
      unchecked == "<a href=\"javascript:alert(1)\">click</a>"
    }
    EmitOk { html: _ } => false
  }
}

fn witness_data_reject_discriminates_from_char_escape() -> Bool {
  match serialize_react_markup(node: hostile_data_href()) {
    EmitRejected { reason: _ } => {
      let unchecked = serialize_markup_node(node: hostile_data_href())
      starts_with(s: unchecked, prefix: "<a href=\"data:")
    }
    EmitOk { html: _ } => false
  }
}

// Rejection surfaces the offending URL (React result shape).
fn witness_serialize_rejects_javascript_href() -> Bool {
  match serialize_react_markup(node: hostile_javascript_href()) {
    EmitRejected { reason: UntrustedUrlScheme { url: u } } =>
      u == "javascript:alert(1)"
    EmitOk { html: _ } => false
  }
}

fn witness_serialize_rejects_data_href() -> Bool {
  match serialize_react_markup(node: hostile_data_href()) {
    EmitRejected { reason: UntrustedUrlScheme { url: u } } =>
      starts_with(s: u, prefix: "data:")
    EmitOk { html: _ } => false
  }
}

fn witness_http_href_serializes() -> Bool {
  match serialize_react_markup(
    node: ElementNode {
      tag: "a",
      attrs: [ MarkupAttr { name: "href", value: "https://gunbc.dev" } ],
      children: [ TextNode { text: "home" } ],
    }
  ) {
    EmitOk { html: h } => h == "<a href=\"https://gunbc.dev\">home</a>"
    EmitRejected { reason: _ } => false
  }
}

// -- trusted URLs still emit (escaping delegated to std.markup) ---------------

fn trusted_relative_link() -> MarkupNode {
  ElementNode {
    tag: "a",
    attrs: [ MarkupAttr { name: "href", value: "/tree/dsl" } ],
    children: [ TextNode { text: "dsl" } ],
  }
}

fn req_a_hostile_but_trusted_scheme() -> MarkupNode {
  ElementNode {
    tag: "a",
    attrs: [ MarkupAttr { name: "href", value: "x\"&<y onmouseover=z" } ],
    children: [],
  }
}

fn witness_trusted_href_serializes() -> Bool {
  match serialize_react_markup(node: trusted_relative_link()) {
    EmitOk { html: h } => h == "<a href=\"/tree/dsl\">dsl</a>"
    EmitRejected { reason: _ } => false
  }
}

fn witness_req_a_hostile_href_still_emits_with_escaping() -> Bool {
  match serialize_react_markup(node: req_a_hostile_but_trusted_scheme()) {
    EmitOk { html: h } =>
      h == "<a href=\"x%22&amp;%3Cy%20onmouseover=z\"></a>"
    EmitRejected { reason: _ } => false
  }
}

// -- keystone ----------------------------------------------------------------

fn react_markup_keystone_holds() -> Bool {
  witness_react_consumer_reduces_and_serializes()
    && witness_react_fragment_matches_markup_fold()
    && witness_javascript_reject_discriminates_from_char_escape()
    && witness_data_reject_discriminates_from_char_escape()
    && witness_serialize_rejects_javascript_href()
    && witness_serialize_rejects_data_href()
    && witness_http_href_serializes()
    && witness_trusted_href_serializes()
    && witness_req_a_hostile_href_still_emits_with_escaping()
}
