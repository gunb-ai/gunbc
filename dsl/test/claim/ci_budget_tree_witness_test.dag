module test.claim.ci_budget_tree_witness

import std.logic { Bool }
import std.measure { byte_size, byte_size_count, measure_fit_count_floor }
import product.budget_tree { node_conserves, budget_child_named, BudgetChildFound, BudgetChildMissing }
import gunbc.ci_budget_tree {
  srv1_budget_tree,
  srv1_host_ram,
  srv1_fixed_overhead_bytes,
  srv1_gha_runner_pool_budget,
  srv1_dashboard_session_pool_budget,
  srv1_ci_run_reservation,
  srv1_ci_run_container_hard_cap,
  srv1_ci_run_worst_observed,
  srv1_runs_fit_in_pool,
  srv1_runs_hard_guaranteed,
  srv1_floor_memory_budget,
  srv1_gha_runner_pool_node,
  srv1_dashboard_session_pool_node,
  srv1_ci_run_node,
}

fn witness_srv1_tree_conserves() -> Bool {
  node_conserves(node: srv1_budget_tree)
}

fn witness_floor_budget_is_run_reservation() -> Bool {
  byte_size_count(b: srv1_floor_memory_budget()) == byte_size_count(b: srv1_ci_run_reservation())
}

fn witness_divide_once_reduces_below_host() -> Bool {
  let reservation = byte_size_count(b: srv1_ci_run_reservation())
  reservation > 0
    && reservation < byte_size_count(b: srv1_gha_runner_pool_budget())
    && byte_size_count(b: srv1_gha_runner_pool_budget()) < byte_size_count(b: srv1_host_ram())
}

fn witness_two_pools_present() -> Bool {
  let gha_found = match srv1_gha_runner_pool_node() {
    BudgetChildFound { node: _ } => true
    BudgetChildMissing => false
  }
  let dash_found = match srv1_dashboard_session_pool_node() {
    BudgetChildFound { node: _ } => true
    BudgetChildMissing => false
  }
  return gha_found && dash_found
}

fn witness_dashboard_pool_reserved() -> Bool {
  let dash = byte_size_count(b: srv1_dashboard_session_pool_budget())
  dash > 0 && dash < byte_size_count(b: srv1_host_ram())
}

fn witness_gha_pool_capped_by_dashboard_reservation() -> Bool {
  let single_pool = byte_size_count(b: srv1_host_ram()) - byte_size_count(b: srv1_fixed_overhead_bytes())
  byte_size_count(b: srv1_gha_runner_pool_budget()) < single_pool
}

fn witness_three_way_conservation() -> Bool {
  let overhead = byte_size_count(b: srv1_fixed_overhead_bytes())
  let gha = byte_size_count(b: srv1_gha_runner_pool_budget())
  let dash = byte_size_count(b: srv1_dashboard_session_pool_budget())
  overhead + gha + dash <= byte_size_count(b: srv1_host_ram())
}

fn witness_reservation_below_hard_cap() -> Bool {
  byte_size_count(b: srv1_ci_run_reservation()) < byte_size_count(b: srv1_ci_run_container_hard_cap())
}

fn witness_worst_observed_fits_under_hard_cap() -> Bool {
  let worst = byte_size_count(b: srv1_ci_run_worst_observed())
  let cap = byte_size_count(b: srv1_ci_run_container_hard_cap())
  let reservation = byte_size_count(b: srv1_ci_run_reservation())
  reservation < worst && worst <= cap
}

fn witness_runs_fit_and_conserve_pool() -> Bool {
  let r = srv1_runs_fit_in_pool()
  let committed = r * byte_size_count(b: srv1_ci_run_reservation())
  r > 0 && committed <= byte_size_count(b: srv1_gha_runner_pool_budget())
}

fn witness_hard_guarantee_is_floor_of_reservation_fit() -> Bool {
  let guaranteed = srv1_runs_hard_guaranteed()
  let fit = srv1_runs_fit_in_pool()
  let guaranteed_committed = guaranteed * byte_size_count(b: srv1_ci_run_container_hard_cap())
  guaranteed >= 1
    && guaranteed <= fit
    && guaranteed_committed <= byte_size_count(b: srv1_gha_runner_pool_budget())
}

fn witness_l2_node_present() -> Bool {
  match srv1_ci_run_node() {
    BudgetChildFound { node: _ } => true
    BudgetChildMissing => false
  }
}

fn witness_unknown_child_is_absent() -> Bool {
  match budget_child_named(node: srv1_budget_tree, name: "__no_such_child__") {
    BudgetChildFound { node: _ } => false
    BudgetChildMissing => true
  }
}

fn witness_fit_count_fails_closed() -> Bool {
  let degenerate = measure_fit_count_floor(capacity: byte_size(1000), each: byte_size(0))
  let normal = measure_fit_count_floor(capacity: byte_size(1000), each: byte_size(100))
  return degenerate == 0 && normal == 10
}

test fn ci_budget_tree_holds() -> Bool {
  witness_srv1_tree_conserves()
    && witness_floor_budget_is_run_reservation()
    && witness_divide_once_reduces_below_host()
    && witness_two_pools_present()
    && witness_dashboard_pool_reserved()
    && witness_gha_pool_capped_by_dashboard_reservation()
    && witness_three_way_conservation()
    && witness_reservation_below_hard_cap()
    && witness_worst_observed_fits_under_hard_cap()
    && witness_runs_fit_and_conserve_pool()
    && witness_hard_guarantee_is_floor_of_reservation_fit()
    && witness_l2_node_present()
    && witness_unknown_child_is_absent()
    && witness_fit_count_fails_closed()
}
