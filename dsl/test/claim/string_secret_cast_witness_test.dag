// dsl/test/claim/string_secret_cast_witness_test.dag — by-execution witness (DESIGN §5)
// for String→Secret nominal_opaque identity cast in v1 interpreter eval_cast.
//
// Secret is nominal_opaque = String (std/types.dag). Infer admits String as Secret;
// interpreter must mirror emit's identity alias cast. Without the eval_cast arm this
// witness aborts: type error: cannot cast String to Secret (spec-without-execution).
//
// Existing consumer: std.credentials.env_credential (result.value as Secret).
//
// Run: gunbc run --source-root dsl --entry test/claim/string_secret_cast_witness_test.dag --function string_secret_cast_holds --claim-run

module test.claim.string_secret_cast

import std.logic { Bool }

fn string_to_secret(s: String) -> Secret {
  s as Secret
}

// RED without fix: interpreter TypeError aborts before returning Bool.
// GREEN with fix: cast is identity; value round-trips.
test fn string_secret_cast_holds() -> Bool {
  string_to_secret("hello") == "hello"
}
