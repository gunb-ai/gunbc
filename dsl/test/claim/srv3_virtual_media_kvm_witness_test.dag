module test.claim.srv3_virtual_media_kvm

import std.logic { Bool }
import extdeps.bmc.webui_kvm {
  NbdWebsocketLocalFile,
  RedfishConfiguredRemoteUri,
  webui_kvm_media_transport_wire,
  transport_requires_local_file,
  transport_session_must_persist_during_mount,
  openbmc_webui_local_file_virtual_media,
}

test fn srv3_webui_kvm_transport_is_local_file_nbd() -> Bool {
  match openbmc_webui_local_file_virtual_media.transport {
    NbdWebsocketLocalFile => true
    RedfishConfiguredRemoteUri => false
  }
    && webui_kvm_media_transport_wire(t: openbmc_webui_local_file_virtual_media.transport) == "nbd-websocket-local-file"
}

test fn srv3_webui_kvm_surface_is_grounded() -> Bool {
  openbmc_webui_local_file_virtual_media.spa_route == "/#/operations/virtual-media"
    && openbmc_webui_local_file_virtual_media.nbd_websocket_path == "/vm/0/0"
    && transport_requires_local_file(t: openbmc_webui_local_file_virtual_media.transport)
    && transport_session_must_persist_during_mount(t: openbmc_webui_local_file_virtual_media.transport)
}

test fn srv3_webui_kvm_dom_is_grounded() -> Bool {
  openbmc_webui_local_file_virtual_media.dom.login_username_input_id == "username"
    && openbmc_webui_local_file_virtual_media.dom.login_password_input_id == "password"
    && openbmc_webui_local_file_virtual_media.dom.attach_file_input_id == "virtual_media_device"
    && openbmc_webui_local_file_virtual_media.dom.attach_start_button_label == "Start"
    && openbmc_webui_local_file_virtual_media.dom.attach_section_heading == "Load image from web browser"
}
