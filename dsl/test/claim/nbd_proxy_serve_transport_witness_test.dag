module test.claim.nbd_proxy_serve_transport

import std.logic { Bool }
import extdeps.bmc.webui.nbd_proxy {
  VmSlotIndexEndpoint,
  bmcweb_nbd_proxy_ws_path,
}
import extdeps.bmc.webui.nbd_proxy_serve {
  nbd_proxy_serve_transport_intent,
  nbd_proxy_serve_program_foreground_command_is_websocat,
  nbd_proxy_serve_program_statement_count,
  nbd_proxy_serve_bash_emit_dissolution_trigger,
  nbd_proxy_serve_cited_tool_row_count,
  nbd_proxy_serve_cited_tool_names,
  bmcweb_session_login_program,
  bmcweb_session_token_env_ref,
  srv3_nbd_proxy_local_port,
  nbd_proxy_serve_requires_host_as_nbd_server,
}
import extdeps.boards.asrock_rack { asrock_srv3_live_bmc_host }
import extdeps.tools.curl { curl_cli_tool }
import extdeps.tools.websocat { websocat_cli_tool }
import extdeps.tools.nbdkit { nbdkit_cli_tool }
import extdeps.tools.socat { socat_cli_tool }

test fn nbd_proxy_ws_path_for_vm_slot_index() -> Bool {
  bmcweb_nbd_proxy_ws_path(variant: VmSlotIndexEndpoint, slot: 0, index: 0) == "/vm/0/0"
}

test fn nbd_proxy_serve_program_is_structured_not_concat_blob() -> Bool {
  let intent = nbd_proxy_serve_transport_intent(
    bmc_host: asrock_srv3_live_bmc_host,
    session_token: bmcweb_session_token_env_ref,
    ws_path: bmcweb_nbd_proxy_ws_path(variant: VmSlotIndexEndpoint, slot: 0, index: 0),
    iso_path: "/var/lib/gunbc/artifacts/ubuntu-24.04.3-live-server-arm64.iso",
    local_nbd_port: srv3_nbd_proxy_local_port,
  )
  nbd_proxy_serve_program_statement_count(intent: intent) == 5
    && nbd_proxy_serve_program_foreground_command_is_websocat(intent: intent)
    && nbd_proxy_serve_cited_tool_row_count() == 3
    && nbd_proxy_serve_cited_tool_names_includes_nbdkit()
    && nbd_proxy_serve_cited_tool_names_includes_websocat()
    && nbd_proxy_serve_cited_tool_names_includes_socat()
}

fn nbd_proxy_serve_cited_tool_names_includes_nbdkit() -> Bool {
  fold(
    nbd_proxy_serve_cited_tool_names,
    init: false,
    f: (acc, name) => acc || name == nbdkit_cli_tool.name
  )
}

fn nbd_proxy_serve_cited_tool_names_includes_websocat() -> Bool {
  fold(
    nbd_proxy_serve_cited_tool_names,
    init: false,
    f: (acc, name) => acc || name == websocat_cli_tool.name
  )
}

fn nbd_proxy_serve_cited_tool_names_includes_socat() -> Bool {
  fold(
    nbd_proxy_serve_cited_tool_names,
    init: false,
    f: (acc, name) => acc || name == socat_cli_tool.name
  )
}

test fn nbd_proxy_serve_carrier_names_bash_emit_dissolution_trigger() -> Bool {
  string_contains(s: nbd_proxy_serve_bash_emit_dissolution_trigger, pattern: "dissolve-on:")
    && string_contains(s: nbd_proxy_serve_bash_emit_dissolution_trigger, pattern: "medium_structure_exception_roster")
    && string_contains(s: nbd_proxy_serve_bash_emit_dissolution_trigger, pattern: "ShellProgram")
}

test fn bmcweb_session_login_program_uses_curl_authority_not_inline_secret() -> Bool {
  bmcweb_session_login_program(
    bmc_host: asrock_srv3_live_bmc_host,
    request_body_file: "/tmp/bmcweb-login.json",
  ).statements.length() == 1
    && curl_cli_tool.name == "curl"
}

test fn nbd_proxy_serve_host_role_is_nbd_server() -> Bool {
  nbd_proxy_serve_requires_host_as_nbd_server()
}
