module test.claim.ci_runner_seam_witness

import gunbc.runner_spec_from_offer { gunbc_ci_runner_spec, gunbc_ci_ubicloud_runner_label }
import gunbc.ci_workflow { ci_workflow }
import gunbc.ci_yaml_emit { expected_ci_yml }
import extdeps.github.actions { RunsOnExpression }

fn witness_ci_runner_spec_is_ubicloud_hosted() -> Bool {
  match gunbc_ci_runner_spec() {
    RunsOnExpression { expression: e } => e == gunbc_ci_ubicloud_runner_label
    _ => false
  }
}

fn witness_ci_workflow_runner_matches_spec() -> Bool {
  ci_workflow.jobs.first().runner == gunbc_ci_runner_spec()
}

fn witness_ci_yaml_runs_on_projects_ubicloud_label() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "    runs-on: ubicloud-standard-16-arm")
}

test fn ci_runner_seam_holds() -> Bool {
  witness_ci_runner_spec_is_ubicloud_hosted()
    && witness_ci_workflow_runner_matches_spec()
    && witness_ci_yaml_runs_on_projects_ubicloud_label()
}
