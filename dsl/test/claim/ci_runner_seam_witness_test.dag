// dsl/test/claim/ci_runner_seam_witness_test.dag
//
// Phase 3a seam: ci.yml runs-on derives from compute_fabric ComputeOffer → RunnerSpec.

module test.claim.ci_runner_seam_witness

import gunbc.ci_fleet { gunbc_ci_fleet_offer, gunbc_ci_runner_spec }
import gunbc.runner_spec_from_offer { runner_spec_from_offer }
import gunbc.ci_workflow { ci_workflow, ci_workflow_primary_job_runner, ci_workflow_primary_job_steps, ci_workflow_primary_step }
import gunbc.ci_yaml_emit { expected_ci_yml }
import extdeps.github.actions { SelfHosted }
import std.algebra { HeadAbsent, HeadFound, length, list_head, list_head_value, skip }

fn witness_ci_runner_spec_derives_from_fleet_offer() -> Bool {
  gunbc_ci_runner_spec() == runner_spec_from_offer(offer: gunbc_ci_fleet_offer)
}

fn witness_ci_workflow_runner_matches_fleet_offer() -> Bool {
  ci_workflow_primary_job_runner() == gunbc_ci_runner_spec()
}

fn witness_ci_yaml_runs_on_projects_fleet_labels() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "    runs-on: [self-hosted, linux, arm64]")
}

fn witness_ci_runner_spec_is_self_hosted_arm64_linux() -> Bool {
  match gunbc_ci_runner_spec() {
    SelfHosted { labels: ls } =>
      length(xs: ls) == 3
        && list_head_value(xs: ls) == "self-hosted"
        && list_head_value(xs: skip(xs: ls, n: 1)) == "linux"
        && list_head_value(xs: skip(xs: ls, n: 2)) == "arm64"
    _ => false
  }
}

test fn ci_runner_seam_holds() -> Bool {
  witness_ci_runner_spec_derives_from_fleet_offer()
    && witness_ci_workflow_runner_matches_fleet_offer()
    && witness_ci_yaml_runs_on_projects_fleet_labels()
    && witness_ci_runner_spec_is_self_hosted_arm64_linux()
}
