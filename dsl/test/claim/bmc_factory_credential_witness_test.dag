// test/claim/bmc_factory_credential_witness_test.dag — by-execution witness (DESIGN §5)
// for the board-dependent BMC login chain.
//
// The claim under test: a server's BMC default login is board-dependent, and that
// dependence is modeled as a derivation — a cited baseboard catalog row names its BMC
// firmware family, and the firmware family is the SINGLE authority for the published
// factory credential (DESIGN §3). This witness RUNS that derivation end to end:
//
//   ServerBaseboard → catalog.bmc_firmware (OpenBmc) → factory credential (root / 0penBmc)
//
// It goes RED if the board points at the wrong firmware, the credential projection is
// mis-wired, or OpenBMC's modeled protocol set drifts. The secret is opaque by type
// (Secret = nominal_opaque) and is therefore NOT compared — only the username, which is
// the discriminating non-secret fact.

module test.claim.bmc_factory_credential

import std.logic { Bool }
import std.types { Int, List }
import std.bmc { BmcProtocol, BmcEndpoint, Redfish, OpenBmc }
import std.baseboard { ServerBaseboard }
import std.credentials { AccountLogin }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog }
import extdeps.bmc.openbmc { bmc_firmware_factory_credential, bmc_firmware_supported_protocols }

// A deployed instance of the operator's new server: the cited ASRock board, reached
// out-of-band over Redfish on its dedicated management NIC. Generic example address.
data new_server_baseboard: ServerBaseboard = ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: BmcEndpoint { host: "10.0.0.10", protocol: Redfish },
}

// Derive the factory login from the board's firmware family — the credential is NOT
// stored on the board, it is resolved through the single authority (extdeps/bmc/openbmc).
data new_server_factory_login: AccountLogin = bmc_firmware_factory_credential(family: new_server_baseboard.catalog.bmc_firmware)

// Count a protocol list by consuming fold (no list-length builtin; fold is the kernel).
fn protocol_count(ps: List<BmcProtocol>) -> Int {
  fold(ps, init: 0, f: (acc, p) => acc + 1)
}

test fn bmc_factory_credential_holds() -> Bool {
  // The ASRock board ships OpenBMC, whose stock login is root / 0penBmc (manual p.47).
  // Assert the username through the full board → firmware → credential derivation.
  new_server_factory_login.username == "root"
    // OpenBMC exposes BOTH Redfish and IPMI — two distinct cited interfaces, not aliases.
    && protocol_count(ps: bmc_firmware_supported_protocols(family: OpenBmc)) == 2
}
