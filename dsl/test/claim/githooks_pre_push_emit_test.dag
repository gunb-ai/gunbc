module test.claim.githooks_pre_push_emit

import gunbc.githooks_pre_push_emit { expected_githooks_pre_push_sh }
import gunbc.local_tidy_spec {
  doc_reachability_trigger_globs, generated_artifact_trigger_globs, cargo_fmt_trigger_globs
}
import extdeps.git.hooks { pre_push_zero_sha, pre_push_stdin_read_vars }

fn has(s: String, p: String) -> Bool {
  string_contains(s: s, pattern: p)
}

fn witness_generated_header() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: "GENERATED by dsl/gunbc/githooks_pre_push_emit.dag")
    && has(s: sh, p: "set -euo pipefail")
}

fn witness_zero_sha_from_authority() -> Bool {
  has(s: expected_githooks_pre_push_sh(), p: pre_push_zero_sha)
}

fn witness_pre_push_stdin_row_fold() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: concat("while IFS=' ' read -r ", pre_push_stdin_read_vars()))
}

fn witness_claim_batch_wired() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: "claim_batch")
    && has(s: sh, p: "run_generated_artifact_drift_gate_body")
    && has(s: sh, p: "main_wet")
}

fn witness_fmt_subsumed() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: "cargo fmt --all --check")
    && has(s: sh, p: "chore: apply cargo fmt")
}

fn witness_doc_witness_wired() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  has(s: sh, p: "doc_graph_has_no_orphan_docs")
    && has(s: sh, p: "doc_graph_has_no_dangling_links")
}

fn witness_trigger_globs_derived() -> Bool {
  let sh = expected_githooks_pre_push_sh()
  all(doc_reachability_trigger_globs(), g => has(s: sh, p: concat(g, "*")))
    && all(generated_artifact_trigger_globs(), g => has(s: sh, p: concat(g, "*")))
    && all(cargo_fmt_trigger_globs(), g => has(s: sh, p: concat(g, "*")))
}

test fn githooks_pre_push_emit_witnesses() -> Bool {
  witness_generated_header()
    && witness_zero_sha_from_authority()
    && witness_pre_push_stdin_row_fold()
    && witness_claim_batch_wired()
    && witness_fmt_subsumed()
    && witness_doc_witness_wired()
    && witness_trigger_globs_derived()
}
