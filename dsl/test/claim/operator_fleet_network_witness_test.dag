module test.claim.operator_fleet_network

import std.logic { Bool }
import std.types { list_length }
import product.network_topology {
  ContainerRunner,
  HostLan,
  BmcManagement,
  network_reachability,
}
import gunbc.operator_fleet_network {
  operator_fleet_network,
  srv1_bmc_endpoint,
  srv1_host_lan_endpoint,
}

test fn operator_fleet_network_container_to_bmc_allowed() -> Bool {
  network_reachability(from: ContainerRunner, to: BmcManagement)
}

test fn operator_fleet_network_container_to_host_lan_denied() -> Bool {
  network_reachability(from: ContainerRunner, to: HostLan) == false
}

test fn operator_fleet_network_topology_endpoint_count_holds() -> Bool {
  list_length(items: operator_fleet_network.endpoints) == 8
}

test fn operator_fleet_network_srv1_addresses_holds() -> Bool {
  srv1_host_lan_endpoint.address == "192.168.1.185"
    && srv1_bmc_endpoint.address == "192.168.1.183"
}
