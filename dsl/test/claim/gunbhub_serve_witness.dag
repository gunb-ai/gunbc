// dsl/test/claim/gunbhub_serve_witness.dag
//
// gunbhub M2 served render surface keystone: static route→body table +
// dispatch witness (request → 200+body / 404). Bodies are compose-time
// serialize_fragment output; XSS reject-witness runs at compose, not
// per-request. README row is M1 placeholder (react-composed until
// std.markdown merges).
//
// Run via: gunbc run --source-root dsl --entry <this> --function <fn> --claim-run

module test.claim.gunbhub_serve_witness

import gunbc.gunbhub_serve {
  GunbhubServeRequest,
  GunbhubPageSource,
  ReactPage,
  ComposedOk,
  ComposeRejected,
  Served,
  RenderRejectedBeforeServe,
  RouteNotFound,
  MethodNotAllowed,
  gunbhub_browse_page,
  gunbhub_readme_page,
  gunbhub_hostile_page,
  gunbhub_browse_route,
  gunbhub_readme_route,
  gunbhub_node_route_bindings,
  gunbhub_static_serve_table,
  gunbhub_compose_body,
  gunbhub_compose_serialized_body,
  serve_gunbhub_request,
  serve_gunbhub_page_source,
}
import gunbc.gunbhub_serve_html { gunbhub_html_render_keystone_holds }
import std.react_markup {
  EmitOk,
  EmitRejected,
  serialize_react_markup,
}
import std.types { GET, POST }

fn expected_browse_html() -> String {
  gunbhub_compose_serialized_body(node: gunbhub_browse_page())
}

fn expected_readme_html() -> String {
  gunbhub_compose_serialized_body(node: gunbhub_readme_page())
}

// Static host table: GET / and GET /README.md with compose-time bodies.
fn witness_static_table_has_two_get_routes() -> Bool {
  let table = gunbhub_static_serve_table()
  count(xs: table.routes) == 2
}

fn witness_static_table_browse_body_matches_compose() -> Bool {
  let table = gunbhub_static_serve_table()
  fold(
    xs: table.routes,
    init: false,
    f: (acc, row) =>
      if acc {
        acc
      } else {
        row.path == "/" && row.body == expected_browse_html()
      }
  )
}

// M1 placeholder: README body is react-composed today; swap when std.markdown lands.
fn witness_static_table_readme_body_is_m1_placeholder() -> Bool {
  let table = gunbhub_static_serve_table()
  fold(
    xs: table.routes,
    init: false,
    f: (acc, row) =>
      if acc {
        acc
      } else {
        row.path == "/README.md" && row.body == expected_readme_html()
      }
  )
}

// End-to-end dispatch: served response body == static table entry.
fn witness_browse_served_body_matches_consumer() -> Bool {
  let expected = expected_browse_html()
  match serve_gunbhub_request(
    req: GunbhubServeRequest { method: GET, path: "/" }
  ) {
    Served { response: r } => r.body == expected
    _ => false
  }
}

fn witness_readme_served_body_matches_static_table() -> Bool {
  match serve_gunbhub_request(
    req: GunbhubServeRequest { method: GET, path: "/README.md" }
  ) {
    Served { response: r } => r.body == expected_readme_html()
    _ => false
  }
}

fn witness_browse_empty_path_also_matches() -> Bool {
  match serve_gunbhub_request(
    req: GunbhubServeRequest { method: GET, path: "" }
  ) {
    Served { response: r } => r.body == expected_browse_html()
    _ => false
  }
}

fn witness_unknown_path_not_found() -> Bool {
  match serve_gunbhub_request(
    req: GunbhubServeRequest { method: GET, path: "/missing" }
  ) {
    RouteNotFound => true
    _ => false
  }
}

fn witness_wrong_method_not_allowed() -> Bool {
  match serve_gunbhub_request(
    req: GunbhubServeRequest { method: POST, path: "/" }
  ) {
    MethodNotAllowed => true
    _ => false
  }
}

fn witness_readme_wrong_method_not_allowed() -> Bool {
  match serve_gunbhub_request(
    req: GunbhubServeRequest { method: POST, path: "/README.md" }
  ) {
    MethodNotAllowed => true
    _ => false
  }
}

// Hostile javascript: href rejected before response — never reaches body.
fn witness_hostile_compose_rejects_fail_closed() -> Bool {
  match gunbhub_compose_body(node: gunbhub_hostile_page()) {
    ComposeRejected { reason: _ } => true
    ComposedOk { html: _ } => false
  }
}

fn witness_hostile_page_not_in_static_table() -> Bool {
  match gunbhub_compose_body(node: gunbhub_hostile_page()) {
    ComposeRejected { reason: _ } =>
      count(xs: gunbhub_static_serve_table().routes) == 2
    ComposedOk { html: _ } => false
  }
}

fn witness_hostile_page_rejected_before_response() -> Bool {
  match serve_gunbhub_page_source(
    source: ReactPage { node: gunbhub_hostile_page() }
  ) {
    RenderRejectedBeforeServe { reason: _ } => true
    Served { response: _ } => false
    RouteNotFound => false
    MethodNotAllowed => false
  }
}

fn witness_hostile_page_not_served_via_request_path() -> Bool {
  witness_hostile_page_rejected_before_response()
}

fn witness_browse_route_binding_declared() -> Bool {
  let browse = gunbhub_browse_route()
  fold(
    xs: gunbhub_node_route_bindings(),
    init: false,
    f: (acc, binding) =>
      if acc {
        acc
      } else {
        binding.route.operation_name == browse.operation_name
          && binding.route.method == browse.method
          && binding.listener.handler_name == "gunbhub_handle_browseRoot"
      }
  )
}

fn witness_readme_route_binding_declared() -> Bool {
  let readme = gunbhub_readme_route()
  fold(
    xs: gunbhub_node_route_bindings(),
    init: false,
    f: (acc, binding) =>
      if acc {
        acc
      } else {
        binding.route.operation_name == readme.operation_name
          && binding.route.method == readme.method
          && binding.listener.handler_name == "gunbhub_handle_readmeDoc"
      }
  )
}

fn gunbhub_serve_keystone_holds() -> Bool {
  witness_static_table_has_two_get_routes()
    && witness_static_table_browse_body_matches_compose()
    && witness_static_table_readme_body_is_m1_placeholder()
    && witness_browse_served_body_matches_consumer()
    && witness_readme_served_body_matches_static_table()
    && witness_browse_empty_path_also_matches()
    && witness_unknown_path_not_found()
    && witness_wrong_method_not_allowed()
    && witness_readme_wrong_method_not_allowed()
    && witness_hostile_compose_rejects_fail_closed()
    && witness_hostile_page_not_in_static_table()
    && witness_hostile_page_rejected_before_response()
    && witness_hostile_page_not_served_via_request_path()
    && witness_browse_route_binding_declared()
    && witness_readme_route_binding_declared()
    && gunbhub_html_render_keystone_holds()
}
