// By-execution witnesses for extdeps round-2 grounding:
//   - delete dead GitCommit / GitMergeStrategy (compile-time; object_store.Commit
//     is the single commit authority)
//   - ground five anemic String leaves on live carriers:
//       GitAuthor.email → Email
//       PullRequestRef.{ref, sha} → GitRef / CommitSha
//       PullReview.commit_id → CommitSha
//       ReviewComment.path → FilePath
//
// Discriminating: each witness goes RED if a field reverts to bare String.

module test.claim.extdeps_git_github_grounding_witness

import extdeps.git { GitAuthor }
import extdeps.github.pulls { PullRequest, PullRequestRef, PullReview, ReviewComment, Commented, Open }
import extdeps.github.github { GitHubUser, User }
import gunbc.digest_render { digest_subject }
import std.types { Email, CommitSha, GitRef, FilePath }

data sample_email: Email = "author@example.com"
data sample_sha: CommitSha = "abc1234def5678901234567890abcd1234567890"
data sample_ref: GitRef = "feature/widgets"
data sample_path: FilePath = "dsl/extdeps/git/git.dag"

fn w_git_author_email_grounded() -> Bool {
  let author = GitAuthor {
    name: "Example Author",
    email: sample_email,
    timestamp: "2026-06-18T00:00:00Z"
  }
  author.email == sample_email
}

fn w_pull_request_ref_grounded() -> Bool {
  let head = PullRequestRef {
    ref: sample_ref,
    sha: sample_sha,
    label: "mock-user:feature/widgets"
  }
  head.ref == sample_ref && head.sha == sample_sha
}

fn w_pull_review_commit_id_grounded() -> Bool {
  let review = PullReview {
    id: 1,
    body: "Looks good",
    state: Commented,
    commit_id: sample_sha,
    html_url: "https://github.com/mock/pull/1#pullrequestreview-1"
  }
  review.commit_id == sample_sha
}

fn w_review_comment_path_grounded() -> Bool {
  let comment = ReviewComment {
    id: 1,
    node_id: "PRRC_kwDO",
    path: sample_path,
    line: 10,
    original_line: none,
    body: "nit",
    html_url: "https://github.com/mock/pull/1#discussion_r1"
  }
  comment.path == sample_path
}

fn w_digest_subject_survives_grounded_pull_request_ref() -> Bool {
  let pr = PullRequest {
    number: 42,
    title: "Ground extdeps git/github fields",
    body: none,
    state: Open,
    html_url: "https://github.com/mock/pull/42",
    user: GitHubUser { login: "mock-user", id: 1, type: User },
    head: PullRequestRef {
      ref: sample_ref,
      sha: sample_sha,
      label: "mock-user:feature/widgets"
    },
    base: PullRequestRef {
      ref: "main",
      sha: "000aaa111bbb000aaa111bbb000aaa111bbb",
      label: "mock-owner:main"
    },
    created_at: "2026-06-18T00:00:00Z",
    updated_at: "2026-06-18T00:00:00Z",
    merged_at: none,
    draft: false
  }
  let subject = digest_subject(pr: pr)
  subject.head_sha == sample_sha && subject.base_ref == "main"
}

test fn extdeps_git_github_grounding_witnesses() -> Bool {
  w_git_author_email_grounded() &&
  w_pull_request_ref_grounded() &&
  w_pull_review_commit_id_grounded() &&
  w_review_comment_path_grounded() &&
  w_digest_subject_survives_grounded_pull_request_ref()
}
