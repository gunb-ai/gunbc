module test.claim.uri_path_parse_witness

import extdeps.uri_path {
  parse_path_template,
  ParsedPathTemplate,
  MalformedPathTemplate,
}
import std.http_path {
  PathTemplate,
  has_path_params,
  last_path_param,
  PathParamBinding,
  render_path_template,
}

fn param_path(prefix: String, param_name: String) -> String {
  concat(prefix, "/", "{", param_name, "}")
}

fn witness_literal_path_parses() -> Bool {
  match parse_path_template(raw: "/users") {
    ParsedPathTemplate { template: t } =>
      !has_path_params(template: t) && t.tokens.length() == 1
    MalformedPathTemplate => false
  }
}

fn witness_param_path_has_params() -> Bool {
  match parse_path_template(raw: param_path(prefix: "/users", param_name: "uid")) {
    ParsedPathTemplate { template: t } =>
      has_path_params(template: t) && t.tokens.length() == 2
    MalformedPathTemplate => false
  }
}

fn witness_last_param_roundtrips() -> Bool {
  let expected = "uid"
  match parse_path_template(raw: param_path(prefix: "/users", param_name: expected)) {
    ParsedPathTemplate { template: t } =>
      match last_path_param(template: t) {
        Present { value: name } => name == expected
        Absent => false
      }
    MalformedPathTemplate => false
  }
}

fn witness_nested_path_parses() -> Bool {
  let path = concat(
    param_path(prefix: "/orgs", param_name: "org-name"),
    param_path(prefix: "/repos", param_name: "repo-name"),
  )
  match parse_path_template(raw: path) {
    ParsedPathTemplate { template: t } =>
      has_path_params(template: t) && t.tokens.length() == 4
    MalformedPathTemplate => false
  }
}

fn witness_empty_root_path_parses() -> Bool {
  match parse_path_template(raw: "/") {
    ParsedPathTemplate { template: t } => t.tokens.length() == 0
    MalformedPathTemplate => false
  }
}

fn witness_malformed_unclosed_brace_rejects() -> Bool {
  let bad = concat("/segment/", "{", "param-no-close")
  match parse_path_template(raw: bad) {
    MalformedPathTemplate => true
    ParsedPathTemplate => false
  }
}

fn witness_malformed_discriminates_from_valid() -> Bool {
  let valid = parse_path_template(raw: param_path(prefix: "/a", param_name: "b-param"))
  let invalid = parse_path_template(raw: concat("/a/", "{", "{", "b", "}", "}"))
  match valid {
    ParsedPathTemplate =>
      match invalid {
        MalformedPathTemplate => true
        ParsedPathTemplate => false
      }
    MalformedPathTemplate => false
  }
}

fn witness_render_path_template_binds_params() -> Bool {
  let template = PathTemplate {
    tokens: [
      LiteralToken { text: "/vm/" },
      ParamToken { name: "slot" },
      LiteralToken { text: "/" },
      ParamToken { name: "index" },
    ],
  }
  render_path_template(
    template: template,
    params: [
      PathParamBinding { name: "slot", value: "0" },
      PathParamBinding { name: "index", value: "0" },
    ],
  ) == "/vm/0/0"
}

test fn uri_path_parse_keystone_holds() -> Bool {
  witness_literal_path_parses()
    && witness_param_path_has_params()
    && witness_last_param_roundtrips()
    && witness_nested_path_parses()
    && witness_empty_root_path_parses()
    && witness_malformed_unclosed_brace_rejects()
    && witness_malformed_discriminates_from_valid()
    && witness_render_path_template_binds_params()
}
