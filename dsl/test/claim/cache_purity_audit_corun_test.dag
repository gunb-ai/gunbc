// dsl/test/claim/cache_purity_audit_corun_test.dag
//
// §5 discriminating proof for the cache-purity audit's CO-RUN width binding (TOOTH 2): the audit
// shares the host cgroup budget with the concurrent floor, so its fan-out width is derived against the
// RESIDUAL budget (0.8·total − the floor's MEASURED concurrent peak), fail-closed to 0 when it cannot
// fit beside the floor. These pin the gunbc binding (real floor-peak + measured audit-peak constants)
// by execution — the std formula itself is proven in realization_width_witness_test.dag.
//
// Run: gunbc run --source-root dsl --entry <this> --function cache_purity_audit_corun_witnesses --claim-run

module test.claim.cache_purity_audit_corun

import std.measure { byte_size_count }
import tools.cache_purity_audit_corun {
  gunbc_cache_purity_audit_spawn_width_value,
  gunbc_cache_purity_audit_per_shard_peak_rss_bytes,
  gunbc_cache_purity_audit_corun_measurement,
}
import gunbc.ci_floor_measurement { gunbc_ci_floor_measured_peak }

// Healthy real-fleet host (128 GB): residual 0.8·128 − 8.4 = 94 GB ≫ 4·4.65 GB → memory non-binding,
// width = shard_count cap (4). RED if the residual term were ignored (would still be 4 here, but the
// tiny-budget witness below is the discriminator that the reservation BINDS).
fn audit_corun_healthy_host_width_is_shard_count() -> Bool {
  gunbc_cache_purity_audit_spawn_width_value(memory_budget_bytes: 128000000000) == 4
}

// FAIL-CLOSED over-budget (TOOTH 2 discriminator): a 12 GB budget — 0.8·12 = 9.6 GB; reserve the
// floor's 8.4 GB concurrent peak → residual 1.2 GB < one 4.65 GB audit shard → width 0 (the
// orchestrator fails closed, never a silent width-1 that busts the shared cap). RED if the floor
// reservation were ignored (9.6 GB ÷ 4.65 GB = 2 → would wrongly admit 2 shards beside the floor).
fn audit_corun_tiny_budget_fails_closed() -> Bool {
  gunbc_cache_purity_audit_spawn_width_value(memory_budget_bytes: 12000000000) == 0
}

// Unreadable budget (0-byte host sentinel) → the conservative committed fallback width (2), never
// an unbounded memory-blind fan-out and never an OOM.
fn audit_corun_unreadable_budget_fallback() -> Bool {
  gunbc_cache_purity_audit_spawn_width_value(memory_budget_bytes: 0) == 2
}

// ── topology: the measured numbers ENCODE the "fits off the floor critical path" decision ─────
// Internal consistency: the reach split partitions the audited corpus exactly (62 + 229 + 0 + 0 ==
// 291). A typo in the committed measurement (a miss-stamp) flips this RED.
fn audit_corun_reach_split_partitions_corpus() -> Bool {
  let m = gunbc_cache_purity_audit_corun_measurement
  m.decoded + m.miss_on_read + m.rejected + m.skipped == m.entries_audited
}

// The cache codec is PURE over the full corpus: zero warm!=cold divergences in the measured run.
fn audit_corun_pure_over_full_corpus() -> Bool {
  gunbc_cache_purity_audit_corun_measurement.violations == 0
}

// The co-run FITS any host budget concurrently BY DERIVATION (not pinned to one measured aggregate):
// at the residual-derived width w(B), the audit's concurrent peak (w · measured per-shard peak) plus
// the floor's measured concurrent peak stays within 0.8·B. The residual fold guarantees this for every
// B with w≥1, so the off-critical-path memory conclusion is PARAMETERIZED on the host budget.
fn audit_co_run_fits_budget(budget: Int) -> Bool {
  let width = gunbc_cache_purity_audit_spawn_width_value(memory_budget_bytes: budget)
  let per_shard = byte_size_count(b: gunbc_cache_purity_audit_per_shard_peak_rss_bytes())
  let floor_peak = byte_size_count(b: gunbc_ci_floor_measured_peak.peak)
  let safe_budget = (budget * 4) / 5
  (width * per_shard) + floor_peak <= safe_budget
}

// Both the real-fleet instance (128 GB → width 4) AND the backed-down in-container e2e (33.6 GB cgroup
// → width 3, the budget the live run actually read) satisfy the same derived fit — the e2e ran at the
// width-3/33.6 GB instance and it co-ran under budget, exactly as this proves.
fn audit_corun_fits_host_budget_concurrently() -> Bool {
  audit_co_run_fits_budget(budget: 128000000000)
    && audit_co_run_fits_budget(budget: 33578549248)
}

test fn cache_purity_audit_corun_witnesses() -> Bool {
  audit_corun_healthy_host_width_is_shard_count()
    && audit_corun_tiny_budget_fails_closed()
    && audit_corun_unreadable_budget_fallback()
    && audit_corun_reach_split_partitions_corpus()
    && audit_corun_pure_over_full_corpus()
    && audit_corun_fits_host_budget_concurrently()
}
