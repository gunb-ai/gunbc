module test.claim.ci_deploy_target_host_witness

import gunbc.ci_deploy_access {
  ci_deploy_srv1_access,
  deploy_access_preflight_script,
  deploy_target_proof_from_access,
  deploy_access_with_ssh_transport,
}
import std.types { Bool, List, String }
import gunbc.ci_deploy_target_host {
  RunnerIdentityOnHost,
  deploy_target_host_apply_permitted,
  deploy_local_apply_refused_for_observed_host,
  deploy_target_ssh_proof_structurally_valid,
  gunbc_ci_deploy_srv1_runner_spec,
  deploy_target_host_refusal_local,
}
import gunbc.ci_spec { gunbc_ci_deploy_srv1_stage }
import gunbc.fleet_intent_network { operator_host_srv1, operator_host_srv2 }
import gunbc.fleet_intent { srv1_host }
import gunbc.host_effect { LocalShell, SshShell }
import gunbc.ci_yaml_emit { expected_ci_yml }
import extdeps.github.actions { SelfHosted, RunsOnExpression }

fn witness_srv1_hostname_proves_target() -> Bool {
  let proof = deploy_target_proof_from_access(access: ci_deploy_srv1_access)
  deploy_target_host_apply_permitted(
    proof: proof,
    observed_hostname: "srv1",
    observed_runner_name: "actions-runner@srv1-01.service"
  )
}

fn witness_srv2_hostname_refused_for_srv1_deploy() -> Bool {
  deploy_local_apply_refused_for_observed_host(
    host: ci_deploy_srv1_access.host.identity,
    transport: ci_deploy_srv1_access.transport,
    observed_hostname: "srv2",
    observed_runner_name: "actions-runner@srv2-09.service"
  )
}

fn witness_srv12_runner_name_refused_for_srv1_deploy() -> Bool {
  deploy_local_apply_refused_for_observed_host(
    host: ci_deploy_srv1_access.host.identity,
    transport: ci_deploy_srv1_access.transport,
    observed_hostname: "srv12",
    observed_runner_name: "actions-runner@srv12-01.service"
  )
}

fn witness_ubicloud_runner_name_refused_for_local_apply() -> Bool {
  deploy_local_apply_refused_for_observed_host(
    host: ci_deploy_srv1_access.host.identity,
    transport: ci_deploy_srv1_access.transport,
    observed_hostname: "ubicloud-runner",
    observed_runner_name: "ubicloud-standard-16-arm"
  )
}

fn witness_ssh_transport_structural_proof_holds() -> Bool {
  let ssh_access = deploy_access_with_ssh_transport(
    access: ci_deploy_srv1_access,
    ssh_host: operator_host_srv1
  )
  deploy_target_ssh_proof_structurally_valid(
    proof: deploy_target_proof_from_access(access: ssh_access)
  )
}

fn witness_ssh_transport_mismatch_refused() -> Bool {
  let ssh_access = deploy_access_with_ssh_transport(
    access: ci_deploy_srv1_access,
    ssh_host: operator_host_srv2
  )
  !deploy_target_ssh_proof_structurally_valid(
    proof: deploy_target_proof_from_access(access: ssh_access)
  )
}

fn label_list_contains(labels: List<String>, needle: String) -> Bool {
  fold(labels, init: false, f: (acc, l) => acc || (l == needle))
}

fn witness_deploy_stage_pins_srv1_runner_label() -> Bool {
  gunbc_ci_deploy_srv1_stage.runner == gunbc_ci_deploy_srv1_runner_spec()
    && match gunbc_ci_deploy_srv1_stage.runner {
      SelfHosted { labels: labels } =>
        label_list_contains(labels: labels, needle: "srv1")
          && label_list_contains(labels: labels, needle: "self-hosted")
      _ => false
    }
}

fn witness_deploy_job_not_on_ubicloud_runner() -> Bool {
  match gunbc_ci_deploy_srv1_stage.runner {
    RunsOnExpression { expression: _ } => false
    SelfHosted { labels: _ } => true
    _ => false
  }
}

fn witness_preflight_script_checks_target_host() -> Bool {
  let script = deploy_access_preflight_script(access: ci_deploy_srv1_access)
  string_contains(s: script, pattern: "deploy-target-host: PASS host=srv1")
    && string_contains(s: script, pattern: deploy_target_host_refusal_local)
    && string_contains(s: script, pattern: "hostname -s")
    && string_contains(s: script, pattern: "printenv RUNNER_NAME")
}

fn witness_ci_yml_deploy_job_pins_srv1_runner() -> Bool {
  let yaml = expected_ci_yml()
  string_contains(s: yaml, pattern: "  deploy_dashboard_srv1:")
    && string_contains(s: yaml, pattern: "    runs-on: [self-hosted, linux, arm64, srv1]")
    && !string_contains(s: yaml, pattern: "  deploy_dashboard_srv1:\n    runs-on: ubicloud-standard-16-arm")
}

fn witness_local_proof_requires_host_identity() -> Bool {
  match deploy_target_proof_from_access(access: ci_deploy_srv1_access) {
    RunnerIdentityOnHost { host: id } => id == operator_host_srv1
    _ => false
  }
}

fn witness_access_host_is_srv1() -> Bool {
  ci_deploy_srv1_access.host == srv1_host
    && match ci_deploy_srv1_access.transport {
      LocalShell => true
      _ => false
    }
}

test fn ci_deploy_target_host_witnesses() -> Bool {
  witness_srv1_hostname_proves_target()
    && witness_srv2_hostname_refused_for_srv1_deploy()
    && witness_srv12_runner_name_refused_for_srv1_deploy()
    && witness_ubicloud_runner_name_refused_for_local_apply()
    && witness_ssh_transport_structural_proof_holds()
    && witness_ssh_transport_mismatch_refused()
    && witness_deploy_stage_pins_srv1_runner_label()
    && witness_deploy_job_not_on_ubicloud_runner()
    && witness_preflight_script_checks_target_host()
    && witness_ci_yml_deploy_job_pins_srv1_runner()
    && witness_local_proof_requires_host_identity()
    && witness_access_host_is_srv1()
}
