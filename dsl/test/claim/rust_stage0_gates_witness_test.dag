module test.claim.rust_stage0_gates_witness

import tools.rust_stage0_gates { path_is_rust_monolith, should_run_gates }

fn w_rs_selects() -> Bool { path_is_rust_monolith(path: "src/v1/stage0/src/lib.rs") }
fn w_cargo_toml_selects() -> Bool { path_is_rust_monolith(path: "src/v1/stage0/Cargo.toml") }
fn w_toolchain_selects() -> Bool { path_is_rust_monolith(path: "rust-toolchain.toml") }
fn w_clippy_toml_selects() -> Bool { path_is_rust_monolith(path: "clippy.toml") }
fn w_cargo_config_selects() -> Bool { path_is_rust_monolith(path: ".cargo/config.toml") }
fn w_cargo_lock_selects() -> Bool { path_is_rust_monolith(path: "Cargo.lock") }

fn w_mixed_fires() -> Bool {
  should_run_gates(paths: ["src/v2/std/text.dag", "src/v1/stage0/src/main.rs", "README.md"], git_success: true)
}

fn w_dag_only_no_fire() -> Bool {
  should_run_gates(paths: ["src/v2/std/text.dag"], git_success: true) == false
}

fn w_rs_substring_no_select() -> Bool {
  path_is_rust_monolith(path: "docs/notes.rs.md") == false
}

fn w_generic_config_no_select() -> Bool {
  path_is_rust_monolith(path: "docs/config.toml") == false
}

fn w_empty_no_fire() -> Bool {
  should_run_gates(paths: [], git_success: true) == false
}

fn w_git_fail_fires() -> Bool {
  should_run_gates(paths: [], git_success: false) == true
}

test fn rust_stage0_gates_witnesses() -> Bool {
  w_rs_selects() &&
  w_cargo_toml_selects() &&
  w_toolchain_selects() &&
  w_clippy_toml_selects() &&
  w_cargo_config_selects() &&
  w_cargo_lock_selects() &&
  w_mixed_fires() &&
  w_dag_only_no_fire() &&
  w_rs_substring_no_select() &&
  w_generic_config_no_select() &&
  w_empty_no_fire() &&
  w_git_fail_fires()
}
