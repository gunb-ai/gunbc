module test.claim.wet_hermetic_equivalence_witness

data wet_hermetic_equivalence_representative_prefix: String = "src/v2/test/lens_mock_totality/"

test fn wet_hermetic_equivalence_roster_authority_is_pinned() -> Bool {
  wet_hermetic_equivalence_representative_prefix.starts_with("src/v2/test/")
    && wet_hermetic_equivalence_representative_prefix.ends_with("lens_mock_totality/")
}
