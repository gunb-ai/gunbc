//   cp dsl/test/claim/probe_dsl_compile_clean_falsifier.dag dsl/test/claim/_active_dsl_compile_clean_falsifier.dag
//   gunbc compile --source-root dsl --output-dir /tmp/pc-red --target rust  # must fail
