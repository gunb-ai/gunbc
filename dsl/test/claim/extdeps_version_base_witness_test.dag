// By-execution witnesses for extdeps.version base carriers — DESIGN.md §3 + §5.
// Discriminating: each witness goes RED if identity functions return wrong values
// or if version labels regress to bare String.
//
// Run via:
//   gunbc run --source-root dsl \
//     --entry dsl/test/claim/extdeps_version_base_witness_test.dag \
//     --function extdeps_version_base_witnesses --claim-run

module test.claim.extdeps_version_base_witness

import extdeps.version {
  UpstreamSpecCitation,
  RestApiVersionHeader,
  spec_citations_match,
  api_headers_same_version,
}

// Identity: a citation matches itself.
fn w_spec_citation_self_match() -> Bool {
  let posix = UpstreamSpecCitation {
    source: "https://pubs.opengroup.org/onlinepubs/9699919799/utilities/crontab.html",
    version: "POSIX.1-2017"
  }
  spec_citations_match(a: posix, b: posix)
}

// Non-identity: same source, different version — no match.
fn w_spec_citation_version_mismatch_not_equal() -> Bool {
  let older = UpstreamSpecCitation {
    source: "https://pubs.opengroup.org/onlinepubs/9699919799/utilities/crontab.html",
    version: "POSIX.1-2008"
  }
  let newer = UpstreamSpecCitation {
    source: "https://pubs.opengroup.org/onlinepubs/9699919799/utilities/crontab.html",
    version: "POSIX.1-2017"
  }
  !spec_citations_match(a: older, b: newer)
}

// Non-identity: same version label, different source — no match.
fn w_spec_citation_source_mismatch_not_equal() -> Bool {
  let from_opengroup = UpstreamSpecCitation {
    source: "https://pubs.opengroup.org/onlinepubs/9699919799/utilities/crontab.html",
    version: "POSIX.1-2017"
  }
  let from_other = UpstreamSpecCitation {
    source: "https://example.com/crontab.html",
    version: "POSIX.1-2017"
  }
  !spec_citations_match(a: from_opengroup, b: from_other)
}

// Identity: a REST API version header matches itself.
fn w_api_header_self_match() -> Bool {
  let h = RestApiVersionHeader {
    header: "anthropic-version",
    version: "2023-06-01"
  }
  api_headers_same_version(a: h, b: h)
}

// Non-identity: different header name and different version — no match.
fn w_api_header_distinct_not_same() -> Bool {
  let anthropic = RestApiVersionHeader {
    header: "anthropic-version",
    version: "2023-06-01"
  }
  let github = RestApiVersionHeader {
    header: "X-GitHub-Api-Version",
    version: "2022-11-28"
  }
  !api_headers_same_version(a: anthropic, b: github)
}

// Ordering (ISO 8601 date labels): a 2022 date label is distinct from a 2023 one.
// Proves labels are not collapsed; callers relying on date ordering compare as strings.
fn w_date_version_labels_are_distinct() -> Bool {
  let earlier = RestApiVersionHeader {
    header: "X-GitHub-Api-Version",
    version: "2022-11-28"
  }
  let later = RestApiVersionHeader {
    header: "anthropic-version",
    version: "2023-06-01"
  }
  earlier.version != later.version
    && string_contains(s: earlier.version, pattern: "2022")
    && string_contains(s: later.version, pattern: "2023")
}

test fn extdeps_version_base_witnesses() -> Bool {
  w_spec_citation_self_match()
    && w_spec_citation_version_mismatch_not_equal()
    && w_spec_citation_source_mismatch_not_equal()
    && w_api_header_self_match()
    && w_api_header_distinct_not_same()
    && w_date_version_labels_are_distinct()
}
