module test.claim.storage_nvme_grounding

import std.logic { Bool }
import std.measure { byte_size_count, bandwidth_count }
import extdeps.storage.types {
  NvmeDeviceCatalogRow,
  pcie_link_raw_transfer_rate_gtps,
}
import extdeps.storage.samsung { samsung_970_evo_plus_1tb_catalog }
import product.compute_fabric { nvme_storage_device, StorageDevice, Persistent, Nvme }

data sample_970_evo_plus_device: StorageDevice = nvme_storage_device(
  catalog: samsung_970_evo_plus_1tb_catalog,
  persistence: Persistent,
)

test fn samsung_970_evo_plus_pcie_link_grounds_gen3_x4() -> Bool {
  samsung_970_evo_plus_1tb_catalog.pcie_link.generation.generation_number == 3
    && samsung_970_evo_plus_1tb_catalog.pcie_link.lane_count == 4
    && pcie_link_raw_transfer_rate_gtps(link: samsung_970_evo_plus_1tb_catalog.pcie_link) == 32
}

test fn samsung_970_evo_plus_form_factor_is_m2_2280() -> Bool {
  match samsung_970_evo_plus_1tb_catalog.form_factor {
    M2_2280 => true
    M2_2230 => false
    M2_2242 => false
    M2_2260 => false
    M2_22110 => false
    U2 => false
    AddInCard => false
  }
}

test fn samsung_970_evo_plus_specs_decode() -> Bool {
  byte_size_count(samsung_970_evo_plus_1tb_catalog.capacity_bytes) == 1000204886016
    && bandwidth_count(samsung_970_evo_plus_1tb_catalog.sequential_read) == 3500000000
    && bandwidth_count(samsung_970_evo_plus_1tb_catalog.sequential_write) == 3300000000
}

test fn nvme_storage_device_derives_from_catalog() -> Bool {
  let derived = sample_970_evo_plus_device
  byte_size_count(derived.capacity) == byte_size_count(samsung_970_evo_plus_1tb_catalog.capacity_bytes)
    && match derived.medium {
      Nvme => true
      Ssd => false
      Hdd => false
      NetworkAttached => false
      EphemeralFs => false
    }
    && match derived.catalog {
      Present { value: c } => c.pcie_link.lane_count == 4
      Absent => false
    }
    && match derived.read_bandwidth {
      Present { value: bw } => bandwidth_count(bw) == 3500000000
      Absent => false
    }
}
