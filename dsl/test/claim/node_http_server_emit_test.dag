module test.claim.node_http_server_emit

import std.logic { Bool }
import gunbc.node_http_server_emit { gunbhub_node_http_server_source }

test fn node_http_server_source_contains_create_server() -> Bool {
  string_contains(s: gunbhub_node_http_server_source(), pattern: "createServer")
}

test fn node_http_server_source_contains_listen_call() -> Bool {
  string_contains(s: gunbhub_node_http_server_source(), pattern: "listen(")
}

test fn node_http_server_source_contains_root_path_re() -> Bool {
  string_contains(s: gunbhub_node_http_server_source(), pattern: "/^\\/$/")
}

test fn node_http_server_source_contains_param_path_re() -> Bool {
  string_contains(s: gunbhub_node_http_server_source(), pattern: "[^\\/]+")
}

test fn node_http_server_source_contains_gunbc_content() -> Bool {
  string_contains(s: gunbhub_node_http_server_source(), pattern: "gunbc")
}

test fn node_http_server_source_contains_port_env_check() -> Bool {
  string_contains(s: gunbhub_node_http_server_source(), pattern: "process.env['PORT']")
}

test fn node_http_server_source_discriminating_negative() -> Bool {
  !string_contains(s: gunbhub_node_http_server_source(), pattern: "DOES_NOT_EXIST_IN_SERVER_SOURCE")
}
