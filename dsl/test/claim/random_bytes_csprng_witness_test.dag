module test.claim.random_bytes_csprng_witness

import std.logic { Bool }
import std.types { Int }
import std.integer { UInt8 }
import std.bytes { random_bytes }
import std.encoding { Base64Variant, UrlSafe, base64_encode }

fn octet_count(bs: List<UInt8>) -> Int {
  fold(bs, init: 0, f: (acc, _) => acc + 1)
}

fn mint_base64url_credential(byte_count: Int) -> String {
  base64_encode(octets: random_bytes(count: byte_count), variant: UrlSafe)
}

test fn random_bytes_count_holds() -> Bool {
  octet_count(bs: random_bytes(count: 16)) == 16
}

test fn random_bytes_zero_holds() -> Bool {
  octet_count(bs: random_bytes(count: 0)) == 0
}

test fn random_bytes_base64url_mint_16_length_holds() -> Bool {
  string_length(mint_base64url_credential(byte_count: 16)) == 24
}

test fn random_bytes_base64url_mint_20_length_holds() -> Bool {
  string_length(mint_base64url_credential(byte_count: 20)) == 28
}
