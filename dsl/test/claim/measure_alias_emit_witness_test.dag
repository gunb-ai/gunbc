// Discriminating by-execution witness for the Measure-alias construction peel
// (cursor review 31502 on gunbc#5396). Runs the REAL emit pipeline
// (`compile_sources`) over a probe module via the interpreter, so it executes
// the live `05_emit_rust.dag` logic — NOT a hand-written target string.
//
// The probe defines a single-field struct with an UNUSED generic param `Q`
// (the `Measure` shape) plus a struct alias `Gib`, and constructs through the
// alias. The fix requires the emitter to: name the concrete struct `Probe`
// (not the alias `Gib`, not `Probe::Gib`), and populate the synthetic
// `_phantom` field for the unused `Q` (E0392). This witness fails RED if the
// construction peel regresses.
//
// Run:
//   gunbc run --source-root src/v1 --source-root dsl \
//     --entry dsl/test/claim/measure_alias_emit_witness_test.dag \
//     --function measure_alias_emit_witnesses --claim-run

module test.claim.measure_alias_emit_witness

import v1.compiler.compile { compile_sources, SourceFile }
import v1.compiler.artifact { Rust }
import v1.std.core { TextFile }
import std.types { Int }

// Self-contained probe: `Probe<Q, M>` has the Measure shape (`Q` unused -> needs
// a PhantomData carrier), `Gib` is a concrete struct alias, `mk` constructs
// through the alias.
fn probe_source() -> String {
  concat(
    "module probe\n",
    "type Marker { tag: Int }\n",
    "type Probe<Q, M> { count: M }\n",
    "type Gib = Probe<Marker, Int>\n",
    "fn mk(c: Int) -> Gib { Gib { count: c } }\n"
  )
}

fn emitted_rust() -> String {
  let sources = [SourceFile { path: "probe.dag", content: probe_source() }]
  let result = compile_sources(sources: sources, target: Rust)
  fold(result.files, init: "", f: (acc, file) => concat(acc, file.content))
}

// The alias construction must name the concrete struct `Probe`, never the alias.
fn w_constructs_concrete_struct() -> Bool {
  string_contains(s: emitted_rust(), pattern: "Probe {")
}

// The synthetic phantom field for the unused `Q` must be populated at the
// construction site (E0063 if missing once the struct def carries it).
fn w_populates_phantom_field() -> Bool {
  string_contains(s: emitted_rust(), pattern: "_phantom")
}

// Must NOT construct through the alias name (`Rc<Probe<..>>` is not
// brace-constructible -> E0560) ...
fn w_not_alias_constructor() -> Bool {
  string_contains(s: emitted_rust(), pattern: "Gib {") == false
}

// ... and must NOT prefix the struct as an enum variant (`Probe::Gib`).
fn w_not_enum_prefixed() -> Bool {
  string_contains(s: emitted_rust(), pattern: "Probe::Gib") == false
}

test fn measure_alias_emit_witnesses() -> Bool {
  w_constructs_concrete_struct() &&
  w_populates_phantom_field() &&
  w_not_alias_constructor() &&
  w_not_enum_prefixed()
}
