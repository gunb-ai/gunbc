module test.claim.cr1000a_dhcp_lease_naming

import std.logic { Bool }
import extdeps.router.types {
  DhcpOption12ClientHostname,
  DhcpReservationLabel,
  DynamicDhcpLease,
  StaticDhcpReservation,
}
import extdeps.router.verizon_cr1000a {
  Cr1000aDhcpLeaseRow,
  cr1000a_catalog,
}
import extdeps.vendor.verizon { verizon }

data sample_dynamic_srv1_lease: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: "14:58:d0:00:00:01",
  ipv4_address: "192.168.1.185",
  lease: DynamicDhcpLease {
    option_12_client_hostname: Present { value: "srv1" as DhcpOption12ClientHostname },
    lease_time_remaining_minutes: 120,
  },
}

data sample_static_srv3_reservation: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: "14:58:d0:00:00:03",
  ipv4_address: "192.168.1.192",
  lease: StaticDhcpReservation { label: "srv3" as DhcpReservationLabel },
}

test fn cr1000a_catalog_grounds_verizon_cr1000a() -> Bool {
  cr1000a_catalog.model_number == "CR1000A"
    && cr1000a_catalog.manufacturer == verizon
}

test fn dhcp_lease_observation_discriminates_option_12_vs_reservation_label() -> Bool {
  match sample_dynamic_srv1_lease.lease {
    DynamicDhcpLease { option_12_client_hostname: Present { value: h }, lease_time_remaining_minutes: m } =>
      h == ("srv1" as DhcpOption12ClientHostname) && m == 120
    StaticDhcpReservation { label: _ } => false
  }
    && match sample_static_srv3_reservation.lease {
      StaticDhcpReservation { label: l } => l == ("srv3" as DhcpReservationLabel)
      DynamicDhcpLease { option_12_client_hostname: _, lease_time_remaining_minutes: _ } => false
    }
}

test fn dhcp_lease_observation_construction_excludes_misbound_name_kind() -> Bool {
  match sample_dynamic_srv1_lease.lease {
    DynamicDhcpLease { option_12_client_hostname: _, lease_time_remaining_minutes: _ } => true
    StaticDhcpReservation { label: _ } => false
  }
    && match sample_static_srv3_reservation.lease {
      StaticDhcpReservation { label: _ } => true
      DynamicDhcpLease { option_12_client_hostname: _, lease_time_remaining_minutes: _ } => false
    }
}
