module test.claim.cr1000a_dhcp_lease_naming

import std.logic { Bool }
import extdeps.router.types {
  DhcpOption12ClientHostname,
  DhcpReservationLabel,
  DynamicLease,
  StaticReservation,
  DynamicLeaseClientName,
  StaticReservationLabel,
  dhcp_lease_name_is_option_12_self_report,
  dhcp_lease_name_is_operator_reservation_label,
  dhcp_lease_name_matches_kind,
}
import extdeps.router.verizon_cr1000a {
  Cr1000aDhcpLeaseRow,
  cr1000a_catalog,
  cr1000a_dhcp_lease_row_is_well_formed,
}
import extdeps.vendor.verizon { verizon }

data sample_dynamic_srv1_lease: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: "14:58:d0:00:00:01",
  ipv4_address: "192.168.1.185",
  lease_kind: DynamicLease,
  name: DynamicLeaseClientName {
    option_12_hostname: Present { value: "srv1" as DhcpOption12ClientHostname },
  },
  lease_time_remaining_minutes: Present { value: 120 },
}

data sample_static_srv3_reservation: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: "14:58:d0:00:00:03",
  ipv4_address: "192.168.1.192",
  lease_kind: StaticReservation,
  name: StaticReservationLabel { label: "srv3" as DhcpReservationLabel },
  lease_time_remaining_minutes: none,
}

data sample_misbound_name_kind: Cr1000aDhcpLeaseRow = Cr1000aDhcpLeaseRow {
  mac_address: "14:58:d0:00:00:02",
  ipv4_address: "192.168.1.188",
  lease_kind: DynamicLease,
  name: StaticReservationLabel { label: "srv2" as DhcpReservationLabel },
  lease_time_remaining_minutes: Present { value: 60 },
}

test fn cr1000a_catalog_grounds_verizon_cr1000a() -> Bool {
  cr1000a_catalog.model_number == "CR1000A"
    && cr1000a_catalog.manufacturer == verizon
}

test fn dhcp_lease_name_discriminates_option_12_vs_reservation_label() -> Bool {
  dhcp_lease_name_is_option_12_self_report(name: sample_dynamic_srv1_lease.name)
    && !dhcp_lease_name_is_operator_reservation_label(name: sample_dynamic_srv1_lease.name)
    && dhcp_lease_name_is_operator_reservation_label(name: sample_static_srv3_reservation.name)
    && !dhcp_lease_name_is_option_12_self_report(name: sample_static_srv3_reservation.name)
}

test fn cr1000a_dhcp_lease_row_well_formed_requires_name_kind_agreement() -> Bool {
  cr1000a_dhcp_lease_row_is_well_formed(row: sample_dynamic_srv1_lease)
    && cr1000a_dhcp_lease_row_is_well_formed(row: sample_static_srv3_reservation)
    && !cr1000a_dhcp_lease_row_is_well_formed(row: sample_misbound_name_kind)
    && !dhcp_lease_name_matches_kind(
      name: sample_misbound_name_kind.name,
      kind: sample_misbound_name_kind.lease_kind,
    )
}
