// DEMO (scratch — delete freely): "the fold along the S axis, derived not hand-coded."
//
// Shows the gap we discussed: std.measure already has the two parts needed to DERIVE
// every scale conversion —
//   - scale_exponent(s) : the single exponent authority (Kilo->3, Gibi->30, ...)
//   - int_pow_bounded(base, exp) : a fail-closed bounded power (std.induction)
// — yet the live conversions hand-code the result instead of deriving it:
//   - std.measure.memory_scale_factor_bytes: literal table (1024 / 1048576 / 2^30 / 2^40)
//   - std.measure.gibibyte_to_byte_size:     `count * gibibyte_scale_factor_bytes()`
//   - product.hardware_selection.dag:133:    `bit_width_count(...) / 8`
//
// Here those literals do not appear. The factor falls out of 2^scale_exponent(s).
// That IS "modeling Measure<Q,S> gives a free fold along S" — it was always one
// derivation away; it just wasn't wired.
module test.claim.scale_convert_demo

import std.types { Int }
import std.nat { Nat }
import std.logic { Bool }
import std.measure {
  Scale,
  Atto, Femto, Pico, Nano, Micro, Milli, One,
  Kilo, Mega, Giga, Tera, Peta, Exa,
  Kibi, Mebi, Gibi, Tebi,
  scale_exponent,
}
import std.induction { int_pow_bounded }

// (a) THE FREE FOLD (binary memory): bytes-per-unit at an IEC scale is 2^exponent.
// The hand table's magic numbers (1024, 1048576, 1073741824, 1099511627776) are gone;
// each is now `int_pow_bounded(2, scale_exponent(s))`. Fail-closed (Int?) on SI scales
// (their exponent is base-10, not a byte factor) — same posture as the original, but the
// value is DERIVED, and it inherits int_pow_bounded's bound (no fabricated huge factor).
fn memory_factor_bytes_derived(s: Scale) -> Int? {
  match s {
    One   => int_pow_bounded(base: 2, exp: scale_exponent(s: One))
    Kibi  => int_pow_bounded(base: 2, exp: scale_exponent(s: Kibi))
    Mebi  => int_pow_bounded(base: 2, exp: scale_exponent(s: Mebi))
    Gibi  => int_pow_bounded(base: 2, exp: scale_exponent(s: Gibi))
    Tebi  => int_pow_bounded(base: 2, exp: scale_exponent(s: Tebi))
    Atto  => none
    Femto => none
    Pico  => none
    Nano  => none
    Micro => none
    Milli => none
    Kilo  => none
    Mega  => none
    Giga  => none
    Tera  => none
    Peta  => none
    Exa   => none
  }
}

// (b) THE FREE FOLD (SI decimal): the factor between two SI scales is 10^(e_from - e_to).
// One function spans EVERY SI pair — Kilo->One, Mega->Kilo, Micro->Nano, ... — instead of
// a per-pair constant. (Production note: this still trusts the caller to pass SI scales; to
// make it fail-closed on an IEC input it needs the OTHER missing projection — `scale_base(s)`
// — at which point `base ^ (e_from - e_to)` is the single safe fold for ALL same-base pairs.
// That second projection is exactly the modeling that makes the fold both free AND safe.)
fn si_scale_factor(from: Scale, to: Scale) -> Int? {
  int_pow_bounded(base: 10, exp: scale_exponent(s: from) - scale_exponent(s: to))
}

// (c) bits -> bytes is NOT a scale (8 is not a base-10/base-2 prefix); it is a unit
// relationship, so it gets ITS OWN single authority instead of a scattered `/ 8`.
// This is hardware_selection.dag:133 fixed at the root: the "8" lives in one place.
fn bits_per_byte() -> Nat { 8 }

fn bit_count_to_byte_count(bits: Nat) -> Nat {
  bits / bits_per_byte()
}

// ---------- witnesses: green by execution ----------

// Kibi derives to exactly 1024 — the literal that the live table hard-codes.
test fn derived_kibi_is_1024() -> Bool {
  match memory_factor_bytes_derived(s: Kibi) {
    Present { value: n } => n == 1024
    Absent => false
  }
}

// Gibi derives to 2^30 = 1073741824 (the value of gibibyte_scale_factor_bytes()).
test fn derived_gibi_is_2_pow_30() -> Bool {
  match memory_factor_bytes_derived(s: Gibi) {
    Present { value: n } => n == 1073741824
    Absent => false
  }
}

// SI fold: 1 Kilo-unit = 1000 base-units.
test fn si_kilo_to_one_is_1000() -> Bool {
  match si_scale_factor(from: Kilo, to: One) {
    Present { value: n } => n == 1000
    Absent => false
  }
}

// SI fold: 1 Mega = 1000 Kilo (a non-One pair, so it's a real conversion, not just a factor).
test fn si_mega_to_kilo_is_1000() -> Bool {
  match si_scale_factor(from: Mega, to: Kilo) {
    Present { value: n } => n == 1000
    Absent => false
  }
}

// bits -> bytes single authority: the 64-bit DRAM data bus is 8 bytes.
test fn bits_to_bytes_64_is_8() -> Bool {
  bit_count_to_byte_count(bits: 64) == 8
}

// ---------- discriminating RED guards (must go false if the derivation is wrong) ----------

// Fail-closed: an SI scale is not a byte factor (derived + gated, not a hand 'none' per row).
test fn memory_factor_rejects_si_scale() -> Bool {
  match memory_factor_bytes_derived(s: Mega) {
    Present { value: _ } => false
    Absent => true
  }
}

// Not vacuous: Gibi (binary, 2^30) must NOT equal the decimal Giga value (10^9). If the
// derivation confused the base, this goes red.
test fn derived_gibi_is_not_decimal_giga() -> Bool {
  match memory_factor_bytes_derived(s: Gibi) {
    Present { value: n } => n != 1000000000
    Absent => false
  }
}
