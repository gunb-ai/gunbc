module test.claim.merge_admission_actuator_witness

import gunbc.merge_admission {
  MergeAdmissionReceipt,
  Success,
  KeyedReceipt,
  MergeAdmissionVerdict,
  MergeAdmitted, MergeDeniedStaleBase, MergeDeniedStaleRoster, MergeDeniedNotSuccess,
  classify_merge_admission_verdict,
  merge_admission_would_block,
  merge_admission_enforcement_policy,
}
import gunbc.ci_failure_class {
  merge_admission_blocks_merge,
  merge_freshness_gating_status,
  gating_is_enforced,
}
import std.types { ContentHash }

data scenario_base_b0: ContentHash = "merge-admission-witness-base-b0"
data scenario_base_b1: ContentHash = "merge-admission-witness-base-b1"
data scenario_roster_r0: ContentHash = "merge-admission-witness-roster-r0"
data scenario_roster_r1: ContentHash = "merge-admission-witness-roster-r1"

data scenario_pr_x_receipt: MergeAdmissionReceipt = MergeAdmissionReceipt {
  pr_number: 5933,
  head_sha: "abc1234def5678901234567890abcd1234567890",
  base_tree_hash: scenario_base_b0,
  gate_roster_hash: scenario_roster_r0,
  conclusion: Success,
}

test fn enforcement_policy_is_keyed_receipt() -> Bool {
  merge_admission_enforcement_policy == KeyedReceipt
}

test fn enforcement_denies_stale_base_verdict() -> Bool {
  match classify_merge_admission_verdict(
    receipt: scenario_pr_x_receipt,
    merge_target_tree_hash: scenario_base_b1,
    current_roster_hash: scenario_roster_r0,
  ) {
    MergeDeniedStaleBase => true
    MergeAdmitted => false
    MergeDeniedStaleRoster => false
    MergeDeniedNotSuccess => false
  }
}

test fn enforcement_denies_stale_roster_verdict() -> Bool {
  match classify_merge_admission_verdict(
    receipt: scenario_pr_x_receipt,
    merge_target_tree_hash: scenario_base_b0,
    current_roster_hash: scenario_roster_r1,
  ) {
    MergeDeniedStaleRoster => true
    MergeAdmitted => false
    MergeDeniedStaleBase => false
    MergeDeniedNotSuccess => false
  }
}

test fn enforcement_admits_fresh_verdict() -> Bool {
  match classify_merge_admission_verdict(
    receipt: scenario_pr_x_receipt,
    merge_target_tree_hash: scenario_base_b0,
    current_roster_hash: scenario_roster_r0,
  ) {
    MergeAdmitted => true
    MergeDeniedStaleBase => false
    MergeDeniedStaleRoster => false
    MergeDeniedNotSuccess => false
  }
}

test fn enforcement_red_on_revert_stale_base() -> Bool {
  let fresh = match classify_merge_admission_verdict(
    receipt: scenario_pr_x_receipt,
    merge_target_tree_hash: scenario_base_b0,
    current_roster_hash: scenario_roster_r0,
  ) {
    MergeAdmitted => true
    MergeDeniedStaleBase => false
    MergeDeniedStaleRoster => false
    MergeDeniedNotSuccess => false
  }
  let stale = match classify_merge_admission_verdict(
    receipt: scenario_pr_x_receipt,
    merge_target_tree_hash: scenario_base_b1,
    current_roster_hash: scenario_roster_r0,
  ) {
    MergeDeniedStaleBase => true
    MergeAdmitted => false
    MergeDeniedStaleRoster => false
    MergeDeniedNotSuccess => false
  }
  fresh && stale
}

test fn activation_enforced_blocks_merge_for_stale() -> Bool {
  (gating_is_enforced(s: merge_freshness_gating_status) == true)
    && merge_admission_would_block(
      receipt: scenario_pr_x_receipt,
      merge_target_tree_hash: scenario_base_b1,
      current_roster_hash: scenario_roster_r0,
    )
    && merge_admission_blocks_merge(
      receipt: scenario_pr_x_receipt,
      merge_target_tree_hash: scenario_base_b1,
      current_roster_hash: scenario_roster_r0,
    )
}
