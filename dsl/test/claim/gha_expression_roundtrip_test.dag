// dsl/test/claim/gha_expression_roundtrip_test.dag
//
// The §5.2 round-trip law for the SECOND medium — GitHub Actions `${{ }}`
// EXPRESSIONS (a recursive expression sub-language, structurally distinct from
// markdown's block document). `ingest ∘ emit = id` over the flat canonical core,
// reading the SAME ExpressionSpellings rows + context_name/function_name name
// authorities the emitter writes (DESIGN §4 one grammar both directions; §5.2
// round-trip-as-completeness). Same 5-tooth pattern as the markdown slice #5525.
//
// Teeth:
//   1. ROUND-TRIP LAW — a flat-core expression AND a template round-trip exactly.
//   2. ROW-SHARED both directions — emit AND ingest under a perturbed row still
//      round-trips; exercised on TWO independent rows (path_sep AND or_op).
//   3. DISCRIMINATING — perturbed-emit + canonical-ingest MUST fail (proves
//      ingest READS the row, not a forked parser), for each of the two rows.
//   4. OR-ASSOCIATIVITY PARTITION — a LEFT-nested `||` round-trips (Lossless,
//      the canonical normal form) AND a RIGHT-nested `||` does NOT (it collapses
//      to left-assoc): `id` on the canonical core, a section on non-canonical
//      input. This is the subtle, most valuable discriminator (manager-flagged).
//   5. FRONTIER EXECUTABLE — the Lossy partition is asserted by execution to NOT
//      round-trip (right-nested or, string literal carrying `||`, nested
//      multi-arg call), so the boundary is enforced, not just commented.
//   6. FIDELITY TAG — the recovered core advertised Lossless.
//   7. EMIT NON-REGRESSION (load-bearing) — the ExpressionSpellings extraction
//      refactored LIVE emit (#5499, feeds ci.yml); serialize_*_with(default) is
//      proven BYTE-IDENTICAL to the canonical serialize_* and to the pinned GHA
//      bytes, so the round-trip slice did not regress the forward path. (The live
//      consumers — ci_yaml_serializer_witness, medium_structure_containment
//      discriminators — also stay green; run them alongside.)
//
// FLAT-CORE HONESTY: this is round-trip-complete for the FLAT core, NOT the whole
// GHA expression language — nesting is common in real GHA and is the fenced Lossy
// frontier (see expressions.dag FIDELITY BOUNDARY).
//
// Run: gunbc run --source-root dsl --entry dsl/test/claim/gha_expression_roundtrip_test.dag --function gha_expression_roundtrip_keystone_holds --claim-run

module test.claim.gha_expression_roundtrip

import extdeps.github.expressions {
  Expression,
  ContextAccess,
  FunctionCall,
  StringLiteral,
  LogicalOr,
  ExpressionTemplate,
  TemplateSegment,
  LiteralText,
  Interpolation,
  ExpressionSpellings,
  default_expression_spellings,
  serialize_expression,
  serialize_expression_with,
  serialize_template,
  serialize_template_with,
  ingest_expression,
  ingest_expression_with,
  ingest_template,
  gha_expression_medium_lossless,
  Github,
  Runner,
  HashFiles,
  Contains,
  FromJSON,
  Format,
}
import extdeps.communication.medium { Lossless, Lossy }

// A flat-core expression: a left-nested `||` of a function call (flat string-literal
// args), a multi-segment context path, and a context access.
fn core_expr() -> Expression {
  LogicalOr {
    left: LogicalOr {
      left: FunctionCall {
        function: HashFiles,
        args: [ StringLiteral { value: "Cargo.lock" }, StringLiteral { value: "Cargo.toml" } ],
      },
      right: ContextAccess { context: Github, path: ["event", "number"] },
    },
    right: ContextAccess { context: Runner, path: ["os"] },
  }
}

// A flat template: literal runs interleaved with interpolated context reads.
fn core_template() -> ExpressionTemplate {
  ExpressionTemplate {
    segments: [
      LiteralText { text: "cargo-ci-" },
      Interpolation { expression: ContextAccess { context: Runner, path: ["os"] } },
      LiteralText { text: "-" },
      Interpolation { expression: ContextAccess { context: Runner, path: ["arch"] } },
    ],
  }
}

fn roundtrips_canonical(e: Expression) -> Bool {
  match ingest_expression(src: serialize_expression(expression: e)) {
    Present { value: v } => v == e
    Absent => false
  }
}

fn does_not_roundtrip(e: Expression) -> Bool {
  match ingest_expression(src: serialize_expression(expression: e)) {
    Present { value: v } => !(v == e)
    Absent => true
  }
}

// Tooth 1: the round-trip law over the flat core.
fn witness_roundtrip_expression() -> Bool {
  roundtrips_canonical(e: core_expr())
}

fn witness_roundtrip_template() -> Bool {
  match ingest_template(src: serialize_template(template: core_template())) {
    Present { value: v } => v == core_template()
    Absent => false
  }
}

// Perturbation builder: override path_sep and/or or_op, keep every other row canonical.
fn override_spellings(path_sep: String, or_op: String) -> ExpressionSpellings {
  ExpressionSpellings {
    path_sep: path_sep,
    call_open: default_expression_spellings.call_open,
    call_close: default_expression_spellings.call_close,
    arg_sep: default_expression_spellings.arg_sep,
    string_quote: default_expression_spellings.string_quote,
    or_op: or_op,
    interp_open: default_expression_spellings.interp_open,
    interp_close: default_expression_spellings.interp_close,
  }
}

fn perturbed_path_sep() -> ExpressionSpellings {
  override_spellings(path_sep: "->", or_op: default_expression_spellings.or_op)
}

fn perturbed_or_op() -> ExpressionSpellings {
  override_spellings(path_sep: default_expression_spellings.path_sep, or_op: " OR ")
}

fn roundtrips_under(sp: ExpressionSpellings) -> Bool {
  match ingest_expression_with(src: serialize_expression_with(expression: core_expr(), sp: sp), sp: sp) {
    Present { value: v } => v == core_expr()
    Absent => false
  }
}

// Tooth 2: emit AND ingest under the SAME perturbed row still round-trips —
// both directions read the row. Exercised on TWO independent rows.
fn witness_roundtrip_under_perturbed_rows() -> Bool {
  roundtrips_under(sp: perturbed_path_sep()) && roundtrips_under(sp: perturbed_or_op())
}

// Tooth 3: discriminating — perturbed-emit + CANONICAL-ingest MUST fail (the
// shifted source is unreadable by a canonical ingest). Inert (still equal) ==
// ingest hard-coded the spelling == RED. Checked for each of the two rows.
fn ingest_reads(sp: ExpressionSpellings) -> Bool {
  match ingest_expression(src: serialize_expression_with(expression: core_expr(), sp: sp)) {
    Present { value: v } => !(v == core_expr())
    Absent => true
  }
}

fn witness_ingest_reads_rows() -> Bool {
  ingest_reads(sp: perturbed_path_sep()) && ingest_reads(sp: perturbed_or_op())
}

// A LEFT-nested `||` (the canonical normal form the emitter/ingest agree on).
fn left_nested_or() -> Expression {
  LogicalOr {
    left: LogicalOr {
      left: ContextAccess { context: Runner, path: ["os"] },
      right: ContextAccess { context: Runner, path: ["arch"] },
    },
    right: ContextAccess { context: Runner, path: ["temp"] },
  }
}

// A RIGHT-nested `||` — emits to the SAME bytes as the left-nested form, so
// ingest (fold-left) recovers the left-nested tree, NOT this one: it does not
// round-trip. The honest §5.2 reading — `id` on the canonical core only.
fn right_nested_or() -> Expression {
  LogicalOr {
    left: ContextAccess { context: Runner, path: ["os"] },
    right: LogicalOr {
      left: ContextAccess { context: Runner, path: ["arch"] },
      right: ContextAccess { context: Runner, path: ["temp"] },
    },
  }
}

// Tooth 4: the OR-associativity partition — LEFT round-trips, RIGHT does not.
fn witness_or_associativity_partition() -> Bool {
  roundtrips_canonical(e: left_nested_or()) && does_not_roundtrip(e: right_nested_or())
}

// Frontier: a string literal carrying the or_op delimiter — re-ingest mis-splits.
fn frontier_string_with_or() -> Expression {
  StringLiteral { value: "a || b" }
}

// Frontier: a nested multi-argument call — the inner arg_sep is indistinguishable
// from the outer on re-ingest, so it does not round-trip.
fn frontier_nested_multiarg_call() -> Expression {
  FunctionCall {
    function: Contains,
    args: [
      ContextAccess { context: Github, path: ["event"] },
      FunctionCall {
        function: Format,
        args: [
          StringLiteral { value: "v" },
          ContextAccess { context: Runner, path: ["os"] },
          ContextAccess { context: Runner, path: ["arch"] },
        ],
      },
    ],
  }
}

// Tooth 5: the Lossy frontier asserted by execution to NOT round-trip.
fn witness_frontier_not_roundtripped() -> Bool {
  does_not_roundtrip(e: right_nested_or())
    && does_not_roundtrip(e: frontier_string_with_or())
    && does_not_roundtrip(e: frontier_nested_multiarg_call())
}

// Tooth 6: the recovered core is advertised Lossless (the §5.2 (B) partition).
fn witness_core_advertised_lossless() -> Bool {
  match ingest_expression(src: serialize_expression(expression: core_expr())) {
    Present { value: v } => {
      let m = gha_expression_medium_lossless(expr: v)
      match m.fidelity {
        Lossless => m.carried == core_expr()
        Lossy => false
      }
    }
    Absent => false
  }
}

// Tooth 7 (load-bearing): the ExpressionSpellings extraction is behavior-preserving
// on the forward path. serialize_*_with(default) is byte-identical to the canonical
// serialize_* AND to the pinned real GHA bytes — the refactor did not regress emit.
fn witness_emit_non_regression() -> Bool {
  let e = core_expr()
  let t = core_template()
  (serialize_expression(expression: e) == serialize_expression_with(expression: e, sp: default_expression_spellings))
    && (serialize_template(template: t) == serialize_template_with(template: t, sp: default_expression_spellings))
    && (serialize_expression(expression: e) == "hashFiles('Cargo.lock', 'Cargo.toml') || github.event.number || runner.os")
    && (serialize_template(template: t) == "cargo-ci-${{ runner.os }}-${{ runner.arch }}")
}

test fn gha_expression_roundtrip_keystone_holds() -> Bool {
  witness_roundtrip_expression()
    && witness_roundtrip_template()
    && witness_roundtrip_under_perturbed_rows()
    && witness_ingest_reads_rows()
    && witness_or_associativity_partition()
    && witness_frontier_not_roundtripped()
    && witness_core_advertised_lossless()
    && witness_emit_non_regression()
}
