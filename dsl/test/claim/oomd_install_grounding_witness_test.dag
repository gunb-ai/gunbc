module test.claim.oomd_install_grounding_witness

import std.types { Bool }
import std.measure { byte_size, percent }
import std.realization_reconcile {
  ShowEffectiveRead,
  ReadObserved,
  Grounding,
  Grounds,
  DoesNotGround,
  reconciliation_converged,
}
import gunbc.oomd_install {
  OomdEffectiveRead,
  OomdGroundingThresholds,
  ground_oomd_from_read,
  reconcile_oomd,
  oomd_evidence_from_reconciliation,
  gunbc_oomd_install_evidence,
  gunbc_oomd_fleet_evidence,
}
import gunbc.ci_floor_measurement {
  OomdEnforcementEvidence,
  OomdEnforced,
  OomdUnverified,
  CapEffective,
  CapUnbounded,
  SessionAggregateMeasured,
  SessionAggregateUnmeasured,
}
import extdeps.os.systemd { Active, Inactive }
import extdeps.os.systemctl { UnitEnabled, UnitDisabled }
import extdeps.os.oomd { ManagedOomKill, ManagedOomAuto }

fn test_thresholds() -> OomdGroundingThresholds {
  OomdGroundingThresholds {
    per_session_cap: byte_size(10737418240),
    parent_slice_cap: SessionAggregateMeasured { bytes: byte_size(21474836480) },
    pressure_limit: percent(60),
  }
}

fn good_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: true,
  }
}

fn slice_absent_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: false,
    unit_active: Active,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: true,
  }
}

fn inactive_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Inactive,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: true,
  }
}

fn disabled_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: UnitDisabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: true,
  }
}

fn auto_pressure_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomAuto,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: true,
  }
}

fn wrong_per_session_cap_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(8589934592) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: true,
  }
}

fn unbounded_per_session_cap_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapUnbounded,
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: true,
  }
}

fn wrong_parent_slice_cap_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: true,
  }
}

fn wrong_pressure_limit_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(90),
    oomctl_manages_slice: true,
  }
}

fn oomctl_unmanaged_read() -> OomdEffectiveRead {
  OomdEffectiveRead {
    slice_present: true,
    unit_active: Active,
    unit_file_state: UnitEnabled,
    effective_managed_oom_memory_pressure: ManagedOomKill,
    effective_per_session_memory_max: CapEffective { bytes: byte_size(10737418240) },
    effective_parent_slice_memory_max: CapEffective { bytes: byte_size(21474836480) },
    effective_managed_oom_memory_pressure_limit: percent(60),
    oomctl_manages_slice: false,
  }
}

fn unmeasured_aggregate_thresholds() -> OomdGroundingThresholds {
  OomdGroundingThresholds {
    per_session_cap: byte_size(10737418240),
    parent_slice_cap: SessionAggregateUnmeasured,
    pressure_limit: percent(60),
  }
}

fn grounding_is_enforced(g: Grounding<OomdEnforcementEvidence>) -> Bool {
  match g {
    Grounds { evidence: e } =>
      match e {
        OomdEnforced => true
        OomdUnverified => false
      }
    DoesNotGround { reason: _ } => false
  }
}

fn grounds(read: OomdEffectiveRead) -> Bool {
  grounding_is_enforced(g: ground_oomd_from_read(read: read, req: test_thresholds()))
}

fn witness_full_conjunction_grounds_enforced() -> Bool {
  grounds(read: good_read())
}

fn witness_slice_absent_fails_closed() -> Bool { !grounds(read: slice_absent_read()) }
fn witness_inactive_fails_closed() -> Bool { !grounds(read: inactive_read()) }
fn witness_disabled_fails_closed() -> Bool { !grounds(read: disabled_read()) }
fn witness_auto_pressure_fails_closed() -> Bool { !grounds(read: auto_pressure_read()) }
fn witness_wrong_per_session_cap_fails_closed() -> Bool { !grounds(read: wrong_per_session_cap_read()) }
fn witness_unbounded_per_session_cap_fails_closed() -> Bool { !grounds(read: unbounded_per_session_cap_read()) }
fn witness_wrong_parent_slice_cap_fails_closed() -> Bool { !grounds(read: wrong_parent_slice_cap_read()) }
fn witness_wrong_pressure_limit_fails_closed() -> Bool { !grounds(read: wrong_pressure_limit_read()) }
fn witness_oomctl_unmanaged_fails_closed() -> Bool { !grounds(read: oomctl_unmanaged_read()) }

fn witness_unmeasured_aggregate_fails_closed() -> Bool {
  !grounding_is_enforced(g: ground_oomd_from_read(read: good_read(), req: unmeasured_aggregate_thresholds()))
}

fn managed_observed_read() -> ShowEffectiveRead<OomdEffectiveRead> {
  ReadObserved { value: good_read() }
}

fn is_enforced(e: OomdEnforcementEvidence) -> Bool {
  match e {
    OomdEnforced => true
    OomdUnverified => false
  }
}

fn witness_reconcile_good_read_enforces() -> Bool {
  is_enforced(e: oomd_evidence_from_reconciliation(r: reconcile_oomd(read: managed_observed_read(), req: test_thresholds())))
}

fn witness_reconcile_good_read_converges() -> Bool {
  reconciliation_converged(r: reconcile_oomd(read: managed_observed_read(), req: test_thresholds()))
}

fn witness_absent_read_is_fail_closed() -> Bool {
  !is_enforced(e: gunbc_oomd_install_evidence())
}

fn witness_fleet_evidence_seam_fail_closed() -> Bool {
  !is_enforced(e: gunbc_oomd_fleet_evidence(req: test_thresholds()))
}

test fn oomd_install_grounding_holds() -> Bool {
  witness_full_conjunction_grounds_enforced()
    && witness_slice_absent_fails_closed()
    && witness_inactive_fails_closed()
    && witness_disabled_fails_closed()
    && witness_auto_pressure_fails_closed()
    && witness_wrong_per_session_cap_fails_closed()
    && witness_unbounded_per_session_cap_fails_closed()
    && witness_wrong_parent_slice_cap_fails_closed()
    && witness_wrong_pressure_limit_fails_closed()
    && witness_oomctl_unmanaged_fails_closed()
    && witness_unmeasured_aggregate_fails_closed()
    && witness_reconcile_good_read_enforces()
    && witness_reconcile_good_read_converges()
    && witness_absent_read_is_fail_closed()
    && witness_fleet_evidence_seam_fail_closed()
}
