// Discriminating witnesses for the lifted measure algebra (std.measure):
//   measure_scale_fraction_floor : Measure × num/den → Measure  (capacity, floors)
//   measure_fit_count_floor      : Measure ÷ Measure → count    (fit, floors)
// These are the §3 ① wall ops from docs/plans/expressibility-frontier.md that dissolve the
// spawn-width unwrap→raw-arith→rewrap fork (std.realization_width). The witnesses pin the two
// properties no type can carry: the FLOOR rounding direction (§3 ② residue — a round/ceil impl
// goes RED) and the fail-closed zero-divisor behavior (§5). Genericity over <Q,S> is proven by
// exercising the SAME ops on two distinct Quantities (Memory via ByteSize, Frequency via Hertz).
//
// Run: gunbc run --source-root dsl --entry dsl/test/claim/measure_lifted_algebra_test.dag --function measure_lifted_algebra_witnesses --claim-run
module test.claim.measure_lifted_algebra

import std.measure {
  byte_size,
  byte_size_count,
  hertz,
  hertz_count,
  measure_scale_fraction_floor,
  measure_fit_count_floor,
}
import std.logic { Bool }

// scale-fraction is EXACT when it divides evenly: 10 × 4/5 = 8 (the spawn-width 0.8 case).
fn scale_fraction_exact_holds() -> Bool {
  byte_size_count(b: measure_scale_fraction_floor(m: byte_size(10), num: 4, den: 5)) == 8
}

// scale-fraction FLOORS, it does not round/ceil: 7 × 1/2 = 3.5 → 3 (round/ceil would be 4 → RED).
fn scale_fraction_floors_not_rounds_holds() -> Bool {
  byte_size_count(b: measure_scale_fraction_floor(m: byte_size(7), num: 1, den: 2)) == 3
}

// scale-fraction fail-closed (§5): a zero denominator yields the zero magnitude, never a divide.
fn scale_fraction_zero_den_is_zero_holds() -> Bool {
  byte_size_count(b: measure_scale_fraction_floor(m: byte_size(100), num: 4, den: 0)) == 0
}

// fit-count is EXACT when it divides evenly: 10 ÷ 5 = 2.
fn fit_count_exact_holds() -> Bool {
  measure_fit_count_floor(capacity: byte_size(10), each: byte_size(5)) == 2
}

// fit-count FLOORS: 7 ÷ 2 = 3.5 → 3 (the "how many whole shards fit" semantics; ceil would be 4).
fn fit_count_floors_not_rounds_holds() -> Bool {
  measure_fit_count_floor(capacity: byte_size(7), each: byte_size(2)) == 3
}

// fit-count fail-closed (§5): a zero divisor yields 0, never a divide-by-zero.
fn fit_count_zero_divisor_is_zero_holds() -> Bool {
  measure_fit_count_floor(capacity: byte_size(7), each: byte_size(0)) == 0
}

// Genericity over <Q,S>: the SAME ops apply to a different Quantity (Frequency / Hertz), proving
// the authority is single, not re-coined per alias (DESIGN §2 horizontal).
fn scale_fraction_generic_over_quantity_holds() -> Bool {
  hertz_count(h: measure_scale_fraction_floor(m: hertz(9), num: 2, den: 4)) == 4
}

fn fit_count_generic_over_quantity_holds() -> Bool {
  measure_fit_count_floor(capacity: hertz(9), each: hertz(4)) == 2
}

test fn measure_lifted_algebra_witnesses() -> Bool {
  scale_fraction_exact_holds()
    && scale_fraction_floors_not_rounds_holds()
    && scale_fraction_zero_den_is_zero_holds()
    && fit_count_exact_holds()
    && fit_count_floors_not_rounds_holds()
    && fit_count_zero_divisor_is_zero_holds()
    && scale_fraction_generic_over_quantity_holds()
    && fit_count_generic_over_quantity_holds()
}
