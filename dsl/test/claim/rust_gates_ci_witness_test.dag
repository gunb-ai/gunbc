module test.claim.rust_gates_ci_witness

import tools.rust_gates_ci { gate_diag }

fn w_diag_names_check() -> Bool {
  string_contains(
    s: gate_diag(check: "cargo fmt --all --check", stdout: "diff here", stderr: ""),
    pattern: "cargo fmt --all --check"
  )
}

fn w_diag_includes_stdout() -> Bool {
  string_contains(
    s: gate_diag(check: "cargo fmt --all --check", stdout: "diff here", stderr: ""),
    pattern: "diff here"
  )
}

fn w_diag_includes_stderr() -> Bool {
  string_contains(
    s: gate_diag(check: "cargo nextest run -p v1-compiler-tests", stdout: "", stderr: "FAILED test::my_failing_test"),
    pattern: "FAILED test::my_failing_test"
  )
}

fn w_diag_check_name_in_header() -> Bool {
  string_contains(
    s: gate_diag(check: "cargo clippy --all-targets -- -D warnings", stdout: "", stderr: "error[E0...]: lint"),
    pattern: "FAILED ==="
  )
}

test fn rust_gates_ci_witnesses() -> Bool {
  w_diag_names_check() &&
  w_diag_includes_stdout() &&
  w_diag_includes_stderr() &&
  w_diag_check_name_in_header()
}
