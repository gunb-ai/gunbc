module test.claim.stage0_emit_model_witness

import gunbc.stage0_emit_model {
  stage0_structural_generated_basenames,
  stage0_module_emit_basename,
  stage0_module_emit_filename,
  is_generated_stage0_file,
  is_stage0_structural_generated_file,
  generated_stage0_file_count,
  stage0_emit_registry_phase_is_model_only
}

fn w_generated_roster_count() -> Bool {
  generated_stage0_file_count() == 89
}

fn w_structural_generated_files() -> Bool {
  is_stage0_structural_generated_file(basename: "lib.rs") &&
  is_stage0_structural_generated_file(basename: "v1_rt.rs") &&
  is_stage0_structural_generated_file(basename: "compiler_tests.rs") &&
  stage0_structural_generated_basenames.length() == 3
}

fn w_hand_maintained_not_classified_generated() -> Bool {
  !is_generated_stage0_file(basename: "main.rs") &&
  !is_generated_stage0_file(basename: "cli_run.rs") &&
  !is_generated_stage0_file(basename: "v1_interpreter.rs") &&
  !is_generated_stage0_file(basename: "v1_compiler_parse.rs")
}

fn w_emit_naming_rule() -> Bool {
  stage0_module_emit_basename(module_path: "v1.compiler.emit_rust") == "v1_compiler_emit_rust" &&
  stage0_module_emit_filename(module_path: "v1.compiler.stage0_emit_roster") == "v1_compiler_stage0_emit_roster.rs"
}

fn w_roster_not_yet_committed_generated() -> Bool {
  !is_generated_stage0_file(basename: "v1_compiler_stage0_emit_roster.rs")
}

fn w_phase_model_only() -> Bool {
  stage0_emit_registry_phase_is_model_only()
}

test fn stage0_emit_model_witnesses() -> Bool {
  w_generated_roster_count() &&
  w_structural_generated_files() &&
  w_hand_maintained_not_classified_generated() &&
  w_emit_naming_rule() &&
  w_roster_not_yet_committed_generated() &&
  w_phase_model_only()
}
