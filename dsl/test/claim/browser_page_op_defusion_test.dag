module test.claim.browser_page_op_defusion

import std.logic { Bool }
import extdeps.browser {
  BrowserPageOp,
  Goto, Fill, Click, WaitForSelector, UploadFile, Wait,
  GetByRoleWaitFor, WaitForLoadState, LocatorCountWithText, WaitForLocatorText,
  NetworkIdle, DomContentLoaded, Attached, Visible,
  OpArg, LitArg, RuntimeArg, JoinArg, op_arg_cli,
  op_page_argv,
}
import extdeps.browser.session_program { op_page_js }

test fn op_page_argv_reconstructs_cli_handler() -> Bool {
  op_page_argv(op: Fill { selector: "#username", text: LitArg { v: "root" } }) == ["playwright-runner", "fill", "#username", "root"]
    && op_page_argv(op: Click { selector: "button[type=\"submit\"]" }) == ["playwright-runner", "click", "button[type=\"submit\"]"]
    && op_page_argv(op: Goto { url: LitArg { v: "https://192.168.1.192/#/login" }, wait_until: NetworkIdle }) == ["playwright-runner", "goto", "https://192.168.1.192/#/login", "--wait-until", "networkidle"]
    && op_page_argv(op: WaitForSelector { selector: "#virtual_media_device", state: Attached, timeout_ms: 30000 }) == ["playwright-runner", "wait-for", "#virtual_media_device", "--state", "attached", "--timeout", "30000"]
    && op_page_argv(op: UploadFile { selector: "#virtual_media_device", path: LitArg { v: "/tmp/ubuntu.iso" } }) == ["playwright-runner", "upload", "#virtual_media_device", "/tmp/ubuntu.iso"]
}

test fn op_arg_renders_runtime_as_cli_placeholder() -> Bool {
  op_arg_cli(a: RuntimeArg { name: "bmcUser" }) == concat("{", concat("bmcUser", "}"))
    && op_arg_cli(a: JoinArg { left: RuntimeArg { name: "bmcHost" }, right: LitArg { v: "/#/login" } }) == concat(concat("{", concat("bmcHost", "}")), "/#/login")
}

test fn both_handlers_realize_one_vocab() -> Bool {
  op_page_js(op: Fill { selector: "#username", text: RuntimeArg { name: "a.bmcUser" } }, page: "page") == "await page.fill('#username', a.bmcUser)"
    && op_page_js(op: Click { selector: "button[type=\"submit\"]" }, page: "page") == "await page.click('button[type=\"submit\"]')"
    && op_page_js(op: Goto { url: JoinArg { left: RuntimeArg { name: "a.bmcHost" }, right: LitArg { v: "/#/login" } }, wait_until: NetworkIdle }, page: "page") == "await page.goto(a.bmcHost + '/#/login', { waitUntil: 'networkidle', timeout: 30000 })"
    && op_page_js(op: UploadFile { selector: "#virtual_media_device", path: RuntimeArg { name: "isoPath" } }, page: "page") == "await page.setInputFiles('#virtual_media_device', isoPath)"
    && op_page_js(op: WaitForLocatorText { selector: "button.btn-primary", has_text: "Stop", state: Visible, timeout_ms: 30000 }, page: "page") == "await page.locator('button.btn-primary', { hasText: 'Stop' }).first().waitFor({ state: 'visible', timeout: 30000 })"
}

test fn op_page_argv_covers_new_ops() -> Bool {
  op_page_argv(op: GetByRoleWaitFor { role: "heading", name: "Load image from web browser", timeout_ms: 30000 }) == ["playwright-runner", "wait-for-role", "heading", "--name", "Load image from web browser", "--timeout", "30000"]
    && op_page_argv(op: WaitForLoadState { state: NetworkIdle, timeout_ms: 30000 }) == ["playwright-runner", "wait-load-state", "networkidle", "--timeout", "30000"]
    && op_page_argv(op: LocatorCountWithText { selector: "button.btn-primary", has_text: "Stop" }) == ["playwright-runner", "locator-count", "button.btn-primary", "--has-text", "Stop"]
    && op_page_argv(op: WaitForLocatorText { selector: "button.btn-primary", has_text: "Stop", state: Visible, timeout_ms: 30000 }) == ["playwright-runner", "wait-for-locator", "button.btn-primary", "--has-text", "Stop", "--state", "visible", "--timeout", "30000"]
    && op_page_argv(op: Wait { ms: 800 }) == ["playwright-runner", "wait", "800"]
}
