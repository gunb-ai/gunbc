module test.claim.runner_memory_contract

import std.types { Bool, String }
import std.measure { byte_size_count }
import gunbc.fleet_host_budget {
  gunbc_runner_slot_memory_contract,
  gunbc_runner_slice_cap,
  gunbc_declared_runner_slot_count,
  gunbc_host_swap_available,
  gunbc_ci_heavy_job_working_set,
  gunbc_per_runner_memory_cap,
  gunbc_per_runner_swap_cap,
  gunbc_per_runner_memory_high,
  runner_swap_aggregate_demand,
  runner_swap_aggregate_fits,
  fabric_effective_heavy_job_concurrency,
  fabric_memory_accounting_sound,
  fabric_runner_slice_cap_per_host,
  host_fixed_overhead_bytes,
  declared_runner_count,
}
import gunbc.ci_fleet { fleet_intent_offers }
import gunbc.ci_floor_measurement { gunbc_ci_host_fixed_overhead }
import gunbc.fleet_converge_emit { expected_fleet_converge_sh }
import gunbc.host_converge { fleet_converge_policy, ConvergePolicyDerived, RunnerSlice }
import gunbc.ci_runner_placement { runner_deployment_plan, PlanDerived }

fn has(s: String, p: String) -> Bool {
  string_contains(s: s, pattern: p)
}

fn witness_contract_is_parameterized_record() -> Bool {
  let c = gunbc_runner_slot_memory_contract
  byte_size_count(b: c.memory_max) == 25769803776
    && byte_size_count(b: c.memory_high) == 15032385536
    && byte_size_count(b: c.memory_swap_max) == 8589934592
    && gunbc_per_runner_memory_cap == c.memory_max
    && gunbc_per_runner_swap_cap == c.memory_swap_max
    && gunbc_per_runner_memory_high == c.memory_high
}

fn witness_slice_cap_derives_from_fabric() -> Bool {
  byte_size_count(b: gunbc_runner_slice_cap)
    == byte_size_count(b: fabric_runner_slice_cap_per_host(
      offers: fleet_intent_offers,
      overhead: host_fixed_overhead_bytes(o: gunbc_ci_host_fixed_overhead)
    ))
    && declared_runner_count() == gunbc_declared_runner_slot_count
    && declared_runner_count() == 10
}

fn witness_fabric_concurrency_is_derived() -> Bool {
  fabric_effective_heavy_job_concurrency(
    offers: fleet_intent_offers,
    overhead: host_fixed_overhead_bytes(o: gunbc_ci_host_fixed_overhead),
    working_set: gunbc_ci_heavy_job_working_set
  ) > 0
}

fn witness_swap_aggregate_exceeds_current_host_swap() -> Bool {
  let demand = runner_swap_aggregate_demand(
    slot_count: declared_runner_count(),
    contract: gunbc_runner_slot_memory_contract
  )
  byte_size_count(b: demand) == 85899345920
    && !runner_swap_aggregate_fits(
      slot_count: declared_runner_count(),
      contract: gunbc_runner_slot_memory_contract,
      host_swap: gunbc_host_swap_available
    )
}

fn per_slot_line(host: String, knob: String, property: String, bytes: String) -> String {
  concat(
    concat(
      concat(
        concat(
          concat(
            concat(
              concat("converge_per_slot_cap \"", host),
              "\" \"runner\" \""
            ),
            knob
          ),
          if knob == "per_slot_memory_swap_max_bytes" {
            "\" \"/etc/systemd/system/actions-runner@.service.d/30-fleet-swap.conf\" \"actions-runner@"
          } else if knob == "per_slot_memory_max_bytes" {
            "\" \"/etc/systemd/system/actions-runner@.service.d/20-fleet-width.conf\" \"actions-runner@"
          } else {
            "\" \"/etc/systemd/system/actions-runner@.service.d/40-fleet-high.conf\" \"actions-runner@"
          }
        ),
        host
      ),
      "-*.service\" \""
    ),
    concat(concat(property, "\" \""), concat(bytes, "\""))
  )
}

fn witness_emit_projects_burst_contract() -> Bool {
  let c = gunbc_runner_slot_memory_contract
  let max = to_string(byte_size_count(b: c.memory_max))
  let swap = to_string(byte_size_count(b: c.memory_swap_max))
  let high = to_string(byte_size_count(b: c.memory_high))
  let slice = to_string(byte_size_count(b: gunbc_runner_slice_cap))
  let sh = expected_fleet_converge_sh()
  has(s: sh, p: concat("converge_slice_property \"srv1\" \"runner\" \"runner_slice_cap_bytes\" \"system-actions-runner.slice\" \"MemoryMax\" \"", concat(slice, "\"")))
    && has(s: sh, p: per_slot_line(host: "srv1", knob: "per_slot_memory_max_bytes", property: "MemoryMax", bytes: max))
    && has(s: sh, p: per_slot_line(host: "srv1", knob: "per_slot_memory_swap_max_bytes", property: "MemorySwapMax", bytes: swap))
    && has(s: sh, p: per_slot_line(host: "srv1", knob: "per_slot_memory_high_bytes", property: "MemoryHigh", bytes: high))
    && has(s: sh, p: "converge_slice_property \"srv1\" \"runner\" \"oom_pressure_auto\" \"system-actions-runner.slice\" \"ManagedOOMMemoryPressure\" \"auto\" \"auto\" \"true\"")
    && has(s: sh, p: per_slot_line(host: "srv3", knob: "per_slot_memory_max_bytes", property: "MemoryMax", bytes: max))
    && has(s: sh, p: per_slot_line(host: "srv3", knob: "per_slot_memory_high_bytes", property: "MemoryHigh", bytes: high))
    && !has(s: sh, p: "\"MemorySwapMax\" \"0\"")
    && !has(s: sh, p: "\"MemoryMax\" \"8589934592\"")
}

fn witness_deployment_carries_slot_memory_and_slice() -> Bool {
  match runner_deployment_plan() {
    PlanDerived { hosts: hosts } =>
      hosts.length() > 0
        && all(hosts, h =>
          byte_size_count(b: h.slot_memory.memory_max) == byte_size_count(b: gunbc_runner_slot_memory_contract.memory_max)
            && byte_size_count(b: h.slot_memory.memory_high) == byte_size_count(b: gunbc_runner_slot_memory_contract.memory_high)
            && byte_size_count(b: h.slot_memory.memory_swap_max) == byte_size_count(b: gunbc_runner_slot_memory_contract.memory_swap_max)
            && byte_size_count(b: h.runner_slice_cap) == byte_size_count(b: gunbc_runner_slice_cap)
        )
    _ => false
  }
}

fn witness_policy_has_per_slot_memory_knobs() -> Bool {
  match fleet_converge_policy() {
    ConvergePolicyDerived { hosts: hosts } =>
      hosts.length() > 0
        && all(hosts, h =>
          any(h.knobs, k => k.name == "per_slot_memory_high_bytes" && k.slice == RunnerSlice)
            && any(h.knobs, k => k.name == "per_slot_memory_max_bytes" && k.slice == RunnerSlice)
            && any(h.knobs, k => k.name == "per_slot_memory_swap_max_bytes" && k.slice == RunnerSlice)
            && any(h.knobs, k => k.name == "runner_slice_cap_bytes" && k.slice == RunnerSlice)
            && any(h.knobs, k => k.name == "oom_pressure_auto" && k.slice == RunnerSlice)
        )
    _ => false
  }
}

fn witness_fabric_accounting_overcommit_requires_swap() -> Bool {
  !fabric_memory_accounting_sound(
    offers: fleet_intent_offers,
    overhead: host_fixed_overhead_bytes(o: gunbc_ci_host_fixed_overhead),
    slot_count: gunbc_declared_runner_slot_count,
    contract: gunbc_runner_slot_memory_contract,
    host_swap: gunbc_host_swap_available
  )
}

test fn runner_memory_contract_holds() -> Bool {
  witness_contract_is_parameterized_record()
    && witness_slice_cap_derives_from_fabric()
    && witness_fabric_concurrency_is_derived()
    && witness_swap_aggregate_exceeds_current_host_swap()
    && witness_emit_projects_burst_contract()
    && witness_deployment_carries_slot_memory_and_slice()
    && witness_policy_has_per_slot_memory_knobs()
    && witness_fabric_accounting_overcommit_requires_swap()
}
