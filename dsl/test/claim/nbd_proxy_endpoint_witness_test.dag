module test.claim.nbd_proxy_endpoint

import std.logic { Bool }
import extdeps.bmc.webui.nbd_proxy {
  bmcweb_nbd_proxy_primary_ws_upgrade_endpoint,
  bmcweb_nbd_proxy_ws_upgrade_facts,
  VmSlotIndexEndpoint,
  NbdSlotEndpoint,
  Primary,
  Absent,
}

test fn altrad8ud_nbd_proxy_primary_endpoint_is_vm_slot_index() -> Bool {
  bmcweb_nbd_proxy_primary_ws_upgrade_endpoint == VmSlotIndexEndpoint
}

test fn altrad8ud_nbd_proxy_ws_upgrade_facts_vm_primary_nbd_absent() -> Bool {
  bmcweb_nbd_proxy_ws_upgrade_facts.first().endpoint == VmSlotIndexEndpoint
    && bmcweb_nbd_proxy_ws_upgrade_facts.first().rank == Primary
    && bmcweb_nbd_proxy_ws_upgrade_facts.skip(n: 1).first().endpoint == NbdSlotEndpoint
    && bmcweb_nbd_proxy_ws_upgrade_facts.skip(n: 1).first().rank == Absent
}
