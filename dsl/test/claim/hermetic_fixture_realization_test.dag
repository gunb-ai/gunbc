module test.claim.hermetic_fixture_realization

import std.types { Bool, ContentHash }
import std.cache_identity { hermetic_fixture_artifact_kind }
import std.cache_interface {
  ArtifactIdentity,
  ContentAddressedByValue,
  PerHostFilesystem,
  InProcess,
  StructuredArtifact,
  MissIsDiagnostic,
}
import extdeps.cache.cache {
  cache_interface_facts_from_catalog,
  cache_key_projection_transport,
}
import extdeps.cache.types { catalog_key_derivation_classification }
import extdeps.realization.hermetic_fixture {
  hermetic_fixture_file_facts,
  hermetic_fixture_in_process_facts,
  hermetic_fixture_file_store_id,
  hermetic_fixture_in_process_id,
}

data shared_input_digest: ContentHash = "hermetic-fixture-witness-shared-input-digest"

fn witness_file_handler_is_content_addressed_reference() -> Bool {
  let f = cache_interface_facts_from_catalog(row: hermetic_fixture_file_facts)
  (catalog_key_derivation_classification(kd: hermetic_fixture_file_facts.key_derivation) == ContentAddressedByValue)
    && f.key_derivation.content_verified_on_read
    && (f.locality == PerHostFilesystem)
    && (f.value_shape == StructuredArtifact)
}

fn witness_in_process_handler_is_content_addressed_converged() -> Bool {
  let m = cache_interface_facts_from_catalog(row: hermetic_fixture_in_process_facts)
  (catalog_key_derivation_classification(kd: hermetic_fixture_in_process_facts.key_derivation) == ContentAddressedByValue)
    && m.key_derivation.content_verified_on_read
    && (m.locality == InProcess)
    && (m.value_shape == StructuredArtifact)
}

fn witness_handlers_converged_on_key_derivation() -> Bool {
  let f = cache_interface_facts_from_catalog(row: hermetic_fixture_file_facts)
  let m = cache_interface_facts_from_catalog(row: hermetic_fixture_in_process_facts)
  let f_class = catalog_key_derivation_classification(kd: hermetic_fixture_file_facts.key_derivation)
  let m_class = catalog_key_derivation_classification(kd: hermetic_fixture_in_process_facts.key_derivation)
  (f_class == m_class)
    && (f_class == ContentAddressedByValue)
    && f.key_derivation.content_verified_on_read
    && m.key_derivation.content_verified_on_read
    && !(f.locality == m.locality)
}

fn witness_handlers_share_kernel_invariants() -> Bool {
  let f = cache_interface_facts_from_catalog(row: hermetic_fixture_file_facts)
  let m = cache_interface_facts_from_catalog(row: hermetic_fixture_in_process_facts)
  (f.value_shape == m.value_shape)
    && (f.miss_semantics == MissIsDiagnostic)
    && (m.miss_semantics == MissIsDiagnostic)
}

fn witness_one_artifact_routes_to_both_backends() -> Bool {
  let id = ArtifactIdentity {
    subject_digest: shared_input_digest,
    artifact_kind: hermetic_fixture_artifact_kind,
  }
  let file_key = cache_key_projection_transport(artifact: id, backend: hermetic_fixture_file_facts)
  let mem_key = cache_key_projection_transport(artifact: id, backend: hermetic_fixture_in_process_facts)
  (file_key.store == hermetic_fixture_file_store_id)
    && (mem_key.store == hermetic_fixture_in_process_id)
    && !(file_key.store == mem_key.store)
}

test fn hermetic_fixture_realization_witnesses() -> Bool {
  witness_file_handler_is_content_addressed_reference()
    && witness_in_process_handler_is_content_addressed_converged()
    && witness_handlers_converged_on_key_derivation()
    && witness_handlers_share_kernel_invariants()
    && witness_one_artifact_routes_to_both_backends()
}
