module test.claim.runnable_space_cost

import std.realization_schedule {
  Runnable,
  RunnableSingleClaim,
  RunnableDiscoveryBatch,
  runnable_space_cost,
  runnable_space_cost_zero,
  runnable_space_cost_sum,
  runnable_space_cost_negligible,
  runnable_forbids_corpus_co_residence,
  runnable_predicted_space,
}
import std.measure { byte_size, byte_size_count }

fn witness_zero_cost_is_negligible() -> Bool {
  runnable_space_cost_negligible(cost: runnable_space_cost_zero())
}

fn witness_nonzero_cost_forbids_corpus_co_residence() -> Bool {
  let heavy = RunnableSingleClaim {
    entry: "e"
    function: "f"
    cost: runnable_space_cost(predicted_peak: byte_size(count: 1))
  }
  runnable_forbids_corpus_co_residence(r: heavy)
}

fn witness_corpus_never_forbids_co_residence() -> Bool {
  let corpus = RunnableDiscoveryBatch {
    source_roots: []
    scan_dirs: []
    explicit_entries: []
    skip_unaffected_node_frontier: false
    cost: runnable_space_cost(predicted_peak: byte_size(count: 3226056704))
  }
  !runnable_forbids_corpus_co_residence(r: corpus)
}

fn witness_space_cost_sum_matches_byte_totals() -> Bool {
  let left = runnable_space_cost(predicted_peak: byte_size(count: 100))
  let right = runnable_space_cost(predicted_peak: byte_size(count: 200))
  let sum = runnable_space_cost_sum(left: left, right: right)
  byte_size_count(b: runnable_predicted_space(r: RunnableSingleClaim {
    entry: "e"
    function: "f"
    cost: sum
  })) == 300
}

test fn runnable_space_cost_witnesses() -> Bool {
  witness_zero_cost_is_negligible()
    && witness_nonzero_cost_forbids_corpus_co_residence()
    && witness_corpus_never_forbids_co_residence()
    && witness_space_cost_sum_matches_byte_totals()
}
