// By-execution witnesses for render glyph + ANSI realizations
// (extdeps.render.glyphs / extdeps.render.ansi over std.symbols concepts).
// Run via:
//   gunbc run --source-root dsl --entry dsl/test/claim/render_glyphs_ansi_witness_test.dag \
//     --function render_glyphs_ansi_witnesses --claim-run
//
// Locks the tier dispatch and ANSI escape table that comments alone would
// leave as spec-without-execution (DESIGN.md §5). Discriminating: each
// witness goes RED on a wrong glyph string or escape code.

module test.claim.render_glyphs_ansi_witness

import extdeps.render.ansi { ansi_code }
import extdeps.render.glyphs { resolve_symbol, symbol_color }
import std.symbols { Ascii, Error, NodeCompleted, NodeFailed, Success, Unicode }

// -- Glyph tier dispatch -----------------------------------------------------
fn w_completed_ascii() -> Bool {
  match resolve_symbol(id: NodeCompleted, tier: Ascii) {
    Present { value: s } => s == "[x]"
    Absent => false
  }
}

fn w_completed_unicode_differs_from_ascii() -> Bool {
  match resolve_symbol(id: NodeCompleted, tier: Unicode) {
    Present { value: u } =>
      match resolve_symbol(id: NodeCompleted, tier: Ascii) {
        Present { value: a } => u != a
        Absent => false
      }
    Absent => false
  }
}

fn w_failed_color_is_error() -> Bool {
  match symbol_color(id: NodeFailed) {
    Present { value: c } =>
      match c {
        Error => true
        _ => false
      }
    Absent => false
  }
}

// -- ANSI escape realization -------------------------------------------------
fn w_success_ansi_is_256_green() -> Bool {
  match ansi_code(c: Success) {
    Present { value: code } => code == "\x1b[38;5;34m"
    Absent => false
  }
}

// Conjunction keystone — CI runs with --claim-run (false → exit 1).
test fn render_glyphs_ansi_witnesses() -> Bool {
  w_completed_ascii() &&
  w_completed_unicode_differs_from_ascii() &&
  w_failed_color_is_error() &&
  w_success_ansi_is_256_green()
}
