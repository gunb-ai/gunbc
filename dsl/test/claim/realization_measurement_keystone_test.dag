// dsl/test/claim/realization_measurement_keystone_test.dag
//
// Phase-0 keystone: PerformanceReceipt wall nanos roll up into CostAccount.time
// with basis Measured (not predicted_zero). Discriminating: predicted_zero stays
// Predicted; measured receipt path is Measured.
//
// Run: gunbc run --source-root dsl --entry <this> --function realization_measurement_keystone_witnesses --claim-run

module test.claim.realization_measurement_keystone

import std.realization_schedule {
  CostAccount,
  CostBasis,
  cost_account_measured,
  cost_account_predicted_zero,
  cost_account_time_nanos,
}
import product.compute_fabric {
  WorkUnitId,
  performance_receipt_host_single_sample,
  performance_receipts_total_time,
  performance_receipts_total_wall_nanos,
}

data sample_work_shape: WorkUnitId = "witness:realization_measurement_keystone"

fn witness_predicted_zero_is_predicted_basis() -> Bool {
  match cost_account_predicted_zero() {
    CostAccount { basis: Predicted, time: _, space: _, power: _ } => true
    CostAccount { basis: Measured, time: _, space: _, power: _ } => false
  }
}

fn witness_measured_receipt_rollup_is_measured_basis() -> Bool {
  let receipt = performance_receipt_host_single_sample(
    work_shape: sample_work_shape,
    wall_nanos: 5000000,
  )
  let total = cost_account_measured(
    time: performance_receipts_total_time(receipts: [receipt]),
  )
  match total {
    CostAccount { basis: Measured, time: _, space: _, power: _ } =>
      cost_account_time_nanos(account: total) == performance_receipts_total_wall_nanos(receipts: [receipt])
    CostAccount { basis: Predicted, time: _, space: _, power: _ } => false
  }
}

test fn realization_measurement_keystone_witnesses() -> Bool {
  witness_predicted_zero_is_predicted_basis()
    && witness_measured_receipt_rollup_is_measured_basis()
}
