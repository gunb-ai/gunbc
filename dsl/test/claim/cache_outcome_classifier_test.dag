// dsl/test/claim/cache_outcome_classifier_test.dag
//
// M5 step-2 gap surfaces (docs/plans/m5-fixture-store-consolidation.md §2): executing witness for
// the additive std.cache_interface lookup/write outcome coproducts and their total classifiers.
//
// Proves BY EXECUTION that FreshnessExpired is a typed staleness refusal, the WriteOnce purity
// oracle (WriteOnceConflict) is isolated from other write rejects, and a rejected write leaves no
// artifact present (fail-closed). Discriminating RED: the purity-oracle witness fails if the
// classifier conflates WriteOnceConflict with WriteUnfaithful/BackendWriteRejected, and the
// present-after-write witness fails if a WriteRejected is treated as present.
//
// Run: gunbc run --source-root dsl --entry dsl/test/claim/cache_outcome_classifier_test.dag \
//        --function cache_outcome_classifier_witnesses --claim-run

module test.claim.cache_outcome_classifier

import std.types { Bool, ContentHash }
import std.cache_identity { CacheInterfaceId, resolved_graph_artifact_kind, ExecutionReceiptDigest }
import std.cache_interface {
  ArtifactIdentity,
  BackendCacheKey,
  CasContentDigest,
  InternalExecution,
  ExecutionReceiptRef,
  CachedArtifactReceipt,
  CacheLookupResult,
  Hit,
  Miss,
  RejectedHit,
  FreshnessExpired,
  SubjectDigestMismatch,
  TransportFaithfulnessFailure,
  EncodingMalformed,
  ValueKindNotSerializable,
  CacheWriteResult,
  Written,
  WriteSkippedIdempotent,
  WriteRejected,
  WriteOnceConflict,
  WriteUnfaithful,
  BackendWriteRejected,
  cache_lookup_honored,
  cache_reject_is_staleness,
  cache_write_artifact_present,
  cache_write_is_purity_violation,
}

data sample_digest: ContentHash = "cache-outcome-classifier-subject"
data sample_store_id: CacheInterfaceId = "cache-outcome-classifier-store"
data sample_receipt_digest: ExecutionReceiptDigest = "cache-outcome-classifier-receipt"

data sample_receipt: CachedArtifactReceipt<String> = CachedArtifactReceipt {
  artifact: ArtifactIdentity {
    subject_digest: sample_digest,
    artifact_kind: resolved_graph_artifact_kind,
  },
  backend_key: BackendCacheKey {
    store: sample_store_id,
    key: CasContentDigest { digest: sample_digest },
  },
  producer: InternalExecution {
    receipt: ExecutionReceiptRef { receipt_digest: sample_receipt_digest },
  },
  content_digest: sample_digest,
}

data hit_result: CacheLookupResult<String> = Hit { receipt: sample_receipt }
data miss_result: CacheLookupResult<String> = Miss
data expired_result: CacheLookupResult<String> = RejectedHit { reason: FreshnessExpired }

data written_result: CacheWriteResult<String> = Written { receipt: sample_receipt }
data idempotent_result: CacheWriteResult<String> = WriteSkippedIdempotent { receipt: sample_receipt }
data drift_result: CacheWriteResult<String> = WriteRejected { reason: WriteOnceConflict }
data unfaithful_write: CacheWriteResult<String> = WriteRejected {
  reason: WriteUnfaithful { reason: ValueKindNotSerializable }
}
data backend_write_reject: CacheWriteResult<String> = WriteRejected {
  reason: BackendWriteRejected { backend_reason: SubjectDigestMismatch }
}

fn witness_lookup_honored_only_for_hit() -> Bool {
  cache_lookup_honored(result: hit_result)
    && !cache_lookup_honored(result: miss_result)
    && !cache_lookup_honored(result: expired_result)
}

fn witness_freshness_expiry_is_typed_staleness() -> Bool {
  cache_reject_is_staleness(reason: FreshnessExpired)
    && !cache_reject_is_staleness(reason: SubjectDigestMismatch)
    && !cache_reject_is_staleness(reason: TransportFaithfulnessFailure { reason: EncodingMalformed })
}

fn witness_write_present_only_when_committed_or_idempotent() -> Bool {
  cache_write_artifact_present(result: written_result)
    && cache_write_artifact_present(result: idempotent_result)
    && !cache_write_artifact_present(result: drift_result)
}

fn witness_purity_oracle_isolates_write_once_conflict() -> Bool {
  cache_write_is_purity_violation(result: drift_result)
    && !cache_write_is_purity_violation(result: idempotent_result)
    && !cache_write_is_purity_violation(result: unfaithful_write)
    && !cache_write_is_purity_violation(result: backend_write_reject)
}

test fn cache_outcome_classifier_witnesses() -> Bool {
  witness_lookup_honored_only_for_hit()
    && witness_freshness_expiry_is_typed_staleness()
    && witness_write_present_only_when_committed_or_idempotent()
    && witness_purity_oracle_isolates_write_once_conflict()
}
