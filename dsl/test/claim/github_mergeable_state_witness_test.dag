module test.claim.github_mergeable_state_witness

import extdeps.github.mergeable_state {
  MergeableState,
  Mergeable,
  Conflicting,
  Unknown,
  parse_mergeable_state,
  mergeable_state_wire_label,
}

test fn witness_mergeable_state_mergeable_recognized() -> Bool {
  match Mergeable {
    Mergeable => true
    _ => false
  }
}

test fn witness_mergeable_state_conflicting_not_mergeable() -> Bool {
  match Conflicting {
    Mergeable => false
    _ => true
  }
}

test fn witness_mergeable_state_conflicting_recognized() -> Bool {
  match Conflicting {
    Conflicting => true
    _ => false
  }
}

test fn witness_mergeable_state_mergeable_not_conflicting() -> Bool {
  match Mergeable {
    Conflicting => false
    _ => true
  }
}

test fn witness_mergeable_wire_decodes_to_mergeable() -> Bool {
  match parse_mergeable_state(raw: "MERGEABLE") {
    Present { value: Mergeable } => true
    _ => false
  }
}

test fn witness_conflicting_wire_decodes_to_conflicting() -> Bool {
  match parse_mergeable_state(raw: "CONFLICTING") {
    Present { value: Conflicting } => true
    _ => false
  }
}

test fn witness_lowercase_mergeable_does_not_decode() -> Bool {
  match parse_mergeable_state(raw: "mergeable") {
    none => true
    _ => false
  }
}

test fn witness_mergeable_state_roundtrip_conflicting() -> Bool {
  mergeable_state_wire_label(s: Conflicting) == "CONFLICTING"
}
