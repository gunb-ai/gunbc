module test.claim.spark_collective_fabric

import std.logic { Bool }
import gunbc.fleet_intent_network {
  operator_host_spark_3bd5,
  operator_host_spark_a3ee,
  operator_host_spark_c2b1,
  operator_host_spark_ac79,
  operator_host_srv1,
  collective_placement,
  CollectiveAdmissible,
  CollectiveRefused,
  SparkPairA,
  SparkPairB,
}

test fn spark_collective_within_pair_a_is_admissible() -> Bool {
  match collective_placement(ranks: [operator_host_spark_3bd5, operator_host_spark_a3ee]) {
    CollectiveAdmissible { fabric: f } => match f { SparkPairA => true  _ => false }
    CollectiveRefused { reason: _ } => false
  }
}

test fn spark_collective_within_pair_b_is_admissible() -> Bool {
  match collective_placement(ranks: [operator_host_spark_c2b1, operator_host_spark_ac79]) {
    CollectiveAdmissible { fabric: f } => match f { SparkPairB => true  _ => false }
    CollectiveRefused { reason: _ } => false
  }
}

test fn spark_collective_across_pairs_is_refused() -> Bool {
  match collective_placement(
    ranks: [
      operator_host_spark_3bd5,
      operator_host_spark_a3ee,
      operator_host_spark_c2b1,
      operator_host_spark_ac79,
    ]
  ) {
    CollectiveAdmissible { fabric: _ } => false
    CollectiveRefused { reason: _ } => true
  }
}

test fn spark_collective_off_fabric_host_is_refused() -> Bool {
  match collective_placement(ranks: [operator_host_srv1]) {
    CollectiveAdmissible { fabric: _ } => false
    CollectiveRefused { reason: _ } => true
  }
}

test fn spark_collective_mixed_on_and_off_fabric_is_refused() -> Bool {
  match collective_placement(ranks: [operator_host_spark_3bd5, operator_host_srv1]) {
    CollectiveAdmissible { fabric: _ } => false
    CollectiveRefused { reason: _ } => true
  }
}
