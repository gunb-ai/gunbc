module test.claim.markup_medium_convergence

import std.markup {
  MarkupNode, MarkupAttr, ElementNode, TextNode,
  MarkupMedium, MarkupBracket, TagDelimiter, EscapeHtml, EscapeRaw,
  OmitClose,
  serialize_markup_node_with,
}
import extdeps.languages.markdown {
  commonmark_gfm_spellings,
  markdown_markup_medium,
  serialize_markdown_source_with,
}
import std.markdown {
  MarkdownDocument,
  ParagraphBlock,
  TextInline,
  EmphasisInline,
  StrongInline,
  LinkInline,
}
import extdeps.languages.html {
  try_serialize_html_source,
  HtmlEmitResult,
  EmitOk,
  EmitRejected,
  canonical_html_spellings,
  html_markup_medium,
}

fn em_hi() -> MarkupNode {
  ElementNode { tag: "em", attrs: [], children: [ TextNode { text: "hi" } ] }
}

fn md_medium() -> MarkupMedium {
  markdown_markup_medium(sp: commonmark_gfm_spellings)
}

fn witness_same_fold_html_vs_md() -> Bool {
  let html = serialize_markup_node_with(node: em_hi(), medium: html_markup_medium())
  let md = serialize_markup_node_with(node: em_hi(), medium: md_medium())
  (html == "<em>hi</em>") && (md == "*hi*") && (html != md)
}

fn md_medium_underscore() -> MarkupMedium {
  MarkupMedium {
    tag_overrides: [ TagDelimiter { tag: "em", open: "_", close: "_" } ],
    bracket: canonical_html_spellings,
    text_escape: EscapeRaw,
    void_tags: [],
    void_rendering: OmitClose,
  }
}

fn witness_perturb_row_flips_output() -> Bool {
  let base = serialize_markup_node_with(node: em_hi(), medium: md_medium())
  let perturbed = serialize_markup_node_with(node: em_hi(), medium: md_medium_underscore())
  (base == "*hi*") && (perturbed == "_hi_") && (base != perturbed)
}

fn button_node() -> MarkupNode {
  ElementNode {
    tag: "button",
    attrs: [ MarkupAttr { name: "class", value: "primary" } ],
    children: [ TextNode { text: "Go" } ],
  }
}

fn single_quote_medium() -> MarkupMedium {
  MarkupMedium {
    tag_overrides: [],
    bracket: MarkupBracket {
      tag_open: "<",
      end_tag_open: "</",
      tag_close: ">",
      attr_sep: " ",
      attr_assign: "=",
      attr_quote: "'",
    },
    text_escape: EscapeHtml,
    void_tags: [],
    void_rendering: OmitClose,
  }
}

fn witness_third_medium_is_one_row() -> Bool {
  let html = serialize_markup_node_with(node: button_node(), medium: html_markup_medium())
  let single_quote = serialize_markup_node_with(node: button_node(), medium: single_quote_medium())
  (html == "<button class=\"primary\">Go</button>")
    && (single_quote == "<button class='primary'>Go</button>")
    && (html != single_quote)
}

fn md_mixed_doc() -> MarkdownDocument {
  MarkdownDocument {
    blocks: [
      ParagraphBlock {
        inlines: [
          StrongInline { inlines: [ TextInline { text: "bold" } ] },
          TextInline { text: " and " },
          EmphasisInline { inlines: [ TextInline { text: "em" } ] },
        ],
      },
    ],
  }
}

fn witness_md_inline_emission_bytes() -> Bool {
  let out = serialize_markdown_source_with(doc: md_mixed_doc(), sp: commonmark_gfm_spellings)
  out == "**bold** and *em*\n"
}

fn md_link_doc() -> MarkdownDocument {
  MarkdownDocument {
    blocks: [
      ParagraphBlock {
        inlines: [
          LinkInline { inlines: [ TextInline { text: "text" } ], url: "https://x.com" },
        ],
      },
    ],
  }
}

fn witness_md_link_named_arm_bytes() -> Bool {
  let out = serialize_markdown_source_with(doc: md_link_doc(), sp: commonmark_gfm_spellings)
  out == "[text](https://x.com)\n"
}

fn hostile_href_node() -> MarkupNode {
  ElementNode {
    tag: "a",
    attrs: [ MarkupAttr { name: "href", value: "javascript:alert(1)" } ],
    children: [ TextNode { text: "x" } ],
  }
}

fn witness_xss_still_rejected_through_fold() -> Bool {
  match try_serialize_html_source(node: hostile_href_node()) {
    EmitRejected { reason: _ } => true
    EmitOk { html: _ } => false
  }
}

test fn markup_medium_convergence_holds() -> Bool {
  witness_same_fold_html_vs_md()
    && witness_perturb_row_flips_output()
    && witness_third_medium_is_one_row()
    && witness_md_inline_emission_bytes()
    && witness_md_link_named_arm_bytes()
    && witness_xss_still_rejected_through_fold()
}
