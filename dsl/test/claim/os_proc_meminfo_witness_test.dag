module test.claim.os_proc_meminfo_witness

import extdeps.os.proc_meminfo {
  ProcMeminfo,
  MemoryMetric,
  meminfo_field_names,
}
import std.types { NonEmptyStr }

test fn proc_meminfo_witnesses() -> Bool {
  let info = ProcMeminfo {
    mem_total: 8012272,
    mem_free: 4048136,
    mem_available: 6144000,
    buffers: 256000,
    cached: 2048136,
    swap_total: 2097152,
    swap_free: 2097152,
    all_metrics: [],
  }

  let metric = MemoryMetric {
    key: "MemTotal" as NonEmptyStr,
    value_kibibytes: 8012272,
  }

  info.mem_total > 0
    && info.mem_available <= info.mem_total
    && metric.value_kibibytes > 0
}
