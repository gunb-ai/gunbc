module test.claim.os_proc_meminfo_witness

import extdeps.os.proc_meminfo {
  ProcMeminfo,
  MemoryMetric,
  meminfo_field_names,
}
import std.measure { Kibibyte }
import std.types { NonEmptyStr }

test fn proc_meminfo_witnesses() -> Bool {
  let info = ProcMeminfo {
    mem_total: 8012272 as Kibibyte,
    mem_free: 4048136 as Kibibyte,
    mem_available: 6144000 as Kibibyte,
    buffers: 256000 as Kibibyte,
    cached: 2048136 as Kibibyte,
    swap_total: 2097152 as Kibibyte,
    swap_free: 2097152 as Kibibyte,
    all_metrics: [],
  }

  let metric = MemoryMetric {
    key: "MemTotal" as NonEmptyStr,
    value: 8012272 as Kibibyte,
  }

  info.mem_total > 0
    && info.mem_available <= info.mem_total
    && metric.value > 0
}
