module test.claim.os_free_witness

import extdeps.os.free {
  FreeOutput,
  MemoryStats,
  SwapStats,
}

test fn free_output_witnesses() -> Bool {
  let memory_stats = MemoryStats {
    total: 8192000000,
    used: 1024000000,
    free: 2048000000,
    shared: 0,
    buff_cache: 5120000000,
    available: 3072000000,
  }

  let swap_stats = SwapStats {
    total: 2048000000,
    used: 0,
    free: 2048000000,
  }

  let output = FreeOutput {
    memory: memory_stats,
    swap: swap_stats,
  }

  memory_stats.total > 0
    && memory_stats.available <= memory_stats.total
    && memory_stats.free <= memory_stats.total
    && swap_stats.total >= 0
    && swap_stats.used <= swap_stats.total
    && swap_stats.free <= swap_stats.total
    && output.memory.total > 0
    && output.swap.total >= 0
    && memory_stats.available >= memory_stats.free
}
