module test.claim.compute_fabric_resource_witness

import product.compute_fabric {
  witness_resource_offer_rejects_insufficient_threads,
  witness_resource_offer_rejects_insufficient_memory,
  witness_resource_offer_admits_feasible_demand,
  witness_run_demand_envelope_fits_budget,
  witness_high_demand_shrinks_envelope_and_fits,
  witness_fail_open_memory_blind_demand_exceeds_budget,
  witness_unreadable_budget_uses_conservative_demand,
}

test fn compute_fabric_resource_feasibility_holds() -> Bool {
  witness_resource_offer_rejects_insufficient_threads()
    && witness_resource_offer_rejects_insufficient_memory()
    && witness_resource_offer_admits_feasible_demand()
}

test fn ci_floor_run_demand_envelope_model_holds() -> Bool {
  witness_run_demand_envelope_fits_budget()
    && witness_high_demand_shrinks_envelope_and_fits()
    && witness_fail_open_memory_blind_demand_exceeds_budget()
    && witness_unreadable_budget_uses_conservative_demand()
}
