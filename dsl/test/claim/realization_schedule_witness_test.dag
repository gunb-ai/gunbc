module test.claim.realization_schedule_witness

import std.realization_schedule {
  RealizationPlan,
  RealizationObjective,
  Runnable,
  RunnableSingleClaim,
  RunnableDiscoveryBatch,
  runnable_resource_profile_negligible,
  schedule_lens_verdict_for_ci_floor,
  cost_account_predicted_zero,
}
import std.types { ContentHash }

data synthetic_target: ContentHash = "realization-schedule-witness-v1"
data compile_gate_fn: String = "dsl_compile_clean_gate_passes"
data gate_entry: String = "dsl/tools/floor_effect_gate_witness.dag"

fn synthetic_correct_schedule() -> List<List<Runnable>> {
  [
    [RunnableSingleClaim { entry: gate_entry, function: compile_gate_fn, profile: runnable_resource_profile_negligible() }],
    [
      RunnableDiscoveryBatch {
        source_roots: ["dsl"]
        scan_dirs: []
        explicit_entries: []
        skip_unaffected_node_frontier: false
        profile: runnable_resource_profile_negligible()
      },
      RunnableSingleClaim { entry: gate_entry, function: "rust_monolith_gate_passes", profile: runnable_resource_profile_negligible() }
    ]
  ]
}

fn synthetic_correct_plan() -> RealizationPlan {
  RealizationPlan {
    target: synthetic_target
    objective: RealizationObjective { goals: [] }
    schedule: synthetic_correct_schedule()
    total: cost_account_predicted_zero()
  }
}

fn perturbed_schedule_wrong_order(correct: List<List<Runnable>>) -> List<List<Runnable>> {
  [
    correct.skip(n: 1).first(),
    correct.first()
  ]
}

fn witness_schedule_lens_green_on_synthetic_plan() -> Bool {
  match schedule_lens_verdict_for_ci_floor(
    plan: synthetic_correct_plan(),
    compile_gate_fn: compile_gate_fn,
    compile_clean_sharded: false
  ) {
    Holds => true
    Violation { diagnostic: _ } => false
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

fn witness_schedule_lens_red_when_corpus_runs_first_on_synthetic() -> Bool {
  let perturbed = RealizationPlan {
    target: synthetic_target
    objective: RealizationObjective { goals: [] }
    schedule: perturbed_schedule_wrong_order(correct: synthetic_correct_schedule())
    total: cost_account_predicted_zero()
  }
  match schedule_lens_verdict_for_ci_floor(plan: perturbed, compile_gate_fn: compile_gate_fn, compile_clean_sharded: false) {
    Holds => false
    Violation { diagnostic: _ } => true
    NotApplicable { diagnostic: _ } => false
    Unrealized { diagnostic: _ } => false
  }
}

test fn realization_schedule_witnesses() -> Bool {
  witness_schedule_lens_green_on_synthetic_plan()
    && witness_schedule_lens_red_when_corpus_runs_first_on_synthetic()
}
