module test.claim.grounded_principal_witness

import std.types { NonEmptyStr, Bool }
import gunbc.fleet_posix_accounts {
  FleetAccountCiRunner,
  FleetAccountOperator,
  FleetAccountRoot,
  GroundedPosixPrincipal,
  PosixAccountDeclaredProbe,
  fleet_posix_principal,
  grounded_posix_principal_name,
  fleet_posix_account_from_name,
  fleet_posix_account_exists,
  posix_declared_probe_names_principal,
  fleet_operator_email,
  fleet_operator_gcp_iam_member,
}
import gunbc.ci_deploy_access {
  ci_deploy_srv1_access,
  ci_deploy_srv1_operator_access,
  deploy_preflight_shell_header,
  deploy_access_preflight_script,
  grounded_principal_privileged_commands,
  deploy_access_privileged_fixture_actor,
  deploy_mutation_gate,
  Permit,
  Deny,
}
import gunbc.ci_deploy_target_host {
  DeployTargetHostObservation,
  deploy_target_host_fixture_observation,
}
import gunbc.host_identity_access { host_identity_operator_principal_name }
import gunbc.tailscale_acl_phase2_credential {
  tailscale_acl_operator_email,
  operator_principal_member,
  operator_tailscale_acl_secret_bindings,
}
import extdeps.github.expressions { context_name, Runner }

fn witness_runner_fiction_not_in_roster() -> Bool {
  !fleet_posix_account_exists(name: "runner" as NonEmptyStr)
    && match fleet_posix_account_from_name(name: "runner" as NonEmptyStr) {
      Present { value: _ } => false
      Absent => true
    }
}

fn witness_ghrunner_is_ci_deploy_principal() -> Bool {
  let deploy_name = grounded_posix_principal_name(p: ci_deploy_srv1_access.principal)
  let roster_name = grounded_posix_principal_name(p: fleet_posix_principal(key: FleetAccountCiRunner))
  deploy_name == "ghrunner" && deploy_name == roster_name
}

fn witness_operator_is_manual_deploy_principal() -> Bool {
  let deploy_name = grounded_posix_principal_name(p: ci_deploy_srv1_operator_access.principal)
  let roster_name = grounded_posix_principal_name(p: fleet_posix_principal(key: FleetAccountOperator))
  deploy_name == "briansrls" && deploy_name == roster_name
}

fn witness_briansrls_fork_dissolved() -> Bool {
  host_identity_operator_principal_name() == "briansrls"
    && tailscale_acl_operator_email() == fleet_operator_email
    && operator_principal_member() == fleet_operator_gcp_iam_member()
    && string_contains(
      s: operator_principal_member(),
      pattern: host_identity_operator_principal_name() as String
    )
}

fn witness_declared_probe_names_principal() -> Bool {
  posix_declared_probe_names_principal(p: fleet_posix_principal(key: FleetAccountCiRunner))
    && posix_declared_probe_names_principal(p: fleet_posix_principal(key: FleetAccountOperator))
    && posix_declared_probe_names_principal(p: fleet_posix_principal(key: FleetAccountRoot))
}

fn witness_declared_probe_mismatch_red() -> Bool {
  let p = fleet_posix_principal(key: FleetAccountCiRunner)
  let poisoned = GroundedPosixPrincipal {
    posix: p.posix,
    sudo_grants: p.sudo_grants,
    declared_probe: PosixAccountDeclaredProbe {
      probed_at: p.declared_probe.probed_at,
      probe_command: "id runner",
      host: p.declared_probe.host,
    },
  }
  !posix_declared_probe_names_principal(p: poisoned)
}

fn witness_ci_runner_sudo_grants_derive_privileged_commands() -> Bool {
  let cmds = grounded_principal_privileged_commands(
    p: fleet_posix_principal(key: FleetAccountCiRunner)
  )
  (length(cmds) == 5)
    && cmds.first().path == "/usr/bin/bash"
}

fn witness_preflight_shell_is_dash_safe() -> Bool {
  deploy_preflight_shell_header == "set -eu"
    && !string_contains(s: deploy_preflight_shell_header, pattern: "pipefail")
}

fn witness_gha_runner_context_is_not_os_account() -> Bool {
  context_name(context: Runner) == "runner"
    && !fleet_posix_account_exists(name: "runner" as NonEmptyStr)
}

fn witness_operator_secret_binding_uses_fleet_gcp_member() -> Bool {
  operator_tailscale_acl_secret_bindings.first().member == fleet_operator_gcp_iam_member()
    && operator_principal_member() == fleet_operator_gcp_iam_member()
}

fn srv1_host_observation() -> DeployTargetHostObservation {
  deploy_target_host_fixture_observation(
    hostname: "srv1",
    runner_name: "actions-runner@srv1-01.service"
  )
}

fn witness_ci_runner_grounded_access_gate_permits() -> Bool {
  match deploy_mutation_gate(
    access: ci_deploy_srv1_access,
    fixture_actor: Present {
      value: deploy_access_privileged_fixture_actor(access: ci_deploy_srv1_access)
    },
    fixture_host: Present { value: srv1_host_observation() }
  ) {
    Permit => true
    Deny { reason: _ } => false
  }
}

fn witness_operator_grounded_access_gate_permits() -> Bool {
  match deploy_mutation_gate(
    access: ci_deploy_srv1_operator_access,
    fixture_actor: Present {
      value: deploy_access_privileged_fixture_actor(access: ci_deploy_srv1_operator_access)
    },
    fixture_host: Present { value: srv1_host_observation() }
  ) {
    Permit => true
    Deny { reason: _ } => false
  }
}

fn witness_deploy_preflight_script_is_dash_safe() -> Bool {
  let script = deploy_access_preflight_script(access: ci_deploy_srv1_access)
  !string_contains(s: script, pattern: "pipefail")
    && string_contains(s: script, pattern: deploy_preflight_shell_header)
}

test fn grounded_principal_witnesses() -> Bool {
  witness_runner_fiction_not_in_roster()
    && witness_ghrunner_is_ci_deploy_principal()
    && witness_operator_is_manual_deploy_principal()
    && witness_briansrls_fork_dissolved()
    && witness_declared_probe_names_principal()
    && witness_declared_probe_mismatch_red()
    && witness_ci_runner_sudo_grants_derive_privileged_commands()
    && witness_gha_runner_context_is_not_os_account()
    && witness_preflight_shell_is_dash_safe()
    && witness_operator_secret_binding_uses_fleet_gcp_member()
    && witness_ci_runner_grounded_access_gate_permits()
    && witness_operator_grounded_access_gate_permits()
    && witness_deploy_preflight_script_is_dash_safe()
}
