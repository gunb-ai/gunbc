// dsl/test/claim/bash_serializer_witness.dag
//
// By-execution witnesses for the structured shell-program serializer
// (extdeps.languages.bash.program). Mirrors ci_yaml_serializer_witness:
// a golden Holds + a discriminating perturbation that goes RED.

module test.claim.bash_serializer_witness

import extdeps.languages.bash.program {
  ShellWord, Lit, VarRef, CmdSubst, Raw,
  ShellStmt, Command, Assign, RawLine,
  ShellProgram,
  lit, var_ref, command, assign, single_quote, serialize_bash
}

// A small, real-shaped program: OUT=$(mktemp -d); rm -rf "$OUT".
fn prog_mktemp_rm() -> ShellProgram {
  ShellProgram {
    set_e: true,
    statements: [
      assign(name: "OUT", value: CmdSubst { argv: [lit(text: "mktemp"), lit(text: "-d")] }),
      command(words: [lit(text: "rm"), lit(text: "-rf"), var_ref(name: "OUT")])
    ]
  }
}

// Golden: exact bytes. set -e prefix, single-quoted literals, $(...) substitution, "$VAR" expansion.
fn witness_serialize_golden() -> Bool {
  serialize_bash(p: prog_mktemp_rm()) ==
    "set -e\nOUT=$('mktemp' '-d')\n'rm' '-rf' \"$OUT\"\n"
}

// Single-quote escaping is total: an embedded ' becomes the canonical '\'' sequence.
fn witness_single_quote_escapes_embedded_quote() -> Bool {
  single_quote(s: "a'b") == "'a'\\''b'"
}

// A literal carrying shell metacharacters is neutralized: the whole thing stays one
// single-quoted word, so the shell never expands $(...) or `...` inside it.
fn witness_metachars_are_quoted() -> Bool {
  serialize_bash(p: ShellProgram {
    set_e: false,
    statements: [command(words: [lit(text: "echo"), lit(text: "$(rm -rf /)")])]
  }) == "'echo' '$(rm -rf /)'\n"
}

// Discriminating: a program WITHOUT the OUT assignment and WITHOUT set -e serializes to
// strictly different bytes. A serializer that ignored its input would fail this.
fn witness_discriminates_on_input() -> Bool {
  let a = serialize_bash(p: prog_mktemp_rm())
  let b = serialize_bash(p: ShellProgram {
    set_e: false,
    statements: [command(words: [lit(text: "rm"), lit(text: "-rf"), var_ref(name: "OUT")])]
  })
  a != b
}

// VarRef stays double-quoted (word-splitting safe), Lit stays single-quoted (no expansion).
fn witness_varref_vs_lit_quoting() -> Bool {
  let out = serialize_bash(p: ShellProgram {
    set_e: false,
    statements: [command(words: [var_ref(name: "ROOT"), lit(text: "ROOT")])]
  })
  out == "\"$ROOT\" 'ROOT'\n"
}

fn bash_serializer_keystone_holds() -> Bool {
  witness_serialize_golden() &&
    witness_single_quote_escapes_embedded_quote() &&
    witness_metachars_are_quoted() &&
    witness_discriminates_on_input() &&
    witness_varref_vs_lit_quoting()
}
