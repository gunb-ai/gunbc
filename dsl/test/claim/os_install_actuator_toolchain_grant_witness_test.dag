module test.claim.os_install_actuator_toolchain_grant

import std.logic { Bool }
import std.types { list_length }
import extdeps.bmc.os_install_actuator_toolchain {
  srv3_os_install_actuator_toolchain_grant,
  srv3_os_install_actuator_host_label,
  srv3_os_install_actuator_toolchain_is_complete,
  actuator_toolchain_grant_includes_tool,
}
import extdeps.tools.curl { curl_cli_tool }
import extdeps.tools.websocat { websocat_cli_tool }
import extdeps.tools.nbdkit { nbdkit_cli_tool }
import extdeps.tools.socat { socat_cli_tool }

test fn srv3_actuator_toolchain_grant_declares_four_tools() -> Bool {
  list_length(items: srv3_os_install_actuator_toolchain_grant.required_tools) == 4
    && srv3_os_install_actuator_toolchain_is_complete()
}

test fn srv3_actuator_toolchain_grant_is_fail_closed_on_websocat() -> Bool {
  actuator_toolchain_grant_includes_tool(
    grant: srv3_os_install_actuator_toolchain_grant,
    tool_name: websocat_cli_tool.name
  )
    && actuator_toolchain_grant_includes_tool(
      grant: srv3_os_install_actuator_toolchain_grant,
      tool_name: nbdkit_cli_tool.name
    )
    && actuator_toolchain_grant_includes_tool(
      grant: srv3_os_install_actuator_toolchain_grant,
      tool_name: socat_cli_tool.name
    )
    && actuator_toolchain_grant_includes_tool(
      grant: srv3_os_install_actuator_toolchain_grant,
      tool_name: curl_cli_tool.name
    )
}

test fn srv3_actuator_host_label_is_declared() -> Bool {
  srv3_os_install_actuator_host_label == "install-actuator-host"
}
