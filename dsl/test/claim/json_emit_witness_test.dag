module test.claim.json_emit_witness

import extdeps.external_authority { ExternalAuthority }
import extdeps.languages.json.emit {
  extdeps_external_authority_anchor,
  escape_json_string,
  quote_json_string,
  serialize_json,
  json_null,
  json_bool,
  json_int,
  json_string,
  json_array,
  json_object,
  json_kv,
  json_int_list,
  json_str_list,
  json_unicode_escape_hex4,
}
import extdeps.languages.json.grammar {
  json_production_rows,
  json_number_lexeme_valid,
  json_int_lexeme,
}

fn witness_json_cites_rfc8259() -> Bool {
  match extdeps_external_authority_anchor {
    ExternalAuthority { uri } => uri.locator == "www.rfc-editor.org/rfc/rfc8259"
  }
}

fn witness_escape_backslash_and_quote() -> Bool {
  escape_json_string(s: "a\"b\\c") == "a\\\"b\\\\c"
}

fn witness_escape_newline() -> Bool {
  escape_json_string(s: "line one\nline two") == "line one\\nline two"
}

fn witness_escape_tab() -> Bool {
  escape_json_string(s: concat("a", concat(from_code_point(cp: 9), "b"))) == "a\\tb"
}

fn witness_escape_carriage_return() -> Bool {
  escape_json_string(s: concat("x", concat(from_code_point(cp: 13), "y"))) == "x\\ry"
}

fn witness_escape_control_u0001() -> Bool {
  escape_json_string(s: from_code_point(cp: 1)) == "\\u0001"
}

fn witness_quote_json_string() -> Bool {
  quote_json_string(s: "hello") == "\"hello\""
    && quote_json_string(s: "a\"b") == "\"a\\\"b\""
}

fn witness_serialize_null() -> Bool {
  serialize_json(v: json_null()) == "null"
}

fn witness_serialize_bool() -> Bool {
  serialize_json(v: json_bool(b: true)) == "true"
    && serialize_json(v: json_bool(b: false)) == "false"
}

fn witness_serialize_int() -> Bool {
  serialize_json(v: json_int(n: 42)) == "42"
}

fn witness_serialize_object() -> Bool {
  serialize_json(v: json_object(members: [
    json_kv(key: "host", value: json_string(s: "srv1")),
    json_kv(key: "runner_count", value: json_int(n: 4)),
  ])) == "{\"host\": \"srv1\", \"runner_count\": 4}"
}

fn witness_serialize_nested_object() -> Bool {
  serialize_json(v: json_object(members: [
    json_kv(key: "Password", value: json_string(s: "secret")),
  ])) == "{\"Password\": \"secret\"}"
}

fn witness_serialize_array() -> Bool {
  serialize_json(v: json_array(elements: [json_string(s: "a"), json_string(s: "b")])) == "[\"a\", \"b\"]"
}

fn witness_int_list_helper() -> Bool {
  json_int_list(nums: [1, 2, 3]) == "[1, 2, 3]"
}

fn witness_str_list_helper() -> Bool {
  json_str_list(items: ["x", "y"]) == "[\"x\", \"y\"]"
}

fn witness_grammar_rows_cover_json_value_variants() -> Bool {
  length(xs: json_production_rows) >= 8
}

fn witness_invalid_number_lexeme_rejected() -> Bool {
  !json_number_lexeme_valid(s: "not-a-number")
    && !json_number_lexeme_valid(s: "12abc")
    && !json_number_lexeme_valid(s: "")
    && !json_number_lexeme_valid(s: "01")
}

fn witness_json_int_lexeme_always_valid() -> Bool {
  json_number_lexeme_valid(s: json_int_lexeme(n: 42).lexeme)
    && json_number_lexeme_valid(s: json_int_lexeme(n: -7).lexeme)
    && json_number_lexeme_valid(s: json_int_lexeme(n: 0).lexeme)
}

fn witness_json_number_lexeme_valid_accepts_fraction_and_exp() -> Bool {
  json_number_lexeme_valid(s: "12.34")
    && json_number_lexeme_valid(s: "1e10")
    && json_number_lexeme_valid(s: "-0.5e+2")
}

fn witness_unicode_escape_hex4_boundary_0fff() -> Bool {
  json_unicode_escape_hex4(cp: 4095) == "0FFF"
}

fn witness_unicode_escape_hex4_boundary_ffff() -> Bool {
  json_unicode_escape_hex4(cp: 65535) == "FFFF"
}

test fn json_emit_witnesses() -> Bool {
  witness_json_cites_rfc8259()
    && witness_escape_backslash_and_quote()
    && witness_escape_newline()
    && witness_escape_tab()
    && witness_escape_carriage_return()
    && witness_escape_control_u0001()
    && witness_quote_json_string()
    && witness_serialize_null()
    && witness_serialize_bool()
    && witness_serialize_int()
    && witness_serialize_object()
    && witness_serialize_nested_object()
    && witness_serialize_array()
    && witness_int_list_helper()
    && witness_str_list_helper()
    && witness_grammar_rows_cover_json_value_variants()
}
