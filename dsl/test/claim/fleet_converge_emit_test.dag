import std.measure { byte_size, byte_size_count, hardware_thread_count, second_count }
import extdeps.github.actions { RunnerSpec, SelfHosted }
import gunbc.fleet_host_budget {
  gunbc_runner_slice_cap,
  gunbc_runner_slot_memory_contract,
  RunnerSlotMemoryContract,
}
import gunbc.ci_runner_placement {
  RunnerDeploymentPlan,
  PlanDerived,
  PlanUnsound,
  RunnerHostDeployment,
  BatchLatencyTolerant,
}
import gunbc.ci_floor_measurement {
  SessionReservationMode,
  Regime2AggregateOomd,
  SessionAggregateMeasured,
}
import gunbc.host_converge {
  ConvergePolicy,
  ConvergePolicyDerived,
  ConvergePolicyUnsound,
  ConvergeVerdict,
  Converged,
  Drifted,
  Absent,
  ConvergeKnob,
  ConvergeSlice,
  GunbcSlice,
  RunnerSlice,
  SessionsSlice,
  HostConverge,
  gunbc_pinned_tree_desired_label,
  gunbc_root_env_key,
  gunbc_host_gunbc_root_path,
  gunbc_host_ctrl_checkout_path,
  gunbc_dsl_root_submodule_path,
  gunbc_fleet_pinned_binary_registry,
  gunbc_ctrl_read_pin_script,
  gunbc_ctrl_green_place_marker_path,
  gunbc_ctrl_green_place_marker_pin_prefix,
  gunbc_ctrl_green_place_marker_ts_prefix,
  gunbc_ctrl_quiescent_reload_hook,
  gunbc_spawn_retry_backstop_cadence,
  gunbc_process_effective_converged,
  gunbc_green_place_marker_satisfied,
  gunbc_sha_triple_coherent,
  converge_apply_mode_label,
  converge_no_op_policy_label,
  gunbc_pinned_noop_policy,
  gunbc_pinned_noop_satisfied,
  FreshStandup,
  ExistingHostQuiescentReload,
  ProcessEffective,
  PinCoherentAndGreenPlaceMarker,
  gunbc_apply_mode_for_host,
  converge_verdict,
  converge_verdict_label,
  fleet_converge_policy_from,
  fleet_converge_policy,
}
import extdeps.ctrl.gunbc_pin { gunbc_pin_match }
import gunbc.fleet_intent_network { operator_host_srv1, operator_host_srv2, operator_host_srv3 }
import gunbc.fleet_converge_emit {
  expected_fleet_converge_sh,
  fleet_converge_sh_for,
  fleet_converge_drifted,
}

fn fixture_slot_memory(max_bytes: Int) -> RunnerSlotMemoryContract {
  RunnerSlotMemoryContract {
    memory_max: byte_size(max_bytes),
    memory_high: gunbc_runner_slot_memory_contract.memory_high,
    memory_swap_max: gunbc_runner_slot_memory_contract.memory_swap_max,
  }
}

fn fixture_runner_host() -> RunnerHostDeployment {
  RunnerHostDeployment {
    identity: "srv1",
    runner_count: 7,
    runner_slice_cap: byte_size(70391285350),
    slot_memory: fixture_slot_memory(max_bytes: 30000000000),
    build_tokens: hardware_thread_count(count: 12),
    runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
    workload_class: BatchLatencyTolerant,
  }
}

fn fixture_sound_plan() -> RunnerDeploymentPlan {
  PlanDerived { hosts: [fixture_runner_host()], fleet_concurrent_runs: 7 }
}

fn fixture_regime2_mode() -> SessionReservationMode {
  Regime2AggregateOomd {
    oomd_eviction_ceiling: byte_size(10737418240),
    session_concurrency: 16,
    aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(21474836480) },
  }
}

fn fixture_sound_policy() -> ConvergePolicy {
  fleet_converge_policy_from(plan: fixture_sound_plan(), mode: fixture_regime2_mode())
}

fn fixture_sound_sh() -> String {
  fleet_converge_sh_for(policy: fixture_sound_policy())
}

fn has(s: String, p: String) -> Bool {
  string_contains(s: s, pattern: p)
}

fn witness_live_converge_is_conservation_sound() -> Bool {
  let slice = to_string(byte_size_count(b: gunbc_runner_slice_cap))
  let sh = expected_fleet_converge_sh()
  !has(s: sh, p: "fleet-converge UNSOUND:")
    && has(s: sh, p: "converge-receipt")
    && has(s: sh, p: concat("converge_slice_property \"srv1\" \"runner\" \"runner_slice_cap_bytes\" \"system-actions-runner.slice\" \"MemoryMax\" \"", concat(slice, concat("\" \"", concat(slice, concat("\" \"", concat(slice, "\"")))))))
    && has(s: sh, p: "converge_per_slot_cap \"srv1\" \"runner\" \"per_slot_memory_max_bytes\" \"/etc/systemd/system/actions-runner@.service.d/20-fleet-width.conf\" \"actions-runner@srv1-*.service\" \"MemoryMax\" \"25769803776\"")
    && has(s: sh, p: "converge_per_slot_cap \"srv1\" \"runner\" \"per_slot_memory_swap_max_bytes\" \"/etc/systemd/system/actions-runner@.service.d/30-fleet-swap.conf\" \"actions-runner@srv1-*.service\" \"MemorySwapMax\" \"8589934592\"")
    && has(s: sh, p: "converge_per_slot_cap \"srv1\" \"runner\" \"per_slot_memory_high_bytes\" \"/etc/systemd/system/actions-runner@.service.d/40-fleet-high.conf\" \"actions-runner@srv1-*.service\" \"MemoryHigh\" \"15032385536\"")
    && has(s: sh, p: "converge_runner_width \"srv1\" \"runner\" \"runner_count\" \"actions-runner@srv1-*.service\" \"10\"")
    && has(s: sh, p: "host_begin \"srv3\"")
    && has(s: sh, p: concat("converge_gunbc_pinned_tree \"srv3\" \"gunbc\" \"pinned_tree_sha\" \"fresh_standup\""))
    && has(s: sh, p: "converge_runner_width \"srv3\" \"runner\" \"runner_count\" \"actions-runner@srv3-*.service\" \"10\"")
}

fn witness_drift_red_receipt() -> Bool {
  !fleet_converge_drifted(committed: expected_fleet_converge_sh())
    && fleet_converge_drifted(committed: concat(expected_fleet_converge_sh(), "x"))
}

fn witness_sound_emits_header_and_helpers() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "#!/usr/bin/env bash")
    && has(s: sh, p: "set -euo pipefail")
    && has(s: sh, p: "emit_receipt()")
    && has(s: sh, p: "decide_verdict()")
    && has(s: sh, p: "exit \"$host_failed\"")
    && has(s: sh, p: "printf 'converge-receipt host=%s slice=%s knob=%s desired=%s effective=%s verdict=%s")
    && has(s: sh, p: "printf 'converge-receipt host=%s applied=%s drifted=%s verdict=%s")
}

fn witness_sound_emits_runner_knobs() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "converge_slice_property \"srv1\" \"runner\" \"runner_slice_cap_bytes\" \"system-actions-runner.slice\" \"MemoryMax\" \"70391285350\" \"70391285350\" \"70391285350\"")
    && has(s: sh, p: "converge_per_slot_cap \"srv1\" \"runner\" \"per_slot_memory_max_bytes\" \"/etc/systemd/system/actions-runner@.service.d/20-fleet-width.conf\" \"actions-runner@srv1-*.service\" \"MemoryMax\" \"30000000000\"")
    && has(s: sh, p: "converge_per_slot_cap \"srv1\" \"runner\" \"per_slot_memory_swap_max_bytes\" \"/etc/systemd/system/actions-runner@.service.d/30-fleet-swap.conf\" \"actions-runner@srv1-*.service\" \"MemorySwapMax\" \"8589934592\"")
    && has(s: sh, p: "converge_runner_width \"srv1\" \"runner\" \"runner_count\" \"actions-runner@srv1-*.service\" \"7\"")
}

fn witness_fold_cpu_weight_and_build_tokens_as_rows() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "converge_slice_property \"srv1\" \"runner\" \"cpu_weight\" \"system-actions-runner.slice\" \"CPUWeight\" \"100\" \"100\" \"100\"")
    && has(s: sh, p: "converge_slice_property \"srv1\" \"sessions\" \"cpu_weight\" \"sessions.slice\" \"CPUWeight\" \"1000\" \"1000\" \"1000\"")
    && has(s: sh, p: "converge_jobserver_tokens \"srv1\" \"runner\" \"build_tokens\" \"/etc/default/ctrl-jobserver\" \"CTRL_JOBSERVER_TOKENS\" \"ctrl-jobserver.service\" \"12\"")
}

fn last_runner_knob_name(knobs: List<ConvergeKnob>) -> String {
  fold(knobs, init: "", f: (acc, k) => match k.slice {
    GunbcSlice => acc
    RunnerSlice => k.name
    SessionsSlice => acc
  })
}

fn witness_caps_before_widen_order() -> Bool {
  match fixture_sound_policy() {
    ConvergePolicyDerived { hosts: hosts } =>
      hosts.length() > 0 && all(hosts, h => last_runner_knob_name(knobs: h.knobs) == "runner_count")
    ConvergePolicyUnsound { reason: _ } => false
  }
}

fn witness_per_session_is_verify_only() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "converge_verify_only_cap \"srv1\" \"sessions\" \"per_session_max_bytes\" \"sessions.slice\" \"MemoryMax\" \"10737418240\"")
    && has(s: sh, p: "CARRY+VERIFY ONLY: NEVER set-property")
}

fn witness_oom_pressure_kill_desired_true() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "converge_slice_property \"srv1\" \"sessions\" \"oom_pressure_kill\" \"sessions.slice\" \"ManagedOOMMemoryPressure\" \"kill\" \"kill\" \"true\"")
    && has(s: sh, p: "converge_slice_property \"srv1\" \"sessions\" \"oom_pressure_limit_pct\" \"sessions.slice\" \"ManagedOOMMemoryPressureLimit\" \"60%\" \"2576980377\" \"60\"")
    && has(s: sh, p: "converge_slice_property \"srv1\" \"sessions\" \"slice_max_bytes\" \"sessions.slice\" \"MemoryMax\" \"21474836480\" \"21474836480\" \"21474836480\"")
}

fn vlabel(effective: String, expected: String) -> String {
  converge_verdict_label(v: converge_verdict(effective: effective, expected: expected))
}

fn witness_verdict_discriminating() -> Bool {
  vlabel(effective: "kill", expected: "kill") == "converged"
    && vlabel(effective: "auto", expected: "kill") == "drifted"
    && vlabel(effective: "", expected: "kill") == "absent"
    && vlabel(effective: "70391285350", expected: "70391285350") == "converged"
    && vlabel(effective: "123", expected: "70391285350") == "drifted"
}

fn witness_emitted_bash_realizes_verdict() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "if [ -z \"$1\" ]; then verdict=absent")
    && has(s: sh, p: "elif [ \"$1\" = \"$2\" ]; then verdict=converged")
    && has(s: sh, p: "else verdict=drifted; fi")
}

fn witness_drift_perturbed_desired_flips_emit() -> Bool {
  let perturbed = PlanDerived {
    hosts: [RunnerHostDeployment {
      identity: "srv1",
      runner_count: 99,
      runner_slice_cap: byte_size(70391285350),
      slot_memory: fixture_slot_memory(max_bytes: 30000000000),
      build_tokens: hardware_thread_count(count: 12),
      runner: SelfHosted { labels: ["self-hosted"] },
      workload_class: BatchLatencyTolerant,
    }],
    fleet_concurrent_runs: 99,
  }
  let perturbed_sh = fleet_converge_sh_for(policy: fleet_converge_policy_from(plan: perturbed, mode: fixture_regime2_mode()))
  !(perturbed_sh == fixture_sound_sh())
    && has(s: perturbed_sh, p: "converge_runner_width \"srv1\" \"runner\" \"runner_count\" \"actions-runner@srv1-*.service\" \"99\"")
}

fn witness_gunbc_pinned_tree_emitted() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "converge_gunbc_pinned_tree()")
    && has(s: sh, p: "converge_read_gunbc_host_pin()")
    && has(s: sh, p: "converge_read_ctrl_gunbc_pin()")
    && has(s: sh, p: "converge_dashboard_process_pin()")
    && has(s: sh, p: "converge_green_place_marker_ok()")
    && has(s: sh, p: "converge_invoke_quiescent_reload()")
    && has(s: sh, p: "--gunbc-root")
    && has(s: sh, p: "--target-sha")
    && has(s: sh, p: "--dsl-mode")
    && has(s: sh, p: "--ctrl")
    && has(s: sh, p: "grep -Eo '[0-9a-f]{40}'")
    && has(s: sh, p: "desired_pin=\"$ctrl_pin\"")
    && has(s: sh, p: "[ -n \"$process_pin\" ] && [ \"$process_pin\" = \"$ctrl_pin\" ]")
    && !has(s: sh, p: "[ -z \"$process_pin\" ] ||")
    && has(s: sh, p: "skip_process_pin_coherent_and_marker")
    && has(s: sh, p: "quiescent-window restart")
    && has(s: sh, p: "spawn-retry backstop")
    && has(s: sh, p: "converge_resolve_live_binary_root()")
    && has(s: sh, p: "emit_gunbc_pinned_detail()")
    && has(s: sh, p: "binary_dsl_sha_skew")
    && has(s: sh, p: "gunbc-pin-quiescent-reload.mjs")
    && has(s: sh, p: concat("\"", gunbc_root_env_key, "\""))
    && has(s: sh, p: concat("\"", gunbc_host_gunbc_root_path, "\""))
    && has(s: sh, p: "defer_submodule")
    && has(s: sh, p: concat("\"", gunbc_dsl_root_submodule_path, "\""))
    && has(s: sh, p: "existing_host_quiescent")
    && !has(s: sh, p: "53e066417e00ee56deb084ea75a969a7f3f96592")
    && has(s: sh, p: gunbc_fleet_pinned_binary_registry)
    && has(s: sh, p: gunbc_ctrl_read_pin_script)
    && has(s: sh, p: gunbc_ctrl_green_place_marker_path)
    && has(s: sh, p: gunbc_ctrl_green_place_marker_pin_prefix)
    && has(s: sh, p: "first_green_at=")
}

fn witness_gunbc_apply_mode_derives_from_lifecycle() -> Bool {
  converge_apply_mode_label(m: gunbc_apply_mode_for_host(host: operator_host_srv1)) == "existing_host_quiescent"
    && converge_apply_mode_label(m: gunbc_apply_mode_for_host(host: operator_host_srv2)) == "existing_host_quiescent"
    && converge_apply_mode_label(m: gunbc_apply_mode_for_host(host: operator_host_srv3)) == "fresh_standup"
}

fn witness_gunbc_noop_predicate_process_and_green_place() -> Bool {
  let sha = "53e066417e00ee56deb084ea75a969a7f3f96592"
  let marker_line = concat(concat("pin=", sha), " first_green_at=2026-06-29T15:00:00Z")
  gunbc_sha_triple_coherent(binary_pin: sha, dsl_pin: sha, ctrl_pin: sha)
    && gunbc_pinned_noop_satisfied(
      binary_pin: sha,
      dsl_pin: sha,
      ctrl_pin: sha,
      process_pin: sha,
      marker_line: marker_line,
      marker_pin: sha,
    )
    && !gunbc_pinned_noop_satisfied(
      binary_pin: sha,
      dsl_pin: sha,
      ctrl_pin: sha,
      process_pin: "",
      marker_line: marker_line,
      marker_pin: sha,
    )
    && !gunbc_green_place_marker_satisfied(marker_line: "pin=deadbeef", marker_pin: "deadbeef", desired_pin: sha)
    && converge_no_op_policy_label(p: gunbc_pinned_noop_policy()) == "skip_process_pin_coherent_and_marker"
    && gunbc_process_effective_converged(process_pin: sha, ctrl_pin: sha)
    && second_count(s: gunbc_spawn_retry_backstop_cadence) == 600
    && gunbc_pinned_tree_desired_label == "ctrl:third_party/gunbc"
}

fn first_host_knob_name(knobs: List<ConvergeKnob>) -> String {
  knobs.first().name
}

fn witness_gunbc_pinned_tree_runs_first() -> Bool {
  match fixture_sound_policy() {
    ConvergePolicyDerived { hosts: hosts } =>
      hosts.length() > 0 && all(hosts, h => first_host_knob_name(knobs: h.knobs) == "pinned_tree_sha")
    ConvergePolicyUnsound { reason: _ } => false
  }
}

fn witness_sessions_membership_line_emitted() -> Bool {
  let sh = fixture_sound_sh()
  has(s: sh, p: "emit_sessions_membership \"srv1\" \"/sys/fs/cgroup/sessions.slice\" \"/sys/fs/cgroup/system.slice\"")
    && has(s: sh, p: "printf 'converge-receipt host=%s slice=sessions sessions_in_slice=%s sessions_legacy_flat=%s verdict=%s")
    && has(s: sh, p: "if [ \"$in_slice\" -gt 0 ]; then verdict=converged; else verdict=absent; fi")
    && has(s: sh, p: "ls -d \"$2\"/docker-*.scope 2>/dev/null | wc -l | tr -d ' ' || true")
}

test fn fleet_converge_emit_holds() -> Bool {
  witness_live_converge_is_conservation_sound()
    && witness_drift_red_receipt()
    && witness_sound_emits_header_and_helpers()
    && witness_sound_emits_runner_knobs()
    && witness_fold_cpu_weight_and_build_tokens_as_rows()
    && witness_caps_before_widen_order()
    && witness_per_session_is_verify_only()
    && witness_oom_pressure_kill_desired_true()
    && witness_verdict_discriminating()
    && witness_emitted_bash_realizes_verdict()
    && witness_drift_perturbed_desired_flips_emit()
    && witness_gunbc_pinned_tree_emitted()
    && witness_gunbc_noop_predicate_process_and_green_place()
    && witness_gunbc_apply_mode_derives_from_lifecycle()
    && witness_gunbc_pinned_tree_runs_first()
    && witness_sessions_membership_line_emitted()
}
