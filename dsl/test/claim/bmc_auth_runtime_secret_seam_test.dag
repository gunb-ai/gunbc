module test.claim.bmc_auth_runtime_secret_seam

import std.logic { Bool }
import std.types { Secret }
import std.bytes { utf8_encode_bytes }
import extdeps.bmc.openbmc { openbmc_factory_login }
import extdeps.cloud.gcp.secret_manager { utf8_secret_from_access_payload }

fn redfish_basic_auth_password(password: Secret) -> Secret {
  password
}

test fn factory_published_password_promotes_to_basic_auth_secret() -> Bool {
  redfish_basic_auth_password(password: openbmc_factory_login.published_password as Secret) == "0penBmc"
}

test fn gcp_access_payload_produces_basic_auth_secret() -> Bool {
  redfish_basic_auth_password(
    password: utf8_secret_from_access_payload(payload: utf8_encode_bytes(s: "bmc-srv3-admin-rotated"))
  ) == "bmc-srv3-admin-rotated"
}
