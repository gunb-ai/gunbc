module test.claim.runner_placement_witness

import gunbc.ci_runner_placement {
  RunnerDeploymentPlan,
  PlanDerived,
  PlanUnsound,
  RunnerHostDeployment,
  runner_deployment_plan,
  SessionSliceResolution,
  SessionSliceResolved,
  SessionSliceUnresolved,
  resolve_session_slice,
  SessionReservationPlan,
  SessionReservationDerived,
  SessionReservationUnsound,
  session_reservation_plan,
  SessionHostReservation,
  RunnersPerHostResolution,
  RunnersPerHostDerived,
  RunnersPerHostUnsound,
  effective_runners_per_host,
  OperatingPointRow,
  evaluate_operating_point,
  operating_curve,
  samples_covered,
  WorkloadClass,
  BatchLatencyTolerant,
  InteractiveLatencySensitive,
  workload_class_cpu_weight,
}
import gunbc.fleet_host_budget {
  declared_runner_count,
  gunbc_runner_pool_budget,
  gunbc_runner_slot_memory_contract,
}
import gunbc.ci_floor_measurement {
  gunbc_ci_runner_cgroup_memory_cap,
}
import gunbc.ci_floor_measurement {
  SessionOperatingPointSet,
  SessionAggregateMeasured,
  SessionAggregateUnmeasured,
  OomdEnforced,
  OomdUnverified,
  Regime1WorstCase,
  Regime2AggregateOomd,
  SessionReservationModeUnset,
}
import gunbc.ci_fleet { fleet_intent_offers }
import gunbc.runner_deploy_emit {
  expected_runner_deploy_manifest,
  expected_runner_deploy_manifest_json,
  runner_deploy_drifted,
  manifest_host_doc,
  manifest_host_fields,
  session_host_doc,
  runner_deploy_protocol,
}
import std.languages { json_record_knobs }
import std.serialize { serialize_record_doc }
import std.layout { render }
import std.measure { byte_size, byte_size_count, hardware_thread_count_value }
import std.types { Bool, Int, List, String }

fn live_plan() -> RunnerDeploymentPlan {
  runner_deployment_plan()
}

fn witness_declared_runner_count_is_ten() -> Bool {
  declared_runner_count() == 10
}

fn witness_live_plan_is_conservation_sound() -> Bool {
  match live_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: total } =>
      hosts.length() == fleet_intent_offers.length()
        && total == declared_runner_count() * fleet_intent_offers.length()
        && all(hosts, h =>
            h.runner_count == declared_runner_count()
              && byte_size_count(b: h.slot_memory.memory_max) == byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)
              && byte_size_count(b: h.runner_slice_cap) == byte_size_count(b: gunbc_runner_pool_budget)
              && hardware_thread_count_value(t: h.build_tokens) > 0
          )
    PlanUnsound { reason: _ } => false
  }
}

fn witness_per_runner_cap_within_runner_pool() -> Bool {
  match live_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && all(hosts, h =>
            h.runner_count * byte_size_count(b: h.slot_memory.memory_max) <= byte_size_count(b: h.runner_slice_cap)
          )
    PlanUnsound { reason: _ } => false
  }
}

fn witness_live_session_plan_fail_closed() -> Bool {
  match session_reservation_plan() {
    SessionReservationUnsound { reason: _ } => true
    SessionReservationDerived { hosts: _, fleet_concurrent_sessions: _, per_session_reservation: _, coverage_count: _, sample_count: _ } => false
  }
}

fn witness_live_effective_runners_derives_ten() -> Bool {
  match effective_runners_per_host() {
    RunnersPerHostDerived { count: c } => c == declared_runner_count()
    RunnersPerHostUnsound { reason: _ } => false
  }
}

fn witness_sound_manifest_line_is_populated() -> Bool {
  match live_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && all(hosts, h => {
            let rendered = render(doc: manifest_host_doc(h: h), proto: runner_deploy_protocol)
            starts_with(s: rendered, prefix: concat(concat("host=", h.identity), " runner_count="))
          })
    PlanUnsound { reason: _ } => false
  }
}

fn witness_regime1_resolves_worst_case_slice() -> Bool {
  match resolve_session_slice(mode: Regime1WorstCase { point: SessionOperatingPointSet { per_session_cap: byte_size(10000000000), session_concurrency: 4 } }, oomd: OomdEnforced) {
    SessionSliceResolved { bytes: b, per_session_cap: c, concurrency: n } =>
      byte_size_count(b: b) == 40000000000 && byte_size_count(b: c) == 10000000000 && n == 4
    SessionSliceUnresolved { reason: _ } => false
  }
}

fn witness_mode_unset_is_unresolved() -> Bool {
  match resolve_session_slice(mode: SessionReservationModeUnset, oomd: OomdEnforced) {
    SessionSliceUnresolved { reason: _ } => true
    SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_oomd_unverified_is_unresolved() -> Bool {
  match resolve_session_slice(mode: Regime2AggregateOomd {
    oomd_eviction_ceiling: byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(15000000000) },
  }, oomd: OomdUnverified) {
    SessionSliceUnresolved { reason: _ } => true
    SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_aggregate_unmeasured_is_unresolved() -> Bool {
  match resolve_session_slice(mode: Regime2AggregateOomd {
    oomd_eviction_ceiling: byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: SessionAggregateUnmeasured,
  }, oomd: OomdEnforced) {
    SessionSliceUnresolved { reason: _ } => true
    SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_reserves_aggregate_not_product() -> Bool {
  match resolve_session_slice(mode: Regime2AggregateOomd {
    oomd_eviction_ceiling: byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(15000000000) },
  }, oomd: OomdEnforced) {
    SessionSliceResolved { bytes: b, per_session_cap: c, concurrency: n } =>
      byte_size_count(b: b) == 15000000000 && byte_size_count(b: c) == 8000000000 && n == 16
    SessionSliceUnresolved { reason: _ } => false
  }
}

fn witness_coverage_is_distribution_grounded() -> Bool {
  samples_covered(cap: byte_size(0)) == 0
    && samples_covered(cap: byte_size(2211908157)) == 6
    && samples_covered(cap: byte_size(8879844884)) == 13
}

fn witness_curve_coverage_monotone_in_cap() -> Bool {
  let lo = evaluate_operating_point(cap: byte_size(2000000000), n: 6)
  let hi = evaluate_operating_point(cap: byte_size(8000000000), n: 6)
  hi.coverage_count >= lo.coverage_count
    && byte_size_count(b: hi.sessions_slice) >= byte_size_count(b: lo.sessions_slice)
}

fn witness_curve_has_full_coverage_option() -> Bool {
  any(operating_curve(), r => r.coverage_count == r.sample_count)
}

fn witness_manifest_drift_red_receipt() -> Bool {
  !runner_deploy_drifted(committed: expected_runner_deploy_manifest())
    && runner_deploy_drifted(committed: concat(expected_runner_deploy_manifest(), "x"))
}

fn witness_session_cpu_weight_exceeds_runner_cpu_weight() -> Bool {
  workload_class_cpu_weight(wc: InteractiveLatencySensitive) > workload_class_cpu_weight(wc: BatchLatencyTolerant)
}

fn witness_runner_manifest_line_contains_cpu_weight() -> Bool {
  match live_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && all(hosts, h => string_contains(s: render(doc: manifest_host_doc(h: h), proto: runner_deploy_protocol), pattern: " cpu_weight=100"))
    PlanUnsound { reason: _ } => false
  }
}

fn witness_runner_and_session_cpu_weights_are_distinct() -> Bool {
  workload_class_cpu_weight(wc: BatchLatencyTolerant) != workload_class_cpu_weight(wc: InteractiveLatencySensitive)
}

fn witness_session_slice_line_emits_cpu_weight() -> Bool {
  let rendered = expected_runner_deploy_manifest()
  string_contains(s: rendered, pattern: "session-slice host=")
    && string_contains(s: rendered, pattern: " cpu_weight=1000")
    && string_contains(s: rendered, pattern: " slice_max_bytes=")
    && string_contains(s: rendered, pattern: " per_session_max_bytes=")
    && string_contains(s: rendered, pattern: " oom_pressure_kill=true")
    && string_contains(s: rendered, pattern: " oom_pressure_limit_pct=60")
}

fn witness_session_reservation_line_has_no_cpu_weight() -> Bool {
  let fixture = SessionHostReservation {
    identity: "fixture-host",
    session_count: 4,
    per_session_reservation: byte_size(4294967296),
    workload_class: InteractiveLatencySensitive,
  }
  !(string_contains(s: render(doc: session_host_doc(h: fixture), proto: runner_deploy_protocol), pattern: "cpu_weight"))
}

fn witness_real_manifest_fields_drive_both_formats() -> Bool {
  match runner_deployment_plan() {
    PlanUnsound { reason: _ } => false
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0 &&
      all(hosts, h => {
        let text_out = render(doc: manifest_host_doc(h: h), proto: runner_deploy_protocol)
        let json_out = render(doc: serialize_record_doc(knobs: json_record_knobs, fields: manifest_host_fields(h: h)), proto: runner_deploy_protocol)
        text_out != json_out &&
          string_contains(s: text_out, pattern: concat("host=", h.identity)) &&
          string_contains(s: json_out, pattern: concat("\"host\": \"", h.identity))
      })
  }
}

fn witness_manifest_json_entry_point_produces_json_format() -> Bool {
  let full = expected_runner_deploy_manifest_json()
  string_contains(s: full, pattern: "runner-deploy {") &&
    string_contains(s: full, pattern: "\"host\": \"") &&
    string_contains(s: full, pattern: "\"cpu_weight\": \"")
}

test fn runner_placement_holds() -> Bool {
  witness_declared_runner_count_is_ten()
    && witness_live_plan_is_conservation_sound()
    && witness_per_runner_cap_within_runner_pool()
    && witness_live_session_plan_fail_closed()
    && witness_live_effective_runners_derives_ten()
    && witness_sound_manifest_line_is_populated()
    && witness_regime1_resolves_worst_case_slice()
    && witness_mode_unset_is_unresolved()
    && witness_regime2_oomd_unverified_is_unresolved()
    && witness_regime2_aggregate_unmeasured_is_unresolved()
    && witness_regime2_reserves_aggregate_not_product()
    && witness_coverage_is_distribution_grounded()
    && witness_curve_coverage_monotone_in_cap()
    && witness_curve_has_full_coverage_option()
    && witness_manifest_drift_red_receipt()
    && witness_session_cpu_weight_exceeds_runner_cpu_weight()
    && witness_runner_manifest_line_contains_cpu_weight()
    && witness_runner_and_session_cpu_weights_are_distinct()
    && witness_session_slice_line_emits_cpu_weight()
    && witness_session_reservation_line_has_no_cpu_weight()
    && witness_real_manifest_fields_drive_both_formats()
    && witness_manifest_json_entry_point_produces_json_format()
}
