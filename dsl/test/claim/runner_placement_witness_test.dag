module test.claim.runner_placement_witness

import gunbc.ci_runner_placement {
  RunnerDeploymentPlan,
  PlanDerived,
  PlanUnsound,
  runner_deployment_plan,
  runner_deployment_plan_for,
  host_runner_count,
}
import gunbc.runner_deploy_emit { expected_runner_deploy_manifest, runner_deploy_drifted }
import gunbc.ci_floor_measurement {
  CiJobPeak,
  JobCgroupPeakMeasured,
  JobCgroupPeakUnmeasured,
  HostFixedOverhead,
  HostFixedOverheadMeasured,
  HostFixedOverheadUnmeasured,
}
import gunbc.operator_fleet { operator_fleet_offers, srv1_offer }
import std.realization_width { memory_effective_budget }
import std.measure { byte_size, byte_size_count }
import std.types { Bool, Int, List }
import product.compute_fabric { compute_host_ram_bytes_total }

fn is_unsound(plan: RunnerDeploymentPlan) -> Bool {
  match plan {
    PlanUnsound { reason: _ } => true
    PlanDerived { hosts: _, fleet_concurrent_runs: _ } => false
  }
}

fn fitting_job_mix() -> List<CiJobPeak> {
  [
    CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(40000000000) } },
    CiJobPeak { job: "rust_tests", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(30000000000) } },
  ]
}

fn oversized_job_mix() -> List<CiJobPeak> {
  [CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(200000000000) } }]
}

fn zero_job_mix() -> List<CiJobPeak> {
  [CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(0) } }]
}

fn partial_unmeasured_mix() -> List<CiJobPeak> {
  [
    CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(40000000000) } },
    CiJobPeak { job: "rust_tests", peak: JobCgroupPeakUnmeasured },
  ]
}

fn fitting_overhead() -> HostFixedOverhead {
  HostFixedOverheadMeasured { bytes: byte_size(8000000000) }
}

fn huge_overhead() -> HostFixedOverhead {
  HostFixedOverheadMeasured { bytes: byte_size(130000000000) }
}

fn witness_live_carrier_measured_derives_plan() -> Bool {
  match runner_deployment_plan() {
    PlanDerived { hosts: _, fleet_concurrent_runs: total } => total >= 1
    PlanUnsound { reason: _ } => false
  }
}

fn witness_measured_mix_derives_capacity() -> Bool {
  match runner_deployment_plan_for(job_peaks: fitting_job_mix(), overhead: fitting_overhead(), offers: operator_fleet_offers) {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: total } =>
      hosts.length() == 2 && total >= 2
    PlanUnsound { reason: _ } => false
  }
}

fn witness_derived_count_respects_host_budget() -> Bool {
  let peak = 40000000000
  let reserved = byte_size(8000000000)
  let count = host_runner_count(offer: srv1_offer, run_unit_peak: byte_size(peak), reserved: reserved)
  let effective = byte_size_count(
    b: memory_effective_budget(budget: compute_host_ram_bytes_total(host: srv1_offer.supply.physical), reserved: reserved)
  )
  count * peak <= effective && count >= 1
}

fn witness_over_commit_is_refused() -> Bool {
  is_unsound(plan: runner_deployment_plan_for(job_peaks: oversized_job_mix(), overhead: fitting_overhead(), offers: operator_fleet_offers))
}

fn witness_zero_peak_is_refused() -> Bool {
  is_unsound(plan: runner_deployment_plan_for(job_peaks: zero_job_mix(), overhead: fitting_overhead(), offers: operator_fleet_offers))
}

fn witness_partial_unmeasured_is_refused() -> Bool {
  is_unsound(plan: runner_deployment_plan_for(job_peaks: partial_unmeasured_mix(), overhead: fitting_overhead(), offers: operator_fleet_offers))
}

fn witness_overhead_unmeasured_is_refused() -> Bool {
  is_unsound(plan: runner_deployment_plan_for(job_peaks: fitting_job_mix(), overhead: HostFixedOverheadUnmeasured, offers: operator_fleet_offers))
}

fn witness_huge_overhead_is_refused() -> Bool {
  is_unsound(plan: runner_deployment_plan_for(job_peaks: fitting_job_mix(), overhead: huge_overhead(), offers: operator_fleet_offers))
}

fn witness_manifest_drift_red_receipt() -> Bool {
  !runner_deploy_drifted(committed: expected_runner_deploy_manifest())
    && runner_deploy_drifted(committed: concat(expected_runner_deploy_manifest(), "x"))
}

test fn runner_placement_holds() -> Bool {
  witness_live_carrier_measured_derives_plan()
    && witness_measured_mix_derives_capacity()
    && witness_derived_count_respects_host_budget()
    && witness_over_commit_is_refused()
    && witness_zero_peak_is_refused()
    && witness_partial_unmeasured_is_refused()
    && witness_overhead_unmeasured_is_refused()
    && witness_huge_overhead_is_refused()
    && witness_manifest_drift_red_receipt()
}
