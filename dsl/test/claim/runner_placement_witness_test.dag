fn fixture_cfg() -> CtrlJobserverConfig {
  CtrlJobserverConfig {
    margin: hardware_thread_count(count: 8),
    mem_reserve: byte_size(8589934592),
    mib_per_job: byte_size(1879048192),
  }
}

fn fixture_citation() -> CtrlJobserverCitation {
  CtrlJobserverCited { config: fixture_cfg(), provenance: "fixture: parent-supplied installer knobs" }
}

fn fitting_headroom() -> HeadroomPolicy {
  HeadroomSet { bytes: byte_size(8589934592) }
}

fn fitting_overhead() -> HostFixedOverhead {
  HostFixedOverheadMeasured { bytes: byte_size(17179869184) }
}

fn fitting_session_mode() -> SessionReservationMode {
  Regime1WorstCase { point: SessionOperatingPointSet { per_session_cap: byte_size(4294967296), session_concurrency: 6 } }
}

fn fitting_session_slice_bytes() -> ByteSize {
  byte_size(25769803776)
}

fn bigger_session_mode() -> SessionReservationMode {
  Regime1WorstCase { point: SessionOperatingPointSet { per_session_cap: byte_size(8589934592), session_concurrency: 6 } }
}

fn fitting_job_mix() -> List<CiJobPeak> {
  [
    CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(24000000000) } },
    CiJobPeak { job: "rust_tests", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(18000000000) } },
  ]
}

fn oversized_job_mix() -> List<CiJobPeak> {
  [CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(200000000000) } }]
}

fn zero_job_mix() -> List<CiJobPeak> {
  [CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(0) } }]
}

fn partial_unmeasured_mix() -> List<CiJobPeak> {
  [
    CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(24000000000) } },
    CiJobPeak { job: "rust_tests", peak: JobCgroupPeakUnmeasured },
  ]
}

fn is_unsound(plan: RunnerDeploymentPlan) -> Bool {
  match plan {
    PlanUnsound { reason: _ } => true
    PlanDerived { hosts: _, fleet_concurrent_runs: _ } => false
  }
}

fn plan_total(plan: RunnerDeploymentPlan) -> Int {
  match plan {
    PlanDerived { hosts: _, fleet_concurrent_runs: total } => total
    PlanUnsound { reason: _ } => 0
  }
}

fn sound_plan(
  enforcement: RunnerSlotEnforcement,
  mode: SessionReservationMode,
  job_peaks: List<CiJobPeak>,
  overhead: HostFixedOverhead,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> RunnerDeploymentPlan {
  runner_deployment_plan_for(
    enforcement: enforcement,
    mode: mode,
    job_peaks: job_peaks,
    overhead: overhead,
    citation: citation,
    policy: policy,
    oomd: oomd,
    offers: fleet_intent_offers
  )
}

fn fully_sound_plan() -> RunnerDeploymentPlan {
  sound_plan(
    enforcement: RunnerSlotEnforced,
    mode: fitting_session_mode(),
    job_peaks: fitting_job_mix(),
    overhead: fitting_overhead(),
    citation: fixture_citation(),
    policy: fitting_headroom(),
    oomd: OomdEnforced
  )
}

fn witness_live_runner_plan_fail_closed() -> Bool {
  is_unsound(plan: runner_deployment_plan())
}

fn witness_live_session_plan_fail_closed() -> Bool {
  match session_reservation_plan() {
    SessionReservationUnsound { reason: _ } => true
    SessionReservationDerived { hosts: _, fleet_concurrent_sessions: _, per_session_reservation: _, coverage_count: _, sample_count: _ } => false
  }
}

fn witness_live_effective_runners_fail_closed() -> Bool {
  match effective_runners_per_host() {
    RunnersPerHostUnsound { reason: _ } => true
    RunnersPerHostDerived { count: _ } => false
  }
}

fn witness_unenforced_fails_closed() -> Bool {
  is_unsound(plan: sound_plan(
    enforcement: RunnerSlotUnenforced { reason: "fixture: cap not live-enforced" },
    mode: fitting_session_mode(),
    job_peaks: fitting_job_mix(),
    overhead: fitting_overhead(),
    citation: fixture_citation(),
    policy: fitting_headroom(),
    oomd: OomdEnforced
  ))
}

fn witness_session_mode_unset_fails_closed() -> Bool {
  is_unsound(plan: sound_plan(
    enforcement: RunnerSlotEnforced,
    mode: SessionReservationModeUnset,
    job_peaks: fitting_job_mix(),
    overhead: fitting_overhead(),
    citation: fixture_citation(),
    policy: fitting_headroom(),
    oomd: OomdEnforced
  ))
}

