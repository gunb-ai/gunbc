fn witness_sound_plan_derives_per_host_capacity() -> Bool {
  match fully_sound_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: total } =>
      hosts.length() == fleet_intent_offers.length()
        && total > 0
        && all(hosts, h =>
            h.runner_count > 0
              && byte_size_count(b: h.per_runner_memory_cap) > 0
              && hardware_thread_count_value(t: h.build_tokens) > 0
          )
    PlanUnsound { reason: _ } => false
  }
}

fn witness_sound_manifest_line_is_populated() -> Bool {
  match fully_sound_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && all(hosts, h =>
            starts_with(manifest_host_text(h: h), prefix: concat(concat("host=", h.identity), " runner_count="))
          )
    PlanUnsound { reason: _ } => false
  }
}

fn witness_count_respects_conserved_runner_slice() -> Bool {
  let mean = byte_size_count(b: gunbc_ci_run_count_divisor)
  match fully_sound_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      all(hosts, h =>
        match fleet_host_plan_for_offer(offer: srv1_offer, overhead: byte_size(17179869184), session_slice: fitting_session_slice_bytes(), citation: fixture_citation(), policy: fitting_headroom(), oomd: OomdEnforced) {
          FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: cap, effective_build_tokens: _, effective_runner_cpu_cap: _, build_step: _ } =>
            h.runner_count * mean <= byte_size_count(b: cap)
              && byte_size_count(b: h.per_runner_memory_cap) <= byte_size_count(b: cap)
              && h.runner_count >= 1
          FleetHostPlanUnsound { reason: _ } => false
        }
      )
    PlanUnsound { reason: _ } => false
  }
}

fn witness_per_runner_cap_is_worst_times_margin() -> Bool {
  let worst = match resolve_run_unit_peak(job_peaks: fitting_job_mix()) {
    JobPeaksResolved { run_unit_peak: w } => byte_size_count(b: w)
    JobPeaksUnresolved { reason: _ } => 0
  }
  let expected = worst * gunbc_ci_runner_unit_cap_safety_margin_num / gunbc_ci_runner_unit_cap_safety_margin_den
  match fully_sound_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && worst > 0
        && all(hosts, h =>
            byte_size_count(b: h.per_runner_memory_cap) == expected
              && byte_size_count(b: h.per_runner_memory_cap) <= byte_size_count(b: h.runner_slice_cap)
          )
    PlanUnsound { reason: _ } => false
  }
}

fn min_runner_count_of(plan: RunnerDeploymentPlan) -> Int {
  match plan {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      fold(hosts, init: 0, f: (acc, h) => if acc == 0 { h.runner_count } else { if h.runner_count < acc { h.runner_count } else { acc } })
    PlanUnsound { reason: _ } => 0
  }
}

fn witness_bigger_session_reservation_fewer_runners() -> Bool {
  let small = sound_plan(enforcement: RunnerSlotEnforced, mode: fitting_session_mode(), job_peaks: fitting_job_mix(), overhead: fitting_overhead(), citation: fixture_citation(), policy: fitting_headroom(), oomd: OomdEnforced)
  let big = sound_plan(enforcement: RunnerSlotEnforced, mode: bigger_session_mode(), job_peaks: fitting_job_mix(), overhead: fitting_overhead(), citation: fixture_citation(), policy: fitting_headroom(), oomd: OomdEnforced)
  !is_unsound(plan: small) && !is_unsound(plan: big) && min_runner_count_of(plan: big) <= min_runner_count_of(plan: small)
}

fn witness_runner_count_memory_term_binds() -> Bool {
  host_runner_count_from_cap(runner_slice_cap: byte_size(96000000000), run_unit_peak: byte_size(24000000000), cpu_cap: hardware_thread_count(count: 120), build_tokens: hardware_thread_count(count: 120)) == 4
}

fn witness_runner_count_cpu_term_binds() -> Bool {
  host_runner_count_from_cap(runner_slice_cap: byte_size(96000000000), run_unit_peak: byte_size(1000000000), cpu_cap: hardware_thread_count(count: 2), build_tokens: hardware_thread_count(count: 120)) == 2
}

fn witness_runner_count_build_token_term_binds() -> Bool {
  host_runner_count_from_cap(runner_slice_cap: byte_size(96000000000), run_unit_peak: byte_size(1000000000), cpu_cap: hardware_thread_count(count: 120), build_tokens: hardware_thread_count(count: 5)) == 5
}

fn witness_runner_count_unfit_is_zero() -> Bool {
  host_runner_count_from_cap(runner_slice_cap: byte_size(1000000000), run_unit_peak: byte_size(24000000000), cpu_cap: hardware_thread_count(count: 120), build_tokens: hardware_thread_count(count: 120)) == 0
}

fn witness_regime1_resolves_worst_case_slice() -> Bool {
  match resolve_session_slice(mode: Regime1WorstCase { point: SessionOperatingPointSet { per_session_cap: byte_size(10000000000), session_concurrency: 4 } }, oomd: OomdEnforced) {
    SessionSliceResolved { bytes: b, per_session_cap: c, concurrency: n } =>
      byte_size_count(b: b) == 40000000000 && byte_size_count(b: c) == 10000000000 && n == 4
    SessionSliceUnresolved { reason: _ } => false
  }
}

fn witness_mode_unset_is_unresolved() -> Bool {
  match resolve_session_slice(mode: SessionReservationModeUnset, oomd: OomdEnforced) {
    SessionSliceUnresolved { reason: _ } => true
    SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_oomd_unverified_is_unresolved() -> Bool {
  match resolve_session_slice(mode: Regime2AggregateOomd {
    oomd_eviction_ceiling: byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(15000000000) },
  }, oomd: OomdUnverified) {
    SessionSliceUnresolved { reason: _ } => true
    SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_aggregate_unmeasured_is_unresolved() -> Bool {
  match resolve_session_slice(mode: Regime2AggregateOomd {
    oomd_eviction_ceiling: byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: SessionAggregateUnmeasured,
  }, oomd: OomdEnforced) {
    SessionSliceUnresolved { reason: _ } => true
    SessionSliceResolved { bytes: _, per_session_cap: _, concurrency: _ } => false
  }
}

fn witness_regime2_reserves_aggregate_not_product() -> Bool {
  match resolve_session_slice(mode: Regime2AggregateOomd {
    oomd_eviction_ceiling: byte_size(8000000000),
    session_concurrency: 16,
    aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(15000000000) },
  }, oomd: OomdEnforced) {
    SessionSliceResolved { bytes: b, per_session_cap: c, concurrency: n } =>
      byte_size_count(b: b) == 15000000000 && byte_size_count(b: c) == 8000000000 && n == 16
    SessionSliceUnresolved { reason: _ } => false
  }
}

fn witness_coverage_is_distribution_grounded() -> Bool {
  samples_covered(cap: byte_size(0)) == 0
    && samples_covered(cap: byte_size(2211908157)) == 6
    && samples_covered(cap: byte_size(8879844884)) == 13
}

fn witness_curve_coverage_monotone_in_cap() -> Bool {
  let lo = evaluate_operating_point(cap: byte_size(2000000000), n: 6)
  let hi = evaluate_operating_point(cap: byte_size(8000000000), n: 6)
  hi.coverage_count >= lo.coverage_count
    && byte_size_count(b: hi.sessions_slice) >= byte_size_count(b: lo.sessions_slice)
}

fn witness_curve_has_full_coverage_option() -> Bool {
  any(operating_curve(), r => r.coverage_count == r.sample_count)
}

fn witness_manifest_drift_red_receipt() -> Bool {
  !runner_deploy_drifted(committed: expected_runner_deploy_manifest())
    && runner_deploy_drifted(committed: concat(expected_runner_deploy_manifest(), "x"))
}

fn witness_session_cpu_weight_exceeds_runner_cpu_weight() -> Bool {
  workload_class_cpu_weight(wc: InteractiveLatencySensitive) > workload_class_cpu_weight(wc: BatchLatencyTolerant)
}

fn witness_runner_manifest_line_contains_cpu_weight() -> Bool {
  match fully_sound_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      hosts.length() > 0
        && all(hosts, h => string_contains(s: manifest_host_text(h: h), pattern: " cpu_weight=100"))
    PlanUnsound { reason: _ } => false
  }
}

fn witness_runner_and_session_cpu_weights_are_distinct() -> Bool {
  workload_class_cpu_weight(wc: BatchLatencyTolerant) != workload_class_cpu_weight(wc: InteractiveLatencySensitive)
}

fn witness_session_slice_line_emits_cpu_weight() -> Bool {
  let rendered = expected_runner_deploy_manifest()
  string_contains(s: rendered, pattern: "session-slice host=")
    && string_contains(s: rendered, pattern: " cpu_weight=1000")
    && string_contains(s: rendered, pattern: " slice_max_bytes=")
    && string_contains(s: rendered, pattern: " per_session_max_bytes=")
    && string_contains(s: rendered, pattern: " oom_pressure_kill=true")
    && string_contains(s: rendered, pattern: " oom_pressure_limit_pct=60")
}

fn witness_session_reservation_line_has_no_cpu_weight() -> Bool {
  let fixture = SessionHostReservation {
    identity: "fixture-host",
    session_count: 4,
    per_session_reservation: byte_size(4294967296),
    workload_class: InteractiveLatencySensitive,
  }
  !(string_contains(s: session_host_text(h: fixture), pattern: "cpu_weight"))
}

test fn runner_placement_holds() -> Bool {
  witness_live_runner_plan_fail_closed()
    && witness_live_session_plan_fail_closed()
    && witness_live_effective_runners_fail_closed()
    && witness_unenforced_fails_closed()
    && witness_session_mode_unset_fails_closed()
    && witness_oomd_unverified_fails_closed()
    && witness_headroom_unset_fails_closed()
    && witness_jobserver_absent_fails_closed()
    && witness_overhead_unmeasured_is_refused()
    && witness_zero_peak_is_refused()
    && witness_partial_unmeasured_is_refused()
    && witness_over_commit_is_refused()
    && witness_sound_plan_derives_per_host_capacity()
    && witness_sound_manifest_line_is_populated()
    && witness_count_respects_conserved_runner_slice()
    && witness_per_runner_cap_is_worst_times_margin()
    && witness_bigger_session_reservation_fewer_runners()
    && witness_runner_count_memory_term_binds()
    && witness_runner_count_cpu_term_binds()
    && witness_runner_count_build_token_term_binds()
    && witness_runner_count_unfit_is_zero()
    && witness_regime1_resolves_worst_case_slice()
    && witness_mode_unset_is_unresolved()
    && witness_regime2_oomd_unverified_is_unresolved()
    && witness_regime2_aggregate_unmeasured_is_unresolved()
    && witness_regime2_reserves_aggregate_not_product()
    && witness_coverage_is_distribution_grounded()
    && witness_curve_coverage_monotone_in_cap()
    && witness_curve_has_full_coverage_option()
    && witness_manifest_drift_red_receipt()
    && witness_session_cpu_weight_exceeds_runner_cpu_weight()
    && witness_runner_manifest_line_contains_cpu_weight()
    && witness_runner_and_session_cpu_weights_are_distinct()
    && witness_session_slice_line_emits_cpu_weight()
    && witness_session_reservation_line_has_no_cpu_weight()
}
