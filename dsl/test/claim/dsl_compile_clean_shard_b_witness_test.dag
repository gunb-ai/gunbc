module test.claim.dsl_compile_clean_shard_b_witness

import tools.dsl_compile_clean_partition {
  compose_compile_clean_shard_verdicts,
  compose_compile_clean_shard_verdicts_as_reduce,
  compile_clean_shard_verdict_from_bool,
  compile_clean_shard_verdict_to_reduce,
  ShardClean,
  ShardFailed,
  witness_empty_compose_is_unknown_reduce
}
import tools.dsl_compile_clean_shard_transport {
  run_shard_compile_verdict,
  run_shard_a_exemplar_compile,
  witness_broken_staged_shard_compile_red,
  shard_a_exemplar_entry_path
}
import tools.dsl_compile_clean_shard_roster {
  compile_clean_sharding_enabled,
  compile_clean_whole_tree_rollback_env,
  compile_clean_shard_roster_has_multiple,
  compile_clean_shard_roster_count,
  witness_shard_roster_derives_from_witness_layer_roots,
  witness_shard_roster_paths_duplicate_free,
  witness_shard_roster_coverage,
  witness_dropped_shard_breaks_coverage,
  compile_clean_shard_entry_paths,
  witness_compose_all_clean_matches_reduce,
  witness_compose_failure_is_fail_closed
}
import std.reducible { verdict_eq, Unknown, Irreducible }
import v2.workflow.ci_floor_plan {
  gunbc_ci_floor_batches,
  witness_floor_batch_one_uses_compile_clean_shards,
  witness_floor_batch_one_has_no_compile_gate_monolith,
  witness_floor_shard_roster_coverage_in_plan,
  witness_floor_dropped_shard_red_control,
  gunbc_ci_floor_compile_clean_shard_count,
  gunbc_ci_floor_schedule_lens_holds
}

fn witness_transport_verdict_bridge_green() -> Bool {
  run_shard_a_exemplar_compile()
    && (run_shard_compile_verdict(entry_rel_path: shard_a_exemplar_entry_path) == ShardClean)
}

fn witness_transport_verdict_bridge_red_on_failure() -> Bool {
  let v = compile_clean_shard_verdict_from_bool(
    entry_path: shard_a_exemplar_entry_path,
    ok: false
  )
  v == ShardFailed { entry_path: shard_a_exemplar_entry_path }
}

fn witness_broken_module_shard_reds_composed_gate() -> Bool {
  witness_broken_staged_shard_compile_red()
    && (compose_compile_clean_shard_verdicts(
      verdicts: [ShardClean, ShardFailed { entry_path: "staged/broken.dag" }]
    ) != ShardClean)
}

fn witness_plan_shard_count_matches_roster() -> Bool {
  gunbc_ci_floor_compile_clean_shard_count() == compile_clean_shard_roster_count()
}

test fn compile_clean_shard_b_floor_plan_enrollment() -> Bool {
  compile_clean_sharding_enabled()
    && witness_floor_batch_one_uses_compile_clean_shards()
    && witness_floor_batch_one_has_no_compile_gate_monolith()
    && witness_plan_shard_count_matches_roster()
    && witness_floor_shard_roster_coverage_in_plan()
    && gunbc_ci_floor_schedule_lens_holds()
}

test fn compile_clean_shard_b_verdict_algebra_and_transport() -> Bool {
  witness_transport_verdict_bridge_green()
    && witness_transport_verdict_bridge_red_on_failure()
    && witness_broken_module_shard_reds_composed_gate()
    && witness_compose_all_clean_matches_reduce()
    && witness_compose_failure_is_fail_closed()
    && witness_empty_compose_is_unknown_reduce()
}

test fn compile_clean_shard_b_roster_and_coverage_red() -> Bool {
  witness_shard_roster_derives_from_witness_layer_roots()
    && witness_shard_roster_paths_duplicate_free()
    && compile_clean_shard_roster_has_multiple()
    && witness_dropped_shard_breaks_coverage(
      full: compile_clean_shard_entry_paths(),
      plan_paths: compile_clean_shard_entry_paths()
    )
    && witness_floor_dropped_shard_red_control()
}

test fn compile_clean_whole_tree_rollback_env_is_named() -> Bool {
  compile_clean_whole_tree_rollback_env == "GUNBC_CI_COMPILE_CLEAN_WHOLE_TREE"
}
