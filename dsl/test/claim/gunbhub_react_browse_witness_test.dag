// dsl/test/claim/gunbhub_react_browse_witness_test.dag
//
// gunbhub R1 browse-page receipt: structurally compose a repo-browse page as a
// ReactMarkupNode tree and serialize through canonical std.markup.Fragment.
// Page composition authority: gunbc.gunbhub_serve (M2 serve surface).

module test.claim.gunbhub_react_browse_witness

import gunbc.gunbhub_serve { gunbhub_browse_page }
import std.react_markup {
  EmitOk,
  EmitRejected,
  serialize_react_markup,
}

fn browse_page_html() -> String {
  match serialize_react_markup(node: gunbhub_browse_page()) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

data gunbhub_browse_html: String = browse_page_html()

fn gunbhub_browse_page_serializes_holds() -> Bool {
  gunbhub_browse_html ==
    "<div><h1>gunbc</h1><ul><li><a>dsl</a></li><li><a>src</a></li><li><a>ROADMAP.md</a></li></ul></div>"
}

test fn gunbhub_browse_keystone_holds() -> Bool {
  gunbhub_browse_page_serializes_holds()
}
