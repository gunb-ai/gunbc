module test.claim.realization_witness

import std.effects {
  ReadEffect, CreateEffect, PostAlways,
  UpsertEffect, DeleteEffect, PathParam, InputField
}
import std.realization {
  Unknown, Dependent, Independent,
  independence_from_effect_shapes,
}

fn witness_unknown_independence_never_reorders() -> Bool {
  let indep = Unknown
  match indep {
    Independent => false
    Dependent => false
    Unknown => true
  }
}

fn witness_read_read_independent() -> Bool {
  independence_from_effect_shapes(left: ReadEffect, right: ReadEffect) == Independent
}

fn witness_create_unknown_not_independent() -> Bool {
  match independence_from_effect_shapes(
    left: CreateEffect { cause: PostAlways },
    right: ReadEffect
  ) {
    Independent => false
    Dependent => false
    Unknown => true
  }
}

fn witness_upsert_same_key_dependent() -> Bool {
  independence_from_effect_shapes(
    left: UpsertEffect { key_source: PathParam { param: "id" } },
    right: UpsertEffect { key_source: PathParam { param: "id" } }
  ) == Dependent
}

fn witness_upsert_different_keys_independent() -> Bool {
  independence_from_effect_shapes(
    left: UpsertEffect { key_source: InputField { field: "a" } },
    right: UpsertEffect { key_source: InputField { field: "b" } }
  ) == Independent
}

test fn realization_witnesses() -> Bool {
  witness_unknown_independence_never_reorders()
    && witness_read_read_independent()
    && witness_create_unknown_not_independent()
    && witness_upsert_same_key_dependent()
    && witness_upsert_different_keys_independent()
}
