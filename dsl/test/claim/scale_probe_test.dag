module test.claim.scale_probe

import std.types { Bool }
import std.nat { Nat, nat_max }
import std.measure { Measure, Time, Nano, Micro, measure_count }

fn time_make<S>(count: Nat) -> Measure<Time, S, Nat> {
  Measure { count: count }
}

fn time_seq<S>(a: Measure<Time, S, Nat>, b: Measure<Time, S, Nat>) -> Measure<Time, S, Nat> {
  time_make(count: measure_count(m: a) + measure_count(m: b))
}

fn time_par<S>(a: Measure<Time, S, Nat>, b: Measure<Time, S, Nat>) -> Measure<Time, S, Nat> {
  time_make(count: nat_max(a: measure_count(m: a), b: measure_count(m: b)))
}

test fn scale_probe_witnesses() -> Bool {
  let a: Measure<Time, Nano, Nat> = time_make(count: 3)
  let b: Measure<Time, Nano, Nat> = time_make(count: 4)
  let s = time_seq(a: a, b: b)
  let p = time_par(a: a, b: b)
  (measure_count(m: s) == 7) && (measure_count(m: p) == 4)
}
