module test.claim.compute_fabric_witness

import product.compute_fabric {
  witness_need_is_only_fabric_plus_program,
  witness_shape_is_derived_from_program,
  witness_fabric_binds_need_to_opportunity,
  witness_exec_and_ci_are_just_programs,
  witness_hard_requirement_unmet_is_unmet,
}

test fn compute_fabric_broker_shape_and_need_holds() -> Bool {
  witness_need_is_only_fabric_plus_program()
    && witness_shape_is_derived_from_program()
}

test fn compute_fabric_broker_connect_holds() -> Bool {
  witness_fabric_binds_need_to_opportunity()
    && witness_exec_and_ci_are_just_programs()
    && witness_hard_requirement_unmet_is_unmet()
}
