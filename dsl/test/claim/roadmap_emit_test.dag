module test.claim.roadmap_emit

import extdeps.languages.markdown { serialize_markdown_source }
import gunbc.roadmap_emit { project_roadmap_section }
import gunbc.roadmap_model { RoadmapNode, RoadmapEdge, Pointer, SectionElement, section_group }
import gunbc.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine }
import ctrl.process_algebra { ProcessNodeId }

data parent_id: ProcessNodeId = "invert-hand-maintained"
data child_id: ProcessNodeId = "pr-checkbox-status"

fn parent_node() -> RoadmapNode {
  RoadmapNode {
    node: parent_id,
    line: AuthoredLine { done: false, content: "**invert hand-maintained**" },
    carriers: [Pointer { label: "plan", path: "docs/plans/invert-hand-maintained.md" }],
  }
}

fn child_node() -> RoadmapNode {
  RoadmapNode {
    node: child_id,
    line: DerivableLine { prs: [5491], title: "**PR-checkbox status**", description: "" },
    carriers: [],
  }
}

fn nodes() -> List<RoadmapNode> { [parent_node(), child_node()] }
fn edges() -> List<RoadmapEdge> { [RoadmapEdge { child: child_id, parent: parent_id }] }

fn elements() -> List<SectionElement> { [section_group(label: "", nodes: nodes(), edges: edges())] }

fn emit(merged: List<Int>) -> String {
  serialize_markdown_source(doc: project_roadmap_section(
    title: "6. Expansion", elements: elements(), merged: merged,
  ))
}

fn witness_heading() -> Bool {
  string_contains(s: emit(merged: [5491]), pattern: "## 6. Expansion")
}

fn witness_parent_authored_box_and_link() -> Bool {
  let out = emit(merged: [5491])
  string_contains(s: out, pattern: "- [ ] **invert hand-maintained**")
    && string_contains(s: out, pattern: "[plan](docs/plans/invert-hand-maintained.md)")
}

fn witness_child_derived_checked_when_merged() -> Bool {
  string_contains(s: emit(merged: [5491]), pattern: "[x] **PR-checkbox status**")
}

fn witness_child_derived_unchecked_when_unmerged() -> Bool {
  let out = emit(merged: [])
  string_contains(s: out, pattern: "[ ] **PR-checkbox status**")
    && !string_contains(s: out, pattern: "[x] **PR-checkbox status**")
}

test fn roadmap_emit_witnesses() -> Bool {
  witness_heading()
    && witness_parent_authored_box_and_link()
    && witness_child_derived_checked_when_merged()
    && witness_child_derived_unchecked_when_unmerged()
}
