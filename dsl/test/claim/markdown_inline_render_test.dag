module test.claim.markdown_inline_render

import extdeps.languages.markdown {
  parse_inline_markdown,
}
import std.markdown_markup {
  markdown_inlines_to_markup_nodes,
}
import extdeps.languages.html {
  EmitOk, EmitRejected, try_serialize_html_source,
}
import std.markup { ElementNode, TextNode }

fn render_inline(text: String) -> String {
  let inlines = parse_inline_markdown(text: text)
  let nodes = markdown_inlines_to_markup_nodes(inlines: inlines)
  let wrapper = ElementNode { tag: "span", attrs: [], children: nodes }
  match try_serialize_html_source(node: wrapper) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

fn witness_bold_renders_as_strong() -> Bool {
  render_inline(text: "**bold text**") == "<span><strong>bold text</strong></span>"
}

fn witness_code_renders_as_code() -> Bool {
  render_inline(text: "`inline code`") == "<span><code>inline code</code></span>"
}

fn witness_link_renders_as_anchor() -> Bool {
  render_inline(text: "[label](/docs/plan.md)") == "<span><a href=\"/docs/plan.md\">label</a></span>"
}

fn witness_em_renders_as_em() -> Bool {
  render_inline(text: "*emphasis*") == "<span><em>emphasis</em></span>"
}

fn witness_mixed_inline_renders() -> Bool {
  render_inline(text: "**bold** and `code` and [link](/p)") ==
    "<span><strong>bold</strong> and <code>code</code> and <a href=\"/p\">link</a></span>"
}

fn witness_plain_text_stays_plain() -> Bool {
  render_inline(text: "plain text no markup") == "<span>plain text no markup</span>"
}

fn witness_plain_differs_from_bold() -> Bool {
  !(render_inline(text: "plain") == render_inline(text: "**plain**"))
}

test fn markdown_inline_render_keystone_holds() -> Bool {
  witness_bold_renders_as_strong()
    && witness_code_renders_as_code()
    && witness_link_renders_as_anchor()
    && witness_em_renders_as_em()
    && witness_mixed_inline_renders()
    && witness_plain_text_stays_plain()
    && witness_plain_differs_from_bold()
}
