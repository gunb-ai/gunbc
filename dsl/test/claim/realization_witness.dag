// dsl/test/claim/realization_witness.dag — by-execution witnesses for std.realization.
//
// GREEN: may_reorder fail-closed (Unknown → Dependent); Read+Read independent.
// Run: gunbc run --source-root dsl --entry <this> --function realization_witnesses --claim-run

module test.claim.realization_witness

import std.effects {
  ReadEffect, CreateEffect,
  UpsertEffect, DeleteEffect, PathParam, InputField
}
import std.realization {
  Unknown, Dependent, Independent,
  independence_from_effect_shapes,
  may_reorder,
}

fn witness_unknown_independence_never_reorders() -> Bool {
  may_reorder(indep: Unknown) == false
}

fn witness_read_read_may_reorder() -> Bool {
  may_reorder(
    indep: independence_from_effect_shapes(left: ReadEffect, right: ReadEffect)
  ) == true
}

fn witness_create_unknown_never_reorders() -> Bool {
  may_reorder(
    indep: independence_from_effect_shapes(left: CreateEffect, right: ReadEffect)
  ) == false
}

fn witness_upsert_same_key_dependent() -> Bool {
  independence_from_effect_shapes(
    left: UpsertEffect { key_source: PathParam { param: "id" } },
    right: UpsertEffect { key_source: PathParam { param: "id" } }
  ) == Dependent
}

fn witness_upsert_different_keys_independent() -> Bool {
  independence_from_effect_shapes(
    left: UpsertEffect { key_source: InputField { field: "a" } },
    right: UpsertEffect { key_source: InputField { field: "b" } }
  ) == Independent
}

fn realization_witnesses() -> Bool {
  witness_unknown_independence_never_reorders()
    && witness_read_read_may_reorder()
    && witness_create_unknown_never_reorders()
    && witness_upsert_same_key_dependent()
    && witness_upsert_different_keys_independent()
}
