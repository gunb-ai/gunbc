module test.claim.fleet_intent_storage

import std.logic { Bool }
import std.types { list_length }
import std.measure { byte_size_count }
import gunbc.fleet_intent { srv1_host, srv2_host, srv3_host, srv1_nvme0 }
import extdeps.observability { OutOfBand, StorageInventory, route_observation }

test fn in_band_hosts_carry_their_real_drive() -> Bool {
  list_length(items: srv1_host.storage) == 1
    && list_length(items: srv2_host.storage) == 1
}

test fn srv1_drive_is_catalog_grounded_wd_sn850x() -> Bool {
  byte_size_count(srv1_nvme0.capacity) == 2000398934016
    && match srv1_nvme0.catalog {
      Present { value: c } =>
        c.pcie_link.lane_count == 4
          && match c.pcie_link.generation {
            Gen4 => true
            Gen3 => false
            Gen5 => false
          }
      Absent => false
    }
}

test fn out_of_band_only_host_reports_no_drives() -> Bool {
  list_length(items: srv3_host.storage) == 0
    && match route_observation(channel: OutOfBand, class: StorageInventory) {
      ChannelCannotObserve { channel: _, class: _ } => true
      RoutedTo { channel: _ } => false
    }
}
