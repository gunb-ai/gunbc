module test.claim.os_systemd_witness

import extdeps.os.systemd {
  SystemdUnitStatus,
  SystemdUnitActiveState,
  Active,
  Inactive,
  Failed,
}
import std.types { NonEmptyStr }

test fn systemd_witnesses() -> Bool {
  let active_status = SystemdUnitStatus {
    name: "docker.service" as NonEmptyStr,
    active_state: Active,
  }

  let inactive_status = SystemdUnitStatus {
    name: "some.service" as NonEmptyStr,
    active_state: Inactive,
  }

  let failed_status = SystemdUnitStatus {
    name: "failing.service" as NonEmptyStr,
    active_state: Failed,
  }

  active_status.name != ""
    && inactive_status.name != ""
    && failed_status.name != ""
}
