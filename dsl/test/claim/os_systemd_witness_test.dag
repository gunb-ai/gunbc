module test.claim.os_systemd_witness

import extdeps.os.systemd {
  SystemdUnitStatus,
  SystemdUnitActiveState,
  Active,
  Inactive,
  Failed,
  parse_systemd_unit_active_state,
  systemd_unit_active_state_wire_label,
  parse_systemd_memory_max_show_value,
  MemoryMaxBounded,
  MemoryMaxUnbounded,
}
import std.types { NonEmptyStr }

test fn witness_active_wire_decodes_to_active() -> Bool {
  match parse_systemd_unit_active_state(raw: "active") {
    Present { value: Active } => true
    _ => false
  }
}

test fn witness_wrong_case_does_not_decode() -> Bool {
  match parse_systemd_unit_active_state(raw: "ACTIVE") {
    none => true
    _ => false
  }
}

test fn witness_roundtrip_failed() -> Bool {
  systemd_unit_active_state_wire_label(s: Failed) == "failed"
}

test fn witness_memory_max_show_infinity_decodes_unbounded() -> Bool {
  match parse_systemd_memory_max_show_value(raw: "infinity") {
    Present { value: MemoryMaxUnbounded } => true
    _ => false
  }
}

test fn witness_memory_max_show_bytes_decodes_bounded() -> Bool {
  match parse_systemd_memory_max_show_value(raw: "8589934592") {
    Present { value: MemoryMaxBounded { bytes: n } } => n == 8589934592
    _ => false
  }
}

test fn witness_memory_max_show_garbage_fails_closed() -> Bool {
  match parse_systemd_memory_max_show_value(raw: "not-a-number") {
    none => true
    _ => false
  }
}
