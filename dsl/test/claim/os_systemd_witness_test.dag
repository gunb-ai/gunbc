module test.claim.os_systemd_witness

import extdeps.os.systemd {
  SystemdUnitStatus,
  SystemdUnitActiveState,
  Active,
  Inactive,
  Failed,
}

test fn valid_active_unit {
  let status: SystemdUnitStatus = SystemdUnitStatus {
    name: "docker.service",
    active_state: Active,
  }

  assert status.name != ""
}

test fn valid_inactive_unit {
  let status: SystemdUnitStatus = SystemdUnitStatus {
    name: "some.service",
    active_state: Inactive,
  }

  assert status.name != ""
}

test fn valid_failed_unit {
  let status: SystemdUnitStatus = SystemdUnitStatus {
    name: "failing.service",
    active_state: Failed,
  }

  assert status.name != ""
}

test fn active_state_variants_exist {
  let _active: SystemdUnitActiveState = Active
  let _inactive: SystemdUnitActiveState = Inactive
  let _failed: SystemdUnitActiveState = Failed
}
