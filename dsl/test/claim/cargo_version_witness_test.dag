// test/claim/cargo_version_witness_test.dag — by-execution witness for Cargo SemVer carriers.
//
// DESIGN §5 green-by-execution: `CargoPackageVersion` and `CargoVersionRequirement`
// are not spec-without-execution — this witness folds render helpers and the stage0
// default over discriminating inputs. Reverting either field to bare `String` or
// dropping the branded requirement carrier breaks the typed data rows below.

module test.claim.cargo_version

import extdeps.cargo {
  CargoPackage,
  CargoDependency,
  RegistryDep,
  Edition2021,
  min_cargo_version,
}
import extdeps.cargo_version {
  default_stage0_package_version,
  render_cargo_package_version_field,
  render_cargo_package_header_prefix,
  render_cargo_version_requirement_toml,
}

fn w_stage0_default_package_version() -> Bool {
  default_stage0_package_version == "0.1.0"
    && render_cargo_package_version_field(version: default_stage0_package_version) == "version = \"0.1.0\""
}

fn w_package_version_field_renders() -> Bool {
  let pkg = CargoPackage {
    name: "demo",
    version: "2.4.6",
    edition: Edition2021,
    path: "."
  }
  render_cargo_package_version_field(version: pkg.version) == "version = \"2.4.6\""
}

fn w_registry_dep_version_requirements() -> Bool {
  let serde = CargoDependency {
    name: "serde",
    source: RegistryDep { version: "1", features: ["derive", "rc"] }
  }
  let stacker = CargoDependency {
    name: "stacker",
    source: RegistryDep { version: "0.1", features: [] }
  }
  match serde.source {
    RegistryDep { version: v, features: f } =>
      render_cargo_version_requirement_toml(req: v) == "\"1\""
        && (f |> count) == 2
    LocalPathDep { path: _ } => false
  }
    && match stacker.source {
      RegistryDep { version: v, features: f } =>
        render_cargo_version_requirement_toml(req: v) == "\"0.1\""
          && (f |> count) == 0
      LocalPathDep { path: _ } => false
    }
}

fn w_requirement_distinct_from_package_version() -> Bool {
  render_cargo_version_requirement_toml(req: "1") != render_cargo_package_version_field(version: "1.0.0")
}

fn w_emitter_header_prefix_uses_default() -> Bool {
  render_cargo_package_header_prefix(name: "demo-crate") == "[package]\nname = \"demo-crate\"\nversion = \"0.1.0\""
}

test fn cargo_version_witnesses() -> Bool {
  w_stage0_default_package_version()
    && w_package_version_field_renders()
    && w_registry_dep_version_requirements()
    && w_requirement_distinct_from_package_version()
    && w_emitter_header_prefix_uses_default()
}
