// test/claim/jedec_ddr_generation_witness_test.dag — by-execution witness for cited JEDEC
// SDRAM generation rows (extdeps/memory/jedec.dag).
//
// Proves by RUNNING (DESIGN §5): the generation axis is decomposed (DoubleDataRate × N),
// per-generation monolithic die-density ceilings are cited with correct byte magnitudes,
// dispatch selects the matching row, and the std realizability guard fail-closes on
// generation mismatch.

module test.claim.jedec_ddr_generation

import std.logic { Bool }
import std.measure { byte_size, byte_size_count, bit_width }
import std.memory.types {
  DoubleDataRate,
  DramModuleCatalogRow,
  dram_module_is_realizable,
  dram_generation_ddr4,
  dram_generation_ddr5,
  dram_generation_eq,
}
import extdeps.memory.jedec {
  ddr4_generation_catalog,
  ddr5_generation_catalog,
  jedec_ddr_generation_catalog_row,
}

// A DDR4 32GB 1Rx8 impossible part — needs 32Gbit dies, above DDR4's 16Gbit ceiling but
// within DDR5's 64Gbit ceiling. Discriminates per-generation ceilings.
data mod_ddr4_32g_1rx8: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "FAKE-32G-1RX8-DDR4",
  manufacturer: SkHynix,
  generation: dram_generation_ddr4,
  capacity_bytes: byte_size(count: 34359738368),
  data_rate_mts: 3200,
  ecc: true,
  buffering: Registered,
  chip_width: bit_width(count: 8),
  rank_count: 1,
}

// Same organization tagged DDR5 — realizable under JESD79-5 (64 Gbit = 8 GiB ceiling).
data mod_ddr5_32g_1rx8: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "FAKE-32G-1RX8-DDR5",
  manufacturer: SkHynix,
  generation: dram_generation_ddr5,
  capacity_bytes: byte_size(count: 34359738368),
  data_rate_mts: 4800,
  ecc: true,
  buffering: Registered,
  chip_width: bit_width(count: 8),
  rank_count: 1,
}

// Generation axis is decomposed: DoubleDataRate family × cardinal generation number.
fn generation_axis_is_decomposed() -> Bool {
  dram_generation_ddr4.signaling_family == DoubleDataRate
    && dram_generation_ddr4.generation_number == 4
    && dram_generation_ddr5.signaling_family == DoubleDataRate
    && dram_generation_ddr5.generation_number == 5
}

fn ddr4_ceiling_is_2_gib() -> Bool {
  byte_size_count(b: ddr4_generation_catalog.max_monolithic_die_density) == 2147483648
}

fn ddr5_ceiling_is_8_gib() -> Bool {
  byte_size_count(b: ddr5_generation_catalog.max_monolithic_die_density) == 8589934592
}

fn dispatch_selects_matching_generation() -> Bool {
  dram_generation_eq(
    a: jedec_ddr_generation_catalog_row(dram_generation_ddr4).generation,
    b: dram_generation_ddr4,
  )
    && dram_generation_eq(
      a: jedec_ddr_generation_catalog_row(dram_generation_ddr5).generation,
      b: dram_generation_ddr5,
    )
}

// Per-generation ceiling discriminates: 32GB 1Rx8 needs 4 GiB dies — impossible DDR4,
// realizable DDR5.
fn per_generation_ceiling_discriminates() -> Bool {
  !dram_module_is_realizable(module: mod_ddr4_32g_1rx8, jedec: ddr4_generation_catalog)
    && dram_module_is_realizable(module: mod_ddr5_32g_1rx8, jedec: ddr5_generation_catalog)
}

// Fail-closed on generation mismatch: a DDR4 module must not pass when scored against DDR5 ceiling.
fn generation_mismatch_fails_closed() -> Bool {
  !dram_module_is_realizable(module: mod_ddr4_32g_1rx8, jedec: ddr5_generation_catalog)
}

test fn jedec_ddr_generation_holds() -> Bool {
  generation_axis_is_decomposed()
    && ddr4_ceiling_is_2_gib()
    && ddr5_ceiling_is_8_gib()
    && dispatch_selects_matching_generation()
    && per_generation_ceiling_discriminates()
    && generation_mismatch_fails_closed()
}
