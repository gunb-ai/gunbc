module tmp_profile_probe

import interfaces.credential_provider { CredentialProvider }
import std.types { CredentialFlow }

func probe() -> { token: Secret }
  uses creds: CredentialProvider
{
  acquired = creds.acquire(
    secret_name: "github-token",
    flow: Stored { secret_name: "github-token" },
    scheme: Bearer,
    source_id: "github",
    required_scopes: []
  )
  return { token: acquired.token.token }
}
