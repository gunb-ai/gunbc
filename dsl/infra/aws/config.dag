// infra/aws/config.dag -- AWS-specific environment configurations.

module infra.aws.config

import infra.core { CloudConfig, InfraEnvironment }
import infra.spec { Environment }

fn aws_dev_config() -> InfraEnvironment {
  {
    name: Dev,
    cloud: AwsConfig(
      account_id: "123456789012",
      region: "us-east-1",
      profile: "dev"
    ),
    secrets_prefix: "dev/",
    tags: { "Environment": "dev", "ManagedBy": "gunbc" }
  }
}

fn aws_ci_config() -> InfraEnvironment {
  aws_dev_config() with {
    name: Ci,
    cloud: AwsConfig(
      account_id: "123456789012",
      region: "us-east-1",
      profile: "ci"
    ),
    secrets_prefix: "ci/",
    tags: { "Environment": "ci", "ManagedBy": "gunbc" }
  }
}

fn aws_prod_config() -> InfraEnvironment {
  {
    name: Prod,
    cloud: AwsConfig(
      account_id: "987654321098",
      region: "us-east-1",
      profile: None
    ),
    secrets_prefix: "",
    tags: { "Environment": "prod", "ManagedBy": "gunbc" }
  }
}
