// infra/azure/services.dag -- Azure API service declarations for infra resources.
//
// Azure REST APIs with bearer token (Managed Identity / MSAL) authentication.

module infra.azure.services


// --- Blob Storage --------------------------------------------------------

service azure.BlobStorage {

  operation GetContainer {
    input { account_name: NonEmptyStr, container: NonEmptyStr }
    output { exists: Bool }
  }

  operation CreateContainer {
    input { account_name: NonEmptyStr, container: NonEmptyStr }
    output { ok: Bool }
  }

  operation DeleteContainer {
    input { account_name: NonEmptyStr, container: NonEmptyStr }
    output { ok: Bool }
  }

  operation GetBlob {
    input { account_name: NonEmptyStr, container: NonEmptyStr, blob: NonEmptyStr }
    output { content: Bytes, found: Bool }
  }

  operation PutBlob {
    input { account_name: NonEmptyStr, container: NonEmptyStr, blob: NonEmptyStr, content: Bytes }
    output { etag: String }
  }

  operation DeleteBlob {
    input { account_name: NonEmptyStr, container: NonEmptyStr, blob: NonEmptyStr }
    output { ok: Bool }
  }

  operation ListBlobs {
    input { account_name: NonEmptyStr, container: NonEmptyStr, prefix: String? }
    output { blobs: List<NonEmptyStr> }
  }
}


// --- Container Apps ------------------------------------------------------

service azure.ContainerApps {

  operation Get {
    input { subscription_id: NonEmptyStr, resource_group: NonEmptyStr, name: NonEmptyStr }
    output { exists: Bool, fqdn: Url?, properties: Json? }
  }

  operation CreateOrUpdate {
    input {
      subscription_id: NonEmptyStr
      resource_group: NonEmptyStr
      name: NonEmptyStr
      location: String
      image: NonEmptyStr
      target_port: Int = 8080
      cpu: Float = 0.5
      memory: String = "1Gi"
      min_replicas: Int = 0
      max_replicas: Int = 10
      env: Map<String, String>?
      managed_identity_id: String?
      tags: Map<String, String>?
    }
    output { fqdn: Url, provisioning_state: String }
  }

  operation Delete {
    input { subscription_id: NonEmptyStr, resource_group: NonEmptyStr, name: NonEmptyStr }
    output { ok: Bool }
  }
}


// --- Key Vault -----------------------------------------------------------

service azure.KeyVault {

  operation GetSecret {
    input { vault_name: NonEmptyStr, name: NonEmptyStr }
    output { exists: Bool, value: Secret?, version: String? }
  }

  operation SetSecret {
    input { vault_name: NonEmptyStr, name: NonEmptyStr, value: Secret, tags: Map<String, String>? }
    output { version: NonEmptyStr }
  }

  operation GetSecretVersions {
    input { vault_name: NonEmptyStr, name: NonEmptyStr }
    output { versions: List<NonEmptyStr> }
  }

  operation DeleteSecret {
    input { vault_name: NonEmptyStr, name: NonEmptyStr }
    output { ok: Bool }
  }
}


// --- Managed Identity ----------------------------------------------------

service azure.ManagedIdentity {

  operation Get {
    input { subscription_id: NonEmptyStr, resource_group: NonEmptyStr, name: NonEmptyStr }
    output { exists: Bool, principal_id: String?, client_id: String? }
  }

  operation Create {
    input {
      subscription_id: NonEmptyStr
      resource_group: NonEmptyStr
      name: NonEmptyStr
      location: String
      tags: Map<String, String>?
    }
    output { principal_id: String, client_id: String }
  }

  operation CreateFederatedCredential {
    input {
      subscription_id: NonEmptyStr
      resource_group: NonEmptyStr
      identity_name: NonEmptyStr
      name: NonEmptyStr
      issuer: Url
      subject: NonEmptyStr
      audiences: List<String>
    }
    output { ok: Bool }
  }
}


// --- Service Bus ---------------------------------------------------------

service azure.ServiceBus {

  operation GetQueue {
    input { subscription_id: NonEmptyStr, resource_group: NonEmptyStr, namespace: NonEmptyStr, queue_name: NonEmptyStr }
    output { exists: Bool }
  }

  operation CreateQueue {
    input {
      subscription_id: NonEmptyStr
      resource_group: NonEmptyStr
      namespace: NonEmptyStr
      queue_name: NonEmptyStr
      lock_duration: String = "PT30S"
      max_delivery_count: Int = 5
      default_message_ttl: String = "P4D"
    }
    output { ok: Bool }
  }

  operation SendMessage {
    input { namespace: NonEmptyStr, queue_name: NonEmptyStr, body: String }
    output { message_id: NonEmptyStr }
  }

  operation ReceiveMessages {
    input { namespace: NonEmptyStr, queue_name: NonEmptyStr, max_messages: Int = 10 }
    output { messages: List<Json> }
  }

  operation CompleteMessage {
    input { namespace: NonEmptyStr, queue_name: NonEmptyStr, lock_token: NonEmptyStr }
    output { ok: Bool }
  }
}


// --- Role Assignments (for identity grants) ------------------------------

service azure.Authorization {

  operation CreateRoleAssignment {
    input {
      scope: NonEmptyStr
      assignment_name: NonEmptyStr
      role_definition_id: NonEmptyStr
      principal_id: NonEmptyStr
    }
    output { ok: Bool }
  }

  operation DeleteRoleAssignment {
    input { scope: NonEmptyStr, assignment_name: NonEmptyStr }
    output { ok: Bool }
  }
}
