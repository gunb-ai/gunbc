// infra/azure/config.dag -- Azure-specific environment configurations.

module infra.azure.config

import infra.core { CloudConfig, InfraEnvironment }
import infra.spec { Environment }

fn azure_dev_config() -> InfraEnvironment {
  {
    name: Dev,
    cloud: AzureConfig(
      subscription_id: "00000000-0000-0000-0000-000000000000",
      resource_group: "rg-gunbc-dev",
      location: "eastus",
      tenant_id: "00000000-0000-0000-0000-000000000001"
    ),
    secrets_prefix: "dev-",
    tags: { "environment": "dev", "managedBy": "gunbc" }
  }
}

fn azure_ci_config() -> InfraEnvironment {
  azure_dev_config() with {
    name: Ci,
    cloud: AzureConfig(
      subscription_id: "00000000-0000-0000-0000-000000000000",
      resource_group: "rg-gunbc-ci",
      location: "eastus",
      tenant_id: "00000000-0000-0000-0000-000000000001"
    ),
    secrets_prefix: "ci-",
    tags: { "environment": "ci", "managedBy": "gunbc" }
  }
}

fn azure_prod_config() -> InfraEnvironment {
  {
    name: Prod,
    cloud: AzureConfig(
      subscription_id: "11111111-1111-1111-1111-111111111111",
      resource_group: "rg-gunbc-prod",
      location: "eastus",
      tenant_id: "11111111-1111-1111-1111-111111111112"
    ),
    secrets_prefix: "",
    tags: { "environment": "prod", "managedBy": "gunbc" }
  }
}
