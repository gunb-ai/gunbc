// workflows/dag_viz.dag
//
// Replaces WF20 dag-viz workflow family specs:
// - dag-viz
// - dag-viz-diff
// - dag-viz-recent
// - dag-snapshot
//
// Mode topology:
// dag-viz family: compilation_ensure -> codegen_ensure -> serialize_dag -> render_viz -> gist_upload -> report
// dag-snapshot:   compilation_ensure -> codegen_ensure -> list_files -> read_files -> render_snapshot -> gist_upload -> report
//
// Shared base edges for all supported modes:
// codegen_ensure -> branch_resolution -> gist_upload
// codegen_ensure -> credential_resolve -> gist_upload

module workflows.dag_viz

import shared.compilation { compilation_ensure }
import tools.codegen { codegen_ensure }

pipeline dag_viz {

  stage compilation_ensure {
    @file(WRITE, "target")
    @tool(READ, "cargo")
    _ = compilation_ensure()
  }

  stage codegen_ensure [after compilation_ensure] {
    @file(WRITE, "generated:cli")
    _ = codegen_ensure()
  }

  stage branch_resolution [after codegen_ensure] {
    @file(READ, "workspace")
  }

  stage credential_resolve [after codegen_ensure] {
    @credential(READ, "github")
  }

  stage serialize_dag [after codegen_ensure, when mode == "dag-viz" || mode == "dag-viz-diff" || mode == "dag-viz-recent"] {
    @file(READ, "workspace")
  }

  stage render_viz [after serialize_dag, when mode == "dag-viz" || mode == "dag-viz-diff" || mode == "dag-viz-recent"] {}

  stage list_files [after codegen_ensure, when mode == "dag-snapshot"] {
    @file(READ, "workspace")
  }

  stage read_files [after list_files, when mode == "dag-snapshot"] {
    @file(READ, "workspace")
  }

  stage render_snapshot [after read_files, when mode == "dag-snapshot"] {}

  stage gist_upload [
    after branch_resolution,
    after credential_resolve,
    after render_viz,
    after render_snapshot,
    when mode == "dag-viz"
      || mode == "dag-viz-diff"
      || mode == "dag-viz-recent"
      || mode == "dag-snapshot"
  ] {
    @network(WRITE, "github_gist")
    @credential(READ, "github")
  }

  stage report [after gist_upload] {}
}
