// workflows/ci.dag
//
// Planner CI workflow (WF1) used by gunbc-workflow.

module workflows.ci

pipeline ci {

  stage lint_upsert {
  }

  stage codegen [after lint_upsert] {
  }

  stage bootstrap [after codegen] {
  }

  stage pragma [after codegen] {
  }

  stage testgen [after codegen] {
  }

  stage build_compile [after codegen, after testgen] {  }

  stage test_run [after build_compile] {  }

  stage clippy_run [after build_compile] {  }

  stage guardrails [after pragma, after testgen] {
  }

  stage verify [after pragma, after testgen, after bootstrap] {
  }

  stage report [after test_run, after clippy_run, after guardrails, after verify] {}
}
