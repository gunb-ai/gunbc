// Planner test-all workflow (WF1) used by gunbc-workflow.

module workflows.test_all

pipeline test_all {

  stage lint_upsert {
  }

  stage codegen [after lint_upsert] {
  }

  stage testgen [after lint_upsert] {
  }

  stage build_compile [after codegen, after testgen] {  }

  stage verify_fix [after codegen, after testgen] {
  }

  stage cargo_test_xl [after build_compile, after verify_fix] {  }

  stage report [after cargo_test_xl, after verify_fix] {}
}
