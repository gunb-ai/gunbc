// understanding/secret_apis.dag -- Secret extraction API surface (Layer 2).
//
// Facts about internal APIs that expose plaintext secrets.
// Provides access to the SecretTransport resource.

module understanding.secret_apis

import std.lint { ApiSurfaceKind }

type SecretOpKind = PlaintextExtract

type SecretEntry {
  path: String
  kind: SecretOpKind
  surface: ApiSurfaceKind
}

type ResourceGroup {
  resource: String
  entries: List<SecretEntry>
}

data groups: List<ResourceGroup> = [
  {
    resource: "SecretTransport",
    entries: [
      { path: "gunbc_ir::value::SecretString::expose_plaintext_for_transport",
        kind: PlaintextExtract, surface: Method },
      { path: "gunbc_ir::transport::credential::Secret::expose_plaintext_for_transport",
        kind: PlaintextExtract, surface: Method }
    ]
  }
]
