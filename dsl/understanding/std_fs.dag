// understanding/std_fs.dag -- std::fs API surface (Layer 2).
//
// Facts about the Rust standard library's filesystem module.
// Declares which resource it provides access to and enumerates
// its public operations and types (from rustdoc).

module understanding.std_fs

import std.lint { ApiSurfaceKind }

// Classification of filesystem operations.
type FsOpKind = FileRead | FileWrite | DirectoryOp | MetadataOp | LinkOp | FileHandle

// An entry in the std::fs API surface.
type StdFsEntry {
  path: String
  kind: FsOpKind
  surface: ApiSurfaceKind
}

// ResourceGroup: groups operations by the resource they provide access to.
// A module may provide access to multiple resources (std::fs only provides Filesystem).
type ResourceGroup {
  resource: String
  entries: List<StdFsEntry>
}

data groups: List<ResourceGroup> = [
  {
    resource: "Filesystem",
    entries: [
      // File read operations
      { path: "std::fs::read",            kind: FileRead,     surface: Method },
      { path: "std::fs::read_to_string",  kind: FileRead,     surface: Method },
      { path: "std::fs::read_link",       kind: FileRead,     surface: Method },
      { path: "std::fs::read_dir",        kind: DirectoryOp,  surface: Method },
      { path: "std::fs::canonicalize",    kind: MetadataOp,   surface: Method },
      { path: "std::fs::metadata",        kind: MetadataOp,   surface: Method },
      { path: "std::fs::symlink_metadata", kind: MetadataOp,  surface: Method },

      // File write operations
      { path: "std::fs::write",           kind: FileWrite,    surface: Method },
      { path: "std::fs::copy",            kind: FileWrite,    surface: Method },
      { path: "std::fs::rename",          kind: FileWrite,    surface: Method },
      { path: "std::fs::hard_link",       kind: LinkOp,       surface: Method },
      { path: "std::fs::create_dir",      kind: DirectoryOp,  surface: Method },
      { path: "std::fs::create_dir_all",  kind: DirectoryOp,  surface: Method },
      { path: "std::fs::remove_file",     kind: FileWrite,    surface: Method },
      { path: "std::fs::remove_dir",      kind: DirectoryOp,  surface: Method },
      { path: "std::fs::remove_dir_all",  kind: DirectoryOp,  surface: Method },
      { path: "std::fs::set_permissions", kind: MetadataOp,   surface: Method },

      // File handle operations
      { path: "std::fs::File::open",         kind: FileHandle, surface: Method },
      { path: "std::fs::File::create",       kind: FileHandle, surface: Method },
      { path: "std::fs::File::options",      kind: FileHandle, surface: Method },
      { path: "std::fs::OpenOptions::new",   kind: FileHandle, surface: Method },
      { path: "std::fs::OpenOptions::open",  kind: FileHandle, surface: Method },
      { path: "std::fs::DirBuilder::new",    kind: DirectoryOp, surface: Method },
      { path: "std::fs::DirBuilder::create", kind: DirectoryOp, surface: Method },

      // Types (owning raw file handles)
      { path: "std::fs::File",        kind: FileHandle,  surface: Type },
      { path: "std::fs::OpenOptions", kind: FileHandle,  surface: Type },
      { path: "std::fs::DirBuilder",  kind: DirectoryOp, surface: Type },
      { path: "std::fs::DirEntry",    kind: DirectoryOp, surface: Type },
      { path: "std::fs::ReadDir",     kind: DirectoryOp, surface: Type },
      { path: "std::fs::Metadata",    kind: MetadataOp,  surface: Type },
      { path: "std::fs::Permissions", kind: MetadataOp,  surface: Type },
      { path: "std::fs::FileType",    kind: MetadataOp,  surface: Type }
    ]
  }
]
