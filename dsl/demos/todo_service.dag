// demos/todo_service — minimal TODO domain + REST operation table for omni-emission demos.
//
// Exercises Shape B projections in `omni_shape_b_openapi.rs` (OpenAPI 3.1 YAML,
// Markdown drift-lock, SQL DDL route schema, runnable Rust backend) plus Shape A
// `emit_rust` on one shared `compile_to_dag` result (r3-program-plan §1.8 #25–#28).
//
// Domain carriers are illustrated with small `data` inhabitants (human-facing
// demo context). Omni route extraction still keys only on
// `List<{ endpoint: RestEndpointBinding }>` rows (`v3.std.services`).

module demos.todo_service

import std.types { GET, POST, PUT, PATCH, DELETE, Int, String, Bool }
import std.effects { LiteralToken, ParamToken }
import v3.std.services { RestEndpointBinding }

// Trivial root `data` so the module is not purely type-level (same cadence as
// `omni_emit_anchor` in `m1_5_omni_shape_b_openapi_test` inline fixtures). Unused by route
// extractors; keeps demo symmetry with other omni Shape B receipts.
data todo_service_emit_anchor: Int = 0

type User {
  id:           String
  display_name: String
}

type TodoItem {
  id:          String
  list_id:     String
  title:       String
  completed:   Bool
}

type TodoList {
  id:          String
  owner_id:    String
  title:       String
}

type TodoServiceOperation {
  endpoint: RestEndpointBinding
}

data todo_domain_example_user: User = {
  id:           "demo-user",
  display_name: "Demo User"
}

data todo_domain_example_item: TodoItem = {
  id:        "demo-todo",
  list_id:   "demo-list",
  title:     "Wire domain carriers to example rows",
  completed: false
}

data todo_domain_example_list: TodoList = {
  id:       "demo-list",
  owner_id: "demo-user",
  title:    "Demo backlog"
}

data todo_service_operations: List<TodoServiceOperation> = [
  {
    endpoint: {
      method: GET,
      path: { tokens: [LiteralToken { text: "users" }] }
    }
  },
  {
    endpoint: {
      method: POST,
      path: { tokens: [LiteralToken { text: "users" }] }
    }
  },
  {
    endpoint: {
      method: GET,
      path: {
        tokens: [LiteralToken { text: "users/" }, ParamToken { name: "userId" }]
      }
    }
  },
  {
    endpoint: {
      method: PUT,
      path: {
        tokens: [LiteralToken { text: "users/" }, ParamToken { name: "userId" }]
      }
    }
  },
  {
    endpoint: {
      method: DELETE,
      path: {
        tokens: [LiteralToken { text: "users/" }, ParamToken { name: "userId" }]
      }
    }
  },
  {
    endpoint: {
      method: GET,
      path: {
        tokens: [
          LiteralToken { text: "users/" },
          ParamToken { name: "userId" },
          LiteralToken { text: "/todos" }
        ]
      }
    }
  },
  {
    endpoint: {
      method: POST,
      path: {
        tokens: [
          LiteralToken { text: "users/" },
          ParamToken { name: "userId" },
          LiteralToken { text: "/todos" }
        ]
      }
    }
  },
  {
    endpoint: {
      method: GET,
      path: {
        tokens: [LiteralToken { text: "todos/" }, ParamToken { name: "todoId" }]
      }
    }
  },
  {
    endpoint: {
      method: PATCH,
      path: {
        tokens: [LiteralToken { text: "todos/" }, ParamToken { name: "todoId" }]
      }
    }
  },
  {
    endpoint: {
      method: DELETE,
      path: {
        tokens: [LiteralToken { text: "todos/" }, ParamToken { name: "todoId" }]
      }
    }
  },
  {
    endpoint: {
      method: GET,
      path: {
        tokens: [LiteralToken { text: "lists/" }, ParamToken { name: "listId" }]
      }
    }
  },
  {
    endpoint: {
      method: POST,
      path: {
        tokens: [
          LiteralToken { text: "lists/" },
          ParamToken { name: "listId" },
          LiteralToken { text: "/todos" }
        ]
      }
    }
  }
]
