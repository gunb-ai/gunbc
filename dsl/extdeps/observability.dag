module extdeps.observability

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Out-of-band_management"
  }
}

type ObservabilityChannel =
    InBand
  | OutOfBand

type ObservationClass =
    ProcessorInventory
  | MemoryInventory
  | PowerState
  | PowerDraw
  | Thermal
  | StorageInventory
  | NetworkInventory

type ObservationRoutingOutcome =
    RoutedTo { channel: ObservabilityChannel }
  | ChannelCannotObserve { channel: ObservabilityChannel, class: ObservationClass }

// The single public answer to "can this channel observe this class?" is the structured outcome — no
// separate Bool predicate over the coproducts (the typed RoutedTo/ChannelCannotObserve subsumes it).
fn route_observation(channel: ObservabilityChannel, class: ObservationClass) -> ObservationRoutingOutcome {
  match channel {
    InBand => RoutedTo { channel: channel }
    OutOfBand =>
      match class {
        ProcessorInventory => RoutedTo { channel: channel }
        MemoryInventory => RoutedTo { channel: channel }
        PowerState => RoutedTo { channel: channel }
        PowerDraw => RoutedTo { channel: channel }
        Thermal => RoutedTo { channel: channel }
        StorageInventory => ChannelCannotObserve { channel: channel, class: class }
        NetworkInventory => ChannelCannotObserve { channel: channel, class: class }
      }
  }
}
