module extdeps.llm.openai_errors

import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "platform.openai.com/docs/guides/error-codes/api-errors"
  }
}

type OpenAiErrorType
  = OpenAiInvalidRequestError
  | OpenAiAuthenticationError
  | OpenAiPermissionError
  | OpenAiNotFoundError
  | OpenAiRateLimitError
  | OpenAiApiError
  | OpenAiInsufficientQuota
  | OpenAiErrorTypeOther { raw: NonEmptyStr }

data openai_error_invalid_request_wire: String = "invalid_request_error"
data openai_error_authentication_wire: String = "authentication_error"
data openai_error_permission_wire: String = "permission_error"
data openai_error_not_found_wire: String = "not_found_error"
data openai_error_rate_limit_wire: String = "rate_limit_error"
data openai_error_api_wire: String = "api_error"
data openai_error_insufficient_quota_wire: String = "insufficient_quota"

fn parse_openai_error_type(raw: String) -> OpenAiErrorType {
  if raw == openai_error_invalid_request_wire { OpenAiInvalidRequestError }
  else if raw == openai_error_authentication_wire { OpenAiAuthenticationError }
  else if raw == openai_error_permission_wire { OpenAiPermissionError }
  else if raw == openai_error_not_found_wire { OpenAiNotFoundError }
  else if raw == openai_error_rate_limit_wire { OpenAiRateLimitError }
  else if raw == openai_error_api_wire { OpenAiApiError }
  else if raw == openai_error_insufficient_quota_wire { OpenAiInsufficientQuota }
  else { OpenAiErrorTypeOther { raw: raw } }
}

fn openai_error_type_label(kind: OpenAiErrorType) -> String {
  match kind {
    OpenAiInvalidRequestError => openai_error_invalid_request_wire
    OpenAiAuthenticationError => openai_error_authentication_wire
    OpenAiPermissionError => openai_error_permission_wire
    OpenAiNotFoundError => openai_error_not_found_wire
    OpenAiRateLimitError => openai_error_rate_limit_wire
    OpenAiApiError => openai_error_api_wire
    OpenAiInsufficientQuota => openai_error_insufficient_quota_wire
    OpenAiErrorTypeOther { raw: r } => r
  }
}

type OpenAiErrorDetails {
  message: String
  type: OpenAiErrorType
  param: String?
  code: String?
}

type OpenAiErrorShape {
  error: OpenAiErrorDetails
}
