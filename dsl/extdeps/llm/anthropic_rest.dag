// extdeps/llm/anthropic_rest.dag — Anthropic Messages API REST transport.
//
// Protocol types and wire contracts live in `anthropic.dag` (`module extdeps.llm.anthropic`).
// This file binds the REST handler only (DESIGN.md §3: one shape, N realization handlers).

module extdeps.llm.anthropic_rest

import extdeps.llm.anthropic {
  AnthropicChatMessage,
  AnthropicMessages200Body,
  AnthropicStopReason,
  current_api_version
}
import extdeps.llm.anthropic_errors { AnthropicErrorShape }
import std.credentials { EnvVar }

service llm.Anthropic {
  config {
    endpoint: "https://api.anthropic.com"
    auth: Header("x-api-key")
    auth_input: api_key
    auth_source: EnvVar { name: "ANTHROPIC_API_KEY" }
    // Anthropic API rate limits: varies by tier (1000-4000 RPM), use conservative default
    rate_limit: { requests: 1000, per: minute, scope: messages }
    // Retry on overload and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 529] }
  }

  operation Messages {
    input {
      api_key: Secret
      model: String
      messages: List<AnthropicChatMessage>
      max_tokens: Int = 4096
      temperature: Float?
      system: String?
    }
    output {
      content: String from "content/0/text"
      model: String from "model"
      stop_reason: AnthropicStopReason from "stop_reason"
      input_tokens: Int from "usage/input_tokens"
      output_tokens: Int from "usage/output_tokens"
    }
    transport rest {
      method: POST,
      path: "/v1/messages",
      body: { model: model, messages: messages, max_tokens: max_tokens, temperature: temperature, system: system },
      headers: { "anthropic-version": current_api_version.version }
    }
    response {
      200 => AnthropicMessages200Body
      400 => AnthropicErrorShape
      401 => AnthropicErrorShape
      403 => AnthropicErrorShape
      404 => AnthropicErrorShape
      429 => AnthropicErrorShape
      529 => AnthropicErrorShape
      5xx => AnthropicErrorShape
    }
    mock_response {
      200 => { id: "msg_mock123", type: "message", role: "assistant", content: [{ type: "text", text: "Mock response from Claude" }], model: "claude-sonnet-4-6-20250929", stop_reason: "end_turn", usage: { input_tokens: 25, output_tokens: 10 } } "Successful completion",
      400 => { type: "error", error: { type: "invalid_request_error", message: "messages: field required" } } "Invalid request body",
      401 => { type: "error", error: { type: "authentication_error", message: "invalid x-api-key" } } "Invalid API key",
      429 => { type: "error", error: { type: "rate_limit_error", message: "Rate limit exceeded" } } "Rate limited",
      529 => { type: "error", error: { type: "overloaded_error", message: "Overloaded" } } "Server overloaded"
    }
  }
}
