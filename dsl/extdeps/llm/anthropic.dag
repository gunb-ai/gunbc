// extdeps/llm/anthropic.dag — Anthropic Messages API protocol (types + wire contracts).
//
// Handlers (REST + Claude CLI): `anthropic_rest.dag` (`module extdeps.llm.anthropic_rest`).
// Cross-provider facts: `llm.dag` (`module extdeps.llm.llm`).
// Error envelope: `anthropic_errors.dag`.
//
module extdeps.llm.anthropic

import extdeps.llm.llm { llm_snake_wire_contract }
import std.serialization { CoproductWireContract, VariantEncoding }
import std.types { NonEmptyStr }

// Wire contract: Anthropic API returns enum values as snake_case strings.
data wire_contract: VariantEncoding = llm_snake_wire_contract

data anthropic_chat_message_wire_contract: CoproductWireContract = {
  coproduct: "AnthropicChatMessage",
  encoding: InternallyTaggedObject { tag_field: "role", naming: StripSuffixAndSnakeCase { suffix: "Message" } }
}

data anthropic_user_content_block_wire_contract: CoproductWireContract = {
  coproduct: "AnthropicUserContentBlock",
  encoding: InternallyTaggedObject { tag_field: "type", naming: StripPrefixSuffixAndSnakeCase { prefix: "User", suffix: "Block" } }
}

data anthropic_assistant_content_block_wire_contract: CoproductWireContract = {
  coproduct: "AnthropicAssistantContentBlock",
  encoding: InternallyTaggedObject { tag_field: "type", naming: StripPrefixSuffixAndSnakeCase { prefix: "Assistant", suffix: "Block" } }
}

data anthropic_messages_200_content_block_wire_contract: CoproductWireContract = {
  coproduct: "AnthropicMessages200ContentBlock",
  encoding: InternallyTaggedObject { tag_field: "type", naming: StripPrefixSuffixAndSnakeCase { prefix: "Messages", suffix: "Block" } }
}

// Tool-result nested content: REST wire is either a scalar JSON string or a JSON
// array of typed content blocks (Messages API `tool_result.content`).
data anthropic_tool_result_content_wire_contract: CoproductWireContract = {
  coproduct: "AnthropicToolResultContent",
  encoding: UntaggedVariant
}

// Nested blocks inside `ToolResultBlocks`: each row is a flat `{"type": ...}` object
// (same tagging discipline as user message content blocks; distinct carrier so shared
// provider-local nested blocks; not a cross-provider carrier).
data anthropic_tool_result_block_wire_contract: CoproductWireContract = {
  coproduct: "AnthropicToolResultBlock",
  encoding: InternallyTaggedObject { tag_field: "type", naming: StripPrefixSuffixAndSnakeCase { prefix: "Anthropic", suffix: "Block" } }
}

// -- Models --------------------------------------------------------

type AnthropicModel
  = ClaudeHaiku4_5
  | ClaudeSonnet4_6
  | ClaudeOpus4_6

type AnthropicModelSpec {
  model: AnthropicModel
  model_id: String
  context_window: Int
  max_output_tokens: Int
}

data models: List<AnthropicModelSpec> = [
  { model: ClaudeHaiku4_5, model_id: "claude-haiku-4-5-20251001", context_window: 200000, max_output_tokens: 64000 },
  { model: ClaudeSonnet4_6, model_id: "claude-sonnet-4-6-20250929", context_window: 200000, max_output_tokens: 64000 },
  { model: ClaudeOpus4_6, model_id: "claude-opus-4-6-20251101", context_window: 200000, max_output_tokens: 64000 }
]

// -- Anthropic content blocks (provider-specific) ---------------------
// Tool-use / tool-result surfaces are Anthropic-specific. `ImageSource`
// models Anthropic Messages API image `source` shapes (base64 / url; file deferred).

// Anthropic Messages image `source` base64 media types (extensible registry).
type AnthropicImageMediaType
  = ImageJpeg
  | ImagePng
  | ImageGif
  | ImageWebp
  | AnthropicImageMediaTypeOther { raw: NonEmptyStr }

data anthropic_image_jpeg_wire: String = "image/jpeg"
data anthropic_image_png_wire: String = "image/png"
data anthropic_image_gif_wire: String = "image/gif"
data anthropic_image_webp_wire: String = "image/webp"

fn parse_anthropic_image_media_type(raw: String) -> AnthropicImageMediaType {
  if raw == anthropic_image_jpeg_wire { ImageJpeg }
  else if raw == anthropic_image_png_wire { ImagePng }
  else if raw == anthropic_image_gif_wire { ImageGif }
  else if raw == anthropic_image_webp_wire { ImageWebp }
  else { AnthropicImageMediaTypeOther { raw: raw } }
}

fn anthropic_image_media_type_label(kind: AnthropicImageMediaType) -> String {
  match kind {
    ImageJpeg => anthropic_image_jpeg_wire
    ImagePng => anthropic_image_png_wire
    ImageGif => anthropic_image_gif_wire
    ImageWebp => anthropic_image_webp_wire
    AnthropicImageMediaTypeOther { raw: r } => r
  }
}

// 🟡 SCAFFOLD provider-domain coproduct for Anthropic Messages image `source`
// (base64/url arms emittable via `llm.Anthropic.Messages`; dissolve on
// `structural_coverage_gap_anthropic_messages_file_image_beta_header`).
type ImageSource
  = Base64Image { media_type: AnthropicImageMediaType, data: String }
  | UrlImage { url: String }

// 🟢 TERMINAL provider-domain coproduct for tool-result content. Anthropic accepts
// either a scalar JSON string (`ToolResultText`) or a JSON array of nested blocks
// (`ToolResultBlocks`), matching Messages API `tool_result.content`. Tuple carriers
// pair with `anthropic_tool_result_content_wire_contract: UntaggedVariant` so serde
// untagged emission maps directly (string vs block array) without an extra object
// wrapper around the array arm.
//
// Nested block shapes use `AnthropicToolResultBlock` (below).
type AnthropicToolResultContent
  = ToolResultText(String)
  | ToolResultBlocks(List<AnthropicToolResultBlock>)

// Tool-result nested content blocks (provider-side carrier). Mirrors the union
// accepted inside `tool_result.content` arrays per Anthropic Messages API /
// generated SDK (`TextBlockParam | ImageBlockParam | DocumentBlockParam |
// SearchResultBlockParam | ToolReferenceBlockParam`).
//
// Singleton wire tag: nested `search_result.content[]` rows and plaintext document
// `source.type` both require the JSON string `"text"` (illegal states
// unrepresentable at the substrate boundary).
type AnthropicToolResultWireTextTag
  = Text {}

// Singleton: `PlainTextSourceParam.media_type` is the literal `"text/plain"` on the wire
// (illegal states unrepresentable — https://github.com/anthropics/anthropic-sdk-python/blob/main/src/anthropic/types/plain_text_source_param.py).
type AnthropicPlainTextDocumentMediaType
  = TextPlain {}

// Nested `search_result.content[]` rows per platform schema (each object carries
// wire `type: "text"` alongside `text` — https://platform.claude.com/docs/en/build-with-claude/search-results).
type AnthropicToolResultTextBlock {
  type: AnthropicToolResultWireTextTag
  text: String
}

// Optional `citations` object on `search_result` blocks (`enabled: Bool`).
type AnthropicSearchResultCitationsConfig {
  enabled: Bool
}

// 🟡 SCAFFOLD — nested `document` / `search_result` payloads are not full OpenAPI
// parity vs platform docs; honest residue on
// `structural_coverage_gap_anthropic_tool_result_nested_block_wire_payloads`.
//
// Dissolution trigger: promote to 🟢 TERMINAL when those residual rows are deleted or
// rewritten to explicit terminal closure on this authority **and** the five-arm
// `tool_result.content[]` discriminator surface is closed against the tracked public
// API / generated SDK (no remaining extension-only gap on this coproduct).
//
// Maintenance trigger (not dissolution): Anthropic adds a *sixth* top-level block kind
// beyond the five modeled arms → fold the new wire tag under
// `anthropic_tool_result_block_wire_contract` here, or escalate if the contract becomes
// non-additive.
type AnthropicToolResultBlock
  = AnthropicTextBlock { text: String }
  | AnthropicImageBlock { source: ImageSource }
  // Plaintext `source` only — not full DocumentBlockParam (extra document sources,
  // title/context/citations/cache_control, …). Tracked under
  // `structural_coverage_gap_anthropic_tool_result_nested_block_wire_payloads`.
  | AnthropicDocumentBlock { source: AnthropicToolResultPlainTextDocumentSource }
  | AnthropicSearchResultBlock {
      source: String
      title: String
      content: List<AnthropicToolResultTextBlock>
      citations: AnthropicSearchResultCitationsConfig?
      cache_control: CacheControl?
    }
  | AnthropicToolReferenceBlock { tool_name: String }

// Honest residue: nested tool-result **payload** fidelity vs generated SDK /
// OpenAPI (per-arm coordinates, not the five-way discriminator). Paid rows on
// `rest_request_wire_serde_alignment_receipt` cover coproduct discriminators +
// untagged `tool_result.content` dispatch — not every nested field on each arm.
// SDK witness (Stainless): `anthropic-sdk-python` `tool_result_block_param.Content`
// arms `TextBlockParam` / `ImageBlockParam` / `ToolReferenceBlockParam` carry optional
// `cache_control: CacheControlEphemeralParam`; `TextBlockParam` also carries optional
// `citations`; `CacheControlEphemeralParam` includes optional `ttl` literal (`5m`|`1h`)
// beyond our stringly `CacheControl.type` carrier — enumerate each omission below.
data structural_coverage_gap_anthropic_tool_result_nested_block_wire_payloads: List<String> = [
  "closure:anthropic_tool_result_nested_wire_payload|AnthropicToolResultBlock.AnthropicTextBlock|missing:cache_control|missing:citations|sdk:https://raw.githubusercontent.com/anthropics/anthropic-sdk-python/main/src/anthropic/types/text_block_param.py|trigger:model TextBlockParam cache_control + citations structurally on nested tool_result text rows",
  "closure:anthropic_tool_result_nested_wire_payload|AnthropicToolResultBlock.AnthropicImageBlock|missing:cache_control|sdk:https://raw.githubusercontent.com/anthropics/anthropic-sdk-python/main/src/anthropic/types/image_block_param.py|trigger:model ImageBlockParam cache_control on nested tool_result image rows",
  "closure:anthropic_tool_result_nested_wire_payload|AnthropicToolResultBlock.AnthropicToolReferenceBlock|missing:cache_control|sdk:https://raw.githubusercontent.com/anthropics/anthropic-sdk-python/main/src/anthropic/types/tool_reference_block_param.py|trigger:model ToolReferenceBlockParam cache_control on nested tool_result tool_reference rows",
  "closure:anthropic_tool_result_nested_wire_payload|AnthropicToolResultBlock|carrier:CacheControl|missing:ttl_literal_5m_1h|sdk:https://raw.githubusercontent.com/anthropics/anthropic-sdk-python/main/src/anthropic/types/cache_control_ephemeral_param.py|trigger:align nested-block CacheControlBreakpoint carrier with CacheControlEphemeralParam (ttl) wherever cache_control appears on tool_result nested arms",
  "closure:anthropic_tool_result_nested_wire_payload|AnthropicToolResultBlock.AnthropicDocumentBlock|residue:plaintext_document_source_only|missing:non_text_document_sources|missing:title_context_citations_cache_control|spec:https://platform.claude.com/docs/en/build-with-claude/citations|trigger:model DocumentBlockParam document sources and citation-facing coordinates structurally",
  "closure:anthropic_tool_result_nested_wire_payload|AnthropicToolResultBlock.AnthropicSearchResultBlock|external_spec_watch:search_result_block_optional_fields|trigger:citations.cache_control_shape_drift_or_additional_optional_keys_from_OpenAPI"
]

// Inline plaintext document source for tool-result document blocks (`source.type`
// is the fixed `"text"` wire slot — same singleton as nested search-result text rows).
type AnthropicToolResultPlainTextDocumentSource {
  type: AnthropicToolResultWireTextTag
  media_type: AnthropicPlainTextDocumentMediaType
  data: String
}

// 🟢 TERMINAL provider-domain coproduct for user-message content. `UserTextBlock`
// and `UserToolResultBlock` are role-legal Anthropic Messages content rows; the
// wire `type` keys are emitter/transport obligations, not caller-authored model
// state. Tool-result content is optional on the wire and, when present, is the
// explicit `AnthropicToolResultContent` coproduct above.
type AnthropicUserContentBlock
  = UserTextBlock { text: String }
  | UserToolResultBlock { tool_use_id: String, content: AnthropicToolResultContent?, is_error: Bool? }

// 🟢 TERMINAL provider-domain coproduct for assistant-message content.
// Assistants can emit text or tool-use requests; tool results are user rows.
type AnthropicAssistantContentBlock
  = AssistantTextBlock { text: String }
  | AssistantToolUseBlock { id: String, name: String, input: Json }

// -- System prompt -------------------------------------------------

// Anthropic API cache control: wire shape requires {"type": "ephemeral"}.
type CacheControlType
  = CacheEphemeral {}

data cache_control_ephemeral_wire: String = "ephemeral"

fn cache_control_type_label(kind: CacheControlType) -> String {
  match kind {
    CacheEphemeral {} => cache_control_ephemeral_wire
  }
}

type CacheControl {
  type: CacheControlType
}

type SystemPrompt {
  text: String
  cache_control: CacheControl?
}

// -- Extended thinking ---------------------------------------------

type ThinkingMode = Enabled | Disabled

type ThinkingConfig {
  type: ThinkingMode
  budget_tokens: Int?
}

// -- Tool definitions ----------------------------------------------

type AnthropicToolDefinition {
  name: String
  description: String
  input_schema: Json
}

// -- API versioning ------------------------------------------------

type AnthropicApiVersion {
  version: String
  header: String
}

data current_api_version: AnthropicApiVersion = {
  version: "2023-06-01",
  header: "anthropic-version"
}

// Messages API conversation row: the outer variant is the role discriminator,
// so role-specific content legality is structural. User rows can carry text or
// tool results; assistant rows can carry text or tool-use requests.
// 🟢 TERMINAL provider-domain coproduct for the modeled Messages row roles.
// Q4.5 P1 closure (#808 / #856 Substrate escalation).
type AnthropicChatMessage
  = UserMessage { content: List<AnthropicUserContentBlock> }
  | AssistantMessage { content: List<AnthropicAssistantContentBlock> }

// Narrow 200-OK wire slice for Messages (text-only `content[0]` path).
// Tool-use / image assistant rows remain outside this carrier.
// 🟢 TERMINAL response citation coproduct. Each citation variant carries only
// the documented coordinates for that wire tag.
type AnthropicMessages200Citation
  = CharLocation { cited_text: String, document_index: Int, document_title: String?, file_id: String?, start_char_index: Int, end_char_index: Int }
  | PageLocation { cited_text: String, document_index: Int, document_title: String?, file_id: String?, start_page_number: Int, end_page_number: Int }
  | ContentBlockLocation { cited_text: String, document_index: Int, document_title: String?, file_id: String?, start_block_index: Int, end_block_index: Int }
  | WebSearchResultLocation { cited_text: String, encrypted_index: String, title: String?, url: String }
  | SearchResultLocation { cited_text: String, source: String, title: String?, search_result_index: Int, start_block_index: Int, end_block_index: Int }

// 🟡 SCAFFOLD provider-domain coproduct for Anthropic Messages 200 `content[]`
// response rows. The outer wire shape is already stable and `type`-tagged, so
// these arms belong as a coproduct instead of optional coordinates on a text
// record. Scaffold triggers (also tracked in
// `structural_coverage_gap_anthropic_messages_200_residual` below):
// `MessagesWebSearchToolResultBlock.content` remains `Json` until the
// web-search result/error payload gains a structural payload coproduct, and
// `AnthropicMessages200Body.content/0/text` output projection needs
// variant-aware typed REST response-path support.
type AnthropicMessages200ContentBlock
  = MessagesTextBlock { text: String, citations: List<AnthropicMessages200Citation>? }
  | MessagesThinkingBlock { thinking: String, signature: String }
  | MessagesRedactedThinkingBlock { data: String }
  | MessagesToolUseBlock { id: String, name: String, input: Json, caller: Json? }
  | MessagesServerToolUseBlock { id: String, name: AnthropicServerToolName, input: Json, caller: Json? }
  | MessagesWebSearchToolResultBlock { tool_use_id: String, content: Json, caller: Json? }

// 🟡 SCAFFOLD provider-domain enum for Anthropic `server_tool_use.name`
// values mirrored from Anthropic's generated OpenAPI SDK schema. Scaffold
// trigger: retire or extend this row when Anthropic publishes additional
// `server_tool_use.name` values; per-tool input payload typing remains tracked
// by `server_tool_input_payloads_unmodeled`.
type AnthropicServerToolName = WebSearch | WebFetch | CodeExecution | BashCodeExecution | TextEditorCodeExecution | ToolSearchToolRegex | ToolSearchToolBm25 | Advisor

// 🟢 TERMINAL provider-domain enum for Anthropic Messages 200 `usage.service_tier`.
// Dissolution receipt: the field is a closed API string domain, not free-form
// metadata; fact placement would duplicate the usage field authority, algebraic
// form has no operator surface, and dimensional split has no independent axes.
type AnthropicMessages200ServiceTier = Standard | Priority | Batch

type AnthropicMessages200Usage {
  input_tokens: Int
  output_tokens: Int
  cache_creation_input_tokens: Int?
  cache_read_input_tokens: Int?
  service_tier: AnthropicMessages200ServiceTier?
}

// Anthropic Messages 200 response role. The API currently returns only
// "assistant"; keep the slot typed and let the module wire_contract serialize
// the unit variant as the required snake-case string.
type AnthropicMessages200Role
  = Assistant {}

// 🟢 TERMINAL provider-domain coproduct for Anthropic Messages `stop_reason`
// wire values. Dissolution receipt: fact placement fails because every value is
// the same response-field fact consumed at `stop_reason`; variant-is-data would
// demote Anthropic's closed API enum into free-form text; algebraic form has no
// std operation/ref target; dimensional split has no independent axes beyond the
// documented reason-token domain.
type AnthropicStopReason = EndTurn | MaxTokens | StopSequence | ToolUse | PauseTurn | Refusal | ModelContextWindowExceeded

// Message object envelope `type` — Anthropic returns only "message" today.
type AnthropicMessagesObjectType
  = MessagesObjectMessage {}

data anthropic_messages_object_message_wire: String = "message"

fn anthropic_messages_object_type_label(kind: AnthropicMessagesObjectType) -> String {
  match kind {
    MessagesObjectMessage {} => anthropic_messages_object_message_wire
  }
}

// Message object envelope for POST /v1/messages 200 responses per Anthropic docs
// (https://docs.anthropic.com/en/api/messages): `id`, `type`, `role`, `content`,
// `model`, `stop_reason`, optional `stop_sequence`, `usage`.
type AnthropicMessages200Body {
  id: String
  type: AnthropicMessagesObjectType
  role: AnthropicMessages200Role
  content: List<AnthropicMessages200ContentBlock>
  model: String
  stop_reason: AnthropicStopReason
  stop_sequence: String?
  usage: AnthropicMessages200Usage
  container: Json?
}

