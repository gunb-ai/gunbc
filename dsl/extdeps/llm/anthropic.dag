// Request wire: Messages API expects string `role` + flat `content[]` objects
// keyed by `type` (https://docs.anthropic.com/en/api/messages). These rows are
// now source-level `CoproductWireContract` authorities above; the v2 Rust
// emitter consumes them directly for serde attributes. Nested tool-result
// `content` uses `anthropic_tool_result_content_wire_contract` +
// `anthropic_tool_result_block_wire_contract` (paid below).
data rest_request_wire_serde_alignment_receipt: List<String> = [
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicChatMessage|paid:role_internally_tagged_object_user_assistant",
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicUserContentBlock|paid:type_internally_tagged_object_text_tool_result",
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicAssistantContentBlock|paid:type_internally_tagged_object_text_tool_use",
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicUserContentBlock.UserToolResultBlock.content|paid:tool_result_content_untagged_scalar_or_block_array",
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicToolResultBlock|paid:type_internally_tagged_object_tool_result_nested_blocks"
]

