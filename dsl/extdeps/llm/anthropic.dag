// extdeps/llm/anthropic.dag -- "What is the Anthropic API?"
//
// Anthropic-specific message format: content blocks, tool use,
// extended thinking, system prompts, API versioning.
//
// Complements extdeps/llm/pricing.dag (model specs and pricing)
// and extdeps/llm/core.dag (universal protocol types).
//
module extdeps.llm.anthropic

import extdeps.llm.llm { TokenUsage, llm_snake_wire_contract, ContentBlock }
import std.errors { AnthropicErrorShape }
import std.credentials { CredentialSource, EnvVar }
import std.serialization { VariantEncoding }
import std.types { HttpMethod }

// Wire contract: Anthropic API returns enum values as snake_case strings.
data wire_contract: VariantEncoding = llm_snake_wire_contract

// -- Models --------------------------------------------------------

type AnthropicModel
  = ClaudeHaiku4_5
  | ClaudeSonnet4_6
  | ClaudeOpus4_6

type AnthropicModelSpec {
  model: AnthropicModel
  model_id: String
  context_window: Int
  max_output_tokens: Int
}

data models: List<AnthropicModelSpec> = [
  { model: ClaudeHaiku4_5, model_id: "claude-haiku-4-5-20251001", context_window: 200000, max_output_tokens: 64000 },
  { model: ClaudeSonnet4_6, model_id: "claude-sonnet-4-6-20250929", context_window: 200000, max_output_tokens: 64000 },
  { model: ClaudeOpus4_6, model_id: "claude-opus-4-6-20251101", context_window: 200000, max_output_tokens: 64000 }
]

// -- Anthropic content blocks (provider-specific) ---------------------
// Extends the shared ContentBlock (llm.dag) with tool-use blocks.

// 🟢 TERMINAL provider-domain coproduct for tool-result content. Anthropic
// accepts either a scalar text result or a nested content-block list for image
// capable tool responses. This keeps scalar text as an explicit arm and reuses
// the shared `ContentBlock` coordinates for nested text/image blocks. Document,
// search-result, and tool-reference nested blocks remain gap-carried below.
type AnthropicToolResultContent
  = ToolResultText { text: String }
  | ToolResultBlocks { blocks: List<ContentBlock> }

data structural_coverage_gap_anthropic_tool_result_additive_blocks: List<String> = [
  "closure:anthropic_tool_result_additive_blocks|AnthropicToolResultContent.ToolResultBlocks|missing:document|missing:search_result|missing:tool_reference"
]

// 🟢 TERMINAL provider-domain coproduct for user-message content. `UserTextBlock`
// and `UserToolResultBlock` are role-legal Anthropic Messages content rows; the
// wire `type` keys are emitter/transport obligations, not caller-authored model
// state. Tool-result content is optional on the wire and, when present, is the
// explicit `AnthropicToolResultContent` coproduct above.
type AnthropicUserContentBlock
  = UserTextBlock { text: String }
  | UserToolResultBlock { tool_use_id: String, content: AnthropicToolResultContent?, is_error: Bool? }

// 🟢 TERMINAL provider-domain coproduct for assistant-message content.
// Assistants can emit text or tool-use requests; tool results are user rows.
type AnthropicAssistantContentBlock
  = AssistantTextBlock { text: String }
  | AssistantToolUseBlock { id: String, name: String, input: Json }

// -- System prompt -------------------------------------------------

// Anthropic API cache control: wire shape requires {"type": "ephemeral"}.
// Single-value discriminant, but the field must be present for API fidelity.
type CacheControl {
  type: String
}

type SystemPrompt {
  text: String
  cache_control: CacheControl?
}

// -- Extended thinking ---------------------------------------------

type ThinkingMode = Enabled | Disabled

type ThinkingConfig {
  type: ThinkingMode
  budget_tokens: Int?
}

// -- Tool definitions ----------------------------------------------

type AnthropicToolDefinition {
  name: String
  description: String
  input_schema: Json
}

// -- API versioning ------------------------------------------------

type AnthropicApiVersion {
  version: String
  header: String
}

data current_api_version: AnthropicApiVersion = {
  version: "2023-06-01",
  header: "anthropic-version"
}

// Messages API conversation row: the outer variant is the role discriminator,
// so role-specific content legality is structural. User rows can carry text or
// tool results; assistant rows can carry text or tool-use requests.
// 🟢 TERMINAL provider-domain coproduct for the modeled Messages row roles.
// Q4.5 P1 closure (#808 / #856 Substrate escalation).
type AnthropicChatMessage
  = UserMessage { content: List<AnthropicUserContentBlock> }
  | AssistantMessage { content: List<AnthropicAssistantContentBlock> }

// Narrow 200-OK wire slice for Messages (text-only `content[0]` path).
// Tool-use / image assistant rows remain outside this carrier.
type AnthropicMessages200TextBlock {
  type: String
  text: String
}

type AnthropicMessages200Usage {
  input_tokens: Int
  output_tokens: Int
}

// 🟢 TERMINAL provider-domain coproduct for Anthropic Messages `stop_reason`
// wire values. Dissolution receipt: fact placement fails because every value is
// the same response-field fact consumed at `stop_reason`; variant-is-data would
// demote Anthropic's closed API enum into free-form text; algebraic form has no
// std operation/ref target; dimensional split has no independent axes beyond the
// documented reason-token domain.
type AnthropicStopReason = EndTurn | MaxTokens | StopSequence | ToolUse | PauseTurn | Refusal | ModelContextWindowExceeded

// Message object envelope for POST /v1/messages 200 responses per Anthropic docs
// (https://docs.anthropic.com/en/api/messages): `id`, `type`, `role`, `content`,
// `model`, `stop_reason`, optional `stop_sequence`, `usage`. `AnthropicMessages200TextBlock`
// remains the narrow text slice inside `content[]`; thinking, tool_use, images,
// server tools, citations, and `usage` cache-token breakdowns stay gap-carried on
// `structural_coverage_gap_anthropic_messages_outputs`.
type AnthropicMessages200Body {
  id: String
  type: String
  role: String
  content: List<AnthropicMessages200TextBlock>
  model: String
  stop_reason: AnthropicStopReason
  stop_sequence: String?
  usage: AnthropicMessages200Usage
}

data structural_coverage_gap_anthropic_messages_outputs: List<String> = [
  "closure:anthropic_messages_200_residual|AnthropicMessages200Body|missing:container|AnthropicMessages200TextBlock|missing:thinking|missing:tool_use|missing:redacted_thinking|missing:web_search|missing:server_tool_use|missing:citations|AnthropicMessages200Usage|missing:cache_creation_input_tokens|missing:cache_read_input_tokens|missing:service_tier"
]

// Request wire: Messages API expects string `role` + flat `content[]` objects
// keyed by `type` (https://docs.anthropic.com/en/api/messages). `type` is not
// caller-authored model state on `TextBlock`; the future
// `rest_request_wire_serde_alignment` closure must emit it from the variant.
data structural_coverage_gap_anthropic_messages_request_wire: List<String> = [
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicChatMessage|residue:message_variant_must_emit_role_string_user_assistant",
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicUserContentBlock.UserTextBlock|residue:variant_must_emit_flat_type_text_wire_key",
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicAssistantContentBlock.AssistantTextBlock|residue:variant_must_emit_flat_type_text_wire_key",
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicAssistantContentBlock.AssistantToolUseBlock|residue:variant_must_emit_flat_type_tool_use_wire_key",
  "closure:rest_request_wire_serde_alignment|llm.Anthropic.Messages|AnthropicUserContentBlock.UserToolResultBlock|residue:variant_must_emit_flat_type_tool_result_wire_key"
]

// -- Service: REST transport wiring ------------------------------

service llm.Anthropic {
  config {
    endpoint: "https://api.anthropic.com"
    auth: Header("x-api-key")
    auth_input: api_key
    auth_source: EnvVar { name: "ANTHROPIC_API_KEY" }
    // Anthropic API rate limits: varies by tier (1000-4000 RPM), use conservative default
    rate_limit: { requests: 1000, per: minute, scope: messages }
    // Retry on overload and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 529] }
  }

  operation Messages {
    input {
      api_key: Secret
      model: String
      messages: List<AnthropicChatMessage>
      max_tokens: Int = 4096
      temperature: Float?
      system: String?
    }
    output {
      content: String from "content/0/text"
      model: String from "model"
      stop_reason: AnthropicStopReason from "stop_reason"
      input_tokens: Int from "usage/input_tokens"
      output_tokens: Int from "usage/output_tokens"
    }
    transport rest {
      method: POST,
      path: "/v1/messages",
      body: { model: model, messages: messages, max_tokens: max_tokens, temperature: temperature, system: system },
      headers: { "anthropic-version": current_api_version.version }
    }
    response {
      200 => AnthropicMessages200Body
      400 => AnthropicErrorShape
      401 => AnthropicErrorShape
      403 => AnthropicErrorShape
      404 => AnthropicErrorShape
      429 => AnthropicErrorShape
      529 => AnthropicErrorShape
      5xx => AnthropicErrorShape
    }
    mock_response {
      200 => { id: "msg_mock123", type: "message", role: "assistant", content: [{ type: "text", text: "Mock response from Claude" }], model: "claude-sonnet-4-6-20250929", stop_reason: "end_turn", usage: { input_tokens: 25, output_tokens: 10 } } "Successful completion",
      400 => { type: "error", error: { type: "invalid_request_error", message: "messages: field required" } } "Invalid request body",
      401 => { type: "error", error: { type: "authentication_error", message: "invalid x-api-key" } } "Invalid API key",
      429 => { type: "error", error: { type: "rate_limit_error", message: "Rate limit exceeded" } } "Rate limited",
      529 => { type: "error", error: { type: "overloaded_error", message: "Overloaded" } } "Server overloaded"
    }
  }
}
