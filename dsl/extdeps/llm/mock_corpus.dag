// dsl/extdeps/llm/mock_corpus.dag
// Scope: the llm layer's PUBLISHED mock corpus as a closed, declared structural fact.
// Anchor: DESIGN.md §3 (single authority) / §6 (model-just-in-time, mark the carrier).
//
// SINGLE authority for WHICH llm.OpenAI / llm.Anthropic / llm.Codex / llm.Gemini operations are
// hermetically realizable. Read by BOTH the compile-time M2 mock_totality_lens
// (src/v2/lens/mock_totality.dag, via the per-layer witness) AND the v1 runtime's eval_service_call
// (the M4 hermetic-realization fold) — one model, not two. The v1 runtime loads the dsl/ tree via
// the M4.1 whole-tree corpus load (#5236), so no per-service co-location import is required.
// Modeled on the M4.0 filesystem pilot (dsl/extdeps/filesystem/mock_corpus.dag, #5188).
//
// Per-SERVICE governance spans four services across three realization homes:
//   llm.OpenAI (openai_rest.dag) — REST ChatCompletion + Responses
//   llm.Anthropic (anthropic_rest.dag) — REST Messages + shell CliPrompt
//   llm.Codex / llm.Gemini (cli.dag) — shell CLI backends
// Every op that today carries an inline mock_response IS published below.
//
// Rows inhabit std.hermetic_replay.PublishedMockCase (all 4 fields: service, operation,
// operation_key, case_id). The operation set authority remains the service decls in
// dsl/extdeps/llm/{openai_rest,anthropic_rest,cli}.dag; per-case payloads live in the Phase-2
// RecordedFixture store ONLY — rows carry the structural key.

module extdeps.llm.mock_corpus

import std.hermetic_replay { PublishedMockCase }

data llm_openai_mock_case_chat_completion: PublishedMockCase = PublishedMockCase {
  operation_key: "llm.OpenAI.ChatCompletion",
  service: "llm.OpenAI",
  operation: "ChatCompletion",
  case_id: 0
}

data llm_openai_mock_case_responses: PublishedMockCase = PublishedMockCase {
  operation_key: "llm.OpenAI.Responses",
  service: "llm.OpenAI",
  operation: "Responses",
  case_id: 0
}

data llm_anthropic_mock_case_messages: PublishedMockCase = PublishedMockCase {
  operation_key: "llm.Anthropic.Messages",
  service: "llm.Anthropic",
  operation: "Messages",
  case_id: 0
}

data llm_anthropic_mock_case_cli_prompt: PublishedMockCase = PublishedMockCase {
  operation_key: "llm.Anthropic.CliPrompt",
  service: "llm.Anthropic",
  operation: "CliPrompt",
  case_id: 0
}

data llm_codex_mock_case_review: PublishedMockCase = PublishedMockCase {
  operation_key: "llm.Codex.Review",
  service: "llm.Codex",
  operation: "Review",
  case_id: 0
}

data llm_gemini_mock_case_cli_prompt: PublishedMockCase = PublishedMockCase {
  operation_key: "llm.Gemini.CliPrompt",
  service: "llm.Gemini",
  operation: "CliPrompt",
  case_id: 0
}

// 🟡 gated — feature:llm-mock-corpus-from-service-decl — bind node://adhoc-55fafd83-c6d
// dissolve-on-arrival: project this corpus directly from the `service llm.*` operation sets in
// dsl/extdeps/llm/{openai_rest,anthropic_rest,cli}.dag (the SINGLE authority for WHICH operations
// exist), joined with the Phase-2 RecordedFixture store (the authority for WHICH recorded cases exist
// per operation), once a v2 lens can read a service decl's operation nodes and the fixture store's
// keys; this declared list then deletes in the same PR. forbidden: a row carrying a response VALUE
// (chat body / stdout / stderr / error shapes) — that would fork the payload authority, now owned
// by the fixture store (§3); rows mirror the structural key ONLY, and grow when a published
// operation/case is added upstream.
data llm_published_mock_corpus: List<PublishedMockCase> = [
  llm_openai_mock_case_chat_completion,
  llm_openai_mock_case_responses,
  llm_anthropic_mock_case_messages,
  llm_anthropic_mock_case_cli_prompt,
  llm_codex_mock_case_review,
  llm_gemini_mock_case_cli_prompt
]
