// extdeps/llm/auth.dag -- LLM provider auth materialization for active workflows.
//
// Transitional until structural auth injection is fully lowered. The workflow
// surface consumes provider-auth modules rather than a shared credential helper.

module extdeps.llm.auth

import extdeps.cloud.gcp.core { shell.GCloud }
import std.types { NonEmptyStr }

fn llm_secret_name(provider: String) -> NonEmptyStr {
  match provider {
    "openai" => "openai-api-key"
    _ => "anthropic-api-key"
  }
}

func llm_api_key(
  provider: String,
  project_id: NonEmptyStr = "gunbai-secrets"
) -> { token: Secret } {
  secret = shell.GCloud.SecretManagerAccessVersion(
    project_id: project_id,
    secret_name: llm_secret_name(provider: provider)
  )

  return { token: secret.secret_value }
}
