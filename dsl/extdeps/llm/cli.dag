// extdeps/llm/cli.dag — non-Anthropic CLI LLM backends (shell transport).
//
// Spec: https://github.com/openai/codex (Codex CLI)
// Spec: https://github.com/google-gemini/gemini-cli (Gemini CLI)
//
// Anthropic (Claude Code CLI) lives on `llm.Anthropic.CliPrompt` in
// `anthropic_rest.dag` — one interface for REST + shell, not a forked `llm.Claude`.
//
// HONEST-MODELING DEBT (DESIGN.md §3, #5059 pattern): Gemini `CliPrompt` fuses
// `--output-format text` and `--approval-mode plan` as argv literals. The grammar
// supports `{var}` interpolation but not omitting flags when a value would disable
// them — parameterize when conditional argv lands (A1 transport-shape de-fusion).
//
// Consumers:
//   gunbc/tools/review_codex.dag — Codex CLI PR review workflow

module extdeps.llm.cli

// -- Codex CLI --------------------------------------------------------
//
// Codex reads prompt from stdin, executes in a working directory,
// writes structured output. Uses OpenAI auth (OPENAI_API_KEY env var).

service llm.Codex {
  operation Review {
    input {
      prompt: String
      cwd: String
      model: String = "o4-mini"
      reasoning_effort: String = "high"
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "codex", "exec",
        "-m", "{model}",
        "-c", "model_reasoning_effort=\"{reasoning_effort}\"",
        "-C", "{cwd}",
        "-"
      ]
      stdin: prompt
    }
    exit {
      0 => Unit
      nonzero => String "Codex CLI failed"
    }
    mock_response {
      0 => { success: true, stdout: "No significant issues found.\n\nPR-COMMENT: LGTM, clean implementation.", stderr: "" } "Successful review"
    }
  }
}

// -- Gemini CLI -------------------------------------------------------
//
// Gemini accepts prompt as a positional argument. Uses Google auth.

service llm.Gemini {
  operation CliPrompt {
    input {
      prompt: String
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "gemini", "-p", "{prompt}",
        "--output-format", "text",
        "--approval-mode", "plan"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "Gemini CLI failed"
    }
    mock_response {
      0 => { success: true, stdout: "Review summary.\n\nPR-COMMENT: Looks good.", stderr: "" } "Successful CLI prompt"
    }
  }
}
