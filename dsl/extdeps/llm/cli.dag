module extdeps.llm.cli

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openai/codex"
  }
}

service llm.Codex {
  operation Review {
    input {
      prompt: String
      cwd: String
      model: String = "o4-mini"
      reasoning_effort: String = "high"
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "codex", "exec",
        "-m", "{model}",
        "-c", "model_reasoning_effort=\"{reasoning_effort}\"",
        "-C", "{cwd}",
        "-"
      ]
      stdin: prompt
    }
    exit {
      0 => Unit
      nonzero => String "Codex CLI failed"
    }
  }
}

service llm.Gemini {
  operation CliPrompt {
    input {
      prompt: String
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "gemini", "-p", "{prompt}",
        "--output-format", "text",
        "--approval-mode", "plan"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "Gemini CLI failed"
    }
  }
}
