// extdeps/llm/cli.dag -- CLI LLM backends (shell transport)
//
// Spec: https://github.com/openai/codex (Codex CLI)
// Spec: https://docs.anthropic.com/en/docs/claude-code (Claude CLI)
// Spec: https://github.com/google-gemini/gemini-cli (Gemini CLI)
//
// Each CLI tool has different argument conventions but the same
// fundamental pattern: prompt in, review text out. These are modeled
// as separate services (not a unified interface) because the argument
// shapes, auth mechanisms, and output formats differ.
//
// Consumers:
//   gunbc/tools/review.dag -- PR review workflow

module extdeps.llm.cli

// -- Codex CLI --------------------------------------------------------
//
// Codex reads prompt from stdin, executes in a working directory,
// writes structured output. Uses OpenAI auth (OPENAI_API_KEY env var).

service llm.Codex {
  operation Review {
    input {
      prompt: String
      cwd: String
      model: String = "o4-mini"
      reasoning_effort: String = "high"
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "codex", "exec",
        "-m", "{model}",
        "-c", "model_reasoning_effort=\"{reasoning_effort}\"",
        "-C", "{cwd}",
        "-"
      ]
      stdin: prompt
    }
    exit {
      0 => Unit
      nonzero => String "Codex CLI failed"
    }
    mock_response {
      0 => { success: true, stdout: "No significant issues found.\n\nPR-COMMENT: LGTM, clean implementation.", stderr: "" } "Successful review"
    }
  }
}

// -- Claude CLI -------------------------------------------------------
//
// Claude accepts prompt as a positional argument. Uses Anthropic auth
// (ANTHROPIC_API_KEY env var). Plan mode prevents file modifications.

service llm.Claude {
  operation Review {
    input {
      prompt: String
      model: String = "opus"
      effort: String = "max"
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "claude", "-p",
        "--output-format", "text",
        "--permission-mode", "plan",
        "--model", "{model}",
        "--effort", "{effort}",
        "{prompt}"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "Claude CLI failed"
    }
    mock_response {
      0 => { success: true, stdout: "Code review complete.\n\nPR-COMMENT: Clean changes, no issues found.", stderr: "" } "Successful review"
    }
  }
}

// -- Gemini CLI -------------------------------------------------------
//
// Gemini accepts prompt as a positional argument. Uses Google auth.
// Plan mode (approval-mode plan) prevents file modifications.

service llm.Gemini {
  operation Review {
    input {
      prompt: String
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "gemini", "-p", "{prompt}",
        "--output-format", "text",
        "--approval-mode", "plan"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "Gemini CLI failed"
    }
    mock_response {
      0 => { success: true, stdout: "Review summary.\n\nPR-COMMENT: Looks good.", stderr: "" } "Successful review"
    }
  }
}
