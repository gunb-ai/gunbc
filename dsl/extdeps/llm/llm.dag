// extdeps/llm/llm.dag — cross-provider LLM facts only.
//
// Provider-shaped types live in discrete homes:
//   extdeps/llm/anthropic.dag      — Anthropic protocol (types + wire contracts)
//   extdeps/llm/anthropic_rest.dag — Anthropic handlers (REST Messages + CLI CliPrompt)
//   extdeps/llm/cli.dag            — Codex / Gemini CLI only (Anthropic → anthropic_rest)
//   extdeps/llm/openai.dag         — OpenAI protocol
//   extdeps/llm/openai_rest.dag    — OpenAI REST transport
//
// Land a row here only when the fact is structurally shared across providers.

module extdeps.llm.llm

import std.serialization { VariantEncoding, StringVariant, VariantNaming, SnakeCase }

// Wire contract: Anthropic and OpenAI APIs return enum values as snake_case strings.
// Single authority for the shared `VariantEncoding` value; each provider module binds
// its own module-scoped `wire_contract` name for the emitter (`05_emit_rust.dag`).
data llm_snake_wire_contract: VariantEncoding = StringVariant { naming: SnakeCase }
