// extdeps/llm/openai.dag -- "What is the OpenAI API?"
//
// OpenAI-specific: models, response formats, tool choice,
// function calling, finish reasons.
//
// Complements extdeps/llm/pricing.dag (model specs and pricing)
// and extdeps/llm/core.dag (universal protocol types).
//
module extdeps.llm.openai

import extdeps.llm.llm { StopReason, TokenUsage, llm_snake_wire_contract }
import std.errors { OpenAiErrorShape }
import std.serialization { VariantEncoding }
import std.types { HttpMethod, AuthScheme }

// Wire contract: OpenAI API returns enum values as snake_case strings.
// Single authority: same `VariantEncoding` value as `extdeps.llm.llm` (`llm_snake_wire_contract`);
// module-local `wire_contract` is the per-module binding name the emitter resolves (`05_emit_rust.dag`).
data wire_contract: VariantEncoding = llm_snake_wire_contract

// -- Models --------------------------------------------------------

type OpenAiModel
  = Gpt4o
  | Gpt4oMini
  | O1
  | O3
  | O3Mini
  | O4Mini

type OpenAiModelSpec {
  model: OpenAiModel
  model_id: String
  context_window: Int
  max_output_tokens: Int
}

data models: List<OpenAiModelSpec> = [
  { model: Gpt4o, model_id: "gpt-4o", context_window: 128000, max_output_tokens: 16384 },
  { model: Gpt4oMini, model_id: "gpt-4o-mini", context_window: 128000, max_output_tokens: 16384 },
  { model: O1, model_id: "o1", context_window: 200000, max_output_tokens: 100000 },
  { model: O3, model_id: "o3", context_window: 200000, max_output_tokens: 100000 },
  { model: O3Mini, model_id: "o3-mini", context_window: 200000, max_output_tokens: 100000 },
  { model: O4Mini, model_id: "o4-mini", context_window: 200000, max_output_tokens: 100000 }
]

// -- Response format -----------------------------------------------

type ResponseFormat
  = TextFormat
  | JsonObjectFormat
  | JsonSchemaFormat { schema: Json }

// -- Tool choice ---------------------------------------------------

type ToolChoice
  = ToolChoiceAuto
  | ToolChoiceNone
  | ToolChoiceRequired
  | ToolChoiceNamed { name: String }

// -- Finish reasons ------------------------------------------------

type OpenAiFinishReason = Stop | Length | ToolCalls | ContentFilter

// -- Function calling ----------------------------------------------

type FunctionCall {
  name: String
  arguments: String
}

// OpenAI tool call: wire shape requires {"type": "function", ...}.
// Single-value discriminant, but the field must be present for API fidelity.
type ToolCall {
  id: String
  type: String
  function: FunctionCall
}

// Roles on Chat Completions `messages[]` for this **narrow string-content**
// carrier: system / developer / user / assistant per OpenAI Chat Completions
// (https://platform.openai.com/docs/api-reference/chat/create). Tool rows and
// multimodal `content` arrays are not modeled here — gap-carried below.
// 🟢 TERMINAL provider-domain coproduct for the modeled narrow text-message
// row. Full Chat Completions message variants remain gap-carried by
// `structural_coverage_gap_openai_chat_message_full_api_surface`.
//
// Request wire for this row (`messages[].role` as system/developer/user/assistant)
// is ratcheted by pipeline tests in `src/v2/tests/src/pipeline.rs`:
// `openai_chat_message_role_wire_matches_llm_snake_contract` (emitted serde attrs)
// and `openai_chat_message_row_json_matches_chat_completions_wire_tags` (golden JSON).
type OpenAiChatMessageRole = System | Developer | User | Assistant

// Chat Completions API message row: wire accepts plain-string `content` for
// text-only payloads (OpenAI docs). Typed here so callers cannot pass opaque
// Json; multimodal rows extend this product when needed (Q4.5 P1 / #808).
type OpenAiChatMessage {
  role: OpenAiChatMessageRole
  content: String
}

// Narrow 200-OK wire slice for Chat Completions (`response { 200 => … }` + serde).
// Tool calls / multimodal message bodies remain outside this carrier (same narrow
// slice as the historical `from` JSON-pointer paths).
type OpenAiChatCompletion200TopLogprob {
  token: String
  bytes: List<Int>?
  logprob: Float
}

type OpenAiChatCompletion200TokenLogprob {
  token: String
  bytes: List<Int>?
  logprob: Float
  top_logprobs: List<OpenAiChatCompletion200TopLogprob>
}

type OpenAiChatCompletion200Logprobs {
  content: List<OpenAiChatCompletion200TokenLogprob>?
  refusal: List<OpenAiChatCompletion200TokenLogprob>?
}

type OpenAiChatCompletion200UrlCitation {
  start_index: Int
  end_index: Int
  title: String
  url: String
}

type OpenAiChatCompletion200Annotation {
  type: String
  url_citation: OpenAiChatCompletion200UrlCitation?
}

type OpenAiChatCompletion200Message {
  role: String
  content: String
  refusal: String?
  annotations: List<OpenAiChatCompletion200Annotation>?
}

type OpenAiChatCompletion200Choice {
  index: Int
  message: OpenAiChatCompletion200Message
  logprobs: OpenAiChatCompletion200Logprobs?
  finish_reason: OpenAiFinishReason
}

type OpenAiChatCompletion200CompletionTokenDetails {
  accepted_prediction_tokens: Int?
  audio_tokens: Int?
  reasoning_tokens: Int?
  rejected_prediction_tokens: Int?
}

type OpenAiChatCompletion200PromptTokenDetails {
  audio_tokens: Int?
  cached_tokens: Int?
}

type OpenAiChatCompletion200Usage {
  prompt_tokens: Int
  completion_tokens: Int
  total_tokens: Int
  completion_tokens_details: OpenAiChatCompletion200CompletionTokenDetails?
  prompt_tokens_details: OpenAiChatCompletion200PromptTokenDetails?
}

// Chat completion **object** envelope per OpenAI Chat Completions reference
// (https://platform.openai.com/docs/api-reference/chat/object): `id`, `object`,
// `created`, `model`, `choices`, `usage`. `OpenAiChatCompletion200Message` is
// still a narrow text slice of each `choices[].message`; richer tool-call,
// multimodal, and audio surfaces remain covered by downstream typed-carrier
// closure rows.
type OpenAiChatCompletion200Body {
  id: String
  object: String
  created: Int
  model: String
  choices: List<OpenAiChatCompletion200Choice>
  usage: OpenAiChatCompletion200Usage
  service_tier: String?
  system_fingerprint: String?
}

// Residuals outside `OpenAiChatCompletion200Body` / nested narrow slices. The
// remaining entries are variant-shaped provider surfaces: tool/function calls,
// audio, and multimodal content need coproduct modeling rather than optional
// coordinates on the current text-message carrier.
data structural_coverage_gap_openai_chat_completion_200_residual: List<String> = [
  "closure:openai_chat_completion_200_residual|OpenAiChatCompletion200Message|variant_pending:tool_calls|variant_pending:function_call|variant_pending:audio|variant_pending:non_string_content|trigger:model response content/tool/audio coproduct surface"
]

// Full Chat Completions message coproduct (tool_call_id, tool role, function,
// multimodal content parts) is not this row — downstream closure trigger.
data structural_coverage_gap_openai_chat_message_full_api_surface: List<String> = [
  "closure:openai_chat_message_full_coproduct|OpenAiChatMessage|missing:tool_role_with_tool_call_id|missing:function_role|missing:multimodal_content_array"
]

// Narrow 200-OK wire slice for OpenAI Responses (`response { 200 => … }`).
// The operation's current projections read text-output and usage token counts,
// so this carrier models the stable message/output_text path plus token-detail
// usage rows. Tool, reasoning-detail, error, and multimodal output item variants
// remain outside this proof-of-shape slice.
type OpenAiResponses200OutputContent {
  type: String
  text: String?
  annotations: List<OpenAiChatCompletion200Annotation>?
}

type OpenAiResponses200OutputItem {
  id: String?
  type: String
  status: String?
  role: String?
  content: List<OpenAiResponses200OutputContent>?
}

type OpenAiResponses200InputTokenDetails {
  cached_tokens: Int?
}

type OpenAiResponses200OutputTokenDetails {
  reasoning_tokens: Int?
}

type OpenAiResponses200Usage {
  input_tokens: Int
  output_tokens: Int
  total_tokens: Int?
  input_tokens_details: OpenAiResponses200InputTokenDetails?
  output_tokens_details: OpenAiResponses200OutputTokenDetails?
}

type OpenAiResponses200Body {
  id: String
  object: String
  created_at: Int?
  status: String?
  model: String
  output: List<OpenAiResponses200OutputItem>
  usage: OpenAiResponses200Usage
  service_tier: String?
}

// -- Service: REST transport wiring ------------------------------

service llm.OpenAI {
  config {
    endpoint: "https://api.openai.com"
    auth: Bearer
    auth_input: api_key
    // OpenAI API rate limits: varies by tier (500-3500 RPM), use conservative default
    rate_limit: { requests: 500, per: minute, scope: chat }
    // Retry on rate limit and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503] }
  }

  operation ChatCompletion {
    input {
      api_key: Secret
      model: String
      messages: List<OpenAiChatMessage>
      temperature: Float?
      max_tokens: Int?
    }
    output {
      content: String from "choices/0/message/content"
      model: String from "model"
      finish_reason: OpenAiFinishReason from "choices/0/finish_reason"
      prompt_tokens: Int from "usage/prompt_tokens"
      completion_tokens: Int from "usage/completion_tokens"
    }
    transport rest {
      method: POST,
      path: "/v1/chat/completions",
      body: { model: model, messages: messages, temperature: temperature, max_tokens: max_tokens }
    }
    response {
      200 => OpenAiChatCompletion200Body
      400 => OpenAiErrorShape
      401 => OpenAiErrorShape
      403 => OpenAiErrorShape
      404 => OpenAiErrorShape
      429 => OpenAiErrorShape
      5xx => OpenAiErrorShape
    }
    mock_response {
      200 => { id: "chatcmpl-mock123", object: "chat.completion", created: 1710000000, choices: [{ index: 0, message: { role: "assistant", content: "Mock response from GPT" }, finish_reason: "stop" }], model: "gpt-4o", usage: { prompt_tokens: 20, completion_tokens: 8, total_tokens: 28 } } "Successful completion",
      400 => { error: { message: "Invalid request", type: "invalid_request_error", code: null } } "Invalid request",
      401 => { error: { message: "Incorrect API key provided", type: "invalid_api_key", code: "invalid_api_key" } } "Invalid API key",
      429 => { error: { message: "Rate limit reached", type: "rate_limit_exceeded", code: "rate_limit_exceeded" } } "Rate limited"
    }
  }

  operation Responses {
    input {
      api_key: Secret
      model: String
      input: Json
      instructions: String?
      max_output_tokens: Int?
    }
    output {
      content: String from "output/0/content/0/text"
      model: String from "model"
      output_tokens: Int from "usage/output_tokens"
      input_tokens: Int from "usage/input_tokens"
    }
    transport rest {
      method: POST,
      path: "/v1/responses",
      body: { model: model, input: input, instructions: instructions, max_output_tokens: max_output_tokens }
    }
    response {
      200 => OpenAiResponses200Body
      400 => OpenAiErrorShape
      401 => OpenAiErrorShape
      403 => OpenAiErrorShape
      404 => OpenAiErrorShape
      429 => OpenAiErrorShape
      5xx => OpenAiErrorShape
    }
    mock_response {
      200 => { id: "resp_mock123", object: "response", output: [{ type: "message", content: [{ type: "text", text: "Mock response" }] }], model: "gpt-4o", usage: { input_tokens: 15, output_tokens: 5 } } "Successful response",
      400 => { error: { message: "Invalid request", type: "invalid_request_error", code: null } } "Invalid request",
      401 => { error: { message: "Incorrect API key", type: "invalid_api_key", code: "invalid_api_key" } } "Invalid API key",
      429 => { error: { message: "Rate limit reached", type: "rate_limit_exceeded", code: "rate_limit_exceeded" } } "Rate limited"
    }
  }
}

