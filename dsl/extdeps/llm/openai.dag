// extdeps/llm/openai.dag -- "What is the OpenAI API?"
//
// OpenAI-specific: models, response formats, tool choice,
// function calling, finish reasons.
//
// Complements extdeps/llm/pricing.dag (model specs and pricing)
// and extdeps/llm/core.dag (universal protocol types).
//
// Consumers:
//   tools/design.dag — design generation

module extdeps.llm.openai

import extdeps.llm.core { Role, StopReason, TokenUsage }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}
import std.errors { OpenAiErrorShape }

// ── Models ────────────────────────────────────────────────────────

type OpenAiModel
  = Gpt4o
  | Gpt4oMini
  | O1
  | O3
  | O3Mini
  | O4Mini

type OpenAiModelSpec {
  model: OpenAiModel
  model_id: String
  context_window: Int
  max_output_tokens: Int
}

data models: List<OpenAiModelSpec> = [
  { model: Gpt4o, model_id: "gpt-4o", context_window: 128000, max_output_tokens: 16384 },
  { model: Gpt4oMini, model_id: "gpt-4o-mini", context_window: 128000, max_output_tokens: 16384 },
  { model: O1, model_id: "o1", context_window: 200000, max_output_tokens: 100000 },
  { model: O3, model_id: "o3", context_window: 200000, max_output_tokens: 100000 },
  { model: O3Mini, model_id: "o3-mini", context_window: 200000, max_output_tokens: 100000 },
  { model: O4Mini, model_id: "o4-mini", context_window: 200000, max_output_tokens: 100000 }
]

// ── Response format ───────────────────────────────────────────────

type ResponseFormat
  = TextFormat
  | JsonObjectFormat
  | JsonSchemaFormat { schema: Json }

// ── Tool choice ───────────────────────────────────────────────────

type ToolChoice
  = ToolChoiceAuto
  | ToolChoiceNone
  | ToolChoiceRequired
  | ToolChoiceNamed { name: String }

// ── Finish reasons ────────────────────────────────────────────────

type OpenAiFinishReason = Stop | Length | ToolCalls | ContentFilter

// ── Function calling ──────────────────────────────────────────────

type FunctionCall {
  name: String
  arguments: String
}

type ToolCall {
  id: String
  type: String
  function: FunctionCall
}

// ── Operation behaviors ───────────────────────────────────────────

type OpenAiOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<OpenAiOperationBehavior> = [
  {
    operation: "chat_completion",
    behavior: {
      side_effects: WritesExternal,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [
        { name: "RateLimited", condition: "too_many_requests", http_status: 429, recoverable: true, retry_safe: true },
        { name: "ServerError", condition: "internal_error", http_status: 500, recoverable: true, retry_safe: true },
        { name: "InvalidRequest", condition: "malformed_input", http_status: 400, recoverable: false, retry_safe: false },
        { name: "AuthError", condition: "invalid_api_key", http_status: 401, recoverable: false, retry_safe: false },
        { name: "ContentFiltered", condition: "safety_filter_triggered", http_status: 400, recoverable: false, retry_safe: false }
      ],
      edge_cases: [
        { description: "JSON mode may produce partial JSON if max_tokens is hit", trigger: "json_mode_truncation", severity: High },
        { description: "reasoning models (o1/o3) do not support temperature or system messages", trigger: "reasoning_model", severity: Medium }
      ],
      confidence: Documented,
      prerequisites: [{ description: "valid OpenAI API key", kind: Credential }],
      assumptions: [],
      unknowns: ["Exact behavior of content_filter finish reason across models"]
    }
  },
  {
    operation: "responses",
    behavior: {
      side_effects: WritesExternal,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [
        { name: "RateLimited", condition: "too_many_requests", http_status: 429, recoverable: true, retry_safe: true },
        { name: "InvalidRequest", condition: "malformed_input", http_status: 400, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "valid OpenAI API key", kind: Credential }],
      assumptions: [],
      unknowns: []
    }
  }
]

// ── Service: REST transport wiring ──────────────────────────────

service llm.OpenAI {
  config {
    endpoint: "https://api.openai.com"
    auth: BearerToken
    // OpenAI API rate limits: varies by tier (500-3500 RPM), use conservative default
    rate_limit: { requests: 500, per: minute, scope: chat }
    // Retry on rate limit and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503] }
  }

  operation ChatCompletion {
    input {
      model: String
      messages: Json
      temperature: Float?
      max_tokens: Int?
    }
    output {
      content: String from "choices/0/message/content"
      model: String from "model"
      finish_reason: String from "choices/0/finish_reason"
      prompt_tokens: Int from "usage/prompt_tokens"
      completion_tokens: Int from "usage/completion_tokens"
    }
    transport rest { method: POST, path: "/v1/chat/completions" }
    response {
      200 => Json
      400 => OpenAiErrorShape
      401 => OpenAiErrorShape
      403 => OpenAiErrorShape
      404 => OpenAiErrorShape
      429 => OpenAiErrorShape
      5xx => OpenAiErrorShape
    }
  }

  operation Responses {
    input {
      model: String
      input: Json
      instructions: String?
      max_output_tokens: Int?
    }
    output {
      content: String from "output/0/content/0/text"
      model: String from "model"
      output_tokens: Int from "usage/output_tokens"
      input_tokens: Int from "usage/input_tokens"
    }
    transport rest { method: POST, path: "/v1/responses" }
    response {
      200 => Json
      400 => OpenAiErrorShape
      401 => OpenAiErrorShape
      403 => OpenAiErrorShape
      404 => OpenAiErrorShape
      429 => OpenAiErrorShape
      5xx => OpenAiErrorShape
    }
  }
}

// ── Tests ──────────────────────────────────────────────────────────
//
// Multiple test cases for different scenarios: basic, code review,
// and provider variants (OpenAI, Anthropic).
//
// NOTE: Provider-specific response formats and cloud credential composition
// still use Rust helpers via @rust_mock_helpers.

// Shared cloud environment for GCP WIF credential resolution.
fixture llm_cloud_env {
    mock cloud_env.config -> { provider: "gcp", runtime: "local-dev", audience: "local-dev", project_or_account: "mock-secrets" }
    mock cloud_env.request_url -> "https://example.com/oidc"
    mock cloud_env.credential -> { token: "<MOCK_API_KEY>", source_type: "static", scheme: "bearer" }
}

test openai_chat_completion : llm_cloud_env {

    // Inputs
    input chat_completion/prepare.provider -> "openai"
    input chat_completion/prepare.model -> "gpt-4o"
    input chat_completion/prepare.messages -> [{ role: "user", content: "Hello" }]

    // Transport mock: OpenAI response format
    mock chat_completion/execute.response -> rest_response(200, {
        choices: [{ message: { content: "Hello! How can I help you?" }, finish_reason: "stop" }],
        model: "gpt-4o",
        usage: { prompt_tokens: 10, completion_tokens: 20 }
    })

    expect result.content is String
    expect result.model == "gpt-4o"
    expect result.finish_reason == "Stop"
}

test anthropic_chat_completion : llm_cloud_env {

    // Inputs
    input chat_completion/prepare.provider -> "anthropic"
    input chat_completion/prepare.model -> "claude-sonnet-4-20250514"
    input chat_completion/prepare.messages -> [{ role: "user", content: "Hello" }]

    // Transport mock: Anthropic response format
    mock chat_completion/execute.response -> rest_response(200, {
        content: [{ type: "text", text: "Hello! I'm Claude." }],
        model: "claude-sonnet-4-20250514",
        stop_reason: "end_turn",
        usage: { input_tokens: 10, output_tokens: 15 }
    })

    expect result.content is String
    expect result.model == "claude-sonnet-4-20250514"
    expect result.finish_reason == "Stop"
}

test code_review_completion : llm_cloud_env {

    // Inputs
    input chat_completion/prepare.provider -> "openai"
    input chat_completion/prepare.model -> "gpt-4o"
    input chat_completion/prepare.messages -> [{ role: "system", content: "Review this code" }, { role: "user", content: "fn main() {}" }]

    // Transport mock: review response
    mock chat_completion/execute.response -> rest_response(200, {
        choices: [{ message: { content: "The code looks good. No issues found." }, finish_reason: "stop" }],
        model: "gpt-4o",
        usage: { prompt_tokens: 50, completion_tokens: 30 }
    })

    expect result.content contains "No issues found"
}
