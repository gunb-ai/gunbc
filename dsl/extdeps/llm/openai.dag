// extdeps/llm/openai.dag — OpenAI Chat Completions / Responses protocol (types + wire contracts).
//
// REST transport binding: `openai_rest.dag` (`module extdeps.llm.openai_rest`).
// Cross-provider facts: `llm.dag` (`module extdeps.llm.llm`).
// Error envelope: `openai_errors.dag`.
//
module extdeps.llm.openai

import extdeps.llm.llm { llm_snake_wire_contract }
import std.serialization { CoproductWireContract, VariantEncoding }
import std.types { NonEmptyStr }

// Wire contract: OpenAI API returns enum values as snake_case strings.
// Single authority: `extdeps.llm.llm` (`llm_snake_wire_contract`); module-local
// `wire_contract` is the per-module binding name the emitter resolves (`05_emit_rust.dag`).
data wire_contract: VariantEncoding = llm_snake_wire_contract

data openai_chat_message_wire_contract: CoproductWireContract = {
  coproduct: "OpenAiChatMessage",
  encoding: InternallyTaggedObject { tag_field: "role", naming: StripPrefixAndSnakeCase { prefix: "OpenAiChatMessage" } }
}

data openai_chat_message_part_wire_contract: CoproductWireContract = {
  coproduct: "OpenAiChatMessagePart",
  encoding: InternallyTaggedObject { tag_field: "type", naming: StripPrefixSuffixAndSnakeCase { prefix: "OpenAiChatMessage", suffix: "Part" } }
}

data openai_chat_message_content_wire_contract: CoproductWireContract = {
  coproduct: "OpenAiChatMessageContent",
  encoding: UntaggedVariant
}

// -- Models --------------------------------------------------------

type OpenAiModel
  = Gpt4o
  | Gpt4oMini
  | O1
  | O3
  | O3Mini
  | O4Mini

type OpenAiModelSpec {
  model: OpenAiModel
  model_id: String
  context_window: Int
  max_output_tokens: Int
}

data models: List<OpenAiModelSpec> = [
  { model: Gpt4o, model_id: "gpt-4o", context_window: 128000, max_output_tokens: 16384 },
  { model: Gpt4oMini, model_id: "gpt-4o-mini", context_window: 128000, max_output_tokens: 16384 },
  { model: O1, model_id: "o1", context_window: 200000, max_output_tokens: 100000 },
  { model: O3, model_id: "o3", context_window: 200000, max_output_tokens: 100000 },
  { model: O3Mini, model_id: "o3-mini", context_window: 200000, max_output_tokens: 100000 },
  { model: O4Mini, model_id: "o4-mini", context_window: 200000, max_output_tokens: 100000 }
]

// -- Response format -----------------------------------------------

type ResponseFormat
  = TextFormat
  | JsonObjectFormat
  | JsonSchemaFormat { schema: Json }

// -- Tool choice ---------------------------------------------------

type ToolChoice
  = ToolChoiceAuto
  | ToolChoiceNone
  | ToolChoiceRequired
  | ToolChoiceNamed { name: String }

// -- Finish reasons ------------------------------------------------

type OpenAiFinishReason = Stop | Length | ToolCalls | ContentFilter

// -- Function calling ----------------------------------------------

type FunctionCall {
  name: String
  arguments: String
}

// OpenAI tool call: wire shape requires {"type": "function", ...}.
// Extensible registry: closed known row + Other escape (fail-open ingress).
type OpenAiToolCallType
  = OpenAiToolCallFunction
  | OpenAiToolCallTypeOther { raw: NonEmptyStr }

data openai_tool_call_function_wire: String = "function"

fn parse_openai_tool_call_type(raw: String) -> OpenAiToolCallType {
  if raw == openai_tool_call_function_wire { OpenAiToolCallFunction }
  else { OpenAiToolCallTypeOther { raw: raw } }
}

fn openai_tool_call_type_label(kind: OpenAiToolCallType) -> String {
  match kind {
    OpenAiToolCallFunction => openai_tool_call_function_wire
    OpenAiToolCallTypeOther { raw: r } => r
  }
}

type ToolCall {
  id: String
  type: OpenAiToolCallType
  function: FunctionCall
}

// Roles on Chat Completions `messages[]`: system / developer / user /
// assistant / tool / function per OpenAI Chat Completions
// (https://platform.openai.com/docs/api-reference/chat/create).
// 🟢 TERMINAL provider-domain coproduct for modeled Chat Completions message
// roles. The value is projected from `OpenAiChatMessage` variant identity, not
// caller-authored as a free payload field.
//
// Request wire for this row (`messages[].role` as
// system/developer/user/assistant/tool/function) is ratcheted by pipeline tests
// in historical pipeline integration tests:
// `openai_chat_message_role_wire_matches_llm_snake_contract` (emitted serde attrs)
// and `openai_chat_message_row_json_matches_chat_completions_wire_tags` (golden JSON).
type OpenAiChatMessageRole = System | Developer | User | Assistant | Tool | Function

// 🟡 SCAFFOLD provider-domain coproduct for request `messages[].content`.
// Chat Completions accepts either a scalar text string or typed content parts.
// Wire uses untagged string-or-array alternatives via
// `openai_chat_message_content_wire_contract`; `OpenAiChatMessagePart` carries
// the tagged part rows. Trigger: split this content carrier by message role if
// OpenAI role-specific content-part legality is modeled structurally.
type OpenAiChatMessageContent
  = OpenAiChatMessageText { text: String }
  | OpenAiChatMessageParts { parts: List<OpenAiChatMessagePart> }

type OpenAiChatMessageImageUrl {
  url: String
  detail: String?
}

// 🟡 SCAFFOLD provider-domain coproduct for Chat Completions request content
// parts. Text and image_url close the original multimodal-content gap; audio,
// refusal, and file-like additive parts remain gap-carried by
// `structural_coverage_gap_openai_chat_message_additive_content_parts`.
type OpenAiChatMessagePart
  = OpenAiChatMessageTextPart { text: String }
  | OpenAiChatMessageImageUrlPart { image_url: OpenAiChatMessageImageUrl }

// Chat Completions API message row. Variant identity determines the wire `role`
// discriminator; role is deliberately not a payload field, so illegal rows like
// a tool payload with `role: User` are not structurally representable.
// 🟡 SCAFFOLD provider-domain coproduct for the current Chat Completions request
// message surface. Trigger: update this carrier when OpenAI request messages
// add new role variants or when assistant/tool custom-call payloads are lifted
// out of the residual rows below.
type OpenAiChatMessage
  = OpenAiChatMessageSystem { content: OpenAiChatMessageContent }
  | OpenAiChatMessageDeveloper { content: OpenAiChatMessageContent }
  | OpenAiChatMessageUser { content: OpenAiChatMessageContent }
  | OpenAiChatMessageAssistant { content: OpenAiChatMessageContent?, tool_calls: List<ToolCall>?, function_call: FunctionCall? }
  | OpenAiChatMessageTool { content: OpenAiChatMessageContent, tool_call_id: String }
  | OpenAiChatMessageFunction { content: String, name: String }

// Narrow 200-OK wire slice for Chat Completions (`response { 200 => … }` + serde).
// Tool calls / multimodal message bodies remain outside this carrier (same narrow
// slice as the historical `from` JSON-pointer paths).
type OpenAiChatCompletion200TopLogprob {
  token: String
  bytes: List<Int>?
  logprob: Float
}

type OpenAiChatCompletion200TokenLogprob {
  token: String
  bytes: List<Int>?
  logprob: Float
  top_logprobs: List<OpenAiChatCompletion200TopLogprob>
}

type OpenAiChatCompletion200Logprobs {
  content: List<OpenAiChatCompletion200TokenLogprob>?
  refusal: List<OpenAiChatCompletion200TokenLogprob>?
}

type OpenAiChatCompletion200UrlCitation {
  start_index: Int
  end_index: Int
  title: String
  url: String
}

// 🟢 TERMINAL response annotation coproduct for Chat Completions. The current
// provider wire exposes `type = "url_citation"` with required citation
// coordinates under `url_citation`.
type OpenAiChatCompletion200Annotation
  = UrlCitation { url_citation: OpenAiChatCompletion200UrlCitation }

type OpenAiChatCompletion200Message {
  role: String
  content: String
  refusal: String?
  annotations: List<OpenAiChatCompletion200Annotation>?
}

type OpenAiChatCompletion200Choice {
  index: Int
  message: OpenAiChatCompletion200Message
  logprobs: OpenAiChatCompletion200Logprobs?
  finish_reason: OpenAiFinishReason
}

type OpenAiChatCompletion200CompletionTokenDetails {
  accepted_prediction_tokens: Int?
  audio_tokens: Int?
  reasoning_tokens: Int?
  rejected_prediction_tokens: Int?
}

type OpenAiChatCompletion200PromptTokenDetails {
  audio_tokens: Int?
  cached_tokens: Int?
}

type OpenAiChatCompletion200Usage {
  prompt_tokens: Int
  completion_tokens: Int
  total_tokens: Int
  completion_tokens_details: OpenAiChatCompletion200CompletionTokenDetails?
  prompt_tokens_details: OpenAiChatCompletion200PromptTokenDetails?
}

// Chat completion **object** envelope per OpenAI Chat Completions reference
// (https://platform.openai.com/docs/api-reference/chat/object): `id`, `object`,
// `created`, `model`, `choices`, `usage`. `OpenAiChatCompletion200Message` is
// still a narrow text/refusal slice of each `choices[].message`; richer
// tool-call, multimodal, and audio surfaces remain covered by downstream
// typed-carrier closure rows.
type OpenAiChatCompletion200Body {
  id: String
  object: String
  created: Int
  model: String
  choices: List<OpenAiChatCompletion200Choice>
  usage: OpenAiChatCompletion200Usage
  service_tier: String?
  system_fingerprint: String?
}

// Residuals outside `OpenAiChatCompletion200Body` / nested narrow slices. The
// remaining entries are variant-shaped provider surfaces: tool/function calls,
// audio, and multimodal content need coproduct modeling rather than optional
// coordinates on the current text-message carrier.
data structural_coverage_gap_openai_chat_completion_200_residual: List<String> = [
  "closure:openai_chat_completion_200_residual|OpenAiChatCompletion200Message|variant_pending:tool_calls|variant_pending:function_call|variant_pending:audio|variant_pending:non_string_content|variant_pending:refusal_without_content|trigger:model response content/tool/audio coproduct surface"
]

data structural_coverage_gap_openai_chat_message_additive_content_parts: List<String> = [
  "closure:openai_chat_message_additive_content_parts|OpenAiChatMessagePart|missing:audio_input_part|missing:refusal_part|missing:file_or_custom_parts|trigger:OpenAI Chat Completions request content-part spec extension",
  "closure:openai_chat_message_additive_tool_calls|ToolCall|missing:custom_tool_call|trigger:OpenAI Chat Completions custom tool-call payload carrier"
]

// Narrow 200-OK wire slice for OpenAI Responses (`response { 200 => … }`).
type OpenAiResponsesOutputContentType
  = OpenAiResponsesOutputText
  | OpenAiResponsesOutputContentTypeOther { raw: NonEmptyStr }

data openai_responses_output_text_wire: String = "output_text"

fn parse_openai_responses_output_content_type(raw: String) -> OpenAiResponsesOutputContentType {
  if raw == openai_responses_output_text_wire { OpenAiResponsesOutputText }
  else { OpenAiResponsesOutputContentTypeOther { raw: raw } }
}

fn openai_responses_output_content_type_label(kind: OpenAiResponsesOutputContentType) -> String {
  match kind {
    OpenAiResponsesOutputText => openai_responses_output_text_wire
    OpenAiResponsesOutputContentTypeOther { raw: r } => r
  }
}

type OpenAiResponsesOutputItemType
  = OpenAiResponsesOutputMessage
  | OpenAiResponsesOutputItemTypeOther { raw: NonEmptyStr }

data openai_responses_output_message_wire: String = "message"

fn parse_openai_responses_output_item_type(raw: String) -> OpenAiResponsesOutputItemType {
  if raw == openai_responses_output_message_wire { OpenAiResponsesOutputMessage }
  else { OpenAiResponsesOutputItemTypeOther { raw: raw } }
}

fn openai_responses_output_item_type_label(kind: OpenAiResponsesOutputItemType) -> String {
  match kind {
    OpenAiResponsesOutputMessage => openai_responses_output_message_wire
    OpenAiResponsesOutputItemTypeOther { raw: r } => r
  }
}

// The operation's current projections read text-output and usage token counts,
// so this carrier models the stable message/output_text path plus token-detail
// usage rows. Refusal content, tool, reasoning-detail, error, and multimodal
// output item variants remain outside this proof-of-shape slice. `text` is
// required here so the typed 200 body cannot inhabit this projection path
// without the string field the operation declares.
type OpenAiResponses200OutputContent {
  type: OpenAiResponsesOutputContentType
  text: String
  annotations: List<OpenAiResponses200Annotation>?
}

data structural_coverage_gap_openai_responses_200_residual: List<String> = [
  "closure:openai_responses_200_residual|OpenAiResponses200OutputContent|json_pending:logprobs|variant_pending:refusal|trigger:Responses output content coproduct surface",
  "closure:openai_responses_200_residual|OpenAiResponses200OutputItem|variant_pending:tool_calls|variant_pending:reasoning|variant_pending:error|variant_pending:multimodal_output|trigger:Responses output item coproduct surface"
]

// 🟢 TERMINAL response annotation coproduct for the direct-coordinate
// Responses `output_text.annotations[]` wire tags modeled in this narrow slice.
type OpenAiResponses200Annotation
  = FileCitation { file_id: String, filename: String, index: Int }
  | UrlCitation { start_index: Int, end_index: Int, title: String, url: String }
  | ContainerFileCitation { container_id: String, file_id: String, filename: String, start_index: Int, end_index: Int }
  | FilePath { file_id: String, index: Int }

type OpenAiResponses200OutputItem {
  id: String?
  type: OpenAiResponsesOutputItemType
  status: String?
  role: String?
  content: List<OpenAiResponses200OutputContent>
}

type OpenAiResponses200InputTokenDetails {
  cached_tokens: Int?
}

type OpenAiResponses200OutputTokenDetails {
  reasoning_tokens: Int?
}

type OpenAiResponses200Usage {
  input_tokens: Int
  output_tokens: Int
  total_tokens: Int?
  input_tokens_details: OpenAiResponses200InputTokenDetails?
  output_tokens_details: OpenAiResponses200OutputTokenDetails?
}

type OpenAiResponses200Body {
  id: String
  object: String
  created_at: Int?
  status: String?
  model: String
  output: List<OpenAiResponses200OutputItem>
  usage: OpenAiResponses200Usage
  service_tier: String?
}

