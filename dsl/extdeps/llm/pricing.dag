      side_effects: WritesExternal,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [{ name: "StreamInterrupted", condition: "connection_dropped_mid_response", http_status: null, recoverable: true, retry_safe: false }],
      edge_cases: [{ description: "partial output may require caller-level checkpointing for resume logic", trigger: "network_instability", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "stream-capable client transport", kind: Tooling }],
      assumptions: ["Caller handles incremental token events safely"],
      unknowns: []
