// extdeps/llm/pricing.dag -- LLM pricing and capability detail.

module extdeps.llm.pricing

import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

type ModelPricing {
  input_per_million: Float
  output_per_million: Float
  cached_input_per_million: Float?
}

type ContextWindow {
  max_tokens: Int
  max_output_tokens: Int
}

type ModelCapability = ExtendedThinking | StructuredOutput | Grounding | ToolUse | VisionInput

type CachingBehavior {
  min_cache_tokens: Int
  ttl_minutes: Int?
  discount_pct: Int
}

type ModelSpec {
  provider: String
  model: String
  pricing: ModelPricing
  context: ContextWindow
  capabilities: List<ModelCapability>
  caching: CachingBehavior?
}

type LlmOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

