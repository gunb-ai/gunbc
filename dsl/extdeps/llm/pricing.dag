data llm_operation_behaviors: List<LlmOperationBehavior> = [
  {
    operation: "ChatCompletion",
    behavior: {
      side_effects: WritesExternal,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [
        { name: "RateLimited", condition: "provider_quota_exhausted", http_status: 429, recoverable: true, retry_safe: true },
        { name: "ContextTooLarge", condition: "input_tokens_exceed_context_window", http_status: 400, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "provider may return a different backing model variant than requested alias", trigger: "alias_resolution", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "provider credential is configured", kind: Credential }],
      assumptions: ["temperature normalization handled by caller"],
      unknowns: ["Tier-specific burst limits and adaptive throttling thresholds"]
    }
  },
  {
    operation: "CountTokens",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: ["model", "input_hash"],
      determinism: Deterministic,
