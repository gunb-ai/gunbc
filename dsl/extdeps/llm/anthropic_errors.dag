// extdeps/llm/anthropic_errors.dag -- Anthropic Messages API error envelope shape.

module extdeps.llm.anthropic_errors

type AnthropicErrorDetails {
  type: String
  message: String
}

type AnthropicErrorShape {
  type: String
  error: AnthropicErrorDetails
}

data anthropic_error_example: AnthropicErrorShape = {
  type: "error",
  error: {
    type: "authentication_error",
    message: "invalid x-api-key"
  }
}
