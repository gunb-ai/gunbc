// extdeps/boot/linux_x86_boot.dag — Linux x86 direct-kernel boot image (Slice-0).
//
// Anchor: Documentation/arch/x86/boot.rst (Linux kernel boot protocol).
// M9 attach: x86_64_linux ArchitectureProfile + ELF EntryPoint.

module extdeps.boot.linux_x86_boot

import extdeps.boot.freestanding_payload {
  EmittedPayload,
  FreestandingPayloadRef,
  HollowPrebuiltInit,
  PrebuiltPayload,
}
import std.types { NonEmptyStr }

type LinuxX86BootImage {
  kernel_digest: NonEmptyStr,
  cmdline: List<String>,
  init: FreestandingPayloadRef,
}

type BootImageOutcome
  = BootImageAccepted { value: LinuxX86BootImage }
  | BootImageRejected { reason: BootImageRejectReason }

// Practice 4 (docs/modeling-discipline.md): coproduct ledger — **🟢 GREEN**
// `HollowInitNotEmitProof` is the terminal reject arm (produced when init is
// `HollowPrebuiltInit`). **🟡 YELLOW (scaffold)** — `BootImageRejectUnspecified`
// reserved for v2 loader ≥2-arms constraint; never produced by
// `accept_linux_x86_boot_image` until a second real reject reason lands.
// dissolve-on: delete `BootImageRejectUnspecified` when a second reject reason
// is modeled (e.g. invalid kernel placement) or unary-sum loader closes.
type BootImageRejectReason
  = HollowInitNotEmitProof
  | BootImageRejectUnspecified

fn accept_linux_x86_boot_image(img: LinuxX86BootImage) -> BootImageOutcome {
  match img.init {
    HollowPrebuiltInit { digest: _, entry: _ } =>
      BootImageRejected { reason: HollowInitNotEmitProof }
    EmittedPayload { digest: _, entry: _ } => BootImageAccepted { value: img }
    PrebuiltPayload { digest: _, entry: _ } => BootImageAccepted { value: img }
  }
}
