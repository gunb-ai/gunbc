// extdeps/boot/boot_stage.dag — boot chain stage graph (kernel → init → framebuffer).

module extdeps.boot.boot_stage

type BootStage
  = FirmwareHandoff
  | KernelEntry
  | EarlyInit
  | InitProcess
  | FramebufferWrite

type BootStageOutcome
  = StageReached { stage: BootStage }
  | StageFailed { stage: BootStage, reason: BootFailReason }

type BootFailReason
  = QemuLaunchFailed { detail: String }
  | SerialMarkerMissing { expected: String }
  | FramebufferCellEmpty
