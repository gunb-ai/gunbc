module extdeps.formats.json

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.ecma-international.org/publications-and-standards/standards/ecma-404/"
  }
}

type JsonKeyValue {
  key: String
  value: JsonValue
}

type JsonValue
  = JsonString { value: String }
  | JsonObject { entries: List<JsonKeyValue> }

fn json_kv(key: String, value: JsonValue) -> JsonKeyValue {
  JsonKeyValue { key: key, value: value }
}

fn json_string(s: String) -> JsonValue {
  JsonString { value: s }
}

fn json_object(entries: List<JsonKeyValue>) -> JsonValue {
  JsonObject { entries: entries }
}

fn json_escape(s: String) -> String {
  replace(replace(s, "\\", "\\\\"), "\"", "\\\"")
}

fn emit_json_string(s: String) -> String {
  concat("\"", concat(json_escape(s: s), "\""))
}

fn emit_json_value(v: JsonValue) -> String {
  match v {
    JsonString { value: s } => emit_json_string(s: s)
    JsonObject { entries: ents } => emit_json_object(entries: ents)
  }
}

fn json_entry_field(entry: JsonKeyValue) -> String {
  concat("\"", concat(json_escape(s: entry.key), concat("\": ", emit_json_value(v: entry.value))))
}

fn join_json_entries(entries: List<JsonKeyValue>) -> String {
  fold(entries, init: { s: "", first: true }, f: (acc, entry) => {
    s: if acc.first { json_entry_field(entry: entry) } else { concat(acc.s, concat(", ", json_entry_field(entry: entry))) },
    first: false
  }).s
}

fn emit_json_object(entries: List<JsonKeyValue>) -> String {
  concat("{", concat(join_json_entries(entries: entries), "}"))
}

fn serialize_json(v: JsonValue) -> String {
  emit_json_value(v: v)
}
