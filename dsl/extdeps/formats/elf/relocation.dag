// extdeps/formats/elf/relocation.dag — ELF relocation carriers (Slice 1: type only).
//
// Anchor: https://refspecs.linuxfoundation.org/elf/gabi4+/ch4.reloc.html
//
// Relocation decode lands in a follow-on slice; R_X86_64_* constants are cited facts.

module extdeps.formats.elf.relocation

// x86-64 relocation types cited from gABI / x86-64 psABI (subset).
// 🟡 dissolve-on: Relocation decode deferred to Slice 2 (shift/mask primitives for sym+type split
//    from Elf64Rela.info; do NOT add elf64_rela_to_relocation here until that lands).
data r_x86_64_none: Int = 0
data r_x86_64_64: Int = 1
data r_x86_64_pc32: Int = 2
data r_x86_64_glob_dat: Int = 6
data r_x86_64_jump_slot: Int = 7
data r_x86_64_relative: Int = 8

type Elf64Rela {
  offset: Int
  info: Int
  addend: Int
}

