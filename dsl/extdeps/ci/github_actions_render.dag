// extdeps/ci/github_actions_render.dag -- GitHub Actions YAML leaf serializer.

module extdeps.ci.github_actions_render

import extdeps.ci.script { render_script_block_lines }
import extdeps.ci.github_actions {
  EnvVar, Permission, Step, StepParam, StepParamValue, Trigger, Workflow
}
import extdeps.yaml {
  yaml_header, yaml_indent, yaml_indented_mapping, yaml_indented_item,
  yaml_sequence_block
}

fn render_trigger(trigger: Trigger) -> String {
  "on:\n" +
    yaml_sequence_block(header: "  push:\n    branches:", level: 3, items: trigger.push_branches) +
    "\n" +
    yaml_sequence_block(header: "  pull_request:\n    branches:", level: 3, items: trigger.pr_branches)
}

fn render_permissions(perms: List<Permission>) -> String {
  let lines = perms
    |> map(p => yaml_indented_mapping(level: 1, key: p.scope, value: p.level))
    |> join("\n")
  "permissions:\n{lines}"
}

fn render_env_block(level: Int, env: List<EnvVar>) -> String {
  let lines = env
    |> map(e => yaml_indented_mapping(level: level, key: e.key, value: e.value))
    |> join("\n")
  "env:\n{lines}"
}

fn render_step_env(env: List<EnvVar>) -> String {
  if env |> count() == 0 { return "" }
  let lines = env
    |> map(e => yaml_indented_mapping(level: 5, key: e.key, value: e.value))
    |> join("\n")
  "\n        env:\n{lines}"
}

fn render_with_param(param: StepParam) -> String {
  match param.value {
    Scalar { value } => yaml_indented_mapping(level: 5, key: param.key, value: value)
    Block { lines } => {
      let block_lines = lines
        |> map(line => yaml_indent(level: 6, text: line))
        |> join("\n")
      yaml_indent(level: 5, text: "{param.key}: |") + "\n" + block_lines
    }
  }
}

fn render_uses_step(name: String, action: String, with_params: List<StepParam>) -> String {
  let with_block = if with_params |> count() == 0 {
    ""
  } else {
    let lines = with_params |> map(param => render_with_param(param: param)) |> join("\n")
    "\n        with:\n{lines}"
  }
  "      - name: {name}\n        uses: {action}{with_block}"
}

fn render_run_step(name: String, lines: List<String>, env: List<EnvVar>) -> String {
  let env_block = render_step_env(env: env)
  if lines |> count() <= 1 {
    let command = lines |> first() ?? ""
    "      - name: {name}\n        run: {command}{env_block}"
  } else {
    let block = lines
      |> map(line => yaml_indent(level: 5, text: line))
      |> join("\n")
    "      - name: {name}\n        run: |\n{block}{env_block}"
  }
}

fn render_step(step: Step) -> String {
  match step {
    Uses { name, action, with_params } => render_uses_step(name: name, action: action, with_params: with_params)
    Run { name, script, env } => render_run_step(
      name: name,
      lines: render_script_block_lines(block: script),
      env: env
    )
  }
}

fn render_github_jobs_block(workflow: Workflow) -> String {
  workflow.jobs |> map(job => {
    let needs_block = if job.needs |> count() == 0 {
      ""
    } else {
      let lines = job.needs |> map(need => yaml_indented_item(level: 3, value: need)) |> join("\n")
      "\n    needs:\n{lines}"
    }
    let steps = job.steps |> map(step => render_step(step: step)) |> join("\n\n")
    "  {job.id}:\n    runs-on: {job.runner.id}\n    timeout-minutes: {job.timeout_minutes}{needs_block}\n    steps:\n{steps}"
  }) |> join("\n\n")
}

fn render_github_workflow_yaml(workflow: Workflow, generator: String, regen_command: String) -> String {
  let header = yaml_header(generator: generator, regen_command: regen_command)
  let trigger = render_trigger(trigger: workflow.trigger)
  let perms = render_permissions(perms: workflow.permissions)
  let env = render_env_block(level: 1, env: workflow.env)
  let jobs = render_github_jobs_block(workflow: workflow)
  "{header}\n\nname: {workflow.name}\n\n{trigger}\n\n{perms}\n\n{env}\n\njobs:\n{jobs}\n"
}
