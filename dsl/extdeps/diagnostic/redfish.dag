// extdeps/diagnostic/redfish.dag — DMTF Redfish REST BMC sensor/state read.
// Anchor: https://www.dmtf.org/standards/redfish

module extdeps.diagnostic.redfish

import std.types { NonEmptyStr }

service diagnostic.redfish.Http {
  operation GetSensors {
    input { base_url: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sfS", "{base_url}/redfish/v1/Chassis/Self/Sensors"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish sensors GET failed"
    }
    mock_response {
      0 => { body: "{\"@odata.type\":\"#SensorCollection.SensorCollection\"}", success: true } "Mock redfish sensors"
    }
  }
}
