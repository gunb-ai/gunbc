  case_id: 0
}

// 🟡 gated — feature:diagnostic-mock-corpus-from-service-decl — bind node://adhoc-49ce4678-496
// dissolve-on-arrival: project this corpus directly from the diagnostic service operation sets
// in dsl/extdeps/diagnostic/{ssh,edac,ipmi}.dag and dsl/extdeps/bmc/http.dag (the SINGLE
// authority for WHICH operations exist), joined with the Phase-2 RecordedFixture store (the authority for WHICH
// recorded cases exist per operation), once a v2 lens can read a service decl's operation nodes
// and the fixture store's keys; this declared list then deletes in the same PR. forbidden: a row
// carrying a response VALUE (exit_code/stdout/success/body/reachable) — that would fork the
// payload authority, now owned by the fixture store (§3); rows mirror the structural key ONLY,
// and grow when a published operation/case is added upstream.
data diagnostic_published_mock_corpus: List<PublishedMockCase> = [
  diagnostic_ssh_session_mock_case_exec,
  diagnostic_ssh_session_mock_case_reachability,
  redfish_http_mock_case_get_system,
  redfish_http_mock_case_get_system_with_netrc,
  redfish_http_mock_case_get_chassis_sensors,
  redfish_http_mock_case_get_power,
  redfish_http_mock_case_get_thermal,
  diagnostic_edac_rasmcctl_mock_case_correctable_counts,
  diagnostic_ipmi_tool_mock_case_sensor_list,
  diagnostic_ipmi_tool_mock_case_sdr_list,
  diagnostic_ipmi_tool_mock_case_sel_list
]
