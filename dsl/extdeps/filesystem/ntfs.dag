module extdeps.filesystem.ntfs

import std.filesystem.types { EntryKind }

type NtfsEntryType
  = NormalFile
  | NtfsDirectory
  | SymlinkReparse
  | MountPointReparse

fn ntfs_entry_kind(t: NtfsEntryType) -> EntryKind {
  match t {
    NormalFile         => RegularFile
    NtfsDirectory      => Directory
    SymlinkReparse     => Symlink
    MountPointReparse  => Other
  }
}
