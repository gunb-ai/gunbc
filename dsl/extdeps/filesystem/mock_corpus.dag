// dsl/extdeps/filesystem/mock_corpus.dag
// Scope: the filesystem layer's PUBLISHED mock corpus as a closed, declared structural fact.
// Anchor: DESIGN.md §3 (single authority) / §6 (model-just-in-time, mark the carrier).
//
// SINGLE authority for WHICH filesystem operations are hermetically realizable. Read by BOTH the
// compile-time M2 mock_totality_lens (src/v2/lens/mock_totality.dag) AND the v1 runtime's
// eval_service_call (the M4 hermetic-realization fold) — one model, not two. The v1 runtime loads
// the dsl/ tree, so this corpus must live in dsl/ for the runtime to reach the SAME model the lens
// reads; the v2 mirror (src/v2/extdeps/filesystem/mock_corpus.dag) is dissolved by this PR. The v2
// lens imports this dsl module directly — cross-tree v2->dsl import is the EXISTING pattern (cf. v2
// importing std.realization / std.types), not a new mechanism.
//
// Rows inhabit std.hermetic_replay.PublishedMockCase. The operation set authority remains
// dsl/extdeps/filesystem/filesystem_io.dag (`service Filesystem`); per-case payloads live in the
// Phase-2 RecordedFixture store ONLY — rows carry the (operation_key, case_id) structural key.

module extdeps.filesystem.mock_corpus

import std.hermetic_replay { PublishedMockCase }

data filesystem_mock_case_write_committed: PublishedMockCase = PublishedMockCase {
  operation_key: "Filesystem.Write",
  service: "Filesystem",
  operation: "Write",
  case_id: 0
}

data filesystem_mock_case_read_contents: PublishedMockCase = PublishedMockCase {
  operation_key: "Filesystem.Read",
  service: "Filesystem",
  operation: "Read",
  case_id: 0
}

// 🟡 gated — feature:filesystem-mock-corpus-from-service-decl — bind node://adhoc-a9399cb3-628
// dissolve-on-arrival: project this corpus directly from the `service Filesystem` operation set
// in dsl/extdeps/filesystem/filesystem_io.dag (the SINGLE authority for WHICH operations exist),
// joined with the Phase-2 RecordedFixture store (the authority for WHICH recorded cases exist
// per operation), once a v2 lens can read a service decl's operation nodes and the fixture
// store's keys; this declared list then deletes in the same PR. forbidden: a row carrying a
// response VALUE (success/bytes_written/content/error) — that would fork the payload authority,
// now owned by the fixture store (§3); rows mirror the (operation_key, case_id) structural key
// ONLY, and grow when a published operation/case is added upstream.
data filesystem_published_mock_corpus: List<PublishedMockCase> = [
  filesystem_mock_case_write_committed,
  filesystem_mock_case_read_contents
]
