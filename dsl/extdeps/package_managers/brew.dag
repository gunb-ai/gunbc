module extdeps.brew

import std.types { NonEmptyStr, FilePath }

data brew_prefix_apple_silicon: FilePath = "/opt/homebrew"
data brew_bin_apple_silicon: FilePath = "/opt/homebrew/bin"

data brew_prefix_intel: FilePath = "/usr/local"
data brew_bin_intel: FilePath = "/usr/local/bin"

data formula_rust: NonEmptyStr = "rust"               
data formula_coreutils: NonEmptyStr = "coreutils"     
data formula_diffutils: NonEmptyStr = "diffutils"     
data formula_grep: NonEmptyStr = "grep"               

data brew_install_url: NonEmptyStr = "https://brew.sh"
data brew_docs: NonEmptyStr = "https://docs.brew.sh/"
