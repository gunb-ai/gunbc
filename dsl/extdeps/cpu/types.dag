module extdeps.cpu.types

import std.measure { HardwareThreadCount, Hertz, Watt }
import std.types { Int, NonEmptyStr }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }

import extdeps.toolchain.types { Architecture }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/CPU_socket"
  }
}

type SocketPackage = LandGridArray | PinGridArray | BallGridArray

type CpuSocket {
  package: SocketPackage
  contact_count: Int
}

type CpuModelCatalogRow {
  model_number: NonEmptyStr
  oem_listing_id: NonEmptyStr?
  vendor: Vendor<Hardware>
  architecture: Architecture
  cores: Int
  threads: HardwareThreadCount
  nominal_sustained_per_thread_hz: Hertz
  socket: CpuSocket
  tdp_watts: Watt

}

type CpuDeploymentFacts {
  sustained_per_thread_hz: Hertz
}

type CpuFacts {
  catalog: CpuModelCatalogRow
  deployment: CpuDeploymentFacts
}
