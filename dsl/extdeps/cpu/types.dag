// extdeps/cpu/types.dag — shared CPU taxonomy types (no vendor catalog data).
//
// A CPU is a hardware domain model, not a universal framework, so it lives downstream
// of std (extdeps), alongside the per-vendor catalog rows that inhabit this shape
// (extdeps/cpu/<vendor>.dag). std owns only the universal frameworks it builds on
// (measure, types).

module extdeps.cpu.types

import std.measure { HardwareThreadCount, Hertz, Watt }
import std.types { Int, NonEmptyStr }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }

import extdeps.toolchain.types { Architecture }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/CPU_socket"
  }
}

// CpuSocket — the physical CPU mount, decomposed from the marketing string (e.g.
// "LGA4926" = a Land Grid Array package with 4926 contacts/lands). `package` is the
// contact technology (a closed set); `contact_count` is the number of electrical
// contacts (lands for LGA, pins for PGA, balls for BGA) — so the string's trailing
// number is a grounded Int, not an opaque token.
// Anchor: https://en.wikipedia.org/wiki/CPU_socket  (land grid array vs pin grid array)
type SocketPackage = LandGridArray | PinGridArray | BallGridArray

type CpuSocket {
  package: SocketPackage
  contact_count: Int
}

// A vendor part identifies itself by its catalog row — extdeps/cpu owns the SHAPE, the
// per-vendor rows live in extdeps/cpu/<vendor>. No std-level enum of one vendor's
// SKUs (that would make the concept a purchase order).
type CpuModelCatalogRow {
  model_number: NonEmptyStr
  oem_listing_id: NonEmptyStr?
  vendor: Vendor<Hardware>
  architecture: Architecture
  cores: Int
  threads: HardwareThreadCount
  nominal_sustained_per_thread_hz: Hertz
  socket: CpuSocket
  tdp_watts: Watt
  // TODO(P-CF-ISA): populate instruction_sets when InstructionSet dissolves
  // from Node in product.compute_fabric (Neoverse-N1 extension set for Altra Max).
}

type CpuDeploymentFacts {
  sustained_per_thread_hz: Hertz
}

// CpuFacts is vendor-agnostic: it carries the catalog row (identity-by-part) plus
// the deployment facts. Which catalog row — that's an extdeps/deployment fact.
type CpuFacts {
  catalog: CpuModelCatalogRow
  deployment: CpuDeploymentFacts
}
