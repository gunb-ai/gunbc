// extdeps/git.dag -- "What is Git?"
//
// Core Git object model: commits, branches, refs, diffs, merge strategies.
// Facts about Git's data model, not how we invoke it (that's services/git.dag).
//
// Consumers:
//   tools/gist.dag                    — branch name
//   shared/gist_modes.dag             — git operations
//   extdeps/github/pull_requests.dag — PR branch refs
//   tools/build.dag                — branch detection

module extdeps.git

import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}
import std.types { CommitSha, FilePath, GitRef, Timestamp }

// ── Object model ──────────────────────────────────────────────────

type ObjectType = BlobObj | TreeObj | CommitObj | TagObj

type GitAuthor {
  name: String
  email: String
  timestamp: Timestamp
}

// Git separates author (who wrote the patch) from committer (who applied
// it to the tree — e.g., merge queue, bot, maintainer). Both are needed
// for SLSA provenance and accurate attribution in automated workflows.
type GitCommit {
  sha: CommitSha
  message: String
  author: GitAuthor
  committer: GitAuthor
  parent_shas: List<CommitSha>
}

// ── Refs ──────────────────────────────────────────────────────────

type GitRef
  = BranchRef { name: String }
  | TagRef { name: String }
  | CommitRef { sha: CommitSha }

type GitBranch {
  name: String
  upstream: String?
  is_head: Bool
}

type GitRemote {
  name: String
  url: String
  fetch_refspec: String
}

// ── Merge strategies ──────────────────────────────────────────────

type GitMergeStrategy = GitMerge | GitSquash | GitRebase | GitFastForward

// ── Diff model ────────────────────────────────────────────────────

type DiffStat {
  files_changed: Int
  insertions: Int
  deletions: Int
}

type DiffLine
  = DiffAdded { content: String }
  | DiffRemoved { content: String }
  | DiffContext { content: String }

type DiffHunk {
  file_path: String
  old_start: Int
  new_start: Int
  lines: List<DiffLine>
}

// ── Working tree status ───────────────────────────────────────────

type GitFileStatus = GitClean | GitModified | GitAdded | GitDeleted | GitRenamed | GitUntracked

// ── Constants ─────────────────────────────────────────────────────

data default_remote: String = "origin"

data default_branch_names: List<String> = ["main", "master"]

// ── Operation behaviors ───────────────────────────────────────────

type GitOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<GitOperationBehavior> = [
  {
    operation: "clone",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "AlreadyExists", condition: "target_dir_exists", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "network access to remote", kind: Infrastructure }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "fetch",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["remote"],
      determinism: Deterministic,
      failure_modes: [{ name: "RemoteUnreachable", condition: "network_failure", http_status: null, recoverable: true, retry_safe: true }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "network access to remote", kind: Infrastructure }],
      assumptions: ["Remote ref state is consistent during fetch"],
      unknowns: []
    }
  },
  {
    operation: "push",
    behavior: {
      side_effects: WritesExternal,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "NonFastForward", condition: "remote_has_diverged", http_status: null, recoverable: true, retry_safe: false },
        { name: "PermissionDenied", condition: "insufficient_access", http_status: null, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "force-push overwrites remote history", trigger: "force_flag", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "write access to remote", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "commit",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NothingToCommit", condition: "empty_staging_area", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "staged changes exist", kind: Runtime }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "status",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "valid git repository", kind: Runtime }],
      assumptions: [],
      unknowns: []
    }
  }
]

// ── Service: shell transport wiring ─────────────────────────────

service git.Core {
  operation CurrentBranch {
    input {}
    output { branch: String }
    readonly
    transport shell { argv: ["git", "rev-parse", "--abbrev-ref", "HEAD"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
  }

  operation RemoteBranches {
    input {}
    output { branches: List<String> }
    readonly
    transport shell { argv: ["git", "branch", "-r", "--format=%(refname:short)"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
  }

  operation LsFiles {
    input {}
    output { files: List<FilePath> }
    readonly
    transport shell { argv: ["git", "ls-files"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
  }

  operation Diff {
    input { base: GitRef, head: GitRef = "HEAD" }
    output { diff: String }
    readonly
    transport shell { argv: ["git", "diff", "\{base\}", "\{head\}"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation RevList {
    input { since: String }
    output { commits: List<CommitSha> }
    readonly
    transport shell { argv: ["git", "rev-list", "\{since\}..HEAD"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation RevListBase {
    input { since: String }
    output { base_ref: CommitSha }
    readonly
    transport shell { argv: ["git", "merge-base", "HEAD", "\{since\}"] }
    exit {
      0 => Unit
      1 => String "No common ancestor found"
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation Show {
    input { ref: GitRef, path: FilePath }
    output { content: String }
    readonly
    transport shell { argv: ["git", "show", "\{ref\}:\{path\}"] }
    exit {
      0 => Unit
      128 => String "File not found or invalid ref"
    }
  }

  operation Checkout {
    input { branch: String }
    output { success: Bool }
    transport shell { argv: ["git", "checkout", "\{branch\}"] }
    exit {
      0 => Unit
      1 => String "Branch not found or checkout conflict"
      128 => String "Not a git repository"
    }
  }
}
