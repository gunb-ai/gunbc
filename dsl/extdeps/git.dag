// extdeps/git.dag -- "What is Git?"
//
// Core Git object model: commits, branches, refs, diffs, merge strategies.
// Facts about Git's data model, not how we invoke it (that's services/git.dag).
//
// Consumers:
//   gunbc/tools/gist.dag           -- branch name
//   shared/gist_modes.dag             -- git operations
//   extdeps/github/pull_requests.dag -- PR branch refs
//   tools/build.dag                -- branch detection

module extdeps.git

import std.types { CommitSha, FilePath, GitRef, Timestamp }

// -- Object model --------------------------------------------------

type ObjectType = BlobObj | TreeObj | CommitObj | TagObj

type GitAuthor {
  name: String
  email: String
  timestamp: Timestamp
}

// Git separates author (who wrote the patch) from committer (who applied
// it to the tree -- e.g., merge queue, bot, maintainer). Both are needed
// for SLSA provenance and accurate attribution in automated workflows.
type GitCommit {
  sha: CommitSha
  message: String
  author: GitAuthor
  committer: GitAuthor
  parent_shas: List<CommitSha>
}

// -- Refs ----------------------------------------------------------

type GitBranch {
  name: String
  upstream: String?
  is_head: Bool
}

type GitRemote {
  name: String
  url: String
  fetch_refspec: String
}

// -- Merge strategies ----------------------------------------------

type GitMergeStrategy = GitMerge | GitSquash | GitRebase | GitFastForward

// -- Diff model ----------------------------------------------------

type DiffStat {
  files_changed: Int
  insertions: Int
  deletions: Int
}

type DiffLine
  = DiffAdded { content: String }
  | DiffRemoved { content: String }
  | DiffContext { content: String }

type DiffHunk {
  file_path: String
  old_start: Int
  new_start: Int
  lines: List<DiffLine>
}

// -- Working tree status -------------------------------------------

type GitFileStatus = GitClean | GitModified | GitAdded | GitDeleted | GitRenamed | GitUntracked

// -- Constants -----------------------------------------------------

data default_remote: String = "origin"

data default_branch_names: List<String> = ["main", "master"]

// -- Service: shell transport wiring -----------------------------

service git.Core {
  operation CurrentBranch {
    input {}
    output { branch: String from "stdout" }
    readonly
    transport shell { argv: ["git", "rev-parse", "--abbrev-ref", "HEAD"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
    mock_response {
      0 => { branch: "main" } "Current branch"
    }
  }

  operation RemoteBranches {
    input {}
    output { branches: List<String> from "stdout_lines" }
    readonly
    transport shell { argv: ["git", "branch", "-r", "--format=%(refname:short)"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
    mock_response {
      0 => { branches: ["origin/main", "origin/feature-x"] } "Remote branches"
    }
  }

  operation LsFiles {
    input {}
    output { files: List<FilePath> from "stdout_lines" }
    readonly
    transport shell { argv: ["git", "ls-files"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
    mock_response {
      0 => { files: ["README.md", "src/main.rs"] } "Tracked files"
    }
  }

  operation Diff {
    input { base: GitRef, head: GitRef = "HEAD" }
    output { diff: String from "stdout" }
    readonly
    transport shell { argv: ["git", "diff", "{base}", "{head}"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
    mock_response {
      0 => { diff: "" } "Empty diff"
    }
  }

  operation RevList {
    input { since: String }
    output { commits: List<CommitSha> from "stdout_lines" }
    readonly
    transport shell { argv: ["git", "rev-list", "{since}..HEAD"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
    mock_response {
      0 => { commits: ["abc1234"] } "Commits since"
    }
  }

  operation RevListBefore {
    input { before: String }
    output { base_ref: CommitSha from "stdout" }
    readonly
    transport shell { argv: ["git", "rev-list", "-1", "--before={before}", "HEAD"] }
    exit {
      0 => Unit
      128 => String "Invalid date expression or not a git repository"
    }
    mock_response {
      0 => { base_ref: "def5678" } "Base ref before date"
    }
  }

  operation Show {
    input { ref: GitRef, path: FilePath }
    output { content: String from "stdout" }
    readonly
    transport shell { argv: ["git", "show", "{ref}:{path}"] }
    exit {
      0 => Unit
      128 => String "File not found or invalid ref"
    }
    mock_response {
      0 => { content: "mock file content" } "File content at ref"
    }
  }
}
