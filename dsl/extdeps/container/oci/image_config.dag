// extdeps/container/oci/image_config.dag — OCI Image Configuration (image-spec config.md).
//
// Spec: https://github.com/opencontainers/image-spec/blob/main/config.md
// Version: image-spec 1.1.0

module extdeps.container.oci.image_config

import extdeps.container.oci.types {
  ContainerExposedPort,
  ContainerPortProtocol,
  ImagePlatformArchitecture,
  ImagePlatformOs,
  ImageArchUnknown,
  ImageOsUnknown,
  OciDigest,
  Tcp,
}
import std.types { Bool, FilePath, NonEmptyStr }

type ContainerImageConfig {
  User: NonEmptyStr?
  Env: List<String>?
  Entrypoint: List<String>?
  Cmd: List<String>?
  WorkingDir: FilePath?
  ExposedPorts: List<ContainerExposedPort>?
}

type ImageRootfs
  = RootfsLayers { diff_ids: List<OciDigest> }

type ImageConfiguration {
  architecture: ImagePlatformArchitecture
  os: ImagePlatformOs
  config: ContainerImageConfig?
  rootfs: ImageRootfs
}

type ImageConfigRejectReason
  = UnknownArchitecture { raw: String }
  | UnknownOs { raw: String }
  | EmptyDiffIds

type ImageConfigOutcome
  = ImageConfigAccepted { value: ImageConfiguration }
  | ImageConfigRejected { reason: ImageConfigRejectReason }

fn accept_image_configuration(c: ImageConfiguration) -> ImageConfigOutcome {
  match c.architecture {
    ImageArchUnknown { raw: r } =>
      ImageConfigRejected { reason: UnknownArchitecture { raw: r } }
    _ =>
      match c.os {
        ImageOsUnknown { raw: r } =>
          ImageConfigRejected { reason: UnknownOs { raw: r } }
        _ =>
          match c.rootfs {
            RootfsLayers { diff_ids: ids } =>
              if count(ids) == 0 {
                ImageConfigRejected { reason: EmptyDiffIds }
              } else {
                ImageConfigAccepted { value: c }
              }
          }
      }
  }
}

fn image_config_layer_count(c: ImageConfiguration) -> Int {
  match c.rootfs {
    RootfsLayers { diff_ids: ids } => count(ids)
  }
}

fn image_config_entrypoint(c: ImageConfiguration) -> List<String> {
  match c.config {
    null => []
    cfg =>
      match cfg.Entrypoint {
        null => []
        ep => ep
      }
  }
}

fn image_config_first_exposed_port(c: ImageConfiguration) -> ContainerExposedPort? {
  match c.config {
    null => null
    cfg =>
      match cfg.ExposedPorts {
        null => null
        ports =>
          match ports |> get(0) {
            null => null
            port => port
          }
      }
  }
}

fn container_exposed_port_is(port: ContainerExposedPort, expected_port: Int, protocol: ContainerPortProtocol) -> Bool {
  if port.port != expected_port {
    false
  } else {
    match port.protocol {
      Tcp =>
        match protocol {
          Tcp => true
          Udp => false
        }
      Udp =>
        match protocol {
          Tcp => false
          Udp => true
        }
    }
  }
}

fn image_config_has_exposed_port(
  c: ImageConfiguration,
  expected_port: Int,
  protocol: ContainerPortProtocol,
) -> Bool {
  match image_config_first_exposed_port(c) {
    null => false
    port => container_exposed_port_is(port: port, expected_port: expected_port, protocol: protocol)
  }
}
