// extdeps/go/go.dag — Go toolchain we shell out to.
//
// Spec: https://go.dev/ref/mod#go-mod-file-go
// Version: Go 1.22+ (go directive minimum language version)
//
// This is a STUB. It documents the `go` binary our workflows rely on
// (emit-host MVP smokes bootstrap go1.22.5 when missing). Language modeling
// lives in extdeps/languages/go/* — this file is the runtime dependency
// declaration only.
//
// Go minimum language version uses the `go` directive wire form ("1.22") —
// not a comparator constraint like ">= 1.22" (go.dev/ref/mod#go-mod-file-go).
//
// dissolve-on: extdeps/languages/go/module.dag (#5315) owns GoLanguageVersion;
// relocate this row when that module lands.
//
// Future:
//   When we model `go build` / `go run` as service operations, this file
//   gets full coverage like extdeps/rust/cargo.dag.

module extdeps.go

import std.types { NonEmptyStr }

// go.dev/ref/mod#go-mod-file-go — minimum language version (MAJOR.MINOR).
type GoLanguageVersion = NonEmptyStr where brand("GoLanguageVersion")

// go.dev/ref/mod#go-mod-file-toolchain — pinned toolchain distribution name.
type GoToolchainName = NonEmptyStr where brand("GoToolchainName")

// ── Spec citations ──────────────────────────────────────────────────

data go_mod_docs: NonEmptyStr = "https://go.dev/ref/mod"

// Minimum go language version for emit-host MVP smokes and go.mod emission.
data min_go_language_version: GoLanguageVersion = "1.22"

// Bootstrap tarball when `go` is absent on PATH (emit_host_transport.dag).
data min_go_toolchain: GoToolchainName = "go1.22.5"
