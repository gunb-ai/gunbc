module extdeps.runtime.api.windows

import std.os.invocation {
  ApiEntry,
  LibraryApiBoundary,
  LibraryApiBoundarySurface,
  StableInvocationSurface,
}
import std.types { Bool }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "learn.microsoft.com/en-us/windows/win32/api/fileapi/nf-fileapi-createfilew"
  }
}

data kernel32_create_file_w: ApiEntry = ApiEntry { symbol: "CreateFileW", module: "kernel32" }
data kernel32_read_file: ApiEntry = ApiEntry { symbol: "ReadFile", module: "kernel32" }
data kernel32_write_file: ApiEntry = ApiEntry { symbol: "WriteFile", module: "kernel32" }
data kernel32_exit_process: ApiEntry = ApiEntry { symbol: "ExitProcess", module: "kernel32" }
data kernel32_load_library_w: ApiEntry = ApiEntry { symbol: "LoadLibraryW", module: "kernel32" }
data kernel32_get_proc_address: ApiEntry = ApiEntry { symbol: "GetProcAddress", module: "kernel32" }
data kernel32_virtual_alloc: ApiEntry = ApiEntry { symbol: "VirtualAlloc", module: "kernel32" }

data ntdll_nt_read_file: ApiEntry = ApiEntry { symbol: "NtReadFile", module: "ntdll" }
data ntdll_nt_write_file: ApiEntry = ApiEntry { symbol: "NtWriteFile", module: "ntdll" }
data ntdll_nt_create_file: ApiEntry = ApiEntry { symbol: "NtCreateFile", module: "ntdll" }
data ntdll_nt_allocate_virtual_memory: ApiEntry = ApiEntry {
  symbol: "NtAllocateVirtualMemory",
  module: "ntdll",
}
data ntdll_nt_terminate_process: ApiEntry = ApiEntry { symbol: "NtTerminateProcess", module: "ntdll" }

data windows_nt_kernel32_exports: List<ApiEntry> = [
  kernel32_create_file_w,
  kernel32_read_file,
  kernel32_write_file,
  kernel32_exit_process,
  kernel32_load_library_w,
  kernel32_get_proc_address,
  kernel32_virtual_alloc,
]

data windows_ntdll_exports: List<ApiEntry> = [
  ntdll_nt_read_file,
  ntdll_nt_write_file,
  ntdll_nt_create_file,
  ntdll_nt_allocate_virtual_memory,
  ntdll_nt_terminate_process,
]

data windows_nt_kernel32_boundary: LibraryApiBoundary = {
  exports: windows_nt_kernel32_exports,
}

data windows_ntdll_boundary: LibraryApiBoundary = {
  exports: windows_ntdll_exports,
}

data windows_11_user_mode_exports: List<ApiEntry> = [
  kernel32_create_file_w,
  kernel32_read_file,
  kernel32_write_file,
  kernel32_exit_process,
  kernel32_load_library_w,
  kernel32_get_proc_address,
  kernel32_virtual_alloc,
  ntdll_nt_read_file,
  ntdll_nt_write_file,
  ntdll_nt_create_file,
  ntdll_nt_allocate_virtual_memory,
  ntdll_nt_terminate_process,
]

data windows_11_user_mode_boundary: LibraryApiBoundary = {
  exports: windows_11_user_mode_exports,
}

data windows_11_library_api_surface: StableInvocationSurface = LibraryApiBoundarySurface {
  boundary: windows_11_user_mode_boundary,
}

fn witness_kernel32_create_file_w_exported() -> Bool {
  kernel32_create_file_w.symbol == "CreateFileW"
}

fn witness_kernel32_create_file_w_module() -> Bool {
  kernel32_create_file_w.module == "kernel32"
}

fn witness_ntdll_nt_read_file_exported() -> Bool {
  ntdll_nt_read_file.symbol == "NtReadFile"
}

fn witness_ntdll_nt_read_file_module() -> Bool {
  ntdll_nt_read_file.module == "ntdll"
}

fn witness_windows_boundary_exports_match_user_mode() -> Bool {
  match windows_11_library_api_surface {
    LibraryApiBoundarySurface { boundary: b } => b.exports == windows_11_user_mode_exports
    _ => false
  }
}

fn witness_windows_component_boundaries_preserved() -> Bool {
  windows_nt_kernel32_boundary.exports == windows_nt_kernel32_exports
    && windows_ntdll_boundary.exports == windows_ntdll_exports
}
