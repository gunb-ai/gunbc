  CapabilityPowerControl,
  CapabilityBootSourceOverride,
  CapabilityAccountManagement,
  CapabilityFirmwareUpdate,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "download.asrock.com/Manual/ALTRAD8UD-1L2T.pdf"
  }
}

data asrock_altrad8ud_download_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.asrockrack.com/general/productdetail.asp?Model=ALTRAD8UD-1L2T"
  }
}

data asrock_altrad8ud_bmc_manual_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
