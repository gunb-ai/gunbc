module extdeps.test.http_pilot

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "jsonplaceholder.typicode.com/posts"
  }
}

type HttpPilotPost {
  userId: Int
  id: Int
  title: String
  body: String
}

service test.HttpPilot {
  config {
    endpoint: "https://jsonplaceholder.typicode.com"
  }

  operation GetPost {
    input { post_id: Int }
    output {
      title: String from "title"
      post_id: Int from "id"
    }
    readonly
    transport rest {
      method: GET,
      path: "/posts/{post_id}"
    }
    response {
      200 => HttpPilotPost
    }

  }
}
