// extdeps/github_actions.dag -- "What is GitHub Actions?"
//
// Stable domain model of GitHub Actions as a CI/CD platform.
// Tautological definitions: a workflow has triggers, permissions,
// env, and jobs. A job has a runner, steps. A step uses an action
// or runs a command.
//
// Facts about the platform's schema — no opinions about our repo.
// Our CI configuration lives in config/ci.dag (Layer 2).
//
// Consumers:
//   config/ci.dag          — our CI configuration data
//   tools/cigen.dag        — rendering + tool entrypoint

module extdeps.github_actions

import extdeps.ci_script { ScriptBlock }

// ── Trigger ────────────────────────────────────────────────────────
// "How does a workflow start?"

type Trigger {
  push_branches: List<String>
  pr_branches: List<String>
}

// ── Permission ─────────────────────────────────────────────────────
// "What can the workflow do?"

type Permission {
  scope: String
  level: String
}

// ── Environment ────────────────────────────────────────────────────

type EnvVar {
  key: String
  value: String
}

type StepParamValue
  = Scalar { value: String }
  | Block { lines: List<String> }

type StepParam {
  key: String
  value: StepParamValue
}

// ── Secrets ────────────────────────────────────────────────────────
// GitHub Actions references secrets via ${{ secrets.NAME }}.

type SecretRef {
  name: String
}

// ── Cache ──────────────────────────────────────────────────────────
// "How does caching work?"

type Cache {
  key: String
  paths: List<String>
  restore_keys: List<String>
}

// ── Checkout ───────────────────────────────────────────────────────

type Checkout {
  fetch_depth: Int?
  submodules: String?
}

// ── Runner ─────────────────────────────────────────────────────────
// "Where does the job run?"

type RunnerImage {
  id: String
}

data ubuntu_latest: RunnerImage = { id: "ubuntu-latest" }
data ubuntu_22_04: RunnerImage = { id: "ubuntu-22.04" }
data macos_latest: RunnerImage = { id: "macos-latest" }
data windows_latest: RunnerImage = { id: "windows-latest" }

// ── Actions ────────────────────────────────────────────────────────
// Well-known reusable actions with pinned versions.

data checkout_action: String = "actions/checkout@v4"
data rust_toolchain_action: String = "dtolnay/rust-toolchain@stable"
data cache_action: String = "actions/cache@v4"

// ── Step ───────────────────────────────────────────────────────────
// "What is a workflow step?"
// A step either uses a reusable action or runs a shell command.

type Step
  = Run { name: String, script: ScriptBlock, env: List<EnvVar> }
  | Uses { name: String, action: String, with_params: List<StepParam> }

// ── Job ────────────────────────────────────────────────────────────
// "What is a workflow job?"

type Job {
  id: String
  name: String
  runner: RunnerImage
  timeout_minutes: Int
  steps: List<Step>
  needs: List<String>
}

// ── Workflow ────────────────────────────────────────────────────────
// "What is a GitHub Actions workflow?"

type Workflow {
  name: String
  trigger: Trigger
  permissions: List<Permission>
  env: List<EnvVar>
  cache: Cache?
  jobs: List<Job>
}

// ── Output ─────────────────────────────────────────────────────────
// "Where does the workflow file go?"

data output_dir: String = ".github/workflows"

fn secret_ref(name: String) -> String {
  "$\{\{ secrets.{name} \}\}"
}

fn uses_step(name: String, action: String, with_params: List<StepParam>) -> Step {
  Uses { name: name, action: action, with_params: with_params } as Step
}

fn run_step(name: String, script: ScriptBlock, env: List<EnvVar>) -> Step {
  Run { name: name, script: script, env: env } as Step
}

fn checkout_step(checkout: Checkout) -> Step {
  let fetch_depth = match checkout.fetch_depth {
    null => []
    depth => [{ key: "fetch-depth", value: Scalar { value: "{depth}" } }]
  }
  let submodules = match checkout.submodules {
    null => []
    submodules => [{ key: "submodules", value: Scalar { value: submodules } }]
  }
  uses_step(
    name: "Checkout",
    action: checkout_action,
    with_params: fetch_depth |> append(items: submodules)
  )
}

fn rust_setup_step() -> Step {
  uses_step(
    name: "Setup Rust",
    action: rust_toolchain_action,
    with_params: []
  )
}

fn cache_step(cache: Cache) -> Step {
  uses_step(
    name: "Cache Cargo",
    action: cache_action,
    with_params: [
      { key: "path", value: Block { lines: cache.paths } },
      { key: "key", value: Scalar { value: cache.key } },
      { key: "restore-keys", value: Block { lines: cache.restore_keys } }
    ]
  )
}
