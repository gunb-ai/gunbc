// extdeps/cron.dag -- POSIX crontab scheduler
//
// Spec: POSIX.1-2017 crontab(1)
// https://pubs.opengroup.org/onlinepubs/9699919799/utilities/crontab.html
//
// Models the local user crontab as a set of entries keyed by a tag
// comment. Upsert and Remove are idempotent by construction:
// Upsert matches on tag, replaces if present, appends if absent.
// Remove matches on tag, no-ops if absent.
//
// Consumers:
//   gunbc/tools/review.dag -- review workflow self-registers its schedule

module extdeps.cron

// -- Cron entry model -------------------------------------------------
// Typed cron expression. Each of the 5 standard POSIX fields is a
// `CronField` rather than an opaque string -- illegal expressions
// are unrepresentable at fixture-load (single authority: one parse
// path through the type system, no runtime parse fork).
//
// Wire format is recovered via `render_cron_field` / `render_cron_schedule`
// for transports that take a string-shaped schedule (e.g., crontab(1)).
//
// Field-count is exactly 5 (POSIX.1-2017). Expansion to 6 (seconds) or
// 7 (year) is a substrate-shape question warranting ratification.

type CronField
  = Wildcard                                  // *
  | Exact { value: Int }                      // N
  | Listed { values: List<Int> }              // a,b,c
  | Ranged { start: Int, end: Int }           // a-b
  | Step { start: Int, step: Int }            // a/N  (start: 0 renders as "*/N")

type CronSchedule {
  minute: CronField
  hour: CronField
  day_of_month: CronField
  month: CronField
  day_of_week: CronField
}

type CronEntry {
  tag: String
  schedule: CronSchedule
  command: String
}

// Wire-format render. Consumers calling `cron.Tab.Upsert` pass
// `render_cron_schedule(typed_schedule)` to satisfy the String-shaped
// transport input.

fn render_cron_field(f: CronField) -> String {
  match f {
    Wildcard => "*"
    Exact { value } => "{value}"
    Listed { values } => values |> map(v => "{v}") |> join(separator: ",")
    Ranged { start, end } => "{start}-{end}"
    Step { start, step } => if start == 0 { "*/{step}" } else { "{start}/{step}" }
  }
}

fn render_cron_schedule(s: CronSchedule) -> String {
  let mn = render_cron_field(s.minute)
  let hr = render_cron_field(s.hour)
  let dm = render_cron_field(s.day_of_month)
  let mo = render_cron_field(s.month)
  let dw = render_cron_field(s.day_of_week)
  "{mn} {hr} {dm} {mo} {dw}"
}

// -- Service: shell transport -----------------------------------------

service cron.Tab {
  operation List {
    input {}
    output { entries: String from "stdout" }
    readonly
    transport shell { argv: ["crontab", "-l"] }
    exit {
      0 => Unit
      1 => Unit "No crontab for user"
    }
    mock_response {
      0 => { entries: "*/30 * * * * /usr/bin/review-agent run # tag:review-agent" } "Existing crontab"
    }
  }

  operation Upsert {
    input {
      tag: String
      schedule: String
      command: String
      log_path: String?
    }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell {
      argv: ["sh", "-c", "TAG='# tag:{tag}'; ENTRY='{schedule} {command} >> {log_path} 2>&1 $TAG'; CURRENT=$(crontab -l 2>/dev/null || true); if echo \"$CURRENT\" | grep -qF \"$TAG\"; then echo \"$CURRENT\" | sed \"/$TAG/c\\\\$ENTRY\" | crontab -; else (echo \"$CURRENT\"; echo \"$ENTRY\") | crontab -; fi"]
    }
    exit {
      0 => Unit
      nonzero => String "Crontab upsert failed"
    }
    mock_response {
      0 => { exit_success: true, stdout: "", stderr: "" } "Upsert succeeded"
    }
  }

  operation Remove {
    input {
      tag: String
    }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell {
      argv: ["sh", "-c", "TAG='# tag:{tag}'; CURRENT=$(crontab -l 2>/dev/null || true); echo \"$CURRENT\" | grep -vF \"$TAG\" | crontab -"]
    }
    exit {
      0 => Unit
      nonzero => String "Crontab remove failed"
    }
    mock_response {
      0 => { exit_success: true, stdout: "", stderr: "" } "Remove succeeded"
    }
  }
}
