// extdeps/sql/migration.dag -- SQL migration emission target surface.
//
// Specs:
//   ISO/IEC 9075 SQL overview
//     https://www.iso.org/standard/76583.html
//   PostgreSQL transactional DDL behavior
//     https://www.postgresql.org/docs/current/sql-commands.html
//   SQLite ALTER TABLE behavior
//     https://www.sqlite.org/lang_altertable.html
//
// Ctrl-Migration Phase 3 authority for generated database migration artifacts.
// This file models migration-script shape and ordering constraints; the SQL
// transport execution config remains in extdeps.transports.sql.

module extdeps.sql.migration

// Coproduct dissolution classification:
// GREEN (terminal). Migration operations have distinct externally visible
// schema effects and rollback constraints. Keeping them as variants preserves
// the operation class without requiring SQL string inspection downstream.
type SqlMigrationOperationKind
  = CreateTable
  | AlterTable
  | DropTable
  | CreateIndex
  | DropIndex
  | AddColumn
  | DropColumn
  // YELLOW scaffold. This variant is only for dialect-specific DDL that cannot
  // yet be represented by the bounded operation variants above. Consumers must
  // carry the `dialect` field on `SqlMigrationStep`; dissolve this variant once
  // the first ctrl migration projection identifies the missing structural
  // operation kind and adds it here.
  | RawSqlStep

type SqlMigrationStep {
  name: String
  operation: SqlMigrationOperationKind
  dialect: String
  statement: String
  reversible: Bool
}

type SqlMigrationScript {
  migration_id: String
  wraps_transaction: Bool
  steps: List<SqlMigrationStep>
}

// STAGED. This target is consumed by ctrl subsystem projections before any
// generated migration becomes authority over the current TypeScript-backed DB
// behavior.
type SqlMigrationEmissionTarget {
  database_name: String
  migrations: List<SqlMigrationScript>
}
