// extdeps/languages/python/imports.dag -- "How does the Python module system work?"
//
// Import statements, from-import, __init__.py, package structure,
// and naming conventions from the Python Language Reference.
//
// Ref: Python Language Reference 7.11 "The import statement"
//      PEP 8 "Style Guide for Python Code"
//      Python Tutorial 6 "Modules"
//
// Consumers:
//   v2/05_emit_python.dag -- import emission, module file generation

module extdeps.languages.python.imports

// -- Import statements -----------------------------------------------
// Ref: Python Reference 7.11 "The import statement"

// "How does Python import a module?"
data import_template: String = "import \{module\}"
data from_import_template: String = "from \{module\} import \{names\}"
data from_import_star_template: String = "from \{module\} import *"
data import_alias_template: String = "import \{module\} as \{alias\}"
data from_import_alias_template: String = "from \{module\} import \{name\} as \{alias\}"

// -- Package structure -----------------------------------------------
// Ref: Python Tutorial 6.4 "Packages"

// "How does Python define a package?"
// A directory with __init__.py is a package.
data package_init_file: String = "__init__.py"
data module_file_extension: String = ".py"

// -- Path separator --------------------------------------------------
data path_separator: String = "."

// -- Relative imports ------------------------------------------------
// Ref: PEP 328 "Imports: Multi-Line and Absolute/Relative"

data relative_import_current: String = "from . import \{name\}"
data relative_import_parent: String = "from .. import \{name\}"
data relative_from_template: String = "from .\{module\} import \{names\}"

// -- Visibility convention -------------------------------------------
// Ref: PEP 8 "Naming Conventions"
//
// Python has no access modifiers. Convention:
// _name  -> private (by convention, not enforced)
// __name -> name-mangled (class-level)
// name   -> public

data private_prefix: String = "_"
data mangled_prefix: String = "__"

// -- Standard imports for generated code -----------------------------
// Common imports needed by generated Python files.

data dataclass_imports: List<String> = [
  "from dataclasses import dataclass, field"
]

data typing_imports: List<String> = [
  "from typing import Optional, Any"
]

data enum_imports: List<String> = [
  "from enum import Enum, auto"
]

data json_imports: List<String> = [
  "import json"
]

data async_imports: List<String> = [
  "import asyncio",
  "import aiohttp"
]

// -- Project scaffolding ---------------------------------------------
// Ref: PEP 517 "Build system interface", PEP 621 "Project metadata"

data pyproject_file: String = "pyproject.toml"
data requirements_file: String = "requirements.txt"
data setup_py_file: String = "setup.py"

// "What does a generated Python project need?"
type PythonDep {
  name: String
  version: String
}

data base_deps: List<PythonDep> = [
  { name: "aiohttp", version: ">=3.9" },
  { name: "pydantic", version: ">=2.0" }
]
