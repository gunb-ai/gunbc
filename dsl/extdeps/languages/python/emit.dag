// extdeps/languages/python/emit.dag -- Python language facts for the v2 emitter.
//
// Single source of truth for Python-specific data consumed by the emitter.
// Imports only the shared SimpleMethodSpec carrier from std; the rest are
// leaf data declarations.
//
// Ref: Python Language Reference (docs.python.org/3/reference)
//      Python Standard Library (docs.python.org/3/library)
//
// Consumers:
//   v2/05_emit.dag -- type mapping, keywords, container templates

module extdeps.languages.python.emit

import std.emit_model { SimpleMethodSpec }

// -- Keyword/operator translation ----------------------------------------
// DAG keywords/operators -> Python syntax.
// Ref: Python Reference 6.10-6.12 "Comparisons", "Boolean operations"
data python_keywords: Map<String, String> = {
  "true": "True", "false": "False", "null": "None",
  "and": "and", "or": "or", "not": "not ",
  "div": "//"
}

// -- Container type templates --------------------------------------------
// {0} = element type, {1} = second type (maps).
// Ref: typing module (PEP 585)
data python_container_templates: Map<String, String> = {
  "list": "list[\{0\}]", "set": "set[\{0\}]",
  "optional": "Optional[\{0\}]", "map": "dict[\{0\}, \{1\}]",
  "free_monoid": "list[\{0\}]", "partial_function": "dict[\{0\}, \{1\}]",
  "boolean_algebra": "bool"
}

// -- Reserved words ------------------------------------------------------
// Ref: Python Reference 2.3.1 Keywords
data python_reserved: List<String> = [
  "False", "None", "True", "and", "as", "assert", "async", "await",
  "break", "class", "continue", "def", "del", "elif", "else",
  "except", "finally", "for", "from", "global", "if", "import",
  "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise",
  "return", "try", "while", "with", "yield",
  "type", "match", "case"
]

// -- Reserved word escape ------------------------------------------------
// Ref: PEP 8 -- trailing underscore convention for keyword conflicts.
// Mirrors python_reserved_words.strategy.suffix from std.languages.
data python_reserved_escape_suffix: String = "_"

// -- Type definitions ----------------------------------------------------
// Ref: PEP 557 "Data Classes", PEP 484 "Type Hints"
// Mirrors python_type_defs.derive_attribute from std.languages.
data python_derive_attribute: String = "@dataclass"

// -- Serialization -------------------------------------------------------
// Ref: Python builtins
// Mirrors python_serialization.default_value from std.languages.
data python_default_value: String = "None"

// -- Item definition facts ------------------------------------------------
// Ref: Python Reference §8 "Compound statements"
data python_func_keyword: String = "def"
data python_async_prefix: String = "async "
data python_struct_keyword: String = "class"
data python_enum_keyword: String = "class"
data python_type_alias_keyword: String = ""
data python_param_separator: String = ", "
data python_return_arrow: String = " -> "
data python_param_type_sep: String = ": "
data python_module_keyword: String = ""
data python_import_keyword: String = "import"
data python_import_from_keyword: String = "from"

// -- Project scaffold ----------------------------------------------------
// Ref: Python packaging conventions
// Mirrors python_scaffold from std.languages.
data python_source_extension: String = ".py"
data python_module_init: String = "__init__.py"

// -- String-like types ------------------------------------------------------
// Types that use string comparison/indexing semantics in Python.
data python_string_types: List<String> = ["String", "Secret"]

// -- Method templates -------------------------------------------------------
// Named-placeholder templates for algebra method calls.
// \{recv\} = pre-emitted receiver, \{arg\} = pre-emitted first argument.
// Ref: Python standard library, builtins, functools.
//
// Single authority: `python_simple_method_specs` carries the flat-templatable
// (unary `{recv}`/`{arg}`) methods, exactly the set the emitter renders by
// template. `map`/`fold`/`concat` are deliberately NOT here — they are binary+
// (`fold(coll, init, f)` per dsl/std/algebra.dag) and route through the runtime
// bridge, which forwards every argument (a flat one-arg template would drop
// fold's accumulator/callback). `python_method_templates_flat()` derives the
// emit map from this list. Mirrors #5039's Rust slice.
data python_simple_method_specs: List<SimpleMethodSpec> = [
  { method_name: "count",            template: "len(\{recv\})",                          wraps_result: false },
  { method_name: "join",             template: "\{arg\}.join(\{recv\})",                 wraps_result: false },
  { method_name: "split",            template: "\{recv\}.split(\{arg\})",                wraps_result: false },
  { method_name: "last",             template: "\{recv\}[-1] if \{recv\} else None",     wraps_result: false },
  { method_name: "first",            template: "\{recv\}[0] if \{recv\} else None",      wraps_result: false },
  { method_name: "enumerate",        template: "list(enumerate(\{recv\}))",              wraps_result: false },
  { method_name: "chars",            template: "[ord(c) for c in \{recv\}]",             wraps_result: false },
  { method_name: "string_contains",  template: "\{arg\} in \{recv\}",                    wraps_result: false },
  { method_name: "filter",           template: "[x for x in \{recv\} if \{arg\}(x)]",    wraps_result: false },
  { method_name: "any",              template: "any(\{arg\}(x) for x in \{recv\})",      wraps_result: false },
  { method_name: "all",              template: "all(\{arg\}(x) for x in \{recv\})",      wraps_result: false },
  { method_name: "flat_map",         template: "[y for x in \{recv\} for y in \{arg\}(x)]", wraps_result: false },
  { method_name: "skip",             template: "\{recv\}[\{arg\}:]",                     wraps_result: false },
  { method_name: "take",             template: "\{recv\}[:\{arg\}]",                     wraps_result: false },
  { method_name: "sort_by",          template: "sorted(\{recv\}, key=\{arg\})",          wraps_result: false },
  { method_name: "append",           template: "\{recv\} + [\{arg\}]",                   wraps_result: false }
]

// Derived: the flat templatable map the emitter reads (single authority above).
// `map`/`fold`/`concat` are absent → they route via the runtime bridge (correct
// argument forwarding).
fn python_method_templates_flat() -> Map<String, String> {
  python_simple_method_specs
    |> fold(init: empty_map(), f: (acc, spec) => map_insert(acc, spec.method_name, spec.template))
}

// -- Expression syntax templates ------------------------------------------
data python_lambda_template: String = "lambda {0}: {1}"
data python_error_expr_template: String = "raise RuntimeError({0})"
data python_list_literal_empty: String = "[]"
data python_list_literal_template: String = "[{0}]"
data python_null_coalesce_template: String = "({0} if {0} is not None else {1})"
data python_error_type_template: String = "__EMIT_BUG_{0}__"
data python_type_arg_open: String = "["
data python_type_arg_close: String = "]"
data python_void_type: String = "None"
data python_tuple_empty: String = "Tuple"
data python_tuple_pair_template: String = "Tuple[{0}, {1}]"
data python_tuple_multi_template: String = "Tuple[{0}]"
data python_tuple_separator: String = ", "
