// extdeps/languages/python/naming.dag -- "How does Python name and format things?"
//
// Naming conventions and source formatting model for Python,
// as specified by PEP 8 and Black defaults.
//
// Ref: PEP 8 (peps.python.org/pep-0008)
//      Black formatter (black.readthedocs.io)
//
// Consumers:
//   v2/05_emit.dag       -- identifier casing, source formatting

module extdeps.languages.python.naming

import std.languages {
  NamingConvention, PascalCase, SnakeCase, ScreamingSnakeCase,
  FormatModel, SpaceIndent, NoGrouping
}

// -- Naming convention --------------------------------------------------
// Ref: PEP 8 Naming Conventions
//   types (classes):  PascalCase
//   functions:        snake_case
//   variables:        snake_case
//   constants:        SCREAMING_SNAKE_CASE
//   modules:          snake_case

data python_naming: NamingConvention = {
  type_case: PascalCase,
  function_case: SnakeCase,
  variable_case: SnakeCase,
  constant_case: ScreamingSnakeCase,
  module_case: SnakeCase
}

// -- Formatting model ---------------------------------------------------
// Ref: PEP 8 (4 spaces), Black defaults (max line length 88)
//      Python has no standard import grouping enforced by formatter.

data python_formatting: FormatModel = {
  indent: SpaceIndent { width: 4 },
  max_line_width: 88,
  import_grouping: NoGrouping,
  trailing_newline: true
}
