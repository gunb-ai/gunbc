module extdeps.languages.python.types

import std.coercion {
  TypeCheckpoint, InhabitantDecl, CallableRepr, CastSyntax
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.python.org/3/reference"
  }
}

data python_type_checkpoints: List<TypeCheckpoint> = [
  { dag_name: "Int",    target_type: "int",   default_expr: "0",      is_copy: none, literal_suffix: none },
  { dag_name: "Float",  target_type: "float", default_expr: "0.0",    is_copy: none, literal_suffix: none },
  { dag_name: "Bool",   target_type: "bool",  default_expr: "False",  is_copy: none, literal_suffix: none },
  { dag_name: "Unit",   target_type: "None",  default_expr: "None",   is_copy: none, literal_suffix: none },
  { dag_name: "String", target_type: "str",   default_expr: "\"\"",   is_copy: none, literal_suffix: none },
  { dag_name: "Bytes",  target_type: "bytes", default_expr: "b\"\"",  is_copy: none, literal_suffix: none },
  { dag_name: "Secret", target_type: "str",   default_expr: "\"\"",   is_copy: none, literal_suffix: none },
  { dag_name: "Json",   target_type: "dict",  default_expr: "{}",     is_copy: none, literal_suffix: none }
]

data python_algebra_inhabitants: List<InhabitantDecl> = [
  { algebra: "FreeMonoid",
    template: "list[\{0\}]",
    arity: 1,
    identity_expr: "[]",
    import_path: none,
    is_copy: none },

  { algebra: "BooleanAlgebra",
    template: "set[\{0\}]",
    arity: 1,
    identity_expr: "set()",
    import_path: none,
    is_copy: none },

  { algebra: "PartialFunction",
    template: "dict[\{0\}, \{1\}]",
    arity: 2,
    identity_expr: "{}",
    import_path: none,
    is_copy: none },

  { algebra: "OrderedRing",
    template: "int",
    arity: 0,
    identity_expr: "0",
    import_path: none,
    is_copy: none },

  { algebra: "ApproximateField",
    template: "float",
    arity: 0,
    identity_expr: "0.0",
    import_path: none,
    is_copy: none }
]

data python_callable: CallableRepr = CallableRepr {
  template: "Callable[[\{params\}], \{return\}]",
  param_separator: ", ",
  return_separator: ", ",
  import_path: "from typing import Callable"
}

type PythonTypeKind
  = DynamicType
  | AnnotatedType

data dataclass_decorator: String = "@dataclass"
data dataclass_import: String = "from dataclasses import dataclass, field"
data field_default_template: String = "field(default=\{value\})"
data field_default_factory_template: String = "field(default_factory=\{factory\})"
data python_enum_import: String = "from enum import Enum, auto"
data enum_class_template: String = "class \{name\}(Enum):\n\{variants\}"
data enum_auto_value: String = "auto()"
data union_syntax: String = "\{a\} | \{b\}"
data optional_syntax: String = "\{type\} | None"
data typing_optional: String = "Optional[\{type\}]"
data python_optional_template: String = "Optional[\{0\}]"
data typing_union: String = "Union[\{types\}]"
data python_typing_import: String = "from typing import Optional, Union"
data type_alias_template: String = "\{name\} = \{type\}"
data generic_param_template: String = "[\{params\}]"
data typing_generic_import: String = "from typing import Generic, TypeVar"
data none_literal: String = "None"
data none_check_template: String = "\{expr\} is None"
data none_not_check_template: String = "\{expr\} is not None"
data pass_statement: String = "pass"
data type_checker: String = "mypy"
data type_checker_strict: String = "mypy --strict"

data python_cast_syntax: CastSyntax = {
  template: "\{type\}(\{expr\})",
  cast_rules: [
    { from_type: "int", to_type: "int" },
    { from_type: "int", to_type: "float" },
    { from_type: "int", to_type: "bool" },
    { from_type: "int", to_type: "str" },
    { from_type: "float", to_type: "int" },
    { from_type: "float", to_type: "float" },
    { from_type: "float", to_type: "bool" },
    { from_type: "float", to_type: "str" },
    { from_type: "bool", to_type: "int" },
    { from_type: "bool", to_type: "float" },
    { from_type: "bool", to_type: "str" },
    { from_type: "str", to_type: "int" },
    { from_type: "str", to_type: "float" }
  ]
}
