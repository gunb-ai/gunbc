// extdeps/languages/python/primitives.dag — Structural target-primitive
// declarations for the Python target (T-Ground-Python tranche 1 / spec authority).
//
// TRANCHE 1 (this file): Python language-reference built-in types whose
// value domain is fixed by the language spec — `int` (arbitrary precision),
// `bool`, `str` (immutable Unicode code-point sequence), and `None` (the
// single inhabitant of `NoneType`). See Python Language Reference §"The
// standard type hierarchy" (docs.python.org/3/reference/datamodel.html) and
// §"Numeric Types — int, float, complex"
// (docs.python.org/3/library/stdtypes.html#numeric-types-int-float-complex).
//
// `float` and `complex` are intentionally omitted from this tranche: the
// language reference states "Floating point numbers are usually implemented
// using double in C" and explicitly flags float/complex precision as
// "implementation dependent". Declaring a fixed IEEE-754 carrier here would
// repeat the same no-lying-about-width discipline violation Go's omission of
// `int` / `uint` / `uintptr` calls out — defer until a CPython-tagged
// implementation-width story lands alongside DB-11 / cardinality substrate.
// `bytes` / `bytearray` (built-in byte-sequence types) are also deferred to
// the next tranche; they're language-level but not part of the
// numeric/bool/str tranche-1 scope per dispatch brief.
//
// TWO-AUTHORITY DISCIPLINE (ROADMAP §Post-R1 Grounding lanes):
//   (a) THIS FILE — Python language reference (docs.python.org/3/reference).
//   (b) stdlib carriers and product-specific rows (e.g. `dict` for Json,
//       `bytes` for Bytes payloads consumed via stdlib paths) stay in
//       python/types.dag + emit tables until a dedicated stdlib-authority
//       slice lands; do not cite stdlib paths here.
//
// CONSUMER BOUNDARY: same Path-2 honest state as rust/primitives.dag and
// go/primitives.dag — the top-level `python_spec_predeclared_primitives`
// list and `python_dag_unit_target_primitive` lower as `ValueBody::Unparsed`
// until R2 T-Substrate's top-level aggregate sub-lane lands; type-structure
// (`PythonPrimitive = …`) is walkable for Engine / future loaders.
//
// LESSON 5 (grounding-pilot-receipt.md): subset-only axes are structurally
// partitioned — string algebra/carrier tags live only on PythonStringPrimitive;
// integer carrier discipline lives only on PythonIntegerPrimitive; the
// terminal sentinel pair lives only on PythonUnitPrimitive.
//
// STRING (language ref §"Text Sequence Type — str",
// docs.python.org/3/library/stdtypes.html#textseq): a `str` value is an
// immutable sequence of Unicode code points (free monoid over Unicode code
// points). Source-text encoding (UTF-8 / UTF-16 / etc.) is NOT a second
// carrier/algebra authority on the spec `str` row — it is encode/decode
// surface and belongs in operator or stdlib slices, not parallel sum arms
// on `PythonStringPrimitive`. (Same discipline as Go's spec-string row
// declining a UTF-8 parallel authority on `GoStringPrimitive`.)
//
// SUBSTRATE-GAP FLAGS:
//   1. Python `int` is arbitrary precision — no fixed-width carrier and no
//      modular-wrap overflow. Tranche-1 models this with the
//      `PythonUnboundedIntegerCarrier` sentinel (no `range_min/max`,
//      no `overflow` field) so consumers cannot read a false fixed width.
//      Post-DB-11 / cardinality substrate this becomes
//      `OrderedRing<UnboundedSignedInteger>` with countably-infinite
//      cardinality; today the sentinel carrier is the honest declaration.
//   2. `bool` is a subclass of `int` per the Python data model
//      (True == 1, False == 0). Tranche-1 routes `bool` through
//      `PythonBooleanPrimitive` with the canonical two-element Boolean
//      algebra value-domain (Bit-carrier sentinel) and does not yet model
//      the int-coercion edge — that lives in coercion / operator slices,
//      not on the predeclared primitive row.
//   3. Algebra and carrier identity is still carried by structural tags
//      (`PythonIntegerAlgebra` / `PythonNonIntegerAlgebra` /
//      `PythonTargetCarrier` / `PythonSpecString*Tag`), same bridge pattern
//      as rust/primitives.dag and go/primitives.dag, until the .dag
//      substrate exposes type expressions as data values.

module extdeps.languages.python.primitives

// =========================================================================
// Algebra tags, partitioned by integer / non-integer / string class.
//
// Practice 4 (docs/modeling-discipline.md) ledger annotations follow the
// post-#1046 Go file style: each closed coproduct names its GREEN
// (terminal / consumed) and YELLOW (parse-scaffold reserved) arms.
// Single-arm `type X = Tag` declarations leave `Tag` unresolved in the
// v2 bootstrap compiler — every coproduct below has ≥2 arms by
// construction, with reserved arms named for their dissolution trigger.
// =========================================================================

// Python `int` is the only spec-predeclared integer; it inhabits the
// (unbounded, signed) ordered ring. The reserved arm exists solely so the
// v2 bootstrap loader resolves `PythonIntegerAlgebra` as a sum, not a unary
// alias.
//
// Practice 4: **🟢 GREEN** — `PythonOrderedRingAlgebra` is the terminal
// algebra-tag for Python's spec integer.
// **🟡 YELLOW (scaffold)** — `PythonIntegerAlgebraReserved` exists only for
// the v2 "≥2 sum arms" tag-resolution constraint; named trigger:
// bootstrap / loader closes single-arm sums, OR a future stdlib-authority
// slice lands a second integer algebra row (e.g., a Semiring inhabitant
// from numerics packages — would still NOT belong on this language-spec
// row; reserved arm dissolves regardless).
type PythonIntegerAlgebra
  = PythonOrderedRingAlgebra
  | PythonIntegerAlgebraReserved

// Bool + None share one closed algebra-tag sum (mirrors rust
// `NonIntegerAlgebra` and go `GoSpecDiscreteAlgebra` grouping). String is
// separate — its value-domain is a sequence monoid, not a discrete scalar.
//
// Practice 4: **🟢 GREEN (terminal coproduct).** Both arms are spec-realized
// and consumed: `PythonCanonicalTwoElementBooleanAlgebra` is the value-domain
// of `bool`; `PythonTerminalAlgebra` is the single-inhabitant algebra of
// `NoneType`. Each arm has a matching `PythonPrimitive` row in
// `python_spec_predeclared_primitives` / `python_dag_unit_target_primitive`.
type PythonNonIntegerAlgebra
  = PythonCanonicalTwoElementBooleanAlgebra
  | PythonTerminalAlgebra


// =========================================================================
// Target carrier tags (value-domain witnesses; not CPython object layout).
//
// `PythonUnboundedIntegerCarrier` is the honest declaration that Python's
// spec `int` is arbitrary-precision — there is no fixed bit-width and no
// modular-wrap field on `PythonIntegerPrimitive`. Substrate-gap flag #1
// names DB-11 / cardinality dissolution.
//
// `PythonBitCarrier` and `PythonTerminalCarrier` mirror the Rust/Go
// convention of declaring the algebra value-domain witness (per
// `dsl/std/integer.dag:4` "Int is a CARRIER (Word64) with EVIDENCE…"),
// not CPython object representation (CPython stores both `True`/`False`
// as singleton PyBool objects; that is target-codegen / runtime, not
// algebra value-domain).
//
// Practice 4: **🟢 GREEN (terminal coproduct).** All three arms are
// consumed by tranche-1 rows: integer (UnboundedInteger), bool (Bit), and
// None (Terminal). No reserved scaffolds — three arms is already ≥2.
// =========================================================================

type PythonTargetCarrier
  = PythonUnboundedIntegerCarrier
  | PythonBitCarrier
  | PythonTerminalCarrier


// String value = immutable Unicode code-point sequence (monoid + Unicode
// code-point carrier). Reserved arms are v2 parse scaffolding only (never
// used in data) — same single-arm-resolution issue as `PythonIntegerAlgebra`;
// do **not** add a UTF-8 / UTF-16 / encoding parallel authority here
// (header §STRING).
//
// Practice 4: **🟢 GREEN** — first arms are the terminal string-value
// witnesses (algebra: immutable codepoint-sequence monoid; carrier:
// Unicode code-point sequence). **🟡 YELLOW (scaffold)** — reserved arms
// exist only for the v2 "≥2 sum arms" tag-resolution constraint; named
// trigger: bootstrap / loader closes single-arm sums.
type PythonSpecStringAlgebraTag
  = PythonImmutableUnicodeCodePointSequenceMonoidAlgebra
  | PythonSpecStringAlgebraParseReserved

type PythonSpecStringCarrierTag
  = PythonUnicodeCodePointSequenceCarrier
  | PythonSpecStringCarrierParseReserved


// =========================================================================
// Sum-typed Python spec primitive (Lesson 5 partition).
//
// Sum-typed so each spec primitive's structurally-meaningful axes attach
// only where they have meaning: integer carrier discipline only on
// `PythonIntegerPrimitive`; string algebra/carrier tags only on
// `PythonStringPrimitive`. State-space modeling discipline — no
// `bool: PythonUnboundedIntegerCarrier`, no `int: PythonUnicodeCodePointSequenceCarrier`.
//
// No `range_min/max` and no `overflow` field on `PythonIntegerPrimitive`:
// substrate-gap flag #1 — Python's spec `int` is unbounded, so a
// fixed-range / fixed-overflow row would be a lie. Consumers needing
// concrete-width integer routing should consult target-specific lanes
// (Rust / Go `*_integer_range` rows) rather than synthesizing a width here.
// =========================================================================

type PythonPrimitive
  = PythonIntegerPrimitive {
      target_name: String
      algebra: PythonIntegerAlgebra
      carrier: PythonTargetCarrier
    }
  | PythonStringPrimitive {
      target_name: String
      algebra: PythonSpecStringAlgebraTag
      carrier: PythonSpecStringCarrierTag
    }
  | PythonBooleanPrimitive {
      target_name: String
      algebra: PythonNonIntegerAlgebra
      carrier: PythonTargetCarrier
    }
  | PythonUnitPrimitive {
      target_name: String
      algebra: PythonNonIntegerAlgebra
      carrier: PythonTargetCarrier
    }


// Predeclared spec primitives: int, bool, str.
// (None / NoneType is split into a separate top-level row below — same
// pattern as Go's `go_dag_unit_target_primitive` — because `None` is the
// canonical DAG `Unit` realization in `python/types.dag`, not a numeric
// or sequence primitive.)
//
// `float` / `complex` deferred (header §implementation-defined width).
// `bytes` / `bytearray` deferred to next tranche.
data python_spec_predeclared_primitives: List<PythonPrimitive> = [
  PythonIntegerPrimitive { target_name: "int",
    algebra: PythonOrderedRingAlgebra,
    carrier: PythonUnboundedIntegerCarrier },

  PythonBooleanPrimitive { target_name: "bool",
    algebra: PythonCanonicalTwoElementBooleanAlgebra,
    carrier: PythonBitCarrier },

  PythonStringPrimitive { target_name: "str",
    algebra: PythonImmutableUnicodeCodePointSequenceMonoidAlgebra,
    carrier: PythonUnicodeCodePointSequenceCarrier }
]

// DAG Unit → Python: `None` (the sole inhabitant of `NoneType`) is the
// target spelling for DagName `Unit` in `python/types.dag`. Split out from
// the predeclared list (same pattern as `go_dag_unit_target_primitive`)
// because `None` is a value, not a type name in the spec's predeclared-type
// list — `NoneType` is the type and is not a builtin identifier in the
// scope a user can name without `types.NoneType`. The target-name string
// here records the value spelling consumers emit ("None"), aligning with
// `python_type_checkpoints` in `python/types.dag`.
data python_dag_unit_target_primitive: PythonPrimitive = PythonUnitPrimitive {
  target_name: "None",
  algebra: PythonTerminalAlgebra,
  carrier: PythonTerminalCarrier
}
