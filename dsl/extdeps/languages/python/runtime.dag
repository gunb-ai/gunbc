// extdeps/languages/python/runtime.dag -- "How does Python operate on values at runtime?"
//
// Collection operations, string operations, dict operations, list
// comprehensions, and truthiness -- all from the Python standard library.
//
// Ref: Python Standard Library (docs.python.org/3/library)
//      Python Language Reference (docs.python.org/3/reference)
//
// Consumers:
//   v2/05_emit_python.dag -- method call emission, pipe operator translation

module extdeps.languages.python.runtime

// -- String operations -----------------------------------------------
// Ref: str type (docs.python.org/3/library/stdtypes.html#text-sequence-type-str)

// "How does Python create a string literal?"
// Python strings need no suffix -- str is the native string type.
data string_literal_prefix: String = ""

// "How does Python do string interpolation?"
// Ref: PEP 498 "Literal String Interpolation" (f-strings, Python 3.6+)
data fstring_template: String = "f\"\{content\}\""
data fstring_expr_template: String = "\{\{\{expr\}\}\}"

// "How does Python index into a string?"
// Direct indexing is supported: s[i] returns a single character as str.
data string_index_template: String = "\{base\}[\{index\}]"

// "How does Python slice a string?"
// Slice syntax: s[start:end] (end exclusive).
data string_slice_template: String = "\{base\}[\{start\}:\{end\}]"

// "How does Python split a string?"
data string_split_template: String = "\{recv\}.split(\{delim\})"

// "How does Python join strings?"
// join is a method on the separator string, not the list.
data string_join_template: String = "\{sep\}.join(\{recv\})"

// "How does Python get characters from a string?"
// Authority: Char = Int (std/types.dag). chars() returns List<Int> of
// Unicode codepoints. Mirrors emit.dag and algebra.dag's chars return type.
data string_chars_template: String = "[ord(c) for c in \{recv\}]"

// -- Collection operations -------------------------------------------
// Ref: list, tuple, set (docs.python.org/3/library/stdtypes.html)

// `MethodTranslation` + `collection_method_translations` retired in
// T-Ground-LanguageSpec scope E Phase 2 (#1196 follow-up): zero v2
// consumers, zero stage0 references, fully dead. Method-template
// authority is the registry-backed `MethodTemplateContract` rows
// (type at `dsl/std/emit_model.dag`). v2's emit pipeline still reads
// the `python_method_templates: Map` below — Phase 2 retirement of THAT
// path folds into Pure-Bootstrap-Zero / v2 retirement scope (manager
// dispatch #1133 inbox 4344956791).

// "How does Python iterate?"
data for_each_template: String = "for \{var\} in \{collection\}:\n    \{body\}"

// -- List comprehensions ---------------------------------------------
// Ref: Python Reference 6.2.4 "Displays for lists, sets and dictionaries"

data list_comp_template: String = "[\{expr\} for \{var\} in \{iter\}]"
data list_comp_filter_template: String = "[\{expr\} for \{var\} in \{iter\} if \{cond\}]"
data dict_comp_template: String = "\{\{\{key\}: \{value\} for \{var\} in \{iter\}\}\}"

// -- Dict operations -------------------------------------------------
// Ref: dict (docs.python.org/3/library/stdtypes.html#mapping-types-dict)

data dict_get_template: String = "\{dict\}.get(\{key\})"
data dict_set_template: String = "\{dict\}[\{key\}] = \{value\}"
data dict_contains_template: String = "\{key\} in \{dict\}"
data dict_literal_template: String = "\{\{\{entries\}\}\}"

// -- Null coalescing -------------------------------------------------
// Python has no ?? operator. Use ternary expression.

// DAG ?? operator -> Python conditional expression.
data null_coalesce_template: String = "\{lhs\} if \{lhs\} is not None else \{rhs\}"

// -- Truthiness ------------------------------------------------------
// Ref: Python Reference 5.10 "Boolean operations"

// Python considers these falsy: None, False, 0, 0.0, "", [], {}, set(), b""
data falsy_values: List<String> = ["None", "False", "0", "0.0", "\"\"", "[]", "{}", "set()", "b\"\""]

// -- Built-in functions used in emission -----------------------------
// Ref: Python Built-in Functions (docs.python.org/3/library/functions.html)

data len_function: String = "len"
data str_function: String = "str"
data int_function: String = "int"
data float_function: String = "float"
data bool_function: String = "bool"
data list_function: String = "list"
data dict_function: String = "dict"
data enumerate_function: String = "enumerate"
data range_function: String = "range"
data isinstance_function: String = "isinstance"

// -- JSON serialization ----------------------------------------------
// Ref: json module (docs.python.org/3/library/json.html)

data json_import: String = "import json"
data json_dumps_template: String = "json.dumps(\{value\}, indent=2)"
data json_loads_template: String = "json.loads(\{text\})"

// -- Numeric casting -------------------------------------------------
// Python uses constructor functions, not cast operators.
data int_cast_template: String = "int(\{expr\})"
data float_cast_template: String = "float(\{expr\})"
data str_cast_template: String = "str(\{expr\})"
