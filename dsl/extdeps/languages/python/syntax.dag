// Python syntax specification.
//
// Operator semantics for Python emission. The emitter reads operator
// symbols from this spec — no hardcoded Python syntax in the compiler.
//
// Ref: Python Reference §6 "Expressions"
// https://docs.python.org/3/reference/expressions.html

module extdeps.languages.python.syntax

import std.syntax {
  OperatorSpec,
  BinOp, Add, Sub, Mul, Div, Mod,
  Eq, Ne, Lt, Gt, Le, Ge, And, Or, NullCoalesce
}

// Python operator precedence (emission-relevant subset).
// Python uses word operators for boolean (and, or) and // for integer div.
// Ref: Python Reference §6.17 "Operator precedence"

data python_operators: List<OperatorSpec> = [
  OperatorSpec { symbol: "or", left_bp: 5, right_bp: 6, binop: Or, algebra_field: none },
  OperatorSpec { symbol: "and", left_bp: 7, right_bp: 8, binop: And, algebra_field: none },
  OperatorSpec { symbol: "==", left_bp: 9, right_bp: 10, binop: Eq, algebra_field: none },
  OperatorSpec { symbol: "!=", left_bp: 9, right_bp: 10, binop: Ne, algebra_field: none },
  OperatorSpec { symbol: "<", left_bp: 11, right_bp: 12, binop: Lt, algebra_field: none },
  OperatorSpec { symbol: ">", left_bp: 11, right_bp: 12, binop: Gt, algebra_field: none },
  OperatorSpec { symbol: "<=", left_bp: 11, right_bp: 12, binop: Le, algebra_field: none },
  OperatorSpec { symbol: ">=", left_bp: 11, right_bp: 12, binop: Ge, algebra_field: none },
  OperatorSpec { symbol: "+", left_bp: 13, right_bp: 14, binop: Add, algebra_field: none },
  OperatorSpec { symbol: "-", left_bp: 13, right_bp: 14, binop: Sub, algebra_field: none },
  OperatorSpec { symbol: "*", left_bp: 15, right_bp: 16, binop: Mul, algebra_field: none },
  // Div is algebra-aware: Float (Field) → true division "/",
  // Int (OrderedRing) → integer division "//".
  // Ref: Python Reference §6.7 "Binary arithmetic operations"
  OperatorSpec { symbol: "/", left_bp: 15, right_bp: 16, binop: Div, algebra_field: Some { value: "reciprocal" } },
  OperatorSpec { symbol: "//", left_bp: 15, right_bp: 16, binop: Div, algebra_field: Some { value: "quotient" } },
  OperatorSpec { symbol: "%", left_bp: 15, right_bp: 16, binop: Mod, algebra_field: none }
]
