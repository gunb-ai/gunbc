// extdeps/languages/bash/program.dag — structured shell-program model + byte-faithful serializer.
//
// Peer of `dsl/extdeps/formats/yaml.dag` (a YamlValue AST + serialize_yaml fold). This module
// models a shell *program* as data so that host-transport scripts stop being hand-written string
// blobs (`let script = "set -e\nWORKDIR=$(mktemp -d)..."`). The serializer output feeds
// `shell.Exec.Run { input { script: String } }` — the transport that is already modeled — so a
// transport's policy lives in a typed Node tree, not in an opaque String the §5/§6 way.
//
// Spec: POSIX.1-2017 Shell Command Language §2.2 (Quoting), §2.9 (Lists / Compound Commands)
//       https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
//
// v2-clean (no std.render / std.unicode imports) so witnesses execute under the v1 interpreter.
//
// Consumers:
//   test.claim.bash_serializer_witness  -- golden + discriminating by-execution witness
//   tools/dsl_compile_clean_transport   -- first real transport rewritten off the blob

module extdeps.languages.bash.program

// =========================================================================
// Words — the atoms of a simple command.
//
// `Lit` MUST be single-quoted so the shell does not expand metacharacters inside it
// (POSIX §2.2.2: single quotes preserve every character literally). `VarRef` is a
// double-quoted parameter expansion. `Concat` glues adjacent words with no separator
// (the structural form of `"$ROOT"/path` interpolation). `CmdSubst` is `$( stmt )`.
// `Raw` is the escape hatch for an already-correct fragment with no structural model.
// =========================================================================

type ShellWord
  = Lit { text: String }
  | VarRef { name: String }
  | Concat { parts: List<ShellWord> }
  | CmdSubst { body: ShellStmt }
  // 🟡 dissolution trigger: a structural model exists for every fragment that today
  // reaches for Raw (the host-language ban lens RED-flags Raw in transport position).
  | Raw { text: String }

// =========================================================================
// Statements + lists.
//
// A test (`[ ... ]`, `test -x …`) is NOT a separate kind — POSIX §2.9.1: the `if`
// condition is a command list whose exit status is consulted, and `[`/`test` are
// ordinary commands. So `If.cond` is a `ShellStmt` and a bracket test is a `Command`
// (see `test_not_executable`), one concept not two (§2).
// =========================================================================

type AndOrOp
  = AndThen                                 // &&
  | OrElse                                  // ||

type Redir
  = StderrToNull                            // 2>/dev/null
  | StdoutAndStderrToNull                   // >/dev/null 2>&1
  | StdoutToStderr                          // >&2

type ShellStmt
  = Command { words: List<ShellWord> }
  | Assign { name: String, value: ShellWord }
  | If { cond: ShellStmt, then: List<ShellStmt> }
  | Subshell { body: List<ShellStmt> }
  | AndOr { left: ShellStmt, op: AndOrOp, right: ShellStmt }
  | WithRedir { stmt: ShellStmt, redir: Redir }
  // Heredoc: `cat > <path> <<'<delimiter>'\n<body>\n<delimiter>`. The body is literal
  // file content (a fixture / a .dag source), not shell control flow — a String payload,
  // not smuggled policy. Always a quoted delimiter (no expansion in the body).
  | Heredoc { path: ShellWord, delimiter: String, body: String }
  | Exit { code: Int }
  // 🟡 dissolution trigger: same as ShellWord.Raw.
  | RawLine { text: String }

type ShellProgram {
  set_e: Bool
  statements: List<ShellStmt>
}

// -- constructors -----------------------------------------------------

fn lit(text: String) -> ShellWord {
  Lit { text: text }
}

fn var_ref(name: String) -> ShellWord {
  VarRef { name: name }
}

fn command(words: List<ShellWord>) -> ShellStmt {
  Command { words: words }
}

fn assign(name: String, value: ShellWord) -> ShellStmt {
  Assign { name: name, value: value }
}

// `[ ! -x <path> ]` — bracket test as the ordinary command it is.
fn test_not_executable(path: ShellWord) -> ShellStmt {
  Command { words: [lit(text: "["), lit(text: "!"), lit(text: "-x"), path, lit(text: "]")] }
}

// -- quoting ----------------------------------------------------------

// POSIX §2.2.2: inside single quotes every character is literal and a single quote
// cannot appear, so an embedded `'` is rendered as the canonical `'\''` (close, escaped
// quote, reopen). This is the total, always-safe quoting of an arbitrary literal.
fn single_quote(s: String) -> String {
  concat("'", concat(replace(s, "'", "'\\''"), "'"))
}

// -- serialization (mirror of serialize_yaml's per-node helpers + one top fold) ----

fn serialize_word(w: ShellWord) -> String {
  match w {
    Lit { text: t } => single_quote(s: t)
    VarRef { name: n } => concat("\"$", concat(n, "\""))
    Concat { parts: ps } => fold(ps, init: "", f: (acc, p) => concat(acc, serialize_word(w: p)))
    CmdSubst { body: b } => concat("$(", concat(serialize_stmt(s: b), ")"))
    Raw { text: t } => t
  }
}

fn join_words(words: List<ShellWord>) -> String {
  fold(words, init: "", f: (acc, w) => {
    let part = serialize_word(w: w)
    if acc == "" { part } else { concat(acc, concat(" ", part)) }
  })
}

fn serialize_redir(r: Redir) -> String {
  match r {
    StderrToNull => "2>/dev/null"
    StdoutAndStderrToNull => ">/dev/null 2>&1"
    StdoutToStderr => ">&2"
  }
}

fn serialize_and_or_op(op: AndOrOp) -> String {
  match op {
    AndThen => "&&"
    OrElse => "||"
  }
}

// then-body / subshell-body: statements joined by `; ` (single-line compound command).
fn join_stmts_semi(stmts: List<ShellStmt>) -> String {
  fold(stmts, init: "", f: (acc, s) => {
    let part = serialize_stmt(s: s)
    if acc == "" { part } else { concat(acc, concat("; ", part)) }
  })
}

fn serialize_stmt(s: ShellStmt) -> String {
  match s {
    Command { words: ws } => join_words(words: ws)
    Assign { name: n, value: v } => concat(n, concat("=", serialize_word(w: v)))
    If { cond: c, then: body } =>
      concat("if ", concat(serialize_stmt(s: c),
        concat("; then ", concat(join_stmts_semi(stmts: body), "; fi"))))
    Subshell { body: b } => concat("(", concat(join_stmts_semi(stmts: b), ")"))
    Heredoc { path: p, delimiter: d, body: b } =>
      concat("cat > ", concat(serialize_word(w: p),
        concat(" <<'", concat(d, concat("'\n", concat(b, concat("\n", d)))))))
    AndOr { left: l, op: o, right: r } =>
      concat(serialize_stmt(s: l),
        concat(" ", concat(serialize_and_or_op(op: o), concat(" ", serialize_stmt(s: r)))))
    WithRedir { stmt: st, redir: rd } =>
      concat(serialize_stmt(s: st), concat(" ", serialize_redir(r: rd)))
    Exit { code: c } => concat("exit ", to_string(c))
    RawLine { text: t } => t
  }
}

// Total serializer: ShellProgram → POSIX shell text (trailing newline at EOF).
fn serialize_bash(p: ShellProgram) -> String {
  let body = fold(p.statements, init: "", f: (acc, s) =>
    concat(acc, concat(serialize_stmt(s: s), "\n")))
  if p.set_e {
    concat("set -e\n", body)
  } else {
    body
  }
}
