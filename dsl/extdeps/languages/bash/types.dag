// Bash/POSIX shell type system.
//
// Spec: POSIX.1-2017 Shell Command Language
//       https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
// Spec: GNU Bash Reference Manual — Shell Parameters
//       https://www.gnu.org/software/bash/manual/bash.html#Shell-Parameters
//
// Bash has a weak type system: all values are strings by default.
// Integers exist in arithmetic contexts (declare -i, $((...)), let).
// Arrays and associative arrays are bash extensions (not POSIX).
//
// Consumers:
//   v2/05_emit_rust.dag  -- shell transport return type decisions

module extdeps.languages.bash.types

// POSIX.1-2017 Section 2.8.2: Exit Status.
// Every command produces an integer exit status.
// 0 = success, 1-125 = command-specific failure,
// 126 = command not executable, 127 = command not found,
// 128+N = terminated by signal N.

type ExitStatus
  = Success
  | Failure { code: Int }
  | SignalTerminated { signal: Int }
  | CommandNotFound
  | CommandNotExecutable

data exit_success: Int = 0
data exit_general_error: Int = 1
data exit_command_not_found: Int = 127
data exit_command_not_executable: Int = 126
data exit_signal_base: Int = 128

// Bash value representation: everything is a string.
// These type checkpoints map .dag types to bash representations
// for contexts where bash needs to handle typed values.

type BashValueKind
  = StringValue
  | IntegerValue
  | ArrayValue
  | AssocArrayValue
