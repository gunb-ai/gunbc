// Bash/POSIX shell emission facts.
//
// Spec: POSIX.1-2017 Section 2.2 (Quoting)
//       https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html#tag_18_02
// Spec: POSIX.1-2017 Section 2.6.2 (Parameter Expansion)
//       https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html#tag_18_06_02
//
// Facts that the Rust emitter needs when generating std::process::Command
// code for shell transport calls. The emitter reads these to determine
// how to safely construct shell command strings in Rust.
//
// Consumers:
//   v2/05_emit_rust.dag  -- emit_shell_call, emit_shell_argv_element

module extdeps.languages.bash.emit

import extdeps.languages.bash.syntax { QuotingMode, Unquoted, SingleQuoted, DoubleQuoted }

// =========================================================================
// Metacharacters
//
// POSIX.1-2017 Section 2.2: characters that have special meaning to
// the shell when unquoted. A string containing any of these needs
// quoting to be used as a literal value.
// =========================================================================

data unquoted_metacharacters: List<String> = [
  "|", "&", ";", "(", ")", "<", ">",
  " ", "\t", "\n",
  "$", "`", "\\", "\"", "'",
  "*", "?", "[", "]", "#", "~", "=", "%",
  "{", "}"
]

// =========================================================================
// Quoting rules per mode
//
// POSIX.1-2017 Section 2.2.1-2.2.3:
// Each quoting mode has different characters that retain special meaning.
// =========================================================================

// Single-quoted strings (Section 2.2.2):
// ALL characters are literal. No expansion, no escaping.
// The ONLY character that cannot appear is the single-quote itself.
// To include a single-quote: end the string, insert an escaped quote,
// restart: 'can'\''t' → can't

type QuotingRule {
  mode: QuotingMode
  special_chars: List<String>
  escape_char: String?
  allows_expansion: Bool
}

data single_quote_rule: QuotingRule = QuotingRule {
  mode: SingleQuoted,
  special_chars: ["'"],
  escape_char: none,
  allows_expansion: false
}

// Double-quoted strings (Section 2.2.3):
// Most characters are literal. Only $, `, \, and " retain meaning.
// Parameter expansion and command substitution occur inside double quotes.

data double_quote_rule: QuotingRule = QuotingRule {
  mode: DoubleQuoted,
  special_chars: ["$", "`", "\\", "\""],
  escape_char: "\\",
  allows_expansion: true
}

// Unquoted context:
// All metacharacters are active. Must escape or quote to use literally.

data unquoted_rule: QuotingRule = QuotingRule {
  mode: Unquoted,
  special_chars: ["|", "&", ";", "(", ")", "<", ">", " ", "\t", "\n",
    "$", "`", "\\", "\"", "'", "*", "?", "[", "]", "#", "~", "=", "%", "{", "}"],
  escape_char: "\\",
  allows_expansion: true
}

// =========================================================================
// Parameter expansion syntax
//
// POSIX.1-2017 Section 2.6.2:
// ${parameter} is the canonical form. $parameter is the short form
// (stops at first non-name character).
// =========================================================================

type VariableRefStyle
  = SimpleRef
  | BracedRef

data simple_variable_prefix: String = "$"
data braced_variable_open: String = "${"
data braced_variable_close: String = "}"

// =========================================================================
// Safe string classification
//
// A string is "safe" for unquoted use if it contains ONLY characters
// that have no special meaning to the shell. Safe strings need no
// quoting when used as command arguments.
// =========================================================================

data safe_unquoted_chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-./:"

// =========================================================================
// Recommended quoting strategy for .dag parameter injection
//
// When the emitter injects a .dag parameter value into a shell command:
// 1. If the value is known-safe (alphanumeric + safe chars): use unquoted
// 2. If the value may contain special chars: single-quote it
//    (prevents all expansion — safest default)
// 3. If expansion is needed inside the value: double-quote it
//    (allows $VAR but prevents word splitting and globbing)
//
// Single-quoting is the fail-safe default because it prevents injection.
// =========================================================================

type InjectionStrategy
  = SafeUnquoted
  | SingleQuoteWrap
  | DoubleQuoteWrap
  | EscapeEach

data default_injection_strategy: InjectionStrategy = SingleQuoteWrap
