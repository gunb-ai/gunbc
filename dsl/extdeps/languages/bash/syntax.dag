// Bash/POSIX shell syntax specification.
//
// Spec: POSIX.1-2017 Shell Command Language
//       https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
// Spec: GNU Bash Reference Manual
//       https://www.gnu.org/software/manual/manual.html
//
// Models the surface syntax of POSIX shell / bash as structural data.
// The compiler reads these facts when generating Rust code that invokes
// shell commands via std::process::Command.
//
// Consumers:
//   v2/05_emit_rust.dag  -- shell transport argv emission

module extdeps.languages.bash.syntax

// POSIX.1-2017 Section 2.4: Reserved Words.
// These words are recognized as reserved when unquoted and when
// used as the first word of a command or after a control operator.

data bash_reserved_words: Map<String, Bool> = {
  "if": true, "then": true, "else": true, "elif": true, "fi": true,
  "do": true, "done": true, "case": true, "esac": true,
  "while": true, "until": true, "for": true, "in": true,
  "function": true, "select": true, "time": true,
  "return": true, "exit": true, "break": true, "continue": true,
  "local": true, "declare": true, "typeset": true, "readonly": true,
  "export": true, "unset": true, "shift": true,
  "trap": true, "eval": true, "exec": true, "source": true
}

// POSIX.1-2017 Section 2.2: Quoting.
// Three quoting mechanisms prevent the shell from interpreting
// metacharacters. Each has different expansion rules.

type QuotingMode
  = Unquoted
  | SingleQuoted
  | DoubleQuoted

// POSIX.1-2017 Section 2.2.1: Escape Character (Backslash).
// A backslash preserves the literal value of the following character,
// with the exception of newline (line continuation).

// POSIX.1-2017 Section 2.6: Word Expansions.
// Order of expansion in unquoted and double-quoted contexts:
// 1. Tilde expansion
// 2. Parameter expansion ${param}
// 3. Command substitution $(command)
// 4. Arithmetic expansion $((expression))
// 5. Field splitting (unquoted only)
// 6. Pathname expansion / globbing (unquoted only)

type ExpansionKind
  = ParameterExpansion
  | CommandSubstitution
  | ArithmeticExpansion
  | TildeExpansion
  | PathnameExpansion
  | FieldSplitting
