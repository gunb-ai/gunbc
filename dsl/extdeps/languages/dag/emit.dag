// extdeps/languages/dag/emit.dag -- .dag language facts for the v2 emitter.
//
// The .dag target is used for debug output and pretty-printing.
// This file provides Dag-specific data so that language_spec_for_target(Dag)
// returns a proper dag_spec() instead of falling back to rust_spec().
//
// Consumers:
//   v2/languages.dag  -- dag_spec() constructor

module extdeps.languages.dag.emit

// -- Keyword/operator translation ----------------------------------------
data dag_keywords: Map<String, String> = {
  "true": "true", "false": "false", "null": "none",
  "and": "&&", "or": "||", "not": "!",
  "div": "/"
}

// -- Container type templates --------------------------------------------
// .dag containers use their natural names.
data dag_container_templates: Map<String, String> = {
  "list": "List<\{0\}>", "set": "Set<\{0\}>",
  "non_empty_list": "NonEmptyList<\{0\}>", "non_empty_set": "NonEmptySet<\{0\}>",
  "optional": "\{0\}?", "map": "Map<\{0\}, \{1\}>",
  "free_monoid": "List<\{0\}>", "partial_function": "Map<\{0\}, \{1\}>",
  "boolean_algebra": "Bool"
}

// -- Reserved words (empty — .dag handles keywords via keyword_set) ------
data dag_reserved: List<String> = []

// -- String-like types ---------------------------------------------------
data dag_string_types: List<String> = ["String", "Secret"]

// -- Item definition facts -----------------------------------------------
data dag_func_keyword: String = "fn"
data dag_async_prefix: String = ""
data dag_struct_keyword: String = "type"
data dag_enum_keyword: String = "type"
data dag_type_alias_keyword: String = "type"
data dag_param_separator: String = ", "
data dag_return_arrow: String = " -> "
data dag_param_type_sep: String = ": "
data dag_module_keyword: String = "module"
data dag_import_keyword: String = "import"
data dag_import_from_keyword: String = ""

// -- Expression syntax templates ------------------------------------------
data dag_lambda_template: String = "({0}) => {1}"
data dag_error_expr_template: String = "error({0})"
data dag_list_literal_empty: String = "[]"
data dag_list_literal_template: String = "[{0}]"
data dag_null_coalesce_template: String = "{0} ?? {1}"
data dag_error_type_template: String = "__EMIT_BUG_{0}__"
data dag_type_arg_open: String = "<"
data dag_type_arg_close: String = ">"
data dag_void_type: String = "()"
data dag_tuple_empty: String = "()"
data dag_tuple_pair_template: String = "({0}, {1})"
data dag_tuple_multi_template: String = "({0})"
data dag_tuple_separator: String = ", "

// -- Project scaffold ----------------------------------------------------
data dag_source_extension: String = ".dag"
