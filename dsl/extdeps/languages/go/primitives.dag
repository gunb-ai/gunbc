// extdeps/languages/go/primitives.dag — Structural target-primitive declarations
// for the Go target (T-Ground-Go / spec authority).
//
// Declared language version (extdeps.md — declare the version): Go 1.23.
// https://go.dev/ref/spec is the official spec but tracks the current release as
// tip HTML; stable authority for this module is Go 1.23 plus the release slice at
// https://go.dev/doc/go1.23 — read the spec through that version, not as unversioned
// "latest language" drift. Bump the version and both URLs' roles together when retargeting.
//
// SOURCE AUTHORITY (Go 1.23 — same pin as above):
//   Language specification — https://go.dev/ref/spec
//     Types — predeclared numeric, string, boolean, and struct{} types
//     Comparison operators — ordering relations on integral values (orthogonal to
//       machine arithmetic routing for + / * / − / negation semantics)
//     Overflow — fixed-width signed two's-complement wrap vs unsigned modular
//       reduction for non-constant expressions
//   Release notes (implementation slice) — https://go.dev/doc/go1.23
//
// TRANCHE 1 (this file): Go spec predeclared types with fixed machine
// representations — booleans, fixed-width integers, floats, complex, string,
// and the byte/rune aliases (ref/spec Types, Predeclared_identifiers).
// The empty struct type `struct{}` is **not** predeclared; it is the canonical
// **DAG Unit → Go target** realization (same authority edge as `go/types.dag`)
// and lives in a **separate** top-level row `go_dag_unit_target_primitive` below.
// Implementation-sized int, uint, and uintptr are intentionally omitted from the
// data table: their width / value set is implementation-defined (ref/spec Numeric
// types, https://go.dev/ref/spec#Numeric_types), so a fixed Word* carrier +
// numeric range would violate the same no-lying-about-width discipline as the
// Rust pilot’s u64 note — close under a GOARCH-tagged width story with DB-11 /
// cardinality substrate.
//
// TWO-AUTHORITY DISCIPLINE (ROADMAP Post-R1 Grounding lanes):
//   (a) THIS FILE — Go 1.23 language specification (go.dev/ref/spec, read per header pin).
//   (b) stdlib carriers and product-specific rows (e.g. []byte for Bytes,
//       interface{} for Json) stay in go/types.dag + emit tables until a
//       dedicated stdlib-authority slice lands; do not cite stdlib paths here.
//
// CONSUMER BOUNDARY: same Path-2 honest state as rust/primitives.dag — the
// top-level `go_spec_predeclared_primitives` list and `go_dag_unit_target_primitive`
// lower as ValueBody::Unparsed until R2 T-Substrate’s top-level aggregate sub-lane
// lands; type-structure (GoPrimitive = …) is walkable for Engine / future loaders.
//
// LESSON 5 (grounding-pilot-receipt.md): subset-only axes are structurally
// partitioned — integer overflow lives only on integer variants; float width
// only on GoFloatPrimitive; complex component width only on GoComplexPrimitive;
// alias linkage only on GoIntegerAliasPrimitive (byte/rune). Integer rows pair
// `arithmetic` (signed two's-complement machine vs unsigned modular machine),
// `ordered_comparison` (Go spec comparison operators on integral values), and
// `carrier: GoIntegerMachineWordCarrier` (no Bit / terminal / UTF-8 arms).
//
// STRING (ref/spec String types, https://go.dev/ref/spec#String_types): a string
// value is an immutable sequence of bytes — not UTF-8 text as the primary
// authority. UTF-8 is a source-literal / conversion refinement layered on
// that byte sequence; it is modeled as a separate algebra+carrier arm from the
// spec-faithful byte-sequence witness used in `go_spec_predeclared_primitives`.
//
// SUBSTRATE-GAP FLAGS: `overflow` on integer variants follows the Rust pilot’s
// *placement* (per-variant bridge tags). `GoIntegerOverflow` carries two **Go-spec-grounded**
// witnesses (signed vs unsigned presentation of fixed-width overflow; ref/spec Overflow)
// — not Rust’s saturating/trap operator families (see `GoIntegerOverflow` header).
// Post-DB-11 these become refinements on carriers / algebras.

module extdeps.languages.go.primitives

// =========================================================================
// Practice 4 — Coproduct dissolution checkpoint
// (`docs/modeling-discipline.md` Practice 4). Every N≥2 sum in this module is classified.
// =========================================================================
//
// | Coproduct                    | Class | Ledger / trigger |
// |-----------------------------|-------|-------------------|
// | GoIntegerArithmeticAlgebra  | YELLOW | Pattern 3 partial: signed vs fixed-width Go machine arithmetic (two's-complement wrap) vs unsigned modular — not a claim of full std.algebra OrderedRing / Semiring law packages on Go values (overflow breaks those laws); routing tags until T-Ground-Engine + DB-11 close substrate-gap #2 analog. |
// | GoIntegerSpecComparison     | GREEN | Ledger: signed vs unsigned witnesses for Go-spec comparison operators on integral values — not emergent from arithmetic routing alone (uint* still admits `<` in Go). |
// | GoIntegerMachineWordCarrier | GREEN | Ledger: row-specific width witness — subset of machine carriers; illegal int8→Bit / terminal / UTF-8 states unrepresentable. |
// | GoIntegerOverflow           | GREEN | Ledger: two arms = spec’s two overflow presentations for fixed-width numerics (signed non-constant two's-complement wrap vs unsigned modular reduction). |
// | GoFloatAlgebra              | YELLOW | Same as rust pilot — width tags bridge approximate-field algebras. |
// | GoTargetCarrier             | YELLOW | Tags bridge std.bit (+ terminal); integer rows do not use this sum. |
// | GoStringAlgebra             | YELLOW | Primary vs UTF-8 refinement arm (M3). |
// | GoStringCarrier             | YELLOW | Parallel to GoStringAlgebra. |
// | GoFloatCarrier              | GREEN | Two float bit carriers. |
// | GoComplexComponentWidth     | GREEN | Ledger: two irreducible spec widths. |
// | GoPrimitive                 | GREEN | Ledger: heterogeneous spec partition (Lesson 5). |
// =========================================================================

// --- Algebra tags (Go-prefixed names; avoid colliding with rust/primitives.dag
// in the shared bootstrap Dag). ---

// Machine **arithmetic** partition (M9 / extdeps fidelity): signed fixed-width Go
// ints use two's-complement wrap on non-constant overflow; unsigned ints use
// modular reduction (ref/spec Overflow — see `GoIntegerOverflow`). These arms
// **do not** assert that int8…int64 **inhabit** std.algebra.OrderedRing as
// law-complete objects (wrap breaks order-compatible addition); unsigned arms
// likewise do not claim an unrestricted Semiring law package under modular wrap.
// Tags parallel rust IntegerAlgebra’s signed/unsigned **routing** split only
// (substrate-gap #2). Go's **comparison** operators stay on `GoIntegerSpecComparison`.
type GoIntegerArithmeticAlgebra
  = GoSignedTwosComplementMachineArithmetic
  | GoUnsignedModularMachineArithmetic

// Go language **spec** fact: comparison operators on predeclared integral types.
// Split signed vs unsigned presentation so this stays a multi-arm sum (loader
// resolution); both arms record the same spec obligation for their class.
type GoIntegerSpecComparison
  = GoSignedIntegralComparisonWitness
  | GoUnsignedIntegralComparisonWitness

// Float algebra tags must be introduced in a multi-arm sum (same rule as
// rust/primitives.dag: a single-arm `type X = Tag` leaves `Tag` unresolved).
// Width-split tags keep float32 vs float64 structurally honest.
type GoFloatAlgebra
  = GoApproximateField32Algebra
  | GoApproximateField64Algebra

// Bool + empty struct share one closed algebra-tag sum (mirrors rust
// `NonIntegerAlgebra` grouping for non-integer scalars). String is separate —
// spec value domain is byte sequence, not UTF-8 monoid (see header note).
type GoSpecDiscreteAlgebra
  = GoCanonicalTwoElementBooleanAlgebra
  | GoTerminalAlgebra

// Primary arm: immutable byte sequence (Go spec string value). Second arm:
// UTF-8 as an explicit refinement / alternate view — not asserted as the spec
// authority for the `string` predeclared type itself (M3 / extdeps fidelity).
type GoStringAlgebra
  = GoImmutableByteSequenceMonoidAlgebra
  | GoUtf8EncodingRefinementAlgebra

type GoStringCarrier
  = GoImmutableByteSequenceCarrier
  | GoUtf8CodeUnitSequenceViewCarrier


// --- Target carrier tags (value-domain witnesses; not ABI / GC shape). ---
//
// Integer primitives (`GoIntegerPrimitive` / `GoIntegerAliasPrimitive`) use
// `GoIntegerMachineWordCarrier` only — not this sum — so Bit / terminal carriers
// are structurally illegal on integer rows (illegal-states-unrepresentable).

type GoTargetCarrier
  = GoBitCarrier
  | GoByteCarrier
  | GoWord16Carrier
  | GoWord32Carrier
  | GoWord64Carrier
  | GoTerminalCarrier

type GoIntegerMachineWordCarrier
  = GoByteCarrier
  | GoWord16Carrier
  | GoWord32Carrier
  | GoWord64Carrier


type GoFloatCarrier
  = GoFloat32BitsCarrier
  | GoFloat64BitsCarrier

// Two **Go-authority-only** arms so constructor tags resolve under the same rule
// as `GoFloatAlgebra` (see rust/primitives.dag — a single-arm alias can leave tags
// unresolved in the loader). Signed: two's-complement wrap for non-constant overflow;
// unsigned: modular reduction. Do not add Rust-shaped Saturating/Trap variants for
// these predeclared int8…uint64 names (INVARIANTS P1).
type GoIntegerOverflow
  = GoSignedFixedWidthTwoComplementWrap
  | GoUnsignedFixedWidthModularWrap


type GoComplexComponentWidth
  = GoComplex64Components
  | GoComplex128Components


// --- Sum-typed Go spec primitive (Lesson 5 partition). ---

type GoPrimitive
  = GoIntegerPrimitive {
      target_name: String
      arithmetic: GoIntegerArithmeticAlgebra
      ordered_comparison: GoIntegerSpecComparison
      carrier: GoIntegerMachineWordCarrier
      overflow: GoIntegerOverflow
      // Bounds live only on this variant’s list row in `go_spec_predeclared_primitives`
      // (single authority; no parallel `go_*_integer_range` data declarations).
      range_min_inclusive: String
      range_max_inclusive: String
    }
  | GoIntegerAliasPrimitive {
      target_name: String
      canon_name: String
      arithmetic: GoIntegerArithmeticAlgebra
      ordered_comparison: GoIntegerSpecComparison
      carrier: GoIntegerMachineWordCarrier
      overflow: GoIntegerOverflow
      range_min_inclusive: String
      range_max_inclusive: String
    }
  | GoFloatPrimitive {
      target_name: String
      algebra: GoFloatAlgebra
      carrier: GoFloatCarrier
    }
  | GoComplexPrimitive {
      target_name: String
      component_width: GoComplexComponentWidth
    }
  | GoStringPrimitive {
      target_name: String
      algebra: GoStringAlgebra
      carrier: GoStringCarrier
    }
  | GoBooleanPrimitive {
      target_name: String
      algebra: GoSpecDiscreteAlgebra
      carrier: GoTargetCarrier
    }
  | GoUnitPrimitive {
      target_name: String
      algebra: GoSpecDiscreteAlgebra
      carrier: GoTargetCarrier
    }


// Predeclared fixed-width numerics + aliases + floats + complex + bool + string
// only (ref/spec Predeclared_identifiers / Types). Order: signed ints, unsigned ints,
// aliases, floats, complex, bool, string. (int/uint/uintptr omitted — implementation width.)
data go_spec_predeclared_primitives: List<GoPrimitive> = [
  GoIntegerPrimitive { target_name: "int8", arithmetic: GoSignedTwosComplementMachineArithmetic,
    ordered_comparison: GoSignedIntegralComparisonWitness, carrier: GoByteCarrier,
    overflow: GoSignedFixedWidthTwoComplementWrap,
    range_min_inclusive: "-128", range_max_inclusive: "127" },
  GoIntegerPrimitive { target_name: "int16", arithmetic: GoSignedTwosComplementMachineArithmetic,
    ordered_comparison: GoSignedIntegralComparisonWitness, carrier: GoWord16Carrier,
    overflow: GoSignedFixedWidthTwoComplementWrap,
    range_min_inclusive: "-32768", range_max_inclusive: "32767" },
  GoIntegerPrimitive { target_name: "int32", arithmetic: GoSignedTwosComplementMachineArithmetic,
    ordered_comparison: GoSignedIntegralComparisonWitness, carrier: GoWord32Carrier,
    overflow: GoSignedFixedWidthTwoComplementWrap,
    range_min_inclusive: "-2147483648", range_max_inclusive: "2147483647" },
  GoIntegerPrimitive { target_name: "int64", arithmetic: GoSignedTwosComplementMachineArithmetic,
    ordered_comparison: GoSignedIntegralComparisonWitness, carrier: GoWord64Carrier,
    overflow: GoSignedFixedWidthTwoComplementWrap,
    range_min_inclusive: "-9223372036854775808", range_max_inclusive: "9223372036854775807" },

  GoIntegerPrimitive { target_name: "uint8", arithmetic: GoUnsignedModularMachineArithmetic,
    ordered_comparison: GoUnsignedIntegralComparisonWitness, carrier: GoByteCarrier,
    overflow: GoUnsignedFixedWidthModularWrap,
    range_min_inclusive: "0", range_max_inclusive: "255" },
  GoIntegerPrimitive { target_name: "uint16", arithmetic: GoUnsignedModularMachineArithmetic,
    ordered_comparison: GoUnsignedIntegralComparisonWitness, carrier: GoWord16Carrier,
    overflow: GoUnsignedFixedWidthModularWrap,
    range_min_inclusive: "0", range_max_inclusive: "65535" },
  GoIntegerPrimitive { target_name: "uint32", arithmetic: GoUnsignedModularMachineArithmetic,
    ordered_comparison: GoUnsignedIntegralComparisonWitness, carrier: GoWord32Carrier,
    overflow: GoUnsignedFixedWidthModularWrap,
    range_min_inclusive: "0", range_max_inclusive: "4294967295" },
  GoIntegerPrimitive { target_name: "uint64", arithmetic: GoUnsignedModularMachineArithmetic,
    ordered_comparison: GoUnsignedIntegralComparisonWitness, carrier: GoWord64Carrier,
    overflow: GoUnsignedFixedWidthModularWrap,
    range_min_inclusive: "0", range_max_inclusive: "18446744073709551615" },

  GoIntegerAliasPrimitive { target_name: "byte", canon_name: "uint8", arithmetic: GoUnsignedModularMachineArithmetic,
    ordered_comparison: GoUnsignedIntegralComparisonWitness,
    carrier: GoByteCarrier, overflow: GoUnsignedFixedWidthModularWrap,
    range_min_inclusive: "0", range_max_inclusive: "255" },
  GoIntegerAliasPrimitive { target_name: "rune", canon_name: "int32", arithmetic: GoSignedTwosComplementMachineArithmetic,
    ordered_comparison: GoSignedIntegralComparisonWitness,
    carrier: GoWord32Carrier, overflow: GoSignedFixedWidthTwoComplementWrap,
    range_min_inclusive: "-2147483648", range_max_inclusive: "2147483647" },

  GoFloatPrimitive { target_name: "float32", algebra: GoApproximateField32Algebra,
    carrier: GoFloat32BitsCarrier },
  GoFloatPrimitive { target_name: "float64", algebra: GoApproximateField64Algebra,
    carrier: GoFloat64BitsCarrier },

  GoComplexPrimitive { target_name: "complex64", component_width: GoComplex64Components },
  GoComplexPrimitive { target_name: "complex128", component_width: GoComplex128Components },

  GoBooleanPrimitive { target_name: "bool", algebra: GoCanonicalTwoElementBooleanAlgebra,
    carrier: GoBitCarrier },

  GoStringPrimitive { target_name: "string", algebra: GoImmutableByteSequenceMonoidAlgebra,
    carrier: GoImmutableByteSequenceCarrier }
]

// DAG Unit → Go: `struct{}` is the target spelling for DagName `Unit` in
// `go/types.dag`; it is not a predeclared identifier, so it must not share the
// `go_spec_predeclared_primitives` table with spec-predeclared types.
data go_dag_unit_target_primitive: GoPrimitive = GoUnitPrimitive {
  target_name: "struct{}",
  algebra: GoTerminalAlgebra,
  carrier: GoTerminalCarrier
}
