// extdeps/languages/go/primitives.dag — Structural target-primitive declarations
// for the Go target (T-Ground-Go / spec authority).
//
// TRANCHE 1 (this file): Go spec predeclared types with fixed machine
// representations — booleans, fixed-width integers, floats, complex, string,
// empty struct, and the byte/rune aliases (go.dev/ref/spec §Types).
// Implementation-sized int, uint, and uintptr are intentionally omitted from the
// data table until a GOARCH-tagged width story closes under DB-11 / cardinality
// substrate (same “no lying about width” discipline as the Rust pilot’s u64
// note; uintptr is pointer-sized per spec, not a fixed u64).
//
// TWO-AUTHORITY DISCIPLINE (ROADMAP §Post-R1 Grounding lanes):
//   (a) THIS FILE — Go language specification (go.dev/ref/spec).
//   (b) stdlib carriers and product-specific rows (e.g. []byte for Bytes,
//       interface{} for Json) stay in go/types.dag + emit tables until a
//       dedicated stdlib-authority slice lands; do not cite stdlib paths here.
//
// CONSUMER BOUNDARY: same Path-2 honest state as rust/primitives.dag — the
// top-level `go_spec_predeclared_primitives` list lowers as ValueBody::Unparsed
// until R2 T-Substrate’s top-level aggregate sub-lane lands; type-structure
// (GoPrimitive = …) is walkable for Engine / future loaders.
//
// LESSON 5 (grounding-pilot-receipt.md): subset-only axes are structurally
// partitioned — integer overflow lives only on integer variants; float width
// only on GoFloatPrimitive; complex component width only on GoComplexPrimitive;
// alias linkage only on GoIntegerAliasPrimitive (byte/rune); bool/string/unit
// share `GoDiscreteScalarPrimitive` with a coproduct `GoDiscreteScalarKind`
// so each arm pairs exactly one algebra tag with its carrier (no cross-wire
// product of broad sums).
//
// SUBSTRATE-GAP FLAGS: `overflow` on integer variants / terminal / text carriers
// follow the Rust pilot’s *placement* (per-variant bridge tags). `GoIntegerOverflow`
// carries two **Go-spec-grounded** witnesses (signed vs unsigned presentation of
// fixed-width overflow; go.dev/ref/spec §Overflow) — not Rust’s saturating/trap
// operator families (see `GoIntegerOverflow` header). Post-DB-11 these become
// refinements on carriers / algebras.

module extdeps.languages.go.primitives

// =========================================================================
// Practice 4 — Coproduct dissolution checkpoint
// (`docs/modeling-discipline.md` Practice 4). Every N≥2 sum in this module is classified.
// Dissolution patterns 1–4 were considered in parallel with
// `rust/primitives.dag` (same pilot lane): bridge tags are not dissolvable until
// the substrate carries first-class algebra/bit type identities as data.
//
// | Coproduct                 | Class | Ledger (GREEN) or named trigger (YELLOW) |
// |---------------------------|-------|---------------------------------------------|
// | GoIntegerAlgebra          | 🟡 YELLOW | Pattern 3 partial: tags bridge `std.algebra` witnesses; dissolve when **T-Ground-Engine** + **DB-11** close substrate-gap #2 analog (see rust `IntegerAlgebra` header). |
// | GoFloatAlgebra            | 🟡 YELLOW | Same — width tags bridge approximate-field algebras; trigger **R2 T-Substrate** / **DB-11** when float witness can reference `std` inhabitants directly. |
// | GoTargetCarrier           | 🟡 YELLOW | Tags bridge `std.bit` (+ terminal / UTF-8 text witnesses); trigger **DB-11** / cardinality lane when carriers collapse to typed `std.bit` refs. |
// | GoComplexComponentWidth   | 🟢 GREEN | **Ledger:** Pattern 2 rejected (64 vs 128 components are not label-only); patterns 1/3/4 N/A. Variants are the two irreducible spec widths for `complex64` / `complex128` (go.dev/ref/spec); no richer internal source to extract. |
// | GoDiscreteScalarKind      | 🟢 GREEN | **Ledger:** Pattern 1 rejected (bool/string/unit route through disjoint spec classes); pattern 2 rejected (payload shapes differ); pattern 3 partial (each arm’s algebra already names its std-facing role). Coproduct exists to **forbid** illegal algebra×carrier cross-wiring — dissolution would re-open the product bug; terminal as authored spec partition + paired witnesses. |
// | GoPrimitive               | 🟢 GREEN | **Ledger:** Mirrors `RustPrimitive` pilot partition (Lesson 5). Variants are heterogeneous spec classes (int vs float vs …); not a compressible enum of same-shaped labels. External authority: Go spec predeclared / fixed-width tranche-1 set. |
// | GoIntegerOverflow         | 🟢 GREEN | **Ledger:** Two arms = spec’s two overflow presentations for fixed-width numerics (signed non-constant two’s-complement wrap vs unsigned modular reduction; go.dev/ref/spec §Overflow). Multi-arm avoids the single-alias `type X = Tag` resolution gap called out for `GoFloatAlgebra` above — without inventing ungrounded Rust-shaped saturating/trap variants (INVARIANTS P1). |
// =========================================================================

// --- Algebra tags (Go-prefixed names; avoid colliding with rust/primitives.dag
// in the shared bootstrap Dag). ---

type GoIntegerAlgebra
  = GoOrderedRingAlgebra
  | GoSemiringAlgebra

// Float algebra tags must be introduced in a multi-arm sum (same rule as
// rust/primitives.dag: a single-arm `type X = Tag` leaves `Tag` unresolved).
// Width-split tags keep float32 vs float64 structurally honest.
type GoFloatAlgebra
  = GoApproximateField32Algebra
  | GoApproximateField64Algebra

// --- Target carrier tags (value-domain witnesses; not ABI / GC shape). ---

type GoTargetCarrier
  = GoBitCarrier
  | GoByteCarrier
  | GoWord16Carrier
  | GoWord32Carrier
  | GoWord64Carrier
  | GoTerminalCarrier
  | GoUtf8TextCarrier


// Go spec fixed-width numerics (this tranche): `GoIntegerOverflow` is a **two-arm**
// sum so constructor tags resolve under the same rule as `GoFloatAlgebra` (see
// header at `GoFloatAlgebra` — a single-arm `type X = Tag` can leave `Tag`
// unresolved in the loader). Arms are **Go-authority-only**: signed types use the
// spec’s two’s-complement wrap presentation for non-constant overflow; unsigned
// types use modular reduction (go.dev/ref/spec §Overflow). Rust’s `IntegerOverflow`
// adds Saturating/Trap because the Rust Reference names those **operator**
// families; Go does not model those as inhabitants of the same predeclared
// `int8`…`uint64` names — do not copy that three-way sum here (INVARIANTS P1).
type GoIntegerOverflow
  = GoSignedFixedWidthTwoComplementWrap
  | GoUnsignedFixedWidthModularWrap


type GoComplexComponentWidth
  = GoComplex64Components
  | GoComplex128Components


// Bool, UTF-8 string, and empty struct — each arm fixes a legal (algebra,
// carrier) pair so bool cannot carry `GoUtf8TextCarrier`, etc. (illegal states
// unrepresentable). Algebra tags are introduced only inside these arms.
type GoDiscreteScalarKind
  = GoBoolScalar {
      algebra: GoCanonicalTwoElementBooleanAlgebra
      carrier: GoBitCarrier
    }
  | GoStringScalar {
      algebra: GoUtf8FreeMonoidAlgebra
      carrier: GoUtf8TextCarrier
    }
  | GoUnitScalar {
      algebra: GoTerminalAlgebra
      carrier: GoTerminalCarrier
    }


// --- Sum-typed Go spec primitive (Lesson 5 partition). ---

type GoPrimitive
  = GoIntegerPrimitive {
      target_name: String
      algebra: GoIntegerAlgebra
      carrier: GoTargetCarrier
      // scaffold: R2 top-level aggregate `ValueBody` sub-lane makes
      // `go_spec_predeclared_primitives` rows structurally walkable; until then,
      // consumers read the duplicated `GoIntegerRangeFact` rows below.
      range_min_inclusive: String
      range_max_inclusive: String
      overflow: GoIntegerOverflow
    }
  | GoIntegerAliasPrimitive {
      target_name: String
      canon_name: String
      algebra: GoIntegerAlgebra
      carrier: GoTargetCarrier
      // Same scaffold as `GoIntegerPrimitive` (see `GoIntegerRangeFact`).
      range_min_inclusive: String
      range_max_inclusive: String
      overflow: GoIntegerOverflow
    }
  | GoFloatPrimitive {
      target_name: String
      // Width is single-sourced on `algebra` (`GoApproximateField32Algebra` ↔
      // float32, `GoApproximateField64Algebra` ↔ float64). No separate float
      // bits-carrier tags live in this module (grep would not find them); a
      // second parallel field would only re-open algebra/carrier cross-wire
      // states (INVARIANTS / illegal states). When T-Ground-Engine consumes
      // this file, map each algebra tag to the appropriate std/bit witness.
      algebra: GoFloatAlgebra
    }
  | GoComplexPrimitive {
      target_name: String
      component_width: GoComplexComponentWidth
    }
  | GoDiscreteScalarPrimitive {
      target_name: String
      kind: GoDiscreteScalarKind
    }


// Structurally walkable integer range facts (mirrors rust `IntegerRangeFact`).
// `go_spec_predeclared_primitives` remains a top-level list/sum body and therefore
// lowers as `ValueBody::Unparsed` until the R2 top-level aggregate sub-lane
// lands. These record data declarations expose the same integer range facts
// through today's structural `ValueBody::Structural` path so consumers do
// not mirror bounds out-of-band. The list rows repeat algebra/carrier/range
// for readable authoring of the full `GoPrimitive` sum; post-R2 walkability,
// derive one shape from the other if the substrate supports it (exploratory;
// same tradeoff as rust/primitives.dag).
type GoIntegerRangeFact {
  target_name: String
  algebra: GoIntegerAlgebra
  carrier: GoTargetCarrier
  range_min_inclusive: String
  range_max_inclusive: String
}

data go_int8_integer_range: GoIntegerRangeFact = {
  target_name: "int8",
  algebra: GoOrderedRingAlgebra,
  carrier: GoByteCarrier,
  range_min_inclusive: "-128",
  range_max_inclusive: "127"
}

data go_int16_integer_range: GoIntegerRangeFact = {
  target_name: "int16",
  algebra: GoOrderedRingAlgebra,
  carrier: GoWord16Carrier,
  range_min_inclusive: "-32768",
  range_max_inclusive: "32767"
}

data go_int32_integer_range: GoIntegerRangeFact = {
  target_name: "int32",
  algebra: GoOrderedRingAlgebra,
  carrier: GoWord32Carrier,
  range_min_inclusive: "-2147483648",
  range_max_inclusive: "2147483647"
}

data go_int64_integer_range: GoIntegerRangeFact = {
  target_name: "int64",
  algebra: GoOrderedRingAlgebra,
  carrier: GoWord64Carrier,
  range_min_inclusive: "-9223372036854775808",
  range_max_inclusive: "9223372036854775807"
}

data go_uint8_integer_range: GoIntegerRangeFact = {
  target_name: "uint8",
  algebra: GoSemiringAlgebra,
  carrier: GoByteCarrier,
  range_min_inclusive: "0",
  range_max_inclusive: "255"
}

data go_uint16_integer_range: GoIntegerRangeFact = {
  target_name: "uint16",
  algebra: GoSemiringAlgebra,
  carrier: GoWord16Carrier,
  range_min_inclusive: "0",
  range_max_inclusive: "65535"
}

data go_uint32_integer_range: GoIntegerRangeFact = {
  target_name: "uint32",
  algebra: GoSemiringAlgebra,
  carrier: GoWord32Carrier,
  range_min_inclusive: "0",
  range_max_inclusive: "4294967295"
}

data go_uint64_integer_range: GoIntegerRangeFact = {
  target_name: "uint64",
  algebra: GoSemiringAlgebra,
  carrier: GoWord64Carrier,
  range_min_inclusive: "0",
  range_max_inclusive: "18446744073709551615"
}

// Hand-edit invariant (until R2 makes one side derivable): every
// `GoIntegerPrimitive` / `GoIntegerAliasPrimitive` in `go_spec_predeclared_primitives`
// must keep algebra, carrier, range_min_inclusive, range_max_inclusive lockstep
// with the matching `go_*_integer_range` row above (byte→uint8, rune→int32).
// Cheap future insurance: an extdeps loader or unit test that pairs rows by
// target_name and asserts equality on those four fields — ideally as soon as
// `go_spec_predeclared_primitives` is structurally walkable (R2 aggregate lane),
// before additional targets copy this two-shape pattern and drift risk scales.


// Predeclared fixed-width numerics + aliases + floats + complex + bool + string
// + empty struct (struct{}). Order: signed ints, unsigned ints, aliases,
// floats, complex, bool, string, unit.
data go_spec_predeclared_primitives: List<GoPrimitive> = [
  GoIntegerPrimitive { target_name: "int8", algebra: GoOrderedRingAlgebra, carrier: GoByteCarrier,
    range_min_inclusive: "-128", range_max_inclusive: "127", overflow: GoSignedFixedWidthTwoComplementWrap },
  GoIntegerPrimitive { target_name: "int16", algebra: GoOrderedRingAlgebra, carrier: GoWord16Carrier,
    range_min_inclusive: "-32768", range_max_inclusive: "32767", overflow: GoSignedFixedWidthTwoComplementWrap },
  GoIntegerPrimitive { target_name: "int32", algebra: GoOrderedRingAlgebra, carrier: GoWord32Carrier,
    range_min_inclusive: "-2147483648", range_max_inclusive: "2147483647", overflow: GoSignedFixedWidthTwoComplementWrap },
  GoIntegerPrimitive { target_name: "int64", algebra: GoOrderedRingAlgebra, carrier: GoWord64Carrier,
    range_min_inclusive: "-9223372036854775808", range_max_inclusive: "9223372036854775807",
    overflow: GoSignedFixedWidthTwoComplementWrap },

  GoIntegerPrimitive { target_name: "uint8", algebra: GoSemiringAlgebra, carrier: GoByteCarrier,
    range_min_inclusive: "0", range_max_inclusive: "255", overflow: GoUnsignedFixedWidthModularWrap },
  GoIntegerPrimitive { target_name: "uint16", algebra: GoSemiringAlgebra, carrier: GoWord16Carrier,
    range_min_inclusive: "0", range_max_inclusive: "65535", overflow: GoUnsignedFixedWidthModularWrap },
  GoIntegerPrimitive { target_name: "uint32", algebra: GoSemiringAlgebra, carrier: GoWord32Carrier,
    range_min_inclusive: "0", range_max_inclusive: "4294967295", overflow: GoUnsignedFixedWidthModularWrap },
  GoIntegerPrimitive { target_name: "uint64", algebra: GoSemiringAlgebra, carrier: GoWord64Carrier,
    range_min_inclusive: "0", range_max_inclusive: "18446744073709551615", overflow: GoUnsignedFixedWidthModularWrap },

  GoIntegerAliasPrimitive { target_name: "byte", canon_name: "uint8", algebra: GoSemiringAlgebra,
    carrier: GoByteCarrier, range_min_inclusive: "0", range_max_inclusive: "255",
    overflow: GoUnsignedFixedWidthModularWrap },
  GoIntegerAliasPrimitive { target_name: "rune", canon_name: "int32", algebra: GoOrderedRingAlgebra,
    carrier: GoWord32Carrier, range_min_inclusive: "-2147483648", range_max_inclusive: "2147483647",
    overflow: GoSignedFixedWidthTwoComplementWrap },

  GoFloatPrimitive { target_name: "float32", algebra: GoApproximateField32Algebra },
  GoFloatPrimitive { target_name: "float64", algebra: GoApproximateField64Algebra },

  GoComplexPrimitive { target_name: "complex64", component_width: GoComplex64Components },
  GoComplexPrimitive { target_name: "complex128", component_width: GoComplex128Components },

  GoDiscreteScalarPrimitive { target_name: "bool",
    kind: GoBoolScalar { algebra: GoCanonicalTwoElementBooleanAlgebra, carrier: GoBitCarrier } },

  GoDiscreteScalarPrimitive { target_name: "string",
    kind: GoStringScalar { algebra: GoUtf8FreeMonoidAlgebra, carrier: GoUtf8TextCarrier } },

  GoDiscreteScalarPrimitive { target_name: "struct{}",
    kind: GoUnitScalar { algebra: GoTerminalAlgebra, carrier: GoTerminalCarrier } }
]
