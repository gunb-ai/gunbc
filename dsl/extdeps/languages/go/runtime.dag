// extdeps/languages/go/runtime.dag -- "How does Go operate on values at runtime?"
//
// String operations (strings/fmt packages), collection operations
// (builtin functions), map operations, and null handling.
//
// Ref: Go Standard Library (pkg.go.dev/std)
//
// Consumers:
//   v2/05_emit_go.dag -- method call emission, pipe operator translation

module extdeps.languages.go.runtime

import std.languages {
  NamingConvention, NamingCase
}

// -- String operations -----------------------------------------------
// Ref: pkg.go.dev/strings, pkg.go.dev/fmt

// Go has no string interpolation; uses fmt.Sprintf.
// Ref: pkg.go.dev/fmt
data format_func: String = "fmt.Sprintf(\"\{fmt\}\", \{args\})"
data format_placeholder: String = "%v"
data format_string_placeholder: String = "%s"
data format_int_placeholder: String = "%d"

// Ref: pkg.go.dev/strings#Split
data string_split_template: String = "strings.Split(\{recv\}, \{delim\})"

// Ref: pkg.go.dev/strings#Join
data string_join_template: String = "strings.Join(\{recv\}, \{sep\})"

// Ref: pkg.go.dev/strings#Contains
data string_contains_template: String = "strings.Contains(\{recv\}, \{substr\})"

// Ref: pkg.go.dev/strings#Split -- splitting into characters
data string_chars_template: String = "strings.Split(\{recv\}, \"\")"

// Go strings are UTF-8 byte sequences; indexing yields bytes, not chars.
// Ref: Go Spec "Index expressions"
data string_index_template: String = "string(\{recv\}[\{index\}])"

// Ref: Go Spec "Slice expressions"
data string_slice_template: String = "\{recv\}[\{start\}:\{end\}]"

// -- Collection operations -------------------------------------------
// Ref: Go Spec "Built-in functions"

// `MethodTranslation` + `collection_method_translations` retired in
// T-Ground-LanguageSpec scope E Phase 2 (#1196 follow-up): zero v2
// consumers, zero stage0 references, fully dead. The per-target flat
// method-template authority is `go_simple_method_specs` in `emit.dag`
// (read by the emitter); migrating it onto the registry-backed
// `MethodTemplateContract` rows (`dsl/std/emit_model.dag`) is the open
// #1133 follow-on.

// Ref: Go Spec "Appending to and copying slices"
data append_template: String = "append(\{slice\}, \{values\}...)"
data make_slice_template: String = "make(\{type\}, \{len\})"
data make_map_template: String = "make(\{type\})"

// Ref: Go Spec "Length and capacity"
data len_func: String = "len(\{collection\})"
data cap_func: String = "cap(\{collection\})"

// -- Map operations --------------------------------------------------
// Ref: Go Spec "Map types", "Index expressions", "Deletion of map elements"

data map_get_template: String = "\{map\}[\{key\}]"
data map_get_ok_template: String = "\{val\}, \{ok\} := \{map\}[\{key\}]"
data map_set_template: String = "\{map\}[\{key\}] = \{value\}"
data map_delete_template: String = "delete(\{map\}, \{key\})"

// -- Null handling ---------------------------------------------------
// Ref: Go Spec "The zero value"
//
// Go has no null-coalesce operator. Nil checks use if statements.

data nil_check_template: String = "if \{expr\} != nil \{\n\t\{body\}\n\}"

// -- Prelude imports -------------------------------------------------
// Standard imports emitted at the top of generated Go files.

data prelude_imports: List<String> = [
  "\"fmt\"",
  "\"strings\"",
  "\"encoding/json\""
]

// -- Serialization ---------------------------------------------------
// Ref: pkg.go.dev/encoding/json

data json_marshal_template: String = "json.Marshal(\{value\})"
data json_unmarshal_template: String = "json.Unmarshal(\{data\}, &\{target\})"
data json_raw_type: String = "json.RawMessage"
data struct_tag_json_template: String = "`json:\"\{name\}\"`"
data struct_tag_json_omitempty: String = "`json:\"\{name\},omitempty\"`"
