// extdeps/languages/go/lint.dag -- "What imports does Go usage require?"
//
// Import derivation rules: maps type/container usage to the
// corresponding Go import paths the emitter must produce.
//
// Ref: Go standard library (pkg.go.dev/std)
//
// Consumers:
//   v2/05_emit_go.dag -- import collection pass

module extdeps.languages.go.lint

import std.languages {
  ImportRule, ImportTrigger,
  TypeUsageTrigger, ContainerUsageTrigger, AsyncUsageTrigger
}

data go_import_rules: List<ImportRule> = [
  { trigger: TypeUsageTrigger { type_name: "fmt" }, import_path: "\"fmt\"" },
  { trigger: TypeUsageTrigger { type_name: "json" }, import_path: "\"encoding/json\"" },
  { trigger: ContainerUsageTrigger { container: "sync" }, import_path: "\"sync\"" },
  { trigger: ContainerUsageTrigger { container: "http" }, import_path: "\"net/http\"" },
  { trigger: AsyncUsageTrigger, import_path: "\"sync\"" }
]
