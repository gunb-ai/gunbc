// extdeps/languages/go/imports.dag -- "How does the Go module system work?"
//
// Package declarations, import syntax, module paths, and visibility
// as specified in the Go Language Specification and Go Modules Reference.
//
// Ref: Go Spec "Packages" (go.dev/ref/spec#Packages)
//      Go Modules Reference (go.dev/ref/mod)
//
// Consumers:
//   v2/05_emit_go.dag -- import emission, package declaration, file layout

module extdeps.languages.go.imports

// -- Package declaration ---------------------------------------------
// Ref: Go Spec "Package clause"
//
// Every Go source file begins with a package clause. The package name
// is the last element of the import path, by convention.

data package_clause_template: String = "package \{name\}"
data main_package: String = "package main"

// -- Import syntax ---------------------------------------------------
// Ref: Go Spec "Import declarations"

data import_single_template: String = "import \"\{path\}\""
data import_group_template: String = "import (\n\{imports\}\n)"
data import_alias_template: String = "\{alias\} \"\{path\}\""

// -- Module system ---------------------------------------------------
// Ref: Go Modules Reference "go.mod file"

data go_mod_template: String = "module \{module\}\n\ngo \{version\}\n"
data go_mod_require_template: String = "require \{path\} \{version\}"
data minimum_go_version: String = "1.21"

// -- File layout -----------------------------------------------------
// Ref: Go convention: one package per directory

data file_extension: String = ".go"
data test_file_suffix: String = "_test.go"

// -- Standard library packages ---------------------------------------
// Ref: pkg.go.dev/std
//
// Packages commonly needed by generated code.

data stdlib_strings: String = "strings"
data stdlib_fmt: String = "fmt"
data stdlib_json: String = "encoding/json"
data stdlib_context: String = "context"
data stdlib_http: String = "net/http"
data stdlib_errors: String = "errors"
data stdlib_sync: String = "sync"
data stdlib_time: String = "time"
data stdlib_io: String = "io"
data stdlib_bytes: String = "bytes"
