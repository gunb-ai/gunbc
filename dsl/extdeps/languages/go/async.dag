// extdeps/languages/go/async.dag -- "How does Go handle concurrent execution?"
//
// Goroutines, channels, select, synchronization primitives, and the
// context package as specified in the Go Language Specification.
//
// Ref: Go Spec "Go statements" (go.dev/ref/spec#Go_statements)
//      Go Spec "Channel types" (go.dev/ref/spec#Channel_types)
//      Go Spec "Select statements" (go.dev/ref/spec#Select_statements)
//      pkg.go.dev/context
//
// Consumers:
//   v2/05_emit_go.dag -- concurrent service calls, context propagation

module extdeps.languages.go.async

// -- Goroutines ------------------------------------------------------
// Ref: Go Spec "Go statements"
//
// A goroutine is a lightweight thread managed by the Go runtime.

data go_statement_template: String = "go \{call\}"
data goroutine_func_template: String = "go func() \{\n\t\{body\}\n\}()"

// -- Channels --------------------------------------------------------
// Ref: Go Spec "Channel types"
//
// Channels are typed conduits for goroutine communication.

data chan_type_template: String = "chan \{type\}"
data send_chan_template: String = "chan<- \{type\}"
data recv_chan_template: String = "<-chan \{type\}"
data make_chan_template: String = "make(chan \{type\})"
data make_buffered_chan_template: String = "make(chan \{type\}, \{size\})"
data chan_send_template: String = "\{chan\} <- \{value\}"
data chan_recv_template: String = "<-\{chan\}"

// -- Select ----------------------------------------------------------
// Ref: Go Spec "Select statements"

data select_template: String = "select \{\n\{cases\}\n\}"
data select_case_template: String = "case \{assignment\}:\n\t\{body\}"
data select_default_template: String = "default:\n\t\{body\}"

// -- Synchronization -------------------------------------------------
// Ref: pkg.go.dev/sync

data mutex_type: String = "sync.Mutex"
data rwmutex_type: String = "sync.RWMutex"
data waitgroup_type: String = "sync.WaitGroup"
data once_type: String = "sync.Once"
data mutex_lock_template: String = "\{mu\}.Lock()"
data mutex_unlock_template: String = "\{mu\}.Unlock()"
data defer_unlock_template: String = "defer \{mu\}.Unlock()"
data waitgroup_add_template: String = "\{wg\}.Add(\{n\})"
data waitgroup_done_template: String = "\{wg\}.Done()"
data waitgroup_wait_template: String = "\{wg\}.Wait()"

// -- Context ---------------------------------------------------------
// Ref: pkg.go.dev/context
//
// context.Context carries deadlines, cancellation signals, and
// request-scoped values across API boundaries and goroutines.

data context_type: String = "context.Context"
data context_background: String = "context.Background()"
data context_todo: String = "context.TODO()"
data context_with_cancel_template: String = "context.WithCancel(\{parent\})"
data context_with_timeout_template: String = "context.WithTimeout(\{parent\}, \{duration\})"

// -- HTTP client -----------------------------------------------------
// Ref: pkg.go.dev/net/http
//
// Go's standard library HTTP client is used for service calls.

data http_client_type: String = "*http.Client"
data http_do_template: String = "\{client\}.Do(\{req\})"
data http_new_request_template: String = "http.NewRequestWithContext(\{ctx\}, \"\{method\}\", \{url\}, \{body\})"
