// extdeps/languages/go/types.dag -- "What is the Go type system?"
//
// Value types, pointer types, zero values, interfaces, and struct
// embedding as specified in the Go Language Specification.
//
// Ref: The Go Programming Language Specification (go.dev/ref/spec)
//      Effective Go (go.dev/doc/effective_go)
//
// Consumers:
//   v2/05_emit_go.dag -- type emission, struct definition, interface satisfaction

module extdeps.languages.go.types

import std.languages {
  TypeMapping, NamingConvention, NamingCase,
  TypeDefinitionSyntax
}

// -- Zero values -----------------------------------------------------
// Ref: Go Spec "The zero value"
//
// Every Go variable is initialized to its zero value when declared
// without an explicit initializer. There is no "uninitialized" state.

type GoZeroValue {
  dag_name: String                     // DAG abstract name
  go_name: String                      // Go concrete type
  zero_value: String                   // Zero value expression
}

data go_primitives: List<GoZeroValue> = [
  { dag_name: "Int",    go_name: "int64",       zero_value: "0" },
  { dag_name: "Float",  go_name: "float64",     zero_value: "0.0" },
  { dag_name: "Bool",   go_name: "bool",        zero_value: "false" },
  { dag_name: "Unit",   go_name: "struct{}",    zero_value: "struct{}{}" },
  { dag_name: "String", go_name: "string",      zero_value: "\"\"" },
  { dag_name: "Bytes",  go_name: "[]byte",      zero_value: "nil" },
  { dag_name: "Secret", go_name: "string",      zero_value: "\"\"" },
  { dag_name: "Json",   go_name: "interface{}", zero_value: "nil" }
]

// -- Pointer types ---------------------------------------------------
// Ref: Go Spec "Pointer types"
//
// Go uses pointer types (*T) for optional values and to avoid copying
// large structs. A nil pointer represents an absent value.

data pointer_template: String = "*{0}"
data address_of_template: String = "&\{value\}"
data nil_literal: String = "nil"

// -- Visibility ------------------------------------------------------
// Ref: Go Spec "Exported identifiers"
//
// An identifier is exported if its first character is uppercase (Unicode
// category Lu). No visibility keyword exists.

data visibility_by_case: Bool = true

// -- Struct embedding ------------------------------------------------
// Ref: Go Spec "Struct types" -- embedded fields
//
// Go has no inheritance. A struct may embed another type by declaring a
// field with no explicit name; the embedded type's methods and fields
// are promoted.

data embedded_field_syntax: String = "\{type\}"

// -- Interface types -------------------------------------------------
// Ref: Go Spec "Interface types"
//
// An interface defines a method set. A type satisfies an interface
// implicitly -- no "implements" declaration.

data empty_interface: String = "interface{}"
data any_type: String = "any"          // Go 1.18+ alias for interface{}
data interface_def_template: String = "type \{name\} interface \{\n\{methods\}\n\}"

// -- Numeric types ---------------------------------------------------
// Ref: Go Spec "Numeric types"

data integer_types: List<String> = [
  "int", "int8", "int16", "int32", "int64",
  "uint", "uint8", "uint16", "uint32", "uint64", "uintptr"
]

data float_types: List<String> = ["float32", "float64"]

// -- Type conversions ------------------------------------------------
// Ref: Go Spec "Conversions"
//
// Go has no implicit type conversions. All conversions are explicit
// with function-call syntax: Type(expr).

data type_conversion_template: String = "\{type\}(\{expr\})"

// -- Emission-facing maps --------------------------------------------
// These provide the Map<String, String> format that the v2 emitter
// consumes. Derived from the facts above and from the Go Spec.
// When the language gains map-from-list primitives, these become computed.

// DAG primitive name -> Go type name.
// Derived from: go_primitives[].dag_name -> go_primitives[].go_name
data emit_type_map: Map<String, String> = {
  "String": "string", "Int": "int64", "Float": "float64", "Bool": "bool",
  "Bytes": "[]byte", "Unit": "struct{}", "Secret": "string", "Json": "interface{}"
}

// Literal and operator keyword translations.
// Ref: Go Spec "Keywords", "Operators and punctuation"
data emit_keywords: Map<String, String> = {
  "true": "true", "false": "false", "null": "nil",
  "and": "&&", "or": "||", "not": "!",
  "div": "/"
}

// Container type templates. {0} = element type, {1} = second type (maps).
// Ref: Go Spec "Slice types", "Map types"
data emit_container_templates: Map<String, String> = {
  "list": "[]{0}", "set": "map[{0}]struct{}",
  "optional": "*{0}", "map": "map[{0}]{1}"
}
