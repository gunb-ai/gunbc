// extdeps/languages/go/types.dag -- Go coercion data.
//
// Declares which Go types inhabit which .dag algebraic structures.
// Go has garbage collection (like Python) but uses pointer types for
// optional values (like Rust uses Option<T>).
//
// FAIL-CLOSED CONTRACT: Missing inhabitant = compile error.
//
// SCHEMA: Type definitions live in std/coercion.dag (shared authority).
// This file instantiates data only — no local type families.
//
// Ref: The Go Programming Language Specification (go.dev/ref/spec)
//      Effective Go (go.dev/doc/effective_go)
//      std/algebra.dag, std/coercion.dag
//
// Consumers:
//   v2/05_emit_go.dag -- coercion engine reads inhabitants

module extdeps.languages.go.types

import std.cast_rules {
  TypeCheckpoint, InhabitantDecl, CallableRepr, CastSyntax
}


// =========================================================================
// Type checkpoints
//
// Go has value types (int64, bool, float64) and reference types (slices,
// maps, channels). is_copy is none — Go has no Copy trait; the value vs
// reference distinction is structural and handled by the emitter via
// ValueContext, not by a declared flag.
// =========================================================================

data go_type_checkpoints: List<TypeCheckpoint> = [
  { dag_name: "Int",    target_type: "int64",       default_expr: "0",          is_copy: none, literal_suffix: none },
  { dag_name: "Float",  target_type: "float64",     default_expr: "0.0",        is_copy: none, literal_suffix: none },
  { dag_name: "Bool",   target_type: "bool",        default_expr: "false",      is_copy: none, literal_suffix: none },
  { dag_name: "Unit",   target_type: "struct{}",    default_expr: "struct{}{}", is_copy: none, literal_suffix: none },
  { dag_name: "String", target_type: "string",      default_expr: "\"\"",       is_copy: none, literal_suffix: none },
  { dag_name: "Bytes",  target_type: "[]byte",      default_expr: "nil",        is_copy: none, literal_suffix: none },
  { dag_name: "Secret", target_type: "string",      default_expr: "\"\"",       is_copy: none, literal_suffix: none },
  { dag_name: "Json",   target_type: "interface{}", default_expr: "nil",        is_copy: none, literal_suffix: none }
]


// =========================================================================
// Algebra inhabitants
//
// CROSS-LANGUAGE COMPARISON:
//   FreeMonoid     → []T (Go) vs Vec<T> (Rust) vs list[T] (Python)
//   BooleanAlgebra → map[A]struct{} (Go) vs BTreeSet<A> (Rust) vs set[A] (Python)
//   PartialFunction→ map[K]V (Go) vs HashMap<K,V> (Rust) vs dict[K,V] (Python)
//
// Go has no native set type. map[T]struct{} is idiomatic: isomorphic to
// A → Bool (the set-theoretic definition).
// =========================================================================

data go_algebra_inhabitants: List<InhabitantDecl> = [
  // FreeMonoid<T> → []T (Go slice)
  { algebra: "FreeMonoid",
    template: "[]\{0\}",
    arity: 1,
    identity_expr: "nil",
    import_path: none,
    is_copy: none },

  // BooleanAlgebra<A> → map[A]struct{}
  { algebra: "BooleanAlgebra",
    template: "map[\{0\}]struct{}",
    arity: 1,
    identity_expr: "nil",
    import_path: none,
    is_copy: none },

  // PartialFunction<K,V> → map[K]V
  { algebra: "PartialFunction",
    template: "map[\{0\}]\{1\}",
    arity: 2,
    identity_expr: "nil",
    import_path: none,
    is_copy: none },

  // OrderedRing → int64
  { algebra: "OrderedRing",
    template: "int64",
    arity: 0,
    identity_expr: "0",
    import_path: none,
    is_copy: none },

  // ApproximateField → float64
  { algebra: "ApproximateField",
    template: "float64",
    arity: 0,
    identity_expr: "0.0",
    import_path: none,
    is_copy: none }
]


// =========================================================================
// Optional: *T (pointer, nil = absent)
//
// Authority: pointer_template and nil_literal below. No separate optional
// declarations — Go optional IS pointer indirection.
// =========================================================================


// =========================================================================
// Callable: func(T) U
//
// Go functions are first-class. No owned/shared/static distinction —
// all callable types are `func`. Simpler than Rust's fn/Fn/FnMut/FnOnce.
// =========================================================================

data go_callable: CallableRepr = CallableRepr {
  template: "func(\{params\}) \{return\}",
  param_separator: ", ",
  return_separator: " ",
  import_path: none
}


// =========================================================================
// Sharing
//
// Go has GC but value semantics for structs. The value-vs-reference
// distinction (large structs → *T, slices/maps/channels → identity) is
// derived from ValueContext at emit time, not from a declared config.
// Emission is translation, not decision-making.
// =========================================================================


// =========================================================================
// Retained Go type system facts
// =========================================================================

data pointer_template: String = "*\{0\}"
data go_optional_template: String = "*\{0\}"
data address_of_template: String = "&\{value\}"
data nil_literal: String = "nil"
data visibility_by_case: Bool = true
data embedded_field_syntax: String = "\{type\}"
data empty_interface: String = "interface{}"
data any_type: String = "any"
data interface_def_template: String = "type \{name\} interface \{\n\{methods\}\n\}"

data integer_types: List<String> = [
  "int", "int8", "int16", "int32", "int64",
  "uint", "uint8", "uint16", "uint32", "uint64", "uintptr"
]

data float_types: List<String> = ["float32", "float64"]

data type_conversion_template: String = "\{type\}(\{expr\})"

// Cast syntax: Go uses type conversion T(x). fail_open=true models Go's
// actual semantics: type conversions are syntactically valid for compatible
// types. The Go compiler validates type compatibility at build time.
// Go type conversions: T(x). All numeric conversions valid.
// Ref: Go Specification "Conversions"
data go_cast_syntax: CastSyntax = {
  template: "\{type\}(\{expr\})",
  cast_rules: [
    { from_type: "int64", to_type: "int64" },
    { from_type: "int64", to_type: "float64" },
    { from_type: "float64", to_type: "int64" },
    { from_type: "float64", to_type: "float64" },
    { from_type: "string", to_type: "[]byte" },
    { from_type: "[]byte", to_type: "string" }
  ]
}
