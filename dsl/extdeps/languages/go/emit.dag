// extdeps/languages/go/emit.dag -- Go language facts for the v2 emitter.
//
// Single source of truth for Go-specific data consumed by the emitter.
// No imports -- these are leaf data declarations.
//
// Ref: The Go Programming Language Specification (go.dev/ref/spec)
//      Go Standard Library (pkg.go.dev/std)
//
// Consumers:
//   v2/05_emit.dag -- type mapping, keywords, container templates

module extdeps.languages.go.emit

// -- Type mapping --------------------------------------------------------
// DAG abstract type -> Go concrete type.
// Ref: Go Spec, Types
data go_type_map: Map<String, String> = {
  "String": "string", "Int": "int64", "Float": "float64", "Bool": "bool",
  "Bytes": "[]byte", "Unit": "struct{}", "Secret": "string", "Json": "interface{}"
}

// -- Keyword/operator translation ----------------------------------------
// DAG keywords/operators -> Go syntax.
// Ref: Go Spec, Operators and punctuation
data go_keywords: Map<String, String> = {
  "true": "true", "false": "false", "null": "nil",
  "and": "&&", "or": "||", "not": "!",
  "div": "/"
}

// -- Container type templates --------------------------------------------
// {0} = element type, {1} = second type (maps).
// Ref: Go Spec, Composite literals
data go_container_templates: Map<String, String> = {
  "list": "[]\{0\}", "set": "map[\{0\}]struct{}",
  "non_empty_list": "[]\{0\}", "non_empty_set": "map[\{0\}]struct{}",
  "optional": "*\{0\}", "map": "map[\{0\}]\{1\}",
  "free_monoid": "[]\{0\}", "partial_function": "map[\{0\}]\{1\}",
  "boolean_algebra": "bool"
}

// -- Reserved words ------------------------------------------------------
// Ref: Go Spec "Keywords" + predeclared identifiers
data go_reserved: List<String> = [
  "break", "case", "chan", "const", "continue",
  "default", "defer", "else", "fallthrough", "for",
  "func", "go", "goto", "if", "import",
  "interface", "map", "package", "range", "return",
  "select", "struct", "switch", "type", "var",
  "bool", "byte", "complex64", "complex128", "error",
  "float32", "float64", "int", "int8", "int16", "int32", "int64",
  "rune", "string", "uint", "uint8", "uint16", "uint32", "uint64",
  "uintptr", "true", "false", "iota", "nil",
  "append", "cap", "close", "complex", "copy", "delete",
  "imag", "len", "make", "new", "panic", "print", "println",
  "real", "recover"
]

// -- Reserved word escape ------------------------------------------------
// Ref: Go Spec -- Go uses no raw identifier escape; underscore suffix by convention.
// Mirrors go_reserved_words.strategy from std.languages (NoEscape, but
// the emitter appends "_" for keywords that clash with identifiers).
data go_reserved_escape_suffix: String = "_"

// -- Item definition facts ------------------------------------------------
// Ref: Go Specification "Declarations and scope"
data go_func_keyword: String = "func"
data go_async_prefix: String = ""
data go_struct_keyword: String = "struct"
data go_enum_keyword: String = "type"
data go_type_alias_keyword: String = "type"
data go_param_separator: String = ", "
data go_return_arrow: String = " "
data go_param_type_sep: String = " "
data go_module_keyword: String = "package"
data go_import_keyword: String = "import"
data go_import_from_keyword: String = ""

// -- Project scaffold ----------------------------------------------------
// Ref: Go modules reference (go.dev/ref/mod)
// Mirrors go_scaffold from std.languages.
data go_source_extension: String = ".go"
data go_manifest_file: String = "go.mod"

// -- String-like types ------------------------------------------------------
// Types that use string comparison/indexing semantics in Go.
data go_string_types: List<String> = ["String", "Secret"]

// -- Method templates -------------------------------------------------------
// Named-placeholder templates for algebra method calls.
// \{recv\} = pre-emitted receiver, \{arg\} = pre-emitted first argument.
// Ref: Go standard library + v2rt runtime helpers.
data go_method_templates: Map<String, String> = {
  "count": "len(\{recv\})",
  "join": "strings.Join(\{recv\}, \{arg\})",
  "split": "strings.Split(\{recv\}, \{arg\})",
  "string_contains": "strings.Contains(\{recv\}, \{arg\})",
  "concat": "append(\{recv\}, \{arg\}...)",
  "map": "v2rt.Map(\{recv\}, \{arg\})",
  "filter": "v2rt.Filter(\{recv\}, \{arg\})",
  "any": "v2rt.Any(\{recv\}, \{arg\})",
  "all": "v2rt.All(\{recv\}, \{arg\})",
  "flat_map": "v2rt.FlatMap(\{recv\}, \{arg\})",
  "skip": "\{recv\}[\{arg\}:]",
  "take": "\{recv\}[:\{arg\}]",
  "fold": "v2rt.Fold(\{recv\}, \{arg\})",
  "sort_by": "v2rt.SortBy(\{recv\}, \{arg\})",
  "append": "append(\{recv\}, \{arg\})"
}
