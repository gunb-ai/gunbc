// extdeps/languages/go/emit.dag -- Go language facts for the v2 emitter.
//
// Single source of truth for Go-specific data consumed by the emitter.
// Imports only the shared SimpleMethodSpec carrier from std; the rest are
// leaf data declarations.
//
// Ref: The Go Programming Language Specification (go.dev/ref/spec)
//      Go Standard Library (pkg.go.dev/std)
//
// Consumers:
//   v2/05_emit.dag -- type mapping, keywords, container templates

module extdeps.languages.go.emit

import std.emit_model { SimpleMethodSpec }

// -- Keyword/operator translation ----------------------------------------
// DAG keywords/operators -> Go syntax.
// Ref: Go Spec, Operators and punctuation
data go_keywords: Map<String, String> = {
  "true": "true", "false": "false", "null": "nil",
  "and": "&&", "or": "||", "not": "!",
  "div": "/"
}

// -- Container type templates --------------------------------------------
// {0} = element type, {1} = second type (maps).
// Ref: Go Spec, Composite literals
data go_container_templates: Map<String, String> = {
  "list": "[]\{0\}", "set": "map[\{0\}]struct{}",
  "optional": "*\{0\}", "map": "map[\{0\}]\{1\}",
  "free_monoid": "[]\{0\}", "partial_function": "map[\{0\}]\{1\}",
  "boolean_algebra": "bool"
}

// -- Reserved words ------------------------------------------------------
// Ref: Go Spec "Keywords" + predeclared identifiers
data go_reserved: List<String> = [
  "break", "case", "chan", "const", "continue",
  "default", "defer", "else", "fallthrough", "for",
  "func", "go", "goto", "if", "import",
  "interface", "map", "package", "range", "return",
  "select", "struct", "switch", "type", "var",
  "bool", "byte", "complex64", "complex128", "error",
  "float32", "float64", "int", "int8", "int16", "int32", "int64",
  "rune", "string", "uint", "uint8", "uint16", "uint32", "uint64",
  "uintptr", "true", "false", "iota", "nil",
  "append", "cap", "close", "complex", "copy", "delete",
  "imag", "len", "make", "new", "panic", "print", "println",
  "real", "recover"
]

// -- Reserved word escape ------------------------------------------------
// Ref: Go Spec -- Go uses no raw identifier escape; underscore suffix by convention.
// Mirrors go_reserved_words.strategy from std.languages (NoEscape, but
// the emitter appends "_" for keywords that clash with identifiers).
data go_reserved_escape_suffix: String = "_"

// -- Item definition facts ------------------------------------------------
// Ref: Go Specification "Declarations and scope"
data go_func_keyword: String = "func"
data go_async_prefix: String = ""
data go_struct_keyword: String = "struct"
data go_enum_keyword: String = "type"
data go_type_alias_keyword: String = "type"
data go_param_separator: String = ", "
data go_return_arrow: String = " "
data go_param_type_sep: String = " "
data go_module_keyword: String = "package"
data go_import_keyword: String = "import"
data go_import_from_keyword: String = ""

// -- Project scaffold ----------------------------------------------------
// Ref: Go modules reference (go.dev/ref/mod)
data go_manifest_file: String = "go.mod"
data go_source_extension: String = ".go"

// -- String-like types ------------------------------------------------------
// Types that use string comparison/indexing semantics in Go.
data go_string_types: List<String> = ["String", "Secret"]

// -- Method templates -------------------------------------------------------
// Named-placeholder templates for algebra method calls.
// \{recv\} = pre-emitted receiver, \{arg\} = pre-emitted first argument.
// Ref: Go standard library + v2rt runtime helpers.
//
// Single authority: `go_simple_method_specs` carries the flat-templatable
// (unary `{recv}`/`{arg}`) methods the v1 emitter renders by template;
// `map`/`fold`/`concat` are deliberately NOT here — they are binary+
// (`fold(coll, init, f)` per dsl/std/algebra.dag) and route through the
// runtime bridge, which forwards every argument. `go_method_templates_flat()`
// (the v1 emit authority) derives from this list; `go_method_templates()`
// re-adds the three runtime entries for the v2-legacy bare-name superset (see
// dsl/std/methods.dag dissolution trigger #1133). Mirrors #5039's Rust slice.
data go_simple_method_specs: List<SimpleMethodSpec> = [
  { method_name: "count",            template: "len(\{recv\})",                          wraps_result: false },
  { method_name: "join",             template: "strings.Join(\{recv\}, \{arg\})",        wraps_result: false },
  { method_name: "split",            template: "strings.Split(\{recv\}, \{arg\})",       wraps_result: false },
  { method_name: "string_contains",  template: "strings.Contains(\{recv\}, \{arg\})",    wraps_result: false },
  { method_name: "filter",           template: "v2rt.Filter(\{recv\}, \{arg\})",         wraps_result: false },
  { method_name: "any",              template: "v2rt.Any(\{recv\}, \{arg\})",            wraps_result: false },
  { method_name: "all",              template: "v2rt.All(\{recv\}, \{arg\})",            wraps_result: false },
  { method_name: "flat_map",         template: "v2rt.FlatMap(\{recv\}, \{arg\})",        wraps_result: false },
  { method_name: "skip",             template: "\{recv\}[\{arg\}:]",                     wraps_result: false },
  { method_name: "take",             template: "\{recv\}[:\{arg\}]",                     wraps_result: false },
  { method_name: "sort_by",          template: "v2rt.SortBy(\{recv\}, \{arg\})",         wraps_result: false },
  { method_name: "append",           template: "append(\{recv\}, \{arg\})",              wraps_result: false }
]

// Derived: the flat templatable map the v1 emitter reads (single authority
// above). `map`/`fold`/`concat` are absent → v1 routes them via the runtime
// bridge (correct argument forwarding).
fn go_method_templates_flat() -> Map<String, String> {
  go_simple_method_specs
    |> fold(init: empty_map(), f: (acc, spec) => map_insert(acc, spec.method_name, spec.template))
}

// Derived superset: the flat map plus the three runtime-bridged entries, for
// the v2-legacy bare-name lookup. Byte-identical key/value set to the former
// `go_method_templates` data literal. v1 emit does NOT read this.
fn go_method_templates() -> Map<String, String> {
  go_method_templates_flat()
    |> map_insert("concat", "append(\{recv\}, \{arg\}...)")
    |> map_insert("map", "v2rt.Map(\{recv\}, \{arg\})")
    |> map_insert("fold", "v2rt.Fold(\{recv\}, \{arg\})")
}

// -- Expression syntax templates ------------------------------------------
data go_lambda_template: String = "func({0}) interface\{\} \{ {1} \}"
data go_error_expr_template: String = "panic({0})"
data go_list_literal_empty: String = "[]interface\{\}\{\}"
data go_list_literal_template: String = "[]interface\{\}\{{0}\}"
data go_null_coalesce_template: String = "func() interface\{\} \{ if {0} != nil \{ return {0} \}; return {1} \}()"
data go_error_type_template: String = "__EMIT_BUG_{0}__"
data go_type_arg_open: String = "<"
data go_type_arg_close: String = ">"
data go_void_type: String = ""
data go_tuple_empty: String = "struct\{\}"
data go_tuple_pair_template: String = "struct\{ First {0}; Second {1} \}"
data go_tuple_multi_template: String = "struct\{ {0} \}"
data go_tuple_separator: String = "; "
