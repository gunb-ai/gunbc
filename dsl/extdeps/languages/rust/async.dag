// extdeps/languages/rust/async.dag -- "How does Rust handle async execution?"
//
// Async/await syntax, the tokio runtime, Future trait, and task spawning
// as specified in The Rust Reference and tokio documentation.
//
// Ref: The Rust Reference 15 "Async and await"
//      tokio.rs docs (docs.rs/tokio)
//      std::future::Future trait
//
// Consumers:
//   v2/05_emit_rust.dag -- async func emission, service call awaiting, main.rs

module extdeps.languages.rust.async_

// -- Async function syntax -------------------------------------------
// Ref: Rust Reference 15 "Async and await"

// "How does Rust define an async function?"
data async_fn_template: String = "pub async fn \{name\}(\{params\})\{ret\} \{\n\{body\}\n\}"

// "How does Rust await a future?"
// Rust uses postfix .await (not prefix like Python/JS).
data await_suffix: String = ".await"
data async_call_template: String = "\{call\}.await?"

// -- Tokio runtime ---------------------------------------------------
// Ref: tokio.rs -- tokio 1.x

// "What async runtime does generated Rust use?"
data runtime_crate: String = "tokio"
data runtime_version: String = "1"
data runtime_features: List<String> = ["full"]

// Main function attribute for tokio.
data tokio_main_attribute: String = "#[tokio::main]"
data tokio_main_template: String = "#[tokio::main]\nasync fn main() \{\n\{body\}\n\}"

// -- Task spawning ---------------------------------------------------
// Ref: tokio::spawn, tokio::task::JoinHandle

data spawn_template: String = "tokio::spawn(\{expr\})"
data join_template: String = "futures::join!(\{exprs\})"

// -- HTTP client -----------------------------------------------------
// Ref: reqwest 0.12.x (docs.rs/reqwest)
//
// Used by service definitions with REST transport.

data http_client_crate: String = "reqwest"
data http_client_version: String = "0.12"
data http_client_features: List<String> = ["json"]

// Request building templates.
data http_get_template: String = "reqwest::Client::new().get(&\{url\})"
data http_post_template: String = "reqwest::Client::new().post(&\{url\})"
data http_header_template: String = ".header(\"\{name\}\", &\{value\})"
data http_json_body_template: String = ".json(&\{body\})"
data http_send_template: String = ".send().await?"
data http_json_response_template: String = ".json::<\{type\}>().await?"

// -- Process execution -----------------------------------------------
// Ref: std::process::Command
//
// Used by service definitions with shell transport.

data command_new_template: String = "std::process::Command::new(\{program\})"
data command_arg_template: String = ".arg(\{arg\})"
data command_args_template: String = ".args(&\{args\})"
data command_cwd_template: String = ".current_dir(\{dir\})"
data command_output_template: String = ".output()"
data stdout_to_string: String = "String::from_utf8_lossy(&output.stdout).to_string()"

// -- File I/O --------------------------------------------------------
// Ref: std::fs

data file_read_template: String = "std::fs::read_to_string(\{path\})?"
data file_write_template: String = "std::fs::write(\{path\}, \{content\})?"
