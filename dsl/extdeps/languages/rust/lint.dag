// extdeps/languages/rust/lint.dag -- "What imports does Rust usage require?"
//
// Import derivation rules: maps type/trait/container usage to the
// corresponding Rust `use` statements the emitter must produce.
//
// Ref: Rust std library (doc.rust-lang.org/std)
//      serde (serde.rs)
//      tokio (tokio.rs)
//
// Consumers:
//   v2/05_emit_rust.dag -- import collection pass

module extdeps.languages.rust.lint

import std.languages {
  ImportRule, ImportTrigger,
  TraitImplTrigger, DeriveMacroTrigger,
  ContainerUsageTrigger, AsyncUsageTrigger
}

data rust_import_rules: List<ImportRule> = [
  { trigger: ContainerUsageTrigger { container: "HashMap" }, import_path: "use std::collections::HashMap;" },
  { trigger: ContainerUsageTrigger { container: "BTreeSet" }, import_path: "use std::collections::BTreeSet;" },
  { trigger: ContainerUsageTrigger { container: "Rc" }, import_path: "use std::rc::Rc;" },
  { trigger: TraitImplTrigger { trait_name: "Serialize" }, import_path: "use serde::Serialize;" },
  { trigger: TraitImplTrigger { trait_name: "Deserialize" }, import_path: "use serde::Deserialize;" },
  { trigger: DeriveMacroTrigger { macro_name: "Debug" }, import_path: "" },
  { trigger: DeriveMacroTrigger { macro_name: "Clone" }, import_path: "" },
  { trigger: AsyncUsageTrigger, import_path: "use tokio;" }
]
