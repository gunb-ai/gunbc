// extdeps/languages/rust/emit.dag -- Rust language facts for the v2 emitter.
//
// Single source of truth for Rust-specific data consumed by the emitter.
// No imports -- these are leaf data declarations.
//
// Ref: The Rust Reference (doc.rust-lang.org/reference)
//      Rust Standard Library (doc.rust-lang.org/std)
//
// Consumers:
//   v2/05_emit.dag       -- type mapping, keywords, container templates
//   v2/05_emit_rust.dag  -- reserved words, runtime function tables

module extdeps.languages.rust.emit

// -- Keyword/operator translation ----------------------------------------
// DAG keywords/operators -> Rust syntax.
// Ref: Rust Reference 8.2 "Expressions"
data rust_keywords: Map<String, String> = {
  "true": "true", "false": "false", "null": "None",
  "and": "&&", "or": "||", "not": "!",
  "div": "/"
}

// -- Container type templates --------------------------------------------
// {0} = element type, {1} = second type (maps).
// Ref: std::vec::Vec, std::collections::BTreeSet, std::option::Option, std::collections::HashMap
// NOTE: Templates are BARE types. Rc-wrapping is applied by the rendering
// layer (build_type_rendering + render_type) via rc_types, not baked into
// templates. This prevents Rc decisions from being duplicated between
// templates and the rc_types predicate.
data rust_container_templates: Map<String, String> = {
  "list": "Vec<\{0\}>", "set": "std::collections::BTreeSet<\{0\}>",
  "optional": "Option<\{0\}>", "map": "HashMap<\{0\}, \{1\}>",
  "free_monoid": "Vec<\{0\}>", "partial_function": "HashMap<\{0\}, \{1\}>",
  "boolean_algebra": "bool"
}

// -- Method templates --------------------------------------------------------
// Named-placeholder templates for simple algebra method calls.
// Templates use {recv} (receiver) and {arg} (first argument).
// Applied via apply_named_template in shared emit.
//
// Single authority: SimpleMethodSpec carries both the template and
// wraps_result flag. Derived maps feed LanguageSpec (template only)
// and Rust emitter (wrapping). Same pattern as HigherOrderMethodSpec.

type SimpleMethodSpec {
  method_name: String
  template: String
  wraps_result: Bool
}

data rust_simple_method_specs: List<SimpleMethodSpec> = [
  { method_name: "count",     template: "(\{recv\}.len() as i64)",                                                                    wraps_result: false },
  { method_name: "join",      template: "\{recv\}.join(&\{arg\})",                                                                    wraps_result: false },
  { method_name: "split",     template: "\{recv\}.split(&\{arg\}).map(|s| s.to_string()).collect::<Vec<_>>()",                         wraps_result: true },
  { method_name: "last",      template: "\{recv\}.last().cloned()",                                                                    wraps_result: false },
  { method_name: "first",     template: "\{recv\}.first().cloned()",                                                                   wraps_result: false },
  { method_name: "enumerate", template: "\{recv\}.iter().cloned().enumerate().map(|(i, v)| (i as i64, v)).collect::<Vec<_>>()",         wraps_result: true },
  { method_name: "chars",     template: "\{recv\}.chars().map(|c| c as i64).collect::<Vec<_>>()",                                      wraps_result: true },
  { method_name: "skip",      template: "\{recv\}.iter().cloned().skip(\{arg\} as usize).collect::<Vec<_>>()",                         wraps_result: true },
  { method_name: "take",      template: "\{recv\}.iter().cloned().take(\{arg\} as usize).collect::<Vec<_>>()",                         wraps_result: true }
]

// Derived: template map for LanguageSpec consumption (backend-neutral).
fn rust_method_templates() -> Map<String, String> {
  rust_simple_method_specs
    |> fold(init: empty_map(), f: (acc, spec) => map_insert(acc, spec.method_name, spec.template))
}

// Derived: wraps_result map for Rust Rc-wrapping decisions.
fn rust_method_wraps_result() -> Map<String, Bool> {
  rust_simple_method_specs
    |> filter(s => s.wraps_result)
    |> fold(init: empty_map(), f: (acc, spec) => map_insert(acc, spec.method_name, true))
}

// -- Reserved words ------------------------------------------------------
// Ref: Rust Reference, Appendix A: Keywords
data rust_reserved: List<String> = [
  "as", "async", "await", "break", "const", "continue", "crate",
  "dyn", "else", "enum", "extern", "false", "fn", "for", "if",
  "impl", "in", "let", "loop", "match", "mod", "move", "mut",
  "pub", "ref", "return", "self", "Self", "static", "struct",
  "super", "trait", "true", "type", "unsafe", "use", "where",
  "while", "yield", "abstract", "become", "box", "do", "final",
  "macro", "override", "priv", "try", "typeof", "unsized",
  "virtual"
]

// -- Reserved word escape ------------------------------------------------
// Mirrors rust_reserved_words.strategy.suffix from std.languages.
data rust_reserved_escape_suffix: String = "_"

// -- String-like types ---------------------------------------------------
// Types that render as Rust &str/.as_str() for comparison operations.
data rust_string_types: List<String> = ["String", "Secret"]

// -- Derives --------------------------------------------------------------
// Ref: Rust derive macros. Serde required for data defs with nested
// records (emitted via serde_json::from_value). serde is already a
// dependency so derives are free at the margin.
data rust_struct_derives: String = "#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]"
// Copy variant: value-semantic types that don't need Rc wrapping.
data rust_struct_derives_copy: String = "#[derive(Debug, Clone, Copy, PartialEq, serde::Serialize, serde::Deserialize)]"
data rust_enum_derives: String = "#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]"
// Copy variant: simple enums (all-unit variants).
data rust_enum_derives_copy: String = "#[derive(Debug, Clone, Copy, PartialEq, serde::Serialize, serde::Deserialize)]"
// Ref: serde docs — #[serde(tag = "...")] for internally tagged enums
data rust_serde_tag: String = "#[serde(tag = \"_variant\")]"
// {0} = field key name. Ref: serde docs — #[serde(rename = "...")]
data rust_serde_rename_template: String = "#[serde(rename = \"\{0\}\")]"

// -- Item definition facts ------------------------------------------------
// Ref: Rust Reference §6 "Items"
// Each fact is a single language-specific token the emitter composes.
data rust_func_keyword: String = "fn"
data rust_async_prefix: String = "async "
data rust_struct_keyword: String = "struct"
data rust_enum_keyword: String = "enum"
data rust_type_alias_keyword: String = "type"
data rust_param_separator: String = ", "
data rust_return_arrow: String = " -> "
data rust_param_type_sep: String = ": "
data rust_module_keyword: String = "mod"
data rust_import_keyword: String = "use"
data rust_import_from_keyword: String = ""

// -- Expression syntax templates ------------------------------------------
// {0} = params, {1} = body. Ref: Rust Reference §8.2.2 "Closure expressions"
data rust_lambda_template: String = "|{0}| {1}"
// {0} = message string
data rust_error_expr_template: String = "panic!({0})"
// {0} = comma-separated elements
data rust_list_literal_empty: String = "Rc::new(vec![])"
data rust_list_literal_template: String = "Rc::new(vec![{0}])"
// {0} = left expr, {1} = right expr
data rust_null_coalesce_template: String = "{0}.unwrap_or_else(|| {1})"
// {0} = error label
data rust_error_type_template: String = "compile_error!(\"{0}\")"
// -- Type argument brackets -----------------------------------------------
data rust_type_arg_open: String = "<"
data rust_type_arg_close: String = ">"
// -- Void type ------------------------------------------------------------
data rust_void_type: String = "()"
// -- Tuple syntax ---------------------------------------------------------
data rust_tuple_empty: String = "()"
data rust_tuple_pair_template: String = "({0}, {1})"
data rust_tuple_multi_template: String = "({0})"
data rust_tuple_separator: String = ", "

// -- Project scaffold ----------------------------------------------------
// Ref: Cargo Reference (doc.rust-lang.org/cargo/reference)
// Mirrors rust_scaffold from std.languages.
data rust_source_extension: String = ".rs"
data rust_source_dir: String = "src/"
data rust_visibility: String = "pub "

// -- Runtime function registry --------------------------------------------
// Single authority for DAG functions backed by v1_rt at runtime.
// Each entry declares: the DAG-level name, the Rust bridge symbol (when
// it differs from the DAG name), and whether the first map argument is
// passed by reference.
//
// Consumers call is_rt_function / rt_bridge_name / rt_passes_by_ref
// instead of probing three separate maps.

type RuntimeFunction {
  name: String
  bridge_name: String
  passes_by_ref: Bool
  wraps_result: Bool
}

data rt_function_registry: List<RuntimeFunction> = [
  { name: "concat",             bridge_name: "concat",           passes_by_ref: false, wraps_result: false },
  { name: "char_at",            bridge_name: "char_at",          passes_by_ref: true,  wraps_result: false },
  { name: "string_length",      bridge_name: "string_length",    passes_by_ref: true,  wraps_result: false },
  { name: "substring",          bridge_name: "substring",        passes_by_ref: true,  wraps_result: false },
  { name: "string_contains",    bridge_name: "string_contains",  passes_by_ref: true,  wraps_result: false },
  { name: "scan_while",         bridge_name: "scan_while",       passes_by_ref: true,  wraps_result: false },
  { name: "skip_horizontal_ws", bridge_name: "skip_horizontal_ws", passes_by_ref: true, wraps_result: false },
  { name: "scan_to_eol",        bridge_name: "scan_to_eol",      passes_by_ref: true,  wraps_result: false },
  { name: "scan_string_end",    bridge_name: "scan_string_end",  passes_by_ref: true,  wraps_result: false },
  { name: "code_point",         bridge_name: "code_point",       passes_by_ref: false, wraps_result: false },
  { name: "from_code_point",    bridge_name: "from_code_point",  passes_by_ref: false, wraps_result: false },
  { name: "lookup",             bridge_name: "lookup",           passes_by_ref: true,  wraps_result: false },
  { name: "index_by",           bridge_name: "rc_index_by",      passes_by_ref: false, wraps_result: false },
  { name: "empty_map",          bridge_name: "rc_empty_map",     passes_by_ref: false, wraps_result: false },
  { name: "empty_set",          bridge_name: "rc_empty_set",     passes_by_ref: false, wraps_result: false },
  { name: "set_insert",         bridge_name: "rc_set_insert",    passes_by_ref: false, wraps_result: false },
  { name: "set_union",          bridge_name: "rc_set_union",     passes_by_ref: false, wraps_result: false },
  { name: "set_contains",       bridge_name: "set_contains",     passes_by_ref: true,  wraps_result: false },
  { name: "map_insert",         bridge_name: "rc_map_insert",    passes_by_ref: false, wraps_result: false },
  { name: "map_merge",          bridge_name: "rc_map_merge",     passes_by_ref: false, wraps_result: false },
  { name: "list_concat",        bridge_name: "rc_list_concat",   passes_by_ref: false, wraps_result: false },
  { name: "str_eq",             bridge_name: "str_eq",           passes_by_ref: false, wraps_result: false },
  { name: "filesystem_read",    bridge_name: "filesystem_read",  passes_by_ref: false, wraps_result: false },
  { name: "list_push",          bridge_name: "rc_list_push",     passes_by_ref: false, wraps_result: false },
  { name: "map_get",            bridge_name: "map_get",          passes_by_ref: true,  wraps_result: false },
  { name: "map_keys",           bridge_name: "map_keys",         passes_by_ref: true,  wraps_result: true },
  { name: "map_values",         bridge_name: "map_values",       passes_by_ref: true,  wraps_result: true },
  { name: "parse_int",          bridge_name: "parse_int",        passes_by_ref: false, wraps_result: false },
  { name: "map_contains_key",   bridge_name: "map_contains_key", passes_by_ref: true,  wraps_result: false },
  { name: "map_has",            bridge_name: "map_has",          passes_by_ref: true,  wraps_result: false },
  { name: "reverse",            bridge_name: "reverse",          passes_by_ref: false, wraps_result: false },
  { name: "replace",            bridge_name: "replace",          passes_by_ref: false, wraps_result: false },
  { name: "chars_to_string",    bridge_name: "chars_to_string",  passes_by_ref: true,  wraps_result: false },
  { name: "record_source_chars_index_lookup", bridge_name: "record_source_chars_index_lookup", passes_by_ref: false, wraps_result: false },
  { name: "append",             bridge_name: "append",           passes_by_ref: false, wraps_result: true },
  { name: "contains",           bridge_name: "contains",         passes_by_ref: false, wraps_result: false },
  { name: "count",              bridge_name: "count",            passes_by_ref: false, wraps_result: false },
  { name: "clamp",              bridge_name: "clamp",            passes_by_ref: false, wraps_result: false },
  { name: "atom_identity_hash", bridge_name: "atom_identity_hash", passes_by_ref: false, wraps_result: false },
  { name: "hash_combine",       bridge_name: "hash_combine",     passes_by_ref: false, wraps_result: false }
]

// Derived indexes from rt_function_registry — all computed, single authority.

fn rt_functions() -> Map<String, Bool> {
  rt_function_registry
    |> fold(init: empty_map(), f: (acc, entry) => map_insert(acc, entry.name, true))
}

fn rt_ref_map_functions() -> Map<String, Bool> {
  rt_function_registry
    |> filter(f => f.passes_by_ref)
    |> fold(init: empty_map(), f: (acc, entry) => map_insert(acc, entry.name, true))
}

fn rt_wraps_result() -> Map<String, Bool> {
  rt_function_registry
    |> filter(f => f.wraps_result)
    |> fold(init: empty_map(), f: (acc, entry) => map_insert(acc, entry.name, true))
}

fn rt_bridge_function_names() -> Map<String, String> {
  rt_function_registry
    |> filter(f => f.name != f.bridge_name)
    |> fold(init: empty_map(), f: (acc, entry) => map_insert(acc, entry.name, entry.bridge_name))
}

fn is_rt_function(name: String) -> Bool {
  map_contains_key(rt_functions(), name)
}

fn rt_bridge_name(name: String) -> String {
  match map_get(rt_bridge_function_names(), name) {
    Present { value: bridge } => bridge
    Absent => name
  }
}

fn rt_passes_by_ref(name: String) -> Bool {
  map_contains_key(rt_ref_map_functions(), name)
}

// -- Higher-order method templates ------------------------------------------
// Templates for algebra methods that take lambda or function-ref arguments.
// filter, any, all, flat_map share the same structural pattern:
//   inline case: extract lambda params/body, substitute into template
//   fn_ref case: pass function reference through iterator adapter
//
// Placeholders (all named, processed by apply_named_template):
//   {param}      — rendered lambda parameter name
//   {body}       — rendered lambda body expression
//   {iter}       — receiver through sharing.iter_owned
//   {inner_iter} — body through sharing.iter_owned (flat_map only)
//   {arg}        — rendered first argument (fn_ref case)

type HigherOrderMethodSpec {
  method_name: String
  inline_template: String
  fn_ref_template: String
  wraps_in_sharing: Bool
}

data rust_higher_order_methods: List<HigherOrderMethodSpec> = [
  { method_name: "filter", inline_template: "\{ let mut __result = Vec::new(); for \{param\} in \{iter\} \{ if \{body\} \{ __result.push(\{param\}); \} \} __result \}", fn_ref_template: "\{iter\}.filter(\{arg\}).collect::<Vec<_>>()", wraps_in_sharing: true },
  { method_name: "any", inline_template: "\{ let mut __found = false; for \{param\} in \{iter\} \{ if \{body\} \{ __found = true; break; \} \} __found \}", fn_ref_template: "\{iter\}.any(\{arg\})", wraps_in_sharing: false },
  { method_name: "all", inline_template: "\{ let mut __all = true; for \{param\} in \{iter\} \{ if !(\{body\}) \{ __all = false; break; \} \} __all \}", fn_ref_template: "\{iter\}.all(\{arg\})", wraps_in_sharing: false },
  { method_name: "flat_map", inline_template: "\{ let mut __result = Vec::new(); for \{param\} in \{iter\} \{ __result.extend(\{inner_iter\}); \} __result \}", fn_ref_template: "\{iter\}.flat_map(\{arg\}).collect::<Vec<_>>()", wraps_in_sharing: true }
]
