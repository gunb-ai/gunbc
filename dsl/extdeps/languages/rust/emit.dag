// extdeps/languages/rust/emit.dag -- Rust language facts for the v2 emitter.
//
// Single source of truth for Rust-specific data consumed by the emitter.
// No imports -- these are leaf data declarations.
//
// Ref: The Rust Reference (doc.rust-lang.org/reference)
//      Rust Standard Library (doc.rust-lang.org/std)
//
// Consumers:
//   v2/05_emit.dag       -- type mapping, keywords, container templates
//   v2/05_emit_rust.dag  -- reserved words, runtime function tables

module extdeps.languages.rust.emit

// -- Type mapping --------------------------------------------------------
// DAG abstract type -> Rust concrete type.
// Ref: Rust Reference 10.1 "Types"
data rust_type_map: Map<String, String> = {
  "String": "String", "Int": "i64", "Float": "f64", "Bool": "bool",
  "Bytes": "Vec<u8>", "Unit": "()", "Secret": "String", "Json": "serde_json::Value"
}

// -- Keyword/operator translation ----------------------------------------
// DAG keywords/operators -> Rust syntax.
// Ref: Rust Reference 8.2 "Expressions"
data rust_keywords: Map<String, String> = {
  "true": "true", "false": "false", "null": "None",
  "and": "&&", "or": "||", "not": "!",
  "div": "/"
}

// -- Container type templates --------------------------------------------
// {0} = element type, {1} = second type (maps).
// Ref: std::vec::Vec, std::collections::BTreeSet, std::option::Option, std::collections::HashMap
// NOTE: Templates are BARE types. Rc-wrapping is applied by the rendering
// layer (emit_node_type_rc) via rc_types, not baked into templates.
// This prevents Rc decisions from being duplicated between templates
// and the rc_types predicate.
data rust_container_templates: Map<String, String> = {
  "list": "Vec<\{0\}>", "set": "std::collections::BTreeSet<\{0\}>",
  "non_empty_list": "NonEmptyVec<\{0\}>", "non_empty_set": "NonEmptyBTreeSet<\{0\}>",
  "optional": "Option<\{0\}>", "map": "HashMap<\{0\}, \{1\}>",
  "free_monoid": "Vec<\{0\}>", "partial_function": "HashMap<\{0\}, \{1\}>",
  "boolean_algebra": "bool"
}

// -- Reserved words ------------------------------------------------------
// Ref: Rust Reference, Appendix A: Keywords
data rust_reserved: List<String> = [
  "as", "async", "await", "break", "const", "continue", "crate",
  "dyn", "else", "enum", "extern", "false", "fn", "for", "if",
  "impl", "in", "let", "loop", "match", "mod", "move", "mut",
  "pub", "ref", "return", "self", "Self", "static", "struct",
  "super", "trait", "true", "type", "unsafe", "use", "where",
  "while", "yield", "abstract", "become", "box", "do", "final",
  "macro", "override", "priv", "try", "typeof", "unsized",
  "virtual"
]

// -- Reserved word escape ------------------------------------------------
// Ref: Rust Reference, Appendix B: Raw identifiers
// Mirrors rust_reserved_words.strategy.prefix from std.languages.
data rust_reserved_escape_prefix: String = "r#"

// -- Value-semantic types ------------------------------------------------
// Types with Copy semantics in Rust — no Rc wrapping, no .clone().
// These are the types whose DAG algebra resolves to fixed-width carriers.
// Ref: Rust Reference 10.1.2 "Copy trait"
data rust_value_types: List<String> = ["Int", "Bool", "Float"]

// -- String-like types ---------------------------------------------------
// Types that render as Rust &str/.as_str() for comparison operations.
data rust_string_types: List<String> = ["String", "Secret"]

// -- Derives --------------------------------------------------------------
// Ref: Rust derive macros. Serde required for data defs with nested
// records (emitted via serde_json::from_value). serde is already a
// dependency so derives are free at the margin.
data rust_struct_derives: String = "#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]"
// Copy variant: value-semantic types that don't need Rc wrapping.
data rust_struct_derives_copy: String = "#[derive(Debug, Clone, Copy, PartialEq, serde::Serialize, serde::Deserialize)]"
data rust_enum_derives: String = "#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]"
// Copy variant: simple enums (all-unit variants).
data rust_enum_derives_copy: String = "#[derive(Debug, Clone, Copy, PartialEq, serde::Serialize, serde::Deserialize)]"
data rust_serde_tag: String = ""
// {0} = field key name
data rust_serde_rename_template: String = ""

// -- Project scaffold ----------------------------------------------------
// Ref: Cargo Reference (doc.rust-lang.org/cargo/reference)
// Mirrors rust_scaffold from std.languages.
data rust_source_extension: String = ".rs"
data rust_source_dir: String = "src/"
data rust_visibility: String = "pub "

// -- Runtime function registry --------------------------------------------
// Single authority for DAG functions backed by v2_rt at runtime.
// Each entry declares: the DAG-level name, the Rust bridge symbol (when
// it differs from the DAG name), and whether the first map argument is
// passed by reference.
//
// Consumers call is_rt_function / rt_bridge_name / rt_passes_by_ref
// instead of probing three separate maps.

type RuntimeFunction {
  name: String
  bridge_name: String
  passes_by_ref: Bool
}

data rt_function_registry: List<RuntimeFunction> = [
  { name: "concat",             bridge_name: "concat",           passes_by_ref: false },
  { name: "char_at",            bridge_name: "char_at",          passes_by_ref: false },
  { name: "string_length",      bridge_name: "string_length",    passes_by_ref: false },
  { name: "substring",          bridge_name: "substring",        passes_by_ref: false },
  { name: "string_contains",    bridge_name: "string_contains",  passes_by_ref: false },
  { name: "scan_while",         bridge_name: "scan_while",       passes_by_ref: false },
  { name: "skip_horizontal_ws", bridge_name: "skip_horizontal_ws", passes_by_ref: false },
  { name: "scan_to_eol",        bridge_name: "scan_to_eol",      passes_by_ref: false },
  { name: "scan_string_end",    bridge_name: "scan_string_end",  passes_by_ref: false },
  { name: "code_point",         bridge_name: "code_point",       passes_by_ref: false },
  { name: "from_code_point",    bridge_name: "from_code_point",  passes_by_ref: false },
  { name: "lookup",             bridge_name: "lookup",           passes_by_ref: true },
  { name: "index_by",           bridge_name: "rc_index_by",      passes_by_ref: false },
  { name: "empty_map",          bridge_name: "rc_empty_map",     passes_by_ref: false },
  { name: "map_insert",         bridge_name: "rc_map_insert",    passes_by_ref: false },
  { name: "map_merge",          bridge_name: "rc_map_merge",     passes_by_ref: false },
  { name: "list_concat",        bridge_name: "rc_list_concat",   passes_by_ref: false },
  { name: "str_eq",             bridge_name: "str_eq",           passes_by_ref: false },
  { name: "filesystem_read",    bridge_name: "filesystem_read",  passes_by_ref: false },
  { name: "list_push",          bridge_name: "rc_list_push",     passes_by_ref: false },
  { name: "map_get",            bridge_name: "map_get",          passes_by_ref: true },
  { name: "map_keys",           bridge_name: "map_keys",         passes_by_ref: true },
  { name: "map_values",         bridge_name: "map_values",       passes_by_ref: true },
  { name: "parse_int",          bridge_name: "parse_int",        passes_by_ref: false },
  { name: "map_contains_key",   bridge_name: "map_contains_key", passes_by_ref: true },
  { name: "map_has",            bridge_name: "map_has",          passes_by_ref: true },
  { name: "reverse",            bridge_name: "reverse",          passes_by_ref: false },
  { name: "replace",            bridge_name: "replace",          passes_by_ref: false }
]

// Helper functions: O(1) lookup via indexed maps built from the registry.
// The registry is the single hand-maintained authority. These maps are
// the DERIVED index — their content must match the registry. If you add
// a runtime function, add it to rt_function_registry above; then update
// the maps below to match.
//
// Why not derive programmatically? The .dag data syntax only supports
// literal map/list initializers, not computed expressions. When the
// language gains computed data declarations, these maps should become
// `rt_function_registry |> fold(...)`.

data rt_functions: Map<String, Bool> = {
  "concat": true, "char_at": true, "string_length": true,
  "substring": true, "string_contains": true, "scan_while": true,
  "skip_horizontal_ws": true, "scan_to_eol": true, "scan_string_end": true,
  "code_point": true, "from_code_point": true, "lookup": true,
  "index_by": true, "empty_map": true, "map_insert": true,
  "map_merge": true, "list_concat": true, "str_eq": true,
  "filesystem_read": true, "list_push": true, "map_get": true,
  "map_keys": true, "map_values": true,
  "parse_int": true, "map_contains_key": true, "map_has": true
}

data rt_ref_map_functions: Map<String, Bool> = {
  "map_get": true, "map_keys": true, "map_values": true,
  "lookup": true, "map_contains_key": true, "map_has": true
}

data rt_bridge_function_names: Map<String, String> = {
  "empty_map": "rc_empty_map",
  "index_by": "rc_index_by",
  "list_concat": "rc_list_concat",
  "list_push": "rc_list_push",
  "map_insert": "rc_map_insert",
  "map_merge": "rc_map_merge"
}

fn is_rt_function(name: String) -> Bool {
  map_contains_key(rt_functions, name)
}

fn rt_bridge_name(name: String) -> String {
  match map_get(rt_bridge_function_names, name) {
    Some { value: bridge } => bridge
    None => name
  }
}

fn rt_passes_by_ref(name: String) -> Bool {
  map_contains_key(rt_ref_map_functions, name)
}
