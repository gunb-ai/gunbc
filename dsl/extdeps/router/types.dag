module extdeps.router.types

import std.types { NonEmptyStr, Int }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc2132#section-3.14"
  }
}

type DhcpOption12ClientHostname = NonEmptyStr where brand("DhcpOption12ClientHostname")

type DhcpReservationLabel = NonEmptyStr where brand("DhcpReservationLabel")

type DhcpLeaseObservation
  = DynamicDhcpLease {
      option_12_client_hostname: DhcpOption12ClientHostname?
      lease_time_remaining_minutes: Int
    }
  | StaticDhcpReservation { label: DhcpReservationLabel }
