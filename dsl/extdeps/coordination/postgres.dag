      failure_modes: [{ name: "Conflict", condition: "version_mismatch", http_status: null, recoverable: true, retry_safe: false }],
      edge_cases: [{ description: "conditional create may use insert-on-conflict semantics", trigger: "missing_row", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "transactional SQL execution capability", kind: Tooling }],
      assumptions: ["Version increments atomically with update"],
      unknowns: []
    }
  },
  {
    operation: "ClaimFromQueue",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [],
      edge_cases: [{ description: "SKIP LOCKED skips in-flight rows and can reorder fairness under contention", trigger: "hot_queue", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "queue table has claim_expires_at + ordering indexes", kind: Infrastructure }],
      assumptions: ["Claims include expiry and owner metadata"],
      unknowns: ["Starvation risk with persistent hot partitions"]
    }
  },
  {
    operation: "Heartbeat",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["claim_id", "owner"],
      determinism: Deterministic,
      failure_modes: [{ name: "LeaseLost", condition: "claim_not_owned_or_expired", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: HighConfidence,
      prerequisites: [{ description: "owner identity is stable for claim lifetime", kind: Runtime }],
      assumptions: ["Heartbeat updates claim_expires_at only for matching owner"],
      unknowns: []
    }
  },
  {
    operation: "Release",
    behavior: {
      side_effects: WritesState,
