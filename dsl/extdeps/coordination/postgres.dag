// extdeps/coordination/postgres.dag -- "PostgreSQL as a coordination store."

module extdeps.coordination.postgres

import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}
import std.rate_limit { PropagationDelay }

type PgIsolationLevel = ReadCommitted | Serializable

type PgSkipLocked {
  enabled: Bool
}

type PgFencingToken {
  column: String
  monotonic: Bool
}

type PgNotifyChannel {
  name: String
  payload_limit_bytes: Int
}

type PgCoordinationOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<PgCoordinationOperationBehavior> = [
  {
    operation: "KvGet",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "soft TTL requires client-side expires_at checks", trigger: "expired_row_present", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "read access to kv table", kind: Capability }],
      assumptions: ["SELECT path uses indexed key lookup"],
      unknowns: []
    }
  },
  {
    operation: "KvSet",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["key", "expected_version"],
      determinism: Deterministic,
      failure_modes: [{ name: "Conflict", condition: "rowcount_zero_due_to_version_mismatch", http_status: null, recoverable: true, retry_safe: false }],
      edge_cases: [],
      confidence: HighConfidence,
      prerequisites: [{ description: "write access to kv table", kind: Capability }],
      assumptions: ["Transaction wraps read-modify-write with row-level lock"],
      unknowns: ["Optimal lock granularity under mixed read/write workloads"]
    }
  },
  {
    operation: "KvCas",
