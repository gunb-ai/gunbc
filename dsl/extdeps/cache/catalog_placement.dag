// extdeps/cache/catalog_placement.dag — cache catalog placement/eviction arm.
// Split from IO semantics so AtomicityModel and CacheWriteSemantics variants do not
// share a module namespace (homonymous WriteThenCommit / WriteThenRename).

module extdeps.cache.catalog_placement

import std.cache_interface {
  ValueShape,
  PersistenceLocality,
  EvictionPolicy,
  AtomicityModel,
  AuthScope,
  ReadLatencyClass,
  ConsistencyModel,
}

type CacheInterfaceCatalogPlacement {
  value_shape: ValueShape
  locality: PersistenceLocality
  eviction: EvictionPolicy
  atomicity: AtomicityModel
  auth: AuthScope
  read_latency: ReadLatencyClass
  consistency: ConsistencyModel
}
