module extdeps.cache.rustup

import extdeps.cache.types { CacheInterfaceCatalogFacts, NativeInternal, ToolchainSpec }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  OpaqueStringEncoding,
  NativeInternalLookup,
  ProviderInternal,
  MissThenCreate,
  FileTree,
  PerHostFilesystem,
  Never,
  PerFile,
  FilesystemPerms,
  LocalDiskUs,
  Strong,
  VendorCitation,
  ToolchainChange,
  ManualPurge,
  Org,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "rust-lang.github.io/rustup/overrides.html"
  }
}

data rustup_toolchain_store_id: CacheInterfaceId = "rustup_toolchain_store"

data rustup_toolchain_store_facts: CacheInterfaceCatalogFacts = {
  identity: rustup_toolchain_store_id
  backing_surface: "rustup-toolchains-dir"
  transport_encoding: OpaqueStringEncoding
  key_derivation: {

    key_inputs: NativeInternal { cited_inputs: [ToolchainSpec] }
    overwritable: false
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: Org
    invalidation_triggers: [ToolchainChange, ManualPurge]
  }
  io: {
    lookup_semantics: NativeInternalLookup
    write_semantics: ProviderInternal
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: FileTree
    locality: PerHostFilesystem
    eviction: Never
    atomicity: PerFile
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: Strong
  }
  evidence: [
    {
      field: "key_derivation"
      evidence: VendorCitation {
        source: "rustup toolchain installation layout"
        url: "https://rust-lang.github.io/rustup/overrides.html"
      }
    },
  ]
}
