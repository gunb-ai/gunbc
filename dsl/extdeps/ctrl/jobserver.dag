module extdeps.ctrl.jobserver

import std.types { Int, String }
import std.nat { Nat, nat_min }
import std.measure { ByteSize, byte_size, byte_size_count, measure_fit_count_floor, measure_scale_fraction_floor, HardwareThreadCount, hardware_thread_count, hardware_thread_count_value }
import std.realization_width { byte_size_saturating_sub }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data ctrl_jobserver_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/ctrl/blob/main/host/install-ctrl-jobserver.sh"
  }
}

type CtrlJobserverConfig {
  margin: HardwareThreadCount
  mem_reserve: ByteSize
  mib_per_job: ByteSize
}

fn derive_jobserver_tokens(nproc: HardwareThreadCount, mem_total: ByteSize, cfg: CtrlJobserverConfig) -> HardwareThreadCount {
  let nproc_v = hardware_thread_count_value(t: nproc)
  let margin_v = hardware_thread_count_value(t: cfg.margin)
  let cpu_bound = nproc_v - margin_v
  let mem_for_builds = byte_size_saturating_sub(total: mem_total, reserved: cfg.mem_reserve)
  let mem_bound = measure_fit_count_floor(capacity: mem_for_builds, each: cfg.mib_per_job)
  hardware_thread_count(count: nat_min(a: cpu_bound, b: mem_bound))
}

fn jobserver_build_pool_bytes(nproc: HardwareThreadCount, mem_total: ByteSize, cfg: CtrlJobserverConfig) -> ByteSize {
  let tokens = derive_jobserver_tokens(nproc: nproc, mem_total: mem_total, cfg: cfg)
  measure_scale_fraction_floor(m: cfg.mib_per_job, num: hardware_thread_count_value(t: tokens), den: 1)
}

type CtrlJobserverCitation
  = CtrlJobserverCited { config: CtrlJobserverConfig, provenance: String }
  | CtrlJobserverAbsent

data ctrl_jobserver_config: CtrlJobserverCitation = CtrlJobserverAbsent

data ctrl_jobserver_flip_values_marker: String = "fail-closed citation. /opt/ctrl and /etc/default/ctrl-jobserver are root-only and unreadable from this session, so the committed citation is CtrlJobserverAbsent (fail-closed); flipping to CtrlJobserverCited is a later 1-line fill once a live read or operator-fed snapshot lands. Installer knobs parent supplied for the eventual flip (cite-do-not-copy: values ATTRIBUTED to ctrl, gunbc owns the SHAPE): margin=8 (CTRL_JOBSERVER_MARGIN), mib_per_job=1792 MiB = 1879048192 bytes (CTRL_JOBSERVER_MIB_PER_JOB, ~1.35GiB measured peak rustc RSS sized under the runner-slice MemoryMax), mem_reserve=UNCONFIRMED. Tokens are INSTALLER-DERIVED, NOT a baked 120: on a 128-core / 125GiB host derive_jobserver_tokens DERIVES to ~69 (the MEMORY bound binds: floor((125GiB - mem_reserve) / 1.75GiB) ~= 69 < nproc-margin = 120), NOT 120. The 120 CTRL_JOBSERVER_TOKENS env value is the CPU-bound knob; the effective token count is the memory-bounded min."
