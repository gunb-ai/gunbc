// extdeps/shell/shell.dag -- Host shell utilities (POSIX utilities + bash-compatible Exec).
//
// find, printenv: POSIX.1 utilities.
// which: common extension (not POSIX; POSIX uses `command -v`).
// Exec: `sh -c` — POSIX subprocess. (Formerly `sh -lc`; login shell dropped CI PATH.)
//
// These are facts about the host OS, not about any specific
// external service.
//
// Consumers:
//   tools/bootstrap.dag     -- find directories
//   tools/clippy.dag        -- which command
//   tools/deps.dag          -- run install scripts, check commands

module extdeps.shell

import std.types { FilePath, NonEmptyStr }

service shell.Find {
  operation ListDirs {
    input { path: FilePath, max_depth: Int = 1, min_depth: Int = 1 }
    output { dirs: List<FilePath> from "stdout_lines" }
    readonly
    transport shell { argv: ["find", "{path}", "-maxdepth", "{max_depth}", "-mindepth", "{min_depth}", "-type", "d"] }
    exit {
      0 => Unit
      nonzero => String "Find command failed"
    }
    mock_response {
      0 => { dirs: ["/tmp/mock-dir"] } "Mock directory listing"
    }
  }
}

service shell.Env {
  operation Get {
    input { name: NonEmptyStr }
    output { value: String? from "stdout" }
    readonly
    transport shell { argv: ["printenv", "{name}"] }
    exit {
      0 => Unit
      1 => Unit "Variable not set"
    }
    // 🟡 dissolved — feature:env-mock-response — dissolve-on-arrival: Phase-2-hermetic
    // RecordedFixture replay from claim_batch --fixture-store; forbidden: reintroducing
    // mock_response for Hermetic dispatch on this shape.
  }
}

service shell.Which {
  operation Check {
    input { command: NonEmptyStr }
    output { exists: Bool from "exit_success", path: FilePath? from "stdout" }
    readonly
    transport shell { argv: ["which", "{command}"] }
    exit {
      0 => Unit "Command found"
      1 => Unit "Command not found"
    }
    mock_response {
      0 => { exit_success: true, stdout: "/usr/bin/mock" } "Mock command found"
    }
  }
}

service shell.Exec {
  operation Run {
    input { script: String }
    // exit_code is the actual subprocess exit code (0 = success, 1, 2, ...).
    // success is the convenience bool (exit_code == 0). Workflows that
    // need tri-state semantics (grep: 0=match, 1=no-match, 2=error;
    // diff: 0=same, 1=different, 2=error) match on exit_code, not success.
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    // Use `sh -c` (not `-lc`): login shells reset PATH on CI runners and break
    // nested floor gates when the parent process already inherited GITHUB_ENV
    // (cargo/rustup). `-c` preserves the interpreter's environment.
    transport shell { argv: ["sh", "-c", "{script}"] }
    exit {
      0 => Unit
      nonzero => String "Script failed"
    }
    mock_response {
      0 => { exit_code: 0, exit_success: true, stdout: "(mock)", stderr: "" } "Mock shell execution"
    }
  }

  operation Check {
    input { command: String }
    output { exists: Bool from "exit_success" }
    readonly
    // `-l`: login-shell flag (bash/zsh); not POSIX sh — see file header.
    transport shell { argv: ["sh", "-c", "{command}"] }
    exit {
      0 => Unit
      nonzero => String "Command failed"
    }
    mock_response {
      0 => { exists: true } "Mock command check"
    }
  }
}
