// extdeps/shell/credentials.dag -- Shell-backed credential materializers.
//
// The realization handler for the agnostic `std.credentials.CredentialSource.EnvVar`
// source: acquire a credential by reading the named environment variable via the host
// shell. Per DESIGN.md §3 a transport/realization handler "sits peripheral (extdeps/),
// never in the interface" — std declares the source SHAPE, this module REALIZES it. Homed
// in extdeps (not gunbc.auth) because its consumer is the extdeps layer
// (extdeps.github.auth); gunbc is downstream, so a gunbc home would invert the import arrow.

module extdeps.shell.credentials

import extdeps.shell
import std.types { NonEmptyStr }

// Acquire a credential from an environment variable.
//
// Simplest materialization strategy: reads the named env var and
// returns its value as a Secret.
//
// Used by service-specific credential functions that still source
// credentials from the process environment.

pattern env_credential(env_var: NonEmptyStr) -> { token: Secret } {
  result = shell.Env.Get(name: env_var)
  return { token: result.value as Secret }
}
