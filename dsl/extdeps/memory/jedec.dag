// extdeps/memory/jedec.dag — JEDEC SDRAM generation catalog (cited spec authority).
//
// Per-generation monolithic die-density ceilings and standard document ids, as
// std.memory.types.JedecDdrGenerationCatalogRow values. JEDEC publishes the spec;
// it is an external dependency: it lives in extdeps/, importing the catalog SHAPE
// from std/memory. std/memory owns only the shape + the generation taxonomy; it does
// not carry cited JEDEC document ids or per-generation ceiling magnitudes.
//
// Dispatch lives here (DESIGN §3: product → cited catalog row → std projection).

module extdeps.memory.jedec

import std.measure { byte_size }
import std.memory.types {
  Ddr4,
  Ddr5,
  DdrGeneration,
  JedecDdrGenerationCatalogRow,
}

// JESD79-4 (DDR4 SDRAM): monolithic device densities 2/4/8/16 Gbit; 16 Gbit = 2 GiB max.
// Anchor: JEDEC JESD79-4 § device density organization.
data ddr4_generation_catalog: JedecDdrGenerationCatalogRow = JedecDdrGenerationCatalogRow {
  generation: Ddr4,
  max_monolithic_die_density: byte_size(count: 2147483648),
  jedec_standard: "JESD79-4",
}

// JESD79-5 (DDR5 SDRAM): monolithic device densities up to 64 Gbit; 64 Gbit = 8 GiB max.
// Anchor: JEDEC JESD79-5 § device density organization.
data ddr5_generation_catalog: JedecDdrGenerationCatalogRow = JedecDdrGenerationCatalogRow {
  generation: Ddr5,
  max_monolithic_die_density: byte_size(count: 8589934592),
  jedec_standard: "JESD79-5",
}

fn jedec_ddr_generation_catalog_row(generation: DdrGeneration) -> JedecDdrGenerationCatalogRow {
  match generation {
    Ddr4 => ddr4_generation_catalog
    Ddr5 => ddr5_generation_catalog
  }
}
