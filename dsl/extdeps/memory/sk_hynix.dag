// extdeps/memory/sk_hynix.dag — SK Hynix DDR4 module catalog (vendor data authority).
//
// SK Hynix's published DDR4 modules, as std.memory DramModuleCatalogRow values.
// Vendor hardware is an external dependency: it lives in extdeps/, importing the
// catalog SHAPE from std/memory. std/memory owns only the shape + the manufacturer
// taxonomy; it does not enumerate any one vendor's parts. Which specific modules a
// given host is populated with is an operator deployment fact (ctrl), not a fact
// about SK Hynix.
//
// Operator DIMMs: HMA82GR7AFR4N-VK 16GB PC4-21300 @ 2666 MT/s.

module extdeps.memory.sk_hynix

import std.measure { ByteSize, byte_size }
import std.memory.types { DramModuleCatalogRow }

// 16 GiB per stick (1×16GB).
data stick_capacity_bytes: ByteSize = byte_size(17179869184)

// Marketplace listing: "SK Hynix 16GB PC4-21300 (1x16GB) DDR4 Server RAM".
data hma82gr7afr4n_vk_server_catalog: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "HMA82GR7AFR4N-VK",
  manufacturer: SkHynix,
  capacity_bytes: stick_capacity_bytes,
  ddr4_pc4_class: "PC4-21300",
  data_rate_mts: 2666,
  ecc: true,
  registered: true,
  rank_label: "server",
}

// Marketplace listing: "SK hynix 16GB PC4-21300 DDR4-2666MHz ECC REG Single Rank".
data hma82gr7afr4n_vk_ecc_reg_single_rank_catalog: DramModuleCatalogRow = DramModuleCatalogRow {
  part_number: "HMA82GR7AFR4N-VK",
  manufacturer: SkHynix,
  capacity_bytes: stick_capacity_bytes,
  ddr4_pc4_class: "PC4-21300",
  data_rate_mts: 2666,
  ecc: true,
  registered: true,
  rank_label: "ecc_reg_single_rank",
}
