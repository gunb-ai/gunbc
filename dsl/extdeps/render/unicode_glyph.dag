module extdeps.render.unicode_glyph

import std.unicode {}

type UnicodeGlyph = String where brand("UnicodeGlyph")

fn unicode_glyph(text: String) -> UnicodeGlyph {
  text
}

fn unicode_glyph_text(g: UnicodeGlyph) -> String {
  g
}
