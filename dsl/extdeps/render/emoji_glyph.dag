// extdeps/render/emoji_glyph.dag — Emoji-tier glyph carrier (UTS #51).
//
// Anchor: https://www.unicode.org/reports/tr51/ (UTS #51 Unicode Emoji)
//
// dissolve-on: Q-Regex UTS #51 emoji-sequence validity.

module extdeps.render.emoji_glyph

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.unicode.org/reports/tr51/"
  }
}

type EmojiGlyph = String where brand("EmojiGlyph")

fn emoji_glyph(text: String) -> EmojiGlyph {
  text
}

fn emoji_glyph_text(g: EmojiGlyph) -> String {
  g
}
