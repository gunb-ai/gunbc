module extdeps.render.emoji_glyph

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.unicode.org/reports/tr51/"
  }
}

type EmojiGlyph = String where brand("EmojiGlyph")

fn emoji_glyph(text: String) -> EmojiGlyph {
  text
}

fn emoji_glyph_text(g: EmojiGlyph) -> String {
  g
}
