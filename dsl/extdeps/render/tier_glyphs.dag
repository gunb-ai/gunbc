module extdeps.render.tier_glyphs

import extdeps.render.ascii_glyph { AsciiGlyph, ascii_glyph_text }
import extdeps.render.emoji_glyph { EmojiGlyph, emoji_glyph_text }
import extdeps.render.unicode_glyph { UnicodeGlyph, unicode_glyph_text }
import std.symbols { Tier }

type TierGlyphs {
  ascii: AsciiGlyph
  unicode: UnicodeGlyph
  emoji: EmojiGlyph
}

fn glyphs_for_tiers(emoji: EmojiGlyph, unicode: UnicodeGlyph, ascii: AsciiGlyph) -> TierGlyphs {
  { emoji: emoji, unicode: unicode, ascii: ascii }
}

fn glyph_at(glyphs: TierGlyphs, tier: Tier) -> String {
  match tier {
    Emoji   => emoji_glyph_text(g: glyphs.emoji)
    Unicode => unicode_glyph_text(g: glyphs.unicode)
    Ascii   => ascii_glyph_text(g: glyphs.ascii)
  }
}
