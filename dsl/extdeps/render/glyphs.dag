  { id: DataSecret,       glyphs: glyphs_for_tiers(emoji: glyph(text: "🔒"),  unicode: glyph(text: "✱"),    ascii: glyph(text: "[*]")),  color: Warning },
  { id: DataUrl,          glyphs: glyphs_for_tiers(emoji: glyph(text: "🔗"),  unicode: glyph(text: "↗"),    ascii: glyph(text: "[U]")),  color: Info    },
  { id: DataTimer,        glyphs: glyphs_for_tiers(emoji: glyph(text: "⏱"),  unicode: glyph(text: "◷"),  ascii: glyph(text: "[T]")),  color: Dim     },

  { id: ConnectorHorizontal,      glyphs: glyphs_for_tiers(emoji: glyph(text: "─"), unicode: glyph(text: "─"), ascii: glyph(text: "--")), color: Dim },
  { id: ConnectorVertical,        glyphs: glyphs_for_tiers(emoji: glyph(text: "│"),  unicode: glyph(text: "│"),  ascii: glyph(text: "|")),  color: Dim },
  { id: ConnectorTeeDown,         glyphs: glyphs_for_tiers(emoji: glyph(text: "┬"),  unicode: glyph(text: "┬"),  ascii: glyph(text: "+")),  color: Dim },
  { id: ConnectorTeeUp,           glyphs: glyphs_for_tiers(emoji: glyph(text: "┴"),  unicode: glyph(text: "┴"),  ascii: glyph(text: "+")),  color: Dim },
  { id: ConnectorCornerBottomLeft, glyphs: glyphs_for_tiers(emoji: glyph(text: "╰"),  unicode: glyph(text: "╰"),  ascii: glyph(text: "+")), color: Dim },
  { id: ConnectorCornerTopLeft,    glyphs: glyphs_for_tiers(emoji: glyph(text: "╭"),  unicode: glyph(text: "╭"),  ascii: glyph(text: "+")), color: Dim },

  { id: BoxHorizontal,          glyphs: glyphs_for_tiers(emoji: glyph(text: "─"), unicode: glyph(text: "─"), ascii: glyph(text: "-")), color: Dim },
  { id: BoxVertical,            glyphs: glyphs_for_tiers(emoji: glyph(text: "│"), unicode: glyph(text: "│"), ascii: glyph(text: "|")), color: Dim },
  { id: BoxCornerTopLeft,       glyphs: glyphs_for_tiers(emoji: glyph(text: "┌"), unicode: glyph(text: "┌"), ascii: glyph(text: "+")), color: Dim },
  { id: BoxCornerTopRight,      glyphs: glyphs_for_tiers(emoji: glyph(text: "┐"), unicode: glyph(text: "┐"), ascii: glyph(text: "+")), color: Dim },
  { id: BoxCornerBottomLeft,    glyphs: glyphs_for_tiers(emoji: glyph(text: "└"), unicode: glyph(text: "└"), ascii: glyph(text: "+")), color: Dim },
  { id: BoxCornerBottomRight,   glyphs: glyphs_for_tiers(emoji: glyph(text: "┘"), unicode: glyph(text: "┘"), ascii: glyph(text: "+")), color: Dim }
]

fn lookup_symbol_entry(id: SymbolId) -> SymbolEntry? {
  fold(standard_symbols,
    init: none,
    f: (acc, e) => match acc {
      Present { value: _ } => acc
      Absent =>
        if e.id == id {
          Present { value: e }
        } else {
          none
        }
    }
  )
}

fn resolve_symbol(id: SymbolId, tier: Tier) -> String? {
  match lookup_symbol_entry(id: id) {
    Present { value: entry } => Present { value: glyph_at(glyphs: entry.glyphs, tier: tier) }
    Absent => none
  }
}

fn symbol_color(id: SymbolId) -> SemanticColor? {
  match lookup_symbol_entry(id: id) {
    Present { value: entry } => Present { value: entry.color }
    Absent => none
  }
}
