// extdeps/render/glyphs.dag — Glyph realization table + encoding-tier dispatch.
//
// Project visual vocabulary: three-tier encodings (Emoji / Unicode / Ascii) per
// SymbolId. Dispatch lives in extdeps/, not std/ (DESIGN.md §3): std.symbols
// owns only the agnostic glyph identity and SymbolEntry shape.

module extdeps.render.glyphs

import std.symbols { SemanticColor, SymbolEntry, SymbolId, Tier }

// --- Standard symbol set ---
//
// The canonical symbol table. Each entry maps a SymbolId to its
// three-tier visual encoding and semantic color.

data standard_symbols: List<SymbolEntry> = [
  // Node lifecycle
  // NOTE: emoji/unicode tiers collapsed to ASCII -- restore when tokenizer handles UTF-8
  { id: NodePending,      emoji: "[ ]", unicode: "o",   ascii: "[ ]", color: Dim     },
  { id: NodeRunning,      emoji: "[~]", unicode: "O",   ascii: "[~]", color: Active  },
  { id: NodeCompleted,    emoji: "[x]", unicode: "*",   ascii: "[x]", color: Success },
  { id: NodeFailed,       emoji: "[!]", unicode: "x",   ascii: "[!]", color: Error   },
  { id: NodeSkipped,      emoji: "[-]", unicode: "o",   ascii: "[-]", color: Dim     },
  { id: NodeIntercepted,  emoji: "[m]", unicode: "<>",  ascii: "[m]", color: Info    },

  // Edge states
  { id: EdgeIdle,         emoji: "-",   unicode: "-",   ascii: "-",   color: Dim     },
  { id: EdgeFlowing,      emoji: "=",   unicode: "=",   ascii: "=",   color: Accent  },
  { id: EdgeDone,         emoji: "-",   unicode: "-",   ascii: "-",   color: Success },
  { id: EdgeDead,         emoji: ".",   unicode: ".",   ascii: ".",   color: Dim     },

  // DAG phases
  { id: DagNotStarted,    emoji: "[ ]", unicode: "[ ]", ascii: "[ ]", color: Dim     },
  { id: DagRunning,       emoji: "[>]", unicode: ">",   ascii: "[>]", color: Active  },
  { id: DagCompleted,     emoji: "[X]", unicode: "#",   ascii: "[X]", color: Success },
  { id: DagFailed,        emoji: "[!]", unicode: "#",   ascii: "[!]", color: Error   },

  // Structural
  { id: BoundaryMarker,   emoji: "[B]", unicode: "<>",  ascii: "[B]", color: Info    },

  // Spinners (ASCII fallback -- restore braille when tokenizer handles UTF-8)
  { id: Spinner0,         emoji: "|",   unicode: "|",   ascii: "|",   color: Active  },
  { id: Spinner1,         emoji: "/",   unicode: "/",   ascii: "/",   color: Active  },
  { id: Spinner2,         emoji: "-",   unicode: "-",   ascii: "-",   color: Active  },
  { id: Spinner3,         emoji: "\\",  unicode: "\\",  ascii: "\\",  color: Active  },
  { id: Spinner4,         emoji: "|",   unicode: "|",   ascii: "|",   color: Active  },
  { id: Spinner5,         emoji: "/",   unicode: "/",   ascii: "/",   color: Active  },
  { id: Spinner6,         emoji: "-",   unicode: "-",   ascii: "-",   color: Active  },
  { id: Spinner7,         emoji: "\\",  unicode: "\\",  ascii: "\\",  color: Active  },
  { id: Spinner8,         emoji: "|",   unicode: "|",   ascii: "|",   color: Active  },
  { id: Spinner9,         emoji: "/",   unicode: "/",   ascii: "/",   color: Active  },

  // Status indicators
  { id: StatusSuccess,    emoji: "OK",   unicode: "v",    ascii: "OK",   color: Success },
  { id: StatusFailure,    emoji: "FAIL", unicode: "x",    ascii: "FAIL", color: Error   },
  { id: StatusWarning,    emoji: "WARN", unicode: "!",    ascii: "WARN", color: Warning },
  { id: StatusInfo,       emoji: "INFO", unicode: "i",    ascii: "INFO", color: Info    },

  // Data type indicators
  { id: DataList,         emoji: "[L]",  unicode: "=",    ascii: "[L]",  color: Default },
  { id: DataMap,          emoji: "[M]",  unicode: "[+]",  ascii: "[M]",  color: Default },
  { id: DataSecret,       emoji: "[*]",  unicode: "*",    ascii: "[*]",  color: Warning },
  { id: DataUrl,          emoji: "[U]",  unicode: ">",    ascii: "[U]",  color: Info    },
  { id: DataTimer,        emoji: "[T]",  unicode: "[T]",  ascii: "[T]",  color: Dim     },

  // Connectors
  { id: ConnectorHorizontal,      emoji: "--", unicode: "--", ascii: "--", color: Dim },
  { id: ConnectorVertical,        emoji: "|",  unicode: "|",  ascii: "|",  color: Dim },
  { id: ConnectorTeeDown,         emoji: "+",  unicode: "+",  ascii: "+",  color: Dim },
  { id: ConnectorTeeUp,           emoji: "+",  unicode: "+",  ascii: "+",  color: Dim },
  { id: ConnectorCornerBottomLeft, emoji: "+",  unicode: "+",  ascii: "+",  color: Dim },
  { id: ConnectorCornerTopLeft,    emoji: "+",  unicode: "+",  ascii: "+",  color: Dim }
]

// Lookup via fold + structural == (filter+field-equality hits a v1 interpreter bug).
fn lookup_symbol_entry(id: SymbolId) -> SymbolEntry? {
  fold(standard_symbols,
    init: none,
    f: (acc, e) => match acc {
      Present { value: _ } => acc
      Absent =>
        if e.id == id {
          Present { value: e }
        } else {
          none
        }
    }
  )
}

fn resolve_symbol(id: SymbolId, tier: Tier) -> String? {
  match lookup_symbol_entry(id: id) {
    Present { value: entry } =>
      match tier {
        Emoji   => Present { value: entry.emoji }
        Unicode => Present { value: entry.unicode }
        Ascii   => Present { value: entry.ascii }
      }
    Absent => none
  }
}

fn symbol_color(id: SymbolId) -> SemanticColor? {
  match lookup_symbol_entry(id: id) {
    Present { value: entry } => Present { value: entry.color }
    Absent => none
  }
}
