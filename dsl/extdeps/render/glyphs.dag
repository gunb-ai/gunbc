  { id: BoundaryMarker,   glyphs: glyphs_for_tiers(emoji: glyph(text: "◆"),  unicode: glyph(text: "◆"),  ascii: glyph(text: "[B]")), color: Info    },

  { id: Spinner0,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠋"),   unicode: glyph(text: "⠋"),   ascii: glyph(text: "|")),   color: Active  },
  { id: Spinner1,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠙"),   unicode: glyph(text: "⠙"),   ascii: glyph(text: "/")),   color: Active  },
  { id: Spinner2,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠹"),   unicode: glyph(text: "⠹"),   ascii: glyph(text: "-")),   color: Active  },
  { id: Spinner3,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠸"),   unicode: glyph(text: "⠸"),   ascii: glyph(text: "\\")),  color: Active  },
  { id: Spinner4,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠼"),   unicode: glyph(text: "⠼"),   ascii: glyph(text: "|")),   color: Active  },
  { id: Spinner5,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠴"),   unicode: glyph(text: "⠴"),   ascii: glyph(text: "/")),   color: Active  },
  { id: Spinner6,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠦"),   unicode: glyph(text: "⠦"),   ascii: glyph(text: "-")),   color: Active  },
  { id: Spinner7,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠧"),   unicode: glyph(text: "⠧"),   ascii: glyph(text: "\\")),  color: Active  },
  { id: Spinner8,         glyphs: glyphs_for_tiers(emoji: glyph(text: "⠇"),   unicode: glyph(text: "⠇"),   ascii: glyph(text: "|")),   color: Active  },
