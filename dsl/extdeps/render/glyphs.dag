// extdeps/render/glyphs.dag — Glyph realization table + encoding-tier dispatch.
//
// Project visual vocabulary: three-tier encodings (Emoji / Unicode / Ascii) per
// SymbolId. Dispatch lives in extdeps/, not std/ (DESIGN.md §3): std.symbols
// owns only the agnostic glyph identity and SymbolEntry shape.

module extdeps.render.glyphs

import std.symbols { SemanticColor, SymbolEntry, SymbolId, Tier }

// --- Standard symbol set ---
//
// The canonical symbol table. Each entry maps a SymbolId to its
// three-tier visual encoding and semantic color.

data standard_symbols: List<SymbolEntry> = [
  // Node lifecycle
  // NOTE: emoji/unicode tiers collapsed to ASCII -- restore when tokenizer handles UTF-8
  { id: NodePending,      glyphs: { Emoji: "[ ]", Unicode: "o",   Ascii: "[ ]" }, color: Dim     },
  { id: NodeRunning,      glyphs: { Emoji: "[~]", Unicode: "O",   Ascii: "[~]" }, color: Active  },
  { id: NodeCompleted,    glyphs: { Emoji: "[x]", Unicode: "*",   Ascii: "[x]" }, color: Success },
  { id: NodeFailed,       glyphs: { Emoji: "[!]", Unicode: "x",   Ascii: "[!]" }, color: Error   },
  { id: NodeSkipped,      glyphs: { Emoji: "[-]", Unicode: "o",   Ascii: "[-]" }, color: Dim     },
  { id: NodeIntercepted,  glyphs: { Emoji: "[m]", Unicode: "<>",  Ascii: "[m]" }, color: Info    },

  // Edge states
  { id: EdgeIdle,         glyphs: { Emoji: "-",   Unicode: "-",   Ascii: "-"   }, color: Dim     },
  { id: EdgeFlowing,      glyphs: { Emoji: "=",   Unicode: "=",   Ascii: "="   }, color: Accent  },
  { id: EdgeDone,         glyphs: { Emoji: "-",   Unicode: "-",   Ascii: "-"   }, color: Success },
  { id: EdgeDead,         glyphs: { Emoji: ".",   Unicode: ".",   Ascii: "."   }, color: Dim     },

  // DAG phases
  { id: DagNotStarted,    glyphs: { Emoji: "[ ]", Unicode: "[ ]", Ascii: "[ ]" }, color: Dim     },
  { id: DagRunning,       glyphs: { Emoji: "[>]", Unicode: ">",   Ascii: "[>]" }, color: Active  },
  { id: DagCompleted,     glyphs: { Emoji: "[X]", Unicode: "#",   Ascii: "[X]" }, color: Success },
  { id: DagFailed,        glyphs: { Emoji: "[!]", Unicode: "#",   Ascii: "[!]" }, color: Error   },

  // Structural
  { id: BoundaryMarker,   glyphs: { Emoji: "[B]", Unicode: "<>",  Ascii: "[B]" }, color: Info    },

  // Spinners (ASCII fallback -- restore braille when tokenizer handles UTF-8)
  { id: Spinner0,         glyphs: { Emoji: "|",   Unicode: "|",   Ascii: "|"   }, color: Active  },
  { id: Spinner1,         glyphs: { Emoji: "/",   Unicode: "/",   Ascii: "/"   }, color: Active  },
  { id: Spinner2,         glyphs: { Emoji: "-",   Unicode: "-",   Ascii: "-"   }, color: Active  },
  { id: Spinner3,         glyphs: { Emoji: "\\",  Unicode: "\\",  Ascii: "\\"  }, color: Active  },
  { id: Spinner4,         glyphs: { Emoji: "|",   Unicode: "|",   Ascii: "|"   }, color: Active  },
  { id: Spinner5,         glyphs: { Emoji: "/",   Unicode: "/",   Ascii: "/"   }, color: Active  },
  { id: Spinner6,         glyphs: { Emoji: "-",   Unicode: "-",   Ascii: "-"   }, color: Active  },
  { id: Spinner7,         glyphs: { Emoji: "\\",  Unicode: "\\",  Ascii: "\\"  }, color: Active  },
  { id: Spinner8,         glyphs: { Emoji: "|",   Unicode: "|",   Ascii: "|"   }, color: Active  },
  { id: Spinner9,         glyphs: { Emoji: "/",   Unicode: "/",   Ascii: "/"   }, color: Active  },

  // Status indicators
  { id: StatusSuccess,    glyphs: { Emoji: "OK",   Unicode: "v",    Ascii: "OK"   }, color: Success },
  { id: StatusFailure,    glyphs: { Emoji: "FAIL", Unicode: "x",    Ascii: "FAIL" }, color: Error   },
  { id: StatusWarning,    glyphs: { Emoji: "WARN", Unicode: "!",    Ascii: "WARN" }, color: Warning },
  { id: StatusInfo,       glyphs: { Emoji: "INFO", Unicode: "i",    Ascii: "INFO" }, color: Info    },

  // Data type indicators
  { id: DataList,         glyphs: { Emoji: "[L]",  Unicode: "=",    Ascii: "[L]"  }, color: Default },
  { id: DataMap,          glyphs: { Emoji: "[M]",  Unicode: "[+]",  Ascii: "[M]"  }, color: Default },
  { id: DataSecret,       glyphs: { Emoji: "[*]",  Unicode: "*",    Ascii: "[*]"  }, color: Warning },
  { id: DataUrl,          glyphs: { Emoji: "[U]",  Unicode: ">",    Ascii: "[U]"  }, color: Info    },
  { id: DataTimer,        glyphs: { Emoji: "[T]",  Unicode: "[T]",  Ascii: "[T]"  }, color: Dim     },

  // Connectors
  { id: ConnectorHorizontal,      glyphs: { Emoji: "--", Unicode: "--", Ascii: "--" }, color: Dim },
  { id: ConnectorVertical,        glyphs: { Emoji: "|",  Unicode: "|",  Ascii: "|"  }, color: Dim },
  { id: ConnectorTeeDown,         glyphs: { Emoji: "+",  Unicode: "+",  Ascii: "+"  }, color: Dim },
  { id: ConnectorTeeUp,           glyphs: { Emoji: "+",  Unicode: "+",  Ascii: "+"  }, color: Dim },
  { id: ConnectorCornerBottomLeft, glyphs: { Emoji: "+",  Unicode: "+",  Ascii: "+"  }, color: Dim },
  { id: ConnectorCornerTopLeft,    glyphs: { Emoji: "+",  Unicode: "+",  Ascii: "+"  }, color: Dim }
]

// Lookup via fold + structural == (filter+field-equality hits a v1 interpreter bug).
fn lookup_symbol_entry(id: SymbolId) -> SymbolEntry? {
  fold(standard_symbols,
    init: none,
    f: (acc, e) => match acc {
      Present { value: _ } => acc
      Absent =>
        if e.id == id {
          Present { value: e }
        } else {
          none
        }
    }
  )
}

fn resolve_symbol(id: SymbolId, tier: Tier) -> String? {
  match lookup_symbol_entry(id: id) {
    Present { value: entry } => map_get(entry.glyphs, tier)
    Absent => none
  }
}

fn symbol_color(id: SymbolId) -> SemanticColor? {
  match lookup_symbol_entry(id: id) {
    Present { value: entry } => Present { value: entry.color }
    Absent => none
  }
}
