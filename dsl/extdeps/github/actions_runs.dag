// extdeps/github/actions_runs.dag -- GitHub Actions workflow-run jobs API (timings).
//
// Spec: https://docs.github.com/en/rest/actions/workflow-jobs
// API version: 2022-11-28 (X-GitHub-Api-Version header)
// Endpoints modeled:
//   GET /repos/{owner}/{repo}/actions/runs/{run_id}/jobs   (ListWorkflowRunJobs)
//
// This is the SERVICE file (REST transport ops), sibling to extdeps/github/pulls.dag.
// The type-only platform model lives in extdeps/github/actions.dag and is NOT touched
// here: actions.dag's `Job` is the workflow-AUTHORING shape (steps/runner for emitting
// YAML); the records below are the runtime API RESPONSE shape (a job-run instance with
// timing), a distinct concept that attaches to the service like pulls.dag's PullRequest.
//
// Consumers:
//   gunbc affected-set CI timings driver -- projects job wall-clock into the
//   affected-set-ci-receipt (actual_run_minutes / wall_clock_by_job).

module extdeps.github.actions_runs

import extdeps.github.github { default_api_base }
import std.types { Timestamp, Url, Secret }
import extdeps.github.errors { GitHubErrorShape }
import std.credentials { EnvVar }

// -- Workflow-run job model (API response shape) ----------------------

// One step within a job run; carries its own wall-clock window.
type WorkflowJobStep {
  name: String
  status: String
  conclusion: String?
  number: Int
  started_at: Timestamp?
  completed_at: Timestamp?
}

// A single job run instance for a workflow run. started_at/completed_at are the
// wall-clock window the timings aggregator projects into wall_clock_by_job.
type WorkflowRunJob {
  id: Int
  name: String
  status: String
  conclusion: String?
  started_at: Timestamp?
  completed_at: Timestamp?
  html_url: Url?
  steps: List<WorkflowJobStep>
}

// -- Service: REST transport wiring -----------------------------------

service github.Actions {
  config {
    // Inlined literal, NOT `default_api_base`: the runtime endpoint resolver
    // (find_service_config_string) only reads a string LITERAL or falls back to
    // the authored identifier name -- a `data` constant reference resolves to the
    // bare name "default_api_base", producing a base-less URL. default_api_base
    // (extdeps.github.github) remains the documented authority for this value.
    endpoint: "https://api.github.com"
    auth: Bearer
    auth_source: EnvVar { name: "GITHUB_TOKEN" }
    // GitHub API rate limits: 5000 requests/hour for authenticated users.
    rate_limit: { requests: 5000, per: hour, scope: core }
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 504] }
  }

  // GET /repos/{owner}/{repo}/actions/runs/{run_id}/jobs
  // Response is an object { total_count, jobs: [...] }; the output field `jobs`
  // direct-key-maps the `jobs` array (field name matches the JSON key, so no
  // `from` pointer is needed). Each job's JSON keys align with WorkflowRunJob.
  operation ListWorkflowRunJobs {
    input {
      auth_token: Secret
      owner: String
      repo: String
      run_id: Int
      per_page: Int = 100
    }
    output {
      jobs: List<WorkflowRunJob>
    }
    readonly
    // Authorization is auto-injected from auth_source (Bearer) -- do NOT hand-set
    // it. The Accept / X-GitHub-Api-Version best-practice headers are omitted: the
    // parser rejects string-literal property keys (only identifiers parse) and
    // header names with hyphens are not identifiers, so they cannot be expressed as
    // individual transport props today. GitHub returns JSON without them.
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/jobs",
      query: { per_page: per_page }
    }
    response {
      200 => List<WorkflowRunJob>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      200 => [] "No jobs for this run"
    }
  }
}
