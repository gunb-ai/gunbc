// extdeps/github/auth.dag -- GitHub credential acquisition.
//
// Delegates to std.credentials.env_credential for materialization.
// Service-specific knowledge (which env var, which scopes) stays here;
// materialization mechanics are in std.credentials.

module extdeps.github.auth

import std.credentials { env_credential }
import std.resources { Network }
import std.types { NonEmptyStr }

func github_token(
  project_id: NonEmptyStr = "gunbai-secrets",
  secret_name: NonEmptyStr = "github-token"
) -> { token: Secret }
  uses net: Network
{
  cred = env_credential(env_var: "GITHUB_TOKEN")
  return { token: cred.token }
}
