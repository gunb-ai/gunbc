// extdeps/github/auth.dag -- GitHub credential acquisition.
//
// Delegates to gunbc.auth.credentials for concrete materialization.
// Service-specific knowledge (which secret, which scopes) stays here;
// materialization mechanics live in gunbc.auth.

module extdeps.github.auth

import extdeps.github.github { GitHubAuthToken, GitHubScope, ScopeGist, ScopeRepo }
import std.credentials { CredentialSource, EnvVar, env_credential }
import std.types { NonEmptyStr, Timestamp }

data default_github_auth_source: CredentialSource = EnvVar { name: "GITHUB_TOKEN" }

data default_github_token_scopes: List<GitHubScope> = [ScopeRepo, ScopeGist]

data default_github_token_expires_at: Timestamp? = None

func github_token() -> GitHubAuthToken
{
  cred = match default_github_auth_source {
    EnvVar { name } => env_credential(env_var: name as NonEmptyStr)
  }
  return {
    token: cred.token,
    scopes: default_github_token_scopes,
    expires_at: default_github_token_expires_at
  }
}
