// extdeps/github/issues.dag -- "What is a GitHub Issue?"
//
// The issue resource model: states, labels, events, comments, timeline.
// This is the raw GitHub model. The SDLC lifecycle stage model
// (IssueLifecycleStage) lives in std/types.dag and maps onto this.
//
// Consumers:
//   funcs/sdlc_stages.dag                  — stage handler logic
//   extdeps/github/pull_requests.dag       — cross-reference

module extdeps.github.issues

import extdeps.github.core { GitHubUser }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}
import std.types { TrackedIssue, IssueState, IssueLifecycleStage, NonEmptyStr, Url, Timestamp }
import std.errors { GitHubErrorShape }

// ── Issue model ───────────────────────────────────────────────────

type GitHubIssueState = Open | Closed

type Label {
  id: Int
  name: String
  color: String
  description: String?
}

type GitHubIssue {
  id: Int
  number: Int
  title: String
  body: String?
  state: GitHubIssueState
  state_reason: String?
  labels: List<Label>
  user: String
  created_at: Timestamp
  updated_at: Timestamp
  closed_at: Timestamp?
  url: String
}

// ── Comments ──────────────────────────────────────────────────────

type IssueComment {
  id: Int
  body: String
  user: String
  created_at: Timestamp
  updated_at: Timestamp
}

// ── Events & timeline ─────────────────────────────────────────────

type IssueEventType
  = Labeled
  | Unlabeled
  | IssueClosed
  | Reopened
  | Assigned
  | Unassigned
  | Milestoned
  | Commented

type IssueEvent {
  id: Int
  event: IssueEventType
  actor: String
  created_at: Timestamp
}

// ── Filters ───────────────────────────────────────────────────────

type IssueFilter
  = ByState { state: GitHubIssueState }
  | ByLabel { label: String }
  | ByAssignee { login: String }

// ── State machine ─────────────────────────────────────────────────

// state_reason values: "completed", "not_planned", "reopened".
// Distinguishes successful completion from intentional abandonment.
type IssueStateTransition {
  from: GitHubIssueState
  to: GitHubIssueState
  action: String
  state_reason: String?
}

data state_transitions: List<IssueStateTransition> = [
  { from: Open, to: Closed, action: "close", state_reason: "completed" },
  { from: Open, to: Closed, action: "close_not_planned", state_reason: "not_planned" },
  { from: Closed, to: Open, action: "reopen", state_reason: "reopened" }
]

// ── Operation behaviors ───────────────────────────────────────────

type IssueOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<IssueOperationBehavior> = [
  {
    operation: "create",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "ValidationError", condition: "invalid_input", http_status: 422, recoverable: false, retry_safe: false },
        { name: "AuthError", condition: "insufficient_scopes", http_status: 401, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "repo write access", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "get",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "issue_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "repo read access", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "close",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["issue_number"],
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "issue_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "closing an already-closed issue is a no-op", trigger: "already_closed", severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "repo write access", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "comment",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "issue_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "repo write access", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "list_events",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "issue_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "repo read access", kind: Capability }],
      assumptions: ["Timeline events are ordered chronologically"],
      unknowns: ["Whether deleted labels appear in timeline"]
    }
  }
]

// ── Service: REST transport wiring ──────────────────────────────

service github.Issues {
  config {
    endpoint: "https://api.github.com"
    auth: BearerToken
    auth_input: auth_token
    // GitHub API rate limits: 5000 requests/hour for authenticated users
    rate_limit: { requests: 5000, per: hour, scope: core }
    // Retry on rate limit and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 504] }
  }

  // --- Core CRUD ---------------------------------------------------------

  operation create {
    input {
      auth_token: Secret
      title: NonEmptyStr
      body: String
      labels: List<String>
    }
    output {
      issue: TrackedIssue from "."
    }
    transport rest { method: POST, path: "/repos/\{owner\}/\{repo\}/issues" }
    response {
      201 => TrackedIssue
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation get {
    input {
      auth_token: Secret
      id: NonEmptyStr
    }
    output {
      issue: TrackedIssue from "."
      found: Bool from "status == 200"
    }
    readonly
    transport rest { method: GET, path: "/repos/\{owner\}/\{repo\}/issues/\{id\}" }
    response {
      200 => TrackedIssue
      301 => GitHubErrorShape
      404 => GitHubErrorShape
      410 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation close {
    input {
      auth_token: Secret
      id: NonEmptyStr
    }
    output {
      ok: Bool from "state == \"closed\""
    }
    transport rest { method: PATCH, path: "/repos/\{owner\}/\{repo\}/issues/\{id\}" }
    response {
      200 => TrackedIssue
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  // --- Comments ----------------------------------------------------------
  // Comments are the artifact carrier: designs, reviews, and reports
  // are posted as issue comments with structured markdown.

  operation comment {
    input {
      auth_token: Secret
      id: NonEmptyStr
      body: String
      marker: NonEmptyStr?
    }
    output {
      comment_id: NonEmptyStr from "id"
      ok: Bool from "id != 0"
    }
    transport rest { method: POST, path: "/repos/\{owner\}/\{repo\}/issues/\{id\}/comments" }
    response {
      201 => IssueComment
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  // --- Labels (lifecycle stage transitions) ------------------------------
  // Labels encode the issue lifecycle stage. Transitions are:
  //   idea → design → design-review → accepted → implementing →
  //   code-review → testing → done

  operation set_labels {
    input {
      auth_token: Secret
      id: NonEmptyStr
      labels: List<String>
    }
    output {
      ok: Bool from "status == 200"
    }
    idempotent
    transport rest { method: PUT, path: "/repos/\{owner\}/\{repo\}/issues/\{id\}/labels" }
    response {
      200 => List<Label>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  // --- Listing (for polling / batch processing) --------------------------

  operation discover {
    input {
      auth_token: Secret
      labels: List<String>
      state: IssueState? = Open
    }
    output {
      issues: List<TrackedIssue>
    }
    readonly
    transport rest { method: GET, path: "/repos/\{owner\}/\{repo\}/issues" }
    response {
      200 => List<TrackedIssue>
      301 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation list_events {
    input {
      auth_token: Secret
      id: NonEmptyStr
      since: String?
    }
    output {
      events: List<IssueEvent>
    }
    readonly
    transport rest { method: GET, path: "/repos/\{owner\}/\{repo\}/issues/\{id\}/events" }
    response {
      200 => List<IssueEvent>
      404 => GitHubErrorShape
      410 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }
}

// ── Tests ──────────────────────────────────────────────────────────

fixture github_auth {
    mock cloud_env.config -> { provider: "github", runtime: "local-dev" }
    mock cloud_env.credential -> { token: "<MOCK_GH_TOKEN>", source_type: "static", scheme: "bearer" }
}

test create_issue : github_auth {

    input create/prepare.auth_token -> "<MOCK_GH_TOKEN>"
    input create/prepare.owner -> "gunb-ai"
    input create/prepare.repo -> "gunbc"
    input create/prepare.title -> "Implement feature X"
    input create/prepare.body -> "## Problem\n\nWe need feature X.\n\n## Approach\n\nUse DAG composition."
    input create/prepare.labels -> ["idea"]

    mock create/execute.response -> rest_response(201, {
        number: 42,
        html_url: "https://github.com/gunb-ai/gunbc/issues/42",
        id: 1234567,
        node_id: "I_mock"
    })

    expect result.number == 42
    expect result.url contains "issues/42"
}

test add_comment : github_auth {

    input comment/prepare.auth_token -> "<MOCK_GH_TOKEN>"
    input comment/prepare.owner -> "gunb-ai"
    input comment/prepare.repo -> "gunbc"
    input comment/prepare.number -> 42
    input comment/prepare.body -> "## Design\n\nHere is the generated design..."

    mock comment/execute.response -> rest_response(201, {
        id: 999,
        html_url: "https://github.com/gunb-ai/gunbc/issues/42#issuecomment-999"
    })

    expect result.id == 999
}

test list_issues_by_label : github_auth {

    input list/prepare.auth_token -> "<MOCK_GH_TOKEN>"
    input list/prepare.owner -> "gunb-ai"
    input list/prepare.repo -> "gunbc"
    input list/prepare.labels -> "idea"
    input list/prepare.state -> "open"

    mock list/execute.response -> rest_response(200, [
        { number: 1, title: "Feature A", labels: [{ name: "idea" }], state: "open" },
        { number: 2, title: "Feature B", labels: [{ name: "idea" }], state: "open" }
    ])

    expect result.issues is List
}
