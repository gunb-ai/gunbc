// extdeps/github/gists.dag -- "What is a GitHub Gist?"
//
// Gist resource model: files, visibility, versions.
// Simpler than issues/PRs — gists are standalone code snippets.
//
// Consumers:
//   services/github/gist.dag — transport wiring
//   tools/gist.dag           — gist creation workflow

module extdeps.github.gists

import extdeps.github.core { GitHubUser }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Gist model ────────────────────────────────────────────────────

type GistVisibility = Public | GistSecret

type GistFile {
  filename: String
  content: String
  language: String?
  size: Int
}

type Gist {
  id: String
  description: String?
  public: Bool
  files: List<GistFile>
  owner: String
  created_at: String
  updated_at: String
  url: String
}

// ── Operation behaviors ───────────────────────────────────────────

type GistOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<GistOperationBehavior> = [
  {
    operation: "create",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "ValidationError", condition: "empty_files", http_status: 422, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "gist scope", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "get",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "gist_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [],
      assumptions: ["Public gists are readable without authentication"],
      unknowns: []
    }
  },
  {
    operation: "delete",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["gist_id"],
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "gist_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "deleting a gist is permanent and cannot be undone", trigger: "delete_confirmed", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "gist ownership", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
