// extdeps/github/gists.dag -- "What is a GitHub Gist?"
//
// Gist resource model: files, visibility, versions.
// Simpler than issues/PRs -- gists are standalone code snippets.
//
// Consumers:
//   shared/gist_modes.dag     -- gist operations
//   gunbc/tools/gist.dag  -- gist creation workflow

module extdeps.github.gists

import extdeps.github.github { GitHubUser, default_api_base }
import std.types { Timestamp, GistId, Url, HttpMethod, AuthScheme }
import extdeps.github.errors { GitHubErrorShape }

// -- Gist model ----------------------------------------------------

type GistFile {
  filename: String
  content: String
  language: String?
  size: Int
}

type Gist {
  id: String
  description: String?
  public: Bool
  files: Map<String, GistFile>
  owner: GitHubUser
  created_at: Timestamp
  updated_at: Timestamp
  html_url: Url
}

// -- Service: REST transport wiring ------------------------------

service github.Gist {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_input: auth_token
    // GitHub API rate limits: 5000 requests/hour for authenticated users
    rate_limit: { requests: 5000, per: hour, scope: core }
    // Retry on rate limit and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 504] }
  }

  operation Create {
    input {
      description: String
      filename: String
      content: String
      public: Bool = false
      auth_token: Secret
    }
    output {
      id: GistId
      html_url: Url
    }
    transport rest {
      method: POST,
      path: "/gists",
      body: {
        description: description,
        public: public,
        files: { "\{filename\}": { content: content } }
      }
    }
    response {
      201 => Gist
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      201 => {
        id: "gist-abc123",
        description: "Mock gist",
        public: false,
        files: { "snippet.rs": { filename: "snippet.rs", content: "fn main() {}", language: "Rust", size: 12 } },
        owner: { login: "mock-user", id: 12345, type: User },
        html_url: "https://gist.github.com/mock-user/gist-abc123",
        created_at: "2026-01-01T00:00:00Z",
        updated_at: "2026-01-01T00:00:00Z"
      } "Gist created successfully",
      401 => { message: "Bad credentials", documentation_url: "https://docs.github.com/rest" } "Invalid or missing auth token",
      403 => { message: "Forbidden", documentation_url: "https://docs.github.com/rest" } "Insufficient scopes",
      422 => { message: "Validation Failed", errors: [{ resource: "Gist", code: "missing_field", field: "files" }] } "Empty files rejected"
    }
  }
}
