module extdeps.github.pulls_contracts

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.serialization { CoproductWireContract, StringVariant, SnakeCase, ScreamingSnakeCase }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/pulls/pulls"
  }
}

data pull_request_state_wire_contract: CoproductWireContract = {
  coproduct: "PullRequestState",
  encoding: StringVariant { naming: SnakeCase }
}

data review_state_wire_contract: CoproductWireContract = {
  coproduct: "ReviewState",
  encoding: StringVariant { naming: ScreamingSnakeCase }
}

data review_event_wire_contract: CoproductWireContract = {
  coproduct: "ReviewEvent",
  encoding: StringVariant { naming: ScreamingSnakeCase }
}
