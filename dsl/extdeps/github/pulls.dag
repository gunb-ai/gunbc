// extdeps/github/pulls.dag -- GitHub Pull Requests API
//
// Spec: https://docs.github.com/en/rest/pulls/pulls
// API version: 2022-11-28 (X-GitHub-Api-Version header)
// Endpoints modeled:
//   GET  /repos/{owner}/{repo}/pulls                        (List)
//   GET  /repos/{owner}/{repo}/pulls/{pull_number}          (Get)
//   GET  /repos/{owner}/{repo}/pulls/{pull_number} [diff]   (Diff)
//   POST /repos/{owner}/{repo}/issues/{issue_number}/comments (CreateComment)
//
// PR comments use the Issues API because PRs are issues in GitHub's model.
//
// Consumers:
//   gunbc/tools/review.dag -- PR review workflow

module extdeps.github.pulls

import extdeps.github.github { GitHubUser }
import std.types { Timestamp, Url, HttpMethod, AuthScheme }
import std.errors { GitHubErrorShape }

// -- Pull request model -----------------------------------------------

type PullRequestState = PrOpen | PrClosed | PrMerged

type PullRequestRef {
  ref: String
  sha: String
  label: String
}

type PullRequest {
  number: Int
  title: String
  body: String?
  state: String
  html_url: String
  user: GitHubUser
  head: PullRequestRef
  base: PullRequestRef
  created_at: Timestamp
  updated_at: Timestamp
  merged_at: Timestamp?
  draft: Bool
}

type IssueComment {
  id: Int
  html_url: String
  body: String
  created_at: Timestamp
}

// -- Service: REST transport wiring -----------------------------------

service github.Pulls {
  config {
    endpoint: "https://api.github.com"
    auth: Bearer
    auth_input: auth_token
    // GitHub API rate limits: 5000 requests/hour for authenticated users
    rate_limit: { requests: 5000, per: hour, scope: core }
    // Retry on rate limit and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 504] }
  }

  operation List {
    input {
      auth_token: Secret
      owner: String
      repo: String
      state: String = "open"
      per_page: Int = 30
    }
    output {
      pulls: List<PullRequest>
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls",
      query: { state: state, per_page: per_page }
    }
    response {
      200 => List<PullRequest>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      200 => [
        {
          number: 42,
          title: "Add widget support",
          body: "Implements widget rendering",
          state: "open",
          html_url: "https://github.com/mock-owner/mock-repo/pull/42",
          user: { login: "mock-user", id: 1, type: "User" },
          head: { ref: "feature-widgets", sha: "abc1234def5678", label: "mock-user:feature-widgets" },
          base: { ref: "main", sha: "000aaa111bbb", label: "mock-owner:main" },
          created_at: "2026-03-01T10:00:00Z",
          updated_at: "2026-03-27T14:00:00Z",
          merged_at: null,
          draft: false
        }
      ] "List of open pull requests"
    }
  }

  operation Get {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      pr: PullRequest
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}"
    }
    response {
      200 => PullRequest
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      200 => {
        number: 42,
        title: "Add widget support",
        body: "Implements widget rendering",
        state: "open",
        html_url: "https://github.com/mock-owner/mock-repo/pull/42",
        user: { login: "mock-user", id: 1, type: "User" },
        head: { ref: "feature-widgets", sha: "abc1234def5678", label: "mock-user:feature-widgets" },
        base: { ref: "main", sha: "000aaa111bbb", label: "mock-owner:main" },
        created_at: "2026-03-01T10:00:00Z",
        updated_at: "2026-03-27T14:00:00Z",
        merged_at: null,
        draft: false
      } "Single pull request"
    }
  }

  operation Diff {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      diff: String
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}",
      headers: { "Accept": "application/vnd.github.diff" }
    }
    response {
      200 => String
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      200 => "diff --git a/src/main.rs b/src/main.rs\nindex abc1234..def5678 100644\n--- a/src/main.rs\n+++ b/src/main.rs\n@@ -1,3 +1,5 @@\n fn main() {\n+    println!(\"hello\");\n }" "Pull request diff"
    }
  }

  operation CreateComment {
    input {
      auth_token: Secret
      owner: String
      repo: String
      issue_number: Int
      body: String
    }
    output {
      id: Int from "id"
      html_url: String from "html_url"
    }
    transport rest {
      method: POST,
      path: "/repos/\{owner\}/\{repo\}/issues/\{issue_number\}/comments",
      body: { body: body }
    }
    response {
      201 => IssueComment
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      201 => {
        id: 99,
        html_url: "https://github.com/mock-owner/mock-repo/pull/42#issuecomment-99",
        body: "Review posted",
        created_at: "2026-03-27T15:00:00Z"
      } "Comment created on PR",
      401 => { message: "Bad credentials", documentation_url: "https://docs.github.com/rest" } "Invalid or missing auth token",
      404 => { message: "Not Found", documentation_url: "https://docs.github.com/rest" } "Repository or PR not found"
    }
  }

  // Spec: https://docs.github.com/en/rest/pulls/reviews
  // Stateless dedup: check if a review exists at a specific commit SHA.
  // Returns review count -- 0 means not yet reviewed at this commit.
  operation ListReviews {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      reviews: List<PullReview>
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews"
    }
    response {
      200 => List<PullReview>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      200 => [] "No reviews yet"
    }
  }

  // Spec: https://docs.github.com/en/rest/pulls/reviews#create-a-review
  // Posts a review with line-level comments. Idempotent when guarded
  // by ListReviews check (don't post if review at this SHA exists).
  operation CreateReview {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
      commit_id: String
      body: String
      event: String = "COMMENT"
      comments: Json
    }
    output {
      id: Int from "id"
      html_url: String from "html_url"
    }
    transport rest {
      method: POST,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews",
      body: { commit_id: commit_id, body: body, event: event, comments: comments }
    }
    response {
      200 => Json
      401 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      200 => { id: 1, html_url: "https://github.com/mock/pull/1#pullrequestreview-1" } "Review created"
    }
  }

  // Spec: https://docs.github.com/en/rest/pulls/comments
  // Lists review comments (line-level). Used for resolution checking.
  operation ListComments {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      comments: List<ReviewComment>
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/comments"
    }
    response {
      200 => List<ReviewComment>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
    mock_response {
      200 => [] "No comments"
    }
  }
}

// -- Review and comment types -----------------------------------------

type PullReview {
  id: Int
  body: String
  state: String
  commit_id: String
  html_url: String
}

type ReviewComment {
  id: Int
  node_id: String
  path: String
  line: Int?
  original_line: Int?
  body: String
  html_url: String
}
