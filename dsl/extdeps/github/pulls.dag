module extdeps.github.pulls

import extdeps.github.github { GitHubUser, default_api_base, default_per_page }
import std.types { CommitSha, FilePath, GitRef, Timestamp, Url, HttpMethod, AuthScheme }
import extdeps.github.errors { GitHubErrorShape }
import std.credentials { CredentialSource, EnvVar }
import std.serialization { WireFormat, Text, CoproductWireContract, StringVariant, SnakeCase, ScreamingSnakeCase }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/pulls/pulls"
  }
}

type PullRequestState = Open | Closed
data pull_request_state_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.github.pulls", decl_name: "PullRequestState", field: WholeDeclaration },
  encoding: StringVariant { naming: SnakeCase }
}

type ReviewState = Pending | Commented | Approved | ChangesRequested | Dismissed
data review_state_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.github.pulls", decl_name: "ReviewState", field: WholeDeclaration },
  encoding: StringVariant { naming: ScreamingSnakeCase }
}

type ReviewEvent = Approve | RequestChanges | Comment | Pending
data review_event_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.github.pulls", decl_name: "ReviewEvent", field: WholeDeclaration },
  encoding: StringVariant { naming: ScreamingSnakeCase }
}

type PullRequestRef {
  ref: GitRef
  sha: CommitSha
  label: String
}

type PullRequest {
  number: Int
  title: String
  body: String?
  state: PullRequestState
  html_url: Url
  user: GitHubUser
  head: PullRequestRef
  base: PullRequestRef
  created_at: Timestamp
  updated_at: Timestamp
  merged_at: Timestamp?
  draft: Bool
}

type IssueComment {
  id: Int
  html_url: Url
  body: String
  created_at: Timestamp
}

service github.Pulls {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_source: EnvVar { name: "GITHUB_TOKEN" }

    rate_limit: { requests: 5000, per: hour, scope: core }

    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 504] }
  }

  operation List {
    input {
      auth_token: Secret
      owner: String
      repo: String
      state: PullRequestState = Open
      per_page: Int = default_per_page
    }
    output {
      pulls: List<PullRequest>
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls",
      query: { state: state, per_page: per_page }
    }
    response {
      200 => List<PullRequest>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation Get {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      pr: PullRequest
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}"
    }
    response {
      200 => PullRequest
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation Diff {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      diff: String
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}",
      headers: { "Accept": "application/vnd.github.diff" },
      response_format: Text
    }
    response {
      200 => String
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation CreateComment {
    input {
      auth_token: Secret
      owner: String
      repo: String
      issue_number: Int
      body: String
    }
    output {
      id: Int from "id"
      html_url: Url from "html_url"
    }
    transport rest {
      method: POST,
      path: "/repos/\{owner\}/\{repo\}/issues/\{issue_number\}/comments",
      body: { body: body }
    }
    response {
      201 => IssueComment
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation ListReviews {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      reviews: List<PullReview>
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews"
    }
    response {
      200 => List<PullReview>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation CreateReview {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
      commit_id: CommitSha
      body: String
      event: ReviewEvent = Comment
      comments: Json
    }
    output {
      id: Int from "id"
      html_url: Url from "html_url"
    }
    transport rest {
      method: POST,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews",
      body: { commit_id: commit_id, body: body, event: event, comments: comments }
    }
    response {
      200 => PullReview
      401 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation ListComments {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      comments: List<ReviewComment>
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/comments"
    }
    response {
      200 => List<ReviewComment>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }
}

type PullReview {
  id: Int
  body: String
  state: ReviewState
  commit_id: CommitSha
  html_url: Url
}

data structural_coverage_gap_github_pull_review_response_residual: List<String> = [
  "closure:github_pull_review_response_residual|PullReview|json_pending:node_id|json_pending:user|json_pending:pull_request_url|json_pending:_links|json_pending:submitted_at|json_pending:author_association|trigger:GitHub PullReview consumer needs full review response fidelity"
]

type ReviewComment {
  id: Int
  node_id: String
  path: FilePath
  line: Int?
  original_line: Int?
  body: String
  html_url: Url
}
