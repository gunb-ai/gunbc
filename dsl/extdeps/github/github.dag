module extdeps.github.github

import std.types { NonEmptyStr, Timestamp }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest"
  }
}

type UserType = User | Bot | Organization

type GitHubUser {
  login: String
  id: Int
  type: UserType
}

type Repository {
  owner: String
  name: String
  full_name: String
  private: Bool
  default_branch: String
}

type GitHubAuthToken {
  token: Secret
  scopes: List<GitHubScope>
  expires_at: Timestamp?
}

type GitHubScope
  = ScopeRepo
  | ScopeGist
  | ScopeWorkflow
  | ScopeReadOrg
  | ScopeReadUser

type Pagination {
  per_page: Int
  cursor: String?
  has_next: Bool
}

type GitHubPermission = PermRead | PermWrite | PermAdmin

data default_api_base: NonEmptyStr = "https://api.github.com"

data default_per_page: Int = 30

data max_per_page: Int = 100
