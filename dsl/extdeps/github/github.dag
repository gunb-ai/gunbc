// extdeps/github/github.dag -- "What is GitHub?"
//
// Core resource model: repositories, users, auth, pagination.
// Complements extdeps/api/github_ops.dag (which covers rate limits and tiers).
// REST-transport bindings of these resources live in sibling service files
// (pulls.dag, gists.dag, actions_runs.dag) -- co-located since services/ was
// merged into extdeps/. REST is one realization handler; the `gh` CLI and
// GraphQL are others not yet bound.
//
// Consumers:
//   extdeps/github/issues.dag        -- issue resource model
//   extdeps/github/pull_requests.dag -- PR resource model
//   extdeps/github/gists.dag         -- gist resource model

module extdeps.github.github

import extdeps.version { RestApiVersionHeader }
import std.serialization { VariantEncoding, StringVariant, VariantNaming, AsAuthored }
import std.types { Timestamp, Url }

// Wire contract: GitHub API returns enum values as plain strings ("User", "Bot").
data wire_contract: VariantEncoding = StringVariant { naming: AsAuthored }

// -- Users ---------------------------------------------------------

type UserType = User | Bot | Organization

type GitHubUser {
  login: String
  id: Int
  type: UserType
}

// -- Repositories --------------------------------------------------

type Repository {
  owner: String
  name: String
  full_name: String
  private: Bool
  default_branch: String
}

// -- Authentication ------------------------------------------------

type GitHubAuthToken {
  token: Secret
  scopes: List<GitHubScope>
  expires_at: Timestamp?
}

type GitHubScope
  = ScopeRepo
  | ScopeGist
  | ScopeWorkflow
  | ScopeReadOrg
  | ScopeReadUser

// -- Pagination ----------------------------------------------------
// GitHub uses Link-header cursor-based pagination.

type Pagination {
  per_page: Int
  cursor: String?
  has_next: Bool
}

// -- Permissions ---------------------------------------------------

type GitHubPermission = PermRead | PermWrite | PermAdmin

// -- Constants -----------------------------------------------------

// Spec: https://docs.github.com/en/rest/about-the-rest-api/api-versions
data default_rest_api_version: RestApiVersionHeader = {
  header: "X-GitHub-Api-Version",
  version: "2022-11-28"
}

data default_api_base: Url = "https://api.github.com"

data default_per_page: Int = 30

data max_per_page: Int = 100
