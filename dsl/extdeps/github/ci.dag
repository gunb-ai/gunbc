          needs: Cons { head: "changes", tail: Empty },
          env: { _wi2_empty_env: "" },
          if_condition: "github.event.pull_request.draft != true && (needs.changes.outputs.code == 'true' || github.event_name == 'push')",
          strategy: none,
          timeout_minutes: 120,
          continue_on_error: false,
          concurrency: none,
        },
  tail: Cons {
  head:         Job {
          id: "self_host_ratchet",
          name: none,
          runner: SelfHosted { labels: Cons { head: "ubicloud-standard-8", tail: Empty } },
          steps: Cons {
  head: RunStep {
  name: none,
  run: "echo \"Gate evidence: changes.result=${{ needs.changes.result }} v3.result=${{ needs.v3.result }}\"\nif [ \"${{ needs.changes.result }}\" != \"success\" ]; then\n  echo \"::error::Layer 1 filter (changes job) did not succeed (result=${{ needs.changes.result }}).\"\n  echo \"::error::Cannot determine v3 skip legitimacy — skipped required-checks default to SUCCESS\"\n  echo \"::error::in GitHub branch protection (https://docs.github.com/en/pull-requests/collaborating-with-pull-requests/collaborating-on-repositories-with-code-quality-features/troubleshooting-required-status-checks#handling-skipped-but-required-checks),\"\n  echo \"::error::so an explicit step failure here surfaces the missing-evidence as a diagnostic\"\n  echo \"::error::per P3 fail-closed / C-8 discipline.\"\n  exit 1\nfi\nif [ \"${{ needs.v3.result }}\" = \"failure\" ] || [ \"${{ needs.v3.result }}\" = \"cancelled\" ]; then\n  echo \"::error::v3 job did not succeed (result=${{ needs.v3.result }}); ratchet cannot claim green.\"\n  exit 1\nfi\necho \"Gate evidence validated; ratchet may proceed.\" ",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: checkout_action,
  with: { fetch_depth: "1" },
  env: { _wi2_empty_env: "" },
  if_condition: "github.event_name == 'push' && github.ref == 'refs/heads/main'",
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "echo \"::notice::self_host_ratchet DB-8 release matrix runs only on pushes to main (Lane 1e staged).\"\nexit 0",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: "github.event_name != 'push' || github.ref != 'refs/heads/main'",
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: setup_rust_action,
  with: { cache: "false", rustflags: "" },
  env: { _wi2_empty_env: "" },
  if_condition: "github.event_name == 'push' && github.ref == 'refs/heads/main'",
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: cache_action,
  with: { path: "~/.cargo/registry/index/\n~/.cargo/registry/cache/\n~/.cargo/git/db/\ntarget/", key: "cargo-self-host-${{ runner.os }}-${{ hashFiles('**/Cargo.lock') }}-${{ hashFiles('src/v3/compiler/**') }}", restore-keys: "cargo-self-host-${{ runner.os }}-${{ hashFiles('**/Cargo.lock') }}-\ncargo-self-host-${{ runner.os }}-" },
  env: { _wi2_empty_env: "" },
  if_condition: "github.event_name == 'push' && github.ref == 'refs/heads/main'",
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "cargo test -p v3-compiler --release --test determinism_test",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: "github.event_name == 'push' && github.ref == 'refs/heads/main'",
  continue_on_error: true,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "cargo run -p v3-compiler --release --bin self_host_fixed_point",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: "github.event_name == 'push' && github.ref == 'refs/heads/main'",
  continue_on_error: true,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "if grep -nE \"(HashMap|HashSet)::\" src/v3/compiler/src/emit.rs; then\n  echo \"::notice::DB-8: emit.rs still uses HashMap/HashSet:: iteration — target is BTree* / sorted keys (determinism_test + ROADMAP Lane 3 Stage 3c prep)\"\nelse\n  echo \"emit.rs: no HashMap::/HashSet:: — consider graduating this check to required when Lane 1e clears debt\"\nfi",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: "github.event_name == 'push' && github.ref == 'refs/heads/main'",
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Empty
}
}
}
}
}
}
}
},
          needs: Cons { head: "v3", tail: Cons { head: "changes", tail: Empty } },
          env: { _wi2_empty_env: "" },
          if_condition: "${{ always() && github.event.pull_request.draft != true }}",
          strategy: none,
          timeout_minutes: 60,
          continue_on_error: true,
          concurrency: none,
        },
  tail: Empty
}
}
}
}
},
  env: { CARGO_TERM_COLOR: "always", RUSTFLAGS: "-D warnings" },
  permissions: WorkflowPermissions {
    contents: PermRead,
    pull_requests: PermRead,
    issues: PermNone,
    actions: PermNone,
  },
}
