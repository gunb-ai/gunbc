// extdeps/github/ci.dag — Workflow-as-data projection of `.github/workflows/ci.yml`.
//
// T-WAD FULL R3 / WI-2 first draft (gunbc PR #2744 / #2745). Carriers:
// `extdeps.github.actions`. Authoritative transport remains the YAML file.
//
// TODO(WI-2 — held / follow-on slices):
//   - Workflow-level `concurrency:` has no `Workflow` field yet — emitter/Slice 4.
//   - `PullRequest` trigger: YAML lists `ready_for_review`; add `PullRequestActivity`
//     variant in actions.dag or dissolve via structural cluster (Slice 7).
//   - `changes.outputs.code` + step `id: filter` — job outputs / step id not on
//     `Job`/`Step` carriers yet (Slice 7).
//   - Layer 2 path-conditional `if:` cluster for regex-heavy steps (Slice 7).
//   - `scripts/slow-test-exemptions.txt` ratchet coupling (Slice 6).
//   - Affected-set / provable minimal selection replaces Layer 1 grep filter (Slice 7).
//   - `GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}` — `WorkflowSecret` / env Map sum-type (Slice 1 held).
//   - `runs-on: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}` approximated as `HostedRunner UbuntuLatest`.
//
// Consumers: T-WAD R3 emitter + timing/dimension reports; keep in lockstep with ci.yml.

module extdeps.github.ci

import std.list { List, Empty, Cons }
import extdeps.github.actions {
  Workflow,
  Job,
  Step,
  RunStep,
  UsesStep,
  HostedRunner,
  SelfHosted,
  UbuntuLatest,
  Push,
  PullRequest,
  Opened,
  Synchronize,
  Reopened,
  checkout_action,
  setup_rust_action,
  cache_action,
  WorkflowPermissions,
  PermRead,
  PermNone,
  Bash,
  ActionRef
}

data gunbc_ci_yml_workflow: Workflow = Workflow {
  name: "ci",
  on: Cons {
  head: Push { branches: Cons { head: "main", tail: Empty }, paths: Empty },
  tail: Cons {
    head: PullRequest {
      branches: Cons { head: "main", tail: Empty },
      types: Cons {
        head: Opened,
        tail: Cons { head: Synchronize, tail: Cons { head: Reopened, tail: Empty } }
      }
    },
    tail: Empty
  }
},
  jobs: Cons {
  head:         Job {
          id: "fmt",
          name: none,
          runner: HostedRunner { label: UbuntuLatest },
          steps: Cons {
  head: UsesStep {
  name: none,
  uses: checkout_action,
  with: { fetch_depth: "1" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: setup_rust_action,
  with: { components: "rustfmt", cache: "false", rustflags: "" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "cargo fmt --all --check",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Empty
}
}
},
          needs: Empty,
          env: { _wi2_empty_env: "" },
          if_condition: "github.event.pull_request.draft != true",
          strategy: none,
          timeout_minutes: 5,
          continue_on_error: false,
          concurrency: none,
        },
  tail: Cons {
  head:         Job {
          id: "ci",
          name: none,
          runner: HostedRunner { label: UbuntuLatest },
          steps: Cons {
  head: UsesStep {
  name: none,
  uses: checkout_action,
  with: { fetch_depth: "0" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "git fetch origin main:refs/remotes/origin/main",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: "github.event_name == 'pull_request'",
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/check-pr-sg0-net-shrink-discipline.sh --self-test",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "body=\"${PR_BODY}\"\nappend_file=\"scripts/ci-merge/sg0-pr-body-append.${{ github.event.pull_request.number }}.txt\"\nif [ -f \"${append_file}\" ]; then\n  body=\"$(cat \"${append_file}\")\"$'\\n\\n'\"${body}\"\nfi\nPR_BODY=\"${body}\" bash scripts/check-pr-sg0-net-shrink-discipline.sh",
  shell: Bash,
  env: { PR_BODY: "${{ github.event.pull_request.body }}" },
  working_directory: none,
  if_condition: "github.event_name == 'pull_request'",
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/check-r4-carve-dissolution-discipline.sh --self-test",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/check-r4-carve-dissolution-discipline.sh",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/check-fabrication-sentinels.sh",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/check-release-doc-authority.sh",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/test-check-release-doc-authority.sh",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/check-manager-brief-authority.sh",
  shell: Bash,
  env: { GH_TOKEN: "${{ secrets.GITHUB_TOKEN }}" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/test-check-manager-brief-authority.sh",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "bash scripts/check-rust-toolchain-single-authority.sh",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: setup_rust_action,
  with: { components: "rustfmt", cache: "false", rustflags: "" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: cache_action,
  with: { path: "~/.cargo/registry/index/\n~/.cargo/registry/cache/\n~/.cargo/git/db/\ntarget/", key: "cargo-ci-${{ runner.os }}-${{ hashFiles('**/Cargo.lock') }}-${{ hashFiles('src/v3/compiler/src/**', 'src/v3/compiler/tests/**') }}", restore-keys: "cargo-ci-${{ runner.os }}-${{ hashFiles('**/Cargo.lock') }}-\ncargo-ci-${{ runner.os }}-" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "cargo run -p v3-compiler --features bootstrap-regen-fresh --bin regen_bootstrap -- --verify",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Empty
}
}
}
}
}
}
}
}
}
}
}
}
}
}
},
          needs: Empty,
          env: { _wi2_empty_env: "" },
          if_condition: "github.event.pull_request.draft != true",
          strategy: none,
          timeout_minutes: 25,
          continue_on_error: false,
          concurrency: none,
        },
  tail: Cons {
  head:         Job {
          id: "changes",
          name: none,
          runner: HostedRunner { label: UbuntuLatest },
          steps: Cons {
  head: UsesStep {
  name: none,
  uses: checkout_action,
  with: { fetch_depth: "0" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "set -euo pipefail\nif [ \"${{ github.event_name }}\" = \"push\" ]; then\n  echo \"push event — always run heavy v3 job\"\n  echo \"code=true\" >> \"$GITHUB_OUTPUT\"\n  exit 0\nfi\ngit fetch origin main:refs/remotes/origin/main\nchanged=$(git diff --name-only origin/main...HEAD)\necho \"Changed files (first 200):\"\necho \"$changed\" | head -200\nnon_docs=$(echo \"$changed\" | grep -vE '^(docs/.*|[^/]+\\.md)$' || true)\nif [ -n \"$non_docs\" ]; then\n  echo \"Non-docs files detected; v3 will run full heavy compute:\"\n  echo \"$non_docs\" | head -50\n  echo \"code=true\" >> \"$GITHUB_OUTPUT\"\nelse\n  echo \"Docs-only PR (allowlist: docs/** + root *.md) — v3 will skip\"\n  echo \"(Layer 1 CI mitigation; dissolution trigger = affected-set lens CI integration)\"\n  echo \"code=false\" >> \"$GITHUB_OUTPUT\"\nfi",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Empty
}
},
          needs: Empty,
          env: { _wi2_empty_env: "" },
          if_condition: "github.event.pull_request.draft != true",
          strategy: none,
          timeout_minutes: 3,
          continue_on_error: false,
          concurrency: none,
        },
  tail: Cons {
  head:         Job {
          id: "v3",
          name: none,
          runner: SelfHosted { labels: Cons { head: "ubicloud-standard-8", tail: Empty } },
          steps: Cons {
  head: UsesStep {
  name: none,
  uses: checkout_action,
  with: { fetch_depth: "1" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
