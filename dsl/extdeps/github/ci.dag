  with: { components: "rustfmt, clippy", cache: "false", rustflags: "" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: ActionRef { owner: "goto-bus-stop", repo: "setup-zig", ref: "v2" },
  with: { version: "0.13.0", cache: "false" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "mkdir -p \"${RUNNER_TEMP}/gunbc-bin\"\ncat > \"${RUNNER_TEMP}/gunbc-bin/zig-cc\" <<'EOF'\n#!/usr/bin/env bash\nexec zig cc \"$@\"\nEOF\nchmod +x \"${RUNNER_TEMP}/gunbc-bin/zig-cc\"\necho \"CC=${RUNNER_TEMP}/gunbc-bin/zig-cc\" >> \"${GITHUB_ENV}\"\necho \"RUSTFLAGS=-D warnings -C linker=${RUNNER_TEMP}/gunbc-bin/zig-cc\" >> \"${GITHUB_ENV}",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: ActionRef { owner: "actions", repo: "setup-python", ref: "v6" },
  with: { python-version: "3.x" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: ActionRef { owner: "actions", repo: "setup-go", ref: "v6" },
  with: { go-version: "stable" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: UsesStep {
  name: none,
  uses: cache_action,
  with: { path: "~/.cargo/registry/index/\n~/.cargo/registry/cache/\n~/.cargo/git/db/\ntarget/", key: "cargo-v3-${{ runner.os }}-${{ hashFiles('**/Cargo.lock') }}-${{ hashFiles('src/v3/compiler/src/**', 'src/v3/compiler/tests/**') }}", restore-keys: "cargo-v3-${{ runner.os }}-${{ hashFiles('**/Cargo.lock') }}-\ncargo-v3-${{ runner.os }}-" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "cargo build -p execute-command-bootstrap",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "set -euo pipefail\nheartbeat() {\n  while sleep 60; do\n    echo \"v3 prebuild heartbeat: $(date -u +%FT%TZ)\"\n  done\n}\nheartbeat &\nheartbeat_pid=$!\ntrap 'kill \"$heartbeat_pid\" 2>/dev/null || true' EXIT\ncargo test -p v3-compiler --test integration --no-run",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "echo \"::notice::v3 lane2d Stage 2d test execution SKIPPED per operator hot-fix directive at gunbc#846 (cold-v3 → ~10min target).\"\necho \"::notice::Restore criteria: per-test wall ≤ 2s under OnceLock/cached_compile amortization (rebuild session per #2722 §5).\"\nexit 0",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "scripts/check-v3-full-suite-split-test-targets.sh",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "set -euo pipefail\necho \"V3_SUITE_START_TS=$(date +%s)\" >> \"${GITHUB_ENV}\"\n: > /tmp/v3-test-timings.log\nRUSTC_BOOTSTRAP=1 cargo test -p v3-compiler --lib --bins -- -Z unstable-options --report-time 2>&1 | tee /tmp/v3-test-timings.log\nstatus=${PIPESTATUS[0]}\nif [ \"$status\" -ne 0 ]; then\n  echo \"::error::cargo test (lib+bins) failed (exit=$status)\"\n  exit \"$status\"\nfi",
  shell: Bash,
  env: { CARGO_TERM_COLOR: "never", RUST_MIN_STACK: "16777216" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "set -euo pipefail\nRUSTC_BOOTSTRAP=1 cargo test -p v3-compiler --test determinism_test -- -Z unstable-options --report-time 2>&1 | tee -a /tmp/v3-test-timings.log\nstatus=${PIPESTATUS[0]}\nif [ \"$status\" -ne 0 ]; then\n  echo \"::error::cargo test (determinism_test) failed (exit=$status)\"\n  exit \"$status\"\nfi",
  shell: Bash,
  env: { CARGO_TERM_COLOR: "never", RUST_MIN_STACK: "16777216" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "set -euo pipefail\nRUSTC_BOOTSTRAP=1 cargo test -p v3-compiler --doc -- -Z unstable-options --report-time 2>&1 | tee -a /tmp/v3-test-timings.log\nstatus=${PIPESTATUS[0]}\nif [ \"$status\" -ne 0 ]; then\n  echo \"::error::cargo test (--doc) failed (exit=$status)\"\n  exit \"$status\"\nfi",
  shell: Bash,
  env: { CARGO_TERM_COLOR: "never", RUST_MIN_STACK: "16777216" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "set -euo pipefail\necho \"::notice::v3 integration test execution SKIPPED via zero-test-filter per operator hot-fix at gunbc#846.\"\necho \"::notice::Guard pattern preserved; integration binary runs zero tests (nonexistent filter).\"\nif [ -z \"${V3_SUITE_START_TS:-}\" ]; then\n  echo \"::error::missing V3_SUITE_START_TS (full suite part 1 must run first)\"\n  exit 1\nfi\nRUSTC_BOOTSTRAP=1 cargo test -p v3-compiler --test integration __HOT_FIX_NONEXISTENT_FILTER__ -- -Z unstable-options --report-time 2>&1 | tee -a /tmp/v3-test-timings.log\nstatus=${PIPESTATUS[0]}\nelapsed=$(( $(date +%s) - V3_SUITE_START_TS ))\necho \"v3 full-suite wall time (integration-skipped): ${elapsed}s\"\nif [ \"$status\" -ne 0 ]; then\n  echo \"::error::cargo test (integration, zero-filter) failed (exit=$status) — should never happen with nonexistent filter; investigate.\"\n  exit \"$status\"\nfi\necho \"::notice::Restore criteria: rebuild session per #2722 §5 OnceLock/cached_compile amortization → per-test wall ≤ 2s ratchet → re-enable per cluster filter (replace __HOT_FIX_NONEXISTENT_FILTER__ with cluster-specific filter).",
  shell: Bash,
  env: { CARGO_TERM_COLOR: "never", RUST_MIN_STACK: "16777216" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "if [ ! -s /tmp/v3-test-timings.log ]; then\n  echo \"::notice::no timing log captured or log is empty (full-suite steps did not reach cargo test, or tee wrote nothing) — skipping per-test ratchet\"\n  exit 0\nfi\nscripts/check-test-timeout.sh /tmp/v3-test-timings.log",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: "always()",
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
