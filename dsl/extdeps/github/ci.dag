  name: none,
  run: "matches=$(grep -nE \"fn (find_port|find_behavior|resolve_producer|lookup_node|lookup_port)\" src/v3/lenses/*.dag 2>/dev/null || true)\nif [ -n \"$matches\" ]; then\n  echo \"::error::L-7 violation: lens reconstructs a substrate lookup locally\"\n  echo \"$matches\"\n  exit 1\nfi",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
  head: RunStep {
  name: none,
  run: "wrappers=$(ls src/v3/compiler/src/lens_*.rs 2>/dev/null || true)\nif [ -z \"$wrappers\" ]; then\n  echo \"L-8: no lens wrapper files to scan\"\n  exit 0\nfi\nmatches=$(grep -nE \"pub fn .*-> (usize|bool|i64)\" $wrappers 2>/dev/null || true)\nif [ -n \"$matches\" ]; then\n  echo \"::error::L-8 violation: lens wrapper collapses typed carrier to a primitive\"\n  echo \"$matches\"\n  exit 1\nfi",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none,
},
  tail: Cons {
