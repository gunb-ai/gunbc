// extdeps/github/expressions.dag — GitHub Actions `${{ }}` expression sub-language as Nodes.
//
// The first roster entry of the **medium-as-Node guard** (docs/plans/emission-ingestion-inverse.md
// §5: a target medium stays a modeled Node from authoring through checking; raw string only at the
// realization edge). GitHub Actions expressions are a sub-language layered on YAML scalars; modeling
// them as opaque `String` (see `actions.dag` `RunsOnExpression { expression: String }`, 🟡 scaffold)
// makes every consumer hand-author the `${{ … }}` delimiters and every check string-grep the emitted
// YAML — an ad-hoc partial re-ingest, the N×M heuristic DESIGN §4 forbids. This module makes the
// expression a typed `Node`, and `serialize_expression` / `interpolate` the SINGLE place the
// `${{ … }}` delimiter bytes are produced. Emit-side (`gunbc.ci_workflow_expressions`) and check-side
// (the model-walk witnesses) both consume it; neither carries the inline syntax (§3 single authority).
//
// Grounding (DESIGN §3 — cite the real upstream, keep its real names, model what it actually provides):
//   Expressions: https://docs.github.com/en/actions/learn-github-actions/expressions
//   Contexts:    https://docs.github.com/en/actions/learn-github-actions/contexts
// The context set (`github`/`env`/`vars`/`runner`/…) and the documented functions
// (`contains`/`hashFiles`/…) are GitHub's, not minted nicknames.
//
// Scope (the first instance — one medium): the expression sub-language sufficient for the
// expressions `gunbc.ci_workflow` emits (context access, function call, logical-or, string literal,
// and a literal/interpolation template). NOT all of YAML and NOT shell-in-`run:` blocks — those are
// later roster entries (§5.1 census).
//
// v1-interpreter-clean (only language builtins + citation deps), so the witnesses execute under
// `gunbc run` exactly as `extdeps/formats/yaml.dag` does.

module extdeps.github.expressions

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.communication.medium { Medium, Lossless }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/learn-github-actions/expressions"
  }
}

// -- Contexts ---------------------------------------------------------
// The documented GitHub Actions expression contexts (the objects an expression may read).
// Closed set per the contexts spec; expanding it is a deliberate taxonomy change when GitHub
// documents a new context.
type ExpressionContext
  = Github
  | Env
  | Vars
  | Job
  | Jobs
  | Steps
  | Runner
  | Secrets
  | Strategy
  | Matrix
  | Needs
  | Inputs

// The documented GitHub Actions expression functions (general + status-check).
type ExpressionFunction
  = Contains
  | StartsWith
  | EndsWith
  | Format
  | Join
  | ToJSON
  | FromJSON
  | HashFiles
  | Success
  | Always
  | Cancelled
  | Failure

// -- Expression -------------------------------------------------------
// One `${{ … }}` expression, as an AST rather than a string.
//
// Field ledger (§2 decompress — each arm genuinely atomic):
//   ContextAccess — a context object read by a dotted property path. `runner.os` is
//     `ContextAccess { context: Runner, path: ["os"] }`; `github.event.pull_request.number`
//     is `ContextAccess { context: Github, path: ["event", "pull_request", "number"] }`. The
//     path is the grounded GitHub property path — NOT split into a fresh enum per context
//     (GitHub's property space per context is open).
//   FunctionCall — a documented function applied to argument expressions.
//   StringLiteral — a single-quoted expression-level string literal (GitHub uses `'…'`).
//   LogicalOr — the `||` operator (the only operator `ci_workflow` uses today; other
//     operators are added as arms when a consumer needs them, not pre-minted — §6 just-in-time).
type Expression
  = ContextAccess { context: ExpressionContext, path: List<String> }
  | FunctionCall { function: ExpressionFunction, args: List<Expression> }
  | StringLiteral { value: String }
  | LogicalOr { left: Expression, right: Expression }

// -- Template ---------------------------------------------------------
// A YAML scalar may interleave literal text with one or more `${{ }}` expressions
// (`cargo-ci-${{ runner.os }}-${{ runner.arch }}-…`). A template is that interleaving:
// literal runs and interpolated expressions. A lone `${{ runner.temp }}` is the degenerate
// one-segment template `[Interpolation { … }]`.
type TemplateSegment
  = LiteralText { text: String }
  | Interpolation { expression: Expression }

type ExpressionTemplate {
  segments: List<TemplateSegment>
}

// -- Serialization (the SINGLE delimiter-byte authority) --------------

fn context_name(context: ExpressionContext) -> String {
  match context {
    Github => "github"
    Env => "env"
    Vars => "vars"
    Job => "job"
    Jobs => "jobs"
    Steps => "steps"
    Runner => "runner"
    Secrets => "secrets"
    Strategy => "strategy"
    Matrix => "matrix"
    Needs => "needs"
    Inputs => "inputs"
  }
}

fn function_name(function: ExpressionFunction) -> String {
  match function {
    Contains => "contains"
    StartsWith => "startsWith"
    EndsWith => "endsWith"
    Format => "format"
    Join => "join"
    ToJSON => "toJSON"
    FromJSON => "fromJSON"
    HashFiles => "hashFiles"
    Success => "success"
    Always => "always"
    Cancelled => "cancelled"
    Failure => "failure"
  }
}

// -- The delimiter spelling rows (single authority, read in BOTH directions) ---
//
// Every structural delimiter byte the serializer produces lives in ONE row the
// fold looks up, so a wrong delimiter is one row edit (and one RED witness),
// never a literal buried in the fold. This is what lets the §5.2 round-trip law
// read the SAME rows backward (the ingest below) — DESIGN §4 one grammar, both
// directions. The closed name maps (context_name / function_name) are the OTHER
// authority; ingest reverses those same functions. (The default values are the
// real GitHub Actions spellings — `${{ … }}`, `.`, `'…'`, `||` — not nicknames.)
type ExpressionSpellings {
  path_sep: String       // "."     dotted context property path
  call_open: String      // "("     function call open
  call_close: String     // ")"     function call close
  arg_sep: String        // ", "    between function arguments
  string_quote: String   // "'"     expression-level string literal delimiter
  or_op: String          // " || "  logical-or operator
  interp_open: String    // "${{ "  interpolation open
  interp_close: String   // " }}"   interpolation close
}

data default_expression_spellings: ExpressionSpellings = {
  path_sep: ".",
  call_open: "(",
  call_close: ")",
  arg_sep: ", ",
  string_quote: "'",
  or_op: " || ",
  interp_open: "${{ ",
  interp_close: " }}",
}

fn join_path_with(path: List<String>, sp: ExpressionSpellings) -> String {
  join(path, sp.path_sep)
}

fn serialize_args_with(args: List<Expression>, sp: ExpressionSpellings) -> String {
  join(map(args, a => serialize_expression_with(expression: a, sp: sp)), sp.arg_sep)
}

// The expression body (no `${{ }}` delimiters): `runner.os`, `hashFiles('a', 'b')`, `x || y`.
fn serialize_expression_with(expression: Expression, sp: ExpressionSpellings) -> String {
  match expression {
    ContextAccess { context: c, path: p } =>
      join([context_name(context: c), join_path_with(path: p, sp: sp)], sp.path_sep)
    FunctionCall { function: f, args: a } =>
      join([function_name(function: f), sp.call_open, serialize_args_with(args: a, sp: sp), sp.call_close], "")
    StringLiteral { value: v } =>
      join([sp.string_quote, v, sp.string_quote], "")
    LogicalOr { left: l, right: r } =>
      join([serialize_expression_with(expression: l, sp: sp), serialize_expression_with(expression: r, sp: sp)], sp.or_op)
  }
}

// The place the interpolation delimiter bytes are produced (now via the rows).
fn interpolate_with(expression: Expression, sp: ExpressionSpellings) -> String {
  join([sp.interp_open, serialize_expression_with(expression: expression, sp: sp), sp.interp_close], "")
}

fn serialize_segment_with(segment: TemplateSegment, sp: ExpressionSpellings) -> String {
  match segment {
    LiteralText { text: t } => t
    Interpolation { expression: e } => interpolate_with(expression: e, sp: sp)
  }
}

fn serialize_template_with(template: ExpressionTemplate, sp: ExpressionSpellings) -> String {
  fold(template.segments, init: "", f: (acc, segment) =>
    concat(acc, serialize_segment_with(segment: segment, sp: sp)))
}

// -- Canonical-spelling entries (the corpus surface; consumers untouched) ------
// `serialize_expression` / `interpolate` / `serialize_template` keep their
// signatures, delegating to the `_with` forms over the default GHA spellings.

fn join_path(path: List<String>) -> String {
  join_path_with(path: path, sp: default_expression_spellings)
}

fn serialize_args(args: List<Expression>) -> String {
  serialize_args_with(args: args, sp: default_expression_spellings)
}

// The expression body (no delimiters): `runner.os`, `hashFiles('a', 'b')`, `x || y`.
fn serialize_expression(expression: Expression) -> String {
  serialize_expression_with(expression: expression, sp: default_expression_spellings)
}

// The ONLY place the `${{ … }}` delimiter bytes are produced. Every emitted GitHub Actions
// expression in the corpus routes through here; nothing hand-authors the delimiters.
fn interpolate(expression: Expression) -> String {
  interpolate_with(expression: expression, sp: default_expression_spellings)
}

fn serialize_segment(segment: TemplateSegment) -> String {
  serialize_segment_with(segment: segment, sp: default_expression_spellings)
}

fn serialize_template(template: ExpressionTemplate) -> String {
  serialize_template_with(template: template, sp: default_expression_spellings)
}

// =========================================================================
// INGEST — GHA expression SOURCE → Expression / ExpressionTemplate (the §5.2
// round-trip inverse). DESIGN §4 one grammar, both directions; §5.2 the
// round-trip law `ingest ∘ emit = id` is the medium-completeness oracle.
//
// Reads the SAME authorities the emitter writes: the `ExpressionSpellings`
// delimiter rows (backward) AND the closed name maps `context_name` /
// `function_name` (reversed via the enumerations below — NO re-spelled second
// name authority; §3 single authority). Fail-closed: any structure outside the
// core yields `Absent`, never a fabricated expression (§5).
//
// FIDELITY BOUNDARY (extdeps.communication.medium):
// `ingest ∘ emit = id` is Lossless over the **FLAT canonical core**:
//   - ContextAccess (context + dotted path), StringLiteral (delimiter-free value),
//   - FunctionCall whose args are FLAT ContextAccess/StringLiteral,
//   - LogicalOr in LEFT-associative (canonical) nesting,
//   - ExpressionTemplate interleaving literal text + interpolations.
// This is round-trip-complete for the FLAT core, NOT the whole GHA expression
// language — nesting is COMMON in real GHA (`contains(x, fromJSON(y))`) and is
// explicitly the **Lossy frontier**, not claimed:
//   - nested FunctionCall / LogicalOr as a function argument,
//   - RIGHT-associative LogicalOr nesting (emit→ingest collapses to left-assoc:
//     `id` on the canonical normal form, a section on non-canonical input),
//   - StringLiteral values containing delimiter bytes (quote / `||` / `, ` / parens),
//   - whitespace variants (`${{runner.os}}` — emit/ingest use canonical spacing only).
// Frontier inputs fail the round-trip (Absent or a different tree), asserted by
// execution in the witness — the boundary is enforced, not just commented.
// Dissolve-on: a precedence/paren-aware tokenizer recovering nested expressions,
// at which point nesting flips to Lossless.
// =========================================================================

// The closed variant enumerations — the reverse name lookups iterate these and
// match via the FORWARD authority (context_name / function_name), so the spelling
// of each name lives in exactly one place (§3). Listing the closed set is not a
// name fork; the names themselves are never re-typed here.
data all_expression_contexts: List<ExpressionContext> = [
  Github, Env, Vars, Job, Jobs, Steps, Runner, Secrets, Strategy, Matrix, Needs, Inputs
]

data all_expression_functions: List<ExpressionFunction> = [
  Contains, StartsWith, EndsWith, Format, Join, ToJSON, FromJSON, HashFiles,
  Success, Always, Cancelled, Failure
]

fn context_from_name(name: String) -> ExpressionContext? {
  fold(all_expression_contexts, init: none, f: (acc, c) => match acc {
    Present { value: x } => Present { value: x }
    Absent => if context_name(context: c) == name { Present { value: c } } else { none }
  })
}

fn function_from_name(name: String) -> ExpressionFunction? {
  fold(all_expression_functions, init: none, f: (acc, fn_variant) => match acc {
    Present { value: x } => Present { value: x }
    Absent => if function_name(function: fn_variant) == name { Present { value: fn_variant } } else { none }
  })
}

fn expr_is_string_literal(s: String, sp: ExpressionSpellings) -> Bool {
  starts_with(s: s, prefix: sp.string_quote)
    && ends_with(s: s, suffix: sp.string_quote)
    && (s.length() >= (2 * sp.string_quote.length()))
}

fn expr_is_call(s: String, sp: ExpressionSpellings) -> Bool {
  ends_with(s: s, suffix: sp.call_close) && string_contains(s, sp.call_open)
}

fn parse_args_with(args_str: String, sp: ExpressionSpellings) -> List<Expression>? {
  if args_str == "" {
    Present { value: [] }
  } else {
    fold(split(s: args_str, delimiter: sp.arg_sep), init: Present { value: [] }, f: (acc, part) => match acc {
      Absent => none
      Present { value: sofar } => match parse_atom_with(s: part, sp: sp) {
        Absent => none
        Present { value: e } => Present { value: concat(sofar, [e]) }
      }
    })
  }
}

// A non-or atom: string literal, function call, or context access.
fn parse_atom_with(s: String, sp: ExpressionSpellings) -> Expression? {
  if expr_is_string_literal(s: s, sp: sp) {
    Present { value: StringLiteral {
      value: substring(s: s, start: sp.string_quote.length(), end: s.length() - sp.string_quote.length()),
    } }
  } else if expr_is_call(s: s, sp: sp) {
    let segs = split(s: s, delimiter: sp.call_open)
    let after = join(segs.skip(n: 1), sp.call_open)
    let args_str = if ends_with(s: after, suffix: sp.call_close) {
      substring(s: after, start: 0, end: after.length() - sp.call_close.length())
    } else {
      after
    }
    match function_from_name(name: segs.first()) {
      Absent => none
      Present { value: fn_variant } => match parse_args_with(args_str: args_str, sp: sp) {
        Absent => none
        Present { value: args } => Present { value: FunctionCall { function: fn_variant, args: args } }
      }
    }
  } else {
    let segs = split(s: s, delimiter: sp.path_sep)
    match context_from_name(name: segs.first()) {
      Absent => none
      Present { value: ctx } => Present { value: ContextAccess { context: ctx, path: segs.skip(n: 1) } }
    }
  }
}

// Top-level: split on or_op and fold LEFT (the canonical normal form), else atom.
fn parse_expression_with(s: String, sp: ExpressionSpellings) -> Expression? {
  let parts = split(s: s, delimiter: sp.or_op)
  if parts.length() == 1 {
    parse_atom_with(s: s, sp: sp)
  } else {
    fold(parts.skip(n: 1), init: parse_atom_with(s: parts.first(), sp: sp), f: (acc, part) => match acc {
      Absent => none
      Present { value: left } => match parse_atom_with(s: part, sp: sp) {
        Absent => none
        Present { value: e } => Present { value: LogicalOr { left: left, right: e } }
      }
    })
  }
}

fn ingest_expression_with(src: String, sp: ExpressionSpellings) -> Expression? {
  parse_expression_with(s: src, sp: sp)
}

fn ingest_expression(src: String) -> Expression? {
  ingest_expression_with(src: src, sp: default_expression_spellings)
}

// Template ingest: split on interp_open; the leading segment is literal text,
// each following segment is `<expr><interp_close><trailing literal>`.
fn ingest_template_with(src: String, sp: ExpressionSpellings) -> ExpressionTemplate? {
  let parts = split(s: src, delimiter: sp.interp_open)
  let lead = parts.first()
  let lead_segs = if lead == "" { [] } else { [ LiteralText { text: lead } ] }
  let built = fold(parts.skip(n: 1), init: Present { value: lead_segs }, f: (acc, part) => match acc {
    Absent => none
    Present { value: sofar } => {
      let halves = split(s: part, delimiter: sp.interp_close)
      if halves.length() < 2 {
        none
      } else {
        let trailing = join(halves.skip(n: 1), sp.interp_close)
        match parse_expression_with(s: halves.first(), sp: sp) {
          Absent => none
          Present { value: e } => {
            let with_interp = concat(sofar, [ Interpolation { expression: e } ])
            Present {
              value: if trailing == "" { with_interp } else { concat(with_interp, [ LiteralText { text: trailing } ]) },
            }
          }
        }
      }
    }
  })
  match built {
    Absent => none
    Present { value: segs } => Present { value: ExpressionTemplate { segments: segs } }
  }
}

fn ingest_template(src: String) -> ExpressionTemplate? {
  ingest_template_with(src: src, sp: default_expression_spellings)
}

// The §5.2 (B) per-medium decidability partition: the FLAT core is Lossless;
// the carried representation is the recovered expression. Nesting / non-canonical
// input is the unclaimed Lossy partition (never advertised by this Medium).
fn gha_expression_medium_lossless(expr: Expression) -> Medium<Expression> {
  Medium { carried: expr, fidelity: Lossless }
}

// -- Runner-context grounding -----------------------------------------
// Constructors for the runner context properties `gunbc.ci_workflow` reads (real property names).
fn runner_os() -> Expression { ContextAccess { context: Runner, path: ["os"] } }
fn runner_arch() -> Expression { ContextAccess { context: Runner, path: ["arch"] } }
fn runner_temp() -> Expression { ContextAccess { context: Runner, path: ["temp"] } }

// The default environment variables GitHub injects that mirror the runner context (each has a
// proper `runner.*` home). Reading one of these through the `env` context instead of `runner.*`
// ties correctness to runtime step-ordering rather than the model — the bad state the model-walk
// guard flags. Grounded in the runner default-env-var table:
// https://docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables
data runner_provided_env_var_names: List<String> = [
  "RUNNER_NAME",
  "RUNNER_OS",
  "RUNNER_ARCH",
  "RUNNER_TEMP",
  "RUNNER_TOOL_CACHE",
  "RUNNER_DEBUG",
  "RUNNER_ENVIRONMENT"
]

fn string_in_list(needle: String, haystack: List<String>) -> Bool {
  fold(haystack, init: false, f: (acc, candidate) => acc || (candidate == needle))
}

// -- Model-walk predicates (the guard) --------------------------------
// These walk the typed expression model — never the emitted YAML string.

// True iff this expression (recursively) reads a runner-provided var through the `env` context.
fn expression_accesses_runner_var_via_env(expression: Expression) -> Bool {
  match expression {
    ContextAccess { context: c, path: p } =>
      match c {
        Env => string_in_list(needle: join_path(path: p), haystack: runner_provided_env_var_names)
        _ => false
      }
    FunctionCall { function: _, args: a } =>
      fold(a, init: false, f: (acc, arg) => acc || expression_accesses_runner_var_via_env(expression: arg))
    LogicalOr { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    StringLiteral { value: _ } => false
  }
}

// True iff this expression (recursively) reads the given context.
fn expression_uses_context(expression: Expression, target: ExpressionContext) -> Bool {
  match expression {
    ContextAccess { context: c, path: _ } => context_name(context: c) == context_name(context: target)
    FunctionCall { function: _, args: a } =>
      fold(a, init: false, f: (acc, arg) => acc || expression_uses_context(expression: arg, target: target))
    LogicalOr { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    StringLiteral { value: _ } => false
  }
}

fn template_accesses_runner_var_via_env(template: ExpressionTemplate) -> Bool {
  fold(template.segments, init: false, f: (acc, segment) => acc || match segment {
    Interpolation { expression: e } => expression_accesses_runner_var_via_env(expression: e)
    LiteralText { text: _ } => false
  })
}

fn template_uses_context(template: ExpressionTemplate, target: ExpressionContext) -> Bool {
  fold(template.segments, init: false, f: (acc, segment) => acc || match segment {
    Interpolation { expression: e } => expression_uses_context(expression: e, target: target)
    LiteralText { text: _ } => false
  })
}

// Walk a roster of templates: does ANY interpolated expression read a runner-provided var via env?
fn any_template_accesses_runner_var_via_env(templates: List<ExpressionTemplate>) -> Bool {
  fold(templates, init: false, f: (acc, template) =>
    acc || template_accesses_runner_var_via_env(template: template))
}
