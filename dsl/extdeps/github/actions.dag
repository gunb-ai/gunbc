// extdeps/github/actions.dag -- GitHub Actions platform model.
//
// Models the GitHub Actions CI/CD platform as external dependency facts:
// workflows, jobs, steps, runners, logging annotations, artifacts, and
// matrix strategies. These are platform constraints -- what GH Actions
// provides and requires -- not repository CI orchestration logic. (The gunbc CI
// gate/projection model that once consumed this carrier was retired in the CI-track rework.)
//
// Spec: https://docs.github.com/en/actions/using-workflows/workflow-syntax-for-github-actions
//
// Consumers: `src/v3/std/t_ci_workflow_as_data_demo.dag` (gate-58 timing-lens
// self-application fixture authors a `Workflow` value over these carriers).
//
// Related extdeps:
//   extdeps/github/ci.dag — repository workflow path facts (complements this syntax model)

module extdeps.github.actions

import extdeps.cron.schedule_model { CronSchedule }
import extdeps.github.log_annotations {
  LogAnnotation,
  AnnotationError, AnnotationWarning, AnnotationNotice,
  AnnotationGroup, AnnotationEndGroup,
  SetOutput, AddMask, StopCommands,
  annotation_error_prefix, annotation_warning_prefix, annotation_notice_prefix,
  annotation_group_prefix, annotation_endgroup,
  annotation_set_output_prefix, annotation_add_mask_prefix,
  annotation_stop_commands_prefix,
  render_log_annotation
}
import std.types { NonEmptyStr, SecretName, Unit }

type GitHubActionsRuntime {
  oidc_request_url_env: NonEmptyStr
  oidc_request_token_env: NonEmptyStr
}

data github_actions_runtime: GitHubActionsRuntime = {
  oidc_request_url_env: "ACTIONS_ID_TOKEN_REQUEST_URL"
  oidc_request_token_env: "ACTIONS_ID_TOKEN_REQUEST_TOKEN"
}

// -- Workflows --------------------------------------------------------
// A workflow is the top-level unit: trigger + jobs.
// `concurrency` is workflow-scoped (YAML `concurrency:`); `none` = block absent.
// Actions accepts a scalar group string or a mapping (`group` + optional `cancel-in-progress`);
// both are modeled — no fabricated booleans when the mapping omits `cancel-in-progress`.

type Workflow {
  name: String
  on: List<WorkflowTrigger>
  concurrency: ConcurrencySpec?
  jobs: List<Job>
  // `none` models an absent top-level `env:` block in Actions YAML (no fabricated keys).
  env: Map<String, String>?
  permissions: WorkflowPermissions?
}

type WorkflowPermissions {
  contents: PermissionLevel
  pull_requests: PermissionLevel
  issues: PermissionLevel
  actions: PermissionLevel
}

type PermissionLevel = PermRead | PermWrite | PermNone

// -- Triggers ---------------------------------------------------------
// Events that cause a workflow to run.

type WorkflowTrigger
  = Push { branches: List<String>, paths: List<String> }
  | PullRequest { branches: List<String>, types: List<PullRequestActivity> }
  | Schedule { cron: CronSchedule }
  | WorkflowDispatch { inputs: List<DispatchInput> }
  | WorkflowCall { inputs: List<DispatchInput> }

type PullRequestActivity
  = Opened
  | Synchronize
  | Reopened
  | ReadyForReview
  | Closed

type DispatchInput {
  name: String
  description: String?
  required: Bool
  default: String?
  type: DispatchInputType
}

type DispatchInputType = InputString | InputBoolean | InputChoice | InputEnvironment

// -- Secrets ----------------------------------------------------------
// Opaque-at-rest secret reference scoped by step / job / workflow.
// Resolution happens at workflow-execution time via the provider's
// secret store (GitHub Secrets); the substrate carries only the
// typed identifier (`SecretName` from std.types -- already cross-provider
// with anthropic/openai providers) and the workflow-scope binding.
// The scope discriminator IS GitHub-Actions-specific (not all providers
// distinguish step-vs-job-vs-workflow secret scopes), which is why the
// carrier folds into actions.dag rather than std.
//
// Coproduct dissolution classification (modeling-discipline.md Practice 4):
// 🟡 SCAFFOLD. The three-way step/job/workflow scope split mirrors the
// existing placement sites (`Step.env`, `Job.env`, `Workflow.env`) named
// in the dissolution trigger below: once `WorkflowSecret` attaches at
// those sites in Slice 3, scope becomes structural (a `WorkflowSecret`
// living inside `Step.env` is step-scoped by placement; the explicit
// `SecretScope` field duplicates that placement fact). Dissolution
// trigger is therefore the SAME Slice 3 wiring that attaches the
// carrier -- at that point `SecretScope` and the `scope` field on
// `WorkflowSecret` collapse into the placement structure and the
// coproduct can be dropped.
//
// Structural-consumer dissolution trigger:
// `WorkflowSecret` is a Slice 1 carrier introduction; structural attachment
// to consumer sites (`Step.env`, `Job.env`, `Workflow.env`) is the **next**
// shape change after today's GitHub-faithful optional plain-text maps
// (`Map<String, String>?` everywhere — `none` = absent `env:` at workflow,
// job, and step scopes; no fabricated keys). Slice 3 upgrades those maps to a
// sum type that includes `WorkflowSecret` (`ci_workflow_modeled_as_dag` demo,
// tracked at #1956), consuming Slices 1+2. Until that wiring lands, the carrier
// is intentionally unattached -- promoting the env-shape change in Slice 1
// would expand the migration cascade beyond the brief's authorized 2-fixture scope.

type SecretScope = StepScope | JobScope | WorkflowScope

// `name` is enforced as `SecretName` (the cross-provider authority in
// `std.types`), not a free type parameter -- the brief's `WorkflowSecret<Name>`
// shape collapses to the concrete binding once the cross-provider grep
// confirmed `SecretName` already exists at std.
type WorkflowSecret {
  name: SecretName
  scope: SecretScope
}

// -- Jobs -------------------------------------------------------------
// A job runs on a runner, has steps, and may depend on other jobs.

type Job {
  id: String
  name: String?
  runner: RunnerSpec
  steps: List<Step>
  needs: List<String>
  // `none` models an absent `env:` block in Actions YAML (no fabricated keys).
  env: Map<String, String>?
  // Job outputs: map output name -> expression string (e.g. `${{ steps.id.outputs.k }}`).
  outputs: Map<String, String>?
  if_condition: String?
  strategy: MatrixStrategy?
  timeout_minutes: Int?
  continue_on_error: Bool
  concurrency: ConcurrencySpec?
}

// YAML `concurrency:` is either a scalar group expression or a mapping.
// See https://docs.github.com/en/actions/using-workflows/workflow-syntax-for-github-actions#concurrency
// and https://docs.github.com/en/actions/using-jobs/using-concurrency (mapping keys
// `group`, `cancel-in-progress`, `queue`; expression-valued cancel-in-progress).

// Coproduct dissolution classification (modeling-discipline.md Practice 4):
// 🟡 YELLOW (scaffold). Literal bool vs opaque `${{ }}` expression string mirrors GitHub's
// surface union; richer source is a typed Actions boolean-expression carrier when/if
// modeled structurally in this repo.
// Named dissolution trigger: typed workflow-boolean expression substrate lands AND
// `gunbc/ci_emission.dag` projection consumes it for `cancel-in-progress` mapping values.
type CancelInProgressSpec
  = CancelInProgressBool { value: Bool }
  | CancelInProgressExpression { expression: String }

// When YAML fixes `queue: max`, GitHub rejects `cancel-in-progress: true` (literal bool).
// This sum therefore excludes literal `true` while still modeling omitted key, literal
// `false`, and opaque `${{ }}` (expression truth remains runtime — see 🟡 below).
//
// Coproduct dissolution classification (modeling-discipline.md Practice 4):
// 🟢 GREEN (terminal). `QueueMaxCancelInProgressFalse` is 1:1 with YAML `cancel-in-progress: false`.
// 🟡 YELLOW (scaffold). `QueueMaxCancelInProgressExpression` mirrors expression-valued mapping;
// GitHub may still reject at runtime if the expression evaluates to true with `queue: max`.
// Named dissolution trigger: same as `CancelInProgressSpec` — typed boolean-expression substrate
// plus `gunbc/ci_emission.dag` consumption for mapping values.
type CancelInProgressWhenQueueMax
  = QueueMaxCancelInProgressFalse
  | QueueMaxCancelInProgressExpression { expression: String }

// 🟡 YELLOW (scaffold). Scalar vs mapping mirrors GitHub's top-level `concurrency:` grammar
// split. Mapping is split into two arms so `queue: max` + literal `cancel-in-progress: true`
// is **unrepresentable** (GitHub validation rejects that product — docs:
// https://docs.github.com/en/actions/using-workflows/workflow-syntax-for-github-actions#concurrency ).
// Named dissolution trigger: GitHub adds documented concurrency mapping fields beyond
// `group` / `cancel-in-progress` / `queue` OR emitter needs single-axis dimensional dispatch.
type ConcurrencySpec
  = ConcurrencyScalar { group: String }
  | ConcurrencyMappingQueueMax {
      group: String
      // `none` when YAML omits `cancel-in-progress:` (do not invent `false`).
      cancel_in_progress: CancelInProgressWhenQueueMax?
    }
  | ConcurrencyMappingQueueNotMax {
      group: String
      // `none` when YAML omits `cancel-in-progress:` (do not invent `false`).
      cancel_in_progress: CancelInProgressSpec?
      // `none` when YAML omits `queue:` (GitHub default single-queue semantics).
      // `some(Unit)` when YAML sets explicit `queue: single` (marker only — no payload).
      explicit_single: Unit?
    }

// -- Runners ----------------------------------------------------------
// The execution environment for a job.

// Coproduct dissolution classification (modeling-discipline.md Practice 4):
// 🟢 GREEN (terminal). `HostedRunner` + `RunnerLabel` are a closed scaffold set aligned with
// GitHub's documented hosted runner images for this repo's first-draft model.
// Ledger (patterns 1–4): no cheaper dissolution for the label enum itself — expanding the
// closed set is a deliberate taxonomy change when GitHub documents new hosted targets.
// 🟡 YELLOW (scaffold). `SelfHosted` carries arbitrary label strings as GitHub accepts for
// self-hosted runner label matching; dissolution: typed runner-label substrate OR emission
// narrows to a closed vocabulary where the compiler owns runner topology.
// 🟡 YELLOW (scaffold). `RunsOnExpression` mirrors GitHub's expression-valued `runs-on:` form;
// the opaque string is faithful YAML surface syntax, not a typed Actions expression carrier.
// Named dissolution trigger: typed Actions string-expression substrate for `runs-on:` AND
// `gunbc/ci_emission.dag` projection consumes it for emitted workflow YAML.
type RunnerSpec
  = HostedRunner { label: RunnerLabel }
  | SelfHosted { labels: List<String> }
  // `runs-on:` as an expression (e.g. `${{ vars.CI_RUNNER || 'ubuntu-latest' }}`).
  | RunsOnExpression { expression: String }

type RunnerLabel
  = UbuntuLatest
  | Ubuntu2404
  | Ubuntu2204
  | MacosLatest
  | Macos14
  | WindowsLatest

// -- Steps ------------------------------------------------------------
// Each step either runs a shell command or uses a published action.

type Step
  = RunStep {
      name: String?,
      id: String?,
      run: String,
      shell: ShellType,
      env: Map<String, String>?,
      working_directory: String?,
      if_condition: String?,
      continue_on_error: Bool,
      timeout_minutes: Int?
    }
  | UsesStep {
      name: String?,
      id: String?,
      uses: ActionRef,
      // `none` models omitted `with:` or YAML `with: {}` (no fabricated action inputs).
      with: Map<String, String>?,
      env: Map<String, String>?,
      if_condition: String?,
      continue_on_error: Bool,
      timeout_minutes: Int?
    }

type ShellType = Bash | Sh | Pwsh | Python | Cmd

type ActionRef {
  owner: String
  repo: String
  ref: String
}

// -- Logging annotations ----------------------------------------------
// Workflow commands that the runner interprets from stdout.
// Authority: extdeps/github/log_annotations.dag (imported above).

// -- Artifacts --------------------------------------------------------
// Upload/download operations for build artifacts.
// Spec: https://docs.github.com/en/actions/using-workflows/storing-workflow-data-as-artifacts

type ArtifactOp
  = Upload { name: String, path: String, retention_days: Int?, if_no_files_found: MissingFilesBehavior }
  | Download { name: String, path: String? }

type MissingFilesBehavior = Warn | ErrorOut | Ignore

// Standard action refs for artifact operations.
data upload_artifact_action: ActionRef = ActionRef {
  owner: "actions", repo: "upload-artifact", ref: "v4"
}

data download_artifact_action: ActionRef = ActionRef {
  owner: "actions", repo: "download-artifact", ref: "v4"
}

// -- Matrix strategy --------------------------------------------------
// Parameterized job execution across multiple configurations.

type MatrixStrategy {
  dimensions: Map<String, List<String>>
  include: List<Map<String, String>>
  exclude: List<Map<String, String>>
  fail_fast: Bool
  max_parallel: Int?
}

// -- Check conclusions ------------------------------------------------
// Terminal states for a workflow run, job, or step.

type CheckConclusion
  = Success
  | Failure
  | Cancelled
  | Skipped
  | TimedOut
  | ActionRequired

// -- Common action refs -----------------------------------------------
// Well-known actions referenced by CI workflows.

data checkout_action: ActionRef = ActionRef {
  owner: "actions", repo: "checkout", ref: "v4"
}

data setup_rust_action: ActionRef = ActionRef {
  owner: "actions-rust-lang", repo: "setup-rust-toolchain", ref: "v1.16.0"
}

data cache_action: ActionRef = ActionRef {
  owner: "actions", repo: "cache", ref: "v4"
}

// -- Platform constants -----------------------------------------------

data max_job_timeout_minutes: Int = 360

data default_job_timeout_minutes: Int = 360

data max_matrix_combinations: Int = 256
