module extdeps.provisioning.network_boot

// Network-boot install mechanism — the cited upstream way to boot a host with no
// removable media: the firmware fetches a bootloader + kernel/initrd over the LAN,
// directed by DHCP. This is the OS-install path forced on a board with no Redfish
// VirtualMedia (the ASRock ALTRAD8UD / OpenBMC case, lane E). The BMC's role is only
// to set the one-shot boot source to Pxe and reset; the *delivery* lives here.
//
// Single authority for the mechanism; the per-mode realizations (legacy TFTP chain
// vs UEFI HTTP Boot) and the per-arch bootloader artifact are dispatch over a closed
// sum (DESIGN §3 — dispatch lives in extdeps, not std).

import std.logic { Bool }
import std.types { NonEmptyStr }
import extdeps.toolchain.types { Architecture, Aarch64, X86_64 }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalAuthority }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "uefi.org/specs/UEFI/2.10/24_Network_Protocols_UDP_and_MTFTP.html"
  }
}

// How the client firmware boots from the network.
//   LegacyBiosPxe  — BIOS option ROM PXE: DHCP options 66/67 + TFTP.
//   UefiPxe        — UEFI PXE: still TFTP-based, client arch via DHCP option 93.
//   UefiHttpBoot   — UEFI HTTP Boot: firmware fetches the boot image directly over
//                    HTTP(S); no TFTP server needed (UEFI 2.5+).
type ClientNetworkBootMode =
    LegacyBiosPxe
  | UefiPxe
  | UefiHttpBoot

// How the client learns where the boot server is.
//   NativeDhcpBootOptions — the LAN's own DHCP server serves the boot options
//                           (next-server/filename or the HTTPClient vendor class).
//                           Requires a configurable DHCP server.
//   ProxyDhcp             — a separate proxyDHCP service (e.g. dnsmasq) answers PXE
//                           requests *alongside* an existing DHCP server that cannot
//                           be configured — the consumer-router case.
type DhcpBootDirection =
    NativeDhcpBootOptions
  | ProxyDhcp

// Whether a given boot mode needs a TFTP server stood up at all. UEFI HTTP Boot
// fetches over HTTP and needs none; the PXE modes chainload the bootloader via TFTP.
fn network_boot_mode_needs_tftp(mode: ClientNetworkBootMode) -> Bool {
  match mode {
    LegacyBiosPxe => true
    UefiPxe => true
    UefiHttpBoot => false
  }
}

// The signed GRUB network bootloader image served for a UEFI network boot, keyed by
// client architecture (Debian/Ubuntu netboot naming). Absent for architectures we do
// not yet ground — fail-closed, not a fabricated default (DESIGN §5).
fn network_uefi_bootloader_artifact(arch: Architecture) -> NonEmptyStr? {
  match arch {
    Aarch64 => Present { value: "grubnetaa64.efi" }
    X86_64 => Present { value: "grubnetx64.efi" }
    _ => Absent
  }
}

// A concrete network-boot chain: the firmware mode, how DHCP directs the client, the
// bootloader artifact served, the optional TFTP root (None for pure HTTP Boot), and
// the HTTP root from which kernel/initrd/squashfs + autoinstall seed are served.
type NetworkBootChain {
  boot_mode: ClientNetworkBootMode
  dhcp_direction: DhcpBootDirection
  bootloader_artifact: NonEmptyStr
  tftp_root: Uri?
  image_http_root: Uri
}

// A chain is well-formed when its TFTP root is present exactly when the mode needs one.
fn network_boot_chain_tftp_coherent(chain: NetworkBootChain) -> Bool {
  match network_boot_mode_needs_tftp(mode: chain.boot_mode) {
    true =>
      match chain.tftp_root {
        Present { value: _ } => true
        Absent => false
      }
    false =>
      match chain.tftp_root {
        Present { value: _ } => false
        Absent => true
      }
  }
}
