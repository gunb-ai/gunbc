// extdeps/os/macos.dag — macOS distribution catalog (cited facts).
// Scope: macOS 15 Sequoia.

module extdeps.os.macos

import std.os.types {
  HomebrewDeFacto,
  LibSystem,
  MacosDistribution,
  MacosDistributionCatalogRow,
  Sequoia15,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.apple.com/documentation/macos-release-notes/macos-15-release-notes"
  }
}

// Anchor: https://developer.apple.com/documentation/macos-release-notes/macos-15-release-notes
data sequoia_15_catalog: MacosDistributionCatalogRow = MacosDistributionCatalogRow {
  distribution: Sequoia15,
  release_label: "macOS 15 Sequoia",
  // M5: none — cited Apple macOS 15 release-notes page documents OS/SDK, not Darwin kernel version.
  darwin_version: none,
  // Anchor (de-facto dev PM; Apple ships no official CLI PM): https://docs.brew.sh/
  package_manager: HomebrewDeFacto,
  libc: LibSystem,
  libc_version: none,
  annual_release_label: "15",
}

fn macos_distribution_catalog_row(distro: MacosDistribution) -> MacosDistributionCatalogRow {
  match distro {
    Sequoia15 => sequoia_15_catalog
  }
}
