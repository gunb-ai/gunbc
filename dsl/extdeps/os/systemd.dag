module extdeps.os.systemd

import std.types { NonEmptyStr }
import std.serialization { CoproductWireContract, StringVariant, SnakeCase }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/systemctl.1.html#is-active"
  }
}

type SystemdUnitActiveState
  = Active
  | Inactive
  | Activating
  | Deactivating
  | Reloading
  | Failed

data systemd_unit_active_state_wire_contract: CoproductWireContract = {
  coproduct: "SystemdUnitActiveState",
  encoding: StringVariant { naming: SnakeCase }
}

type SystemdUnitStatus {
  name: NonEmptyStr
  active_state: SystemdUnitActiveState
}
