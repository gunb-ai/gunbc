module extdeps.os.free

import std.types { Int }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/free.1.html"
  }
}

type MemoryStats {
  total: Int
  used: Int
  free: Int
  shared: Int
  buff_cache: Int
  available: Int
}

type SwapStats {
  total: Int
  used: Int
  free: Int
}

type FreeOutput {
  memory: MemoryStats
  swap: SwapStats
}
