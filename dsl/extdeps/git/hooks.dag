module extdeps.git.hooks

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "git-scm.com/docs/githooks"
  }
}

data zero_sha: String = "0000000000000000000000000000000000000000"

data pre_push_zero_sha: String = zero_sha
