// dsl/extdeps/git/mock_corpus.dag
// Scope: the git layer's PUBLISHED mock corpus as a closed, declared structural fact.
// Anchor: DESIGN.md §3 (single authority) / §6 (model-just-in-time, mark the carrier).
//
// SINGLE authority for WHICH git.Core operations are hermetically realizable. Read by BOTH the
// compile-time M2 mock_totality_lens (src/v2/lens/mock_totality.dag, via the per-layer witness)
// AND the v1 runtime's eval_service_call (the M4 hermetic-realization fold) — one model, not two.
// The v1 runtime loads the dsl/ tree, so this corpus lives in dsl/ for the runtime to reach the
// SAME model the lens reads. Modeled on the M4.0 filesystem pilot
// (dsl/extdeps/filesystem/mock_corpus.dag, #5188).
//
// Rows inhabit std.hermetic_replay.PublishedMockCase. The operation set authority remains
// dsl/extdeps/git/git.dag (`service git.Core`); per-case payloads live in the Phase-2
// RecordedFixture store ONLY — rows carry the (operation_key, case_id) structural key.

module extdeps.git.mock_corpus

import std.hermetic_replay { PublishedMockCase }

data git_core_mock_case_current_branch: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.CurrentBranch",
  service: "git.Core",
  operation: "CurrentBranch",
  case_id: 0
}

data git_core_mock_case_remote_branches: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.RemoteBranches",
  service: "git.Core",
  operation: "RemoteBranches",
  case_id: 0
}

data git_core_mock_case_ls_files: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.LsFiles",
  service: "git.Core",
  operation: "LsFiles",
  case_id: 0
}

data git_core_mock_case_diff: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.Diff",
  service: "git.Core",
  operation: "Diff",
  case_id: 0
}

data git_core_mock_case_diff_name_only: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.DiffNameOnly",
  service: "git.Core",
  operation: "DiffNameOnly",
  case_id: 0
}

data git_core_mock_case_diff_name_only_merge: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.DiffNameOnlyMerge",
  service: "git.Core",
  operation: "DiffNameOnlyMerge",
  case_id: 0
}

data git_core_mock_case_rev_list: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.RevList",
  service: "git.Core",
  operation: "RevList",
  case_id: 0
}

data git_core_mock_case_rev_list_before: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.RevListBefore",
  service: "git.Core",
  operation: "RevListBefore",
  case_id: 0
}

data git_core_mock_case_show: PublishedMockCase = PublishedMockCase {
  operation_key: "git.Core.Show",
  service: "git.Core",
  operation: "Show",
  case_id: 0
}

// 🟡 gated — feature:git-mock-corpus-from-service-decl — bind node://adhoc-aeaa1c56-be5
// dissolve-on-arrival: project this corpus directly from the `service git.Core` operation set in
// dsl/extdeps/git/git.dag (the SINGLE authority for WHICH operations exist), joined with the
// Phase-2 RecordedFixture store (the authority for WHICH recorded cases exist per operation), once
// a v2 lens can read a service decl's operation nodes and the fixture store's keys; this declared
// list then deletes in the same PR. forbidden: a row carrying a response VALUE (branch/branches/
// files/diff/paths/commits/base_ref/content) — that would fork the payload authority, now owned
// by the fixture store (§3); rows mirror the (operation_key, case_id) structural key ONLY, and grow
// when a published operation/case is added upstream.
data git_published_mock_corpus: List<PublishedMockCase> = [
  git_core_mock_case_current_branch,
  git_core_mock_case_remote_branches,
  git_core_mock_case_ls_files,
  git_core_mock_case_diff,
  git_core_mock_case_diff_name_only,
  git_core_mock_case_diff_name_only_merge,
  git_core_mock_case_rev_list,
  git_core_mock_case_rev_list_before,
  git_core_mock_case_show
]
