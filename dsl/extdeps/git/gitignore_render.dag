// extdeps/git/gitignore_render.dag -- Gitignore rendering functions.
//
// Rendering fns extracted from extdeps/git/gitignore.dag to separate
// domain model from serialization (same pattern as markdown.dag +
// markdown_render.dag).

module extdeps.gitignore_render

import extdeps.gitignore { GitignoreCategory, GitignoreFile }

fn render_category_header(cat: GitignoreCategory) -> String {
  match cat.source {
    Absent => "# --- {cat.name} ---"
    _ => "# --- {cat.name} (from {cat.source}) ---"
  }
}

fn render_category(cat: GitignoreCategory) -> String {
  let header = render_category_header(cat: cat)
  let rationale_line = match cat.rationale {
    Absent => ""
    _ => "# {cat.rationale}\n"
  }
  let items = join(cat.items, "\n")
  "\{header\}\n\{rationale_line\}\{items\}\n"
}

fn render_gitignore_content(file: GitignoreFile) -> String {
  let rule = "# {file.rule_comment}\n\n"
  let rendered = map(file.categories, c => render_category(cat: c))
  let body = join(rendered, "\n")
  "\{rule\}\{body\}"
}

fn render_gitignore_file(file: GitignoreFile, generator: String, regen_command: String) -> String {
  let header = "# Generated by \{generator\}\n# DO NOT EDIT - regenerate with: \{regen_command\}"
  let content = render_gitignore_content(file: file)
  "\{header\}\n\n\{content\}"
}
