// extdeps/audit/event.dag -- audit event emission target surface.
//
// Specs:
//   CloudEvents 1.0.2 core event attributes
//     https://github.com/cloudevents/spec/blob/v1.0.2/cloudevents/spec.md
//   RFC 3339 timestamp profile
//     https://www.rfc-editor.org/rfc/rfc3339
//
// Ctrl-Migration Phase 3 authority for emitted audit event facts. The target
// describes stable event records; it does not decide storage backend, queueing,
// retention, or alerting policy.

module extdeps.audit.event

// Coproduct dissolution classification (modeling-discipline.md Practice 4):
// GREEN (terminal). Actor source changes authorization and attribution
// semantics; collapsing to a string would lose the external audit dimension.
type AuditActorKind
  = HumanActor
  | ServiceActor
  | SystemActor

// Coproduct dissolution classification (modeling-discipline.md Practice 4):
// GREEN (terminal). Outcome is part of the externally reported audit fact
// and drives different downstream compliance interpretations.
type AuditOutcome
  = AuditSucceeded
  | AuditDenied
  | AuditFailed

type AuditActor {
  kind: AuditActorKind
  id: String
}

type AuditEventField {
  key: String
  value: String
}

type AuditEventRecord {
  event_type: String
  subject: String
  actor: AuditActor
  outcome: AuditOutcome
  occurred_at: String
  fields: List<AuditEventField>
}

// STAGED. Ctrl subsystem projections emit into this target only after parity
// tests prove the event stream matches the existing TypeScript implementation.
type AuditEventEmissionTarget {
  stream_name: String
  events: List<AuditEventRecord>
}
