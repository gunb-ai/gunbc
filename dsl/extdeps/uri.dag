module extdeps.uri

import std.types { NonEmptyStr, Url }

type UriScheme
  = Http
  | Https
  | File
  | Ftp

type Uri {
  scheme: UriScheme
  locator: NonEmptyStr
}

fn uri_scheme_is_http(s: UriScheme) -> Bool {
  match s {
    Http => true
    Https => true
    File => false
    Ftp => false
  }
}

fn uri_is_url(uri: Uri) -> Bool {
  uri_scheme_is_http(s: uri.scheme)
}
