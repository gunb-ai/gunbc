module extdeps.uri

import std.types { NonEmptyStr, Url }

type UriScheme
  = Http
  | Https
  | File
  | Ftp

type Uri {
  scheme: UriScheme
  locator: NonEmptyStr
}

fn uri_scheme_is_http(s: UriScheme) -> Bool {
  match s {
    Http => true
    Https => true
    File => false
    Ftp => false
  }
}

fn uri_is_url(uri: Uri) -> Bool {
  uri_scheme_is_http(s: uri.scheme)
}

fn uri_scheme_wire(s: UriScheme) -> NonEmptyStr {
  match s {
    Http => "http://"
    Https => "https://"
    File => "file://"
    Ftp => "ftp://"
  }
}

fn uri_wire(uri: Uri) -> NonEmptyStr {
  concat(uri_scheme_wire(s: uri.scheme), uri.locator)
}
