// extdeps/tools.dag — Holistic CLI tool modeling.
//
// Every .dag program that shells out depends on external CLI binaries
// (cargo, grep, diff, cp, ...). This file models those binaries as
// explicit declared facts with install sources, and provides a
// fail-closed upsert that resolves tool → absolute path via `which`.
//
// Consumers build command strings from resolved ResolvedTool.path values
// instead of bare names, eliminating hidden PATH dependencies.
//
// InstallSource only contains variants we actually use today. Adding a
// new install source means modeling that source completely first
// (e.g., `dsl/extdeps/apt.dag` before `SourceApt`).
//
// Pattern reference: gunb.ai/tools/toolpaths/toolpaths.go (Ensure upsert).

module extdeps.tools

import std.types { FilePath, NonEmptyStr }
import extdeps.shell
import extdeps.coreutils
import extdeps.rustup { rustup_install_url }

// ── Install source ──────────────────────────────────────────────────

// How a required CLI tool gets onto the system. Closed set — only
// variants whose backing extdeps file exists. Don't add a variant
// for an install source we haven't modeled.
//
//   SourceCoreutils → extdeps/coreutils.dag (grep, diff, cp, rm, ...)
//   SourceRustup    → extdeps/rustup.dag    (cargo, rustc)
type InstallSource
  = SourceCoreutils
  | SourceRustup

// ── Tool declaration and resolution ────────────────────────────────

// A required external CLI tool. The name is what the workflow would
// invoke; min_version is an optional version floor; source tells the
// resolver how the tool gets installed.
type CliTool {
  name: NonEmptyStr
  min_version: String?
  source: InstallSource
}

// A resolved tool: the declared CliTool paired with its actual absolute
// filesystem path (from `which`). Workflows build command strings from
// resolved.path, never from the bare name.
type ResolvedTool {
  tool: CliTool
  path: FilePath
}

// The outcome of attempting to resolve a tool. Fail-closed: if the
// tool isn't found, the hint tells the user exactly how to install it.
type ResolveResult
  = Resolved { resolved: ResolvedTool }
  | NotFound { tool: CliTool, hint: String }

// ── Install hints ──────────────────────────────────────────────────

// Human-readable recovery instruction when a tool is missing.
// Each variant references the documented dependency in its extdeps file.
fn install_hint(source: InstallSource) -> String {
  match source {
    SourceCoreutils => "expected GNU/BSD coreutils — see extdeps/coreutils.dag for the documented dependency"
    SourceRustup => concat("install rustup from ", rustup_install_url)
  }
}

// ── Resolution workflow ─────────────────────────────────────────────

// Fail-closed upsert: check if the tool is on PATH via `which`, return
// Resolved with the absolute path if found, NotFound with an install
// hint if not. This is the single authority for "where does this tool
// live on this system."
func resolve(tool: CliTool) -> ResolveResult {
  let check = shell.Which.Check(command: tool.name)
  match check.path {
    Some { value: p } => Resolved { resolved: { tool: tool, path: p } }
    None => NotFound { tool: tool, hint: install_hint(source: tool.source) }
  }
}
