module extdeps.getrandom

import std.integer { UInt8 }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man4/random.4.html"
  }
}

data getrandom_transport_linux_gnu_only: String = "🟡 SCAFFOLD — transport is Linux/GNU-coreutils-only: head(1) from util-linux, base64(1) -w 0 from GNU coreutils (macOS/BSD base64 uses -b 0). Dissolution trigger: per-OS dispatch realization (extdeps/getrandom/linux.dag, bsd.dag) replaces this single shell pipeline."

data getrandom_count_bytes_unit_debt: String = "🟡 SCAFFOLD — count: Int is a flat-scalar unit field for bytes-to-read; grounded carrier is ByteSize (std.measure). Dissolution trigger: std.resources Entropy.read_bytes migrates count to ByteSize."

service Getrandom {
  operation ReadBytes {
    input { count: Int }
    output { octets_b64: String from "stdout" }
    readonly
    transport shell { argv: ["sh", "-c", "head -c {count} /dev/urandom | base64 -w 0"] }
    exit {
      0 => Unit
      nonzero => String "Getrandom.ReadBytes: /dev/urandom or base64 failed"
    }
  }
}
