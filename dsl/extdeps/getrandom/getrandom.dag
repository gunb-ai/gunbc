module extdeps.getrandom

import std.integer { UInt8 }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man2/getrandom.2.html"
  }
}

data getrandom_native_transport_seam_note: String = "SEAM: Getrandom.ReadBytes transport argv is a fail-closed decoy; native /dev/urandom read is intercepted in eval_service_call before transport dispatch. DISSOLUTION: replace decoy with a real getrandom(2) transport when crate support lands in the transport vocabulary."

service Getrandom {
  operation ReadBytes {
    input { count: Int }
    output { octets: List<UInt8> from "native" }
    readonly
    transport shell { argv: ["false"] }
    exit {
      0 => Unit
      nonzero => String "getrandom native transport seam: decoy must not run"
    }
  }
}
