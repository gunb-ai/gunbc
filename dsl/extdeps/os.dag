// extdeps/os.dag — OS catalog dispatch hub (per-distro modules: ubuntu/windows/macos).
// Reuse: std.os surface projections from cited distribution catalog rows.

module extdeps.os

import extdeps.macos { macos_distribution_catalog_row }
import extdeps.ubuntu { ubuntu_distribution_catalog_row }
import extdeps.windows { windows_distribution_catalog_row }
import std.compute_fabric { OperatingSystemSurface }
import std.list { List }
import std.os {
  operating_system_surface_macos,
  operating_system_surface_ubuntu,
  operating_system_surface_windows,
}
import std.os.types {
  MacosOs,
  NobleNumbat2404Lts,
  OperatingSystemProduct,
  Sequoia15,
  UbuntuOs,
  Windows1124H2Build26100,
  WindowsOs,
}

fn cited_operating_system_surface(product: OperatingSystemProduct) -> OperatingSystemSurface {
  match product {
    UbuntuOs { distro: d } => operating_system_surface_ubuntu(ubuntu_distribution_catalog_row(d))
    WindowsOs { distro: d } => operating_system_surface_windows(windows_distribution_catalog_row(d))
    MacosOs { distro: d } => operating_system_surface_macos(macos_distribution_catalog_row(d))
  }
}

data ubuntu_24_04: OperatingSystemSurface = cited_operating_system_surface(UbuntuOs { distro: NobleNumbat2404Lts })
data windows_11: OperatingSystemSurface = cited_operating_system_surface(WindowsOs { distro: Windows1124H2Build26100 })
data macos_15_sequoia: OperatingSystemSurface = cited_operating_system_surface(MacosOs { distro: Sequoia15 })

data os_catalog: List<OperatingSystemSurface> = [
  ubuntu_24_04,
  windows_11,
  macos_15_sequoia,
]

// Operator fleet authority (srv1/srv2 run Ubuntu 24.04 LTS).
data operator_fleet_os_product: OperatingSystemProduct = UbuntuOs { distro: NobleNumbat2404Lts }
data operator_fleet_os_surface: OperatingSystemSurface = cited_operating_system_surface(operator_fleet_os_product)
