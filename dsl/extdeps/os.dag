// extdeps/os.dag — cited OS catalog dispatch (per-product rows in extdeps/os/*).
// Scope: Ubuntu 24.04 LTS / Windows 11 24H2 / macOS 15 Sequoia.
// Reuse: std.os.types.OperatingSystemCatalogRow + std.os.operating_system_surface.

module extdeps.os

import extdeps.os.macos_15_sequoia { macos_15_sequoia_catalog }
import extdeps.os.ubuntu_24_04 { ubuntu_24_04_catalog }
import extdeps.os.windows_11 { windows_11_catalog }
import std.compute_fabric { OperatingSystemSurface }
import std.list { List }
import std.os { operating_system_surface }
import std.os.types {
  Macos15Sequoia,
  OperatingSystemCatalogRow,
  OperatingSystemProduct,
  Ubuntu2404Lts,
  Windows1124H2,
}

fn os_catalog_row(product: OperatingSystemProduct) -> OperatingSystemCatalogRow {
  match product {
    Ubuntu2404Lts => ubuntu_24_04_catalog
    Windows1124H2 => windows_11_catalog
    Macos15Sequoia => macos_15_sequoia_catalog
  }
}

fn cited_operating_system_surface(product: OperatingSystemProduct) -> OperatingSystemSurface {
  operating_system_surface(os_catalog_row(product))
}

data ubuntu_24_04: OperatingSystemSurface = cited_operating_system_surface(Ubuntu2404Lts)
data windows_11: OperatingSystemSurface = cited_operating_system_surface(Windows1124H2)
data macos_15_sequoia: OperatingSystemSurface = cited_operating_system_surface(Macos15Sequoia)

data os_catalog: List<OperatingSystemSurface> = [
  ubuntu_24_04,
  windows_11,
  macos_15_sequoia,
]

// Operator fleet authority (srv1/srv2 run Ubuntu 24.04 LTS).
data operator_fleet_os_product: OperatingSystemProduct = Ubuntu2404Lts
data operator_fleet_os_surface: OperatingSystemSurface = cited_operating_system_surface(operator_fleet_os_product)
