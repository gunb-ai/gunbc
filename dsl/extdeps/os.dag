// extdeps/os.dag — OS catalog dispatch hub (per-distro modules: ubuntu/windows/macos).
// Reuse: std.os surface projections from cited distribution catalog rows.

module extdeps.os

import extdeps.macos { macos_distribution_catalog_row, sequoia_15_catalog }
import extdeps.ubuntu { noble_numbat_2404_catalog, ubuntu_distribution_catalog_row }
import extdeps.windows { windows_11_24h2_catalog, windows_distribution_catalog_row }
import std.compute_fabric { OperatingSystemSurface }
import std.list { List }
import std.os {
  operating_system_surface_macos,
  operating_system_surface_ubuntu,
  operating_system_surface_windows,
}
import std.os.types {
  MacosDistributionCatalogRow,
  NobleNumbat2404Lts,
  OperatingSystemProduct,
  Sequoia15,
  UbuntuDistributionCatalogRow,
  Windows1124H2Build26100,
  WindowsDistributionCatalogRow,
}

fn ubuntu_surface(product: NobleNumbat2404Lts) -> OperatingSystemSurface {
  operating_system_surface_ubuntu(ubuntu_distribution_catalog_row(product))
}

fn windows_surface(product: Windows1124H2Build26100) -> OperatingSystemSurface {
  operating_system_surface_windows(windows_distribution_catalog_row(product))
}

fn macos_surface(product: Sequoia15) -> OperatingSystemSurface {
  operating_system_surface_macos(macos_distribution_catalog_row(product))
}

fn cited_operating_system_surface(product: OperatingSystemProduct) -> OperatingSystemSurface {
  match product {
    NobleNumbat2404Lts => ubuntu_surface(product)
    Windows1124H2Build26100 => windows_surface(product)
    Sequoia15 => macos_surface(product)
  }
}

data ubuntu_24_04: OperatingSystemSurface = cited_operating_system_surface(NobleNumbat2404Lts)
data windows_11: OperatingSystemSurface = cited_operating_system_surface(Windows1124H2Build26100)
data macos_15_sequoia: OperatingSystemSurface = cited_operating_system_surface(Sequoia15)

data os_catalog: List<OperatingSystemSurface> = [
  ubuntu_24_04,
  windows_11,
  macos_15_sequoia,
]

// Operator fleet authority (srv1/srv2 run Ubuntu 24.04 LTS).
data operator_fleet_os_product: OperatingSystemProduct = NobleNumbat2404Lts
data operator_fleet_os_surface: OperatingSystemSurface = cited_operating_system_surface(operator_fleet_os_product)
