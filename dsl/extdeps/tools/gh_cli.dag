// extdeps/tools/gh_cli.dag -- "What is the GitHub CLI?"

module extdeps.tools.gh_cli

import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

type GhAuthMethod = OAuthBrowser | Token | GitHubApp

type GhCommand {
  verb: String
  resource: String
  flags: List<String>
}

type GhOutputFormat = Json | Table | Template

type GhCliOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

type AuthFlowStep {
  step: String
  required: Bool
}

data auth_flow: List<AuthFlowStep> = [
  { step: "Select auth method (token/browser/app)", required: true },
  { step: "Exchange or validate credentials with API", required: true },
  { step: "Persist credential in keychain or config", required: true },
  { step: "Verify scopes with gh auth status", required: true }
]

data operation_behaviors: List<GhCliOperationBehavior> = [
  {
    operation: "Auth",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["host", "auth_method"],
      determinism: NonDeterministic,
      failure_modes: [{ name: "AuthFailed", condition: "token_invalid_or_scope_missing", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "network access to GitHub host", kind: Infrastructure }],
      assumptions: ["Credential storage backend is available on host platform"],
      unknowns: ["Exact scope requirements per subcommand family"]
    }
  },
  {
    operation: "ReleaseList",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [],
      confidence: HighConfidence,
      prerequisites: [{ description: "read access to repository releases", kind: Credential }],
      assumptions: ["CLI pagination handles large release lists safely"],
      unknowns: []
    }
  },
  {
    operation: "ReleaseDownload",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["repo", "tag", "pattern", "dest"],
      determinism: Deterministic,
      failure_modes: [{ name: "AssetNotFound", condition: "release_or_pattern_missing", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "write access to destination path", kind: Infrastructure }],
      assumptions: ["Artifact checksum validation handled by caller when required"],
      unknowns: ["Retry behavior for partial downloads over unstable links"]
    }
  },
  {
    operation: "IssueCreate",
    behavior: {
      side_effects: WritesExternal,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [],
      edge_cases: [{ description: "duplicate issues possible without caller-level dedup keys", trigger: "repeated_submit", severity: Medium }],
      confidence: MediumConfidence,
      prerequisites: [{ description: "issues:write permission", kind: Credential }],
      assumptions: ["Repository issue tracker enabled"],
      unknowns: []
    }
  },
  {
    operation: "PrCreate",
    behavior: {
      side_effects: WritesExternal,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [{ name: "ValidationFailed", condition: "base_or_head_invalid", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: MediumConfidence,
      prerequisites: [{ description: "pull_requests:write permission", kind: Credential }],
      assumptions: ["Head branch exists and is push-accessible"],
      unknowns: []
    }
  },
  {
    operation: "RunWatch",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: ["run_id"],
      determinism: NonDeterministic,
      failure_modes: [],
      edge_cases: [{ description: "watch loop can exceed terminal timeout for long workflows", trigger: "long_running_run", severity: Medium }],
      confidence: HighConfidence,
      prerequisites: [{ description: "actions:read permission", kind: Credential }],
      assumptions: ["Polling interval is bounded to avoid API exhaustion"],
      unknowns: []
    }
  }
]
