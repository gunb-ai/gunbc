// extdeps/bmc/http.dag — DMTF Redfish REST transport (curl argv bindings).
//
// Anchor: https://www.dmtf.org/standards/redfish
//
// Interface shapes and grounding projections live in extdeps/bmc/{types,redfish}.dag
// (git.dag pattern: types + projections co-located; transport in this file).
//
// Service name is 2-segment (`redfish.Http`) so it is callable from a fn — a 3-segment
// `diagnostic.redfish.Http` could not be referenced as a call path.
//
// 🟡 dissolved — feature:diagnostic-redfish-mock-response — scaffold:hand-authored mock_response —
// dissolve-on-arrival: Phase-2-hermetic RecordedFixture replay from claim_batch --fixture-store
// (recorded wet via --record); the published corpus (extdeps.diagnostic.mock_corpus) governs
// WHICH redfish.Http ops are hermetically realizable, and the fixture store owns the payloads (§3).
// forbidden: reintroducing mock_response constants for Hermetic dispatch on these shapes.

module extdeps.bmc.http

import std.types { NonEmptyStr }

service redfish.Http {
  // Authenticated read of the system resource (power state, manufacturer, etc.) — the
  // minimal "first contact" that proves the BMC is reachable AND the credentials work.
  // Read-only / safe. `-k` accepts the BMC's self-signed cert (standard for OOB mgmt).
  // NOTE: the password rides the curl argv here, acceptable ONLY because first contact
  // uses the PUBLISHED factory default; a rotated Secret must use GetSystemWithNetrc
  // (password never on argv) once rotation has happened.
  operation GetSystem {
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-u", "{username}:{password}", "https://{bmc_host}/redfish/v1/Systems/system"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish system GET failed"
    }
  }

  // Authenticated read via netrc file — REQUIRED for rotated BMC secrets (password must
  // not appear on curl argv). netrc_file path comes from BMC_NETRC_FILE (0600 file).
  operation GetSystemWithNetrc {
    input { bmc_host: NonEmptyStr, netrc_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "--netrc-file", "{netrc_file}", "https://{bmc_host}/redfish/v1/Systems/system"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish system GET (netrc) failed"
    }
  }

  // Chassis sensor collection — OpenBMC ALTRAD8UD exposes power/temp under Sensors/{name}
  // (Chassis Power/Thermal are empty on Redfish 1.15 for this board).
  operation GetChassisSensors {
    input { bmc_host: NonEmptyStr, chassis_id: NonEmptyStr, netrc_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "--netrc-file", "{netrc_file}", "https://{bmc_host}/redfish/v1/Chassis/{chassis_id}/Sensors"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish chassis sensors GET failed"
    }
  }

  // Chassis Power — PowerControl members (PowerConsumedWatts, PowerLimitWatts).
  // Shape authority: extdeps/bmc/types.dag (RedfishPowerSubsystem).
  operation GetPower {
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-u", "{username}:{password}", "https://{bmc_host}/redfish/v1/Chassis/Self/Power"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish power GET failed"
    }
  }

  // Chassis Thermal — temperature sensor readings.
  // Shape authority: extdeps/bmc/types.dag (RedfishThermalSubsystem).
  operation GetThermal {
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-u", "{username}:{password}", "https://{bmc_host}/redfish/v1/Chassis/Self/Thermal"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish thermal GET failed"
    }
  }
}
