module extdeps.bmc.http

import std.types { NonEmptyStr }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.dmtf.org/standards/redfish"
  }
}

service redfish.Http {

  operation GetServiceRoot {
    input { bmc_host: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "https://{bmc_host}/redfish/v1"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish service root GET failed"
    }
  }

  operation GetSystem {
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-u", "{username}:{password}", "https://{bmc_host}/redfish/v1/Systems/system"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish system GET failed"
    }
  }

  operation GetSystemWithNetrc {
    input { bmc_host: NonEmptyStr, netrc_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "--netrc-file", "{netrc_file}", "https://{bmc_host}/redfish/v1/Systems/system"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish system GET (netrc) failed"
    }
  }

  operation GetChassisSensors {
    input { bmc_host: NonEmptyStr, chassis_id: NonEmptyStr, netrc_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "--netrc-file", "{netrc_file}", "https://{bmc_host}/redfish/v1/Chassis/{chassis_id}/Sensors"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish chassis sensors GET failed"
    }
  }

  operation GetPower {
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-u", "{username}:{password}", "https://{bmc_host}/redfish/v1/Chassis/Self/Power"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish power GET failed"
    }
  }

  operation GetThermal {
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-u", "{username}:{password}", "https://{bmc_host}/redfish/v1/Chassis/Self/Thermal"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish thermal GET failed"
    }
  }
}
