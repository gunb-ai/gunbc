// extdeps/bmc/openbmc.dag — OpenBMC firmware family: cited defaults (single authority).
//
// Anchor: https://github.com/openbmc/openbmc  (the Linux Foundation OpenBMC project)
//
// OpenBMC ships a stock root account with the published default password `0penBmc`
// (that is a zero, then "penBmc"). Cited witness: ASRock Rack ALTRAD8UD-1L2T User
// Manual p.47 — "the default login information for the IPMI web interface is:
// Username: root  Password: 0penBmc". This is a WORLD-KNOWN published default, so
// it is allowed as a cited source literal here (not a held secret); a real deployment
// rotates it on first contact (rotation is a workflow policy, not modeled here).
//
// This file is the ONE home for the OpenBMC factory credential: every board that ships
// OpenBMC derives it from here (DESIGN §2 horizontal — one fact, every board derives;
// §3 single authority — never re-stated per board row).

module extdeps.bmc.openbmc

import std.bmc { BmcFirmwareFamily, OpenBmc, BmcProtocol, Redfish, Ipmi }
import std.credentials { Credential }
import std.types { List, Secret }

// The published OpenBMC factory login (see anchor above).
data openbmc_factory_credential: Credential = Credential {
  username: "root",
  secret: "0penBmc" as Secret,
}

// OpenBMC exposes BOTH a DMTF Redfish service and a legacy IPMI/RMCP+ service. These
// are distinct, separately-cited interfaces (DESIGN §3 — exclusive, not aliases).
data openbmc_supported_protocols: List<BmcProtocol> = [Redfish, Ipmi]

// firmware → published factory credential. Closed match; fail-closed on a new family
// until its own cited file lands.
fn bmc_firmware_factory_credential(family: BmcFirmwareFamily) -> Credential {
  match family {
    OpenBmc => openbmc_factory_credential
  }
}

// firmware → the management protocols it speaks.
fn bmc_firmware_supported_protocols(family: BmcFirmwareFamily) -> List<BmcProtocol> {
  match family {
    OpenBmc => openbmc_supported_protocols
  }
}
