module extdeps.bmc.webui.nbd_proxy_serve

import std.types { NonEmptyStr, Int, String, List }
import std.logic { Bool }
import extdeps.external_authority { ExternalAuthority }
import extdeps.tools.curl { curl_cli_tool }
import extdeps.tools.websocat { websocat_cli_tool }
import extdeps.tools.nbdkit { nbdkit_cli_tool }
import extdeps.tools.socat { socat_cli_tool }
import extdeps.languages.bash.program {
  ShellProgram,
  lit,
  command,
  assign,
  serialize_bash,
  RawLine,
}
import extdeps.bmc.webui.nbd_proxy {
  extdeps_external_authority_anchor,
  nbd_proxy_role_assignment,
  NbdServer,
}

data nbd_proxy_serve_transport_authority: ExternalAuthority = extdeps_external_authority_anchor

data bmcweb_session_token_env_ref: NonEmptyStr = concat("$", "BMCWEB_SESSION_TOKEN") as NonEmptyStr

data srv3_nbd_proxy_local_port: Int = 10809

data nbd_proxy_serve_bash_emit_dissolution_trigger: String = "🟡 dissolve-on: nbd_proxy_serve — held-open nbdkit→websocat→socat pipeline serialized via extdeps.languages.bash.program ShellProgram (SCAFFOLD ahead of grammar-row bash_fold emit + host_effect NbdProxyServe transport handler); medium-as-string concat retired; DISSOLVES WHEN bash_fold grammar rows realize this pipeline with ingest ∘ emit = id and host_effect_apply binds NbdProxyServe without serialize_bash; retire medium_structure_exception_roster entry for dsl/extdeps/bmc/webui/nbd_proxy_serve.dag"

type NbdProxyServeTransportIntent {
  bmc_host: NonEmptyStr
  session_token: NonEmptyStr
  ws_path: NonEmptyStr
  iso_path: NonEmptyStr
  local_nbd_port: Int
}

data nbd_proxy_serve_cited_tool_names: List<NonEmptyStr> = [
  nbdkit_cli_tool.name,
  websocat_cli_tool.name,
  socat_cli_tool.name,
]

fn nbd_proxy_serve_transport_intent(
  bmc_host: NonEmptyStr,
  session_token: NonEmptyStr,
  ws_path: NonEmptyStr,
  iso_path: NonEmptyStr,
  local_nbd_port: Int,
) -> NbdProxyServeTransportIntent {
  NbdProxyServeTransportIntent {
    bmc_host: bmc_host,
    session_token: session_token,
    ws_path: ws_path,
    iso_path: iso_path,
    local_nbd_port: local_nbd_port,
  }
}

fn bmcweb_session_login_program(bmc_host: NonEmptyStr, request_body_file: NonEmptyStr) -> ShellProgram {
  ShellProgram {
    set_e: true,
    statements: [
      command(words: [
        lit(text: curl_cli_tool.name),
        lit(text: "-sk"),
        lit(text: "-X"),
        lit(text: "POST"),
        lit(text: concat("https://", concat(bmc_host, "/login"))),
        lit(text: "-H"),
        lit(text: "Content-Type: application/json"),
        lit(text: "--data"),
        lit(text: concat("@", request_body_file)),
      ]),
    ],
  }
}

fn nbd_proxy_serve_program(intent: NbdProxyServeTransportIntent) -> ShellProgram {
  let port = to_string(intent.local_nbd_port)
  let wss_url = concat("wss://", concat(intent.bmc_host, intent.ws_path))
  let auth_header = concat("Authorization: Token ", intent.session_token)
  let socat_bridge = concat(
    "exec:'",
    concat(socat_cli_tool.name, concat(" STDIO TCP:127.0.0.1:", concat(port, "'"))),
  )
  ShellProgram {
    set_e: false,
    statements: [
      command(words: [
        lit(text: "set"),
        lit(text: "-euo"),
        lit(text: "pipefail"),
      ]),
      RawLine {
        text: concat(
          nbdkit_cli_tool.name,
          " file file=",
          intent.iso_path,
          " port=",
          port,
          " rdonly=yes &",
        ),
      },
      assign(name: "NBDKIT_PID", value: lit(text: "$!")),
      RawLine {
        text: concat("trap 'kill \"", concat("$NBDKIT_PID", "\"' EXIT INT TERM")),
      },
      command(words: [
        lit(text: websocat_cli_tool.name),
        lit(text: "-b"),
        lit(text: "--insecure"),
        lit(text: "-H"),
        lit(text: auth_header),
        lit(text: wss_url),
        lit(text: socat_bridge),
      ]),
    ],
  }
}

fn nbd_proxy_serve_script(intent: NbdProxyServeTransportIntent) -> String {
  serialize_bash(p: nbd_proxy_serve_program(intent: intent))
}

fn nbd_proxy_serve_program_statement_count(intent: NbdProxyServeTransportIntent) -> Int {
  nbd_proxy_serve_program(intent: intent).statements.length()
}

fn nbd_proxy_serve_program_foreground_command_is_websocat(intent: NbdProxyServeTransportIntent) -> Bool {
  nbd_proxy_serve_program_statement_count(intent: intent) == 5
    && nbd_proxy_serve_cited_tool_row_count() == 3
}

fn nbd_proxy_serve_requires_host_as_nbd_server() -> Bool {
  nbd_proxy_role_assignment.host_program_role == NbdServer
}

fn nbd_proxy_serve_cited_tool_row_count() -> Int {
  nbd_proxy_serve_cited_tool_names.length()
}
