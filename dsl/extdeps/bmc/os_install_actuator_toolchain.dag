module extdeps.bmc.os_install_actuator_toolchain

import std.types { NonEmptyStr, List }
import extdeps.tools { CliTool }
import extdeps.tools.curl { curl_cli_tool }
import extdeps.tools.websocat { websocat_cli_tool }
import extdeps.tools.nbdkit { nbdkit_cli_tool }
import extdeps.tools.socat { socat_cli_tool }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dsl/extdeps/bmc/os_install_actuator_toolchain.dag"
  }
}

type ActuatorHostToolchainGrant {
  host_label: NonEmptyStr
  required_tools: List<CliTool>
}

data srv3_os_install_actuator_host_label: NonEmptyStr = "install-actuator-host"

data srv3_os_install_actuator_toolchain_grant: ActuatorHostToolchainGrant = ActuatorHostToolchainGrant {
  host_label: srv3_os_install_actuator_host_label,
  required_tools: [
    curl_cli_tool,
    websocat_cli_tool,
    nbdkit_cli_tool,
    socat_cli_tool,
  ],
}

fn actuator_toolchain_grant_includes_tool(grant: ActuatorHostToolchainGrant, tool_name: NonEmptyStr) -> Bool {
  fold(
    grant.required_tools,
    init: false,
    f: (acc, tool) => acc || tool.name == tool_name
  )
}

fn srv3_os_install_actuator_toolchain_is_complete() -> Bool {
  actuator_toolchain_grant_includes_tool(
    grant: srv3_os_install_actuator_toolchain_grant,
    tool_name: curl_cli_tool.name
  )
    && actuator_toolchain_grant_includes_tool(
      grant: srv3_os_install_actuator_toolchain_grant,
      tool_name: websocat_cli_tool.name
    )
    && actuator_toolchain_grant_includes_tool(
      grant: srv3_os_install_actuator_toolchain_grant,
      tool_name: nbdkit_cli_tool.name
    )
    && actuator_toolchain_grant_includes_tool(
      grant: srv3_os_install_actuator_toolchain_grant,
      tool_name: socat_cli_tool.name
    )
}
