module extdeps.bmc.types

import std.measure {
  Watt,
  ByteSize,
  HardwareThreadCount,
  Celsius,
  RevolutionsPerMinute,
  byte_size,
  watt,
}
import std.types { NonEmptyStr, Int, List }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.dmtf.org/standards/redfish"
  }
}

type RedfishPowerState = On | Off | PoweringOn | PoweringOff

type RedfishProcessorSummary {
  model: NonEmptyStr
  processor_count: Int
  core_count: HardwareThreadCount
  logical_processor_count: HardwareThreadCount?
}

type RedfishMemorySummary {
  total_memory_bytes: ByteSize
}

type RedfishSystemInventory {
  model: NonEmptyStr
  manufacturer: NonEmptyStr?
  serial_number: NonEmptyStr?
  processor: RedfishProcessorSummary
  memory: RedfishMemorySummary
  power_state: RedfishPowerState
}

type RedfishPowerControl {
  member_id: NonEmptyStr
  name: NonEmptyStr?
  power_consumed_watts: Watt?
  power_limit_watts: Watt?
}

type RedfishPowerSubsystem {
  controls: List<RedfishPowerControl>
}

type RedfishTemperatureReading {
  member_id: NonEmptyStr
  name: NonEmptyStr?
  reading_celsius: Celsius?
}

type RedfishThermalSubsystem {
  temperatures: List<RedfishTemperatureReading>
}

type RedfishSensorReading =
    PowerSensor { name: NonEmptyStr, watts: Watt? }
  | TemperatureSensor { name: NonEmptyStr, celsius: Celsius? }
  | FanTachSensor { name: NonEmptyStr, rpm: RevolutionsPerMinute? }

type RedfishChassisSensorCollection {
  chassis_id: NonEmptyStr
  sensors: List<RedfishSensorReading>
}

type BmcTelemetrySnapshot {
  system: RedfishSystemInventory
  power: RedfishPowerSubsystem?
  thermal: RedfishThermalSubsystem?
  sensors: RedfishChassisSensorCollection?
}

type BmcGroundedHostObservations {
  processor_model: NonEmptyStr
  processor_core_count: HardwareThreadCount
  total_memory_bytes: ByteSize
  power_consumed_watts: Watt?
}

type RedfishBootSourceOverrideTarget =
    BootTargetNone
  | BootTargetPxe
  | BootTargetHdd
  | BootTargetCd
  | BootTargetUsb
  | BootTargetBiosSetup
  | BootTargetDiags

type RedfishBootSourceOverrideEnabled =
    BootOverrideDisabled
  | BootOverrideOnce
  | BootOverrideContinuous

type RedfishResetType =
    ResetForceOff
  | ResetForceOn
  | ResetForceRestart
  | ResetGracefulRestart
  | ResetGracefulShutdown
  | ResetPowerCycle

type RedfishAccountRole =
    AccountRoleAdministrator
  | AccountRoleOperator
  | AccountRoleReadOnly

type RedfishPrivilege =
    PrivilegeLogin
  | PrivilegeConfigureManager
  | PrivilegeConfigureUsers
  | PrivilegeConfigureComponents
  | PrivilegeConfigureSelf

fn redfish_boot_target_wire(t: RedfishBootSourceOverrideTarget) -> NonEmptyStr {
  match t {
    BootTargetNone => "None"
    BootTargetPxe => "Pxe"
    BootTargetHdd => "Hdd"
    BootTargetCd => "Cd"
    BootTargetUsb => "Usb"
    BootTargetBiosSetup => "BiosSetup"
    BootTargetDiags => "Diags"
  }
}

fn redfish_boot_override_enabled_wire(e: RedfishBootSourceOverrideEnabled) -> NonEmptyStr {
  match e {
    BootOverrideDisabled => "Disabled"
    BootOverrideOnce => "Once"
    BootOverrideContinuous => "Continuous"
  }
}

fn redfish_reset_type_wire(r: RedfishResetType) -> NonEmptyStr {
  match r {
    ResetForceOff => "ForceOff"
    ResetForceOn => "ForceOn"
    ResetForceRestart => "ForceRestart"
    ResetGracefulRestart => "GracefulRestart"
    ResetGracefulShutdown => "GracefulShutdown"
    ResetPowerCycle => "PowerCycle"
  }
}

fn redfish_account_role_wire(role: RedfishAccountRole) -> NonEmptyStr {
  match role {
    AccountRoleAdministrator => "Administrator"
    AccountRoleOperator => "Operator"
    AccountRoleReadOnly => "ReadOnly"
  }
}

fn redfish_privilege_wire(p: RedfishPrivilege) -> NonEmptyStr {
  match p {
    PrivilegeLogin => "Login"
    PrivilegeConfigureManager => "ConfigureManager"
    PrivilegeConfigureUsers => "ConfigureUsers"
    PrivilegeConfigureComponents => "ConfigureComponents"
    PrivilegeConfigureSelf => "ConfigureSelf"
  }
}
