// extdeps/cron/cron.dag — POSIX crontab shell transport (`cron.Tab` operations).
//
// Interface shape only (DESIGN.md §3): faithful `crontab` utility primitives.
// Schedule field grammar lives in `cron/schedule_model.dag` (`module extdeps.cron.schedule_model`).
// Tag-based upsert/remove idempotency is workflow policy — compose `List` + `Replace` in
// `gunbc/tools/cron_tag.dag`, not here.
//
// External authority: POSIX.1-2017 user crontab interface (crontab utility / on-disk entries)
// — schedule-shaped data cites the same POSIX volume as the carrier module header.

module extdeps.cron

// Co-locate the PUBLISHED mock corpus into this service's import closure (DESIGN.md §3: which
// cron.Tab operations are hermetically realizable is a fact ABOUT the cron service, so it belongs
// in the service's closure). Any consumer that imports extdeps.cron now transitively pulls the
// corpus, so the v1 runtime's eval_service_call (the M4 hermetic-realization fold) resolves the
// published-key set from item_registry — cron.Tab.List/Replace are GOVERNED in production via the
// same single model the M2 mock_totality_lens reads. (Bare import: the closure membership is the
// point, not a bound symbol — cf. filesystem_io.dag importing extdeps.filesystem.mock_corpus.)
// 🟡 gated — feature:m4-universal-hermetic-corpus-load — bind node://adhoc-2d1fb71c-1f4
// dissolve-on-arrival: M4.1 (fierce-crab-852) makes the runtime load the whole-tree published
// corpus independent of the entry's import closure (governance universal not opt-in); this
// per-service co-location import then deletes.
import extdeps.cron.mock_corpus

// 🟡 dissolved — feature:cron-mock-response — scaffold:hand-authored mock_response —
// dissolve-on-arrival: Phase-2-hermetic RecordedFixture replay from claim_batch --fixture-store
// (recorded wet via --record); the published corpus above (extdeps.cron.mock_corpus) now governs
// WHICH cron.Tab ops are hermetically realizable, and the fixture store owns the payloads (§3).
// forbidden: reintroducing mock_response constants for Hermetic dispatch on these shapes.
service cron.Tab {
  operation List {
    input {}
    output { entries: String from "stdout" }
    readonly
    transport shell { argv: ["crontab", "-l"] }
    exit {
      0 => Unit
      1 => Unit "No crontab for user"
    }
  }

  // Install crontab from stdin — POSIX `crontab -` (replaces the user's entire table).
  operation Replace {
    input { entries: String }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell {
      argv: ["crontab", "-"]
      stdin: entries
    }
    exit {
      0 => Unit
      nonzero => String "Crontab install failed"
    }
  }
}
