module extdeps.cron

service cron.Tab {
  operation List {
    input {}
    output { entries: String from "stdout" }
    readonly
    transport shell { argv: ["crontab", "-l"] }
    exit {
      0 => Unit
      1 => Unit "No crontab for user"
    }
  }

  operation Replace {
    input { entries: String }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell {
      argv: ["crontab", "-"]
      stdin: entries
    }
    exit {
      0 => Unit
      nonzero => String "Crontab install failed"
    }
  }
}
