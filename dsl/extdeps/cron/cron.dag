// extdeps/cron/cron.dag — POSIX crontab shell transport (`cron.Tab` operations).
//
// Interface shape only (DESIGN.md §3): faithful `crontab` utility primitives.
// Schedule field grammar lives in `cron/schedule_model.dag` (`module extdeps.cron.schedule_model`).
// Tag-based upsert/remove idempotency is workflow policy — compose `List` + `Replace` in
// `gunbc/tools/cron_tag.dag`, not here.
//
// External authority: POSIX.1-2017 user crontab interface (crontab utility / on-disk entries)
// — schedule-shaped data cites the same POSIX volume as the carrier module header.

module extdeps.cron

service cron.Tab {
  operation List {
    input {}
    output { entries: String from "stdout" }
    readonly
    transport shell { argv: ["crontab", "-l"] }
    exit {
      0 => Unit
      1 => Unit "No crontab for user"
    }
    mock_response {
      0 => { entries: "*/30 * * * * /usr/bin/review-agent run # tag:review-agent" } "Existing crontab"
    }
  }

  // Install crontab from stdin — POSIX `crontab -` (replaces the user's entire table).
  operation Replace {
    input { entries: String }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell {
      argv: ["crontab", "-"]
      stdin: entries
    }
    exit {
      0 => Unit
      nonzero => String "Crontab install failed"
    }
    mock_response {
      0 => { exit_success: true, stdout: "", stderr: "" } "Install succeeded"
    }
  }
}
