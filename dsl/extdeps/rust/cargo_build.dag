// extdeps/rust/cargo_build.dag -- the `cargo` command service (shell transport).
//
// Split out of `extdeps.cargo` (the pure Cargo model) so the model can be
// imported by compiler modules / the bootstrap seed without pulling a
// shell-transport service into the compiled set. Consumers that actually run
// cargo (e.g. tools/build.dag) import this module.
//
// §3 shape/transport/policy: argv is a faithful list-of-strings; policy flags are
// caller-supplied `List<String>` parameters (workflow), not hardcoded literals.

module extdeps.cargo_build

// Default input values for the cargo ops below. Build references `env` in its input
// block (not yet wired into shell argv). Clippy and Test are invoked from rust_gates_ci
// and must not carry a Map input — RecordedFixture cannot serialize Map (fail-closed §5).
data cargo_compile_env: Map<String, String> = empty_map()

// -- Service: shell transport wiring -----------------------------

service cargo.Build {
  operation Build {
    input { extra_args: List<String> = [], env: Map<String, String> = cargo_compile_env }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "build", extra_args] }
    exit {
      0 => Unit
      101 => String "Compilation failed"
    }
  }

  operation Test {
    input { extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "test", extra_args] }
    exit {
      0 => Unit
      101 => String "Tests failed"
    }
  }

  operation Clippy {
    input {
      extra_args: List<String> = []
      lint_args: List<String> = []
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "clippy", extra_args, "--", lint_args] }
    exit {
      0 => Unit
      101 => String "Clippy warnings or errors"
    }
  }

  operation Fmt {
    input {}
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "fmt", "--all", "--check"] }
    exit {
      0 => Unit
      1 => String "Formatting check failed"
    }
  }

  operation Doc {
    input {}
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell { argv: ["cargo", "doc", "--no-deps"] }
    exit {
      0 => Unit
      101 => String "Documentation generation failed"
    }
  }

  operation Run {
    input { package: String, bin: String, args: List<String> }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    // Note: args are appended to the command by the transport layer.
    transport shell { argv: ["cargo", "run", "-p", "\{package\}", "--bin", "\{bin\}", args] }
    exit {
      0 => Unit
      101 => String "Run failed"
      nonzero => String "Binary exited with error"
    }
  }
}
