module extdeps.cargo_build

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/commands/cargo-build.html"
  }
}

data cargo_compile_env: Map<String, String> = empty_map()

fn cargo_build_jobs_flag(count: Int) -> List<String> {
  ["--jobs", "{count}"]
}

fn cargo_nextest_build_jobs_flag(count: Int) -> List<String> {
  ["--build-jobs", "{count}"]
}

fn cargo_nextest_test_threads_flag(count: Int) -> List<String> {
  ["--test-threads", "{count}"]
}

service cargo.Build {
  operation Build {
    input { extra_args: List<String> = [], env: Map<String, String> = cargo_compile_env, build_jobs_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "build", build_jobs_args, extra_args] }
    exit {
      0 => Unit
      101 => String "Compilation failed"
    }
  }

  operation Test {
    input { extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }

    transport shell { argv: ["cargo", "test", extra_args] }
    exit {
      0 => Unit
      101 => String "Tests failed"
    }
  }

  operation Nextest {
    input { extra_args: List<String> = [], build_jobs_args: List<String> = [], test_threads_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "nextest", "run", build_jobs_args, test_threads_args, extra_args] }
    exit {
      0 => Unit
      100 => String "Tests failed"
      nonzero => String "Nextest run error"
    }
  }

  operation Clippy {
    input {
      extra_args: List<String> = []
      lint_args: List<String> = []
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "clippy", extra_args, "--", lint_args] }
    exit {
      0 => Unit
      101 => String "Clippy warnings or errors"
    }
  }

  operation Fmt {
    input { extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "fmt", extra_args] }
    exit {
      0 => Unit
      1 => String "Formatting check failed"
    }
  }

  operation Doc {
    input { extra_args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell { argv: ["cargo", "doc", extra_args] }
    exit {
      0 => Unit
      101 => String "Documentation generation failed"
    }
  }

  operation Run {
    input { package: String, bin: String, args: List<String> }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }

    transport shell { argv: ["cargo", "run", "-p", package, "--bin", bin, args] }
    exit {
      0 => Unit
      101 => String "Run failed"
      nonzero => String "Binary exited with error"
    }
  }
}
