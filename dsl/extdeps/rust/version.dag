// extdeps/rust/version.dag — Cargo version carriers (SemVer scheme + requirements).
//
// Fidelity — extdeps invariant (cite source; DESIGN.md §3):
//   Spec: https://doc.rust-lang.org/cargo/reference/manifest.html
//   Package version field: SemVer 2.0.0 (manifest.md#the-version-field).
//   Dependency version field: semver version requirement
//   (specifying-dependencies.md#specifying-dependencies) — caret/tilde/comparator
//   syntax, not a bare published version.
//
// Authority: extdeps.version.semver (semver.org), not std.types.SemVer.
//
// Consumers:
//   extdeps/rust/cargo.dag — `CargoPackage`, `RegistryDep`

module extdeps.cargo_version

import extdeps.version.semver { SemVerIdentity, SemVerConstraint }

// Published crate version in `[package].version` (crates.io / workspace manifests).
type CargoPackageVersion = SemVerIdentity

// Dependency version requirement in `[dependencies].crate = "…"`.
type CargoVersionRequirement = SemVerConstraint

// Single authority for the stage0/bootstrap crate package version token.
data default_stage0_package_version: CargoPackageVersion = "0.1.0"

// Render helpers exercised by witnesses (manifest emission reuses these tokens).
fn render_cargo_package_version_field(version: CargoPackageVersion) -> String {
  concat("version = \"", version, "\"")
}

fn render_cargo_version_requirement_toml(req: CargoVersionRequirement) -> String {
  concat("\"", req, "\"")
}
