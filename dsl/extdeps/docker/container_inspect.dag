module extdeps.docker.container_inspect

import std.types { Timestamp, String, Int, FilePath }
import std.nat { Nat }
import std.measure { ByteSize, byte_size, byte_size_count, Microsecond, microsecond_count }
import std.serialization { VariantEncoding, StringVariant, VariantNaming, AsAuthored }
import extdeps.docker.endpoint { docker_default_endpoint, docker_external_authority_anchor }

type ContainerState
  = Running
  | Paused
  | Exited
  | Dead
  | Restarting

type ContainerStateDetail {
  status: ContainerState
  running: Bool
  paused: Bool
  restarting: Bool
  oom_killed: Bool
  dead: Bool
  pid: Nat?
  exit_code: Int?
  error: String?
  started_at: Timestamp?
  finished_at: Timestamp?
}

type HostConfig {
  cpu_shares: Nat?
  memory: ByteSize?
  memory_reservation: ByteSize?
  memory_swap: ByteSize?
  cpu_period: Microsecond?
  cpu_quota: Microsecond?
  cpuset_cpus: String?
  cpuset_mems: String?
  blkio_weight: Nat?
  blkio_weight_device: List<String>?
  network_mode: String?
  pid_mode: String?
  ipc_mode: String?
  uts_mode: String?
  cap_add: List<String>?
  cap_drop: List<String>?
  exposed_ports: List<String>?
  port_bindings: List<String>?
  volumes: List<String>?
  volumes_from: List<String>?
  device_requests: List<String>?
}

type ContainerConfig {
  hostname: String?
  domainname: String?
  user: String?
  attach_stdin: Bool?
  attach_stdout: Bool?
  attach_stderr: Bool?
  tty: Bool?
  open_stdin: Bool?
  stdin_once: Bool?
  env: List<String>?
  cmd: List<String>?
  image: String?
  volumes: List<String>?
  working_dir: String?
  entrypoint: List<String>?
  labels: List<String>?
  mac_address: String?
  exposed_ports: List<String>?
  network_disabled: Bool?
}

data dissolve_on_hostconfig_containerconfig_anemic_leaves: List<String> = [
  "closure:decompose_hostconfig_containerconfig_string_lists|HostConfig carries structured concepts as List<String>?: cap_add/cap_drop (privilege names), exposed_ports/port_bindings (host:container port specs), volumes/volumes_from (mount source:target:mode), device_requests (structured device specs); ContainerConfig similar: env (KEY=VALUE pairs), cmd/entrypoint (command args), labels (KEY=VALUE metadata), volumes (mount specs), exposed_ports (port specs). All anemic-leaf §2 violations (structured wire shapes flattened to bare strings)|trigger:B3 grounds each as typed coproduct or decomposed record with named axes (e.g. PortBinding = {host_port: Nat, container_port: Nat, protocol: Protocol}, EnvVar = {key: String, value: String})"
]

type ContainerInspect {
  id: String
  created: Timestamp
  path: FilePath?
  args: List<String>?
  state: ContainerStateDetail
  image: String
  resolv_conf_path: FilePath?
  hostname: String?
  name: String?
  restart_count: Nat?
  driver: String?
  platform: String?
  config: ContainerConfig?
  network_settings: NetworkSettings?
  host_config: HostConfig?
}

type NetworkSettings {
  bridge: String?
  gateway: String?
  ip_address: String?
  ip_prefix_len: Nat?
  mac_address: String?
  networks: List<String>?
}

data dissolve_on_network_settings_bare_strings: List<String> = [
  "closure:ground_network_address_types|NetworkSettings.gateway/ip_address/mac_address are bare String?, should be typed with IP/MAC carriers (e.g. IpAddress, MacAddress, IpCidr); lower stakes since std/network primitives don't exist yet, but structured type system would catch malformed/invalid addresses (§5 fail-closed)|trigger:B3 introduces network address carriers in std/ (IPv4, IPv6, MacAddress with validation) or extdeps/network"
]

service docker.Container {
  config {
    endpoint: docker_default_endpoint
    auth: None

    retry: { max_attempts: 3, backoff: exponential, retry_on: [500, 502, 503, 504] }
  }

  operation Inspect {
    input {
      container_id: String
      size: Bool = false
    }
    output {
      container: ContainerInspect
    }
    readonly
    transport rest {
      method: GET,
      path: "/containers/\{container_id\}/json",
      query: { size: size }
    }
    response {
      200 => ContainerInspect
      404 => String
      500 => String
    }
  }
}

data dissolve_on_error_responses_opaque_strings: List<String> = [
  "closure:typed_error_responses|Error responses (404 => String, 500 => String) collapse two distinct error shapes (not-found vs server error) to opaque string, violating §5 fail-closed (errors must be typed and located with structured diagnostics). Docker API returns JSON error objects with reason/message; should be modeled as ErrorDetail coproduct or structured record (NotFound | ServerError variants with message and optional retry info)|trigger:B3 models error responses as typed variants with structured failure details, not opaque strings"
]

fn container_state_is_running(state: ContainerState) -> Bool =
  state == Running

fn container_inspect_memory_limit(inspect: ContainerInspect) -> ByteSize? {
  match inspect.host_config {
    null => none
    hc => hc.memory
  }
}

fn container_inspect_cpu_quota(inspect: ContainerInspect) -> Microsecond? {
  match inspect.host_config {
    null => none
    hc => hc.cpu_quota
  }
}

fn container_inspect_cpu_period(inspect: ContainerInspect) -> Microsecond? {
  match inspect.host_config {
    null => none
    hc => hc.cpu_period
  }
}

fn parse_container_state(raw: String) -> ContainerState? {
  match raw {
    "running" => Present { value: Running }
    "paused" => Present { value: Paused }
    "exited" => Present { value: Exited }
    "dead" => Present { value: Dead }
    "restarting" => Present { value: Restarting }
    _ => none
  }
}

fn container_state_wire_label(state: ContainerState) -> String {
  match state {
    Running => "running"
    Paused => "paused"
    Exited => "exited"
    Dead => "dead"
    Restarting => "restarting"
  }
}

data dissolve_on_variant_wire_fork_container_state: List<String> = [
  "closure:consolidate_variant_string_mapping|parse_container_state and container_state_wire_label are hand-forked forward/backward arms of one variant↔string table (§4 one grammar, read both directions); single rowset with derived bidirectional access dissolves the fork and eliminates silent divergence risk (§5)|trigger:B3 models ContainerState wire facts as single authority"
]
