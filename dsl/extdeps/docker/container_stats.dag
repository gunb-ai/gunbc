module extdeps.docker.container_stats

import std.types { Timestamp, String, Int, Float }
import std.nat { Nat }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.serialization { VariantEncoding, StringVariant, VariantNaming, AsAuthored }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.docker.com/engine/api/v1.47/#tag/Container/operation/ContainerStats"
  }
}

data wire_contract: VariantEncoding = StringVariant { naming: AsAuthored }

type CpuStats {
  cpu_usage: CpuUsage
  system_cpu_usage: Nat
  online_cpus: Nat
  cpu_percent: Float?
}

type CpuUsage {
  total_usage: Nat
  percpu_usage: List<Nat>?
  usage_in_kernelmode: Nat
  usage_in_usermode: Nat
}

type MemoryStats {
  usage: ByteSize
  max_usage: ByteSize
  limit: ByteSize
  failcnt: Nat?
}

type PidStats {
  current: Nat?
}

type ContainerStats {
  read: Timestamp
  pids_stats: PidStats?
  blkio_stats: BlkioStats?
  cpu_stats: CpuStats
  memory_stats: MemoryStats
  networks: Networks?
}

type BlkioStats {
  io_service_bytes_recursive: List<BlkioValue>?
  io_service_time_recursive: List<BlkioValue>?
  io_serviced_recursive: List<BlkioValue>?
  io_time_recursive: List<BlkioValue>?
  sectors_recursive: List<BlkioValue>?
}

type BlkioValue {
  op: String
  value: Nat
}

type NetworkStats {
  rx_bytes: ByteSize
  rx_packets: Nat
  rx_errors: Nat
  rx_dropped: Nat
  tx_bytes: ByteSize
  tx_packets: Nat
  tx_errors: Nat
  tx_dropped: Nat
}

type Networks {
  eth0: NetworkStats?
}

service docker.ContainerStats {
  config {
    endpoint: docker_default_endpoint
    auth: None

    retry: { max_attempts: 3, backoff: exponential, retry_on: [500, 502, 503, 504] }
  }

  operation GetStats {
    input {
      container_id: String
      stream: Bool = false
    }
    output {
      stats: ContainerStats
    }
    readonly
    transport rest {
      method: GET,
      path: "/containers/\{container_id\}/stats",
      query: { stream: stream }
    }
    response {
      200 => ContainerStats
      404 => String
      500 => String
    }
  }
}

data docker_default_endpoint: String = "unix:///var/run/docker.sock"

fn container_stats_memory_usage(stats: ContainerStats) -> ByteSize {
  stats.memory_stats.usage
}

fn container_stats_cpu_usage_total(stats: ContainerStats) -> Nat {
  stats.cpu_stats.cpu_usage.total_usage
}

fn container_stats_online_cpus(stats: ContainerStats) -> Nat {
  stats.cpu_stats.online_cpus
}
