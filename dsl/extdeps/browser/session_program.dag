module extdeps.browser.session_program

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.browser {
  BrowserPageOp,
  Goto, CurrentUrl, Title, WaitForSelector, QueryAll, Click, Fill, Evaluate,
  UploadFile, Screenshot, Wait, GetByRoleWaitFor, WaitForLoadState,
  LocatorCountWithText, WaitForLocatorText,
  LoadState, load_state_wire,
  ElementState, element_state_wire,
  OpArg, LitArg, RuntimeArg, JoinArg,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "playwright.dev/docs/api/class-page"
  }
}

fn js_str(s: String) -> String {
  concat("'", concat(replace(replace(s, "\\", "\\\\"), "'", "\\'"), "'"))
}

fn op_arg_js(a: OpArg) -> String {
  match a {
    LitArg { v: s } => js_str(s: s)
    RuntimeArg { name: n } => n
    JoinArg { left: l, right: r } => concat(op_arg_js(a: l), concat(" + ", op_arg_js(a: r)))
  }
}

fn op_page_js(op: BrowserPageOp, page: String) -> String {
  match op {
    Goto { url: u, wait_until: w } =>
      concat("await ", concat(page, concat(".goto(", concat(op_arg_js(a: u), concat(", { waitUntil: ", concat(js_str(s: load_state_wire(s: w)), ", timeout: 30000 })"))))))
    CurrentUrl => concat(page, ".url()")
    Title => concat("await ", concat(page, ".title()"))
    WaitForSelector { selector: s, state: st, timeout_ms: t } =>
      concat("await ", concat(page, concat(".waitForSelector(", concat(js_str(s: s), concat(", { state: ", concat(js_str(s: element_state_wire(s: st)), concat(", timeout: ", concat(to_string(t), " })"))))))))
    QueryAll { selector: s } =>
      concat("await ", concat(page, concat(".locator(", concat(js_str(s: s), ").count()"))))
    Click { selector: s } =>
      concat("await ", concat(page, concat(".click(", concat(js_str(s: s), ")"))))
    Fill { selector: s, text: x } =>
      concat("await ", concat(page, concat(".fill(", concat(js_str(s: s), concat(", ", concat(op_arg_js(a: x), ")"))))))
    Evaluate { expression: e } =>
      concat("await ", concat(page, concat(".evaluate(", concat(js_str(s: e), ")"))))
    UploadFile { selector: s, path: p } =>
      concat("await ", concat(page, concat(".setInputFiles(", concat(js_str(s: s), concat(", ", concat(op_arg_js(a: p), ")"))))))
    Screenshot { path: p } =>
      concat("await ", concat(page, concat(".screenshot({ path: ", concat(op_arg_js(a: p), " })"))))
    Wait { ms: m } =>
      concat("await ", concat(page, concat(".waitForTimeout(", concat(to_string(m), ")"))))
    GetByRoleWaitFor { role: r, name: n, timeout_ms: t } =>
      concat("await ", concat(page, concat(".getByRole(", concat(js_str(s: r), concat(", { name: ", concat(js_str(s: n), concat(" }).waitFor({ timeout: ", concat(to_string(t), " })"))))))))
    WaitForLoadState { state: st, timeout_ms: t } =>
      concat("await ", concat(page, concat(".waitForLoadState(", concat(js_str(s: load_state_wire(s: st)), concat(", { timeout: ", concat(to_string(t), " })"))))))
    LocatorCountWithText { selector: s, has_text: h } =>
      concat("await ", concat(page, concat(".locator(", concat(js_str(s: s), concat(", { hasText: ", concat(js_str(s: h), " }).count()"))))))
    WaitForLocatorText { selector: s, has_text: h, state: st, timeout_ms: t } =>
      concat("await ", concat(page, concat(".locator(", concat(js_str(s: s), concat(", { hasText: ", concat(js_str(s: h), concat(" }).first().waitFor({ state: ", concat(js_str(s: element_state_wire(s: st)), concat(", timeout: ", concat(to_string(t), " })"))))))))))
  }
}

fn op_stmt_line(op: BrowserPageOp, indent: String) -> String {
  concat(indent, concat(op_page_js(op: op, page: "page"), ";"))
}

fn render_ops(ops: List<BrowserPageOp>, indent: String) -> List<String> {
  map(ops, op => op_stmt_line(op: op, indent: indent))
}
