module extdeps.browser

import std.types { FilePath }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "playwright.dev/docs/api/class-browsercontext"
  }
}

type BrowserConfig {
  headless: Bool = false
  profile_path: FilePath
  viewport_width: Int = 1280
  viewport_height: Int = 900
}

type BrowserContext = String where brand("BrowserContext")
type Page           = String where brand("Page")
type Element        = String where brand("Element")

service browser.Context {
  operation Launch {
    input { headless: String = "false", profile_path: FilePath }
    output { context: BrowserContext from "stdout" }
    transport shell { argv: ["playwright-runner", "launch", "--headless", "{headless}", "--profile", "{profile_path}"] }
  }

  operation Close {
    input { context: BrowserContext }
    output {}
    transport shell { argv: ["playwright-runner", "close", "{context}"] }
  }
}

type LoadState
  = NetworkIdle
  | Load
  | DomContentLoaded

fn load_state_wire(s: LoadState) -> String {
  match s {
    NetworkIdle => "networkidle"
    Load => "load"
    DomContentLoaded => "domcontentloaded"
  }
}

type BrowserPageOp
  = Goto { url: String, wait_until: LoadState = DomContentLoaded }
  | CurrentUrl
  | Title
  | WaitForSelector { selector: String, timeout_ms: Int = 30000 }
  | QueryAll { selector: String }
  | Click { selector: String }
  | Fill { selector: String, text: String }
  | Evaluate { expression: String }
  | UploadFile { selector: String, path: String }
  | Screenshot { path: String }
  | Wait { ms: Int }
  | GetByRoleWaitFor { role: String, name: String, timeout_ms: Int = 30000 }
  | WaitForLoadState { state: LoadState = NetworkIdle, timeout_ms: Int = 30000 }
  | LocatorCountWithText { selector: String, has_text: String }

fn op_page_argv(op: BrowserPageOp) -> List<String> {
  match op {
    Goto { url: u, wait_until: w } => ["playwright-runner", "goto", u, "--wait-until", load_state_wire(s: w)]
    CurrentUrl => ["playwright-runner", "url"]
    Title => ["playwright-runner", "title"]
    WaitForSelector { selector: s, timeout_ms: t } => ["playwright-runner", "wait-for", s, "--timeout", to_string(t)]
    QueryAll { selector: s } => ["playwright-runner", "query-all", s]
    Click { selector: s } => ["playwright-runner", "click", s]
    Fill { selector: s, text: x } => ["playwright-runner", "fill", s, x]
    Evaluate { expression: e } => ["playwright-runner", "evaluate", e]
    UploadFile { selector: s, path: p } => ["playwright-runner", "upload", s, p]
    Screenshot { path: p } => ["playwright-runner", "screenshot", p]
    Wait { ms: m } => ["playwright-runner", "wait", to_string(m)]
    GetByRoleWaitFor { role: r, name: n, timeout_ms: t } => ["playwright-runner", "wait-for-role", r, "--name", n, "--timeout", to_string(t)]
    WaitForLoadState { state: st, timeout_ms: t } => ["playwright-runner", "wait-load-state", load_state_wire(s: st), "--timeout", to_string(t)]
    LocatorCountWithText { selector: s, has_text: h } => ["playwright-runner", "locator-count", s, "--has-text", h]
  }
}

service browser.Element {

  operation IsVisible {
    input { selector: String }
    output { visible: String from "stdout" }
    transport shell { argv: ["playwright-runner", "is-visible", "{selector}"] }
  }

  operation InnerText {
    input { selector: String }
    output { text: String from "stdout" }
    transport shell { argv: ["playwright-runner", "inner-text", "{selector}"] }
  }

  operation EvaluateOn {
    input { selector: String, expression: String }
    output { result: String from "stdout" }
    transport shell { argv: ["playwright-runner", "evaluate-on", "{selector}", "{expression}"] }
  }
}
