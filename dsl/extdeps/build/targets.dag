// extdeps/build/targets.dag -- Shared build/workflow target schema.
//
// Stable model for repo build/workflow targets independent of any concrete
// output syntax. Makefile/Justfile renderers consume this schema and project it
// into their own surface models.
//
// Recipe lines use the RecipeLine type from extdeps.build.make so that semantic
// flags (silent, ignore_errors) are structured data, not embedded string
// prefixes. Renderers derive the correct syntax (Make's "@", Just's "@",
// etc.) from these flags.

module extdeps.build.targets

import extdeps.build.make { RecipeLine, EnvBinding }

// Entrypoint parameter exposed through generated build projections.
type EntrypointParam {
  port_name: String
  make_var: String
  cli_flag: String
  type_hint: String
  default: String?
  repeatable: Bool
}

// A core build workflow (e.g., "codegen", "build", "testgen").
type CoreWorkflow {
  name: String
  description: String
  deps: List<String>
  body: List<RecipeLine>
  comment: String?
}

// What resource a meta target needs and how.
type ResourceNeed {
  resource: String
  mode: String
}

// A meta target definition (e.g., "test", "check", "fmt").
type MetaTargetDef {
  name: String
  description: String
  has_check: Bool
  has_fix: Bool
  command: RecipeLine
  check_command: RecipeLine?
  fix_command: RecipeLine?
  env: List<EnvBinding>
  resource_needs: List<ResourceNeed>
  fix_prerequisites: List<String>
}

// Maps a resource identifier to its ensure/verify target names.
type ResourceTargetEntry {
  resource: String
  ensure_target: String
  verify_target: String
}

// Extra composite target for a tool (e.g., "viz-serve").
type ExtraTarget {
  suffix: String
  description: String
  post_commands: List<String>
}

// A tool discovered at build time via inventory/DSL introspection.
type DiscoveredTool {
  short_name: String
  description: String
  binary_name: String
  command: String
  dry_run_command: String
  deps: List<String>
  entrypoints: List<EntrypointParam>
  extra_targets: List<ExtraTarget>
}
