// extdeps/build/make.dag -- "What is GNU Make?"
//
// GNU Make is a build automation tool that reads Makefiles to determine
// which pieces of a program need to be recompiled, and issues the
// commands to recompile them.
//
// This module models Make's interface: recipe syntax, echoing behavior,
// target rules, and phony declarations. Types here are the source of
// truth for what "@", "-", and "+" mean in recipe lines.
//
// Reference: https://www.gnu.org/software/make/manual/make.html
//
// Consumers:
//   extdeps/build/make_render.dag    -- Makefile text serializer
//   extdeps/build/targets.dag        -- shared build-target schema (imports RecipeLine)

module extdeps.build.make

import std.render { OutputFormat }

// §5.2 Recipe Echoing
// "Normally, make prints each line of the recipe before it is executed.
//  We call this echoing because it gives the appearance that you are
//  typing the lines yourself."
//
// §5.2: "When a line starts with '@', the echoing of that line is
//  suppressed. The '@' is discarded before the line is passed to the
//  shell."
//
// §5.5 Errors in Recipes: "To ignore errors in a recipe line, write
//  a '-' at the beginning of the line's text."
//
// §5.7.1: "A line that begins with '+' is run even if make is invoked
//  in a 'do not execute' mode."
type RecipePrefix = Silent | IgnoreErrors | AlwaysRun

// §5.1 Recipe Syntax
//
// A recipe line is a shell command preceded by a tab character (or the
// character set by .RECIPEPREFIX). Recipe lines may carry prefix flags
// that modify echoing, error handling, and dry-run behavior.
//
// This type models a single recipe line with its semantic flags
// separated from the shell command, so renderers can apply the correct
// syntax per output format.
type RecipeLine {
  shell: String
  silent: Bool
  ignore_errors: Bool
}

// §6.10 Variables from the Environment
//
// "Every environment variable that make sees when it starts up is
//  transformed into a make variable with the same name and value."
//
// Recipe lines can set per-command environment variables:
//   VAR=value command args...
type EnvBinding {
  name: String
  value: String
}

// §2.1 What a Rule Looks Like
//
// "A simple makefile consists of rules with the following shape:
//   target ...: prerequisites ...
//           recipe
//           ..."
type MakeRule {
  target: String
  prerequisites: List<String>
  recipe: List<RecipeLine>
  comment: String?
}

// §4.6 Phony Targets
//
// "A phony target is one that is not really the name of a file; rather
//  it is just a name for a recipe to be executed when you make an
//  explicit request."
//
// ".PHONY: clean" declares 'clean' as phony so make doesn't look for
// a file called 'clean'.
type PhonyDeclaration {
  targets: List<String>
}

// §2.5 Letting make Deduce the Recipes / .DEFAULT_GOAL
//
// "By default, the goal is the first target of the first rule in the
//  first makefile." The .DEFAULT_GOAL variable overrides this.
type DefaultGoal {
  target: String
}

// §5.7.2 Communicating Variables to a Sub-make
//
// "Recursive use of make means using make as a command in a makefile.
//  ... Always use the variable MAKE, not the explicit command name
//  'make', when you mean recursive invocation."
//
// $(MAKE) ensures the same make executable and -j parallelism are
// inherited by sub-makes.
type MakeInvocation {
  target: String
  silent: Bool
}

// Complete Makefile document.
type Makefile {
  header: String?
  default_goal: String
  phony: List<String>
  rules: List<MakeRule>
}

// OutputFormat parameterization for GNU Make.
data make_output_format: OutputFormat = {
  name: "Makefile",
  indent_unit: "\t",
  kv_separator: " = ",
  list_prefix: "",
  comment_prefix: "#",
  section_separator: "\n",
  trailing_newline: true
}
