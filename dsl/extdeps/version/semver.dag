// extdeps/version/semver.dag — Semantic Versioning scheme (slice 2 + 2b).
//
// Spec: https://semver.org/
//
// Inhabits extdeps.version carriers — not std.types.SemVer (String alias; OCI migration
// is a separate escalation-gated PR). Ecosystem consumers (Cargo package version, etc.)
// import SemVerIdentity / SemVerConstraint from here.
//
// Slice 2b: structured MAJOR.MINOR.PATCH decomposition + semver-aware ordering on
// `SemVerVersion`. `VersionScheme.compare` on opaque `VersionIdentity` uses wire-label
// lexicographic ordering until parse ingress lands (dissolve-on: parse_semver_version).

module extdeps.version.semver

import extdeps.version { VersionIdentity, VersionScheme, VersionConstraint }
import std.algebra { Ordering, Less, Equal, Greater, length, list_head, list_head_value, skip }
import std.integer { NonNegativeInt }
import std.list { List }
import std.nat { nat_compare }
import std.types { NonEmptyStr }

// Published semver version label (MAJOR.MINOR.PATCH wire form).
type SemVerIdentity = VersionIdentity

// Semver version requirement / comparator wire text — not a published identity.
type SemVerConstraint = VersionConstraint

// Pre-release / build identifier (semver.org §9–§10).
type SemVerIdentifier
  = SemVerNumericIdentifier { value: NonNegativeInt }
  | SemVerAlphanumericIdentifier { label: NonEmptyStr }

// Decomposed semver version. Build metadata is informational and ignored in
// precedence (semver.org §11).
type SemVerVersion {
  major: NonNegativeInt
  minor: NonNegativeInt
  patch: NonNegativeInt
  pre_release: List<SemVerIdentifier>
  build: List<SemVerIdentifier>
}

fn semver_compare_non_negative_int(a: NonNegativeInt, b: NonNegativeInt) -> Ordering {
  nat_compare(a: a, b: b)
}

fn semver_compare_identifier(a: SemVerIdentifier, b: SemVerIdentifier) -> Ordering {
  match a {
    SemVerNumericIdentifier { value: av } => match b {
      SemVerNumericIdentifier { value: bv } =>
        semver_compare_non_negative_int(a: av, b: bv)
      SemVerAlphanumericIdentifier { label: _ } => Less
    }
    SemVerAlphanumericIdentifier { label: al } => match b {
      SemVerNumericIdentifier { value: _ } => Greater
      SemVerAlphanumericIdentifier { label: bl } =>
        if al < bl { Less } else { if al > bl { Greater } else { Equal } }
    }
  }
}

fn semver_compare_identifiers(a: List<SemVerIdentifier>, b: List<SemVerIdentifier>) -> Ordering {
  if length(xs: a) == 0 && length(xs: b) == 0 { Equal }
  // semver.org §11.4.4: when all preceding identifiers are equal, the longer set wins.
  else if length(xs: a) == 0 { Less }
  else if length(xs: b) == 0 { Greater }
  else {
    match semver_compare_identifier(a: list_head_value(xs: a), b: list_head_value(xs: b)) {
      Equal =>
        semver_compare_identifiers(
          a: skip(xs: a, n: 1),
          b: skip(xs: b, n: 1)
        )
      other => other
    }
  }
}

fn semver_compare_pre_release(a: List<SemVerIdentifier>, b: List<SemVerIdentifier>) -> Ordering {
  if length(xs: a) == 0 && length(xs: b) == 0 { Equal }
  else if length(xs: a) == 0 { Greater }
  else if length(xs: b) == 0 { Less }
  else { semver_compare_identifiers(a: a, b: b) }
}

fn semver_compare(a: SemVerVersion, b: SemVerVersion) -> Ordering {
  match semver_compare_non_negative_int(a: a.major, b: b.major) {
    Equal =>
      match semver_compare_non_negative_int(a: a.minor, b: b.minor) {
        Equal =>
          match semver_compare_non_negative_int(a: a.patch, b: b.patch) {
            Equal => semver_compare_pre_release(a: a.pre_release, b: b.pre_release)
            other => other
          }
        other => other
      }
    other => other
  }
}

fn semver_identifier_label(id: SemVerIdentifier) -> String {
  match id {
    SemVerNumericIdentifier { value: v } => "{v}"
    SemVerAlphanumericIdentifier { label: s } => s
  }
}

fn semver_identifiers_label(ids: List<SemVerIdentifier>) -> String {
  ids |> map(id => semver_identifier_label(id: id)) |> join(separator: ".")
}

fn semver_version_label(v: SemVerVersion) -> String {
  let core = concat(
    to_string(v.major),
    concat(".", concat(to_string(v.minor), concat(".", to_string(v.patch))))
  )
  let with_pre = if length(xs: v.pre_release) == 0 {
    core
  } else {
    concat(core, concat("-", semver_identifiers_label(ids: v.pre_release)))
  }
  if length(xs: v.build) == 0 {
    with_pre
  } else {
    concat(with_pre, concat("+", semver_identifiers_label(ids: v.build)))
  }
}

fn semver_to_version_identity(v: SemVerVersion) -> VersionIdentity {
  semver_version_label(v: v)
}

// VersionIdentity ingress for extdeps.version.VersionScheme.
// Interim: lexicographic order on wire labels (deterministic total order, not
// semver-aware — pre-release segments can sort wrong on the opaque surface).
// Scaffold: dissolve-on: parse_semver_version lands — replace body with:
//   (a, b) => semver_compare(a: parse_semver_version(a), b: parse_semver_version(b))
fn semver_identity_compare(a: VersionIdentity, b: VersionIdentity) -> Ordering {
  if a == b { Equal } else { if a < b { Less } else { Greater } }
}

data semver_scheme: VersionScheme = {
  compare: semver_identity_compare
}
