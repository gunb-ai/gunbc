module extdeps.entropy

import std.integer { UInt8 }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.disposition { Disposition, Scaffold, SingleAuthority, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man4/random.4.html"
  }
}

data entropy_transport_linux_gnu_only: String = "🟡 SCAFFOLD — transport is Linux/GNU-coreutils-only: head(1) from util-linux, base64(1) -w 0 from GNU coreutils (macOS/BSD base64 uses -b 0). Dissolution trigger: per-OS dispatch realization (extdeps/entropy/linux.dag, bsd.dag) replaces this single shell pipeline."

data entropy_count_bytes_unit_debt: String = "🟡 SCAFFOLD — count: Int is a flat-scalar unit field for bytes-to-read; grounded carrier is ByteSize (std.measure). std.resources Entropy.read_bytes already uses ByteSize; this transport input stays Int because head(1) accepts a plain integer and ByteSize extraction is not yet wired at the shell-argv interpolation layer. Dissolve-on: feature:bytesize-argv-interpolation — argv interpolation supports ByteSize extraction (byte_size_count); count migrates to ByteSize and this note drops."

service Urandom {
  operation ReadBytes {
    input { count: Int }
    output { octets_b64: String from "stdout" }
    readonly
    transport shell { argv: ["sh", "-c", "head -c {count} /dev/urandom | base64 -w 0"] }
    exit {
      0 => Unit
      nonzero => String "Urandom.ReadBytes: /dev/urandom or base64 failed"
    }
  }
}
