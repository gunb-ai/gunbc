// extdeps/api/github_ops.dag -- GitHub API operational detail.

module extdeps.api.github_ops

import std.rate_limit { RateLimit, ResetStrategy }

type GitHubProductTier = Free | Pro | Team | EnterpriseCloud | EnterpriseServer

type GitHubApiVersion {
  date: String
  header: String
}

type GitHubRateLimitScope = Core | Search | GraphQL | CodeSearch

type GitHubAppAuth {
  jwt_expiry_minutes: Int
  clock_skew_seconds: Int
  installation_token_ttl: Int
}

type GitHubPollingConfig {
  interval_seconds: Int
  max_wait_seconds: Int
}

type GitHubRateLimitSpec {
  tier: GitHubProductTier
  scope: GitHubRateLimitScope
  limit: RateLimit
}

data supported_api_version: GitHubApiVersion = {
  date: "2022-11-28",
  header: "X-GitHub-Api-Version"
}

data github_app_auth: GitHubAppAuth = {
  jwt_expiry_minutes: 9,
  clock_skew_seconds: 60,
  installation_token_ttl: 3600
}

data polling_default: GitHubPollingConfig = {
  interval_seconds: 30,
  max_wait_seconds: 1800
}

