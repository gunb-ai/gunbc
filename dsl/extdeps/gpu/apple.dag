module extdeps.gpu.apple

import std.measure { ByteSize, gibibyte, gibibyte_to_byte_size }
import extdeps.gpu.types { GpuModelCatalogRow, GpuFacts, GpuRuntime, Metal }
import extdeps.memory.types { MemoryFacts, UnifiedShared }
import extdeps.vendor.apple { apple }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.apple.com/macbook-pro/specs/"
  }
}

data apple_m5_unified_memory_bytes: ByteSize = gibibyte_to_byte_size(g: gibibyte(24))

data apple_m5_gpu_catalog: GpuModelCatalogRow = GpuModelCatalogRow {
  model_number: "Apple M5 GPU"
  vendor: apple
  compute_capability: none
  memory: MemoryFacts {
    capacity: apple_m5_unified_memory_bytes
    memory_kind: UnifiedShared
  }
  supported_runtimes: [Metal]
  wgpu_dispatch_device_label: "apple-m5-metal"
}

data apple_silicon_m5_gpu: GpuFacts = GpuFacts {
  catalog: apple_m5_gpu_catalog
}
