// extdeps/realization/parse_table_memo.dag — gunbc in-process parse-table memo (operator facts).
//
// Realization carrier for v2.compiler.parse ParseTable — dissolves hand-rolled Map threading.

module extdeps.realization.parse_table_memo

import extdeps.cache.types { CacheInterfaceCatalogFacts }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  CasContentEncoding,
  ContentAddressedByValue,
  UpsertSubject,
  ContentAddressLookup,
  OverwriteAllowed,
  MissThenCreate,
  StructuredArtifact,
  InProcess,
  Never,
  PerFile,
  None,
  InProcessNs,
  Strong,
  OperatorObserved,
  ManualPurge,
  Repo,
}

data parse_table_memo_id: CacheInterfaceId = "parse_table_memo_cache"

// In-process parse memo: content-addressed (grammar_digest × token_stream_digest × position × production).
// Grammar scopes the in-process store; token_stream_digest prevents cross-source cell reuse.
data parse_table_memo_facts: CacheInterfaceCatalogFacts = {
  identity: parse_table_memo_id
  backing_surface: "gunbc-parse-table-in-process"
  transport_encoding: CasContentEncoding
  key_derivation: {
    classification: ContentAddressedByValue
    inputs_considered: [UpsertSubject]
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Repo
    invalidation_triggers: [ManualPurge]
  }
  io: {
    lookup_semantics: ContentAddressLookup
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: StructuredArtifact
    locality: InProcess
    eviction: Never
    atomicity: PerFile
    auth: None
    read_latency: InProcessNs
    consistency: Strong
  }
  evidence: [
    {
      field: "locality"
      evidence: OperatorObserved {
        note: "scoped to InterpContext; drops with evaluation — within-run memo (design-recompute-memoization §4.1)"
        observed_at: 0
      }
    },
    {
      field: "key_derivation"
      evidence: OperatorObserved {
        note: "ParseTableSubject = grammar_digest + token_stream_digest (full stream content-address incl. lexemes) + position + production"
        observed_at: 0
      }
    },
  ]
}
