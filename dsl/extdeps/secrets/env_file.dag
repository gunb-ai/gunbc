// extdeps/secrets/env_file.dag -- "What is a .env file?"

module extdeps.secrets.env_file

import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

type EnvEntry {
  key: String
  value: String
  comment: String?
}

type EnvFile {
  path: String
  entries: List<EnvEntry>
}

type EnvValidation {
  required_keys: List<String>
  format_rules: List<String>
}

type EnvOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data parsing_rules: List<String> = [
  "Ignore blank lines",
  "Ignore lines starting with #",
  "Split key/value at first = character",
  "Preserve quoted values as literal payload",
  "Treat leading export prefix as optional syntax sugar"
]

data operation_behaviors: List<EnvOperationBehavior> = [
  {
    operation: "Load",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["path"],
      determinism: Deterministic,
      failure_modes: [{ name: "ParseError", condition: "invalid_line_format", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "missing file may be silent depending on loader options", trigger: "dotenv_missing_file", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: ".env file path is readable", kind: Infrastructure }],
      assumptions: ["Callers intentionally choose whether existing process env may be overridden"],
      unknowns: ["Cross-platform newline normalization differences for escaped values"]
    }
  },
  {
    operation: "Get",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "MissingVar", condition: "variable_not_set", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [],
      assumptions: ["Process environment is authoritative for lookup"],
      unknowns: []
    }
  },
  {
    operation: "Set",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["path", "key"],
      determinism: Deterministic,
      failure_modes: [{ name: "PermissionDenied", condition: "file_not_writable", http_status: null, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: HighConfidence,
      prerequisites: [{ description: "target file is writable", kind: Infrastructure }],
      assumptions: ["Encoding is UTF-8 compatible for key/value text"],
      unknowns: ["Concurrent writer conflict handling strategy"]
    }
  },
  {
    operation: "List",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [],
      confidence: HighConfidence,
      prerequisites: [{ description: "target file is readable", kind: Infrastructure }],
      assumptions: ["Parser consistently orders returned keys by file order"],
      unknowns: []
    }
  },
  {
    operation: "Validate",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "validation returns missing and extra keys rather than mutating files", trigger: null, severity: Low }],
      confidence: Documented,
      prerequisites: [],
      assumptions: ["Template schema is complete for intended environment"],
      unknowns: []
    }
  },
  {
    operation: "GenerateExample",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["path"],
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "template generation must avoid writing real secret values", trigger: "secret_leakage", severity: Critical }],
      confidence: HighConfidence,
      prerequisites: [{ description: "schema exists for expected env variables", kind: Tooling }],
      assumptions: ["Generated example file is intended for onboarding only"],
      unknowns: []
    }
  }
]
