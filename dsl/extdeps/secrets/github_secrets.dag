// extdeps/secrets/github_secrets.dag -- "What is GitHub Secrets?"

module extdeps.secrets.github_secrets

import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

type GitHubSecretScope = Repository | Environment | Organization

type GitHubPublicKey {
  key_id: String
  key: String
}

type OidcTokenClaims {
  sub: String
  aud: String
  iss: String
  ref: String?
  sha: String?
  repository: String?
}

type GitHubSecretsOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

type EncryptionModel {
  algorithm: String
  key_source: String
  payload_encoding: String
}

data github_encryption_model: EncryptionModel = {
  algorithm: "libsodium sealed box",
  key_source: "repo/environment/org public key endpoint",
  payload_encoding: "base64"
}

data operation_behaviors: List<GitHubSecretsOperationBehavior> = [
  {
    operation: "ListRepoSecrets",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "values are write-only and never returned", trigger: null, severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "token has actions:read scope", kind: Credential }],
      assumptions: ["Pagination order is stable enough for deterministic scans"],
      unknowns: ["Rate-limit behavior under large organization secret inventories"]
    }
  },
  {
    operation: "GetRepoSecret",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "secret_missing", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "metadata only; secret value is never retrievable", trigger: null, severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "token has actions:read scope", kind: Credential }],
      assumptions: ["Secret metadata reflects latest update timestamp"],
      unknowns: ["Consistency window between create/update and metadata reads"]
    }
  },
  {
    operation: "GetPublicKey",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [],
      edge_cases: [{ description: "public keys rotate periodically; fetch fresh before encryption", trigger: "stale_key_cache", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "token can read repository metadata", kind: Credential }],
      assumptions: ["Provider key endpoint is globally reachable from caller"],
      unknowns: ["Rotation cadence and overlap window for old/new key acceptance"]
    }
  },
  {
    operation: "CreateOrUpdateRepoSecret",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["owner", "repo", "secret_name"],
      determinism: Deterministic,
      failure_modes: [{ name: "ValidationFailed", condition: "invalid_secret_name", http_status: 422, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "updates overwrite prior value; there is no version history", trigger: "reusing_secret_name", severity: High }],
      confidence: Documented,
      prerequisites: [
        { description: "token has actions:write scope", kind: Credential },
        { description: "encrypted_value produced with current key_id", kind: Tooling }
      ],
      assumptions: ["Secret names match provider regex constraints"],
      unknowns: ["Propagation delay from update to workflow runtime visibility"]
    }
  },
  {
    operation: "DeleteRepoSecret",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["owner", "repo", "secret_name"],
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [],
      confidence: HighConfidence,
      prerequisites: [{ description: "token has actions:write scope", kind: Credential }],
      assumptions: ["Delete is immediate for future workflow runs"],
      unknowns: ["How quickly running workflows lose access to deleted secret values"]
    }
  },
  {
    operation: "ListEnvironmentSecrets",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "scope constrained to a deployment environment", trigger: "environment_mismatch", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "token can read environment metadata", kind: Credential }],
      assumptions: ["Environment identifiers are resolved to repository IDs"],
      unknowns: ["Pagination behavior for very large environment secret sets"]
    }
  },
  {
    operation: "GetOidcToken",
    behavior: {
      side_effects: ReadOnly,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [{ name: "PermissionDenied", condition: "missing_id_token_write_permission", http_status: 403, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "claims vary by workflow context (ref, sha, repo)", trigger: "different_runner_context", severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "workflow grants id-token:write", kind: Policy }],
      assumptions: ["JWT signing keys are trusted by downstream verifier"],
      unknowns: ["Exact token issuance latency under high Actions load"]
    }
  },
  {
    operation: "AccessSecretInWorkflow",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "missing secret resolves to empty string rather than hard failure", trigger: "absent_secret_reference", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "secret is scoped to the workflow context", kind: Infrastructure }],
      assumptions: ["Runner masking protects secret values in logs"],
      unknowns: ["Provider-side masking edge cases for multiline secret payloads"]
    }
  }
]
