// extdeps/secrets/gcp_secret_manager.dag -- "What is GCP Secret Manager?"

module extdeps.secrets.gcp_secret_manager

import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}
import std.rate_limit { RateLimit, PropagationDelay, ResetStrategy }
import extdeps.secrets.secrets { SecretLifecycle, SecretVersion, SecretEncryption, RotationPolicy }

type GcpReplicationPolicy = Automatic | UserManaged { locations: List<String> }

type GcpSecret {
  project: String
  secret_id: String
  replication: GcpReplicationPolicy
  rotation: RotationPolicy?
  encryption: SecretEncryption
}

type GcpSecretVersion {
  name: String
  version: SecretVersion
}

type GcpOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

type GcpMethodRateLimit {
  operation: String
  limit: RateLimit
}

data operation_behaviors: List<GcpOperationBehavior> = [
  {
    operation: "AccessVersion",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "secret_or_version_missing", http_status: 404, recoverable: false, retry_safe: false },
        { name: "PermissionDenied", condition: "missing_secret_accessor_role", http_status: 403, recoverable: false, retry_safe: false },
        { name: "VersionUnavailable", condition: "version_disabled_or_destroyed", http_status: 409, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "version can be numeric or latest alias", trigger: "version=latest", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "ADC credential with secretmanager.versions.access", kind: Credential }],
      assumptions: ["Project and secret identifiers are valid and routable"],
      unknowns: ["Exact IAM policy propagation delay for newly granted access"]
    }
  },
  {
    operation: "CreateSecret",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["project", "secret_id"],
      determinism: Deterministic,
      failure_modes: [{ name: "AlreadyExists", condition: "duplicate_secret_id", http_status: 409, recoverable: true, retry_safe: false }],
      edge_cases: [{ description: "create only provisions metadata; value added in a second call", trigger: "missing_add_version", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.secrets.create permission", kind: Capability }],
      assumptions: ["Replication policy selection is accepted by org policy"],
      unknowns: ["Cross-region metadata convergence under control-plane incidents"]
    }
  },
  {
    operation: "AddVersion",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "parent_secret_missing", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "new version starts in ENABLED state", trigger: null, severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.versions.add permission", kind: Capability }],
      assumptions: ["Version append never mutates prior version payloads"],
      unknowns: ["Per-secret throughput limits for version creation bursts"]
    }
  },
  {
    operation: "ListSecrets",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: EventuallyConsistent,
      failure_modes: [],
      edge_cases: [{ description: "response is paginated by page_token", trigger: "large_secret_sets", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.secrets.list permission", kind: Capability }],
      assumptions: ["Pagination cursors remain valid during short listing windows"],
      unknowns: ["Latency variability under very high cardinality projects"]
    }
  },
  {
    operation: "GetSecret",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "secret_missing", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.secrets.get permission", kind: Capability }],
      assumptions: ["Metadata reads are strongly consistent enough for policy checks"],
      unknowns: ["Behavior during transient control-plane partitions"]
    }
  },
  {
    operation: "DestroyVersion",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "destroy is irreversible", trigger: "operator_mistake", severity: Critical }],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.versions.destroy permission", kind: Capability }],
      assumptions: ["Destroy tombstones payload permanently"],
      unknowns: ["Retention metadata visibility for destroyed versions"]
    }
  },
  {
    operation: "DisableVersion",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "disable blocks access but preserves data", trigger: null, severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.versions.disable permission", kind: Capability }],
      assumptions: ["State transitions obey ENABLED->DISABLED semantics"],
      unknowns: ["Transient delays before disable is globally enforced"]
    }
  },
  {
    operation: "EnableVersion",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "enable may race with concurrent destroy", trigger: "concurrent_mutation", severity: High }],
      confidence: HighConfidence,
      prerequisites: [{ description: "secretmanager.versions.enable permission", kind: Capability }],
      assumptions: ["Version lifecycle transitions are serialized by provider"],
      unknowns: ["Observed behavior under rapid flip-flop enable/disable requests"]
    }
  }
]

data method_rate_limits: List<GcpMethodRateLimit> = [
  {
    operation: "AccessVersion",
    limit: {
      scope: "gcp.secret_manager.access",
      requests_per_window: 60000,
      window_seconds: 60,
      burst: 6000,
      reset_strategy: SlidingWindow
    }
  },
  {
    operation: "CreateSecret",
    limit: {
      scope: "gcp.secret_manager.write",
      requests_per_window: 6000,
      window_seconds: 60,
      burst: 1000,
      reset_strategy: SlidingWindow
    }
  }
]

data propagation_delays: List<PropagationDelay> = [
  {
    typical_ms: 30000,
    max_ms: 120000,
    description: "IAM policy grants can take time before access checks pass"
  }
]
