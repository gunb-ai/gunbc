      edge_cases: [],
      confidence: HighConfidence,
      prerequisites: [{ description: "OIDC role + bound claims configured", kind: Policy }],
      assumptions: ["Issuer keys are reachable for signature verification"],
      unknowns: []
    }
  },
  {
    operation: "DatabaseCreds",
    behavior: {
      side_effects: WritesState,
