      confidence: Documented,
      prerequisites: [{ description: "valid token is already present", kind: Credential }],
      assumptions: ["Token lookup endpoint available in current auth mount"],
      unknowns: []
    }
  },
  {
    operation: "AuthAppRole",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [{ name: "InvalidCreds", condition: "role_id_or_secret_id_invalid", http_status: 400, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "role_id and secret_id are provisioned", kind: Credential }],
