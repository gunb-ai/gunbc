// extdeps/secrets/vault.dag -- "What is HashiCorp Vault?"

module extdeps.secrets.vault

import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

type VaultEngine = Kv2 | Transit | Database | Pki

type VaultAuth = AppRole | Oidc | Token | Kubernetes

type VaultLease {
  id: String
  ttl_seconds: Int
  renewable: Bool
}

type VaultPolicy {
  name: String
  rules: List<String>
}

type DynamicCredential {
  engine: VaultEngine
  role: String
  ttl: Int
}

type VaultOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

type LeaseLifecycleState = Issued | Renewable | Expired | Revoked

data lease_lifecycle: List<LeaseLifecycleState> = [Issued, Renewable, Expired, Revoked]

data operation_behaviors: List<VaultOperationBehavior> = [
  {
    operation: "KvRead",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "path_missing_or_version_deleted", http_status: 404, recoverable: false, retry_safe: false },
        { name: "Denied", condition: "policy_denies_read", http_status: 403, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "version=0 resolves to latest", trigger: "implicit_version", severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "valid Vault token with read policy", kind: Credential }],
      assumptions: ["KV v2 mount semantics are enabled at mount path"],
      unknowns: ["Read consistency during HA failover windows"]
    }
  },
  {
    operation: "KvList",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "folder-like entries end with /", trigger: "nested_paths", severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "list capability on metadata endpoint", kind: Capability }],
      assumptions: ["HTTP LIST method supported by proxy path"],
      unknowns: ["Path traversal semantics with deeply nested prefixes"]
    }
  },
  {
    operation: "KvWrite",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["path", "cas"],
      determinism: Deterministic,
      failure_modes: [{ name: "CasMismatch", condition: "cas_precondition_failed", http_status: 400, recoverable: true, retry_safe: false }],
      edge_cases: [
        { description: "cas=0 means create-only", trigger: "first_write_only", severity: Medium },
        { description: "cas=N means update-if-current-version-is-N", trigger: "optimistic_locking", severity: Medium }
      ],
      confidence: Documented,
      prerequisites: [{ description: "token can write KV data path", kind: Credential }],
      assumptions: ["KV metadata versioning is enabled"],
      unknowns: ["Conflict probability under high contention and retry storms"]
    }
  },
  {
    operation: "KvDelete",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["path"],
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "delete is soft and can be undeleted", trigger: null, severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "token can delete data path", kind: Credential }],
      assumptions: ["Soft-delete tombstones are retained by provider policy"],
      unknowns: []
    }
  },
  {
    operation: "KvDestroy",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["path", "versions"],
      determinism: Deterministic,
      failure_modes: [],
