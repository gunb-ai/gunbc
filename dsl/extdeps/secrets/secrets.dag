// extdeps/secrets/core.dag -- Abstract "what is a secret provider?" model.

module extdeps.secrets.secrets

import std.behavioral {
  OperationBehavior, FailureMode, EdgeCase, Confidence, Prerequisite
}
import std.types { Timestamp }

type SecretLifecycle = Active | Disabled | Destroyed | PendingDeletion

type SecretVersion {
  id: String
  state: SecretLifecycle
  created_at: Timestamp?
}

type RotationPolicy {
  period_seconds: Int
  next_rotation: String?
}

type SecretAccessPolicy {
  principal: String
  permission: String
  condition: String?
}

type SecretEncryption = ProviderManaged | CustomerManaged { key_id: String }

type SecretOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data shared_secret_operation_behaviors: List<SecretOperationBehavior> = [
  {
    operation: "ReadSecret",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "secret_missing", http_status: 404, recoverable: false, retry_safe: false },
        { name: "PermissionDenied", condition: "access_denied", http_status: 403, recoverable: false, retry_safe: false }
      ],
      edge_cases: [
        { description: "Version alias may resolve to different concrete version over time", trigger: "latest_alias", severity: Medium }
      ],
      confidence: Documented,
      prerequisites: [{ description: "Caller is authenticated", kind: Credential }],
      assumptions: ["Provider enforces resource-level IAM policies"],
      unknowns: ["Exact read-after-write propagation characteristics vary by provider"]
    }
  },
  {
    operation: "CreateSecret",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "AlreadyExists", condition: "name_collision", http_status: 409, recoverable: true, retry_safe: false }
      ],
      edge_cases: [
        { description: "Provider name rules differ across backends", trigger: "invalid_name", severity: Medium }
      ],
      confidence: HighConfidence,
      prerequisites: [{ description: "Caller has create permission on secret namespace", kind: Capability }],
      assumptions: ["Create allocates secret metadata and policy context"],
      unknowns: ["Cross-region create latency under control-plane load"]
    }
  },
  {
    operation: "AddSecretVersion",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "SecretMissing", condition: "parent_secret_missing", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [
        { description: "Version state may default to enabled immediately", trigger: null, severity: Low }
      ],
      confidence: HighConfidence,
      prerequisites: [{ description: "Caller can add versions to existing secret", kind: Capability }],
      assumptions: ["Version append is monotonic and does not mutate existing versions"],
      unknowns: ["Per-provider limits for versions per secret over long retention windows"]
    }
  }
]
