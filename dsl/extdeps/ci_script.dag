// extdeps/ci_script.dag -- Shared CI shell-script modeling.
//
// Provider-neutral model for CI shell snippets. This keeps command
// structure and comments as data until the final provider serializer.

module extdeps.ci_script

type ScriptLine
  = Command { argv: List<String> }
  | Raw { shell: String }
  | Comment { text: String }

type ScriptBlock {
  lines: List<ScriptLine>
}

// Current CI commands are shell-safe argv tokens already. Keep shell
// rendering centralized here so quoting can be strengthened later
// without widening the Rust/DSL boundary again.
fn render_command_arg(arg: String) -> String {
  arg
}

fn render_command_shell(argv: List<String>) -> String {
  argv |> map(arg => render_command_arg(arg: arg)) |> join(" ")
}

fn render_script_line_shell(line: ScriptLine) -> String {
  match line {
    Command { argv } => render_command_shell(argv: argv)
    Raw { shell } => shell
    Comment { text } => "# {text}"
  }
}

fn render_script_block_lines(block: ScriptBlock) -> List<String> {
  block.lines |> map(line => render_script_line_shell(line: line))
}

fn render_script_block_shell(block: ScriptBlock) -> String {
  render_script_block_lines(block: block) |> join("\n")
}
