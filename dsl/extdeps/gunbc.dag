// extdeps/gunbc.dag -- "What is gunbc?"
//
// Meta model of this repo's workspace structure. Technically an
// internal system, but modeled as an extdep because:
//   1. The crate graph is a stable fact (changes rarely)
//   2. Multiple tools derive from it (clippy policy, codegen, testgen)
//   3. Treating it uniformly with external deps simplifies composition
//
// Consumers:
//   config/arch_rules.dag    -- exemption scopes reference packages
//   config/clippy_policy.dag -- crate policies reference roles
//   tools/codegen.dag        -- codegen shell operations

module extdeps.gunbc

// -- Package roles ---------------------------------------------------
// How a crate participates in the architecture.

type CrateRole
  = TransportBoundary
  | Compiler
  | CodegenBootstrap
  | Runtime
  | Infra
  | Library
  | Tool

// -- Package declarations --------------------------------------------
// Each package states its role and whether it's an I/O boundary.

type WorkspacePackage {
  name: String
  role: CrateRole
  description: String
  io_boundary: Bool
}

data packages: List<WorkspacePackage> = [
  // Transport layer -- the designated I/O boundary
  { name: "gunbc-lib-transport",
    role: TransportBoundary,
    description: "Designated I/O boundary: all filesystem, network, process I/O flows through here",
    io_boundary: true },

  // Execution engine
  { name: "gunbc-exec",
    role: Runtime,
    description: "DAG execution engine with freshness checking and CI display",
    io_boundary: false },

  // IR and infrastructure
  { name: "gunbc-ir",
    role: Infra,
    description: "Intermediate representation types, workspace layout, transport credential",
    io_boundary: false },
  { name: "gunbc-infra",
    role: Infra,
    description: "Leaf infrastructure: ResourceId, ContentHash, hash, manifest, freshness",
    io_boundary: false },

  // Codegen and tool registry
  { name: "gunbc-codegen",
    role: CodegenBootstrap,
    description: "Code generation from IR to Rust/Go/C/MIPS targets",
    io_boundary: false },

  // Compiler pipeline
  { name: "daglang-syntax",
    role: Compiler,
    description: "DSL lexer and parser",
    io_boundary: false },
  { name: "daglang-resolve",
    role: Compiler,
    description: "DSL module resolution and dependency graph",
    io_boundary: false },
  { name: "daglang-typecheck",
    role: Compiler,
    description: "DSL type checking and validation",
    io_boundary: false },
  { name: "daglang-lower",
    role: Compiler,
    description: "DSL lowering to DAG IR",
    io_boundary: false },
  { name: "daglang-emit",
    role: Compiler,
    description: "Backend code emission (Rust, Go, C, MIPS)",
    io_boundary: false },
  { name: "daglang-driver",
    role: Compiler,
    description: "Compiler driver: orchestrates parse -> resolve -> typecheck -> lower -> emit",
    io_boundary: false },
  { name: "daglang-cli",
    role: Compiler,
    description: "CLI frontend for the DSL compiler",
    io_boundary: false },

  // Main DAG crate
  { name: "gunbc-app",
    role: CodegenBootstrap,
    description: "Workspace DAG: tool graphs, extern impls, policy, registry",
    io_boundary: false },

]

// -- Service: codegen shell operations ---------------------------

service shell.Codegen {
  operation Check {
    input {}
    output { needed: Bool from "exit_success" }
    readonly
    // Checks if codegen output files exist / are stale
    transport shell { argv: ["test", "-f", "target/codegen/.stamp"] }
    exit {
      0 => Unit "File exists"
      1 => Unit "File does not exist"
    }
  }

  operation Run {
    input {}
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "run", "--bin", "gunbc-codegen", "--", "codegen"] }
    exit {
      0 => Unit
      nonzero => String "Codegen failed"
    }
  }
}
