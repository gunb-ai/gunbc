// extdeps/cloud/azure/key_vault.dag -- "What is Azure Key Vault?"
//
// Key Vault resource model: secrets, keys, certificates,
// soft delete policies.
//
// Consumers:
//   infra/azure/resources.dag — secret store resource impl (future)

module extdeps.cloud.azure.key_vault

import extdeps.cloud.azure.azure { AzureRegion }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Secrets ───────────────────────────────────────────────────────

type VaultSecret {
  name: String
  vault_uri: String
  value: Secret
  content_type: String?
  enabled: Bool
  created: String
  updated: String
  expires: String?
}

// ── Keys ──────────────────────────────────────────────────────────

type VaultKeyType = Rsa | RsaHsm | Ec | EcHsm | Oct | OctHsm

type VaultKey {
  name: String
  vault_uri: String
  key_type: VaultKeyType
  key_size: Int?
  enabled: Bool
}

// ── Certificates ──────────────────────────────────────────────────

type VaultCertificate {
  name: String
  vault_uri: String
  thumbprint: String
  subject: String
  expires: String
}

// ── Soft delete ───────────────────────────────────────────────────

type SoftDeletePolicy {
  enabled: Bool
  retention_days: Int
  purge_protection: Bool
}

// ── Constants ─────────────────────────────────────────────────────

data default_retention_days: Int = 90

data max_secret_size_bytes: Int = 25600

// ── Operation behaviors ───────────────────────────────────────────

type VaultOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<VaultOperationBehavior> = [
  {
    operation: "GetSecret",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "SecretNotFound", condition: "secret_absent", http_status: 404, recoverable: false, retry_safe: false },
        { name: "Forbidden", condition: "access_policy_denied", http_status: 403, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "disabled secrets return 403, not 404", trigger: "secret_disabled", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "secrets/get access policy", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "SetSecret",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["vault_uri", "secret_name"],
      determinism: Deterministic,
      failure_modes: [
        { name: "Forbidden", condition: "access_policy_denied", http_status: 403, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "setting a secret creates a new version, old versions remain accessible", trigger: "version_create", severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "secrets/set access policy", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
