// extdeps/cloud/azure/container_apps.dag -- "What is Azure Container Apps?"
//
// Container Apps resource model: apps, revisions, Dapr integration,
// ingress configuration, scaling rules.
//
// Consumers:
//   infra/azure/resources.dag — compute resource impl (future)

module extdeps.cloud.azure.container_apps

import extdeps.cloud.azure.core { AzureRegion, ResourceGroup }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Container Apps ────────────────────────────────────────────────

type ContainerApp {
  name: String
  resource_group: String
  location: String
  environment_id: String
  revision_mode: RevisionMode
}

type RevisionMode = Single | Multiple

// ── Revisions ─────────────────────────────────────────────────────

type ContainerAppRevision {
  name: String
  active: Bool
  traffic_weight: Int
  created_time: String
}

// ── Containers ────────────────────────────────────────────────────

type CaContainer {
  image: String
  name: String
  cpu: Float
  memory: String
  env: List<CaEnvVar>
}

type CaEnvVar
  = CaLiteralEnv { name: String, value: String }
  | CaSecretRefEnv { name: String, secret_ref: String }

// ── Ingress ───────────────────────────────────────────────────────

type CaIngressConfig {
  external: Bool
  target_port: Int
  transport: CaTransport
}

type CaTransport = Auto | Http | Http2 | Tcp

// ── Dapr ──────────────────────────────────────────────────────────

type DaprConfig {
  enabled: Bool
  app_id: String?
  app_port: Int?
  app_protocol: DaprProtocol?
}

type DaprProtocol = Http | Grpc

// ── Scaling ───────────────────────────────────────────────────────

type CaScalingRule
  = HttpScaling { concurrent_requests: Int }
  | QueueScaling { queue_name: String, queue_length: Int }
  | CustomScaling { type: String, metadata: Map<String, String> }

// ── Constants ─────────────────────────────────────────────────────

data max_replicas: Int = 300

data default_cpu: Float = 0.25

data default_memory: String = "0.5Gi"

// ── Operation behaviors ───────────────────────────────────────────

type ContainerAppOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<ContainerAppOperationBehavior> = [
  {
    operation: "CreateOrUpdate",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["name", "resource_group"],
      determinism: Deterministic,
      failure_modes: [
        { name: "QuotaExceeded", condition: "subscription_quota_reached", http_status: 409, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "multi-revision mode requires explicit traffic weight management", trigger: "multiple_revisions", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "Microsoft.App/containerApps/write permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "Get",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "app_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "Microsoft.App/containerApps/read permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
