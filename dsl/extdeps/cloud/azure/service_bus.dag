// extdeps/cloud/azure/service_bus.dag -- "What is Azure Service Bus?"
//
// Service Bus resource model: queues, topics, subscriptions,
// messages, sessions.
//
// Consumers:
//   infra/azure/resources.dag — queue resource impl (future)

module extdeps.cloud.azure.service_bus

import extdeps.cloud.azure.azure { AzureRegion }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Queues ────────────────────────────────────────────────────────

type ServiceBusQueue {
  name: String
  namespace: String
  max_size_mb: Int
  lock_duration_seconds: Int
  max_delivery_count: Int
  requires_session: Bool
  dead_lettering: Bool
}

// ── Topics ────────────────────────────────────────────────────────

type ServiceBusTopic {
  name: String
  namespace: String
  max_size_mb: Int
  enable_partitioning: Bool
}

// ── Subscriptions ─────────────────────────────────────────────────

type ServiceBusSubscription {
  name: String
  topic: String
  max_delivery_count: Int
  lock_duration_seconds: Int
  forward_to: String?
  dead_letter_on_filter_error: Bool
}

// ── Messages ──────────────────────────────────────────────────────

type ServiceBusMessage {
  message_id: String
  body: Bytes
  content_type: String?
  label: String?
  session_id: String?
  correlation_id: String?
  time_to_live_seconds: Int?
}

// ── Sessions ──────────────────────────────────────────────────────

type SessionConfig {
  enabled: Bool
  max_concurrent_sessions: Int?
}

// ── Constants ─────────────────────────────────────────────────────

data default_lock_duration_seconds: Int = 30

data max_lock_duration_seconds: Int = 300

data default_max_delivery_count: Int = 10

data max_message_size_bytes: Int = 262144

// ── Operation behaviors ───────────────────────────────────────────

type ServiceBusOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<ServiceBusOperationBehavior> = [
  {
    operation: "SendMessage",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "QuotaExceeded", condition: "queue_full", http_status: 403, recoverable: true, retry_safe: true },
        { name: "MessageTooLarge", condition: "exceeds_size_limit", http_status: 400, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "session-enabled queues require SessionId on every message", trigger: "session_queue", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "Azure Service Bus Data Sender role", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "ReceiveMessage",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [
        { name: "SessionNotAvailable", condition: "all_sessions_locked", http_status: 503, recoverable: true, retry_safe: true }
      ],
      edge_cases: [{ description: "peek-lock mode holds message invisible for lock_duration", trigger: "peek_lock", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "Azure Service Bus Data Receiver role", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "CompleteMessage",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["lock_token"],
      determinism: Deterministic,
      failure_modes: [{ name: "LockExpired", condition: "lock_token_expired", http_status: 410, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "Azure Service Bus Data Receiver role", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
