// extdeps/cloud/agent.dag -- "What is a cloud coding agent?"
//
// Models the lifecycle of a cloud-hosted coding agent (Cursor Composer,
// Claude Code cloud, etc.) from the perspective of an API consumer.
// The exact upstream API shape must be re-verified against current docs
// when implementation starts (per ROADMAP § Business Feature Track).
//
// Typed lifecycle: credentials → launch → follow-up → result → cleanup.
//
// Consumers:
//   gunbc/tools/agent_workflow.dag (future)

module extdeps.cloud.agent

import std.types { Timestamp }
import std.errors { ApiErrorShape }

// -- Credential model --------------------------------------------------

type AgentCredential {
  api_key: Secret
  organization_id: String?
}

type CredentialStatus
  = Ready { credential: AgentCredential }
  | NeedsManualProvision { reason: String }
  | Invalid { error: String }

// -- Agent lifecycle types ---------------------------------------------

type AgentConfig {
  model: String
  max_turns: Int
  timeout_seconds: Int
  working_directory: String?
}

type LaunchRequest {
  prompt: String
  config: AgentConfig
  repository: String?
  branch: String?
}

type AgentHandle {
  agent_id: String
  run_id: String
  status: AgentStatus
  created_at: Timestamp
}

type AgentStatus
  = Pending
  | Running
  | Completed
  | Failed { error: String }
  | Cancelled

type FollowUpRequest {
  agent_id: String
  run_id: String
  message: String
}

type AgentResult {
  agent_id: String
  run_id: String
  status: AgentStatus
  output: String?
  files_changed: List<String>
  duration_seconds: Int
}

// -- Service definition ------------------------------------------------

service cloud.Agent {
  config {
    endpoint: "https://api.example.com/v1"
    auth: BearerToken
    auth_input: api_key
  }

  operation launch(request: LaunchRequest) -> AgentHandle {
    transport rest {
      method: POST,
      path: "/agents/launch",
      body: {
        prompt: request.prompt,
        model: request.config.model,
        max_turns: request.config.max_turns,
        repository: request.repository,
        branch: request.branch
      }
    }
    response {
      200 => AgentHandle
      401 => ApiErrorShape
      422 => ApiErrorShape
      429 => ApiErrorShape
    }
    mock_response {
      200 => {
        agent_id: "agent-001",
        run_id: "run-abc",
        status: "Pending",
        created_at: "2026-01-01T00:00:00Z"
      } "Agent launched successfully",
      401 => { message: "Invalid API key" } "Bad credentials",
      422 => { message: "Invalid request" } "Validation failed"
    }
  }

  operation follow_up(request: FollowUpRequest) -> AgentHandle {
    transport rest {
      method: POST,
      path: "/agents/{request.agent_id}/runs/{request.run_id}/follow-up",
      body: { message: request.message }
    }
    response {
      200 => AgentHandle
      404 => ApiErrorShape
    }
    mock_response {
      200 => {
        agent_id: "agent-001",
        run_id: "run-abc",
        status: "Running",
        created_at: "2026-01-01T00:00:00Z"
      } "Follow-up sent",
      404 => { message: "Agent not found" } "Unknown agent"
    }
  }

  operation get_result(agent_id: String, run_id: String) -> AgentResult {
    transport rest {
      method: GET,
      path: "/agents/{agent_id}/runs/{run_id}/result"
    }
    response {
      200 => AgentResult
      404 => ApiErrorShape
    }
    mock_response {
      200 => {
        agent_id: "agent-001",
        run_id: "run-abc",
        status: "Completed",
        output: "Changes applied successfully",
        files_changed: ["src/main.rs", "Cargo.toml"],
        duration_seconds: 120
      } "Result retrieved",
      404 => { message: "Run not found" } "Unknown run"
    }
  }

  operation delete_agent(agent_id: String) -> String {
    transport rest {
      method: DELETE,
      path: "/agents/{agent_id}"
    }
    response {
      204 => String
      404 => ApiErrorShape
    }
    mock_response {
      204 => "deleted" "Agent deleted",
      404 => { message: "Agent not found" } "Already deleted"
    }
  }
}
