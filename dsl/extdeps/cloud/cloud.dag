// extdeps/cloud/core.dag -- "What is a cloud provider?"
//
// Universal concepts shared across GCP, AWS, and Azure.
// Types only -- concrete values live in provider-specific core.dag files.
//
// Consumers:
//   extdeps/cloud/gcp/core.dag   -- GCP-specific identity, endpoints
//   extdeps/cloud/aws/core.dag   -- AWS-specific ARNs, SigV4
//   extdeps/cloud/azure/core.dag -- Azure-specific tenants, subscriptions

module extdeps.cloud.cloud

import std.types { AuthScheme }

// Coproduct dissolution classification (DESIGN.md §2 decompress->map->reduce):
// 🟢 GREEN (terminal). SigV4 signing names a closed AWS region identifier set.
type AwsRegion
  = UsEast1
  | UsEast2
  | UsWest1
  | UsWest2
  | EuWest1
  | EuCentral1
  | ApSoutheast1
  | ApNortheast1

// 🟢 GREEN (terminal). SigV4 signing names a closed AWS service identifier set.
type AwsService
  = S3
  | Iam
  | Sts
  | Ec2
  | Lambda
  | Dynamodb
  | Sqs
  | Sns
  | Kms
  | Secretsmanager

fn aws_region_wire_label(region: AwsRegion) -> String {
  match region {
    UsEast1 => "us-east-1"
    UsEast2 => "us-east-2"
    UsWest1 => "us-west-1"
    UsWest2 => "us-west-2"
    EuWest1 => "eu-west-1"
    EuCentral1 => "eu-central-1"
    ApSoutheast1 => "ap-southeast-1"
    ApNortheast1 => "ap-northeast-1"
  }
}

fn aws_service_wire_label(service: AwsService) -> String {
  match service {
    S3 => "s3"
    Iam => "iam"
    Sts => "sts"
    Ec2 => "ec2"
    Lambda => "lambda"
    Dynamodb => "dynamodb"
    Sqs => "sqs"
    Sns => "sns"
    Kms => "kms"
    Secretsmanager => "secretsmanager"
  }
}

// -- Service endpoints ---------------------------------------------

type ServiceEndpoint {
  base_url: String
  version: String
  regional: Bool
}

// -- Rate limiting -------------------------------------------------

type RateLimitPolicy {
  requests_per_minute: Int
  burst: Int?
  scope: String
}

// -- Cloud auth (Layer 2) ------------------------------------------
// Composes protocol-level AuthScheme from std/ with provider-specific
// schemes. Provider services project the subset they actually use.
// AWS: SigV4. GCP: OidcToken. Azure: Bearer (already in std/).

type CloudAuthScheme
  = Protocol { scheme: AuthScheme }
  | SigV4 { region: AwsRegion, service: AwsService }
  | OidcToken { audience: String }

// -- Credentials ---------------------------------------------------

type CloudCredential {
  scheme: CloudAuthScheme
  scopes: List<String>?
  expires_seconds: Int?
}

// -- Idempotency ---------------------------------------------------

type IdempotencyToken {
  header: String
  format: String
}

// -- Quotas --------------------------------------------------------

type CloudQuota {
  resource: String
  limit: Int
  scope: String
}

// -- Regions -------------------------------------------------------

type CloudRegion {
  provider: String
  name: String
  display_name: String
}
