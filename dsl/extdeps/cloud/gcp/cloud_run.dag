// extdeps/cloud/gcp/cloud_run.dag -- "What is Google Cloud Run?"
//
// Cloud Run resource model: services, revisions, containers,
// scaling, traffic splitting, ingress control.
//
// Consumers:
//   infra/gcp/resources.dag    — compute resource impl
//   infra/sdlc/deploy.dag      — SDLC deployment spec
//   config/ci.dag              — CI deploy targets

module extdeps.cloud.gcp.cloud_run

import extdeps.cloud.gcp.core { GcpProject, GcpRegion, GcpServiceAccount }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Ingress ───────────────────────────────────────────────────────

type IngressTraffic = All | InternalOnly | InternalAndCloudLoadBalancing

// ── Launch stage ──────────────────────────────────────────────────

type LaunchStage = Ga | Beta | Alpha

// ── Services ──────────────────────────────────────────────────────

type CloudRunService {
  name: String
  project: String
  location: String
  uri: String?
  ingress: IngressTraffic
  launch_stage: LaunchStage
}

// ── Revisions ─────────────────────────────────────────────────────

type ScalingConfig {
  min_instances: Int
  max_instances: Int
  concurrency: Int?
}

type ContainerPort {
  container_port: Int
  name: String?
}

type CrEnvVar
  = Literal { name: String, value: String }
  | FromSecret { name: String, secret: String, version: String }

type ResourceRequirements {
  cpu: String
  memory: String
}

type CrContainer {
  image: String
  ports: List<ContainerPort>
  env: List<CrEnvVar>
  resources: ResourceRequirements
}

type Revision {
  name: String
  service: String
  scaling: ScalingConfig
  containers: List<CrContainer>
  service_account: String?
}

// ── Traffic splitting ─────────────────────────────────────────────

type TrafficType = Latest | ByRevision

type TrafficSplit {
  revision: String
  percent: Int
  type: TrafficType
}

// ── Constants ─────────────────────────────────────────────────────

data default_concurrency: Int = 80

data max_instances_limit: Int = 1000

data default_timeout_seconds: Int = 300

// ── Operation behaviors ───────────────────────────────────────────

type CloudRunOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<CloudRunOperationBehavior> = [
  {
    operation: "createService",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "AlreadyExists", condition: "service_name_taken", http_status: 409, recoverable: false, retry_safe: false },
        { name: "QuotaExceeded", condition: "service_limit_reached", http_status: 429, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "service creation triggers an initial revision deployment", trigger: "create", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "run.services.create permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "getService",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "service_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "run.services.get permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "updateService",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["service_name"],
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "service_absent", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "update creates a new revision and shifts traffic", trigger: "update_with_traffic", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "run.services.update permission", kind: Capability }],
      assumptions: [],
      unknowns: ["Exact rollout timing for traffic shift to new revision"]
    }
  },
  {
    operation: "deleteService",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["service_name"],
      determinism: Deterministic,
      failure_modes: [{ name: "NotFound", condition: "service_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "deletion removes all revisions and their serving URLs", trigger: "delete", severity: High }],
      confidence: Documented,
      prerequisites: [{ description: "run.services.delete permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
