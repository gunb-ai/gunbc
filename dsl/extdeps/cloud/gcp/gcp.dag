// extdeps/cloud/gcp/gcp.dag -- "What is GCP?"
//
// GCP identity model: projects, service accounts, OAuth2 scopes,
// Workload Identity Federation, API endpoint patterns, regions,
// and the transport bindings of GCP auth operations. OAuth2 token refresh
// is modeled once (oauth2.Google.Refresh, REST -- the canonical handler);
// gcloud-CLI shell ops are a distinct surface, not a duplicate of it.
//
// Complements extdeps/api/gcp_ops.dag (which covers retries,
// propagation delays, and operational constraints).
//
// Consumers:
//   extdeps/cloud/gcp/{storage,pubsub,iam,secret_manager,cloud_run,sts}.dag
//   gunbc/auth/patterns.dag         -- credential chain

module extdeps.cloud.gcp.gcp

import extdeps.cloud.cloud { ServiceEndpoint }
import std.types { FilePath, NonEmptyStr, Secret, HttpMethod, AuthScheme }
import extdeps.cloud.gcp.errors { GcpErrorShape, GcpOAuth2ErrorShape }

// -- Grounded identifier refinements --------------------------------
// Cite: cloud.google.com/resource-manager/docs/creating-managing-projects
// GcpProjectId: restore `where pattern("^[a-z][a-z0-9-]{4,28}[a-z0-9]$")` post-Q-Regex.
type GcpProjectId = String where non_empty
// ServiceAccountEmail: restore `where pattern("^[a-z][a-z0-9-]*@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$")` post-Q-Regex.
type ServiceAccountEmail = String

// -- Projects ------------------------------------------------------

type GcpProject {
  project_id: GcpProjectId
  project_number: Int
  name: String
}

// -- Service accounts ----------------------------------------------

type GcpServiceAccount {
  email: ServiceAccountEmail
  unique_id: String
  display_name: String?
  disabled: Bool
}

// -- Credential acquisition (GCP-specific flows) -------------------
// Provider-neutral flows live in std.credentials; Workload Identity Federation
// and interactive gcloud OAuth are grounded here.

type GcpCredentialFlow
  = WorkloadIdentity {
      audience: NonEmptyStr
      service_account: ServiceAccountEmail?
      scopes: List<String>
    }
  | InteractiveAuth { scopes: List<String> }

// -- OAuth2 scopes -------------------------------------------------

type OAuth2Scope {
  scope: String
  description: String
}

data common_scopes: List<OAuth2Scope> = [
  { scope: "https://www.googleapis.com/auth/cloud-platform", description: "Full access to all GCP resources" },
  { scope: "https://www.googleapis.com/auth/devstorage.read_write", description: "Read/write access to GCS" },
  { scope: "https://www.googleapis.com/auth/iam", description: "IAM management" },
  { scope: "https://www.googleapis.com/auth/pubsub", description: "Pub/Sub access" },
  { scope: "https://www.googleapis.com/auth/secretmanager", description: "Secret Manager access" }
]

// -- Workload Identity Federation ----------------------------------

type WifPool {
  name: String
  project: String
  display_name: String?
  disabled: Bool
}

type WifProvider {
  name: String
  pool: String
  issuer_uri: String
  attribute_mapping: Map<String, String>?
}

// -- API endpoints -------------------------------------------------
// Pattern: {service}.googleapis.com/{version}

type GcpService
  = GcpStorage
  | GcpIam
  | GcpSecretManager
  | GcpCloudRun
  | GcpPubsub
  | GcpSts

fn gcp_service_wire_label(service: GcpService) -> String {
  match service {
    GcpStorage => "storage"
    GcpIam => "iam"
    GcpSecretManager => "secretmanager"
    GcpCloudRun => "run"
    GcpPubsub => "pubsub"
    GcpSts => "sts"
  }
}

type GcpApiEndpoint {
  service: GcpService
  base_url: String
  version: String
}

data api_endpoints: List<GcpApiEndpoint> = [
  { service: GcpStorage, base_url: "https://storage.googleapis.com/storage/v1", version: "v1" },
  { service: GcpIam, base_url: "https://iam.googleapis.com/v1", version: "v1" },
  { service: GcpSecretManager, base_url: "https://secretmanager.googleapis.com/v1", version: "v1" },
  { service: GcpCloudRun, base_url: "https://run.googleapis.com/v2", version: "v2" },
  { service: GcpPubsub, base_url: "https://pubsub.googleapis.com/v1", version: "v1" },
  { service: GcpSts, base_url: "https://sts.googleapis.com/v1", version: "v1" }
]

// -- Regions -------------------------------------------------------

type GcpRegion {
  name: String
  zones: List<String>
  multi_region: Bool
}

data regions: List<GcpRegion> = [
  { name: "us-central1", zones: ["us-central1-a", "us-central1-b", "us-central1-c", "us-central1-f"], multi_region: false },
  { name: "us-east1", zones: ["us-east1-b", "us-east1-c", "us-east1-d"], multi_region: false },
  { name: "us-east4", zones: ["us-east4-a", "us-east4-b", "us-east4-c"], multi_region: false },
  { name: "europe-west1", zones: ["europe-west1-b", "europe-west1-c", "europe-west1-d"], multi_region: false },
  { name: "us", zones: [], multi_region: true },
  { name: "eu", zones: [], multi_region: true }
]

// -- Service: GCP auth operations (shell + REST transport) -------

// 🟡 dissolved — feature:gcp-cloud-mock-response — scaffold:hand-authored mock_response —
// dissolve-on-arrival: Phase-2-hermetic RecordedFixture replay from claim_batch --fixture-store
// (recorded wet via --record); the published corpus (extdeps.cloud.gcp.mock_corpus) now governs
// WHICH gcloud.Auth ops are hermetically realizable, and the fixture store owns the payloads (§3).
// forbidden: reintroducing mock_response constants for Hermetic dispatch on these shapes.
service gcloud.Auth {
  operation Login {
    input {}
    output { ok: Bool from "exit_success" }
    transport shell { argv: ["gcloud", "auth", "login", "--update-adc"] }
    exit {
      0 => Unit
      nonzero => String "Authentication failed"
    }
  }

  operation ReadADC {
    input { path: FilePath = "~/.config/gcloud/application_default_credentials.json" }
    output {
      client_id: String
      client_secret: Secret
      refresh_token: Secret
    }
    readonly
    // Parses JSON: extracts client_id, client_secret, refresh_token
    transport file { op: READ, path: "\{path\}" }
  }
}

type GoogleOAuth2Refresh200Body {
  access_token: Secret
  expires_in: Int
  token_type: String
  scope: String?
}

// 🟡 dissolved — feature:gcp-cloud-mock-response — scaffold:hand-authored mock_response —
// dissolve-on-arrival: Phase-2-hermetic RecordedFixture replay from claim_batch --fixture-store
// (recorded wet via --record); the published corpus (extdeps.cloud.gcp.mock_corpus) now governs
// WHICH oauth2.Google ops are hermetically realizable, and the fixture store owns the payloads (§3).
// forbidden: reintroducing mock_response constants for Hermetic dispatch on these shapes.
service oauth2.Google {
  config { endpoint: "https://oauth2.googleapis.com" }

  operation Refresh {
    input {
      client_id: String
      client_secret: Secret
      refresh_token: Secret
    }
    output {
      access_token: Secret from "access_token"
      expires_in: Int from "expires_in"
    }
    // Derivation unknown: POST /token has no path key.
    // Idempotency is spec-declared per RFC 6749 §6 for a given refresh_token.
    idempotent
    transport rest { method: POST, path: "/token" }
    response {
      200 => GoogleOAuth2Refresh200Body
      400 => GcpOAuth2ErrorShape
      401 => GcpOAuth2ErrorShape
      5xx => GcpOAuth2ErrorShape
    }
  }
}

// NOTE: the OAuth2 token-refresh endpoint is GCP's REST API, modeled faithfully
// by `oauth2.Google.Refresh` above. A former `shell.OAuth2.RefreshToken` op
// re-implemented that same endpoint with hand-rolled curl + form-encoding -- a
// business bridge masquerading as a distinct dependency, with a known JSON/encoding
// defect its own comment flagged. Removed: there is exactly one model of the
// refresh endpoint, and `curl` is a transport, not a second handler we owe here.

// 🟡 dissolved — feature:gcp-cloud-mock-response — scaffold:hand-authored mock_response —
// dissolve-on-arrival: Phase-2-hermetic RecordedFixture replay from claim_batch --fixture-store
// (recorded wet via --record); the published corpus (extdeps.cloud.gcp.mock_corpus) now governs
// WHICH shell.GCloud ops are hermetically realizable, and the fixture store owns the payloads (§3).
// forbidden: reintroducing mock_response constants for Hermetic dispatch on these shapes.
service shell.GCloud {
  operation AuthPrintAccessToken {
    input {}
    output { access_token: Secret from "stdout" }
    readonly
    transport shell { argv: ["gcloud", "auth", "print-access-token"] }
    exit {
      0 => Unit
      nonzero => String "Failed to get access token"
    }
  }

  operation SecretManagerAccessVersion {
    input {
      project_id: NonEmptyStr
      secret_name: NonEmptyStr
      version: NonEmptyStr = "latest"
    }
    output { secret_value: Secret from "stdout" }
    readonly
    transport shell { argv: ["gcloud", "secrets", "versions", "access", "\{version\}", "--secret=\{secret_name\}", "--project=\{project_id\}"] }
    exit {
      0 => Unit
      nonzero => String "Failed to access secret"
    }
  }
}
