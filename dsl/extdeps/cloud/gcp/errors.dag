module extdeps.cloud.gcp.errors

type GcpErrorDetails {
  code: Int
  message: String
  status: String?
}

type GcpErrorShape {
  error: GcpErrorDetails
}

type GcpOAuth2ErrorShape {
  error: String
  error_description: String?
  error_uri: String?
}

data gcp_error_example: GcpErrorShape = {
  error: {
    code: 403,
    message: "Permission denied",
    status: "PERMISSION_DENIED"
  }
}

data gcp_oauth2_error_example: GcpOAuth2ErrorShape = {
  error: "invalid_grant",
  error_description: "Token has been expired or revoked"
}
