// extdeps/cloud/gcp/errors.dag -- GCP API error envelope shapes.
//
// Two distinct upstream wire shapes are modeled here, one per spec:
//   GcpErrorShape       -- Google APIs canonical RPC-status envelope
//                          (https://cloud.google.com/apis/design/errors#http_mapping)
//   GcpOAuth2ErrorShape -- RFC 6749 §5.2 OAuth2 token-endpoint error
//                          (https://datatracker.ietf.org/doc/html/rfc6749#section-5.2)

module extdeps.cloud.gcp.errors

type GcpErrorDetails {
  code: Int
  message: String
  status: String?
}

type GcpErrorShape {
  error: GcpErrorDetails
}

type GcpOAuth2ErrorShape {
  error: String
  error_description: String?
  error_uri: String?
}

data gcp_error_example: GcpErrorShape = {
  error: {
    code: 403,
    message: "Permission denied",
    status: "PERMISSION_DENIED"
  }
}

data gcp_oauth2_error_example: GcpOAuth2ErrorShape = {
  error: "invalid_grant",
  error_description: "Token has been expired or revoked"
}
