// extdeps/cloud/gcp/secret_manager.dag -- "What is GCP Secret Manager?"
//
// Secret Manager resource model: secrets, versions, replication,
// rotation, access policies.
//
// Complements extdeps/secrets/gcp_secret_manager.dag (which covers
// behavioral specs for coordination/access patterns).
//
// Consumers:
//   gunbc/auth/patterns.dag    -- credential-chain secret access

module extdeps.cloud.gcp.secret_manager

import extdeps.cloud.gcp.gcp { GcpProject }
import extdeps.cloud.gcp.errors { GcpErrorShape }
import std.types { HttpMethod, AuthScheme }

// -- Replication ---------------------------------------------------

type SmReplica {
  location: String
}

type SmReplication
  = Automatic
  | UserManaged { replicas: List<SmReplica> }

// -- Secrets -------------------------------------------------------

type GcpSecret {
  name: String
  project: String
  replication: SmReplication
  labels: Map<String, String>?
  create_time: String
}

// -- Versions ------------------------------------------------------

type SmVersionState = SmEnabled | SmDisabled | SmDestroyed

type GcpSecretVersion {
  name: String
  state: SmVersionState
  create_time: String
}

// -- Payload -------------------------------------------------------

type SecretPayload {
  data: Bytes
}

// -- Rotation ------------------------------------------------------

type SmRotationSchedule {
  next_rotation_time: String?
  rotation_period_seconds: Int?
}

// -- Constants -----------------------------------------------------

data max_secret_size_bytes: Int = 65536

data max_versions: Int = 1000

// -- Service: REST transport wiring ------------------------------

// 🟡 dissolved — feature:gcp-cloud-mock-response — scaffold:hand-authored mock_response —
// dissolve-on-arrival: Phase-2-hermetic RecordedFixture replay from claim_batch --fixture-store
// (recorded wet via --record); the published corpus (extdeps.cloud.gcp.mock_corpus) now governs
// WHICH gcp.SecretManager ops are hermetically realizable, and the fixture store owns the payloads (§3).
// forbidden: reintroducing mock_response constants for Hermetic dispatch on these shapes.
service gcp.SecretManager {
  config {
    endpoint: "https://secretmanager.googleapis.com"
    auth: Bearer
    auth_input: access_token
    // GCP Secret Manager rate limits: 1000 requests/min per project
    rate_limit: { requests: 1000, per: minute, scope: secret_manager }
    // Retry on quota exceeded and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 503] }
  }

  operation AccessVersion {
    input {
      access_token: Secret
      project_id: GcpProjectId
      secret: NonEmptyStr
      version: NonEmptyStr = "latest"
    }
    output {
      payload: Bytes
      name: String
    }
    readonly
    transport rest { method: GET, path: "/v1/projects/\{project_id\}/secrets/\{secret\}/versions/\{version\}:access" }
    response {
      200 => SecretPayload
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation CreateSecret {
    input { access_token: Secret, project_id: GcpProjectId, secret_id: NonEmptyStr }
    output { name: String }
    transport rest { method: POST, path: "/v1/projects/\{project_id\}/secrets" }
    response {
      200 => GcpSecret
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation AddVersion {
    input { access_token: Secret, secret_name: String, payload: Bytes }
    output { name: String }
    // Derivation unknown: POST derives CreateEffect (fail-closed).
    // Idempotency is declared per Google API semantics for addVersion.
    idempotent
    transport rest { method: POST, path: "/v1/\{secret_name\}:addVersion" }
    response {
      200 => GcpSecretVersion
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}
