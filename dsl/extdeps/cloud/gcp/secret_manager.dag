// extdeps/cloud/gcp/secret_manager.dag -- "What is GCP Secret Manager?"
//
// Secret Manager resource model: secrets, versions, replication,
// rotation, access policies.
//
// Complements extdeps/secrets/gcp_secret_manager.dag (which covers
// behavioral specs for coordination/access patterns).
//
// Consumers:
//   services/gcp/secret_manager.dag — transport wiring
//   cloud/gcp/credential.dag       — secret access in credential chain

module extdeps.cloud.gcp.secret_manager

import extdeps.cloud.gcp.core { GcpProject }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Replication ───────────────────────────────────────────────────

type SmReplica {
  location: String
}

type SmReplication
  = Automatic
  | UserManaged { replicas: List<SmReplica> }

// ── Secrets ───────────────────────────────────────────────────────

type GcpSecret {
  name: String
  project: String
  replication: SmReplication
  labels: Map<String, String>?
  create_time: String
}

// ── Versions ──────────────────────────────────────────────────────

type SmVersionState = SmEnabled | SmDisabled | SmDestroyed

type GcpSecretVersion {
  name: String
  state: SmVersionState
  create_time: String
}

// ── Payload ───────────────────────────────────────────────────────

type SecretPayload {
  data: Bytes
}

// ── Rotation ──────────────────────────────────────────────────────

type SmRotationSchedule {
  next_rotation_time: String?
  rotation_period_seconds: Int?
}

// ── Constants ─────────────────────────────────────────────────────

data max_secret_size_bytes: Int = 65536

data max_versions: Int = 1000

// ── Operation behaviors ───────────────────────────────────────────

type SmOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<SmOperationBehavior> = [
  {
    operation: "accessSecretVersion",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "secret_or_version_absent", http_status: 404, recoverable: false, retry_safe: false },
        { name: "PermissionDenied", condition: "insufficient_access", http_status: 403, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "version alias 'latest' resolves to most recent enabled version", trigger: "latest_alias", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.versions.access permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "createSecret",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "AlreadyExists", condition: "secret_name_taken", http_status: 409, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.secrets.create permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "addSecretVersion",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "secret_absent", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "adding a version makes it the new 'latest'", trigger: "version_add", severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "secretmanager.versions.add permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
