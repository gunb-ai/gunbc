// dsl/extdeps/cloud/gcp/mock_corpus.dag
// Scope: the GCP cloud layer's PUBLISHED mock corpus as a closed, declared structural fact.
// Anchor: DESIGN.md §3 (single authority) / §6 (model-just-in-time, mark the carrier).
//
// SINGLE authority for WHICH gcloud.Auth / oauth2.Google / shell.GCloud / gcp.IAM /
// gcp.ResourceManager / gcp.SecretManager / gcp.STS / github.OIDC / gcp.Metadata operations
// are hermetically realizable. Read by BOTH the compile-time M2 mock_totality_lens
// (src/v2/lens/mock_totality.dag, via the per-layer witness) AND the v1 runtime's
// eval_service_call (the M4 hermetic-realization fold) — one model, not two. The v1 runtime
// loads the dsl/ tree via the M4.1 whole-tree corpus load (#5236), so no per-service
// co-location import is required. Modeled on the M4.0 filesystem pilot
// (dsl/extdeps/filesystem/mock_corpus.dag, #5188).
//
// Rows inhabit std.hermetic_replay.PublishedMockCase (all 4 fields: service, operation,
// operation_key, case_id). The operation set authority remains the respective service decls in
// dsl/extdeps/cloud/gcp/{gcp,iam,secret_manager,sts}.dag; per-case payloads live in the
// Phase-2 RecordedFixture store ONLY — rows carry the (operation_key, case_id) structural key.

module extdeps.cloud.gcp.mock_corpus

import std.hermetic_replay { PublishedMockCase }

// -- gcloud.Auth ---------------------------------------------------

data gcloud_auth_mock_case_login: PublishedMockCase = PublishedMockCase {
  operation_key: "gcloud.Auth.Login",
  service: "gcloud.Auth",
  operation: "Login",
  case_id: 0
}

data gcloud_auth_mock_case_read_adc: PublishedMockCase = PublishedMockCase {
  operation_key: "gcloud.Auth.ReadADC",
  service: "gcloud.Auth",
  operation: "ReadADC",
  case_id: 0
}

