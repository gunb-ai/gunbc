// 🟡 gated — feature:gcp-cloud-mock-corpus-from-service-decl — bind node://adhoc-743f3949-b3b
// dissolve-on-arrival: project this corpus directly from the service operation sets in
// dsl/extdeps/cloud/gcp/{gcp,iam,secret_manager,sts}.dag (the SINGLE authority for WHICH
// operations exist), joined with the Phase-2 RecordedFixture store (the authority for WHICH
// recorded cases exist per operation), once a v2 lens can read a service decl's operation nodes
// and the fixture store's keys; this declared list then deletes in the same PR. forbidden: a row
// carrying a response VALUE — that would fork the payload authority, now owned by the fixture
// store (§3); rows mirror the (operation_key, case_id) structural key ONLY, and grow when a
// published operation/case is added upstream.
data gcp_published_mock_corpus: List<PublishedMockCase> = [
  gcloud_auth_mock_case_login,
  gcloud_auth_mock_case_read_adc,
  oauth2_google_mock_case_refresh,
  shell_gcloud_mock_case_auth_print_access_token,
  gcp_iam_mock_case_generate_access_token,
  gcp_resource_manager_mock_case_get_iam_policy,
  gcp_resource_manager_mock_case_set_iam_policy,
  gcp_secret_manager_mock_case_access_version,
  gcp_secret_manager_mock_case_create_secret,
  gcp_secret_manager_mock_case_add_version,
  gcp_sts_mock_case_exchange,
  github_oidc_mock_case_get_token,
  gcp_metadata_mock_case_get_identity_token
]
