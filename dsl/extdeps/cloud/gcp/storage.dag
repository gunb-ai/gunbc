// extdeps/cloud/gcp/storage.dag -- "What is Google Cloud Storage?"
//
// GCS resource model: buckets, objects, storage classes, CAS
// preconditions (generation-based), lifecycle rules.
//
// Complements extdeps/coordination/gcs.dag (which covers GCS as
// a coordination store with full behavioral specs).
//
// Consumers:
//   services/gcp/storage.dag (future)    — transport wiring
//   infra/gcp/resources.dag              — GcsBucket resource impl
//   extdeps/coordination/gcs.dag         — CAS behavioral overlay

module extdeps.cloud.gcp.storage

import extdeps.cloud.gcp.core { GcpProject, GcpRegion }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, Severity
}

// ── Storage classes ───────────────────────────────────────────────

type StorageClass = GcsStandard | GcsNearline | GcsColdline | GcsArchive

// ── Buckets ───────────────────────────────────────────────────────

type GcsBucket {
  name: String
  location: String
  storage_class: StorageClass
  versioning: Bool
  project: String
}

// ── Objects ───────────────────────────────────────────────────────

type GcsObject {
  bucket: String
  key: String
  generation: Int
  metageneration: Int
  content_type: String?
  size: Int
  md5_hash: String?
  crc32c: String?
}

// ── CAS preconditions ─────────────────────────────────────────────
// GCS uses monotonic generation numbers for optimistic concurrency.

type GcsCasPrecondition {
  if_generation_match: Int?
  if_metageneration_match: Int?
}

// ── ACLs ──────────────────────────────────────────────────────────

type ObjectAcl
  = Private
  | PublicRead
  | ProjectPrivate
  | AuthenticatedRead
  | BucketOwnerRead
  | BucketOwnerFullControl

// ── Lifecycle rules ───────────────────────────────────────────────

type LifecycleAction
  = LifecycleDelete
  | SetStorageClass { class: StorageClass }

type LifecycleCondition {
  age_days: Int?
  created_before: String?
  num_newer_versions: Int?
}

type LifecycleRule {
  action: LifecycleAction
  condition: LifecycleCondition
}

// ── Behavioral constants ────────────────────────────────────────

data cas_conflict_status: Int = 412

data create_only_generation: Int = 0

// ── Operation behaviors ─────────────────────────────────────────

type GcsOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<GcsOperationBehavior> = [
  {
    operation: "get_object",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "object_absent", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "insert_object",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "Conflict", condition: "generation_precondition_failed", http_status: 412, recoverable: false, retry_safe: false },
        { name: "NotFound", condition: "bucket_absent", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [
        { description: "CAS insert with ifGenerationMatch=0 is create-only (fails if object exists)", trigger: "create_only_precondition", severity: Medium }
      ],
      confidence: Documented,
      prerequisites: [],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "update_object_cas",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["bucket", "key", "generation"],
      determinism: Deterministic,
      failure_modes: [
        { name: "PreconditionFailed", condition: "generation_mismatch", http_status: 412, recoverable: true, retry_safe: true },
        { name: "NotFound", condition: "object_absent", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [
        { description: "generation-based CAS: read-modify-write requires retry on 412", trigger: "concurrent_write", severity: Medium }
      ],
      confidence: Documented,
      prerequisites: [],
      assumptions: ["Client holds a valid generation number from a recent read"],
      unknowns: []
    }
  },
  {
    operation: "delete_object",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["bucket", "key"],
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "object_absent", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "list_objects",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "NotFound", condition: "bucket_absent", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [],
      assumptions: [],
      unknowns: []
    }
  }
]
