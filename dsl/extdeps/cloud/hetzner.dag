// extdeps/cloud/hetzner.dag — Hetzner Cloud facts (vendor catalog authority).
//
// Spec: https://docs.hetzner.com/cloud/ (server types, billing model)
// Pricing: https://docs.hetzner.com/general/infrastructure-and-availability/price-adjustment/
//   (GE-D9256; Germany/Finland CAX rows effective 2026-04-01, ex-VAT)
//
// Consumers: product.compute_fabric supply rows (cross-provider isolation witnesses).

module extdeps.cloud.hetzner

import std.cpu.types { CpuArchitecture }
import std.measure { MoneyMicros, money_micros }
import std.types { Int, NonEmptyStr }

type HetznerCloudServerType = Cax11 | Cax21 | Cax31 | Cax41

type HetznerCloudServerCatalogRow {
  server_type: HetznerCloudServerType
  // P-CF-BYTESIZE: shared raw-Int stopgap (operator_fleet + Hetzner) — NOT a parallel
  // representation. Dissolves when Measure value-typing lands (ByteSize, thread count);
  // converts BOTH operator_fleet and Hetzner catalog rows. Money fields migrated to
  // `MoneyMicros` (Measure<Currency, Micro>) — the Hetzner source quotes micro-EUR.
  vcpus: Int
  memory_bytes: Int
  disk_bytes: Int
  hourly_eur: MoneyMicros
  monthly_cap_eur: MoneyMicros
  pricing_citation: NonEmptyStr
  cpu_architecture: CpuArchitecture
}

// CAX41 — 16 Ampere® vCPU, 32 GiB RAM, 320 GB SSD (hetzner.com/cloud cost-optimized).
// Hourly €0.0505 / monthly cap €31.49 — docs price-adjustment Germany/Finland 2026-04-01.
data cax41_catalog: HetznerCloudServerCatalogRow = HetznerCloudServerCatalogRow {
  server_type: Cax41,
  vcpus: 16,
  memory_bytes: 34359738368,
  disk_bytes: 343597383680,
  hourly_eur: money_micros(count: 50500),
  monthly_cap_eur: money_micros(count: 31490000),
  pricing_citation: "docs.hetzner.com/general/infrastructure-and-availability/price-adjustment/ GE-D9256 CAX41 Germany/Finland €0.0505/hr €31.49/mo ex-VAT effective 2026-04-01",
  cpu_architecture: Aarch64,
}
