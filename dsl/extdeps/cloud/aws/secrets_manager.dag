// extdeps/cloud/aws/secrets_manager.dag -- "What is AWS Secrets Manager?"
//
// AWS Secrets Manager resource model: secrets, versions,
// rotation configuration.
//
// Consumers:
//   infra/aws/resources.dag  — secret store resource impl (future)

module extdeps.cloud.aws.secrets_manager

import extdeps.cloud.aws.aws { Arn }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Secrets ───────────────────────────────────────────────────────

type AwsSecret {
  arn: String
  name: String
  description: String?
  kms_key_id: String?
  tags: Map<String, String>?
}

// ── Versions ──────────────────────────────────────────────────────

type AwsSecretVersionStage = Current | Previous | Pending

type AwsSecretVersion {
  version_id: String
  stages: List<AwsSecretVersionStage>
  created_date: String
}

// ── Rotation ──────────────────────────────────────────────────────

type AwsRotationConfig {
  rotation_lambda_arn: String
  automatically_after_days: Int
}

// ── Constants ─────────────────────────────────────────────────────

data max_secret_size_bytes: Int = 65536

data max_versions_per_secret: Int = 100

// ── Operation behaviors ───────────────────────────────────────────

type AwsSmOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<AwsSmOperationBehavior> = [
  {
    operation: "GetSecretValue",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "ResourceNotFound", condition: "secret_absent", http_status: 404, recoverable: false, retry_safe: false },
        { name: "AccessDenied", condition: "insufficient_permissions", http_status: 403, recoverable: false, retry_safe: false },
        { name: "DecryptionFailure", condition: "kms_key_unavailable", http_status: 400, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "AWSCURRENT stage resolves to latest rotated version", trigger: "rotation_active", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "secretsmanager:GetSecretValue and KMS decrypt permissions", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "CreateSecret",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "ResourceExists", condition: "secret_name_taken", http_status: 409, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "secretsmanager:CreateSecret permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "PutSecretValue",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "ResourceNotFound", condition: "secret_absent", http_status: 404, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "secretsmanager:PutSecretValue permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
