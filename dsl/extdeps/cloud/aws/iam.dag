// extdeps/cloud/aws/iam.dag -- "What is AWS IAM?"
//
// AWS IAM resource model: roles, policies, trust relationships,
// managed policies.
//
// Consumers:
//   infra/aws/resources.dag    — IAM resource impl
//   cloud/aws/credential.dag   — AssumeRole chain

module extdeps.cloud.aws.iam

import extdeps.cloud.aws.core { Arn }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Roles ─────────────────────────────────────────────────────────

type AwsRole {
  arn: String
  name: String
  path: String
  assume_role_policy: TrustPolicy
  max_session_duration: Int
}

// ── Trust policies ────────────────────────────────────────────────

type TrustPolicy {
  version: String
  statements: List<TrustStatement>
}

type TrustPrincipal
  = AwsAccount { account_id: String }
  | AwsService { service: String }
  | Federated { provider: String }

type TrustStatement {
  effect: String
  principal: TrustPrincipal
  action: String
  condition: Map<String, String>?
}

// ── Policies ──────────────────────────────────────────────────────

type AwsPolicyDocument {
  version: String
  statements: List<AwsPolicyStatement>
}

type AwsPolicyEffect = AwsAllow | AwsDeny

type AwsPolicyStatement {
  effect: AwsPolicyEffect
  action: List<String>
  resource: List<String>
  condition: Map<String, String>?
}

type ManagedPolicy {
  arn: String
  name: String
  description: String?
}

// ── Operation behaviors ───────────────────────────────────────────

type AwsIamOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<AwsIamOperationBehavior> = [
  {
    operation: "GetRole",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [{ name: "NoSuchEntity", condition: "role_absent", http_status: 404, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "iam:GetRole permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "AssumeRole",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [
        { name: "AccessDenied", condition: "trust_policy_denied", http_status: 403, recoverable: false, retry_safe: false },
        { name: "MalformedPolicyDocument", condition: "invalid_session_policy", http_status: 400, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "session credentials have shorter lifetime than role max", trigger: "duration_override", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "sts:AssumeRole permission and matching trust policy", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
