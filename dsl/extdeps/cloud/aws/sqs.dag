// extdeps/cloud/aws/sqs.dag -- "What is Amazon SQS?"
//
// SQS resource model: queues, messages, visibility timeout,
// dead letter queues, FIFO vs Standard.
//
// Consumers:
//   infra/aws/resources.dag — queue resource impl (future)

module extdeps.cloud.aws.sqs

import extdeps.cloud.aws.aws { Arn }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Queue types ───────────────────────────────────────────────────

type SqsQueueType = SqsStandard | SqsFifo

// ── Queues ────────────────────────────────────────────────────────

type SqsQueue {
  url: String
  arn: String
  name: String
  type: SqsQueueType
  visibility_timeout_seconds: Int
  message_retention_seconds: Int
}

// ── Dead letter ───────────────────────────────────────────────────

type SqsRedrivePolicy {
  dead_letter_queue_arn: String
  max_receive_count: Int
}

// ── Messages ──────────────────────────────────────────────────────

type SqsMessage {
  message_id: String
  receipt_handle: String
  body: String
  attributes: Map<String, String>?
  message_group_id: String?
  deduplication_id: String?
}

// ── Constants ─────────────────────────────────────────────────────

data default_visibility_timeout: Int = 30

data max_visibility_timeout: Int = 43200

data max_message_size_bytes: Int = 262144

data max_retention_seconds: Int = 1209600

data fifo_throughput_per_second: Int = 300

// ── Operation behaviors ───────────────────────────────────────────

type SqsOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<SqsOperationBehavior> = [
  {
    operation: "SendMessage",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "QueueDoesNotExist", condition: "queue_absent", http_status: 400, recoverable: false, retry_safe: false },
        { name: "MessageTooLarge", condition: "exceeds_256kb", http_status: 400, recoverable: false, retry_safe: false }
      ],
      edge_cases: [{ description: "FIFO queues require MessageGroupId and optional DeduplicationId", trigger: "fifo_queue", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "sqs:SendMessage permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "ReceiveMessage",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [
        { name: "QueueDoesNotExist", condition: "queue_absent", http_status: 400, recoverable: false, retry_safe: false }
      ],
      edge_cases: [
        { description: "standard queues may return fewer messages than requested", trigger: "distributed_polling", severity: Low },
        { description: "messages become invisible for visibility_timeout after receive", trigger: "receive", severity: Medium }
      ],
      confidence: Documented,
      prerequisites: [{ description: "sqs:ReceiveMessage permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    operation: "DeleteMessage",
    behavior: {
      side_effects: WritesState,
      idempotent: true,
      idempotency_keys: ["receipt_handle"],
      determinism: Deterministic,
      failure_modes: [{ name: "InvalidReceiptHandle", condition: "expired_or_invalid_handle", http_status: 400, recoverable: false, retry_safe: false }],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "sqs:DeleteMessage permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
