// extdeps/cloud/aws/core.dag -- "What is AWS?"
//
// AWS identity model: ARNs, regions, SigV4 authentication,
// STS AssumeRole, session credentials, partitions.
//
// Consumers:
//   extdeps/cloud/aws/{s3,iam,lambda,secrets_manager,sqs}.dag
//   cloud/aws/credential.dag — credential chain

module extdeps.cloud.aws.aws

import extdeps.cloud.cloud { CloudAuthScheme, ServiceEndpoint }

// ── ARNs ──────────────────────────────────────────────────────────

type Arn {
  partition: String
  service: String
  region: String?
  account_id: String?
  resource: String
}

// ── Partitions ────────────────────────────────────────────────────

type AwsPartition = AwsStandard | GovCloud | AwsChina

// ── Regions ───────────────────────────────────────────────────────

type AwsRegion {
  name: String
  partition: String
}

data regions: List<AwsRegion> = [
  { name: "us-east-1", partition: "aws" },
  { name: "us-east-2", partition: "aws" },
  { name: "us-west-2", partition: "aws" },
  { name: "eu-west-1", partition: "aws" },
  { name: "eu-central-1", partition: "aws" },
  { name: "ap-southeast-1", partition: "aws" }
]

// ── SigV4 authentication ──────────────────────────────────────────

type AwsSigV4 {
  region: String
  service: String
  access_key: String
  secret_key: Secret
  session_token: Secret?
}

// ── STS ───────────────────────────────────────────────────────────

type AssumeRoleRequest {
  role_arn: String
  session_name: String
  duration_seconds: Int?
  external_id: String?
  policy: String?
}

type AwsSessionCredentials {
  access_key_id: String
  secret_access_key: Secret
  session_token: Secret
  expiration: String
}

// ── Constants ─────────────────────────────────────────────────────

data default_partition: String = "aws"

data default_session_duration: Int = 3600

data max_session_duration: Int = 43200

data sts_endpoint_template: String = "https://sts.{region}.amazonaws.com"
