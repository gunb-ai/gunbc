// extdeps/cloud/aws/lambda.dag -- "What is AWS Lambda?"
//
// Lambda resource model: functions, runtimes, layers,
// invocation types, handler specifications.
//
// Consumers:
//   infra/aws/resources.dag — compute resource impl (future)

module extdeps.cloud.aws.lambda

import extdeps.cloud.aws.core { Arn }
import std.behavioral {
  OperationBehavior, SideEffects, Determinism, Confidence, PrerequisiteKind, Severity
}

// ── Runtimes ──────────────────────────────────────────────────────
// AWS adds Lambda runtimes out-of-band (e.g., python3.13, nodejs22.x).
// A strict enum forces a compiler update for each new runtime. Use String
// and provide canonical values as data.

type LambdaRuntime = String

data canonical_runtimes: List<String> = [
  "nodejs20.x", "python3.12", "java21", "dotnet8",
  "provided.al2023", "custom"
]

// ── Functions ─────────────────────────────────────────────────────

type LambdaFunction {
  arn: String
  name: String
  runtime: LambdaRuntime
  handler: String
  memory_mb: Int
  timeout_seconds: Int
  role_arn: String
}

// ── Layers ────────────────────────────────────────────────────────

type LambdaLayer {
  arn: String
  version: Int
  compatible_runtimes: List<LambdaRuntime>
}

// ── Invocation ────────────────────────────────────────────────────

type InvocationType = RequestResponse | LambdaEvent | LambdaDryRun

// ── Constants ─────────────────────────────────────────────────────

data max_memory_mb: Int = 10240

data max_timeout_seconds: Int = 900

data max_layers: Int = 5

// ── Operation behaviors ───────────────────────────────────────────

type LambdaOperationBehavior {
  operation: String
  behavior: OperationBehavior
}

data operation_behaviors: List<LambdaOperationBehavior> = [
  {
    operation: "Invoke",
    behavior: {
      side_effects: WritesExternal,
      idempotent: false,
      idempotency_keys: null,
      determinism: NonDeterministic,
      failure_modes: [
        { name: "ResourceNotFound", condition: "function_absent", http_status: 404, recoverable: false, retry_safe: false },
        { name: "TooManyRequests", condition: "concurrency_exceeded", http_status: 429, recoverable: true, retry_safe: true },
        { name: "ServiceException", condition: "internal_error", http_status: 500, recoverable: true, retry_safe: true }
      ],
      edge_cases: [{ description: "cold start adds latency on first invocation", trigger: "cold_start", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "lambda:InvokeFunction permission", kind: Capability }],
      assumptions: [],
      unknowns: ["Exact cold start duration varies by runtime and memory"]
    }
  },
  {
    operation: "CreateFunction",
    behavior: {
      side_effects: WritesState,
      idempotent: false,
      idempotency_keys: null,
      determinism: Deterministic,
      failure_modes: [
        { name: "ResourceConflict", condition: "function_name_taken", http_status: 409, recoverable: false, retry_safe: false }
      ],
      edge_cases: [],
      confidence: Documented,
      prerequisites: [{ description: "lambda:CreateFunction permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  }
]
