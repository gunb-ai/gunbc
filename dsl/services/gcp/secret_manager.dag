// services/gcp/secret_manager.dag -- GCP Secret Manager API.
//
// Replaces: lib/gcp-ops/src/services/secret_manager.rs

module services.gcp.secret_manager

service gcp.SecretManager {

  operation AccessVersion {
    input {
      project_id: ProjectId
      secret: NonEmptyStr
      version: NonEmptyStr = "latest"
    }
    output {
      payload: Bytes
      name: String
    }
  }

  operation CreateSecret {
    input { project_id: ProjectId, secret_id: NonEmptyStr }
    output { name: String }
  }

  operation AddVersion {
    input { secret_name: String, payload: Bytes }
    output { name: String }
  }
}
