// services/github/gist.dag -- GitHub Gist API.
//
// Replaces: core/ir/src/transport/gist.rs, core/ir/src/ops/gist.rs

module services.github.gist

service github.Gist {
  @endpoint("https://api.github.com")

  operation Create {
    input {
      description: String
      content: String
      public: Bool = false
      auth_token: String
    }
    output {
      id: GistId
      url: Url @json("html_url")
    }
    @rest(POST, "/gists")
    @body_template({
      description: description,
      files: { "gunbc-snapshot.md": { content: content } },
      public: public
    })
    @headers({
      "Authorization": "Bearer {auth_token}",
      "Accept": "application/vnd.github+json",
      "User-Agent": "gunbc/1.0"
    })
    @permissions(["gist"])
    @mock_response(
      status: 201,
      body: { "html_url": "https://gist.github.com/mock/mock-id", "id": "mock-id" }
    )
  }
}
