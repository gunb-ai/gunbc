// services/github/gist.dag -- GitHub Gist API.
//
// Replaces: core/ir/src/transport/gist.rs, core/ir/src/ops/gist.rs

module services.github.gist

service github.Gist {

  operation Create {
    input {
      description: String
      content: String
      public: Bool = false
      auth_token: String
    }
    output {
      id: GistId
      html_url: Url
    }
  }
}
