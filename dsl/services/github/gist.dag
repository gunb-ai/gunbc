// services/github/gist.dag -- GitHub Gist API.
//
// Replaces: core/ir/src/transport/gist.rs, core/ir/src/ops/gist.rs
//
// Imports the Gist domain model from extdeps for type consistency.
// The extdeps define "what is a gist?" — this file defines "how do we call the API?"

module services.github.gist

import extdeps.github.gists { Gist, GistFile, GistVisibility }
import extdeps.github.core { GitHubUser, Repository }

service github.Gist {
  config {
    endpoint: "https://api.github.com"
    auth: BearerToken
    auth_input: auth_token
    // GitHub API rate limits: 5000 requests/hour for authenticated users
    rate_limit: { requests: 5000, per: hour, scope: core }
    // Retry on rate limit and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 504] }
  }

  operation Create {
    input {
      description: String
      content: String
      public: Bool = false
      auth_token: Secret
    }
    output {
      id: GistId
      html_url: Url
    }
    transport rest { method: POST, path: "/gists" }
  }
}
