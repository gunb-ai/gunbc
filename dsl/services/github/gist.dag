// services/github/gist.dag -- GitHub Gist API.
//
// Replaces: core/ir/src/transport/gist.rs, core/ir/src/ops/gist.rs

module services.github.gist

service github.Gist {
  @endpoint("https://api.github.com")

  operation Create {
    input {
      description: String
      files: Map<String, String>
      public: Bool = false
      auth_token: String
    }
    output {
      id: GistId
      url: Url @json("html_url")
    }
    @rest(POST, "/gists")
    @headers({ "Authorization": "Bearer {auth_token}" })
    @permissions(["gist"])
    @mock_response(
      status: 201,
      body: { "html_url": "https://gist.github.com/mock/mock-id", "id": "mock-id" }
    )
  }
}
