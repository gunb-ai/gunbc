// services/github/gist.dag -- GitHub Gist API.
//
// Replaces: core/ir/src/transport/gist.rs, core/ir/src/ops/gist.rs

module services.github.gist

service github.Gist {

  operation Create {
    input {
      description: String
      content: String
      public: Bool = false
      auth_token: String
    }
    output {
      id: GistId
      html_url: Url
    }
      description: description,
      files: { "gunbc-snapshot.md": { content: content } },
      public: public
    })
      "Authorization": "Bearer {auth_token}",
      "Accept": "application/vnd.github+json",
      "User-Agent": "gunbc/1.0"
    })
      status: 201,
      body: { "html_url": "https://gist.github.com/mock/mock-id", "id": "mock-id" }
    )
  }
}
