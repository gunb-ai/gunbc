// services/sdlc/control_plane.dag -- SDLC claim/outcome control-plane contracts.
//
// CG3: expose claim lease and stage outcome ledgers as DSL-visible
// service interfaces. This module defines transport-level CAS-style
// operations used by pipelines/workers for:
//   - atomic claim acquisition
//   - lease heartbeats/release
//   - deterministic stage outcome upserts
//
// Ledger backend migration path:
//   Phase 1 (current): JSON files on local disk, stubbed via mock responses
//   Phase 2: GCS bucket (infra/sdlc/deploy.dag provisions the bucket)
//   Phase 3: SQLite via @sqlite transport (when supported by daglang-emit)
//
// The transport is REST against a local endpoint. In production, this
// is a sidecar or Cloud Run service that wraps the chosen backend.
// The DSL pipeline doesn't change when the backend swaps.

module services.sdlc.control_plane

service sdlc.ControlPlane {
  @endpoint("http://127.0.0.1:8787")

  operation AcquireStageClaim {
    input {
      intake_key: NonEmptyStr
      issue_id: NonEmptyStr
      stage: NonEmptyStr
      run_key: NonEmptyStr
      claimant: NonEmptyStr
      lease_ttl_ms: Int = 30000
      expected_generation: Int?
    }
    output {
      acquired: Bool
      conflict: Bool
      lease_generation: Int
      lease_expires_at_epoch_ms: Int
      claim_token: String?
      conflict_reason: String?
      observed_generation: Int?
    }
    @rest(POST, "/v1/sdlc/claims/acquire")
    @mock_response(
      status: 200,
      body: {
        "acquired": true,
        "conflict": false,
        "lease_generation": 1,
        "lease_expires_at_epoch_ms": 1734000000000,
        "claim_token": "lease-token-1",
        "conflict_reason": null,
        "observed_generation": 1
      }
    )
  }

  operation HeartbeatStageClaim {
    input {
      intake_key: NonEmptyStr
      issue_id: NonEmptyStr
      stage: NonEmptyStr
      claim_token: NonEmptyStr
      lease_generation: Int
      lease_ttl_ms: Int = 30000
    }
    output {
      accepted: Bool
      lease_expires_at_epoch_ms: Int
      observed_generation: Int?
    }
    @rest(POST, "/v1/sdlc/claims/heartbeat")
    @idempotent
    @mock_response(
      status: 200,
      body: {
        "accepted": true,
        "lease_expires_at_epoch_ms": 1734000002000,
        "observed_generation": 1
      }
    )
  }

  operation ReleaseStageClaim {
    input {
      intake_key: NonEmptyStr
      issue_id: NonEmptyStr
      stage: NonEmptyStr
      claim_token: NonEmptyStr
      lease_generation: Int
      release_reason: String = "completed"
    }
    output { released: Bool, observed_generation: Int? }
    @rest(POST, "/v1/sdlc/claims/release")
    @idempotent
    @mock_response(
      status: 200,
      body: {
        "released": true,
        "observed_generation": 1
      }
    )
  }

  operation UpsertStageOutcome {
    input {
      intake_key: NonEmptyStr
      issue_id: NonEmptyStr
      stage: NonEmptyStr
      run_key: NonEmptyStr
      outcome_status: NonEmptyStr
      retry_attempt: Int = 0
      terminal: Bool = false
      approval_required: Bool = false
      payload_hash: NonEmptyStr
      claim_generation: Int?
    }
    output {
      updated: Bool
      previous_status: String?
      checksum: NonEmptyStr
    }
    @rest(PUT, "/v1/sdlc/outcomes/{intake_key}/{stage}")
    @idempotent
    @mock_response(
      status: 200,
      body: {
        "updated": true,
        "previous_status": null,
        "checksum": "sha256:mock-outcome"
      }
    )
  }

  operation GetStageOutcome {
    input { intake_key: NonEmptyStr, stage: NonEmptyStr }
    output {
      found: Bool
      outcome_status: String?
      run_key: String?
      retry_attempt: Int?
      terminal: Bool?
      approval_required: Bool?
      payload_hash: String?
      updated_at_epoch_ms: Int?
    }
    @rest(GET, "/v1/sdlc/outcomes/{intake_key}/{stage}")
    @idempotent @readonly
    @mock_response(
      status: 200,
      body: {
        "found": true,
        "outcome_status": "accepted",
        "run_key": "sdlc::github::intent-1::intent-1::v1",
        "retry_attempt": 0,
        "terminal": false,
        "approval_required": false,
        "payload_hash": "sha256:mock-outcome",
        "updated_at_epoch_ms": 1734000001000
      }
    )
  }
}
