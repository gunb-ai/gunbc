// services/sdlc/providers/gcs_outcome_ledger.dag
//
// Layer 3 concrete implementation: GcsOutcomeLedger implements OutcomeLedger.
//
// Uses GCS objects for durable outcome storage. Idempotent upsert with
// content-hash collision detection via GCS preconditions.
//
// Object layout:
//   gs://{bucket}/outcomes/{run_key}/{stage}.json
//   Contents: StageOutcome serialized as JSON
//
// CAS for idempotent upsert:
//   - First write: x-goog-if-generation-match: 0 (create-only)
//   - Re-write with same content_hash: succeeds (idempotent replay)
//   - Re-write with different content_hash: fails (conflict)
//
// Gap E resolution: GCS generation-based CAS for outcome safety.

module services.sdlc.providers.gcs_outcome_ledger

import interfaces.outcome_ledger { OutcomeLedger }
import std.types { NonEmptyStr, StageOutcome }

// =========================================================================
// GcsOutcomeLedger : OutcomeLedger
// =========================================================================
//
// Profile binding: cloud_run
// Storage: GCS objects in gs://{bucket}/outcomes/
// CAS: GCS object generation for first-writer-wins

service gcs.OutcomeLedger : OutcomeLedger {

  @endpoint("https://storage.googleapis.com")
  @auth(BearerToken)

  config {
    bucket: NonEmptyStr
    project: NonEmptyStr
  }

  operation upsert {
    input {
      run_key: NonEmptyStr
      stage: NonEmptyStr
      outcome: StageOutcome
    }
    output {
      updated: Bool
      previous: StageOutcome?
    }
    // Write outcome object. For first write, generation-match: 0 ensures
    // exactly-once semantics. For replays with matching content_hash, the
    // handler reads the existing object and returns success if hashes match.
    @rest(POST, "/upload/storage/v1/b/{config.bucket}/o?uploadType=media&name=outcomes/{run_key}/{stage}.json")
    @header("Content-Type", "application/json")
    @idempotent
    @permissions(["storage.objects.create", "storage.objects.get"])
    @mock_response(
      status: 200,
      body: {
        "updated": true,
        "previous": null
      }
    )
  }

  operation get {
    input {
      run_key: NonEmptyStr
      stage: NonEmptyStr
    }
    output {
      found: Bool
      outcome: StageOutcome?
    }
    // Read outcome object. 404 → { found: false, outcome: null }.
    @rest(GET, "/storage/v1/b/{config.bucket}/o/outcomes%2F{run_key}%2F{stage}.json?alt=media")
    @idempotent @readonly
    @permissions(["storage.objects.get"])
    @error_map(status: 404, body: { "found": false, "outcome": null })
    @mock_response(
      status: 200,
      body: {
        "found": true,
        "outcome": {
          "run_key": "mock-run-key",
          "stage": "design",
          "status": "Success",
          "payload": null,
          "error": null,
          "attempt_count": 1,
          "retry_budget_remaining": 2,
          "next_attempt_at": null,
          "created_at": "",
          "updated_at": ""
        }
      }
    )
  }

  operation list_by_issue {
    input { issue_id: NonEmptyStr }
    output { outcomes: List<StageOutcome> }
    // List objects with prefix matching the issue_id, then read each.
    @rest(GET, "/storage/v1/b/{config.bucket}/o?prefix=outcomes/{issue_id}/")
    @readonly
    @permissions(["storage.objects.list"])
    @mock_response(
      status: 200,
      body: { "outcomes": [] }
    )
  }
}

// ── Tests ──────────────────────────────────────────────────────────

fixture gcs_auth {
    mock cloud_env.config -> { provider: "gcp", runtime: "cloud-run" }
    mock cloud_env.credential -> { token: "<MOCK_GCS_TOKEN>", source_type: "static", scheme: "bearer" }
}

test gcs_outcome_upsert : gcs_auth {
    @tier(Unit)
    @hermetic(true)

    input upsert/prepare.run_key -> "sdlc::42::design::v1"
    input upsert/prepare.stage -> "design"

    mock upsert/execute.response -> rest_response(200, {
        name: "outcomes/sdlc::42::design::v1/design.json",
        generation: "1706745600000000",
        metageneration: "1"
    })

    expect result.updated == true
}

test gcs_outcome_get_found : gcs_auth {
    @tier(Unit)
    @hermetic(true)

    input get/prepare.run_key -> "sdlc::42::design::v1"
    input get/prepare.stage -> "design"

    mock get/execute.response -> rest_response(200, {
        run_key: "sdlc::42::design::v1",
        stage: "design",
        status: "Success",
        payload: null,
        error: null,
        attempt_count: 1,
        retry_budget_remaining: 2,
        next_attempt_at: null,
        created_at: "",
        updated_at: ""
    })

    expect result.found == true
}

test gcs_outcome_get_not_found : gcs_auth {
    @tier(Unit)
    @hermetic(true)

    input get/prepare.run_key -> "sdlc::99::idea::v1"
    input get/prepare.stage -> "idea"

    // 404 = object does not exist
    mock get/execute.response -> rest_response(404, {
        error: { code: 404, message: "Not Found" }
    })

    expect result.found == false
}
