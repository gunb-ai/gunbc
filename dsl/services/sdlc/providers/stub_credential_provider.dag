// services/sdlc/providers/stub_credential_provider.dag
//
// Stub CredentialProvider for unit tests.
// Bound via profile: `bind CredentialProvider -> StubCredentialProvider`.

module services.sdlc.providers.stub_credential_provider

import std.types { AccessToken, AuthScheme, CredentialFlow, NonEmptyStr }
import interfaces.credential_provider { CredentialProvider }

service StubCredentialProvider : CredentialProvider {

  operation acquire {
    input {
      secret_name: NonEmptyStr
      flow: CredentialFlow
      scheme: AuthScheme = Bearer
      source_id: NonEmptyStr
      required_scopes: List<String>
    }
    output {
      token: AccessToken
    }
      body: {
        "token": { "token": "<STUB_TOKEN>", "scheme": "bearer", "expires_at": "2099-01-01T00:00:00Z" }
      }
    )
  }

  operation validate {
    input { token: AccessToken }
    output { valid: Bool, expires_in: Int? }
  }
}
