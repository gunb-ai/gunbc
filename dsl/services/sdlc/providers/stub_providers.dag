// services/sdlc/providers/stub_providers.dag
//
// Layer 3 stub implementations for unit_test profile.
// All operations return deterministic, in-memory responses.
// No external I/O. No filesystem. No network.
//
// These exist so the pipeline can be tested hermetically without
// any external dependencies.

module services.sdlc.providers.stub_providers

import interfaces.issue_provider { IssueProvider }
import interfaces.claim_store { ClaimStore }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }
import interfaces.signal_store { SignalStore }
import interfaces.artifact_store { ArtifactStore }
import std.types { NonEmptyStr, StageOutcome, ArtifactPayload, ArtifactMarker }

// =========================================================================
// StubIssueProvider : IssueProvider  (unit_test profile)
// =========================================================================

service stub.IssueProvider : IssueProvider {
  @hermetic

  operation discover {
    input { labels: List<String>, state: String? }
    output { issues: Json }
    @mock_response(status: 0, body: [])
  }

  operation get {
    input { id: NonEmptyStr }
    output { issue: Json, found: Bool }
    @mock_response(status: 0, body: {
      "issue": {
        "id": "{id}",
        "title": "Stub issue",
        "body": "Stub body",
        "stage": "Idea",
        "labels": ["sdlc:idea"],
        "url": null,
        "author": "stub",
        "created_at": "2026-01-01T00:00:00Z",
        "updated_at": "2026-01-01T00:00:00Z"
      },
      "found": true
    })
  }

  operation create {
    input { title: NonEmptyStr, body: String, labels: List<String> }
    output { issue: Json }
    @mock_response(status: 0, body: {
      "issue": {
        "id": "stub-1",
        "title": "{title}",
        "body": "{body}",
        "stage": "Idea",
        "labels": [],
        "url": null,
        "author": "stub"
      }
    })
  }

  operation comment {
    input { id: NonEmptyStr, body: String, marker: NonEmptyStr? }
    output { comment_id: NonEmptyStr, ok: Bool }
    @mock_response(status: 0, body: { "comment_id": "stub-comment-1", "ok": true })
  }

  operation set_labels {
    input { id: NonEmptyStr, labels: List<String> }
    output { ok: Bool }
    @mock_response(status: 0, body: { "ok": true })
  }

  operation close {
    input { id: NonEmptyStr }
    output { ok: Bool }
    @mock_response(status: 0, body: { "ok": true })
  }

  operation list_events {
    input { id: NonEmptyStr, since: String? }
    output { events: Json }
    @mock_response(status: 0, body: [])
  }
}

// =========================================================================
// StubClaimStore : ClaimStore  (unit_test profile)
// =========================================================================

service stub.ClaimStore : ClaimStore {
  @hermetic

  operation acquire {
    input { issue_id: NonEmptyStr, stage: NonEmptyStr, owner: NonEmptyStr, lease_ttl_ms: Int }
    output { acquired: Bool, conflict: Bool, lease_generation: Int }
    @mock_response(status: 0, body: { "acquired": true, "conflict": false, "lease_generation": 1 })
  }

  operation heartbeat {
    input { issue_id: NonEmptyStr, stage: NonEmptyStr, owner: NonEmptyStr, generation: Int }
    output { accepted: Bool }
    @mock_response(status: 0, body: { "accepted": true })
  }

  operation release {
    input { issue_id: NonEmptyStr, stage: NonEmptyStr, owner: NonEmptyStr, generation: Int }
    output { released: Bool }
    @mock_response(status: 0, body: { "released": true })
  }
}

// =========================================================================
// StubOutcomeLedger : OutcomeLedger  (unit_test profile)
// =========================================================================

service stub.OutcomeLedger : OutcomeLedger {
  @hermetic

  operation upsert {
    input { run_key: NonEmptyStr, stage: NonEmptyStr, outcome: StageOutcome }
    output { updated: Bool, previous: Json? }
    @mock_response(status: 0, body: { "updated": true, "previous": null })
  }

  operation get {
    input { run_key: NonEmptyStr, stage: NonEmptyStr }
    output { found: Bool, outcome: Json? }
    @mock_response(status: 0, body: { "found": false, "outcome": null })
  }

  operation list_by_issue {
    input { issue_id: NonEmptyStr }
    output { outcomes: Json }
    @mock_response(status: 0, body: { "outcomes": [] })
  }
}

// =========================================================================
// StubAgentProvider : AgentProvider  (unit_test profile)
// =========================================================================

service stub.AgentProvider : AgentProvider {
  @hermetic

  operation spawn {
    input { prompt: String, repo_path: String, branch: NonEmptyStr, model: String?, timeout_seconds: Int?, approval_mode: String? }
    output { run_id: NonEmptyStr, status: String, started: Bool }
    @mock_response(status: 0, body: { "run_id": "stub-run-001", "status": "completed", "started": true })
  }

  operation poll {
    input { run_id: NonEmptyStr }
    output { status: String, finished: Bool, exit_code: Int?, error: String? }
    @mock_response(status: 0, body: { "status": "completed", "finished": true, "exit_code": 0, "error": null })
  }

  operation cancel {
    input { run_id: NonEmptyStr, reason: String? }
    output { cancelled: Bool, final_status: String }
    @mock_response(status: 0, body: { "cancelled": true, "final_status": "cancelled" })
  }

  operation get_result {
    input { run_id: NonEmptyStr }
    output { status: String, exit_code: Int?, stdout: String?, stderr: String?, files_changed: List<String> }
    @mock_response(status: 0, body: { "status": "completed", "exit_code": 0, "stdout": "Stub implementation.", "stderr": "", "files_changed": [] })
  }
}

// =========================================================================
// StubSignalStore : SignalStore  (unit_test profile)
// =========================================================================

service stub.SignalStore : SignalStore {
  @hermetic

  operation emit {
    input { signal: Json }
    output { emitted: Bool }
    @mock_response(status: 0, body: { "emitted": true })
  }

  operation consume {
    input { signal_types: List<String>, limit: Int? }
    output { signals: Json }
    @mock_response(status: 0, body: { "signals": [] })
  }

  operation ack {
    input { idempotency_key: NonEmptyStr }
    output { acked: Bool }
    @mock_response(status: 0, body: { "acked": true })
  }
}

// =========================================================================
// StubArtifactStore : ArtifactStore  (unit_test profile)
// =========================================================================

service stub.ArtifactStore : ArtifactStore {
  @hermetic

  operation store {
    input { artifact_id: NonEmptyStr, payload: ArtifactPayload, content_hash: NonEmptyStr }
    output { stored: Bool, conflict: Bool }
    @mock_response(status: 0, body: { "stored": true, "conflict": false })
  }

  operation retrieve {
    input { artifact_id: NonEmptyStr }
    output { found: Bool, payload: Json?, content_hash: String? }
    @mock_response(status: 0, body: { "found": false, "payload": null, "content_hash": null })
  }

  operation store_marker {
    input { marker: ArtifactMarker }
    output { stored: Bool }
    @mock_response(status: 0, body: { "stored": true })
  }

  operation get_canonical_marker {
    input { run_key: NonEmptyStr, artifact_type: String }
    output { found: Bool, marker: Json? }
    @mock_response(status: 0, body: { "found": false, "marker": null })
  }
}
