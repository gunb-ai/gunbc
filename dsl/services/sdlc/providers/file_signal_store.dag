// services/sdlc/providers/file_signal_store.dag
//
// Layer 3 concrete implementation: FileSignalStore implements SignalStore.
//
// Uses local JSON files for signal persistence. Single-machine only.

module services.sdlc.providers.file_signal_store

import interfaces.signal_store { SignalStore }
import std.types { NonEmptyStr, Signal, SignalType }

service file.SignalStore : SignalStore {

  config {
    dir: String = "target/sdlc/signals"
  }

  operation emit {
    input { signal: Signal }
    output { emitted: Bool }
    @file(WRITE, "{config.dir}/{signal.idempotency_key}.json")
    @idempotent
    @mock_response(
      status: 0,
      body: { "emitted": true }
    )
  }

  operation consume {
    input { signal_types: List<SignalType>, limit: Int? }
    output { signals: List<Signal> }
    @file(READ_DIR, "{config.dir}")
    @mock_response(
      status: 0,
      body: { "signals": [] }
    )
  }

  operation ack {
    input { idempotency_key: NonEmptyStr }
    output { acked: Bool }
    @file(DELETE, "{config.dir}/{idempotency_key}.json")
    @idempotent
    @mock_response(
      status: 0,
      body: { "acked": true }
    )
  }
}

// ── Tests ──────────────────────────────────────────────────────────

test file_signal_store_emit {
    @tier(Unit)
    @hermetic(true)

    input emit/prepare.signal -> {
        signal_type: ReconcileTick { window_id: "w-1" },
        idempotency_key: "sig-1",
        payload: {},
        produced_at: "2026-01-01T00:00:00Z",
        consumed_at: null
    }

    mock emit/execute.response -> file_response(0, {
        emitted: true
    })

    expect result.emitted == true
}
