// services/llm/anthropic.dag -- Anthropic Messages API.
//
// Replaces: core/ir/src/transport/llm/anthropic.rs (request builder + response parser)
//           lib/llm-ops/src/lib.rs (PrepareChatRequest/ParseChatResponse for anthropic)

module services.llm.anthropic

service llm.Anthropic {
  @endpoint("https://api.anthropic.com")
  @auth(Header("x-api-key"))

  operation Messages {
    input {
      model: String
      messages: Json
      max_tokens: Int = 4096
      temperature: Float?
      system: String?
    }
    output {
      content: String @json("content/0/text")
      model: String @json("model")
      stop_reason: String @json("stop_reason")
      input_tokens: Int @json("usage/input_tokens")
      output_tokens: Int @json("usage/output_tokens")
    }
    @rest(POST, "/v1/messages")
    @headers({ "anthropic-version": "2023-06-01" })
    @permissions(["messages"])
    @mock_response(
      status: 200,
      body: {
        "content": [{"type": "text", "text": "Hello"}],
        "model": "claude-sonnet-4-20250514",
        "stop_reason": "end_turn",
        "usage": {"input_tokens": 10, "output_tokens": 5}
      }
    )
  }
}
