// services/llm/anthropic.dag -- Anthropic Messages API.
//
// Replaces: core/ir/src/transport/llm/anthropic.rs (request builder + response parser)
//           lib/llm-ops/src/lib.rs (PrepareChatRequest/ParseChatResponse for anthropic)

module services.llm.anthropic

import extdeps.llm.core { Role, LlmMessage, TokenUsage, StopReason }
import extdeps.llm.anthropic {
  AnthropicModel, AnthropicModelSpec, ContentBlock,
  SystemPrompt, ThinkingConfig, AnthropicApiVersion
}
import extdeps.llm.pricing { ModelPricing, ContextWindow, ModelCapability }

service llm.Anthropic {
  // TODO(RT-A3): add auth_input: api_key — requires threading api_key: Secret through
  // all callers (design.dag, sdlc_stages.dag, review_pipeline.dag).
  config {
    endpoint: "https://api.anthropic.com"
    auth: Header("x-api-key")
    // Anthropic API rate limits: varies by tier (1000-4000 RPM), use conservative default
    rate_limit: { requests: 1000, per: minute, scope: messages }
    // Retry on overload and server errors with exponential backoff
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 529] }
  }

  operation Messages {
    input {
      model: String
      messages: Json
      max_tokens: Int = 4096
      temperature: Float?
      system: String?
    }
    output {
      content: String from "content/0/text"
      model: String from "model"
      stop_reason: String from "stop_reason"
      input_tokens: Int from "usage/input_tokens"
      output_tokens: Int from "usage/output_tokens"
    }
    transport rest { method: POST, path: "/v1/messages" }
  }
}
