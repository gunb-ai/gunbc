// dsl/std/emit_model.dag — `dag run --source-root dsl` module for
// `MethodTemplateContract` and friends.
//
// This file is the surviving authority for `std.emit_model`; dsl sources import it directly.

module std.emit_model

// Stand-in `DeclarationRef` — bootstrap rows are empty.
type DeclarationRef = String

type PlaceholderConvention
  = IndexedArgs
  | NamedArg

// SimpleMethodSpec — the single authority shape for a flat-templatable
// algebra method on one target: a `{recv}`/`{arg}` render template plus
// the `wraps_result` flag (Rust Rc-wrapping; false for Python/Go). Each
// per-target `*_simple_method_specs` list in `extdeps/languages/*/emit.dag`
// inhabits this type and derives its `*_method_templates*()` map(s) from it
// (the #5039 pattern, extended to Python/Go). Lives here, in std, so all
// three targets share one type rather than forking it per file.
type SimpleMethodSpec {
  method_name: String
  template: String
  wraps_result: Bool
}

// MethodTemplateContract (P1 substrate).
type MethodTemplateContract {
  dag_method: DeclarationRef
  runtime_template: String
  emit_template: String
  wraps_result: Bool
  placeholder_convention: PlaceholderConvention
}
