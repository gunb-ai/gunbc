// std/verification.dag -- structural authority for generated tests.
//
// A TestClaim is data: one typed assertion over one modeled compiler subject.
// Test runners and target framework renderers consume this schema; they do not
// invent parallel assertion taxonomies.
//
// Relationship to src/v4/std/verification.dag:
//   This is the shared std projection of the v4 TestClaim substrate for the
//   v2.5 fork. It keeps the older TestCase/TestNodeCostDimension surfaces in
//   this canonical file while giving tokenize/parse/normalize/resolve/infer/
//   emit coverage a closed TestClaim schema to consume.

module std.verification

import std.types { Milliseconds }

// Closed assertion kind set. Each variant names a predicate shape that is
// grounded in compiler substrate facts: equality over modeled nodes, diagnostic
// rejection, successful compilation, or round-trip preservation.
type AssertKind
  = Equals
  | DiagnosticAssert
  | Compiles
  | RoundTrips

// Test generation tier: Tier1 structural checks, Tier2 safety checks, and
// Tier3 emitted/runtime verification.
type TestgenTier
  = Tier1
  | Tier2
  | Tier3

// Test generation layer: local unit-shaped facts, integrated stage facts, or
// external/boundary behavior.
type TestgenLayer
  = Unit
  | Integration
  | Boundary

type TestClassification {
  tier: TestgenTier
  layer: TestgenLayer
}

// Closed impossible-bug taxonomy for generated regression claims. New variants
// require a modeled bug class, not a prose-only label.
type ImpossibleBugClass
  = SuboptimalComplexity
  | IdempotencyContract
  | TransportTypeDrift
  | NestedOptionalFlatten
  | UnenumeratedEffects
  | UnhandledDiagnosticPaths

// Manual anchor bridge for the initial generated corpus. The bridge dissolves
// when generated corpus coverage owns every row directly.
type T19ManualAnchorKey
  = T19ManualTcConjEmpty
  | T19ManualTcDisjEmpty
  | T19ManualTcArrowTwoConj
  | T19ManualTcCardinalityEmpty
  | T19ManualTcInstantiationEmpty
  | T19ManualTcConjEqualsRefl
  | T19ManualNatAddLeftIdentity
  | T19ManualNatAddRightIdentity
  | T19ManualNatAddAssociativity
  | T19ManualNatMulLeftIdentity
  | T19ManualNatMulAnnihilator
  | T19ManualNatMulAssociativity
  | T19ManualAnchorAbsent

// Compiler-stage subjects that structural coverage can bind without relying on
// free-form labels. The stage set follows the v2.5 pipeline boundary names that
// this work item unblocks.
type CompilerStageSubject
  = TokenizeStage
  | ParseStage
  | NormalizeStage
  | ResolveStage
  | InferStage
  | EmitStage

// A structural test input. `CompilerStageInput` gives pipeline-stage coverage a
// typed subject edge; `NodeInput` remains the generic v4-compatible node claim
// shape until the shared Node carrier supersedes the v2 compiler record.
type TestClaimInput
  = NodeInput { node: Node }
  | CompilerStageInput { stage: CompilerStageSubject, node: Node }

// A structural expected result. This is a bounded scaffold because shared
// `std.diagnostic.Outcome<T>` does not exist in dsl/std yet; dissolve by
// replacing this with the shared Outcome carrier once diagnostic.dag graduates.
type TestClaimExpected
  = ExpectedNode { node: Node }
  | ExpectedDiagnostic

// Core TestClaim carrier. Receipts live beside claim rows; renderers and
// runners consume `kind`, `input`, `expected`, and `classification` rather than
// reverse-engineering meaning from labels.
type TestClaim {
  kind: AssertKind
  label: String
  t19_anchor: T19ManualAnchorKey
  input: TestClaimInput
  expected: TestClaimExpected
  classification: TestClassification
}

// A named test case is a conjunction of claims.
type TestCase {
  name: String
  claims: List<TestClaim>
  ignored: Bool
}

// R3 T-Workflow-As-Data gate #101 (`test_cost_dimension_landed`).
//
// Test execution cost is a first-class structural fact attached to a modeled
// test node. This older dsl projection keeps Milliseconds until the v3
// TimingBudget / TimingMeasurement authority converges into shared std.
type TestNodeRef
  = TestCaseNode { test_case: TestCase }

type TestNodeCostDimension {
  node: TestNodeRef
  budget_ms: Milliseconds
  measured_ms: Milliseconds
}
