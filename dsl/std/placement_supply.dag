// std/placement_supply.dag — v2-safe placement projection carrier.
//
// First-fit placement consumers (ctrl plans.capacity, shadow reconciler)
// project physical compute supply into PlacementSupplyRow. Cordoning is
// absence: only schedulable hosts appear in the supply list — no stored
// healthy: Bool flag.
//
// Authority for ComputeHost remains std.compute_fabric; CpuFacts / CpuIdentity
// is std.cpu; DIMM populations std.memory.operator_fleet. Thin projection
// surface importable without pulling the full fabric graph.

module std.placement_supply

import std.measure {
  ByteSize,
  Hertz,
  HardwareThreadCount,
  byte_size_count,
  hardware_thread_count_value,
  hertz_count,
}
import std.types { NonEmptyStr, Int }

type HostIdentity = NonEmptyStr where brand("HostIdentity")

type PlacementSupplyRow {
  identity: HostIdentity
  hardware_threads: HardwareThreadCount
  clock_hz: Hertz
  ram_bytes: ByteSize
}

fn cpu_capacity_hz_row(row: PlacementSupplyRow) -> Int {
  hardware_thread_count_value(row.hardware_threads) * hertz_count(row.clock_hz)
}
