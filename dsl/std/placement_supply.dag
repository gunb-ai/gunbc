// std/placement_supply.dag — v2-safe placement projection carrier.
//
// First-fit placement consumers (ctrl plans.capacity, shadow reconciler)
// project physical compute supply into PlacementSupplyRow. Cordoning is
// absence: only schedulable hosts appear in the supply list — no stored
// healthy: Bool flag.
//
// Authority for ComputeHost remains std.compute_fabric; CpuFacts / CpuIdentity
// is std.cpu; DIMM populations std.memory.operator_fleet. Thin projection
// surface importable without pulling the full fabric graph.

module std.placement_supply

import std.measure {
  ByteSize,
  Hertz,
  HardwareThreadCount,
  hardware_thread_count_value,
  hertz,
  hertz_count,
}
import std.types { NonEmptyStr }

type HostIdentity = NonEmptyStr where brand("HostIdentity")

type PlacementSupplyRow {
  identity: HostIdentity
  hardware_threads: HardwareThreadCount
  clock_hz: Hertz
  ram_bytes: ByteSize
}

// Aggregate clock capacity = thread count x per-thread rate. The product is a
// Frequency at unit scale, so it projects back onto `Hertz` via `hertz()` rather
// than leaking a flat `Int` at the std boundary (the dimension stays attached;
// GATE-0 value-Measure boundary projection, mirroring `money_micros()` in
// std.compute_fabric). `let` bindings avoid a v2 parse ambiguity where
// `call() * call()` is misparsed as juxtaposition (make_call_expr `<expr>`).
fn cpu_capacity_hz_row(row: PlacementSupplyRow) -> Hertz {
  let threads = hardware_thread_count_value(row.hardware_threads)
  let hz = hertz_count(row.clock_hz)
  hertz(threads * hz)
}
