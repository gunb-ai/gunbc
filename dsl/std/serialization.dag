// std/serialization.dag -- Wire format contracts for external APIs.
//
// Types declare how their values appear on the wire (JSON responses).
// Modules declare a wire_contract that applies to all types within.
// The emitter reads the contract and generates target-language
// serialization attributes (e.g., serde for Rust).
//
// Without a wire_contract, enums use internal tagging ({"_variant": "Name"}).
// With StringVariant, enums serialize as plain strings ("Name" or "name").

module std.serialization

// Declaration reference for source-level wire contracts. Today this is the
// authored declaration name; the v3 DeclarationRef carrier can replace this
// alias when v2 retires.
type DeclarationRef = String

// How enum variant names map to wire strings.
// AsAuthored: variant name as-is (User → "User", Bot → "Bot").
// SnakeCase: variant name lowercased with underscores (EndTurn → "end_turn").
// StripPrefixAndSnakeCase / StripSuffixAndSnakeCase /
// StripPrefixSuffixAndSnakeCase: remove at least one authored affix, then
// snake_case the result. These handle provider-domain variants whose source
// names carry role context that is not part of the wire discriminant.
type VariantNaming
  = AsAuthored
  | SnakeCase
  | StripPrefixAndSnakeCase { prefix: String }
  | StripSuffixAndSnakeCase { suffix: String }
  | StripPrefixSuffixAndSnakeCase { prefix: String, suffix: String }

// How enum variants appear on the wire.
// StringVariant: plain strings — the common REST API pattern.
// TaggedVariant: internally tagged objects ({"_variant": "Name"}) — .dag default.
// InternallyTaggedObject: serde-style internally tagged payload objects with an
// explicit discriminator field ({"type": "text", ...}).
type VariantEncoding
  = StringVariant { naming: VariantNaming }
  | InternallyTaggedObject { tag_field: String, naming: VariantNaming }
  | TaggedVariant

// Declaration-level override. Selection order is:
//   1. CoproductWireContract for the exact coproduct declaration.
//   2. Module-local `data wire_contract: VariantEncoding` fallback/default.
//   3. Emitter default.
type CoproductWireContract {
  coproduct: DeclarationRef
  encoding: VariantEncoding
}

// Module-level wire contract. Declared as:
//   data wire_contract: WireContract = { variant_encoding: StringVariant { naming: AsAuthored } }
type WireContract {
  variant_encoding: VariantEncoding
}

// Wire format for response bodies.
// Json: parse with serde_json (default for REST).
// Text: read as raw string (diffs, plain-text APIs).
// Declared on transport: response_format: Text
type WireFormat = Json | Text
