// std/realization_width.dag — Peripheral host spawn-width fold (Phase 1).
//
// Schedule topology stays pure (std.realization_schedule); sharding width is a
// PERIPHERAL host realization folded against placement supply (§3). Width =
// min(shard_count, hardware_threads) — demand parallelism capped by what the
// host provisions, not a scheduler-local authority.
//
// IndependentShards.shard_count (product.compute_fabric) and the host's
// HardwareThreadCount (extracted from product.placement_supply by the caller) both
// arrive as grounded std carriers, so this module stays product-free (layer DAG).
//
// 🟡 SCAFFOLD — feature:scheduler-width-budget —
// consumer: claim_executor run_walk spawn cap + run_discovery_corpus shard split —
// dissolve-on: v2 self-compile-clean replaces host fan-out with the v2 executor
// consuming the width field directly; corpus RunnableDiscoveryBatch projected as N
// IndependentShards runnables (cli_run.rs:2198 serial loop deleted).
//
// Dissolution trigger: claim_executor spawner reads bounded_host_spawn_width;
// width witnesses enroll when corpus shards ≥2.

module std.realization_width

import std.types { Int, List }
import std.nat { Nat, nat_max }
import std.measure {
  HardwareThreadCount,
  ByteSize,
  Measure,
  Time,
  Nano,
  byte_size,
  byte_size_count,
  measure_scale_fraction_floor,
  measure_fit_count_floor,
  hardware_thread_count,
  hardware_thread_count_value,
  time_measure,
}
import std.pareto { AxisGoal, LowerIsBetter }
import std.realization_schedule {
  Schedule,
  RealizationPlan,
  RealizationObjective,
  CostAccount,
  CostBasis,
  schedule_eq,
  cost_account_measured,
  cost_account_predicted_zero,
  cost_account_time_count,
}

fn int_min(a: Int, b: Int) -> Int {
  if a < b { a } else { b }
}

fn nano_time(count: Nat) -> Measure<Time, Nano, Nat> {
  time_measure(count: count)
}

fn nano_predicted_zero() -> CostAccount<Nano> {
  cost_account_predicted_zero()
}

// Ground IndependentShards demand: non-positive shard_count is degenerate — fail-closed to 1.
fn shard_count_positive(shard_count: Int) -> Int {
  if shard_count <= 0 { 1 } else { shard_count }
}

// Peripheral width fold: min(IndependentShards.shard_count, hardware_threads). Takes the
// grounded HardwareThreadCount projection (a std.measure carrier) rather than the product
// PlacementSupplyRow, so std stays product-free (layer DAG); the product caller extracts
// supply.hardware_threads and threads it in.
// GATE-0 Int↔Nat: shard_count is Int (IndependentShards carrier); hardware_thread_count(count:)
// expects Nat. Nat⊂Int widening at the constructor is load-bearing and verified by witness
// execution today (realization_width_witness_test.dag).
//   feature:v2-nat-int-tightening — dissolve-on: explicit Nat projection when the checker
//   stops auto-widening Int to Nat at measure constructors.
fn bounded_host_spawn_width(shard_count: Int, hardware_threads: HardwareThreadCount) -> HardwareThreadCount {
  let demand = shard_count_positive(shard_count: shard_count)
  let cores = hardware_thread_count_value(t: hardware_threads)
  let width = int_min(a: demand, b: cores)
  hardware_thread_count(count: width)
}

// ── memory-aware width (§1-C): the third term — fail-closed against OOM ───────
// The CPU/topology bound above is memory-BLIND: N concurrent whole-tree-resolve shards
// each peak at the MEASURED per-shard RSS, and N×peak must stay under the host's cgroup
// budget or the batch is OOM-killed (exit 137). The memory term backs fan-out off BEFORE
// the kill — §1's safety axis made structural, CPU and memory ONE width relationship (a
// CPU bound patched after an OOM is the §6 forked-logic trap). The per-shard peak is sourced
// from the §1 measurement keystone (claim_executor's VmHWM emit), NOT a hand-grounded literal
// (the literal #5419 deleted as unwired); the live budget is read by the host realizer and
// threaded in — §3 measured⇒peripheral: WE author+commit the measurement, an EXTERNAL system
// (the host/cgroup) authors the budget so the host READS it live.

// Conservative fraction applied to the LIVE budget before dividing by the measured per-shard
// peak: floor(budget × 4/5) = 0.80×budget. memory.max is the HARD OOM-kill ceiling and the
// per-shard peak is a division-derived ESTIMATE (whole-floor VmHWM ÷ width) with non-shard
// overhead around it (parent process, allocator slop, page-cache pressure, the in-shard gunbc
// compile). 0.80 = a 20% margin: it costs nothing while memory is non-binding (width capped by
// shard_count today) and is precisely the lean (DESIGN §5) that protects the one failure mode
// §1-C exists to prevent — OOM — in the future stale-low-peak case. Integer ×4/5 (no floats).
// Stays in the ByteSize domain (a fractioned budget is still a budget): scale the underlying Nat
// magnitude and re-ground via byte_size() — the dimension stays attached at the public seam.
// The lifted std.measure op scales the magnitude WITHIN the carrier, so the dimension never
// detaches — no unwrap→raw-arith→rewrap round-trip (expressibility-frontier §3 ①). 4/5 is the
// §3 ② *capacity* rounding case → floor.
fn budget_safety_fraction_apply(budget: ByteSize) -> ByteSize {
  measure_scale_fraction_floor(m: budget, num: 4, den: 5)
}

// How many concurrent shards fit under the safety-fractioned budget, each peaking at the MEASURED
// per-shard RSS. This is the §3 ① "how many fit" op (`Measure ÷ Measure → count`): the dimensionless
// shard count is a `Nat`, budget and peak stay `ByteSize` — no manual unwrap, no ByteSize→Int
// projection. Fail-closed forward progress: a non-positive peak (unknown measurement → fit op floors
// to 0 on a zero divisor) or a budget under one shard still admits 1, never 0.
fn memory_bounded_shard_count(memory_budget: ByteSize, per_shard_peak: ByteSize) -> Int {
  let fits = measure_fit_count_floor(
    capacity: budget_safety_fraction_apply(budget: memory_budget),
    each: per_shard_peak
  )
  nat_max(a: fits, b: 1)
}

// Memory-aware spawn width: min(shard_count, hardware_threads, ⌊0.8·budget ÷ measured_peak⌋).
// Byte quantities are std.measure ByteSize (the canonical Memory carrier), not flat Int — the
// dimension stays attached through the lifted measure algebra; only the dimensionless shard counts
// surface as Int. A zero-magnitude budget means the host could NOT read a live budget — fall back
// to the caller's conservative committed width so a missing measurement never OOMs and is never
// fabricated here (DESIGN §5; the host supplies the fallback). This is a sentinel READ of the
// budget magnitude (not arithmetic), so a plain `byte_size_count` projection is correct — no
// round-trip. The heavy-resolve topology serialization stays the independent backstop either way.
fn memory_aware_spawn_width(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  memory_budget: ByteSize,
  per_shard_peak: ByteSize,
  conservative_fallback_width: Int
) -> HardwareThreadCount {
  let budget_bytes = byte_size_count(b: memory_budget)
  if budget_bytes == 0 {
    hardware_thread_count(count: conservative_fallback_width)
  } else {
    let cpu_width = hardware_thread_count_value(
      t: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
    )
    let mem_width = memory_bounded_shard_count(
      memory_budget: memory_budget,
      per_shard_peak: per_shard_peak
    )
    hardware_thread_count(count: int_min(a: cpu_width, b: mem_width))
  }
}

// ── co-run residual width (§1-C, concurrent realizations) ─────────────────────
// When a SECOND fan-out (e.g. the warm==cold cache-purity audit) runs CONCURRENTLY with the floor
// claim_executor on the SAME host, they SHARE the one cgroup budget. Sizing the second fan-out as
// if it owned the whole budget re-introduces the very OOM the memory term exists to prevent:
// floor_peak + audit_peak can exceed the cap even though each alone fits. So the concurrent realizer
// sizes against the RESIDUAL budget = 0.8·total − the floor's MEASURED concurrent peak (reserve the
// FULL floor peak — it really will use that RAM — from the already-safety-fractioned budget). This
// is the floor-concurrent term made structural: the co-runner can never claim RAM the floor holds.
fn co_run_safe_residual_budget(memory_budget: ByteSize, floor_concurrent_peak: ByteSize) -> ByteSize {
  let safe = byte_size_count_int(b: budget_safety_fraction_apply(budget: memory_budget))
  let reserved = byte_size_count_int(b: floor_concurrent_peak)
  let residual = safe - reserved
  if residual <= 0 { byte_size(0) } else { byte_size(count: residual) }
}

// Width for a fan-out co-running with the floor: min(shard_count, threads, ⌊residual ÷ peak⌋) where
// residual already reserves the concurrent floor peak. Distinct from memory_aware_spawn_width in its
// FAIL-CLOSED floor: where the standalone floor always admits ≥1 (it owns the host, forward progress
// beats OOM), a co-runner that does NOT fit beside the floor must NOT silently run width-1 and bust
// the shared cap — it returns width 0, the typed "cannot co-run safely" signal the host realizer
// fails closed on (escalate, never OOM). A 0-byte (unreadable) budget → the conservative fallback,
// same as the standalone fold.
fn co_run_residual_spawn_width(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  memory_budget: ByteSize,
  floor_concurrent_peak: ByteSize,
  audit_per_shard_peak: ByteSize,
  conservative_fallback_width: Int
) -> HardwareThreadCount {
  let budget_bytes = byte_size_count_int(b: memory_budget)
  if budget_bytes <= 0 {
    hardware_thread_count(count: conservative_fallback_width)
  } else {
    let cpu_width = hardware_thread_count_value(
      t: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
    )
    let peak = byte_size_count_int(b: audit_per_shard_peak)
    if peak <= 0 {
      hardware_thread_count(count: 0)
    } else {
      let residual = byte_size_count_int(
        b: co_run_safe_residual_budget(memory_budget: memory_budget, floor_concurrent_peak: floor_concurrent_peak)
      )
      let mem_fits = residual / peak
      if mem_fits < 1 {
        hardware_thread_count(count: 0)
      } else {
        hardware_thread_count(count: int_min(a: cpu_width, b: mem_fits))
      }
    }
  }
}

fn co_run_residual_width_value(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  memory_budget: ByteSize,
  floor_concurrent_peak: ByteSize,
  audit_per_shard_peak: ByteSize,
  conservative_fallback_width: Int
) -> Int {
  hardware_thread_count_value(
    t: co_run_residual_spawn_width(
      shard_count: shard_count,
      hardware_threads: hardware_threads,
      memory_budget: memory_budget,
      floor_concurrent_peak: floor_concurrent_peak,
      audit_per_shard_peak: audit_per_shard_peak,
      conservative_fallback_width: conservative_fallback_width
    )
  )
}

// Pareto goals for width trade-off (wall-time ↓, peak-memory ↓) — reuse std.pareto vocabulary.
fn width_fold_objective_goals() -> List<AxisGoal> {
  [LowerIsBetter, LowerIsBetter]
}

type WidthBoundedRealization<S> {
  plan: RealizationPlan<S>
  spawn_width: HardwareThreadCount
}

// Width is peripheral: the schedule topology is unchanged (§3 invariant).
fn width_bounded_realization<S>(
  plan: RealizationPlan<S>,
  shard_count: Int,
  hardware_threads: HardwareThreadCount
) -> WidthBoundedRealization<S> {
  WidthBoundedRealization {
    plan: plan
    spawn_width: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
  }
}

fn witness_width_fold_preserves_schedule_topology<S>(
  plan: RealizationPlan<S>,
  shard_count: Int,
  hardware_threads: HardwareThreadCount
) -> Bool {
  let bounded = width_bounded_realization(
    plan: plan,
    shard_count: shard_count,
    hardware_threads: hardware_threads
  )
  schedule_eq(left: plan.schedule, right: bounded.plan.schedule)
}

// Discriminating lens: width must equal min(shard_count, cores), not the uncapped demand.
fn witness_spawn_width_capped_by_hardware(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  expected: Int
) -> Bool {
  hardware_thread_count_value(
    t: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
  ) == expected
}

// RED guard (a): a budget-ignoring fold that returns uncapped shard_count goes red here.
fn witness_budget_ignoring_fold_fails(
  shard_count: Int,
  hardware_threads: HardwareThreadCount
) -> Bool {
  hardware_thread_count_value(
    t: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
  ) != shard_count
}

// Measured shard-balance scaffold: assignment must read CostAccount.basis=Measured.
fn shard_balance_slot_for_cost(cost: CostAccount<Nano>, baseline: CostAccount<Nano>) -> Int {
  match cost.basis {
    Measured => cost_account_time_count(account: cost)
    Predicted => cost_account_time_count(account: baseline)
  }
}

// RED guard (b): asymmetric measured costs must yield different slot assignments.
fn witness_measured_cost_affects_shard_balance() -> Bool {
  let high = cost_account_measured(time: nano_time(count: 100))
  let low = cost_account_measured(time: nano_time(count: 10))
  let baseline = nano_predicted_zero()
  let left = shard_balance_slot_for_cost(cost: high, baseline: baseline)
  let right = shard_balance_slot_for_cost(cost: low, baseline: baseline)
  left != right
}

// ── §1-C memory-aware width witnesses ────────────────────────────────────────
// Helper: derived width value given the four inputs (shard/threads/budget/peak) + fallback.
fn memory_aware_width_value(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  memory_budget: ByteSize,
  per_shard_peak: ByteSize,
  conservative_fallback_width: Int
) -> Int {
  hardware_thread_count_value(
    t: memory_aware_spawn_width(
      shard_count: shard_count,
      hardware_threads: hardware_threads,
      memory_budget: memory_budget,
      per_shard_peak: per_shard_peak,
      conservative_fallback_width: conservative_fallback_width
    )
  )
}

// Non-binding case: budget admits far more than shard_count, so width = shard_count (the
// 4→7 reality — 0.8×62.5GiB ÷ 2.1GB ≈ 23 ≫ 7, so memory does not bind).
fn witness_memory_term_non_binding_uses_shard_count(
  shard_count: Int,
  hardware_threads: HardwareThreadCount
) -> Bool {
  memory_aware_width_value(
    shard_count: shard_count,
    hardware_threads: hardware_threads,
    memory_budget: byte_size(67108864000),
    per_shard_peak: byte_size(2100028416),
    conservative_fallback_width: 4
  ) == shard_count
}

// Binding case: a tight budget backs width BELOW the topology cap — the fail-closed floor.
// budget 6 GiB × 0.8 = 4.8 GiB ÷ 2.1 GB = 2 shards < shard_count 7 → width 2.
fn witness_tight_budget_backs_off_below_shard_count() -> Bool {
  memory_aware_width_value(
    shard_count: 7,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(6442450944),
    per_shard_peak: byte_size(2100028416),
    conservative_fallback_width: 4
  ) == 2
}

// Fail-closed: an unreadable budget (0-byte sentinel from the host) → the conservative fallback,
// never an unbounded width and never an OOM. RED if a memory-blind fold ignored the sentinel.
fn witness_unreadable_budget_falls_back_conservative() -> Bool {
  memory_aware_width_value(
    shard_count: 7,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(0),
    per_shard_peak: byte_size(2100028416),
    conservative_fallback_width: 4
  ) == 4
}

// Fraction is load-bearing: 0.8×budget changes the bound. budget exactly 2×peak admits 2 raw
// but 0.8×(2×peak)=1.6×peak admits only 1 — the safety margin demoted it. RED without ×4/5.
fn witness_safety_fraction_is_load_bearing() -> Bool {
  let peak = 2100028416
  memory_aware_width_value(
    shard_count: 7,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(peak * 2),
    per_shard_peak: byte_size(peak),
    conservative_fallback_width: 4
  ) == 1
}

// Fail-closed forward progress: a budget under one shard still admits width 1 (never 0).
fn witness_subunit_budget_admits_one() -> Bool {
  memory_aware_width_value(
    shard_count: 7,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(1000000000),
    per_shard_peak: byte_size(2100028416),
    conservative_fallback_width: 4
  ) == 1
}

// ── co-run residual width witnesses (TOOTH 2: reserve the floor's concurrent peak) ──
fn co_run_width_value(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  memory_budget: ByteSize,
  floor_concurrent_peak: ByteSize,
  audit_per_shard_peak: ByteSize,
  conservative_fallback_width: Int
) -> Int {
  co_run_residual_width_value(
    shard_count: shard_count,
    hardware_threads: hardware_threads,
    memory_budget: memory_budget,
    floor_concurrent_peak: floor_concurrent_peak,
    audit_per_shard_peak: audit_per_shard_peak,
    conservative_fallback_width: conservative_fallback_width
  )
}

// The reservation BINDS: at a budget where the audit alone would admit the full shard_count (8),
// reserving the concurrent floor peak (8.4 GB) backs it below that cap. RED if the floor term were
// ignored — the co-run width would then equal the standalone (no-reservation) width.
// total 60 GB: 0.8×60=48 GB. standalone ⌊48 ÷ 5.55⌋=8 (=shard_count). residual 48−8.4=39.6 GB,
// ⌊39.6 ÷ 5.55⌋=7 < 8. So co-run=7, standalone=8 → strictly less ⟺ reservation took effect.
fn witness_co_run_reservation_binds() -> Bool {
  let co_run = co_run_width_value(
    shard_count: 8,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(60000000000),
    floor_concurrent_peak: byte_size(8400113664),
    audit_per_shard_peak: byte_size(5550000000),
    conservative_fallback_width: 4
  )
  let standalone = memory_aware_width_value(
    shard_count: 8,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(60000000000),
    per_shard_peak: byte_size(5550000000),
    conservative_fallback_width: 4
  )
  co_run == 7 && standalone == 8 && co_run < standalone
}

// FAIL-CLOSED over-budget: when 0.8×total − floor_peak admits less than ONE audit shard, the
// co-runner returns width 0 — the typed "cannot co-run safely" signal (NOT a silent width-1 that
// would bust the shared cap and OOM). total 12 GB: 0.8×12=9.6 GB; residual 9.6−8.4=1.2 GB <
// 5.55 GB peak → 0. RED if it floored to 1 like the standalone fold.
fn witness_co_run_over_budget_fails_closed() -> Bool {
  co_run_width_value(
    shard_count: 8,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(12000000000),
    floor_concurrent_peak: byte_size(8400113664),
    audit_per_shard_peak: byte_size(5550000000),
    conservative_fallback_width: 4
  ) == 0
}

// Healthy real-fleet host: residual ≫ shard_count·peak so memory is non-binding and width = the
// topology cap (shard_count). 128 GB: 0.8×128=102.4 GB; residual 102.4−8.4=94 GB; ⌊94 ÷ 5.55⌋≈16 ≫ 4.
fn witness_co_run_healthy_host_caps_at_shard_count() -> Bool {
  co_run_width_value(
    shard_count: 4,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(128000000000),
    floor_concurrent_peak: byte_size(8400113664),
    audit_per_shard_peak: byte_size(5550000000),
    conservative_fallback_width: 4
  ) == 4
}

// Unreadable budget (0-byte host sentinel) → conservative committed fallback, never an OOM.
fn witness_co_run_unreadable_budget_falls_back() -> Bool {
  co_run_width_value(
    shard_count: 4,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(0),
    floor_concurrent_peak: byte_size(8400113664),
    audit_per_shard_peak: byte_size(5550000000),
    conservative_fallback_width: 4
  ) == 4
}
