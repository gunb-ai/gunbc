module std.realization_width

import std.types { Int, List }
import std.nat { Nat, nat_max }
import std.measure {
  HardwareThreadCount,
  ByteSize,
  Measure,
  Time,
  Nano,
  byte_size,
  byte_size_count,
  measure_scale_fraction_floor,
  measure_fit_count_floor,
  hardware_thread_count,
  hardware_thread_count_value,
  time_measure,
}
import std.pareto { AxisGoal, LowerIsBetter }
import std.realization_schedule {
  Schedule,
  RealizationPlan,
  RealizationObjective,
  CostAccount,
  CostBasis,
  schedule_eq,
  cost_account_measured,
  cost_account_predicted_zero,
  cost_account_time_count,
}

fn int_min(a: Int, b: Int) -> Int {
  if a < b { a } else { b }
}

fn nano_time(count: Nat) -> Measure<Time, Nano, Nat> {
  time_measure(count: count)
}

fn nano_predicted_zero() -> CostAccount<Nano> {
  cost_account_predicted_zero()
}

fn shard_count_positive(shard_count: Int) -> Int {
  if shard_count <= 0 { 1 } else { shard_count }
}

fn bounded_host_spawn_width(shard_count: Int, hardware_threads: HardwareThreadCount) -> HardwareThreadCount {
  let demand = shard_count_positive(shard_count: shard_count)
  let cores = hardware_thread_count_value(t: hardware_threads)
  let width = int_min(a: demand, b: cores)
  hardware_thread_count(count: width)
}

fn budget_safety_fraction_apply(budget: ByteSize) -> ByteSize {
  measure_scale_fraction_floor(m: budget, num: 4, den: 5)
}

fn memory_bounded_shard_count(memory_budget: ByteSize, per_shard_peak: ByteSize) -> Int {
  let fits = measure_fit_count_floor(
    capacity: budget_safety_fraction_apply(budget: memory_budget),
    each: per_shard_peak
  )
  nat_max(a: fits, b: 1)
}

fn memory_aware_spawn_width(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  memory_budget: ByteSize,
  per_shard_peak: ByteSize,
  conservative_fallback_width: Int
) -> HardwareThreadCount {
  let budget_bytes = byte_size_count(b: memory_budget)
  if budget_bytes == 0 {
    hardware_thread_count(count: conservative_fallback_width)
  } else {
    let cpu_width = hardware_thread_count_value(
      t: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
    )
    let mem_width = memory_bounded_shard_count(
      memory_budget: memory_budget,
      per_shard_peak: per_shard_peak
    )
    hardware_thread_count(count: int_min(a: cpu_width, b: mem_width))
  }
}

fn width_fold_objective_goals() -> List<AxisGoal> {
  [LowerIsBetter, LowerIsBetter]
}

type WidthBoundedRealization<S> {
  plan: RealizationPlan<S>
  spawn_width: HardwareThreadCount
}

fn width_bounded_realization<S>(
  plan: RealizationPlan<S>,
  shard_count: Int,
  hardware_threads: HardwareThreadCount
) -> WidthBoundedRealization<S> {
  WidthBoundedRealization {
    plan: plan
    spawn_width: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
  }
}

fn witness_width_fold_preserves_schedule_topology<S>(
  plan: RealizationPlan<S>,
  shard_count: Int,
  hardware_threads: HardwareThreadCount
) -> Bool {
  let bounded = width_bounded_realization(
    plan: plan,
    shard_count: shard_count,
    hardware_threads: hardware_threads
  )
  schedule_eq(left: plan.schedule, right: bounded.plan.schedule)
}

fn witness_spawn_width_capped_by_hardware(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  expected: Int
) -> Bool {
  hardware_thread_count_value(
    t: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
  ) == expected
}

fn witness_budget_ignoring_fold_fails(
  shard_count: Int,
  hardware_threads: HardwareThreadCount
) -> Bool {
  hardware_thread_count_value(
    t: bounded_host_spawn_width(shard_count: shard_count, hardware_threads: hardware_threads)
  ) != shard_count
}

fn shard_balance_slot_for_cost(cost: CostAccount<Nano>, baseline: CostAccount<Nano>) -> Int {
  match cost.basis {
    Measured => cost_account_time_count(account: cost)
    Predicted => cost_account_time_count(account: baseline)
  }
}

fn witness_measured_cost_affects_shard_balance() -> Bool {
  let high = cost_account_measured(time: nano_time(count: 100))
  let low = cost_account_measured(time: nano_time(count: 10))
  let baseline = nano_predicted_zero()
  let left = shard_balance_slot_for_cost(cost: high, baseline: baseline)
  let right = shard_balance_slot_for_cost(cost: low, baseline: baseline)
  left != right
}

fn memory_aware_width_value(
  shard_count: Int,
  hardware_threads: HardwareThreadCount,
  memory_budget: ByteSize,
  per_shard_peak: ByteSize,
  conservative_fallback_width: Int
) -> Int {
  hardware_thread_count_value(
    t: memory_aware_spawn_width(
      shard_count: shard_count,
      hardware_threads: hardware_threads,
      memory_budget: memory_budget,
      per_shard_peak: per_shard_peak,
      conservative_fallback_width: conservative_fallback_width
    )
  )
}

fn witness_memory_term_non_binding_uses_shard_count(
  shard_count: Int,
  hardware_threads: HardwareThreadCount
) -> Bool {
  memory_aware_width_value(
    shard_count: shard_count,
    hardware_threads: hardware_threads,
    memory_budget: byte_size(67108864000),
    per_shard_peak: byte_size(2100028416),
    conservative_fallback_width: 4
  ) == shard_count
}

fn witness_tight_budget_backs_off_below_shard_count() -> Bool {
  memory_aware_width_value(
    shard_count: 7,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(6442450944),
    per_shard_peak: byte_size(2100028416),
    conservative_fallback_width: 4
  ) == 2
}

fn witness_unreadable_budget_falls_back_conservative() -> Bool {
  memory_aware_width_value(
    shard_count: 7,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(0),
    per_shard_peak: byte_size(2100028416),
    conservative_fallback_width: 4
  ) == 4
}

fn witness_safety_fraction_is_load_bearing() -> Bool {
  let peak = 2100028416
  memory_aware_width_value(
    shard_count: 7,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(peak * 2),
    per_shard_peak: byte_size(peak),
    conservative_fallback_width: 4
  ) == 1
}

fn witness_subunit_budget_admits_one() -> Bool {
  memory_aware_width_value(
    shard_count: 7,
    hardware_threads: hardware_thread_count(128),
    memory_budget: byte_size(1000000000),
    per_shard_peak: byte_size(2100028416),
    conservative_fallback_width: 4
  ) == 1
}
