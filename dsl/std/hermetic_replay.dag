// std/hermetic_replay.dag -- Phase-2 hermetic replay vocabulary (RecordedFixture seam).
//
// Anchor: DESIGN.md §3 (single payload authority) / §6 (model-before-implement).
//
// A mock is NOT a hand-rolled stub: hermetic execution replays wet-captured
// RecordedFixture rows keyed by (operation_key, content_hash(inputs)).
// Published mock corpora carry structural keys ONLY — never response payloads.

module std.hermetic_replay

// Structural key for a published mock case. Both filesystem and REST layers
// inhabit this row shape (operation_key matches RecordedFixture.operation).
type PublishedMockCase {
  operation_key: String
  case_id: Int
}

// M0 substrate-target authority for per-op hermetic realization (dissolution axis).
// Production gate eval_service_call (v1_interpreter.rs) decides independently today
// and does NOT yet fold this coproduct.
// 🟡 gated — feature:m4-eval-service-call-folds-hermetic-realization — dissolve-on-arrival:
// M4 migrates eval_service_call to fold HermeticRealization.
type HermeticRealization
  = RecordedFixtureReplay
  | InlineMockScaffold
