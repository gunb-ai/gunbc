// std/runtime/local_dev.dag -- local developer execution-runtime facts.

module std.runtime.local_dev

import std.types { NonEmptyStr }

type LocalDevRuntime {
  adc_env_var: NonEmptyStr
  fallback_auth_command: NonEmptyStr
}

data local_dev_runtime: LocalDevRuntime = {
  adc_env_var: "GOOGLE_APPLICATION_CREDENTIALS"
  fallback_auth_command: "gcloud auth print-access-token"
}
