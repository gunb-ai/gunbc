// std/workflow_recursive.dag — recursive Workflow fold (catamorphism + located latch).
//
// Pure std layer: imports only std.reducible + std.types. Application witnesses
// and spine subsumption proofs live in dsl/test/claim/.
//
// Workflow = Leaf | Decomposed is the recursive carrier. settle_workflow recurses
// depth-first; sibling verdicts fold via reduce_verdicts_located (Semigroup over
// List = FreeMonoid<ReduceVerdict>). CONSUME-BY-CORRESPONDENCE of
// compute_fabric.PartitionedReduce — no compute_fabric import (dissolution trigger).

module std.workflow_recursive

import std.types { List }
import std.reducible { ReduceVerdict, reduce_verdicts_located }

type Workflow
  = Leaf { verdict: ReduceVerdict }
  | Decomposed { children: List<Workflow> }

fn settle_workflow(w: Workflow) -> ReduceVerdict {
  match w {
    Leaf { verdict: v } => v
    Decomposed { children: cs } => settle_children(cs)
  }
}

fn settle_children(cs: List<Workflow>) -> ReduceVerdict {
  reduce_verdicts_located(
    verdicts: map(
      collection: cs,
      f: fn(w) { settle_workflow(w: w) }
    ),
    empty_missing: "workflow:empty-decomposition"
  )
}

fn linearize_verdicts(verdicts: List<ReduceVerdict>) -> Workflow {
  Decomposed {
    children: map(
      collection: verdicts,
      f: fn(v) { Leaf { verdict: v } }
    )
  }
}
