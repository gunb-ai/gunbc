module std.realization_schedule

import std.types { ContentHash, Bool, String, List, Int }
import std.nat { Nat }
import std.measure {
  Measure, Time, ByteSize, Watt,
  byte_size, byte_size_count, watt, time_measure, measure_count
}
import std.pareto { AxisGoal }
import std.lens_verdict {
  LensVerdict,
  LensVerdictDiagnostic,
  Holds,
  Violation,
  ModuleWholeFile,
}

type CostBasis
  = Predicted
  | Measured

type CostAccount<S> {
  time: Measure<Time, S, Nat>
  space: ByteSize
  power: Watt
  basis: CostBasis
}

fn cost_account_predicted_zero<S>() -> CostAccount<S> {
  CostAccount {
    time: time_measure(count: 0)
    space: byte_size(count: 0)
    power: watt(count: 0)
    basis: Predicted
  }
}

fn cost_account_measured<S>(time: Measure<Time, S, Nat>) -> CostAccount<S> {
  CostAccount {
    time: time
    space: byte_size(count: 0)
    power: watt(count: 0)
    basis: Measured
  }
}

fn cost_account_time_count<S>(account: CostAccount<S>) -> Nat {
  measure_count(m: account.time)
}

type RealizationObjective {
  goals: List<AxisGoal>
}

type ScheduleWitnessEntry {
  entry: String
  function: String
}

type RunnableMemoryPeak {
  predicted_peak: ByteSize
}

type RunnableMemoryClass
  = RunnableMemoryNegligible
  | RunnableMemorySubstantial { peak: RunnableMemoryPeak }

type RunnableResourceProfile {
  heavy_whole_tree_resolve: Bool
  spawns_host_compiler: Bool
  memory: RunnableMemoryClass
}

fn runnable_memory_negligible() -> RunnableMemoryClass {
  RunnableMemoryNegligible
}

fn runnable_memory_substantial(predicted_peak: ByteSize) -> RunnableMemoryClass {
  RunnableMemorySubstantial {
    peak: RunnableMemoryPeak { predicted_peak: predicted_peak }
  }
}

fn runnable_memory_class_eq(left: RunnableMemoryClass, right: RunnableMemoryClass) -> Bool {
  match left {
    RunnableMemoryNegligible => match right {
      RunnableMemoryNegligible => true
      RunnableMemorySubstantial { peak: _ } => false
    }
    RunnableMemorySubstantial { peak: lp } => match right {
      RunnableMemoryNegligible => false
      RunnableMemorySubstantial { peak: rp } =>
        byte_size_count(b: lp.predicted_peak) == byte_size_count(b: rp.predicted_peak)
    }
  }
}

fn runnable_memory_substantial_sum(left: RunnableMemoryClass, right: RunnableMemoryClass) -> RunnableMemoryClass {
  let left_count = match left {
    RunnableMemoryNegligible => 0
    RunnableMemorySubstantial { peak: p } => byte_size_count(b: p.predicted_peak)
  }
  let right_count = match right {
    RunnableMemoryNegligible => 0
    RunnableMemorySubstantial { peak: p } => byte_size_count(b: p.predicted_peak)
  }
  runnable_memory_substantial(predicted_peak: byte_size(count: left_count + right_count))
}

fn runnable_resource_profile_eq(left: RunnableResourceProfile, right: RunnableResourceProfile) -> Bool {
  (left.heavy_whole_tree_resolve == right.heavy_whole_tree_resolve)
    && (left.spawns_host_compiler == right.spawns_host_compiler)
    && runnable_memory_class_eq(left: left.memory, right: right.memory)
}

fn runnable_resource_profile_negligible() -> RunnableResourceProfile {
  RunnableResourceProfile {
    heavy_whole_tree_resolve: false
    spawns_host_compiler: false
    memory: runnable_memory_negligible()
  }
}

fn runnable_resource_profile(
  heavy_whole_tree_resolve: Bool,
  spawns_host_compiler: Bool,
  memory: RunnableMemoryClass
) -> RunnableResourceProfile {
  RunnableResourceProfile {
    heavy_whole_tree_resolve: heavy_whole_tree_resolve
    spawns_host_compiler: spawns_host_compiler
    memory: memory
  }
}

fn runnable_excludes_corpus_co_residence(profile: RunnableResourceProfile) -> Bool {
  match profile.memory {
    RunnableMemoryNegligible => false
    RunnableMemorySubstantial { peak: _ } => true
  }
}

fn runnable_heavy_whole_tree_resolve(profile: RunnableResourceProfile) -> Bool {
  profile.heavy_whole_tree_resolve
}

fn runnable_predicted_space(profile: RunnableResourceProfile) -> ByteSize {
  match profile.memory {
    RunnableMemoryNegligible => byte_size(count: 0)
    RunnableMemorySubstantial { peak: p } => p.predicted_peak
  }
}

fn runnable_profile(r: Runnable) -> RunnableResourceProfile {
  match r {
    RunnableSingleClaim { entry: _, function: _, profile: p } => p
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: p } => p
    RunnableCompileCleanShardBatch { entry_paths: _, spawn_width_cap: _, profile: p } => p
    RunnableKernelWorkload { fused_op_count: _ } => runnable_resource_profile_negligible()
  }
}

fn runnable_forbids_corpus_co_residence(r: Runnable) -> Bool {
  match r {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: _ } => false
    RunnableCompileCleanShardBatch { entry_paths: _, spawn_width_cap: _, profile: p } => runnable_excludes_corpus_co_residence(profile: p)
    RunnableSingleClaim { entry: _, function: _, profile: p } => runnable_excludes_corpus_co_residence(profile: p)
    RunnableKernelWorkload { fused_op_count: _ } => false
  }
}

type Runnable
  = RunnableSingleClaim { entry: String, function: String, profile: RunnableResourceProfile }
  | RunnableDiscoveryBatch {
      source_roots: List<String>
      scan_dirs: List<String>
      explicit_entries: List<ScheduleWitnessEntry>
      skip_unaffected_node_frontier: Bool
      exclude_substrings: List<String>
      discovery_scope_dirs: List<String>
      spawn_width_cap: Int
      profile: RunnableResourceProfile
    }
  | RunnableCompileCleanShardBatch {
      entry_paths: List<String>
      spawn_width_cap: Int
      profile: RunnableResourceProfile
    }
  | RunnableKernelWorkload { fused_op_count: Int }

data compile_clean_shard_batch_label: String = "__compile_clean_shard_batch__"

data runnable_kernel_workload_dissolution_trigger: String = "dissolve-on: execution lane attaches extdeps.languages kernel_surface rows to RunnableKernelWorkload when fused_op_count alone is insufficient; op_count is structural on substrate (not a string-label nickname)."

type Schedule = List<List<Runnable>>

type RealizationPlan<S> {
  target: ContentHash
  objective: RealizationObjective
  schedule: Schedule

  total: CostAccount<S>
}

fn runnable_step_label(r: Runnable) -> String {
  match r {
    RunnableSingleClaim { entry: _, function: f, profile: _ } => f
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: _ } => "__discovery_corpus__"
    RunnableCompileCleanShardBatch { entry_paths: _, spawn_width_cap: _, profile: _ } => compile_clean_shard_batch_label
    RunnableKernelWorkload { fused_op_count: _ } => "__kernel_workload__"
  }
}

fn runnable_compile_clean_shard_count(r: Runnable) -> Int {
  match r {
    RunnableCompileCleanShardBatch { entry_paths: paths, spawn_width_cap: _, profile: _ } => length(xs: paths)
    _ => 0
  }
}

fn schedule_batch_compile_clean_shard_count(batch: List<Runnable>) -> Int {
  fold(batch, init: 0, f: fn(acc, r) { acc + runnable_compile_clean_shard_count(r: r) })
}

fn schedule_batch_contains_label(batch: List<Runnable>, target: String) -> Bool {
  fold(batch, init: false, f: fn(acc, r) {
    acc || (runnable_step_label(r: r) == target)
  })
}

type ScheduleLensViolation
  = EmptySchedule
  | CompileGateNotFirst { expected: String }
  | CompileGateMonolithPresent { expected: String }
  | CompileCleanShardsInsufficient { minimum: Int }
  | CorpusBeforeCompile
  | SingleBatchOnly

data schedule_lens_module: String = "std.realization_schedule"

fn schedule_lens_violation_diagnostic(
  kind: ScheduleLensViolation,
  compile_gate_fn: String
) -> LensVerdictDiagnostic {
  let at = ModuleWholeFile { module_name: schedule_lens_module }
  match kind {
    EmptySchedule =>
      LensVerdictDiagnostic { reason: "schedule_lens_empty_schedule", at: at }
    CompileGateNotFirst { expected: expected } =>
      LensVerdictDiagnostic {
        reason: "schedule_lens_compile_gate_not_first:" + expected,
        at: at
      }
    CompileGateMonolithPresent { expected: expected } =>
      LensVerdictDiagnostic {
        reason: "schedule_lens_compile_gate_monolith_present:" + expected,
        at: at
      }
    CompileCleanShardsInsufficient { minimum: _ } =>
      LensVerdictDiagnostic {
        reason: "schedule_lens_compile_clean_shards_insufficient",
        at: at
      }
    CorpusBeforeCompile =>
      LensVerdictDiagnostic { reason: "schedule_lens_corpus_before_compile", at: at }
    SingleBatchOnly =>
      LensVerdictDiagnostic { reason: "schedule_lens_single_batch_only", at: at }
  }
}

fn schedule_lens_verdict_for_ci_floor<S>(plan: RealizationPlan<S>, compile_gate_fn: String, compile_clean_sharded: Bool) -> LensVerdict {
  if plan.schedule.count() == 0 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(
        kind: EmptySchedule,
        compile_gate_fn: compile_gate_fn
      )
    }
  } else if plan.schedule.count() < 2 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(
        kind: SingleBatchOnly,
        compile_gate_fn: compile_gate_fn
      )
    }
  } else if !compile_clean_sharded {
    let batch0 = plan.schedule.first()
    if batch0.count() != 1 {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CompileGateNotFirst { expected: compile_gate_fn },
          compile_gate_fn: compile_gate_fn
        )
      }
    } else if !schedule_batch_contains_label(batch: batch0, target: compile_gate_fn) {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CompileGateNotFirst { expected: compile_gate_fn },
          compile_gate_fn: compile_gate_fn
        )
      }
    } else if schedule_batch_contains_label(batch: batch0, target: "__discovery_corpus__") {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CorpusBeforeCompile,
          compile_gate_fn: compile_gate_fn
        )
      }
    } else {
      let batch1 = plan.schedule.skip(n: 1).first()
      if batch1.count() < 2 {
        Violation {
          diagnostic: schedule_lens_violation_diagnostic(
            kind: SingleBatchOnly,
            compile_gate_fn: compile_gate_fn
          )
        }
      } else {
        Holds
      }
    }
  } else {
    let batch0 = plan.schedule.first()
    let shard_count = schedule_batch_compile_clean_shard_count(batch: batch0)
    if schedule_batch_contains_label(batch: batch0, target: compile_gate_fn) {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CompileGateMonolithPresent { expected: compile_gate_fn },
          compile_gate_fn: compile_gate_fn
        )
      }
    } else if shard_count < 2 {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CompileCleanShardsInsufficient { minimum: 2 },
          compile_gate_fn: compile_gate_fn
        )
      }
    } else if schedule_batch_contains_label(batch: batch0, target: "__discovery_corpus__") {
      Violation {
        diagnostic: schedule_lens_violation_diagnostic(
          kind: CorpusBeforeCompile,
          compile_gate_fn: compile_gate_fn
        )
      }
    } else {
      let batch1 = plan.schedule.skip(n: 1).first()
      if batch1.count() < 2 {
        Violation {
          diagnostic: schedule_lens_violation_diagnostic(
            kind: SingleBatchOnly,
            compile_gate_fn: compile_gate_fn
          )
        }
      } else {
        Holds
      }
    }
  }
}

fn schedule_generates_same_batch_count<S>(left: RealizationPlan<S>, right: RealizationPlan<S>) -> Bool {
  left.schedule.count() == right.schedule.count()
}

fn schedule_witness_entry_eq(a: ScheduleWitnessEntry, b: ScheduleWitnessEntry) -> Bool {
  (a.entry == b.entry) && (a.function == b.function)
}

fn string_list_eq(left: List<String>, right: List<String>) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else if left.first() != right.first() {
    false
  } else {
    string_list_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn schedule_witness_entry_list_eq(left: List<ScheduleWitnessEntry>, right: List<ScheduleWitnessEntry>) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else if !schedule_witness_entry_eq(a: left.first(), b: right.first()) {
    false
  } else {
    schedule_witness_entry_list_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn runnable_eq(left: Runnable, right: Runnable) -> Bool {
  match left {
    RunnableSingleClaim { entry: le, function: lf, profile: lp } => match right {
      RunnableSingleClaim { entry: re, function: rf, profile: rp } =>
        (le == re) && (lf == rf) && runnable_resource_profile_eq(left: lp, right: rp)
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: _ } => false
      RunnableCompileCleanShardBatch { entry_paths: _, spawn_width_cap: _, profile: _ } => false
      RunnableKernelWorkload { fused_op_count: _ } => false
    }
    RunnableDiscoveryBatch { source_roots: lsr, scan_dirs: lsd, explicit_entries: lex, skip_unaffected_node_frontier: lskip, exclude_substrings: lex2, discovery_scope_dirs: lsc, spawn_width_cap: lwc, profile: lp } => match right {
      RunnableSingleClaim { entry: _, function: _, profile: _ } => false
      RunnableDiscoveryBatch { source_roots: rsr, scan_dirs: rsd, explicit_entries: rex, skip_unaffected_node_frontier: rskip, exclude_substrings: rex2, discovery_scope_dirs: rsc, spawn_width_cap: rwc, profile: rp } =>
        string_list_eq(left: lsr, right: rsr)
          && string_list_eq(left: lsd, right: rsd)
          && schedule_witness_entry_list_eq(left: lex, right: rex)
          && (lskip == rskip)
          && string_list_eq(left: lex2, right: rex2)
          && string_list_eq(left: lsc, right: rsc)
          && (lwc == rwc)
          && runnable_resource_profile_eq(left: lp, right: rp)
      RunnableCompileCleanShardBatch { entry_paths: _, spawn_width_cap: _, profile: _ } => false
      RunnableKernelWorkload { fused_op_count: _ } => false
    }
    RunnableCompileCleanShardBatch { entry_paths: lpaths, spawn_width_cap: lwc, profile: lp } => match right {
      RunnableSingleClaim { entry: _, function: _, profile: _ } => false
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: _ } => false
      RunnableCompileCleanShardBatch { entry_paths: rpaths, spawn_width_cap: rwc, profile: rp } =>
        string_list_eq(left: lpaths, right: rpaths)
          && (lwc == rwc)
          && runnable_resource_profile_eq(left: lp, right: rp)
      RunnableKernelWorkload { fused_op_count: _ } => false
    }
    RunnableKernelWorkload { fused_op_count: lleft } => match right {
      RunnableSingleClaim { entry: _, function: _, profile: _ } => false
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _, exclude_substrings: _, discovery_scope_dirs: _, spawn_width_cap: _, profile: _ } => false
      RunnableCompileCleanShardBatch { entry_paths: _, spawn_width_cap: _, profile: _ } => false
      RunnableKernelWorkload { fused_op_count: rcount } => lleft == rcount
    }
  }
}

fn runnable_batch_eq(left: List<Runnable>, right: List<Runnable>) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else if !runnable_eq(left: left.first(), right: right.first()) {
    false
  } else {
    runnable_batch_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn schedule_eq(left: Schedule, right: Schedule) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else if !runnable_batch_eq(left: left.first(), right: right.first()) {
    false
  } else {
    schedule_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn schedule_generates_identical_schedule<S>(plan: RealizationPlan<S>, schedule: Schedule) -> Bool {
  schedule_eq(left: plan.schedule, right: schedule)
}
