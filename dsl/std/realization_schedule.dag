// std/realization_schedule.dag — Schedule arm of std.realization (dsl-tree authority).
//
// Lives in the dsl tree so schedule-lens witnesses execute without pulling the v2
// resolution closure. Live ci_floor_plan generative wiring is proven in
// v2/test/claim/realization_schedule_witness.dag (dissolution: enroll when v2
// self-compile-clean closes the Empty-in-generic sequence_outcome substrate gap).
//
// Algebra probe (Route C): FreeMonoid record-field ops wholesale-repointed to
// v2.std.algebra substrate fns — one-consumer floor proof for dsl→v2 std de-fork.

module std.realization_schedule

import std.types { ContentHash, Bool, String, List, Int }
import std.nat { Nat }
import std.measure {
  Measure, Time, ByteSize, Watt,
  byte_size, watt, time_measure, measure_count
}
import std.pareto { AxisGoal }
import std.lens_verdict {
  LensVerdict,
  LensVerdictDiagnostic,
  Holds,
  Violation,
  ModuleWholeFile,
}
import v2.std.algebra {
  HeadAbsent,
  HeadFound,
  fold_list,
  length,
  list_head,
  skip,
  zip_eq,
}

// dissolve-on: extdeps/realization measured cost handlers — peripheral host realizers
//   aggregate PerformanceReceipt rows into cost_account_measured_* at the floor boundary.
type CostBasis
  = Predicted
  | Measured

// Scale-AGNOSTIC cost ledger: `time` is a `Time` magnitude at ANY scale `<S>` (DESIGN §3
// — the framework names no scale; a consumer pins `<S>`, e.g. `CostAccount<Nano>` for
// measured wall-clock, at its own boundary). `space`/`power` keep their own dimensional
// scales (`Memory@One` / `Power@One`); only the time axis is the relocated scale choice.
type CostAccount<S> {
  time: Measure<Time, S, Nat>
  space: ByteSize
  power: Watt
  basis: CostBasis
}

fn cost_account_predicted_zero<S>() -> CostAccount<S> {
  CostAccount {
    time: time_measure(count: 0)
    space: byte_size(count: 0)
    power: watt(count: 0)
    basis: Predicted
  }
}

fn cost_account_measured<S>(time: Measure<Time, S, Nat>) -> CostAccount<S> {
  CostAccount {
    time: time
    space: byte_size(count: 0)
    power: watt(count: 0)
    basis: Measured
  }
}

// Magnitude projection at the ledger's declared scale (count, not scale-named "nanos").
fn cost_account_time_count<S>(account: CostAccount<S>) -> Nat {
  measure_count(m: account.time)
}

type RealizationObjective {
  goals: List<AxisGoal>
}

type ScheduleWitnessEntry {
  entry: String
  function: String
}

type Runnable
  = RunnableSingleClaim { entry: String, function: String }
  | RunnableDiscoveryBatch {
      source_roots: List<String>
      scan_dirs: List<String>
      explicit_entries: List<ScheduleWitnessEntry>
      skip_unaffected_node_frontier: Bool
    }

type Schedule = List<List<Runnable>>

type RealizationPlan<S> {
  target: ContentHash
  objective: RealizationObjective
  schedule: Schedule
  // Measured roll-up along schedule critical path (seq across batches, max within batch);
  // authority v1.compiler.complexity span / cost_seq / cost_par — see
  // std.realization_measurement.schedule_critical_path_time. `<S>` is the consumer-pinned
  // time scale of the ledger (e.g. `RealizationPlan<Nano>`); the plan itself is agnostic.
  total: CostAccount<S>
}

fn runnable_step_label(r: Runnable) -> String {
  match r {
    RunnableSingleClaim { entry: _, function: f } => f
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _ } => "__discovery_corpus__"
  }
}

fn schedule_batch_contains_label(batch: List<Runnable>, target: String) -> Bool {
  fold_list(xs: batch, empty: false, cons: fn(acc, r) {
    acc || (runnable_step_label(r: r) == target)
  })
}

type ScheduleLensViolation
  = EmptySchedule
  | CompileGateNotFirst { expected: String }
  | CorpusBeforeCompile
  | SingleBatchOnly

data schedule_lens_module: String = "std.realization_schedule"

fn schedule_lens_violation_diagnostic(
  kind: ScheduleLensViolation,
  compile_gate_fn: String
) -> LensVerdictDiagnostic {
  let at = ModuleWholeFile { module_name: schedule_lens_module }
  match kind {
    EmptySchedule =>
      LensVerdictDiagnostic { reason: "schedule_lens_empty_schedule", at: at }
    CompileGateNotFirst { expected: expected } =>
      LensVerdictDiagnostic {
        reason: "schedule_lens_compile_gate_not_first:" + expected,
        at: at
      }
    CorpusBeforeCompile =>
      LensVerdictDiagnostic { reason: "schedule_lens_corpus_before_compile", at: at }
    SingleBatchOnly =>
      LensVerdictDiagnostic { reason: "schedule_lens_single_batch_only", at: at }
  }
}

fn schedule_lens_verdict_for_batch0<S>(
  batch0: List<Runnable>,
  plan: RealizationPlan<S>,
  compile_gate_fn: String
) -> LensVerdict {
  if length(xs: batch0) != 1 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(
        kind: CompileGateNotFirst { expected: compile_gate_fn },
        compile_gate_fn: compile_gate_fn
      )
    }
  } else if !schedule_batch_contains_label(batch: batch0, target: compile_gate_fn) {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(
        kind: CompileGateNotFirst { expected: compile_gate_fn },
        compile_gate_fn: compile_gate_fn
      )
    }
  } else if schedule_batch_contains_label(batch: batch0, target: "__discovery_corpus__") {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(
        kind: CorpusBeforeCompile,
        compile_gate_fn: compile_gate_fn
      )
    }
  } else {
    match list_head(xs: skip(xs: plan.schedule, n: 1)) {
      HeadAbsent =>
        Violation {
          diagnostic: schedule_lens_violation_diagnostic(
            kind: SingleBatchOnly,
            compile_gate_fn: compile_gate_fn
          )
        }
      HeadFound { value: batch1 } =>
        if length(xs: batch1) < 2 {
          Violation {
            diagnostic: schedule_lens_violation_diagnostic(
              kind: SingleBatchOnly,
              compile_gate_fn: compile_gate_fn
            )
          }
        } else {
          Holds
        }
    }
  }
}

fn schedule_lens_verdict_for_ci_floor<S>(plan: RealizationPlan<S>, compile_gate_fn: String) -> LensVerdict {
  if length(xs: plan.schedule) == 0 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(
        kind: EmptySchedule,
        compile_gate_fn: compile_gate_fn
      )
    }
  } else if length(xs: plan.schedule) < 2 {
    Violation {
      diagnostic: schedule_lens_violation_diagnostic(
        kind: SingleBatchOnly,
        compile_gate_fn: compile_gate_fn
      )
    }
  } else {
    match list_head(xs: plan.schedule) {
      HeadAbsent =>
        Violation {
          diagnostic: schedule_lens_violation_diagnostic(
            kind: EmptySchedule,
            compile_gate_fn: compile_gate_fn
          )
        }
      HeadFound { value: batch0 } =>
        schedule_lens_verdict_for_batch0(
          batch0: batch0,
          plan: plan,
          compile_gate_fn: compile_gate_fn
        )
    }
  }
}

fn schedule_generates_same_batch_count<S>(left: RealizationPlan<S>, right: RealizationPlan<S>) -> Bool {
  length(xs: left.schedule) == length(xs: right.schedule)
}

fn schedule_witness_entry_eq(a: ScheduleWitnessEntry, b: ScheduleWitnessEntry) -> Bool {
  (a.entry == b.entry) && (a.function == b.function)
}

fn string_list_eq(left: List<String>, right: List<String>) -> Bool {
  zip_eq(a: left, b: right, eq: fn(x, y) { x == y })
}

fn runnable_eq(left: Runnable, right: Runnable) -> Bool {
  match left {
    RunnableSingleClaim { entry: le, function: lf } => match right {
      RunnableSingleClaim { entry: re, function: rf } => (le == re) && (lf == rf)
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, skip_unaffected_node_frontier: _ } => false
    }
    RunnableDiscoveryBatch { source_roots: lsr, scan_dirs: lsd, explicit_entries: lex, skip_unaffected_node_frontier: lskip } => match right {
      RunnableSingleClaim { entry: _, function: _ } => false
      RunnableDiscoveryBatch { source_roots: rsr, scan_dirs: rsd, explicit_entries: rex, skip_unaffected_node_frontier: rskip } =>
        string_list_eq(left: lsr, right: rsr)
          && string_list_eq(left: lsd, right: rsd)
          && zip_eq(a: lex, b: rex, eq: fn(a, b) { schedule_witness_entry_eq(a: a, b: b) })
          && (lskip == rskip)
    }
  }
}

fn runnable_batch_eq(left: List<Runnable>, right: List<Runnable>) -> Bool {
  zip_eq(a: left, b: right, eq: fn(a, b) { runnable_eq(left: a, right: b) })
}

fn schedule_eq(left: Schedule, right: Schedule) -> Bool {
  zip_eq(a: left, b: right, eq: fn(a, b) { runnable_batch_eq(left: a, right: b) })
}

fn schedule_generates_identical_schedule<S>(plan: RealizationPlan<S>, schedule: Schedule) -> Bool {
  schedule_eq(left: plan.schedule, right: schedule)
}
