// std/lens_verdict.dag — tier-0 unified lens verdict carrier (dsl-tree authority).
//
// Single-authority (§3): lives in the dsl tree so schedule-lens and other dsl
// witnesses execute without pulling the v2 resolution closure. NOT
// `v2.std.verdict.Verdict<Subj,T>` (eval-claim Pass/Fail/Deferred). Per-lens
// bespoke verdicts dissolve by projecting here.
//
// Dissolve-on: `v2.std.diagnostic.Diagnostic` locus when v2 self-compile-clean
// closes the cross-tree import gap — then Violation/NotApplicable/Unrealized
// carry the full located diagnostic instead of the interim String carrier.

module std.lens_verdict

type LensVerdictLocus
  = ModuleWholeFile { module_name: String }

type LensVerdictDiagnostic {
  reason: String
  at: LensVerdictLocus
}

type LensVerdict
  = Holds
  | Violation { diagnostic: LensVerdictDiagnostic }
  | NotApplicable { diagnostic: LensVerdictDiagnostic }
  | Unrealized { diagnostic: LensVerdictDiagnostic }

fn lens_verdict_diagnostic_module(d: LensVerdictDiagnostic) -> String {
  match d.at {
    ModuleWholeFile { module_name: m } => m
  }
}

fn lens_verdict_is_fail_closed(verdict: LensVerdict) -> Bool {
  match verdict {
    Unrealized { diagnostic: _ } => true
    _ => false
  }
}

fn lens_verdict_is_violation(verdict: LensVerdict) -> Bool {
  match verdict {
    Violation { diagnostic: _ } => true
    _ => false
  }
}

fn lens_verdict_locus_module(verdict: LensVerdict) -> String {
  match verdict {
    Holds => "std.lens_verdict"
    Violation { diagnostic: d } => lens_verdict_diagnostic_module(d: d)
    NotApplicable { diagnostic: d } => lens_verdict_diagnostic_module(d: d)
    Unrealized { diagnostic: d } => lens_verdict_diagnostic_module(d: d)
  }
}
