// std/syntax.dag -- Language syntax specification types.
//
// Single authority for binary operations, literal values, and syntax
// specification types. The compiler (v2/00_core.dag) imports from here.
//
// Consumers:
//   v2/00_core.dag                      -- compiler IR
//   v2/languages.dag                    -- LanguageSpec shim
//   extdeps/languages/dag/syntax.dag    -- .dag language spec
//   (future) extdeps/languages/*/syntax.dag -- other frontends

module std.syntax

// -- Binary operators -------------------------------------------------
// The set of binary operations. Compact naming — these are universal.
// Ref: ring theory (Add/Sub/Mul/Div/Mod), total order (Eq/Ne/Lt/Gt/Le/Ge),
// boolean algebra (And/Or), language syntax (NullCoalesce).

type BinOp
  = Add | Sub | Mul | Div | Mod
  | Eq | Ne | Lt | Gt | Le | Ge
  | And | Or | NullCoalesce

// -- Literal values ---------------------------------------------------
// All value forms that can appear as literals in source.
// Keyword literals (true/false/null) are a subset used by SyntaxSpec.

type LiteralValue
  = LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | LitBool { value: Bool }
  | LitNull

// -- Item body kinds --------------------------------------------------
// How the body of a declaration is structured.

type BodyKind
  = ExprBody
  | BlockBody
  | TypeBody
  | ValueBody
  | NoBody
  | ServiceBody
  | ResourceBody

// -- Item kind --------------------------------------------------------
// Discriminator for item forms — identifies which semantic role
// an item serves. Used to derive emission keywords from SyntaxSpec.

type ItemFormKind
  = FuncForm
  | StructForm
  | EnumForm
  | TypeAliasForm
  | ModuleForm
  | OtherForm        // trait, impl, const, static, service, resource, etc.

// -- Item form --------------------------------------------------------
// Describes one kind of declaration (fn, type, service, etc.)
// as data. The parser reads this to decide what structural
// components to expect after the keyword.

type ItemForm {
  kind: ItemFormKind
  keyword: String
  has_type_params: Bool
  has_params: Bool
  has_return_type: Bool
  return_required: Bool
  has_uses: Bool
  body_kind: BodyKind
}

// -- Algebra field kind -----------------------------------------------
// Which algebra field an operator dispatches through on the operand type.
// Variants correspond 1:1 to field names on algebraic structure types
// in std/algebra.dag (Ring.add, Field.reciprocal, OrderedRing.quotient, etc.).

type AlgebraFieldKind
  = AlgAdd | AlgMul | AlgReciprocal | AlgQuotient | AlgRemainder
  | AlgCompare | AlgMeet | AlgJoin

// -- Operator specification -------------------------------------------
// One entry in the precedence table.

type OperatorSpec {
  symbol: String
  left_bp: Int
  right_bp: Int
  binop: BinOp?
  algebra_field: AlgebraFieldKind?  // when present, matches only this algebra field on the operand type
}

// -- Full syntax specification ----------------------------------------
// Everything a parser needs to recognize a language's surface syntax.

type SyntaxSpec {
  item_forms: List<ItemForm>
  operators: List<OperatorSpec>
  keyword_literals: Map<String, LiteralValue>
  keyword_set: Map<String, Bool>
}
