// std/cpu/ampere.dag — Ampere CPU model catalog (data authority).
//
// Authority: Ampere product-line invariant facts. Altra Max M128-30: 128
// Neoverse-N1 cores @ 3.0 GHz nominal (Ampere Altra Max datasheet).

module std.cpu.ampere

import std.cpu.types { CpuArchitecture, CpuModelCatalogRow }

// Altra Max M128-30 — operator fleet (Neoverse-N1, 128c/128t @ 3.0 GHz nominal).
data altra_max_catalog: CpuModelCatalogRow = CpuModelCatalogRow {
  architecture: Aarch64,
  cores: 128,
  threads: 128,
  nominal_sustained_per_thread_hz: 3000000000,
}

// Altra Q80-30 — catalog sibling (80c/80t @ 3.0 GHz nominal); not in operator fleet yet.
data altra_catalog: CpuModelCatalogRow = CpuModelCatalogRow {
  architecture: Aarch64,
  cores: 80,
  threads: 80,
  nominal_sustained_per_thread_hz: 3000000000,
}
