module std.encoding

import std.algebra { BoundedLattice }
import std.types { Bytes }

type Encoding
  = ASCII
  | UTF8
  | Latin1
  | Text
  | Binary
  | Unknown

fn encoding_rank(e: Encoding) -> Int {
  match e {
    ASCII => 0
    UTF8 => 1
    Latin1 => 1
    Text => 2
    Binary => 2
    Unknown => 3
  }
}

fn is_text_encoding(e: Encoding) -> Bool {
  match e {
    ASCII => true
    UTF8 => true
    Latin1 => true
    Text => true
    Binary => false
    Unknown => false
  }
}

fn encoding_lattice_meet(a: Encoding, b: Encoding) -> Encoding {
  match a {
    Unknown => b
    ASCII => ASCII
    Binary => match b {
      Binary => Binary
      Unknown => Binary
      _ => ASCII
    }
    UTF8 => match b {
      Unknown => UTF8
      Text => UTF8
      UTF8 => UTF8
      _ => ASCII
    }
    Latin1 => match b {
      Unknown => Latin1
      Text => Latin1
      Latin1 => Latin1
      _ => ASCII
    }
    Text => match b {
      Unknown => Text
      Text => Text
      UTF8 => UTF8
      Latin1 => Latin1
      ASCII => ASCII
      Binary => ASCII
    }
  }
}

fn encoding_lattice_join(a: Encoding, b: Encoding) -> Encoding {
  match a {
    ASCII => b
    Unknown => Unknown
    Binary => match b {
      Binary => Binary
      ASCII => Binary
      Unknown => Unknown
      _ => Unknown
    }
    UTF8 => match b {
      ASCII => UTF8
      UTF8 => UTF8
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Latin1 => match b {
      ASCII => Latin1
      Latin1 => Latin1
      UTF8 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Text => match b {
      ASCII => Text
      UTF8 => Text
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
  }
}

data encoding_bounded_lattice: BoundedLattice<Encoding> = {
  meet: encoding_lattice_meet
  join: encoding_lattice_join
  top: Unknown
  bottom: ASCII
}

fn utf8_decode_bytes(payload: Bytes) -> String {
  ""
}
