module std.markup_jsx_boundary

import std.string_type { String }

type MarkupRealizationLayer
  = MarkupTreeLayer
  | HtmlBracketLayer
  | JsxEnvelopeLayer

data markup_tree_layer_authority: String = "std.markup"

data html_bracket_layer_authority: String = "extdeps.languages.html"

data jsx_envelope_layer_authority: String = "extdeps.languages.react_jsx"

data markup_jsx_vocabulary_boundary: String = "MarkupNode tree (std.markup) | html_markup_medium bracket+escape (extdeps.languages.html) | JSX.Component export envelope (extdeps.languages.react_jsx)"

data markup_jsx_static_only_honesty: String = "static structure only: no props, no state, no hooks, no event handlers, no client logic, no bundler"

data markup_jsx_interactivity_exhaustion: String = "onClick or any JSX expression-valued prop: MarkupAttr.value is String only, react_jsx emits via html_markup_medium so handlers become string HTML attributes not arrow-function JSX props, no MarkupNode variant for expression props conditional render or runtime list map"

fn layer_authority(layer: MarkupRealizationLayer) -> String {
  match layer {
    MarkupTreeLayer => markup_tree_layer_authority
    HtmlBracketLayer => html_bracket_layer_authority
    JsxEnvelopeLayer => jsx_envelope_layer_authority
  }
}
