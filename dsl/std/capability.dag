// std/capability.dag -- Capability contract vocabulary.

module std.capability

type InfraScope = Secret | Identity | Api | Storage | Compute | Network | Database | Queue | Federation

type AccessLevel = Read | Write | Admin

type CapabilityRequirement {
  scope: InfraScope
  level: AccessLevel
  resource: String
}

type CapabilityGrant {
  provider: String
  scope: InfraScope
  concrete_resource: String
}

type ServiceAccessManifest {
  service_name: String
  requirements: List<CapabilityRequirement>
}

data github_issue_provider_manifest: ServiceAccessManifest = {
  service_name: "IssueProvider",
  requirements: [
    { scope: Api, level: Read, resource: "github/issues.read" },
    { scope: Api, level: Write, resource: "github/issues.write" }
  ]
}

data credential_provider_manifest: ServiceAccessManifest = {
  service_name: "CredentialProvider",
  requirements: [
    { scope: Secret, level: Read, resource: "credential.source" },
    { scope: Identity, level: Read, resource: "workload.identity" }
  ]
}
