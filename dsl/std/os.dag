// std/os.dag — distribution catalog → OperatingSystemSurface projections.

module std.os

import std.compute_fabric { OperatingSystemSurface }
import std.os.types {
  MacosDistributionCatalogRow,
  UbuntuDistributionCatalogRow,
  WindowsDistributionCatalogRow,
}

fn operating_system_surface_ubuntu(row: UbuntuDistributionCatalogRow) -> OperatingSystemSurface {
  OperatingSystemSurface {
    kernel: row.kernel,
    distro_or_product: Some { value: row.distro_or_product },
    version: Some { value: row.version },
    filesystem_semantics: row.filesystem_semantics,
    process_semantics: row.process_semantics,
  }
}

fn operating_system_surface_windows(row: WindowsDistributionCatalogRow) -> OperatingSystemSurface {
  OperatingSystemSurface {
    kernel: row.kernel,
    distro_or_product: Some { value: row.distro_or_product },
    version: Some { value: row.version },
    filesystem_semantics: row.filesystem_semantics,
    process_semantics: row.process_semantics,
  }
}

fn operating_system_surface_macos(row: MacosDistributionCatalogRow) -> OperatingSystemSurface {
  OperatingSystemSurface {
    kernel: row.kernel,
    distro_or_product: Some { value: row.distro_or_product },
    version: Some { value: row.version },
    filesystem_semantics: row.filesystem_semantics,
    process_semantics: row.process_semantics,
  }
}
