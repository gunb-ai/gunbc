// std/react_markup.dag — React/TSX serialize result wrapper over std.markup.
//
// gunbhub R1 builds MarkupNode trees (the shared std.markup consumer IR) and
// renders through this thin entry. The element tree, the href/src XSS gate
// (validate_href / find_first_rejected_url — formerly a DIVERGING re-mint here)
// and the Fragment adapter all live in std.markup, the ONE authority shared
// with std.html_markup. This module adds only React's result shape, which
// surfaces the offending URL on rejection.

module std.react_markup

import std.markup {
  MarkupNode,
  find_first_rejected_url,
  serialize_markup_node,
}

type MarkupRejectReason = UntrustedUrlScheme { url: String }

type MarkupEmitResult
  = EmitOk { html: String }
  | EmitRejected { reason: MarkupRejectReason }

// Thin consumer entry: fail-closed on untrusted href/src schemes, carrying the
// offending URL in the rejection (the shared gate already located it).
fn serialize_react_markup(node: MarkupNode) -> MarkupEmitResult {
  match find_first_rejected_url(node: node) {
    Present { value: ru } =>
      EmitRejected { reason: UntrustedUrlScheme { url: ru.url } }
    Absent =>
      EmitOk { html: serialize_markup_node(node: node) }
  }
}
