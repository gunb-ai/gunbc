module std.react_markup

import std.markup {
  MarkupNode,
  find_first_rejected_url,
  serialize_markup_node,
}

type MarkupRejectReason = UntrustedUrlScheme { url: String }

type MarkupEmitResult
  = EmitOk { html: String }
  | EmitRejected { reason: MarkupRejectReason }

fn serialize_react_markup(node: MarkupNode) -> MarkupEmitResult {
  match find_first_rejected_url(node: node) {
    Present { value: ru } =>
      EmitRejected { reason: UntrustedUrlScheme { url: ru.url } }
    Absent =>
      EmitOk { html: serialize_markup_node(node: node) }
  }
}
