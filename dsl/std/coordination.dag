// std/coordination.dag -- Coordination primitive vocabulary.

module std.coordination

type CasMechanism = GenerationBased | ETagBased | VersionId | RowVersion

type FencingToken {
  scope: String
  value: Int
}

type LeaseConfig {
  ttl_seconds: Int
  heartbeat_interval_seconds: Int
}

type DeliveryGuarantee = AtLeastOnce | AtMostOnce | ExactlyOnce

type QueueOrdering = Unordered | Fifo | PriorityFifo

type DeadLetterPolicy {
  max_attempts: Int
  destination: String
}

type QueueSemantics {
  ordering: QueueOrdering
  visibility_timeout_seconds: Int?
  dead_letter: DeadLetterPolicy?
}

type NotificationMechanism = Polling | PubSub | Listen | Webhook

data default_lease: LeaseConfig = {
  ttl_seconds: 300,
  heartbeat_interval_seconds: 60
}

data default_dead_letter: DeadLetterPolicy = {
  max_attempts: 10,
  destination: "dead-letter"
}
