// std/cpu.dag — CPU concept projections over a vendor-agnostic catalog row.
//
// Types: std.cpu.types. Per-vendor catalog data: extdeps.cpu.<vendor>.
// std/cpu owns only the general CPU concept; it does not enumerate any one
// vendor's parts, so it does NOT dispatch on owned SKUs.

module std.cpu

import std.cpu.types { CpuArchitecture, CpuFacts, CpuVendor }
import std.measure { HardwareThreadCount, Hertz }

fn cpu_vendor(cpu: CpuFacts) -> CpuVendor {
  cpu.catalog.vendor
}

fn cpu_facts_cores(cpu: CpuFacts) -> Int {
  cpu.catalog.cores
}

fn cpu_facts_threads(cpu: CpuFacts) -> HardwareThreadCount {
  cpu.catalog.threads
}

fn cpu_facts_architecture(cpu: CpuFacts) -> CpuArchitecture {
  cpu.catalog.architecture
}

fn cpu_facts_sustained_per_thread_hz(cpu: CpuFacts) -> Hertz {
  cpu.deployment.sustained_per_thread_hz
}
