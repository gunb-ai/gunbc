// std/effects.dag -- Effect algebra for operation composition.
//
// An operation's effect on external state determines whether it is
// idempotent, whether it composes safely with other operations, and
// what verification the compiler generates.
//
// DESIGN PRINCIPLE:
//   Idempotency is not a flag. It is a DERIVED PROPERTY of the
//   effect's algebraic structure. An operation whose effect forms
//   a lattice meet on the target state is idempotent by construction.
//   The compiler doesn't ask "did you mark this idempotent?" — it
//   checks "does this effect inhabit a lattice?"
//
// EXTERNAL AUTHORITY:
//   - Lattice theory: Birkhoff (1940)
//     Lattice = set with meet ∧ and join ∨, both idempotent,
//     commutative, associative, with absorption.
//     meet(a, a) = a is the idempotency law.
//   - Effect algebras: Foulis, Bennett (1994)
//     Compositional effects with partial combination.
//   - Idempotent semirings: used in dataflow analysis, routing
//     algebras, tropical geometry.
//
// RELATIONSHIP TO std/algebra.dag:
//   Lattice<T> is declared in algebra.dag. This file applies the
//   lattice structure to operation effects — the "T" is the state
//   space that the operation modifies.
//
// RELATIONSHIP TO std/behavioral.dag:
//   behavioral.dag declares OperationBehavior with idempotent: Bool.
//   That flag dissolves when this algebra is wired: idempotency is
//   derived from EffectShape, not declared.
//
// CONSUMERS:
//   - Compiler: compose effects through workflows, prove idempotency
//   - Test generation: emit f(f(x)) == f(x) tests for idempotent ops
//   - Diagnostics: show the composition chain when idempotency breaks

module std.effects

import std.types { HttpMethod, GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS, String, List }
import std.realization_schedule { string_list_eq }
import std.http_path {
  PathTemplate,
  PathTemplateParseResult, ParsedPathTemplate, MalformedPathTemplate,
  parse_path_template, has_path_params, last_path_param
}

// =========================================================================
// Effect shapes: how an operation modifies external state
// =========================================================================

// The fundamental classification of an operation's effect.
//
// Each shape corresponds to an algebraic structure on the state space:
//
//   ReadEffect:      identity function on state (trivially idempotent)
//   UpsertEffect:    lattice meet on Map<K, V> — sets key to value
//                    meet(state, {k: v}) applied twice = applied once
//   DeleteEffect:    lattice meet with bottom on key — removes key
//                    meet(state, {k: ⊥}) applied twice = applied once
//   CreateEffect:    monoid append when create-always (PostAlways) — NOT idempotent
//                    create-if-absent (proven KeySource) — lattice meet, idempotent
//   AppendEffect:    monoid append on ordered collection
//                    NOT idempotent (appends duplicates)
//
// The state model determines the algebra:
//   Map<K, V> with upsert/delete → BoundedLattice (idempotent)
//   Set<T> with insert/remove    → BoundedLattice (idempotent)
//   List<T> with append          → FreeMonoid (NOT idempotent)

type EffectShape
  = ReadEffect
  | UpsertEffect { key_source: KeySource }
  | DeleteEffect { key_source: KeySource }
  | CreateEffect { cause: CreateCause }
  | AppendEffect

// Why a create-shaped effect was derived. PostAlways = fail-closed create-always
// (no proven resource identity). CreateIfAbsent = guarded create with proven KeySource.
type CreateCause
  = PostAlways
  | CreateIfAbsent { key_source: KeySource }

// Where the idempotency key comes from.
//
// The key is what makes upsert/delete convergent: operating on the
// same key with the same value produces the same state regardless
// of how many times you apply it.
//
// PathParam:     key extracted from URL/path template ({id}, {name})
// InputField:    key is a declared input field of the operation
// CompositeKey:  key is a tuple of multiple fields

type KeySource
  = PathParam { param: String }
  | InputField { field: String }
  | CompositeKey { fields: List<String> }

// =========================================================================
// Effect evidence: the idempotency proof
// =========================================================================

// Per-operation evidence of idempotency.
//
// Analogous to DescentEvidence in termination proofs:
//   termination: "this argument is structurally smaller"
//   idempotency: "this effect forms a lattice on the target state"

type IdempotencyEvidence
  = LatticeEffect { shape: EffectShape }
  | IdentityEffect
  | NonIdempotent { shape: EffectShape, reason: String }

// Whether an effect is idempotent — derived from its shape.
fn is_idempotent_effect(shape: EffectShape) -> Bool {
  match shape {
    ReadEffect => true
    UpsertEffect => true
    DeleteEffect => true
    CreateEffect { cause: cause } =>
      match cause {
        CreateIfAbsent { key_source: key_source } => true
        PostAlways => false
      }
    AppendEffect => false
  }
}

// dissolve-on: derived structural == on KeySource (closed coproduct equality) replaces this
// hand-rolled predicate; interim owner: increment-1 create_double_init_collapsible identity.
fn key_source_eq(a: KeySource, b: KeySource) -> Bool {
  match a {
    PathParam { param: pa } => match b {
      PathParam { param: pb } => pa == pb
      _ => false
    }
    InputField { field: fa } => match b {
      InputField { field: fb } => fa == fb
      _ => false
    }
    CompositeKey { fields: fa } => match b {
      CompositeKey { fields: fb } => string_list_eq(left: fa, right: fb)
      _ => false
    }
  }
}

// Increment-1 membership: is this shape in the create-if-absent dedup-eligible class?
// Pairwise Share collapse (same identity) is create_double_init_collapsible, not this predicate.
// dissolve-on: increment-2 Share/dedup classifier surface replaces both interim predicates.
fn create_effect_is_dedupable(shape: EffectShape) -> Bool {
  match shape {
    CreateEffect { cause: cause } =>
      match cause {
        CreateIfAbsent { key_source: key_source } => true
        PostAlways => false
      }
    _ => false
  }
}

// Pairwise Share collapse for increment-1 create-if-absent double-init dedup.
// dissolve-on: increment-2 Share/dedup classifier surface replaces both interim predicates.
fn create_double_init_collapsible(a: EffectShape, b: EffectShape) -> Bool {
  match a {
    CreateEffect { cause: cause_a } =>
      match cause_a {
        CreateIfAbsent { key_source: ka } =>
          match b {
            CreateEffect { cause: cause_b } =>
              match cause_b {
                CreateIfAbsent { key_source: kb } => key_source_eq(a: ka, b: kb)
                PostAlways => false
              }
            _ => false
          }
        PostAlways => false
      }
    _ => false
  }
}

// =========================================================================
// Effect composition: workflows compose effects
// =========================================================================

// Composed effect of a sequence of operations.
//
// A workflow is idempotent iff all its constituent effects are
// idempotent. This is because lattice meets compose:
//   meet_a ∘ meet_b applied twice = meet_a ∘ meet_b applied once
//   (each individual meet is idempotent, and the composition of
//   idempotent functions on orthogonal keys is idempotent)
//
// Non-idempotent effects poison the composition:
//   meet_a ∘ append_b applied twice ≠ applied once
//   (the append duplicates on the second application)

// Per-operation effect entry in a workflow.
type OperationEffect {
  operation_name: String
  shape: EffectShape
  evidence: IdempotencyEvidence
}

// Workflow-level idempotency judgment — a sum, not a Bool × optional
// label product. The old `ComposedEffect { idempotent, breaking_operation }`
// shape admitted contradictory states (e.g. idempotent true with a named
// breaker). R3 F5: only these two arms exist; `compose_effects` returns them.
type CompositionVerdict
  = IdempotentComposition
  | BrokenBy { first_breaker: OperationEffect }

// Compose a list of operation effects into a workflow-level verdict.
fn compose_effects(effects: List<OperationEffect>) -> CompositionVerdict {
  let non_idempotent = effects |> filter(e =>
    match e.evidence {
      NonIdempotent => true
      _ => false
    }
  )
  match non_idempotent |> first {
    Present { value: op } => BrokenBy { first_breaker: op }
    Absent => IdempotentComposition
  }
}

// =========================================================================
// Effect derivation from transport facts
// =========================================================================

// The compiler derives EffectShape from facts it already has on
// the service operation:
//
// | HTTP method | Key in path? | Derived shape        | Idempotent? |
// |-------------|-------------|----------------------|-------------|
// | GET         | —           | ReadEffect           | Yes         |
// | PUT         | Yes ({id})  | UpsertEffect(PathParam) | Yes      |
// | PUT         | No          | UpsertEffect(InputField) | Yes*    |
// | DELETE      | Yes ({id})  | DeleteEffect(PathParam) | Yes      |
// | POST        | Yes ({id})  | UpsertEffect(PathParam) | Yes      |
// | POST        | No          | CreateEffect         | No          |
// | PATCH       | Yes ({id})  | UpsertEffect(PathParam) | Yes      |
//
// * PUT without path key: the upsert key must come from an input
//   field. The compiler looks for a field marked as identity/key.
//
// For shell transport:
//   readonly operations → ReadEffect
//   operations with idempotent flag → derive from command semantics
//
// The derivation replaces the manual `idempotent: Bool` on
// OperationBehavior. The flag dissolves.

// -------------------------------------------------------------------------
// Modifier roles after v1 derivation lands
// -------------------------------------------------------------------------
// Three modifiers survive with distinct roles after this PR:
//   idempotent on REST ops:
//     - DISSOLVED where derivation Agrees (1 site: AccessVersion — GET)
//     - KEPT where derivation is DerivationUnknown because POST always
//       derives CreateEffect (fail-closed — no proven resource identity)
//       (4 sites: AddVersion, GenerateAccessToken, Refresh, Exchange)
//   readonly on REST GETs:
//     - ASSERTABLE-REDUNDANT (check_modifier_vs_derivation returns Agrees)
//     - Deletion deferred to v2 once derivation has wider track record
//   readonly on shell/file/cron/cargo/git/gunbc ops:
//     - LOAD-BEARING declaration, not a REST method proxy
//     - INPUT to future derive_shell_effect_shape (out of scope for v1)

// =========================================================================
// Effect derivation implementation
// =========================================================================

type DerivedOpEffect {
  operation_name: String
  method: HttpMethod
  path_template: PathTemplate
  shape: EffectShape
}

// 🟡 SCAFFOLD. This coproduct remains as the v2 bridge result carrier while
// surface parsing failures are still reported through local parser helpers.
// `derive_op_effect` itself is structural: it consumes typed HttpMethod and
// PathTemplate carriers and only constructs the successful derived effect.
// Dissolution trigger: callers move to the shared compiler diagnostic/result
// carrier and this local v2 bridge result can collapse away.
type DeriveOpEffectResult
  = DerivedEffect { effect: DerivedOpEffect }
  | MalformedPathInput {
      operation_name: String,
      method: HttpMethod,
      raw_path: String,
      segment: String,
      reason: String
    }

// Fail-closed derivation: only classifies effects the model can prove.
//
// POST always derives CreateEffect — the table cannot distinguish
// parent-scoped paths (POST /projects/{id}/secrets creates a CHILD)
// from resource-identity paths without a structural subject-key witness.
// This is conservative: declared `idempotent` modifiers on POST ops
// surface as DerivationUnknown, not as false proofs.
//
// PUT/PATCH/DELETE require a proven path key. Without one, the
// derivation returns CreateEffect (non-idempotent) rather than
// fabricating an empty InputField key.
fn derive_effect_shape(
  method: HttpMethod,
  path: PathTemplate
) -> EffectShape {
  match method {
    GET     => ReadEffect
    HEAD    => ReadEffect
    OPTIONS => ReadEffect
    POST    => CreateEffect { cause: PostAlways }
    DELETE =>
      match last_path_param(template: path) {
        Present { value: p } => DeleteEffect { key_source: PathParam { param: p } }
        Absent => CreateEffect { cause: PostAlways }
      }
    PUT =>
      match last_path_param(template: path) {
        Present { value: p } => UpsertEffect { key_source: PathParam { param: p } }
        Absent => CreateEffect { cause: PostAlways }
      }
    PATCH =>
      match last_path_param(template: path) {
        Present { value: p } => UpsertEffect { key_source: PathParam { param: p } }
        Absent => CreateEffect { cause: PostAlways }
      }
  }
}

fn derive_op_effect(
  operation_name: String,
  method: HttpMethod,
  path: PathTemplate
) -> DeriveOpEffectResult {
  let shape = derive_effect_shape(method: method, path: path)
  DerivedEffect { effect: DerivedOpEffect {
    operation_name: operation_name,
    method: method,
    path_template: path,
    shape: shape
  } }
}

// =========================================================================
// Modifier falsification
// =========================================================================

type ModifierAgreement
  = Agrees
  | Disagrees          { reason: String }
  | DerivationUnknown  { reason: String }

type ModifierCheck {
  operation_name: String
  declared_idempotent: Bool
  declared_readonly: Bool
  derived_shape: EffectShape
  agreement: ModifierAgreement
}

fn check_modifier_vs_derivation(
  op: DerivedOpEffect,
  declared_idempotent: Bool,
  declared_readonly: Bool
) -> ModifierCheck {
  let derived_idempotent = is_idempotent_effect(shape: op.shape)
  let agreement = if declared_idempotent && derived_idempotent {
    Agrees
  } else if declared_idempotent && !derived_idempotent {
    match op.shape {
      CreateEffect { cause: PostAlways } =>
        DerivationUnknown { reason: "POST with no path key derives CreateEffect; idempotency may be spec-declared" }
      _ =>
        Disagrees { reason: "derivation says non-idempotent but modifier declares idempotent" }
    }
  } else if !declared_idempotent && derived_idempotent {
    match op.shape {
      CreateEffect { cause: CreateIfAbsent { key_source: key_source } } =>
        Disagrees { reason: "create-if-absent has proven identity but modifier declares non-idempotent" }
      _ =>
        Agrees
    }
  } else if !declared_idempotent && declared_readonly {
    match op.method {
      GET => Agrees
      HEAD => Agrees
      OPTIONS => Agrees
      _ => Disagrees { reason: "readonly declared but method is not GET/HEAD/OPTIONS" }
    }
  } else {
    Agrees
  }
  ModifierCheck {
    operation_name: op.operation_name,
    declared_idempotent: declared_idempotent,
    declared_readonly: declared_readonly,
    derived_shape: op.shape,
    agreement: agreement
  }
}

// =========================================================================
// Test obligation generation
// =========================================================================

type IdempotencyTestObligation {
  operation_name: String
  effect_shape: EffectShape
  claim: String
  witness_required: Bool
}

fn generate_idempotency_obligations(
  ops: List<DerivedOpEffect>
) -> List<IdempotencyTestObligation> {
  ops |> filter(o => is_idempotent_effect(shape: o.shape))
      |> map(o => IdempotencyTestObligation {
           operation_name: o.operation_name,
           effect_shape: o.shape,
           claim: "f(f(x)) == f(x)",
           witness_required: true
         })
}

// =========================================================================
// Workflow-level effect concerns
// =========================================================================

type WorkflowEffectConcern {
  workflow_name: String
  create_op: String
  reason: String
}

// =========================================================================
// Relationship to verification (KF-3)
// =========================================================================

// For operations proven idempotent, the compiler generates:
//
//   test "{operation} is idempotent" {
//     let state1 = run(operation, input: test_input)
//     let state2 = run(operation, input: test_input)
//     assert state1 == state2
//   }
//
// For workflows proven idempotent:
//
//   test "{workflow} is idempotent" {
//     let state1 = run(workflow, config: test_config)
//     let state2 = run(workflow, config: test_config)
//     assert state1 == state2
//   }
//
// These tests verify the MODEL against reality. The compile-time
// proof says "if your model is right, this is idempotent." The
// generated test says "and your model IS right."
