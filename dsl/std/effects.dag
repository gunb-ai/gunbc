// std/effects.dag -- Effect algebra for operation composition.
//
// An operation's effect on external state determines whether it is
// idempotent, whether it composes safely with other operations, and
// what verification the compiler generates.
//
// DESIGN PRINCIPLE:
//   Idempotency is not a flag. It is a DERIVED PROPERTY of the
//   effect's algebraic structure. An operation whose effect forms
//   a lattice meet on the target state is idempotent by construction.
//   The compiler doesn't ask "did you mark this idempotent?" — it
//   checks "does this effect inhabit a lattice?"
//
// EXTERNAL AUTHORITY:
//   - Lattice theory: Birkhoff (1940)
//     Lattice = set with meet ∧ and join ∨, both idempotent,
//     commutative, associative, with absorption.
//     meet(a, a) = a is the idempotency law.
//   - Effect algebras: Foulis, Bennett (1994)
//     Compositional effects with partial combination.
//   - Idempotent semirings: used in dataflow analysis, routing
//     algebras, tropical geometry.
//
// RELATIONSHIP TO std/algebra.dag:
//   Lattice<T> is declared in algebra.dag. This file applies the
//   lattice structure to operation effects — the "T" is the state
//   space that the operation modifies.
//
// RELATIONSHIP TO std/behavioral.dag:
//   behavioral.dag declares OperationBehavior with idempotent: Bool.
//   That flag dissolves when this algebra is wired: idempotency is
//   derived from EffectShape, not declared.
//
// CONSUMERS:
//   - Compiler: compose effects through workflows, prove idempotency
//   - Test generation: emit f(f(x)) == f(x) tests for idempotent ops
//   - Diagnostics: show the composition chain when idempotency breaks

module std.effects

// =========================================================================
// Effect shapes: how an operation modifies external state
// =========================================================================

// The fundamental classification of an operation's effect.
//
// Each shape corresponds to an algebraic structure on the state space:
//
//   ReadEffect:      identity function on state (trivially idempotent)
//   UpsertEffect:    lattice meet on Map<K, V> — sets key to value
//                    meet(state, {k: v}) applied twice = applied once
//   DeleteEffect:    lattice meet with bottom on key — removes key
//                    meet(state, {k: ⊥}) applied twice = applied once
//   CreateEffect:    monoid append — adds new entry without key guard
//                    NOT idempotent (creates duplicates)
//   AppendEffect:    monoid append on ordered collection
//                    NOT idempotent (appends duplicates)
//
// The state model determines the algebra:
//   Map<K, V> with upsert/delete → BoundedLattice (idempotent)
//   Set<T> with insert/remove    → BoundedLattice (idempotent)
//   List<T> with append          → FreeMonoid (NOT idempotent)

type EffectShape
  = ReadEffect
  | UpsertEffect { key_source: KeySource }
  | DeleteEffect { key_source: KeySource }
  | CreateEffect
  | AppendEffect

// Where the idempotency key comes from.
//
// The key is what makes upsert/delete convergent: operating on the
// same key with the same value produces the same state regardless
// of how many times you apply it.
//
// PathParam:     key extracted from URL/path template ({id}, {name})
// InputField:    key is a declared input field of the operation
// CompositeKey:  key is a tuple of multiple fields

type KeySource
  = PathParam { param: String }
  | InputField { field: String }
  | CompositeKey { fields: List<String> }

// =========================================================================
// Effect evidence: the idempotency proof
// =========================================================================

// Per-operation evidence of idempotency.
//
// Analogous to DescentEvidence in termination proofs:
//   termination: "this argument is structurally smaller"
//   idempotency: "this effect forms a lattice on the target state"

type IdempotencyEvidence
  = LatticeEffect { shape: EffectShape }
  | IdentityEffect
  | NonIdempotent { shape: EffectShape, reason: String }

// Whether an effect is idempotent — derived from its shape.
fn is_idempotent_effect(shape: EffectShape) -> Bool {
  match shape {
    ReadEffect => true
    UpsertEffect => true
    DeleteEffect => true
    CreateEffect => false
    AppendEffect => false
  }
}

// =========================================================================
// Effect composition: workflows compose effects
// =========================================================================

// Composed effect of a sequence of operations.
//
// A workflow is idempotent iff all its constituent effects are
// idempotent. This is because lattice meets compose:
//   meet_a ∘ meet_b applied twice = meet_a ∘ meet_b applied once
//   (each individual meet is idempotent, and the composition of
//   idempotent functions on orthogonal keys is idempotent)
//
// Non-idempotent effects poison the composition:
//   meet_a ∘ append_b applied twice ≠ applied once
//   (the append duplicates on the second application)

type ComposedEffect {
  operations: List<OperationEffect>
  idempotent: Bool
  breaking_operation: String?
}

// Per-operation effect entry in a workflow.
type OperationEffect {
  operation_name: String
  shape: EffectShape
  evidence: IdempotencyEvidence
}

// Compose a list of operation effects into a workflow-level verdict.
fn compose_effects(effects: List<OperationEffect>) -> ComposedEffect {
  let non_idempotent = effects |> filter(e =>
    match e.evidence {
      NonIdempotent => true
      _ => false
    }
  )
  let breaker = non_idempotent |> first
  let breaker_name = match breaker {
    Some { value: op } => Some { value: op.operation_name }
    None => none
  }
  ComposedEffect {
    operations: effects,
    idempotent: non_idempotent |> count == 0,
    breaking_operation: breaker_name
  }
}

// =========================================================================
// Effect derivation from transport facts
// =========================================================================

// The compiler derives EffectShape from facts it already has on
// the service operation:
//
// | HTTP method | Key in path? | Derived shape        | Idempotent? |
// |-------------|-------------|----------------------|-------------|
// | GET         | —           | ReadEffect           | Yes         |
// | PUT         | Yes ({id})  | UpsertEffect(PathParam) | Yes      |
// | PUT         | No          | UpsertEffect(InputField) | Yes*    |
// | DELETE      | Yes ({id})  | DeleteEffect(PathParam) | Yes      |
// | POST        | Yes ({id})  | UpsertEffect(PathParam) | Yes      |
// | POST        | No          | CreateEffect         | No          |
// | PATCH       | Yes ({id})  | UpsertEffect(PathParam) | Yes      |
//
// * PUT without path key: the upsert key must come from an input
//   field. The compiler looks for a field marked as identity/key.
//
// For shell transport:
//   readonly operations → ReadEffect
//   operations with idempotent flag → derive from command semantics
//
// The derivation replaces the manual `idempotent: Bool` on
// OperationBehavior. The flag dissolves.

// =========================================================================
// Relationship to verification (KF-3)
// =========================================================================

// For operations proven idempotent, the compiler generates:
//
//   test "{operation} is idempotent" {
//     let state1 = run(operation, input: test_input)
//     let state2 = run(operation, input: test_input)
//     assert state1 == state2
//   }
//
// For workflows proven idempotent:
//
//   test "{workflow} is idempotent" {
//     let state1 = run(workflow, config: test_config)
//     let state2 = run(workflow, config: test_config)
//     assert state1 == state2
//   }
//
// These tests verify the MODEL against reality. The compile-time
// proof says "if your model is right, this is idempotent." The
// generated test says "and your model IS right."
