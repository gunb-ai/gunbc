// std/induction.dag -- Inductive type structure and structural recursion.
//
// Every .dag type with recursive fields is an inductive type. Its
// structure contains all the information needed for termination proofs
// and complexity bounds. This file models the type-level facts from
// which complexity analysis is DERIVED — no heuristic pattern-matching,
// no hand-maintained accessor tables.
//
// EXTERNAL AUTHORITY:
//   - Initial algebras of endofunctors: Lambek (1968)
//     https://en.wikipedia.org/wiki/Initial_algebra
//     An inductive type is the initial algebra of its signature functor.
//     The type definition IS the functor; the constructors are the algebra.
//   - Catamorphisms: Meijer, Fokkinga, Paterson (1991) "Bananas" paper
//     https://en.wikipedia.org/wiki/Catamorphism
//     Every initial algebra has a unique fold (catamorphism). A function
//     that recurses only on sub-terms of its inductive argument IS a
//     catamorphism. Termination is guaranteed by well-foundedness.
//   - Size-change termination: Lee, Jones, Ben-Amram (2001)
//     https://en.wikipedia.org/wiki/Size-change_termination_principle
//     Termination is decidable when each call either strictly decreases
//     or preserves a well-founded measure. SubValueRelation models the
//     size-change graph edges.
//   - Well-founded induction: Floyd (1967), Turing (1949)
//     https://en.wikipedia.org/wiki/Well-founded_relation
//     Every inductive type has a natural well-founded ordering: the
//     sub-term relation. The size measure (constructor count) maps to ℕ.
//   - Structural induction / primitive recursion:
//     https://en.wikipedia.org/wiki/Structural_induction
//     Recursion on sub-terms of an inductively defined structure is
//     guaranteed to terminate. InductiveField models the sub-term positions.
//   - Master theorem: Bentley, Haken, Saxe (1980); CLRS Theorem 4.1
//     https://en.wikipedia.org/wiki/Master_theorem_(analysis_of_algorithms)
//     For recurrences T(n) = a·T(n/b) + O(n^d), the asymptotic bound
//     is determined by comparing log_b(a) with d.
//   - Asymptotic notation: Knuth (1976) "Big Omicron and big Omega"
//     https://en.wikipedia.org/wiki/Big_O_notation
//     O(f(n)) denotes the class of functions bounded above by c·f(n)
//     for sufficiently large n.
//
// RELATIONSHIP TO std/termination.dag:
//   termination.dag defines DescentEvidence and RankingDimension as
//   abstract proof components. This file defines the TYPE-LEVEL facts
//   that PRODUCE ranking dimensions and descent evidence. A
//   RankingDimension is a consequence of an InductiveField; a
//   DescentEvidence is a consequence of a SubValueRelation.
//
// RELATIONSHIP TO std/computation.dag:
//   computation.dag defines CallPattern → LoweringTarget. This file's
//   SubValueRelation produces the CallPattern for a self-call.
//
// RELATIONSHIP TO std/iteration.dag:
//   iteration.dag defines descend (tree catamorphism) and fold (list
//   catamorphism). This file proves WHICH recursive functions are
//   catamorphisms — i.e., which functions structurally recurse on
//   sub-terms of an inductive type.
//
// DESIGN PRINCIPLE (P1 from cx-design.md):
//   Descent is a TYPE-LEVEL fact. The type definition `children: List<Node>`
//   IS the descent fact. The complexity analyzer should never need to know
//   about specific accessor functions. It reads from the type that certain
//   fields carry recursive sub-structure.

module std.induction

import std.termination {
  DescentEvidence, Strict, NonIncreasing, DescentUnknown,
  RankingDimension, TreeSize,
  PositiveDescentAmount, OneStep, AdditionalStep,
  ProportionalDivisor, DivideByTwo, StrictlyLarger,
  proportional_divisor_to_int,
  positive_descent_amount_from_positive_int,
  proportional_divisor_from_int_at_least_two,
  peano_literal_materialization_cap
}
import std.computation {
  CallPattern, ChildAccessorCall, FoldBodyCall, SameArgumentCall,
  ArithmeticSubtractCall, ArithmeticDivideCall,
  LoweringTarget, IterationPrimitive, Descend, Fold, Repeat,
  ShrinkFactor, UnitShrink, ConstantShrink, ProportionalShrink,
  CollectionSize, ArithmeticParam, Forever,
  tree_size_bound, positive_descent_count
}



// =========================================================================
// RecursionShape — how a field references its parent type
// =========================================================================

// The .dag type system has these ways a field can reference its parent
// type. These correspond to positions in the signature functor of the
// initial algebra (Lambek 1968):
//
//   DirectRecursion:     F(X) = ... × X × ...
//   ListRecursion:       F(X) = ... × List(X) × ...   (free monoid functor)
//   OptionalRecursion:   F(X) = ... × (1 + X) × ...   (maybe functor)
//   SetRecursion:        F(X) = ... × Set(X) × ...    (powerset functor)
//   MapValueRecursion:   F(X) = ... × Map(K, X) × ... (partial function functor)
//
// These enumerate the container types in the .dag language. Adding a new
// container type to the language adds one variant here.
//
// 🟢 TERMINAL at E-I inductive-shape scope. Pure functor-shape partition for
// recursive field wrappers; no name-like payloads.

type RecursionShape
  = DirectRecursion       // field_type == parent_type
  | ListRecursion         // field_type == List<parent_type>
  | OptionalRecursion     // field_type == parent_type?
  | SetRecursion          // field_type == Set<parent_type>
  | MapValueRecursion     // field_type == Map<K, parent_type>


// =========================================================================
// InductiveField — one recursive position in a type definition
// =========================================================================

// An InductiveField is one position in the signature functor of an
// inductive type. It records:
//   - WHICH type is inductive (type_name)
//   - WHICH constructor contains the recursion (variant_name, "" for records)
//   - WHICH field carries the recursive reference (field_name)
//   - HOW the reference is wrapped (shape)
//
// For type Node { children: List<Node>, body: Node?, name: String }:
//   InductiveField { type_name: "Node", variant_name: "", field_name: "children", shape: ListRecursion }
//   InductiveField { type_name: "Node", variant_name: "", field_name: "body", shape: OptionalRecursion }
//   (name: String produces no InductiveField — it's not recursive)
//
// For type MyList<T> = Nil | Cons { head: T, tail: MyList<T> }:
//   InductiveField { type_name: "MyList", variant_name: "Cons", field_name: "tail", shape: DirectRecursion }
//
// 🟡 SCAFFOLD. Type/variant/field identities are `String` bridges until reflected
// declarations supply structural references; `RecursionShape` is terminal.

type InductiveField {
  type_name: String         // type that owns this field ("Node", "InferredNode")
  variant_name: String      // "" for records, variant name for sum types
  field_name: String        // "children", "body", "node"
  shape: RecursionShape     // how field references recursive structure
  element_type: String      // type of the element (== type_name for self-referential, different for cross-type)
}

fn recursion_shape_eq(a: RecursionShape, b: RecursionShape) -> Bool {
  match a {
    DirectRecursion => match b { DirectRecursion => true, _ => false }
    ListRecursion => match b { ListRecursion => true, _ => false }
    OptionalRecursion => match b { OptionalRecursion => true, _ => false }
    SetRecursion => match b { SetRecursion => true, _ => false }
    MapValueRecursion => match b { MapValueRecursion => true, _ => false }
  }
}

fn inductive_field_eq(a: InductiveField, b: InductiveField) -> Bool {
  a.type_name == b.type_name &&
    a.variant_name == b.variant_name &&
    a.field_name == b.field_name &&
    recursion_shape_eq(a: a.shape, b: b.shape) &&
    a.element_type == b.element_type
}


// =========================================================================
// InductiveField → RankingDimension
// =========================================================================

// Every inductive type has a natural size measure: the number of
// constructors in a value. All recursion shapes produce TreeSize
// because they all measure structural depth.

fn inductive_field_to_dimension(field: InductiveField, param: String) -> RankingDimension {
  TreeSize { param: param }
}


// =========================================================================
// ShrinkFactor — imported from std.computation (moved to avoid circular dep)


// =========================================================================
// SubValueRelation — call-site descent evidence
// =========================================================================

// At each self-call site, each argument either:
//   - Is obtained by deconstructing through a recursive field (StrictSubValue)
//   - Is an element from iterating over a recursive list field (IteratedSubValue)
//   - Is the same value, no descent (PreservedValue)
//   - Cannot be classified by the analyzer (SubValueUnknown — fail-closed)
//
// SubValueUnknown is categorically different from PreservedValue:
//   PreservedValue = the argument IS the parameter (no descent, bounded by Forever)
//   SubValueUnknown = the analyzer cannot determine the relationship (hard error)
//
// 🟡 MIXED. Structural descent via `InductiveField` and proof-grade `ShrinkFactor`
// (`std.computation`); `ArithmeticDescent` names a parameter; `SubValueUnknown` is the fail-closed sink.

type SubValueRelation
  = StrictSubValue { field: InductiveField, factor: ShrinkFactor }
  | IteratedSubValue { field: InductiveField }
  | ArithmeticDescent { param: String, factor: ShrinkFactor }
  | PreservedValue
  | SubValueUnknown


// =========================================================================
// ShrinkFactor is now on LoweringTarget directly (no wrapper needed).


// =========================================================================
// SubValueRelation → DescentEvidence
// =========================================================================

// `ShrinkFactor` has no raw `Int` rate fields — only `UnitShrink` and carriers into
// `PositiveDescentAmount` / `ProportionalDivisor` (`std.computation` / `std.termination`).
// Non-positive steps and divisors < 2 are therefore not representable here; producers
// that still see `Int` validate upstream and fail closed to `SubValueUnknown` instead of
// minting `ArithmeticDescent` / `StrictSubValue`. Evidence mapping matches on `factor`
// so `Strict` is issued only alongside an exhaustively-known proof-grade shrink shape.

fn sub_value_to_evidence(relation: SubValueRelation) -> DescentEvidence {
  match relation {
    StrictSubValue { field: _, factor: f } =>
      match f {
        UnitShrink => Strict
        ConstantShrink { steps: _ } => Strict
        ProportionalShrink { divisor: _ } => Strict
      }
    IteratedSubValue { field: _ }            => Strict
    ArithmeticDescent { param: _, factor: f } =>
      match f {
        UnitShrink => Strict
        ConstantShrink { steps: _ } => Strict
        ProportionalShrink { divisor: _ } => Strict
      }
    PreservedValue                           => NonIncreasing
    SubValueUnknown                          => DescentUnknown
  }
}


// =========================================================================
// SubValueRelation lattice: meet/join for conservative/optimistic merge
// =========================================================================

// Structural equality on shrink rates (P2 single authority for cost-relevant
// merge): `ConstantShrink` / `ProportionalShrink` compared via canonical `Int`
// measures from `std.computation` / `std.termination`.
fn shrink_factor_eq(a: ShrinkFactor, b: ShrinkFactor) -> Bool {
  match a {
    UnitShrink =>
      match b { UnitShrink => true, _ => false }
    ConstantShrink { steps: sa } =>
      match b {
        ConstantShrink { steps: sb } =>
          positive_descent_count(steps: sa) == positive_descent_count(steps: sb)
        _ => false
      }
    ProportionalShrink { divisor: da } =>
      match b {
        ProportionalShrink { divisor: db } =>
          proportional_divisor_to_int(d: da) == proportional_divisor_to_int(d: db)
        _ => false
      }
  }
}

// Meet: conservative merge. SubValueUnknown absorbs everything (worst case).
// PreservedValue absorbs everything except SubValueUnknown.
// For two structural relations on the **same** field/param, factors must agree
// (`shrink_factor_eq`); otherwise the merge is incomparable → SubValueUnknown.
// Different fields/params remain incomparable as before.
//
// Lattice ordering: SubValueUnknown < PreservedValue < {structural variants}

fn meet_sub_value(a: SubValueRelation, b: SubValueRelation) -> SubValueRelation {
  match a {
    SubValueUnknown => SubValueUnknown
    PreservedValue =>
      match b {
        SubValueUnknown => SubValueUnknown
        _ => PreservedValue
      }
    StrictSubValue { field: fa, factor: fac_a } =>
      match b {
        SubValueUnknown => SubValueUnknown
        PreservedValue => PreservedValue
        StrictSubValue { field: fb, factor: fac_b } =>
          if inductive_field_eq(a: fa, b: fb) {
            if shrink_factor_eq(a: fac_a, b: fac_b) {
              StrictSubValue { field: fa, factor: fac_a }
            } else { SubValueUnknown }
          } else { SubValueUnknown }
        _ => SubValueUnknown
      }
    IteratedSubValue { field: fa } =>
      match b {
        SubValueUnknown => SubValueUnknown
        PreservedValue => PreservedValue
        IteratedSubValue { field: fb } =>
          if inductive_field_eq(a: fa, b: fb) { a } else { SubValueUnknown }
        _ => SubValueUnknown
      }
    ArithmeticDescent { param: pa, factor: fac_a } =>
      match b {
        SubValueUnknown => SubValueUnknown
        PreservedValue => PreservedValue
        ArithmeticDescent { param: pb, factor: fac_b } =>
          if pa == pb {
            if shrink_factor_eq(a: fac_a, b: fac_b) {
              ArithmeticDescent { param: pa, factor: fac_a }
            } else { SubValueUnknown }
          } else { SubValueUnknown }
        _ => SubValueUnknown
      }
  }
}

// Join: optimistic merge. SubValueUnknown is identity.
// PreservedValue yields to any structural descent.
// Same field/param requires **matching** shrink factors for a commutative join;
// mismatched factors are incomparable → SubValueUnknown.

fn join_sub_value(a: SubValueRelation, b: SubValueRelation) -> SubValueRelation {
  match a {
    SubValueUnknown => b
    PreservedValue =>
      match b {
        SubValueUnknown => PreservedValue
        _ => b
      }
    StrictSubValue { field: fa, factor: fac_a } =>
      match b {
        SubValueUnknown => a
        PreservedValue => a
        StrictSubValue { field: fb, factor: fac_b } =>
          if inductive_field_eq(a: fa, b: fb) {
            if shrink_factor_eq(a: fac_a, b: fac_b) {
              StrictSubValue { field: fa, factor: fac_a }
            } else { SubValueUnknown }
          } else { SubValueUnknown }
        _ => SubValueUnknown
      }
    IteratedSubValue { field: fa } =>
      match b {
        SubValueUnknown => a
        PreservedValue => a
        IteratedSubValue { field: fb } =>
          if inductive_field_eq(a: fa, b: fb) { a } else { SubValueUnknown }
        _ => SubValueUnknown
      }
    ArithmeticDescent { param: pa, factor: fac_a } =>
      match b {
        SubValueUnknown => a
        PreservedValue => a
        ArithmeticDescent { param: pb, factor: fac_b } =>
          if pa == pb {
            if shrink_factor_eq(a: fac_a, b: fac_b) {
              ArithmeticDescent { param: pa, factor: fac_a }
            } else { SubValueUnknown }
          } else { SubValueUnknown }
        _ => SubValueUnknown
      }
  }
}

// SubValueRelation inhabits BoundedLattice:
//   meet = meet_sub_value, join = join_sub_value
//   top = PreservedValue (meet identity), bottom = SubValueUnknown
// Data declaration deferred: compiler does not yet emit generic type
// parameters for data constants (BoundedLattice<SubValueRelation>).


// =========================================================================
// SubValueRelation composition — authority for provenance threading
// =========================================================================

// Compose a provenance relation with a field access. When a binding has
// known provenance (not SubValueUnknown) and the accessed field is
// inductive (recursive), the result is StrictSubValue — a structural
// sub-value one level deeper.
//
// This is the single authority for provenance composition through field
// access, pattern destructuring, and let-binding classification.
// Consumers (inference, descent analysis) call this instead of
// fabricating StrictSubValue locally.
fn compose_sub_value(base: SubValueRelation, field: InductiveField) -> SubValueRelation {
  match base {
    SubValueUnknown => SubValueUnknown
    _ => StrictSubValue { field: field, factor: UnitShrink }
  }
}

// Compose two sub-value relations across a function call boundary.
// If the caller passes arg_rel to the callee, and the callee's output
// has callee_rel relative to that param, the composed result is the
// output's relation to the caller's recursive param.
//
// PreservedValue is the identity element (callee returns its param
// unchanged). SubValueUnknown is absorbing. Structural composed with
// structural produces StrictSubValue — descending into a child of a
// child is still descent, with the outer field as authority.
// IteratedSubValue only survives composition with PreservedValue
// (identity), because cross-composition cannot verify that the outer
// field's shape supports iteration (ListRecursion vs OptionalRecursion).
fn compose_sub_value_relations(arg_rel: SubValueRelation, callee_rel: SubValueRelation) -> SubValueRelation {
  match callee_rel {
    PreservedValue => arg_rel
    SubValueUnknown => SubValueUnknown
    StrictSubValue { field: _, factor: _ } =>
      match arg_rel {
        PreservedValue => callee_rel
        SubValueUnknown => SubValueUnknown
        StrictSubValue { field: f, factor: _ } => StrictSubValue { field: f, factor: UnitShrink }
        IteratedSubValue { field: f } => StrictSubValue { field: f, factor: UnitShrink }
        ArithmeticDescent { param: _, factor: _ } => SubValueUnknown
      }
    IteratedSubValue { field: _ } =>
      match arg_rel {
        PreservedValue => callee_rel
        SubValueUnknown => SubValueUnknown
        // Conservative: StrictSubValue, not IteratedSubValue. The outer
        // field may be OptionalRecursion (not iterable). Iteration evidence
        // is only valid at the site that observes the list, not through
        // cross-call composition.
        StrictSubValue { field: f, factor: _ } => StrictSubValue { field: f, factor: UnitShrink }
        IteratedSubValue { field: f } => StrictSubValue { field: f, factor: UnitShrink }
        ArithmeticDescent { param: _, factor: _ } => SubValueUnknown
      }
    ArithmeticDescent { param: p, factor: f } =>
      match arg_rel {
        PreservedValue => ArithmeticDescent { param: p, factor: f }
        _ => SubValueUnknown
      }
  }
}


// =========================================================================
// SubValueRelation → CallPattern
// =========================================================================

// Bridge to computation.dag's CallPattern. LOSSY for `StrictSubValue` /
// `IteratedSubValue` (drops `ShrinkFactor`, collapses into `ChildAccessorCall`).
// `ArithmeticDescent` maps shrink factors structurally — no Int round-trip.
// CX-L3 reads SubValueRelation directly and does NOT use this bridge.
// This exists only for the computation.dag integration path and will
// be retired when computation.dag accepts SubValueRelation natively.
// SubValueUnknown → none (fail-closed through the bridge).

fn sub_value_to_call_pattern(relation: SubValueRelation) -> CallPattern? {
  match relation {
    StrictSubValue { field: f, factor: _ }    => Some { value: ChildAccessorCall { accessor: f.field_name } }
    IteratedSubValue { field: f }             => Some { value: ChildAccessorCall { accessor: f.field_name } }
    ArithmeticDescent { param: p, factor: f } =>
      match f {
        ConstantShrink { steps: steps } =>
          Some { value: ArithmeticSubtractCall { steps: steps, ring_param: p } }
        ProportionalShrink { divisor: d } =>
          Some { value: ArithmeticDivideCall { divisor: d, ring_param: p } }
        UnitShrink => Some { value: ArithmeticSubtractCall { steps: OneStep, ring_param: p } }
      }
    PreservedValue                            => Some { value: SameArgumentCall }
    SubValueUnknown                           => none
  }
}


// =========================================================================
// SubValueRelation → BoundedLoweringTarget (lossless)
// =========================================================================

// Direct bridge to LoweringTarget that preserves ShrinkFactor. Unlike
// sub_value_to_call_pattern which drops factor, this function carries
// the factor through so downstream cost analysis can distinguish O(n)
// from O(log n) via ProportionalShrink.
// SubValueUnknown → none (fail-closed).

fn sub_value_to_lowering_target(relation: SubValueRelation) -> LoweringTarget? {
  match relation {
    StrictSubValue { field: f, factor: fac } =>
      Some { value: LoweringTarget {
        primitive: Descend,
        bound: tree_size_bound(param: f.field_name),
        evidence: Strict,
        factor: Some { value: fac }
      }}
    IteratedSubValue { field: f } =>
      Some { value: LoweringTarget {
        primitive: Fold,
        bound: CollectionSize { param: f.field_name },
        evidence: Strict,
        factor: none
      }}
    ArithmeticDescent { param: p, factor: fac } =>
      Some { value: LoweringTarget {
        primitive: Repeat,
        bound: ArithmeticParam { param: p },
        evidence: Strict,
        factor: Some { value: fac }
      }}
    PreservedValue =>
      Some { value: LoweringTarget {
        primitive: Repeat,
        bound: Forever,
        evidence: NonIncreasing,
        factor: none
      }}
    SubValueUnknown => none
  }
}


// =========================================================================
// PolynomialExponent — exact representation of asymptotic exponents
// =========================================================================

// Polynomial exponents in complexity bounds:
//   IntegerExpZero: O(1) in n (degree 0).
//   IntegerExpPos: O(n^k) for k ≥ 1 via `PositiveDescentAmount` (same Peano family as termination).
//   FractionExp: n^(p/r) with strictly positive Peano numerators/roots (typ. p=1).
//   LogBasedExp: n^(log_b(a)) with divisor witness b ≥ 2 and positive Peano argument a.
//
// `cost_poly` / `master_theorem` are the typed bridges from `Int` literals; invalid or
// oversized degrees fail closed (`ErrorBound` / `none`) — M9 matches `std.termination` caps.
//
// 🟢 TERMINAL coproduct at E-I exponent scope — negative roots, bases < 2, and non-positive
// log arguments are not representable as inhabitants (only via the `Int` bridges above).
//
// E-P note (api-review): exponents intentionally reuse termination Peano carriers for now;
// a later lane can swap degree/root/base slots to `std.types` bounded refinements once
// refinement lowering is uniform across consumers (same story as `std.termination`).

type PolynomialExponent
  = IntegerExpZero
  | IntegerExpPos { degree: PositiveDescentAmount }
  | FractionExp { numerator: PositiveDescentAmount, root: PositiveDescentAmount }
  | LogBasedExp { base: ProportionalDivisor, argument: PositiveDescentAmount }

fn poly_exp_degree_one() -> PolynomialExponent {
  IntegerExpPos { degree: OneStep }
}


// =========================================================================
// AtomicCost — one indivisible cost factor on a single parameter
// =========================================================================

// A cost factor tied to a single size parameter. These are the atoms
// from which composite bounds are built.
//
// 🟡 MIXED. Exponents are terminal (`PolynomialExponent`); `param: String` is the current
// symbolic size-parameter bridge (mirrors `RankingDimension` string slots).

type AtomicCost
  = PolyCost { param: String, exponent: PolynomialExponent }  // O(n^e)
  | LogCost { param: String }                                  // O(log n)


// =========================================================================
// CostBound — asymptotic bound algebra (Big-O)
// =========================================================================

// The output of structural descent analysis.  Most slots use `AtomicCost` only;
// `SumBound` is the v3 E-I pre-flight case that carries `List<CostBound>`
// (same structural pattern as `FieldValue` in substrate — indirection through
// `List`, not an extra anonymous recursive .dag connective).
//
// Kernel invariant: `SumBound` is the only `CostBound`→`CostBound` recursion — a named
// alternative-max stack (E-I), not open-ended anonymous substrate recursion like `Node` trees.
//
// CostBound is the authority for structurally-proven bounds derived from
// the induction model. complexity.dag's CostExpr/SizeExpr is a transitional
// working representation that will converge to CostBound as the sole
// cost algebra (see CX lane in ROADMAP.md).
//
// Composite bounds are represented in sum-of-products normal form:
//   O((V+E) · log V) = SumOfProductsBound { [[Poly(V,1), Log(V)], [Poly(E,1), Log(V)]] }
//
// That SOP path (and `ProductBound` / `AtomicCost`) needs no `CostBound`→`CostBound`
// self-edge; `SumBound` below is the **sole** deliberate `CostBound` self-reference
// (see kernel invariant above — not anonymous substrate recursion like `Node`).
//
// 🟡 MIXED. SOP / product shapes are structural lists of `AtomicCost`; `SumBound` stacks
// alternatives; string-named atoms inherit scaffold from `AtomicCost`; `ErrorBound` is fail-closed.

type CostBound
  = ConstantBound                                // O(1)
  | AtomicBound { cost: AtomicCost }             // O(n^k) or O(log n)
  | ProductBound { factors: List<AtomicCost> }   // O(f1 · f2 · ...)
  | SumOfProductsBound { terms: List<List<AtomicCost>> }  // O(Σ(Π fi))
  // SumBound: structural alternative stack only here; per-term terminal receipts/ledgers land with E-I consumers (lane 1+).
  // O(max terms) requires ≥1 alternative — empty `terms` is ill-formed; `sum_bound` maps that to `ErrorBound` (P3 fail-closed).
  | SumBound { terms: List<CostBound> }         // O(max terms) / structural alternative stack (E-I: List<CostBound>)
  | ForeverBound                                 // O(2^63-1) — repeat(max_int)
  | ErrorBound                                   // fail-closed: invalid/unresolvable


// =========================================================================
// Named bound constructors
// =========================================================================

// P3: empty alternative stack has no max/merge semantics — fail closed (Codex #726 schedule review).
fn sum_bound(terms: List<CostBound>) -> CostBound {
  match terms |> first {
    None => ErrorBound
    Some { value: _ } => SumBound { terms: terms }
  }
}

// E-6: minimal destructor for `SumBound` — first match arm that *observes* the self-edge
// variant so the coproduct is not constructor-only. Full dominance / cost comparison on
// `List<CostBound>` remains deferred to lane consumers; this predicate is the intake hook.
fn cost_bound_is_sum_bound(b: CostBound) -> Bool {
  match b {
    SumBound { terms: _ } => true
    ConstantBound => false
    AtomicBound { cost: _ } => false
    ProductBound { factors: _ } => false
    SumOfProductsBound { terms: _ } => false
    ForeverBound => false
    ErrorBound => false
  }
}

fn cost_constant() -> CostBound { ConstantBound }
fn cost_linear(param: String) -> CostBound { AtomicBound { cost: PolyCost { param: param, exponent: poly_exp_degree_one() } } }
fn cost_poly(param: String, degree: Int) -> CostBound {
  if degree < 0 { ErrorBound }
  else {
    if degree == 0 {
      AtomicBound { cost: PolyCost { param: param, exponent: IntegerExpZero } }
    } else {
      match positive_descent_amount_from_positive_int(k: degree) {
        Some { value: deg } =>
          AtomicBound { cost: PolyCost { param: param, exponent: IntegerExpPos { degree: deg } } }
        None => ErrorBound
      }
    }
  }
}
fn cost_root(param: String, k: Int) -> CostBound {
  if k <= 0 { ErrorBound }
  else {
    match positive_descent_amount_from_positive_int(k: k) {
      Some { value: rw } =>
        AtomicBound { cost: PolyCost { param: param, exponent: FractionExp { numerator: OneStep, root: rw } } }
      None => ErrorBound
    }
  }
}
fn cost_sqrt(param: String) -> CostBound { cost_root(param: param, k: 2) }
fn cost_cbrt(param: String) -> CostBound { cost_root(param: param, k: 3) }
fn cost_log(param: String) -> CostBound { AtomicBound { cost: LogCost { param: param } } }

fn cost_nlogn(param: String) -> CostBound {
  ProductBound { factors: [PolyCost { param: param, exponent: poly_exp_degree_one() }, LogCost { param: param }] }
}

fn cost_graph_linear(v_param: String, e_param: String) -> CostBound {
  SumOfProductsBound { terms: [
    [PolyCost { param: v_param, exponent: poly_exp_degree_one() }],
    [PolyCost { param: e_param, exponent: poly_exp_degree_one() }]
  ] }
}


// =========================================================================
// RecurrenceForm — structure of a divide-and-conquer recurrence
// =========================================================================

// T(n) = a·T(n/b) + O(n^d)
//   a: branching factor (self-calls per execution path)
//   b: division factor (each sub-problem is n/b of the original)
//   d: exponent of per-level non-recursive work (≥ 0; `master_theorem` rejects d < 0 → ErrorBound)
//
// P4 / P3 (cost-algebra boundary): `work_exponent` stays typed as `Int` while recurrence inputs
// are a bootstrap scaffold, but **`bounded_int_pow_exponent`** is the single authority gate:
// `master_theorem` and `int_pow_bounded` route raw exponents through it **before** any `b^d`
// recursion — same closed `[0, peano_literal_materialization_cap()]` as `std.termination` (M9).
// Oversized / negative → `none` / `ErrorBound` (no raw `*` on the power path; see `int_mul_checked`).
//
// 🟡 SCAFFOLD. Master-theorem input bundles a symbolic `param: String` with `Int` recurrence
// coefficients; structural parameter refs dissolve with reflected function params.

type RecurrenceForm {
  param: String
  branches: Int
  divisor: Int
  work_exponent: Int
}


// =========================================================================
// Master theorem — recurrence → CostBound
// =========================================================================

// P3: `Int` is realized as i64 in v2 — raw `*` / `+` can wrap or debug-panic.
// These helpers return `none` on overflow so `master_theorem` / `ceil_log` stay
// fail-closed (same posture as `cost_poly` / `positive_descent_amount_from_positive_int`).
// Bounds are i64::MIN / i64::MAX; `/` matches signed truncating division (Rust `Int`).

fn int_add_checked(a: Int, b: Int) -> Int? {
  if b > 0 {
    if a > 9223372036854775807 - b { none }
    else { Some { value: a + b } }
  } else {
    if b < 0 {
      if a < (0 - 9223372036854775807 - 1) - b { none }
      else { Some { value: a + b } }
    } else { Some { value: a } }
  }
}

fn int_mul_checked(a: Int, b: Int) -> Int? {
  if b == 0 { Some { value: 0 } }
  else {
    if a == 0 { Some { value: 0 } }
    else {
      if b == -1 {
        if a == (0 - 9223372036854775807 - 1) { none }
        else { Some { value: 0 - a } }
      } else {
        if b > 0 {
          if a > 0 {
            if a > 9223372036854775807 / b { none }
            else { Some { value: a * b } }
          } else {
            if a < (0 - 9223372036854775807 - 1) / b { none }
            else { Some { value: a * b } }
          }
        } else {
          if a > 0 {
            if b < (0 - 9223372036854775807 - 1) / a { none }
            else { Some { value: a * b } }
          } else {
            if b < 9223372036854775807 / a { none }
            else { Some { value: a * b } }
          }
        }
      }
    }
  }
}

// P4 / E-I (numeric boundary): sole gate from raw `Int` exponents / recurrence work degree into
// `int_pow_bounded`'s recursive core. Upper bound is `peano_literal_materialization_cap()` from
// `std.termination` (P2 single authority — Codex #726). Reject **before** any power recursion; do not
// hand `exp` to the recursive `int_pow_bounded` body until it passes here (PR #726: fail before materialization).
fn bounded_int_pow_exponent(k: Int) -> Int? {
  if k < 0 { none }
  else {
    if k > peano_literal_materialization_cap() { none }
    else { Some { value: k } }
  }
}

// b^exp for exp ≥ 0 (exp = 0 → Some { value: 1 }). Out-of-range exp → none via
// `bounded_int_pow_exponent` — no silent plausible wrong output (P3; same posture as `ceil_log` / `cost_poly`).
//
// P4 (degenerate bases): for `base ∈ {0, 1, -1}`, `int_mul_checked` may never overflow, so the
// recursive path would still walk `e` stack frames. Short-circuit those bases **before** recursion
// (Codex #726: bounded forward execution on the exported helper, not only `base ≥ 2` call sites).
fn int_pow_bounded(base: Int, exp: Int) -> Int? {
  match bounded_int_pow_exponent(k: exp) {
    None => none
    Some { value: e } =>
      if e == 0 { Some { value: 1 } }
      else {
        if base == 0 { Some { value: 0 } }
        else {
          if base == 1 { Some { value: 1 } }
          else {
            if base == (0 - 1) {
              let half = e / 2
              if half + half == e { Some { value: 1 } } else { Some { value: 0 - 1 } }
            }
            else {
              match int_pow_bounded(base: base, exp: e - 1) {
                Some { value: prev } =>
                  match int_mul_checked(a: base, b: prev) {
                    Some { value: prod } => Some { value: prod }
                    None => none
                  }
                None => none
              }
            }
          }
        }
      }
  }
}

// Smallest k with base^k >= argument. Requires base ≥ 2 and argument ≥ 1 so each
// iteration strictly increases `power` (P4 decidability); invalid inputs → none.
fn ceil_log(base: Int, argument: Int) -> Int? {
  if base < 2 || argument < 1 { none }
  else { ceil_log_iter(base: base, argument: argument, k: 0, power: 1) }
}

// Pre: base ≥ 2, argument ≥ 1. Overflow in `power * base` or `k + 1` → none.
fn ceil_log_iter(base: Int, argument: Int, k: Int, power: Int) -> Int? {
  if power >= argument { Some { value: k } }
  else {
    match int_mul_checked(a: power, b: base) {
      None => none
      Some { value: next_power } =>
        match int_add_checked(a: k, b: 1) {
          None => none
          Some { value: k1 } =>
            ceil_log_iter(base: base, argument: argument, k: k1, power: next_power)
        }
    }
  }
}

fn master_theorem(form: RecurrenceForm) -> CostBound {
  let a = form.branches
  let b = form.divisor
  let d = form.work_exponent
  let n = form.param
  // Fail-closed: invalid inputs produce ErrorBound, not fabricated O(1).
  // P4: `bounded_int_pow_exponent` rejects `work_exponent` outside [0, peano_literal_materialization_cap()] before `int_pow_bounded`.
  if a < 1 || b < 2 { ErrorBound }
  else {
    match bounded_int_pow_exponent(k: d) {
      None => ErrorBound
      Some { value: d_ok } =>
        match int_pow_bounded(base: b, exp: d_ok) {
          None => ErrorBound
          Some { value: b_to_d } =>
            if a < b_to_d {
              // Case 3: per-level work dominates → O(n^d)
              match d_ok {
                0 => ConstantBound
                _ => cost_poly(param: n, degree: d_ok)
              }
            } else {
              if a == b_to_d {
                // Case 2: balanced → O(n^d · log n)
                match d_ok {
                  0 => cost_log(param: n)
                  _ =>
                    match positive_descent_amount_from_positive_int(k: d_ok) {
                      Some { value: deg } =>
                        ProductBound { factors: [PolyCost { param: n, exponent: IntegerExpPos { degree: deg } }, LogCost { param: n }] }
                      None => ErrorBound
                    }
                }
              } else {
                // Case 1: sub-problem work dominates → O(n^(log_b(a)))
                // Exact representation via LogBasedExp — no approximation
                match proportional_divisor_from_int_at_least_two(k: b) {
                  Some { value: baseW } =>
                    match positive_descent_amount_from_positive_int(k: a) {
                      Some { value: argW } =>
                        AtomicBound { cost: PolyCost { param: n, exponent: LogBasedExp { base: baseW, argument: argW } } }
                      None => ErrorBound
                    }
                  None => ErrorBound
                }
              }
            }
        }
    }
  }
}


// =========================================================================
// Structural recursion → CostBound (catamorphism)
// =========================================================================

// Visits every sub-term exactly once. O(n^k) for k-nested traversals.

fn catamorphism_bound(param: String, nesting_depth: Int) -> CostBound {
  if nesting_depth < 0 { ErrorBound }
  else {
    if nesting_depth == 0 { ConstantBound }
    else { cost_poly(param: param, degree: nesting_depth) }
  }
}


// =========================================================================
// Combined derivation: descent facts → CostBound
// =========================================================================

// P3: align with `master_theorem` — invalid `branches` / `work_exponent` must not yield a
// plausible `cost_linear` / `ForeverBound` (OpenAI-pro #726 manual review on `derive_bound`).
fn derive_bound(param: String, branches: Int, factor: ShrinkFactor, work_exponent: Int) -> CostBound {
  if branches < 1 { ErrorBound }
  else {
    match bounded_int_pow_exponent(k: work_exponent) {
      None => ErrorBound
      Some { value: _ } =>
        match factor {
          // Structural recursion: each step removes one constructor
          UnitShrink =>
            if branches <= 1 { cost_linear(param: param) }
            else {
              // Multi-branch with unit shrink: T(n) = k·T(n-1) + O(1) = O(k^n).
              // In .dag, bounded by repeat(Forever).
              ForeverBound
            }
          // Constant shrink: similar to unit but with larger steps
          ConstantShrink { steps: _ } =>
            if branches <= 1 { cost_linear(param: param) }
            else { ForeverBound }
          // Proportional shrink: divide-and-conquer → Master theorem
          ProportionalShrink { divisor: d } =>
            master_theorem(form: RecurrenceForm { param: param, branches: branches, divisor: proportional_divisor_to_int(d: d), work_exponent: work_exponent })
        }
    }
  }
}


// =========================================================================
// Algorithm complexity specifications
// =========================================================================

// --- Structural recursion (catamorphisms) ---
// https://en.wikipedia.org/wiki/Tree_traversal

fn tree_traversal_bound() -> CostBound {
  catamorphism_bound(param: "tree", nesting_depth: 1)
}

fn nested_iteration_bound() -> CostBound {
  catamorphism_bound(param: "items", nesting_depth: 2)
}

// https://en.wikipedia.org/wiki/Fold_(higher-order_function)
fn linear_scan_bound() -> CostBound {
  catamorphism_bound(param: "xs", nesting_depth: 1)
}

// --- Divide-and-conquer (Master theorem) ---
// https://en.wikipedia.org/wiki/Divide-and-conquer_algorithm

// https://en.wikipedia.org/wiki/Binary_search
fn binary_search_bound() -> CostBound {
  derive_bound(param: "xs", branches: 1, factor: ProportionalShrink { divisor: DivideByTwo }, work_exponent: 0)
}

// https://en.wikipedia.org/wiki/Merge_sort
fn mergesort_bound() -> CostBound {
  derive_bound(param: "xs", branches: 2, factor: ProportionalShrink { divisor: DivideByTwo }, work_exponent: 1)
}

// https://en.wikipedia.org/wiki/Karatsuba_algorithm
// a=3, b=2, d=1 → O(n^(log_2(3))) ≈ O(n^1.585) — exact via LogBasedExp
fn karatsuba_bound() -> CostBound {
  derive_bound(param: "digits", branches: 3, factor: ProportionalShrink { divisor: DivideByTwo }, work_exponent: 1)
}

// https://en.wikipedia.org/wiki/Strassen_algorithm
// a=7, b=2, d=2 → O(n^(log_2(7))) ≈ O(n^2.807) — exact via LogBasedExp
fn strassen_bound() -> CostBound {
  derive_bound(param: "n", branches: 7, factor: ProportionalShrink { divisor: DivideByTwo }, work_exponent: 2)
}

// --- Root complexity ---

// https://en.wikipedia.org/wiki/Trial_division
fn trial_division_bound() -> CostBound { cost_sqrt(param: "n") }
fn cube_root_bound() -> CostBound { cost_cbrt(param: "n") }
// https://en.wikipedia.org/wiki/Nth_root
fn kth_root_bound(k: Int) -> CostBound { cost_root(param: "n", k: k) }

// --- Graph algorithms (multi-parameter) ---
// https://en.wikipedia.org/wiki/Graph_traversal

// https://en.wikipedia.org/wiki/Breadth-first_search
// https://en.wikipedia.org/wiki/Depth-first_search
fn bfs_dfs_bound() -> CostBound {
  cost_graph_linear(v_param: "V", e_param: "E")
}

// https://en.wikipedia.org/wiki/Dijkstra%27s_algorithm
fn dijkstra_bound() -> CostBound {
  // O((V+E) · log V) in sum-of-products: O(V·log V + E·log V)
  SumOfProductsBound { terms: [
    [PolyCost { param: "V", exponent: poly_exp_degree_one() }, LogCost { param: "V" }],
    [PolyCost { param: "E", exponent: poly_exp_degree_one() }, LogCost { param: "V" }]
  ] }
}

// https://en.wikipedia.org/wiki/Bellman%E2%80%93Ford_algorithm
fn bellman_ford_bound() -> CostBound {
  ProductBound { factors: [
    PolyCost { param: "V", exponent: poly_exp_degree_one() },
    PolyCost { param: "E", exponent: poly_exp_degree_one() }
  ] }
}

// https://en.wikipedia.org/wiki/Floyd%E2%80%93Warshall_algorithm
fn floyd_warshall_bound() -> CostBound {
  cost_poly(param: "V", degree: 3)
}


// Cost ordering is intentionally not provided here.
// A correct dominance relation on CostBound requires structural comparison
// (e.g., ConstantBound < AtomicBound(LogCost) < AtomicBound(PolyCost(n^1))),
// not a lossy Int surrogate. When the bridge (Phase 1) needs cost comparison,
// it should pattern-match on the CostBound variants directly.
