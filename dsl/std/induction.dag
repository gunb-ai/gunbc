// std/induction.dag -- Inductive type structure and structural recursion.
//
// Every .dag type with recursive fields is an inductive type. Its
// structure contains all the information needed for termination proofs
// and complexity bounds. This file models the type-level facts from
// which complexity analysis is DERIVED — no heuristic pattern-matching,
// no hand-maintained accessor tables.
//
// EXTERNAL AUTHORITY:
//   - Initial algebras of endofunctors: Lambek (1968)
//     An inductive type is the initial algebra of its signature functor.
//     The type definition IS the functor; the constructors are the algebra.
//   - Catamorphisms: Meijer, Fokkinga, Paterson (1991) "Bananas" paper
//     Every initial algebra has a unique fold (catamorphism). A function
//     that recurses only on sub-terms of its inductive argument IS a
//     catamorphism. Termination is guaranteed by well-foundedness.
//   - Size-change termination: Lee, Jones, Ben-Amram (2001)
//     Termination is decidable when each call either strictly decreases
//     or preserves a well-founded measure. SubValueRelation models the
//     size-change graph edges.
//   - Well-founded induction: Floyd (1967), Turing (1949)
//     Every inductive type has a natural well-founded ordering: the
//     sub-term relation. The size measure (constructor count) maps to ℕ.
//   - Master theorem: Bentley, Haken, Saxe (1980); CLRS Theorem 4.1
//     For recurrences T(n) = a·T(n/b) + O(n^d), the asymptotic bound
//     is determined by comparing log_b(a) with d.
//   - Asymptotic notation: Knuth (1976) "Big Omicron and big Omega"
//     O(f(n)) denotes the class of functions bounded above by c·f(n)
//     for sufficiently large n.
//
// RELATIONSHIP TO std/termination.dag:
//   termination.dag defines DescentEvidence and RankingDimension as
//   abstract proof components. This file defines the TYPE-LEVEL facts
//   that PRODUCE ranking dimensions and descent evidence. A
//   RankingDimension is a consequence of an InductiveField; a
//   DescentEvidence is a consequence of a SubValueRelation.
//
// RELATIONSHIP TO std/computation.dag:
//   computation.dag defines CallPattern → LoweringTarget. This file's
//   SubValueRelation produces the CallPattern for a self-call.
//
// RELATIONSHIP TO std/iteration.dag:
//   iteration.dag defines descend (tree catamorphism) and fold (list
//   catamorphism). This file proves WHICH recursive functions are
//   catamorphisms — i.e., which functions structurally recurse on
//   sub-terms of an inductive type.
//
// DESIGN PRINCIPLE (P1 from cx-design.md):
//   Descent is a TYPE-LEVEL fact. The type definition `children: List<Node>`
//   IS the descent fact. The complexity analyzer should never need to know
//   about specific accessor functions. It reads from the type that certain
//   fields carry recursive sub-structure.

module std.induction

import std.termination {
  DescentEvidence, Strict, NonIncreasing,
  RankingDimension, TreeSize
}
import std.computation {
  CallPattern, ChildAccessorCall, FoldBodyCall, SameArgumentCall
}


// =========================================================================
// RecursionShape — how a field references its parent type
// =========================================================================

// The .dag type system has three ways a field can reference its parent
// type. These correspond to positions in the signature functor of the
// initial algebra (Lambek 1968):
//
//   DirectRecursion:   F(X) = ... × X × ...
//     The field type IS the parent type.
//     Example: type MyList<T> = Cons { tail: MyList<T> }
//
//   ListRecursion:     F(X) = ... × List(X) × ...
//     The field is a list of the parent type (free monoid functor).
//     Example: type Node { children: List<Node> }
//
//   OptionalRecursion: F(X) = ... × (1 + X) × ...
//     The field is an optional parent type (maybe functor).
//     Example: type Node { body: Node? }
//
// These three forms exhaust the recursive positions possible in .dag.
// Adding a new container type to the language (e.g., Set<T>) would add
// one variant here.

type RecursionShape
  = DirectRecursion       // field_type == parent_type
  | ListRecursion         // field_type == List<parent_type>
  | OptionalRecursion     // field_type == parent_type?


// =========================================================================
// InductiveField — one recursive position in a type definition
// =========================================================================

// An InductiveField is one position in the signature functor of an
// inductive type. It records:
//   - WHICH type is inductive (type_name)
//   - WHICH constructor contains the recursion (variant_name, "" for records)
//   - WHICH field carries the recursive reference (field_name)
//   - HOW the reference is wrapped (shape)
//
// For type Node { children: List<Node>, body: Node?, name: String }:
//   InductiveField { type_name: "Node", variant_name: "", field_name: "children", shape: ListRecursion }
//   InductiveField { type_name: "Node", variant_name: "", field_name: "body", shape: OptionalRecursion }
//   (name: String produces no InductiveField — it's not recursive)
//
// For type MyList<T> = Nil | Cons { head: T, tail: MyList<T> }:
//   InductiveField { type_name: "MyList", variant_name: "Cons", field_name: "tail", shape: DirectRecursion }
//   (Nil produces no InductiveField — it's a base case)
//   (head: T produces no InductiveField — T is a type parameter, not the parent type)
//
// This extends RecursiveVariantFieldWitness (04_env.dag) with the shape
// classification. The existing witness captures variant_name and field_name;
// InductiveField adds the structural information needed to derive a
// RankingDimension.

type InductiveField {
  type_name: String
  variant_name: String
  field_name: String
  shape: RecursionShape
}


// =========================================================================
// InductiveField → RankingDimension (size measure derivation)
// =========================================================================

// Every inductive type has a natural size measure: the number of
// constructors in a value. This is the unique homomorphism from the
// initial algebra to (ℕ, +, 0) — the "catamorphism to size."
//
// All three recursion shapes produce TreeSize because they all measure
// structural depth:
//   - DirectRecursion: sub-term has strictly fewer constructors
//   - ListRecursion: each list element is a strict sub-tree
//   - OptionalRecursion: inner value (when present) is a strict sub-tree
//
// ListLength is a DIFFERENT dimension — it measures a list parameter
// shrinking (skip/tail), not tree descent through recursive fields.

fn inductive_field_to_dimension(field: InductiveField, param: String) -> RankingDimension {
  TreeSize { param: param }
}


// =========================================================================
// SubValueRelation — call-site descent evidence
// =========================================================================

// At each self-call site in a recursive function, each argument either:
//   - Is obtained by deconstructing the parameter through a recursive
//     field (StrictSubValue) — provably smaller by the sub-term relation
//   - Is an element from iterating over a list-recursive field
//     (IteratedSubValue) — each element is a strict sub-tree
//   - Cannot be proven smaller (PreservedValue) — no descent evidence
//
// These are edges in the size-change graph (Lee, Jones, Ben-Amram 2001).
// The size-change principle: if every infinite call sequence would
// require an infinite descent on a well-founded ordering, the program
// terminates.
//
// The pipeline produces SubValueRelation values at self-call sites.
// The analyzer reads them — it never pattern-matches AST to derive them.

type SubValueRelation
  = StrictSubValue { field: InductiveField, factor: ShrinkFactor }
  | IteratedSubValue { field: InductiveField }  // element from fold/map over recursive list field
  | PreservedValue                              // no descent proven


// =========================================================================
// SubValueRelation → DescentEvidence (bridge to termination.dag)
// =========================================================================

fn sub_value_to_evidence(relation: SubValueRelation) -> DescentEvidence {
  match relation {
    StrictSubValue { field: _, factor: _ } => Strict
    IteratedSubValue { field: _ }          => Strict   // each element is a strict sub-tree
    PreservedValue                         => NonIncreasing
  }
}


// =========================================================================
// SubValueRelation → CallPattern (bridge to computation.dag)
// =========================================================================

fn sub_value_to_call_pattern(relation: SubValueRelation) -> CallPattern {
  match relation {
    StrictSubValue { field: _, factor: _ } => ChildAccessorCall { accessor: "structural" }
    IteratedSubValue { field: _ }          => FoldBodyCall
    PreservedValue                         => SameArgumentCall
  }
}


// =========================================================================
// ShrinkFactor — rate of decrease per recursive step
// =========================================================================

// SubValueRelation says WHETHER an argument decreases. ShrinkFactor says
// BY HOW MUCH. This is the quantitative dimension that distinguishes
// O(n) from O(log n).
//
// The three forms correspond to different well-founded orderings on ℕ:
//   UnitShrink:         n → n-1 → n-2 → ... → 0       (O(n) steps)
//   ConstantShrink:     n → n-k → n-2k → ... → 0      (O(n/k) = O(n) steps)
//   ProportionalShrink: n → n/d → n/d² → ... → 1      (O(log_d(n)) steps)
//
// These emerge from how the sub-value is obtained:
//   - Structural field projection: UnitShrink (one constructor removed)
//   - skip(k): ConstantShrink { k }
//   - take(n/2), split-in-half: ProportionalShrink { divisor: 2 }
//
// MATHEMATICAL GROUNDING:
//   The number of steps to reach the base case under each ordering:
//   - UnitShrink: |{n, n-1, ..., 1}| = n
//   - ConstantShrink(k): |{n, n-k, ..., r}| = ⌈n/k⌉
//   - ProportionalShrink(d): |{n, n/d, n/d², ..., 1}| = ⌈log_d(n)⌉

type ShrinkFactor
  = UnitShrink                          // decrease by 1 per step
  | ConstantShrink { amount: Int }      // decrease by constant k per step
  | ProportionalShrink { divisor: Int } // decrease by factor d per step


// =========================================================================
// Rational — exact fractional exponents
// =========================================================================

// Rational numbers for polynomial exponents. Enables O(n^(1/3)), O(n^(3/2)),
// O(n^(log_2(7))) ≈ O(n^(2807/1000)), etc.
//
// Invariant: denominator > 0. Reduced form not required — { p: 2, q: 4 }
// and { p: 1, q: 2 } are both valid representations of 1/2.

type Rational { p: Int, q: Int }

fn rational(p: Int, q: Int) -> Rational { Rational { p: p, q: q } }
fn integer(n: Int) -> Rational { Rational { p: n, q: 1 } }

// Compare two rationals: a/b vs c/d ↔ a*d vs c*b (when b,d > 0)
fn rational_less(a: Rational, b: Rational) -> Bool { a.p * b.q < b.p * a.q }
fn rational_equal(a: Rational, b: Rational) -> Bool { a.p * b.q == b.p * a.q }


// =========================================================================
// CostTerm — compositional asymptotic bound (Big-O)
// =========================================================================

// The output of complexity analysis: the asymptotic growth rate of a
// function's cost as a function of input size parameters.
//
// Knuth (1976): f(n) = O(g(n)) iff ∃c,n₀ : ∀n≥n₀ : f(n) ≤ c·g(n)
//
// CostTerm is a term algebra for asymptotic bounds. It supports:
//   - Single-parameter polynomial: O(n^(p/q)) for any rational p/q
//   - Logarithmic: O(log n)
//   - Products: O(f · g) — e.g., O(n log n), O((V+E) log V)
//   - Sums: O(f + g) — e.g., O(V + E) (multi-parameter)
//   - Composed: arbitrary combinations of the above
//
// MATHEMATICAL GROUNDING:
//   CostTerm forms a commutative semiring under (Sum, Product) with
//   identity elements (CostOne for Product, CostOne for Sum since
//   O(1 + f) = O(f)). This is a sub-algebra of the tropical semiring
//   (max, +) used in asymptotic analysis.
//
// WHY COMPOSITIONAL (not an enum of named classes):
//   An enumerated AsymptoticBound (Constant | Linear | Quadratic | ...)
//   can't express O(n^(1/3)), O(V+E), O(n^(log_2(7))), or O((V+E)·log V).
//   The compositional structure lets any bound emerge from the algebra.
//   Named classes (O(n log n), O(n²)) are derived by simplification,
//   not by enumeration.
//
// Every .dag program is bounded (decidability invariant). Exponential
// is unreachable — .dag has no unbounded branching. BoundedForever
// (2^63-1 iterations) is the maximum for explicit repeat() loops.

type CostTerm
  = CostOne                                     // O(1) — constant
  | CostPoly { param: String, exponent: Rational }  // O(n^(p/q))
  | CostLog { param: String }                   // O(log n) — base irrelevant (constant factor)
  | CostProduct { factors: List<CostTerm> }     // O(f₁ · f₂ · ... · fₖ)
  | CostSum { terms: List<CostTerm> }           // O(f₁ + f₂ + ... + fₖ) = O(max(f₁,...,fₖ))
  | CostForever                                 // O(2^63-1) — repeat(max_int)


// =========================================================================
// Named bound constructors — convenience for common classes
// =========================================================================

fn cost_constant() -> CostTerm { CostOne }
fn cost_linear(param: String) -> CostTerm { CostPoly { param: param, exponent: integer(n: 1) } }
fn cost_quadratic(param: String) -> CostTerm { CostPoly { param: param, exponent: integer(n: 2) } }
fn cost_root(param: String, k: Int) -> CostTerm { CostPoly { param: param, exponent: rational(p: 1, q: k) } }
fn cost_sqrt(param: String) -> CostTerm { cost_root(param: param, k: 2) }
fn cost_cbrt(param: String) -> CostTerm { cost_root(param: param, k: 3) }
fn cost_log(param: String) -> CostTerm { CostLog { param: param } }
fn cost_nlogn(param: String) -> CostTerm { CostProduct { factors: [cost_linear(param: param), cost_log(param: param)] } }
fn cost_poly(param: String, degree: Int) -> CostTerm { CostPoly { param: param, exponent: integer(n: degree) } }

// Multi-parameter: O(V + E) for graph algorithms
fn cost_graph_linear(v_param: String, e_param: String) -> CostTerm {
  CostSum { terms: [cost_linear(param: v_param), cost_linear(param: e_param)] }
}


// =========================================================================
// RecurrenceForm — structure of a divide-and-conquer recurrence
// =========================================================================

// A RecurrenceForm captures the structure T(n) = a·T(n/b) + O(n^d)
// that arises from divide-and-conquer algorithms.
//
// Parameters (Bentley, Haken, Saxe 1980):
//   a: branching factor — number of recursive sub-problems
//   b: division factor — each sub-problem is n/b of the original
//   d: exponent of per-level work — non-recursive cost is O(n^d)
//
// Examples:
//   Binary search:   a=1, b=2, d=0 → O(log n)
//   Mergesort:       a=2, b=2, d=1 → O(n log n)
//   Karatsuba mult:  a=3, b=2, d=1 → O(n^1.585)
//   Strassen matrix: a=7, b=2, d=2 → O(n^2.807)
//   Tree traversal:  NOT a recurrence — it's a catamorphism (all children)

type RecurrenceForm {
  param: String    // the size parameter name
  branches: Int    // a: number of self-calls per execution path
  divisor: Int     // b: input size divided by this at each level
  work_exponent: Int  // d: per-level non-recursive cost exponent
}


// =========================================================================
// Master theorem — recurrence → CostTerm
// =========================================================================

// CLRS Theorem 4.1 (Master theorem for divide-and-conquer recurrences):
//
//   T(n) = a·T(n/b) + Θ(n^d)
//
//   Case 1: d < log_b(a) → T(n) = Θ(n^(log_b(a)))
//     Sub-problem work dominates.
//     Example: Strassen (a=7, b=2, d=2): log_2(7)≈2.81 > 2 → O(n^2.81)
//     Example: Karatsuba (a=3, b=2, d=1): log_2(3)≈1.585 > 1 → O(n^1.585)
//
//   Case 2: d = log_b(a) → T(n) = Θ(n^d · log n)
//     Sub-problem and per-level work balance.
//     Example: Mergesort (a=2, b=2, d=1): log_2(2)=1 → O(n log n)
//
//   Case 3: d > log_b(a) → T(n) = Θ(n^d)
//     Per-level work dominates.
//     Example: Binary search (a=1, b=2, d=0): log_2(1)=0 → O(log n)
//
// The comparison uses integer arithmetic: compare a vs b^d.
//   a < b^d → Case 3
//   a = b^d → Case 2
//   a > b^d → Case 1

fn int_pow(base: Int, exp: Int) -> Int {
  if exp == 0 { 1 }
  else {
    let prev = int_pow(base: base, exp: exp - 1)
    base * prev
  }
}

fn master_theorem(form: RecurrenceForm) -> CostTerm {
  let n = form.param
  let a = form.branches
  let b = form.divisor
  let d = form.work_exponent
  if a < 1 || b < 2 { CostOne }
  else {
    let b_to_d = int_pow(base: b, exp: d)
    if a < b_to_d {
      // Case 3: per-level work dominates → O(n^d)
      match d {
        0 => CostOne
        _ => cost_poly(param: n, degree: d)
      }
    } else {
      if a == b_to_d {
        // Case 2: balanced → O(n^d · log n)
        match d {
          0 => cost_log(param: n)
          _ => CostProduct { factors: [cost_poly(param: n, degree: d), cost_log(param: n)] }
        }
      } else {
        // Case 1: sub-problem work dominates → O(n^(log_b(a)))
        // log_b(a) is generally irrational. We can't compute it exactly
        // with integers, but we CAN represent it structurally: the
        // exponent IS log_b(a), which we approximate as the rational
        // ceiling. For common cases:
        //   a=3, b=2 → log_2(3) ≈ 1585/1000 (Karatsuba)
        //   a=7, b=2 → log_2(7) ≈ 2807/1000 (Strassen)
        // Conservative: use d+1 as integer upper bound.
        CostPoly { param: n, exponent: integer(n: d + 1) }
      }
    }
  }
}


// =========================================================================
// Structural recursion → CostTerm (catamorphism)
// =========================================================================

// Structural recursion (catamorphism) visits every sub-term exactly once.
// O(n) for single traversal, O(n^k) for k-nested traversals.
// NOT a divide-and-conquer recurrence — processes ALL children.

fn catamorphism_bound(param: String, nesting_depth: Int) -> CostTerm {
  match nesting_depth {
    0 => CostOne
    _ => cost_poly(param: param, degree: nesting_depth)
  }
}


// =========================================================================
// ShrinkFactor → step count
// =========================================================================

fn shrink_to_steps(param: String, factor: ShrinkFactor) -> CostTerm {
  match factor {
    UnitShrink                        => cost_linear(param: param)
    ConstantShrink { amount: _ }      => cost_linear(param: param)
    ProportionalShrink { divisor: _ } => cost_log(param: param)
  }
}


// =========================================================================
// Combined derivation: descent facts → cost term
// =========================================================================

fn derive_bound(param: String, branches: Int, factor: ShrinkFactor, work_exponent: Int) -> CostTerm {
  match factor {
    UnitShrink =>
      catamorphism_bound(param: param, nesting_depth: 1)
    ConstantShrink { amount: _ } =>
      catamorphism_bound(param: param, nesting_depth: 1)
    ProportionalShrink { divisor: d } =>
      master_theorem(form: RecurrenceForm { param: param, branches: branches, divisor: d, work_exponent: work_exponent })
  }
}


// =========================================================================
// Algorithm complexity specifications
// =========================================================================

// Each function derives the expected complexity for a known algorithm
// from its structural facts. These serve as verification targets:
// when the pipeline integration lands, the automatically derived bound
// should match.

// --- Structural recursion (catamorphisms) ---

// Tree traversal: visit every node. O(n).
fn tree_traversal_bound() -> CostTerm {
  catamorphism_bound(param: "tree", nesting_depth: 1)
}

// Nested iteration: items |> map(item => items |> filter(...)). O(n²).
fn nested_iteration_bound() -> CostTerm {
  catamorphism_bound(param: "items", nesting_depth: 2)
}

// Linear scan: single fold. O(n).
fn linear_scan_bound() -> CostTerm {
  catamorphism_bound(param: "xs", nesting_depth: 1)
}

// --- Divide-and-conquer (Master theorem) ---

// Binary search: 1 branch, halving, O(1) work. O(log n).
fn binary_search_bound() -> CostTerm {
  derive_bound(param: "xs", branches: 1, factor: ProportionalShrink { divisor: 2 }, work_exponent: 0)
}

// Mergesort: 2 branches, halving, O(n) merge. O(n log n).
fn mergesort_bound() -> CostTerm {
  derive_bound(param: "xs", branches: 2, factor: ProportionalShrink { divisor: 2 }, work_exponent: 1)
}

// Karatsuba multiplication: 3 branches, halving, O(n) work. O(n^1.585).
// (Conservative: reported as O(n²) due to integer ceiling of log_2(3))
fn karatsuba_bound() -> CostTerm {
  derive_bound(param: "digits", branches: 3, factor: ProportionalShrink { divisor: 2 }, work_exponent: 1)
}

// --- Root complexity ---

// Trial division primality: loop d from 2 to √n. O(√n).
fn trial_division_bound() -> CostTerm {
  cost_sqrt(param: "n")
}

// Cube-root bounded iteration. O(∛n).
fn cube_root_bound() -> CostTerm {
  cost_cbrt(param: "n")
}

// k-th root bounded iteration. O(n^(1/k)).
fn kth_root_bound(k: Int) -> CostTerm {
  cost_root(param: "n", k: k)
}

// --- Graph algorithms (multi-parameter) ---

// BFS / DFS: visit every vertex and edge once. O(V + E).
fn bfs_dfs_bound() -> CostTerm {
  cost_graph_linear(v_param: "V", e_param: "E")
}

// Dijkstra with binary heap: O((V + E) · log V).
fn dijkstra_bound() -> CostTerm {
  CostProduct { factors: [
    cost_graph_linear(v_param: "V", e_param: "E"),
    cost_log(param: "V")
  ] }
}

// Bellman-Ford: relax all edges V-1 times. O(V · E).
fn bellman_ford_bound() -> CostTerm {
  CostProduct { factors: [
    cost_linear(param: "V"),
    cost_linear(param: "E")
  ] }
}

// Floyd-Warshall: triple-nested over vertices. O(V³).
fn floyd_warshall_bound() -> CostTerm {
  cost_poly(param: "V", degree: 3)
}
