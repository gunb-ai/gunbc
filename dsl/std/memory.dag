// std/memory.dag — DRAM population projections over a vendor-agnostic catalog row.
//
// std/memory owns only the general DRAM concept; per-vendor catalog data lives in
// extdeps/memory/<vendor>. A populated row carries its own catalog module, so this
// module never dispatches on an owned SKU set and never imports a vendor catalog.

module std.memory

import std.measure { ByteSize, byte_size, byte_size_count }
import std.memory.types { HostMemoryPopulation, MemoryPopulationRow }
import std.types { Int }

// nominal bytes for one populated row = per-module capacity × stick count.
fn memory_population_row_bytes(row: MemoryPopulationRow) -> ByteSize {
  byte_size(
    byte_size_count(row.module.capacity_bytes) * row.stick_count,
  )
}

fn host_memory_population_nominal_bytes(pop: HostMemoryPopulation) -> ByteSize {
  byte_size(
    pop.rows
      |> fold(
        init: 0,
        f: (acc, row) => acc + byte_size_count(memory_population_row_bytes(row)),
      ),
  )
}
