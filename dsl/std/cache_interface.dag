// --- §1.7 projection + view helpers ------------------------------------------

fn cache_store_view(facts: CacheInterfaceFacts) -> CacheStoreView {
  CacheStoreView { facts: facts }
}

fn cache_key_projection<T>(
  artifact: ArtifactIdentity<T>,
  backend: CacheInterfaceFacts,
) -> CacheKeyProjection<T> {
  CacheKeyProjection {
    artifact: artifact
    backend: backend
    transport: cache_key_projection_transport(backend: backend),
  }
}

fn cache_key_projection_transport(backend: CacheInterfaceFacts) -> BackendCacheKey {
  BackendCacheKey {
    store: backend.identity
    key: cache_key_projection_provider_key(backend: backend),
  }
}

fn cache_key_projection_provider_key(backend: CacheInterfaceFacts) -> ProviderKey {
  match backend.key_derivation.classification {
    ContentAddressedByValue => CasContentDigest { digest: "content-addressed-projection-stub" }
    HandAuthoredString => OpaqueStringKey { key: "hand-authored-projection-stub" }
    NativeInternalHash => SccacheInternalHash { digest: "native-internal-projection-stub" }
  }
}
