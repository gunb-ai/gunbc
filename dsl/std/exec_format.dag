// std/exec_format.dag — format-agnostic executable vocabulary for the §10 execution-contract layer.
//
// Scope: LoadSegment, EntryPoint, Relocation — shared carriers before per-format extdeps
// (ELF/PE/Mach-O) inhabit ExecutableFormat. Slice 1: ELF x86-64 subset only.
// Anchor: per-format spec URLs live in extdeps/formats/* (gABI, PE/COFF, Mach-O loader.h).
//
// Uses Int / Bool / List / records / enums — no distribution-enum imports (v2-green standalone).

module std.exec_format

import std.types { Bool, NonEmptyStr }

// Format identity as a cited fact-bundle (Slice 1: family name only; per-format rows in extdeps).
type ExecutableFormat {
  family: NonEmptyStr
}

type SegmentPermission {
  readable: Bool
  writable: Bool
  executable: Bool
}

// Loadable segment — maps to PT_LOAD (and cognates in other formats in later slices).
type LoadSegment {
  file_offset: Int
  virtual_address: Int
  file_size: Int
  memory_size: Int
  permissions: SegmentPermission
  alignment: Int
}

type EntryPoint {
  virtual_address: Int
}

// Relocation record — format-agnostic carrier; ELF-specific typing lives in extdeps/formats/elf.
type Relocation {
  offset: Int
  symbol_index: Int
  relocation_type: Int
}
