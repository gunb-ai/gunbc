// std.methods — minimal method-declaration registry.
//
// 🟡 TRANSITIONAL. Today's methods (`count`, `join`, `split`, `length`,
// …) are STRING fields inside per-profile `AlgebraFieldTemplate`
// records in `dsl/std/algebra.dag`, not standalone declarations
// `DeclarationRef` can target. This registry elevates the unique
// method-name set into top-level `data` bindings so
// `MethodTemplateContract.dag_method: MethodRef` (refined from bare
// `DeclarationRef` per #1175 substrate gap) has a real authority
// target.
//
// Scope (Director-locked option A on parent inbox #1130; target-only
// classification opened on the same inbox per #1549 Gap 1 / R3 dispatch):
//   - Full union of unique method names across the seven
//     `dsl/std/algebra.dag` per-profile template lists
//     (`ordered_ring_templates`, `approximate_field_templates`,
//     `boolean_algebra_templates`, `boolean_algebra_collection_templates`,
//     `free_monoid_scalar_templates`, `free_monoid_collection_templates`,
//     `partial_function_templates`). 64 names from algebra. The registry
//     IS the closed-system namespace authority for every
//     algebra-template method name; not a demand-shaped subset for the
//     first Grounding consumer.
//   - Legacy v2 emit-map aliases. v2's emit pipeline keys
//     `dsl/extdeps/languages/{python,go}/emit.dag` by bare method-name
//     string. When two algebra profiles inhabit the same name with
//     different render shapes, v2 disambiguates by minting a separate
//     legacy key (e.g. `string_contains` vs `contains`). The algebra
//     authority itself does NOT split: `dsl/std/algebra.dag` declares
//     `contains` once on `free_monoid_scalar_templates` (String
//     substring test) and once on `*_collection_templates` /
//     `boolean_algebra_*` (element/key membership) under the same
//     method name; the algebra-profile coordinate carries the
//     disambiguation. To give the legacy aliases a `MethodRef` row key
//     until v2 retires its bare-string lookup, those aliases live
//     here as additional `MethodDeclaration` bindings. `string_contains`
//     (rendered as `{arg} in {recv}` / `strings.Contains({recv}, {arg})`)
//     is the first such entry. Dissolution trigger: when v2 emit
//     migrates to algebra-profile-keyed method dispatch (PB projection
//     scope, #1549 audit Recommendations §3-§4 / R3 Method-template
//     consumer migration debt row), legacy alias bindings collapse
//     back into algebra-typed `contains` dispatch and these entries
//     can be deleted alongside the per-target legacy emit maps.
//   - Flat name-only namespace (Director-locked option A on Q2):
//     `join` / `length` / `contains` / `map` / `fold` / etc. each
//     appear once, regardless of how many algebra profiles inhabit
//     them. Algebra/profile-specific semantics stay in the existing
//     `AlgebraFieldTemplate` records and the §6a `MethodContract`
//     `(algebra_id, method_id)` cost/complexity coordinate; method
//     identity is not owning-algebra identity.
//   - Identity-only: each `MethodDeclaration` carries `name: String`
//     and nothing else. No parameter lists, return types, size
//     effects, cost shapes, profile fields, or render-template facts.
//     Those live in `AlgebraFieldTemplate` (signature/cost) and
//     per-target extdeps tables (templates).
//
// Dissolution: when method declarations grow first-class signature/
// cost fields and the `AlgebraFieldTemplate` string-name pattern
// retires, this registry's String-name field can refine to a typed
// namespace identifier and the per-method `data` bindings can absorb
// the per-method facts the templates currently carry.
//
// Drift trigger: a new method name added to any algebra template
// list in `dsl/std/algebra.dag` MUST also land here as a new
// `data <name>_method: MethodDeclaration` binding. The acceptance
// test `method_registry_covers_all_algebra_template_names` enforces
// this fail-closed by enumerating unique names and asserting each
// resolves to a `MethodDeclaration` decl in the bootstrap Dag.

module std.methods

// 🟡 TRANSITIONAL. Identity-only method-name carrier. The decl name
// is a `String` today; refines to a typed namespace identifier
// (`KindName`-style) once the substrate exposes namespace-typed
// declaration ids. See module docs above for dissolution path.
//
// Layering note: this file lives at `dsl/std/methods.dag` and keeps
// its method-name carrier identity-only (`name: String`) rather than
// carrying a heavier typed declaration reference, so the dsl-only std
// tree stays free of spec-pipeline imports. The typed
// `MethodRef { decl: DeclarationRef }` reference shape is not modeled
// here for that reason.
type MethodDeclaration {
  name: String
}

// ---------------------------------------------------------------------------
// Method-name registry. One `data` binding per unique method name carried by
// the seven per-profile algebra template lists in `dsl/std/algebra.dag`.
// Sorted alphabetically. Each binding is a `MethodDeclaration`
// with the `name` field matching the string used in algebra templates.
// ---------------------------------------------------------------------------

data add_method: MethodDeclaration = { name: "add" }
data all_method: MethodDeclaration = { name: "all" }
data any_method: MethodDeclaration = { name: "any" }
data append_method: MethodDeclaration = { name: "append" }
data bottom_method: MethodDeclaration = { name: "bottom" }
data chars_method: MethodDeclaration = { name: "chars" }
data clamp_method: MethodDeclaration = { name: "clamp" }
data compare_method: MethodDeclaration = { name: "compare" }
data complement_method: MethodDeclaration = { name: "complement" }
data concat_method: MethodDeclaration = { name: "concat" }
data contains_method: MethodDeclaration = { name: "contains" }
data count_method: MethodDeclaration = { name: "count" }
data diff_method: MethodDeclaration = { name: "diff" }
data empty_method: MethodDeclaration = { name: "empty" }
data ends_with_method: MethodDeclaration = { name: "ends_with" }
data enumerate_method: MethodDeclaration = { name: "enumerate" }
data filter_method: MethodDeclaration = { name: "filter" }
data first_method: MethodDeclaration = { name: "first" }
data flat_map_method: MethodDeclaration = { name: "flat_map" }
data fold_method: MethodDeclaration = { name: "fold" }
data get_method: MethodDeclaration = { name: "get" }
data has_method: MethodDeclaration = { name: "has" }
data intersect_method: MethodDeclaration = { name: "intersect" }
data is_empty_method: MethodDeclaration = { name: "is_empty" }
data join_method: MethodDeclaration = { name: "join" }
data keys_method: MethodDeclaration = { name: "keys" }
data last_method: MethodDeclaration = { name: "last" }
data length_method: MethodDeclaration = { name: "length" }
data list_push_method: MethodDeclaration = { name: "list_push" }
data lookup_method: MethodDeclaration = { name: "lookup" }
data map_method: MethodDeclaration = { name: "map" }
data map_contains_key_method: MethodDeclaration = { name: "map_contains_key" }
data map_get_method: MethodDeclaration = { name: "map_get" }
data map_has_method: MethodDeclaration = { name: "map_has" }
data map_insert_method: MethodDeclaration = { name: "map_insert" }
data map_keys_method: MethodDeclaration = { name: "map_keys" }
data map_merge_method: MethodDeclaration = { name: "map_merge" }
data map_values_method: MethodDeclaration = { name: "map_values" }
data meet_method: MethodDeclaration = { name: "meet" }
data member_method: MethodDeclaration = { name: "member" }
data mul_method: MethodDeclaration = { name: "mul" }
data negate_method: MethodDeclaration = { name: "negate" }
data one_method: MethodDeclaration = { name: "one" }
data reciprocal_method: MethodDeclaration = { name: "reciprocal" }
data replace_method: MethodDeclaration = { name: "replace" }
data reverse_method: MethodDeclaration = { name: "reverse" }
data skip_method: MethodDeclaration = { name: "skip" }
data sort_by_method: MethodDeclaration = { name: "sort_by" }
data split_method: MethodDeclaration = { name: "split" }
data starts_with_method: MethodDeclaration = { name: "starts_with" }
data string_contains_method: MethodDeclaration = { name: "string_contains" }
data substring_method: MethodDeclaration = { name: "substring" }
data take_method: MethodDeclaration = { name: "take" }
data to_int_method: MethodDeclaration = { name: "to_int" }
data to_lower_method: MethodDeclaration = { name: "to_lower" }
data to_string_method: MethodDeclaration = { name: "to_string" }
data to_upper_method: MethodDeclaration = { name: "to_upper" }
data top_method: MethodDeclaration = { name: "top" }
data trim_method: MethodDeclaration = { name: "trim" }
data union_method: MethodDeclaration = { name: "union" }
data values_method: MethodDeclaration = { name: "values" }
data with_method: MethodDeclaration = { name: "with" }
data zero_method: MethodDeclaration = { name: "zero" }
