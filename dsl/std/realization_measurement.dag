// std/realization_measurement.dag — Measured-cost model (Phase-0 keystone, v2-inheritable).
//
// Authority split (§3 / §7):
//   THIS MODULE — durable model + pure roll-up lens (what v2 inherits).
//   extdeps/realization/* — peripheral host handlers (v1 eval_expr tap today).
//   product.compute_fabric — PerformanceReceipt observation carrier.
//
// Instrumentation is the dual of cache (realization-measurement-loop.md Phase 0):
// both wrap the same fold boundary keyed by content-hash subject; cache stores
// node→value, measurement stores node→duration. The handler is host-effect;
// the analysis is this lens.

module std.realization_measurement

import std.types { ContentHash, Bool, String, List }
import std.nat { Nat, nat_max }
import std.measure {
  Measure,
  Time,
  time_measure,
  measure_count,
}
import std.realization_schedule {
  CostAccount,
  CostBasis,
  cost_account_measured,
  cost_account_predicted_zero,
  cost_account_time_count,
}

// Host-effect shape: observe elapsed wall time at a cache-subject boundary.
// NOT a state-mutation EffectShape (std.effects) — measurement is peripheral
// realization (§3 measured⇒peripheral), keyed like cache UpsertSubject.
type RealizationMeasureEffect
  = ObserveElapsedAtSubject {
      subject: ContentHash
      work_shape: String
    }

// --- Pure roll-up lens: observations → CostAccount.time --------------------
//
// Scale-AGNOSTIC over `<S>`: the algebra below is pure add / max over a `Time` magnitude
// at ANY scale (DESIGN §3 — the framework carries no scale CHOICE). A consumer pins `<S>`
// (e.g. `Nano`) at its own boundary; nothing here names a particular scale. `<M>` is fixed
// at `Nat` (magnitude-genericity needs `+`/`max` over `<M>`, the documented where-clause
// substrate gap — see `std.measure.time_measure`).

fn cost_account_measured_from_time<S>(time: Measure<Time, S, Nat>) -> CostAccount<S> {
  cost_account_measured(time: time)
}

fn time_measure_list_total<S>(times: List<Measure<Time, S, Nat>>) -> Measure<Time, S, Nat> {
  time_measure(
    count: fold(times, init: 0, f: (acc, t) => acc + measure_count(m: t))
  )
}

// --- Critical-path span roll-up (Phase 1.5b) --------------------------------
//
// Authority: v1.compiler.complexity — `span` is critical-path length under DAG
// dependency structure; `cost_seq` (sequential = add) and `cost_par` (parallel =
// CostMax) at complexity.dag:3754-3771. Do NOT fork a second span semantics here;
// these are the concrete NanosecondDuration realizations of that proof vocabulary.

fn time_measure_is_zero<S>(d: Measure<Time, S, Nat>) -> Bool {
  measure_count(m: d) == 0
}

fn time_measure_seq<S>(a: Measure<Time, S, Nat>, b: Measure<Time, S, Nat>) -> Measure<Time, S, Nat> {
  if time_measure_is_zero(d: a) {
    b
  } else if time_measure_is_zero(d: b) {
    a
  } else {
    time_measure(
      count: measure_count(m: a) + measure_count(m: b)
    )
  }
}

fn time_measure_par<S>(a: Measure<Time, S, Nat>, b: Measure<Time, S, Nat>) -> Measure<Time, S, Nat> {
  if time_measure_is_zero(d: a) {
    b
  } else if time_measure_is_zero(d: b) {
    a
  } else {
    time_measure(
      count: nat_max(a: measure_count(m: a), b: measure_count(m: b))
    )
  }
}

fn time_measure_list_par<S>(times: List<Measure<Time, S, Nat>>) -> Measure<Time, S, Nat> {
  fold(
    times,
    init: time_measure(count: 0),
    f: (acc, t) => time_measure_par(a: acc, b: t)
  )
}

// One schedule batch (parallel runnables) → max wall time; zero identity matches cost_par.
fn schedule_batch_critical_path<S>(batch_times: List<Measure<Time, S, Nat>>) -> Measure<Time, S, Nat> {
  time_measure_list_par(times: batch_times)
}

// Schedule topology `List<List<…>>`: sequential across batches, parallel within batch.
fn schedule_critical_path_time<S>(batch_times: List<List<Measure<Time, S, Nat>>>) -> Measure<Time, S, Nat> {
  fold(
    batch_times,
    init: time_measure(count: 0),
    f: (acc, batch) => time_measure_seq(
      a: acc,
      b: schedule_batch_critical_path(batch_times: batch)
    )
  )
}

fn cost_account_measured_from_schedule_critical_path<S>(
  batch_times: List<List<Measure<Time, S, Nat>>>
) -> CostAccount<S> {
  cost_account_measured_from_time(time: schedule_critical_path_time(batch_times: batch_times))
}

fn cost_account_measured_from_time_list<S>(times: List<Measure<Time, S, Nat>>) -> CostAccount<S> {
  cost_account_measured_from_time(time: time_measure_list_total(times: times))
}

// Discriminating lens: non-zero measured roll-up must differ from predicted_zero
// and preserve the magnitude count (§5 — goes red if roll-up aliases or drops time).
// Scale-agnostic: holds at whatever scale `<S>` the consumer supplies.
fn witness_measured_rollup_differs_from_predicted_zero<S>(wall_time: Measure<Time, S, Nat>) -> Bool {
  if measure_count(m: wall_time) == 0 {
    false
  } else {
    let measured_count = cost_account_time_count(
      account: cost_account_measured_from_time(time: wall_time)
    )
    let predicted_count = cost_account_time_count(account: cost_account_predicted_zero())
    measured_count != predicted_count
      && measured_count == measure_count(m: wall_time)
  }
}
