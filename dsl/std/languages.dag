  name: "YAML",
  extensions: [".yml", ".yaml"],
  comment: {
    line_prefix: "#",
    block_start: null,
    block_end: null,
    doc_prefix: null
  }
}

// "What is TOML?"
data toml_format: ConfigFormat = {
