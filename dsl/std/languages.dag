  name: "Makefile",
  extensions: ["Makefile", "*.mk"],
  comment: {
    line_prefix: "#",
    block_start: null,
    block_end: null,
    doc_prefix: null
  }
}

// "What is a .gitignore?"
data gitignore_format: ConfigFormat = {
  id: "gitignore",
  name: "Gitignore",
  extensions: [".gitignore"],
  comment: {
