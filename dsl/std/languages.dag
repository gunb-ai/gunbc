// -- Layer 2d: LanguageSpec compositions ------------------------------
//
// Each LanguageSpec value composes all the Layer 0/0b/0c/2/2b/2c data
// for a single target language. This is the value the emitter receives.

// "Everything the compiler needs to emit Rust."
data rust_spec: LanguageSpec = {
  language: rust_language,
  statements: rust_statements,
  expressions: rust_expressions,
  control_flow: rust_control_flow,
  literals: rust_literals,
  modules: rust_modules,
  functions: rust_functions,
  errors: rust_errors,
  type_defs: rust_type_defs,
  patterns: rust_patterns,
  async_model: rust_async,
  collection_ops: rust_collection_ops,
  string_ops: rust_string_ops,
  map_ops: rust_map_ops,
  null_coalesce: rust_null_coalesce,
  reserved_words: rust_reserved_words,
  value_semantics: rust_value_semantics,
  serialization: rust_serialization,
  scaffold: rust_scaffold,
  service_calls: rust_service_calls
}

// "Everything the compiler needs to emit Go."
data go_spec: LanguageSpec = {
  language: go_language,
  statements: go_statements,
  expressions: go_expressions,
  control_flow: go_control_flow,
  literals: go_literals,
  modules: go_modules,
  functions: go_functions,
  errors: go_errors,
  type_defs: go_type_defs,
  patterns: go_patterns,
  async_model: go_async,
  collection_ops: go_collection_ops,
  string_ops: go_string_ops,
  map_ops: go_map_ops,
  null_coalesce: go_null_coalesce,
  reserved_words: go_reserved_words,
  value_semantics: go_value_semantics,
  serialization: go_serialization,
  scaffold: go_scaffold,
  service_calls: go_service_calls
}

// "Everything the compiler needs to emit Python."
data python_spec: LanguageSpec = {
  language: python_language,
  statements: python_statements,
  expressions: python_expressions,
  control_flow: python_control_flow,
  literals: python_literals,
  modules: python_modules,
  functions: python_functions,
  errors: python_errors,
  type_defs: python_type_defs,
  patterns: python_patterns,
  async_model: python_async,
  collection_ops: python_collection_ops,
  string_ops: python_string_ops,
  map_ops: python_map_ops,
  null_coalesce: python_null_coalesce,
  reserved_words: python_reserved_words,
  value_semantics: python_value_semantics,
  serialization: python_serialization,
  scaffold: python_scaffold,
  service_calls: python_service_calls
}
// -- Markup formats ---------------------------------------------------

// "What is Markdown?"
data markdown_format: MarkupFormat = {
  id: "markdown",
  name: "Markdown",
  extensions: [".md", ".markdown"],
  comment: {
    line_prefix: null,
    block_start: "<!-- ",
    block_end: " -->",
    doc_prefix: null
  },
  code_fence: "```"
}

// "What is HTML?"
data html_format: MarkupFormat = {
  id: "html",
  name: "HTML",
  extensions: [".html", ".htm"],
  comment: {
    line_prefix: null,
    block_start: "<!-- ",
    block_end: " -->",
    doc_prefix: null
  },
  code_fence: null
}

// -- Config formats ---------------------------------------------------

// "What is YAML?"
data yaml_format: ConfigFormat = {
  id: "yaml",
  name: "YAML",
  extensions: [".yml", ".yaml"],
  comment: {
    line_prefix: "#",
    block_start: null,
    block_end: null,
    doc_prefix: null
  }
}

// "What is TOML?"
data toml_format: ConfigFormat = {
  id: "toml",
  name: "TOML",
  extensions: [".toml"],
  comment: {
    line_prefix: "#",
    block_start: null,
    block_end: null,
    doc_prefix: null
  }
}

// "What is a Makefile?"
data makefile_format: ConfigFormat = {
  id: "makefile",
  name: "Makefile",
  extensions: ["Makefile", "*.mk"],
  comment: {
    line_prefix: "#",
    block_start: null,
    block_end: null,
    doc_prefix: null
  }
}

// "What is a .gitignore?"
data gitignore_format: ConfigFormat = {
  id: "gitignore",
  name: "Gitignore",
  extensions: [".gitignore"],
  comment: {
    line_prefix: "#",
    block_start: null,
    block_end: null,
    doc_prefix: null
  }
}

// "What is CSS?"
data css_format: ConfigFormat = {
  id: "css",
  name: "CSS",
  extensions: [".css"],
  comment: {
    line_prefix: null,
    block_start: "/*",
    block_end: "*/",
    doc_prefix: null
  }
}

// -- Utility fn signatures --------------------------------------------
//
// These fns are not defined here as DSL fn items because the lowerer
// creates standalone nodes for all fn items in a module, causing
// "missing input" errors when the module is imported transitively.
//
// Signatures (for documentation):
//   comment_line(text: String, syntax: CommentSyntax) -> String
//   map_abstract_type(abstract_type: String, mapping: TypeMapping) -> String
