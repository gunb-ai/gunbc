// std/stack.dag -- Persistent LIFO stack (cons list).
//
// Stack<T> inhabits FreeMonoid<T>: finite sequence under concatenation.
// The cons-list representation gives different cost characteristics than
// the array-backed FreeMonoid (List):
//
//   FreeMonoid operation    Stack (cons-list)    List (array)
//   ─────────────────────   ─────────────────    ────────────
//   append (push/prepend)   O(1)                 O(n)
//   first (peek)            O(1)                 O(1)
//   rest (pop)              O(1)                 O(n)
//   concat                  O(n)                 O(1) amortized
//   index                   O(n)                 O(1)
//   length                  O(n)                 O(1)
//   fold                    O(n)                 O(n)
//
// Use Stack when you need LIFO push/pop (call stacks, undo history,
// parsing state, depth-first traversal).
// Use List when you need indexed access or append.
//
// DECIDABILITY:
//   Stack is inductively defined. Every Stack is finite because:
//   - Empty has 0 elements
//   - Push { top, rest } has 1 + |rest| elements
//   There is no constructor for infinite stacks.
//   fold is bounded by |stack| — same as fold on List.

module std.stack

import std.algebra { FreeMonoid }

// =========================================================================
// Stack type — recursive coproduct (cons-list representation of FreeMonoid)
// =========================================================================

type Stack<T>
  = Empty
  | Push { top: T, rest: Stack<T> }

// =========================================================================
// FreeMonoid witness — Stack operations mapped to FreeMonoid vocabulary
// =========================================================================

// FreeMonoid.append: O(1) — construct Push node
fn append<T>(stack: Stack<T>, value: T) -> Stack<T> {
  Push { top: value, rest: stack }
}

// FreeMonoid.empty: Stack<T> = Empty (the identity element)

// FreeMonoid.first: O(1) — return top element
fn first<T>(stack: Stack<T>) -> T? {
  match stack {
    Empty => none
    Push { top: t, rest: _ } => Some { value: t }
  }
}

// rest: O(1) — return stack without top (pop)
fn rest<T>(stack: Stack<T>) -> Stack<T> {
  match stack {
    Empty => Empty
    Push { top: _, rest: r } => r
  }
}

// FreeMonoid.length: O(n) — count elements
fn length<T>(stack: Stack<T>) -> Int {
  match stack {
    Empty => 0
    Push { top: _, rest: r } => 1 + length(stack: r)
  }
}

// FreeMonoid.fold: O(n) — the bounded iteration primitive for Stack.
// Process each element top-to-bottom. Bounded by |stack|.
fn fold<T, B>(stack: Stack<T>, init: B, f: fn(B, T) -> B) -> B {
  match stack {
    Empty => init
    Push { top: t, rest: r } => fold(stack: r, init: f(init, t), f: f)
  }
}

// =========================================================================
// Conversion — homomorphism between Stack and List (both FreeMonoid<T>)
// =========================================================================

fn to_list<T>(stack: Stack<T>) -> List<T> {
  match stack {
    Empty => []
    Push { top: t, rest: r } => [t] |> concat(to_list(stack: r))
  }
}

fn from_list<T>(items: List<T>) -> Stack<T> {
  fold(items, Empty, fn(stack, item) { append(stack: stack, value: item) })
}

// Stack<T> inhabits FreeMonoid<T>:
//   empty    = Empty
//   append   = append (Push constructor)
//   first    = first (peek at top)
//   fold     = fold (top-to-bottom catamorphism)
//   length   = length (structural recursion)
//   to_list  = the unique FreeMonoid homomorphism Stack<T> → List<T>
// Data declaration deferred: compiler does not yet emit generic type
// parameters for data constants (FreeMonoid<T> instance).
