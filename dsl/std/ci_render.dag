// std/ci_render.dag -- CI workflow rendering: provider-specific YAML output.
//
// Pure functions that transform CiWorkflow records into YAML strings.
// Matches the output previously generated by codegen_cli.rs. Each helper
// renders one YAML section; top-level functions compose them.

module std.ci_render

import std.ci {
  CiProvider, CiWorkflow, CiJob, CiStep, CiEnvVar, CiPermission,
  CiCache, CiCheckout, CiTrigger, CiRunner, CiSecret
}

// ---------------------------------------------------------------------------
// Shared helpers
// ---------------------------------------------------------------------------

fn render_ci_header(generator_name: String, regenerate_command: String) -> String {
  "# Generated by {generator_name}\n# DO NOT EDIT - regenerate with: {regenerate_command}"
}

fn render_yaml_block(header: String, items: List<String>) -> String {
  if items |> count() == 0 {
    ""
  } else {
    let lines = items |> join("\n")
    "{header}\n{lines}\n"
  }
}

// ---------------------------------------------------------------------------
// GitHub Actions rendering
// ---------------------------------------------------------------------------

fn render_github_trigger(trigger: CiTrigger) -> String {
  let branch_lines = trigger.branches |> map(b => "      - {b}") |> join("\n")
  let push_block = if trigger.on_push {
    "on:\n  push:\n    branches:\n{branch_lines}\n"
  } else {
    "on:\n"
  }
  let pr_block = if trigger.on_pull_request {
    "  pull_request:\n    branches:\n{branch_lines}\n"
  } else {
    ""
  }
  "{push_block}{pr_block}"
}

fn render_github_permissions(permissions: List<CiPermission>) -> String {
  if permissions |> count() == 0 {
    ""
  } else {
    let lines = permissions |> map(p => "  {p.scope}: {p.level}") |> join("\n")
    "permissions:\n{lines}\n\n"
  }
}

fn render_github_env(env: List<CiEnvVar>) -> String {
  if env |> count() == 0 {
    ""
  } else {
    let lines = env |> map(e => "  {e.key}: {e.value}") |> join("\n")
    "env:\n{lines}\n\n"
  }
}

fn render_github_cache(cache: CiCache?) -> String {
  match cache {
    null => "",
    c => {
      let path_lines = c.paths |> map(p => "            {p}") |> join("\n")
      let restore_lines = c.restore_keys |> map(k => "            {k}") |> join("\n")
      "      - name: Cache Cargo\n        uses: actions/cache@v4\n        with:\n          path: |\n{path_lines}\n          key: {c.key}\n          restore-keys: |\n{restore_lines}\n"
    }
  }
}

fn render_github_checkout(checkout: CiCheckout?) -> String {
  match checkout {
    null => "",
    co => {
      let base = "      - name: Checkout\n        uses: actions/checkout@v4\n"
      match co.fetch_depth {
        null => base + "\n",
        depth => base + "        with:\n          fetch-depth: {depth}\n\n"
      }
    }
  }
}

fn render_github_step_env(env: List<CiEnvVar>) -> String {
  if env |> count() == 0 {
    ""
  } else {
    let lines = env |> map(e => "          {e.key}: {e.value}") |> join("\n")
    "        env:\n{lines}\n"
  }
}

fn render_github_secrets(secrets: List<String>) -> String {
  secrets |> map(s => "          {s}: ${{{{ secrets.{s} }}}}") |> join("\n")
}

fn render_github_job(job: CiJob, checkout: CiCheckout?, cache: CiCache?, secrets_env: List<String>) -> String {
  let job_header = "jobs:\n  {job.name}:\n    runs-on: {job.runner.id}\n    timeout-minutes: {job.timeout_minutes}\n    steps:\n"
  let checkout_section = render_github_checkout(checkout: checkout)
  let rust_setup = "      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n"
  let cache_section = render_github_cache(cache: cache)
  let steps_section = job.steps |> map(step => render_github_step(step: step, secrets_env: secrets_env)) |> join("")
  "{job_header}{checkout_section}{rust_setup}{cache_section}{steps_section}"
}

fn render_github_step(step: CiStep, secrets_env: List<String>) -> String {
  match step {
    Run(s) => "      - name: {s.name}\n        run: {s.command}\n",
    Uses(s) => {
      let base = "      - name: {s.name}\n        uses: {s.action}\n"
      if s.with_params |> count() > 0 {
        let params = s.with_params |> map(p => "          {p.key}: {p.value}") |> join("\n")
        base + "        with:\n{params}\n"
      } else {
        base
      }
    },
    DagRun(s) => {
      let base = "      - name: {s.name}\n        run: {s.command}\n"
      let env_lines = s.env |> map(e => "          {e.key}: {e.value}") |> join("\n")
      let secret_lines = render_github_secrets(secrets: secrets_env)
      let all_env = if env_lines + secret_lines != "" {
        let combined = if env_lines != "" && secret_lines != "" {
          "{env_lines}\n{secret_lines}"
        } else {
          "{env_lines}{secret_lines}"
        }
        "        env:\n{combined}\n"
      } else {
        ""
      }
      "{base}{all_env}"
    }
  }
}

fn render_github_workflow(w: CiWorkflow) -> String {
  let header = render_ci_header(generator_name: w.generator_name, regenerate_command: w.regenerate_command)
  let name_line = "\n\nname: {w.name}\n\n"
  let trigger = render_github_trigger(trigger: w.trigger)
  let permissions = render_github_permissions(permissions: w.permissions)
  let env = render_github_env(env: w.env)
  let job = w.jobs |> first()
  match job {
    null => "{header}{name_line}{trigger}{permissions}{env}",
    j => {
      let job_section = render_github_job(job: j, checkout: w.checkout, cache: w.cache, secrets_env: w.secrets_env)
      "{header}{name_line}{trigger}{permissions}{env}{job_section}"
    }
  }
}

// ---------------------------------------------------------------------------
// GitLab CI rendering
// ---------------------------------------------------------------------------

fn render_gitlab_variables(env: List<CiEnvVar>) -> String {
  if env |> count() == 0 {
    ""
  } else {
    let lines = env |> map(e => "  {e.key}: \"{e.value}\"") |> join("\n")
    "variables:\n{lines}\n\n"
  }
}

fn render_gitlab_cache() -> String {
  "cache:\n  key: cargo-${{CI_COMMIT_REF_SLUG}}\n  paths:\n    - .cargo/\n    - target/\n\n"
}

fn render_gitlab_workflow(w: CiWorkflow) -> String {
  let header = render_ci_header(generator_name: w.generator_name, regenerate_command: w.regenerate_command)
  let image = "\n\nimage: rust:latest\n\n"
  let variables = render_gitlab_variables(env: w.env)
  let stages = "stages:\n  - ci\n\n"
  let cache = render_gitlab_cache()
  let job = w.jobs |> first()
  match job {
    null => "{header}{image}{variables}{stages}{cache}",
    j => {
      let step = j.steps |> first()
      let command = match step {
        null => "echo 'no steps'",
        DagRun(s) => s.command,
        Run(s) => s.command,
        Uses(s) => s.action
      }
      "{header}{image}{variables}{stages}{cache}{w.name}:\n  stage: ci\n  script:\n    - {command}\n"
    }
  }
}
