// std/float.dag -- Floating-point types as algebraic compositions.
//
// Fixed-width floats are width refinements of `ApproximateField<Word*>` (see
// `src/v3/std/approximate_field.dag`) composed with `MachineWidth<Word*>` (R3 §1.8
// gate #19 `numeric_aliases_align_to_refinements`). Approximate field laws subsume
// IEEE-style rounding / NaN policy axes — grounding remains target-specific.

module std.float

import std.bit { Word32, Word64 }
import std.machine_constraints { Compose, MachineWidth }
import v3.std.approximate_field { ApproximateField }

type Float32 = Compose<ApproximateField<Word32>, MachineWidth<Word32>>
type Float64 = Compose<ApproximateField<Word64>, MachineWidth<Word64>>

// Default alias
type Float = Float64
