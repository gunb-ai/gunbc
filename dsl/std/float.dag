// std/float.dag -- Floating-point types as algebraic compositions.
//
// Fixed-width floats are compatibility aliases for fixed-width reals:
// `Float<N> = Real<N> = Compose<Real, MachineWidth<N>>` with literal-Nat `N`
// (R3 gate #60 Slice Z; R3 §1.8 gate #67 `numeric_construction_demonstration`).
// IEEE 754 rounding still breaks pure field laws — approximate semantics remain
// Grounding's concern.
//
// T-Numeric-Construction / R3 gate #17 — abstract `Real` (construction-chain
// layer 5). Spelling per
// `docs/audit/t-numeric-construction-approximate-field-real-parameter-stop.md`
// Option A: `ApproximateField<Rational>` collides with landed
// `Rational = Field<FieldOfFractions<Int>>` (witness vs carrier). The `F` slot
// binds the fraction **carrier** `FieldOfFractions<Int>` so `base: Field<F>`
// matches `Rational`'s exact-field witness.

module std.float

import std.algebra { Field, FieldOfFractions }
import std.integer { Int }
import std.machine_constraints { Compose, MachineWidth }
import std.approximate_field { ApproximateField }

// Opaque compatibility carrier for older Float<N> receipts. The construction
// chain authority below is `Real`; fixed-width public aliases route through
// Real<N>-shaped Compose rows.
type Ieee754Float

// Abstract reals: approximate field over the exact rational **carrier**
// `FieldOfFractions<Int>` (see `dsl/std/rational.dag` for `Rational =
// Field<FieldOfFractions<Int>>`).
type Real = ApproximateField<FieldOfFractions<Int>>

// Fixed-width reals: abstract `Real` × machine width (refinement-shaped Compose).
// These are the R3 gate #67 `numeric_construction_demonstration` Real<N>
// construction entries; Rust Grounding maps Real64 to `f64`.
type Real32 = Compose<Real, MachineWidth<32>>
type Real64 = Compose<Real, MachineWidth<64>>

type Float32 = Real32
type Float64 = Real64

// Default alias
type Float = Float64
