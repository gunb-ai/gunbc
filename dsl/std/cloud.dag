// std/cloud.dag -- Cloud runtime composition.

module std.cloud

import std.runtime.github_actions { GitHubActionsRuntime }
import std.runtime.local_dev { LocalDevRuntime }
import std.runtime.metadata { MetadataRuntime }

type CloudRuntime
  = GitHubActions { runtime: GitHubActionsRuntime }
  | Metadata { runtime: MetadataRuntime }
  | LocalDev { runtime: LocalDevRuntime }
