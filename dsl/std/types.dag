// std/types.dag -- Base types and domain enums for the gunbc DSL.
//
// SET-THEORETIC FOUNDATION:
// Every type T denotes a set ⟦T⟧ of values. Subtyping is set inclusion:
//   A <: B  iff  ⟦A⟧ ⊆ ⟦B⟧
//
// The type universe is a bounded lattice:
//   ⊥ = Unit = {}        (empty set)
//   ⊤ = Json             (universal structured value)
//
// See dsl-design.md §4.1 "Type-Theoretic Foundations" for the full
// axiom system and coercion theorem.
//
// TYPES ARE DAGS: Every type T is itself a Dag<TypeOp>. The set ⟦T⟧
// is the set of values that PASS the type's DAG when executed:
//   ⟦T⟧ = {v | execute(T.dag, v) succeeds}
//
// Primitives are Identity DAGs (single node). Refinements add Validate
// nodes. Records are Product nodes (parallel field DAGs). Enums are
// Coproduct nodes (branching on variant tag). Generics are Apply nodes
// (parameterized SubDags). Brands are Brand nodes (nominal disjointness).
//
// This means type checking is DAG analysis, coercion insertion is DAG
// transformation, and test generation is DAG traversal. Same tooling
// as business logic -- one recursive Dag<Op> structure for everything.
//
// The compiler's internal model uses full cardinality algebra (lattice +
// semiring) and predicate entailment (Heyting algebra). The surface
// syntax keeps it simple: T, T?, List<T>.

module std.types

// --- Primitives (Level 0: Atoms) --------------------------------------
// Each is a single-node Identity DAG -- no validation, just a base carrier.
//
// DAG representation:         Set denotation:
//   String = Dag{Identity}      ⟦String⟧ = Σ*
//   Int    = Dag{Identity}      ⟦Int⟧    = ℤ
//   Bool   = Dag{Identity}      ⟦Bool⟧   = {true, false}
//   Float  = Dag{Identity}      ⟦Float⟧  = 𝔽₆₄
//   Bytes  = Dag{Identity}      ⟦Bytes⟧  = {0..255}*
//   Secret = Dag{Identity}      ⟦Secret⟧ = Σ* (security-policy distinction)
//   Unit   = Dag{Identity}      ⟦Unit⟧   = {} (bottom, ⊥)
//   Json   = Dag{Identity}      ⟦Json⟧   = ⟦Bool⟧ ∪ ⟦Int⟧ ∪ ... ∪ {null} (top, ⊤)
//
// (built-in to the compiler, listed here for documentation)

// --- Refinement types (Level 1: Subset Comprehension) -----------------
// Each adds a Validate node to the base type's DAG:
//   Url = Dag { Identity("String") → Validate(NonEmpty) → Validate(Matches("^https?://")) }
//
// Set meaning: ⟦T @pred(P)⟧ = {x ∈ ⟦T⟧ | P(x)}
// DAG meaning: execute base Identity, then each Validate; value passes iff all pass.
//
// Always a subtype of the base: T @pred(P) <: T  (the DAG is strictly longer)
// Conjunction is intersection: @pred(P) @pred(Q) chains two Validate nodes
//
// The compiler uses refinements for:
//   1. Validation at type-check time (compile error if ⟦source⟧ ⊄ ⟦target⟧)
//   2. Auto-generation of test inputs (valid from ⟦T⟧, invalid from ⟦T⟧ᶜ)
//   3. Documentation of expected shapes

type CommitSha    = String @pattern("^[a-f0-9]{40}$")     // ⟦CommitSha⟧ ⊂ ⟦String⟧
type RetryCount   = Int @range(min: 1, max: 5)           // ⟦RetryCount⟧ = {1,2,3,4,5} ⊂ ⟦Int⟧
type HttpStatus   = Int @range(min: 100, max: 599)       // |⟦HttpStatus⟧| = 500
type Email        = String @pattern("^[^@]+@[^@]+\\.[^@]+$")
type Port         = Int @range(min: 1, max: 65535)       // ⟦Port⟧ = {n ∈ ℤ | 1 ≤ n ≤ 65535}
type GistId       = String @format(uuid)                 // ⟦GistId⟧ ⊂ ⟦String⟧
type SecretValue  = Secret @non_empty                    // ⟦SecretValue⟧ = {s ∈ Σ* | s ≠ ""}
type Url          = String @pattern("^https?://")        // ⟦Url⟧ ⊂ ⟦NonEmptyStr⟧ ⊂ ⟦String⟧
type FilePath     = String @non_empty                    // ⟦FilePath⟧ = ⟦NonEmptyStr⟧
type SemVer       = String @pattern("^\\d+\\.\\d+\\.\\d+")
type NonEmptyStr  = String @non_empty                    // ⟦NonEmptyStr⟧ = {s ∈ Σ* | |s| > 0}

// --- Git types (refinements of String) ------------------------------------
type GitRef       = String @non_empty                    // ⟦GitRef⟧ ⊂ ⟦String⟧ (branch name, tag, "HEAD", etc.)
// Note: CommitSha <: GitRef <: String. A SHA is always a valid ref,
// but a ref is not always a SHA (e.g., "main", "HEAD~1").

// --- GCP types (refinements for cloud identifiers) -----------------------
type ProjectId    = String @non_empty @pattern("^[a-z][a-z0-9-]{4,28}[a-z0-9]$")  // GCP project IDs
type ServiceAccountEmail = String @pattern("^[a-z][a-z0-9-]*@[a-z0-9-]+\\.iam\\.gserviceaccount\\.com$")

// Refinement chain example (transitive subtyping):
//   ⟦Url⟧ ⊂ ⟦NonEmptyStr⟧ ⊂ ⟦String⟧ ⊂ ⟦Json⟧
// Each step narrows by predicate (subset comprehension).
// The compiler walks this chain for coercion: passing Url where String
// expected is safe (⊆); passing String where Url expected is an error (⊄).

// --- Domain enums (Level 4: Finite Coproducts) ------------------------

type CloudRuntime = GitHubActions | Metadata | LocalDev  // |⟦CloudRuntime⟧| = 3
type Platform     = Linux | MacOS | Windows              // |⟦Platform⟧| = 3

// Simple enums are finite sets. Pattern matching must be exhaustive
// (cover the full ⊔). CloudRuntime <: Json (by injection into String).

// --- Content encoding (Level 4+1: Coproduct with lattice structure) ----
// Content encodings classify what a file path's referent contains.
// This is NOT a property of the path string -- it's a property of the
// content at that path. The lattice enables compile-time narrowing:
//
//            Unknown (⊤)
//           /       \
//        Text      Binary
//       /    \
//    UTF8   Latin1
//       \    /
//       ASCII
//
// Set meaning: ⟦ContentEncoding⟧ = {UTF8, ASCII, Latin1, Binary}
// Lattice: UTF8 ⊔ Binary = Unknown, ASCII <: UTF8, ASCII <: Latin1
//
// The compiler uses ContentEncoding to:
//   1. Verify domain compatibility at I/O boundaries (compile-time)
//   2. Generate coproduct branch scenarios in tests (text vs binary)
//   3. Produce diverse mock file lists from @file_types rules

type ContentEncoding
  = UTF8                        // valid Unicode (Σ* decodable)
  | ASCII                       // 7-bit subset (ASCII <: UTF8 ∧ ASCII <: Latin1)
  | Latin1                      // ISO 8859-1
  | Binary                      // opaque byte sequence ({0..255}*)

// --- File content types (Level 1+4: Refinement × Coproduct) -----------
// Model BOTH sides of the file I/O equation:
//   Producer side: what files actually exist (content encoding)
//   Consumer side: what operations require (TextFilePath vs FilePath)
//
// A FilePath names a location; its referent has a content encoding.
// TextFilePath and BinaryFilePath are content-indexed refinements:
//   ⟦TextFilePath⟧ ⊂ ⟦FilePath⟧         (subset)
//   ⟦BinaryFilePath⟧ ⊂ ⟦FilePath⟧       (subset)
//   ⟦TextFilePath⟧ ∩ ⟦BinaryFilePath⟧ = ∅   (disjoint via @content brand)
//   ⟦TextFilePath⟧ ⊔ ⟦BinaryFilePath⟧ = ⟦FilePath⟧  (exhaustive partition)
//
// Passing FilePath where TextFilePath is expected is a compile error:
//   ⟦FilePath⟧ ⊄ ⟦TextFilePath⟧  →  "cannot prove content is text"
// The developer must insert an explicit classification step.

type TextFilePath   = FilePath @content(Text)     // referent is Σ* decodable
type BinaryFilePath = FilePath @content(Binary)   // referent is {0..255}*

// What Filesystem.probe returns -- classifies a path's referent.
type FileClassification {
  path: FilePath
  encoding: ContentEncoding
  size: Int
  mime: MimeType?
}

type MimeType = String @pattern("^[a-z]+/[a-z0-9.+-]+$")

// File type rules -- declarative extension-to-encoding mapping.
// This is compile-time data the compiler uses for:
//   1. Static narrowing: path literal "foo.rs" → TextFilePath (from @file_types)
//   2. Test fixture generation: diverse mock file lists across branches
//   3. Default classification in dry-run mode (no filesystem access)
//   4. Repo integration tests: expected binary/text file counts
//
// Defines the partitioning:  classify: ⟦FilePath⟧ → TextFilePath ⊔ BinaryFilePath
@file_types {
  text: [".rs", ".toml", ".dag", ".md", ".txt", ".json", ".yaml", ".yml",
         ".sh", ".html", ".css", ".js", ".ts", ".py", ".go", ".java",
         ".xml", ".csv", ".sql", ".graphql", ".proto", ".lock"]
  binary: [".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico",
           ".wasm", ".zip", ".tar", ".gz", ".bz2", ".xz",
           ".exe", ".dll", ".so", ".dylib", ".o", ".a",
           ".mp3", ".mp4", ".wav", ".ogg", ".avi", ".mov"]
  default: Binary   // unknown extensions → Binary (fail-safe)
}

// --- Auth types (Level 3+4: Product and Coproduct DAGs) ---------------
// Records compile to Product nodes with parallel SubDag fields.
// Sums compile to Coproduct nodes that branch on variant tag.

// ⟦AuthScheme⟧ = {Bearer} ⊔ ({Header} × ⟦String⟧) ⊔ ({Basic} × ⟦String⟧)
// Sum type with payloads: tagged disjoint union.
type AuthScheme
  = Bearer
  | Header { name: String }
  | Basic { username: String }

// ⟦AccessToken⟧ = ⟦Secret⟧ × ⟦AuthScheme⟧ × ⟦String?⟧
//               = ⟦Secret⟧ × ⟦AuthScheme⟧ × (⟦String⟧ ∪ {none})
type AccessToken {
  token: Secret
  scheme: AuthScheme
  expires_at: String?          // Level 5: Optional -- ⟦String⟧ ∪ {none}
}

type CloudSecretConfig {
  project: String
  secret: String
  version: String = "latest"
  service_account: String?
  audience: String = "sigstore"
  scheme: AuthScheme = Bearer
  header_name: String?
  source_id: String
  required_scopes: List<String>
}

type Credential {
  token: Secret
  scheme: AuthScheme
  header_name: String?
  source_id: String
  required_scopes: List<String>
  expires_in: Int?
}

// --- Test / CI types (Level 3: Labeled Products) ----------------------

type TestResult {
  name: String
  ok: Bool
  stdout: String
  stderr: String
  duration_ms: Int
}

type Summary {
  total: Int
  passed: Int
  failed: Int
}

type StageResult {
  name: String
  success: Bool
  stdout: String
  stderr: String
  skipped: Bool
}

// --- Tool registry (Level 3+6: Products with Collections) -------------

type ToolEntry {
  name: String
  command: String
  description: String?
}

type ToolRegistry {
  tools: List<ToolEntry>
}

// --- Dag visualization (nested products + collections) ----------------

// DAG: Product { nodes: Wrap(List) → SubDag(TopologyNode), edges: ..., ... }
// Set: ⟦DagTopology⟧ = (⋃ₙ ⟦TopologyNode⟧ⁿ) × (⋃ₘ ⟦TopologyEdge⟧ᵐ) × (⋃ₖ ⟦String⟧ᵏ)
type DagTopology {
  nodes: List<TopologyNode>
  edges: List<TopologyEdge>
  subdag_boundaries: List<String>
}

type TopologyNode {
  id: String
  label: String
  kind: String           // "pure" | "transport" | "subdag" | "env"
  parent: String?        // SubDag parent id
}

type TopologyEdge {
  from: String
  to: String
  port: String?
}

type DagDiff {
  added: List<String>
  removed: List<String>
  changed: List<String>
}

// --- Codegen / pragma (simple products) --------------------------------

type CodegenTarget {
  name: String
  path: FilePath
}

type PragmaDirective {
  key: String
  value: String
  scope: String?
}

// --- Docgen (product with refinement) ----------------------------------

type DocSource {
  path: FilePath
  kind: String           // "template" | "generated" | "static"
}
