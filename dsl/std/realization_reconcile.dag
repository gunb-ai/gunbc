module std.realization_reconcile

import std.types { String, Bool }

data realization_reconcile_doc: String = "Canonical reconcile-and-verify-ground carrier. SHARED substrate: runner-slot, PXE, and ctrl reconcile all import this; systemd-oomd is its FIRST instance, not its owner (home is std, the layer all consumers point toward). Signed signature: reconcile(apply_effect, show_read, grounds_predicate) -> Converged { evidence } | NotConverged { reason }. DESIGN section 5 invariant: the evidence carrier is produced ONLY by grounds_predicate over an OBSERVED show_read. The verdict depends on the read alone, NEVER on apply_effect: trusting apply (the declaration that the effect was applied) instead of the read (what the host actually resolved) would be a fail-open seam. So apply_effect is threaded as provenance only and is structurally incapable of producing evidence. A read that is absent or does not ground yields NotConverged (fail-closed) and records no evidence."

type ShowEffectiveRead<R>
  = ReadObserved { value: R }
  | ReadAbsent { reason: String }

type Grounding<E>
  = Grounds { evidence: E }
  | DoesNotGround { reason: String }

type Reconciliation<A, E>
  = Converged { evidence: E, applied: A }
  | NotConverged { reason: String, applied: A }

fn reconcile<A, R, E>(
  apply_effect: A,
  show_read: ShowEffectiveRead<R>,
  grounds_predicate: fn(R) -> Grounding<E>
) -> Reconciliation<A, E> {
  match show_read {
    ReadAbsent { reason: why } => NotConverged { reason: why, applied: apply_effect }
    ReadObserved { value: observed } => {
      let grounded = grounds_predicate(observed)
      match grounded {
        Grounds { evidence: e } => Converged { evidence: e, applied: apply_effect }
        DoesNotGround { reason: why } => NotConverged { reason: why, applied: apply_effect }
      }
    }
  }
}

fn reconciliation_converged<A, E>(r: Reconciliation<A, E>) -> Bool {
  match r {
    Converged { evidence: _, applied: _ } => true
    NotConverged { reason: _, applied: _ } => false
  }
}
