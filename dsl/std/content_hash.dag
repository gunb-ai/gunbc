// std/content_hash.dag — Cross-module content-hash primitives (B1 re-export).
//
// hash_combine / atom_identity_hash are runtime primitives (v1_rt FNV-1a 64-bit);
// this module wraps them for dsl-tree consumers that cannot import v2.std.node.
//
// dissolve-on: v2 cross-tree Node content_hash subsumes tagged atom hashing for
// forward-stubbed ingress carriers (P-CF-INGRESS).

module std.content_hash

import std.types { ContentHash, NonEmptyStr }

fn content_hash_atom(value: NonEmptyStr) -> ContentHash {
  atom_identity_hash(value)
}

fn content_hash_combine(left: ContentHash, right: ContentHash) -> ContentHash {
  hash_combine(left, right)
}

fn content_hash_tagged(tag: NonEmptyStr, payload: ContentHash) -> ContentHash {
  content_hash_combine(content_hash_atom(value: tag), payload)
}
