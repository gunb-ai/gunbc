// std/integer.dag -- Integer types as carrier + algebra witness.
//
// MODELING NOTE: T-Numeric-Construction Slice 3 pivots the default `Int`
// alias from the legacy 64-bit storage carrier to the construction-chain
// algebra layer. The fixed-width rows (`Int8`..`Int128`, `UInt8`..`UInt128`)
// stay on `OrderedRing<Word*>` / `Semiring<Word*>`; only the abstract
// default alias moves to the algebra-over-`Nat` shape from
// `docs/design-numeric-construction.md`. Storage carriers (`Word*`) remain
// storage refinements, not alternate `Int`/`Nat`/`Magnitude` authorities.
//
// Pre-Slice-3 representation: Int = Int64 (default = 64-bit storage carrier).
// This conflated default-alias with fixed-width storage. The
// construction-chain progression is:
//   Magnitude → Nat = Semiring<Magnitude> → Int = AbelianGroup<Nat> → ...
//
// Slice 3 makes `Int` the abstract algebra layer; Slice §6 (cascade)
// migrates downstream consumers off `OrderedRing<Word64>` for the abstract
// `Int` algebra. Until then, the fixed-width rows are unaffected — code
// that explicitly names `Int8`/`Int64`/etc. continues to inhabit
// `OrderedRing<Word*>`.
//
// LEGACY MODELING NOTE (Int8..Int128 storage rows): A value of type Int8
// is NOT an OrderedRing record. Int8 is a CARRIER (Byte) with EVIDENCE
// that it inhabits OrderedRing. The algebra record is the witness — it
// tells the compiler what operations are valid on Int8 values. Values are
// Byte; operations come from the ring structure. The fixed-width rows
// stay shape-conflated until v3 supports trait/witness syntax separation.
//
// Signed/unsigned distinction comes from the algebra:
//   OrderedRing has negate (signed arithmetic — additive inverse)
//   Semiring has no negate (unsigned — only add and mul)

module std.integer

import std.algebra { OrderedRing, Semiring, AbelianGroup }
import std.bit { Byte, Word16, Word32, Word64, Word128 }
import std.nat { Nat }

// Signed integers: ordered rings (add + negate + mul + compare)
type Int8 = OrderedRing<Byte>
type Int16 = OrderedRing<Word16>
type Int32 = OrderedRing<Word32>
type Int64 = OrderedRing<Word64>
type Int128 = OrderedRing<Word128>

// Unsigned integers: semirings (add + mul, no negate)
type UInt8 = Semiring<Byte>
type UInt16 = Semiring<Word16>
type UInt32 = Semiring<Word32>
type UInt64 = Semiring<Word64>
type UInt128 = Semiring<Word128>

// Default aliases.
//
// T-Numeric-Construction Slice 3: `Int` is the abstract integer algebra,
// derived from `Nat` via the Grothendieck construction (design doc §3,
// Option 3 — abstract via existing `AbelianGroup<T>` algebra surface).
// The fixed-width storage rows above (`Int8`..`Int128`) stay on
// `OrderedRing<Word*>`; only this default alias is the construction-chain
// layer-3 carrier. Slice §6 (cascade) migrates downstream consumers off
// `OrderedRing<Word*>` for the abstract `Int` algebra path.
//
// `UInt = UInt64` remains the legacy default alias until the cascade slice;
// `UInt IS Nat` per design doc, but per-row migration is §6's job.
type Int = AbelianGroup<Nat>
type UInt = UInt64
