// std/integer.dag -- Integer types as carrier + algebra witness.
//
// MODELING NOTE: A value of type Int is NOT an OrderedRing record.
// Int is a CARRIER (Word64) with EVIDENCE that it inhabits OrderedRing.
// The algebra record is the witness — it tells the compiler what
// operations are valid on Int values. Values are Word64; operations
// come from the ring structure.
//
// Current representation: Int = OrderedRing<Word64>
// This conflates carrier with witness (the reviewer correctly noted
// this). The end-state model separates them:
//
//   type Int64 = Carrier<Word64> with OrderedRing
//   -- or --
//   type Int64 { carrier: Word64, algebra: OrderedRing<Word64> }
//
// Until the language supports trait/witness syntax, the direct alias
// is the honest intermediate. The compiler's structural field lookup
// works the same either way — it finds "add" on the resolved type.
//
// Signed/unsigned distinction comes from the algebra:
//   OrderedRing has negate (signed arithmetic — additive inverse)
//   Semiring has no negate (unsigned — only add and mul)

module std.integer

import std.algebra { OrderedRing, Semiring }
import std.bit { Byte, Word16, Word32, Word64 }

// Signed integers: ordered rings (add + negate + mul + compare)
type Int8 = OrderedRing<Byte>
type Int16 = OrderedRing<Word16>
type Int32 = OrderedRing<Word32>
type Int64 = OrderedRing<Word64>

// Unsigned integers: semirings (add + mul, no negate)
type UInt8 = Semiring<Byte>
type UInt16 = Semiring<Word16>
type UInt32 = Semiring<Word32>
type UInt64 = Semiring<Word64>

// Default aliases
type Int = Int64
type UInt = UInt64
