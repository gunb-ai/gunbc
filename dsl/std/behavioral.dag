// std/behavioral.dag -- Behavioral vocabulary for external-system modeling.
//
// Canonical operation behavior schema ported from the-gunbai Understanding
// model and used by Lane 4 extdeps + interface contracts.
//
// 🟡 NOT THE CLOSED-SYSTEM EFFECT AUTHORITY. This module declares
// **extdeps / interface contract metadata** authored alongside extdeps
// service operations. Per the R2 Substrate-inbox escalation #856
// (forwarded from Impossible-Bugs #857) and design doc #808, the
// closed-system effect authority is the type-signature-shape lens
// over the 5 substrate behaviors — `side_effects: SideEffects` and
// the `SideEffects = ReadOnly | WritesState | WritesExternal`
// taxonomy below are **declared** (parallel-representation) facts,
// not derived structural facts, and reviewers/consumers must NOT
// read them as effect-proof.
//
// **No extension.** Per the dispatch (substrate-inbox #856 reply) and
// T-Modeling discipline, this taxonomy must not grow to cover P1
// bypasses — non-derivable primitives surface as structural-coverage-gap
// diagnostics from the future signature-shape lens, not as new
// variants here.
//
// **Dissolution trigger (cross-surface).** When the signature-shape
// effects lens lands (#808 Slice §1 at
// `src/v3/lenses/effect_enumeration.dag`) and extdeps primitives are
// reshaped onto resource-threading discipline
// (returned-modified-resource), `side_effects` retires. This is a
// **cross-surface** retirement, not a local-schema retirement: the
// `idempotent` / `readonly` modifiers it pairs with are NOT declared
// in this file — they live in extdeps service operations and are
// cross-checked by
// `src/v3/std/effects.dag::check_modifier_vs_derivation` against the
// method+path normalization. All three (this `side_effects` taxonomy,
// the extdeps modifier declarations, the cross-check) retire together
// when the lens lands; no fact stored locally in `behavioral.dag`
// retires by itself.

module std.behavioral

// How an operation affects the world.
type SideEffects = ReadOnly | WritesState | WritesExternal

// Whether repeated invocations with equal inputs converge to one outcome.
type Determinism = Deterministic | NonDeterministic | EventuallyConsistent

// Severity used by modeled edge cases.
type Severity = Low | Medium | High | Critical

// Confidence assigned to a behavior declaration.
type Confidence = Documented | HighConfidence | MediumConfidence | LowConfidence | Assumed

// Coarse-grained prerequisite kind.
type PrerequisiteKind = Capability | Credential | Infrastructure | Policy | Tooling | Runtime | Other

type FailureMode {
  name: String
  condition: String?
  http_status: Int?
  recoverable: Bool
  retry_safe: Bool
}

type EdgeCase {
  description: String
  trigger: String?
  severity: Severity
}

type Prerequisite {
  description: String
  kind: PrerequisiteKind
}

// Shared contract types used by all interface definitions.
type CapabilityBehaviorContract {
  capability: String
  behavior: OperationBehavior
}

type CapabilityFailureContract {
  capability: String
  failures: List<FailureMode>
}

// Canonical behavior payload attached to operations and capabilities.
type OperationBehavior {
  side_effects: SideEffects
  determinism: Determinism
  failure_modes: List<FailureMode>
  edge_cases: List<EdgeCase>
  confidence: Confidence
  prerequisites: List<Prerequisite>
  assumptions: List<String>
  unknowns: List<String>
}
