module std.behavioral

data operation_determinism_projection_activation_marker: String = "P5 SERVICE PROJECTION scaffold — std.behavioral Determinism (OperationDeterminism) currently re-declares Deterministic|NonDeterministic alongside EventuallyConsistent; honest §3 fork until projection lands. Core authority: std.determinism DeterminismAxis (two arms only). Activation (P5): project Deterministic/NonDeterministic from v2.std.determinism DeterminismFact/DeterminismClass at OperationBehavior bind time (Deterministic ⇐ every bound realization is Deterministic; NonDeterministic ⇐ ∃ NonDeterministic { source: _ }; EventuallyConsistent has no DeterminismClass/NonDetSource image — D2). Dissolves when: extdeps OperationBehavior contracts consume projected determinism from DeterminismFact without restating the core predicate; contract drift lens gates behavioral↔compiler alignment (determinism-mechanism-design P5)."

type SideEffects = ReadOnly | WritesState | WritesExternal

type Determinism = Deterministic | NonDeterministic | EventuallyConsistent

type Severity = Low | Medium | High | Critical

type Confidence = Documented | HighConfidence | MediumConfidence | LowConfidence | Assumed

type PrerequisiteKind = Capability | Credential | Infrastructure | Policy | Tooling | Runtime | Other

type FailureMode {
  name: String
  condition: String?
  http_status: Int?
  recoverable: Bool
  retry_safe: Bool
}

type EdgeCase {
  description: String
  trigger: String?
  severity: Severity
}

type Prerequisite {
  description: String
  kind: PrerequisiteKind
}

type CapabilityBehaviorContract {
  capability: String
  behavior: OperationBehavior
}

type CapabilityFailureContract {
  capability: String
  failures: List<FailureMode>
}

type OperationBehavior {
  side_effects: SideEffects
  determinism: Determinism
  failure_modes: List<FailureMode>
  edge_cases: List<EdgeCase>
  confidence: Confidence
  prerequisites: List<Prerequisite>
  assumptions: List<String>
  unknowns: List<String>
}
