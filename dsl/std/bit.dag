// std/bit.dag -- Bit-level structural types.
//
// Machine-width types built from Classical truth values.
// These are FIXED-WIDTH carriers — not variable-length collections.
// The machine/container distinction is fundamental:
//   Word64 = exactly 8 bytes (machine carrier, fixed)
//   List<Byte> = variable-length byte sequence (container)
//
// Width constraints are structural invariants on each type.
// The v2 parser doesn't support field-level where clauses, so
// constraints are documented here and enforced by construction
// (the compiler creates these with the correct fixed widths).
//
// These carriers compose with algebras to form numeric types:
//   Int = OrderedRing<Word64>
//   Float = Field<Word64>

module std.bit

import std.logic { Classical }

// Bit: single Classical truth value (width = 1 bit)
type Bit = Classical

// Nibble: exactly 4 bits (half byte)
// Invariant: bits.length == 4
type Nibble { bits: List<Bit> }

// Byte: exactly 8 bits (fundamental storage unit)
// Invariant: bits.length == 8
type Byte { bits: List<Bit> }

// Machine words: fixed-width byte sequences
// Invariant: bytes.length == width / 8

// Word16: exactly 2 bytes (16 bits)
type Word16 { bytes: List<Byte> }

// Word32: exactly 4 bytes (32 bits)
type Word32 { bytes: List<Byte> }

// Word64: exactly 8 bytes (64 bits)
type Word64 { bytes: List<Byte> }

// Word128: exactly 16 bytes (128 bits)
type Word128 { bytes: List<Byte> }
