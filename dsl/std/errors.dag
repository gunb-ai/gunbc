// std/errors.dag -- Canonical provider error-shape vocabulary.

module std.errors

type HttpErrorShape {
  status: Int
  error_type: String
  message: String
  detail: String?
}

type AuthError = Expired | InvalidToken | MissingCredential | InsufficientScope | Forbidden

// Algebraic Result sum for fallible std operations (e.g. `OrderedRing.div` totality).
// Lives in `std.errors` (not `std.types`, which already imports `std.algebra`).
type Result<ok, err> = Ok { value: ok } | Err { value: err }

// Signed integer division (`Int / Int`): two structurally distinct failure modes
// (C-8): zero divisor vs MIN / -1 signed overflow. Used as `Result<T, DivError>`
// error half on `OrderedRing.div`.
type DivError = DivideByZero | Overflow

type RateLimitError {
  retry_after_seconds: Int?
  scope: String
}

type ConflictError {
  resource: String
  expected_version: String?
  actual_version: String?
}

type ProviderError {
  provider: String
  operation: String
  http_status: Int?
  message: String
}

type GitHubErrorShape {
  message: String
  documentation_url: String?
}

type GcpErrorDetails {
  code: Int
  message: String
  status: String?
}

type GcpErrorShape {
  error: GcpErrorDetails
}

type AnthropicErrorDetails {
  type: String
  message: String
}

type AnthropicErrorShape {
  type: String
  error: AnthropicErrorDetails
}

type OpenAiErrorDetails {
  message: String
  type: String
  param: String?
  code: String?
}

type OpenAiErrorShape {
  error: OpenAiErrorDetails
}

data github_error_example: GitHubErrorShape = {
  message: "Not Found",
  documentation_url: "https://docs.github.com/rest"
}

data gcp_error_example: GcpErrorShape = {
  error: {
    code: 403,
    message: "Permission denied",
    status: "PERMISSION_DENIED"
  }
}

data anthropic_error_example: AnthropicErrorShape = {
  type: "error",
  error: {
    type: "authentication_error",
    message: "invalid x-api-key"
  }
}
