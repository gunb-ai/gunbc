// std/errors.dag -- Provider error shapes from API documentation.
//
// Each type models the actual error response body of a specific provider.
// No invented abstractions — each shape is cited from the provider's API docs.

module std.errors

// GitHub REST API error response.
// Ref: https://docs.github.com/en/rest/overview/resources-in-the-rest-api#client-errors
type GitHubErrorShape {
  message: String
  documentation_url: String?
}

// GCP API error response (standard across all GCP REST APIs).
// Ref: https://cloud.google.com/apis/design/errors#error_model
type GcpErrorDetails {
  code: Int
  message: String
  status: String?
}

type GcpErrorShape {
  error: GcpErrorDetails
}

// Anthropic API error response.
// Ref: https://docs.anthropic.com/en/api/errors
type AnthropicErrorDetails {
  type: String
  message: String
}

type AnthropicErrorShape {
  type: String
  error: AnthropicErrorDetails
}

// OpenAI API error response.
// Ref: https://platform.openai.com/docs/guides/error-codes
type OpenAiErrorDetails {
  message: String
  type: String
  param: String?
  code: String?
}

type OpenAiErrorShape {
  error: OpenAiErrorDetails
}

data github_error_example: GitHubErrorShape = {
  message: "Not Found",
  documentation_url: "https://docs.github.com/rest"
}

data gcp_error_example: GcpErrorShape = {
  error: {
    code: 403,
    message: "Permission denied",
    status: "PERMISSION_DENIED"
  }
}

data anthropic_error_example: AnthropicErrorShape = {
  type: "error",
  error: {
    type: "authentication_error",
    message: "invalid x-api-key"
  }
}
