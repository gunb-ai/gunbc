// std/render_fns.dag -- Fragment/RenderDocument serializer functions.
//
// Serializers for the Fragment IR defined in std/render.dag. Separate from
// types to avoid the lowerer injecting unconnected fn nodes into consumers
// that import std.render (same pattern as markdown.dag + markdown_render.dag).
//
// serialize_fragment takes a level: Int for indentation — no Indented
// Fragment variant. Non-recursive: handles one level. Block/Section
// children are pre-serialized by callers when depth > 1.

module std.render_fns

import std.render {
  Fragment, OutputFormat, GeneratorHeader, RenderDocument
}

// Serialize a single Fragment using OutputFormat parameters.
fn serialize_fragment(f: Fragment, fmt: OutputFormat, level: Int) -> String {
  let pad = fmt.indent_unit |> repeat(level)
  match f {
    Text { content } => "{pad}{content}"
    Blank => ""
    Comment { text } => "{pad}{fmt.comment_prefix} {text}"
    Heading { level: hlevel, text } => {
      let marker = "=" |> repeat(hlevel)
      "{pad}{fmt.comment_prefix} {marker} {text} {marker}"
    }
    KeyValue { key, value } => "{pad}{key}{fmt.kv_separator}{value}"
    ListItem { content } => "{pad}{fmt.list_prefix}{content}"
    Block { header, children, separator } => {
      let sep = separator ?? fmt.section_separator
      let child_lines = children
        |> map(child => serialize_fragment(f: child, fmt: fmt, level: level + 1))
        |> join(sep)
      match header {
        None => child_lines
        _ => "{pad}{header}\n{child_lines}"
      }
    }
    Section { title, children } => {
      let child_lines = children
        |> map(child => serialize_fragment(f: child, fmt: fmt, level: level))
        |> join(fmt.section_separator)
      match title {
        None => child_lines
        _ => "{pad}{fmt.comment_prefix} {title}\n{child_lines}"
      }
    }
    Verbatim { content } => content
    Separator { text } => "{pad}{text}"
  }
}

// Serialize a list of Fragments, joined by section_separator.
fn serialize_fragments(fragments: List<Fragment>, fmt: OutputFormat) -> String {
  fragments
    |> map(f => serialize_fragment(f: f, fmt: fmt, level: 0))
    |> join(fmt.section_separator)
}

// Render the "Generated by" header using format's comment_prefix.
fn render_generator_header(h: GeneratorHeader, comment_prefix: String) -> String {
  "{comment_prefix} Generated by {h.generator}\n{comment_prefix} DO NOT EDIT - regenerate with: {h.regen_command}"
}

// Serialize a RenderDocument (header + preamble + sections).
fn serialize_document(doc: RenderDocument) -> String {
  let header_str = match doc.header {
    None => ""
    _ => render_generator_header(h: doc.header, comment_prefix: doc.format.comment_prefix) + "\n"
  }
  let preamble_str = serialize_fragments(fragments: doc.preamble, fmt: doc.format)
  let sections_str = serialize_fragments(fragments: doc.sections, fmt: doc.format)
  let body = if preamble_str != "" {
    "{preamble_str}\n\n{sections_str}"
  } else {
    sections_str
  }
  let result = "{header_str}{body}"
  if doc.format.trailing_newline { "{result}\n" } else { result }
}
