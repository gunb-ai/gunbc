// std/algebra.dag -- Algebraic structures from which type operations emerge.
//
// DESIGN PRINCIPLE: Operations are not listed on types — they emerge from
// the algebraic structure the type inhabits. Like Set.union falls out of
// Set<A> = A -> Bool (pointwise OR), Int.add falls out of Int inhabiting
// a commutative ring (additive monoid operation).
//
// The compiler reads algebraic inhabitation from type declarations:
//   is_int_type_node(n)   → inhabits_ring(n)      → arithmetic ops
//   is_bool_type_node(n)  → inhabits_lattice(n)    → logic ops
//   is_string_type_node(n)→ inhabits_monoid(n)     → concat, length
//
// ALGEBRAIC HIERARCHY:
//
//   Magma ─── Semigroup ─── Monoid ─── CommutativeMonoid
//                                           │
//                            ┌──────────────┼──────────────┐
//                            │              │              │
//                        Semiring      Lattice      FreeMonoid<T>
//                            │              │
//                          Ring      BoundedLattice
//                            │              │
//                      OrderedRing   BooleanAlgebra
//                            │
//                         Field
//
// Each level adds axioms. A type that inhabits Ring automatically gets
// all Monoid, Semigroup, and Magma operations.
//
// EMERGENCE TABLE:
//
//   Structure           | Operations that fall out
//   --------------------|------------------------------------------
//   Magma               | op(T, T) -> T (closure)
//   Semigroup           | associativity: op(op(a,b), c) == op(a, op(b,c))
//   Monoid              | identity: op(identity, a) == a
//   CommutativeMonoid    | commutativity: op(a, b) == op(b, a)
//   Semiring            | add (CommMonoid) + mul (Monoid) + distribution
//   Ring                | add inverse (negate, subtract)
//   OrderedRing         | total order (compare, <, >, min, max, abs)
//   Field               | mul inverse (reciprocal, divide)
//   Lattice             | meet ∧ and join ∨ (both idempotent, absorptive)
//   BoundedLattice      | top (⊤) and bottom (⊥)
//   BooleanAlgebra      | complement (¬), distributive
//   FreeMonoid<T>       | concat + empty + length + positional access
//
// DENOTATIONAL GROUNDING:
//
//   Bool    inhabits BooleanAlgebra
//     Because: Bool = True | False, and {True, False} with ∧/∨/¬ is
//     the canonical two-element Boolean algebra.
//
//   Nat     inhabits CommutativeSemiring
//     Because: (Nat, +, 0) is a commutative monoid,
//              (Nat, *, 1) is a commutative monoid,
//              and * distributes over +.
//     No subtraction (no additive inverse in Nat).
//
//   Int     inhabits OrderedCommutativeRing
//     Because: Int extends Nat with additive inverses (negation).
//     (Int, +, 0) is an abelian group, (Int, *, 1) is a commutative monoid,
//     * distributes over +, and Int has a total order compatible with +.
//
//   Float   inhabits ApproximateField
//     Because: Float extends Int's ring with multiplicative inverses
//     (division), subject to IEEE 754 rounding. Not an exact field —
//     associativity of + fails for floating point. "Approximate" is honest.
//
//   String  inhabits FreeMonoid<Char>
//     Because: (String, concat, "") is a monoid, and String is the
//     free monoid over Char — every string is a unique sequence of
//     characters with no additional relations.
//
//   List<T> inhabits FreeMonoid<T>
//     Because: (List<T>, append, []) is a monoid, free over T.
//     String = List<Char> is the special case.
//
//   Set<A>  inhabits BooleanAlgebra<A>
//     Because: Set<A> = A -> Bool, and pointwise operations on Bool
//     lift to set operations: union = OR, intersect = AND, diff = AND-NOT.
//
//   Map<K,V> inhabits PartialFunction<K,V>
//     Because: Map<K,V> = K -> (1 + V), a partial function. Lookup is
//     function application. Merge requires conflict resolution because
//     two partial functions may disagree on a key.

module std.algebra

// =========================================================================
// Unary structures (single operation)
// =========================================================================

// Magma: a set with a closed binary operation.
// No laws beyond closure. The weakest algebraic structure.
type Magma<T> {
  op: fn(T, T) -> T
}

// Semigroup: associative magma.
// Law: op(op(a, b), c) == op(a, op(b, c))
type Semigroup<T> {
  op: fn(T, T) -> T
  // associativity is a law, not a field — enforced by the algebra, not stored
}

// Monoid: semigroup with identity element.
// Laws: op(identity, a) == a, op(a, identity) == a
type Monoid<T> {
  op: fn(T, T) -> T
  identity: T
}

// CommutativeMonoid: monoid where op(a, b) == op(b, a).
type CommutativeMonoid<T> {
  op: fn(T, T) -> T
  identity: T
  // commutativity is a law
}

// Group: monoid with inverses.
// Law: op(a, inverse(a)) == identity
type Group<T> {
  op: fn(T, T) -> T
  identity: T
  inverse: fn(T) -> T
}

// AbelianGroup: commutative group.
type AbelianGroup<T> {
  op: fn(T, T) -> T
  identity: T
  inverse: fn(T) -> T
  // commutativity is a law
}

// =========================================================================
// Ring-like structures (two operations: additive + multiplicative)
// =========================================================================

// Semiring: two monoids with distribution.
// (T, add, zero) is a commutative monoid.
// (T, mul, one) is a monoid.
// mul distributes over add: a * (b + c) == a*b + a*c
// zero annihilates: a * zero == zero
type Semiring<T> {
  add: fn(T, T) -> T
  zero: T
  mul: fn(T, T) -> T
  one: T
}

// Ring: semiring where (T, add, zero) is an abelian group.
// Adds: negate(T) -> T, subtract(T, T) -> T = add(a, negate(b))
type Ring<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
}

// OrderedRing: ring with a total order compatible with addition.
// Adds: compare(T, T) -> Ordering
// Derived: less_than, greater_than, min, max, abs
type OrderedRing<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  compare: fn(T, T) -> Ordering
}

// Field: ring where (T \ {zero}, mul, one) is an abelian group.
// Adds: reciprocal(T) -> T, divide(T, T) -> T = mul(a, reciprocal(b))
type Field<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  reciprocal: fn(T) -> T
  compare: fn(T, T) -> Ordering
}

// =========================================================================
// Lattice structures
// =========================================================================

// Lattice: two idempotent, commutative, associative operations with absorption.
// Laws: meet(a, join(a, b)) == a, join(a, meet(a, b)) == a
type Lattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
}

// BoundedLattice: lattice with top and bottom elements.
// Laws: meet(top, a) == a, join(bottom, a) == a
type BoundedLattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
  top: T
  bottom: T
}

// BooleanAlgebra: bounded distributive lattice with complement.
// Laws: meet(a, complement(a)) == bottom, join(a, complement(a)) == top
// This is the algebra of Bool, Set<A>, and propositions.
type BooleanAlgebra<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
  complement: fn(T) -> T
  top: T
  bottom: T
}

// =========================================================================
// Sequence/collection structures
// =========================================================================

// FreeMonoid<T>: the free monoid over element type T.
// Concretely: finite sequences (lists/strings) under concatenation.
// The "free" means: no additional relations beyond the monoid laws.
// Every element of FreeMonoid<T> is a unique finite sequence of T values.
//
// Operations that emerge:
//   concat(FreeMonoid<T>, FreeMonoid<T>) -> FreeMonoid<T>   (monoid op)
//   empty: FreeMonoid<T>                                     (identity)
//   length(FreeMonoid<T>) -> Nat                             (carrier count)
//   index(FreeMonoid<T>, Nat) -> T?                          (positional access)
//   slice(FreeMonoid<T>, Nat, Nat) -> FreeMonoid<T>          (subsequence)
//   map(FreeMonoid<T>, fn(T) -> U) -> FreeMonoid<U>          (functorial)
//   fold(FreeMonoid<T>, init: U, fn(U, T) -> U) -> U         (catamorphism)
//   filter(FreeMonoid<T>, fn(T) -> Bool) -> FreeMonoid<T>    (predicated subsequence)
//   reverse(FreeMonoid<T>) -> FreeMonoid<T>                  (anti-involution)
type FreeMonoid<T> {
  // Monoid operations
  concat: fn(FreeMonoid<T>, FreeMonoid<T>) -> FreeMonoid<T>
  empty: FreeMonoid<T>
  append: fn(T) -> FreeMonoid<T>
  // Positional access — falls out of the carrier being Fin(n) → T
  index: fn(Int) -> T
  slice: fn(Int, Int) -> FreeMonoid<T>
  length: fn() -> Int
  count: fn() -> Int
  first: fn() -> T?
  last: fn() -> T?
  // Catamorphic / functorial operations
  map: fn(fn(T) -> T) -> FreeMonoid<T>
  filter: fn(fn(T) -> Bool) -> FreeMonoid<T>
  fold: fn(T, fn(T, T) -> T) -> T
  flat_map: fn(fn(T) -> FreeMonoid<T>) -> FreeMonoid<T>
  any: fn(fn(T) -> Bool) -> Bool
  all: fn(fn(T) -> Bool) -> Bool
  // Structural transformations
  enumerate: fn() -> FreeMonoid<Tuple<Int, T>>
  reverse: fn() -> FreeMonoid<T>
  skip: fn(Int) -> FreeMonoid<T>
  take: fn(Int) -> FreeMonoid<T>
  sort_by: fn(fn(T, T) -> Int) -> FreeMonoid<T>
  contains: fn(T) -> Bool
}

// PartialFunction<K, V>: finite partial function (Map algebra).
// Map<K, V> = K -> (1 + V) — a function that may be undefined for some keys.
//
// Operations that emerge:
//   lookup(Map<K,V>, K) -> V?                    (function application)
//   insert(Map<K,V>, K, V) -> Map<K,V>           (extend domain)
//   delete(Map<K,V>, K) -> Map<K,V>              (restrict domain)
//   merge(Map<K,V>, Map<K,V>, fn(V,V)->V) -> Map<K,V>  (union with conflict)
//   keys(Map<K,V>) -> Set<K>                     (domain)
//   values(Map<K,V>) -> List<V>                  (range, repeated)
//   size(Map<K,V>) -> Nat                        (domain cardinality)
type PartialFunction<K, V> {
  lookup: fn(K) -> V?
  empty: PartialFunction<K, V>
  get: fn(K) -> V?
  insert: fn(K, V) -> PartialFunction<K, V>
  merge: fn(PartialFunction<K, V>) -> PartialFunction<K, V>
  keys: fn() -> FreeMonoid<K>
  values: fn() -> FreeMonoid<V>
  has: fn(K) -> Bool
  contains_key: fn(K) -> Bool
  size: fn() -> Int
}

// =========================================================================
// Ordering (used by OrderedRing and Field)
// =========================================================================

type Ordering = Less | Equal | Greater

// =========================================================================
// Derived operations (emerge from algebraic inhabitation)
// =========================================================================

// These are not new primitives — they are derived from the algebra.
// Listed here as the canonical derivation rules.

// From Ring:
//   subtract(a, b) = add(a, negate(b))
//
// From OrderedRing:
//   abs(a) = if compare(a, zero) == Less { negate(a) } else { a }
//   min(a, b) = if compare(a, b) == Less { a } else { b }
//   max(a, b) = if compare(a, b) == Greater { a } else { b }
//   less_than(a, b) = compare(a, b) == Less
//   greater_than(a, b) = compare(a, b) == Greater
//
// From Field:
//   divide(a, b) = mul(a, reciprocal(b))
//
// From BooleanAlgebra:
//   and(a, b)  = meet(a, b)
//   or(a, b)   = join(a, b)
//   not(a)     = complement(a)
//   xor(a, b)  = meet(join(a, b), complement(meet(a, b)))
//
// From FreeMonoid:
//   length(m)    = fold(m, init: 0, f: (acc, _) => acc + 1)
//   contains(m, x) = fold(m, init: false, f: (acc, e) => acc || e == x)

// =========================================================================
// Compiler bridge: algebraic enrichment profiles
//
// These types and data tables drive the compiler's kernel type enrichment.
// Each kernel type is mapped to an algebra profile; the compiler reads
// these declarations to materialize structural method fields (add, mul,
// concat, etc.) on kernel types during build_type_env.
//
// Canonical source: adding algebraic enrichment for a new kernel type
// requires one line in kernel_algebra_profile below.
// =========================================================================

type AlgebraProfile
  = OrderedRingProfile
  | ApproximateFieldProfile
  | BooleanAlgebraProfile
  | BooleanAlgebraCollectionProfile
  | FreeMonoidScalarProfile
  | FreeMonoidCollectionProfile
  | PartialFunctionProfile

type AlgebraTypeTemplate
  = ReceiverSelf
  | ReceiverElement
  | ReceiverKey
  | ReceiverValue
  | NamedTemplate { name: String }
  | ReceiverCollectionOf { element: AlgebraTypeTemplate }
  | ListOf { element: AlgebraTypeTemplate }
  | OptionalOf { inner: AlgebraTypeTemplate }
  | TupleOf { first: AlgebraTypeTemplate, second: AlgebraTypeTemplate }
  | CallableOf { params: List<AlgebraTypeTemplate>, return_type: AlgebraTypeTemplate }

type AlgebraFieldTemplate {
  name: String
  param_types: List<AlgebraTypeTemplate>
  return_type: AlgebraTypeTemplate
}

// Operation size effects — explicit contracts for complexity analysis.
// Each algebra method that affects collection size or extracts elements
// declares its effect here. The complexity analyzer consumes these facts
// as the single authority for descent evidence — no template-shape inference.
type CollectionSizeEffect
  = ShrinkEffect         // output collection strictly smaller than input (skip, take, substring)
  | ProjectionEffect     // extracts single element from collection (first, last)
  | IdentityEffect       // preserves structural children identity (filter, reverse, sort_by)

data algebra_size_effects: Map<String, CollectionSizeEffect> = {
  "skip": ShrinkEffect,
  "take": ShrinkEffect,
  "substring": ShrinkEffect,
  "first": ProjectionEffect,
  "last": ProjectionEffect,
  "filter": IdentityEffect,
  "reverse": IdentityEffect,
  "sort_by": IdentityEffect
}

fn lookup_algebra_size_effect(method_name: String) -> CollectionSizeEffect? {
  lookup(algebra_size_effects, key: method_name)
}

data kernel_algebra_profile: Map<String, AlgebraProfile> = {
  "Int": OrderedRingProfile,
  "Float": ApproximateFieldProfile,
  "Bool": BooleanAlgebraProfile,
  "String": FreeMonoidScalarProfile,
  "List": FreeMonoidCollectionProfile,
  "Set": BooleanAlgebraCollectionProfile,
  "NonEmptyList": FreeMonoidCollectionProfile,
  "NonEmptySet": BooleanAlgebraCollectionProfile,
  "Map": PartialFunctionProfile
}

fn ordered_ring_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "add", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "zero", param_types: [], return_type: ReceiverSelf },
    { name: "negate", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "mul", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "one", param_types: [], return_type: ReceiverSelf },
    { name: "compare", param_types: [ReceiverSelf, ReceiverSelf], return_type: NamedTemplate { name: "Ordering" } }
  ]
}

fn approximate_field_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "add", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "zero", param_types: [], return_type: ReceiverSelf },
    { name: "negate", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "mul", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "one", param_types: [], return_type: ReceiverSelf },
    { name: "reciprocal", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "compare", param_types: [ReceiverSelf, ReceiverSelf], return_type: NamedTemplate { name: "Ordering" } }
  ]
}

fn boolean_algebra_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "meet", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "join", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "complement", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "top", param_types: [], return_type: ReceiverSelf },
    { name: "bottom", param_types: [], return_type: ReceiverSelf }
  ]
}

// Set<A> inhabits BooleanAlgebra<A> applied pointwise: union = join,
// intersect = meet, diff = meet(a, complement(b)), member = element test.
// Unlike FreeMonoid collections, sets have no positional operations
// (append, sort_by, enumerate, reverse) — only algebraic + iteration ops.
fn boolean_algebra_collection_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "union", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "intersect", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "diff", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "member", param_types: [ReceiverSelf, ReceiverElement], return_type: NamedTemplate { name: "Bool" } },
    { name: "contains", param_types: [ReceiverSelf, ReceiverElement], return_type: NamedTemplate { name: "Bool" } },
    { name: "filter", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "map", param_types: [ReceiverSelf], return_type: ReceiverCollectionOf { element: NamedTemplate { name: "MappedElement" } } },
    { name: "flat_map", param_types: [ReceiverSelf], return_type: ReceiverCollectionOf { element: NamedTemplate { name: "MappedElement" } } },
    { name: "fold", param_types: [NamedTemplate { name: "FoldAccumulator" }], return_type: NamedTemplate { name: "FoldAccumulator" } },
    { name: "any", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Bool" } },
    { name: "all", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Bool" } },
    { name: "count", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Int" } },
    { name: "length", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Int" } }
  ]
}

fn free_monoid_scalar_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "concat", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "empty", param_types: [], return_type: ReceiverSelf },
    { name: "length", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Int" } },
    { name: "chars", param_types: [ReceiverSelf], return_type: ListOf { element: NamedTemplate { name: "Int" } } },
    { name: "split", param_types: [ReceiverSelf, ReceiverSelf], return_type: ListOf { element: ReceiverSelf } },
    { name: "join", param_types: [ListOf { element: ReceiverSelf }, ReceiverSelf], return_type: ReceiverSelf },
    { name: "contains", param_types: [ReceiverSelf, ReceiverSelf], return_type: NamedTemplate { name: "Bool" } },
    { name: "starts_with", param_types: [ReceiverSelf, ReceiverSelf], return_type: NamedTemplate { name: "Bool" } },
    { name: "ends_with", param_types: [ReceiverSelf, ReceiverSelf], return_type: NamedTemplate { name: "Bool" } },
    { name: "trim", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "to_lower", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "to_upper", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "replace", param_types: [ReceiverSelf, ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "substring", param_types: [ReceiverSelf, NamedTemplate { name: "Int" }, NamedTemplate { name: "Int" }], return_type: ReceiverSelf },
    { name: "to_int", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Int" } },
    { name: "to_string", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "reverse", param_types: [ReceiverSelf], return_type: ReceiverSelf }
  ]
}

fn free_monoid_collection_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "map", param_types: [ReceiverSelf], return_type: ReceiverCollectionOf { element: NamedTemplate { name: "MappedElement" } } },
    { name: "filter", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "flat_map", param_types: [ReceiverSelf], return_type: ReceiverCollectionOf { element: NamedTemplate { name: "MappedElement" } } },
    { name: "fold", param_types: [NamedTemplate { name: "FoldAccumulator" }], return_type: NamedTemplate { name: "FoldAccumulator" } },
    { name: "any", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Bool" } },
    { name: "all", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Bool" } },
    { name: "count", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Int" } },
    { name: "first", param_types: [ReceiverSelf], return_type: OptionalOf { inner: ReceiverElement } },
    { name: "last", param_types: [ReceiverSelf], return_type: OptionalOf { inner: ReceiverElement } },
    { name: "skip", param_types: [ReceiverSelf, NamedTemplate { name: "Int" }], return_type: ReceiverSelf },
    { name: "take", param_types: [ReceiverSelf, NamedTemplate { name: "Int" }], return_type: ReceiverSelf },
    { name: "sort_by", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "append", param_types: [ReceiverSelf, ReceiverElement], return_type: ReceiverSelf },
    { name: "contains", param_types: [ReceiverSelf, ReceiverElement], return_type: NamedTemplate { name: "Bool" } },
    { name: "enumerate", param_types: [ReceiverSelf], return_type: ReceiverCollectionOf { element: TupleOf { first: NamedTemplate { name: "Int" }, second: ReceiverElement } } },
    { name: "reverse", param_types: [ReceiverSelf], return_type: ReceiverSelf },
    { name: "join", param_types: [ReceiverSelf, NamedTemplate { name: "String" }], return_type: NamedTemplate { name: "String" } },
    { name: "concat", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "list_push", param_types: [ReceiverSelf, ReceiverElement], return_type: ReceiverSelf },
    { name: "length", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Int" } }
  ]
}

fn partial_function_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "get", param_types: [ReceiverSelf, ReceiverKey], return_type: OptionalOf { inner: ReceiverValue } },
    { name: "map_get", param_types: [ReceiverSelf, ReceiverKey], return_type: OptionalOf { inner: ReceiverValue } },
    { name: "lookup", param_types: [ReceiverSelf, ReceiverKey], return_type: OptionalOf { inner: ReceiverValue } },
    { name: "map_insert", param_types: [ReceiverSelf, ReceiverKey, ReceiverValue], return_type: ReceiverSelf },
    { name: "map_merge", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf },
    { name: "has", param_types: [ReceiverSelf, ReceiverKey], return_type: NamedTemplate { name: "Bool" } },
    { name: "map_has", param_types: [ReceiverSelf, ReceiverKey], return_type: NamedTemplate { name: "Bool" } },
    { name: "map_contains_key", param_types: [ReceiverSelf, ReceiverKey], return_type: NamedTemplate { name: "Bool" } },
    { name: "keys", param_types: [ReceiverSelf], return_type: ListOf { element: ReceiverKey } },
    { name: "map_keys", param_types: [ReceiverSelf], return_type: ListOf { element: ReceiverKey } },
    { name: "values", param_types: [ReceiverSelf], return_type: ListOf { element: ReceiverValue } },
    { name: "map_values", param_types: [ReceiverSelf], return_type: ListOf { element: ReceiverValue } },
    { name: "with", param_types: [ReceiverSelf, ReceiverKey, ReceiverValue], return_type: ReceiverSelf },
    { name: "contains", param_types: [ReceiverSelf, ReceiverKey], return_type: NamedTemplate { name: "Bool" } },
    { name: "length", param_types: [ReceiverSelf], return_type: NamedTemplate { name: "Int" } }
  ]
}

fn algebra_templates_for_profile(profile: AlgebraProfile) -> List<AlgebraFieldTemplate> {
  match profile {
    OrderedRingProfile => ordered_ring_templates()
    ApproximateFieldProfile => approximate_field_templates()
    BooleanAlgebraProfile => boolean_algebra_templates()
    BooleanAlgebraCollectionProfile => boolean_algebra_collection_templates()
    FreeMonoidScalarProfile => free_monoid_scalar_templates()
    FreeMonoidCollectionProfile => free_monoid_collection_templates()
    PartialFunctionProfile => partial_function_templates()
  }
}
