// std/algebra.dag -- Algebraic structures from which type operations emerge.
//
// DESIGN PRINCIPLE: Operations are not listed on types — they emerge from
// the algebraic structure the type inhabits. Like Set.union falls out of
// Set<A> = A -> Bool (pointwise OR), Int.add falls out of Int inhabiting
// a commutative ring (additive monoid operation).
//
// The compiler reads algebraic inhabitation from type declarations:
//   is_int_type_node(n)   → inhabits_ring(n)      → arithmetic ops
//   is_bool_type_node(n)  → inhabits_lattice(n)    → logic ops
//   is_string_type_node(n)→ inhabits_monoid(n)     → concat, length
//
// ALGEBRAIC HIERARCHY:
//
//   Magma ─── Semigroup ─── Monoid ─── CommutativeMonoid
//                                           │
//                            ┌──────────────┼──────────────┐
//                            │              │              │
//                        Semiring      Lattice      FreeMonoid<T>
//                            │              │
//                          Ring      BoundedLattice
//                            │              │
//                      OrderedRing   BooleanAlgebra
//                            │
//                         Field
//
// Each level adds axioms. A type that inhabits Ring automatically gets
// all Monoid, Semigroup, and Magma operations.
//
// EMERGENCE TABLE:
//
//   Structure           | Operations that fall out
//   --------------------|------------------------------------------
//   Magma               | op(T, T) -> T (closure)
//   Semigroup           | associativity: op(op(a,b), c) == op(a, op(b,c))
//   Monoid              | identity: op(identity, a) == a
//   CommutativeMonoid    | commutativity: op(a, b) == op(b, a)
//   Semiring            | add (CommMonoid) + mul (Monoid) + distribution
//   Ring                | add inverse (negate, subtract)
//   OrderedRing         | total order (compare, <, >, min, max, abs)
//   Field               | mul inverse (reciprocal, divide)
//   Lattice             | meet ∧ and join ∨ (both idempotent, absorptive)
//   BoundedLattice      | top (⊤) and bottom (⊥)
//   BooleanAlgebra      | complement (¬), distributive
//   FreeMonoid<T>       | concat + empty + length + positional access
//
// DENOTATIONAL GROUNDING:
//
//   Bool    inhabits BooleanAlgebra
//     Because: Bool = True | False, and {True, False} with ∧/∨/¬ is
//     the canonical two-element Boolean algebra.
//
//   Nat     inhabits CommutativeSemiring
//     Because: (Nat, +, 0) is a commutative monoid,
//              (Nat, *, 1) is a commutative monoid,
//              and * distributes over +.
//     No subtraction (no additive inverse in Nat).
//
//   Int     inhabits OrderedCommutativeRing
//     Because: Int extends Nat with additive inverses (negation).
//     (Int, +, 0) is an abelian group, (Int, *, 1) is a commutative monoid,
//     * distributes over +, and Int has a total order compatible with +.
//
//   Float   inhabits ApproximateField
//     Because: Float extends Int's ring with multiplicative inverses
//     (division), subject to IEEE 754 rounding. Not an exact field —
//     associativity of + fails for floating point. "Approximate" is honest.
//
//   String  inhabits FreeMonoid<Char>
//     Because: (String, concat, "") is a monoid, and String is the
//     free monoid over Char — every string is a unique sequence of
//     characters with no additional relations.
//
//   List<T> inhabits FreeMonoid<T>
//     Because: (List<T>, append, []) is a monoid, free over T.
//     String = List<Char> is the special case.
//
//   Set<A>  inhabits BooleanAlgebra<A>
//     Because: Set<A> = A -> Bool, and pointwise operations on Bool
//     lift to set operations: union = OR, intersect = AND, diff = AND-NOT.
//
//   Map<K,V> inhabits PartialFunction<K,V>
//     Because: Map<K,V> = K -> (1 + V), a partial function. Lookup is
//     function application. Merge requires conflict resolution because
//     two partial functions may disagree on a key.

module std.algebra

// =========================================================================
// Unary structures (single operation)
// =========================================================================

// Magma: a set with a closed binary operation.
// No laws beyond closure. The weakest algebraic structure.
type Magma<T> {
  op: fn(T, T) -> T
}

// Semigroup: associative magma.
// Law: op(op(a, b), c) == op(a, op(b, c))
type Semigroup<T> {
  op: fn(T, T) -> T
  // associativity is a law, not a field — enforced by the algebra, not stored
}

// Monoid: semigroup with identity element.
// Laws: op(identity, a) == a, op(a, identity) == a
type Monoid<T> {
  op: fn(T, T) -> T
  identity: T
}

// CommutativeMonoid: monoid where op(a, b) == op(b, a).
type CommutativeMonoid<T> {
  op: fn(T, T) -> T
  identity: T
  // commutativity is a law
}

// Group: monoid with inverses.
// Law: op(a, inverse(a)) == identity
type Group<T> {
  op: fn(T, T) -> T
  identity: T
  inverse: fn(T) -> T
}

// AbelianGroup: commutative group.
type AbelianGroup<T> {
  op: fn(T, T) -> T
  identity: T
  inverse: fn(T) -> T
  // commutativity is a law
}

// =========================================================================
// Ring-like structures (two operations: additive + multiplicative)
// =========================================================================

// Semiring: two monoids with distribution.
// (T, add, zero) is a commutative monoid.
// (T, mul, one) is a monoid.
// mul distributes over add: a * (b + c) == a*b + a*c
// zero annihilates: a * zero == zero
type Semiring<T> {
  add: fn(T, T) -> T
  zero: T
  mul: fn(T, T) -> T
  one: T
}

// Ring: semiring where (T, add, zero) is an abelian group.
// Adds: negate(T) -> T, subtract(T, T) -> T = add(a, negate(b))
type Ring<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
}

// OrderedRing: ring with a total order compatible with addition.
// Adds: compare(T, T) -> Ordering
// Derived: less_than, greater_than, min, max, abs
type OrderedRing<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  compare: fn(T, T) -> Ordering
}

// Field: ring where (T \ {zero}, mul, one) is an abelian group.
// Adds: reciprocal(T) -> T, divide(T, T) -> T = mul(a, reciprocal(b))
type Field<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  reciprocal: fn(T) -> T
  compare: fn(T, T) -> Ordering
}

// =========================================================================
// Lattice structures
// =========================================================================

// Lattice: two idempotent, commutative, associative operations with absorption.
// Laws: meet(a, join(a, b)) == a, join(a, meet(a, b)) == a
type Lattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
}

// BoundedLattice: lattice with top and bottom elements.
// Laws: meet(top, a) == a, join(bottom, a) == a
type BoundedLattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
  top: T
  bottom: T
}

// BooleanAlgebra: bounded distributive lattice with complement.
// Laws: meet(a, complement(a)) == bottom, join(a, complement(a)) == top
// This is the algebra of Bool, Set<A>, and propositions.
type BooleanAlgebra<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
  complement: fn(T) -> T
  top: T
  bottom: T
}

// =========================================================================
// Sequence/collection structures
// =========================================================================

// FreeMonoid<T>: the free monoid over element type T.
// Concretely: finite sequences (lists/strings) under concatenation.
// The "free" means: no additional relations beyond the monoid laws.
// Every element of FreeMonoid<T> is a unique finite sequence of T values.
//
// Operations that emerge:
//   concat(FreeMonoid<T>, FreeMonoid<T>) -> FreeMonoid<T>   (monoid op)
//   empty: FreeMonoid<T>                                     (identity)
//   length(FreeMonoid<T>) -> Nat                             (carrier count)
//   index(FreeMonoid<T>, Nat) -> T?                          (positional access)
//   slice(FreeMonoid<T>, Nat, Nat) -> FreeMonoid<T>          (subsequence)
//   map(FreeMonoid<T>, fn(T) -> U) -> FreeMonoid<U>          (functorial)
//   fold(FreeMonoid<T>, init: U, fn(U, T) -> U) -> U         (catamorphism)
//   filter(FreeMonoid<T>, fn(T) -> Bool) -> FreeMonoid<T>    (predicated subsequence)
//   reverse(FreeMonoid<T>) -> FreeMonoid<T>                  (anti-involution)
type FreeMonoid<T> {
  // Monoid operations
  concat: fn(FreeMonoid<T>, FreeMonoid<T>) -> FreeMonoid<T>
  empty: FreeMonoid<T>
  append: fn(T) -> FreeMonoid<T>
  // Positional access — falls out of the carrier being Fin(n) → T
  index: fn(Int) -> T
  slice: fn(Int, Int) -> FreeMonoid<T>
  length: fn() -> Int
  count: fn() -> Int
  first: fn() -> T?
  last: fn() -> T?
  // Catamorphic / functorial operations
  map: fn(fn(T) -> T) -> FreeMonoid<T>
  filter: fn(fn(T) -> Bool) -> FreeMonoid<T>
  fold: fn(T, fn(T, T) -> T) -> T
  flat_map: fn(fn(T) -> FreeMonoid<T>) -> FreeMonoid<T>
  any: fn(fn(T) -> Bool) -> Bool
  all: fn(fn(T) -> Bool) -> Bool
  // Structural transformations
  enumerate: fn() -> FreeMonoid<Tuple<Int, T>>
  reverse: fn() -> FreeMonoid<T>
  skip: fn(Int) -> FreeMonoid<T>
  take: fn(Int) -> FreeMonoid<T>
  sort_by: fn(fn(T, T) -> Int) -> FreeMonoid<T>
  contains: fn(T) -> Bool
}

// PartialFunction<K, V>: finite partial function (Map algebra).
// Map<K, V> = K -> (1 + V) — a function that may be undefined for some keys.
//
// Operations that emerge:
//   lookup(Map<K,V>, K) -> V?                    (function application)
//   insert(Map<K,V>, K, V) -> Map<K,V>           (extend domain)
//   delete(Map<K,V>, K) -> Map<K,V>              (restrict domain)
//   merge(Map<K,V>, Map<K,V>, fn(V,V)->V) -> Map<K,V>  (union with conflict)
//   keys(Map<K,V>) -> Set<K>                     (domain)
//   values(Map<K,V>) -> List<V>                  (range, repeated)
//   size(Map<K,V>) -> Nat                        (domain cardinality)
type PartialFunction<K, V> {
  lookup: fn(K) -> V?
  empty: PartialFunction<K, V>
  get: fn(K) -> V?
  insert: fn(K, V) -> PartialFunction<K, V>
  merge: fn(PartialFunction<K, V>) -> PartialFunction<K, V>
  keys: fn() -> FreeMonoid<K>
  values: fn() -> FreeMonoid<V>
  has: fn(K) -> Bool
  contains_key: fn(K) -> Bool
  size: fn() -> Int
}

// =========================================================================
// Ordering (used by OrderedRing and Field)
// =========================================================================

type Ordering = Less | Equal | Greater

// =========================================================================
// Derived operations (emerge from algebraic inhabitation)
// =========================================================================

// These are not new primitives — they are derived from the algebra.
// Listed here as the canonical derivation rules.

// From Ring:
//   subtract(a, b) = add(a, negate(b))
//
// From OrderedRing:
//   abs(a) = if compare(a, zero) == Less { negate(a) } else { a }
//   min(a, b) = if compare(a, b) == Less { a } else { b }
//   max(a, b) = if compare(a, b) == Greater { a } else { b }
//   less_than(a, b) = compare(a, b) == Less
//   greater_than(a, b) = compare(a, b) == Greater
//
// From Field:
//   divide(a, b) = mul(a, reciprocal(b))
//
// From BooleanAlgebra:
//   and(a, b)  = meet(a, b)
//   or(a, b)   = join(a, b)
//   not(a)     = complement(a)
//   xor(a, b)  = meet(join(a, b), complement(meet(a, b)))
//
// From FreeMonoid:
//   length(m)    = fold(m, init: 0, f: (acc, _) => acc + 1)
//   contains(m, x) = fold(m, init: false, f: (acc, e) => acc || e == x)
