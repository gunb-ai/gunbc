// std/reducible.dag — fail-closed three-valued reduction verdict (objective primitive).
//
// Promoted from ctrl plans.reducible (gunb-ai/ctrl PR #1716 relocation target).
// CONSUMES compute_fabric.PartitionedReduce by correspondence only — declares
// NO map/reduce types; binding literal PartitionedReduce fields is a dissolution
// trigger (snappy-stag: Option-in-v2 + Measure G1).
//
// VERDICT (DESIGN.md §5):
//   Reduced { parts }       — decomposed / progressed
//   Irreducible { witness } — grounded atom, decisively not further reducible
//   Unknown { missing }     — fail-closed; located axis names what is missing
//
// ALGEBRA: (ReduceVerdict, reduce_verdict_combine, _) forms a join with Unknown
// as absorbing element (first located axis preserved — the latch). The fold init
// uses started-flag discipline: init Unknown is NOT absorbing; empty fold stays
// decisively Unknown, never fabricated-green.

module std.reducible

import std.algebra { Monoid }
import std.types { NonEmptyStr, Int, Bool, List }

type ReduceVerdict
  = Reduced { parts: Int }
  | Irreducible { witness: String }
  | Unknown { missing: String }

// Join with located latch: Unknown absorbs; first located axis wins; decisive
// siblings otherwise adopt the right-hand verdict (last green child wins).
fn reduce_verdict_combine(a: ReduceVerdict, b: ReduceVerdict) -> ReduceVerdict {
  match a {
    Unknown { missing: ma } => Unknown { missing: ma }
    _ => match b {
      Unknown { missing: mb } => Unknown { missing: mb }
      _ => b
    }
  }
}

fn reduce_verdict_monoid() -> Monoid<ReduceVerdict> {
  Monoid {
    op: reduce_verdict_combine,
    identity: Reduced { parts: 0 }
  }
}

fn verdict_is_unknown(v: ReduceVerdict) -> Bool {
  match v {
    Unknown { missing: m } => true
    Reduced { parts: p } => false
    Irreducible { witness: w } => false
  }
}

fn verdict_is_irreducible(v: ReduceVerdict) -> Bool {
  match v {
    Irreducible { witness: w } => true
    Reduced { parts: p } => false
    Unknown { missing: m } => false
  }
}

fn verdict_is_reduced(v: ReduceVerdict) -> Bool {
  match v {
    Reduced { parts: p } => true
    Irreducible { witness: w } => false
    Unknown { missing: m } => false
  }
}

fn verdict_eq(a: ReduceVerdict, b: ReduceVerdict) -> Bool {
  match a {
    Reduced { parts: pa } => match b {
      Reduced { parts: pb } => pa == pb
      Irreducible { witness: wb } => false
      Unknown { missing: mb } => false
    }
    Irreducible { witness: wa } => match b {
      Reduced { parts: pb } => false
      Irreducible { witness: wb } => wa == wb
      Unknown { missing: mb } => false
    }
    Unknown { missing: ma } => match b {
      Reduced { parts: pb } => false
      Irreducible { witness: wb } => false
      Unknown { missing: mb } => ma == mb
    }
  }
}

// Located fold accumulator — started/in-progress discipline so init Unknown is
// NOT absorbing (the spine / workflow gate guards this).
type LocatedVerdictFoldAcc {
  started: Bool
  verdict: ReduceVerdict
}

fn fold_located_verdict(acc: LocatedVerdictFoldAcc, next: ReduceVerdict) -> LocatedVerdictFoldAcc {
  if acc.started {
    if verdict_is_unknown(acc.verdict) {
      acc
    } else {
      LocatedVerdictFoldAcc { started: true, verdict: next }
    }
  } else {
    LocatedVerdictFoldAcc { started: true, verdict: next }
  }
}

fn fold_located_verdicts(verdicts: List<ReduceVerdict>, empty_missing: String) -> ReduceVerdict {
  let acc = fold(
    verdicts,
    init: LocatedVerdictFoldAcc {
      started: false,
      verdict: Unknown { missing: empty_missing }
    },
    f: fn(a, v) { fold_located_verdict(acc: a, next: v) }
  )
  acc.verdict
}

// §5 primitive: empty witness -> Unknown; named witness -> grounded atom.
fn classify_leaf(witness: String) -> ReduceVerdict {
  if witness == "" {
    Unknown { missing: "witness" }
  } else {
    Irreducible { witness: witness }
  }
}
