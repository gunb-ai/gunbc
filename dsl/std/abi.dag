// std/abi.dag — arch-agnostic ABI vocabulary for the §10 execution-contract layer.
//
// Scope: SyscallRole (closed map domain), ArchitecturalRegister (open atom identity), and
// CallingConvention (total role→register map shape). Cited per-arch register atoms inhabit
// ArchitecturalRegister in extdeps/runtime/abi/*.dag (M3); std never names amd64.
//
// Uses only Int / Bool / NonEmptyStr / List / records / enums — no distribution-enum imports.

module std.abi

import std.types { Bool, NonEmptyStr }

// Closed arch-agnostic syscall-role domain (the map keys).
// 🟢 terminal — irreducible role distinctions at the ABI boundary (arg slot vs nr vs return).
type SyscallRole = Arg0 | Arg1 | Arg2 | Arg3 | Arg4 | Arg5 | SyscallNumber | ReturnValue

// Open register atom identity (a node). Per-arch cited atoms (e.g. Amd64Gpr) inhabit this in
// extdeps — identity only; register name is an attribute of the cited atom, not a string key.
type ArchitecturalRegister

// Total SyscallRole → ArchitecturalRegister map (totality by construction; one field per role).
type CallingConvention {
  arg0: ArchitecturalRegister
  arg1: ArchitecturalRegister
  arg2: ArchitecturalRegister
  arg3: ArchitecturalRegister
  arg4: ArchitecturalRegister
  arg5: ArchitecturalRegister
  syscall_number: ArchitecturalRegister
  return_value: ArchitecturalRegister
}

// Stack growth direction for stack-based conventions (function-call ABIs land in later slices).
type StackLayout {
  grows_down: Bool
}
