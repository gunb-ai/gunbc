// Directed graph algebra: adjacency representation, DFS, SCC detection.
//
// Provides Kosaraju's algorithm for strongly connected component detection
// on string-labeled directed graphs. Used by the complexity analyzer for
// termination proof validation and parser mutual recursion analysis.

module std.graph

import std.termination {
  ProofEdge,
  DescentEvidence, Strict, NonIncreasing, DescentUnknown,
  TerminationProof
}

type GraphEdge {
  caller: String
  callee: String
}

// Single-authority graph representation: edges are the stored fact.
// Forward and reverse adjacency maps are derived views, not fields that can
// drift independently.
// M4 note: String keys are a textual identity proxy. Post-M4, vertices
// M4 debt: String keys are textual identity proxies. Post-M4, vertices
// should be structural Node references so SCC/cycle facts derive from
// structure, not name equality. Currently safe because function names
// are module-qualified from the typed IR (no collisions within a
// compilation unit). Blocked on Map<K,V> supporting non-String keys.
type CallGraph {
  edges: List<GraphEdge>
}

type CallGraphAdjacencyViews {
  forward: Map<String, List<String>>
  reverse: Map<String, List<String>>
}

// DFS accumulator for Kosaraju pass 1: finish order computation.
type DfsFinishAcc {
  visited: Set<String>
  order: List<String>
}

// DFS accumulator for Kosaraju pass 2: component collection.
type SccComponentAcc {
  visited: Set<String>
  members: List<String>
}

// SCC cycle detection result.
type SccCycleAcc {
  visited: Set<String>
  has_cycle: Bool
}

// Initialize an adjacency map with empty neighbor lists for all names.
fn seed_adjacency_map(names: List<String>) -> Map<String, List<String>> {
  names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, [])
  )
}

// Build a call graph from ProofEdge values. Self-loops are excluded
// (they are handled separately by cycle detection callers).
fn build_call_graph_from_proof_edges(names: List<String>, edges: List<ProofEdge>) -> CallGraph {
  CallGraph {
    edges: edges
      |> filter(e => e.caller != e.callee)
      |> map(e => GraphEdge { caller: e.caller, callee: e.callee })
  }
}

fn build_adjacency_views(names: List<String>, graph: CallGraph) -> CallGraphAdjacencyViews {
  let initial_forward = seed_adjacency_map(names: names)
  let initial_reverse = seed_adjacency_map(names: names)
  graph.edges |> fold(init: CallGraphAdjacencyViews { forward: initial_forward, reverse: initial_reverse }, f: (acc, edge) =>
    let forward_neighbors = match map_get(acc.forward, edge.caller) {
      Present { value: ns } => concat(ns, [edge.callee])
      Absent => [edge.callee]
    }
    let reverse_neighbors = match map_get(acc.reverse, edge.callee) {
      Present { value: ns } => concat(ns, [edge.caller])
      Absent => [edge.caller]
    }
    CallGraphAdjacencyViews {
      forward: map_insert(acc.forward, edge.caller, forward_neighbors),
      reverse: map_insert(acc.reverse, edge.callee, reverse_neighbors)
    }
  )
}

fn forward_adjacency(names: List<String>, graph: CallGraph) -> Map<String, List<String>> {
  build_adjacency_views(names: names, graph: graph).forward
}

fn reverse_adjacency(names: List<String>, graph: CallGraph) -> Map<String, List<String>> {
  build_adjacency_views(names: names, graph: graph).reverse
}

// Kosaraju pass 1: DFS on forward graph to compute finish order.
// REVIEW #8: Uses recursion bounded by visited set (|V| - |visited| decreases
// each step). Termination is structural but not expressible as a fold over a
// fixed collection. Fix: worklist-based iteration (requires repeat/while
// primitive from ROADMAP I1/I2). Origin: graph DFS is inherently stack-based;
// the .dag language lacks a stack-drain primitive.
fn dfs_finish_order(node: String, adjacency: Map<String, List<String>>, acc: DfsFinishAcc) -> DfsFinishAcc {
  if set_contains(acc.visited, node) {
    acc
  } else {
    let next_visited = set_insert(acc.visited, node)
    let neighbors = match map_get(adjacency, node) {
      Present { value: ns } => ns
      Absent => []
    }
    let explored = neighbors |> fold(init: DfsFinishAcc { visited: next_visited, order: acc.order }, f: (inner, neighbor) =>
      dfs_finish_order(node: neighbor, adjacency: adjacency, acc: inner)
    )
    DfsFinishAcc { visited: explored.visited, order: explored.order |> list_push(node) }
  }
}

// Kosaraju pass 2: DFS on reverse graph to collect component members.
// REVIEW #9: Same visited-set-bounded recursion as dfs_finish_order.
// Same fix direction: worklist iteration (ROADMAP I1/I2).
fn dfs_collect_component(node: String, adjacency: Map<String, List<String>>, acc: SccComponentAcc) -> SccComponentAcc {
  if set_contains(acc.visited, node) {
    acc
  } else {
    let next_visited = set_insert(acc.visited, node)
    let next_members = acc.members |> list_push(node)
    let neighbors = match map_get(adjacency, node) {
      Present { value: ns } => ns
      Absent => []
    }
    neighbors |> fold(init: SccComponentAcc { visited: next_visited, members: next_members }, f: (inner, neighbor) =>
      dfs_collect_component(node: neighbor, adjacency: adjacency, acc: inner)
    )
  }
}

// Detect whether the graph contains a strongly connected component with
// more than one node (Kosaraju's algorithm: 2-pass DFS).
fn graph_has_multi_node_scc(names: List<String>, graph: CallGraph) -> Bool {
  let adjacency = build_adjacency_views(names: names, graph: graph)
  let finish = names |> fold(init: DfsFinishAcc { visited: empty_set(), order: [] }, f: (acc, name) =>
    dfs_finish_order(node: name, adjacency: adjacency.forward, acc: acc)
  )
  let result = finish.order |> reverse |> fold(init: SccCycleAcc { visited: empty_set(), has_cycle: false }, f: (acc, name) =>
    if acc.has_cycle || set_contains(acc.visited, name) {
      acc
    } else {
      let component = dfs_collect_component(node: name, adjacency: adjacency.reverse, acc: SccComponentAcc { visited: acc.visited, members: [] })
      SccCycleAcc {
        visited: component.visited,
        has_cycle: (component.members |> count) > 1
      }
    }
  )
  result.has_cycle
}

// =========================================================================
// Termination proof validation
// =========================================================================

// Check if a lexicographic proof edge is descending:
// first Strict dimension wins; all higher dimensions must be NonIncreasing.
fn is_lexicographic_descent(evidence: List<DescentEvidence>) -> Bool {
  match evidence |> first {
    Absent => false  // no dimensions = no proof
    Present { value: e } =>
      match e {
        Strict => true
        NonIncreasing => is_lexicographic_descent(evidence: evidence |> skip(1))
        DescentUnknown => false
      }
  }
}

// Verify a termination proof: every cycle must have lexicographic descent.
// Algorithm: the subgraph of non-descending edges must be acyclic.
// A non-descending self-loop (caller == callee) IS a cycle.
// CX-P: validates proof.dimensions against edge evidence — mismatched
// evidence lengths are treated as non-descending (fail-closed).
fn is_valid_proof(proof: TerminationProof, edges: List<ProofEdge>) -> Bool {
  let expected_dims = proof.dimensions |> count
  let non_descending = edges |> filter(e =>
    (e.evidence |> count != expected_dims) || is_lexicographic_descent(evidence: e.evidence) == false
  )
  let has_self_cycle = non_descending |> any(e => e.caller == e.callee)
  if has_self_cycle { false }
  else {
    let members = edges |> flat_map(e => [e.caller, e.callee])
    let nd_graph = build_call_graph_from_proof_edges(names: members, edges: non_descending)
    graph_has_multi_node_scc(names: members, graph: nd_graph) == false
  }
}
