// std/render.dag -- Rendering domain types, composition, and primitives.
//
// The unified rendering layer. Two halves:
//
//   1. Terminal rendering IR -- Span, Line, Frame, Viewport with
//      width-constrained composition.  Mirrors Rust IR structs in
//      core/ir/src/render_ir.rs.
//
//   2. File-format rendering -- format-aware primitives derived from
//      language models (languages.dag), plus generic structured-text
//      building blocks (indentation, key-value pairs, list items,
//      blocks) that format-specific modules parameterize.
//
// Format-specific modules (extdeps/yaml.dag, std/markdown_render.dag)
// are thin wrappers that fix the parameters (indent unit, kv separator,
// list prefix) for their format.

module std.render

import std.width { truncate_text }
import std.unicode { string_display_width }
import std.symbols { SemanticColor, SymbolId, Tier, resolve_symbol }
import std.languages { CommentSyntax, ConfigFormat, Language }

// ===================================================================
// Terminal rendering IR
// ===================================================================

type SpanStyle {
  color: SemanticColor?
  bold: Bool
  italic: Bool
  symbol: SymbolId?
}

type RenderMode = Standard | Dynamic | Compact

type Span {
  text: String
  style: SpanStyle
}

type Line {
  spans: List<Span>
  indent: Int
  max_width: Int?
}

type CursorAction = Overwrite | Append | Clear

type Frame {
  lines: List<Line>
  cursor_action: CursorAction
}

type ViewportUnit = Chars | Pixels

type Viewport {
  width: Int
  height: Int
  unit: ViewportUnit
}

// -- Width-constrained composition ----------------------------------

fn span_width(span: Span, tier: Tier) -> Int? {
  let text_w = string_display_width(s: span.text)
  match span.style.symbol {
    null => Some { value: text_w }
    sym  => match resolve_symbol(id: sym, tier: tier) {
      Some { value: s } => Some { value: text_w + string_display_width(s: s) }
      None => none
    }
  }
}

fn truncate_spans(spans: List<Span>, budget: Int, tier: Tier) -> List<Span>? {
  let state = fold(spans,
    init: Some { value: { kept: [], remaining: budget } },
    f: (acc, span) => match acc {
      None => none
      Some { value: st } =>
        if st.remaining <= 0 {
          acc
        } else {
          match span_width(span: span, tier: tier) {
            Some { value: w } =>
              if w <= st.remaining {
                Some { value: { kept: concat(st.kept, [span]), remaining: st.remaining - w } }
              } else {
                Some { value: { kept: concat(st.kept, [Span { text: truncate_text(text: span.text, max_width: st.remaining), style: span.style }]), remaining: 0 } }
              }
            None => none
          }
        }
    }
  )
  match state {
    Some { value: s } => Some { value: s.kept }
    None => none
  }
}

fn constrain_line(line: Line, max_width: Int, tier: Tier) -> Line? {
  let indent_width = line.indent * 4
  let budget = max_width - indent_width
  if budget <= 0 { return Some { value: Line { spans: [], indent: line.indent, max_width: max_width } } }
  match truncate_spans(spans: line.spans, budget: budget, tier: tier) {
    Some { value: spans } => Some { value: Line { spans: spans, indent: line.indent, max_width: max_width } }
    None => none
  }
}

fn constrain_frame(frame: Frame, viewport: Viewport, tier: Tier) -> Frame? {
  let result = fold(frame.lines,
    init: Some { value: [] },
    f: (acc, line) => match acc {
      None => none
      Some { value: lines } =>
        match constrain_line(line: line, max_width: viewport.width, tier: tier) {
          Some { value: l } => Some { value: concat(lines, [l]) }
          None => none
        }
    }
  )
  match result {
    Some { value: lines } => Some { value: Frame { lines: lines, cursor_action: frame.cursor_action } }
    None => none
  }
}

// ===================================================================
// Format-aware primitives (language model -> rendering)
// ===================================================================

// -- Comment-syntax extraction --------------------------------------

fn comment_prefix_for(syntax: CommentSyntax) -> String {
  match syntax.line_prefix {
    null => ""
    prefix => prefix
  }
}

fn config_comment_prefix(format: ConfigFormat) -> String {
  comment_prefix_for(syntax: format.comment)
}

fn language_comment_prefix(lang: Language) -> String {
  comment_prefix_for(syntax: lang.comment)
}

// -- Format-aware header --------------------------------------------

fn format_header(syntax: CommentSyntax, generator: String, regen_command: String) -> String {
  let prefix = comment_prefix_for(syntax: syntax)
  "\{prefix\} Generated by \{generator\}\n\{prefix\} DO NOT EDIT - regenerate with: \{regen_command\}"
}

fn config_format_header(format: ConfigFormat, generator: String, regen_command: String) -> String {
  format_header(syntax: format.comment, generator: generator, regen_command: regen_command)
}

fn language_format_header(lang: Language, generator: String, regen_command: String) -> String {
  format_header(syntax: lang.comment, generator: generator, regen_command: regen_command)
}

// -- Format-aware comment -------------------------------------------

fn format_comment(syntax: CommentSyntax, text: String) -> String {
  let prefix = comment_prefix_for(syntax: syntax)
  "\{prefix\} \{text\}"
}

// -- Format-aware section header ------------------------------------

// GUNBC_BOOTSTRAP_EMIT_BEGIN
// Repeat a string N times. Local helper until std.strings provides this.
// Bounded loop: `remaining` descends (complexity: arithmetic descent, not same-argument).
fn repeat_string_loop(acc: String, s: String, remaining: Int) -> String {
  if remaining <= 0 {
    acc
  } else {
    repeat_string_loop(concat(acc, s), s: s, remaining: remaining - 1)
  }
}

fn repeat_string(s: String, n: Int) -> String {
  repeat_string_loop(acc: "", s: s, remaining: n)
}
// GUNBC_BOOTSTRAP_EMIT_END

fn format_section_header(syntax: CommentSyntax, title: String) -> String {
  let prefix = comment_prefix_for(syntax: syntax)
  let separator = "============================================================================"
  "\{prefix\} \{separator\}\n\{prefix\} \{title\}\n\{prefix\} \{separator\}"
}

// ===================================================================
// Structured-text primitives (format-agnostic)
// ===================================================================
//
// Generic building blocks for indentation-based text formats.
// Format-specific modules fix the parameters:
//   YAML:     indent_unit = "  ", kv_sep = ": ",  list_prefix = "- "
//   Makefile: indent_unit = "\t", kv_sep = " = ", list_prefix = ""

// -- Indentation ----------------------------------------------------

fn indent_text(level: Int, unit: String, text: String) -> String {
  let pad = repeat_string(s: unit, n: level)
  "\{pad\}\{text\}"
}

// -- Key-value pairs ------------------------------------------------

fn kv_pair(key: String, sep: String, value: String) -> String {
  "\{key\}\{sep\}\{value\}"
}

fn indented_kv(level: Int, unit: String, key: String, sep: String, value: String) -> String {
  indent_text(level: level, unit: unit, text: kv_pair(key: key, sep: sep, value: value))
}

// -- List items -----------------------------------------------------

fn list_item(prefix: String, value: String) -> String {
  "\{prefix\}\{value\}"
}

fn indented_list_item(level: Int, unit: String, prefix: String, value: String) -> String {
  indent_text(level: level, unit: unit, text: list_item(prefix: prefix, value: value))
}

// -- Blocks ---------------------------------------------------------

fn text_block(header: String, level: Int, unit: String, items: List<String>) -> String {
  let indented = map(items, item => indent_text(level: level, unit: unit, text: item))
  let lines = join(indented, "\n")
  if count(items) > 0 {
    "\{header\}\n\{lines\}"
  } else {
    header
  }
}

fn list_block(header: String, level: Int, unit: String, prefix: String, items: List<String>) -> String {
  let indented = map(items, item => indented_list_item(level: level, unit: unit, prefix: prefix, value: item))
  let lines = join(indented, "\n")
  if count(items) > 0 {
    "\{header\}\n\{lines\}"
  } else {
    header
  }
}

fn kv_block(level: Int, unit: String, sep: String, entries: List<{ key: String, value: String }>) -> String {
  let indented = map(entries, e => indented_kv(level: level, unit: unit, key: e.key, sep: sep, value: e.value))
  join(indented, "\n")
}

// ===================================================================
// Fragment IR -- format-agnostic renderable content
// ===================================================================
//
// OutputFormat: syntactic parameters of a target format.
// Each format module owns its own OutputFormat data declaration.
type OutputFormat {
  name: String
  indent_unit: String
  kv_separator: String
  list_prefix: String
  comment_prefix: String
  section_separator: String
  trailing_newline: Bool
}

// GeneratorHeader: "Generated by X -- DO NOT EDIT"
type GeneratorHeader {
  generator: String
  regen_command: String
}

// RenderDocument: deleted. Depended on Fragment (also deleted).
// HTML markup emit reintroduced in std/html_markup.dag (HtmlNode IR +
// serialize_html_node fold-to-text). Generic Fragment may return when a
// second markup consumer needs format-agnostic renderable content.
