// std/reduce_to_fixpoint.dag — Reduce-to-fixpoint toolkit (objective-first).
//
// OBJECTIVE-FIRST: the reduction objective (one step toward a smaller or
// normal form) is the primary input. Fixpoint iteration and tree
// catamorphisms are derived from it — consumers supply
// `ReductionObjective<T>`, not a hand-rolled loop per site.
//
// VERDICT (fail-closed three-valued):
//   Reduced     — objective made progress and then reached stability
//   Irreducible — objective reports stability on the first step (nothing to do)
//   Unknown     — cannot classify: a step returned StepUnknown, or bounded
//                 iteration exhausted without stability
//
// ALGEBRA: (ReductionVerdict, reduction_verdict_combine, Reduced) is a Monoid
// with absorbing element Unknown (fail-closed join). Ordering:
//   Reduced < Irreducible < Unknown
//
// CATAMORPHISM: ReduceTreeFold + fold_reduce_tree mirror fold_stack
// (std/stack.dag) and the structural folds in std/induction.dag — recursion
// only on strict sub-trees, bounded by |tree|.
//
// Anchor: https://en.wikipedia.org/wiki/Kleene%27s_fixed-point_theorem
// (iterative reduction to least fixpoint); catamorphism: Meijer et al. (1991).

module std.reduce_to_fixpoint

import std.algebra { Monoid }
import std.logic { Bool }
import std.types { Int, List }

// =========================================================================
// ReductionVerdict — fail-closed three-valued outcome
// =========================================================================

type ReductionVerdict = Reduced | Irreducible | Unknown

// Join of the Reduced < Irreducible < Unknown order. Unknown absorbs
// (fail-closed). Reduced is the monoid identity.
fn reduction_verdict_combine(a: ReductionVerdict, b: ReductionVerdict) -> ReductionVerdict {
  match a {
    Unknown => Unknown
    Reduced => b
    Irreducible => match b {
      Unknown => Unknown
      Reduced => Irreducible
      Irreducible => Irreducible
    }
  }
}

fn reduction_verdict_monoid() -> Monoid<ReductionVerdict> {
  Monoid {
    op: reduction_verdict_combine,
    identity: Reduced
  }
}

fn reduction_verdict_fold(verdicts: List<ReductionVerdict>) -> ReductionVerdict {
  fold(
    verdicts,
    init: Reduced,
    f: fn(acc, v) { reduction_verdict_combine(a: acc, b: v) }
  )
}

// =========================================================================
// ReductionObjective — one bounded step toward a fixpoint
// =========================================================================

type ReductionStepOutcome<T>
  = Progress { value: T }
  | Stable
  | StepUnknown

type ReductionObjective<T> = fn(T) -> ReductionStepOutcome<T>

type ReductionResult<T> {
  value: T
  verdict: ReductionVerdict
}

fn apply_reduction_step<T>(step: fn(T) -> ReductionStepOutcome<T>, value: T) -> ReductionStepOutcome<T> {
  step(value)
}

fn reduce_to_fixpoint_bounded<T>(
  step: fn(T) -> ReductionStepOutcome<T>,
  value: T,
  bound: Int
) -> ReductionResult<T> {
  reduce_to_fixpoint_bounded_go(
    step: step,
    value: value,
    saw_progress: false,
    remaining: bound
  )
}

fn reduce_to_fixpoint_bounded_go<T>(
  step: fn(T) -> ReductionStepOutcome<T>,
  value: T,
  saw_progress: Bool,
  remaining: Int
) -> ReductionResult<T> {
  if remaining < 0 {
    ReductionResult { value: value, verdict: Unknown }
  } else {
    match apply_reduction_step(step: step, value: value) {
      Stable =>
        if saw_progress {
          ReductionResult { value: value, verdict: Reduced }
        } else {
          ReductionResult { value: value, verdict: Irreducible }
        }
      StepUnknown =>
        ReductionResult { value: value, verdict: Unknown }
      Progress { value: next } =>
        if remaining == 0 {
          ReductionResult { value: next, verdict: Unknown }
        } else {
          reduce_to_fixpoint_bounded_go(
            step: step,
            value: next,
            saw_progress: true,
            remaining: remaining - 1
          )
        }
    }
  }
}

// =========================================================================
// ReduceTree — inductive tree for structural catamorphism
// =========================================================================

type ReduceTree<T>
  = ReduceLeaf { value: T }
  | ReduceBranch { children: List<ReduceTree<T>> }

type ReduceTreeFold<T, R> {
  leaf: fn(T) -> R
  branch: fn(List<R>) -> R
}

fn fold_reduce_tree<T, R>(tree: ReduceTree<T>, algebra: ReduceTreeFold<T, R>) -> R {
  match tree {
    ReduceLeaf { value: v } => algebra.leaf(v)
    ReduceBranch { children: children } =>
      algebra.branch(
        map(
          collection: children,
          f: fn(child) { fold_reduce_tree(tree: child, algebra: algebra) }
        )
      )
  }
}

fn reduce_tree_verdict<T>(
  tree: ReduceTree<T>,
  step: fn(T) -> ReductionStepOutcome<T>
) -> ReductionVerdict {
  fold_reduce_tree(
    tree: tree,
    algebra: ReduceTreeFold {
      leaf: fn(v) {
        reduce_to_fixpoint_bounded(step: step, value: v, bound: 64).verdict
      },
      branch: fn(child_verdicts) { reduction_verdict_fold(verdicts: child_verdicts) }
    }
  )
}

// =========================================================================
// Verdict predicates — structural classification, not string matching
// =========================================================================

fn verdict_is_reduced(v: ReductionVerdict) -> Bool {
  match v {
    Reduced => true
    Irreducible => false
    Unknown => false
  }
}

fn verdict_is_irreducible(v: ReductionVerdict) -> Bool {
  match v {
    Irreducible => true
    Reduced => false
    Unknown => false
  }
}

fn verdict_is_unknown(v: ReductionVerdict) -> Bool {
  match v {
    Unknown => true
    Reduced => false
    Irreducible => false
  }
}
