// std/os/operator_fleet.dag — Operator srv1/srv2 OS deployment binding.
//
// srv1/srv2 run Ubuntu 24.04 LTS (Noble Numbat). Product → catalog → surface via std.os.

module std.os.operator_fleet

import std.os { cited_operating_system_surface }
import std.os.types { NobleNumbat2404Lts, OperatingSystemProduct, OperatingSystemSurface, UbuntuOs }

data operator_fleet_os_product: OperatingSystemProduct = UbuntuOs { distro: NobleNumbat2404Lts }

data operator_fleet_os_surface: OperatingSystemSurface = cited_operating_system_surface(operator_fleet_os_product)
