// std/os/invocation.dag — open invocation-surface model for the §10 execution-contract layer.
//
// Scope: the stable contract an application binds to, modeled OPEN over invocation paradigms so the
// system can speak ANY (real, cited) syscall table / runtime surface — a new OS/runtime is a DATA
// inhabitation, never a model edit (the omni invariant). Slice 1 ships the SyscallAbi paradigm,
// inhabited by Linux x86-64 (extdeps/runtime/syscalls/linux.dag). LibraryApiBoundary (Windows/macOS),
// CapabilityInvocation (microkernels), and ImportResolution (WASM/WASI) land as StableInvocationSurface
// coproduct arms ONLY when a real cited inhabitant exists (facts-first) — so the coproduct is born
// multi-variant in Slice 2, NOT as a single-variant alias here.
//
// This file uses only Int / NonEmptyStr / List / records — it does NOT import the distribution enums
// (UbuntuDistribution et al.), which do not resolve on v2 yet; binding to the OS catalog happens only
// at the (gated) attach step in a later slice.
//
// Anchor: per-inhabitant spec URLs live with the inhabiting data (extdeps/runtime/*).

module std.os.invocation

import std.types { NonEmptyStr }

// One entry in a flat syscall table: the stable (number, name, arity) fact a kernel publishes.
// number = the architecture's real syscall NR; arg_count = the documented man(2) argument count.
type SyscallEntry {
  number: Int
  name: NonEmptyStr
  arg_count: Int
}

// The SyscallAbi paradigm: the syscall numbers + a named register convention ARE the stable public
// contract (e.g. Linux). `convention` names the ABI modeled in extdeps/runtime/abi/*.dag.
type SyscallAbi {
  table: List<SyscallEntry>
  convention: NonEmptyStr
}
