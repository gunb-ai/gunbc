module std.html_markup

import std.markup {
  MarkupNode,
  MarkupSerializeResult,
  try_serialize_markup_node,
  escape_text,
}
import std.string_type { String }

fn try_serialize_html_node(node: MarkupNode) -> MarkupSerializeResult {
  try_serialize_markup_node(node: node)
}

fn escape_text_content(s: String) -> String {
  escape_text(s: s)
}
