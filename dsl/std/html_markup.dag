// std/html_markup.dag — HTML serialize result wrapper over std.markup.
//
// The consumer-facing element tree (MarkupNode), the href/src XSS gate
// (validate_href / find_first_rejected_url), and the Fragment adapter all live
// in std.markup — the ONE authority shared with std.react_markup and
// std.markdown. This module is now just the HTML-flavored serialize-or-reject
// result type plus its thin entry; gunbhub builds MarkupNode trees and renders
// through serialize_markup_node's single fold (cost-of-change = 1).

module std.html_markup

import std.markup {
  MarkupNode,
  find_first_rejected_url,
  serialize_markup_node,
  escape_text,
}

type HtmlSerializeResult
  = Serialized { html: String }
  | Rejected { reason: String }

// --- thin consumer entry (fail-closed on untrusted href/src schemes) --------

fn try_serialize_html_node(node: MarkupNode) -> HtmlSerializeResult {
  match find_first_rejected_url(node: node) {
    Present { value: _ } =>
      Rejected { reason: "URL scheme not allowlisted for href/src" }
    Absent =>
      Serialized { html: serialize_markup_node(node: node) }
  }
}

fn escape_text_content(s: String) -> String {
  escape_text(s: s)
}
