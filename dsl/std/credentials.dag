// std/credentials.dag -- Standard credential SOURCE declaration (provider-neutral shape).
//
// Services declare WHERE a credential comes from; they do not carry materialization
// logic. This module owns ONLY the agnostic `CredentialSource` shape and the
// provider-neutral `CredentialFlow` acquisition strategies. std is the root of
// the layer DAG (the import arrow points toward std), so it declares no transport and
// imports no extdeps. The materializers that REALIZE a source are realization handlers and
// live peripherally in their own layer: the shell-backed `env_credential` is in
// `extdeps.shell.credentials`; provider-specific materializers (GCP secret manager) are in
// `gunbc.auth.credentials`; GCP WIF / interactive gcloud OAuth flows are in
// `extdeps.cloud.gcp.gcp.GcpCredentialFlow`.

module std.credentials

import std.types { NonEmptyStr }

// A vendor/firmware-PUBLISHED factory default login (a device's stock console/BMC account).
// The password is public — printed in manuals, identical across every shipped unit — so it
// is a plain NonEmptyStr, deliberately NOT a Secret: typing it as a secret would hide that
// it is world-known and MUST be rotated on first contact (DESIGN §5 — the must-rotate
// obligation should be loud, not buried). The real, protected credential is the one a host
// effect GENERATES during rotation (next phase), and that one carries a Secret.
//
// Distinct from `std.types.Credential` (a token/scheme API credential with scopes): a
// FactoryLogin has neither token nor scopes, so it is a different fact bundle, not a
// nickname of it (DESIGN §3).
type FactoryLogin {
  username: NonEmptyStr
  published_password: NonEmptyStr
}

// CredentialSource: declares WHERE a credential is acquired from.
// Services reference this in config { auth_source: EnvVar("TOKEN_NAME") }.
// The emitter generates target-language acquisition code from the variant.

type CredentialSource
  = EnvVar { name: String }

// CredentialFlow: provider-neutral acquisition strategy.
// PlatformInjected folded into CredentialSource.EnvVar (§2 horizontal dedup).
// GCP WorkloadIdentity / InteractiveAuth → extdeps.cloud.gcp.gcp.GcpCredentialFlow.

type CredentialFlow
  = Stored { secret_name: NonEmptyStr }
  | Chained { steps: List<CredentialFlow> }
