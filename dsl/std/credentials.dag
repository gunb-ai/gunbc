// std/credentials.dag -- Standard credential acquisition patterns.
//
// Services should declare credential needs, not materialization logic.
// This module provides reusable credential acquisition patterns that
// decouple "what credential is needed" from "how to get it."
//
// This module intentionally contains only provider-neutral credential
// acquisition helpers. Provider-specific materializers live under
// runtime.auth.

module std.credentials

import extdeps.shell
import std.types { NonEmptyStr }

// Acquire a credential from an environment variable.
//
// Simplest materialization strategy: reads the named env var and
// returns its value as a Secret.
//
// Used by service-specific credential functions that still source
// credentials from the process environment.

pattern env_credential(env_var: NonEmptyStr) -> { token: Secret } {
  result = shell.Env.Get(name: env_var)
  return { token: result.value as Secret }
}
