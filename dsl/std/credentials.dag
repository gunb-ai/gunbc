// std/credentials.dag -- Standard credential acquisition patterns.
//
// T8 (POSTMORTEM): Services should declare credential needs, not
// materialization logic. This module provides reusable credential
// acquisition patterns that decouple "what credential is needed"
// from "how to get it."
//
// CURRENT STATE (Phase 3e):
//   - env_credential: reads a token from an environment variable.
//     Simplest strategy, used for local dev and CI where a token
//     is injected via env var.
//
// FUTURE (full credential provider interface):
//   The credential_chain pattern in std.patterns handles the full
//   OIDC -> STS -> impersonation -> Secret Manager flow for GCP.
//   The next step is to make services declare credential requirements
//   as CredentialIntent (from std.types), and have the execution
//   profile resolve intent -> CredentialResolution -> materialization.
//   This would eliminate explicit auth_token threading in callers.
//
//   Design (from POSTMORTEM T8):
//     1. Service declares: "I need a credential with scope X"
//        (CredentialIntent in service config, not an explicit input)
//     2. Profile resolves: intent -> CredentialResolution
//        (e.g., GitHubApi -> EnvVar("GITHUB_TOKEN"))
//     3. Runtime materializes: resolution -> Secret
//        (env_credential, credential_chain, or future strategies)
//     4. Credential is injected into service config automatically
//        (no manual threading of auth_token through callers)
//
//   See also: std.types.CredentialIntent, CredentialResolution,
//   CredentialBinding, CredentialFlow.

module std.credentials

import extdeps.shell
import std.types { NonEmptyStr }

// Acquire a credential from an environment variable.
//
// Simplest materialization strategy: reads the named env var and
// returns its value as a Secret. This is the building block for
// the EnvVar resolution strategy in CredentialResolution.
//
// Used by service-specific credential functions (e.g., github_token
// in extdeps.github.auth) that know which env var maps to which
// service credential.
//
// Corresponds to: CredentialResolution::EnvVar { name }

pattern env_credential(env_var: NonEmptyStr) -> { token: Secret } {
  result = shell.Env.Get(name: env_var)
  return { token: result.value as Secret }
}
