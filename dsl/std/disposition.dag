module std.disposition

import std.types { NonEmptyStr }

type ConstructionMechanism
  = SingleAuthority
  | RealizationDispatch
  | SubstrateMandatoryTag

type NodeRef {
  module_path: String
  decl_name: NonEmptyStr
}

type Disposition
  = Terminal { reason: NonEmptyStr }
  | Scaffold { dissolves_to: ConstructionMechanism, bind: NodeRef }
