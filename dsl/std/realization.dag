// std/realization.dag — Realization meta-process (DESIGN.md §2 horizontal).
//
// The HOW of computation reified as a content-addressed plan: execution order
// (schedule), placement, materialization, cost, and evidence — observable via
// lenses independently of the WHAT (the pure Node DAG).
//
// Layer split (§3):
//   std/realization.dag           — independence classifier + schedule re-exports
//   std/realization_schedule.dag  — schedule arm + lens (dsl-tree witnesses)
//   extdeps/realization/*           — placement/materialization handlers (follow-on)
//   workflow/*                    — policy (which Objective for prod vs dev)
//
// Dissolution triggers (named):
//   - v2/test/claim/realization_schedule_witness.dag enrolls in CI discovery when
//     v2 self-compile-clean closes the Empty-in-generic sequence_outcome gap.
//   - cache_interface.dag → Materialization rows become extdeps/realization handlers
//   - RealizedStep / Placement / Materialization re-introduced (increment 3: reconcile→Share);
//     their ContentHash intent + licensed_by return in increment 4 (cross-tree content-hash)
//   - target digest → content_hash(subgraph) when dsl/ imports v2.std.node directly
//     (v2.std.cross_tree.node_content_hash bridge SCAFFOLDED, not yet consumed here)

module std.realization

import std.types { Bool, String, List }
import std.effects {
  EffectShape, ReadEffect, UpsertEffect, DeleteEffect, CreateEffect, AppendEffect,
  key_source_eq, create_double_init_collapsible
}
import std.realization_schedule {
  RealizationPlan,
  RealizationObjective,
  Runnable,
  RunnableSingleClaim,
  RunnableDiscoveryBatch,
  ScheduleWitnessEntry,
  Schedule,
  CostAccount,
  cost_account_measured,
  cost_account_predicted_zero,
  cost_account_time_nanos,
  schedule_lens_verdict_for_ci_floor,
  schedule_generates_same_batch_count,
  schedule_generates_identical_schedule,
  schedule_eq,
  ScheduleLensViolation,
  runnable_step_label,
  schedule_batch_contains_label,
}
import std.realization_measurement {
  RealizationMeasureEffect,
  cost_account_measured_from_time,
  cost_account_measured_from_schedule_critical_path,
  schedule_critical_path_time,
  schedule_batch_critical_path,
  nanosecond_duration_list_total,
}

// --- Independence classifier (fail-closed) ------------------------------------

type Independence = Independent | Dependent | Unknown

// Compare effect keys for upsert/delete; unmatched arms stay Unknown (fail-closed).
fn independence_from_effect_shapes(left: EffectShape, right: EffectShape) -> Independence {
  match left {
    ReadEffect => match right {
      ReadEffect => Independent
      UpsertEffect { key_source: _ } => Unknown
      DeleteEffect { key_source: _ } => Unknown
      CreateEffect { cause: _ } => Unknown
      AppendEffect => Unknown
    }
    UpsertEffect { key_source: lk } => match right {
      ReadEffect => Unknown
      UpsertEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      DeleteEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      CreateEffect { cause: _ } => Unknown
      AppendEffect => Unknown
    }
    DeleteEffect { key_source: lk } => match right {
      ReadEffect => Unknown
      UpsertEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      DeleteEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      CreateEffect { cause: _ } => Unknown
      AppendEffect => Unknown
    }
    CreateEffect { cause: _ } => Unknown
    AppendEffect => Unknown
  }
}

// --- Materialization arm (increment 3: reconcile → Share) ----------------------
//
// A RealizedStep is one node's realization: WHERE it runs (placement), HOW its
// result is materialized (recompute / memoize / share), and its cost. The intent
// digest (ContentHash) + licensed_by return in increment 4 when cross-tree import
// lands (bridge scaffolded in v2, not consumed by dsl yet); for now the step
// carries its source EffectShape so reconcile can key the Share collapse on KeySource identity.

type Placement = LocalInProcess | LocalFilesystem | RemoteNetwork

type Materialization = Recompute | Memoize | Share

type RealizedStep {
  shape: EffectShape
  placement: Placement
  materialization: Materialization
  cost: CostAccount
}

// Mark every accumulator step whose effect is the same-KeySource create-if-absent
// twin of `s` as Share (s collapses INTO the shared materialization; not appended).
fn mark_collapsible_share(acc: List<RealizedStep>, s: RealizedStep) -> List<RealizedStep> {
  acc |> map(e =>
    if create_double_init_collapsible(a: e.shape, b: s.shape) {
      RealizedStep {
        shape: e.shape,
        placement: e.placement,
        materialization: Share,
        cost: e.cost
      }
    } else {
      e
    }
  )
}

// Does `s` have a same-KeySource create-if-absent twin already in `acc`?
fn has_collapsible_peer(acc: List<RealizedStep>, s: RealizedStep) -> Bool {
  let peers = acc |> filter(e => create_double_init_collapsible(a: e.shape, b: s.shape))
  !((peers |> length) == 0)
}

// Collapse same-KeySource create-if-absent steps into one shared materialization.
// Two steps with KeySource-equal CreateIfAbsent effects reconcile to ONE step whose
// materialization is Share; distinct identities (or non-create effects) stay separate.
// The collapse decision is create_double_init_collapsible (std.effects, KeySource-keyed) —
// reconcile only consumes it, never re-derives KeySource equality (§3 single authority).
fn reconcile(steps: List<RealizedStep>) -> List<RealizedStep> {
  steps |> fold(init: [], f: (acc, s) =>
    if has_collapsible_peer(acc: acc, s: s) {
      mark_collapsible_share(acc: acc, s: s)
    } else {
      concat(acc, [s])
    }
  )
}
