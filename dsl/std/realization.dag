type Independence = Independent | Dependent | Unknown

fn independence_from_effect_shapes(left: EffectShape, right: EffectShape) -> Independence {
  match left {
    ReadEffect => match right {
      ReadEffect => Independent
      UpsertEffect { key_source: _ } => Unknown
      DeleteEffect { key_source: _ } => Unknown
      CreateEffect { cause: _ } => Unknown
      AppendEffect => Unknown
    }
    UpsertEffect { key_source: lk } => match right {
      ReadEffect => Unknown
      UpsertEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      DeleteEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      CreateEffect { cause: _ } => Unknown
      AppendEffect => Unknown
    }
    DeleteEffect { key_source: lk } => match right {
      ReadEffect => Unknown
      UpsertEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      DeleteEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      CreateEffect { cause: _ } => Unknown
      AppendEffect => Unknown
    }
    CreateEffect { cause: _ } => Unknown
    AppendEffect => Unknown
  }
}

type Placement
  = LocalInProcess
  | LocalFilesystem
  | RemoteNetwork
  | LocalAccelerator

data local_accelerator_placement_dissolution_trigger: String = "dissolve-on: execution lane wires device identity from extdeps.gpu.AcceleratorFacts at the product/demo placement site; std keeps LocalAccelerator as placement-kind only (no device_model nickname on substrate — DESIGN §3)."

type Materialization = Recompute | Memoize | Share

type RealizedStep<S> {
  shape: EffectShape
  placement: Placement
  materialization: Materialization
  cost: CostAccount<S>
}

fn mark_collapsible_share<S>(acc: List<RealizedStep<S>>, s: RealizedStep<S>) -> List<RealizedStep<S>> {
  acc |> map(e =>
    if create_double_init_collapsible(a: e.shape, b: s.shape) {
      RealizedStep {
        shape: e.shape,
        placement: e.placement,
        materialization: Share,
        cost: e.cost
      }
    } else {
      e
    }
  )
}

fn has_collapsible_peer<S>(acc: List<RealizedStep<S>>, s: RealizedStep<S>) -> Bool {
  let peers = acc |> filter(e => create_double_init_collapsible(a: e.shape, b: s.shape))
  !((peers |> length) == 0)
}

fn reconcile<S>(steps: List<RealizedStep<S>>) -> List<RealizedStep<S>> {
  steps |> fold(init: [], f: (acc, s) =>
    if has_collapsible_peer(acc: acc, s: s) {
      mark_collapsible_share(acc: acc, s: s)
    } else {
      concat(acc, [s])
    }
  )
}
