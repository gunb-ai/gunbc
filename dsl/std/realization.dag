// std/realization.dag — Realization meta-process (DESIGN.md §2 horizontal).
//
// The HOW of computation reified as a content-addressed plan: execution order
// (schedule), placement, materialization, cost, and evidence — observable via
// lenses independently of the WHAT (the pure Node DAG).
//
// Layer split (§3):
//   std/realization.dag           — may_reorder + schedule re-exports
//   std/realization_schedule.dag  — schedule arm + lens (dsl-tree witnesses)
//   extdeps/realization/*           — placement/materialization handlers (follow-on)
//   workflow/*                    — policy (which Objective for prod vs dev)
//
// Dissolution triggers (named):
//   - v2/test/claim/realization_schedule_witness.dag enrolls in CI discovery when
//     v2 self-compile-clean closes the Empty-in-generic sequence_outcome gap.
//   - cache_interface.dag → Materialization rows become extdeps/realization handlers
//   - RealizedStep / Placement / Materialization return in the feature follow-on
//   - target digest → content_hash(subgraph) when dsl/v2 cross-tree Node import lands

module std.realization

import std.types { Bool, String, List }
import std.effects {
  EffectShape, ReadEffect, UpsertEffect, DeleteEffect, CreateEffect, AppendEffect,
  KeySource, PathParam, InputField, CompositeKey
}
import std.realization_schedule {
  RealizationPlan,
  RealizationObjective,
  Runnable,
  RunnableSingleClaim,
  RunnableDiscoveryBatch,
  ScheduleWitnessEntry,
  Schedule,
  CostAccount,
  CostBasis,
  NanosecondDuration,
  cost_account_predicted_zero,
  schedule_lens_verdict_for_ci_floor,
  schedule_lens_holds_for_ci_floor,
  schedule_generates_same_batch_count,
  schedule_generates_identical_schedule,
  schedule_eq,
  ScheduleLensViolation,
  ScheduleLensVerdict,
  runnable_step_label,
  schedule_batch_contains_label,
}

// --- Independence / may_reorder (fail-closed) ---------------------------------

type Independence = Independent | Dependent | Unknown

fn string_list_eq(left: List<String>, right: List<String>) -> Bool {
  if left.length() != right.length() {
    false
  } else if left.length() == 0 {
    true
  } else if left.first() != right.first() {
    false
  } else {
    string_list_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn key_source_eq(left: KeySource, right: KeySource) -> Bool {
  match left {
    PathParam { param: lp } => match right {
      PathParam { param: rp } => lp == rp
      InputField { field: _ } => false
      CompositeKey { fields: _ } => false
    }
    InputField { field: lf } => match right {
      PathParam { param: _ } => false
      InputField { field: rf } => lf == rf
      CompositeKey { fields: _ } => false
    }
    CompositeKey { fields: lf } => match right {
      PathParam { param: _ } => false
      InputField { field: _ } => false
      CompositeKey { fields: rf } => string_list_eq(left: lf, right: rf)
    }
  }
}

// Compare effect keys for upsert/delete; unmatched arms stay Unknown (fail-closed).
fn independence_from_effect_shapes(left: EffectShape, right: EffectShape) -> Independence {
  match left {
    ReadEffect => match right {
      ReadEffect => Independent
      UpsertEffect { key_source: _ } => Unknown
      DeleteEffect { key_source: _ } => Unknown
      CreateEffect => Unknown
      AppendEffect => Unknown
    }
    UpsertEffect { key_source: lk } => match right {
      ReadEffect => Unknown
      UpsertEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      DeleteEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      CreateEffect => Unknown
      AppendEffect => Unknown
    }
    DeleteEffect { key_source: lk } => match right {
      ReadEffect => Unknown
      UpsertEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      DeleteEffect { key_source: rk } =>
        if key_source_eq(left: lk, right: rk) { Dependent } else { Independent }
      CreateEffect => Unknown
      AppendEffect => Unknown
    }
    CreateEffect => Unknown
    AppendEffect => Unknown
  }
}

fn may_reorder(indep: Independence) -> Bool {
  match indep {
    Independent => true
    Dependent => false
    Unknown => false
  }
}
