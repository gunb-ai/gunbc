// std/termination.dag -- Well-founded descent and termination proofs.
//
// Every recursive function in .dag must terminate. This file models
// the mathematical structures that PROVE termination — well-founded
// orderings, ranking functions, and descent evidence.
//
// EXTERNAL AUTHORITY:
//   - Well-founded relations: set theory (Zermelo 1904, von Neumann 1929)
//   - Ranking functions for termination: Floyd (1967), Turing (1949)
//   - Size-change termination: Lee, Jones, Ben-Amram (2001)
//   - Lexicographic orderings: Dershowitz, Manna (1979)
//   - Multiset orderings: Dershowitz, Manna (1979)
//
// RELATIONSHIP TO std/iteration.dag:
//   iteration.dag defines the three bounded primitives (fold, descend,
//   repeat). This file defines the PROOF THEORY that lets the compiler
//   verify recursive syntax lowers to those primitives. The primitives
//   are the "what." This file is the "why it terminates."
//
// RELATIONSHIP TO std/algebra.dag:
//   algebra.dag defines Ordering = Less | Equal | Greater and
//   OrderedRing with compare(). This file uses Ordering as the
//   evidence type for descent steps. The well-founded ordering on
//   natural numbers IS the OrderedRing ordering restricted to
//   non-negative values.
//
// DESIGN PRINCIPLE: The complexity analyzer should be a CHECKER of
// termination proofs, not a DISCOVERER. The proof structure is
// modeled here as objective facts. The analyzer constructs candidate
// proofs by examining code, then validates them against this model.
// If no valid proof can be constructed, the function is rejected.

module std.termination

import std.algebra { Ordering }
// NOTE: is_valid_proof lives in std.graph (graph algorithm needs SCC
// primitives). Cannot re-export here (circular: termination → graph →
// termination). Consumers import from std.graph directly.

// =========================================================================
// Descent evidence: what happens to a ranking dimension at one call edge
// =========================================================================

// At each call edge in a recursive function (or SCC cycle), the
// ranking dimension either:
//   - Strictly decreases (Strict): the callee receives a provably
//     smaller value. Examples: skip(1) on a list, child accessor on
//     a Node, n-1 on an integer.
//   - Stays the same (NonIncreasing): the callee receives the same
//     value or a value no larger. Examples: passing a parameter
//     unchanged, passing state through a helper that doesn't advance.
//   - Is unknown (DescentUnknown): the analyzer cannot determine the
//     relationship. Fail-closed: treated as potentially non-decreasing.
//
// These correspond to Ordering values:
//   Strict         → Less    (value strictly decreases)
//   NonIncreasing  → Equal   (value stays the same — may decrease but not proven)
//   DescentUnknown → Greater (conservatively treated as potentially increasing)

type DescentEvidence
  = Strict           // value provably decreases (Less)
  | NonIncreasing    // value does not increase (Equal or Less)
  | DescentUnknown   // cannot determine (fail-closed: Greater)

// Merge two descent evidences (e.g., from two branches of an if/match).
// The merge is conservative: if EITHER branch is DescentUnknown, result is DescentUnknown.
// If both are Strict, result is Strict. Otherwise NonIncreasing.
//
// This forms a bounded lattice:
//   top    = Strict         (best evidence)
//   bottom = DescentUnknown (no evidence)
//   meet(a, b) = min(a, b)  (conservative merge)
//
// The lattice ordering is: DescentUnknown < NonIncreasing < Strict
// meet(Strict, Strict) = Strict
// meet(Strict, NonIncreasing) = NonIncreasing
// meet(Strict, DescentUnknown) = DescentUnknown
// meet(NonIncreasing, NonIncreasing) = NonIncreasing
// meet(NonIncreasing, DescentUnknown) = DescentUnknown

fn merge_evidence(a: DescentEvidence, b: DescentEvidence) -> DescentEvidence {
  match a {
    Strict => match b {
      Strict => Strict
      NonIncreasing => NonIncreasing
      _ => DescentUnknown
    }
    NonIncreasing => match b {
      Strict => NonIncreasing
      NonIncreasing => NonIncreasing
      _ => DescentUnknown
    }
    _ => DescentUnknown
  }
}

// Join two descent evidences: the OPTIMISTIC merge. Returns the BEST
// evidence from either branch. Dual of merge_evidence (meet).
//
// The lattice ordering is: DescentUnknown < NonIncreasing < Strict
// join(DescentUnknown, X) = X
// join(NonIncreasing, Strict) = Strict
// join(NonIncreasing, NonIncreasing) = NonIncreasing
// join(Strict, X) = Strict

fn join_evidence(a: DescentEvidence, b: DescentEvidence) -> DescentEvidence {
  match a {
    Strict => Strict
    NonIncreasing => match b {
      Strict => Strict
      _ => NonIncreasing
    }
    _ => b
  }
}

// DescentEvidence inhabits BoundedLattice:
//   meet = merge_evidence, join = join_evidence
//   top = Strict, bottom = DescentUnknown
// Data declaration deferred: compiler does not yet emit generic type
// parameters for data constants (BoundedLattice<DescentEvidence>).

// Promote NonIncreasing to Strict (e.g., when a callee is known to always advance).
// DescentUnknown stays unknown — can't promote what we don't know.
fn promote_to_strict(evidence: DescentEvidence) -> DescentEvidence {
  match evidence {
    NonIncreasing => Strict
    Strict => Strict
    _ => DescentUnknown
  }
}

// =========================================================================
// Ranking dimensions: what can be measured for descent
// =========================================================================

// A ranking dimension identifies WHAT is decreasing across a recursive
// call. Each dimension corresponds to a well-founded set:
//
//   TreeSize    — the number of nodes in a subtree (ℕ, well-founded by <)
//   ListLength  — the length of a list (ℕ, well-founded by <)
//   ArithmeticValue — an integer parameter (ℕ, well-founded by <)
//   TokenPosition — position in a finite token stream (ℕ, bounded by |tokens|)
//   SetCardinality — size of a finite set (ℕ, well-founded by <)
//
// All of these map to natural numbers with the standard ordering.
// The well-foundedness of ℕ under < is the fundamental fact that
// makes all termination proofs work.

// Bootstrap constraint: `param` is a function parameter name (String).
// .dag does not yet have first-class param references. When it does,
// param should become a structural reference into the function's param list.
type RankingDimension
  = TreeSize { param: String }           // |subtree| via child accessor
  | ListLength { param: String }         // |list| via skip/tail
  | ArithmeticValue { param: String }    // integer via n-1, n/2
  | TokenPosition { param: String }      // parser state.position
  | SetCardinality { param: String }     // |set| via remove

// =========================================================================
// Descent sources: HOW descent is witnessed at a call site
// =========================================================================

// A descent source is the concrete code pattern that provides descent
// evidence for a ranking dimension. These are the objective facts that
// the analyzer recognizes:
//
// Each source is grounded in a structural property of the IR:
//   - ChildAccessor: the ChildRole model in 00_core.dag declares
//     which functions project into Node.children. Calling self on
//     an accessor result is provably smaller (subtree < tree).
//   - ListShrink: skip(n) for n >= 1 produces a shorter list.
//     Grounded in List algebra (|skip(n, l)| = max(0, |l| - n)).
//   - ArithmeticDecrease: n-k for k >= 1, or n/k for k >= 2.
//     Grounded in OrderedRing (subtract decreases, division too).
//   - ParserAdvance: advance/expect/eat move position forward.
//     Grounded in ParserState contract (position is monotonic).
//   - SetRemoval: removing an element from a finite set.
//     Grounded in BooleanAlgebra (|remove(s, x)| < |s| when x ∈ s).

// Bootstrap constraint: accessor/op/witness/element are function or operator
// names (String). In the current .dag type system, the name IS the structural
// identity. When .dag supports function references, these should become structural.
type DescentSource
  = ChildAccessor { accessor: String }         // e.g., "binop_left"
  | ListShrink { amount: Int }                 // skip(amount), amount >= 1
  | ArithmeticDecrease { op: String, by: Int } // "subtract" by 1, "divide" by 2
  | ParserAdvance { witness: String }          // "advance", "expect", "eat"
  | SetRemoval { element: String }             // set remove in work-list drain
  | FoldIteration                              // body of fold — bounded by |collection|

// =========================================================================
// Termination proof: a ranking over dimensions
// =========================================================================

// A termination proof for a recursive function (or SCC) is a
// lexicographic ordering over ranking dimensions, together with
// evidence that the ordering decreases across every recursive path.
//
// LEXICOGRAPHIC ORDERING:
//   Given dimensions (d1, d2, ..., dn), a call is "descending" if:
//   - d1 is Strict, OR
//   - d1 is NonIncreasing AND d2 is Strict, OR
//   - d1 is NonIncreasing AND d2 is NonIncreasing AND d3 is Strict, OR
//   - ...
//
//   In other words: the first dimension that changes must decrease.
//   Higher dimensions must not increase.
//
// SINGLE-FUNCTION EXAMPLE:
//   fn walk(remaining: List<Node>) -> Result {
//     match remaining |> first {
//       None => done
//       Some { value: stmt } =>
//         process(stmt)
//         walk(remaining: remaining |> skip(1))  // ListLength Strict
//     }
//   }
//   Proof: [ListLength("remaining")]
//   Edge walk→walk: [Strict]  ✓
//
// SCC EXAMPLE (emit_rust_block_stmts):
//   Proof: [TreeSize("texpr"), ListLength("remaining")]
//
//   Edge emit_block_stmts→emit_typed_expr:
//     TreeSize: NonIncreasing (stmt is a child of the block)
//     ListLength: N/A (different function, different param)
//
//   Edge emit_typed_expr→...→emit_block_stmts (through nested block):
//     TreeSize: Strict (nested block's children are a subtree)
//     ListLength: N/A (new list, unrelated)
//
//   Edge emit_block_stmts→emit_block_stmts (self-call):
//     TreeSize: NonIncreasing (same tree level)
//     ListLength: Strict (skip(1))
//
//   Every cycle has at least one Strict edge. ✓
//
// WORK-LIST EXAMPLE (kahn_drain):
//   Proof: [SetCardinality("unvisited")]
//   Each iteration removes processed nodes from the work set.
//   New nodes added to queue are from the unvisited set (finite).
//   Edge kahn_drain→kahn_drain: SetCardinality Strict
//   (total unvisited strictly decreases each iteration) ✓

type TerminationProof {
  dimensions: List<RankingDimension>
}

// An edge in the proof: what happens to each dimension at one call.
// Bootstrap constraint: caller/callee are function names (String).
// When .dag supports function references, these should become structural.
type ProofEdge {
  caller: String
  callee: String
  evidence: List<DescentEvidence>   // one per dimension, same order
}

// Verify a termination proof: every cycle must have lexicographic descent.
// Implementation lives in std.graph (which imports ProofEdge from here).
// Declared here for conceptual ownership; re-exported via std.graph.
// See std.graph.is_valid_proof for the algorithm.

// =========================================================================
// Cost composition from iteration primitives
// =========================================================================

// Once a function's termination proof is established, its cost is
// determined by the iteration primitive it lowers to:
//
//   fold(collection, f)     → CostSum(|collection|, cost(f))
//   descend(tree, f)        → CostSum(|tree|, cost(f))
//   repeat(N, f)            → CostMul(N, cost(f))
//   arithmetic descent(n/b) → Master theorem application
//
// The TerminationProof's ranking dimensions directly determine
// which primitive applies:
//
//   TreeSize dimension       → descend
//   ListLength dimension     → fold
//   ArithmeticValue dimension → repeat (or Master theorem for divide)
//   TokenPosition dimension  → fold (over tokens)
//   SetCardinality dimension → fold (over set elements)
//
// For lexicographic proofs with multiple dimensions, the cost is
// the PRODUCT of the dimensions' contributions:
//   [TreeSize, ListLength] → descend(tree, f: fold(stmts, g))
//   Cost: O(|tree| × max_stmts_per_node × per_stmt_cost)

// =========================================================================
// Relationship to current complexity.dag types
// =========================================================================

// This model replaces or grounds the following ad-hoc types:
//
// | Current (complexity.dag)  | Grounded in (this file)        |
// |---------------------------|--------------------------------|
// | ProgressKind              | DescentEvidence                |
// | ParserProgressEdge        | ProofEdge                      |
// | RecursionPattern          | TerminationProof + cost rule   |
// | "arithmetic descent"      | ArithmeticValue dimension      |
// | "container-child descent" | TreeSize + ChildAccessor       |
// | "parser progress"         | TokenPosition + ParserAdvance  |
// | "list shrinkage"          | ListLength + ListShrink        |
// | (missing: work-list)      | SetCardinality + SetRemoval    |
// | (missing: lexicographic)  | TerminationProof.dimensions    |
//
// Migration: complexity.dag adopts these types. The ad-hoc classify_*
// functions become proof CONSTRUCTORS that build TerminationProof
// values. The proof CHECKER (is_valid_proof) is universal — one
// function, not five heuristics.
