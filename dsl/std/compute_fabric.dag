// --- §7 supply inhabitation (operator fleet + Hetzner CAX41) -------------------

data operator_fleet_provider: ProviderIdentity = "operator-fleet"

data operator_fleet_os_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: none,
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

data operator_fleet_execution_surface: ExecutionSurface = ExecutionSurface {
  os: operator_fleet_os_surface,
  isolation: SharedHostHome,
  container_runtime: none,
  toolchains: [],
  mounted_storage: [],
  network: [],
}

// P-CF-BYTESIZE: `ram` is the explicit authority handle (also via placement_supply_row)
// until ComputeHost.memory[] is populated by Measure value-typing.
fn operator_fleet_compute_host(identity: HostIdentity, cpu: CpuFacts, ram: HostRamSupplyFacts) -> ComputeHost {
  ComputeHost {
    identity: identity,
    processors: [CpuProcessor { cpu: cpu }],
    // RAM authority via ram.observed_usable_bytes; memory [] until value-typing lands.
    memory: [],
    storage: [],
    network_interfaces: [],
  }
}

data operator_fleet_owned_cost: CostModel = CostModel {
  cost_class: OwnedMarginalZero,
  rates: ProviderCostModel { placeholder: true },
}

data operator_fleet_availability_open: LogicalTime = "operator-fleet:always-open"

data supply_srv1_offer: ComputeOffer = ComputeOffer {
  provider: operator_fleet_provider,
  supply: ComputeSupplyFacts {
    physical: operator_fleet_compute_host(supply_srv1_host_identity, supply_srv1_cpu, supply_srv1_ram),
    execution: operator_fleet_execution_surface,
    cost: Present { value: operator_fleet_owned_cost },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: operator_fleet_availability_open, close: none },
  cost_quote: none,
  constraints: [],
}

data supply_srv2_offer: ComputeOffer = ComputeOffer {
  provider: operator_fleet_provider,
  supply: ComputeSupplyFacts {
    physical: operator_fleet_compute_host(supply_srv2_host_identity, supply_srv2_cpu, supply_srv2_ram),
    execution: operator_fleet_execution_surface,
    cost: Present { value: operator_fleet_owned_cost },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: operator_fleet_availability_open, close: none },
  cost_quote: none,
  constraints: [],
}

