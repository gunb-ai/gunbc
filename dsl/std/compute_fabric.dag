// Cross-provider Vm demand: operator fleet (SharedHostHome) rejects; Hetzner (Vm) admits.
data vm_isolation_work_demand: WorkDemand = WorkDemand {
  resources: ResourceEnvelope {
    cpu: none,
    gpu: none,
    memory: none,
    storage: none,
    network: none,
  },
  os: none,
  isolation: IsolationRequirement { boundary: Vm },
  toolchains: [],
  parallelism: SingleWorkItem,
  data_locality: [],
  effects: [],
}

// Case 7 — #1 rule: an untrusted Vm-requiring job is NOT honored by SharedHostHome supply.
fn witness_shared_host_home_rejects_vm() -> Bool {
  isolation_satisfies(supply: SharedHostHome, demand: Vm) == false
}

// Case 8 — a SharedHostHome-tolerant (trusted in-fleet) job IS honored by SharedHostHome supply.
fn witness_shared_host_home_admits_shared_host_home() -> Bool {
  isolation_satisfies(supply: SharedHostHome, demand: SharedHostHome)
}

// Monotonicity: stronger supply honors a weaker demand (Vm admits SharedHostHome), never reverse.
fn witness_vm_admits_shared_host_home() -> Bool {
  isolation_satisfies(supply: Vm, demand: SharedHostHome)
}

// Cross-provider: grounded srv1 offer rejects Vm demand (operator fleet SharedHostHome).
fn witness_srv1_offer_rejects_vm_demand() -> Bool {
  match satisfies(offer: supply_srv1_offer, demand: vm_isolation_work_demand) {
    Rejected { reason: _ } => true
    Eligible { witness: _ } => false
  }
}

// Cross-provider: grounded srv2 offer rejects Vm demand (operator fleet SharedHostHome).
fn witness_srv2_offer_rejects_vm_demand() -> Bool {
  match satisfies(offer: supply_srv2_offer, demand: vm_isolation_work_demand) {
    Rejected { reason: _ } => true
    Eligible { witness: _ } => false
  }
}

// Cross-provider: Hetzner Vm isolation admits Vm demand — isolation-lattice only until
// hetzner_cax41_compute_host physical facts are plumbed from cax41_catalog (P-CF-BYTESIZE).
fn witness_hetzner_cax41_admits_vm_demand() -> Bool {
  match satisfies(offer: supply_hetzner_cax41_offer, demand: vm_isolation_work_demand) {
    Eligible { witness: _ } => true
    Rejected { reason: _ } => false
  }
}
