module std.primitives

type Certainty = Proven | Amortized | Expected | Conservative

type CarrierCostSensitivity
  = CarrierInsensitive
  | CarrierSensitive { ephemeral_work: String, persistent_work: String }

type PrimitiveContract {
  name: String
  work: String
  output_size: String
  certainty: Certainty
  carrier_cost: CarrierCostSensitivity
}

data char_at_contract: PrimitiveContract = {
  name: "char_at",
  work: "pos",
  output_size: "1",
  certainty: Proven,
  carrier_cost: CarrierInsensitive
}

data string_length_contract: PrimitiveContract = {
  name: "string_length",
  work: "n",
