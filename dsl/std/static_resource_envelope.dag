module std.static_resource_envelope

import std.types { Bool, Int, List }
import std.nat { Nat, nat_max }
import std.measure {
  ByteSize,
  byte_size,
  byte_size_count,
  HardwareThreadCount,
  hardware_thread_count,
  hardware_thread_count_value,
  Watt,
  watt,
  watt_count,
  measure_fit_count_floor,
  measure_le,
  measure_scale_fraction_ceil,
}
import std.realization_width { int_min }
import std.realization_schedule {
  Runnable,
  RunnableSingleClaim,
  RunnableDiscoveryBatch,
  RunnableKernelWorkload,
  RunnableResourceProfile,
  runnable_predicted_space,
  runnable_profile,
}

type ResourceAxis
  = MemoryAxis
  | ComputeAxis
  | StorageAxis
  | EnergyAxis

type StaticResourcePeak {
  memory: ByteSize
  compute: HardwareThreadCount
  storage: ByteSize
  energy: Watt
}

type ResourceCap {
  memory: ByteSize
  compute: HardwareThreadCount
  storage: ByteSize
  energy: Watt
}

type AxisReconciliation
  = AxisWithinCap
  | AxisOverCap { axis: ResourceAxis }

type EnvelopeReconciliation
  = EnvelopeFits
  | EnvelopeOverCap { axis: ResourceAxis }

type DeclaredSizeBound {
  witness_count: Nat
  source_node_count: Nat
  corpus_node_count: Nat
}

type PerUnitPeakCost {
  per_witness_memory: ByteSize
  per_source_node_memory: ByteSize
  per_corpus_node_memory: ByteSize
  per_witness_compute: HardwareThreadCount
  per_witness_storage: ByteSize
  per_witness_energy: Watt
}

fn static_peak_zero() -> StaticResourcePeak {
  StaticResourcePeak {
    memory: byte_size(count: 0)
    compute: hardware_thread_count(count: 1)
    storage: byte_size(count: 0)
    energy: watt(count: 0)
  }
}

fn static_peak(
  memory: ByteSize,
  compute: HardwareThreadCount,
  storage: ByteSize,
  energy: Watt
) -> StaticResourcePeak {
  StaticResourcePeak {
    memory: memory
    compute: compute
    storage: storage
    energy: energy
  }
}

fn static_peak_memory(peak: StaticResourcePeak) -> ByteSize {
  peak.memory
}

fn static_peak_compute(peak: StaticResourcePeak) -> HardwareThreadCount {
  peak.compute
}

fn reconcile_byte_axis(cap: ByteSize, demand: ByteSize, axis: ResourceAxis) -> AxisReconciliation {
  if byte_size_count(b: demand) == 0 {
    AxisWithinCap
  } else if measure_le(a: demand, b: cap) {
    AxisWithinCap
  } else {
    AxisOverCap { axis: axis }
  }
}

fn reconcile_compute_axis(cap: HardwareThreadCount, demand: HardwareThreadCount) -> AxisReconciliation {
  if hardware_thread_count_value(t: demand) <= hardware_thread_count_value(t: cap) {
    AxisWithinCap
  } else {
    AxisOverCap { axis: ComputeAxis }
  }
}

fn reconcile_watt_axis(cap: Watt, demand: Watt) -> AxisReconciliation {
  if watt_count(w: demand) == 0 {
    AxisWithinCap
  } else if watt_count(w: demand) <= watt_count(w: cap) {
    AxisWithinCap
  } else {
    AxisOverCap { axis: EnergyAxis }
  }
}

fn envelope_reconciled(peak: StaticResourcePeak, cap: ResourceCap) -> EnvelopeReconciliation {
  match reconcile_byte_axis(cap: cap.memory, demand: peak.memory, axis: MemoryAxis) {
    AxisOverCap { axis: a } => EnvelopeOverCap { axis: a }
    AxisWithinCap =>
      match reconcile_compute_axis(cap: cap.compute, demand: peak.compute) {
        AxisOverCap { axis: a } => EnvelopeOverCap { axis: a }
        AxisWithinCap =>
          match reconcile_byte_axis(cap: cap.storage, demand: peak.storage, axis: StorageAxis) {
            AxisOverCap { axis: a } => EnvelopeOverCap { axis: a }
            AxisWithinCap =>
              match reconcile_watt_axis(cap: cap.energy, demand: peak.energy) {
                AxisOverCap { axis: a } => EnvelopeOverCap { axis: a }
                AxisWithinCap => EnvelopeFits
              }
          }
      }
  }
}

fn envelope_fits_cap(peak: StaticResourcePeak, cap: ResourceCap) -> Bool {
  match envelope_reconciled(peak: peak, cap: cap) {
    EnvelopeFits => true
    EnvelopeOverCap { axis: _ } => false
  }
}

fn width_from_memory_cap(cap: ByteSize, per_unit_peak: ByteSize) -> Int {
  if byte_size_count(b: cap) == 0 {
    0
  } else if byte_size_count(b: per_unit_peak) == 0 {
    0
  } else {
    nat_max(
      a: measure_fit_count_floor(capacity: cap, each: per_unit_peak),
      b: 1
    )
  }
}

fn width_from_storage_cap(cap: ByteSize, per_unit_peak: ByteSize) -> Int {
  width_from_memory_cap(cap: cap, per_unit_peak: per_unit_peak)
}

fn width_from_compute_cap(cap: HardwareThreadCount, shard_count: Int) -> Int {
  let cores = hardware_thread_count_value(t: cap)
  let demand = if shard_count <= 0 { 1 } else { shard_count }
  int_min(a: cores, b: demand)
}

fn derive_spawn_width(
  cap: ResourceCap,
  peak: StaticResourcePeak,
  shard_count: Int
) -> HardwareThreadCount {
  let mem_w = width_from_memory_cap(cap: cap.memory, per_unit_peak: peak.memory)
  let stor_w = width_from_storage_cap(cap: cap.storage, per_unit_peak: peak.storage)
  let cpu_w = width_from_compute_cap(cap: cap.compute, shard_count: shard_count)
  let bound = int_min(a: mem_w, b: int_min(a: stor_w, b: cpu_w))
  hardware_thread_count(count: nat_max(a: bound, b: 1))
}

fn projected_concurrent_memory_peak(width: HardwareThreadCount, per_shard_peak: ByteSize) -> ByteSize {
  measure_scale_fraction_ceil(
    m: per_shard_peak,
    num: hardware_thread_count_value(t: width),
    den: 1
  )
}

fn static_peak_from_declared_sizes(
  sizes: DeclaredSizeBound,
  unit: PerUnitPeakCost
) -> StaticResourcePeak {
  let witness_mem = measure_scale_fraction_ceil(
    m: unit.per_witness_memory,
    num: sizes.witness_count,
    den: 1
  )
  let source_mem = measure_scale_fraction_ceil(
    m: unit.per_source_node_memory,
    num: sizes.source_node_count,
    den: 1
  )
  let corpus_mem = measure_scale_fraction_ceil(
    m: unit.per_corpus_node_memory,
    num: sizes.corpus_node_count,
    den: 1
  )
  let memory = byte_size(
    count: byte_size_count(b: witness_mem)
      + byte_size_count(b: source_mem)
      + byte_size_count(b: corpus_mem)
  )
  let compute = hardware_thread_count(
    count: nat_max(
      a: hardware_thread_count_value(t: unit.per_witness_compute) * sizes.witness_count,
      b: 1
    )
  )
  let storage = measure_scale_fraction_ceil(
    m: unit.per_witness_storage,
    num: sizes.witness_count,
    den: 1
  )
  let energy = watt(count: watt_count(w: unit.per_witness_energy) * sizes.witness_count)
  static_peak(memory: memory, compute: compute, storage: storage, energy: energy)
}

fn peak_from_runnable_profile(
  profile: RunnableResourceProfile,
  compute_threads: HardwareThreadCount
) -> StaticResourcePeak {
  static_peak(
    memory: runnable_predicted_space(profile: profile),
    compute: compute_threads,
    storage: byte_size(count: 0),
    energy: watt(count: 0)
  )
}

fn runnable_static_peak(r: Runnable) -> StaticResourcePeak {
  match r {
    RunnableSingleClaim { entry: _, function: _, profile: p } =>
      peak_from_runnable_profile(profile: p, compute_threads: hardware_thread_count(count: 1))
    RunnableDiscoveryBatch {
      source_roots: _,
      scan_dirs: _,
      explicit_entries: _,
      skip_unaffected_node_frontier: _,
      exclude_substrings: _,
      discovery_scope_dirs: _,
      spawn_width_cap: cap,
      profile: p
    } =>
      peak_from_runnable_profile(
        profile: p,
        compute_threads: hardware_thread_count(count: if cap <= 0 { 1 } else { cap })
      )
    RunnableKernelWorkload { fused_op_count: _ } =>
      static_peak_zero()
  }
}

fn schedule_peak_envelope(runnables: List<Runnable>) -> StaticResourcePeak {
  fold(runnables, init: static_peak_zero(), f: fn(acc, r) {
    let peak = runnable_static_peak(r: r)
    static_peak(
      memory: if byte_size_count(b: peak.memory) > byte_size_count(b: acc.memory) {
        peak.memory
      } else {
        acc.memory
      },
      compute: if hardware_thread_count_value(t: peak.compute) > hardware_thread_count_value(t: acc.compute) {
        peak.compute
      } else {
        acc.compute
      },
      storage: if byte_size_count(b: peak.storage) > byte_size_count(b: acc.storage) {
        peak.storage
      } else {
        acc.storage
      },
      energy: if watt_count(w: peak.energy) > watt_count(w: acc.energy) {
        peak.energy
      } else {
        acc.energy
      }
    )
  })
}

fn witness_envelope_fits_when_all_axes_within_cap() -> Bool {
  let peak = static_peak(
    memory: byte_size(count: 1000),
    compute: hardware_thread_count(count: 2),
    storage: byte_size(count: 500),
    energy: watt(count: 10)
  )
  let cap = ResourceCap {
    memory: byte_size(count: 2000)
    compute: hardware_thread_count(count: 4)
    storage: byte_size(count: 1000)
    energy: watt(count: 20)
  }
  envelope_fits_cap(peak: peak, cap: cap)
}

fn witness_envelope_red_on_memory_over_cap() -> Bool {
  let peak = static_peak(
    memory: byte_size(count: 3000),
    compute: hardware_thread_count(count: 1),
    storage: byte_size(count: 0),
    energy: watt(count: 0)
  )
  let cap = ResourceCap {
    memory: byte_size(count: 2000)
    compute: hardware_thread_count(count: 128)
    storage: byte_size(count: 0)
    energy: watt(count: 0)
  }
  match envelope_reconciled(peak: peak, cap: cap) {
    EnvelopeOverCap { axis: a } => a == MemoryAxis
    EnvelopeFits => false
  }
}

fn witness_derived_width_memory_limited() -> Bool {
  let peak = static_peak(
    memory: byte_size(count: 2100028416),
    compute: hardware_thread_count(count: 128),
    storage: byte_size(count: 0),
    energy: watt(count: 0)
  )
  let cap = ResourceCap {
    memory: byte_size(count: 6442450944)
    compute: hardware_thread_count(count: 128)
    storage: byte_size(count: 0)
    energy: watt(count: 0)
  }
  hardware_thread_count_value(
    t: derive_spawn_width(cap: cap, peak: peak, shard_count: 7)
  ) == 2
}

fn witness_declared_sizes_derive_memory_peak() -> Bool {
  let sizes = DeclaredSizeBound {
    witness_count: 100
    source_node_count: 0
    corpus_node_count: 0
  }
  let unit = PerUnitPeakCost {
    per_witness_memory: byte_size(count: 1000000)
    per_source_node_memory: byte_size(count: 0)
    per_corpus_node_memory: byte_size(count: 0)
    per_witness_compute: hardware_thread_count(count: 1)
    per_witness_storage: byte_size(count: 0)
    per_witness_energy: watt(count: 0)
  }
  byte_size_count(b: static_peak_from_declared_sizes(sizes: sizes, unit: unit).memory) == 100000000
}

fn witness_zero_demand_axis_does_not_bind() -> Bool {
  let peak = static_peak(
    memory: byte_size(count: 0),
    compute: hardware_thread_count(count: 1),
    storage: byte_size(count: 0),
    energy: watt(count: 0)
  )
  let cap = ResourceCap {
    memory: byte_size(count: 0)
    compute: hardware_thread_count(count: 7)
    storage: byte_size(count: 0)
    energy: watt(count: 0)
  }
  hardware_thread_count_value(
    t: derive_spawn_width(cap: cap, peak: peak, shard_count: 7)
  ) == 7
}
