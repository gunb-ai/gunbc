// std/cache_identity.dag — Cache store and artifact-kind identity carriers.
//
// P2 single authority for named cache interfaces and artifact-kind tags shared
// across std.cache_interface and product.compute_fabric (acyclic; no cross-import).

module std.cache_identity

import std.types { NonEmptyStr, ContentHash }

type CacheInterfaceId = NonEmptyStr where brand("CacheInterfaceId")
type ArtifactKindId = NonEmptyStr where brand("ArtifactKindId")

// Neutral digest bridge — cache_interface.ExecutionReceiptRef and
// compute_fabric.ExecutionReceipt link via this carrier only (no cross-import).
type ExecutionReceiptDigest = ContentHash where brand("ExecutionReceiptDigest")

// First ArtifactKindId inhabitant (resolve-cost PR2).
data resolved_graph_artifact_kind: ArtifactKindId = "resolved_graph"

// Parse-table memo inhabitant (v2.compiler.parse ParseTableRealization carrier).
data parse_table_artifact_kind: ArtifactKindId = "parse_table"

// Hermetic-fixture inhabitant: a wet-captured effect response keyed by content_hash(inputs).
// ONE artifact kind realized by TWO handlers — v1 on-disk RecordedFixture + v2 in-process
// EffectIoFixtureStore (extdeps/realization/hermetic_fixture.dag). The shared subject_digest
// is the content hash of the operation inputs; both handlers project it to a backend key.
data hermetic_fixture_artifact_kind: ArtifactKindId = "hermetic_fixture"

// Product identity for cited cache catalog dispatch (extdeps/cache/cache.dag).
type CacheInterfaceProduct
  = GhaActionsCache
  | SccacheLocal
  | BuildbuddyCas
  | CargoTargetDir
  | RustupToolchainStore
  | ResolvedGraphCache
  | ParseTableMemo
