// std/time_affine.dag -- affine time coordinates over an elapsed-time vector.
// Scope: Instant (affine coordinate), Milliseconds (vector), TimeAffine (ops), DrainWindow (#4883 consumer).

module std.time_affine

// 🟡 P-TIME-ELAPSED-CARRIER opaque ms vector; dissolve-on: re-point to Measure<Time,Milli> when consumable.
type Milliseconds {}

// 🟡 P-TIME-AFFINE affine coordinate (no Add: instant+instant is type-rejected); dissolve-on: snappy torsor lift.
type Instant {}

// 🟡 P-TIME-AFFINE-OPS concrete torsor ops difference(I,I)->Ms / translate(I,Ms)->I; dissolve-on: generic torsor lift.
type TimeAffine {
  difference: fn(Instant, Instant) -> Milliseconds
  translate:  fn(Instant, Milliseconds) -> Instant
}

// 🟡 P-TIME-AFFINE-CONSUMER #4883 burn-in window (coordinate + vector); dissolve-on: relocated TemporalAggregator.
type DrainWindow {
  first_failed_at: Instant
  min_down: Milliseconds
}
