module std.unicode

import std.types { Char }

type CharClass = Whitespace | Digit | IdentStart | IdentContinue

type CodePointRange {
  start: Int
  end_inclusive: Int
}

fn in_cp_range(cp: Int, r: CodePointRange) -> Bool {
  cp >= r.start && cp <= r.end_inclusive
}

fn cp_in_any_range(cp: Int, ranges: List<CodePointRange>) -> Bool {
  any(ranges, predicate: r => in_cp_range(cp: cp, r: r))
}

// XID_Start ranges from UAX31 Unicode 15.1 (DerivedCoreProperties.txt).
// These are the code points whose Unicode property XID_Start=Yes.
// Programming extension: underscore (U+005F) is added per UAX31 §2.5
// (connector punctuation is XID_Continue only, but conventional in all
// major programming languages as an identifier-start character).
data xid_start_ranges: List<CodePointRange> = [
  // Basic Latin letters
  { start: 65,    end_inclusive: 90 },    // A-Z
  { start: 97,    end_inclusive: 122 },   // a-z
  // Latin-1 Supplement letters
  { start: 170,   end_inclusive: 170 },   // ª feminine ordinal indicator
  { start: 181,   end_inclusive: 181 },   // µ micro sign
  { start: 186,   end_inclusive: 186 },   // º masculine ordinal indicator
  { start: 192,   end_inclusive: 214 },   // À..Ö
