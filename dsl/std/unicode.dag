// std/unicode.dag -- Unicode domain model for character classification.
//
// Follows the same modelling pattern as Encoding (std/encoding.dag) + @file_types:
// structured types for the domain, `data` for lookup tables, `fn` for
// classification.  Everything here is reusable -- other modules can
// import `char_display_width` for terminal layout, `in_block` for
// block membership queries, or the data tables for encoding detection.

module std.unicode

import std.types { Char }

// --- Lexical character classes (ASCII-oriented tokenizer vocabulary) ---
//
// These intentionally align with the historical Rust `u8` scanner helpers
// (`is_ascii_whitespace`, `is_ascii_digit`, `is_ascii_alphabetic`,
// `is_ascii_alphanumeric`) on the ASCII sub-range: they classify Unicode
// scalar values (`Char` / `Int` code points) by the same ASCII byte rules
// the v3 `.dag` tokenizer uses today. Full Unicode identifier classes are a
// separate follow-up.
//
// **Concept placement (non-blocking / exploratory):** `CharClass` here is
// *lexical* vocabulary (what a tokenizer treats as whitespace / ident) more than
// a Unicode-intrinsic property like `DisplayWidth`. It lives in `std.unicode`
// today as the nearest shared character-classification home (MODELING M9:
// DFS from `dsl/std/`). Once M1(2.8) allows structural class rows in
// tokenizer authority, revisit whether this sum moves to a lexical sibling
// (e.g. std-facing tokenize) vs staying co-located with scalar `Char` helpers.
//
// **Dissolution receipt — `CharClass` (modeling-discipline principle 4).**
// 🟢 TERMINAL at ASCII-oriented lexical scanner scope: four irreducible named
// buckets for the closed `char_in_class` dispatch (and the mirrored
// `TokenizerCharClass` in the v3 tokenizer bridge). Four-pattern ledger:
// 1 Fact placement — rejected: a single authority (`char_in_class`) already owns
//   all four predicates; scattering them would duplicate the same four-way
//   dispatch without a richer upstream fact.
// 2 Variant-is-data — rejected: shapes differ materially (fixed whitespace set
//   vs digit range vs letter/underscore rules; `IdentContinue` repeats the digit
//   codepoint range inline — no recursive `char_in_class` call, so CX/bounded
//   recursion can prove descent), not interchangeable labels on one record.
// 3 Algebraic form — rejected: not a thin `Apply` over one shared `std/`
//   numeric elimination; each variant names a distinct ASCII rule aligned with
//   the historical `u8::is_ascii_*` scanner contract until tokenizer authority
//   can read structural class rows (M1(2.8) class-5 gap #3).
// 4 Dimensional — rejected: variants are not axes of one interpretation space.
//
// Named follow-up (not silent variant accretion here): fuller Unicode-wide
// identifier classes / tokenizer structural consumption — ROADMAP tokenize lane.

type CharClass = Whitespace | Digit | IdentStart | IdentContinue

fn char_in_class(c: Char, class: CharClass) -> Bool {
  let cp = code_point(c: c)
  match class {
    // Match Rust `u8::is_ascii_whitespace`: TAB, LF, FF, CR, SPACE — not U+000B VT.
    Whitespace => cp == 9 || cp == 10 || cp == 12 || cp == 13 || cp == 32
    Digit => cp >= 48 && cp <= 57
    IdentStart => (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp == 95
    // Inline digit range (same as `Digit` arm) — do not call `char_in_class`
    // recursively here: same `c` gives no structural descent for CX proofs.
    IdentContinue => (cp >= 48 && cp <= 57)
      || (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp == 95
  }
}

// --- Display width classification ---
//
//      DisplayWidth
//      /     |     \
//  ZeroWidth Narrow Wide
//
// Set meaning:
//   ZeroWidth -- combining marks, zero-width joiners (0 terminal columns)
//   Narrow    -- most characters including ASCII, Latin (1 terminal column)
//   Wide      -- CJK ideographs, fullwidth forms, emoji (2 terminal columns)

type DisplayWidth = ZeroWidth | Narrow | Wide

fn display_width_columns(w: DisplayWidth) -> Int {
  match w {
    ZeroWidth => 0
    Narrow    => 1
    Wide      => 2
  }
}

// --- Unicode block model ---
// Each block is a named range of code points with a default display width.
// Reusable: other modules can query blocks for character classification,
// encoding detection, identifier validation, etc.

type UnicodeBlock {
  name: String
  start: Int
  end_inclusive: Int
  default_width: DisplayWidth
}

// Zero-width blocks (combining marks, variation selectors)
data zero_width_blocks: List<UnicodeBlock> = [
  { name: "Combining Diacritical Marks",             start: 768,   end_inclusive: 879,   default_width: ZeroWidth },
  { name: "Combining Diacritical Marks Extended",    start: 6832,  end_inclusive: 6911,  default_width: ZeroWidth },
  { name: "Combining Diacritical Marks Supplement",  start: 7616,  end_inclusive: 7679,  default_width: ZeroWidth },
  { name: "Combining Marks for Symbols",             start: 8400,  end_inclusive: 8447,  default_width: ZeroWidth },
  { name: "Variation Selectors",                     start: 65024, end_inclusive: 65039, default_width: ZeroWidth },
  { name: "Combining Half Marks",                    start: 65056, end_inclusive: 65071, default_width: ZeroWidth }
]

// Individual zero-width code points (outside zero-width blocks)
data zero_width_codepoints: List<Int> = [
  8203,   // U+200B Zero Width Space
  8204,   // U+200C Zero Width Non-Joiner
  8205,   // U+200D Zero Width Joiner
  65279   // U+FEFF Zero Width No-Break Space (BOM)
]

// Wide blocks (CJK, fullwidth forms, emoji)
data wide_blocks: List<UnicodeBlock> = [
  { name: "Hangul Jamo",                        start: 4352,   end_inclusive: 4447,   default_width: Wide },
  { name: "CJK Radicals and Symbols",           start: 11904,  end_inclusive: 12350,  default_width: Wide },
  { name: "Hiragana / Katakana / CJK Compat",   start: 12353,  end_inclusive: 13247,  default_width: Wide },
  { name: "CJK Extension A",                    start: 13312,  end_inclusive: 19903,  default_width: Wide },
  { name: "CJK Unified Ideographs",             start: 19968,  end_inclusive: 40959,  default_width: Wide },
  { name: "Yi Syllables and Radicals",           start: 40960,  end_inclusive: 42191,  default_width: Wide },
  { name: "Hangul Syllables",                    start: 44032,  end_inclusive: 55215,  default_width: Wide },
  { name: "CJK Compatibility Ideographs",       start: 63744,  end_inclusive: 64255,  default_width: Wide },
  { name: "CJK Compatibility Forms",            start: 65072,  end_inclusive: 65135,  default_width: Wide },
  { name: "Fullwidth ASCII",                    start: 65281,  end_inclusive: 65376,  default_width: Wide },
  { name: "Fullwidth Signs",                    start: 65504,  end_inclusive: 65510,  default_width: Wide },
  { name: "CJK Extension B+",                   start: 131072, end_inclusive: 196607, default_width: Wide },
  { name: "CJK Extension G+",                   start: 196608, end_inclusive: 262143, default_width: Wide },
  { name: "Misc Symbols and Dingbats",           start: 9728,   end_inclusive: 10175,  default_width: Wide },
  { name: "Symbols / Pictographs / Emoticons",   start: 127744, end_inclusive: 129535, default_width: Wide },
  { name: "Symbols Extended",                   start: 129536, end_inclusive: 131071, default_width: Wide }
]

// --- Classification functions ---

// Extract the integer code point from a Char.
// `+ 0` coerces branded Char to plain Int for the typechecker.
fn code_point(c: Char) -> Int {
  c + 0
}

fn in_block(cp: Int, block: UnicodeBlock) -> Bool {
  cp >= block.start && cp <= block.end_inclusive
}

fn char_display_width(c: Char) -> DisplayWidth {
  let cp = code_point(c: c)
  let is_zero_width = contains(zero_width_codepoints, item: cp) || any(zero_width_blocks, predicate: b => in_block(cp: cp, block: b))
  if is_zero_width { return ZeroWidth }
  if any(wide_blocks, predicate: b => in_block(cp: cp, block: b)) { return Wide }
  return Narrow
}

fn char_width(c: Char) -> Int {
  display_width_columns(w: char_display_width(c: c))
}

fn string_display_width(s: String) -> Int {
  let char_list = chars(s)
  let widths = char_list |> map(c => char_width(c: c))
  widths |> fold(init: 0, f: fn(acc, w) { acc + w })
}
