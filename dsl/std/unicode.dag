// XID_Continue-only ranges: code points in XID_Continue but not XID_Start
// (UAX31: digits, combining marks, connector punctuation).
// The underscore U+005F is here (connector punctuation), but the programming
// convention treats it as XID_Start too — see char_in_class below.
data xid_continue_only_ranges: List<CodePointRange> = [
  { start: 48,   end_inclusive: 57 },   // 0-9 decimal digits
  { start: 95,   end_inclusive: 95 },   // _ LOW LINE (connector punctuation)
  // Combining Diacritical Marks
  { start: 768,  end_inclusive: 879 },
  // Combining marks for various scripts
  { start: 1155, end_inclusive: 1161 },
  { start: 1425, end_inclusive: 1479 },  // Hebrew cantillation
  { start: 1552, end_inclusive: 1562 },  // Syriac combining
  { start: 1611, end_inclusive: 1631 },  // Arabic combining
  { start: 1632, end_inclusive: 1641 },  // Arabic-Indic digits ٠-٩
  { start: 1648, end_inclusive: 1648 },  // Arabic hamza above
  { start: 1750, end_inclusive: 1756 },  // Arabic combining
  { start: 1759, end_inclusive: 1764 },  // Arabic combining
  { start: 1767, end_inclusive: 1768 },  // Arabic combining
  { start: 1770, end_inclusive: 1773 },  // Arabic combining
  { start: 1776, end_inclusive: 1785 },  // Extended Arabic-Indic digits
  { start: 1809, end_inclusive: 1809 },  // Thaana combining
  { start: 1840, end_inclusive: 1866 },  // Thaana digits
  { start: 1958, end_inclusive: 1968 },
  { start: 1984, end_inclusive: 1993 },  // NKo digits
  { start: 2027, end_inclusive: 2035 },
  { start: 2045, end_inclusive: 2047 },
