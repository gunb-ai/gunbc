// std/memory/operator_fleet.dag — Operator srv1/srv2 concrete DIMM populations.
//
// srv1 (degraded usable RAM ~93 GiB): 6× server-listing sticks + 2× ECC REG
// single-rank sticks (same JEDEC part, distinct catalog variant).
// srv2 (~125 GiB usable): 8× server-listing sticks.

module std.memory.operator_fleet

import std.memory.types { DramModuleIdentity, HostMemoryPopulation, MemoryPopulationRow }
import std.types { Int }

data supply_srv1_memory: HostMemoryPopulation = HostMemoryPopulation {
  rows: [
    MemoryPopulationRow {
      dimm_identity: SkHynix { dimm: Hma82gr7afr4nVkServer },
      stick_count: 6,
    },
    MemoryPopulationRow {
      dimm_identity: SkHynix { dimm: Hma82gr7afr4nVkEccRegSingleRank },
      stick_count: 2,
    },
  ],
}

data supply_srv2_memory: HostMemoryPopulation = HostMemoryPopulation {
  rows: [
    MemoryPopulationRow {
      dimm_identity: SkHynix { dimm: Hma82gr7afr4nVkServer },
      stick_count: 8,
    },
  ],
}

// Observed usable bytes (operator spec 2026-06-02) — nominal population is
// 8×16 GiB per host; srv1 reports degraded due to mixed stick population.
data supply_srv1_observed_ram_bytes: Int = 99857989632
data supply_srv2_observed_ram_bytes: Int = 134217728000
