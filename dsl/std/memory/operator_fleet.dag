// std/memory/operator_fleet.dag — Operator srv1/srv2 concrete DIMM populations.
//
// srv1 (degraded usable RAM ~93 GiB): 6× server-listing sticks + 2× ECC REG
// single-rank sticks (same JEDEC part, distinct catalog variant).
// srv2 (~125 GiB usable): 8× server-listing sticks.

module std.memory.operator_fleet

import std.memory { host_memory_population_nominal_bytes }
import std.memory.types { DramModuleIdentity, HostMemoryPopulation, HostRamSupplyFacts, MemoryPopulationRow }
import std.types { Int }

data supply_srv1_memory: HostMemoryPopulation = HostMemoryPopulation {
  rows: [
    MemoryPopulationRow {
      dimm_identity: SkHynix { dimm: Hma82gr7afr4nVkServer },
      stick_count: 6,
    },
    MemoryPopulationRow {
      dimm_identity: SkHynix { dimm: Hma82gr7afr4nVkEccRegSingleRank },
      stick_count: 2,
    },
  ],
}

data supply_srv2_memory: HostMemoryPopulation = HostMemoryPopulation {
  rows: [
    MemoryPopulationRow {
      dimm_identity: SkHynix { dimm: Hma82gr7afr4nVkServer },
      stick_count: 8,
    },
  ],
}

data supply_srv1_nominal_ram_bytes: Int = host_memory_population_nominal_bytes(supply_srv1_memory)
data supply_srv2_nominal_ram_bytes: Int = host_memory_population_nominal_bytes(supply_srv2_memory)

// Observed usable bytes (operator spec 2026-06-02) — below nominal on srv1 (mixed sticks).
data supply_srv1_observed_ram_bytes: Int = 99857989632
data supply_srv2_observed_ram_bytes: Int = 134217728000

data supply_srv1_ram: HostRamSupplyFacts = HostRamSupplyFacts {
  nominal_bytes: supply_srv1_nominal_ram_bytes,
  observed_usable_bytes: supply_srv1_observed_ram_bytes,
}

data supply_srv2_ram: HostRamSupplyFacts = HostRamSupplyFacts {
  nominal_bytes: supply_srv2_nominal_ram_bytes,
  observed_usable_bytes: supply_srv2_observed_ram_bytes,
}
