// Generic time-measure constructor: a `Time` magnitude at ANY scale `<S>`, magnitude
// fixed at the concrete `Nat` node. This is the scale-AGNOSTIC surface the realization /
// measurement framework (std.realization_measurement) builds its roll-up algebra on —
// it names no particular scale, so the framework carries no scale CHOICE (DESIGN §3: the
// agnostic shape stays central, the scale CHOICE sits peripheral at the consumer). A
// consumer pins `<S>` (e.g. `Nano` for measured wall-clock) at its own boundary.
//
// `<M>` is fixed at `Nat` here, NOT generic: a magnitude-generic roll-up would need `+`/
// `max` over `<M>`, and algebra-inhabitance resolves only on concrete numeric nodes —
// the same where-clause substrate gap `GroupCompletion<M>` and the `Measure`
// constrained-inhabitance note above already carry. **Dissolution trigger:** when
// parametric where-clause syntax lands, widen to `<M> where M : CommutativeMonoid` and
// the roll-up algebra generalizes with it.
fn time_measure<S>(count: Nat) -> Measure<Time, S, Nat> {
  Measure { count: count }
}

// Memory magnitude at unit scale (Q-Unit composition; P2 single authority).
type ByteSize = Measure<Memory, One, Nat>

// Memory capacity in gibibytes (IEC GiB). Redfish TotalSystemMemoryGiB is explicit binary units.
type Gibibyte = Measure<Memory, Gibi, Nat>

fn gibibyte(count: Nat) -> Gibibyte {
  Gibibyte { count: count }
}

fn gibibyte_count(g: Gibibyte) -> Nat {
  g.count
}

fn gibibyte_to_byte_size(g: Gibibyte) -> ByteSize {
  byte_size(count: gibibyte_count(g) * gibibyte_scale_factor_bytes())
}

// DECOMPOSITION CHECKPOINT (DESIGN.md §2): 🟢 PRIMITIVE (parametric alias of the 🟢 `Measure`
// carrier; Information's FIRST inhabitant — sets precedent: Information = digital
// bits, atomic unit at scale One).
// 🟡 feature:memory-information-byte-bit-conversion — bind first cross-conversion
// consumer needing Memory <-> Information (byte <-> bit x8). x8 is non-decimal so
// it will NOT be an SI Scale; lands as a separate sub-unit authority (same pattern
// as currency ISO minor-unit at lines 205-209). Dissolve-on: first consumer.
type BitWidth = Measure<Information, One, Nat>

// Dimensional alias for sustained per-thread clock rate (SI hertz).
type Hertz = Measure<Frequency, One, Nat>

// Schedulable hardware thread count (extdeps.cpu catalog/deployment authority).
type HardwareThreadCount = Measure<Count, One, Nat>

// NOTE: the scale-FIXED nanosecond time alias `NanosecondDuration = Measure<Time, Nano,
// Nat>` is deliberately NOT defined here. A scale-fixed alias is a CHOICE, not generic
// dimensional vocabulary — it is parallel to `Milliwatt` (`Measure<Power, Milli, Nat>`,
// homed at its product consumer in #5235), not to the base SI units `Watt` / `Hertz`
// that stay below. std.measure keeps only the generic `Measure<Time, S, M>` carrier +
// `time_measure<S>`; the nanosecond CHOICE + its reason live at the timing-authority
// CONSUMER (std.verification), per DESIGN §3 (the agnostic shape stays central; the
// scale that selects a realization sits peripheral).

// Power magnitude at unit scale — the plain watt (SI derived: W = J/s). The dimension
// TDP specs, PSU ratings, and live draw are all quoted in. A power rating carries the
// Power dimension rather than a bare Int (the anemic-leaf trap, DESIGN §2): a sum of
// component draws stays power-typed (`total_power_watts`), and perf-per-watt divides a
// throughput BY a real dimension instead of an untyped number. M=Nat (ratings are
// non-negative whole watts at this layer); a fractional rung (e.g. tenths of a watt)
// would instantiate `<M>` like the signed electrical carriers, not a new alias.
type Watt = Measure<Power, One, Nat>

// Absolute thermal magnitude in degrees Celsius (Redfish ReadingUnits=Cel). M=Int —
// cold-aisle inlet readings can be sub-zero; ΔCelsius affine split deferred.
type Celsius = Measure<Temperature, One, Int>

// Fan tach magnitude in revolutions per minute (Redfish ReadingUnits=Rpm).
type RevolutionsPerMinute = Measure<RotationalSpeed, One, Nat>

fn watt(count: Nat) -> Watt {
  Watt { count: count }
}

fn watt_count(w: Watt) -> Nat {
  w.count
}

fn celsius(count: Int) -> Celsius {
  Celsius { count: count }
}

fn celsius_count(c: Celsius) -> Int {
  c.count
}

fn rpm(count: Nat) -> RevolutionsPerMinute {
  RevolutionsPerMinute { count: count }
}

fn rpm_count(r: RevolutionsPerMinute) -> Nat {
  r.count
}

// --- MoneyAmount<S>: price magnitude carrier ------------------------------
//
// DECOMPOSITION CHECKPOINT (DESIGN.md §2): 🟢 PRIMITIVE (parametric alias of the 🟢 `Measure`
// carrier; widening is on Scale, not new variants).
//
// `MoneyAmount<S> = Measure<Currency, S>` -- the money carrier the design
// doc §6 (measure-value-typing-design-2026-06-13) calls for: a fixed-point
// magnitude tagged with the `Currency` dimension, NEVER a `Float` (floating
// point for money is a representation defect -- the magnitude is an exact
// integer count of a sub-major denomination).
//
// `<S>` is the STORAGE scale of the integer `count`: the SI `Scale` at which
// the magnitude is denominated. The per-currency ISO 4217 minor-unit
// exponent is a SEPARATE authority (`std.currency.currency_minor_unit_exponent`)
// -- ISO minor units (10^-2 cents) are not SI `Scale` values, so the two
// axes stay distinct (Q-Unit-5: no new `Scale` values for currency).
//
// The currency *identity* (which currency) is carried alongside as a
// `std.currency.CurrencyCode`, not in the phantom `<Q>` (which is the
// dimension `Currency`, shared by all currencies). A consumer that needs a
// specific currency carries the pair `(CurrencyCode, MoneyAmount<S>)` --
// e.g. `product.compute_fabric.CostEstimate { unit_price, currency }`.
//
// Scale-fixed money aliases: `MoneyAmountMicro` (std, extdeps vendor-catalog boundary)
// and `MoneyMicros` (product.compute_fabric, CostEstimate consumers) both denote
// `MoneyAmount<Micro>`. Std keeps the parametric `MoneyAmount<S>` plus the extdeps-
// facing micro-scale alias; product owns the downstream nickname. Multi-hop alias
// field-access (G3 + multi-hop, gunbc#4885) is verified by execution via
// product.compute_fabric.MoneyMicros — see measure_two_hop_alias_count_roundtrip_holds.
// dissolution-trigger: collapse `MoneyAmountMicro` + `MoneyMicros` to parametric
// `MoneyAmount<Micro>` in field positions once v2 parametric-in-field-position eval
// lands (the v2-eval scaffold that forced the dual named aliases); repoint extdeps +
// product consumers and delete the witness cross-alias pump in hetzner_cost_quote_witness.
type MoneyAmount<S> = Measure<Currency, S, Nat>

// Micro-scale money at the extdeps boundary (Hetzner `*_eur_micros` source rows).
// Named alias required for v2 eval (parametric `MoneyAmount<Micro>` in field positions
// does not evaluate); product `MoneyMicros` is the downstream CostEstimate nickname.
// dissolution-trigger: see header on `MoneyAmountMicro`/`MoneyMicros` pair above.
type MoneyAmountMicro = MoneyAmount<Micro>

fn money_amount_micro(count: Nat) -> MoneyAmountMicro {
  MoneyAmountMicro { count: count }
}

fn money_amount_micro_count(m: MoneyAmountMicro) -> Nat {
  m.count
}

fn byte_size(count: Nat) -> ByteSize {
  ByteSize { count: count }
}

fn byte_size_count(b: ByteSize) -> Nat {
  b.count
}

fn bit_width(count: Nat) -> BitWidth {
  BitWidth { count: count }
}

fn bit_width_count(b: BitWidth) -> Nat {
  b.count
}

fn hertz(count: Nat) -> Hertz {
  Hertz { count: count }
}

fn hertz_count(h: Hertz) -> Nat {
  h.count
}

fn hardware_thread_count(count: Nat) -> HardwareThreadCount {
  HardwareThreadCount { count: count }
}

fn hardware_thread_count_value(t: HardwareThreadCount) -> Nat {
  t.count
}
