// std/measure.dag -- Measure / Quantity / Scale carrier (algebra-axis
// dimensional shape).
//
// Per Q-Unit-1..5 RATIFIED at gunbc#828 #issuecomment-4385412256 (2026-05-06),
// Q-Unit-1-Recanvas RATIFIED at gunbc#828 #issuecomment-4385539791
// (outer carrier renamed from `Unit` to `Measure` to avoid collision with
// kernel `Unit` terminal-object type at `dsl/std/types.dag`), and
// Q-Refined-Phantom-Composition option (c) RATIFIED 2026-05-06 (literal
// `Refined<Measure<...>, predicate>` form deferred to value-typed integration
// follow-up; this layer carries dimensional semantics via the `Quantity` /
// `Scale` tags only — no predicate refinement at the Measure level).
//
// Authority anchors (cited by rule-text quote per
// `brief-authoring-checklist.md`; bare line-number cites prohibited):
//   - Practice 4 (`docs/modeling-discipline.md#4-coproduct-dissolution`):
//     "Any new Rust enum with N >= 2 variants must have a checkpoint
//     comment naming its classification (🟢/🟡/🔴), with a ledger entry
//     if GREEN or a named trigger if YELLOW."
//   - `feedback_construction_over_ratchets`: "Don't build the predicate
//     ahead of consumer demand."
//   - `feedback_reason_not_label`: "The predicate name is the label;
//     the reason is the carrier's semantic content."
// Director ratifications recorded in gunbc#828 issue comments cited above.
// Worker brief lives outside this checkout (parent worktree); cross-program
// review reaches the brief through the gunbc#828 ratification thread.
//
// Scope (Phase-1 carrier landing):
//   - `Measure<Q, S>` -- phantom-parameter carrier for dimensional types.
//   - `Quantity`      -- what is being measured (Time, Length, Mass, ...).
//   - `Scale`         -- SI decimal scale exponent (Atto..Exa, `One` = 10^0).
//   - `scale_exponent(s: Scale) -> Int` -- structural exponent query
//     (typed exponent authority; lets Grounding consumers and downstream
//     algebraic consumers project a Scale value to its decimal exponent
//     without re-encoding the table at each call site).
//
// NOT in scope (deferred per brief):
//   - Aspect axis (PointKind / Magnitude / Instant / Rate) -> R4 C6.
//   - Scale-agnostic `Duration<S>` parametric form -> needs >=2 consumers.
//   - 3-axis `AlgebraMachineRoundingProduct` -> R4 C5.
//
// COMPOSITION (S9 Phase-3 reframe per Q-Unit-4 RATIFIED outer-Refined /
// inner-Measure, with option (c) deferral of the literal Refined wrapper):
//
//   Duration     :=  Measure<Time, One>     (Quantity-tagged; predicate deferred)
//   Milliseconds :=  Measure<Time, Milli>   (Quantity-tagged; predicate deferred)
//   Seconds      :=  Duration               (Q-Unit-3 collapse)
//
// Value-typed integration (Q-Refined-Phantom-Composition option (c) follow-up):
// `Measure<Q, S>` carries magnitude in `count`; phantom `<Q>` / `<S>` tag
// dimensional semantics. Predicate-bearing refinement (`Refined<Measure<…>>`)
// remains deferred per option (c).

module std.measure

import std.nat { Nat }
import std.types { Int }

// --- Quantity: what is being measured -------------------------------------
//
// PRACTICE 4 CHECKPOINT: 🟡 SCAFFOLD
// Dissolution trigger (Q-Unit-5 RATIFIED): "all Quantity values consumed
// by >= 1 Grounding emission rule". Until each value gates a real
// emission rule (Grounding consumer demonstrates need), the carrier
// is hand-modeled / speculative. Adding a new value without a
// corresponding emission rule violates
// `feedback_construction_over_ratchets`; new values require the P1
// substrate-fact-introduction procedure with named consumer demand.
type Quantity =
    Time
  | Length
  | Mass
  | Memory
  | Information
  | DataRate
  | Frequency
  | Count
  | Currency

// --- Scale: SI decimal scale exponent -------------------------------------
//
// PRACTICE 4 CHECKPOINT: 🟡 SCAFFOLD
// Same dissolution trigger as `Quantity`: "all Scale values consumed by
// >= 1 Grounding emission rule" (Q-Unit-5 RATIFIED).
//
// `One` is the unscaled identity (10^0) -- RATIFIED rename from `Unit`
// per Q-Unit-1 to avoid shadowing the outer carrier name and the
// kernel terminal-object `Unit` type.
//
// Scale is a typed exponent authority, not bare labels: the
// `scale_exponent` query below is the structural projection from a
// Scale value to its decimal exponent. Grounding consumers MUST go
// through `scale_exponent` rather than re-encoding the SI table per
// call site (single-source-of-truth invariant; cf. T-Numeric-Construction
// "single numeric authority" pattern).
type Scale =
    Atto       // 10^-18
  | Femto      // 10^-15
  | Pico       // 10^-12
  | Nano       // 10^-9
  | Micro      // 10^-6
  | Milli      // 10^-3
  | One        // 10^0   (identity scale; RATIFIED rename from `Unit` per Q-Unit-1)
  | Kilo       // 10^3
  | Mega       // 10^6
  | Giga       // 10^9
  | Tera       // 10^12
  | Peta       // 10^15
  | Exa        // 10^18

// --- scale_exponent: typed exponent authority -----------------------------
//
// Structural projection from `Scale` to its SI decimal exponent. This is
// the canonical query Grounding consumers and any downstream algebraic
// consumer (e.g., scale-arithmetic for unit conversion) bind against,
// rather than the bare variant names. Centralizing the table here means
// adding a new Scale value updates the exponent authority in one place.
//
// Total over all `Scale` inhabitants; exponents are i64-representable
// (range [-18, 18] in this enumeration).
fn scale_exponent(s: Scale) -> Int {
  match s {
    Atto  => -18
    Femto => -15
    Pico  => -12
    Nano  =>  -9
    Micro =>  -6
    Milli =>  -3
    One   =>   0
    Kilo  =>   3
    Mega  =>   6
    Giga  =>   9
    Tera  =>  12
    Peta  =>  15
    Exa   =>  18
  }
}

// --- Measure<Q, S>: phantom-parameter dimensional carrier -----------------
//
// PRACTICE 4 CHECKPOINT: 🟢 PRIMITIVE
// Parametric dimensional carrier: phantom `<Q>` / `<S>` tag semantics;
// `count` holds magnitude at the declared scale. Widening adds Quantity /
// Scale values, not new Measure variants.
// Per-target representation (Rust `std::time::Duration`, Python
// `datetime.timedelta`, Go `time.Duration`, etc.) is Grounding's job
// per Q-Unit-4 RATIFIED.
//
// CONSTRAINED-INHABITANCE GAP (P5 tracked scaffold):
//   Denotationally `<Q>` must inhabit `Quantity` and `<S>` must inhabit
//   `Scale` for `Measure<Q, S>` to carry dimensional semantics. The current
//   substrate has no parametric where-clause syntax (e.g., `<Q, S> where
//   Q : Quantity, S : Scale`), so this declaration accepts any type-
//   reference for `<Q>` / `<S>` at the parser/lower level. All intended
//   consumers in Phase-1 / Phase-2 of the carrier landing instantiate with
//   the ratified Quantity / Scale values (`Measure<Time, One>`,
//   `Measure<Time, Milli>`, etc.); the constraint holds for those sole
//   consumers by construction.
//
//   Same gap as `GroupCompletion<M>` / `FieldOfFractions<R>` in
//   `dsl/std/algebra.dag` (where-clause syntax is a substrate-feature
//   lane, not per-carrier ceremony). Mechanical Quantity / Scale
//   inhabitance witnesses are not declared at this layer for the same
//   substrate reason.
//
//   **Dissolution trigger:** when constrained-inhabitance / parametric
//   where-clause syntax lands in the substrate (separate substrate-feature
//   lane), tighten this declaration to require `<Q> : Quantity, <S> :
//   Scale`. Existing call sites continue to type-check by construction.
//
// HARD BOUNDARIES (per Q-Unit RATIFIED + option (c) RATIFIED):
//   - No `Refined<Measure<…>, predicate>` at this layer per option (c).
//   - No mechanical Measure-witness derivation declared here -- same
//     substrate gap as `GroupCompletion<M>`; inhabitance lens follow-up.
//   - v2 claim-run: phantom type-arg resolution (G1) and single-hop alias
//     field access (G2) now resolve on the v2 interpreter; parametric record
//     literals (G3) and multi-hop alias field-access chains remain gated.
//     Consumers use the constructor/projection fns below until G3 lands.
type Measure<Q, S> {
  count: Nat
}

// Memory magnitude at unit scale (Q-Unit composition; P2 single authority).
type ByteSize = Measure<Memory, One>

// PRACTICE 4 CHECKPOINT: 🟢 PRIMITIVE (parametric alias of the 🟢 `Measure`
// carrier; Information's FIRST inhabitant — sets precedent: Information = digital
// bits, atomic unit at scale One).
// 🟡 feature:memory-information-byte-bit-conversion — bind first cross-conversion
// consumer needing Memory <-> Information (byte <-> bit x8). x8 is non-decimal so
// it will NOT be an SI Scale; lands as a separate sub-unit authority (same pattern
// as currency ISO minor-unit at lines 205-209). Dissolve-on: first consumer.
type BitWidth = Measure<Information, One>

// Dimensional alias for sustained per-thread clock rate (SI hertz).
type Hertz = Measure<Frequency, One>

// Schedulable hardware thread count (std.cpu catalog/deployment authority).
type HardwareThreadCount = Measure<Count, One>

// --- MoneyAmount<S>: price magnitude carrier ------------------------------
//
// PRACTICE 4 CHECKPOINT: 🟢 PRIMITIVE (parametric alias of the 🟢 `Measure`
// carrier; widening is on Scale, not new variants).
//
// `MoneyAmount<S> = Measure<Currency, S>` -- the money carrier the design
// doc §6 (measure-value-typing-design-2026-06-13) calls for: a fixed-point
// magnitude tagged with the `Currency` dimension, NEVER a `Float` (floating
// point for money is a representation defect -- the magnitude is an exact
// integer count of a sub-major denomination).
//
// `<S>` is the STORAGE scale of the integer `count`: the SI `Scale` at which
// the magnitude is denominated. The per-currency ISO 4217 minor-unit
// exponent is a SEPARATE authority (`std.currency.currency_minor_unit_exponent`)
// -- ISO minor units (10^-2 cents) are not SI `Scale` values, so the two
// axes stay distinct (Q-Unit-5: no new `Scale` values for currency).
//
// The currency *identity* (which currency) is carried alongside as a
// `std.currency.CurrencyCode`, not in the phantom `<Q>` (which is the
// dimension `Currency`, shared by all currencies). A consumer that needs a
// specific currency carries the pair `(CurrencyCode, MoneyAmount<S>)` --
// e.g. `std.compute_fabric.CostEstimate { unit_price, currency }`.
//
// `MoneyAmount` is a MULTI-HOP alias (MoneyMicros = MoneyAmount<Micro> =
// Measure<Currency, Micro>); its phantom type args resolve on v2 (G1 landed),
// but reading its `.count` is the multi-hop alias field-access case that the
// single-hop G2 does not yet cover -- the money VALUE on v2 lands with the G3
// follow-up. `std.currency` (a plain enum) evaluates on v2 today.
type MoneyAmount<S> = Measure<Currency, S>

// Micro-denominated money (storage scale = `Micro`, 10^-6 major units).
// Demanded by Hetzner cost quotes, whose source data is `*_eur_micros`
// (e.g. 50500 micro-EUR/hour) -- micros are finer than the EUR minor unit
// (cent), so a minor-unit `<One>` carrier could not hold them losslessly.
type MoneyMicros = MoneyAmount<Micro>

fn money_micros(count: Nat) -> MoneyMicros {
  MoneyMicros { count: count }
}

// 🟡 consumer:G3-multi-hop-alias-field-access — bind gunbc#4885 (G3 flip lane).
// Inline `Measure<Currency, Micro>` dodges v2 multi-hop `.count` on `MoneyMicros` pre-flip.
// Dissolve-on: #4885 merge — repoint param to `MoneyMicros`; coordinate with snappy-stag-903.
fn money_micros_count(m: Measure<Currency, Micro>) -> Nat {
  m.count
}

fn byte_size(count: Nat) -> ByteSize {
  ByteSize { count: count }
}

fn byte_size_count(b: ByteSize) -> Nat {
  b.count
}

fn bit_width(count: Nat) -> BitWidth {
  BitWidth { count: count }
}

fn bit_width_count(b: BitWidth) -> Nat {
  b.count
}

fn hertz(count: Nat) -> Hertz {
  Hertz { count: count }
}

fn hertz_count(h: Hertz) -> Nat {
  h.count
}

fn hardware_thread_count(count: Nat) -> HardwareThreadCount {
  HardwareThreadCount { count: count }
}

fn hardware_thread_count_value(t: HardwareThreadCount) -> Nat {
  t.count
}
