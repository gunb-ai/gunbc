// shared/credentials.dag -- Transitional credential helpers for concrete workflows.
//
// Centralizes the credential-resolution paths that are executable today
// while profile-bound CredentialProvider lowering is still incomplete.
// This keeps workflow-local policy in one place instead of duplicating
// env/secret-manager branches per tool.

module shared.credentials

import extdeps.cloud.gcp.core { shell.GCloud }
import extdeps.shell { shell.Env }
import std.types { NonEmptyStr }

fn llm_api_env_var(provider: String) -> NonEmptyStr {
  match provider {
    "openai" => "OPENAI_API_KEY"
    _ => "ANTHROPIC_API_KEY"
  }
}

func resolve_secret_from_env(env_name: NonEmptyStr) -> { token: Secret } {
  env = shell.Env.Get(name: env_name)
  match env.value {
    Some(token) => return { token: token }
    None => return { token: "" }
  }
}

func resolve_secret_from_env_or_gcp_secret(
  env_name: NonEmptyStr,
  project_id: NonEmptyStr = "gunbai-secrets",
  secret_name: NonEmptyStr?
) -> { token: Secret } {
  env = shell.Env.Get(name: env_name)
  match env.value {
    Some(token) => return { token: token }
    None => match secret_name {
      Some(name) => {
        secret = shell.GCloud.SecretManagerAccessVersion(
          project_id: project_id,
          secret_name: name
        )
        return { token: secret.secret_value }
      }
      None => return { token: "" }
    }
  }
}

func resolve_github_token(
  allow_secret_manager_fallback: Bool = false,
  project_id: NonEmptyStr = "gunbai-secrets",
  secret_name: NonEmptyStr = "github-token"
) -> { token: Secret } {
  fallback_secret_name = match allow_secret_manager_fallback {
    true => secret_name
    false => null
  }

  resolved = resolve_secret_from_env_or_gcp_secret(
    env_name: "GITHUB_TOKEN",
    project_id: project_id,
    secret_name: fallback_secret_name
  )

  return { token: resolved.token }
}

func resolve_llm_api_key(provider: String) -> { token: Secret } {
  env_name = llm_api_env_var(provider: provider)
  resolved = resolve_secret_from_env(env_name: env_name)
  return { token: resolved.token }
}
