// shared/gist_modes.dag -- Shared helpers for the snapshot/diff/recent pattern.
//
// Both gist and dag-viz (and any future tool that wants to share content
// as a gist) follow the same 3-mode structure:
//
//   snapshot:  produce_content()               -> share
//   diff:      produce_content(base_ref)       -> share
//   recent:    resolve_base(since) -> diff mode -> share
//
// This module factors out the shared pieces:
//   resolve_recent_base  -- "recent" mode base ref resolution
//   share_content        -- branch detection + gist upload
//   branch_context       -- branch detection (used by snapshot/diff modes)

module shared.gist_modes

import services.git
import services.github.gist
import std.patterns { credential_chain }
import std.resources { Network, AuthContext, Clock }
import std.types { CloudRuntime, CommitSha, Url }

// Get branch context for any mode.
func branch_context() -> { branch: String } {
  current = git.Core.CurrentBranch()

  return {
    branch: current.branch
  }
}

// Resolve the base ref for "recent" mode.
func resolve_recent_base(since: String = "3.days.ago") -> { base_ref: CommitSha, branch: String } {
  ctx = branch_context()
  commits = git.Core.RevList(since: since)
  base_ref = (commits.commits |> last()) as CommitSha

  return {
    base_ref: base_ref,
    branch: ctx.branch
  }
}

// Filename for a gist upload.
fn gist_filename(branch: String, base_ref: CommitSha?, timestamp: String) -> String {
  let suffix = match base_ref {
    Some(ref) => "-vs-{ref}"
    None      => ""
  }
  "snapshot-{branch}{suffix}-{timestamp}.md"
}

// Upload markdown content as a GitHub gist.
func gist_upload(markdown: String, branch: String, base_ref: CommitSha?) -> { url: Url }
  uses net: Network
  uses clock: Clock
  uses auth: AuthContext
{
  timestamp = clock.now()
  filename = gist_filename(
    branch: branch,
    base_ref: base_ref,
    timestamp: timestamp.timestamp
  )

  cred = credential_chain(
    runtime: detect_runtime(),
    audience: "sigstore",
    project: "gunbc",
    secret_name: "github-token",
    source_id: "gist",
    required_scopes: ["gist"],
    service_account: None
  )

  result = github.Gist.Create(
    description: "Snapshot from {branch}",
    files: { filename: markdown }
  )

  return { url: result.url as Url }
}

// Share any markdown content as a gist.
func share_content(markdown: String, branch: String, base_ref: CommitSha?) -> { url: Url } {
  result = gist_upload(
    markdown: markdown,
    branch: branch,
    base_ref: base_ref
  )

  return { url: result.url }
}

fn detect_runtime() -> CloudRuntime {
  LocalDev
}
