// tools/cache_purity_audit_gate.dag — the warm==cold cache-purity SHADOW AUDIT as a fail-closed
// CI floor gate (DESIGN §5; ROADMAP §2 P3). The live continuous falsifier that makes ENABLING the
// resolved-graph cache safe: a cache is enabled ONLY behind its purity oracle.
//
// Over every floor discovery-corpus entry, a WARM resolved-graph cache hit must equal a fresh COLD
// compute (canonical structural `==`; the codec, write→read, is the only difference under test).
// A divergence is a located, typed, LOUD `CachePurityViolation` and FAILS the gate — the v1
// handler is `src/v1/stage0/src/cache_purity_audit.rs`, run via the prebuilt `cache_purity_audit`
// release bin (the floor's release bootstrap builds it with `--bins`).
//
// ISOLATED EMPTY CACHE (not the shared persistent corpus cache the floor enables): the audit's
// COLD pass must genuinely MISS→compute→write so the warm hit has a cold compute to be compared
// against. Pointed at the floor's already-primed corpus cache, COLD would HIT and the audit would
// compare decode-vs-decode — vacuous. The codec it verifies is cache-dir-independent, so a fresh
// `mktemp -d` per gate run is correct AND independent of the corpus enable. Hence this gate's
// transport sets `GUNBC_RESOLVED_GRAPH_CACHE_DIR` to its OWN empty dir, distinct from the
// workflow-level var the discovery corpus consumes.
//
// §5 honest residual: SOUND over the CI discovery corpus, NOT COMPLETE over all realizations — a
// prod-only realization never resolved in CI can still go impure silently (surfaced by the bin).
//
// Roots/scan-dirs: gunbc.ci_layer_roots (§3 single authority — same corpus the floor discovers).
// dissolve-on: the v2 realize fold self-hosts this comparison (ROADMAP §2 P5).

module tools.cache_purity_audit_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.shell
import gunbc.ci_layer_roots { witness_layer_roots, witness_discovery_scan_dirs }
import extdeps.languages.bash.program {
  ShellProgram, ShellStmt, ShellWord,
  EnvPrefixed, CmdSubst, Concat,
  lit, var_ref, command, assign, serialize_bash
}
import tools.host_prelude { ensure_bin_built_and_verified }

// --source-root <r> for every witness_layer_root (§3 — same roots as the rest of CI).
fn cpa_source_root_flags() -> List<ShellWord> {
  fold(witness_layer_roots, init: [], f: (acc, r) => concat(acc, [lit(text: "--source-root"), lit(text: r)]))
}

// --scan-dir <d> for every discovery scan dir (the corpus the floor enrolls).
fn cpa_scan_dir_flags() -> List<ShellWord> {
  fold(witness_discovery_scan_dirs, init: [], f: (acc, d) => concat(acc, [lit(text: "--scan-dir"), lit(text: d)]))
}

// ensure-built+verified cache_purity_audit; cd "$ROOT"; CACHE=$(mktemp -d);
// GUNBC_RESOLVED_GRAPH_CACHE_DIR="$CACHE" "$CACHE_PURITY_AUDIT" --source-root … --scan-dir …;
// rm -rf "$CACHE"
fn cache_purity_audit_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  let bin = var_ref(name: "CACHE_PURITY_AUDIT")
  let cache = var_ref(name: "CACHE")
  ShellProgram {
    set_e: true,
    statements: concat(
      ensure_bin_built_and_verified(var_name: "CACHE_PURITY_AUDIT", bin_name: "cache_purity_audit"),
      [
        command(words: [lit(text: "cd"), root]),
        assign(name: "CACHE", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
        EnvPrefixed {
          name: "GUNBC_RESOLVED_GRAPH_CACHE_DIR",
          value: cache,
          command: command(words: concat(
            [bin],
            concat(cpa_source_root_flags(), cpa_scan_dir_flags())
          ))
        },
        command(words: [lit(text: "rm"), lit(text: "-rf"), cache])
      ]
    )
  }
}

fn run_cache_purity_audit() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: cache_purity_audit_program()))
  result.success
}

func run_cache_purity_audit_gate_body() -> ProcessExit {
  if run_cache_purity_audit() {
    ExitSuccess
  } else {
    exit_failure(
      reason: "cache purity audit gate failed: warm!=cold on the floor discovery corpus (the resolved-graph cache codec is lossy/stale — a warm hit serves a different graph than a cold recompute; DESIGN §5)"
    )
  }
}

func run_cache_purity_audit_gate() -> ProcessExit {
  run_cache_purity_audit_gate_body()
}

func main() -> ProcessExit {
  run_cache_purity_audit_gate_body()
}
