// tools/cigen.dag -- CI YAML generation.
//
// Renders GitHub Actions and GitLab CI workflow files from DSL data
// declarations. Follows the makegen pattern: extern discovery for
// dynamic values, pure rendering for everything else, content_upsert
// for output.
//
// Composition:
//   Layer 0: std/render.dag          — common render primitives
//   Layer 1: extdeps/yaml.dag        — YAML serialization
//            extdeps/github_actions.dag, extdeps/gitlab_ci.dag
//   Layer 2: config/ci.dag           — our static CI configuration
//   Layer 3: this file               — rendering + entrypoint
//
// Replaces: codegen_cli.rs generate_github_actions_template(),
//           generate_gitlab_ci_template(), validate_*() (~200 lines)

module tools.cigen

import std.patterns { content_upsert }
import std.resources { Filesystem }
import extdeps.github_actions {
  EnvVar, Step, Workflow, cache_step, checkout_step, output_dir, run_step,
  rust_setup_step, rust_setup_step_pinned, secret_ref
}
import config.toolchain { rust_version, rust_toolchain_action }
import extdeps.github_actions_render { render_github_workflow_yaml }
import extdeps.gitlab_ci { Pipeline, Variable, output_path }
import extdeps.gitlab_ci_render { render_gitlab_pipeline_yaml }
import extdeps.ci_script { ScriptBlock }
import config.ci {
  ci_checkout, ci_generator, ci_github_base_workflow, ci_gitlab_base_pipeline,
  ci_regen_command, ci_runner, ci_timeout_minutes, ci_workflow_name
}

// ── Extern bridge ──────────────────────────────────────────────────

type CiDiscovery {
  secrets: List<String>
  run: ScriptBlock
  bootstrap: ScriptBlock?
}

extern func discover_ci_config() -> CiDiscovery

// ── Output paths ───────────────────────────────────────────────────

fn github_output_path() -> String {
  "{output_dir}/ci.yml"
}

fn gitlab_output_path() -> String {
  output_path
}

// ── Entry point ────────────────────────────────────────────────────

func cigen() -> { written: Bool }
  uses fs: Filesystem(mode: ReadWrite)
{
  discovery = discover_ci_config()

  github_secret_env = discovery.secrets
    |> map(s => { key: s, value: secret_ref(name: s) })
  github_cache_steps = match ci_github_base_workflow.cache {
    null => []
    config => [cache_step(cache: config)]
  }
  github_bootstrap_steps = match discovery.bootstrap {
    null => []
    script => [run_step(name: "Verify Bootstrap Invariants", script: script, env: [])]
  }
  github_run_env = [{ key: "CARGO_INCREMENTAL", value: "\"1\"" }]
    |> append(items: github_secret_env)
  github_steps = [
    checkout_step(checkout: ci_checkout),
    rust_setup_step_pinned(action: rust_toolchain_action, version: rust_version)
  ]
    |> append(items: github_cache_steps)
    |> append(items: github_bootstrap_steps)
    |> append(items: [run_step(name: "Run CI Pipeline", script: discovery.run, env: github_run_env)])
  github_workflow = ci_github_base_workflow with {
    jobs: [{
      id: ci_workflow_name,
      name: ci_workflow_name,
      runner: ci_runner,
      timeout_minutes: ci_timeout_minutes,
      steps: github_steps,
      needs: []
    }]
  }
  gitlab_secret_variables = discovery.secrets
    |> map(s => { key: s, value: "${s}" })
  gitlab_pipeline = ci_gitlab_base_pipeline with {
    variables: ci_gitlab_base_pipeline.variables
      |> append(items: gitlab_secret_variables),
    jobs: [{
      id: ci_workflow_name,
      stage: ci_gitlab_base_pipeline.stages |> first() ?? "ci",
      script: discovery.run,
      needs: [],
      variables: []
    }]
  }

  github_yaml = render_github_workflow_yaml(
    workflow: github_workflow,
    generator: ci_generator,
    regen_command: ci_regen_command
  )
  github_result = content_upsert(
    content: github_yaml,
    path: github_output_path()
  )

  gitlab_yaml = render_gitlab_pipeline_yaml(
    pipeline: gitlab_pipeline,
    generator: ci_generator,
    regen_command: ci_regen_command
  )
  gitlab_result = content_upsert(
    content: gitlab_yaml,
    path: gitlab_output_path()
  )

  return { written: github_result.written || gitlab_result.written }
}
