// tools/cigen.dag -- CI YAML generation.
//
// Renders GitHub Actions and GitLab CI workflow files from DSL data
// declarations. Follows the makegen pattern: extern discovery for
// dynamic values, pure rendering for everything else, content_upsert
// for output.
//
// Composition:
//   Layer 0: std/render.dag          — common render primitives
//   Layer 1: extdeps/yaml.dag        — YAML serialization
//            extdeps/github_actions.dag, extdeps/gitlab_ci.dag
//   Layer 2: config/ci.dag           — our static CI configuration
//   Layer 3: this file               — rendering + entrypoint
//
// Replaces: codegen_cli.rs generate_github_actions_template(),
//           generate_gitlab_ci_template(), validate_*() (~200 lines)

module tools.cigen

import std.patterns { content_upsert }
import std.resources { Filesystem }
import extdeps.yaml {
  yaml_header, yaml_indent, yaml_indented_mapping,
  yaml_indented_item, yaml_sequence_block
}
import extdeps.github_actions {
  Checkout, EnvVar, Permission, Trigger,
  checkout_action, rust_toolchain_action, cache_action, output_dir
}
import extdeps.gitlab_ci { output_path }
import config.ci {
  ci_cache_key, ci_cache_paths, ci_cache_restore_keys, ci_checkout, ci_env,
  ci_generator, ci_gitlab_cache_key, ci_gitlab_cache_paths, ci_gitlab_image,
  ci_permissions, ci_regen_command, ci_runner, ci_stages, ci_timeout_minutes,
  ci_trigger, ci_workflow_name
}

// ── Extern bridge ──────────────────────────────────────────────────

type CiDiscovery {
  secrets: List<String>
  tool_command: String
  bootstrap_script: String?
}

extern func discover_ci_config() -> CiDiscovery

// ── GitHub Actions: secret syntax ──────────────────────────────────

fn gha_secret_ref(name: String) -> String {
  "$\{\{ secrets.{name} \}\}"
}

// ── GitHub Actions: rendering ──────────────────────────────────────

fn render_gha_trigger(trigger: Trigger) -> String {
  "on:\n" +
    yaml_sequence_block(header: "  push:\n    branches:", level: 3, items: trigger.push_branches) +
    "\n" +
    yaml_sequence_block(header: "  pull_request:\n    branches:", level: 3, items: trigger.pr_branches)
}

fn render_gha_permissions(perms: List<Permission>) -> String {
  let lines = perms
    |> map(p => yaml_indented_mapping(level: 1, key: p.scope, value: p.level))
    |> join("\n")
  "permissions:\n{lines}"
}

fn render_gha_env(env: List<EnvVar>) -> String {
  let lines = env
    |> map(e => yaml_indented_mapping(level: 1, key: e.key, value: e.value))
    |> join("\n")
  "env:\n{lines}"
}

fn render_gha_step_env(env: List<EnvVar>) -> String {
  if env |> count() == 0 { return "" }
  let lines = env
    |> map(e => yaml_indented_mapping(level: 5, key: e.key, value: e.value))
    |> join("\n")
  "\n        env:\n{lines}"
}

fn render_gha_uses_step(name: String, action: String, with_block: String) -> String {
  "      - name: {name}\n        uses: {action}{with_block}"
}

fn render_gha_run_step(name: String, command: String, env: List<EnvVar>) -> String {
  let env_block = render_gha_step_env(env: env)
  "      - name: {name}\n        run: {command}{env_block}"
}

fn render_checkout_step(checkout: Checkout) -> String {
  let fetch_depth_line = match checkout.fetch_depth {
    null => ""
    depth => "\n          fetch-depth: {depth}"
  }
  let submodules_line = match checkout.submodules {
    null => ""
    submodules => "\n          submodules: {submodules}"
  }
  render_gha_uses_step(
    name: "Checkout",
    action: checkout_action,
    with_block: "\n        with:{fetch_depth_line}{submodules_line}"
  )
}

fn render_rust_setup_step() -> String {
  render_gha_uses_step(
    name: "Setup Rust",
    action: rust_toolchain_action,
    with_block: ""
  )
}

fn render_cache_step(paths: List<String>, key: String, restore_keys: List<String>) -> String {
  let path_block = paths
    |> map(p => yaml_indent(level: 6, text: p))
    |> join("\n")
  let restore_block = restore_keys
    |> map(k => yaml_indent(level: 6, text: k))
    |> join("\n")
  render_gha_uses_step(
    name: "Cache Cargo",
    action: cache_action,
    with_block: "\n        with:\n          path: |\n{path_block}\n\n          key: {key}\n          restore-keys: |\n{restore_block}"
  )
}

fn render_bootstrap_step(script: String) -> String {
  render_gha_run_step(name: "Verify Bootstrap Invariants", command: "|\n{script}", env: [])
}

fn render_ci_run_step(discovery: CiDiscovery) -> String {
  let secret_env = discovery.secrets
    |> map(s => { key: s, value: gha_secret_ref(name: s) })
  let step_env = [{ key: "CARGO_INCREMENTAL", value: "\"1\"" }]
    |> append(items: secret_env)
  render_gha_run_step(name: "Run CI Pipeline", command: discovery.tool_command, env: step_env)
}

fn render_github_steps(discovery: CiDiscovery) -> String {
  let checkout = render_checkout_step(checkout: ci_checkout)
  let setup = render_rust_setup_step()
  let cache = render_cache_step(
    paths: ci_cache_paths,
    key: ci_cache_key,
    restore_keys: ci_cache_restore_keys
  )
  let bootstrap = match discovery.bootstrap_script {
    null => ""
    script => "\n\n" + render_bootstrap_step(script: script)
  }
  let run = render_ci_run_step(discovery: discovery)
  "{checkout}\n\n{setup}\n\n{cache}{bootstrap}\n\n{run}"
}

fn render_github_workflow(discovery: CiDiscovery) -> String {
  let header = yaml_header(generator: ci_generator, regen_command: ci_regen_command)
  let trigger = render_gha_trigger(trigger: ci_trigger)
  let perms = render_gha_permissions(perms: ci_permissions)
  let env = render_gha_env(env: ci_env)
  let steps = render_github_steps(discovery: discovery)
  let job = "  {ci_workflow_name}:\n    runs-on: {ci_runner.id}\n    timeout-minutes: {ci_timeout_minutes}\n    steps:\n{steps}"
  "{header}\n\nname: {ci_workflow_name}\n\n{trigger}\n\n{perms}\n\n{env}\n\njobs:\n{job}\n"
}

// ── GitLab CI: rendering ───────────────────────────────────────────

fn render_gitlab_variables(env: List<EnvVar>, secrets: List<String>) -> String {
  let env_lines = env
    |> map(e => yaml_indented_mapping(level: 1, key: e.key, value: "\"{e.value}\""))
    |> join("\n")
  let secret_lines = secrets
    |> map(s => yaml_indented_mapping(level: 1, key: s, value: "\"${s}\""))
    |> join("\n")
  if secrets |> count() > 0 {
    "variables:\n{env_lines}\n{secret_lines}"
  } else {
    "variables:\n{env_lines}"
  }
}

fn render_gitlab_cache(paths: List<String>, key: String) -> String {
  let lines = paths
    |> map(p => yaml_indented_item(level: 2, value: p))
    |> join("\n")
  "cache:\n  key: {key}\n  paths:\n{lines}"
}

fn render_gitlab_job(job_name: String, stage_name: String, tool_command: String) -> String {
  "{job_name}:\n  stage: {stage_name}\n  script:\n    - {tool_command}"
}

fn render_gitlab_pipeline(discovery: CiDiscovery) -> String {
  let header = yaml_header(generator: ci_generator, regen_command: ci_regen_command)
  let vars = render_gitlab_variables(
    env: ci_env,
    secrets: discovery.secrets
  )
  let stages = yaml_sequence_block(header: "stages:", level: 1, items: ci_stages)
  let cache = render_gitlab_cache(paths: ci_gitlab_cache_paths, key: ci_gitlab_cache_key)
  let job = render_gitlab_job(
    job_name: ci_workflow_name,
    stage_name: ci_stages |> first() ?? "ci",
    tool_command: discovery.tool_command
  )
  "{header}\n\nimage: {ci_gitlab_image}\n\n{vars}\n\n{stages}\n\n{cache}\n\n{job}\n"
}

// ── Output paths ───────────────────────────────────────────────────

fn github_output_path() -> String {
  "{output_dir}/ci.yml"
}

fn gitlab_output_path() -> String {
  output_path
}

// ── Entry point ────────────────────────────────────────────────────

func cigen() -> { written: Bool }
  uses fs: Filesystem(mode: ReadWrite)
{
  discovery = discover_ci_config()

  github_yaml = render_github_workflow(discovery: discovery)
  github_result = content_upsert(
    content: github_yaml,
    path: github_output_path()
  )

  gitlab_yaml = render_gitlab_pipeline(discovery: discovery)
  gitlab_result = content_upsert(
    content: gitlab_yaml,
    path: gitlab_output_path()
  )

  return { written: github_result.written || gitlab_result.written }
}
