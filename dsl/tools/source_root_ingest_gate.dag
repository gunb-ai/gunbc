// tools/source_root_ingest_gate.dag — Lane 3a real SourceRootIngest producer gate.
//
// Run in CI:
//   cargo run -p v1-compiler --release --bin gunbc -- run \
//     --source-root dsl --entry dsl/tools/source_root_ingest_gate.dag --function main

module tools.source_root_ingest_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.source_root_ingest_transport { run_real_ingest_gate }

func main() -> ProcessExit {
  if run_real_ingest_gate() {
    ExitSuccess
  } else {
    exit_failure(
      reason: "source root ingest gate failed: host manifest overlay + real_ingest_test receipts"
    )
  }
}

// Composed CI gate entry point (tools.ci_gates imports this name).
func run_source_root_ingest_ci_gate() -> ProcessExit {
  main()
}
