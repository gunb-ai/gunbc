// tools/purity_check.dag — Purity lens for .dag source.
//
// Validates the fn/func keyword distinction as a purity signal:
//   fn   = pure (expression body, no side effects)
//   func = effectful (may use resources, services, transport)
//
// This is a v3 validation experiment: a .dag tool that runs via the
// interpreter with ZERO compiler changes. The fn/func distinction is
// already enforced by convention; this lens makes it observable.
//
// Entry point:
//   run_purity_check()  -> ProcessExit, for dag run / CI
//
// Run via: dag run --source-root dsl --function run_purity_check

module tools.purity_check

import gunbc.compiler {
  compiler_source,
  resolve_compiler_tools, ToolsReady, ToolsMissing
}
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_code_general_error }
import extdeps.shell

// -- Result types ----------------------------------------------------

type FunctionPurity
  = Pure
  | Impure

type PurityReport {
  pure_count: Int
  impure_count: Int
  total: Int
  purity_ratio: String
}

type PurityCheckResult
  = PurityChecked { report: PurityReport }
  | PurityGrepError { stderr: String }
  | PurityToolsMissing { tool: String, hint: String }

// -- grep tri-state --------------------------------------------------
// Reuses the same POSIX tri-state as ratchet.dag:
//   0 = match found
//   1 = no match found
//   2 = error

type GrepOutcome
  = GrepMatch { stdout: String }
  | GrepNoMatch
  | GrepError { stderr: String }

fn classify_grep(exit_code: Int, stdout: String, stderr: String) -> GrepOutcome {
  if exit_code == 0 { GrepMatch { stdout: stdout } }
  else if exit_code == 1 { GrepNoMatch }
  else { GrepError { stderr: stderr } }
}

// -- Line counting ---------------------------------------------------
// Count lines in grep output by counting newlines. Each grep -c match
// returns a file:count line; we sum them by counting the output lines
// and parsing the wc output.

fn count_lines_command(grep: String, pattern: String, dir: String) -> String {
  concat(grep, " -rE '", pattern, "' ", dir, " --include='*.dag' | wc -l | tr -d ' '")
}

fn list_functions_command(grep: String, pattern: String, dir: String) -> String {
  concat(grep, " -rnE '", pattern, "' ", dir, "/*.dag")
}

// -- Purity check workflow -------------------------------------------

func check_purity() -> PurityCheckResult {
  match resolve_compiler_tools() {
    ToolsMissing { tool: t, hint: h } => PurityToolsMissing { tool: t, hint: h }
    ToolsReady { tools: t } => {
      let dir = "."

      // Count pure functions (fn declarations)
      let pure_run = shell.Exec.Run(
        script: count_lines_command(grep: t.grep, pattern: "^fn ", dir: dir)
      )
      let pure_result = classify_grep(
        exit_code: pure_run.exit_code,
        stdout: pure_run.stdout,
        stderr: pure_run.stderr
      )

      // Count impure functions (func declarations)
      let impure_run = shell.Exec.Run(
        script: count_lines_command(grep: t.grep, pattern: "^func ", dir: dir)
      )
      let impure_result = classify_grep(
        exit_code: impure_run.exit_code,
        stdout: impure_run.stdout,
        stderr: impure_run.stderr
      )

      // Fail closed on grep errors
      match pure_result {
        GrepError { stderr: e } => PurityGrepError { stderr: e }
        _ => match impure_result {
          GrepError { stderr: e } => PurityGrepError { stderr: e }
          _ => {
            let pure_count = match pure_result {
              GrepMatch { stdout: s } => parse_int(trim(s))
              GrepNoMatch => 0
              _ => 0
            }
            let impure_count = match impure_result {
              GrepMatch { stdout: s } => parse_int(trim(s))
              GrepNoMatch => 0
              _ => 0
            }
            let total = pure_count + impure_count

            PurityChecked {
              report: {
                pure_count: pure_count,
                impure_count: impure_count,
                total: total,
                purity_ratio: concat(to_string(pure_count), "/", to_string(total))
              }
            }
          }
        }
      }
    }
  }
}

// -- ProcessExit entry point -----------------------------------------

fn purity_to_exit(result: PurityCheckResult) -> ProcessExit {
  match result {
    PurityChecked { report: r } => ExitSuccess
    PurityGrepError { stderr: e } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("Purity check: grep error:\n", e)
    }
    PurityToolsMissing { tool: t, hint: h } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("Purity check: required tool missing: ", t, " (", h, ")")
    }
  }
}

func run_purity_check() -> ProcessExit {
  let result = check_purity()

  // Print summary before returning exit status
  match result {
    PurityChecked { report: r } => {
      let _ = shell.Exec.Run(
        script: concat("echo 'Purity Lens Report (src/v2/*.dag):\n",
                        "  Pure functions (fn):     ", to_string(r.pure_count), "\n",
                        "  Effectful functions (func): ", to_string(r.impure_count), "\n",
                        "  Total:                   ", to_string(r.total), "\n",
                        "  Purity ratio:            ", r.purity_ratio, "'")
      )
      ExitSuccess
    }
    _ => purity_to_exit(result: result)
  }
}
