module tools.wiring_liveness_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.wiring_liveness_transport { run_wiring_liveness_whole_tree }

func run_wiring_liveness_gate_body() -> ProcessExit {
  let clean = run_wiring_liveness_whole_tree()
  return if clean {
    ExitSuccess
  } else {
    exit_failure(
      reason: "wiring-liveness whole-tree gate failed: dead wires detected across the corpus"
    )
  }
}

func run_wiring_liveness_ci_gate() -> ProcessExit {
  run_wiring_liveness_gate_body()
}

func main() -> ProcessExit {
  run_wiring_liveness_gate_body()
}
