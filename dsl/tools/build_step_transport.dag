module tools.build_step_transport

import extdeps.shell
import extdeps.languages.bash.program {
  ShellProgram,
  If, Subshell, AndOr, AndThen, Exit, Heredoc,
  Concat, CmdSubst,
  assign, command, lit, var_ref, serialize_bash
}
import tools.build_step { BuildArtifact, VarPath, emit_verifications }

fn probe_var_artifact() -> BuildArtifact {
  BuildArtifact {
    path: VarPath { var_name: "PROBE_BIN" },
    name: "probe_bin"
  }
}

fn corruption_probe_zero_byte_harness() -> String {
  serialize_bash(p: ShellProgram {
    set_e: false,
    statements: [
      assign(name: "TMPDIR", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
      assign(name: "PROBE_BIN", value: Concat { parts: [var_ref(name: "TMPDIR"), lit(text: "/probe_bin")] }),
      AndOr {
        left: command(words: [lit(text: "touch"), var_ref(name: "PROBE_BIN")]),
        op: AndThen,
        right: command(words: [lit(text: "chmod"), lit(text: "+x"), var_ref(name: "PROBE_BIN")])
      },
      If {
        cond: Subshell { body: emit_verifications(produces: [probe_var_artifact()]) },
        then: [Exit { code: 1 }]
      }
    ]
  })
}

fn corruption_probe_nonempty_harness() -> String {
  serialize_bash(p: ShellProgram {
    set_e: true,
    statements: concat(
      [
        assign(name: "TMPDIR", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
        assign(name: "PROBE_BIN", value: Concat { parts: [var_ref(name: "TMPDIR"), lit(text: "/probe_bin")] }),
        Heredoc { path: var_ref(name: "PROBE_BIN"), delimiter: "PROBE_CONTENT", body: "x" },
        command(words: [lit(text: "chmod"), lit(text: "+x"), var_ref(name: "PROBE_BIN")])
      ],
      emit_verifications(produces: [probe_var_artifact()])
    )
  })
}

fn witness_zero_byte_artifact_rejected_by_execution() -> Bool {
  let result = shell.Exec.Run(script: corruption_probe_zero_byte_harness())
  result.success
}

fn witness_nonempty_executable_accepted_by_execution() -> Bool {
  let result = shell.Exec.Run(script: corruption_probe_nonempty_harness())
  result.success
}
