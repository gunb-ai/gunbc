// tools/testgen.dag -- Test generation for all compilable DSL modules.
//
// Rust now provides only narrow extern bridges:
// - discover which DSL modules are compilable
// - render one generated test file for one module
//
// The orchestration, fan-out, and file writes live here in DSL.

module tools.testgen

import std.patterns { content_upsert }
import std.resources { Filesystem }

data output_paths: List<String> = ["**/generated_tests*.rs"]

extern func discover_testgen_modules() -> List<String>
extern func render_testgen_module(dsl_path: String) -> { content: String, path: String }

func testgen() -> { success: Bool, target_count: Int, all_fresh: Bool }
  uses fs: Filesystem(mode: ReadWrite)
{
  modules = discover_testgen_modules()

  results = for dsl_path in modules {
    rendered = render_testgen_module(dsl_path: dsl_path)
    content_upsert(content: rendered.content, path: rendered.path)
  }

  return {
    success: true,
    target_count: modules |> count(),
    all_fresh: results |> all(result => result.written == false)
  }
}
