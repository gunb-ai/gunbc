// tools/stage0_lockstep_transport.dag — shell transport for the stage0 regen-lockstep gate.
//
// The §6 enforcement the CI floor was MISSING: the committed v1 stage0 seed
// (`src/v1/stage0/src/*.rs`) must be a clean function of the `.dag` authorities.
// `regen_stage0 --verify` is the lockstep oracle — it self-compiles the `.dag`
// tree, then byte-compares every GENERATED_STAGE0_FILES entry, the split-crate
// boundary files, and the workspace-members region against the committed seed,
// failing (exit 1) on any drift.
//
//   GREEN: `regen_stage0 --verify` over the live tree exits 0.
//   RED receipt: clobber one committed generated seed file, run `--verify`
//     (MUST fail), restore via `git checkout`. The +/- teeth: a drifted seed
//     is caught. (Proven by execution at authoring time; this encodes it for CI.)
//
// Both transports are structured `ShellProgram`s rendered by `serialize_bash`
// (extdeps.languages.bash.program), mirroring tools.dsl_compile_clean_transport.
// The RED receipt overwrites a tracked file then restores it with `git checkout`
// (verify must read the on-disk committed seed, so — unlike the compile-clean
// perturb — it cannot stay in a TMP dir); the CI checkout is ephemeral.

module tools.stage0_lockstep_transport

import extdeps.shell
import extdeps.languages.bash.program {
  ShellProgram, ShellStmt, ShellWord,
  Command, Assign, If, Subshell, AndOr, WithRedir, Heredoc, Exit,
  Lit, VarRef, Concat, CmdSubst,
  AndThen, OrElse, StderrToNull, StdoutAndStderrToNull,
  lit, var_ref, command, assign, serialize_bash
}

// ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
// REGEN="$ROOT"/target/release/regen_stage0
// if [ ! -x "$REGEN" ]; then (cd "$ROOT" && cargo build -p v1-compiler --release --bin regen_stage0) || exit 1; fi
fn ensure_regen_stage0_built() -> List<ShellStmt> {
  let root = var_ref(name: "ROOT")
  let regen = var_ref(name: "REGEN")
  [
    assign(name: "ROOT", value: CmdSubst { body: AndOr {
      left: WithRedir {
        stmt: command(words: [lit(text: "git"), lit(text: "rev-parse"), lit(text: "--show-toplevel")]),
        redir: StderrToNull
      },
      op: OrElse,
      right: command(words: [lit(text: "pwd")])
    } }),
    assign(name: "REGEN", value: Concat { parts: [root, lit(text: "/target/release/regen_stage0")] }),
    If {
      cond: command(words: [lit(text: "["), lit(text: "!"), lit(text: "-x"), regen, lit(text: "]")]),
      then: [
        AndOr {
          left: Subshell { body: [
            AndOr {
              left: command(words: [lit(text: "cd"), root]),
              op: AndThen,
              right: command(words: [
                lit(text: "cargo"), lit(text: "build"), lit(text: "-p"), lit(text: "v1-compiler"),
                lit(text: "--release"), lit(text: "--bin"), lit(text: "regen_stage0")
              ])
            }
          ] },
          op: OrElse,
          right: Exit { code: 1 }
        }
      ]
    }
  ]
}

// GREEN: <prelude>; "$REGEN" --verify
fn stage0_lockstep_verify_program() -> ShellProgram {
  let regen = var_ref(name: "REGEN")
  ShellProgram {
    set_e: true,
    statements: concat(ensure_regen_stage0_built(), [
      command(words: [regen, lit(text: "--verify")])
    ])
  }
}

fn run_stage0_lockstep_verify() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: stage0_lockstep_verify_program()))
  result.success
}

// The committed generated seed file the RED receipt clobbers. Any GENERATED
// entry works; std_node is a small, stable generated module.
data perturb_seed_relpath: String = "src/v1/stage0/src/std_node.rs"

// Drift sentinel written over the seed file — content that a fresh self-compile
// will never reproduce, so `--verify` must report the byte mismatch.
data perturb_seed_drift_body: String = "// __stage0_lockstep_perturb_red__ planted drift sentinel — not a fixpoint of the .dag"

// RED receipt: clobber one committed generated seed file, run `--verify` (MUST
// fail), restore via `git checkout` on both branches. If `--verify` SUCCEEDS on
// the drifted seed the gate is toothless → exit 1.
//   set -e; <prelude>
//   cat > "$ROOT"/<seed> <<'PERTURB' ... PERTURB
//   if "$REGEN" --verify >/dev/null 2>&1; then git -C "$ROOT" checkout -- <seed>; exit 1; fi
//   git -C "$ROOT" checkout -- <seed>; exit 0
fn stage0_lockstep_perturb_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  let regen = var_ref(name: "REGEN")
  let seed_abs = Concat { parts: [root, lit(text: "/"), lit(text: perturb_seed_relpath)] }
  let restore = command(words: [
    lit(text: "git"), lit(text: "-C"), root, lit(text: "checkout"),
    lit(text: "--"), lit(text: perturb_seed_relpath)
  ])
  ShellProgram {
    set_e: true,
    statements: concat(ensure_regen_stage0_built(), [
      Heredoc {
        path: seed_abs,
        delimiter: "PERTURB",
        body: perturb_seed_drift_body
      },
      If {
        cond: WithRedir {
          stmt: command(words: [regen, lit(text: "--verify")]),
          redir: StdoutAndStderrToNull
        },
        then: [
          restore,
          Exit { code: 1 }
        ]
      },
      restore,
      Exit { code: 0 }
    ])
  }
}

fn run_stage0_lockstep_perturb_red_receipt() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: stage0_lockstep_perturb_program()))
  result.success
}
