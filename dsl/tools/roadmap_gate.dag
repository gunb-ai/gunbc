module tools.roadmap_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.roadmap_authority { expected_roadmap_md, roadmap_drifted }

data roadmap_md_path: String = "ROADMAP.md"

func run_roadmap_gate_body() -> ProcessExit {
  let committed = Filesystem.Read(path: roadmap_md_path)
  let drift_ok = committed.success && !roadmap_drifted(committed: committed.content)
  return if drift_ok {
    ExitSuccess
  } else {
    exit_failure(
      reason: "ROADMAP.md drift: it is a GENERATED projection of gunbc.roadmap_authority (the ci_yaml_gate clone over markdown). Do not hand-edit; edit the .dag authority then regenerate via main_wet on dsl/tools/roadmap_gate.dag. BOUNDARY: green means ROADMAP.md matches the authority against the committed authored_merged_prs snapshot; it does NOT mean checkboxes are current vs live GitHub PR state (that residue is the separate non-hermetic status bridge #5491, out of the floor)."
    )
  }
}

func main() -> ProcessExit {
  run_roadmap_gate_body()
}

func main_wet() -> ProcessExit {
  let expected = expected_roadmap_md()
  let w = Filesystem.Write(path: roadmap_md_path, content: expected)
  return if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("ROADMAP.md write failed: ", w.error))
  }
}

fn exit_ok(e: ProcessExit) -> Bool {
  match e { ExitSuccess => true  _ => false }
}

func run_roadmap_gate() -> ProcessExit {
  let gate = run_roadmap_gate_body()
  let red = drift_red_receipt()
  return if exit_ok(e: gate) && exit_ok(e: red) {
    ExitSuccess
  } else if !exit_ok(e: gate) {
    gate
  } else {
    red
  }
}

func drift_red_receipt() -> ProcessExit {
  let committed = Filesystem.Read(path: roadmap_md_path)
  let clean_ok = committed.success && !roadmap_drifted(committed: committed.content)
  let perturb_drifts = roadmap_drifted(committed: concat(expected_roadmap_md(), "\n- [x] **drift-receipt-perturb**"))
  return if clean_ok && perturb_drifts {
    ExitSuccess
  } else {
    exit_failure(reason: "ROADMAP.md drift red receipt failed: clean must match; perturb must drift")
  }
}
