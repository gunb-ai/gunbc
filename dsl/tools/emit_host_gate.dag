// tools/emit_host_gate.dag — emit-host transport gate, run by `gunbc` (NOT a Rust binary).
//
// Replaces `tools/emit_host_runner`: the four MVP host rows (rust/python/go/typescript) are
// shell transports orchestrated here; the decision is pure Bool conjunction. This is the §7
// shape: gate logic is `.dag` authority, the only Rust left is the `gunbc` interpreter seed.
//
// Run in CI:
//   cargo run -p v1-compiler --release --bin gunbc -- run \
//     --source-root dsl --entry dsl/tools/emit_host_gate.dag --function main
//   (host maps ProcessExit: ExitSuccess → 0, ExitFailure { code } → code.)
//
// SCAFFOLD — dissolves when `v2.compiler.emit_host` host rows wire through gunbc Realization
// and generated TestClaimRun fixtures replace these hand-authored sources (T-PB-B / T-22).
// `emit_host.dag` `run_emit_host_*` bodies stay fail-closed in src/v2 (no host effects there).

module tools.emit_host_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.emit_host_transport {
  run_rust_mvp2_smoke,
  run_python_mvp2_smoke,
  run_go_mvp2_smoke,
  run_ts_mvp1_smoke
}

// Run all four MVP rows (no short-circuit — surface every target failure in one CI pass).
func run_gate() -> ProcessExit {
  rust = run_rust_mvp2_smoke()
  python = run_python_mvp2_smoke()
  go = run_go_mvp2_smoke()
  ts = run_ts_mvp1_smoke()
  return if rust && python && go && ts {
    ExitSuccess
  } else {
    exit_failure(
      reason: "emit host gate failed: one or more of rust/python/go/typescript MVP smoke rows"
    )
  }
}

func main() -> ProcessExit {
  run_gate()
}
