// tools/review.dag -- Code review tool specification.
//
// Replaces: lib/review/src/graph_mock.rs
// Two review modes: inline (direct content) and diff (git diff).
// Both share a cloud credential fixture for GCP WIF credential resolution.
//
// NOTE: Complex Rust types (SecretString, CloudSecretConfig, FilesystemHandle,
// mock_openai_response, Criteria) still use Rust helpers via @rust_mock_helpers.

module tools.review

// ── Tests ──────────────────────────────────────────────────────────

// Shared cloud environment for GCP WIF credential resolution.
fixture review_cloud_env {
    mock cloud_env.config -> { provider: "gcp", runtime: "local-dev", audience: "local-dev", project_or_account: "mock-secrets" }
    mock cloud_env.request_url -> "https://example.com/oidc"
    mock cloud_env.request_token -> "mock-oidc-token"
    mock cloud_credential/gcp_wif_secret/build_credential.credential -> { token: "<MOCK_API_KEY>", source_type: "static", scheme: "bearer" }
    mock cloud_credential/gcp_wif_secret/local_auth_upsert/merge_auth_result.expires_in -> 3600
    mock cloud_credential/gcp_wif_secret/parse_set_iam.ok -> true
    mock bind_secret.config -> { provider: "gcp", runtime: "local-dev", audience: "local-dev", project_or_account: "mock-secrets" }
}

test inline_review : review_cloud_env {

    // Inputs: inline content to review
    input prepare_prompt.artifact -> "fn main() { let x: Option<i32> = None; x.unwrap(); }"
    input prepare_prompt.criteria -> { name: "code-review", description: "General code review" }
    input parse_response.criteria -> { name: "code-review", description: "General code review" }
    input llm/prepare_llm.content -> "fn main() { let x: Option<i32> = None; x.unwrap(); }"
    input llm/prepare_llm.provider -> "openai"
    input llm/prepare_llm.model -> "gpt-4o"
    input resolve_auth.provider -> "openai"

    // Transport mock: LLM response with review findings
    mock llm/execute_llm.response -> rest_response(200, {
        choices: [{ message: { content: "{\"findings\":[{\"check_id\":\"correctness\",\"issue_key\":\"unwrap_without_context\",\"observation\":\"Using unwrap() without context\",\"candidate_fix\":\"Use .expect() or ? operator\"}],\"summary\":\"Found 1 issue\"}" }, finish_reason: "stop" }],
        model: "gpt-4o",
        usage: { prompt_tokens: 50, completion_tokens: 100 }
    })

    expect result.content is String
    expect result.content contains "issue"
}

test diff_review : review_cloud_env {

    // Inputs: repo path for git diff
    input diff/prepare_diff.repo_path -> "."

    // Transport mock: git diff output (shell command)
    mock diff/execute_diff.response -> shell_response(0, "diff --git a/src/main.rs b/src/main.rs\n--- a/src/main.rs\n+++ b/src/main.rs\n@@ -1,3 +1,5 @@\n fn main() {\n+    let x: Option<i32> = None;\n+    x.unwrap();\n }")

    // Transport mock: LLM response with diff review findings
    mock llm/execute_llm.response -> rest_response(200, {
        choices: [{ message: { content: "{\"findings\":[{\"check_id\":\"correctness\",\"issue_key\":\"unwrap_on_none\",\"observation\":\"unwrap() on a None value will panic\",\"candidate_fix\":\"Handle the None case explicitly\"}],\"summary\":\"Found 1 correctness issue in the diff.\"}" }, finish_reason: "stop" }],
        model: "gpt-4o",
        usage: { prompt_tokens: 80, completion_tokens: 120 }
    })

    expect result.content is String
    expect result.content contains "correctness"
}
