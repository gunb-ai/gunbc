// tools/review.dag -- Code review tool specification.
//
// Replaces: lib/review/src/graph.rs
// Replaces: lib/review/src/graph_mock.rs

module tools.review

import services.git
import std.types { GitRef }

fn render_review(repo_path: String, base_ref: GitRef, diff: String) -> String {
  "# Review Summary\n\nrepo: {repo_path}\nbase: {base_ref}\n\n```diff\n{diff}\n```"
}

func review_diff(repo_path: String = ".", base_ref: GitRef = "main") -> { content: String } {
  diff = git.Core.Diff(base: base_ref)
  content = render_review(repo_path: repo_path, base_ref: base_ref, diff: diff.diff)
  return { content: content }
}

// ── Tests ──────────────────────────────────────────────────────────

test review_diff_smoke {
    @tier(Unit)
    @hermetic(true)
    @auto_mock(true)

    expect result.content is String
}
