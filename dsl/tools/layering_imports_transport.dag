// Shared scanner-perturb receipt: plant a bad module, scan, assert the scanner DETECTS it AND
// clean_tree goes RED; then remove the plant, re-scan, assert clean_tree GREEN again.
//   set -e; <ensure_gunbc_built>; TMP=$(mktemp -d); MANIFEST="$TMP"/...; MANIFEST_DIR="$TMP"
//   mkdir -p "$TMP"/<plant_dir>; cat > "$TMP"/<plant_file> <<'PLANT' <plant_src> PLANT
//   <perturb_scan>; <scanner detect run>
//   if <clean_tree run> 2>/dev/null; then echo 'clean_tree should be red' >&2; rm -rf "$TMP"; exit 1; fi
//   rm -f "$TMP"/<plant_file>; <perturb_scan>; <clean_tree run>; rm -rf "$TMP"
fn perturb_program(
  plant_dir: String,
  plant_file: String,
  plant_source: String,
  scanner_entry: String,
  scanner_function: String
) -> ShellProgram {
  let tmp = var_ref(name: "TMP")
  let plant_path = Concat { parts: [tmp, lit(text: plant_file)] }
  ShellProgram {
    set_e: true,
    statements: concat(ensure_gunbc_built(), [
      assign(name: "TMP", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
      assign(name: "MANIFEST", value: Concat { parts: [tmp, lit(text: "/v2-layering-imports-manifest.dag")] }),
      assign(name: "MANIFEST_DIR", value: tmp),
      command(words: [lit(text: "mkdir"), lit(text: "-p"), Concat { parts: [tmp, lit(text: plant_dir)] }]),
      Heredoc { path: plant_path, delimiter: "PLANT", body: plant_source },
      perturb_scan(),
      gunbc_claim_run(entry: scanner_entry, function: scanner_function),
      If {
        cond: WithRedir {
          stmt: gunbc_claim_run(entry: clean_tree_entry, function: clean_tree_function),
          redir: StderrToNull
        },
        then: [
          WithRedir {
            stmt: command(words: [lit(text: "echo"), lit(text: "clean_tree should be red")]),
            redir: StdoutToStderr
          },
          command(words: [lit(text: "rm"), lit(text: "-rf"), tmp]),
          Exit { code: 1 }
        ]
      },
      command(words: [lit(text: "rm"), lit(text: "-f"), plant_path]),
      perturb_scan(),
      gunbc_claim_run(entry: clean_tree_entry, function: clean_tree_function),
      command(words: [lit(text: "rm"), lit(text: "-rf"), tmp])
    ])
  }
}

