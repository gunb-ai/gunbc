// tools/layering_imports_transport.dag — shell transports for layering-imports gate.
//
// Replaces the deleted `tools/layering_imports_scan` Rust host (#5048): calls
// scripts/layering-imports-scan.sh for enumeration, then runs gunbc Bool witnesses
// with manifest overlay.

module tools.layering_imports_transport

import extdeps.shell
import gunbc.ci_layer_roots { witness_layer_roots, witness_layer_source_flags }
import std.logic { Bool }

fn gunbc_run_with_manifest_overlay() -> String {
  concat(
    concat("\"$GUNBC\" run", witness_layer_source_flags(roots: witness_layer_roots)),
    " --source-root \"$MANIFEST_DIR\""
  )
}

// Green pass: scan live repo, assert clean_tree witness holds.
fn run_clean_tree_gate() -> Bool {
  let script = concat(
    concat(
      concat(
        "set -e\nROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"\ncd \"$ROOT\"\nMANIFEST=\"$ROOT/target/v2-layering-imports-manifest.dag\"\nMANIFEST_DIR=\"$(dirname \"$MANIFEST\")\"\nbash scripts/layering-imports-scan.sh \"$ROOT\" \"$MANIFEST\"\nGUNBC=\"$ROOT/target/release/gunbc\"\nif [ ! -x \"$GUNBC\" ]; then cargo build -p v1-compiler --release --bin gunbc || exit 1; fi\n",
        gunbc_run_with_manifest_overlay()
      ),
      " --entry src/v2/test/claim/layering_imports/clean_tree_test.dag --function clean_tree_no_wrong_direction_imports_holds --claim-run"
    ),
    ""
  )
  let result = shell.Exec.Run(script: script)
  result.success
}

fn run_perturb_std_v4_prefix() -> Bool {
  let run = gunbc_run_with_manifest_overlay()
  let script = concat(
    concat(
      concat(
        concat(
          "set -e\nROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"\nGUNBC=\"$ROOT/target/release/gunbc\"\nif [ ! -x \"$GUNBC\" ]; then (cd \"$ROOT\" && cargo build -p v1-compiler --release --bin gunbc) || exit 1; fi\nTMP=$(mktemp -d)\nMANIFEST=\"$TMP/v2-layering-imports-manifest.dag\"\nMANIFEST_DIR=\"$TMP\"\nmkdir -p \"$TMP/src/v2/std\"\ncat >\"$TMP/src/v2/std/_perturb_scanner_std_v4_prefix.dag\" <<'PLANT'\nmodule v2.std._perturb_scanner_std_v4_prefix\nimport v2.compiler.tokenize\ndata perturb: Bool = true\nPLANT\nbash \"$ROOT/scripts/layering-imports-scan.sh\" \"$TMP\" \"$MANIFEST\"\n",
          concat(run, " --entry src/v2/test/claim/layering_imports/scanner/std_v4_prefix.dag --function scanner_std_v4_prefix_detects_holds --claim-run\n")
        ),
        concat("if ", run, " --entry src/v2/test/claim/layering_imports/clean_tree_test.dag --function clean_tree_no_wrong_direction_imports_holds --claim-run 2>/dev/null; then echo 'clean_tree should be red' >&2; rm -rf \"$TMP\"; exit 1; fi\n")
      ),
      concat(
        concat(
          "rm -f \"$TMP/src/v2/std/_perturb_scanner_std_v4_prefix.dag\"\nbash \"$ROOT/scripts/layering-imports-scan.sh\" \"$TMP\" \"$MANIFEST\"\n",
          concat(run, " --entry src/v2/test/claim/layering_imports/clean_tree_test.dag --function clean_tree_no_wrong_direction_imports_holds --claim-run\nrm -rf \"$TMP\"")
        ),
        ""
      )
    ),
    ""
  )
  let result = shell.Exec.Run(script: script)
  result.success
}

