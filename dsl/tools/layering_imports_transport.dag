// All four scanner-execution perturb receipts (coverage_domain_equivalence roster).
fn run_scanner_perturb_receipts() -> Bool {
  run_perturb_std_v4_prefix()
    && run_perturb_extdeps_v4_prefix()
    && run_perturb_dsl_extdeps_v4_exact()
    && run_perturb_parse_level_pre_resolve()
}
