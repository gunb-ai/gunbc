// tools/layering_imports_transport.dag — shell transports for layering-imports gate.
//
// Replaces the deleted `tools/layering_imports_scan` Rust host (#5048): calls
// scripts/layering-imports-scan.sh for enumeration, then runs gunbc Bool witnesses
// with manifest overlay.
//
// Migrated off hand-written `let script = "..."` blobs onto structured `ShellProgram`s
// (extdeps.languages.bash.program). The 4 scanner-perturb receipts share one
// `perturb_program(...)` builder parameterized by plant dir/file/source + scanner entry/fn
// (§2 DRY — was 4 copy-pasted 15-line blobs). The build prelude is the shared
// `host_prelude.ensure_gunbc_built()`.

module tools.layering_imports_transport

import extdeps.shell
import gunbc.ci_layer_roots { witness_layer_roots, witness_layer_source_flags }
import std.logic { Bool }
import extdeps.languages.bash.program {
  ShellProgram, ShellStmt, ShellWord,
  Command, Assign, If, Subshell, AndOr, WithRedir, Heredoc, Exit,
  Lit, VarRef, Concat, CmdSubst,
  AndThen, OrElse, StderrToNull, StdoutToStderr,
  lit, var_ref, command, assign, test_not_executable, serialize_bash
}
import tools.host_prelude { ensure_gunbc_built }

data clean_tree_entry: String = "src/v2/test/claim/layering_imports/clean_tree.dag"
data clean_tree_function: String = "clean_tree_no_wrong_direction_imports_holds"

// "$GUNBC" run --source-root src/v2 --source-root "$MANIFEST_DIR" --entry <e> --function <f> --claim-run
fn gunbc_claim_run(entry: String, function: String) -> ShellStmt {
  command(words: [
    var_ref(name: "GUNBC"), lit(text: "run"),
    lit(text: "--source-root"), lit(text: "src/v2"),
    lit(text: "--source-root"), var_ref(name: "MANIFEST_DIR"),
    lit(text: "--entry"), lit(text: entry),
    lit(text: "--function"), lit(text: function),
    lit(text: "--claim-run")
  ])
}

// bash "$ROOT"/scripts/layering-imports-scan.sh "$TMP" "$MANIFEST"
fn perturb_scan() -> ShellStmt {
  command(words: [
    lit(text: "bash"),
    Concat { parts: [var_ref(name: "ROOT"), lit(text: "/scripts/layering-imports-scan.sh")] },
    var_ref(name: "TMP"),
    var_ref(name: "MANIFEST")
  ])
}

fn gunbc_run_with_manifest_overlay() -> String {
  concat(
    concat("\"$GUNBC\" run", witness_layer_source_flags(roots: witness_layer_roots)),
    " --source-root \"$MANIFEST_DIR\""
  )
}

// Green pass: scan live repo, assert clean_tree witness holds.
//   set -e; ROOT=$(...); cd "$ROOT"; MANIFEST="$ROOT"/target/...; MANIFEST_DIR=$(dirname "$MANIFEST")
//   bash scripts/layering-imports-scan.sh "$ROOT" "$MANIFEST"
//   GUNBC="$ROOT"/target/release/gunbc; if [ ! -x "$GUNBC" ]; then cargo build ... || exit 1; fi
//   "$GUNBC" run ... clean_tree ...
fn clean_tree_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  let gunbc = var_ref(name: "GUNBC")
  let manifest = var_ref(name: "MANIFEST")
  ShellProgram {
    set_e: true,
    statements: [
      assign(name: "ROOT", value: CmdSubst { body: AndOr {
        left: WithRedir {
          stmt: command(words: [lit(text: "git"), lit(text: "rev-parse"), lit(text: "--show-toplevel")]),
          redir: StderrToNull
        },
        op: OrElse,
        right: command(words: [lit(text: "pwd")])
      } }),
      command(words: [lit(text: "cd"), root]),
      assign(name: "MANIFEST", value: Concat { parts: [root, lit(text: "/target/v2-layering-imports-manifest.dag")] }),
      assign(name: "MANIFEST_DIR", value: CmdSubst { body: command(words: [lit(text: "dirname"), manifest]) }),
      command(words: [lit(text: "bash"), lit(text: "scripts/layering-imports-scan.sh"), root, manifest]),
      assign(name: "GUNBC", value: Concat { parts: [root, lit(text: "/target/release/gunbc")] }),
      If {
        cond: test_not_executable(path: gunbc),
        then: [
          AndOr {
            left: command(words: [
              lit(text: "cargo"), lit(text: "build"), lit(text: "-p"), lit(text: "v1-compiler"),
              lit(text: "--release"), lit(text: "--bin"), lit(text: "gunbc")
            ]),
            op: OrElse,
            right: Exit { code: 1 }
          }
        ]
      },
      gunbc_claim_run(entry: clean_tree_entry, function: clean_tree_function)
    ]
  }
}

