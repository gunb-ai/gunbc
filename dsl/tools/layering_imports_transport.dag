fn run_perturb_parse_level_pre_resolve() -> Bool {
  let run = gunbc_run_with_manifest_overlay()
  let script = concat(
    concat(
      concat(
        concat(
          "set -e\nROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"\nGUNBC=\"$ROOT/target/release/gunbc\"\nif [ ! -x \"$GUNBC\" ]; then (cd \"$ROOT\" && cargo build -p v1-compiler --release --bin gunbc) || exit 1; fi\nTMP=$(mktemp -d)\nMANIFEST=\"$TMP/v2-layering-imports-manifest.dag\"\nMANIFEST_DIR=\"$TMP\"\nmkdir -p \"$TMP/src/v2/std\"\ncat >\"$TMP/src/v2/std/_perturb_scanner_parse_level_pre_resolve.dag\" <<'PLANT'\nmodule v2.std._perturb_scanner_parse_level_pre_resolve\nimport v2.compiler.tokenize\nimport totally.broken.unresolved.module\ndata x: String = \"unresolved\"\nPLANT\nbash \"$ROOT/scripts/layering-imports-scan.sh\" \"$TMP\" \"$MANIFEST\"\n",
          concat(run, " --entry src/v2/test/claim/layering_imports/scanner/parse_level_pre_resolve.dag --function scanner_parse_level_pre_resolve_detects_holds --claim-run\n")
        ),
        concat("if ", run, " --entry src/v2/test/claim/layering_imports/clean_tree_test.dag --function clean_tree_no_wrong_direction_imports_holds --claim-run 2>/dev/null; then echo 'clean_tree should be red' >&2; rm -rf \"$TMP\"; exit 1; fi\n")
      ),
      concat(
        concat(
          "rm -f \"$TMP/src/v2/std/_perturb_scanner_parse_level_pre_resolve.dag\"\nbash \"$ROOT/scripts/layering-imports-scan.sh\" \"$TMP\" \"$MANIFEST\"\n",
          concat(run, " --entry src/v2/test/claim/layering_imports/clean_tree_test.dag --function clean_tree_no_wrong_direction_imports_holds --claim-run\nrm -rf \"$TMP\"")
        ),
        ""
      )
    ),
    ""
  )
  let result = shell.Exec.Run(script: script)
  result.success
}

// All four scanner-execution perturb receipts (coverage_domain_equivalence roster).
fn run_scanner_perturb_receipts() -> Bool {
  run_perturb_std_v4_prefix()
    && run_perturb_extdeps_v4_prefix()
    && run_perturb_dsl_extdeps_v4_exact()
    && run_perturb_parse_level_pre_resolve()
}
