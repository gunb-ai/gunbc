// tools/bootstrap.dag -- Workspace bootstrap (Makefile + .gitignore generation).
//
// Scans the workspace for crates, then generates Makefile and .gitignore
// using content_upsert for each. Two parallel upsert chains share the
// same crate discovery step.
//
// Replaces: gunbc-dag/src/bootstrap/graph.rs (~16 nodes)

module tools.bootstrap

import std.patterns { content_upsert }
import std.resources { Filesystem }
import services.shell { shell.Find }

fn render_makefile(crate_names: List<String>) -> String {
  let header = "# Generated by gunbc bootstrap\n.PHONY: all\n\n"
  let targets = crate_names
    |> map(name => "{name}:\n\tcargo build -p {name}")
    |> join("\n\n")
  "{header}all: {crate_names |> join(\" \")}\n\n{targets}\n"
}

fn render_gitignore(crate_names: List<String>) -> String {
  let header = "# Generated by gunbc bootstrap\n/target/\n"
  let entries = crate_names
    |> map(name => "/{name}/target/")
    |> join("\n")
  "{header}{entries}\n"
}

journey bootstrap {
  input { check_mode: Bool? }
  output {
    crate_count: Int
    makefile_written: Bool
    gitignore_written: Bool
  }
  uses fs: Filesystem(mode: ReadWrite)

  // Discover crates in workspace
  scan = shell.Find.ListDirs(path: "crates")

  // Generate and upsert both files (parallel after scan)
  makefile_content = render_makefile(crate_names: scan.dirs)
  makefile = content_upsert(content: makefile_content, path: "Makefile")

  gitignore_content = render_gitignore(crate_names: scan.dirs)
  gitignore = content_upsert(content: gitignore_content, path: ".gitignore")

  return {
    crate_count: scan.dirs |> count(),
    makefile_written: makefile.written,
    gitignore_written: gitignore.written
  }
}
