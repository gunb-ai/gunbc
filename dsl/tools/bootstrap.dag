module tools.bootstrap

import std.patterns { content_upsert }
import std.resources { Filesystem }
import config.gitignore { categories }
import extdeps.gitignore {
  GitignoreCategory,
  GitignoreFile,
  filter_categories
}
import extdeps.gitignore_render { render_gitignore_file }

func bootstrap(check_mode: Bool?, gitignore_categories: List<GitignoreCategory>) -> { success: Bool, crate_count: Int, gitignore_written: Bool }
  uses fs: Filesystem(mode: ReadWrite)
{
  static_gitignore_categories = filter_categories(categories: categories, build_system: "cargo")
  gitignore_file = {
    rule_comment: "Rule: Ignore anything that is (a) reproducible from committed source-of-truth files, or (b) environment-specific and not shared across developers.",
    categories: append(static_gitignore_categories, items: gitignore_categories)
  }
  gitignore_content = render_gitignore_file(
    file: gitignore_file,
    generator: "gunbc-bootstrap",
    regen_command: "cargo run -p gunbc-app --bin gunbc-bootstrap"
  )
  gitignore = content_upsert(content: gitignore_content, path: ".gitignore")

  return {
    success: true,
    crate_count: 0,
    gitignore_written: gitignore.written
  }
}
