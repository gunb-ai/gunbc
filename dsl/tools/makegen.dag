// tools/makegen.dag -- Makefile generation from tool registry.
//
// The simplest tool: load registry, render content, content_upsert.
// 5 lines of DSL replace 220 lines of Rust (gunbc-dag/src/makegen/graph.rs).
//
// Resulting IR: 10 nodes, 12 edges (identical to hand-wired version).
//   fs_env, load_registry,
//   MapNode(format_target), JoinNode(targets),     <- collection ops from fn body
//   ScalarNode(interpolate_header),
//   prepare_read, execute_read, compare, prepare_write, execute_write
//
// The |> map(...) |> join(...) in render_makefile are NOT compiled as
// a single opaque fn call. They lower to IR collection nodes (MapNode,
// JoinNode) so the scheduler can parallelize the map if the list is large.

module tools.makegen

import std.patterns { content_upsert }
import std.types { ToolRegistry }
import shared.dag_util { doc_with_header, generated_header, render_document, section, text_line }

// ── Extern declarations ──────────────────────────────────────────────
// Implementations in gunbc-dag/src/extern_impls.rs.

extern func load_registry() -> { tool_count: Int, tool_names: List<String>, registry: Json }
extern asset makefile: String

// ── Render helpers ──────────────────────────────────────────────────

fn render_makefile(registry: ToolRegistry) -> String {
  let targets = registry.tools
    |> map(t => text_line(text: "{t.name}:\n\t{t.command}"))
  let document = doc_with_header(
    header: generated_header(tool: "makegen") + ".PHONY: all",
    comment_prefix: "#",
    sections: [section(lines: targets)]
  )
  render_document(document: document)
}

@outputs("Makefile")
func makegen(registry: ToolRegistry, path: String = "Makefile") -> { written: Bool } {
  content = render_makefile(registry: registry)
  result = content_upsert(content: content, path: path)
  return { written: result.written }
}

// ── Tests ──────────────────────────────────────────────────────────

test makegen_dryrun {}
