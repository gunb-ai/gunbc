// tools/makegen.dag -- Makefile generation.
//
// Renders the project Makefile via Rust's MakefileRenderer + ToolRegistry.
// The extern impl (RenderMakefileContentOp) calls render_makefile() with
// ToolRegistry::default_registry(). DSL rendering helpers are preserved
// below as aspirational code for Phase 2 (pure-DSL rendering).

module tools.makegen

import std.patterns { content_upsert }

// ── Type declarations ─────────────────────────────────────────────────
// Mirror Rust's registry types for documentation and future DSL rendering.

type EntrypointParam {
  port_name: String
  make_var: String
  cli_flag: String
  type_hint: String
  default: String?
  repeatable: Bool
}

type MakeTarget {
  name: String
  description: String
  deps: List<String>
  commands: List<String>
  comment: String?
}

type ToolTarget {
  name: String
  description: String
  make_target: String?
  entrypoints: List<EntrypointParam>
}

type MakegenRegistry {
  core_targets: List<MakeTarget>
  meta_targets: List<MakeTarget>
  tool_targets: List<ToolTarget>
}

// ── Rendering ─────────────────────────────────────────────────────────
// Shadow fn — overridden by RenderMakefileContentOp at resolve time.
// Rust impl: ToolRegistry::default_registry() → render_makefile().

fn render_makefile_content(path: String) -> String {
  ""
}

// ── Entry point ───────────────────────────────────────────────────────

@outputs("Makefile")
func makegen(path: String = "Makefile") -> { written: Bool } {
  content = render_makefile_content(path: path)
  result = content_upsert(content: content, path: path)
  return { written: result.written }
}

// ── Tests ─────────────────────────────────────────────────────────────

test makegen_dryrun {}
