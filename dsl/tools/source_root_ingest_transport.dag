// tools/source_root_ingest_transport.dag — shell transport for Lane 3a real ingest gate.
//
// SCAFFOLD (§3 transport-fusion): inline shell is the host-effect transport realization.
// dissolve-on: modeled ProcessExit/Realization host effects with PARAMETERIZED argv —
//   de-fuse transport from the leaked business-policy literals (--source-root, --scan-dir,
//   --entry path, --function names) so the gate is a Node tree, not a bash string.
//
// Transport authority: scripts/source-root-ingest-gate.sh (host realization).
// This module only binds the script path — no embedded shell templating.

module tools.source_root_ingest_transport

import extdeps.shell
import std.logic { Bool }

fn run_real_ingest_gate() -> Bool {
  let result = shell.Exec.Run(script: "bash scripts/source-root-ingest-gate.sh")
  result.success
}
