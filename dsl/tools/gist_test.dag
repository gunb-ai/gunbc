// gist_test.dag -- Test specifications for the gist tool.
//
// Migrated from lib/tools/gist/src/graph_mock.rs.
// Three test cases corresponding to GistMode variants: Snapshot, Diff, Recent.
//
// NOTE: Complex mock values (SecretString, FilesystemHandle, CloudSecretConfig)
// still use Rust helper functions via @rust_mock_helpers. The test structure
// and fixture data ownership lives here; typed Rust helpers provide the values
// that the DSL cannot express yet.

module tools.gist_test

// Shared cloud environment mocks used by all gist modes.
fixture gist_cloud_env {
    mock cloud_env.config -> { provider: "gcp", runtime: "local-dev", audience: "local-dev", project_or_account: "mock-secrets" }
    mock cloud_env.request_url -> "https://example.com/oidc"
    mock cloud_env.credential -> { token: "<MOCK_GITHUB_TOKEN>", source_type: "static", scheme: "bearer" }
}

test gist_snapshot_dryrun : gist_cloud_env {
    @tier(Unit)
    @hermetic(true)
    @mode("Snapshot")
    @rust_mock_helpers("gunbc_gist::graph_mock")

    // Shell transport mocks
    mock execute_rev_list.response -> shell_response(0, "abc123\ndef456")
    mock execute_show.response -> shell_response(0, "fn main() {}")
    mock execute_list_files.response -> shell_response(0, "src/main.rs\nREADME.md")

    // Gist upload REST mock
    mock gist_upload/execute.response -> rest_response(200, {
        id: "abc123def456",
        html_url: "https://gist.github.com/mock/abc123def456",
        files: {},
        public: false
    })

    expect result.url contains "gist.github.com"
    expect result.ok == true
}

test gist_diff_dryrun : gist_cloud_env {
    @tier(Unit)
    @hermetic(true)
    @mode("Diff")
    @rust_mock_helpers("gunbc_gist::graph_mock")

    // Shell transport mocks
    mock execute_diff.response -> shell_response(0, "diff --git a/src/main.rs b/src/main.rs")

    // Gist upload REST mock
    mock gist_upload/execute.response -> rest_response(200, {
        id: "abc123def456",
        html_url: "https://gist.github.com/mock/abc123def456",
        files: {},
        public: false
    })

    expect result.url contains "gist.github.com"
    expect result.ok == true
}

test gist_recent_dryrun : gist_cloud_env {
    @tier(Unit)
    @hermetic(true)
    @mode("Recent")
    @rust_mock_helpers("gunbc_gist::graph_mock")

    // Shell transport mocks
    mock execute_rev_list.response -> shell_response(0, "abc123")
    mock execute_diff.response -> shell_response(0, "diff --git a/src/main.rs b/src/main.rs")

    // Gist upload REST mock
    mock gist_upload/execute.response -> rest_response(200, {
        id: "abc123def456",
        html_url: "https://gist.github.com/mock/abc123def456",
        files: {},
        public: false
    })

    expect result.url contains "gist.github.com"
    expect result.ok == true
}
