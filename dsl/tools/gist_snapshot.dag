// tools/gist_snapshot.dag -- Create a GitHub gist from workspace snapshot.
//
// Reads all tracked files through the DAG filesystem transport, then renders
// a tree-character directory tree + fenced code blocks per file.
//
// Content rendering: `build_snapshot_content` is a local fn whose body is a
// placeholder -- the actual rendering is handled by the compiled fn bridge
// (gunbc-dag/src/compiled_fns.rs :: BuildSnapshotContentOp), which produces
// a full markdown document with heading, branch info, directory tree, and
// fenced code blocks for every tracked file.

module tools.gist_snapshot

import services.git
import services.shell
import services.github.gist
import std.resources { Filesystem, Network }
import std.types { Url }

// Compiled fn: produces markdown from branch name + paths + file contents.
// Implementation: gunbc-dag/src/compiled_fns.rs (BuildSnapshotContentOp)
fn build_snapshot_content(branch: String, files: List<String>, file_contents: List<String>) -> String {
  "{branch}"
}

func gist_snapshot(public: Bool = false) -> { url: Url }
  uses fs: Filesystem(mode: Read)
  uses net: Network
{
  branch_info = git.Core.CurrentBranch()
  listing = git.Core.LsFiles()

  file_contents = for path in listing.files {
    fs.read(path: path)
  }

  content = build_snapshot_content(
    branch: branch_info.branch,
    files: listing.files,
    file_contents: file_contents
  )
  secret = shell.GCloud.SecretManagerAccessVersion(
    project_id: "gunbai-secrets",
    secret_name: "github-token"
  )
  result = github.Gist.Create(
    description: branch_info.branch,
    content: content,
    public: public,
    auth_token: secret.secret_value
  )
  return { url: result.url as Url }
}

test gist_snapshot_dryrun {}
