func main() -> ProcessExit {
  let w = Filesystem.Write(path: roadmap_dispatch_output_path, content: roadmap_dispatch_file_content())
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat(concat("write failed for ", roadmap_dispatch_output_path), concat(": ", w.error)))
  }
}
