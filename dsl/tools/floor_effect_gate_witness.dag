module tools.floor_effect_gate_witness

import gunbc.ci_spec {
  RustMonolithGate, EmitHostGate, LayeringImportsGate,
  ExtdepsExternalAuthorityGate, DslCompileCleanGate, GeneratedArtifactDriftGate,
  WiringLivenessWholeTreeGate
}
import tools.ci_gates { exit_ok, run_spec_gate }

func rust_monolith_gate_passes() -> Bool {
  exit_ok(e: run_spec_gate(g: RustMonolithGate))
}

func emit_host_gate_passes() -> Bool {
  exit_ok(e: run_spec_gate(g: EmitHostGate))
}

func layering_imports_gate_passes() -> Bool {
  exit_ok(e: run_spec_gate(g: LayeringImportsGate))
}

func extdeps_external_authority_gate_passes() -> Bool {
  exit_ok(e: run_spec_gate(g: ExtdepsExternalAuthorityGate))
}

func dsl_compile_clean_gate_passes() -> Bool {
  exit_ok(e: run_spec_gate(g: DslCompileCleanGate))
}

func generated_artifact_drift_gate_passes() -> Bool {
  exit_ok(e: run_spec_gate(g: GeneratedArtifactDriftGate))
}

func wiring_liveness_whole_tree_gate_passes() -> Bool {
  exit_ok(e: run_spec_gate(g: WiringLivenessWholeTreeGate))
}
