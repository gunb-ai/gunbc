fn compile_dsl_shell_primary_precedence_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  let gunbc = var_ref(name: "GUNBC")
  let tmp = var_ref(name: "TMP")
  let out = var_ref(name: "OUT")
  ShellProgram {
    set_e: true,
    statements: concat(ensure_gunbc_built(), [
      command(words: [lit(text: "cd"), root]),
      assign(name: "TMP", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
      Heredoc {
        path: Concat { parts: [tmp, lit(text: "/_perturb_compile_clean_dsl_shell_primary.dag")] },
        delimiter: "DSL_SHELL_PRIMARY",
        body: dsl_shell_primary_module_source
      },
      assign(name: "OUT", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
      command(words: concat(
        [gunbc, lit(text: "compile"), lit(text: "--source-root"), tmp],
        concat(dcc_source_root_flags(), concat(dcc_pool_index_flags(), [
          lit(text: "--output-dir"), out,
