// tools/dsl_compile_clean_transport.dag — shell transport for whole-tree dsl/ compile-clean.
//
// Host runs `gunbc compile --source-root <dsl> --target rust` over the live tree (GREEN) and
// a perturb receipt (RED: planted fresh-name unimported module resolved against the live
// dsl/ index as dependency pool — no cp -r + cold whole-tree rebuild).
//
// Both transports are modeled off hand-written `let script = "..."` blobs onto structured
// `ShellProgram`s rendered by `serialize_bash` (extdeps.languages.bash.program). The shared
// ROOT/GUNBC/ensure-built prelude is a single `ensure_gunbc_built()` (DRY, §2). Proven green by
// execution (each gate runs the real compile).

module tools.dsl_compile_clean_transport

import extdeps.shell
import extdeps.languages.bash.program {
  ShellProgram, ShellStmt, ShellWord,
  Command, Assign, If, Subshell, AndOr, WithRedir, Heredoc, Exit,
  Lit, VarRef, Concat, CmdSubst,
  AndThen, OrElse, StderrToNull, StdoutAndStderrToNull,
  lit, var_ref, command, assign, serialize_bash
}
import tools.host_prelude { ensure_gunbc_built }

// set -e; <prelude>; OUT=$(mktemp -d); "$GUNBC" compile --source-root "$ROOT"/dsl ... ; rm -rf "$OUT"
fn clean_tree_compile_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  let gunbc = var_ref(name: "GUNBC")
  let out = var_ref(name: "OUT")
  ShellProgram {
    set_e: true,
    statements: concat(ensure_gunbc_built(), [
      assign(name: "OUT", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
      command(words: [
        gunbc, lit(text: "compile"),
        lit(text: "--source-root"), Concat { parts: [root, lit(text: "/dsl")] },
        lit(text: "--output-dir"), out,
        lit(text: "--target"), lit(text: "rust")
      ]),
      command(words: [lit(text: "rm"), lit(text: "-rf"), out])
    ])
  }
}

fn run_clean_tree_compile() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: clean_tree_compile_program()))
  result.success
}

// The planted module whose legacy Some/None on a builtin T? must fail typecheck.
data perturb_module_source: String = "module test.perturb_compile_clean_red\nfn probe() -> String? {\n  match Present { value: \"x\" } {\n    Some { value: s } => Some { value: s }\n    None => none\n  }\n}"

// RED receipt: plant the fresh-name unimported bad module; resolve against the live dsl/
// index (second --source-root) as dependency pool — no cp -r + cold whole-tree rebuild.
// Compile MUST fail (if it succeeds → exit 1).
//   set -e; <prelude>; TMP=$(mktemp -d)
//   cat > "$TMP"/_perturb_compile_clean_red.dag <<'PERTURB' ... PERTURB
//   if "$GUNBC" compile --source-root "$TMP" --source-root "$ROOT"/dsl \
//        --output-dir "$TMP"/out --target rust >/dev/null 2>&1
//     then rm -rf "$TMP"; exit 1; fi
//   rm -rf "$TMP"; exit 0
fn perturb_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  let gunbc = var_ref(name: "GUNBC")
  let tmp = var_ref(name: "TMP")
  ShellProgram {
    set_e: true,
    statements: concat(ensure_gunbc_built(), [
      assign(name: "TMP", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
      Heredoc {
        path: Concat { parts: [tmp, lit(text: "/_perturb_compile_clean_red.dag")] },
        delimiter: "PERTURB",
        body: perturb_module_source
      },
      If {
        cond: WithRedir {
          stmt: command(words: [
            gunbc, lit(text: "compile"),
            lit(text: "--source-root"), tmp,
            lit(text: "--source-root"), Concat { parts: [root, lit(text: "/dsl")] },
            lit(text: "--output-dir"), Concat { parts: [tmp, lit(text: "/out")] },
            lit(text: "--target"), lit(text: "rust")
          ]),
          redir: StdoutAndStderrToNull
        },
        then: [
          command(words: [lit(text: "rm"), lit(text: "-rf"), tmp]),
          Exit { code: 1 }
        ]
      },
      command(words: [lit(text: "rm"), lit(text: "-rf"), tmp]),
      Exit { code: 0 }
    ])
  }
}

fn run_perturb_optional_skew_red_receipt() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: perturb_program()))
  result.success
}
