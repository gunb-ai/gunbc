      Heredoc {
        path: Concat { parts: [tmp, lit(text: "/_perturb_compile_clean_unresolved_import.dag")] },
        delimiter: "PERTURB_UNRESOLVED",
        body: unresolved_import_perturb_source
      },
      If {
        cond: WithRedir {
          stmt: command(words: concat(
            [gunbc, lit(text: "compile"), lit(text: "--source-root"), tmp],
            concat(dcc_source_root_flags(), concat(dcc_pool_index_flags(), [
              lit(text: "--output-dir"), Concat { parts: [tmp, lit(text: "/out")] },
              lit(text: "--target"), lit(text: "dag")
            ]))
          )),
          redir: StdoutAndStderrToNull
        },
        then: [
          command(words: [lit(text: "rm"), lit(text: "-rf"), tmp]),
          Exit { code: 1 }
        ]
      },
      command(words: [lit(text: "rm"), lit(text: "-rf"), tmp]),
      Exit { code: 0 }
    ])
  }
}

fn run_perturb_unresolved_import_red_receipt() -> Bool {
