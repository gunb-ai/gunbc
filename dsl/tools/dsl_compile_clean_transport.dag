// tools/dsl_compile_clean_transport.dag — shell transport for whole-tree dsl/ compile-clean.
//
// Host runs `gunbc compile --source-root <dsl> --target rust` over the live tree (GREEN) and
// a temp-tree perturb receipt (RED: planted optional Some/None skew must fail typecheck).
//
// `run_clean_tree_compile` is the FIRST transport migrated off a hand-written `let script = "..."`
// blob onto a structured `ShellProgram` rendered by `serialize_bash` (extdeps.languages.bash.program).
// The script's policy now lives in a typed Node tree, not an opaque String. Proven green by the
// gate executing the compile-clean check.

module tools.dsl_compile_clean_transport

import extdeps.shell
import extdeps.languages.bash.program {
  ShellProgram, ShellStmt, ShellWord,
  Command, Assign, If, Subshell, AndOr, WithRedir, Exit,
  Lit, VarRef, Concat, CmdSubst,
  NotExecutable, AndThen, OrElse, StderrToNull,
  lit, var_ref, command, assign, serialize_bash
}

// The compile-clean script as structured data:
//   set -e
//   ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
//   GUNBC="$ROOT"/target/release/gunbc
//   if [ ! -x "$GUNBC" ]; then (cd "$ROOT" && cargo build -p v1-compiler --release --bin gunbc) || exit 1; fi
//   OUT=$(mktemp -d)
//   "$GUNBC" compile --source-root "$ROOT"/dsl --output-dir "$OUT" --target rust
//   rm -rf "$OUT"
fn clean_tree_compile_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  let gunbc = var_ref(name: "GUNBC")
  let out = var_ref(name: "OUT")
  ShellProgram {
    set_e: true,
    statements: [
      assign(name: "ROOT", value: CmdSubst { body: AndOr {
        left: WithRedir {
          stmt: command(words: [lit(text: "git"), lit(text: "rev-parse"), lit(text: "--show-toplevel")]),
          redir: StderrToNull
        },
        op: OrElse,
        right: command(words: [lit(text: "pwd")])
      } }),
      assign(name: "GUNBC", value: Concat { parts: [root, lit(text: "/target/release/gunbc")] }),
      If {
        cond: NotExecutable { path: gunbc },
        then: [
          AndOr {
            left: Subshell { body: [
              AndOr {
                left: command(words: [lit(text: "cd"), root]),
                op: AndThen,
                right: command(words: [
                  lit(text: "cargo"), lit(text: "build"), lit(text: "-p"), lit(text: "v1-compiler"),
                  lit(text: "--release"), lit(text: "--bin"), lit(text: "gunbc")
                ])
              }
            ] },
            op: OrElse,
            right: Exit { code: 1 }
          }
        ]
      },
      assign(name: "OUT", value: CmdSubst { body: command(words: [lit(text: "mktemp"), lit(text: "-d")]) }),
      command(words: [
        gunbc, lit(text: "compile"),
        lit(text: "--source-root"), Concat { parts: [root, lit(text: "/dsl")] },
        lit(text: "--output-dir"), out,
        lit(text: "--target"), lit(text: "rust")
      ]),
      command(words: [lit(text: "rm"), lit(text: "-rf"), out])
    ]
  }
}

fn run_clean_tree_compile() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: clean_tree_compile_program()))
  result.success
}

// RED receipt: copy dsl/ + one module with legacy Some/None on builtin T?; compile must fail.
// NEXT (warm-badger-46): migrate off this blob too — it bakes a .dag file via a heredoc, which is
// a file-WRITE effect (dispatch_file content-write), so it decomposes into write+run rather than a
// pure ShellProgram. Tracked as the next increment behind clean_tree_compile_program above.
fn run_perturb_optional_skew_red_receipt() -> Bool {
  let script = "set -e\nROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"\nGUNBC=\"$ROOT/target/release/gunbc\"\nif [ ! -x \"$GUNBC\" ]; then (cd \"$ROOT\" && cargo build -p v1-compiler --release --bin gunbc) || exit 1; fi\nTMP=$(mktemp -d)\ncp -r \"$ROOT/dsl\" \"$TMP/dsl\"\ncat > \"$TMP/dsl/test/_perturb_compile_clean_red.dag\" <<'PERTURB'\nmodule test.perturb_compile_clean_red\nfn probe() -> String? {\n  match Present { value: \"x\" } {\n    Some { value: s } => Some { value: s }\n    None => none\n  }\n}\nPERTURB\nif \"$GUNBC\" compile --source-root \"$TMP/dsl\" --output-dir \"$TMP/out\" --target rust >/dev/null 2>&1; then\n  rm -rf \"$TMP\"\n  exit 1\nfi\nrm -rf \"$TMP\"\nexit 0"
  let result = shell.Exec.Run(script: script)
  result.success
}
