// tools/rust_gates_ci.dag -- the Rust-monolith CI gate, run by `gunbc` (NOT a Rust binary).
//
// Realizes the three dependents of the Rust monolith (cargo fmt, cargo clippy, cargo test)
// selected by `tools.rust_stage0_gates`. `git diff` is extdeps.git; cargo invocations use
// `gunbc.ci_spec` EAGAIN retry scripts via shell.Exec (workflow policy, §3 — not dispatch_shell).
// Nested func calls serialize host shell transports (parallel bindings race under batch-2 load).
// the gate logic is `.dag` authority, the only Rust left is the `gunbc` interpreter seed.
//
// Run in CI: gunbc run --source-root dsl --entry dsl/tools/rust_gates_ci.dag --function main
//   (host maps the returned ProcessExit: ExitSuccess → 0, ExitFailure { code } → code.)
//
// SCAFFOLD — dissolves when the Rust seed reaches zero (DESIGN §7): no Rust monolith, no gate.

module tools.rust_gates_ci

import std.process { ProcessExit, ExitSuccess, ExitFailure }
import extdeps.git
import extdeps.shell
import tools.rust_stage0_gates { should_run_gates }
import gunbc.ci_spec {
  gunbc_ci_spec,
  DiffMergeBase,
  DiffTwoDot,
  ci_cargo_eagain_retry_shell_exec,
  ci_rust_gate_fmt_command,
  ci_rust_gate_clippy_command,
  ci_rust_gate_test_command,
}

fn exit_ok(e: ProcessExit) -> Bool {
  match e { ExitSuccess => true  _ => false }
}

func run_fmt_check() -> ProcessExit {
  fmt = shell.Exec.Run(
    script: ci_cargo_eagain_retry_shell_exec(command: ci_rust_gate_fmt_command())
  )
  if fmt.success {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: "cargo fmt --all --check failed" }
  }
}

func run_clippy_check() -> ProcessExit {
  clippy = shell.Exec.Run(
    script: ci_cargo_eagain_retry_shell_exec(command: ci_rust_gate_clippy_command())
  )
  if clippy.success {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: "cargo clippy --all-targets -- -D warnings failed" }
  }
}

func run_interp_fixture_test() -> ProcessExit {
  test = shell.Exec.Run(
    script: ci_cargo_eagain_retry_shell_exec(command: ci_rust_gate_test_command())
  )
  if test.success {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: "cargo test -p v1-compiler-tests interp_recorded_fixture failed" }
  }
}

// Run cargo fmt, clippy, and test sequentially via separate func calls (all evaluated —
// no short-circuit, so every failure surfaces). Parallel effect bindings in one func
// body race under batch-2 load; nested func calls serialize host shell transports.
// SCAFFOLD — gate scope: hermetic seam discriminators only (interp_recorded_fixture).
// Dissolve-on: promote to extra_args ["--workspace"] when v1-compiler --lib self_* quartet
// and full v1-compiler-tests package are green without ignored tests (§6 named trigger).
func run_gates() -> ProcessExit {
  let fmt = run_fmt_check()
  let clippy = run_clippy_check()
  let test = run_interp_fixture_test()
  return if exit_ok(e: fmt) && exit_ok(e: clippy) && exit_ok(e: test) {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: "rust gate failed: cargo fmt --all --check and/or cargo clippy --all-targets -- -D warnings and/or cargo test (hermetic discriminators)" }
  }
}

// Entry: consult the diff, fire the gates only when the Rust monolith is touched.
// Policy (which base ref, three-dot merge-base mode) lives here — not in extdeps/git.
func run_rust_monolith_gate() -> ProcessExit {
  let policy = gunbc_ci_spec.diff_policy
  let changed = match policy.mode {
    DiffMergeBase => git.Core.DiffNameOnlyMerge(base: policy.base, head: policy.head)
    DiffTwoDot => git.Core.DiffNameOnly(base: policy.base, head: policy.head)
  }
  return if should_run_gates(paths: changed.paths, git_success: changed.success) {
    run_gates()
  } else {
    ExitSuccess
  }
}

func main() -> ProcessExit {
  run_rust_monolith_gate()
}
