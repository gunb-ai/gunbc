module tools.rust_gates_ci

import std.process { ProcessExit, ExitSuccess, ExitFailure }
import extdeps.git
import extdeps.cargo_build
import extdeps.cargo_build { cargo_nextest_build_jobs_flag }
import tools.rust_stage0_gates { should_run_gates }
import gunbc.ci_spec {
  gunbc_ci_spec,
  DiffMergeBase,
  DiffTwoDot,
}
import gunbc.ci_compile_jobs { ci_compile_jobs, compile_jobs_count_or_serial }
import gunbc.operator_fleet { srv1_host }
import product.compute_fabric { compute_host_ram_bytes_total }

fn rust_gate_build_jobs_args() -> List<String> {
  let jobs = ci_compile_jobs(
    memory_budget: compute_host_ram_bytes_total(host: srv1_host),
    force_serial: false
  )
  cargo_nextest_build_jobs_flag(count: compile_jobs_count_or_serial(jobs: jobs))
}

func run_gates() -> ProcessExit {
  fmt = cargo.Build.Fmt(extra_args: ["--all", "--check"])
  clippy = cargo.Build.Clippy(extra_args: ["--all-targets"], lint_args: ["-D", "warnings"])
  test = cargo.Build.Nextest(extra_args: ["-p", "v1-compiler-tests"], build_jobs_args: rust_gate_build_jobs_args())
  return if fmt.success && clippy.success && test.success {
    ExitSuccess
  } else {
    ExitFailure { code: 1, reason: "rust gate failed: cargo fmt --all --check and/or cargo clippy --all-targets -- -D warnings and/or cargo nextest run -p v1-compiler-tests" }
  }
}

func run_rust_monolith_gate() -> ProcessExit {
  let policy = gunbc_ci_spec.diff_policy
  let changed = match policy.mode {
    DiffMergeBase => git.Core.DiffNameOnlyMerge(base: policy.base, head: policy.head)
    DiffTwoDot => git.Core.DiffNameOnly(base: policy.base, head: policy.head)
  }
  // closure_paths: [] for now -- the rust-test consumed-.dag closures live on the
  // NodeArtifactProvenance carrier in the v2 tree (v2.workflow.rust_test_dag_closure), and
  // dsl is MORE fundamental than v2 (cross_tree.import_model), so this dsl host program
  // cannot import the v2 closure. Threading the union of declared closures into this
  // production caller is the Edge-(b) shared blocker (structural .dag-closure discovery,
  // surfaced into a dsl-readable form) -- not slice 1. Empty closure is behavior-preserving.
  return if should_run_gates(paths: changed.paths, git_success: changed.success, closure_paths: []) {
    run_gates()
  } else {
    ExitSuccess
  }
}

func main() -> ProcessExit {
  run_rust_monolith_gate()
}
