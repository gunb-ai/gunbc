// tools/stage0_lockstep_gate.dag — stage0 regen-lockstep gate, run by the CI floor.
//
// Closes the §6 hole: nothing in CI gated on the stage0 seed being a clean
// function of the `.dag`, so the seed silently drifted. This gate runs
// `regen_stage0 --verify` (the lockstep oracle) over the live tree (GREEN) plus
// a planted-drift RED receipt (the +/- teeth), mirroring tools.dsl_compile_clean_gate.
//
// Catches drift the existing floor MISSES — two observed data points: (1) a
// hand-patched seed fn with no `.dag` source (the policy accessors that lived
// seed-only) regen-drops on a fresh self-compile, which `regen_stage0 --verify`
// flags but a typecheck of the committed seed does not; (2) a parse error in the
// emitter `.dag` that surfaces ONLY in regen's self-compile of the v1 tree — a PR
// whose `DslCompileCleanGate` was GREEN still failed `regen_stage0 --verify` (a
// parser-strictness divergence / compile-clean blind spot). Both are seed↔.dag
// lockstep failures the regen oracle detects and the rest of the floor does not.
//
// Run standalone:
//   cargo run -p v1-compiler --release --bin gunbc -- run \
//     --source-root dsl --entry dsl/tools/stage0_lockstep_gate.dag --function main
//
// §2 DEDUP MARKER (dissolution trigger — prompt follow-up, not someday): this gate's
// `regen_stage0 --verify` self-compiles the .dag tree, and DslCompileCleanGate ALSO
// self-compiles the whole tree in the same floor run — TWO full self-compiles per CI
// pass (real §1-time redundancy). Dissolve by having the lockstep verify REUSE the
// DslCompileCleanGate whole-tree compile artifact (content-addressed) rather than
// recompiling. Landed as always-run (option A) now; this is the named optimization to
// reclaim the second compile once the artifact-reuse seam exists.

module tools.stage0_lockstep_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.stage0_lockstep_transport {
  run_stage0_lockstep_verify,
  run_stage0_lockstep_perturb_red_receipt
}

func run_stage0_lockstep_gate_body() -> ProcessExit {
  let clean = run_stage0_lockstep_verify()
  let perturb = run_stage0_lockstep_perturb_red_receipt()
  return if clean && perturb {
    ExitSuccess
  } else {
    exit_failure(
      reason: "stage0 regen-lockstep gate failed: regen_stage0 --verify and/or planted-drift red receipt"
    )
  }
}

func run_stage0_lockstep_gate() -> ProcessExit {
  run_stage0_lockstep_gate_body()
}

func main() -> ProcessExit {
  run_stage0_lockstep_gate_body()
}
