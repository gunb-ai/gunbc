// tools/resolved_imports_transport.dag — host transport for the resolved-imports gate.
//
// Sibling of tools.layering_imports_transport: import enumeration lives in the
// single-authority projection v2.lens.resolved_imports.import_resolution_facts_live
// (v1 handler: src/v1/stage0/src/import_resolution_project.rs, REUSING the resolver's own
// build_module_path_index + extract_import_paths + collect_dag_files_tolerant). This
// transport only runs the gunbc Bool witnesses that call that projection:
//   * clean_tree (over the live witness tree, /test/fixture/ excluded) must hold —
//     zero dangling imports;
//   * the scanner-execution receipt (over the committed parse_level_pre_resolve fixture)
//     must detect its one planted unresolved import — the by-execution oracle that the
//     projection's membership check matches the resolver's UnresolvedImport rule.
// Source roots come from witness_layer_roots (§3 single authority).
//
// dissolve-on: emit(intent, Bash) makes this gunbc-claim shell program a Node tree the
//   emitter serializes (matches v2.lens.host_language_transport_script).

module tools.resolved_imports_transport

import extdeps.shell
import gunbc.ci_layer_roots { witness_layer_roots }
import std.logic { Bool }
import extdeps.languages.bash.program {
  ShellProgram, ShellStmt, ShellWord,
  Command, Lit, VarRef,
  lit, var_ref, command, serialize_bash
}
import tools.host_prelude { ensure_gunbc_built }

data clean_tree_entry: String = "src/v2/test/claim/resolved_imports/clean_tree_test.dag"
data clean_tree_function: String = "resolved_imports_clean_over_live_tree_holds"
data scanner_entry: String = "src/v2/test/claim/resolved_imports/scanner/parse_level_pre_resolve.dag"
data scanner_function: String = "scanner_parse_level_pre_resolve_detects_holds"

// --source-root <r> for every witness_layer_root (§3 single authority — same roots as the
// rest of CI, NOT a hardcoded "src/v2").
fn source_root_flags() -> List<ShellWord> {
  fold(witness_layer_roots, init: [], f: (acc, r) => concat(acc, [lit(text: "--source-root"), lit(text: r)]))
}

// "$GUNBC" run <source-root flags> --entry <e> --function <f> --claim-run
fn gunbc_claim_run(entry: String, function: String) -> ShellStmt {
  command(words: concat(
    concat([var_ref(name: "GUNBC"), lit(text: "run")], source_root_flags()),
    [lit(text: "--entry"), lit(text: entry), lit(text: "--function"), lit(text: function), lit(text: "--claim-run")]
  ))
}

// One ShellProgram: ensure gunbc built, then the given claim-runs (set -e — any failing
// claim fails the gate). The script: argument is a computed serialize_bash application, so
// v2.lens.host_language_transport_script reads it as ComputedApplication (no literal blob).
fn run_claims(stmts: List<ShellStmt>) -> Bool {
  let prog = ShellProgram {
    set_e: true,
    statements: concat(ensure_gunbc_built(), stmts)
  }
  let result = shell.Exec.Run(script: serialize_bash(p: prog))
  result.success
}

// Green pass: the live import-resolution projection over the witness tree must hold.
fn run_clean_tree_gate() -> Bool {
  run_claims(stmts: [gunbc_claim_run(entry: clean_tree_entry, function: clean_tree_function)])
}

// Scanner-execution detection receipt — the projection flags exactly one unresolved import
// over the committed fixture (equivalence-by-execution oracle for the resolver's rule).
fn run_scanner_perturb_receipts() -> Bool {
  run_claims(stmts: [gunbc_claim_run(entry: scanner_entry, function: scanner_function)])
}
