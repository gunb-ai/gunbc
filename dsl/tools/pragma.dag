// tools/pragma.dag -- Pragma config file generation.
//
// Generates 3 config files from pragma directives, each using
// content_upsert. All 3 chains are independent (parallel).
//
//   1. clippy.toml           -- Clippy configuration
//   2. disallowed-methods-allowlist.txt -- Method allowlist
//   3. pragma-lint-policy.txt -- Lint policy rules
//
// Each render fn contains filter |> map |> join chains that lower to
// FilterNode -> MapNode -> JoinNode in the IR.
//
// Replaces: gunbc-dag/src/pragma/graph.rs (~19 nodes)

module tools.pragma

import std.patterns { content_upsert }
import std.types { Document, PragmaDirective }
import shared.dag_util { doc_with_header, generated_header, render_document, section, text_line }
import config.clippy_policy { derive_clippy_toml, derive_disallowed_methods_allowlist, derive_pragma_lint_policy }
import config.arch_rules { allowlist_patterns, dead_code_allowances, exemptions, large_error_threshold, pragma_allow_lints }
import config.clippy_disallowed { disallowed_method_groups, disallowed_type_groups }

fn render_clippy_toml_document(directives: List<PragmaDirective>) -> Document {
  let entries = directives
    |> filter(d => d.scope == "clippy" || d.scope == None)
    |> map(d => text_line(text: "{d.key} = {d.value}"))
  doc_with_header(
    header: generated_header(tool: "pragma"),
    comment_prefix: "#",
    sections: [section(lines: entries)]
  )
}

fn render_clippy_toml(directives: List<PragmaDirective>) -> String {
  render_document(document: render_clippy_toml_document(directives: directives))
}

fn render_disallowed_methods_allowlist_document(directives: List<PragmaDirective>) -> Document {
  let methods = directives
    |> filter(d => d.key == "disallowed_method")
    |> map(d => text_line(text: d.value))
  doc_with_header(
    header: generated_header(tool: "pragma"),
    comment_prefix: "#",
    sections: [section(lines: methods)]
  )
}

fn render_disallowed_methods_allowlist(directives: List<PragmaDirective>) -> String {
  render_document(document: render_disallowed_methods_allowlist_document(directives: directives))
}

fn render_pragma_lint_policy_document(directives: List<PragmaDirective>) -> Document {
  let policies = directives
    |> filter(d => d.scope == "lint")
    |> map(d => text_line(text: "{d.key}: {d.value}"))
  doc_with_header(
    header: generated_header(tool: "pragma"),
    comment_prefix: "#",
    sections: [section(lines: policies)]
  )
}

fn render_pragma_lint_policy(directives: List<PragmaDirective>) -> String {
  render_document(document: render_pragma_lint_policy_document(directives: directives))
}

func pragma(directives: List<PragmaDirective>) -> { success: Bool, clippy_written: Bool, allowlist_written: Bool, policy_written: Bool } {
  clippy = content_upsert(
    content: derive_clippy_toml(threshold: large_error_threshold, crate_exemptions: exemptions, method_groups: disallowed_method_groups, type_groups: disallowed_type_groups),
    path: "clippy.toml"
  )

  allowlist = content_upsert(
    content: derive_disallowed_methods_allowlist(patterns: allowlist_patterns),
    path: "tools/disallowed-methods-allowlist.txt"
  )

  policy = content_upsert(
    content: derive_pragma_lint_policy(dead_code: dead_code_allowances, allow_lints: pragma_allow_lints),
    path: "tools/pragma-lint-policy.txt"
  )

  return {
    success: true,
    clippy_written: clippy.written,
    allowlist_written: allowlist.written,
    policy_written: policy.written
  }
}

// ── Tests ──────────────────────────────────────────────────────────

test pragma_dryrun {}
