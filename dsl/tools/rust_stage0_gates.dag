module tools.rust_stage0_gates

import std.list { List }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

fn rust_monolith_suffixes() -> List<String> {
  [".rs", "Cargo.toml", "Cargo.lock", "rust-toolchain.toml",
   "clippy.toml", "rustfmt.toml", ".cargo/config.toml"]
}

fn path_is_rust_monolith(path: String) -> Bool {
  fold(rust_monolith_suffixes(), false, fn(acc, suffix) { acc || ends_with(s: path, suffix: suffix) })
}

fn any_rust_monolith(paths: List<String>) -> Bool {
  fold(paths, false, fn(acc, p) { acc || path_is_rust_monolith(path: p) })
}

data consumed_input_closure_concept_note: Disposition = Terminal {
  reason: "ConsumedInputClosure is the first std-layer authority for dsl-layer input-consumption selection; consume-input vs produce-artifact is a permanent §3 distinction (different direction + domain from NodeArtifactProvenance), so this dsl-layer instance is the FIRST authority, not a parallel mint"
}

data consumed_input_closure_convergence_candidate: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.consumed_input",
    decl_name: "ConsumedInputClosure",
    field: WholeDeclaration
  }
}

data consumed_input_closure_slice1_status: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "tools.rust_stage0_gates",
    decl_name: "structural_closure_derivation",
    field: WholeDeclaration
  }
}

type ConsumedInputClosure {
  unit: String
  consumed_dag_paths: List<String>
}

data coproduct_reflection_conformance_consumed_closure: ConsumedInputClosure = ConsumedInputClosure {
  unit: "coproduct_reflection_conformance_test",
  consumed_dag_paths: [
    "src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag",
    "src/v2/std/algebra.dag",
    "src/v2/std/collection.dag",
    "src/v2/std/diagnostic.dag",
    "src/v2/std/logic.dag",
    "src/v2/std/node.dag",
    "src/v2/std/node_query.dag",
    "src/v2/std/witness.dag"
  ]
}

data declared_consumed_input_closures: List<ConsumedInputClosure> = [
  coproduct_reflection_conformance_consumed_closure
]

fn closure_contains_path(closure: ConsumedInputClosure, path: String) -> Bool {
  fold(closure.consumed_dag_paths, false, fn(acc, p) { acc || (p == path) })
}

fn closure_hit_by_any(closure: ConsumedInputClosure, paths: List<String>) -> Bool {
  fold(paths, false, fn(acc, p) { acc || closure_contains_path(closure: closure, path: p) })
}

fn any_declared_closure_hit(paths: List<String>) -> Bool {
  fold(declared_consumed_input_closures, false, fn(acc, c) { acc || closure_hit_by_any(closure: c, paths: paths) })
}

data unit_must_run_failclosed_note: Disposition = Terminal {
  reason: "fail-closed per-unit selection is a permanent §5 invariant: absent declaration = must-run, keeping coverage sound while declarations are added incrementally"
}

data unit_must_run_staged_note: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "tools.rust_stage0_gates",
    decl_name: "per_unit_test_selector",
    field: WholeDeclaration
  }
}

fn unit_must_run(unit: String, paths: List<String>) -> Bool {
  fold(declared_consumed_input_closures, true, fn(acc, c) {
    if c.unit == unit { closure_hit_by_any(closure: c, paths: paths) } else { acc }
  })
}

data should_run_gates_coverage_note: Disposition = Terminal {
  reason: "Coverage fire (Edge-(b)) is a permanent §5 design invariant: the rust gate ALSO runs when a changed .dag is in the union of declared consumed-input closures, only ever ADDING fires, never newly skipping"
}

fn should_run_gates(paths: List<String>, git_success: Bool) -> Bool {
  if git_success {
    any_rust_monolith(paths: paths) || any_declared_closure_hit(paths: paths)
  } else {
    true
  }
}
