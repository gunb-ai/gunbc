// tools/ci_yaml_gate.dag — fixed-point drift gate for the committed workflow YAML files.
//
// ONE gate concept `run_workflow_yaml_gate_body(path, expected, label)`: the committed file at
// `path` must equal its generator output `expected` byte-for-byte (DESIGN §7 self-emit fixed
// point — NO hash pin) AND parse as YAML. `ci.yml` and `nightly.yml` are two INSTANCES of this
// one gate (DESIGN §2 horizontal — distinct instances, not a forked second implementation).
// Regenerate with the matching `*_wet`.
//
// Run (check):    gunbc run --source-root dsl --entry dsl/tools/ci_yaml_gate.dag --function main
// Regenerate:     gunbc run --source-root dsl --entry dsl/tools/ci_yaml_gate.dag --function main_wet
// Nightly check:  ... --function nightly_main      Regenerate: ... --function nightly_main_wet

module tools.ci_yaml_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.ci_yaml_emit { expected_ci_yml, expected_nightly_yml }
import gunbc.ci_yaml_validate { ci_yml_parses }

data ci_yml_path: String = ".github/workflows/ci.yml"
data nightly_yml_path: String = ".github/workflows/nightly.yml"

// ── The one gate concept ────────────────────────────────────────────────────────────────
func run_workflow_yaml_gate_body(path: String, expected: String, label: String) -> ProcessExit {
  let committed = Filesystem.Read(path: path)
  let drift_ok = committed.success && (committed.content == expected)
  let parse_ok = ci_yml_parses(path: path)
  return if drift_ok && parse_ok {
    ExitSuccess
  } else if !drift_ok {
    exit_failure(reason: concat(label, " drift: regenerate via the matching main_wet on dsl/tools/ci_yaml_gate.dag"))
  } else {
    exit_failure(
      reason: concat(label, " does not parse as YAML (install python3-yaml or actionlint; see gunbc.ci_yaml_validate)")
    )
  }
}

func run_workflow_yaml_gate_wet(path: String, expected: String, label: String) -> ProcessExit {
  let w = Filesystem.Write(path: path, content: expected)
  return if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat(concat(label, " write failed: "), w.error))
  }
}

fn exit_ok(e: ProcessExit) -> Bool {
  match e { ExitSuccess => true  _ => false }
}

// §5 receipt: clean bytes match; perturbed bytes must drift (the gate has teeth).
func drift_red_receipt(path: String, expected: String, label: String) -> ProcessExit {
  let committed = Filesystem.Read(path: path)
  let clean_ok = committed.success && (committed.content == expected)
  let perturb_drifts = !(concat(expected, "\n# drift-receipt-perturb") == expected)
  return if clean_ok && perturb_drifts {
    ExitSuccess
  } else {
    exit_failure(reason: concat(label, " drift red receipt failed: clean must match; perturb must drift"))
  }
}

func run_gate_with_receipt(path: String, expected: String, label: String) -> ProcessExit {
  let gate = run_workflow_yaml_gate_body(path: path, expected: expected, label: label)
  let red = drift_red_receipt(path: path, expected: expected, label: label)
  return if exit_ok(gate) && exit_ok(red) {
    ExitSuccess
  } else if !exit_ok(gate) {
    gate
  } else {
    red
  }
}

// ── ci.yml instance ─────────────────────────────────────────────────────────────────────
func run_ci_yaml_gate_body() -> ProcessExit {
  run_workflow_yaml_gate_body(path: ci_yml_path, expected: expected_ci_yml(), label: "ci.yml")
}

func main() -> ProcessExit {
  run_ci_yaml_gate_body()
}

func main_wet() -> ProcessExit {
  run_workflow_yaml_gate_wet(path: ci_yml_path, expected: expected_ci_yml(), label: "ci.yml")
}

func run_ci_yaml_gate() -> ProcessExit {
  run_gate_with_receipt(path: ci_yml_path, expected: expected_ci_yml(), label: "ci.yml")
}

// ── nightly.yml instance ────────────────────────────────────────────────────────────────
func run_nightly_yaml_gate_body() -> ProcessExit {
  run_workflow_yaml_gate_body(path: nightly_yml_path, expected: expected_nightly_yml(), label: "nightly.yml")
}

func nightly_main() -> ProcessExit {
  run_nightly_yaml_gate_body()
}

func nightly_main_wet() -> ProcessExit {
  run_workflow_yaml_gate_wet(path: nightly_yml_path, expected: expected_nightly_yml(), label: "nightly.yml")
}

func run_nightly_yaml_gate() -> ProcessExit {
  run_gate_with_receipt(path: nightly_yml_path, expected: expected_nightly_yml(), label: "nightly.yml")
}
