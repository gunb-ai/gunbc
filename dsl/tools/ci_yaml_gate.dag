// tools/ci_yaml_gate.dag — fixed-point drift gate for `.github/workflows/ci.yml`.
//
// The committed ci.yml must equal `expected_ci_yml()` byte-for-byte (DESIGN §7 self-emit
// fixed point — NO hash pin). Regenerate with `main_wet`.
//
// Run (check):
//   gunbc run --source-root dsl --entry dsl/tools/ci_yaml_gate.dag --function main
// Regenerate (write):
//   gunbc run --source-root dsl --entry dsl/tools/ci_yaml_gate.dag --function main_wet

module tools.ci_yaml_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.ci_yaml_emit { expected_ci_yml, ci_yml_drifted }
import gunbc.ci_yaml_validate { ci_yml_parses }

data ci_yml_path: String = ".github/workflows/ci.yml"

func run_gate() -> ProcessExit {
  let committed = Filesystem.Read(path: ci_yml_path)
  let drift_ok = committed.success && !ci_yml_drifted(committed: committed.content)
  let parse_ok = ci_yml_parses(path: ci_yml_path)
  return if drift_ok && parse_ok {
    ExitSuccess
  } else if !drift_ok {
    exit_failure(reason: "ci.yml drift: regenerate via main_wet on dsl/tools/ci_yaml_gate.dag")
  } else {
    exit_failure(
      reason: "ci.yml does not parse as YAML (install python3-yaml or actionlint; see gunbc.ci_yaml_validate)"
    )
  }
}

func main() -> ProcessExit {
  run_gate()
}

func main_wet() -> ProcessExit {
  let expected = expected_ci_yml()
  let w = Filesystem.Write(path: ci_yml_path, content: expected)
  return if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("ci.yml write failed: ", w.error))
  }
}

// Composed CI floor entry point (tools.ci_floor_gates imports this name).
func run_ci_yaml_gate() -> ProcessExit {
  run_gate()
}

// §5 receipt: perturbed bytes must drift (gate would exit non-zero on this content).
func drift_red_receipt() -> ProcessExit {
  let committed = Filesystem.Read(path: ci_yml_path)
  let clean_ok = committed.success && !ci_yml_drifted(committed: committed.content)
  let perturb_drifts = ci_yml_drifted(committed: concat(expected_ci_yml(), "\n# drift-receipt-perturb"))
  return if clean_ok && perturb_drifts {
    ExitSuccess
  } else {
    exit_failure(reason: "ci.yml drift red receipt failed: clean must match; perturb must drift")
  }
}
