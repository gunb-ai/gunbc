module tools.gunbc_ci

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.shell
import gunbc.ci_spec { gunbc_ci_spec, gunbc_ci_run_script }

func main() -> ProcessExit {
  let script = gunbc_ci_run_script(spec: gunbc_ci_spec)
  let result = shell.Exec.Run(script: script)
  return if result.success {
    ExitSuccess
  } else {
    exit_failure(
      reason: concat(
        concat("gunbc ci failed (exit ", to_string(result.exit_code)),
        concat("): ", result.stderr)
      )
    )
  }
}
