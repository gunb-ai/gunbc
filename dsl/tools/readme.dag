module tools.readme

import std.patterns { content_upsert }
import std.resources { Filesystem }

type ReadmeTool {
  name: String
  description: String
}

fn render_tool_row(tool: ReadmeTool) -> String {
  "| `{tool.name}` | {tool.description} |"
}

fn render_tool_table(tools: List<ReadmeTool>) -> String {
  let header = "| Tool | Description |\n|------|-------------|"
  let rendered = map(tools, t => render_tool_row(tool: t))
  let rows = join(rendered, "\n")
  "\{header\}\n\{rows\}"
}

fn render_title() -> String {
  "# gunbc\n\nA DSL-first workflow compiler where everything is a DAG."
}

fn render_install() -> String {
  "## Install\n\n```bash\ngit clone <repo>\ncd gunbc\nmake install\n```\n\nRun `make help` to see all available targets."
}

fn render_overview() -> String {
  "## Overview\n\n`.dag` files declare types, data, and workflows. The compiler lowers them to executable graphs.\n\n```\nPipeline: .dag -> parse -> typecheck -> lower -> emit\n```\n\nRust is the substrate -- it compiles, executes, and emits artifacts. Domain logic, policy data, and rendering live in the DSL.\n\n| Path | Purpose |\n|------|---------|\n| `dsl/` | Primary authoring surface -- all `.dag` source files |\n| `core/daglang/` | DSL compiler: parse, typecheck, lower, emit |\n| `core/ir/` | Core IR types, patterns, transport model |\n| `core/exec/` | Execution engine |\n| `core/codegen/` | CLI and test generation |\n| `lib/transport/` | Canonical I/O boundary |\n| `gunbc-app/` | Repo-specific DAGs and CLI entrypoints |\n| `docs/` | Design documentation |"
}

fn render_tools(tools: List<ReadmeTool>) -> String {
  "## Tools\n\nAuto-discovered from `dsl/tools/*.dag` via structural entrypoint inference.\n\n{render_tool_table(tools: tools)}"
}

fn render_testing() -> String {
  "## Testing\n\n```bash\ncargo test\ncargo clippy --all-targets -- -D warnings\n```"
}

fn render_docs() -> String {
  "## Documentation\n\n- `CLAUDE.md` -- contributor and agent guide (auto-loaded by Claude Code)\n- `docs/start-here.md` -- repo orientation and feature development process\n- `docs/design/v2/dsl-design.md` -- DSL language specification\n- `SPEC.md` -- formal IR specification\n- `docs/handbook.md` -- conceptual map and e2e examples"
}

fn render_footer() -> String {
  "---\n\nGenerated by `gunbc-readme`. Do not edit manually.\n"
}

fn render_readme(tools: List<ReadmeTool>) -> String {
  let sections = [
    render_title(),
    render_install(),
    render_overview(),
    render_tools(tools: tools),
    render_testing(),
    render_docs(),
    render_footer()
  ]
  join(sections, "\n\n")
}

func readme(tools: List<ReadmeTool>) -> { written: Bool }
  uses fs: Filesystem(mode: ReadWrite)
{
  content = render_readme(tools: tools)
  result = content_upsert(content: content, path: "README.md")
  return { written: result.written }
}
