module tools.host_prelude

import extdeps.shell
import std.logic { Bool }
import extdeps.languages.bash.program {
  ShellStmt, ShellWord,
  Command, If, Subshell, AndOr, WithRedir, Exit,
  Lit, VarRef, Concat, CmdSubst,
  AndThen, OrElse, StderrToNull,
  lit, var_ref, command, assign, test_not_executable
}
import tools.build_step { BuildArtifact, emit_verifications }

fn assign_root_stmt() -> ShellStmt {
  assign(name: "ROOT", value: CmdSubst { body: AndOr {
    left: WithRedir {
      stmt: command(words: [lit(text: "git"), lit(text: "rev-parse"), lit(text: "--show-toplevel")]),
      redir: StderrToNull
    },
    op: OrElse,
    right: command(words: [lit(text: "pwd")])
  } })
}

fn build_bin_if_absent_stmt(bin_path: ShellWord, root: ShellWord, bin_name: String) -> ShellStmt {
  If {
    cond: test_not_executable(path: bin_path),
    then: [
      AndOr {
        left: Subshell { body: [
          AndOr {
            left: command(words: [lit(text: "cd"), root]),
            op: AndThen,
            right: command(words: [
              lit(text: "cargo"), lit(text: "build"), lit(text: "-p"), lit(text: "v1-compiler"),
              lit(text: "--release"), lit(text: "--bin"), lit(text: bin_name)
            ])
          }
        ] },
        op: OrElse,
        right: Exit { code: 1 }
      }
    ]
  }
}

fn ensure_bin_built_and_verified(var_name: String, bin_name: String) -> List<ShellStmt> {
  let root = var_ref(name: "ROOT")
  let bin = var_ref(name: var_name)
  concat(
    [
      assign_root_stmt(),
      assign(name: var_name, value: Concat { parts: [root, lit(text: concat("/target/release/", bin_name))] }),
      build_bin_if_absent_stmt(bin_path: bin, root: root, bin_name: bin_name)
    ],
    emit_verifications(
      produces: [BuildArtifact { path: bin, name: bin_name }]
    )
  )
}

fn ensure_gunbc_built() -> List<ShellStmt> {
  ensure_bin_built_and_verified(var_name: "GUNBC", bin_name: "gunbc")
}

fn ensure_discover_source_root_ingest_built() -> List<ShellStmt> {
  ensure_bin_built_and_verified(var_name: "DISCOVER_SOURCE_ROOT_INGEST", bin_name: "discover_source_root_ingest")
}

fn ensure_v1_src_dag_parse_built() -> List<ShellStmt> {
  ensure_bin_built_and_verified(var_name: "V1_SRC_DAG_PARSE", bin_name: "v1_src_dag_parse")
}

fn ensure_wiring_liveness_whole_tree_built() -> List<ShellStmt> {
  ensure_bin_built_and_verified(var_name: "WIRING_LIVENESS_WHOLE_TREE", bin_name: "wiring_liveness_whole_tree")
}

fn toolchain_provision_shell_exec(script: String) -> Bool {
  let result = shell.Exec.Run(script: script)
  result.success
}
