// tools/dag_viz.dag -- DAG visualization tool (all 4 modes).
//
// A meta-tool: introspects the compiled DAG system itself and renders
// interactive visualizations as HTML (Cytoscape.js) or markdown (Mermaid).
//
// Modes:
//   dag_viz_snapshot   -- current topology -> HTML/gist
//   dag_viz_diff       -- diff current vs base branch -> annotated diagram
//   dag_viz_recent     -- diff current vs 3 days ago
//   dag_viz_save       -- write topology JSON to .dag-snapshots/
//
// Replaces: gunbc-dag/src/dag_viz/graph.rs

module tools.dag_viz

import services.git
import tools.gist { gist_upload }
import std.resources { Filesystem }
import std.types { DagTopology, DagDiff }

// --- Services ---------------------------------------------------------
// workspace.Introspect is a special service: it reads compiled DAG builders
// at runtime and extracts topology. No external I/O.

service workspace.Introspect {
  operation BuildTopology {
    input {}
    output {
      topology_json: String
      node_count: Int
      total_node_count: Int
    }
    @hermetic @readonly
    // Calls build_workspace_dag() and serializes DagTopology to JSON
  }
}

service shell.Browser {
  operation Open {
    input { path: String }
    output { opened: Bool }
    @shell(["xdg-open", "{path}"])
    @external
  }
}

// --- Pure functions ---------------------------------------------------

fn render_topology_snapshot(
  topology_json: String,
  branch: String,
  format: String
) -> { content: String, ext: String } {
  // Renders DagTopology as:
  //   format="html" -> Cytoscape.js interactive viewer
  //   format="md"   -> Mermaid diagram in markdown
  // The actual rendering is complex (CSS, JS embedding for HTML mode).
  // The compiler compiles this; it's a pure string transformation.
  match format {
    "html" => {
      content: render_cytoscape_html(topology: topology_json, title: branch),
      ext: "html"
    }
    "md" => {
      content: render_mermaid_markdown(topology: topology_json, title: branch),
      ext: "md"
    }
  }
}

fn diff_topologies(
  current_json: String,
  base_json: String
) -> DagDiff {
  // Compares two DagTopology JSON strings and returns structural diff:
  // added nodes, removed nodes, changed edges.
  compute_topology_diff(current: current_json, base: base_json)
}

fn render_topology_diff(
  diff: DagDiff,
  current_json: String,
  branch: String,
  base_ref: String
) -> String {
  // Renders annotated Mermaid diagram with color-coded changes:
  //   green = added, red = removed, yellow = changed
  render_annotated_mermaid(
    diff: diff,
    topology: current_json,
    title: "{branch} vs {base_ref}"
  )
}

fn topology_snapshot_path() -> String {
  ".dag-snapshots/workspace.json"
}

// --- Journeys ---------------------------------------------------------

// Snapshot: build topology, render as HTML, upload to gist, save locally
journey dag_viz_snapshot {
  input { format: String = "html" }
  output { url: String, local_path: String }
  uses fs: Filesystem(mode: ReadWrite)

  // Build current topology
  topo = workspace.Introspect.BuildTopology()
  branch = git.Core.CurrentBranch()

  // Render to HTML or markdown
  rendered = render_topology_snapshot(
    topology_json: topo.topology_json,
    branch: branch.branch,
    format: format
  )

  // Save locally for browser viewing
  local_path = "target/dag-viz/workspace.{rendered.ext}"
  save = fs.write(path: local_path, content: rendered.content)
  open = shell.Browser.Open(path: local_path) [after save]

  // Upload to gist
  result = gist_upload(
    markdown: rendered.content,
    branch: branch.branch
  )

  return { url: result.url, local_path: local_path }
}

// Diff: compare current topology against a base branch
journey dag_viz_diff {
  input { base_ref: String = "main" }
  output { url: String }
  uses fs: Filesystem(mode: Read)

  // Build current topology
  topo = workspace.Introspect.BuildTopology()
  branch = git.Core.CurrentBranch()

  // Get base topology from git
  base_content = git.Core.Show(
    ref: base_ref,
    path: ".dag-snapshots/workspace.json"
  )

  // Diff and render
  diff = diff_topologies(
    current_json: topo.topology_json,
    base_json: base_content.content
  )
  markdown = render_topology_diff(
    diff: diff,
    current_json: topo.topology_json,
    branch: branch.branch,
    base_ref: base_ref
  )

  // Upload
  result = gist_upload(
    markdown: markdown,
    branch: branch.branch,
    base_ref: base_ref
  )

  return { url: result.url }
}

// Recent: compare current topology against 3 days ago
journey dag_viz_recent {
  input { since: String = "3.days.ago" }
  output { url: String }
  uses fs: Filesystem(mode: Read)

  // Build current topology
  topo = workspace.Introspect.BuildTopology()
  branch = git.Core.CurrentBranch()

  // Find the oldest commit in the range
  commits = git.Core.RevList(since: since)
  base_ref = commits.commits |> last()

  // Get base topology from that commit
  base_content = git.Core.Show(
    ref: base_ref,
    path: ".dag-snapshots/workspace.json"
  )

  // Diff and render
  diff = diff_topologies(
    current_json: topo.topology_json,
    base_json: base_content.content
  )
  markdown = render_topology_diff(
    diff: diff,
    current_json: topo.topology_json,
    branch: branch.branch,
    base_ref: base_ref
  )

  // Upload
  result = gist_upload(
    markdown: markdown,
    branch: branch.branch,
    base_ref: base_ref
  )

  return { url: result.url }
}

// Save: write topology JSON to .dag-snapshots/ for future diffing
journey dag_viz_save {
  input {}
  output { node_count: Int, total_node_count: Int }
  uses fs: Filesystem(mode: ReadWrite)

  topo = workspace.Introspect.BuildTopology()
  write = fs.write(
    path: topology_snapshot_path(),
    content: topo.topology_json
  )

  return {
    node_count: topo.node_count,
    total_node_count: topo.total_node_count
  }
}
