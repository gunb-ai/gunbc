// tools/extdeps_stable_authority_gate.dag — extdeps stable-authority anchor gate (slice 1: ADVISORY).
//
// Runs uri + live projection + RED perturb witnesses; reports but does NOT fail CI floor
// (ExtdepsStableAuthorityGate removed from gunbc_ci_spec until slice 3 flip).

module tools.extdeps_stable_authority_gate

import std.process { ProcessExit, ExitSuccess }
import tools.extdeps_stable_authority_transport {
  run_extdeps_stable_authority_uri_witnesses,
  run_extdeps_stable_authority_live_corpus_witness,
  run_extdeps_stable_authority_lens_unit_red
}

func run_extdeps_stable_authority_gate_body() -> ProcessExit {
  let _uri_ok = run_extdeps_stable_authority_uri_witnesses()
  let _live_ok = run_extdeps_stable_authority_live_corpus_witness()
  let _red_ok = run_extdeps_stable_authority_lens_unit_red()
  ExitSuccess
}

func main() -> ProcessExit {
  run_extdeps_stable_authority_gate_body()
}

func run_extdeps_stable_authority_ci_gate() -> ProcessExit {
  run_extdeps_stable_authority_gate_body()
}
