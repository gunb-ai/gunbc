// tools/gist.dag -- Gist creation tool (diff/recent modes).
//
// The snapshot mode lives in tools/gist_snapshot.dag (inlined service calls).
// These modes use shared/gist_modes.dag helpers, which have cross-callable
// data flow that the lowerer doesn't fully wire yet. They compile and run but
// produce empty results. Will be fixed when the lowerer supports callable
// argument wiring.
//
// Replaces: lib/tools/gist/src/graph.rs (~1,449 lines)

module tools.gist

import services.git
import shared.gist_modes { branch_context, resolve_recent_base, share_content }
import std.resources { Filesystem }
import std.types { CommitSha, Url }

fn render_diff_markdown(diff: String, branch: String, base_ref: CommitSha) -> String {
  "# Diff: {branch} vs {base_ref}\n\n```diff\n{diff}\n```\n"
}

func gist_diff(base_ref: CommitSha = "HEAD~1", public: Bool = false) -> { url: Url }
  uses fs: Filesystem(mode: Read)
{
  ctx = branch_context()
  changes = git.Core.Diff(base: base_ref)
  markdown = render_diff_markdown(diff: changes.diff, branch: ctx.branch, base_ref: base_ref)
  result = share_content(markdown: markdown, branch: ctx.branch, base_ref: base_ref, public: public)
  return { url: result.url }
}

func gist_recent(since: String = "3.days.ago", public: Bool = false) -> { url: Url }
  uses fs: Filesystem(mode: Read)
{
  recent = resolve_recent_base(since: since)
  changes = git.Core.Diff(base: recent.base_ref)
  markdown = render_diff_markdown(diff: changes.diff, branch: recent.branch, base_ref: recent.base_ref)
  result = share_content(markdown: markdown, branch: recent.branch, base_ref: recent.base_ref, public: public)
  return { url: result.url }
}

// ── Tests ──────────────────────────────────────────────────────────

test gist_diff_dryrun {
    @tier(Unit)
    @hermetic(true)
    @auto_mock(true)
}

test gist_recent_dryrun {
    @tier(Unit)
    @hermetic(true)
    @auto_mock(true)
}
