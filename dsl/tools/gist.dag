module tools.gist

import services.git
import std.patterns { read_text_files }
import std.resources { Filesystem }
import std.types { CommitSha, GitRef, TextFilePath, Url }
import shared.gist_modes { branch_context, resolve_recent_base, share_content }

fn render_snapshot(files: List<{ path: TextFilePath, content: String }>) -> String {
  let header = "# Code Snapshot\n\n"
  let sections = files
    |> map(f => "## `{f.path}`\n\n```\n{f.content}\n```")
    |> join("\n\n")
  "{header}{sections}"
}

fn render_diff(diff: String) -> String {
  "# Diff Snapshot\n\n```diff\n{diff}\n```"
}

fn render_recent(diffs: List<String>) -> String {
  let header = "# Recent Changes\n\n"
  let sections = diffs
    |> map(d => "```diff\n{d}\n```")
    |> join("\n\n---\n\n")
  "{header}{sections}"
}

func gist_snapshot(base_ref: CommitSha?) -> { url: Url }
  uses fs: Filesystem(mode: Read)
{
  ctx = branch_context()
  files = git.Core.LsFiles()
  read_result = read_text_files(paths: files.files)
  markdown = render_snapshot(files: read_result.files)
  result = share_content(markdown: markdown, branch: ctx.branch, base_ref: base_ref)
  return { url: result.url }
}

func gist_diff(base_ref: GitRef) -> { url: Url } {
  ctx = branch_context()
  diff = git.Core.Diff(base: base_ref)
  markdown = render_diff(diff: diff.diff)
  result = share_content(markdown: markdown, branch: ctx.branch, base_ref: base_ref)
  return { url: result.url }
}

func gist_recent(since: String = "3.days.ago") -> { url: Url } {
  recent = resolve_recent_base(since: since)
  commits = git.Core.RevList(since: since)
  diffs = for commit in commits.commits {
    git.Core.Diff(base: "{commit}~1", head: commit)
  }
  markdown = render_recent(diffs: diffs |> map(d => d.diff))
  result = share_content(
    markdown: markdown, branch: recent.branch, base_ref: recent.base_ref
  )
  return { url: result.url }
}
