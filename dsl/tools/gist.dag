// tools/gist.dag -- Gist creation tool (all 4 modes).
//
// Modes:
//   gist_snapshot -- list files, read contents, render markdown, upload
//   gist_diff     -- git diff, render markdown, upload
//   gist_recent   -- rev-list since N days, diff each commit, upload
//   gist_upload   -- shared upload func (credential + GitHub API)
//
// Composition: snapshot/diff/recent use shared helpers from gist_modes.dag
// for branch detection, base ref resolution, and gist upload. Only the
// content-production logic (what to snapshot, how to diff) is tool-specific.
//
// Two kinds of parallelism:
//   Task-parallel: `for file in files { fs.read(path: file) }` -> LoopBuilder
//   Data-parallel: `|> map(...)` in fn bodies -> MapNode/JoinNode in IR
//
// Replaces: lib/tools/gist/src/graph.rs (1,449 lines)
//           gunbc-dag/src/workspace/subdags/gist.rs

module tools.gist

import services.git
import services.github.gist
import std.patterns { credential_chain }
import std.resources { Filesystem, Network, AuthContext, Clock }
import std.types { CloudRuntime, AccessToken }
import shared.gist_modes { branch_context, resolve_recent_base, share_content }

// --- Pure functions ---------------------------------------------------

fn gist_filename(branch: String, base_ref: String?, timestamp: String) -> String {
  let suffix = match base_ref {
    Some(ref) => "-vs-{ref}"
    None      => ""
  }
  "snapshot-{branch}{suffix}-{timestamp}.md"
}

fn render_snapshot(files: List<{ path: String, content: String }>) -> String {
  let header = "# Code Snapshot\n\n"
  let sections = files
    |> map(f => "## `{f.path}`\n\n```\n{f.content}\n```")
    |> join("\n\n")
  "{header}{sections}"
}

fn render_diff(diff: String) -> String {
  "# Diff Snapshot\n\n```diff\n{diff}\n```"
}

fn render_recent(diffs: List<String>) -> String {
  let header = "# Recent Changes\n\n"
  let sections = diffs
    |> map(d => "```diff\n{d}\n```")
    |> join("\n\n---\n\n")
  "{header}{sections}"
}

// --- Upload (shared by all modes) ------------------------------------

func gist_upload(markdown: String, branch: String, base_ref: String?) -> { url: String }
  uses net: Network
  uses clock: Clock
  uses auth: AuthContext
{
  timestamp = clock.now()
  filename = gist_filename(
    branch: branch,
    base_ref: base_ref,
    timestamp: timestamp.timestamp
  )

  cred = credential_chain(
    runtime: detect_runtime(),
    audience: "sigstore",
    project: "gunbc",
    secret_name: "github-token",
    source_id: "gist",
    required_scopes: ["gist"],
    service_account: None
  )

  result = github.Gist.Create(
    description: "Snapshot from {branch}",
    files: { filename: markdown }
  )

  return { url: result.url }
}

// --- Modes (each produces markdown, then shares via gist) ------------

func gist_snapshot(base_ref: String?) -> { url: String }
  uses fs: Filesystem(mode: Read)
{
  ctx = branch_context()
  files = git.Core.LsFiles()

  contents = for file in files.files {
    content = fs.read(path: file)
    { path: file, content: content.content }
  }

  markdown = render_snapshot(files: contents)
  result = share_content(
    markdown: markdown,
    branch: ctx.branch,
    base_ref: base_ref
  )

  return { url: result.url }
}

func gist_diff(base_ref: String) -> { url: String } {
  ctx = branch_context()
  diff = git.Core.Diff(base: base_ref)
  markdown = render_diff(diff: diff.diff)
  result = share_content(
    markdown: markdown,
    branch: ctx.branch,
    base_ref: base_ref
  )

  return { url: result.url }
}

func gist_recent(since: String = "3.days.ago") -> { url: String } {
  recent = resolve_recent_base(since: since)
  commits = git.Core.RevList(since: since)
  diffs = for commit in commits.commits {
    git.Core.Diff(base: "{commit}~1", head: commit)
  }
  markdown = render_recent(diffs: diffs |> map(d => d.diff))
  result = share_content(
    markdown: markdown,
    branch: recent.branch,
    base_ref: recent.base_ref
  )

  return { url: result.url }
}
