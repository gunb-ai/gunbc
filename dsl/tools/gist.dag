// tools/gist.dag -- Gist creation tool (snapshot/diff/recent modes).
//
// Three entrypoints: gist, gist_diff, gist_recent (structurally inferred).
// Pure DSL -- no extern funcs. Snapshot content is built with map/join/fold.
//
// Replaces the previous version that used extern func build_snapshot_content.

module tools.gist

import extdeps.git
import extdeps.github.auth { github_token }
import extdeps.github.gists
import std.resources { Filesystem, Network }
import std.patterns { read_text_files }
import std.types { CommitSha, Url }

// ── Content rendering (pure DSL) ────────────────────────────────────

// Guess a language tag from a file extension for code block syntax highlighting.
fn lang_for_path(path: String) -> String {
  let parts = path |> split(".")
  let ext = parts |> last() ?? ""
  match ext {
    "rs"   => "rust"
    "dag"  => "dag"
    "toml" => "toml"
    "yaml" => "yaml"
    "yml"  => "yaml"
    "json" => "json"
    "md"   => "markdown"
    "py"   => "python"
    "js"   => "javascript"
    "ts"   => "typescript"
    "go"   => "go"
    "sh"   => "bash"
    "css"  => "css"
    "html" => "html"
    "sql"  => "sql"
    "txt"  => "text"
    _      => ""
  }
}

// Render one file entry as a markdown section: heading + code block.
fn render_file_section(path: String, content: String) -> String {
  let lang = lang_for_path(path: path)
  "## {path}\n\n```{lang}\n{content}\n```"
}

// Build the full snapshot markdown from branch, files, and skipped paths.
fn build_snapshot_content(
  branch: String,
  files: List<{ path: String, content: String }>,
  skipped: List<String>
) -> String {
  let heading = "# Snapshot: {branch}"
  let file_list = files |> map(f => f.path) |> join("\n")
  let tree_section = "## Files\n\n```\n{file_list}\n```"
  let file_sections = files
    |> map(f => render_file_section(path: f.path, content: f.content))
    |> join("\n\n")
  let skip_section = if skipped |> count() > 0 {
    let skip_lines = skipped |> map(s => "- {s}") |> join("\n")
    "\n\n## Skipped\n\n{skip_lines}"
  } else {
    ""
  }
  "{heading}\n\n{tree_section}\n\n{file_sections}{skip_section}"
}

// Render a diff as markdown with branch and base ref context.
fn render_diff_markdown(diff: String, branch: String, base_ref: CommitSha) -> String {
  "# Diff: {branch} vs {base_ref}\n\n```diff\n{diff}\n```"
}

// ── Entrypoints ─────────────────────────────────────────────────────

func gist(public: Bool = false) -> { url: Url }
  uses fs: Filesystem(mode: Read)
  uses net: Network
{
  branch_info = git.Core.CurrentBranch()
  listing = git.Core.LsFiles()

  result = read_text_files(paths: listing.files)

  content = build_snapshot_content(
    branch: branch_info.branch,
    files: result.files,
    skipped: result.skipped
  )
  token = github_token()
  gist_result = github.Gist.Create(
    description: branch_info.branch,
    content: content,
    public: public,
    auth_token: token.token
  )
  return { url: gist_result.html_url as Url }
}

func gist_diff(base_ref: CommitSha = "HEAD~1", public: Bool = false) -> { url: Url }
  uses fs: Filesystem(mode: Read)
  uses net: Network
{
  current = git.Core.CurrentBranch()
  changes = git.Core.Diff(base: base_ref)
  markdown = render_diff_markdown(diff: changes.diff, branch: current.branch, base_ref: base_ref)
  token = github_token()
  result = github.Gist.Create(
    description: current.branch,
    content: markdown,
    public: public,
    auth_token: token.token
  )
  return { url: result.html_url as Url }
}

func gist_recent(since: String = "3.days.ago", public: Bool = false) -> { url: Url }
  uses fs: Filesystem(mode: Read)
  uses net: Network
{
  current = git.Core.CurrentBranch()
  base = git.Core.RevListBase(since: since)
  changes = git.Core.Diff(base: base.base_ref)
  markdown = render_diff_markdown(
    diff: changes.diff,
    branch: current.branch,
    base_ref: base.base_ref
  )
  token = github_token()
  result = github.Gist.Create(
    description: current.branch,
    content: markdown,
    public: public,
    auth_token: token.token
  )
  return { url: result.html_url as Url }
}
