// tools/extdeps_stable_authority_transport.dag — host transport for stable-authority gate.

module tools.extdeps_stable_authority_transport

import std.logic { Bool }
import tools.claim_runner { run_claim_witness }

data uri_witness_entry: String = "dsl/test/claim/uri_witness_test.dag"
data uri_witness_fn: String = "uri_witnesses"

data live_corpus_entry: String = "src/v2/compiler/extdeps_stable_authority/corpus/self_anchor_live_clean_test.dag"
data live_corpus_fn: String = "corpus_self_anchor_live_clean_holds"

data missing_red_entry: String = "src/v2/compiler/extdeps_stable_authority/lens_unit/missing_anchor_red_test.dag"
data missing_red_fn: String = "missing_anchor_fixture_is_red_holds"

data bogus_scheme_red_entry: String = "src/v2/compiler/extdeps_stable_authority/lens_unit/bogus_scheme_red_test.dag"
data bogus_scheme_red_fn: String = "bogus_scheme_fixture_is_red_holds"

fn run_extdeps_stable_authority_uri_witnesses() -> Bool {
  run_claim_witness(entry: uri_witness_entry, function: uri_witness_fn)
}

fn run_extdeps_stable_authority_live_corpus_witness() -> Bool {
  run_claim_witness(entry: live_corpus_entry, function: live_corpus_fn)
}

fn run_extdeps_stable_authority_lens_unit_red() -> Bool {
  run_claim_witness(entry: missing_red_entry, function: missing_red_fn)
    && run_claim_witness(entry: bogus_scheme_red_entry, function: bogus_scheme_red_fn)
}
