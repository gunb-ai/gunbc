
module config.gitignore

import extdeps.gitignore { GitignoreCategory }

data categories: List<GitignoreCategory> = [
  {
    id: "cargo_build_artifacts",
    name: "Cargo build artifacts",
    source: "cargo",
    items: ["/target/", "/target-codex/"],
    rationale: "Reproducible from source via cargo build",
    when_build_system: none
  },
  {
    id: "cargo_home_cache",
    name: "Cargo cache (local CARGO_HOME)",
    source: "tool/rust",
    items: ["/.cargo-home/"],
    rationale: "Local Cargo cache may include git checkouts; not project state",
    when_build_system: none
  },
  {
    id: "codegen_bin_symlink",
    name: "Codegen bin symlink",
    source: "codegen",
    items: ["/bin/"],
    rationale: "Symlink to target/release created by codegen",
    when_build_system: none
  },
  {
    id: "buck2_build_artifacts",
    name: "Buck2 build artifacts",
    source: "buck2",
    items: ["/buck-out/"],
    rationale: "Reproducible from source via buck2 build",
    when_build_system: "buck2"
  },
  {
    id: "buck2_vendored_dependencies",
    name: "Vendored dependencies",
    source: "buck2",
    items: ["/third-party/rust/vendor/", "/third-party/rust/.cargo/"],
    rationale: "Reproducible from lockfile via reindeer vendor",
    when_build_system: "buck2"
  },
  {
    id: "coverage_reports",
    name: "Coverage reports",
    source: "cargo-tarpaulin",
    items: ["tarpaulin-report.html", "tarpaulin-report.json", "cobertura.xml", "lcov.info", "coverage/"],
    rationale: "Generated, often large, reproducible",
    when_build_system: none
  },
  {
    id: "editor_state",
    name: "Editor/IDE state",
    source: "editor",
    items: [".idea/", ".vscode/", "*.swp", "*.swo", "*~"],
    rationale: "Per-developer configuration, not project state",
    when_build_system: none
  },
  {
    id: "os_metadata",
    name: "OS metadata",
    source: "os",
    items: [".DS_Store", "Thumbs.db"],
    rationale: "OS-generated, not project state",
    when_build_system: none
  },
  {
    id: "secrets_local_config",
    name: "Secrets and local config",
    source: "secrets",
    items: [".env", ".env.local", ".env.*.local"],
    rationale: "Environment-specific, may contain secrets",
    when_build_system: none
  },
  {
    id: "generator_stamp_files",
    name: "Generator stamp files",
    source: "generators",
    items: [".*-stamp"],
    rationale: "Producer-centric model stamps; regenerated by make targets",
    when_build_system: none
  },
  {
    id: "workflow_runtime_state",
    name: "Workflow runtime state",
    source: "workflow",
    items: ["/.gunbc/"],
    rationale: "Local execution ledger and config; not source-of-truth",
    when_build_system: none
  },
  {
    id: "tool_outputs_bootstrap",
    name: "Stage0 regeneration temp dirs",
    source: "bootstrap",
    items: [".regen-sources/", ".regen-output/", ".regen-generated-source-root/"],
    rationale: "Historical v2 regen temp dirs (script retired); ephemeral if recreated locally",
    when_build_system: none
  },
  {
    id: "tool_outputs_testgen",
    name: "testgen outputs",
    source: "testgen",
    items: ["src/v1/10_test/generated-tests/src/generated/"],
    rationale: "Generated by testgen; not source-of-truth",
    when_build_system: none
  }
]
