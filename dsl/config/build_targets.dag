// config/build_targets.dag -- Canonical build target declarations.
//
// These data declarations are the source of truth for core workflows,
// meta targets, and resource target mappings. The Makefile renderer
// consumes these to produce the complete Makefile.

module config.build_targets

import extdeps.make

// ============================================================================
// Resource Target Mappings — how resources are provided as Make targets
// ============================================================================

data resource_targets: List<ResourceTargetEntry> = [
  { resource: "generated_cli",      ensure_target: "ensure-codegen",  verify_target: "ensure-codegen" },
  { resource: "generated_tests",    ensure_target: "testgen",         verify_target: "testgen-check" },
  { resource: "pragma_config",      ensure_target: "pragma",          verify_target: "pragma-check" },
  { resource: "compiled_code",      ensure_target: "build",           verify_target: "build" },
  { resource: "verified_artifacts", ensure_target: "verify-fix",      verify_target: "verify" },
  { resource: "deps_config",        ensure_target: "deps-config",     verify_target: "deps-config-check" },
  { resource: "makefile",           ensure_target: "makegen",         verify_target: "makegen-check" },
  { resource: "gitignore",          ensure_target: "bootstrap",       verify_target: "bootstrap-check" }
]

// ============================================================================
// Core Workflows — orchestration targets with dependency ordering
// ============================================================================

data core_workflows: List<CoreWorkflow> = [
  {
    name: "preflight-fix",
    description: "Preflight: auto-fix rustc warnings before running generators",
    deps: [],
    body: ["@cargo fix --workspace --all-targets --allow-dirty --allow-staged"],
    comment: None
  },
  {
    name: "ensure-codegen",
    description: "Ensure CLI entrypoints exist (bootstrap-safe)",
    deps: [],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-codegen -- codegen"],
    comment: None
  },
  {
    name: "build-release-bins",
    description: "Build workspace binaries once for direct tool execution",
    deps: ["ensure-codegen"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo build --workspace --release --bins"],
    comment: None
  },
  {
    name: "lint-upsert",
    description: "Lint upsert: fix if needed, then verify",
    deps: ["ensure-codegen", "preflight-fix"],
    body: [
      "@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-pragma",
      "@cargo clippy --all-targets -- -D warnings || (cargo clippy --fix --workspace --allow-dirty --allow-staged -- -D warnings && cargo clippy --all-targets -- -D warnings)"
    ],
    comment: None
  },
  {
    name: "codegen",
    description: "Generate CLI entrypoints (DAG upsert)",
    deps: ["lint-upsert"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-codegen-dag"],
    comment: None
  },
  {
    name: "build",
    description: "Full build transaction",
    deps: ["codegen", "testgen"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo build --all-targets"],
    comment: "Full build transaction: codegen \u{2192} testgen \u{2192} cargo build"
  },
  {
    name: "clean",
    description: "Clean build artifacts",
    deps: [],
    body: ["@cargo clean"],
    comment: None
  },
  {
    name: "testgen",
    description: "Regenerate tests from DAG structures and MockSpecs",
    deps: ["lint-upsert"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-testgen"],
    comment: None
  },
  {
    name: "testgen-check",
    description: "Check if generated tests are stale",
    deps: ["lint-upsert"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-testgen"],
    comment: None
  },
  {
    name: "deps-config",
    description: "Ensure deps.toml matches canonical generated configuration",
    deps: ["build-release-bins"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-deps -q --release"],
    comment: None
  },
  {
    name: "deps-config-check",
    description: "Check if deps.toml is stale",
    deps: ["build-release-bins"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-deps -q --release -- --dry-run"],
    comment: None
  },
  {
    name: "makegen-check",
    description: "Check if generated Makefile is stale",
    deps: ["lint-upsert"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-makegen"],
    comment: None
  },
  {
    name: "bootstrap-check",
    description: "Check if generated bootstrap artifacts are stale",
    deps: ["lint-upsert"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-bootstrap"],
    comment: None
  },
  {
    name: "pragma-check",
    description: "Check if pragma artifacts are stale",
    deps: ["lint-upsert"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-pragma"],
    comment: None
  },
  {
    name: "verify",
    description: "Verify generated artifacts match their generators",
    deps: ["lint-upsert"],
    body: [
      "@$(MAKE) deps-config-check",
      "@$(MAKE) makegen-check",
      "@$(MAKE) bootstrap-check",
      "@$(MAKE) testgen-check",
      "@$(MAKE) pragma-check"
    ],
    comment: None
  },
  {
    name: "verify-fix",
    description: "Ensure generated artifacts are up to date",
    deps: ["lint-upsert"],
    body: [
      "@$(MAKE) deps-config",
      "@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-makegen",
      "@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-bootstrap",
      "@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-testgen",
      "@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-pragma"
    ],
    comment: None
  },
  {
    name: "fmt-fix",
    description: "fmt-fix: apply formatting (alias for fmt)",
    deps: [],
    body: ["@cargo fmt"],
    comment: None
  },
  {
    name: "lint-fix",
    description: "lint-fix: auto-fix lint issues where possible",
    deps: ["pragma"],
    body: ["@cargo clippy --fix --workspace --allow-dirty --allow-staged -- -D warnings"],
    comment: None
  },
  {
    name: "ci",
    description: "Run CI via build DAG (typed units, deterministic keying)",
    deps: ["ensure-codegen"],
    body: ["@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-ci -q --release"],
    comment: None
  },
  {
    name: "test-all",
    description: "Run all tests via cargo test workspace",
    deps: ["ensure-codegen"],
    body: ["@cargo test --workspace"],
    comment: None
  }
]

// ============================================================================
// Meta Targets — resource-based composite operations
// ============================================================================

data meta_targets: List<MetaTargetDef> = [
  {
    name: "test",
    description: "Run tests (<=S)",
    has_check: false,
    has_fix: true,
    command: "@RUSTFLAGS=\"-D warnings\" cargo test",
    check_command: None,
    fix_command: None,
    command_prefix: None,
    resource_needs: [
      { resource: "compiled_code", mode: "ensure" },
      { resource: "verified_artifacts", mode: "ensure" }
    ],
    fix_prerequisites: ["fmt-fix", "lint-fix"]
  },
  {
    name: "test-integration",
    description: "Run integration-focused tests",
    has_check: false,
    has_fix: false,
    command: "@RUSTFLAGS=\"-D warnings\" cargo test integration",
    check_command: None,
    fix_command: None,
    command_prefix: "GUNBC_TEST_MAX_COST=XL",
    resource_needs: [
      { resource: "compiled_code", mode: "ensure" },
      { resource: "verified_artifacts", mode: "ensure" }
    ],
    fix_prerequisites: []
  },
  {
    name: "test-external",
    description: "Run external/live-flow tests",
    has_check: false,
    has_fix: false,
    command: "@RUSTFLAGS=\"-D warnings\" cargo test live_flow",
