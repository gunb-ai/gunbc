// config/build_targets.dag -- Canonical build target declarations.
//
// These data declarations are the source of truth for core workflows,
// meta targets, and resource target mappings. The Makefile renderer
// consumes these to produce the complete Makefile.
//
// Recipe lines use structured RecipeLine records so that the silent
// flag (Make's "@" prefix per §5.2) is typed data, not an embedded
// string prefix.

module config.build_targets

import extdeps.build.targets

// ============================================================================
// Resource Target Mappings — how resources are provided as Make targets
// ============================================================================

data resource_targets: List<ResourceTargetEntry> = [
  { resource: "generated_cli",      ensure_target: "ensure-codegen",  verify_target: "ensure-codegen" },
  { resource: "generated_tests",    ensure_target: "testgen",         verify_target: "testgen-check" },
  { resource: "compiled_code",      ensure_target: "build",           verify_target: "build" },
  { resource: "verified_artifacts", ensure_target: "verify-fix",      verify_target: "verify" },
  { resource: "deps_config",        ensure_target: "deps-config",     verify_target: "deps-config-check" },
  { resource: "gitignore",          ensure_target: "bootstrap",       verify_target: "bootstrap-check" }
]

// ============================================================================
// Core Workflows — orchestration targets with dependency ordering
// ============================================================================

data core_workflows: List<CoreWorkflow> = [
  {
    name: "preflight-fix",
    description: "Preflight: auto-fix rustc warnings before running generators",
    deps: [],
    body: [{ shell: "cargo fix --workspace --all-targets --allow-dirty --allow-staged", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "ensure-codegen",
    description: "Ensure CLI entrypoints exist (bootstrap-safe)",
    deps: [],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-codegen -- codegen", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "build-release-bins",
    description: "Build workspace binaries once for direct tool execution",
    deps: ["ensure-codegen"],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo build --workspace --release --bins", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "lint-upsert",
    description: "Lint upsert: fix if needed, then verify",
    deps: ["ensure-codegen", "preflight-fix"],
    body: [
      { shell: "cargo clippy --all-targets -- -D warnings || (cargo clippy --fix --workspace --allow-dirty --allow-staged -- -D warnings && cargo clippy --all-targets -- -D warnings)", silent: true, ignore_errors: false }
    ],
    comment: None
  },
  {
    name: "codegen",
    description: "Generate CLI entrypoints (DAG upsert)",
    deps: ["lint-upsert"],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-codegen-dag", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "build",
    description: "Full build transaction",
    deps: ["codegen", "testgen"],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo build --all-targets", silent: true, ignore_errors: false }],
    comment: "Full build transaction: codegen \u{2192} testgen \u{2192} cargo build"
  },
  {
    name: "clean",
    description: "Clean build artifacts",
    deps: [],
    body: [{ shell: "cargo clean", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "testgen",
    description: "Regenerate tests from DAG structures and MockSpecs",
    deps: ["lint-upsert"],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-testgen", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "testgen-check",
    description: "Check if generated tests are stale",
    deps: ["lint-upsert"],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-testgen", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "deps-config",
    description: "Ensure deps.toml matches canonical generated configuration",
    deps: ["build-release-bins"],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-deps -q --release", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "deps-config-check",
    description: "Check if deps.toml is stale",
    deps: ["build-release-bins"],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-deps -q --release -- --dry-run", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "bootstrap-check",
    description: "Check if generated bootstrap artifacts are stale",
    deps: ["lint-upsert"],
    body: [{ shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-bootstrap", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "verify",
    description: "Verify generated artifacts match their generators",
    deps: ["lint-upsert"],
    body: [
      { shell: "$(MAKE) deps-config-check", silent: true, ignore_errors: false },
      { shell: "$(MAKE) bootstrap-check", silent: true, ignore_errors: false },
      { shell: "$(MAKE) testgen-check", silent: true, ignore_errors: false }
    ],
    comment: None
  },
  {
    name: "verify-fix",
    description: "Ensure generated artifacts are up to date",
    deps: ["lint-upsert"],
    body: [
      { shell: "$(MAKE) deps-config", silent: true, ignore_errors: false },
      { shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-bootstrap", silent: true, ignore_errors: false },
      { shell: "RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-testgen", silent: true, ignore_errors: false }
    ],
    comment: None
  },
  {
    name: "fmt-fix",
    description: "fmt-fix: apply formatting (alias for fmt)",
    deps: [],
    body: [{ shell: "cargo fmt", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "lint-fix",
    description: "lint-fix: auto-fix lint issues where possible",
    deps: [],
    body: [{ shell: "cargo clippy --fix --workspace --allow-dirty --allow-staged -- -D warnings", silent: true, ignore_errors: false }],
    comment: None
  },
  {
    name: "test-all",
    description: "Alias for test-xl (full Fermi budget)",
    deps: ["ensure-codegen"],
    body: [{ shell: "$(MAKE) test-xl", silent: true, ignore_errors: false }],
    comment: None
  }
]

