    fix_command: None,
    command_prefix: "GUNBC_TEST_MAX_COST=XL",
    resource_needs: [
      { resource: "compiled_code", mode: "ensure" },
      { resource: "verified_artifacts", mode: "ensure" }
    ],
    fix_prerequisites: []
  },
  {
    name: "check",
    description: "Type check all targets",
    has_check: false,
    has_fix: true,
    command: "@RUSTFLAGS=\"-D warnings\" cargo check --all-targets",
    check_command: None,
    fix_command: None,
    command_prefix: None,
    resource_needs: [
      { resource: "generated_cli", mode: "ensure" },
      { resource: "pragma_config", mode: "verify" }
    ],
    fix_prerequisites: ["fmt-fix"]
  },
  {
    name: "clippy",
    description: "Run clippy linter",
    has_check: false,
    has_fix: true,
    command: "@cargo clippy --all-targets -- -D warnings",
    check_command: None,
    fix_command: "@cargo clippy --fix --workspace --allow-dirty --allow-staged -- -D warnings",
    command_prefix: None,
    resource_needs: [
      { resource: "generated_cli", mode: "ensure" },
      { resource: "pragma_config", mode: "verify" }
    ],
    fix_prerequisites: []
  },
  {
    name: "fmt",
    description: "Format all code",
    has_check: true,
    has_fix: false,
    command: "@cargo fmt",
    check_command: "@cargo fmt --check",
    fix_command: None,
    command_prefix: None,
    resource_needs: [],
    fix_prerequisites: []
  },
  {
    name: "ci-yaml",
    description: "Generate CI workflow YAML (GitHub Actions & GitLab CI)",
    has_check: false,
    has_fix: false,
    command: "@RUSTFLAGS=\"-D warnings\" cargo run -p gunbc-app --bin gunbc-codegen -- cigen",
    check_command: None,
    fix_command: None,
    command_prefix: None,
    resource_needs: [],
    fix_prerequisites: []
  }
]
