// config/workflow_catalog.dag -- Canonical workflow variant registry.
//
// This is the source of truth for workflow aliases, backing DSL files,
// pipeline names, mode gates, and planner namespaces.

module config.workflow_catalog

type WorkflowVariantDef {
  canonical_name: String,
  aliases: List<String>,
  file: String,
  pipeline: String,
  mode: String?,
  namespace: String,
  is_tool: Bool
}

