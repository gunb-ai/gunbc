// Default claims for well-known stages whose resource usage is known
// structurally but not yet expressible in DSL stage bodies.
data default_stage_claims: List<StageDefaultClaims> = [
  {
    stage_name: "build_compile",
    claims: [
      { claim_id: "file:target", access_mode: "Write" },
      { claim_id: "tool:cargo", access_mode: "Read" }
    ]
  },
  {
    stage_name: "test_run",
    claims: [
      { claim_id: "file:target", access_mode: "Read" },
      { claim_id: "tool:cargo", access_mode: "Read" }
    ]
  },
  {
    stage_name: "clippy_run",
    claims: [
      { claim_id: "file:target", access_mode: "Read" },
      { claim_id: "tool:cargo", access_mode: "Read" }
    ]
  }
]
