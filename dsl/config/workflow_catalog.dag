// config/workflow_catalog.dag -- Workflow variant and default claim catalog.
//
// Replaces hardcoded Rust tables in `gunbc-dag/src/workflow/catalog.rs`.

module config.workflow_catalog

type WorkflowVariant {
  canonical_name: String
  aliases: List<String>
  file: String
  pipeline: String
  mode: String?
  namespace: String
  is_tool: Bool
}

type StageClaim {
  claim_id: String
  access_mode: String
}

type StageDefaultClaims {
  stage_name: String
  claims: List<StageClaim>
}

data workflow_variants: List<WorkflowVariant> = [
