// config/gitignore_categories.dag -- Static gitignore policy categories (Phase 7).

module config.gitignore_categories

type GitignoreCategory {
  name: String
  source: String
  items: List<String>
  rationale: String
}

data gitignore_categories: List<GitignoreCategory> = [
  GitignoreCategory {
    name: "Cargo build artifacts",
    source: "cargo",
    items: ["/target/", "/target-codex/"],
    rationale: "Reproducible from source via cargo build"
  },
  GitignoreCategory {
    name: "Cargo cache (local CARGO_HOME)",
    source: "tool/rust",
    items: ["/.cargo-home/"],
    rationale: "Local Cargo cache may include git checkouts; not project state"
  },
  GitignoreCategory {
    name: "Codegen bin symlink",
    source: "codegen",
    items: ["/bin/"],
    rationale: "Symlink to target/release created by codegen"
  },
  GitignoreCategory {
    name: "Coverage reports",
    source: "cargo-tarpaulin",
    items: ["tarpaulin-report.html", "tarpaulin-report.json", "cobertura.xml", "lcov.info", "coverage/"],
    rationale: "Generated, often large, reproducible"
  },
  GitignoreCategory {
    name: "Editor/IDE state",
    source: "editor",
    items: [".idea/", ".vscode/", "*.swp", "*.swo", "*~"],
    rationale: "Per-developer configuration, not project state"
  },
  GitignoreCategory {
    name: "OS metadata",
    source: "os",
    items: [".DS_Store", "Thumbs.db"],
    rationale: "OS-generated, not project state"
  },
  GitignoreCategory {
    name: "Secrets and local config",
    source: "secrets",
    items: [".env", ".env.local", ".env.*.local"],
    rationale: "Environment-specific, may contain secrets"
  },
  GitignoreCategory {
    name: "Generator stamp files",
    source: "generators",
    items: [".*-stamp"],
    rationale: "Producer-centric model stamps; regenerated by make targets"
  },
  GitignoreCategory {
    name: "bootstrap outputs",
    source: "bootstrap",
    items: ["/.gitignore", "/Makefile"],
    rationale: "Generated by bootstrap; not source-of-truth"
  },
  GitignoreCategory {
    name: "codegen outputs",
    source: "codegen",
    items: ["/target/codegen/.stamp"],
    rationale: "Generated by codegen; not source-of-truth"
  },
  GitignoreCategory {
    name: "codegen-ensure outputs",
    source: "codegen-ensure",
    items: ["/target/codegen/.stamp"],
    rationale: "Generated by codegen-ensure; not source-of-truth"
  },
  GitignoreCategory {
    name: "deps outputs",
    source: "deps",
    items: ["/deps.toml"],
    rationale: "Generated by deps; not source-of-truth"
  },
  GitignoreCategory {
    name: "deps-generate outputs",
    source: "deps-generate",
    items: ["/deps.toml"],
    rationale: "Generated by deps-generate; not source-of-truth"
  },
  GitignoreCategory {
    name: "docgen outputs",
    source: "docgen",
    items: ["/docs/ab-writing-workflows.md"],
    rationale: "Generated by docgen; not source-of-truth"
  },
  GitignoreCategory {
    name: "makegen outputs",
    source: "makegen",
    items: ["/Makefile"],
    rationale: "Generated by makegen; not source-of-truth"
  },
  GitignoreCategory {
    name: "pragma outputs",
    source: "pragma",
    items: ["/clippy.toml", "/tools/disallowed-methods-allowlist.txt", "/tools/pragma-lint-policy.txt"],
    rationale: "Generated by pragma; not source-of-truth"
  },
  GitignoreCategory {
    name: "testgen outputs",
    source: "testgen",
    items: ["**/generated_tests*.rs"],
    rationale: "Generated by testgen; not source-of-truth"
  },
  GitignoreCategory {
    name: "Workflow runtime state",
    source: "workflow",
    items: ["/.gunbc/"],
    rationale: "Local execution ledger and config; not source-of-truth"
  }
]
