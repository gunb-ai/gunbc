// config/clippy_disallowed.dag -- Disallowed methods and types for clippy.toml.
//
// Static data: every method/type that clippy.toml must disallow.
// Grouped by category with section comments for the TOML output.
//
// Single source of truth for clippy.toml content. The derive_clippy_toml()
// function in clippy_policy.dag renders this data into clippy.toml format.

module config.clippy_disallowed

import extdeps.clippy { DisallowedMethodEntry, DisallowedTypeEntry }

// ── Grouped disallowed methods ──────────────────────────────────────

type DisallowedMethodGroup {
  comments: List<String>
  entries: List<DisallowedMethodEntry>
}

type DisallowedTypeGroup {
  comments: List<String>
  entries: List<DisallowedTypeEntry>
}

data disallowed_method_groups: List<DisallowedMethodGroup> = [
  {
    comments: ["Filesystem operations - use PrepareFileReadOp/PrepareFileWriteOp instead"],
