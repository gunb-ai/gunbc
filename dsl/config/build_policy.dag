// config/build_policy.dag -- Repo-wide Rust build policy.
//
// Source of truth for how the Rust compiler treats diagnostics.
// cargo_compile_env is the projection of warning_policy to env vars.
// BuildConfig::cargo() mirrors this; a contract test ensures agreement.

module config.build_policy

data warning_policy: WarningPolicy = DenyAll

data cargo_compile_env: Map<String, String> = { "RUSTFLAGS": "-D warnings" }

data clippy_deny_args: List<String> = ["-D", "warnings"]
