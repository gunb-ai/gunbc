// config/workspace.dag -- Workspace crate declarations.
//
// Single source of truth for the gunbc workspace structure. Each crate
// is declared with its path, crate name, and layer classification.
// A CI drift test verifies this data matches the actual Cargo.toml.

module config.workspace

// ── Types ──────────────────────────────────────────────────────────────

type CrateLayer = Core | Compiler | Library | Tool | Repo

type CrateSpec {
  path: String
  name: String
  layer: CrateLayer
}

// ── Workspace members ──────────────────────────────────────────────────

data workspace_crates: List<CrateSpec> = [
  // Core crates (handwritten foundation)
  { path: "src/core/infra",                     name: "gunbc-infra",                  layer: Core },
  { path: "src/core/ir",                        name: "gunbc-ir",                     layer: Core },
  { path: "src/core/exec",                      name: "gunbc-exec",                   layer: Core },
  { path: "src/core/resolve",                   name: "gunbc-resolve",                layer: Core },
  { path: "src/core/workflow",                  name: "gunbc-workflow",               layer: Core },
  { path: "src/core/cli",                       name: "gunbc-cli",                    layer: Core },
  { path: "src/core/codegen",                   name: "gunbc-codegen",                layer: Core },
  { path: "src/core/test",                      name: "gunbc-test",                   layer: Core },
  { path: "src/core/testgen-registry",          name: "gunbc-testgen-registry",       layer: Core },
  { path: "src/core/testgen-registry-macros",   name: "gunbc-testgen-registry-macros", layer: Core },
  { path: "src/core/delegate-macros",           name: "gunbc-delegate-macros",        layer: Core },
  // DSL compiler (daglang)
  { path: "src/core/daglang/daglang-syntax",    name: "daglang-syntax",              layer: Compiler },
  { path: "src/core/daglang/daglang-contract",  name: "daglang-contract",            layer: Compiler },
  { path: "src/core/daglang/daglang-resolve",   name: "daglang-resolve",             layer: Compiler },
  { path: "src/core/daglang/daglang-typecheck", name: "daglang-typecheck",           layer: Compiler },
  { path: "src/core/daglang/daglang-lower",     name: "daglang-lower",               layer: Compiler },
  { path: "src/core/daglang/daglang-derive",    name: "daglang-derive",              layer: Compiler },
  { path: "src/core/daglang/daglang-emit",      name: "daglang-emit",                layer: Compiler },
  { path: "src/core/daglang/daglang-driver",    name: "daglang-driver",              layer: Compiler },
  { path: "src/core/daglang/daglang-cli",       name: "daglang-cli",                 layer: Compiler },
  // Library crates (moved from src/lib/ into core/)
  { path: "src/core/primitives",                name: "gunbc-primitives",             layer: Library },
  { path: "src/core/blob",                      name: "gunbc-lib-blob",              layer: Library },
  { path: "src/core/transport",                 name: "gunbc-lib-transport",         layer: Library },
  // Repo-specific configuration (gunbc's own DAGs)
  { path: "src/gunbc-app",                      name: "gunbc-app",                   layer: Repo }
]
