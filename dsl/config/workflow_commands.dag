// config/workflow_commands.dag -- Workflow execution command catalog.
//
// Each entry maps workflow unit node IDs to shell commands used by the
// workflow executor when running plans.

module config.workflow_commands

type UnitCommandDef {
  node_id: String,
  label: String,
  program: String,
  args: List<String>
}

type WorkflowCommandSet {
  workflow: String,
  commands: List<UnitCommandDef>
}

