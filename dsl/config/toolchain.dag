// config/toolchain.dag -- Pinned Rust toolchain version.
//
// Single source of truth for the Rust version used across CI and local
// development. Flows to:
//   - CI YAML generation (tools/cigen.dag → GitHub Actions / GitLab CI)
//   - rust-toolchain.toml (tools/bootstrap.dag)
//
// When upgrading Rust:
//   1. Update `rust_version` here
//   2. Run `make codegen` to regenerate CI and rust-toolchain.toml
//   3. Run `rustup update` locally

module config.toolchain

// ── Pinned version ──────────────────────────────────────────────────

data rust_version: String = "1.93.0"

data rust_edition: String = "2021"

// ── Derived: CI action reference ────────────────────────────────────

data rust_toolchain_action: String = "dtolnay/rust-toolchain@stable"

// ── Derived: rust-toolchain.toml content ────────────────────────────

fn rust_toolchain_toml() -> String {
  "# Generated by gunbc-codegen. Do not edit manually.\n# Source of truth: dsl/config/toolchain.dag\n[toolchain]\nchannel = \"{rust_version}\"\ncomponents = [\"clippy\", \"rustfmt\"]\n"
}
