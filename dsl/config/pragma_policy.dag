data dead_code_policy_rules: List<String> = [
  "allow_generated",
  "allow_tests",
  "allow_binaries",
  "allow_examples",
  "allow_benchmarks"
]

data allow_lints: List<String> = [
  "clippy::module_name_repetitions",
  "clippy::missing_errors_doc",
  "clippy::missing_panics_doc"
]
