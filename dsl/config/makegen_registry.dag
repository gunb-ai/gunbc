// config/makegen_registry.dag -- Makefile model for DSL-native makegen.
//
// This is the single source of truth for Makefile targets and help text.
// The makegen tool renders this model into the Makefile.

module config.makegen_registry

type EntrypointParam {
  port_name: String
  make_var: String
  type_hint: String
  default: String?
  repeatable: Bool
}

type MakeTarget {
  name: String
  description: String
  deps: List<String>
  commands: List<String>
  comment: String?
}

type ToolTarget {
  name: String
  make_target: String?
  description: String
  entrypoints: List<EntrypointParam>
}

type MakegenRegistry {
  core_targets: List<MakeTarget>
  meta_targets: List<MakeTarget>
  tool_targets: List<ToolTarget>
}

