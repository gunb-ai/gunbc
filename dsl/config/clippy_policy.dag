// config/clippy_policy.dag -- Clippy enforcement policy (derived).
//
// Composes: extdeps/clippy.dag (what clippy can configure)
//         + config/arch_rules.dag (our invariants + exemptions)
//         → concrete clippy.toml content, allowlist, lint policy.
//
// Phase 1: extern funcs in extern_impls.rs do the derivation in Rust.
// Phase 2: pure DSL when lowerer supports multi-source filter/map.

module config.clippy_policy

import extdeps.clippy {
  ClippySpec,
  DisallowedMethodEntry,
  DisallowedTypeEntry,
  ClippyTomlConfig,
  spec
}

import config.arch_rules {
  BoundaryRule,
  Exemption,
  DeadCodeAllowance,
  boundary_rules,
  exemptions,
  dead_code_allowances,
  pragma_allow_lints,
  large_error_threshold
}

// ── Derivation output types ─────────────────────────────────────────

type AllowlistEntry {
  pattern: String
  rationale: String
}

type LintPolicyOutput {
  allow_dead_code: List<String>
  allow_lints: List<String>
}

// ── Phase 1 shadow fns ──────────────────────────────────────────────
// Overridden by extern impls at resolve time.
// Rust reads arch_rules data via default_*() functions (Phase 1).
// Phase 2: DSL data declarations flow into these as arguments.

fn derive_clippy_toml() -> String {
  ""
}

fn derive_disallowed_methods_allowlist() -> String {
  ""
}

fn derive_pragma_lint_policy() -> String {
  ""
}
