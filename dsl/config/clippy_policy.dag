// config/clippy_policy.dag -- Clippy config data (Phase 6).

module config.clippy_policy

type DisallowedMethod {
  path: String
  reason: String
}

type DisallowedType {
  path: String
  reason: String
}

type CrateAllowance {
  crate_name: String
  reason: String
}

type ClippyConfig {
  disallowed_methods: List<DisallowedMethod>
  disallowed_types: List<DisallowedType>
  crate_allowances: List<CrateAllowance>
  large_error_threshold: Int?
}

data crate_allowances: List<CrateAllowance> = [
  CrateAllowance { crate_name: "gunbc-lib-transport", reason: "IS the I/O boundary - the designated place for I/O" },
]

