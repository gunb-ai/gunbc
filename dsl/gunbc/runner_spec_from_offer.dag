module gunbc.runner_spec_from_offer

import extdeps.github.actions { RunnerSpec, SelfHosted, RunsOnExpression }
import gunbc.ci_fleet { ComputeOffer, gunbc_ci_fleet_offer }
import gunbc.fleet_intent { compute_host_primary_cpu }
import extdeps.cpu { cpu_facts_architecture }
import extdeps.toolchain.types { Architecture }
import std.os.types { KernelFamily }

fn kernel_runner_label(kernel: KernelFamily) -> String {
  match kernel {
    Linux => "linux"
    Darwin => "macos"
    WindowsNt => "windows"
    LinuxGuestOnWindows => "linux"
  }
}

fn cpu_architecture_runner_label(arch: Architecture) -> String {
  match arch {
    Aarch64 => "arm64"
    X86_64 => "x64"
    X86 => "x86"
    Arm => "arm"
    Armv7 => "arm"
    Riscv64 => "riscv64"
    Wasm32 => "wasm32"
    Mips => "mips"
    Mipsel => "mipsel"
    Mips64 => "mips64"
    Mips64el => "mips64el"
  }
}

fn runner_spec_from_offer(offer: ComputeOffer) -> RunnerSpec {
  let os = offer.supply.execution.os
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      SelfHosted { labels: concat(["self-hosted"], [kernel_runner_label(kernel: os.kernel)]) }
    Present { value: cpu } =>
      SelfHosted {
        labels: concat(
          concat(["self-hosted"], [kernel_runner_label(kernel: os.kernel)]),
          [cpu_architecture_runner_label(arch: cpu_facts_architecture(cpu: cpu))],
        ),
      }
  }
}

data gunbc_ci_ubicloud_runner_label: String = "ubicloud-standard-16-arm"

fn gunbc_ci_runner_spec() -> RunnerSpec {
  RunsOnExpression { expression: gunbc_ci_ubicloud_runner_label }
}
