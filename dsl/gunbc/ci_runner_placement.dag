type RunnerHostDeployment {
  identity: HostIdentity
  runner_count: Int
  per_runner_memory_cap: ByteSize
  build_tokens: HardwareThreadCount
  runner: RunnerSpec
}

type RunnerDeploymentPlan
  = PlanDerived { hosts: List<RunnerHostDeployment>, fleet_concurrent_runs: Int }
  | PlanUnsound { reason: String }

data gunbc_ci_runner_slot_enforcement_marker: String = "RunnerSlotEnforcement is the §5 LIVE-enforcement gate distinct from model soundness: fleet_host_plan can be model-sound (all inputs cited) yet the live runner-slice MemoryMax drop-in stays INERT (effective MemoryMax=INFINITY, see gunbc_fleet_runner_slice_dropin_marker). Deriving a governing runner count while the conserving runner_slice_cap is unenforced live would over-commit runners against the sessions/sccache pool the cap reserves. Committed RunnerSlotUnenforced (fail closed). Flips to RunnerSlotEnforced ONLY when ctrl runner_host_reconcile makes disk==live (runner_slice_cap_drifted == false) and the design authority signs off — never to make a test go green."

type RunnerSlotEnforcement
  = RunnerSlotEnforced
  | RunnerSlotUnenforced { reason: String }

data gunbc_ci_runner_slot_enforcement: RunnerSlotEnforcement = RunnerSlotUnenforced {
  reason: "runner-slot conserving cap not enforced live: the runner-slice MemoryMax drop-in is inert (effective MemoryMax=INFINITY); refuse to derive a governing runner count that assumes a cap the host does not enforce (fail closed until ctrl runner_host_reconcile makes disk==live and the design authority flips it)"
}

type JobPeakResolution
  = JobPeaksResolved { run_unit_peak: ByteSize }
  | JobPeaksUnresolved { reason: String }

type PeakFold {
  max_peak: ByteSize
  any_unmeasured: Bool
  count: Int
}

type DeploymentAccumulator {
  deployments: List<RunnerHostDeployment>
  unsound_reason: String
  any_unfit: Bool
  total: Int
}

fn fold_job_peak(acc: PeakFold, job_peak: CiJobPeak) -> PeakFold {
  match job_peak.peak {
    JobCgroupPeakUnmeasured =>
      PeakFold { max_peak: acc.max_peak, any_unmeasured: true, count: acc.count + 1 }
    JobCgroupPeakMeasured { cgroup_peak: p } =>
      PeakFold {
        max_peak: measure_max(a: acc.max_peak, b: p),
        any_unmeasured: acc.any_unmeasured,
        count: acc.count + 1,
      }
  }
}

fn resolve_run_unit_peak(job_peaks: List<CiJobPeak>) -> JobPeakResolution {
  let folded = fold(
    job_peaks,
    init: PeakFold { max_peak: byte_size(0), any_unmeasured: false, count: 0 },
    f: (a, j) => fold_job_peak(acc: a, job_peak: j)
  )
  if folded.count == 0 {
    JobPeaksUnresolved {
      reason: "no CI jobs declared: cannot derive runner capacity without a per-job peak"
    }
  } else if folded.any_unmeasured {
    JobPeaksUnresolved {
      reason: "at least one CI job has an unmeasured cgroup whole-tree peak: refuse to derive runner capacity on a missing per-job measurement (self-RSS undercounts child rustc/sccache, an over-commit risk)"
    }
  } else if byte_size_count(b: folded.max_peak) == 0 {
    JobPeaksUnresolved {
      reason: "measured per-job peak is zero bytes: refuse to divide host RAM by a zero peak"
    }
  } else {
    JobPeaksResolved { run_unit_peak: folded.max_peak }
  }
}

type SessionSliceResolution
  = SessionSliceResolved { bytes: ByteSize, per_session_cap: ByteSize, concurrency: Int }
  | SessionSliceUnresolved { reason: String }

fn resolve_regime1_slice(c: ByteSize, n: Int) -> SessionSliceResolution {
  if byte_size_count(b: c) == 0 {
    SessionSliceUnresolved { reason: "per-session cap is zero bytes: refuse a degenerate sessions-slice" }
  } else if n <= 0 {
    SessionSliceUnresolved { reason: "session concurrency is non-positive: refuse a degenerate sessions-slice" }
  } else {
    SessionSliceResolved {
      bytes: measure_scale_fraction_floor(m: c, num: n, den: 1),
      per_session_cap: c,
      concurrency: n,
    }
  }
}

fn resolve_session_slice(mode: SessionReservationMode) -> SessionSliceResolution {
  match mode {
    SessionReservationModeUnset =>
      SessionSliceUnresolved {
        reason: "session reservation mode unset: the per-session budget is an operator operating-point choice (REGIME-1 worst-case cap C * concurrency N, or REGIME-2 measured aggregate with C as the oomd eviction ceiling) grounded in the measured distribution (min 0.28 / median ~2.06 / max 8.27 GiB); refuse to derive the host sessions-slice (and therefore the conserving runner count) until gunbc_ci_session_reservation_mode is set. See the operating curve in the manifest."
      }
    Regime1WorstCase { point: p } =>
      match p {
        SessionOperatingPointUnset =>
          SessionSliceUnresolved { reason: "REGIME-1 operating point unset: refuse to derive a worst-case sessions-slice without a (cap, concurrency) pair" }
        SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } =>
          resolve_regime1_slice(c: c, n: n)
      }
    Regime2AggregateOomd { oomd_eviction_ceiling: ceiling, session_concurrency: n, aggregate_reservation: agg, oomd_enforcement: oomd } =>
      match oomd {
        OomdUnverified =>
          SessionSliceUnresolved { reason: "REGIME-2 keystone unmet: it over-commits the per-session caps, so it is unsound until per-cgroup memory.max + systemd-oomd eviction is verified live on the hosts (oomd_enforcement = OomdUnverified). Fail closed; do NOT reserve the smaller aggregate without the runtime eviction floor." }
        OomdEnforced =>
          match agg {
            SessionAggregateUnmeasured =>
              SessionSliceUnresolved { reason: "REGIME-2 aggregate-concurrent-peak series unmeasured: refuse to derive the aggregate sessions-slice without a measured realistic concurrent peak (the 13 per-session samples are NOT an aggregate). Fail closed." }
            SessionAggregateMeasured { bytes: agg_bytes } =>
              if byte_size_count(b: agg_bytes) == 0 {
                SessionSliceUnresolved { reason: "REGIME-2 measured aggregate is zero bytes: refuse a degenerate sessions-slice" }
              } else if byte_size_count(b: ceiling) == 0 {
                SessionSliceUnresolved { reason: "REGIME-2 oomd eviction ceiling is zero bytes: refuse a degenerate per-session ceiling" }
              } else if n <= 0 {
                SessionSliceUnresolved { reason: "REGIME-2 session concurrency is non-positive: refuse a degenerate admitted-session target" }
              } else {
                SessionSliceResolved {
                  bytes: agg_bytes,
                  per_session_cap: ceiling,
                  concurrency: n,
                }
              }
          }
      }
  }
}

data gunbc_ci_runner_count_from_budget_marker: String = "the runner-slot count now divides the CONSERVING fleet_host_budget.runner_slice_cap (host - overhead - per-type idle baselines - sccache_build_pool - oomd headroom), NOT the old host - overhead - session_slice. That dissolves the §3 fork: the runner slice had two homes (this module's host_runner_slice and fleet_host_budget's runner_slice_cap) that decomposed host RAM differently; runner_slice_cap is the single authority and this module is its count CONSUMER. Sessions reserve the idle session_baseline + share the sccache pool inside the budget, so the runner count is INDEPENDENT of the session operating point (REGIME-1/2 cap*concurrency now drives only the dashboard session reservation, not runner capacity). ci_budget_tree.runner_pool_bytes_at remains a parallel non-conserving slice (separate memory-budget-tree consumer) — its convergence onto runner_slice_cap is the named follow-up, out of this PR's scope."

fn host_runner_count_from_cap(runner_slice_cap: ByteSize, run_unit_peak: ByteSize, cpu_cap: HardwareThreadCount) -> Int {
  let mem_count = measure_fit_count_floor(capacity: runner_slice_cap, each: run_unit_peak)
  if mem_count <= 0 {
    0
  } else {
    hardware_thread_count_value(t: bounded_host_spawn_width(shard_count: mem_count, hardware_threads: cpu_cap))
  }
}

fn host_deployment_from_plan(offer: ComputeOffer, cap: ByteSize, tokens: HardwareThreadCount, cpu_cap: HardwareThreadCount, run_unit_peak: ByteSize) -> RunnerHostDeployment {
  let count = host_runner_count_from_cap(runner_slice_cap: cap, run_unit_peak: run_unit_peak, cpu_cap: cpu_cap)
  let safe_den = if count > 0 { count } else { 1 }
  RunnerHostDeployment {
    identity: offer.supply.physical.identity,
    runner_count: count,
    per_runner_memory_cap: measure_scale_fraction_floor(m: cap, num: 1, den: safe_den),
    build_tokens: tokens,
    runner: runner_spec_from_offer(offer: offer),
  }
}

fn empty_deployment_accumulator() -> DeploymentAccumulator {
  DeploymentAccumulator { deployments: [], unsound_reason: "", any_unfit: false, total: 0 }
}

fn accumulate_host_deployment(
  acc: DeploymentAccumulator,
  offer: ComputeOffer,
  overhead: ByteSize,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence,
  run_unit_peak: ByteSize
) -> DeploymentAccumulator {
  match fleet_host_plan_for_offer(offer: offer, overhead: overhead, citation: citation, policy: policy, oomd: oomd) {
    FleetHostPlanUnsound { reason: r } =>
      DeploymentAccumulator {
        deployments: acc.deployments,
        unsound_reason: if acc.unsound_reason == "" { r } else { acc.unsound_reason },
        any_unfit: acc.any_unfit,
        total: acc.total,
      }
    FleetHostPlanDerived { name: _, tree: _, runner_slice_cap: cap, effective_build_tokens: tokens, effective_runner_cpu_cap: cpu_cap, build_step: _ } => {
      let dep = host_deployment_from_plan(offer: offer, cap: cap, tokens: tokens, cpu_cap: cpu_cap, run_unit_peak: run_unit_peak)
      DeploymentAccumulator {
        deployments: concat(acc.deployments, [dep]),
        unsound_reason: acc.unsound_reason,
        any_unfit: acc.any_unfit || (dep.runner_count == 0),
        total: acc.total + dep.runner_count,
      }
    }
  }
}

fn derive_plan_with_budget(
  offers: List<ComputeOffer>,
  overhead: ByteSize,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence,
  run_unit_peak: ByteSize
) -> RunnerDeploymentPlan {
  let acc = fold(
    offers,
    init: empty_deployment_accumulator(),
    f: (a, o) => accumulate_host_deployment(acc: a, offer: o, overhead: overhead, citation: citation, policy: policy, oomd: oomd, run_unit_peak: run_unit_peak)
  )
  if acc.unsound_reason != "" {
    PlanUnsound { reason: concat("fleet host budget unsound: ", acc.unsound_reason) }
  } else if acc.any_unfit {
    PlanUnsound {
      reason: "at least one fleet host cannot host a single runner under conservation (runner_slice_cap < one whole-run cgroup peak); raise the host, lower the headroom/sccache reservation, or sharpen the conservative 24GiB per-run peak"
    }
  } else {
    PlanDerived { hosts: acc.deployments, fleet_concurrent_runs: acc.total }
  }
}

fn runner_deployment_plan_for(
  enforcement: RunnerSlotEnforcement,
  job_peaks: List<CiJobPeak>,
  overhead: HostFixedOverhead,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence,
  offers: List<ComputeOffer>
) -> RunnerDeploymentPlan {
  match enforcement {
    RunnerSlotUnenforced { reason: r } => PlanUnsound { reason: r }
    RunnerSlotEnforced =>
      match resolve_run_unit_peak(job_peaks: job_peaks) {
        JobPeaksUnresolved { reason: r } => PlanUnsound { reason: r }
        JobPeaksResolved { run_unit_peak: peak } =>
          match overhead {
            HostFixedOverheadUnmeasured =>
              PlanUnsound {
                reason: "host fixed overhead unmeasured: the sccache server daemon may live in a sibling host cgroup outside every per-job cgroup, so it is counted by no per-job peak; refuse to derive runner capacity until it is classified and reserved exactly once"
              }
            HostFixedOverheadMeasured { bytes: oh } =>
              derive_plan_with_budget(offers: offers, overhead: oh, citation: citation, policy: policy, oomd: oomd, run_unit_peak: peak)
          }
      }
  }
}

fn runner_deployment_plan() -> RunnerDeploymentPlan {
  runner_deployment_plan_for(
    enforcement: gunbc_ci_runner_slot_enforcement,
    job_peaks: gunbc_ci_job_peaks,
    overhead: gunbc_ci_host_fixed_overhead,
    citation: ctrl_jobserver_config,
    policy: gunbc_fleet_headroom_policy,
    oomd: gunbc_fleet_oomd_evidence,
    offers: fleet_intent_offers
  )
}

type RunnersPerHostResolution
  = RunnersPerHostDerived { count: Int }
  | RunnersPerHostUnsound { reason: String }

fn effective_runners_per_host() -> RunnersPerHostResolution {
  match runner_deployment_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      RunnersPerHostDerived { count: fold(hosts, init: 0, f: (acc, h) => if h.runner_count > acc { h.runner_count } else { acc }) }
    PlanUnsound { reason: r } => RunnersPerHostUnsound { reason: r }
  }
}

type SessionHostReservation {
  identity: HostIdentity
  session_count: Int
  per_session_reservation: ByteSize
}

type SessionReservationPlan
  = SessionReservationDerived {
      hosts: List<SessionHostReservation>,
      fleet_concurrent_sessions: Int,
      per_session_reservation: ByteSize,
      coverage_count: Int,
      sample_count: Int
    }
  | SessionReservationUnsound { reason: String }

fn samples_covered(cap: ByteSize) -> Int {
  fold(gunbc_ci_per_session_peak_samples, init: 0, f: (acc, s) => if measure_le(a: s, b: cap) { acc + 1 } else { acc })
}

fn session_reservation_plan() -> SessionReservationPlan {
  match resolve_session_slice(mode: gunbc_ci_session_reservation_mode) {
    SessionSliceUnresolved { reason: r } => SessionReservationUnsound { reason: r }
    SessionSliceResolved { bytes: _, per_session_cap: c, concurrency: n } =>
      SessionReservationDerived {
        hosts: map(fleet_intent_offers, o => SessionHostReservation {
          identity: o.supply.physical.identity,
          session_count: n,
          per_session_reservation: c,
        }),
        fleet_concurrent_sessions: n * fleet_intent_offers.length(),
        per_session_reservation: c,
        coverage_count: samples_covered(cap: c),
        sample_count: gunbc_ci_per_session_peak_samples.length(),
      }
  }
}

data gunbc_ci_count_field_measure_followup: String = "dissolve-on feature:M12-cardinal-count-value-measure-sweep -- the M12 / Practice-13 value-Measure sweep for cardinal COUNT fields. The runner/session counts here (OperatingPointRow.session_concurrency, .coverage_count, .sample_count; RunnerHostDeployment.runner_count; SessionHostReservation.session_count; SessionReservationDerived.fleet_concurrent_sessions) are flat Int -- cardinals per DESIGN sec 2, identical in kind to the codebase-wide bare-Int count convention (rank_count, contact_count, processor_count, lane_count, stick_count, approval_count, ...) and to the unit_modeling lens's own cardinal exemptions (index/ordinal/position). The lens is an ADVISORY region-3 RatchetForever (not floor-enrolled, does not gate CI). Disposition for the whole cluster: convert together to a count-Measure carrier (HardwareThreadCount-style) in one M12 sweep so the unit modeling stays single-authority -- do NOT peel one field here (the forked-logic trap)."

data gunbc_ci_operating_curve_session_only_marker: String = "the operating curve is now a SESSION-side coverage tradeoff only (per_session_cap -> measured-peak coverage, with sessions_slice = cap*concurrency). It NO LONGER carries a runner count: once the runner count divides the conserving runner_slice_cap (gunbc_ci_runner_count_from_budget_marker), it is independent of the session operating point, so a per-row min_runner_count column would be a constant masquerading as a tradeoff. The single budget-derived per-host runner count is reported by runner_deployment_plan / the consumable manifest, not swept here."

type OperatingPointRow {
  per_session_cap: ByteSize
  session_concurrency: Int
  sessions_slice: ByteSize
  coverage_count: Int
  sample_count: Int
}

fn evaluate_operating_point(cap: ByteSize, n: Int) -> OperatingPointRow {
  let slice = match resolve_session_slice(mode: Regime1WorstCase { point: SessionOperatingPointSet { per_session_cap: cap, session_concurrency: n } }) {
    SessionSliceResolved { bytes: b, per_session_cap: _, concurrency: _ } => b
    SessionSliceUnresolved { reason: _ } => byte_size(0)
  }
  OperatingPointRow {
    per_session_cap: cap,
    session_concurrency: n,
    sessions_slice: slice,
    coverage_count: samples_covered(cap: cap),
    sample_count: gunbc_ci_per_session_peak_samples.length(),
  }
}

data gunbc_ci_session_operating_curve_candidates: List<SessionOperatingPoint> = [
  SessionOperatingPointSet { per_session_cap: byte_size(2211908157), session_concurrency: 16 },
  SessionOperatingPointSet { per_session_cap: byte_size(4294967296), session_concurrency: 16 },
  SessionOperatingPointSet { per_session_cap: byte_size(8879844884), session_concurrency: 6 },
  SessionOperatingPointSet { per_session_cap: byte_size(10737418240), session_concurrency: 6 },
  SessionOperatingPointSet { per_session_cap: byte_size(8879844884), session_concurrency: 4 },
]

fn operating_curve() -> List<OperatingPointRow> {
  map(gunbc_ci_session_operating_curve_candidates, op => match op {
    SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } => evaluate_operating_point(cap: c, n: n)
    SessionOperatingPointUnset => evaluate_operating_point(cap: byte_size(0), n: 0)
  })
}
