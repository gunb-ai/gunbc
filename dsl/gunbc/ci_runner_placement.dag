module gunbc.ci_runner_placement

import product.compute_fabric { ComputeOffer, compute_host_ram_bytes_total }
import product.placement_supply { HostIdentity }
import std.realization_width { measure_max, byte_size_saturating_sub }
import std.measure { ByteSize, byte_size, byte_size_count, measure_scale_fraction_floor, measure_fit_count_floor, measure_le }
import std.types { Int, List, String, Bool }
import extdeps.github.actions { RunnerSpec }
import gunbc.runner_spec_from_offer { runner_spec_from_offer }
import gunbc.ci_floor_measurement {
  CiJobPeak,
  JobCgroupPeakMeasurement,
  JobCgroupPeakMeasured,
  JobCgroupPeakUnmeasured,
  HostFixedOverhead,
  HostFixedOverheadMeasured,
  HostFixedOverheadUnmeasured,
  SessionOperatingPoint,
  SessionOperatingPointSet,
  SessionOperatingPointUnset,
  gunbc_ci_job_peaks,
  gunbc_ci_host_fixed_overhead,
  gunbc_ci_per_session_peak_samples,
  gunbc_ci_session_operating_point,
}
import gunbc.fleet_intent { fleet_intent_offers }

type RunnerHostDeployment {
  identity: HostIdentity
  runner_count: Int
  per_runner_memory_cap: ByteSize
  runner: RunnerSpec
}

type RunnerDeploymentPlan
  = PlanDerived { hosts: List<RunnerHostDeployment>, fleet_concurrent_runs: Int }
  | PlanUnsound { reason: String }

type JobPeakResolution
  = JobPeaksResolved { run_unit_peak: ByteSize }
  | JobPeaksUnresolved { reason: String }

type PeakFold {
  max_peak: ByteSize
  any_unmeasured: Bool
  count: Int
}

type DeploymentAccumulator {
  deployments: List<RunnerHostDeployment>
  any_unfit: Bool
  total: Int
}

fn fold_job_peak(acc: PeakFold, job_peak: CiJobPeak) -> PeakFold {
  match job_peak.peak {
    JobCgroupPeakUnmeasured =>
      PeakFold { max_peak: acc.max_peak, any_unmeasured: true, count: acc.count + 1 }
    JobCgroupPeakMeasured { cgroup_peak: p } =>
      PeakFold {
        max_peak: measure_max(a: acc.max_peak, b: p),
        any_unmeasured: acc.any_unmeasured,
        count: acc.count + 1,
      }
  }
}

fn resolve_run_unit_peak(job_peaks: List<CiJobPeak>) -> JobPeakResolution {
  let folded = fold(
    job_peaks,
    init: PeakFold { max_peak: byte_size(0), any_unmeasured: false, count: 0 },
    f: (a, j) => fold_job_peak(acc: a, job_peak: j)
  )
  if folded.count == 0 {
    JobPeaksUnresolved {
      reason: "no CI jobs declared: cannot derive runner capacity without a per-job peak"
    }
  } else if folded.any_unmeasured {
    JobPeaksUnresolved {
      reason: "at least one CI job has an unmeasured cgroup whole-tree peak: refuse to derive runner capacity on a missing per-job measurement (self-RSS undercounts child rustc/sccache, an over-commit risk)"
    }
  } else if byte_size_count(b: folded.max_peak) == 0 {
    JobPeaksUnresolved {
      reason: "measured per-job peak is zero bytes: refuse to divide host RAM by a zero peak"
    }
  } else {
    JobPeaksResolved { run_unit_peak: folded.max_peak }
  }
}

type SessionSliceResolution
  = SessionSliceResolved { bytes: ByteSize, per_session_cap: ByteSize, concurrency: Int }
  | SessionSliceUnresolved { reason: String }

fn resolve_session_slice(op: SessionOperatingPoint) -> SessionSliceResolution {
  match op {
    SessionOperatingPointUnset =>
      SessionSliceUnresolved {
        reason: "session operating point unset: the per-session budget is an operator operating-point choice (per-session cap C vs concurrency N) grounded in the measured distribution (min 0.28 / median ~2.06 / max 8.27 GiB); refuse to derive the host sessions-slice (and therefore the conserving runner count) until gunbc_ci_session_operating_point is set. See the operating curve in the manifest."
      }
    SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } =>
      if byte_size_count(b: c) == 0 {
        SessionSliceUnresolved { reason: "per-session cap is zero bytes: refuse a degenerate sessions-slice" }
      } else if n <= 0 {
        SessionSliceUnresolved { reason: "session concurrency is non-positive: refuse a degenerate sessions-slice" }
      } else {
        SessionSliceResolved {
          bytes: measure_scale_fraction_floor(m: c, num: n, den: 1),
          per_session_cap: c,
          concurrency: n,
        }
      }
  }
}

fn host_allocatable(offer: ComputeOffer, overhead: ByteSize) -> ByteSize {
  byte_size_saturating_sub(
    total: compute_host_ram_bytes_total(host: offer.supply.physical),
    reserved: overhead
  )
}

fn host_runner_slice(offer: ComputeOffer, overhead: ByteSize, session_slice: ByteSize) -> ByteSize {
  byte_size_saturating_sub(total: host_allocatable(offer: offer, overhead: overhead), reserved: session_slice)
}

fn host_runner_count(offer: ComputeOffer, overhead: ByteSize, session_slice: ByteSize, run_unit_peak: ByteSize) -> Int {
  measure_fit_count_floor(
    capacity: host_runner_slice(offer: offer, overhead: overhead, session_slice: session_slice),
    each: run_unit_peak
  )
}

fn host_deployment(offer: ComputeOffer, overhead: ByteSize, session_slice: ByteSize, count: Int) -> RunnerHostDeployment {
  let runner_slice = host_runner_slice(offer: offer, overhead: overhead, session_slice: session_slice)
  let safe_den = if count > 0 { count } else { 1 }
  RunnerHostDeployment {
    identity: offer.supply.physical.identity,
    runner_count: count,
    per_runner_memory_cap: measure_scale_fraction_floor(m: runner_slice, num: 1, den: safe_den),
    runner: runner_spec_from_offer(offer: offer),
  }
}

fn empty_deployment_accumulator() -> DeploymentAccumulator {
  DeploymentAccumulator { deployments: [], any_unfit: false, total: 0 }
}

fn accumulate_host_deployment(
  acc: DeploymentAccumulator,
  offer: ComputeOffer,
  overhead: ByteSize,
  session_slice: ByteSize,
  run_unit_peak: ByteSize
) -> DeploymentAccumulator {
  let count = host_runner_count(offer: offer, overhead: overhead, session_slice: session_slice, run_unit_peak: run_unit_peak)
  DeploymentAccumulator {
    deployments: concat(acc.deployments, [host_deployment(offer: offer, overhead: overhead, session_slice: session_slice, count: count)]),
    any_unfit: acc.any_unfit || (count == 0),
    total: acc.total + count,
  }
}

fn derive_plan_with_budget(offers: List<ComputeOffer>, overhead: ByteSize, session_slice: ByteSize, run_unit_peak: ByteSize) -> RunnerDeploymentPlan {
  let acc = fold(
    offers,
    init: empty_deployment_accumulator(),
    f: (a, o) => accumulate_host_deployment(acc: a, offer: o, overhead: overhead, session_slice: session_slice, run_unit_peak: run_unit_peak)
  )
  if acc.any_unfit {
    PlanUnsound {
      reason: "at least one fleet host cannot host a single runner under conservation (host RAM - host_fixed_overhead - sessions_slice < one whole-run cgroup peak); lower the per-session cap C, lower the session concurrency N, or sharpen the conservative 24GiB per-run peak"
    }
  } else {
    PlanDerived { hosts: acc.deployments, fleet_concurrent_runs: acc.total }
  }
}

fn runner_deployment_plan_for(
  job_peaks: List<CiJobPeak>,
  overhead: HostFixedOverhead,
  session_slice: ByteSize,
  offers: List<ComputeOffer>
) -> RunnerDeploymentPlan {
  match resolve_run_unit_peak(job_peaks: job_peaks) {
    JobPeaksUnresolved { reason: r } => PlanUnsound { reason: r }
    JobPeaksResolved { run_unit_peak: peak } =>
      match overhead {
        HostFixedOverheadUnmeasured =>
          PlanUnsound {
            reason: "host fixed overhead unmeasured: the sccache server daemon may live in a sibling host cgroup outside every per-job cgroup, so it is counted by no per-job peak; refuse to derive runner capacity until it is classified and reserved exactly once"
          }
        HostFixedOverheadMeasured { bytes: oh } =>
          derive_plan_with_budget(offers: offers, overhead: oh, session_slice: session_slice, run_unit_peak: peak)
      }
  }
}

fn runner_deployment_plan() -> RunnerDeploymentPlan {
  match resolve_session_slice(op: gunbc_ci_session_operating_point) {
    SessionSliceUnresolved { reason: r } => PlanUnsound { reason: r }
    SessionSliceResolved { bytes: s, per_session_cap: _, concurrency: _ } =>
      runner_deployment_plan_for(
        job_peaks: gunbc_ci_job_peaks,
        overhead: gunbc_ci_host_fixed_overhead,
        session_slice: s,
        offers: fleet_intent_offers
      )
  }
}

type RunnersPerHostResolution
  = RunnersPerHostDerived { count: Int }
  | RunnersPerHostUnsound { reason: String }

fn effective_runners_per_host() -> RunnersPerHostResolution {
  match runner_deployment_plan() {
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } =>
      RunnersPerHostDerived { count: fold(hosts, init: 0, f: (acc, h) => if h.runner_count > acc { h.runner_count } else { acc }) }
    PlanUnsound { reason: r } => RunnersPerHostUnsound { reason: r }
  }
}

type SessionHostReservation {
  identity: HostIdentity
  session_count: Int
  per_session_reservation: ByteSize
}

type SessionReservationPlan
  = SessionReservationDerived {
      hosts: List<SessionHostReservation>,
      fleet_concurrent_sessions: Int,
      per_session_reservation: ByteSize,
      coverage_count: Int,
      sample_count: Int
    }
  | SessionReservationUnsound { reason: String }

fn samples_covered(cap: ByteSize) -> Int {
  fold(gunbc_ci_per_session_peak_samples, init: 0, f: (acc, s) => if measure_le(a: s, b: cap) { acc + 1 } else { acc })
}

fn session_reservation_plan() -> SessionReservationPlan {
  match resolve_session_slice(op: gunbc_ci_session_operating_point) {
    SessionSliceUnresolved { reason: r } => SessionReservationUnsound { reason: r }
    SessionSliceResolved { bytes: _, per_session_cap: c, concurrency: n } =>
      SessionReservationDerived {
        hosts: map(fleet_intent_offers, o => SessionHostReservation {
          identity: o.supply.physical.identity,
          session_count: n,
          per_session_reservation: c,
        }),
        fleet_concurrent_sessions: n * fleet_intent_offers.length(),
        per_session_reservation: c,
        coverage_count: samples_covered(cap: c),
        sample_count: gunbc_ci_per_session_peak_samples.length(),
      }
  }
}

data gunbc_ci_count_field_measure_followup: String = "dissolve-on feature:M12-cardinal-count-value-measure-sweep -- the M12 / Practice-13 value-Measure sweep for cardinal COUNT fields. The runner/session counts here (OperatingPointRow.min_runner_count, .session_concurrency, .coverage_count, .sample_count; RunnerHostDeployment.runner_count; SessionHostReservation.session_count; SessionReservationDerived.fleet_concurrent_sessions) are flat Int -- cardinals per DESIGN sec 2, identical in kind to the codebase-wide bare-Int count convention (rank_count, contact_count, processor_count, lane_count, stick_count, approval_count, ...) and to the unit_modeling lens's own cardinal exemptions (index/ordinal/position). The lens is an ADVISORY region-3 RatchetForever (not floor-enrolled, does not gate CI). Disposition for the whole cluster: convert together to a count-Measure carrier (HardwareThreadCount-style) in one M12 sweep so the unit modeling stays single-authority -- do NOT peel one field here (the forked-logic trap)."

type OperatingPointRow {
  per_session_cap: ByteSize
  session_concurrency: Int
  sessions_slice: ByteSize
  min_runner_count: Int
  coverage_count: Int
  sample_count: Int
}

fn evaluate_operating_point(cap: ByteSize, n: Int) -> OperatingPointRow {
  let slice = match resolve_session_slice(op: SessionOperatingPointSet { per_session_cap: cap, session_concurrency: n }) {
    SessionSliceResolved { bytes: b, per_session_cap: _, concurrency: _ } => b
    SessionSliceUnresolved { reason: _ } => byte_size(0)
  }
  let plan = runner_deployment_plan_for(
    job_peaks: gunbc_ci_job_peaks,
    overhead: gunbc_ci_host_fixed_overhead,
    session_slice: slice,
    offers: fleet_intent_offers
  )
  let min_count = match plan {
    PlanDerived { hosts: hs, fleet_concurrent_runs: _ } =>
      fold(hs, init: 0, f: (acc, h) => if acc == 0 { h.runner_count } else { if h.runner_count < acc { h.runner_count } else { acc } })
    PlanUnsound { reason: _ } => 0
  }
  OperatingPointRow {
    per_session_cap: cap,
    session_concurrency: n,
    sessions_slice: slice,
    min_runner_count: min_count,
    coverage_count: samples_covered(cap: cap),
    sample_count: gunbc_ci_per_session_peak_samples.length(),
  }
}

data gunbc_ci_session_operating_curve_candidates: List<SessionOperatingPoint> = [
  SessionOperatingPointSet { per_session_cap: byte_size(2211908157), session_concurrency: 16 },
  SessionOperatingPointSet { per_session_cap: byte_size(4294967296), session_concurrency: 16 },
  SessionOperatingPointSet { per_session_cap: byte_size(8879844884), session_concurrency: 6 },
  SessionOperatingPointSet { per_session_cap: byte_size(10737418240), session_concurrency: 6 },
  SessionOperatingPointSet { per_session_cap: byte_size(8879844884), session_concurrency: 4 },
]

fn operating_curve() -> List<OperatingPointRow> {
  map(gunbc_ci_session_operating_curve_candidates, op => match op {
    SessionOperatingPointSet { per_session_cap: c, session_concurrency: n } => evaluate_operating_point(cap: c, n: n)
    SessionOperatingPointUnset => evaluate_operating_point(cap: byte_size(0), n: 0)
  })
}
