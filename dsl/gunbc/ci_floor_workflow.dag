// gunbc/ci_floor_workflow.dag — authoritative CI floor Workflow value.
//
// Single authority for `.github/workflows/ci.yml` (DESIGN §3). The committed file
// is the literal byte output of `serialize_yaml(project_workflow_to_yaml(ci_floor_workflow))`
// — no hash pin, no dual representation.

module gunbc.ci_floor_workflow

import extdeps.formats.yaml { YamlValue, YamlKeyValue, yaml_string, yaml_int, yaml_bool, kv }
import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep,
  WorkflowTrigger, Push, PullRequest, WorkflowDispatch,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview,
  WorkflowPermissions, PermRead,
  ConcurrencySpec, ConcurrencyMappingQueueNotMax, CancelInProgressBool,
  RunnerSpec, SelfHosted,
  checkout_action, setup_rust_action, cache_action
}

data ci_floor_workflow: Workflow = {
  name: "ci",
  on: [
    WorkflowDispatch { inputs: [] },
    Push { branches: ["main"], paths: [] },
    PullRequest {
      branches: ["main"],
      types: [Opened, Synchronize, Reopened, ReadyForReview]
    }
  ],
  concurrency: Present {
    value: ConcurrencyMappingQueueNotMax {
      group: "${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}",
      cancel_in_progress: Present { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  env: Present {
    value: [
      kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
      kv(key: "RUSTFLAGS", value: yaml_string(s: "-D warnings"))
    ]
  },
  permissions: Present {
    value: WorkflowPermissions {
      contents: Present { value: PermRead },
      pull_requests: Present { value: PermRead },
      issues: none,
      actions: none
    }
  },
  jobs: [{
    id: "ci",
    name: none,
    runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
    steps: [
      RunStep {
        name: Present { value: "Isolate toolchain dirs" },
        id: none,
        run: concat(
          concat(
            concat(
              "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\n",
              "echo \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n"
            ),
            "echo \"CARGO_BUILD_JOBS=2\" >> \"$GITHUB_ENV\""
          ),
          ""
        ),
        shell: none,
        env: none,
        working_directory: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      UsesStep {
        name: Present { value: "Checkout" },
        id: none,
        uses: checkout_action,
        with: Present {
          value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
        },
        env: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      UsesStep {
        name: Present { value: "Setup Rust" },
        id: none,
        uses: setup_rust_action,
        with: Present {
          value: [
            kv(key: "components", value: yaml_string(s: "rustfmt")),
            kv(key: "cache", value: yaml_bool(b: false)),
            kv(key: "rustflags", value: yaml_string(s: ""))
          ]
        },
        env: Present {
          value: [kv(key: "HOME", value: yaml_string(s: "${{ runner.temp }}"))]
        },
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      RunStep {
        name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
        id: none,
        run: concat(
          "rustup default \"$(rustup show active-toolchain | awk '",
          concat(concat("{", "print $1; exit"), concat("}", "')\""))
        ),
        shell: none,
        env: none,
        working_directory: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      UsesStep {
        name: Present { value: "Cache Cargo" },
        id: none,
        uses: cache_action,
        with: Present {
          value: [
            kv(key: "path", value: yaml_string(s: concat(
              concat(
                concat(
                  "${{ runner.temp }}/cargo/registry/index/\n",
                  "${{ runner.temp }}/cargo/registry/cache/\n"
                ),
                concat(
                  "${{ runner.temp }}/cargo/git/db/\n",
                  "target/"
                )
              ),
              ""
            ))),
            kv(key: "key", value: yaml_string(s: "cargo-ci-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('**/Cargo.lock', 'rust-toolchain.toml') }}")),
            kv(key: "restore-keys", value: yaml_string(s: "cargo-ci-${{ runner.os }}-${{ runner.arch }}-\n"))
          ]
        },
        env: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      RunStep {
        name: Present { value: "CI floor (.dag witness corpus + gates via gunbc)" },
        id: none,
        run: concat(
          concat(
            concat(
              "git fetch --no-tags origin main 2>/dev/null || true\n",
              "cargo run -p v1-compiler --release --bin claim_batch -- \\\n"
            ),
            concat(
              concat(
                concat(
                  "  --source-root src/v2 --source-root dsl \\\n",
                  "  --roster-from-discovery \\\n"
                ),
                concat(
                  "  --entry dsl/test/claim/rust_stage0_gates_witness.dag --function rust_stage0_gates_witnesses \\\n",
                  "  --entry dsl/test/claim/emit_host_gate_witness.dag --function emit_host_gate_witnesses \\\n"
                )
              ),
              concat(
                concat(
                  "  --entry src/v2/test/claim/layering_imports/coverage_domain_equivalence.dag --function coverage_domain_equivalence_argument_holds \\\n",
                  "  --entry dsl/test/claim/filesystem_entry_kind_witness.dag --function filesystem_entry_kind_witnesses \\\n"
                ),
                concat(
                  "  --entry dsl/test/claim/power_watt_witness.dag --function power_watt_witnesses \\\n",
                  "  --entry dsl/test/claim/dsl_compile_clean_witness.dag --function dsl_compile_clean_witnesses \\\n"
                )
              )
            )
          ),
          concat(
            concat(
              "  --notice-title \"v2 claim corpus\"\n",
              "cargo run -p v1-compiler --release --bin gunbc -- run \\\n"
            ),
            concat(
              "  --source-root dsl --source-root src/v2 \\\n",
              "  --entry dsl/tools/ci_floor_gates.dag --function main"
            )
          )
        ),
        shell: none,
        env: none,
        working_directory: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      }
    ],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: 240 },
    continue_on_error: none,
    concurrency: none
  }]
}
