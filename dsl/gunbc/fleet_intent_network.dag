fn fleet_intent_network_topology() -> NetworkTopology {
  fleet_intent_network
}

type CollectiveFabricGroup = NoCollectiveFabric | SparkPairA | SparkPairB

fn host_collective_fabric_group(host: HostIdentity) -> CollectiveFabricGroup {
  if host == operator_host_spark_3bd5 {
    SparkPairA
  } else {
    if host == operator_host_spark_a3ee {
      SparkPairA
    } else {
      if host == operator_host_spark_c2b1 {
        SparkPairB
      } else {
        if host == operator_host_spark_ac79 {
          SparkPairB
        } else {
          NoCollectiveFabric
        }
      }
    }
  }
}

type CollectivePlacement =
    CollectiveAdmissible { fabric: CollectiveFabricGroup }
  | CollectiveRefused { reason: NonEmptyStr }

fn collective_fabric_groups_agree(a: CollectiveFabricGroup, b: CollectiveFabricGroup) -> Bool {
  match a {
    NoCollectiveFabric => match b { NoCollectiveFabric => true  _ => false }
    SparkPairA => match b { SparkPairA => true  _ => false }
    SparkPairB => match b { SparkPairB => true  _ => false }
  }
}

fn collective_placement(ranks: List<HostIdentity>) -> CollectivePlacement {
  let head_group = fold(
    ranks,
    init: NoCollectiveFabric,
    f: (acc, host) => match acc {
      NoCollectiveFabric => host_collective_fabric_group(host: host)
      _ => acc
    }
  )
  let all_agree = fold(
    ranks,
    init: true,
    f: (acc, host) => acc && collective_fabric_groups_agree(
      a: host_collective_fabric_group(host: host),
      b: head_group
    )
  )
  match head_group {
    NoCollectiveFabric =>
      CollectiveRefused {
        reason: "collective_placement: no rank sits on a DirectAttachFabric. Tensor-parallel ranks exchange an all-reduce per layer, so they must share a point-to-point RDMA fabric; the operator LAN is WiFi and is latency-disqualified. Typed refusal via total fold, DESIGN section 5."
      }
    _ =>
      if all_agree {
        CollectiveAdmissible { fabric: head_group }
      } else {
        CollectiveRefused {
          reason: "collective_placement: ranks span more than one DirectAttachFabric. Each Spark pair is cabled point-to-point to its partner and the pairs share only the WiFi LAN, so a cross-pair collective has no route at UltraLow latency. Widening tensor parallelism across pairs requires one fabric (switch or re-cable), not a larger degree. Typed refusal via total fold, DESIGN section 5."
        }
      }
  }
}
