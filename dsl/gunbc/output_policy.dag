module gunbc.output_policy

import std.types { Bool, Int, List, String }

type Verbosity = Quiet | Normal | Verbose

fn verbosity_eq(a: Verbosity, b: Verbosity) -> Bool {
  match a {
    Quiet => match b { Quiet => true, _ => false }
    Normal => match b { Normal => true, _ => false }
    Verbose => match b { Verbose => true, _ => false }
  }
}

type VerbosityEnvBinding {
  verbosity: Verbosity
  env_var: String
}

data gunbc_verbosity_env_vars: List<VerbosityEnvBinding> = [
  VerbosityEnvBinding { verbosity: Verbose, env_var: "GUNBC_VERBOSE" },
  VerbosityEnvBinding { verbosity: Quiet, env_var: "GUNBC_QUIET" }
]

fn env_var_for(v: Verbosity) -> String {
  fold(gunbc_verbosity_env_vars,
    init: "",
    f: (acc, binding) => if verbosity_eq(a: binding.verbosity, b: v) { binding.env_var } else { acc })
}

data shell_trace_summary_max_columns: Int = 100

type OutputDecision = Suppressed | Condensed | Full

type OutputChannel
  = Diagnostic
  | ClaimResult
  | Progress
  | ShellTrace
  | Instrumentation

type VerbosityEnv {
  verbose: Bool
  quiet: Bool
}

fn resolve_verbosity(env: VerbosityEnv) -> Verbosity {
  if env.verbose {
    Verbose
  } else if env.quiet {
    Quiet
  } else {
    Normal
  }
}

fn channel_decision(channel: OutputChannel, verbosity: Verbosity) -> OutputDecision {
  match channel {
    Diagnostic => Full
    ClaimResult => match verbosity {
      Quiet => Suppressed
      Normal => Full
      Verbose => Full
    }
    Progress => match verbosity {
      Quiet => Suppressed
      Normal => Condensed
      Verbose => Full
    }
    ShellTrace => match verbosity {
      Quiet => Suppressed
      Normal => Condensed
      Verbose => Full
    }
    Instrumentation => match verbosity {
      Quiet => Suppressed
      Normal => Suppressed
      Verbose => Full
    }
  }
}

fn is_emitted(channel: OutputChannel, verbosity: Verbosity) -> Bool {
  match channel_decision(channel: channel, verbosity: verbosity) {
    Suppressed => false
    Condensed => true
    Full => true
  }
}

fn is_condensed(channel: OutputChannel, verbosity: Verbosity) -> Bool {
  match channel_decision(channel: channel, verbosity: verbosity) {
    Condensed => true
    Suppressed => false
    Full => false
  }
}
