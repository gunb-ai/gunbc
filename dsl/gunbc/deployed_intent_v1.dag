module gunbc.deployed_intent_v1

import std.types { String }
import std.disposition { Disposition, Terminal }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent { ComputeHost, srv1_host }
import gunbc.fleet_intent_network { operator_host_srv1 }

type DeployedIntentV1 {
  fleet_slot: HostIdentity
  target_host: ComputeHost
  desired_hostname_short: String
}

data gunbc_deployed_intent_v1_scope_disposition: Disposition = Terminal {
  reason: "Phase-1 desired-intent carrier: hostname_short derives from modeled fleet identity (operator_host_srv*), never a duplicated literal. v1 pairs with DeployedIntentV0 observed base for keyed three-way fold."
}

fn deployed_intent_v1_desired_hostname_short(fleet_slot: HostIdentity) -> String {
  fleet_slot
}

fn deployed_intent_v1_desired_hostname_valid(hostname: String) -> Bool {
  hostname != ""
}

fn deployed_intent_v1_from_fleet_slot(
  fleet_slot: HostIdentity,
  target_host: ComputeHost,
) -> DeployedIntentV1 {
  DeployedIntentV1 {
    fleet_slot: fleet_slot,
    target_host: target_host,
    desired_hostname_short: deployed_intent_v1_desired_hostname_short(fleet_slot: fleet_slot),
  }
}

fn deployed_intent_v1_srv1() -> DeployedIntentV1 {
  deployed_intent_v1_from_fleet_slot(
    fleet_slot: operator_host_srv1,
    target_host: srv1_host,
  )
}

data gunbc_srv1_deployed_intent_v1: DeployedIntentV1 = deployed_intent_v1_srv1()
