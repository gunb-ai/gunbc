module gunbc.gha_yaml_fold_pilot

import extdeps.formats.yaml { YamlKeyValue }
import extdeps.github.actions {
  ActionRef,
  Job,
  RunStep,
  SelfHosted,
  ShellType,
  Step,
  UsesStep
}

type GhaPilotStepEmit
  = GhaPilotRunEmit { run: String }
  | GhaPilotUsesEmit { uses: ActionRef }

fn gha_pilot_run_step_non_emit_fields_absent(
  name: String?,
  id: String?,
  shell: ShellType?,
  env: List<YamlKeyValue>?,
  working_directory: String?,
  if_condition: String?,
  continue_on_error: Bool?,
  timeout_minutes: Int?
) -> Bool {
  match name {
    Absent =>
      match id {
        Absent =>
          match shell {
            Absent =>
              match env {
                Absent =>
                  match working_directory {
                    Absent =>
                      match if_condition {
                        Absent =>
                          match continue_on_error {
                            Absent =>
                              match timeout_minutes {
                                Absent => true
                                Present { value: _ } => false
                              }
                            Present { value: _ } => false
                          }
                        Present { value: _ } => false
                      }
                    Present { value: _ } => false
                  }
                Present { value: _ } => false
              }
            Present { value: _ } => false
          }
        Present { value: _ } => false
      }
    Present { value: _ } => false
  }
}

fn gha_pilot_uses_step_non_emit_fields_absent(
  name: String?,
  id: String?,
  with: List<YamlKeyValue>?,
  env: List<YamlKeyValue>?,
  if_condition: String?,
  continue_on_error: Bool?,
  timeout_minutes: Int?
) -> Bool {
  match name {
    Absent =>
      match id {
        Absent =>
          match with {
            Absent =>
              match env {
                Absent =>
                  match if_condition {
                    Absent =>
                      match continue_on_error {
                        Absent =>
                          match timeout_minutes {
                            Absent => true
                            Present { value: _ } => false
                          }
                        Present { value: _ } => false
                      }
                    Present { value: _ } => false
                  }
                Present { value: _ } => false
              }
            Present { value: _ } => false
          }
        Present { value: _ } => false
      }
    Present { value: _ } => false
  }
}

fn gha_fold_pilot_emit_step(step: Step) -> Optional<GhaPilotStepEmit> {
  match step {
    RunStep { name: n, id: i, run: r, shell: sh, env: e, working_directory: wd, if_condition: ic, continue_on_error: coe, timeout_minutes: tm } =>
      match gha_pilot_run_step_non_emit_fields_absent(
        name: n,
        id: i,
        shell: sh,
        env: e,
        working_directory: wd,
        if_condition: ic,
        continue_on_error: coe,
        timeout_minutes: tm
      ) {
        true =>
          Present {
            value: GhaPilotRunEmit { run: r }
          }
        false => Absent
      }
    UsesStep { name: n, id: i, uses: u, with: w, env: e, if_condition: ic, continue_on_error: coe, timeout_minutes: tm } =>
      match gha_pilot_uses_step_non_emit_fields_absent(
        name: n,
        id: i,
        with: w,
        env: e,
        if_condition: ic,
        continue_on_error: coe,
        timeout_minutes: tm
      ) {
        true =>
          Present {
            value: GhaPilotUsesEmit { uses: u }
          }
        false => Absent
      }
  }
}

data gha_fold_pilot_job: Job = Job {
  id: "pilot",
  name: Absent,
  runner: SelfHosted { labels: ["self-hosted", "linux"] },
  steps: [
    RunStep {
      name: Absent,
      id: Absent,
      run: "echo hi",
      shell: Absent,
      env: Absent,
      working_directory: Absent,
      if_condition: Absent,
      continue_on_error: Absent,
      timeout_minutes: Absent
    },
    UsesStep {
      name: Absent,
      id: Absent,
      uses: ActionRef { owner: "actions", repo: "checkout", ref: "v4" },
      with: Absent,
      env: Absent,
      if_condition: Absent,
      continue_on_error: Absent,
      timeout_minutes: Absent
    }
  ],
  needs: [],
  env: Absent,
  outputs: Absent,
  if_condition: Absent,
  strategy: Absent,
  timeout_minutes: Absent,
  continue_on_error: Absent,
  concurrency: Absent
}
