module gunbc.host_effect_realize

import gunbc.host_effect {
  HostEffect, ShellCommand, RedfishAction,
  NodeControlPlane, HostOs, BmcController,
  Policy, OneShotIdempotent, ConvergeToFixpoint,
  HostEffectIntent, HostEffectEvidence, ShellEffectApplied,
  HostEffectTransport, LocalShell, SshShell,
}
import std.realization_reconcile {
  Reconciliation, Converged, NotConverged,
  ReadObserved, Grounds, DoesNotGround,
  reconcile_grounded
}
import extdeps.shell
import extdeps.diagnostic.ssh { ssh_session_exec }
import extdeps.bmc.types { RedfishSystemAction }
import gunbc.fleet_intent { ComputeHost }
import std.types { String, NonEmptyStr }

type ResolvedHostEffectCell =
    ShellOnHost { node: ComputeHost, script: String }
  | RedfishOnBmc { node: ComputeHost, action: RedfishSystemAction }
  | IncompatibleCell { reason: String }

fn resolve_host_effect_cell(target: NodeControlPlane, effect: HostEffect) -> ResolvedHostEffectCell {
  match target {
    HostOs { node: n } =>
      match effect {
        ShellCommand { script: s } => ShellOnHost { node: n, script: s }
        RedfishAction { action: _ } =>
          IncompatibleCell { reason: "host_effect: RedfishAction is out-of-band (Redfish) and cannot target HostOs (in-band shell/systemd); target BmcController instead. Typed mismatch via total fold, DESIGN section 5." }
      }
    BmcController { node: n } =>
      match effect {
        ShellCommand { script: _ } =>
          IncompatibleCell { reason: "host_effect: ShellCommand is in-band (shell/systemd) and cannot target BmcController (out-of-band Redfish only); target HostOs instead. Typed mismatch via total fold, DESIGN section 5." }
        RedfishAction { action: a } => RedfishOnBmc { node: n, action: a }
      }
  }
}

type ShellExecObserved {
  exit_code: Int
  success: Bool
  stdout: String
}

fn run_shell_transport(script: String, transport: HostEffectTransport) -> ShellExecObserved {
  match transport {
    LocalShell => {
      let result = shell.Exec.Run(script: script)
      ShellExecObserved {
        exit_code: result.exit_code,
        success: result.success,
        stdout: result.stdout,
      }
    }
    SshShell { ssh_host: h } => {
      if script == "" {
        ShellExecObserved {
          exit_code: 1,
          success: false,
          stdout: "host_effect_apply: empty shell script over SshShell; fail-closed",
        }
      } else {
        let result = ssh_session_exec(host: h, command: script as NonEmptyStr)
        ShellExecObserved {
          exit_code: result.exit_code,
          success: result.success,
          stdout: result.stdout,
        }
      }
    }
  }
}

fn realize_shell_on_host(script: String, transport: HostEffectTransport, intent: HostEffectIntent) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let result = run_shell_transport(script: script, transport: transport)
  let grounding = if result.success {
      Grounds { evidence: ShellEffectApplied { exit_code: result.exit_code, stdout: result.stdout } }
    } else {
      DoesNotGround { reason: "host_effect_apply: shell exec returned a nonzero exit code; fail-closed, no fabricated convergence" }
    }
  reconcile_grounded(
    apply_effect: intent,
    show_read: ReadObserved { value: result },
    grounding: grounding
  )
}

fn host_effect_apply(target: NodeControlPlane, effect: HostEffect, policy: Policy, transport: HostEffectTransport) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let intent = HostEffectIntent { target: target, effect: effect, policy: policy, transport: transport }
  match resolve_host_effect_cell(target: target, effect: effect) {
    ShellOnHost { node: _, script: s } => realize_shell_on_host(script: s, transport: transport, intent: intent)
    RedfishOnBmc { node: _, action: _ } =>
      NotConverged { reason: "host_effect_apply: RedfishAction realization is a fail-closed Unimplemented stub in Phase A; neat-boar-71 realizes it over RedfishRest in Phase C. No plausible no-op for a power/boot action (DESIGN section 5).", applied: intent }
    IncompatibleCell { reason: why } => NotConverged { reason: why, applied: intent }
  }
}

type ConvergeDirective = Settled | ReDrive | Refused { reason: String }

fn not_converged_directive(policy: Policy) -> ConvergeDirective {
  match policy {
    OneShotIdempotent => Settled
    ConvergeToFixpoint => ReDrive
  }
}

fn host_effect_policy_directive(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> ConvergeDirective {
  match r {
    Converged { evidence: _, applied: _ } => Settled
    NotConverged { reason: _, applied: intent } =>
      match resolve_host_effect_cell(target: intent.target, effect: intent.effect) {
        IncompatibleCell { reason: why } => Refused { reason: why }
        ShellOnHost { node: _, script: _ } => not_converged_directive(policy: intent.policy)
        RedfishOnBmc { node: _, action: _ } => not_converged_directive(policy: intent.policy)
      }
  }
}
