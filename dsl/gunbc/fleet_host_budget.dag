data fleet_build_realization_marker: String = "build = ONE shared host-wide RealizedStep, NOT per-type. shape = CreateEffect CreateIfAbsent keyed on the content hash (sccache content-addresses the compile -> create-if-absent on content key); materialization = Share (the CACHING arm = ctrl-sccache, host-wide across GHA-CI builds AND session ctrl-builds); placement = LocalFilesystem; cost.space = mib_per_job (the per-build memory envelope = SCHEDULING arm = ctrl-jobserver). The two arms (ctrl-jobserver scheduling + ctrl-sccache caching) already unify GHA and session builds = the two arms of std.realization RealizedStep instantiated. A typed RealizedStep value IS constructed (build_realization below), not only this marker."

fn build_cost_account(cfg: CtrlJobserverConfig) -> CostAccount<Nano> {
  CostAccount {
    time: time_measure(count: 0),
    space: cfg.mib_per_job,
    power: watt(count: 0),
    basis: Predicted,
  }
}

fn build_realization(cfg: CtrlJobserverConfig) -> RealizedStep<Nano> {
  RealizedStep {
    shape: CreateEffect { cause: CreateIfAbsent { key_source: CompositeKey { fields: ["compile_unit_content_hash", "toolchain_content_hash"] } } },
    placement: LocalFilesystem,
    materialization: Share,
    cost: build_cost_account(cfg: cfg),
  }
}

type HeadroomPolicy
  = HeadroomSet { bytes: ByteSize }
  | HeadroomUnset

data gunbc_fleet_headroom_policy: HeadroomPolicy = HeadroomUnset

data gunbc_fleet_oomd_floor_basis: String = "oomd_actuation_floor is a DERIVED lower bound on free host memory: systemd-oomd needs free headroom to evict a runaway cgroup BEFORE the kernel OOM-killer/livelock fires (the srv2-reboot vector). Basis: a fixed fraction of host RAM (1/16 = ~6.25%) as the minimum free-memory swing oomd needs to actuate; on a 125GiB host this is ~7.8GiB. This is the floor BELOW which a HeadroomSet policy is unsound (it leaves oomd no room to act). Derived, not a literal: scales with host. dissolve-on a measured oomd MemoryPressureLimit + swap-free actuation window once systemd-oomd is live (operator fix-manifest item 8)."

fn oomd_actuation_floor(host: ByteSize) -> ByteSize {
  measure_scale_fraction_floor(m: host, num: 1, den: 16)
}

type HeadroomResolution
  = HeadroomResolved { bytes: ByteSize }
  | HeadroomUnsound { reason: String }

fn resolve_headroom(policy: HeadroomPolicy, floor: ByteSize) -> HeadroomResolution {
  match policy {
    HeadroomUnset => HeadroomUnsound { reason: "headroom policy unset" }
    HeadroomSet { bytes: b } =>
      if byte_size_count(b: b) >= byte_size_count(b: floor) {
        HeadroomResolved { bytes: b }
      } else {
        HeadroomUnsound { reason: "below oomd actuation floor" }
      }
  }
}

data gunbc_fleet_runner_slice_dropin_marker: String = "the runner-slice memory cap ALREADY EXISTS on disk as /etc/systemd/system/system-actions-runner.slice.d/10-resource-caps.conf (MemoryHigh=55307438489 ~51.5GiB = 55% of host, MemoryMax=70391285350 ~65.6GiB = 70% of host; cites the srv2 2026-05-28 reboot incident) but is INERT (effective MemoryMax=INFINITY) = disk!=live DRIFT, which the ctrl reconciler runner_host_reconcile.mjs is meant to fix. gunbc does NOT generate a new cap from scratch: it OWNS the cap VALUE = runner_slice_cap = host - overhead - session_worst_case_slice - headroom (the CONSERVING value that REFINES the 55/70% static-fraction policy; build_pool is NOT subtracted -- the GHA build lives INSIDE this slice, counted once via the per-job peak, see gunbc_fleet_build_pool_counted_once_marker), fed INTO that existing drop-in. The 55/70% fractions are the coarse stand-in this conserving value sharpens."


fn gunbc_fleet_oomd_evidence_for(mode: SessionReservationMode) -> OomdEnforcementEvidence {
  match mode {
    Regime2AggregateOomd { oomd_eviction_ceiling: ceiling, session_concurrency: _, aggregate_reservation: agg } =>
      gunbc_oomd_fleet_evidence(req: OomdGroundingThresholds {
        per_session_cap: ceiling,
        parent_slice_cap: agg,
        pressure_limit: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit,
      })
    Regime1WorstCase { point: _ } => OomdUnverified
    SessionReservationModeUnset => OomdUnverified
  }
}

data gunbc_fleet_oomd_evidence: OomdEnforcementEvidence = gunbc_fleet_oomd_evidence_for(mode: gunbc_ci_session_reservation_mode)

data gunbc_fleet_build_pool_counted_once_marker: String = "the sccache build pool is NO LONGER a host-level sibling reservation subtracted before the runner slice (that was a DOUBLE-COUNT: a GHA-CI runner job IS a build -- its rustc lives INSIDE system-actions-runner.slice and is already charged in the per-job whole-tree peak that the runner count divides by; subtracting build_pool again starved the runner slice to ~0). Counted-once fix (bright-stag §2/§3 ruling 2026-06-23): the build memory lives INSIDE the cgroup that builds (runner slice for GHA-CI, session footprint for session ctrl-builds), so it is NOT a separate host line. The shared pool's CONCURRENCY survives as effective_build_tokens (= derive_jobserver_tokens, the jobserver authority) -- the build-bound axis of the min-over-constraints runner count, NOT a memory subtraction. runner_baseline likewise lives INSIDE the runner slice (idle is in the per-job peak), so it is an informational sub-allocation of the slice, not a host sibling. The SESSION ctrl-build burst is the session-reservation-plan's per_session_cap concern (REGIME-1 worst-case), re-attributed there, not deleted."

fn appropriation_of(b: ByteSize) -> Appropriation<Memory, One> {
  Appropriation { ceiling: b }
}

fn overhead_claim(overhead: ByteSize) -> BudgetClaim {
  BudgetClaim {
    item: LineItem { purpose: "host_fixed_overhead", amount: overhead },
    priority: Guaranteed,
  }
}

fn host_ram_of(offer: ComputeOffer) -> ByteSize {
  compute_host_ram_bytes_total(host: offer.supply.physical)
}

fn child_node(name: String, b: ByteSize) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: b),
    claims: [],
    children: [],
  }
}

data gunbc_fleet_session_worstcase_marker: String = "the host-level session reservation subtracted from the runner slice is the session WORST-CASE (REGIME-1 per_session_cap * concurrency = the resolve_session_slice figure), NOT the idle session_baseline. Safe-by-construction = sum-of-MAXES <= host: srv1/srv2 co-host the agent-session fleet AND the runners, and a session ctrl-build BURSTS well above idle CONCURRENTLY with full runner load; reserving only idle would over-commit when a session build co-runs with runners, defeating the by-construction property and re-introducing the need for oomd. This UNIFIES the session-slice authority (§3): the SAME resolve_session_slice number is subtracted here AND drives the dashboard session reservation -- one figure, not a fork. RESIDUAL VECTOR (bright-stag §5 caveat): this is only truly safe-by-construction if the session slice is itself LIVE-CAP-ENFORCED at that worst-case (verified-effective, same discipline as RunnerSlotEnforcement). There is NO session-slice enforcement carrier modeled today -> the session burst is the one place oomd-as-backstop still earns its keep until a SessionSliceEnforcement carrier + verified-effective apply lands (T-next, coordinate with the CI-humming manager). headroom stays the general kernel/residue margin where oomd operates."

fn runner_slice_cap(host: ByteSize, overhead: ByteSize, session_slice: ByteSize, headroom: ByteSize) -> ByteSize {
  let after_overhead = byte_size_saturating_sub(total: host, reserved: overhead)
  let after_session = byte_size_saturating_sub(total: after_overhead, reserved: session_slice)
  byte_size_saturating_sub(total: after_session, reserved: headroom)
}

fn runner_slice_node(runner_slice: ByteSize, runner_baseline: ByteSize) -> BudgetNode {
  BudgetNode {
    name: "runner_slice",
    appropriation: appropriation_of(b: runner_slice),
    claims: [],
    children: [child_node(name: "runner_idle_baseline", b: runner_baseline)],
  }
}

fn fleet_host_budget_tree(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  runner_baseline: ByteSize,
  session_slice: ByteSize,
  headroom: ByteSize,
  runner_slice: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "session_worstcase_reservation", b: session_slice),
      child_node(name: "headroom", b: headroom),
      runner_slice_node(runner_slice: runner_slice, runner_baseline: runner_baseline),
    ],
  }
}

data gunbc_fleet_runner_slice_drift_marker: String = "the runner-slice cap disk!=live DRIFT detector (the REAL over-commit vector, not sessions). runner_slice_cap_drifted(disk_cap, effective): the live bug is 10-resource-caps.conf setting MemoryMax=70391285350 ON DISK while the effective runtime cgroup is CapUnbounded (MemoryMax=INFINITY) -> drift=true. The ctrl reconciler runner_host_reconcile.mjs is meant to make disk==live (CapEffective with the disk cap) -> drift=false; a different effective value is also drift. This is the SHAPE + a fixture red-receipt; the live-read arm (systemctl show the effective MemoryMax) is the D2 effectful floor gate, fail-closed when the host read is unavailable (never silently pass off-host)."

fn runner_slice_cap_drifted(disk_cap: ByteSize, effective: RunnerSliceCapEffectiveness) -> Bool {
  match effective {
    CapUnbounded => true
    CapEffective { bytes: b } => !(byte_size_count(b: disk_cap) == byte_size_count(b: b))
  }
}

type FleetHostPlan
  = FleetHostPlanDerived {
      name: String,
      tree: BudgetNode,
      runner_slice_cap: ByteSize,
      effective_build_tokens: HardwareThreadCount,
      effective_runner_cpu_cap: HardwareThreadCount,
      build_step: RealizedStep<Nano>
    }
  | FleetHostPlanUnsound { reason: String }

fn fleet_host_plan_for(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  nproc: HardwareThreadCount,
  runner: FleetContainerType,
  session_slice: ByteSize,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match oomd {
    OomdUnverified =>
      FleetHostPlanUnsound { reason: "oomd enforcement unverified: systemd-oomd is the eviction backstop (srv2-reboot fix + the conservation keystone); refuse to derive a host plan without it (fail closed)" }
    OomdEnforced =>
      match citation {
        CtrlJobserverAbsent =>
          FleetHostPlanUnsound { reason: "ctrl-jobserver config citation absent: refuse to derive the build token bound without the cited installer knobs (margin / mem_reserve / mib_per_job)" }
        CtrlJobserverCited { config: cfg, provenance: _ } =>
          match container_baseline_bytes(c: runner) {
            BaselineUnmeasured { reason: r } => FleetHostPlanUnsound { reason: r }
            BaselineResolved { bytes: rb } => {
              let floor = oomd_actuation_floor(host: host)
              match resolve_headroom(policy: policy, floor: floor) {
                HeadroomUnsound { reason: r } => FleetHostPlanUnsound { reason: r }
                HeadroomResolved { bytes: hr } => {
                  let slice = runner_slice_cap(host: host, overhead: overhead, session_slice: session_slice, headroom: hr)
                  let tree = fleet_host_budget_tree(name: name, host: host, overhead: overhead, runner_baseline: rb, session_slice: session_slice, headroom: hr, runner_slice: slice)
                  FleetHostPlanDerived {
                    name: name,
                    tree: tree,
                    runner_slice_cap: slice,
                    effective_build_tokens: derive_jobserver_tokens(nproc: nproc, mem_total: host, cfg: cfg),
                    effective_runner_cpu_cap: cpu_cores_available(nproc: nproc, margin: cfg.margin),
                    build_step: build_realization(cfg: cfg),
                  }
                }
              }
            }
          }
      }
  }
}

fn fleet_host_plan() -> FleetHostPlan {
  fleet_host_plan_for(
    name: "fleet_host",
    host: byte_size(134217728000),
    overhead: byte_size(17179869184),
    nproc: hardware_thread_count(count: 128),
    runner: gha_runner_container,
    session_slice: byte_size(0),
    citation: ctrl_jobserver_config,
    policy: gunbc_fleet_headroom_policy,
    oomd: gunbc_fleet_oomd_evidence
  )
}

data gunbc_fleet_standalone_plan_session_slice_marker: String = "fleet_host_plan() is the standalone live fail-closed SMOKE only (committed oomd=OomdUnverified -> Unsound before session_slice is consumed). It passes session_slice=0 as a placeholder because fleet_host_budget cannot resolve the session reservation mode without importing UP into ci_runner_placement (the cycle the param-pass design avoids). The REAL live plan is the per-offer path: ci_runner_placement resolves the worst-case session_slice via resolve_session_slice and passes it DOWN into fleet_host_plan_for_offer. Do not read capacity from fleet_host_plan(); read it from runner_deployment_plan()."

fn fleet_host_plan_for_offer(
  offer: ComputeOffer,
  overhead: ByteSize,
  session_slice: ByteSize,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      FleetHostPlanUnsound { reason: "compute offer has no primary CPU facts: refuse to derive a host plan without a measured core count (the CPU-core runner cap needs nproc; fail closed)" }
    Present { value: cpu } =>
      fleet_host_plan_for(
        name: offer.supply.physical.identity,
        host: compute_host_ram_bytes_total(host: offer.supply.physical),
        overhead: overhead,
        nproc: cpu_facts_threads(cpu: cpu),
        runner: gha_runner_container,
        session_slice: session_slice,
        citation: citation,
        policy: policy,
        oomd: oomd
      )
  }
}
