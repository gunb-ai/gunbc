fn build_cost_account(cfg: CtrlJobserverConfig) -> CostAccount<Nano> {
  CostAccount {
    time: time_measure(count: 0),
    space: cfg.mib_per_job,
    power: watt(count: 0),
    basis: Predicted,
  }
}

fn build_realization(cfg: CtrlJobserverConfig) -> RealizedStep<Nano> {
  RealizedStep {
    shape: CreateEffect { cause: CreateIfAbsent { key_source: CompositeKey { fields: ["compile_unit_content_hash", "toolchain_content_hash"] } } },
    placement: LocalFilesystem,
    materialization: Share,
    cost: build_cost_account(cfg: cfg),
  }
}

type HeadroomPolicy
  = HeadroomSet { bytes: ByteSize }
  | HeadroomUnset

data gunbc_fleet_headroom_policy: HeadroomPolicy = HeadroomUnset

data gunbc_fleet_oomd_floor_basis: String = "oomd_actuation_floor is a DERIVED lower bound on free host memory: systemd-oomd needs free headroom to evict a runaway cgroup BEFORE the kernel OOM-killer/livelock fires (the srv2-reboot vector). Basis: a fixed fraction of host RAM (1/16 = ~6.25%) as the minimum free-memory swing oomd needs to actuate; on a 125GiB host this is ~7.8GiB. This is the floor BELOW which a HeadroomSet policy is unsound (it leaves oomd no room to act). Derived, not a literal: scales with host. dissolve-on a measured oomd MemoryPressureLimit + swap-free actuation window once systemd-oomd is live (operator fix-manifest item 8)."

fn oomd_actuation_floor(host: ByteSize) -> ByteSize {
  measure_scale_fraction_floor(m: host, num: 1, den: 16)
}

data gunbc_host_headroom_per_core_basis: String = "host headroom is reserved FIRST and scales with the core count: each hardware thread can host a concurrent allocator whose burst lands above its steady cap, so the elastic free-memory buffer the OS scheduler/oomd needs grows with how many things run at once. Grounded per-core (gunbc_host_headroom_per_core x nproc), NOT a flat literal. A strict 1-2 GiB/core would exceed the host on a 128-core Ampere Altra Max (128 x 1 GiB = 128 GiB > 125 GiB RAM), so the per-core coefficient is fair-fitted below that ceiling; raise gunbc_host_headroom_per_core to widen the host's margin. Floored at oomd_actuation_floor so the host is never packed below the swing systemd-oomd needs to evict before the kernel OOM-killer/host-reboot fires (the srv2-reboot vector)."

data gunbc_host_headroom_per_core: ByteSize = byte_size(268435456)

fn core_grounded_headroom(nproc: HardwareThreadCount) -> ByteSize {
  measure_scale_fraction_floor(m: gunbc_host_headroom_per_core, num: hardware_thread_count_value(t: nproc), den: 1)
}

fn fleet_host_headroom(host: ByteSize, nproc: HardwareThreadCount) -> ByteSize {
  let core_based = core_grounded_headroom(nproc: nproc)
  let floor = oomd_actuation_floor(host: host)
  if byte_size_count(b: core_based) >= byte_size_count(b: floor) { core_based } else { floor }
}

type HeadroomResolution
  = HeadroomResolved { bytes: ByteSize }
  | HeadroomUnsound { reason: String }

fn resolve_headroom(policy: HeadroomPolicy, floor: ByteSize) -> HeadroomResolution {
  match policy {
    HeadroomUnset => HeadroomUnsound { reason: "headroom policy unset" }
    HeadroomSet { bytes: b } =>
      if byte_size_count(b: b) >= byte_size_count(b: floor) {
        HeadroomResolved { bytes: b }
      } else {
        HeadroomUnsound { reason: "below oomd actuation floor" }
      }
  }
}



fn gunbc_fleet_oomd_evidence_for(mode: SessionReservationMode) -> OomdEnforcementEvidence {
  match mode {
    Regime2AggregateOomd { oomd_eviction_ceiling: ceiling, session_concurrency: _, aggregate_reservation: agg } =>
      gunbc_oomd_fleet_evidence(req: OomdGroundingThresholds {
        per_session_cap: ceiling,
        parent_slice_cap: agg,
        pressure_limit: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit,
      })
    Regime1WorstCase { point: _ } => OomdUnverified
    SessionReservationModeUnset => OomdUnverified
  }
}

data gunbc_fleet_oomd_evidence: OomdEnforcementEvidence = gunbc_fleet_oomd_evidence_for(mode: gunbc_ci_session_reservation_mode)


fn appropriation_of(b: ByteSize) -> Appropriation<Memory, One> {
  Appropriation { ceiling: b }
}

fn overhead_claim(overhead: ByteSize) -> BudgetClaim {
  BudgetClaim {
    item: LineItem { purpose: "host_fixed_overhead", amount: overhead },
    priority: Guaranteed,
  }
}

fn host_ram_of(offer: ComputeOffer) -> ByteSize {
  compute_host_ram_bytes_total(host: offer.supply.physical)
}

fn child_node(name: String, b: ByteSize) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: b),
    claims: [],
    children: [],
  }
}


data gunbc_per_runner_memory_cap: ByteSize = byte_size(8589934592)

data gunbc_session_container_memory: ByteSize = byte_size(1073741824)

data gunbc_session_dashboard_reservation_basis: String = "PROVISIONAL hard host reservation for the session-dashboard tenant (the ctrl orchestrator + web UI container, FleetContainerType.SessionDashboardContainer) - 4 GiB, NOT yet a measured cap. It is a THIRD co-resident tenant on srv1/srv2 alongside CI runners and agent sessions and MUST be reserved off the host or the host over-commits (operator: no over-commitment - we are not sophisticated enough to allow it). Dissolves to a measured dashboard-container cap (ask keen-dove-772). TOPOLOGY CAVEAT: reserved per-host (every host leaves room for it) as the conservative no-over-commit choice; if the dashboard is actually a single central instance, the non-hosting hosts over-reserve by this amount - confirm topology to tighten."

data gunbc_session_dashboard_reservation: ByteSize = byte_size(4294967296)

fn session_pool_bytes(active_sessions: Nat) -> ByteSize {
  measure_scale_fraction_floor(m: gunbc_session_container_memory, num: active_sessions, den: 1)
}

fn session_pool_reservation(mode: SessionReservationMode) -> ByteSize {
  match mode {
    Regime2AggregateOomd { oomd_eviction_ceiling: _, session_concurrency: _, aggregate_reservation: agg } =>
      match agg {
        SessionAggregateMeasured { bytes: b } => b
        SessionAggregateUnmeasured => byte_size(0)
      }
    Regime1WorstCase { point: _ } => byte_size(0)
    SessionReservationModeUnset => byte_size(0)
  }
}

fn host_allocation_tree(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  dashboard_pool: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: "host_allocation",
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "runner_pool", b: runner_pool),
      child_node(name: "session_pool", b: session_pool),
      child_node(name: "dashboard_pool", b: dashboard_pool),
      child_node(name: "headroom", b: headroom),
    ],
  }
}

fn host_allocation_conserves(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize,
  session_pool: ByteSize,
  dashboard_pool: ByteSize
) -> Bool {
  node_conserves(node: host_allocation_tree(
    host: host,
    overhead: overhead,
    headroom: headroom,
    runner_pool: runner_pool,
    session_pool: session_pool,
    dashboard_pool: dashboard_pool
  ))
}

fn max_concurrent_sessions(session_pool: ByteSize) -> Int {
  measure_fit_count_floor(capacity: session_pool, each: gunbc_session_container_memory)
}


fn runner_slice_cap(host: ByteSize, overhead: ByteSize, session_slice: ByteSize, headroom: ByteSize) -> ByteSize {
  let after_overhead = byte_size_saturating_sub(total: host, reserved: overhead)
  let after_session = byte_size_saturating_sub(total: after_overhead, reserved: session_slice)
  byte_size_saturating_sub(total: after_session, reserved: headroom)
}

fn runner_residual_after_cotenants(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  session_pool: ByteSize,
  dashboard_pool: ByteSize
) -> ByteSize {
  let after_dashboard = byte_size_saturating_sub(total: host, reserved: dashboard_pool)
  runner_slice_cap(host: after_dashboard, overhead: overhead, session_slice: session_pool, headroom: headroom)
}

fn runner_slice_node(runner_slice: ByteSize, runner_baseline: ByteSize) -> BudgetNode {
  BudgetNode {
    name: "runner_slice",
    appropriation: appropriation_of(b: runner_slice),
    claims: [],
    children: [child_node(name: "runner_idle_baseline", b: runner_baseline)],
  }
}

fn fleet_host_budget_tree(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  runner_baseline: ByteSize,
  session_slice: ByteSize,
  headroom: ByteSize,
  runner_slice: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "session_worstcase_reservation", b: session_slice),
      child_node(name: "headroom", b: headroom),
      runner_slice_node(runner_slice: runner_slice, runner_baseline: runner_baseline),
    ],
  }
}


fn runner_slice_cap_drifted(disk_cap: ByteSize, effective: RunnerSliceCapEffectiveness) -> Bool {
  match effective {
    CapUnbounded => true
    CapEffective { bytes: b } => !(byte_size_count(b: disk_cap) == byte_size_count(b: b))
  }
}

type FleetHostPlan
  = FleetHostPlanDerived {
      name: String,
      tree: BudgetNode,
      runner_slice_cap: ByteSize,
      effective_build_tokens: HardwareThreadCount,
      effective_runner_cpu_cap: HardwareThreadCount,
      build_step: RealizedStep<Nano>
    }
  | FleetHostPlanUnsound { reason: String }

fn fleet_host_plan_for(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  nproc: HardwareThreadCount,
  runner: FleetContainerType,
  session_slice: ByteSize,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match oomd {
    OomdUnverified =>
      FleetHostPlanUnsound { reason: "oomd enforcement unverified: systemd-oomd is the eviction backstop (srv2-reboot fix + the conservation keystone); refuse to derive a host plan without it (fail closed)" }
    OomdEnforced =>
      match citation {
        CtrlJobserverAbsent =>
          FleetHostPlanUnsound { reason: "ctrl-jobserver config citation absent: refuse to derive the build token bound without the cited installer knobs (margin / mem_reserve / mib_per_job)" }
        CtrlJobserverCited { config: cfg, provenance: _ } =>
          match container_baseline_bytes(c: runner) {
            BaselineUnmeasured { reason: r } => FleetHostPlanUnsound { reason: r }
            BaselineResolved { bytes: rb } => {
              let floor = oomd_actuation_floor(host: host)
              match resolve_headroom(policy: policy, floor: floor) {
                HeadroomUnsound { reason: r } => FleetHostPlanUnsound { reason: r }
                HeadroomResolved { bytes: hr } => {
                  let slice = runner_slice_cap(host: host, overhead: overhead, session_slice: session_slice, headroom: hr)
                  let tree = fleet_host_budget_tree(name: name, host: host, overhead: overhead, runner_baseline: rb, session_slice: session_slice, headroom: hr, runner_slice: slice)
                  FleetHostPlanDerived {
                    name: name,
                    tree: tree,
                    runner_slice_cap: slice,
                    effective_build_tokens: derive_jobserver_tokens(nproc: nproc, mem_total: host, cfg: cfg),
                    effective_runner_cpu_cap: cpu_cores_available(nproc: nproc, margin: cfg.margin),
                    build_step: build_realization(cfg: cfg),
                  }
                }
              }
            }
          }
      }
  }
}

fn fleet_host_plan() -> FleetHostPlan {
  fleet_host_plan_for(
    name: "fleet_host",
    host: byte_size(134217728000),
    overhead: byte_size(17179869184),
    nproc: hardware_thread_count(count: 128),
    runner: gha_runner_container,
    session_slice: byte_size(0),
    citation: ctrl_jobserver_config,
    policy: gunbc_fleet_headroom_policy,
    oomd: gunbc_fleet_oomd_evidence
  )
}


data gunbc_container_cpu_shares_basis: String = "cpu_shares is the cgroup-v2 CPUWeight (relative scheduling share, NOT a hard core partition - cpu_quota_cores stays none so containers are CPU-soft-capped, free to burst into idle cores). 1024 is the systemd default weight; sessions and the dashboard get the same relative weight as a runner here (equal-share). Distinct from the workload_class cpu_weight in ci_runner_placement, which biases interactive sessions above batch runners at the slice level; this is the per-container default the resolver stamps when a caller does not override. Provisional flat default; dissolves to a per-demand-class weight once relative latency-sensitivity is grounded."

data gunbc_container_cpu_shares: Int = 1024

data gunbc_container_pids_max_basis: String = "pids_max is the cgroup pids.max fork-bomb backstop: a per-container cap on task count so one runaway container cannot exhaust the host PID space (a second conservation axis beside memory). 4096 is a provisional ceiling comfortably above a build's process fan-out; dissolves to a measured peak task count per demand class."

data gunbc_container_pids_max: Int = 4096

fn session_container_provision() -> ContainerProvisionResult {
  match container_baseline_bytes(c: agent_session_container) {
    BaselineUnmeasured { reason: _ } =>
      ProvisionRefused { reason: "session container provision refused: agent-session idle baseline is unmeasured (no grounded reservation floor); fail closed rather than spawn an unreserved session container" }
    BaselineResolved { bytes: idle } =>
      resolve_container_provision(
        per_unit_cap: gunbc_session_container_memory,
        mem_reservation: idle,
        cgroup_slice: gunbc_oomd_sessions_slice,
        cpu_shares: gunbc_container_cpu_shares,
        pids_max: gunbc_container_pids_max,
        cargo_build_jobs: none,
        applier: SelfAppliedBySpawner
      )
  }
}

fn dashboard_container_provision() -> ContainerProvisionResult {
  match container_baseline_bytes(c: session_dashboard_container) {
    BaselineUnmeasured { reason: _ } =>
      ProvisionRefused { reason: "dashboard container provision refused: session-dashboard idle baseline is unmeasured (no grounded reservation floor); fail closed rather than spawn an unreserved dashboard container" }
    BaselineResolved { bytes: idle } =>
      resolve_container_provision(
        per_unit_cap: gunbc_session_dashboard_reservation,
        mem_reservation: idle,
        cgroup_slice: gunbc_oomd_sessions_slice,
        cpu_shares: gunbc_container_cpu_shares,
        pids_max: gunbc_container_pids_max,
        cargo_build_jobs: none,
        applier: ExternallyApplied
      )
  }
}

fn fleet_host_plan_for_offer(
  offer: ComputeOffer,
  overhead: ByteSize,
  session_slice: ByteSize,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      FleetHostPlanUnsound { reason: "compute offer has no primary CPU facts: refuse to derive a host plan without a measured core count (the CPU-core runner cap needs nproc; fail closed)" }
    Present { value: cpu } =>
      fleet_host_plan_for(
        name: offer.supply.physical.identity,
        host: compute_host_ram_bytes_total(host: offer.supply.physical),
        overhead: overhead,
        nproc: cpu_facts_threads(cpu: cpu),
        runner: gha_runner_container,
        session_slice: session_slice,
        citation: citation,
        policy: policy,
        oomd: oomd
      )
  }
}
