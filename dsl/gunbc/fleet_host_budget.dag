fn build_cost_account(cfg: CtrlJobserverConfig) -> CostAccount<Nano> {
  CostAccount {
    time: time_measure(count: 0),
    space: cfg.mib_per_job,
    power: watt(count: 0),
    basis: Predicted,
  }
}

fn build_realization(cfg: CtrlJobserverConfig) -> RealizedStep<Nano> {
  RealizedStep {
    shape: CreateEffect { cause: CreateIfAbsent { key_source: CompositeKey { fields: ["compile_unit_content_hash", "toolchain_content_hash"] } } },
    placement: LocalFilesystem,
    materialization: Share,
    cost: build_cost_account(cfg: cfg),
  }
}

type HeadroomPolicy
  = HeadroomSet { bytes: ByteSize }
  | HeadroomUnset

data gunbc_fleet_headroom_policy: HeadroomPolicy = HeadroomUnset

data gunbc_fleet_oomd_floor_basis: String = "oomd_actuation_floor is a DERIVED lower bound on free host memory: systemd-oomd needs free headroom to evict a runaway cgroup BEFORE the kernel OOM-killer/livelock fires (the srv2-reboot vector). Basis: a fixed fraction of host RAM (1/16 = ~6.25%) as the minimum free-memory swing oomd needs to actuate; on a 125GiB host this is ~7.8GiB. This is the floor BELOW which a HeadroomSet policy is unsound (it leaves oomd no room to act). Derived, not a literal: scales with host. dissolve-on a measured oomd MemoryPressureLimit + swap-free actuation window once systemd-oomd is live (operator fix-manifest item 8)."

fn oomd_actuation_floor(host: ByteSize) -> ByteSize {
  measure_scale_fraction_floor(m: host, num: 1, den: 16)
}

type HeadroomResolution
  = HeadroomResolved { bytes: ByteSize }
  | HeadroomUnsound { reason: String }

fn resolve_headroom(policy: HeadroomPolicy, floor: ByteSize) -> HeadroomResolution {
  match policy {
    HeadroomUnset => HeadroomUnsound { reason: "headroom policy unset" }
    HeadroomSet { bytes: b } =>
      if byte_size_count(b: b) >= byte_size_count(b: floor) {
        HeadroomResolved { bytes: b }
      } else {
        HeadroomUnsound { reason: "below oomd actuation floor" }
      }
  }
}



fn gunbc_fleet_oomd_evidence_for(mode: SessionReservationMode) -> OomdEnforcementEvidence {
  match mode {
    Regime2AggregateOomd { oomd_eviction_ceiling: ceiling, session_concurrency: _, aggregate_reservation: agg } =>
      gunbc_oomd_fleet_evidence(req: OomdGroundingThresholds {
        per_session_cap: ceiling,
        parent_slice_cap: agg,
        pressure_limit: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit,
      })
    Regime1WorstCase { point: _ } => OomdUnverified
    SessionReservationModeUnset => OomdUnverified
  }
}

data gunbc_fleet_oomd_evidence: OomdEnforcementEvidence = gunbc_fleet_oomd_evidence_for(mode: gunbc_ci_session_reservation_mode)


fn appropriation_of(b: ByteSize) -> Appropriation<Memory, One> {
  Appropriation { ceiling: b }
}

fn overhead_claim(overhead: ByteSize) -> BudgetClaim {
  BudgetClaim {
    item: LineItem { purpose: "host_fixed_overhead", amount: overhead },
    priority: Guaranteed,
  }
}

fn host_ram_of(offer: ComputeOffer) -> ByteSize {
  compute_host_ram_bytes_total(host: offer.supply.physical)
}

fn child_node(name: String, b: ByteSize) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: b),
    claims: [],
    children: [],
  }
}


fn host_fixed_overhead_bytes(o: HostFixedOverhead) -> ByteSize {
  match o {
    HostFixedOverheadMeasured { bytes: b } => b
    HostFixedOverheadUnmeasured => byte_size(0)
  }
}

fn runner_slice_cap(host: ByteSize, overhead: ByteSize, headroom: ByteSize) -> ByteSize {
  let after_overhead = byte_size_saturating_sub(total: host, reserved: overhead)
  byte_size_saturating_sub(total: after_overhead, reserved: headroom)
}

type RunnerSlotMemoryContract {
  memory_max: ByteSize
  memory_high: ByteSize
  memory_swap_max: ByteSize
}

data gunbc_runner_slot_memory_contract_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "product.compute_fabric",
    decl_name: "connect",
    field: WholeDeclaration
  }
}

data gunbc_runner_slot_memory_contract: RunnerSlotMemoryContract = RunnerSlotMemoryContract {
  memory_max: byte_size(25769803776),
  memory_high: byte_size(15032385536),
  memory_swap_max: byte_size(8589934592),
}

data gunbc_per_runner_memory_cap: ByteSize = gunbc_runner_slot_memory_contract.memory_max

data gunbc_per_runner_swap_cap: ByteSize = gunbc_runner_slot_memory_contract.memory_swap_max

data gunbc_per_runner_memory_high: ByteSize = gunbc_runner_slot_memory_contract.memory_high

data gunbc_declared_runner_slot_count: Int = 10

data gunbc_host_swap_available: ByteSize = byte_size(8589934592)

data gunbc_ci_heavy_job_working_set: ByteSize = byte_size(11811160064)

fn runner_ram_overcommit_per_host(
  slot_count: Int,
  contract: RunnerSlotMemoryContract,
  slice_cap: ByteSize
) -> ByteSize {
  byte_size_saturating_sub(
    total: fabric_contract_memory_demand_per_host(slot_count: slot_count, contract: contract),
    reserved: slice_cap
  )
}

fn runner_swap_backs_ram_overcommit(
  slot_count: Int,
  contract: RunnerSlotMemoryContract,
  slice_cap: ByteSize,
  host_swap: ByteSize
) -> Bool {
  measure_le(
    a: runner_ram_overcommit_per_host(slot_count: slot_count, contract: contract, slice_cap: slice_cap),
    b: host_swap
  )
}

fn effective_heavy_job_concurrency(slice_cap: ByteSize, working_set: ByteSize) -> Int {
  measure_fit_count_floor(capacity: slice_cap, each: working_set)
}

fn fabric_host_allocatable_runner_memory(offer: ComputeOffer, overhead: ByteSize) -> ByteSize {
  let host_ram = compute_host_ram_bytes_total(host: offer.supply.physical)
  let headroom = oomd_actuation_floor(host: host_ram)
  runner_slice_cap(host: host_ram, overhead: overhead, headroom: headroom)
}

fn fabric_total_allocatable_runner_memory(offers: List<ComputeOffer>, overhead: ByteSize) -> ByteSize {
  fold(
    offers,
    init: byte_size(0),
    f: (acc, o) => measure_add(a: acc, b: fabric_host_allocatable_runner_memory(offer: o, overhead: overhead))
  )
}

fn fabric_host_count(offers: List<ComputeOffer>) -> Int {
  offers.length()
}

fn fabric_runner_slice_cap_per_host(offers: List<ComputeOffer>, overhead: ByteSize) -> ByteSize {
  let count = fabric_host_count(offers: offers)
  let divisor = if count <= 0 { 1 } else { count }
  measure_scale_fraction_floor(
    m: fabric_total_allocatable_runner_memory(offers: offers, overhead: overhead),
    num: 1,
    den: divisor
  )
}

fn fabric_contract_memory_demand_per_host(slot_count: Int, contract: RunnerSlotMemoryContract) -> ByteSize {
  measure_scale_fraction_floor(m: contract.memory_max, num: slot_count, den: 1)
}

fn fabric_total_contract_memory_demand(
  offers: List<ComputeOffer>,
  slot_count: Int,
  contract: RunnerSlotMemoryContract
) -> ByteSize {
  measure_scale_fraction_floor(
    m: fabric_contract_memory_demand_per_host(slot_count: slot_count, contract: contract),
    num: fabric_host_count(offers: offers),
    den: 1
  )
}

fn fabric_memory_accounting_admissible(
  offers: List<ComputeOffer>,
  overhead: ByteSize,
  slot_count: Int,
  contract: RunnerSlotMemoryContract,
  host_swap: ByteSize
) -> Bool {
  let capacity = fabric_total_allocatable_runner_memory(offers: offers, overhead: overhead)
  let demand = fabric_total_contract_memory_demand(offers: offers, slot_count: slot_count, contract: contract)
  measure_le(a: demand, b: capacity)
    || measure_le(a: contract.memory_swap_max, b: host_swap)
}

fn fabric_effective_heavy_job_concurrency(offers: List<ComputeOffer>, overhead: ByteSize, working_set: ByteSize) -> Int {
  effective_heavy_job_concurrency(
    slice_cap: fabric_total_allocatable_runner_memory(offers: offers, overhead: overhead),
    working_set: working_set
  )
}

data gunbc_runner_slice_cap: ByteSize = fabric_runner_slice_cap_per_host(
  offers: fleet_intent_offers,
  overhead: host_fixed_overhead_bytes(o: gunbc_ci_host_fixed_overhead)
)

data gunbc_runner_pool_budget: ByteSize = gunbc_runner_slice_cap

data gunbc_runner_standalone_memory_contract_basis: String = "Fabric-level runner budget (operator 2026-07-01 reframe): authority is Σ(contracts) ≤ Σ(capacity) across fleet_intent_offers — hosts are fungible opportunities, not per-host literals. RunnerSlotMemoryContract (burst: high=14GiB, max=24GiB, swap=8GiB/slot) is the workload contract; gunbc_runner_slice_cap is a REALIZATION projection (systemd slice MemoryMax per host) derived via fabric_runner_slice_cap_per_host = Σallocatable / host_count, NOT a hardcoded 80G input. fabric_effective_heavy_job_concurrency = Σallocatable / working_set (~11GiB), emitted on runner-deploy manifest. Burst overcommit when Σ(memory_max) exceeds Σ(allocatable) is ADMISSIBLE (not aggregate-sound) only if per-slot memory_swap_max ≤ host swap pool — operator intent: any single slot may page up to its cgroup swap cap against the shared host pool; fabric_memory_accounting_admissible gates runner_deployment_plan. srv3 is mixed (runners+sessions), not dedicated. session_pool dropped from runner budget (cool-swift P4). dissolve-on: product.compute_fabric connect() memory axis + clever-raven orchestration emit."

fn host_allocation_tree(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: "host_allocation",
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "runner_pool", b: runner_pool),
      child_node(name: "headroom", b: headroom),
    ],
  }
}

fn host_allocation_conserves(
  host: ByteSize,
  overhead: ByteSize,
  headroom: ByteSize,
  runner_pool: ByteSize
) -> Bool {
  node_conserves(node: host_allocation_tree(
    host: host,
    overhead: overhead,
    headroom: headroom,
    runner_pool: runner_pool
  ))
}

fn declared_runner_count() -> Int {
  gunbc_declared_runner_slot_count
}

fn runner_slice_node(runner_slice: ByteSize, runner_baseline: ByteSize) -> BudgetNode {
  BudgetNode {
    name: "runner_slice",
    appropriation: appropriation_of(b: runner_slice),
    claims: [],
    children: [child_node(name: "runner_idle_baseline", b: runner_baseline)],
  }
}

fn fleet_host_budget_tree(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  runner_baseline: ByteSize,
  headroom: ByteSize,
  runner_slice: ByteSize
) -> BudgetNode {
  BudgetNode {
    name: name,
    appropriation: appropriation_of(b: host),
    claims: [overhead_claim(overhead: overhead)],
    children: [
      child_node(name: "headroom", b: headroom),
      runner_slice_node(runner_slice: runner_slice, runner_baseline: runner_baseline),
    ],
  }
}


fn runner_slice_cap_drifted(disk_cap: ByteSize, effective: RunnerSliceCapEffectiveness) -> Bool {
  match effective {
    CapUnbounded => true
    CapEffective { bytes: b } => !(byte_size_count(b: disk_cap) == byte_size_count(b: b))
  }
}

type FleetHostPlan
  = FleetHostPlanDerived {
      name: String,
      tree: BudgetNode,
      runner_slice_cap: ByteSize,
      effective_build_tokens: HardwareThreadCount,
      effective_runner_cpu_cap: HardwareThreadCount,
      build_step: RealizedStep<Nano>
    }
  | FleetHostPlanUnsound { reason: String }

fn fleet_host_plan_for(
  name: String,
  host: ByteSize,
  overhead: ByteSize,
  nproc: HardwareThreadCount,
  runner: FleetContainerType,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match oomd {
    OomdUnverified =>
      FleetHostPlanUnsound { reason: "oomd enforcement unverified: systemd-oomd is the eviction backstop (srv2-reboot fix + the conservation keystone); refuse to derive a host plan without it (fail closed)" }
    OomdEnforced =>
      match citation {
        CtrlJobserverAbsent =>
          FleetHostPlanUnsound { reason: "ctrl-jobserver config citation absent: refuse to derive the build token bound without the cited installer knobs (margin / mem_reserve / mib_per_job)" }
        CtrlJobserverCited { config: cfg, provenance: _ } =>
          match container_baseline_bytes(c: runner) {
            BaselineUnmeasured { reason: r } => FleetHostPlanUnsound { reason: r }
            BaselineResolved { bytes: rb } => {
              let floor = oomd_actuation_floor(host: host)
              match resolve_headroom(policy: policy, floor: floor) {
                HeadroomUnsound { reason: r } => FleetHostPlanUnsound { reason: r }
                HeadroomResolved { bytes: hr } => {
                  let slice = runner_slice_cap(host: host, overhead: overhead, headroom: hr)
                  let tree = fleet_host_budget_tree(name: name, host: host, overhead: overhead, runner_baseline: rb, headroom: hr, runner_slice: slice)
                  FleetHostPlanDerived {
                    name: name,
                    tree: tree,
                    runner_slice_cap: slice,
                    effective_build_tokens: derive_jobserver_tokens(nproc: nproc, mem_total: host, cfg: cfg),
                    effective_runner_cpu_cap: cpu_cores_available(nproc: nproc, margin: cfg.margin),
                    build_step: build_realization(cfg: cfg),
                  }
                }
              }
            }
          }
      }
  }
}

fn fleet_host_plan() -> FleetHostPlan {
  fleet_host_plan_for(
    name: "fleet_host",
    host: byte_size(134217728000),
    overhead: byte_size(17179869184),
    nproc: hardware_thread_count(count: 128),
    runner: gha_runner_container,
    citation: ctrl_jobserver_config,
    policy: gunbc_fleet_headroom_policy,
    oomd: gunbc_fleet_oomd_evidence
  )
}


fn fleet_host_plan_for_offer(
  offer: ComputeOffer,
  overhead: ByteSize,
  citation: CtrlJobserverCitation,
  policy: HeadroomPolicy,
  oomd: OomdEnforcementEvidence
) -> FleetHostPlan {
  match compute_host_primary_cpu(host: offer.supply.physical) {
    Absent =>
      FleetHostPlanUnsound { reason: "compute offer has no primary CPU facts: refuse to derive a host plan without a measured core count (the CPU-core runner cap needs nproc; fail closed)" }
    Present { value: cpu } =>
      fleet_host_plan_for(
        name: offer.supply.physical.identity,
        host: compute_host_ram_bytes_total(host: offer.supply.physical),
        overhead: overhead,
        nproc: cpu_facts_threads(cpu: cpu),
        runner: gha_runner_container,
        citation: citation,
        policy: policy,
        oomd: oomd
      )
  }
}
