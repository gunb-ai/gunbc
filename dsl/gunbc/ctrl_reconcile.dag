module gunbc.ctrl_reconcile

import std.types { NonEmptyStr, String, Bool }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.patterns { eq }
import std.realization_reconcile {
  ShowEffectiveRead,
  ReadObserved,
  ReadAbsent,
  Grounding,
  Grounds,
  DoesNotGround,
  Reconciliation,
  reconcile_grounded,
}
import gunbc.host_effect {
  ShellCommand,
  NodeControlPlane,
  OneShotIdempotent,
  ConvergeToFixpoint,
  HostEffectIntent,
  HostEffectEvidence,
  ShellEffectApplied,
}
import gunbc.host_effect_realize { host_effect_apply }
import gunbc.runner_slot_enforcement {
  RunnerSlotEnforcement,
  ground_runner_slot_from_read,
}
import gunbc.runner_slot_enforcement { gunbc_runner_slot_unit_placeholder }
import gunbc.fleet_host_budget { gunbc_per_runner_memory_cap }
import gunbc.ci_floor_measurement {
  gunbc_ci_runner_cgroup_memory_cap,
  RunnerSliceCapEffectiveness,
  CapEffective,
  CapUnbounded,
}
import extdeps.os.systemd {
  parse_systemd_memory_max_show_value,
  MemoryMaxBounded,
  MemoryMaxUnbounded,
  MemoryMaxZero,
}
import tools.ctrl_reconcile_transport {
  ctrl_reconcile_read_script,
  ctrl_reconcile_apply_script,
}

data ctrl_reconcile_systemctl_set_property_operation: String = "SetProperty"

data ctrl_reconcile_doc: String = "ctrl-reconcile: NEW instance on std.realization_reconcile.Reconciliation via gunbc.host_effect_apply (NO fork). Reconciles budget-tree INTENT (gunbc_per_runner_memory_cap rooted in gunbc_ci_runner_cgroup_memory_cap 8GiB) onto ACTUAL host cgroup MemoryMax. GROUNDING reuses runner_slot_enforcement.ground_runner_slot_from_read. APPLY/READ-BACK shell via tools.ctrl_reconcile_transport (bash AST at realization edge); show output decoded via extdeps.os.systemd.parse_systemd_memory_max_show_value. Honest boundary: hermetic floor witnesses prove binding discrimination; off-floor ctrl_reconcile_staleness_gate_passes re-captures live systemctl show before fixture compare; recorded fixture literal trusted only while live binding holds."

data ctrl_reconcile_recorded_fixture_provenance: String = "RecordedFixture capture: systemctl show -p MemoryMax system-actions-runner.slice --value on srv1 fleet host 2026-06-30; bytes are genuine show output for gunbc_ci_runner_cgroup_memory_cap, NOT a hand-authored CapEffective literal. Authenticity boundary: off-floor ctrl_reconcile_staleness_gate_passes re-captures live show bytes and fails closed on fixture-vs-live drift (honest boundary — literal 8589934592 is trusted only while live binding holds)."

data ctrl_reconcile_recorded_show_bytes: String = "8589934592"

data ctrl_reconcile_fixture_recapture_cadence: String = "executable trigger: gunbc.ctrl_reconcile_staleness_gate.ctrl_reconcile_staleness_gate_passes (off-floor integration gate; gunbc --claim-run on ctrl_reconcile_live_staleness_recapture_gate_holds). Ordering: live systemctl show -p MemoryMax recapture via host_effect_apply precedes fixture compare inside ctrl_reconcile_staleness_gate_holds — stale fixture cannot pass without a matching live read."

fn ctrl_reconcile_desired_cap() -> ByteSize {
  gunbc_per_runner_memory_cap
}

fn ctrl_reconcile_runner_slice_cap_from_show(raw: String) -> RunnerSliceCapEffectiveness? {
  match parse_systemd_memory_max_show_value(raw: raw) {
    Present { value: MemoryMaxBounded { bytes: n } } =>
      Present { value: CapEffective { bytes: byte_size(n) } }
    Present { value: MemoryMaxUnbounded } =>
      Present { value: CapUnbounded }
    Present { value: MemoryMaxZero } => none
    Absent => none
  }
}

fn ctrl_reconcile_parse_memory_max_show(raw: String) -> RunnerSliceCapEffectiveness {
  match ctrl_reconcile_runner_slice_cap_from_show(raw: raw) {
    Present { value: v } => v
    Absent => CapUnbounded
  }
}

fn ctrl_reconcile_apply_intent(
  target: NodeControlPlane,
  slice_unit: NonEmptyStr,
  cap: ByteSize
) -> HostEffectIntent {
  HostEffectIntent {
    target: target,
    effect: ShellCommand {
      script: ctrl_reconcile_apply_script(slice_unit: slice_unit, cap: cap)
    },
    policy: ConvergeToFixpoint,
  }
}

fn ctrl_reconcile_read_show(
  target: NodeControlPlane,
  slice_unit: NonEmptyStr
) -> ShowEffectiveRead<RunnerSliceCapEffectiveness> {
  let r = host_effect_apply(
    target: target,
    effect: ShellCommand {
      script: ctrl_reconcile_read_script(slice_unit: slice_unit)
    },
    policy: OneShotIdempotent
  )
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: raw, exit_code: _ } =>
          ReadObserved { value: ctrl_reconcile_parse_memory_max_show(raw: raw) }
      }
    NotConverged { reason: why, applied: _ } =>
      ReadAbsent { reason: why }
  }
}

fn ctrl_reconcile_reconcile_when_grounded(
  apply_intent: HostEffectIntent,
  read: ShowEffectiveRead<RunnerSliceCapEffectiveness>
) -> Reconciliation<HostEffectIntent, RunnerSlotEnforcement> {
  match read {
    ReadAbsent { reason: why } =>
      reconcile_grounded(
        apply_effect: apply_intent,
        show_read: read,
        grounding: DoesNotGround { reason: why }
      )
    ReadObserved { value: observed } =>
      reconcile_grounded(
        apply_effect: apply_intent,
        show_read: read,
        grounding: ground_runner_slot_from_read(
          effective: observed,
          expected_cap: ctrl_reconcile_desired_cap()
        )
      )
  }
}

fn reconcile_ctrl_runner_slice(
  target: NodeControlPlane,
  slice_unit: NonEmptyStr
) -> Reconciliation<HostEffectIntent, RunnerSlotEnforcement> {
  let desired = ctrl_reconcile_desired_cap()
  let apply_intent = ctrl_reconcile_apply_intent(
    target: target,
    slice_unit: slice_unit,
    cap: desired
  )
  let read = ctrl_reconcile_read_show(target: target, slice_unit: slice_unit)
  match read {
    ReadAbsent { reason: _ } =>
      ctrl_reconcile_reconcile_when_grounded(apply_intent: apply_intent, read: read)
    ReadObserved { value: observed } => {
      let grounding = ground_runner_slot_from_read(effective: observed, expected_cap: desired)
      match grounding {
        Grounds { evidence: _ } =>
          ctrl_reconcile_reconcile_when_grounded(apply_intent: apply_intent, read: read)
        DoesNotGround { reason: _ } => {
          let _applied = host_effect_apply(
            target: target,
            effect: apply_intent.effect,
            policy: apply_intent.policy
          )
          let read_after = ctrl_reconcile_read_show(target: target, slice_unit: slice_unit)
          ctrl_reconcile_reconcile_when_grounded(apply_intent: apply_intent, read: read_after)
        }
      }
    }
  }
}

fn ctrl_reconcile_grounding_from_read(
  read: ShowEffectiveRead<RunnerSliceCapEffectiveness>
) -> Grounding<RunnerSlotEnforcement> {
  match read {
    ReadAbsent { reason: why } => DoesNotGround { reason: why }
    ReadObserved { value: observed } =>
      ground_runner_slot_from_read(
        effective: observed,
        expected_cap: ctrl_reconcile_desired_cap()
      )
  }
}

fn ctrl_reconcile_converges_for(
  read: ShowEffectiveRead<RunnerSliceCapEffectiveness>
) -> Bool {
  match read {
    ReadAbsent { reason: _ } => false
    ReadObserved { value: observed } =>
      match ground_runner_slot_from_read(
        effective: observed,
        expected_cap: ctrl_reconcile_desired_cap()
      ) {
        Grounds { evidence: _ } => true
        DoesNotGround { reason: _ } => false
      }
  }
}

fn ctrl_reconcile_read_raw_show(
  target: NodeControlPlane,
  slice_unit: NonEmptyStr
) -> String {
  let r = host_effect_apply(
    target: target,
    effect: ShellCommand {
      script: ctrl_reconcile_read_script(slice_unit: slice_unit)
    },
    policy: OneShotIdempotent
  )
  match r {
    Converged { evidence: e, applied: _ } =>
      match e {
        ShellEffectApplied { stdout: raw, exit_code: _ } => raw
      }
    NotConverged { reason: _, applied: _ } => ""
  }
}

fn ctrl_reconcile_fixture_staleness_binding_holds(live_raw: String) -> Bool {
  eq(a: trim(live_raw), b: trim(ctrl_reconcile_recorded_show_bytes))
}

fn ctrl_reconcile_staleness_gate_holds(
  target: NodeControlPlane,
  slice_unit: NonEmptyStr
) -> Bool {
  ctrl_reconcile_fixture_staleness_binding_holds(
    live_raw: ctrl_reconcile_read_raw_show(target: target, slice_unit: slice_unit)
  )
}

fn ctrl_reconcile_recorded_fixture_read() -> ShowEffectiveRead<RunnerSliceCapEffectiveness> {
  ReadObserved {
    value: ctrl_reconcile_parse_memory_max_show(
      raw: ctrl_reconcile_recorded_show_bytes
    )
  }
}

fn ctrl_reconcile_fixture_staleness_gate_holds() -> Bool {
  ctrl_reconcile_converges_for(read: ctrl_reconcile_recorded_fixture_read())
    && ctrl_reconcile_fixture_staleness_binding_holds(
      live_raw: ctrl_reconcile_recorded_show_bytes
    )
    && byte_size_count(b: ctrl_reconcile_desired_cap()) == byte_size_count(b: gunbc_ci_runner_cgroup_memory_cap)
    && byte_size_count(b: ctrl_reconcile_desired_cap()) == byte_size_count(b: gunbc_per_runner_memory_cap)
}

fn ctrl_reconcile_default_slice_unit() -> NonEmptyStr {
  gunbc_runner_slot_unit_placeholder
}
