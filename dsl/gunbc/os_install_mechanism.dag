module gunbc.os_install_mechanism

import std.types { Bool }
import std.bmc { OpenBmc }
import extdeps.bmc.capability {
  BmcFirmwareCapabilityRow,
  CapabilityVirtualMedia,
  CapabilityFirmwareUpdate,
  firmware_exposes,
  catalog_has_firmware_with,
  openbmc_2_07_00_capabilities,
  bmc_firmware_capability_catalog,
}

data os_install_mechanism_doc: String = "The OS-install mechanism is a SOLVE over the capabilities the node's actual BMC firmware exposes, not a hardcoded choice (the operator's directive: model board/BMC as a dependency solve). VirtualMediaInstall is PREFERRED -- it mounts the install ISO straight to the host through the BMC over HTTPS, so it needs NO PXE, NO proxyDHCP, NO install server, NO same-L2-segment, NO BIOS edit, and is Tailscale-agnostic (an out-of-band Redfish call, not an L2 broadcast). It is available IFF the firmware exposes CapabilityVirtualMedia. When VirtualMedia is absent but the firmware exposes CapabilityFirmwareUpdate AND the catalog knows a VirtualMedia-capable firmware for that family, the solved path is FirmwareUpdateThenVirtualMedia -- firmware update is a CAPABILITY-ACQUIRING TRANSITION in the graph, not a manual one-off. Only when neither holds does it fall back to PxeHttpInstall, which drags in two physical preconditions PXE cannot escape: the BIOS UEFI network stack must be enabled (this board's firmware exposes no BIOS attribute config to set it remotely) and the install server must share an L2 broadcast domain with the boot NIC (PXE is L2-broadcast; it cannot cross a Tailscale overlay). So the mechanism is derived from inhabitance (§4): add one grounded VirtualMedia-capable firmware row to the catalog and a node's solve flips from PxeHttpInstall to FirmwareUpdateThenVirtualMedia with no edit here. GROUNDED FINDING for THIS board (2026-06-24, cited research): NO ASRockRack ALTRAD8UD-1L2T OpenBmc firmware exposes Redfish VirtualMedia -- not the installed 2.07.00, not the latest 03.22.00 (both rows in the catalog lack it; ASRockRack has not wired nbd-proxy/jsnbd into the Redfish schema). So on srv3 the solve correctly stays PxeHttpInstall and FirmwareUpdateThenVirtualMedia is UNREACHABLE via firmware update -- the lever is sound but has no inhabitant for this board's firmware line. It remains valid for boards/BMCs whose OEM DID wire Redfish VirtualMedia (the model is board-agnostic). The honest consequence: an automatable remote install on srv3 today is PXE (BIOS network stack enabled out-of-band via host UEFI once or ASRockRack MgmtTool IPMI-OEM, + same-L2-segment), OR the manual WebUI-KVM virtual-media attach (not API-modeled)."

type OsInstallMechanism =
    VirtualMediaInstall
  | PxeHttpInstall
  | FirmwareUpdateThenVirtualMedia

fn solve_install_mechanism(row: BmcFirmwareCapabilityRow, virtual_media_capable_firmware_available: Bool) -> OsInstallMechanism {
  if firmware_exposes(row: row, cap: CapabilityVirtualMedia) {
    VirtualMediaInstall
  } else {
    if firmware_exposes(row: row, cap: CapabilityFirmwareUpdate) && virtual_media_capable_firmware_available {
      FirmwareUpdateThenVirtualMedia
    } else {
      PxeHttpInstall
    }
  }
}

data srv3_install_mechanism: OsInstallMechanism = solve_install_mechanism(
  row: openbmc_2_07_00_capabilities,
  virtual_media_capable_firmware_available: catalog_has_firmware_with(
    catalog: bmc_firmware_capability_catalog,
    family: OpenBmc,
    cap: CapabilityVirtualMedia,
  ),
)
