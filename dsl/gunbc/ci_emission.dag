// gunbc/ci_emission.dag — T-WAD WI-2 / Slice 4: `WorkflowRuntime` + `project_github_actions`.
//
// `.github/workflows/ci.yml` remains the hand-edited workflow authority until the T-24 CI model
// emits it. `CIWorkflowDag` in `dsl/gunbc/ci.dag` carries gate topology only; Actions transport
// projection is deferred to T-24 `src/v4/workflow/ci.dag`.
//
// `project_github_actions(..., BinaryShim)` emits a thin single-job workflow that invokes the
// compiled `gunbc-ci` runner. Transport-arm selection, not a second gate-topology editor.

module gunbc.ci_emission

import gunbc.ci { CIWorkflowDag, ci_workflow_dag }
import extdeps.github.actions {
  Workflow, Job, RunStep, UsesStep,
  HostedRunner, UbuntuLatest,
  Bash,
  WorkflowTrigger, Push, PullRequest,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview,
  WorkflowPermissions, PermRead, PermWrite, PermNone,
  ConcurrencySpec, ConcurrencyMappingQueueNotMax,
  CancelInProgressSpec, CancelInProgressBool
}

// 🟡 YELLOW (scaffold) — coproduct-dissolution receipt (see modeling-discipline Practice 4).
// Ratified initial surface: BinaryShim only until T-24 YamlStatic emission lands.
// YamlStatic dissolved with the interim hand-sync carrier `ci_github_actions_workflow.dag`.
// PythonShim and InlineGunbc stay off the enum until a real runtime consumer
// lands with the corresponding substrate-prereq PR.

// Leading pipe marks a single-variant nullary sum (deliberate novel tag), not a
// bare alias to an existing type — the latter fails closed on an unknown RHS.
type WorkflowRuntime = | BinaryShim

// Slice 5: BinaryShim thin-shim `Workflow` projection (design-ci-workflow-emitter-dispatch.md §5.2).
//
// Workflow-level envelope fields are minimal placeholders until T-24 projection reads
// `src/v4/workflow/ci.dag` directly. The structural deviation from the live ci.yml transport is
// `jobs`: BinaryShim collapses the full gate matrix into a single bootstrap job whose only `run:`
// invokes the compiled `gunbc-ci` runner. The binary at runtime reads `CIWorkflowDag` and
// dispatches the gate matrix (Slice 7 / PR #2713 affected-set lens territory).
//
// Binary `main()` and affected-set selection are out of scope — the arm
// emits a `Workflow` that *references* the binary, not the binary itself.
fn gunbc_ci_emission_binary_shim_workflow(dag: CIWorkflowDag) -> Workflow = {
  name: "ci",
  on: [Push { branches: ["main"], paths: [] }, PullRequest { branches: ["main"], types: [Opened, Synchronize, Reopened, ReadyForReview] }],
  concurrency: Some {
    value: ConcurrencyMappingQueueNotMax {
      group: "${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}",
      cancel_in_progress: Some { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  jobs: [{
      id: "ci",
      name: none,
      runner: HostedRunner { label: UbuntuLatest },
      steps: [UsesStep {
          name: Some { value: "Checkout" },
          id: none,
          uses: { owner: "actions", repo: "checkout", ref: "v4" },
          with: none,
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Invoke gunbc-ci runner" },
          id: none,
          run: "./gunbc-ci --workflow ci --event \"$GITHUB_EVENT_PATH\"",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }],
      needs: [],
      env: none,
      outputs: none,
      if_condition: none,
      strategy: none,
      timeout_minutes: none,
      continue_on_error: false,
      concurrency: none
    }],
  env: { "CARGO_TERM_COLOR": "always", "RUSTFLAGS": "-D warnings", "FORCE_JAVASCRIPT_ACTIONS_TO_NODE24": "true" },
  permissions: Some {
    value: {
      contents: PermRead,
      pull_requests: PermRead,
      issues: PermNone,
      actions: PermNone
    }
  }
}

// v3 tokenizer maps `fn`, not legacy `func` (which becomes `Ident("func")` and fails top-level dispatch).
fn project_github_actions(dag: CIWorkflowDag, runtime: WorkflowRuntime) -> Workflow =
  match runtime {
    BinaryShim => gunbc_ci_emission_binary_shim_workflow(dag)
  }
