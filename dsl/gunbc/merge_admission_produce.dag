module gunbc.merge_admission_produce

import std.types { ContentHash, CommitSha, String, Int, List, Bool }
import extdeps.github.checks {
  CheckConclusion,
  check_conclusion_wire_label,
  parse_check_conclusion,
  Success,
}
import gunbc.merge_admission {
  MergeAdmissionReceipt,
  mint_merge_admission_receipt,
  current_gate_roster_hash,
}
import gunbc.ci_spec { gunbc_ci_spec, ci_repo_root_shell }
import gunbc.ci_layer_roots { witness_layer_roots, witness_layer_source_flags }

data merge_admission_receipt_schema: String = "gunbc.merge_admission_receipt.v1"

data merge_admission_receipt_rel_path: String = ".gunbc/merge-admission-receipt.wire"

fn merge_admission_receipt_path(root: String) -> String {
  concat(concat(root, "/"), merge_admission_receipt_rel_path)
}

fn render_receipt_wire(receipt: MergeAdmissionReceipt) -> String {
  concat(
    concat(
      concat(
        concat(receipt.base_tree_hash, "\n"),
        concat(receipt.gate_roster_hash, "\n")
      ),
      concat(check_conclusion_wire_label(c: receipt.conclusion), "\n")
    ),
    concat(
      concat(receipt.head_sha, "\n"),
      to_string(receipt.pr_number)
    )
  )
}

fn receipt_wire_lines(text: String) -> List<String> {
  split(s: text, delimiter: "\n")
}

fn parse_receipt_wire(text: String) -> MergeAdmissionReceipt? {
  let lines = receipt_wire_lines(text: text)
  if length(lines) < 3 {
    none
  } else {
    match parse_check_conclusion(raw: lines.skip(n: 2).first()) {
      Present { value: conclusion } =>
        Present {
          value: MergeAdmissionReceipt {
            pr_number: 0,
            head_sha: if length(lines) > 3 { lines.skip(n: 3).first() } else { "" },
            base_tree_hash: lines.first(),
            gate_roster_hash: lines.skip(n: 1).first(),
            conclusion: conclusion,
          }
        }
      Absent => none
    }
  }
}

fn gunbc_run_bin_shell() -> String {
  "\"$ROOT/target/release/gunbc\" run"
}

fn merge_admission_stamp_invoke() -> String {
  concat(
    concat(
      concat(gunbc_run_bin_shell(), witness_layer_source_flags(roots: witness_layer_roots)),
      " --entry dsl/tools/merge_admission_stamp.dag --function main"
    ),
    "\n"
  )
}

fn merge_admission_gate_invoke() -> String {
  concat(
    concat(
      concat(gunbc_run_bin_shell(), witness_layer_source_flags(roots: witness_layer_roots)),
      " --entry dsl/tools/merge_admission_gate.dag --function main"
    ),
    "\n"
  )
}

fn ci_merge_admission_stamp_script() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    merge_admission_stamp_invoke()
  )
}

fn ci_merge_admission_gate_script() -> String {
  concat(
    concat(
      concat("ROOT=", ci_repo_root_shell(), "\n"),
      concat(git_fetch_script_for_gate(), "\n")
    ),
    merge_admission_gate_invoke()
  )
}

fn git_fetch_script_for_gate() -> String {
  let parts = split(s: gunbc_ci_spec.diff_policy.base, delimiter: "/")
  let remote = parts.first()
  let ref_name = fold(parts.skip(n: 1), init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, "/"), p) })
  concat(
    concat(concat("git fetch --no-tags ", remote), " "),
    concat(ref_name, " 2>/dev/null || true")
  )
}

fn stamp_success_receipt(
  pr_number: Int,
  head_sha: CommitSha,
  base_tree_hash: ContentHash,
) -> MergeAdmissionReceipt {
  mint_merge_admission_receipt(
    pr_number: pr_number,
    head_sha: head_sha,
    base_tree_hash: base_tree_hash,
    gate_roster_hash: current_gate_roster_hash,
    conclusion: Success,
  )
}
