module gunbc.live_deploy.apply

import gunbc.live_deploy.spec {
  DeploymentSpec,
  DeploymentEnsuredStep,
  deployment_spec_srv1,
}
import gunbc.live_deploy.emit {
  live_deploy_apply_script_for,
  live_deploy_retract_script_for,
  deployment_ensure_dependency_script,
}
import gunbc.ci_deploy_access {
  ci_deploy_srv1_access,
  DeployAccess,
  AccessDecision,
  Permit,
  Deny,
  deploy_access_check_observed,
  deploy_access_preflight_pass_message,
  deploy_access_decision_reason,
}
import gunbc.host_effect {
  ShellCommand,
  HostOs,
  OneShotIdempotent,
  HostEffectTransport,
  HostEffectIntent,
  HostEffectEvidence,
  ShellEffectApplied,
}
import gunbc.host_effect_realize { host_effect_apply_gated }
import std.realization_reconcile { Reconciliation, reconciliation_converged, Converged, NotConverged }
import std.process { ProcessExit, ExitSuccess, exit_failure }

fn live_deploy_ensure_dependency(
  spec: DeploymentSpec,
  dep: DeploymentEnsuredStep,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  host_effect_apply_gated(
    access: access,
    target: HostOs { node: spec.target.host },
    effect: ShellCommand { script: deployment_ensure_dependency_script(dep: dep) },
    policy: OneShotIdempotent,
    transport: transport,
    fixture_actor: Absent
  )
}

fn live_deploy_fold(
  spec: DeploymentSpec,
  script: String,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  host_effect_apply_gated(
    access: access,
    target: HostOs { node: spec.target.host },
    effect: ShellCommand { script: script },
    policy: OneShotIdempotent,
    transport: transport,
    fixture_actor: Absent
  )
}

fn live_deploy_apply_via_transport(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    script: live_deploy_apply_script_for(spec: spec),
    transport: transport,
    access: access
  )
}

fn live_deploy_retract_via_transport(
  spec: DeploymentSpec,
  transport: HostEffectTransport,
  access: DeployAccess
) -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  live_deploy_fold(
    spec: spec,
    script: live_deploy_retract_script_for(spec: spec),
    transport: transport,
    access: access
  )
}

fn live_deploy_access_preflight() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let access = ci_deploy_srv1_access
  let intent = HostEffectIntent {
    target: HostOs { node: access.host },
    effect: ShellCommand { script: "" },
    policy: OneShotIdempotent,
    transport: access.transport,
    privilege_denial: none,
  }
  let verdict = deploy_access_check_observed(access: access)
  match verdict {
    Permit =>
      Converged {
        evidence: ShellEffectApplied {
          exit_code: 0,
          stdout: deploy_access_preflight_pass_message(access: access),
        },
        applied: intent,
      }
    Deny { reason: _ } =>
      NotConverged {
        reason: deploy_access_decision_reason(d: verdict),
        applied: HostEffectIntent {
          target: HostOs { node: access.host },
          effect: ShellCommand { script: "" },
          policy: OneShotIdempotent,
          transport: access.transport,
          privilege_denial: Present { value: verdict },
        },
      }
  }
}

fn live_deploy_apply_srv1() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let access = ci_deploy_srv1_access
  live_deploy_apply_via_transport(
    spec: deployment_spec_srv1(),
    transport: access.transport,
    access: access
  )
}

fn live_deploy_retract_srv1() -> Reconciliation<HostEffectIntent, HostEffectEvidence> {
  let access = ci_deploy_srv1_access
  live_deploy_retract_via_transport(
    spec: deployment_spec_srv1(),
    transport: access.transport,
    access: access
  )
}

fn live_deploy_reconciliation_exit(r: Reconciliation<HostEffectIntent, HostEffectEvidence>) -> ProcessExit {
  if reconciliation_converged(r: r) {
    ExitSuccess
  } else {
    match r {
      NotConverged { reason: why, applied: _ } => exit_failure(reason: why)
      Converged { evidence: _, applied: _ } => ExitSuccess
    }
  }
}

func live_deploy_apply_srv1_wet() -> ProcessExit {
  let preflight = live_deploy_access_preflight()
  if !reconciliation_converged(r: preflight) {
    live_deploy_reconciliation_exit(r: preflight)
  } else {
    live_deploy_reconciliation_exit(r: live_deploy_apply_srv1())
  }
}

func live_deploy_retract_srv1_wet() -> ProcessExit {
  let preflight = live_deploy_access_preflight()
  if !reconciliation_converged(r: preflight) {
    live_deploy_reconciliation_exit(r: preflight)
  } else {
    live_deploy_reconciliation_exit(r: live_deploy_retract_srv1())
  }
}
