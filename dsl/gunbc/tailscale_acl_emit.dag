module gunbc.tailscale_acl_emit

import std.types { String, NonEmptyStr, List }
import extdeps.tailscale.acl {
  TailscaleGrant,
  TailscaleSshRule,
  TailscaleNodeAttr,
  TailscaleTagOwnerRow,
  operator_tailscale_acl_policy,
}

fn join_json_quoted(items: List<NonEmptyStr>) -> String {
  fold(items, init: "", f: (acc, x) => if acc == "" { concat("\"", concat(x, "\"")) } else { concat(concat(acc, ", \""), concat(x, "\"")) })
}

fn json_string_array(items: List<NonEmptyStr>) -> String {
  concat("[", concat(join_json_quoted(items: items), "]"))
}

fn emit_grant_row(g: TailscaleGrant) -> String {
  concat(
    concat(
      concat(
        concat("{\"src\": ", json_string_array(items: g.src)),
        concat(", \"dst\": ", json_string_array(items: g.dst))
      ),
      concat(", \"ip\": ", json_string_array(items: g.ip))
    ),
    "}"
  )
}

fn emit_grant_rows(grants: List<TailscaleGrant>) -> String {
  fold(grants, init: "", f: (acc, g) => if acc == "" { emit_grant_row(g: g) } else { concat(concat(acc, ",\n        "), emit_grant_row(g: g)) })
}

fn emit_ssh_rule(r: TailscaleSshRule) -> String {
  concat(
    concat(
      concat(
        concat(
          concat(
            concat("{\n            \"action\": \"", r.action),
            concat("\",\n            \"src\":    ", json_string_array(items: r.src))
          ),
          concat(",\n            \"dst\":    ", json_string_array(items: r.dst))
        ),
        concat(",\n            \"users\":  ", json_string_array(items: r.users))
      ),
      "\n        }"
    ),
    ""
  )
}

fn emit_ssh_rows(rules: List<TailscaleSshRule>) -> String {
  fold(rules, init: "", f: (acc, r) => if acc == "" { emit_ssh_rule(r: r) } else { concat(concat(acc, ",\n        "), emit_ssh_rule(r: r)) })
}

fn emit_node_attr_row(n: TailscaleNodeAttr) -> String {
  concat(
    concat(
      concat("{\"target\": ", json_string_array(items: n.target)),
      concat(", \"attr\": ", json_string_array(items: n.attr))
    ),
    "}"
  )
}

fn emit_node_attr_rows(attrs: List<TailscaleNodeAttr>) -> String {
  fold(attrs, init: "", f: (acc, n) => if acc == "" { emit_node_attr_row(n: n) } else { concat(concat(acc, ",\n        "), emit_node_attr_row(n: n)) })
}

fn emit_tag_owner_row(row: TailscaleTagOwnerRow) -> String {
  concat(
    concat(concat("        \"", row.tag), concat("\": ", json_string_array(items: row.owners))),
    ""
  )
}

fn emit_tag_owners(rows: List<TailscaleTagOwnerRow>) -> String {
  fold(rows, init: "", f: (acc, row) => if acc == "" { emit_tag_owner_row(row: row) } else { concat(concat(acc, ",\n"), emit_tag_owner_row(row: row)) })
}

fn expected_tailscale_acl_json() -> String {
  let policy = operator_tailscale_acl_policy
  concat(
    concat(
      concat(
        concat(
          concat(
            concat(
              concat(
                concat(
                  "{\n    \"grants\": [\n        ",
                  emit_grant_rows(grants: policy.grants)
                ),
                "\n    ],\n    \"ssh\": [\n        "
              ),
              emit_ssh_rows(rules: policy.ssh)
            ),
            "\n    ],\n    \"nodeAttrs\": [\n        "
          ),
          emit_node_attr_rows(attrs: policy.node_attrs)
        ),
        concat(
          concat(
            "\n    ],\n    \"tagOwners\": {\n",
            emit_tag_owners(rows: policy.tag_owners)
          ),
          "\n    }\n}\n"
        )
      ),
      ""
    ),
    ""
  )
}
