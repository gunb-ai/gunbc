module gunbc.host_effect

import std.types { String, Int }
import extdeps.bmc.types { RedfishSystemAction }
import product.compute_fabric { ComputeHost }

data host_effect_interface_doc: String = "The one host-operation interface (Phase A of host-effect-orchestration). apply(target: NodeControlPlane, effect: HostEffect, policy: Policy) -> Reconciliation reconciles a pure-intent effect against a control plane. ONE interface x N control-planes x N transports x N effect-kinds x N policies (DESIGN section 3): the two of-today regimes -- emit-artifact-then-thin-run and gunbc-run-over-ssh -- are realizations of this one shape, not two. This module holds ONLY the agnostic shapes; dispatch + transport are realization and sit peripheral in gunbc.host_effect_realize (DESIGN section 3 the-dispatch-that-selects-a-realization-is-itself-realization). Target-duality: a logical node has two control planes -- in-band HostOs (shell/systemd) and out-of-band BmcController (Redfish) -- so apply targets a control PLANE, not a host address; the target supplies the WHERE (resolved over fleet_intent), the effect is pure intent. HostEffect is a COPRODUCT of effect-kinds (a Redfish op is a typed action, not bash); an incompatible control-plane x effect-kind cell (RedfishAction at HostOs, ShellCommand at BmcController) is a typed mismatch via a total fold (DESIGN section 5), never a silent no-op. The outcome reuses std.realization_reconcile.Reconciliation -- NO second receipt grammar (DESIGN section 3 single-authority). Policy is the OneShotIdempotent vs ConvergeToFixpoint axis: it governs how a caller reads a NotConverged (terminal-this-pass vs re-drive), so neat-boar-71 Phase-C BMC poll-loop composes on top."

type HostEffect =
    ShellCommand { script: String }
  | RedfishAction { action: RedfishSystemAction }

type NodeControlPlane =
    HostOs { node: ComputeHost }
  | BmcController { node: ComputeHost }

type Policy = OneShotIdempotent | ConvergeToFixpoint

type HostEffectIntent {
  target: NodeControlPlane
  effect: HostEffect
  policy: Policy
}

type HostEffectEvidence =
    ShellEffectApplied { exit_code: Int, stdout: String }
