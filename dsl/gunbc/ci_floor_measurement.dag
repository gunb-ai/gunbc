module gunbc.ci_floor_measurement

import std.measure { ByteSize, byte_size }
import std.types { Int, List, String, Bool }
import std.realization_measurement {
  ConcurrentMemoryPeakSample,
  concurrent_memory_peak_per_share,
}
import std.disposition { Disposition, Scaffold, SingleAuthority, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data gunbc_ci_floor_measured_peak: ConcurrentMemoryPeakSample = ConcurrentMemoryPeakSample {
  peak: byte_size(11592347648)
  concurrency: 4
}

type PerShardRssPeakMeasurement
  = PerShardRssPeakMeasured { per_shard_peak: ByteSize, sample_width: Int }
  | PerShardRssPeakUnmeasured

data gunbc_ci_floor_per_shard_rss_measurement: PerShardRssPeakMeasurement = PerShardRssPeakMeasured {
  per_shard_peak: byte_size(4294967296)
  sample_width: 2
}

data gunbc_ci_floor_per_shard_rss_source: Disposition = Terminal {
  reason: "Conservative lower-bound from width=2 OOM observation (CI run 28215907472, 2026-06-26): at spawn_width=2 the runner cgroup (memory.max=8GiB) OOM-killed the executor. Lower bound on per-share: (8GiB - base~0.7GiB) / 2 ~= 3.65GiB; set conservatively to 4GiB (4294967296) so floor(8GiB*4/5 / 4GiB) = floor(1.6) = 1 -> width=1, guaranteed under cap. Prior VmHWM-based value (2100028416, run 27893441091) was stale and under-counted: VmHWM misses child-process RSS (rustc, sccache), and the uniform average (8.4GiB/4) under-estimates the heavy corpus-discovery shard. Dissolution path: run at width=1, capture cgroup peak via --measure-cgroup-peak, compute marginal per_shard via width-sweep slope (RSS(w2)-RSS(w1))/(w2-w1) with width-sweep from 1->2."
}

fn gunbc_ci_floor_per_shard_peak_rss_bytes() -> ByteSize {
  match gunbc_ci_floor_per_shard_rss_measurement {
    PerShardRssPeakMeasured { per_shard_peak: p, sample_width: _ } => p
    PerShardRssPeakUnmeasured => concurrent_memory_peak_per_share(sample: gunbc_ci_floor_measured_peak)
  }
}

fn gunbc_ci_floor_whole_run_peak_rss_bytes() -> ByteSize {
  gunbc_ci_floor_measured_peak.peak
}

data gunbc_ci_host_container_memory_cap: ByteSize = byte_size(33578549248)

data gunbc_ci_floor_runner_margin_num: Int = 6
data gunbc_ci_floor_runner_margin_den: Int = 5

data gunbc_ci_floor_conservative_fallback_width: Int = 4

type JobCgroupPeakMeasurement
  = JobCgroupPeakMeasured { cgroup_peak: ByteSize }
  | JobCgroupPeakUnmeasured

type CiJobPeak {
  job: String
  peak: JobCgroupPeakMeasurement
}

data gunbc_ci_job_peaks: List<CiJobPeak> = [
  CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(11811160064) } },
  CiJobPeak { job: "rust_tests", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(39728447488) } },
]


data gunbc_ci_run_count_divisor: ByteSize = byte_size(9985798963)


data gunbc_ci_runner_unit_cap_safety_margin_num: Int = 5
data gunbc_ci_runner_unit_cap_safety_margin_den: Int = 4


data gunbc_ci_per_session_peak_samples: List<ByteSize> = [
  byte_size(8879844884),
  byte_size(4584877588),
  byte_size(4370129224),
  byte_size(4284229878),
  byte_size(3167538381),
  byte_size(3103113871),
  byte_size(2952790016),
  byte_size(2211908157),
  byte_size(1352914698),
  byte_size(579820585),
  byte_size(504658657),
  byte_size(397284475),
  byte_size(300647711),
]


type SessionOperatingPoint
  = SessionOperatingPointSet { per_session_cap: ByteSize, session_concurrency: Int }
  | SessionOperatingPointUnset

type SessionAggregateReservation
  = SessionAggregateMeasured { bytes: ByteSize }
  | SessionAggregateUnmeasured

type OomdEnforcementEvidence
  = OomdEnforced
  | OomdUnverified


type RunnerSliceCapEffectiveness
  = CapEffective { bytes: ByteSize }
  | CapUnbounded

type SessionReservationMode
  = Regime1WorstCase { point: SessionOperatingPoint }
  | Regime2AggregateOomd { oomd_eviction_ceiling: ByteSize, session_concurrency: Int, aggregate_reservation: SessionAggregateReservation }
  | SessionReservationModeUnset

data gunbc_ci_session_reservation_mode: SessionReservationMode = Regime2AggregateOomd {
  oomd_eviction_ceiling: byte_size(10737418240),
  session_concurrency: 16,
  aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(21474836480) },
}

data gunbc_ci_regime2_aggregate_dissolution_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.ctrl.jobserver",
    decl_name: "jobserver_build_pool_bytes",
    field: WholeDeclaration
  }
}




data gunbc_ci_footprint_granularity_disposition: Disposition = Terminal { reason: "DESIGN §3 deliberate two-concerns split: INTER-run whole-run cgroup peak (gunbc_ci_job_peaks, ~24GiB) governs co-residence - how many runs share a host, feeding the conserving budget tree; WITHIN-run per-shard peak (gunbc_ci_floor_per_shard_peak_rss_bytes, ~2.0GiB directly measured) governs parallelism inside one run against its container cap, feeding memory_aware_spawn_width. Different granularity, different scheduling decision, different consumer. Do not consolidate them into one authority." }

data gunbc_ci_footprint_bridge_disposition: Disposition = Terminal { reason: "Deferred unification path (acknowledged, not attempted): INTER-run whole-run peak is plausibly within-run-width x per-shard-peak + base, so the INTER-run footprint could eventually derive from the WITHIN-run model once both are measured - the real single authority. Held back deliberately: re-coupling the two carriers risks zeroing the live floor width before per-type baseline measurement data exists." }

type HostFixedOverhead
  = HostFixedOverheadMeasured { bytes: ByteSize }
  | HostFixedOverheadUnmeasured

data gunbc_ci_host_fixed_overhead: HostFixedOverhead = HostFixedOverheadMeasured { bytes: byte_size(17179869184) }

