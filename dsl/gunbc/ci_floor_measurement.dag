module gunbc.ci_floor_measurement

import std.measure { ByteSize, byte_size }
import std.types { Int, List, String, Bool }
import std.realization_measurement {
  ConcurrentMemoryPeakSample,
  concurrent_memory_peak_per_share,
}
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data gunbc_ci_floor_measured_peak: ConcurrentMemoryPeakSample = ConcurrentMemoryPeakSample {
  peak: byte_size(11592347648)
  concurrency: 4
}

fn gunbc_ci_floor_per_shard_peak_rss_bytes() -> ByteSize {
  concurrent_memory_peak_per_share(sample: gunbc_ci_floor_measured_peak)
}

fn gunbc_ci_floor_whole_run_peak_rss_bytes() -> ByteSize {
  gunbc_ci_floor_measured_peak.peak
}

data gunbc_ci_host_container_memory_cap: ByteSize = byte_size(33578549248)

data gunbc_ci_floor_runner_margin_num: Int = 6
data gunbc_ci_floor_runner_margin_den: Int = 5

data gunbc_ci_floor_conservative_fallback_width: Int = 4

type JobCgroupPeakMeasurement
  = JobCgroupPeakMeasured { cgroup_peak: ByteSize }
  | JobCgroupPeakUnmeasured

type CiJobPeak {
  job: String
  peak: JobCgroupPeakMeasurement
}

data gunbc_ci_job_peaks: List<CiJobPeak> = [
  CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(11811160064) } },
  CiJobPeak { job: "rust_tests", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(39728447488) } },
]


data gunbc_ci_run_count_divisor: ByteSize = byte_size(9985798963)


data gunbc_ci_runner_unit_cap_safety_margin_num: Int = 5
data gunbc_ci_runner_unit_cap_safety_margin_den: Int = 4


data gunbc_ci_per_session_peak_samples: List<ByteSize> = [
  byte_size(8879844884),
  byte_size(4584877588),
  byte_size(4370129224),
  byte_size(4284229878),
  byte_size(3167538381),
  byte_size(3103113871),
  byte_size(2952790016),
  byte_size(2211908157),
  byte_size(1352914698),
  byte_size(579820585),
  byte_size(504658657),
  byte_size(397284475),
  byte_size(300647711),
]


type SessionOperatingPoint
  = SessionOperatingPointSet { per_session_cap: ByteSize, session_concurrency: Int }
  | SessionOperatingPointUnset

type SessionAggregateReservation
  = SessionAggregateMeasured { bytes: ByteSize }
  | SessionAggregateUnmeasured

type OomdEnforcementEvidence
  = OomdEnforced
  | OomdUnverified


type RunnerSliceCapEffectiveness
  = CapEffective { bytes: ByteSize }
  | CapUnbounded

type SessionReservationMode
  = Regime1WorstCase { point: SessionOperatingPoint }
  | Regime2AggregateOomd { oomd_eviction_ceiling: ByteSize, session_concurrency: Int, aggregate_reservation: SessionAggregateReservation }
  | SessionReservationModeUnset

data gunbc_ci_session_reservation_mode: SessionReservationMode = Regime2AggregateOomd {
  oomd_eviction_ceiling: byte_size(10737418240),
  session_concurrency: 16,
  aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(21474836480) },
}

data gunbc_ci_regime2_aggregate_dissolution_marker: String = "dissolve-on stage:per-type-baseline-build-pool -- Regime2AggregateOomd.aggregate_reservation is the COARSE single-aggregate stand-in. It DISSOLVES into the grounded decomposition host = overhead + Sigma(container-type baselines: GhaRunnerContainer idle ~0.2-0.3GiB + AgentSessionContainer idle ~0.35-0.5GiB, each a measured ResourceEnvelope) + ONE capped shared_build_pool + headroom. The shared build pool is NOT new infra: it is the EXISTING host-wide ctrl-jobserver (scheduling arm) + ctrl-sccache (caching arm) = the two arms of std.realization RealizedStep already unifying GHA-CI builds and session ctrl-builds; its authority is the ctrl-jobserver instance config (build_pool_budget = TOKENS x MIB_PER_JOB, gunbc owns the SHAPE, ctrl owns the values, cited in extdeps per shapes-vs-instances). Coarse-form scaffold per DESIGN sec 6: honest forward-composing, NOT parallel-representation debt; the single aggregate is exactly Sigma(baselines)+build_pool collapsed."




data gunbc_ci_footprint_granularity_note: String = "two distinct memory footprints, intentionally separate carriers (a de-conflation, not a fork): (1) INTER-run whole-run cgroup peak gunbc_ci_job_peaks (~24GiB) decides how many runs/runners CO-RESIDE per host -> the conserving budget tree; (2) WITHIN-run per-shard peak gunbc_ci_floor_per_shard_peak_rss_bytes (~2.9GiB) decides parallelism INSIDE one run against its container cap -> memory_aware_spawn_width (#5444). Different granularity (whole-run vs per-shard) and different decision, so two carriers. Do not consolidate them into one authority."

data gunbc_ci_footprint_bridge_followup: String = "deferred unification (named follow-up, NOT done here): the inter-run whole-run peak is plausibly width x per-shard-peak + base, so the INTER-run footprint could eventually DERIVE from the within-run model once both are measured -- the real single authority. Not attempted in this PR: it would re-couple the two carriers and risk zeroing the live floor width. Also a future derive-target: the within-run spawn width (~4) is itself a conservative/hand value under the all-spawns-through-dag end-state."

type HostFixedOverhead
  = HostFixedOverheadMeasured { bytes: ByteSize }
  | HostFixedOverheadUnmeasured

data gunbc_ci_host_fixed_overhead: HostFixedOverhead = HostFixedOverheadMeasured { bytes: byte_size(17179869184) }

data gunbc_ci_floor_measured_peak_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_floor_measurement",
    decl_name: "gunbc_ci_job_peaks",
    field: WholeDeclaration
  }
}

data gunbc_ci_host_fixed_overhead_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_floor_measurement",
    decl_name: "gunbc_ci_per_service_overhead",
    field: WholeDeclaration
  }
}

data gunbc_ci_concurrent_runs_conservative_high_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_runner_placement",
    decl_name: "runner_deployment_plan",
    field: WholeDeclaration
  }
}
