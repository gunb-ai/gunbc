module gunbc.ci_floor_measurement

import std.measure { ByteSize, byte_size }
import std.types { Int, List, String, Bool }
import std.realization_measurement {
  ConcurrentMemoryPeakSample,
  concurrent_memory_peak_per_share,
}
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data gunbc_ci_floor_measured_peak: ConcurrentMemoryPeakSample = ConcurrentMemoryPeakSample {
  peak: byte_size(11592347648)
  concurrency: 4
}

fn gunbc_ci_floor_per_shard_peak_rss_bytes() -> ByteSize {
  concurrent_memory_peak_per_share(sample: gunbc_ci_floor_measured_peak)
}

fn gunbc_ci_floor_whole_run_peak_rss_bytes() -> ByteSize {
  gunbc_ci_floor_measured_peak.peak
}

data gunbc_ci_host_container_memory_cap: ByteSize = byte_size(33578549248)

data gunbc_ci_floor_runner_margin_num: Int = 6
data gunbc_ci_floor_runner_margin_den: Int = 5

data gunbc_ci_floor_conservative_fallback_width: Int = 4

type JobCgroupPeakMeasurement
  = JobCgroupPeakMeasured { cgroup_peak: ByteSize }
  | JobCgroupPeakUnmeasured

type CiJobPeak {
  job: String
  peak: JobCgroupPeakMeasurement
}

data gunbc_ci_job_peaks: List<CiJobPeak> = [
  CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(11811160064) } },
  CiJobPeak { job: "rust_tests", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(39728447488) } },
]

data gunbc_ci_job_cgroup_peak_provenance: String = "measured per-unit cgroup memory.peak (15s sample, both srv1/srv2, reset-segmented for per-job finals). BIMODAL: a light cluster (dsl/claim jobs, here job=ci ~1-11GiB) and a heavy tail (cargo compiles, here job=rust_tests ~29-37GiB). The worst climbed across windows (first 30min: 34.8; extended: srv1 35.2 / srv2 36.2) -- the 3-sample tail was undersampled -- so the worst is pinned 37GiB (36.2 rounded up). max(this list) is the WORST whole-run peak that sizes the per-runner memory.max ceiling (= worst * safety_margin); the count DIVISOR is the measured MEAN (gunbc_ci_run_count_divisor, a separate stat of the SAME distribution, ~9.3GiB) -- not max -- because runners are MEAN-packed under the jobserver + slice-cap + per-unit-cap belt (NOT oomd -- oomd guards the sessions side, see gunbc_ci_run_count_divisor_provenance), not worst-packed. Supersedes the prior 24GiB single round-up (which was simultaneously too LOW for the worst and too HIGH for the typical -- the bimodal conflation this split dissolves)."

data gunbc_ci_run_count_divisor: ByteSize = byte_size(9985798963)

data gunbc_ci_run_count_divisor_provenance: String = "measured MEAN per-job whole-run cgroup peak (~9.3GiB) over the same bimodal distribution as gunbc_ci_job_peaks (mean 9.3, median 5.0, p75 10.1, p95 34.4, worst 36.2 extended). It is the runner COUNT divisor (runner_count memory term = runner_slice_cap / this), NOT the per-runner ceiling. Runners are MEAN-packed because the heavy tail cannot all burst at once, held by a THREE-part runner belt: (i) the ctrl-jobserver bounds coincident heavy compiles (THIS is the load-shaping reason mean-packing is safe -- the tail is serialized); (ii) the hard runner-slice MemoryMax is the aggregate ceiling, and on breach the kernel kills+retries a single runner job (recoverable, NOT a host OOM); (iii) the per-runner memory.max bounds any single runaway (no one job blows the slice). oomd is NOT the runner belt -- it caps the SESSIONS slice so sessions cannot eat the runner reservation, an INDIRECT guard of the runner budget. Reserving the worst per runner (worst-packing) would strand the slice at ~2 runners; the mean is the correct divisor for an aggregate co-residence budget, the worst (gunbc_ci_job_peaks max) only sizes the per-runner cap. SAFE ONLY under that belt -- the live plan stays UNSOUND until RunnerSlotEnforced (slice live) + OomdEnforced (sessions side protected), so mean-packing is never realized without both floors."

data gunbc_ci_runner_unit_cap_safety_margin_num: Int = 5
data gunbc_ci_runner_unit_cap_safety_margin_den: Int = 4

data gunbc_ci_runner_unit_cap_safety_margin_provenance: String = "per-runner memory.max safety margin = 5/4 (1.25x over the measured worst whole-run peak). unit_cap = measured_worst_job_peak (gunbc_ci_job_peaks max ~37GiB) * 5/4 = ~46GiB. Grounded: worst is measured, the 1.25 is a stated headroom constant. The pad is VALIDATED, not guessed: the heavy tail was undersampled (the worst climbed 34.8 -> 36.2 as the window extended), so the margin on the rounded-up 37 absorbs that drift via a cap RAISE (the over-commit-safe direction). Padded HIGH on purpose -- a too-low per-runner cap kills a legitimate heavy compile (spurious red), while ~46GiB is still ~half the ~80-89GiB slice so it meaningfully bounds a runaway; the true aggregate ceiling is the hard slice cap + jobserver regardless, so erring high costs ~nothing."

data gunbc_ci_per_session_peak_samples: List<ByteSize> = [
  byte_size(8879844884),
  byte_size(4584877588),
  byte_size(4370129224),
  byte_size(4284229878),
  byte_size(3167538381),
  byte_size(3103113871),
  byte_size(2952790016),
  byte_size(2211908157),
  byte_size(1352914698),
  byte_size(579820585),
  byte_size(504658657),
  byte_size(397284475),
  byte_size(300647711),
]

data gunbc_ci_per_session_peak_provenance: String = "measured live (read-only srv2 session-container cgroup memory.peak, 13 concurrent sessions, real high-water marks): min 0.28 / median ~2.06 / max 8.27 GiB. Replaces two non-measurements: the 31.25GiB container cap (~4x the observed max) and the 4GiB live admission knob (below the heavy sessions -> over-commits when a build-heavy session peaks)."

type SessionOperatingPoint
  = SessionOperatingPointSet { per_session_cap: ByteSize, session_concurrency: Int }
  | SessionOperatingPointUnset

type SessionAggregateReservation
  = SessionAggregateMeasured { bytes: ByteSize }
  | SessionAggregateUnmeasured

type OomdEnforcementEvidence
  = OomdEnforced
  | OomdUnverified

data gunbc_ci_effective_memory_max_home_note: String = "RunnerSliceCapEffectiveness is the result of a live systemd MemoryMax effective read: CapEffective\{bytes\} (a finite cgroup cap) or CapUnbounded (MemoryMax=infinity, the inert-cap OOM-reboot vector). It is homed here (a budget_tree-free measurement module), not in fleet_host_budget, so BOTH the slice-level drift detector (fleet_host_budget.runner_slice_cap_drifted) AND the per-slot enforcement carrier (gunbc.runner_slot_enforcement, which also imports std.realization_reconcile) can share the ONE authority without the flat-namespace Reconciliation collision that co-loading fleet_host_budget (-> product.budget_tree.Reconciliation) and std.realization_reconcile.Reconciliation would otherwise trigger. Single effective-MemoryMax-read concept, one home; the name keeps Slice for git-history continuity, it reads any systemd MemoryMax (slice or slot)."

type RunnerSliceCapEffectiveness
  = CapEffective { bytes: ByteSize }
  | CapUnbounded

type SessionReservationMode
  = Regime1WorstCase { point: SessionOperatingPoint }
  | Regime2AggregateOomd { oomd_eviction_ceiling: ByteSize, session_concurrency: Int, aggregate_reservation: SessionAggregateReservation, oomd_enforcement: OomdEnforcementEvidence }
  | SessionReservationModeUnset

data gunbc_ci_session_reservation_mode: SessionReservationMode = Regime2AggregateOomd {
  oomd_eviction_ceiling: byte_size(10737418240),
  session_concurrency: 16,
  aggregate_reservation: SessionAggregateMeasured { bytes: byte_size(21474836480) },
  oomd_enforcement: OomdUnverified,
}

data gunbc_ci_regime2_aggregate_dissolution_marker: String = "dissolve-on stage:per-type-baseline-build-pool -- Regime2AggregateOomd.aggregate_reservation is the COARSE single-aggregate stand-in. It DISSOLVES into the grounded decomposition host = overhead + Sigma(container-type baselines: GhaRunnerContainer idle ~0.2-0.3GiB + AgentSessionContainer idle ~0.35-0.5GiB, each a measured ResourceEnvelope) + ONE capped shared_build_pool + headroom. The shared build pool is NOT new infra: it is the EXISTING host-wide ctrl-jobserver (scheduling arm) + ctrl-sccache (caching arm) = the two arms of std.realization RealizedStep already unifying GHA-CI builds and session ctrl-builds; its authority is the ctrl-jobserver instance config (build_pool_budget = TOKENS x MIB_PER_JOB, gunbc owns the SHAPE, ctrl owns the values, cited in extdeps per shapes-vs-instances). Coarse-form scaffold per DESIGN sec 6: honest forward-composing, NOT parallel-representation debt; the single aggregate is exactly Sigma(baselines)+build_pool collapsed."

data gunbc_ci_per_run_peak_sharpen_followup: String = "LANDED (this PR): the conservative single 24GiB round-up is sharpened into the measured bimodal distribution -- worst 37GiB (pinned over the extended-window 36.2, -> per-runner cap) and mean 9.3GiB (-> count divisor). The count divisor dropping 24 -> 9.3 is the capacity unlock: a host's ~80-89GiB runner slice now mean-packs to ~8-9 runners instead of worst-packing to ~2. The heavy tail was undersampled (the worst climbed 34.8 -> 36.2 as sampling extended); the safety margin absorbed it via a cap raise (over-commit-safe). Deeper follow-up still open: per-run footprint plausibly DERIVES from within-run width x per-shard-peak once both are measured (gunbc_ci_footprint_bridge_followup)."

data gunbc_ci_session_regime_model: String = "REGIME-1 (Regime1WorstCase mode, shipping, safe-now, no runtime floor required): sessions_slice = per_session_cap C * concurrency N -- reserve as if all N sessions sit at their cap simultaneously. This is what the operating curve renders. It forces the hard tension visible in the curve: on a 128GiB host at 24GiB/run you cannot get high concurrency AND full peak coverage AND 3 runners at once. Both regimes are now SELECTABLE via the SessionReservationMode authority (gunbc_ci_session_reservation_mode): resolve_session_slice dispatches REGIME-1 -> C*N and REGIME-2 -> measured aggregate; the committed mode stays SessionReservationModeUnset (fail-closed) until the operator picks."

data gunbc_ci_session_regime2_followup: String = "REGIME-2 is now the COMMITTED mode (gunbc_ci_session_reservation_mode = Regime2AggregateOomd), staged fail-closed: sessions_slice = measured realistic AGGREGATE concurrent peak (the sessions do not all peak together), with C kept only as the per-session OOM CEILING (oomd_eviction_ceiling). The far-smaller aggregate reservation lets high concurrency (16) AND full coverage AND many runners coexist. Gate (a) aggregate_reservation: CLOSED -- SessionAggregateMeasured { 20GiB } from a live measured concurrent peak. Gate (b) oomd_enforcement: STILL OPEN -- OomdUnverified until per-cgroup memory.max + systemd-oomd eviction is live and verified on the hosts (the managed sessions.slice). That oomd floor is the KEYSTONE: it is both the srv2-reboot fix and the REGIME-2 enabler, and it is also what makes mean-packed runner counts safe. resolve_session_slice therefore still returns Unresolved (live plan UNSOUND) -- a single 1-line flip OomdUnverified -> OomdEnforced (PR2, once the managed slice is live) unlocks the full derivation with NO structural change."

data gunbc_ci_footprint_granularity_note: String = "two distinct memory footprints, intentionally separate carriers (a de-conflation, not a fork): (1) INTER-run whole-run cgroup peak gunbc_ci_job_peaks (~24GiB) decides how many runs/runners CO-RESIDE per host -> the conserving budget tree; (2) WITHIN-run per-shard peak gunbc_ci_floor_per_shard_peak_rss_bytes (~2.9GiB) decides parallelism INSIDE one run against its container cap -> memory_aware_spawn_width (#5444). Different granularity (whole-run vs per-shard) and different decision, so two carriers. Do not consolidate them into one authority."

data gunbc_ci_footprint_bridge_followup: String = "deferred unification (named follow-up, NOT done here): the inter-run whole-run peak is plausibly width x per-shard-peak + base, so the INTER-run footprint could eventually DERIVE from the within-run model once both are measured -- the real single authority. Not attempted in this PR: it would re-couple the two carriers and risk zeroing the live floor width. Also a future derive-target: the within-run spawn width (~4) is itself a conservative/hand value under the all-spawns-through-dag end-state."

type HostFixedOverhead
  = HostFixedOverheadMeasured { bytes: ByteSize }
  | HostFixedOverheadUnmeasured

data gunbc_ci_host_fixed_overhead: HostFixedOverhead = HostFixedOverheadMeasured { bytes: byte_size(17179869184) }

data gunbc_ci_floor_measured_peak_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_floor_measurement",
    decl_name: "gunbc_ci_job_peaks",
    field: WholeDeclaration
  }
}

data gunbc_ci_host_fixed_overhead_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_floor_measurement",
    decl_name: "gunbc_ci_per_service_overhead",
    field: WholeDeclaration
  }
}

data gunbc_ci_concurrent_runs_conservative_high_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.ci_runner_placement",
    decl_name: "runner_deployment_plan",
    field: WholeDeclaration
  }
}
