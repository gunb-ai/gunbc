module gunbc.ci_floor_measurement

import std.measure { ByteSize, byte_size }
import std.types { Int, List, String, Bool }
import std.realization_measurement {
  ConcurrentMemoryPeakSample,
  concurrent_memory_peak_per_share,
}
import std.disposition { Disposition, Scaffold, SingleAuthority, Terminal }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data gunbc_ci_floor_measured_peak: ConcurrentMemoryPeakSample = ConcurrentMemoryPeakSample {
  peak: byte_size(6452113408)
  concurrency: 2
}

type PerShardRssPeakMeasurement
  = PerShardRssPeakMeasured { per_shard_peak: ByteSize, sample_width: Int }
  | PerShardRssPeakUnmeasured

data gunbc_ci_floor_per_shard_rss_measurement: PerShardRssPeakMeasurement = PerShardRssPeakMeasured {
  per_shard_peak: byte_size(3226056704)
  sample_width: 2
}

data gunbc_ci_floor_per_shard_rss_source: Disposition = Terminal {
  reason: "Measured local floor, post-#5860 corpus, main HEAD 6461042c64 at spawn_width=2 (pinned): floor peak VmHWM=6.0GiB => per-shard = VmHWM/width = 6.0GiB/2 = 3.0GiB (3226056704 bytes). Supersedes the stale 2.1GiB@width4 (CI run 27893441091) which the corpus outgrew: at the stale value the formula picked width=3 and 3 concurrent shards exceeded the 8GiB runner cap => exit-137 (run 28296782925). VESTIGIAL IN WIDTH FORMULA as of gunbc_ci_floor_confirmed_safe_width: spawn_width is now min(cpu_bound, confirmed_safe_width), not floor(budget/per_shard). per_shard_committed is retained as (a) width=1 guard (if budget < per_shard, even one shard may not fit) and (b) ResourceEnvelope memory estimate. It is a [calibration] receipt, not a live scheduler input. Durable fix: resource-aware-scheduler Node B/C (docs/plans/resource-aware-scheduler.md)."
}

data gunbc_ci_floor_host_compiler_spawn_peak: ByteSize = byte_size(1610612736)

data gunbc_ci_floor_host_compiler_spawn_peak_source: Disposition = Terminal {
  reason: "emit_host_gate_passes / regen_verify_gate_passes spawn child cargo/rustc processes; ~1.5 GiB per docs/plans/emit-host-batch-isolation.md. Grounds RunnableSpaceCost on EmitHostGate and the host-compiler arm of RegenVerifyGate; feeds runnable_forbids_corpus_co_residence in std.realization_schedule."
}

fn gunbc_ci_floor_per_shard_peak_rss_bytes() -> ByteSize {
  match gunbc_ci_floor_per_shard_rss_measurement {
    PerShardRssPeakMeasured { per_shard_peak: p, sample_width: _ } => p
    PerShardRssPeakUnmeasured => concurrent_memory_peak_per_share(sample: gunbc_ci_floor_measured_peak)
  }
}

data gunbc_ci_host_container_memory_cap: ByteSize = byte_size(33578549248)

data gunbc_ci_floor_conservative_fallback_width: Int = 4

data gunbc_ci_floor_confirmed_safe_width: Int = 2

data gunbc_ci_floor_confirmed_safe_width_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.realization_schedule",
    decl_name: "Runnable",
    field: WholeDeclaration
  }
}

type JobCgroupPeakMeasurement
  = JobCgroupPeakMeasured { cgroup_peak: ByteSize }
  | JobCgroupPeakUnmeasured

type CiJobPeak {
  job: String
  peak: JobCgroupPeakMeasurement
}

data gunbc_ci_job_peaks: List<CiJobPeak> = [
  CiJobPeak { job: "ci", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(11811160064) } },
  CiJobPeak { job: "rust_tests", peak: JobCgroupPeakMeasured { cgroup_peak: byte_size(39728447488) } },
]


data gunbc_ci_run_count_divisor: ByteSize = byte_size(9985798963)


data gunbc_ci_runner_unit_cap_safety_margin_num: Int = 5
data gunbc_ci_runner_unit_cap_safety_margin_den: Int = 4


data gunbc_ci_per_session_peak_samples: List<ByteSize> = [
  byte_size(8879844884),
  byte_size(4584877588),
  byte_size(4370129224),
  byte_size(4284229878),
  byte_size(3167538381),
