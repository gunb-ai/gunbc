module gunbc.fleet_converge_timer_emit

import std.types { String, List, Int, Bool }
import std.measure { second_count }
import std.layout {
  Doc, DocConcat,
  LayoutProtocol,
  doc_concat, doc_line_of,
  render
}
import gunbc.host_converge {
  ConvergePolicy,
  ConvergePolicyDerived,
  ConvergePolicyUnsound,
  fleet_converge_policy,
  gunbc_host_ctrl_checkout_path,
  gunbc_dsl_root_submodule_path,
  gunbc_spawn_retry_backstop_cadence,
  gunbc_fleet_operator_unix_user,
}

data fleet_converge_timer_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

data gunbc_fleet_converge_service_unit_name: String = "gunbc-fleet-converge.service"
data gunbc_fleet_converge_timer_unit_name: String = "gunbc-fleet-converge.timer"
data gunbc_fleet_converge_systemd_unit_dir: String = "/etc/systemd/system"

fn fleet_converge_script_path() -> String {
  concat(
    concat(concat(gunbc_host_ctrl_checkout_path, "/"), gunbc_dsl_root_submodule_path),
    "/.github/fleet-converge.sh"
  )
}

fn fleet_converge_service_unit_path() -> String {
  concat(concat(gunbc_fleet_converge_systemd_unit_dir, "/"), gunbc_fleet_converge_service_unit_name)
}

fn fleet_converge_timer_unit_path() -> String {
  concat(concat(gunbc_fleet_converge_systemd_unit_dir, "/"), gunbc_fleet_converge_timer_unit_name)
}

fn timer_on_unit_active_sec() -> String {
  concat(to_string(second_count(s: gunbc_spawn_retry_backstop_cadence)), "s")
}

fn emit_service_unit_doc() -> Doc {
  let script = fleet_converge_script_path()
  doc_concat(parts: [
    doc_line_of(text: "[Unit]"),
    doc_line_of(text: "Description=gunbc fleet converge (host-self-selecting reconcile)"),
    doc_line_of(text: "After=network-online.target"),
    doc_line_of(text: "Wants=network-online.target"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Service]"),
    doc_line_of(text: "Type=oneshot"),
    doc_line_of(text: concat("User=", gunbc_fleet_operator_unix_user)),
    doc_line_of(text: concat("ExecStart=/usr/bin/bash ", script)),
    doc_line_of(text: "RemainAfterExit=no"),
  ])
}

fn emit_timer_unit_doc() -> Doc {
  let interval = timer_on_unit_active_sec()
  doc_concat(parts: [
    doc_line_of(text: "[Unit]"),
    doc_line_of(text: "Description=gunbc fleet converge periodic reconcile"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Timer]"),
    doc_line_of(text: "OnBootSec=2min"),
    doc_line_of(text: concat("OnUnitActiveSec=", interval)),
    doc_line_of(text: "Unit=gunbc-fleet-converge.service"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Install]"),
    doc_line_of(text: "WantedBy=timers.target"),
  ])
}

fn emit_timer_upsert_header() -> Doc {
  doc_concat(parts: map([
    "#!/usr/bin/env bash",
    "set -euo pipefail",
    "# GENERATED by dsl/gunbc/fleet_converge_timer_emit.dag (gunbc.fleet_converge_timer_emit). DO NOT HAND-EDIT.",
    "# Idempotent per-host upsert: write service+timer units, daemon-reload, enable timer.",
    "# The converge script self-selects via $(hostname -s); no SSH star required for steady-state.",
    "",
    concat("svc_path=\"", concat(fleet_converge_service_unit_path(), "\"")),
    concat("timer_path=\"", concat(fleet_converge_timer_unit_path(), "\"")),
    "mkdir -p \"$(dirname \"$svc_path\")\"",
    "",
    "cat > \"$svc_path\" <<'GUNBC_FLEET_CONVERGE_SERVICE_EOF'",
  ], line => doc_line_of(text: line)))
}

fn emit_timer_upsert_footer() -> Doc {
  doc_concat(parts: [
    doc_line_of(text: "GUNBC_FLEET_CONVERGE_SERVICE_EOF"),
    doc_line_of(text: ""),
    doc_line_of(text: "cat > \"$timer_path\" <<'GUNBC_FLEET_CONVERGE_TIMER_EOF'"),
  ])
}

fn emit_timer_upsert_trailer() -> Doc {
  doc_concat(parts: map([
    "GUNBC_FLEET_CONVERGE_TIMER_EOF",
    "",
    "systemctl daemon-reload",
    "systemctl enable --now gunbc-fleet-converge.timer",
    "printf 'fleet-converge-timer-receipt host=%s verdict=converged\\n' \"$(hostname -s 2>/dev/null || echo unknown)\"",
  ], line => doc_line_of(text: line)))
}

fn timer_upsert_unsound_doc(reason: String) -> Doc {
  doc_concat(parts: map([
    "#!/usr/bin/env bash",
    "set -euo pipefail",
    "# GENERATED by dsl/gunbc/fleet_converge_timer_emit.dag (gunbc.fleet_converge_timer_emit). DO NOT HAND-EDIT.",
    concat("echo \"fleet-converge-timer UNSOUND: ", concat(reason, "\" >&2")),
    "exit 1"
  ], line => doc_line_of(text: line)))
}

fn project_timer_upsert_to_doc(policy: ConvergePolicy) -> Doc {
  match policy {
    ConvergePolicyUnsound { reason: reason } => timer_upsert_unsound_doc(reason: reason)
    ConvergePolicyDerived { hosts: _ } =>
      doc_concat(parts: [
        emit_timer_upsert_header(),
        emit_service_unit_doc(),
        emit_timer_upsert_footer(),
        emit_timer_unit_doc(),
        emit_timer_upsert_trailer(),
      ])
  }
}

fn fleet_converge_timer_upsert_sh_for(policy: ConvergePolicy) -> String {
  render(doc: project_timer_upsert_to_doc(policy: policy), proto: fleet_converge_timer_protocol)
}

fn expected_fleet_converge_timer_upsert_sh() -> String {
  fleet_converge_timer_upsert_sh_for(policy: fleet_converge_policy())
}

fn fleet_converge_timer_upsert_drifted(committed: String) -> Bool {
  !(committed == expected_fleet_converge_timer_upsert_sh())
}
