// gunbc/roadmap_emit.dag — project the roadmap work-model to Markdown (slice-2 step 2).
//
// SCAFFOLD (DESIGN §7 self-host / plan §6): the ROADMAP-specific projection in the SAME shape as
// ci.yml's `expected_ci_yml = serialize_yaml(project_workflow_to_yaml(...))` — here
// `expected_roadmap_md = serialize_markdown_source(project_roadmap_to_markdown(...))`, a dsl
// serializer fold on the v1 seed. The generic Markdown medium is deep-newt's
// `std.markdown` + `extdeps.languages.markdown.serialize_markdown_source` (row-driven). This module
// owns ONLY the roadmap→Markdown projection; the medium is not re-modeled here.
// dissolution-trigger: the eventual v2 Markdown TargetModel (one grammar both ways, §4) supersedes
//   the dsl serializer fold — at which point `project_roadmap_to_markdown` emits v2 Nodes and this
//   composition retires, exactly as `serialize_yaml`/`ci_yaml_emit` will.
//
// The checkbox cell is where the DONE-authority decision lands (plan §6.1): a CompletesIff line's box
// is DERIVED from the merged-PR set (the inversion — generated, not hand-toggled); a HandChecked
// line's box is the AUTHORED one (honest un-derivable residue). So the generated ROADMAP cannot carry
// a stale checkbox on a PR-bound line.

module gunbc.roadmap_emit

import std.markdown {
  MarkdownDocument, MarkdownBlock, MarkdownInline, HeadingBlock, ParagraphBlock, TaskListBlock,
  MarkdownTaskItem, StrongInline, TextInline, LinkInline, H2, Checked, Unchecked,
}
import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, PlanDocCarrier, NoCarrier, PlanDoc,
  RoadmapParent, TopLevel, UnderParent, roadmap_parent, is_top_level,
}
// Completion is a Bool here (§2: roadmap_status carries no 2-variant enum restating it). The ONLY
// checkbox-state type in the project is std.markdown's GFM glyph `CheckboxState = Checked | Unchecked`;
// this module maps the Bool onto that glyph in `task_item_with` below. The completion concept (Bool,
// roadmap_status) and the render-glyph concept (std.markdown.CheckboxState) stay distinct (§3).
import gunbc.roadmap_status { entry_is_done }
import ctrl.process_algebra { ProcessNodeId }

// Bounded nesting depth — the roadmap forest is shallow (sections → items → sub-items). Explicit fuel
// gives the recursion its strict-descent evidence (DESIGN §4 bounded-and-forward); a tree deeper than
// this truncates, which is loud (a missing deep item is visible drift), not silent corruption.
fn roadmap_max_depth() -> Int { 8 }

// === The checkbox cell — DONE-authority (plan §6.1) ==========================

// Whether a line's box SHOULD read done — the DONE-authority decision (plan §6.1), delegated whole to
// `roadmap_status.entry_is_done` (CompletesIff → derived from the merged set; HandChecked → authored).
// Kept as a Bool so the markdown glyph lands in `MarkdownTaskItem.state` field position below.
fn node_is_done(rn: RoadmapNode, merged: List<Int>) -> Bool {
  entry_is_done(entry: rn.line, merged: merged)
}

// === Inline content — bold title + optional plan-doc link ====================

fn carrier_inlines(carrier: PlanDocCarrier) -> List<MarkdownInline> {
  match carrier {
    NoCarrier => []
    PlanDoc { path } => [
      TextInline { text: " " },
      LinkInline { inlines: [TextInline { text: "plan" }], url: path },
    ]
  }
}

fn node_inlines(rn: RoadmapNode) -> List<MarkdownInline> {
  concat(
    [StrongInline { inlines: [TextInline { text: rn.line.title }] }],
    carrier_inlines(carrier: rn.carrier),
  )
}

// === The forest projection ===================================================

// Direct children of `parent`: nodes whose decomposition parent is `parent`.
fn children_of(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, parent: ProcessNodeId) -> List<RoadmapNode> {
  nodes |> filter(n => match roadmap_parent(edges: edges, node: n.node) {
    UnderParent { parent: p } => p == parent
    TopLevel => false
  })
}

// Build a task item from its done-flag + blocks. The glyph (`Checked`/`Unchecked`) sits DIRECTLY in
// `state:` field position in each branch — a bare nullary markdown constructor only resolves where its
// type (`MarkdownTaskItem.state`) is the expected type pushed onto it; it does NOT resolve through an
// `if`/match-arm into the field, nor inside a match-arm body (read there as a variable). Both branches
// build the same record type, so they unify cleanly.
fn task_item_with(done: Bool, blocks: List<MarkdownBlock>) -> MarkdownTaskItem {
  if done {
    MarkdownTaskItem { state: Checked, blocks: blocks }
  } else {
    MarkdownTaskItem { state: Unchecked, blocks: blocks }
  }
}

// Map a roadmap node to a task item, nesting its children one indent level (fuel-bounded, §4). The
// status box is the DONE-authority decision (plan §6.1): CompletesIff → derived from the merged set,
// HandChecked → authored.
fn task_item_for(rn: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int) -> MarkdownTaskItem {
  let para = ParagraphBlock { inlines: node_inlines(rn: rn) }
  let kids = if fuel > 0 { children_of(nodes: nodes, edges: edges, parent: rn.node) } else { [] }
  let blocks = if count(kids) > 0 {
    [para, TaskListBlock { items: kids |> map(k => task_item_for(rn: k, nodes: nodes, edges: edges, merged: merged, fuel: fuel - 1)) }]
  } else {
    [para]
  }
  task_item_with(done: node_is_done(rn: rn, merged: merged), blocks: blocks)
}

// === The section projection ==================================================

// One ROADMAP section: an H2 heading + a task list of its top-level nodes (each nesting its children
// as the indentation = dependency forest). The whole-document projection maps this over sections.
fn project_roadmap_section(title: String, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>) -> MarkdownDocument {
  let tops = nodes |> filter(n => is_top_level(edges: edges, node: n.node))
  MarkdownDocument {
    blocks: [
      HeadingBlock { level: H2, inlines: [TextInline { text: title }] },
      TaskListBlock { items: tops |> map(n => task_item_for(rn: n, nodes: nodes, edges: edges, merged: merged, fuel: roadmap_max_depth())) },
    ]
  }
}
