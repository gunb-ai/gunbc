module gunbc.roadmap_emit

import std.markdown {
  MarkdownDocument, MarkdownBlock, MarkdownInline, HeadingBlock, ParagraphBlock, TaskListBlock,
  MarkdownTaskItem, StrongInline, TextInline, LinkInline, H2, Checked, Unchecked,
}
import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, Pointer,
  RoadmapParent, TopLevel, UnderParent, roadmap_parent, is_top_level,
  SectionElement, Prose, Group, SectionProse, SectionGroup,
}

import gunbc.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine, item_is_done }
import ctrl.process_algebra { ProcessNodeId }

fn roadmap_max_depth() -> Int { 8 }

fn node_is_done(rn: RoadmapNode, merged: List<Int>) -> Bool {
  item_is_done(item: rn.line, merged: merged)
}

fn pointer_inlines(p: Pointer) -> List<MarkdownInline> {
  [
    TextInline { text: " " },
    LinkInline { inlines: [TextInline { text: p.label }], url: p.path },
  ]
}

fn carriers_inlines(carriers: List<Pointer>) -> List<MarkdownInline> {
  fold(carriers, init: [], f: (acc, p) => concat(acc, pointer_inlines(p: p)))
}

fn refs_text(prs: List<Int>) -> String {
  fold(prs, init: "", f: (acc, p) =>
    if acc == "" { concat("#", to_string(p)) } else { concat(acc, concat("/#", to_string(p))) })
}
fn refs_inlines(prs: List<Int>) -> List<MarkdownInline> {
  if count(prs) == 0 { [] } else { [TextInline { text: concat(" (", concat(refs_text(prs: prs), ")")) }] }
}

fn desc_inlines(description: String) -> List<MarkdownInline> {
  if description == "" { [] } else { [TextInline { text: concat(" ", description) }] }
}

fn line_inlines(line: RoadmapItem) -> List<MarkdownInline> {
  match line {
    DerivableLine { prs, title, description } =>
      concat(
        concat([StrongInline { inlines: [TextInline { text: title }] }], refs_inlines(prs: prs)),
        desc_inlines(description: description),
      )
    AuthoredLine { done: _, content } => [TextInline { text: content }]
  }
}

fn node_inlines(rn: RoadmapNode) -> List<MarkdownInline> {
  concat(
    line_inlines(line: rn.line),
    carriers_inlines(carriers: rn.carriers),
  )
}

fn children_of(nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, parent: ProcessNodeId) -> List<RoadmapNode> {
  nodes |> filter(n => match roadmap_parent(edges: edges, node: n.node) {
    UnderParent { parent: p } => p == parent
    TopLevel => false
  })
}

fn task_item_with(done: Bool, blocks: List<MarkdownBlock>) -> MarkdownTaskItem {
  if done {
    MarkdownTaskItem { state: Checked, blocks: blocks }
  } else {
    MarkdownTaskItem { state: Unchecked, blocks: blocks }
  }
}

fn task_item_for(rn: RoadmapNode, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>, merged: List<Int>, fuel: Int) -> MarkdownTaskItem {
  let para = ParagraphBlock { inlines: node_inlines(rn: rn) }
  let kids = if fuel > 0 { children_of(nodes: nodes, edges: edges, parent: rn.node) } else { [] }
  let blocks = if count(kids) > 0 {
    [para, TaskListBlock { items: kids |> map(k => task_item_for(rn: k, nodes: nodes, edges: edges, merged: merged, fuel: fuel - 1)) }]
  } else {
    [para]
  }
  task_item_with(done: node_is_done(rn: rn, merged: merged), blocks: blocks)
}

fn group_blocks(g: SectionGroup, merged: List<Int>) -> List<MarkdownBlock> {
  let tops = g.nodes |> filter(n => is_top_level(edges: g.edges, node: n.node))
  let list = TaskListBlock { items: tops |> map(n => task_item_for(rn: n, nodes: g.nodes, edges: g.edges, merged: merged, fuel: roadmap_max_depth())) }
  if g.label == "" {
    [list]
  } else {
    [
      ParagraphBlock { inlines: [StrongInline { inlines: [TextInline { text: concat(g.label, ":") }] }] },
      list,
    ]
  }
}

fn element_blocks(e: SectionElement, merged: List<Int>) -> List<MarkdownBlock> {
  match e {
    Prose { prose } => [ParagraphBlock { inlines: [TextInline { text: prose.content }] }]
    Group { group } => group_blocks(g: group, merged: merged)
  }
}

fn project_roadmap_section(title: String, elements: List<SectionElement>, merged: List<Int>) -> MarkdownDocument {
  MarkdownDocument {
    blocks: fold(elements,
      init: [HeadingBlock { level: H2, inlines: [TextInline { text: title }] }],
      f: fn(acc, e) { concat(acc, element_blocks(e: e, merged: merged)) })
  }
}
