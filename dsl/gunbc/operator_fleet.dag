// gunbc/operator_fleet.dag — the operator fleet as the single compute-fabric authority.
//
// srv1 + srv2 as real, BMC-grounded ComputeHost/ComputeOffer values (slice 2 of
// docs/plans/operator-fleet-on-compute-fabric.md), replacing the synthetic single
// gunbc_ci_fleet_offer. CI, agent sessions, and placement all derive from here.
//
// PUBLIC in gunbc — we skip the private ctrl repo. The hardware facts are BMC-grounded and
// publishable; the privacy boundary is handled in-repo, two ways:
//   * secret VALUES (rotated BMC credentials) are HANDLES via std.credentials — never committed.
//   * operator-private surface facts (OS distro/version) are left absent here (resolved at
//     runtime), not stored.
// The operator OWNS the fleet (provider = the operator; marginal cost zero).
//
// Both hosts are ASRock Rack ALTRAD8UD-1L2T (Ampere Altra M128-30, 128c/128t, 128 GiB DDR4),
// grounded on live Redfish probes (srv2: gunbc.fleet_srv2_bmc_fixture; srv1: below, BMC .183).
// The per-host cgroup MemoryMax difference is out of scope — the allocator is OS-agnostic
// (grantable = physical RAM − reserve); see docs/plans/compute-fabric-allocator.md.

module gunbc.operator_fleet

import gunbc.operator_fleet_network { operator_host_srv1, operator_host_srv2 }
import gunbc.fleet_srv2_bmc_fixture { fleet_srv2_bmc_telemetry }
import extdeps.cpu.ampere { altra_max_m12830_catalog }
import extdeps.cpu.types { CpuFacts, CpuDeploymentFacts }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog }
import extdeps.bmc.types { BmcTelemetrySnapshot, RedfishSystemInventory, On }
import extdeps.bmc.redfish { redfish_system_inventory }
import extdeps.bmc { bmc_ground_snapshot }
import std.baseboard { ServerBaseboard }
import std.bmc { BmcEndpoint, Redfish }
import std.credentials { CredentialFlow, Stored }
import std.measure { gibibyte, gibibyte_to_byte_size, hertz, hardware_thread_count }
import std.os.types { OperatingSystemSurface, Linux, Posix, PosixProcess }
import std.types { List }
import product.compute_fabric {
  ComputeOffer,
  ComputeSupplyFacts,
  ComputeHost,
  ExecutionSurface,
  MemoryDevice,
  CpuProcessor,
  AvailabilityWindow,
  CostModel,
  ProviderCostModel,
  OwnedMarginalZero,
  PerJobFilesystem,
  Dram,
  placement_supply_row_from_bmc,
}
import product.placement_supply { PlacementSupplyRow }

// ---- srv1 live Redfish probe (srv1 ≡ srv2 hardware; BMC on the management plane at .183) ----
data srv1_bmc_redfish_system: RedfishSystemInventory = redfish_system_inventory(
  model: "ALTRAD8UD-1L2T",
  manufacturer: Present { value: "ASRockRack" },
  processor_model: "Ampere(R) Altra(R) Processor",
  processor_count: 1,
  processor_core_count: hardware_thread_count(128),
  total_memory_gib: gibibyte(128),
  power_state: On,
  logical_processor_count: Present { value: hardware_thread_count(128) },
)

data srv1_bmc_telemetry: BmcTelemetrySnapshot = BmcTelemetrySnapshot {
  system: srv1_bmc_redfish_system,
  power: none,
  thermal: none,
  sensors: none,
}

// ---- shared host facts (the two hosts are identical hardware) ----
data operator_fleet_cpu: CpuFacts = CpuFacts {
  catalog: altra_max_m12830_catalog,
  deployment: CpuDeploymentFacts { sustained_per_thread_hz: hertz(3000000000) },
}

data operator_fleet_os_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: none,   // operator-private — resolved at runtime, never committed (skip-ctrl)
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

// ---- baseboards (out-of-band BMC management plane) ----
data srv1_baseboard: ServerBaseboard = ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: BmcEndpoint { host: "192.168.1.183", protocol: Redfish },
}
data srv2_baseboard: ServerBaseboard = ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: BmcEndpoint { host: "192.168.1.184", protocol: Redfish },
}

// ---- rotated BMC credentials: HANDLES only, value NEVER committed (the skip-ctrl privacy) ----
// The factory default (root/0penBmc) is a cited public fact (extdeps/bmc/openbmc.dag); the
// rotated admin secret lives in the secret manager, referenced here by name only — never in git.
data srv1_bmc_credential: CredentialFlow = Stored { secret_name: "bmc-srv1-admin" }
data srv2_bmc_credential: CredentialFlow = Stored { secret_name: "bmc-srv2-admin" }

// ---- hosts ----
data srv1_host: ComputeHost = ComputeHost {
  identity: operator_host_srv1,
  baseboard: Present { value: srv1_baseboard },
  processors: [CpuProcessor { cpu: operator_fleet_cpu }],
  memory: [MemoryDevice { capacity: gibibyte_to_byte_size(g: gibibyte(128)), memory_kind: Dram, bandwidth: none }],
  storage: [],
  network_interfaces: [],
}
data srv2_host: ComputeHost = ComputeHost {
  identity: operator_host_srv2,
  baseboard: Present { value: srv2_baseboard },
  processors: [CpuProcessor { cpu: operator_fleet_cpu }],
  memory: [MemoryDevice { capacity: gibibyte_to_byte_size(g: gibibyte(128)), memory_kind: Dram, bandwidth: none }],
  storage: [],
  network_interfaces: [],
}

fn operator_fleet_execution_surface() -> ExecutionSurface {
  ExecutionSurface {
    os: operator_fleet_os_surface,
    isolation: PerJobFilesystem,
    container_runtime: none,
    toolchains: [],
    mounted_storage: [],
    network: [],
  }
}

// Operator-owned hardware: marginal cost zero (the machines are already paid for).
fn operator_owned_cost() -> CostModel {
  CostModel { cost_class: OwnedMarginalZero, rates: ProviderCostModel { placeholder: true } }
}

// ---- offers (the operator owns srv1/srv2) ----
data srv1_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-operator-srv1",
  supply: ComputeSupplyFacts {
    physical: srv1_host,
    execution: operator_fleet_execution_surface(),
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
  constraints: [],
}
data srv2_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-operator-srv2",
  supply: ComputeSupplyFacts {
    physical: srv2_host,
    execution: operator_fleet_execution_surface(),
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
  constraints: [],
}

// ---- the fleet: the single authority CI / sessions / placement derive from ----
data operator_fleet_offers: List<ComputeOffer> = [srv1_offer, srv2_offer]

// ---- per-host BMC-grounded placement rows (what the allocator's admit() consumes) ----
fn srv1_placement_supply() -> PlacementSupplyRow {
  placement_supply_row_from_bmc(
    identity: operator_host_srv1,
    obs: bmc_ground_snapshot(snapshot: srv1_bmc_telemetry),
    cpu: operator_fleet_cpu,
  )
}
fn srv2_placement_supply() -> PlacementSupplyRow {
  placement_supply_row_from_bmc(
    identity: operator_host_srv2,
    obs: bmc_ground_snapshot(snapshot: fleet_srv2_bmc_telemetry),
    cpu: operator_fleet_cpu,
  )
}
