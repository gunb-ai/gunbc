// gunbc/operator_fleet.dag — the operator fleet inventory (srv1 + srv2 as compute-fabric hosts).
//
// srv1 + srv2 as real ComputeOffer values (ASRock Rack ALTRAD8UD-1L2T, Ampere Altra M128-30,
// 128c/128t, 128 GiB DDR4). PUBLIC in gunbc — we skip the private ctrl repo. The privacy
// boundary is handled in-repo: rotated BMC credentials are std.credentials handles (never
// committed); operator-private distro left absent. The operator owns the fleet (provider).
//
// Plain inventory — the spawn-width/allocator/placement modeling was removed as unwired
// complexity; this is the authority that CI/sessions/placement can derive from when a real
// consumer needs it.

module gunbc.operator_fleet

import gunbc.operator_fleet_network { operator_host_srv1, operator_host_srv2 }
import extdeps.cpu.ampere { altra_max_m12830_catalog }
import extdeps.cpu.types { CpuFacts, CpuDeploymentFacts }
import extdeps.boards.asrock_rack { asrock_altrad8ud_1l2t_catalog }
import std.baseboard { ServerBaseboard }
import std.bmc { BmcEndpoint, Redfish }
import std.credentials { CredentialFlow, Stored }
import std.measure { gibibyte, gibibyte_to_byte_size, hertz }
import std.os.types { OperatingSystemSurface, Linux, Posix, PosixProcess }
import std.types { List }
import product.compute_fabric {
  ComputeOffer,
  ComputeSupplyFacts,
  ComputeHost,
  ExecutionSurface,
  MemoryDevice,
  CpuProcessor,
  AvailabilityWindow,
  CostModel,
  ProviderCostModel,
  OwnedMarginalZero,
  PerJobFilesystem,
  Dram,
}

// Shared host facts (the two hosts are identical hardware).
data operator_fleet_cpu: CpuFacts = CpuFacts {
  catalog: altra_max_m12830_catalog,
  deployment: CpuDeploymentFacts { sustained_per_thread_hz: hertz(3000000000) },
}

data operator_fleet_os_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: none,   // operator-private — resolved at runtime, never committed (skip-ctrl)
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

// Baseboards (out-of-band BMC management plane).
data srv1_baseboard: ServerBaseboard = ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: BmcEndpoint { host: "192.168.1.183", protocol: Redfish },
}
data srv2_baseboard: ServerBaseboard = ServerBaseboard {
  catalog: asrock_altrad8ud_1l2t_catalog,
  bmc: BmcEndpoint { host: "192.168.1.184", protocol: Redfish },
}

// Rotated BMC credentials: HANDLES only, value NEVER committed (the skip-ctrl privacy).
data srv1_bmc_credential: CredentialFlow = Stored { secret_name: "bmc-srv1-admin" }
data srv2_bmc_credential: CredentialFlow = Stored { secret_name: "bmc-srv2-admin" }

data srv1_host: ComputeHost = ComputeHost {
  identity: operator_host_srv1,
  baseboard: Present { value: srv1_baseboard },
  processors: [CpuProcessor { cpu: operator_fleet_cpu }],
  memory: [MemoryDevice { capacity: gibibyte_to_byte_size(g: gibibyte(128)), memory_kind: Dram, bandwidth: none }],
  storage: [],
  network_interfaces: [],
}
data srv2_host: ComputeHost = ComputeHost {
  identity: operator_host_srv2,
  baseboard: Present { value: srv2_baseboard },
  processors: [CpuProcessor { cpu: operator_fleet_cpu }],
  memory: [MemoryDevice { capacity: gibibyte_to_byte_size(g: gibibyte(128)), memory_kind: Dram, bandwidth: none }],
  storage: [],
  network_interfaces: [],
}

fn operator_fleet_execution_surface() -> ExecutionSurface {
  ExecutionSurface {
    os: operator_fleet_os_surface,
    isolation: PerJobFilesystem,
    container_runtime: none,
    toolchains: [],
    mounted_storage: [],
    network: [],
  }
}

fn operator_owned_cost() -> CostModel {
  CostModel { cost_class: OwnedMarginalZero, rates: ProviderCostModel { placeholder: true } }
}

data srv1_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-operator-srv1",
  supply: ComputeSupplyFacts {
    physical: srv1_host,
    execution: operator_fleet_execution_surface(),
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
  constraints: [],
}
data srv2_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-operator-srv2",
  supply: ComputeSupplyFacts {
    physical: srv2_host,
    execution: operator_fleet_execution_surface(),
    cost: Present { value: operator_owned_cost() },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
  constraints: [],
}

// The fleet: the single inventory authority CI / sessions / placement derive from.
data operator_fleet_offers: List<ComputeOffer> = [srv1_offer, srv2_offer]
