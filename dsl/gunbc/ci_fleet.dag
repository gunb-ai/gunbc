// gunbc/ci_fleet.dag — Phase 3a-ours: gunbc CI fleet ComputeOffer meta-model.
//
// OUR self-hosted runner fleet instantiated as compute_fabric data. Concrete srv1/srv2
// operator inventory remains private (ctrl); this module is public-in-repo meta-modeling
// consumed by ci_workflow / ci_yaml_emit via gunbc_ci_runner_spec().

module gunbc.ci_fleet

import extdeps.cpu.ampere { altra_q6430_catalog }
import extdeps.github.actions { RunnerSpec }
import gunbc.runner_spec_from_offer { runner_spec_from_offer }
import gunbc.fleet_srv2_bmc_fixture {
  fleet_srv2_bmc_redfish_system,
  fleet_srv2_bmc_telemetry,
}
import extdeps.bmc.types { BmcGroundedHostObservations }
import extdeps.bmc { bmc_ground_snapshot }
import product.compute_fabric {
  ComputeOffer,
  ComputeSupplyFacts,
  ComputeHost,
  ExecutionSurface,
  MemoryDevice,
  CpuProcessor,
  AvailabilityWindow,
  CostModel,
  ProviderCostModel,
  OwnedMarginalZero,
  PerJobFilesystem,
  Dram,
  WorkDemand,
  ResourceEnvelope,
  MemoryRequirement,
  IsolationRequirement,
  IndependentShards,
  placement_spawn_width,
  placement_floor_memory_budget_bytes,
  placement_supply_row_from_bmc,
}
import extdeps.cpu.types { CpuFacts, CpuDeploymentFacts }
import std.measure {
  byte_size,
  byte_size_count,
  gibibyte,
  gibibyte_to_byte_size,
  hertz,
  hardware_thread_count,
  hardware_thread_count_value,
  HardwareThreadCount,
}
import std.os.types {
  OperatingSystemSurface,
  Linux,
  Posix,
  PosixProcess,
}
import product.placement_supply { HostIdentity, PlacementSupplyRow }

data gunbc_ci_host_identity: HostIdentity = "gunbc-ci-fleet"

fn gunbc_ci_bmc_grounded() -> BmcGroundedHostObservations {
  bmc_ground_snapshot(snapshot: fleet_srv2_bmc_telemetry)
}

data gunbc_ci_cpu: CpuFacts = CpuFacts {
  catalog: altra_q6430_catalog,
  deployment: CpuDeploymentFacts { sustained_per_thread_hz: hertz(3000000000) },
}

data gunbc_ci_linux_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: none,
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

data gunbc_ci_host: ComputeHost = ComputeHost {
  identity: gunbc_ci_host_identity,
  baseboard: none,
  processors: [CpuProcessor { cpu: gunbc_ci_cpu }],
  memory: [
    MemoryDevice {
      capacity: gibibyte_to_byte_size(g: gibibyte(128)),
      memory_kind: Dram,
      bandwidth: none,
    },
  ],
  storage: [],
  network_interfaces: [],
}

data gunbc_ci_fleet_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-ci-fleet",
  supply: ComputeSupplyFacts {
    physical: gunbc_ci_host,
    execution: ExecutionSurface {
      os: gunbc_ci_linux_surface,
      isolation: PerJobFilesystem,
      container_runtime: none,
      toolchains: [],
      mounted_storage: [],
      network: [],
    },
    cost: Present {
      value: CostModel {
        cost_class: OwnedMarginalZero,
        rates: ProviderCostModel { placeholder: true },
      },
    },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
  constraints: [],
}

fn gunbc_ci_runner_spec() -> RunnerSpec {
  runner_spec_from_offer(offer: gunbc_ci_fleet_offer)
}

// Corpus parallel breadth is the CALLER's fact: the floor plan derives it from the
// single-authority spec (gates + corpus cardinality), so it is NOT a tuned constant.
fn gunbc_ci_floor_corpus_work_demand(corpus_shard_count: Int) -> WorkDemand {
  WorkDemand {
    resources: ResourceEnvelope {
      cpu: none,
      gpu: none,
      // Per-shard peak resolve memory (#5375). Pig witnesses (Arc1-class ~31 GiB) are
      // contained by the operator cgroup cap on system-actions-runner.slice — NOT by
      // serializing width to 1. eager-boar-790 slims the pig content; see
      // docs/runbooks/ci-runner-cgroup-memory-cap.md.
      memory: Present { value: MemoryRequirement { min_bytes: byte_size(15032385536) } },
      storage: none,
      network: none,
    },
    os: none,
    isolation: IsolationRequirement { boundary: PerJobFilesystem },
    toolchains: [],
    parallelism: IndependentShards { shard_count: corpus_shard_count },
    data_locality: [],
    effects: [],
  }
}

// BMC-grounded placement for width fold (#5375 + allocator plan step 3 supply grounding).
fn gunbc_ci_floor_placement_supply() -> PlacementSupplyRow? {
  Present {
    value: placement_supply_row_from_bmc(
      identity: gunbc_ci_host_identity,
      obs: gunbc_ci_bmc_grounded(),
      cpu: gunbc_ci_cpu,
    ),
  }
}

// Host spawn-width = min(corpus breadth, hardware threads, memory_budget / per-shard peak).
// #5375 memory-aware width (typically 4 on the fleet) — do NOT force serial width=1.
fn ci_fleet_floor_spawn_width(corpus_shard_count: Int) -> HardwareThreadCount {
  match gunbc_ci_floor_placement_supply() {
    Absent => hardware_thread_count(1)
    Present { value: row } =>
      placement_spawn_width(
        supply: row,
        demand: gunbc_ci_floor_corpus_work_demand(corpus_shard_count: corpus_shard_count),
      )
  }
}

// §5 OOM oracle: width × per-shard peak fits the conservative memory budget.
fn ci_fleet_floor_spawn_fits_memory_budget(corpus_shard_count: Int) -> Bool {
  match gunbc_ci_floor_placement_supply() {
    Absent => true
    Present { value: row } =>
      match gunbc_ci_floor_corpus_work_demand(corpus_shard_count: corpus_shard_count).resources.memory {
        Absent => true
        Present { value: req } => {
          let width = hardware_thread_count_value(
            t: ci_fleet_floor_spawn_width(corpus_shard_count: corpus_shard_count),
          )
          width * byte_size_count(req.min_bytes) <= placement_floor_memory_budget_bytes(supply: row)
        }
      }
  }
}
