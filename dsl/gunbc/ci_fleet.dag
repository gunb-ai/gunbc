// gunbc/ci_fleet.dag — Phase 3a-ours: gunbc CI fleet ComputeOffer meta-model.
//
// OUR self-hosted runner fleet instantiated as compute_fabric data. Concrete srv1/srv2
// operator inventory remains private (ctrl); this module is public-in-repo meta-modeling
// consumed by ci_workflow / ci_yaml_emit via gunbc_ci_runner_spec().

module gunbc.ci_fleet

import extdeps.cpu.ampere { altra_q6430_catalog }
import extdeps.github.actions { RunnerSpec }
import gunbc.runner_spec_from_offer { runner_spec_from_offer }
import extdeps.bmc.types {
  BmcGroundedHostObservations,
  BmcTelemetrySnapshot,
  RedfishChassisSensorCollection,
  RedfishSensorReading,
  RedfishSystemInventory,
  On,
}
import extdeps.bmc.redfish { redfish_system_inventory }
import extdeps.bmc { bmc_ground_snapshot }
import extdeps.boards.asrock_rack { asrock_altrad8ud_redfish_chassis_id }
import product.compute_fabric {
  ComputeOffer,
  ComputeSupplyFacts,
  ComputeHost,
  ExecutionSurface,
  MemoryDevice,
  CpuProcessor,
  AvailabilityWindow,
  CostModel,
  ProviderCostModel,
  OwnedMarginalZero,
  PerJobFilesystem,
  Dram,
  ComputeRequest,
  placement_spawn_width_for_request,
  placement_grantable_memory_bytes,
  placement_supply_row_from_bmc,
  allocation_class_memory_cost,
}
import extdeps.cpu.types { CpuFacts, CpuDeploymentFacts }
import std.measure {
  byte_size,
  gibibyte,
  gibibyte_to_byte_size,
  hertz,
  hardware_thread_count,
  hardware_thread_count_value,
  HardwareThreadCount,
  watt,
}
import std.os.types {
  OperatingSystemSurface,
  Linux,
  Posix,
  PosixProcess,
}
import product.placement_supply { HostIdentity, PlacementSupplyRow }

data gunbc_ci_host_identity: HostIdentity = "gunbc-ci-fleet"

// BMC-grounded srv2 inventory (live Redfish probe 2026-06-20, operator warm-crane-135).
// Replaces hand-typed RAM/thread stubs — allocator plan step 3.
data gunbc_ci_bmc_redfish_system: RedfishSystemInventory = redfish_system_inventory(
  model: "ALTRAD8UD-1L2T",
  manufacturer: Present { value: "ASRockRack" },
  processor_model: "Ampere(R) Altra(R) Processor",
  processor_count: 1,
  processor_core_count: hardware_thread_count(128),
  total_memory_gib: gibibyte(128),
  power_state: On,
  logical_processor_count: Present { value: hardware_thread_count(128) },
)

data gunbc_ci_bmc_sensor_power: RedfishChassisSensorCollection = RedfishChassisSensorCollection {
  chassis_id: asrock_altrad8ud_redfish_chassis_id,
  sensors: [
    PowerSensor {
      name: "power_PWR_Core_VRD",
      watts: Present { value: watt(count: 95) },
    },
    PowerSensor {
      name: "power_PWR_SOC_VRD",
      watts: Present { value: watt(count: 17) },
    },
  ],
}

data gunbc_ci_bmc_telemetry: BmcTelemetrySnapshot = BmcTelemetrySnapshot {
  system: gunbc_ci_bmc_redfish_system,
  power: none,
  thermal: none,
  sensors: Present { value: gunbc_ci_bmc_sensor_power },
}

fn gunbc_ci_bmc_grounded() -> BmcGroundedHostObservations {
  bmc_ground_snapshot(snapshot: gunbc_ci_bmc_telemetry)
}

data gunbc_ci_cpu: CpuFacts = CpuFacts {
  catalog: altra_q6430_catalog,
  deployment: CpuDeploymentFacts {
    sustained_per_thread_hz: hertz(3000000000),
  },
}

data gunbc_ci_linux_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: none,
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

data gunbc_ci_host: ComputeHost = ComputeHost {
  identity: gunbc_ci_host_identity,
  baseboard: none,
  processors: [CpuProcessor { cpu: gunbc_ci_cpu }],
  memory: [
    MemoryDevice {
      capacity: gibibyte_to_byte_size(g: gibibyte(128)),
      memory_kind: Dram,
      bandwidth: none,
    },
  ],
  storage: [],
  network_interfaces: [],
}

data gunbc_ci_fleet_offer: ComputeOffer = ComputeOffer {
  provider: "gunbc-ci-fleet",
  supply: ComputeSupplyFacts {
    physical: gunbc_ci_host,
    execution: ExecutionSurface {
      os: gunbc_ci_linux_surface,
      isolation: PerJobFilesystem,
      container_runtime: none,
      toolchains: [],
      mounted_storage: [],
      network: [],
    },
    cost: Present {
      value: CostModel {
        cost_class: OwnedMarginalZero,
        rates: ProviderCostModel { placeholder: true },
      },
    },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: "always-open", close: none },
  cost_quote: none,
  constraints: [],
}

fn gunbc_ci_runner_spec() -> RunnerSpec {
  runner_spec_from_offer(offer: gunbc_ci_fleet_offer)
}

// CI floor is a pure fabric consumer (allocator plan step 2): it names a fixed
// allocation class; the fabric derives memory/width — no hand-tuned 14 GiB constant.
fn gunbc_ci_floor_compute_request() -> ComputeRequest {
  ComputeRequest { class: XLarge }
}

// Meantime reserve until step 4 routes agent sessions through admit: headroom for
// non-CI consumers on a shared host (2026-06-20 census — 20 agent containers under
// load; ~48 GiB observed concurrent footprint on srv2).
fn ci_fleet_host_consumer_reserve_bytes() -> ByteSize {
  byte_size(51539607552)
}

fn gunbc_ci_floor_placement_supply() -> PlacementSupplyRow? {
  Present {
    value: placement_supply_row_from_bmc(
      identity: gunbc_ci_host_identity,
      obs: gunbc_ci_bmc_grounded(),
      cpu: gunbc_ci_cpu,
    ),
  }
}

// Host spawn-width = fabric projection from ComputeRequest + BMC-grounded supply.
// No hand-tuned width: add a gate → breadth re-derives; BMC grounds RAM/threads;
// the reserve + allocation class back fan-out off before host OOM.
fn ci_fleet_floor_spawn_width(corpus_shard_count: Int) -> HardwareThreadCount {
  match gunbc_ci_floor_placement_supply() {
    Absent => hardware_thread_count(1)
    Present { value: row } =>
      placement_spawn_width_for_request(
        supply: row,
        request: gunbc_ci_floor_compute_request(),
        shard_count: corpus_shard_count,
        reserve_bytes: ci_fleet_host_consumer_reserve_bytes(),
      )
  }
}

// §5 OOM oracle: the chosen floor width times the class memory envelope must fit
// grantable (BMC RAM budget minus non-CI reserve). Discriminating against the
// memory-blind / hand-constant regressions that let claim_executor reach ~93 GiB.
fn ci_fleet_floor_spawn_fits_memory_budget(corpus_shard_count: Int) -> Bool {
  match gunbc_ci_floor_placement_supply() {
    Absent => true
    Present { value: row } => {
      let request = gunbc_ci_floor_compute_request()
      let width = hardware_thread_count_value(
        t: ci_fleet_floor_spawn_width(corpus_shard_count: corpus_shard_count),
      )
      let per_unit = allocation_class_memory_cost(class: request.class)
      let grantable = placement_grantable_memory_bytes(
        supply: row,
        reserve_bytes: ci_fleet_host_consumer_reserve_bytes(),
      )
      width * per_unit <= grantable
    }
  }
}
