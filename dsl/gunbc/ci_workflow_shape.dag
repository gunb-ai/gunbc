// gunbc/ci_workflow_shape.dag — the ONE repo-CI workflow-construction authority.
//
// §2-horizontal (DESIGN §2): a repo CI workflow is `repo_ci_workflow(name, triggers,
// run_step)` — the shared runner prelude (sccache-isolation, checkout, setup-rust,
// pin-rustup, cache-cargo), concurrency, env, permissions, runner, and job-timeout are
// authored ONCE here; `ci_workflow` and `nightly_workflow` are two CALLS (two rows) that
// differ ONLY in name, triggers, and the final run step. Copying the prelude into a second
// workflow value would fork "the repo CI runner prelude" into two authorities (§3) — this
// module exists so that fork is unwritable.
//
// Byte-identity oracle: `tools.ci_yaml_gate` (CiYamlGate) asserts the committed ci.yml equals
// `serialize_yaml(project_workflow_to_yaml(ci_workflow))` byte-for-byte; green proves this
// factoring preserved ci.yml exactly (DESIGN §5 green-by-execution).

module gunbc.ci_workflow_shape

import extdeps.formats.yaml { yaml_string, yaml_int, yaml_bool, kv }
import gunbc.ci_fleet { gunbc_ci_runner_spec }
import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep,
  WorkflowTrigger,
  WorkflowPermissions, PermRead,
  ConcurrencyMappingQueueNotMax, CancelInProgressBool,
  checkout_action, setup_rust_action, cache_action,
  default_job_timeout_minutes
}

// The five environment-prep steps every repo CI job runs identically, BEFORE the
// workflow-specific final run step. Verbatim from the prior inlined ci_workflow steps 1–5
// (byte-identity is gate-checked).
fn repo_ci_prelude_steps() -> List<Step> {
  [
    RunStep {
      name: Present { value: "Isolate toolchain dirs" },
      id: none,
      // CARGO_HOME/RUSTUP_HOME before Setup Rust + Cache Cargo. Fleet sccache is
      // host-managed (SCCACHE_SERVER_UDS); enable wrapper only when daemon responds.
      run: concat(
        concat(
          concat(
            "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\n",
            "echo \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n"
          ),
          "if sccache --show-stats >/dev/null 2>&1; then\n"
        ),
        concat(
          concat(
            "  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n",
            concat(
              "  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\n",
              concat(
                "  echo \"CARGO_BUILD_JOBS=1\" >> \"$GITHUB_ENV\"\n",
                concat(
                  "else\n",
                  concat(
                    "  echo \"CARGO_BUILD_JOBS=2\" >> \"$GITHUB_ENV\"\n",
                    "fi"
                  )
                )
              )
            )
          ),
          ""
        )
      ),
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Checkout" },
      id: none,
      uses: checkout_action,
      with: Present {
        value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
      },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Setup Rust" },
      id: none,
      uses: setup_rust_action,
      with: Present {
        value: [
          kv(key: "components", value: yaml_string(s: "rustfmt")),
          kv(key: "cache", value: yaml_bool(b: false)),
          kv(key: "rustflags", value: yaml_string(s: ""))
        ]
      },
      env: Present {
        value: [kv(key: "HOME", value: yaml_string(s: "${{ runner.temp }}"))]
      },
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    RunStep {
      name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
      id: none,
      run: concat(
        "rustup default \"$(rustup show active-toolchain | awk '",
        concat(concat("{", "print $1; exit"), concat("}", "')\""))
      ),
      shell: none,
      env: none,
      working_directory: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    },
    UsesStep {
      name: Present { value: "Cache Cargo" },
      id: none,
      uses: cache_action,
      with: Present {
        value: [
          kv(key: "path", value: yaml_string(s: concat(
            concat(
              concat(
                "${{ runner.temp }}/cargo/registry/index/\n",
                "${{ runner.temp }}/cargo/registry/cache/\n"
              ),
              concat(
                "${{ runner.temp }}/cargo/git/db/\n",
                "target/"
              )
            ),
            ""
          ))),
          kv(key: "key", value: yaml_string(s: "cargo-ci-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('**/Cargo.lock', 'rust-toolchain.toml') }}")),
          kv(key: "restore-keys", value: yaml_string(s: "cargo-ci-${{ runner.os }}-${{ runner.arch }}-\n"))
        ]
      },
      env: none,
      if_condition: none,
      continue_on_error: none,
      timeout_minutes: none
    }
  ]
}

// The single repo-CI job: shared runner, timeout, and prelude; the workflow-specific final
// run step appended. `id` doubles as the `jobs:` YAML key and equals the workflow name (ci /
// nightly) — derived, not a separate arg.
fn repo_ci_job(id: String, run_step: Step) -> Job {
  {
    id: id,
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: concat(repo_ci_prelude_steps(), [run_step]),
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: default_job_timeout_minutes },
    continue_on_error: none,
    concurrency: none
  }
}

// The ONE workflow-construction authority. `name`, `triggers`, and `run_step` are the only
// facts that differ between repo CI workflows; everything else is shared by construction.
fn repo_ci_workflow(name: String, triggers: List<WorkflowTrigger>, run_step: Step) -> Workflow {
  {
    name: name,
    on: triggers,
    concurrency: Present {
      value: ConcurrencyMappingQueueNotMax {
        group: "${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}",
        cancel_in_progress: Present { value: CancelInProgressBool { value: true } },
        explicit_single: none
      }
    },
    env: Present {
      value: [
        kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
        kv(key: "RUSTFLAGS", value: yaml_string(s: "-D warnings"))
      ]
    },
    permissions: Present {
      value: WorkflowPermissions {
        contents: Present { value: PermRead },
        pull_requests: Present { value: PermRead },
        issues: none,
        actions: none
      }
    },
    jobs: [repo_ci_job(id: name, run_step: run_step)]
  }
}
