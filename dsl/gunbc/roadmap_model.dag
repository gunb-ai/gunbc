module gunbc.roadmap_model

import ctrl.process_algebra { ProcessNodeId }
import gunbc.roadmap_status { RoadmapItem, DriftVerdict, status_drift }

type PlanDocCarrier
  = NoCarrier
  | PlanDoc { path: String }

type RoadmapNode {
  node: ProcessNodeId
  line: RoadmapItem
  carrier: PlanDocCarrier
}

type RoadmapEdge {
  child: ProcessNodeId
  parent: ProcessNodeId
}

type RoadmapParent
  = TopLevel
  | UnderParent { parent: ProcessNodeId }

fn under_parent(p: ProcessNodeId) -> RoadmapParent { UnderParent { parent: p } }
fn top_level() -> RoadmapParent { TopLevel }

fn edge_parent_for(e: RoadmapEdge, node: ProcessNodeId) -> RoadmapParent {
  if e.child == node { under_parent(p: e.parent) } else { top_level() }
}

fn roadmap_parent(edges: List<RoadmapEdge>, node: ProcessNodeId) -> RoadmapParent {
  fold(edges, init: TopLevel, f: (acc, e) => match acc {
    UnderParent { parent: p } => UnderParent { parent: p }
    TopLevel => edge_parent_for(e: e, node: node)
  })
}

fn is_top_level(edges: List<RoadmapEdge>, node: ProcessNodeId) -> Bool {
  match roadmap_parent(edges: edges, node: node) {
    TopLevel => true
    UnderParent { parent: _ } => false
  }
}

fn carrier_resolves(carrier: PlanDocCarrier, existing_docs: List<String>) -> Bool {
  match carrier {
    NoCarrier => true
    PlanDoc { path } => existing_docs |> any(d => d == path)
  }
}

fn node_carrier_clean(rn: RoadmapNode, existing_docs: List<String>) -> Bool {
  carrier_resolves(carrier: rn.carrier, existing_docs: existing_docs)
}

fn node_status_drift(rn: RoadmapNode, committed_box: Bool, merged: List<Int>) -> DriftVerdict {
  status_drift(item: rn.line, committed_box: committed_box, merged: merged)
}
