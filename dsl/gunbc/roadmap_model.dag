module gunbc.roadmap_model

import ctrl.process_algebra { ProcessNodeId }
import gunbc.roadmap_status { RoadmapItem, DriftVerdict, status_drift, Signoff, Unsigned, signoff_accepts, signoff_drift }

type Pointer { label: String, path: String }

type Intricacy
  = IntricacyLow
  | IntricacyMedium
  | IntricacyHigh

type Volume
  = VolumeSmall
  | VolumeMedium
  | VolumeLarge

type Acceptance
  = PrsMerged
  | ManualAcceptance

type NodeSizing
  = Unsized
  | Sized { intricacy: Intricacy, volume: Volume, repo: String, acceptance: Acceptance }

type RoadmapNode {
  node: ProcessNodeId
  line: RoadmapItem
  carriers: List<Pointer>
  sizing: NodeSizing
  owner: String
  signoff: Signoff
}

type RoadmapEdge {
  child: ProcessNodeId
  parent: ProcessNodeId
}

type SectionProse { content: String }
type SectionGroup { label: String, nodes: List<RoadmapNode>, edges: List<RoadmapEdge> }

type SectionElement
  = Prose { prose: SectionProse }
  | Group { group: SectionGroup }

fn section_prose(content: String) -> SectionElement { Prose { prose: SectionProse { content: content } } }
fn section_group(label: String, nodes: List<RoadmapNode>, edges: List<RoadmapEdge>) -> SectionElement {
  Group { group: SectionGroup { label: label, nodes: nodes, edges: edges } }
}

type RoadmapParent
  = TopLevel
  | UnderParent { parent: ProcessNodeId }

fn under_parent(p: ProcessNodeId) -> RoadmapParent { UnderParent { parent: p } }
fn top_level() -> RoadmapParent { TopLevel }

fn edge_parent_for(e: RoadmapEdge, node: ProcessNodeId) -> RoadmapParent {
  if e.child == node { under_parent(p: e.parent) } else { top_level() }
}

fn roadmap_parent(edges: List<RoadmapEdge>, node: ProcessNodeId) -> RoadmapParent {
  fold(edges, init: TopLevel, f: (acc, e) => match acc {
    UnderParent { parent: p } => UnderParent { parent: p }
    TopLevel => edge_parent_for(e: e, node: node)
  })
}

fn is_top_level(edges: List<RoadmapEdge>, node: ProcessNodeId) -> Bool {
  match roadmap_parent(edges: edges, node: node) {
    TopLevel => true
    UnderParent { parent: _ } => false
  }
}

fn pointer_resolves(p: Pointer, existing_docs: List<String>) -> Bool {
  existing_docs |> any(d => d == p.path)
}

fn node_carrier_clean(rn: RoadmapNode, existing_docs: List<String>) -> Bool {
  all(rn.carriers, p => pointer_resolves(p: p, existing_docs: existing_docs))
}

fn node_status_drift(rn: RoadmapNode, committed_box: Bool, merged: List<Int>) -> DriftVerdict {
  signoff_drift(s: rn.signoff, committed_box: committed_box)
}

fn node_closed(rn: RoadmapNode) -> Bool {
  signoff_accepts(s: rn.signoff)
}
