module gunbc.nbd_proxy_virtual_media_install

import std.types { List, Int }
import std.measure { ByteSize, byte_size }
import extdeps.bmc.types {
  RedfishBootSourceOverrideTarget,
  RedfishBootSourceOverrideEnabled,
  BootOverrideOnce,
  RedfishResetType,
  ResetForceRestart,
  RedfishSystemAction,
  SetBootSourceOverride,
  ResetSystem,
}
import extdeps.bmc.webui.nbd_proxy {
  NbdProxyServeInterface,
  BmcwebNbdProxyEndpointVariant,
}
import extdeps.boards.asrock_rack {
  asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint,
}
import gunbc.os_install_mechanism {
  solve_install_mechanism,
  srv3_install_mechanism,
}
import gunbc.host_effect {
  RedfishAction,
  BmcController,
  OneShotIdempotent,
  HostEffectIntent,
  LocalShell,
}
import gunbc.fleet_intent { srv3_host }

type OsInstallActuatorStep
  = ActuatorNbdProxyServe {
      endpoint: BmcwebNbdProxyEndpointVariant
      slot: Int
      index: Int
      export: NbdProxyServeInterface
    }
  | ActuatorRedfishInsertMedia
  | ActuatorPxeNetworkBootStaging
  | ActuatorFirmwareUpdate
  | ActuatorBootOnce {
      target: RedfishBootSourceOverrideTarget
      enabled: RedfishBootSourceOverrideEnabled
    }
  | ActuatorForceRestart { reset_type: RedfishResetType }

type OsInstallActuatorPlan {
  mechanism: OsInstallMechanism
  steps: List<OsInstallActuatorStep>
}

fn boot_once_step(target: RedfishBootSourceOverrideTarget) -> OsInstallActuatorStep {
  ActuatorBootOnce {
    target: target,
    enabled: BootOverrideOnce,
  }
}

fn force_restart_step() -> OsInstallActuatorStep {
  ActuatorForceRestart { reset_type: ResetForceRestart }
}

fn nbd_proxy_serve_step(export: NbdProxyServeInterface) -> OsInstallActuatorStep {
  ActuatorNbdProxyServe {
    endpoint: asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint,
    slot: 0,
    index: 0,
    export: export,
  }
}

fn os_install_actuator_steps(mechanism: OsInstallMechanism, export: NbdProxyServeInterface) -> List<OsInstallActuatorStep> {
  let boot_target = install_boot_target_for(mechanism: mechanism)
  match mechanism {
    VirtualMediaInstall => [
      ActuatorRedfishInsertMedia,
      boot_once_step(target: boot_target),
      force_restart_step(),
    ]
    NbdProxyVirtualMediaInstall => [
      nbd_proxy_serve_step(export: export),
      boot_once_step(target: boot_target),
      force_restart_step(),
    ]
    PxeHttpInstall => [
      ActuatorPxeNetworkBootStaging,
      boot_once_step(target: boot_target),
      force_restart_step(),
    ]
    FirmwareUpdateThenVirtualMedia => [
      ActuatorFirmwareUpdate,
      ActuatorRedfishInsertMedia,
      boot_once_step(target: boot_target),
      force_restart_step(),
    ]
  }
}

fn os_install_actuator_plan(mechanism: OsInstallMechanism, export: NbdProxyServeInterface) -> OsInstallActuatorPlan {
  OsInstallActuatorPlan {
    mechanism: mechanism,
    steps: os_install_actuator_steps(mechanism: mechanism, export: export),
  }
}

data srv3_nbd_proxy_export_placeholder: NbdProxyServeInterface = NbdProxyServeInterface {
  export_byte_count: byte_size(0),
}

data srv3_os_install_actuator_plan: OsInstallActuatorPlan = os_install_actuator_plan(
  mechanism: srv3_install_mechanism,
  export: srv3_nbd_proxy_export_placeholder
)

fn actuator_step_to_host_effect_intent(step: OsInstallActuatorStep) -> HostEffectIntent? {
  match step {
    ActuatorBootOnce { target: t, enabled: e } =>
      Present {
        value: HostEffectIntent {
          target: BmcController { node: srv3_host },
          effect: RedfishAction {
            action: SetBootSourceOverride { target: t, enabled: e }
          },
          policy: OneShotIdempotent,
          transport: LocalShell,
        }
      }
    ActuatorForceRestart { reset_type: r } =>
      Present {
        value: HostEffectIntent {
          target: BmcController { node: srv3_host },
          effect: RedfishAction {
            action: ResetSystem { reset_type: r }
          },
          policy: OneShotIdempotent,
          transport: LocalShell,
        }
      }
    ActuatorNbdProxyServe { endpoint: _, slot: _, index: _, export: _ } => Absent
    ActuatorRedfishInsertMedia => Absent
    ActuatorPxeNetworkBootStaging => Absent
    ActuatorFirmwareUpdate => Absent
  }
}

fn os_install_actuator_step_count(plan: OsInstallActuatorPlan) -> Int {
  plan.steps.length()
}
