// Non-authoritative interim typed Actions carrier for .github/workflows/ci.yml.
// `.github/workflows/ci.yml` remains the hand-edited workflow authority until the T-24 CI model
// emits it; this static carrier is only the YamlStatic input consumed by `gunbc.ci`.
// Source-SHA256(.github/workflows/ci.yml): 871c99812a8426068ba3d5dd79727fb25e536d0344aa6bda330ff85936897eb1
// Dissolve-on: T-24 `src/v4/workflow/ci.dag` projection emits the Actions workflow and deletes
// this static carrier.

module gunbc.ci.github_actions_workflow

import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep, ActionRef,
  WorkflowTrigger, Push, PullRequest,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview, Closed,
  WorkflowPermissions, PermRead, PermWrite, PermNone,
  ConcurrencySpec, ConcurrencyMappingQueueNotMax,
  CancelInProgressSpec, CancelInProgressBool,
  HostedRunner, SelfHosted, RunsOnExpression,
  RunnerLabel, UbuntuLatest,
  ShellType, Bash
}

data gunbc_ci_github_actions_workflow: Workflow = {
  name: "ci",
  on: [Push { branches: ["main"], paths: [] }, PullRequest { branches: ["main"], types: [Opened, Synchronize, Reopened, ReadyForReview] }],
  concurrency: Some {
  value: ConcurrencyMappingQueueNotMax {
      group: "${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}",
      cancel_in_progress: Some { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  jobs: [{
      id: "fmt",
      name: none,
      runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
      steps: [RunStep {
          name: Some { value: "Isolate toolchain dirs (srv1/srv2 shared-$HOME concurrent-rustup race)" },
          id: none,
          run: "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\necho \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n# INTERIM sccache transport (operator 2026-06-01 override; \"disregard the memo for now\").\n# Right-way fix is the modeled cache_interface projection consumer (dsl/std/cache_interface.dag\n# sccache_local_facts; src/v4/workflow/ci.dag cache-projection note) — NOT this hand-wire.\n# These jobs build directly on the srv1/srv2 host, so rustc/build paths are real host paths\n# the host-wide ctrl-sccache.service (ctrl#1399, 50G shared LRU) can exec/read — no container\n# path translation. Gate on a real server handshake (--show-stats over the UDS), NOT mere\n# socket existence: the socket file can be present yet unconnectable by the runner user\n# (ctrl#1399 socket perms), and a bare `[ -S ]` gate would then export RUSTC_WRAPPER and the\n# build would die with \"sccache: Permission denied\". A failed handshake degrades observably to\n# a cold build (::warning), never silently and never fail-hard. dissolve-on-arrival.\nif [ -S /var/lib/ctrl/sccache/server.sock ] \\\n  && SCCACHE_SERVER_UDS=/var/lib/ctrl/sccache/server.sock sccache --show-stats >/dev/null 2>&1; then\n  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n  echo \"SCCACHE_SERVER_UDS=/var/lib/ctrl/sccache/server.sock\" >> \"$GITHUB_ENV\"\n  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\nelse\n  echo \"::warning::sccache server at /var/lib/ctrl/sccache/server.sock absent or not usable by runner user; building cold\"\nfi\n",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Clear inherited GitHub auth header (shared runner HOME)" },
          id: none,
          run: "git config --global --unset-all http.https://github.com/.extraheader || true",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Checkout" },
          id: none,
          uses: { owner: "actions", repo: "checkout", ref: "v4" },
          with: { "fetch-depth": "1" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Setup Rust" },
          id: none,
          uses: { owner: "actions-rust-lang", repo: "setup-rust-toolchain", ref: "v1.16.0" },
          with: { "components": "rustfmt", "cache": "false", "rustflags": "" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Pin global rustup default (isolated RUSTUP_HOME has no default toolchain)" },
          id: none,
          run: "rustup default \"$(rustup show active-toolchain | awk '{print $1; exit}')\"",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "cargo fmt --all --check" },
          id: none,
          run: "cargo fmt --all --check",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }],
      needs: [],
      env: none,
      outputs: none,
      if_condition: Some { value: "github.event.pull_request.draft != true" },
      strategy: none,
      timeout_minutes: Some { value: 15 },
      continue_on_error: false,
      concurrency: none
    }, {
      id: "affected",
      name: none,
      continue_on_error: true,
      runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
      steps: [RunStep {
          name: Some { value: "Isolate toolchain dirs (srv1/srv2 shared-$HOME concurrent-rustup race)" },
          id: none,
          run: "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\necho \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n# INTERIM sccache transport (operator 2026-06-01 override; \"disregard the memo for now\").\n# Right-way fix is the modeled cache_interface projection consumer (dsl/std/cache_interface.dag\n# sccache_local_facts; src/v4/workflow/ci.dag cache-projection note) — NOT this hand-wire.\n# These jobs build directly on the srv1/srv2 host, so rustc/build paths are real host paths\n# the host-wide ctrl-sccache.service (ctrl#1399, 50G shared LRU) can exec/read — no container\n# path translation. Gate on a real server handshake (--show-stats over the UDS), NOT mere\n# socket existence: the socket file can be present yet unconnectable by the runner user\n# (ctrl#1399 socket perms), and a bare `[ -S ]` gate would then export RUSTC_WRAPPER and the\n# build would die with \"sccache: Permission denied\". A failed handshake degrades observably to\n# a cold build (::warning), never silently and never fail-hard. dissolve-on-arrival.\nif [ -S /var/lib/ctrl/sccache/server.sock ] \\\n  && SCCACHE_SERVER_UDS=/var/lib/ctrl/sccache/server.sock sccache --show-stats >/dev/null 2>&1; then\n  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n  echo \"SCCACHE_SERVER_UDS=/var/lib/ctrl/sccache/server.sock\" >> \"$GITHUB_ENV\"\n  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\nelse\n  echo \"::warning::sccache server at /var/lib/ctrl/sccache/server.sock absent or not usable by runner user; building cold\"\nfi\n",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Clear inherited GitHub auth header (shared runner HOME)" },
          id: none,
          run: "git config --global --unset-all http.https://github.com/.extraheader || true",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Checkout" },
          id: none,
          uses: { owner: "actions", repo: "checkout", ref: "v4" },
          with: { "fetch-depth": "0" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Setup Rust" },
          id: none,
          uses: { owner: "actions-rust-lang", repo: "setup-rust-toolchain", ref: "v1.16.0" },
          with: { "cache": "false", "rustflags": "" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Pin global rustup default (isolated RUSTUP_HOME has no default toolchain)" },
          id: none,
          run: "rustup default \"$(rustup show active-toolchain | awk '{print $1; exit}')\"",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Fetch main for diff base" },
          id: none,
          run: "git fetch origin main:refs/remotes/origin/main",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: Some { value: "github.event_name == 'pull_request'" },
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Detect affected components" },
          id: Some { value: "detect" },
          run: "cargo run -p ci_affected_components --bin detect-ci-affected-components -- \"${{ github.event_name }}\" \"$GITHUB_OUTPUT\"",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }],
      needs: [],
      env: none,
      outputs: { "v2": "${{ steps.detect.outputs.v2 }}", "v3": "${{ steps.detect.outputs.v3 }}", "v4": "${{ steps.detect.outputs.v4 }}", "testclaim_corpus": "${{ steps.detect.outputs.testclaim_corpus }}", "workflow_policy": "${{ steps.detect.outputs.workflow_policy }}", "release_distribution": "${{ steps.detect.outputs.release_distribution }}", "release_distribution_only": "${{ steps.detect.outputs.release_distribution_only }}" },
      if_condition: Some { value: "github.event.pull_request.draft != true" },
      strategy: none,
      timeout_minutes: Some { value: 15 },
      concurrency: none
    }, {
      id: "ci_floor",
      name: none,
      runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
      steps: [RunStep {
          name: Some { value: "Isolate toolchain dirs (srv1/srv2 shared-$HOME concurrent-rustup race)" },
          id: none,
          run: "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\necho \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n# INTERIM sccache transport (operator 2026-06-01 override; \"disregard the memo for now\").\n# Right-way fix is the modeled cache_interface projection consumer (dsl/std/cache_interface.dag\n# sccache_local_facts; src/v4/workflow/ci.dag cache-projection note) — NOT this hand-wire.\n# These jobs build directly on the srv1/srv2 host, so rustc/build paths are real host paths\n# the host-wide ctrl-sccache.service (ctrl#1399, 50G shared LRU) can exec/read — no container\n# path translation. Gate on a real server handshake (--show-stats over the UDS), NOT mere\n# socket existence: the socket file can be present yet unconnectable by the runner user\n# (ctrl#1399 socket perms), and a bare `[ -S ]` gate would then export RUSTC_WRAPPER and the\n# build would die with \"sccache: Permission denied\". A failed handshake degrades observably to\n# a cold build (::warning), never silently and never fail-hard. dissolve-on-arrival.\nif [ -S /var/lib/ctrl/sccache/server.sock ] \\\n  && SCCACHE_SERVER_UDS=/var/lib/ctrl/sccache/server.sock sccache --show-stats >/dev/null 2>&1; then\n  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n  echo \"SCCACHE_SERVER_UDS=/var/lib/ctrl/sccache/server.sock\" >> \"$GITHUB_ENV\"\n  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\nelse\n  echo \"::warning::sccache server at /var/lib/ctrl/sccache/server.sock absent or not usable by runner user; building cold\"\nfi\n",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Clear inherited GitHub auth header (shared runner HOME)" },
          id: none,
          run: "git config --global --unset-all http.https://github.com/.extraheader || true",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Checkout" },
          id: none,
          uses: { owner: "actions", repo: "checkout", ref: "v4" },
          with: { "fetch-depth": "0" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Setup Rust" },
          id: none,
          uses: { owner: "actions-rust-lang", repo: "setup-rust-toolchain", ref: "v1.16.0" },
          with: { "components": "rustfmt", "cache": "false", "rustflags": "" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Pin global rustup default (isolated RUSTUP_HOME has no default toolchain)" },
          id: none,
          run: "rustup default \"$(rustup show active-toolchain | awk '{print $1; exit}')\"",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Cache Cargo (ci floor)" },
          id: none,
          uses: { owner: "actions", repo: "cache", ref: "v4" },
          with: { "path": "${{ runner.temp }}/cargo/registry/index/\n${{ runner.temp }}/cargo/registry/cache/\n${{ runner.temp }}/cargo/git/db/\ntarget/\n", "key": "cargo-ci-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('**/Cargo.lock', 'rust-toolchain.toml') }}", "restore-keys": "cargo-ci-${{ runner.os }}-${{ runner.arch }}-\n" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Cache gunbc binary (v4 floor)" },
          id: Some { value: "v4-v2-bin" },
          uses: { owner: "actions", repo: "cache", ref: "v4" },
          with: { "path": "target/release/gunbc", "key": "gunbc-bin-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('src/v2/stage0/src/**', 'src/v2/stage0/Cargo.toml', 'Cargo.toml', '**/Cargo.lock', 'rust-toolchain.toml') }}" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Build v2 compiler (v4 floor)" },
          id: none,
          run: "cargo build -p v2-compiler --release",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: Some { value: "steps.v4-v2-bin.outputs.cache-hit != 'true'" },
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "M1 v4 full-tree rust emit probe (v2 emit + cargo check)" },
          id: none,
          run: "bash scripts/v4-m1-rust-emit-probe.sh",
          shell: Bash,
          env: { "V4_M1_RUST_EMIT_OUT": "${{ runner.temp }}/v4-rust-emit", "V4_M1_CARGO_CHECK_JOBS_CEILING": "64", "V4_M1_RUST_EMIT_PROBE_STRICT": "0" },
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: Some { value: 20 }
        }, RunStep {
