      steps: [RunStep {
          name: Some { value: "Validate gate evidence (fail-closed under v3 failure)" },
          id: none,
          run: "echo \"Gate evidence: v3.result=${{ needs.v3.result }}\"\nif [ \"${{ needs.v3.result }}\" = \"failure\" ] || [ \"${{ needs.v3.result }}\" = \"cancelled\" ]; then\n  echo \"::error::v3 job did not succeed (result=${{ needs.v3.result }}); ratchet cannot claim green.\"\n  exit 1\nfi\nif [ \"${{ needs.v3.result }}\" != \"success\" ]; then\n  echo \"::error::v3 job has unexpected result (result=${{ needs.v3.result }}); expected success after Layer-2 path-regex removal.\"\n  exit 1\nfi\necho \"Gate evidence validated; ratchet may proceed.\"\n",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
