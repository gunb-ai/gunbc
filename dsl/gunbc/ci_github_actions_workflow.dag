// Non-authoritative interim typed Actions carrier for .github/workflows/ci.yml.
// `.github/workflows/ci.yml` remains the hand-edited workflow authority until the T-24 CI model
// emits it; this static carrier is only the YamlStatic input consumed by `gunbc.ci`.
// Source-SHA256(.github/workflows/ci.yml): 71dad637664e11a38d51cbff14b181abdef5857684a044c39c4224d25a466874
// Dissolve-on: T-24 `src/v4/workflow/ci.dag` projection emits the Actions workflow and deletes
// this static carrier.

module gunbc.ci.github_actions_workflow

import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep, ActionRef,
  WorkflowTrigger, Push, PullRequest,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview, Closed,
  WorkflowPermissions, PermRead, PermWrite, PermNone,
  ConcurrencySpec, ConcurrencyMappingQueueNotMax,
  CancelInProgressSpec, CancelInProgressBool,
  HostedRunner, SelfHosted, RunsOnExpression,
  RunnerLabel, UbuntuLatest,
  ShellType, Bash
}

data gunbc_ci_github_actions_workflow: Workflow = {
  name: "ci",
  on: [Push { branches: ["main"], paths: [] }, PullRequest { branches: ["main"], types: [Opened, Synchronize, Reopened, ReadyForReview] }],
  concurrency: Some {
  value: ConcurrencyMappingQueueNotMax {
      group: "${{ github.workflow }}-${{ github.event.pull_request.number || github.run_id }}",
      cancel_in_progress: Some { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  jobs: [{
      id: "infra_isolation",
      name: none,
      runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
      steps: [RunStep {
          name: Some { value: "Assert runner is de-privileged (adversarial)" },
          id: none,
          run: "fail(){ echo \"::error::INFRA ISOLATION REGRESSION: $1\"; exit 1; }\n[ \"$(id -u)\" -ne 0 ] || fail \"running as root\"\nfor g in docker sudo lxd wheel root; do id -nG | tr ' ' '\\n' | grep -qx \"$g\" && fail \"in privileged group $g\"; done\ncat /etc/actions-runner/app.pem >/dev/null 2>&1 && fail \"can read the App private key\"\nsudo -n true 2>/dev/null && fail \"has passwordless sudo\"\n{ test -r /var/run/docker.sock || test -w /var/run/docker.sock; } && fail \"can read or write docker.sock\"\necho \"OK: non-root, no privileged groups (docker/sudo/lxd/wheel/root), App key unreadable, no passwordless sudo, docker.sock inaccessible\"\n",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }],
      needs: [],
      env: none,
      outputs: none,
      if_condition: none,
      strategy: none,
      timeout_minutes: Some { value: 5 },
      continue_on_error: false,
      concurrency: none
    }, {
      id: "fmt",
      name: none,
      runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
      steps: [RunStep {
          name: Some { value: "Isolate toolchain dirs (srv1/srv2 shared-$HOME concurrent-rustup race)" },
          id: none,
          run: "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\necho \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n# INTERIM sccache transport (operator 2026-06-01 override; \"disregard the memo for now\").\n# Right-way fix is the modeled cache_interface projection consumer (dsl/std/cache_interface.dag\n# sccache_local_facts; src/v4/workflow/ci.dag cache-projection note) -- NOT this hand-wire.\n# The runner provides an ISOLATED, ghrunner-owned sccache via systemd env (SCCACHE_DIR +\n# SCCACHE_SERVER_UDS, ctrl#1419). Do NOT hardcode SCCACHE_SERVER_UDS here: a job/step-level\n# env beats the runner default, so pinning the old shared socket forces EACCES and keeps\n# sccache inert. Inherit the runner's socket; only flip RUSTC_WRAPPER on. The server starts\n# LAZILY (sccache creates the socket on the first rustc call), so the socket does NOT exist yet\n# at this pre-cargo step -- gate on the socket's PARENT DIR being writable, not the socket file:\n# the runner provisions that dir ghrunner:ghrunner 0755 (ctrl#1419), so the gate passes pre-start\n# and sccache then binds its socket there on first rustc. Fails SAFE: a missing or non-writable\n# dir -> cold build (::warning), never silently / never fail-hard. dissolve-on-arrival.\nif [ -n \"$SCCACHE_SERVER_UDS\" ] && [ -w \"$(dirname \"$SCCACHE_SERVER_UDS\")\" ]; then\n  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\nelse\n  echo \"::warning::sccache socket (SCCACHE_SERVER_UDS=${SCCACHE_SERVER_UDS:-unset}) absent or not usable by runner user; building cold\"\nfi\n",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Clear inherited GitHub auth header (shared runner HOME)" },
          id: none,
          run: "git config --global --unset-all http.https://github.com/.extraheader || true",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Checkout" },
          id: none,
          uses: { owner: "actions", repo: "checkout", ref: "v4" },
          with: { "fetch-depth": "1" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Setup Rust" },
          id: none,
          uses: { owner: "actions-rust-lang", repo: "setup-rust-toolchain", ref: "v1.16.0" },
          with: { "components": "rustfmt", "cache": "false", "rustflags": "" },
          env: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "Pin global rustup default (isolated RUSTUP_HOME has no default toolchain)" },
          id: none,
          run: "rustup default \"$(rustup show active-toolchain | awk '{print $1; exit}')\"",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "cargo fmt --all --check" },
          id: none,
          run: "cargo fmt --all --check",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: none,
          continue_on_error: false,
          timeout_minutes: none
        }],
      needs: [],
      env: none,
      outputs: none,
      if_condition: Some { value: "github.event.pull_request.draft != true" },
      strategy: none,
      timeout_minutes: Some { value: 15 },
      continue_on_error: false,
      concurrency: none
    }, {
      id: "affected",
      name: none,
      runner: SelfHosted { labels: ["self-hosted", "linux", "arm64"] },
