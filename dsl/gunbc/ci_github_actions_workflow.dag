          with: { "fetch-depth": "1" },
          env: none,
          if_condition: Some { value: "github.event_name == 'push' && github.ref == 'refs/heads/main'" },
          continue_on_error: false,
          timeout_minutes: none
        }, RunStep {
          name: Some { value: "DB-8 stub (PR / non-main — full matrix is main-push only)" },
          id: none,
          run: "echo \"::notice::self_host_ratchet DB-8 release matrix runs only on pushes to main (Lane 1e staged).\"\nexit 0\n",
          shell: Bash,
          env: none,
          working_directory: none,
          if_condition: Some { value: "github.event_name != 'push' || github.ref != 'refs/heads/main'" },
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Setup Rust" },
          id: none,
          uses: { owner: "actions-rust-lang", repo: "setup-rust-toolchain", ref: "v1.16.0" },
          with: { "cache": "false", "rustflags": "" },
          env: none,
          if_condition: Some { value: "github.event_name == 'push' && github.ref == 'refs/heads/main'" },
          continue_on_error: false,
          timeout_minutes: none
        }, UsesStep {
          name: Some { value: "Cache Cargo (self_host_ratchet)" },
          id: none,
          uses: { owner: "actions", repo: "cache", ref: "v4" },
          with: { "path": "~/.cargo/registry/index/\n~/.cargo/registry/cache/\n~/.cargo/git/db/\ntarget/\n", "key": "cargo-self-host-${{ runner.os }}-${{ hashFiles('**/Cargo.lock') }}-${{ hashFiles('src/v3/compiler/**') }}", "restore-keys": "cargo-self-host-${{ runner.os }}-${{ hashFiles('**/Cargo.lock') }}-\ncargo-self-host-${{ runner.os }}-\n" },
          env: none,
          if_condition: Some { value: "github.event_name == 'push' && github.ref == 'refs/heads/main'" },
          continue_on_error: false,
