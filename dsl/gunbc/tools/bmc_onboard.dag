module gunbc.tools.bmc_onboard

// Executable onboarding orchestration for the new Altra server (BMC 192.168.1.192).
// Composes the lifecycle legs over new_altra_onboarding_plan + the BmcOnboardingPhase machine.
//
// Leg status:
//   acquire      — PROVEN live (gunbc.tools.bmc_onboard_validate ran -> ExitSuccess)
//   gen+store    — entropy mint (#5633 extdeps.entropy) -> base64 -> GCP store (secret_manager);
//                  wired once #5633 lands on main (this file stays free of that import until then).
//   rotate+reauth — THIS FILE: materialize netrc + PATCH body, SetAccountPassword, reauth-verify.
//                  Compile-verified here; LIVE EXECUTION IS OPERATOR-FENCED (first destructive write).
//                  Live-correctness of account_id (= factory username) and the Redfish PATCH body
//                  shape is confirmed only by the gated live run against .192, not by this typecheck.
//   os-install   — Lane E (#5638 PXE) — pending.

import extdeps.bmc.http
import extdeps.filesystem.filesystem_io
import gunbc.bmc_onboarding { new_altra_onboarding_plan }
import std.types { NonEmptyStr, Secret, String }
import std.resources { Network }
import std.process { ProcessExit, ExitSuccess, exit_failure }

// Runtime materialization paths for the credential-rotation files.
// SECURITY (§5): these transiently hold the BMC credential on disk under the default umask.
// DEBT (named dissolution): Filesystem.Write cannot set mode 0600 today, and there is no post-run
// unlink — dissolution = a mode-aware file-write effect + an unlink leg, so the secret-on-disk
// window is 0600 and bounded. Tracked for the live-go review, NOT a silent leak.
data bmc_onboard_netrc_path: String = "/tmp/bmc_onboard_netrc"
data bmc_onboard_pwbody_path: String = "/tmp/bmc_onboard_pwbody.json"

// One curl netrc line authenticating as `account` with `password` at `host`.
fn netrc_content(host: String, account: String, password: String) -> String {
  concat("machine ", concat(host, concat(" login ", concat(account, concat(" password ", concat(password, "\n"))))))
}

// Redfish PATCH body that sets an account password.
fn account_password_body(new_password: String) -> String {
  concat("{\"Password\": \"", concat(new_password, "\"}"))
}

// ROTATE + REAUTH leg.
// Authenticate with the factory credential, PATCH the admin account to `new_credential`, then
// reauth with the new credential to VERIFY the rotation took — fail-closed if it did not.
// `new_credential` is the minted+stored Secret (gen+store leg); declassified to String exactly once,
// explicitly, to write the PATCH body (the Secret type forbids accidental exposure).
func bmc_rotate_credential(new_credential: Secret) -> ProcessExit
  uses net: Network
{
  let plan = new_altra_onboarding_plan
  let host = plan.bmc.host
  let account = plan.factory_login.username

  let netrc = Filesystem.Write(
    path: bmc_onboard_netrc_path,
    content: netrc_content(host: host, account: account, password: plan.factory_login.published_password)
  )
  if netrc.success == false {
    return exit_failure(reason: concat("netrc write failed: ", netrc.error))
  }

  let body = Filesystem.Write(
    path: bmc_onboard_pwbody_path,
    content: account_password_body(new_password: new_credential as String)
  )
  if body.success == false {
    return exit_failure(reason: concat("password body write failed: ", body.error))
  }

  let rot = redfish.Http.SetAccountPassword(
    bmc_host: host,
    netrc_file: bmc_onboard_netrc_path as NonEmptyStr,
    account_id: account,
    request_body_file: bmc_onboard_pwbody_path as NonEmptyStr
  )
  if rot.success == false {
    return exit_failure(reason: rot.body)
  }

  let verify = redfish.Http.GetSystem(bmc_host: host, username: account, password: new_credential)
  return if verify.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("rotation verify failed (new credential rejected): ", verify.body))
  }
}
