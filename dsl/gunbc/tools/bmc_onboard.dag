module gunbc.tools.bmc_onboard

// Executable onboarding orchestration for the new Altra server (BMC 192.168.1.192).
// Composes the full lifecycle over new_altra_onboarding_plan + srv3_os_install_plan, walking
// the phases acquire -> gen+store -> rotate -> reauth -> os-install entirely in .dag.
//
// Leg realization:
//   acquire      — GetServiceRoot + factory-login GetSystem (read; PROVEN live via bmc_onboard_validate)
//   gen+store    — mint a credential from OS entropy (extdeps.entropy Urandom), fail-CLOSED, then store
//                  it to GCP Secret Manager for durability (AddVersion on the existing srv3 secret)
//   rotate+reauth — materialize netrc + PATCH body via Filesystem.Write, SetAccountPassword (Redfish
//                  write), reauth with the NEW credential to VERIFY the rotation took (fail-closed)
//   os-install   — re-materialize netrc with the NEW credential, SetBootSourceOverride(Pxe,Once) +
//                  ResetSystem(ForceRestart) to boot srv3 into the Lane-E PXE/autoinstall path
//
// Verification posture: the whole graph is COMPILE-VERIFIED. LIVE EXECUTION IS OPERATOR-FENCED
// (the first SetAccountPassword is destructive). Live-correctness of account_id (= factory username),
// the Redfish PATCH/POST body shapes, and the GCP store round-trip is confirmed only by the gated run
// against .192, not by this typecheck. This is a tool (no test fn), so it does NOT auto-enroll as a
// floor witness — no false CI-coverage claim.

import extdeps.bmc.http
import extdeps.bmc.types { redfish_boot_target_wire, redfish_boot_override_enabled_wire, redfish_reset_type_wire }
import extdeps.filesystem.filesystem_io
import extdeps.entropy
import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.gcp { GcpProjectId }
import extdeps.shell
import gunbc.bmc_onboarding { new_altra_onboarding_plan }
import gunbc.os_install { srv3_os_install_plan }
import std.credentials { Stored }
import std.encoding { base64_encode, base64_decode, Base64Variant, Standard }
import std.integer { UInt8 }
import std.types { NonEmptyStr, Secret, String }
import std.logic { Bool }
import std.resources { Network }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_failure, exit_code_general_error }

// Runtime materialization paths for the credential + boot files.
// SECURITY (§5): these transiently hold the BMC credential on disk under the default umask.
// DEBT (named dissolution): Filesystem.Write cannot set mode 0600 today and there is no post-run
// unlink — dissolution = a mode-aware file-write effect + an unlink leg, so the secret-on-disk
// window is 0600 and bounded. Tracked for the live-go review, NOT a silent leak.
data bmc_onboard_netrc_path: String = "/tmp/bmc_onboard_netrc"
data bmc_onboard_pwbody_path: String = "/tmp/bmc_onboard_pwbody.json"
data bmc_onboard_bootbody_path: String = "/tmp/bmc_onboard_bootbody.json"
data bmc_onboard_resetbody_path: String = "/tmp/bmc_onboard_resetbody.json"

// GCP project that homes the srv3 BMC admin secret (the secret_id rides on the onboarding plan).
data srv3_gcp_project: GcpProjectId = "gunbai-secrets"

// Credential byte count (20 octets -> 28-char base64url credential).
// 🟡 SCAFFOLD — bmc_credential_bytes: Int is a flat-scalar bytes unit; the grounded carrier is
// ByteSize (std.measure). It stays Int because it feeds Urandom.ReadBytes(count: Int) whose shell-argv
// transport needs a plain integer — the same constraint already tracked by extdeps.entropy's
// entropy_count_bytes_unit_debt. Dissolve-on: feature:bytesize-argv-interpolation — when ByteSize
// extraction is wired at argv interpolation, this and the entropy count migrate to ByteSize together.
data bmc_credential_bytes: Int = 20

// --- pure content builders ---------------------------------------------------

// One curl netrc line authenticating as `account` with `password` at `host`.
fn netrc_content(host: String, account: String, password: String) -> String {
  concat("machine ", concat(host, concat(" login ", concat(account, concat(" password ", concat(password, "\n"))))))
}

// 🟡 SCAFFOLD — the Redfish PATCH/POST bodies below are hand-built via concat, a §3 nickname for
// JSON encoding (a second representation of "JSON object") with no escaping. Safe for the CURRENT
// call sites ONLY: the credential is base64url (no " or \), and the boot/reset values are closed
// enum wires — an escape bug is unreachable with these inputs, and the body-shape witnesses pin the
// exact strings. Dissolve-on: feature:redfish-json-body-model — route through a structured JSON-object
// encoder authority (std to_json over a typed Redfish body record) so escaping is by-construction.

// Redfish PATCH body that sets an account password.
fn account_password_body(new_password: String) -> String {
  concat("{\"Password\": \"", concat(new_password, "\"}"))
}

// Redfish PATCH body that overrides the boot source (target + enablement).
fn boot_override_body(target: String, enabled: String) -> String {
  concat("{\"Boot\": {\"BootSourceOverrideTarget\": \"",
    concat(target, concat("\", \"BootSourceOverrideEnabled\": \"", concat(enabled, "\"}}"))))
}

// Redfish POST body that resets the system.
fn reset_body(reset_type: String) -> String {
  concat("{\"ResetType\": \"", concat(reset_type, "\"}"))
}

// Fully-qualified GCP secret resource name from a project + short secret id.
fn gcp_secret_full_name(project: String, secret_id: String) -> String {
  concat("projects/", concat(project, concat("/secrets/", secret_id)))
}

// The short secret id the rotated credential is stored under (from the onboarding plan).
fn onboarding_secret_id() -> NonEmptyStr {
  match new_altra_onboarding_plan.rotated_credential {
    Stored { secret_name: sn } => sn
    Chained { steps: _ } => "bmc-srv3-admin" as NonEmptyStr
  }
}

// --- mint (fail-closed) ------------------------------------------------------

// Read `byte_count` octets of OS entropy via the Urandom realization and decode to raw octets.
// Optional: Absent only if the base64 round-trip fails (structurally unreachable — Urandom.ReadBytes
// fails closed on nonzero exit). The CALLER fails closed on Absent, never fabricating a credential.
fn mint_credential_octets(byte_count: Int) -> List<UInt8>? {
  base64_decode(s: Urandom.ReadBytes(count: byte_count).octets_b64, variant: Standard)
}

// SINGLE AUTHORITY for the credential string derived from entropy octets (§2/§3). The password set
// on the BMC, the payload stored in GCP, and the read-back comparison MUST all be the identical
// string — deriving it independently at each site (rotate / store / os-install) lets the encoding
// variant diverge, and a recoverer who reads the GCP secret would get a string that is NOT the
// password (a §5 lockout foot-gun: the stored value must BE the credential, not a re-encoding of it).
// The credential is itself valid base64, so it doubles as the GCP wire payload: GCP stores the
// underlying octets and AccessVersion returns this exact string as `data_b64` — so the recovered
// secret IS the password, directly usable, no decode/re-encode step at the recovery site.
fn credential_from_octets(octets: List<UInt8>) -> Secret {
  base64_encode(octets: octets, variant: Standard) as Secret
}

// --- write a netrc authenticating as `account` with `password` --------------

fn write_netrc(host: String, account: String, password: String) -> Bool {
  Filesystem.Write(path: bmc_onboard_netrc_path, content: netrc_content(host: host, account: account, password: password)).success
}

// --- rotate + reauth leg -----------------------------------------------------

// Authenticate with the factory credential, PATCH the admin account to `new_credential`, then reauth
// with the new credential to VERIFY the rotation took. The Secret is declassified to String exactly
// once, explicitly, to write the PATCH body (the Secret type forbids accidental exposure).
func bmc_rotate_credential(new_credential: Secret) -> ProcessExit
  uses net: Network
{
  let plan = new_altra_onboarding_plan
  let host = plan.bmc.host
  let account = plan.factory_login.username

  // netrc authenticates the PATCH as the CURRENT (factory) credential.
  if write_netrc(host: host, account: account, password: plan.factory_login.published_password) == false {
    return exit_failure(reason: "rotate: netrc write failed")
  }

  let body = Filesystem.Write(
    path: bmc_onboard_pwbody_path,
    content: account_password_body(new_password: new_credential as String)
  )
  if body.success == false {
    return exit_failure(reason: concat("rotate: password body write failed: ", body.error))
  }

  rot = redfish.Http.SetAccountPassword(
    bmc_host: host,
    netrc_file: bmc_onboard_netrc_path as NonEmptyStr,
    account_id: account,
    request_body_file: bmc_onboard_pwbody_path as NonEmptyStr
  )
  if rot.success == false {
    return exit_failure(reason: rot.body)
  }

  verify = redfish.Http.GetSystem(bmc_host: host, username: account, password: new_credential)
  return if verify.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("rotate: reauth with new credential rejected: ", verify.body))
  }
}

// --- os-install leg ----------------------------------------------------------

// Point srv3 at the PXE/autoinstall path (Lane E) and reboot. Authenticates with the NEW credential
// (the factory netrc from the rotate leg is now stale), so it re-materializes netrc first.
func bmc_os_install(new_credential: Secret) -> ProcessExit
  uses net: Network
{
  let plan = new_altra_onboarding_plan
  let host = plan.bmc.host
  let account = plan.factory_login.username
  let system_id = plan.redfish_system_id
  let install = srv3_os_install_plan

  if write_netrc(host: host, account: account, password: new_credential as String) == false {
    return exit_failure(reason: "os-install: netrc (new credential) write failed")
  }

  let boot_body = Filesystem.Write(
    path: bmc_onboard_bootbody_path,
    content: boot_override_body(
      target: redfish_boot_target_wire(t: install.bmc_boot_target),
      enabled: redfish_boot_override_enabled_wire(e: install.bmc_boot_enabled)
    )
  )
  if boot_body.success == false {
    return exit_failure(reason: concat("os-install: boot body write failed: ", boot_body.error))
  }

  boot = redfish.Http.SetBootSourceOverride(
    bmc_host: host,
    netrc_file: bmc_onboard_netrc_path as NonEmptyStr,
    system_id: system_id,
    request_body_file: bmc_onboard_bootbody_path as NonEmptyStr
  )
  if boot.success == false {
    return exit_failure(reason: concat("os-install: boot source override failed: ", boot.body))
  }

  let reset_body_w = Filesystem.Write(
    path: bmc_onboard_resetbody_path,
    content: reset_body(reset_type: redfish_reset_type_wire(r: install.post_stage_reset))
  )
  if reset_body_w.success == false {
    return exit_failure(reason: concat("os-install: reset body write failed: ", reset_body_w.error))
  }

  reset = redfish.Http.ResetSystem(
    bmc_host: host,
    netrc_file: bmc_onboard_netrc_path as NonEmptyStr,
    system_id: system_id,
    request_body_file: bmc_onboard_resetbody_path as NonEmptyStr
  )
  return if reset.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat("os-install: system reset failed: ", reset.body))
  }
}

// --- gen+store -> rotate -> os-install continuation --------------------------

// Given freshly-minted entropy octets: derive the credential, store it to GCP for durability, rotate
// the BMC password, then drive the OS install. Chained on ProcessExit so any leg's failure short-circuits.
func bmc_store_and_rotate(octets: List<UInt8>) -> ProcessExit
  uses net: Network
{
  let credential = credential_from_octets(octets: octets)
  // The credential is valid base64, so it is also the GCP wire payload — GCP decodes it to the raw
  // octets, stores them, and returns this same string as `data_b64`. So `data_b64 == payload_b64`
  // (the read-back gate below) proves the EXACT credential is durably recoverable, not merely the octets.
  let payload_b64 = credential as String
  let secret_id = onboarding_secret_id()

  // Store the credential to GCP for durability (payload is base64 of the same octets — no utf8 hop),
  // then PROVE it is retrievable by reading it back BEFORE rotating. This gate is load-bearing for
  // §5 fail-closed: if the store fails and we rotate anyway, the BMC password becomes a credential
  // that exists only in process memory and srv3 is permanently locked out the moment the run ends.
  // The read-back makes "rotate to an unstored credential" UNWRITABLE — we never reach the
  // destructive rotate unless the new credential is durably recoverable from GCP. A base64 mismatch
  // fails closed (refuses to rotate), which is the safe direction: a false block beats a lockout.
  // AddVersion on the existing srv3 secret; new-node enrollment (idempotent CreateSecret) is the
  // assimilate/discovery lane's concern, not srv3's (its secret already exists).
  auth = shell.GCloud.AuthPrintAccessToken()
  stored = gcp.SecretManager.AddVersion(
    access_token: auth.access_token,
    secret_name: gcp_secret_full_name(project: srv3_gcp_project, secret_id: secret_id),
    payload_b64: payload_b64
  )
  readback = gcp.SecretManager.AccessVersion(
    access_token: auth.access_token,
    project_id: srv3_gcp_project,
    secret: secret_id,
    version: "latest"
  )
  if readback.data_b64 != payload_b64 {
    return exit_failure(reason: concat("store: GCP durability read-back mismatch — refusing to rotate (would lock out srv3); stored version ", stored.name))
  }

  return bmc_rotate_credential(new_credential: credential)
}

// Full continuation: store+rotate, then (on success) os-install. os-install requires a reachable
// PXE/install server (Lane E) — do NOT run this until that infra exists, or it resets srv3 into a
// dead PXE boot.
func bmc_onboard_store_rotate_install(octets: List<UInt8>) -> ProcessExit
  uses net: Network
{
  return match bmc_store_and_rotate(octets: octets) {
    ExitSuccess => bmc_os_install(new_credential: credential_from_octets(octets: octets))
    ExitFailure { code: c, reason: r } => ExitFailure { code: c, reason: r }
  }
}

// CREDENTIAL ASSIMILATION ONLY — acquire -> gen(fail-closed) -> store(read-back gated) -> rotate ->
// reauth, STOPPING before os-install. This is the safe live step to assimilate srv3's BMC credential
// (factory root/0penBmc -> a minted admin credential durably stored in GCP) while the PXE/install
// server does not yet exist. Run: gunbc run --source-root dsl --entry dsl/gunbc/tools/bmc_onboard.dag
//   --function bmc_assimilate_srv3_credential
func bmc_assimilate_srv3_credential() -> ProcessExit
  uses net: Network
{
  let plan = new_altra_onboarding_plan
  let host = plan.bmc.host
  let account = plan.factory_login.username

  root_resp = redfish.Http.GetServiceRoot(bmc_host: host)
  if root_resp.success == false {
    return exit_failure(reason: concat("acquire: service root unreachable: ", root_resp.body))
  }
  acq = redfish.Http.GetSystem(
    bmc_host: host,
    username: account,
    password: plan.factory_login.published_password as Secret
  )
  if acq.success == false {
    return exit_failure(reason: concat("acquire: factory login failed: ", acq.body))
  }

  octets_opt = mint_credential_octets(byte_count: bmc_credential_bytes)
  return match octets_opt {
    Absent => exit_failure(reason: "gen: entropy mint failed (fail-closed)")
    Present { value: octets } => bmc_store_and_rotate(octets: octets)
  }
}

// --- top-level orchestration -------------------------------------------------

// Full srv3 onboarding: acquire -> gen+store -> rotate -> reauth -> os-install.
// LIVE EXECUTION OPERATOR-FENCED. Run: gunbc run dsl/gunbc/tools/bmc_onboard.dag --function bmc_onboard_srv3
func bmc_onboard_srv3() -> ProcessExit
  uses net: Network
{
  let plan = new_altra_onboarding_plan
  let host = plan.bmc.host
  let account = plan.factory_login.username

  // 1. ACQUIRE — service root reachable + factory login valid (read-only; safe).
  root_resp = redfish.Http.GetServiceRoot(bmc_host: host)
  if root_resp.success == false {
    return exit_failure(reason: concat("acquire: service root unreachable: ", root_resp.body))
  }
  acq = redfish.Http.GetSystem(
    bmc_host: host,
    username: account,
    password: plan.factory_login.published_password as Secret
  )
  if acq.success == false {
    return exit_failure(reason: concat("acquire: factory login failed: ", acq.body))
  }

  // 2. GEN — mint a credential from OS entropy, FAIL-CLOSED (never a fabricated/empty credential).
  octets_opt = mint_credential_octets(byte_count: bmc_credential_bytes)
  return match octets_opt {
    Absent => exit_failure(reason: "gen: entropy mint failed (fail-closed)")
    Present { value: octets } => bmc_onboard_store_rotate_install(octets: octets)
  }
}
