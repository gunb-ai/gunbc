// gunbc/tools/ratchet.dag — L1 type knowledge ratchet check.
//
// Replaces scripts/l1-ratchet.sh with a .dag program. Uses
// resolve_compiler_tools() for the grep path and matches on the actual
// grep exit code (tri-state: match / no-match / error) instead of the
// boolean success flag, which would conflate "no match" with "tool error".
//
// Entry points:
//   run_l1_ratchet()    → ProcessExit, for dag run / CI
//   check_l1_ratchet()  → L1RatchetResult, composable internal helper
//
// Run via: dag run --source-root dsl --function run_l1_ratchet

module gunbc.tools.ratchet

import gunbc.compiler {
  compiler_source,
  resolve_compiler_tools, ToolsReady, ToolsMissing
}
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_code_general_error }
import extdeps.shell

// ── Violation patterns ──────────────────────────────────────────────

data l1_constructor_pattern: String = "\\b(leaf_node|optional_node|container_node|tuple_node|pair_node|callable_node|error_type_node)\\b"

data l1_typename_pattern: String = "\\.name == \"(Optional|Map|List|Set|Dynamic|Error|Int|String|Bool|Float|Unit|Bytes|Json|Secret|Tuple|Callable|None|Some)\""

// ── Result type ─────────────────────────────────────────────────────

type L1RatchetResult
  = L1Passed
  | L1Failed { report: String }
  | L1GrepError { stderr: String }
  | RatchetToolsMissing { tool: String, hint: String }

// ── grep tri-state ──────────────────────────────────────────────────
// grep exit codes (POSIX, GNU/BSD compatible):
//   0 = match found
//   1 = no match found
//   2 = error (unreadable file, bad pattern, etc.)
// Earlier versions of this file collapsed exit 1 and 2 into "no match",
// which made the L1 ratchet false-pass on real grep errors. We now
// match on exit_code structurally so a real grep failure surfaces as
// L1GrepError instead of being silently ignored.

type GrepOutcome
  = GrepMatch
  | GrepNoMatch
  | GrepError { stderr: String }

fn classify_grep_exit(exit_code: Int, stderr: String) -> GrepOutcome {
  if exit_code == 0 { GrepMatch }
  else if exit_code == 1 { GrepNoMatch }
  else { GrepError { stderr: stderr } }
}

// ── Command derivation ──────────────────────────────────────────────
// Commands take the resolved grep path. We do NOT silence stderr — real
// errors must surface so classify_grep_exit can distinguish them from
// no-match.

fn has_pattern_command(grep: String, pattern: String, dir: String) -> String {
  concat(grep, " -rqE '", pattern, "' ", dir, "/*.dag")
}

fn find_violations_command(grep: String, pattern: String, dir: String) -> String {
  concat(grep, " -rnE '", pattern, "' ", dir, "/*.dag")
}

// ── Ratchet workflow ────────────────────────────────────────────────

func check_l1_ratchet() -> L1RatchetResult {
  match resolve_compiler_tools() {
    ToolsMissing { tool: t, hint: h } => RatchetToolsMissing { tool: t, hint: h }
    ToolsReady { tools: t } => {
      let dir = compiler_source.path

      let constructors_run = shell.Exec.Run(
        script: has_pattern_command(grep: t.grep, pattern: l1_constructor_pattern, dir: dir)
      )
      let typenames_run = shell.Exec.Run(
        script: has_pattern_command(grep: t.grep, pattern: l1_typename_pattern, dir: dir)
      )

      let constructors = classify_grep_exit(exit_code: constructors_run.exit_code, stderr: constructors_run.stderr)
      let typenames = classify_grep_exit(exit_code: typenames_run.exit_code, stderr: typenames_run.stderr)

      // Fail closed on any grep error — never silently treat it as no-match.
      match constructors {
        GrepError { stderr: e } => L1GrepError { stderr: e }
        _ => match typenames {
          GrepError { stderr: e } => L1GrepError { stderr: e }
          _ => {
            // Both grep calls succeeded structurally. Did either find matches?
            let has_violations = match constructors {
              GrepMatch => true
              _ => match typenames { GrepMatch => true, _ => false }
            }
            if has_violations {
              let constructor_detail = shell.Exec.Run(
                script: find_violations_command(grep: t.grep, pattern: l1_constructor_pattern, dir: dir)
              )
              let typename_detail = shell.Exec.Run(
                script: find_violations_command(grep: t.grep, pattern: l1_typename_pattern, dir: dir)
              )
              L1Failed { report: concat(constructor_detail.stdout, typename_detail.stdout) }
            } else {
              L1Passed
            }
          }
        }
      }
    }
  }
}

// ── ProcessExit entry point ─────────────────────────────────────────
// Wraps check_l1_ratchet so the host can map result → exit code.
// Any L1RatchetResult variant other than L1Passed becomes ExitFailure.

fn l1_to_exit(result: L1RatchetResult) -> ProcessExit {
  match result {
    L1Passed => ExitSuccess
    L1Failed { report: r } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("L1 ratchet failed:\n", r)
    }
    L1GrepError { stderr: e } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("L1 ratchet: grep error:\n", e)
    }
    RatchetToolsMissing { tool: t, hint: h } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("L1 ratchet: required tool missing: ", t, " (", h, ")")
    }
  }
}

func run_l1_ratchet() -> ProcessExit {
  l1_to_exit(result: check_l1_ratchet())
}
