module gunbc.tools.grounding_confirm

import extdeps.llm.anthropic
import extdeps.llm.anthropic_rest

data eval_corpus_path: String = "src/v2/lens/testdata/anemia_confirm_eval_corpus.json"

fn judge_model_id() -> String {
  fold(models, init: "", f: fn(acc, spec) {
    match spec.model { ClaudeHaiku4_5 => spec.model_id, _ => acc }
  })
}

type GroundingFinding {
  corpus_id: String
  enclosing: String
  field: String
  declared_type: String
  coincides_with: String
  target_kind: String
  target_structure: String
  expected: String
}

data bare_system: String = "You decide whether a struct field typed as a bare string is UNDER-GROUNDED (it should point at an existing concept type that it merely re-spells as text) or LEGITIMATELY A STRING.\n\nDecompose the value: if it has named internal parts or a closed/fixed structure -> answer GROUND. If it is an extensible registry, a constraint/grammar string, or an opaque/free-form value -> answer KEEP.\n\nReply with exactly one word: GROUND or KEEP."

data enriched_system: String = "You decide whether a struct field typed as a bare string is UNDER-GROUNDED (it should point at an existing concept type that it merely re-spells as text) or LEGITIMATELY A STRING.\n\nThe grounding lens supplies target_kind (Structured | Unstructured) and target_structure (the matched concept's actual members, exactly as the lens renders them). Reason from them:\n- target_kind=Structured AND the rendered members are the RIGHT concept for this field -> GROUND.\n- target_kind=Structured BUT the members describe a DIFFERENT concept than the field means (a coincidental name match) -> KEEP.\n- target_kind=Unstructured (no named members -- a string alias, an open/extensible registry, a constraint/grammar/format string, or an opaque token) -> KEEP.\n\nReply with exactly one word: GROUND or KEEP."

fn bare_user(f: GroundingFinding) -> String {
  "enclosing_concept: {f.enclosing}\nfield: {f.field}\ndeclared_type: {f.declared_type}\ncoincides_with: {f.coincides_with}"
}

fn enriched_user(f: GroundingFinding) -> String {
  "enclosing_concept: {f.enclosing}\nfield: {f.field}\ndeclared_type: {f.declared_type}\ncoincides_with: {f.coincides_with}\ntarget_kind: {f.target_kind}\ntarget_structure: {f.target_structure}"
}

fn candidate_message(body: String) -> List<AnthropicChatMessage> {
  [UserMessage { content: [UserTextBlock { text: body }] }]
}

data haiku_confirm_findings: List<GroundingFinding> = [
  GroundingFinding {
    corpus_id: "pos-git-url",
    enclosing: "GitRemote", field: "url", declared_type: "String", coincides_with: "Url",
    target_kind: "Structured",
    target_structure: "scheme: UriScheme, host: NonEmptyStr, path: String, query: String",
    expected: "GROUND"
  },
  GroundingFinding {
    corpus_id: "neg-version-constraint",
    enclosing: "CargoDepSource.RegistryDep", field: "version", declared_type: "String", coincides_with: "SemVer",
    target_kind: "Unstructured",
    target_structure: "(no named members -- a version-requirement constraint grammar like \"^1.2\", \">=1.0, <2.0\")",
    expected: "KEEP"
  },
  GroundingFinding {
    corpus_id: "neg-oci-mediatype",
    enclosing: "OciDescriptor", field: "mediaType", declared_type: "String", coincides_with: "OciMediaType",
    target_kind: "Unstructured",
    target_structure: "(no named members -- an open, vendor-extensible registry, application/vnd.*)",
    expected: "KEEP"
  },
  GroundingFinding {
    corpus_id: "neg-cursor-opaque",
    enclosing: "Pagination", field: "cursor", declared_type: "String", coincides_with: "Cursor",
    target_kind: "Unstructured",
    target_structure: "(no named members -- an opaque server-issued pagination token)",
    expected: "KEEP"
  },
  GroundingFinding {
    corpus_id: "neg-lexeme-parse-input",
    enclosing: "RepeatState", field: "lexeme", declared_type: "String", coincides_with: "Lexeme",
    target_kind: "Unstructured",
    target_structure: "(no named members -- raw matched source text, a lexer's parse input)",
    expected: "KEEP"
  },
  GroundingFinding {
    corpus_id: "neg-schedule-wrong-target",
    enclosing: "CronEntry", field: "schedule", declared_type: "String", coincides_with: "Schedule",
    target_kind: "Structured",
    target_structure: "rows: List<List<Runnable>> (a parallelism schedule -- the WRONG concept for a cron expression string)",
    expected: "KEEP"
  }
]

func judge_one(instructions: String, body: String) -> { verdict: String } {
  resp = llm.Anthropic.Messages(
    api_key: "",
    model: judge_model_id(),
    messages: candidate_message(body: body),
    max_tokens: 8,
    temperature: 0.0,
    system: instructions
  )
  return { verdict: resp.content }
}

fn grade(verdict: String, expected: String) -> String {
  if starts_with(verdict, prefix: expected) { "MATCH" } else { "MISS" }
}

func confirm_bare() -> { lines: String } {
  rows = for f in haiku_confirm_findings {
    let v = judge_one(instructions: bare_system, body: bare_user(f: f)).verdict
    "{f.corpus_id}: {f.field} -> {v} [want {f.expected}] {grade(verdict: v, expected: f.expected)}"
  }
  return { lines: join(rows, "\n") }
}

func confirm_enriched() -> { lines: String } {
  rows = for f in haiku_confirm_findings {
    let v = judge_one(instructions: enriched_system, body: enriched_user(f: f)).verdict
    "{f.corpus_id}: {f.field} -> {v} [want {f.expected}] {grade(verdict: v, expected: f.expected)}"
  }
  return { lines: join(rows, "\n") }
}
