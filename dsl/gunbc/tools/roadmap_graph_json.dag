module gunbc.tools.roadmap_graph_json

import extdeps.shell
import gunbc.roadmap_graph { roadmap_graph_json }
import gunbc.roadmap_authority { roadmap_authority, authored_merged_prs }

func roadmap_graph_json_output() -> String {
  let sha_result = shell.Exec.Run(script: "git rev-parse HEAD 2>/dev/null | tr -d '\\n'")
  if sha_result.success {
    roadmap_graph_json(doc: roadmap_authority(), merged: authored_merged_prs(), anchor_commit: sha_result.stdout)
  } else {
    "{\"schema\": \"roadmap-graph/v1\", \"error\": \"anchor_commit unavailable: git rev-parse HEAD failed\", \"nodes\": [], \"edges\": []}"
  }
}
