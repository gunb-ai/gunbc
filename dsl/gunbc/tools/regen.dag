// gunbc/tools/regen.dag — Stage0 regeneration workflow.
//
// Replaces scripts/regenerate-stage0.sh with a .dag program whose
// commands derive entirely from gunbc.compiler facts and whose tools
// are resolved to absolute paths before dispatch.
//
// Entry points:
//   run_regenerate_stage0()  → ProcessExit, for dag run / CI
//   regenerate_stage0()      → RegenResult, composable internal
//
// Run via: dag run --source-root dsl --function run_regenerate_stage0

module gunbc.tools.regen

import gunbc.compiler {
  compiler_cycle, SelfHostingCycle, ResolvedCompilerTools,
  resolve_compiler_tools, ToolsReady, ToolsMissing,
  build_command, check_command, compile_command, copy_generated_command,
  clean_stage0_generated_command
}
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_code_general_error }
import extdeps.shell

// ── Result types ────────────────────────────────────────────────────

type RegenStage = Build | Compile | Copy | Check | Rebuild | Recompile | DiffStage

type RegenResult
  = Converged
  | Diverged
  | Failed { stage: RegenStage, stderr: String }
  | RegenToolsMissing { tool: String, hint: String }

// diff exit codes (POSIX, GNU/BSD compatible):
//   0 = identical, 1 = different, 2 = error
// We must distinguish "different" from "error" so a real diff failure
// surfaces as Failed, not silently misclassified as Diverged.
type DiffOutcome
  = DiffSame
  | DiffDifferent
  | DiffError { stderr: String }

fn classify_diff_exit(exit_code: Int, stderr: String) -> DiffOutcome {
  if exit_code == 0 { DiffSame }
  else if exit_code == 1 { DiffDifferent }
  else { DiffError { stderr: stderr } }
}

// ── Regen workflow ──────────────────────────────────────────────────
//
// Mirrors the 5-step process from regenerate-stage0.sh:
//   1. Build current compiler from committed stage0
//   2. Compile .dag source → Rust (pass 1)
//   3. Copy output to stage0, verify it compiles
//   4. Rebuild compiler with new stage0
//   5. Compile again (pass 2), verify pass1 == pass2

func regenerate(cycle: SelfHostingCycle) -> RegenResult {
  // Resolve all tools once — one level of match, not four.
  match resolve_compiler_tools() {
    ToolsMissing { tool: t, hint: h } => RegenToolsMissing { tool: t, hint: h }
    ToolsReady { tools: t } => {
      // Clear stale output from prior runs
      let _ = shell.Exec.Run(script: concat(t.rm, " -rf .regen-pass1 .regen-pass2"))

      // Step 1: Build current compiler from committed stage0
      let build = shell.Exec.Run(script: build_command(cargo: t.cargo, cycle: cycle))
      if build.success == false {
        return Failed { stage: Build, stderr: build.stderr }
      }

      // Step 2: Compile .dag source → generated Rust (pass 1)
      let pass1 = shell.Exec.Run(
        script: compile_command(cargo: t.cargo, cycle: cycle, output_dir: ".regen-pass1")
      )
      if pass1.success == false {
        return Failed { stage: Compile, stderr: pass1.stderr }
      }

      // Step 3a: Delete stale generated files from stage0 (those the
      // compiler stopped emitting). Hand-maintained files are excluded
      // by the find filter. Without this, removed modules would linger
      // as committed orphans.
      let clean = shell.Exec.Run(
        script: clean_stage0_generated_command(find: t.find, cycle: cycle)
      )
      if clean.success == false {
        return Failed { stage: Copy, stderr: clean.stderr }
      }

      // Step 3b: Copy pass 1 output to stage0
      let copy = shell.Exec.Run(
        script: copy_generated_command(find: t.find, cp: t.cp, from_dir: ".regen-pass1", cycle: cycle)
      )
      if copy.success == false {
        return Failed { stage: Copy, stderr: copy.stderr }
      }

      // Step 4: Verify stage0 compiles with new generated code
      let check = shell.Exec.Run(script: check_command(cargo: t.cargo, cycle: cycle))
      if check.success == false {
        return Failed { stage: Check, stderr: check.stderr }
      }

      // Step 5: Rebuild compiler with new stage0
      let rebuild = shell.Exec.Run(script: build_command(cargo: t.cargo, cycle: cycle))
      if rebuild.success == false {
        return Failed { stage: Rebuild, stderr: rebuild.stderr }
      }

      // Step 6: Compile again with rebuilt compiler (pass 2)
      let pass2 = shell.Exec.Run(
        script: compile_command(cargo: t.cargo, cycle: cycle, output_dir: ".regen-pass2")
      )
      if pass2.success == false {
        return Failed { stage: Recompile, stderr: pass2.stderr }
      }

      // Step 7: Fixed-point check — pass 1 output == pass 2 output.
      // Match on tri-state diff exit so a real diff error surfaces as
      // Failed, not as a false-Diverged.
      let diff_run = shell.Exec.Run(
        script: concat(t.diff, " -r .regen-pass1 .regen-pass2")
      )
      let diff_outcome = classify_diff_exit(exit_code: diff_run.exit_code, stderr: diff_run.stderr)

      // Step 8: Cleanup
      let _ = shell.Exec.Run(script: concat(t.rm, " -rf .regen-pass1 .regen-pass2"))

      match diff_outcome {
        DiffSame => Converged
        DiffDifferent => Diverged
        DiffError { stderr: e } => Failed { stage: DiffStage, stderr: e }
      }
    }
  }
}

// Composable internal helper: returns rich result type.
func regenerate_stage0() -> RegenResult {
  regenerate(cycle: compiler_cycle)
}

// ── ProcessExit entry point ─────────────────────────────────────────
// Wraps regenerate_stage0 so the host can map result → exit code.

fn regen_to_exit(result: RegenResult) -> ProcessExit {
  match result {
    Converged => ExitSuccess
    Diverged => ExitFailure {
      code: exit_code_general_error,
      reason: "Regen diverged: pass 1 != pass 2 (fixed point not reached)"
    }
    Failed { stage: s, stderr: e } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("Regen failed at stage: ", e)
    }
    RegenToolsMissing { tool: t, hint: h } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("Regen: required tool missing: ", t, " (", h, ")")
    }
  }
}

func run_regenerate_stage0() -> ProcessExit {
  regen_to_exit(result: regenerate_stage0())
}
