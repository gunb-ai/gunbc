// gunbc/tools/regen.dag — Stage0 regeneration process.
//
// Replaces scripts/regenerate-stage0.sh with a .dag program.
// All paths and package names derive from gunbc.compiler data —
// adding a source root or changing the crate name propagates
// automatically.
//
// Entry point: regenerate_stage0()
// Future:      dag run --source-root dsl --function regenerate_stage0

module gunbc.tools.regen

import gunbc.compiler {
  compiler_cycle, SelfHostingCycle,
  build_command, check_command, compile_command, copy_output_command
}
import extdeps.shell

// ── Result types ───────────────────────────────────────────────���────

// Where in the regen process a failure occurred.
type RegenStage = Build | Compile | Check | Rebuild | Recompile

type RegenResult
  = Converged
  | Diverged
  | Failed { stage: RegenStage, stderr: String }

// ── Regen workflow ──────────────────────────────────────────────────
//
// Mirrors the 5-step process from regenerate-stage0.sh:
//   1. Build current compiler from committed stage0
//   2. Compile .dag source → Rust (pass 1)
//   3. Copy output to stage0, verify it compiles
//   4. Rebuild compiler with new stage0
//   5. Compile again (pass 2), verify pass1 == pass2

func regenerate(cycle: SelfHostingCycle) -> RegenResult {
  // Step 1: Build current compiler from committed stage0
  let build = shell.Exec.Run(script: build_command(cycle: cycle))
  if build.success == false {
    return Failed { stage: Build, stderr: build.stderr }
  }

  // Step 2: Compile .dag source → generated Rust (pass 1)
  let pass1 = shell.Exec.Run(script: compile_command(cycle: cycle, output_dir: ".regen-pass1"))
  if pass1.success == false {
    return Failed { stage: Compile, stderr: pass1.stderr }
  }

  // Step 3: Copy pass 1 output to stage0
  let copy = shell.Exec.Run(script: copy_output_command(from_dir: ".regen-pass1", cycle: cycle))
  if copy.success == false {
    return Failed { stage: Compile, stderr: copy.stderr }
  }

  // Step 4: Verify stage0 compiles with new generated code
  let check = shell.Exec.Run(script: check_command(cycle: cycle))
  if check.success == false {
    return Failed { stage: Check, stderr: check.stderr }
  }

  // Step 5: Rebuild compiler with new stage0
  let rebuild = shell.Exec.Run(script: build_command(cycle: cycle))
  if rebuild.success == false {
    return Failed { stage: Rebuild, stderr: rebuild.stderr }
  }

  // Step 6: Compile again with rebuilt compiler (pass 2)
  let pass2 = shell.Exec.Run(script: compile_command(cycle: cycle, output_dir: ".regen-pass2"))
  if pass2.success == false {
    return Failed { stage: Recompile, stderr: pass2.stderr }
  }

  // Step 7: Fixed-point check — pass 1 output == pass 2 output
  let diff = shell.Exec.Run(script: "diff -r .regen-pass1 .regen-pass2")

  // Step 8: Cleanup
  let _ = shell.Exec.Run(script: "rm -rf .regen-pass1 .regen-pass2")

  if diff.success { Converged } else { Diverged }
}

// Entry point: regenerate using the compiler's own self-hosting cycle.
func regenerate_stage0() -> RegenResult {
  regenerate(cycle: compiler_cycle)
}
