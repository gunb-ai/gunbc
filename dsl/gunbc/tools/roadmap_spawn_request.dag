module gunbc.tools.roadmap_spawn_request

import extdeps.shell
import gunbc.roadmap_spawner { roadmap_spawn_request_json }
import gunbc.roadmap_authority { roadmap_authority, authored_merged_prs }

func roadmap_next_spawnable() -> String {
  let sha_result = shell.Exec.Run(script: "git rev-parse HEAD 2>/dev/null | tr -d '\\n'")
  let anchor = if sha_result.success { sha_result.stdout } else { "unknown" }
  roadmap_spawn_request_json(doc: roadmap_authority(), merged: authored_merged_prs(), anchor_commit: anchor)
}
