// gunbc/tools/ci_runner_pool.dag — CF-M1: project CI self-hosted runner pool from compute_fabric supply.
//
// Authority: std.compute_fabric RunnerPoolFacts + operator-fleet ComputeOffer constraints.
// Host consumer: tools/ci_affected_components/src/runner_pool.rs (transport projection until
// gate-3 dispatches WorkDemand onto the fabric eval path).

module gunbc.tools.ci_runner_pool

import std.compute_fabric {
  RunnerPoolFacts,
  ComputeOffer,
  supply_srv1_ci_runner_pool,
  supply_srv2_ci_runner_pool,
  supply_srv1_host_identity,
  supply_srv2_host_identity,
  supply_srv1_offer,
  supply_srv2_offer
}

// Single authority: offer identity must equal the declared HostIdentity data row AND the
// canonical pool row for that host (constraints on the offer are wired from that pool row).
fn ci_runner_pool_offer_matches_authority(
  offer: ComputeOffer,
  pool: RunnerPoolFacts,
  host: HostIdentity
) -> Bool {
  offer.supply.physical.identity == host
  && pool.host == host
}

// Recover canonical pool for an inhabited offer — keyed on HostIdentity authorities only.
fn ci_runner_pool_from_offer(offer: ComputeOffer) -> RunnerPoolFacts {
  match offer.supply.physical.identity == supply_srv1_host_identity {
    true => supply_srv1_ci_runner_pool
    false =>
      match offer.supply.physical.identity == supply_srv2_host_identity {
        true => supply_srv2_ci_runner_pool
        false => supply_srv1_ci_runner_pool
      }
  }
}

// Fail-closed witness: pools recovered from offers match canonical supply rows field-wise.
fn ci_runner_pool_offer_projection_holds() -> Bool {
  ci_runner_pool_offer_matches_authority(
    offer: supply_srv1_offer,
    pool: supply_srv1_ci_runner_pool,
    host: supply_srv1_host_identity
  )
  && ci_runner_pool_offer_matches_authority(
    offer: supply_srv2_offer,
    pool: supply_srv2_ci_runner_pool,
    host: supply_srv2_host_identity
  )
  && (match ci_runner_pool_from_offer(offer: supply_srv1_offer) {
    pool1 =>
      pool1.host == supply_srv1_ci_runner_pool.host
      && pool1.runner_count == supply_srv1_ci_runner_pool.runner_count
      && pool1.jobserver_token_cap == supply_srv1_ci_runner_pool.jobserver_token_cap
      && pool1.architecture == supply_srv1_ci_runner_pool.architecture
      && pool1.core_count == supply_srv1_ci_runner_pool.core_count
      && pool1.jobserver_fifo == supply_srv1_ci_runner_pool.jobserver_fifo
  })
  && (match ci_runner_pool_from_offer(offer: supply_srv2_offer) {
    pool2 =>
      pool2.host == supply_srv2_ci_runner_pool.host
      && pool2.runner_count == supply_srv2_ci_runner_pool.runner_count
      && pool2.jobserver_token_cap == supply_srv2_ci_runner_pool.jobserver_token_cap
      && pool2.architecture == supply_srv2_ci_runner_pool.architecture
      && pool2.core_count == supply_srv2_ci_runner_pool.core_count
      && pool2.jobserver_fifo == supply_srv2_ci_runner_pool.jobserver_fifo
  })
}
