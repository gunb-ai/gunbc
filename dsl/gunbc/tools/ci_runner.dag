// gunbc/tools/ci_runner.dag — Execute the CI pipeline via the interpreter.
//
// Walks the gates declared in gunbc.ci, runs each command, tracks
// pass/fail with blocking semantics. Returns PipelinePass or
// PipelineFail so the caller (YAML shim or local dev) can act on
// the result.
//
// Entry point: run_ci_pipeline()
// Run via:     cargo run -p v2-compiler --release --bin gunbc -- run --source-root dsl --function run_ci_pipeline
//
// v2 `dag run --source-root dsl` only indexes that tree. If a dsl `.dag` imports
// `v3.std.emit_model`, resolution uses the parseable facade `dsl/v3/std/emit_model.dag`
// (canonical substrate: `src/v3/std/emit_model.dag`).

module gunbc.tools.ci_runner

import gunbc.ci { ci_pipeline, CIGate, render_ci_command }
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_code_general_error }
import extdeps.shell
import extdeps.github.log_annotations {
  LogAnnotation,
  AnnotationError, AnnotationNotice, AnnotationGroup, AnnotationEndGroup,
  render_log_annotation
}

// ── Result types ────────────────────────────────────────────────────

type GateOutcome {
  name: String
  passed: Bool
  blocking: Bool
  output: String
}

type PipelineResult
  = PipelinePass { passed: Int, total: Int }
  | PipelineFail { passed: Int, failed: Int, total: Int, blocking_failures: List<String> }

// ── Log annotation emission ─────────────────────────────────────────

func emit_log_annotation(annotation: LogAnnotation) -> Unit {
  let line = render_log_annotation(annotation)
  let _ = shell.Exec.Run(script: concat("printf '%s\\n' ", line))
}

// ── Gate execution ──────────────────────────────────────────────────

func run_gate(gate: CIGate) -> GateOutcome {
  let _ = emit_log_annotation(AnnotationGroup { title: gate.name })
  let script = render_ci_command(gate.command)
  let result = shell.Exec.Run(script: script)
  if result.success {
    let _ = emit_log_annotation(
      AnnotationNotice {
        message: concat("[PASS] ", gate.name),
        file: none,
        line: none,
        col: none
      }
    )
    let _ = emit_log_annotation(AnnotationEndGroup)
    { name: gate.name, passed: true, blocking: gate.blocking, output: result.stdout }
  } else {
    let _ = emit_log_annotation(
      AnnotationError {
        message: concat("[FAIL] ", gate.name),
        file: none,
        line: none,
        col: none
      }
    )
    let _ = emit_log_annotation(AnnotationEndGroup)
    { name: gate.name, passed: false, blocking: gate.blocking, output: result.stderr }
  }
}

// ── Pipeline execution ──────────────────────────────────────────────

func compute_pipeline_result() -> PipelineResult {
  let outcomes = ci_pipeline.gates |> map(g => run_gate(gate: g))

  let total = ci_pipeline.gates |> fold(init: 0, f: (acc, _) => acc + 1)
  let passed = outcomes |> filter(o => o.passed) |> fold(init: 0, f: (acc, _) => acc + 1)
  let failed = total - passed

  let blocking_failures = outcomes
    |> filter(o => o.passed == false && o.blocking)
    |> map(o => o.name)

  let blocking_count = blocking_failures |> fold(init: 0, f: (acc, _) => acc + 1)
  if blocking_count == 0 {
    PipelinePass { passed: passed, total: total }
  } else {
    PipelineFail { passed: passed, failed: failed, total: total, blocking_failures: blocking_failures }
  }
}

fn pipeline_to_exit(result: PipelineResult) -> ProcessExit {
  match result {
    PipelinePass { passed: _, total: _ } => ExitSuccess
    PipelineFail { passed: p, failed: f, total: t, blocking_failures: b } =>
      ExitFailure {
        code: exit_code_general_error,
        reason: concat("CI pipeline: ", to_string(value: f), " of ", to_string(value: t), " gates failed")
      }
  }
}

func run_ci_pipeline() -> ProcessExit {
  pipeline_to_exit(result: compute_pipeline_result())
}

// Parse/typecheck witness for the CI floor closure under --source-root dsl.
// Used by the blocking dsl-compile-clean gate (--claim-run: true → exit 0).
func ci_floor_parse_check() -> Bool {
  true
}
