// gunbc/tools/freshness.dag — Stage0 freshness check.
//
// Replaces scripts/check-stage0-freshness.sh with a .dag program.
// Verifies that committed stage0 matches what the compiler would
// currently produce, EXCLUDING hand_maintained_src files.
//
// Uses tri-state diff exit code matching: 0 = same, 1 = different,
// 2 = error. Earlier versions collapsed exit 1 and 2 into "stale", which
// would mislabel a real diff failure (unreadable dir, bad invocation)
// as ordinary drift. Now diff errors surface as Failed instead.
//
// Entry points:
//   run_freshness_check()      → ProcessExit, for dag run / CI
//   check_stage0_freshness()   → FreshnessCheckResult, composable internal
//
// Run via: dag run --source-root dsl --function run_freshness_check

module gunbc.tools.freshness

import gunbc.compiler {
  compiler_cycle, SelfHostingCycle,
  resolve_compiler_tools, ToolsReady, ToolsMissing,
  build_command, compile_command, diff_exclude_args
}
import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_code_general_error }
import extdeps.shell

// ── Result type ─────────────────────────────────────────────────────

type FreshnessCheckResult
  = Fresh
  | Stale { diff: String }
  | Failed { stderr: String }
  | FreshnessToolsMissing { tool: String, hint: String }

// ── diff tri-state ──────────────────────────────────────────────────
// diff exit codes (POSIX, GNU/BSD compatible):
//   0 = files/dirs are identical
//   1 = files/dirs differ
//   2 = error (file not found, unreadable, etc.)
// Earlier versions of this file collapsed exit 1 and 2 into "stale",
// which masked real diff failures.

type DiffOutcome
  = DiffSame
  | DiffDifferent
  | DiffError { stderr: String }

fn classify_diff_exit(exit_code: Int, stderr: String) -> DiffOutcome {
  if exit_code == 0 { DiffSame }
  else if exit_code == 1 { DiffDifferent }
  else { DiffError { stderr: stderr } }
}

// ── Freshness workflow ──────────────────────────────────────────────

func check_freshness(cycle: SelfHostingCycle) -> FreshnessCheckResult {
  match resolve_compiler_tools() {
    ToolsMissing { tool: t, hint: h } => FreshnessToolsMissing { tool: t, hint: h }
    ToolsReady { tools: t } => {
      // Build current compiler
      let build = shell.Exec.Run(script: build_command(cargo: t.cargo, cycle: cycle))
      if build.success == false {
        return Failed { stderr: build.stderr }
      }

      // Clear any stale temp dir from a prior run
      let _ = shell.Exec.Run(script: concat(t.rm, " -rf .freshness-check"))

      // Compile .dag source to temp dir
      let compile = shell.Exec.Run(
        script: compile_command(cargo: t.cargo, cycle: cycle, output_dir: ".freshness-check")
      )
      if compile.success == false {
        return Failed { stderr: compile.stderr }
      }

      // Compare generated output against committed stage0, excluding
      // hand-maintained files. Match on tri-state exit code so a real
      // diff failure surfaces as Failed instead of being mislabeled Stale.
      let exclude = diff_exclude_args(cycle: cycle)
      let diff_run = shell.Exec.Run(
        script: concat(t.diff, " -rq", exclude,
                       " .freshness-check/src/ ", cycle.generated.source_dir, "/")
      )
      let diff_outcome = classify_diff_exit(exit_code: diff_run.exit_code, stderr: diff_run.stderr)

      // Cleanup
      let _ = shell.Exec.Run(script: concat(t.rm, " -rf .freshness-check"))

      match diff_outcome {
        DiffSame => Fresh
        DiffDifferent => Stale { diff: diff_run.stdout }
        DiffError { stderr: e } => Failed { stderr: e }
      }
    }
  }
}

func check_stage0_freshness() -> FreshnessCheckResult {
  check_freshness(cycle: compiler_cycle)
}

// ── ProcessExit entry point ─────────────────────────────────────────
// Wraps check_stage0_freshness so the host can map result → exit code.

fn freshness_to_exit(result: FreshnessCheckResult) -> ProcessExit {
  match result {
    Fresh => ExitSuccess
    Stale { diff: d } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("Stage0 stale:\n", d)
    }
    Failed { stderr: e } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("Freshness check failed:\n", e)
    }
    FreshnessToolsMissing { tool: t, hint: h } => ExitFailure {
      code: exit_code_general_error,
      reason: concat("Freshness check: required tool missing: ", t, " (", h, ")")
    }
  }
}

func run_freshness_check() -> ProcessExit {
  freshness_to_exit(result: check_stage0_freshness())
}
