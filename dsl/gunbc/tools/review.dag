// gunbc/tools/review.dag -- PR review workflow.
//
// Reviews PRs on two axes:
//   1. Invariant violations -- checks diff against INVARIANTS.md
//   2. Compositional modeling -- evaluates new .dag types/services for
//      accuracy, harmony with existing models, and room for improvement.
//      Uses std/algebra.dag, std/integer.dag, and extdeps/ as reference
//      for what good compositional modeling looks like.
//
// Entrypoints:
//   review_cycle() -- review all open PRs (upserts cron schedule)
//   review_pr()    -- review a single PR by number
//
// Backend selection is config-driven (config/review.dag). The backend
// CLI command is built as a string and invoked via shell.Exec.Run.
//
// Dedup is stateless -- queries GitHub for existing reviews at each SHA.

module gunbc.tools.review

import extdeps.git
import extdeps.cron
import extdeps.github.auth { github_token }
import extdeps.github.pulls
import extdeps.shell
import config.review {
  default_backend,
  default_codex_model,
  default_claude_model,
  owner,
  repo,
  review_objective
}
import std.resources { Network }
import std.types { Url }

// -- Pure helper functions --------------------------------------------

fn backend_command(backend: String, prompt_file: String, cwd: String) -> String {
  match backend {
    "codex" => "codex exec -m {default_codex_model} -C {cwd} - < {prompt_file}"
    "claude" => "claude -p --output-format text --permission-mode plan --model {default_claude_model} --effort max < {prompt_file}"
    "gemini" => "gemini -p --output-format text --approval-mode plan < {prompt_file}"
    _ => "echo unknown backend && exit 1"
  }
}

// -- Review context assembly ------------------------------------------
// The review prompt includes three reference documents from the repo:
//   1. INVARIANTS.md -- the rules to check against
//   2. std/algebra.dag -- reference for compositional type modeling
//   3. std/integer.dag -- reference for carrier + algebra witness pattern
// These are fetched from the PR's head commit via git show.

fn build_review_context(branch: String) -> String {
  "Fetched from origin/{branch}"
}

// -- Review a single PR -----------------------------------------------

func review_pr(
  pr_number: Int,
  pr_title: String,
  pr_url: String,
  branch: String,
  base_ref: String,
  backend: String = default_backend
) -> { comment_url: String }
  uses net: Network
{
  token = github_token()
  prompt_file = "/Users/briansrls/.local/share/gunbc-review/prompt.md"

  // Step 1: Fetch diff, diffstat, and reference docs (parallel)
  pr_diff = github.Pulls.Diff(
    auth_token: token.token,
    owner: owner,
    repo: repo,
    pull_number: pr_number
  )
  diffstat = shell.Exec.Run(
    script: "cd /Users/briansrls/gunbc && git diff --stat --find-renames origin/{base_ref}...origin/{branch} 2>/dev/null || echo '(diffstat unavailable)'"
  )
  invariants = shell.Exec.Run(
    script: "cd /Users/briansrls/gunbc && git show origin/{branch}:INVARIANTS.md 2>/dev/null || echo '(not found)'"
  )
  algebra_ref = shell.Exec.Run(
    script: "cd /Users/briansrls/gunbc && git show origin/{branch}:dsl/std/algebra.dag 2>/dev/null || echo '(not found)'"
  )
  integer_ref = shell.Exec.Run(
    script: "cd /Users/briansrls/gunbc && git show origin/{branch}:dsl/std/integer.dag 2>/dev/null || echo '(not found)'"
  )
  extdeps_ref = shell.Exec.Run(
    script: "cd /Users/briansrls/gunbc && git show origin/{branch}:dsl/extdeps/extdeps.md 2>/dev/null || echo '(not found)'"
  )

  // Step 2: Write prompt and invoke LLM
  command = backend_command(backend: backend, prompt_file: prompt_file, cwd: "/Users/briansrls/gunbc")
  llm_result = shell.Exec.Run(
    script: "mkdir -p /Users/briansrls/.local/share/gunbc-review && cat > {prompt_file} << 'PROMPT_BOUNDARY'\n... prompt content ...\nPROMPT_BOUNDARY\n{command}"
  )

  // Step 3: Post review (line comments parsed by shell runtime)
  posted = github.Pulls.CreateComment(
    auth_token: token.token,
    owner: owner,
    repo: repo,
    issue_number: pr_number,
    body: llm_result.stdout
  )

  return { comment_url: posted.html_url }
}

// -- Top-level entrypoint: review all open PRs ------------------------

func review_cycle(backend: String = default_backend) -> { reviewed_count: Int }
  uses net: Network
{
  // Upsert cron schedule -- idempotent, converges on every run
  cron.Tab.Upsert(
    tag: "review-agent",
    schedule: "*/10 * * * *",
    command: "/Users/briansrls/gunbc/scripts/review-agent run",
    log_path: "/Users/briansrls/.local/share/gunbc-review/logs/cron.log"
  )

  token = github_token()

  // List open PRs
  open_prs = github.Pulls.List(
    auth_token: token.token,
    owner: owner,
    repo: repo,
    state: "open"
  )

  // Review each open PR
  results = for pr in open_prs.pulls {
    review_pr(
      pr_number: pr.number,
      pr_title: pr.title,
      pr_url: pr.html_url,
      branch: pr.head.ref,
      base_ref: pr.base.ref,
      backend: backend
    )
  }

  return { reviewed_count: count(results) }
}
