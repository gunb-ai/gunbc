// gunbc/tools/review.dag -- PR review workflow.
//
// Reviews open PRs for invariant violations and compositional modeling
// quality. Every operation is idempotent:
//   - Cron upsert: tag-based, converges on every run
//   - Review dedup: checks GitHub for existing review at commit SHA
//   - Comment resolution: minimizes fixed violations (future)
//
// Entrypoints:
//   review_cycle(owner, repo) -- scan and review all open PRs
//   review_pr(owner, repo, pr_number) -- review a single PR

module gunbc.tools.review

import extdeps.cron
import extdeps.github.pulls
import extdeps.llm.anthropic
import extdeps.shell

// -- Configuration as data --------------------------------------------

data default_model: String = "claude-sonnet-4-6-20250929"
data cron_schedule: String = "*/10 * * * *"
// Messages as JSON string: call arguments go through the general expression
// emitter, not emit_simple_expr. The Json-typed param resolves the record to
// LlmMessage which isn't in scope. Dissolves when the emitter handles
// Json-typed arguments via serde_json::json! instead of struct construction.
data review_messages: String = "[{\"role\": \"user\", \"content\": \"Review the PR described in the system prompt.\"}]"

// -- Pure functions ---------------------------------------------------

fn has_review_at_sha(reviews: List<PullReview>, sha: String) -> Bool {
  any(reviews, r => r.commit_id == sha && contains(r.body, "Review"))
}

fn build_system_prompt(
  invariants: String,
  algebra_ref: String,
  extdeps_ref: String
) -> String {
  let instructions = "Review on two axes:\n1. INVARIANT VIOLATIONS: check diff against INVARIANTS.md\n2. COMPOSITIONAL MODELING: for .dag changes, evaluate accuracy, harmony, layering\n\nOutput:\nVIOLATION|file|line|description\nMODEL|file|GOOD|description\nMODEL|file|IMPROVE|description\nSUMMARY|one sentence\n\nNothing else."
  "{instructions}\n\n--- INVARIANTS.md ---\n{invariants}\n\n--- std/algebra.dag ---\n{algebra_ref}\n\n--- extdeps.md ---\n{extdeps_ref}"
}

fn build_user_message(
  pr_title: String,
  pr_number: Int,
  branch: String,
  base_ref: String,
  diff: String
) -> String {
  "PR #{pr_number}: {pr_title}\nBranch: {branch} -> {base_ref}\n\n--- Diff ---\n{diff}"
}

fn build_review_prompt(
  pr_title: String,
  pr_number: Int,
  branch: String,
  base_ref: String,
  diff: String,
  invariants: String,
  algebra_ref: String,
  extdeps_ref: String
) -> String {
  let system = build_system_prompt(invariants: invariants, algebra_ref: algebra_ref, extdeps_ref: extdeps_ref)
  let user_msg = build_user_message(pr_title: pr_title, pr_number: pr_number, branch: branch, base_ref: base_ref, diff: diff)
  "{system}\n\n{user_msg}"
}

// -- Review a single PR -----------------------------------------------
// Idempotent: checks ListReviews before posting. If a review exists
// at this commit SHA, returns early.

func review_pr(
  owner: String,
  repo: String,
  pr_number: Int,
  model: String = default_model
) -> { reviewed: Bool, comment_url: String } {

  // Step 1: Get PR metadata
  pr = github.Pulls.Get(
    owner: owner,
    repo: repo,
    pull_number: pr_number
  )

  // Step 2: Dedup -- check if already reviewed at this SHA (idempotent guard)
  existing = github.Pulls.ListReviews(
    owner: owner,
    repo: repo,
    pull_number: pr_number
  )
  already_done = has_review_at_sha(reviews: existing.reviews, sha: pr.pr.head.sha)

  // Step 3: Fetch context (parallel)
  diff = github.Pulls.Diff(
    owner: owner,
    repo: repo,
    pull_number: pr_number
  )
  invariants = shell.Exec.Run(
    script: "cd ~/gunbc && git fetch origin {pr.pr.head.ref} 2>/dev/null; git show origin/{pr.pr.head.ref}:INVARIANTS.md 2>/dev/null || echo '(not found)'"
  )
  algebra_ref = shell.Exec.Run(
    script: "cd ~/gunbc && git show origin/{pr.pr.head.ref}:dsl/std/algebra.dag 2>/dev/null || echo '(not found)'"
  )
  extdeps_ref = shell.Exec.Run(
    script: "cd ~/gunbc && git show origin/{pr.pr.head.ref}:dsl/extdeps/extdeps.md 2>/dev/null || echo '(not found)'"
  )

  // Step 4: Build context and invoke LLM via Anthropic REST API
  system_prompt = build_system_prompt(
    invariants: invariants.stdout,
    algebra_ref: algebra_ref.stdout,
    extdeps_ref: extdeps_ref.stdout
  )
  user_msg = build_user_message(
    pr_title: pr.pr.title,
    pr_number: pr_number,
    branch: pr.pr.head.ref,
    base_ref: pr.pr.base.ref,
    diff: diff.diff
  )
  llm_response = llm.Anthropic.Messages(
    model: model,
    messages: review_messages,
    max_tokens: 8192,
    temperature: none,
    system: "{system_prompt}\n\n{user_msg}"
  )

  // Step 5: Post review via GitHub API (idempotent: guarded by step 2)
  posted = github.Pulls.CreateReview(
    owner: owner,
    repo: repo,
    pull_number: pr_number,
    commit_id: pr.pr.head.sha,
    body: llm_response.content,
    comments: "[]"
  )

  return { reviewed: true, comment_url: posted.html_url }
}

// -- Top-level: review all open PRs -----------------------------------
// Idempotent end-to-end:
//   1. Cron upsert: ensures schedule exists (tag-based, converges)
//   2. PR listing: reads current state from GitHub
//   3. Per-PR review: guarded by ListReviews dedup

func review_cycle(
  owner: String = "gunb-ai",
  repo: String = "gunbc"
) -> { reviewed_count: Int } {

  // Upsert cron -- idempotent, converges on every run
  cron.Tab.Upsert(
    tag: "review-agent",
    schedule: cron_schedule,
    command: "/Users/briansrls/gunbc/target/review-codegen/review-agent review-cycle",
    log_path: "/Users/briansrls/.local/share/gunbc-review/logs/cron.log"
  )

  // List open PRs
  open_prs = github.Pulls.List(
    owner: owner,
    repo: repo,
    state: "open"
  )

  // Review each PR (review_pr handles dedup internally)
  results = for pr in open_prs.pulls {
    review_pr(
      owner: owner,
      repo: repo,
      pr_number: pr.number
    )
  }

  return { reviewed_count: count(results) }
}
