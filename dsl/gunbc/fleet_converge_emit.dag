module gunbc.fleet_converge_emit

import std.types { String, List, Int, Bool }
import std.layout {
  Doc, DocConcat,
  LayoutProtocol,
  doc_concat, doc_line_of,
  render
}
import gunbc.host_converge {
  ConvergePolicy,
  ConvergePolicyDerived,
  ConvergePolicyUnsound,
  HostConverge,
  ConvergeKnob,
  ConvergeTarget,
  SliceProperty,
  PerSlotMemoryCap,
  RunnerWidth,
  JobserverTokens,
  VerifyOnlyCap,
  ConvergeSlice,
  converge_slice_label,
  fleet_converge_policy,
}

data fleet_converge_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

data gunbc_fleet_converge_emit_doc: String = "Regime-2 (pure-projection, emit-only, NEVER parsed back) Doc-IR projection of the gunbc.host_converge policy to .github/fleet-converge.sh, rendered through the SAME std.layout Doc/render path as the runner-deploy manifest (NOT a bash-AST sidecar -- the script is a projected apply-script with no round-trip law, so regime 2 is correct, DESIGN section 4/5 honesty boundary). The emitted .sh applies each ConvergeKnob to its host via the grounded systemd mechanisms (gunbc_host_converge_grounded_mechanism_marker), reads the live effective value back, and prints converge-receipt lines in the frozen grammar (gunbc_host_converge_receipt_grammar_marker) for fierce-carp-462's ctrl reconciler to parse. The per-knob verdict bash realizes converge_verdict (the single authority; empty read => absent = the ReadAbsent gate, mismatch => drifted, match => converged). Fail-closed: an unsound policy projects a non-zero-exit script (no fabricated converge). SAFETY: per_session_max_bytes is read-back ONLY (the converge never set-property's it nor caps existing scopes -- the spawn path owns the write)."

fn sh_arg(s: String) -> String {
  concat(concat("\"", s), "\"")
}

fn sh_call(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => if acc == "" { sh_arg(s: p) } else { concat(concat(acc, " "), sh_arg(s: p)) })
}

fn converge_script_header() -> Doc {
  doc_concat(parts: map([
    "#!/usr/bin/env bash",
    "set -euo pipefail",
    "# GENERATED by dsl/gunbc/fleet_converge_emit.dag (gunbc.fleet_converge_emit). DO NOT HAND-EDIT.",
    "# Regime-2 pure projection of the gunbc.host_converge policy. Run per-host as the blessed ctrl",
    "# shell transport; emits converge-receipt lines on stdout (EMIT is the single authority; the",
    "# ctrl reconciler aligns to gunbc_host_converge_receipt_grammar_marker with no fallback).",
    "# Ordering invariant: caps-before-widen (runner_count is applied LAST).",
    "",
    "host_failed=0",
    "applied=0; drifted=0; any_absent=0; verdict=converged; effective=",
    "",
    "emit_receipt() {",
    "  printf 'converge-receipt host=%s slice=%s knob=%s desired=%s effective=%s verdict=%s\\n' \"$1\" \"$2\" \"$3\" \"$4\" \"$5\" \"$6\"",
    "}",
    "",
    "record() {",
    "  applied=$((applied + 1))",
    "  if [ \"$1\" != \"converged\" ]; then drifted=$((drifted + 1)); fi",
    "  if [ \"$1\" = \"absent\" ]; then any_absent=1; fi",
    "}",
    "",
    "host_begin() {",
    "  applied=0; drifted=0; any_absent=0",
    "}",
    "",
    "host_summary() {",
    "  if [ \"$drifted\" -eq 0 ]; then verdict=converged",
    "  elif [ \"$any_absent\" -eq 1 ]; then verdict=absent",
    "  else verdict=drifted; fi",
    "  printf 'converge-receipt host=%s applied=%s drifted=%s verdict=%s\\n' \"$1\" \"$applied\" \"$drifted\" \"$verdict\"",
    "  if [ \"$drifted\" -ne 0 ]; then host_failed=1; fi",
    "}",
    "",
    "# verdict realizes gunbc.host_converge.converge_verdict (single authority): empty=absent, equal=converged, else=drifted.",
    "decide_verdict() {",
    "  if [ -z \"$1\" ]; then verdict=absent",
    "  elif [ \"$1\" = \"$2\" ]; then verdict=converged",
    "  else verdict=drifted; fi",
    "}",
    "",
    "converge_slice_property() {",
    "  # host slice knob unit property apply_value expected_effective desired_display",
    "  systemctl set-property \"$4\" \"$5=$6\" >/dev/null 2>&1 || true",
    "  effective=\"$(systemctl show \"$4\" --property=\"$5\" --value 2>/dev/null || true)\"",
    "  if [ -z \"$effective\" ]; then effective=ABSENT; verdict=absent; else decide_verdict \"$effective\" \"$7\"; fi",
    "  emit_receipt \"$1\" \"$2\" \"$3\" \"$8\" \"$effective\" \"$verdict\"",
    "  record \"$verdict\"",
    "}",
    "",
    "converge_per_slot_cap() {",
    "  # host slice knob dropin_path instance_glob property bytes",
    "  # template drop-in (future instances, inert until restart) + set-property per active instance (effective now)",
    "  mkdir -p \"$(dirname \"$4\")\"",
    "  printf '[Service]\\n%s=%s\\n' \"$6\" \"$7\" > \"$4\"",
    "  systemctl daemon-reload >/dev/null 2>&1 || true",
    "  n=0; all_ok=1; effective=ABSENT",
    "  for unit in $(systemctl list-units --type=service --state=active --no-legend \"$5\" 2>/dev/null | awk '{print $1}'); do",
    "    n=$((n + 1))",
    "    systemctl set-property \"$unit\" \"$6=$7\" >/dev/null 2>&1 || true",
    "    eff=\"$(systemctl show \"$unit\" --property=\"$6\" --value 2>/dev/null || true)\"",
    "    effective=\"$eff\"",
    "    if [ \"$eff\" != \"$7\" ]; then all_ok=0; fi",
    "  done",
    "  if [ \"$n\" -eq 0 ]; then effective=ABSENT; verdict=absent",
    "  elif [ \"$all_ok\" -eq 1 ]; then verdict=converged",
    "  else verdict=drifted; fi",
    "  emit_receipt \"$1\" \"$2\" \"$3\" \"$7\" \"$effective\" \"$verdict\"",
    "  record \"$verdict\"",
    "}",
    "",
    "converge_runner_width() {",
    "  # host slice knob instance_glob desired_count",
    "  current=$(systemctl list-units --type=service --state=active --no-legend \"$4\" 2>/dev/null | awk 'END{print NR}')",
    "  current=${current:-0}",
    "  if [ \"$current\" -gt \"$5\" ]; then",
    "    # DECREASE: drain-before-stop the surplus, highest-NN first (stop=SIGTERM to Runner.Listener, never SIGKILL), then disable",
    "    systemctl list-units --type=service --state=active --no-legend \"$4\" 2>/dev/null | awk '{print $1}' | sort -r | head -n \"$((current - $5))\" | while IFS= read -r unit; do",
    "      systemctl stop \"$unit\" || true",
    "      systemctl disable \"$unit\" >/dev/null 2>&1 || true",
    "    done",
    "  elif [ \"$current\" -lt \"$5\" ]; then",
    "    echo \"width INCREASE $current->$5 needs slot provisioning (rsync from -01); run the install path -- converge only drains for DECREASE\" >&2",
    "  fi",
    "  effective=$(systemctl list-units --type=service --state=active --no-legend \"$4\" 2>/dev/null | awk 'END{print NR}')",
    "  effective=${effective:-0}",
    "  decide_verdict \"$effective\" \"$5\"",
    "  emit_receipt \"$1\" \"$2\" \"$3\" \"$5\" \"$effective\" \"$verdict\"",
    "  record \"$verdict\"",
    "}",
    "",
    "converge_jobserver_tokens() {",
    "  # host slice knob env_file env_key service desired_count  (FIFO-safe: shrink by attrition on restart between builds)",
    "  mkdir -p \"$(dirname \"$4\")\"",
    "  printf '%s=%s\\n' \"$5\" \"$7\" > \"$4\"",
    "  systemctl restart \"$6\" >/dev/null 2>&1 || true",
    "  effective=\"$(grep -E \"^$5=\" \"$4\" 2>/dev/null | head -n1 | cut -d= -f2 | tr -d ' ' || true)\"",
    "  if [ -z \"$effective\" ]; then effective=ABSENT; verdict=absent; else decide_verdict \"$effective\" \"$7\"; fi",
    "  emit_receipt \"$1\" \"$2\" \"$3\" \"$7\" \"$effective\" \"$verdict\"",
    "  record \"$verdict\"",
    "}",
    "",
    "converge_verify_only_cap() {",
    "  # host slice knob slice_unit property desired  (CARRY+VERIFY ONLY: NEVER set-property; the spawn path owns the write)",
    "  scope=\"$(systemctl show \"$4\" --property=ConsistsOf --value 2>/dev/null | tr ' ' '\\n' | grep -m1 '\\.scope$' || true)\"",
    "  if [ -z \"$scope\" ]; then effective=ABSENT; verdict=absent;",
    "  else",
    "    effective=\"$(systemctl show \"$scope\" --property=\"$5\" --value 2>/dev/null || true)\"",
    "    if [ -z \"$effective\" ]; then effective=ABSENT; verdict=absent; else decide_verdict \"$effective\" \"$6\"; fi",
    "  fi",
    "  emit_receipt \"$1\" \"$2\" \"$3\" \"$6\" \"$effective\" \"$verdict\"",
    "  record \"$verdict\"",
    "}",
    ""
  ], line => doc_line_of(text: line)))
}

fn knob_call_line(host: String, k: ConvergeKnob) -> Doc {
  let slice = converge_slice_label(s: k.slice)
  match k.target {
    SliceProperty { unit: u, property: p, apply_value: av, expected_effective: ee } =>
      doc_line_of(text: sh_call(parts: ["converge_slice_property", host, slice, k.name, u, p, av, ee, k.desired]))
    PerSlotMemoryCap { dropin_path: d, instance_glob: g, property: p, bytes_value: b } =>
      doc_line_of(text: sh_call(parts: ["converge_per_slot_cap", host, slice, k.name, d, g, p, b]))
    RunnerWidth { instance_glob: g } =>
      doc_line_of(text: sh_call(parts: ["converge_runner_width", host, slice, k.name, g, k.desired]))
    JobserverTokens { env_file: f, env_key: ek, service_unit: su } =>
      doc_line_of(text: sh_call(parts: ["converge_jobserver_tokens", host, slice, k.name, f, ek, su, k.desired]))
    VerifyOnlyCap { slice_unit: u, property: p } =>
      doc_line_of(text: sh_call(parts: ["converge_verify_only_cap", host, slice, k.name, u, p, k.desired]))
  }
}

fn host_converge_doc(h: HostConverge) -> Doc {
  doc_concat(parts: append(
    concat(
      [doc_line_of(text: sh_call(parts: ["host_begin", h.identity]))],
      map(h.knobs, k => knob_call_line(host: h.identity, k: k))
    ),
    items: [doc_line_of(text: sh_call(parts: ["host_summary", h.identity]))]
  ))
}

fn converge_unsound_doc(reason: String) -> Doc {
  doc_concat(parts: map([
    "#!/usr/bin/env bash",
    "set -euo pipefail",
    "# GENERATED by dsl/gunbc/fleet_converge_emit.dag (gunbc.fleet_converge_emit). DO NOT HAND-EDIT.",
    concat("echo \"fleet-converge UNSOUND: ", concat(reason, "\" >&2")),
    "exit 1"
  ], line => doc_line_of(text: line)))
}

fn project_fleet_converge_to_doc(policy: ConvergePolicy) -> Doc {
  match policy {
    ConvergePolicyUnsound { reason: reason } => converge_unsound_doc(reason: reason)
    ConvergePolicyDerived { hosts: hosts } =>
      doc_concat(parts: append(
        [converge_script_header()],
        items: append(
          map(hosts, h => host_converge_doc(h: h)),
          items: [doc_line_of(text: "exit \"$host_failed\"")]
        )
      ))
  }
}

fn fleet_converge_sh_for(policy: ConvergePolicy) -> String {
  render(doc: project_fleet_converge_to_doc(policy: policy), proto: fleet_converge_protocol)
}

fn expected_fleet_converge_sh() -> String {
  fleet_converge_sh_for(policy: fleet_converge_policy())
}

fn fleet_converge_drifted(committed: String) -> Bool {
  !(committed == expected_fleet_converge_sh())
}
