module gunbc.ctrl_reconcile_staleness_claims

import std.logic { Bool }
import gunbc.host_effect { HostOs, NodeControlPlane }
import gunbc.fleet_intent { srv1_host }
import gunbc.ctrl_reconcile {
  ctrl_reconcile_staleness_gate_holds,
  ctrl_reconcile_default_slice_unit,
}

data ctrl_reconcile_staleness_claims_doc: String = "Live staleness claims for ctrl-reconcile. ctrl_reconcile_live_staleness_recapture_gate_holds invokes host_effect_apply(systemctl show -p MemoryMax) on srv1 BEFORE comparing to ctrl_reconcile_recorded_show_bytes — the #6009 ordering analog (fresh capture precedes compare). Honest boundary: hermetic floor witnesses prove binding discrimination; this claim is the off-floor live authenticity check."

fn ctrl_reconcile_live_target() -> NodeControlPlane {
  HostOs { node: srv1_host }
}

func ctrl_reconcile_live_staleness_recapture_gate_holds() -> Bool {
  ctrl_reconcile_staleness_gate_holds(
    target: ctrl_reconcile_live_target(),
    slice_unit: ctrl_reconcile_default_slice_unit()
  )
}
