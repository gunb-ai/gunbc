// gunbc/design_argument.dag — DESIGN.md's own argument, as data (the §7 recursion).
//
// The axiom+syllogism lens's first target is DESIGN.md itself (DESIGN open thread #1):
// the document checking that its own serial structure is a real consequence-chain back
// to the axioms, not a circle. This module is the INSTANCE — the A1-A3 axioms and the
// §1 consequence rows — kept OUT of std/ (it is a fact about gunbc's own DESIGN, not a
// universal framework, exactly as doc_reachability homes the doc-graph instance outside
// std/). The framework it runs over is std/syllogism.dag (§3 single authority).
//
// SCOPE: §1 only — the smallest NON-VACUOUS argument (A1-A3 + their immediate
// consequences), per the "DESIGN as the FIRST target" reading. §2-§7 rows (and the
// independent-peer sections, which root into their OWN licensing axiom) land on top
// incrementally once this slice is green.
//
// These rows are the "map" step of §2's decompress -> map -> reduce: DESIGN's prose
// already NAMES each edge ("From A1 and A2 —", "From A2 and A3 —", "A1-A2 turned on
// grounding itself"), so the model transcribes the stated premises, it does not invent
// them. A1-A3 are NonLogicalAxiom (domain postulates of the gunbc theory; the §1 prose
// "assumed, not derived").

module gunbc.design_argument

import std.syllogism {
  Axiom, LogicalAxiom, NonLogicalAxiom,
  Proposition, Argument
}

// DESIGN §1 — "The objective (the axioms)". Three NON-LOGICAL axioms: assumed,
// not derived; domain postulates about goals / time / agreement, not tautologies.
data design_axioms: List<Axiom> = [
  Axiom {
    id: "A1",
    statement: "there is a goal: to solve a problem presupposes an agent with a goal to satisfy",
    kind: NonLogicalAxiom
  },
  Axiom {
    id: "A2",
    statement: "time is the value: every agent intrinsically values time — time is life — the one value assumed shared",
    kind: NonLogicalAxiom
  },
  Axiom {
    id: "A3",
    statement: "agreement is temporal: intersubjective agreement is possible only across time, on what stays stable under it",
    kind: NonLogicalAxiom
  }
]

// DESIGN §1's three stated consequences — each names the premises the prose cites.
data design_section_1_propositions: List<Proposition> = [
  // "From A1 and A2 — the solution is minimal, safe, efficient."
  Proposition {
    id: "s1.minimal-safe-efficient",
    statement: "the solution is minimal, safe, efficient: a solution is good insofar as it spends less of the only thing valued, time (cost, safety, complexity)",
    premises: ["A1", "A2"]
  },
  // "From A2 and A3 — grounding is intersubjective."
  Proposition {
    id: "s1.grounding-intersubjective",
    statement: "grounding is intersubjective: because time is the only assumed-shared value, a fact is grounded only by pointing at a shared, time-stable framework",
    premises: ["A2", "A3"]
  },
  // "At the limit — reduce intersubjectivity to physics." — "A1-A2 turned on grounding itself".
  Proposition {
    id: "s1.reduce-to-physics",
    statement: "at the limit, reduce intersubjectivity to physics: the efficient, time-bound description of interactions that satisfies a goal — A1-A2 turned on grounding itself",
    premises: ["A1", "A2", "s1.grounding-intersubjective"]
  }
]

// The DESIGN §1 argument: the non-logical axioms and the consequences they entail.
data design_section_1_argument: Argument = Argument {
  axioms: design_axioms,
  propositions: design_section_1_propositions
}
