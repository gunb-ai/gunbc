module gunbc.node_http_server_emit

import std.types { HttpMethod, GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS }
import std.http_path { PathTemplate, LiteralToken, ParamToken }
import extdeps.http.server {
  HttpServerListenConfig,
  ServedStaticRoute,
  ServedStaticRouteTable,
  http_content_type_wire_label,
}
import gunbc.gunbhub_serve { gunbhub_served_static_route_table }

type NodeHttpStaticServerSpec {
  service_name: String
  routes: ServedStaticRouteTable
  listen: HttpServerListenConfig
}

fn emit_http_method_label(method: HttpMethod) -> String {
  match method {
    GET => "GET"
    POST => "POST"
    PUT => "PUT"
    PATCH => "PATCH"
    DELETE => "DELETE"
    HEAD => "HEAD"
    OPTIONS => "OPTIONS"
  }
}

fn js_backtick_escape(s: String) -> String {
  let s1 = join(split(s: s, delimiter: "\\"), "\\\\")
  let s2 = join(split(s: s1, delimiter: "`"), "\\`")
  s2
}

fn js_regex_escape_literal(s: String) -> String {
  let s1 = join(split(s: s, delimiter: "\\"), "\\\\")
  let s2 = join(split(s: s1, delimiter: "."), "\\.")
  let s3 = join(split(s: s2, delimiter: "+"), "\\+")
  let s4 = join(split(s: s3, delimiter: "?"), "\\?")
  let s5 = join(split(s: s4, delimiter: "*"), "\\*")
  let s6 = join(split(s: s5, delimiter: "("), "\\(")
  let s7 = join(split(s: s6, delimiter: ")"), "\\)")
  let s8 = join(split(s: s7, delimiter: "^"), "\\^")
  let s9 = join(split(s: s8, delimiter: "$"), "\\$")
  let s10 = join(split(s: s9, delimiter: "["), "\\[")
  let s11 = join(split(s: s10, delimiter: "]"), "\\]")
  let s12 = join(split(s: s11, delimiter: "\{"), "\\\{")
  let s13 = join(split(s: s12, delimiter: "\}"), "\\\}")
  let s14 = join(split(s: s13, delimiter: "|"), "\\|")
  s14
}

fn emit_path_template_re(template: PathTemplate) -> String {
  let segs = map(xs: template.tokens, f: tok =>
    match tok {
      LiteralToken { text: t } => js_regex_escape_literal(s: t)
      ParamToken { name: _ } => "[^\\/]+"
    }
  )
  if count(xs: segs) == 0 {
    "/^\\/$/"
  } else {
    join(["/^\\/", join(segs, "\\/"), "$/"], "")
  }
}

fn emit_static_route_entry(route: ServedStaticRoute) -> String {
  let method = emit_http_method_label(method: route.method)
  let re = emit_path_template_re(template: route.path_pattern)
  let body_esc = js_backtick_escape(s: route.body)
  let ct = http_content_type_wire_label(content_type: route.content_type)
  let status = to_string(route.status_on_hit)
  join(["  \{ method: '", method, "', pathRe: ", re, ", body: `", body_esc, "`, contentType: '", ct, "', status: ", status, " \}"], "")
}

fn emit_static_route_table_src(routes: List<ServedStaticRoute>) -> String {
  let entries = map(xs: routes, f: r => emit_static_route_entry(route: r))
  join(["[\n", join(entries, ",\n"), "\n]"], "")
}

data node_http_server_handler_src: String = "const server = require('http').createServer((req, res) => \{\n  const method = req.method || 'GET';\n  const rawUrl = req.url || '/';\n  const path = rawUrl.split('?')[0] || '/';\n  for (const route of routes) \{\n    if (route.method === method && route.pathRe.test(path)) \{\n      res.writeHead(route.status, \{ 'Content-Type': route.contentType \});\n      res.end(route.body);\n      return;\n    \}\n  \}\n  const pathRoutes = routes.filter(r => r.pathRe.test(path));\n  if (pathRoutes.length > 0) \{\n    const allow = [...new Set(pathRoutes.map(r => r.method))].join(', ');\n    res.writeHead(405, \{ 'Allow': allow \});\n    res.end('Method Not Allowed');\n    return;\n  \}\n  res.writeHead(404);\n  res.end('Not Found');\n\});\n"

fn emit_node_http_static_server(spec: NodeHttpStaticServerSpec) -> String {
  let port = to_string(spec.listen.port)
  let host = spec.listen.host
  let routes_src = emit_static_route_table_src(routes: spec.routes.routes)
  join([
    "// @ts-nocheck\n",
    "// GENERATED by gunbc from dsl/gunbc/node_http_server_emit.dag\n",
    "const routes = ", routes_src, ";\n",
    node_http_server_handler_src,
    "const PORT = process.env['PORT'] ? parseInt(process.env['PORT'], 10) : ", port, ";\n",
    "const HOST = process.env['HOST'] || '", host, "';\n",
    "server.listen(PORT, HOST, () => \{ process.stdout.write('listening\\n'); \});\n"
  ], "")
}

fn gunbhub_node_http_static_server_spec() -> NodeHttpStaticServerSpec {
  NodeHttpStaticServerSpec {
    service_name: "gunbhub",
    routes: gunbhub_served_static_route_table(),
    listen: HttpServerListenConfig {
      host: "0.0.0.0",
      port: 8080,
    },
  }
}

fn gunbhub_node_http_server_source() -> String {
  emit_node_http_static_server(spec: gunbhub_node_http_static_server_spec())
}

data node_http_server_emit_medium_dissolution_trigger: String = "dissolve-on: Lane-C typescript emit — replace string-concat JS emission with Node server modeled as a TS program tree emitted through grammar rows in extdeps.languages.typescript; medium_structure_exception_roster entry retires at that point"

data gunbhub_node_http_listen_defaults_dissolution_trigger: String = "dissolve-on: fleet_intent host binding — host 0.0.0.0 / port 8080 are provisioning defaults; fleet_intent should supply the listen address and port as deployment facts, not compile-time constants"
