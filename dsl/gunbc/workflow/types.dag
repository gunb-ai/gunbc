// gunbc/workflow/types.dag -- Gunbc workflow domain model.
//
// These types are intentionally not part of std/: they model this repo's
// workflow, review, approval, runtime, and audit domain rather than a
// provider-neutral standard library surface.

module gunbc.workflow.types

import std.types {
  ContentHash,
  FermiDepth,
  FilePath,
  Milliseconds,
  NonEmptyStr,
  Timestamp,
  Url
}

// --- Review model ------------------------------------------------------

type ArtifactKind = Design | Review | Plan | CiReport
type AuthorSource = Llm | Human
// Coproduct receipt: terminal. Semantic source-kind axis for review authorship.
// Unattributed is the fail-closed open case for coordinates that do not map to
// a known Llm/Human/Policy kind.
type ReviewSource = Llm | Human | Policy | Unattributed
type SeverityLevel = Blocking | Suggestion | Info

type ReviewDimension = Coherence | Quality | Requirements | Aspirational

type ReviewConcern {
  dimension: ReviewDimension
  system_prompt_preamble: String
}

type DimensionReviewOutput {
  dimension: ReviewDimension
  output: Json
  errors: Json
}

type MergedReviewOutput {
  output: Json
  summary: String
}

// --- Issue lifecycle ---------------------------------------------------

type IssueLifecycleStage
  = Idea
  | Design
  | DesignReview
  | Accepted
  | Implementing
  | CodeReview
  | Testing
  | Done
  | TerminalFailed

type TrackedIssue {
  id: String
  title: String
  body: String
  stage: IssueLifecycleStage
  url: Url?
  author: String?
  labels: List<String>
  created_at: Timestamp?
  updated_at: Timestamp?
}

type DesignOutput {
  content: String
  summary: String
  source: AuthorSource
  sections: DesignSections?
}

type DesignSections {
  problem: String?
  approach: String?
  interfaces: String?
  risks: List<String>?
  test_plan: String?
  scope: FermiDepth?
}

type DesignReviewOutput {
  findings: List<DesignFinding>
  approved: Bool
  summary: String
  source: ReviewSource
}

type DesignFinding {
  check_id: String
  issue_key: String
  observation: String
  severity: SeverityLevel
  suggestion: String?
}

type ImplementationPlan {
  tasks: List<ImplementationTask>
  estimated_scope: FermiDepth
  summary: String
}

type ImplementationTask {
  title: String
  description: String
  file_paths: List<FilePath>?
  dependencies: List<String>?
  done: Bool = false
}

type PipelineRun {
  issue_id: String
  stages_completed: List<IssueLifecycleStage>
  current_stage: IssueLifecycleStage
  started_at: Timestamp
  updated_at: Timestamp
  artifacts: List<PipelineArtifact>
}

type PipelineArtifact {
  stage: IssueLifecycleStage
  kind: ArtifactKind
  content: String
  url: Url?
}

// --- Workflow state ----------------------------------------------------

type IssueState = Open | Closed

type BindingStatus
  = Active
  | Conflicted
  | Terminated

type IntentSheet {
  intent_id: NonEmptyStr
  intent_version: Int
  title: NonEmptyStr
  body: String
  labels: List<String>
  owner: NonEmptyStr
  repo: NonEmptyStr
  created_at: Timestamp
  metadata: Json?
}

type IssueBinding {
  intent_id: NonEmptyStr
  issue_id: NonEmptyStr
  provider: NonEmptyStr
  created_at: Timestamp
  binding_status: BindingStatus
}

type StageRunKey {
  issue_id: NonEmptyStr
  stage: IssueLifecycleStage
  input_hash: ContentHash
  policy_version: NonEmptyStr
}

type ClaimLease {
  issue_id: NonEmptyStr
  stage: IssueLifecycleStage
  owner: NonEmptyStr
  generation: Int
  acquired_at: Timestamp
  expires_at: Timestamp
  lease_ttl_ms: Milliseconds
}

type OutcomeStatus
  = Success
  | Failed
  | PendingApproval
  | Skipped
  | TerminalFailed

type StageOutcome {
  run_key: NonEmptyStr
  stage: IssueLifecycleStage
  status: OutcomeStatus
  payload: Json?
  error: String?
  attempt_count: Int
  retry_budget_remaining: Int
  next_attempt_at: Timestamp?
  created_at: Timestamp
  updated_at: Timestamp
}

// --- Artifacts ---------------------------------------------------------

type ArtifactType
  = DesignArtifact
  | DesignReviewArtifact
  | ImplementationPlanArtifact
  | CodeDiffArtifact
  | CodeReviewArtifact
  | TestReportArtifact
  | StageSummaryArtifact

type ArtifactPayload
  = Inline { body: String }
  | BlobRef { uri: Url, size_bytes: Int }

type Artifact {
  artifact_id: NonEmptyStr
  run_key: NonEmptyStr
  artifact_type: ArtifactType
  payload: ArtifactPayload
  content_hash: ContentHash
  created_at: Timestamp
}

type MarkerKind
  = Provisional
  | Canonical

type ArtifactMarker {
  run_key: NonEmptyStr
  artifact_type: ArtifactType
  marker_kind: MarkerKind
  content_hash: ContentHash
  lease_generation: Int?
  created_at: Timestamp
}

// --- Signals -----------------------------------------------------------

type SignalType
  = IntentSubmitted { intent_id: NonEmptyStr, intent_version: Int }
  | WorkReady { issue_id: NonEmptyStr, stage: IssueLifecycleStage, stage_epoch: Int }
  | ApprovalGranted { issue_id: NonEmptyStr, stage: IssueLifecycleStage, approval_epoch: Int }
  | RetryDue { issue_id: NonEmptyStr, stage: IssueLifecycleStage, run_key: NonEmptyStr, next_attempt_at: Timestamp }
  | LeaseExpired { issue_id: NonEmptyStr, stage: IssueLifecycleStage, lease_generation: Int }
  | ReconcileTick { window_id: NonEmptyStr }
  | InfraIntentChanged { intent_fingerprint: NonEmptyStr }
  | TerminalStateReached { issue_id: NonEmptyStr, stage: IssueLifecycleStage, run_key: NonEmptyStr }

type Signal {
  signal_type: SignalType
  idempotency_key: NonEmptyStr
  payload: Json
  produced_at: Timestamp
  consumed_at: Timestamp?
}

// --- Runtime / credentials / audit ------------------------------------

type RuntimeProfile
  = LocalCoLocated
  | StatelessFleet

type LaunchConfig {
  worker_count: Int
  drain_flag_path: String?
  drain_flag_url: Url?
}

type InfraIntent {
  schema_version: NonEmptyStr
  runtime_profile: RuntimeProfile
  launch: LaunchConfig
  infra_fingerprint: NonEmptyStr
}

type FailureClass
  = Retryable {
      reason: String
      next_attempt_at: Timestamp
    }
  | NonRetryable { reason: String }
  | Transient { reason: String }

type AgentStatus
  = Pending
  | Running
  | Completed
  | AgentFailed
  | Cancelled
  | TimedOut

type ApprovalMode
  = FullAuto
  | SuggestOnly
  | HumanInLoop

type CredentialIntent
  = GitHubApi
  | AgentExecution
  | LlmApi
  | CloudStorage
  | SecretManagerAccess

type CredentialResolution
  = EnvVar { name: NonEmptyStr }
  | SecretManagerRef { secret_id: NonEmptyStr, project_id: NonEmptyStr }
  | WorkloadIdentity { service_account: NonEmptyStr, scopes: List<String> }

type CredentialBinding {
  intent: CredentialIntent
  resolution: CredentialResolution
}

type ExecutionMetrics {
  run_key: NonEmptyStr
  stage: IssueLifecycleStage
  duration_ms: Milliseconds
  approval_latency_ms: Milliseconds?
  retry_attempts: Int
  llm_cost_units: Float?
  transport_calls: Int
  artifacts_stored: Int
}

type AuditAction
  = Created
  | Updated
  | Deleted
  | TransitionedTo { from_state: String, to_state: String }

type AuditEntry {
  timestamp: Timestamp
  actor: NonEmptyStr
  action: AuditAction
  entity_type: NonEmptyStr
  entity_id: NonEmptyStr
  before: Json?
  after: Json?
}
