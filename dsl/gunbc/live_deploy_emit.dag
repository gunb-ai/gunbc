module gunbc.live_deploy_emit

import std.types { String, List, Bool, NonEmptyStr, Int }
import std.layout {
  Doc, DocConcat,
  LayoutProtocol,
  doc_concat, doc_line_of,
  render
}
import gunbc.live_deploy {
  LiveDeployPlan,
  LiveDeployPackageDependency,
  live_deploy_plan_srv1,
  live_deploy_plan_listen_port,
}
import gunbc.node_http_server_emit { gunbhub_node_http_server_source }

data live_deploy_protocol: LayoutProtocol = LayoutProtocol { indent_unit: "" }

fn sh_arg(s: String) -> String {
  concat(concat("\"", s), "\"")
}

fn ensure_apt_package_line(dep: LiveDeployPackageDependency) -> String {
  concat(
    concat(
      concat("ensure_apt_package ", sh_arg(s: dep.package)),
      concat(" # idempotent: dpkg -s ", dep.package)
    ),
    ""
  )
}

fn emit_systemd_unit_doc(plan: LiveDeployPlan) -> Doc {
  let svc = plan.service
  let port = to_string(svc.listen.port)
  let host = svc.listen.host
  let unit = svc.unit_name
  let install_dir = svc.install_dir
  let entry = svc.server_entry
  doc_concat(parts: [
    doc_line_of(text: "[Unit]"),
    doc_line_of(text: "Description=gunbc roadmap HTTP server"),
    doc_line_of(text: "After=network-online.target tailscaled.service"),
    doc_line_of(text: "Wants=network-online.target"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Service]"),
    doc_line_of(text: "Type=simple"),
    doc_line_of(text: concat("Environment=PORT=", port)),
    doc_line_of(text: concat("Environment=HOST=", host)),
    doc_line_of(text: concat("WorkingDirectory=", install_dir)),
    doc_line_of(text: concat("ExecStart=/usr/bin/node ", concat(install_dir, concat("/", entry)))),
    doc_line_of(text: "Restart=on-failure"),
    doc_line_of(text: ""),
    doc_line_of(text: "[Install]"),
    doc_line_of(text: "WantedBy=multi-user.target"),
    doc_line_of(text: concat("# unit_path=/etc/systemd/system/", unit)),
  ])
}

fn emit_remote_deploy_body(plan: LiveDeployPlan) -> Doc {
  let svc = plan.service
  let port = live_deploy_plan_listen_port(plan: plan)
  let dep_lines = map(plan.dependencies, d => doc_line_of(text: ensure_apt_package_line(dep: d)))
  doc_concat(parts: concat(
    [
      doc_line_of(text: "set -euo pipefail"),
      doc_line_of(text: concat("# GENERATED by dsl/gunbc/live_deploy_emit.dag for host=", plan.target.host.identity)),
      doc_line_of(text: ""),
      doc_line_of(text: "ensure_apt_package() {"),
      doc_line_of(text: "  local pkg=\"$1\""),
      doc_line_of(text: "  if ! dpkg -s \"$pkg\" >/dev/null 2>&1; then"),
      doc_line_of(text: "    apt-get install -y \"$pkg\""),
      doc_line_of(text: "  fi"),
      doc_line_of(text: "}"),
      doc_line_of(text: ""),
    ],
    dep_lines,
    [
      doc_line_of(text: ""),
      doc_line_of(text: concat("install -d -m 0755 ", svc.install_dir)),
      doc_line_of(text: concat("cat > ", concat(svc.install_dir, concat("/", svc.server_entry)), " <<'GUNBC_SERVER_EOF'")),
      doc_line_of(text: gunbhub_node_http_server_source()),
      doc_line_of(text: "GUNBC_SERVER_EOF"),
      doc_line_of(text: ""),
      doc_line_of(text: concat("cat > /etc/systemd/system/", svc.unit_name, " <<'GUNBC_UNIT_EOF'")),
    ],
    [
      emit_systemd_unit_doc(plan: plan),
      doc_line_of(text: "GUNBC_UNIT_EOF"),
      doc_line_of(text: ""),
      doc_line_of(text: "systemctl daemon-reload"),
      doc_line_of(text: concat("systemctl enable --now ", svc.unit_name)),
      doc_line_of(text: ""),
      doc_line_of(text: concat("# tailscale serve: expose local port ", to_string(port), " on the tailnet (idempotent)")),
      doc_line_of(text: concat("if ! tailscale serve status 2>/dev/null | grep -q ':", to_string(port), "'; then")),
      doc_line_of(text: concat("  tailscale serve --bg ", to_string(port))),
      doc_line_of(text: "fi"),
      doc_line_of(text: concat("echo live-deploy-receipt host=", plan.target.host.identity, " verdict=converged")),
    ]
  ))
}

fn live_deploy_remote_script_for(plan: LiveDeployPlan) -> String {
  render(doc: emit_remote_deploy_body(plan: plan), proto: live_deploy_protocol)
}

fn expected_live_deploy_remote_script() -> String {
  live_deploy_remote_script_for(plan: live_deploy_plan_srv1())
}

fn live_deploy_remote_script_drifted(committed: String) -> Bool {
  !(committed == expected_live_deploy_remote_script())
}

fn live_deploy_systemd_unit_for(plan: LiveDeployPlan) -> String {
  render(doc: emit_systemd_unit_doc(plan: plan), proto: live_deploy_protocol)
}

fn live_deploy_orchestration_ssh_script(plan: LiveDeployPlan) -> String {
  let remote = live_deploy_remote_script_for(plan: plan)
  let host = plan.target.ssh_host
  concat(
    concat("ssh ", host),
    concat(" ", sh_arg(s: remote))
  )
}
