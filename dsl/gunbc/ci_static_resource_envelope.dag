module gunbc.ci_static_resource_envelope

import gunbc.ci_input_envelope {
  InputEnvelope,
  InputBound,
  InputSizeAxis,
  WitnessCount,
  SourceNodeCount,
  CorpusNodeCount,
  BoundedInput,
  EnvelopeUnknown,
  find_input_bound_for_axis,
  gunbc_ci_corpus_envelope,
}
import gunbc.ci_floor_measurement {
  gunbc_ci_floor_per_shard_peak_rss_bytes,
  gunbc_ci_floor_execution_corpus_per_witness_rss,
}
import std.measure {
  byte_size,
  byte_size_count,
  hardware_thread_count,
  hardware_thread_count_value,
  watt,
}
import std.nat { Nat }
import std.types { List }
import std.static_resource_envelope {
  DeclaredSizeBound,
  PerUnitPeakCost,
  StaticResourcePeak,
  static_peak_from_declared_sizes,
  peak_from_runnable_profile,
  runnable_static_peak,
  Runnable,
}

fn declared_size_bound_from_envelope(envelope: InputEnvelope) -> DeclaredSizeBound? {
  match envelope {
    EnvelopeUnknown => none
    BoundedInput { bounds: declared } =>
      let witness = match find_input_bound_for_axis(declared: declared, axis: WitnessCount) {
        Absent => 0
        Present { value: b } => b.max.count
      }
      let source = match find_input_bound_for_axis(declared: declared, axis: SourceNodeCount) {
        Absent => 0
        Present { value: b } => b.max.count
      }
      let corpus = match find_input_bound_for_axis(declared: declared, axis: CorpusNodeCount) {
        Absent => 0
        Present { value: b } => b.max.count
      }
      Present {
        value: DeclaredSizeBound {
          witness_count: witness
          source_node_count: source
          corpus_node_count: corpus
        }
      }
  }
}

fn ci_floor_per_unit_peak_cost() -> PerUnitPeakCost {
  PerUnitPeakCost {
    per_witness_memory: gunbc_ci_floor_execution_corpus_per_witness_rss
    per_source_node_memory: byte_size(count: 0)
    per_corpus_node_memory: byte_size(count: 0)
    per_witness_compute: hardware_thread_count(count: 1)
    per_witness_storage: byte_size(count: 0)
    per_witness_energy: watt(count: 0)
  }
}

fn ci_resolve_per_unit_peak_cost() -> PerUnitPeakCost {
  PerUnitPeakCost {
    per_witness_memory: byte_size(count: 0)
    per_source_node_memory: byte_size(count: 0)
    per_corpus_node_memory: byte_size(count: 0)
    per_witness_compute: hardware_thread_count(count: 1)
    per_witness_storage: byte_size(count: 0)
    per_witness_energy: watt(count: 0)
  }
}

fn static_peak_from_ci_corpus_envelope(envelope: InputEnvelope) -> StaticResourcePeak? {
  match declared_size_bound_from_envelope(envelope: envelope) {
    Absent => none
    Present { value: sizes } =>
      Present {
        value: static_peak_from_declared_sizes(
          sizes: sizes,
          unit: ci_floor_per_unit_peak_cost()
        )
      }
  }
}

fn witness_ci_corpus_envelope_derives_peak() -> Bool {
  match static_peak_from_ci_corpus_envelope(envelope: gunbc_ci_corpus_envelope) {
    Absent => false
    Present { value: peak } =>
      byte_size_count(b: peak.memory) > 0
        && hardware_thread_count_value(t: peak.compute) > 0
  }
}

fn witness_envelope_unknown_refuses_peak_derivation() -> Bool {
  match static_peak_from_ci_corpus_envelope(envelope: EnvelopeUnknown) {
    Absent => true
    Present { value: _ } => false
  }
}

fn ci_floor_resolve_peak() -> StaticResourcePeak {
  static_peak_from_declared_sizes(
    sizes: DeclaredSizeBound {
      witness_count: 0
      source_node_count: 0
      corpus_node_count: 0
    },
    unit: PerUnitPeakCost {
      per_witness_memory: gunbc_ci_floor_per_shard_peak_rss_bytes()
      per_source_node_memory: byte_size(count: 0)
      per_corpus_node_memory: byte_size(count: 0)
      per_witness_compute: hardware_thread_count(count: 1)
      per_witness_storage: byte_size(count: 0)
      per_witness_energy: watt(count: 0)
    }
  )
}
