  VmSlotIndexEndpoint,
  bmcweb_nbd_proxy_ws_path,
}
import extdeps.bmc.webui.nbd_proxy_serve {
  NbdProxyServeTransportIntent,
  nbd_proxy_serve_transport_intent,
  nbd_proxy_serve_script,
  bmcweb_session_login_program,
  srv3_nbd_proxy_local_port,
}
import extdeps.languages.bash.program { serialize_bash }
import gunbc.srv3_os_install_actuate_scope { srv3_actuator_virtual_media_iso_install_path }
import gunbc.srv3_bmc_credential_resolve {
  srv3_os_install_actuate_credential_intent,
  observe_and_resolve_srv3_bmc_credential,
  materialize_bmc_login_password,
  bmcweb_login_body_content,
