// gunbc/ci.dag — CI gate declarations derived from compiler.dag.
//
// Every gate command traces back to gunbc.compiler facts. Changing the
// crate name or source roots in compiler.dag updates all gates
// automatically. No hardcoded crate names in this file.
//
// The two script gates (l1, freshness) will become dag run invocations
// once tools/ratchet.dag and tools/freshness.dag are proven.
//
// Consumers:
//   .github/workflows/ci.yml     -- current transport (hand-maintained shim)
//   future: dag run ci_pipeline  -- interpreter execution of gates

module gunbc.ci

import gunbc.compiler {
  compiler_cycle, test_package,
  lint_command, test_command, ignored_test_command
}

// ── Gate types ──────────────────────────────────────────────────────

type CIGate {
  name: String
  command: String
  blocking: Bool
}

type CIPipeline {
  name: String
  gates: List<CIGate>
}

// ── Gates ───────────────────────────────────────────────────────────
// Commands derive from compiler.dag. Sustainability test: change
// package_name in compiler.dag → every gate picks it up.

data lint_gate: CIGate = {
  name: "Lint",
  command: lint_command(),
  blocking: true
}

data test_gate: CIGate = {
  name: "Tests",
  command: test_command(package: test_package),
  blocking: true
}

data full_dsl_gate: CIGate = {
  name: "Full DSL Compiles",
  command: ignored_test_command(package: test_package, test_name: "full_dsl_compiles"),
  blocking: true
}

data diagnostic_ratchet_gate: CIGate = {
  name: "Diagnostic Ratchet",
  command: ignored_test_command(package: test_package, test_name: "strict_compile_diagnostic_count"),
  blocking: false
}

// Script gates — will become dag run invocations when tools are proven.

data l1_gate: CIGate = {
  name: "L1 Type Knowledge Ratchet",
  command: "scripts/l1-ratchet.sh --check",
  blocking: true
}

data stage0_freshness_gate: CIGate = {
  name: "Stage0 Freshness",
  command: "scripts/check-stage0-freshness.sh",
  blocking: true
}

// Test gates derived from compiler.dag.

data performance_ratchet_gate: CIGate = {
  name: "Performance Ratchet",
  command: ignored_test_command(package: test_package, test_name: "performance_ratchet"),
  blocking: true
}

data bootstrap_fixed_point_gate: CIGate = {
  name: "Bootstrap Fixed Point",
  command: ignored_test_command(package: test_package, test_name: "bootstrap_fixed_point"),
  blocking: true
}

// ── Pipeline assembly ───────────────────────────────────────────────

data ci_pipeline: CIPipeline = {
  name: "gunbc-ci",
  gates: [
    lint_gate,
    test_gate,
    full_dsl_gate,
    diagnostic_ratchet_gate,
    l1_gate,
    stage0_freshness_gate,
    performance_ratchet_gate,
    bootstrap_fixed_point_gate
  ]
}
