// gunbc/ci.dag -- CI gate declarations for the gunbc project.
//
// Models the CI pipeline as .dag declarations so that adding a new
// feature automatically produces CI coverage (upsert semantics).
// YAML is a transport constraint (GitHub requires it), not the CI
// logic. This file IS the CI logic.
//
// M5 Phase 2b: CI intent declarations.
//
// Consumers:
//   .github/workflows/ci.yml     -- current transport (hand-maintained shim)
//   future: dag run ci.dag       -- interpreter execution of gates

module gunbc.ci

// -- Gate source: what a gate checks ------------------------------------

type RatchetDirection = Down | Stable

type GateSource
  = LintGate
  | TestSuiteGate { test_pattern: String }
  | RatchetGate {
      metric: String
      direction: RatchetDirection
      threshold: Int
    }
  | FreshnessGate { generated_files: List<String> }

// -- Gate result --------------------------------------------------------

type GateResult
  = Pass
  | Fail { detail: String }

// -- Gate declaration ---------------------------------------------------

type CIGate {
  name: String
  command: String
  blocking: Bool
  source: GateSource
}

// -- Pipeline -----------------------------------------------------------

type CIPipeline {
  name: String
  gates: List<CIGate>
}

// -- Declared gates -----------------------------------------------------

data lint_gate: CIGate = {
  name: "Lint",
  command: "cargo clippy --workspace -- -D warnings",
  blocking: true,
  source: LintGate
}

data test_gate: CIGate = {
  name: "Tests",
  command: "cargo test -p v2-compiler-tests",
  blocking: true,
  source: TestSuiteGate { test_pattern: "" }
}

data full_dsl_gate: CIGate = {
  name: "Full DSL Compiles",
  command: "cargo test -p v2-compiler-tests full_dsl_compiles -- --ignored --nocapture",
  blocking: true,
  source: TestSuiteGate { test_pattern: "full_dsl_compiles" }
}

data diagnostic_ratchet_gate: CIGate = {
  name: "Diagnostic Ratchet",
  command: "cargo test -p v2-compiler-tests strict_compile_diagnostic_count -- --ignored --nocapture",
  blocking: false,
  source: RatchetGate { metric: "diagnostics", direction: Down, threshold: 424 }
}

data l1_gate: CIGate = {
  name: "L1 Type Knowledge Ratchet",
  command: "scripts/l1-ratchet.sh --check",
  blocking: true,
  source: RatchetGate { metric: "l1_type_knowledge", direction: Stable, threshold: 0 }
}

data stage0_freshness_gate: CIGate = {
  name: "Stage0 Freshness",
  command: "scripts/check-stage0-freshness.sh",
  blocking: true,
  source: FreshnessGate { generated_files: ["src/v2/stage0/src/"] }
}

data performance_ratchet_gate: CIGate = {
  name: "Performance Ratchet",
  command: "cargo test -p v2-compiler-tests performance_ratchet -- --ignored --nocapture",
  blocking: true,
  source: RatchetGate { metric: "performance", direction: Stable, threshold: 0 }
}

data bootstrap_fixed_point_gate: CIGate = {
  name: "Bootstrap Fixed Point",
  command: "cargo test -p v2-compiler-tests bootstrap_fixed_point -- --ignored --nocapture",
  blocking: true,
  source: TestSuiteGate { test_pattern: "bootstrap_fixed_point" }
}

// -- Pipeline assembly --------------------------------------------------

data ci_pipeline: CIPipeline = {
  name: "gunbc-ci",
  gates: [
    lint_gate,
    test_gate,
    full_dsl_gate,
    diagnostic_ratchet_gate,
    l1_gate,
    stage0_freshness_gate,
    performance_ratchet_gate,
    bootstrap_fixed_point_gate
  ]
}
