// gunbc/ci.dag — CI gate declarations with structural gate kind.
//
// Every gate command derives from gunbc.compiler facts. Commands are
// still string-typed (that's the transport) but each gate carries a
// structural GateSource variant that names what the gate actually
// proves — lint / test / ratchet / freshness / fixed-point. The closed
// GateSource coproduct makes it possible to reason about gate kind
// without parsing command strings.
//
// Tool resolution: gate commands are constructed with resolved cargo
// path as input. A future dag run of the pipeline would resolve tools
// once at the top, then build gate commands from the resolved set.
// For the current CI transport (ci.yml shim), commands are assembled
// lazily inside the interpreter or pre-rendered with `cargo` bare name
// since CI runners have cargo on PATH by convention.
//
// The two script gates (l1, freshness) will become dag run invocations
// once tools/ratchet.dag and tools/freshness.dag execute reliably in
// any environment (blocked on tool upsert landing end-to-end).
//
// Consumers:
//   .github/workflows/ci.yml     -- hand-maintained Actions transport + faithful mirror below
//   gunbc_ci_yml_workflow (Workflow from extdeps.github.actions) — T-WAD R3 WI-2 full ci.yml data
//   future: dag run ci_pipeline  -- interpreter execution of compiler-intent gates
//
// Dual authority (transitional): `ci.yml` stays human-edited until WI-1 emitter dispatch
//   (`docs/design-ci-workflow-emitter-dispatch.md`, still-heron-763) lands and can own generation;
//   then either (i) `ci.yml` becomes emitted-only and this `Workflow` data is the structural source
//   for Actions YAML, or (ii) Director ratifies gate #56 / PR #2736 neutral DAG supersedes this layer
//   — remove the stale bullet from this file when that decision closes.
//
// QUESTION ratify-via-Mgr: Workflow-shaped `data` placement (vs sibling emitter dispatch doc
//   still-heron-763 / WI-1) — resolve on canvas if emitter routing conflicts.
//
// Transitional — empty `env` on Job / Step (`Map<String, String>` in actions.dag):
//   Sites with no workflow env vars use `env: { _wi2_empty_env: "" }` because v3 surface grammar
//   cannot express an empty string map in record fields today: `{}` parses as an empty *record*, not
//   an empty `Map`, and fails shape check (same deferral as `src/v3/std/anthropic_operations.dag`
//   §EXPLICIT DEFERRAL §1 / #1133). This key MUST NOT appear in emitted YAML: treat as empty map for
//   GHA `env:` blocks. Dissolution: land nested / empty `Map<String, String>` literals (or an
//   authoritative `empty_map` binding usable here), then sweep every `_wi2_empty_env` row to the real
//   empty form and delete this bullet.

module gunbc.ci

import std.list { List, Empty, Cons }
import extdeps.github.actions {
  Workflow,
  Job,
  Step,
  RunStep,
  UsesStep,
  HostedRunner,
  SelfHosted,
  UbuntuLatest,
  Push,
  PullRequest,
  Opened,
  Synchronize,
  Reopened,
  checkout_action,
  setup_rust_action,
  cache_action,
  WorkflowPermissions,
  PermRead,
  PermNone,
  Bash,
  ActionRef
}
import gunbc.compiler {
  compiler_cycle, test_package,
  lint_command, test_command, ignored_test_command
}

// ── Ratchet kind ────────────────────────────────────────────────────

// Direction of a ratchet gate. Down = monotonically decreasing (we
// track regressions); Stable = must remain at the threshold value.
type RatchetDirection = Down | Stable

// Closed set of ratchet metrics — no opaque strings. Each corresponds
// to a specific measurement the compiler produces or a script computes.
// Adding a new ratchet is a new variant, not a new string.
type RatchetMetric
  = DiagnosticCount       // total compile-time diagnostics (CX)
  | L1TypeKnowledge       // type constructors and name comparisons in .dag
  | Performance           // self-compile pipeline duration
  | FixedPointConvergence // bootstrap stage1 == stage2

// ── Gate kind ───────────────────────────────────────────────────────

// What a gate is structurally. Closed coproduct — every variant is a
// category of gate with its own invariant. Consumers that need to
// reason about gate category (e.g., "how many ratchet gates are there?")
// pattern-match on this rather than parsing command strings.
//
// RatchetGate intentionally does NOT carry a threshold value. The
// numeric threshold is enforced by whatever runs the gate (a Rust test
// const, a shell script comparison). Duplicating it here would create
// a second authority that drifts (the original ci.dag had 424, while
// the bootstrap test had 354 — exactly the kind of dual-authority
// problem the invariants forbid). The structural fact is "this is a
// ratchet on metric M with direction D"; the threshold value is
// operational data that lives with the enforcer.
type GateSource
  = LintGate
  | TestSuiteGate { test_name: String }  // empty means run all tests
  | RatchetGate { metric: RatchetMetric, direction: RatchetDirection }
  | FreshnessGate                        // proves committed stage0 == compile(source)
  | FixedPointGate                       // proves regen(regen(source)) == regen(source)

type CIGate {
  name: String
  command: String
  blocking: Bool
  source: GateSource
}

type CIPipeline {
  name: String
  gates: List<CIGate>
}

// ── Gates ───────────────────────────────────────────────────────────
// Commands are derived from compiler.dag; commands use bare "cargo"
// because CI runners always have cargo on PATH. For local dag run,
// tools/*.dag workflows resolve the absolute path via extdeps.tools.
// Sustainability test: changing package_name in compiler.dag updates
// all gate commands automatically.

data lint_gate: CIGate = {
  name: "Lint",
  command: lint_command(cargo: "cargo"),
  blocking: true,
  source: LintGate
}

data test_gate: CIGate = {
  name: "Tests",
  command: test_command(cargo: "cargo", package: test_package),
  blocking: true,
  source: TestSuiteGate { test_name: "" }
}

// Script gates — will become `dag run` invocations once the tool
// workflows execute reliably in any environment.

data l1_gate: CIGate = {
  name: "L1 Type Knowledge Ratchet",
  command: "scripts/l1-ratchet.sh --check",
  blocking: true,
  source: RatchetGate { metric: L1TypeKnowledge, direction: Stable }
}

// Consolidated compile gate — 4 hermetic tests sharing a single
// compilation via LazyLock (ci_diagnostic_ratchet, ci_performance_ratchet,
// ci_freshness, ci_fixed_point). Run in one process via prefix match.
// Pass 1 compiles once for diagnostic/perf/freshness checks;
// pass 2 builds stage1 and compiles again for fixed-point.
// Replaces 4 separate gates that each independently built + compiled
// (6 self-compiles → 2).

data compile_gates_gate: CIGate = {
  name: "Compile Gates",
  command: ignored_test_command(cargo: "cargo", package: test_package, test_name: "ci_"),
  blocking: true,
  source: FixedPointGate
}

// ── Pipeline assembly ───────────────────────────────────────────────

data ci_pipeline: CIPipeline = {
  name: "gunbc-ci",
  // compile_gates first: build_stage0() hits the clean release cache
  // from ci.yml's Build Compiler step. Running clippy before this would
  // invalidate cargo's release fingerprints, forcing a full rebuild.
  gates: [
    compile_gates_gate,
    lint_gate,
    test_gate,
    l1_gate
  ]
}

// ── GitHub Actions workflow mirror (`.github/workflows/ci.yml`) ──────────────
// Hierarchy: Workflow > Job > Step (RunStep | UsesStep). Structural TODOs:
// workflow `concurrency:`, job `outputs:`, step `id:`, PullRequest `ready_for_review`,
// Layer-2 `if:` regex cluster, affected-set wiring — see header on slice dissolution.

data gunbc_ci_yml_workflow: Workflow = Workflow {
  name: "ci",
  on: Cons {
  head: Push { branches: Cons { head: "main", tail: Empty }, paths: Empty },
  tail: Cons {
    head: PullRequest {
      branches: Cons { head: "main", tail: Empty },
      types: Cons {
        head: Opened,
        tail: Cons { head: Synchronize, tail: Cons { head: Reopened, tail: Empty } }
      }
    },
    tail: Empty
  }
},
  jobs:         Cons {
          head:         Job {
          id: "fmt",
          name: none,
          runner: HostedRunner { label: UbuntuLatest },
          steps:         Cons {
          head: UsesStep {
  name: none,
  uses: checkout_action,
  with: { fetch_depth: "1" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none
},
          tail:         Cons {
          head: UsesStep {
  name: none,
  uses: setup_rust_action,
  with: { components: "rustfmt", cache: "false", rustflags: "" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none
},
          tail:         Cons {
          head: RunStep {
  name: none,
  run: "cargo fmt --all --check",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none
},
          tail: Empty
        }
        }
        },
          needs: Empty,
          env: { _wi2_empty_env: "" },
          if_condition: "github.event.pull_request.draft != true",
          strategy: none,
          timeout_minutes: 5,
          continue_on_error: false,
          concurrency: none
        },
          tail:         Cons {
          head:         Job {
          id: "ci",
          name: none,
          runner: HostedRunner { label: UbuntuLatest },
          steps:         Cons {
          head: UsesStep {
  name: none,
  uses: checkout_action,
  with: { fetch_depth: "0" },
  env: { _wi2_empty_env: "" },
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none
},
          tail:         Cons {
          head: RunStep {
  name: none,
  run: "git fetch origin main:refs/remotes/origin/main",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: "github.event_name == 'pull_request'",
  continue_on_error: false,
  timeout_minutes: none
},
          tail:         Cons {
          head: RunStep {
  name: none,
  run: "bash scripts/check-pr-sg0-net-shrink-discipline.sh --self-test",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none
},
          tail:         Cons {
          head: RunStep {
  name: none,
  run: "body=\"${PR_BODY}\"\nappend_file=\"scripts/ci-merge/sg0-pr-body-append.${{ github.event.pull_request.number }}.txt\"\nif [ -f \"${append_file}\" ]; then\n  body=\"$(cat \"${append_file}\")\"$'\\n\\n'\"${body}\"\nfi\nPR_BODY=\"${body}\" bash scripts/check-pr-sg0-net-shrink-discipline.sh",
  shell: Bash,
  env: { PR_BODY: "${{ github.event.pull_request.body }}" },
  working_directory: none,
  if_condition: "github.event_name == 'pull_request'",
  continue_on_error: false,
  timeout_minutes: none
},
          tail:         Cons {
          head: RunStep {
  name: none,
  run: "bash scripts/check-r4-carve-dissolution-discipline.sh --self-test",
  shell: Bash,
  env: { _wi2_empty_env: "" },
  working_directory: none,
  if_condition: none,
  continue_on_error: false,
  timeout_minutes: none
},
          tail:         Cons {
          head: RunStep {
  name: none,
  run: "bash scripts/check-r4-carve-dissolution-discipline.sh",
