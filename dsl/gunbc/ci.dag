// gunbc/ci.dag — CI gate declarations with structural gate kind.
//
// Every gate command derives from gunbc.compiler facts. Commands are
// still string-typed at the transport boundary but each gate carries a
// structural GateSource variant that names what the gate actually
// proves. The closed GateSource coproduct makes it possible to reason
// about gate kind without parsing command strings.
//
// Floor membership (operator-locked): three blocking gates —
// dsl compile-clean, fmt, v4_lens_gate. Demoted gates still run+log
// but do not fail the pipeline. Deleted jobs (doc_refs, affected_timings,
// timeout_budgets) are absent from this model.
//
// Consumers:
//   dsl/gunbc/tools/ci_runner.dag — runtime execution via run_ci_pipeline()
//   .github/workflows/ci.yml — thin shim (checkout + run_ci_pipeline)
//   dsl/gunbc/ci_emission.dag — BinaryShim workflow projection

module gunbc.ci

import std.list { List }
import std.types { FilePath }

type SourceRoot {
  path: FilePath
}

data dsl_root: SourceRoot = { path: "dsl" }

// ── Gate kind ───────────────────────────────────────────────────────

// Closed coproduct — every variant names a category of CI proof.
type GateSource
  = DslCompileCleanGate { root: SourceRoot }
  | FmtGate
  | LensWitnessGate
  | DagParityGate
  | NodeFrontierGate
  | LensPerturbGate
  | CorpusEnrollmentGate { shard: CorpusShard }
  | LayeringImportsGate
  | FreshnessGate
  | FullTreeEmitGate

type CorpusShard = ShardA | ShardB

// ── Command carrier ─────────────────────────────────────────────────

// Structural command intent — rendered to shell by render_ci_command().
type CICommand
  = DslCompileCleanCommand { root: SourceRoot }
  | FmtCommand
  | LensWitnessCommand
  | DagParityCommand
  | NodeFrontierCommand
  | LensPerturbCommand
  | CorpusEnrollmentCommand { shard: CorpusShard }
  | LayeringImportsCommand
  | FreshnessVerifyCommand
  | FullTreeEmitCommand

type CIGate {
  id: String
  name: String
  command: CICommand
  blocking: Bool
  source: GateSource
}

type CIPipeline {
  name: String
  gates: List<CIGate>
}

type CIGateEdge {
  from: CIGate
  to: CIGate
}

type CIWorkflowDag {
  pipeline: CIPipeline
  edges: List<CIGateEdge>
}

// ── Command rendering ─────────────────────────────────────────────────
// Shell transport derived from structural command variants.

fn ensure_gunbc_binary() -> String {
  "test -x target/release/gunbc || cargo build -p v2-compiler --release"
}

fn ensure_ci_claim_gate_binary() -> String {
  "test -x target/release/ci-claim-gate || cargo build -p ci_claim_gate --release"
}

fn ensure_claim_batch_binary() -> String {
  "test -x target/release/claim_batch || cargo build -p v2-compiler --release --bin claim_batch"
}

fn ensure_discover_owned_data_binary() -> String {
  "test -x target/release/discover_owned_data || cargo build -p v2-compiler --release --bin discover_owned_data"
}

fn dsl_compile_clean_shell(root: SourceRoot) -> String {
  concat(
    ensure_gunbc_binary(), "; ",
    "target/release/gunbc run --source-root ", root.path,
    " --entry dsl/gunbc/tools/ci_runner.dag --function ci_floor_parse_check --claim-run"
  )
}

fn render_ci_command(cmd: CICommand) -> String {
  match cmd {
    DslCompileCleanCommand { root: r } => dsl_compile_clean_shell(root: r)
    FmtCommand => "cargo fmt --all --check"
    LensWitnessCommand => concat(
      ensure_gunbc_binary(), "; ",
      ensure_ci_claim_gate_binary(), "; ",
      ensure_claim_batch_binary(), "; ",
      ensure_discover_owned_data_binary(), "; ",
      "bash scripts/v4-lens-ci-gate.sh --perturb-check && ",
      "bash scripts/v4-substrate-equivalence-gate.sh --perturb-check"
    )
    DagParityCommand => concat(
      ensure_gunbc_binary(), "; ",
      "cargo test -p v2-compiler-tests --release pipeline::dag_emit_from_resolved_matches_compile_sources_for_v4_slice -- --exact --quiet && ",
      "cargo test -p v3-compiler --test integration get_off_v3_compile_to_dag_census_test::get_off_v3_compile_to_dag_caller_count_is_at_or_below_ceiling -- --exact --quiet && ",
      "cargo test -p v2-compiler-tests --release resolve_typed_cache_equivalence_test::typed_module_cache_matches_cold_oracle_in_every_order -- --exact --quiet && ",
      "cargo test -p v2-compiler-tests --release resolve_cross_process_cache_test -- --quiet"
    )
    NodeFrontierCommand => concat(
      ensure_gunbc_binary(), "; ",
      ensure_ci_claim_gate_binary(), "; ",
      ensure_claim_batch_binary(), "; ",
      "bash scripts/v4-affected-set-node-frontier-gate.sh --green-only && ",
      "bash scripts/v4-probe-selector-keystone-gate.sh --perturb-check && ",
      "bash scripts/v4-batch-executor-gate.sh --perturb-check"
    )
    LensPerturbCommand => concat(
      ensure_gunbc_binary(), "; ",
      "bash scripts/v4-affected-set-node-frontier-gate.sh --perturb-shard 0 4 && ",
      "bash scripts/v4-affected-set-node-frontier-gate.sh --perturb-shard 1 4 && ",
      "bash scripts/v4-affected-set-node-frontier-gate.sh --perturb-shard 2 4 && ",
      "bash scripts/v4-affected-set-node-frontier-gate.sh --perturb-shard 3 4"
    )
    CorpusEnrollmentCommand { shard: ShardA } => concat(
      ensure_gunbc_binary(), "; ",
      ensure_claim_batch_binary(), "; ",
      "bash scripts/v4-claim-witness-corpus-gate.sh --shard a --spot-perturb-check"
    )
    CorpusEnrollmentCommand { shard: ShardB } => concat(
      ensure_gunbc_binary(), "; ",
      ensure_claim_batch_binary(), "; ",
      "bash scripts/v4-claim-witness-corpus-gate.sh --shard b --spot-perturb-check"
    )
    LayeringImportsCommand => concat(
      ensure_gunbc_binary(), "; ",
      ensure_ci_claim_gate_binary(), "; ",
      "cargo build -p layering_imports_scan --release; ",
      "bash scripts/v4-layering-imports-gate.sh --perturb-check"
    )
    FreshnessVerifyCommand => concat(
      ensure_gunbc_binary(), "; ",
      "cargo run --release -p v2-compiler --bin regen_stage0 -- --verify"
    )
    FullTreeEmitCommand => concat(
      ensure_gunbc_binary(), "; ",
      "bash .github/ci-floor/v4-rust-full-tree-emit-probe.sh"
    )
  }
}

// ── Gates ───────────────────────────────────────────────────────────

// BLOCKING FLOOR (operator-locked): three gates.

data dsl_compile_clean_gate: CIGate = {
  id: "dsl-compile-clean",
  name: "DSL compile-clean",
  command: DslCompileCleanCommand { root: dsl_root },
  blocking: true,
  source: DslCompileCleanGate { root: dsl_root }
}

data fmt_gate: CIGate = {
  id: "fmt",
  name: "cargo fmt",
  command: FmtCommand,
  blocking: true,
  source: FmtGate
}

data v4_lens_gate: CIGate = {
  id: "v4-lens-gate",
  name: "v4 lens witnesses",
  command: LensWitnessCommand,
  blocking: true,
  source: LensWitnessGate
}

// DEMOTED — still run+log, blocking:false.

data ci_floor_parity_gate: CIGate = {
  id: "ci-floor-parity",
  name: "DAG parity + census ratchet",
  command: DagParityCommand,
  blocking: false,
  source: DagParityGate
}

data v4_lens_ci_gate: CIGate = {
  id: "v4-lens-ci",
  name: "node-frontier GREEN witnesses",
  command: NodeFrontierCommand,
  blocking: false,
  source: NodeFrontierGate
}

data v4_lens_ci_perturb_gate: CIGate = {
  id: "v4-lens-ci-perturb",
  name: "node-frontier PERTURB shards",
  command: LensPerturbCommand,
  blocking: false,
  source: LensPerturbGate
}

data v4_claim_witness_corpus_a_gate: CIGate = {
  id: "v4-claim-witness-corpus-a",
  name: "claim-witness corpus shard a",
  command: CorpusEnrollmentCommand { shard: ShardA },
  blocking: false,
  source: CorpusEnrollmentGate { shard: ShardA }
}

data v4_claim_witness_corpus_b_gate: CIGate = {
  id: "v4-claim-witness-corpus-b",
  name: "claim-witness corpus shard b",
  command: CorpusEnrollmentCommand { shard: ShardB },
  blocking: false,
  source: CorpusEnrollmentGate { shard: ShardB }
}

data layering_imports_gate: CIGate = {
  id: "layering-imports",
  name: "cross-layer import gate",
  command: LayeringImportsCommand,
  blocking: false,
  source: LayeringImportsGate
}

// VERIFY-THEN-DELETE candidates — demoted pending subsumption proof.

data ci_floor_freshness_gate: CIGate = {
  id: "ci-floor-freshness",
  name: "stage0 freshness",
  command: FreshnessVerifyCommand,
  blocking: false,
  source: FreshnessGate
}

data ci_floor_emit_gate: CIGate = {
  id: "ci-floor-emit",
  name: "M1 rust+dag full-tree emit",
  command: FullTreeEmitCommand,
  blocking: false,
  source: FullTreeEmitGate
}

// ── Pipeline assembly ───────────────────────────────────────────────

data ci_pipeline: CIPipeline = {
  name: "gunbc-ci",
  gates: [
    dsl_compile_clean_gate,
    fmt_gate,
    v4_lens_gate,
    ci_floor_parity_gate,
    v4_lens_ci_gate,
    v4_lens_ci_perturb_gate,
    v4_claim_witness_corpus_a_gate,
    v4_claim_witness_corpus_b_gate,
    layering_imports_gate,
    ci_floor_freshness_gate,
    ci_floor_emit_gate
  ]
}

data ci_workflow_dag: CIWorkflowDag = {
  pipeline: ci_pipeline,
  edges: [
    { from: dsl_compile_clean_gate, to: fmt_gate },
    { from: fmt_gate, to: v4_lens_gate }
  ]
}
