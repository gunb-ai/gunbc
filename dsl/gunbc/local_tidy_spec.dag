module gunbc.local_tidy_spec

import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import gunbc.gate_registry {
  Gate, DocReachabilityGate, GeneratedArtifactDriftGate, CargoFmtGate,
  gate_local_tidy_variants, gate_binding, local_tidy_trigger_globs, gate_has_stale_probe
}

data local_tidy_emit_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.githooks_pre_push_emit",
    decl_name: "expected_githooks_pre_push_sh",
    field: WholeDeclaration
  }
}

data gunbc_local_tidy_gates: List<Gate> = gate_local_tidy_variants()

fn local_tidy_gate_entry(g: Gate) -> String {
  gate_binding(g: g).entry
}

fn local_tidy_gate_check_fns(g: Gate) -> List<String> {
  gate_binding(g: g).check_fns
}

fn local_tidy_gate_wet_fn(g: Gate) -> String {
  gate_binding(g: g).wet_fn
}

fn local_tidy_gate_order() -> List<Gate> {
  [DocReachabilityGate, GeneratedArtifactDriftGate, CargoFmtGate]
}
