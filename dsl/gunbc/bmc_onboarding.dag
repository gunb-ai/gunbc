module gunbc.bmc_onboarding

import std.bmc { BmcEndpoint, Redfish }
import std.credentials { FactoryLogin, CredentialFlow, Stored }
import std.os.types { OperatingSystemProduct, UbuntuOs, NobleNumbat2404Lts }
import std.types { NonEmptyStr, Int, List }
import std.logic { Bool }
import extdeps.bmc.types { RedfishBootSourceOverrideTarget, BootTargetPxe, RedfishAccountRole, AccountRoleAdministrator }
import extdeps.bmc.openbmc { openbmc_factory_login }
import extdeps.boards.asrock_rack { asrock_altrad8ud_redfish_system_id }
import extdeps.communication.medium { DecodeFidelity, Lossless, Lossy, Medium }

type BmcOnboardingPhase =
    FactoryDefault
  | CredentialsRotated
  | OsInstalled
  | FabricJoined

fn bmc_onboarding_next_phase(phase: BmcOnboardingPhase) -> BmcOnboardingPhase? {
  match phase {
    FactoryDefault => Present { value: CredentialsRotated }
    CredentialsRotated => Present { value: OsInstalled }
    OsInstalled => Present { value: FabricJoined }
    FabricJoined => Absent
  }
}

fn bmc_phase_chain_from(
  phase: BmcOnboardingPhase,
  acc: List<BmcOnboardingPhase>
) -> List<BmcOnboardingPhase> {
  let acc2 = acc |> list_push(phase)
  match bmc_onboarding_next_phase(phase: phase) {
    Present { value: nxt } => bmc_phase_chain_from(phase: nxt, acc: acc2)
    Absent => acc2
  }
}

data bmc_onboarding_phase_order: List<BmcOnboardingPhase> = bmc_phase_chain_from(phase: FactoryDefault, acc: [])

type BmcCredentialPosture =
    FactoryPublished
  | RotatedSecretManaged
  | KeylessFederated

fn bmc_phase_credential_posture(phase: BmcOnboardingPhase) -> BmcCredentialPosture {
  match phase {
    FactoryDefault => FactoryPublished
    CredentialsRotated => RotatedSecretManaged
    OsInstalled => RotatedSecretManaged
    FabricJoined => KeylessFederated
  }
}

fn bmc_posture_rank(posture: BmcCredentialPosture) -> Int {
  match posture {
    FactoryPublished => 0
    RotatedSecretManaged => 1
    KeylessFederated => 2
  }
}

fn bmc_posture_is_keyless(posture: BmcCredentialPosture) -> Bool {
  match posture {
    FactoryPublished => false
    RotatedSecretManaged => false
    KeylessFederated => true
  }
}

fn bmc_credential_lifecycle() -> List<BmcCredentialPosture> {
  fold(
    bmc_onboarding_phase_order,
    init: [],
    f: (acc, ph) => acc |> list_push(bmc_phase_credential_posture(phase: ph))
  )
}

type BmcPostureScan {
  prev_rank: Int
  monotone: Bool
}

fn bmc_lifecycle_is_monotone_hardening() -> Bool {
  fold(
    bmc_credential_lifecycle(),
    init: BmcPostureScan { prev_rank: 0, monotone: true },
    f: (acc, posture) => BmcPostureScan {
      prev_rank: bmc_posture_rank(posture: posture),
      monotone: acc.monotone && bmc_posture_rank(posture: posture) >= acc.prev_rank
    }
  ).monotone
}

fn bmc_lifecycle_length() -> Int {
  bmc_onboarding_phase_order.length()
}

fn bmc_phase_index(phase: BmcOnboardingPhase) -> Int {
  match phase {
    FactoryDefault => 0
    CredentialsRotated => 1
    OsInstalled => 2
    FabricJoined => 3
  }
}

fn bmc_phase_eq(a: BmcOnboardingPhase, b: BmcOnboardingPhase) -> Bool {
  bmc_phase_index(phase: a) == bmc_phase_index(phase: b)
}

fn bmc_onboarding_prev_phase(phase: BmcOnboardingPhase) -> BmcOnboardingPhase? {
  match phase {
    FactoryDefault => Absent
    CredentialsRotated => Present { value: FactoryDefault }
    OsInstalled => Present { value: CredentialsRotated }
    FabricJoined => Present { value: OsInstalled }
  }
}

fn bmc_onboard_to_steady(phase: BmcOnboardingPhase) -> BmcOnboardingPhase {
  match bmc_onboarding_next_phase(phase: phase) {
    Present { value: nxt } => bmc_onboard_to_steady(phase: nxt)
    Absent => phase
  }
}

fn bmc_decom_to_factory(phase: BmcOnboardingPhase) -> BmcOnboardingPhase {
  match bmc_onboarding_prev_phase(phase: phase) {
    Present { value: prv } => bmc_decom_to_factory(phase: prv)
    Absent => phase
  }
}

fn bmc_decom_step_fidelity(into_phase: BmcOnboardingPhase) -> DecodeFidelity {
  match into_phase {
    FactoryDefault => Lossless
    CredentialsRotated => Lossy
    OsInstalled => Lossless
    FabricJoined => Lossless
  }
}

fn bmc_lifecycle_inverse_fidelity() -> DecodeFidelity {
  fold(
    bmc_onboarding_phase_order,
    init: Lossless,
    f: (acc, ph) => match acc {
      Lossy => Lossy
      Lossless => bmc_decom_step_fidelity(into_phase: ph)
    }
  )
}

fn bmc_lifecycle_roundtrip(phase: BmcOnboardingPhase) -> Medium<BmcOnboardingPhase> {
  Medium {
    carried: bmc_decom_to_factory(phase: bmc_onboard_to_steady(phase: phase)),
    fidelity: bmc_lifecycle_inverse_fidelity()
  }
}

type BmcOnboardingPlan {
  bmc: BmcEndpoint
  redfish_system_id: NonEmptyStr
  factory_login: FactoryLogin
  rotated_credential: CredentialFlow
  rotated_account_role: RedfishAccountRole
  os_target: OperatingSystemProduct
  os_install_boot_target: RedfishBootSourceOverrideTarget
  start_phase: BmcOnboardingPhase
  steady_state_phase: BmcOnboardingPhase
}

fn bmc_plan_steady_state_posture(plan: BmcOnboardingPlan) -> BmcCredentialPosture {
  bmc_phase_credential_posture(phase: plan.steady_state_phase)
}

fn bmc_plan_steady_state_is_keyless(plan: BmcOnboardingPlan) -> Bool {
  bmc_posture_is_keyless(posture: bmc_plan_steady_state_posture(plan: plan))
}

data new_altra_onboarding_plan: BmcOnboardingPlan = BmcOnboardingPlan {
  bmc: BmcEndpoint { host: "192.168.1.192", protocol: Redfish },
  redfish_system_id: asrock_altrad8ud_redfish_system_id,
  factory_login: openbmc_factory_login,
  rotated_credential: Stored { secret_name: "bmc-srv3-admin" },
  rotated_account_role: AccountRoleAdministrator,
  os_target: UbuntuOs { distro: NobleNumbat2404Lts },
  os_install_boot_target: BootTargetPxe,
  start_phase: FactoryDefault,
  steady_state_phase: FabricJoined,
}
