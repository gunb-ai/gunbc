module gunbc.gitignore_emit

import gunbc.gitignore_model {
  Producer, IgnoreGroup, IgnoreArtifact,
  CargoArtifacts, CargoCacheLocal, CodegenSymlink, CoverageReport,
  GeneratorStamp, WorkflowRuntime, TestgenOutput, RegenTempDir,
  ClaudeCodeSession, ClaimMapOutput, OpenClawArtifact, GithubCLICache,
  AuthSessionTranscript, PythonLocalDevScript,
  JetBrainsIDE, VSCodeIDE, VimEditor, EmacsEditor, GenericEditorBackup,
  MacOSFinder, WindowsExplorer, Tmux, NodeJS, SecretsConvention, CPythonInterpreter,
  Derivable, Cited,
  CargoTargetDir, CargoTargetCodexDir, LocalCargoHome, CodegenBinSymlink,
  TarpaulinHtmlReport, TarpaulinJsonReport, CoberturaReport, LcovReport, CoverageOutputDir,
  JetBrainsProjectDir, VSCodeWorkspaceDir,
  VimSwapFile, VimSwapFileAlt, EmacsBackupFile, GenericBackupFile,
  MacOSFinderMetadata, WindowsThumbnailCache, TmuxLogFile,
  DotEnvFile, DotEnvLocalFile, DotEnvLocalWildcard,
  GeneratorStampFile, GunbcWorkflowDir, TestgenOutputDir, NodeModulesDir,
  ClaudeSessionDir, RegenSourcesDir, RegenOutputDir, RegenGeneratedSourceRootDir,
  FreshnessCheckDir, AuthTranscriptFile,
  OpenClawControlDir, OpenClawAgentsFile, OpenClawHeartbeatFile, OpenClawIdentityFile,
  OpenClawSoulFile, OpenClawToolsFile, OpenClawUserFile, OpenClawWorkboardFile,
  OpenClawScriptsDir, V2InspectFile, V2InspectErrorsFile, GithubCLICacheDir,
  PythonLocalDevScriptFile, PythonBytecodeCacheDir, PythonCompiledBytecode,
  ClaimMapDir, ScratchProbeFile
}
import gunbc.gitignore_authority { gitignore_authority }

fn artifact_pattern(a: IgnoreArtifact) -> String {
  match a {
    CargoTargetDir => "/target/"
    CargoTargetCodexDir => "/target-codex/"
    LocalCargoHome => "/.cargo-home/"
    CodegenBinSymlink => "/bin/"
    TarpaulinHtmlReport => "tarpaulin-report.html"
    TarpaulinJsonReport => "tarpaulin-report.json"
    CoberturaReport => "cobertura.xml"
    LcovReport => "lcov.info"
    CoverageOutputDir => "coverage/"
    JetBrainsProjectDir => ".idea/"
    VSCodeWorkspaceDir => ".vscode/"
    VimSwapFile => "*.swp"
    VimSwapFileAlt => "*.swo"
    EmacsBackupFile => "*~"
    GenericBackupFile => "*.bak"
    MacOSFinderMetadata => ".DS_Store"
    WindowsThumbnailCache => "Thumbs.db"
    TmuxLogFile => "tmux-*.log"
    DotEnvFile => ".env"
    DotEnvLocalFile => ".env.local"
    DotEnvLocalWildcard => ".env.*.local"
    GeneratorStampFile => ".*-stamp"
    GunbcWorkflowDir => "/.gunbc/"
    TestgenOutputDir => "src/v1/10_test/generated-tests/src/generated/"
    NodeModulesDir => "node_modules/"
    ClaudeSessionDir => ".claude/"
    RegenSourcesDir => ".regen-sources/"
    RegenOutputDir => ".regen-output/"
    RegenGeneratedSourceRootDir => ".regen-generated-source-root/"
    FreshnessCheckDir => ".freshness-check/"
    AuthTranscriptFile => "out.txt"
    OpenClawControlDir => "/.openclaw/"
    OpenClawAgentsFile => "/AGENTS.md"
    OpenClawHeartbeatFile => "/HEARTBEAT.md"
    OpenClawIdentityFile => "/IDENTITY.md"
    OpenClawSoulFile => "/SOUL.md"
    OpenClawToolsFile => "/TOOLS.md"
    OpenClawUserFile => "/USER.md"
    OpenClawWorkboardFile => "/WORKBOARD.md"
    OpenClawScriptsDir => "/scripts/openclaw/"
    V2InspectFile => ".v2-inspect"
    V2InspectErrorsFile => ".v2-inspect-errors.txt"
    GithubCLICacheDir => ".gh-cache/"
    PythonLocalDevScriptFile => "*.py"
    PythonBytecodeCacheDir => "__pycache__/"
    PythonCompiledBytecode => "*.pyc"
    ClaimMapDir => ".claim-map/"
    ScratchProbeFile => "src/v2/compiler/manual/sg2_scratch_probe.dag"
  }
}

fn producer_display(p: Producer) -> String {
  match p {
    Derivable { kind: CargoArtifacts } => "Cargo build artifacts (from cargo)"
    Derivable { kind: CargoCacheLocal } => "Cargo cache (local CARGO_HOME) (from tool/rust)"
    Derivable { kind: CodegenSymlink } => "Codegen bin symlink (from codegen)"
    Derivable { kind: CoverageReport } => "Coverage reports (from cargo-tarpaulin)"
    Derivable { kind: GeneratorStamp } => "Generator stamp files (from generators)"
    Derivable { kind: WorkflowRuntime } => "Workflow runtime state (from workflow)"
    Derivable { kind: TestgenOutput } => "testgen outputs (from testgen)"
    Derivable { kind: RegenTempDir } => "Stage0 regeneration temp dirs"
    Derivable { kind: ClaudeCodeSession } => "Claude Code session state"
    Derivable { kind: ClaimMapOutput } => "claim-corpus execution-map output"
    Derivable { kind: OpenClawArtifact } => "OpenClaw workspace artifacts"
    Derivable { kind: GithubCLICache } => "GitHub CLI local cache (dashboard / gh API)"
    Derivable { kind: AuthSessionTranscript } => "Interactive auth/session transcripts"
    Derivable { kind: PythonLocalDevScript } => "Python local dev scripts"
    Cited { kind: JetBrainsIDE, upstream: u } => concat("JetBrains IDE project state [cited: ", concat(u, "]"))
    Cited { kind: VSCodeIDE, upstream: u } => concat("VS Code workspace state [cited: ", concat(u, "]"))
    Cited { kind: VimEditor, upstream: u } => concat("Vim editor state [cited: ", concat(u, "]"))
    Cited { kind: EmacsEditor, upstream: u } => concat("Emacs backup convention [cited: ", concat(u, "]"))
    Cited { kind: GenericEditorBackup, upstream: u } => concat("Generic editor backup files [cited: ", concat(u, "]"))
    Cited { kind: MacOSFinder, upstream: u } => concat("macOS Finder metadata [cited: ", concat(u, "]"))
    Cited { kind: WindowsExplorer, upstream: u } => concat("Windows Explorer cache [cited: ", concat(u, "]"))
    Cited { kind: Tmux, upstream: u } => concat("tmux terminal multiplexer logs [cited: ", concat(u, "]"))
    Cited { kind: NodeJS, upstream: u } => concat("Node.js [cited: ", concat(u, "]"))
    Cited { kind: SecretsConvention, upstream: u } => concat("Secrets and local config [cited: ", concat(u, "]"))
    Cited { kind: CPythonInterpreter, upstream: u } => concat("CPython bytecode cache (PEP 3147) [cited: ", concat(u, "]"))
  }
}

fn producer_rationale_line(p: Producer) -> String {
  match p {
    Derivable { kind: CargoArtifacts } => "# Reproducible from source via cargo build"
    Derivable { kind: CargoCacheLocal } => "# Local Cargo cache may include git checkouts; not project state"
    Derivable { kind: CodegenSymlink } => "# Symlink to target/release created by codegen"
    Derivable { kind: CoverageReport } => "# Generated, often large, reproducible"
    Derivable { kind: GeneratorStamp } => "# Producer-centric model stamps"
    Derivable { kind: WorkflowRuntime } => "# Local execution ledger and config; not source-of-truth"
    Derivable { kind: TestgenOutput } => "# Generated by testgen; not source-of-truth"
    Derivable { kind: RegenTempDir } => ""
    Derivable { kind: ClaudeCodeSession } => ""
    Derivable { kind: ClaimMapOutput } => ""
    Derivable { kind: OpenClawArtifact } => "# The OpenClaw control plane lives in ~/ctrl, not in this repo"
    Derivable { kind: GithubCLICache } => ""
    Derivable { kind: AuthSessionTranscript } => "# Should never be committed; may contain OAuth URLs or session state"
    Derivable { kind: PythonLocalDevScript } => "# Python is used only for local dev tooling; never committed to the .dag/.rs substrate"
    Cited { kind: JetBrainsIDE, upstream: _ } => "# Per-developer configuration, not project state"
    Cited { kind: VSCodeIDE, upstream: _ } => "# Per-developer configuration, not project state"
    Cited { kind: VimEditor, upstream: _ } => "# Per-developer configuration, not project state"
    Cited { kind: EmacsEditor, upstream: _ } => "# Per-developer configuration, not project state"
    Cited { kind: GenericEditorBackup, upstream: _ } => "# Per-developer configuration, not project state"
    Cited { kind: MacOSFinder, upstream: _ } => "# OS-generated, not project state"
    Cited { kind: WindowsExplorer, upstream: _ } => "# OS-generated, not project state"
    Cited { kind: Tmux, upstream: _ } => "# Session log; not project state"
    Cited { kind: NodeJS, upstream: _ } => "# Not part of this project"
    Cited { kind: SecretsConvention, upstream: _ } => "# Environment-specific, may contain secrets"
    Cited { kind: CPythonInterpreter, upstream: _ } => ""
  }
}

fn render_group(g: IgnoreGroup) -> String {
  let header = concat(concat("# --- ", producer_display(p: g.producer)), " ---\n")
  let rationale = producer_rationale_line(p: g.producer)
  let rat_section = if rationale == "" { "" } else { concat(rationale, "\n") }
  let patterns_block = fold(g.artifacts, init: "", f: fn(acc, a) { concat(acc, concat(artifact_pattern(a: a), "\n")) })
  concat(concat(header, rat_section), patterns_block)
}

fn gitignore_file_header() -> String {
  "# gunbc .gitignore — generated from dsl/gunbc/gitignore_authority.dag — do not hand-edit.\n#\n# Rule: Ignore anything that is (a) reproducible from committed source-of-truth files, or (b) environment-specific and not shared across developers.\n\n"
}

fn serialize_gitignore(groups: List<IgnoreGroup>) -> String {
  let body = fold(groups, init: "", f: fn(acc, g) {
    let rendered = render_group(g: g)
    if acc == "" { rendered } else { concat(acc, concat("\n", rendered)) }
  })
  concat(gitignore_file_header(), body)
}

fn expected_gitignore() -> String {
  serialize_gitignore(groups: gitignore_authority)
}

fn gitignore_drifted(committed: String) -> Bool {
  !(committed == expected_gitignore())
}

// The ignore-set as a flat pattern list — the COMMIT-side authority the generated-artifact registry
// reads to derive `committed = generated AND NOT ignored` (gunbc.generated_artifact). Reuses the same
// gitignore_authority rows and artifact_pattern producer the file emit already folds over (no second
// authority for "what we ignore").
fn group_patterns(g: IgnoreGroup) -> List<String> {
  fold(g.artifacts, init: [], f: fn(acc, a) { concat(acc, [artifact_pattern(a: a)]) })
}

fn ignore_patterns() -> List<String> {
  fold(gitignore_authority, init: [], f: fn(acc, g) { concat(acc, group_patterns(g: g)) })
}

// path_is_ignored — the INTERPRETER of this authority's patterns, homed beside the producer
// (artifact_pattern) it reads, so gitignore semantics live in ONE module (DESIGN §3). A path is ignored
// iff it matches any authority pattern under a FAITHFUL SUBSET of gitignore semantics over the pattern
// forms the authority actually uses:
//   - trailing "/"  => directory pattern: path is that dir or sits under it
//   - leading "/"   => anchored to repo root
//   - "*.ext"       => basename suffix glob
//   - plain name    => exact basename, anywhere in the tree
// FAIL-CLOSED toward "not ignored": an UNCERTAIN match returns false. Its consumer (the generated-artifact
// commit derivation) treats not-ignored => committed => still drift-gated, so a false negative is loud
// (read() of an absent path goes RED), never a silent drop. Seed has substring/length, not drop_*.
fn without_prefix(s: String, prefix: String) -> String {
  substring(s: s, start: prefix.length(), end: s.length())
}

fn without_suffix(s: String, suffix: String) -> String {
  substring(s: s, start: 0, end: s.length() - suffix.length())
}

fn path_basename(path: String) -> String {
  fold(split(s: path, delimiter: "/"), init: "", f: fn(_, seg) { seg })
}

fn dir_pattern_matches(dir: String, path: String) -> Bool {
  // dir already has leading/trailing slashes stripped.
  let anchored = concat(dir, "/")
  path == dir
    || starts_with(path, prefix: anchored)
    || string_contains(s: path, pattern: concat("/", anchored))
}

fn strip_slashes(p: String) -> String {
  let no_lead = if starts_with(p, prefix: "/") { without_prefix(s: p, prefix: "/") } else { p }
  if ends_with(s: no_lead, suffix: "/") { without_suffix(s: no_lead, suffix: "/") } else { no_lead }
}

fn pattern_matches(pattern: String, path: String) -> Bool {
  if ends_with(s: pattern, suffix: "/") {
    dir_pattern_matches(dir: strip_slashes(p: pattern), path: path)
  } else if starts_with(pattern, prefix: "*.") {
    ends_with(s: path, suffix: without_prefix(s: pattern, prefix: "*"))
  } else if starts_with(pattern, prefix: "/") {
    let anchored = without_prefix(s: pattern, prefix: "/")
    path == anchored || starts_with(path, prefix: concat(anchored, "/"))
  } else {
    path == pattern || path_basename(path: path) == pattern || ends_with(s: path, suffix: concat("/", pattern))
  }
}

fn path_is_ignored(path: String) -> Bool {
  any(ignore_patterns(), p => pattern_matches(pattern: p, path: path))
}
