module gunbc.gcp_secret_roundtrip_probe

import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.gcp { GcpProjectId }
import std.types { NonEmptyStr }
import std.logic { Bool }

data probe_project: GcpProjectId = "gunbai-secrets"
data probe_secret: NonEmptyStr = "bmc-srv3-admin"
data probe_secret_name: String = "projects/gunbai-secrets/secrets/bmc-srv3-admin"
data probe_payload_b64: String = "Zm9vYmFy"

func gcp_sm_create() -> String {
  let r = gcp.SecretManager.CreateSecret(project_id: probe_project, secret_id: probe_secret)
  return r.name
}

func gcp_sm_addversion() -> String {
  let r = gcp.SecretManager.AddVersion(secret_name: probe_secret_name, payload_b64: probe_payload_b64)
  return r.name
}

func gcp_sm_access() -> String {
  let r = gcp.SecretManager.AccessVersion(project_id: probe_project, secret: probe_secret, version: "latest")
  return r.data_b64
}

func gcp_sm_roundtrip_holds() -> Bool {
  let _add = gcp.SecretManager.AddVersion(secret_name: probe_secret_name, payload_b64: probe_payload_b64)
  let r = gcp.SecretManager.AccessVersion(project_id: probe_project, secret: probe_secret, version: "latest")
  return r.data_b64 == probe_payload_b64
}
