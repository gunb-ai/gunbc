// gunbc/ci_spec.dag — CI intent as data (layer roots, gates, diff policy).

module gunbc.ci_spec

import v2.std.collection { List }

type Gate
  = RustMonolithGate
  | EmitHostGate
  | LayeringImportsGate
  | DslCompileCleanGate
  | CiYamlGate
  | SourceRootIngestGate

type DiffMode = DiffMergeBase | DiffTwoDot

type DiffPolicy {
  base: String
  head: String
  mode: DiffMode
}

type CiSpec {
  gates: List<Gate>
  diff_policy: DiffPolicy
  notice_title: String
}

// Single authority for CI witness layer roots (§3 — replaces the former triple-fork across
// ci.yml / the transport scripts / a hand-listed witness_entries).
data witness_layer_roots: List<String> = ["src/v2", "dsl"]

// Discovery scan dirs: `claim_batch --roster-from-discovery` requires at least one --scan-dir
// and reflects every `data unified_claim_*` / `*_test.dag` witness it finds under them into the
// roster. This DISSOLVES the former hand-listed witness_entries (reference-by-path →
// discovery-by-predicate, §2/§3): a new witness dropped into one of these dirs is picked up with
// no edit here — that is the anti-rot point. These two dirs are exactly where the dissolved
// witnesses live (7 in dsl/test/claim + 1 in src/v2/test/claim/layering_imports), so coverage
// equals the prior explicit-entry floor with no regression.
data witness_discovery_scan_dirs: List<String> = [
  "dsl/test/claim",
  "src/v2/test/claim/layering_imports"
]

// 🟡 SCAFFOLD — feature:gate-coproduct-inhabitant-bridge — bind gunbc#4872 —
// dissolve-on-arrival: generic Symbol→inhabitant replaces this exhaustive match roster.
// The roster is held HONEST by a discovered witness (dsl/test/claim/ci_spec_witness.dag,
// gate_roster_matches_coproduct_arms) that reflects ^Gate's arms via std.node_query and
// fails RED if this list drifts from the coproduct. That reflection lives in the WITNESS,
// never here: importing std.node_query into this runtime spec drags it (and std.diagnostic)
// into the `gunbc ci` resolution closure, where the v2 FreeMonoid<T> generic-alias bootstrap
// limitation (src/v2/std/qualified_name.dag:25) makes its Empty/Cons constructors unresolvable.
data gunbc_ci_gates: List<Gate> = [
  RustMonolithGate,
  EmitHostGate,
  LayeringImportsGate,
  DslCompileCleanGate,
  CiYamlGate,
  SourceRootIngestGate
]

data gunbc_ci_spec: CiSpec = {
  gates: gunbc_ci_gates,
  diff_policy: {
    base: "origin/main",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "v2 claim corpus"
}

fn join_slash(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, "/"), p) })
}

fn git_fetch_script(policy: DiffPolicy) -> String {
  let parts = split(s: policy.base, delimiter: "/")
  let remote = parts.first()
  let ref_name = join_slash(parts: parts.skip(n: 1))
  concat(
    concat(concat("git fetch --no-tags ", remote), " "),
    concat(ref_name, " 2>/dev/null || true")
  )
}

fn witness_layer_source_flags(roots: List<String>) -> String {
  fold(roots, init: "", f: (acc, r) => concat(acc, concat(" --source-root ", r)))
}

// Shared by dsl/tools/layering_imports_transport.dag so the transport reads the SAME
// witness_layer_roots authority instead of re-forking the src/v2 + dsl pair (§3).
fn witness_layer_source_shell_flags(roots: List<String>) -> String {
  witness_layer_source_flags(roots: roots)
}

fn witness_layer_scan_flags() -> String {
  fold(witness_discovery_scan_dirs, init: "", f: (acc, d) => concat(acc, concat(" --scan-dir ", d)))
}

fn claim_batch_script(spec: CiSpec) -> String {
  concat(
    concat(
      concat(
        concat("cargo run -p v1-compiler --release --bin claim_batch --", witness_layer_source_flags(roots: witness_layer_roots)),
        witness_layer_scan_flags()
      ),
      " --roster-from-discovery"
    ),
    concat(concat(" --notice-title \"", spec.notice_title), "\"")
  )
}

fn ci_gates_invoke(spec: CiSpec) -> String {
  concat(
    concat("cargo run -p v1-compiler --release --bin gunbc -- run", witness_layer_source_flags(roots: witness_layer_roots)),
    " --entry dsl/tools/ci_gates.dag --function main"
  )
}

fn gunbc_ci_run_script(spec: CiSpec) -> String {
  concat(
    concat(
      concat(git_fetch_script(policy: spec.diff_policy), "\n"),
      concat(claim_batch_script(spec: spec), "\n")
    ),
    ci_gates_invoke(spec: spec)
  )
}

fn gunbc_ci_workflow_run(spec: CiSpec) -> String {
  concat(
    concat(git_fetch_script(policy: spec.diff_policy), "\n"),
    "cargo run -p v1-compiler --release --bin gunbc -- ci"
  )
}
