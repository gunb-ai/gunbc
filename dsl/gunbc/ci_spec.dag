// gunbc/ci_spec.dag — CI intent as data (gates, diff policy, transport scripts).

module gunbc.ci_spec

import gunbc.ci_layer_roots {
  witness_layer_roots,
  witness_layer_source_flags
}

type Gate
  = RustMonolithGate
  | EmitHostGate
  | LayeringImportsGate
  | DslCompileCleanGate
  | CiYamlGate
  | SourceRootIngestGate

type DiffMode = DiffMergeBase | DiffTwoDot

type DiffPolicy {
  base: String
  head: String
  mode: DiffMode
}

type CiSpec {
  gates: List<Gate>
  diff_policy: DiffPolicy
  notice_title: String
}

