// gunbc/ci_spec.dag — CI intent as data (layer roots, gates, diff policy).

module gunbc.ci_spec

import v2.std.algebra { bag_eq, Empty, list_snoc_item, length }
import v2.std.collection { List }
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import v2.std.node { Behavior, Symbol }
import v2.std.node_query { coproduct_arm_keys, coproduct_nullary_inhabitants }

type Gate
  = RustMonolithGate
  | EmitHostGate
  | LayeringImportsGate
  | DslCompileCleanGate
  | CiYamlGate

type DiffMode = DiffMergeBase | DiffTwoDot

type DiffPolicy {
  base: String
  head: String
  mode: DiffMode
}

type CiSpec {
  gates: List<Gate>
  diff_policy: DiffPolicy
  notice_title: String
}

// Single authority for CI witness layer roots (§3 — replaces triple-fork in ci.yml / transport scripts).
data witness_layer_roots: List<String> = ["src/v2", "dsl"]

// Narrow discovery scan dirs for unified_claim_* markers (not whole layer trees).
data witness_discovery_scan_dirs: List<String> = [
  "dsl/test/claim",
  "src/v2/test/claim/layering_imports"
]

data reflect_gate_type: Symbol = ^Gate

// 🟡 SCAFFOLD — feature:gate-coproduct-inhabitant-bridge — bind gunbc#4872 —
// dissolve-on-arrival: generic Symbol→inhabitant replaces exhaustive match roster;
// until then the roster is witness-checked against coproduct reflection on ^Gate.
data gunbc_ci_gates: List<Gate> = [
  RustMonolithGate,
  EmitHostGate,
  LayeringImportsGate,
  DslCompileCleanGate,
  CiYamlGate
]

data gunbc_ci_spec: CiSpec = {
  gates: gunbc_ci_gates,
  diff_policy: {
    base: "origin/main",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "v2 claim corpus"
}

fn symbol_eq(a: Symbol, b: Symbol) -> Bool {
  a == b
}

fn nullary_inhabitant_discriminants(inhabitants: List<Behavior>) -> List<Symbol> {
  fold(inhabitants, init: Empty, f: fn(acc, v) {
    list_snoc_item(xs: acc, item: discriminant(v: v))
  })
}

fn gate_roster_matches_coproduct_arms() -> Bool {
  let arm_keys = coproduct_arm_keys(type_name: reflect_gate_type)
  match coproduct_nullary_inhabitants(type_name: reflect_gate_type) {
    Accepted { value: inhabitants, diagnostics: _ } =>
      (length(xs: gunbc_ci_gates) == length(xs: arm_keys)) &&
        bag_eq(
          xs: nullary_inhabitant_discriminants(inhabitants: inhabitants),
          ys: arm_keys,
          eq: symbol_eq
        )
    Rejected { diagnostics: _ } => false
  }
}

fn join_slash(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, "/"), p) })
}

fn git_fetch_script(policy: DiffPolicy) -> String {
  let parts = split(s: policy.base, delimiter: "/")
  let remote = parts.first()
  let ref_name = join_slash(parts: parts.skip(n: 1))
  concat(
    concat(concat("git fetch --no-tags ", remote), " "),
    concat(ref_name, " 2>/dev/null || true")
  )
}

fn witness_layer_source_flags(roots: List<String>) -> String {
  fold(roots, init: "", f: (acc, r) => concat(acc, concat(" --source-root ", r)))
}

fn witness_layer_scan_flags() -> String {
  fold(witness_discovery_scan_dirs, init: "", f: (acc, d) => concat(acc, concat(" --scan-dir ", d)))
}

fn witness_layer_source_shell_flags(roots: List<String>) -> String {
  witness_layer_source_flags(roots: roots)
}

fn claim_batch_script(spec: CiSpec) -> String {
  concat(
    concat(
      concat(
        concat(
          concat("cargo run -p v1-compiler --release --bin claim_batch --", witness_layer_source_flags(roots: witness_layer_roots)),
          witness_layer_scan_flags()
        ),
        " --roster-from-discovery"
      ),
      ""
    ),
    concat(concat(" --notice-title \"", spec.notice_title), "\"")
  )
}

fn ci_gates_invoke(spec: CiSpec) -> String {
  concat(
    concat("cargo run -p v1-compiler --release --bin gunbc -- run", witness_layer_source_flags(roots: witness_layer_roots)),
    " --entry dsl/tools/ci_gates.dag --function main"
  )
}

fn gunbc_ci_run_script(spec: CiSpec) -> String {
  concat(
    concat(
      concat(git_fetch_script(policy: spec.diff_policy), "\n"),
      concat(claim_batch_script(spec: spec), "\n")
    ),
    ci_gates_invoke(spec: spec)
  )
}

fn gunbc_ci_workflow_run(spec: CiSpec) -> String {
  concat(
    concat(git_fetch_script(policy: spec.diff_policy), "\n"),
    "cargo run -p v1-compiler --release --bin gunbc -- ci"
  )
}
