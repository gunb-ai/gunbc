fn ci_gates_invoke(spec: CiSpec) -> String {
  concat(
    concat("cargo run -p v1-compiler --release --bin gunbc -- run", witness_roots_flags(roots: spec.witness_roots)),
    " --entry dsl/tools/ci_gates.dag --function main"
  )
}

