module gunbc.ci_spec

import gunbc.ci_layer_roots {
  witness_layer_roots,
  witness_layer_source_flags
}
import tools.build_step { BuildArtifact, verifications_script }
import extdeps.languages.bash.program { ShellWord, Concat, lit, var_ref }

type Gate
  = RustMonolithGate
  | EmitHostGate
  | LayeringImportsGate
  | ResolvedImportsGate
  | ExtdepsExternalAuthorityGate
  | DslCompileCleanGate
  | CiYamlGate
  | SourceRootIngestGate

type DiffMode = DiffMergeBase | DiffTwoDot

type DiffPolicy {
  base: String
  head: String
  mode: DiffMode
}

type CiSpec {
  gates: List<Gate>
  diff_policy: DiffPolicy
  notice_title: String
}

// The CI gate set is PARTITIONED by which GHA job runs it (DESIGN §2 — the partition is
// total and disjoint by construction, so no gate can be silently dropped from CI):
//   - `gunbc_ci_floor_gates` run inside the floor scheduler (the single "ci" job).
//   - `gunbc_ci_rust_job_gates` run in their own parallel "rust_tests" GHA job (the long
//     v1 cargo gate, split out so it no longer serializes with the .dag witness corpus).
// `gunbc_ci_gates` (the complete roster the coproduct-completeness witnesses check) is the
// UNION of the two — defined by `concat`, so floor ∪ rust_job == every Gate arm holds by
// construction, not by a re-listing that could drift from the partition.
data gunbc_ci_floor_gates: List<Gate> = [
  EmitHostGate,
  LayeringImportsGate,
  ResolvedImportsGate,
  ExtdepsExternalAuthorityGate,
  DslCompileCleanGate,
  CiYamlGate,
  SourceRootIngestGate
]

data gunbc_ci_rust_job_gates: List<Gate> = [
  RustMonolithGate
]

data gunbc_ci_gates: List<Gate> = concat(gunbc_ci_floor_gates, gunbc_ci_rust_job_gates)

data gunbc_ci_spec: CiSpec = {
  gates: gunbc_ci_floor_gates,
  diff_policy: {
    base: "origin/main",
    head: "HEAD",
    mode: DiffMergeBase
  },
  notice_title: "v2 claim corpus"
}

data ci_release_features: String = "text_lookup_work_counter"

fn ci_repo_root_shell() -> String {
  "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
}

fn ci_release_build_line() -> String {
  concat(
    concat(
      "cargo build -p v1-compiler --release --features ",
      ci_release_features
    ),
    " --bins"
  )
}

fn ci_cargo_eagain_retry_core(command: String) -> String {
  concat(
    concat(
      concat("BUILD_LOG=$(mktemp)\n", "if ! ("),
      concat(command, ") 2>&1 | tee \"$BUILD_LOG\"; then\n")
    ),
    concat(
      concat(
        concat(
          "  if grep -qiE 'Resource temporarily unavailable|failed to spawn|sccache: encountered fatal error' \"$BUILD_LOG\"; then\n",
          "    echo \"::warning::cargo/sccache EAGAIN under fleet pressure; cold retry CARGO_BUILD_JOBS=1 (keep sccache)\"\n"
        ),
        concat(
          concat("    RETRY_LOG=$(mktemp)\n", "    if ! ( CARGO_BUILD_JOBS=1 "),
          concat(command, " ) 2>&1 | tee \"$RETRY_LOG\"; then\n")
        )
      ),
      concat(
        concat(
          concat(
            "      if grep -qiE 'Resource temporarily unavailable|failed to spawn|sccache:' \"$RETRY_LOG\"; then\n",
            "        echo \"::warning::cargo/sccache still failing; retry without RUSTC_WRAPPER\"\n"
          ),
          concat("        env -u RUSTC_WRAPPER CARGO_BUILD_JOBS=1 ", concat(command, " || exit 1\n"))
        ),
        concat(
          concat("      else\n", "        exit 1\n"),
          concat("      fi\n", "    fi\n")
        )
      )
    ),
    concat(
      concat(
        concat("    rm -f \"$RETRY_LOG\"\n", "  else\n"),
        concat("    exit 1\n", "  fi\n")
      ),
      concat("fi\n", "rm -f \"$BUILD_LOG\"\n")
    )
  )
}

fn ci_cargo_eagain_retry_script(command: String) -> String {
  concat("set -o pipefail\n", ci_cargo_eagain_retry_core(command: command))
}

fn ci_cargo_eagain_retry_shell_exec(command: String) -> String {
  concat(
    concat("bash -o pipefail <<'__GUNBC_CI_RETRY__'\n", ci_cargo_eagain_retry_core(command: command)),
    "__GUNBC_CI_RETRY__"
  )
}

fn ci_release_artifact(name: String) -> BuildArtifact {
  BuildArtifact {
    path: Concat { parts: [var_ref(name: "ROOT"), lit(text: concat("/target/release/", name))] },
    name: name
  }
}

data ci_floor_required_artifacts: List<BuildArtifact> = [
  ci_release_artifact(name: "claim_executor"),
  ci_release_artifact(name: "gunbc")
]

fn ci_build_source_roots() -> List<ShellWord> {
  [
    Concat { parts: [var_ref(name: "ROOT"), lit(text: "/src/v1/stage0")] },
    Concat { parts: [var_ref(name: "ROOT"), lit(text: "/src/v1/stage0_core")] },
    Concat { parts: [var_ref(name: "ROOT"), lit(text: "/src/v1/stage0_emit_core")] }
  ]
}

fn ci_floor_build_verify_script() -> String {
  verifications_script(produces: ci_floor_required_artifacts, roots: ci_build_source_roots(), patterns: ["*.rs", "Cargo.toml", "Cargo.lock"])
}

fn ci_release_build_script() -> String {
  concat(
    concat("ROOT=", ci_repo_root_shell(), "\n"),
    concat(
      ci_cargo_eagain_retry_script(command: ci_release_build_line()),
      concat(
        ci_floor_build_verify_script(),
        "sccache --show-stats 2>/dev/null || true"
      )
    )
  )
}

// The Rust-monolith gate's cargo invocations are no longer hand-typed argv Strings here:
// `tools.rust_gates_ci.run_gates` calls the MODELED `extdeps.cargo_build` operations
// (`cargo.Build.Fmt(["--all","--check"])`, `cargo.Build.Clippy(["--all-targets"], ["-D","warnings"])`,
// `cargo.Build.Test(["-p","v1-compiler-tests"])`) — the cargo shell-transport argv is the single
// authority (DESIGN §3; the old `ci_rust_gate_{fmt,clippy,test}_command() -> String` were nicknames
// for cargo's already-modeled interface). Coverage holds by construction (cargo runs
// all-except-`#[ignore]`d; the `coverage_completeness_lens_test` is the fail-closed residue).
// The EAGAIN cold-retry wrappers below stay (transport resilience the cargo model cannot yet express)
// and are applied at the CI workflow step that runs the gate (see gunbc.ci_workflow).

fn claim_executor_bin_shell() -> String {
  "\"$ROOT/target/release/claim_executor\""
}

fn join_slash(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, "/"), p) })
}

fn git_fetch_script(policy: DiffPolicy) -> String {
  let parts = split(s: policy.base, delimiter: "/")
  let remote = parts.first()
  let ref_name = join_slash(parts: parts.skip(n: 1))
  concat(
    concat(concat("git fetch --no-tags ", remote), " "),
    concat(ref_name, " 2>/dev/null || true")
  )
}

data floor_plan_entry: String = "src/v2/workflow/ci_floor_plan.dag"
data floor_plan_function: String = "gunbc_ci_floor_batches"

fn scheduler_invoke(spec: CiSpec) -> String {
  concat(
    concat(
      concat(
        concat(concat(claim_executor_bin_shell(), witness_layer_source_flags(roots: witness_layer_roots)), concat(" --plan-entry ", floor_plan_entry)),
        concat(" --plan-function ", floor_plan_function)
      ),
      concat(concat(" --notice-title \"", spec.notice_title), "\"")
    ),
    ""
  )
}

fn gunbc_ci_run_script(spec: CiSpec) -> String {
  concat(
    concat(
      concat(ci_release_build_script(), "\n"),
      concat(git_fetch_script(policy: spec.diff_policy), "\n")
    ),
    scheduler_invoke(spec: spec)
  )
}

fn gunbc_ci_workflow_run(spec: CiSpec) -> String {
  gunbc_ci_run_script(spec: spec)
}
