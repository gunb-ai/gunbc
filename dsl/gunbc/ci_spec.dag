// Unify v1-compiler feature set across CI cargo invocations. v1-compiler-tests enables
// text_lookup_work_counter; building gunbc/claim_executor without it forces a second full
// v1-compiler compile when rust gates run clippy --all-targets (~49% CI wall-time prong).
data ci_release_features: String = "text_lookup_work_counter"

fn ci_repo_root_shell() -> String {
  "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
}

fn ci_release_build_line() -> String {
  concat(
    concat(
      "cargo build -p v1-compiler --release --features ",
      ci_release_features
    ),
    " --bins"
  )
}

// Two-tier cold retry on fleet EAGAIN (#4978 / #5138): first CARGO_BUILD_JOBS=1 with
// sccache (populate daemon when it works); if sccache still cannot spawn rustc, drop
// RUSTC_WRAPPER and compile direct. Then print stats.
fn ci_release_build_script() -> String {
  let build = ci_release_build_line()
  concat(
    concat(
      concat(
        concat("ROOT=", ci_repo_root_shell(), "\n"),
        "set -o pipefail\n"
      ),
      concat(
        concat("BUILD_LOG=$(mktemp)\n", "if ! ("),
        concat(build, ") 2>&1 | tee \"$BUILD_LOG\"; then\n")
      )
    ),
    concat(
      concat(
        concat(
          "  if grep -qiE 'Resource temporarily unavailable|failed to spawn|sccache: encountered fatal error' \"$BUILD_LOG\"; then\n",
          "    echo \"::warning::cargo/sccache EAGAIN under fleet pressure; cold retry CARGO_BUILD_JOBS=1 (keep sccache)\"\n"
        ),
        concat(
          concat("    RETRY_LOG=$(mktemp)\n", "    if ! ( CARGO_BUILD_JOBS=1 "),
          concat(build, " ) 2>&1 | tee \"$RETRY_LOG\"; then\n")
        )
      ),
      concat(
        concat(
          concat(
            "      if grep -qiE 'Resource temporarily unavailable|failed to spawn|sccache:' \"$RETRY_LOG\"; then\n",
            "        echo \"::warning::cargo/sccache still failing; retry without RUSTC_WRAPPER\"\n"
          ),
          concat("        env -u RUSTC_WRAPPER CARGO_BUILD_JOBS=1 ", concat(build, " || exit 1\n"))
        ),
        concat(
          concat("      else\n", "        exit 1\n"),
          concat("      fi\n", "    fi\n")
        )
      )
    ),
    concat(
      concat(
        concat("    rm -f \"$RETRY_LOG\"\n", "  else\n"),
        concat("    exit 1\n", "  fi\n")
      ),
      concat(
        concat("fi\n", "rm -f \"$BUILD_LOG\"\n"),
        concat("sccache --show-stats 2>/dev/null || true", "")
      )
    )
  )
}

fn claim_executor_bin_shell() -> String {
  "\"$ROOT/target/release/claim_executor\""
}

fn join_slash(parts: List<String>) -> String {
  fold(parts, init: "", f: (acc, p) => if acc == "" { p } else { concat(concat(acc, "/"), p) })
}

fn git_fetch_script(policy: DiffPolicy) -> String {
  let parts = split(s: policy.base, delimiter: "/")
  let remote = parts.first()
  let ref_name = join_slash(parts: parts.skip(n: 1))
  concat(
    concat(concat("git fetch --no-tags ", remote), " "),
    concat(ref_name, " 2>/dev/null || true")
  )
}

// `claim_executor` takes ONLY `--source-root` (to resolve the plan) — it has no
// `--scan-dir` flag and hard-errors on any unknown argument. Scan dirs are carried
// SOLELY by the plan (`ci_floor_plan` discovery batch `scan_dirs` from
// `gunbc.ci_layer_roots.witness_discovery_scan_dirs` → `RunnableDiscoveryBatch.
// scan_dirs`), the single authority for that derivation (DESIGN §3); emitting them
// on the argv too would be a redundant, fail-closed mis-wire (DESIGN §5).
//
// Layer roots: `gunbc.ci_layer_roots.witness_layer_roots` (§3 single authority).

// The dependency-ordered scheduler plan (the single floor topology, DESIGN §3) and
// the host entry the executor evaluates. The scheduler — NOT a flat claim_batch +
// gates pair — is the default CI runtime: both the discovery corpus and the gates
// are scheduler plan nodes (`src/v2/workflow/ci_floor_plan.dag`), run dependency-ordered
// and parallel-where-independent, fail-closed (DESIGN §4/§5).
data floor_plan_entry: String = "src/v2/workflow/ci_floor_plan.dag"
data floor_plan_function: String = "gunbc_ci_floor_batches"

fn scheduler_invoke(spec: CiSpec) -> String {
  concat(
    concat(
      concat(
        concat(concat(claim_executor_bin_shell(), witness_layer_source_flags(roots: witness_layer_roots)), concat(" --plan-entry ", floor_plan_entry)),
        concat(" --plan-function ", floor_plan_function)
      ),
      concat(concat(" --notice-title \"", spec.notice_title), "\"")
    ),
    ""
  )
}

fn gunbc_ci_run_script(spec: CiSpec) -> String {
  concat(
    concat(
      concat(ci_release_build_script(), "\n"),
      concat(git_fetch_script(policy: spec.diff_policy), "\n")
    ),
    scheduler_invoke(spec: spec)
  )
}

fn gunbc_ci_workflow_run(spec: CiSpec) -> String {
  gunbc_ci_run_script(spec: spec)
}
