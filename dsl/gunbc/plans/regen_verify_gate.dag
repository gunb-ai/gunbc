module gunbc.plans.regen_verify_gate

import gunbc.plan { Plan, DissolutionTrigger, HasTrigger }
import std.markdown {
  MarkdownBlock, MarkdownListItem,
  HeadingBlock, ParagraphBlock, OrderedListBlock,
  TextInline, H2,
}

fn h2(text: String) -> MarkdownBlock { HeadingBlock { level: H2, inlines: [TextInline { text: text }] } }
fn p(text: String) -> MarkdownBlock { ParagraphBlock { inlines: [TextInline { text: text }] } }
fn li(text: String) -> MarkdownListItem { MarkdownListItem { blocks: [p(text: text)] } }
fn ol(items: List<MarkdownListItem>) -> MarkdownBlock { OrderedListBlock { items: items } }

fn regen_verify_gate_body() -> List<MarkdownBlock> {
  [
    p(text: "Status: parked design row. Pins the load-bearing operational facts that the `v1_compiler_emit_rust.rs` header carried before the codebase-wide comment ban deleted it (deletion was operator-directed; git history holds the full original at `git show <pre-ban-sha>:src/v1/stage0/src/v1_compiler_emit_rust.rs`). A comment described the regen hazard but enforced nothing — the structural home for the fact is this gate. Breadcrumb: `node://adhoc-80af9ff8-40f` (#5514 deferral)."),
    h2(text: "Why this row exists"),
    p(text: "`src/v1/stage0/src/v1_compiler_emit_rust.rs` is a **hand-synced mirror** of the `.dag` authority, **not** a clean regen fixpoint. There is no `regen --verify` gate, so a blind regen would silently overwrite the two hand-resolved drifts below and regress the wire-policy fix. The protection was always absent; this row makes the fact durable so it rides the gate when it lands."),
    h2(text: "The two hand-resolved local drifts (must be reproduced by a faithful regen)"),
    ol(items: [
      li(text: "**cargo header inlined** — the file inlines its cargo header rather than importing the deliberately-unwired `extdeps_cargo_version` orphan module."),
      li(text: "**policy ref/value alignment at `wire_value_serialize.rs`** — the wire-policy reference/value alignment is hand-resolved here; a naive regen loses it."),
    ]),
    p(text: "All other emitted modules stay byte-identical to the committed seed."),
    h2(text: "Deferral provenance (#5514, verbatim)"),
    p(text: "\"regen-write still emits a non-building seed from ~150 emitter-completeness gaps; the clean green regen fixpoint is deferred, converges with the Route-A emitter self-host.\" A faithful full regen wires the deliberately-unwired orphan std modules (`std_measure`, `std_algebra`, `std_realization_schedule`, `std_machine_constraints`, `std_integer`, `extdeps_version_semver`, `extdeps_cargo_version`) and surfaces ~150 latent emitter-completeness gaps (std numeric / measure-tower generic emission)."),
  ]
}

data regen_verify_gate_plan: Plan = Plan {
  slug: "regen-verify-gate-required-facts",
  title: "regen --verify gate — required facts (carried from the deleted emit_rust header)",
  body: regen_verify_gate_body(),
  dissolution: HasTrigger {
    text: "§7 fixpoint convergence with the Route-A emitter self-host — when wire-all-emitted-modules → regen-equals-committed is in reach, the `regen --verify` gate (a wall: a clean regen must reproduce the committed seed bit-identically) becomes buildable and this row dissolves into it."
  }
}
