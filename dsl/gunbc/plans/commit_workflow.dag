// bind: docs/plans/commit-workflow.md
module gunbc.plans.commit_workflow

import gunbc.plan { Plan, DissolutionTrigger, HasTrigger }
import std.markdown { MarkdownBlock, TableBlock, AlignNone }
import gunbc.plans.md_helpers { h2, h3, p, li, ul, ol, cell, row, quote }

fn commit_workflow_body() -> List<MarkdownBlock> {
  [
    quote(blocks: [
      p(text: "**Status: design sketch (checkpoint 0)** — model frame for parent review *before* further substrate migration. DESIGN §6: priced in displaced cost, not elegance. **#5924 frozen** — `.githooks/pre-push` / `githooks_pre_push_emit.dag` / `local_tidy_spec.dag` are not edited until this sketch is approved and handler re-expression is witnessed byte-identical."),
    ]),
    h2(text: "0. Grounded today — two emitters, one gate vocabulary"),
    p(text: "This is **not speculative**. Gunbc already has two registered `GeneratedArtifact` rows whose committed bytes are drift-gated:"),
    TableBlock {
      header: row(cells: [cell(text: "artifact"), cell(text: "consumer (`RepoConsumer`)"), cell(text: "emit handler"), cell(text: "gate authority imported today")]),
      alignments: [AlignNone, AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [
          cell(text: "`CiYamlArtifact` → `.github/workflows/ci.yml`"),
          cell(text: "`GithubActionsWorkflow`"),
          cell(text: "`gunbc.ci_yaml_emit` ← `gunbc.ci_workflow`"),
          cell(text: "`gunbc.ci_spec` (`gunbc_ci_floor_gates`, `gunbc_ci_rust_job_gates`, `CiSpec`)"),
        ]),
        row(cells: [
          cell(text: "`GithooksPrePushArtifact` → `.githooks/pre-push`"),
          cell(text: "`GitProtocol` (`CommitRequired { consumer: GitProtocol }`)"),
          cell(text: "`gunbc.githooks_pre_push_emit`"),
          cell(text: "`gunbc.ci_spec.Gate` (via `GeneratedArtifactDriftGate`) + `local_tidy_spec` freshness slice (#5924)"),
        ]),
      ],
    },
    p(text: "**Displaced cost:** two parallel emission paths maintain the same commit-time gate facts twice — `ci_workflow` hardwires the CI job graph while `githooks_pre_push_emit` hardwires a overlapping bash slice. Adding a gate today means touching both handlers *and* hoping `local_tidy_checks` stays aligned with `gunbc_ci_*_gates`. The project unifies **two existing emitters**, not a hypothetical Nth provider."),
    h2(text: "1. §3 spine — three facts, one workflow authority"),
    TableBlock {
      header: row(cells: [cell(text: "fact"), cell(text: "owner (layer)"), cell(text: "lives in sketch model as")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [
          cell(text: "**(a) Interface shape** — what runs at commit-time: gate identity, witness entry/fn, exit semantics (`ProcessExit` pass/fail), freshness scoping (path globs)"),
          cell(text: "**workflow** (`gunbc.commit_workflow`)"),
          cell(text: "`CommitCheckRow { kind, exit_shape, freshness }` reusing `gunbc.ci_spec.Gate` + witness channel (no parallel gate enum)"),
        ]),
        row(cells: [
          cell(text: "**(b) Transport** — how the check is invoked on a provider surface"),
          cell(text: "**realization handler** (peripheral)"),
          cell(text: "`CommitWorkflowHandler` arms: `CiYamlHandler` (`ci_yaml_emit`), `GitPrePushScriptHandler` (`githooks_pre_push_emit`); a 3rd provider = **one new handler row**, not a workflow fork"),
        ]),
        row(cells: [
          cell(text: "**(c) Business policy** — which checks run on which provider, auto-stage-on-drift, HEAD-branch fmt auto-fix, diff merge-base for CI"),
          cell(text: "**workflow**"),
          cell(text: "`CommitWorkflowEnrollment { row, providers: List<RepoConsumer> }` + policy fields (`auto_stage_on_drift`, `ci_diff_policy`, …)"),
        ]),
      ],
    },
    p(text: "**Reuse, don't re-coin:** `gunbc.ci_spec` keeps `Gate`, `CiSpec`, `DiffPolicy` as the gate vocabulary; `gunbc.local_tidy_spec` keeps path-glob helpers as **freshness policy** projections, not a second roster authority; `gunbc.generated_artifact` keeps `RepoConsumer` / `CommitPolicy` as the provider registry."),
    h2(text: "2. Model sketch — `gunbc.commit_workflow`"),
    p(text: "Single authority the two handlers project from:"),
    ul(items: [
      li(text: "`CommitWorkflowSpec` — the workflow fact bundle: `checks: List<CommitCheckRow>`, `ci_policy: CiSpec` (existing type), `pre_push_policy: PrePushPolicy` (freshness + auto-fix flags extracted from #5924 emit, not the bash)."),
      li(text: "`CommitCheckRow` — one roster line: `kind: CommitCheckKind` = `SpecGate { gate: Gate }` | `WitnessClaim { entry, fns }` | `CargoFmtSlice` (honest fork: CI runs fmt inside `RustMonolithGate`; pre-push runs fmt-only with auto-fix policy)."),
      li(text: "`CommitCheckEnrollment` — policy row: `check: CommitCheckRow` + `providers: List<RepoConsumer>` (`GithubActionsWorkflow` | `GitProtocol`). **No speculative providers** — only the two consumers registered in `generated_artifact.dag` today; adding e.g. Buildkite is `providers += Buildkite` + one handler arm."),
    ]),
    p(text: "**Projections (legacy compatibility, fail-closed):**"),
    ul(items: [
      li(text: "`project_ci_floor_gates(spec)` → `gunbc_ci_floor_gates` (GithubActionsWorkflow, floor job)"),
      li(text: "`project_ci_rust_job_gates(spec)` → `gunbc_ci_rust_job_gates`"),
      li(text: "`project_local_tidy_checks(spec)` → `local_tidy_checks` (GitProtocol only; witness→gate→fmt order preserved)"),
      li(text: "`project_freshness_globs(spec, row)` → delegates to existing `local_tidy_trigger_globs` helpers (#5924, untouched)"),
    ]),
    h2(text: "3. Handler re-expression — same bytes, one workflow feed"),
    p(text: "Both handlers become **thin realization folds** over `CommitWorkflowSpec` + `RepoConsumer`:"),
    ol(items: [
      li(text: "**`ci_yaml_emit`** — unchanged public surface (`expected_ci_yml()`). Internals: `ci_workflow` builds `Workflow` from `project_ci_jobs(commit_workflow_spec, GithubActionsWorkflow)` instead of importing gate lists directly from `ci_spec` data rows. Checkpoint: `ci_yml_drifted(committed) == false` (existing `GeneratedArtifactDriftGate` / `ci_yaml_gate`)."),
      li(text: "**`githooks_pre_push_emit`** — unchanged public surface (`expected_githooks_pre_push_sh()`). Internals: bash emission walks `project_local_tidy_checks` + `project_freshness_globs` for `GitProtocol`. **#5924 hook bytes frozen** until projection wiring is witnessed; then swap authority import, not hand-edit bash."),
    ]),
    p(text: "Dispatch registry (extends `generated_artifact.dag`, no new artifact types):"),
    TableBlock {
      header: row(cells: [cell(text: "`RepoConsumer`"), cell(text: "handler module"), cell(text: "artifact")]),
      alignments: [AlignNone, AlignNone, AlignNone],
      rows: [
        row(cells: [cell(text: "`GithubActionsWorkflow`"), cell(text: "`ci_yaml_emit` / `ci_workflow`"), cell(text: "`CiYamlArtifact`")]),
        row(cells: [cell(text: "`GitProtocol`"), cell(text: "`githooks_pre_push_emit`"), cell(text: "`GithooksPrePushArtifact`")]),
      ],
    },
    h3(text: "3.1 What we are NOT doing (purity-trap guard)"),
    ul(items: [
      li(text: "No speculative provider handlers (GitLab/Jenkins/…) — a 3rd provider is one `RepoConsumer` row + one handler arm."),
      li(text: "No new parallel gate enum — `Gate` from `ci_spec` stays the vocabulary."),
      li(text: "No pre-push rewrite in the same PR as the authority lift — #5924 emit stays byte-frozen until handler re-expression is proven."),
    ]),
    h2(text: "4. Checkpoint — witnessed before any handler rewire"),
    ul(items: [
      li(text: "**Roster lift:** `project_*` lists match `gunbc_ci_floor_gates`, `gunbc_ci_rust_job_gates`, `local_tidy_checks` (ordered)."),
      li(text: "**Byte identity:** `expected_ci_yml()` and `expected_githooks_pre_push_sh()` unchanged across handler rewire PR (existing drift gates stay green)."),
      li(text: "**Provider registry:** enrollments use only `GithubActionsWorkflow` + `GitProtocol` from `generated_artifact.dag`."),
    ]),
    h2(text: "5. Sequencing (sketch → implement)"),
    ol(items: [
      li(text: "**Checkpoint 0 (this sketch)** — parent review; no #5924 edits. Plan source: `dsl/gunbc/plans/commit_workflow.dag`; `docs/plans/commit-workflow.md` is a review projection — **not** enrolled in `plan_registry` until checkpoint 1b."),
      li(text: "**Checkpoint 1** — land `gunbc.commit_workflow` (`dsl/gunbc/commit_workflow.dag`) model + projection witnesses only (additive; `ci_spec`/`local_tidy_spec` still own data rows). Projections carry `commit_workflow_projection_scaffold` (`Scaffold { dissolves_to: SingleAuthority }`) — parallel-rep until checkpoint 2 inverts authority. **Do not merge checkpoint 1 as authority dissolution.**"),
      li(text: "**Checkpoint 2 — HOLD** (operator scope pending): `ci_spec` gate lists → projections. Load-bearing; do not touch until relay."),
      li(text: "**Checkpoint 3 — HOLD** (operator scope pending): handler re-expression; mandatory byte-identity on `expected_ci_yml()` + `expected_githooks_pre_push_sh()`; #5924 hook bytes frozen (swap authority import only)."),
    ]),
  ]
}

data commit_workflow_plan: Plan = Plan {
  slug: "commit-workflow",
  title: "[SKETCH] Provider-agnostic commit workflow — unify two existing emitters over one gate roster",
  body: commit_workflow_body(),
  dissolution: HasTrigger {
    text: "Delete when `gunbc.commit_workflow` is the sole roster authority, both handlers emit from it byte-identically, and this sketch is superseded by the landed model."
  }
}
