module gunbc.ci_deploy_access

import std.types { NonEmptyStr, List, String, Bool }
import std.access { AccessDecision, Permit, Deny }
import extdeps.shell
import gunbc.fleet_intent { ComputeHost, srv1_host }
import gunbc.host_effect { HostEffectTransport, LocalShell, SshShell }

type PrivilegedCommand {
  path: NonEmptyStr
  check: NonEmptyStr
}

type DeployAccess {
  principal: NonEmptyStr
  host: ComputeHost
  transport: HostEffectTransport
  privileged_commands: List<PrivilegedCommand>
}

type DeployAccessActor {
  principal: NonEmptyStr
  sudo_granted: Bool
}

type DeployAccessVerdict
  = AccessGranted
  | AccessDenied { reason: String }

data deploy_access_refusal_prefix: String = "deploy_access: typed refusal before mutation"

data gunbc_deploy_sudoers_dropin: NonEmptyStr = "/etc/sudoers.d/gunbc-deploy"

data ci_deploy_runner_principal: NonEmptyStr = "runner"

fn srv1_live_deploy_privileged_commands() -> List<PrivilegedCommand> {
  [
    PrivilegedCommand { path: "/usr/bin/bash", check: "-c true" },
    PrivilegedCommand { path: "/usr/bin/apt-get", check: "--help" },
    PrivilegedCommand { path: "/usr/bin/systemctl", check: "--version" },
    PrivilegedCommand { path: "/usr/bin/tailscale", check: "version" },
    PrivilegedCommand { path: "/usr/bin/install", check: "--version" },
  ]
}

fn ci_deploy_srv1_local_access() -> DeployAccess {
  DeployAccess {
    principal: ci_deploy_runner_principal,
    host: srv1_host,
    transport: LocalShell,
    privileged_commands: srv1_live_deploy_privileged_commands(),
  }
}

data ci_deploy_srv1_access: DeployAccess = ci_deploy_srv1_local_access()

fn deploy_access_sudoers_line(access: DeployAccess, cmd: PrivilegedCommand) -> String {
  concat(concat(access.principal, " ALL=(ALL) NOPASSWD: "), cmd.path)
}

fn deploy_access_preflight_check_block(access: DeployAccess, cmd: PrivilegedCommand) -> String {
  let sudoers = deploy_access_sudoers_line(access: access, cmd: cmd)
  concat(
    concat(
      concat(concat("if ! sudo -n ", cmd.path), concat(" ", cmd.check)),
      concat(" >/dev/null 2>&1; then\n  echo \"deploy-access-preflight: FAIL sudo -n ", cmd.path)
    ),
    concat(
      concat(concat(" ", cmd.check), "\"\n"),
      concat(
        concat(concat("  echo \"Add to ", gunbc_deploy_sudoers_dropin), ":\"\n"),
        concat(concat("  echo \"", sudoers), "\"\n  exit 1\nfi\n")
      )
    )
  )
}

fn deploy_access_preflight_script(access: DeployAccess) -> String {
  let checks = fold(
    access.privileged_commands,
    init: "",
    f: (acc, cmd) => concat(acc, deploy_access_preflight_check_block(access: access, cmd: cmd))
  )
  concat(
    concat(
      concat("set -euo pipefail\n", "echo \"deploy-access-preflight: whoami=$(whoami)\"\n"),
      concat(
        concat(
          concat("if [ \"$(whoami)\" != \"", access.principal),
          "\" ]; then\n"
        ),
        concat(
          concat(
            concat(
              concat("  echo \"deploy-access-preflight: FAIL principal mismatch expected=", access.principal),
              " actual=$(whoami)\""
            ),
            "\n  exit 1\nfi\n"
          ),
          checks
        )
      )
    ),
    concat("echo \"deploy-access-preflight: PASS\"\n", "")
  )
}

fn deploy_access_is_local_apply(access: DeployAccess) -> Bool {
  match access.transport {
    LocalShell => true
    SshShell { ssh_host: _ } => false
  }
}

fn deploy_access_sudo_check_cmd(cmd: PrivilegedCommand) -> Bool {
  shell.Exec.Check(
    command: concat(concat(concat("sudo -n ", cmd.path), " "), cmd.check)
  ).exists
}

fn deploy_access_sudo_all_granted(access: DeployAccess) -> Bool {
  fold(
    access.privileged_commands,
    init: true,
    f: (acc, cmd) => if !acc { false } else { deploy_access_sudo_check_cmd(cmd: cmd) }
  )
}

fn deploy_access_observed_principal() -> NonEmptyStr? {
  let result = shell.Exec.Run(script: "whoami")
  if result.success && trim(result.stdout) != "" {
    Present { value: trim(result.stdout) as NonEmptyStr }
  } else {
    Absent
  }
}

fn deploy_access_observed_actor(access: DeployAccess) -> DeployAccessActor? {
  match deploy_access_observed_principal() {
    Present { value: principal } =>
      Present {
        value: DeployAccessActor {
          principal: principal,
          sudo_granted: deploy_access_sudo_all_granted(access: access),
        }
      }
    Absent => Absent
  }
}

fn deploy_access_privileged_fixture_actor(access: DeployAccess) -> DeployAccessActor {
  DeployAccessActor { principal: access.principal, sudo_granted: true }
}

data deploy_access_unprivileged_fixture_principal: NonEmptyStr = "nobody"

fn deploy_access_unprivileged_fixture_actor() -> DeployAccessActor {
  DeployAccessActor { principal: deploy_access_unprivileged_fixture_principal, sudo_granted: false }
}

fn deploy_access_check(access: DeployAccess, actor: DeployAccessActor) -> DeployAccessVerdict {
  if actor.principal != access.principal {
    AccessDenied {
      reason: concat(
        concat(
          concat(deploy_access_refusal_prefix, " — principal mismatch expected="),
          access.principal
        ),
        concat(" actual=", actor.principal)
      )
    }
  } else {
    if actor.sudo_granted {
      AccessGranted
    } else {
      AccessDenied {
        reason: concat(
          deploy_access_refusal_prefix,
          " — privileged commands not granted (sudo -n preflight miss)"
        )
      }
    }
  }
}

fn deploy_access_check_observed(access: DeployAccess) -> DeployAccessVerdict {
  match deploy_access_observed_actor(access: access) {
    Present { value: actor } => deploy_access_check(access: access, actor: actor)
    Absent =>
      AccessDenied {
        reason: concat(
          deploy_access_refusal_prefix,
          " — could not observe principal (whoami failed)"
        )
      }
  }
}

fn deploy_access_verdict_is_granted(v: DeployAccessVerdict) -> Bool {
  match v {
    AccessGranted => true
    AccessDenied { reason: _ } => false
  }
}

fn deploy_access_verdict_to_decision(v: DeployAccessVerdict) -> AccessDecision {
  match v {
    AccessGranted => Permit
    AccessDenied { reason: _ } => Deny
  }
}

fn deploy_access_preflight_pass_message(access: DeployAccess) -> String {
  concat("deploy-access-preflight: PASS principal=", access.principal)
}

data deploy_access_preflight_shell_dissolution_trigger: String = "🟡 dissolve-on: deploy_access_preflight_shell — bash preflight script built with concat/string shell (extends live_deploy medium-as-string debt, #5828); DISSOLVES WHEN live_deploy_emit_shell_dissolution_trigger lands — privileged-command checks modeled as HostEffect intent rows realized through host_effect_apply transport handlers, retiring bash script emit and medium_structure_exception_roster entry for dsl/gunbc/ci_deploy_access.dag"
