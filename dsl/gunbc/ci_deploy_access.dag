module gunbc.ci_deploy_access

import std.types { NonEmptyStr, List, String, Bool }
import gunbc.fleet_intent { ComputeHost, srv1_host }
import gunbc.host_effect { HostEffectTransport, LocalShell, SshShell }
import gunbc.ci_deploy_target_host {
  DeployTargetHostProof,
  deploy_target_proof,
  deploy_target_host_preflight_block,
}

type PrivilegedCommand {
  path: NonEmptyStr
  check: NonEmptyStr
}

type DeployAccess {
  principal: NonEmptyStr
  host: ComputeHost
  transport: HostEffectTransport
  privileged_commands: List<PrivilegedCommand>
}

data gunbc_deploy_sudoers_dropin: NonEmptyStr = "/etc/sudoers.d/gunbc-deploy"

data ci_deploy_runner_principal: NonEmptyStr = "runner"

fn srv1_live_deploy_privileged_commands() -> List<PrivilegedCommand> {
  [
    PrivilegedCommand { path: "/usr/bin/bash", check: "-c true" },
    PrivilegedCommand { path: "/usr/bin/apt-get", check: "--help" },
    PrivilegedCommand { path: "/usr/bin/systemctl", check: "--version" },
    PrivilegedCommand { path: "/usr/bin/tailscale", check: "version" },
    PrivilegedCommand { path: "/usr/bin/install", check: "--version" },
  ]
}

fn ci_deploy_srv1_local_access() -> DeployAccess {
  DeployAccess {
    principal: ci_deploy_runner_principal,
    host: srv1_host,
    transport: LocalShell,
    privileged_commands: srv1_live_deploy_privileged_commands(),
  }
}

data ci_deploy_srv1_access: DeployAccess = ci_deploy_srv1_local_access()

fn deploy_access_sudoers_line(access: DeployAccess, cmd: PrivilegedCommand) -> String {
  concat(concat(access.principal, " ALL=(ALL) NOPASSWD: "), cmd.path)
}

fn deploy_access_preflight_check_block(access: DeployAccess, cmd: PrivilegedCommand) -> String {
  let sudoers = deploy_access_sudoers_line(access: access, cmd: cmd)
  concat(
    concat(
      concat(concat("if ! sudo -n ", cmd.path), concat(" ", cmd.check)),
      concat(" >/dev/null 2>&1; then\n  echo \"deploy-access-preflight: FAIL sudo -n ", cmd.path)
    ),
    concat(
      concat(concat(" ", cmd.check), "\"\n"),
      concat(
        concat(concat("  echo \"Add to ", gunbc_deploy_sudoers_dropin), ":\"\n"),
        concat(concat("  echo \"", sudoers), "\"\n  exit 1\nfi\n")
      )
    )
  )
}

fn deploy_target_proof_from_access(access: DeployAccess) -> DeployTargetHostProof {
  deploy_target_proof(host: access.host.identity, transport: access.transport)
}

fn deploy_target_host_preflight_script(access: DeployAccess) -> String {
  let proof = deploy_target_proof_from_access(access: access)
  concat(
    concat("set -euo pipefail\n", deploy_target_host_preflight_block(proof: proof)),
    ""
  )
}

fn deploy_access_with_ssh_transport(access: DeployAccess, ssh_host: NonEmptyStr) -> DeployAccess {
  DeployAccess {
    principal: access.principal,
    host: access.host,
    transport: SshShell { ssh_host: ssh_host },
    privileged_commands: access.privileged_commands,
  }
}

fn deploy_access_preflight_script(access: DeployAccess) -> String {
  let checks = fold(
    access.privileged_commands,
    init: "",
    f: (acc, cmd) => concat(acc, deploy_access_preflight_check_block(access: access, cmd: cmd))
  )
  concat(
    concat(
      concat("set -euo pipefail\n", "echo \"deploy-access-preflight: whoami=$(whoami)\"\n"),
      concat(
        concat(
          concat("if [ \"$(whoami)\" != \"", access.principal),
          "\" ]; then\n"
        ),
        concat(
          concat(
            concat(
              concat("  echo \"deploy-access-preflight: FAIL principal mismatch expected=", access.principal),
              " actual=$(whoami)\""
            ),
            concat("\n  exit 1\nfi\n", checks)
          )
        )
      )
    ),
    concat("echo \"deploy-access-preflight: PASS\"\n", "")
  )
}

fn deploy_access_is_local_apply(access: DeployAccess) -> Bool {
  match access.transport {
    LocalShell => true
    SshShell { ssh_host: _ } => false
  }
}

data deploy_access_preflight_shell_dissolution_trigger: String = "🟡 dissolve-on: deploy_access_preflight_shell — bash preflight script built with concat/string shell (extends live_deploy medium-as-string debt, #5828); DISSOLVES WHEN live_deploy_emit_shell_dissolution_trigger lands — privileged-command checks modeled as HostEffect intent rows realized through host_effect_apply transport handlers, retiring bash script emit and medium_structure_exception_roster entry for dsl/gunbc/ci_deploy_access.dag"
