module gunbc.ci_deploy_target_host

import std.types { String, NonEmptyStr, Bool, List }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent { ComputeHost }
import gunbc.fleet_intent_network { operator_host_srv1 }
import gunbc.ci_fleet { srv1_offer, ComputeOffer }
import gunbc.host_effect { HostEffectTransport, LocalShell, SshShell }
import gunbc.ci_deploy_access { DeployAccess }
import gunbc.runner_spec_from_offer { runner_spec_from_offer }
import extdeps.github.actions { RunnerSpec, SelfHosted }

type DeployTargetHostProof
  = RunnerIdentityOnHost { host: HostIdentity, pinned_label: NonEmptyStr }
  | SshExplicitHost { host: HostIdentity, ssh_host: NonEmptyStr }

data deploy_target_host_refusal_local: String = "deploy-target-host: FAIL LocalShell apply refused — runner identity does not prove target host"

data deploy_target_host_refusal_ssh: String = "deploy-target-host: FAIL SshShell ssh_host does not match target host identity"

fn deploy_target_proof_from_access(access: DeployAccess) -> DeployTargetHostProof {
  match access.transport {
    LocalShell =>
      RunnerIdentityOnHost {
        host: access.host.identity,
        pinned_label: access.host.identity,
      }
    SshShell { ssh_host: h } =>
      SshExplicitHost { host: access.host.identity, ssh_host: h }
  }
}

fn deploy_target_ssh_proof_structurally_valid(proof: DeployTargetHostProof) -> Bool {
  match proof {
    SshExplicitHost { host: id, ssh_host: h } => h == id
    RunnerIdentityOnHost { host: _, pinned_label: _ } => true
  }
}

fn deploy_target_runner_identity_proves_host(
  proof: DeployTargetHostProof,
  observed_hostname: String,
  observed_runner_name: String
) -> Bool {
  match proof {
    RunnerIdentityOnHost { host: id, pinned_label: _ } =>
      (observed_hostname == id) || string_contains(s: observed_runner_name, pattern: id)
    SshExplicitHost { host: _, ssh_host: _ } => true
  }
}

fn deploy_target_host_apply_permitted(
  proof: DeployTargetHostProof,
  observed_hostname: String,
  observed_runner_name: String
) -> Bool {
  deploy_target_ssh_proof_structurally_valid(proof: proof)
    && deploy_target_runner_identity_proves_host(
      proof: proof,
      observed_hostname: observed_hostname,
      observed_runner_name: observed_runner_name
    )
}

fn deploy_local_apply_refused_for_observed_host(
  access: DeployAccess,
  observed_hostname: String,
  observed_runner_name: String
) -> Bool {
  let proof = deploy_target_proof_from_access(access: access)
  match access.transport {
    LocalShell =>
      !deploy_target_host_apply_permitted(
        proof: proof,
        observed_hostname: observed_hostname,
        observed_runner_name: observed_runner_name
      )
    SshShell { ssh_host: _ } =>
      !deploy_target_ssh_proof_structurally_valid(proof: proof)
  }
}

fn host_pinned_runner_spec(offer: ComputeOffer, host: HostIdentity) -> RunnerSpec {
  match runner_spec_from_offer(offer: offer) {
    SelfHosted { labels: labels } =>
      SelfHosted { labels: concat(labels, [host]) }
    other => other
  }
}

fn gunbc_ci_deploy_srv1_runner_spec() -> RunnerSpec {
  host_pinned_runner_spec(offer: srv1_offer, host: operator_host_srv1)
}

fn deploy_target_host_preflight_block(proof: DeployTargetHostProof) -> String {
  match proof {
    RunnerIdentityOnHost { host: id, pinned_label: _ } =>
      concat(
        concat(
          concat(
            concat(
              "HOSTNAME=\"$(hostname -s 2>/dev/null || hostname)\"\n",
              "RUNNER_NAME=\"${RUNNER_NAME:-}\"\n"
            ),
            concat(
              concat("if [ \"$HOSTNAME\" != \"", id),
              concat("\" ] && ! echo \"$RUNNER_NAME\" | grep -q '", concat(id, "'; then\n"))
            )
          ),
          concat(
            concat(
              concat(
                concat("  echo \"", deploy_target_host_refusal_local),
                concat(" expected=", id)
              ),
              concat(" hostname=$HOSTNAME runner=$RUNNER_NAME\"\n", "  exit 1\nfi\n")
            ),
            concat(concat("echo \"deploy-target-host: PASS host=", id), "\"\n")
          )
        ),
        ""
      )
    SshExplicitHost { host: id, ssh_host: h } =>
      concat(
        concat(concat("echo \"deploy-target-host: PASS SshShell target=", h), concat(" host=", id)),
        "\"\n"
      )
  }
}

fn deploy_access_with_ssh_transport(access: DeployAccess, ssh_host: NonEmptyStr) -> DeployAccess {
  DeployAccess {
    principal: access.principal,
    host: access.host,
    transport: SshShell { ssh_host: ssh_host },
    privileged_commands: access.privileged_commands,
  }
}
