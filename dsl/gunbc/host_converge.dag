  RunnerDeploymentPlan,
  PlanDerived,
  PlanUnsound,
  RunnerHostDeployment,
  runner_deployment_plan,
  workload_class_cpu_weight,
  WorkloadClass,
  BatchLatencyTolerant,
  InteractiveLatencySensitive,
}
import gunbc.ci_floor_measurement {
  SessionReservationMode,
  Regime2AggregateOomd,
  Regime1WorstCase,
  SessionReservationModeUnset,
  SessionAggregateMeasured,
  SessionAggregateUnmeasured,
  gunbc_ci_session_reservation_mode,
}
import gunbc.ci_fleet { fleet_intent_offers }
import gunbc.bmc_onboarding {
  host_onboarding_lifecycle_phase,
  BmcOnboardingPhase,
  FactoryDefault,
  CredentialsRotated,
  OsInstalled,
  FabricJoined,
}
import extdeps.ctrl.gunbc_pin { gunbc_pin_match, gunbc_pin_skewed }
import gunbc.oomd_install { gunbc_oomd_sessions_policy, gunbc_oomd_sessions_slice }
import gunbc.runner_slot_enforcement { gunbc_runner_slot_unit_placeholder }
import extdeps.os.systemd {
  systemd_memory_max_property,
  systemd_memory_swap_max_property,
  systemd_memory_high_property,
  systemd_cpu_weight_property,
}
import extdeps.os.oomd {
  oomd_managed_oom_memory_pressure_property,
  oomd_managed_oom_memory_pressure_limit_property,
  managed_oom_action_value,
  managed_oom_pressure_limit_show_value,
  ManagedOomAuto,
}


data gunbc_cgroup_v2_root: String = "/sys/fs/cgroup"
data gunbc_sessions_legacy_parent_slice: String = "system.slice"

data gunbc_runner_unit_template: String = "actions-runner@.service"
data gunbc_runner_per_slot_dropin_path: String = "/etc/systemd/system/actions-runner@.service.d/20-fleet-width.conf"
data gunbc_runner_per_slot_swap_dropin_path: String = "/etc/systemd/system/actions-runner@.service.d/30-fleet-swap.conf"
data gunbc_runner_per_slot_high_dropin_path: String = "/etc/systemd/system/actions-runner@.service.d/40-fleet-high.conf"
data gunbc_runner_jobserver_env_file: String = "/etc/default/ctrl-jobserver"
data gunbc_runner_jobserver_env_key: String = "CTRL_JOBSERVER_TOKENS"
data gunbc_runner_jobserver_service: String = "ctrl-jobserver.service"

data gunbc_root_env_key: String = "GUNBC_ROOT"

data gunbc_dsl_root_submodule_path: String = "third_party/gunbc"

data gunbc_fleet_operator_unix_home: String = "/home/briansrls"

data gunbc_fleet_operator_unix_user: String = "briansrls"

data gunbc_host_ctrl_checkout_path: String = concat(gunbc_fleet_operator_unix_home, "/ctrl")

data gunbc_host_gunbc_root_path: String = concat(gunbc_fleet_operator_unix_home, "/.local/share/gunbc/pinned")

data gunbc_pinned_tree_desired_label: String = "ctrl:third_party/gunbc"

data gunbc_fleet_pinned_binary_registry: String = "ghcr.io/gunb-ai/gunbc/bootstrap"

data gunbc_fleet_pinned_binary_digest: String = "sha256:BOOTSTRAP_DIGEST_PLACEHOLDER"

data gunbc_fleet_pinned_binary_digest_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_converge",
    decl_name: "gunbc_fleet_pinned_binary_digest",
    field: WholeDeclaration
  }
}

data gunbc_fleet_pinned_binary_name: String = "gunbc"

data gunbc_ctrl_read_pin_script: String = "scripts/session-dashboard/container/read-gunbc-pin.sh"

data gunbc_ctrl_placement_probe_script: String = "scripts/session-dashboard/lib/placement_query.mjs"

data gunbc_ctrl_green_place_marker_path: String = ".dashboard/converge-green-place.marker"

data gunbc_ctrl_green_place_marker_pin_prefix: String = "pin="

data gunbc_ctrl_green_place_marker_ts_prefix: String = "first_green_at="

data gunbc_ctrl_quiescent_reload_hook: String = "scripts/session-dashboard/bin/gunbc-pin-quiescent-reload.mjs"

data gunbc_spawn_retry_backstop_cadence: Second = second(count: 600)

type GreenPlaceReadinessMarker {
  path: String
  pin_prefix: String
  timestamp_prefix: String
}

type SpawnRetryBackstop {
  cadence: Second
  role: String
}

type GunbcPinnedTreeDriftReceipt {
  drift: Bool
  reason: String
  desired_gunbc_root: String
  target_sha: String
  dsl_binding_mode: String
}

type ConvergeVerdict
  = Converged
  | Drifted
  | Absent


fn converge_verdict(effective: String, expected: String) -> ConvergeVerdict {
  if effective == "" { Absent }
  else { if effective == expected { Converged } else { Drifted } }
}

fn converge_verdict_label(v: ConvergeVerdict) -> String {
  match v {
    Converged => "converged"
    Drifted => "drifted"
    Absent => "absent"
  }
}

type ConvergeSlice
  = GunbcSlice
  | RunnerSlice
  | SessionsSlice

fn converge_slice_label(s: ConvergeSlice) -> String {
  match s {
    GunbcSlice => "gunbc"
    RunnerSlice => "runner"
    SessionsSlice => "sessions"
  }
}

type ConvergeApplyMode
  = FreshStandup
  | ExistingHostQuiescentReload

type ConvergeEffectiveSource
  = FileOnDisk
  | ProcessEffective

type ConvergeDoneCondition
  = EffectiveEqualsDesired
  | PinCoherentAndGreenPlaceMarker

type ConvergeLiveApplyPolicy {
  restart: String
  quiescent_window: Bool
  backstop: SpawnRetryBackstop
  reload_hook: String
}

type ConvergeNoOpPolicy
  = BlindApply
  | SkipApplyWhenConverged {
      effective_source: ConvergeEffectiveSource
      done: ConvergeDoneCondition
    }

type DslRootBinding
  = DeferToSubmodule { submodule_path: String }
  | HardPin { path: String }

type GunbcBinaryProvenance
  = PublishedArtifactPull { registry_uri: String, digest: String }
  | BuildBinIfAbsent { bin_name: String }

type GunbcBinaryProvenancePolicy {
  steady: GunbcBinaryProvenance
  bootstrap_fallback: GunbcBinaryProvenance
}

type ConvergeTarget
  = SliceProperty { unit: String, property: String, apply_value: String, expected_effective: String }
  | PerSlotMemoryCap { dropin_path: String, instance_glob: String, property: String, bytes_value: String }
  | RunnerWidth { instance_glob: String }
  | JobserverTokens { env_file: String, env_key: String, service_unit: String }
  | VerifyOnlyCap { slice_unit: String, property: String }
  | GunbcPinnedTree {
      gunbc_root_env_key: String
      gunbc_root_path: String
      dsl_root: DslRootBinding
      ctrl_checkout_path: String
      binary: GunbcBinaryProvenancePolicy
      pin_read_script: String
      green_place_marker: GreenPlaceReadinessMarker
      live_apply: ConvergeLiveApplyPolicy
    }

type ConvergeKnob {
  slice: ConvergeSlice
  name: String
  desired: String
  target: ConvergeTarget
  apply_mode: ConvergeApplyMode
  no_op: ConvergeNoOpPolicy
}

data gunbc_host_converge_knob_apply_semantics_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_converge",
    decl_name: "ConvergeKnob",
    field: WholeDeclaration
  }
}

data gunbc_host_converge_runner_sessions_coupling_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_converge",
    decl_name: "HostConverge",
    field: WholeDeclaration
  }
}

type SessionsMembershipProbe
  = MembershipProbe { slice_cgroup: String, legacy_cgroup: String }
  | NoMembershipProbe

type HostConverge {
  identity: HostIdentity
  knobs: List<ConvergeKnob>
  membership: SessionsMembershipProbe
}

type ConvergePolicy
  = ConvergePolicyDerived { hosts: List<HostConverge> }
  | ConvergePolicyUnsound { reason: String }

fn runner_instance_glob(host: HostIdentity) -> String {
  concat(concat("actions-runner@", host), "-*.service")
}

fn converge_apply_mode_label(m: ConvergeApplyMode) -> String {
  match m {
    FreshStandup => "fresh_standup"
    ExistingHostQuiescentReload => "existing_host_quiescent"
  }
}

fn converge_no_op_policy_label(p: ConvergeNoOpPolicy) -> String {
  match p {
    BlindApply => "blind_apply"
    SkipApplyWhenConverged { effective_source: ProcessEffective, done: PinCoherentAndGreenPlaceMarker } =>
      "skip_process_pin_coherent_and_marker"
    SkipApplyWhenConverged { effective_source: _, done: _ } => "skip_when_converged"
  }
}

fn converge_effective_source_label(s: ConvergeEffectiveSource) -> String {
  match s {
    FileOnDisk => "file_on_disk"
    ProcessEffective => "process_effective"
  }
}

fn converge_done_condition_label(d: ConvergeDoneCondition) -> String {
  match d {
    EffectiveEqualsDesired => "effective_equals_desired"
    PinCoherentAndGreenPlaceMarker => "pin_coherent_and_green_place_marker"
  }
}

fn gunbc_green_place_marker_spec() -> GreenPlaceReadinessMarker {
  GreenPlaceReadinessMarker {
    path: gunbc_ctrl_green_place_marker_path,
    pin_prefix: gunbc_ctrl_green_place_marker_pin_prefix,
    timestamp_prefix: gunbc_ctrl_green_place_marker_ts_prefix,
  }
}

fn gunbc_dashboard_live_apply_policy() -> ConvergeLiveApplyPolicy {
  ConvergeLiveApplyPolicy {
    restart: "quiescent_window_systemd",
    quiescent_window: true,
    backstop: SpawnRetryBackstop {
      cadence: gunbc_spawn_retry_backstop_cadence,
      role: "acknowledged_auto_spawn_retry",
    },
    reload_hook: gunbc_ctrl_quiescent_reload_hook,
  }
}

fn gunbc_sha_triple_coherent(binary_pin: String, dsl_pin: String, ctrl_pin: String) -> Bool {
  gunbc_pin_match(read_pin: binary_pin, desired_pin: ctrl_pin)
    && gunbc_pin_match(read_pin: dsl_pin, desired_pin: ctrl_pin)
    && gunbc_pin_match(read_pin: binary_pin, desired_pin: dsl_pin)
}

fn gunbc_binary_dsl_skewed(binary_pin: String, dsl_pin: String) -> Bool {
  binary_pin != "" && dsl_pin != "" && gunbc_pin_skewed(host_pin: binary_pin, ctrl_pin: dsl_pin)
}

fn gunbc_pinned_drift_receipt(
  reason: String,
  gunbc_root_path: String,
  target_sha: String,
  dsl_binding: DslRootBinding,
) -> GunbcPinnedTreeDriftReceipt {
  GunbcPinnedTreeDriftReceipt {
    drift: true,
    reason: reason,
    desired_gunbc_root: gunbc_root_path,
    target_sha: target_sha,
    dsl_binding_mode: dsl_root_binding_mode(binding: dsl_binding),
  }
}

fn gunbc_process_effective_converged(process_pin: String, ctrl_pin: String) -> Bool {
  gunbc_pin_match(read_pin: process_pin, desired_pin: ctrl_pin)
}

fn gunbc_green_place_marker_satisfied(marker_line: String, marker_pin: String, desired_pin: String) -> Bool {
  marker_line != ""
    && gunbc_pin_match(read_pin: marker_pin, desired_pin: desired_pin)
    && string_contains(s: marker_line, pattern: gunbc_ctrl_green_place_marker_ts_prefix)
}

fn gunbc_pinned_noop_satisfied(
  binary_pin: String,
  dsl_pin: String,
  ctrl_pin: String,
  process_pin: String,
  marker_line: String,
  marker_pin: String,
) -> Bool {
  gunbc_sha_triple_coherent(binary_pin: binary_pin, dsl_pin: dsl_pin, ctrl_pin: ctrl_pin)
    && gunbc_process_effective_converged(process_pin: process_pin, ctrl_pin: ctrl_pin)
    && gunbc_green_place_marker_satisfied(marker_line: marker_line, marker_pin: marker_pin, desired_pin: ctrl_pin)
}

fn dsl_root_binding_mode(binding: DslRootBinding) -> String {
  match binding {
    DeferToSubmodule { submodule_path: _ } => "defer_submodule"
    HardPin { path: _ } => "hard_pin"
  }
}

fn dsl_root_binding_path(binding: DslRootBinding) -> String {
  match binding {
    DeferToSubmodule { submodule_path: sp } => sp
    HardPin { path: p } => p
  }
}

fn gunbc_pinned_binary_provenance_policy() -> GunbcBinaryProvenancePolicy {
  GunbcBinaryProvenancePolicy {
    steady: PublishedArtifactPull {
      registry_uri: gunbc_fleet_pinned_binary_registry,
      digest: gunbc_fleet_pinned_binary_digest,
    },
    bootstrap_fallback: BuildBinIfAbsent { bin_name: gunbc_fleet_pinned_binary_name },
  }
}

fn gunbc_apply_mode_for_host(host: HostIdentity) -> ConvergeApplyMode {
  match host_onboarding_lifecycle_phase(host: host) {
    Present { value: phase } =>
      match phase {
        FactoryDefault => FreshStandup
        CredentialsRotated => FreshStandup
        OsInstalled => ExistingHostQuiescentReload
        FabricJoined => ExistingHostQuiescentReload
      }
    Absent => ExistingHostQuiescentReload
  }
}

fn gunbc_pinned_noop_policy() -> ConvergeNoOpPolicy {
  SkipApplyWhenConverged {
    effective_source: ProcessEffective,
    done: PinCoherentAndGreenPlaceMarker,
  }
}

fn legacy_converge_knob(slice: ConvergeSlice, name: String, desired: String, target: ConvergeTarget) -> ConvergeKnob {
  ConvergeKnob {
    slice: slice,
    name: name,
    desired: desired,
    target: target,
    apply_mode: ExistingHostQuiescentReload,
    no_op: BlindApply,
  }
}

fn slice_numeric_knob(slice: ConvergeSlice, name: String, unit: String, property: String, value: Int) -> ConvergeKnob {
  let v = to_string(value)
  legacy_converge_knob(
    slice: slice,
    name: name,
    desired: v,
    target: SliceProperty { unit: unit, property: property, apply_value: v, expected_effective: v }
  )
}

fn gunbc_pinned_tree_knob(host: HostIdentity) -> ConvergeKnob {
  ConvergeKnob {
    slice: GunbcSlice,
    name: "pinned_tree_sha",
    desired: gunbc_pinned_tree_desired_label,
    target: GunbcPinnedTree {
      gunbc_root_env_key: gunbc_root_env_key,
      gunbc_root_path: gunbc_host_gunbc_root_path,
      dsl_root: DeferToSubmodule { submodule_path: gunbc_dsl_root_submodule_path },
      ctrl_checkout_path: gunbc_host_ctrl_checkout_path,
      binary: gunbc_pinned_binary_provenance_policy(),
      pin_read_script: gunbc_ctrl_read_pin_script,
      green_place_marker: gunbc_green_place_marker_spec(),
      live_apply: gunbc_dashboard_live_apply_policy(),
    },
    apply_mode: gunbc_apply_mode_for_host(host: host),
    no_op: gunbc_pinned_noop_policy(),
  }
}

fn gunbc_pinned_tree_knobs(host: HostIdentity) -> List<ConvergeKnob> {
  [gunbc_pinned_tree_knob(host: host)]
}

fn runner_host_knobs(h: RunnerHostDeployment) -> List<ConvergeKnob> {
  let glob = runner_instance_glob(host: h.identity)
  [
    slice_numeric_knob(
      slice: RunnerSlice,
      name: "runner_slice_cap_bytes",
      unit: gunbc_runner_slot_unit_placeholder,
      property: systemd_memory_max_property,
      value: byte_size_count(b: h.runner_slice_cap)
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "per_slot_memory_max_bytes",
      desired: to_string(byte_size_count(b: h.slot_memory.memory_max)),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_dropin_path,
        instance_glob: glob,
        property: systemd_memory_max_property,
        bytes_value: to_string(byte_size_count(b: h.slot_memory.memory_max)),
      }
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "per_slot_memory_swap_max_bytes",
      desired: to_string(byte_size_count(b: h.slot_memory.memory_swap_max)),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_swap_dropin_path,
        instance_glob: glob,
        property: systemd_memory_swap_max_property,
        bytes_value: to_string(byte_size_count(b: h.slot_memory.memory_swap_max)),
      }
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "per_slot_memory_high_bytes",
      desired: to_string(byte_size_count(b: h.slot_memory.memory_high)),
      target: PerSlotMemoryCap {
        dropin_path: gunbc_runner_per_slot_high_dropin_path,
        instance_glob: glob,
        property: systemd_memory_high_property,
        bytes_value: to_string(byte_size_count(b: h.slot_memory.memory_high)),
      }
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "oom_pressure_auto",
      desired: "true",
      target: SliceProperty {
        unit: gunbc_runner_slot_unit_placeholder,
        property: oomd_managed_oom_memory_pressure_property,
        apply_value: managed_oom_action_value(a: ManagedOomAuto),
        expected_effective: managed_oom_action_value(a: ManagedOomAuto),
      }
    ),
    slice_numeric_knob(
      slice: RunnerSlice,
      name: "cpu_weight",
      unit: gunbc_runner_slot_unit_placeholder,
      property: systemd_cpu_weight_property,
      value: workload_class_cpu_weight(wc: h.workload_class)
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "build_tokens",
      desired: to_string(hardware_thread_count_value(t: h.build_tokens)),
      target: JobserverTokens {
        env_file: gunbc_runner_jobserver_env_file,
        env_key: gunbc_runner_jobserver_env_key,
        service_unit: gunbc_runner_jobserver_service,
      }
    ),
    legacy_converge_knob(
      slice: RunnerSlice,
      name: "runner_count",
      desired: to_string(h.runner_count),
      target: RunnerWidth { instance_glob: glob }
    ),
  ]
}

fn session_host_knobs(slice_max: ByteSize, per_session: ByteSize) -> List<ConvergeKnob> {
  let kill_value = managed_oom_action_value(a: gunbc_oomd_sessions_policy.managed_oom_memory_pressure)
  let pct = to_string(percent_count(p: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit))
  [
    slice_numeric_knob(
      slice: SessionsSlice,
      name: "slice_max_bytes",
      unit: gunbc_oomd_sessions_slice,
      property: systemd_memory_max_property,
      value: byte_size_count(b: slice_max)
    ),
    legacy_converge_knob(
      slice: SessionsSlice,
      name: "per_session_max_bytes",
      desired: to_string(byte_size_count(b: per_session)),
      target: VerifyOnlyCap {
        slice_unit: gunbc_oomd_sessions_slice,
        property: systemd_memory_max_property,
      }
    ),
    legacy_converge_knob(
      slice: SessionsSlice,
      name: "oom_pressure_kill",
      desired: "true",
      target: SliceProperty {
        unit: gunbc_oomd_sessions_slice,
        property: oomd_managed_oom_memory_pressure_property,
        apply_value: kill_value,
        expected_effective: kill_value,
      }
    ),
    legacy_converge_knob(
      slice: SessionsSlice,
      name: "oom_pressure_limit_pct",
      desired: pct,
      target: SliceProperty {
        unit: gunbc_oomd_sessions_slice,
        property: oomd_managed_oom_memory_pressure_limit_property,
        apply_value: concat(pct, "%"),
        expected_effective: to_string(managed_oom_pressure_limit_show_value(p: gunbc_oomd_sessions_policy.managed_oom_memory_pressure_limit)),
      }
    ),
    slice_numeric_knob(
      slice: SessionsSlice,
      name: "cpu_weight",
      unit: gunbc_oomd_sessions_slice,
      property: systemd_cpu_weight_property,
      value: workload_class_cpu_weight(wc: InteractiveLatencySensitive)
    ),
  ]
}

fn session_knobs_by_host(mode: SessionReservationMode) -> List<ConvergeKnob>? {
  match mode {
    SessionReservationModeUnset => none
    Regime1WorstCase { point: _ } => none
    Regime2AggregateOomd { oomd_eviction_ceiling: ceiling, session_concurrency: _, aggregate_reservation: agg } =>
      match agg {
        SessionAggregateUnmeasured => none
        SessionAggregateMeasured { bytes: agg_bytes } =>
          Present { value: session_host_knobs(
            slice_max: agg_bytes,
            per_session: ceiling
          ) }
      }
  }
}

fn sessions_membership_probe(session_knobs: List<ConvergeKnob>) -> SessionsMembershipProbe {
  if session_knobs.length() > 0 {
    MembershipProbe {
      slice_cgroup: concat(concat(gunbc_cgroup_v2_root, "/"), gunbc_oomd_sessions_slice),
      legacy_cgroup: concat(concat(gunbc_cgroup_v2_root, "/"), gunbc_sessions_legacy_parent_slice),
    }
  } else {
    NoMembershipProbe
  }
}

fn host_converge_of(h: RunnerHostDeployment, session_knobs: List<ConvergeKnob>) -> HostConverge {
  HostConverge {
    identity: h.identity,
    knobs: concat(concat(gunbc_pinned_tree_knobs(host: h.identity), runner_host_knobs(h: h)), session_knobs),
    membership: sessions_membership_probe(session_knobs: session_knobs),
  }
}

fn fleet_converge_policy_from(plan: RunnerDeploymentPlan, mode: SessionReservationMode) -> ConvergePolicy {
  match plan {
    PlanUnsound { reason: reason } =>
      ConvergePolicyUnsound { reason: concat("runner deployment unsound: ", reason) }
    PlanDerived { hosts: hosts, fleet_concurrent_runs: _ } => {
      let session_knobs = match session_knobs_by_host(mode: mode) {
        Present { value: ks } => ks
        Absent => []
      }
      ConvergePolicyDerived {
        hosts: map(hosts, h => host_converge_of(h: h, session_knobs: session_knobs)),
      }
    }
  }
}

fn fleet_converge_policy() -> ConvergePolicy {
  fleet_converge_policy_from(plan: runner_deployment_plan(), mode: gunbc_ci_session_reservation_mode)
}
