module gunbc.tailscale_acl_phase2_credential

import std.types { String, NonEmptyStr, Secret, Bool, List }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.cloud.gcp.gcp { GcpProjectId, GcpCredentialFlow, GcpOAuth2AccessTokenStrategy, AdcRefresh }
import extdeps.cloud.gcp.iam { GcpBinding, role_secretmanager_secret_accessor }
import extdeps.cloud.gcp.secret_manager { GcpSecret, utf8_secret_from_access_payload }
import gunbc.assimilate.bmc_token_federation {
  SecretAccessBinding,
  bmc_secrets_project_id,
  bmc_wif_principal_set,
  bmc_assimilator_sa_member,
  bmc_federated_github_repo,
}
import gunbc.tailscale_acl_emit { expected_tailscale_acl_json }
import extdeps.tailscale.acl {
  TailscaleAclPolicy,
  operator_tailscale_acl_policy,
  operator_acl_security_spine_holds,
}

data tailscale_acl_phase2_design_status: String = "DESIGN_ONLY — operator sign-off required before tailscale_acl_upsert_wet lands; operator runs the live ACL write"

data tailscale_acl_api_key_secret_id: NonEmptyStr = "tailscale-acl-api-key"

data tailscale_acl_operator_email: NonEmptyStr = "briansrls@gmail.com"

data tailscale_acl_operator_principal: NonEmptyStr = "user:briansrls@gmail.com"

data tailscale_acl_operator_tailnet: NonEmptyStr = "TAILNET_PLACEHOLDER"

fn operator_principal_member() -> String {
  tailscale_acl_operator_principal as String
}

fn tailscale_acl_secret_resource_name() -> String {
  concat(
    concat(concat("projects/", bmc_secrets_project_id as String), "/secrets/"),
    tailscale_acl_api_key_secret_id as String
  )
}

fn operator_secret_accessor_binding() -> GcpBinding {
  GcpBinding {
    role: role_secretmanager_secret_accessor,
    members: [operator_principal_member()],
    condition: none,
  }
}

data operator_tailscale_acl_secret_bindings: List<SecretAccessBinding> = [
  SecretAccessBinding {
    member: operator_principal_member(),
    role: role_secretmanager_secret_accessor,
    secret: tailscale_acl_api_key_secret_id as String,
    project: bmc_secrets_project_id,
  }
]

data tailscale_acl_credential_flow: GcpCredentialFlow = InteractiveAuth {
  scopes: ["https://www.googleapis.com/auth/secretmanager"]
}

data tailscale_acl_gcp_token_strategy: GcpOAuth2AccessTokenStrategy = AdcRefresh { adc_path: Absent }

fn tailscale_acl_uses_operator_adc_not_wif() -> Bool {
  match tailscale_acl_gcp_token_strategy {
    AdcRefresh { adc_path: _ } => true
    _ => false
  }
}

fn tailscale_acl_admits_repo_scoped_wif() -> Bool {
  false
}

fn tailscale_acl_wif_principal_is_bmc_repo_scope() -> String {
  bmc_wif_principal_set()
}

fn tailscale_acl_operator_binding_excludes_bmc_assimilator() -> Bool {
  fold(
    operator_tailscale_acl_secret_bindings,
    init: true,
    f: (acc, b) => acc && (b.member != bmc_assimilator_sa_member())
  )
}

fn tailscale_acl_operator_binding_excludes_wif_principal() -> Bool {
  fold(
    operator_tailscale_acl_secret_bindings,
    init: true,
    f: (acc, b) => acc && (b.member != bmc_wif_principal_set())
  )
}

fn tailscale_acl_operator_binding_is_user_principal_only() -> Bool {
  (length(operator_tailscale_acl_secret_bindings) == 1)
    && operator_tailscale_acl_secret_bindings.first().member == operator_principal_member()
    && operator_tailscale_acl_secret_bindings.first().role == role_secretmanager_secret_accessor
    && operator_tailscale_acl_secret_bindings.first().project == bmc_secrets_project_id
    && operator_tailscale_acl_secret_bindings.first().secret == (tailscale_acl_api_key_secret_id as String)
}

type OperatorAdcIdentityGate
  = IdentityVerified { principal: NonEmptyStr }
  | IdentityMismatch { observed: String, required: NonEmptyStr }
  | IdentityUnverified { reason: String }

data tailscale_acl_identity_gate_refusal: String = "tailscale_acl:operator_adc_identity_unverified — refuse Secret Manager access unless local ADC resolves to user:briansrls@gmail.com"

fn operator_adc_identity_required() -> NonEmptyStr {
  tailscale_acl_operator_principal
}

type AclPolicyDiff
  = PoliciesMatch
  | PoliciesDiffer { emitted: String, live: String }

type AclUpsertGate
  = DiffPending { diff: AclPolicyDiff }
  | OperatorConfirmed { emitted: String }
  | RefusedAutoUpsert { reason: String }

fn acl_diff_from_authority(live_json: String) -> AclPolicyDiff {
  let emitted = expected_tailscale_acl_json()
  if emitted == live_json {
    PoliciesMatch
  } else {
    PoliciesDiffer { emitted: emitted, live: live_json }
  }
}

fn acl_upsert_permitted(gate: AclUpsertGate) -> Bool {
  match gate {
    OperatorConfirmed { emitted: _ } => true
    _ => false
  }
}

fn acl_auto_upsert_refused(gate: AclUpsertGate) -> Bool {
  match gate {
    RefusedAutoUpsert { reason: _ } => true
    DiffPending { diff: _ } => true
    OperatorConfirmed { emitted: _ } => false
  }
}

fn tailscale_acl_upsert_preflight(policy: TailscaleAclPolicy) -> Bool {
  operator_acl_security_spine_holds(policy: policy)
}

data tailscale_acl_phase2_live_write_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.tailscale_acl_phase2_credential",
    decl_name: "tailscale_acl_upsert_wet",
    field: WholeDeclaration
  }
}

fn tailscale_acl_phase2_credential_design_holds() -> Bool {
  tailscale_acl_uses_operator_adc_not_wif()
    && !tailscale_acl_admits_repo_scoped_wif()
    && tailscale_acl_operator_binding_is_user_principal_only()
    && tailscale_acl_operator_binding_excludes_bmc_assimilator()
    && tailscale_acl_operator_binding_excludes_wif_principal()
}
