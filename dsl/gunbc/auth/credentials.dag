// gunbc/auth/credentials.dag -- Concrete gunbc credential acquisition bindings.
//
// This module binds provider-neutral credential needs to concrete runtime
// mechanisms. It is intentionally not part of std/: these patterns depend on
// a specific provider and local runtime tooling.

module gunbc.auth.credentials

import extdeps.cloud.gcp.gcp
import extdeps.cloud.gcp.secret_manager
import std.resources { Network }
import std.types { NonEmptyStr }

// Acquire a credential from GCP Secret Manager via the canonical REST interface.
//
// Local dev composes gcloud auth (shell transport) with Secret Manager REST
// (gcp.SecretManager.AccessVersion) — one interface shape, two realization
// handlers (DESIGN.md §3), not a forked duplicate of the access endpoint.

pattern gcp_secret_credential(
  project_id: NonEmptyStr,
  secret_name: NonEmptyStr,
  version: NonEmptyStr = "latest"
) -> { token: Secret }
  uses net: Network
{
  auth = shell.GCloud.AuthPrintAccessToken()
  result = gcp.SecretManager.AccessVersion(
    access_token: auth.access_token,
    project_id: project_id,
    secret: secret_name,
    version: version
  )
  return { token: utf8_secret_from_access_payload(payload: result.payload) }
}
