// gunbc/auth/credentials.dag -- Concrete gunbc credential acquisition bindings.
//
// This module binds provider-neutral credential needs to concrete runtime
// mechanisms. It is intentionally not part of std/: these patterns depend on
// a specific provider and local runtime tooling.

module gunbc.auth.credentials

import std.resources { Network }
import std.types { NonEmptyStr }

// Acquire a credential from GCP Secret Manager through the local gcloud CLI.
//
// This is the standard materialization path for locally-managed secrets when
// Secret Manager is the system of record. The active gcloud account provides
// access; the retrieved secret value is returned as a Secret.

pattern gcp_secret_credential(
  project_id: NonEmptyStr,
  secret_name: NonEmptyStr,
  version: NonEmptyStr = "latest"
) -> { token: Secret }
  uses net: Network
{
  result = shell.GCloud.SecretManagerAccessVersion(
    project_id: project_id,
    secret_name: secret_name,
    version: version
  )
  return { token: result.secret_value }
}
