// gunbc/auth/patterns.dag -- Gunbc-specific auth composition.
//
// These patterns intentionally live outside std/: they compose concrete
// runtime environments, provider services, and local tooling to materialize
// credentials and auth contexts.

module gunbc.auth.patterns

import std.resources { Filesystem, Network, AuthContext }
import std.types {
  AccessToken,
  AuthScheme,
  NonEmptyStr,
  GcpProjectId,
  ServiceAccountEmail
}
import extdeps.cloud.gcp.gcp
import extdeps.cloud.gcp.secret_manager
import extdeps.cloud.gcp.iam
import extdeps.cloud.gcp.sts
import extdeps.cloud.gcp.sts { MetadataRuntime }
import extdeps.github.actions { GitHubActionsRuntime }
import extdeps.runtime.local { LocalDevRuntime }
import extdeps.shell

// 🟢 terminal coproduct: consumer-owned auth runtime choice; each payload lives in its discrete concern home.
type AuthRuntime
  = GitHubActions { runtime: GitHubActionsRuntime }
  | GcpMetadata { runtime: MetadataRuntime }
  | LocalDev { runtime: LocalDevRuntime }

// Acquire a subject token based on runtime environment.
// Useful independently for: any workflow that needs a subject token
// without the full credential chain (e.g., direct STS exchange,
// non-GCP federated auth).

pattern acquire_subject_token(
  runtime: AuthRuntime,
  audience: NonEmptyStr
) -> { token: Secret } {
  node token = match runtime {
    GitHubActions { runtime: github_actions } => github_oidc(audience: audience, runtime: github_actions)
    GcpMetadata { runtime: _ } => metadata_oidc(audience: audience)
    LocalDev { runtime: _ } => metadata_oidc(audience: audience)  // placeholder: local_auth() needs if/else expression support
  }
  return { token: token.token }
}

// Optionally impersonate a service account.
// Passes through the original token when no SA is specified.
// Useful independently for: any workflow that needs conditional
// SA impersonation outside of the credential chain.

pattern optional_impersonation(
  access_token: Secret,
  service_account: ServiceAccountEmail?,
  lifetime_seconds: Int where range(min: 1, max: 3600)= 3600
) -> { token: Secret } {
  impersonated = gcp.IAM.GenerateAccessToken(
    access_token: access_token,
    target_sa: service_account,
    lifetime_seconds: lifetime_seconds
  ) [when service_account != none]
  let result_token = match service_account {
    Present { value: _sa } => impersonated.access_token
    Absent => access_token
  }
  return { token: result_token }
}

fn build_token(payload: Secret, scheme: AuthScheme, header_name: String, source_id: String, required_scopes: List<String>) -> AccessToken {
  { token: payload, scheme: scheme, expires_at: none }
}

// OIDC -> STS -> optional impersonation -> secret access -> credential.
// Composes fundamental auth steps with GCP service calls.

pattern credential_chain(
  runtime: AuthRuntime,
  audience: NonEmptyStr,
  service_account: ServiceAccountEmail?,
  secret_name: NonEmptyStr,
  project_id: GcpProjectId,
  scheme: String = "Bearer",
  header_name: String?,
  source_id: NonEmptyStr,
  required_scopes: List<String>,
  lifetime_seconds: Int where range(min: 1, max: 3600)= 3600
) -> { token: AccessToken }
  uses net: Network
  // provides auth: AuthContext  -- commented: parser doesn't support provides yet
{
  node subject: acquire_subject_token(runtime: runtime, audience: audience)

  node access: gcp.STS.Exchange(
    subject_token: subject.token,
    audience: audience
  )

  node impersonated: optional_impersonation(
    access_token: access.access_token,
    service_account: service_account,
    lifetime_seconds: lifetime_seconds
  )

  node secret: gcp.SecretManager.AccessVersion(
    access_token: impersonated.token,
    project_id: project_id,
    secret: secret_name
  )

  return {
    token: build_token(
      payload: secret.payload,
      scheme: scheme,
      header_name: header_name,
      source_id: source_id,
      required_scopes: required_scopes
    )
  }
}

// Real implementations replacing stubs. Each acquires a subject token
// from the runtime environment using the appropriate protocol.

func github_oidc(audience: String, runtime: GitHubActionsRuntime) -> { token: Secret }
  uses net: Network
{
  url = shell.Env.Get(name: runtime.oidc_request_url_env)
  auth = shell.Env.Get(name: runtime.oidc_request_token_env)

  response = github.OIDC.GetToken(
    audience: audience,
    request_url: url.value,
    request_token: auth.value
  )
  return { token: response.subject_token as String }
}

func metadata_oidc(audience: String) -> { token: Secret }
  uses net: Network
{
  response = gcp.Metadata.GetIdentityToken(audience: audience)
  return { token: response.subject_token as String }
}

