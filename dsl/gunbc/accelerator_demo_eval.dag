module gunbc.accelerator_demo_eval

import std.types { Int, List }
import std.realization_width { int_max }
import gunbc.accelerator_demo_program {
  AcceleratorDemoProgram,
  PureElementwiseMap,
  EffectfulElementwiseMap,
  DataDependentGatherMap,
  ElementwiseArrayOp,
  ElemwiseMul,
  ElemwiseAdd,
  ElemwiseRelu,
}

fn int_relu(x: Int) -> Int {
  int_max(a: 0, b: x)
}

fn eval_elementwise_ops_at_index(
  ops: List<ElementwiseArrayOp>,
  ai: Int,
  bi: Int,
  ci: Int,
  acc: Int,
  phase: Int
) -> Int {
  match ops.first() {
    Absent =>
      if phase == 2 {
        int_relu(x: acc)
      } else {
        0
      }
    Present { value: op } =>
      let tail = ops.skip(n: 1)
      match op {
        ElemwiseMul =>
          eval_elementwise_ops_at_index(
            ops: tail,
            ai: ai,
            bi: bi,
            ci: ci,
            acc: ai * bi,
            phase: 1
          )
        ElemwiseAdd =>
          if phase != 1 {
            0
          } else {
            eval_elementwise_ops_at_index(
              ops: tail,
              ai: ai,
              bi: bi,
              ci: ci,
              acc: acc + ci,
              phase: 2
            )
          }
        ElemwiseRelu =>
          if tail.length() != 0 {
            0
          } else if phase != 2 {
            0
          } else {
            int_relu(x: acc)
          }
      }
  }
}

fn eval_pure_map_at_indices(
  ops: List<ElementwiseArrayOp>,
  a: List<Int>,
  b: List<Int>,
  c: List<Int>,
  acc: List<Int>
) -> List<Int> {
  match a.first() {
    Absent => acc
    Present { value: ai } =>
      match b.first() {
        Absent => acc
        Present { value: bi } =>
          match c.first() {
            Absent => acc
            Present { value: ci } =>
              eval_pure_map_at_indices(
                ops: ops,
                a: a.skip(n: 1),
                b: b.skip(n: 1),
                c: c.skip(n: 1),
                acc: concat(
                  acc,
                  [
                    eval_elementwise_ops_at_index(
                      ops: ops,
                      ai: ai,
                      bi: bi,
                      ci: ci,
                      acc: 0,
                      phase: 0
                    ),
                  ]
                )
              )
          }
      }
  }
}

fn eval_accelerator_program(
  program: AcceleratorDemoProgram,
  a: List<Int>,
  b: List<Int>,
  c: List<Int>
) -> List<Int> {
  match program {
    PureElementwiseMap { ops: ops } =>
      eval_pure_map_at_indices(ops: ops, a: a, b: b, c: c, acc: [])
    EffectfulElementwiseMap { ops: _ } => []
    DataDependentGatherMap { ops: _ } => []
  }
}
