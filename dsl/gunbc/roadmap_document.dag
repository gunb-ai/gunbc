module gunbc.roadmap_document

import std.markdown { MarkdownDocument, MarkdownBlock }
import gunbc.roadmap_model { RoadmapNode, RoadmapEdge }
import gunbc.roadmap_emit { project_roadmap_section }

type RoadmapSection {
  title: String
  nodes: List<RoadmapNode>
  edges: List<RoadmapEdge>
}

type RoadmapDocument {
  preamble: List<MarkdownBlock>
  sections: List<RoadmapSection>
}

fn section_blocks(s: RoadmapSection, merged: List<Int>) -> List<MarkdownBlock> {
  project_roadmap_section(title: s.title, nodes: s.nodes, edges: s.edges, merged: merged).blocks
}

fn project_roadmap_to_markdown(doc: RoadmapDocument, merged: List<Int>) -> MarkdownDocument {
  MarkdownDocument {
    blocks: fold(doc.sections, init: doc.preamble, f: fn(acc, s) {
      concat(acc, section_blocks(s: s, merged: merged))
    })
  }
}
