module gunbc.host_identity_access

import std.types { List, NonEmptyStr }
import gunbc.fleet_intent { srv1_host }
import gunbc.fleet_intent_network { operator_host_srv1 }
import gunbc.host_effect { HostEffectTransport, SshShell }
import gunbc.ci_deploy_access {
  DeployAccess,
  PrivilegedCommand,
  deploy_access_with_ssh_transport,
}

data host_identity_hostnamectl_path: NonEmptyStr = "/usr/bin/hostnamectl"

data host_identity_srv1_ssh_principal: NonEmptyStr = "briansrls"

fn host_identity_privileged_commands() -> List<PrivilegedCommand> {
  [
    PrivilegedCommand { path: host_identity_hostnamectl_path, check: "--version" },
  ]
}

fn host_identity_srv1_ssh_access() -> DeployAccess {
  DeployAccess {
    principal: host_identity_srv1_ssh_principal,
    host: srv1_host,
    transport: SshShell { ssh_host: operator_host_srv1 as NonEmptyStr },
    privileged_commands: host_identity_privileged_commands(),
  }
}

data host_identity_srv1_access: DeployAccess = host_identity_srv1_ssh_access()
