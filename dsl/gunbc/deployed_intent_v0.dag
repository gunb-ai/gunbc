module gunbc.deployed_intent_v0

import std.types { String, NonEmptyStr, Bool }
import std.disposition { Disposition, Terminal }
import product.placement_supply { HostIdentity }
import gunbc.fleet_intent { ComputeHost, srv1_host, srv2_host }
import gunbc.fleet_intent_network { operator_host_srv1, operator_host_srv2 }
import gunbc.host_identity_observation {
  HostIdentityObservation,
  HostIdentityObservationRow,
  gunbc_srv1_host_identity_observation_fixture_row,
  gunbc_srv2_host_identity_observation_fixture_row,
  host_identity_observation_typed,
  fixture_host_identity_observation,
}

type DeployedIntentV0 {
  fleet_slot: HostIdentity
  target_host: ComputeHost
  observation: HostIdentityObservation
}

data gunbc_deployed_intent_v0_scope_disposition: Disposition = Terminal {
  reason: "ADOPT-BASE phase-0 carrier: the DeployedIntentV0 type IS the observed-base shape — records live-read hostname observation, explicitly NOT fleet design-intent identity (operator_host_srv*). Design intent is a later-phase type; no base_kind tag (§2: v0 is observed-only by construction, not by predicate over a dead coproduct arm). PERSISTED base: gunbc_srv1_deployed_intent_v0_persisted and gunbc_srv2_deployed_intent_v0_persisted are the checked-in adopt-once receipts — a committed .dag data row IS the persistence carrier (survives across runs, git-tracked, read as INPUT by converge-from-base). Closed-loop converge takes a DeployedIntentV0 as an argument; it never re-derives one from a live read (that would silently adopt drift as the new base every run, defeating the three-way conflict check)."
}

fn deployed_intent_v0_adopt_observed_base(
  fleet_slot: HostIdentity,
  target_host: ComputeHost,
  observation: HostIdentityObservation,
) -> DeployedIntentV0 {
  DeployedIntentV0 {
    fleet_slot: fleet_slot,
    target_host: target_host,
    observation: observation,
  }
}

fn deployed_intent_observed_short_hostname(d: DeployedIntentV0) -> String {
  d.observation.short_hostname
}

fn deployed_intent_observed_differs_from_fleet_slot(d: DeployedIntentV0) -> Bool {
  deployed_intent_observed_short_hostname(d: d) != d.fleet_slot
}

fn deployed_intent_v0_from_observation_row(
  fleet_slot: HostIdentity,
  target_host: ComputeHost,
  row: HostIdentityObservationRow,
) -> DeployedIntentV0 {
  deployed_intent_v0_adopt_observed_base(
    fleet_slot: fleet_slot,
    target_host: target_host,
    observation: host_identity_observation_typed(row: row),
  )
}

fn deployed_intent_v0_srv1_fixture() -> DeployedIntentV0 {
  deployed_intent_v0_adopt_observed_base(
    fleet_slot: operator_host_srv1,
    target_host: srv1_host,
    observation: fixture_host_identity_observation(),
  )
}

data gunbc_srv1_deployed_intent_v0_persisted: DeployedIntentV0 = deployed_intent_v0_from_observation_row(
  fleet_slot: operator_host_srv1,
  target_host: srv1_host,
  row: gunbc_srv1_host_identity_observation_fixture_row,
)

data gunbc_srv2_deployed_intent_v0_persisted: DeployedIntentV0 = deployed_intent_v0_from_observation_row(
  fleet_slot: operator_host_srv2,
  target_host: srv2_host,
  row: gunbc_srv2_host_identity_observation_fixture_row,
)
