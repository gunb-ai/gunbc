module gunbc.srv3_os_install_diagnostic

import std.types { NonEmptyStr, Bool, Int, String, ContentHash, Milliseconds, List }
import std.measure { ByteSize, byte_size }
import std.disposition { Disposition, Terminal }
import extdeps.bmc.types {
  RedfishPowerState,
  RedfishBootSourceOverrideTarget,
  RedfishBootSourceOverrideEnabled,
  BootTargetCd,
  BootOverrideOnce,
  BootOverrideDisabled,
  On,
  Off,
}
import extdeps.bmc.webui.nbd_proxy_serve { srv3_nbd_proxy_local_port }
import extdeps.boards.asrock_rack { asrock_srv3_live_bmc_host }
import extdeps.dhcp.v4 {
  DhcpLeaseObservation,
  DynamicDhcpLease,
  StaticDhcpReservation,
  Active,
}
import extdeps.router.verizon_cr1000a { Cr1000aDhcpLeaseTable }
import gunbc.fleet_intent_network { operator_host_srv1, operator_host_srv3 }
import gunbc.network_identity_subsumption {
  network_identity_subsumes_fleet_slot,
  lease_table_has_os_up_subsumption,
  srv3_pre_install_lease_table,
  srv3_post_install_lease_table_fixture,
  srv3_bmc_static_lease_row,
}
import gunbc.srv3_os_install_actuate_scope { srv3_actuator_virtual_media_iso_install_path }
import gunbc.srv3_seeded_install_media { srv3_seeded_install_media_content_hash }
import product.placement_supply { HostIdentity }

data gunbc_srv3_os_install_diagnostic_scope_disposition: Disposition = Terminal {
  reason: "srv3 OS install actuation diagnostic fold — multi-surface observation (nbd serve, BMC session, Redfish system boot/power, virtual media, SOL console, router DHCP lease, weak KVM) over InstallAttemptIntent → InstallDiagnosticVerdict; KVM frozen/keyboard-dead is weak evidence only."
}

data srv3_os_install_diagnostic_runbook_section: NonEmptyStr = "docs/runbooks/srv3-os-install-actuate.md#install-debug-diagnostic-fold"

data srv3_install_hang_no_installer_progress_ms: Milliseconds = 900000

data srv3_install_hang_no_router_lease_ms: Milliseconds = 4500000

type OsInstallObservationSurface
  = ObserveNbdServe
  | ObserveBmcSession
  | ObserveRedfishSystem
  | ObserveVirtualMedia
  | ObserveSolConsole
  | ObserveRouterLease
  | ObserveKvmWeak

data bmc_install_debug_checklist_surfaces: List<OsInstallObservationSurface> = [
  ObserveNbdServe,
  ObserveBmcSession,
  ObserveRedfishSystem,
  ObserveVirtualMedia,
  ObserveSolConsole,
  ObserveRouterLease,
  ObserveKvmWeak,
]

type OsInstallAttemptIntent {
  target_host: HostIdentity
  actuator_host: HostIdentity
  bmc_endpoint: NonEmptyStr
  iso_path: NonEmptyStr
  iso_content_hash: ContentHash
  expected_hostname: NonEmptyStr
  boot_source: RedfishBootSourceOverrideTarget
  boot_override: RedfishBootSourceOverrideEnabled
  serve_port: Int
}

data srv3_os_install_attempt_intent: OsInstallAttemptIntent = OsInstallAttemptIntent {
  target_host: operator_host_srv3,
  actuator_host: operator_host_srv1,
  bmc_endpoint: asrock_srv3_live_bmc_host,
  iso_path: srv3_actuator_virtual_media_iso_install_path,
  iso_content_hash: srv3_seeded_install_media_content_hash,
  expected_hostname: "srv3" as NonEmptyStr,
  boot_source: BootTargetCd,
  boot_override: BootOverrideOnce,
  serve_port: srv3_nbd_proxy_local_port,
}

type NbdServeProcessObservation
  = NbdkitAbsent
  | WebsocatAbsent
  | ServeProcessesPresent

type NbdServePortObservation
  = ServePortAbsent
  | ServePortListening { port: Int, owner_matches_expected: Bool }
  | ServePortConflict

type BmcSessionTokenObservation
  = TokenMissing
  | TokenPresent

type IsoServeReadinessObservation
  = IsoMissing
  | IsoPresent { observed_content_hash: ContentHash }

type NbdServeReadinessVerdict
  = ServeAbsent
  | ServePortAbsent
  | ServePortConflict
  | TokenMissing
  | IsoMissing
  | IsoHashMismatch
  | ServeReady

type RedfishBootProgressLastState
  = BootProgressUnknown
  | BootProgressNone
  | BootProgressSetupEntered
  | BootProgressOsBootStarted
  | BootProgressOsRunning

type RedfishSystemBootObservation {
  power_state: RedfishPowerState
  boot_override_enabled: RedfishBootSourceOverrideEnabled
  boot_override_target: RedfishBootSourceOverrideTarget
  boot_progress: RedfishBootProgressLastState
}

type RedfishSystemBootVerdict
  = PowerOff
  | PowerOnFirmware
  | BootOverrideCdOnceArmed
  | BootOverrideDisabledAfterAttempt
  | BootProgressSetupEnteredVerdict
  | BootProgressOsBootStartedVerdict
  | BootProgressOsRunningVerdict

type BmcVirtualMediaObservation {
  inserted_or_connected: Bool
  image_or_endpoint: NonEmptyStr?
  connected_to_expected_port: Bool
  bmc_session_valid: Bool
}

type BmcVirtualMediaVerdict
  = VirtualMediaMountedExpectedIso
  | VirtualMediaAbsent
  | VirtualMediaWrongIso
  | VirtualMediaDisconnected
  | BmcSessionExpired

type SolConsoleContentObservation {
  bytes_captured: ByteSize
  duration_ms: Milliseconds
  contains_grub: Bool
  contains_subiquity: Bool
  contains_autoinstall: Bool
  contains_firmware_menu: Bool
  contains_error: Bool
  capture_available: Bool
}

type SolConsoleDiagnosticVerdict
  = SolSilent
  | SolFirmwareMenu
  | SolGrubSeen
  | SolInstallerSeen
  | SolAutoinstallSeen
  | SolErrorSeen
  | SolCaptureUnavailable

type RouterLeaseDiagnosticVerdict
  = Srv3OsLeaseAbsent
  | Srv3OsLeasePresent
  | WrongHostnameLeasePresent
  | OnlyBmcLeasePresent

type KvmVideoState
  = KvmIdle
  | KvmFirmwareMenu
  | KvmUnknown

type KvmObservation {
  video_state: KvmVideoState
  keyboard_accepted: Bool
}

type KvmDiagnosticVerdict
  = KvmUntrusted
  | KvmWeakInconclusive

type OsInstallActuationObservations {
  serve_process: NbdServeProcessObservation
  serve_port: NbdServePortObservation
  bmc_session: BmcSessionTokenObservation
  iso_readiness: IsoServeReadinessObservation
  redfish_system: RedfishSystemBootObservation
  virtual_media: BmcVirtualMediaObservation
  sol_console: SolConsoleContentObservation
  router_lease_table: Cr1000aDhcpLeaseTable
  kvm: KvmObservation
  elapsed_since_boot_once_ms: Milliseconds
}

type InstallDiagnosticVerdict
  = ReadyToBoot
  | VirtualMediaServeDown
  | VirtualMediaNotMounted
  | BootOverrideNotSet
  | BootOverrideConsumedNoInstall
  | BootAttemptInProgress
  | FirmwareIdle
  | InstallerBooted
  | AutoinstallRunning
  | InstallerHung
  | OsInstalled
  | KvmUntrustedVerdict
  | Inconclusive

fn classify_nbd_serve_readiness(
  process: NbdServeProcessObservation,
  port: NbdServePortObservation,
  session: BmcSessionTokenObservation,
  iso: IsoServeReadinessObservation,
  intent: OsInstallAttemptIntent,
) -> NbdServeReadinessVerdict {
  match process {
    NbdkitAbsent => ServeAbsent
    WebsocatAbsent => ServeAbsent
    ServeProcessesPresent =>
      match session {
        TokenMissing => TokenMissing
        TokenPresent =>
          match iso {
            IsoMissing => IsoMissing
            IsoPresent { observed_content_hash: observed } =>
              if observed != intent.iso_content_hash {
                IsoHashMismatch
              } else {
                match port {
                  ServePortAbsent => ServePortAbsent
                  ServePortConflict => ServePortConflict
                  ServePortListening { port: p, owner_matches_expected: owner_ok } =>
                    if p != intent.serve_port || !owner_ok {
                      ServePortConflict
                    } else {
                      ServeReady
                    }
                }
              }
          }
      }
  }
}

fn nbd_serve_readiness_is_ready(verdict: NbdServeReadinessVerdict) -> Bool {
  match verdict {
    ServeReady => true
    ServeAbsent => false
    ServePortAbsent => false
    ServePortConflict => false
    TokenMissing => false
    IsoMissing => false
    IsoHashMismatch => false
  }
}

fn classify_redfish_system_boot(obs: RedfishSystemBootObservation) -> RedfishSystemBootVerdict {
  match obs.boot_progress {
    BootProgressOsRunning => BootProgressOsRunningVerdict
    BootProgressOsBootStarted => BootProgressOsBootStartedVerdict
    BootProgressSetupEntered => BootProgressSetupEnteredVerdict
    BootProgressNone =>
      match obs.power_state {
        Off => PowerOff
        On =>
          match obs.boot_override_enabled {
            BootOverrideOnce =>
              if obs.boot_override_target == BootTargetCd {
                BootOverrideCdOnceArmed
              } else {
                PowerOnFirmware
              }
            BootOverrideDisabled => BootOverrideDisabledAfterAttempt
            _ => PowerOnFirmware
          }
        _ => PowerOnFirmware
      }
    BootProgressUnknown =>
      match obs.power_state {
        Off => PowerOff
        On =>
          match obs.boot_override_enabled {
            BootOverrideOnce =>
              if obs.boot_override_target == BootTargetCd {
                BootOverrideCdOnceArmed
              } else {
                PowerOnFirmware
              }
            BootOverrideDisabled => BootOverrideDisabledAfterAttempt
            _ => PowerOnFirmware
          }
        _ => PowerOnFirmware
      }
  }
}

fn classify_bmc_virtual_media(
  obs: BmcVirtualMediaObservation,
  intent: OsInstallAttemptIntent,
) -> BmcVirtualMediaVerdict {
  if !obs.bmc_session_valid {
    BmcSessionExpired
  } else if !obs.inserted_or_connected {
    VirtualMediaAbsent
  } else if !obs.connected_to_expected_port {
    VirtualMediaDisconnected
  } else {
    match obs.image_or_endpoint {
      Present { value: endpoint } =>
        if string_contains(s: endpoint as String, pattern: intent.iso_path as String) {
          VirtualMediaMountedExpectedIso
        } else {
          VirtualMediaWrongIso
        }
      Absent => VirtualMediaAbsent
    }
  }
}

fn classify_sol_console(obs: SolConsoleContentObservation) -> SolConsoleDiagnosticVerdict {
  if !obs.capture_available {
    SolCaptureUnavailable
  } else if obs.contains_error {
    SolErrorSeen
  } else if obs.contains_autoinstall {
    SolAutoinstallSeen
  } else if obs.contains_subiquity {
    SolInstallerSeen
  } else if obs.contains_grub {
    SolGrubSeen
  } else if obs.contains_firmware_menu {
    SolFirmwareMenu
  } else {
    SolSilent
  }
}

fn router_table_has_wrong_dynamic_hostname(
  table: Cr1000aDhcpLeaseTable,
  fleet_slot: HostIdentity,
) -> Bool {
  fold(
    table.rows,
    init: false,
    f: (acc, row) =>
      acc
        || match row.lease {
          DynamicDhcpLease { client_hostname: Present { value: _ }, lease_time_remaining: _, status: Active } =>
            !network_identity_subsumes_fleet_slot(fleet_slot: fleet_slot, lease: row.lease)
          _ => false
        },
  )
}

fn router_table_is_only_static_reservations(
  table: Cr1000aDhcpLeaseTable,
) -> Bool {
  fold(
    table.rows,
    init: true,
    f: (acc, row) =>
      acc
        && match row.lease {
          StaticDhcpReservation { reservation_label: _, status: _ } => true
          DynamicDhcpLease { client_hostname: _, lease_time_remaining: _, status: _ } => false
        },
  )
}

fn classify_router_lease_table(
  table: Cr1000aDhcpLeaseTable,
  fleet_slot: HostIdentity,
) -> RouterLeaseDiagnosticVerdict {
  if lease_table_has_os_up_subsumption(table: table, fleet_slot: fleet_slot) {
    Srv3OsLeasePresent
  } else if router_table_is_only_static_reservations(table: table) {
    OnlyBmcLeasePresent
  } else if router_table_has_wrong_dynamic_hostname(table: table, fleet_slot: fleet_slot) {
    WrongHostnameLeasePresent
  } else {
    Srv3OsLeaseAbsent
  }
}

fn classify_kvm(obs: KvmObservation) -> KvmDiagnosticVerdict {
  if !obs.keyboard_accepted {
    KvmUntrusted
  } else {
    KvmWeakInconclusive
  }
}

fn sol_has_installer_evidence(verdict: SolConsoleDiagnosticVerdict) -> Bool {
  match verdict {
    SolGrubSeen => true
    SolInstallerSeen => true
    SolAutoinstallSeen => true
    SolSilent => false
    SolFirmwareMenu => false
    SolErrorSeen => false
    SolCaptureUnavailable => false
  }
}

fn sol_has_autoinstall_evidence(verdict: SolConsoleDiagnosticVerdict) -> Bool {
  match verdict {
    SolAutoinstallSeen => true
    _ => false
  }
}

fn diagnose_os_install_actuation(
  intent: OsInstallAttemptIntent,
  observations: OsInstallActuationObservations,
) -> InstallDiagnosticVerdict {
  let serve = classify_nbd_serve_readiness(
    process: observations.serve_process,
    port: observations.serve_port,
    session: observations.bmc_session,
    iso: observations.iso_readiness,
    intent: intent,
  )
  let redfish = classify_redfish_system_boot(obs: observations.redfish_system)
  let virtual_media = classify_bmc_virtual_media(obs: observations.virtual_media, intent: intent)
  let sol = classify_sol_console(obs: observations.sol_console)
  let router = classify_router_lease_table(
    table: observations.router_lease_table,
    fleet_slot: intent.target_host,
  )
  let _kvm = classify_kvm(obs: observations.kvm)

  if router == Srv3OsLeasePresent {
    OsInstalled
  } else if serve == IsoHashMismatch {
    VirtualMediaServeDown
  } else if serve != ServeReady {
    VirtualMediaServeDown
  } else if virtual_media == VirtualMediaAbsent || virtual_media == VirtualMediaDisconnected {
    VirtualMediaNotMounted
  } else if virtual_media == BmcSessionExpired {
    VirtualMediaServeDown
  } else if redfish == BootOverrideCdOnceArmed {
    BootAttemptInProgress
  } else if serve == ServeReady
    && virtual_media == VirtualMediaMountedExpectedIso
    && redfish == BootOverrideDisabledAfterAttempt
    && observations.elapsed_since_boot_once_ms == 0 {
    ReadyToBoot
  } else if redfish == BootOverrideDisabledAfterAttempt
    && observations.elapsed_since_boot_once_ms == 0
    && serve != ServeReady {
    BootOverrideNotSet
  } else if sol_has_autoinstall_evidence(verdict: sol)
    && observations.elapsed_since_boot_once_ms < srv3_install_hang_no_router_lease_ms {
    AutoinstallRunning
  } else if sol_has_installer_evidence(verdict: sol)
    && observations.elapsed_since_boot_once_ms >= srv3_install_hang_no_installer_progress_ms
    && router == Srv3OsLeaseAbsent {
    InstallerHung
  } else if redfish == BootOverrideDisabledAfterAttempt
    && !sol_has_installer_evidence(verdict: sol)
    && router != Srv3OsLeasePresent {
    BootOverrideConsumedNoInstall
  } else if sol == SolFirmwareMenu
    && redfish == BootOverrideDisabledAfterAttempt
    && router == Srv3OsLeaseAbsent {
    BootOverrideConsumedNoInstall
  } else if sol == SolSilent
    && observations.elapsed_since_boot_once_ms >= srv3_install_hang_no_router_lease_ms
    && router == Srv3OsLeaseAbsent {
    InstallerHung
  } else if sol == SolSilent
    && observations.sol_console.duration_ms >= srv3_install_hang_no_installer_progress_ms
    && router == Srv3OsLeaseAbsent {
    Inconclusive
  } else if sol == SolGrubSeen || sol == SolInstallerSeen {
    InstallerBooted
  } else if redfish == BootOverrideDisabledAfterAttempt && sol == SolSilent {
    FirmwareIdle
  } else if observations.kvm.video_state == KvmFirmwareMenu && !observations.kvm.keyboard_accepted {
    KvmUntrustedVerdict
  } else {
    Inconclusive
  }
}

fn install_diagnostic_verdict_is_ready_to_boot(verdict: InstallDiagnosticVerdict) -> Bool {
  match verdict {
    ReadyToBoot => true
    _ => false
  }
}

fn install_diagnostic_verdict_is_os_installed(verdict: InstallDiagnosticVerdict) -> Bool {
  match verdict {
    OsInstalled => true
    _ => false
  }
}

fn install_diagnostic_verdict_is_boot_override_consumed_failure(verdict: InstallDiagnosticVerdict) -> Bool {
  match verdict {
    BootOverrideConsumedNoInstall => true
    _ => false
  }
}

fn bmc_install_debug_checklist_surface_count_is_seven() -> Bool {
  bmc_install_debug_checklist_surfaces.length() == 7
}

fn srv3_os_install_diagnostic_runbook_is_declared() -> Bool {
  string_contains(s: srv3_os_install_diagnostic_runbook_section as String, pattern: "install-debug-diagnostic-fold")
}
