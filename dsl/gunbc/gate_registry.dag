module gunbc.gate_registry

type Gate
  = RustMonolithGate
  | EmitHostGate
  | LayeringImportsGate
  | ExtdepsExternalAuthorityGate
  | DslCompileCleanGate
  | GeneratedArtifactDriftGate
  | SourceRootIngestGate
  | RegenVerifyGate

type GateBinding {
  gate: Gate
  entry: String
  check_fns: List<String>
  wet_fn: String
  floor: Bool
}

fn gate_binding(g: Gate) -> GateBinding {
  match g {
    EmitHostGate => GateBinding { gate: EmitHostGate, entry: "dsl/tools/emit_host_gate.dag", check_fns: [], wet_fn: "", floor: true }
    LayeringImportsGate => GateBinding { gate: LayeringImportsGate, entry: "dsl/tools/layering_imports_gate.dag", check_fns: [], wet_fn: "", floor: true }
    ExtdepsExternalAuthorityGate => GateBinding { gate: ExtdepsExternalAuthorityGate, entry: "dsl/tools/extdeps_external_authority_gate.dag", check_fns: [], wet_fn: "", floor: true }
    DslCompileCleanGate => GateBinding { gate: DslCompileCleanGate, entry: "dsl/tools/dsl_compile_clean_gate.dag", check_fns: [], wet_fn: "", floor: true }
    GeneratedArtifactDriftGate => GateBinding { gate: GeneratedArtifactDriftGate, entry: "dsl/tools/generated_artifact_gate.dag", check_fns: ["run_generated_artifact_drift_gate_body"], wet_fn: "main_wet", floor: true }
    SourceRootIngestGate => GateBinding { gate: SourceRootIngestGate, entry: "src/v2/workflow/source_root_ingest_gate.dag", check_fns: [], wet_fn: "", floor: true }
    RegenVerifyGate => GateBinding { gate: RegenVerifyGate, entry: "dsl/tools/regen_verify_gate.dag", check_fns: [], wet_fn: "", floor: true }
    RustMonolithGate => GateBinding { gate: RustMonolithGate, entry: "dsl/tools/rust_gates_ci.dag", check_fns: ["main"], wet_fn: "", floor: false }
  }
}

data gate_bindings: List<GateBinding> = [
  gate_binding(g: EmitHostGate),
  gate_binding(g: LayeringImportsGate),
  gate_binding(g: ExtdepsExternalAuthorityGate),
  gate_binding(g: DslCompileCleanGate),
  gate_binding(g: GeneratedArtifactDriftGate),
  gate_binding(g: SourceRootIngestGate),
  gate_binding(g: RegenVerifyGate),
  gate_binding(g: RustMonolithGate)
]

fn gate_floor_variants() -> List<Gate> {
  fold(gate_bindings, init: [], f: fn(acc, row) {
    if row.floor { concat(acc, [row.gate]) } else { acc }
  })
}

fn gate_rust_job_variants() -> List<Gate> {
  [RustMonolithGate]
}

fn gate_all_variants() -> List<Gate> {
  map(gate_bindings, row => row.gate)
}
