// === The whole authority =====================================================

// The REAL ROADMAP as the single `.dag` authority — preamble + the eight sections in priority order.
// `project_roadmap_to_markdown(roadmap_authority(), merged)` is the emitted ROADMAP.md.
fn roadmap_authority() -> RoadmapDocument {
  RoadmapDocument {
    preamble: preamble(),
    sections: [
      section_0(), section_1(), section_2(), section_3(),
      section_4(), section_5(), section_6(), section_7(), section_8(),
    ],
  }
}
