          authored(id: "5-defork", done: false, content: "de-fork dsl ↔ v2 (one std authority, no historical forks)"),

          derivable(id: "5-defork-step1", prs: [5473], title: "turn on cross-tree import — Step 1 **LANDED**", description: "— PR-B (collapse forks) next *(nimble-koi-625)*"),
          authored(id: "5-collapse-dups", done: false, content: "collapse clear duplicates (algebra, logic, nat, reducible, measure)"),
