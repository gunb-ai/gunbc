module gunbc.roadmap_authority

import gunbc.roadmap_document { RoadmapDocument, RoadmapSection, project_roadmap_to_markdown }
import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, Pointer,
  SectionElement, section_prose, section_group,
}
import gunbc.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine }
import ctrl.process_algebra { ProcessNodeId }
import std.markdown { MarkdownBlock, HeadingBlock, ParagraphBlock, TextInline, H1 }
import extdeps.languages.markdown { serialize_markdown_source }

fn nid(s: String) -> ProcessNodeId { s }

fn ptr(label: String, path: String) -> Pointer { Pointer { label: label, path: path } }
fn plan_ptr(path: String) -> List<Pointer> { [Pointer { label: "plan", path: path }] }

fn authored(id: String, done: Bool, content: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: [] }
}

fn authored_doc(id: String, done: Bool, content: String, path: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: plan_ptr(path: path) }
}

fn authored_pp(id: String, done: Bool, content: String, carriers: List<Pointer>) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: carriers }
}

fn derivable(id: String, prs: List<Int>, title: String, description: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: [] }
}
fn derivable_doc(id: String, prs: List<Int>, title: String, description: String, path: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: plan_ptr(path: path) }
}
fn derivable_pp(id: String, prs: List<Int>, title: String, description: String, carriers: List<Pointer>) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: carriers }
}

fn preamble() -> List<MarkdownBlock> {
  [
    HeadingBlock { level: H1, inlines: [TextInline { text: "gunbc — Roadmap" }] },
    ParagraphBlock { inlines: [TextInline { text: "`DESIGN.md` is the authority for *why*. This is the **shape of the work** — a scannable, dependency-ordered checklist. **Checkboxes are authoritative for progress**; detail lives in the linked plan docs — don't restate it here (no dual representations). A task's real state is its branch/PR." }] },
    ParagraphBlock { inlines: [TextInline { text: "Legend: `[x]` done · `[ ]` todo · **indentation = depends on the item it sits under**. Each section opens with a **◆ Milestones** spine — the *verifiable* checkpoints in dependency order (`✓` reached · `▸` now · `○` ahead); the checklist below is the work toward them. Read L→R = the path." }] },
    ParagraphBlock { inlines: [TextInline { text: "**Priority order, top = now.** Bands: **stability / correctness** (§0–§4) → **expansion** (§5–§7) → **shelved** (§8)." }] },
  ]
}

fn section_0() -> RoadmapSection {
  RoadmapSection {
    title: "0. Fail-closed lock-down LANE — BLOCKS expansion into products",
    elements: [
      section_prose(content: "Cache flakes, un-wired lenses, complexity violations = one problem: modeled, not made *impossible to write*. Fix = correctness by construction, not validation ([DESIGN §5](DESIGN.md))."),
      section_prose(content: "→ [audit + checklist](docs/plans/fail-closed-lockdown.md)"),
      section_prose(content: "This window = a few days of STABILITY — shrink the fail-open surface, don't \"lock\" it. The deepest root (`Value::Null` overload, ~131 sites) stays OPEN until its own runway ([fork plan](docs/plans/model-realization-fork.md) §3)."),
      section_prose(content: "**◆ Milestones:** fail-open audited ✓ · numeric tower grounded ✓ (#5428) → **▸ NOW: cache warm==cold oracle · every lens wired-or-deleted · stage0 census under budget** → `Value::Null` split *(deep root)*"),
      section_group(
        label: "Audits (done)",
        nodes: [
          authored(id: "0-audit-wiring", done: true, content: "lens/gate wiring — most analytical lenses inert (authored, no discovered gate)"),
          authored(id: "0-audit-failopen", done: true, content: "fail-open code — cache lossy-digest · under-keyed memos · `unwrap_or_default` infer"),
          authored_doc(id: "0-audit-fork", done: true, content: "**model↔realization fork — ROOT CONFIRMED** — one seam (~13 bridges); sub-roots = numeric tower + `Value::Null`", path: "docs/plans/model-realization-fork.md"),
          authored_pp(id: "0-audit-remaining", done: false, content: "remaining: coercion/equality straddles · inference fail-open · cache-purity · CI-coverage-completeness", carriers: [ptr(label: "detail", path: "docs/plans/fail-closed-lockdown.md")]),
        ],
        edges: [],
      ),
      section_group(
        label: "In-scope this window",
        nodes: [

          derivable_doc(id: "0-numeric-tower", prs: [5428], title: "**numeric-tower grounding**", description: "— `Int=GroupCompletion<Nat>`; `==` straddle guard now dead-in-corpus", path: "docs/plans/model-realization-fork.md"),
          authored(id: "0-cache-trustworthy", done: false, content: "**cache trustworthy** — authoritative home is §2 F2/F3/P1; ship the warm==cold oracle as a detective now"),
          authored_pp(id: "0-rust-gate", done: false, content: "**rust-gate coverage** (shared §1) — opt-level=3 restores Pop-A to per-PR (#5456); run-all-unless-`#[ignore]`d (#5427); `.dag`→rust coverage wall = edge-(b), SCOPED / pending operator greenlight *(quick-ant-298)*", carriers: [ptr(label: "cause table", path: "docs/plans/ci-selection-vs-scheduling.md"), ptr(label: "edge-(b) brief", path: "docs/plans/edge-b-rust-dag-provenance-brief.md")]),
          authored(id: "0-promote-lenses", done: false, content: "**promote-or-delete inert lenses · de-vacuum gates** — EmitHostGate de-vacuumed ✓ (#5477); 4 advisory lenses widened+bounded, whole-corpus deferred to `.dag` structural-reflection (also unlocks coverage/testgen) *(silent-wren-739)*"),

          derivable_doc(id: "0-realization-vocab", prs: [5445, 5453], title: "**realization-vocabulary containment guard**", description: "— target-AST importable only at the realization edge (fail-closed, shrinking-roster); dissolve-on: bash-sidecar arc empties the roster → pure wall → `program.dag` deletable", path: "docs/plans/emission-ingestion-inverse.md"),
          authored(id: "0-stage0-census", done: false, content: "**stage0 clone-census inert + seed regressed** to 21540 (~1138 over) — resolve by clone-reduction / substrate-migration, NEVER a cap-bump; #5427 `#[ignore]` is the interim *(fierce-hawk-540 via quick-ant-298)*"),
        ],
        edges: [],
      ),
      section_group(
        label: "Fenced OUT (after stability)",
        nodes: [
          authored(id: "0-value-null", done: false, content: "**split `Value::Null`** (None/Absent/miss/Violates → own carriers) — ~131-site substrate change, the deeper root; own runway"),
          authored(id: "0-selfhost-purity", done: false, content: "**self-host purity gate** — a §5 deliverable, not §0 (avoids the §0↔§5 cycle)"),

          derivable(id: "0-cross-tree", prs: [5473], title: "**cross-tree import activation** (§5)", description: "— LANDED; the §0↔§5 escalate item is now closed"),
          authored_doc(id: "0-disposition", done: false, content: "**`Disposition` carrier** — a new concept; parked", path: "docs/plans/disposition-carrier.md"),
          authored(id: "0-complexity-residue", done: false, content: "complexity-budget whole-codebase (§3) · cache-redundancy completeness (§2 P3) — residue, after construction"),
          authored_pp(id: "0-cardinality", done: false, content: "**cardinality refinement** — illegal cardinalities (wrong length · empty · overflow) unwritable by construction; the *decidable* refinement axis (linear arithmetic over counts), fold-propagated. MVP-1 (`Byte` via `Length<8>`) + P4 (fold homomorphism · uint8 overflow → typed `Rejected`) proven (#5512); P1 (`where` lowering) / P2 (construction-enforced) behind this lane; P5 (phantom-width reflection) substrate-blocked.", carriers: [ptr(label: "plan", path: "docs/plans/cardinality-refinement.md"), ptr(label: "P1", path: "docs/plans/p1-where-clause-lowering.md")]),
        ],
        edges: [],
      ),
      section_group(
        label: "Meta — lock down the reasoning (§7 recursion)",
        nodes: [

          derivable(id: "0-inert-hygiene", prs: [5433], title: "**inert-lens hygiene backstop**", description: "— every `lens/*.dag` wired or deleted; runs over the corpus"),
          authored_doc(id: "0-reachability", done: false, content: "**reachability-completeness lens** — every declared node (code carrier · doc · lens) reachable from a run-root, rostered, or deleted; generalizes #5433 to carriers + docs", path: "docs/plans/inert-layer-lens.md"),
          authored(id: "0-gate-hygiene", done: false, content: "**gate-hygiene: a floor-enrolled gate must be green-on-main at merge** — roster-completeness assertion promoted to should-land ([plan](docs/plans/emission-ingestion-inverse.md) §2; [merge-freshness decision record](docs/plans/ci-merge-freshness.md)) *(quick-ant-298)*"),

          derivable_pp(id: "0-construction-rule", prs: [5476], title: "**construction-justification rule**", description: "(authoring-time) — justify why a class can't be construction before adding a lens *(silent-wren-739)*", carriers: [ptr(label: "plan", path: "docs/plans/construction-justification-rule.md"), ptr(label: "DESIGN §6", path: "DESIGN.md")]),
          authored_doc(id: "0-expressibility", done: false, content: "**expressibility frontier** — partition each modeling discipline into wall / lens-residue / undecidable-review *before* gating", path: "docs/plans/expressibility-frontier.md"),
          authored_pp(id: "0-skipped-modeling", done: false, content: "**confront the skipped modeling decisions** — the `🟡` comment backlog", carriers: [ptr(label: "Disposition plan", path: "docs/plans/disposition-carrier.md")]),
          authored_pp(id: "0-axiom-lens", done: false, content: "**axiom + syllogism lens** (DESIGN open thread #1) — every claim chains back to an axiom, no orphan/cycle; stays `[ ]` until it runs executably over this doc", carriers: [ptr(label: "scope", path: "docs/plans/axiom-syllogism-lens.md")]),
        ],
        edges: [],
      ),
    ],
  }
}

fn section_1() -> RoadmapSection {
  RoadmapSection {
    title: "1. CI as the substrate integration dogfood (the correctness floor)",
    elements: [
      section_prose(content: "A flaky or green-but-broken floor means no gate protects anything — so CI is upstream of every §0 claim. CI is also the one workload that flexes *every* substrate layer at once (execution · scheduling · caching · secrets/effects · emission), so it is the forcing function that turns each modeled-but-inert abstraction load-bearing. **Deliverable = shared abstractions proven by CI consuming them** (one Materialization kernel · one Placement authority · one secrets model); faster CI falls *out* of that, it is not the goal (§6 — price the lane in displaced cost, \"move with confidence\", not elegance)."),
      section_prose(content: "→ [charter: causal-chain gap analysis](docs/plans/ci-process-end-to-end.md) — what's on `.dag` today vs not, push→execute."),
      section_prose(content: "**◆ Milestones:** execution-as-DAG ✓ (the floor *is* a bounded forward graph walk) · width on `.dag` ✓ (#5444) → **▸ NOW — host-operation on `.dag` (placement · runner deployment · caps are hand-managed, off-fabric)** → resolve-cache enabled → one Materialization kernel (collapse the 5 caches) → one Placement authority (jobs · threads · sessions = 3 forks) → shared secrets · gunbhub closes the GitHub engine (G6, parked)"),
      section_group(
        label: "What's on `.dag` today (the gap map — detail in the charter §2/§4)",
        nodes: [
          authored(id: "1-exec-walk", done: true, content: "**execution = a dependency-graph walk** — `claim_executor` interprets `ci_floor_plan.dag`; one fold, batches from dependency edges (the realest layer)"),
          derivable(id: "1-sched-width", prs: [5444], title: "**scheduling: width axis**", description: "— `memory_aware_spawn_width` consumes the measured envelope; single-host"),
          derivable_doc(id: "1-measure-foundation", prs: [5470, 5478], title: "**Section 1 spawn-width foundation — std.measure expressibility**", description: "— the FLOOR family (measure_scale_fraction_floor + measure_fit_count_floor) and the demand-CEIL family completing the ceil-not-equal-floor money-pair landed, dissolving the measure unwrap→raw-arith→rewrap §3 fork. Authority: the expressibility-frontier spec #5467", path: "docs/plans/expressibility-frontier.md"),
          authored(id: "1-placement-inert", done: false, content: "**scheduling: placement + materialization inert** — `Placement`/`Materialization` modeled + witness-passing, **no live consumer** (same band as the host-ops gap, substrate side)"),
          authored(id: "1-caching-forked", done: false, content: "**caching forked** — sccache live · resolve-cache **dormant** (pure-proven 616/616, env var unset — biggest dormant lever) · ParseTable memo live · RecordedFixture · BuildBuddy opt-in → converge on `realize(subject)` (§2 P2)"),
        ],
        edges: [],
      ),
      section_group(
        label: "Host-operation band — off-fabric, unmodeled, unenforced (G1–G3, NOW)",
        nodes: [
          authored_doc(id: "1-g1-placement", done: false, content: "**G1 placement** — which host a job lands on is GitHub-native, demand-blind, first-idle → heavy runs co-reside, other host idles (the underutilization root)", path: "docs/plans/compute-envelope-model.md"),
          authored(id: "1-g2-runner", done: false, content: "**G2 runner deployment** — runners/host + registration are hand-run shell, **no repo artifact**; derive from `operator_fleet`+envelope, generate + drift-gate (the `ci.yml` pattern, for the host)"),
          authored(id: "1-g3-caps", done: false, content: "**G3 cgroup caps** — `TasksMax`/`MemoryMax` host-set by hand, only *read* live; derive + reconcile-gate so a hand-edit reds"),
          authored_doc(id: "1-ci-fabric", done: false, content: "**CI on compute fabric** — derive every host knob from one measured `ResourceEnvelope`; ends the crash-or-idle swing", path: "docs/plans/compute-envelope-model.md"),
        ],
        edges: [],
      ),
      section_group(
        label: "Adjacent gaps (smaller, outside the host band)",
        nodes: [
          authored_pp(id: "1-g4-dispatch", done: false, content: "**G4 dispatch dup** — `workflow_dispatch`+PR fire two same-SHA runs; `run_id` concurrency fallback won't collapse them → OOM", carriers: [ptr(label: "decision record", path: "docs/plans/ci-merge-freshness.md")]),
          authored_doc(id: "1-g5-rust-selection", done: false, content: "**G5 rust-gate selection** — rust fmt/clippy/run-all is all-or-nothing on `.rs` PRs; no affected-set (the `.dag` floor already has one)", path: "docs/plans/ci-selection-vs-scheduling.md"),
          authored_doc(id: "1-floor-right-things", done: false, content: "**floor runs the right things** — SELECTION (what changed) vs SCHEDULING (by cost); cost never drives selection", path: "docs/plans/ci-selection-vs-scheduling.md"),

          derivable(id: "1-opt3", prs: [5456], title: "opt-level=3 restores Pop-A to per-PR", description: "— merged"),
          authored(id: "1-per-pr-shrink", done: false, content: "per-PR = #5427 run-all sound baseline, shrunk to the affected set (#5427)"),
          authored(id: "1-nightly", done: false, content: "nightly = full-corpus selector-backstop + non-hermetic residue (#5447 stood down; ⚠ CI-gen load-bearing) *(quick-ant-298)*"),
          authored_pp(id: "1-builtin-registry", done: false, content: "**tree-scoped builtin registry** (fail-closed) — global seed registry leaks intrinsics into the substrate compile; instance fix #5452, class fix (partition) open *(quick-ant-298)*", carriers: [ptr(label: "force-check plan", path: "docs/plans/compile-clean-forcecheck.md")]),
          authored(id: "1-sccache-falsegreens", done: false, content: "**kill sccache false-greens** — exit-0-no-binary; build-verify asserts artifact exists + fresh (partly landed in `ci.yml`)"),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "1-opt3"), parent: nid(s: "1-floor-right-things") },
          RoadmapEdge { child: nid(s: "1-per-pr-shrink"), parent: nid(s: "1-floor-right-things") },
          RoadmapEdge { child: nid(s: "1-nightly"), parent: nid(s: "1-floor-right-things") },
        ],
      ),
      section_group(
        label: "Shared abstractions (the lane's real deliverable — §6: pull in as CI flexes them, not by taxonomy)",
        nodes: [
          authored(id: "1-materialization-kernel", done: false, content: "**one Materialization kernel** — collapse sccache / resolve / ParseTable-memo / RecordedFixture / BuildBuddy onto `realize(subject)` (§2 P2)"),
          authored(id: "1-placement-authority", done: false, content: "**one Placement authority** — jobs (GitHub) · threads (`spawn_width`) · sessions (ctrl `plans.capacity`) are 3 forks of \"put work on a host\""),
          authored(id: "1-shared-secrets", done: false, content: "**shared secrets/effects** — BMC · tokens · sccache-auth modeled once (when the fork is the pain)"),
        ],
        edges: [],
      ),
      section_group(
        label: "Downstream / parked",
        nodes: [
          authored(id: "1-privacy", done: true, content: "privacy (compute fabric)"),
          authored(id: "1-repo-model", done: false, content: "repo model (internal repo) on compute fabric"),
          authored(id: "1-gunbhub", done: false, content: "**gunbhub** — own the Git/CI engine (closes G6, the irreducible GitHub boundary); not pressing"),
          authored(id: "1-sellable", done: false, content: "*(downstream)* compute fabric as a sellable infra piece"),
        ],
        edges: [],
      ),
    ],
  }
}

fn section_2() -> RoadmapSection {
  RoadmapSection {
    title: "2. Minimal work — caching by realization (fail-closed)",
    elements: [
      section_prose(content: "Gate: uncached non-redundant work is an ERROR, not \"slow\". The cache-key-from-inputs construction is the §0 \"cache trustworthy\" item. → [plan](docs/plans/realization-measurement-loop.md)"),
      section_prose(content: "**◆ Milestones:** key-by-construction ✓ (#5425) → **▸ warm==cold purity proven (616/616, #5429)** → resolve-cache ON — ~18% floor cut *(core ask)* → native `content(T)` *(gated B2)*"),
      section_group(
        label: "",
        nodes: [
          derivable(id: "2-f1", prs: [5421], title: "F1 scheduler gives heavy nodes budgeted width", description: ""),
          derivable(id: "2-f2f3", prs: [5425], title: "F2/F3 `resolved_graph` key derived from declared `inputs_considered`", description: "— construction, not a lens"),
          authored(id: "2-p1", done: false, content: "P1 honest keys by construction — warm==cold purity oracle (#5429)"),
          authored(id: "2-p2", done: false, content: "P2 one door: `realize(subject)` sole API — kernel inhabits `cache_interface.dag` (#5446); ParseTable dissolution is downstream of the dsl→v2 de-fork (§5)"),
          authored(id: "2-p3", done: false, content: "P3 **resolve-cache enable** — cuts ~18% of floor wall; purity proven (616/616); gated on #5429 ← **core ask**"),
          authored(id: "2-p4", done: false, content: "P4 economic tier (measured cost → `Materialization`) — instrument done (#5431); remaining = the consumer feedback + width-fold"),
          authored(id: "2-p5", done: false, content: "P5 native `content(T) = content_hash(subgraph)` — gated on B2"),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "2-p1"), parent: nid(s: "2-f2f3") },
          RoadmapEdge { child: nid(s: "2-p2"), parent: nid(s: "2-p1") },
          RoadmapEdge { child: nid(s: "2-p3"), parent: nid(s: "2-p2") },
