          derivable_doc(id: "2-m41", prs: [5236], title: "M4.1 universal hermetic corpus governance", description: "", path: "docs/plans/m4-universal-hermetic-corpus.md"),
          authored_doc(id: "2-m5", done: false, content: "M5 fixture-store onto one Realization kernel", path: "docs/plans/m5-fixture-store-consolidation.md"),
        ],
        edges: [],
      ),
      section_group(
        label: "blockers",
        nodes: [
          authored(id: "2-b1", done: false, content: "B1 #5295 generic-instantiation (gates cross-shard `Share`)"),
          authored(id: "2-b2", done: false, content: "B2 cross-tree content-hash (gates P5)"),
        ],
        edges: [],
      ),
    ],
  }
}

fn section_3() -> RoadmapSection {
  RoadmapSection {
    title: "3. Complexity budget gate (stability — validation)",
    elements: [
      section_prose(content: "Operator decision (2026-06-21): budget-gate validation is the in-window tool; the algorithmic-cost *rewrite construction* is expansion, relocated to §5. Detection is total by construction (cost.dag U2); the gate's reach is a subject-production limit (fn-body reflection), not a detection one."),
      section_prose(content: "**◆ Milestones:** budget-gate non-toothless ✓ (#5437) → complexity gates the whole codebase *(gated on §5 fn-body reflection)*"),
      section_group(
        label: "",
        nodes: [
          authored(id: "3-complexity-lens", done: true, content: "complexity lens total over the kernel (cost.dag U2); the gate runs a curated subject roster"),

          derivable(id: "3-cost-lens", prs: [5437], title: "cost-lens zero-absorption fix — budgets non-toothless", description: ""),
          authored(id: "3-subject-producer", done: false, content: "a subject-producer for every fn (#5437 helper; whole-corpus needs fn-body reflection)"),
          authored(id: "3-gates-whole", done: false, content: "complexity budget gates the whole codebase (gated on fn-body reflection)"),
          authored(id: "3-synthesis-advisory", done: false, content: "synthesis stays advisory (by Rice, optimality is a ratchet not a wall — DESIGN §5)"),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "3-subject-producer"), parent: nid(s: "3-cost-lens") },
          RoadmapEdge { child: nid(s: "3-gates-whole"), parent: nid(s: "3-subject-producer") },
        ],
      ),
      section_prose(content: "→ rewrite-catalog construction design preserved + relocated to §5 ([plan](docs/plans/algebraic-rewrite-optimization.md))"),
    ],
  }
}

fn section_4() -> RoadmapSection {
  RoadmapSection {
    title: "4. Testgen as the bug-class oracle (coverage by construction)",
    elements: [
      section_prose(content: "Prevent the next class, not the last instance: generate witnesses from declared structure. → [audit + method](docs/plans/testgen-oracle.md)"),
      section_prose(content: "**◆ Milestones:** output gated ✓ (#5434) · coproduct-exhaustiveness structural ✓ (#5441) · cross-rep-equality ✓ (#5449) · oracle-method mapped ✓ (#5471) → anemia lens? *(parked, likely advisory)*"),
      section_group(
        label: "",
        nodes: [
          derivable(id: "4-gate-output", prs: [5434], title: "gate the generated output", description: "— floor-discover `generated/` (or regen==committed drift gate)"),
          derivable(id: "4-coproduct-exhaust", prs: [5441], title: "CoproductExhaustiveness made structural", description: "— over every declared coproduct, not a hand-roster"),
          derivable(id: "4-cross-rep", prs: [5449], title: "cross-representation-equality category", description: "— straddle witness per coproduct × native realization"),
          derivable(id: "4-oracle-method", prs: [5471], title: "**the oracle method (retro)**", description: "— bug-class→mechanism map (generator/lens/wall); testgen owns A + B-routing only, rest are lenses/walls ([map](docs/plans/testgen-oracle.md) §2)"),
          derivable(id: "4-affected-set", prs: [5430], title: "affected-set = the completeness half", description: "— model the full repo-process universe"),
          authored(id: "4-anemia", done: false, content: "*anemia lens?* (parked, DESIGN §2 leaf-side) — likely advisory, not a hard gate; decide whether to elevate"),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "4-anemia"), parent: nid(s: "4-affected-set") },
