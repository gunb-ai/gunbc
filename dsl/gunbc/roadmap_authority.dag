fn section_6() -> RoadmapSection {
  RoadmapSection {
    title: "6. idea → idea compiler (expansion — stop anchoring on code)",
    elements: [
      section_prose(content: "A program is a canonical `Node` (the *idea*); ingest / emit / eval across many media via one grammar read both directions (§2 N+M). → [plan](docs/plans/idea-machine.md)"),
      section_prose(content: "**◆ Milestones:** medium axis ✓ → language axis: English ingest round-trip → cross-media first-class (JSON/react/diagram) → invert hand-maintained: ROADMAP emitted + drift-gated"),
      section_group(
        label: "",
        nodes: [
