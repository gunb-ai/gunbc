module gunbc.roadmap_authority

import gunbc.roadmap_document { RoadmapDocument, RoadmapSection, project_roadmap_to_markdown }
import gunbc.roadmap_model {
  RoadmapNode, RoadmapEdge, Pointer,
  Intricacy, IntricacyLow, IntricacyMedium, IntricacyHigh,
  Volume, VolumeSmall, VolumeMedium, VolumeLarge,
  Acceptance, PrsMerged, ManualAcceptance,
  NodeSizing, Unsized, Sized,
  SectionElement, section_prose, section_group,
}
import gunbc.roadmap_status { RoadmapItem, DerivableLine, AuthoredLine, PlainLine, Signoff, Unsigned, SignedOff }
import ctrl.process_algebra { ProcessNodeId }
import std.markdown { MarkdownBlock, HeadingBlock, ParagraphBlock, TextInline, H1 }
import extdeps.languages.markdown { serialize_markdown_source }

fn nid(s: String) -> ProcessNodeId { s }

fn ptr(label: String, path: String) -> Pointer { Pointer { label: label, path: path } }
fn plan_ptr(path: String) -> List<Pointer> { [Pointer { label: "plan", path: path }] }

fn unsigned() -> Signoff { Unsigned }

fn signed(by: String, works: Bool, scope_equivalent: Bool, as_expected: Bool) -> Signoff {
  SignedOff { by: by, works: works, scope_equivalent: scope_equivalent, as_expected: as_expected }
}

fn authored(id: String, done: Bool, content: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}

fn authored_doc(id: String, done: Bool, content: String, path: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: plan_ptr(path: path), sizing: Unsized, owner: "", signoff: Unsigned }
}

fn authored_pp(id: String, done: Bool, content: String, carriers: List<Pointer>) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: AuthoredLine { done: done, content: content }, carriers: carriers, sizing: Unsized, owner: "", signoff: Unsigned }
}

fn plain(id: String, content: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: PlainLine { content: content }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}

fn derivable(id: String, prs: List<Int>, title: String, description: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: [], sizing: Unsized, owner: "", signoff: Unsigned }
}
fn derivable_doc(id: String, prs: List<Int>, title: String, description: String, path: String) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: plan_ptr(path: path), sizing: Unsized, owner: "", signoff: Unsigned }
}
fn derivable_pp(id: String, prs: List<Int>, title: String, description: String, carriers: List<Pointer>) -> RoadmapNode {
  RoadmapNode { node: nid(s: id), line: DerivableLine { prs: prs, title: title, description: description }, carriers: carriers, sizing: Unsized, owner: "", signoff: Unsigned }
}

fn derivable_wi(id: String, prs: List<Int>, title: String, description: String, intricacy: Intricacy, volume: Volume, repo: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: DerivableLine { prs: prs, title: title, description: description },
    carriers: [],
    sizing: Sized { intricacy: intricacy, volume: volume, repo: repo, acceptance: PrsMerged },
    owner: "",
    signoff: Unsigned,
  }
}

fn authored_wi(id: String, done: Bool, content: String, intricacy: Intricacy, volume: Volume, repo: String) -> RoadmapNode {
  RoadmapNode {
    node: nid(s: id),
    line: AuthoredLine { done: done, content: content },
    carriers: [],
    sizing: Sized { intricacy: intricacy, volume: volume, repo: repo, acceptance: ManualAcceptance },
    owner: "",
    signoff: Unsigned,
  }
}

fn owned(rn: RoadmapNode, owner: String) -> RoadmapNode {
  RoadmapNode { node: rn.node, line: rn.line, carriers: rn.carriers, sizing: rn.sizing, owner: owner, signoff: rn.signoff }
}

fn sign(rn: RoadmapNode, s: Signoff) -> RoadmapNode {
  RoadmapNode { node: rn.node, line: rn.line, carriers: rn.carriers, sizing: rn.sizing, owner: rn.owner, signoff: s }
}

fn preamble() -> List<MarkdownBlock> {
  [
    HeadingBlock { level: H1, inlines: [TextInline { text: "gunbc — Roadmap" }] },
    ParagraphBlock { inlines: [TextInline { text: "`DESIGN.md` is the authority for *why*. This is the **shape of the work** — a scannable, dependency-ordered checklist. **Checkboxes are authoritative for progress**; detail lives in the linked plan docs — don't restate it here (no dual representations). A task's real state is its branch/PR." }] },
    ParagraphBlock { inlines: [TextInline { text: "Legend: `[x]` done · `[ ]` todo · **indentation = depends on the item it sits under**. Each section opens with a **◆ Milestones** spine — the *verifiable* checkpoints in dependency order (`✓` reached · `▸` now · `○` ahead); the checklist below is the work toward them. Read L→R = the path." }] },
    ParagraphBlock { inlines: [TextInline { text: "**Reset 2026-07-01 (operator-directed).** The roadmap is collapsed to **two pillars** — **§1 get off v1** and **§2 own the compute fabric** — plus **§3 the floor + audit**: the walls that keep both pillars honest, and an execution-grounded audit of what the existing machinery *actually does* (green by execution, red by perturbation). Everything else is **§4 shelved**: parked, not deleted — plan docs and carriers stay, no work dispatches from it, and un-shelving is a PR that moves a node into §1–§3 with a displaced-cost justification (DESIGN §6). The prior roadmap with full detail is in git history. Priority order, top = now." }] },
  ]
}

fn section_1() -> RoadmapSection {
  RoadmapSection {
    title: "1. Get off v1 — v2 self-hosts (TERMINAL: `src/v1` deleted)",
    elements: [
      section_prose(content: "Anchor (do not flip-flop): `.dag` = truth; v2 emits its own seed (no stage0 hand-edits); the trust chain is discharged by execution; then the hand-written seed is deleted. Terminal is **hand-written compiler logic → 0**, not zero bytes of Rust: a pinned v2-emitted bootstrap kernel (~8–15k LOC — `claim_executor`, evaluator host-physics, the regen oracle) survives as the content-addressed seed. → [plan](docs/plans/v2-self-hosting.md) · [de-fork audit](docs/plans/dsl-v2-defork-audit.md) · [seed census](docs/plans/seed-shrink-census.md)"),
      section_prose(content: "Ground truth (2026-07-01): `src/v1` = ~174k hand-written `.rs` LOC (the ~154k figure in older docs is stale) + 44 `.dag` files of v1's own modeling; `src/v2` = 839 `.dag`, zero `.rs`. HAND_MAINTAINED roster is down 24 → 11 files + `module_path_index` (~20.6k LOC); `patch_*` 3 → 1. The regen gate proves byte-identity per the COMMITTED seed (two-generation): emitter improvements are latent until a cutover, and the cargo-green receipt is episodic (`#[ignore]`, ~3–5min), not continuous — today's continuous walls are byte-identity + the interim fixpoint + well-typed emit."),
      section_prose(content: "**◆ Milestones:** front-end ✓ · emit-rust well-typed ✓ · cross-tree import ✓ (#5473) · emitted crate cargo-green, 0 rustc errors ✓ (#5777/#5873, re-verified #6099) · `regen --verify` in CI ✓ (#5873) · interim fixpoint gate, 2-of-92 roster ✓ (#6009) → **▸ NOW: regen-cutover cadence · HAND queue drain · full-roster real fixed point** → seed-honesty (DDC) → **TERMINAL: `src/v1` deleted**"),
      section_group(
        label: "",
        nodes: [
          authored_wi(id: "5-regen-cutover", done: false, content: "**regen-cutover cadence** — absorb latent emitter fixes into the committed seed (#6099 merged with the `machine_width` emit test still ignored: two-generation regen means every emitter improvement is invisible until a cutover). Each cutover un-ignores its witnesses; a stale seed hides emitter regressions.", intricacy: IntricacyMedium, volume: VolumeMedium, repo: "gunbc"),
          authored(id: "5-real-fixpoint", done: false, content: "**real fixed point** — `content_hash` stage1==stage2 over the FULL seed: host-ground `source_text_code_unit_digest`, widen the `SelfHostRealizedComparisonGate` byte-fold from its 2-file roster (`lib.rs`, `v1_rt.rs`) to all 92 GENERATED files, dissolve the `bootstrap.dag` placeholder hashes. The #6009 gate is INTERIM by its own disposition; this milestone gates the bulk cutover-delete, seed-honesty, and the shelved TS self-host."),
          authored(id: "5-dissolve-patches", done: false, content: "**drain the HAND_MAINTAINED queue** (11 files + `module_path_index`, ~20.6k LOC) + kill the last `patch_*` (`patch_complexity_linearity_audit_mod`) — order: `main.rs` flip-back → the three lens projections → `coproduct_reflection` (de-fork-coupled) → `v1_interpreter` pure-eval emit (kernel D [plan](docs/plans/interpreter-kernel-d.md)) → `cli_run.rs` (largest, ~9.2k LOC; #6046 hard-gates relocating anything further INTO it). Host-physics files (recorded_fixture · resolved_graph_cache · rest_transport · wire_value_serialize) are terminal-kernel pins, not dissolution targets."),
          derivable(id: "5-dual-rep-lens", prs: [6104], title: "**no-dual-representation-test lens rebuilt pure-v2**", description: "— lens verdict moves off v1 Rust, the lens-E retirement pattern continued (in flight)"),
          authored(id: "5-defork", done: false, content: "**de-fork dsl ↔ v2 grounding cluster** (one std authority — the fixed point must be well-defined over ONE algebra): `algebra` first (LIVE fail-open, 75 floor entries) → effects/float/integer/logic → `nat` LAST. Operator rulings stand: coproduct = structural authority; grounded-realization wins. [brief](docs/plans/dsl-v2-defork-audit.md)"),
          authored(id: "5-root-b", done: false, content: "**Root B repoints** — def-unification (coproduct authority + aliases) → repoints (algebra/nat/integer/float/logic/effects/verification) → 🟡-marker dissolution (keystone #5552 merged)"),
          authored(id: "5-v1coupled", done: false, content: "v1-coupled `coercion`/`node` renames — deferred to v1-delete"),
          authored_wi(id: "5-test-migration", done: false, content: "**test-migration lane** — ~90 v1 test modules / ~939 `#[test]` fns move to floor `*_test.dag` witnesses before their module deletes (hard gate per module, bulk-delete forbidden); ~71 modules have NO floor equivalent today (census §5B: infer_semantics 51 · source_audit 41 · effects 36 · pipeline.rs 418 concern-level only). Parallelizable now; gates the terminal collapse per module.", intricacy: IntricacyMedium, volume: VolumeLarge, repo: "gunbc"),
          authored(id: "5-cargo-green-continuous", done: false, content: "**make cargo-green continuous (or cheap)** — `route_a_emit_fresh_cargo_green_test` is ignored (~3–5min); an emitter regression that keeps bytes stable per the old seed but breaks a fresh build surfaces late. Decide: fold into `RegenVerifyGate` (doubles its cost) or a scheduled receipt."),
          authored(id: "5-seed-honesty", done: false, content: "**seed-honesty discharge** (Diverse Double-Compiling) — modeled in `bootstrap.dag` (`SeedHonestyDischarge`), no execution exists; needs a reproducible artifact to double-compile"),
          authored(id: "5-collapse-v1", done: false, content: "**TERMINAL — collapse `src/v1`**: one atomic regen cutover-delete of the 92 GENERATED files (~117k of stage0's ~137k LOC) + per-module test deletes as migration lands + pin the terminal kernel. Requires: HAND queue empty · real fixed point · test-migration green · seed-honesty."),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "5-real-fixpoint"), parent: nid(s: "5-regen-cutover") },
          RoadmapEdge { child: nid(s: "5-dual-rep-lens"), parent: nid(s: "5-dissolve-patches") },
          RoadmapEdge { child: nid(s: "5-root-b"), parent: nid(s: "5-defork") },
          RoadmapEdge { child: nid(s: "5-v1coupled"), parent: nid(s: "5-defork") },
          RoadmapEdge { child: nid(s: "5-seed-honesty"), parent: nid(s: "5-real-fixpoint") },
          RoadmapEdge { child: nid(s: "5-collapse-v1"), parent: nid(s: "5-real-fixpoint") },
        ],
      ),
    ],
  }
}

fn section_2() -> RoadmapSection {
  RoadmapSection {
    title: "2. Compute fabric — own the infra (CI · deploy · control plane)",
    elements: [
      section_prose(content: "State (2026-07-01): required CI is **stabilized on Ubicloud** (#6107, `ubicloud-standard-16-arm`, one fresh VM per job — the reliability half; zero required jobs on the fleet). The fleet — srv1/srv2 (128c/125GiB Ampere) + srv3 (greenfield, OpenBMC) — carries agent sessions, the dashboard, and non-required runners, with live cgroup caps, runner registration, sudoers, and tailscale-ACL actuation still **hand-managed**. #6096 (fleet converge control plane) was **closed unmerged**; its review gap-list is the re-land spec, and the findings apply to the committed `.github/fleet-converge.sh` too (mutate-then-read, `|| true` swallowing, no hostname dispatch) — the re-land is an architecture change, not a rebase. → [CI humming](docs/plans/ci-humming.md) *(self-hosted-era caveats)* · [host-effect orchestration](docs/plans/host-effect-orchestration.md) · [compute envelope](docs/plans/compute-envelope-model.md) · [charter](docs/plans/ci-process-end-to-end.md)"),
      section_prose(content: "**◆ Milestones:** OOM root-caused (hand-set caps vs measured peaks + budget double-count) ✓ · required CI on Ubicloud ✓ (#6107) · converge shell emitted ✓ (#5725/#5827) · `apply()` Phase A ✓ (#5756) · CD to srv1 ✓ (#6030/#6060/#6093) · witness-level affected-set pruning LIVE ✓ (#6061) → **▸ NOW: CD-transport fix · cap de-conflation (~9× floor width on Ubicloud) · floor <1min · converge re-land to the signed design** → periodic actuation with receipts → srv3 OsInstalled · `apply()` Phases B–D → required CI returns to the fleet → **TERMINAL: install/manage/decom all on `apply()` with fail-closed receipts**"),
      section_group(
        label: "Now — correctness of the current posture",
        nodes: [
          authored_wi(id: "2-cd-transport", done: false, content: "**fix the CD transport premise** *(URGENT — fail-open wrong-host-apply risk on every main push)* — `ci_deploy_access` is `LocalShell` with principal `runner` (premise: runner is ON srv1, #6093), but since #6107 the runner is a Ubicloud VM; `deploy_dashboard_srv1` needs `SshShell`-over-tailnet + an ephemeral-runner credential (#6066 Phase 2 design). Verify or disable the job's effect before it next fires.", intricacy: IntricacyHigh, volume: VolumeSmall, repo: "gunbc"),
          authored_wi(id: "2-cap-deconflation", done: false, content: "**cap de-conflation** — split `gunbc_ci_runner_cgroup_memory_cap` (8GiB fleet slot contract, load-bearing for the dormant fleet budget tree) from the Ubicloud 48GB VM envelope → floor `spawn_width` ~9 on Ubicloud (~9× floor throughput; the deferred half of #6107).", intricacy: IntricacyMedium, volume: VolumeSmall, repo: "gunbc"),
          authored_pp(id: "2-merge-admission", done: false, content: "**merge-admission gate: close the HELD state** — wired (#5974/#6080) but the freshness block is HELD pending a real green-on-main receipt, and the #6080→#6101 accidental re-apply/re-revert needs a clean landing.", carriers: [ptr(label: "decision record", path: "docs/plans/ci-merge-freshness.md")]),
        ],
        edges: [],
      ),
      section_group(
        label: "Floor wall-clock — 26m → <1min on a typical PR",
        nodes: [
          authored(id: "1-wallclock-measured", done: false, content: "**the floor is a full recompute every run** — profiled 26m: ~518s resolves all 870 witnesses cold, a second ~275s discovery pass, ~360s effect-bound gates, ~134s seed compile; on a one-file PR ~99% of the resolve recomputes witnesses whose inputs did not change. **Target: <1min.** The lever is resolve-phase incrementality, NOT cross-run caching — CI is cold-dominated (the exe-hash re-colds on every code change)."),
          authored_doc(id: "1-affected-set-defork", done: false, content: "**affected-set de-fork — `v2.lens.affected_set` as single authority** — witness-level run/skip live (#6061, v1 `force_run_all` hack retired); remaining: precompute-skip wired to the same one `.dag` query, the Rust parallel (`NodeFrontierSeeds`) deleted (N→1), and a wall-clock+RSS receipt on a scoped diff.", path: "docs/plans/affected-set-precompute-pruning.md"),
          derivable_doc(id: "2-provenance-ingest", prs: [6105], title: "**provenance ingest live at floor runtime**", description: "— make the `v2.lens.affected_set` node-closure LIVE during the floor pass (`host_source_root_ingest_manifest` is Empty today); gates node-level pruning + the Rust-bridge deletion (in flight)", path: "docs/plans/affected-set-precompute-pruning.md"),
          authored(id: "1-double-resolve", done: false, content: "**kill the within-run double-resolve** — discovery and execution each resolve the corpus (~275s second pass); execution piggybacks the discovery resolve. Pure within-run win (M1 within-walk memo landed #6008 — this is the cross-phase half)."),
          authored(id: "1-resolver-pathology", done: false, content: "**profile the 518s resolve** — `budget_roster` resolves ~450× its structural twin (machine-independent resolver bug); a few pathological witnesses likely dominate. Profile which, fix the resolver."),
          authored_doc(id: "1-g5-rust-selection", done: false, content: "**G5 rust-gate selection** — rust fmt/clippy/run-all is all-or-nothing on `.rs` PRs (the ~530s hot spot); no affected-set, while the `.dag` floor already has one. Matters until v1 is gone.", path: "docs/plans/ci-selection-vs-scheduling.md"),
          authored_doc(id: "1-floor-right-things", done: false, content: "**floor runs the right things** — SELECTION (what changed) vs SCHEDULING (by cost); per-PR = run-all sound baseline (#5427) shrunk to the affected set; cost never drives selection.", path: "docs/plans/ci-selection-vs-scheduling.md"),
          authored(id: "2-p3", done: false, content: "**resolve-cache default-on** — purity proven (616/616) but opt-in: whole-file JSON IO buffers ~11× the packed graph and OOMed the concurrent floor (#5789 reverted); gated on a streaming IO realization. The warm ~18% lever, downstream of incrementality."),
          authored_pp(id: "1-g4-dispatch", done: false, content: "**G4 dispatch dup** — `workflow_dispatch`+PR fire two same-SHA runs; the concurrency fallback won't collapse them → wasted runners (and OOM risk at fleet return).", carriers: [ptr(label: "decision record", path: "docs/plans/ci-merge-freshness.md")]),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "2-provenance-ingest"), parent: nid(s: "1-affected-set-defork") },
        ],
      ),
      section_prose(content: "Receipts + adjacent levers: [fractal Gantt](docs/plans/ci-floor-fractal-gantt.md) · [memory chronicle](docs/plans/interpreter-memory-chronicle.md) · [representation minimization](docs/plans/representation-minimization.md) · [shared-compute memoization](docs/plans/floor-shared-compute-memoization.md) *(M1 ✓ #6008; M2 gated on determinism #5941)* · [OOM reclassification](docs/plans/ci-oom-reclassification.md)."),
      section_group(
        label: "Control plane — the #6096 re-land, done right (G2/G3)",
        nodes: [
          authored(id: "1-g2-runner", done: false, content: "**G2 runner deployment derived from `fleet_intent`** — runners/host + registration from the modeled envelope; the gunbc-EMITTED converge shell is the host-apply carrier (operator-set). The umbrella for the re-land below."),
          authored_wi(id: "2-converge-reland", done: false, content: "**closed-loop converge re-land** — the signed design: base snapshot → edit → **three-way diff** → gated plan → apply → **independent read-back** → commit/retract; **hostname self-selection** (the committed script runs all three hosts' rows unconditionally); **sound swap admission** (per-slot × slot-count overcommit vs host swap, not a single-slot compare); runner-width **INCREASE provisioning** (today an echo-to-stderr stub). The three-way-diff carrier does not exist yet in `dsl/gunbc/`.", intricacy: IntricacyHigh, volume: VolumeLarge, repo: "gunbc"),
          authored(id: "2-privilege-model", done: false, content: "**privilege model for host mutation** — converge writes `/etc/systemd/system/*.d` and runs `systemctl set-property` (root), but #6096's service ran as the operator user with `|| true` swallowing EPERM; extend `DeployAccess`/`host_effect` so an unprivileged apply is a **typed refusal BEFORE mutation**, never a swallowed failure."),
          authored(id: "2-periodic-actuation", done: false, content: "**periodic actuation with receipts** — a systemd timer (or ctrl thin-run) executes the emitted converge per-host under the privilege model; receipts land where a hand-edit REDS (G3's unmet promise). Until this exists the emitted shell is spec-without-execution."),
          authored(id: "1-g3-caps", done: false, content: "**G3 cgroup caps derived + reconciled** — `TasksMax`/`MemoryMax` are host-set by hand and only *read* live; derive from the budget tree + reconcile via converge so a hand-edit reds."),
          authored_doc(id: "1-g1-placement", done: false, content: "**G1 placement** — job→host is GitHub-native, demand-blind, first-idle → heavy runs co-reside while the other host idles. Dormant while required CI is on Ubicloud; live again at fleet return.", path: "docs/plans/compute-envelope-model.md"),
          authored_doc(id: "6-shell-emission", done: false, content: "**shell emission model** — `emit(intent, Bash)`; the mechanism the emitted converge/CD artifacts ride on (kept scoped to the converge/CI path; the tail slices are shelved).", path: "docs/plans/shell-emission-model.md"),
          derivable(id: "2-debash-orchestration", prs: [6106], title: "**orchestration emission → agnostic registry dispatch**", description: "— de-bash the compiler stage (in flight)"),
          authored_doc(id: "6-shell-slice0", done: false, content: "**slice 0 — CI EAGAIN-retry** — `ci_cargo_eagain_retry_core` → `emit(Retry, Bash)`; byte-oracle = committed `ci.yml`", path: "docs/plans/shell-emission-model.md"),
          authored_doc(id: "6-shell-slice1", done: false, content: "**slice 1 — control-flow emit** — `If` then `For`/`While` (`orch_emit_step` arms + byte goldens)", path: "docs/plans/shell-emission-model.md"),
          authored_doc(id: "6-shell-slice2", done: false, content: "**slice 2 — fleet_converge emit** — `fleet_converge_emit` → committed `.github/fleet-converge.sh`; the emit half of the re-land", path: "docs/plans/shell-emission-model.md"),
          authored_doc(id: "2-host-effect-phases", done: false, content: "**`apply()` Phases B–F** — B `host_exec`→`apply()` (gated on srv3 OsInstalled) · C Redfish live (partially via #6097) · D converge lane = EmitArtifactThenThinRun handler (first ctrl LOC deleted) · E pull-mode self-converge (autoinstall plants the on-host agent; the push star retires) · F decom. Phase A landed (#5756).", path: "docs/plans/host-effect-orchestration.md"),
          authored_doc(id: "2-srv3-osinstalled", done: false, content: "**srv3 → OsInstalled** — finish the greenfield install over the solve-driven NBD-proxy actuator (#6097, live BMC); proves the install band end-to-end.", path: "docs/plans/srv3-webui-kvm-virtual-media.md"),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "2-converge-reland"), parent: nid(s: "1-g2-runner") },
          RoadmapEdge { child: nid(s: "2-privilege-model"), parent: nid(s: "2-converge-reland") },
          RoadmapEdge { child: nid(s: "2-periodic-actuation"), parent: nid(s: "2-converge-reland") },
          RoadmapEdge { child: nid(s: "2-debash-orchestration"), parent: nid(s: "6-shell-emission") },
          RoadmapEdge { child: nid(s: "6-shell-slice0"), parent: nid(s: "6-shell-emission") },
          RoadmapEdge { child: nid(s: "6-shell-slice1"), parent: nid(s: "6-shell-slice0") },
          RoadmapEdge { child: nid(s: "6-shell-slice2"), parent: nid(s: "6-shell-slice1") },
        ],
      ),
      section_group(
        label: "Fleet return — required CI back on our metal",
        nodes: [
          authored(id: "2-session-slice", done: false, content: "**SessionSliceEnforcement + verified-effective caps** — agent-session cgroups have no citable verified-effective cap (the residual over-commit vector on srv1/srv2); the humming apply-rule stands: runner caps must not tighten while sessions are uncapped and oomd is absent."),
          authored_doc(id: "2-oom-consumer", done: false, content: "**OOM classification consumer** — `ClusteredOutOfMemoryKill` is modeled but absent from the active infra-retry signature roster; build the consumer so an OOM is first-class, never EAGAIN-shaped.", path: "docs/plans/ci-oom-reclassification.md"),
          authored(id: "2-fleet-return", done: false, content: "**return required CI to the fleet** (or hybrid: fleet + Ubicloud burst) — gated on: converge closed-loop live · caps verified-effective on all hosts · SessionSliceEnforcement · the OOM consumer. Retires rented compute as the required path; 3×128c/125GiB does no required-CI work today."),
          authored(id: "1-sched-resource-aware", done: false, content: "**resource-aware scheduler** — width derived from per-`Runnable` measured cost, self-calibrating: (A) per-shard peak-RSS plumbing → (B) `CostEstimate.space` on `Runnable` → (C) scheduler reads cost, static side-channel deleted → (D) calibration loop retires the data rows (instrument landed #5431). Construction invariant: more memory → more width → more throughput, no `.dag` edits. [plan](docs/plans/resource-aware-scheduler.md)"),
          authored_pp(id: "1-budget-tree", done: false, content: "**resource budget tree** — admission (construction) · conserve-lens (honest residue) · runtime reconcile (fail-closed handler), three verdicts never conflated; subsumes spawn-width/placement/compile-jobs as consumer leaves. Protective only when paired with an enforcement actuator (cgroup `memory.max`, operator-fenced).", carriers: [ptr(label: "carrier", path: "dsl/product/budget_tree.dag"), ptr(label: "grounding", path: "docs/plans/budget-tree.md")]),
          authored(id: "1-placement-authority", done: false, content: "**one Placement authority** — jobs (GitHub) · threads (`spawn_width`) · sessions (ctrl capacity) are 3 forks of \"put work on a host\"; `Placement`/`Materialization` are modeled but inert — CI consuming them is the lane's real deliverable."),
        ],
        edges: [
          RoadmapEdge { child: nid(s: "2-fleet-return"), parent: nid(s: "2-session-slice") },
        ],
      ),
    ],
  }
}

fn section_3() -> RoadmapSection {
  RoadmapSection {
    title: "3. The floor — audit what we have (does it actually do what it claims?)",
    elements: [
      section_prose(content: "Both pillars ride the CI floor: tree-wide marker-driven witness discovery · compile-clean gate · generated-artifact drift gates (this document is one) · `regen --verify` (#5873) · doc-graph reachability · emit-determinism (#5941) · the interim self-host comparison (#6009). Those stand. The floor's *expansion* lanes (testgen, wiring-liveness, complexity gates, lens meta-walls) are shelved — a new wall must displace a measured cost on a pillar path to un-shelve."),
      section_prose(content: "**Audit directive (operator, 2026-07-01): thoroughly audit what we have and what it actually does.** For each load-bearing mechanism, prove **by execution** that it does what it claims, with a **discriminating perturb** that goes RED when the behavior is wrong — a typecheck or a grep is not a consumer (DESIGN §5), and a wired gate can still be vacuous. A mechanism claim without a red-control is *unverified*, whatever its docs say. The reset's own mapping found the pattern live: the committed converge shell is spec-without-execution (§2), the fixpoint gate self-declares interim (2-of-92 files), cargo-green is an ignored test. Highest-stakes mechanisms first:"),
      section_group(
        label: "Audit — green by execution, red by perturbation",
        nodes: [
          authored_wi(id: "3-audit-affected-set", done: false, content: "**affected-set lens** *(the operator's named example)* — witness-level skip is LIVE on the floor (#6061); prove it: (a) **soundness** — construct a diff that MUST re-run a witness and assert it runs (a skipped-but-affected witness is the fail-open catastrophe); (b) **effectiveness** — receipts on real scoped diffs (skip counts + wall-clock delta, not claims); (c) **fail-closed default** — a provenance gap falls back to run-all, witnessed RED-on-perturb. The node-closure half (#6105) inherits the same receipt obligation before it may prune.", intricacy: IntricacyHigh, volume: VolumeMedium, repo: "gunbc"),
          authored_wi(id: "3-audit-gate-inventory", done: false, content: "**mechanism inventory with red-controls** — census every wired gate/lens/cache (floor-plan roster + `commit_workflow`): what it claims · its discriminating RED witness · its last execution receipt. Anything without a red-control gets one or gets demoted/deleted. The inert-lens backstop (#5433) covers *wiring*; this covers *claim-vs-behavior*.", intricacy: IntricacyMedium, volume: VolumeLarge, repo: "gunbc"),
          authored(id: "3-audit-cache-honesty", done: false, content: "**cache honesty re-receipt** — re-run the warm==cold purity oracle against CURRENT main (616/616 was pre-reset), and close the sccache exit-0-no-binary class (below); a cache that lies is worse than no cache."),
        ],
        edges: [],
      ),
      section_group(
        label: "Open floor holes",
        nodes: [
          authored(id: "1-nightly", done: false, content: "**nightly full-corpus selector-backstop** — per-PR selection is only sound because nightly runs everything; ⚠ CI-gen load-bearing"),
          authored_pp(id: "1-builtin-registry", done: false, content: "**tree-scoped builtin registry** (fail-closed) — the global seed registry leaks intrinsics into the substrate compile, making compile-clean falsely green; instance fix #5452, class fix (partition) open", carriers: [ptr(label: "force-check plan", path: "docs/plans/compile-clean-forcecheck.md")]),
          authored(id: "1-sccache-falsegreens", done: false, content: "**kill sccache false-greens** — exit-0-no-binary; build-verify asserts the artifact exists + is fresh (partly landed in `ci.yml`)"),
        ],
        edges: [],
      ),
    ],
  }
}

