// gunbc.generated_artifact — the ONE meta-repo model of "what gunbc produces and what it does with each".
//
// It answers the operator's three questions over a SINGLE registry, collapsing the three byte-identical
// per-artifact drift gates (CiYamlGate / RoadmapGate / GitignoreGate) into one universal policy (DESIGN
// §2 realization: ONE kernel — the drift gate, in tools.generated_artifact_gate — over N handlers, the
// existing emit fns; DESIGN §3: one authority for "what we generate", reading the existing gitignore
// authority for "what we ignore", never a second `committed: Bool` ledger).
//
//   Q1 GENERATE? — presence in `generated_artifact_registry`. Each row binds a path -> its generator
//      (the existing nullary emit fns, untouched).
//   Q2 COMMIT?   — DERIVED, not declared: committed = generated AND NOT ignored. The ignore side is read
//      from gunbc.gitignore_authority via gitignore_emit.ignore_patterns (the same rows the .gitignore
//      file is emitted from). This is the elegant connection: the gitignore authority and the generated
//      registry are one model — target/ + caches are generated-but-ignored; ci.yml / ROADMAP.md /
//      .gitignore are generated-AND-committed (not in the ignore set), so the gate covers them.
//   Q3 DRIFT?    — handled by the one gate in tools.generated_artifact_gate, folding over the COMMITTED
//      subset this module derives.
//
// UNIVERSAL, NOT OPT-IN: a new generated-committed artifact = one enum variant + its path/generate arm
// here — no Gate variant, no ci_spec/ci_gates/floor/plan edit. The universal gate auto-covers it.

module gunbc.generated_artifact

import gunbc.ci_yaml_emit { expected_ci_yml }
import gunbc.ci_yaml_validate { ci_yml_parses }
import gunbc.gitignore_emit { expected_gitignore, ignore_patterns }
import gunbc.roadmap_authority { expected_roadmap_md }

// Q1 — the closed registry of artifacts gunbc generates from a .dag authority.
type GeneratedArtifact
  = CiYamlArtifact
  | GitignoreArtifact
  | RoadmapArtifact

// 🟡 §5 COMPLETENESS RESIDUE: the gate folds this LIST. A new variant added to GeneratedArtifact + its
// path/generate arms but FORGOTTEN here is silently UNGATED — the "add a row -> auto-gated" promise fails
// OPEN. Without seed enum-reflection this list cannot be fully derived from the type. Mitigation: the
// no-regression witness (test.claim.generated_artifact_drift) cross-checks this list against an
// INDEPENDENT enumeration of all known variants, so a forgotten (or spurious) entry trips RED.
// DISSOLUTION TRIGGER: derive generated_artifact_registry from the enum by reflection once v2 self-host
// lands enum-variant enumeration (then this hand-list + its cross-check witness both delete).
data generated_artifact_registry: List<GeneratedArtifact> = [
  CiYamlArtifact,
  GitignoreArtifact,
  RoadmapArtifact
]

// INDEPENDENT enumeration of every GeneratedArtifact variant (the closed coproduct, hand-mirrored). The
// completeness witness asserts registry == this set so a registry omission is caught until reflection
// dissolves both (see residue note above). This is authored from the TYPE, not copied from the registry.
data all_generated_artifact_variants: List<GeneratedArtifact> = [
  CiYamlArtifact,
  GitignoreArtifact,
  RoadmapArtifact
]

// path: where the generated bytes live in the working tree.
fn artifact_path(a: GeneratedArtifact) -> String {
  match a {
    CiYamlArtifact => ".github/workflows/ci.yml"
    GitignoreArtifact => ".gitignore"
    RoadmapArtifact => "ROADMAP.md"
  }
}

// generator: the existing nullary emit fn for this artifact (each closes over its own authored inputs —
// roadmap over authored_merged_prs, ci.yml over ci_workflow, .gitignore over gitignore_authority).
fn artifact_generate(a: GeneratedArtifact) -> String {
  match a {
    CiYamlArtifact => expected_ci_yml()
    GitignoreArtifact => expected_gitignore()
    RoadmapArtifact => expected_roadmap_md()
  }
}

// Optional per-artifact validation BEYOND byte-drift. ci.yml additionally must parse as YAML (the check
// that lived inside the old CiYamlGate); others have no extra property. Preserved here so the unification
// is a no-regression — still no separate Gate variant.
fn artifact_extra_valid(a: GeneratedArtifact) -> Bool {
  match a {
    CiYamlArtifact => ci_yml_parses(path: artifact_path(a: a))
    _ => true
  }
}

// Q2 — COMMIT, derived. A gitignore pattern matches a path under a faithful subset of gitignore
// semantics over the authority's actual pattern forms:
//   - trailing "/"  => directory pattern: path is that dir or sits under it (anywhere in the tree
//                      unless leading-"/" anchored)
//   - leading "/"   => anchored to repo root
//   - "*.ext"       => basename suffix glob
//   - plain name    => exact basename, anywhere in the tree
// FAIL-CLOSED toward committed-and-gated: an UNCERTAIN match returns false (treat as committed => still
// drift-gated). Wrongly dropping a committed artifact from the gate would be fail-OPEN (silent drift);
// wrongly gating an ignored one is loud (read() of an absent path goes RED). So we only return true on a
// confident match.
// Seed string helpers (the seed has substring/length, not drop_prefix/suffix).
fn without_prefix(s: String, prefix: String) -> String {
  substring(s: s, start: prefix.length(), end: s.length())
}

fn without_suffix(s: String, suffix: String) -> String {
  substring(s: s, start: 0, end: s.length() - suffix.length())
}

fn path_basename(path: String) -> String {
  fold(split(s: path, delimiter: "/"), init: "", f: fn(_, seg) { seg })
}

fn dir_pattern_matches(dir: String, path: String) -> Bool {
  // dir already has leading/trailing slashes stripped.
  let anchored = concat(dir, "/")
  path == dir
    || starts_with(path, prefix: anchored)
    || string_contains(s: path, pattern: concat("/", anchored))
}

fn strip_slashes(p: String) -> String {
  let no_lead = if starts_with(p, prefix: "/") { without_prefix(s: p, prefix: "/") } else { p }
  if ends_with(s: no_lead, suffix: "/") { without_suffix(s: no_lead, suffix: "/") } else { no_lead }
}

fn pattern_matches(pattern: String, path: String) -> Bool {
  if ends_with(s: pattern, suffix: "/") {
    dir_pattern_matches(dir: strip_slashes(p: pattern), path: path)
  } else if starts_with(pattern, prefix: "*.") {
    ends_with(s: path, suffix: without_prefix(s: pattern, prefix: "*"))
  } else if starts_with(pattern, prefix: "/") {
    let anchored = without_prefix(s: pattern, prefix: "/")
    path == anchored || starts_with(path, prefix: concat(anchored, "/"))
  } else {
    path == pattern || path_basename(path: path) == pattern || ends_with(s: path, suffix: concat("/", pattern))
  }
}

fn path_is_ignored(path: String) -> Bool {
  any(ignore_patterns(), p => pattern_matches(pattern: p, path: path))
}

fn artifact_is_committed(a: GeneratedArtifact) -> Bool {
  !path_is_ignored(path: artifact_path(a: a))
}

fn committed_generated_artifacts() -> List<GeneratedArtifact> {
  filter(generated_artifact_registry, a => artifact_is_committed(a: a))
}

// Structural equality over the closed coproduct (for the completeness cross-check witness).
fn artifact_eq(a: GeneratedArtifact, b: GeneratedArtifact) -> Bool {
  match a {
    CiYamlArtifact => match b { CiYamlArtifact => true  _ => false }
    GitignoreArtifact => match b { GitignoreArtifact => true  _ => false }
    RoadmapArtifact => match b { RoadmapArtifact => true  _ => false }
  }
}

fn registry_contains(a: GeneratedArtifact) -> Bool {
  any(generated_artifact_registry, x => artifact_eq(a: x, b: a))
}
