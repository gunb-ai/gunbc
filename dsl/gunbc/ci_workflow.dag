// gunbc/ci_workflow.dag — authoritative GitHub Actions Workflow value for repo per-PR CI.
//
// Single authority for `.github/workflows/ci.yml` (DESIGN §3). The committed file is the
// literal byte output of `serialize_yaml(project_workflow_to_yaml(ci_workflow))` — no hash
// pin, no dual representation. `ci_workflow` is now ONE ROW of `repo_ci_workflow` (the shared
// workflow-construction authority, gunbc.ci_workflow_shape); it differs from the nightly row
// only in name, triggers, and the final run step. The prior inlined prelude moved verbatim to
// the shape module — CiYamlGate proves ci.yml is byte-identical after the move.

module gunbc.ci_workflow

import gunbc.ci_workflow_shape { repo_ci_workflow }
import gunbc.ci_spec { gunbc_ci_spec, gunbc_ci_workflow_run }
import extdeps.github.actions {
  Workflow, Step, RunStep,
  WorkflowTrigger, Push, PullRequest, WorkflowDispatch,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview
}

// The per-PR floor run step: release bootstrap + git fetch + the claim_executor scheduler.
fn ci_floor_run_step() -> Step {
  RunStep {
    name: Present { value: "gunbc ci (.dag witnesses + gates)" },
    id: none,
    run: gunbc_ci_workflow_run(spec: gunbc_ci_spec),
    shell: none,
    env: none,
    working_directory: none,
    if_condition: none,
    continue_on_error: none,
    timeout_minutes: none
  }
}

data ci_workflow: Workflow = repo_ci_workflow(
  name: "ci",
  triggers: [
    WorkflowDispatch { inputs: [] },
    Push { branches: ["main"], paths: [] },
    PullRequest {
      branches: ["main"],
      types: [Opened, Synchronize, Reopened, ReadyForReview]
    }
  ],
  run_step: ci_floor_run_step()
)
