// gunbc/ci_workflow.dag — authoritative GitHub Actions Workflow value for repo CI.
//
// Single authority for `.github/workflows/ci.yml` (DESIGN §3). The committed file
// is the literal byte output of `serialize_yaml(project_workflow_to_yaml(ci_workflow))`
// — no hash pin, no dual representation.
//
// Job timeout uses `default_job_timeout_minutes` (360): the claim_executor CI floor
// (#5122) exceeds the prior 240m limit on self-hosted runners; not lens-specific cost.

module gunbc.ci_workflow

import extdeps.formats.yaml { yaml_string, yaml_int, yaml_bool, kv }
import gunbc.ci_workflow_expressions {
  ci_concurrency_group, ci_setup_rust_home, ci_cache_path, ci_cache_key, ci_cache_restore_keys
}
import gunbc.ci_spec { gunbc_ci_spec, gunbc_ci_workflow_run }
import gunbc.ci_fleet { gunbc_ci_runner_spec }
import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep,
  WorkflowTrigger, Push, PullRequest, WorkflowDispatch,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview,
  WorkflowPermissions, PermRead,
  ConcurrencySpec, ConcurrencyMappingQueueNotMax, CancelInProgressBool,
  checkout_action, setup_rust_action, cache_action,
  default_job_timeout_minutes
}

data ci_workflow: Workflow = {
  name: "ci",
  on: [
    WorkflowDispatch { inputs: [] },
    Push { branches: ["main"], paths: [] },
    PullRequest {
      branches: ["main"],
      types: [Opened, Synchronize, Reopened, ReadyForReview]
    }
  ],
  concurrency: Present {
    value: ConcurrencyMappingQueueNotMax {
      // GitHub Actions `${{ }}` expressions are typed Nodes in `gunbc.ci_workflow_expressions`
      // and serialized here (medium-as-Node guard — no inline expression strings in this file).
      group: ci_concurrency_group(),
      cancel_in_progress: Present { value: CancelInProgressBool { value: true } },
      explicit_single: none
    }
  },
  env: Present {
    value: [
      kv(key: "CARGO_TERM_COLOR", value: yaml_string(s: "always")),
      kv(key: "RUSTFLAGS", value: yaml_string(s: "-D warnings"))
      // NOTE: GUNBC_RESOLVED_GRAPH_CACHE_DIR (ROADMAP §2 P3 cache enable) is NOT set here. The
      // `runner` context is INVALID in a workflow-level `env:` (GitHub fails to parse the whole
      // workflow → it never runs), so it is exported from the "Isolate toolchain dirs" step below
      // via `$RUNNER_TEMP` into `$GITHUB_ENV` — the same idiom CARGO_HOME/RUSTUP_HOME use.
    ]
  },
  permissions: Present {
    value: WorkflowPermissions {
      contents: Present { value: PermRead },
      pull_requests: Present { value: PermRead },
      issues: none,
      actions: none
    }
  },
  jobs: [{
    id: "ci",
    name: none,
    runner: gunbc_ci_runner_spec(),
    steps: [
      RunStep {
        name: Present { value: "Isolate toolchain dirs" },
        id: none,
        // CARGO_HOME/RUSTUP_HOME before Setup Rust + Cache Cargo. Fleet sccache is
        // host-managed (SCCACHE_SERVER_UDS); enable wrapper only when daemon responds.
        run: concat(
          concat(
            concat(
              "echo \"CARGO_HOME=$RUNNER_TEMP/cargo\" >> \"$GITHUB_ENV\"\n",
              concat(
                "echo \"RUSTUP_HOME=$RUNNER_TEMP/rustup\" >> \"$GITHUB_ENV\"\n",
                // ROADMAP §2 P3 — ENABLE the resolved-graph cache (persisted cross-run via the "Cache
                // resolved-graph" step; ~18% floor wall / 29.5% resolve CPU, proud-deer #5447). Exported
                // here (not workflow `env:`) because `runner.temp` is invalid at workflow scope. SAFE
                // only bundled with the warm==cold purity audit (DESIGN §5); the audit's own run uses an
                // isolated mktemp -d, unaffected by this shared dir.
                "echo \"GUNBC_RESOLVED_GRAPH_CACHE_DIR=$RUNNER_TEMP/gunbc-resolved-graph-cache\" >> \"$GITHUB_ENV\"\n"
              )
            ),
            "if sccache --show-stats >/dev/null 2>&1; then\n"
          ),
          concat(
            concat(
              "  echo \"RUSTC_WRAPPER=sccache\" >> \"$GITHUB_ENV\"\n",
              concat(
                "  echo \"CARGO_INCREMENTAL=0\" >> \"$GITHUB_ENV\"\n",
                concat(
                  "  echo \"CARGO_BUILD_JOBS=1\" >> \"$GITHUB_ENV\"\n",
                  concat(
                    "else\n",
                    concat(
                      "  echo \"CARGO_BUILD_JOBS=2\" >> \"$GITHUB_ENV\"\n",
                      "fi"
                    )
                  )
                )
              )
            ),
            ""
          )
        ),
        shell: none,
        env: none,
        working_directory: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      UsesStep {
        name: Present { value: "Checkout" },
        id: none,
        uses: checkout_action,
        with: Present {
          value: [kv(key: "fetch-depth", value: yaml_int(n: 0))]
        },
        env: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      UsesStep {
        name: Present { value: "Setup Rust" },
        id: none,
        uses: setup_rust_action,
        with: Present {
          value: [
            kv(key: "components", value: yaml_string(s: "rustfmt")),
            kv(key: "cache", value: yaml_bool(b: false)),
            kv(key: "rustflags", value: yaml_string(s: ""))
          ]
        },
        env: Present {
          value: [kv(key: "HOME", value: yaml_string(s: ci_setup_rust_home()))]
        },
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      RunStep {
        name: Present { value: "Pin rustup default (isolated RUSTUP_HOME has no default toolchain)" },
        id: none,
        run: concat(
          "rustup default \"$(rustup show active-toolchain | awk '",
          concat(concat("{", "print $1; exit"), concat("}", "')\""))
        ),
        shell: none,
        env: none,
        working_directory: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      UsesStep {
        name: Present { value: "Cache Cargo" },
        id: none,
        uses: cache_action,
        with: Present {
          value: [
            kv(key: "path", value: yaml_string(s: ci_cache_path())),
            kv(key: "key", value: yaml_string(s: ci_cache_key())),
            kv(key: "restore-keys", value: yaml_string(s: ci_cache_restore_keys()))
          ]
        },
        env: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      UsesStep {
        // ROADMAP §2 P3 — persist the resolved-graph cache cross-run so a WARM (primed) floor sees
        // the ~18% saving (a fresh-checkout run is cold). Content-keyed internally (per closure
        // digest), so a stale entry is simply a key-miss — harmless; the per-run-unique key always
        // saves a fresh snapshot, restore-keys warms from the latest prior. SAFE behind the bundled
        // warm==cold cache-purity audit gate (DESIGN §5).
        name: Present { value: "Cache resolved-graph (warm==cold purity-audited)" },
        id: none,
        uses: cache_action,
        with: Present {
          value: [
            kv(key: "path", value: yaml_string(s: "${{ runner.temp }}/gunbc-resolved-graph-cache")),
            kv(key: "key", value: yaml_string(s: "gunbc-rgcache-${{ runner.os }}-${{ runner.arch }}-${{ github.run_id }}")),
            kv(key: "restore-keys", value: yaml_string(s: "gunbc-rgcache-${{ runner.os }}-${{ runner.arch }}-\n"))
          ]
        },
        env: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      },
      RunStep {
        name: Present { value: "gunbc ci (.dag witnesses + gates)" },
        id: none,
        run: gunbc_ci_workflow_run(spec: gunbc_ci_spec),
        shell: none,
        env: none,
        working_directory: none,
        if_condition: none,
        continue_on_error: none,
        timeout_minutes: none
      }
    ],
    needs: [],
    env: none,
    outputs: none,
    if_condition: none,
    strategy: none,
    timeout_minutes: Present { value: default_job_timeout_minutes },
    continue_on_error: none,
    concurrency: none
  }]
}
