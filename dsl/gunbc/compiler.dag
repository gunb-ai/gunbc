// gunbc/compiler.dag — Self-hosting dependency cycle of the gunbc compiler.
//
// The compiler reads .dag source, produces Rust, and that Rust compiles
// to the binary that IS the compiler. This file names the participants
// in that cycle — source roots, generated crate, required tools — and
// provides command derivation functions that take resolved tool paths
// (not bare names) to keep the model free of hidden PATH dependencies.
//
//   source_roots ──(compile)──▶ generated_crate ──(cargo build)──▶ binary
//       ▲                                                            │
//       └────────────────────(reads)─────────────────────────────────┘
//
// Faithfulness: stage0 has two hand-maintained .rs files
// (cli_run.rs, v2_interpreter.rs) that survive regen and are excluded
// from the fixed-point diff. The GeneratedCrate type names them
// explicitly. Cargo.toml is also hand-maintained but lives outside
// source_dir and is never part of the src/ fixed-point — it's noted
// here but not modeled as a structural field.
//
// Tool modeling: the compiler cycle depends on cargo, grep, diff, cp, rm.
// Each is declared as a CliTool with an InstallSource. Workflows resolve
// these via extdeps.tools.resolve before dispatching commands, so every
// shell string uses absolute paths from `which`, not bare names.
//
// What this file is NOT:
//   - Internal pipeline (Tokenize → Parse → ...) — see src/v2/compile.dag
//   - Executable regen/freshness/ratchet — see dsl/gunbc/tools/*.dag
//   - CI gate declarations — those derive from this model, see gunbc/ci.dag

module gunbc.compiler

import std.types { FilePath, NonEmptyStr }
import extdeps.tools { CliTool, InstallSource, SourceCoreutils, SourceRustup, SourceBrew, SourceApt }
import extdeps.brew { formula_rust, formula_grep, formula_diffutils, formula_coreutils }
import extdeps.apt  { package_cargo, package_grep, package_diffutils, package_coreutils }

// ── Source roots ────────────────────────────────────────────────────

// A directory the compiler searches for .dag modules. The compiler's
// CLI API is --source-root <path> [--source-root <path> ...], and the
// roots are NOT symmetric: the first root is the entry root (all its
// .dag files compiled), subsequent roots are dependency pools (resolved
// transitively via imports). SelfHostingCycle captures this order as
// a product type so reordering in data is a type error.

type SourceRoot {
  path: FilePath
}

data compiler_source: SourceRoot = { path: "src/v2" }
data dsl_root: SourceRoot = { path: "dsl" }

// ── Generated crate ─────────────────────────────────────────────────

// The Rust crate that the compiler produces. hand_maintained_src names
// the basenames (relative to source_dir) that are NOT emitted: they
// survive regeneration and must be excluded from the fixed-point diff.
//
// Note: Cargo.toml is also hand-maintained but lives outside source_dir,
// never changes as part of regen, and is never in the fixed-point diff.
// Not modeled as a field — overhead for zero current benefit.

type GeneratedCrate {
  package_name: NonEmptyStr
  source_dir: FilePath
  hand_maintained_src: List<FilePath>
}

data stage0: GeneratedCrate = {
  package_name: "v2-compiler",
  source_dir: "src/v2/stage0/src",
  hand_maintained_src: ["cli_run.rs", "v2_interpreter.rs"]
}

// ── Self-hosting cycle ──────────────────────────────────────────────

// The structural fact that the compiler derives its own implementation.
// entry_root + dependency_roots matches the compiler's actual CLI:
//   --source-root <entry> --source-root <dep1> --source-root <dep2> ...
// Reversing or reordering is semantically significant, so the model
// encodes the distinction instead of flattening to a list.

type SelfHostingCycle {
  entry_root: SourceRoot
  dependency_roots: List<SourceRoot>
  generated: GeneratedCrate
}

data compiler_cycle: SelfHostingCycle = {
  entry_root: compiler_source,
  dependency_roots: [dsl_root],
  generated: stage0
}

// ── Tool registry ───────────────────────────────────────────────────

// The CLI tools the compiler cycle depends on. Each declares ALL the
// known install paths so the resolver's failure hint enumerates them
// for the user's platform — macOS dev (brew), Linux dev (apt), CI
// (rustup), etc. The resolver itself just runs `which`; the list is
// for documentation and recovery.

data cargo_tool: CliTool = {
  name: "cargo",
  min_version: None,
  installable_via: [
    SourceRustup,
    SourceBrew { formula: formula_rust },
    SourceApt { package: package_cargo }
  ]
}

data grep_tool: CliTool = {
  name: "grep",
  min_version: None,
  installable_via: [
    SourceCoreutils,
    SourceBrew { formula: formula_grep },
    SourceApt { package: package_grep }
  ]
}

data diff_tool: CliTool = {
  name: "diff",
  min_version: None,
  installable_via: [
    SourceCoreutils,
    SourceBrew { formula: formula_diffutils },
    SourceApt { package: package_diffutils }
  ]
}

data cp_tool: CliTool = {
  name: "cp",
  min_version: None,
  installable_via: [
    SourceCoreutils,
    SourceBrew { formula: formula_coreutils },
    SourceApt { package: package_coreutils }
  ]
}

data rm_tool: CliTool = {
  name: "rm",
  min_version: None,
  installable_via: [
    SourceCoreutils,
    SourceBrew { formula: formula_coreutils },
    SourceApt { package: package_coreutils }
  ]
}

data find_tool: CliTool = {
  name: "find",
  min_version: None,
  installable_via: [
    SourceCoreutils,
    SourceBrew { formula: formula_coreutils },
    SourceApt { package: package_coreutils }
  ]
}

data required_tools: List<CliTool> = [cargo_tool, grep_tool, diff_tool, cp_tool, rm_tool, find_tool]

// ── Resolved tool set ───────────────────────────────────────────────

// After resolution, workflows pass a typed record of absolute paths
// instead of accessing the bare list. This is the "tools are ready"
// state — every field is a FilePath from `which`.

type ResolvedCompilerTools {
  cargo: FilePath
  grep: FilePath
  diff: FilePath
  cp: FilePath
  rm: FilePath
  find: FilePath
}

type ToolResolveResult
  = ToolsReady { tools: ResolvedCompilerTools }
  | ToolsMissing { tool: String, hint: String }

// Resolve all required compiler tools in one call. Workflows call
// this once at the top and pattern-match — one level deep, not nested.
// Adding a new tool = edit this function + ResolvedCompilerTools.
func resolve_compiler_tools() -> ToolResolveResult {
  let cargo_r = resolve(tool: cargo_tool)
  match cargo_r {
    NotFound { tool: t, hint: h } => ToolsMissing { tool: t.name, hint: h }
    Resolved { resolved: cargo_rt } => {
      let grep_r = resolve(tool: grep_tool)
      match grep_r {
        NotFound { tool: t, hint: h } => ToolsMissing { tool: t.name, hint: h }
        Resolved { resolved: grep_rt } => {
          let diff_r = resolve(tool: diff_tool)
          match diff_r {
            NotFound { tool: t, hint: h } => ToolsMissing { tool: t.name, hint: h }
            Resolved { resolved: diff_rt } => {
              let cp_r = resolve(tool: cp_tool)
              match cp_r {
                NotFound { tool: t, hint: h } => ToolsMissing { tool: t.name, hint: h }
                Resolved { resolved: cp_rt } => {
                  let rm_r = resolve(tool: rm_tool)
                  match rm_r {
                    NotFound { tool: t, hint: h } => ToolsMissing { tool: t.name, hint: h }
                    Resolved { resolved: rm_rt } => {
                      let find_r = resolve(tool: find_tool)
                      match find_r {
                        NotFound { tool: t, hint: h } => ToolsMissing { tool: t.name, hint: h }
                        Resolved { resolved: find_rt } => ToolsReady {
                          tools: {
                            cargo: cargo_rt.path,
                            grep: grep_rt.path,
                            diff: diff_rt.path,
                            cp: cp_rt.path,
                            rm: rm_rt.path,
                            find: find_rt.path
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// ── Test infrastructure ─────────────────────────────────────────────
// The test crate validates the compiler. Part of the same workspace
// but not part of the self-hosting cycle (not regenerated).

data test_package: NonEmptyStr = "v2-compiler-tests"

// ── v3 source authority inventory (SG program) ──────────────────────
//
// v3 is mid-migration from hand-authored Rust to .dag sources. Unlike
// v2 stage0 (a fully regenerated crate with tiny hand-maintained
// carve-outs) v3's hand-authored surface is still the majority and
// shrinks one lane at a time. The SG program (SG-0..SG-7) sequences
// that dissolution. Each lane's PR ports a group of .rs files to
// .dag authority AND removes those .rs files as authority in the
// same PR — deleted, generated, or reduced to a narrow host shim
// that carries a generated header. No dual-authority period.
//
// This section is the STRUCTURAL authority for the census: the
// directories that count against the inventory, and the marker that
// separates generated files from hand-authored ones. The ENFORCED
// authority — the concrete list of hand-authored .rs paths that
// must only shrink over time — lives with the ratchet test at
// src/v3/compiler/tests/integration/sg0_census_test.rs. The two
// agree today by discipline; when the v3 pipeline is self-hosting
// enough, the test's constant can be derived from this file.

// Directories the census walks for .rs files. The walk is recursive
// within each root; nested build artifacts (target/) are skipped by
// the walker. One root today (`src/v3/compiler`) is enough to reach
// every v3-compiler .rs file on disk — the crate sources, bin
// targets, the emit subtree, the integration test tree, and the
// crate's `build.rs`. Additional census roots land here if v3
// ever grows Rust sources outside this crate.
type V3CensusRoot {
  path: FilePath
}

data v3_census_roots: List<V3CensusRoot> = [
  { path: "src/v3/compiler" }
]

// First non-blank line prefix on every generated .rs file. Every
// regen driver (src/v3/compiler/src/bin/regen_*.rs and the crate's
// build.rs) prepends a header beginning with this string; the
// census classifies any file whose first non-blank line begins with
// it as generated-by-construction and drops it from the hand-
// authored count. Hand-editing a generated file is still forbidden
// by feedback_no_generated_code_on_disk — this marker is the
// discrimination protocol, not a permission.
data v3_generated_marker_prefix: NonEmptyStr = "// AUTO-GENERATED"

// ── Command derivation ──────────────────────────────────────────────
// Every builder takes a resolved cargo/grep/diff/cp/rm path instead of
// a bare name, so emitted shell commands have no hidden PATH dependency.
// Tool workflows call resolve() for each required tool, pattern-match
// on ResolveResult, then pass the FilePath into these builders.

fn build_command(cargo: FilePath, cycle: SelfHostingCycle) -> String {
  concat(cargo, " build -p ", cycle.generated.package_name, " --release")
}

fn check_command(cargo: FilePath, cycle: SelfHostingCycle) -> String {
  concat(cargo, " check -p ", cycle.generated.package_name)
}

fn compile_command(cargo: FilePath, cycle: SelfHostingCycle, output_dir: String) -> String {
  let entry_arg = concat(" --source-root ", cycle.entry_root.path)
  let dep_args = cycle.dependency_roots |> fold(init: "", f: (acc, r) =>
    concat(acc, " --source-root ", r.path)
  )
  concat(cargo, " run -p ", cycle.generated.package_name,
         " --release -- compile", entry_arg, dep_args,
         " --output-dir ", output_dir)
}

// Build a `find ... -delete` predicate that excludes hand-maintained
// files. Used to clean stage0 of stale generated .rs files BEFORE
// copying pass output, so files the compiler stopped emitting don't
// linger in the committed authority. Takes the resolved find binary
// path so the command has no PATH dependency.
fn clean_stage0_generated_command(find: FilePath, cycle: SelfHostingCycle) -> String {
  // Build `! -name X ! -name Y ...` filter from hand_maintained_src
  let exclude_filter = cycle.generated.hand_maintained_src |> fold(init: "", f: (acc, f) =>
    concat(acc, " ! -name ", f)
  )
  // <find_path> SRCDIR -maxdepth 1 -type f -name '*.rs' ! -name cli_run.rs ! -name v2_interpreter.rs -delete
  concat(find, " ", cycle.generated.source_dir,
         " -maxdepth 1 -type f -name '*.rs'", exclude_filter,
         " -delete")
}

// Copy pass 1 output to stage0. Combined with clean_stage0_generated_command
// (which runs first), this synchronizes deletions: pass output replaces
// committed files, removed files are pruned, hand_maintained_src files
// are preserved on both sides.
fn copy_generated_command(cp: FilePath, from_dir: String, cycle: SelfHostingCycle) -> String {
  concat(cp, " ", from_dir, "/src/*.rs ", cycle.generated.source_dir, "/")
}

// Diff exclusion args for hand-maintained files. Applied in freshness
// and fixed-point checks so committed hand-maintained files don't
// register as "stale" (they're not supposed to be regenerated).
fn diff_exclude_args(cycle: SelfHostingCycle) -> String {
  cycle.generated.hand_maintained_src |> fold(init: "", f: (acc, f) =>
    concat(acc, " --exclude=", f)
  )
}

// ── Test/lint commands ──────────────────────────────────────────────
// CI-facing commands derived from the test package name and cargo path.

fn lint_command(cargo: FilePath) -> String {
  concat(cargo, " clippy --workspace -- -D warnings")
}

fn test_command(cargo: FilePath, package: NonEmptyStr) -> String {
  concat(cargo, " test -p ", package)
}

fn ignored_test_command(cargo: FilePath, package: NonEmptyStr, test_name: String) -> String {
  concat(cargo, " test -p ", package, " ", test_name, " -- --ignored --nocapture")
}
