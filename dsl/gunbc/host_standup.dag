module gunbc.host_standup

import std.types { List, String, NonEmptyStr, Bool, Int }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import gunbc.host_effect { Policy, OneShotIdempotent, ConvergeToFixpoint }
import gunbc.bmc_onboarding {
  FactoryDefault,
  CredentialsRotated,
  bmc_credential_probe_to_phase,
  BmcCredentialProbeResult,
  FactoryCredentialActive,
  RotatedCredentialActive,
}
import gunbc.os_install_mechanism {
  NbdProxyVirtualMediaInstall,
  srv3_install_mechanism,
}
import gunbc.host_converge { fleet_converge_policy, ConvergePolicy }
import gunbc.fleet_intent_network { operator_host_srv3 }
import product.placement_supply { HostIdentity }

type HostStandupPrefixPhase
  = BmcCredentialConverge
  | OsInstallMechanismResolved
  | HostConvergePolicyDerived

type HostStandupAssimilationPhase
  = ReachSecretsNetwork
  | RunnerDeploySlot
  | ComputeFabricEnroll
  | GreenPlaceReadiness
  | SessionPlacementEnrollment
  | StandupAssimilationComplete

type HostStandupPhase
  = Prefix { phase: HostStandupPrefixPhase }
  | Assimilation { phase: HostStandupAssimilationPhase }

type PhaseDisposition
  = ModeledCompose { authorities: List<DeclarationRef> }
  | DeclaredGap {
      interim_realization: String
      refusal: String
    }

type HostStandupStep {
  phase: HostStandupPhase
  label: NonEmptyStr
  disposition: PhaseDisposition
  effect_policy: Policy
}

type GapLedgerRow {
  phase_label: String
  modeling: String
  authority_or_interim: String
}

type AssimilationCompleteInput
  = NodeRegistered
  | ResourcesPresent
  | GreenPlacePinCoherent
  | RunnerSlotHealthy

type AssimilationInputWitness
  = InputSatisfied
  | InputRefused { input: AssimilationCompleteInput, reason: String }
  | InputGap { input: AssimilationCompleteInput, interim_realization: String }

type GreenPlacePinCoherentWitness
  = GreenPlaceFromGunbcGate {
      noop_satisfied_authority: DeclarationRef
      marker_satisfied_authority: DeclarationRef
      desired_pin_authority: DeclarationRef
      gate_verdict: Bool
    }
  | GreenPlacePinRefused { reason: String }
  | GreenPlacePinGap { interim_realization: String }

type AssimilationCompleteGate {
  node_registered: AssimilationInputWitness
  resources_present: AssimilationInputWitness
  green_place_pin_coherent: GreenPlacePinCoherentWitness
  runner_healthy: AssimilationInputWitness
}

type AssimilationCompleteVerdict
  = AssimilationComplete
  | AssimilationIncomplete { input: AssimilationCompleteInput, reason: String }

data host_standup_p3_gunbc_pinned_tree_landing_gate: String = "gunbc.host_converge.GunbcPinnedTree (#5948 nimble-koi-42)"

data host_standup_p3_gunbc_pinned_tree_landed: Bool = false

data host_standup_p3_green_place_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_converge",
    decl_name: "GunbcPinnedTree",
    field: WholeDeclaration
  }
}

data host_standup_p5_green_place_noop_gate_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_pinned_noop_satisfied",
  field: WholeDeclaration,
}

data host_standup_p5_green_place_marker_gate_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_green_place_marker_satisfied",
  field: WholeDeclaration,
}

data host_standup_p5_desired_pin_authority: DeclarationRef = DeclarationRef {
  module_path: "gunbc.host_converge",
  decl_name: "gunbc_ctrl_read_pin_script",
  field: WholeDeclaration,
}

data host_standup_p5_green_place_pin_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: host_standup_p5_green_place_noop_gate_authority
}

data host_standup_p5_composite_gate_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_standup",
    decl_name: "AssimilationCompleteGate",
    field: WholeDeclaration
  }
}

fn host_standup_prefix_step(
  phase: HostStandupPrefixPhase,
  label: NonEmptyStr,
  authorities: List<DeclarationRef>,
  effect_policy: Policy
) -> HostStandupStep {
  HostStandupStep {
    phase: Prefix { phase: phase },
    label: label,
    disposition: ModeledCompose { authorities: authorities },
    effect_policy: effect_policy,
  }
}

fn host_standup_assimilation_step(
  phase: HostStandupAssimilationPhase,
  label: NonEmptyStr,
  disposition: PhaseDisposition,
  effect_policy: Policy
) -> HostStandupStep {
  HostStandupStep {
    phase: Assimilation { phase: phase },
    label: label,
    disposition: disposition,
    effect_policy: effect_policy,
  }
}

fn decl_ref(module_path: String, decl_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path as NonEmptyStr,
    decl_name: decl_name as NonEmptyStr,
    field: WholeDeclaration,
  }
}

data host_standup_spine: List<HostStandupStep> = [
  host_standup_prefix_step(
    phase: BmcCredentialConverge,
    label: "prefix:bmc-credential-converge",
    authorities: [
      decl_ref(module_path: "gunbc.bmc_onboarding", decl_name: "bmc_credential_probe_to_phase"),
      decl_ref(module_path: "gunbc.tools.bmc_onboard", decl_name: "bmc_converge_credential_idempotent"),
    ],
    effect_policy: OneShotIdempotent
  ),
  host_standup_prefix_step(
    phase: OsInstallMechanismResolved,
    label: "prefix:os-install-mechanism",
    authorities: [
      decl_ref(module_path: "gunbc.os_install_mechanism", decl_name: "solve_install_mechanism"),
      decl_ref(module_path: "gunbc.os_install_mechanism", decl_name: "srv3_install_mechanism"),
    ],
    effect_policy: OneShotIdempotent
  ),
  host_standup_prefix_step(
    phase: HostConvergePolicyDerived,
    label: "prefix:host-converge",
    authorities: [
      decl_ref(module_path: "gunbc.host_converge", decl_name: "fleet_converge_policy"),
      decl_ref(module_path: "gunbc.fleet_converge_emit", decl_name: "expected_fleet_converge_sh"),
    ],
    effect_policy: ConvergeToFixpoint
  ),
  host_standup_assimilation_step(
    phase: ReachSecretsNetwork,
    label: "P0:reach-secrets-network",
    disposition: DeclaredGap {
      interim_realization: "ctrl:scripts/session-dashboard/lib/grant_host_reach.mjs;scripts/session-dashboard/lib/spawn_github_token.mjs;scripts/session-dashboard/lib/prepare_host_bind_dirs.mjs",
      refusal: "host_standup:P0:reach-secrets-network:unmodeled — refuse until reach/secrets/bind-dir facts have a .dag authority (interim ctrl .mjs only)"
    },
    effect_policy: OneShotIdempotent
  ),
  host_standup_assimilation_step(
    phase: RunnerDeploySlot,
    label: "P1:runner-deploy-slot",
    disposition: ModeledCompose {
      authorities: [
        decl_ref(module_path: "gunbc.runner_spec_from_offer", decl_name: "runner_spec_from_offer"),
        decl_ref(module_path: "gunbc.runner_deploy_emit", decl_name: "expected_runner_deploy_manifest"),
        decl_ref(module_path: "gunbc.runner_slot_enforcement", decl_name: "reconcile_runner_slot"),
        decl_ref(module_path: "gunbc.ci_runner_placement", decl_name: "runner_deployment_plan"),
      ]
    },
    effect_policy: ConvergeToFixpoint
  ),
  host_standup_assimilation_step(
    phase: ComputeFabricEnroll,
    label: "P2:compute-fabric-enroll",
