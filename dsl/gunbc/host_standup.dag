    authority_or_interim: "gunbc.host_standup.AssimilationCompleteGate — AND(node_registered, resources_present, green_place_pin_coherent via gunbc_pinned_noop_satisfied gate ref, runner_slot_healthy); no pin re-derivation in P5"
  },
]

data srv3_host_standup_target: HostIdentity = operator_host_srv3

fn host_standup_spine_length() -> Int {
  host_standup_spine.length()
}

fn host_standup_step_is_gap(step: HostStandupStep) -> Bool {
  match step.disposition {
    DeclaredGap { interim_realization: _, refusal: _ } => true
    ModeledCompose { authorities: _ } => false
  }
}

fn host_standup_step_is_effective_gap(step: HostStandupStep) -> Bool {
  match step.phase {
    Assimilation { phase: GreenPlaceReadiness } =>
      !host_standup_p3_gunbc_pinned_tree_landed || host_standup_step_is_gap(step: step)
    _ => host_standup_step_is_gap(step: step)
  }
}

fn host_standup_p3_green_place_input_witness() -> GreenPlacePinCoherentWitness {
  if host_standup_p3_gunbc_pinned_tree_landed {
    GreenPlacePinGap {
      interim_realization: "runtime: inject gate_verdict from gunbc_pinned_noop_satisfied after #5948 lands"
    }
  } else {
    GreenPlacePinGap {
      interim_realization: host_standup_p3_gunbc_pinned_tree_landing_gate
    }
  }
}

fn host_standup_p5_default_green_place_gate_verdict() -> GreenPlacePinCoherentWitness {
  GreenPlaceFromGunbcGate {
    noop_satisfied_authority: host_standup_p5_green_place_noop_gate_authority,
    marker_satisfied_authority: host_standup_p5_green_place_marker_gate_authority,
    desired_pin_authority: host_standup_p5_desired_pin_authority,
    gate_verdict: false,
  }
}

fn green_place_pin_coherent_satisfied(w: GreenPlacePinCoherentWitness) -> Bool {
  match w {
    GreenPlaceFromGunbcGate { gate_verdict: v, noop_satisfied_authority: _, marker_satisfied_authority: _, desired_pin_authority: _ } => v
    GreenPlacePinRefused { reason: _ } => false
    GreenPlacePinGap { interim_realization: _ } => false
  }
}

fn green_place_pin_coherent_failure(w: GreenPlacePinCoherentWitness) -> AssimilationCompleteVerdict? {
  match w {
    GreenPlaceFromGunbcGate { gate_verdict: false, noop_satisfied_authority: _, marker_satisfied_authority: _, desired_pin_authority: _ } =>
      Present {
        value: AssimilationIncomplete {
          input: GreenPlacePinCoherent,
          reason: "host_standup:P5:green_place_pin_coherent: gunbc gate verdict false or unread — fail-closed, no pin re-derivation in spine"
        }
      }
    GreenPlaceFromGunbcGate { gate_verdict: true, noop_satisfied_authority: _, marker_satisfied_authority: _, desired_pin_authority: _ } => Absent
    GreenPlacePinRefused { reason: r } =>
      Present { value: AssimilationIncomplete { input: GreenPlacePinCoherent, reason: r } }
    GreenPlacePinGap { interim_realization: path } =>
      Present {
        value: AssimilationIncomplete {
          input: GreenPlacePinCoherent,
          reason: concat("host_standup:P5:gap-refused:", path)
        }
      }
  }
}

fn host_standup_default_assimilation_gate_unsatisfied() -> AssimilationCompleteGate {
  AssimilationCompleteGate {
    node_registered: InputGap { input: NodeRegistered, interim_realization: "ctrl:node_registry.mjs" },
    resources_present: InputGap { input: ResourcesPresent, interim_realization: "ctrl:resources-present-unmodeled" },
    green_place_pin_coherent: host_standup_p3_green_place_input_witness(),
    runner_healthy: InputGap { input: RunnerSlotHealthy, interim_realization: "gunbc.runner_slot_enforcement until P1 converged" },
  }
}

fn host_standup_p3_fail_closed_blocks_complete() -> Bool {
  !host_standup_p3_gunbc_pinned_tree_landed
    && match assimilation_complete(gate: host_standup_default_assimilation_gate_unsatisfied()) {
      AssimilationIncomplete { input: GreenPlacePinCoherent, reason: r } =>
        string_contains(s: r, pattern: "#5948")
      AssimilationComplete => false
      AssimilationIncomplete { input: _, reason: _ } => true
    }
}

fn host_standup_gap_count() -> Int {
  fold(
    host_standup_spine,
    init: 0,
    f: (acc, s) => if host_standup_step_is_effective_gap(step: s) { acc + 1 } else { acc }
  )
}

fn assimilation_input_satisfied(w: AssimilationInputWitness) -> Bool {
  match w {
    InputSatisfied => true
    InputRefused { input: _, reason: _ } => false
    InputGap { input: _, interim_realization: _ } => false
  }
}

fn assimilation_input_failure(w: AssimilationInputWitness) -> AssimilationCompleteVerdict? {
  match w {
    InputSatisfied => Absent
    InputRefused { input: i, reason: r } =>
      Present { value: AssimilationIncomplete { input: i, reason: r } }
    InputGap { input: i, interim_realization: path } =>
      Present {
        value: AssimilationIncomplete {
          input: i,
          reason: concat("host_standup:P5:gap-refused:", path)
        }
      }
  }
}

fn assimilation_complete_first_failure(gate: AssimilationCompleteGate) -> AssimilationCompleteVerdict? {
  match assimilation_input_failure(w: gate.node_registered) {
    Present { value: v } => Present { value: v }
    Absent =>
      match assimilation_input_failure(w: gate.resources_present) {
        Present { value: v } => Present { value: v }
        Absent =>
          match green_place_pin_coherent_failure(w: gate.green_place_pin_coherent) {
            Present { value: v } => Present { value: v }
            Absent => assimilation_input_failure(w: gate.runner_healthy)
          }
      }
  }
}

fn assimilation_complete(gate: AssimilationCompleteGate) -> AssimilationCompleteVerdict {
  match assimilation_complete_first_failure(gate: gate) {
    Present { value: v } => v
    Absent => AssimilationComplete
  }
}

fn assimilation_complete_all_satisfied(gate: AssimilationCompleteGate) -> Bool {
  assimilation_input_satisfied(w: gate.node_registered)
    && assimilation_input_satisfied(w: gate.resources_present)
    && green_place_pin_coherent_satisfied(w: gate.green_place_pin_coherent)
    && assimilation_input_satisfied(w: gate.runner_healthy)
}

fn srv3_install_mechanism_is_nbd_proxy_no_fallback() -> Bool {
  match srv3_install_mechanism {
    NbdProxyVirtualMediaInstall => true
    _ => false
  }
}

fn credential_probe_maps_factory_default(probe: BmcCredentialProbeResult) -> Bool {
  match bmc_credential_probe_to_phase(probe: probe) {
    Present { value: FactoryDefault } => true
    Present { value: _ } => false
    Absent => false
  }
}

fn credential_probe_maps_credentials_rotated(probe: BmcCredentialProbeResult) -> Bool {
  match bmc_credential_probe_to_phase(probe: probe) {
    Present { value: CredentialsRotated } => true
    Present { value: _ } => false
    Absent => false
  }
}

fn host_standup_fleet_converge_policy() -> ConvergePolicy {
  fleet_converge_policy()
}
