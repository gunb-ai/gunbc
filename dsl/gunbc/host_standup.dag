      interim_realization: "ctrl:scripts/session-dashboard/lib/node_registry.mjs",
      refusal: "host_standup:P2:compute-fabric-enroll:enroll-act-unmodeled — product.compute_fabric.connect shapes the need/opportunity match but the enroll act is interim ctrl only"
    },
    effect_policy: OneShotIdempotent
  ),
  host_standup_assimilation_step(
    phase: GreenPlaceReadiness,
    label: "P3:green-place-readiness",
    disposition: ModeledCompose {
      authorities: [
        decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_green_place_marker_spec"),
        decl_ref(module_path: "gunbc.host_converge", decl_name: "GunbcPinnedTree"),
        decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_pinned_noop_satisfied"),
        decl_ref(module_path: "gunbc.host_converge", decl_name: "gunbc_pinned_tree_knob"),
      ]
    },
    effect_policy: ConvergeToFixpoint
  ),
  host_standup_assimilation_step(
