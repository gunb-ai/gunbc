  GapLedgerRow {
    phase_label: "prefix:bmc-credential-converge",
    modeling: "modeled",
    authority_or_interim: "gunbc.bmc_onboarding.bmc_credential_probe_to_phase + gunbc.tools.bmc_onboard.bmc_converge_credential_idempotent (#5949 idempotent probe)"
  },
  GapLedgerRow {
    phase_label: "prefix:os-install-mechanism",
    modeling: "modeled",
    authority_or_interim: "gunbc.os_install_mechanism.srv3_install_mechanism (srv3=NbdProxyVirtualMediaInstall, no fallback)"
  },
  GapLedgerRow {
    phase_label: "prefix:host-converge",
    modeling: "modeled",
    authority_or_interim: "gunbc.host_converge.fleet_converge_policy + gunbc.fleet_converge_emit.expected_fleet_converge_sh"
  },
  GapLedgerRow {
    phase_label: "P0:reach-secrets-network",
    modeling: "gap",
    authority_or_interim: "ctrl: grant_host_reach.mjs, spawn_github_token.mjs, prepare_host_bind_dirs.mjs"
  },
  GapLedgerRow {
    phase_label: "P1:runner-deploy-slot",
    modeling: "modeled",
    authority_or_interim: "gunbc.runner_spec_from_offer + gunbc.runner_deploy_emit + gunbc.runner_slot_enforcement + gunbc.ci_runner_placement"
  },
  GapLedgerRow {
    phase_label: "P2:compute-fabric-enroll",
    modeling: "gap-shape-only",
    authority_or_interim: "product.compute_fabric.connect (shape); enroll act: ctrl node_registry.mjs"
  },
  GapLedgerRow {
    phase_label: "P3:green-place-readiness",
    modeling: "modeled-pending-landing",
    authority_or_interim: "gunbc AUTHORITY: GunbcPinnedTree/gunbc_pinned_noop_satisfied/gunbc_green_place_marker_spec (#5948); ctrl VERIFY/WRITER → plans/reconcile/converge/green_place.dag (shadow_connect pattern; #1848 hand-mjs closed); desired pin: read-gunbc-pin.sh"
  },
  GapLedgerRow {
    phase_label: "P4:session-placement-enrollment",
