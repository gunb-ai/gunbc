// GATE-0 throwaway probe — DELETE after confirming the service-op CLI seam.
// Proves claim_batch can evaluate a .dag function that fires github.Actions
// ListWorkflowRunJobs end-to-end (real ureq HTTP, JSON->typed records).

module gate0_probe_temp

import extdeps.github.actions_runs

fn gate0_probe() -> Bool {
  result = github.Actions.ListWorkflowRunJobs(
    auth_token: "",
    owner: "gunb-ai",
    repo: "gunbc",
    run_id: 27454321323
  )
  // True iff we got real job records back with non-empty names — proves the
  // wrapper-object response parsed into typed WorkflowRunJob records.
  any(result.jobs, j => j.name != "")
}
