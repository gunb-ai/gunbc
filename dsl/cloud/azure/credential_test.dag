// credential_test.dag -- Test specification for Azure Key Vault credential.
//
// Replaces lib/azure-ops/src/graph_mock.rs.

module cloud.azure.credential_test

test azure_keyvault_stub_dryrun {
    @tier(Unit)
    @hermetic(true)
    @auto_mock(true)

    // Cloud secret config
    input azure_key_vault_stub.config -> { provider: "azure", tenant: "azure-tenant", client_id: "azure-client-id", prefix: "ci-", secret_name: "anthropic" }
    input azure_key_vault_stub.scheme -> "bearer"
    input azure_key_vault_stub.header_name -> ""
    input azure_key_vault_stub.source_id -> "azure"
    input azure_key_vault_stub.request_url -> "https://vault.azure.net"
    input azure_key_vault_stub.request_token -> "mock-azure-token"

    // Credential boundary output
    mock azure_key_vault_stub.credential -> { token: "<MOCK_AZURE_TOKEN>", source_type: "static", scheme: "bearer" }
}
