// cloud/azure/credential.dag -- Azure credential acquisition.
//
// Azure uses Managed Identity (system or user-assigned) or federated
// identity credentials (for CI via GitHub Actions OIDC).
//
// In CI: GitHub OIDC -> federated credential on a managed identity
//        -> request token from Azure AD
// Locally: Azure CLI `az login` provides tokens via MSAL cache.
//
// Pattern: OIDC/CLI -> Azure AD token -> bearer auth for ARM/data-plane

module cloud.azure.credential

import infra.azure.services { azure.ManagedIdentity }
import std.resources { AuthContext }
import std.types { CloudRuntime, AccessToken, NonEmptyStr }

// Azure token with scope and expiry
type AzureAccessToken {
  access_token: Secret
  expires_on: String
  resource: String
}

func acquire_azure_credentials(
  runtime: CloudRuntime,
  tenant_id: NonEmptyStr,
  client_id: NonEmptyStr,
  resource: String = "https://management.azure.com/",
  subscription_id: NonEmptyStr? = None
) -> { token: AzureAccessToken }
  provides auth: AuthContext
{
  result = match runtime {
    CloudRun => {
      // In CI: exchange GitHub OIDC token for Azure AD token
      // Uses federated identity credential configured on the managed identity
      oidc_token = env("ACTIONS_ID_TOKEN_REQUEST_TOKEN")

      // Exchange OIDC token for Azure AD access token
      // This uses the standard OAuth2 client credentials flow with federated assertion
      token = azure_ad_token_exchange(
        tenant_id: tenant_id,
        client_id: client_id,
        assertion: oidc_token,
        resource: resource
      )

      AzureAccessToken {
        access_token: token.access_token,
        expires_on: token.expires_on,
        resource: resource
      }
    }

    Local => {
      // Locally: use Azure CLI cached credentials
      // `az account get-access-token --resource <resource>`
      token = shell.Azure.GetAccessToken(resource: resource)

      AzureAccessToken {
        access_token: token.access_token,
        expires_on: token.expires_on,
        resource: resource
      }
    }
  }

  return { token: result }
}

// Convenience: acquire credentials and read a Key Vault secret
func acquire_azure_secret(
  runtime: CloudRuntime,
  tenant_id: NonEmptyStr,
  client_id: NonEmptyStr,
  vault_name: NonEmptyStr,
  secret_name: NonEmptyStr
) -> { value: Secret }
  provides auth: AuthContext
{
  creds = acquire_azure_credentials(
    runtime: runtime,
    tenant_id: tenant_id,
    client_id: client_id,
    resource: "https://vault.azure.net"
  )

  secret = azure.KeyVault.GetSecret(
    vault_name: vault_name,
    name: secret_name
  ) [after creds]

  return { value: secret.value }
}

// Internal: Azure AD token exchange (federated credential flow)
// POST https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token
// Body: client_id, client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer,
//       client_assertion={oidc_token}, scope={resource}/.default, grant_type=client_credentials
fn azure_ad_token_exchange(
  tenant_id: NonEmptyStr,
  client_id: NonEmptyStr,
  assertion: Secret,
  resource: String
) -> { access_token: Secret, expires_on: String }
{
  return { access_token: assertion, expires_on: "0" }
}
