// cloud/gcp/credential.dag -- GCP credential acquisition.
//
// Wraps the credential_chain pattern to acquire a GCP secret.
// This is the entry point that tools like gist and review call
// to get authenticated access to GCP services.
//
// Replaces: lib/gcp-ops/src/graph.rs + lib/cloud-ops/src/graph.rs
//           Total: 4,000+ lines across 6+ files -> ~25 lines

module cloud.gcp.credential

import services.gcp.secret_manager
import services.gcp.iam
import services.gcp.sts
import std.patterns { credential_chain }
import std.resources { AuthContext }
import std.types {
  CloudRuntime,
  CloudSecretConfig,
  AccessToken,
  AuthScheme,
  ProjectId,
  NonEmptyStr,
  ServiceAccountEmail
}

// Extract the raw Secret from an AccessToken record.
// Workaround: the lowerer can't wire two-level field access (cred.token.token)
// to res:credential, so we use a pure fn to do the extraction.
fn extract_secret(tok: AccessToken) -> Secret {
  tok.token
}

func acquire_gcp_secret(
  runtime: CloudRuntime,
  project_id: ProjectId,
  secret_name: NonEmptyStr,
  audience: NonEmptyStr = "sigstore",
  service_account: ServiceAccountEmail?,
  scheme: AuthScheme = Bearer,
  header_name: String?,
  source_id: NonEmptyStr,
  required_scopes: List<String>,
  lifetime_seconds: Int where range(min: 1, max: 3600)= 3600
) -> { token: AccessToken, secret: Secret }
  provides auth: AuthContext
{
  cred = credential_chain(
    runtime: runtime,
    audience: audience,
    service_account: service_account,
    secret_name: secret_name,
    project_id: project_id,
    scheme: scheme,
    header_name: header_name,
    source_id: source_id,
    required_scopes: required_scopes,
    lifetime_seconds: lifetime_seconds
  )

  raw = extract_secret(tok: cred.token)
  return { token: cred.token, secret: raw }
}

// ── Tests ──────────────────────────────────────────────────────────
//
// Three flows: GitHub WIF, local-dev ADC, and secret upsert.
//
// NOTE: Complex REST response payloads and OAuth2 flows still use Rust
// helpers via @rust_mock_helpers for realistic response construction.

// GitHub Actions WIF + Secret Manager flow.
test gcp_github_credential {

    // Transport mocks for the four-step OAuth2 flow
    mock execute_github_oidc.response -> rest_response(200, { value: "mock-oidc-token" })
    mock execute_sts.response -> rest_response(200, { access_token: "mock-sts-token", expires_in: 3600, token_type: "Bearer" })
    mock execute_impersonate.response -> rest_response(200, { accessToken: "mock-sa-token", expireTime: "2099-01-01T00:00:00Z" })
    mock execute_secret_access.response -> rest_response(200, { payload: { "data": "bW9jay1zZWNyZXQ=" } })

    // Input mocks
    input cloud_env.audience -> "projects/123/locations/global/workloadIdentityPools/github/providers/gha"
    input cloud_env.service_account -> "ci-secrets@mock.iam.gserviceaccount.com"
    input cloud_env.project_id -> "mock-secrets"
    input cloud_env.secret_name -> "github"

    expect result.credential is NonEmpty
}

// Local-dev ADC auth (testgen skipped — used as composition helper).
test gcp_local_credential {

    // ADC file check
    mock execute_adc_check.response -> file_response("~/.config/gcloud/application_default_credentials.json")

    // OAuth2 refresh
    mock execute_oauth_refresh.response -> rest_response(200, { access_token: "mock-adc-token", expires_in: 3600 })

    expect result.credential is NonEmpty
}

// Secret upsert flow (create + add version).
test gcp_github_upsert {

    // Get existing secret (404 — not found, triggers create)
    mock execute_secret_get.response -> rest_response(404, { error: { code: 404, message: "NOT_FOUND" } })
    mock execute_secret_create.response -> rest_response(200, { name: "projects/mock-secrets/secrets/github" })
    mock execute_add_version.response -> rest_response(200, { name: "projects/mock-secrets/secrets/github/versions/1" })

    expect result.version is String
}
