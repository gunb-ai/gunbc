// cloud/aws/credential.dag -- AWS credential acquisition.
//
// AWS uses OIDC federation -> STS AssumeRoleWithWebIdentity to get
// temporary session credentials. This is the equivalent of GCP's
// WIF -> STS exchange -> impersonation chain.
//
// In CI (e.g., GitHub Actions), the OIDC token is available via
// the ACTIONS_ID_TOKEN_REQUEST_URL environment variable.
// Locally, credentials come from the AWS CLI profile or env vars.
//
// Pattern: OIDC token -> STS AssumeRoleWithWebIdentity -> session creds

module cloud.aws.credential

import infra.aws.services { aws.STS }
import std.types { CloudRuntime, AccessToken }

// AWS session credentials bundle
type AwsSessionCredentials {
  access_key_id: Secret
  secret_access_key: Secret
  session_token: Secret
  expiration: String
}

func acquire_aws_credentials(
  runtime: CloudRuntime,
  role_arn: NonEmptyStr,
  session_name: NonEmptyStr = "gunbc-session",
  region: String = "us-east-1",
  duration_seconds: Int @range(min: 900, max: 43200) = 3600
) -> { credentials: AwsSessionCredentials }
  provides auth: AuthContext
{
  // Branch on runtime: CI uses OIDC federation, local uses profile/env
  result = match runtime {
    CloudRun => {
      // In CI: get OIDC token from environment, exchange via STS
      oidc_token = env("ACTIONS_ID_TOKEN_REQUEST_TOKEN")
      sts_result = aws.STS.AssumeRoleWithWebIdentity(
        role_arn: role_arn,
        session_name: session_name,
        web_identity_token: oidc_token
      )
      AwsSessionCredentials {
        access_key_id: sts_result.access_key_id,
        secret_access_key: sts_result.secret_access_key,
        session_token: sts_result.session_token,
        expiration: sts_result.expiration
      }
    }

    Local => {
      // Locally: assume role via existing CLI credentials
      sts_result = aws.STS.AssumeRole(
        role_arn: role_arn,
        session_name: session_name,
        duration_seconds: duration_seconds
      )
      AwsSessionCredentials {
        access_key_id: sts_result.access_key_id,
        secret_access_key: sts_result.secret_access_key,
        session_token: sts_result.session_token,
        expiration: sts_result.expiration
      }
    }
  }

  return { credentials: result }
}

// Convenience: acquire credentials and read a specific secret
func acquire_aws_secret(
  runtime: CloudRuntime,
  role_arn: NonEmptyStr,
  secret_name: NonEmptyStr,
  region: String = "us-east-1"
) -> { value: Secret }
  provides auth: AuthContext
{
  creds = acquire_aws_credentials(
    runtime: runtime,
    role_arn: role_arn,
    region: region
  )

  secret = aws.SecretsManager.GetSecretValue(
    secret_id: secret_name
  ) [after creds]

  return { value: secret.secret_string }
}
