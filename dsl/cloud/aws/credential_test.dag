// credential_test.dag -- Test specification for AWS Secrets Manager credential.
//
// Replaces lib/aws-ops/src/graph_mock.rs.

module cloud.aws.credential_test

test aws_secrets_stub_dryrun {
    @tier(Unit)
    @hermetic(true)
    @auto_mock(true)

    // Cloud secret config
    input aws_secrets_manager_stub.config -> { provider: "aws", account: "123456789012", prefix: "ci-", secret_name: "openai" }
    input aws_secrets_manager_stub.scheme -> "bearer"
    input aws_secrets_manager_stub.header_name -> ""
    input aws_secrets_manager_stub.source_id -> "aws"
    input aws_secrets_manager_stub.request_url -> "https://secretsmanager.us-east-1.amazonaws.com"
    input aws_secrets_manager_stub.request_token -> "mock-aws-token"

    // Credential boundary output
    mock aws_secrets_manager_stub.credential -> { token: "<MOCK_AWS_TOKEN>", source_type: "static", scheme: "bearer" }
}
