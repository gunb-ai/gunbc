// tests/cas_stress_test.dag -- SP-5: Multi-worker CAS stress test.
//
// Validates exactly-once claim processing with 3 concurrent workers
// using GCS generation-based Compare-And-Swap.
//
// Test matrix:
//   1. Three workers race for the same claim -> exactly one wins
//   2. Heartbeat with stale generation -> rejection
//   3. Lease expiry -> re-acquisition by different worker
//   4. Concurrent release + re-acquire -> generation monotonicity
//   5. Multiple issues -> no cross-contamination
//
// CAS mechanism: GCS x-goog-if-generation-match header.
//   - Generation 0 = object does not exist (first acquire)
//   - Each successful write increments generation
//   - 412 Precondition Failed = conflict (another worker won)
//
// Invariants tested:
//   INV-9:  Mutual exclusion (at most one claim holder per (issue_id, stage))
//   INV-10: Generation monotonicity (generation only increases)

module tests.cas_stress_test

import interfaces.claim_store { ClaimStore }
import std.types { NonEmptyStr }

// ── Helpers ─────────────────────────────────────────────────────────

fn worker_id(n: Int) -> String {
  "worker-{n}"
}

// ── Test: Three workers race for same claim ─────────────────────────
// INV-9: Exactly one worker acquires the claim. The other two get
// 412 Precondition Failed from GCS CAS.

test three_workers_race_one_wins {

    // Worker 1: acquires successfully (wins the race)
    input worker1_acquire.issue_id -> "100"
    input worker1_acquire.stage -> "design"
    input worker1_acquire.owner -> "worker-1"
    input worker1_acquire.lease_ttl_ms -> 30000

    mock worker1_acquire/execute.response -> rest_response(200, {
        name: "claims/100/design.json",
        generation: "1706745600000000",
        metageneration: "1"
    })

    // Worker 2: gets 412 conflict (worker 1 already holds)
    input worker2_acquire.issue_id -> "100"
    input worker2_acquire.stage -> "design"
    input worker2_acquire.owner -> "worker-2"
    input worker2_acquire.lease_ttl_ms -> 30000

    mock worker2_acquire/execute.response -> rest_response(412, {
        error: {
            code: 412,
            message: "Precondition Failed",
            errors: [{ reason: "conditionNotMet" }]
        }
    })

    // Worker 3: also gets 412 conflict
    input worker3_acquire.issue_id -> "100"
    input worker3_acquire.stage -> "design"
    input worker3_acquire.owner -> "worker-3"
    input worker3_acquire.lease_ttl_ms -> 30000

    mock worker3_acquire/execute.response -> rest_response(412, {
        error: {
            code: 412,
            message: "Precondition Failed",
            errors: [{ reason: "conditionNotMet" }]
        }
    })

    // INV-9: Exactly one acquired, two conflicted
    expect worker1_result.acquired == true
    expect worker1_result.conflict == false
    expect worker2_result.acquired == false
    expect worker2_result.conflict == true
    expect worker3_result.acquired == false
    expect worker3_result.conflict == true
}

// ── Test: Heartbeat with stale generation ───────────────────────────
// INV-10: A heartbeat with an old generation is rejected (412).
// This detects lease theft -- another worker acquired the claim
// between heartbeats.

test heartbeat_stale_generation_rejected {

    input heartbeat.issue_id -> "100"
    input heartbeat.stage -> "design"
    input heartbeat.owner -> "worker-1"
    input heartbeat.generation -> 1706745500000000  // Stale generation

    // GCS returns 412 -- generation mismatch, lease was stolen
    mock heartbeat/execute.response -> rest_response(412, {
        error: { code: 412, message: "Precondition Failed" }
    })

    expect result.accepted == false
}

// ── Test: Lease expiry and re-acquisition ───────────────────────────
// After lease_ttl_ms expires, another worker can acquire the claim
// by using the current generation (not 0).

test lease_expiry_allows_reacquisition {

    // Worker 1's lease has expired (simulated by time passing).
    // Worker 2 reads the existing object, sees expired lease,
    // and re-acquires using the existing generation.
    input reacquire.issue_id -> "100"
    input reacquire.stage -> "design"
    input reacquire.owner -> "worker-2"
    input reacquire.lease_ttl_ms -> 30000
    input reacquire.expected_generation -> 1706745600000000  // Match existing

    // CAS write with matching generation succeeds
    mock reacquire/execute.response -> rest_response(200, {
        name: "claims/100/design.json",
        generation: "1706745700000000",  // New, higher generation
        metageneration: "2"
    })

    expect result.acquired == true
    expect result.conflict == false
    // INV-10: New generation > old generation
    expect result.lease_generation > 1706745600000000
}

// ── Test: Concurrent release + re-acquire ───────────────────────────
// Worker 1 releases, Worker 2 acquires. The generation after
// Worker 2's acquire must be strictly greater than Worker 1's.

test release_then_reacquire_monotonic {

    // Worker 1 releases with matching generation
    input release.issue_id -> "100"
    input release.stage -> "design"
    input release.owner -> "worker-1"
    input release.generation -> 1706745600000000

    mock release/execute.response -> rest_response(204, {})

    // Worker 2 acquires (object deleted, generation 0)
    input acquire.issue_id -> "100"
    input acquire.stage -> "design"
    input acquire.owner -> "worker-2"
    input acquire.lease_ttl_ms -> 30000

    mock acquire/execute.response -> rest_response(200, {
        name: "claims/100/design.json",
        generation: "1706745800000000",
        metageneration: "1"
    })

    expect release_result.released == true
    expect acquire_result.acquired == true
}

// ── Test: Multiple issues no cross-contamination ────────────────────
// Workers processing different issues never interfere. Claim for
// issue 100 does not block claim for issue 200.

test multiple_issues_independent {

    // Worker 1 claims issue 100/design
    input worker1_acquire.issue_id -> "100"
    input worker1_acquire.stage -> "design"
    input worker1_acquire.owner -> "worker-1"
    input worker1_acquire.lease_ttl_ms -> 30000

    mock worker1_acquire/execute.response -> rest_response(200, {
        name: "claims/100/design.json",
        generation: "1000",
        metageneration: "1"
    })

    // Worker 2 claims issue 200/design (different object path)
    input worker2_acquire.issue_id -> "200"
    input worker2_acquire.stage -> "design"
    input worker2_acquire.owner -> "worker-2"
    input worker2_acquire.lease_ttl_ms -> 30000

    mock worker2_acquire/execute.response -> rest_response(200, {
        name: "claims/200/design.json",
        generation: "2000",
        metageneration: "1"
    })

    // Worker 3 claims issue 100/implementing (same issue, different stage)
    input worker3_acquire.issue_id -> "100"
    input worker3_acquire.stage -> "implementing"
    input worker3_acquire.owner -> "worker-3"
    input worker3_acquire.lease_ttl_ms -> 30000

    mock worker3_acquire/execute.response -> rest_response(200, {
        name: "claims/100/implementing.json",
        generation: "3000",
        metageneration: "1"
    })

    // All three workers acquire independently
    expect worker1_result.acquired == true
    expect worker2_result.acquired == true
    expect worker3_result.acquired == true
}
