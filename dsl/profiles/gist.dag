// profiles/gist.dag -- Deployment profiles for gist credential binding.
//
// Binds the CredentialProvider interface to concrete implementations:
// - local/dev: LocalCredentialProvider (reads GITHUB_TOKEN from env)
// - test/prod: GcpWifCredentialProvider (full GCP WIF chain for CI)

module profiles.gist

import interfaces.credential_provider { CredentialProvider }
import extdeps.sdlc.providers.local_credential_provider { LocalCredentialProvider }
import extdeps.sdlc.providers.gcp_credential_provider { GcpWifCredentialProvider }

// Local development -- reads GITHUB_TOKEN from environment.
profile local {
  bind CredentialProvider -> extdeps.sdlc.providers.local_credential_provider.LocalCredentialProvider {
    cache_dir: "~/.gunbc/credentials"
  }
}

// Development -- same as local.
profile dev {
  bind CredentialProvider -> extdeps.sdlc.providers.local_credential_provider.LocalCredentialProvider {
    cache_dir: "~/.gunbc/credentials"
  }
}

// CI / GitHub Actions -- full GCP WIF credential chain.
profile test {
  bind CredentialProvider -> extdeps.sdlc.providers.gcp_credential_provider.GcpWifCredentialProvider {
    runtime: GitHubActions,
    project_id: "gunbai-secrets"
  }
}

// Production -- same as test (runs on GitHub Actions).
profile prod {
  bind CredentialProvider -> extdeps.sdlc.providers.gcp_credential_provider.GcpWifCredentialProvider {
    runtime: GitHubActions,
    project_id: "gunbai-secrets"
  }
}
