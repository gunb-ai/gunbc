// profiles/cloud_run.dag -- Cloud Run (GCP) deployment profile.
//
// Binds domain interfaces to GCP-native implementations:
//   - GitHub API for issue management
//   - GCS objects for claims, outcomes, artifacts (with generation-based CAS)
//   - GCP Pub/Sub for signals
//   - Codex CLI for agent execution
//
// Profile invariants (INV-20, INV-21):
//   - Every interface used in the pipeline is bound.
//   - Profile is compile-time only (no runtime switching).
//
// Canonical reference: domain-modeling-comprehensive.md §5.1

module profiles.cloud_run

import interfaces.issue_provider { IssueProvider }
import interfaces.claim_store { ClaimStore }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }
import interfaces.signal_store { SignalStore }
import interfaces.artifact_store { ArtifactStore }
import services.github.issues { github.Issues }
import services.agent.codex { agent.Codex }

profile cloud_run {
  bind IssueProvider    -> github.Issues {
    owner: "gunb-ai"
    repo: "gunbc"
    credential: secret("github-token", project: "gunbai-auto")
  }
  bind ClaimStore       -> GcsClaimStore {
    bucket: "gunbai-auto-sdlc-claims"
    project: "gunbai-auto"
  }
  bind OutcomeLedger    -> GcsOutcomeLedger {
    bucket: "gunbai-auto-sdlc-outcomes"
    project: "gunbai-auto"
  }
  bind AgentProvider    -> agent.Codex {
    credential: secret("codex-api-key", project: "gunbai-auto")
  }
  bind SignalStore      -> PubSubSignalStore {
    topic: "sdlc-signals"
    subscription: "sdlc-worker"
    project: "gunbai-auto"
  }
  bind ArtifactStore    -> GcsArtifactStore {
    bucket: "gunbai-auto-sdlc-artifacts"
    project: "gunbai-auto"
  }
}

// --- GCS-backed implementations ------------------------------------------
// These use GCS objects with generation-based CAS (x-goog-if-generation-match).
// INV-13: CAS provides mutual exclusion and conflict detection.

service GcsClaimStore : ClaimStore {
  @endpoint("https://storage.googleapis.com/storage/v1")
  @auth(BearerToken)

  config {
    bucket: String
    project: String
  }

  operation acquire {
    input { issue_id: String, stage: String, owner: String, lease_ttl_ms: Int }
    output { acquired: Bool, conflict: Bool, lease_generation: Int }
    @rest(POST, "/b/{config.bucket}/o?name=claims/{issue_id}/{stage}.json")
    // Uses x-goog-if-generation-match:0 for create-if-not-exists semantics.
    // If the object already exists, checks expiry before reporting conflict.
    @mock_response(status: 200, body: { "acquired": true, "conflict": false, "lease_generation": 1 })
  }

  operation heartbeat {
    input { issue_id: String, stage: String, owner: String, generation: Int }
    output { accepted: Bool }
    @rest(PUT, "/b/{config.bucket}/o/claims/{issue_id}/{stage}.json")
    @idempotent
    @mock_response(status: 200, body: { "accepted": true })
  }

  operation release {
    input { issue_id: String, stage: String, owner: String, generation: Int }
    output { released: Bool }
    @rest(DELETE, "/b/{config.bucket}/o/claims/{issue_id}/{stage}.json")
    @idempotent
    @mock_response(status: 200, body: { "released": true })
  }
}

service GcsOutcomeLedger : OutcomeLedger {
  @endpoint("https://storage.googleapis.com/storage/v1")
  @auth(BearerToken)

  config {
    bucket: String
    project: String
  }

  operation upsert {
    input { run_key: String, stage: String, outcome: Json }
    output { updated: Bool, previous: Json? }
    @rest(PUT, "/b/{config.bucket}/o?name=outcomes/{run_key}/{stage}.json")
    @idempotent
    @mock_response(status: 200, body: { "updated": true, "previous": null })
  }

  operation get {
    input { run_key: String, stage: String }
    output { found: Bool, outcome: Json? }
    @rest(GET, "/b/{config.bucket}/o/outcomes/{run_key}/{stage}.json?alt=media")
    @idempotent @readonly
    @mock_response(status: 200, body: { "found": false, "outcome": null })
  }

  operation list_by_issue {
    input { issue_id: String }
    output { outcomes: List<Json> }
    @rest(GET, "/b/{config.bucket}/o?prefix=outcomes/{issue_id}/")
    @readonly
    @mock_response(status: 200, body: { "outcomes": [] })
  }
}

service PubSubSignalStore : SignalStore {
  @endpoint("https://pubsub.googleapis.com/v1")
  @auth(BearerToken)

  config {
    topic: String
    subscription: String
    project: String
  }

  operation emit {
    input { signal: Json }
    output { emitted: Bool }
    @rest(POST, "/projects/{config.project}/topics/{config.topic}:publish")
    @idempotent
    @mock_response(status: 200, body: { "emitted": true })
  }

  operation consume {
    input { signal_types: List<String>, limit: Int? }
    output { signals: List<Json> }
    @rest(POST, "/projects/{config.project}/subscriptions/{config.subscription}:pull")
    @mock_response(status: 200, body: { "signals": [] })
  }

  operation ack {
    input { idempotency_key: String }
    output { acked: Bool }
    @rest(POST, "/projects/{config.project}/subscriptions/{config.subscription}:acknowledge")
    @idempotent
    @mock_response(status: 200, body: { "acked": true })
  }
}

service GcsArtifactStore : ArtifactStore {
  @endpoint("https://storage.googleapis.com/storage/v1")
  @auth(BearerToken)

  config {
    bucket: String
    project: String
  }

  operation store {
    input { artifact_id: String, payload: Json, content_hash: String }
    output { stored: Bool, conflict: Bool }
    @rest(POST, "/upload/storage/v1/b/{config.bucket}/o?name=artifacts/{artifact_id}")
    @idempotent
    @mock_response(status: 200, body: { "stored": true, "conflict": false })
  }

  operation retrieve {
    input { artifact_id: String }
    output { found: Bool, payload: Json?, content_hash: String? }
    @rest(GET, "/b/{config.bucket}/o/artifacts/{artifact_id}?alt=media")
    @readonly
    @mock_response(status: 200, body: { "found": false, "payload": null, "content_hash": null })
  }

  operation store_marker {
    input { marker: Json }
    output { stored: Bool }
    @rest(POST, "/upload/storage/v1/b/{config.bucket}/o?name=markers/{marker.run_key}/{marker.artifact_type}")
    @idempotent
    @mock_response(status: 200, body: { "stored": true })
  }

  operation get_canonical_marker {
    input { run_key: String, artifact_type: String }
    output { found: Bool, marker: Json? }
    @rest(GET, "/b/{config.bucket}/o/markers/{run_key}/{artifact_type}?alt=media")
    @readonly
    @mock_response(status: 200, body: { "found": false, "marker": null })
  }
}
