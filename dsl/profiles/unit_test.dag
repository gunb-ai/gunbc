// profiles/unit_test.dag -- Unit test deployment profile.
//
// Binds all domain interfaces to in-memory stub implementations.
// Used for hermetic unit testing: no network, no filesystem, no secrets.
//
// Profile invariants (INV-20, INV-21):
//   - Every interface used in the pipeline is bound.
//   - Profile is compile-time only (no runtime switching).
//
// Canonical reference: domain-modeling-comprehensive.md §5.1

module profiles.unit_test

import interfaces.issue_provider { IssueProvider }
import interfaces.claim_store { ClaimStore }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }
import interfaces.signal_store { SignalStore }
import interfaces.artifact_store { ArtifactStore }

// Profile bindings (compile-time interface -> implementation mapping):
//   IssueProvider    -> StubIssueProvider
//   ClaimStore       -> InMemoryClaimStore
//   OutcomeLedger    -> InMemoryOutcomeLedger
//   AgentProvider    -> StubAgentProvider
//   SignalStore      -> InMemorySignalStore
//   ArtifactStore    -> InMemoryArtifactStore

// --- Stub implementations ------------------------------------------------
// These are minimal in-memory implementations that satisfy the interface
// contracts. They are auto-generated by the compiler for any interface
// that has @contract annotations.

service StubIssueProvider : IssueProvider {
  config {
    issues: List<Json> = []       // Pre-seeded test issues
  }

  operation discover {
    input { labels: List<String>, state: String? }
    output { issues: List<Json> }
    @hermetic
    @mock_response(status: 200, body: { "issues": [] })
  }

  operation get {
    input { id: String }
    output { issue: TrackedIssue, found: Bool }
    @hermetic
    @mock_response(status: 200, body: { "issue": {}, "found": false })
  }

  operation create {
    input { title: String, body: String, labels: List<String> }
    output { issue: TrackedIssue }
    @hermetic
    @mock_response(status: 201, body: { "issue": { "id": "stub-1", "title": "stub" } })
  }

  operation comment {
    input { id: String, body: String, marker: String? }
    output { comment_id: String, ok: Bool }
    @hermetic
    @mock_response(status: 201, body: { "comment_id": "stub-comment-1", "ok": true })
  }

  operation set_labels {
    input { id: String, labels: List<String> }
    output { ok: Bool }
    @hermetic
    @mock_response(status: 200, body: { "ok": true })
  }

  operation close {
    input { id: String }
    output { ok: Bool }
    @hermetic
    @mock_response(status: 200, body: { "ok": true })
  }

  operation list_events {
    input { id: String, since: String? }
    output { events: List<Json> }
    @hermetic
    @mock_response(status: 200, body: { "events": [] })
  }
}

service InMemoryClaimStore : ClaimStore {
  operation acquire {
    input { issue_id: String, stage: String, owner: String, lease_ttl_ms: Int }
    output { acquired: Bool, conflict: Bool, lease_generation: Int }
    @hermetic
    @mock_response(status: 200, body: { "acquired": true, "conflict": false, "lease_generation": 1 })
  }

  operation heartbeat {
    input { issue_id: String, stage: String, owner: String, generation: Int }
    output { accepted: Bool }
    @hermetic
    @mock_response(status: 200, body: { "accepted": true })
  }

  operation release {
    input { issue_id: String, stage: String, owner: String, generation: Int }
    output { released: Bool }
    @hermetic
    @mock_response(status: 200, body: { "released": true })
  }
}

service InMemoryOutcomeLedger : OutcomeLedger {
  operation upsert {
    input { run_key: String, stage: String, outcome: Json }
    output { updated: Bool, previous: Json? }
    @hermetic
    @mock_response(status: 200, body: { "updated": true, "previous": null })
  }

  operation get {
    input { run_key: String, stage: String }
    output { found: Bool, outcome: Json? }
    @hermetic
    @mock_response(status: 200, body: { "found": false, "outcome": null })
  }

  operation list_by_issue {
    input { issue_id: String }
    output { outcomes: List<Json> }
    @hermetic
    @mock_response(status: 200, body: { "outcomes": [] })
  }
}

service StubAgentProvider : AgentProvider {
  operation spawn {
    input { prompt: String, repo_path: String, branch: String, model: String?, timeout_seconds: Int?, approval_mode: String? }
    output { run_id: String, status: AgentStatus, started: Bool }
    @hermetic
    @mock_response(status: 200, body: { "run_id": "stub-run-1", "status": "completed", "started": true })
  }

  operation poll {
    input { run_id: String }
    output { status: AgentStatus, finished: Bool, exit_code: Int?, error: String? }
    @hermetic
    @mock_response(status: 200, body: { "status": "completed", "finished": true, "exit_code": 0, "error": null })
  }

  operation cancel {
    input { run_id: String, reason: String? }
    output { cancelled: Bool, final_status: AgentStatus }
    @hermetic
    @mock_response(status: 200, body: { "cancelled": true, "final_status": "cancelled" })
  }

  operation get_result {
    input { run_id: String }
    output { status: AgentStatus, exit_code: Int?, stdout: String?, stderr: String?, files_changed: List<String> }
    @hermetic
    @mock_response(status: 200, body: { "status": "completed", "exit_code": 0, "stdout": "stub output", "stderr": "", "files_changed": [] })
  }
}

service InMemorySignalStore : SignalStore {
  operation emit {
    input { signal: Signal }
    output { emitted: Bool }
    @hermetic
    @mock_response(status: 200, body: { "emitted": true })
  }

  operation consume {
    input { signal_types: List<SignalType>, limit: Int? }
    output { signals: List<Json> }
    @hermetic
    @mock_response(status: 200, body: { "signals": [] })
  }

  operation ack {
    input { idempotency_key: String }
    output { acked: Bool }
    @hermetic
    @mock_response(status: 200, body: { "acked": true })
  }
}

service InMemoryArtifactStore : ArtifactStore {
  operation store {
    input { artifact_id: String, payload: ArtifactPayload, content_hash: String }
    output { stored: Bool, conflict: Bool }
    @hermetic
    @mock_response(status: 200, body: { "stored": true, "conflict": false })
  }

  operation retrieve {
    input { artifact_id: String }
    output { found: Bool, payload: ArtifactPayload?, content_hash: String? }
    @hermetic
    @mock_response(status: 200, body: { "found": false, "payload": null, "content_hash": null })
  }

  operation store_marker {
    input { marker: Json }
    output { stored: Bool }
    @hermetic
    @mock_response(status: 200, body: { "stored": true })
  }

  operation get_canonical_marker {
    input { run_key: String, artifact_type: String }
    output { found: Bool, marker: Json? }
    @hermetic
    @mock_response(status: 200, body: { "found": false, "marker": null })
  }
}
