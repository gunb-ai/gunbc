// profiles/sdlc.dag -- SDLC deployment profiles.
//
// Binds domain interfaces to concrete implementations at compile time.
// The pipeline imports interfaces (Layer 2); profiles select which
// Layer 3 implementation fulfills each interface.
//
// Three profiles:
//   unit_test  -- All stub/in-memory, hermetic, deterministic
//   local      -- File-based ledgers, real GitHub API, single-process
//   cloud_run  -- GCS-based ledgers, real GitHub API, stateless fleet
//
// Source: domain-modeling-comprehensive.md Section 5
// Gap:    e2e-gap-analysis.md Gap C (deployment profile binding)
//         e2e-gap-analysis.md Gap D (credential wiring via profile)
//
// NOTE: The `profile { bind ... }` syntax is the target language feature
// (Gap C). Until the parser supports it, the match-based provider_for_*
// functions below serve as the compile-time binding mechanism. The
// profile declarations below are the canonical definitions that the
// parser will eventually accept.

module profiles.sdlc

import interfaces.issue_provider { IssueProvider }
import interfaces.claim_store { ClaimStore }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }
import interfaces.signal_store { SignalStore }
import interfaces.artifact_store { ArtifactStore }

import services.sdlc.providers.github_issue_provider as github_issues
import services.sdlc.providers.file_claim_store as file_claims
import services.sdlc.providers.file_outcome_ledger as file_outcomes
import services.sdlc.providers.codex_agent_provider as codex_agent
import services.sdlc.providers.stub_providers as stubs

import std.types { NonEmptyStr }

// =========================================================================
// Profile Declarations (target syntax)
// =========================================================================
//
// These are the canonical profile definitions. When the parser gains
// profile/bind support (Gap C), these become executable. Until then,
// they serve as documentation and the match-based functions below
// provide the same binding semantics.

// profile unit_test {
//   bind IssueProvider      -> stub.IssueProvider
//   bind ClaimStore         -> stub.ClaimStore
//   bind OutcomeLedger      -> stub.OutcomeLedger
//   bind AgentProvider      -> stub.AgentProvider
//   bind SignalStore        -> stub.SignalStore
//   bind ArtifactStore      -> stub.ArtifactStore
// }
//
// profile local {
//   bind IssueProvider      -> github.IssueProvider {
//       owner: env("SDLC_OWNER", "gunb-ai"),
//       repo: env("SDLC_REPO", "gunbc")
//   }
//   bind ClaimStore         -> file.ClaimStore {
//       dir: env("SDLC_LEDGER_DIR", "target/sdlc/claims")
//   }
//   bind OutcomeLedger      -> file.OutcomeLedger {
//       dir: env("SDLC_LEDGER_DIR", "target/sdlc/outcomes")
//   }
//   bind AgentProvider      -> codex.AgentProvider
//   bind SignalStore        -> stub.SignalStore    // signals not needed for local dry-run
//   bind ArtifactStore      -> stub.ArtifactStore  // inline artifacts for local
// }
//
// profile cloud_run {
//   bind IssueProvider      -> github.IssueProvider {
//       owner: "gunb-ai", repo: "gunbc",
//       credential: secret("github-token", project: "gunbai-auto")
//   }
//   bind ClaimStore         -> gcs.ClaimStore {
//       bucket: "gunbai-auto-sdlc-claims", project: "gunbai-auto"
//   }
//   bind OutcomeLedger      -> gcs.OutcomeLedger {
//       bucket: "gunbai-auto-sdlc-outcomes", project: "gunbai-auto"
//   }
//   bind AgentProvider      -> codex.AgentProvider {
//       credential: secret("codex-api-key", project: "gunbai-auto")
//   }
//   bind SignalStore        -> pubsub.SignalStore {
//       topic: "sdlc-signals", subscription: "sdlc-worker",
//       project: "gunbai-auto"
//   }
//   bind ArtifactStore      -> gcs.ArtifactStore {
//       bucket: "gunbai-auto-sdlc-artifacts", project: "gunbai-auto"
//   }
// }

// =========================================================================
// Profile Enum (runtime-selectable)
// =========================================================================

type SdlcProfile
  = UnitTest                            // All stubs, hermetic
  | Local                               // File-based, real GitHub
  | CloudRun                            // GCS-based, stateless fleet

// =========================================================================
// Provider Selection Functions (bridge until profile/bind lands)
// =========================================================================
//
// These functions implement the same binding semantics as the profile
// declarations above. The pipeline calls these to resolve interfaces
// to concrete implementations. The `--profile` CLI flag determines
// which branch executes.
//
// Step 7 (gap analysis): transport selection by environment.

fn select_issue_provider(profile: SdlcProfile, owner: String, repo: String) -> IssueProvider {
  match profile {
    UnitTest => stubs.stub.IssueProvider
    Local    => github_issues.github.IssueProvider { owner: owner, repo: repo }
    CloudRun => github_issues.github.IssueProvider { owner: owner, repo: repo }
  }
}

fn select_claim_store(profile: SdlcProfile) -> ClaimStore {
  match profile {
    UnitTest => stubs.stub.ClaimStore
    Local    => file_claims.file.ClaimStore { dir: "target/sdlc/claims" }
    CloudRun => stubs.stub.ClaimStore     // placeholder until GcsClaimStore lands
  }
}

fn select_outcome_ledger(profile: SdlcProfile) -> OutcomeLedger {
  match profile {
    UnitTest => stubs.stub.OutcomeLedger
    Local    => file_outcomes.file.OutcomeLedger { dir: "target/sdlc/outcomes" }
    CloudRun => stubs.stub.OutcomeLedger  // placeholder until GcsOutcomeLedger lands
  }
}

fn select_agent_provider(profile: SdlcProfile) -> AgentProvider {
  match profile {
    UnitTest => stubs.stub.AgentProvider
    Local    => codex_agent.codex.AgentProvider
    CloudRun => codex_agent.codex.AgentProvider
  }
}
