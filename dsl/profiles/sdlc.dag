// profiles/sdlc.dag -- SDLC deployment profiles.
//
// Binds domain interfaces to concrete implementations at compile time.
// The pipeline imports interfaces (Layer 2); profiles select which
// Layer 3 implementation fulfills each interface.
//
// Three profiles:
//   unit_test  -- All stub/in-memory, hermetic, deterministic
//   local      -- File-based ledgers, real GitHub API, single-process
//   cloud_run  -- GCS-based ledgers, real GitHub API, stateless fleet
//
// Source: domain-modeling-comprehensive.md Section 5
// Gap C: deployment profile binding      [RESOLVED - direct syntax]
// Gap D: credential wiring via profile   [RESOLVED - secret/env bindings]

module profiles.sdlc

import interfaces.issue_provider { IssueProvider }
import interfaces.claim_store { ClaimStore }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }
import interfaces.signal_store { SignalStore }
import interfaces.artifact_store { ArtifactStore }

import services.sdlc.providers.github_issue_provider as github_issues
import services.sdlc.providers.file_claim_store as file_claims
import services.sdlc.providers.file_outcome_ledger as file_outcomes
import services.sdlc.providers.codex_agent_provider as codex_agent
import services.sdlc.providers.stub_providers as stubs

// =========================================================================
// Profile: unit_test
// =========================================================================
// All stubs, hermetic, deterministic. No credentials needed.
// Used for: `gunbc run --profile unit_test`

profile unit_test {
  bind IssueProvider      -> stubs.stub.IssueProvider
  bind ClaimStore         -> stubs.stub.ClaimStore
  bind OutcomeLedger      -> stubs.stub.OutcomeLedger
  bind AgentProvider      -> stubs.stub.AgentProvider
  bind SignalStore        -> stubs.stub.SignalStore
  bind ArtifactStore      -> stubs.stub.ArtifactStore
}

// =========================================================================
// Profile: local
// =========================================================================
// File-based ledgers, real GitHub API, single-process.
// Used for: `gunbc run --profile local`

profile local {
  bind IssueProvider -> github_issues.github.IssueProvider {
    owner: env("SDLC_OWNER", "gunb-ai")
    repo: env("SDLC_REPO", "gunbc")
    credential: env("GITHUB_TOKEN")
  }

  bind ClaimStore -> file_claims.file.ClaimStore {
    dir: env("SDLC_CLAIMS_DIR", "target/sdlc/claims")
  }

  bind OutcomeLedger -> file_outcomes.file.OutcomeLedger {
    dir: env("SDLC_OUTCOMES_DIR", "target/sdlc/outcomes")
  }

  bind AgentProvider -> codex_agent.codex.AgentProvider {
    credential: env("CODEX_API_KEY")
  }

  bind SignalStore -> stubs.stub.SignalStore
  bind ArtifactStore -> stubs.stub.ArtifactStore
}

// =========================================================================
// Profile: cloud_run
// =========================================================================
// GCS-based ledgers, real GitHub API, stateless fleet.
// Used for: `gunbc run --profile cloud_run`

profile cloud_run {
  bind IssueProvider -> github_issues.github.IssueProvider {
    owner: "gunb-ai"
    repo: "gunbc"
    credential: secret("github-token", project: "gunbai-auto")
  }

  bind ClaimStore -> file_claims.file.ClaimStore {
    // TODO: swap for gcs.ClaimStore when GCS provider lands
    dir: "/tmp/sdlc/claims"
  }

  bind OutcomeLedger -> file_outcomes.file.OutcomeLedger {
    // TODO: swap for gcs.OutcomeLedger when GCS provider lands
    dir: "/tmp/sdlc/outcomes"
  }

  bind AgentProvider -> codex_agent.codex.AgentProvider {
    credential: secret("codex-api-key", project: "gunbai-auto")
  }

  bind SignalStore -> stubs.stub.SignalStore {
    // TODO: swap for pubsub.SignalStore when PubSub provider lands
    // topic: "sdlc-signals", subscription: "sdlc-worker",
    // project: "gunbai-auto"
  }

  bind ArtifactStore -> stubs.stub.ArtifactStore {
    // TODO: swap for gcs.ArtifactStore when GCS provider lands
    // bucket: "gunbai-auto-sdlc-artifacts", project: "gunbai-auto"
  }
}
