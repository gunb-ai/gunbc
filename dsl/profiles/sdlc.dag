// profiles/sdlc.dag -- temporary SDLC local binding compatibility path.
//
// This exists only to unblock local real-mode proof while the compiler-side
// binding cleanup lands on a separate branch. It is not the target model.
// Delete this module once concrete binding/link artifacts replace profiles.

module profiles.sdlc

import interfaces.issue_provider { IssueProvider }
import interfaces.claim_store { ClaimStore }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }
import interfaces.signal_store { SignalStore }
import interfaces.artifact_store { ArtifactStore }
import extdeps.sdlc.providers.github_issue_provider
import extdeps.sdlc.providers.file_claim_store
import extdeps.sdlc.providers.file_outcome_ledger
import extdeps.sdlc.providers.codex_agent_provider
import extdeps.sdlc.providers.file_signal_store
import extdeps.sdlc.providers.inline_artifact_store

profile local {
  bind IssueProvider -> extdeps.sdlc.providers.github_issue_provider.github.IssueProvider {
    owner: "gunb-ai"
    repo: "integration_testing"
    credential: env("GITHUB_TOKEN")
  }
  bind ClaimStore -> extdeps.sdlc.providers.file_claim_store.file.ClaimStore
  bind OutcomeLedger -> extdeps.sdlc.providers.file_outcome_ledger.file.OutcomeLedger
  bind AgentProvider -> extdeps.sdlc.providers.codex_agent_provider.codex.AgentProvider
  bind SignalStore -> extdeps.sdlc.providers.file_signal_store.file.SignalStore
  bind ArtifactStore -> extdeps.sdlc.providers.inline_artifact_store.file.ArtifactStore
}
