test stage_code_review_with_pr_diff {
    @tier(Scenario)
    @hermetic(true)
    @auto_mock(true)

    input execute/prepare.issue_id -> "42"
    input execute/prepare.stage -> "code-review"
    input execute/prepare.title -> "Add feature X"
    input execute/prepare.body -> "Body"
    input execute/prepare.run_key -> "test-run-001"
    input execute/prepare.owner -> "gunb-ai"
    input execute/prepare.repo -> "gunbc"
    input execute/prepare.number -> 42
    input execute/prepare.llm_provider -> "anthropic"
    input execute/prepare.llm_model -> "claude-sonnet-4-20250514"

    // Mock PR get
    mock pr/execute.response -> rest_response(200, {
        number: 42,
        title: "feat: implement issue #42",
        body: "Closes #42",
        state: "open",
        html_url: "https://github.com/gunb-ai/gunbc/pull/42",
        head: { sha: "abc123" },
        base: { ref: "main" },
        mergeable: true,
        merged: false
    })

    // Mock PR file list
    mock list_files/execute.response -> rest_response(200, [
        {
            filename: "src/main.rs",
            status: "modified",
            additions: 10,
            deletions: 2,
            patch: "@@ -1,3 +1,5 @@\n fn main() {\n+    let x = 42;\n+    println!(\"{}\", x);\n }"
        }
    ])

    // Mock LLM code review
    mock review_llm/execute.response -> rest_response(200, {
        content: [{ type: "text", text: "{\"approved\": true, \"findings\": [], \"summary\": \"LGTM\"}" }],
        model: "claude-sonnet-4-20250514",
        stop_reason: "end_turn",
        usage: { input_tokens: 200, output_tokens: 100 }
    })

    // Mock PR comment and issue comment
    mock pr_comment/execute.response -> rest_response(201, { id: 500, html_url: "https://github.com/gunb-ai/gunbc/pull/42#issuecomment-500" })
    mock comment/execute.response -> rest_response(201, { comment_id: "7", ok: true })
    mock labels/execute.response -> rest_response(200, { ok: true })

    expect result.success == true
    expect result.next_stage == "testing"
}

