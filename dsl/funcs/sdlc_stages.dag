    mock test/execute.response -> shell_response(1, "{\"success\": false, \"stdout\": \"\", \"stderr\": \"test result: FAILED. 1 failed\"}")

    // Mock cargo clippy success (runs in parallel)
    mock clippy/execute.response -> shell_response(0, "{\"success\": true, \"stdout\": \"\", \"stderr\": \"\"}")

    mock comment/execute.response -> rest_response(201, { comment_id: "9", ok: true })

    expect result.success == false
    expect result.next_stage == Testing
}

test full_stage_chain {

    // This test verifies that determine_stage correctly routes and
    // each handler returns the correct next_stage for chaining.
    // The worker would invoke execute_stage repeatedly to progress
    // through: idea -> design -> design-review -> accepted ->
    // implementing -> code-review -> testing -> done

    input execute/prepare.auth_token -> "<MOCK_GH_TOKEN>"
    input execute/prepare.api_key -> "<MOCK_API_KEY>"
    input execute/prepare.stage -> Idea
    input execute/prepare.issue_id -> "99"
    input execute/prepare.title -> "Full chain test"
    input execute/prepare.body -> "Test the full stage chain."
    input execute/prepare.run_key -> "chain-run-001"
    input execute/prepare.owner -> "gunb-ai"
    input execute/prepare.repo -> "gunbc"
    input execute/prepare.number -> 99
    input execute/prepare.llm_provider -> "anthropic"
    input execute/prepare.llm_model -> "claude-sonnet-4-20250514"

    mock design/llm/execute.response -> rest_response(200, {
        content: [{ type: "text", text: "## Design\n\nFull chain design." }],
        model: "claude-sonnet-4-20250514",
        stop_reason: "end_turn",
        usage: { input_tokens: 50, output_tokens: 100 }
    })

    mock comment/execute.response -> rest_response(201, { comment_id: "100", ok: true })
    mock labels/execute.response -> rest_response(200, { ok: true })

    expect result.success == true
}
