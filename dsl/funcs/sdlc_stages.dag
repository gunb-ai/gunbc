    mock implementation_outcome/execute.response -> rest_response(200, {
        found: true,
        outcome: {
            run_key: "sdlc::gunb-ai/gunbc#42::Implementing::v1",
            stage: "Implementing",
            status: "Success",
            payload: { pr_number: 314, branch: "sdlc/issue-42" },
            error: null,
            attempt_count: 1,
            retry_budget_remaining: 2,
            next_attempt_at: null,
            created_at: "2026-01-01T00:00:00Z",
            updated_at: "2026-01-01T00:00:00Z"
        }
    })

    // Mock PR get
    mock pr/execute.response -> rest_response(200, {
        number: 314,
        title: "feat: implement issue #42",
        body: "Closes #42",
        state: "open",
        html_url: "https://github.com/gunb-ai/gunbc/pull/314",
        head: { sha: "abc123" },
        base: { ref: "main" },
        mergeable: true,
        merged: false
    })

    // Mock PR file list
    mock list_files/execute.response -> rest_response(200, [
        {
            filename: "src/main.rs",
            status: "modified",
            additions: 10,
            deletions: 2,
            patch: "@@ -1,3 +1,5 @@\n fn main() {\n+    let x = 42;\n+    println!(\"{}\", x);\n }"
        }
    ])

    // Mock LLM code review
    mock review_llm/execute.response -> rest_response(200, {
        content: [{ type: "text", text: "{\"approved\": true, \"findings\": [], \"summary\": \"LGTM\"}" }],
        model: "claude-sonnet-4-20250514",
        stop_reason: "end_turn",
        usage: { input_tokens: 200, output_tokens: 100 }
    })

    // Mock PR comment and issue comment
    mock pr_comment/execute.response -> rest_response(201, { id: 500, html_url: "https://github.com/gunb-ai/gunbc/pull/314#issuecomment-500" })
    mock comment/execute.response -> rest_response(201, { comment_id: "7", ok: true })
    mock labels/execute.response -> rest_response(200, { ok: true })

    expect result.success == true
    expect result.next_stage == Testing
}

