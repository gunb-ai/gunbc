test stage_dispatch_idea {

    input execute/prepare.auth_token -> "<MOCK_GH_TOKEN>"
    input execute/prepare.api_key -> "<MOCK_API_KEY>"
    input execute/prepare.issue_id -> "42"
    input execute/prepare.stage -> Idea
    input execute/prepare.title -> "Add feature X"
    input execute/prepare.body -> "We need feature X."
    input execute/prepare.run_key -> "test-run-001"
    input execute/prepare.owner -> "gunb-ai"
    input execute/prepare.repo -> "gunbc"
    input execute/prepare.number -> 42
    input execute/prepare.llm_provider -> "anthropic"
    input execute/prepare.llm_model -> "claude-sonnet-4-20250514"

    // Mock LLM response for design generation
    mock design/llm/execute.response -> rest_response(200, {
        content: [{ type: "text", text: "## Design\n\nImplement feature X." }],
        model: "claude-sonnet-4-20250514",
        stop_reason: "end_turn",
        usage: { input_tokens: 100, output_tokens: 200 }
    })

    mock comment/execute.response -> rest_response(201, { comment_id: "1", ok: true })
    mock labels/execute.response -> rest_response(200, { ok: true })

    expect result.success == true
    expect result.next_stage == Design
}

test stage_dispatch_design_review {

    input execute/prepare.auth_token -> "<MOCK_GH_TOKEN>"
    input execute/prepare.api_key -> "<MOCK_API_KEY>"
    input execute/prepare.issue_id -> "42"
    input execute/prepare.stage -> DesignReview
    input execute/prepare.title -> "Add feature X"
    input execute/prepare.body -> "Design content here."
    input execute/prepare.run_key -> "test-run-001"
    input execute/prepare.owner -> "gunb-ai"
    input execute/prepare.repo -> "gunbc"
    input execute/prepare.number -> 42
    input execute/prepare.llm_provider -> "anthropic"
    input execute/prepare.llm_model -> "claude-sonnet-4-20250514"

    mock prior_design/execute.response -> rest_response(200, {
        found: true,
        outcome: {
            run_key: "sdlc::gunb-ai/gunbc#42::Idea::v1",
            stage: "Idea",
            status: "Success",
            payload: { design_content: "## Generated Design\n\nUse a worker-driven flow." },
            error: null,
            attempt_count: 1,
            retry_budget_remaining: 2,
            next_attempt_at: null,
            created_at: "2026-01-01T00:00:00Z",
            updated_at: "2026-01-01T00:00:00Z"
        }
    })

    mock comment/execute.response -> rest_response(201, { comment_id: "2", ok: true })
    mock labels/execute.response -> rest_response(200, { ok: true })

    expect result.success == true
    expect result.next_stage == Accepted
}

