    current_stage: Design, run_key: run_key, worker_id: worker_id,
    issue_id: "{issue_id}", owner: owner, repo: repo, retry_budget_remaining: 3
  )
  return {
    next_stage: "{d.next_stage}",
    awaiting_approval: d.awaiting_approval,
    marker: d.marker,
    message: d.message,
    value: { "next_stage": "{d.next_stage}", "awaiting_approval": d.awaiting_approval, "terminal": d.terminal }
  }
}

