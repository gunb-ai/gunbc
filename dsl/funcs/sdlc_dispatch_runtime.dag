// funcs/sdlc_dispatch_runtime.dag -- SDLC stage dispatch runtime adapters.
//
// This module now delegates dispatch behavior to the real stage handlers in
// funcs.sdlc_stages, instead of returning static placeholder records.
//
// The result shape remains stable for callers that still consume this module,
// but all transition decisions come from execute_stage().

module funcs.sdlc_dispatch_runtime

import funcs.sdlc_stages { execute_stage }
import interfaces.issue_provider { IssueProvider }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }
import std.state_machines { stage_to_label }
import std.types { IssueLifecycleStage }

fn dispatch_message(
  stage: IssueLifecycleStage,
  run_key: String,
  issue_id: Int,
  owner: String,
  repo: String,
  worker_id: String
) -> String {
  "Dispatched stage `{stage_to_label(stage: stage)}` for run `{run_key}` on issue `{owner}/{repo}#{issue_id}` (worker: `{worker_id}`)"
}

func dispatch_through_stage(
  stage: IssueLifecycleStage,
  run_key: String,
  worker_id: String,
  issue_id: Int,
  owner: String,
  repo: String
) -> { next_stage: String, awaiting_approval: Bool, marker: String, message: String, value: Json }
  uses issues: IssueProvider
  uses outcomes: OutcomeLedger
  uses agents: AgentProvider
{
  stage_result = execute_stage(
    issue_id: "{issue_id}",
    stage: stage,
    title: "Issue #{issue_id}",
    body: "Dispatch runtime bridge for {owner}/{repo} issue #{issue_id}",
    run_key: run_key,
    owner: owner,
    repo: repo,
    number: issue_id,
    llm_provider: "anthropic",
    llm_model: "claude-sonnet-4-20250514"
  )

  return {
    next_stage: stage_to_label(stage: stage_result.next_stage),
    awaiting_approval: stage_result.next_stage == DesignReview && !stage_result.success,
    marker: "sdlc:{stage_to_label(stage: stage)}:{run_key}",
    message: dispatch_message(
      stage: stage,
      run_key: run_key,
      issue_id: issue_id,
      owner: owner,
      repo: repo,
      worker_id: worker_id
    ),
    value: stage_result.value
  }
}

func dispatch_idea(
  run_key: String,
  worker_id: String,
  issue_id: Int,
  owner: String,
  repo: String
) -> { next_stage: String, awaiting_approval: Bool, marker: String, message: String, value: Json } {
  return dispatch_through_stage(
    stage: Idea,
    run_key: run_key,
    worker_id: worker_id,
    issue_id: issue_id,
    owner: owner,
    repo: repo
  )
}

