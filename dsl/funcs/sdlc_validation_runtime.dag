// funcs/sdlc_validation_runtime.dag -- SDLC validation gate policy.
//
// Centralizes review_gate and ci_gate policy decisions in DSL so
// worker command flow remains policy-thin in Rust.
//
// Gates:
//   review_gate  — checks code review approval (blocking findings = 0)
//   ci_gate      — checks CI test/clippy pass status
//   design_gate  — checks design review approval
//
// The worker calls these gates before advancing to the next stage.

module funcs.sdlc_validation_runtime

// ── Review Gate ──────────────────────────────────────────────────
// Evaluates whether code review findings block CI execution.
// A review passes when there are zero blocking findings.
// CI is only run if the review passes (no point running CI on
// code that has blocking review comments).

fn evaluate_review_gate(
  blocking_count: Int,
  blocking_summaries: String
) -> { review_passed: Bool, should_run_ci: Bool, ci_summary: String, review_failure: String } {
  review_passed = blocking_count == 0
  should_run_ci = review_passed
  ci_summary = if should_run_ci { "ready: no blocking review findings" } else { "skipped: {blocking_count} blocking code review finding(s)" }
  review_failure = if review_passed { "" } else { "Blocked by {blocking_count} review finding(s):\n{blocking_summaries}" }
  return {
    review_passed: review_passed,
    should_run_ci: should_run_ci,
    ci_summary: ci_summary,
    review_failure: review_failure
  }
}

// ── CI Gate ──────────────────────────────────────────────────────
// Evaluates whether CI checks (test + clippy) passed.
// Both must pass for the gate to open.

fn evaluate_ci_gate(
  test_passed: Bool,
  clippy_passed: Bool,
  test_output: String,
  clippy_output: String
) -> { ci_passed: Bool, ci_failure: String } {
  ci_passed = test_passed && clippy_passed
  test_status = if test_passed { "passed" } else { "FAILED" }
  clippy_status = if clippy_passed { "passed" } else { "FAILED" }
  ci_failure = if ci_passed {
    ""
  } else {
    if !test_passed && !clippy_passed {
      "CI gate failed: cargo test ({test_status}) and cargo clippy ({clippy_status})\n\nTest output:\n{test_output}\n\nClippy output:\n{clippy_output}"
    } else {
      if !test_passed {
        "CI gate failed: cargo test ({test_status})\n\nTest output:\n{test_output}"
      } else {
        "CI gate failed: cargo clippy ({clippy_status})\n\nClippy output:\n{clippy_output}"
      }
    }
  }
  return {
    ci_passed: ci_passed,
    ci_failure: ci_failure
  }
}

// ── Design Review Gate ───────────────────────────────────────────
// Evaluates whether a design review approves the design.
// An approved review allows the pipeline to proceed to implementation.

fn evaluate_design_gate(
  approved: Bool,
  review_summary: String
) -> { design_passed: Bool, should_implement: Bool, design_failure: String } {
  return {
    design_passed: approved,
    should_implement: approved,
    design_failure: if approved { "" } else { "Design review rejected: {review_summary}" }
  }
}

// ── Combined Validation Summary ──────────────────────────────────
// Aggregates review + CI gate results into a single pass/fail
// and determines the next stage.

fn summarize_validation_status(
  review_passed: Bool,
  ci_passed: Bool
) -> { all_passed: Bool, stage_after: String } {
  all_passed = review_passed && ci_passed
  stage_after = if all_passed { "done" } else { "testing" }
  return {
    all_passed: all_passed,
    stage_after: stage_after
  }
}

// ── Failure Diagnostic ───────────────────────────────────────────
// Formats a diagnostic message when implementation validation fails.
// Used for posting failure reports to the issue.

fn implementation_validation_failure(
  intake_key: String,
  review_passed: Bool,
  ci_passed: Bool,
  ci_summary: String,
  review_failure: String
) -> { passed: Bool, failure_message: String } {
  passed = review_passed && ci_passed
  failure_message = if passed {
    ""
  } else {
    if !review_passed {
      "## Validation Failed: Code Review\n\nImplementation `{intake_key}` blocked by code review findings.\n\n{review_failure}"
    } else {
      "## Validation Failed: CI\n\nImplementation `{intake_key}` failed CI checks.\n\nReview: passed\nCI: {ci_summary}"
    }
  }
  return {
    passed: passed,
    failure_message: failure_message
  }
}
