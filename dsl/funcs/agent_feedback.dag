// funcs/agent_feedback.dag -- Agent feedback loop.
//
// Polls a running agent task until completion or timeout, then
// transitions the issue to the next lifecycle stage based on the
// agent's result.
//
// The pattern is:
//   1. Poll agent status in a loop (with backoff)
//   2. On completion: create PR, post results, transition labels
//   3. On failure/timeout: post error, transition to error state
//
// This function is invoked after Codex.Spawn returns a run_id.
// It's the bridge between "agent dispatched" and "PR ready for review".

module funcs.agent_feedback

import services.agent.codex { Codex }
import services.github.issues { Issues }
import services.github.pull_request { PullRequest }
import services.sdlc.control_plane { ControlPlane }

// ── Helpers ─────────────────────────────────────────────────────────

fn format_agent_success_comment(run_id: String, files: Json) -> String {
  "## Agent Completed\n\nRun `{run_id}` finished successfully.\n\n---\n_Agent feedback from gunbc SDLC pipeline_"
}

fn format_agent_failure_comment(run_id: String, error: String) -> String {
  "## Agent Failed\n\nRun `{run_id}` failed.\n\nError: {error}\n\n---\n_Agent feedback from gunbc SDLC pipeline_"
}

fn format_pr_body(issue_number: Int, run_id: String) -> String {
  "Closes #{issue_number}\n\nGenerated by agent run `{run_id}`.\n\n---\n_Created by gunbc SDLC pipeline_"
}

// ── Agent result handler ────────────────────────────────────────────
// Called after confirming the agent has finished. Creates a PR from
// the agent's changes and transitions the issue.

func handle_agent_completion(
  owner: String,
  repo: String,
  issue_number: Int,
  run_id: String,
  branch_name: String,
  run_key: String
) -> { success: Bool, pr_number: Int } {
  agent_result = Codex.GetResult(
    run_id: run_id
  )

  pr = PullRequest.Create(
    owner: owner,
    repo: repo,
    title: "feat: implement issue #{issue_number}",
    body: format_pr_body(issue_number: issue_number, run_id: run_id),
    head: branch_name,
    base: "main"
  )

  comment = Issues.AddComment(
    owner: owner,
    repo: repo,
    number: issue_number,
    body: format_agent_success_comment(
      run_id: run_id,
      files: agent_result.files_changed
    )
  )

  labels = Issues.SetLabels(
    owner: owner,
    repo: repo,
    number: issue_number,
    labels: ["code-review"]
  )

  outcome = ControlPlane.UpsertStageOutcome(
    intake_key: "{owner}/{repo}",
    issue_id: "{owner}/{repo}#{issue_number}",
    stage: "implementing",
    run_key: run_key,
    outcome_status: "completed",
    retry_attempt: 0,
    payload_hash: "sha256:agent-completion"
  )

  return { success: true, pr_number: 0 }
}

// ── Agent failure handler ───────────────────────────────────────────

func handle_agent_failure(
  owner: String,
  repo: String,
  issue_number: Int,
  run_id: String,
  error_message: String,
  run_key: String
) -> { success: Bool } {
  comment = Issues.AddComment(
    owner: owner,
    repo: repo,
    number: issue_number,
    body: format_agent_failure_comment(
      run_id: run_id,
      error: error_message
    )
  )

  outcome = ControlPlane.UpsertStageOutcome(
    intake_key: "{owner}/{repo}",
    issue_id: "{owner}/{repo}#{issue_number}",
    stage: "implementing",
    run_key: run_key,
    outcome_status: "failed",
    retry_attempt: 0,
    terminal: false,
    payload_hash: "sha256:agent-failure"
  )

  return { success: false }
}

// ── Poll loop ───────────────────────────────────────────────────────
// Polls agent status until terminal. The loop body is a single
// PollStatus call; the scheduler invokes this repeatedly at
// configured intervals (e.g. every 30s via Cloud Scheduler or
// a cron trigger). Each invocation is stateless -- it checks the
// agent's current status and acts accordingly.
//
// This is a "check-and-act" pattern rather than a long-running loop,
// because the DSL compiles to DAGs that execute and return. The
// iteration is driven by the external scheduler, not an in-process
// spin loop.

func check_agent_status(
  owner: String,
  repo: String,
  issue_number: Int,
  run_id: String,
  branch_name: String,
  run_key: String
) -> { finished: Bool, status: String } {
  poll = Codex.PollStatus(
    run_id: run_id
  )

  if poll.finished {
    heartbeat = ControlPlane.HeartbeatStageClaim(
      intake_key: "{owner}/{repo}",
      issue_id: "{owner}/{repo}#{issue_number}",
      stage: "implementing",
      claim_token: run_id,
      lease_generation: 1
    )
  }

  return { finished: poll.finished, status: poll.status }
}

// ── Tests ──────────────────────────────────────────────────────────

fixture agent_env {
    mock cloud_env.config -> { provider: "github", runtime: "local-dev" }
    mock cloud_env.credential -> { token: "<MOCK_GH_TOKEN>", source_type: "static", scheme: "bearer" }
}

test agent_completion_creates_pr : agent_env {
    @tier(Scenario)
    @hermetic(true)
    @auto_mock(true)

    input completion/prepare.owner -> "gunb-ai"
    input completion/prepare.repo -> "gunbc"
    input completion/prepare.issue_number -> 42
    input completion/prepare.run_id -> "codex-run-001"
    input completion/prepare.branch_name -> "feature/issue-42"
    input completion/prepare.run_key -> "test-run-001"

    mock result/execute.response -> shell_response(0, "{\"status\":\"completed\",\"exit_code\":0,\"stdout\":\"Done.\",\"stderr\":\"\",\"files_changed\":[\"src/main.rs\"]}")

    mock pr/execute.response -> rest_response(201, {
        number: 99,
        html_url: "https://github.com/gunb-ai/gunbc/pull/99",
        id: 9876543,
        node_id: "PR_mock",
        head: { sha: "abc123" }
    })

    mock comment/execute.response -> rest_response(201, { id: 200, html_url: "https://github.com/gunb-ai/gunbc/issues/42#issuecomment-200" })
    mock labels/execute.response -> rest_response(200, [{ name: "code-review" }])
    mock outcome/execute.response -> rest_response(200, { updated: true, previous_status: null, checksum: "sha256:mock" })

    expect result is Map
}

test agent_poll_not_finished : agent_env {
    @tier(Unit)
    @hermetic(true)
    @auto_mock(true)

    input check/prepare.owner -> "gunb-ai"
    input check/prepare.repo -> "gunbc"
    input check/prepare.issue_number -> 42
    input check/prepare.run_id -> "codex-run-001"
    input check/prepare.branch_name -> "feature/issue-42"
    input check/prepare.run_key -> "test-run-001"

    mock poll/execute.response -> shell_response(0, "{\"status\":\"running\",\"finished\":false,\"exit_code\":null,\"error\":null}")

    expect result.finished == false
    expect result.status == "running"
}
