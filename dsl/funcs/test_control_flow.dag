// test_control_flow.dag -- Verifies for/if lowering with service calls.

module funcs.test_control_flow

import interfaces.issue_provider { IssueProvider }

func process_issues(owner: String, repo: String) -> { count: Int }
  uses issues: IssueProvider
{
    discovered = issues.discover(
        labels: ["sdlc:idea"],
        state: "open"
    )
    details = for issue in discovered.issues {
        issues.get(id: "{owner}/{repo}#{issue.id}")
    }
    return { count: 0 }
}
