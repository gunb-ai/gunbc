// =========================================================================
// TIER 6: END-TO-END (full pipeline integration)
// =========================================================================
//
// Tests the full flow: infra bootstrap + business logic + verification.
//
//   @test(tier: E2E, cost: L, hermetic: false)
//   @requires(GUNBC_TEST_MAX_COST >= "L")
//   @requires(env: "GCP_WIF_PROVIDER", "GCP_SECRETS_PROJECT")
