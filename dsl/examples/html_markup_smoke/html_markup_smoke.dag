// examples/html_markup_smoke.dag — in-repo consumer for std.html_markup.
//
// Builds HtmlNode trees and asserts serialize_html_node output through
// func main (executed-green receipt). Run:
//   gunbc run \
//     --source-root dsl/examples/html_markup_smoke \
//     --source-root dsl/std \
//     --entry dsl/examples/html_markup_smoke/html_markup_smoke.dag \
//     --function main

module examples.html_markup_smoke

import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_code_general_error }
import std.html_markup {
  HtmlAttr,
  HtmlNode,
  ElementNode,
  TextNode,
  serialize_html_node,
  escape_text_content,
}

data tiny: HtmlNode = ElementNode {
  tag: "p",
  attrs: [],
  children: [ TextNode { text: "ok" } ],
}

data with_attr: HtmlNode = ElementNode {
  tag: "a",
  attrs: [ HtmlAttr { name: "href", value: "/tree/dsl" } ],
  children: [ TextNode { text: "dsl" } ],
}

data href_amp: HtmlNode = ElementNode {
  tag: "a",
  attrs: [ HtmlAttr { name: "href", value: "/x?a=1&b=2" } ],
  children: [ TextNode { text: "link" } ],
}

// REQ-A: url-within-attribute composition — hostile href must not break out of
// the double-quoted attr (quote percent-encoded, not left literal).
data href_hostile: HtmlNode = ElementNode {
  tag: "a",
  attrs: [ HtmlAttr { name: "href", value: "x\"&<y onmouseover=z" } ],
  children: [],
}

data tiny_html: String = serialize_html_node(node: tiny)
data attr_html: String = serialize_html_node(node: with_attr)
data href_amp_html: String = serialize_html_node(node: href_amp)
data href_hostile_html: String = serialize_html_node(node: href_hostile)
data escaped: String = escape_text_content(s: "<b>")

func main() -> ProcessExit {
  if tiny_html == "<p>ok</p>"
    && attr_html == "<a href=\"/tree/dsl\">dsl</a>"
    && href_amp_html == "<a href=\"/x?a=1&amp;b=2\">link</a>"
    && href_hostile_html == "<a href=\"x%22&amp;%3Cy%20onmouseover=z\"></a>"
    && escaped == "&lt;b&gt;" {
    ExitSuccess
  } else {
    ExitFailure { code: exit_code_general_error, reason: "html_markup_smoke mismatch" }
  }
}
