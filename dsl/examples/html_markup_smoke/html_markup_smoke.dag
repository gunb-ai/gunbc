// examples/html_markup_smoke.dag — in-repo consumer for std.html_markup.
//
// Builds HtmlNode trees and asserts try_serialize_html_node output through
// func main (executed-green receipt). Run:
//   gunbc run \
//     --source-root dsl/examples/html_markup_smoke \
//     --source-root dsl/std \
//     --entry dsl/examples/html_markup_smoke/html_markup_smoke.dag \
//     --function main

module examples.html_markup_smoke

import std.process { ProcessExit, ExitSuccess, ExitFailure, exit_code_general_error }
import std.html_markup {
  HtmlAttr,
  HtmlNode,
  ElementNode,
  TextNode,
  Serialized,
  Rejected,
  try_serialize_html_node,
  escape_text_content,
}

data tiny: HtmlNode = ElementNode {
  tag: "p",
  attrs: [],
  children: [ TextNode { text: "ok" } ],
}

data with_attr: HtmlNode = ElementNode {
  tag: "a",
  attrs: [ HtmlAttr { name: "href", value: "/tree/dsl" } ],
  children: [ TextNode { text: "dsl" } ],
}

data href_amp: HtmlNode = ElementNode {
  tag: "a",
  attrs: [ HtmlAttr { name: "href", value: "/x?a=1&b=2" } ],
  children: [ TextNode { text: "link" } ],
}

// REQ-A: url-within-attribute composition — hostile href must not break out of
// the double-quoted attr (quote percent-encoded, not left literal).
data href_hostile: HtmlNode = ElementNode {
  tag: "a",
  attrs: [ HtmlAttr { name: "href", value: "x\"&<y onmouseover=z" } ],
  children: [],
}

// XSS: dangerous URL schemes must fail-closed before serialization.
data href_javascript: HtmlNode = ElementNode {
  tag: "a",
  attrs: [ HtmlAttr { name: "href", value: "javascript:alert(1)" } ],
  children: [ TextNode { text: "click" } ],
}

fn serialize_ok(node: HtmlNode, expected: String) -> Bool {
  match try_serialize_html_node(node: node) {
    Serialized { html: h } => h == expected
    Rejected { reason: _ } => false
  }
}

fn serialize_rejects(node: HtmlNode) -> Bool {
  match try_serialize_html_node(node: node) {
    Rejected { reason: _ } => true
    Serialized { html: _ } => false
  }
}

func main() -> ProcessExit {
  if serialize_ok(node: tiny, expected: "<p>ok</p>")
    && serialize_ok(node: with_attr, expected: "<a href=\"/tree/dsl\">dsl</a>")
    && serialize_ok(node: href_amp, expected: "<a href=\"/x?a=1&amp;b=2\">link</a>")
    && serialize_ok(
      node: href_hostile,
      expected: "<a href=\"x%22&amp;%3Cy%20onmouseover=z\"></a>"
    )
    && serialize_rejects(node: href_javascript)
    && escape_text_content(s: "<b>") == "&lt;b&gt;" {
    ExitSuccess
  } else {
    ExitFailure { code: exit_code_general_error, reason: "html_markup_smoke mismatch" }
  }
}
