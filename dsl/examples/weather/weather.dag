// Hero demo for the public daglang launch: types, enums, pure functions,
// pattern matching, and list pipelines — compiles to Rust with zero hand glue.
//
// Gate (from repo root, after `cargo build --release -p v1-compiler --bin gunbc`):
//   ./target/release/gunbc compile \
//     --source-root dsl/examples/weather \
//     --source-root dsl/std \
//     --output-dir /tmp/weather-out \
//     --target rust \
//   && cargo check --manifest-path /tmp/weather-out/Cargo.toml

module examples.weather

// -- Domain types --

type Temperature {
  celsius: Float
}

type Condition
  = Sunny
  | Cloudy
  | Rainy { mm_per_hour: Float }
  | Snowy { cm_per_hour: Float }

type Forecast {
  location: String
  high: Temperature
  low: Temperature
  condition: Condition
}

// -- Pure functions --

fn to_fahrenheit(temp: Temperature) -> Float {
  temp.celsius * 1.8 + 32.0
}

fn is_freezing(temp: Temperature) -> Bool {
  temp.celsius <= 0.0
}

fn describe_condition(cond: Condition) -> String {
  match cond {
    Sunny => "clear skies"
    Cloudy => "overcast"
    Rainy { mm_per_hour: rate } =>
      if rate > 10.0 { "heavy rain" }
      else { "light rain" }
    Snowy { cm_per_hour: _ } => "snowfall"
  }
}

fn daily_summary(forecast: Forecast) -> String {
  let high_f = to_fahrenheit(temp: forecast.high)
  let desc = describe_condition(cond: forecast.condition)
  concat(forecast.location, ": ", desc, ", high ", to_string(value: high_f), "°F")
}

fn freezing_locations(forecasts: List<Forecast>) -> List<String> {
  forecasts |> filter(f => is_freezing(temp: f.low)) |> map(f => f.location)
}
