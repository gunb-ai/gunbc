module examples.js_site_emit

import examples.js_site {
  JsSitePage,
  JsSitePageId,
  Home,
  About,
  Browse,
  js_site_pages,
}
import std.markup_jsx_boundary {
  markup_jsx_vocabulary_boundary,
  markup_jsx_static_only_honesty,
  markup_jsx_interactivity_exhaustion,
  MarkupRealizationLayer,
  MarkupTreeLayer,
  HtmlBracketLayer,
  JsxEnvelopeLayer,
  layer_authority,
}
import extdeps.languages.html {
  try_serialize_html_source,
  HtmlEmitResult,
  EmitOk,
  EmitRejected,
}
import extdeps.languages.react_jsx {
  try_serialize_jsx_component,
  JsxEmitResult,
  JsxOk,
  JsxRejected,
}
import extdeps.filesystem.filesystem_io { Filesystem }
import std.process { ProcessExit, ExitSuccess, exit_failure }

fn js_site_generated_dir() -> String {
  "dsl/examples/js_site/generated"
}

fn js_site_page_basename(id: JsSitePageId) -> String {
  match id {
    Home => "home"
    About => "about"
    Browse => "browse"
  }
}

fn js_site_html_artifact_path(id: JsSitePageId) -> String {
  join(
    [js_site_generated_dir(), "/", js_site_page_basename(id: id), ".html"],
    ""
  )
}

fn js_site_tsx_artifact_path(id: JsSitePageId) -> String {
  join(
    [js_site_generated_dir(), "/", js_site_page_basename(id: id), ".tsx"],
    ""
  )
}

fn js_site_emit_html(page: JsSitePage) -> HtmlEmitResult {
  try_serialize_html_source(node: page.node)
}

fn js_site_emit_tsx(page: JsSitePage) -> JsxEmitResult {
  try_serialize_jsx_component(fn_name: page.tsx_fn_name, node: page.node)
}

fn js_site_page_html(page: JsSitePage) -> String {
  match js_site_emit_html(page: page) {
    EmitOk { html: h } => h
    EmitRejected { reason: _ } => ""
  }
}

fn js_site_page_tsx(page: JsSitePage) -> String {
  match js_site_emit_tsx(page: page) {
    JsxOk { tsx: s } => s
    JsxRejected { reason: _ } => ""
  }
}

fn js_site_boundary_names_three_layers() -> Bool {
  layer_authority(layer: MarkupTreeLayer) == "std.markup"
    && layer_authority(layer: HtmlBracketLayer) == "extdeps.languages.html"
    && layer_authority(layer: JsxEnvelopeLayer) == "extdeps.languages.react_jsx"
    && markup_jsx_vocabulary_boundary != ""
    && markup_jsx_static_only_honesty != ""
    && markup_jsx_interactivity_exhaustion != ""
}

fn js_site_write_artifact(path: String, content: String) -> Bool {
  Filesystem.Write(path: path, content: content).success
}

fn js_site_write_page_artifacts(page: JsSitePage) -> Bool {
  js_site_write_artifact(path: js_site_html_artifact_path(id: page.id), content: js_site_page_html(page: page))
    && js_site_write_artifact(path: js_site_tsx_artifact_path(id: page.id), content: js_site_page_tsx(page: page))
}

fn js_site_write_all_artifacts() -> Bool {
  fold(
    xs: js_site_pages(),
    init: true,
    f: (acc, page) => if acc { js_site_write_page_artifacts(page: page) } else { false }
  )
}

func main_wet() -> ProcessExit {
  if js_site_write_all_artifacts() {
    ExitSuccess
  } else {
    exit_failure(reason: "js_site_emit main_wet: artifact write failed")
  }
}
