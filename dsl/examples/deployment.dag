// examples/deployment.dag -- Infra resources as first-class resources.
//
// Shows the full holistic binding:
//   1. Infra resources (infra/gcp.dag) are `resource` declarations
//   2. Business logic `uses` them like Filesystem or Network
//   3. The compiler generates integration tests automatically
//   4. Interfaces bind to infra-backed resources
//   5. Environment configs select which infra is provisioned

module examples.deployment

import infra.gcp { GcsBucket, CloudRunService, ManagedSecret, GcpServiceAccount, WifProvider }
import infra.spec { dev_config, ci_config }
import tools.gist { gist_snapshot }
import examples.abstract_services { Storage, LLM }


// =========================================================================
// 1. BUSINESS LOGIC USES INFRA RESOURCES DIRECTLY
// =========================================================================

func store_gist_artifact(content: String, key: String) -> { ok: Bool }
  uses bucket: GcsBucket(name: "gunbc-gist-artifacts", project: "gunbai-auto")
{
  result = bucket.write(key: key, content: content |> to_bytes())
  return { ok: result.ok }
}

// Compiler expands to:
//   [acquire: check_bucket -> create_bucket -> resolve_bucket]
//   [business: bucket.write(key, content)]
// Bucket handle flows from acquire -> write via resource edges.


// =========================================================================
// 2. COMPOSING MULTIPLE INFRA RESOURCES
// =========================================================================

func gist_with_storage(base_ref: String?) -> { url: String, stored: Bool }
  uses bucket: GcsBucket(name: "gunbc-gist-artifacts", project: "gunbai-auto")
  uses secret: ManagedSecret(project: "gunbai-secrets", secret_id: "github-token", prefix: "dev-")
{
  result = gist_snapshot(base_ref: base_ref)
  stored = bucket.write(
    key: "snapshots/{result.url |> hash()}.md",
    content: result.url |> to_bytes()
  )
  return { url: result.url, stored: stored.ok }
}


// =========================================================================
// 3. INTERFACES BOUND TO INFRA RESOURCES
// =========================================================================

// Storage interface backed by a GcsBucket resource.
service gcs.BucketStorage : Storage {
  backed_by: GcsBucket

  operation Get { delegate: bucket.read }
  operation Put { delegate: bucket.write }
  operation Delete { delegate: bucket.delete }
  operation List { delegate: bucket.list }
}

// Business logic uses the INTERFACE:
func review_and_store(diff: String) -> { review: String, stored: Bool }
  uses store: Storage
  uses llm: LLM
{
  review = llm.Complete(messages: [
    { role: "system", content: "You are a code reviewer." },
    { role: "user", content: "Review:\n{diff}" }
  ])
  stored = store.Put(key: "reviews/{hash(diff)}.md", value: review.content |> to_bytes())
  return { review: review.content, stored: stored.ok }
}

// Binding at environment level:
//   dev:  Storage => gcs.BucketStorage(bucket: GcsBucket(name: "dev-artifacts", ...))
//   test: Storage => local.FileStore(base_dir: "/tmp/test-artifacts")
//   CI:   Storage => gcs.BucketStorage(bucket: GcsBucket(name: "ci-artifacts", ...))


// =========================================================================
// 4. FULL INFRA BOOTSTRAP
// =========================================================================

func infra_bootstrap() -> { ready: Bool }
  uses wif: WifProvider(
    project_number: "314501921854",
    pool_id: "github-pool",
    provider_id: "github",
    issuer_uri: "https://token.actions.githubusercontent.com",
    attribute_mapping: {
      "google.subject": "assertion.sub",
      "attribute.repository": "assertion.repository"
    },
    attribute_condition: "assertion.repository_owner == 'org-name'"
  )
  uses deployer_sa: GcpServiceAccount(
    name: "gunbai-deployer",
    project: "gunbai-auto",
    display_name: "GitHub Actions Deployer",
    roles: ["roles/iam.serviceAccountAdmin", "roles/secretmanager.admin"]
  )
  uses dev_secrets_sa: GcpServiceAccount(
    name: "gunbai-dev-secrets",
    project: "gunbai-auto",
    display_name: "Dev Secrets Accessor",
    roles: []
  )
  uses github_token: ManagedSecret(
    project: "gunbai-secrets",
    secret_id: "github-token",
    prefix: "dev-"
  )
  uses gist_bucket: GcsBucket(name: "gunbc-gist-artifacts", project: "gunbai-auto")
{
  // All resources acquired by the time we get here.
  // Compiler orders: WIF -> SAs -> Secrets -> Buckets
  return { ready: true }
}


// =========================================================================
// 5. INTEGRATION TEST GENERATION
// =========================================================================
//
// For `store_gist_artifact` using GcsBucket, compiler generates:
//
// Bucket A (DryRun, cost XS):
//   DAG completes with @mock_response from GcsBucket.acquire
//
// Bucket B (Node Contracts, cost S):
//   check_bucket: mock 404 -> { exists: false }
//   create_bucket: mock 200 -> { name: "gunbc-gist-artifacts" }
//   bucket.write: mock 200 -> { ok: true }
//
// Bucket C (Scenarios, cost S):
//   Scenario: bucket exists -> create SKIPPED, write proceeds
//   Scenario: bucket missing -> create runs, then write
//   Scenario: create fails (503) -> func fails, write never runs
//
// Bucket D (Resource Hygiene, cost S):
//   Resource acquired before first use
//   Handle threaded to all consumers
//   No dangling references
//
// Integration (Live GCP, cost M):
//   Gated: GUNBC_TEST_MAX_COST >= M, GCP_WIF_PROVIDER set
//   Creates test-prefixed bucket, writes, reads back, cleans up

func store_and_verify(key: String, content: String) -> { stored: Bool, verified: Bool }
  uses bucket: GcsBucket(name: "gunbc-test-artifacts", project: "gunbai-auto")
  @test_hermetic(
    probes: { key: "test/hello.txt", content: "hello world" },
    observers: { stored: true, verified: true }
  )
  @test_integration(
    cost: M,
    requires_secrets: ["GCP_WIF_PROVIDER"],
    config_override: { bucket.name: "test-artifacts-{uuid()}" },
    cleanup: bucket.delete_all(prefix: "test/")
  )
{
  write_result = bucket.write(key: key, content: content |> to_bytes())
  read_result = bucket.read(key: key) [after write_result]
  verified = read_result.found && read_result.content == content |> to_bytes()
  return { stored: write_result.ok, verified: verified }
}


// =========================================================================
// 6. ENVIRONMENT-DRIVEN CONFIG
// =========================================================================

fn dev_bucket_config() -> GcsBucket.Config {
  { name: "gunbc-dev-artifacts", project: "gunbai-auto" }
}

fn ci_bucket_config() -> GcsBucket.Config {
  { name: "gunbc-ci-artifacts", project: "gunbai-auto" }
}

fn prod_bucket_config() -> GcsBucket.Config {
  { name: "gunbc-prod-artifacts", project: "gunbai-prod", storage_class: "NEARLINE" }
}

// Func written once; config selected at build time:
//   gunbc build --env=dev   -> uses dev_bucket_config()
//   gunbc build --env=prod  -> uses prod_bucket_config()


// =========================================================================
// 7. CROSS-INFRA COMPOSITION
// =========================================================================

func deploy_gist_api() -> { url: Url }
  uses service: CloudRunService(
    name: "gist-api",
    project: "gunbai-auto",
    image: "gcr.io/gunbai-auto/gist-api:latest",
    memory: "512Mi",
    service_account: "gunbai-deployer"
  )
  uses bucket: GcsBucket(name: "gunbc-gist-artifacts", project: "gunbai-auto")
{
  // Both provisioned. Cloud Run deployed, GCS bucket exists.
  url = service.get_url()
  return { url: url.url }
}
rio: bucket already exists (check returns 200)
//     -> create is SKIPPED, write proceeds
//   - Scenario: bucket doesn't exist (check returns 404)
//     -> create runs, then write
//   - Scenario: create fails (503)
//     -> entire func fails, bucket.write never runs
//
// --- Bucket D: Resource Hygiene (hermetic, cost: S) ---
//   - Resource acquired before first use
//   - Resource handle threaded to all consuming nodes
//   - No dangling resource references
//
// --- Integration: Live Infra (real GCP, cost: M) ---
//   Gated by:
//     GUNBC_TEST_MAX_COST >= M
//     GCP_WIF_PROVIDER is set
//     GCP_SECRETS_PROJECT is set
//
//   Test runs the REAL acquire DAG against GCP APIs:
//   - Creates a test-prefixed bucket (test-gunbc-gist-artifacts-{uuid})
//   - Writes a test object
//   - Reads it back and verifies
//   - Cleans up (deletes test bucket)
//
//   MockSpec for live tests uses `live_expected_output`:
//     bucket.write -> { ok: true }
//     bucket.read  -> { found: true, content: NonEmpty }

// Here's what the generated test annotations look like on a func:

func store_and_verify(key: String, content: String) -> { stored: Bool, verified: Bool }
  uses bucket: GcsBucket(
    name: "gunbc-test-artifacts",
    project: "gunbai-auto"
  )

  // Test annotations -- compiler uses these + @mock_response from
  // the resource declaration to generate all test tiers.
  @test_hermetic(
    // Probes: entry point values
    probes: { key: "test/hello.txt", content: "hello world" },
    // Observers: expected outputs at terminal nodes
    observers: { stored: true, verified: true }
  )
  @test_integration(
    cost: M,
    requires_secrets: ["GCP_WIF_PROVIDER"],
    // For live tests, use a unique bucket name to avoid conflicts
    config_override: { bucket.name: "test-artifacts-{uuid()}" },
    // Cleanup: delete the test bucket after the test
    cleanup: bucket.delete_all(prefix: "test/")
  )
{
  write_result = bucket.write(key: key, content: content |> to_bytes())

  // Verify by reading back
  read_result = bucket.read(key: key) [after write_result]
  verified = read_result.found && read_result.content == content |> to_bytes()

  return { stored: write_result.ok, verified: verified }
}


// =========================================================================
// 6. ENVIRONMENT-DRIVEN RESOURCE SELECTION
// =========================================================================
//
// Different environments use different resource configurations.
// This is NOT a separate "deploy" block -- it's just different
// config values passed to the same resource declarations.

fn dev_bucket() -> GcsBucket.Config {
  { name: "gunbc-dev-artifacts", project: "gunbai-auto" }
}

fn ci_bucket() -> GcsBucket.Config {
  { name: "gunbc-ci-artifacts", project: "gunbai-auto" }
}

fn prod_bucket() -> GcsBucket.Config {
  { name: "gunbc-prod-artifacts", project: "gunbai-prod", storage_class: "NEARLINE" }
}

// The func is written once; the config is selected at build time:
//   gunbc build --env=dev   -> uses dev_bucket()
//   gunbc build --env=ci    -> uses ci_bucket()
//   gunbc build --env=prod  -> uses prod_bucket()
//
// The compiler resolves the config at compile time and generates
// the appropriate acquire DAG for the selected environment.


// =========================================================================
// 7. CROSS-INFRA COMPOSITION
// =========================================================================
//
// A Cloud Run service that uses a GCS bucket for storage.
// Both are infra resources, composed via `uses`.

func deploy_gist_api() -> { url: Url }
  uses service: CloudRunService(
    name: "gist-api",
    project: "gunbai-auto",
    region: "us-central1",
    image: "gcr.io/gunbai-auto/gist-api:latest",
    memory: "512Mi",
    service_account: "gunbai-deployer"
  )
  uses bucket: GcsBucket(
    name: "gunbc-gist-artifacts",
    project: "gunbai-auto"
  )
{
  // Both resources are acquired (provisioned if needed).
  // The Cloud Run service is deployed with the latest image.
  // The GCS bucket exists for the service to use.
  url = service.get_url()
  return { url: url.url }
}

// The compiler generates:
//   1. Acquire GcsBucket (check -> create if needed)
//   2. Acquire CloudRunService (check -> create/update if needed)
//   3. Wire: service's env can reference bucket.name
//   4. Integration tests: deploy test service, verify it responds
