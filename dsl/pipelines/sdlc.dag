// pipelines/sdlc.dag -- Issue-centric SDLC pipeline.
//
// Core idea: a GitHub issue IS a pipeline instance. Its labels encode
// lifecycle stage, its comments carry artifacts (designs, reviews,
// reports), and its state transitions drive pipeline progression.
//
//   sdlc:idea -> sdlc:design -> sdlc:design-review -> sdlc:accepted
//                                                        |
//   sdlc:done <- sdlc:testing <- sdlc:code-review <- sdlc:implementing
//
// Each stage transition:
//   1. Reads current issue state (via IssueProvider)
//   2. Acquires a stage claim (via ClaimStore)
//   3. Executes stage logic (LLM call, agent spawn, CI, etc.)
//   4. Posts artifact as issue comment (via IssueProvider)
//   5. Updates labels to next stage (via IssueProvider)
//   6. Records outcome (via OutcomeLedger)
//
// Unlike the CI pipeline (triggered by code push), this pipeline is
// triggered by issue events (creation, label changes). It can run:
//   1. End-to-end: idea -> done (full autonomy)
//   2. Stage-by-stage: triggered per label transition (human-in-loop)
//   3. Ad-hoc: any single stage invoked on an existing issue
//
// DSL-native implementation:
//   - Uses domain interfaces (Layer 2), not concrete services
//   - Profile binding selects GitHub vs stub vs GCS implementations
//   - Per-stage handlers in funcs/sdlc_stages.dag
//   - Worker dispatch in funcs/sdlc_worker.dag
//
// Gap analysis coverage:
//   Gap A: IssueProvider interface instead of concrete GitHub service
//   Gap B: ClaimStore + OutcomeLedger interfaces for domain state
//   Gap C: Profile declarations (bridge via match-based selection)
//   Gap D: Credential wiring via profile config
//   Gap F: SubDag execution via stage composition
//   Gap G: Worker routes by stage (execute_stage dispatcher)
//   Gap H: All stages have real handlers (PR diff review, cargo testing)
//   Gap I: AgentProvider interface with branch management
//   Gap J: Pipeline parameters via param declarations

module pipelines.sdlc

// --- Interface imports (Layer 2) ------------------------------------------
// The pipeline works against abstract interfaces. Profile binding
// selects concrete implementations at compile time.

import interfaces.issue_provider { IssueProvider }
import interfaces.claim_store { ClaimStore }
import interfaces.outcome_ledger { OutcomeLedger }
import interfaces.agent_provider { AgentProvider }

// --- Tool imports (domain logic) ------------------------------------------
import shared.dag_util { aggregate_results, format_report, stage_result }
import funcs.sdlc_stages { determine_stage, execute_stage }

// --- Type imports ----------------------------------------------------------
import std.types {
    IssueLifecycleStage, StageResult, Summary, StageOutcome,
    OutcomeStatus, NonEmptyStr
}

// ── Pipeline parameters ─────────────────────────────────────────────
// These are bound at invocation time (from webhook payload, CLI args,
// or a polling loop). Gap J resolution: parameterized instead of hardcoded.

param repo_owner: String               // e.g. "gunb-ai"
param repo_name: String                // e.g. "gunbc"
param issue_number: Int                // the issue to process
param llm_provider: String = "anthropic"
param llm_model: String = "claude-sonnet-4-20250514"
param worker_id: String = "pipeline-1" // claim identity

// ── Pipeline ────────────────────────────────────────────────────────
// The pipeline definition uses interfaces. Each stage handler
// delegates to funcs/sdlc_stages.dag which also uses interfaces.
// The concrete implementation is selected by the profile.

pipeline sdlc
  uses issues: IssueProvider
  uses claims: ClaimStore
  uses outcomes: OutcomeLedger
  uses agents: AgentProvider
{

  // Stage 1: Fetch current issue state
  stage fetch {
    issue_result = issues.get(
      id: "{issue_number}"
    )
    issue = issue_result.issue
  }

  // Stage 2: Determine current lifecycle stage and acquire claim
  stage claim [after fetch] {
    current_stage = determine_stage(labels: issue.labels)
    issue_id = "{repo_owner}/{repo_name}#{issue_number}"
    run_key = "sdlc::{issue_id}::{current_stage}::v1"

    acquired = claims.acquire(
      issue_id: issue_id,
      stage: current_stage,
      owner: worker_id,
      lease_ttl_ms: 30000
    )
  }

  // Stage 3: Check for prior outcome (replay-skip)
  stage replay_check [after claim, when acquired.acquired] {
    prior = outcomes.get(
      run_key: run_key,
      stage: current_stage
    )
  }

  // Stage 4: Execute stage-specific logic
  stage execute [after replay_check, when !prior.found] {
    stage_outcome = execute_stage(
      issue_id: issue_id,
      stage: current_stage,
      title: issue.title,
      body: issue.body,
      run_key: run_key,
      owner: repo_owner,
      repo: repo_name,
      number: issue_number,
      llm_provider: llm_provider,
      llm_model: llm_model
    )
  }

  // Stage 5: Record outcome in ledger
  stage record [after execute, when stage_outcome != null] {
    recorded = outcomes.upsert(
      run_key: run_key,
      stage: current_stage,
      outcome: {
        run_key: run_key,
        stage: current_stage,
        status: match stage_outcome.success {
          true  => Success
          false => Failed
        },
        payload: stage_outcome.payload,
        error: None,
        attempt_count: 1,
        retry_budget_remaining: 2,
        next_attempt_at: None,
        created_at: "",
        updated_at: ""
      }
    )
  }

  // Stage 6: Release claim
  stage release [after record] {
    released = claims.release(
      issue_id: issue_id,
      stage: current_stage,
      owner: worker_id,
      generation: acquired.lease_generation
    )
  }

  // Stage 7: Report
  stage report [after release] {
    stages = [
      stage_result(
        name: "{current_stage}->{stage_outcome.next_stage}",
        success: stage_outcome.success,
        stderr: ""
      )
    ]
    summary = aggregate_results(stages: stages)
    report_text = format_report(summary: summary, stages: stages)

    // Post report as issue comment
    report_comment = issues.comment(
      id: issue_id,
      body: report_text,
      marker: "sdlc:report:{run_key}"
    )
  }
}

// ── Tests ──────────────────────────────────────────────────────────
// The SDLC pipeline composes interfaces + design + review + CI.
// Tests use auto_mock with stage-by-stage boundary mocks.

test sdlc_idea_to_design {
    @tier(Scenario)
    @hermetic(true)
    @auto_mock(true)

    // Pipeline parameters
    input repo_owner -> "gunb-ai"
    input repo_name -> "gunbc"
    input issue_number -> 42

    // Mock: issue fetch returns an issue with "sdlc:idea" label
    mock fetch/execute.response -> rest_response(200, {
        issue: {
            id: "42",
            title: "Add GitHub Issues integration",
            body: "We need the SDLC pipeline to create and track issues.",
            stage: "Idea",
            labels: ["sdlc:idea"],
            url: "https://github.com/gunb-ai/gunbc/issues/42",
            author: "test-user",
            created_at: "2026-01-01T00:00:00Z",
            updated_at: "2026-01-01T00:00:00Z"
        },
        found: true
    })

    // Mock: claim acquisition succeeds
    mock claim/execute.response -> rest_response(200, {
        acquired: true,
        conflict: false,
        lease_generation: 1
    })

    // Mock: no prior outcome
    mock replay_check/execute.response -> rest_response(200, {
        found: false,
        outcome: null
    })

    // Mock: LLM generates a design
    mock design/llm/execute.response -> rest_response(200, {
        content: [{ type: "text", text: "## Problem\n\nNeed issue tracking.\n\n## Approach\n\nGitHub Issues API." }],
        model: "claude-sonnet-4-20250514",
        stop_reason: "end_turn",
        usage: { input_tokens: 100, output_tokens: 200 }
    })

    // Mock: comment and label updates succeed
    mock comment/execute.response -> rest_response(201, { comment_id: "100", ok: true })
    mock set_labels/execute.response -> rest_response(200, { ok: true })

    // Mock: outcome upsert
    mock record/execute.response -> rest_response(200, { updated: true, previous: null })

    // Mock: claim release
    mock release/execute.response -> rest_response(200, { released: true })

    expect result is Map
}

test sdlc_replay_skip {
    @tier(Scenario)
    @hermetic(true)
    @auto_mock(true)

    input repo_owner -> "gunb-ai"
    input repo_name -> "gunbc"
    input issue_number -> 42

    mock fetch/execute.response -> rest_response(200, {
        issue: {
            id: "42",
            title: "Already processed",
            body: "This stage was already done.",
            stage: "Design",
            labels: ["sdlc:design"],
            url: "https://github.com/gunb-ai/gunbc/issues/42",
            author: "test-user"
        },
        found: true
    })

    mock claim/execute.response -> rest_response(200, {
        acquired: true,
        conflict: false,
        lease_generation: 1
    })

    // Prior outcome exists -> replay-skip
    mock replay_check/execute.response -> rest_response(200, {
        found: true,
        outcome: {
            run_key: "sdlc::gunb-ai/gunbc#42::design::v1",
            stage: "design",
            status: "Success"
        }
    })

    expect result is Map
}
