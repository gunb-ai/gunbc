// pipelines/sdlc.dag -- Issue-centric SDLC orchestration.
//
// Canonical SDLC pipeline module (CG1). This pipeline models the
// core design + design-review loop on a tracked GitHub issue.

module pipelines.sdlc

import services.github.issues { Issues }
import services.sdlc.control_plane { ControlPlane }
import tools.design { generate_design, review_design }
import shared.dag_util { aggregate_results, format_report, stage_result }

fn default_repo_owner() -> String {
  "gunb-ai"
}

fn default_repo_name() -> String {
  "gunbc"
}

fn default_issue_number() -> Int {
  1
}

fn has_label(labels: Json, name: String) -> Bool {
  labels |> filter(l => l.name == name) |> count() > 0
}

fn format_design_comment(design: String, summary: String) -> String {
  "## Generated Design\n\n> {summary}\n\n---\n\n{design}\n\n---\n_Generated by gunbc SDLC pipeline_"
}

fn format_review_comment(findings: Json, approved: Bool, summary: String) -> String {
  let status = match approved {
    true => "APPROVED"
    false => "CHANGES REQUESTED"
  }
  let findings_text = findings
    |> map(f => "- **{f.check_id}**: {f.observation}")
    |> join("\n")
  "## Design Review: {status}\n\n{summary}\n\n### Findings\n\n{findings_text}\n\n---\n_Reviewed by gunbc SDLC pipeline_"
}

pipeline sdlc {
  stage fetch {
    issue = Issues.Get(
      owner: default_repo_owner(),
      repo: default_repo_name(),
      number: default_issue_number()
    )
  }

  stage claim_design [after fetch] {
    design_claim = ControlPlane.AcquireStageClaim(
      intake_key: "default-intake",
      issue_id: "{default_repo_owner()}/{default_repo_name()}#{default_issue_number()}",
      stage: "design",
      run_key: "sdlc::default-run",
      claimant: "pipelines.sdlc"
    )
  }

  stage design [after claim_design, when design_claim.acquired && has_label(issue.labels, "idea")] {
    design_output = generate_design(
      idea: issue.body,
      context: issue.title,
      provider: "anthropic",
      model: "claude-sonnet-4-20250514"
    )

    design_comment = Issues.AddComment(
      owner: default_repo_owner(),
      repo: default_repo_name(),
      number: default_issue_number(),
      body: format_design_comment(design: design_output.content, summary: design_output.summary)
    )

    design_labels = Issues.SetLabels(
      owner: default_repo_owner(),
      repo: default_repo_name(),
      number: default_issue_number(),
      labels: ["design"]
    )
  }

  stage design_review [after design] {
    review_output = review_design(
      design: design_output.content,
      provider: "anthropic",
      model: "claude-sonnet-4-20250514"
    )

    review_comment = Issues.AddComment(
      owner: default_repo_owner(),
      repo: default_repo_name(),
      number: default_issue_number(),
      body: format_review_comment(
        findings: review_output.findings,
        approved: review_output.approved,
        summary: review_output.summary
      )
    )

    review_labels = Issues.SetLabels(
      owner: default_repo_owner(),
      repo: default_repo_name(),
      number: default_issue_number(),
      labels: ["design-review"]
    )
  }

  stage record_design_outcome [after design_review] {
    design_outcome = ControlPlane.UpsertStageOutcome(
      intake_key: "default-intake",
      issue_id: "{default_repo_owner()}/{default_repo_name()}#{default_issue_number()}",
      stage: "design-review",
      run_key: "sdlc::default-run",
      outcome_status: match review_output.approved {
        true => "approved",
        false => "changes-requested"
      },
      retry_attempt: 0,
      terminal: false,
      approval_required: !review_output.approved,
      payload_hash: "sha256:review-output"
    )
  }

  stage accepted [after record_design_outcome, when review_output.approved] {
    accepted_labels = Issues.SetLabels(
      owner: default_repo_owner(),
      repo: default_repo_name(),
      number: default_issue_number(),
      labels: ["accepted"]
    )

    accepted_comment = Issues.AddComment(
      owner: default_repo_owner(),
      repo: default_repo_name(),
      number: default_issue_number(),
      body: "Design approved. Ready for implementation."
    )
  }

  stage report [after record_design_outcome] {
    stages = [
      stage_result(name: "design", success: true, stderr: ""),
      stage_result(
        name: "design-review",
        success: review_output.approved,
        stderr: review_output.summary
      )
    ]
    summary = aggregate_results(stages: stages)
    report_text = format_report(summary: summary, stages: stages)

    report_comment = Issues.AddComment(
      owner: default_repo_owner(),
      repo: default_repo_name(),
      number: default_issue_number(),
      body: report_text
    )
  }
}
