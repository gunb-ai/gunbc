      edge_cases: [{ description: "marker-based upsert updates existing comment when marker matches", trigger: "same_marker", severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "comment write access", kind: Capability }],
      assumptions: ["Marker text is unique within managed automation comments"],
      unknowns: []
    }
  },
  {
    capability: "set_labels",
    behavior: {
      side_effects: WritesExternal,
      idempotent: true,
      idempotency_keys: ["id", "labels_hash"],
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "operation replaces full label set rather than merging", trigger: "partial_update_expectation", severity: Medium }],
      confidence: Documented,
      prerequisites: [{ description: "label write access", kind: Capability }],
      assumptions: ["Caller provides complete desired label set"],
      unknowns: []
    }
  },
  {
    capability: "close",
    behavior: {
      side_effects: WritesExternal,
      idempotent: true,
      idempotency_keys: ["id"],
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [{ description: "closing an already closed issue is no-op success", trigger: "already_closed", severity: Low }],
      confidence: Documented,
      prerequisites: [{ description: "issue close permission", kind: Capability }],
      assumptions: [],
      unknowns: []
    }
  },
  {
    capability: "list_events",
    behavior: {
      side_effects: ReadOnly,
      idempotent: true,
      idempotency_keys: ["id", "since"],
      determinism: Deterministic,
      failure_modes: [],
      edge_cases: [],
      confidence: HighConfidence,
      prerequisites: [{ description: "event read access", kind: Capability }],
      assumptions: ["Event timeline ordering is stable by timestamp"],
      unknowns: []
