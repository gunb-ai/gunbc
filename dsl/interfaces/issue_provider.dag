      failure_modes: [{ name: "ValidationFailed", condition: "title_or_body_invalid", http_status: 422, recoverable: false, retry_safe: false }],
      edge_cases: [{ description: "duplicate create can happen without caller dedup key", trigger: "retry_without_marker", severity: High }],
      confidence: HighConfidence,
      prerequisites: [{ description: "issue write access", kind: Capability }],
      assumptions: ["Provider creates canonical issue ID on success"],
