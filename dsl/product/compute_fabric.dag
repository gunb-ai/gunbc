// product/compute_fabric.dag — Elastic compute fabric (Worksheet A / exploration §4.0f cases 1–8).
//
// LAYER: product, not std. This is a DOMAIN MODEL (a compute supply/demand/placement
// market), not a standard-library primitive. It imports std/ only and is consumed by
// applications/tests; the operator's CONCRETE fleet instances live further out still
// (ctrl plans.fabric.operator_fleet), and vendor catalogs in extdeps.{cpu,cloud}.
//
// Authority: this module (.dag self-authoritative; worksheet refs retired).
// Composition: cache via ExecutionReceipt.output only — MUST NOT import cache_interface.
//
// Ingress types (UpsertInputRef, ChangeSet, ArtifactRef) are v2.workflow.ci / v2.std.change
// authority — forward-stubbed as Node until harness wires cross-module checks (P-CF-INGRESS).

module product.compute_fabric

import std.types { NonEmptyStr, ContentHash, Bool, Int, LogicalTime }
import std.os.types {
  Darwin,
  FileSystemSemantics,
  KernelFamily,
  Linux,
  LinuxGuestOnWindows,
  OperatingSystemSurface,
  Posix,
  PosixProcess,
  ProcessSemantics,
  WindowsNt,
}
import std.float { Float }
import std.measure {
  Measure,
  Time,
  DataRate,
  One,
  ByteSize,
  MoneyMicros,
  byte_size,
  hardware_thread_count,
  hertz,
}
import std.currency { CurrencyCode }
import std.cache_identity { CacheInterfaceId, ArtifactKindId, ExecutionReceiptDigest }
import std.cpu {
  CpuFacts,
  CpuArchitecture,
  cpu_facts_architecture,
  cpu_facts_cores,
  cpu_facts_sustained_per_thread_hz,
  cpu_facts_threads
}
import std.placement_supply { HostIdentity, PlacementSupplyRow }
// CPU catalog shape (+ the variants the example fixture inhabits) for the
// cpu-dimension witnesses — std.cpu owns the shape, this product only reads it.
import std.cpu.types {
  Aarch64,
  Ampere,
  CpuDeploymentFacts,
  CpuModelCatalogRow,
  CpuSocket,
  CpuVendor,
  LandGridArray,
  SocketPackage,
}

// 🟡 forward — v2.std.witness / v2.std.diagnostic at harness (P-CF-WITNESS).
// Kept intentionally distinct from the kernel `Witness<T>` container.
type ComputeWitness<C> = Node
type Outcome<T> = Node

// 🟡 forward — v2 ingress / artifact carriers (P-CF-INGRESS).
type UpsertInputRef = Node
type ChangeSet = Node
type ArtifactRef<T> = Node
type ArtifactSpec<T> = Node
type WorkAction = Node
type WorkGraph = Node
type Partitioner = Node
type Reducer = Node
type EffectBoundary = Node
type SymbolicCost = Node
type Associativity = Node
type Commutativity = Node
type Idempotency = Node
type IdentityElement = Node
type InstructionSet = Node

// --- §1.7 supporting enums + measure carriers --------------------------------

type NetworkLocality = Loopback | Lan | Internet | WslNat | WslBridged
type NetworkAddressability = Unicast | Multicast | Broadcast
type NetworkEgressClass = None | CratesIo | InternalMirror | Unrestricted
type IsolationBoundary = SharedHostHome | PerJobFilesystem | ContainerHermetic | Vm
type PersistenceKind = Ephemeral | Persistent | CachedMirror
type MemoryKind = Dram | Hbm | UnifiedShared
type StorageMedium = Nvme | Ssd | Hdd | NetworkAttached | EphemeralFs
type LatencyClass = UltraLow | Low | Medium | High
type GpuRuntime = Cuda | Rocm | Metal | OpenCl
type ContainerRuntime = Docker | Podman | Gvisor | Ubicloud | GcloudRun
type CostClass = OwnedMarginalZero | PerSecondBilled | Metered | DeveloperAttention
// Lens: tiered-access cost — owned marginal vs metered vs attention-priced axes.
type OomSignalClass = KillProcess | Throttle | ReportOnly

type Bandwidth = Measure<DataRate, One, Nat>
type Duration = Measure<Time, One, Nat>
type ProviderIdentity = NonEmptyStr where brand("ProviderIdentity")

type ComputeArtifactLocality
  = InProcess
  | PerRunnerColocation
  | PerHostColocation
  | CrossHostFetch
// Lens: memory-hierarchy distance — register/process → runner → host → remote fetch.

// --- §1.4 supply records -----------------------------------------------------

type StorageMount {
  mount_path: NonEmptyStr
  device: StorageDevice
  lifecycle: PersistenceKind
}

// CpuFacts authority: std.cpu (identity + deployment); catalog invariants
// project via cpu_facts_* helpers — not duplicated fields here.

type MemoryFacts { capacity: ByteSize, memory_kind: MemoryKind }

// GPU vendor is a closed domain like `CpuVendor` (std.cpu), NOT a free
// `NonEmptyStr` — dissolves the DESIGN.md §3 "one vendor concept forks by
// rigor" debt named for this field. Distinct enum from `CpuVendor` because
// GPU and CPU vendors are different domains (Nvidia is GPU-only); reusing
// `CpuVendor` would be a nickname, not a single authority. Fixing a
// known-stringly field is type-correctness, not abstraction ahead of demand
// (same move as `CostEstimate.unit_price` → `MoneyMicros`).
type GpuVendor = Nvidia | AmdGpu | IntelGpu | AppleGpu | Qualcomm | ArmMali

type GpuFacts {
  vendor: GpuVendor
  model: NonEmptyStr
  compute_capability: NonEmptyStr?
  memory: MemoryFacts
  supported_runtimes: List<GpuRuntime>
}

type AcceleratorFacts { vendor: NonEmptyStr, model: NonEmptyStr }

type MemoryDevice {
  capacity: ByteSize
  memory_kind: MemoryKind
  bandwidth: Bandwidth?
}

type StorageDevice {
  capacity: ByteSize
  medium: StorageMedium
  read_bandwidth: Bandwidth?
  write_bandwidth: Bandwidth?
  persistence: PersistenceKind
}

type NetworkInterface {
  addressability: NetworkAddressability
  bandwidth: Bandwidth?
  latency_class: LatencyClass?
  locality: NetworkLocality
}

type ExecutionSurface {
  os: OperatingSystemSurface
  isolation: IsolationBoundary
  container_runtime: ContainerRuntime?
  toolchains: List<ToolchainCapability>
  mounted_storage: List<StorageMount>
  network: List<NetworkInterface>
}

type ProcessorKind
  = CpuProcessor { cpu: CpuFacts }
  | GpuProcessor { gpu: GpuFacts }
  | AcceleratorProcessor { accelerator: AcceleratorFacts }

type ComputeHost {
  identity: HostIdentity
  processors: List<ProcessorKind>
  memory: List<MemoryDevice>
  storage: List<StorageDevice>
  network_interfaces: List<NetworkInterface>
}

// 🟡 P-CF-COST-MODEL — dissolve when per-provider `data` rows land (Worksheet A §1.4 / §7).
type ProcessorCostModel { placeholder: Bool }
type ProviderCostModel { placeholder: Bool }

type CostModel {
  cost_class: CostClass
  rates: ProviderCostModel
}

type ComputeSupplyFacts {
  physical: ComputeHost
  execution: ExecutionSurface
  cost: CostModel?
  observed_performance: List<PerformanceReceipt>
}

type ProviderConstraint
  = HostJobserverFifo { fifo_path: NonEmptyStr, token_cap: Int }
  | SharedHomeRoot { path: NonEmptyStr }
  | MaxConcurrentRunners { cap: Int }
  | OomBehavior { signal: OomSignalClass }

type AvailabilityWindow { open: LogicalTime, close: LogicalTime? }
// Lens: RAII borrow window — open acquires scope; close is optional early release.
// Cost quote: a fixed-point money price tagged with its ISO 4217 currency.
// The `expected_units: Float` / `currency: NonEmptyStr` stopgap (Float carrying
// raw int micros; loose string code) is DISSOLVED here onto the money carrier
// landed in `std.measure` / `std.currency`:
//   - `unit_price: MoneyMicros` — `Measure<Currency, Micro>`, the exact micro
//     denomination Hetzner quotes in (`*_eur_micros`). Money is fixed-point,
//     never `Float` (floating point for money is a representation defect).
//   - `currency: CurrencyCode` — ISO 4217 closed-domain identity, not a free
//     `NonEmptyStr`.
type CostEstimate { model: CostModel, unit_price: MoneyMicros, currency: CurrencyCode }

type ComputeOffer {
  provider: ProviderIdentity
  supply: ComputeSupplyFacts
  available_window: AvailabilityWindow
  cost_quote: CostEstimate?
  constraints: List<ProviderConstraint>
}

type MachineView { label: NonEmptyStr, host: HostIdentity }

fn machine_view(host: ComputeHost, surface: ExecutionSurface) -> MachineView {
  MachineView {
    label: machine_view_label(host: host, surface: surface),
    host: host.identity,
  }
}

fn machine_view_label(host: ComputeHost, surface: ExecutionSurface) -> NonEmptyStr {
  // Label from execution surface when grounded; else host identity (Worksheet A §1.4).
  match surface.os.distro_or_product {
    Present { value: distro } => distro
    Absent => host.identity
  }
}

// --- §1.4b placement projection (derived — NOT a parallel authority) ----------
//
// PlacementSupplyRow authority: std.placement_supply. ram_bytes_total is a
// value-typed ByteSize projection — Measure carriers now have inhabitants via
// std.measure, so this consumer is migrated in step with the census (the
// prior P-CF-BYTESIZE bare-Int stopgap here is dissolved).

fn placement_supply_row(identity: HostIdentity, cpu: CpuFacts, ram_bytes_total: ByteSize) -> PlacementSupplyRow {
  PlacementSupplyRow {
    identity: identity,
    hardware_threads: cpu_facts_threads(cpu),
    clock_hz: cpu_facts_sustained_per_thread_hz(cpu),
    ram_bytes: ram_bytes_total,
  }
}

// --- §1.2 demand -------------------------------------------------------------

type ResourceEnvelope {
  cpu: CpuRequirement?
  gpu: GpuRequirement?
  memory: MemoryRequirement?
  storage: StorageRequirement?
  network: NetworkRequirement?
}

type CpuRequirement { min_cores: Int, architecture: CpuArchitecture? }
type GpuRequirement { min_vram: ByteSize, runtimes: List<GpuRuntime> }
type MemoryRequirement { min_bytes: ByteSize }
type StorageRequirement { min_bytes: ByteSize, persistence: PersistenceKind }
type NetworkRequirement { egress: NetworkEgressClass?, ambient_allowed: Bool }
type OperatingSystemRequirement { surface: OperatingSystemSurface }
type IsolationRequirement { boundary: IsolationBoundary }
type ToolchainRequirement { name: NonEmptyStr, version: NonEmptyStr }

type ArtifactLocalityRequirement {
  artifact_kind: ArtifactKindId
  locality: ComputeArtifactLocality
}

type ToolchainEnvIsolation
  = SharedHomeAcrossJobs
  | PerJobCargoHome { cargo_home_var: NonEmptyStr, rustup_home_var: NonEmptyStr }
  | HermeticContainer

type BuildWrapperKind = CtrlBuild | BakedInImage | NoBuildWrapper

type ToolchainCapability {
  name: NonEmptyStr
  version: NonEmptyStr
  env_isolation: ToolchainEnvIsolation
  build_wrapper: BuildWrapperKind?
  linked_cache_interface: CacheInterfaceId?
}

type WorkDemand {
  resources: ResourceEnvelope
  os: OperatingSystemRequirement?
  isolation: IsolationRequirement
  toolchains: List<ToolchainRequirement>
  parallelism: ParallelismShape
  data_locality: List<ArtifactLocalityRequirement>
  effects: List<EffectBoundary>
}

// --- §1.3 parallelism + budget -----------------------------------------------

type ParallelismShape
  = SingleWorkItem
  | IndependentShards { shard_count: Int }
  | DependencyGraphParallel { graph: WorkGraph }
  | PartitionedReduce {
      partitioner: Partitioner
      map: WorkAction
      reduce: Reducer
      laws: ReducerLaws
    }

type ReducerLaws {
  associative: ComputeWitness<Associativity>
  commutative: ComputeWitness<Commutativity>?
  identity: IdentityElement?
  idempotent: ComputeWitness<Idempotency>?
}

type ExecutionBudget {
  expected_cost: SymbolicCost
  provider_model: ProviderCostModel
  watchdog: WatchdogLimit
}

type WatchdogLimit { max_wall: Duration }

// --- §1.5 eligibility --------------------------------------------------------

type DemandDimension
  = DemandCpu
  | DemandGpu
  | DemandMemory
  | DemandStorage
  | DemandNetwork
  | DemandOs
  | DemandIsolation
  | DemandToolchains
  | DemandParallelism
  | DemandDataLocality
  | DemandEffects

type MissingDemandFact { dimension: DemandDimension, required: NonEmptyStr }

type ComputeLeaseWitness {
  provider: ProviderIdentity
  satisfied: List<DemandDimension>
}

type ComputeLeaseEligibility
  = Eligible { witness: ComputeLeaseWitness }
  | Rejected { reason: MissingDemandFact }

type AllocationReceipt {
  provider: ProviderIdentity
  scope: NonEmptyStr
  acquired_at: LogicalTime
}

type ComputeLease {
  offer: ComputeOffer
  demand: WorkDemand
  allocation: AllocationReceipt
  eligibility: ComputeWitness<ComputeLeaseEligibility>
}
// Lens: RAII borrow — offer + demand paired for lease lifetime; allocation receipt is acquire proof.

// 🟢 P-CF-WITNESS dissolved: satisfies returns ComputeLeaseEligibility directly (ComputeWitness<C>
// stays a forward Node for v2.std.witness). Isolation is an ordered lattice (chain below),
// honored iff ordinal(supply) >= ordinal(demand) — rationale in PR #4805 / commit message.
//   SharedHostHome < PerJobFilesystem < ContainerHermetic < Vm
fn isolation_boundary_ordinal(boundary: IsolationBoundary) -> Int {
  match boundary {
    SharedHostHome   => 0
    PerJobFilesystem => 1
    ContainerHermetic => 2
    Vm               => 3
  }
}

fn isolation_boundary_label(boundary: IsolationBoundary) -> NonEmptyStr {
  match boundary {
    SharedHostHome   => "Vm/ContainerHermetic/PerJobFilesystem/SharedHostHome"
    PerJobFilesystem => "Vm/ContainerHermetic/PerJobFilesystem"
    ContainerHermetic => "Vm/ContainerHermetic"
    Vm               => "Vm"
  }
}

// supply isolation honors a demand iff it is at least as strong on the chain.
fn isolation_satisfies(supply: IsolationBoundary, demand: IsolationBoundary) -> Bool {
  isolation_boundary_ordinal(boundary: supply) >= isolation_boundary_ordinal(boundary: demand)
}

// --- §1.5b orthogonal dimension checks ---------------------------------------
//
// Each demand DIMENSION is checked INDEPENDENTLY by its own pure
// `check_<dimension>` reader over (offer, demand): the dimensions are
// orthogonal — one dimension's verdict never reads another's. A checker reports
// one of three states for its axis:
//
//   DimensionNotDemanded — the workflow imposes no constraint on this axis
//                          (optional field Absent / empty list); nothing to prove.
//   DimensionSatisfied   — the offer's supply provably honors the demand.
//   DimensionUnmet       — the demand is present and the offer does NOT honor it.
//
// `satisfies` folds the per-dimension verdicts into one ComputeLeaseEligibility,
// FAIL-CLOSED (§5): the FIRST Unmet dimension rejects the whole lease (a wrong
// admission is a silent harm paid later at interest), and the Eligible witness
// enumerates exactly the dimensions actually PROVEN (NotDemanded axes are not
// listed — nothing was demanded, so nothing was proven). This is what abstracts
// the workflow's compute demand FROM the compute supply: the workflow expresses
// its envelope once as orthogonal dimensions, and ANY offer that proves them all
// is eligible — the mapreduce over the change DAG runs on whatever supply fits.
//
// (Prior `satisfies` gated on isolation ALONE and returned Eligible regardless
// of cpu/gpu/memory/… demand — a fail-OPEN admission. The fold closes that hole:
// every demanded dimension must now be proven.)
//
// Grounded today (real comparisons of distinct kinds): isolation (lattice
// ordinal), cpu (Int core count + architecture enum), os (FULL surface — kernel
// + distro/version + filesystem/process semantics, each enum/string equality;
// a matching kernel with a mismatched sub-field is fail-closed, not admitted),
// toolchains (name+version membership). The remaining supply-match dimensions
// are modeled but FAIL-CLOSED pending their comparison primitive:
//   🟡 P-CF-DIM-BYTESIZE — memory/storage/gpu-vram need an ORDERED ByteSize;
//      `Measure`'s carrier `Magnitude` is an opaque atom with no `>=` today, and
//      adding it is the gated std numeric-cascade slice, not this product change.
//      Dissolve each fail-closed arm when ByteSize inhabits a total order.
//   🟡 P-CF-DIM-NETWORK — supply carries no egress-class fact to match a
//      NetworkRequirement.egress (NetworkInterface has locality/addressability
//      only). Dissolve when the supply surface gains an egress-class fact.
//
// parallelism / data_locality / effects are NOT per-offer supply-match
// dimensions: they shape how the mapreduce DECOMPOSES work ACROSS supply — an
// orthogonal concern from "does this one offer fit the per-unit envelope" — and
// belong to the placement/decomposition layer, not this eligibility fold.

type DimensionCheck
  = DimensionNotDemanded { dimension: DemandDimension }
  | DimensionSatisfied { dimension: DemandDimension }
  | DimensionUnmet { fact: MissingDemandFact }

fn check_isolation(offer: ComputeOffer, demand: WorkDemand) -> DimensionCheck {
  if isolation_satisfies(supply: offer.supply.execution.isolation, demand: demand.isolation.boundary) {
    DimensionSatisfied { dimension: DemandIsolation }
  } else {
    DimensionUnmet {
      fact: MissingDemandFact {
        dimension: DemandIsolation,
        required: isolation_boundary_label(boundary: demand.isolation.boundary),
      },
    }
  }
}

// First CpuProcessor's facts in the host's processor list (Absent if the host
// advertises no CPU processor).
fn first_cpu_facts(processors: List<ProcessorKind>) -> CpuFacts? {
  fold(processors, init: none, f: (acc, p) =>
    match acc {
      Present { value: c } => Present { value: c }
      Absent =>
        match p {
          CpuProcessor { cpu: c } => Present { value: c }
          GpuProcessor { gpu: _ } => Absent
          AcceleratorProcessor { accelerator: _ } => Absent
        }
    })
}

fn cpu_requirement_architecture_ok(facts: CpuFacts, req: CpuRequirement) -> Bool {
  match req.architecture {
    Absent => true
    Present { value: arch } => cpu_facts_architecture(facts) == arch
  }
}

fn check_cpu(offer: ComputeOffer, demand: WorkDemand) -> DimensionCheck {
  match demand.resources.cpu {
    Absent => DimensionNotDemanded { dimension: DemandCpu }
    Present { value: req } =>
      match first_cpu_facts(offer.supply.physical.processors) {
        Absent =>
          DimensionUnmet { fact: MissingDemandFact { dimension: DemandCpu, required: "cpu processor" } }
        Present { value: facts } =>
          if cpu_facts_cores(facts) >= req.min_cores && cpu_requirement_architecture_ok(facts: facts, req: req) {
            DimensionSatisfied { dimension: DemandCpu }
          } else {
            DimensionUnmet { fact: MissingDemandFact { dimension: DemandCpu, required: "min_cores+architecture" } }
          }
      }
  }
}

fn kernel_family_label(kernel: KernelFamily) -> NonEmptyStr {
  match kernel {
    Linux               => "Linux"
    Darwin              => "Darwin"
    WindowsNt           => "WindowsNt"
    LinuxGuestOnWindows => "LinuxGuestOnWindows"
  }
}

// An optional surface sub-field is honored iff the demand imposes no constraint
// (Absent) or the supply carries the SAME value. A demand that pins a distro/
// version the supply does not advertise is fail-closed (Absent supply ≠ proven).
fn os_optional_str_satisfied(supply: NonEmptyStr?, demand: NonEmptyStr?) -> Bool {
  match demand {
    Absent => true
    Present { value: d } =>
      match supply {
        Absent => false
        Present { value: s } => s == d
      }
  }
}

// The FULL demanded OS surface must be proven, not just the kernel: distro,
// version, filesystem and process semantics are all on the demand side and all
// comparable today (enum/string equality — no ByteSize blocker). Returns the
// first unmet sub-field as a located diagnostic, or Absent if every field holds.
fn os_surface_unmet_field(supply: OperatingSystemSurface, demand: OperatingSystemSurface) -> NonEmptyStr? {
  if supply.kernel == demand.kernel {
    if os_optional_str_satisfied(supply: supply.distro_or_product, demand: demand.distro_or_product) {
      if os_optional_str_satisfied(supply: supply.version, demand: demand.version) {
        if supply.filesystem_semantics == demand.filesystem_semantics {
          if supply.process_semantics == demand.process_semantics {
            none
          } else {
            Present { value: "os process semantics" }
          }
        } else {
          Present { value: "os filesystem semantics" }
        }
      } else {
        Present { value: "os version" }
      }
    } else {
      Present { value: "os distro/product" }
    }
  } else {
    Present { value: kernel_family_label(kernel: demand.kernel) }
  }
}

fn check_os(offer: ComputeOffer, demand: WorkDemand) -> DimensionCheck {
  match demand.os {
    Absent => DimensionNotDemanded { dimension: DemandOs }
    Present { value: req } =>
      match os_surface_unmet_field(supply: offer.supply.execution.os, demand: req.surface) {
        Absent => DimensionSatisfied { dimension: DemandOs }
        Present { value: field } =>
          DimensionUnmet { fact: MissingDemandFact { dimension: DemandOs, required: field } }
      }
  }
}

fn toolchain_available(supply: List<ToolchainCapability>, req: ToolchainRequirement) -> Bool {
  supply |> any(cap => cap.name == req.name && cap.version == req.version)
}

fn toolchain_check_step(supply: List<ToolchainCapability>, req: ToolchainRequirement) -> DimensionCheck {
  if toolchain_available(supply: supply, req: req) {
    DimensionSatisfied { dimension: DemandToolchains }
  } else {
    DimensionUnmet { fact: MissingDemandFact { dimension: DemandToolchains, required: req.name } }
  }
}

// Empty demand → NotDemanded; every requirement met → Satisfied; first
// unmet requirement → Unmet (its name). One fold, no `length`.
fn check_toolchains(offer: ComputeOffer, demand: WorkDemand) -> DimensionCheck {
  let supply = offer.supply.execution.toolchains
  fold(demand.toolchains, init: DimensionNotDemanded { dimension: DemandToolchains }, f: (acc, req) =>
    match acc {
      DimensionUnmet { fact: f } => DimensionUnmet { fact: f }
      _ => toolchain_check_step(supply: supply, req: req)
    })
}

// 🟡 P-CF-DIM-BYTESIZE: min_vram needs an ordered ByteSize — fail-closed until then.
fn check_gpu(offer: ComputeOffer, demand: WorkDemand) -> DimensionCheck {
  match demand.resources.gpu {
    Absent => DimensionNotDemanded { dimension: DemandGpu }
    Present { value: _ } =>
      DimensionUnmet { fact: MissingDemandFact { dimension: DemandGpu, required: "min_vram (ordered ByteSize pending P-CF-DIM-BYTESIZE)" } }
  }
}

// 🟡 P-CF-DIM-BYTESIZE: min_bytes needs an ordered ByteSize — fail-closed until then.
fn check_memory(offer: ComputeOffer, demand: WorkDemand) -> DimensionCheck {
  match demand.resources.memory {
    Absent => DimensionNotDemanded { dimension: DemandMemory }
    Present { value: _ } =>
      DimensionUnmet { fact: MissingDemandFact { dimension: DemandMemory, required: "min_bytes (ordered ByteSize pending P-CF-DIM-BYTESIZE)" } }
  }
}

// 🟡 P-CF-DIM-BYTESIZE: min_bytes needs an ordered ByteSize — fail-closed until then.
fn check_storage(offer: ComputeOffer, demand: WorkDemand) -> DimensionCheck {
  match demand.resources.storage {
    Absent => DimensionNotDemanded { dimension: DemandStorage }
    Present { value: _ } =>
      DimensionUnmet { fact: MissingDemandFact { dimension: DemandStorage, required: "min_bytes (ordered ByteSize pending P-CF-DIM-BYTESIZE)" } }
  }
}

// 🟡 P-CF-DIM-NETWORK: supply carries no egress-class fact to match — fail-closed until then.
fn check_network(offer: ComputeOffer, demand: WorkDemand) -> DimensionCheck {
  match demand.resources.network {
    Absent => DimensionNotDemanded { dimension: DemandNetwork }
    Present { value: _ } =>
      DimensionUnmet { fact: MissingDemandFact { dimension: DemandNetwork, required: "egress class (supply egress fact pending P-CF-DIM-NETWORK)" } }
  }
}

// Fold step: keep the FIRST Unmet (fail-closed); accumulate proven dimensions.
fn fold_dimension_check(acc: ComputeLeaseEligibility, check: DimensionCheck) -> ComputeLeaseEligibility {
  match acc {
    Rejected { reason: r } => Rejected { reason: r }
    Eligible { witness: w } =>
      match check {
        DimensionUnmet { fact: f } => Rejected { reason: f }
        DimensionSatisfied { dimension: d } =>
          Eligible {
            witness: ComputeLeaseWitness {
              provider: w.provider,
              satisfied: append(w.satisfied, items: [d]),
            },
          }
        DimensionNotDemanded { dimension: _ } => Eligible { witness: w }
      }
  }
}

// Orthogonal fold over the per-dimension verdicts. Fail-closed (§5): first Unmet
// rejects; the Eligible witness enumerates exactly the dimensions proven.
// Lens: host selection over the offer free-list — first-fit allocator semantics (cf. placement_supply).
fn satisfies(offer: ComputeOffer, demand: WorkDemand) -> ComputeLeaseEligibility {
  fold(
    [
      check_isolation(offer: offer, demand: demand),
      check_cpu(offer: offer, demand: demand),
      check_os(offer: offer, demand: demand),
      check_toolchains(offer: offer, demand: demand),
      check_gpu(offer: offer, demand: demand),
      check_memory(offer: offer, demand: demand),
      check_storage(offer: offer, demand: demand),
      check_network(offer: offer, demand: demand),
    ],
    init: Eligible { witness: ComputeLeaseWitness { provider: offer.provider, satisfied: [] } },
    f: (acc, check) => fold_dimension_check(acc: acc, check: check),
  )
}

// --- §1.1 executable unit + ingress --------------------------------------------

type WorkUnitId = NonEmptyStr where brand("WorkUnitId")

type WorkUnit<T> {
  id: WorkUnitId
  inputs: List<ArtifactRef<T>>
  action: WorkAction
  output: ArtifactSpec<T>
  requirements: WorkDemand
}

// --- §1.6 execution receipts -------------------------------------------------

type MeasurementConfidence
  = SingleSample
  | Range { low: Float, high: Float }
  | DistributionSummary { mean: Float, variance: Float }

type PerformanceReceipt {
  provider: ProviderIdentity
  work_shape: WorkUnitId
  wall_duration: Duration
  cpu_seconds: Float?
  sample_count: Int
  measurement_context: ExecutionSurface
  confidence: MeasurementConfidence
  cache_state_summary: NonEmptyStr?
}

type PricingSource
  = VendorDocument { citation: NonEmptyStr }
  | ObservedBill { receipt_id: NonEmptyStr }
  | NegotiatedRate { contract_ref: NonEmptyStr }

type AmortizationScope
  = PerLease
  | PerCalendarMonth
  | PerWorkShape

type CostReceipt {
  provider: ProviderIdentity
  cost_class: CostClass
  // Money is fixed-point: the observed-bill amount is `MoneyMicros`, not
  // `Float` (same money-as-Float defect dissolved on `CostEstimate.unit_price`).
  // The type is corrected here regardless of inhabitation — fixing a
  // known-wrong field type is type-correctness, not abstraction ahead of
  // demand. `CostReceipt` stays uninhabited (no fabricated `data` rows until a
  // real observed-bill consumer lands).
  amount: MoneyMicros?
  pricing_source: PricingSource
  amortization_scope: AmortizationScope?
}

type ExecutionReceipt<T> {
  work: WorkUnit<T>
  lease: ComputeLease
  output: Outcome<ArtifactRef<T>>
  performance: PerformanceReceipt
  cost: CostReceipt
  started_at: LogicalTime
  finished_at: LogicalTime
}

// --- §7 isolation-lattice witnesses (concept-only example fixtures) ----------
//
// The cross-provider isolation proofs below run on GENERIC example offers, not on
// any real machine. The operator's actual fleet (srv1/srv2) and the Hetzner CAX41
// offer are *instances* that ground this concept; they live in the operator
// deployment repo (ctrl), which imports this module plus the extdeps vendor
// models. std/ owns the shape and the proof that the lattice behaves — it does
// not own the computers.

data example_host_identity: HostIdentity = "example-host"
data example_shared_host_provider: ProviderIdentity = "example-shared-host"
data example_vm_provider: ProviderIdentity = "example-vm"
data example_availability_open: LogicalTime = "example:always-open"

data example_linux_os_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: none,
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

data example_shared_host_execution_surface: ExecutionSurface = ExecutionSurface {
  os: example_linux_os_surface,
  isolation: SharedHostHome,
  container_runtime: none,
  toolchains: [],
  mounted_storage: [],
  network: [],
}

data example_vm_execution_surface: ExecutionSurface = ExecutionSurface {
  os: example_linux_os_surface,
  isolation: Vm,
  container_runtime: none,
  toolchains: [],
  mounted_storage: [],
  network: [],
}

data example_compute_host: ComputeHost = ComputeHost {
  identity: example_host_identity,
  processors: [],
  memory: [],
  storage: [],
  network_interfaces: [],
}

data example_owned_cost: CostModel = CostModel {
  cost_class: OwnedMarginalZero,
  rates: ProviderCostModel { placeholder: true },
}

// A generic SharedHostHome offer — exercises the lattice, names no real machine.
data example_shared_host_offer: ComputeOffer = ComputeOffer {
  provider: example_shared_host_provider,
  supply: ComputeSupplyFacts {
    physical: example_compute_host,
    execution: example_shared_host_execution_surface,
    cost: Present { value: example_owned_cost },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: example_availability_open, close: none },
  cost_quote: none,
  constraints: [],
}

// A generic Vm offer — the stronger isolation boundary.
data example_vm_offer: ComputeOffer = ComputeOffer {
  provider: example_vm_provider,
  supply: ComputeSupplyFacts {
    physical: example_compute_host,
    execution: example_vm_execution_surface,
    cost: Present { value: example_owned_cost },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: example_availability_open, close: none },
  cost_quote: none,
  constraints: [],
}

// Generic Vm demand used by the cross-provider witnesses below.
data vm_isolation_work_demand: WorkDemand = WorkDemand {
  resources: ResourceEnvelope {
    cpu: none,
    gpu: none,
    memory: none,
    storage: none,
    network: none,
  },
  os: none,
  isolation: IsolationRequirement { boundary: Vm },
  toolchains: [],
  parallelism: SingleWorkItem,
  data_locality: [],
  effects: [],
}

// Case 7 — #1 rule: an untrusted Vm-requiring job is NOT honored by SharedHostHome supply.
fn witness_shared_host_home_rejects_vm() -> Bool {
  isolation_satisfies(supply: SharedHostHome, demand: Vm) == false
}

// Case 8 — a SharedHostHome-tolerant (trusted in-fleet) job IS honored by SharedHostHome supply.
fn witness_shared_host_home_admits_shared_host_home() -> Bool {
  isolation_satisfies(supply: SharedHostHome, demand: SharedHostHome)
}

// Monotonicity: stronger supply honors a weaker demand (Vm admits SharedHostHome), never reverse.
fn witness_vm_admits_shared_host_home() -> Bool {
  isolation_satisfies(supply: Vm, demand: SharedHostHome)
}

// Cross-provider, full-offer: a SharedHostHome offer rejects a Vm demand.
fn witness_shared_host_offer_rejects_vm_demand() -> Bool {
  match satisfies(offer: example_shared_host_offer, demand: vm_isolation_work_demand) {
    Rejected { reason: _ } => true
    Eligible { witness: _ } => false
  }
}

// Cross-provider, full-offer: a Vm offer admits a Vm demand.
fn witness_vm_offer_admits_vm_demand() -> Bool {
  match satisfies(offer: example_vm_offer, demand: vm_isolation_work_demand) {
    Eligible { witness: _ } => true
    Rejected { reason: _ } => false
  }
}

// --- §7b orthogonal-dimension witnesses (concept-only example fixtures) -------
//
// Each witness exercises ONE demand dimension through the same `satisfies` fold,
// proving the dimensions are independent: a cpu demand rejects on the cpu axis,
// an os demand on the os axis, a (fail-closed) memory demand on the memory axis,
// and a non-conflicting demand is admitted with the proven dimensions in the
// witness. Concept fixtures, naming no real machine (cf. the §7 offers above).

// Example 64-core Aarch64 CPU — grounds the cpu dimension's real Int core-count
// + architecture-enum comparison (no real machine; mirrors the extdeps Ampere row).
data example_cpu_facts: CpuFacts = CpuFacts {
  catalog: CpuModelCatalogRow {
    model_number: "example-64c",
    oem_listing_id: none,
    vendor: Ampere,
    architecture: Aarch64,
    cores: 64,
    threads: hardware_thread_count(64),
    nominal_sustained_per_thread_hz: hertz(3000000000),
    socket: CpuSocket { package: LandGridArray, contact_count: 4926 },
    tdp_watts: 124,
  },
  deployment: CpuDeploymentFacts { sustained_per_thread_hz: hertz(3000000000) },
}

data example_cpu_compute_host: ComputeHost = ComputeHost {
  identity: example_host_identity,
  processors: [CpuProcessor { cpu: example_cpu_facts }],
  memory: [],
  storage: [],
  network_interfaces: [],
}

// SharedHostHome offer carrying the 64-core CPU (exercises the cpu axis).
data example_cpu_offer: ComputeOffer = ComputeOffer {
  provider: example_shared_host_provider,
  supply: ComputeSupplyFacts {
    physical: example_cpu_compute_host,
    execution: example_shared_host_execution_surface,
    cost: Present { value: example_owned_cost },
    observed_performance: [],
  },
  available_window: AvailabilityWindow { open: example_availability_open, close: none },
  cost_quote: none,
  constraints: [],
}

data example_darwin_os_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Darwin,
  distro_or_product: none,
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

// A 4-core demand (SharedHostHome) — satisfied by the 64-core example supply.
data cpu_4core_demand: WorkDemand = WorkDemand {
  resources: ResourceEnvelope {
    cpu: Present { value: CpuRequirement { min_cores: 4, architecture: none } },
    gpu: none,
    memory: none,
    storage: none,
    network: none,
  },
  os: none,
  isolation: IsolationRequirement { boundary: SharedHostHome },
  toolchains: [],
  parallelism: SingleWorkItem,
  data_locality: [],
  effects: [],
}

// A 128-core demand — exceeds the 64-core example supply (cpu axis goes red).
data cpu_128core_demand: WorkDemand = WorkDemand {
  resources: ResourceEnvelope {
    cpu: Present { value: CpuRequirement { min_cores: 128, architecture: none } },
    gpu: none,
    memory: none,
    storage: none,
    network: none,
  },
  os: none,
  isolation: IsolationRequirement { boundary: SharedHostHome },
  toolchains: [],
  parallelism: SingleWorkItem,
  data_locality: [],
  effects: [],
}

// A memory demand — fail-closed pending ordered ByteSize (P-CF-DIM-BYTESIZE).
data memory_demand: WorkDemand = WorkDemand {
  resources: ResourceEnvelope {
    cpu: none,
    gpu: none,
    memory: Present { value: MemoryRequirement { min_bytes: byte_size(1073741824) } },
    storage: none,
    network: none,
  },
  os: none,
  isolation: IsolationRequirement { boundary: SharedHostHome },
  toolchains: [],
  parallelism: SingleWorkItem,
  data_locality: [],
  effects: [],
}

// Vm isolation + Linux OS — matches example_vm_offer (Linux kernel, Vm).
data vm_linux_os_demand: WorkDemand = WorkDemand {
  resources: ResourceEnvelope {
    cpu: none,
    gpu: none,
    memory: none,
    storage: none,
    network: none,
  },
  os: Present { value: OperatingSystemRequirement { surface: example_linux_os_surface } },
  isolation: IsolationRequirement { boundary: Vm },
  toolchains: [],
  parallelism: SingleWorkItem,
  data_locality: [],
  effects: [],
}

// Vm isolation + Darwin OS — mismatches example_vm_offer's Linux kernel.
data vm_darwin_os_demand: WorkDemand = WorkDemand {
  resources: ResourceEnvelope {
    cpu: none,
    gpu: none,
    memory: none,
    storage: none,
    network: none,
  },
  os: Present { value: OperatingSystemRequirement { surface: example_darwin_os_surface } },
  isolation: IsolationRequirement { boundary: Vm },
  toolchains: [],
  parallelism: SingleWorkItem,
  data_locality: [],
  effects: [],
}

// Linux surface pinning a distro the example supply does NOT advertise
// (example_linux_os_surface has distro_or_product: none) — same kernel, but a
// demanded sub-field the supply cannot prove.
data example_ubuntu_os_surface: OperatingSystemSurface = OperatingSystemSurface {
  kernel: Linux,
  distro_or_product: "Ubuntu",
  version: none,
  filesystem_semantics: Posix,
  process_semantics: PosixProcess,
}

// Vm isolation + Linux-kernel demand that pins distro "Ubuntu".
data vm_ubuntu_os_demand: WorkDemand = WorkDemand {
  resources: ResourceEnvelope {
    cpu: none,
    gpu: none,
    memory: none,
    storage: none,
    network: none,
  },
  os: Present { value: OperatingSystemRequirement { surface: example_ubuntu_os_surface } },
  isolation: IsolationRequirement { boundary: Vm },
  toolchains: [],
  parallelism: SingleWorkItem,
  data_locality: [],
  effects: [],
}

// cpu — a 4-core demand is admitted by the 64-core supply (Int comparison green;
// isolation SharedHostHome also honored).
fn witness_cpu_demand_admitted_when_cores_suffice() -> Bool {
  match satisfies(offer: example_cpu_offer, demand: cpu_4core_demand) {
    Eligible { witness: _ } => true
    Rejected { reason: _ } => false
  }
}

// cpu — a 128-core demand exceeds the 64-core supply: rejected on the cpu axis
// (discriminating — the same offer admits the 4-core demand above).
fn witness_cpu_demand_rejected_when_cores_short() -> Bool {
  match satisfies(offer: example_cpu_offer, demand: cpu_128core_demand) {
    Rejected { reason: r } =>
      match r.dimension {
        DemandCpu => true
        _ => false
      }
    Eligible { witness: _ } => false
  }
}

// cpu — a cpu demand against a processor-less offer is rejected on the cpu axis
// (fail-closed: no CpuProcessor to prove against).
fn witness_cpu_demand_rejected_when_no_processor() -> Bool {
  match satisfies(offer: example_shared_host_offer, demand: cpu_4core_demand) {
    Rejected { reason: r } =>
      match r.dimension {
        DemandCpu => true
        _ => false
      }
    Eligible { witness: _ } => false
  }
}

// os — a matching kernel family is admitted (Vm offer is Linux, demand Linux).
fn witness_os_demand_admitted_matching_kernel() -> Bool {
  match satisfies(offer: example_vm_offer, demand: vm_linux_os_demand) {
    Eligible { witness: _ } => true
    Rejected { reason: _ } => false
  }
}

// os — a mismatched kernel family is rejected on the os axis (Linux supply,
// Darwin demand) even though isolation is honored — dimensions are independent.
fn witness_os_demand_rejected_mismatched_kernel() -> Bool {
  match satisfies(offer: example_vm_offer, demand: vm_darwin_os_demand) {
    Rejected { reason: r } =>
      match r.dimension {
        DemandOs => true
        _ => false
      }
    Eligible { witness: _ } => false
  }
}

// os — a matching kernel with a mismatched distro is rejected on the os axis:
// the full demanded surface (not just kernel) must be proven. The Vm offer is
// Linux/no-distro; the demand pins Linux/"Ubuntu", so a sub-field goes red even
// though the kernel matches (discriminating against the kernel-only check).
fn witness_os_demand_rejected_distro_mismatch() -> Bool {
  match satisfies(offer: example_vm_offer, demand: vm_ubuntu_os_demand) {
    Rejected { reason: r } =>
      match r.dimension {
        DemandOs => true
        _ => false
      }
    Eligible { witness: _ } => false
  }
}

// fail-OPEN fix — a memory demand (which the prior isolation-only `satisfies`
// admitted silently) is now rejected fail-closed on the memory axis.
fn witness_memory_demand_fail_closed() -> Bool {
  match satisfies(offer: example_shared_host_offer, demand: memory_demand) {
    Rejected { reason: r } =>
      match r.dimension {
        DemandMemory => true
        _ => false
      }
    Eligible { witness: _ } => false
  }
}

// Content-pure digest projected from work identity (work.id) only; output
// content_digest joins when ArtifactRef inhabits. Full canonical encoding
// (action + inputs + output spec + output content_digest) supplied by the
// harness when Outcome/ArtifactRef inhabit (Node stubs today).
fn execution_receipt_digest<T>(receipt: ExecutionReceipt<T>) -> ExecutionReceiptDigest {
  receipt.work.id
}
