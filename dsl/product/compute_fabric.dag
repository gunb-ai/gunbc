module product.compute_fabric

import std.types { NonEmptyStr, Bool, Int, List }

type Fabric = NonEmptyStr where brand("Fabric")

type HardRequirements { threads: Int }

type Shape { hard: HardRequirements }

fn shape_covers(offered: Shape, needed: Shape) -> Bool {
  offered.hard.threads >= needed.hard.threads
}

type ProgramPreference { preferred_tag: NonEmptyStr? }

type Program {
  id: NonEmptyStr
  hard: HardRequirements
  prefers: ProgramPreference
}

fn derive_shape(p: Program) -> Shape {
  Shape { hard: p.hard }
}

type ComputeNeed {
  fabric: Fabric
  program: Program
}

type Opportunity {
  fabric: Fabric
  offers: Shape
  tag: NonEmptyStr
}

type Connection
  = Bound { opportunity: Opportunity }
  | Pending
  | Unmet { reason: NonEmptyStr }

fn connect(need: ComputeNeed, opportunities: List<Opportunity>) -> Connection {
  let shape = derive_shape(p: need.program)
  fold(
    opportunities,
    init: Unmet { reason: "no_matching_opportunity" },
    f: (acc, opp) =>
      match acc {
        Bound { opportunity: _ } => acc
        Pending => acc
        Unmet { reason: _ } =>
          if opp.fabric == need.fabric && shape_covers(offered: opp.offers, needed: shape) {
            Bound { opportunity: opp }
          } else {
            acc
          }
      }
  )
}

data example_fabric: Fabric = "ci-fleet"

data example_small_program: Program = Program {
  id: "small-prog",
  hard: HardRequirements { threads: 4 },
  prefers: ProgramPreference { preferred_tag: none },
}

data example_large_program: Program = Program {
  id: "large-prog",
  hard: HardRequirements { threads: 64 },
  prefers: ProgramPreference { preferred_tag: none },
}

data example_opportunity: Opportunity = Opportunity {
  fabric: example_fabric,
  offers: Shape { hard: HardRequirements { threads: 128 } },
  tag: "srv1",
}

data example_small_opportunity: Opportunity = Opportunity {
  fabric: example_fabric,
  offers: Shape { hard: HardRequirements { threads: 8 } },
  tag: "srv1",
}

data example_pref_program: Program = Program {
  id: "pref-prog",
  hard: HardRequirements { threads: 2 },
  prefers: ProgramPreference { preferred_tag: Present { value: "srv1" } },
}

data example_pref_miss_opportunity: Opportunity = Opportunity {
  fabric: example_fabric,
  offers: Shape { hard: HardRequirements { threads: 64 } },
  tag: "srv2",
}

fn witness_need_is_only_fabric_plus_program() -> Bool {
  let need = ComputeNeed { fabric: example_fabric, program: example_small_program }
  need.program.hard.threads == 4
}

fn witness_shape_is_derived_from_program() -> Bool {
  let small_shape = derive_shape(p: example_small_program)
  let large_shape = derive_shape(p: example_large_program)
  small_shape.hard.threads != large_shape.hard.threads
}

fn witness_fabric_binds_need_to_opportunity() -> Bool {
  let need = ComputeNeed { fabric: example_fabric, program: example_small_program }
  match connect(need: need, opportunities: [example_opportunity]) {
    Bound { opportunity: _ } => true
    Pending => false
    Unmet { reason: _ } => false
  }
}

fn witness_exec_and_ci_are_just_programs() -> Bool {
  let exec_prog = Program {
    id: "exec-cmd",
    hard: HardRequirements { threads: 4 },
    prefers: ProgramPreference { preferred_tag: none },
  }
  let ci_job = Program {
    id: "ci-job",
    hard: HardRequirements { threads: 4 },
    prefers: ProgramPreference { preferred_tag: none },
  }
  let need_exec = ComputeNeed { fabric: example_fabric, program: exec_prog }
  let need_ci = ComputeNeed { fabric: example_fabric, program: ci_job }
  match connect(need: need_exec, opportunities: [example_opportunity]) {
    Bound { opportunity: _ } =>
      match connect(need: need_ci, opportunities: [example_opportunity]) {
        Bound { opportunity: _ } => true
        Pending => false
        Unmet { reason: _ } => false
      }
    Pending => false
    Unmet { reason: _ } => false
  }
}

fn witness_hard_requirement_unmet_is_unmet() -> Bool {
  let big_need = ComputeNeed { fabric: example_fabric, program: example_large_program }
  let hard_unmet = connect(need: big_need, opportunities: [example_small_opportunity])
  let pref_need = ComputeNeed { fabric: example_fabric, program: example_pref_program }
  let pref_bound = connect(need: pref_need, opportunities: [example_pref_miss_opportunity])
  match hard_unmet {
    Unmet { reason: _ } =>
      match pref_bound {
        Bound { opportunity: _ } => true
        Pending => false
        Unmet { reason: _ } => false
      }
    Bound { opportunity: _ } => false
    Pending => false
  }
}
