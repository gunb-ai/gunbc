module test.claim.fn_index_attribution_probe

// THE INSTRUMENT FOR gunbc.rung_drop.determinism_transitive_reachability, NAMED BY THAT ROW SO ITS
// FIGURES ARE RE-DERIVED RATHER THAN TRANSCRIBED (DESIGN §6). Run it as
//   claim_batch --source-root dag --source-root src/v2 --source-root scratch-probe
//     --entry scratch-probe/test/claim/fn_index_attribution_probe.dag --functions <the six below>
// which charges each arm separately, and read the differences between arms rather than any arm's
// absolute value.
//
// IT LIVES IN scratch-probe BECAUSE IT IS AN INSTRUMENT AND NOT A FLOOR WITNESS. These rows assert
// only non-emptiness; they establish nothing about the corpus and must never be read as coverage.
//
// AND THAT HOME CARRIES AN EXPOSURE. scratch-probe is reached by no source root, no scan dir and no
// row other than the one above, so this module sits OUTSIDE EVERY COMPILED CLOSURE: a renamed
// builtin or a changed signature rots it with no red anywhere. WHY THAT IS NOT DISCHARGED HERE, AND
// WHEN THIS MODULE DIES, are both stated in that row and are deliberately not restated here -- one
// fact, one home. THE ONE THING A READER OF THIS FILE MUST ACT ON: if the row sent you, RUN THIS
// FIRST and repair it if it has rotted, before quoting any finding that depends on it, because
// those findings are only as live as the thing that re-derives them.
// What they are for is the SHAPE of the cost, which is why each arm is chosen to differ from its
// neighbour in exactly one term.
//
// THE ARMS, AND WHAT EACH DIFFERENCE ISOLATES. a is the acquisition alone. b is the closure list
// alone. c adds the reachability walk over the same pool and closure, so c minus a is the walk. d
// adds the determinism fold over the reached set, so d minus c is the fold -- and that difference
// is the one that refuted the fold as a candidate cause.
//
// f IS THE ARM THAT SEPARATES THE FIT FROM THE MECHANISM, and it is the one neither gunbc#10744
// nor gunbc#10753 ran. It holds the entry and the CLOSURE fixed at the lens modules while
// enlarging ONLY the candidate pool. That the reached set is therefore identical to c's is the
// premise the whole discrimination rests on, and it is MEASURED by arm g and reported by
// reached_sizes below -- never argued from the fact that the walk is bounded by the closure,
// which is a true statement about a different subject than what a given run enumerated. If cost tracks the pool the walk was handed, f
// rises against c with the reached set unchanged; if cost tracks what the walk REACHES, the two
// agree. e is f's own acquisition, so f can be netted against its own pool rather than against a's.
//
// WHAT A RE-DERIVER MUST PIN AND THIS PROBE DOES NOT: whether each arm re-pays its acquisition or
// is served from a cross-witness share. Until that is pinned the arm differences are directional
// and the ratios are not quotable as exact.

import v2.lens.determinism { determinism_transitive_holds }
import v2.lens.module_graph { module_declaration_facts_live }
import v2.std.algebra { fold_list, length, list_snoc_item }
import v2.std.collection { List }
import v2.std.fn_index { FnArrowDecl, call_reachable_decls, fn_arrow_decl_facts_live }
import v2.std.integer { integer_int_to_decimal_string }
import v2.std.logic { Bool }
import v2.std.text { String }

data lens_roots: List<String> = ["src/v2/lens"]
data lens_plus_std_roots: List<String> = ["src/v2/lens", "src/v2/std"]
data no_files: List<String> = []
data entry: String = "v2.lens.affected_set"
data no_modules: List<String> = []
data no_terminals: List<String> = []

fn closure_of(roots: List<String>) -> List<String> {
  fold_list(
    xs: module_declaration_facts_live(pool_roots: roots),
    empty: no_modules,
    cons: fn(acc, fact) { list_snoc_item(xs: acc, item: fact.module) }
  )
}

fn decls_of(roots: List<String>) -> List<FnArrowDecl> {
  fn_arrow_decl_facts_live(pool_roots: roots, pool_files: no_files)
}

test fn a_acquisition_only() -> Bool {
  length(xs: decls_of(roots: lens_roots)) > 0
}

test fn b_closure_only() -> Bool {
  length(xs: closure_of(roots: lens_roots)) > 0
}

test fn c_walk_only() -> Bool {
  length(xs: call_reachable_decls(
    entry_module: entry,
    terminal_callee_symbols: no_terminals,
    closure_modules: closure_of(roots: lens_roots),
    decls: decls_of(roots: lens_roots)
  )) > 0
}

test fn d_walk_plus_findings() -> Bool {
  determinism_transitive_holds(
    entry_module: entry,
    closure_modules: closure_of(roots: lens_roots),
    decls: decls_of(roots: lens_roots)
  )
}

test fn e_acquisition_only_bigger_pool() -> Bool {
  length(xs: decls_of(roots: lens_plus_std_roots)) > 0
}

test fn f_walk_only_bigger_pool_same_closure() -> Bool {
  length(xs: call_reachable_decls(
    entry_module: entry,
    terminal_callee_symbols: no_terminals,
    closure_modules: closure_of(roots: lens_roots),
    decls: decls_of(roots: lens_plus_std_roots)
  )) > 0
}

// g MEASURES THE PREMISE THAT c-vs-f RESTS ON, RATHER THAN ARGUING IT. The discrimination is only
// about the pool if the two walks REACH the same set; that the closure bounds the walk is a true
// fact about a different subject than what a given run actually enumerated. So this arm runs both
// walks and compares the two reached-set SIZES directly: it is GREEN only when enlarging the pool
// changed nothing about what was reached, and RED -- loudly, and before any repair is built on it
// -- if any part of the c-to-f difference is reach rather than pool.
test fn g_reached_sets_agree_across_pools() -> Bool {
  length(xs: call_reachable_decls(
    entry_module: entry,
    terminal_callee_symbols: no_terminals,
    closure_modules: closure_of(roots: lens_roots),
    decls: decls_of(roots: lens_roots)
  )) == length(xs: call_reachable_decls(
    entry_module: entry,
    terminal_callee_symbols: no_terminals,
    closure_modules: closure_of(roots: lens_roots),
    decls: decls_of(roots: lens_plus_std_roots)
  ))
}

// reached_sizes REPORTS THE TWO SIZES g COMPARES, so a reader gets the number and not only the
// verdict. Run it with `gunbc run --function reached_sizes` over the same three source roots.
func reached_sizes() -> String {
  concat(
    concat("small_pool_reached=", integer_int_to_decimal_string(value: length(xs: call_reachable_decls(
      entry_module: entry,
      terminal_callee_symbols: no_terminals,
      closure_modules: closure_of(roots: lens_roots),
      decls: decls_of(roots: lens_roots)
    )))),
    concat(" big_pool_reached=", integer_int_to_decimal_string(value: length(xs: call_reachable_decls(
      entry_module: entry,
      terminal_callee_symbols: no_terminals,
      closure_modules: closure_of(roots: lens_roots),
      decls: decls_of(roots: lens_plus_std_roots)
    ))))
  )
}
