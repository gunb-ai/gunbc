   class_bounded: NewEscapeHatchOrAdmissionRow,
   condition_authored_before_enqueue: "The deletion follow-up PR is authored before the carrier is enqueued; otherwise eligibility fails as ConditionOneUnmetAtEligibility." as NonEmptyStr,
