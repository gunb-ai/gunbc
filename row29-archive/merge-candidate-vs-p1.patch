+// THE REFUSAL STAYS REFUSAL: with the base pre-flight in front of the diff, an unresolvable base
+// must still end in a refusal arm and never in `UnifiedDiffOk`. Which refusal arm it is, and
+// whether it names the base, is pinned by the pure witnesses below (the diff runners reach git,
+// and a witness does not hold git).
 test fn witness_invalid_base_fails_closed() -> Bool {
   match floor_run_git_diff_unified(base: "__gunbc_invalid_diff_base__", head: "HEAD", mode: DiffMergeBase) {
     UnifiedDiffFail { reason: _ } => true
+    UnifiedBaseRefUnresolvable { base_ref: _, reason: _ } => true
