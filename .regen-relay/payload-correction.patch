+// Exact arity refuses an authored zero-parameter Optional owner at the literal producer.
+data optional_owner_arity_source: String = "module probe_optional_owner_arity\nimport std.types { Int }\ntype Optional = Present { value: Int } | Absent\nfn asks() -> Optional { none }\n"
+
+test fn optional_owner_arity_refuses() -> Bool {
+  match census_blocking_count_for_class(census: compile_dag_diagnostic_census(optional_owner_arity_source), wanted: "TypeArgumentArityMismatch") {
+    Present { value: n } => n > 0
+    Absent => false
+  }
+}
