+data optional_literal_pattern_preserves_argument_source: String = "module probe_optional_literal_pattern\nimport std.types { Int, Bool, List }\nimport v2.std.optional { Optional, Present, Absent }\ntype Item { children: List<Int> }\nfn asks() -> Bool {\n let candidate: Optional<Item> = none\n match candidate { Present { value: chosen } => count(chosen.children) == 0 Absent => true }\n}\n"
+
+test fn optional_literal_pattern_preserves_argument() -> Bool {
+  callback_compiles_clean(source: optional_literal_pattern_preserves_argument_source)
