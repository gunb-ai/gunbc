+
+data generic_variant_pattern_preserves_argument_source: String = "module probe_generic_variant_pattern\nimport std.types { Int, Bool, List }\ntype Item { children: List<Int> }\ntype Choice<T> = Got { value: T } | Missing\nfn asks() -> Bool {\n let candidate = Got { value: Item { children: [1] } }\n match candidate { Got { value: chosen } => count(chosen.children) == 1 Missing => false }\n}\n"
+
+test fn generic_variant_pattern_preserves_argument() -> Bool {
+  callback_compiles_clean(source: generic_variant_pattern_preserves_argument_source)
+}
