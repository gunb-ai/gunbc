+module test.claim.ownership_branch_read_witness_test
+
+import std.types { Bool }
+import v1.compiler.ownership { BindingUsage, EdgeClassification, OwnershipProof, Read, Consumed, Projected, max_usage_by_fan_out, build_movable_set }
+
+// Consumer: build_movable_set at the branch join; this executes the lower-fan-out Read RED.
+test fn branch_read_survives_larger_projection_path() -> Bool {
+  let read_path = BindingUsage { name: "item", binding_kind: none, consumers: [EdgeClassification { kind: Consumed, site: "return", span_start: 1 }, EdgeClassification { kind: Read, site: "read", span_start: 2 }] }
+  let projection_path = BindingUsage { name: "item", binding_kind: none, consumers: [EdgeClassification { kind: Consumed, site: "return", span_start: 1 }, EdgeClassification { kind: Projected, site: ".a", span_start: 3 }, EdgeClassification { kind: Projected, site: ".b", span_start: 4 }] }
+  let joined = max_usage_by_fan_out(a: read_path, b: projection_path)
+  let proof = OwnershipProof { func_name: "fixture", bindings: map_insert(empty_map(), "item", joined), decisions: [], fold_acc_unwrap: [] }
+  set_contains(build_movable_set(proof: proof, param_names: set_insert(empty_set(), "item")), "item") == false
+}
+
+// Consumer: the same move decision retains Projected-before-Consumed without whole-value Read.
+test fn projected_before_consumed_stays_movable() -> Bool {
+  let usage = BindingUsage { name: "item", binding_kind: none, consumers: [EdgeClassification { kind: Projected, site: ".a", span_start: 1 }, EdgeClassification { kind: Consumed, site: "return", span_start: 2 }] }
+  let proof = OwnershipProof { func_name: "fixture", bindings: map_insert(empty_map(), "item", max_usage_by_fan_out(a: usage, b: usage)), decisions: [], fold_acc_unwrap: [] }
+  set_contains(build_movable_set(proof: proof, param_names: set_insert(empty_set(), "item")), "item")
+}
+
+// Consumer: the existing conservative whole-read contract also holds after a repeated join.
+test fn whole_read_then_consume_stays_non_movable() -> Bool {
+  let usage = BindingUsage { name: "item", binding_kind: none, consumers: [EdgeClassification { kind: Read, site: "read", span_start: 1 }, EdgeClassification { kind: Consumed, site: "return", span_start: 2 }] }
+  let joined = max_usage_by_fan_out(a: usage, b: usage)
+  let proof = OwnershipProof { func_name: "fixture", bindings: map_insert(empty_map(), "item", joined), decisions: [], fold_acc_unwrap: [] }
+  set_contains(build_movable_set(proof: proof, param_names: set_insert(empty_set(), "item")), "item") == false
+}
