module tprobe.r3_list_push_typed_init

import std.types { String, Int, Bool, List, NonEmptyStr }
import std.list { distinct_by_key, duplicated_by_key }
import std.algebra { list_push, list_map, FreeMonoid }

fn probe_case(seed: List<NonEmptyStr>) -> Int {
  let pushed = list_push(seed, "a" as NonEmptyStr)
  let reveal: Int = pushed
  count(pushed)
}
