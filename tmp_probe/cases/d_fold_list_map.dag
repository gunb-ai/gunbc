module tprobe.d_fold_list_map

import std.types { String, Int, Bool, List, NonEmptyStr }
import std.list { distinct_by_key, duplicated_by_key, list_map }
import std.algebra { fold, list_push }
import std.io { filesystem_listing_entry_names }

fn probe_case(names: List<String>) -> List<String> {
  let keys = fold(names, init: [], f: (acc, n) => acc |> list_push(n as NonEmptyStr))
  list_map(xs: keys, f: fn(k) { k as String })
}
