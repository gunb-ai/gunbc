# gunbc .gitignore — generated from gunbc.repo_workspace via gunbc.gitignore_emit — do not hand-edit.
#
# Every pattern is declared by its producer (an extdeps product's workspace footprint, or a repo tool's own declaration) with its meaning and a typed ignore reason; the trailing section is derived from gunbc.generated_artifact commit policy.

# --- Cargo build artifacts [cited: doc.rust-lang.org/cargo/] ---
# regenerable from committed source — cargo build output tree (compiled artifacts, incremental state)
/target/
# regenerable from committed source — cargo build output tree (compiled artifacts, incremental state)
/target-codex/
# local cache; not project state — CARGO_HOME registry/cache; may include git checkouts
/.cargo-home/

# --- Coverage reports (cargo-tarpaulin) [cited: github.com/xd009642/tarpaulin] ---
# regenerable from committed source — HTML coverage report (--out Html)
tarpaulin-report.html
# regenerable from committed source — JSON coverage report (--out Json)
tarpaulin-report.json
# regenerable from committed source — Cobertura XML coverage report (--out Xml)
cobertura.xml
# regenerable from committed source — LCOV coverage report (--out Lcov)
lcov.info
# regenerable from committed source — repo-chosen coverage output directory
/coverage/

# --- JetBrains IDE project state [cited: jetbrains.com/idea] ---
# per-developer state; not shared — per-project IDE workspace configuration
.idea/

# --- VS Code workspace state [cited: code.visualstudio.com] ---
# per-developer state; not shared — per-folder workspace settings
.vscode/

# --- Vim editor state [cited: vim.org] ---
# per-developer state; not shared — swap file for an open buffer
*.swp
# per-developer state; not shared — secondary swap file
*.swo

# --- Emacs backup convention [cited: gnu.org/software/emacs] ---
# per-developer state; not shared — backup of an edited file
*~

# --- macOS Finder metadata [cited: developer.apple.com (Finder metadata)] ---
# host OS metadata; not project state — Finder folder-view metadata
.DS_Store

# --- Windows Explorer cache [cited: microsoft.com (Explorer thumbnail cache)] ---
# host OS metadata; not project state — Explorer thumbnail cache
Thumbs.db

# --- tmux pipe-pane session logs [cited: github.com/tmux/tmux (pipe-pane)] ---
# session/runtime state; not source-of-truth — captured pane output from a local session
tmux-*.log

# --- Secrets and local config [cited: github.com/motdotla/dotenv] ---
# may contain secrets; never committed — environment-specific configuration, commonly secrets
.env
# may contain secrets; never committed — local override of .env
.env.local
# may contain secrets; never committed — per-environment local overrides
.env.*.local

# --- npm installed dependency tree [cited: docs.npmjs.com/cli/configuring-npm/folders] ---
# regenerable from committed source — installed packages materialized from the lockfile
node_modules/

# --- CPython bytecode cache [cited: python.org/peps/pep-3147] ---
# regenerable from committed source — PEP 3147 per-directory bytecode cache
__pycache__/
# regenerable from committed source — compiled bytecode (legacy layout)
*.pyc

# --- Codegen bin symlink [owner: gunbc.repo_workspace] ---
# regenerable from committed source — symlink to target/release created by codegen
/bin/

# --- Generator stamp files [owner: gunbc.generated_artifact] ---
# regenerable from committed source — producer-centric generator stamps
.*-stamp

# --- Workflow runtime state [owner: v2.workflow.required_floor] ---
# session/runtime state; not source-of-truth — local execution ledger and config
/.gunbc/

# --- testgen outputs [owner: v1.10_test] ---
# regenerable from committed source — tests generated by testgen; not source-of-truth
src/v1/10_test/generated-tests/src/generated/

# --- Claude Code session state [cited: code.claude.com] ---
# session/runtime state; not source-of-truth — per-clone agent session state
.claude/

# --- Stage0 regeneration temp dirs [owner: v1_compiler.required_regen_host] ---
# regenerable from committed source — regen input snapshot
.regen-sources/
# regenerable from committed source — regen emitted candidate
.regen-output/
# regenerable from committed source — regen generated source root
.regen-generated-source-root/
# regenerable from committed source — staleness-check scratch tree
.freshness-check/

# --- Interactive auth/session transcripts [owner: gunbc.auth.credentials] ---
# may contain secrets; never committed — interactive auth transcript; may contain OAuth URLs or session state
out.txt

# --- OpenClaw workspace artifacts [owner: gunbc.repo_workspace] ---
# session/runtime state; not source-of-truth — OpenClaw control dir; the control plane lives in ~/ctrl, not this repo
/.openclaw/
# session/runtime state; not source-of-truth — OpenClaw agent roster projection
/AGENTS.md
# session/runtime state; not source-of-truth — OpenClaw heartbeat projection
/HEARTBEAT.md
# session/runtime state; not source-of-truth — OpenClaw identity projection
/IDENTITY.md
# session/runtime state; not source-of-truth — OpenClaw soul projection
/SOUL.md
# session/runtime state; not source-of-truth — OpenClaw tools projection
/TOOLS.md
# session/runtime state; not source-of-truth — OpenClaw user projection
/USER.md
# session/runtime state; not source-of-truth — OpenClaw workboard projection
/WORKBOARD.md
# session/runtime state; not source-of-truth — OpenClaw-managed scripts dir
/scripts/openclaw/

# --- v2 compiler inspect output [owner: gunbc.repo_workspace] ---
# session/runtime state; not source-of-truth — v2 compiler inspect output
.v2-inspect
# session/runtime state; not source-of-truth — v2 compiler inspect error output
.v2-inspect-errors.txt

# --- GitHub CLI local cache [owner: gunbc.repo_workspace] ---
# local cache; not project state — local gh API response cache (dashboard tooling)
.gh-cache/

# --- Python local dev scripts [owner: gunbc.repo_workspace] ---
# outside the committed substrate — local dev tooling only; never committed to the .dag/.rs substrate
*.py

# --- Generic editor backup files [cited: cross-editor backup convention] ---
# per-developer state; not shared — editor backup copy
*.bak

# --- claim-corpus execution-map output [owner: v1_compiler.cli_run] ---
# regenerable from committed source — claim execution map output
.claim-map/
# session/runtime state; not source-of-truth — scratch probe written by manual claim runs
src/v2/test/claim/manual/sg2_scratch_probe.dag

# --- Superseded planning scratch directories [owner: gunbc.plan] ---
# superseded; canonical home: docs/plans/ (generated PlanArtifact) and DESIGN.md — pre-plan-carrier planning scratch
/gunbc-planning/
# superseded; canonical home: docs/plans/ (generated PlanArtifact) and DESIGN.md — pre-plan-carrier fixture scratch
/scripts/fixtures/

