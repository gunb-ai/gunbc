# gunbc .gitignore — generated from dsl/gunbc/gitignore_authority.dag — do not hand-edit.
#
# Rule: Ignore anything that is (a) reproducible from committed source-of-truth files, or (b) environment-specific and not shared across developers.

# --- Cargo build artifacts (from cargo) ---
# Reproducible from source via cargo build
/target/
/target-codex/

# --- Cargo cache (local CARGO_HOME) (from tool/rust) ---
# Local Cargo cache may include git checkouts; not project state
/.cargo-home/

# --- Codegen bin symlink (from codegen) ---
# Symlink to target/release created by codegen
/bin/

# --- Coverage reports (from cargo-tarpaulin) ---
# Generated, often large, reproducible
tarpaulin-report.html
tarpaulin-report.json
cobertura.xml
lcov.info
coverage/

# --- Editor/IDE state (from editor) ---
# Per-developer configuration, not project state
.idea/
.vscode/
*.swp
*.swo
*.bak
*~

# --- OS metadata (from os) ---
# OS-generated, not project state
.DS_Store
Thumbs.db
tmux-*.log

# --- Secrets and local config (from secrets) ---
# Environment-specific, may contain secrets
.env
.env.local
.env.*.local

# --- Generator stamp files (from generators) ---
# Producer-centric model stamps
.*-stamp

# --- Workflow runtime state (from workflow) ---
# Local execution ledger and config; not source-of-truth
/.gunbc/

# --- testgen outputs (from testgen) ---
# Generated by testgen; not source-of-truth
src/v1/10_test/generated-tests/src/generated/

# --- Node.js (from npm) ---
# Not part of this project
node_modules/

# --- Claude Code session state ---
.claude/

# --- Stage0 regeneration temp dirs ---
.regen-sources/
.regen-output/
.regen-generated-source-root/
.freshness-check/

# --- Interactive auth/session transcripts ---
# Should never be committed; may contain OAuth URLs or session state
out.txt

# --- OpenClaw workspace artifacts ---
# The OpenClaw control plane lives in ~/ctrl, not in this repo
/.openclaw/
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md
/WORKBOARD.md
/scripts/openclaw/
.v2-inspect
.v2-inspect-errors.txt

# --- GitHub CLI local cache (dashboard / gh API) ---
.gh-cache/

# --- Python (local dev-only scripts; never committed to the .dag/.rs substrate) ---
*.py
__pycache__/
*.pyc

# --- claim-corpus execution-map output ---
.claim-map/
src/v2/compiler/manual/sg2_scratch_probe.dag
