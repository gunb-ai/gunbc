# gunbc .gitignore — generated from dag/gunbc/gitignore_authority.dag — do not hand-edit.
#
# Rule: Ignore anything that is (a) reproducible from committed source-of-truth files, or (b) environment-specific and not shared across developers.

# --- Cargo build artifacts (from cargo) ---
# Reproducible from source via cargo build
/target/
/target-codex/

# --- Cargo cache (local CARGO_HOME) (from tool/rust) ---
# Local Cargo cache may include git checkouts; not project state
/.cargo-home/

# --- Codegen bin symlink (from codegen) ---
# Symlink to target/release created by codegen
/bin/

# --- Coverage reports (from cargo-tarpaulin) ---
# Generated, often large, reproducible
tarpaulin-report.html
tarpaulin-report.json
cobertura.xml
lcov.info
coverage/

# --- JetBrains IDE project state [cited: jetbrains.com/idea] ---
# Per-developer configuration, not project state
.idea/

# --- VS Code workspace state [cited: code.visualstudio.com] ---
# Per-developer configuration, not project state
.vscode/

# --- Vim editor state [cited: vim.org] ---
# Per-developer configuration, not project state
*.swp
*.swo

# --- Emacs backup convention [cited: gnu.org/software/emacs] ---
# Per-developer configuration, not project state
*~

# --- Generic editor backup files [cited: cross-editor backup convention] ---
# Per-developer configuration, not project state
*.bak

# --- macOS Finder metadata [cited: developer.apple.com (Finder metadata)] ---
# OS-generated, not project state
.DS_Store

# --- Windows Explorer cache [cited: microsoft.com (Explorer thumbnail cache)] ---
# OS-generated, not project state
Thumbs.db

# --- tmux terminal multiplexer logs [cited: github.com/tmux/tmux (pipe-pane log naming)] ---
# Session log; not project state
tmux-*.log

# --- Secrets and local config [cited: github.com/motdotla/dotenv] ---
# Environment-specific, may contain secrets
.env
.env.local
.env.*.local

# --- Generator stamp files (from generators) ---
# Producer-centric model stamps
.*-stamp

# --- Workflow runtime state (from workflow) ---
# Local execution ledger and config; not source-of-truth
/.gunbc/

# --- testgen outputs (from testgen) ---
# Generated by testgen; not source-of-truth
src/v1/10_test/generated-tests/src/generated/

# --- Node.js [cited: github/gitignore/Node.gitignore] ---
# Not part of this project
node_modules/

# --- Claude Code session state ---
.claude/

# --- Stage0 regeneration temp dirs ---
.regen-sources/
.regen-output/
.regen-generated-source-root/
.freshness-check/

# --- Interactive auth/session transcripts ---
# Should never be committed; may contain OAuth URLs or session state
out.txt

# --- OpenClaw workspace artifacts ---
# The OpenClaw control plane lives in ~/ctrl, not in this repo
/.openclaw/
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md
/WORKBOARD.md
/scripts/openclaw/
.v2-inspect
.v2-inspect-errors.txt

# --- GitHub CLI local cache (dashboard / gh API) ---
.gh-cache/

# --- Python local dev scripts ---
# Python is used only for local dev tooling; never committed to the .dag/.rs substrate
*.py
!docs/plans/witness-subject-execution-audit.py

# --- CPython bytecode cache (PEP 3147) [cited: python.org/peps/pep-3147] ---
__pycache__/
*.pyc

# --- claim-corpus execution-map output ---
.claim-map/
src/v2/test/claim/manual/sg2_scratch_probe.dag

# --- Superseded planning scratch directories (canonical home: docs/plans/ or DESIGN.md) ---
# Superseded by docs/plans/ (generated PlanArtifact) and DESIGN.md/ROADMAP.md as canonical authorities
/gunbc-planning/
/scripts/fixtures/

# --- Generated artifacts (gitignored-by-default, derived from generated_artifact_registry) ---
# Regenerable; not committed. Whitelist: ci.yml, .gitignore, .md docs (ROADMAP.md, DESIGN.md, docs/plans/).
/.github/fleet-runner-deploy.manifest
/provisioning/srv3/user-data
.witness_tmp/
.witness_namespace_import_closure/
