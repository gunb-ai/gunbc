  witness_dc_population_is_unresolved_not_invented,
  witness_every_feature_is_datumed,
  witness_grip_to_board_web_survives_minimum,
  witness_lift_holds_are_bolted_and_never_feet,
  witness_selected_hold_is_gated_not_deleted,
  witness_cleat_seating_is_legible,
  witness_shape_is_irregular_only_where_nothing_is_measured,
  witness_power_budget_closes,
  witness_branch_circuits_carry_the_ceiling,
  witness_48v_distribution_beats_12v_on_conductor,
  witness_rejected_rear_fixed_fork_stays_measurable,
  witness_depth_is_derived_and_liquid_is_not_shallow,
  witness_no_scenario_claims_zero_fans,
  witness_preset_crossings_derive_correctly,
