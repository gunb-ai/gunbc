data machine_tile_witness_expected_count: Int = 20

fn machine_tile_roster_all_green() -> Bool {
  all(machine_tile_witness_outcomes, o => o.passed)
}

fn machine_tile_roster_count_matches() -> Bool {
  count(machine_tile_witness_outcomes) == machine_tile_witness_expected_count
}

fn machine_tile_roster_names_are_unique() -> Bool {
  all(
    machine_tile_witness_outcomes,
    o => count(filter(machine_tile_witness_outcomes, p => p.name == o.name)) == 1,
  )
}

fn machine_tile_roster_failing_names() -> List<NonEmptyStr> {
  machine_tile_witness_outcomes |> filter(o => !o.passed) |> map(o => o.name)
}

// The receipt: the expected number of witnesses ran, each exactly once under its own name, and
// every body returned true. Stronger than seventeen separate green exit codes, which cannot detect
// an eighteenth witness that was never invoked.
test fn witness_machine_tile_roster_is_complete_unique_and_green() -> Bool {
  machine_tile_roster_count_matches()
    && machine_tile_roster_names_are_unique()
    && machine_tile_roster_all_green()
}

// A PROCESS-EXIT ENTRY POINT, so this witness is runnable by the actuator on the same terms as
// every other row. gunbc run REFUSES to map a Bool to an exit code -- printing the value and
// exiting 0 would report success for a run whose outcome is unknown -- so a roster witness with no
// ProcessExit main cannot be executed by CI at all, which is how the machine tile roster sat green and
// unrun. The verdict is the roster's own, unchanged; only the carrier is new.
fn machine_tile_witness_main() -> ProcessExit {
  if witness_machine_tile_roster_is_complete_unique_and_green() { ExitSuccess } else { ExitFailure { code: 1, reason: "witness_machine_tile_roster_is_complete_unique_and_green returned false" } }
}
