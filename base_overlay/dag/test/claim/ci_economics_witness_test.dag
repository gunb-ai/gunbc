  "witness_unbalanced_builds_strand_what_they_paid_for",
  "witness_build_choice_moves_revenue_capex_and_break_even",
  "witness_cheapest_and_densest_are_both_worse_per_unit",
  "witness_memory_price_curve_has_a_cliff",
  "witness_rates_are_assumed_not_contracted",
  "witness_frontier_drops_only_dominated_candidates",
  "witness_split_fleet_trades_capex_for_machines",
  "witness_site_fixed_cost_is_allocated_exactly_once",
  "witness_actual_margin_is_impossible_today",
  "witness_customer_alpha_is_not_operator_margin",
  "witness_comparison_refuses_a_missing_rate",
  "witness_unpriced_business_costs_stay_named",
]

// One entry that calls every witness body, because the interpreter pays a fixed multi-minute
// module-index cost per process and eighteen separate runs would pay it eighteen times.
test fn ci_economics_witness_roster_is_complete_and_green() -> Bool {
  count(ci_economics_witness_names) == 18
    && witness_missing_offer_refuses_and_is_never_free()
    && witness_duplicate_identity_refuses_and_catalog_is_clean()
    && witness_architecture_gate_holds_both_ways()
    && witness_shared_cpu_cannot_serve_a_guaranteed_tier()
    && witness_spill_route_differs_by_job_shape()
    && witness_experimental_and_foreign_rows_are_not_spendable()
    && witness_unbalanced_builds_strand_what_they_paid_for()
    && witness_build_choice_moves_revenue_capex_and_break_even()
    && witness_cheapest_and_densest_are_both_worse_per_unit()
    && witness_memory_price_curve_has_a_cliff()
    && witness_rates_are_assumed_not_contracted()
    && witness_frontier_drops_only_dominated_candidates()
    && witness_split_fleet_trades_capex_for_machines()
    && witness_socket_mismatch_refuses()
    && witness_habitability_splits_platforms()
    && witness_levies_applied()
    && witness_site_fixed_cost_is_allocated_exactly_once()
    && witness_actual_margin_is_impossible_today()
    && witness_customer_alpha_is_not_operator_margin()
    && witness_comparison_refuses_a_missing_rate()
    && witness_unpriced_business_costs_stay_named()
    && witness_receipt_surface_branches_on_sku_basis()
    && witness_live_receipt_surface_matches_selected_basis()
    && witness_receipt_remains_customer_visible()
}

// ---------------------------------------------------------------------------------------------
// THE PROJECTION JOIN. PR #6 ruled the first SKU MeteredExecutionOnly and stated the refused claim
// in the carrier; the customer-facing surface went on saying reuse was the product for five days,
// because it AUTHORED that sentence instead of DERIVING it. The repair makes the surface a function
// of the ruling, and these controls are what keep the function from being collapsed back into a
// constant.
//
// NOTE ON WHAT IS NOT WITNESSED HERE. "receipt_why equals receipt_customer_why(the live basis)" is
// true by construction now - there is no second authority left to disagree with - so asserting it
// would be permanently green and would be cited as coverage while carrying no information (DESIGN
// section 4b). The controls below are the ones whose RED is authorable: collapse either match to a
// single arm, or re-author the customer sentence as a literal, and they fail.
// ---------------------------------------------------------------------------------------------

// CONTROL. The customer-facing receipt description must actually BRANCH on the pricing basis. If
// someone collapses receipt_customer_why to one arm - which is exactly how the drift happened the
// first time - the two bases render identically and this goes red.
test fn witness_receipt_surface_branches_on_sku_basis() -> Bool {
  let metered = receipt_customer_why(b: MeteredExecutionOnly { basis: "probe", refused_claim: "probe" })
  let structural = receipt_customer_why(b: StructuralWorkElimination { basis: "probe", evidence: "probe" })
  let note_metered = receipt_internal_note(b: MeteredExecutionOnly { basis: "probe", refused_claim: "probe" })
  let note_structural = receipt_internal_note(b: StructuralWorkElimination { basis: "probe", evidence: "probe" })
  metered != structural && note_metered != note_structural
}

// CONTROL. Under the basis actually selected today, the live customer surface must be the metered
// arm and not the structural one. This is the assertion that would have caught the original defect:
// it joins the shipped sentence to the ruling rather than reading either alone.
test fn witness_live_receipt_surface_matches_selected_basis() -> Bool {
  let expected = receipt_customer_why(b: first_runner_sku_pricing_basis)
  let structural = receipt_customer_why(b: StructuralWorkElimination { basis: "probe", evidence: "probe" })
  receipt_why == expected && receipt_why != structural
}

// CONTROL. The receipt stays a customer-visible attribute. The repair changed what it SAYS; it must
// not have quietly demoted the receipt off the customer surface, which would have been a different
// and worse way to resolve the contradiction.
test fn witness_receipt_remains_customer_visible() -> Bool {
  is_customer_visible(s: attr_receipt.side)
}

fn econ_flag(b: Bool) -> NonEmptyStr { if b { "pass" } else { "FAIL" } }

fn economics_frontier_report() -> NonEmptyStr {
  join([
    "frontier_drops_only_dominated=", econ_flag(b: witness_frontier_drops_only_dominated_candidates()),
    " system_lots_honest=", econ_flag(b: witness_system_lots_enter_frontier_honestly()),
    " split_trades=", econ_flag(b: witness_split_fleet_trades_capex_for_machines()),
    " rates_assumed=", econ_flag(b: witness_rates_are_assumed_not_contracted()),
    " receipt_branches=", econ_flag(b: witness_receipt_surface_branches_on_sku_basis()),
    " receipt_matches_basis=", econ_flag(b: witness_live_receipt_surface_matches_selected_basis()),
    " receipt_visible=", econ_flag(b: witness_receipt_remains_customer_visible()),
  ], "")
}

// The band claim, restated over the scenario aggregate rather than the deleted Bool: the
// provisional selection must not be dominated in every declared scenario.
fn frontier_holds_across_the_band() -> Bool {
  match band_standing(c: candidate_q64_32) {
    FrontierAtEveryScenario { receipts } => true
    ScenarioSensitive { frontier_at, dominated_at } => true
    DominatedAtEveryScenario { receipts } => false
    BandStandingUnestablished { receipts } => false
  }
}

fn economics_frontier_main() -> ProcessExit {
  let report = economics_frontier_report()
  let all_pass = witness_frontier_drops_only_dominated_candidates()
    && witness_system_lots_enter_frontier_honestly()
    && witness_split_fleet_trades_capex_for_machines()
    && witness_socket_mismatch_refuses()
    && witness_habitability_splits_platforms()
    && witness_levies_applied()
    && witness_rates_are_assumed_not_contracted()
    && witness_receipt_surface_branches_on_sku_basis()
    && witness_live_receipt_surface_matches_selected_basis()
    && witness_receipt_remains_customer_visible()
  if all_pass { ExitSuccess } else { ExitFailure { code: 1, reason: report } }
}

// ONE SKU, THREE DECIMAL GB, AND THE FOUR-GB UNIT IS REVOKED RATHER THAN SHADOWED. The
// conversions are checked at the two edges where binary and decimal meet: 3 GiB is 3.22e9 bytes,
// one unit and change, never two; 76 units need 228e9 bytes = 212.4 GiB, so 213 rounded up.
test fn witness_one_sellable_unit_at_three_decimal_gb() -> Bool {
  let one_core = ci_sellable_unit.cores_per_unit == 1
  let revoked_names_this = revoked_four_gb_unit.revoked_on == ci_sellable_unit.effective_from
  let only_admission = second_sku_needs_a_dramatically_different_market(c: ci_sellable_unit)
  let floors = units_by_memory_gib(gib: 3) == 1 && units_by_memory_gib(gib: 6) == 2
  let ceils = required_memory_gib_ceiling_for_units(units: 76) == 213
  one_core && revoked_names_this && only_admission && floors && ceils
}

// THE LARGEST OFFERED SHAPE IS WHAT A NODE EXPOSES, NOT A SECOND SKU. A one-socket Q80 node cannot
// host the 128-unit shape; the menu filtered by that node stops at 64.
test fn witness_the_128_unit_shape_is_not_hostable_on_a_one_socket_q80() -> Bool {
  let per_node = sellable_units(c: candidate_r12spd_q80_32)
  let hostable = hostable_unit_counts(offered: [2, 4, 8, 16, 32, 64, 128], sellable_units_per_node: per_node)
  per_node < 128
    && !shape_is_hostable(units: 128, sellable_units_per_node: per_node)
    && shape_is_hostable(units: 64, sellable_units_per_node: per_node)
    && count(hostable) == 6
}
