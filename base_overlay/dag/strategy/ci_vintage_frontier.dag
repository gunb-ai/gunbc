  id: "gaming-9950x-1u",
  description: "Ryzen 9 9950X 1U on an AM5 server board (BMC + ECC UDIMM): 16c/32t Zen 5 at 5.7 GHz boost. Charitable best-case readings throughout - the Blacksmith-inferred vintage as its strongest self.",
  equivalence: EquivalenceBenchmarkEstimated { planning_equiv_per_node: 70, obligation: "benchmark-chained equivalence has no declared spread: 70 equivalents is 32 threads x ~2.2, a charitable BEST-CASE reading chosen by operator direction rather than measured, and a best case read as a point is the narrowest possible interval over an unmeasured quantity" },
  power: PowerPlanningEstimated { planning_watts: 280, obligation: "the 280 W wall figure is the charitable BEST-CASE reading chosen by operator direction, unmetered on this workload - a best case read as a point is the narrowest possible interval over an unmeasured quantity" },
  rack_units_per_node: 1,
  single_thread: SingleThreadEstimated { planning_index_micro: 3400000, obligation: "the 3.4x single-thread index is the charitable best-case reading of a 5.7 GHz Zen 5 core against the reference, unmeasured on this workload" },
  capex: VintageCapexIncompleteBom { obligation: "no grounded capex region: the memo 4b BOM bands the CPU at 500-560, the board at 430 and DDR5 ECC at 550-700, but the NVMe and the 1U chassis/cooler/PSU carry no figure at all, so the parts that ARE banded cannot be summed into a total. The 2.2k row read every band at its favourable end and then dropped the unpriced lines, which is a best case presented as a reading" },
}

