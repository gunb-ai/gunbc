module strategy.ci_vintage_frontier

import std.types { Int, List, NonEmptyStr, Bool }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, decl_ref }
import std.interval { degenerate_interval, closed_interval, IntervalReady, IntervalRefused }
import std.pareto {
  AxisGoal, LowerIsBetter, HigherIsBetter,
  SelectionAxis, AxisReading, AxisGap, ParetoEntry, ParetoStanding,
  ProvisionallyNonDominated, DominatedBy, NotComputable, PendingEvidence, SelectionRefused,
  entry_standing, pareto_label,
}

// THE VINTAGE-GRAIN FRONTIER (seeded from docs/strategy/2026-08-29-blacksmith-gaming-cpu-
// comparison.md sections 4e-4g; operator direction 2026-08-29: "make sure to add all of
// these options" to the Pareto selection).
//
// GRAIN, and why this is not ci_build_frontier. That module compares BUILDABLE
// CONFIGURATIONS of observed facts - boards, processor lots, DIMM lots with marketplace
// rates - on the DDR4/Altra spine, and its generator grows by fact rows. The options this
// module carries are HARDWARE VINTAGES, most of which cannot be a NodeBuildCandidate yet:
// the gaming node needs an AM5 board/DDR5-lot fact population that extdeps does not carry,
// and AmpereOne and Bergamo have NO liquidation market at all - their capex is not a
// missing rate but a market that has not happened. Comparing vintages at planning grade,
// with the unpurchasable ones held incomparable by their own declaration, is exactly what
// the std.pareto missing-inputs discipline is for. When a vintage becomes buildable
// (facts land in extdeps), it graduates into the ci_node_build generator and its row here
// becomes provenance.
//
// THE UNIT. Readings are denominated in ALTRA-EQUIVALENTS: one equivalent is the loaded
// throughput of one Altra Q80-30 core at 3.0 GHz. Cross-ISA throughput equivalence is a
// modelling estimate chained from public benchmark readings (memo section 4e: the 1T gap
// decomposes as clock x IPC; SMT sharing costs each sibling thread ~35-40%), NOT a
// measurement - which is why every entry carries the benchmark obligation in its
// sensitivities and the section-5 pilot's realized-throughput measurement retires it.

// ---------------------------------------------------------------------------------------------
// AXES. Identity is structural per the std.pareto ruling; display strings are presentation.
// Four funded axes carry the operator's "efficient in all dimensions" objective - capex,
// power, space - plus the single axis the gaming vintage exists for. Liquidity/ops axes
// (supply depth, firmware openness, parts liquidity) remain sensitivities, not readings.
// ---------------------------------------------------------------------------------------------

data axis_capex_per_equiv_id: DeclarationRef = decl_ref(module_path: "strategy.ci_vintage_frontier", decl_name: "axis_capex_per_equiv_id")
data axis_watts_per_equiv_id: DeclarationRef = decl_ref(module_path: "strategy.ci_vintage_frontier", decl_name: "axis_watts_per_equiv_id")
data axis_single_thread_id: DeclarationRef = decl_ref(module_path: "strategy.ci_vintage_frontier", decl_name: "axis_single_thread_id")
data axis_equiv_per_ru_id: DeclarationRef = decl_ref(module_path: "strategy.ci_vintage_frontier", decl_name: "axis_equiv_per_ru_id")

data axis_capex_per_equiv: SelectionAxis = SelectionAxis { identity: axis_capex_per_equiv_id, goal: LowerIsBetter }
data axis_watts_per_equiv: SelectionAxis = SelectionAxis { identity: axis_watts_per_equiv_id, goal: LowerIsBetter }
data axis_single_thread: SelectionAxis = SelectionAxis { identity: axis_single_thread_id, goal: HigherIsBetter }
data axis_equiv_per_ru: SelectionAxis = SelectionAxis { identity: axis_equiv_per_ru_id, goal: HigherIsBetter }

// The full axis set: the efficiency dimensions plus latency.
data vintage_axes: List<SelectionAxis> = [
  axis_capex_per_equiv,
  axis_watts_per_equiv,
  axis_single_thread,
  axis_equiv_per_ru,
]

// The AGENT-BUYER axis set (memo section 4f): wall-clock premium is a human-attention
// artifact, so an agent-denominated demand book un-funds the single-thread axis and the
// selection runs on efficient capacity alone. Both sets are carried because the demand mix
// is an open empirical question (JobInitiatorClass on the billing receipt answers it);
// which axis set is THE selection is a demand fact, not a modelling choice.
data agent_buyer_axes: List<SelectionAxis> = [
  axis_capex_per_equiv,
  axis_watts_per_equiv,
  axis_equiv_per_ru,
]

data vintage_sensitivities: List<NonEmptyStr> = [
  "throughput equivalence: every equivalent-count is a benchmark-chained estimate, never a measurement - the section-5 pilot's realized throughput on a representative workload retires it and could move any verdict here",
  "single-thread under load: the gaming index is quoted charitably at the lightly-occupied best case; at full SMT occupancy it sags toward ~2x an Altra core, which narrows its one winning axis",
  "supply and liquidation state: Altra is deep and cheap today, the gaming node is retail-infinite, AmpereOne and Bergamo have no liquidation market yet - a numeric axis cannot carry this and the purchase gates in ci_node_build own it",
  "ops and parts liquidity: NDA-gated Altra firmware versus retail-everywhere AM5 parts is unpriced on any axis (memo section 4c); it runs in the gaming vintage's favour and is the strongest argument the frontier cannot see",
  "memory platform cost: equivalents price the CPU, but DDR5 RDIMMs across 8 channels can exceed a liquidated CPU's price (memo section 4g) - the balanced-point lesson of ci_node_build will bind harder on AmpereOne and Bergamo than a per-equiv capex axis shows",
  "power price and site admission: watts-per-equiv is site-neutral here, but section 4e's ruling is per-site - where admitted watts bind, this axis dominates the selection; where a colo sells watts by the kW, it is ~5% of runner revenue",
]

// ---------------------------------------------------------------------------------------------
// CANDIDATES. Planning-grade rows seeded from the memo; each figure names its provenance in
// the note. Capex is a standing, not a number: a vintage without a market carries the watch
// obligation instead of a guessed price, and that alone holds it incomparable.
// ---------------------------------------------------------------------------------------------

// THREE ROWS CARRIED "OBSERVED" CAPEX AND NOT ONE OF THEM WAS A QUOTE. Milan's note says
// "band (2-3k); memo 4f table midpoint" - a declared band already collapsed to its middle. Gaming's
// note is a BOM of component RANGES read at their favourable ends, with the NVMe and the 1U
// chassis/cooler/PSU never quantified at all. Mt. Jade's is derived at planning rates that include
// ci_node_build's own 32-GiB DIMM band. The old scalar could not tell those apart from a quote;
// interval_micro can, so each one now says what it actually is.
type VintageCapex
  = VintageCapexBanded { low_usd_micro: Int, high_usd_micro: Int, note: NonEmptyStr }
  | VintageCapexAwaitingSharedScenario { obligation: NonEmptyStr }
  | VintageCapexIncompleteBom { obligation: NonEmptyStr }
  | VintageAwaitingLiquidation { watch_obligation: NonEmptyStr }

// THE EQUIVALENCE IS THE DIVISOR UNDER THREE OF THE FOUR AXES, so its evidence grade decides
// theirs. It was a bare Int, which let a grounded capex band be divided by an unbounded benchmark
// estimate and emerge as an interval that LOOKS like evidence while carrying only the numerator's
// width. One row is the definition of the unit and is exact; the rest are benchmark-chained
// planning figures with no declared spread, and an unbounded divisor does not yield a region at
// all - so those axes are not computable for those rows, which is a located missing input rather
// than a narrower interval than the evidence supports.
type EquivalenceEvidence
  = EquivalenceByDefinition { equiv_per_node: Int, note: NonEmptyStr }
  | EquivalenceBenchmarkEstimated { planning_equiv_per_node: Int, obligation: NonEmptyStr }

// The single-thread index is the same shape: a ratio against the reference core.
// POWER IS EVIDENCE-GRADED FOR THE SAME REASON EQUIVALENCE IS, and missing this was the sharpest
// finding on review 5091375040. Altra's equivalence is exact BY DEFINITION of the unit, so
// per_equiv_readings funded its axes -- and the numerator it divided was the old bare-Int watts
// field carrying 350, a figure the row's own description calls a loaded PLANNING number. An exact
// divisor cannot launder an estimated numerator: the quotient is no better than its worst input,
// and a degenerate [350,350] asserted a wall measurement nobody took.
//
// It was not deciding today's field only because Altra is separately blocked on capex, so this was a
// point that becomes load-bearing the moment the capex debt is discharged -- a latent wrong answer
// with a scheduled arrival date, which is worse than an active one for being invisible now.
type PowerEvidence
  = PowerMeasured { watts: Int, note: NonEmptyStr }
  | PowerPlanningEstimated { planning_watts: Int, obligation: NonEmptyStr }

type SingleThreadEvidence
  = SingleThreadByDefinition { index_micro: Int }
  | SingleThreadEstimated { planning_index_micro: Int, obligation: NonEmptyStr }

type VintageCandidate {
  id: NonEmptyStr
  description: NonEmptyStr
  equivalence: EquivalenceEvidence
  power: PowerEvidence
  rack_units_per_node: Int
  single_thread: SingleThreadEvidence
  capex: VintageCapex
}

data altra_mt_jade_vintage: VintageCandidate = VintageCandidate {
  id: "altra-mt-jade",
  description: "2P Altra Q80-30 Mt. Jade 2U: 160 physical cores at 3.0 GHz, the owned reference vintage. 350 W loaded planning figure, ~3.5k loaded node (2k barebones + 16x 32GiB DDR4). Single-thread index 1.0 by definition of the unit.",
  equivalence: EquivalenceByDefinition { equiv_per_node: 160, note: "the reference vintage DEFINES the Altra-equivalent unit: 160 physical cores at 3.0 GHz counted one-for-one. This is exact by construction of the unit, not a benchmark estimate" },
  power: PowerPlanningEstimated { planning_watts: 350, obligation: "the 350 W loaded figure is a PLANNING number, called that in this row's own description: a budgeting figure for a 2P Q80-30 chassis, not a wall reading taken at the socket on our workload. The equivalence divisor being exact by definition does not ground it" },
  rack_units_per_node: 2,
  single_thread: SingleThreadByDefinition { index_micro: 1000000 },
  capex: VintageCapexAwaitingSharedScenario { obligation: "no grounded capex region: the 3.5k figure is derived at PLANNING rates - a 2k barebones planning figure plus sixteen 32-GiB modules priced from ci_node_build's declared 80-to-120 band. That band is a SHARED market parameter, not this candidate's own width, so it cannot be collapsed into a per-row interval here without recreating the correlation loss corrected in ci_build_frontier. It funds when the memory-price scenario is threaded across modules, which is deliberately not done in this cut" },
}

data milan_7713_vintage: VintageCandidate = VintageCandidate {
  id: "milan-7713-quiet-4u",
  description: "1P EPYC Milan 7713 quiet 4U tower: 64c/128t Zen 3, the admitted x86 candidate (Aug-09 doc section 6). ~100 Altra-equivalents loaded, ~300 W wall, ~2.5k built. Single-thread ~1.5x an Altra core.",
  equivalence: EquivalenceBenchmarkEstimated { planning_equiv_per_node: 100, obligation: "benchmark-chained equivalence has no declared spread: the ~100 Altra-equivalents for a 64c/128t Milan is a benchmark-chained planning figure (Aug-09 doc section 6) stated as a single approximate number with no bounds. Every per-equivalent axis divides by it, so an unbounded divisor leaves those axes not computable for this row - including the capex-per-equivalent axis whose 2-3k NUMERATOR is genuinely grounded" },
  power: PowerPlanningEstimated { planning_watts: 300, obligation: "the ~300 W wall figure for the quiet Milan tower is a stated approximation (Aug-09 doc section 6) with no metered receipt and no bounds" },
  rack_units_per_node: 4,
  single_thread: SingleThreadEstimated { planning_index_micro: 1500000, obligation: "the ~1.5x single-thread ratio against an Altra core is a stated approximation with no benchmark receipt and no bounds" },
  capex: VintageCapexBanded { low_usd_micro: 2000000000, high_usd_micro: 3000000000, note: "Aug-09 doc section 6 quiet-Milan-tower band, carried as the 2-3k band the source actually states rather than the midpoint the memo 4f table took. This is genuine candidate-local width: it is this build's own quoted spread, not a market parameter shared with any other row, so an interval is the right carrier and the overlap it creates is real uncertainty rather than discarded correlation" },
}

// CHARITABLE BEST CASE by operator direction 2026-08-29: assume Blacksmith's node is the
