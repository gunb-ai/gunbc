data vintage_candidates: List<VintageCandidate> = [
  altra_mt_jade_vintage,
  milan_7713_vintage,
  gaming_9950x_vintage,
  ampereone_a160_vintage,
  bergamo_9754_vintage,
]

// ---------------------------------------------------------------------------------------------
// THE PROJECTION. Per-equiv figures are derived from the node figures so a row edit moves
// every reading together; a missing capex market yields a missing input, never a guess.
// ---------------------------------------------------------------------------------------------

data no_vintage_readings: List<AxisReading> = []
data no_vintage_missing: List<AxisGap> = []

fn one_vintage_missing(axis: DeclarationRef, text: NonEmptyStr) -> List<AxisGap> {
  [AxisGap { axis: axis, cause: text }]
}

// THE EQUIVALENCE GAP EXCUSES THREE AXES, AND THIS MODULE ALREADY SAID SO IN PROSE. The comment
// below has always stated that every per-equivalent axis divides by the equivalence, so none can be
// funded more strongly than it -- but with a flat gap list there was nowhere to say WHICH axes that
// was, and the standing collapsed to "incomparable" without recording the reasoning. The
// single-thread axis does not divide by the equivalence and is deliberately absent from this list:
// its reading is independently grounded, so an estimated equivalence gives it no gap.
//
// That is the whole claim, and the earlier text overstated it as "perfectly comparable". No partial
// comparison proceeds on a surviving axis: entry_standing returns NotComputable for ANY nonempty
// missing_inputs, so while the candidate carries the other three gaps its single-thread reading
// buys no comparison at all. What the omission buys is that the single-thread axis is not blamed
// for a shortfall that is not its own.
data per_equivalent_axes: List<DeclarationRef> = [axis_capex_per_equiv_id, axis_watts_per_equiv_id, axis_equiv_per_ru_id]

fn gap_on_each(axes: List<DeclarationRef>, text: NonEmptyStr) -> List<AxisGap> {
  fold(axes, init: [], f: fn(acc, ax) { concat(acc, [AxisGap { axis: ax, cause: text }]) })
}

fn le_int(a: Int, b: Int) -> Bool { a <= b }

// EVERY PER-EQUIVALENT AXIS DIVIDES BY THE EQUIVALENCE, so none of them can be funded more
// strongly than it. The divisor is exact only for the row that DEFINES the unit; everywhere else
// it is a benchmark-chained planning number with no declared spread, and there is no interval
// arithmetic that rescues that - an unbounded divisor does not produce a bounded quotient, so the
// axis is not computable for that row and says so by name. This is the reviewer's correction: a
// grounded 2-3k capex NUMERATOR over an unbounded divisor was emerging as an interval that looked
// like evidence while carrying only the numerator's width.
fn equivalence_divisor(c: VintageCandidate) -> Int {
  match c.equivalence {
    EquivalenceByDefinition { equiv_per_node, note } => equiv_per_node
    EquivalenceBenchmarkEstimated { planning_equiv_per_node, obligation } => planning_equiv_per_node
  }
}

fn equivalence_is_exact(c: VintageCandidate) -> Bool {
  match c.equivalence {
    EquivalenceByDefinition { equiv_per_node, note } => true
    EquivalenceBenchmarkEstimated { planning_equiv_per_node, obligation } => false
  }
}

fn equivalence_missing(c: VintageCandidate) -> List<AxisGap> {
  match c.equivalence {
    EquivalenceByDefinition { equiv_per_node, note } => no_vintage_missing
    EquivalenceBenchmarkEstimated { planning_equiv_per_node, obligation } =>
      gap_on_each(axes: per_equivalent_axes, text: obligation)
  }
}

fn power_watts(c: VintageCandidate) -> Int {
  match c.power {
    PowerMeasured { watts, note } => watts
    PowerPlanningEstimated { planning_watts, obligation } => planning_watts
  }
}

fn power_is_grounded(c: VintageCandidate) -> Bool {
  match c.power {
    PowerMeasured { watts, note } => true
    PowerPlanningEstimated { planning_watts, obligation } => false
  }
}

fn power_missing(c: VintageCandidate) -> List<AxisGap> {
  match c.power {
    PowerMeasured { watts, note } => no_vintage_missing
    PowerPlanningEstimated { planning_watts, obligation } =>
      one_vintage_missing(axis: axis_watts_per_equiv_id, text: obligation)
  }
}

fn watts_per_equiv_micro(c: VintageCandidate) -> Int {
  power_watts(c: c) * 1000000 / equivalence_divisor(c: c)
}

fn equiv_per_ru_micro(c: VintageCandidate) -> Int {
  equivalence_divisor(c: c) * 1000000 / c.rack_units_per_node
}

// THE TWO DERIVED AXES NO LONGER SHARE AN EVIDENCE GRADE, and the note that said they did was true
// only while both had exactly one input. watts-per-equivalent divides POWER by the equivalence
// divisor and so needs BOTH grounded; equivalents-per-RU divides that same divisor by an exact
// chassis height and needs only the divisor. Gating them together would refuse an axis whose inputs
// are actually established -- the fail-shut mirror of the fail-open this whole cut is removing, and
// no more honest for erring the other way.
fn per_equiv_readings(c: VintageCandidate) -> List<AxisReading> {
  let watts_axis = if equivalence_is_exact(c: c) && power_is_grounded(c: c) {
    [AxisReading { axis: axis_watts_per_equiv_id, interval_micro: degenerate_interval(point: watts_per_equiv_micro(c: c)) }]
  } else { no_vintage_readings }
  let ru_axis = if equivalence_is_exact(c: c) {
    [AxisReading { axis: axis_equiv_per_ru_id, interval_micro: degenerate_interval(point: equiv_per_ru_micro(c: c)) }]
  } else { no_vintage_readings }
  concat(watts_axis, ru_axis)
}

fn single_thread_readings(c: VintageCandidate) -> List<AxisReading> {
  match c.single_thread {
    SingleThreadByDefinition { index_micro } =>
      [AxisReading { axis: axis_single_thread_id, interval_micro: degenerate_interval(point: index_micro) }]
    SingleThreadEstimated { planning_index_micro, obligation } => no_vintage_readings
  }
}

fn single_thread_missing(c: VintageCandidate) -> List<AxisGap> {
  match c.single_thread {
    SingleThreadByDefinition { index_micro } => no_vintage_missing
    SingleThreadEstimated { planning_index_micro, obligation } =>
      one_vintage_missing(axis: axis_single_thread_id, text: obligation)
  }
}

fn base_readings(c: VintageCandidate) -> List<AxisReading> {
  concat(per_equiv_readings(c: c), single_thread_readings(c: c))
}

// THE BAND DIVIDES BY THE EQUIVALENCE AT BOTH ENDS, and the division is monotone in the numerator,
// so where the divisor is EXACT the capex-per-equivalent region is exactly the image of the capex
// region. Where it is not, the band funds nothing here however grounded the numerator is. A refused
// construction becomes a declared gap rather than a repaired point: reversed endpoints would mean
// the source band was authored backwards, and answering anyway would hide it.
fn banded_capex_reading(c: VintageCandidate, low_usd_micro: Int, high_usd_micro: Int) -> List<AxisReading> {
  if equivalence_is_exact(c: c) {
    match closed_interval(low: low_usd_micro / equivalence_divisor(c: c), high: high_usd_micro / equivalence_divisor(c: c), le: le_int) {
      IntervalReady { interval } => [AxisReading { axis: axis_capex_per_equiv_id, interval_micro: interval }]
      IntervalRefused { reason } => no_vintage_readings
    }
  } else { no_vintage_readings }
}

fn banded_capex_missing(c: VintageCandidate, low_usd_micro: Int, high_usd_micro: Int) -> List<AxisGap> {
  if equivalence_is_exact(c: c) {
    match closed_interval(low: low_usd_micro / equivalence_divisor(c: c), high: high_usd_micro / equivalence_divisor(c: c), le: le_int) {
      IntervalReady { interval } => no_vintage_missing
      IntervalRefused { reason } => one_vintage_missing(axis: axis_capex_per_equiv_id, text: join(["capex band is unusable: ", reason], ""))
    }
  } else {
    one_vintage_missing(axis: axis_capex_per_equiv_id, text: "capex-per-equivalent is not computable although the capex band itself is grounded: the divisor is an unbounded benchmark estimate, so the quotient has no bounded region. The numerator is not the blocker and grounding it further will not fund this axis")
  }
}

fn vintage_readings(c: VintageCandidate) -> List<AxisReading> {
  match c.capex {
    VintageCapexBanded { low_usd_micro, high_usd_micro, note } =>
      concat(base_readings(c: c), banded_capex_reading(c: c, low_usd_micro: low_usd_micro, high_usd_micro: high_usd_micro)),
    VintageCapexAwaitingSharedScenario { obligation } => base_readings(c: c),
    VintageCapexIncompleteBom { obligation } => base_readings(c: c),
    VintageAwaitingLiquidation { watch_obligation } => base_readings(c: c),
  }
}

fn capex_missing(c: VintageCandidate) -> List<AxisGap> {
  match c.capex {
    VintageCapexBanded { low_usd_micro, high_usd_micro, note } =>
      banded_capex_missing(c: c, low_usd_micro: low_usd_micro, high_usd_micro: high_usd_micro),
    VintageCapexAwaitingSharedScenario { obligation } => one_vintage_missing(axis: axis_capex_per_equiv_id, text: obligation),
    VintageCapexIncompleteBom { obligation } => one_vintage_missing(axis: axis_capex_per_equiv_id, text: obligation),
    VintageAwaitingLiquidation { watch_obligation } => one_vintage_missing(axis: axis_capex_per_equiv_id, text: watch_obligation),
  }
}

fn vintage_missing(c: VintageCandidate) -> List<AxisGap> {
  concat(concat(concat(equivalence_missing(c: c), single_thread_missing(c: c)), capex_missing(c: c)), power_missing(c: c))
}

// A GAP IS RELATIVE TO THE AXES BEING COMPARED, AND THIS MODULE COMPARES UNDER TWO SETS.
//
// A candidate's gaps are computed once, per candidate; funding is decided per COMPARISON. This
// module runs the same rows under vintage_axes and again under agent_buyer_axes, which drops
// single-thread -- so the single-thread gap, perfectly correct under the first set, names an axis
// the second one does not fund. std.pareto refuses exactly that: "a gap must name a funded axis or
// it excuses and blocks nothing". The refusal is right. A gap on an unfunded axis is not evidence
// of anything, and letting it stand would let an irrelevant absence block a comparison it has no
// bearing on -- the very failure the axis-scoping was introduced to end.
//
// Before gunbc#10150 this could not even be noticed: gaps carried no axis, so the single-thread
// obligation was indistinguishable from the capex one and both blocked both comparisons.
//
// The entry is therefore built against the axis set it will be compared under, and the readings are
// left alone -- std.pareto ignores a reading on an unfunded axis, while a GAP on one is a
// contradiction, so only the gaps need scoping.
// A GENERIC INTERSECTION WAS THE WRONG SHAPE, AND IT SILENCED THE WALL IT WAS MEANT TO RESPECT.
//
// The first version kept a gap when its axis appeared in the comparison roster and dropped it
// otherwise. That treats the INTENDED omission of one known axis exactly like a typo or a foreign
// identity: std.pareto refuses a gap naming an axis the selection does not fund, and an
// intersection deletes the offending row before Pareto can ever see it. The check would have been
// permanently green by construction -- a decoration, and worse than absent because this module
// would have been cited as respecting it.
//
// The projection is therefore typed and names the one axis it drops. Every other gap survives,
// INCLUDING one naming an axis outside this module's vocabulary, so a mis-authored gap stays loud
// and reaches the refusal that exists for it.
fn without_axis(gaps: List<AxisGap>, drop: DeclarationRef) -> List<AxisGap> {
  fold(gaps, init: [], f: fn(acc, g) {
    if declaration_ref_eq(a: g.axis, b: drop) { acc } else { concat(acc, [g]) }
  })
}

fn vintage_entry_with(c: VintageCandidate, gaps: List<AxisGap>) -> ParetoEntry {
  ParetoEntry {
    identity: decl_ref(module_path: "strategy.ci_vintage_frontier", decl_name: c.id),
    display_label: c.id,
    readings: vintage_readings(c: c),
    missing_inputs: gaps,
  }
}

fn vintage_entry(c: VintageCandidate) -> ParetoEntry {
  vintage_entry_with(c: c, gaps: vintage_missing(c: c))
}

// THE AGENT-BUYER COMPARISON DROPS SINGLE-THREAD AND NOTHING ELSE. It is the one axis that does not
// divide by the equivalence, so it is the one gap that names an axis this comparison stops funding.
fn agent_buyer_entry(c: VintageCandidate) -> ParetoEntry {
  vintage_entry_with(c: c, gaps: without_axis(gaps: vintage_missing(c: c), drop: axis_single_thread_id))
}

data no_vintage_entries: List<ParetoEntry> = []

fn agent_buyer_entries() -> List<ParetoEntry> {
  fold(vintage_candidates, init: no_vintage_entries, f: fn(acc, c) { concat(acc, [agent_buyer_entry(c: c)]) })
}

fn vintage_standing(c: VintageCandidate) -> ParetoStanding {
  standing_in_field(c: c, field: vintage_candidates)
}

// The production projector over an explicit field. The live roster and a fixture roster go through
// exactly the same path, so a control that plants a challenger is exercising the real seam rather
// than a test-only re-implementation of it.
fn standing_in_field(c: VintageCandidate, field: List<VintageCandidate>) -> ParetoStanding {
  entry_standing(
    subject: vintage_entry(c: c),
    field: fold(field, init: no_vintage_entries, f: fn(acc, x) { concat(acc, [vintage_entry(c: x)]) }),
    axes: vintage_axes,
    sensitivities: vintage_sensitivities,
  )
}

fn vintage_standing_label(c: VintageCandidate) -> NonEmptyStr {
  pareto_label(s: vintage_standing(c: c))
}

// The same field under the agent-buyer axis set: single-thread un-funded.
fn agent_buyer_standing(c: VintageCandidate) -> ParetoStanding {
  entry_standing(subject: agent_buyer_entry(c: c), field: agent_buyer_entries(), axes: agent_buyer_axes, sensitivities: vintage_sensitivities)
}

// The prior note asserted "under the full set every observed vintage survives" and "the Altra build
// dominates the gaming node under the agent-buyer set". Both conclusions rested on capex POINTS that
// no source supports, so they are retracted here rather than left standing beside the corrected
// model - a note that keeps asserting what the evidence no longer carries is the same false claim in
// prose instead of in a reading.
data frontier_reading_note: NonEmptyStr = "What the two axis sets say together, at planning grade with the sensitivities attached: Milan is the only vintage carrying a grounded capex region (its stated 2-3k band), and it survives the full set. Mt. Jade and the gaming node are NotComputable on capex BY THEIR OWN DECLARATION - Mt. Jade because its figure is derived at planning rates including the shared 32-GiB memory band, the gaming node because its BOM prices neither the NVMe nor the chassis/cooler/PSU - and the unliquidated successors are incomparable for want of a liquidation market. RETRACTED, and named so it is not quietly missed: the earlier reading that every observed vintage survives, and that the Altra build dominates the charitably-read gaming node once single-thread is un-funded. That second claim IS the operator's thesis (wall-clock premium is a human-attention artifact) stated as a selection fact, and it is UNFUNDED rather than refuted - agent_buyer_axes still funds capex, so a missing capex genuinely blocks the comparison. It returns when the two capex obligations below are discharged; the demand-mix measurement (JobInitiatorClass on billing receipts) then decides which axis set the business actually faces."

// VintageCapexDebt WAS HERE AND IS DELETED (2026-09-02). It was a three-arm coproduct whose arms
// mapped ONE-TO-ONE onto VintageCapex's - grounded, ungrounded, awaiting-market - with the payloads
// dropped. That is one concept under two names, and the second name was strictly weaker: the
// obligations are the part that says WHEN each debt dissolves, and the projection threw them away.
//
// The review asked for the two ungrounded rows to carry distinct arms, because Mt. Jade's capex funds
// when the shared memory scenario is threaded across modules while the gaming row's funds when two
// unpriced BOM lines are quoted. Those really are different debts with different triggers - and the
// distinction already existed, in the obligation strings this renaming discarded. So the fix is to
// delete the renaming and read c.capex directly, not to widen a type that should not exist.
fn capex_is_a_grounded_band(c: VintageCandidate) -> Bool {
  match c.capex {
    VintageCapexBanded { low_usd_micro, high_usd_micro, note } => true
    VintageCapexAwaitingSharedScenario { obligation } => false
    VintageCapexIncompleteBom { obligation } => false
    VintageAwaitingLiquidation { watch_obligation } => false
  }
}

fn agent_buyer_flip_is_fundable() -> Bool {
  capex_is_a_grounded_band(c: altra_mt_jade_vintage) && capex_is_a_grounded_band(c: gaming_9950x_vintage)
}
