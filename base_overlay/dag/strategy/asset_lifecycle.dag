module strategy.asset_lifecycle

import std.types { Int, List, NonEmptyStr, Bool }

// ASSET LIFECYCLE (operator direction 2026-08-30): every asset in the system - modeled
// part, screw, down to the atom - has a lifecycle, but NOT everything is tracked: the
// tracking grade is DERIVED from what the item is worth and whether it carries data,
// never chosen per-item by taste. The operator's stated center of gravity is the EXIT:
// "companies never handle that process well" - and the diagnosis this module encodes is
// that disposal fails because it is a DEFAULT DRIFT (assets rot idle until they are
// worthless, then leave untyped: tossed, shrunk, lost) rather than a forced, typed,
// deadline-carrying decision. So here: (1) an exit is always one typed arm with its
// evidence; (2) a data-bearing asset cannot exit without sanitization evidence -
// fail-closed, no exceptions arm; (3) the count ledger must conserve - acquired equals
// held plus exited, so shrinkage is a visible refusal, not an inventory surprise; and
// (4) idleness past the grade's floor FORCES a disposition decision - the decision may
// be "hold, re-reviewed at a date", but it may not be silence.

// ---------------------------------------------------------------------------------------------
// Tracking grade - derived, not declared per item.
// ---------------------------------------------------------------------------------------------

type TrackingGrade
  = SerialTracked
  | CountTracked { reorder_floor_units: Int }
  | UntrackedConsumable

// Policy thresholds - declared once, with the reasoning attached. Value drives cost of
// tracking vs cost of loss; data-bearing overrides value entirely (chain of custody is a
// compliance fact, not an economics one).
data serial_floor_micro: Int = 50000000
data count_floor_micro: Int = 1000000

data tracking_policy_note: NonEmptyStr = "Serial tracking above 50 dollars a unit: at that value the loss/mix-up cost exceeds the seconds it takes to record a serial, and every part above it in our fleet (DIMMs at 55, CPUs at 95, drives, servers) already carries a manufacturer serial. Count tracking between 1 and 50 dollars: fungible bins with a reorder floor - the obligation is a LEVEL, not an identity. Below 1 dollar: untracked consumables (screws, cable ties, standoffs) - tracking them costs more than they do, and the honest model is a bin that gets refilled when it looks low. DATA-BEARING OVERRIDES EVERYTHING: any asset that can hold customer or operational data is SerialTracked at any value, because its exit obligation (sanitization evidence) requires an identity to bind the receipt to."

type AssetClassFacts {
  id: NonEmptyStr
  description: NonEmptyStr
  unit_value_micro: Int
  data_bearing: Bool
  reorder_floor_units: Int
}

fn derived_tracking(f: AssetClassFacts) -> TrackingGrade {
  if f.data_bearing {
    SerialTracked
  } else if f.unit_value_micro >= serial_floor_micro {
    SerialTracked
  } else if f.unit_value_micro >= count_floor_micro {
    CountTracked { reorder_floor_units: f.reorder_floor_units }
  } else {
    UntrackedConsumable
  }
}

