// ---------------------------------------------------------------------------------------------
// Exit: every departure is one typed arm carrying its evidence.
// ---------------------------------------------------------------------------------------------

type SanitizationEvidence
  = CryptoEraseReceipt { method: NonEmptyStr, verified_at: NonEmptyStr }
  | PhysicalDestructionReceipt { certificate: NonEmptyStr }
  | NotDataBearing

type ExitChannel
  = ResoldWorking { channel: NonEmptyStr, proceeds_micro: Int }
  | ResoldForParts { channel: NonEmptyStr, proceeds_micro: Int }
  | HarvestedIntoParts { yielded_component_ids: List<NonEmptyStr> }
  | RecycledEwaste { downstream: NonEmptyStr }
  | ReturnedRmaWarranty { reference: NonEmptyStr }
  | WrittenOffLost { investigation_note: NonEmptyStr }

type ExitOutcome
  = ExitAdmitted { asset_id: NonEmptyStr, channel: ExitChannel }
  | ExitRefusedUnsanitized { asset_id: NonEmptyStr }
  | ExitRefusedEvidenceMismatch { asset_id: NonEmptyStr }

// The wall: a data-bearing asset exits only with real sanitization evidence, and a
// non-data-bearing asset must not carry fabricated sanitization (an erase receipt for a
// screw is a lie that would train readers to skim receipts).
fn admit_exit(f: AssetClassFacts, channel: ExitChannel, evidence: SanitizationEvidence) -> ExitOutcome {
  match evidence {
    NotDataBearing =>
      if f.data_bearing { ExitRefusedUnsanitized { asset_id: f.id } }
      else { ExitAdmitted { asset_id: f.id, channel: channel } },
    CryptoEraseReceipt { method, verified_at } =>
      if f.data_bearing { ExitAdmitted { asset_id: f.id, channel: channel } }
      else { ExitRefusedEvidenceMismatch { asset_id: f.id } },
    PhysicalDestructionReceipt { certificate } =>
      if f.data_bearing { ExitAdmitted { asset_id: f.id, channel: channel } }
      else { ExitRefusedEvidenceMismatch { asset_id: f.id } },
  }
}

// ---------------------------------------------------------------------------------------------
// Conservation: acquired == held + exited, per class. Shrinkage is a refusal, never a
// quiet count adjustment - a lost unit exits through WrittenOffLost with its
// investigation note, which is how the ledger stays honest AND the loss stays visible.
// ---------------------------------------------------------------------------------------------

type AssetLedger {
  asset_id: NonEmptyStr
  acquired_units: Int
  held_units: Int
  exited: List<ExitChannel>
}

fn ledger_conserves(l: AssetLedger) -> Bool {
  l.acquired_units == l.held_units + count(l.exited)
}

fn exit_proceeds_micro(c: ExitChannel) -> Int {
  match c {
    ResoldWorking { channel, proceeds_micro } => proceeds_micro,
    ResoldForParts { channel, proceeds_micro } => proceeds_micro,
    HarvestedIntoParts { yielded_component_ids } => 0,
    RecycledEwaste { downstream } => 0,
    ReturnedRmaWarranty { reference } => 0,
    WrittenOffLost { investigation_note } => 0,
  }
}

// The recovery instrument - the number companies never measure. Proceeds per exited unit
// against the class's carried value; the point is to LOOK at it, per channel, so the
// closet-rot pattern (hold until worthless, then scrap at zero) shows up as a falling
// recovery rate instead of a feeling.
fn ledger_recovery_micro(l: AssetLedger) -> Int {
  fold(l.exited, init: 0, f: fn(acc, c) { acc + exit_proceeds_micro(c: c) })
}

// ---------------------------------------------------------------------------------------------
// INTENT: capital deploys against an intent, and the intent is the asset's license to
// stay (operator 2026-08-30: "to buy an item probably requires an intent to use it - an
// item without any living intent needs pressure put on it to liquidate"). Idle-time was
// the first draft's proxy; intent is the real primitive - every holding binds one, every
// intent carries a review date, and the standing DERIVES: a living intent holds, a
// lapsed review forces a re-ruling, and no living intent is standing liquidation
// pressure. "Hold" is a legitimate ruling; silence is not a state the model can express.
// ---------------------------------------------------------------------------------------------

type AssetIntent
  = DeployIntent { target: NonEmptyStr, review_by: NonEmptyStr }
  | SpareFloorIntent { floor_units: Int, review_by: NonEmptyStr }
  | SampleQualificationIntent { note: NonEmptyStr, review_by: NonEmptyStr }
  | ResaleIntent { channel_note: NonEmptyStr, review_by: NonEmptyStr }
  | NoLivingIntent

type DispositionStanding
  = IntentLiving { review_by: NonEmptyStr }
  | ReviewLapsed { review_by: NonEmptyStr }
  | PressureToLiquidate

fn intent_review_by(i: AssetIntent) -> NonEmptyStr {
  match i {
    DeployIntent { target, review_by } => review_by,
    SpareFloorIntent { floor_units, review_by } => review_by,
    SampleQualificationIntent { note, review_by } => review_by,
    ResaleIntent { channel_note, review_by } => review_by,
    NoLivingIntent => "0000-00-00",
  }
}

fn disposition_standing(i: AssetIntent, today: NonEmptyStr) -> DispositionStanding {
  match i {
    NoLivingIntent => PressureToLiquidate,
    DeployIntent { target, review_by } => standing_by_review(review_by: review_by, today: today),
    SpareFloorIntent { floor_units, review_by } => standing_by_review(review_by: review_by, today: today),
    SampleQualificationIntent { note, review_by } => standing_by_review(review_by: review_by, today: today),
    ResaleIntent { channel_note, review_by } => standing_by_review(review_by: review_by, today: today),
  }
}

fn standing_by_review(review_by: NonEmptyStr, today: NonEmptyStr) -> DispositionStanding {
  if review_by < today { ReviewLapsed { review_by: review_by } } else { IntentLiving { review_by: review_by } }
}

// ---------------------------------------------------------------------------------------------
