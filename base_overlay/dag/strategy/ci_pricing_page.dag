fn purchase_gate_banner() -> Fragment {
  match purchase_authorization(c: selected_build) {
    PurchaseAuthorized { receipt } =>
      el_class(tag: "p", cls: "gen", children: [txt(s: join(["Purchase authorized. ", receipt], ""))]),
    PurchaseBlocked { obligations } =>
      el_class(tag: "p", cls: "refused", children: [txt(s: join([
        "PLANNING LAYER ONLY - NOT A PURCHASE ORDER. ", two_layer_note,
        " Before this build can be bought: ", join(obligations, "; "), ".",
      ], ""))]),
  }
}

fn capex_banner() -> Fragment {
  match landed_capex(c: selected_build) {
    LandedCapexResolved { usd_micro, receipt } =>
      el_class(tag: "p", cls: "gen", children: [txt(s: join([
        "Landed capex resolved at ", cp_usd2(micro: usd_micro), ". ", receipt,
      ], ""))]),
    LandedCapexIncomplete { known_subtotal_micro, missing, obligation } =>
      el_class(tag: "p", cls: "refused", children: [txt(s: join([
        "NOT A LANDED COST. Known lines for the selected build total ",
        cp_usd2(micro: known_subtotal_micro), ", covering board, duty reserve, processors and memory. Still unpriced: ",
        join(missing, "; "), ". ", obligation,
      ], ""))]),
  }
}

fn dia_row(dia_micro: Int) -> Fragment {
  let b = selected_build
  el(tag: "tr", children: [
    cp_td_dim(text: join([cp_usd2(micro: dia_micro), " / month"], "")),
    cp_td_dim(text: cp_usd2(micro: site_cost_per_node_micro(a: allocate_site(admitted_nodes: admitted_node_count, dia_micro: dia_micro, node_watts: node_watts())))),
    cp_td_dim(text: cp_signed_permille_text(p: contribution_permille_of(c: contribution(b: b, price_micro: volume_per_unit_minute_micro, utilization_permille: selected_utilization_permille, dia_micro: dia_micro)))),
    cp_td_dim(text: cp_permille_text(p: break_even_permille(b: b, price_micro: volume_per_unit_minute_micro, dia_micro: dia_micro))),
  ])
}

fn dia_table() -> Fragment {
  cp_scrollable(t: el_class(tag: "table", cls: "wide", children: [
    cp_head_row(cells: ["Transit quote", "Modelled cost / node / month", "Volume contribution at 30%", "Break-even use"]),
    el(tag: "tbody", children: map(dia_sensitivity_micro_per_month, d => dia_row(dia_micro: d))),
  ]))
}

fn unpriced_row(u: UnpricedCostLine) -> Fragment {
  el(tag: "tr", children: [cp_td(text: u.label), cp_td(text: u.obligation)])
}

fn unpriced_table() -> Fragment {
  cp_scrollable(t: el(tag: "table", children: [
    cp_head_row(cells: ["Cost", "What is missing"]),
    el(tag: "tbody", children: map(unpriced_site_lines, u => unpriced_row(u: u))),
  ]))
}

// ---------------------------------------------------------------------------------------------
// CONTRIBUTION
// ---------------------------------------------------------------------------------------------

fn contribution_row(b: NodeBuildCandidate, price_micro: Int, tier: String) -> Fragment {
  let dia = dia_planning_micro_per_month
  let rev = node_revenue_per_month_micro(b: b, price_micro: price_micro, utilization_permille: selected_utilization_permille)
  let cost = modelled_cost_per_month_micro(b: b, dia_micro: dia)
  let contrib = contribution_permille_of(c: contribution(b: b, price_micro: price_micro, utilization_permille: selected_utilization_permille, dia_micro: dia))
  el(tag: "tr", children: [
    cp_td(text: join([b.label, ", ", tier], "")),
    cp_td_dim(text: to_string(sellable_units(c: b))),
    cp_td_dim(text: cp_usd2(micro: rev)),
    cp_td_dim(text: cp_usd2(micro: cost)),
    if contrib < 0 { cp_td_warn(text: cp_signed_permille_text(p: contrib)) } else { cp_td_dim(text: cp_signed_permille_text(p: contrib)) },
    cp_td_dim(text: cp_permille_text(p: break_even_permille(b: b, price_micro: price_micro, dia_micro: dia))),
  ])
}

fn contribution_table() -> Fragment {
  cp_scrollable(t: el_class(tag: "table", cls: "widest", children: [
    cp_head_row(cells: ["Build and tier", "Units", "Revenue / month at 30%", "Modelled cost / month", "Contribution", "Break-even use"]),
    el(tag: "tbody", children: concat(
      map(node_build_candidates, b => contribution_row(b: b, price_micro: retail_per_unit_minute_micro, tier: "retail")),
      map(node_build_candidates, b => contribution_row(b: b, price_micro: volume_per_unit_minute_micro, tier: "volume")),
    )),
  ]))
}

fn margin_banner() -> Fragment {
  match margin_standing(b: selected_build, price_micro: volume_per_unit_minute_micro, utilization_permille: selected_utilization_permille) {
    ActualMargin { permille, receipt } =>
      el_class(tag: "p", cls: "gen", children: [txt(s: join([
        "Margin ", cp_permille_text(p: permille), ". ", receipt,
      ], ""))]),
    MarginSensitivity { contribution_permille, low_permille, high_permille, unresolved_inputs, unpriced, caveat } =>
      el_class(tag: "p", cls: "refused", children: [txt(s: join([
        "THIS IS NOT A MARGIN. Selected build at volume pricing contributes ",
        cp_signed_permille_text(p: contribution_permille), " on the planning transit quote, ranging ",
        cp_signed_permille_text(p: low_permille), " to ", cp_signed_permille_text(p: high_permille),
        " across the transit ladder. ", caveat, " Unresolved inputs: ",
        join(unresolved_inputs, "; "), ".",
      ], ""))]),
  }
}

// ---------------------------------------------------------------------------------------------
// PAGE
// ---------------------------------------------------------------------------------------------

data ci_page_standfirst: String = "What CI minutes cost elsewhere, what we would charge, where overflow work actually goes, what a node costs to build, and what is left after the room is paid for. Every figure is computed from the model beneath it. Nothing on this page is a margin."

data unit_definition_note: String = "One unit-minute is one CPU entitlement plus 3 GB (decimal, strategy.ci_sellable_unit) of RAM for one minute. Whichever of CPU and memory runs out first is what a shape can actually deliver, so every row takes the smaller of the two and prints the result. A 2-vCPU box with 4 GiB is one unit, not two: the second vCPU has no memory to work with."

data performance_note: String = "A physical Arm core and an x86 hardware thread are counted as one unit each, and that is deliberately conservative. No benchmark has been run on any route in this table or on our own hardware, so no row is credited with delivering more work per unit than another. A 160-core node is 160 billing units until a benchmark receipt says otherwise, and a higher-performance class would be a separate product with its own price rather than a quiet multiplier on this one."

data build_intro: String = "Cores are cheap and unevenly priced; high-density memory is expensive and on a cliff. The build question is therefore not how many cores fit on a board, it is where those two curves cross the product's own contract of three decimal gigabytes per core (strategy.ci_sellable_unit). Every row below is derived from marketplace listings with dates and quantities attached, and none of them is a purchase authorization."

data alpha_intro: String = "A price under the market is a spread, not an explanation. If the only thing behind the number is cheaper hardware, the advantage lasts until someone else shops the same market. There are seven separate sources here and they are not equally real: four are derived from the model below, three are claims with no measurement behind them, and the largest one is a claim."

// The economics sections as a list, so another page can compose them beside the physical drawings
// without either page owning the other's chrome.
fn pricing_sections() -> List<Fragment> {
  [
      cp_section(label: "The unit", heading: "One core, three gigabytes, one minute.", body: [
        cp_para(text: unit_definition_note),
        cp_note(text: performance_note),
      ]),

      cp_section(label: "Where the alpha lives", heading: "Seven sources, four of them measured.", body: [
        cp_para(text: alpha_intro),
        alpha_table(),
        cp_note(text: alpha_summation_refusal),
        cp_note(text: packing_conclusion_note),
        el(tag: "h3", children: [txt(s: "Work elimination, and why it is not in this SKU")]),
        work_avoided_banner(),
        work_elimination_reach_line(r: internal_work_elimination),
        work_elimination_reach_line(r: saleable_work_elimination),
        work_avoided_measurement_banner(),
        cp_note(text: alpha_reach_note),
        el(tag: "h3", children: [txt(s: "What the customer keeps")]),
        customer_alpha_table(),
        cp_note(text: three_readings_note),
      ]),

      cp_section(label: "The market", heading: "What everyone else charges, normalized.", body: [
        market_table(),
        cp_note(text: ci_product_defaults_note),
        cp_note(text: circleci_caveat_note),
        cp_note(text: namespace_note),
        cp_note(text: price_provenance_note),
      ]),

      cp_section(label: "Our schedule", heading: "Multiplication, not a price list.", body: [
        shape_table(),
        cp_note(text: pricing_position_note),
        cp_note(text: no_free_tier_note),
      ]),

      cp_section(label: "Spill", heading: "Where overflow work goes.", body: [
        spill_table(),
        cp_note(text: spread_naming_note),
        cp_note(text: spill_authority_note),
        cp_note(text: shared_family_note),
        cp_note(text: service_class_note),
        cp_note(text: committed_capacity_note),
      ]),

      cp_section(label: "The build", heading: "The cheapest balanced point, not the most cores.", body: [
        cp_para(text: build_intro),
        el(tag: "h3", children: [txt(s: "The memory market, as observed")]),
        memory_lot_table(),
        cp_note(text: memory_curve_note),
        cp_note(text: memory_band_note),
        el(tag: "h3", children: [txt(s: "The candidate frontier")]),
        packing_table(),
        cp_note(text: frontier_note),
        frontier_axes_banner(),
        cp_note(text: capex_ceiling_note),
        el(tag: "h3", children: [txt(s: "Two smaller nodes, or one dense node")]),
        split_versus_dense_table(),
        cp_note(text: split_versus_dense_note),
        el(tag: "h3", children: [txt(s: "What is still unpriced")]),
        purchase_gate_banner(),
        capex_banner(),
        cp_note(text: duty_reserve_note),
        cp_note(text: processor_market_note),
        cp_note(text: reserve_basis_note),
        cp_note(text: finishing_allowance_note),
        cp_note(text: selection_note),
      ]),

      cp_section(label: "The room", heading: "Rent, transit, power, and how many nodes share them.", body: [
        dia_table(),
        cp_note(text: dia_note),
        cp_note(text: density_note),
        cp_note(text: electricity_tariff_note),
        cp_note(text: cooling_note),
        el(tag: "h3", children: [txt(s: "Costs with no reading at all")]),
        unpriced_table(),
      ]),

      cp_section(label: "Contribution", heading: "What is left, and how little demand it needs.", body: [
        contribution_table(),
        margin_banner(),
        cp_note(text: utilization_note),
      ]),

  ]
}

fn page_body() -> Fragment {
  el_attrs(tag: "div", attributes: [attr(name: "data-generated-by", value: "strategy.ci_pricing_page")], children: [
    el(tag: "style", children: [txt(s: ci_page_css)]),
    el_class(tag: "div", cls: "wrap", children: concat(
      [
        el(tag: "h1", children: [txt(s: "Selling CI minutes.")]),
        el_class(tag: "p", cls: "standfirst", children: [txt(s: ci_page_standfirst)]),
      ],
      concat(pricing_sections(), [
        el(tag: "footer", children: [txt(s: "generated by strategy.ci_pricing_page - no tile cut, no minute sold")]),
      ]))),
  ])
}

fn render_ci_pricing_body() -> String {
  match try_serialize_html_source(node: page_body()) {
    EmitOk { html: h } => h
    EmitRejected { reason: r } => join(["REJECTED: ", r], "")
  }
}

data ci_page_css: String = ":root\{--plaster:#E9E4DA;--ink:#2A2620;--muted:#6E675C;--oak:#A97C3E;--rule:#C8C0B2;--green:#4F7A4A;--alarm:#9C4A38;--alarm-ink:#FFF4F0}\n@media (prefers-color-scheme:dark)\{:root:not([data-theme=\"light\"])\{--plaster:#191713;--ink:#EAE4D8;--muted:#9C9485;--oak:#D2A057;--rule:#3A352C;--green:#7CA876;--alarm:#A85039;--alarm-ink:#FFF0EA}}\n:root[data-theme=\"dark\"]\{--plaster:#191713;--ink:#EAE4D8;--muted:#9C9485;--oak:#D2A057;--rule:#3A352C;--green:#7CA876;--alarm:#A85039;--alarm-ink:#FFF0EA}\n*\{box-sizing:border-box}\nbody\{background:var(--plaster);color:var(--ink);margin:0;padding:0 1.25rem 5rem;font-family:ui-sans-serif,system-ui,Helvetica,Arial,sans-serif;font-size:17px;line-height:1.7}\n.wrap\{max-width:52rem;margin:0 auto}\nh1\{font-family:Georgia,serif;font-weight:400;font-size:clamp(2rem,5vw,3rem);line-height:1.1;margin:3.5rem 0 1rem;letter-spacing:-0.02em}\nh2\{font-family:Georgia,serif;font-weight:400;font-size:1.6rem;line-height:1.25;margin:0 0 0.9rem}\nh3\{font-family:ui-monospace,Menlo,monospace;font-size:0.72rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--muted);margin:2.2rem 0 0.2rem;font-weight:400}\n.standfirst\{font-family:Georgia,serif;font-size:1.15rem;line-height:1.55;margin:0 0 1.4rem}\n.sec-label\{font-family:ui-monospace,Menlo,monospace;font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--oak);display:block;margin:0 0 0.7rem}\nsection\{padding-top:2.8rem}\np\{margin:0 0 1rem}\n.note\{font-size:0.93rem;color:var(--muted);border-top:1px solid var(--rule);padding-top:0.9rem}\n.refused\{font-family:ui-monospace,Menlo,monospace;font-size:0.75rem;line-height:1.65;letter-spacing:0.02em;color:var(--alarm-ink);background:var(--alarm);padding:0.9rem 1rem;margin:1.4rem 0}\n.gen\{font-family:ui-monospace,Menlo,monospace;font-size:0.72rem;color:var(--muted);border:1px solid var(--rule);border-left:2.5px solid var(--green);padding:0.9rem 1rem;margin:1.4rem 0}\n.scroll\{overflow-x:auto;margin:1.4rem 0}\n.scroll table\{margin:0}\ntable.wide\{min-width:40rem}\ntable.widest\{min-width:52rem}\ntable\{border-collapse:collapse;width:100%;font-size:0.9rem;margin:1.4rem 0}\nth,td\{text-align:left;padding:0.45rem 0.6rem;border-bottom:1px solid var(--rule);vertical-align:top;line-height:1.45}\nth\{font-family:ui-monospace,Menlo,monospace;font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);border-bottom:1.5px solid var(--ink)}\ntd.dim\{font-family:ui-monospace,Menlo,monospace;font-size:0.8rem;font-variant-numeric:tabular-nums;white-space:nowrap}\ntd.warn\{font-family:ui-monospace,Menlo,monospace;font-size:0.8rem;font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--alarm);font-weight:600}\nfooter\{max-width:52rem;margin:3.5rem auto 0;padding-top:1.4rem;border-top:1.5px solid var(--ink);font-family:ui-monospace,Menlo,monospace;font-size:0.7rem;color:var(--muted)}"
