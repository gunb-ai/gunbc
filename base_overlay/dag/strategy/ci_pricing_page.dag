// ---------------------------------------------------------------------------------------------
// SPILL
// ---------------------------------------------------------------------------------------------

fn selection_text(s: SpillSelection) -> String {
  match s {
    SpillRouteSelected { identity, product, per_unit_minute_micro, considered } =>
      join([identity.provider, " ", product], ""),
    SpillRouteRefused { job, considered, obligation } => "no admissible route",
  }
}

fn selection_cost_text(s: SpillSelection) -> String {
  match s {
    SpillRouteSelected { identity, product, per_unit_minute_micro, considered } =>
      cp_usd6(micro: per_unit_minute_micro),
    SpillRouteRefused { job, considered, obligation } => "refused",
  }
}

fn spread_text(s: SpillSpread) -> String {
  match s {
    SpreadPositive { permille, route } => cp_permille_text(p: permille),
    SpreadNegative { shortfall_micro, route } => join(["LOSS ", cp_usd6(micro: shortfall_micro)], ""),
    SpreadUnavailable { obligation } => "no route",
  }
}

fn spill_row(j: JobRequirement) -> Fragment {
  let sel = cheapest_admissible(j: j)
  el(tag: "tr", children: [
    cp_td(text: j.label),
    cp_td_dim(text: service_class_label(c: j.service_class)),
    cp_td_dim(text: architecture_requirement_label(r: j.architecture)),
    cp_td(text: selection_text(s: sel)),
    cp_td_dim(text: selection_cost_text(s: sel)),
    cp_td_dim(text: spread_text(s: retail_spread_for(j: j))),
    cp_td_dim(text: spread_text(s: volume_spread_for(j: j))),
  ])
}

fn spill_table() -> Fragment {
  cp_scrollable(t: el_class(tag: "table", cls: "widest", children: [
    cp_head_row(cells: ["Job shape", "Class", "Arch", "Cheapest admitted route", "Route cost", "Retail spread", "Volume spread"]),
    el(tag: "tbody", children: map(spill_job_shapes, j => spill_row(j: j))),
  ]))
}

