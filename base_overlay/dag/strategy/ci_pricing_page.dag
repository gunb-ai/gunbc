fn frontier_axes_banner() -> Fragment {
  el_class(tag: "p", cls: "refused", children: [txt(s: join([
    "PLANNING ASSUMPTIONS, AND NOTHING IS RANKED. ",
    to_string(count(frontier_sensitivities)),
    " observations could still reorder the survivors: ",
    join(frontier_sensitivities, "; "), ".",
  ], ""))])
}

fn split_versus_dense_table() -> Fragment {
  let s = split_versus_dense()
  cp_scrollable(t: el_class(tag: "table", cls: "wide", children: [
    cp_head_row(cells: ["", "Planning capex", "Sellable units", "Failure domain", "Machines"]),
    el(tag: "tbody", children: [
      el(tag: "tr", children: [
        cp_td(text: s.split_label), cp_td_dim(text: cp_usd2(micro: s.split_capex_micro)),
        cp_td_dim(text: to_string(s.split_units)), cp_td_dim(text: to_string(s.split_failure_domain)),
        cp_td_dim(text: "2"),
      ]),
      el(tag: "tr", children: [
        cp_td(text: s.dense_label), cp_td_dim(text: cp_usd2(micro: s.dense_capex_micro)),
        cp_td_dim(text: to_string(s.dense_units)), cp_td_warn(text: to_string(s.dense_failure_domain)),
        cp_td_dim(text: "1"),
      ]),
      el(tag: "tr", children: [
        cp_td(text: "Split saves"), cp_td_dim(text: cp_usd2(micro: s.known_saving_micro)),
        cp_td_warn(text: join(["-", to_string(s.unit_shortfall)], "")),
        cp_td_dim(text: "half"), cp_td_warn(text: "+1"),
      ]),
    ]),
  ]))
}

// TWO QUESTIONS IN ORDER, AND THE FIRST DECIDES WHETHER THE SECOND IS EVEN A PRODUCT CLAIM.
//
// This banner previously rendered "THE BIGGEST CLAIM HAS NO NUMBER" straight from the measurement
// state, which framed work elimination as the latent centerpiece of the offer merely awaiting a
// figure. That framing IS the claim first_runner_sku_pricing_basis refuses: a reader takes it as
// "this is what they sell, unpriced" rather than "this is not what they sell". So the SKU basis is
// consulted first. Under MeteredExecutionOnly the page states the refusal; the measurement state is
// then reported as an INTERNAL engineering question, which is what it is.
fn work_avoided_banner() -> Fragment {
  match first_runner_sku_pricing_basis {
    MeteredExecutionOnly { basis, refused_claim } =>
      el_class(tag: "p", cls: "refused", children: [txt(s: join([
        "NOT SOLD ON THIS. ", refused_claim,
      ], ""))]),
    StructuralWorkElimination { basis, evidence } =>
      el_class(tag: "p", cls: "gen", children: [txt(s: join([
        "SOLD ON THIS. ", basis, " Evidence: ", evidence,
      ], ""))]),
  }
}

// The measurement state, rendered as the internal question it is. Reached under either basis: it is
// what is true about the mechanism, and it does not become a product claim by being displayed.
fn work_avoided_measurement_banner() -> Fragment {
  match selected_software_execution_alpha {
    WorkAvoidedMeasured { baseline_unit_minutes, admitted_unit_minutes, receipt } =>
      el_class(tag: "p", cls: "gen", children: [txt(s: join([
        "Work avoided on our own workload: ", to_string(baseline_unit_minutes - admitted_unit_minutes),
        " unit-minutes of ", to_string(baseline_unit_minutes), ". ", receipt,
      ], ""))]),
    WorkAvoidedUnmeasured { obligation } =>
      el_class(tag: "p", cls: "refused", children: [txt(s: join([
        "UNMEASURED, AND THE INSTRUMENT IS GONE. ", obligation,
      ], ""))]),
  }
}

// Why the two questions are separate, rendered from the reach carrier rather than restated.
fn work_elimination_reach_line(r: WorkEliminationReach) -> Fragment {
  match r {
    InternalWorkload { question, answerable_by } =>
      el_class(tag: "p", cls: "gen", children: [txt(s: join([
        "Internal - ", question, " ", answerable_by,
      ], ""))]),
    ExternalWorkload { question, blocked_by, unblocking_contracts } =>
      el_class(tag: "p", cls: "refused", children: [txt(s: join([
        "Saleable - ", question, " BLOCKED: ", blocked_by, " Unblocked by: ", unblocking_contracts,
      ], ""))]),
  }
}

// Customer saving is the customer's money. It is rendered against the competitor rows only, and
// never beside our contribution, because the two are not the same quantity.
fn customer_alpha_row(o: ComputeOfferObservation) -> Fragment {
  match offer_unit_price(o: o) {
    UnitPriceForeign { micro, currency, obligation } =>
      el(tag: "tr", children: [cp_td(text: o.identity.provider), cp_td_dim(text: "not comparable"), cp_td_dim(text: "-")]),
    UnitPriceUsd { micro } => {
      let a = customer_alpha(competitor: o.identity.provider, competitor_micro: micro, our_price_micro: retail_per_unit_minute_micro)
      el(tag: "tr", children: [
        cp_td(text: join([o.identity.provider, " ", o.product], "")),
        cp_td_dim(text: cp_usd6(micro: a.saving_micro)),
        cp_td_dim(text: cp_signed_permille_text(p: a.saving_permille)),
      ])
    },
  }
}

fn customer_alpha_table() -> Fragment {
  cp_scrollable(t: el(tag: "table", children: [
    cp_head_row(cells: ["Instead of", "Customer keeps, per unit-minute", "Share of their price"]),
    el(tag: "tbody", children: map(competitor_offers(), o => customer_alpha_row(o: o))),
  ]))
}

// ---------------------------------------------------------------------------------------------
// MARKET
// ---------------------------------------------------------------------------------------------

fn unit_price_text(o: ComputeOfferObservation) -> String {
  match offer_unit_price(o: o) {
    UnitPriceUsd { micro } => cp_usd6(micro: micro),
    UnitPriceForeign { micro, currency, obligation } => join(["EUR ", cp_micro6(micro: micro)], ""),
  }
}

fn comparison_text(c: RetailComparison) -> String {
  match c {
    RetailUnder { permille } => join([cp_permille_text(p: permille), " under"], ""),
    RetailOver { permille } => join([cp_permille_text(p: permille), " over"], ""),
    RetailLevel => "level",
    RetailNotComparable { reason } => "not comparable",
  }
}

fn market_row(o: ComputeOfferObservation) -> Fragment {
  el(tag: "tr", children: [
    cp_td(text: join([o.identity.provider, " ", o.product], "")),
    cp_td_dim(text: market_class_label(c: o.market_class)),
    cp_td_dim(text: architecture_label(a: o.architecture)),
    cp_td_dim(text: join([entitlement_label(e: o.entitlement), ", ", dedication_label(d: o.dedication)], "")),
    cp_td_dim(text: interruption_label(i: o.interruption)),
    cp_td_dim(text: join([
      to_string(o.vcpu_count), " / ", to_string(o.memory_gib), " GiB = ",
      cp_units_text(permille: offer_unit_count_permille(o: o)), " u",
    ], "")),
    cp_td_dim(text: unit_price_text(o: o)),
    cp_td_dim(text: comparison_text(c: offer_retail_comparison(o: o))),
    cp_td_dim(text: spill_admission_label(s: o.spill_admission)),
  ])
}

fn market_table() -> Fragment {
  cp_scrollable(t: el_class(tag: "table", cls: "widest", children: [
    cp_head_row(cells: ["Provider", "Class", "Arch", "CPU unit", "Durability", "Shape", "Per unit-minute", "Our retail", "Spill"]),
    el(tag: "tbody", children: map(ci_compute_offers, o => market_row(o: o))),
  ]))
}

