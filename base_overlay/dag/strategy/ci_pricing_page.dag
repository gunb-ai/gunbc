fn alpha_row(a: AlphaSource) -> Fragment {
  el(tag: "tr", children: [
    cp_td(text: a.name),
    cp_td(text: a.mechanism),
    cp_td_dim(text: alpha_evidence_label(e: a.evidence)),
    cp_td(text: a.durability),
  ])
}

fn alpha_table() -> Fragment {
  cp_scrollable(t: el_class(tag: "table", cls: "wide", children: [
    cp_head_row(cells: ["Source", "Mechanism", "Standing", "How durable"]),
    el(tag: "tbody", children: map(alpha_sources, a => alpha_row(a: a))),
  ]))
}

fn packing_row(b: NodeBuildCandidate) -> Fragment {
  let r = packing_reading(b: b)
  el(tag: "tr", children: [
    cp_td(text: r.label),
    cp_td_dim(text: to_string(r.cores)),
    cp_td_dim(text: join([to_string(r.memory_gib), " GiB"], "")),
    cp_td_dim(text: to_string(r.standard_units)),
    cp_td_dim(text: to_string(r.sellable_units)),
    if r.stranded_cores > 0 { cp_td_warn(text: to_string(r.stranded_cores)) } else { cp_td_dim(text: "0") },
    cp_td_dim(text: join([to_string(r.unused_memory_gib), " GiB"], "")),
    cp_td_dim(text: cp_usd2(micro: r.capex_micro)),
    cp_td_dim(text: cp_usd2(micro: r.capex_per_unit_micro)),
    cp_td_dim(text: band_standing_label(c: b)),
  ])
}

fn packing_table() -> Fragment {
  cp_scrollable(t: el_class(tag: "table", cls: "widest", children: [
    cp_head_row(cells: ["Candidate", "Cores", "Memory", "Standard units", "Sellable", "Stranded cores", "Unused RAM", "Known capex", "Capex per unit", "Frontier"]),
    el(tag: "tbody", children: map(node_build_candidates, b => packing_row(b: b))),
  ]))
}

fn memory_lot_row(m: MemoryLotObservation) -> Fragment {
  el(tag: "tr", children: [
    cp_td(text: m.part_description),
    cp_td_dim(text: join([to_string(m.data_rate_mt_s), " MT/s"], "")),
    cp_td_dim(text: condition_label(c: m.condition)),
    cp_td_dim(text: cp_usd2(micro: m.unit_price_micro)),
    cp_td_dim(text: cp_usd2(micro: memory_price_per_gib_micro(m: m))),
    cp_td_dim(text: supply_label(q: m.supply)),
    cp_td_dim(text: m.observed_on),
  ])
}

fn memory_lot_table() -> Fragment {
  cp_scrollable(t: el_class(tag: "table", cls: "widest", children: [
    cp_head_row(cells: ["Module", "Speed", "Condition", "Price", "Per GiB", "Supply", "Observed"]),
