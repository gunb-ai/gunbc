// ---------------------------------------------------------------------------------------------
// Number rendering. Micro-dollars are integers; a price is rendered by splitting rather than
// dividing, so no rounding happens on the way to the page.
// ---------------------------------------------------------------------------------------------

fn cp_micro6(micro: Int) -> String {
  let whole = micro / 1000000
  join([to_string(whole), ".", cp_pad6(v: micro - whole * 1000000)], "")
}

fn cp_pad6(v: Int) -> String {
  if v >= 100000 { to_string(v) }
  else if v >= 10000 { join(["0", to_string(v)], "") }
  else if v >= 1000 { join(["00", to_string(v)], "") }
  else if v >= 100 { join(["000", to_string(v)], "") }
  else if v >= 10 { join(["0000", to_string(v)], "") }
  else { join(["00000", to_string(v)], "") }
}

fn cp_pad2(v: Int) -> String {
  if v >= 10 { to_string(v) } else { join(["0", to_string(v)], "") }
}

fn cp_usd6(micro: Int) -> String { join(["$", cp_micro6(micro: micro)], "") }

// Dollars, not fractions of a cent.
fn cp_usd2(micro: Int) -> String {
  let whole = micro / 1000000
  join(["$", to_string(whole), ".", cp_pad2(v: (micro - whole * 1000000) / 10000)], "")
}

fn cp_permille_text(p: Int) -> String {
  join([to_string(p / 10), ".", to_string(p - p / 10 * 10), "%"], "")
}

fn cp_signed_permille_text(p: Int) -> String {
  if p < 0 { join(["-", cp_permille_text(p: 0 - p)], "") } else { cp_permille_text(p: p) }
}

fn cp_units_text(permille: Int) -> String {
  let whole = permille / 1000
  join([to_string(whole), ".", to_string((permille - whole * 1000) / 100)], "")
}

fn cp_th(text: String) -> Fragment { el(tag: "th", children: [txt(s: text)]) }
fn cp_td(text: String) -> Fragment { el(tag: "td", children: [txt(s: text)]) }
fn cp_td_dim(text: String) -> Fragment { el_class(tag: "td", cls: "dim", children: [txt(s: text)]) }
fn cp_td_warn(text: String) -> Fragment { el_class(tag: "td", cls: "warn", children: [txt(s: text)]) }
fn cp_note(text: String) -> Fragment { el_class(tag: "p", cls: "note", children: [txt(s: text)]) }
fn cp_para(text: String) -> Fragment { el(tag: "p", children: [txt(s: text)]) }

// A table that outgrows a phone scrolls inside its own box, not by dragging the page sideways.
fn cp_scrollable(t: Fragment) -> Fragment {
  el_class(tag: "div", cls: "scroll", children: [t])
}

fn cp_head_row(cells: List<String>) -> Fragment {
  el(tag: "thead", children: [el(tag: "tr", children: map(cells, c => cp_th(text: c)))])
}

fn cp_section(label: String, heading: String, body: List<Fragment>) -> Fragment {
  el(tag: "section", children: concat([
    el_class(tag: "span", cls: "sec-label", children: [txt(s: label)]),
    el(tag: "h2", children: [txt(s: heading)]),
  ], body))
}

