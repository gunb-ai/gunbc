// The exact s1-gate conjunction, as identities - a count alone would still pass if a
// required dependency were swapped for an unrelated one while the count held.
data s1_gate_required_deps: List<NonEmptyStr> = [
  "s0-receipts", "colo-rfq", "soc2-window", "acquisition-instrumented",
  "machine-health-model", "lot-decision", "marketing-min", "billing-ux",
  "commercial-demand-standing", "tenant-shared-fleet-suite", "storage-recovery-rewarm-drill",
  "tax-insurance-scope", "spares-control-plane-readiness", "package-upstream-admission",
]

// ---------------------------------------------------------------------------------------------
// Structural checks the witness executes.
// ---------------------------------------------------------------------------------------------

fn find_item(id: NonEmptyStr) -> List<PlanItem> {
  filter(year_end_plan_items, i => i.id == id)
}

fn dep_resolves(id: NonEmptyStr) -> Bool {
  count(find_item(id: id)) == 1
}

fn item_deps_resolve(i: PlanItem) -> Bool {
  fold(i.depends_on, init: true, f: fn(acc, d) { acc && dep_resolves(id: d) })
}

fn dep_milestone_order_ok(i: PlanItem) -> Bool {
  fold(i.depends_on, init: true, f: fn(acc, d) {
    acc && fold(find_item(id: d), init: true, f: fn(a2, dep) {
      a2 && milestone_order(m: dep.milestone) <= milestone_order(m: i.milestone)
    })
  })
}

// ACYCLICITY BY CONSTRUCTION: every dependency's declared rank is strictly smaller than
// the dependent's, and no cycle admits strictly decreasing ranks - the same-milestone
// two-cycle the previous witness permitted is now unwritable without also failing this.
fn dep_rank_ok(i: PlanItem) -> Bool {
  fold(i.depends_on, init: true, f: fn(acc, d) {
    acc && fold(find_item(id: d), init: true, f: fn(a2, dep) {
      a2 && dep.rank < i.rank
    })
  })
}

fn plan_graph_sound() -> Bool {
  fold(year_end_plan_items, init: true, f: fn(acc, i) {
    acc && item_deps_resolve(i: i) && dep_milestone_order_ok(i: i) && dep_rank_ok(i: i)
  })
}

fn contains_id(ids: List<NonEmptyStr>, id: NonEmptyStr) -> Bool {
  count(filter(ids, x => x == id)) == 1
}

fn gate_conjunction_exact() -> Bool {
  fold(find_item(id: "s1-gate"), init: false, f: fn(acc, g) {
    count(g.depends_on) == count(s1_gate_required_deps)
      && fold(s1_gate_required_deps, init: true, f: fn(a2, r) { a2 && contains_id(ids: g.depends_on, id: r) })
  })
}

fn item_is_done(i: PlanItem) -> Bool {
  match i.status {
    Done { receipt } => true,
    NotStarted => false,
    InProgress { note } => false,
    DeclaredBehind { reason } => false,
  }
}

fn item_not_started(i: PlanItem) -> Bool {
  match i.status {
    NotStarted => true,
    Done { receipt } => false,
    InProgress { note } => false,
    DeclaredBehind { reason } => false,
  }
}

// COMPLETION COHERENCE: a Done item whose dependency is not Done is a lie the previous
// model accepted; now it reds the witness. (Typed receipt identities in place of the
// receipt string remain declared follow-up debt - the string proves someone typed text.)
fn deps_all_done(i: PlanItem) -> Bool {
  fold(i.depends_on, init: true, f: fn(acc, d) {
    acc && fold(find_item(id: d), init: true, f: fn(a2, dep) { a2 && item_is_done(i: dep) })
  })
}

fn done_implies_deps_done() -> Bool {
  fold(year_end_plan_items, init: true, f: fn(acc, i) {
    acc && (!item_is_done(i: i) || deps_all_done(i: i))
  })
}

// ---------------------------------------------------------------------------------------------
// TRACKING, in plan-epoch days (2026-08-29 = day 0). LATE: anchor passed without Done.
// AT RISK: latest safe start (anchor_day - min_calendar_days) has passed and the item is
// UNFINISHED -- not merely unstarted. InProgress past that day is still amber: starting
// an item must not extinguish the only signal that means act today. Late remains the
// stronger colour once the anchor itself has passed.
// ---------------------------------------------------------------------------------------------

fn latest_start_day(i: PlanItem) -> Int {
  milestone_anchor_day(m: i.milestone) - i.min_calendar_days
}

fn item_late_at_day(i: PlanItem, today_day: Int) -> Bool {
  milestone_anchor_day(m: i.milestone) < today_day && !item_is_done(i: i)
}

fn item_at_risk_at_day(i: PlanItem, today_day: Int) -> Bool {
  !item_late_at_day(i: i, today_day: today_day)
    && latest_start_day(i: i) < today_day
    && !item_is_done(i: i)
}

fn items_late_at_day(today_day: Int) -> List<PlanItem> {
  filter(year_end_plan_items, i => item_late_at_day(i: i, today_day: today_day))
}

fn items_at_risk_at_day(today_day: Int) -> List<PlanItem> {
  filter(year_end_plan_items, i => item_at_risk_at_day(i: i, today_day: today_day))
}

fn on_track_at_day(today_day: Int) -> Bool {
  count(items_late_at_day(today_day: today_day)) == 0 && count(items_at_risk_at_day(today_day: today_day)) == 0
}

data requirement_coalescence_note: NonEmptyStr = "COALESCENCE MAP - where every standing requirement family lives, so this plan is the ONE staging surface: the compliance register's DesignConstraintNow rows land through m2-applicability-model, m2-control-bindings, customer-authorizations, soc2-baseline and tax-insurance-scope; the external review's before-first-customer list lands through tenant-boundary-minimum, fabric-m0's durable-commit gate, boot-minimum, machine-identity-secrets-lifecycle, the m2-launch-intent through m2-compliance-admission chain, whose centre is the provider-route permit, and support-abuse; its before-S1 list lands through colo-rfq, s0-receipts, machine-health-model, tenant-shared-fleet-suite, storage-recovery-rewarm-drill, package-upstream-admission, spares-control-plane-readiness and the s1-gate conjunction; the storage M0-M3 sequence enters as fabric-m0 with M1+ stages deliberately post-gate; the acquisition authority's outbound-scale preconditions bind acquisition-instrumented; the fragility/lot analysis lands through lot-decision (immediate execution); the product surface lands through customer-portal (cut scope), docs-dry-run, paid-minimum, billing-ux and support-abuse. A requirement discovered later is added HERE as an item with a milestone, or explicitly recorded as post-gate - never tracked in a side list."

data plan_scaling_note: NonEmptyStr = "Why the M3 items exist at demo scale (operator 2026-08-29): the business can scale exponentially for a stretch, so every lever must carry EXECUTABLE TERMS before it is needed - the PreparedLever grain (quoted price, quote expiry, activation lead days, admitted capacity, prerequisites, deposit, cancellation terms, supplier), and for software/security levers an executed drill in place of a price. Price alone is not sufficient. The demo is deliberately small; the levers are deliberately not - and by each anchor the plan establishes the smallest executed fact that safely authorizes the next irreversible step."
