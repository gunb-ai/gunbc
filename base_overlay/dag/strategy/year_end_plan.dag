  depends_on: ["m2-launch-intent", "provider-route-census"],
  relates_to: ["strategy.compliance_posture", "strategy.ci_alpha"],
  status: NotStarted,
}

data item_provider_route_admission: PlanItem = PlanItem {
  id: "provider-route-admission",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 8,
  min_calendar_days: 14,
  execution_mode: AgentParallel,
  exit_criterion: "THE EXECUTABLE JOIN, AND THE CENTRE OF THE COMPLIANCE PROGRAM: active posture revision x exact demand and work and customer and data scope x provider route and its data-path closure -> a SEALED PERMIT naming demand, work, offer, route, posture revision, route-facts revision, customer profile revision and agreement revision. Refusals are typed and constructible - route unclassified, route facts incomplete, posture revision stale, customer scope unsupported, data handling unsupported, required agreement authority absent, transfer or location unresolved, downstream provider unassessed, access path unsupported - none of which the current RouteRejection can even express. The gate runs BEFORE capacity fungibility and before price, alongside executor sanction, because neither is economic and neither belongs in a selection cost. Required reds: the cheapest unadmitted route never wins; an unclassified route refuses rather than defaulting; the same provider in two regions may differ; a permit under one posture revision is stale under the next; available money cannot override a denial; and a permit cannot override an exhausted budget.",
  depends_on: ["provider-route-census", "m2-applicability-model", "m2-admission-spine"],
  relates_to: ["strategy.compliance_posture", "strategy.compute_fabric_model"],
  status: NotStarted,
}

data item_m2_control_bindings: PlanItem = PlanItem {
  id: "m2-control-bindings",
  workstream: SecurityCompliance,
  milestone: M2FirstExternal,
  rank: 10,
  min_calendar_days: 14,
  execution_mode: AgentParallel,
