data item_llc_publication_filing: PlanItem = PlanItem {
  id: "llc-publication-filing",
  workstream: SecurityCompliance,
  milestone: M1InternalVertical,
  rank: 10,
  min_calendar_days: 14,
  execution_mode: OperatorExclusive,
  exit_criterion: "Certificate of Publication filed with the New York Department of State, both newspaper affidavits annexed, and the DOS receipt captured. Publication itself is complete and the filing package was MAILED on 2026-09-05, which starts DOS processing and does not end this item: mailed is not filed, and the exit is the DOS receipt in hand. Until filed, the LLC's authority to maintain an action in New York courts is suspended — dormant while nobody owes anything, live the moment a customer contract exists.",
  depends_on: no_deps,
  relates_to: ["finance.gunbai_llc"],
