  depends_on: ["s0-receipts", "colo-rfq", "soc2-window", "acquisition-instrumented", "machine-health-model", "lot-decision", "marketing-min", "billing-ux", "commercial-demand-standing", "tenant-shared-fleet-suite", "storage-recovery-rewarm-drill", "tax-insurance-scope", "spares-control-plane-readiness", "package-upstream-admission"],
