  depends_on: ["hw-first-host"],
  relates_to: ["strategy.home_hosting", "strategy.makeshift_datacenter", "strategy.site_power_survey"],
  status: NotStarted,
}

data item_siting_decision: PlanItem = PlanItem {
  id: "siting-decision",
  workstream: Hardware,
  milestone: M3YearEndGate,
  rank: 40,
  min_calendar_days: 3,
  execution_mode: OperatorExclusive,
