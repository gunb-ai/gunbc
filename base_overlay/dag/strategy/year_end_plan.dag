  depends_on: ["provider-route-admission", "m2-applicability-model"],
  relates_to: ["strategy.compliance_posture", "strategy.ci_alpha"],
  status: NotStarted,
}

data item_provider_enablement_budget: PlanItem = PlanItem {
  id: "provider-enablement-budget",
  workstream: EconomicsQa,
  milestone: M2FirstExternal,
  rank: 10,
  min_calendar_days: 10,
  execution_mode: AgentParallel,
  exit_criterion: "THE SECOND OF THE THREE BUDGET QUESTIONS, kept separate from the permit because compliance is not depleted by use. One item per unsupported route naming what it closes first, the posture revision it was sized against, its owner as internal construction or provider evidence or bounded external interpretation, and its cost as quoted or estimated or explicitly unpriced. Cash, operator time and calendar latency stay SEPARATE AXES rather than one scalar, so an internal hour is never silently interchangeable with an outside dollar. A one-time contract review is never charged per job, and a route that has not completed enablement never enters dispatch selection - the selector must not commission legal research or sign an agreement as a fallback.",
  depends_on: ["provider-route-admission"],
  relates_to: ["strategy.compliance_posture", "strategy.ci_runner_economics"],
  status: NotStarted,
}

