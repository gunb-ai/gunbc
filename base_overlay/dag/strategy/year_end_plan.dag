data item_netboot_gap_analysis: PlanItem = PlanItem {
  id: "netboot-gap-analysis",
  workstream: Hardware,
  milestone: M1bInternalS0Proof,
  rank: 20,
  min_calendar_days: 5,
  execution_mode: AgentParallel,
  exit_criterion: "END-TO-END netboot install enumerated against what actually exists: DHCP/PXE or HTTP boot path, aarch64 UEFI chain, image identity and digest, per-node identity and secret injection, disk-free or disk-optional operation, unattended reinstall, and recovery when the boot service is the thing that is down. Each step is Present, Partial or Absent with evidence — an Absent that nobody wrote down is the one that surfaces during the first reinstall of a customer-serving node. THE HOST BOOT VARIANT IS ALREADY SETTLED AND THIS ITEM MUST NOT REOPEN IT: strategy.compute_fabric_model selects RamRoot with local NVMe as disposable scratch only, netboot-m0 states RAM-root, and the reasoning is recorded - a root materialised into RAM limits the network dependency to the BOOT WINDOW, where an NFS root keeps the network on a running node's continuous execution path so losing the server hangs a live node. What is open is the layer BELOW the host root: guest and scratch materialisation, and whether a node-local cache exists at all, which compute_fabric_model already carries as the choice between NetworkToRamNoNodeCache, NetworkToRamWithSiteCache and NetworkToLocalEphemeralRoot. Its diskless_promotion_gate owes eight controls before local scratch may be removed, and control six - that removing local scratch adds the EXACT remote-scratch network demand - is the one this fleet's 1 GbE links make expensive to get wrong. Precedes netboot-m0, which builds the product this analysis scopes.",
  depends_on: ["hw-first-host"],
  relates_to: ["strategy.mobo_x_architecture", "strategy.compute_fabric_model"],
  status: NotStarted,
}

data item_node_burnin_protocol: PlanItem = PlanItem {
