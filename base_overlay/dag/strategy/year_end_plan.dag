  depends_on: ["cohort-qualified", "first-external-customer"],
  relates_to: ["strategy.ci_acquisition", "strategy.fleet_qualification"],
  status: NotStarted,
}

data item_competitive_price_benchmark: PlanItem = PlanItem {
  id: "competitive-price-benchmark",
  workstream: EconomicsQa,
  milestone: M3YearEndGate,
  rank: 70,
  min_calendar_days: 7,
  execution_mode: AgentParallel,
  exit_criterion: "The profiled jobs executed on our fleet and on the named competitors, reduced to COST PER COMPLETED JOB rather than cost per minute — a per-minute comparison flatters whichever side is faster and says nothing about what the customer pays for the work. Result is a per-workload advantage or disadvantage carrying its measurement receipt, admitting the cases where we lose. Deliberately NOT declared an s1-gate conjunct: whether a price claim gates the go/no-go is the operator's call, and adding a conjunct silently would change the gate's meaning.",
  depends_on: ["economics-regrounding"],
  relates_to: ["strategy.pareto_comparison_procedure", "strategy.ci_runner_economics"],
  status: NotStarted,
}


// ---------------------------------------------------------------------------------------------
// SITING, MONEY AND COMPLIANCE (operator, 2026-09-04). Accumulate broadly now, consolidate
// later — the operator's explicit instruction. Three families enter here.
//
// SITING was represented only by colo-rfq, which produces QUOTES and stops. A quote is not a
// vendor, a vendor is not a signed date, and a signed date is not a rack you can put a server
// in. Worse, the fallback had no carrier at all: "if colo is not ready we soft-launch from the
// house" is a real plan the graph could not see, so nothing derived when it had to be decided.
// A fallback with no decision date is not a fallback, it is a hope.
//
// MONEY was absent entirely. Everything built in finance.personal_ledger and finance.gunbai_llc
// is invisible to every on-track derivation, so a 38,106.25 invoice and a January estimated
// payment were tracked by memory. The schedule cannot see what the ledger knows.
//
// GDPR had zero occurrences. SOC 2 is rostered twice; the regime that binds on the FIRST EU
// customer rather than at year end was not modelled at all.
// ---------------------------------------------------------------------------------------------

data item_colo_shortlist: PlanItem = PlanItem {
  id: "colo-shortlist",
  workstream: Hardware,
  milestone: M3YearEndGate,
  rank: 20,
  min_calendar_days: 21,
  execution_mode: ExternalLead,
  exit_criterion: "RFQ responses reduced to a ranked shortlist of at most three named facilities, each carrying price, quote validity window, lead time to occupancy, committed capacity, deposit and expansion terms — the criteria colo-rfq was already extended to cover. A shortlist of one is a refusal to shop and must say so; a shortlist that omits validity windows is a list of numbers that expire without anyone noticing.",
  depends_on: ["colo-rfq"],
  relates_to: ["strategy.colo_market", "strategy.site_requirements"],
  status: NotStarted,
}

data item_colo_vendor_selection: PlanItem = PlanItem {
