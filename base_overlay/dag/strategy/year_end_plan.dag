  depends_on: ["hw-first-host", "fleet-capacity-floor"],
  relates_to: ["strategy.fleet_qualification", "strategy.mobo_x_memory_census"],
  status: NotStarted,
}

data item_scheduler_capacity_weights: PlanItem = PlanItem {
