data program_pilot_note: String = "Pilot of the program decomposition and discharge graph (audit 2026-08-02, docs/strategy/2026-08-02-program-decomposition-audit.md): the bare-minimum-computation contract as first specimen. The contract was adopted 2026-08-01 under operator dispatch K with the five-minute wall-clock wording and amended 2026-08-02 by operator ruling (verbatim in docs/strategy/2026-08-02-ci-bare-minimum-computation-ruling.md; public carriers re-anchored in gunb-ai/gunbc#7664); the amendment row retains the previous criteria, and the stale-binding witness derives its specimen digest from them. Bindings carry the criteria-digest LITERAL each was read against - re-pasting it per row is the mechanism, not sloppiness: amending the contract mismatches every un-reread row individually, and a shared constant would let one lockstep edit hide the re-read. Three obligations are deliberately unbound today (exact affected closure, semantic input identity, pre-index lookup: the first is live machinery predating this graph and needs its own binding pass with real work refs; the others are genuinely open) so the derived program view shows true open surface. PR states enter only as dated ObservationReceipt rows; nothing here says is-open or is-merged in the present tense. The four audit test claims this instantiation must keep false: 7599 claiming cross-invocation materialization, 7534 claiming pre-index lookup, 7522 claiming native witness execution, and any completion claim while the decomposition is Partial."

data program_contracts: List<StrategicContract> = [
  StrategicContract {
    id: "contract-bare-minimum-computation",
    statement: "Every required operation performs the bare minimum computation needed to serve it; redundant computation is a defect, and wall-clock outcomes fall out of the realization and materialization goals rather than defining the contract.",
    acceptance_criteria: [
      "every required operation computes only facts its inputs require",
      "no semantic fact is recomputed while its inputs are unchanged",
      "wall-clock follows from realization and materialization, never defines the contract",
      "five minutes is an operational distress threshold, not the success criterion",
    ],
    constraint_ids: [],
    adoption: DecisionReceipt {
      authority: "operator",
      decided_on: "2026-08-01",
      rationale: "Operator dispatch K registered the central CI program boundary; adopted with the five-minute wall-clock wording, amended the next day - see contract_amendments am-2026-08-02-bare-minimum-reanchor.",
    },
  },
  StrategicContract {
    id: "contract-v2-self-host-fixed-point",
    statement: "v2 emits its own compiler sources as the cleanest principled realization, proven by execution: the seed shrinks across a typed frontier until production routes through the self-emitted result; behavioral equivalence is the bar, byte identity explicitly is not.",
    acceptance_criteria: [
      "every compiler module is either self-emitted green-by-execution or a declared seed-retained row with reason and trigger",
      "self-emitted means produced by v2's own emitter with no old-generator reachability and behavioral equivalence on a discriminating corpus",
      "the emitter reproduces itself through two generations before the remaining stages are claimed",
      "the fixed point is behavioral equivalence, never byte identity",
    ],
    constraint_ids: [],
    adoption: DecisionReceipt {
      authority: "operator",
      decided_on: "2026-03-11",
      rationale: "GOAL INTRODUCTION evidence only: PR #138 (titled gunbc v2, no body, merged 2026-03-11) marks the lineage origin and establishes none of today's bar. The criteria on this row are the CURRENT bar - behavioral equivalence per DESIGN 7, strict producer-provenance per calm-badger-682 2026-07-29, boundary recut per the 2026-08-02 review - not the March 11 plan (review Finding 7).",
    },
  },
  StrategicContract {
    id: "contract-v2-production-cutover",
    statement: "Production compilation and every required CI operation route through v2-produced compiler output, with fallback to the old generator absent or explicitly refused.",
    acceptance_criteria: [
      "the production build routes through v2-produced compiler output",
      "every required CI operation routes through v2-produced output",
      "fallback to the old generator is absent or explicitly refused, never silent",
    ],
    constraint_ids: [],
    adoption: DecisionReceipt {
      authority: "operator",
      decided_on: "2026-08-02",
      rationale: "Minted by the boundary recut (review Finding 3) so cutover cannot overload the fixed-point terminal; mirrors the public roadmap ordering (v1-emitter-fixed-point then v1-ci-floor-cutover). Carries no decomposition yet - completion honestly refuses DecompositionMissing. Old-generator retirement is a further downstream contract, unminted until work binds to it.",
    },
  },
  StrategicContract {
    id: "contract-language-medium-support",
    statement: "Every language or medium the project claims to support is complete for an explicit support profile; every incomplete target carries an exact typed frontier and disposition; new product or experimental needs promote profiles and capabilities deliberately, and nothing remains mostly-supported without being measurable.",
    acceptance_criteria: [
      "every registered target declares its support profiles and priority in one typed registry, never status prose",
      "a target is complete for a profile only when required capabilities equal executed-proven capabilities and unclassified residue is zero, derived never authored",
      "target-language vocabulary is confined to realization boundaries, with the live-tree containment receipt executing in CI and every exception a declared row with a dissolution trigger",
      "every executable target's support claim is an executed toolchain-and-behavior receipt with a discriminating planted defect, never emitted text alone",
    ],
    constraint_ids: [],
    adoption: DecisionReceipt {
      authority: "operator",
      decided_on: "2026-08-02",
      rationale: "Operator-routed language-support review (docs/strategy/2026-08-02-language-support-completion-review.md), fitted by this session on the operator's draft-the-work instruction; wording follows the review's strategic correction - profile-completeness with an exact frontier, never unbounded full support - and stays amendable through ContractAmendment. Scope: Rust compiler-bootstrap is governed by contract-v2-self-host-fixed-point and contract-v2-production-cutover, referenced never duplicated; P2/P3 targets enter through registry rows under criterion 1, not per-target obligations.",
    },
  },
]

