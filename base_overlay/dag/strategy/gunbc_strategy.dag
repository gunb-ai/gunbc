data corrected_census_subject: String = "gunb-ai/gunbc self-host corrected candidate census (second-pass 27-row roster rewrite)"

fn selfhost_module_obligation_ids() -> List<String> {
  fold(compiler_frontier_roster, init: [], f: fn(acc, r) {
    let mp = r.module_path
    concat(acc, ["obl-module-{mp}"])
  })
}

