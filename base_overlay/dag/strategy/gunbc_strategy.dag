data hypotheses: List<Hypothesis> = [
  Hypothesis {
    id: "visually-legible-privacy-is-shareable",
    causal_claim: "A visually legible privacy interaction (authorized wipe-to-reveal) causes qualified developers to voluntarily share the product, producing referral events.",
  },
  Hypothesis {
    id: "landing-and-sealed-execution-create-compute-demand",
    causal_claim: "Landing validation and sealed execution produce billable compute demand attached to visible causal constraints rather than subscription tiers.",
  },
  Hypothesis {
    id: "one-authority-derives-hardware-and-software",
    causal_claim: "Because .dag preserves types, exact widths, bounds, effects, cost, and placement across layers, one semantic authority can derive hardware realization (spatial pipeline / CGRA fabric / scalar-effect partition), software fallback, drivers, verification, and deployment as projections with proved correspondence — removing per-instruction control overhead in static pure regions and the cost of maintaining five parallel representations.",
  },
]

data experiments: List<Experiment> = [
  Experiment {
    id: "qualified-design-partner-privacy-demo",
    tests_hypothesis_id: "visually-legible-privacy-is-shareable",
    intervention: "Show the real authorized wipe-to-reveal interaction to a bounded set of qualified developers; observe demo completion, access requests, follow-up meetings, voluntary sharing, referred qualified viewers.",
    stop_predicate: "bounded cohort exhausted, or no voluntary sharing after the declared cohort size, or trust-boundary rejection dominates causes",
  },
  Experiment {
    id: "dag-machine-measurement-program",
    tests_hypothesis_id: "one-authority-derives-hardware-and-software",
    intervention: "Five slices from the dag-machine architecture directive: (1) model the graph-machine contract (GraphImage/Launch/Completion, four execution classes Transform/Select/State/Effect, lowering from the six behaviors proved where it holds with typed refusals where not); (2) cycle-accurate simulator of a configurable PE array; (3) three realizations of ONE nontrivial pure kernel — sequential host baseline, simulated fabric, XLS IR to Verilog; (4) FPGA measurements incl. graph-load amortization at 1, 10, and 1M invocations; (5) soft CGRA mesh mapping several .dag graphs without resynthesis.",
    stop_predicate: "curiosity-priced: never displaces priority-directive lanes and runs in operator personal time; program stops if the three-realization comparison shows no energy or initiation-interval advantage on the matched kernel, or if FPGA receipts show graph-load amortization never breaks even at realistic invocation counts",
  },
]

data dag_machine_experiment_note: String = "Recorded per operator request 2026-08-01 (dag-machine architecture directive, docs/strategy/2026-08-01-dag-machine-architecture-directive.md): explicitly a personal-curiosity lane — 'not a realistic project, curious for personal reasons' — wanting Verilog/SPICE emission and measured efficiency math. Priced OUTSIDE the priority-assessment sequence; the four-question test defers it, and the hypothesis it tests doubles as the honest frame for the section-12 business readings (better targeting of existing hardware, co-design platform, specialized compute tier, custom silicon last). The efficiency envelope anchor: on an OoO core, per-instruction control energy is on the order of tens of pJ while a 32-bit add is on the order of 0.1 pJ (Horowitz, ISSCC 2014 keynote figures) — the removable overhead in static pure regions is the gap between those two numbers, bounded below by memory and communication energy, which do not vanish."

data constraints: List<Constraint> = [
  Constraint { id: "ui-never-claims-state-without-receipt", forbids: "Any visible domain claim without exactly one structural source and an inspectable provenance path." },
  Constraint { id: "no-plaintext-before-authorized-disclosure", forbids: "Delivering protected plaintext to a client (payload, index, accessibility text, page source, CSS-hidden) before disclosure authorization." },
  Constraint { id: "no-unmodeled-publication", forbids: "Publication of content by machinery with no modeled operation; automatic pushes are the live specimen class." },
  Constraint { id: "public-claims-require-evidence", forbids: "Marketing a claim whose required capabilities lack observed evidence; unsupported claims are Unsupported, never aspirationally public." },
  Constraint { id: "default-private-strategy", forbids: "New strategy content defaulting public; publishing is the explicit act (opt-in-public ruling 2026-08-01)." },
  Constraint { id: "standards-before-invention", forbids: "Minting an internal model where a citable external standard or real upstream exists; the extdeps citation IS the grounding (operator ruling 2026-08-01, applied to auth/identity/disclosure and to sales/marketing alike)." },
]

