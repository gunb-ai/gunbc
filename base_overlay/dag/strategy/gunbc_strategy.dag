    receipt: DecisionReceipt {
      authority: "operator",
      decided_on: "2026-08-02",
      rationale: "Operator-routed discharge-graph review decisions table: production cutover not part of compiler fixed point; old-generator deletion belongs to a separate downstream retirement contract.",
