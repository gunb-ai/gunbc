    coverage: PartialCoverage {
      open_note: "sequencing is registered but completeness is not derivable yet: module coverage must derive from the public 27-row frontier denominator (selfhost_module_obligation_ids), the bootstrap/host-kernel membership question is open, and old-generator deletion belongs to a downstream retirement contract, never this one; CompleteCoverage requires an operator-authorized coverage rule whose derivation then establishes completeness (review Finding 5)",
    },
  },
  ProgramDecomposition {
    id: "dec-language-support-2026-08-02",
    parent_contract: "contract-language-medium-support",
    parent_criteria_digest: "criteria|every registered target declares its support profiles and priority in one typed registry, never status prose|a target is complete for a profile only when required capabilities equal executed-proven capabilities and unclassified residue is zero, derived never authored|target-language vocabulary is confined to realization boundaries, with the live-tree containment receipt executing in CI and every exception a declared row with a dissolution trigger|every executable target's support claim is an executed toolchain-and-behavior receipt with a discriminating planted defect, never emitted text alone",
    child_obligation_ids: [
