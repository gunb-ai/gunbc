data decisions: List<StrategicDecision> = [
  StrategicDecision {
    question_id: "first-world",
    question: "Which project is the first world the landing dashboard renders?",
    alternatives: [
      DecisionAlternative { id: "gunbc-dogfood", statement: "gunbc itself: missions are roadmap nodes, actors are sessions, receipts are the live PR and witness stream." },
      DecisionAlternative { id: "synthetic-demonstration", statement: "A synthetic demo repository authored for presentation." },
    ],
    criteria: ["TruthfulLiveReceipts", "ImmediateDogfoodValue", "MinimalNewSubstrate"],
    state: Selected {
      choice_id: "gunbc-dogfood",
      receipt: DecisionReceipt {
        authority: "operator",
        decided_on: "2026-08-01",
        rationale: "Truthful live receipts and immediate dogfood value; mission identity binds roadmap nodes; actor projection may initially be thin.",
      },
    },
  },
  StrategicDecision {
    question_id: "dashboard-host-surface",
    question: "Which surface hosts the phase-1 landing dashboard?",
    alternatives: [
      DecisionAlternative { id: "gunbc-served-dashboard-lane", statement: "The gunbc-served dashboard lane: routes and dispatch already modeled, site register supplies the visual law." },
      DecisionAlternative { id: "site-register-stack", statement: "The gunb.ai site register stack." },
      DecisionAlternative { id: "standalone-surface", statement: "A standalone new surface." },
    ],
    criteria: ["MinimalNewSubstrate", "ReceiptFidelity", "IterationSpeed"],
    state: Selected {
      choice_id: "gunbc-served-dashboard-lane",
      receipt: DecisionReceipt {
        authority: "operator",
        decided_on: "2026-08-01",
        rationale: "Operator: focus on the srv1 dashboard and how it evolves. The landing dashboard is the gunbc-served dashboard lane's evolution, not a new surface; routes and dispatch are already modeled there and the site register supplies the visual law.",
      },
    },
  },
  StrategicDecision {
    question_id: "roadmap-visibility",
    question: "Does the gunbc roadmap stay public or move to the private root?",
    alternatives: [
      DecisionAlternative { id: "keep-public-for-now", statement: "ROADMAP.md and roadmap_authority.dag stay in the public repo; strategy references roadmap node ids one-way." },
      DecisionAlternative { id: "move-private", statement: "The roadmap moves to the private root and the public repo carries a projection." },
    ],
    criteria: ["ConsumerContinuity", "PublicationMonotonicity", "EventualPrivacyParity"],
    state: Selected {
      choice_id: "keep-public-for-now",
      receipt: DecisionReceipt {
        authority: "operator",
        decided_on: "2026-08-01",
        rationale: "Many live consumers (sessions, dispatch, CI, dashboard) depend on the public roadmap today. Instinct is private, but continuity wins for now; revisit when generated projections (visibility-grants P-D) can serve consumers from a private authority.",
      },
    },
  },
  StrategicDecision {
    question_id: "actor-model-scope",
    question: "How are actors modeled in the phase-1 dashboard?",
    alternatives: [
      DecisionAlternative { id: "thin-projection", statement: "Project existing session, work-item, and PR facts as actors; no new carrier." },
      DecisionAlternative { id: "modeled-actor-carrier", statement: "Land a modeled Actor carrier (identity, capabilities, assigned intents, attempts, context, compute allocation) first." },
    ],
    criteria: ["MinimalNewSubstrate", "LegibilityOfAgentWork"],
    state: Selected {
      choice_id: "thin-projection",
      receipt: DecisionReceipt {
        authority: "operator",
        decided_on: "2026-08-01",
        rationale: "Priority-assessment directive: derive actors from session/work-item/attempt/process/provider-instance/branch/PR facts; a canonical Actor carrier lands only when the first interface exposes a fact existing structures cannot derive. Avoids modeling the people on screen before building the screen.",
      },
    },
  },
  StrategicDecision {
    question_id: "licensing-model",
    question: "Under which license model does the public gunbc corpus ship?",
    alternatives: [
      DecisionAlternative { id: "fully-open-source", statement: "Whole public corpus under an OSI-approved license; the hosted platform and enterprise surface carry any commercial boundary." },
      DecisionAlternative { id: "open-core", statement: "Open substrate/compiler core; proprietary product surfaces (landing dashboard, disclosure, sealed execution)." },
      DecisionAlternative { id: "source-available", statement: "Source visible under a non-OSI license restricting competing use; with a change date each version auto-converts to an OSI license (FSL/BUSL shape) - the operator's early-versions-become-free instinct, formalized." },
      DecisionAlternative { id: "dual-license", statement: "Copyleft public license plus commercial license for closed embedding, with a watertight compiler-output exception." },
      DecisionAlternative { id: "revenue-threshold-commercial", statement: "Game-engine shape: free below a revenue threshold, commercial above - highest adoption-tax risk for a language." },
      DecisionAlternative { id: "graduated-contribution-hybrid", statement: "The 2026-08-02 routed shape: permanently-free spec layer (MIT/Apache), BSL-like public-source implementation with delayed per-release conversion, and a graduated capped group fee - free below 100M consolidated prior-year gross revenue, declining marginal basis-point brackets (1 / 0.5 / 0.25 bp), 1M annual cap, unconditional output exception, contractor-on-behalf-of use included, no telemetry; fee function executable in strategy.licensing_fee_model." },
    ],
    criteria: ["AdoptionFriction", "PublicPrivateBoundaryFit", "FutureMonetization", "CommunityTrust", "OutputOwnershipUnambiguous", "SoleAuthorshipVerifiedWithCounsel", "SwitchCostGrowsWithAdoption"],
    state: Open,
  },
  StrategicDecision {
    question_id: "lang-ecmascript-authority",
    question: "Is ECMAScript the runtime-semantic authority beneath the TypeScript target, or a deliberately separate target model?",
    alternatives: [
      DecisionAlternative { id: "ecmascript-as-base", statement: "ECMAScript is the semantic base; the TypeScript target projects onto it and duplicate JavaScript semantics dissolve." },
      DecisionAlternative { id: "deliberately-separate", statement: "The two targets stay separate with an explicit boundary statement; duplication is declared and bounded." },
    ],
    criteria: ["SingleSemanticAuthority", "NoDuplicateJsSemantics", "MigrationCost"],
    state: Open,
  },
  StrategicDecision {
    question_id: "lang-cpp-profile",
    question: "Which C++ profile does the project commit to: bounded system-kernel C++ or a general-purpose C++ target?",
    alternatives: [
      DecisionAlternative { id: "bounded-system-kernel", statement: "Bounded system/ABI and numerical-kernel C++ serving the accelerator and systems goals; explicitly not labeled full support." },
      DecisionAlternative { id: "general-purpose-target", statement: "A general-purpose C++ target including templates, exceptions, ownership, and multi-file linkage - a much larger separately-scoped program." },
    ],
    criteria: ["AcceleratorNeedsFirst", "HonestScopeNaming", "TemplateAbiCost"],
    state: Open,
  },
  StrategicDecision {
    question_id: "lang-tsprogram-terminal-role",
    question: "What is the terminal role of the TsProgram AST: retained as a confined realization carrier, or dissolved into the shared target-model fold?",
    alternatives: [
      DecisionAlternative { id: "retained-confined", statement: "TsProgram remains an internal confined TypeScript realization AST behind the containment wall." },
      DecisionAlternative { id: "dissolved-into-target-model", statement: "TsProgram dissolves into the common target-model and grammar emission machinery." },
    ],
    criteria: ["DecideOnlyAfterRealConsumers", "SingleEmissionAuthority"],
    state: Open,
  },
]

data licensing_decision_note: String = "ACTIVATED 2026-08-02: the operator raised the model question directly (game-engine-style free/commercial split; is-it-too-late) - captured with verified repo facts and four registered alternatives in docs/strategy/2026-08-02-licensing-model-question.md; the licensing-model decision row above is Open and operator-owned; it is NOT too late (MIT is irrevocable only for already-distributed snapshots, zero external human contributors, switch cost grows with adoption). Originally opened per the priority-assessment directive (2026-08-01): licensing is a bounded research pass culminating in ONE decision with criteria and consequences, never a general license-reasoning framework before the product boundary is known. Research grounding when picked up: SPDX identifiers and OSI license texts as cited extdeps rows. Ranked Medium; the operator owns the decision."

