fn observed_capability_id_list() -> List<String> {
  fold(observed_capabilities, init: [], f: fn(acc, o) { concat(acc, [o.capability_id]) })
}

data observed_capability_note: String = "source-integration-landing-dashboard carries RoadmapAccepted evidence: the P0 acceptance receipt merged to main 2026-08-01 (PR 7542, operator merge as the acceptance act); the witness checks this node id against the PUBLIC accepted_roadmap_node_ids() so acceptance evidence cannot be asserted here ahead of the authority. Scenario-executed contract, not a real-target transition (P3 write transport absent by design). Disclosure and sealed execution remain design-only. Capability observation is evidence of existence, never of adoption; AdoptionEvidence has no roadmap arm by construction."

