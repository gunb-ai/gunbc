module p_c_httpstatus
import std.process { ProcessExit, ExitSuccess }
import std.types { String, Int, Bool, Port, HttpStatus }
import std.nat { Nat, nat_to_decimal_string }
import std.integer { int_to_decimal_string, PositiveInt, NonNegativeInt }
import std.measure { ByteSize, HardwareThreadCount }
fn outer(x: HttpStatus) -> String { int_to_decimal_string(value: x) }
fn main() -> ProcessExit {
  let s = outer(x: 200)
  ExitSuccess
}
