module p_p_string
import std.process { ProcessExit, ExitSuccess }
import std.types { String, Int, Bool, List }
import std.nat { Nat }
import std.integer { int_to_decimal_string }

fn g(a: String) -> String { int_to_decimal_string(value: a) }
fn main() -> ProcessExit {
  let s = g(a: "x")
  ExitSuccess
}
