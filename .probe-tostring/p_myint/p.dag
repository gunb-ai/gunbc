module p_p_myint
import std.process { ProcessExit, ExitSuccess }
import std.types { String, Int, Bool, List }
import std.nat { Nat }
import std.integer { int_to_decimal_string }
type MyInt = Alpha { a: Nat } | Beta
fn g(a: MyInt) -> String { int_to_decimal_string(value: a) }
fn main() -> ProcessExit {
  let s = g(a: Alpha { a: 1 })
  ExitSuccess
}
