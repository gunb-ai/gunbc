+
+// NoReadOfRecord is ALLOWED by the closure and halts nothing: a deploy whose only unit makes a positive
+// no-read assertion PROCEEDS, proving the third arm is not secretly treated as Unclosed.
+test fn a_no_read_of_record_row_allows_the_deploy_gate() -> Bool {
+  let row = ReadRow { located: "/var/lib/tailscale/serve", reads: NoReadOfRecord { reason: "tailscale CLI mapping" } }
+  match deploy_gate(rows: [row], installed: []) {
+    Proceed => true
+    Halt { cause: _ } => false
+  }
+}
+
+// A no-read is NOT a fallback for an unmodeled kind: from the REAL adapter over the srv1 roster, the tailscale
+// mapping yields a NoReadRow (allowed) while an enabled-but-unmodeled kind (the tree-remote unit, still
+// NotYetModeled until its module exports its ExecStart) yields an UnclosedRow. Both are unconditional roster
+// members, so this checks the REAL adapter on kinds srv1 always enables: a no-read kind cannot silently borrow
+// another's assertion, because the adapter has a distinct, explicit arm per kind.
+test fn no_read_is_never_a_fallback_for_an_unmodeled_kind() -> Bool {
+  let steps = srv1_steps()
+  let tailscale_step = first_where(xs: steps, keep: fn(s) { match s.kind { UpsertOwned { kind: TailscaleServeMapping } => true, _ => false } })
+  let remote_step = first_where(xs: steps, keep: fn(s) { match s.kind { UpsertOwned { kind: DeployedTreeRemoteUnit } => true, _ => false } })
+  match tailscale_step {
+    Present { value: ts } => match remote_step {
+      Present { value: rs } =>
+        match deploy_artifact_inventory_row(row: ReadRow { located: ts.path as String, reads: deployment_artifact_read_set(step: ts, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) }) {
+          NoReadRow { located: _, reason: r } => non_empty(r)
+            && match deploy_artifact_inventory_row(row: ReadRow { located: rs.path as String, reads: deployment_artifact_read_set(step: rs, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) }) {
+                 UnclosedRow { located: _, reason: _ } => true
+                 _ => false
+               }
+          _ => false
+        }
+      Absent => false
+    }
+    Absent => false
+  }
 }
 
