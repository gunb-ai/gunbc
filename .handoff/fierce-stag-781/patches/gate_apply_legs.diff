+// THE OWNED SET: each install leg's OWN typed destination (leg_installed_paths), unioned. This is the
+// WRITES side; the roster read-sets are the READS side. Two independent views, so the gate is not the
+// model checked against itself -- a leg that argv-spells a path its enabled unit does not read, or a
+// unit enabled with no install leg covering its read, is caught.
+fn deploy_gate_installed_paths(legs: List<DeployApplyLeg>) -> List<OwnedArtifact> {
+  match legs {
+    Empty => []
+    Cons { head: l, tail: rest } => list_append(left: leg_installed_paths(leg: l), right: deploy_gate_installed_paths(legs: rest))
+  }
+}
