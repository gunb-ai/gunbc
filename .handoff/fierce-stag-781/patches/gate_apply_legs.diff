+// a oneshot converger is covered by a start/restart leg (it runs its work in this deploy); a long-running
+// converger is covered by an enable leg. A new unit kind is a compile error here until someone decides.
+fn converger_brought_up(legs: List<DeployApplyLeg>, unit_step: String, kind: ConvergerUnitKind) -> Bool {
+  match kind {
+    Oneshot => leg_step_present(legs: legs, step: join([unit_step, "-restart"], "")) || leg_step_present(legs: legs, step: join([unit_step, "-start"], ""))
+    LongRunning => leg_step_present(legs: legs, step: join([unit_step, "-enable"], ""))
+  }
+}
