+fn tailscale_serve_mapping_reads_installed_artifact(service: TailscaleServeService) -> Bool {
+  match service {
+    // The serve CLI applies the mapping out-of-band; it installs no file and reads none of record.
+    ServeCli => false
+  }
 }
