
// ── NoReadOfRecord: the positive, owner-derived no-read (item 4a) ──
// A NoReadOfRecord row is the kind's OWN module saying "this unit reads no installed artifact". It is a POSITIVE
// assertion made by an enumerated adapter arm (never a catch-all), so it must ALLOW the deploy — but it is NOT a
// default for an unmodeled kind. The inventory keeps it distinct from Unclosed (not a hidden gap) and from a
// reason-bearing row (the allow must not rest on a String).

test fn a_no_read_of_record_row_allows_the_deploy_gate() -> Bool {
  let row = ReadRow { located: "/var/lib/gunbc/tailscale/serve-map", reads: NoReadOfRecord }
  match deploy_gate(rows: [row], installed: []) {
    Proceed => true
    Halt { cause: _ } => false
  }
}

// A NoReadOfRecord is NEVER a fallback for an unmodeled kind. deployment_artifact_read_set has no catch-all, so an
// unmodeled kind must be NotYetModeled, not NoReadOfRecord; and the inventory maps NoReadOfRecord to its own
// NoReadRow, so it is not smuggled in as Unclosed. (The adapter enumerates every kind explicitly, so a new kind is
// a compile error, not an implicit no-read.)
test fn no_read_is_never_a_fallback_for_an_unmodeled_kind() -> Bool {
  let rows = [
    ReadRow { located: "/u/unmodeled", reads: NotYetModeled { reason: "reader read-set not declared" } },
    ReadRow { located: "/u/noread", reads: NoReadOfRecord }
  ]
  let inv = deploy_artifact_inventory(rows: rows)
  let unmodeled_is_not_noread = match first_where(xs: inv, keep: fn(r) { match r { UnclosedRow { located: l, reason: _ } => l == "/u/unmodeled", _ => false } }) {
    Present { value: _ } => true
    Absent => false
  }
  let noread_is_not_unclosed = match first_where(xs: inv, keep: fn(r) { match r { NoReadRow { located: l } => l == "/u/noread", _ => false } }) {
    Present { value: _ } => true
    Absent => false
  }
  unmodeled_is_not_noread && noread_is_not_unclosed
}

// The serve mapping has no unit module to classify, so its adapter arm must state no-read DIRECTLY rather than fall
// through to a catch-all — and it derives it from the serve's OWN typed TailscaleServeService (not a hardcoded
// true), so the claim cannot drift from the typed surface. The serve type is a total match, so a future serve that
// DOES read an artifact yields false -> NotYetModeled, not a silent NoReadOfRecord.
test fn the_tailscale_no_read_is_derived_from_the_serve_service() -> Bool {
  let srv = tailscale_serve_service()
  let derived_allows_no_read = tailscale_serve_mapping_reads_installed_artifact(service: srv) == false
  let srv_steps = srv1_steps()
  let mapping = first_where(xs: srv_steps, keep: fn(s) { match s.kind { UpsertOwned { kind: TailscaleServeMapping } => true, _ => false } })
  match mapping {
    Present { value: s } =>
      match deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) {
        NoReadOfRecord => derived_allows_no_read
        _ => false
      }
    Absent => derived_allows_no_read
  }
}

// THE deployed-tree-remote unit reads {its sync-script argv[0], its WorkingDirectory tree}, derived from its OWN
// typed oneshot unit file via the unit_standing classifier — the same unit file the deploy emits. RED if the read
// set drifts off the unit it is derived from, or if the classifier is abandoned for a hand-kept list.
test fn the_tree_remote_read_set_matches_the_emitted_host_text() -> Bool {
  let spec = srv1_spec()
  let remote = first_where(xs: srv1_steps(), keep: fn(s) { match s.kind { UpsertOwned { kind: DeployedTreeRemoteUnit } => true, _ => false } })
  match remote {
    Present { value: s } =>
      match deployment_artifact_read_set(step: s, spec: spec, instance: srv1_inst(), revision: srv1_rev()) {
        Declared { paths: reads } =>
          let host = convergence_oneshot_unit_text(spec: spec, oneshot: tree_remote_convergence_oneshot(spec: spec))
          non_empty(reads)
            && string_contains(s: host, pattern: "ExecStart=/")
            && string_contains(s: host, pattern: "WorkingDirectory=")
            && all(reads, fn(r) { string_contains(s: host, pattern: r) })
        _ => false
      }
    Absent => false
  }
}

// The serve unit's read-set gains the OIDC config document it reads at startup, and that path is the SAME string as
// the INSTALLED OidcConfigArtifact step's path — both come from deployment_oidc_config_steps, so serve's read and
// the owned artifact can never drift. srv1 has OIDC placed; Absent is a failure (a control that silently checks
// nothing when OIDC is off is a decoration, guarantee_ladder).
test fn the_serve_unit_read_set_includes_the_oidc_config_it_reads() -> Bool {
  let inst = srv1_inst()
  let steps = srv1_steps()
  let serve = first_where(xs: steps, keep: fn(s) { match s.kind { ComposeOwned { kind: SystemdUnit } => true, _ => false } })
  let oidc_artifact = first_where(xs: steps, keep: fn(s) { match s.kind { ComposeOwned { kind: OidcConfigArtifact } => true, _ => false } })
  match serve {
    Present { value: su } => match oidc_artifact {
      Present { value: oc } =>
        match deployment_artifact_read_set(step: su, spec: srv1_spec(), instance: inst, revision: srv1_rev()) {
          Declared { paths: ps } => list_member(xs: ps, x: oc.path as String, eq: fn(a, b) { a == b })
          _ => false
        }
      Absent => false
    }
    Absent => false
  }
}

// The OIDC config is an installed artifact (the deploy owns it), never a unit with unmodeled reads. Its adapter arm
// is InstalledArtifact, so it is NOT NotYetModeled (the false "unit whose reads aren't modeled yet" claim for a
// config document) and NOT Declared (it is not a unit reading an artifact — the serve row declares that read).
test fn the_oidc_config_artifact_is_an_installed_artifact_not_a_reader() -> Bool {
  let steps = srv1_steps()
  let oidc = first_where(xs: steps, keep: fn(s) { match s.kind { ComposeOwned { kind: OidcConfigArtifact } => true, _ => false } })
  match oidc {
    Present { value: s } =>
      match deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) {
        InstalledArtifact => true
        Declared { paths: _ } => false
        NotYetModeled { reason: _ } => false
        NoReadOfRecord => false
      }
    Absent => false
  }
}

fn kind_is_belt(s: DeploymentArtifactStep) -> Bool { match s.kind { UpsertOwned { kind: BeltEventPathUnit } => true, _ => false } }
fn kind_is_publication(s: DeploymentArtifactStep) -> Bool { match s.kind { UpsertOwned { kind: PublicationHelperPathUnit } => true, _ => false } }

// THE BELT exit .path unit's declared read equals the DirectoryNotEmpty dirs of its own rendered unit file (and is
// non-empty). srv1 MUST own a BeltEventPathUnit step; if it ever stops owning one this check goes RED rather than
// silently passing — a check whose step could be absent is a decoration (guarantee_ladder).
test fn the_belt_path_unit_reads_its_watched_dirs() -> Bool {
  match first_where(xs: srv1_steps(), keep: fn(s) { kind_is_belt(s) }) {
    Present { value: s } =>
      let watched = watched_paths_of_unit_file(live_deploy_belt_exit_path_unit_file(spec: srv1_spec()))
      non_empty(watched) && read_is_exactly(deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()), watched)
    Absent => false
  }
}

// THE PUBLICATION helper .path unit's declared read equals the DirectoryNotEmpty dirs of its own rendered unit file
// (and is non-empty). srv1 MUST own a PublicationHelperPathUnit step; absence is a defect and goes RED.
test fn the_publication_path_unit_reads_its_watched_dirs() -> Bool {
  match first_where(xs: srv1_steps(), keep: fn(s) { kind_is_publication(s) }) {
    Present { value: s } =>
      let watched = watched_paths_of_unit_file(live_deploy_publication_path_unit_file(spec: srv1_spec()))
      non_empty(watched) && read_is_exactly(deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()), watched)
    Absent => false
  }
}
