+// OidcConfigArtifact is a written, installed artifact — NOT a modeled reader and NOT the false NotYetModeled
+// TODO label. Its row maps to InstalledArtifactRow (located, countable), never Declared or Unclosed.
+test fn the_oidc_config_artifact_is_an_installed_artifact_not_a_reader() -> Bool {
+  let oc = first_where(xs: srv1_steps(), keep: fn(s) { match s.kind { ComposeOwned { kind: OidcConfigArtifact } => true, _ => false } })
+  match oc {
+    Present { value: s } =>
+      match deploy_artifact_inventory_row(row: ReadRow { located: s.path as String, reads: deployment_artifact_read_set(step: s, spec: srv1_spec(), instance: srv1_inst(), revision: srv1_rev()) }) {
+        InstalledArtifactRow { located: _ } => true
+        _ => false
+      }
+    Absent => false
+  }
+}
