	@echo "  gist [REPO=.] [EXT=...]  - Create a GitHub gist from code files"
	@echo "  buck2 [INPUT=Cargo.toml] [OUTPUT=BUCK]  - Generate BUCK file from Cargo.toml"
	@echo "  makegen [OUTPUT=Makefile]  - Generate Makefile from tool registry"
