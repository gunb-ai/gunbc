# Ensure CLI entrypoints exist (bootstrap-safe)
ensure-codegen:
	@RUSTFLAGS="-D warnings" cargo run -p gunbc-codegen --release -- codegen

# Generate CLI entrypoints (DAG upsert)
codegen: ensure-codegen
