# Full build transaction: codegen → testgen → cargo build
build: codegen testgen
	@RUSTFLAGS="-D warnings" cargo build --all-targets

# Clean build artifacts
clean:
	@cargo clean

# Regenerate tests from DAG structures and MockSpecs
