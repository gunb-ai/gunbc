module bst227_f_check

// Local validation driver for PR F (.dag side): exercises the in-scope-binder
// verdict rule and the live-arm join with hand-built nodes. Returns 0 when all
// checks pass. Not enrolled in any gate; scratch only.

import v1.compiler.infer_types { type_resolution_verdict, TypeResolutionVerdict }
import v1.compiler.infer { join_type_nodes_opt }
import std.types { FilePath, SourceSpan }

fn f_span() -> SourceSpan {
  SourceSpan { file: FilePath { path: "f_check" }, start: 0, end: 1 }
}

fn f_leaf(name: String) -> Node {
  Node {
    ident: Absent,
    occurrence_identity: OccurrenceSynthetic, name: name, span: f_span(), ident_span: none, children: [],
    connective: NoConnective, params: [], inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData
  }
}

fn f_carrier(name: String, kids: List<Node>) -> Node {
  Node {
    ident: Absent,
    occurrence_identity: OccurrenceSynthetic, name: name, span: f_span(), ident_span: none, children: kids,
    connective: NoConnective, params: [], inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData
  }
}

fn f_owner(name: String, param_name: String, kids: List<Node>) -> Node {
  Node {
    ident: Absent,
    occurrence_identity: OccurrenceSynthetic, name: name, span: f_span(), ident_span: none, children: kids,
    connective: NoConnective, params: [f_leaf(param_name)], inferred: none, return_cardinality: Required,
    uses: [], body: none, transport: none, properties: [],
    type_annotation: none, is_self_recursive: false, has_non_tail_self_call: false, match_pattern: none, module_item_kind: NotAModuleItem, declaration_marker: Unmarked, declaration: none, expr_data: NoExprData
  }
}

fn f_no_src() -> Map<String, NewlineIndex> {
  Map {}
}

fn f_check() -> Int {
  // Verdict: a carrier's formal stranded outside its owner reads UnderResolved.
  let v1 = type_resolution_verdict(n: f_carrier("Optional", [f_leaf("T")]), source_indices: f_no_src())
  // Owner scope binds its own formal: resolved.
  let v2 = type_resolution_verdict(n: f_owner("Optional", "T", [f_leaf("T")]), source_indices: f_no_src())
  // Nested application: Rc<BadUrl> fully resolved.
  let v3 = type_resolution_verdict(n: f_carrier("Rc", [f_leaf("BadUrl")]), source_indices: f_no_src())
  // Join: Optional<T> with Optional<BadUrl> adopts the more instantiated child.
  let j1 = join_type_nodes_opt(left: f_carrier("Optional", [f_leaf("T")]), right: f_carrier("Optional", [f_leaf("BadUrl")]))
  // Join: genuine disagreement refuses.
  let j2 = join_type_nodes_opt(left: f_leaf("Int"), right: f_leaf("String"))
  let v1_ok = match v1 { UnderResolved => true _ => false }
  let v2_ok = match v2 { FullyResolved => true _ => false }
  let v3_ok = match v3 { FullyResolved => true _ => false }
  let j1_ok = match j1 {
    Present { value: j } =>
      (j.name == "Optional")
        && ((j.children |> count) == 1)
        && (((j.children |> first) |> unwrap_or(f_leaf(""))) .name == "BadUrl")
    Absent => false
  }
  let j2_ok = match j2 { Absent => true _ => false }
  if !v1_ok { 1 }
  else if !v2_ok { 2 }
  else if !v3_ok { 3 }
  else if !j1_ok { 4 }
  else if !j2_ok { 5 }
  else { 0 }
}
