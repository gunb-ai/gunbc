module bst227_closure_driver

// TEMPORARY DIAGNOSTIC DRIVER (deleted before commit). The claims route prints only PASS/FAIL per test,
// so this returns the closure emission's own report as text: which members emitted, and for the refused
// ones the diagnostic reason lexemes. Run it with `gunbc run --entry` and read stderr after "returned `".

import extdeps.communication.medium { Lossless, Medium }
import std.algebra { Cons, Empty, FreeMonoid, fold_list, list_reverse }
import std.live_tree { LiveTreeDisposition, SubstrateInputsOnly }
import std.optional { Absent, Optional, Present }
import v2.compiler.self_host.closure_emission { ClosureEmissionLocated, ClosureMemberEmission, ClosureMemberEmitted, ClosureMemberRefused, emit_closure_from_ingest_located }
import v2.compiler.source_authority { DagSourceReadWitness, SourceRootIngest }
import v2.extdeps.languages.rust { rust_target_model }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { DagTree }
import v2.std.diagnostic { Accepted, DeclarationLocus, Diagnostic, InvariantPortLocus, Locus, NonEmptyDiagnostics, NodeLocus, Rejected, SourcePortLocus, Textual, diagnostics_reason_lexemes }
import v2.std.node { Node, Symbol, node_synthetic, symbol_lexeme }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string, qualified_name_to_dotted_string }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = SubstrateInputsOnly

data etl_owner_source: String = "module v2.test.etl_owner\n\ntype EtlGrasp\n  = EtlHold\n  | Edge\n  | EtlRelease\n\ntype EtlGrip { chosen: EtlGrasp }\n\nfn etl_grip(g: EtlGrasp) -> EtlGrip { EtlGrip { chosen: g } }\n"

data etl_uses_source: String = "module v2.test.etl_uses\n\ntype EdgeMark\n  = Marked\n  | Unmarked\n\ntype EdgeList\n  = EdgeNil\n  | EdgeCons { head: Edge, tail: EdgeList }\n\ntype Edge { marked: EdgeMark, children: EdgeList }\n\ntype EtlWalk { first: Edge, second: Edge }\n\nfn etl_identity(edge: Edge) -> Edge { edge }\n\nfn etl_mark(m: EdgeMark) -> EdgeMark { m }\n\nfn etl_nil() -> EdgeList { EdgeNil }\n\nfn etl_walk(edge: Edge) -> EtlWalk { EtlWalk { first: edge, second: edge } }\n"

data etl_entry_source: String = "module v2.test.etl_entry\n\nimport v2.test.etl_uses { Edge, EdgeMark, EdgeList, EtlWalk, etl_identity, etl_walk }\nimport v2.test.etl_owner { EtlGrasp, EtlGrip }\n\ntype EtlPair { grasp: EtlGrasp, edge: Edge }\n\nfn etl_second(edge: Edge) -> Edge { etl_identity(edge: edge) }\n"

fn etl_read(source: String, id: Symbol, path: String) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: source, fidelity: Lossless },
    artifact: Artifact { kind: SourceFile, id: id, file_path: path },
    compilation_unit: id,
    source_root: DagTree
  }
}

fn etl_locus() -> Node {
  node_synthetic(kind: v2.std.node.TypeNode { connective: v2.std.node.Atom { identity: ^etl_entry_locus } }, children: [])
}

fn etl_ingest() -> SourceRootIngest {
  [
    etl_read(source: etl_owner_source, id: ^etl_owner_read, path: "src/v2/test/etl_owner.dag"),
    etl_read(source: etl_uses_source, id: ^etl_uses_read, path: "src/v2/test/etl_uses.dag"),
    etl_read(source: etl_entry_source, id: ^etl_entry_read, path: "src/v2/test/etl_entry.dag")
  ]
}

fn etl_emit() -> ClosureEmissionLocated {
  emit_closure_from_ingest_located(
    ingest: etl_ingest(),
    entry: qualified_name_from_dotted_string(dotted: "v2.test.etl_entry"),
    entry_locus: etl_locus(),
    target: rust_target_model()
  )
}

fn etl_diag(d: NonEmptyDiagnostics) -> String {
  concat(etl_diag_one(d.head), etl_tail(d.tail, ""))
}

fn etl_diag_one(d: Diagnostic) -> String {
  concat(concat(diagnostics_reason_lexemes(diagnostics: NonEmptyDiagnostics { head: d, tail: Empty }), " @ "), etl_diag_locus(at: d.at))
}

fn etl_diag_locus(at: Locus) -> String {
  match at {
    Textual { file: f, extent: _ } => concat("Textual(", symbol_lexeme(sym: f), ")")
    NodeLocus { anchor: _ } => "Node"
    SourcePortLocus { anchor: _, file: f, extent: _ } => concat("SourcePort(", symbol_lexeme(sym: f), ")")
    InvariantPortLocus { anchor: _, invariant: i } => concat("Invariant(", symbol_lexeme(sym: i), ")")
    DeclarationLocus { declaration: path } => concat("Decl(", etl_dots(segs: path, acc: ""), ")")
  }
}

fn etl_dots(segs: FreeMonoid<Symbol>, acc: String) -> String {
  match segs {
    Empty => acc
    Cons { head: s, tail: rest } => etl_dots(rest, if acc == "" { symbol_lexeme(sym: s) } else { concat(acc, ".", symbol_lexeme(sym: s)) })
  }
}

fn etl_tail(xs: List<Diagnostic>, acc: String) -> String {
  match xs {
    Empty => acc
    Cons { head: h, tail: rest } => etl_tail(rest, concat(acc, ",", diagnostics_reason_lexemes(diagnostics: NonEmptyDiagnostics { head: h, tail: Empty })))
  }
}

fn etl_member_line(m: ClosureMemberEmission) -> String {
  match m {
    ClosureMemberEmitted { module: q, text: t } =>
      concat(
        concat("EMITTED ", qualified_name_to_dotted_string(qn: q)),
        concat(
          if string_contains(s: t, pattern: "compile_error!") { " REFUSAL-TEXT" } else { "" },
          if string_contains(s: t, pattern: "Rc<()>") { " UNIT-PHANTOM" } else { "" }
        )
      )
    ClosureMemberRefused { module: q, diagnostics: d } =>
      concat(concat("REFUSED ", qualified_name_to_dotted_string(qn: q)), concat(" ", etl_diag(d: d)))
  }
}

fn etl_lines(arms: FreeMonoid<ClosureMemberEmission>, acc: List<String>) -> List<String> {
  match arms {
    Empty => acc
    Cons { head: m, tail: rest } => etl_lines(rest, Cons { head: etl_member_line(m: m), tail: acc })
  }
}

fn etl_join(xs: List<String>, acc: String) -> String {
  match xs {
    Empty => acc
    Cons { head: h, tail: rest } => etl_join(rest, concat(acc, concat("\n", h)))
  }
}

fn bst227_report() -> String {
  let located = etl_emit()
  match located.outcome {
    Rejected { diagnostics: d } => concat("OUTCOME-REJECTED ", etl_diag(d: d))
    Accepted { value: e, diagnostics: _ } => etl_join(list_reverse(xs: etl_lines(arms: e.modules, acc: [])), "OUTCOME-ACCEPTED")
  }
}
