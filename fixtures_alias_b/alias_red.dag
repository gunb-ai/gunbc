module instruments.fixtures.alias_red

// (b) RED for stern-bat-401 msg_db49ee15 (3): an alias against its OWN right-hand side, on main,
// with NO change to the fold. Written import-free on purpose -- the first attempt imported
// std.types/std.algebra, a standalone compile could not resolve them, and two of three rows were
// never evaluated. A RED that depends on an unresolved import is not a RED.
// Shape reproduces `type String = FreeMonoid<Char>` (src/v2/std/text.dag:7): an alias whose right
// hand side is an application of a generic type to a concrete argument.

type Box<T>
  = BoxValue { value: T }

type CharLike = CharLikeValue { code: Int }

type BoxOfChar = Box<CharLike>

// ROW 1 -- THE RED. A value of the alias's own right-hand side where the alias is expected.
fn accepts_box_of_char(x: Box<CharLike>) -> Bool {
  match x {
    BoxValue { value: v } => v.code == 0
  }
}

fn alias_against_its_own_rhs(a: BoxOfChar) -> Bool {
  accepts_box_of_char(x: a)
}

// ROW 2 -- THE REFUSAL TWIN. A genuinely different instance must still refuse.
fn accepts_box_of_int(x: Box<Int>) -> Bool {
  match x {
    BoxValue { value: v } => v == 0
  }
}

fn alias_against_a_different_instance(a: BoxOfChar) -> Bool {
  accepts_box_of_int(x: a)
}

// ROW 3 -- THE ACCEPT CONTROL. Right-hand side against right-hand side, no alias involved.
fn rhs_against_itself(x: Box<CharLike>) -> Bool {
  accepts_box_of_char(x: x)
}

// ROW 4 -- THE ASYMMETRY CONTROL. The alias where the alias is expected: must accept.
fn takes_alias_directly(a: BoxOfChar) -> Bool {
  alias_against_its_own_rhs(a: a)
}
