// std/containers.dag -- Container type algebra documentation.
//
// Container operations EMERGE from the algebraic structures their types
// inhabit (see std/algebra.dag). This file documents the derivation chain.
//
// LIST OPERATIONS (from FreeMonoid<T>):
//   concat, empty          — monoid operation + identity
//   length                 — carrier count (fold over elements)
//   index, slice           — positional access (Fin(n) carrier)
//   map, fold, filter      — catamorphism / functorial map
//   append, prepend        — monoid operation at specific position
//   reverse                — anti-involution on the monoid
//   sort                   — requires Ordering on T (OrderedRing or comparable)
//   first, last            — index at 0, index at length-1
//   contains               — fold with equality check
//   enumerate              — zip with Nat index
//   dedup                  — filter to unique elements (requires equality on T)
//   flat_map               — map then flatten (monadic bind)
//   join                   — fold with separator (FreeMonoid concat)
//
// SET OPERATIONS (from BooleanAlgebra<A>):
//   member                 — function application (A -> Bool)
//   union                  — pointwise OR
//   intersect              — pointwise AND
//   difference             — pointwise AND-NOT
//   complement_in(univ)    — relative complement (requires finite universe)
//   empty, size            — bottom element, support cardinality
//   is_subset              — pointwise implication
//   symmetric_difference   — pointwise XOR
//
// MAP OPERATIONS (from PartialFunction<K,V>):
//   lookup                 — function application (K -> 1+V)
//   insert                 — extend domain by one key
//   delete                 — restrict domain by one key
//   merge(f)               — union of domains with conflict resolution f
//   keys                   — domain as Set<K>
//   values                 — range as List<V>
//   has                    — domain membership (K -> Bool)
//   empty, size            — empty function, domain cardinality
//
// COST CONTRACTS for these operations are in std/primitives.dag.

module std.containers
