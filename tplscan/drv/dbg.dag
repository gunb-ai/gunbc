module tplscan.dbg
import v2.test.claim.body_lowering.string_template { st_route }
import std.process { ProcessExit, ExitFailure }
import v2.std.node { symbol_lexeme }
import v2.std.integer { integer_int_to_decimal_string }

fn route() -> ProcessExit {
  let r = st_route()
  ExitFailure { code: 1, reason: concat("ROUTE outcome=", concat(symbol_lexeme(sym: r.outcome), concat(" parsed=", concat(integer_int_to_decimal_string(value: r.parsed_templates), concat(" norm=", concat(integer_int_to_decimal_string(value: r.normalized_templates), concat(" concats=", concat(integer_int_to_decimal_string(value: r.normalized_concats), concat(" texts=", fold(r.normalized_texts, init: "", f: fn(a, t) { concat(a, concat("|", t)) })))))))))) }
}
