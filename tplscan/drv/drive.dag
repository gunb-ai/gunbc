fn run_paths(paths: List<String>) -> String {
  fold_list(xs: paths, empty: "", cons: fn(acc, p) {
    let v = match grammar_coverage_ingest_path(path: p) {
      ParsedClean => "ACCEPTED"
      ParseRejected { stage: s, reason: r } => concat("REFUSED ", concat(s, concat(" ", symbol_lexeme(sym: r))))
    }
    concat(acc, concat(p, concat("\t", concat(v, "\n"))))
  })
}

fn roster() -> ProcessExit {
  ExitFailure { code: 1, reason: concat("TPLSCAN\n", roster_text()) }
}

fn roster_text() -> String {
  fold_list(xs: grammar_choice_ambiguity_roster(root: dag_grammar_root()), empty: "", cons: fn(acc, row) { concat(acc, concat(symbol_lexeme(sym: row.production), "\n")) })
}

data tplscan_controls: List<String> = [
  "module c\ndata a: String = \"a\{ b\"\n",
  "module c\ndata a: String = \"\\\{x\"\n",
  "module c\ndata a: String = \"\{\}\"\n",
  "module c\ndata a: String = \"\\u\{e9\}\"\n",
  "module c\ndata a: String = \"\\uZ\"\n",
  "module c\ndata a: String = \"plain\\t\\\"q\\\\\"\n"
]

fn controls() -> ProcessExit {
  ExitFailure { code: 1, reason: concat("TPLSCAN\n", controls_text()) }
}

fn controls_text() -> String {
  let lm = dag_language_model()
  fold_list(xs: tplscan_controls, empty: "", cons: fn(acc, src) {
    let line = match tokenize(text: src, file: ^tplscan_control, rules: lm.lex) {
      Rejected { diagnostics: _ } => "TOKENIZE-REFUSED"
      Accepted { value: ts, diagnostics: _ } =>
        match parse_module(tokens: ts, grammar: lm.grammar) {
          Rejected { diagnostics: _ } => "PARSE-REFUSED"
          Accepted { value: art, diagnostics: _ } => content_hash(n: art.tree).digest
        }
    }
    concat(acc, concat(line, "\n"))
  })
}
