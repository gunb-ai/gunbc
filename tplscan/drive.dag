  "dag/test/fixture/argv_executable_position_probe.dag",
  "fixtures/atomic_materialization/subject.dag",
  "fixtures/bare_service_provider/provider.dag",
  "src/v1/02_parse.dag",
  "src/v2/lens/grounding.dag"
]
fn run() -> String {
  fold_list(xs: tplscan_paths, empty: "", cons: fn(acc, p) {
    let v = match grammar_coverage_ingest_path(path: p) {
      ParsedClean => "ACCEPTED"
      ParseRejected { stage: s, reason: r } => concat("REFUSED ", concat(s, concat(" ", symbol_lexeme(sym: r))))
    }
    concat(acc, concat(p, concat("\t", concat(v, "\n"))))
  })
}
