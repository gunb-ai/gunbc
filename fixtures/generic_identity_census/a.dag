module gic.a

type Box<Q> {
  item: Q
  rest: List<Q>
}

fn head_of<T>(xs: List<T>, d: T) -> T {
  match xs |> first {
    Present { value: v } => v
    Absent => d
  }
}

fn rename_of<M>(xs: List<M>, d: M) -> M {
  match xs |> first {
    Present { value: v } => v
    Absent => d
  }
}

fn ints() -> List<Int> {
  [1]
}

fn take_s(s: String) -> String {
  s
}

fn caller_literal() -> Int {
  head_of(xs: [1], d: 2)
}

fn caller_function() -> Int {
  head_of(xs: ints(), d: 2)
}

fn caller_renamed() -> Int {
  rename_of(xs: [1], d: 2)
}

fn boxed() -> Box<Int> {
  Box { item: 1, rest: [2] }
}

fn unbox<Q>(b: Box<Q>) -> Q {
  b.item
}

fn same_spelling_as_a_record_parameter<Q>(b: Box<Q>, q: Q) -> Q {
  q
}

type NlMod {
  module: String
}

fn nl_ms() -> List<NlMod> {
  [NlMod { module: "a" }]
}

fn nl_fold_list<T, A>(xs: List<T>, empty: A, cons: fn(A, T) -> A) -> A {
  match xs |> first {
    Present { value: h } => nl_fold_list(xs: xs |> skip(1), empty: cons(empty, h), cons: cons)
    Absent => empty
  }
}

fn caller_nl_fold() -> String {
  let modules = nl_fold_list(xs: nl_ms(), empty: [], cons: fn(acc, m) { list_push(xs: acc, item: m) })
  match modules |> first {
    Present { value: m } => m.module
    Absent => ""
  }
}
