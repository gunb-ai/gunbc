// DIRECT-INGEST main anyway: a 25-line translator for a corpus that declares the source-root Eval
// driver, emitted with zero diagnostics. Measured on this fixture at 17 modules, which is what
// makes the 404-module instance a symptom rather than the subject.
data compiler_pipeline_entry: CompilerEntryDriver = std.compiler_entry.SourceRootEvalDriver

fn probe_holds() -> Bool {
  true
}
