module fixtures.record_lit_owner_route.extra_module

// THE PERTURBATION. Not imported by subject. Present only in the larger-entry manifest so the
// two routes differ by pool membership of an unreachable module, matching own `--entry` vs
// a larger resolve over the same subject bytes.
type ExtraPoolMember { n: Int }

fn extra_value() -> ExtraPoolMember {
  ExtraPoolMember { n: 1 }
}
