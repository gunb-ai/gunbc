module gunbc.instruments.native_emission_controls_optional_importer

import std.types { Int }
import gunbc.instruments.native_emission_controls_optional_collision { Optional, CollisionWrapped, CollisionEmpty, collision_row_value }

// THE DISCRIMINATING IMPORTER. Not ingested as corpus (fixtures/ is not a source root).
// test.claim.infer_kernel_import_collision_witness reads THIS file and compiles its bytes.
fn imported_optional_value(o: Optional) -> Int {
  match o {
    CollisionWrapped { value: v } => v
    CollisionEmpty => 0
  }
}

// THE COLLISION WALL'S DISCRIMINATING RED
// (gunbc.recurring_failure_mode.import_collides_with_a_kernel_name). This module imports the
// non-kernel Optional of gunbc.instruments.native_emission_controls_optional_collision BY NAME.
// v1.compiler.resolve imported_type_collides_with_kernel_mint refuses that import
// (ImportCollidesWithKernelName). test.claim.infer_kernel_import_collision_witness
// importing_a_non_mint_optional_refuses_at_the_import compiles these fixture bytes and asserts that
// class. The file is not a dual-typing emit specimen: the colliding import is unwritable, so the
// two-lookup fork cannot form. It lives under fixtures/, not a source root, beside its collision
// declaration: a second Optional in the accepted corpus is itself a leaf-name fork.
type HeldChoice
  = HeldOptional { held: Optional }
  | HeldNothing

data held_wrapped_row: HeldChoice = HeldOptional { held: CollisionWrapped { value: 11 } }

data held_empty_row: HeldChoice = HeldOptional { held: CollisionEmpty }

fn held_choice_value(c: HeldChoice) -> Int {
  match c {
    HeldOptional { held: o } => collision_row_value(o: o)
    HeldNothing => 0 - 1
  }
}
