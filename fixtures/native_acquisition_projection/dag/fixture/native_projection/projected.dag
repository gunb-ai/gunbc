module fixture.native_projection.projected

// THE NATIVE EMIT VERB'S WALKED SUBJECT FOR "A PROJECTION IS NOT A MODULE REFERENCE"
// (src/v1/stage0/src/cli_run/native_lane_runner.rs walk_native_acquisition_projection_controls).
//
// `product.y` below is a field projection: `product` is the module-level value declared here, `y` its
// field. It is spelled exactly as the module `product.y` would be, and the tree this file is read from
// does store a module of that name (product/y.dag beside this root's other files), so the control can tell
// a compiler that decides what `product.y` means from the lexical frames at the site from one that decides
// it from which files exist. The walk reads this entry from three trees that differ only in that module
// (absent, malformed, well-formed) and requires the same verdict and the same emission from all three.
type Holder {
  y: Int
}

data product: Holder = Holder { y: 707070 }

data native_projection_projected_value: Int = product.y
