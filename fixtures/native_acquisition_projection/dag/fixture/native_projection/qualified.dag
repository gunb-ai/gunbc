module fixture.native_projection.qualified

// THE POSITIVE CONTROL OF THE SAME WALK: `product.y.projection_same_named_value` names no binder -- nothing
// here binds `product` -- so it IS a qualified module reference, and the module `product.y` is read for
// it. The walk requires that a well-formed product/y.dag emits through this entry and a malformed one
// refuses it, so the projection control's silence about that file is a fact of the head's binding and not
// of the file never being read at all.
data native_projection_qualified_value: Int = product.y.projection_same_named_value
