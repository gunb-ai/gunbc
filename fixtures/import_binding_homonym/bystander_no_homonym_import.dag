module fixture.import_binding_homonym.bystander_no_homonym_import

import std.types { Int }
import v2.std.integer { OverflowDisposition, Wrapping }

// ARM C's BYSTANDER. It puts v2.std.integer in the closure -- so the emitted crate still carries
// TWO `UInt8` type aliases, one per declaring module -- while naming NOTHING that collides in its
// own import list. OverflowDisposition is declared only by v2.std.integer.
//
// This is the arm that separates the two candidate causes. If the consumer's use-line survives
// here, the drop is caused by a BYSTANDER IMPORTING THE COLLIDING NAME, which is the "last
// same-named import in the closure wins" mechanism. If the line disappears here too, the import
// list is irrelevant and the cause is the crate carrying two declarations of the spelling.
fn bystander_disposition() -> OverflowDisposition {
  Wrapping
}
