module fixture.import_binding_homonym.nominal_consumer

import std.types { Int, List }
import std.termination { TerminationProof }

// THE SECOND CONSUMER, over a NON-PHANTOM dual-declared spelling. std.termination
// TerminationProof is a record with a `dimensions` field; v2.std.cardinality declares a different
// record under the same short name, with `non_increasing` and `strict`. That is a real meaning
// fork rather than two spellings of one concept, and unlike UInt8 both declarations have a
// genuine Rust nominal shell -- so this arm asks whether the dropped use-line needs the
// uninhabited phantom at all, or whether any two declarations of one spelling suffice.
fn proof_dimension_count(p: TerminationProof) -> Int {
  count(p.dimensions)
}
