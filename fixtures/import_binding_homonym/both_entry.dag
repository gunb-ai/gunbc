module fixture.import_binding_homonym.both_entry

import std.types { Int }
import fixture.import_binding_homonym.consumer { count_octets }
import fixture.import_binding_homonym.bystander { bystander_octet_width }

// ARM B, THE REPRO: the same consumer, with the bystander added to the closure and nothing else
// changed. One variable differs between the two arms.
fn both_probe() -> Int {
  count_octets(xs: []) + bystander_octet_width(x: 0)
}
