module fixture.import_binding_homonym.consumer

import std.types { Int, List }
import std.integer { UInt8 }

// THE CONSUMER UNDER TEST. It names ONE provider for UInt8 in its authored import list, and its
// signature spells the bare name. The emitted module must carry a use-line that binds that
// spelling to the NAMED provider -- crate::std_integer -- or it renders a type it declined to
// import, which is one module contradicting itself and refuses at rustc with E0425.
fn count_octets(xs: List<UInt8>) -> Int {
  count(xs)
}
