module fixture.import_binding_homonym.nominal_alone_entry

import std.types { Int }
import fixture.import_binding_homonym.nominal_consumer { proof_dimension_count }
import std.termination { TerminationProof }

// ARM D1, THE CONTROL: only std.termination declares TerminationProof in this closure.
fn nominal_alone_probe(p: TerminationProof) -> Int {
  proof_dimension_count(p: p)
}
