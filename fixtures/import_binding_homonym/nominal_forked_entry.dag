module fixture.import_binding_homonym.nominal_forked_entry

import std.types { Int }
import fixture.import_binding_homonym.nominal_consumer { proof_dimension_count }
import std.termination { TerminationProof }
import v2.std.cardinality { LoopBound }

// ARM D2: v2.std.cardinality joins the closure, so a SECOND TerminationProof declaration reaches
// the crate. Nothing imports that one by name -- LoopBound is the only name taken from it -- so
// this is arm C's shape over a non-phantom spelling.
fn nominal_forked_probe(p: TerminationProof) -> Int {
  proof_dimension_count(p: p)
}
