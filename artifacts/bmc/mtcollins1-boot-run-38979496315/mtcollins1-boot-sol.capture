----SECTION workload----
----ARGV workload: need=4294967296; echo workload-bytes=$need; mkdir -p /dev/shm/gunbc || exit 1; shm=$(df -B1 --output=avail /dev/shm/gunbc | tail -n 1 | tr -d ' '); ma=$(awk '/^MemAvailable:/ { printf "%.0f", $2 * 1024 }' /proc/meminfo); echo workload-shm-avail-bytes=$shm; echo workload-mem-available-bytes=$ma; fit=1; case "$shm" in ''|*[!0-9]*) fit=0;; esac; case "$ma" in ''|*[!0-9]*) fit=0;; esac; [ "$fit" = 1 ] && [ "$shm" -ge "$need" ] && [ "$ma" -ge "$need" ] || fit=0; if [ "$fit" != 1 ]; then echo workload-preflight=refused; rm -rf /dev/shm/gunbc; exit 1; fi; echo workload-preflight=fits; rc=0; for f in /dev/shm/gunbc/chunk0 /dev/shm/gunbc/chunk1; do dd if=/dev/urandom of=$f bs=1M count=2048 status=none || rc=1; done; echo workload-write-rc=$rc; a=$(sha256sum /dev/shm/gunbc/chunk0 /dev/shm/gunbc/chunk1); sa=$?; b=$(sha256sum /dev/shm/gunbc/chunk0 /dev/shm/gunbc/chunk1); sb=$?; na=$(printf '%s
' "$a" | grep -c .); nb=$(printf '%s
' "$b" | grep -c .); printf '%s
' "$a"; ok=0; [ "$rc" = 0 ] && [ "$sa" = 0 ] && [ "$sb" = 0 ] && [ "$na" = 2 ] && [ "$nb" = 2 ] && [ "$a" = "$b" ] && ok=1; [ "$ok" = 1 ] && echo workload-digest-stable=yes; rm -rf /dev/shm/gunbc; [ "$ok" = 1 ]
