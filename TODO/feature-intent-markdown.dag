{
    "intent_id": "intent-20260221-md-report",
    "title": "Add structured markdown report output to gunbc-review",
    "objective": "Currently gunbc-review outputs findings as JSON to stdout. Add a --format flag\nthat accepts \"json\" (default) or \"markdown\", producing a clean markdown-formatted\nreview summary with severity, finding descriptions, and candidate fixes when\nthe markdown format is selected.\n",
    "provider": "github",
    "success_criteria": [
        "gunbc-review --format markdown produces valid markdown output",
        "gunbc-review --format json preserves existing JSON behavior (backward compatible)",
        "Markdown output includes severity, check-id, and observation for each finding",
        "Integration test with a mock finding validates markdown rendering",
        "cargo test --workspace passes",
        "cargo clippy --all-targets -- -D warnings is clean",
    ],
    "constraints": [
        "JSON output must remain the default (backward compatible)",
        "Must use standard Rust string formatting (no external markdown library)",
        "Must adhere to existing ReviewOutput and Finding schema",
        "No new crate dependencies",
    ],
    "owner": "sdlc-agent",
    "priority": "M",
    "scope": {
        "in": [
            "gunbc-dag/src/bin/review.rs (add --format flag to BinaryArgs)",
            "lib/review/src/lib.rs (add markdown rendering function)",
            "gunbc-dag/tests/ (add integration test for --format markdown)",
        ],
        "out": [
            "HTML or other format support",
            "Changes to the ReviewOutput schema",
            "Changes to the LLM prompt or review criteria",
        ],
    },
