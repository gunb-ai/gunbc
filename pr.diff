diff --git a/dsl/services/agent/codex.dag b/dsl/services/agent/codex.dag
new file mode 100644
index 00000000..43c87017
--- /dev/null
+++ b/dsl/services/agent/codex.dag
@@ -0,0 +1,163 @@
+// services/agent/codex.dag -- Codex agent dispatch service.
+//
+// Provider-agnostic agent dispatch modeled as shell-out operations.
+// The Codex CLI is the first concrete backend; the interface is
+// generic enough to swap for any agent runner (Devin, SWE-bench,
+// local LLM agent, etc.) by changing the @shell annotation.
+//
+// Operations:
+//   Spawn       -- kick off an agent task, get a run ID
+//   PollStatus  -- check whether the agent is still working
+//   Cancel      -- abort a running task
+//   GetResult   -- retrieve the agent's output after completion
+//
+// Transport: @shell (CLI subprocess)
+// Auth: inherits from environment (CODEX_API_KEY or equivalent)
+
+module services.agent.codex
+
+service agent.Codex {
+
+  operation Spawn {
+    input {
+      prompt: String
+      repo_path: String = "."
+      model: String = "o4-mini"
+      timeout_seconds: Int = 600
+      approval_mode: String = "full-auto"
+    }
+    output {
+      run_id: String
+      status: String
+      started: Bool
+    }
+    @shell(["codex", "exec",
+            "--prompt", "{prompt}",
+            "--cwd", "{repo_path}",
+            "--model", "{model}",
+            "--timeout", "{timeout_seconds}",
+            "--approval-mode", "{approval_mode}",
+            "--output-format", "json"])
+    @mock_response(
+      status: 0,
+      body: {
+        "run_id": "codex-run-mock-001",
+        "status": "running",
+        "started": true
+      }
+    )
+  }
+
+  operation PollStatus {
+    input {
+      run_id: String
+    }
+    output {
+      status: String
+      finished: Bool
+      exit_code: Int?
+      error: String?
+    }
+    @shell(["codex", "status",
+            "--run-id", "{run_id}",
+            "--output-format", "json"])
+    @readonly
+    @mock_response(
+      status: 0,
+      body: {
+        "status": "completed",
+        "finished": true,
+        "exit_code": 0,
+        "error": null
+      }
+    )
+  }
+
+  operation Cancel {
+    input {
+      run_id: String
+      reason: String = "pipeline-cancelled"
+    }
+    output {
+      cancelled: Bool
+      final_status: String
+    }
+    @shell(["codex", "cancel",
+            "--run-id", "{run_id}",
+            "--reason", "{reason}",
+            "--output-format", "json"])
+    @mock_response(
+      status: 0,
+      body: {
+        "cancelled": true,
+        "final_status": "cancelled"
+      }
+    )
+  }
+
+  operation GetResult {
+    input {
+      run_id: String
+    }
+    output {
+      status: String
+      exit_code: Int
+      stdout: String
+      stderr: String
+      files_changed: Json
+    }
+    @shell(["codex", "result",
+            "--run-id", "{run_id}",
+            "--output-format", "json"])
+    @readonly
+    @mock_response(
+      status: 0,
+      body: {
+        "status": "completed",
+        "exit_code": 0,
+        "stdout": "Implementation complete.",
+        "stderr": "",
+        "files_changed": ["src/main.rs", "tests/integration.rs"]
+      }
+    )
+  }
+}
+
+// ── Tests ──────────────────────────────────────────────────────────
+
+test spawn_agent {
+    @tier(Unit)
+    @hermetic(true)
+
+    input spawn/prepare.prompt -> "Implement the feature described in issue #42"
+    input spawn/prepare.repo_path -> "/tmp/test-repo"
+
+    mock spawn/execute.response -> shell_response(0, "{\"run_id\":\"codex-run-001\",\"status\":\"running\",\"started\":true}")
+
+    expect result.run_id == "codex-run-001"
+    expect result.started == true
+}
+
+test poll_completed {
+    @tier(Unit)
+    @hermetic(true)
+
+    input poll/prepare.run_id -> "codex-run-001"
+
+    mock poll/execute.response -> shell_response(0, "{\"status\":\"completed\",\"finished\":true,\"exit_code\":0,\"error\":null}")
+
+    expect result.finished == true
+    expect result.exit_code == 0
+}
+
+test cancel_agent {
+    @tier(Unit)
+    @hermetic(true)
+
+    input cancel/prepare.run_id -> "codex-run-001"
+    input cancel/prepare.reason -> "timeout"
+
+    mock cancel/execute.response -> shell_response(0, "{\"cancelled\":true,\"final_status\":\"cancelled\"}")
+
+    expect result.cancelled == true
+}
diff --git a/dsl/services/github/pull_request.dag b/dsl/services/github/pull_request.dag
new file mode 100644
index 00000000..812eadb5
--- /dev/null
+++ b/dsl/services/github/pull_request.dag
@@ -0,0 +1,252 @@
+// services/github/pull_request.dag -- GitHub Pull Request API.
+//
+// Complements issues.dag for the implementation stage of the SDLC
+// pipeline. Once an agent pushes code, the pipeline creates a PR,
+// requests reviews, and merges on approval.
+//
+// Transport pattern (same as issues.dag, gist.dag):
+//   Pure prepare → REST execute (I/O boundary) → Pure parse
+
+module services.github.pull_request
+
+service github.PullRequest {
+  @endpoint("https://api.github.com")
+  @auth(BearerToken)
+
+  operation Create {
+    input {
+      owner: String
+      repo: String
+      title: String
+      body: String
+      head: String
+      base: String = "main"
+      draft: Bool = false
+    }
+    output {
+      number: Int @json("number")
+      url: String @json("html_url")
+      id: Int @json("id")
+      node_id: String @json("node_id")
+      head_sha: String @json("head.sha")
+    }
+    @rest(POST, "/repos/{owner}/{repo}/pulls")
+    @permissions(["pull_requests:write"])
+    @mock_response(
+      status: 201,
+      body: {
+        "number": 99,
+        "html_url": "https://github.com/{owner}/{repo}/pull/99",
+        "id": 9876543,
+        "node_id": "PR_mock",
+        "head": { "sha": "abc123def456" }
+      }
+    )
+  }
+
+  operation Get {
+    input {
+      owner: String
+      repo: String
+      number: Int
+    }
+    output {
+      number: Int @json("number")
+      title: String @json("title")
+      body: String @json("body")
+      state: String @json("state")
+      url: String @json("html_url")
+      head_sha: String @json("head.sha")
+      base_ref: String @json("base.ref")
+      mergeable: Bool? @json("mergeable")
+      merged: Bool @json("merged")
+    }
+    @rest(GET, "/repos/{owner}/{repo}/pulls/{number}")
+    @permissions(["pull_requests:read"])
+    @mock_response(
+      status: 200,
+      body: {
+        "number": 99,
+        "title": "Mock PR",
+        "body": "Mock PR body",
+        "state": "open",
+        "html_url": "https://github.com/{owner}/{repo}/pull/99",
+        "head": { "sha": "abc123def456" },
+        "base": { "ref": "main" },
+        "mergeable": true,
+        "merged": false
+      }
+    )
+  }
+
+  operation AddComment {
+    input {
+      owner: String
+      repo: String
+      number: Int
+      body: String
+    }
+    output {
+      id: Int @json("id")
+      url: String @json("html_url")
+    }
+    @rest(POST, "/repos/{owner}/{repo}/issues/{number}/comments")
+    @permissions(["pull_requests:write"])
+    @mock_response(
+      status: 201,
+      body: {
+        "id": 888,
+        "html_url": "https://github.com/{owner}/{repo}/pull/99#issuecomment-888"
+      }
+    )
+  }
+
+  operation Merge {
+    input {
+      owner: String
+      repo: String
+      number: Int
+      merge_method: String = "squash"
+      commit_title: String?
+      commit_message: String?
+    }
+    output {
+      merged: Bool @json("merged")
+      sha: String @json("sha")
+      message: String @json("message")
+    }
+    @rest(PUT, "/repos/{owner}/{repo}/pulls/{number}/merge")
+    @permissions(["pull_requests:write"])
+    @mock_response(
+      status: 200,
+      body: {
+        "merged": true,
+        "sha": "merge-sha-mock-001",
+        "message": "Pull Request successfully merged"
+      }
+    )
+  }
+
+  operation ListFiles {
+    input {
+      owner: String
+      repo: String
+      number: Int
+      per_page: Int = 100
+    }
+    output {
+      files: Json
