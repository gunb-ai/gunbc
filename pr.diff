+    let intake = ctx.command()
+        .arg("intake")
+        .arg("--intent")
+        .arg(&intent_path)
+        .current_dir(&root)
+        .output()
+        .expect("run intake");
+    assert!(
+        intake.status.success(),
+        "intake should succeed: {}",
+        String::from_utf8_lossy(&intake.stderr)
+    );
+
+    for stage in ["design", "design-review"] {
+        let transition = ctx.command()
+            .arg("transition")
+            .arg("--intake-key")
+            .arg("intent-20260221-canonical")
+            .arg("--stage")
