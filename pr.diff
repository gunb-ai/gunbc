+        let stderr = String::from_utf8_lossy(&run_output.stderr).into_owned();
+        let _ = std::fs::remove_dir_all(&output_dir);
+        return RuntimeOutcome::Skipped {
+            reason: format!("daglang interpreter run failed: {stderr}"),
+        };
