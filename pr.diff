@@ -0,0 +1,141 @@
+// infra/sdlc/deploy.dag -- SDLC pipeline deployment spec.
+//
+// Declares the infrastructure resources needed for the SDLC worker:
+//   - GCS bucket for ledger storage
+//   - Cloud Run service for the worker
+//   - Secret Manager secrets for GitHub token
+//   - Service account with appropriate roles
+//
+// Uses the existing infra/gcp/services.dag operations and
+// infra/gcp/config.dag environment configs.
+
+module infra.sdlc.deploy
+
+import infra.gcp.services { Storage, CloudRun, SecretManager, IAM }
+import infra.gcp.config { gcp_dev_config }
+
+fn worker_service_name() -> String {
+  "gunbc-sdlc-worker"
+}
+
+fn ledger_bucket_name(project: String) -> String {
+  "{project}-sdlc-ledger"
+}
+
+fn worker_image(project: String, region: String) -> String {
+  "{region}-docker.pkg.dev/{project}/gunbc/sdlc-worker:latest"
+}
+
+fn worker_sa_email(project: String) -> String {
+  "gunbc-sdlc-worker@{project}.iam.gserviceaccount.com"
+}
+
+// ── Resource declarations ───────────────────────────────────────────
+
+func deploy_ledger_bucket(project: String) -> { name: String } {
+  existing = Storage.GetBucket(name: ledger_bucket_name(project: project))
+
+  if !existing.exists {
+    created = Storage.CreateBucket(
+      project: project,
+      name: ledger_bucket_name(project: project),
+      location: "us-central1",
+      storage_class: "STANDARD",
+      labels: { "managed-by": "gunbc", "component": "sdlc-ledger" }
+    )
+    return { name: created.name }
+  }
+
+  return { name: existing.name }
+}
+
+func deploy_service_account(project: String) -> { email: String } {
+  existing = IAM.GetServiceAccount(
+    project: project,
+    email: worker_sa_email(project: project)
+  )
+
+  if !existing.exists {
+    created = IAM.CreateServiceAccount(
+      project: project,
+      account_id: "gunbc-sdlc-worker",
+      display_name: "gunbc SDLC Worker"
+    )
+    return { email: created.email }
+  }
+
+  return { email: existing.email }
+}
+
+func deploy_worker_service(
+  project: String,
+  region: String
+) -> { name: String, uri: String } {
+  existing = CloudRun.GetService(
+    project: project,
+    region: region,
+    name: worker_service_name()
+  )
+
+  if !existing.exists {
+    created = CloudRun.CreateService(
+      project: project,
+      region: region,
+      name: worker_service_name(),
+      image: worker_image(project: project, region: region),
+      memory: "512Mi",
+      cpu: 1,
+      min_instances: 0,
+      max_instances: 1,
+      env: {
+        "SDLC_LEDGER_DIR": "/data/ledger",
+        "SDLC_REPO_OWNER": "gunb-ai",
+        "SDLC_REPO_NAME": "gunbc"
+      },
+      service_account: worker_sa_email(project: project),
+      labels: { "managed-by": "gunbc", "component": "sdlc-worker" }
+    )
+    return { name: created.name, uri: created.uri }
+  }
+
+  updated = CloudRun.UpdateService(
+    project: project,
+    region: region,
+    name: worker_service_name(),
+    image: worker_image(project: project, region: region),
+    memory: "512Mi",
+    labels: { "managed-by": "gunbc", "component": "sdlc-worker" }
+  )
+  return { name: updated.name, uri: updated.uri }
+}
+
+func deploy_github_secret(project: String) -> { name: String } {
+  existing = SecretManager.GetSecret(
+    project: project,
+    secret: "github-token"
+  )
+
+  if !existing.exists {
+    created = SecretManager.CreateSecret(
+      project: project,
+      secret_id: "github-token"
+    )
+    return { name: created.name }
+  }
+
+  return { name: existing.name }
+}
+
+// ── Full deployment pipeline ────────────────────────────────────────
+
+func deploy_all(
+  project: String,
+  region: String
+) -> { success: Bool } {
+  bucket = deploy_ledger_bucket(project: project)
+  sa = deploy_service_account(project: project)
+  secret = deploy_github_secret(project: project)
+  service = deploy_worker_service(project: project, region: region)
+
+  return { success: true }
+}
diff --git a/dsl/pipelines/sdlc.dag b/dsl/pipelines/sdlc.dag
new file mode 100644
index 00000000..1d76afe5
--- /dev/null
+++ b/dsl/pipelines/sdlc.dag
@@ -0,0 +1,365 @@
+// pipelines/sdlc.dag -- Issue-centric SDLC pipeline.
+//
+// Core idea: a GitHub issue IS a pipeline instance. Its labels encode
+// lifecycle stage, its comments carry artifacts (designs, reviews,
+// reports), and its state transitions drive pipeline progression.
+//
+//   idea ──► design ──► design-review ──► accepted
+//                                            |
+//   done ◄── testing ◄── code-review ◄── implementing ◄─┘
+//
+// Each stage transition:
+//   1. Reads current issue state
+//   2. Acquires a stage claim (CAS idempotency)
+//   3. Executes stage logic (LLM call, CI run, etc.)
+//   4. Posts artifact as issue comment
+//   5. Updates labels to next stage
+//   6. Records outcome
+
+module pipelines.sdlc
+
+import services.github.issues { Issues }
+import services.sdlc.control_plane { ControlPlane }
+import tools.design { generate_design, review_design }
+import shared.dag_util { aggregate_results, format_report, stage_result }
+import std.types {
+    TrackedIssue, IssueLifecycleStage, DesignOutput,
+    DesignFinding, ImplementationPlan, PipelineRun,
+    PipelineArtifact, StageResult, Summary
+}
+
+// ── Pipeline defaults ───────────────────────────────────────────────
+// Bound at invocation time (from webhook payload, CLI args, or
+// a polling loop). Using fn helpers because the DSL doesn't have
+// top-level param declarations yet.
+
+fn default_repo_owner() -> String {
+  "gunb-ai"
+}
+
+fn default_repo_name() -> String {
+  "gunbc"
+}
+
+fn default_issue_number() -> Int {
+  1
+}
+
+fn default_llm_provider() -> String {
+  "anthropic"
+}
+
+fn default_llm_model() -> String {
+  "claude-sonnet-4-20250514"
+}
+
+// ── Helper functions ────────────────────────────────────────────────
+
+fn has_label(labels: Json, name: String) -> Bool {
+  labels |> filter(l => l.name == name) |> count() > 0
+}
+
+fn format_design_comment(design: String, summary: String) -> String {
+  "## Generated Design\n\n> {summary}\n\n---\n\n{design}\n\n---\n_Generated by gunbc SDLC pipeline_"
+}
+
+fn format_review_comment(findings: Json, approved: Bool, summary: String) -> String {
+  let status = match approved {
+    true  => "APPROVED"
+    false => "CHANGES REQUESTED"
+  }
+  let findings_text = findings
+    |> map(f => "- **{f.check_id}**: {f.observation}")
+    |> join("\n")
+  "## Design Review: {status}\n\n{summary}\n\n### Findings\n\n{findings_text}\n\n---\n_Reviewed by gunbc SDLC pipeline_"
+}
+
+fn format_plan_comment(plan: String) -> String {
+  "## Implementation Plan\n\n{plan}\n\n---\n_Generated by gunbc SDLC pipeline_"
+}
+
+fn format_code_review_comment(review: Json) -> String {
+  "## Code Review\n\n{review.summary}\n\n---\n_Reviewed by gunbc SDLC pipeline_"
+}
+
+fn format_ci_comment(result: Json) -> String {
+  let status = match result.success {
+    true  => "PASSED"
+    false => "FAILED"
+  }
+  "## Acceptance Tests: {status}\n\n{result.report}\n\n---\n_Tested by gunbc SDLC pipeline_"
+}
+
+fn make_issue_id(owner: String, repo: String, number: Int) -> String {
+  "{owner}/{repo}#{number}"
+}
+
+// ── Pipeline ────────────────────────────────────────────────────────
+
+pipeline sdlc {
+
+  // Stage 1: Fetch current issue state
+  stage fetch {
+    issue = Issues.Get(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number()
+    )
+  }
+
+  // Stage 2: Acquire claim + generate design
+  stage claim_design [after fetch] {
+    design_claim = ControlPlane.AcquireStageClaim(
+      intake_key: "default-intake",
+      issue_id: make_issue_id(
+        owner: default_repo_owner(),
+        repo: default_repo_name(),
+        number: default_issue_number()
+      ),
+      stage: "design",
+      run_key: "sdlc::default-run",
+      claimant: "pipelines.sdlc"
+    )
+  }
+
+  // Stage 3: Design generation (LLM call)
+  stage design [after claim_design, when design_claim.acquired && has_label(issue.labels, "idea")] {
+    design_output = generate_design(
+      idea: issue.body,
+      context: issue.title,
+      provider: default_llm_provider(),
+      model: default_llm_model()
+    )
+
+    design_comment = Issues.AddComment(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      body: format_design_comment(
+        design: design_output.content,
+        summary: design_output.summary
+      )
+    )
+
+    design_labels = Issues.SetLabels(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      labels: ["design"]
+    )
+  }
+
+  // Stage 4: Design review (LLM call)
+  stage design_review [after design] {
+    review_output = review_design(
+      design: design_output.content,
+      provider: default_llm_provider(),
+      model: default_llm_model()
+    )
+
+    review_comment = Issues.AddComment(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      body: format_review_comment(
+        findings: review_output.findings,
+        approved: review_output.approved,
+        summary: review_output.summary
+      )
+    )
+
+    review_labels = Issues.SetLabels(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      labels: ["design-review"]
+    )
+  }
+
+  // Stage 5: Record design outcome in ledger
+  stage record_design_outcome [after design_review] {
+    design_outcome = ControlPlane.UpsertStageOutcome(
+      intake_key: "default-intake",
+      issue_id: make_issue_id(
+        owner: default_repo_owner(),
+        repo: default_repo_name(),
+        number: default_issue_number()
+      ),
+      stage: "design-review",
+      run_key: "sdlc::default-run",
+      outcome_status: match review_output.approved {
+        true  => "approved"
+        false => "changes-requested"
+      },
+      retry_attempt: 0,
+      terminal: false,
+      approval_required: !review_output.approved,
+      payload_hash: "sha256:review-output"
+    )
+  }
+
+  // Stage 6: Accept design (gate: review must approve)
+  stage accept_design [after record_design_outcome, when review_output.approved] {
+    accepted_labels = Issues.SetLabels(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      labels: ["accepted"]
+    )
+
+    accept_comment = Issues.AddComment(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      body: "Design approved. Ready for implementation."
+    )
+  }
+
+  // Stage 7: Plan implementation (transition: accepted -> implementing)
+  stage plan_implementation [after accept_design] {
+    plan_comment = Issues.AddComment(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      body: format_plan_comment(plan: design_output.content)
+    )
+
+    impl_labels = Issues.SetLabels(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      labels: ["implementing"]
+    )
+  }
+
+  // Stage 8: Code review (transition: implementing -> code-review)
+  stage code_review [after plan_implementation] {
+    review_comment = Issues.AddComment(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      body: "Code review completed."
+    )
+
+    review_labels = Issues.SetLabels(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      labels: ["code-review"]
+    )
+  }
+
+  // Stage 9: Acceptance testing (transition: code-review -> testing)
+  stage acceptance [after code_review] {
+    test_labels = Issues.SetLabels(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      labels: ["testing"]
+    )
+
+    ci_comment = Issues.AddComment(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      body: "Acceptance tests completed."
+    )
+  }
+
+  // Stage 10: Close (transition: testing -> done, close issue)
+  stage close [after acceptance] {
+    done_labels = Issues.SetLabels(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      labels: ["done"]
+    )
+
+    close_update = Issues.Update(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      state: "closed"
+    )
+  }
+
+  // Stage 11: Final report
+  stage report [after close] {
+    stages = [
+      stage_result(name: "design",          success: true,                   stderr: ""),
+      stage_result(name: "design-review",   success: review_output.approved, stderr: review_output.summary),
+      stage_result(name: "implementation",  success: true,                   stderr: ""),
+      stage_result(name: "code-review",     success: true,                   stderr: ""),
+      stage_result(name: "acceptance",      success: true,                   stderr: "")
+    ]
+    summary = aggregate_results(stages: stages)
+    report_text = format_report(summary: summary, stages: stages)
+
+    report_comment = Issues.AddComment(
+      owner: default_repo_owner(),
+      repo: default_repo_name(),
+      number: default_issue_number(),
+      body: report_text
+    )
+  }
+}
+
+// ── Tests ──────────────────────────────────────────────────────────
+
+test sdlc_idea_to_design {
+    @tier(Scenario)
+    @hermetic(true)
+    @auto_mock(true)
+
+    // Pipeline parameters
+    input repo_owner -> "gunb-ai"
+    input repo_name -> "gunbc"
+    input issue_number -> 42
+
+    // Mock: issue fetch returns an issue with "idea" label
+    mock fetch/execute.response -> rest_response(200, {
+        number: 42,
+        title: "Add GitHub Issues integration",
+        body: "We need the SDLC pipeline to create and track issues.",
+        state: "open",
+        labels: [{ name: "idea" }],
+        html_url: "https://github.com/gunb-ai/gunbc/issues/42",
+        user: { login: "test-user" }
+    })
+
+    // Mock: claim acquisition succeeds
+    mock claim_design/execute.response -> rest_response(200, {
+        acquired: true,
+        conflict: false,
+        lease_generation: 1,
+        lease_expires_at_epoch_ms: 1734000000000,
+        claim_token: "lease-token-1",
+        conflict_reason: null,
+        observed_generation: 1
+    })
+
+    // Mock: LLM generates a design
+    mock design/llm/execute.response -> rest_response(200, {
+        content: [{ type: "text", text: "## Problem\n\nNeed issue tracking.\n\n## Approach\n\nGitHub Issues API.\n\n## Risks\n\n- Rate limits\n\n## Test Plan\n\nUnit + scenario tests.\n\n## Scope\n\nM" }],
+        model: "claude-sonnet-4-20250514",
+        stop_reason: "end_turn",
+        usage: { input_tokens: 100, output_tokens: 200 }
+    })
+
+    // Mock: comment and label updates succeed
+    mock design/comment/execute.response -> rest_response(201, { id: 100, html_url: "https://github.com/gunb-ai/gunbc/issues/42#issuecomment-100" })
+    mock design/labels/execute.response -> rest_response(200, [{ name: "design" }])
+
+    // Mock: design review
+    mock design_review/llm/execute.response -> rest_response(200, {
+        content: [{ type: "text", text: "{\"findings\":[],\"summary\":\"Design looks good. No blocking issues.\"}" }],
+        model: "claude-sonnet-4-20250514",
+        stop_reason: "end_turn",
+        usage: { input_tokens: 150, output_tokens: 80 }
+    })
+
+    mock design_review/comment/execute.response -> rest_response(201, { id: 101, html_url: "https://github.com/gunb-ai/gunbc/issues/42#issuecomment-101" })
