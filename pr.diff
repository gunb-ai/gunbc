+) -> Dag<LoweredOp> {
+    let mut inputs = vec![Port::scalar(element_var, "Any")];
+    for pt in passthrough {
+        inputs.push(Port::scalar(pt.as_str(), "Any"));
+    }
+    let mut dag: Dag<LoweredOp> = Dag::new();
+    dag.add_node(Node::opaque(
+        "body_op",
