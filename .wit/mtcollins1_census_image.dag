module wit.mtcollins1_census_image

import std.types { Bool, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import test.claim.mtcollins1_census_image { one_run_binds_and_answers_every_verdict_axis, a_begin_from_one_run_and_an_end_from_another_does_not_bind, an_end_before_a_begin_does_not_bind, an_unclosed_envelope_does_not_bind, a_section_from_another_run_is_not_read, the_same_text_under_two_identity_forms_is_not_one_run, the_same_text_under_one_identity_form_is_one_run, a_duplicate_section_refuses_the_capture, a_marker_without_a_run_identity_does_not_bind, the_envelope_is_bound_to_its_own_machine, a_workload_token_in_the_argv_line_is_not_a_result, seed_absent_reaches_the_installer_and_never_binds, the_two_run_identity_forms_are_distinguished, every_stage_is_bound_to_the_historical_capture, a_mutated_bound_stage_fails_the_historical_map, the_workload_requires_pass_status_and_full_coverage, the_census_roster_is_the_brief_order, the_program_writes_every_section_then_end_then_syncs_then_halts, the_seed_runs_the_census_early_and_leaves_every_section_interactive, the_boot_configuration_seeds_from_the_medium_on_the_serial_console, every_build_input_reaches_the_derivation_key, the_image_name_is_the_stem_and_the_measured_digest, the_pinned_and_current_derivations_differ_only_by_the_instrument }

fn main() -> ProcessExit {
  let failed = join([
    if one_run_binds_and_answers_every_verdict_axis() { "" } else { "one_run_binds_and_answers_every_verdict_axis " },
    if a_begin_from_one_run_and_an_end_from_another_does_not_bind() { "" } else { "a_begin_from_one_run_and_an_end_from_another_does_not_bind " },
    if an_end_before_a_begin_does_not_bind() { "" } else { "an_end_before_a_begin_does_not_bind " },
    if an_unclosed_envelope_does_not_bind() { "" } else { "an_unclosed_envelope_does_not_bind " },
    if a_section_from_another_run_is_not_read() { "" } else { "a_section_from_another_run_is_not_read " },
    if the_same_text_under_two_identity_forms_is_not_one_run() { "" } else { "the_same_text_under_two_identity_forms_is_not_one_run " },
    if the_same_text_under_one_identity_form_is_one_run() { "" } else { "the_same_text_under_one_identity_form_is_one_run " },
    if a_duplicate_section_refuses_the_capture() { "" } else { "a_duplicate_section_refuses_the_capture " },
    if a_marker_without_a_run_identity_does_not_bind() { "" } else { "a_marker_without_a_run_identity_does_not_bind " },
    if the_envelope_is_bound_to_its_own_machine() { "" } else { "the_envelope_is_bound_to_its_own_machine " },
    if a_workload_token_in_the_argv_line_is_not_a_result() { "" } else { "a_workload_token_in_the_argv_line_is_not_a_result " },
    if seed_absent_reaches_the_installer_and_never_binds() { "" } else { "seed_absent_reaches_the_installer_and_never_binds " },
    if the_two_run_identity_forms_are_distinguished() { "" } else { "the_two_run_identity_forms_are_distinguished " },
    if every_stage_is_bound_to_the_historical_capture() { "" } else { "every_stage_is_bound_to_the_historical_capture " },
    if a_mutated_bound_stage_fails_the_historical_map() { "" } else { "a_mutated_bound_stage_fails_the_historical_map " },
    if the_workload_requires_pass_status_and_full_coverage() { "" } else { "the_workload_requires_pass_status_and_full_coverage " },
    if the_census_roster_is_the_brief_order() { "" } else { "the_census_roster_is_the_brief_order " },
    if the_program_writes_every_section_then_end_then_syncs_then_halts() { "" } else { "the_program_writes_every_section_then_end_then_syncs_then_halts " },
    if the_seed_runs_the_census_early_and_leaves_every_section_interactive() { "" } else { "the_seed_runs_the_census_early_and_leaves_every_section_interactive " },
    if the_boot_configuration_seeds_from_the_medium_on_the_serial_console() { "" } else { "the_boot_configuration_seeds_from_the_medium_on_the_serial_console " },
    if every_build_input_reaches_the_derivation_key() { "" } else { "every_build_input_reaches_the_derivation_key " },
    if the_image_name_is_the_stem_and_the_measured_digest() { "" } else { "the_image_name_is_the_stem_and_the_measured_digest " },
    if the_pinned_and_current_derivations_differ_only_by_the_instrument() { "" } else { "the_pinned_and_current_derivations_differ_only_by_the_instrument " }
  ], "")
  if failed == "" { ExitSuccess } else { exit_failure(reason: failed) }
}
