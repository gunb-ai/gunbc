module wit.srv3_seeded_install_media_real_execution

import std.types { Bool, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import test.claim.srv3_seeded_install_media_real_execution { install_media_remaster_ensure_grub_cmdline_inserts_by_real_execution, a_seed_artifact_is_fetched_read_back_and_an_escaping_name_moves_no_byte_by_real_execution }

fn main() -> ProcessExit {
  let failed = join([
    if install_media_remaster_ensure_grub_cmdline_inserts_by_real_execution() { "" } else { "install_media_remaster_ensure_grub_cmdline_inserts_by_real_execution " },
    if a_seed_artifact_is_fetched_read_back_and_an_escaping_name_moves_no_byte_by_real_execution() { "" } else { "a_seed_artifact_is_fetched_read_back_and_an_escaping_name_moves_no_byte_by_real_execution " }
  ], "")
  if failed == "" { ExitSuccess } else { exit_failure(reason: failed) }
}
