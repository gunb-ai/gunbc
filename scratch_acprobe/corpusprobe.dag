decl_ref(module_path: \"extdeps.ssh.openssh_client_commands\", decl_name: \"ssh_keygen_public_key_command\"),\n    decl_ref(module_path: \"extdeps.ssh.openssh_client_commands\", decl_name: \"ssh_keygen_fingerprint_command\"),\n    decl_ref(module_path: \"extdeps.ssh.openssh_client_commands\", decl_name: \"ssh_keygen_known_hosts_find_command\"),\n    decl_ref(module_path: \"extdeps.ssh.openssh_client_commands\", decl_name: \"ssh_keyscan_command\"),\n    decl_ref(module_path: \"extdeps.ssh.openssh_client_commands\", decl_name: \"ssh_add_list_identities_command\"),\n    decl_ref(module_path: \"extdeps.ssh.openssh_client_commands\", decl_name: \"scp_download_command\"),\n    decl_ref(module_path: \"extdeps.ssh.openssh_client_commands\", decl_name: \"scp_upload_command\"),\n    decl_ref(module_path: \"extdeps.systemd.systemctl\", decl_name: \"systemctl_enable_now_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_config_local_set_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_clone_shallow_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_fetch_shallow_revision_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_checkout_revision_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_rev_parse_head_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_status_porcelain_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_apply_check_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_apply_reverse_check_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_apply_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_diff_binary_head_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_reset_hard_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_name: \"git_worktree_add_detached_command\"),\n    decl_ref(module_path: \"extdeps.git\", decl_