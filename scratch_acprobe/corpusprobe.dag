fn corpus_admits_verdict() -> Symbol {
  match assemble_program_from_ingest(
    ingest: Cons {
      head: probe_source(src: "module extdeps.git\n\nimport std.types { List }\nimport extdeps.exec.program { ProgramIdentity }\nimport extdeps.exec.command { ArgvCommand, argv_command }\n\nfn git_config_local_set_command(p: ProgramIdentity, args: List<String>) -> ArgvCommand = argv_command(program: p, arguments: args)\n", artifact: probe_artifact, cu: ^cu_peer),
      tail: Cons {
      head: probe_source(src: "module extdeps.exec.command\n\nimport extdeps.exec.program { ProgramIdentity, cataloged_program }\n\nimport std.types { NonEmptyStr, String, List }\nimport extdeps.external_authority { ExternalAuthority }\nimport extdeps.uri { Uri, Https }\nimport extdeps.posix.shell_command_language { posix_single_quote }\nimport v2.std.orchestration { EnvBinding }\nimport extdeps.tools.env { env_path_resolved_program, env_prefixed_args, env_absolute_program, env_ignore_environment_flag, env_chdir_flag }\nimport gunbc.remote_shell_command {\n  RemoteExecCommandInterpretation,\n  RemoteExecCommandOutcome,\n  RemoteExecCommandBuilt,\n  RemoteExecCommandRefused,\n  RemoteExecCommandRefusalCause,\n  remote_exec_command_rendered,\n  remote_exec_command_string,\n}\n\ndata extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {\n  uri: Uri {\n    scheme: Https\n    locator: \"man7.org/linux/man-pages/man1/ssh.1.html\"\n  }\n}\n\n// THE ARGV CONSTRUCTION WALL. ArgvCommand was a plain record, so every module could write\n// `ArgvCommand { argv: [\"curl\", \"-fsL\", \"-o\", dest, url] }` at the call site and the flags of a tool\n// this repository does not own lived wherever someone happened to need them. That is the anemic\n// modeling DESIGN §2 names -- a String leaf hiding named parts -- and it is what made the omitted\n// `--fail` fail-open class writable (gunbc.plans.transport_argv_anemia_dissolution, Lane B).\n//\n// It is now sole_constructor: only this module may build one, and `argv_command` below is the single\n// admitted route in, caller-sealed BY NAME to the typed builders that derive an argv from a cited\n// authority. A hand-spelled word list has no route to a process that does not pass through one of\n// them, so \"which flags does this tool take\" is answered in the tool's own extdeps module and\n// nowhere else. Adding a command is an edit to the admit list in this file -- a conspicuous, counted\n// review event -- rather than an import a caller can write in their own.\n//\n// THE PROGRAM IS NOT AN ARGUMENT. execve takes the executable and the argument vector as distinct\n// parameters, and this carrier now does the same, for the reason already recorded at\n// extdeps.shell.exec RunArgv: conflating them is a state-space collapse. It also makes the EMPTY\n// argv -- a command naming no program to execute -- unrepresentable rather than refused after the\n// fact (DESIGN §4b: structurally impossible beats mechanically preventable). The two\n// `HeadAbsent => empty argv` refusal arms in gunbc.command_runner dissolve with this shape; there is\n// always a program, so there is nothing left to refuse.\n//\n// The program is a ProgramIdentity (extdeps.exec.program), not a string: which program a command\n// runs is minted once, by a sealed row whose admission IS the census of what gunbc executes, so a\n// builder cannot name a program the census does not already count.\ntype ArgvCommand sole_constructor {\n  program: ProgramIdentity\n  arguments: List<String>\n}\n\n// THE ONE MINT. It takes the program and its operands, and gates WHO may call it. Every admitted\n// caller is a named builder for ONE operation of ONE tool, homed in that tool's own extdeps module\n// beside its cited upstream authority -- never here: a generic hub may define the agnostic shape but\n// may not enumerate concrete products (DESIGN §3, external upstream decomposition). That is why the\n// six builders this module used to carry (curl_download_command, mkdir_p_command,\n// tar_extract_command, make_command, sed_in_place_command, cp_command) are GONE from this file and\n// live in extdeps.tools.{curl,mkdir,tar,make,sed,gnu_coreutils}: sealing the record while keeping\n// the product rows in the hub would have made this module the one place every tool's flags collect.\n//\n// TWO CONCRETE PRODUCTS DO STILL LIVE IN THIS FILE -- sshpass and OpenSSH's ssh/scp -- and that is a\n// stated exception rather than an oversight in the rule above. They are not here as tools a caller\n// picks; they are the REALIZATION of the CommandTransport coproduct this module declares, so\n// command_over_transport cannot compose an SshExec without naming them. Moving them out would leave\n// the transport unable to build its own outer invocation, or force an import cycle to get it back.\n// If a second ssh realization ever lands, that is the moment this becomes a real product\n// enumeration and the pair moves to extdeps.ssh with the transport dispatching over them.\n//\n// No test declaration is admitted. A witness obtains an ArgvCommand through a production builder,\n// the same way production does -- the rule extdeps.shell.exec transport_script_seal already sets.\nfn argv_command(program: ProgramIdentity, arguments: List<String>) -> ArgvCommand\n  admit_callers: [\n    decl_ref(module_path: \"extdeps.ssh.openssh_port_forwarding\", decl_name: \"ssh_stdio_forward_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"install_file_owned_command\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"scp_command\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"env_prefixed_command\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"env_prefixed_command_in\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"env_cleared_command_in\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"env_cleared_command\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"command_over_transport\"),\n    decl_ref(module_path: \"extdeps.tools.curl\", decl_name: \"curl_download_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_create_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_start_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_stop_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_exec_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_pull_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_container_inspect_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_ps_running_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_ps_running_all_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_build_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_build_spec_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_digest_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_save_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_load_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_inspect_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_info_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_run_ephemeral_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_remove_force_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_rename_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_logs_command\"),\n    decl_ref(module_path: \"extdeps.tools.tar\", decl_name: \"tar_extract_command\"),\n    decl_ref(module_path: \"extdeps.tools.tar\", decl_name: \"tar_create_from_list_command\"),\n    decl_ref(module_path: \"extdeps.tools.tar\", decl_name: \"tar_list_command\"),\n    decl_ref(module_path: \"extdeps.tools.btrfs_progs\", decl_name: \"btrfs_subvolume_create_command\"),\n    decl_ref(module_path: \"extdeps.tools.btrfs_progs\", decl_name: \"btrfs_subvolume_snapshot_read_only_command\"),\n    decl_ref(module_path: \"extdeps.tools.btrfs_progs\", decl_name: \"btrfs_subvolume_delete_command\"),\n    decl_ref(module_path: \"extdeps.tools.kopia\", decl_name: \"kopia_repository_create_filesystem_command\"),\n    decl_ref(module_path: \"extdeps.tools.kopia\", decl_name: \"kopia_snapshot_create_command\"),\n    decl_ref(module_path: \"extdeps.tools.findutils\", decl_name: \"find_regular_files_sha256_command\"),\n    decl_ref(module_path: \"extdeps.tools.findutils\", decl_name: \"find_owner_executable_files_command\"),\n    decl_ref(module_path: \"extdeps.tools.findutils\", decl_name: \"find_symlink_targets_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"mv_exact_destination_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"sort_in_place_command\"),\n    decl_ref(module_path: \"extdeps.tools.unzip\", decl_name: \"unzip_extract_command\"),\n    decl_ref(module_path: \"extdeps.tools.ldd\", decl_name: \"ldd_command\"),\n    decl_ref(module_path: \"extdeps.tools.dpkg_deb\", decl_name: \"dpkg_deb_extract_command\"),\n    decl_ref(module_path: \"extdeps.tools.node\", decl_name: \"node_eval_command\"),\n    decl_ref(module_path: \"extdeps.tools.node\", decl_name: \"node_version_command\"),\n    decl_ref(module_path: \"extdeps.browser.chromium\", decl_name: \"chromium_version_command\"),\n    decl_ref(module_path: \"extdeps.tools.squashfs_tools\", decl_name: \"unsquashfs_extract_command\"),\n    decl_ref(module_path: \"extdeps.tools.e2fsprogs\", decl_name: \"mke2fs_populate_command\"),\n    decl_ref(module_path: \"extdeps.tools.e2fsprogs\", decl_name: \"mke2fs_format_command\"),\n    decl_ref(module_path: \"extdeps.tools.e2fsprogs\", decl_name: \"dumpe2fs_superblock_command\"),\n    decl_ref(module_path: \"extdeps.nftables.ruleset\", decl_name: \"nft_list_table_command\"),\n    decl_ref(module_path: \"extdeps.tools.conntrack\", decl_name: \"conntrack_delete_command\"),\n    decl_ref(module_path: \"extdeps.tools.conntrack\", decl_name: \"conntrack_li