module scratch.acprobe

// DBG-PROBE (temporary, untracked): does the corpus route execute the admit-wall carrier AND
// judge on real corpus text? Subject = real argv_command (verbatim, full 186-entry roster);
// peers = the real rostered docker_rename_command (expect admitted) and a non-rostered caller
// (expect refused). Deleted with the diagnosis.

import extdeps.communication.medium { Lossless, Medium }
import std.algebra { Cons, Empty }
import v2.compiler.infer { infer }
import v2.compiler.name_resolve { Admission, ResolutionSubject }
import v2.compiler.program_assembly { assemble_program_from_ingest }
import v2.compiler.resolve { ResolvedTree }
import v2.compiler.source_authority { DagSourceReadWitness }
import v2.extdeps.languages.dag { dag_language_model }
import v2.std.artifact { Artifact, SourceFile }
import v2.std.cross_tree.import_model { V2Tree }
import v2.std.diagnostic { Accepted, Outcome, Rejected, Suggested, Unavailable }
import v2.std.node { Symbol, Node, Edge, Authored, symbol_lexeme }
import v2.std.text { String }

data probe_artifact: Artifact = Artifact {
  kind: SourceFile,
  id: ^probe_artifact,
  file_path: "scratch_acprobe/probe_subject_unit.dag"
}

fn probe_source(src: String, artifact: Artifact, cu: Symbol) -> DagSourceReadWitness {
  DagSourceReadWitness {
    source: Medium { carried: src, fidelity: Lossless },
    artifact: artifact,
    compilation_unit: cu,
    source_root: V2Tree
  }
}

fn probe_assembled(unit_b: DagSourceReadWitness) -> Outcome<ResolvedTree> {
  assemble_program_from_ingest(
    ingest: Cons {
      head: probe_source(src: "module aca\n\nimport std.types { NonEmptyStr, String, List }\n\n// DBG-PROBE (temporary): mechanism probe over real corpus text. ProgramIdentity is shimmed to\n// its real sole shape minus the catalog field (the imported program.dag closure); the\n// ArgvCommand type and the argv_command fn are VERBATIM from dag/extdeps/exec/command.dag\n// including the full 186-entry admit_callers roster.\ntype ProgramIdentity sole_constructor {\n  invocation: NonEmptyStr\n}\n\ntype ArgvCommand sole_constructor {\n  program: ProgramIdentity\n  arguments: List<String>\n}\n\nfn argv_command(program: ProgramIdentity, arguments: List<String>) -> ArgvCommand\n  admit_callers: [\n    decl_ref(module_path: \"extdeps.ssh.openssh_port_forwarding\", decl_name: \"ssh_stdio_forward_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"install_file_owned_command\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"scp_command\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"env_prefixed_command\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"env_prefixed_command_in\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"env_cleared_command_in\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"env_cleared_command\"),\n    decl_ref(module_path: \"extdeps.exec.command\", decl_name: \"command_over_transport\"),\n    decl_ref(module_path: \"extdeps.tools.curl\", decl_name: \"curl_download_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_create_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_start_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_stop_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_exec_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_pull_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_container_inspect_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_ps_running_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_ps_running_all_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_build_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_build_spec_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_digest_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_save_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_load_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_image_inspect_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_info_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_run_ephemeral_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_remove_force_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_rename_command\"),\n    decl_ref(module_path: \"extdeps.docker.cli\", decl_name: \"docker_logs_command\"),\n    decl_ref(module_path: \"extdeps.tools.tar\", decl_name: \"tar_extract_command\"),\n    decl_ref(module_path: \"extdeps.tools.tar\", decl_name: \"tar_create_from_list_command\"),\n    decl_ref(module_path: \"extdeps.tools.tar\", decl_name: \"tar_list_command\"),\n    decl_ref(module_path: \"extdeps.tools.btrfs_progs\", decl_name: \"btrfs_subvolume_create_command\"),\n    decl_ref(module_path: \"extdeps.tools.btrfs_progs\", decl_name: \"btrfs_subvolume_snapshot_read_only_command\"),\n    decl_ref(module_path: \"extdeps.tools.btrfs_progs\", decl_name: \"btrfs_subvolume_delete_command\"),\n    decl_ref(module_path: \"extdeps.tools.kopia\", decl_name: \"kopia_repository_create_fil