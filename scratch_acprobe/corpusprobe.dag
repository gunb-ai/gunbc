decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"cat_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"mktemp_directory_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"dd_overwrite_path_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"mkdir_parents_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"ln_hard_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"ls_long_directory_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"ls_long_directory_numeric_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"od_hex_span_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"rm_force_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"rm_recursive_force_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"rm_recursive_force_one_file_system_command\"),\n    decl_ref(module_path: \"extdeps.tools.util_linux_umount\", decl_name: \"umount_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"ln_symbolic_force_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"timeout_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"printf_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"true_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"whoami_command\"),\n    decl_ref(module_path: \"extdeps.tools.gnu_coreutils\", decl_name: \"pwd_command\"),\n    decl_ref(module_path: \"extdeps.posix.getent\", decl_name: \"getent_passwd_command\"),\n    decl_ref(module_path: \"extdeps.tools.gcloud\", decl_name: \"gcloud_auth_list_accounts_command\"),\n    decl_ref(module_path: \"extdeps.to