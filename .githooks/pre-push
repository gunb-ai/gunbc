#!/usr/bin/env bash
# Pre-push hook: fmt check on push. On drift, auto-fix + commit
# locally (convenience), then ABORT THE PUSH so the developer
# re-runs git push to pick up the new commit.
#
# Why not auto-continue the push?  Git resolves the local SHA and
# builds the push pack BEFORE calling this hook. A commit created
# inside the hook advances the local ref, but git already captured
# the pre-hook SHA in the pack — the new commit stays local and
# never reaches the remote. See PR #509 review (codex 35d67a7d).
#
# Decision table:
#   Delete-only push         → skip entirely (nothing to fmt-check)
#   Push includes HEAD, clean → exit 0, push proceeds
#   Push includes HEAD, drift → auto-fix + auto-commit + ABORT
#                                (developer re-runs `git push`)
#   Push excludes HEAD, clean → exit 0, push proceeds
#   Push excludes HEAD, drift → fail with actionable message
#                                (don't auto-commit to a ref that
#                                 isn't even being pushed)
#
# Enable via: scripts/install-hooks.sh (sets core.hooksPath .githooks)

set -e

ZERO_SHA="0000000000000000000000000000000000000000"
current_head=$(git rev-parse HEAD 2>/dev/null || echo "")

pushes_content=0
current_head_in_push=0

# Pre-push stdin format (one line per ref being pushed):
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# All-zero local_sha means delete (no content pushed for this ref).
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" == "$ZERO_SHA" ]]; then
    continue  # delete, no content to check
  fi
  pushes_content=1
  if [[ "$local_sha" == "$current_head" ]]; then
    current_head_in_push=1
  fi
done

# Delete-only push (e.g., `git push origin --delete branch-name`): skip.
if [[ "$pushes_content" == "0" ]]; then
  exit 0
fi

# If auto-commit is in scope (HEAD is being pushed), require a clean tree.
# Don't silently sweep uncommitted work into a fmt commit.
if [[ "$current_head_in_push" == "1" ]]; then
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "[pre-push] uncommitted changes in working tree — commit or stash before pushing."
    exit 1
  fi
fi

echo "[pre-push] cargo fmt --all --check"
if cargo fmt --all --check 2>/dev/null; then
  exit 0  # clean, push proceeds
fi

# Fmt drift detected. Two paths:
if [[ "$current_head_in_push" == "0" ]]; then
  # Push doesn't include current HEAD — auto-committing would land on a
  # ref that isn't being pushed. Fail with an actionable message.
  echo ""
  echo "[pre-push] fmt drift detected, but the push doesn't include the current HEAD."
  echo "[pre-push] auto-commit would land on a ref that isn't being pushed."
  echo ""
  echo "Either:"
  echo "  - switch to the branch you intend to push and push again (hook will auto-fix), or"
  echo "  - run 'cargo fmt --all' now, commit, and include the fmt fix in your push."
  exit 1
fi

# HEAD is being pushed. Auto-fix + commit as a convenience, then
# abort the push so the developer re-runs and the new commit ships.
echo "[pre-push] fmt drift detected; running cargo fmt --all"
cargo fmt --all

# Only stage tracked files; never sweep up untracked files.
git add -u

if git diff --cached --quiet; then
  # cargo fmt --check reported drift but --all produced no diff?
  # Shouldn't happen; fail loud rather than exit silently.
  echo "[pre-push] cargo fmt --check reported drift but cargo fmt --all produced no diff."
  echo "[pre-push] this shouldn't happen; please investigate. Aborting push."
  exit 1
fi

git commit -m "chore: apply cargo fmt"

echo ""
echo "[pre-push] fmt fixes committed locally as 'chore: apply cargo fmt'."
echo "[pre-push] Git has already built the push pack with the pre-hook SHA, so"
echo "[pre-push] the new commit would NOT reach the remote on this push."
echo ""
echo "Run 'git push' again to push the fmt commit alongside your original work."
echo ""
exit 1
