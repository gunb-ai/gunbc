#!/usr/bin/env bash
# Pre-push hook: tidy floor gates (doc reachability + generated-artifact drift)
# and fmt check. On auto-fixable drift, commit locally then ABORT THE PUSH so
# the developer re-runs git push to pick up the new commit.
#
# SCAFFOLD — tidy-gate orchestration dissolves-on: emit from gunbc.local_tidy_spec
# + extdeps.git.hooks (see stern-moth-225 model sketch). Gate entrypoints are
# single-authority .dag witnesses; this shell is interim transport.
#
# Why not auto-continue the push after auto-commit? Git resolves the local SHA and
# builds the push pack BEFORE calling this hook. See PR #509 review (codex 35d67a7d).
#
# Enable via: git config core.hooksPath .githooks

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=lib/tidy-gates.sh
source "$ROOT/.githooks/lib/tidy-gates.sh"

ZERO_SHA="0000000000000000000000000000000000000000"

head_ref=$(git symbolic-ref HEAD 2>/dev/null || echo "")

pushes_content=0
head_branch_in_push=0
declare -a PUSH_LINES=()
declare -a PUSH_CHANGED=()

collect_push_changed() {
  local local_ref="$1" local_sha="$2" remote_ref="$3" remote_sha="$4"
  local range_base range_head

  if [[ "$local_sha" == "$ZERO_SHA" ]]; then
    return 0
  fi

  range_head="$local_sha"
  if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
    range_base="$(git hash-object -t tree /dev/null)"
  else
    range_base="$remote_sha"
  fi

  local path
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local seen=0 existing
    for existing in ${PUSH_CHANGED[@]+"${PUSH_CHANGED[@]}"}; do
      if [[ "$existing" == "$path" ]]; then
        seen=1
        break
      fi
    done
    if [[ "$seen" == "0" ]]; then
      PUSH_CHANGED+=("$path")
    fi
  done < <(git diff --name-only --diff-filter=ACMR "$range_base" "$range_head")
}

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  PUSH_LINES+=("$local_ref $local_sha $remote_ref $remote_sha")
  if [[ "$local_sha" == "$ZERO_SHA" ]]; then
    continue
  fi
  pushes_content=1
  collect_push_changed "$local_ref" "$local_sha" "$remote_ref" "$remote_sha"
  if [[ -n "$head_ref" ]] && [[ "$local_ref" == "$head_ref" ]]; then
    head_branch_in_push=1
  fi
done

if [[ "$pushes_content" == "0" ]]; then
  exit 0
fi

if [[ "$head_branch_in_push" == "1" ]]; then
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "[pre-push] uncommitted changes in working tree — commit or stash before pushing."
    exit 1
  fi
fi

# --- tidy gates (scoped to files in the push range) -------------------------
if [[ ${#PUSH_CHANGED[@]} -gt 0 ]]; then
  printf '%s\n' "${PUSH_CHANGED[@]}" | tidy_gates_run_if_needed
fi

# Regen may have staged projection updates; commit + abort like fmt auto-fix.
if ! git diff --cached --quiet; then
  if [[ "$head_branch_in_push" != "1" ]]; then
    echo "[pre-push] regen staged changes but HEAD's branch is not in this push — commit manually."
    exit 1
  fi
  git commit -m "chore: regenerate committed projections"
  echo ""
  echo "[pre-push] projection regen committed locally."
  echo "[pre-push] Re-run 'git push' to include the regen commit."
  echo ""
  exit 1
fi

# --- cargo fmt (existing behavior) ------------------------------------------
echo "[pre-push] cargo fmt --all --check"
if cargo fmt --all --check 2>/dev/null; then
  exit 0
fi

if [[ "$head_branch_in_push" == "0" ]]; then
  echo ""
  if [[ -z "$head_ref" ]]; then
    echo "[pre-push] fmt drift detected, but HEAD is detached — no current branch to auto-commit onto."
    echo ""
    echo "Attach HEAD to a branch (git checkout <branch>) and push again, or"
    echo "run 'cargo fmt --all' and commit the fix explicitly."
  else
    echo "[pre-push] fmt drift detected, but the push doesn't include the current branch ($head_ref)."
    echo "[pre-push] auto-commit would land on a ref that isn't being pushed."
    echo ""
    echo "Either:"
    echo "  - switch to the branch you intend to push and push again (hook will auto-fix), or"
    echo "  - run 'cargo fmt --all' now, commit, and include the fmt fix in your push."
  fi
  exit 1
fi

echo "[pre-push] fmt drift detected; running cargo fmt --all"
cargo fmt --all
git add -u

if git diff --cached --quiet; then
  echo "[pre-push] cargo fmt --check reported drift but cargo fmt --all produced no diff."
  echo "[pre-push] this shouldn't happen; please investigate. Aborting push."
  exit 1
fi

git commit -m "chore: apply cargo fmt"

echo ""
echo "[pre-push] fmt fixes committed locally as 'chore: apply cargo fmt'."
echo "[pre-push] Git has already built the push pack with the pre-hook SHA, so"
echo "[pre-push] the new commit would NOT reach the remote on this push."
echo ""
echo "Run 'git push' again to push the fmt commit alongside your original work."
echo ""
exit 1
