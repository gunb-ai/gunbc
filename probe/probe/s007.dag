module probe.s007

import std.types { String, List }
import extdeps.communication.medium { Medium, Lossless }
import v2.compiler.source_authority { parse_dag_source_ast }
import v2.std.diagnostic { Accepted, Rejected, NonEmptyDiagnostics }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.compiler.self_host.frontier_probe_assemble_detail {
  frontier_probe_assemble_located_reason_from_diagnostics,
  diagnostic_reason_is_overlap_residue
}
import v2.std.algebra { fold_list, length }
import extdeps.filesystem.filesystem_io { Filesystem }

data paths: List<String> = [
  "dag/test/fixture/sole_constructor_sealed/admitted_caller.dag",
  "dag/test/claim/filesystem_read_hermetic_witness.dag",
  "dag/extdeps/llm/cursor_stream.dag",
  "src/v2/std/emit_on_demand.dag",
  "src/v2/test/claim/impossible_bug/release_demos_test.dag",
  "src/v2/test/claim/long/accumulator_copy_compile_gate_test.dag",
  "dag/extdeps/formats/dnsmasq.dag",
  "src/v2/test/claim/infer_self_grounding_wall_test.dag",
  "src/v2/lens/ownership/subject_roster.dag",
  "src/v2/test/claim/enforcement/lens_module_gate_witness_test.dag",
  "dag/extdeps/filesystem/linux.dag",
  "dag/test/claim/principal_projection_witness_test.dag",
  "src/v2/test/claim/bash_program_fold_test.dag",
  "dag/extdeps/bmc/aspeed_ast2500.dag",
  "src/v2/test/compiler/pipeline/lower_stage_test.dag",
  "dag/test/claim/required_expr_newline_continuation_witness_test.dag",
  "dag/tools/merge_admission_capture.dag"
]

fn refusal_row(path: String, ds: NonEmptyDiagnostics) -> String {
  let head_reason = symbol_lexeme(sym: ds.head.reason)
  let located = symbol_lexeme(sym: frontier_probe_assemble_located_reason_from_diagnostics(d: ds))
  let tail_len = to_string(length(xs: ds.tail))
  let masked = if diagnostic_reason_is_overlap_residue(d: ds.head) { "HEAD_IS_RESIDUE" } else { "HEAD_IS_CAUSE" }
  let a = concat("\nR\t", path)
  let b = concat(a, concat("\t", head_reason))
  let c = concat(b, concat("\t", located))
  let d = concat(c, concat("\t", tail_len))
  concat(d, concat("\t", masked))
}

fn one(path: String) -> String {
  let r = Filesystem.Read(path: path)
  match parse_dag_source_ast(source: Medium { carried: r.content, fidelity: Lossless }) {
    Accepted { value: _, diagnostics: _ } => concat("\nA\t", path)
    Rejected { diagnostics: ds } => refusal_row(path: path, ds: ds)
  }
}

fn run_s007() -> String {
  fold_list(xs: paths, empty: "", cons: fn(acc, p) { concat(acc, one(path: p)) })
}
