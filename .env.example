# SDLC Pipeline — Environment Variables
# Copy to .env.local and fill in values.
# .env, .env.local, and .env.*.local are gitignored.

# ── Required for local profile ──────────────────────────────────────

# GitHub PAT with `repo` scope — used by IssueProvider (GitHub Issues API)
GITHUB_TOKEN=

# Anthropic API key — used by Design, DesignReview, and CodeReview stages
ANTHROPIC_API_KEY=

# Codex API key — used by AgentProvider (Codex CLI subprocess)
CODEX_API_KEY=

# ── Optional overrides ──────────────────────────────────────────────

# Deployment profile: local | cloud_run | unit_test
# SDLC_PROFILE=local

# Worker identity for claim ownership (default: worker-{pid}-{epoch})
# SDLC_WORKER_ID=

# GitHub org/owner (default: gunb-ai)
# SDLC_REPO_OWNER=gunb-ai

# GitHub repo name (default: gunbc)
# SDLC_REPO_NAME=gunbc

# LLM provider selection (default: anthropic)
# SDLC_LLM_PROVIDER=anthropic

# LLM model ID (default: claude-sonnet-4-20250514)
# SDLC_LLM_MODEL=claude-sonnet-4-20250514

# OpenAI API key — optional, only if SDLC_LLM_PROVIDER=openai
# OPENAI_API_KEY=
