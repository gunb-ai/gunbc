module scratch.qual_nat_repro

import v2.std.nat { Nat, Zero, Succ, nat_mul }
import v2.std.logic { Bool }

fn classify_qualified(value: v2.std.nat.Nat) -> Bool {
  match value {
    v2.std.nat.Zero => true
    v2.std.nat.Succ { prev: p } => false
  }
}

fn three() -> Nat {
  Succ { prev: Succ { prev: Succ { prev: Zero } } }
}

test fn qualified_pattern_matches_grounded_zero() -> Bool {
  classify_qualified(value: nat_mul(a: Zero, b: three()))
}

test fn bare_pattern_control() -> Bool {
  match nat_mul(a: Zero, b: three()) {
    Zero => true
    Succ { prev: p } => false
  }
}
