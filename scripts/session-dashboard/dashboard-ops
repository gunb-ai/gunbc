#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  dashboard-ops logs [out|err] [tail]
  dashboard-ops events [session-id] [limit]
  dashboard-ops graph [session-id]
  dashboard-ops reviews <repo#pr|pr-url|pr-number> [repo]
  dashboard-ops gates [ready|mine|all]
  dashboard-ops gate-ack <gate-id> [note]
  dashboard-ops gate-nack <gate-id> [reason]
  dashboard-ops gate-claim <gate-id> [note]
  dashboard-ops gate-bind <gate-id> [issue-url|-] [pr-url|-] [session-id|-] [note]
  dashboard-ops work-items [ready|mine|all]
  dashboard-ops work-items create [--owner-session-id <session-id>] [--shape leaf|composite|bucket] <title>
  dashboard-ops escalate <title>
  dashboard-ops replan <reason>
  dashboard-ops archive [session-id] [--cascade] [--force]
  dashboard-ops declare <leaf|composite|bucket>
  dashboard-ops bucket-drain <node-id> <note>
  dashboard-ops messages [mine|reports] [hours] [limit]
  dashboard-ops redispatch <work-item-id-or-url> <new-owner-session-id> [session-id|-] [reason]
  dashboard-ops decisions [owner|session] [session-id]
  dashboard-ops decision <ack|escalate|resolve|default> <decision-id> [note]

Reads dashboard operational state from $DASHBOARD_URL. Local container
sessions may also have read-only service logs at /dashboard-logs.
EOF
}

dash_url="${DASHBOARD_URL:-}"
if [[ -r /run/dashboard.env ]]; then
  # shellcheck disable=SC1091
  source /run/dashboard.env
  dash_url="${DASHBOARD_URL:-}"
fi
if [[ -z "$dash_url" ]]; then
  echo "dashboard-ops: DASHBOARD_URL is not set" >&2
  exit 2
fi
dash_url="${dash_url%/}"

repo_from_git() {
  local remote
  remote="$(git remote get-url origin 2>/dev/null || true)"
  case "$remote" in
    git@github.com:*.git) remote="${remote#git@github.com:}"; remote="${remote%.git}" ;;
    git@github.com:*) remote="${remote#git@github.com:}" ;;
    https://github.com/*.git) remote="${remote#https://github.com/}"; remote="${remote%.git}" ;;
    https://github.com/*) remote="${remote#https://github.com/}" ;;
    *) remote="" ;;
  esac
  printf '%s' "$remote"
}

json_body() {
  node -e 'const note = process.argv[1] || ""; const out = note ? { note } : {}; process.stdout.write(JSON.stringify(out));' "${1:-}"
}

gate_binding_json() {
  node -e '
    const [issueUrl, prUrl, sessionId, note] = process.argv.slice(1);
    const out = {};
    if (issueUrl && issueUrl !== "-") out.issue_url = issueUrl;
    if (prUrl && prUrl !== "-") out.pr_url = prUrl;
    if (sessionId && sessionId !== "-") out.session_id = sessionId;
    if (note) out.note = note;
    process.stdout.write(JSON.stringify(out));
  ' "${1:-}" "${2:-}" "${3:-}" "${4:-}"
}

redispatch_json() {
  node -e '
    const [owner, sessionId, reason] = process.argv.slice(1);
    const out = { new_owner_session_id: owner };
    if (sessionId && sessionId !== "-") out.session_id = sessionId;
    if (reason) out.reason = reason;
    process.stdout.write(JSON.stringify(out));
  ' "${1:-}" "${2:-}" "${3:-}"
}

work_item_id_from_arg() {
  local raw="${1:-}"
  raw="${raw#dashboard://work-items/}"
  printf '%s' "$raw"
}

# Wraps curl with -sk (silent, allow self-signed) and surfaces the
# server's JSON error body on non-2xx responses. The legacy `curl -skf`
# combo (which this replaces) silently dropped 4xx/5xx bodies — workers
# saw an empty response and a 22 exit code with no clue what went wrong.
# Successful 2xx body is printed to stdout; on failure, the server's
# { error, reason?, detail?, hint?, url? } fields are formatted to stderr
# and the function returns 22 (matching curl -f's old exit code so
# callers that check $? still work).
dash_curl() {
  local response status body msg
  if ! response="$(curl -sk -w $'\n%{http_code}' "$@")"; then
    echo "dashboard-ops: curl failed (network/DNS/connect error)" >&2
    return 22
  fi
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$status" =~ ^2[0-9][0-9]$ ]]; then
    printf '%s' "$body"
    return 0
  fi
  msg="$(printf '%s' "$body" | node -e '
    let raw = "";
    process.stdin.on("data", d => raw += d);
    process.stdin.on("end", () => {
      try {
        const o = JSON.parse(raw);
        if (o && typeof o.error === "string") {
          let out = o.error;
          for (const k of ["reason", "detail", "hint", "url"]) {
            if (typeof o[k] === "string" && o[k]) out += ` (${k}: ${o[k]})`;
          }
          process.stdout.write(out);
          return;
        }
      } catch {}
      process.stdout.write(raw);
    });
  ' 2>/dev/null || true)"
  if [[ -n "$msg" ]]; then
    echo "dashboard-ops: HTTP ${status}: ${msg}" >&2
  else
    echo "dashboard-ops: HTTP ${status}" >&2
  fi
  return 22
}

cmd="${1:-}"
case "$cmd" in
  logs)
    stream="${2:-err}"
    tail_n="${3:-200}"
    dash_curl "${dash_url}/api/dashboard/logs?stream=${stream}&tail=${tail_n}"
    ;;
  events)
    sid="${2:-${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}}"
    limit="${3:-200}"
    if [[ -z "$sid" ]]; then
      echo "dashboard-ops events: session id required when DASHBOARD_SESSION_ID is unset" >&2
      exit 2
    fi
    dash_curl "${dash_url}/api/sessions/${sid}/events?limit=${limit}"
    ;;
  graph)
    sid="${2:-${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}}"
    if [[ -z "$sid" ]]; then
      echo "dashboard-ops graph: session id required when DASHBOARD_SESSION_ID is unset" >&2
      exit 2
    fi
    dash_curl "${dash_url}/api/sessions/${sid}/project_graph"
    ;;
  reviews|review)
    target="${2:-}"
    repo="${3:-}"
    pr=""
    if [[ -z "$target" ]]; then
      echo "dashboard-ops reviews: target required" >&2
      exit 2
    fi
    if [[ "$target" =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+)([/?#].*)?$ ]]; then
      repo="${BASH_REMATCH[1]}"
      pr="${BASH_REMATCH[2]}"
    elif [[ "$target" =~ ^([^#[:space:]]+/[^#[:space:]]+)#([0-9]+)$ ]]; then
      repo="${BASH_REMATCH[1]}"
      pr="${BASH_REMATCH[2]}"
    elif [[ "$target" =~ ^[0-9]+$ ]]; then
      pr="$target"
      if [[ -z "$repo" ]]; then
        repo="$(repo_from_git)"
      fi
    else
      echo "dashboard-ops reviews: expected repo#pr, GitHub PR URL, or PR number" >&2
      exit 2
    fi
    if [[ -z "$repo" || -z "$pr" ]]; then
      echo "dashboard-ops reviews: repo could not be inferred; pass it as the second argument" >&2
      exit 2
    fi
    dash_curl -G \
      --data-urlencode "repo=${repo}" \
      --data-urlencode "pr=${pr}" \
      "${dash_url}/api/reviews/pr"
    ;;
  gate-bind)
    gate_id="${2:-}"
    issue_url="${3:-}"
    pr_url="${4:-}"
    session_id="${5:-${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}}"
    note="${6:-}"
    if [[ -z "$gate_id" ]]; then
      echo "dashboard-ops gate-bind: gate id required" >&2
      exit 2
    fi
    dash_curl \
      -X POST \
      -H 'Content-Type: application/json' \
      --data-binary "$(gate_binding_json "$issue_url" "$pr_url" "$session_id" "$note")" \
      "${dash_url}/api/r3-gates/${gate_id}/bindings"
    ;;
  gates)
    scope="${2:-ready}"
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    case "$scope" in
      ready)
        dash_curl -G --data-urlencode "state=READY" "${dash_url}/api/r3-gate-queue"
        ;;
      mine)
        if [[ -z "$sid" ]]; then
          echo "dashboard-ops gates mine: session id required when DASHBOARD_SESSION_ID is unset" >&2
          exit 2
        fi
        dash_curl -G --data-urlencode "manager_session_id=${sid}" "${dash_url}/api/r3-gate-queue"
        ;;
      all)
        dash_curl "${dash_url}/api/r3-gate-queue"
        ;;
      *)
        echo "dashboard-ops gates: scope must be ready, mine, or all" >&2
        exit 2
        ;;
    esac
    ;;
  gate-ack|gate-nack|gate-claim)
    gate_id="${2:-}"
    note="${3:-}"
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    if [[ -z "$gate_id" ]]; then
      echo "dashboard-ops ${cmd}: gate id required" >&2
      exit 2
    fi
    action="${cmd#gate-}"
    payload="$(node -e 'const [sessionId,note]=process.argv.slice(1); const out={}; if(sessionId) out.session_id=sessionId; if(note) out.note=note; process.stdout.write(JSON.stringify(out));' "$sid" "$note")"
    dash_curl \
      -X POST \
      -H 'Content-Type: application/json' \
      --data-binary "$payload" \
      "${dash_url}/api/r3-gates/${gate_id}/queue/${action}"
    ;;
  work-items)
    scope="${2:-ready}"
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    case "$scope" in
      ready)
        dash_curl -G --data-urlencode "status=ready" "${dash_url}/api/internal-work-items"
        ;;
      mine)
        if [[ -z "$sid" ]]; then
          echo "dashboard-ops work-items mine: session id required when DASHBOARD_SESSION_ID is unset" >&2
          exit 2
        fi
        dash_curl -G --data-urlencode "owner_session_id=${sid}" "${dash_url}/api/internal-work-items"
        ;;
      all)
        dash_curl "${dash_url}/api/internal-work-items"
        ;;
      create)
        owner_sid="$sid"
        work_item_shape=""
        shift 2
        while [[ "${1:-}" == --* ]]; do
          case "${1:-}" in
            --owner-session-id|--owner)
              if [[ -z "${2:-}" ]]; then
                echo "dashboard-ops work-items create: ${1} requires a session id" >&2
                exit 2
              fi
              owner_sid="$2"
              shift 2
              ;;
            --shape)
              if [[ -z "${2:-}" ]]; then
                echo "dashboard-ops work-items create: --shape requires leaf, composite, or bucket" >&2
                exit 2
              fi
              work_item_shape="$2"
              shift 2
              ;;
            *)
              echo "dashboard-ops work-items create: unknown option ${1}" >&2
              echo "  usage: dashboard-ops work-items create [--owner-session-id <session-id>] [--shape leaf|composite|bucket] \"<title>\"" >&2
              exit 2
              ;;
          esac
        done
        title="${1:-}"
        if [[ -z "$title" ]]; then
          echo "dashboard-ops work-items create: title required" >&2
          echo "  usage: dashboard-ops work-items create [--owner-session-id <session-id>] [--shape leaf|composite|bucket] \"<title>\"" >&2
          exit 2
        fi
        if [[ -z "$owner_sid" ]]; then
          echo "dashboard-ops work-items create: owner session id required when DASHBOARD_SESSION_ID is unset" >&2
          echo "  usage: dashboard-ops work-items create [--owner-session-id <session-id>] [--shape leaf|composite|bucket] \"<title>\"" >&2
          exit 2
        fi
        if [[ -n "$work_item_shape" ]]; then
          case "$work_item_shape" in
            leaf|composite|bucket) ;;
            *)
              echo "dashboard-ops work-items create: --shape must be one of leaf|composite|bucket" >&2
              echo "  leaf      — spawned role-node is atomic (closes on its own signal)" >&2
              echo "  composite — spawned role-node is a union of children" >&2
              echo "  bucket    — spawned role-node holds explicit remainder; closes via bucket-drain" >&2
              exit 2
              ;;
          esac
        fi
        # POST /api/internal-work-items uses a single wire field `shape` for
        # spawn-time decomposition (same enum as `declare` uses as `mode` on
        # POST /api/nodes/:id/declare). One key only — avoids dual-canonical drift.
        payload=$(node -e '
          const [sid, title, shape] = process.argv.slice(1);
          const out = { owner_session_id: sid, title };
          if (shape) out.shape = shape;
          process.stdout.write(JSON.stringify(out));
        ' "$owner_sid" "$title" "$work_item_shape")
        dash_curl \
          -X POST \
          -H 'Content-Type: application/json' \
          --data-binary "$payload" \
          "${dash_url}/api/internal-work-items"
        ;;
      *)
        echo "dashboard-ops work-items: scope must be ready, mine, all, or create" >&2
        exit 2
        ;;
    esac
    ;;
  escalate)
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    if [[ -z "$sid" ]]; then
      echo "dashboard-ops escalate: session id required when DASHBOARD_SESSION_ID is unset" >&2
      exit 2
    fi
    title="${2:-}"
    # Strip leading/trailing whitespace to match server-side .trim()
    # semantics (server.mjs createInternalWorkItemNode). Without this,
    # a worker invocation that inadvertently includes a trailing newline
    # — common via heredoc, $(...) edge cases, or pasted titles — would
    # be rejected here even though the server would have accepted it.
    title="$(printf '%s' "$title" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
    if [[ -z "$title" ]]; then
      echo "dashboard-ops escalate: title required" >&2
      echo "  usage: dashboard-ops escalate \"<single-line debt description>\"" >&2
      echo "  effect: creates a work item under your parent representing the missing work," >&2
      echo "          structurally blocks your own work-node until the debt closes," >&2
      echo "          and archives this session (work resumes via fresh autospawn when debt resolves)." >&2
      exit 2
    fi
    if [[ "$title" == *$'\n'* ]]; then
      echo "dashboard-ops escalate: title must be a single line (one debt per escalation)" >&2
      echo "  hint: leading/trailing whitespace is stripped automatically; only embedded newlines are rejected" >&2
      exit 2
    fi
    # Look up the caller's parent_id (the escalation target).
    parent=$(dash_curl "${dash_url}/api/sessions/${sid}" | node -e '
      let raw = "";
      process.stdin.on("data", d => raw += d);
      process.stdin.on("end", () => {
        try { const o = JSON.parse(raw); process.stdout.write(o?.parent_id || ""); }
        catch { process.stdout.write(""); }
      });
    ')
    if [[ -z "$parent" ]]; then
      echo "dashboard-ops escalate: no parent_id on session ${sid} — root managers cannot escalate (decide instead)" >&2
      exit 2
    fi
    payload=$(node -e '
      const [owner, escFrom, title] = process.argv.slice(1);
      process.stdout.write(JSON.stringify({
        owner_session_id: owner,
        escalating_from_session_id: escFrom,
        title,
      }));
    ' "$parent" "$sid" "$title")
    dash_curl \
      -X POST \
      -H 'Content-Type: application/json' \
      --data-binary "$payload" \
      "${dash_url}/api/internal-work-items"
    ;;
  archive)
    # Wraps DELETE /api/sessions/:id so workers don't hit the raw HTTP
    # API with curl (the silent-DELETE complaint that prompted this
    # subcommand: -skf swallowed 404/409 bodies, so an archive that
    # was refused looked identical to one that succeeded). Default
    # session id is the caller's own session, so a worker tearing
    # itself down can just run `dashboard-ops archive`.
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    cascade="false"
    force="false"
    shift 1
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --cascade) cascade="true" ;;
        --force) force="true" ;;
        --) shift; break ;;
        -*)
          echo "dashboard-ops archive: unknown flag $1" >&2
          echo "  usage: dashboard-ops archive [session-id] [--cascade] [--force]" >&2
          exit 2
          ;;
        *) sid="$1" ;;
      esac
      shift
    done
    if [[ -z "$sid" ]]; then
      echo "dashboard-ops archive: session id required when DASHBOARD_SESSION_ID is unset" >&2
      echo "  usage: dashboard-ops archive [session-id] [--cascade] [--force]" >&2
      exit 2
    fi
    dash_curl -X DELETE \
      "${dash_url}/api/sessions/${sid}?cascade=${cascade}&force=${force}"
    ;;
  replan)
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    if [[ -z "$sid" ]]; then
      echo "dashboard-ops replan: session id required when DASHBOARD_SESSION_ID is unset" >&2
      exit 2
    fi
    reason="${2:-}"
    if [[ -z "$reason" ]]; then
      echo "dashboard-ops replan: reason required" >&2
      echo "  usage: dashboard-ops replan \"<single-line reconciliation reason>\"" >&2
      echo "  effect: creates a reconciliation work item under your parent (\"Reconcile: <reason>\")," >&2
      echo "          structurally blocks your own work-node until the parent addresses it," >&2
      echo "          and archives this session (work resumes via fresh autospawn after the parent" >&2
      echo "          either closes the reconcile or authors children that change your scope)." >&2
      echo "  use when: you suspect your assigned decomposition is incomplete or wrong, and need" >&2
      echo "            the parent to re-examine the shape of the work — NOT for clearing a debt" >&2
      echo "            owed by an external party (use \`escalate\` for that)." >&2
      exit 2
    fi
    if printf '%s' "$reason" | grep -q $'\n'; then
      echo "dashboard-ops replan: reason must be a single line (replans express one decomposition question)" >&2
      exit 2
    fi
    # Look up the caller's parent_id (the reconciliation target).
    parent=$(dash_curl "${dash_url}/api/sessions/${sid}" | node -e '
      let raw = "";
      process.stdin.on("data", d => raw += d);
      process.stdin.on("end", () => {
        try { const o = JSON.parse(raw); process.stdout.write(o?.parent_id || ""); }
        catch { process.stdout.write(""); }
      });
    ')
    if [[ -z "$parent" ]]; then
      echo "dashboard-ops replan: no parent_id on session ${sid} — root managers cannot replan (decide instead)" >&2
      exit 2
    fi
    # Compose the reconcile title. The "Reconcile: " prefix is the human-
    # readable marker that distinguishes a decomposition-question from a
    # regular escalation. The underlying work-item shape is the same —
    # parent gets a new debt under their queue; caller archives with the
    # node preserved.
    title="Reconcile: ${reason}"
    payload=$(node -e '
      const [owner, escFrom, title] = process.argv.slice(1);
      process.stdout.write(JSON.stringify({
        owner_session_id: owner,
        escalating_from_session_id: escFrom,
        title,
      }));
    ' "$parent" "$sid" "$title")
    dash_curl \
      -X POST \
      -H 'Content-Type: application/json' \
      --data-binary "$payload" \
      "${dash_url}/api/internal-work-items"
    ;;
  messages)
    scope="${2:-mine}"
    hours="${3:-24}"
    limit="${4:-100}"
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    if [[ -z "$sid" ]]; then
      echo "dashboard-ops messages: session id required when DASHBOARD_SESSION_ID is unset" >&2
      exit 2
    fi
    case "$scope" in
      mine)
        dash_curl -G \
          --data-urlencode "hours=${hours}" \
          --data-urlencode "limit=${limit}" \
          "${dash_url}/api/sessions/${sid}/messages"
        ;;
      reports|children)
        dash_curl -G \
          --data-urlencode "hours=${hours}" \
          --data-urlencode "limit=${limit}" \
          "${dash_url}/api/sessions/${sid}/report-messages"
        ;;
      *)
        echo "dashboard-ops messages: scope must be mine or reports" >&2
        exit 2
        ;;
    esac
    ;;
  redispatch)
    raw_item="${2:-}"
    new_owner="${3:-}"
    session_id="${4:-${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}}"
    reason="${5:-}"
    if [[ -z "$raw_item" || -z "$new_owner" ]]; then
      echo "dashboard-ops redispatch: work item and new owner required" >&2
      exit 2
    fi
    item_id="$(work_item_id_from_arg "$raw_item")"
    dash_curl \
      -X POST \
      -H 'Content-Type: application/json' \
      --data-binary "$(redispatch_json "$new_owner" "$session_id" "$reason")" \
      "${dash_url}/api/internal-work-items/${item_id}/redispatch"
    ;;
  decisions)
    scope="${2:-owner}"
    sid="${3:-${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}}"
    if [[ -z "$sid" ]]; then
      echo "dashboard-ops decisions: session id required when DASHBOARD_SESSION_ID is unset" >&2
      exit 2
    fi
    case "$scope" in
      owner|owned)
        dash_curl -G --data-urlencode "owner_session_id=${sid}" "${dash_url}/api/decisions"
        ;;
      session|blocked)
        dash_curl -G --data-urlencode "session_id=${sid}" "${dash_url}/api/decisions"
        ;;
      *)
        echo "dashboard-ops decisions: scope must be owner or session" >&2
        exit 2
        ;;
    esac
    ;;
  decision)
    action="${2:-}"
    decision_id="${3:-}"
    note="${4:-}"
    case "$action" in
      ack|escalate|resolve|default) ;;
      *)
        echo "dashboard-ops decision: action must be ack, escalate, resolve, or default" >&2
        exit 2
        ;;
    esac
    if [[ -z "$decision_id" ]]; then
      echo "dashboard-ops decision: decision id required" >&2
      exit 2
    fi
    dash_curl \
      -X POST \
      -H 'Content-Type: application/json' \
      --data-binary "$(json_body "$note")" \
      "${dash_url}/api/decisions/${decision_id}/${action}"
    ;;
  declare)
    mode="${2:-}"
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    if [[ -z "$sid" ]]; then
      echo "dashboard-ops declare: session id required when DASHBOARD_SESSION_ID is unset" >&2
      exit 2
    fi
    case "$mode" in
      leaf|composite|bucket) ;;
      *)
        echo "dashboard-ops declare: mode must be one of leaf|composite|bucket" >&2
        echo "  leaf      — atomic; closes on its own signal (PR merge / archive)" >&2
        echo "  composite — meaning = union of children; closes when all open children close" >&2
        echo "  bucket    — explicit unallocated meaning; closes only via bucket-drain" >&2
        exit 2
        ;;
    esac
    node_id=$(dash_curl "${dash_url}/api/sessions/${sid}" | node -e '
      let raw = "";
      process.stdin.on("data", d => raw += d);
      process.stdin.on("end", () => {
        try { const o = JSON.parse(raw); process.stdout.write(o?.node_id || ""); }
        catch { process.stdout.write(""); }
      });
    ')
    if [[ -z "$node_id" ]]; then
      echo "dashboard-ops declare: no node_id on session ${sid} — session must be bound to a node" >&2
      exit 2
    fi
    payload=$(node -e '
      const [sid, mode] = process.argv.slice(1);
      process.stdout.write(JSON.stringify({ session_id: sid, mode }));
    ' "$sid" "$mode")
    dash_curl \
      -X POST \
      -H 'Content-Type: application/json' \
      --data-binary "$payload" \
      "${dash_url}/api/nodes/${node_id}/declare"
    ;;
  bucket-drain)
    target_node="${2:-}"
    note="${3:-}"
    sid="${DASHBOARD_SESSION_ID:-${SESSION_ID:-}}"
    if [[ -z "$target_node" || -z "$note" ]]; then
      echo "dashboard-ops bucket-drain: node-id and note both required" >&2
      echo "  usage: dashboard-ops bucket-drain <node-id> \"<witness note>\"" >&2
      echo "  effect: marks the bucket node drained; the note records what absorbs its meaning" >&2
      echo "          (e.g. \"absorbed by PR #2747\", \"reassigned to gate-99\")." >&2
      exit 2
    fi
    payload=$(node -e '
      const [sid, note] = process.argv.slice(1);
      const out = { note };
      if (sid) out.session_id = sid;
      process.stdout.write(JSON.stringify(out));
    ' "$sid" "$note")
    dash_curl \
      -X POST \
      -H 'Content-Type: application/json' \
      --data-binary "$payload" \
      "${dash_url}/api/nodes/${target_node}/bucket/drain"
    ;;
  -h|--help|help|'')
    usage
