#!/usr/bin/env bash
# review-agent -- PR review agent that checks for INVARIANTS.md violations.
#
# Reviews PRs by fetching the diff, loading INVARIANTS.md from the
# branch being reviewed, and asking an LLM to find violations.
# Posts line-level comments directly on offending code.
#
# Usage:
#   review-agent install     Install launchd plist (starts on boot)
#   review-agent uninstall   Remove launchd plist and state
#   review-agent start       Load (activate) the launchd job
#   review-agent stop        Unload (deactivate) the launchd job
#   review-agent status      Show whether the job is loaded and last run
#   review-agent run         Run one review cycle now (manual trigger)
#   review-agent run <PR#>   Review a single PR by number
#
# Configuration (edit these or set env vars):
REVIEW_OWNER="${REVIEW_OWNER:-gunb-ai}"
REVIEW_REPO="${REVIEW_REPO:-gunbc}"
REVIEW_BACKEND="${REVIEW_BACKEND:-codex}"
REVIEW_CODEX_MODEL="${REVIEW_CODEX_MODEL:-gpt-5.4}"
REVIEW_CLAUDE_MODEL="${REVIEW_CLAUDE_MODEL:-opus}"
REVIEW_INTERVAL="${REVIEW_INTERVAL:-1800}"  # seconds between runs (default 30m)

REPO_DIR="$HOME/gunbc"
STATE_DIR="$HOME/.local/share/gunbc-review"
STATE_FILE="$STATE_DIR/reviewed-heads.txt"
PROMPT_FILE="$STATE_DIR/prompt.md"
OUTPUT_FILE="$STATE_DIR/output.txt"
LOG_DIR="$STATE_DIR/logs"
PLIST_LABEL="com.gunbc.review-cycle"
PLIST_PATH="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

set -euo pipefail

# -- Dependency checks -------------------------------------------------

check_deps() {
  local missing=()
  command -v gh >/dev/null 2>&1 || missing+=("gh (brew install gh)")
  command -v python3 >/dev/null 2>&1 || missing+=("python3")
  case "$REVIEW_BACKEND" in
    codex)  command -v codex  >/dev/null 2>&1 || missing+=("codex") ;;
    claude) command -v claude >/dev/null 2>&1 || missing+=("claude") ;;
    gemini) command -v gemini >/dev/null 2>&1 || missing+=("gemini") ;;
  esac
  if [ ${#missing[@]} -gt 0 ]; then
    echo "Missing dependencies:"
    printf '  - %s\n' "${missing[@]}"
    return 1
  fi
}

# -- Review logic ------------------------------------------------------

review_pr() {
  local pr_number="$1" pr_title="$2" pr_url="$3" branch="$4" base_ref="$5" head_sha="$6"

  echo "Reviewing PR #${pr_number}: ${pr_title}"

  mkdir -p "$STATE_DIR"

  # Fetch reference documents from the PR's branch (parallel)
  cd "$REPO_DIR" && git fetch origin "$branch" 2>/dev/null
  local invariants algebra_ref integer_ref extdeps_ref diff
  invariants=$(cd "$REPO_DIR" && git show "origin/${branch}:INVARIANTS.md" 2>/dev/null || echo "(not found)")
  algebra_ref=$(cd "$REPO_DIR" && git show "origin/${branch}:dsl/std/algebra.dag" 2>/dev/null || echo "(not found)")
  integer_ref=$(cd "$REPO_DIR" && git show "origin/${branch}:dsl/std/integer.dag" 2>/dev/null || echo "(not found)")
  extdeps_ref=$(cd "$REPO_DIR" && git show "origin/${branch}:dsl/extdeps/extdeps.md" 2>/dev/null || echo "(not found)")
  diff=$(gh pr diff "$pr_number" --repo "${REVIEW_OWNER}/${REVIEW_REPO}" 2>/dev/null || echo "(diff unavailable)")

  # Build prompt -- two review axes
  cat > "$PROMPT_FILE" << 'PROMPT_HEADER'
You are a code reviewer for a DAG compiler project. Review the PR diff on two axes:

AXIS 1: INVARIANT VIOLATIONS
Check the diff against INVARIANTS.md. Report actual violations you can see in the changed code.

AXIS 2: COMPOSITIONAL MODELING
For any new or modified .dag types, services, or data declarations, evaluate:
- Accuracy: Does it faithfully model the domain? (reference: extdeps.md fidelity invariant)
- Harmony: Does it compose correctly from existing primitives? (reference: algebra.dag shows
  how Int emerges from OrderedRing<Word64>, how List is FreeMonoid<T>, how operations emerge
  from algebraic inhabitation rather than being listed ad-hoc)
- Layering: Does it sit at the right level? (L0 std, L2 provider-agnostic, L3 provider-specific,
  L5 tool -- see extdeps.md layer model)
- Improvement: What could make the model more compositional or more faithful?

Skip axis 2 if the PR has no .dag file changes.

OUTPUT FORMAT (strict, no markdown):

For violations:
VIOLATION|file_path|line_number|one sentence, reference the invariant

For modeling observations:
MODEL|file_path|GOOD|one sentence on what composes well
MODEL|file_path|IMPROVE|one sentence on what could be more compositional or faithful

After all lines, exactly one:
SUMMARY|one sentence overall assessment

Nothing else. No headers, no preamble.
PROMPT_HEADER

  cat >> "$PROMPT_FILE" << PROMPT_BODY

--- INVARIANTS.md ---
${invariants}

--- Reference: std/algebra.dag (aspirational compositional model) ---
${algebra_ref}

--- Reference: std/integer.dag (carrier + algebra witness pattern) ---
${integer_ref}

--- Reference: extdeps.md (layer model and fidelity invariant) ---
${extdeps_ref}

--- PR #${pr_number}: ${pr_title} ---
Branch: ${branch} -> ${base_ref}

--- Diff ---
${diff}
PROMPT_BODY

  # Invoke LLM backend
  local raw_output=""
  case "$REVIEW_BACKEND" in
    codex)
      raw_output=$(codex exec -m "$REVIEW_CODEX_MODEL" -C "$REPO_DIR" - < "$PROMPT_FILE" 2>/dev/null || true)
      ;;
    claude)
      raw_output=$(claude -p --output-format text --permission-mode plan --model "$REVIEW_CLAUDE_MODEL" --effort max < "$PROMPT_FILE" 2>/dev/null || true)
      ;;
    gemini)
      raw_output=$(gemini -p --output-format text --approval-mode plan < "$PROMPT_FILE" 2>/dev/null || true)
      ;;
  esac

  if [ -z "$raw_output" ]; then
    echo "  Backend returned empty output, skipping."
    return 1
  fi

  echo "$raw_output" > "$OUTPUT_FILE"

  # Parse output and post review with line comments
  export _RA_PR="$pr_number" _RA_SHA="$head_sha" _RA_RAW="$raw_output"
  python3 << 'PYEOF'
import json, subprocess, sys, os

pr_number = os.environ["_RA_PR"]
head_sha = os.environ["_RA_SHA"]
raw = os.environ["_RA_RAW"]

owner_repo = "gunb-ai/gunbc"

violations = []
model_good = []
model_improve = []
summary = ""

for line in raw.strip().split("\n"):
    line = line.strip()
    if line.startswith("VIOLATION|"):
        parts = line.split("|", 3)
        if len(parts) == 4:
            _, path, line_num, desc = parts
            try:
                violations.append({
                    "path": path.strip(),
                    "line": int(line_num.strip()),
                    "body": desc.strip()
                })
            except ValueError:
                pass
    elif line.startswith("MODEL|"):
        parts = line.split("|", 3)
        if len(parts) == 4:
            _, path, rating, desc = parts
            entry = {"path": path.strip(), "body": desc.strip()}
            if rating.strip() == "GOOD":
                model_good.append(entry)
            elif rating.strip() == "IMPROVE":
                model_improve.append(entry)
    elif line.startswith("SUMMARY|"):
        summary = line.split("|", 1)[1].strip()

# Build review body
sections = []
if violations:
    sections.append(f"**Invariant violations** ({len(violations)})")
if model_good:
    items = "\n".join(f"- `{m['path']}` {m['body']}" for m in model_good)
    sections.append(f"**Modeling (good)**\n{items}")
if model_improve:
    items = "\n".join(f"- `{m['path']}` {m['body']}" for m in model_improve)
    sections.append(f"**Modeling (improve)**\n{items}")
if summary:
    sections.append(summary)

review_body = "\n\n".join(sections) if sections else "No findings."

if not violations:
    # No line comments needed -- post as PR comment
    body = f"**Review** ({len(violations)} violations, {len(model_good)} model strengths, {len(model_improve)} suggestions)\n\n{review_body}"
    subprocess.run([
        "gh", "pr", "comment", pr_number,
        "--repo", owner_repo,
        "--body", body
    ], capture_output=True)
    print(f"  Posted: {len(model_good)} good, {len(model_improve)} improve, 0 violations")
    sys.exit(0)

# Build review payload with line comments for violations
review = {
    "commit_id": head_sha,
    "event": "COMMENT",
    "body": f"**Review** ({len(violations)} violation{'s' if len(violations) != 1 else ''}, {len(model_improve)} modeling suggestion{'s' if len(model_improve) != 1 else ''})\n\n{review_body}",
    "comments": []
}

for v in violations:
    review["comments"].append({
        "path": v["path"],
        "line": v["line"],
        "body": f"**Invariant violation:** {v['body']}"
    })

# Post via GitHub API
result = subprocess.run(
    ["gh", "api", f"repos/{owner_repo}/pulls/{pr_number}/reviews",
     "--method", "POST",
     "--input", "-"],
    input=json.dumps(review).encode(),
    capture_output=True
)

if result.returncode == 0:
    resp = json.loads(result.stdout)
    print(f"  Posted: {len(violations)} violations, {len(model_good)} good, {len(model_improve)} improve: {resp.get('html_url', '')}")
else:
    err = result.stderr.decode()
    v_lines = "\n".join(f"- `{v['path']}:{v['line']}` {v['body']}" for v in violations)
    body = f"**Review** ({len(violations)} violations)\n\n{review_body}\n\n{v_lines}"
    subprocess.run([
        "gh", "pr", "comment", pr_number,
        "--repo", owner_repo,
        "--body", body
    ], capture_output=True)
    print(f"  Line comments failed ({err[:80]}), posted as PR comment.")
PYEOF
}

run_cycle() {
  mkdir -p "$STATE_DIR" "$LOG_DIR"
  touch "$STATE_FILE"

  echo "$(date -Iseconds) Review cycle: ${REVIEW_OWNER}/${REVIEW_REPO} (${REVIEW_BACKEND})"

  local prs
  prs=$(gh pr list --repo "${REVIEW_OWNER}/${REVIEW_REPO}" --state open --json number,title,url,headRefName,headRefOid,baseRefName --limit 50 2>/dev/null || echo "[]")

  echo "$prs" | python3 -c "
import json, sys
for pr in json.load(sys.stdin):
    print(f\"{pr['number']}\t{pr['headRefOid']}\t{pr['headRefName']}\t{pr['baseRefName']}\t{pr['url']}\t{pr['title']}\")
" 2>/dev/null | while IFS=$'\t' read -r number head_sha branch base_ref url title; do
    if grep -q "$head_sha" "$STATE_FILE" 2>/dev/null; then
      echo "  Skip PR #${number} (${head_sha:0:8} already reviewed)"
      continue
    fi

    if review_pr "$number" "$title" "$url" "$branch" "$base_ref" "$head_sha"; then
      echo "$head_sha" >> "$STATE_FILE"
    fi
  done

  echo "$(date -Iseconds) Done."
}

run_single() {
  local pr_number="$1"
  mkdir -p "$STATE_DIR"

  local pr_json
  pr_json=$(gh pr view "$pr_number" --repo "${REVIEW_OWNER}/${REVIEW_REPO}" --json number,title,url,headRefName,headRefOid,baseRefName 2>/dev/null)

  local title branch base_ref url head_sha
  title=$(echo "$pr_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['title'])")
  branch=$(echo "$pr_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['headRefName'])")
  base_ref=$(echo "$pr_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['baseRefName'])")
  url=$(echo "$pr_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['url'])")
  head_sha=$(echo "$pr_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['headRefOid'])")

  review_pr "$pr_number" "$title" "$url" "$branch" "$base_ref" "$head_sha"
}

# -- Lifecycle commands ------------------------------------------------

do_install() {
  check_deps || exit 1
  mkdir -p "$STATE_DIR" "$LOG_DIR" "$(dirname "$PLIST_PATH")"

  cat > "$PLIST_PATH" << PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${PLIST_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${SCRIPT_PATH}</string>
    <string>run</string>
  </array>
  <key>StartInterval</key>
  <integer>${REVIEW_INTERVAL}</integer>
  <key>StandardOutPath</key>
  <string>${LOG_DIR}/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>${LOG_DIR}/stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>REVIEW_BACKEND</key>
    <string>${REVIEW_BACKEND}</string>
  </dict>
</dict>
</plist>
PLIST_EOF

  echo "Installed: ${PLIST_PATH}"
  echo "Run 'review-agent start' to activate."
}

do_uninstall() {
  do_stop 2>/dev/null || true
  rm -f "$PLIST_PATH"
  echo "Removed: ${PLIST_PATH}"
  echo "State at: ${STATE_DIR} (rm -rf to purge)"
}

do_start() {
  [ -f "$PLIST_PATH" ] || { echo "Not installed. Run 'review-agent install' first."; exit 1; }
  launchctl load "$PLIST_PATH" 2>/dev/null || true
  echo "Started: ${PLIST_LABEL} (every ${REVIEW_INTERVAL}s)"
}

do_stop() {
  launchctl unload "$PLIST_PATH" 2>/dev/null || true
  echo "Stopped: ${PLIST_LABEL}"
}

do_status() {
  echo "Backend:  ${REVIEW_BACKEND}"
  echo "Target:   ${REVIEW_OWNER}/${REVIEW_REPO}"
  echo "Interval: ${REVIEW_INTERVAL}s"
  if launchctl list "$PLIST_LABEL" >/dev/null 2>&1; then
    echo "Status:   ACTIVE"
  else
    echo "Status:   INACTIVE"
  fi
  if [ -f "$STATE_FILE" ]; then
    echo "Reviewed: $(wc -l < "$STATE_FILE" | tr -d ' ') heads"
  fi
}

# -- Main --------------------------------------------------------------

case "${1:-}" in
  install)   do_install ;;
  uninstall) do_uninstall ;;
  start)     do_start ;;
  stop)      do_stop ;;
  status)    do_status ;;
  run)
    check_deps || exit 1
    if [ -n "${2:-}" ]; then run_single "$2"; else run_cycle; fi
    ;;
  *)
    echo "Usage: review-agent {install|uninstall|start|stop|status|run [PR#]}"
    exit 1
    ;;
esac
