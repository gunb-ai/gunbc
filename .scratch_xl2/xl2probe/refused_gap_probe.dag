module xl2probe.refused_gap_probe

import v2.test.claim.namespace_xl0.reference_conservation { conservation_subject }
import v2.compiler.reference_conservation { reference_conservation_of_subject, dag_declared_token_classes }
import v2.std.integer { integer_int_to_decimal_string }
import v2.std.text { String }

fn probe() -> String {
  let r = reference_conservation_of_subject(subject: conservation_subject(id_tail: "normalization_refused", source: "module v2.test.reference_conservation_refused\n\nfn rc_guard(c: Bool, n: Int) -> Int {\n  if c { return n }\n  n\n}\n"), token_classes: dag_declared_token_classes())
  "role_not_yet_read=" + integer_int_to_decimal_string(value: r.role_not_yet_read) + " refused=" + integer_int_to_decimal_string(value: r.refused) + " authored=" + integer_int_to_decimal_string(value: r.authored)
}
