module test.gap_depth_6
import std.types { Int }
fn gar_bind<T, R>(o: T, f: fn(T) -> R) -> R { f(o) }
fn probe() -> Int {
  gar_bind(o: 1, f: fn(a) {
    gar_bind(o: a, f: fn(b) {
    gar_bind(o: b, f: fn(c) {
    gar_bind(o: c, f: fn(d) {
    gar_bind(o: d, f: fn(e) {
    gar_bind(o: e, f: fn(f) { f })
  })
  })
  })
  })
  })
}
