module flag_count_witness

type RiskReason = UnmatchedCard | HighValue

type IntakeDisposition
  = ReadyToList
  | NeedsReview { reasons: List<RiskReason> }

data results: List<{ disposition: IntakeDisposition }> = [
  { disposition: ReadyToList },
  { disposition: NeedsReview { reasons: [] |> list_push(HighValue) } },
  { disposition: ReadyToList },
  { disposition: NeedsReview { reasons: [] |> list_push(UnmatchedCard) } },
  { disposition: ReadyToList }
]

fn flagged_count() -> Int {
  fold(results, init: 0, f: (acc, r) => match r.disposition {
    ReadyToList => acc
    NeedsReview { reasons: _ } => acc + 1
  })
}
