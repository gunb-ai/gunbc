+  // comment's last character -- while the last lexeme is the `}` on line 6; and a file ending in a
+  // newline was refused one line past its last line. A span either ends at a lexeme or it is not a
+  // span: see the authority in 00_core.dag, which is also what says SO when there is no lexeme.
+  // Deliberately NOT a 'does this land in a comment' test -- there is no comment shape to test,
+  // comments emit nothing, and a guard would be the second copy of a rule this block removes.
+  let eof_end = last_code_token_end(tokens: final_state.tokens)
+  let eof_span = match eof_end {
