+    Present { value: end } => make_file_span(file: src.file, start: end, end: end)
+    // A file of pure trivia -- comments, whitespace, or nothing -- has no lexeme to end at, so it
+    // gets NO offset rather than a fabricated 0. `locate_span` turns this into the typed
+    // FileHasNoLexemes cause, which keeps the file name and says the position is not there.
+    Absent => make_file_span(
+      file: src.file,
+      start: unlocatable_span_offset,
+      end: unlocatable_span_offset
+    )
+  }
