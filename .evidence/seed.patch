index 365a3bf88a6c..cfbf2c02b109 100644
--- a/src/v1/00_core.dag
+++ b/src/v1/00_core.dag
@@ -2738,6 +2738,182 @@ fn byte_to_line_col(index: NewlineIndex, offset: Int) -> LineCol {
   LineCol { line: line, col: col }
 }
 
+// ---------------------------------------------------------------------------------------------
+// THE ONE AUTHORITY FOR A REFUSAL'S LOCATION.
+//
+// A span carries two CHAR offsets into a file. Offsets are the compiler's own units; what an
+// author reads is a POSITION -- file, line, column -- the triple they can type into an editor.
+// A refusal whose location cannot be reproduced in an editor is not a location, however many
+// digits it carries, so the honest alternatives are exactly two: say where it is, or say in
+// words that it cannot be said. This block is the only thing in the seed that does either.
+//
+// WHY IT IS ONE PLACE AND NOT ONE PER CALL SITE (DESIGN 6b). Before this block there was no
+// authority at all: each producer formatted a location itself. The compile lane printed
+// `{file}:{start}-{end}`; the emitted CLI printed `{file}:{line}:{col}` from its own walk; and
+// two HOST Rust sites formatted `{file}:{line}:{col}` again in Rust
+// (src/v1/stage0/src/module_path_index/index.rs `ModuleBindingRefusal::rendered` and
+// src/v1/stage0/src/cli_run.rs `run_dag_parse_sweep`, beside
+// src/v1/stage0/src/declaration_index.rs `render_finding`). One diagnostic therefore reached the
+// same author twice in different units -- measured at the head, `(m.dag:133-134)` from the lane
+// and `error[m.dag:9:5]` from the CLI for the SAME call-shape refusal: the same place, two
+// units, which reads as a compiler that does not know where it is. Every consumer -- the lane,
+// the emitted CLI's diagnostic block, and the host Rust, which CALLS the function emitted from
+// here rather than reimplementing it -- goes through `locate_span` and `render_span_location`.
+// The deletion test is
+// dag/test/claim/diagnostic_span_location_rendering_witness.dag: one row reads the lane line and
+// the CLI line for a single diagnostic, so a second formatter growing back makes them disagree.
+//
+// THE UNLOCATED ARM IS TYPED, AND IT KEEPS THE FILE. When a span cannot be placed the answer is
+// `Unlocated { cause: ... }` naming WHY, and `render_span_location` renders it in words that
+// cannot be mistaken for a position: never `byte 75`, never a bare `<synthetic>` where a path
+// belongs, and never an offset dressed as a location. The file is kept even when the position is
+// lost -- a refusal about `cfg/nolexemes.dag` must still say so.
+// ---------------------------------------------------------------------------------------------
+
+// A span that COULD be placed. 1-based line and column, the units an editor takes; the end is
+// carried so a range that straddles lines is not silently narrowed to its first position.
+type LocatedSpan {
+  file: String
+  start_line: Int
+  start_col: Int
+  end_line: Int
+  end_col: Int
+}
+
+// WHY a span could not be placed. Named causes, not prose: a refusal can be routed by cause, a
+// claim can assert WHICH reason it got, and a caller that must not degrade (a build gate, say)
+// can match on the one it cares about instead of pattern-matching sentences.
+type UnlocatedCause
+  = FileHasNoLexemes { file: String }
+  | NoSourceIndex { file: String }
+  | SpanOutsideIndexedSource { file: String }
+  | SynthesizedNode { authored_file: String }
+
+type SpanLocation
+  = Located { at: LocatedSpan }
+  | Unlocated { cause: UnlocatedCause }
+
+// The words that stand WHERE A POSITION WOULD STAND. Deliberately carries no digit run followed
+// by a colon, so neither a reader nor a test can mistake it for a location: the claim's
+// structural predicate accepts `m.dag:9:5` and refuses everything this arm can print. The file is
+// printed by `render_span_location` in front of it, because a refusal that loses which file it is
+// about is worse than one that loses the position.
+data unlocated_position_phrase: String = "(no position:"
+
+// THE FILE A SYNTHESIZED NODE CARRIES. `no_span()` stamps it, and it is NOT a path: printing it
+// where a path belongs tells an author to open a file that does not exist. It stays the marker for
+// nodes the compiler MADE; a real file whose position is lost is `FileHasNoLexemes`/`NoSourceIndex`
+// below, which keeps the real path -- a real file's position is not "synthetic".
+data synthetic_span_file: String = "<synthetic>"
+
+// HOW THE TOKENISER SAYS "there is no lexeme to end a span at", without inventing one. An EOF
+// token whose span is `unlocatable_span_offset..unlocatable_span_offset` in a REAL file asserts
+// that the file has no lexemes at all: it names its file, and it refuses to claim an offset. The
+// value is negative so no position in any file can collide with it, and `locate_span` turns it
+// into the typed `FileHasNoLexemes` cause rather than an arithmetic result.
+data unlocatable_span_offset: Int = -1
+
+fn file_has_no_lexemes(file: String) -> SpanLocation {
+  SpanLocation.Unlocated { cause: FileHasNoLexemes { file: file } }
+}
+
+// WHETHER a span can be placed, and where. Four refusals, each with its own cause and each
+// keeping the file it is about:
+//   * SynthesizedNode -- the compiler made this node; there is no source behind the span at all.
+//   * FileHasNoLexemes -- the file is real and named, but pure trivia (comments/whitespace/nothing)
+//     produced no lexeme, so there is no position to report. This is the arm the tokenise fix
+//     leaves behind: the alternative is a fabricated offset 0, which sends an author to line 1.
+//   * NoSourceIndex -- the compiler has not indexed the source it is refusing in, so the line is
+//     genuinely not known. Printing the offsets instead is the original sin this block removes.
+//   * SpanOutsideIndexedSource -- the span disagrees with the file (negative, inverted, or past
+//     the end). Guessing a line from a span the file contradicts would be a second lie.
+fn locate_span(span: SourceSpan, source_indices: Map<String, NewlineIndex>) -> SpanLocation {
+  if span.file == synthetic_span_file {
+    SpanLocation.Unlocated { cause: SynthesizedNode { authored_file: synthetic_span_file } }
+  } else if span.start == unlocatable_span_offset && span.end == unlocatable_span_offset {
+    file_has_no_lexemes(span.file)
+  } else {
+    match map_get(source_indices, span.file) {
+      Absent => SpanLocation.Unlocated { cause: NoSourceIndex { file: span.file } }
+      Present { value: index } =>
+        let src_len = count(index.char_codes)
+        if span.start < 0 || span.end < span.start || span.end > src_len {
+          SpanLocation.Unlocated { cause: SpanOutsideIndexedSource { file: span.file } }
+        } else {
+          let from = byte_to_line_col(index: index, offset: span.start)
+          let to = byte_to_line_col(index: index, offset: span.end)
+          SpanLocation.Located { at: LocatedSpan {
+            file: span.file,
+            start_line: from.line,
+            start_col: from.col,
+            end_line: to.line,
+            end_col: to.col
+          } }
+        }
+    }
+  }
+}
+
+// WHY, in words, for each cause. One match, so a new cause cannot be added without saying what it
+// sounds like -- there is no default arm.
+fn unlocated_cause_phrase(cause: UnlocatedCause) -> String {
+  match cause {
+    FileHasNoLexemes { file: _ } => "file has no lexemes)"
+    NoSourceIndex { file: _ } => "no source index for this file)"
+    SpanOutsideIndexedSource { file: _ } => "the span lies outside the indexed source)"
+    SynthesizedNode { authored_file: _ } => "the node is synthesized, not read from a file)"
+  }
+}
+
+// The file a refusal is ABOUT -- and the empty string when there is no file to name. A refusal
+// about a real file must always say which one, even when its position is lost; a SYNTHESIZED node
+// has no file behind it, and printing the sentinel `<synthetic>` in a file position would tell an
+// author to open something that does not exist. `render_span_location` omits the prefix here, so
+// the sentinel never appears where a path belongs.
+fn unlocated_cause_file(cause: UnlocatedCause) -> String {
+  match cause {
+    FileHasNoLexemes { file: file } => file
+    NoSourceIndex { file: file } => file
+    SpanOutsideIndexedSource { file: file } => file
+    SynthesizedNode { authored_file: _ } => ""
+  }
+}
+
+// THE ONLY THING THAT PUTS A LOCATION INTO WORDS.
+//
+// A refusal's LOCATION is where it starts -- `file:line:col`, the triple an editor accepts. The
+// EXTENT of a span is not part of a location: it is what the caret block under the refusal shows,
+// and a caller that needs it takes `located_span_of` rather than a string. Rendering the end here
+// would put a range where a position belongs and change every `error[file:line:col]:` the CLI
+// prints -- a second format for the same fact, which is the thing this block is here to remove.
+//
+// THE UNLOCATED ARM KEEPS THE FILE AND SAYS SO: `cfg/nolexemes.dag: (no position: file has no
+// lexemes)`. That line is deliberately not a location -- no editor accepts it -- which is the
+// point: the alternative was `byte 75`, a byte count wearing a location's clothes.
+fn render_span_location(span: SourceSpan, source_indices: Map<String, NewlineIndex>) -> String {
+  match locate_span(span: span, source_indices: source_indices) {
+    Located { at: at } =>
+      concat(at.file, concat(":", concat(to_string(value: at.start_line), concat(":", to_string(value: at.start_col)))))
+    Unlocated { cause: cause } =>
+      let about = unlocated_cause_file(cause: cause)
+      let phrase = concat(unlocated_position_phrase, " ", unlocated_cause_phrase(cause: cause))
+      if about == "" { phrase } else { concat(about, concat(": ", phrase)) }
+  }
+}
+
+// The same question with only the located answer, for a caller that genuinely needs the triple
+// (a caret column, a slice) and has a fallback for its absence. The seed's optional
+// spelling is `T?` with Present/Absent, as at Node.ident_span (00_core.dag:1196). Prefer
+// `render_span_location`:
+// a caller that reaches past this has to decide what to say when there is no position, and that
+// decision belongs here.
+fn located_span_of(span: SourceSpan, source_indices: Map<String, NewlineIndex>) -> LocatedSpan? {
+  match locate_span(span: span, source_indices: source_indices) {
+    Located { at: at } => Present { value: at }
+    Unlocated { cause: _ } => Absent
+  }
+}
+
 fn source_line_at(index: NewlineIndex, line: Int) -> String {
   let src_len = count(index.char_codes)
   let line_start = if line <= 1 { 0 }
