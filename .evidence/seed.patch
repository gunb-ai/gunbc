+// Which tokens may END a refusal's span. A newline token is emitted for every physical line break
+// (:250) and a comment emits none at all, so both are TRIVIA: a span ending at either points into
+// whitespace or into a comment. `ShEof` is excluded because it is the token this rule is about --
+// it must end at a lexeme, never at itself.
+fn is_trivia_shape(shape: TokenShape) -> Bool {
+  match shape { ShNewline => true  ShEof => true  _ => false }
+}
+
+// The END OFFSET of the last non-trivia token -- one past the last character a reader could have
+// typed. `Absent` means the file produced no lexeme at all, which is a different fact from "its
+// last lexeme ended at 0" and must not be collapsed into one.
+fn last_code_token_end(tokens: List<Token>) -> Int? {
+  fold(tokens |> filter(t => !is_trivia_shape(t.shape)), init: none, f: (acc, t) =>
+    Present { value: t.span.end })
+}
