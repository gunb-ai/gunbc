    pub default_tier: Tier,
    glyphs: &'static [Glyph],
}

impl GlyphSet {
    pub fn get(&self, id: GlyphId) -> &Glyph { ... }
    pub fn render(&self, id: GlyphId) -> &str { ... }
    pub fn render_at(&self, id: GlyphId, tier: Tier) -> &str { ... }
    pub fn spinner_frames(&self, tier: Tier) -> [&str; 4] { ... }
}
```

