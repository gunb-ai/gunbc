### Integration point in execute_flat()

Minimal change — add observer calls around existing node execution:

```rust
fn execute_flat<T: Executable>(
    dag: &Dag<T>,
    boundaries: &BoundaryInfo,
    mode: &ExecutionMode,
    ci: Option<&mut CiContext>,
    observer: Option<&mut dyn ProgressObserver>,  // NEW
) -> Result<ExecutionLog, ExecError> {
    let order = topo_sort(dag);

    if let Some(ref mut obs) = observer {
        obs.on_dag_start(&build_snapshot(dag, &order));
    }

    let start = Instant::now();

    for node_id in &order {
        if let Some(ref mut obs) = observer {
            obs.on_node_start(node_id);
        }

        // ... existing execution logic ...

        if let Some(ref mut obs) = observer {
            match &result {
                Ok(outputs) if was_intercepted =>
                    obs.on_node_intercepted(node_id, summarize(outputs)),
                Ok(outputs) =>
                    obs.on_node_complete(node_id, summarize(outputs)),
                Err(e) =>
                    obs.on_node_failed(node_id, &e.to_string()),
            }
        }
    }

    if let Some(ref mut obs) = observer {
        obs.on_dag_complete(start.elapsed());
    }

    Ok(ExecutionLog { entries })
}
```

