module gunbc.zz_fb

import std.types { String, Bool, List, Int, Unit }
import std.optional { Optional, Present, Absent }

fn probe(xs: List<String>) -> Bool {
  let init0: String? = none
  let r = fold(xs, init: init0, f: (acc, c) => Present { value: c })
  match r {
    Absent => false
    Present { value: c } =>
      let z: Bool = c
      z
  }
}

fn zz_control_after(x: Int) -> Bool {
  let n: Bool = x
  n
}
