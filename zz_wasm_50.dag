    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f32_mul)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f32_div)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f32_min)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f32_max)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f32_copysign)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f64_add)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f64_sub)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f64_mul)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f64_div)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f64_min)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f64_max)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f64_copysign)]),

    grammar_formal_production(lhs: ^wasm_production_module_fn_suffix, rhs: []),
    grammar_formal_production(
      lhs: ^wasm_production_module_fn_suffix,
      rhs: [
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_fn_add),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_module_fn_suffix)
      ]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_module,
      rhs: [
        grammar_formal_terminal(identity: ^wasm_token_lparen),
        grammar_formal_terminal(identity: ^wasm_token_kw_module),
        grammar_formal_terminal(identity: ^wasm_token_rparen)
      ]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_module,
      rhs: [
        grammar_formal_terminal(identity: ^wasm_token_lparen),
        grammar_formal_terminal(identity: ^wasm_token_kw_module),
        grammar_formal_terminal(identity: ^wasm_token_ident),
        grammar_formal_terminal(identity: ^wasm_token_rparen)
      ]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_module,
      rhs: [
        grammar_formal_terminal(identity: ^wasm_token_lparen),
        grammar_formal_terminal(identity: ^wasm_token_kw_module),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_fn_add),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_module_fn_suffix),
        grammar_formal_terminal(identity: ^wasm_token_rparen)
      ]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_module,
      rhs: [
        grammar_formal_terminal(identity: ^wasm_token_lparen),
        grammar_formal_terminal(identity: ^wasm_token_kw_module),
        grammar_formal_terminal(identity: ^wasm_token_ident),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_fn_add),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_module_fn_suffix),
        grammar_formal_terminal(identity: ^wasm_token_rparen)
      ]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_text_fragment,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^wasm_production_fn_add)]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_text_fragment,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^wasm_production_module)]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_text_fragment,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^wasm_production_value_type)]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_text_fragment,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^wasm_production_localidx)]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_text_fragment,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^wasm_production_numeric_const_instr)]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_text_fragment,
      rhs: [grammar_formal_nonterminal_occurrence(identity: ^wasm_production_numeric_binop_instr)]
    ),
    wasm_formal_production_fn_add()
  ]
}

