import v2.std.text { String }

type WasmIntWidth
  = WasmIntBits32
  | WasmIntBits64

type WasmFloatWidth
  = WasmFloatBits32
  | WasmFloatBits64

type WasmScalar
  = IntScalar { width: WasmIntWidth }
  | FloatScalar { width: WasmFloatWidth }

type WasmIntegerPrimitiveFacts {
  surface_spelling: Symbol
  width: WasmIntWidth
  std_projection: Symbol
}

type WasmFloatPrimitiveFacts {
  surface_spelling: Symbol
  width: WasmFloatWidth
  ieee754_binary: Symbol
  std_projection: Symbol
}

type WasmGrammarRelationRow {
  production: GrammarProduction
  emitted: Node
  tokens: List<ConcreteSyntaxToken>
}
fn wasm_concrete_tokens() -> List<ConcreteSyntaxToken> {
  [
    FixedToken { token_class: ^wasm_token_lparen },
    FixedToken { token_class: ^wasm_token_kw_func },
    BoundToken { token_class: ^wasm_token_ident, binding: ^wasm_binding_fn_add },
    FixedToken { token_class: ^wasm_token_lparen },
    FixedToken { token_class: ^wasm_token_kw_param },
    FixedToken { token_class: ^wasm_token_type_i32 },
    FixedToken { token_class: ^wasm_token_type_i32 },
    FixedToken { token_class: ^wasm_token_rparen },
    FixedToken { token_class: ^wasm_token_lparen },
    FixedToken { token_class: ^wasm_token_kw_result },
    FixedToken { token_class: ^wasm_token_type_i32 },
    FixedToken { token_class: ^wasm_token_rparen },
    FixedToken { token_class: ^wasm_token_local_get },
    BoundToken { token_class: ^wasm_token_localidx_literal, binding: ^wasm_binding_localidx_0 },
    FixedToken { token_class: ^wasm_token_local_get },
    BoundToken { token_class: ^wasm_token_localidx_literal, binding: ^wasm_binding_localidx_1 },
    FixedToken { token_class: ^wasm_token_i32_add },
    FixedToken { token_class: ^wasm_token_rparen }
  ]
}
data wasm_source_text: String = "(func $add (param i32 i32) (result i32) local.get 0 local.get 1 i32.add)"

data wasm_facts_i32: WasmIntegerPrimitiveFacts = WasmIntegerPrimitiveFacts {
  surface_spelling: ^wasm_surface_spelling_i32,
  width: WasmIntBits32,
  std_projection: ^wasm_std_projection_i32,
}

data wasm_facts_i64: WasmIntegerPrimitiveFacts = WasmIntegerPrimitiveFacts {
  surface_spelling: ^wasm_surface_spelling_i64,
  width: WasmIntBits64,
  std_projection: ^wasm_std_projection_i64,
}

data wasm_facts_f32: WasmFloatPrimitiveFacts = WasmFloatPrimitiveFacts {
  surface_spelling: ^wasm_surface_spelling_f32,
  width: WasmFloatBits32,
  ieee754_binary: ^wasm_ieee754_binary32,
  std_projection: ^wasm_std_projection_f32,
}

data wasm_facts_f64: WasmFloatPrimitiveFacts = WasmFloatPrimitiveFacts {
  surface_spelling: ^wasm_surface_spelling_f64,
  width: WasmFloatBits64,
  ieee754_binary: ^wasm_ieee754_binary64,
  std_projection: ^wasm_std_projection_f64,
}

data wasm_integer_facts_catalog: List<WasmIntegerPrimitiveFacts> = [
  wasm_facts_i32,
  wasm_facts_i64,
]

data wasm_float_facts_catalog: List<WasmFloatPrimitiveFacts> = [
  wasm_facts_f32,
  wasm_facts_f64,
]

fn wasm_inhabitant_atom(id: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: id } },
    children: [],
    occurrence_id: OccurrenceSynthetic
}
}

fn wasm_int_width_node(width: WasmIntWidth) -> Node {
  match width {
    WasmIntBits32 => wasm_inhabitant_atom(id: ^wasm_tag_bits32)
    WasmIntBits64 => wasm_inhabitant_atom(id: ^wasm_tag_bits64)
  }
}

fn wasm_float_width_node(width: WasmFloatWidth) -> Node {
  match width {
    WasmFloatBits32 => wasm_inhabitant_atom(id: ^wasm_tag_bits32)
    WasmFloatBits64 => wasm_inhabitant_atom(id: ^wasm_tag_bits64)
  }
}

fn wasm_scalar_node(scalar: WasmScalar) -> Node {
  match scalar {
    IntScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        wasm_named_edge(
          name: ^wasm_scalar_field_classifier,
          target: wasm_inhabitant_atom(id: ^wasm_tag_scalar_int)
        ),
        wasm_named_edge(name: ^wasm_scalar_field_width, target: wasm_int_width_node(width: width))
      ],
      occurrence_id: OccurrenceSynthetic
}
    FloatScalar { width } => Node {
      kind: TypeNode { connective: Conj },
      children: [
        wasm_named_edge(
          name: ^wasm_scalar_field_classifier,
          target: wasm_inhabitant_atom(id: ^wasm_tag_scalar_float)
        ),
        wasm_named_edge(name: ^wasm_scalar_field_width, target: wasm_float_width_node(width: width))
      ],
      occurrence_id: OccurrenceSynthetic
}
  }
}

fn wasm_integer_facts_node(facts: WasmIntegerPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: ^wasm_facts_field_surface_spelling,
        target: wasm_inhabitant_atom(id: facts.surface_spelling)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_width,
        target: wasm_int_width_node(width: facts.width)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_std_projection,
        target: wasm_inhabitant_atom(id: facts.std_projection)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_scalar_classifier,
        target: wasm_scalar_node(scalar: IntScalar { width: facts.width })
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn wasm_float_facts_node(facts: WasmFloatPrimitiveFacts) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: ^wasm_facts_field_surface_spelling,
        target: wasm_inhabitant_atom(id: facts.surface_spelling)
      ),
      wasm_named_edge(name: ^wasm_facts_field_width, target: wasm_float_width_node(width: facts.width)),
      wasm_named_edge(
        name: ^wasm_facts_field_ieee754_binary,
        target: wasm_inhabitant_atom(id: facts.ieee754_binary)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_std_projection,
        target: wasm_inhabitant_atom(id: facts.std_projection)
      ),
      wasm_named_edge(
        name: ^wasm_facts_field_scalar_classifier,
        target: wasm_scalar_node(scalar: FloatScalar { width: facts.width })
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn wasm_inhabitant_node(id: Symbol, facts: Node) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(name: ^wasm_inhabitant_field_atom, target: wasm_inhabitant_atom(id: id)),
      wasm_named_edge(name: ^wasm_inhabitant_field_facts, target: facts)
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn wasm_integer_inhabitant_node(id: Symbol, facts: WasmIntegerPrimitiveFacts) -> Node {
  wasm_inhabitant_node(id: id, facts: wasm_integer_facts_node(facts: facts))
}

fn wasm_float_inhabitant_node(id: Symbol, facts: WasmFloatPrimitiveFacts) -> Node {
  wasm_inhabitant_node(id: id, facts: wasm_float_facts_node(facts: facts))
}

fn wasm_inhabitant_i32_node() -> Node {
  wasm_integer_inhabitant_node(id: ^wasm_inhabitant_i32, facts: wasm_facts_i32)
}

fn wasm_integer_inhabitant_id(facts: WasmIntegerPrimitiveFacts) -> Symbol {
  match facts {
    wasm_facts_i32 => ^wasm_inhabitant_i32
    wasm_facts_i64 => ^wasm_inhabitant_i64
  }
}

fn wasm_float_inhabitant_id(facts: WasmFloatPrimitiveFacts) -> Symbol {
  match facts {
    wasm_facts_f32 => ^wasm_inhabitant_f32
    wasm_facts_f64 => ^wasm_inhabitant_f64
  }
}

fn wasm_integer_inhabitant_for_facts(facts: WasmIntegerPrimitiveFacts) -> Node {
  wasm_integer_inhabitant_node(id: wasm_integer_inhabitant_id(facts: facts), facts: facts)
}

fn wasm_float_inhabitant_for_facts(facts: WasmFloatPrimitiveFacts) -> Node {
  wasm_float_inhabitant_node(id: wasm_float_inhabitant_id(facts: facts), facts: facts)
}

fn wasm_named_edge(name: Symbol, target: Node) -> Edge {
  Edge { label: Authored { name: name }, target: target }
}

fn wasm_int_numeric_immediate_node(
  surface: Symbol,
  token_class: Symbol,
  width: WasmIntWidth,
  validation: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: surface } },
    children: [
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_token_class,
        target: wasm_inhabitant_atom(id: token_class)
      ),
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_width,
        target: wasm_int_width_node(width: width)
      ),
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_validation,
        target: wasm_inhabitant_atom(id: validation)
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn wasm_float_numeric_immediate_node(
  surface: Symbol,
  token_class: Symbol,
  width: WasmFloatWidth,
  validation: Symbol
) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: surface } },
    children: [
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_token_class,
        target: wasm_inhabitant_atom(id: token_class)
      ),
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_width,
        target: wasm_float_width_node(width: width)
      ),
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_validation,
        target: wasm_inhabitant_atom(id: validation)
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn wasm_localidx_node(token_class: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: ^wasm_surface_localidx } },
    children: [
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_token_class,
        target: wasm_inhabitant_atom(id: token_class)
      ),
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_width,
        target: wasm_int_width_node(width: WasmIntBits32)
      ),
      wasm_named_edge(
        name: ^wasm_numeric_immediate_field_validation,
        target: wasm_inhabitant_atom(id: ^wasm_localidx_validation_u32_range)
      )
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn wasm_localidx_operand_node() -> Node {
  wasm_localidx_node(token_class: ^wasm_token_localidx_literal)
}

fn wasm_declared_inhabitants_root() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(name: ^wasm_inhabitant_field_i32, target: wasm_integer_inhabitant_node(id: ^wasm_inhabitant_i32, facts: wasm_facts_i32)),
      wasm_named_edge(name: ^wasm_inhabitant_field_i64, target: wasm_integer_inhabitant_node(id: ^wasm_inhabitant_i64, facts: wasm_facts_i64)),
      wasm_named_edge(name: ^wasm_inhabitant_field_f32, target: wasm_float_inhabitant_node(id: ^wasm_inhabitant_f32, facts: wasm_facts_f32)),
      wasm_named_edge(name: ^wasm_inhabitant_field_f64, target: wasm_float_inhabitant_node(id: ^wasm_inhabitant_f64, facts: wasm_facts_f64))
    ],
    occurrence_id: OccurrenceSynthetic
  }
}

fn wasm_selection_policy_node() -> Node {
  wasm_inhabitant_i32_node()
}

fn wasm_emitted_add_fn_node() -> Node {
  anonymous_signature_arrow(domain_types: [wasm_inhabitant_i32_node(), wasm_inhabitant_i32_node()], codomain: wasm_inhabitant_i32_node(), source: wasm_inhabitant_i32_node())
}

fn wasm_source_text_authority() -> String {
  wasm_source_text
}

fn wasm_concrete_token_node(token: ConcreteSyntaxToken) -> Node {

  concrete_syntax_token_to_node(token: token)
}

fn wasm_grammar_terminal(token_class: Symbol) -> GrammarExpr {
  Terminal { token_class: token_class, stamp: StampClass }
}

fn wasm_grammar_choice(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Choice { left: left, right: right }
}

fn wasm_grammar_optional(element: GrammarExpr) -> GrammarExpr {
  Optional { element: element }
}

fn wasm_grammar_repeat(element: GrammarExpr) -> GrammarExpr {
  Repeat { element: element }
}

fn wasm_grammar_choice_fold_step(acc: GrammarExpr, token_class: Symbol) -> GrammarExpr {
  wasm_grammar_choice(
    left: wasm_grammar_terminal(token_class: token_class),
    right: acc
  )
}

fn wasm_grammar_choice_from_token_classes(token_classes: List<Symbol>, last: Symbol) -> GrammarExpr {
  fold_list(
    xs: token_classes,
    empty: wasm_grammar_terminal(token_class: last),
    cons: fn(acc, token_class) {
      wasm_grammar_choice_fold_step(acc: acc, token_class: token_class)
    }
  )
}

fn wasm_grammar_sequence(left: GrammarExpr, right: GrammarExpr) -> GrammarExpr {
  Sequence { left: left, right: right }
}

fn wasm_grammar_sequence_fold_step(acc: GrammarExpr, token: ConcreteSyntaxToken) -> GrammarExpr {
  let token_class = concrete_syntax_token_class(token: token)
  if token_class == ^wasm_token_lparen {
    acc
  } else {
    Sequence {
      left: wasm_grammar_terminal(token_class: token_class),
      right: acc
    }
  }
}

fn wasm_grammar_sequence_from_token_classes() -> GrammarExpr {
  fold_list(
    xs: wasm_concrete_tokens(),
    empty: wasm_grammar_terminal(token_class: ^wasm_token_lparen),
    cons: fn(acc, token) {
      wasm_grammar_sequence_fold_step(acc: acc, token: token)
    }
  )
}

fn wasm_grammar_relation_row() -> WasmGrammarRelationRow {
  WasmGrammarRelationRow {
    production: wasm_grammar_production_fn_add(),
    emitted: wasm_emitted_add_fn_node(),
    tokens: wasm_concrete_tokens()
  }
}

fn wasm_grammar_relation_row_node(row: WasmGrammarRelationRow) -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: ^grammar_relation_field_production,
        target: grammar_production_to_node(production: row.production)
      ),
      wasm_named_edge(name: ^grammar_relation_field_emitted, target: row.emitted),
      wasm_named_edge(
        name: ^grammar_relation_field_tokens,
        target: grammar_relation_tokens_node(
          tokens: row.tokens,
          token_to_node: wasm_concrete_token_node
        )
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn wasm_translation_rules_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: ^wasm_relation_rule_fn_add,
        target: wasm_grammar_relation_row_node(row: wasm_grammar_relation_row())
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn wasm_target_model_node() -> Node {
  Node {
    kind: TypeNode { connective: Conj },
    children: [
      wasm_named_edge(
        name: ^target_model_edge_selection_policy,
        target: wasm_selection_policy_node()
      ),
      wasm_named_edge(
        name: ^target_model_edge_declared_inhabitants,
        target: wasm_declared_inhabitants_root()
      ),
      wasm_named_edge(
        name: ^target_model_edge_translation_rules,
        target: wasm_translation_rules_node()
      )
    ],
    occurrence_id: OccurrenceSynthetic
}
}

fn wasm_binding_spellings() -> Map<Symbol, String> {
  map_insert(
    map_insert(
      map_insert(empty_map(), ^wasm_binding_fn_add, "$add"),
      ^wasm_binding_localidx_0,
      "0"
    ),
    ^wasm_binding_localidx_1,
    "1"
  )
}

fn wasm_target_model() -> TargetModel {
  TargetModel {
    produced_decl_support: ProducedDeclUnwired,
    bundle: wasm_target_model_node(),
    lex: wasm_lex(),
    binding_spellings: wasm_binding_spellings(),
    token_class_emit_transforms: target_model_emit_transforms_empty,
    authority_source_text: wasm_source_text_authority(),
    runtime_row: target_emit_host_runtime_row_unconfigured
  }
}

fn wasm_lex_rule(token_class: Symbol, text: String) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: LiteralPattern { text: chars(s: text) }
  }
}

fn wasm_dollar_ident_lex_pattern() -> LexPattern {
  SequencePattern {
    left: LiteralPattern { text: "$" },
    right: SequencePattern {
      left: CharClassPattern { class: IdentStartChar },
      right: RepeatPattern { element: CharClassPattern { class: IdentContinueChar } }
    }
  }
}

fn wasm_ident_lex_rule() -> LexRule {
  TokenRule {
    token_class: ^wasm_token_ident,
    pattern: wasm_dollar_ident_lex_pattern()
  }
}

fn wasm_lex_choice(left: LexPattern, right: LexPattern) -> LexPattern {
  ChoicePattern { left: left, right: right }
}

fn wasm_lex_sequence(left: LexPattern, right: LexPattern) -> LexPattern {
  SequencePattern { left: left, right: right }
}

fn wasm_optional_sign_lex_pattern() -> LexPattern {
  OptionalPattern {
    element: wasm_lex_choice(
      left: LiteralPattern { text: "+" },
      right: LiteralPattern { text: "-" }
    )
  }
}

fn wasm_digit_run_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: CharClassPattern { class: DigitChar },
    right: RepeatPattern {
      element: wasm_lex_choice(
        left: CharClassPattern { class: DigitChar },
        right: wasm_lex_sequence(
          left: LiteralPattern { text: "_" },
          right: CharClassPattern { class: DigitChar }
        )
      )
    }
  )
}

fn wasm_hex_digit_run_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: CharClassPattern { class: HexDigitChar },
    right: RepeatPattern {
      element: wasm_lex_choice(
        left: CharClassPattern { class: HexDigitChar },
        right: wasm_lex_sequence(
          left: LiteralPattern { text: "_" },
          right: CharClassPattern { class: HexDigitChar }
        )
      )
    }
  )
}

fn wasm_decimal_exponent_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: wasm_lex_choice(
      left: LiteralPattern { text: "e" },
      right: LiteralPattern { text: "E" }
    ),
    right: wasm_lex_sequence(
      left: wasm_optional_sign_lex_pattern(),
      right: wasm_digit_run_lex_pattern()
    )
  )
}

fn wasm_hex_exponent_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: wasm_lex_choice(
      left: LiteralPattern { text: "p" },
      right: LiteralPattern { text: "P" }
    ),
    right: wasm_lex_sequence(
      left: wasm_optional_sign_lex_pattern(),
      right: wasm_digit_run_lex_pattern()
    )
  )
}

fn wasm_decimal_integer_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: wasm_optional_sign_lex_pattern(),
    right: wasm_digit_run_lex_pattern()
  )
}

fn wasm_hex_integer_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: wasm_optional_sign_lex_pattern(),
    right: wasm_lex_sequence(
      left: LiteralPattern { text: "0x" },
      right: wasm_hex_digit_run_lex_pattern()
    )
  )
}

fn wasm_decimal_float_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: wasm_optional_sign_lex_pattern(),
    right: wasm_lex_choice(
      left: wasm_lex_sequence(
        left: wasm_digit_run_lex_pattern(),
        right: wasm_lex_sequence(
          left: LiteralPattern { text: "." },
          right: wasm_lex_sequence(
            left: OptionalPattern { element: wasm_digit_run_lex_pattern() },
            right: wasm_decimal_exponent_lex_pattern()
          )
        )
      ),
      right: wasm_lex_sequence(
        left: wasm_digit_run_lex_pattern(),
        right: wasm_decimal_exponent_lex_pattern()
      )
    )
  )
}

fn wasm_hex_float_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: wasm_optional_sign_lex_pattern(),
    right: wasm_lex_sequence(
      left: LiteralPattern { text: "0x" },
      right: wasm_lex_sequence(
        left: wasm_hex_digit_run_lex_pattern(),
        right: wasm_lex_sequence(
          left: OptionalPattern {
            element: wasm_lex_sequence(
              left: LiteralPattern { text: "." },
              right: OptionalPattern { element: wasm_hex_digit_run_lex_pattern() }
            )
          },
          right: wasm_hex_exponent_lex_pattern()
        )
      )
    )
  )
}

fn wasm_nan_payload_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: LiteralPattern { text: "nan:0x" },
    right: wasm_hex_digit_run_lex_pattern()
  )
}

fn wasm_float_special_lex_pattern() -> LexPattern {
  wasm_lex_sequence(
    left: wasm_optional_sign_lex_pattern(),
    right: wasm_lex_choice(
      left: LiteralPattern { text: "inf" },
      right: wasm_lex_choice(
        left: wasm_nan_payload_lex_pattern(),
        right: LiteralPattern { text: "nan" }
      )
    )
  )
}

fn wasm_u32_lex_pattern() -> LexPattern {
  wasm_digit_run_lex_pattern()
}

fn wasm_wat_int_literal_lex_pattern() -> LexPattern {
  wasm_lex_choice(
    left: wasm_hex_integer_lex_pattern(),
    right: wasm_decimal_integer_lex_pattern()
  )
}

fn wasm_wat_float_literal_lex_pattern() -> LexPattern {
  wasm_lex_choice(
    left: wasm_float_special_lex_pattern(),
    right: wasm_lex_choice(
      left: wasm_hex_float_lex_pattern(),
      right: wasm_decimal_float_lex_pattern()
    )
  )
}

fn wasm_numeric_literal_lex_rule(token_class: Symbol, pattern: LexPattern) -> LexRule {
  TokenRule {
    token_class: token_class,
    pattern: pattern
  }
}

fn wasm_int_numeric_literal_lex_rule() -> LexRule {
  wasm_numeric_literal_lex_rule(
    token_class: ^wasm_token_int_numeric_literal,
    pattern: wasm_wat_int_literal_lex_pattern()
  )
}

fn wasm_float_numeric_literal_lex_rule() -> LexRule {
  wasm_numeric_literal_lex_rule(
    token_class: ^wasm_token_float_numeric_literal,
    pattern: wasm_wat_float_literal_lex_pattern()
  )
}

fn wasm_localidx_literal_lex_rule() -> LexRule {
  wasm_numeric_literal_lex_rule(
    token_class: ^wasm_token_localidx_literal,
    pattern: wasm_u32_lex_pattern()
  )
}

fn wasm_lex_rules() -> LexRuleSet {
  LexRuleSet {
    rules: [
      wasm_lex_rule(token_class: ^wasm_token_lparen, text: "("),
      wasm_lex_rule(token_class: ^wasm_token_rparen, text: ")"),
      TriviaRule {
        pattern: SequencePattern {
          left: CharClassPattern { class: WhitespaceChar },
          right: RepeatPattern { element: CharClassPattern { class: WhitespaceChar } }
        }
      },
      TokenRule {
        token_class: ^wasm_token_kw_module,
        pattern: KeywordPattern { text: "module" }
      },
      TokenRule {
        token_class: ^wasm_token_kw_func,
        pattern: KeywordPattern { text: "func" }
      },
      wasm_ident_lex_rule(),
      TokenRule {
        token_class: ^wasm_token_kw_param,
        pattern: KeywordPattern { text: "param" }
      },
      TokenRule {
        token_class: ^wasm_token_kw_result,
        pattern: KeywordPattern { text: "result" }
      },
      wasm_lex_rule(token_class: ^wasm_token_local_get, text: "local.get"),
      wasm_lex_rule(token_class: ^wasm_token_type_i32, text: "i32"),
      wasm_lex_rule(token_class: ^wasm_token_type_i64, text: "i64"),
      wasm_lex_rule(token_class: ^wasm_token_type_f32, text: "f32"),
      wasm_lex_rule(token_class: ^wasm_token_type_f64, text: "f64"),
      wasm_int_numeric_literal_lex_rule(),
      wasm_float_numeric_literal_lex_rule(),
      wasm_localidx_literal_lex_rule(),
      wasm_numeric_literal_lex_rule(
        token_class: ^wasm_token_i32_numeric_literal,
        pattern: wasm_wat_int_literal_lex_pattern()
      ),
      wasm_numeric_literal_lex_rule(
        token_class: ^wasm_token_i64_numeric_literal,
        pattern: wasm_wat_int_literal_lex_pattern()
      ),
      wasm_numeric_literal_lex_rule(
        token_class: ^wasm_token_f32_numeric_literal,
        pattern: wasm_wat_float_literal_lex_pattern()
      ),
      wasm_numeric_literal_lex_rule(
        token_class: ^wasm_token_f64_numeric_literal,
        pattern: wasm_wat_float_literal_lex_pattern()
      ),
      wasm_lex_rule(token_class: ^wasm_token_i32_const, text: "i32.const"),
      wasm_lex_rule(token_class: ^wasm_token_i32_add, text: "i32.add"),
      wasm_lex_rule(token_class: ^wasm_token_i32_sub, text: "i32.sub"),
      wasm_lex_rule(token_class: ^wasm_token_i32_mul, text: "i32.mul"),
      wasm_lex_rule(token_class: ^wasm_token_i32_div_s, text: "i32.div_s"),
      wasm_lex_rule(token_class: ^wasm_token_i32_div_u, text: "i32.div_u"),
      wasm_lex_rule(token_class: ^wasm_token_i32_rem_s, text: "i32.rem_s"),
      wasm_lex_rule(token_class: ^wasm_token_i32_rem_u, text: "i32.rem_u"),
      wasm_lex_rule(token_class: ^wasm_token_i32_and, text: "i32.and"),
      wasm_lex_rule(token_class: ^wasm_token_i32_or, text: "i32.or"),
      wasm_lex_rule(token_class: ^wasm_token_i32_xor, text: "i32.xor"),
      wasm_lex_rule(token_class: ^wasm_token_i32_shl, text: "i32.shl"),
      wasm_lex_rule(token_class: ^wasm_token_i32_shr_s, text: "i32.shr_s"),
      wasm_lex_rule(token_class: ^wasm_token_i32_shr_u, text: "i32.shr_u"),
      wasm_lex_rule(token_class: ^wasm_token_i32_rotl, text: "i32.rotl"),
      wasm_lex_rule(token_class: ^wasm_token_i32_rotr, text: "i32.rotr"),
      wasm_lex_rule(token_class: ^wasm_token_i64_const, text: "i64.const"),
      wasm_lex_rule(token_class: ^wasm_token_i64_add, text: "i64.add"),
      wasm_lex_rule(token_class: ^wasm_token_i64_sub, text: "i64.sub"),
      wasm_lex_rule(token_class: ^wasm_token_i64_mul, text: "i64.mul"),
      wasm_lex_rule(token_class: ^wasm_token_i64_div_s, text: "i64.div_s"),
      wasm_lex_rule(token_class: ^wasm_token_i64_div_u, text: "i64.div_u"),
      wasm_lex_rule(token_class: ^wasm_token_i64_rem_s, text: "i64.rem_s"),
      wasm_lex_rule(token_class: ^wasm_token_i64_rem_u, text: "i64.rem_u"),
      wasm_lex_rule(token_class: ^wasm_token_i64_and, text: "i64.and"),
      wasm_lex_rule(token_class: ^wasm_token_i64_or, text: "i64.or"),
      wasm_lex_rule(token_class: ^wasm_token_i64_xor, text: "i64.xor"),
      wasm_lex_rule(token_class: ^wasm_token_i64_shl, text: "i64.shl"),
      wasm_lex_rule(token_class: ^wasm_token_i64_shr_s, text: "i64.shr_s"),
      wasm_lex_rule(token_class: ^wasm_token_i64_shr_u, text: "i64.shr_u"),
      wasm_lex_rule(token_class: ^wasm_token_i64_rotl, text: "i64.rotl"),
      wasm_lex_rule(token_class: ^wasm_token_i64_rotr, text: "i64.rotr"),
      wasm_lex_rule(token_class: ^wasm_token_f32_const, text: "f32.const"),
      wasm_lex_rule(token_class: ^wasm_token_f32_add, text: "f32.add"),
      wasm_lex_rule(token_class: ^wasm_token_f32_sub, text: "f32.sub"),
      wasm_lex_rule(token_class: ^wasm_token_f32_mul, text: "f32.mul"),
      wasm_lex_rule(token_class: ^wasm_token_f32_div, text: "f32.div"),
      wasm_lex_rule(token_class: ^wasm_token_f32_min, text: "f32.min"),
      wasm_lex_rule(token_class: ^wasm_token_f32_max, text: "f32.max"),
      wasm_lex_rule(token_class: ^wasm_token_f32_copysign, text: "f32.copysign"),
      wasm_lex_rule(token_class: ^wasm_token_f64_const, text: "f64.const"),
      wasm_lex_rule(token_class: ^wasm_token_f64_add, text: "f64.add"),
      wasm_lex_rule(token_class: ^wasm_token_f64_sub, text: "f64.sub"),
      wasm_lex_rule(token_class: ^wasm_token_f64_mul, text: "f64.mul"),
      wasm_lex_rule(token_class: ^wasm_token_f64_div, text: "f64.div"),
      wasm_lex_rule(token_class: ^wasm_token_f64_min, text: "f64.min"),
      wasm_lex_rule(token_class: ^wasm_token_f64_max, text: "f64.max"),
      wasm_lex_rule(token_class: ^wasm_token_f64_copysign, text: "f64.copysign")
    ],
    modes: []
  }
}

fn wasm_lex() -> LexRules {
  ModeledLexRules { root: wasm_lex_rules() }
}

fn wasm_formal_rhs_from_tokens(tokens: List<ConcreteSyntaxToken>) -> List<FormalGrammarSymbol> {
  fold_list(
    xs: tokens,
    empty: Empty,
    cons: fn(acc, token) {
      list_snoc_item(
        xs: acc,
        item: grammar_formal_terminal(identity: concrete_syntax_token_class(token: token))
      )
    }
  )
}

fn wasm_formal_production_fn_add() -> FormalProduction {
  grammar_formal_production(
    lhs: ^wasm_production_fn_add,
    rhs: wasm_formal_rhs_from_tokens(tokens: wasm_concrete_tokens())
  )
}

fn wasm_formal_productions() -> List<FormalProduction> {
  [
    grammar_formal_production(lhs: ^wasm_production_value_type, rhs: [grammar_formal_terminal(identity: ^wasm_token_type_i32)]),
    grammar_formal_production(lhs: ^wasm_production_value_type, rhs: [grammar_formal_terminal(identity: ^wasm_token_type_i64)]),
    grammar_formal_production(lhs: ^wasm_production_value_type, rhs: [grammar_formal_terminal(identity: ^wasm_token_type_f32)]),
    grammar_formal_production(lhs: ^wasm_production_value_type, rhs: [grammar_formal_terminal(identity: ^wasm_token_type_f64)]),
    grammar_formal_production(lhs: ^wasm_production_localidx, rhs: [grammar_formal_terminal(identity: ^wasm_token_localidx_literal)]),
    grammar_formal_production(lhs: ^wasm_production_localidx, rhs: [grammar_formal_terminal(identity: ^wasm_token_ident)]),
    grammar_formal_production(lhs: ^wasm_production_i32_numeric_literal, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_numeric_literal)]),
    grammar_formal_production(lhs: ^wasm_production_i64_numeric_literal, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_numeric_literal)]),
    grammar_formal_production(lhs: ^wasm_production_f32_numeric_literal, rhs: [grammar_formal_terminal(identity: ^wasm_token_f32_numeric_literal)]),
    grammar_formal_production(lhs: ^wasm_production_f64_numeric_literal, rhs: [grammar_formal_terminal(identity: ^wasm_token_f64_numeric_literal)]),
    grammar_formal_production(
      lhs: ^wasm_production_numeric_const_instr,
      rhs: [
        grammar_formal_terminal(identity: ^wasm_token_i32_const),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_i32_numeric_literal)
      ]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_numeric_const_instr,
      rhs: [
        grammar_formal_terminal(identity: ^wasm_token_i64_const),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_i64_numeric_literal)
      ]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_numeric_const_instr,
      rhs: [
        grammar_formal_terminal(identity: ^wasm_token_f32_const),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_f32_numeric_literal)
      ]
    ),
    grammar_formal_production(
      lhs: ^wasm_production_numeric_const_instr,
      rhs: [
        grammar_formal_terminal(identity: ^wasm_token_f64_const),
        grammar_formal_nonterminal_occurrence(identity: ^wasm_production_f64_numeric_literal)
      ]
    ),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_add)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_sub)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_mul)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_div_s)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_div_u)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_rem_s)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_rem_u)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_and)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_or)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_xor)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_shl)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_shr_s)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_shr_u)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_rotl)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i32_rotr)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_add)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_sub)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_mul)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_div_s)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_div_u)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_rem_s)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_rem_u)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_and)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_or)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_xor)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_shl)]),
