    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_i64_rotr)]),
    grammar_formal_production(lhs: ^wasm_production_numeric_binop_instr, rhs: [grammar_formal_terminal(identity: ^wasm_token_f32_add)]),
