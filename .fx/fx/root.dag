module fx.root

import std.types { Bool, Int }
import fx.owner { owner_reads_its_own }
import fx.puller { pull_stranger_into_closure }

fn both_present() -> Int {
  pull_stranger_into_closure()
}

test fn owner_binds_its_own_local_declaration() -> Bool {
  owner_reads_its_own() == 111
}

test fn stranger_binds_its_own_local_declaration() -> Bool {
  both_present() == 222
}
