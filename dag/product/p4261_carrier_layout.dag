    InstalledComponent { component: e1_d2, terminals: names(ns: ["tab nearer J20", "tab farther from J20"]), identification: MarkingSharedByMakers { rows: e1_shared_tvs_rows, marking: MarkingReading { text: "5PGK / ZCN5U under a boxed maker logo that is not identified", evidence: e1_photo(taken_on: "2026-10-15", locator: "D2 close-up sent in the session") } } },
    InstalledComponent { component: e1_d5, terminals: names(ns: ["top tab", "bottom tab"]), identification: MarkingSharedByMakers { rows: e1_shared_tvs_rows, marking: MarkingReading { text: "5PGK / 2CN5U", evidence: e1_photo(taken_on: "2026-10-16", locator: "F300 photograph sent in the session, D5 in frame") } } },
    InstalledComponent { component: e1_f300, terminals: names(ns: ["one end", "other end"]), identification: RatingPrintedOnBody { rating: PrintedFuseRating { current: ampere(count: 100), interrupt_voltage: Present { value: volt(count: 75) } }, marking: MarkingReading { text: "LF 75V 100A", evidence: e1_photo(taken_on: "2026-10-16", locator: "F300 photograph sent in the session") } } },
    InstalledComponent { component: e1_f302, terminals: names(ns: ["one pad", "other pad"]), identification: FootprintUnpopulated { evidence: e1_photo(taken_on: "2026-10-16", locator: "F300 photograph sent in the session") } },
    InstalledComponent { component: e1_f1, terminals: names(ns: ["end nearer J20", "end farther from J20"]), identification: RatingPrintedOnBody { rating: PrintedFuseRating { current: ampere(count: 12), interrupt_voltage: Absent }, marking: MarkingReading { text: "LF 12A", evidence: e1_photo(taken_on: "2026-10-15", locator: "J20 close-up sent in the session") } } },
    InstalledComponent { component: e1_component(local: "R010 shunt beside F1"), terminals: [], identification: ResistanceCodeRead { milliohms: 10, marking: MarkingReading { text: "R010", evidence: e1_photo(taken_on: "2026-10-15", locator: "J20 close-up sent in the session") } } },
    InstalledComponent { component: e1_c10, terminals: names(ns: ["positive", "negative"]), identification: IdentifiedByMarking { row: eeh_zu1j151, marking: MarkingReading { text: "150 / J ZU / 26AL", evidence: e1_photo(taken_on: "2026-10-15", locator: "J20 close-up sent in the session") } } },
    InstalledComponent { component: e1_c12, terminals: names(ns: ["positive", "negative"]), identification: IdentifiedByMarking { row: eeh_zu1j151, marking: MarkingReading { text: "150 / J ZU / 26AL", evidence: e1_photo(taken_on: "2026-10-15", locator: "J20 close-up sent in the session") } } },
    InstalledComponent { component: e1_third_can, terminals: names(ns: ["positive", "negative"]), identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "partly visible '...ZU / ...AL'", evidence: e1_photo(taken_on: "2026-10-15", locator: "J20 close-up sent in the session") } }, discriminator: "a full read of its top marking" } },
    InstalledComponent { component: e1_component(local: "switch candidate between R010 and the capacitors"), terminals: [], identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "...08N10 / SWAC (partly legible, photographed upside down)", evidence: e1_photo(taken_on: "2026-10-15", locator: "switch close-up sent in the session") } }, discriminator: "a sharp close-up of the marking matched to its maker's marking table; 'N10' is how Infineon names its 100 V parts, a lead rather than an identification" } },
    InstalledComponent { component: e1_input_fet, terminals: names(ns: e1_fet_terminal_names), identification: MarkingUnresolved { marking: Absent, discriminator: "read its designator and top marking; the K1's input-stage MOSFETs read 017N10LF (IPB017N10N5LF), a lead for this one, not its identity" } },
    InstalledComponent { component: e1_component(local: "U522"), terminals: names(ns: ["1", "2", "3", "4", "5", "6", "7", "8"]), identification: IdentifiedByMarking { row: tmp275_dgk, marking: MarkingReading { text: "TI 31 / T275", evidence: e1_photo(taken_on: "2026-10-15", locator: "U522 close-up sent in the session") } } },
