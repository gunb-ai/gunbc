  e1_pad_read(a: e1_u500_pad, b: e1_ground_ref, ohms: 300, polarity: RedOnSecond),
  e1_pad_read(a: e1_q300_lead_b, b: e1_u500_pad, ohms: 1000, polarity: RedOnSecond),
]

// How many of a part's terminals read at or below a ceiling from Q300's lead b, from the record: the
// count that says whether a part meets the gate network at one contact or sits across it.
fn terminals_reading_at_most(rs: List<ResistanceObservation>, c: ComponentInstanceIdentity, names: List<NonEmptyStr>, ceiling_ohms: Nat) -> List<NonEmptyStr> {
  filter(names, n => any(rs, o => observation_reads_pair(o: o, a: e1_q300_lead_b, b: e1_terminal(c: c, name: n)) && match valued_ohms(o: o) { Present { value: v } => v <= ceiling_ohms, Absent => false }))
}


// THE ENABLE CHAIN, ENERGIZED (2026-10-20, the source at 54 V, against J20's black lead). Q300's lead b
// reads 0 V, P6 0 V, and the far end of the resistor beside Q301 54 V: the input itself. With the via's
// 4.9 V at 54 V, Q301's lead b sits near a tenth of the input, fed from it through that resistor.
// Under the candidate BSS138 pinout that is Q300 off, Q301 on and P6 at the return; these are readings
// at P6 and at the parts' pads, not at pin 7.
data e1_zv_said: NonEmptyStr = "V3 - 0v / ZV1 - 0v / ZV2 - 54v"

fn e1_zv_read(at: ElectricalTerminalRef, millivolts: Nat) -> NodeVoltageObservation {
  NodeVoltageObservation {
    asset: p4261_e1_b, at: at, reference: e1_ground_ref,
    record: second_point_inferred(basis: "the sheet's setup: the meter's black probe on J20's black lead, which joins J20's latch-side row; position 1 stands for the row"),
    conditions: e1_live_bench, source: volt(count: 54), value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-20", verbatim: e1_zv_said }, OperatorStatement { stated_on: "2026-10-20", verbatim: "Yeah it was 54v" }, e1_resistor_marking_photo],
  }
}

data e1_zv_volts: List<NodeVoltageObservation> = [
  e1_zv_read(at: e1_q300_lead_b, millivolts: 0),
  e1_zv_read(at: e1_terminal(c: e1_back_cluster, name: "P6"), millivolts: 0),
  e1_zv_read(at: e1_q301_resistor_far, millivolts: 54000),
]

// ── THE LOCAL CONTROLS AND THE PHASES THEY PUT THE CARRIER THROUGH (2026-10-20) ─────────────
//
// Module absent, J20 fed as before. The operator found the two DIP packages S1 and S2 while following
// Q300's trace, and the carrier's draw and indicators changed; then set the poles one at a time and
// bridged two headers. Every phase below is a recorded state; its name is derived in
// product.electrical.carrier_phase from the record, never from what a switch or header is for. The
// source's setting for the staircase is carried forward from the switch-event photographs (54.00 V,
// OCP armed) and the session's 0.10 A limit: the operator was asked whether the steps were at 48 V or
// 54 V and has not answered. Two currents are kept as typed, each with both values it could mean.
data e1_s1: ComponentInstanceIdentity = e1_component(local: "S1")
data e1_s2: ComponentInstanceIdentity = e1_component(local: "S2")
data e1_j68: ComponentInstanceIdentity = e1_component(local: "J68")
data e1_j30: ComponentInstanceIdentity = e1_component(local: "J30")
data e1_u49: ComponentInstanceIdentity = e1_component(local: "U49")
data e1_u51: ComponentInstanceIdentity = e1_component(local: "U51")
data e1_u1_tfp_blinker: ComponentInstanceIdentity = e1_component(local: "indicator blinking near U1_TFP (designator unrecorded)")
data e1_j68_points: List<NonEmptyStr> = ["L1", "L2", "L3", "L4", "L5", "R1", "R2", "R3", "R4", "R5"]
// The operator's labelled photographs (2026-10-21) fix the positions: J68's left column L1 to L5 and
// right column R1 to R5, top to bottom as photographed, labelled 'positions (not pin numbers)'; J30's
// A, B, C left to right. Every J68 and J30 reading from here on uses these.
data e1_j68_labelled_photo: EvidenceRef = e1_photo(taken_on: "2026-10-21", locator: "bench-session upload: J68 with L1 to L5 down the left column and R1 to R5 down the right, captioned 'J68 positions (not pin numbers)'; and J30 with A, B, C marked left to right (not on Drive)")
data e1_j68_ohms_said: NonEmptyStr = "All at 2k / R1 at 0.00 R2: 0.057 R3: high R4: high R5: ground / L1: .937 L2: .538 L3: 1.153 L4: high L5: 1.153"
fn e1_j68_read(n: NonEmptyStr, display: ResistanceDisplay) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: e1_terminal(c: e1_j68, name: n), second: e1_ground_ref,
    record: both_points_recorded,
    conditions: e1_bench, polarity: PolarityUnrecorded, range: RangeFullScale { ohms: 2000 }, display: display, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-21", verbatim: e1_j68_ohms_said }, e1_j68_labelled_photo],
  }
}
// J68's ten positions to J20's black lead on the 2k range, unpowered (2026-10-21), under the labelled
// photograph: R1 '0.00' and R5 'ground' are zeros without a baseline (they join nothing in the live
// netlist); R2 57 ohm; R3, R4 and L4 over range; L1 937 ohm; L2 538; L3 and L5 both 1153. The shape is
// Intel's ten-pin JTAG layout read position by position (grounds at 2 and 10, VCC at 4, no connection
// at 6, 7 and 8, TCK with a pull-down at 1, TMS and TDI with matching pull-ups at 5 and 9, TDO at 3),
// with L as the odd pins and R the even: a candidate pinout the hypothesis names and the powered
// re-read under the same labels decides. The powered map of 2026-10-20 ('R1, L2-5 are all 1.8v') named
// R1 high, which under this labelling reads as the return, so one of the two counts was oriented
// differently; the labelled photograph is the authority from here on.
data e1_j68_resistances: List<ResistanceObservation> = [
  e1_j68_read(n: "R1", display: DisplayZeroWithoutBaseline { reported: "0.00" }),
  e1_j68_read(n: "R2", display: DisplayValue { ohms: 57, approximate: false }),
  e1_j68_read(n: "R3", display: DisplayOverRange),
  e1_j68_read(n: "R4", display: DisplayOverRange),
  e1_j68_read(n: "R5", display: DisplayZeroWithoutBaseline { reported: "ground" }),
  e1_j68_read(n: "L1", display: DisplayValue { ohms: 937, approximate: false }),
  e1_j68_read(n: "L2", display: DisplayValue { ohms: 538, approximate: false }),
  e1_j68_read(n: "L3", display: DisplayValue { ohms: 1153, approximate: false }),
  e1_j68_read(n: "L4", display: DisplayOverRange),
  e1_j68_read(n: "L5", display: DisplayValue { ohms: 1153, approximate: false }),
]
data e1_j68_high_points: List<NonEmptyStr> = ["R1", "L2", "L3", "L4", "L5"]
data e1_j68_low_points: List<NonEmptyStr> = ["L1", "R2", "R3", "R4", "R5"]
data e1_j30_points: List<NonEmptyStr> = ["A", "B", "C"]
data e1_switch_event_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session uploads: the source's display at 54.00 V / 0.085 A / 4.587 W with CV lit, and the lit indicator groups beside the heatsinked control region and at the board edge (not on Drive)")
data e1_switch_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session uploads: S1 beside J540 and DS3 to DS6, and S2 near the large high-density connectors, each a two-pole package with a printed ON legend (not on Drive)")
data e1_settled_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session uploads: the settled state's indicators, the top group beside DS10 to DS13, DS1_2, and the bottom group DS3 to DS6 (not on Drive)")
data e1_j68_held_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session upload: J68 bridged and held, every indicator dark (not on Drive)")
data e1_lv165a_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session uploads: U49 and U51 close enough to read 'LV165A / 2BKG4 / AEC0' on each (not on Drive)")
data e1_switch_event_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "I tried to trace over to the side of the board where Q30 leads, and found some literal on off switches - the current jumped a bit and some lights turned on." }
data e1_headers_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "Some of these Pinouts seem to do something - basically, j68 either has a reset for some portion or it's shorting and causing a reset - j30 seems to something. The switches enable distinct power phases with different consequences - the bottom switch S2 seems more important for the initial startup - I'm not sure if S1 is doing anything here" }
data e1_j68_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "Regarding J68 - when i short R1 and R2 - i hear an audible click, and the circuit repeats/resets a phase (or it holds it down, and then when i release again it automatically tries to boot again)" }
data e1_j30_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "Regarding J30 - when I short A and B, something similar seems to happen, but its not a hard reset, more like a softer reset through the same sort of phase" }
data e1_s2_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "S2 (switch 1 and 2, labelledo n the switch): switch 1 off, switch 2 on:  N/A - same .013A, nothing happens - when i have switch 1 on, switch 2 off: amp jumps to .038A, but no LEDs at all." }
data e1_s1_inert_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "This seems like the first distinct phase I could find.  At this point, toggling either S1 switch does nothing." }
data e1_s1_sequence_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "Now, next phase is toggling S1 switch 2 on: jumps to ~.08A, and then after a moment jumps again to .094 and the lights settle (from all lit to a few lit/one blinking near U1_TFP)" }
data e1_s1_after_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "At this point, turning S1 switch 1 off doesn't matter - it seems to have done its job, turning it off is a no - op, turning S2 returns back to the initlal state." }
data e1_bridges_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "At this point, and before, neither S1 switch seems to change anything.  At this point, if I short A and B on j30, it does the soft reset - and slowly returns to .94A - if I short R1 and R2 on J68 - it does a harder reset and stalls at .7A, until I let go - all the LEDs switch off in some kind of intermediary - i hear an audible click when i do this." }
data e1_blinkers_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "I pointed to two blinking green lights - second picture and third - ds4 and ds3 light up as long as I hold J30 short" }
data e1_j30_volts_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "J30 reads 3.1v, on pin 1 it's 0v" }
data e1_j68_held_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "Last picture: holding j68 turns all lights off, releasing starts boot sequence over" }
data e1_j68_volts_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "J68: R1, L2-5 are all 1.8v, the rest are 0v" }
// The 2026-10-20 powered map was read under a count the labelled photograph of 2026-10-21 does not
// reproduce: its R1 at 1.8 V is, under the labels, a position that reads as the return unpowered. The
// rows stay in the settled phase as read, hedged with that dispute, superseded once the labelled
// re-read lands in e1_j68_volts_under_labels.
data e1_j68_orientation_dispute: NonEmptyStr = "orientation disputed: read 2026-10-20 under a count that named R1 high; under the labelled positions of 2026-10-21, R1 reads as the return unpowered, so this map's L/R and 1 to 5 may be rotated against the labels"
// The labelled powered re-read (2026-10-21, energized at 48 V, module removed; the phase and the draw
// at the reading were not restated, the re-read having been asked for in the settled state): R1, R3,
// R4, R5, L1 and L4 at 0 V; R2, L2, L3 and L5 at 1.8 V. Under the candidate map that is the two
// returns at 0 V, the reference at 1.8 V (VCCPGM, so the FPGA's JTAG bank is powered), TCK held low by
// its pull-down, TMS and TDI pulled up, TDO high, and the three no-connect positions resting low.
data e1_j68_powered_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "R1: 0v R2: 1.8V R3: 0v R4: 0v R5: 0v L1: 0v L2: 1.8v L3: 1.8v L4: 0v L5: 1.8v" }
fn e1_j68_labelled_volt(point: NonEmptyStr, millivolts: Nat) -> PhaseNodeVoltage {
  PhaseNodeVoltage { at: e1_terminal(c: e1_j68, name: point), reference: e1_ground_ref, value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly, evidence: e1_j68_powered_said }
}
data e1_j68_volts_under_labels: List<PhaseNodeVoltage> = concat(
  map(["R1", "R3", "R4", "R5", "L1", "L4"], n => e1_j68_labelled_volt(point: n, millivolts: 0)),
  map(["R2", "L2", "L3", "L5"], n => e1_j68_labelled_volt(point: n, millivolts: 1800)))
data e1_setting_basis: NonEmptyStr = "the operator, asked whether the steps were at 48 V or 54 V: 'usually the supply was 48v at .10A, or .6A, but agin, no difference' and 'i had the amperage at .6A regularly so .1A was definitely not capping it, its not taking more' (2026-10-20); the voltage is the candidates' agreement, which limit any one step ran under is unrecorded, and the switch-event photographs alone show 54.00 V"
data e1_ceiling_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "i had the amperage at .6A regularly so .1A was definitely not capping it, its not taking more." }
data e1_j68_current_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "yes, its .07A, usually the supply was 48v at .10A, or .6A, but agin, no difference" }
data e1_phase_setting: SourceSettingStanding = SettingOneOf { candidates: [SourceSetting { voltage: volt(count: 48), current_limit: milliampere(count: 100), protection: OverCurrentShutoffArmed }, SourceSetting { voltage: volt(count: 48), current_limit: milliampere(count: 600), protection: OverCurrentShutoffArmed }], basis: e1_setting_basis }
data e1_pole_label_basis: NonEmptyStr = "the operator's 'switch 1' and 'switch 2' are the poles as the package prints them; 'on' is read as the actuator toward the printed ON legend, which no continuity reading has yet confirmed closes the pole"

fn e1_pole(package: ComponentInstanceIdentity, pole: Nat, position: SwitchPolePosition) -> SwitchPoleState {
  SwitchPoleState { package: package, pole: pole, position: position }
}

// THE SAME INDUCTORS ON THE E1, SETTLED (2026-10-21), against J20's black lead: the 4R7 nearest U4 about
// 3.2 V and the 2R2 0.94 V ('the other r47 and 242 are powered now'; the farther 4R7 is unread on the
// E1). 0.94 V is the level of the Cyclone 10 GX's core supply (VCC, 0.9 V nominal per Intel's handbook,
// a candidate reading of the 2R2's converter, not a traced one). The two the K1 holds at 0 V the E1
// runs, so the E1's U4 domain powers and the K1's does not.
data e1_l_4r7_near: ComponentInstanceIdentity = e1_component(local: "4R7 inductor nearest U4")
data e1_l_2r2: ComponentInstanceIdentity = e1_component(local: "2R2 inductor beside U4")
data e1_l_4r7_far: ComponentInstanceIdentity = e1_component(local: "the farther 4R7 inductor beside U4")
data e1_inductor_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "3. the other r47 and 242 are powered now, at ~3.2 and .94v respectively" }
fn e1_l_volt(c: ComponentInstanceIdentity, millivolts: Nat) -> PhaseNodeVoltage {
  PhaseNodeVoltage { at: e1_terminal(c: c, name: inductor_pad_unrecorded), reference: e1_ground_ref, value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly, evidence: e1_inductor_said }
}
data e1_inductor_volts: List<PhaseNodeVoltage> = [e1_l_volt(c: e1_l_4r7_near, millivolts: 3200), e1_l_volt(c: e1_l_2r2, millivolts: 940)]

// THE SECOND INCIDENT (2026-10-21, later the same day): reading the 4R7 nearest U4 energized and
// settled, the probe joined its pad to the ground pads under the part. From then on the source cycled,
// CC lit, then 13 mA, then 97 mA, then CC again, the board restarting over and over; nothing new was
// seen on the board and nothing around U4 was warm after power-off. Unpowered afterward, both pads of
// that 4R7 read 0 on the 2k range to J20's black lead where the K1's same pad reads about 4 kohm, and
// the rail had read about 3.2 V an hour earlier (e1_inductor_volts): the rail that inductor feeds is
// shorted to the return since the incident, and the E1 stays unpowered until the short is located by
// splitting the rail at the inductor. The three inductors each read 0 ohm pad to pad on the 200 range,
// so the inductors themselves are whole. Photographed afterward (e1_near_4r7_area_photo): the inductor
// sits against U4's heatsink edge with U21, an 8-lead package with a pin-1 dot and a thermal pad,
// directly above it and U69, another 8-lead, to U21's right; two large ceramics to the inductor's right
// and two below it; a 6-lead package below-left; and the silkscreen 'U1_2' at the right edge, so the
// rail runs toward the '_2' island. U21 reads 'P617A / 01 14 / 226', NXP's PCA9617ADP I2C-bus repeater,
// so U21 is not this inductor's converter; the converter candidate is U100, the 6-lead SOT-23 marked
// 'C3U / S22 / 25' beside the inductor (e1_u100_photo).
// Which inductor pad is the switch node and which the output, which of the ceramics sit on the output,
// and which loads the rail supplies are unread until that converter is identified. Markings unread.
data e1_near_4r7_area_photo: EvidenceRef = e1_photo(taken_on: "2026-10-21", locator: "bench-session upload efd0d163: the 4R7 nearest U4 after the short, with U21 and U69 above it, four ceramics beside and below it, a 6-lead package below-left, U4's heatsink edge at the left and 'U1_2' at the right edge")
data e1_u21: ComponentInstanceIdentity = e1_component(local: "U21")
data e1_u69: ComponentInstanceIdentity = e1_component(local: "U69")
// Two close photographs later the same day: U21 reads 'P617A / 01 14 / 226', NXP's marking for the
// PCA9617ADP I2C-bus repeater (extdeps.electronic_component.nxp_pca9617a), and U53 below it reads the
// same; a third of the same shape sits by U69 and is not read sharply. Three I2C repeaters beside J24
// make J24 an I2C / SMBus header candidate, which its ten contacts at 405 to 485 ohm with no return
// (e1_j24_resistances) fit as pulled-up bus lines; nothing is read through J24 on that account. U100,
// the 6-lead SOT-23 beside the inductor with a pin-1 dot, reads 'C3U / S22 / 25', a top-marking code
// no table read so far decodes; it is the converter candidate for the inductor by its place and its
// package, and its pins are mapped on the K1 before any datasheet is assumed.
data e1_u21_marking_photo: EvidenceRef = e1_photo(taken_on: "2026-10-21", locator: "bench-session upload c1405100: the 4R7 nearest U4 with U21 ('P617A / 01 14 / 226'), U53 (the same marking), U69's neighbour, U100 and the U10_P2 silkscreen, J24 and J68 at the frame's foot")
data e1_u100_photo: EvidenceRef = e1_photo(taken_on: "2026-10-21", locator: "bench-session upload cbc94a7e: U100 ('C3U / S22 / 25', pin-1 dot) beside the 4R7 nearest U4, two '330' polymers at the left, a 5-lead package marked 'DFP 528' below the inductor, U21 at the top right")
data e1_u53: ComponentInstanceIdentity = e1_component(local: "U53")
data e1_u100: ComponentInstanceIdentity = e1_component(local: "U100")
data e1_short_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "uh oh - i think i shorted something - the circuit is like looping now - when i was measuring that inductor i was shorting it to ground, not thinking that it was a mistake? / the E1 - the closer 4R7, i was probing it to ground, the pads under it / the supply is going from CC back to .013 now - 'CC' is red and lights up and quickly drops back to .097 / don't see anything on the board" }
data e1_short_after_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "idk nothing is hot / 4R7 near U4 is showing both terminals at ground on 2k. On K1, that 4R7 is ~4k ohms / yeah they're all at 0 ohms" }
data e1_ground_pads_under_l: ComponentInstanceIdentity = e1_component(local: "ground pads under the 4R7 nearest U4")
data e1_inductor_short_incident: BenchIncident = BenchIncident {
  key: "2026-10-21 inductor short",
  asset: p4261_e1_b,
  bridged: [e1_terminal(c: e1_l_4r7_near, name: inductor_pad_unrecorded), e1_terminal(c: e1_ground_pads_under_l, name: "pad (which unrecorded)")],
  record: both_points_inferred(first_basis: "'the closer 4R7, i was probing it to ground': which of its two pads the probe sat on is unrecorded", second_basis: "'the pads under it': a ground pad under the part, which one unrecorded"),
  conditions: e1_module_unrecorded_bench,
  observed: "the source cycling with no new sight on the board: CC lit, then 13 mA, then 97 mA, then CC again",
  inspection: NoDamageSeen { looked_at: "by touch after power-off (2026-10-21, 'idk nothing is hot'); by eye under the Andonstar on 2026-10-31 after both carriers' sites were cleaned with isopropyl: the 4R7's two joints, the converter's body and leads, the ceramics beside them and the ground pads under the inductor, nothing broken, cracked or singed ('nothing is obviously broken/singed'); the fault is internal to a part" },
  evidence: e1_short_said,
}
fn e1_after_short_read(first: ElectricalTerminalRef, second: ElectricalTerminalRef, ohms_full_scale: Nat, display: ResistanceDisplay) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: first, second: second, record: both_points_recorded,
    conditions: e1_bench, polarity: PolarityUnrecorded, range: RangeFullScale { ohms: ohms_full_scale }, display: display, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key, e1_inductor_short_incident.key] },
    evidence: [e1_short_after_said],
  }
}
data e1_after_short_resistances: List<ResistanceObservation> = [
  e1_after_short_read(first: e1_terminal(c: e1_l_4r7_near, name: inductor_pad_near_u4), second: e1_ground_ref, ohms_full_scale: 2000, display: DisplayZeroWithoutBaseline { reported: "ground" }),
  e1_after_short_read(first: e1_terminal(c: e1_l_4r7_near, name: inductor_pad_far_u4), second: e1_ground_ref, ohms_full_scale: 2000, display: DisplayZeroWithoutBaseline { reported: "ground" }),
  e1_after_short_read(first: e1_terminal(c: e1_l_4r7_near, name: inductor_pad_near_u4), second: e1_terminal(c: e1_l_4r7_near, name: inductor_pad_far_u4), ohms_full_scale: 200, display: DisplayZeroWithoutBaseline { reported: "0 ohms" }),
  e1_after_short_read(first: e1_terminal(c: e1_l_4r7_far, name: inductor_pad_near_u4), second: e1_terminal(c: e1_l_4r7_far, name: inductor_pad_far_u4), ohms_full_scale: 200, display: DisplayZeroWithoutBaseline { reported: "0 ohms" }),
  e1_after_short_read(first: e1_terminal(c: e1_l_2r2, name: inductor_pad_near_u4), second: e1_terminal(c: e1_l_2r2, name: inductor_pad_far_u4), ohms_full_scale: 200, display: DisplayZeroWithoutBaseline { reported: "0 ohms" }),
]
// The K1's same pad, read unpowered the same evening as the healthy reference: about 4 kohm on the 2k
// range (a 2k range reading 4 kohm is over range or a misreported range; the figure is kept as said).
data k1_l_4r7_near_resistance: ResistanceObservation = ResistanceObservation {
  asset: p4261_k1_a, first: terminal_ref(component: k1_l_4r7_near, terminal: inductor_pad_unrecorded as TerminalIdentity), second: k1_return, record: both_points_recorded,
  conditions: k1_bench, polarity: PolarityUnrecorded, range: RangeFullScale { ohms: 2000 }, display: DisplayValue { ohms: 4000, approximate: true }, stability: StabilityUnrecorded,
  certainty: StatedHedged { verbatim: "~4k ohms" }, order: BeforeIncidents { keys: [] }, evidence: [e1_short_after_said],
}

// ── THE NEAR-4R7 CONVERTER AND U100, READ LEAD BY LEAD (2026-10-23 to 2026-10-31) ─────────────
//
// Unpowered, J20 disconnected, the Fluke auto-ranging, black probe on the return or on an inductor pad,
// red on the lead. U100's eight leads were read first (2026-10-23): the dot side at the return on both
// carriers, the far side kilohms, and on the K1 no lead at the baseline to either pad of the inductor
// beside it, which took U100 out of the running as that inductor's converter. The 8-lead part beside
// the inductor, marked 'BDFP 528' on the K1 (2026-10-24; the E1's reads 'DFP 528' in e1_u100_photo, its
// first glyph unread), is the converter, MPS's MP2333CGTL by its documented top marking, with one lead
// wired straight to the inductor's pad. Its leads were read 2026-10-31 under the operator's own labels,
// T1-T4 along the row at the inductor's side and B1-B4 along the other, each from the inductor end. The
// datasheet runs pins 1-4 (PG, VIN, SW, GND) down one side and 8-5 (FB, SS, EN, BST) down the other,
// pin 4 across from pin 5; T1 at the return on both carriers (GND) and T2 on the inductor's pad (SW)
// put GND and SW at the inductor end, so T1-T4 are pins 4, 3, 2, 1 and B1-B4 pins 5, 6, 7, 8. That
// attribution is an inference from the operator's labels and the row's pin order, so each lead reading
// carries its first point as inferred with the label it rests on, and a derivation resting on one says
// so. The K1's photograph of its read shows the U2_P2 silkscreen, and two wide photographs taken later
// that evening (k1_u4_area_photo_1031, k1_two_4r7_photo_1031) place the designators: on the K1, as on
// the E1, the 4R7 nearest U4 has U100 above it and its converter, U10_P2, below it, and the farther 4R7
// has its own converter, U2_P2, with Q6_P2, Q5_P2, D6_P2, U50 and U550 around it. So the K1's eight
// leads of 2026-10-31 are taken as the farther 4R7's converter's, a sibling of the same package and
// circuit whose marking is unread, and the near-U4 converter on the K1 (U10_P2, the part marked 'BDFP
// 528' on 2026-10-24) was read later that evening from a labelled copy of the operator's close-up
// (k1_near_converter_lead_resistances): the same figures as U2_P2's, but BST over range where U2_P2
// read 134 kohm and the E1 reads 0, and SS 19 Mohm. The operator confirmed the far site from the
// photograph, so what each K1 reading carries as inferred is the pin, not the chip. Two readings of the
// first evening exceed any handheld
// Fluke's resistance range (SS at 130 Mohm on the E1, 50 Mohm on the K1): kept as said; the display most
// likely read over range, and the meter's model is unrecorded.
data converter_said_1023_e1: EvidenceRef = OperatorStatement { stated_on: "2026-10-23", verbatim: "Ok all the pins on the dot side are 1 ohm, the bottom two on the left are 900 ohms, the top two on the left are 5.5k ohms - all done with the fluke auto mode" }
data converter_said_1023_k1: EvidenceRef = OperatorStatement { stated_on: "2026-10-23", verbatim: "The right side is still ground, but the left side is 6k, 6k, 10k 10k from the bottom up - the baseline is 0" }
data converter_said_1023_pads: EvidenceRef = OperatorStatement { stated_on: "2026-10-23", verbatim: "K1: red u100 left pins, black on the left pad- 4k, 4k, 12k, 12k / Right pins, right pad: 8k for all / E1 left pins left pad- 1k, 3k, 8k, 4k - right side, all baseline" }
data converter_said_1024: EvidenceRef = OperatorStatement { stated_on: "2026-10-24", verbatim: "1. 8.3k on both 2. 4k, 12k, 12k, 12k 3. I see BDFP 528 - the top two left pins In this picture are connected to 4r7 directly" }
data converter_photo_1024: EvidenceRef = OperatorPhotograph { taken_on: "2026-10-24", locator: "bench-session photograph on the K1: the 8-lead package beside the 4R7 by U100, marked 'BDFP / 528', two of its leads at the inductor end running toward the inductor's pad (converter_said_1024, item 3)" }
data e1_converter_area_photo_1031: EvidenceRef = e1_photo(taken_on: "2026-10-31", locator: "Andonstar frame, upload ca51a451: the 4R7 nearest U4 with the 8-lead converter to its right, leads in a top and a bottom row, two large ceramics at the top right, two 0603 parts fitted under the inductor, the U10_P2 silkscreen at the bottom right; cleaned, nothing broken or singed")
data k1_converter_area_photo_1031: EvidenceRef = k1_photo(locator: "Andonstar frame, upload a84251b4 (taken 2026-10-31): a 4R7 with the 8-lead converter to its right, one large ceramic and a via at the top right, four empty pads under the inductor, the U2_P2, D6_P2, Q5_P2, U50 and U550 silkscreens around it; cleaned, nothing broken or singed")
data k1_u4_area_photo_1031: EvidenceRef = k1_photo(locator: "upload 55f5fd51 (taken 2026-10-31): U4's heatsink with the board right of and below it: U21, U69 and U53 beside the heatsink, J24 and the J68 header to the right, V1_TFP, U1_2, U104, U105 and U5_2 above; below the heatsink the three inductors beside U4: 2R2 at the left with U9_P2 and V9_P2 beside it, the 4R7 nearest U4 with U100 above-left of it and the U10_P2 silkscreen below-left, the farther 4R7 with Q6_P2 at its left and Q5_P2, U2_P2, D6_P2, U50 and U550 below it, U1_TNE and U95 to its right, and 1R0 with U1_P2 at the bottom left")
data k1_two_4r7_photo_1031: EvidenceRef = k1_photo(locator: "upload 16b4e93a (taken 2026-10-31): the two 4R7s one above the other with three '330' polymers at the left; each 4R7 has an 8-lead package just below it with two large ceramics to that package's right; the upper 4R7 (nearest U4) has U100 above-left of it and the U10_P2 silkscreen beside the package below it, the lower 4R7 has Q6_P2 at its left and Q5_P2, U2_P2, D6_P2 and U50 below; J68 and U1_TNE to the right")
data converter_said_1031: EvidenceRef = OperatorStatement { stated_on: "2026-10-31", verbatim: "E1: T1: 0 ohm T2: 10-30 ohm (will not settle, jumps a lot) T3: 10ohm: T4: 9kohm / B1: 0 B2: 130k B3: 130Mohm B4: 50k ohm // K1: T1: 0, T2: 8k, T3: 5k, T4: 16k / B1: 134k, B2:134k B3: 50m B4: 50k" }

data e1_converter_near: ComponentInstanceIdentity = e1_component(local: "8-lead converter beside the 4R7 nearest U4 (the U10_P2 silkscreen beside it)")
data k1_converter_near: ComponentInstanceIdentity = k1_component(local: "8-lead converter below the 4R7 nearest U4 (the U10_P2 silkscreen beside it, U100 above), marked BDFP 528")
data k1_converter_far: ComponentInstanceIdentity = k1_component(local: "8-lead converter below the 4R7 farther from U4 (the U2_P2 silkscreen beside it)")
data k1_u100: ComponentInstanceIdentity = k1_component(local: "U100")

// A converter pin's terminal is named from its row, so a reading and the row join on one spelling.
fn pin_terminal_name(number: Nat, name: NonEmptyStr) -> NonEmptyStr {
  join(["pin ", to_string(number), " (", name as String, ")"], "") as NonEmptyStr
}
fn regulator_pins(row: ElectronicComponentRow) -> List<RegulatorPin> {
  match row.specification {
    SwitchingRegulatorSpec { regulator } => regulator.pins
    _ => []
  }
}
data converter_pin_terminals: List<NonEmptyStr> = map(regulator_pins(row: mp2333cgtl), p => pin_terminal_name(number: p.number, name: p.name))

// U100's leads as the operator counted them on 2026-10-23, the pin-1 dot's side to the right, each row
// from the bottom up; the inductor's pads as they lay that day, left and right, which of the two is
// nearer U4 unrecorded.
data u100_lead_terminals: List<NonEmptyStr> = ["dot-side lead, bottom", "dot-side lead, second from bottom", "dot-side lead, third from bottom", "dot-side lead, top", "far-side lead, bottom", "far-side lead, second from bottom", "far-side lead, third from bottom", "far-side lead, top"]
data pad_on_the_left_1023: NonEmptyStr = "pad on the operator's left with U100's dot side to the right (2026-10-23; which of the two pads by U4 unrecorded)"
data pad_on_the_right_1023: NonEmptyStr = "pad on the operator's right with U100's dot side to the right (2026-10-23; which of the two pads by U4 unrecorded)"

data t1_basis: NonEmptyStr = "the operator's T1, first along the inductor-side row from the inductor end: pin 4 (GND) by the row's pin order, the lead at the return on both carriers"
data t2_basis: NonEmptyStr = "the operator's T2, second along the inductor-side row from the inductor end: pin 3 (SW), the lead wired to the inductor's pad (converter_photo_1024)"
data t3_basis: NonEmptyStr = "the operator's T3, third along the inductor-side row from the inductor end: pin 2 (VIN) by the row's pin order once T1 is GND and T2 SW"
data t4_basis: NonEmptyStr = "the operator's T4, fourth along the inductor-side row from the inductor end: pin 1 (PG) by the same order"
data b1_basis: NonEmptyStr = "the operator's B1, first along the far row from the inductor end, across from T1: pin 5 (BST), across from pin 4 in the package drawing"
data b2_basis: NonEmptyStr = "the operator's B2, second along the far row from the inductor end: pin 6 (EN) by the same order"
data b3_basis: NonEmptyStr = "the operator's B3, third along the far row from the inductor end: pin 7 (SS) by the same order"
data b4_basis: NonEmptyStr = "the operator's B4, fourth along the far row from the inductor end: pin 8 (FB) by the same order"
data converter_said_1031_near: EvidenceRef = OperatorStatement { stated_on: "2026-10-31", verbatim: "In K1: GND: 0 SW: 8k VIN: 5k PG: 16k / BST:high?infinite?  EN: 130kSS:19M FB:50k" }
data k1_near_site_basis: NonEmptyStr = "read at the near-U4 converter (U10_P2) the operator was asked to read from a labelled copy of the K1 close-up (the red-boxed site of k1_two_4r7_photo_1031), the site taken from the order of the exchange rather than named by the operator; the pin is named by the label, drawn from the MP2333CGTL row's pin order, the same inference as the T/B readings'"
data k1_far_site_basis: NonEmptyStr = "the K1's photograph of this read (k1_converter_area_photo_1031) shows the U2_P2 silkscreen, which the wide photographs of the same evening (k1_u4_area_photo_1031, k1_two_4r7_photo_1031) place at the 4R7 farther from U4, and the operator, shown that photograph, confirmed it as the chip probed ('its this one - from my earlier picture', 2026-10-31); what stays inferred is the pin: named by the MP2333CGTL row on the strength of the package and circuit matching U10_P2's, this part's own marking unread"
data k1_u100_inductor_basis: NonEmptyStr = "the inductor beside the K1's U100, taken as the 4R7 nearest U4 as on the E1 (e1_u100_photo); the K1's site was not photographed that day"

fn converter_lead_read_e1(number: Nat, name: NonEmptyStr, basis: NonEmptyStr, display: ResistanceDisplay, stability: ReadingStability, certainty: StatementCertainty) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: e1_terminal(c: e1_converter_near, name: pin_terminal_name(number: number, name: name)), second: e1_ground_ref,
    record: ProbeRecord { first: PointInferred { basis: basis }, second: PointRecorded },
    conditions: e1_bench, polarity: RedOnFirst, range: AutoRanging, display: display, stability: stability, certainty: certainty,
    order: AfterIncidents { keys: [e1_bridge_incident.key, e1_inductor_short_incident.key] },
    evidence: [converter_said_1031, e1_converter_area_photo_1031],
  }
}
fn converter_lead_read_k1(number: Nat, name: NonEmptyStr, basis: NonEmptyStr, display: ResistanceDisplay) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_k1_a, first: terminal_ref(component: k1_converter_far, terminal: pin_terminal_name(number: number, name: name) as TerminalIdentity), second: k1_return,
    record: ProbeRecord { first: PointInferred { basis: join([basis as String, "; ", k1_far_site_basis as String], "") as NonEmptyStr }, second: PointRecorded },
    conditions: k1_bench, polarity: RedOnFirst, range: AutoRanging, display: display, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: BeforeIncidents { keys: [] },
    evidence: [converter_said_1031, k1_converter_area_photo_1031, k1_two_4r7_photo_1031],
  }
}
fn near_converter_lead_read_k1(number: Nat, name: NonEmptyStr, display: ResistanceDisplay, certainty: StatementCertainty) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_k1_a, first: terminal_ref(component: k1_converter_near, terminal: pin_terminal_name(number: number, name: name) as TerminalIdentity), second: k1_return,
    record: ProbeRecord { first: PointInferred { basis: k1_near_site_basis }, second: PointRecorded },
    conditions: k1_bench, polarity: RedOnFirst, range: AutoRanging, display: display, stability: StabilityUnrecorded, certainty: certainty,
    order: BeforeIncidents { keys: [] },
    evidence: [converter_said_1031_near, k1_two_4r7_photo_1031],
  }
}
fn u100_lead_read_e1(lead: NonEmptyStr, second: ElectricalTerminalRef, display: ResistanceDisplay, evidence: List<EvidenceRef>) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: e1_terminal(c: e1_u100, name: lead), second: second, record: both_points_recorded,
    conditions: e1_bench, polarity: RedOnFirst, range: AutoRanging, display: display, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key, e1_inductor_short_incident.key] },
    evidence: evidence,
  }
}
fn u100_lead_read_k1(lead: NonEmptyStr, second: ElectricalTerminalRef, record: ProbeRecord, display: ResistanceDisplay, evidence: List<EvidenceRef>) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_k1_a, first: terminal_ref(component: k1_u100, terminal: lead as TerminalIdentity), second: second, record: record,
    conditions: k1_bench, polarity: RedOnFirst, range: AutoRanging, display: display, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: BeforeIncidents { keys: [] },
    evidence: evidence,
  }
}
fn k1_pad_1023(name: NonEmptyStr) -> ElectricalTerminalRef {
  terminal_ref(component: k1_l_4r7_near, terminal: name as TerminalIdentity)
}

data e1_converter_lead_resistances: List<ResistanceObservation> = [
  converter_lead_read_e1(number: 4, name: "GND", basis: t1_basis, display: DisplayZeroWithoutBaseline { reported: "0 ohm" }, stability: StabilityUnrecorded, certainty: StatedPlainly),
  converter_lead_read_e1(number: 3, name: "SW", basis: t2_basis, display: DisplayValue { ohms: 20, approximate: true }, stability: KeptMoving, certainty: StatedHedged { verbatim: "T2: 10-30 ohm (will not settle, jumps a lot)" }),
  converter_lead_read_e1(number: 2, name: "VIN", basis: t3_basis, display: DisplayValue { ohms: 10, approximate: false }, stability: StabilityUnrecorded, certainty: StatedPlainly),
  converter_lead_read_e1(number: 1, name: "PG", basis: t4_basis, display: DisplayValue { ohms: 9000, approximate: false }, stability: StabilityUnrecorded, certainty: StatedPlainly),
  converter_lead_read_e1(number: 5, name: "BST", basis: b1_basis, display: DisplayZeroWithoutBaseline { reported: "0" }, stability: StabilityUnrecorded, certainty: StatedPlainly),
  converter_lead_read_e1(number: 6, name: "EN", basis: b2_basis, display: DisplayValue { ohms: 130000, approximate: false }, stability: StabilityUnrecorded, certainty: StatedPlainly),
  converter_lead_read_e1(number: 7, name: "SS", basis: b3_basis, display: DisplayValue { ohms: 130000000, approximate: false }, stability: StabilityUnrecorded, certainty: StatedPlainly),
  converter_lead_read_e1(number: 8, name: "FB", basis: b4_basis, display: DisplayValue { ohms: 50000, approximate: false }, stability: StabilityUnrecorded, certainty: StatedPlainly),
]
data k1_converter_lead_resistances: List<ResistanceObservation> = [
  converter_lead_read_k1(number: 4, name: "GND", basis: t1_basis, display: DisplayZeroWithoutBaseline { reported: "0" }),
  converter_lead_read_k1(number: 3, name: "SW", basis: t2_basis, display: DisplayValue { ohms: 8000, approximate: false }),
  converter_lead_read_k1(number: 2, name: "VIN", basis: t3_basis, display: DisplayValue { ohms: 5000, approximate: false }),
  converter_lead_read_k1(number: 1, name: "PG", basis: t4_basis, display: DisplayValue { ohms: 16000, approximate: false }),
  converter_lead_read_k1(number: 5, name: "BST", basis: b1_basis, display: DisplayValue { ohms: 134000, approximate: false }),
  converter_lead_read_k1(number: 6, name: "EN", basis: b2_basis, display: DisplayValue { ohms: 134000, approximate: false }),
  converter_lead_read_k1(number: 7, name: "SS", basis: b3_basis, display: DisplayValue { ohms: 50000000, approximate: false }),
  converter_lead_read_k1(number: 8, name: "FB", basis: b4_basis, display: DisplayValue { ohms: 50000, approximate: false }),
]
// The near-U4 converter on the K1 (U10_P2), eight leads to the return, later on 2026-10-31.
data k1_near_converter_lead_resistances: List<ResistanceObservation> = [
  near_converter_lead_read_k1(number: 4, name: "GND", display: DisplayZeroWithoutBaseline { reported: "0" }, certainty: StatedPlainly),
  near_converter_lead_read_k1(number: 3, name: "SW", display: DisplayValue { ohms: 8000, approximate: false }, certainty: StatedPlainly),
  near_converter_lead_read_k1(number: 2, name: "VIN", display: DisplayValue { ohms: 5000, approximate: false }, certainty: StatedPlainly),
  near_converter_lead_read_k1(number: 1, name: "PG", display: DisplayValue { ohms: 16000, approximate: false }, certainty: StatedPlainly),
  near_converter_lead_read_k1(number: 5, name: "BST", display: DisplayOverRange, certainty: StatedHedged { verbatim: "BST:high?infinite?" }),
  near_converter_lead_read_k1(number: 6, name: "EN", display: DisplayValue { ohms: 130000, approximate: false }, certainty: StatedPlainly),
  near_converter_lead_read_k1(number: 7, name: "SS", display: DisplayValue { ohms: 19000000, approximate: false }, certainty: StatedPlainly),
  near_converter_lead_read_k1(number: 8, name: "FB", display: DisplayValue { ohms: 50000, approximate: false }, certainty: StatedPlainly),
]
// U100 on the E1 (2026-10-23): the dot side's four leads at 1 ohm to the return and at the baseline to
// the right-hand pad; the far side's four kilohms to both. The far-side-to-pad figures are in the order
// said, taken as bottom-up like the statements before them.
data e1_u100_lead_resistances: List<ResistanceObservation> = [
  u100_lead_read_e1(lead: "dot-side lead, bottom", second: e1_ground_ref, display: DisplayValue { ohms: 1, approximate: false }, evidence: [converter_said_1023_e1]),
  u100_lead_read_e1(lead: "dot-side lead, second from bottom", second: e1_ground_ref, display: DisplayValue { ohms: 1, approximate: false }, evidence: [converter_said_1023_e1]),
  u100_lead_read_e1(lead: "dot-side lead, third from bottom", second: e1_ground_ref, display: DisplayValue { ohms: 1, approximate: false }, evidence: [converter_said_1023_e1]),
  u100_lead_read_e1(lead: "dot-side lead, top", second: e1_ground_ref, display: DisplayValue { ohms: 1, approximate: false }, evidence: [converter_said_1023_e1]),
  u100_lead_read_e1(lead: "far-side lead, bottom", second: e1_ground_ref, display: DisplayValue { ohms: 900, approximate: false }, evidence: [converter_said_1023_e1]),
  u100_lead_read_e1(lead: "far-side lead, second from bottom", second: e1_ground_ref, display: DisplayValue { ohms: 900, approximate: false }, evidence: [converter_said_1023_e1]),
  u100_lead_read_e1(lead: "far-side lead, third from bottom", second: e1_ground_ref, display: DisplayValue { ohms: 5500, approximate: false }, evidence: [converter_said_1023_e1]),
  u100_lead_read_e1(lead: "far-side lead, top", second: e1_ground_ref, display: DisplayValue { ohms: 5500, approximate: false }, evidence: [converter_said_1023_e1]),
  u100_lead_read_e1(lead: "far-side lead, bottom", second: e1_terminal(c: e1_l_4r7_near, name: pad_on_the_left_1023), display: DisplayValue { ohms: 1000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_e1(lead: "far-side lead, second from bottom", second: e1_terminal(c: e1_l_4r7_near, name: pad_on_the_left_1023), display: DisplayValue { ohms: 3000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_e1(lead: "far-side lead, third from bottom", second: e1_terminal(c: e1_l_4r7_near, name: pad_on_the_left_1023), display: DisplayValue { ohms: 8000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_e1(lead: "far-side lead, top", second: e1_terminal(c: e1_l_4r7_near, name: pad_on_the_left_1023), display: DisplayValue { ohms: 4000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_e1(lead: "dot-side lead, bottom", second: e1_terminal(c: e1_l_4r7_near, name: pad_on_the_right_1023), display: DisplayZeroWithoutBaseline { reported: "baseline" }, evidence: [converter_said_1023_pads]),
  u100_lead_read_e1(lead: "dot-side lead, second from bottom", second: e1_terminal(c: e1_l_4r7_near, name: pad_on_the_right_1023), display: DisplayZeroWithoutBaseline { reported: "baseline" }, evidence: [converter_said_1023_pads]),
  u100_lead_read_e1(lead: "dot-side lead, third from bottom", second: e1_terminal(c: e1_l_4r7_near, name: pad_on_the_right_1023), display: DisplayZeroWithoutBaseline { reported: "baseline" }, evidence: [converter_said_1023_pads]),
  u100_lead_read_e1(lead: "dot-side lead, top", second: e1_terminal(c: e1_l_4r7_near, name: pad_on_the_right_1023), display: DisplayZeroWithoutBaseline { reported: "baseline" }, evidence: [converter_said_1023_pads]),
]
// U100 on the K1 (2026-10-23, the dot side to the right-hand pad re-read 2026-10-24 answering a question
// about the first figure): both readings of each of those four pairs are kept, two links each.
data k1_u100_lead_resistances: List<ResistanceObservation> = [
  u100_lead_read_k1(lead: "dot-side lead, bottom", second: k1_return, record: both_points_recorded, display: DisplayZeroWithoutBaseline { reported: "ground" }, evidence: [converter_said_1023_k1]),
  u100_lead_read_k1(lead: "dot-side lead, second from bottom", second: k1_return, record: both_points_recorded, display: DisplayZeroWithoutBaseline { reported: "ground" }, evidence: [converter_said_1023_k1]),
  u100_lead_read_k1(lead: "dot-side lead, third from bottom", second: k1_return, record: both_points_recorded, display: DisplayZeroWithoutBaseline { reported: "ground" }, evidence: [converter_said_1023_k1]),
  u100_lead_read_k1(lead: "dot-side lead, top", second: k1_return, record: both_points_recorded, display: DisplayZeroWithoutBaseline { reported: "ground" }, evidence: [converter_said_1023_k1]),
  u100_lead_read_k1(lead: "far-side lead, bottom", second: k1_return, record: both_points_recorded, display: DisplayValue { ohms: 6000, approximate: false }, evidence: [converter_said_1023_k1]),
  u100_lead_read_k1(lead: "far-side lead, second from bottom", second: k1_return, record: both_points_recorded, display: DisplayValue { ohms: 6000, approximate: false }, evidence: [converter_said_1023_k1]),
  u100_lead_read_k1(lead: "far-side lead, third from bottom", second: k1_return, record: both_points_recorded, display: DisplayValue { ohms: 10000, approximate: false }, evidence: [converter_said_1023_k1]),
  u100_lead_read_k1(lead: "far-side lead, top", second: k1_return, record: both_points_recorded, display: DisplayValue { ohms: 10000, approximate: false }, evidence: [converter_said_1023_k1]),
  u100_lead_read_k1(lead: "far-side lead, bottom", second: k1_pad_1023(name: pad_on_the_left_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 4000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_k1(lead: "far-side lead, second from bottom", second: k1_pad_1023(name: pad_on_the_left_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 4000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_k1(lead: "far-side lead, third from bottom", second: k1_pad_1023(name: pad_on_the_left_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 12000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_k1(lead: "far-side lead, top", second: k1_pad_1023(name: pad_on_the_left_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 12000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_k1(lead: "dot-side lead, bottom", second: k1_pad_1023(name: pad_on_the_right_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 8000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_k1(lead: "dot-side lead, second from bottom", second: k1_pad_1023(name: pad_on_the_right_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 8000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_k1(lead: "dot-side lead, third from bottom", second: k1_pad_1023(name: pad_on_the_right_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 8000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_k1(lead: "dot-side lead, top", second: k1_pad_1023(name: pad_on_the_right_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 8000, approximate: false }, evidence: [converter_said_1023_pads]),
  u100_lead_read_k1(lead: "dot-side lead, bottom", second: k1_pad_1023(name: pad_on_the_right_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 4000, approximate: false }, evidence: [converter_said_1024]),
  u100_lead_read_k1(lead: "dot-side lead, second from bottom", second: k1_pad_1023(name: pad_on_the_right_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 12000, approximate: false }, evidence: [converter_said_1024]),
  u100_lead_read_k1(lead: "dot-side lead, third from bottom", second: k1_pad_1023(name: pad_on_the_right_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 12000, approximate: false }, evidence: [converter_said_1024]),
  u100_lead_read_k1(lead: "dot-side lead, top", second: k1_pad_1023(name: pad_on_the_right_1023), record: second_point_inferred(basis: k1_u100_inductor_basis), display: DisplayValue { ohms: 12000, approximate: false }, evidence: [converter_said_1024]),
]
// The K1's inductor beside U100, both pads to the return with the Fluke auto-ranging (2026-10-24):
// 8.3 kohm each, the figure the 2k-range '~4k' reading above was hedged toward; its identity as the
// 4R7 nearest U4 is the same inference as its U100 readings'.
data k1_l_4r7_near_pad_resistances: List<ResistanceObservation> = [
  ResistanceObservation {
    asset: p4261_k1_a, first: k1_pad_1023(name: inductor_pad_near_u4), second: k1_return, record: ProbeRecord { first: PointInferred { basis: k1_u100_inductor_basis }, second: PointRecorded },
    conditions: k1_bench, polarity: RedOnFirst, range: AutoRanging, display: DisplayValue { ohms: 8300, approximate: false }, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: BeforeIncidents { keys: [] }, evidence: [converter_said_1024],
  },
  ResistanceObservation {
    asset: p4261_k1_a, first: k1_pad_1023(name: inductor_pad_far_u4), second: k1_return, record: ProbeRecord { first: PointInferred { basis: k1_u100_inductor_basis }, second: PointRecorded },
    conditions: k1_bench, polarity: RedOnFirst, range: AutoRanging, display: DisplayValue { ohms: 8300, approximate: false }, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: BeforeIncidents { keys: [] }, evidence: [converter_said_1024],
  },
]

// THE CONVERTER IS THE LEADING CANDIDATE FOR THE E1'S RAIL SHORT, NOT YET THE VERDICT. Read against the
// K1 lead by lead, three of the E1's leads sit near the return where the K1's read kilohms: SW, which
// the shorted rail explains by itself; VIN, 5 kohm there and 10 ohm here; and BST, 134 kohm there and a
// reported zero here. VIN and BST are nodes, not isolated pins: the input capacitors and whatever feeds
// VIN sit on the one, the bootstrap capacitor and the device's internal charging path on the other, so
// a resistance reading names the node and not yet the part on it. What separates the device from the
// parts around it is a read with one of them gone.
data p4261_near_4r7_converter_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "the converter beside the 4R7 nearest U4, MPS's MP2333CGTL (marked BDFP 528), is the leading candidate for the part that failed in the 2026-10-21 incident: its SW, VIN and BST leads read near the return where the K1's same converter reads 8 kohm, 5 kohm and over range. The capacitors on those nodes (input and bootstrap) and the loads on the rail are not excluded by a resistance reading, and U100 is not on the switch node",
  sources: [
    "E1 against the K1's same converter (U10_P2), lead by lead, 2026-10-31 (e1_converter_lead_resistances, k1_near_converter_lead_resistances): GND 0 / 0; SW 10-30 ohm unsettled / 8 kohm; VIN 10 ohm / 5 kohm; PG 9 kohm / 16 kohm; BST 0 / over range; EN 130 kohm / 130 kohm; SS over range / 19 Mohm; FB 50 kohm / 50 kohm. PG's difference is the rail's own, seen through a pull-up. The K1's farther converter (U2_P2, k1_converter_lead_resistances, read first that evening) agrees lead for lead except BST at 134 kohm and SS at 50 Mohm, so the BST node's DC path to the return differs by instance or by circuit, and the E1's 0 at BST is read against U10_P2's over range",
    "VIN and BST are nodes, not isolated pins: VIN carries the input capacitors and whatever feeds it, BST the bootstrap capacitor and the device's internal charging path (the datasheet's block diagram), so a low reading at either names the node and not yet the part on it",
    "the SW lead at 10-30 ohm, unsettled, against the inductor's pads at 'ground' on the 2 kohm range on 2026-10-21 (e1_after_short_resistances), a range whose last digit is 1 ohm: not reconciled. Probe contact on a 0.5 mm lead, the lead's attribution, the site or the copper between lead and pad; the SW-to-pad read decides",
    "the datasheet's circuit joins BST to SW through a 1 uF capacitor in series with 20 ohm (extdeps.electronic_component.mps_mp2333c): a shorted bootstrap capacitor would read about 20 ohm from BST to SW if the board fits that resistor, and the baseline if it does not or if the short is inside the device",
    "U100's eight leads (e1_u100_lead_resistances, k1_u100_lead_resistances): the dot side at the return on both carriers, the far side kilohms, and on the K1 no lead at the baseline to either pad of the inductor beside it",
    "the device's 4.2 V to 18 V input range bounds the path feeding VIN (pin 2), which is unread; it says nothing about J20's voltage (p4261_j20_main_input_hypothesis)",
    "both sites cleaned and inspected under the Andonstar 2026-10-31 with nothing broken, cracked or singed (e1_inductor_short_incident); the carriers differ in population around the inductor (two 0603 parts under the E1's, four empty pads under the K1's; two large ceramics against one), so the K1 is a reference for the converter and not for every part on the rail",
  ],
  decided_by: "On the K1 at the near-U4 site the wide photographs of 2026-10-31 fix (U10_P2, below U100; its eight leads to the return are read, GND at 0): SW (pin 3) to the inductor's terminal nearer the device against a shorted-probe baseline in ohms, fixing the physical pin map on the board the short cannot confuse. Then on the E1, unpowered: SW to the inductor's terminal nearer the device, reconciling the 10-30 ohm with the pads' 2026-10-21 'ground'; the OUT pad to the return once, since the cleaning was an intervention; BST to SW and VIN to SW. Then one separation, chosen on those reads and not because replacements are in hand: the inductor lifted (its terminals reachable with the iron), SW and VIN re-read to the return with the load gone, a low SW naming the converter's side and a kilohm SW with the OUT pad still low naming the load; or the device lifted with low-melt alloy and SW, VIN and BST read to the return without it. The reading after the removal, not the removal, establishes what changed; a replacement is fitted only after the input and output nodes read clear and the path feeding VIN is read. Which loads the rail supplies waits on that.",
}

data e1_vector_unrecorded: List<SwitchPoleState> = [e1_pole(package: e1_s2, pole: 1, position: PolePositionUnrecorded), e1_pole(package: e1_s2, pole: 2, position: PolePositionUnrecorded), e1_pole(package: e1_s1, pole: 1, position: PolePositionUnrecorded), e1_pole(package: e1_s1, pole: 2, position: PolePositionUnrecorded)]
data e1_vector_p0: List<SwitchPoleState> = [e1_pole(package: e1_s2, pole: 1, position: AwayFromOnLegend), e1_pole(package: e1_s2, pole: 2, position: TowardOnLegend), e1_pole(package: e1_s1, pole: 1, position: PolePositionUnrecorded), e1_pole(package: e1_s1, pole: 2, position: PolePositionUnrecorded)]
data e1_vector_p1: List<SwitchPoleState> = [e1_pole(package: e1_s2, pole: 1, position: TowardOnLegend), e1_pole(package: e1_s2, pole: 2, position: AwayFromOnLegend), e1_pole(package: e1_s1, pole: 1, position: PolePositionUnrecorded), e1_pole(package: e1_s1, pole: 2, position: PolePositionUnrecorded)]
data e1_vector_p3: List<SwitchPoleState> = [e1_pole(package: e1_s2, pole: 1, position: TowardOnLegend), e1_pole(package: e1_s2, pole: 2, position: AwayFromOnLegend), e1_pole(package: e1_s1, pole: 1, position: PolePositionUnrecorded), e1_pole(package: e1_s1, pole: 2, position: TowardOnLegend)]

data e1_j30_bridge: HeaderBridge = HeaderBridge { header: e1_j30, first: e1_terminal(c: e1_j30, name: "A"), second: e1_terminal(c: e1_j30, name: "B"), coupling: DirectBridge, hold: HeldWhileObserved }
data e1_j68_bridge: HeaderBridge = HeaderBridge { header: e1_j68, first: e1_terminal(c: e1_j68, name: "R1"), second: e1_terminal(c: e1_j68, name: "R2"), coupling: DirectBridge, hold: HeldWhileObserved }

fn e1_seen(designator: NonEmptyStr, colour: IndicatorColour, state: IndicatorState) -> IndicatorObservation {
  IndicatorObservation { indicator: DesignatorRead { designator: designator }, colour: colour, state: state, basis: SeenInPhotograph { evidence: e1_settled_photo } }
}

data e1_top_group_basis: NonEmptyStr = "the top group's four indicators are read against the printed labels taken top to bottom as DS10, DS11, DS13, DS12; the photograph does not settle which label belongs to which lamp"

fn e1_top_group(designator: NonEmptyStr, state: IndicatorState) -> IndicatorObservation {
  IndicatorObservation { indicator: DesignatorCandidate { designator: designator, basis: e1_top_group_basis }, colour: GreenIndicator, state: state, basis: SeenInPhotograph { evidence: e1_settled_photo } }
}

data e1_settled_indicators: List<IndicatorObservation> = [
  e1_top_group(designator: "DS10", state: IndicatorLit),
  e1_top_group(designator: "DS13", state: IndicatorLit),
  e1_top_group(designator: "DS12", state: IndicatorLit),
  e1_top_group(designator: "DS11", state: IndicatorDark),
  IndicatorObservation { indicator: DesignatorRead { designator: "DS1_2" }, colour: GreenIndicator, state: IndicatorBlinking, basis: TimedInVideo { evidence: e1_blink_videos, on_ms: 1010, off_ms: 1480, cycles: 5 } },
  IndicatorObservation { indicator: DesignatorRead { designator: "DS6" }, colour: GreenIndicator, state: IndicatorBlinking, basis: TimedInVideo { evidence: e1_blink_videos, on_ms: 1360, off_ms: 1320, cycles: 5 } },
  IndicatorObservation { indicator: DesignatorRead { designator: "DS5" }, colour: RedOrAmberIndicator, state: IndicatorLit, basis: SeenInVideo { evidence: e1_blink_videos, seconds: 15 } },
  e1_seen(designator: "DS3", colour: GreenIndicator, state: IndicatorDark),
  e1_seen(designator: "DS4", colour: GreenIndicator, state: IndicatorDark),
]

fn e1_phase_volt(c: ComponentInstanceIdentity, point: NonEmptyStr, millivolts: Nat, said: EvidenceRef) -> PhaseNodeVoltage {
  PhaseNodeVoltage { at: e1_terminal(c: c, name: point), reference: e1_ground_ref, value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly, evidence: said }
}

fn e1_j68_disputed_volt(point: NonEmptyStr, millivolts: Nat) -> PhaseNodeVoltage {
  PhaseNodeVoltage { at: e1_terminal(c: e1_j68, name: point), reference: e1_ground_ref, value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedHedged { verbatim: e1_j68_orientation_dispute }, evidence: e1_j68_volts_said }
}
data e1_settled_volts: List<PhaseNodeVoltage> = concat(
  map(e1_j68_high_points, n => e1_j68_disputed_volt(point: n, millivolts: 1800)),
  map(e1_j68_low_points, n => e1_j68_disputed_volt(point: n, millivolts: 0)))

// J30's two readings were at points the operator named their own way ('pin 1' by their count, and the
// point that read 3.1 V), each one of J30's three physical positions A, B, C in the marked photograph,
// which one unrecorded: kept as aliased readings, never as terminals of their own.
fn e1_j30_aliased_volt(label: NonEmptyStr, millivolts: Nat) -> PhaseAliasedVoltage {
  PhaseAliasedVoltage { label: label, candidates: map(e1_j30_points, n => e1_terminal(c: e1_j30, name: n)), reference: e1_ground_ref, value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly, evidence: e1_j30_volts_said }
}

data e1_j30_aliased: List<PhaseAliasedVoltage> = [
  e1_j30_aliased_volt(label: "pin 1 (the operator's own count)", millivolts: 0),
  e1_j30_aliased_volt(label: "point read at 3.1 V", millivolts: 3100),
]

fn e1_phase_in(conditions: BenchConditions, key: NonEmptyStr, supply: SupplyReading, vector: List<SwitchPoleState>, held: HeaderBridge?, recovering_from: HeaderBridge?, settling: PhaseSettling, indicators: IndicatorPattern, volts: List<PhaseNodeVoltage>, aliased: List<PhaseAliasedVoltage>, evidence: List<EvidenceRef>) -> CarrierPhaseObservation {
  CarrierPhaseObservation {
    key: key, asset: p4261_e1_b, conditions: conditions, setting: e1_phase_setting, supply: supply, switch_vector: vector,
    held: held, recovering_from: recovering_from, settling: settling, indicators: indicators, node_voltages: volts, aliased_voltages: aliased, evidence: evidence,
  }
}

fn e1_phase(key: NonEmptyStr, supply: SupplyReading, vector: List<SwitchPoleState>, held: HeaderBridge?, recovering_from: HeaderBridge?, settling: PhaseSettling, indicators: IndicatorPattern, volts: List<PhaseNodeVoltage>, evidence: List<EvidenceRef>) -> CarrierPhaseObservation {
  e1_phase_in(conditions: e1_live_bench, key: key, supply: supply, vector: vector, held: held, recovering_from: recovering_from, settling: settling, indicators: indicators, volts: volts, aliased: [], evidence: evidence)
}

// ALL FOUR POLES TOWARD ON, THE MODULE ABSENT (2026-10-20, 48 V). The operator left every pole toward
// the ON legend and read, against J20's black lead: the source 48 V, 0.097 A, 4.653 W with CV lit;
// Q21_P5's small output legs about 1.66 V (which of the six was touched is unrecorded, so each stands
// for a touch, as the 1 V readings do); the via on Q301's lead b node 4.37 V; Q300's lead b 0 V; the
// resistor's far end 48 V; and, re-read counting from the pin 1 marker, pin 7 0 V, pin 8 1.8 V and P6
// 0 V. The first report's 'pin 7 is 1.8v i believe' is superseded by that re-read and not recorded at
// pin 7. Which indicators were lit in this state was not described, so the phase is unclassified; the
// protected bus reads held off from the legs, and the enable chain reads as it did before the switches
// were found.
data e1_vector_all_on: List<SwitchPoleState> = [e1_pole(package: e1_s2, pole: 1, position: TowardOnLegend), e1_pole(package: e1_s2, pole: 2, position: TowardOnLegend), e1_pole(package: e1_s1, pole: 1, position: TowardOnLegend), e1_pole(package: e1_s1, pole: 2, position: TowardOnLegend)]
data e1_all_on_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "i just keep all poles at on position" }
data e1_switch_legend_photos: List<EvidenceRef> = [
  e1_photo(taken_on: "2026-10-20", locator: "bench-session upload 9fe8a23b, S2 straight down with its legend legible, both sliders toward ON (not on Drive)"),
  e1_photo(taken_on: "2026-10-20", locator: "bench-session upload 60ce8352, S1 straight down with its legend legible, both sliders toward ON (not on Drive)"),
]
data e1_sw_a_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "SW-A1 48v, .097A, 4.653w - it shows CV, no CC / SW-A2 : 1.66v / SW-A3: pin 7 is 1.8v i believe, pin 6 is 0v / SW-A4: 4.37v / SW-A5: 0v / SW-A6: 48v (input voltage)" }
data e1_sw_a_reread_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "SW-A7 - pin 7 is 0v, SW-A8: pin 8 is 1.8v, p6 is also 0v" }
data e1_all_on_volts: List<PhaseNodeVoltage> = concat(
  map(e1_small_leg_names, n => e1_phase_volt(c: e1_q21, point: n, millivolts: 1660, said: e1_sw_a_said)),
  [
    PhaseNodeVoltage { at: e1_q301_b_via, reference: e1_ground_ref, value: ReadAbout { value: millivolt(count: 4370) }, certainty: StatedPlainly, evidence: e1_sw_a_said },
    PhaseNodeVoltage { at: e1_q300_lead_b, reference: e1_ground_ref, value: ReadAbout { value: millivolt(count: 0) }, certainty: StatedPlainly, evidence: e1_sw_a_said },
    PhaseNodeVoltage { at: e1_q301_resistor_far, reference: e1_ground_ref, value: ReadAbout { value: millivolt(count: 48000) }, certainty: StatedPlainly, evidence: e1_sw_a_said },
    e1_phase_volt(c: e1_u1_p5, point: "pin 7", millivolts: 0, said: e1_sw_a_reread_said),
    e1_phase_volt(c: e1_u1_p5, point: "pin 8", millivolts: 1800, said: e1_sw_a_reread_said),
    e1_phase_volt(c: e1_back_cluster, point: "P6", millivolts: 0, said: e1_sw_a_reread_said),
  ])

// THE MODULE INSTALLED, AND A J30 TAP (2026-10-20). The operator seated the GH200 module and repeated
// the steps: 'the module doesn't change any of the supply current numbers', so P0 to P3 are recorded
// again with the module installed, at the same draws; how it was seated and what cooled it are not
// recorded, and the private plan's module-presence test is not this, since it waits on the protected
// bus read in each phase. A tap on J30's A and B 'just repeats the power phases': back in the settled
// state, Q21_P5's small output legs read about 1.7 V against J20's black lead, with the module's state
// at that reading unrecorded; the protected bus reads held off from it.
// The module seated for the repeated steps is gh200-dv5-b (label 699-2G530-0215-DV9 D1,
// product.superchip_assembly_qualification gh200_dv5_second_unit): 'its bene this one the whole time,
// both are on hand' (2026-10-20).
data e1_module_installed_bench: BenchConditions = BenchConditions { power: Energized, module: ModuleInstalled { asset: gh200_dv5_b } }
data e1_module_unrecorded_bench: BenchConditions = BenchConditions { power: Energized, module: ModuleUnrecorded }
data e1_module_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "I'm a bit confused at what you want me to do at this point.  I put the module on the board and repeated a lot of this - nothing really c hanged" }
data e1_module_draw_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "public: the module doesn't change any of the supply current numbers" }
data e1_module_identity_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "its bene this one the whole time, both are on hand" }
data e1_tap_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "SW-A2 - ~1.7V / SW-A5: this is hard to get - could we skip it? or is there any pin on the top of the board i could use for this? and what do you mean by changed?" }
data e1_tap_repeats_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "J30's tap - doesn't fundamentally change anything in terms of voltage, it just repeats the power phases we discussed" }
data e1_j30_tap: HeaderBridge = HeaderBridge { header: e1_j30, first: e1_terminal(c: e1_j30, name: "A"), second: e1_terminal(c: e1_j30, name: "B"), coupling: DirectBridge, hold: MomentaryTouch }
data e1_module_unchanged: IndicatorPattern = IndicatorsDescribed { description: "as with the module absent ('nothing really changed'); which designators, unread", presence: SomeLit, evidence: e1_module_said }

// WHICH WAY EACH POLE CLOSES (2026-10-20, unpowered). Across each pole's two terminals: 'basically 0
// ohms when the switches are ON, when they're off, even 2M won't measure them'. No shorted-probe
// baseline is named, so the zero is a reported zero; it still says the pole conducts toward the ON
// legend and is open away from it, on every pole.
data e1_closure_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-20", verbatim: "regarding the continuity - they are basically 0 ohms when the switches are ON, when they're off, even 2M won't measure them" }

// Each pole has two solder terminals, a and b, named by the pole; which physical pad is which is the
// package's, and a closure reading is across the two.
data e1_pole_terminal_names: List<NonEmptyStr> = ["pole 1 terminal a", "pole 1 terminal b", "pole 2 terminal a", "pole 2 terminal b"]

fn e1_pole_terminal_a(package: ComponentInstanceIdentity, pole: Nat) -> ElectricalTerminalRef {
  if pole == 1 { e1_terminal(c: package, name: "pole 1 terminal a") } else { e1_terminal(c: package, name: "pole 2 terminal a") }
}

fn e1_pole_terminal_b(package: ComponentInstanceIdentity, pole: Nat) -> ElectricalTerminalRef {
  if pole == 1 { e1_terminal(c: package, name: "pole 1 terminal b") } else { e1_terminal(c: package, name: "pole 2 terminal b") }
}

fn e1_closure(package: ComponentInstanceIdentity, pole: Nat, position: SwitchPolePosition, display: ResistanceDisplay, range: MeterRange) -> SwitchPoleClosure {
  SwitchPoleClosure { pole: e1_pole(package: package, pole: pole, position: position), first: e1_pole_terminal_a(package: package, pole: pole), second: e1_pole_terminal_b(package: package, pole: pole), display: display, range: range, evidence: e1_closure_said }
}

data e1_pole_closures: List<SwitchPoleClosure> = flat_map([e1_s1, e1_s2], p => flat_map([1, 2], n => [
  e1_closure(package: p, pole: n, position: TowardOnLegend, display: DisplayZeroWithoutBaseline { reported: "basically 0 ohms" }, range: RangeUnrecorded),
  e1_closure(package: p, pole: n, position: AwayFromOnLegend, display: DisplayOverRange, range: RangeFullScale { ohms: 2000000 }),
]))

fn e1_module_phase(key: NonEmptyStr, count: Nat, vector: List<SwitchPoleState>, settling: PhaseSettling, indicators: IndicatorPattern) -> CarrierPhaseObservation {
  e1_phase_in(conditions: e1_module_installed_bench, key: key, supply: e1_read_ma(count: count), vector: vector, held: Absent, recovering_from: Absent, settling: settling, indicators: indicators, volts: [], aliased: [], evidence: [e1_module_said, e1_module_draw_said, e1_module_identity_said])
}

data e1_module_phases: List<CarrierPhaseObservation> = [
  e1_module_phase(key: "p0-bias-module-installed", count: 13, vector: e1_vector_p0, settling: SettledSteady, indicators: NoIndicatorSeen { evidence: e1_module_said }),
  e1_module_phase(key: "p1-s2-domain-module-installed", count: 38, vector: e1_vector_p1, settling: SettledSteady, indicators: NoIndicatorSeen { evidence: e1_module_said }),
  e1_module_phase(key: "p2-s1-sequence-module-installed", count: 80, vector: e1_vector_p3, settling: TransientPassing, indicators: e1_module_unchanged),
  e1_module_phase(key: "p3-settled-module-installed", count: 94, vector: e1_vector_p3, settling: SettledSteady, indicators: e1_module_unchanged),
]

fn e1_read_ma(count: Nat) -> SupplyReading {
  SupplyReading { voltage: Absent, current: CurrentRead { value: milliampere(count: count) }, mode: SourceModeUnrecorded }
}

data e1_j30_recovery_draw: SupplyReading = SupplyReading { voltage: Absent, current: CurrentAmbiguous { verbatim: ".94A", candidates: [milliampere(count: 94), milliampere(count: 940)] }, mode: SourceModeUnrecorded }
data e1_j68_held_draw: SupplyReading = SupplyReading { voltage: Absent, current: CurrentRead { value: milliampere(count: 70) }, mode: SourceModeUnrecorded }
data e1_draw_unrecorded: SupplyReading = SupplyReading { voltage: Absent, current: CurrentUnrecorded, mode: SourceModeUnrecorded }

data e1_phases_module_absent: List<CarrierPhaseObservation> = [
  e1_phase(key: "first-lit-state", supply: SupplyReading { voltage: Present { value: volt(count: 54) }, current: CurrentRead { value: milliampere(count: 85) }, mode: ConstantVoltageShown }, vector: e1_vector_unrecorded, held: Absent, recovering_from: Absent, settling: SettlingUnrecorded,
    indicators: IndicatorsDescribed { description: "green indicators beside the heatsinked control region and red-or-amber indicators at the board edge lit; which designators is unread from these photographs", presence: SomeLit, evidence: e1_switch_event_photo },
    volts: [], evidence: [e1_switch_event_said, e1_switch_event_photo, e1_switch_photo]),
  e1_phase(key: "p0-bias", supply: e1_read_ma(count: 13), vector: e1_vector_p0, held: Absent, recovering_from: Absent, settling: SettledSteady, indicators: NoIndicatorSeen { evidence: e1_s2_said }, volts: [], evidence: [e1_s2_said, e1_ceiling_said, e1_j68_current_said]),
  e1_phase(key: "p1-s2-domain", supply: e1_read_ma(count: 38), vector: e1_vector_p1, held: Absent, recovering_from: Absent, settling: SettledSteady, indicators: NoIndicatorSeen { evidence: e1_s2_said }, volts: [], evidence: [e1_s2_said, e1_s1_inert_said]),
  e1_phase(key: "p2-s1-sequence", supply: e1_read_ma(count: 80), vector: e1_vector_p3, held: Absent, recovering_from: Absent, settling: TransientPassing, indicators: IndicatorsDescribed { description: "all lit", presence: SomeLit, evidence: e1_s1_sequence_said }, volts: [], evidence: [e1_s1_sequence_said]),
  e1_phase_in(conditions: e1_live_bench, key: "p3-settled", supply: e1_read_ma(count: 94), vector: e1_vector_p3, held: Absent, recovering_from: Absent, settling: SettledSteady, indicators: IndicatorsObserved { items: e1_settled_indicators }, volts: e1_settled_volts, aliased: e1_j30_aliased, evidence: [e1_s1_sequence_said, e1_settled_photo, e1_j30_volts_said, e1_j68_volts_said]),
  e1_phase(key: "j30-held", supply: e1_draw_unrecorded, vector: e1_vector_p3, held: Present { value: e1_j30_bridge }, recovering_from: Absent, settling: SettlingUnrecorded,
    indicators: IndicatorsObserved { items: [
      IndicatorObservation { indicator: DesignatorRead { designator: "DS3" }, colour: GreenIndicator, state: IndicatorLit, basis: OperatorReported { evidence: e1_blinkers_said } },
      IndicatorObservation { indicator: DesignatorRead { designator: "DS4" }, colour: GreenIndicator, state: IndicatorLit, basis: OperatorReported { evidence: e1_blinkers_said } },
    ] }, volts: [], evidence: [e1_j30_said, e1_bridges_said, e1_blinkers_said]),
  e1_phase(key: "j30-release", supply: e1_j30_recovery_draw, vector: e1_vector_p3, held: Absent, recovering_from: Present { value: e1_j30_bridge }, settling: TransientPassing, indicators: IndicatorsDescribed { description: "'the soft reset', the same sequence replayed, returning slowly to the settled state", presence: SomeLit, evidence: e1_bridges_said }, volts: [], evidence: [e1_j30_said, e1_bridges_said]),
  e1_phase(key: "j68-held", supply: e1_j68_held_draw, vector: e1_vector_p3, held: Present { value: e1_j68_bridge }, recovering_from: Absent, settling: SettlingUnrecorded, indicators: NoIndicatorSeen { evidence: e1_j68_held_said }, volts: [], evidence: [e1_j68_said, e1_bridges_said, e1_j68_held_said, e1_j68_held_photo, e1_j68_current_said]),
  e1_phase(key: "p3-all-poles-on", supply: SupplyReading { voltage: Present { value: volt(count: 48) }, current: CurrentRead { value: milliampere(count: 97) }, mode: ConstantVoltageShown }, vector: e1_vector_all_on, held: Absent, recovering_from: Absent, settling: SettledSteady,
    indicators: IndicatorsUnobserved, volts: e1_all_on_volts, evidence: concat([e1_all_on_said, e1_sw_a_said, e1_sw_a_reread_said], e1_switch_legend_photos)),
  e1_phase_in(conditions: e1_module_unrecorded_bench, key: "j68-labelled-reread", supply: e1_draw_unrecorded, vector: e1_vector_unrecorded, held: Absent, recovering_from: Absent, settling: SettlingUnrecorded,
    indicators: IndicatorsUnobserved, volts: e1_j68_volts_under_labels, aliased: [], evidence: [e1_j68_powered_said, e1_j68_labelled_photo]),
  e1_phase_in(conditions: e1_module_unrecorded_bench, key: "inductors-settled-read", supply: e1_draw_unrecorded, vector: e1_vector_unrecorded, held: Absent, recovering_from: Absent, settling: SettledSteady,
    indicators: IndicatorsUnobserved, volts: e1_inductor_volts, aliased: [], evidence: [e1_inductor_said]),
  e1_phase_in(conditions: e1_module_unrecorded_bench, key: "p3-after-j30-tap", supply: e1_draw_unrecorded, vector: e1_vector_p3, held: Absent, recovering_from: Absent, settling: SettledSteady,
    indicators: IndicatorsDescribed { description: "the settled state's, by the operator's statement that the tap only repeats the phases; which designators, unread", presence: SomeLit, evidence: e1_tap_repeats_said },
    volts: map(e1_small_leg_names, n => e1_phase_volt(c: e1_q21, point: n, millivolts: 1700, said: e1_tap_said)), aliased: [], evidence: [e1_tap_said, e1_tap_repeats_said]),
  e1_phase(key: "j68-release", supply: e1_draw_unrecorded, vector: e1_vector_p3, held: Absent, recovering_from: Present { value: e1_j68_bridge }, settling: TransientPassing, indicators: IndicatorsDescribed { description: "'starts boot sequence over': the sequence replayed from the start", presence: SomeLit, evidence: e1_j68_held_said }, volts: [], evidence: [e1_j68_said, e1_j68_held_said]),
]

data e1_phases: List<CarrierPhaseObservation> = concat(e1_phases_module_absent, e1_module_phases)

fn e1_transition(key: NonEmptyStr, from_phase: NonEmptyStr, stimulus: PhaseStimulus, to_phase: NonEmptyStr, supply_trace: List<SupplyReading>, indicator_trace: List<IndicatorPattern>, audible: AudibleEvent, evidence: List<EvidenceRef>) -> CarrierTransitionObservation {
  CarrierTransitionObservation { key: key, asset: p4261_e1_b, from_phase: from_phase, stimulus: stimulus, to_phase: to_phase, supply_trace: supply_trace, indicator_trace: indicator_trace, audible: audible, evidence: evidence }
}

data e1_transitions: List<CarrierTransitionObservation> = [
  e1_transition(key: "s2-set", from_phase: "p0-bias", stimulus: SwitchPolesMoved { poles: [e1_pole(package: e1_s2, pole: 1, position: TowardOnLegend), e1_pole(package: e1_s2, pole: 2, position: AwayFromOnLegend)], timing: MoveTimingUnrecorded }, to_phase: "p1-s2-domain",
    supply_trace: [e1_read_ma(count: 13), e1_read_ma(count: 38)], indicator_trace: [NoIndicatorSeen { evidence: e1_s2_said }], audible: NoSoundReported, evidence: [e1_s2_said]),
  e1_transition(key: "s1-toggled-in-p1", from_phase: "p1-s2-domain", stimulus: SwitchPolesMoved { poles: [e1_pole(package: e1_s1, pole: 1, position: PolePositionUnrecorded), e1_pole(package: e1_s1, pole: 2, position: PolePositionUnrecorded)], timing: MoveTimingUnrecorded }, to_phase: "p1-s2-domain",
    supply_trace: [], indicator_trace: [], audible: NoSoundReported, evidence: [e1_s1_inert_said]),
  e1_transition(key: "s1-pole-2-on", from_phase: "p1-s2-domain", stimulus: SwitchPolesMoved { poles: [e1_pole(package: e1_s1, pole: 2, position: TowardOnLegend)], timing: MovedEnergized }, to_phase: "p2-s1-sequence",
    supply_trace: [e1_read_ma(count: 80)], indicator_trace: [IndicatorsDescribed { description: "all lit", presence: SomeLit, evidence: e1_s1_sequence_said }], audible: NoSoundReported, evidence: [e1_s1_sequence_said, e1_s1_after_said]),
  e1_transition(key: "sequence-settles", from_phase: "p2-s1-sequence", stimulus: SettlingDelay, to_phase: "p3-settled",
    supply_trace: [e1_read_ma(count: 94)], indicator_trace: [IndicatorsDescribed { description: "a few lit, one blinking near U1_TFP", presence: SomeLit, evidence: e1_s1_sequence_said }], audible: NoSoundReported, evidence: [e1_s1_sequence_said]),
  e1_transition(key: "s1-pole-1-off-in-p3", from_phase: "p3-settled", stimulus: SwitchPolesMoved { poles: [e1_pole(package: e1_s1, pole: 1, position: AwayFromOnLegend)], timing: MovedEnergized }, to_phase: "p3-settled",
    supply_trace: [], indicator_trace: [], audible: NoSoundReported, evidence: [e1_s1_after_said, e1_bridges_said]),
  e1_transition(key: "s2-returned", from_phase: "p3-settled", stimulus: SwitchPolesMoved { poles: [e1_pole(package: e1_s2, pole: 1, position: AwayFromOnLegend), e1_pole(package: e1_s2, pole: 2, position: TowardOnLegend)], timing: MoveTimingUnrecorded }, to_phase: "p0-bias",
    supply_trace: [], indicator_trace: [], audible: NoSoundReported, evidence: [e1_s1_after_said]),
  e1_transition(key: "j30-tapped", from_phase: "p3-settled", stimulus: HeaderBridgeApplied { bridge: e1_j30_tap }, to_phase: "p3-after-j30-tap", supply_trace: [], indicator_trace: [], audible: NoSoundReported, evidence: [e1_tap_said, e1_tap_repeats_said]),
  e1_transition(key: "j30-bridged", from_phase: "p3-settled", stimulus: HeaderBridgeApplied { bridge: e1_j30_bridge }, to_phase: "j30-held", supply_trace: [], indicator_trace: [], audible: NoSoundReported, evidence: [e1_j30_said, e1_bridges_said, e1_blinkers_said]),
  e1_transition(key: "j30-released", from_phase: "j30-held", stimulus: HeaderBridgeReleased { bridge: e1_j30_bridge }, to_phase: "j30-release", supply_trace: [e1_j30_recovery_draw], indicator_trace: [], audible: NoSoundReported, evidence: [e1_bridges_said]),
  e1_transition(key: "j30-recovery-settles", from_phase: "j30-release", stimulus: SettlingDelay, to_phase: "p3-settled", supply_trace: [], indicator_trace: [], audible: NoSoundReported, evidence: [e1_bridges_said]),
  e1_transition(key: "j68-bridged", from_phase: "p3-settled", stimulus: HeaderBridgeApplied { bridge: e1_j68_bridge }, to_phase: "j68-held", supply_trace: [e1_j68_held_draw], indicator_trace: [NoIndicatorSeen { evidence: e1_j68_held_said }], audible: ClickHeard { origin: Absent }, evidence: [e1_j68_said, e1_bridges_said, e1_j68_held_said, e1_j68_held_photo]),
  e1_transition(key: "j68-released", from_phase: "j68-held", stimulus: HeaderBridgeReleased { bridge: e1_j68_bridge }, to_phase: "j68-release", supply_trace: [], indicator_trace: [], audible: NoSoundReported, evidence: [e1_j68_said, e1_j68_held_said]),
  e1_transition(key: "j68-retry-settles", from_phase: "j68-release", stimulus: SettlingDelay, to_phase: "p3-settled", supply_trace: [], indicator_trace: [], audible: NoSoundReported, evidence: [e1_j68_held_said]),
]

data e1_bench_record: BenchRecord = BenchRecord {
  incidents: [e1_bridge_incident, e1_inductor_short_incident],
  attachments: [e1_pin7_attachment, e1_w2_attachment, e1_w4_attachment],
  alterations: [e1_u4_heatsink_alteration],
  voltages: concat(concat(concat(concat(concat(concat(e1_switch_readings(c: e1_q21), e1_switch_readings(c: e1_q22)), [e1_pad_volts(source_volts: 48, millivolts: 1800, said: "1.8v"), e1_pad_volts(source_volts: 36, millivolts: 1350, said: "1.35 at 36v")]), map([48, 36, 54], v => e1_wire_volts(source_volts: v))), [e1_vdd_volts]), concat([e1_lead_volts(pin: "pin 8", millivolts: 1800), e1_lead_volts(pin: "pin 7", millivolts: 0)], [e1_via_volts(source_volts: 38, millivolts: 3800, certainty: StatedHedged { verbatim: "~3.8v" }), e1_via_volts(source_volts: 54, millivolts: 4900, certainty: StatedPlainly)])), e1_zv_volts),
  resistances: concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(e1_ovlo_pad_resistances, e1_wire_resistances), e1_wire_later_resistances), e1_pin21_resistances), e1_rp1_resistances), e1_w2_resistances), e1_pin7_lead_resistances), e1_w4_resistances), e1_cluster_resistances), e1_q301_resistances), e1_zb_resistances), e1_u51_resistances), e1_front_chain_resistances), e1_u55_resistances), e1_site_resistances), e1_j24_resistances), e1_ds1_2_resistances), e1_j68_resistances), e1_after_short_resistances), e1_u100_lead_resistances), e1_converter_lead_resistances),
}

data e1_measured: MeasuredBoard = MeasuredBoard {
  asset: p4261_e1_b,
  continuity: concat(concat(concat(concat(
    // each fused-row position to both ends of F1: both points named
    map(j20_row_indices, i => e1_read(a: e1_j20_at(side: AwayFromLatch, index: i), b: e1_f1_near, record: both_points_recorded, result: BuzzerAsserted, evidence: e1_fuse_ends_said)),
    map(j20_row_indices, i => e1_read(a: e1_j20_at(side: AwayFromLatch, index: i), b: e1_f1_far, record: both_points_recorded, result: BuzzerAsserted, evidence: e1_fuse_ends_said))),
    // each latch-side position to the row's ground reference
    map(filter(j20_row_indices, i => i > 1), i => e1_read(a: e1_j20_at(side: LatchSide, index: i), b: e1_ground_ref, record: second_point_inferred(basis: e1_row_basis), result: BuzzerAsserted, evidence: e1_bottom_row_said))),
    [
      to_rail(a: e1_d2_near, result: BuzzerAsserted, evidence: e1_d2_tabs_said),
      to_ground(a: e1_d2_far, result: BuzzerAsserted, evidence: e1_d2_tabs_said),
      to_ground(a: e1_c10_neg, result: BuzzerAsserted, evidence: e1_d2_tabs_said),
      to_ground(a: e1_c12_neg, result: BuzzerAsserted, evidence: e1_d2_tabs_said),
      to_rail(a: e1_c10_pos, result: BuzzerNotAsserted, evidence: e1_caps_said),
      to_rail(a: e1_c12_pos, result: BuzzerNotAsserted, evidence: e1_caps_said),
      to_ground(a: e1_d5_top, result: BuzzerAsserted, evidence: e1_d5_tabs_said),
      to_rail(a: e1_d5_bottom, result: BuzzerAsserted, evidence: e1_d5_tabs_said),
      touched_to(a: e1_f300_one, reference: e1_rail_ref, first_basis: e1_touched_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f300_other, reference: e1_rail_ref, first_basis: e1_touched_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f300_one, reference: e1_ground_ref, first_basis: e1_touched_basis, second_basis: e1_ground_basis, result: BuzzerNotAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f300_other, reference: e1_ground_ref, first_basis: e1_touched_basis, second_basis: e1_ground_basis, result: BuzzerNotAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f302_one, reference: e1_rail_ref, first_basis: e1_touched_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f302_other, reference: e1_rail_ref, first_basis: e1_touched_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fuses_said),
    ]),
    // the probed input-stage MOSFET: the named tab and the middle lead (pin 4) to the rail; the other
    // leads silent to the rail, and every terminal silent to ground, inferred over the population named
    concat(concat(
      [
        to_rail(a: fet_terminal(name: "tab"), result: BuzzerAsserted, evidence: e1_fet_said),
        touched_to(a: fet_terminal(name: "pin 4"), reference: e1_rail_ref, first_basis: e1_middle_pin_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fet_said),
      ],
      map(e1_fet_off_rail, n => touched_to(a: fet_terminal(name: n), reference: e1_rail_ref, first_basis: e1_only_basis, second_basis: e1_rail_basis, result: BuzzerNotAsserted, evidence: e1_fet_said))),
      map(e1_fet_terminal_names, n => touched_to(a: fet_terminal(name: n), reference: e1_ground_ref, first_basis: e1_nothing_basis, second_basis: e1_ground_basis, result: BuzzerNotAsserted, evidence: e1_fet_said)))),
  source_draws: [e1_j20_draw],
  bench: e1_bench_record,
  phases: e1_phases,
  transitions: e1_transitions,
  pole_closures: e1_pole_closures,
  diode_readings: [
    DiodeModeObservation { asset: p4261_e1_b, probes: RedBlack { red: e1_d2_far, black: e1_d2_near }, display: ForwardMillivolts { millivolts: 600 }, conditions: e1_bench, evidence: OperatorStatement { stated_on: "2026-10-15", verbatim: "yeah putting the red on the ground of the diode and black on the supply reads .6" } },
    DiodeModeObservation { asset: p4261_e1_b, probes: RedBlack { red: e1_d5_top, black: e1_d5_bottom }, display: ForwardMillivolts { millivolts: 605 }, conditions: e1_bench, evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "diode reading on D5 gives .605 / yes red was on top" } },
  ],
}

