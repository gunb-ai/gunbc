// ── THE E1 UNIT (the operator's bench readings, asset p4261_e1_b) ──────────────────────────────
//
// THE E1 AS A DESIGN in product.electrical.connectivity's vocabulary: its parts are component instances
// scoped to this board, their pads are terminals, and every bench reading is a raw continuity or diode
// reading over those terminals. Nets are derived (product.electrical.continuity), never stated: the
// ground net is whatever continuity joined to J20's latch-side row, J20's supply net whatever it joined
// to the row away from the latch. A continuity net conducts through intact fuses and shunts, so F1's
// two ends on one net say F1 is intact and nothing about which side of it J20 sits on.
//
// Readings, 2026-10-15: each J20 row's nine positions beep to each other; the latch-side row beeps to
// D2's farther tab and the probed cans' negative terminals, the other row to both ends of F1 and D2's
// nearer tab; the two probed cans' positive terminals beep to each other and NOT to J20's supply; D2
// read 600 mV with red on its farther tab and black on its nearer; between the cans' positives and J20's
// supply, 523 mV one way and open the other, probe placement unrecorded. 2026-10-16: every copper-ringed
// mounting hole beeps to J20's latch-side row; D5's upper tab (as the operator described it) beeps to
// ground and its lower tab to J20's supply, as does every large bare pad by F300 (the unpopulated F302
// footprint among them), and so do both ends of F300; D5 read 605 mV with red on its upper tab and
// black on its lower.
// R010, the switch candidate and the third can are not yet in a recorded reading. F300 and F1 both sit
// on J20's supply continuity net, which says both are intact and nothing about whether either is in
// series with J20 or on a branch from it: continuity does not see through a fuse.
data e1_design: ElectricalDesignIdentity = "p4261-e1-b" as ElectricalDesignIdentity

data e1_j20: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "J20")
data e1_f1: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "F1")
data e1_d2: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "D2")
data e1_d5: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "D5")
data e1_f300: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "F300")
data e1_c10: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "C10_P5")
data e1_c12: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "C12_P5")
// Two readings each covered a whole population at once ("every ring", "every large bare pad"), with the
// members neither counted nor designated; each population is carried as one component whose one terminal
// stands for all of its members, until a reading separates them.
data e1_mounting_rings: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "copper-ringed mounting holes")
data e1_bare_pads: ComponentInstanceIdentity = component_instance_identity(design: e1_design, local_identity: "large bare pads by F300")

fn e1_terminal(c: ComponentInstanceIdentity, name: NonEmptyStr) -> ElectricalTerminalRef {
  terminal_ref(component: c, terminal: name as TerminalIdentity)
}

// J20'S EIGHTEEN POSITIONS, by side and by index along the row. The index runs from the end the operator
// called pin 1 (2026-10-15, top left as photographed, which is on the row away from the latch); the
// latch-side row is indexed in the same direction. Which end is the connector maker's pin 1 is unread.
data j20_row_indices: List<Nat> = [1, 2, 3, 4, 5, 6, 7, 8, 9]

fn j20_position_terminal(side: RowSide, index: Nat) -> TerminalIdentity {
  let row = match side {
    LatchSide => "latch-side row"
    AwayFromLatch => "row away from the latch"
    SideUnrecorded => "row of unrecorded side"
  }
  (join([row, ", position ", to_string(index)], "") as NonEmptyStr) as TerminalIdentity
}

fn j20_row(side: RowSide) -> List<HousingPosition> {
  map(j20_row_indices, i => HousingPosition { terminal: j20_position_terminal(side: side, index: i), side: side, index: i })
}

data e1_j20_housing: ConnectorHousing = ConnectorHousing {
  component: e1_j20,
  positions: concat(j20_row(side: LatchSide), j20_row(side: AwayFromLatch)),
}

fn housing_side_terminals(h: ConnectorHousing, side: RowSide) -> List<ElectricalTerminalRef> {
  map(filter(h.positions, p => row_side_code(s: p.side) == row_side_code(s: side)), p => terminal_ref(component: h.component, terminal: p.terminal))
}

data e1_j20_latch_1: ElectricalTerminalRef = terminal_ref(component: e1_j20, terminal: j20_position_terminal(side: LatchSide, index: 1))
data e1_j20_away_1: ElectricalTerminalRef = terminal_ref(component: e1_j20, terminal: j20_position_terminal(side: AwayFromLatch, index: 1))
data e1_f1_near: ElectricalTerminalRef = e1_terminal(c: e1_f1, name: "end nearer J20")
data e1_f1_far: ElectricalTerminalRef = e1_terminal(c: e1_f1, name: "end farther from J20")
data e1_d2_near: ElectricalTerminalRef = e1_terminal(c: e1_d2, name: "tab nearer J20")
data e1_d2_far: ElectricalTerminalRef = e1_terminal(c: e1_d2, name: "tab farther from J20")
data e1_d5_upper: ElectricalTerminalRef = e1_terminal(c: e1_d5, name: "upper tab (as the operator described it, 2026-10-16)")
data e1_d5_lower: ElectricalTerminalRef = e1_terminal(c: e1_d5, name: "lower tab (as the operator described it, 2026-10-16)")
data e1_c10_pos: ElectricalTerminalRef = e1_terminal(c: e1_c10, name: "positive")
data e1_c10_neg: ElectricalTerminalRef = e1_terminal(c: e1_c10, name: "negative")
data e1_c12_pos: ElectricalTerminalRef = e1_terminal(c: e1_c12, name: "positive")
data e1_c12_neg: ElectricalTerminalRef = e1_terminal(c: e1_c12, name: "negative")
data e1_f300_one_end: ElectricalTerminalRef = e1_terminal(c: e1_f300, name: "one end")
data e1_f300_other_end: ElectricalTerminalRef = e1_terminal(c: e1_f300, name: "the other end")
data e1_every_ring: ElectricalTerminalRef = e1_terminal(c: e1_mounting_rings, name: "every ring (count unread)")
data e1_every_bare_pad: ElectricalTerminalRef = e1_terminal(c: e1_bare_pads, name: "every pad (count unread)")

data e1_ground: NetIdentity = net_identity(design: e1_design, local_identity: "ground")
data e1_j20_supply: NetIdentity = net_identity(design: e1_design, local_identity: "J20 supply")
data e1_capacitor_rail: NetIdentity = net_identity(design: e1_design, local_identity: "capacitor rail")

data e1_measured_circuit: MeasuredCircuit = MeasuredCircuit {
  asset: p4261_e1_b,
  read_on: "2026-10-15 and 2026-10-16",
  conditions: "unpowered, module removed, handheld multimeter in continuity and diode modes",
  readings: [
    JoinedByContinuity { terminals: concat(housing_side_terminals(h: e1_j20_housing, side: LatchSide), [e1_d2_far, e1_c10_neg, e1_c12_neg]) },
    JoinedByContinuity { terminals: concat(housing_side_terminals(h: e1_j20_housing, side: AwayFromLatch), [e1_f1_near, e1_f1_far, e1_d2_near]) },
    JoinedByContinuity { terminals: [e1_c10_pos, e1_c12_pos] },
    OpenByContinuity { a: e1_j20_away_1, b: e1_c10_pos },
    JoinedByContinuity { terminals: [e1_j20_latch_1, e1_every_ring] },
    JoinedByContinuity { terminals: [e1_j20_latch_1, e1_d5_upper] },
    JoinedByContinuity { terminals: [e1_j20_away_1, e1_d5_lower, e1_every_bare_pad] },
    JoinedByContinuity { terminals: [e1_j20_away_1, e1_f300_one_end, e1_f300_other_end] },
  ],
  anchors: [
    NetAnchor { net: e1_ground, anchor: e1_j20_latch_1 },
    NetAnchor { net: e1_j20_supply, anchor: e1_j20_away_1 },
    NetAnchor { net: e1_capacitor_rail, anchor: e1_c10_pos },
  ],
  input_supply: e1_j20_supply,
  ground: e1_ground,
  diode_readings: [
    DiodeModeReading { probes: RedBlack { red: e1_d2_far, black: e1_d2_near }, display: ForwardMillivolts { millivolts: 600 } },
    DiodeModeReading { probes: PlacementUnrecorded { between: [e1_c10_pos, e1_j20_away_1] }, display: ForwardMillivolts { millivolts: 523 } },
    DiodeModeReading { probes: PlacementUnrecorded { between: [e1_c10_pos, e1_j20_away_1] }, display: OverLimit },
    DiodeModeReading { probes: RedBlack { red: e1_d5_upper, black: e1_d5_lower }, display: ForwardMillivolts { millivolts: 605 } },
  ],
}

data e1_adjacency_j20: PathMembership = OnPathByAdjacency {
  basis: "operator close-ups of the E1 carrier, 2026-10-15: the part sits beside J20 and was not probed; adjacency, not a traced net",
}

// A fuse has no return terminal, so the circuit cannot place its rating across the input the way it
// places a TVS diode's; F300's ends on J20's supply net put it on J20's path, not across the rail.
data e1_f300_on_j20_supply: PathMembership = OnPathByAdjacency {
  basis: "measured circuit on the E1 carrier, 2026-10-16: both ends of F300 are on J20's supply continuity net, so the fuse is on J20's input; a fuse's interrupt rating is not a rating across the rail, and whether F300 is in series with J20 or on a branch is not decidable from continuity",
}

// The probed cans' fallback when the circuit does not place them across J20 -- which it does not.
data e1_caps_not_across_j20: PathMembership = OnPathByAdjacency {
  basis: "measured circuit on the E1 carrier: the cans' negative terminals are on ground, their positive terminals on a separate 'capacitor rail' net, read open to J20's supply in continuity and joined to it only through a one-way junction (523 mV / open, probe placement unrecorded) -- consistent with the body diode of the switch between R010 and the cans, and equally with a converter's switch, which would put the cans on a different rail",
}

