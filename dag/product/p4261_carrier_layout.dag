// GH200-3 (2026-10-04). THE P4261 CARRIER AS PHOTOGRAPHED, AND WHAT CAN BE DEDUCED FROM IT. No NVIDIA
// document names this board, so everything here is the operator's observation of a unit, kept in
// the product layer (DESIGN §3: observations are receipts downstream, never upstream facts). What
// IS upstream -- a part's datasheet ratings once its marking is matched -- lives in
// extdeps.electronic_component and extdeps.connector and is consumed here.
//
// Every marking is transcribed as read, and the standings are kept apart because they license
// different conclusions:
//
//   IdentifiedByDatasheetMarking  the marking matches one maker's marking table, so the part's
//                                 ratings are cited facts
//   MarkingSharedByMakers         the marking matches the same code in several makers' tables and the
//                                 maker is not identified: the electrical class is cited, the maker is
//                                 not, and the lowest rating among the candidates is the one carried
//   RatingPrintedOnBody           the part prints its own rating; no datasheet, but no decoding either
//   MarkingUnresolved             the marking is read and NOT decoded; it contributes nothing, and the
//                                 discriminator says what would decode it
//
// Which circuit a part sits on is a further fact. From a photograph it is ADJACENCY, not copper, and
// bounds nothing. From a multimeter it is a MEASURED CIRCUIT (below), which is the one authority for
// whether a part sits across an input.
//
// GH200-P9 (2026-10-15): ONE OBSERVATION PER PHYSICAL CARRIER. The K1 observation is the K1 listing's
// photographs and nothing else. The operator's bench readings are of a different board, whose model
// label the operator reads as revision E1 (asset p4261_e1_b), and live in its own observation; no
// reading transfers between them because both are P4261 boards. The paths are named by connector,
// not by role: which connector carries the module's power is not established.

type ComponentIdentification
  = IdentifiedByDatasheetMarking { row: ElectronicComponentRow, marking_read: NonEmptyStr }
  | MarkingSharedByMakers { rows: List<ElectronicComponentRow>, marking_read: NonEmptyStr }
  | RatingPrintedOnBody { voltage: ComponentVoltageRating?, current: Ampere?, marking_read: NonEmptyStr }
  | ResistanceCodeRead { milliohms: Nat, marking_read: NonEmptyStr }
  | MarkingUnresolved { marking_read: NonEmptyStr, discriminator: NonEmptyStr }

type PowerPath = GreyBlindMatePath | J20InputPath

// WHAT RELATES A PART'S RATING TO A RAIL. RatingAcrossInputRail is the one relation that licenses a
// bound: the evidence must say that the rated terminals see the input rail -- a measured circuit, a
// schematic, or the vendor's reference design. OnPathByAdjacency places the part near a path and
// bounds nothing: an input-stage part and a downstream converted rail can share one region.
type PathMembership
  = RatingAcrossInputRail { evidence: NonEmptyStr }
  | OnPathByAdjacency { basis: NonEmptyStr }

type ObservedComponent {
  designators: List<NonEmptyStr>
  quantity: Nat
  role: NonEmptyStr
  identification: ComponentIdentification
  path: PowerPath
  membership: PathMembership
}

// A signal part identified by its marking: a sensor or controller whose relevance is where its pins go.
type IdentifiedSignalPart {
  designators: List<NonEmptyStr>
  marking_read: NonEmptyStr
  row: SignalComponentRow
}

// J20'S PINS BY CONTINUITY, unpowered. Each row of pins is read against ground and against the fuse
// beside the connector; tied_together says every pin in the row beeps to every other.
type ContinuityTarget
  = ToGround
  | ToFuse { designator: NonEmptyStr }

type PinRowContinuity {
  pins: Nat
  tied_to: ContinuityTarget
  tied_together: Bool
}

// THE MEASURED CIRCUIT: the part of one board's netlist a multimeter has established, unpowered. A node
// is a set of terminals continuity found joined to each other. A diode-mode reading is kept RAW -- which
// node the red probe touched, which the black, and what the meter displayed -- and orientation is
// derived from it: in diode mode the red probe is positive, so a forward reading with red on X and
// black on Y puts an anode on X and a cathode on Y. A direction nobody read is absent, not open. A
// terminal no reading reached is absent, never assumed. The circuit binds to the physical asset it was
// read on, so it cannot describe another carrier.
type CircuitNode {
  name: NonEmptyStr
  terminals: List<NonEmptyStr>
}

type ProbePoint
  = OnNode { node: NonEmptyStr }
  | ProbePlacementUnrecorded

type MeterDisplay
  = ForwardMillivolts { millivolts: Nat }
  | OverLimit

type DiodeModeReading {
  red_on: ProbePoint
  black_on: ProbePoint
  display: MeterDisplay
}

type NodePairReadings {
  nodes: List<NonEmptyStr>
  readings: List<DiodeModeReading>
}

type MeasuredCircuit {
  asset: PhysicalAssetIdentity
  read_on: NonEmptyStr
  conditions: NonEmptyStr
  nodes: List<CircuitNode>
  diode_readings: List<NodePairReadings>
}

type JunctionOrientation
  = CathodeOn { cathode_node: NonEmptyStr, anode_node: NonEmptyStr }
  | OrientationUnread

// A connector family read off one housing, and which unit it was read on.
type ConnectorFamilyCandidate {
  row: ConnectorComponentRow
  marking_read: NonEmptyStr
  read_on_unit: NonEmptyStr
}

type ConnectorCensus
  = CensusComplete { count: Nat, family: NonEmptyStr }
  | CensusPartial { counted_at_least: Nat, obligation: NonEmptyStr, family_candidate: ConnectorFamilyCandidate? }

type CarrierLayoutObservation {
  labels: List<NonEmptyStr>
  module_receptacles: List<NonEmptyStr>
  grey_edge_connectors: NonEmptyStr
  j20_connector: NonEmptyStr
  j20_positions: Nat
  j20_rows: List<PinRowContinuity>
  edge_high_speed_connectors: ConnectorCensus
  management_io_observed: List<NonEmptyStr>
  power_components: List<ObservedComponent>
  identified_signal_parts: List<IdentifiedSignalPart>
  unresolved_parts: List<NonEmptyStr>
}

// One housing's marking, read from an operator photograph 2026-10-15. Which of the two received
// carriers it was photographed on was not recorded, so each observation carries it as a candidate for
// its own housings, never as a reading of them.
data operator_carrier_edge_family: ConnectorFamilyCandidate = ConnectorFamilyCandidate {
  row: g97v22332hr,
  marking_read: "G97V22332HR / 2248 / Amphenol",
  read_on_unit: "one of the operator's two carriers; which one was not recorded",
}

// ── THE MEASURED CIRCUIT AND ITS DEDUCTIONS ──────────────────────────────────────────────────

fn node_of(c: MeasuredCircuit, terminal: NonEmptyStr) -> NonEmptyStr? {
  match filter(c.nodes, n => any(n.terminals, t => t == terminal)).first() {
    Absent => Absent
    Present { value: n } => Present { value: n.name }
  }
}

fn on_node(c: MeasuredCircuit, terminal: NonEmptyStr, node: NonEmptyStr) -> Bool {
  match node_of(c: c, terminal: terminal) {
    Absent => false
    Present { value: n } => n == node
  }
}

fn pair_joins(p: NodePairReadings, a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  any(p.nodes, n => n == a) && any(p.nodes, n => n == b)
}

fn readings_between(c: MeasuredCircuit, a: NonEmptyStr, b: NonEmptyStr) -> List<DiodeModeReading> {
  flat_map(filter(c.diode_readings, p => pair_joins(p: p, a: a, b: b)), p => p.readings)
}

fn reading_orientation(r: DiodeModeReading) -> JunctionOrientation {
  match r.display {
    OverLimit => OrientationUnread
    ForwardMillivolts { millivolts: _ } => match r.red_on {
      ProbePlacementUnrecorded => OrientationUnread
      OnNode { node: anode } => match r.black_on {
        ProbePlacementUnrecorded => OrientationUnread
        OnNode { node: cathode } => CathodeOn { cathode_node: cathode, anode_node: anode }
      }
    }
  }
}

fn is_oriented(o: JunctionOrientation) -> Bool {
  match o {
    CathodeOn { cathode_node: _, anode_node: _ } => true
    OrientationUnread => false
  }
}

// The orientation the raw readings between two nodes establish, if any reading establishes one.
fn orientation_between(c: MeasuredCircuit, a: NonEmptyStr, b: NonEmptyStr) -> JunctionOrientation {
  match filter(map(readings_between(c: c, a: a, b: b), r => reading_orientation(r: r)), o => is_oriented(o: o)).first() {
    Absent => OrientationUnread
    Present { value: o } => o
  }
}

fn probe_text(p: ProbePoint) -> String {
  match p {
    OnNode { node: n } => join(["'", n as String, "'"], "")
    ProbePlacementUnrecorded => "an unrecorded node"
  }
}

fn display_text(d: MeterDisplay) -> String {
  match d {
    ForwardMillivolts { millivolts: mv } => join([to_string(mv), " mV"], "")
    OverLimit => "over limit (open)"
  }
}

fn reading_text(r: DiodeModeReading) -> String {
  join(["red on ", probe_text(p: r.red_on), ", black on ", probe_text(p: r.black_on), ": ", display_text(d: r.display)], "")
}

fn junction_text(c: MeasuredCircuit, a: NonEmptyStr, b: NonEmptyStr) -> String {
  let rs = readings_between(c: c, a: a, b: b)
  match rs.first() {
    Absent => "no diode-mode reading between these nodes"
    Present { value: _ } => join([
      "diode mode: ", join(map(rs, r => reading_text(r: r)), "; "),
      if count(rs) == 1 { "; the reverse direction was not read" } else { "" },
      match orientation_between(c: c, a: a, b: b) {
        CathodeOn { cathode_node: k, anode_node: _ } => join(["; cathode on '", k as String, "'"], "")
        OrientationUnread => "; orientation not established"
      },
    ], "")
  }
}

// THE DEDUCTION. A part every one of whose positive terminals is on the input's supply node, and every
// one of whose return terminals is on ground, is across that input; the evidence is rendered from the
// circuit itself, raw diode readings included. Any other part keeps the membership it would have
// without the circuit.
fn membership_by_circuit(c: MeasuredCircuit, positives: List<NonEmptyStr>, returns: List<NonEmptyStr>, supply: NonEmptyStr, ground: NonEmptyStr, otherwise: PathMembership) -> PathMembership {
  let placed = count(positives) > 0 && count(returns) > 0
    && all(positives, t => on_node(c: c, terminal: t, node: supply))
    && all(returns, t => on_node(c: c, terminal: t, node: ground))
  if placed {
    RatingAcrossInputRail { evidence: join([
      "measured circuit on asset ", c.asset as String, " (", c.read_on as String, ", ", c.conditions as String, "): ",
      join(map(positives, t => join(["'", t as String, "'"], "")), ", "), " on node '", supply as String, "', ",
      join(map(returns, t => join(["'", t as String, "'"], "")), ", "), " on node '", ground as String, "'; ",
      junction_text(c: c, a: ground, b: supply),
    ], "") as NonEmptyStr }
  } else { otherwise }
}

