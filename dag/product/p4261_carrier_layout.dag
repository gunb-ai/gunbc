        current: Present { value: ampere(count: 100) },
        marking_read: "LF 75V 100A (Littelfuse's 881 series sells a 75 VDC / 100 A part, 0881100, and lists a sibling's marking as 'LF 75V 60A' -- a pattern, the 100 A marking itself not read from a Littelfuse table)",
      },
      path: J20InputPath,
      membership: e1_f300_on_j20_supply,
