        marking_read: "5PGK / ZCN5U under a boxed maker logo that is not identified: 5PGK is 5.0SMDJ60A in both Bourns's and Alpha and Omega Semiconductor's marking tables",
      },
      path: J20InputPath,
      membership: membership_by_circuit(c: e1_measured_circuit, positives: [e1_d2_near], returns: [e1_d2_far], otherwise: e1_adjacency_j20),
    },
    ObservedComponent {
      designators: ["D5"],
      quantity: 1,
