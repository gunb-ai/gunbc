}

// ── WHAT THE PARTS BOUND ─────────────────────────────────────────────────────────────────────
//
// A BOUND IS DERIVED ONLY FROM PARTS WHOSE RATING IS ESTABLISHED ACROSS THE INPUT RAIL: the lowest such
// rating bounds the rail from above, because the rail would exceed that part's rating. Every other
// rated part -- placed by adjacency, or on a rail whose relation to the input is unknown -- is an
// observation that is carried and named, never folded into the bound. (GH200-5, 2026-10-04: the first
// revision took the minimum over adjacency-placed parts and reported the fuse's 75 V as an input
// ceiling; review showed that a lower-rated part on a downstream rail sharing the region would have
// lowered it, so adjacency no longer participates.) A bound never says what the rail IS.
type InputVoltageBound
  = BoundByRatedParts { maximum: Volt, limiting: NonEmptyStr, relation: NonEmptyStr }
  | NoEstablishedBound { observed_ratings: List<NonEmptyStr> }

// Several makers' rows for one code: the lowest rating among them is carried, so the class bounds no
// more than its weakest candidate allows.
fn lowest_rating(rows: List<ElectronicComponentRow>) -> ComponentVoltageRating? {
  match rows.first() {
    Absent => Absent
    Present { value: first } => Present { value: fold(rows, init: first.voltage_rating, f: (acc, r) => if volt_count(v: r.voltage_rating.maximum) < volt_count(v: acc.maximum) { r.voltage_rating } else { acc }) }
  }
}

fn component_rating(c: ObservedComponent) -> ComponentVoltageRating? {
  match c.identification {
    IdentifiedByDatasheetMarking { row: r, marking_read: _ } => Present { value: r.voltage_rating }
    MarkingSharedByMakers { rows: rs, marking_read: _ } => lowest_rating(rows: rs)
    RatingPrintedOnBody { voltage: v, current: _, marking_read: _ } => v
    ResistanceCodeRead { milliohms: _, marking_read: _ } => Absent
    MarkingUnresolved { marking_read: _, discriminator: _ } => Absent
  }
}

fn path_key(p: PowerPath) -> Nat {
  match p {
    GreyBlindMatePath => 0
    J20InputPath => 1
  }
}

fn path_eq(a: PowerPath, b: PowerPath) -> Bool {
  path_key(p: a) == path_key(p: b)
}

type RatedComponent {
  component: ObservedComponent
  rating: ComponentVoltageRating
}

fn rating_kind_text(k: VoltageRatingKind) -> String {
  match k {
    DrainSourceMaximum => "drain-source maximum"
    FuseInterruptRating => "fuse voltage rating"
    CapacitorRatedVoltage => "capacitor rated voltage"
    TvsReverseStandoff => "TVS reverse standoff"
  }
}

fn rated_text(r: RatedComponent) -> NonEmptyStr {
  join([
    r.component.role as String, ": ", to_string(volt_count(v: r.rating.maximum)), " V ", rating_kind_text(k: r.rating.kind),
    match r.component.membership {
      RatingAcrossInputRail { evidence: _ } => ""
      OnPathByAdjacency { basis: _ } => ", placed by adjacency only",
    },
  ], "") as NonEmptyStr
}

fn rated_on_path(layout: CarrierLayoutObservation, path: PowerPath) -> List<RatedComponent> {
  flat_map(filter(layout.power_components, c => path_eq(a: c.path, b: path)), c =>
    match component_rating(c: c) {
      Present { value: r } => [RatedComponent { component: c, rating: r }]
      Absent => []
    }
  )
}

fn across_input_rail(r: RatedComponent) -> Bool {
  match r.component.membership {
    RatingAcrossInputRail { evidence: _ } => true
    OnPathByAdjacency { basis: _ } => false
  }
}

fn path_bound(layout: CarrierLayoutObservation, path: PowerPath) -> InputVoltageBound {
  let rated = rated_on_path(layout: layout, path: path)
  let bounding = filter(rated, r => across_input_rail(r: r))
  match bounding.first() {
    Absent => NoEstablishedBound { observed_ratings: map(rated, r => rated_text(r: r)) }
    Present { value: first } => {
      let lowest = fold(bounding, init: first, f: (acc, x) => if volt_count(v: x.rating.maximum) < volt_count(v: acc.rating.maximum) { x } else { acc })
      BoundByRatedParts {
        maximum: lowest.rating.maximum,
        limiting: lowest.component.role,
        relation: match lowest.component.membership {
          RatingAcrossInputRail { evidence: e } => e
          OnPathByAdjacency { basis: b } => b
        },
      }
    }
  }
}

// THE BUS-CLASS QUESTION IS AN INVESTIGATION HYPOTHESIS, NOT A DERIVATION. No rule over part ratings
// decides a bus class: a 100 V FET is a common choice for a 48-54 V hot-swap stage and is not thereby
// absent from lower-voltage designs, so the first revision's ">= 80 V drain-source means 48-54 V" rule
// manufactured a class from a threshold (GH200-5, review). What remains is the hypothesis, its sources
// stated beside it, and the reading that would decide it.
type InvestigationHypothesis {
  claim: NonEmptyStr
  sources: List<NonEmptyStr>
  decided_by: NonEmptyStr
}

data p4261_grey_path_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "the grey blind-mate connectors carry the P4261's main input, and it is a 48-54 V-class bus",
  sources: [
    "the input-stage MOSFETs beside the grey blocks are Infineon IPB017N10N5LF, a 100 V part its vendor presents for hot-swap and e-fuse use and characterizes at VDS=56V (extdeps.electronic_component.infineon_ipb017n10n5lf): consistent with a 48-54 V stage, not a determination of one",
    "the module part number 699-2G530-0215 reads as SKU215, which an uncited earlier NVIDIA guide revision tied to a 54 V module rail (extdeps.systems.nvidia_gh200 gh200_rail_variants): a lead about the module, not the carrier's input",
  ],
  decided_by: "the grey blocks' power contacts traced to that stage on a measured circuit, plus the input rating read off the original power-distribution board or harness, the carrier's schematic or vendor documentation, or a measurement of the original system's supply output",
}

fn bound_text(b: InputVoltageBound) -> String {
  match b {
    BoundByRatedParts { maximum: m, limiting: l, relation: r } =>
      join(["at most ", to_string(volt_count(v: m)), " V, limited by the ", l as String, " (", r as String, ")"], "")
    NoEstablishedBound { observed_ratings: rs } =>
      match rs.first() {
        Absent => "no rated part read on this path, and no input bound"
        Present { value: _ } => join(["no input bound established: no part's rating is shown to apply across the input rail; ratings observed (", join(map(rs, r => r as String), "; "), ") bound nothing"], "")
      }
  }
}

fn hypothesis_text(h: InvestigationHypothesis) -> String {
  join(["hypothesis, not a derivation: ", h.claim as String, " (", join(map(h.sources, x => x as String), "; "), "); decided by ", h.decided_by as String], "")
}

// THE READING the bench plan consumes: what the photographs establish about the carrier's power
// input, and what they leave open.
fn row_side_text(s: RowSide) -> String {
  match s {
    LatchSide => "on the latch side"
    AwayFromLatch => "on the side away from the latch"
    SideUnrecorded => "side unrecorded"
  }
}

fn row_side_code(s: RowSide) -> Nat {
  match s {
    SideUnrecorded => 0
    LatchSide => 1
    AwayFromLatch => 2
  }
}

fn j20_position_count(layout: CarrierLayoutObservation) -> Nat {
  match layout.j20 {
    CountedFromPhotograph { positions: n, source: _ } => n
    MappedOnHousing { housing } => count(housing.positions)
  }
}

// The one net every position on a side lies on, if there is one.
fn side_net(nl: MeasuredNetlist, h: ConnectorHousing, side: RowSide) -> NetIdentity? {
  let ts = housing_side_terminals(h: h, side: side)
  match ts.first() {
    Absent => Absent
    Present { value: t0 } => match measured_net_of(netlist: nl, t: t0) {
      Absent => Absent
      Present { value: n } => if all(ts, t => on_measured_net(netlist: nl, t: t, net: n)) { Present { value: n } } else { Absent }
    }
  }
}

fn side_is_on(nl: MeasuredNetlist, h: ConnectorHousing, side: RowSide, net: NetIdentity) -> Bool {
  match side_net(nl: nl, h: h, side: side) {
    Absent => false
    Present { value: n } => net_identity_eq(a: n, b: net)
  }
}

fn housing_polarity(h: ConnectorHousing, c: MeasuredCircuit) -> PolarityReading {
  if any(h.positions, p => row_side_code(s: p.side) == 0) {
    PolarityUnrecorded { reason: "a position's side on the housing is unrecorded" }
  } else {
    match circuit_netlist(c: c) {
      NetlistRefused { cause } => PolarityUnrecorded { reason: join(["the measured circuit refuses: ", continuity_refusal_text(c: cause)], "") as NonEmptyStr }
      NetlistDerived { netlist: nl } =>
        if side_is_on(nl: nl, h: h, side: AwayFromLatch, net: c.input_supply) && side_is_on(nl: nl, h: h, side: LatchSide, net: c.ground) {
          PolarityRecorded { supply_side: AwayFromLatch, ground_side: LatchSide }
        } else {
          if side_is_on(nl: nl, h: h, side: LatchSide, net: c.input_supply) && side_is_on(nl: nl, h: h, side: AwayFromLatch, net: c.ground) {
            PolarityRecorded { supply_side: LatchSide, ground_side: AwayFromLatch }
          } else {
            PolarityUnrecorded { reason: "the housing's two sides do not lie one on the supply net and one on ground" }
          }
        }
    }
  }
}

fn polarity_reading(layout: CarrierLayoutObservation) -> PolarityReading {
  match layout.j20 {
    CountedFromPhotograph { positions: _, source: _ } => PolarityUnrecorded { reason: "J20's positions are counted from a photograph, not mapped" }
    MappedOnHousing { housing } => match layout.circuit {
      Absent => PolarityUnrecorded { reason: "no measured circuit on this unit" }
      Present { value: c } => housing_polarity(h: housing, c: c)
    }
  }
}

fn side_summary(nl: MeasuredNetlist, h: ConnectorHousing, side: RowSide) -> String {
  join([
    to_string(count(housing_side_terminals(h: h, side: side))), " ", row_side_text(s: side),
    match side_net(nl: nl, h: h, side: side) {
      Absent => " on no single named net"
      Present { value: n } => join([" on net '", net_local_label(n: n) as String, "'"], "")
    },
  ], "")
}

fn j20_text(layout: CarrierLayoutObservation) -> String {
  match layout.j20 {
    CountedFromPhotograph { positions: n, source: src } => join([to_string(n), " positions counted from ", src as String, "; pin continuity unread"], "")
    MappedOnHousing { housing } => match layout.circuit {
      Absent => join([to_string(count(housing.positions)), " positions mapped on the housing; no measured circuit"], "")
      Present { value: c } => match circuit_netlist(c: c) {
        NetlistRefused { cause } => join(["the measured circuit refuses: ", continuity_refusal_text(c: cause)], "")
        NetlistDerived { netlist: nl } => join([to_string(count(housing.positions)), " positions: ", side_summary(nl: nl, h: housing, side: LatchSide), "; ", side_summary(nl: nl, h: housing, side: AwayFromLatch)], "")
      }
    }
  }
}

fn polarity_text(p: PolarityReading) -> String {
  match p {
    PolarityRecorded { supply_side, ground_side } => join(["polarity recorded: fused supply ", row_side_text(s: supply_side), ", ground ", row_side_text(s: ground_side)], "")
    PolarityUnrecorded { reason } => join(["polarity UNRECORDED (", reason as String, "): re-read before any connection"], "")
  }
}

fn carrier_input_reading(layout: CarrierLayoutObservation) -> String {
  join([
    "grey blind-mate path: ", bound_text(b: path_bound(layout: layout, path: GreyBlindMatePath)), ". ", hypothesis_text(h: p4261_grey_path_hypothesis),
    ". J20 input path at ", layout.j20_connector as String, " (", j20_text(layout: layout), "; ", polarity_text(p: polarity_reading(layout: layout)), "): ",
    bound_text(b: path_bound(layout: layout, path: J20InputPath)),
    ". Which connector carries the module's power is not established. The input voltage contract is unknown: no rail, pin assignment, standby rail or sequence is established",
  ], "")
}

fn signal_part_text(p: IdentifiedSignalPart) -> String {
  join([
    join(map(p.designators, d => d as String), ", "), " ('", p.marking_read as String, "') is ", p.row.ordering_code as String, ", a ", p.row.function as String,
    "; trace pins ", join(map(filter(p.row.pins, x => x.name != "GND" && x.name != "V+"), x => join([to_string(x.number), " ", x.name as String], "")), ", "),
  ], "")
}

fn management_io_text(layout: CarrierLayoutObservation) -> String {
  let io = match layout.management_io_survey {
    WholeBoardPhotographed => match layout.management_io_observed.first() {
      Absent => "the photographed P4261 shows no RJ45, USB, video, console header or coin cell"
      Present { value: _ } => join(["the photographed P4261 shows no RJ45, video or coin cell; it shows ", join(map(layout.management_io_observed, s => s as String), "; ")], "")
    }
    PartlyPhotographed { not_covered } => match layout.management_io_observed.first() {
      Absent => join(["this P4261's management I/O is unsurveyed: ", not_covered as String], "")
      Present { value: _ } => join(["this P4261 is partly photographed, so no absence of management I/O is established (", not_covered as String, "); it shows ", join(map(layout.management_io_observed, s => s as String), "; ")], "")
    }
  }
  match layout.identified_signal_parts.first() {
    Absent => io
    Present { value: _ } => join([io, ". Identified management-bus parts: ", join(map(layout.identified_signal_parts, p => signal_part_text(p: p)), "; ")], "")
  }
}

fn edge_connector_text(layout: CarrierLayoutObservation) -> String {
  match layout.edge_high_speed_connectors {
    CensusComplete { count: n, family: f } => join([to_string(n), " ", f as String, " connectors"], "")
    CensusPartial { counted_at_least: n, obligation: o, family_candidate: f } => join([
      "at least ", to_string(n), " cabled high-speed connectors (", o as String, ")",
      match f {
        Absent => ""
        Present { value: fc } => join(["; family candidate ", fc.row.ordering_code as String, " (", fc.row.series as String, ", ", to_string(fc.row.positions), " positions), marking '", fc.marking_read as String, "' read on ", fc.read_on_unit as String], "")
      },
    ], "")
  }
}
