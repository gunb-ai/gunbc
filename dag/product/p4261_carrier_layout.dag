    InstalledComponent { component: e1_y50, terminals: names(ns: e1_y50_pads), identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "T327K / EV13", evidence: e1_u500_photo } }, discriminator: "a four-pad crystal by its Y designator and package; whether 'T327K' (or '1327K') encodes its frequency is unread until a maker's table says so" } },
