// GH200-3 (2026-10-04). THE P4261 CARRIER AS PHOTOGRAPHED, AND WHAT CAN BE DEDUCED FROM IT. No NVIDIA
// document names this board, so everything here is the operator's observation of a unit, kept in
// the product layer (DESIGN §3: observations are receipts downstream, never upstream facts). What
// IS upstream -- a part's datasheet ratings once its marking is matched -- lives in
// extdeps.electronic_component and extdeps.connector and is consumed here.
//
// Every marking is transcribed as read, and the standings are kept apart because they license
// different conclusions:
//
//   IdentifiedByDatasheetMarking  the marking matches one maker's marking table, so the part's
//                                 ratings are cited facts
//   MarkingSharedByMakers         the marking matches the same code in several makers' tables and the
//                                 maker is not identified: the electrical class is cited, the maker is
//                                 not, and the lowest rating among the candidates is the one carried
//   RatingPrintedOnBody           the part prints its own rating; no datasheet, but no decoding either
//   MarkingUnresolved             the marking is read and NOT decoded; it contributes nothing, and the
//                                 discriminator says what would decode it
//
// Which circuit a part sits on is a further fact. From a photograph it is ADJACENCY, not copper, and
// bounds nothing. From a multimeter it is a MEASURED CIRCUIT (below), which is the one authority for
// whether a part sits across an input.
//
// GH200-P9 (2026-10-15): ONE OBSERVATION PER PHYSICAL CARRIER. The K1 observation is the K1 listing's
// photographs and nothing else. The operator's bench readings are of a different board, whose model
// label the operator reads as revision E1 (asset p4261_e1_b), and live in its own observation; no
// reading transfers between them because both are P4261 boards. The paths are named by connector,
// not by role: which connector carries the module's power is not established.

type ComponentIdentification
  = IdentifiedByDatasheetMarking { row: ElectronicComponentRow, marking_read: NonEmptyStr }
  | MarkingSharedByMakers { rows: List<ElectronicComponentRow>, marking_read: NonEmptyStr }
  | RatingPrintedOnBody { voltage: ComponentVoltageRating?, current: Ampere?, marking_read: NonEmptyStr }
  | ResistanceCodeRead { milliohms: Nat, marking_read: NonEmptyStr }
  | MarkingUnresolved { marking_read: NonEmptyStr, discriminator: NonEmptyStr }

type PowerPath = GreyBlindMatePath | J20InputPath

// WHAT RELATES A PART'S RATING TO A RAIL. RatingAcrossInputRail is the one relation that licenses a
// bound: the evidence must say that the rated terminals see the input rail -- a measured circuit, a
// schematic, or the vendor's reference design. OnPathByAdjacency places the part near a path and
// bounds nothing: an input-stage part and a downstream converted rail can share one region.
type PathMembership
  = RatingAcrossInputRail { evidence: NonEmptyStr }
  | OnPathByAdjacency { basis: NonEmptyStr }

type ObservedComponent {
  designators: List<NonEmptyStr>
  quantity: Nat
  role: NonEmptyStr
  identification: ComponentIdentification
  path: PowerPath
  membership: PathMembership
}

// A signal part identified by its marking: a sensor or controller whose relevance is where its pins go.
type IdentifiedSignalPart {
  designators: List<NonEmptyStr>
  marking_read: NonEmptyStr
  row: SignalComponentRow
}

// WHICH PHYSICAL ROW, against a reference on the housing anyone can find: the latch. A row swap reverses
// polarity, so a position whose side was not recorded is never assumed.
type RowSide
  = LatchSide
  | AwayFromLatch
  | SideUnrecorded

// A CONNECTOR'S POSITIONS AS TERMINALS. Each position is a terminal of the connector's component
// instance, so what continuity found on it is a net membership in product.electrical.connectivity's
// vocabulary, and where it sits on the housing is a physical fact beside it. Polarity is then derived
// -- which side's positions are on the supply net and which on ground -- rather than stated.
type HousingPosition {
  terminal: TerminalIdentity
  side: RowSide
  index: Nat
}

type ConnectorHousing {
  component: ComponentInstanceIdentity
  positions: List<HousingPosition>
}

type ConnectorPositionCensus
  = CountedFromPhotograph { positions: Nat, source: NonEmptyStr }
  | MappedOnHousing { housing: ConnectorHousing }

// Polarity is recorded only when the circuit derives, every position has a recorded side, one side's
// positions all lie on the circuit's supply net and the other side's all on its ground net.
type PolarityReading
  = PolarityRecorded { supply_side: RowSide, ground_side: RowSide }
  | PolarityUnrecorded { reason: NonEmptyStr }

// THE MEASURED CIRCUIT: the part of one board's connectivity a multimeter has established, unpowered,
// as raw continuity readings over component terminals (product.electrical.continuity), the anchors
// that name the nets they derive, and raw diode-mode readings. A diode reading names the terminals the
// probes touched -- red and black when recorded, the pair alone when not -- and orientation is derived:
// in diode mode the red probe is positive, so a forward reading with red on X and black on Y puts an
// anode on X's net and a cathode on Y's. Where a probe's exact terminal on a net is unrecorded, a
// terminal of that net stands for it; the net's terminals are joined, so the choice carries no
// information and is never read as one. input_supply and ground are the two nets the circuit was read
// to establish. The circuit binds to the physical asset it was read on, so it cannot describe another
// carrier.
type MeterDisplay
  = ForwardMillivolts { millivolts: Nat }
  | OverLimit

type ProbePlacement
  = RedBlack { red: ElectricalTerminalRef, black: ElectricalTerminalRef }
  | PlacementUnrecorded { between: List<ElectricalTerminalRef> }

type DiodeModeReading {
  probes: ProbePlacement
  display: MeterDisplay
}

type MeasuredCircuit {
  asset: PhysicalAssetIdentity
  read_on: NonEmptyStr
  conditions: NonEmptyStr
  readings: List<ContinuityReading>
  anchors: List<NetAnchor>
  input_supply: NetIdentity
  ground: NetIdentity
  diode_readings: List<DiodeModeReading>
}

type JunctionOrientation
  = CathodeOn { cathode_net: NetIdentity, anode_net: NetIdentity }
  | OrientationUnread

// A connector family read off one housing, and which unit it was read on.
type ConnectorFamilyCandidate {
  row: ConnectorComponentRow
  marking_read: NonEmptyStr
  read_on_unit: NonEmptyStr
}

type ConnectorCensus
  = CensusComplete { count: Nat, family: NonEmptyStr }
  | CensusPartial { counted_at_least: Nat, obligation: NonEmptyStr, family_candidate: ConnectorFamilyCandidate? }

// HOW MUCH OF THE BOARD THE MANAGEMENT-I/O READING COVERS. An absence ("no RJ45, no console header")
// is a reading only of a board photographed whole; close-ups of parts of a board establish what they
// show and nothing about what lies outside them.
type ManagementIoSurvey
  = WholeBoardPhotographed
  | PartlyPhotographed { not_covered: NonEmptyStr }

type CarrierLayoutObservation {
  labels: List<NonEmptyStr>
  module_receptacles: List<NonEmptyStr>
  grey_edge_connectors: NonEmptyStr
  j20_connector: NonEmptyStr
  j20: ConnectorPositionCensus
  circuit: MeasuredCircuit?
  edge_high_speed_connectors: ConnectorCensus
  management_io_survey: ManagementIoSurvey
  management_io_observed: List<NonEmptyStr>
  power_components: List<ObservedComponent>
  identified_signal_parts: List<IdentifiedSignalPart>
  unresolved_parts: List<NonEmptyStr>
}

// One housing's marking, read from an operator photograph 2026-10-15. Which of the two received
// carriers it was photographed on was not recorded, so each observation carries it as a candidate for
// its own housings, never as a reading of them.
data operator_carrier_edge_family: ConnectorFamilyCandidate = ConnectorFamilyCandidate {
  row: g97v22332hr,
  marking_read: "G97V22332HR / 2248 / Amphenol",
  read_on_unit: "one of the operator's two carriers; which one was not recorded",
}

// ── THE MEASURED CIRCUIT AND ITS DEDUCTIONS ──────────────────────────────────────────────────

fn circuit_netlist(c: MeasuredCircuit) -> NetlistDerivation {
  derive_measured_netlist(readings: c.readings, anchors: c.anchors)
}

fn terminal_among(ts: List<ElectricalTerminalRef>, t: ElectricalTerminalRef) -> Bool {
  any(ts, m => terminal_ref_equal(a: m, b: t))
}

fn probe_terminals(p: ProbePlacement) -> List<ElectricalTerminalRef> {
  match p {
    RedBlack { red, black } => [red, black]
    PlacementUnrecorded { between } => between
  }
}

// The diode readings taken across a part: those whose every probe point is one of the part's terminals.
fn readings_across(c: MeasuredCircuit, terminals: List<ElectricalTerminalRef>) -> List<DiodeModeReading> {
  filter(c.diode_readings, r => all(probe_terminals(p: r.probes), t => terminal_among(ts: terminals, t: t)))
}

fn reading_orientation(nl: MeasuredNetlist, r: DiodeModeReading) -> JunctionOrientation {
  match r.display {
    OverLimit => OrientationUnread
    ForwardMillivolts { millivolts: _ } => match r.probes {
      PlacementUnrecorded { between: _ } => OrientationUnread
      RedBlack { red, black } => match measured_net_of(netlist: nl, t: red) {
        Absent => OrientationUnread
        Present { value: anode } => match measured_net_of(netlist: nl, t: black) {
          Absent => OrientationUnread
          Present { value: cathode } => CathodeOn { cathode_net: cathode, anode_net: anode }
        }
      }
    }
  }
}

fn is_oriented(o: JunctionOrientation) -> Bool {
  match o {
    CathodeOn { cathode_net: _, anode_net: _ } => true
    OrientationUnread => false
  }
}

// The orientation the raw readings across a part establish, if any reading establishes one.
fn part_orientation(c: MeasuredCircuit, terminals: List<ElectricalTerminalRef>) -> JunctionOrientation {
  match circuit_netlist(c: c) {
    NetlistRefused { cause: _ } => OrientationUnread
    NetlistDerived { netlist: nl } => match filter(map(readings_across(c: c, terminals: terminals), r => reading_orientation(nl: nl, r: r)), o => is_oriented(o: o)).first() {
      Absent => OrientationUnread
      Present { value: o } => o
    }
  }
}

fn probe_text(p: ProbePlacement) -> String {
  match p {
    RedBlack { red, black } => join(["red on '", terminal_text(t: red), "', black on '", terminal_text(t: black), "'"], "")
    PlacementUnrecorded { between } => join(["across ", join(map(between, t => join(["'", terminal_text(t: t), "'"], "")), " and "), " with probe placement unrecorded"], "")
  }
}

fn display_text(d: MeterDisplay) -> String {
  match d {
    ForwardMillivolts { millivolts: mv } => join([to_string(mv), " mV"], "")
    OverLimit => "over limit (open)"
  }
}

fn reading_text(r: DiodeModeReading) -> String {
  join([probe_text(p: r.probes), ": ", display_text(d: r.display)], "")
}

fn junction_text(c: MeasuredCircuit, terminals: List<ElectricalTerminalRef>) -> String {
  let rs = readings_across(c: c, terminals: terminals)
  match rs.first() {
    Absent => "no diode-mode reading across these terminals"
    Present { value: _ } => join([
      "diode mode: ", join(map(rs, r => reading_text(r: r)), "; "),
      if count(rs) == 1 { "; the reverse direction was not read" } else { "" },
      match part_orientation(c: c, terminals: terminals) {
        CathodeOn { cathode_net: k, anode_net: _ } => join(["; cathode on net '", net_local_label(n: k) as String, "'"], "")
        OrientationUnread => "; orientation not established"
      },
    ], "")
  }
}

fn quoted_terminals(ts: List<ElectricalTerminalRef>) -> String {
  join(map(ts, t => join(["'", terminal_text(t: t), "'"], "")), ", ")
}

// THE DEDUCTION. A part every one of whose positive terminals is on the circuit's supply net, and every
// one of whose return terminals is on its ground net, is across that input; the evidence is rendered
// from the circuit itself, raw diode readings included. A circuit whose readings contradict each other
// places nothing, and any part the circuit does not place keeps the membership it would have without it.
fn membership_by_circuit(c: MeasuredCircuit, positives: List<ElectricalTerminalRef>, returns: List<ElectricalTerminalRef>, otherwise: PathMembership) -> PathMembership {
  match circuit_netlist(c: c) {
    NetlistRefused { cause: _ } => otherwise
    NetlistDerived { netlist: nl } => {
      let placed = count(positives) > 0 && count(returns) > 0
        && all(positives, t => on_measured_net(netlist: nl, t: t, net: c.input_supply))
        && all(returns, t => on_measured_net(netlist: nl, t: t, net: c.ground))
      if placed {
        RatingAcrossInputRail { evidence: join([
          "measured circuit on asset ", c.asset as String, " (", c.read_on as String, ", ", c.conditions as String, "): ",
          quoted_terminals(ts: positives), " on net '", net_local_label(n: c.input_supply) as String, "', ",
          quoted_terminals(ts: returns), " on net '", net_local_label(n: c.ground) as String, "'; ",
          junction_text(c: c, terminals: concat(positives, returns)),
        ], "") as NonEmptyStr }
      } else { otherwise }
    }
  }
}

