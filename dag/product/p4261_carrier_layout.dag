// GH200-3 (2026-10-04). THE P4261 CARRIER AS OBSERVED, AND WHAT CAN BE DEDUCED FROM IT. No NVIDIA
// document names this board, so everything here is the operator's observation of a physical unit,
// kept in the product layer (DESIGN section 3: observations are receipts downstream, never upstream
// facts). What IS upstream -- a part's datasheet specification once its marking is matched -- lives in
// extdeps.electronic_component and extdeps.connector and is consumed here.
//
// GH200-P10 (2026-10-16, review of gunbc#14070): ONE TYPED AUTHORITY. Each carrier is an
// ElectricalDesignIdentity bound to its physical asset; its parts are ComponentInstanceIdentity values
// and their pads ElectricalTerminalRef values (product.electrical.connectivity). Bench readings are
// terminal-to-terminal receipts (product.electrical.continuity), and polarity, placement across the
// input and the voltage bound are derived from them with typed causes, explicit Unestablished and
// Contradicted standings, and the grade of their evidence: a reading whose second probe point is
// inferred from the operator's words is kept and typed as such, and every derivation resting on one
// says so. Strings below are transcriptions of what was printed or said, obligations, hypotheses, or
// renderer output; no deduction reads them.

// ── IDENTIFICATION ────────────────────────────────────────────────────────────────────────────
//
//   IdentifiedByMarking      the marking matches one maker's table, so the part's specification is cited
//   MarkingSharedByMakers    the marking matches one code in several makers' tables and the maker is not
//                            identified: a property counts only where every candidate supports it
//   RatingPrintedOnBody      the part prints its own rating; no datasheet, and no decoding either
//   ResistanceCodeRead       a resistance code, read and decoded
//   MarkingUnresolved        the marking is read (or unread) and NOT decoded; it contributes nothing
//   FootprintUnpopulated     a footprint with no part on it
//
// Each reading of a marking carries its own receipt, so a part never inherits another's identity by
// sitting nearby or looking alike.

type MarkingReading {
  text: NonEmptyStr
  evidence: EvidenceRef
}

type PrintedRating = PrintedFuseRating { current: Ampere, interrupt_voltage: Volt? }

type ComponentIdentification
  = IdentifiedByMarking { row: ElectronicComponentRow, marking: MarkingReading }
  | MarkingSharedByMakers { rows: List<ElectronicComponentRow>, marking: MarkingReading }
  | RatingPrintedOnBody { rating: PrintedRating, marking: MarkingReading }
  | ResistanceCodeRead { milliohms: Nat, marking: MarkingReading }
  | MarkingUnresolved { marking: MarkingReading?, discriminator: NonEmptyStr }
  | FootprintUnpopulated { evidence: EvidenceRef }

type InstalledComponent {
  component: ComponentInstanceIdentity
  terminals: List<TerminalIdentity>
  identification: ComponentIdentification
}

fn names(ns: List<NonEmptyStr>) -> List<TerminalIdentity> {
  map(ns, n => n as TerminalIdentity)
}

fn withstand_kind_key(k: VoltageWithstandKind) -> Nat {
  match k {
    TvsReverseStandoff => 0
    CapacitorRatedVoltage => 1
    DrainSourceMaximum => 2
    FuseInterruptRating => 3
  }
}

fn withstand_list(rows: List<ElectronicComponentRow>) -> List<VoltageWithstand> {
  flat_map(rows, r => match voltage_withstand(spec: r.specification) {
    Absent => []
    Present { value: w } => [w]
  })
}

fn highest_withstand(ws: List<VoltageWithstand>, w0: VoltageWithstand) -> VoltageWithstand {
  fold(ws, init: w0, f: (acc, w) => if volt_count(v: w.maximum) > volt_count(v: acc.maximum) { w } else { acc })
}

// THE PROPERTY EVERY CANDIDATE SUPPORTS. The installed part is one of the candidates, so a voltage limit
// holds for it only if it holds for all of them: they must agree on the kind of limit, and the limit
// carried is the HIGHEST candidate figure -- the rail stays below the installed part's figure, which is
// at most that. (The first revision carried the lowest, which a higher-rated installed candidate would
// falsify.) Candidates of different kinds support no limit.
fn agreed_withstand(rows: List<ElectronicComponentRow>, ws: List<VoltageWithstand>, w0: VoltageWithstand) -> List<VoltageWithstand> {
  if count(ws) == count(rows) && all(ws, w => withstand_kind_key(k: w.kind) == withstand_kind_key(k: w0.kind)) { [highest_withstand(ws: ws, w0: w0)] } else { [] }
}

fn shared_withstand(rows: List<ElectronicComponentRow>) -> VoltageWithstand? {
  let ws = withstand_list(rows: rows)
  match ws.first() {
    Absent => Absent
    Present { value: w0 } => agreed_withstand(rows: rows, ws: ws, w0: w0).first()
  }
}

fn identified_withstand(i: ComponentIdentification) -> VoltageWithstand? {
  match i {
    IdentifiedByMarking { row, marking: _ } => voltage_withstand(spec: row.specification)
    MarkingSharedByMakers { rows, marking: _ } => shared_withstand(rows: rows)
    RatingPrintedOnBody { rating, marking: _ } => match rating {
      PrintedFuseRating { current: _, interrupt_voltage } => match interrupt_voltage {
        Absent => Absent
        Present { value: v } => Present { value: VoltageWithstand { kind: FuseInterruptRating, maximum: v } }
      }
    }
    ResistanceCodeRead { milliohms: _, marking: _ } => Absent
    MarkingUnresolved { marking: _, discriminator: _ } => Absent
    FootprintUnpopulated { evidence: _ } => Absent
  }
}

// ── CONNECTOR HOUSINGS ────────────────────────────────────────────────────────────────────────

// WHICH PHYSICAL ROW, against a reference anyone can find on the housing: the latch. A row swap reverses
// polarity, so a position whose side was not recorded is never assumed.
type RowSide
  = LatchSide
  | AwayFromLatch
  | SideUnrecorded

type HousingPosition {
  terminal: TerminalIdentity
  side: RowSide
  index: Nat
}

// A connector's contact inventory: each position is a terminal of the connector's component instance,
// so its count is the inventory's length and nothing else, and the sides carry their own receipt.
type ConnectorHousing {
  component: ComponentInstanceIdentity
  positions: List<HousingPosition>
  sides_evidence: EvidenceRef
}

type ConnectorPositionCensus
  = CountedFromPhotograph { positions: Nat, evidence: EvidenceRef }
  | MappedOnHousing { housing: ConnectorHousing }

// A caliper span across a row of cavities: so many pitches plus so many cavity widths.
type CaliperAxis
  = AlongRow
  | AcrossRows

type CaliperSpan {
  axis: CaliperAxis
  measured: Micrometer
  pitches: Nat
  cavities: Nat
  evidence: EvidenceRef
}

// ── BOARD MARKINGS AND SURVEYS ────────────────────────────────────────────────────────────────

type BoardMarking
  = AssemblyLabel { model: NonEmptyStr, part_number: NonEmptyStr, revision: NonEmptyStr, serial: NonEmptyStr, evidence: EvidenceRef }
  | PcbCode { code: NonEmptyStr, printed_beside: NonEmptyStr?, evidence: EvidenceRef }
  | RevisionSticker { revision: NonEmptyStr, serial: NonEmptyStr, evidence: EvidenceRef }
  | FabricationMark { text: NonEmptyStr, evidence: EvidenceRef }

type CavityGrid {
  columns: Nat
  rows: Nat
}

type BackplaneConnectorObservation {
  seen: Nat
  face: CavityGrid?
  guide_pin_seen: Bool
  power_blade_seen: Bool
  evidence: EvidenceRef
}

type ReadOnUnit
  = ReadOnAsset { asset: PhysicalAssetIdentity }
  | UnitUnrecorded

type ConnectorFamilyCandidate {
  row: ElectronicComponentRow
  marking: NonEmptyStr
  read_on: ReadOnUnit
}

type ConnectorCensus
  = CensusComplete { count: Nat, family: ElectronicComponentRow }
  | CensusPartial { counted_at_least: Nat, designators_read: List<NonEmptyStr>, family_candidate: ConnectorFamilyCandidate?, obligation: NonEmptyStr }

// HOW MUCH OF THE BOARD THE MANAGEMENT-I/O READING COVERS. An absence ("no RJ45, no console header") is a
// reading only of a board photographed whole; close-ups establish what they show and nothing else.
type ManagementIoSurvey
  = WholeBoardPhotographed
  | PartlyPhotographed { not_covered: NonEmptyStr }

// A receptacle's candidate families stay candidates until a discriminator (part number, contact count
// read, pinout) agrees: dimensions and a marking do not establish a protocol, a generation or a role.
type ReceptacleCandidate
  = UsbMicroB
  | UsbSuperSpeedMicroB

type PlugFit
  = MicroUsbPlugFits
  | PlugFitUntried

type ManagementIoObservation
  = PinHeader { designator: NonEmptyStr?, rows: Nat, columns: Nat, pin_one_marked: Bool, evidence: EvidenceRef }
  | EdgeReceptacle { marking: NonEmptyStr?, opening_widths: List<Micrometer>, plug_fit: PlugFit, candidates: List<ReceptacleCandidate>, evidence: EvidenceRef }
  | FlatCableConnectors { count: Nat, evidence: EvidenceRef }

type UnresolvedPart {
  designator: NonEmptyStr?
  marking: NonEmptyStr?
  obligation: NonEmptyStr
  evidence: EvidenceRef
}

// ── THE MEASURED BOARD AND ITS INPUT ──────────────────────────────────────────────────────────

type MeasuredBoard {
  asset: PhysicalAssetIdentity
  continuity: List<ContinuityObservation>
  diode_readings: List<DiodeModeObservation>
}

// The input under study: a mapped housing and the terminal of the fuse beside it. The fused side is the
// side whose contacts reach that fuse terminal; nothing else about the fuse is assumed.
type InputConnector {
  housing: ConnectorHousing
  fuse_terminal: ElectricalTerminalRef
}

type CarrierLayoutObservation {
  asset: PhysicalAssetIdentity
  design: ElectricalDesignIdentity
  markings: List<BoardMarking>
  module_receptacles: List<NonEmptyStr>
  backplane_connectors: List<BackplaneConnectorObservation>
  j20: ConnectorPositionCensus
  j20_calipers: List<CaliperSpan>
  edge_high_speed_connectors: ConnectorCensus
  management_io_survey: ManagementIoSurvey
  management_io: List<ManagementIoObservation>
  components: List<InstalledComponent>
  measured: MeasuredBoard?
  input: InputConnector?
  unresolved: List<UnresolvedPart>
}

// ── POLARITY ──────────────────────────────────────────────────────────────────────────────────

type PolarityGap
  = SidesUnrecorded
  | NoMeasuredBoard
  | FusedSideNotReached
  | ReturnSideNotJoined
  | IsolationUnread

type InputPolarity
  = PolarityEstablished { fused_side: RowSide, return_side: RowSide, fused: List<ContinuityObservation>, returns: List<ContinuityObservation>, isolation: List<ContinuityObservation> }
  | PolarityContradicted { readings: List<ContinuityObservation> }
  | PolarityUnestablished { gaps: List<PolarityGap> }

fn row_side_code(s: RowSide) -> Nat {
  match s {
    SideUnrecorded => 0
    LatchSide => 1
    AwayFromLatch => 2
  }
}

fn other_side(s: RowSide) -> RowSide {
  match s {
    LatchSide => AwayFromLatch
    AwayFromLatch => LatchSide
    SideUnrecorded => SideUnrecorded
  }
}

fn side_terminals(h: ConnectorHousing, side: RowSide) -> List<ElectricalTerminalRef> {
  map(filter(h.positions, p => row_side_code(s: p.side) == row_side_code(s: side)), p => terminal_ref(component: h.component, terminal: p.terminal))
}

fn board_graph(b: MeasuredBoard) -> ReachabilityGraph {
  reachability_graph(observations: b.continuity, asset: b.asset)
}

fn standings_to(g: ReachabilityGraph, ts: List<ElectricalTerminalRef>, target: ElectricalTerminalRef) -> List<ReachabilityStanding> {
  map(ts, t => reach(g: g, a: t, b: target))
}

fn all_reachable(ss: List<ReachabilityStanding>) -> Bool {
  count(ss) > 0 && all(ss, s => is_reachable(s: s))
}

fn readings_of(ss: List<ReachabilityStanding>) -> List<ContinuityObservation> {
  flat_map(ss, s => supporting_readings(s: s))
}

// Every standing on an established side is reachability into ONE class, whose supporting readings each
// standing carries whole; the first carries them once, where concatenating all would repeat them per
// contact.
fn class_readings(ss: List<ReachabilityStanding>) -> List<ContinuityObservation> {
  match ss.first() {
    Absent => []
    Present { value: s } => supporting_readings(s: s)
  }
}

fn side_reaches_fuse(g: ReachabilityGraph, input: InputConnector, side: RowSide) -> Bool {
  all_reachable(ss: standings_to(g: g, ts: side_terminals(h: input.housing, side: side), target: input.fuse_terminal))
}

fn polarity_gaps(to_fuse: List<ReachabilityStanding>, to_return: List<ReachabilityStanding>, isolation: ReachabilityStanding) -> List<PolarityGap> {
  concat(concat(
    if all_reachable(ss: to_fuse) { [] } else { [FusedSideNotReached] },
    if all_reachable(ss: to_return) { [] } else { [ReturnSideNotJoined] }),
    if is_read_above_threshold(s: isolation) { [] } else { [IsolationUnread] })
}

// The polarity a fused side implies, if the readings establish it: every fused-side contact reaches the
// fuse terminal, every return-side contact reaches the first return-side contact, and the first
// fused-side contact is read silent (above the continuity threshold) to the first return-side one. Any contradicted standing contradicts.
fn polarity_from(g: ReachabilityGraph, input: InputConnector, fused: RowSide, f0: ElectricalTerminalRef, r0: ElectricalTerminalRef) -> InputPolarity {
  let ret = other_side(s: fused)
  let to_fuse = standings_to(g: g, ts: side_terminals(h: input.housing, side: fused), target: input.fuse_terminal)
  let to_return = standings_to(g: g, ts: side_terminals(h: input.housing, side: ret), target: r0)
  let isolation = reach(g: g, a: f0, b: r0)
  let contradicted = filter(concat(concat(to_fuse, to_return), [isolation]), s => is_reachability_contradicted(s: s))
  let gaps = polarity_gaps(to_fuse: to_fuse, to_return: to_return, isolation: isolation)
  match contradicted.first() {
    Present { value: _ } => PolarityContradicted { readings: readings_of(ss: contradicted) }
    Absent => match gaps.first() {
      Present { value: _ } => PolarityUnestablished { gaps: gaps }
      Absent => PolarityEstablished { fused_side: fused, return_side: ret, fused: class_readings(ss: to_fuse), returns: class_readings(ss: to_return), isolation: supporting_readings(s: isolation) }
    }
  }
}

fn polarity_with(g: ReachabilityGraph, input: InputConnector, fused: RowSide) -> InputPolarity {
  match side_terminals(h: input.housing, side: fused).first() {
    Absent => PolarityUnestablished { gaps: [FusedSideNotReached] }
    Present { value: f0 } => match side_terminals(h: input.housing, side: other_side(s: fused)).first() {
      Absent => PolarityUnestablished { gaps: [ReturnSideNotJoined] }
      Present { value: r0 } => polarity_from(g: g, input: input, fused: fused, f0: f0, r0: r0)
    }
  }
}

fn measured_polarity(g: ReachabilityGraph, input: InputConnector) -> InputPolarity {
  if any(input.housing.positions, p => row_side_code(s: p.side) == 0) {
    PolarityUnestablished { gaps: [SidesUnrecorded] }
  } else {
    if side_reaches_fuse(g: g, input: input, side: LatchSide) && !side_reaches_fuse(g: g, input: input, side: AwayFromLatch) {
      polarity_with(g: g, input: input, fused: LatchSide)
    } else {
      polarity_with(g: g, input: input, fused: AwayFromLatch)
    }
  }
}

fn input_polarity(layout: CarrierLayoutObservation) -> InputPolarity {
  match layout.measured {
    Absent => PolarityUnestablished { gaps: [NoMeasuredBoard] }
    Present { value: b } => match layout.input {
      Absent => PolarityUnestablished { gaps: [SidesUnrecorded] }
      Present { value: input } => measured_polarity(g: board_graph(b: b), input: input)
    }
  }
}

fn polarity_grade(p: InputPolarity) -> EvidenceGrade {
  match p {
    PolarityEstablished { fused_side: _, return_side: _, fused, returns, isolation } => evidence_grade(readings: concat(concat(fused, returns), isolation))
    PolarityContradicted { readings } => evidence_grade(readings: readings)
    PolarityUnestablished { gaps: _ } => evidence_grade(readings: [])
  }
}

// ── PLACEMENT ACROSS THE INPUT ────────────────────────────────────────────────────────────────

type TerminalPair {
  a: ElectricalTerminalRef
  b: ElectricalTerminalRef
}

fn component_terminal_refs(c: InstalledComponent) -> List<ElectricalTerminalRef> {
  map(c.terminals, t => terminal_ref(component: c.component, terminal: t))
}

fn pairs_of(ts: List<ElectricalTerminalRef>) -> List<TerminalPair> {
  match ts.first() {
    Absent => []
    Present { value: a } => match filter(ts, t => !terminal_ref_equal(a: t, b: a)).first() {
      Absent => []
      Present { value: b } => if count(ts) == 2 { [TerminalPair { a: a, b: b }] } else { [] }
    }
  }
}

type AcrossGap
  = InputPolarityNotEstablished
  | NotTwoTerminals
  | TerminalsNotPlaced

type AcrossInputStanding
  = AcrossInput { component: ComponentInstanceIdentity, on_fused: ElectricalTerminalRef, on_return: ElectricalTerminalRef, fused_path: List<ContinuityObservation>, return_path: List<ContinuityObservation> }
  | AcrossInputContradicted { component: ComponentInstanceIdentity, readings: List<ContinuityObservation> }
  | AcrossInputUnestablished { component: ComponentInstanceIdentity, gap: AcrossGap }

fn placed_pair(g: ReachabilityGraph, comp: ComponentInstanceIdentity, p: TerminalPair, f0: ElectricalTerminalRef, r0: ElectricalTerminalRef) -> AcrossInputStanding {
  let af = reach(g: g, a: p.a, b: f0)
  let br = reach(g: g, a: p.b, b: r0)
  let bf = reach(g: g, a: p.b, b: f0)
  let ar = reach(g: g, a: p.a, b: r0)
  let contradicted = filter([af, br, bf, ar], s => is_reachability_contradicted(s: s))
  match contradicted.first() {
    Present { value: _ } => AcrossInputContradicted { component: comp, readings: readings_of(ss: contradicted) }
    Absent =>
      if is_reachable(s: af) && is_reachable(s: br) {
        AcrossInput { component: comp, on_fused: p.a, on_return: p.b, fused_path: supporting_readings(s: af), return_path: supporting_readings(s: br) }
      } else {
        if is_reachable(s: bf) && is_reachable(s: ar) {
          AcrossInput { component: comp, on_fused: p.b, on_return: p.a, fused_path: supporting_readings(s: bf), return_path: supporting_readings(s: ar) }
        } else {
          AcrossInputUnestablished { component: comp, gap: TerminalsNotPlaced }
        }
      }
  }
}

fn placed_under(g: ReachabilityGraph, input: InputConnector, c: InstalledComponent, fused: RowSide, ret: RowSide) -> AcrossInputStanding {
  match side_terminals(h: input.housing, side: fused).first() {
    Absent => AcrossInputUnestablished { component: c.component, gap: InputPolarityNotEstablished }
    Present { value: f0 } => match side_terminals(h: input.housing, side: ret).first() {
      Absent => AcrossInputUnestablished { component: c.component, gap: InputPolarityNotEstablished }
      Present { value: r0 } => match pairs_of(ts: component_terminal_refs(c: c)).first() {
        Absent => AcrossInputUnestablished { component: c.component, gap: NotTwoTerminals }
        Present { value: p } => placed_pair(g: g, comp: c.component, p: p, f0: f0, r0: r0)
      }
    }
  }
}

// WHAT EVERY PLACEMENT ON ONE BOARD READS: its reachability graph and its established polarity, derived
// once per layout rather than once per component asked about.
type PlacementBasis
  = PlacementOnPolarity { graph: ReachabilityGraph, input: InputConnector, fused: RowSide, ret: RowSide, readings: List<ContinuityObservation> }
  | NoPlacementBasis

fn placement_basis(layout: CarrierLayoutObservation) -> PlacementBasis {
  match layout.measured {
    Absent => NoPlacementBasis
    Present { value: b } => match layout.input {
      Absent => NoPlacementBasis
      Present { value: input } => {
        let g = board_graph(b: b)
        match measured_polarity(g: g, input: input) {
          PolarityEstablished { fused_side, return_side, fused, returns, isolation } =>
            PlacementOnPolarity { graph: g, input: input, fused: fused_side, ret: return_side, readings: concat(concat(fused, returns), isolation) }
          PolarityContradicted { readings: _ } => NoPlacementBasis
          PolarityUnestablished { gaps: _ } => NoPlacementBasis
        }
      }
    }
  }
}

// A two-terminal part is across the input when one terminal reaches a fused-side contact and the other a
// return-side contact, under an established polarity. Which terminal is which is derived, not stated.
fn placed_on(basis: PlacementBasis, c: InstalledComponent) -> AcrossInputStanding {
  match basis {
    PlacementOnPolarity { graph, input, fused, ret, readings: _ } => placed_under(g: graph, input: input, c: c, fused: fused, ret: ret)
    NoPlacementBasis => AcrossInputUnestablished { component: c.component, gap: InputPolarityNotEstablished }
  }
}

fn across_input(layout: CarrierLayoutObservation, c: InstalledComponent) -> AcrossInputStanding {
  placed_on(basis: placement_basis(layout: layout), c: c)
}

fn is_across(s: AcrossInputStanding) -> Bool {
  match s {
    AcrossInput { component: _, on_fused: _, on_return: _, fused_path: _, return_path: _ } => true
    AcrossInputContradicted { component: _, readings: _ } => false
    AcrossInputUnestablished { component: _, gap: _ } => false
  }
}

fn is_contradicted_placement(s: AcrossInputStanding) -> Bool {
  match s {
    AcrossInput { component: _, on_fused: _, on_return: _, fused_path: _, return_path: _ } => false
    AcrossInputContradicted { component: _, readings: _ } => true
    AcrossInputUnestablished { component: _, gap: _ } => false
  }
}

fn placement_readings(s: AcrossInputStanding) -> List<ContinuityObservation> {
  match s {
    AcrossInput { component: _, on_fused: _, on_return: _, fused_path, return_path } => concat(fused_path, return_path)
    AcrossInputContradicted { component: _, readings } => readings
    AcrossInputUnestablished { component: _, gap: _ } => []
  }
}

// ── THE INPUT VOLTAGE BOUND ───────────────────────────────────────────────────────────────────
//
// A BOUND IS DERIVED ONLY FROM A PART WHOSE LIMIT IS ESTABLISHED ACROSS THE INPUT: the rail would exceed
// that part's limit otherwise. Every other rated part is an observed rating, carried with its placement
// standing and never folded in. (GH200-5, 2026-10-04: adjacency once set a ceiling; a lower-rated part on
// a downstream rail sharing the region would have lowered it, so adjacency never participates.) The
// lowest established limit bounds the rail; parts tying it are carried beside it. The bound carries the
// grade of the readings it rests on, polarity's included. A bound never says what the rail IS.

type InputVoltageUpperBound {
  asset: PhysicalAssetIdentity
  input_connector: ComponentInstanceIdentity
  limiting_component: ComponentInstanceIdentity
  rated: VoltageWithstand
  identification: ComponentIdentification
  placement: AcrossInputStanding
  grade: EvidenceGrade
}

type ObservedRating {
  component: ComponentInstanceIdentity
  identification: ComponentIdentification
  rated: VoltageWithstand
  placement: AcrossInputStanding
}

type InputBoundStanding
  = BoundEstablished { bound: InputVoltageUpperBound, equally_limiting: List<InputVoltageUpperBound>, observed: List<ObservedRating> }
  | BoundContradicted { contradicted: List<ObservedRating>, observed: List<ObservedRating> }
  | BoundUnestablished { observed: List<ObservedRating> }

fn observed_ratings(layout: CarrierLayoutObservation, basis: PlacementBasis) -> List<ObservedRating> {
  flat_map(layout.components, c => match identified_withstand(i: c.identification) {
    Absent => []
    Present { value: w } => [ObservedRating { component: c.component, identification: c.identification, rated: w, placement: placed_on(basis: basis, c: c) }]
  })
}

fn bound_from(layout: CarrierLayoutObservation, input: InputConnector, polarity_readings: List<ContinuityObservation>, o: ObservedRating) -> InputVoltageUpperBound {
  InputVoltageUpperBound {
    asset: layout.asset,
    input_connector: input.housing.component,
    limiting_component: o.component,
    rated: o.rated,
    identification: o.identification,
    placement: o.placement,
    grade: evidence_grade(readings: concat(placement_readings(s: o.placement), polarity_readings)),
  }
}

fn lowest_rating(across: List<ObservedRating>, first: ObservedRating) -> ObservedRating {
  fold(across, init: first, f: (acc, x) => if volt_count(v: x.rated.maximum) < volt_count(v: acc.rated.maximum) { x } else { acc })
}

fn established_bound(layout: CarrierLayoutObservation, input: InputConnector, polarity_readings: List<ContinuityObservation>, across: List<ObservedRating>, first: ObservedRating, observed: List<ObservedRating>) -> InputBoundStanding {
  let lowest = lowest_rating(across: across, first: first)
  let ties = filter(across, x => volt_count(v: x.rated.maximum) == volt_count(v: lowest.rated.maximum) && !component_identity_eq(a: x.component, b: lowest.component))
  BoundEstablished { bound: bound_from(layout: layout, input: input, polarity_readings: polarity_readings, o: lowest), equally_limiting: map(ties, x => bound_from(layout: layout, input: input, polarity_readings: polarity_readings, o: x)), observed: observed }
}

fn input_bound(layout: CarrierLayoutObservation) -> InputBoundStanding {
  let basis = placement_basis(layout: layout)
  let observed = observed_ratings(layout: layout, basis: basis)
  let contradicted = filter(observed, o => is_contradicted_placement(s: o.placement))
  let across = filter(observed, o => is_across(s: o.placement))
  match contradicted.first() {
    Present { value: _ } => BoundContradicted { contradicted: contradicted, observed: observed }
    Absent => match across.first() {
      Absent => BoundUnestablished { observed: observed }
      Present { value: first } => match basis {
        NoPlacementBasis => BoundUnestablished { observed: observed }
        PlacementOnPolarity { graph: _, input, fused: _, ret: _, readings } => established_bound(layout: layout, input: input, polarity_readings: readings, across: across, first: first, observed: observed)
      }
    }
  }
}

// The junction readings across a two-terminal part on its measured board.
fn component_junction(layout: CarrierLayoutObservation, c: InstalledComponent) -> List<JunctionStanding> {
  match layout.measured {
    Absent => []
    Present { value: b } => map(pairs_of(ts: component_terminal_refs(c: c)), p => junction_between(observations: b.diode_readings, asset: b.asset, a: p.a, b: p.b))
  }
}

// ── HYPOTHESES (prose leads, consumed by no deduction) ───────────────────────────────────────

type InvestigationHypothesis {
  claim: NonEmptyStr
  sources: List<NonEmptyStr>
  decided_by: NonEmptyStr
}

data p4261_grey_path_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "the grey blind-mate connectors carry the P4261's main input, and it is a 48-54 V-class bus",
  sources: [
    "the input-stage MOSFETs beside the grey blocks are Infineon IPB017N10N5LF, a 100 V part its vendor presents for hot-swap and e-fuse use and characterizes at VDS=56V (extdeps.electronic_component.infineon_ipb017n10n5lf): consistent with a 48-54 V stage, not a determination of one",
    "the module part number 699-2G530-0215 reads as SKU215, which an uncited earlier NVIDIA guide revision tied to a 54 V module rail (extdeps.systems.nvidia_gh200 gh200_rail_variants): a lead about the module, not the carrier's input",
    "counter-lead: a grey edge connector photographed face-on on the E1 (2026-10-16) shows fine contacts and no power blade",
  ],
  decided_by: "the grey blocks' contacts traced by terminal readings to the input stage, plus the input rating read off the original power-distribution board or harness, the carrier's schematic or vendor documentation, or a measurement of the original system's supply output",
}

data p4261_j20_main_input_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "J20 is the P4261's main input, and the input-stage MOSFETs switch it toward the module",
  sources: [
    "the E1's measured board puts F300 (75 V / 100 A) and the probed input-stage MOSFET's drain -- its tab and pin 4 on the IPB017N10N5LF pinout -- on J20's fused side, with none of that MOSFET's pins reaching ground: a hot-swap stage's shape, read on inferred probe points",
    "J20's nine fused positions on a 3.0 mm-pitch housing could carry a 1 kW module's input current at 48-54 V, where its 12 A F1 could not -- so F1 is either a branch or the input is elsewhere",
  ],
  decided_by: "where the probed MOSFET's sources go: terminal readings from its source pins toward the module receptacles' power contacts",
}

// ── THE K1 UNIT (listing photographs; design p4261-k1-a) ────────────────────────────────────

data k1_design: ElectricalDesignIdentity = "p4261-k1-a" as ElectricalDesignIdentity

data k1_listing: EvidenceRef = SellerListingPhotograph { listing: "eBay item 168742238639", read_on: "2026-10-04" }

data k1_label_photo: EvidenceRef = OperatorPhotograph { taken_on: "2026-10-16", locator: "K1 label photograph sent in the session" }

