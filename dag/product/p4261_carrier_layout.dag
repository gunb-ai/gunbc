}

data polymer_cap_discriminator: NonEmptyStr = "read the rated voltage from the maker's datasheet for the series printed as 'ZU' (or measure the can's diameter and height to find it). 'J' is NOT decoded as 6.3 V: that EIA letter convention belongs to tantalum and some polymer-chip lines, and assuming it here would invent a rating" as NonEmptyStr

// "Rework" beside the PCB code is a printed marking; whether any rework was performed, and what, is
// unknown. The labels read "0000-100" where the listing title says "000-100"; the label is the reading.
data p4261_k1_layout: CarrierLayoutObservation = CarrierLayoutObservation {
  asset: p4261_k1_a,
  design: k1_design,
  markings: [
    AssemblyLabel { model: "P4261", part_number: "694-24261-0000-100", revision: "K1", serial: "1582023110038", evidence: k1_listing },
    AssemblyLabel { model: "P4261", part_number: "694-24261-0000-100", revision: "K1", serial: "1582023110033", evidence: k1_listing },
    AssemblyLabel { model: "P4261", part_number: "694-24261-0000-100", revision: "K1", serial: "1582023110038", evidence: k1_label_photo },
    PcbCode { code: "180-14261-DAAF-A01", printed_beside: Present { value: "Rework" }, evidence: k1_label_photo },
    RevisionSticker { revision: "215-EV1", serial: "1582023110033", evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "the k1 board has the ev1 sticker on it" } },
    FabricationMark { text: "TTM 94V0 RFB1 2923", evidence: k1_listing },
  ],
  module_receptacles: ["J3", "J4"],
  backplane_connectors: [
    BackplaneConnectorObservation { seen: 2, face: Absent, guide_pin_seen: false, power_blade_seen: false, evidence: k1_listing },
  ],
  j20: CountedFromPhotograph { positions: 16, evidence: k1_listing },
  j20_calipers: [],
  edge_high_speed_connectors: CensusPartial {
    counted_at_least: 10,
    designators_read: [],
    family_candidate: Present { value: operator_carrier_edge_family },
    obligation: "confirm the count on this unit and name the family by reading one housing's marking or test-fitting a known MCIO 8i cable unpowered (MCIO SFF-TA-1016 and SlimSAS SFF-8654 do not mate). Leading candidate: vertical 74-contact MCIO, from a close-up whose shell, open top and paired latch windows match Amphenol's published MCIO receptacles (a visual match, no part number read), and ASRock's documented GH200 carrier ARLINGTON-MB uses six MCIO PCIe 5.0 x8 connectors. A 74-contact MCIO is not thereby a PCIe x8 port on P4261: what this board routes through each one is a separate fact. A listing photograph of a P4261 (Central Valley watermark, label reading -DAAF-000 rather than this unit's -A01) shows ten narrow shrouded receptacles. GH200 exposes 64 PCIe Gen5 lanes (whitepaper Table 1), which would fill eight x8 connectors, a consistency check rather than an identification",
  },
  management_io_survey: WholeBoardPhotographed,
  management_io: [
    EdgeReceptacle { marking: Present { value: "Amphenol / 1502" }, opening_widths: [], plug_fit: PlugFitUntried, candidates: [UsbMicroB, UsbSuperSpeedMicroB], evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "Both of the boards have the microusb thing  its an amphenol 1502" } },
    FlatCableConnectors { count: 2, evidence: k1_listing },
  ],
  components: [
    InstalledComponent { component: k1_component(local: "input-stage MOSFET, first of two"), terminals: [], identification: IdentifiedByMarking { row: ipb017n10n5lf, marking: k1_marking(text: "017N10LF, lot line HAL225") } },
    InstalledComponent { component: k1_component(local: "input-stage MOSFET, second of two"), terminals: [], identification: IdentifiedByMarking { row: ipb017n10n5lf, marking: k1_marking(text: "017N10LF") } },
    InstalledComponent { component: k1_component(local: "F300"), terminals: names(ns: ["one end", "other end"]), identification: RatingPrintedOnBody { rating: PrintedFuseRating { current: ampere(count: 100), interrupt_voltage: Present { value: volt(count: 75) } }, marking: k1_marking(text: "75V 100A (leading maker glyph not legible), the body spanning the F300/F302 pads") } },
    InstalledComponent { component: k1_component(local: "input-stage inductor"), terminals: [], identification: MarkingUnresolved { marking: Present { value: k1_marking(text: "A850 / Coilcraft / D") }, discriminator: "look up Coilcraft's part for code A850 and read its current and inductance" } },
    InstalledComponent { component: k1_component(local: "D2"), terminals: names(ns: ["tab nearer J20", "tab farther from J20"]), identification: MarkingUnresolved { marking: Present { value: k1_marking(text: "5P0X / ZCNSU (as read)") }, discriminator: "a sharper photograph of the marking, matched to a diode maker's marking table" } },
    InstalledComponent { component: k1_component(local: "input-stage diode"), terminals: [], identification: MarkingUnresolved { marking: Present { value: k1_marking(text: "5P0X / ZCNSU (as read)") }, discriminator: "a sharper photograph of the marking, matched to a diode maker's marking table" } },
    InstalledComponent { component: k1_component(local: "F1"), terminals: names(ns: ["end nearer J20", "end farther from J20"]), identification: RatingPrintedOnBody { rating: PrintedFuseRating { current: ampere(count: 12), interrupt_voltage: Absent }, marking: k1_marking(text: "12A (leading maker glyph not legible)") } },
    InstalledComponent { component: k1_component(local: "R010 shunt beside F1"), terminals: [], identification: ResistanceCodeRead { milliohms: 10, marking: k1_marking(text: "R010") } },
    InstalledComponent { component: k1_component(local: "R150 above the upper capacitor"), terminals: [], identification: ResistanceCodeRead { milliohms: 150, marking: k1_marking(text: "R150") } },
    InstalledComponent { component: k1_component(local: "R150 below F1"), terminals: [], identification: ResistanceCodeRead { milliohms: 150, marking: k1_marking(text: "R150") } },
    InstalledComponent { component: k1_component(local: "C10_P5"), terminals: names(ns: ["positive", "negative"]), identification: MarkingUnresolved { marking: Present { value: k1_marking(text: "150 / J ZU / 29AH (photographed upside down)") }, discriminator: polymer_cap_discriminator } },
    InstalledComponent { component: k1_component(local: "C12_P5"), terminals: names(ns: ["positive", "negative"]), identification: MarkingUnresolved { marking: Present { value: k1_marking(text: "150 / J ZU / 29AH") }, discriminator: polymer_cap_discriminator } },
    InstalledComponent { component: k1_component(local: "capacitor below J20 by U522"), terminals: [], identification: MarkingUnresolved { marking: Present { value: k1_marking(text: "150 / J ZU / 29AH") }, discriminator: polymer_cap_discriminator } },
  ],
  measured: Absent,
  input: Absent,
  unresolved: [
    UnresolvedPart { designator: Present { value: "U4" }, marking: Absent, obligation: "the one heatsinked device (bottom-centre, below J4): marking hidden under a finned heatsink held by two plastic push-pins, with its own local power stage, so it takes several rails; consistent with an FPGA, a management SoC or a PCIe switch. Read by removing the push-pin heatsink, unpowered, and refitting it with a new pad", evidence: k1_listing },
    UnresolvedPart { designator: Absent, marking: Absent, obligation: "a 2x5 pin header and a small shrouded connector below U4: function unread; candidates for JTAG or a UART console, unconfirmed", evidence: k1_listing },
    UnresolvedPart { designator: Absent, marking: Present { value: "2FA17 / RW186 (two), RW251" }, obligation: "three small BGAs beside U4: two-line marks in Micron's FBGA format, undecoded; a neighbouring code (RW187) is identified elsewhere as Micron serial NOR boot flash, so configuration or firmware flash is the leading reading", evidence: k1_listing },
    UnresolvedPart { designator: Present { value: "U522" }, marking: Absent, obligation: "marking not legible in the listing close-up", evidence: k1_listing },
    UnresolvedPart { designator: Absent, marking: Absent, obligation: "the 28-pin TSSOP below the lower capacitor: marking not legible in the close-up", evidence: k1_listing },
  ],
}

// One housing's marking, read from an operator photograph 2026-10-15; which carrier it was photographed
// on was not recorded, so it is a candidate for each carrier's housings and a reading of neither.
data operator_carrier_edge_family: ConnectorFamilyCandidate = ConnectorFamilyCandidate {
  row: g97v22332hr,
  marking: "G97V22332HR / 2248 / Amphenol",
  read_on: UnitUnrecorded,
}

// ── THE E1 UNIT (bench readings; design p4261-e1-b) ─────────────────────────────────────────

data e1_design: ElectricalDesignIdentity = "p4261-e1-b" as ElectricalDesignIdentity

data e1_bench: BenchConditions = BenchConditions { power: Unpowered, module: ModuleRemoved }

fn e1_component(local: NonEmptyStr) -> ComponentInstanceIdentity {
  component_instance_identity(design: e1_design, local_identity: local)
}

fn e1_photo(taken_on: NonEmptyStr, locator: NonEmptyStr) -> EvidenceRef {
  OperatorPhotograph { taken_on: taken_on, locator: locator }
}

data e1_j20: ComponentInstanceIdentity = e1_component(local: "J20")
data e1_f1: ComponentInstanceIdentity = e1_component(local: "F1")
data e1_f300: ComponentInstanceIdentity = e1_component(local: "F300")
data e1_f302: ComponentInstanceIdentity = e1_component(local: "F302")
data e1_d2: ComponentInstanceIdentity = e1_component(local: "D2")
data e1_d5: ComponentInstanceIdentity = e1_component(local: "D5")
data e1_c10: ComponentInstanceIdentity = e1_component(local: "C10_P5")
data e1_c12: ComponentInstanceIdentity = e1_component(local: "C12_P5")
data e1_third_can: ComponentInstanceIdentity = e1_component(local: "capacitor below J20 by U522")
data e1_input_fet: ComponentInstanceIdentity = e1_component(local: "input-stage MOSFET probed 2026-10-16 (designator unread)")

// J20'S EIGHTEEN POSITIONS. The index runs from the end the operator called pin 1 (2026-10-15, top left
// as photographed, on the row away from the latch); the latch-side row is indexed the same way. Which
// end is the connector maker's pin 1 is unread.
data j20_row_indices: List<Nat> = [1, 2, 3, 4, 5, 6, 7, 8, 9]

fn j20_row_name(side: RowSide) -> String {
  match side {
    LatchSide => "latch-side row"
    AwayFromLatch => "row away from the latch"
    SideUnrecorded => "row of unrecorded side"
  }
}

fn j20_position_terminal(side: RowSide, index: Nat) -> TerminalIdentity {
  (join([j20_row_name(side: side), ", position ", to_string(index)], "") as NonEmptyStr) as TerminalIdentity
}

fn j20_row(side: RowSide) -> List<HousingPosition> {
  map(j20_row_indices, i => HousingPosition { terminal: j20_position_terminal(side: side, index: i), side: side, index: i })
}

data e1_j20_housing: ConnectorHousing = ConnectorHousing {
  component: e1_j20,
  positions: concat(j20_row(side: LatchSide), j20_row(side: AwayFromLatch)),
  sides_evidence: e1_photo(taken_on: "2026-10-16", locator: "J20 photograph annotated RAIL (row by F1 and D2) and GROUND (latch-side row), sent in the session"),
}

fn e1_terminal(c: ComponentInstanceIdentity, name: NonEmptyStr) -> ElectricalTerminalRef {
  terminal_ref(component: c, terminal: name as TerminalIdentity)
}

fn e1_j20_at(side: RowSide, index: Nat) -> ElectricalTerminalRef {
  terminal_ref(component: e1_j20, terminal: j20_position_terminal(side: side, index: index))
}

// The two reference contacts the operator's "power" and "ground" stand for.
data e1_rail_ref: ElectricalTerminalRef = e1_j20_at(side: AwayFromLatch, index: 1)
data e1_ground_ref: ElectricalTerminalRef = e1_j20_at(side: LatchSide, index: 1)

data e1_f1_near: ElectricalTerminalRef = e1_terminal(c: e1_f1, name: "end nearer J20")
data e1_f1_far: ElectricalTerminalRef = e1_terminal(c: e1_f1, name: "end farther from J20")
data e1_f300_one: ElectricalTerminalRef = e1_terminal(c: e1_f300, name: "one end")
data e1_f300_other: ElectricalTerminalRef = e1_terminal(c: e1_f300, name: "other end")
data e1_f302_one: ElectricalTerminalRef = e1_terminal(c: e1_f302, name: "one pad")
data e1_f302_other: ElectricalTerminalRef = e1_terminal(c: e1_f302, name: "other pad")
data e1_d2_near: ElectricalTerminalRef = e1_terminal(c: e1_d2, name: "tab nearer J20")
data e1_d2_far: ElectricalTerminalRef = e1_terminal(c: e1_d2, name: "tab farther from J20")
data e1_d5_top: ElectricalTerminalRef = e1_terminal(c: e1_d5, name: "top tab")
data e1_d5_bottom: ElectricalTerminalRef = e1_terminal(c: e1_d5, name: "bottom tab")
data e1_c10_pos: ElectricalTerminalRef = e1_terminal(c: e1_c10, name: "positive")
data e1_c10_neg: ElectricalTerminalRef = e1_terminal(c: e1_c10, name: "negative")
data e1_c12_pos: ElectricalTerminalRef = e1_terminal(c: e1_c12, name: "positive")
data e1_c12_neg: ElectricalTerminalRef = e1_terminal(c: e1_c12, name: "negative")

data e1_fet_terminal_names: List<NonEmptyStr> = ["pin 1", "pin 2", "pin 3", "pin 4", "pin 5", "pin 6", "pin 7", "tab"]
data e1_fet_off_rail: List<NonEmptyStr> = ["pin 1", "pin 2", "pin 3", "pin 5", "pin 6", "pin 7"]

// THE INFERENCES. "Ground" in the operator's readings is J20's latch-side row: they named that row ground
// first (2026-10-15, "the entire bottom row is ground"), and the annotated photograph puts it on the latch
// side. "Power" / "rail" is the row away from the latch, the nine positions read to both ends of F1. Which
// point of each row the probe touched is unrecorded; position 1 stands for it.
data e1_ground_basis: NonEmptyStr = "the operator's 'ground' is J20's latch-side row (2026-10-15 'the entire bottom row is ground'; the annotated photograph's GROUND row); the point on it is unrecorded and position 1 stands for it"
data e1_rail_basis: NonEmptyStr = "the operator's 'power' / 'rail' is J20's fused row away from the latch (2026-10-15 'all 9 on top are joined to the fuse'; the annotated photograph's RAIL row); the point on it is unrecorded and position 1 stands for it"
data e1_row_basis: NonEmptyStr = "'the entire bottom row is ground': each latch-side position beeps to the operator's ground reference, taken as the same row's position 1"

// POPULATION STATEMENTS NAME NO EXACT FIRST POINT. "Everything I touched", "only the big tab and the very
// middle pin" and "nothing seems to be connected to ground" cover visible terminals without saying which
// were probed; each terminal the statement covers stands for a touch, inferred with that basis.
data e1_touched_basis: NonEmptyStr = "'everything i touched had continuity to power' (F300, F302): which points were touched is unrecorded; the named parts' two visible terminals each stand for a touch"
data e1_middle_pin_basis: NonEmptyStr = "'the very middle little small pin': the middle of the MOSFET's seven leads, which the IPB017N10N5LF pinout numbers pin 4; the number is read off the lead geometry, not off the board"
data e1_only_basis: NonEmptyStr = "'only the BIG tab and the very middle little small pin are connected to rail power': whether each other lead was touched is unrecorded; 'only' is taken to cover every visible lead"
data e1_nothing_basis: NonEmptyStr = "'nothing seems to be connected to ground': whether each lead and the tab were touched is unrecorded; 'nothing' is taken to cover every visible terminal"

fn touched_to(a: ElectricalTerminalRef, reference: ElectricalTerminalRef, first_basis: NonEmptyStr, second_basis: NonEmptyStr, result: ContinuityResult, evidence: EvidenceRef) -> ContinuityObservation {
  e1_read(a: a, b: reference, record: both_points_inferred(first_basis: first_basis, second_basis: second_basis), result: result, evidence: evidence)
}

fn e1_read(a: ElectricalTerminalRef, b: ElectricalTerminalRef, record: ProbeRecord, result: ContinuityResult, evidence: EvidenceRef) -> ContinuityObservation {
  ContinuityObservation { asset: p4261_e1_b, first: a, second: b, record: record, conditions: e1_bench, result: result, evidence: evidence }
}

fn to_ground(a: ElectricalTerminalRef, result: ContinuityResult, evidence: EvidenceRef) -> ContinuityObservation {
  e1_read(a: a, b: e1_ground_ref, record: second_point_inferred(basis: e1_ground_basis), result: result, evidence: evidence)
}

fn to_rail(a: ElectricalTerminalRef, result: ContinuityResult, evidence: EvidenceRef) -> ContinuityObservation {
  e1_read(a: a, b: e1_rail_ref, record: second_point_inferred(basis: e1_rail_basis), result: result, evidence: evidence)
}

data e1_fuse_ends_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-15", verbatim: "regarding the 'which end of the fuse' the 9 supply pins beep to both ends of the fuse" }
data e1_bottom_row_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-15", verbatim: "the entire bottom row is ground" }
data e1_d2_tabs_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-15", verbatim: "regarding the tabs - D2 closer to J20 is connected to power, the farther tab is connected to ground (near the grounded cap terminals)" }
data e1_caps_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-15", verbatim: "J20 supply did not seem to connect to the caps like that" }
data e1_d5_tabs_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-16", verbatim: "the top of D5 is connected to ground, the bottom is connected to power rail and everything else" }
data e1_fuses_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-16", verbatim: "F200 seems to be connected mostly to the rail, not ground, same with F302 - everything i touched had continuity to power / yeah F300 mb" }
data e1_fet_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-16", verbatim: "only the BIG tab and the very middle little small  pin are conneted to rail power, nothing seems to be connected to ground" }

fn fet_terminal(name: NonEmptyStr) -> ElectricalTerminalRef {
  e1_terminal(c: e1_input_fet, name: name)
}

data e1_measured: MeasuredBoard = MeasuredBoard {
  asset: p4261_e1_b,
  continuity: concat(concat(concat(concat(
    // each fused-row position to both ends of F1: both points named
    map(j20_row_indices, i => e1_read(a: e1_j20_at(side: AwayFromLatch, index: i), b: e1_f1_near, record: both_points_recorded, result: BuzzerAsserted, evidence: e1_fuse_ends_said)),
    map(j20_row_indices, i => e1_read(a: e1_j20_at(side: AwayFromLatch, index: i), b: e1_f1_far, record: both_points_recorded, result: BuzzerAsserted, evidence: e1_fuse_ends_said))),
    // each latch-side position to the row's ground reference
    map(filter(j20_row_indices, i => i > 1), i => e1_read(a: e1_j20_at(side: LatchSide, index: i), b: e1_ground_ref, record: second_point_inferred(basis: e1_row_basis), result: BuzzerAsserted, evidence: e1_bottom_row_said))),
    [
      to_rail(a: e1_d2_near, result: BuzzerAsserted, evidence: e1_d2_tabs_said),
      to_ground(a: e1_d2_far, result: BuzzerAsserted, evidence: e1_d2_tabs_said),
      to_ground(a: e1_c10_neg, result: BuzzerAsserted, evidence: e1_d2_tabs_said),
      to_ground(a: e1_c12_neg, result: BuzzerAsserted, evidence: e1_d2_tabs_said),
      to_rail(a: e1_c10_pos, result: BuzzerNotAsserted, evidence: e1_caps_said),
      to_rail(a: e1_c12_pos, result: BuzzerNotAsserted, evidence: e1_caps_said),
      to_ground(a: e1_d5_top, result: BuzzerAsserted, evidence: e1_d5_tabs_said),
      to_rail(a: e1_d5_bottom, result: BuzzerAsserted, evidence: e1_d5_tabs_said),
      touched_to(a: e1_f300_one, reference: e1_rail_ref, first_basis: e1_touched_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f300_other, reference: e1_rail_ref, first_basis: e1_touched_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f300_one, reference: e1_ground_ref, first_basis: e1_touched_basis, second_basis: e1_ground_basis, result: BuzzerNotAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f300_other, reference: e1_ground_ref, first_basis: e1_touched_basis, second_basis: e1_ground_basis, result: BuzzerNotAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f302_one, reference: e1_rail_ref, first_basis: e1_touched_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fuses_said),
      touched_to(a: e1_f302_other, reference: e1_rail_ref, first_basis: e1_touched_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fuses_said),
    ]),
    // the probed input-stage MOSFET: the named tab and the middle lead (pin 4) to the rail; the other
    // leads silent to the rail, and every terminal silent to ground, inferred over the population named
    concat(concat(
      [
        to_rail(a: fet_terminal(name: "tab"), result: BuzzerAsserted, evidence: e1_fet_said),
        touched_to(a: fet_terminal(name: "pin 4"), reference: e1_rail_ref, first_basis: e1_middle_pin_basis, second_basis: e1_rail_basis, result: BuzzerAsserted, evidence: e1_fet_said),
      ],
      map(e1_fet_off_rail, n => touched_to(a: fet_terminal(name: n), reference: e1_rail_ref, first_basis: e1_only_basis, second_basis: e1_rail_basis, result: BuzzerNotAsserted, evidence: e1_fet_said))),
      map(e1_fet_terminal_names, n => touched_to(a: fet_terminal(name: n), reference: e1_ground_ref, first_basis: e1_nothing_basis, second_basis: e1_ground_basis, result: BuzzerNotAsserted, evidence: e1_fet_said)))),
  diode_readings: [
    DiodeModeObservation { asset: p4261_e1_b, probes: RedBlack { red: e1_d2_far, black: e1_d2_near }, display: ForwardMillivolts { millivolts: 600 }, conditions: e1_bench, evidence: OperatorStatement { stated_on: "2026-10-15", verbatim: "yeah putting the red on the ground of the diode and black on the supply reads .6" } },
    DiodeModeObservation { asset: p4261_e1_b, probes: RedBlack { red: e1_d5_top, black: e1_d5_bottom }, display: ForwardMillivolts { millivolts: 605 }, conditions: e1_bench, evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "diode reading on D5 gives .605 / yes red was on top" } },
  ],
}

data e1_input: InputConnector = InputConnector { housing: e1_j20_housing, fuse_terminal: e1_f1_near }

data e1_shared_tvs_rows: List<ElectronicComponentRow> = [tvs_5_0smdj60a, aos_tvs_5_0smdj60a]

data p4261_e1_layout: CarrierLayoutObservation = CarrierLayoutObservation {
  asset: p4261_e1_b,
  design: e1_design,
  markings: [
    AssemblyLabel { model: "P4261", part_number: "694-24261-0000-201", revision: "E1", serial: "1583323120274", evidence: e1_photo(taken_on: "2026-10-16", locator: "E1 label photograph sent in the session") },
    PcbCode { code: "180-14261-DAAF-B00", printed_beside: Absent, evidence: e1_photo(taken_on: "2026-10-16", locator: "E1 label photograph sent in the session") },
  ],
  module_receptacles: [],
  backplane_connectors: [
    BackplaneConnectorObservation { seen: 1, face: Present { value: CavityGrid { columns: 9, rows: 4 } }, guide_pin_seen: true, power_blade_seen: false, evidence: e1_photo(taken_on: "2026-10-16", locator: "grey edge connector photographed face-on, sent in the session") },
  ],
  j20: MappedOnHousing { housing: e1_j20_housing },
  j20_calipers: [
    CaliperSpan { axis: AlongRow, measured: micrometer(count: 26320), pitches: 8, cavities: 1, evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "inner left wall of first pin - outer right wall of right pin: 26.32mm" } },
    CaliperSpan { axis: AcrossRows, measured: micrometer(count: 5270), pitches: 1, cavities: 1, evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "top inner wall of 9th pin to bottom inner wall of ground 9th pin: 5.27mm" } },
  ],
  edge_high_speed_connectors: CensusPartial {
    counted_at_least: 2,
    designators_read: ["J11"],
    family_candidate: Present { value: operator_carrier_edge_family },
    obligation: "count the rest, read their J-numbers and one housing's marking on this unit",
  },
  management_io_survey: PartlyPhotographed { not_covered: "the board has been photographed only in close-ups (J20 and its parts, F300, U522, the label area, one grey connector, one edge receptacle); its other edges and the region around U4 are unphotographed" },
  management_io: [
    PinHeader { designator: Present { value: "J620" }, rows: 2, columns: 5, pin_one_marked: true, evidence: e1_photo(taken_on: "2026-10-16", locator: "E1 label photograph sent in the session") },
    EdgeReceptacle { marking: Present { value: "Amphenol / 1502" }, opening_widths: [micrometer(count: 7000), micrometer(count: 5000)], plug_fit: MicroUsbPlugFits, candidates: [UsbSuperSpeedMicroB], evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "one side is ~5mm and the other (micro usb) is ~7mm" } },
