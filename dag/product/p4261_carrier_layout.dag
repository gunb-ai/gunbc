    family_candidate: Present { value: operator_carrier_edge_family },
  },
  management_io_survey: PartlyPhotographed { not_covered: "the board has been photographed only in close-ups (J20, its fuse and capacitors, D2, U522, the sticker area); its other edges and the region around U4 are unphotographed" },
  management_io_observed: [
    "J620, a 2 x 5 pin header beside U78-U81 (2026-10-16 label photograph), one position marked with a white square, which reads as pin 1: function and pinout unread; a candidate for a debug, JTAG or UART header, unconfirmed",
