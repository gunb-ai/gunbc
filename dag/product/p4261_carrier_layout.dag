    InstalledComponent { component: e1_u43_resistor, terminals: names(ns: ["upper end", "lower end"]), identification: MarkingUnresolved { marking: Absent, discriminator: "read its marking; both ends read about 500 ohm from Q300's lead b, so it is in the chain, not across it" } },
    InstalledComponent { component: e1_u43_capacitor, terminals: names(ns: ["end nearer U43", "end farther from U43"]), identification: MarkingUnresolved { marking: Absent, discriminator: "an unmarked capacitor at U43's right; read it out of circuit or from the board's documentation" } },
    InstalledComponent { component: e1_u500_upper_part, terminals: names(ns: ["upper pad", "lower pad"]), identification: MarkingUnresolved { marking: Absent, discriminator: "read its marking; its lower pad's trace runs to U500's upper-right contact" } },
    InstalledComponent { component: e1_j3, terminals: [], identification: MarkingUnresolved { marking: Absent, discriminator: "the module receptacle at one end of the site; its contact count and maker from the board's documentation or the connector's own marking" } },
    InstalledComponent { component: e1_j4, terminals: [], identification: MarkingUnresolved { marking: Absent, discriminator: "the module receptacle at the other end of the site, beside H2 and U4" } },
    InstalledComponent { component: e1_u3, terminals: names(ns: e1_u3_leads), identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "B5 and more (partly legible)", evidence: e1_u3_photo } }, discriminator: "a six-lead small-outline part beside the module site; read the full marking under raking light and count the leads from its marker" } },
    InstalledComponent { component: e1_u5_2, terminals: [], identification: IdentifiedByMarking { row: cec1736, marking: MarkingReading { text: "Microchip logo / CEC1736 / BAS723G / 2242QB1", evidence: e1_erot_photo } } },
    InstalledComponent { component: e1_u3_2, terminals: [], identification: IdentifiedByMarking { row: mt25qu01gbbb8e12, marking: MarkingReading { text: "2NA17 / RW188 (corner dot); RW188 decoded by Micron's FBGA part-marking decoder to MT25QU01GBBB8E12-0SIT (operator lookup, 2026-10-21)", evidence: e1_erot_photo } } },
    InstalledComponent { component: e1_u2_2, terminals: [], identification: IdentifiedByMarking { row: mt25qu01gbbb8e12, marking: MarkingReading { text: "2NA17 / RW188 (corner dot); the same code as U3_2, the same decode", evidence: e1_erot_photo } } },
    InstalledComponent { component: e1_rw251_bga, terminals: [], identification: IdentifiedByMarking { row: mt25qu02gcbb8e12, marking: MarkingReading { text: "2RA17 / RW251; RW251 decoded by Micron's FBGA part-marking decoder to MT25QU02GCBB8E12-0SIT (operator lookup, 2026-10-21). Its designator is unread: the 'U39' label sits beside the small two-terminal part between U3_2 and U2_2 (upload 52e248d1), not this BGA", evidence: e1_erot_photo } } },
    InstalledComponent { component: e1_u41, terminals: [], identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "PW546A / 26KG4 / C7HE", evidence: e1_j30_area_photo } }, discriminator: "a 14-lead part beside J30; the maker's marking table" } },
    InstalledComponent { component: e1_u22, terminals: [], identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "P617A / 01.14 / 226", evidence: e1_j30_area_photo } }, discriminator: "an eight-lead part beside U483; the maker's marking table" } },
    InstalledComponent { component: e1_j24, terminals: names(ns: e1_j24_positions), identification: MarkingUnresolved { marking: Absent, discriminator: "J24: a two-row five-position shrouded female receptacle, one position keyed, between J68 and U53 (the K1 listing's 'small shrouded connector below U4'); its pitch is e1_j24_pitch, a photographic measurement. Its pinout is unread: no position reads near the return unpowered, so its ground, if any, is a powered or baselined reading away; it is the debug-port candidate for U4 or U5_2, and a female receptacle takes a male plug, not the USB Blaster's socket" } },
    InstalledComponent { component: e1_ds1_2, terminals: names(ns: ["one side (which of the two unrecorded)", "other side"]), identification: MarkingUnresolved { marking: Absent, discriminator: "the green indicator beside U5_2 that blinks on 1.0 s, off 1.5 s in the settled state; its anode and cathode are unread, and which side the meter lit it from says which" } },
    InstalledComponent { component: e1_u104, terminals: names(ns: e1_u104_leads), identification: MarkingUnresolved { marking: Absent, discriminator: "a six-lead part between U5_2 and U105 whose inner middle lead reads '.000' to one side of DS1_2: a driver or a series element for the lamp; its marking and its other five leads are unread" } },
    InstalledComponent { component: e1_u4, terminals: [], identification: IdentifiedByMarking { row: cyclone_10_gx_10cx085yf672e6g, marking: MarkingReading { text: "intel (logo) / Cyclone 10 / 10CX085YF672E6G / P CBABF2243A / TAIWAN / S241AK47 / 305PA2U0D / e1 (circled)", evidence: e1_u4_photo } } },
    InstalledComponent { component: e1_u43_chain_via, terminals: names(ns: ["via"]), identification: MarkingUnresolved { marking: Absent, discriminator: "a via the operator reads as a ground point (800 ohm from Q300's lead b on the 2k range); joined to the return only by a baselined reading" } },
  ],
  measured: Present { value: e1_measured },
  input: Present { value: e1_input },
  unresolved: [
    UnresolvedPart { designator: Absent, marking: Present { value: "P617A / 01 14 / 226" }, obligation: "an 8-pin MSOP left of the VCI mark, read at the photograph's resolution: maker and function unresolved", evidence: e1_photo(taken_on: "2026-10-16", locator: "E1 label photograph sent in the session") },
    UnresolvedPart { designator: Present { value: "U1_P1" }, marking: Absent, obligation: "the 28-pin TSSOP below the lower capacitor, designator read 2026-10-19: its marking is not legible; its _P5 twin U1_P5 is an LM5066I, a lead for this one, not its identity", evidence: e1_photo(taken_on: "2026-10-15", locator: "J20 close-up sent in the session") },
    UnresolvedPart { designator: Absent, marking: Present { value: "HA..." }, obligation: "a part below D5, partly in frame: read its marking", evidence: e1_photo(taken_on: "2026-10-16", locator: "F300 photograph sent in the session") },
    UnresolvedPart { designator: Absent, marking: Absent, obligation: "the large bare pads by F300 and the copper-ringed mounting holes were read as populations ('all of the big bare pads', 'J20 connects to all copper holes'); each would be a terminal once numbered on a photograph", evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "all of the big bare pads are connected the to the power rail" } },
    UnresolvedPart { designator: Present { value: "J24" }, marking: Absent, obligation: "a keyed socket of about 2 x 5 positions in the debug corner: its ground and logic-reference points by unpowered readings and idle voltages, nothing bridged", evidence: e1_switch_photo },
    UnresolvedPart { designator: Present { value: "J540" }, marking: Absent, obligation: "a smaller multi-pin socket beside U71, U95, DS3 to DS6 and S1: its position count, its ground and logic-reference points, nothing bridged", evidence: e1_switch_photo },
    UnresolvedPart { designator: Present { value: "J31" }, marking: Absent, obligation: "a two-pin header silkscreened J31 beside Q530 in the corner photograph, a different header from J30: its role and its points", evidence: e1_switch_photo },
  ],
}

// ── RENDERING (diagnostics only) ──────────────────────────────────────────────────────────────

fn component_text(c: ComponentInstanceIdentity) -> String {
  component_local_label(c: c) as String
}

fn withstand_kind_text(k: VoltageWithstandKind) -> String {
  match k {
    TvsReverseStandoff => "TVS reverse standoff"
    CapacitorRatedVoltage => "capacitor rated voltage"
    DrainSourceMaximum => "drain-source maximum"
    FuseInterruptRating => "fuse voltage rating"
  }
}

fn row_side_text(s: RowSide) -> String {
  match s {
    LatchSide => "on the latch side"
    AwayFromLatch => "away from the latch"
    SideUnrecorded => "side unrecorded"
  }
}

fn polarity_gap_text(g: PolarityGap) -> String {
  match g {
    SidesUnrecorded => "a contact's side is unrecorded"
    NoMeasuredBoard => "no measured board"
    InputUnmapped => "J20's contacts are not mapped on this board"
    FusedSideNotReached => "not every fused-side contact is read to the fuse"
    ReturnSideNotJoined => "the return-side contacts are not read joined"
    IsolationUnread => "no reading separates the two sides"
  }
}

fn polarity_text(p: InputPolarity) -> String {
  match p {
    PolarityEstablished { fused_side, return_side, fused: _, returns: _, isolation: _ } => join([
      "polarity established ", evidence_grade_text(g: polarity_grade(p: p)), ": fused contacts ", row_side_text(s: fused_side), ", return contacts ", row_side_text(s: return_side),
    ], "")
    PolarityContradicted { readings } => join(["polarity CONTRADICTED (", join(map(readings, o => continuity_text(o: o)), "; "), "): re-read before any connection"], "")
    PolarityUnestablished { gaps } => join(["polarity UNESTABLISHED (", join(map(gaps, g => polarity_gap_text(g: g)), "; "), "): re-read before any connection"], "")
  }
}

fn across_text(s: AcrossInputStanding) -> String {
  match s {
    AcrossInput { component, on_fused, on_return, fused_path: _, return_path: _ } => join([
      component_text(c: component), " across the input ('", terminal_text(t: on_fused), "' on the fused side, '", terminal_text(t: on_return), "' on the return side)",
    ], "")
    AcrossInputContradicted { component, readings } => join([component_text(c: component), " placement CONTRADICTED (", join(map(readings, o => continuity_text(o: o)), "; "), ")"], "")
    AcrossInputUnestablished { component, gap } => join([component_text(c: component), " not placed across the input (",
      match gap {
        InputPolarityNotEstablished => "the input polarity is not established"
        NotTwoTerminals => "not a two-terminal part"
        TerminalsNotPlaced => "its terminals are not read to the two sides"
      }, ")"], "")
  }
}

fn observed_rating_text(o: ObservedRating) -> String {
  join([component_text(c: o.component), ": ", to_string(volt_count(v: o.rated.maximum)), " V ", withstand_kind_text(k: o.rated.kind), "; ", across_text(s: o.placement)], "")
}

fn bound_text(b: InputBoundStanding) -> String {
  match b {
    BoundEstablished { bound, equally_limiting, observed: _ } => join([
      "at most ", to_string(volt_count(v: bound.rated.maximum)), " V, limited by ", component_text(c: bound.limiting_component), "'s ", withstand_kind_text(k: bound.rated.kind),
      " (", across_text(s: bound.placement), "; ", evidence_grade_text(g: bound.grade), ")",
      match equally_limiting.first() {
        Absent => ""
        Present { value: _ } => join(["; equally limited by ", join(map(equally_limiting, x => component_text(c: x.limiting_component)), ", ")], "")
      },
    ], "")
    BoundContradicted { contradicted, observed: _ } => join(["bound CONTRADICTED: ", join(map(contradicted, o => observed_rating_text(o: o)), "; ")], "")
    BoundUnestablished { observed } => match observed.first() {
      Absent => "no rated part read, and no input bound"
      Present { value: _ } => join(["no input bound established; observed ratings (", join(map(observed, o => observed_rating_text(o: o)), "; "), ") bound nothing"], "")
    }
  }
}

fn hypothesis_text(h: InvestigationHypothesis) -> String {
  join(["hypothesis, not a derivation: ", h.claim as String, " (", join(map(h.sources, x => x as String), "; "), "); decided by ", h.decided_by as String], "")
}

fn j20_position_count(layout: CarrierLayoutObservation) -> Nat {
  match layout.j20 {
    CountedFromPhotograph { positions: n, evidence: _ } => n
    MappedOnHousing { housing } => count(housing.positions)
  }
}

fn span_fits(s: CaliperSpan, pitch: Micrometer, cavity_min: Micrometer, cavity_max: Micrometer) -> Bool {
  micrometer_count(m: s.measured) >= s.pitches * micrometer_count(m: pitch) + s.cavities * micrometer_count(m: cavity_min)
    && micrometer_count(m: s.measured) <= s.pitches * micrometer_count(m: pitch) + s.cavities * micrometer_count(m: cavity_max)
}

// Whether every caliper span is consistent with a pitch, given bounds on the cavity width.
fn calipers_fit_pitch(spans: List<CaliperSpan>, pitch: Micrometer, cavity_min: Micrometer, cavity_max: Micrometer) -> Bool {
  count(spans) > 0 && all(spans, s => span_fits(s: s, pitch: pitch, cavity_min: cavity_min, cavity_max: cavity_max))
}

fn fit_word(b: Bool) -> String {
  if b { "fit" } else { "do not fit" }
}

fn caliper_text(spans: List<CaliperSpan>) -> String {
  match spans.first() {
    Absent => ""
    Present { value: _ } => join([
      "; caliper spans ", fit_word(b: calipers_fit_pitch(spans: spans, pitch: micrometer(count: 3000), cavity_min: micrometer(count: 2000), cavity_max: micrometer(count: 2600))),
      " a 3.0 mm pitch and ", fit_word(b: calipers_fit_pitch(spans: spans, pitch: micrometer(count: 4200), cavity_min: micrometer(count: 2000), cavity_max: micrometer(count: 2600))),
      " a 4.2 mm pitch, for a cavity of 2.0 to 2.6 mm",
    ], "")
  }
}

fn j20_text(layout: CarrierLayoutObservation) -> String {
  match layout.j20 {
    CountedFromPhotograph { positions: n, evidence: _ } => join([to_string(n), " positions counted from a photograph; pin continuity unread", caliper_text(spans: layout.j20_calipers)], "")
    MappedOnHousing { housing } => join([to_string(count(housing.positions)), " positions mapped on the housing", caliper_text(spans: layout.j20_calipers)], "")
  }
}

// ── NARROW FINDINGS, for consumers that cite one fact ─────────────────────────────────────────
//
// A consumer that records "this was established" cites ONE finding, not the whole carrier report, so
// that removing or contradicting that fact in this model reopens the consumer and nothing else. Each
// finding's standing is derived here from the typed model; its text is this module's own rendering.
type CarrierFinding
  = J20ContactInventory
  | J20Polarity
  | ComponentAcrossInput { component: ComponentInstanceIdentity }
  | ComponentIdentified { component: ComponentInstanceIdentity }
  | InputUpperBound
  | J20EnergizedDraw
  | InputSwitchState { component: ComponentInstanceIdentity }
  | ControllerEnableState { component: ComponentInstanceIdentity }
  | ControllerOvervoltageState { component: ComponentInstanceIdentity }
  | EnableInputProjection { component: ComponentInstanceIdentity }
  | CarrierPhaseObserved { key: NonEmptyStr }
  | ProtectedInputBusInPhase { key: NonEmptyStr }

type FindingStanding
  = FindingEstablished { text: String }
  | FindingNotEstablished { reason: String }

fn identification_text(i: ComponentIdentification) -> String? {
  match i {
    IdentifiedByMarking { row, marking } => Present { value: join([row.vendor.legal_name as String, " ", row.ordering_code as String, ", from the marking '", marking.text as String, "'"], "") }
    MarkingSharedByMakers { rows, marking } => Present { value: join(["one of ", join(map(rows, r => join([r.vendor.legal_name as String, " ", r.ordering_code as String], "")), " or "), " (maker not identified), from the marking '", marking.text as String, "'"], "") }
    MarkingCandidate { row, marking, discriminator } => Present { value: join(["CANDIDATE ", row.vendor.legal_name as String, " ", row.ordering_code as String, " from the marking '", marking.text as String, "' (not identified: ", discriminator as String, ")"], "") }
    RatingPrintedOnBody { rating: _, marking } => Present { value: join(["rating printed on the body: '", marking.text as String, "'"], "") }
    ResistanceCodeRead { milliohms, marking } => Present { value: join([to_string(milliohms), " milliohms by the resistor code '", marking.text as String, "'"], "") }
    MarkingUnresolved { marking: _, discriminator: _ } => Absent
    FootprintUnpopulated { evidence: _ } => Absent
  }
}

fn installed(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity) -> InstalledComponent? {
  (filter(layout.components, x => component_identity_eq(a: x.component, b: c))).first()
}

fn not_a_component(c: ComponentInstanceIdentity) -> FindingStanding {
  FindingNotEstablished { reason: join([component_text(c: c), " is not a component of this carrier's observation"], "") }
}

fn across_finding(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity) -> FindingStanding {
  match installed(layout: layout, c: c) {
    Absent => not_a_component(c: c)
    Present { value: x } => match across_input(layout: layout, c: x) {
      AcrossInput { component, on_fused, on_return, fused_path, return_path } =>
        FindingEstablished { text: across_text(s: AcrossInput { component: component, on_fused: on_fused, on_return: on_return, fused_path: fused_path, return_path: return_path }) }
      AcrossInputContradicted { component, readings } => FindingNotEstablished { reason: across_text(s: AcrossInputContradicted { component: component, readings: readings }) }
      AcrossInputUnestablished { component, gap } => FindingNotEstablished { reason: across_text(s: AcrossInputUnestablished { component: component, gap: gap }) }
    }
  }
}

fn identified_finding(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity) -> FindingStanding {
  match installed(layout: layout, c: c) {
    Absent => not_a_component(c: c)
    Present { value: x } => match identification_text(i: x.identification) {
      Present { value: t } => FindingEstablished { text: join([component_text(c: c), " is ", t], "") }
      Absent => FindingNotEstablished { reason: join([component_text(c: c), "'s marking is not resolved"], "") }
    }
  }
}

fn carrier_finding(layout: CarrierLayoutObservation, f: CarrierFinding) -> FindingStanding {
  match f {
    J20ContactInventory => match layout.j20 {
      MappedOnHousing { housing: _ } => FindingEstablished { text: join(["J20: ", j20_text(layout: layout)], "") }
      CountedFromPhotograph { positions: _, evidence: _ } => FindingNotEstablished { reason: join(["J20 is only counted from a photograph: ", j20_text(layout: layout)], "") }
    }
    J20Polarity => match input_polarity(layout: layout) {
      PolarityEstablished { fused_side: _, return_side: _, fused: _, returns: _, isolation: _ } => FindingEstablished { text: join(["J20 ", polarity_text(p: input_polarity(layout: layout))], "") }
      PolarityContradicted { readings: _ } => FindingNotEstablished { reason: polarity_text(p: input_polarity(layout: layout)) }
      PolarityUnestablished { gaps: _ } => FindingNotEstablished { reason: polarity_text(p: input_polarity(layout: layout)) }
    }
    ComponentAcrossInput { component } => across_finding(layout: layout, c: component)
    ComponentIdentified { component } => identified_finding(layout: layout, c: component)
    InputUpperBound => match input_bound(layout: layout) {
      BoundEstablished { bound: _, equally_limiting: _, observed: _ } => FindingEstablished { text: join(["J20 input ", bound_text(b: input_bound(layout: layout))], "") }
      BoundContradicted { contradicted: _, observed: _ } => FindingNotEstablished { reason: bound_text(b: input_bound(layout: layout)) }
      BoundUnestablished { observed: _ } => FindingNotEstablished { reason: bound_text(b: input_bound(layout: layout)) }
    }
    InputSwitchState { component } => match installed(layout: layout, c: component) {
      Absent => not_a_component(c: component)
      Present { value: x } => match input_switch_standing(layout: layout, c: x) {
        SwitchStateUnestablished { component: _, gap: _ } => FindingNotEstablished { reason: switch_text(s: input_switch_standing(layout: layout, c: x)) }
        _ => FindingEstablished { text: switch_text(s: input_switch_standing(layout: layout, c: x)) }
      }
    }
    ControllerEnableState { component } => match installed(layout: layout, c: component) {
      Absent => not_a_component(c: component)
      Present { value: x } => match controller_enable_standing(layout: layout, c: x) {
        PinThresholdUnestablished { component: _, readings: _, gap: _ } => FindingNotEstablished { reason: enable_text(s: controller_enable_standing(layout: layout, c: x)) }
        _ => FindingEstablished { text: enable_text(s: controller_enable_standing(layout: layout, c: x)) }
      }
    }
    ControllerOvervoltageState { component } => match installed(layout: layout, c: component) {
      Absent => not_a_component(c: component)
      Present { value: x } => match controller_overvoltage_standing(layout: layout, c: x) {
        PinThresholdUnestablished { component: _, readings: _, gap: _ } => FindingNotEstablished { reason: overvoltage_text(s: controller_overvoltage_standing(layout: layout, c: x)) }
        _ => FindingEstablished { text: overvoltage_text(s: controller_overvoltage_standing(layout: layout, c: x)) }
      }
    }
    EnableInputProjection { component } => match installed(layout: layout, c: component) {
      Absent => not_a_component(c: component)
      Present { value: x } => match enable_projection(layout: layout, c: x) {
        EnableProjectionUnestablished { component: _, gap: _ } => FindingNotEstablished { reason: projection_text(p: enable_projection(layout: layout, c: x)) }
        _ => FindingEstablished { text: projection_text(p: enable_projection(layout: layout, c: x)) }
      }
    }
    J20EnergizedDraw => match input_draw(layout: layout) {
      InputDrawBounded { bounded: _, observed: _ } => FindingEstablished { text: join(["J20 ", input_draw_text(d: input_draw(layout: layout))], "") }
      InputDrawContradicted { contradicted: _, observed: _ } => FindingNotEstablished { reason: input_draw_text(d: input_draw(layout: layout)) }
      InputDrawUnestablished { gaps: _ } => FindingNotEstablished { reason: input_draw_text(d: input_draw(layout: layout)) }
    }
    CarrierPhaseObserved { key } => match phase_standing_in(layout: layout, key: key) {
      Absent => FindingNotEstablished { reason: join(["no phase '", key as String, "' is recorded on this carrier"], "") }
      Present { value: s } => if is_phase_classified(s: s) { FindingEstablished { text: phase_standing_text(s: s) } } else { FindingNotEstablished { reason: phase_standing_text(s: s) } }
    }
    ProtectedInputBusInPhase { key } => match protected_bus_in(layout: layout, key: key) {
      Absent => FindingNotEstablished { reason: join(["no phase '", key as String, "' is recorded on this carrier"], "") }
      Present { value: s } => if is_bus_read(s: s) { FindingEstablished { text: protected_bus_text(s: s) } } else { FindingNotEstablished { reason: protected_bus_text(s: s) } }
    }
  }
}

fn is_finding_established(s: FindingStanding) -> Bool {
  match s {
    FindingEstablished { text: _ } => true
    FindingNotEstablished { reason: _ } => false
  }
}

// The input switches and controllers this observation identifies, rendered from their standings.
fn input_stage_text(layout: CarrierLayoutObservation) -> String {
  let switches = filter(layout.components, c => match mosfet_of(c: c) {
    Present { value: _ } => true
    Absent => false
  })
  let controllers = filter(layout.components, c => match controller_of(c: c) {
    Present { value: _ } => true
    Absent => false
  })
  let bench = bench_record_text(layout: layout)
  let attached = attachments_text(layout: layout)
  join([
    match switches.first() {
      Absent => "no input switch identified"
      Present { value: _ } => join(map(switches, c => switch_text(s: input_switch_standing(layout: layout, c: c))), ". ")
    },
    match controllers.first() {
      Absent => ""
      Present { value: _ } => join([". ", join(map(controllers, c => join([enable_text(s: controller_enable_standing(layout: layout, c: c)), ". ", overvoltage_text(s: controller_overvoltage_standing(layout: layout, c: c)), ". ", projection_text(p: enable_projection(layout: layout, c: c)), ". ", regulator_output_text(layout: layout, c: c)], "")), ". ")], "")
    },
    if attached == "" { "" } else { join([". ", attached], "") },
    if bench == "" { "" } else { join([". ", bench], "") },
  ], "")
}

// Q300'S LEAD B TOWARD U51: what the pair reads across ranges, derived from the record, never from the
// trace followed by eye. Rendered only where U51 is a component of the observation.
fn q300_gate_path_reading(layout: CarrierLayoutObservation) -> String {
  match installed(layout: layout, c: e1_u51) {
    Absent => join([component_text(c: e1_u51), " is not a component of this carrier's observation"], "")
    Present { value: _ } => match layout.measured {
      Absent => "no reading from Q300 lead b toward U51"
      Present { value: b } => join([
        "Q300 lead b to U51 pin 8 ", pair_range_text(s: pair_range_standing(os: b.bench.resistances, a: e1_q300_lead_b, b: e1_u51_pin(n: "pin 8"))),
        "; Q300 lead b to J20's black lead ", pair_range_text(s: pair_range_standing(os: b.bench.resistances, a: e1_q300_lead_b, b: e1_ground_ref)),
        "; no U51 pin is read as Q300 lead b's node. On the front, ", to_string(count(terminals_reading_at_most(rs: b.bench.resistances, c: e1_u500, names: e1_u500_contacts, ceiling_ohms: 500))), " of U500's contacts read at or below 500 ohm from Q300 lead b on the 2k range (", join(map(terminals_reading_at_most(rs: b.bench.resistances, c: e1_u500, names: e1_u500_contacts, ceiling_ohms: 500), n => n as String), ", "), "), against 800 ohm to its ground contact and to the via beside the U43 chain; the pad above U500 to J20's black lead ", pair_polarity_text(s: pair_polarity_standing(os: b.bench.resistances, a: e1_u500_pad, b: e1_ground_ref), a: e1_u500_pad, b: e1_ground_ref), "; Q300 lead b to that pad ", pair_polarity_text(s: pair_polarity_standing(os: b.bench.resistances, a: e1_q300_lead_b, b: e1_u500_pad), a: e1_q300_lead_b, b: e1_u500_pad), ". Of U55's pins, ", to_string(count(terminals_reading_at_most(rs: b.bench.resistances, c: e1_u55, names: e1_u55_pins, ceiling_ohms: 500))), " read at or below 500 ohm from Q300 lead b on the 2k range (", join(map(terminals_reading_at_most(rs: b.bench.resistances, c: e1_u55, names: e1_u55_pins, ceiling_ohms: 500), n => n as String), ", "), "). ", gate_pin_text(layout: layout, c: e1_u43, number: 4), "; ", translator_pin_text(layout: layout, c: e1_u55, number: 13), "; ", translator_pin_text(layout: layout, c: e1_u55, number: 16), "; ", translator_pin_text(layout: layout, c: e1_u55, number: 12),
      ], "")
    }
  }
}

fn carrier_input_reading(layout: CarrierLayoutObservation) -> String {
  join([
    "J20 (", j20_text(layout: layout), "; ", polarity_text(p: input_polarity(layout: layout)), "): ", bound_text(b: input_bound(layout: layout)),
    ". J20 ", input_draw_text(d: input_draw(layout: layout)),
    ". ", input_stage_text(layout: layout),
    ". ", netlist_reading(layout: layout),
    ". ", phases_reading(layout: layout),
    ". ", q300_gate_path_reading(layout: layout),
    ". ", u4_configuration_text(layout: layout),
    ". ", u5_2_root_of_trust_text(layout: layout),
    ". ", island_flash_text(layout: layout),
    ". ", j24_text(layout: layout),
    ". ", j68_shape_text(layout: layout),
    ". ", alterations_text(layout: layout),
    ". ", hypothesis_text(h: p4261_j20_main_input_hypothesis), ". ", hypothesis_text(h: p4261_grey_path_hypothesis), ". ", hypothesis_text(h: p4261_enable_network_hypothesis), ". ", hypothesis_text(h: p4261_local_control_hypothesis), ". ", hypothesis_text(h: p4261_q4_temperature_diode_hypothesis), ". ", hypothesis_text(h: p4261_vdd_bypass_hypothesis), ". ", hypothesis_text(h: p4261_near_4r7_converter_hypothesis),
    ". Which connector carries the module's power is not established. The input voltage contract is unknown: no rail, pin assignment, standby rail or sequence is established",
  ], "")
}

fn sensor_role_text(r: SensorPinRole) -> String {
  match r {
    SerialData { bus: _, open_drain: _ } => "serial data"
    SerialClock { bus: _ } => "serial clock"
    AlertOutput { open_drain: _ } => "alert output"
    GroundReturn => "ground"
    SupplyInput => "supply"
    AddressSelect { bit } => join(["address bit ", to_string(bit)], "")
  }
}

fn is_trace_target(r: SensorPinRole) -> Bool {
  match r {
    SerialData { bus: _, open_drain: _ } => true
    SerialClock { bus: _ } => true
    AlertOutput { open_drain: _ } => true
    GroundReturn => false
    SupplyInput => false
    AddressSelect { bit: _ } => false
  }
}

fn sensor_pins_text(c: InstalledComponent, row: ElectronicComponentRow, marking: MarkingReading) -> List<String> {
  match row.specification {
    TemperatureSensorSpec { sensor } => [join([
      component_text(c: c.component), " ('", marking.text as String, "') is ", row.ordering_code as String,
      "; trace pins ", join(map(filter(sensor.pins, p => is_trace_target(r: p.role)), p => join([to_string(p.number), " ", p.name as String, " (", sensor_role_text(r: p.role), ")"], "")), ", "),
    ], "")]
    TvsDiodeSpec { tvs: _ } => []
    CapacitorSpec { capacitor: _ } => []
    MosfetSpec { mosfet: _ } => []
    ConnectorSpec { connector: _ } => []
    HotSwapControllerSpec { controller: _ } => []
    ShiftRegisterSpec { register: _ } => []
    LevelTranslatorSpec { translator: _ } => []
    LogicGateSpec { gate: _ } => []
    ProgrammableLogicSpec { logic: _ } => []
    RootOfTrustSpec { root_of_trust: _ } => []
    SerialFlashSpec { flash: _ } => []
    SwitchingRegulatorSpec { regulator: _ } => []
  }
}

// A part identified as a temperature sensor renders its bus pins as trace targets, from its typed roles.
fn sensor_trace_text(c: InstalledComponent) -> List<String> {
  match c.identification {
    IdentifiedByMarking { row, marking } => sensor_pins_text(c: c, row: row, marking: marking)
    MarkingSharedByMakers { rows: _, marking: _ } => []
    MarkingCandidate { row: _, marking: _, discriminator: _ } => []
    RatingPrintedOnBody { rating: _, marking: _ } => []
    ResistanceCodeRead { milliohms: _, marking: _ } => []
    MarkingUnresolved { marking: _, discriminator: _ } => []
    FootprintUnpopulated { evidence: _ } => []
  }
}

fn candidate_text(c: ReceptacleCandidate) -> String {
  match c {
    UsbMicroB => "USB Micro-B"
    UsbSuperSpeedMicroB => "USB 3.0 SuperSpeed Micro-B"
  }
}

fn width_text(w: Micrometer) -> String {
  join([to_string(micrometer_count(m: w)), " um"], "")
}

fn management_io_item_text(o: ManagementIoObservation) -> String {
  match o {
    PinHeader { designator, rows, columns, pin_one_marked, evidence: _ } => join([
      match designator {
        Absent => "a"
        Present { value: d } => d as String
      },
      " ", to_string(rows), " x ", to_string(columns), " pin header", if pin_one_marked { " with a pin-1 mark" } else { "" }, ", function and pinout unread",
    ], "")
    EdgeReceptacle { marking, opening_widths, plug_fit, candidates, evidence: _ } => join([
      "an edge receptacle",
      match marking {
        Absent => ""
        Present { value: m } => join([" marked '", m as String, "'"], "")
      },
      match opening_widths.first() {
        Absent => ""
        Present { value: _ } => join([" with openings of about ", join(map(opening_widths, w => width_text(w: w)), " and ")], "")
      },
      match plug_fit {
        MicroUsbPlugFits => ", into which a micro-USB plug fits"
        PlugFitUntried => ""
      },
      "; candidate families ", join(map(candidates, c => candidate_text(c: c)), ", "), " (part number, protocol and role unestablished)",
    ], "")
    FlatCableConnectors { count: n, evidence: _ } => join([to_string(n), " thin flat-cable connectors, function unread"], "")
  }
}

// THE RECEIVED BOARD IS NAMED BY ITS OWN LABEL. A label in a listing photograph names what was sold,
// possibly a sibling unit; only the operator's photograph of the board in hand names this one, so every
// consumer that labels the carrier reads it here rather than restating it.
fn is_operator_photograph(e: EvidenceRef) -> Bool {
  match e {
    OperatorPhotograph { taken_on: _, locator: _ } => true
    _ => false
  }
}

fn is_received_label(m: BoardMarking) -> Bool {
  match m {
    AssemblyLabel { model: _, part_number: _, revision: _, serial: _, evidence } => is_operator_photograph(e: evidence)
    _ => false
  }
}

fn received_labels(layout: CarrierLayoutObservation) -> List<BoardMarking> {
  filter(layout.markings, m => is_received_label(m: m))
}

fn carrier_label_text(layout: CarrierLayoutObservation) -> String {
  let texts = flat_map(received_labels(layout: layout), m => match m {
    AssemblyLabel { model, part_number, revision, serial, evidence: _ } =>
      [join([model as String, " ", part_number as String, " rev ", revision as String, ", S/N ", serial as String], "")]
    _ => []
  })
  match texts.first() {
    Absent => "a carrier whose label is unread on the received unit"
    Present { value: _ } => join(texts, "; ")
  }
}

fn carrier_model_text(layout: CarrierLayoutObservation) -> String {
  let models = flat_map(received_labels(layout: layout), m => match m {
    AssemblyLabel { model, part_number: _, revision: _, serial: _, evidence: _ } => [model as String]
    _ => []
  })
  match models.first() {
    Absent => "unlabelled"
    Present { value: m } => m
  }
}

fn management_io_text(layout: CarrierLayoutObservation) -> String {
  let items = join(map(layout.management_io, o => management_io_item_text(o: o)), "; ")
  let io = match layout.management_io_survey {
    WholeBoardPhotographed => match layout.management_io.first() {
      Absent => "the photographed P4261 shows no RJ45, USB, video, console header or coin cell"
      Present { value: _ } => join(["the photographed P4261 shows no RJ45, video or coin cell; it shows ", items], "")
    }
    PartlyPhotographed { not_covered } => match layout.management_io.first() {
      Absent => join(["this P4261's management I/O is unsurveyed: ", not_covered as String], "")
      Present { value: _ } => join(["this P4261 is partly photographed, so no absence of management I/O is established (", not_covered as String, "); it shows ", items], "")
    }
  }
  let sensors = flat_map(layout.components, c => sensor_trace_text(c: c))
  match sensors.first() {
    Absent => io
    Present { value: _ } => join([io, ". Identified management-bus parts: ", join(sensors, "; ")], "")
  }
}

fn family_spec_text(row: ElectronicComponentRow) -> String {
  match row.specification {
    ConnectorSpec { connector } => join([" (", connector.series as String, ", ", to_string(connector.positions), " positions)"], "")
    TvsDiodeSpec { tvs: _ } => ""
    CapacitorSpec { capacitor: _ } => ""
    MosfetSpec { mosfet: _ } => ""
    TemperatureSensorSpec { sensor: _ } => ""
    HotSwapControllerSpec { controller: _ } => ""
    ShiftRegisterSpec { register: _ } => ""
    LevelTranslatorSpec { translator: _ } => ""
    LogicGateSpec { gate: _ } => ""
    ProgrammableLogicSpec { logic: _ } => ""
    RootOfTrustSpec { root_of_trust: _ } => ""
    SerialFlashSpec { flash: _ } => ""
    SwitchingRegulatorSpec { regulator } => join([" (synchronous step-down converter, ", millivolt_text(n: millivolt_count(v: regulator.input.minimum)), " to ", millivolt_text(n: millivolt_count(v: regulator.input.maximum)), " in, ", to_string(ampere_count(a: regulator.continuous_output_current)), " A, ", to_string(count(regulator.pins)), " pins)"], "")
  }
}

fn read_on_text(r: ReadOnUnit) -> String {
  match r {
    ReadOnAsset { asset } => asset as String
    UnitUnrecorded => "one of the operator's two carriers, which one unrecorded"
  }
}

fn edge_connector_text(layout: CarrierLayoutObservation) -> String {
  match layout.edge_high_speed_connectors {
    CensusComplete { count: n, family } => join([to_string(n), " ", family.ordering_code as String, " connectors"], "")
    CensusPartial { counted_at_least: n, designators_read, family_candidate, obligation } => join([
      "at least ", to_string(n), " cabled high-speed connectors",
      match designators_read.first() {
        Absent => ""
        Present { value: _ } => join([" (", join(map(designators_read, d => d as String), ", "), " read)"], "")
      },
      " (", obligation as String, ")",
      match family_candidate {
        Absent => ""
        Present { value: fc } => join(["; family candidate ", fc.row.ordering_code as String, family_spec_text(row: fc.row), ", marking '", fc.marking as String, "' read on ", read_on_text(r: fc.read_on)], "")
      },
    ], "")
  }
}
