module product.p4261_carrier_layout

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { Volt, Ampere, volt, ampere, volt_count, ampere_count }
import extdeps.electronic_component.types {
  ElectronicComponentRow,
  ComponentVoltageRating,
  VoltageRatingKind,
  DrainSourceMaximum,
  FuseInterruptRating,
  CapacitorRatedVoltage,
}
import extdeps.electronic_component.infineon_ipb017n10n5lf { ipb017n10n5lf }
import extdeps.electronic_component.panasonic_eeh_zu1j151 { eeh_zu1j151 }
import extdeps.electronic_component.bourns_5_0smdj60a { tvs_5_0smdj60a }

// GH200-3 (2026-10-04). THE P4261 CARRIER AS PHOTOGRAPHED, AND WHAT CAN BE DEDUCED FROM IT. No NVIDIA
// document names this board, so everything here is the operator's observation of one unit, kept in
// the product layer (DESIGN §3: observations are receipts downstream, never upstream facts). What
// IS upstream -- a part's datasheet ratings once its marking is matched -- lives in
// extdeps.electronic_component and is consumed here.
//
// Three photographs: the full component side; the label close-up; the left-edge close-up around the
// connector silkscreened J20. Every marking is transcribed as read, and three standings are kept
// apart because they license different conclusions:
//
//   IdentifiedByDatasheetMarking  the marking matches a datasheet's marking table, so the part's
//                                 ratings are cited facts
//   RatingPrintedOnBody           the part prints its own rating; no datasheet, but no decoding either
//   MarkingUnresolved             the marking is read and NOT decoded; it contributes nothing, and the
//                                 discriminator says what would decode it
//
// Which circuit a part sits on is a fourth fact, and from a photograph it is ADJACENCY, not traced
// copper. Adjacency places a part in a region of the board; it does not say what voltage appears
// across the part's rated terminals, which is the only relation under which a rating bounds a rail.
//
// GH200-P9 (2026-10-15): THE OPERATOR'S OWN BENCH READINGS of a received carrier. The operator read
// J20 and its neighbourhood with a multimeter, unpowered, and photographed the parts beside it, on a
// carrier whose label reads revision E1 -- not this K1; the operator believes it is the board bought
// from Central Valley. Both are P4261 boards (E1 and K1 revisions), and J20's continuity is taken as
// a property of the board design rather than of one unit: a revision change could alter it, so the
// readings carry their unit, and lot codes and labels are recorded with that caveat. A continuity reading is stronger than
// adjacency (it says two points are joined, or are not) and weaker than a traced net under power (a
// switch that is open while unpowered hides the rail behind it).

type ComponentIdentification
  = IdentifiedByDatasheetMarking { row: ElectronicComponentRow, marking_read: NonEmptyStr }
  | RatingPrintedOnBody { voltage: ComponentVoltageRating?, current: Ampere?, marking_read: NonEmptyStr }
  | ResistanceCodeRead { milliohms: Nat, marking_read: NonEmptyStr }
  | MarkingUnresolved { marking_read: NonEmptyStr, discriminator: NonEmptyStr }

type PowerPath = MainInputPath | AuxiliaryInputPath

// WHAT RELATES A PART'S RATING TO A RAIL. RatingAcrossInputRail is the one relation that licenses a
// bound: the evidence must say that the rated terminals see the input rail (a fuse in series with the
// input, a bulk capacitor across it, a hot-swap FET's drain-source in its path) in the condition the
// rating applies to -- a traced net, a schematic, or the vendor's reference design for the board.
// OnPathByAdjacency places the part near a path and bounds nothing: an input-stage part and a
// downstream converted rail can share one region of the board.
type PathMembership
  = RatingAcrossInputRail { evidence: NonEmptyStr }
  | OnPathByAdjacency { basis: NonEmptyStr }

type ObservedComponent {
  designators: List<NonEmptyStr>
  quantity: Nat
  role: NonEmptyStr
  identification: ComponentIdentification
  path: PowerPath
  membership: PathMembership
}

// J20'S PINS BY CONTINUITY, unpowered. Each row of pins is read against ground and against the fuse
// beside the connector; tied_together says every pin in the row beeps to every other.
type ContinuityTarget
  = ToGround
  | ToFuse { designator: NonEmptyStr }

type PinRowContinuity {
  pins: Nat
  tied_to: ContinuityTarget
  tied_together: Bool
}

// THE MEASURED CIRCUIT: the part of the board's netlist a multimeter has established, unpowered. A
// node is a set of terminals continuity found joined to each other; a junction is a diode-mode reading
// between two nodes. This is the single authority for whether a rated part sits ACROSS an input: its
// two terminals on the input's supply node and on ground. A terminal no reading reached is absent,
// never assumed. The circuit is an observation of one unit, so it carries the unit and conditions.
type CircuitNode {
  name: NonEmptyStr
  terminals: List<NonEmptyStr>
}

type JunctionDirection
  = ForwardFrom { anode_node: NonEmptyStr, cathode_node: NonEmptyStr }
  | DirectionUnrecorded

type JunctionReading {
  between: List<NonEmptyStr>
  forward_millivolts: Nat
  direction: JunctionDirection
  reverse_open: Bool
}

type MeasuredCircuit {
  unit: NonEmptyStr
  read_on: NonEmptyStr
  conditions: NonEmptyStr
  nodes: List<CircuitNode>
  junctions: List<JunctionReading>
}

type ConnectorCensus
  = CensusComplete { count: Nat, family: NonEmptyStr }
  | CensusPartial { counted_at_least: Nat, obligation: NonEmptyStr }

type CarrierLayoutObservation {
  labels: List<NonEmptyStr>
  module_receptacles: List<NonEmptyStr>
  main_input_connectors: NonEmptyStr
  auxiliary_connector: NonEmptyStr
  auxiliary_connector_positions: Nat
  auxiliary_connector_rows: List<PinRowContinuity>
  edge_high_speed_connectors: ConnectorCensus
  management_io_observed: List<NonEmptyStr>
  power_components: List<ObservedComponent>
  unresolved_parts: List<NonEmptyStr>
}

// ── THE K1 UNIT ──────────────────────────────────────────────────────────────────────────────

data k1_adjacency_main: PathMembership = OnPathByAdjacency {
  basis: "left-edge close-up: the two MOSFETs, the fuse body at F300/F302 and the Coilcraft inductor sit together in the power stage below the top-edge input blocks, above J20; adjacency, not a traced net",
}

data k1_adjacency_aux: PathMembership = OnPathByAdjacency {
  basis: "left-edge close-up: fuse F1, the R010 shunt, the R150 resistors and the polymer capacitors cluster beside connector J20; adjacency, not a traced net",
}

// J20'S INPUT CIRCUIT AS MEASURED on the E1 carrier, 2026-10-15. The nine J20 supply pins, both ends
// of F1 (it tests intact, so its ends read joined) and D2's tab nearer J20 form one node; the nine
// J20 ground pins, D2's farther tab and the cans' negative terminals form ground. The cans' positive
// terminals are NOT joined to J20's supply: a one-way junction separates them (0.523 V one way, open
// the other; which way was not recorded). D2 itself reads 0.6 V forward from ground to J20's supply,
// so its cathode is on the supply. R010, the switch candidate and the third can were not probed.
data j20_supply_node: NonEmptyStr = "J20 supply"
data board_ground_node: NonEmptyStr = "ground"

data e1_j20_input_circuit: MeasuredCircuit = MeasuredCircuit {
  unit: "the E1-revision P4261 the operator believes was bought from Central Valley",
  read_on: "2026-10-15",
  conditions: "unpowered, module removed, handheld multimeter in continuity and diode modes",
  nodes: [
    CircuitNode { name: j20_supply_node, terminals: ["J20 supply row (9 pins)", "F1 end nearer J20", "F1 end farther from J20", "D2 tab nearer J20"] },
    CircuitNode { name: board_ground_node, terminals: ["J20 ground row (9 pins)", "mounting-hole copper ring", "D2 tab farther from J20", "C10_P5 negative", "C12_P5 negative"] },
    CircuitNode { name: "capacitor rail", terminals: ["C10_P5 positive", "C12_P5 positive"] },
  ],
  junctions: [
    JunctionReading { between: [board_ground_node, j20_supply_node], forward_millivolts: 600, direction: ForwardFrom { anode_node: board_ground_node, cathode_node: j20_supply_node }, reverse_open: false },
    JunctionReading { between: ["capacitor rail", j20_supply_node], forward_millivolts: 523, direction: DirectionUnrecorded, reverse_open: true },
  ],
}

fn node_of(c: MeasuredCircuit, terminal: NonEmptyStr) -> NonEmptyStr? {
  match filter(c.nodes, n => any(n.terminals, t => t == terminal)).first() {
    Absent => Absent
    Present { value: n } => Present { value: n.name }
  }
}

fn on_node(c: MeasuredCircuit, terminal: NonEmptyStr, node: NonEmptyStr) -> Bool {
  match node_of(c: c, terminal: terminal) {
    Absent => false
    Present { value: n } => n == node
  }
}

// THE DEDUCTION. A part whose positive terminal is on the input's supply node and whose return
// terminal is on ground is across that input, and the evidence says so from the circuit itself; any
// other part keeps the membership it would have without the circuit.
fn membership_by_circuit(c: MeasuredCircuit, positive: NonEmptyStr, negative: NonEmptyStr, supply: NonEmptyStr, otherwise: PathMembership) -> PathMembership {
  if on_node(c: c, terminal: positive, node: supply) && on_node(c: c, terminal: negative, node: board_ground_node) {
    RatingAcrossInputRail { evidence: join([
      "measured circuit (", c.unit as String, ", ", c.read_on as String, ", ", c.conditions as String, "): '", positive as String,
      "' is on node '", supply as String, "' and '", negative as String, "' is on node '", board_ground_node as String, "'",
    ], "") as NonEmptyStr }
  } else { otherwise }
}

// THE CAPACITORS' RAIL IS NOT SHOWN TO BE J20'S. Their rating is now a cited fact (63 V); what is not
// established is that the rail they sit on is J20's input, so they stay placed by adjacency and bound
// nothing. The reading that would place them: their positive terminal shown joined to J20's supply
// pins with the board powered, or the board's schematic.
data k1_aux_caps_membership: PathMembership = OnPathByAdjacency {
  basis: "operator continuity readings on the E1 carrier, unpowered, 2026-10-15: each can's negative terminal is tied to ground; its positive terminal is NOT tied to J20's supply pins, and a diode-mode reading between them gives 0.523 V one way and open the other -- a one-way junction separates them, consistent with the body diode of the switch between R010 and the cans, and equally with a converter's switch, which would put the cans on a different rail",
}

