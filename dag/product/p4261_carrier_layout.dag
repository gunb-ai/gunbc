    InstalledComponent { component: e1_q301_resistor, terminals: names(ns: ["end nearer Q301", "far end"]), identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "18D (read from an enlarged photograph; first read as 180)", evidence: e1_resistor_marking_photo } }, discriminator: "the third character read under magnification: '18D' is 150 kohm by the EIA-96 code, which the 26 kohm read across its ends in circuit admits, since a resistor in circuit reads at or below its value; '180', 18 ohm by the three-digit code, that reading excludes" } },
    InstalledComponent { component: e1_component(local: "U2_P1"), terminals: [], identification: FootprintUnpopulated { evidence: e1_photo(taken_on: "2026-10-19", locator: "J20 photograph with the temporary leads and a tape measure, sent in the session") } },
    InstalledComponent { component: e1_component(local: "Q5_P5"), terminals: names(ns: ["single lead", "pair, first lead", "pair, second lead"]), identification: MarkingUnresolved { marking: Absent, discriminator: "read its marking; a back-side SOT-23 in the _P5 group (an enable-network candidate, see p4261_enable_network_hypothesis)" } },
    InstalledComponent { component: e1_component(local: "D5_P5"), terminals: names(ns: ["end nearer the OVLO (pin 8) pad", "other end"]), identification: MarkingUnresolved { marking: Absent, discriminator: "read its marking; a small back-side part in the _P5 group, a different component from the input TVS D5" } },
    InstalledComponent { component: e1_01b, terminals: names(ns: ["one end", "other end"]), identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "01B", evidence: e1_back_photo } }, discriminator: "'01B' is 1.00 kohm in the EIA-96 code (a nominal-value candidate); its maker and its place in the enable network are unread" } },
    InstalledComponent { component: e1_beige, terminals: names(ns: ["top end", "bottom end"]), identification: MarkingUnresolved { marking: Absent, discriminator: beige_part_discriminator } },
    InstalledComponent { component: e1_s1, terminals: names(ns: e1_pole_terminal_names), identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "two-pole DIP package with a printed ON legend, beside J540 and DS3 to DS6", evidence: e1_switch_photo } }, discriminator: "its package marking, and an unpowered continuity reading per pole in each actuator position, which alone says which way a pole closes" } },
    InstalledComponent { component: e1_s2, terminals: names(ns: e1_pole_terminal_names), identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "two-pole DIP package with a printed ON legend, near the large high-density connectors", evidence: e1_switch_photo } }, discriminator: "its package marking, and an unpowered continuity reading per pole in each actuator position, which alone says which way a pole closes" } },
    InstalledComponent { component: e1_j68, terminals: names(ns: e1_j68_points), identification: MarkingUnresolved { marking: Absent, discriminator: "a 2 x 5 header at 0.1 inch, read unpowered 2026-10-21 (e1_j68_resistances) in the shape of Intel's ten-pin JTAG layout, a candidate (j68_jtag_standing); under that map R2 is the reference rail, so no bridge is placed between its positions; its ten points to J20's black lead unpowered on a recorded range against the shorted-probe baseline, which alone joins a point to the return; a 2 x 5 footprint fixes no pinout" } },
    InstalledComponent { component: e1_u21, terminals: [], identification: IdentifiedByMarking { row: pca9617adp, marking: MarkingReading { text: "P617A / 01 14 / 226", evidence: e1_u21_marking_photo } } },
    InstalledComponent { component: e1_u53, terminals: [], identification: IdentifiedByMarking { row: pca9617adp, marking: MarkingReading { text: "P617A / 01 14 / 226", evidence: e1_u21_marking_photo } } },
    InstalledComponent { component: e1_u100, terminals: names(ns: u100_lead_terminals), identification: MarkingUnresolved { marking: Present { value: MarkingReading { text: "C3U / S22 / 25", evidence: e1_u100_photo } }, discriminator: "an 8-lead package (four leads a side, pin-1 dot) beside the 4R7 nearest U4 (e1_u100_photo); its eight leads read on both carriers 2026-10-23 (e1_u100_lead_resistances, k1_u100_lead_resistances): the dot side at the return on both, the far side kilohms, and no lead at the baseline to either inductor pad on the K1, so it is not the inductor's converter. Its code C3U is undecoded; a maker's marking table or the part's own pinout would name it" } },
    InstalledComponent { component: e1_converter_near, terminals: names(ns: converter_pin_terminals), identification: MarkingCandidate { row: mp2333cgtl, marking: MarkingReading { text: "DFP 528", evidence: e1_u100_photo }, discriminator: "the first glyph of this carrier's own part under the Andonstar: a B completes MPS's MP2333CGTL top-marking code 'BDFY / LLL' (year code P, lot 528, the lot the K1's part reads in full); the package (8 leads, four a side, 0.5 mm pitch) and the lead on the inductor's pad fit the row, and the 2026-10-21 photograph counted its leads as five" } },
    InstalledComponent { component: e1_u69, terminals: [], identification: MarkingUnresolved { marking: Absent, discriminator: "an 8-lead package to U21's right (e1_near_4r7_area_photo): its marking under magnification" } },
