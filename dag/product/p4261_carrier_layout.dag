  },
  e1_front_read(b: e1_terminal(c: e1_u43_chain_via, name: "via"), ohms: 800, said: e1_u43_chain_said),
  e1_front_read(b: e1_u500_contact(n: "upper-left contact"), ohms: 1500, said: e1_u500_said),
  e1_front_read(b: e1_u500_contact(n: "upper-right contact"), ohms: 500, said: e1_u500_said),
  e1_front_read(b: e1_u500_contact(n: "right contact 2"), ohms: 800, said: e1_u500_said),
  e1_front_read(b: e1_u500_contact(n: "right contact 3"), ohms: 1400, said: e1_u500_said),
  e1_front_read(b: e1_u500_contact(n: "lower-right contact"), ohms: 1400, said: e1_u500_said),
  e1_front_read(b: e1_u500_contact(n: "left contact 2"), ohms: 1500, said: e1_u500_said),
  ResistanceObservation {
    asset: p4261_e1_b, first: e1_u500_contact(n: "right contact 2"), second: e1_ground_ref,
    record: both_points_recorded,
    conditions: e1_bench, polarity: PolarityUnrecorded, range: RangeFullScale { ohms: 2000 }, display: DisplayZeroWithoutBaseline { reported: "0.00" }, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
