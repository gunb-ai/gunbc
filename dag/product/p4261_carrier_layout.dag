// ── THE E1 UNIT (the operator's bench readings, asset p4261_e1_b) ──────────────────────────────
//
// J20'S INPUT CIRCUIT AS MEASURED, 2026-10-15. The nine J20 supply pins, both ends of F1 (it tests
// intact, so its ends read joined) and D2's tab nearer J20 form one node; the nine J20 ground pins,
// D2's farther tab and the two probed cans' negative terminals form ground. Those cans' positive
// terminals are NOT joined to J20's supply: two diode-mode readings between them gave 523 mV and open,
// with the probe placement unrecorded. D2 read 600 mV with red on ground and black on J20 supply; its
// reverse direction was not read. R010, the switch candidate and the third can were not probed.
data j20_supply_node: NonEmptyStr = "J20 supply"
data board_ground_node: NonEmptyStr = "ground"
data capacitor_rail_node: NonEmptyStr = "capacitor rail"

data e1_j20_input_circuit: MeasuredCircuit = MeasuredCircuit {
  asset: p4261_e1_b,
  read_on: "2026-10-15",
  conditions: "unpowered, module removed, handheld multimeter in continuity and diode modes",
  nodes: [
    CircuitNode { name: j20_supply_node, terminals: ["J20 supply row (9 pins)", "F1 end nearer J20", "F1 end farther from J20", "D2 tab nearer J20"] },
    CircuitNode { name: board_ground_node, terminals: ["J20 ground row (9 pins)", "mounting-hole copper ring", "D2 tab farther from J20", "C10_P5 negative", "C12_P5 negative"] },
    CircuitNode { name: capacitor_rail_node, terminals: ["C10_P5 positive", "C12_P5 positive"] },
  ],
  diode_readings: [
    NodePairReadings {
      nodes: [board_ground_node, j20_supply_node],
      readings: [
        DiodeModeReading { red_on: OnNode { node: board_ground_node }, black_on: OnNode { node: j20_supply_node }, display: ForwardMillivolts { millivolts: 600 } },
      ],
    },
    NodePairReadings {
      nodes: [capacitor_rail_node, j20_supply_node],
      readings: [
        DiodeModeReading { red_on: ProbePlacementUnrecorded, black_on: ProbePlacementUnrecorded, display: ForwardMillivolts { millivolts: 523 } },
        DiodeModeReading { red_on: ProbePlacementUnrecorded, black_on: ProbePlacementUnrecorded, display: OverLimit },
      ],
    },
  ],
}

data e1_adjacency_j20: PathMembership = OnPathByAdjacency {
  basis: "operator close-ups of the E1 carrier, 2026-10-15: the part sits beside J20 and was not probed; adjacency, not a traced net",
}

data e1_adjacency_grey: PathMembership = OnPathByAdjacency {
  basis: "operator close-up of the E1 carrier, 2026-10-15: F300 sits toward the top edge above J20's region and was not probed; adjacency, not a traced net",
}

// The probed cans' fallback when the circuit does not place them across J20 -- which it does not.
data e1_caps_not_across_j20: PathMembership = OnPathByAdjacency {
  basis: "measured circuit on the E1 carrier: the cans' negative terminals are on ground, their positive terminals on a separate 'capacitor rail' node, joined to J20's supply only through a one-way junction (523 mV / open, probe placement unrecorded) -- consistent with the body diode of the switch between R010 and the cans, and equally with a converter's switch, which would put the cans on a different rail",
}

