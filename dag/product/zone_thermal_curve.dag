module product.zone_thermal_curve

import std.types { Bool, Int, List, NonEmptyStr }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.checked_arithmetic { checked_int_to_nat }
import std.optional { Absent, Present }
import std.measure { Celsius, Percent, Second, second_count, celsius, celsius_count, percent, percent_count }

// POLICY: A COOLING ZONE FOLLOWS THE HOTTEST OF A NAMED SENSOR SET THROUGH A CURVE, AND A MISSING
// READING DRIVES FULL DUTY. It names no host, header, BMC family or sensor spelling (DESIGN 3: those
// are a machine row's and a family realization's). Which sensors a zone reads and which header it
// drives are row facts; this module owns only the mapping from readings to duty.
//
// THE FAIL-SAFE IS AN OBLIGATION OF THE CURVE, NOT A CALLER'S CHECK: zone_duty is total over
// the readings and its empty-readings arm is ZoneFailSafe, whose duty is 100 by construction (the
// constructor takes no duty). This is deliberately NOT the fleet guard's posture
// (product.fleet_fan_policy returns to firmware automatic on an unreadable sensor): a passive
// accelerator host's firmware curve keys on the SoC, not the card, and is not a safe place to fall
// back to (butch, 2026-10-30, factory curve idled the A2s at 84-93 C), so here not knowing the
// temperature is a reason for maximum cooling.
//
// A curve is flat at `floor` up to and including `flat_until`, then linear to 100 at `full_at`.
// Integer arithmetic, truncating division. The live a16-fan.sh lin() was read on 2026-10-30
// (sha256 4ff02eb223003349): bash integer d0 + (t-t0)*(100-d0)/(t1-t0), truncating toward zero, and
// the witness pins the interior to it. That script is an observed behaviour this module reproduces
// and replaces at cutover; it is not the authority, and the cutover deletes it.
type ZoneCurve sole_constructor {
  floor: Percent
  flat_until: Celsius
  full_at: Celsius
}

type ZoneDuty
  = ZoneFollowsCurve { hottest: Celsius, duty: Percent }
  | ZoneFailSafe

fn zone_full_duty() -> Percent {
  percent(100)
}

fn zone_hottest(readings: List<Celsius>) -> Celsius? {
  match first(readings) {
    Absent => Absent
    Present { value: head } => Present {
      value: fold(readings, init: head, f: (acc, r) => if celsius_count(r) > celsius_count(acc) { r } else { acc }),
    }
  }
}

// A CURVE EXISTS ONLY IF IT IS A CURVE (the carrier is sole_constructor, as std.interval
// OrderedClosedInterval is): floor within 100 and flat_until strictly below full_at. zone_curve is the
// one mint and refuses with every constraint that failed, never repairing to the floor, so a
// malformed configuration has no ZoneCurve to be read as successful curve-following.
type ZoneCurveRefusal
  = ZoneCurveFloorOverFullDuty
  | ZoneCurveThresholdsNotAscending

type ZoneCurveConstruction
  = ZoneCurveReady { curve: ZoneCurve }
  | ZoneCurveRefused { causes: List<ZoneCurveRefusal> }

fn zone_curve(floor: Percent, flat_until: Celsius, full_at: Celsius) -> ZoneCurveConstruction {
  let causes = concat(
    if percent_count(floor) > 100 { [ZoneCurveFloorOverFullDuty] } else { no_refusals() },
    if celsius_count(flat_until) < celsius_count(full_at) { no_refusals() } else { [ZoneCurveThresholdsNotAscending] },
  )
  if length(causes) == 0 {
    ZoneCurveReady { curve: ZoneCurve { floor: floor, flat_until: flat_until, full_at: full_at } }
  } else {
    ZoneCurveRefused { causes: causes }
  }
}

fn no_refusals() -> List<ZoneCurveRefusal> {
  []
}

fn zone_curve_duty(curve: ZoneCurve, t: Celsius) -> Percent {
  let lo = celsius_count(curve.flat_until)
  let hi = celsius_count(curve.full_at)
  let at = celsius_count(t)
  let floor = percent_count(curve.floor) as Int
  if at <= lo {
    curve.floor
  } else {
    if at >= hi {
      zone_full_duty()
    } else {
      match checked_int_to_nat(n: floor + (100 - floor) * (at - lo) / (hi - lo)) {
        Absent => zone_full_duty()
        Present { value: n } => percent(n)
      }
    }
  }
}

// A ZONE'S REQUIRED SENSORS ARE OBSERVED, AND AN UNREAD ONE IS A VALUE, NOT AN OMISSION. The list can
// repeat a sensor, so exactly one observation per required sensor is demanded (below), not assumed.
// zone_duty proves completeness against the required set before it computes the hottest, so one cool
// reading beside an unread required sensor is ZoneFailSafe and no adapter has to invent a convention
// of replacing a failure with an empty list.
type ZoneSensorStatus
  = ZoneSensorRead { temperature: Celsius }
  | ZoneSensorUnread

type ZoneSensorObservation {
  sensor: NonEmptyStr
  status: ZoneSensorStatus
}

fn zone_sensor_read_temperature(o: ZoneSensorObservation) -> Celsius? {
  match o.status {
    ZoneSensorRead { temperature: t } => Present { value: t }
    ZoneSensorUnread => Absent
  }
}

// THE TEMPERATURE A REQUIRED SENSOR CONTRIBUTES, ABSENT UNLESS IT HAS EXACTLY ONE OBSERVATION AND IT IS
// A READ. A list can write a sensor twice, so a duplicate (Unread beside Read, or two Reads) is
// contradictory evidence and counts as unread: absence of agreement is never a reading.
fn zone_required_temperature(observations: List<ZoneSensorObservation>, sensor: NonEmptyStr) -> Celsius? {
  let mine = filter(observations, o => o.sensor == sensor)
  match first(mine) {
    Absent => Absent
    Present { value: o } => if length(mine) == 1 { zone_sensor_read_temperature(o: o) } else { Absent }
  }
}

fn zone_required_readings(required: List<NonEmptyStr>, observations: List<ZoneSensorObservation>) -> List<Celsius> {
  fold(required, init: [], f: (acc, n) => match zone_required_temperature(observations: observations, sensor: n) {
    Absent => acc
    Present { value: t } => concat(acc, [t])
  })
}

fn zone_duty(curve: ZoneCurve, required: List<NonEmptyStr>, observations: List<ZoneSensorObservation>) -> ZoneDuty {
  let readings = zone_required_readings(required: required, observations: observations)
  if length(required) == 0 || length(readings) != length(required) {
    ZoneFailSafe
  } else {
    match zone_hottest(readings: readings) {
      Absent => ZoneFailSafe
      Present { value: t } => ZoneFollowsCurve { hottest: t, duty: zone_curve_duty(curve: curve, t: t) }
    }
  }
}

fn zone_duty_percent(d: ZoneDuty) -> Percent {
  match d {
    ZoneFailSafe => zone_full_duty()
    ZoneFollowsCurve { hottest: _, duty: p } => p
  }
}

// A ZONE WITH A LOADED AND AN IDLE CURVE (the accelerator zone). Loaded applies while the last
// loaded sample is younger than hold, so the zone steps down only after hold from the last
// loaded sample and there is no temperature hysteresis: a16-fan.sh sets busy_until = now + 60 on a loaded
// sample and applies the loaded curve while now < busy_until. What counts as loaded (power or
// utilisation thresholds) is a reading's meaning, supplied by the realization, not this policy.
type ZoneLoadCurves {
  loaded: ZoneCurve
  idle: ZoneCurve
  hold: Second
}

// `secs_since_loaded` is absent when no loaded sample has been seen, which is idle.
fn zone_curve_for_load(curves: ZoneLoadCurves, since_loaded: Second?) -> ZoneCurve {
  match since_loaded {
    Absent => curves.idle
    Present { value: s } => if second_count(s) < second_count(curves.hold) { curves.loaded } else { curves.idle }
  }
}

// DESIGN section 3c declared frontier: this policy has no consumer in this change.
data zone_thermal_curve_consumer_frontier: DissolutionCondition = unbound_dissolution(
  description: "TRIGGER: the h11 GPU-card host row (gunbc.machine_intake.supermicro_h11ssl_unit1_platform_standing, once its wiring facts land) carries a ZoneCurve or ZoneLoadCurves per cooling zone, and a Supermicro realization renders the host-side controller unit from that row by calling zone_duty. SUFFICIENT FOR: zone_duty and zone_curve_for_load have a production consumer, and gunbc.plans.gpu_card_host_program can delete a16-fan.sh. THE INHABITANCE CLAIM IS PART OF THIS TRIGGER AND IS NOT MET: the witness supplies readings, and no enrolled claim yet shows the rendered controller answering what zone_duty answers." as NonEmptyStr
)
