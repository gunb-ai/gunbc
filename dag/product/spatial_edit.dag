module product.spatial_edit


// SPATIAL-5B: EDITING, AND EVERY EDIT IS A DELTA BY CONSTRUCTION.
//
// SPATIAL-4A made a variant a base plus a KeyedPatch and gave it no constructor that takes a whole
// room list. This band is the other half of that: the vocabulary a caller actually wants - move this
// room, raise that ceiling, add one, remove one - compiled INTO such a patch. There is no function
// here that returns a World, and that absence is the design: an editor that could hand back a world
// would let a caller produce one whose relationship to the base is unrecorded, which is exactly what
// 4A's carrier exists to prevent. What comes out is a patch; realization is 4A's, unchanged.
//
// THE EDIT IS RESOLVED AGAINST THE BASE, which is what makes the compare-and-swap real. A move needs
// the room's CURRENT shape to fill the hunk's `from`, so an edit naming a room the base does not
// have cannot produce a hunk at all - it refuses here rather than producing a hunk that 4A would
// then refuse to apply. Both refusals exist and neither is redundant: this one catches an
// ill-formed edit, 4A's catches a well-formed patch applied to the wrong base.
//
// TWO EDITS TO ONE ROOM IN ONE BATCH REFUSE. A keyed patch has one hunk per key, so a batch touching
// one room twice has no faithful representation - and the two available fabrications are both wrong
// in the silent way: last-writer-wins discards an edit the caller asked for, and composing them
// invents an intermediate state the caller never described. Sequencing two edits is expressible, by
// realizing the first patch and editing the result; it is simply not one patch.
//
// GEOMETRY IS RE-ADMITTED, NOT PATCHED. A moved room is built by running the loop and prism mints on
// the translated coordinates, so a move that would produce a degenerate footprint refuses at the
// geometry authority rather than sliding past it - this module never assembles an EnclosedSpace by
// copying one and swapping fields.

type EditRefusal
  = EditTargetMissing { identity: product.placement_supply.RoomIdentity }
  | EditTargetAlreadyPresent { identity: product.placement_supply.RoomIdentity }
  | RoomEditedTwiceInOneBatch { identity: product.placement_supply.RoomIdentity }
  | EditGeometryRefused { cause: std.orthogonal_geometry.OrthogonalRefusal }
  | EditArithmeticRefused { cause: std.checked_arithmetic.IntegerOverflow }
  | EditFrameRefused { refusal: std.affine_space.SpatialFrameRefusal }

type EditConstruction<T>
  = EditReady { value: T }
  | EditRefused { cause: EditRefusal }

// A CEILING IS SET, NOT NUDGED, and a move is a displacement rather than a destination. The
// asymmetry is deliberate and follows from what each operation means: "raise the ceiling to 2700" is
// how a ceiling is described, and a relative nudge would need the current height to be meaningful to
// the reader; "move the room 500 east" is how a move is described, and an absolute destination for a
// polygon would need an anchor vertex nobody has named.
type RoomEdit
  = AddRoom { identity: product.placement_supply.RoomIdentity, space: std.orthogonal_topology.EnclosedSpace }
  | RemoveRoom { identity: product.placement_supply.RoomIdentity }
  | MoveRoom { identity: product.placement_supply.RoomIdentity, east: Int, north: Int, up: Int }
  | SetCeilingHeight { identity: product.placement_supply.RoomIdentity, high: Int }

fn edit_subject(e: RoomEdit) -> product.placement_supply.RoomIdentity {
  match e {
    AddRoom { identity: i, space: _ } => i
    RemoveRoom { identity: i } => i
    MoveRoom { identity: i, east: _, north: _, up: _ } => i
    SetCeilingHeight { identity: i, high: _ } => i
  }
}

fn room_identity_eq(a: product.placement_supply.RoomIdentity, b: product.placement_supply.RoomIdentity) -> Bool {
  (a as String) == (b as String)
}

fn find_room(rooms: List<product.spatial_world.PlacedSpace>, identity: product.placement_supply.RoomIdentity) -> product.spatial_world.PlacedSpace? {
  fold(rooms, init: none, f: (acc, r) =>
    match acc {
      v2.std.optional.Present { value: found } => v2.std.optional.Present { value: found }
      v2.std.optional.Absent => if room_identity_eq(a: r.identity, b: identity) { v2.std.optional.Present { value: r } } else { none }
    })
}

type VertexAcc {
  moved: List<std.affine_space.Point2>
  refusal: EditRefusal?
}

// Each vertex is translated through std.affine_space, which is where the overflow and frame
// questions already have answers. Re-deriving the translation here with bare integer addition would
// be a second arithmetic authority, and the one that skips the checks.
fn move_vertex(acc: VertexAcc, by: std.affine_space.Vector2, v: std.affine_space.Point2) -> VertexAcc {
  match acc.refusal {
    v2.std.optional.Present { value: c } => VertexAcc { moved: acc.moved, refusal: v2.std.optional.Present { value: c } }
    v2.std.optional.Absent =>
      match std.affine_space.translate_point2(point: v, by: by) {
        std.affine_space.SpatialArithmeticRefused { cause: c } => VertexAcc { moved: acc.moved, refusal: v2.std.optional.Present { value: EditArithmeticRefused { cause: c } } }
        std.affine_space.SpatialFrameRefused { refusal: r } => VertexAcc { moved: acc.moved, refusal: v2.std.optional.Present { value: EditFrameRefused { refusal: r } } }
        std.affine_space.SpatialReady { value: p } => VertexAcc { moved: concat(acc.moved, [p]), refusal: none }
      }
  }
}

fn checked_offset(base: Int, delta: Int) -> EditConstruction<Int> {
  match std.checked_arithmetic.checked_int_add(a: base, b: delta) {
    std.checked_arithmetic.CheckedIntOverflow { cause: c } => EditRefused { cause: EditArithmeticRefused { cause: c } }
    std.checked_arithmetic.CheckedIntReady { value: v } => EditReady { value: v }
  }
}

// The rebuilt space runs both mints, so the result is admissible geometry or a located refusal -
// there is no path here that produces an EnclosedSpace the geometry layer would not have minted.
fn space_from(vertices: List<std.affine_space.Point2>, low: Int, high: Int) -> EditConstruction<std.orthogonal_topology.EnclosedSpace> {
  match std.orthogonal_geometry.orthogonal_loop2(vertices: vertices) {
    std.orthogonal_geometry.OrthogonalRefused { cause: c } => EditRefused { cause: EditGeometryRefused { cause: c } }
    std.orthogonal_geometry.OrthogonalReady { value: l } =>
      match std.orthogonal_geometry.orthogonal_prism3(footprint: l, low: low, high: high) {
        std.orthogonal_geometry.OrthogonalRefused { cause: c } => EditRefused { cause: EditGeometryRefused { cause: c } }
        std.orthogonal_geometry.OrthogonalReady { value: p } => EditReady { value: std.orthogonal_topology.enclosed_space(shell: std.orthogonal_topology.closed_shell_of_prism(prism: p)) }
      }
  }
}

fn space_low(s: std.orthogonal_topology.EnclosedSpace) -> Int {
  std.affine_space.signed_frame_component_count(c: std.orthogonal_geometry.prism3_low(p: std.orthogonal_topology.shell_prism(s: std.orthogonal_topology.space_shell(s: s))))
}

fn space_high(s: std.orthogonal_topology.EnclosedSpace) -> Int {
  std.affine_space.signed_frame_component_count(c: std.orthogonal_geometry.prism3_high(p: std.orthogonal_topology.shell_prism(s: std.orthogonal_topology.space_shell(s: s))))
}

fn moved_space(current: std.orthogonal_topology.EnclosedSpace, east: Int, north: Int, up: Int) -> EditConstruction<std.orthogonal_topology.EnclosedSpace> {
  let footprint = std.orthogonal_topology.space_footprint(s: current)
  let by = std.affine_space.vector2(frame: footprint.frame, x: east, y: north)
  let acc = fold(std.orthogonal_geometry.loop2_vertices(l: footprint), init: VertexAcc { moved: [], refusal: none }, f: (a, v) =>
    move_vertex(acc: a, by: by, v: v))
  match acc.refusal {
    v2.std.optional.Present { value: c } => EditRefused { cause: c }
    v2.std.optional.Absent =>
      match checked_offset(base: space_low(s: current), delta: up) {
        EditRefused { cause: c } => EditRefused { cause: c }
        EditReady { value: low } =>
          match checked_offset(base: space_high(s: current), delta: up) {
            EditRefused { cause: c } => EditRefused { cause: c }
            EditReady { value: high } => space_from(vertices: acc.moved, low: low, high: high)
          }
      }
  }
}

fn raised_space(current: std.orthogonal_topology.EnclosedSpace, high: Int) -> EditConstruction<std.orthogonal_topology.EnclosedSpace> {
  space_from(vertices: std.orthogonal_geometry.loop2_vertices(l: std.orthogonal_topology.space_footprint(s: current)), low: space_low(s: current), high: high)
}

// ONE EDIT, ONE HUNK, AND THE HUNK'S `from` COMES FROM THE BASE. An add is the only arm that does not
// read the base for a value, and it is the only one that refuses when the room IS there.
fn edit_to_hunk(base: product.spatial_world.World, e: RoomEdit) -> EditConstruction<std.change.KeyedDiffHunk<product.placement_supply.RoomIdentity, std.orthogonal_topology.EnclosedSpace>> {
  let current = find_room(rooms: product.spatial_world.world_rooms(w: base), identity: edit_subject(e: e))
  match e {
    AddRoom { identity: i, space: s } =>
      match current {
        v2.std.optional.Present { value: _ } => EditRefused { cause: EditTargetAlreadyPresent { identity: i } }
        v2.std.optional.Absent => EditReady { value: std.change.KeyedDiffAddedHunk { hunk_key: i, to: s } }
      }
    RemoveRoom { identity: i } =>
      match current {
        v2.std.optional.Absent => EditRefused { cause: EditTargetMissing { identity: i } }
        v2.std.optional.Present { value: r } => EditReady { value: std.change.KeyedDiffRemovedHunk { hunk_key: i, from: r.space } }
      }
    MoveRoom { identity: i, east: east, north: north, up: up } =>
      match current {
        v2.std.optional.Absent => EditRefused { cause: EditTargetMissing { identity: i } }
        v2.std.optional.Present { value: r } =>
          match moved_space(current: r.space, east: east, north: north, up: up) {
            EditRefused { cause: c } => EditRefused { cause: c }
            EditReady { value: s } => EditReady { value: std.change.KeyedDiffModifiedHunk { hunk_key: i, from: r.space, to: s } }
          }
      }
    SetCeilingHeight { identity: i, high: high } =>
      match current {
        v2.std.optional.Absent => EditRefused { cause: EditTargetMissing { identity: i } }
        v2.std.optional.Present { value: r } =>
          match raised_space(current: r.space, high: high) {
            EditRefused { cause: c } => EditRefused { cause: c }
            EditReady { value: s } => EditReady { value: std.change.KeyedDiffModifiedHunk { hunk_key: i, from: r.space, to: s } }
          }
      }
  }
}

fn count_edits_for(edits: List<RoomEdit>, wanted: product.placement_supply.RoomIdentity) -> Int {
  fold(edits, init: 0, f: (n, e) => if room_identity_eq(a: edit_subject(e: e), b: wanted) { n + 1 } else { n })
}

fn first_double_edit(edits: List<RoomEdit>) -> product.placement_supply.RoomIdentity? {
  fold(edits, init: none, f: (found, e) =>
    match found {
      v2.std.optional.Present { value: i } => v2.std.optional.Present { value: i }
      v2.std.optional.Absent =>
        if count_edits_for(edits: edits, wanted: edit_subject(e: e)) > 1 {
          v2.std.optional.Present { value: edit_subject(e: e) }
        } else {
          none
        }
    })
}

type HunkAcc {
  hunks: List<std.change.KeyedDiffHunk<product.placement_supply.RoomIdentity, std.orthogonal_topology.EnclosedSpace>>
  refusal: EditRefusal?
}

fn edits_to_patch(base: product.spatial_world.World, edits: List<RoomEdit>) -> EditConstruction<std.change.KeyedPatch<product.placement_supply.RoomIdentity, std.orthogonal_topology.EnclosedSpace>> {
  match first_double_edit(edits: edits) {
    v2.std.optional.Present { value: i } => EditRefused { cause: RoomEditedTwiceInOneBatch { identity: i } }
    v2.std.optional.Absent =>
      let acc = fold(edits, init: HunkAcc { hunks: [], refusal: none }, f: (a, e) =>
        match a.refusal {
          v2.std.optional.Present { value: c } => HunkAcc { hunks: a.hunks, refusal: v2.std.optional.Present { value: c } }
          v2.std.optional.Absent =>
            match edit_to_hunk(base: base, e: e) {
              EditRefused { cause: c } => HunkAcc { hunks: a.hunks, refusal: v2.std.optional.Present { value: c } }
              EditReady { value: h } => HunkAcc { hunks: concat(a.hunks, [h]), refusal: none }
            }
        })
      match acc.refusal {
        v2.std.optional.Present { value: c } => EditRefused { cause: c }
        v2.std.optional.Absent => EditReady { value: std.change.KeyedPatch { hunks: acc.hunks } }
      }
  }
}

fn edits_to_variant(base: product.spatial_world.World, edits: List<RoomEdit>) -> EditConstruction<product.spatial_world.WorldVariant> {
  match edits_to_patch(base: base, edits: edits) {
    EditRefused { cause: c } => EditRefused { cause: c }
    EditReady { value: p } => EditReady { value: product.spatial_world.world_variant(base: base, delta: p) }
  }
}

// THE TWO REFUSAL VOCABULARIES STAY SEPARATE. An edit that could not be COMPILED is this module's
// refusal; a patch that could not be APPLIED - because the result is not a legal world - is 4A's,
// and it arrives here unchanged inside its own carrier. Flattening them into one sum would lose the
// distinction between "the instruction was wrong" and "the instruction was right and the result is
// not a world", which have different remedies: rewrite the edit, or accept that the layout does not
// admit it.
type EditOutcome
  = EditNotCompiled { cause: EditRefusal }
  | EditRealized { result: product.spatial_world.WorldConstruction<product.spatial_world.World> }

fn apply_edits(base: product.spatial_world.World, edits: List<RoomEdit>) -> EditOutcome {
  match edits_to_variant(base: base, edits: edits) {
    EditRefused { cause: c } => EditNotCompiled { cause: c }
    EditReady { value: v } => EditRealized { result: product.spatial_world.realize_variant(v: v) }
  }
}
