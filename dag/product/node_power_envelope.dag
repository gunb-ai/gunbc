// WHAT A NODE DRAWS AND WHAT ITS MEMORY DELIVERS — the electrical and bandwidth half of a build,
// kept apart from what the build COSTS (product.build_fulfillment). They answer different questions;
// fusing them was the shape of the deleted product.hardware_selection, where a candidate record
// carried a synthetic price beside a real wall-draw and neither could be used without the other.
//
// RELOCATED, NOT REWRITTEN (2026-08-19). effective_data_rate_mts, memory_bandwidth, memory_power,
// the DC/AC wall-draw pair and psu_is_adequate came from product.hardware_selection when it was
// deleted at the root. What changed is their INPUTS: a cited PopulationOption from
// gunbc.memory_provisioning and a cited CpuModelCatalogRow replace the deleted module's
// hand-authored Platform/CpuCandidate/MemoryConfig records, so a population this repository refuses
// upstream cannot be priced electrically here. The physics and its witnesses did not change.
//
// NO PRICES LIVE HERE, and no candidate records. A power envelope is a fact about hardware; a
// candidate is a decision about buying it.

// --- the memory channel context this module needs ----------------------------------------------

// WHAT THIS MODULE ADDS TO THE UPSTREAM GEOMETRY, AND NOTHING ELSE. Channel count, admitted
// topology and DRAM generation are already gunbc.memory_provisioning's MemoryChannelGeometry, so
// they are referenced, not restated — a second channels field would be two authorities for one
// fact. The new fact is the platform's rated transfer rate, an electrical figure the population
// derivation has no reason to carry.
//
// The POPULATED depth is not a field either: it is a property of the chosen population, read from
// that population's coverage below. A board with two DIMMs per channel populated one-deep is
// electrically one-deep, and the only authority for which happened is the PopulationOption.
type MemoryElectricalContext {
  geometry: MemoryChannelGeometry
  max_data_rate: MegatransfersPerSecond
  two_dpc_ceilings: TwoDpcRateCeilingTable
}

// THE 2DPC DERATING TABLE, AND THE CITATION ON THE TABLE. These ceilings arrived with the
// physics relocated from the deleted product.hardware_selection, where they were uncited literals
// 2933 MT/s (min two ranks) and 2400 MT/s (min four ranks). Moving them onto an Ampere citation
// needs an authority actually read.
//
// READ 2026-09-10: Ampere Altra Rev A1 Processor Datasheet issue 1.50 section 2.10 states "Up to
// DDR4-3200" and "Up to 2 DPC" and does not publish a rank-dependent 2DPC derate table. The Altra
// Platform Hardware Design Specification v1.00 carries 2DPC topology (section 2.2) and no rate
// table. The OCP Mt. Jade specification rev 1.0 (Ampere-contributed) states DIMM speed as
// DDR4-3200 at 2DPC (section 7.1). Those figures are a PLATFORM CEILING, not an operating rate
// for every 1R/2R/4R two-DIMM fill. THE TRANSCRIBED 2933/2400 FIGURES ARE NOT IN THE PUBLIC
// AMPERE SOURCES THIS REPOSITORY MAY CARRY, and they stay retracted. Gated AVL / PCB Layout
// Guidelines remain unread (HTTP 403): that unreadness cannot prove a derate and cannot prove
// there is none. An empty row list is therefore UNRESOLVED for a 2DPC effective rate, not a
// cited default of the maximum.
type TwoDpcRateCeiling {
  min_rank_count: Nat
  ceiling: MegatransfersPerSecond
}

type TwoDpcRateCeilingTable {
  rows: List<TwoDpcRateCeiling>
  evidence: CitedFigureStanding
}

data altra_two_dpc_ceilings: TwoDpcRateCeilingTable = TwoDpcRateCeilingTable {
  rows: [],
  evidence: TranscribedUncited {
    read_obligation: "Ampere Customer Connect AVL issue 1.15 and Altra PCB Layout Guidelines (HTTP 403): rank-dependent 2DPC operating rate" as NonEmptyStr,
  },
}

// A full-channel population is as deep as its topology says; a partial one has
// dark channels and the populated ones are single-deep, which is what
// documented_coverage means by PartialChannel.
fn populated_dimms_per_channel(population: PopulationOption) -> Nat {
  match population.coverage {
    FullChannel { topology: t } => dimms_per_channel_count(topology: t)
    PartialChannel { channels_populated: _, channels_dark: _ } => 1
  }
}

// THE 2DPC CLOCK IS UNRESOLVED UNLESS A RANK-SPECIFIC ROW APPLIES. The platform maximum
// (context.max_data_rate) is a capability ceiling, never the init of this fold: folding from
// that maximum over an empty table manufactures 3200 for every rank count.
fn min_nat(a: Nat, b: Nat) -> Nat {
  if a < b { a } else { b }
}

fn min_rate(a: MegatransfersPerSecond, b: MegatransfersPerSecond) -> MegatransfersPerSecond {
  megatransfers_per_second(
    count: min_nat(a: megatransfers_per_second_count(r: a), b: megatransfers_per_second_count(r: b)),
  )
}

type ChannelClockUnresolvedCause
  = RankSpecificRateMissing
  | RankSpecificRateUncited { read_obligation: NonEmptyStr }

type ChannelClock
  = ChannelClockAdmitted { rate: MegatransfersPerSecond }
  | ChannelClockUnresolved {
      dimms_per_channel: Nat
      rank_count: Nat
      platform_max: MegatransfersPerSecond
      cause: ChannelClockUnresolvedCause
    }

fn apply_rank_ceiling_row(
  acc: MegatransfersPerSecond?,
  row: TwoDpcRateCeiling,
  rank_count: Nat,
) -> MegatransfersPerSecond? {
  if rank_count >= row.min_rank_count {
    match acc {
      Absent => Present { value: row.ceiling }
      Present { value: acc_rate } => Present { value: min_rate(a: acc_rate, b: row.ceiling) }
    }
  } else {
    acc
  }
}

fn rank_specific_2dpc_clock(
  table: TwoDpcRateCeilingTable,
  platform_max: MegatransfersPerSecond,
  rank_count: Nat,
) -> ChannelClock {
  let matched = fold(table.rows, init: none, f: fn(acc, row) {
    apply_rank_ceiling_row(acc: acc, row: row, rank_count: rank_count)
  })
  match matched {
    Absent => ChannelClockUnresolved {
      dimms_per_channel: 2,
      rank_count: rank_count,
      platform_max: platform_max,
      cause: RankSpecificRateMissing,
    }
    Present { value: ceiling } => match table.evidence {
      TranscribedUncited { read_obligation: obligation } => ChannelClockUnresolved {
        dimms_per_channel: 2,
        rank_count: rank_count,
        platform_max: platform_max,
        cause: RankSpecificRateUncited { read_obligation: obligation },
      }
      CitedToAuthority { authority: _ } =>
        ChannelClockAdmitted { rate: min_rate(a: ceiling, b: platform_max) }
      ObservedByReceipt { observed: _ } =>
        ChannelClockAdmitted { rate: min_rate(a: ceiling, b: platform_max) }
    }
  }
}

fn cited_channel_clock(
  context: MemoryElectricalContext,
  dimms_per_channel: Nat,
  rank_count: Nat,
) -> ChannelClock {
  if dimms_per_channel <= 1 {
    ChannelClockAdmitted { rate: context.max_data_rate }
  } else {
    rank_specific_2dpc_clock(
      table: context.two_dpc_ceilings,
      platform_max: context.max_data_rate,
      rank_count: rank_count,
    )
  }
}

fn dram_channel_bus_bytes() -> ByteSize {
  byte_size(count: bit_width_count(b: dram_data_word_width) / bits_per_byte())
}

// A second rank per channel lets the controller interleave, so a rank-starved
// population does not reach the bus's rated throughput even at its rated clock.
fn rank_interleave_percent(rank_count: Nat) -> Percent {
  if rank_count >= 2 { percent(count: 100) } else { percent(count: 90) }
}

// The platform downclocks to the SLOWEST module present, so the rated figure is
// the minimum of what the module can do and what the topology admits.
type MemoryBandwidthReading
  = MemoryBandwidthDerived { bandwidth: Bandwidth }
  | MemoryBandwidthUnresolved {
      dimms_per_channel: Nat
      rank_count: Nat
      platform_max: MegatransfersPerSecond
      cause: ChannelClockUnresolvedCause
    }

fn memory_bandwidth(
  context: MemoryElectricalContext,
  population: PopulationOption,
) -> MemoryBandwidthReading {
  let module = population.module
  let dpc = populated_dimms_per_channel(population: population)
  match cited_channel_clock(
    context: context,
    dimms_per_channel: dpc,
    rank_count: module.rank_count,
  ) {
    ChannelClockUnresolved { dimms_per_channel: d, rank_count: r, platform_max: m, cause: c } =>
      MemoryBandwidthUnresolved {
        dimms_per_channel: d,
        rank_count: r,
        platform_max: m,
        cause: c,
      }
    ChannelClockAdmitted { rate: er } => {
      let rated = min_nat(
        a: module.data_rate_mts,
        b: megatransfers_per_second_count(r: er),
      )
      let interleaved = rated * percent_count(p: rank_interleave_percent(rank_count: module.rank_count)) / 100
      MemoryBandwidthDerived {
        bandwidth: Bandwidth {
          count: interleaved
            * mega_factor()
            * byte_size_count(b: dram_channel_bus_bytes())
            * context.geometry.channels,
        },
      }
    }
  }
}

// --- DIMM POWER AS A FUNCTION OF TRAFFIC, TEMPERATURE AND THE PART ------------------------------
//
// REPLACES memory_power's per-chip constant times devices_per_stick (host thermal plan finding B).
// That arithmetic multiplied one arbitrary per-chip constant by the die count and had no traffic,
// operating-state, temperature, buffer or evidentiary model (about 58 W per M393A8G40D40 stick at the
// witness's 400 mW); it is deleted, not kept beside this. Per-die IDD currents legitimately use the
// die count; the defect was the constant, not the count. Two evidence paths and no third:
//   1. PART CURRENTS: the part's per-die IDD profile (extdeps.memory.types DramCurrentProfile) by the
//      DDR4 current-based method. Background current on every die; activate, read and write on the
//      addressed rank's dies only; refresh at tRFC/tREFI, DOUBLED above 85 C.
//   2. CLASS BOUND: product.dimm_class_power_bound, a conservative ceiling by generation,
//      class and capacity, used when no part evidence resolves.
// A module resolving through neither REFUSES; it never reads as zero or as a default. The reading
// carries the figure's CitedFigureStanding so a bet is never consumed as deduced (DESIGN 4d).
//
// Consumers: node_draw below (and through it psu_adequacy and derived_wall_power). Declared later
// consumers: P3 (host envelope) and P5 (steady-state prediction) of
// gunbc.plans.host_thermal_operating_point.
// The row-activation duty cannot be guessed and has no producer yet: the planned
// ReadMemoryTrafficStanding observation covers read and write bandwidth only. Until an observation of
// ACT/PRE (or a cited bound) exists, a part-current reading REFUSES rather than minting a wattage over
// an arbitrary activation fraction. An uncited duty is a bet and is treated as not established.
type DimmActivation
  = ActivationNotEstablished { read_obligation: NonEmptyStr }
  | ActivationEstablished { duty: Permille, standing: CitedFigureStanding }

type DimmTraffic {
  read: Bandwidth
  write: Bandwidth
  activation: DimmActivation
}

// The DDR4 refresh bands are stated on TCASE, the DRAM CASE temperature (extdeps.memory.jedec
// Ddr4RefreshBand), not on the module's on-board sensor. A sensor reading is a different quantity, and
// this repository holds no sensor-to-case conversion (the plan names that relationship as missing).
// This is a plain record and .dag has no module-private constructor, so the type NAME is the caller's
// declaration that the value is a TCASE source; it is not a guarantee the type enforces.
type DramCaseTemperature {
  tcase: Celsius
}

type DimmLoad {
  traffic: DimmTraffic
  case_temperature: DramCaseTemperature
}

type DimmPowerEvidence {
  parts: List<DramPartCurrentEvidence>
  class_bounds: List<DramClassPowerBound>
}

type DimmPowerRefusalCause
  = NoPartEvidenceAndNoClassBound { part_number: NonEmptyStr }
  | AmbiguousPartEvidence { part_number: NonEmptyStr, candidate_count: Nat }
  | TrafficExceedsModulePeak { demanded: Bandwidth, peak: Bandwidth }
  | TemperatureBeyondExtendedBand { tcase: Celsius, extended_band_standing: CitedFigureStanding }
  | RefreshBandLimitUnestablished { tcase: Celsius, read_obligation: NonEmptyStr }
  | RefreshBandUnread { read_obligation: NonEmptyStr }
  | UnsupportedDramGeneration { part_number: NonEmptyStr }
  | ActivationDutyOutOfRange { duty: Permille }
  | AmbiguousClassBound { part_number: NonEmptyStr, candidate_count: Nat }
  | UncitedPartEvidenceAndNoClassBound { part_number: NonEmptyStr, read_obligation: NonEmptyStr }
  | ActivationDutyUnestablished { read_obligation: NonEmptyStr }

type DimmPowerReading
  = DimmPowerFromPartCurrents { power: Milliwatt, grounds: DimmPowerGrounds }
  | DimmPowerFromClassBound { power: Milliwatt, grounds: DimmPowerGrounds }
  | DimmPowerRefused { cause: DimmPowerRefusalCause }

fn div_ceil(a: Nat, b: Nat) -> Nat {
  (a + b - 1) / b
}

fn nat_sub_floor(a: Nat, b: Nat) -> Nat {
  if a > b { a - b } else { 0 }
}

// THE REFRESH BAND IS READ FROM extdeps.memory.jedec, NOT RESTATED: its upper TCASE edges and tREFI
// intervals are the canonical rows, and the refresh multiplier is their interval ratio. The band's own
// standing travels with the answer; above the extended band the part is out of specification and no
// band exists, so the reading is a refusal, never an extrapolated multiplier.
type SelectedRefreshBand {
  extended: Bool
  multiplier: Nat
  normal_standing: CitedFigureStanding
  extended_standing: CitedFigureStanding?
}

// THE GROUNDS OF A DIMM POWER ARE SEVERAL INDEPENDENT FACTS, each with its own standing, and none is
// collapsed into another (DESIGN 4d): the current profile or class ceiling, the normal band row, the
// extended band row (present only when the extended band was selected, since the multiplier is the
// ratio of both rows), and the activation duty (present only on the part-current path).
type DimmPowerGrounds {
  profile_or_class: CitedFigureStanding
  normal_band: CitedFigureStanding
  extended_band: CitedFigureStanding?
  activation: CitedFigureStanding?
}

fn grounds_of(base: CitedFigureStanding, band: SelectedRefreshBand, activation: CitedFigureStanding?) -> DimmPowerGrounds {
  DimmPowerGrounds {
    profile_or_class: base,
    normal_band: band.normal_standing,
    extended_band: band.extended_standing,
    activation: activation,
  }
}

type RefreshBandReading
  = RefreshBandSelected { band: SelectedRefreshBand }
  | RefreshBandBeyondSpecification { tcase: Celsius, extended_standing: CitedFigureStanding }
  | RefreshBandNotRead { read_obligation: NonEmptyStr }

fn refresh_band_for(case_temperature: DramCaseTemperature) -> RefreshBandReading {
  refresh_band_from_rows(case_temperature: case_temperature, normal_row: ddr4_normal_refresh_band, extended_row: ddr4_extended_refresh_band)
}

fn refresh_band_from_rows(
  case_temperature: DramCaseTemperature,
  normal_row: RowField<Ddr4RefreshBand>,
  extended_row: RowField<Ddr4RefreshBand>,
) -> RefreshBandReading {
  match normal_row {
    NeedsReading { read_obligation: o } => RefreshBandNotRead { read_obligation: o }
    FromCitedFigure { value: normal, standing: ns } =>
      if celsius_count(c: case_temperature.tcase) <= celsius_count(c: normal.upper_tcase) {
        RefreshBandSelected { band: SelectedRefreshBand { extended: false, multiplier: 1, normal_standing: ns, extended_standing: Absent } }
      } else {
        match extended_row {
          NeedsReading { read_obligation: o } => RefreshBandNotRead { read_obligation: o }
          FromCitedFigure { value: extended, standing: es } =>
            if celsius_count(c: case_temperature.tcase) <= celsius_count(c: extended.upper_tcase) {
              RefreshBandSelected {
                band: SelectedRefreshBand {
                  extended: true,
                  multiplier: nanosecond_count(n: normal.refresh_interval) / nanosecond_count(n: extended.refresh_interval),
                  normal_standing: ns,
                  extended_standing: Present { value: es },
                },
              }
            } else {
              RefreshBandBeyondSpecification { tcase: case_temperature.tcase, extended_standing: es }
            }
        }
      }
  }
}

fn module_peak_bandwidth(module: DramModuleCatalogRow) -> Bandwidth {
  Bandwidth { count: module.data_rate_mts * mega_factor() * byte_size_count(b: dram_channel_bus_bytes()) }
}

fn dimm_power_from_currents(
  module: DramModuleCatalogRow,
  profile: DramCurrentProfile,
  traffic: DimmTraffic,
  activate_duty: Permille,
  refresh_multiplier: Nat,
) -> Milliwatt {
  let peak = bandwidth_count(b: module_peak_bandwidth(module: module))
  let read_pm = div_ceil(a: bandwidth_count(b: traffic.read) * 1000, b: peak)
  let write_pm = div_ceil(a: bandwidth_count(b: traffic.write) * 1000, b: peak)
  let active_dies = dram_chips_per_rank(module: module)
  let all_dies = active_dies * module.rank_count
  let idd3n = milliampere_count(i: profile.idd3n)
  let background = all_dies * idd3n
  let activate = div_ceil(
    a: active_dies * nat_sub_floor(a: milliampere_count(i: profile.idd0), b: idd3n) * permille_count(p: activate_duty),
    b: 1000,
  )
  let read = div_ceil(a: active_dies * nat_sub_floor(a: milliampere_count(i: profile.idd4r), b: idd3n) * read_pm, b: 1000)
  let write = div_ceil(a: active_dies * nat_sub_floor(a: milliampere_count(i: profile.idd4w), b: idd3n) * write_pm, b: 1000)
  let refresh = div_ceil(
    a: all_dies * nat_sub_floor(a: milliampere_count(i: profile.idd5b), b: idd3n)
      * permille_count(p: profile.refresh_duty) * refresh_multiplier,
    b: 1000,
  )
  let total_ma = background + activate + read + write + refresh
  milliwatt(
    count: div_ceil(a: total_ma * millivolt_count(v: profile.supply), b: 1000)
      + milliwatt_count(w: profile.buffer_overhead),
  )
}

fn dimm_power_from_class_bound(bound: DramClassPowerBound, band: SelectedRefreshBand) -> DimmPowerReading {
  DimmPowerFromClassBound {
    power: if band.extended { bound.extended_milliwatts } else { bound.normal_milliwatts },
    grounds: grounds_of(base: bound.standing, band: band, activation: Absent),
  }
}

// WHICH EVIDENCE MAY LOWER THE CEILING. A part-specific profile replaces the conservative class bound
// only when its standing is CITED or OBSERVED; an uncited transcription is a bet and a bet must not
// lower a ceiling (DESIGN 4d). Uncited part evidence beside a class bound keeps the class ceiling;
// uncited part evidence with no class bound refuses rather than minting a derived figure.
fn dimm_power_from_class_selection(
  module: DramModuleCatalogRow,
  evidence: DimmPowerEvidence,
  band: SelectedRefreshBand,
  uncited_obligation: NonEmptyStr?,
) -> DimmPowerReading {
  match dram_class_power_bound_for(bounds: evidence.class_bounds, module: module) {
    ExactlyOneClassBound { bound: bound } => dimm_power_from_class_bound(bound: bound, band: band)
    AmbiguousTightestClassBounds { candidate_count: n } =>
      DimmPowerRefused { cause: AmbiguousClassBound { part_number: module.part_number, candidate_count: n } }
    NoCoveringClassBound =>
      match uncited_obligation {
        Present { value: o } =>
          DimmPowerRefused { cause: UncitedPartEvidenceAndNoClassBound { part_number: module.part_number, read_obligation: o } }
        Absent => DimmPowerRefused { cause: NoPartEvidenceAndNoClassBound { part_number: module.part_number } }
      }
  }
}

// The part-current reading, which needs an ESTABLISHED row-activation duty (cited or observed).
fn dimm_power_from_part(
  module: DramModuleCatalogRow,
  part: DramPartCurrentEvidence,
  load: DimmLoad,
  band: SelectedRefreshBand,
) -> DimmPowerReading {
  match load.traffic.activation {
    ActivationNotEstablished { read_obligation: o } =>
      DimmPowerRefused { cause: ActivationDutyUnestablished { read_obligation: o } }
    ActivationEstablished { duty: d, standing: g } =>
      if permille_count(p: d) > 1000 {
        DimmPowerRefused { cause: ActivationDutyOutOfRange { duty: d } }
      } else {
      match g {
        TranscribedUncited { read_obligation: o } =>
          DimmPowerRefused { cause: ActivationDutyUnestablished { read_obligation: o } }
        CitedToAuthority { authority: _ } =>
          DimmPowerFromPartCurrents {
            power: dimm_power_from_currents(module: module, profile: part.profile, traffic: load.traffic, activate_duty: d, refresh_multiplier: band.multiplier),
            grounds: grounds_of(base: part.standing, band: band, activation: Present { value: g }),
          }
        ObservedByReceipt { observed: _ } =>
          DimmPowerFromPartCurrents {
            power: dimm_power_from_currents(module: module, profile: part.profile, traffic: load.traffic, activate_duty: d, refresh_multiplier: band.multiplier),
            grounds: grounds_of(base: part.standing, band: band, activation: Present { value: g }),
          }
      }
      }
  }
}

fn dimm_power(
  module: DramModuleCatalogRow,
  evidence: DimmPowerEvidence,
  load: DimmLoad,
) -> DimmPowerReading {
  dimm_power_over_bands(module: module, evidence: evidence, load: load, normal_row: ddr4_normal_refresh_band, extended_row: ddr4_extended_refresh_band)
}

// The DDR4 method is DDR4-only: a module of another generation refuses BEFORE any DDR4 refresh band is
// selected, so a DDR5 module with matching part evidence cannot run through DDR4 semantics.
fn dimm_power_over_bands(
  module: DramModuleCatalogRow,
  evidence: DimmPowerEvidence,
  load: DimmLoad,
  normal_row: RowField<Ddr4RefreshBand>,
  extended_row: RowField<Ddr4RefreshBand>,
) -> DimmPowerReading {
  let matches = filter(evidence.parts, e => dram_module_catalog_row_eq(a: e.subject, b: module))
  let demanded = bandwidth_count(b: load.traffic.read) + bandwidth_count(b: load.traffic.write)
  if !dram_generation_eq(a: module.generation, b: dram_generation_ddr4) {
    DimmPowerRefused { cause: UnsupportedDramGeneration { part_number: module.part_number } }
  } else if count(matches) > 1 {
    DimmPowerRefused {
      cause: AmbiguousPartEvidence { part_number: module.part_number, candidate_count: count(matches) },
    }
  } else if demanded > bandwidth_count(b: module_peak_bandwidth(module: module)) {
    DimmPowerRefused {
      cause: TrafficExceedsModulePeak {
        demanded: Bandwidth { count: demanded },
        peak: module_peak_bandwidth(module: module),
      },
    }
  } else {
    match refresh_band_from_rows(case_temperature: load.case_temperature, normal_row: normal_row, extended_row: extended_row) {
      RefreshBandBeyondSpecification { tcase: t, extended_standing: es } =>
        match es {
          CitedToAuthority { authority: _ } =>
            DimmPowerRefused { cause: TemperatureBeyondExtendedBand { tcase: t, extended_band_standing: es } }
          ObservedByReceipt { observed: _ } =>
            DimmPowerRefused { cause: TemperatureBeyondExtendedBand { tcase: t, extended_band_standing: es } }
          TranscribedUncited { read_obligation: o } =>
            DimmPowerRefused { cause: RefreshBandLimitUnestablished { tcase: t, read_obligation: o } }
        }
      RefreshBandNotRead { read_obligation: o } =>
        DimmPowerRefused { cause: RefreshBandUnread { read_obligation: o } }
      RefreshBandSelected { band: band } =>
        match matches.first() {
          Absent =>
            dimm_power_from_class_selection(module: module, evidence: evidence, band: band, uncited_obligation: Absent)
          Present { value: part } =>
            match part.standing {
              TranscribedUncited { read_obligation: o } =>
                dimm_power_from_class_selection(module: module, evidence: evidence, band: band, uncited_obligation: Present { value: o })
              CitedToAuthority { authority: _ } =>
                dimm_power_from_part(module: module, part: part, load: load, band: band)
              ObservedByReceipt { observed: _ } =>
                dimm_power_from_part(module: module, part: part, load: load, band: band)
            }
        }
    }
  }
}

type MemoryPowerReading
  = MemoryPowerDerived { power: Watt, grounds: DimmPowerGrounds }
  | MemoryPowerRefused { cause: DimmPowerRefusalCause }

// Module-grain power over a read population, rounded UP to whole watts (a heat figure never floors).
fn memory_power(
  population: PopulationOption,
  evidence: DimmPowerEvidence,
  load: DimmLoad,
) -> MemoryPowerReading {
  match dimm_power(module: population.module, evidence: evidence, load: load) {
    DimmPowerRefused { cause: c } => MemoryPowerRefused { cause: c }
    DimmPowerFromPartCurrents { power: p, grounds: g } =>
      MemoryPowerDerived {
        power: watt(count: div_ceil(a: milliwatt_count(w: p) * population.dimm_count, b: 1000)),
        grounds: g,
      }
    DimmPowerFromClassBound { power: p, grounds: g } =>
      MemoryPowerDerived {
        power: watt(count: div_ceil(a: milliwatt_count(w: p) * population.dimm_count, b: 1000)),
        grounds: g,
      }
  }
}

// --- CPU POWER AS A FUNCTION OF LOAD AND CAP (finding A) ---------------------------------------
//
// CpuModelCatalogRow.tdp_watts is DESIGN power; the usage power a vendor lists for a named workload
// is a different fact (extdeps.cpu.types CpuUsagePower). The three loads are the three questions a
// consumer can ask. Partial utilisation has NO cited power curve in this repository, so it refuses
// rather than interpolating an invented idle point. A power cap bounds any answer from above.
//
// Consumers: node_draw (design worst case, which sizes the supply) and the later P3/P5 thermal
// prediction (usage and cap). product.cooling_qualification reads the row's design power directly.
type CpuLoad
  = CpuDesignWorstCase
  | CpuRatedUsageWorkload { usage: CpuUsagePower }
  | CpuPartialUtilisation { utilisation: Permille }

type CpuPowerReading
  = CpuPowerDerived { watts: Watt, standing: CitedFigureStanding }
  | CpuPowerRefused { utilisation: Permille, read_obligation: NonEmptyStr }
  | CpuUsageEvidenceForeign { cpu_model: NonEmptyStr, usage_model: NonEmptyStr }

fn capped_watts(watts: Watt, cap: Watt?) -> Watt {
  match cap {
    Absent => watts
    Present { value: c } => if watt_count(w: c) < watt_count(w: watts) { c } else { watts }
  }
}

fn cpu_power(cpu: CpuModelCatalogRow, load: CpuLoad, cap: Watt?) -> CpuPowerReading {
  match load {
    CpuDesignWorstCase =>
      CpuPowerDerived { watts: capped_watts(watts: cpu.tdp_watts, cap: cap), standing: cpu.tdp_standing }
    CpuRatedUsageWorkload { usage: u } =>
      if cpu_model_catalog_row_eq(a: cpu, b: u.subject) {
        CpuPowerDerived { watts: capped_watts(watts: u.watts, cap: cap), standing: u.standing }
      } else {
        CpuUsageEvidenceForeign { cpu_model: cpu.model_number, usage_model: u.subject.model_number }
      }
    CpuPartialUtilisation { utilisation: m } =>
      CpuPowerRefused {
        utilisation: m,
        read_obligation: "a cited per-utilisation power curve for this CPU (Ampere datasheet or a bench measurement): none is held, so partial load is not interpolated" as NonEmptyStr,
      }
  }
}

// --- the whole node --------------------------------------------------------------------------

type EfficiencyRating = Plus80 | Bronze | Silver | Gold | Platinum | Titanium

// 80 PLUS IS AN EXTERNAL PROGRAM AND THIS TABLE IS A SIMPLIFICATION OF IT. The program certifies
// efficiency at FOUR load points (10, 20, 50 and 100 percent) and two input voltages, so one figure
// per rating is at best the 50-percent-load 115 V column — the figures below arrived as uncited
// literals with the physics relocated from the deleted product.hardware_selection.
//
// The consequence is real: a node idling at 15 percent of its supply's rating is materially less
// efficient than this table says, so the derived wall figure is optimistic for a lightly loaded
// machine. That is why the measured arm of this module exists, and why the divergence is reported
// signed rather than reconciled.
//
// DISSOLVES ON: the 80 PLUS specification cited in extdeps/ with its load-point table, at which
// point efficiency becomes a function of load rather than of rating alone.
fn efficiency_percent(e: EfficiencyRating) -> Percent {
  match e {
    Plus80 => percent(count: 80)
    Bronze => percent(count: 85)
    Silver => percent(count: 88)
    Gold => percent(count: 90)
    Platinum => percent(count: 92)
    Titanium => percent(count: 94)
  }
}

// A POPULATION WHOSE EXACT PART IS NOT YET READ IS A REAL STATE OF A REAL PURCHASE — the state of
// the operator's pending configuration now: eight 64 GiB RDIMMs are arriving and the part number
// has not been read. Capacity is answerable (the sticks state it) but DRAW IS NOT, because chip
// count per rank comes from the module's data width and rank count, and a 64 GiB DDR4 module can be
// 2Rx4, 4Rx4 or a stacked-die part with materially different device counts.
//
// So this is a coproduct, not an optional field, and the unread arm carries what IS known plus the
// obligation that closes it. Assuming 2Rx4 to keep the arithmetic runnable would be fabricated
// plausible output at its most expensive: the figure feeds a power allocation, and a wrong one is
// not discovered until the rack is energised.
type MemoryPopulationEvidence
  = PopulationModuleRead { population: PopulationOption }
  | PopulationModuleUnread {
      stick_capacity: ByteSize
      dimm_count: Nat
      read_obligation: NonEmptyStr
    }

// A node's electrical inputs. Board idle draw is declared by the caller because this repository
// cites no row for it yet. The DIMM load (traffic and temperature), the DIMM evidence paths and the
// CPU load are fields for the same reason: each is a figure a reader must supply rather than a
// default buried in the arithmetic.
type NodeElectricalInputs {
  label: NonEmptyStr
  sockets: Nat
  cpu: CpuModelCatalogRow
  context: MemoryElectricalContext
  memory: MemoryPopulationEvidence
  dimm_load: DimmLoad
  dimm_evidence: DimmPowerEvidence
  cpu_load: CpuLoad
  cpu_power_cap: Watt?
  board_idle_draw: Watt
  psu_rated_output: Watt
  psu_efficiency: EfficiencyRating
}

// WHY THE REFUSAL IS TYPED AND NOT A ZERO. A node whose memory draw could not be derived does not
// draw only its processor: a CPU-plus-board figure is an answer a placement decision would happily
// divide a power budget by. The refusal names the obligation, so the missing read is countable and
// actionable rather than absorbed.
type DrawRefusalCause
  = MemoryModuleUnread {
      stick_capacity: ByteSize
      dimm_count: Nat
      read_obligation: NonEmptyStr
    }
  | MemoryPowerUnresolved { cause: DimmPowerRefusalCause }
  | CpuPowerUnresolved { utilisation: Permille, read_obligation: NonEmptyStr }
  | CpuUsageEvidenceForeignToCpu { cpu_model: NonEmptyStr, usage_model: NonEmptyStr }

// EVERY TERM OF THE SUM CARRIES ITS STANDING. The whole-node figure is only as grounded as its
// weakest term, and the board idle draw and the PSU efficiency table are uncited (the 80 PLUS table
// below is a simplification), so a reading never presents as an unqualified derived figure: it
// travels with the four standings that produced it, through node_draw, psu_adequacy and
// derived_wall_power alike.
type NodeDrawStandings {
  memory: DimmPowerGrounds
  cpu: CitedFigureStanding
  board_idle: CitedFigureStanding
  psu_efficiency: CitedFigureStanding
}

data board_idle_draw_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "a cited or bench-measured idle draw for this baseboard: the caller declares it, this repository cites no row" as NonEmptyStr,
}

data psu_efficiency_table_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "the 80 PLUS specification load-point table: one figure per rating is a simplification, optimistic for a lightly loaded node" as NonEmptyStr,
}

type NodeDrawReading
  = NodeDrawDerived { dc_load: Watt, wall_draw: Watt, standings: NodeDrawStandings }
  | NodeDrawRefused { cause: DrawRefusalCause }

fn memory_evidence_refusal(memory: MemoryPopulationEvidence) -> DrawRefusalCause? {
  match memory {
    PopulationModuleRead { population: _ } => none
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o } =>
      Present {
        value: MemoryModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o },
      }
  }
}

// CPU draw per socket is cpu_power over the node's declared load (design worst case by default
// callers choose), once per socket. The earlier home read tdp_watts directly; that figure is
// DESIGN power, and usage power is a separate fact (extdeps.cpu.types CpuUsagePower).
fn cpu_draw_watts(inputs: NodeElectricalInputs) -> CpuPowerReading {
  match cpu_power(cpu: inputs.cpu, load: inputs.cpu_load, cap: inputs.cpu_power_cap) {
    CpuPowerRefused { utilisation: m, read_obligation: o } =>
      CpuPowerRefused { utilisation: m, read_obligation: o }
    CpuUsageEvidenceForeign { cpu_model: c, usage_model: u } =>
      CpuUsageEvidenceForeign { cpu_model: c, usage_model: u }
    CpuPowerDerived { watts: w, standing: g } =>
      CpuPowerDerived { watts: watt(count: watt_count(w: w) * inputs.sockets), standing: g }
  }
}

fn wall_from_dc(dc: Watt, efficiency: EfficiencyRating) -> Watt {
  watt(count: watt_count(w: dc) * 100 / percent_count(p: efficiency_percent(e: efficiency)))
}

fn node_draw(inputs: NodeElectricalInputs) -> NodeDrawReading {
  match inputs.memory {
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o } =>
      NodeDrawRefused {
        cause: MemoryModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o },
      }
    PopulationModuleRead { population: p } =>
      match memory_power(population: p, evidence: inputs.dimm_evidence, load: inputs.dimm_load) {
        MemoryPowerRefused { cause: c } => NodeDrawRefused { cause: MemoryPowerUnresolved { cause: c } }
        MemoryPowerDerived { power: mem, grounds: g } =>
          match cpu_draw_watts(inputs: inputs) {
            CpuPowerRefused { utilisation: m, read_obligation: o } =>
              NodeDrawRefused { cause: CpuPowerUnresolved { utilisation: m, read_obligation: o } }
            CpuUsageEvidenceForeign { cpu_model: c, usage_model: u } =>
              NodeDrawRefused { cause: CpuUsageEvidenceForeignToCpu { cpu_model: c, usage_model: u } }
            CpuPowerDerived { watts: cpu, standing: cs } => {
              let dc = watt(
                count: watt_count(w: cpu)
                  + watt_count(w: mem) * inputs.sockets
                  + watt_count(w: inputs.board_idle_draw),
              )
              NodeDrawDerived {
                dc_load: dc,
                wall_draw: wall_from_dc(dc: dc, efficiency: inputs.psu_efficiency),
                standings: NodeDrawStandings {
                  memory: g,
                  cpu: cs,
                  board_idle: board_idle_draw_standing,
                  psu_efficiency: psu_efficiency_table_standing,
                },
              }
            }
          }
      }
  }
}

// PSU ADEQUACY IS A TYPED VERDICT CARRYING BOTH NUMBERS, not a Bool. A false
// tells a buyer nothing about which supply to buy instead, and the headroom is
// exactly the figure the next decision needs.
type PsuAdequacy
  = PsuAdequate { dc_load: Watt, rated: Watt, headroom: Watt }
  | PsuUndersized { dc_load: Watt, rated: Watt, shortfall: Watt }
  | PsuUndecidable { cause: DrawRefusalCause }

fn psu_adequacy_for_load(load: Watt, rated: Watt) -> PsuAdequacy {
  if watt_count(w: load) <= watt_count(w: rated) {
    PsuAdequate {
      dc_load: load,
      rated: rated,
      headroom: watt(count: watt_count(w: rated) - watt_count(w: load)),
    }
  } else {
    PsuUndersized {
      dc_load: load,
      rated: rated,
      shortfall: watt(count: watt_count(w: load) - watt_count(w: rated)),
    }
  }
}

// A supply cannot be judged adequate for a load nobody could compute, and it
// must not be judged adequate for the load MINUS its memory either.
type NodePsuAdequacy
  = NodePsuAdequacyDerived { verdict: PsuAdequacy, standings: NodeDrawStandings }
  | NodePsuAdequacyUndecidable { cause: DrawRefusalCause }

fn psu_adequacy(inputs: NodeElectricalInputs) -> NodePsuAdequacy {
  match node_draw(inputs: inputs) {
    NodeDrawRefused { cause: c } => NodePsuAdequacyUndecidable { cause: c }
    NodeDrawDerived { dc_load: dc, wall_draw: _, standings: g } =>
      NodePsuAdequacyDerived { verdict: psu_adequacy_for_load(load: dc, rated: inputs.psu_rated_output), standings: g }
  }
}

// --- derived and observed are two facts of the same shape --------------------------------------

// THE MEASUREMENT SEAM. Once a host is built and qualified, someone puts a meter on it, and that
// number is a DIFFERENT FACT from the one derived above — same units, same shape, different
// epistemic standing. Neither overwrites the other: a derived figure that disagrees with a
// measurement is not corrected by deletion; the disagreement locates a modelling error the next
// node will repeat.
//
// So a reading carries its provenance, and the comparison below reports the divergence rather than
// reconciling it. There is deliberately no function taking a measurement and returning a corrected
// derivation.
type WallPowerReading
  = WallPowerDerived { watts: Watt, standings: NodeDrawStandings }
  | WallPowerMeasured { watts: Watt, host: NonEmptyStr, observed_at: EpochMs }

fn reading_watts(reading: WallPowerReading) -> Watt {
  match reading {
    WallPowerDerived { watts: w, standings: _ } => w
    WallPowerMeasured { watts: w, host: _, observed_at: _ } => w
  }
}

// The divergence is signed and named in both directions, because over- and under-prediction have
// different causes and remedies: reading high is usually a TDP standing in for a typical draw;
// reading low usually means a component the model does not carry at all.
type EnvelopeDivergence
  = EnvelopeAgrees { watts: Watt }
  | DerivationReadsHigh { derived: Watt, measured: Watt, excess: Watt }
  | DerivationReadsLow { derived: Watt, measured: Watt, shortfall: Watt }
  | DivergenceNotComparable

fn envelope_divergence(derived: WallPowerReading, measured: WallPowerReading) -> EnvelopeDivergence {
  match derived {
    WallPowerMeasured { watts: _, host: _, observed_at: _ } => DivergenceNotComparable
    WallPowerDerived { watts: d, standings: _ } =>
      match measured {
        WallPowerDerived { watts: _, standings: _ } => DivergenceNotComparable
        WallPowerMeasured { watts: m, host: _, observed_at: _ } =>
          if watt_count(w: d) == watt_count(w: m) {
            EnvelopeAgrees { watts: d }
          } else if watt_count(w: d) > watt_count(w: m) {
            DerivationReadsHigh {
              derived: d,
              measured: m,
              excess: watt(count: watt_count(w: d) - watt_count(w: m)),
            }
          } else {
            DerivationReadsLow {
              derived: d,
              measured: m,
              shortfall: watt(count: watt_count(w: m) - watt_count(w: d)),
            }
          }
      }
  }
}

type DerivedWallPower
  = DerivedWallPowerReading { reading: WallPowerReading }
  | DerivedWallPowerRefused { cause: DrawRefusalCause }

fn derived_wall_power(inputs: NodeElectricalInputs) -> DerivedWallPower {
  match node_draw(inputs: inputs) {
    NodeDrawRefused { cause: c } => DerivedWallPowerRefused { cause: c }
    NodeDrawDerived { dc_load: _, wall_draw: w, standings: g } =>
      DerivedWallPowerReading { reading: WallPowerDerived { watts: w, standings: g } }
  }
}

// --- capacity, for the projector -----------------------------------------------------------------

// CAPACITY ANSWERS EVEN WHEN DRAW REFUSES, and the asymmetry is the point: a stick states its
// capacity on the label, so an unread part number costs nothing here — while the device count that
// decides draw is exactly what the part number carries. Two questions, two evidence requirements,
// answered independently.
fn node_memory_capacity(inputs: NodeElectricalInputs) -> ByteSize {
  match inputs.memory {
    PopulationModuleRead { population: p } =>
      byte_size(count: byte_size_count(b: p.total_bytes) * inputs.sockets)
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: _ } =>
      byte_size(count: byte_size_count(b: c) * n * inputs.sockets)
  }
}
