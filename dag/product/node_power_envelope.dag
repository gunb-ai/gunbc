module product.node_power_envelope


// WHAT A NODE DRAWS AND WHAT ITS MEMORY DELIVERS — the electrical and bandwidth
// half of a build, kept deliberately apart from what the build COSTS
// (product.build_fulfillment). The two answer different questions and a reader
// looking for one would not find it inside the other; fusing them was the shape
// of the deleted product.hardware_selection, where a candidate record carried a
// synthetic price beside a real wall-draw and neither could be used without the
// other.
//
// RELOCATED, NOT REWRITTEN (2026-08-19). effective_data_rate_mts,
// memory_bandwidth, memory_power, the DC/AC wall-draw pair and psu_is_adequate
// came from product.hardware_selection when that module was deleted at the
// root. What changed is their INPUTS: they take a cited PopulationOption from
// gunbc.memory_provisioning and a cited CpuModelCatalogRow rather than the
// deleted module's hand-authored Platform/CpuCandidate/MemoryConfig records,
// so a population this repository refuses upstream has no way to be priced
// electrically here. What did not change is the physics or its witnesses.
//
// NO PRICES LIVE HERE, and no candidate records. A power envelope is a fact
// about hardware; a candidate is a decision about buying it.

// --- the memory channel context this module needs ----------------------------------------------

// WHAT THIS MODULE ADDS TO THE UPSTREAM GEOMETRY, AND NOTHING ELSE. Channel
// count, admitted topology and DRAM generation are already
// gunbc.memory_provisioning's MemoryChannelGeometry, so they are referenced
// rather than restated — a second record carrying its own channels field would
// be two authorities for one fact that could disagree. The genuinely new fact
// is the platform's rated transfer rate, which is an electrical figure the
// population derivation has no reason to carry.
//
// The POPULATED depth is not a field either: it is a property of the population
// that was actually chosen, and it is read from that population's coverage
// below. A board with two DIMMs per channel populated one-deep is electrically
// a one-deep board, and the only authority for which of those happened is the
// PopulationOption.
type MemoryElectricalContext {
  geometry: gunbc.memory_provisioning.MemoryChannelGeometry
  max_data_rate: std.measure.MegatransfersPerSecond
  two_dpc_ceilings: TwoDpcRateCeilingTable
}

// THE 2DPC DERATING TABLE, AND ITS EVIDENCE STANDING BESIDE IT. These ceilings
// arrived with the physics relocated from the deleted product.hardware_selection,
// where they were bare literals with no citation at all. Moving them into
// extdeps/ under this repository's citation duty would require an authority that
// has actually been read, and the Altra platform module states in its own
// coverage note that it transcribes running text and NOT tables — a derating
// table is exactly what it does not carry. Minting a citation there would be the
// fabricated-symbol defect that module's notes exist to prevent.
//
// So the figures are carried where they are consumed, with their uncitedness
// TYPED rather than invisible: a consumer can ask whether the ceiling it just
// used is grounded, and the read obligation names what would ground it. This is
// a declared boundary fact, not a silent constant.
type RateCeilingEvidence
  = CeilingCitedToAuthority { authority: extdeps.external_authority.ExternalAuthority }
  | CeilingTranscribedUncited { read_obligation: std.types.NonEmptyStr }

type TwoDpcRateCeiling {
  min_rank_count: std.nat.Nat
  ceiling: std.measure.MegatransfersPerSecond
  evidence: RateCeilingEvidence
}

type TwoDpcRateCeilingTable {
  rows: List<TwoDpcRateCeiling>
}

fn ceiling_is_cited(evidence: RateCeilingEvidence) -> Bool {
  match evidence {
    CeilingCitedToAuthority { authority: _ } => true
    CeilingTranscribedUncited { read_obligation: _ } => false
  }
}

// The ceilings this repository holds today, all uncited. Named as one
// declaration so the population is countable and a later citation edits one row
// rather than hunting literals.
data altra_two_dpc_ceilings: TwoDpcRateCeilingTable = TwoDpcRateCeilingTable {
  rows: [
    TwoDpcRateCeiling {
      min_rank_count: 4,
      ceiling: std.measure.megatransfers_per_second(count: 2400),
      evidence: CeilingTranscribedUncited {
        read_obligation: "cite the platform or JEDEC DDR4 two-DIMM-per-channel derating table for quad-rank modules; transcribed from the deleted product.hardware_selection, which carried it as a bare literal",
      },
    },
    TwoDpcRateCeiling {
      min_rank_count: 2,
      ceiling: std.measure.megatransfers_per_second(count: 2933),
      evidence: CeilingTranscribedUncited {
        read_obligation: "cite the platform or JEDEC DDR4 two-DIMM-per-channel derating table for dual-rank modules; transcribed from the deleted product.hardware_selection, which carried it as a bare literal",
      },
    },
  ],
}

// A full-channel population is as deep as its topology says; a partial one has
// dark channels and the populated ones are single-deep, which is what
// documented_coverage means by PartialChannel.
fn populated_dimms_per_channel(population: gunbc.memory_provisioning.PopulationOption) -> std.nat.Nat {
  match population.coverage {
    gunbc.memory_provisioning.FullChannel { topology: t } => extdeps.cpu.ampere_altra_platform_hw_design.platform.dimms_per_channel_count(topology: t)
    gunbc.memory_provisioning.PartialChannel { channels_populated: _, channels_dark: _ } => 1
  }
}

// THE 2DPC DOWNCLOCK, and it is rank-dependent. A second module on a channel
// loads the bus; how much depends on how many ranks that module presents, so a
// single-rank pair keeps the platform's rated speed while a quad-rank pair
// falls to 2400 MT/s. These figures are the platform's published 2DPC table.
fn min_nat(a: std.nat.Nat, b: std.nat.Nat) -> std.nat.Nat {
  if a < b { a } else { b }
}

fn min_rate(a: std.measure.MegatransfersPerSecond, b: std.measure.MegatransfersPerSecond) -> std.measure.MegatransfersPerSecond {
  std.measure.megatransfers_per_second(
    count: min_nat(a: std.measure.megatransfers_per_second_count(r: a), b: std.measure.megatransfers_per_second_count(r: b)),
  )
}

// The deepest ceiling any row applies to this rank count. A fold over the table
// rather than a literal ladder, so a third derating row is data and not a new
// branch — and so the table above is genuinely the authority for the numbers
// rather than a restatement of what the code does.
fn ceiling_for_ranks(
  table: TwoDpcRateCeilingTable,
  rated: std.measure.MegatransfersPerSecond,
  rank_count: std.nat.Nat,
) -> std.measure.MegatransfersPerSecond {
  fold(table.rows, init: rated, f: fn(acc, row) {
    if rank_count >= row.min_rank_count { min_rate(a: acc, b: row.ceiling) } else { acc }
  })
}

fn effective_data_rate(
  context: MemoryElectricalContext,
  dimms_per_channel: std.nat.Nat,
  rank_count: std.nat.Nat,
) -> std.measure.MegatransfersPerSecond {
  if dimms_per_channel <= 1 {
    context.max_data_rate
  } else {
    ceiling_for_ranks(
      table: context.two_dpc_ceilings,
      rated: context.max_data_rate,
      rank_count: rank_count,
    )
  }
}

fn dram_channel_bus_bytes() -> std.measure.ByteSize {
  std.measure.byte_size(count: std.measure.bit_width_count(b: extdeps.memory.types.dram_data_word_width) / std.measure.bits_per_byte())
}

// A second rank per channel lets the controller interleave, so a rank-starved
// population does not reach the bus's rated throughput even at its rated clock.
fn rank_interleave_percent(rank_count: std.nat.Nat) -> std.measure.Percent {
  if rank_count >= 2 { std.measure.percent(count: 100) } else { std.measure.percent(count: 90) }
}

// The platform downclocks to the SLOWEST module present, so the rated figure is
// the minimum of what the module can do and what the topology admits.
fn memory_bandwidth(
  context: MemoryElectricalContext,
  population: gunbc.memory_provisioning.PopulationOption,
) -> std.measure.Bandwidth {
  let module = population.module
  let rated = min_nat(
    a: module.data_rate_mts,
    b: std.measure.megatransfers_per_second_count(
      r: effective_data_rate(
        context: context,
        dimms_per_channel: populated_dimms_per_channel(population: population),
        rank_count: module.rank_count,
      ),
    ),
  )
  let interleaved = rated * std.measure.percent_count(p: rank_interleave_percent(rank_count: module.rank_count)) / 100
  std.measure.Bandwidth {
    count: interleaved
      * std.measure.mega_factor()
      * std.measure.byte_size_count(b: dram_channel_bus_bytes())
      * context.geometry.channels,
  }
}

fn devices_per_stick(module: extdeps.memory.types.DramModuleCatalogRow) -> std.nat.Nat {
  extdeps.memory.types.dram_chips_per_rank(module: module) * module.rank_count
}

fn memory_power(
  population: gunbc.memory_provisioning.PopulationOption,
  power_per_chip: std.measure.Milliwatt,
) -> std.measure.Watt {
  std.measure.milliwatt_to_watt_floor(
    w: std.measure.milliwatt(
      count: std.measure.milliwatt_count(w: power_per_chip)
        * devices_per_stick(module: population.module)
        * population.dimm_count,
    ),
  )
}

// --- the whole node --------------------------------------------------------------------------

type EfficiencyRating = Plus80 | Bronze | Silver | Gold | Platinum | Titanium

// 80 PLUS IS AN EXTERNAL PROGRAM AND THIS TABLE IS A SIMPLIFICATION OF IT,
// stated rather than left to be discovered. The program certifies efficiency at
// FOUR load points (10, 20, 50 and 100 percent) and at two input voltages, so a
// single figure per rating is at best the 50-percent-load 115 V column — the
// figures below arrived as bare literals with the physics relocated from the
// deleted product.hardware_selection and no citation came with them.
//
// The consequence is real: a node idling at 15 percent of its supply's rating is
// materially less efficient than this table says, so the derived wall figure is
// optimistic for a lightly loaded machine. That is exactly why the measured arm
// of this module exists, and why the divergence is reported signed rather than
// reconciled.
//
// DISSOLVES ON: the 80 PLUS specification cited in extdeps/ with its load-point
// table, at which point efficiency becomes a function of load rather than of
// rating alone.
fn efficiency_percent(e: EfficiencyRating) -> std.measure.Percent {
  match e {
    Plus80 => std.measure.percent(count: 80)
    Bronze => std.measure.percent(count: 85)
    Silver => std.measure.percent(count: 88)
    Gold => std.measure.percent(count: 90)
    Platinum => std.measure.percent(count: 92)
    Titanium => std.measure.percent(count: 94)
  }
}

// A POPULATION WHOSE EXACT PART IS NOT YET READ IS A REAL STATE OF A REAL
// PURCHASE, and it is the state the operator's pending configuration is in
// right now: eight 64 GiB RDIMMs are arriving and the exact part number has not
// been read. Capacity is still answerable — the sticks state their capacity —
// but DRAW IS NOT, because the chip count per rank comes from the module's data
// width and its rank count, and a 64 GiB DDR4 module can be 2Rx4, 4Rx4 or a
// stacked-die part with materially different device counts.
//
// So this is a coproduct rather than an optional field, and the unread arm
// carries what IS known plus the obligation that closes it. Assuming 2Rx4 to
// keep the arithmetic runnable would be the fabricated plausible output at its
// most expensive: the figure feeds a power allocation, and a wrong one is not
// discovered until the rack is energised.
type MemoryPopulationEvidence
  = PopulationModuleRead { population: gunbc.memory_provisioning.PopulationOption }
  | PopulationModuleUnread {
      stick_capacity: std.measure.ByteSize
      dimm_count: std.nat.Nat
      read_obligation: std.types.NonEmptyStr
    }

// A node's electrical inputs. Board idle draw and per-chip DRAM power are
// declared by the caller because this repository cites no row for either yet;
// naming them as fields keeps them visible as the two figures a reader must
// supply, rather than burying a default inside the arithmetic.
type NodeElectricalInputs {
  label: std.types.NonEmptyStr
  sockets: std.nat.Nat
  cpu: extdeps.cpu.types.CpuModelCatalogRow
  context: MemoryElectricalContext
  memory: MemoryPopulationEvidence
  dram_power_per_chip: std.measure.Milliwatt
  board_idle_draw: std.measure.Watt
  psu_rated_output: std.measure.Watt
  psu_efficiency: EfficiencyRating
}

// WHY THE REFUSAL IS TYPED AND NOT A ZERO. A node whose memory draw could not be
// derived is not a node that draws only its processor: reporting the CPU-plus-
// board figure would be an answer a placement decision would happily divide a
// power budget by. The refusal names the obligation, so the missing read is
// countable and actionable rather than absorbed.
type DrawRefusalCause
  = MemoryModuleUnread {
      stick_capacity: std.measure.ByteSize
      dimm_count: std.nat.Nat
      read_obligation: std.types.NonEmptyStr
    }

type NodeDrawReading
  = NodeDrawDerived { dc_load: std.measure.Watt, wall_draw: std.measure.Watt }
  | NodeDrawRefused { cause: DrawRefusalCause }

fn memory_evidence_refusal(memory: MemoryPopulationEvidence) -> DrawRefusalCause? {
  match memory {
    PopulationModuleRead { population: _ } => none
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o } =>
      Present {
        value: MemoryModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o },
      }
  }
}

// CPU draw is the catalog TDP, once per socket. An earlier home for this
// arithmetic took a hand-authored 'typical_draw' beside the catalog row, which
// is a second representation of one fact that could disagree with the first;
// TDP is what the vendor states and it is what this reads.
fn cpu_draw_watts(inputs: NodeElectricalInputs) -> std.measure.Watt {
  std.measure.watt(count: std.measure.watt_count(w: inputs.cpu.tdp_watts) * inputs.sockets)
}

// The arithmetic over a READ population. Total, and reached only through
// node_draw below, which is where the unread arm is refused.
fn dc_load_over_read_population(inputs: NodeElectricalInputs, population: gunbc.memory_provisioning.PopulationOption) -> std.measure.Watt {
  std.measure.watt(
    count: std.measure.watt_count(w: cpu_draw_watts(inputs: inputs))
      + std.measure.watt_count(w: memory_power(population: population, power_per_chip: inputs.dram_power_per_chip)) * inputs.sockets
      + std.measure.watt_count(w: inputs.board_idle_draw),
  )
}

fn wall_from_dc(dc: std.measure.Watt, efficiency: EfficiencyRating) -> std.measure.Watt {
  std.measure.watt(count: std.measure.watt_count(w: dc) * 100 / std.measure.percent_count(p: efficiency_percent(e: efficiency)))
}

fn node_draw(inputs: NodeElectricalInputs) -> NodeDrawReading {
  match inputs.memory {
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o } =>
      NodeDrawRefused {
        cause: MemoryModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: o },
      }
    PopulationModuleRead { population: p } => {
      let dc = dc_load_over_read_population(inputs: inputs, population: p)
      NodeDrawDerived { dc_load: dc, wall_draw: wall_from_dc(dc: dc, efficiency: inputs.psu_efficiency) }
    }
  }
}

// PSU ADEQUACY IS A TYPED VERDICT CARRYING BOTH NUMBERS, not a Bool. A false
// tells a buyer nothing about which supply to buy instead, and the headroom is
// exactly the figure the next decision needs.
type PsuAdequacy
  = PsuAdequate { dc_load: std.measure.Watt, rated: std.measure.Watt, headroom: std.measure.Watt }
  | PsuUndersized { dc_load: std.measure.Watt, rated: std.measure.Watt, shortfall: std.measure.Watt }
  | PsuUndecidable { cause: DrawRefusalCause }

fn psu_adequacy_for_load(load: std.measure.Watt, rated: std.measure.Watt) -> PsuAdequacy {
  if std.measure.watt_count(w: load) <= std.measure.watt_count(w: rated) {
    PsuAdequate {
      dc_load: load,
      rated: rated,
      headroom: std.measure.watt(count: std.measure.watt_count(w: rated) - std.measure.watt_count(w: load)),
    }
  } else {
    PsuUndersized {
      dc_load: load,
      rated: rated,
      shortfall: std.measure.watt(count: std.measure.watt_count(w: load) - std.measure.watt_count(w: rated)),
    }
  }
}

// A supply cannot be judged adequate for a load nobody could compute, and it
// must not be judged adequate for the load MINUS its memory either.
fn psu_adequacy(inputs: NodeElectricalInputs) -> PsuAdequacy {
  match node_draw(inputs: inputs) {
    NodeDrawRefused { cause: c } => PsuUndecidable { cause: c }
    NodeDrawDerived { dc_load: dc, wall_draw: _ } =>
      psu_adequacy_for_load(load: dc, rated: inputs.psu_rated_output)
  }
}

// --- derived and observed are two facts of the same shape --------------------------------------

// THE MEASUREMENT SEAM. Once a host is built and qualified, someone puts a
// meter on it, and the number that comes back is a DIFFERENT FACT from the one
// derived above — same units, same shape, different epistemic standing. Neither
// overwrites the other: a derived figure that disagreed with a measurement is
// not corrected by deleting it, it is the most interesting thing in the record,
// because the disagreement locates a modelling error the next node will repeat.
//
// So a reading carries its provenance, and the comparison below reports the
// divergence rather than reconciling it. There is deliberately no function that
// takes a measurement and returns a corrected derivation.
type WallPowerReading
  = WallPowerDerived { watts: std.measure.Watt }
  | WallPowerMeasured { watts: std.measure.Watt, host: std.types.NonEmptyStr, observed_at: std.types.EpochMs }

fn reading_watts(reading: WallPowerReading) -> std.measure.Watt {
  match reading {
    WallPowerDerived { watts: w } => w
    WallPowerMeasured { watts: w, host: _, observed_at: _ } => w
  }
}

// The divergence is signed and named in both directions, because over- and
// under-prediction have different causes and different remedies: a derivation
// that reads high is usually a TDP standing in for a typical draw, while one
// that reads low usually means a component the model does not carry at all.
type EnvelopeDivergence
  = EnvelopeAgrees { watts: std.measure.Watt }
  | DerivationReadsHigh { derived: std.measure.Watt, measured: std.measure.Watt, excess: std.measure.Watt }
  | DerivationReadsLow { derived: std.measure.Watt, measured: std.measure.Watt, shortfall: std.measure.Watt }
  | DivergenceNotComparable

fn envelope_divergence(derived: WallPowerReading, measured: WallPowerReading) -> EnvelopeDivergence {
  match derived {
    WallPowerMeasured { watts: _, host: _, observed_at: _ } => DivergenceNotComparable
    WallPowerDerived { watts: d } =>
      match measured {
        WallPowerDerived { watts: _ } => DivergenceNotComparable
        WallPowerMeasured { watts: m, host: _, observed_at: _ } =>
          if std.measure.watt_count(w: d) == std.measure.watt_count(w: m) {
            EnvelopeAgrees { watts: d }
          } else if std.measure.watt_count(w: d) > std.measure.watt_count(w: m) {
            DerivationReadsHigh {
              derived: d,
              measured: m,
              excess: std.measure.watt(count: std.measure.watt_count(w: d) - std.measure.watt_count(w: m)),
            }
          } else {
            DerivationReadsLow {
              derived: d,
              measured: m,
              shortfall: std.measure.watt(count: std.measure.watt_count(w: m) - std.measure.watt_count(w: d)),
            }
          }
      }
  }
}

type DerivedWallPower
  = DerivedWallPowerReading { reading: WallPowerReading }
  | DerivedWallPowerRefused { cause: DrawRefusalCause }

fn derived_wall_power(inputs: NodeElectricalInputs) -> DerivedWallPower {
  match node_draw(inputs: inputs) {
    NodeDrawRefused { cause: c } => DerivedWallPowerRefused { cause: c }
    NodeDrawDerived { dc_load: _, wall_draw: w } =>
      DerivedWallPowerReading { reading: WallPowerDerived { watts: w } }
  }
}

// --- capacity, for the projector -----------------------------------------------------------------

// CAPACITY ANSWERS EVEN WHEN DRAW REFUSES, and that asymmetry is the point
// rather than an inconsistency: a stick states its capacity on the label, so an
// unread part number costs nothing here — while the device count that decides
// draw is exactly what the part number carries. Two questions, two different
// evidence requirements, answered independently.
fn node_memory_capacity(inputs: NodeElectricalInputs) -> std.measure.ByteSize {
  match inputs.memory {
    PopulationModuleRead { population: p } =>
      std.measure.byte_size(count: std.measure.byte_size_count(b: p.total_bytes) * inputs.sockets)
    PopulationModuleUnread { stick_capacity: c, dimm_count: n, read_obligation: _ } =>
      std.measure.byte_size(count: std.measure.byte_size_count(b: c) * n * inputs.sockets)
  }
}
