module product.supplier.ubicloud


// THE MISSING LAYER BETWEEN A CITED PRICE AND A SELECTABLE OFFER.
//
// product.fabric.supply states the division of labour explicitly: "Normalizing a
// supplier's published terms into one of these is the supplier binding's work, and so
// are billing quantum, rounding, minimum charge, fixed and setup charges, caps, and
// when billing starts and stops. The core compares normalized quotes; it does not
// model any supplier's tariff." Until this module existed there were no supplier
// bindings at all: SupplierOffer was constructed only in test fixtures, so the selection fold
// had nothing real to rank. This module is that work for one supplier.
//
// It RESTATES NOTHING. Shapes come from extdeps.cloud.ubicloud, prices from
// extdeps.pricing.ubicloud, and both keep their own citations. A previous attempt in
// this repository re-minted both and produced two disagreeing answers for one vendor
// fact within a day; the rule that prevents it is to consume the row, never copy it.

// THE VENDOR'S OWN BILLING PERIOD IS PRESERVED, NOT NORMALIZED.
//
// Ubicloud bills by the minute, so the quote is QuotedPerMinute and the billing quantum
// is sixty seconds. An earlier revision of this binding squashed the per-minute rate
// into QuotedPerHour because the core had no per-minute arm; that was a twentyfold
// overcharge on a three-minute job, since the hourly arm rounds up to whole billed
// hours. Normalizing a supplier's period is not a presentational choice -- the period
// and the quantum together ARE the tariff, and a binding that discards them hands the
// selection fold a number that is not the price.
fn ubicloud_quote(row: extdeps.pricing.ubicloud.UbicloudRunnerPriceRow) -> product.fabric.supply.OfferQuote {
  product.fabric.supply.QuotedPerMinute(row.per_minute)
}

// Sixty seconds, from the vendor's published per-minute billing. Not a default.
data ubicloud_billing_quantum: std.measure.Second = std.measure.second(count: 60)

// WHAT THE FABRIC'S SHAPE CANNOT SAY.
//
// MEMORY CAME OFF THIS LIST, AND ITS REMOVAL IS THE POINT RATHER THAN A TIDY-UP. This row
// existed because Shape carried only { hard: { threads } }, so a 2-thread runner with 6 GB and a
// 2-thread runner with 8 GB were indistinguishable to a selection fold -- and Ubicloud sells
// exactly that pair. Shape now carries an `envelope`, added for precisely this binding, so the
// memory a catalog row publishes is EXPRESSED (see ubicloud_shape) and MemoryNotExpressibleInShape
// would now be a false statement about the model rather than an honest one about its limits. A
// diagnosis outliving the deficit it diagnoses is worse than absent: it is cited as a known gap
// while the gap is closed.
//
// Disk stays, because nothing in ResourceEnvelope's storage axis is populated from this catalog
// yet, and the fact is still true. That asymmetry is the whole content of this type now.
type UnexpressedSupplyFact
  = DiskNotExpressibleInShape { provided: std.measure.ByteSize }
  | IsolationNotObserved

// A PROJECTION BESIDE THE OFFER, NOT A SECOND KIND OF OFFER. The name matters more than it
// looks: this type was briefly called SupplierOffer, which is also what the fabric carrier is
// called, and the field below then read as referring to this wrapper rather than to the
// carrier it wraps. Two types under one name is the ambiguity the corpus resolves by silent
// last-import-wins, so nothing refuses and the reader cannot tell which one a use means.
type SupplierOfferProjection<P> {
  offer: product.fabric.supply.SupplierOffer<P>
  unexpressed: List<UnexpressedSupplyFact>
}

fn ubicloud_shape(catalog: extdeps.cloud.ubicloud.UbicloudRunnerCatalogRow) -> product.fabric.work.Shape {
  product.fabric.work.Shape {
    hard: product.fabric.work.HardRequirements { threads: catalog.vcpus },
    envelope: product.fabric.envelope.cpu_memory_envelope(
      min_threads: catalog.vcpus,
      architecture: none,
      min_bytes: catalog.memory_bytes,
    ),
  }
}

// THE PROFILE THIS BINDING MAY HONESTLY CLAIM IS THE EMPTY ONE, AND IT IS NOT A PLACEHOLDER.
//
// SupplierOffer.isolation states what an offer PROVIDES, and nobody here has measured what a
// Ubicloud runner provides. The published catalog rows carry vcpus, memory and disk; they say
// nothing about kernel tenancy, namespacing or egress. Naming shared_kernel_sandbox_profile()
// would be inventing a vendor guarantee from its price list -- the fabricated-plausible-output
// failure, and worse than a refusal because a broker would then ROUTE work to it.
//
// An empty guarantee list is fail-closed by construction: unsatisfied_isolation_guarantees
// filters the REQUIRED set against this one, so every guarantee any work asks for comes back
// missing and the offer refuses BY NAME. Work requiring nothing still matches, which is correct.
//
// The empty list alone would conflate "provides none" with "nobody looked", so the projection
// carries IsolationNotObserved beside it -- the same move the disk fact makes, and the thing
// that turns this from a silent zero into a stated coverage obligation.
fn ubicloud_unobserved_isolation() -> product.fabric.isolation.IsolationProfile {
  product.fabric.isolation.IsolationProfile { guarantees: [] }
}

fn ubicloud_unexpressed(catalog: extdeps.cloud.ubicloud.UbicloudRunnerCatalogRow) -> List<UnexpressedSupplyFact> {
  [
    DiskNotExpressibleInShape { provided: catalog.disk_bytes },
    IsolationNotObserved,
  ]
}

// BUYER-SIDE POLICY, DECLARED HERE BECAUSE IT IS OURS AND NOT THE VENDOR'S.
//
// A scraped list price carries no expiry: the vendor publishes a number, not a quote
// with a validity window, while QuotedSupply requires valid_until. The gap is closed by
// OUR freshness policy -- how long we are willing to treat a scraped list price as
// current -- which is a buyer fact and belongs in the product layer. It is NOT a claim
// about what the vendor promised.
data list_price_trust_horizon_note: std.types.NonEmptyStr = "A scraped vendor list price has no stated expiry. valid_until is therefore OUR staleness horizon, not the vendor's commitment. Reading it as a vendor promise would turn a buyer-side policy into a supplier guarantee that nobody made."

// Cloud supply is bounded, never unbounded: supply.dag requires a quantity bound
// because an offer without one cannot be conserved against, and no supplier actually
// claims infinite capacity. Ubicloud publishes no concurrency cap in the cited rows, so
// this is the bound WE would place against, which is a buyer policy and not a vendor
// fact.
data placement_concurrency_bound: Int = 64

// READINESS IS REFUSED, NOT ASSUMED, AND THAT IS THE POINT.
//
// The selection policy is CheapestFungibleWithDelayValuation: ready_at is an INPUT to
// the ranking, not decoration. Guessing it does not merely add an unmeasured field --
// it corrupts the exact comparison the policy exists to make, and it does so silently,
// in the direction that flatters whichever supplier we guessed optimistically about.
// So provisioning delay must be MEASURED, and until it is this binding refuses rather
// than binding an offer that would rank on a fabricated number.
type ReadinessObservation
  = ReadinessMeasured { ready_at: std.types.Timestamp, receipt: product.fabric.demand.ObservationReceiptRef }
  | ReadinessUnmeasured { obligation: std.types.NonEmptyStr }

data ubicloud_readiness: ReadinessObservation = ReadinessUnmeasured {
  obligation: "Provisioning delay from job dispatch to a Ubicloud runner accepting work has not been measured. Start one job per shape, record dispatch and first-heartbeat timestamps, and land the receipt. Until then no Ubicloud offer may be ranked by a delay-valuing policy.",
}

type OfferBinding<P>
  = OfferBound { bound: SupplierOfferProjection<P> }
  | OfferBindingRefused { runs_on_label: std.types.NonEmptyStr, cause: std.types.NonEmptyStr }

fn bind_ubicloud_offer<P>(
  principal: P,
  executor: P,
  row: extdeps.pricing.ubicloud.UbicloudRunnerPriceRow,
  capabilities: product.fabric.work.CapabilityManifestRef,
  trust_domain: product.fabric.work.TrustDomainRef,
  readiness: ReadinessObservation,
  quoted_at: std.types.Timestamp,
  valid_until: std.types.Timestamp,
  receipt: product.fabric.demand.ObservationReceiptRef,
) -> OfferBinding<P> {
  match readiness {
    ReadinessUnmeasured { obligation } =>
      OfferBindingRefused { runs_on_label: row.catalog.runs_on_label, cause: obligation },
    ReadinessMeasured { ready_at, receipt: readiness_receipt } =>
      OfferBound {
        bound: SupplierOfferProjection {
          offer: product.fabric.supply.SupplierOffer {
            id: product.fabric.identity.FabricIdentity { principal: principal, key: row.catalog.runs_on_label },
            executor: executor,
            shape: ubicloud_shape(catalog: row.catalog),
            capabilities: capabilities,
            trust_domain: trust_domain,
            isolation: ubicloud_unobserved_isolation(),
            quantity_bound: placement_concurrency_bound,
            ready_at: ready_at,
            quote: ubicloud_quote(row: row),
            billing_quantum: ubicloud_billing_quantum,
            evidence: product.fabric.supply.QuotedSupply {
              quoted_at: quoted_at,
              valid_until: valid_until,
              receipt: receipt,
            },
          },
          unexpressed: ubicloud_unexpressed(catalog: row.catalog),
        },
      },
  }
}
