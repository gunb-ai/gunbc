module product.altra_motherboard.placement

import std.types { String, Bool, NonEmptyStr, List }
import std.integer { Int }
import std.measure { Micrometer, micrometer, micrometer_count }
import std.coordinate_frame { CoordinateFrameIdentity, coordinate_frame_identity }
import std.affine_space { Point2, point2 }
import std.orthogonal_geometry {
  AxisAlignedRectangle2,
  OrthogonalConstruction,
  OrthogonalReady,
  OrthogonalRefused,
  axis_aligned_rectangle2,
}
import product.compute_board.physical {
  ComponentPlacement,
  PackageBodyEnvelope,
  body_envelope_of_ice40_package,
}
import product.altra_motherboard.minimal_design {
  ActiveDdrChannelCount,
  AltraMinimalMotherboard,
  DesignIntent,
  EightChannels,
  EngineeringBringUp,
  FourChannels,
  OneChannel,
  Production,
  SixChannels,
  TwoChannels,
  altra_1p_minimum,
}
import extdeps.programmable_logic.ice40.subject { ice40_tq144_package }

data placement_note: String = "WHERE THE PARTS GO, AND — MORE IMPORTANTLY HERE — WHICH PARTS THIS REPOSITORY IS ENTITLED TO SAY THAT ABOUT. Placing a component requires its body envelope, and a body envelope is a VENDOR fact: the part is whatever size the vendor made it, and a number chosen because it looks about right is the fabricated plausible output the design forbids, in the form that is hardest to catch. A board layout built from invented dimensions passes every geometric check, draws convincingly, and cannot be assembled. THE BOARD OUTLINE IS A DIFFERENT KIND OF FACT and is authored here without citation, deliberately: how big we make our own board is our decision, not a claim about anyone's document. That asymmetry is the whole reason this module can exist before the mechanical sources are settled — the frame and the outline are ours, the envelopes are not. WHAT IS ACTUALLY ESTABLISHED TODAY is one envelope: the iCE40 TQ144 that serves as board control, whose body dimensions come from a public vendor datasheet already cited in this tree. EVERY OTHER COMPONENT IS AN OBLIGATION RATHER THAN A PLACEMENT, and the gaps are of two different kinds that must not be merged. The Altra package's mechanical data is PUBLISHED — section 3 of the datasheet — but every page of that document is footed Ampere Computing Proprietary, so transcribing it into a PUBLIC repository is a licensing question and not an availability one; that is RedistributionUnresolved, and it is the same distinction the attachment stack already draws between Unresolved and NdaGated. The DIMM sockets, flash, clock, reset, power controllers and endpoints have no chosen part yet, so there is no document to consult at all; that is VendorSelectionNotMade. Merging those two into one absent would be a state-space conflation: the first is answered by a lawyer, the second by an engineer, and reporting either as the other sends the work to the wrong person."

// WHAT A COMPONENT IS ON THIS BOARD, which is what the population is checked against. A roster of
// identities would say the board has twelve parts; a roster of ROLES says it has a processor
// socket, four memory slots and a boot device, which is the claim a design review actually makes.
// The memory slot carries its channel because two slots on one channel and one slot on each of two
// channels are different boards, and an identity-only roster cannot tell them apart.
type BoardComponentRole
  = ProcessorSocket
  | MemoryModuleSlot { channel: Int }
  | BoardControlCpld
  | BootFirmwareEeprom
  | FirmwareFlash
  | ClockGenerator
  | ResetController
  | PowerController
  | NetworkEndpoint
  | StorageEndpoint
  | DebugConnector

// A DISPLAY NAME FOR DIAGNOSTICS, AND DELIBERATELY NOT AN EQUALITY. An earlier revision of this
// module compared roles by this string, which the module's own note warns against: a role compared
// through a rendered name is a role whose equality an edit to that name can redefine. Equality is
// structural below; this exists so a refusal can say WHICH role, and nothing reads it to decide
// whether two roles are the same.
fn role_tag(r: BoardComponentRole) -> NonEmptyStr {
  match r {
    ProcessorSocket => "ProcessorSocket"
    MemoryModuleSlot { channel: _ } => "MemoryModuleSlot"
    BoardControlCpld => "BoardControlCpld"
    BootFirmwareEeprom => "BootFirmwareEeprom"
    FirmwareFlash => "FirmwareFlash"
    ClockGenerator => "ClockGenerator"
    ResetController => "ResetController"
    PowerController => "PowerController"
    NetworkEndpoint => "NetworkEndpoint"
    StorageEndpoint => "StorageEndpoint"
    DebugConnector => "DebugConnector"
  }
}

// EQUALITY IS A DIRECT MATCH ON BOTH SIDES, with no sentinel and no rendered name. An earlier
// revision derived a channel with -1 standing for "this role has no channel", which is a
// degenerate value absorbing ignorance: a processor socket does not have channel minus one, it has
// no channel at all, and the only reason the comparison worked was that the tag happened to gate
// the number. Matching both sides makes the absent channel unrepresentable rather than encoded.
fn roles_equal(a: BoardComponentRole, b: BoardComponentRole) -> Bool {
  match a {
    MemoryModuleSlot { channel: ca } =>
      match b {
        MemoryModuleSlot { channel: cb } => ca == cb
        _ => false
      }
    ProcessorSocket => match b { ProcessorSocket => true  _ => false }
    BoardControlCpld => match b { BoardControlCpld => true  _ => false }
    BootFirmwareEeprom => match b { BootFirmwareEeprom => true  _ => false }
    FirmwareFlash => match b { FirmwareFlash => true  _ => false }
    ClockGenerator => match b { ClockGenerator => true  _ => false }
    ResetController => match b { ResetController => true  _ => false }
    PowerController => match b { PowerController => true  _ => false }
    NetworkEndpoint => match b { NetworkEndpoint => true  _ => false }
    StorageEndpoint => match b { StorageEndpoint => true  _ => false }
    DebugConnector => match b { DebugConnector => true  _ => false }
  }
}

// WHY A DIMENSION IS NOT AVAILABLE, at the grain that decides who fixes it. These are not degrees
// of the same absence: a licensing question is answered by a decision about redistribution, and a
// missing part choice is answered by choosing a part. A single Absent would send both to whoever
// happened to read it.
type EnvelopeGap
  // The vendor publishes the mechanical data, and this repository is public while the document
  // carries a proprietary footer. Availability is not the blocker; redistribution is.
  = RedistributionUnresolved { subject: NonEmptyStr }
  // No part has been selected for this role, so there is no document to consult.
  | VendorSelectionNotMade { role_named: NonEmptyStr }

// AN ENVELOPE IS EITHER ESTABLISHED FROM A SOURCE OR IT IS AN OBLIGATION. There is no third arm
// carrying a provisional number, and that absence is the construction: a placement cannot be built
// from a guess because a guess has no representation here.
type ComponentEnvelopeStanding
  = EnvelopeEstablished { envelope: PackageBodyEnvelope, source: NonEmptyStr }
  | EnvelopeNotEstablished { gap: EnvelopeGap }

type PlannedComponent {
  identity: NonEmptyStr
  role: BoardComponentRole
  envelope: ComponentEnvelopeStanding
  origin: Point2
}

type PlacementRefusal
  // The component cannot be placed because nobody has established how big it is. The gap travels
  // with the refusal so the reader learns which question to ask, not merely that one exists.
  = ComponentEnvelopeNotEstablished { component: NonEmptyStr, gap: EnvelopeGap }
  // A role the design requires that no planned component fills.
  | RequiredRoleUnfilled { role: BoardComponentRole }
  // A component present on the board filling no role the design requires.
  | ComponentFillsNoRequiredRole { component: NonEmptyStr, role_named: NonEmptyStr }

type BoardPlacementPlan {
  frame: CoordinateFrameIdentity
  outline: AxisAlignedRectangle2
  components: List<PlannedComponent>
}

// THE REQUIRED POPULATION IS DERIVED FROM THE DESIGN, never listed beside it. A hand-written
// roster of four memory slots is a second statement of the channel count, and the copy that
// disagrees when someone selects six channels is the one nobody edits.
fn channel_indices(c: ActiveDdrChannelCount) -> List<Int> {
  match c {
    OneChannel => [0]
    TwoChannels => [0, 1]
    FourChannels => [0, 1, 2, 3]
    SixChannels => [0, 1, 2, 3, 4, 5]
    EightChannels => [0, 1, 2, 3, 4, 5, 6, 7]
  }
}

fn required_roles(d: AltraMinimalMotherboard) -> List<BoardComponentRole> {
  let slots = fold(channel_indices(c: d.memory.channels), init: [], f: fn(acc, i) {
    concat(acc, [MemoryModuleSlot { channel: i }])
  })
  concat(
    [ProcessorSocket, BoardControlCpld, BootFirmwareEeprom, FirmwareFlash,
     ClockGenerator, ResetController, PowerController, NetworkEndpoint,
     StorageEndpoint, DebugConnector],
    slots
  )
}

fn plan_fills_role(plan: BoardPlacementPlan, r: BoardComponentRole) -> Bool {
  fold(plan.components, init: false, f: fn(acc, c) { acc || roles_equal(a: c.role, b: r) })
}

fn design_requires_role(d: AltraMinimalMotherboard, r: BoardComponentRole) -> Bool {
  fold(required_roles(d: d), init: false, f: fn(acc, q) { acc || roles_equal(a: q, b: r) })
}

// COMPLETENESS IS AN IDENTITY JOIN, NOT A COUNT. Asserting that the plan has fourteen components
// would pass for a plan with two processor sockets and no clock generator. Both directions are
// walked because they fail differently: a missing role is an unbuilt board, and an extra component
// is a part nobody has justified.
fn population_refusals(d: AltraMinimalMotherboard, plan: BoardPlacementPlan) -> List<PlacementRefusal> {
  let missing = fold(required_roles(d: d), init: [], f: fn(acc, r) {
    if plan_fills_role(plan: plan, r: r) {
      acc
    } else {
      concat(acc, [RequiredRoleUnfilled { role: r }])
    }
  })
  let extra = fold(plan.components, init: [], f: fn(acc, c) {
    if design_requires_role(d: d, r: c.role) {
      acc
    } else {
      concat(acc, [ComponentFillsNoRequiredRole { component: c.identity, role_named: role_tag(r: c.role) }])
    }
  })
  concat(missing, extra)
}

fn envelope_refusals(plan: BoardPlacementPlan) -> List<PlacementRefusal> {
  fold(plan.components, init: [], f: fn(acc, c) {
    match c.envelope {
      EnvelopeEstablished { envelope: _, source: _ } => acc
      EnvelopeNotEstablished { gap: g } =>
        concat(acc, [ComponentEnvelopeNotEstablished { component: c.identity, gap: g }])
    }
  })
}

fn placement_causes(d: AltraMinimalMotherboard, plan: BoardPlacementPlan) -> List<PlacementRefusal> {
  concat(population_refusals(d: d, plan: plan), envelope_refusals(plan: plan))
}

fn placement_refusal_count(cs: List<PlacementRefusal>) -> Int {
  fold(cs, init: 0, f: fn(acc, _c) { acc + 1 })
}

type PlacementAdmission
  = PlacementAdmitted { plan: BoardPlacementPlan }
  | PlacementRefused { causes: List<PlacementRefusal> }

// THE ADMISSION IS THE SAME QUESTION UNDER BOTH INTENTS, and that is deliberate. An unestablished
// envelope is not more acceptable during bring-up: the part is still whatever size it is, and a
// bring-up board that cannot be assembled is not a lesser failure than a production one. The
// intent already decides what the design admits in minimal_design; it does not get a second,
// weaker meaning here.
fn admit_placement(d: AltraMinimalMotherboard, plan: BoardPlacementPlan) -> PlacementAdmission {
  let causes = placement_causes(d: d, plan: plan)
  if placement_refusal_count(cs: causes) == 0 {
    PlacementAdmitted { plan: plan }
  } else {
    PlacementRefused { causes: causes }
  }
}

// ONLY THE COMPONENTS WHOSE SIZE IS KNOWN BECOME PLACEMENTS. This is the bridge to the body-
// envelope collision check, and it deliberately cannot carry an obligation across: a component
// with no established envelope has no extent, so handing it to a geometric check would require
// inventing one. The obligations are reported by the admission above rather than smuggled here
// as zero-sized parts that collide with nothing.
fn placeable_components(plan: BoardPlacementPlan) -> List<ComponentPlacement> {
  fold(plan.components, init: [], f: fn(acc, c) {
    match c.envelope {
      EnvelopeNotEstablished { gap: _ } => acc
      EnvelopeEstablished { envelope: e, source: _ } =>
        concat(acc, [ComponentPlacement { identity: c.identity, body_envelope: e, origin: c.origin }])
    }
  })
}

fn established_envelope_count(plan: BoardPlacementPlan) -> Int {
  fold(placeable_components(plan: plan), init: 0, f: fn(acc, _c) { acc + 1 })
}

fn outstanding_obligation_count(plan: BoardPlacementPlan) -> Int {
  placement_refusal_count(cs: envelope_refusals(plan: plan))
}

// THE BOARD'S OWN FRAME AND OUTLINE, authored rather than cited because they are ours. 305 by 267
// millimetres, drawn in micrometres because the frame is sub-millimetre registered; this is a
// declared board size and NOT a claim of conformance to any mechanical standard. Conformance would
// be a cited constraint checked against this outline, which is a different fact and is not made
// here by choosing similar numbers.
// The frame identity is MINTED, not named. A coordinate frame is an allocator occurrence in the
// spatial-frame space rather than a string, and the distinction is not cosmetic: two frames with
// the same spelling would compare equal while registering different quanta. The board's frame is
// registered by its consumer with a micrometre quantum, which is what physical.dag's sub-millimetre
// requirement checks — a half-millimetre package pitch is not expressible in whole millimetres.
fn altra_board_frame() -> CoordinateFrameIdentity { coordinate_frame_identity(occurrence: 21) }

fn altra_board_outline() -> OrthogonalConstruction<AxisAlignedRectangle2> {
  axis_aligned_rectangle2(
    min: point2(frame: altra_board_frame(), x: 0, y: 0),
    max: point2(frame: altra_board_frame(), x: 305000, y: 267000)
  )
}

// THE ONE ESTABLISHED ENVELOPE. The board-control CPLD is an iCE40 in TQ144, whose body dimensions
// come from the public Lattice datasheet this tree already cites, and are read from the package row
// rather than retyped — so a correction there moves this placement instead of leaving it agreeing
// with a number that has changed.
data board_control_envelope: ComponentEnvelopeStanding = EnvelopeEstablished {
  envelope: body_envelope_of_ice40_package(p: ice40_tq144_package),
  source: "extdeps.programmable_logic.ice40.subject ice40_tq144_package",
}

fn obligation(g: EnvelopeGap, id: NonEmptyStr, r: BoardComponentRole, x: Int, y: Int) -> PlannedComponent {
  PlannedComponent {
    identity: id,
    role: r,
    envelope: EnvelopeNotEstablished { gap: g },
    origin: point2(frame: altra_board_frame(), x: x, y: y),
  }
}

fn memory_slot_obligations(d: AltraMinimalMotherboard) -> List<PlannedComponent> {
  fold(channel_indices(c: d.memory.channels), init: [], f: fn(acc, i) {
    concat(acc, [obligation(
      g: VendorSelectionNotMade { role_named: "MemoryModuleSlot" },
      id: "dimm_slot",
      r: MemoryModuleSlot { channel: i },
      x: 150000,
      y: 20000 + (i * 12000)
    )])
  })
}

// THE REFERENCE PLAN, AND IT REFUSES. That is the honest state of this increment rather than a
// defect in it: one envelope is established and the rest are obligations, so the plan names every
// part the design requires and can place exactly one of them. The refusals are the increment's
// deliverable — each is typed, carries its own cause, and is counted, so the remaining work is
// visible and prioritisable instead of being absent.
fn altra_reference_plan() -> OrthogonalConstruction<BoardPlacementPlan> {
  let fixed = [
    PlannedComponent {
      identity: "board_control_cpld",
      role: BoardControlCpld,
      envelope: board_control_envelope,
      origin: point2(frame: altra_board_frame(), x: 240000, y: 200000),
    },
    obligation(
      g: RedistributionUnresolved { subject: "Ampere Altra package mechanical data, datasheet section 3" },
      id: "cpu_socket", r: ProcessorSocket, x: 60000, y: 90000
    ),
    obligation(g: VendorSelectionNotMade { role_named: "BootFirmwareEeprom" }, id: "boot_eeprom", r: BootFirmwareEeprom, x: 250000, y: 40000),
    obligation(g: VendorSelectionNotMade { role_named: "FirmwareFlash" }, id: "spi_nor", r: FirmwareFlash, x: 260000, y: 60000),
    obligation(g: VendorSelectionNotMade { role_named: "ClockGenerator" }, id: "clock_gen", r: ClockGenerator, x: 220000, y: 150000),
    obligation(g: VendorSelectionNotMade { role_named: "ResetController" }, id: "reset_ctl", r: ResetController, x: 220000, y: 170000),
    obligation(g: VendorSelectionNotMade { role_named: "PowerController" }, id: "power_ctl", r: PowerController, x: 30000, y: 220000),
    obligation(g: VendorSelectionNotMade { role_named: "NetworkEndpoint" }, id: "net_phy", r: NetworkEndpoint, x: 280000, y: 120000),
    obligation(g: VendorSelectionNotMade { role_named: "StorageEndpoint" }, id: "nvme_conn", r: StorageEndpoint, x: 280000, y: 90000),
    obligation(g: VendorSelectionNotMade { role_named: "DebugConnector" }, id: "debug_hdr", r: DebugConnector, x: 200000, y: 250000),
  ]
  match altra_board_outline() {
    // A BOARD WITH NO OUTLINE IS NOT A BOARD WITH A SMALL OUTLINE. An earlier draft of this
    // function answered a refused construction with a degenerate one-micrometre rectangle so the
    // return type could stay simple, which is the absorbing fallback in its purest form: every
    // component would then have been reported as outside the outline, and the real cause — that
    // the outline never constructed — would have been replaced by a dozen plausible ones.
    OrthogonalRefused { cause: c } => OrthogonalRefused { cause: c }
    OrthogonalReady { value: o } =>
      OrthogonalReady {
        value: BoardPlacementPlan {
          frame: altra_board_frame(),
          outline: o,
          components: concat(fixed, memory_slot_obligations(d: altra_1p_minimum)),
        }
      }
  }
}
