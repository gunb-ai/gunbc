module product.altra_motherboard.pcb_world

import std.types { String, List }
import std.orthogonal_geometry { OrthogonalReady, OrthogonalRefused }
import product.pcb.world {
  PcbWorld,
  PcbWorldIdentity,
  PcbWorldConstruction,
  PcbWorldReady,
  PcbWorldRefused,
  PcbBoardOutlineRefused,
  PcbSourceDesign,
  PcbBoard,
  PcbPhysicalWorld,
  PcbElectricalWorld,
  PcbManufacturingWorld,
  PcbComponentObligation,
  PcbAttachmentObligation,
  PcbObligationStanding,
  PcbSelectionJustification,
  AuthorityUnresolved,
  pcb_world,
}
import product.altra_motherboard.placement {
  BoardPlacementPlan,
  PlannedComponent,
  EnvelopeEstablished,
  EnvelopeNotEstablished,
  placeable_components,
  role_tag,
  altra_reference_plan,
}
import product.altra_motherboard.part_standing { obligation_standing_for, justification_for }
import product.altra_motherboard.attachment_stack {
  LayerBlocker,
  attachment_layer_name,
  open_blockers,
}

data pcb_world_note: String = "THE ALTRA BOARD AS ONE PCB WORLD AUTHORITY. The placement plan is projected into product.pcb.world's populations: established envelopes become components, and every other planned role becomes an obligation whose standing is joined from product.altra_motherboard.part_standing. The part/geometry ladder is four rungs — established, PatternOutstanding consuming MountingPatternStanding, TypeNamed, and nothing-known (SelectionNeverAttempted, AccessRefused, or AuthorityUnresolved). Collapsing any two rungs reports less than the repository knows. JUSTIFICATION IS A FIFTH AXIS beside those rungs, not a fifth rung: every planned identity carries a SelectionJustificationStanding from the same observing layer. The plan view never reads placement directly."

data altra_reference_world_identity: PcbWorldIdentity = "altra-reference-1p" as PcbWorldIdentity

data altra_source_design: PcbSourceDesign = PcbSourceDesign {
  subject: "product.altra_motherboard.minimal_design"
}

fn standing_of(c: PlannedComponent) -> PcbObligationStanding {
  match obligation_standing_for(r: c.role) {
    Present { value: s } => s
    Absent => AuthorityUnresolved {
      because: "this role has no established envelope and no recorded selection standing",
    }
  }
}

fn component_obligation(c: PlannedComponent) -> PcbComponentObligation {
  PcbComponentObligation {
    identity: c.identity,
    role: role_tag(r: c.role),
    origin: c.origin,
    standing: standing_of(c: c),
  }
}

fn obligations_from_plan(plan: BoardPlacementPlan) -> List<PcbComponentObligation> {
  fold(plan.components, init: [], f: fn(acc, c) {
    match c.envelope {
      EnvelopeEstablished { envelope: _, source: _ } => acc
      EnvelopeNotEstablished { gap: _ } => concat(acc, [component_obligation(c: c)])
    }
  })
}

fn attachment_obligation_from_blocker(b: LayerBlocker) -> PcbAttachmentObligation {
  PcbAttachmentObligation { layer: attachment_layer_name(l: b.layer) }
}

fn attachment_obligations() -> List<PcbAttachmentObligation> {
  fold(open_blockers(), init: [], f: fn(acc, b) {
    concat(acc, [attachment_obligation_from_blocker(b: b)])
  })
}

fn selection_justification(c: PlannedComponent) -> PcbSelectionJustification {
  PcbSelectionJustification {
    identity: c.identity,
    standing: justification_for(r: c.role),
  }
}

fn justifications_from_plan(plan: BoardPlacementPlan) -> List<PcbSelectionJustification> {
  fold(plan.components, init: [], f: fn(acc, c) {
    concat(acc, [selection_justification(c: c)])
  })
}

fn physical_world_from_plan(plan: BoardPlacementPlan) -> PcbPhysicalWorld {
  PcbPhysicalWorld {
    board: PcbBoard { frame: plan.frame, outline: plan.outline },
    stackup: [],
    components: placeable_components(plan: plan),
    footprints: [],
    pads: [],
    holes: [],
    routes: [],
    copper_regions: [],
    keepouts: [],
    obligations: obligations_from_plan(plan: plan),
    attachment_obligations: attachment_obligations(),
    justifications: justifications_from_plan(plan: plan),
  }
}

fn pcb_world_from_plan(plan: BoardPlacementPlan) -> PcbWorld {
  pcb_world(
    identity: altra_reference_world_identity,
    source_design: altra_source_design,
    electrical: PcbElectricalWorld { nets: [] },
    physical: physical_world_from_plan(plan: plan),
    manufacturing: PcbManufacturingWorld { artifacts: [] },
  )
}

fn altra_pcb_world() -> PcbWorldConstruction<PcbWorld> {
  match altra_reference_plan() {
    OrthogonalRefused { cause: c } => PcbWorldRefused { cause: PcbBoardOutlineRefused { cause: c } }
    OrthogonalReady { value: plan } => PcbWorldReady { value: pcb_world_from_plan(plan: plan) }
  }
}
