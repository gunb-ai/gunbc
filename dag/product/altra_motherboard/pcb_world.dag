data pcb_world_note: String = "THE ALTRA BOARD AS A PROJECTION OF 8233'S PLACEMENT PLAN INTO THE SHARED PCB WORLD. This module owns the scene join, not the design: envelopes, blockers and admission stay in product.altra_motherboard.placement and attachment_stack. World identity is derived from topology_slot_identities, not from a channel count that would invent which controllers are populated. Obligation causes are derived from the blocker variant together with the planned role — UnselectedPart is a role with no vendor, MissingDocument is a role that names a document still owed — never recovered by grepping blocker prose. The socket-type designation is extdeps.ocp.mt_jade ilm4926_designation; Mt. Jade's board extents are the same module's foreign reference and are not this board's outline. Capabilities that 8233 has not modeled are pending with a nonempty obligation, never an empty list. The outline constructing is PartialPcbWorldReady — a preview, not an admitted board. A six-channel design does not share the four-channel identity, and has no plan on this increment, so it refuses rather than borrowing the reference plan."

fn intent_tag(i: DesignIntent) -> String {
  match i {
    EngineeringBringUp => "bring-up"
    Production => "production"
  }
}

fn slot_revision_tag(s: DdrSlotIdentity) -> String {
  concat(
    "ddr",
    concat(to_string(ddr_channel_ordinal(c: s.channel)), concat(".p", to_string(dimm_slot_position_ordinal(p: s.position))))
  )
}

fn topology_revision_tag(t: ActiveDdrTopology) -> String {
  fold(topology_slot_identities(t: t), init: "", f: fn(acc, s) {
    if acc == "" {
      slot_revision_tag(s: s)
    } else {
      concat(acc, concat("+", slot_revision_tag(s: s)))
    }
  })
}

fn design_revision_tag(d: AltraMinimalMotherboard) -> String {
  concat(
    intent_tag(i: d.intent),
    concat(":",
    concat(topology_revision_tag(t: d.memory.topology),
    concat(":pcie", to_string(d.pcie_lanes_broken_out))))
  )
}

fn world_identity_for(d: AltraMinimalMotherboard) -> PcbWorldIdentity {
  concat("altra:", design_revision_tag(d: d)) as PcbWorldIdentity
}

fn source_design_for(d: AltraMinimalMotherboard) -> PcbSourceDesign {
  PcbSourceDesign {
    subject: concat("product.altra_motherboard.minimal_design:", design_revision_tag(d: d)) as NonEmptyStr,
  }
}

fn intent_eq(a: DesignIntent, b: DesignIntent) -> Bool {
  match a {
    EngineeringBringUp => match b {
      EngineeringBringUp => true
      Production => false
    }
    Production => match b {
      Production => true
      EngineeringBringUp => false
    }
  }
}

fn slot_list_covers(xs: List<DdrSlotIdentity>, ys: List<DdrSlotIdentity>) -> Bool {
  fold(ys, init: true, f: fn(acc, p) {
    acc && fold(xs, init: false, f: fn(seen, q) { seen || ddr_slot_identity_eq(a: p, b: q) })
  })
}

fn topologies_eq(a: ActiveDdrTopology, b: ActiveDdrTopology) -> Bool {
  let aslots = topology_slot_identities(t: a)
  let bslots = topology_slot_identities(t: b)
  list_length(items: aslots) == list_length(items: bslots)
    && slot_list_covers(xs: aslots, ys: bslots)
}

fn designs_eq(a: AltraMinimalMotherboard, b: AltraMinimalMotherboard) -> Bool {
  intent_eq(a: a.intent, b: b.intent)
    && topologies_eq(a: a.memory.topology, b: b.memory.topology)
    && a.pcie_lanes_broken_out == b.pcie_lanes_broken_out
}

fn mt_jade_reference_board_width_um() -> Int {
  micrometer_count(m: mt_jade_board_width)
}

fn mt_jade_reference_board_depth_um() -> Int {
  micrometer_count(m: mt_jade_board_depth)
}

fn outline_copies_mt_jade_reference(o: AxisAlignedRectangle2) -> Bool {
  let hi = rectangle2_max(r: o)
  signed_frame_component_count(c: hi.x) == mt_jade_reference_board_width_um()
    && signed_frame_component_count(c: hi.y) == mt_jade_reference_board_depth_um()
}

fn cause_from_unresolved_role(r: BoardComponentRole, w: NonEmptyStr) -> PcbObligationCause {
  match r {
    ProcessorSocket => MissingDocument { what_is_missing: ilm4926_designation }
    ProcessorPackage => MissingDocument { what_is_missing: w }
    BoardControlCpld => UnselectedPart { because: w }
    MemoryModuleSlot { slot: _ } => UnselectedPart { because: w }
    BootFirmwareEeprom => UnselectedPart { because: w }
    FirmwareFlash => UnselectedPart { because: w }
    ClockGenerator => UnselectedPart { because: w }
    ResetController => UnselectedPart { because: w }
    PowerController => UnselectedPart { because: w }
    NetworkEndpoint => UnselectedPart { because: w }
    StorageEndpoint => UnselectedPart { because: w }
    DebugConnector => UnselectedPart { because: w }
  }
}

fn cause_from_outstanding(c: PlannedComponent, g: FactAuthorityBlocker) -> PcbObligationCause {
  match g {
    NeedsSomeoneToFindTheDocument { what_is_missing: w } =>
      cause_from_unresolved_role(r: c.role, w: w)
    NeedsCommercialAccess { subject: s, access_route: _ } =>
      CommercialAccess { subject: s }
    NeedsARedistributionDecision { reason: r } =>
      LegalCarriage { reason: r }
  }
}

fn obligations_from_plan(plan: BoardPlacementPlan) -> List<PcbComponentObligation> {
  fold(plan.components, init: [], f: fn(acc, c) {
    match c.envelope {
      EnvelopeEstablished { envelope: _, source: _ } => acc
      EnvelopeNotEstablished { gap: g } => concat(acc, [PcbComponentObligation {
        identity: c.identity,
        origin: c.origin,
        cause: cause_from_outstanding(c: c, g: g),
      }])
    }
  })
}

fn cause_from_attachment_blocker(g: FactAuthorityBlocker) -> PcbObligationCause {
  match g {
    NeedsSomeoneToFindTheDocument { what_is_missing: w } =>
      MissingDocument { what_is_missing: w }
    NeedsCommercialAccess { subject: s, access_route: _ } =>
      CommercialAccess { subject: s }
    NeedsARedistributionDecision { reason: r } =>
      LegalCarriage { reason: r }
  }
}

fn attachment_obligation_from_blocker(b: LayerBlocker) -> PcbAttachmentObligation {
  PcbAttachmentObligation {
    layer: attachment_layer_name(l: b.layer),
    cause: cause_from_attachment_blocker(g: b.blocker),
  }
}

fn attachment_obligations() -> List<PcbAttachmentObligation> {
  fold(open_blockers(), init: [], f: fn(acc, b) {
    concat(acc, [attachment_obligation_from_blocker(b: b)])
  })
}

fn physical_world_from_plan(plan: BoardPlacementPlan) -> PcbPhysicalWorld {
  PcbPhysicalWorld {
    board: PcbBoard { frame: plan.frame, outline: plan.outline },
    components: placeable_components(plan: plan),
    obligations: obligations_from_plan(plan: plan),
    attachment_obligations: attachment_obligations(),
    stackup: capability_pending(what_is_owed: "a cited dielectric stackup for this board; no fabricator profile has been joined"),
    footprints: capability_pending(what_is_owed: "vendor land patterns placed on this board; body envelopes are not footprints"),
    pads: capability_pending(what_is_owed: "a pad population derived from placed footprints"),
    routes: capability_pending(what_is_owed: "a route population; routing has not been modeled for this board"),
  }
}

fn pcb_world_from_plan(d: AltraMinimalMotherboard, plan: BoardPlacementPlan) -> PcbWorld {
  pcb_world(
    identity: world_identity_for(d: d),
    source_design: source_design_for(d: d),
    electrical: PcbElectricalWorld {
      nets: capability_pending(what_is_owed: "a netlist joined to this board; electrical connectivity has not been modeled"),
    },
    physical: physical_world_from_plan(plan: plan),
    manufacturing: PcbManufacturingWorld {
      artifacts: capability_pending(what_is_owed: "manufacturing artifacts (gerber, drill, fab drawing); none have been emitted"),
    },
  )
}

fn altra_pcb_world_for(d: AltraMinimalMotherboard) -> PcbWorldConstruction<PcbWorld> {
  if !designs_eq(a: d, b: altra_1p_minimum) {
    PcbWorldRefused { cause: PcbDesignPlanUnavailable { requested: source_design_for(d: d) } }
  } else {
    match altra_reference_plan() {
      OrthogonalRefused { cause: c } => PcbWorldRefused { cause: PcbBoardOutlineRefused { cause: c } }
      OrthogonalReady { value: plan } =>
        if outline_copies_mt_jade_reference(o: plan.outline) {
          PcbWorldRefused { cause: PcbOutlineCopiedFromCitedForeignBoard }
        } else {
          PartialPcbWorldReady { value: pcb_world_from_plan(d: d, plan: plan) }
        }
    }
  }
}

fn altra_pcb_world() -> PcbWorldConstruction<PcbWorld> {
  altra_pcb_world_for(d: altra_1p_minimum)
}

fn admit_pcb_world(d: AltraMinimalMotherboard, w: PcbWorld) -> PcbWorldConstruction<PcbWorld> {
  match first_pending_capability(w: w) {
    Present { value: cap } => PcbWorldRefused { cause: PcbCapabilityStillPending { capability: cap } }
    Absent =>
      match altra_reference_plan() {
        OrthogonalRefused { cause: c } => PcbWorldRefused { cause: PcbBoardOutlineRefused { cause: c } }
        OrthogonalReady { value: plan } =>
          match admit_placement(d: d, plan: plan) {
            PlacementAdmitted { plan: _ } => AdmittedPcbWorld { value: w }
            PlacementRefused { causes: _ } => PcbWorldRefused { cause: PcbPlacementNotAdmitted }
          }
      }
  }
}
