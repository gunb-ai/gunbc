  PcbDesignPlanUnavailable,
  PcbCapabilityStillPending,
  PcbPlacementNotAdmitted,
  PcbOutlineCopiedFromCitedForeignBoard,
  PcbSourceDesign,
  PcbBoard,
  PcbPhysicalWorld,
  PcbElectricalWorld,
  PcbManufacturingWorld,
  PcbComponentObligation,
  PcbAttachmentObligation,
  PcbObligationCause,
  MissingDocument,
  CommercialAccess,
  LegalCarriage,
  UnselectedPart,
  pcb_world,
  capability_pending,
  first_pending_capability,
}
