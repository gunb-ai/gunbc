module product.altra_motherboard.pcb_world


// THE ALTRA BOARD AS A PROJECTION OF 8233'S PLACEMENT PLAN INTO THE SHARED PCB WORLD. This module
// owns the scene join, not the design: envelopes, blockers and admission stay in
// product.altra_motherboard.placement and attachment_stack. Body-envelope geometry is consumed as
// BoardBodyLayoutStanding — this module does not call admit_body_envelopes itself — so a check
// over the two envelopes that exist cannot report as a finished board while thirteen parts are
// still owed. Every projection is stamped with the plan's design identity, a DeclarationRef, not a
// revision: it names the declaration and does not change when that declaration's contents are
// edited in place. Established envelope sources are the same kind of identity — which declaration
// this board read, formatted as a record, never a datasheet sentence reconstructed here, and never
// labelled verified. Obligation causes are derived from the blocker variant together with the
// planned role — UnselectedPart is a role with no vendor, MissingDocument is a role that names a
// document still owed — never recovered by grepping blocker prose. The socket-type designation is
// extdeps.cpu_attachment.ilm4926; Mt. Jade's board extents are extdeps.ocp.mt_jade.platform's foreign
// reference and are not this board's outline. Capabilities that 8233 has not modeled are pending
// with a nonempty obligation, never an empty list. The outline constructing is
// PartialPcbWorldReady — a preview, not an admitted board. A six-channel design has no plan on
// this increment, so it refuses rather than borrowing the reference plan.
fn intent_eq(a: product.altra_motherboard.minimal_design.DesignIntent, b: product.altra_motherboard.minimal_design.DesignIntent) -> Bool {
  match a {
    product.altra_motherboard.minimal_design.EngineeringBringUp => match b {
      product.altra_motherboard.minimal_design.EngineeringBringUp => true
      product.altra_motherboard.minimal_design.Production => false
    }
    product.altra_motherboard.minimal_design.Production => match b {
      product.altra_motherboard.minimal_design.Production => true
      product.altra_motherboard.minimal_design.EngineeringBringUp => false
    }
  }
}

fn slot_list_covers(xs: List<product.altra_motherboard.minimal_design.DdrSlotIdentity>, ys: List<product.altra_motherboard.minimal_design.DdrSlotIdentity>) -> Bool {
  fold(ys, init: true, f: fn(acc, p) {
    acc && fold(xs, init: false, f: fn(seen, q) { seen || product.altra_motherboard.minimal_design.ddr_slot_identity_eq(a: p, b: q) })
  })
}

fn topologies_eq(a: product.altra_motherboard.minimal_design.ActiveDdrTopology, b: product.altra_motherboard.minimal_design.ActiveDdrTopology) -> Bool {
  let aslots = product.altra_motherboard.minimal_design.topology_slot_identities(t: a)
  let bslots = product.altra_motherboard.minimal_design.topology_slot_identities(t: b)
  std.types.list_length(items: aslots) == std.types.list_length(items: bslots)
    && slot_list_covers(xs: aslots, ys: bslots)
}

fn designs_eq(a: product.altra_motherboard.minimal_design.AltraMinimalMotherboard, b: product.altra_motherboard.minimal_design.AltraMinimalMotherboard) -> Bool {
  intent_eq(a: a.intent, b: b.intent)
    && topologies_eq(a: a.memory.topology, b: b.memory.topology)
    && a.pcie_lanes_broken_out == b.pcie_lanes_broken_out
}

fn mt_jade_reference_board_width_um() -> Int {
  std.measure.micrometer_count(m: mt_jade_motherboard_mechanical.outline_width)
}

fn mt_jade_reference_board_depth_um() -> Int {
  std.measure.micrometer_count(m: mt_jade_motherboard_mechanical.outline_depth)
}

fn outline_copies_mt_jade_reference(o: std.orthogonal_geometry.AxisAlignedRectangle2) -> Bool {
  let hi = std.orthogonal_geometry.rectangle2_max(r: o)
  std.affine_space.signed_frame_component_count(c: hi.x) == mt_jade_reference_board_width_um()
    && std.affine_space.signed_frame_component_count(c: hi.y) == mt_jade_reference_board_depth_um()
}

fn cause_from_unresolved_role(r: product.altra_motherboard.placement.BoardComponentRole, w: std.types.NonEmptyStr) -> product.pcb.world.PcbObligationCause {
  match r {
    product.altra_motherboard.placement.ProcessorSocket => NamedAttachmentTypePartUnresolved { designation: ilm4926.designator, missing: w }
    product.altra_motherboard.placement.ProcessorPackage => product.pcb.world.MissingDocument { what_is_missing: w }
    product.altra_motherboard.placement.BoardControlCpld => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.MemoryModuleSlot { slot: _ } => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.BootFirmwareEeprom => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.FirmwareFlash => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.ResetController => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.ProcessorRailSequencer => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.ProcessorPowerStage => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.ProcessorPowerGoodSupervisor => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.HostNetworkPhy => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.ManagementNetworkPath => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.StorageEndpoint => product.pcb.world.UnselectedPart { because: w }
    product.altra_motherboard.placement.DebugConnector => product.pcb.world.UnselectedPart { because: w }
  }
}

fn cause_from_outstanding(c: product.altra_motherboard.placement.PlannedComponent, g: product.altra_motherboard.attachment_stack.FactAuthorityBlocker) -> product.pcb.world.PcbObligationCause {
  match g {
    product.altra_motherboard.attachment_stack.NeedsSomeoneToFindTheDocument { what_is_missing: w } =>
      cause_from_unresolved_role(r: c.role, w: w)
    product.altra_motherboard.attachment_stack.NeedsCommercialAccess { subject: s, access_route: _ } =>
      product.pcb.world.CommercialAccess { subject: s }
    product.altra_motherboard.attachment_stack.NeedsARedistributionDecision { reason: r } =>
      product.pcb.world.LegalCarriage { reason: r }
    product.altra_motherboard.attachment_stack.NeedsAHumanToReadTheDrawing { figure: f, what_is_drawn: d } =>
      product.pcb.world.DrawingMustBeRead { figure: f, what_is_drawn: d }
    product.altra_motherboard.attachment_stack.NeedsTheStandingItselfRepaired { refusal: r } =>
      product.pcb.world.StandingIsSelfContradictory { what_is_wrong: product.altra_motherboard.attachment_stack.authority_standing_refusal_text(r: r) }
  }
}

fn obligations_from_plan(plan: product.altra_motherboard.placement.BoardPlacementPlan) -> List<product.pcb.world.PcbComponentObligation> {
  fold(plan.components, init: [], f: fn(acc, c) {
    match c.envelope {
      product.altra_motherboard.placement.EnvelopeEstablished { envelope: _, source: _ } => acc
      product.altra_motherboard.placement.EnvelopeNotEstablished { gap: g } => concat(acc, [product.pcb.world.PcbComponentObligation {
        identity: c.identity,
        origin: c.origin,
        cause: cause_from_outstanding(c: c, g: g),
      }])
    }
  })
}

fn cause_from_attachment_blocker(g: product.altra_motherboard.attachment_stack.FactAuthorityBlocker) -> product.pcb.world.PcbObligationCause {
  match g {
    product.altra_motherboard.attachment_stack.NeedsSomeoneToFindTheDocument { what_is_missing: w } =>
      product.pcb.world.MissingDocument { what_is_missing: w }
    product.altra_motherboard.attachment_stack.NeedsCommercialAccess { subject: s, access_route: _ } =>
      product.pcb.world.CommercialAccess { subject: s }
    product.altra_motherboard.attachment_stack.NeedsARedistributionDecision { reason: r } =>
      product.pcb.world.LegalCarriage { reason: r }
    product.altra_motherboard.attachment_stack.NeedsAHumanToReadTheDrawing { figure: f, what_is_drawn: d } =>
      product.pcb.world.DrawingMustBeRead { figure: f, what_is_drawn: d }
    product.altra_motherboard.attachment_stack.NeedsTheStandingItselfRepaired { refusal: r } =>
      product.pcb.world.StandingIsSelfContradictory { what_is_wrong: product.altra_motherboard.attachment_stack.authority_standing_refusal_text(r: r) }
  }
}

fn attachment_obligation_from_blocker(b: product.altra_motherboard.attachment_stack.LayerBlocker) -> product.pcb.world.PcbAttachmentObligation {
  product.pcb.world.PcbAttachmentObligation {
    layer: product.altra_motherboard.attachment_stack.attachment_layer_name(l: b.layer),
    cause: cause_from_attachment_blocker(g: b.blocker),
  }
}

fn attachment_obligations() -> List<product.pcb.world.PcbAttachmentObligation> {
  fold(product.altra_motherboard.attachment_stack.open_blockers(), init: [], f: fn(acc, b) {
    concat(acc, [attachment_obligation_from_blocker(b: b)])
  })
}

// THE NESTED GEOMETRY VERDICT IS MATCHED, NOT DROPPED. This function used to bind the subset
// arm's geometry to `_`, which is how a refused subset reached the world as a checked one: the
// count of what was NOT examined was projected, and the verdict on what WAS examined was thrown
// away. Two established components overlapping is a hard failure of the only geometry this board
// has actually done, and it must not be reported behind a word that means "so far so good".
fn project_body_layout(s: product.altra_motherboard.placement.BoardBodyLayoutStanding) -> product.pcb.world.PcbBodyLayoutStanding {
  match s {
    product.altra_motherboard.placement.BodyLayoutAdmittedOverEveryRequiredPart { article: _ } =>
      product.pcb.world.PcbBodyLayoutAdmittedOverEveryRequiredPart
    product.altra_motherboard.placement.BodyLayoutCheckedOverEstablishedSubsetOnly { parts_still_owed: n, geometry: g } =>
      match g {
        product.pcb.physical.BodyEnvelopesAdmitted { article: _ } =>
          product.pcb.world.PcbBodyLayoutAdmittedOverEstablishedSubsetOnly { parts_still_owed: n }
        product.pcb.physical.PhysicallyRefused { causes: cs } =>
          product.pcb.world.PcbBodyLayoutRefusedOverEstablishedSubset { parts_still_owed: n, causes: cs }
      }
    product.altra_motherboard.placement.BodyLayoutRefused { causes: cs } =>
      product.pcb.world.PcbBodyLayoutRefusedOverCompletePopulation { causes: cs }
  }
}

fn envelope_reads_from_plan(plan: product.altra_motherboard.placement.BoardPlacementPlan) -> List<product.pcb.world.EstablishedEnvelopeRead> {
  fold(plan.components, init: [], f: fn(acc, c) {
    match c.envelope {
      product.altra_motherboard.placement.EnvelopeEstablished { envelope: _, source: s } =>
        concat(acc, [product.pcb.world.EstablishedEnvelopeRead { identity: c.identity, source: s }])
      product.altra_motherboard.placement.EnvelopeNotEstablished { gap: _ } => acc
    }
  })
}

// board_functional_obligations() names every required function whose realization gap must stay
// visible in the PCB world (two clock roles + five physical-population requirements). This fold
// projects every member unconditionally — the authority list is the filter, not a runtime
// predicate here. A cited body envelope on the plan must not read as functional establishment;
// omitting an identity from that list would be the exact failure this projection is supposed to
// make impossible.
fn functional_obligations() -> List<product.pcb.world.PcbFunctionalObligation> {
  fold(product.altra_motherboard.realization.board_functional_obligations(), init: [], f: fn(acc, f) {
    concat(acc, [product.pcb.world.PcbFunctionalObligation {
      function: product.altra_motherboard.realization.functional_requirement_name(f: f),
      cause: product.pcb.world.UnselectedPart { because: product.altra_motherboard.realization.functional_requirement_reason(f: f) },
    }])
  })
}

fn physical_world_from_plan(d: product.altra_motherboard.minimal_design.AltraMinimalMotherboard, d_ref: DeclarationRef, plan: product.altra_motherboard.placement.BoardPlacementPlan) -> product.pcb.world.PcbPhysicalWorld {
  product.pcb.world.PcbPhysicalWorld {
    board: product.pcb.world.PcbBoard { frame: plan.frame, outline: plan.outline },
    components: product.altra_motherboard.placement.placeable_components(plan: plan),
    envelope_reads: envelope_reads_from_plan(plan: plan),
    obligations: obligations_from_plan(plan: plan),
    attachment_obligations: attachment_obligations(),
    functional_obligations: functional_obligations(),
    body_layout: project_body_layout(s: product.altra_motherboard.placement.board_body_layout_standing(d: d, d_ref: d_ref, plan: plan)),
    stackup: product.pcb.world.capability_pending(what_is_owed: "a cited dielectric stackup for this board; no fabricator profile has been joined"),
    footprints: product.pcb.world.capability_pending(what_is_owed: "vendor land patterns placed on this board; body envelopes are not footprints"),
    pads: product.pcb.world.capability_pending(what_is_owed: "a pad population derived from placed footprints"),
    routes: product.pcb.world.capability_pending(what_is_owed: "a route population; routing has not been modeled for this board"),
  }
}

fn pcb_world_from_plan(d: product.altra_motherboard.minimal_design.AltraMinimalMotherboard, d_ref: DeclarationRef, plan: product.altra_motherboard.placement.BoardPlacementPlan) -> product.pcb.world.PcbWorld {
  product.pcb.world.pcb_world(
    design: plan.design,
    electrical: product.pcb.world.PcbElectricalWorld {
      nets: product.pcb.world.capability_pending(what_is_owed: "a netlist joined to this board; electrical connectivity has not been modeled"),
    },
    physical: physical_world_from_plan(d: d, d_ref: d_ref, plan: plan),
    manufacturing: product.pcb.world.PcbManufacturingWorld {
      artifacts: product.pcb.world.capability_pending(what_is_owed: "manufacturing artifacts (gerber, drill, fab drawing); none have been emitted"),
    },
  )
}

fn altra_pcb_world_for(d: product.altra_motherboard.minimal_design.AltraMinimalMotherboard) -> product.pcb.world.PcbWorldConstruction<product.pcb.world.PcbWorld> {
  if !designs_eq(a: d, b: product.altra_motherboard.minimal_design.altra_1p_minimum) {
    product.pcb.world.PcbWorldRefused { cause: product.pcb.world.PcbDesignPlanUnavailable { only_available: product.altra_motherboard.placement.altra_1p_minimum_ref() } }
  } else {
    match product.altra_motherboard.placement.altra_reference_plan() {
      std.orthogonal_geometry.OrthogonalRefused { cause: c } => product.pcb.world.PcbWorldRefused { cause: product.pcb.world.PcbBoardOutlineRefused { cause: c } }
      std.orthogonal_geometry.OrthogonalReady { value: plan } =>
        if outline_copies_mt_jade_reference(o: plan.outline) {
          product.pcb.world.PcbWorldRefused { cause: product.pcb.world.PcbOutlineCopiedFromCitedForeignBoard }
        } else {
          product.pcb.world.PartialPcbWorldReady { value: pcb_world_from_plan(d: d, d_ref: product.altra_motherboard.placement.altra_1p_minimum_ref(), plan: plan) }
        }
    }
  }
}

fn altra_pcb_world() -> product.pcb.world.PcbWorldConstruction<product.pcb.world.PcbWorld> {
  altra_pcb_world_for(d: product.altra_motherboard.minimal_design.altra_1p_minimum)
}

fn design_mismatch_from_causes(cs: List<product.altra_motherboard.placement.PlacementRefusal>) -> PcbWorldRefusal? {
  fold(cs, init: none, f: fn(acc, c) {
    match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        match c {
          product.altra_motherboard.placement.PlanWasBuiltFromADifferentDesign { plan_design: a, admitted_against: b } =>
            Present { value: product.pcb.world.PcbPlanWasBuiltFromADifferentDesign { plan_design: a, admitted_against: b } }
          product.altra_motherboard.placement.ComponentEnvelopeNotEstablished { component: _, gap: _ } => none
          product.altra_motherboard.placement.RequiredRoleUnfilled { role: _ } => none
          product.altra_motherboard.placement.ComponentFillsNoRequiredRole { component: _, role_named: _ } => none
          product.altra_motherboard.placement.PlannedIdentityRepeated { component: _ } => none
          product.altra_motherboard.placement.RoleFilledMoreThanOnce { role: _, fills: _ } => none
          RequiredFunctionWithoutJustifiedPartOnBoard { requirement: _ } => none
        }
    }
  })
}

// THE DESIGN'S IDENTITY IS SUPPLIED BY WHOEVER READ IT. Passing plan.design here instead would
// make the join compare the plan against itself -- a tautology, and a worse defect than the
// hardcoded reference it replaced, because it can never fail.
fn admit_pcb_world(d: product.altra_motherboard.minimal_design.AltraMinimalMotherboard, d_ref: DeclarationRef, w: product.pcb.world.PcbWorld) -> product.pcb.world.PcbWorldConstruction<product.pcb.world.PcbWorld> {
  match product.altra_motherboard.placement.altra_reference_plan() {
    std.orthogonal_geometry.OrthogonalRefused { cause: c } => product.pcb.world.PcbWorldRefused { cause: product.pcb.world.PcbBoardOutlineRefused { cause: c } }
    std.orthogonal_geometry.OrthogonalReady { value: plan } =>
      if !std.decl_ref.declaration_ref_eq(a: product.pcb.world.pcb_world_design(w: w), b: plan.design) {
        product.pcb.world.PcbWorldRefused { cause: product.pcb.world.PcbPlanWasBuiltFromADifferentDesign { plan_design: plan.design, admitted_against: product.pcb.world.pcb_world_design(w: w) } }
      } else {
        match product.pcb.world.first_unsettled_capability(w: w) {
          Present { value: r } => product.pcb.world.PcbWorldRefused { cause: r }
          Absent =>
            match product.altra_motherboard.placement.admit_placement(d: d, d_ref: d_ref, plan: plan) {
              product.altra_motherboard.placement.PlacementAdmitted { plan: _ } => product.pcb.world.AdmittedPcbWorld { value: w }
              product.altra_motherboard.placement.PlacementRefused { causes: cs } =>
                match design_mismatch_from_causes(cs: cs) {
                  Present { value: r } => product.pcb.world.PcbWorldRefused { cause: r }
                  Absent => product.pcb.world.PcbWorldRefused { cause: product.pcb.world.PcbPlacementNotAdmitted }
                }
            }
        }
      }
  }
}
