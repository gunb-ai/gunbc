module product.altra_motherboard.scene_emission

import product.altra_motherboard.pcb_world { altra_pcb_world }
import product.pcb.world { PcbWorldReady, PcbWorldRefused }
import product.pcb.plan_view {
  PcbSceneEmission,
  PcbSceneEmitted,
  PcbSceneEmissionRefused,
  PcbSceneWorldRefused,
  project_pcb_world,
  emit_pcb_plan_view,
}

data scene_emission_note: String = "Production entry for the Altra reference board plan view. The world is minted once through product.altra_motherboard.pcb_world and projected through product.pcb.plan_view; this module names no component and no channel."

fn emit_altra_board_scene() -> PcbSceneEmission {
  match altra_pcb_world() {
    PcbWorldRefused { cause: c } => PcbSceneEmissionRefused { cause: PcbSceneWorldRefused { cause: c } }
    PcbWorldReady { value: w } => emit_pcb_plan_view(c: project_pcb_world(w: w))
  }
}
