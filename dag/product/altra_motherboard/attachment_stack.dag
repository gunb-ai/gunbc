module product.altra_motherboard.attachment_stack

import std.types { String, Bool, NonEmptyStr, List }
import std.integer { Int }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.cpu.types { CpuSocket }
import extdeps.cpu.ampere_altra_package {
  ReferenceBoardCollateralStanding,
  ReferenceBoardCollateralAvailable,
  ReferenceBoardCollateralUnderNda,
  altra_declared_contact_count,
  altra_fclga_socket,
  altra_reference_board_collateral_standing,
  ampere_customer_reference_boards_authority,
  extdeps_external_authority_anchor,
}

// SIX THINGS BETWEEN A PROCESSOR DIE AND A BOARD, AND THEY ARE NOT ONE THING. The processor
// package, the socket, the socket's own board termination, the motherboard land pattern that
// termination solders to, the loading mechanism that clamps the processor into the socket, and the
// mounting that carries the load are six independently governed identities with six different
// authorities — one vendor publishes the package, another manufactures the socket, and the
// motherboard designer owns neither. THE ERROR THIS MODULE EXISTS TO MAKE UNWRITABLE is deriving
// the board land pattern from the processor package's bottom-land geometry. Both are grids of
// lands with 4926 members and the same pitch, so they LOOK like the same fact, and the datasheet's
// mechanical section is right there. They are not the same fact: one is the package's underside,
// the other is the pad array the SOCKET solders to, and the socket sits between them adding its
// own tolerance, termination style and keepout. A board built on the first is a board where
// nothing solders. The identical category error was already made one layer down in this
// repository, where a package body envelope was called a footprint and approved by review before
// it was caught.
// EACH LAYER IS ITS OWN SUBJECT WITH ITS OWN AUTHORITY. They are separate types rather than one
// parameterised row because their FACTS differ in kind, not only in value: a package has contacts
// and a mechanical outline, a socket has a vendor part number and an insertion force, a loading
// mechanism has a clamping load and a screw torque. Fusing them would produce a record where most
// fields are absent for most layers, which is how an absent fact becomes indistinguishable from
// an inapplicable one.
type AttachmentLayer
  = ProcessorPackageLayer
  | SocketLayer
  | SocketBoardTerminationLayer
  | BoardLandPatternLayer
  | LoadingMechanismLayer
  | MountingLayer

fn attachment_layer_name(l: AttachmentLayer) -> NonEmptyStr {
  match l {
    ProcessorPackageLayer => "processor package"
    SocketLayer => "socket"
    SocketBoardTerminationLayer => "socket board termination"
    BoardLandPatternLayer => "board land pattern"
    LoadingMechanismLayer => "loading mechanism"
    MountingLayer => "mounting"
  }
}

// THREE CATEGORIES, NOT TWO, and the third is the one that keeps getting collapsed into the
// second. A fact whose authority nobody has looked for is UNRESOLVED; it is not NDA-gated, and
// recording it as NDA-gated invents a blocker and stops anyone looking. The reverse error is
// equally live: this repository once declared the Altra pin map NDA-only by reasoning from the
// fact that the reference BOARD collateral is under NDA, and defended it with a passing witness.
// It was public in the datasheet the repository was already citing.
//
// REDISTRIBUTION IS A FOURTH THING AND IT IS NOT AVAILABILITY. A document can be freely
// downloadable and still carry a proprietary footer that makes copying its tables into a public
// repository a licensing question. That is a question about WHERE the bytes may live, not about
// whether we may know them, and conflating the two would either block modelling that is allowed
// or leak bytes that are not.
// THE ACCESS ROUTE IS AN AUTHORITY, NOT A SENTENCE. An earlier revision typed this NonEmptyStr
// beside a subject of the same type, and the projection below duly bound the real
// ExternalAuthority, discarded it, and put the subject label in the route field — a swap that
// typechecked precisely because both were strings. A consumer asking where to obtain the
// collateral received a description of what the collateral IS. The holder is gone rather than
// corrected: it was hard-coded here while the upstream standing carries no such field, so it
// was an invented fact, and the authority already identifies who holds it.
// TWO INDEPENDENT QUESTIONS, SPLIT BECAUSE FUSING THEM MADE HONEST STATES UNSAYABLE. The earlier
// AuthorityStanding forced a choice between "publicly cited" and "public but redistribution
// undecided", so a subject whose dimensions ARE established from a public document, and whose
// vendor expression this repository declines to copy, had no representation — which is exactly
// the Altra package. This module's own note above says redistribution answers WHERE THE BYTES MAY
// LIVE and not whether we may know them, and the type then made them one choice. Worse, the fused
// type let a consumer write EnvelopeNotEstablished carrying PubliclyCited: a not-established arm
// holding an established value, a contradiction the type permitted.
//
// IS THE FACT ESTABLISHED. This axis says nothing about what may be copied.
// AND THE FOURTH STATE, WHICH THE FIRST THREE COULD NOT SAY. A fact can sit in a document that is
// found, public, and already cited by this repository, and still be unreadable: it is drawn rather
// than written. The Altra land geometry is exactly this -- the mechanical section IS the drawing,
// and its dimensions render from subset fonts carrying no character map, so a machine reading it
// gets glyph codes rather than numbers.
//
// Filing that as FactUnresolved was wrong in the way that matters most here, because this type's
// own principle is that the reason decides who acts. Unresolved dispatches someone to find a
// document; there is no document left to find, the bibliography lists nine and none is a mechanical
// drawing, and the search would return empty after costing a day. What is owed is a HUMAN READING A
// DRAWING, which is a different actor and a different unblocking event.
//
// It is deliberately NOT a carriage question. The document is public and the ruling permits its
// facts, so nothing legal stands here -- fusing this into carriage would send a reading task to
// whoever decides what the repository may hold.
type FactAuthorityStanding
  = FactEstablished { authority: ExternalAuthority, subject: DeclarationRef }
  | FactUnresolved { what_is_missing: NonEmptyStr }
  | FactAccessGated { subject: NonEmptyStr, access_route: ExternalAuthority }
  | FactStatedOnlyInFigure { figure: NonEmptyStr, what_is_drawn: NonEmptyStr }

// WHAT THIS REPOSITORY MAY CARRY FOR THAT SUBJECT. Deliberately three arms rather than the four a
// naive split would give, and the missing one is worth stating: there is no
// SourceExpressionMayBeCarried, because copying a vendor's PDF, figure, prose or table layout is
// refused for EVERY subject by repository policy rather than chosen per subject. It is therefore
// not a degree of freedom here, and modelling it as one would invite a row to grant itself
// something no row may grant. NormalizedFactsMayBeCarried consequently means exactly: the
// normalized numerical facts are admitted AND the vendor's expression of them is not.
type RepositoryCarriageStanding
  = CarriageNotApplicable { because: NonEmptyStr }
  | NormalizedFactsMayBeCarried
  | CarriageDecisionRequired { reason: NonEmptyStr }

fn fact_is_established(f: FactAuthorityStanding) -> Bool {
  match f {
    FactEstablished { authority: _, subject: _ } => true
    FactUnresolved { what_is_missing: _ } => false
    FactAccessGated { subject: _, access_route: _ } => false
    FactStatedOnlyInFigure { figure: _, what_is_drawn: _ } => false
  }
}

type AttachmentLayerStanding {
  layer: AttachmentLayer
  fact: FactAuthorityStanding
  carriage: RepositoryCarriageStanding
}

// THE AUTHORITIES ARE THE EXTDEPS MODULE'S AND ARE CONSUMED, NOT RE-MINTED. An earlier revision
// of this module declared its own ExternalAuthority rows for the Ampere product brief and the
// Customer Connect page, both of which already exist in extdeps.cpu.ampere_altra_package — a
// second name for one authority, in a module whose entire subject is that six layers must not be
// collapsed into fewer. One of the duplicates was not even referenced, so it forked a fact
// without buying anything.

// The processor package is PUBLIC and its redistribution is the open question — every page of the
// datasheet carrying it is footed proprietary, so the contact table may be modelled and joined
// but not hand-copied into this public repository until placement is decided.
data processor_package_standing: AttachmentLayerStanding = AttachmentLayerStanding {
  layer: ProcessorPackageLayer,
  fact: FactEstablished {
    authority: extdeps_external_authority_anchor,
    subject: DeclarationRef {
      module_path: "extdeps.cpu.ampere_altra_package",
      decl_name: "altra_fclga_socket",
      field: WholeDeclaration
    },
  },
  carriage: NormalizedFactsMayBeCarried,
}

// The socket is a purchased part from a socket manufacturer, and nobody here has yet identified
// which one. That is an unresolved authority, NOT an NDA blocker — recording it as NDA-gated
// would invent a wall and stop anyone from looking for the datasheet that probably exists.
// CORRECTED BY EXECUTION. This layer said the processor datasheet names the package and not the
// socket that receives it. That is false: the datasheet's thermal notes state the case temperature
// is measured with the device seated in a named socket, and the OCP board specification names the
// same designation independently. Two documents agreeing is what promoted it to its own authority.
//
// The layer stays unresolved because what is still missing narrowed rather than cleared: a
// designation is not a vendor part number, and which physical part the designation names -- the
// socket body or the retention hardware, plausibly different vendors -- is unsettled. The
// designation itself is not repeated here; it lives in one authority and this layer will reference
// it rather than carry a second spelling.
data socket_standing: AttachmentLayerStanding = AttachmentLayerStanding {
  layer: SocketLayer,
  fact: FactUnresolved {
    what_is_missing: "the socket vendor and part number, and which physical part the shared designation names; a designation appearing in two independent documents establishes the name, not the part",},
  carriage: CarriageNotApplicable {
    because: "no fact is established for this layer, so there is nothing to decide carriage for",
  },
}

data socket_board_termination_standing: AttachmentLayerStanding = AttachmentLayerStanding {
  layer: SocketBoardTerminationLayer,
  fact: FactUnresolved {
    what_is_missing: "how the selected socket terminates to the board — solder ball, compliant pin or land — which is a property of the socket part and cannot be read off the processor package",},
  carriage: CarriageNotApplicable {
    because: "no fact is established for this layer, so there is nothing to decide carriage for",
  },
}

// THE ONE THAT MATTERS MOST, and the one that looks most available. The board land pattern is the
// SOCKET vendor's recommended pad array, not the processor's underside.
// LOCATED, NOT MISSING. This layer was filed as a document nobody had found, and it is now known
// exactly where the geometry sits: inside a figure in a document this repository already cites and
// is permitted to carry. The search is over and it returned a location rather than a document, so
// the actor changes from someone reading a bibliography to someone reading a drawing.
//
// The package-versus-board distinction the earlier wording made is still correct and still load
// bearing: the platform specification's running text gives the PACKAGE pad array, which is the
// underside of the part, not the board surface on the other side of the socket. Having the first
// does not give the second, and the figure is where the question is settled either way.
data board_land_pattern_standing: AttachmentLayerStanding = AttachmentLayerStanding {
  layer: BoardLandPatternLayer,
  fact: FactStatedOnlyInFigure {
    figure: "Ampere Altra Platform Hardware Design Specification v1.00, Figure 3, Altra Package Size and Pad Array",
    what_is_drawn: "the package outline drawing and the socket drawing, which is where a board land pattern would be stated if either document states one; the running text gives the package pad array only, and that is the other surface",
  },
  carriage: CarriageNotApplicable {
    because: "no fact is established for this layer yet, so there is nothing to decide carriage for; the document itself is public and permitted, so nothing legal blocks this layer",
  },
}

data loading_mechanism_standing: AttachmentLayerStanding = AttachmentLayerStanding {
  layer: LoadingMechanismLayer,
  fact: FactUnresolved {
    what_is_missing: "independent loading mechanism and backplate geometry, clamping load and torque; whether these ship with the socket or with reference-board collateral is itself unestablished",},
  carriage: CarriageNotApplicable {
    because: "no fact is established for this layer, so there is nothing to decide carriage for",
  },
}

data mounting_standing: AttachmentLayerStanding = AttachmentLayerStanding {
  layer: MountingLayer,
  fact: FactUnresolved {
    what_is_missing: "mounting hole positions and keepouts carrying the loading mechanism's reaction force",},
  carriage: CarriageNotApplicable {
    because: "no fact is established for this layer, so there is nothing to decide carriage for",
  },
}

// THE NDA BOUNDARY IS PROJECTED FROM THE EXTDEPS STANDING, NOT RESTATED. That module already owns
// the fact, names the four reference boards and cites the access route; re-authoring it here as
// product-layer prose would be a second representation that drifts the moment either is edited.
// The projection exists because this module's AuthorityStanding is the vocabulary its six layers
// share — so the boundary arrives as a value in that vocabulary rather than as a parallel claim.
fn reference_board_collateral_standing() -> FactAuthorityStanding {
  match altra_reference_board_collateral_standing() {
    ReferenceBoardCollateralAvailable =>
      FactEstablished {
        authority: ampere_customer_reference_boards_authority,
        subject: DeclarationRef {
          module_path: "extdeps.cpu.ampere_altra_package",
          decl_name: "altra_reference_board_collateral_standing",
          field: WholeDeclaration
        },
      }
    ReferenceBoardCollateralUnderNda { subject: s, access_route: route } =>
      FactAccessGated { subject: s, access_route: route }
  }
}

data attachment_stack: List<AttachmentLayerStanding> = [
  processor_package_standing,
  socket_standing,
  socket_board_termination_standing,
  board_land_pattern_standing,
  loading_mechanism_standing,
  mounting_standing,
]

// A LAYER IS BLOCKED FOR A REASON, AND THE REASON DECIDES WHO ACTS. An unresolved authority is
// someone reading a datasheet; a redistribution question is a legal decision about where bytes
// may live; an NDA gate is a commercial relationship. Collapsing them into "not ready" would send
// all three to the same person and make the tractable ones look like the intractable one.
// WHY A SUBJECT IS BLOCKED, WITH NO ESTABLISHED ARM. That absence is the construction: a consumer
// holding one of these cannot be holding an established fact, so the contradiction the fused type
// permitted — a not-established carrier containing PubliclyCited — has no representation. It is
// layer-agnostic because envelopes, laminates and layers are all blocked for these same three
// reasons, and minting a second copy per subject is the fork this repository keeps repairing.
type FactAuthorityBlocker
  = NeedsSomeoneToFindTheDocument { what_is_missing: NonEmptyStr }
  | NeedsARedistributionDecision { reason: NonEmptyStr }
  | NeedsCommercialAccess { subject: NonEmptyStr, access_route: ExternalAuthority }
  | NeedsAHumanToReadTheDrawing { figure: NonEmptyStr, what_is_drawn: NonEmptyStr }

// THE BLOCKER FOR ANY SUBJECT, derived from both axes rather than either alone. AN ESTABLISHED
// FACT CAN STILL BE BLOCKED, and only the split makes that sayable: the question is then not
// whether we know the dimension but whether this repository may carry it, so the blocker is read
// off the carriage axis. Before the split these were one choice, and a subject whose fact was
// established and whose carriage was undecided had to be filed as not established — which sent a
// legal question to whoever was reading datasheets.
// THE TWO AXES ARE INDEPENDENT BUT NOT UNCONSTRAINED, and this admission is the hole I left when
// I split them. Splitting fact from carriage was right -- whether anyone established a fact and
// whether this repository may hold it are different questions with different remedies. What I did
// not do was say which COMBINATIONS mean anything, so the product admitted three that do not, and
// subject_blocker answered the worst of them with no blocker at all: an established fact whose
// carriage is "not applicable" read as nothing standing in the way, which is the fabricated
// plausible output pointed at the legal axis.
//
// WHY EACH REFUSAL IS INCOHERENT RATHER THAN MERELY UNUSUAL. Carriage is not applicable only
// because there is no fact yet to carry, so once the fact IS established the question stops being
// moot and somebody has to answer it -- silence there is a decision nobody made. Carriage
// permission for a fact nobody has established is permission to hold nothing, and it will read as
// a green light the moment the fact lands, without anyone revisiting it. And an access-gated fact
// does not get an independent carriage decision, because the terms that gate the access are the
// terms that govern the carriage: deciding them separately is deciding one of them wrongly.
type AuthorityStandingRefusal
  = EstablishedFactHasInapplicableCarriage
  | UnestablishedFactClaimsNormalizedCarriage
  | AccessGatedFactHasIndependentCarriageDecision

fn authority_standing_refusal(fact: FactAuthorityStanding, carriage: RepositoryCarriageStanding) -> AuthorityStandingRefusal? {
  match fact {
    FactEstablished { authority: _, subject: _ } =>
      match carriage {
        CarriageNotApplicable { because: _ } => Present { value: EstablishedFactHasInapplicableCarriage }
        NormalizedFactsMayBeCarried => none
        CarriageDecisionRequired { reason: _ } => none
      }
    FactUnresolved { what_is_missing: _ } =>
      match carriage {
        NormalizedFactsMayBeCarried => Present { value: UnestablishedFactClaimsNormalizedCarriage }
        CarriageNotApplicable { because: _ } => none
        CarriageDecisionRequired { reason: _ } => none
      }
    FactStatedOnlyInFigure { figure: _, what_is_drawn: _ } =>
      match carriage {
        NormalizedFactsMayBeCarried => Present { value: UnestablishedFactClaimsNormalizedCarriage }
        CarriageNotApplicable { because: _ } => none
        CarriageDecisionRequired { reason: _ } => none
      }
    FactAccessGated { subject: _, access_route: _ } =>
      match carriage {
        CarriageDecisionRequired { reason: _ } => Present { value: AccessGatedFactHasIndependentCarriageDecision }
        NormalizedFactsMayBeCarried => Present { value: AccessGatedFactHasIndependentCarriageDecision }
        CarriageNotApplicable { because: _ } => none
      }
  }
}

fn standing_pair_is_admitted(fact: FactAuthorityStanding, carriage: RepositoryCarriageStanding) -> Bool {
  match authority_standing_refusal(fact: fact, carriage: carriage) {
    Present { value: _ } => false
    Absent => true
  }
}

// RUNG, STATED HONESTLY rather than implied by the presence of this function. This is mechanically
// preventable, not structurally impossible: AttachmentLayerStanding is still a freely constructible
// record, so an incoherent pair remains WRITABLE and safety depends on a witness executing. The
// next rung is construction closure -- sealing the record so the only mint is a function that
// consults this refusal -- and that is the trigger, not a wish. It is deliberately not attempted in
// the same change that discovers the class.
// Mechanically preventable. The incoherent combinations are detected and witnessed, not made
// unwritable; AttachmentLayerStanding stays a public record literal. Next-rung trigger: seal
// AttachmentLayerStanding with a sole constructor whose mint returns an admission, so an
// incoherent pair has no representation rather than a check that must be run.
fn subject_blocker(fact: FactAuthorityStanding, carriage: RepositoryCarriageStanding) -> FactAuthorityBlocker? {
  match fact {
    FactUnresolved { what_is_missing: w } =>
      Present { value: NeedsSomeoneToFindTheDocument { what_is_missing: w } }
    FactStatedOnlyInFigure { figure: f, what_is_drawn: d } =>
      Present { value: NeedsAHumanToReadTheDrawing { figure: f, what_is_drawn: d } }
    FactAccessGated { subject: sub, access_route: route } =>
      Present { value: NeedsCommercialAccess { subject: sub, access_route: route } }
    FactEstablished { authority: _, subject: _ } =>
      match carriage {
        NormalizedFactsMayBeCarried => none
        CarriageNotApplicable { because: _ } => none
        CarriageDecisionRequired { reason: r } =>
          Present { value: NeedsARedistributionDecision { reason: r } }
      }
  }
}

// The layer-grain wrapper is the generic blocker PLUS which layer it is about, rather than three
// variants restating the generic ones with a layer field bolted on. Those would be a second copy
// that drifts the moment a fourth blocking reason exists.
type LayerBlocker {
  layer: AttachmentLayer
  blocker: FactAuthorityBlocker
}

fn layer_blocker(row: AttachmentLayerStanding) -> LayerBlocker? {
  match subject_blocker(fact: row.fact, carriage: row.carriage) {
    Absent => none
    Present { value: b } => Present { value: LayerBlocker { layer: row.layer, blocker: b } }
  }
}


fn open_blockers() -> List<LayerBlocker> {
  fold(attachment_stack, init: [], f: fn(acc, row) {
    match layer_blocker(row: row) {
      Absent => acc
      Present { value: b } => concat(acc, [b])
    }
  })
}

// THE CONSTRUCTION WALL. A board land pattern is reachable only from the socket layer's own
// authority, and this module supplies no function taking a processor package and returning one.
// The absence is the wall: with no such function, a caller that wants board pads must obtain the
// socket vendor's geometry, and cannot instead reach for the package drawing that is sitting
// right there in the datasheet.
//
// The contact COUNT is shared and is deliberately the only thing that crosses: however the socket
// terminates, a 4926-contact processor needs 4926 board-side terminations, so the population is a
// join key between the two layers even though the geometry is not.
fn board_side_termination_population() -> Int {
  altra_declared_contact_count()
}

fn processor_socket() -> CpuSocket {
  altra_fclga_socket
}
