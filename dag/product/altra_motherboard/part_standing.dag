// FETCH OBSERVATIONS STAY DISTINCT BY CAUSE. A vendor-level extraction failure (every Microchip
// PDF tried this session) is not a Macronix text-not-extractable, is not a script-rendered
// product page, and is not a Digi-Key 410 GONE. A reconstructed URL that 403s is not a sibling
// print that was actually observed to exist.
type DocumentFetchObservation
  = HttpOkTextNotExtractable
  | VendorExtractionFailure { vendor: NonEmptyStr }
  | ScriptRenderedUnreadable
  | SiblingDocumentObserved
  | HttpGone
  | HttpForbidden
  | FetchTimedOut
  | UrlUnconfirmedForbidden

type DocumentAttemptDisposition
  = AttemptOpen
  | AttemptSuperseded { selected_instead: NonEmptyStr }

type DocumentAttemptSubject
  = CitedCatalogRow { declaration: DeclarationRef }
  | UncitedLocator { document: NonEmptyStr, uri: Uri }

type DocumentAttemptReceipt {
  role_named: NonEmptyStr
  subject: DocumentAttemptSubject
  wanted: NonEmptyStr
  observed_on: NonEmptyStr
  observation: DocumentFetchObservation
  disposition: DocumentAttemptDisposition
}

