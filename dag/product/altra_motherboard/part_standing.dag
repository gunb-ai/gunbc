module product.altra_motherboard.part_standing

import std.types { String, NonEmptyStr, List }
import std.integer { Int }
import product.altra_motherboard.placement {
  BoardComponentRole,
  ProcessorSocket,
  ProcessorPackage,
  MemoryModuleSlot,
  BoardControlCpld,
  BootFirmwareEeprom,
  FirmwareFlash,
  ClockGenerator,
  ResetController,
  PowerController,
  NetworkEndpoint,
  StorageEndpoint,
  DebugConnector,
  role_tag,
}
import extdeps.land_pattern.types {
  MountablePart,
  MountingPatternStanding,
}
