fn established_mountable_part(r: BoardComponentRole) -> MountablePart? {
  match r {
    ResetController => Present { value: tps3808g01dbvr }
    ClockGenerator => Present { value: cdce913pwr }
    NetworkEndpoint => Present { value: dp83867irrgz }
    PowerController => Present { value: tps53688rsbr }
    ProcessorSocket => none
    ProcessorPackage => none
    MemoryModuleSlot { channel: _ } => none
    BoardControlCpld => none
    BootFirmwareEeprom => none
    FirmwareFlash => none
    StorageEndpoint => none
    DebugConnector => none
  }
}

fn selected_catalog_part(r: BoardComponentRole) -> CatalogPartIdentity? {
  match r {
    BootFirmwareEeprom => Present { value: at24cm02 }
    FirmwareFlash => Present { value: mx25l25673g }
    StorageEndpoint => Present { value: mdt420m01001 }
    DebugConnector => Present { value: ftsh_105_01_l_dv }
    ResetController => none
    ClockGenerator => none
    NetworkEndpoint => none
    PowerController => none
    ProcessorSocket => none
    ProcessorPackage => none
    MemoryModuleSlot { channel: _ } => none
    BoardControlCpld => none
  }
}

fn dimm_socket_pattern_standing() -> MountingPatternStanding {
  ddr4_dimm_socket_solder_tail_288.board_pattern
}

fn processor_socket_type_named_because() -> NonEmptyStr {
  "vendor identity and orderable part number remain unresolved; ILM4926 is a socket type, not a vendor, not an orderable part, and not a land pattern, and minting a part number here would reopen the package/socket split"
}

data mt_jade_spec_document: NonEmptyStr = "extdeps.ocp.mt_jade Ampere Altra/AltraMax Motherboard Specification v1.0"

fn justification_for(r: BoardComponentRole) -> SelectionJustificationStanding {
  match r {
    ProcessorSocket =>
      ReferenceDesignPrecedent { document: mt_jade_spec_document, section: "12 Mechanical" }
    ProcessorPackage =>
      JustificationOutstanding { because: "the package body is cited from the Ampere datasheet; no motherboard reference-design precedent has been joined to this board's use of it" }
    MemoryModuleSlot { channel: _ } =>
      JustificationOutstanding { because: "the TE 2308107 socket is selected from the vendor specification; no motherboard reference-design precedent has been joined" }
    BoardControlCpld =>
      JustificationOutstanding { because: "the iCE40 TQ144 is cited from the Lattice datasheet; no motherboard reference-design precedent has been joined" }
    BootFirmwareEeprom =>
      JustificationOutstanding { because: "AT24CM02 is named by the parent's report of Mt. Jade; no BOM read has joined that report as a reference-design precedent" }
    FirmwareFlash =>
      JustificationOutstanding { because: "MX25L25673G is named by the parent's report of Mt. Jade; no BOM read has joined that report as a reference-design precedent" }
    ClockGenerator =>
      JustificationOutstanding { because: "the CDCE913PWR is selected from the vendor drawing; no motherboard reference-design precedent has been joined" }
    ResetController =>
      JustificationOutstanding { because: "the TPS3808G01DBVR is selected from the vendor drawing; no motherboard reference-design precedent has been joined" }
    PowerController =>
      JustificationOutstanding { because: "the TPS53688RSBR is selected from the vendor drawing; no motherboard reference-design precedent has been joined" }
    NetworkEndpoint =>
      JustificationOutstanding { because: "the DP83867IRRGZ is selected from the vendor drawing; no motherboard reference-design precedent has been joined" }
    StorageEndpoint =>
      JustificationOutstanding { because: "MDT420M01001 is named by the parent's report of Mt. Jade; no BOM read has joined that report as a reference-design precedent" }
    DebugConnector =>
      JustificationOutstanding { because: "FTSH-105-01-L-DV is a session candidate; Mt. Jade describes JTAG headers and names no part number, so nothing upstream selects it" }
  }
}

fn obligation_standing_for(r: BoardComponentRole) -> PcbObligationStanding? {
  match r {
    MemoryModuleSlot { channel: _ } =>
      Present { value: PatternOutstanding { standing: dimm_socket_pattern_standing() } }
    BootFirmwareEeprom =>
      Present { value: PatternOutstanding { standing: at24cm02.board_pattern } }
    FirmwareFlash =>
      Present { value: PatternOutstanding { standing: mx25l25673g.board_pattern } }
    StorageEndpoint =>
      Present { value: PatternOutstanding { standing: mdt420m01001.board_pattern } }
    DebugConnector =>
      Present { value: PatternOutstanding { standing: ftsh_105_01_l_dv.board_pattern } }
    ProcessorSocket =>
      Present {
        value: TypeNamed {
          type_name: ilm4926_designation,
          because: processor_socket_type_named_because(),
        }
      }
    ProcessorPackage => none
    BoardControlCpld => none
    ResetController => none
    ClockGenerator => none
    NetworkEndpoint => none
    PowerController => none
  }
}

fn document_attempt_count() -> Int {
  fold(altra_parts_document_attempts, init: 0, f: fn(acc, _r) { acc + 1 })
}

fn document_attempts_for_role_name(name: NonEmptyStr) -> List<DocumentAttemptReceipt> {
  fold(altra_parts_document_attempts, init: [], f: fn(acc, r) {
    if (r.role_named as String) == (name as String) {
      concat(acc, [r])
    } else {
      acc
    }
  })
}

fn open_document_attempts() -> List<DocumentAttemptReceipt> {
  fold(altra_parts_document_attempts, init: [], f: fn(acc, r) {
    match r.disposition {
      AttemptOpen => concat(acc, [r])
      AttemptSuperseded { selected_instead: _ } => acc
    }
  })
}

fn superseded_document_attempts() -> List<DocumentAttemptReceipt> {
  fold(altra_parts_document_attempts, init: [], f: fn(acc, r) {
    match r.disposition {
      AttemptOpen => acc
      AttemptSuperseded { selected_instead: _ } => concat(acc, [r])
    }
  })
}

fn observation_tag(o: DocumentFetchObservation) -> NonEmptyStr {
  match o {
    HttpOkTextNotExtractable => "text-not-extractable"
    VendorExtractionFailure { vendor: _ } => "vendor-extraction-failure"
    ScriptRenderedUnreadable => "script-rendered-unreadable"
    SiblingDocumentObserved => "sibling-document-observed"
    HttpGone => "gone"
    HttpForbidden => "forbidden"
    FetchTimedOut => "timeout"
    UrlUnconfirmedForbidden => "url-unconfirmed-forbidden"
  }
}

fn receipt_count(rs: List<DocumentAttemptReceipt>) -> Int {
  fold(rs, init: 0, f: fn(acc, _r) { acc + 1 })
}

fn roster_has_locator(loc: String) -> Bool {
  fold(altra_parts_document_attempts, init: false, f: fn(acc, r) {
    acc || match r.subject {
      CitedCatalogRow { declaration: _ } => false
      UncitedLocator { document: _, uri: u } => (u.locator as String) == loc
    }
  })
}

fn roster_cites_declaration(d: DeclarationRef) -> Bool {
  fold(altra_parts_document_attempts, init: false, f: fn(acc, r) {
    acc || match r.subject {
      CitedCatalogRow { declaration: cited } =>
        (cited.module_path as String) == (d.module_path as String)
          && (cited.decl_name as String) == (d.decl_name as String)
      UncitedLocator { document: _, uri: _ } => false
    }
  })
}

fn open_cited_attempt_count() -> Int {
  fold(open_document_attempts(), init: 0, f: fn(acc, r) {
    match r.subject {
      CitedCatalogRow { declaration: _ } => acc + 1
      UncitedLocator { document: _, uri: _ } => acc
    }
  })
}
