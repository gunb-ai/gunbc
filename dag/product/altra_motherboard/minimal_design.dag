module product.altra_motherboard.minimal_design

// The admitted channel populations and the production/bring-up qualifier are CITED VENDOR FACTS,
// consumed from the datasheet authority rather than re-modelled here. They were authored in this
// module first; re-homing them upstream is what keeps one contract from having two homes.

// THE SMALLEST ALTRA MOTHERBOARD THAT IS A SERVER RATHER THAN A BRING-UP FIXTURE, and the
// distinction is the vendor's own rather than ours. The datasheet admits 1, 2, 4, 6 or 8 active
// DDR4 channels and describes the one- and two-channel configurations as engineering debug and
// bring-up. So a memory configuration is not merely a number to minimise: below four channels the
// part is documented as being outside its production envelope, and a design that quietly selected
// two to save routing effort would be shipping a debug fixture wearing a product's name. That is
// why the channel count is selected against a declared INTENT here rather than chosen as a scalar
// — the same count is admissible for one purpose and refused for another, which a bare Int cannot
// express.
// WHAT THE BOARD IS FOR, and it is a modelled fact because the vendor's admissibility depends on
// it. An engineering bring-up board is a legitimate thing to build and the one- and two-channel
// configurations exist precisely to serve it; what is not legitimate is building one and calling
// it production.
type DesignIntent
  = EngineeringBringUp
  | Production


type DesignRefusal
  = DebugOnlyChannelCountUnderProductionIntent { selected: Int }
  | ChannelCountExceedsControllerPopulation { selected: Int, available: Int }
  | ChannelPopulationIsNotAnAdmittedCount { populated: Int }
  | ChannelPopulatedMoreThanOnce { channel: Int }
  | ChannelHasNoDimmPositions
  | DimmPositionRepeatedOnChannel { position: Int }
  | PcieLanesExceedPackage { requested: Int, available: Int }

// A CHANNEL HAS AN IDENTITY, AND IT IS NOT ITS ORDINAL POSITION IN A COUNT. An earlier revision
// derived the populated set from the count by generating [0..n), which is cardinality standing
// where identity was required: it silently asserts that a four-channel board populates channels
// zero through three. The processor's own controllers are named DDR0 through DDR7 in the
// datasheet's signal grouping, and which four a board populates is a DESIGN DECISION under vendor
// guidance, not an arithmetic consequence — Ampere's own reference board documents several
// distinct valid populations at the same count, pairing controllers across the two halves of the
// package rather than taking the first n. A generated range cannot express that, and worse, it
// cannot express getting it wrong: every count produces exactly one answer and it always looks
// correct.
type DdrChannelIdentity
  = DdrChannel0
  | DdrChannel1
  | DdrChannel2
  | DdrChannel3
  | DdrChannel4
  | DdrChannel5
  | DdrChannel6
  | DdrChannel7

fn ddr_channel_ordinal(c: DdrChannelIdentity) -> Int {
  match c {
    DdrChannel0 => 0
    DdrChannel1 => 1
    DdrChannel2 => 2
    DdrChannel3 => 3
    DdrChannel4 => 4
    DdrChannel5 => 5
    DdrChannel6 => 6
    DdrChannel7 => 7
  }
}

// DIMMS PER CHANNEL IS A POSITION, NOT A QUANTITY. Two DIMMs on one channel are not
// interchangeable: the near and far positions differ in stub length and loading, which is why the
// vendor's population order fills one before the other. A bare count of two cannot say which slot
// a board is placing, so it cannot give the two slots distinct identities, and two connectors that
// cannot be told apart are two connectors that can silently become one.
type DimmSlotPosition
  = FirstDimmOnChannel
  | SecondDimmOnChannel

fn dimm_slot_position_ordinal(p: DimmSlotPosition) -> Int {
  match p {
    FirstDimmOnChannel => 0
    SecondDimmOnChannel => 1
  }
}

type DdrSlotIdentity {
  channel: DdrChannelIdentity
  position: DimmSlotPosition
}

// THE TOPOLOGY IS THE AUTHORITY AND THE COUNT IS DERIVED FROM IT, which is the direction that was
// inverted. Ask the topology how many channels are populated and the answer follows from the
// named set; ask a count which channels are populated and it must invent them.
type ActiveDdrTopology {
  populated_channels: List<DdrChannelIdentity>
  positions_per_channel: List<DimmSlotPosition>
}

fn topology_channel_count(t: ActiveDdrTopology) -> Int {
  std.types.list_length(items: t.populated_channels)
}

fn topology_slot_identities(t: ActiveDdrTopology) -> List<DdrSlotIdentity> {
  fold(t.populated_channels, init: [], f: fn(acc, ch) {
    concat(acc, fold(t.positions_per_channel, init: [], f: fn(inner, pos) {
      concat(inner, [DdrSlotIdentity { channel: ch, position: pos }])
    }))
  })
}

fn ddr_slot_identity_eq(a: DdrSlotIdentity, b: DdrSlotIdentity) -> Bool {
  ddr_channel_ordinal(c: a.channel) == ddr_channel_ordinal(c: b.channel)
    && dimm_slot_position_ordinal(p: a.position) == dimm_slot_position_ordinal(p: b.position)
}

// THE POPULATION IS NAMED CONTROLLERS, and the admitted COUNT is recovered from it rather than
// declared beside it. Carrying both a count field and a channel list would be two statements of
// one fact, and the copy that disagrees is the one nobody edits.
type MemoryConfiguration {
  topology: ActiveDdrTopology
}

// THE COUNT IS RECOVERED, AND A POPULATION THE VENDOR DOES NOT ADMIT HAS NO ANSWER. Three named
// channels do not round down to two: Absent here means the population is outside the enumerated
// set, which becomes a refusal below rather than a nearest admitted value. This is the direction
// the old shape could not fail in — a count could only ever be admissible, because it was chosen
// from the admissible type in the first place.
fn admitted_channel_count(n: Int) -> extdeps.cpu.ampere_altra_memory_controller.ActiveDdrChannelCount? {
  fold([extdeps.cpu.ampere_altra_memory_controller.OneChannel, extdeps.cpu.ampere_altra_memory_controller.TwoChannels, extdeps.cpu.ampere_altra_memory_controller.FourChannels, extdeps.cpu.ampere_altra_memory_controller.SixChannels, extdeps.cpu.ampere_altra_memory_controller.EightChannels], init: none, f: fn(acc, c) {
    match acc {
      Present { value: v } => Present { value: v }
      Absent => if extdeps.cpu.ampere_altra_memory_controller.active_channel_count(c: c) == n { Present { value: c } } else { none }
    }
  })
}

fn channel_occurrences(cs: List<DdrChannelIdentity>, c: DdrChannelIdentity) -> Int {
  fold(cs, init: 0, f: fn(acc, q) {
    if ddr_channel_ordinal(c: q) == ddr_channel_ordinal(c: c) { acc + 1 } else { acc }
  })
}

// AND THE SAME CLASS EXISTS ON THE OTHER AXIS, which the channel half alone did not close. The
// slot identities are the cross product of populated channels and positions per channel, so a
// repeated POSITION duplicates every slot on every channel just as surely as a repeated channel
// duplicates every slot on one — [FirstDimmOnChannel, FirstDimmOnChannel] against four channels
// yields eight identities naming four slots. Refusing only the channel axis left that writable,
// and a duplicated DdrSlotIdentity is exactly the fact everything downstream keys on.
fn position_occurrences(ps: List<DimmSlotPosition>, p: DimmSlotPosition) -> Int {
  fold(ps, init: 0, f: fn(acc, q) {
    if dimm_slot_position_ordinal(p: q) == dimm_slot_position_ordinal(p: p) { acc + 1 } else { acc }
  })
}

fn duplicate_position_causes(t: ActiveDdrTopology) -> List<DesignRefusal> {
  fold(t.positions_per_channel, init: [], f: fn(acc, p) {
    if position_occurrences(ps: t.positions_per_channel, p: p) > 1
      && !fold(acc, init: false, f: fn(seen, r) {
        seen || match r {
          DimmPositionRepeatedOnChannel { position: n } => n == dimm_slot_position_ordinal(p: p)
          ChannelPopulatedMoreThanOnce { channel: _ } => false
          DebugOnlyChannelCountUnderProductionIntent { selected: _ } => false
          ChannelCountExceedsControllerPopulation { selected: _, available: _ } => false
          ChannelPopulationIsNotAnAdmittedCount { populated: _ } => false
          ChannelHasNoDimmPositions => false
          PcieLanesExceedPackage { requested: _, available: _ } => false
        }
      }) {
      concat(acc, [DimmPositionRepeatedOnChannel { position: dimm_slot_position_ordinal(p: p) }])
    } else {
      acc
    }
  })
}

// A CONTROLLER POPULATED TWICE IS A FAILURE THE COUNT FORM COULD NOT EXPRESS, which is the
// clearest evidence that identity was the missing fact rather than a nicety. A generated range
// is duplicate-free by construction, so this class did not exist to be caught; naming the
// channels makes it writable, and this makes it refused.
fn duplicate_channel_causes(t: ActiveDdrTopology) -> List<DesignRefusal> {
  fold(t.populated_channels, init: [], f: fn(acc, c) {
    if channel_occurrences(cs: t.populated_channels, c: c) > 1
      && !fold(acc, init: false, f: fn(seen, r) {
        seen || match r {
          ChannelPopulatedMoreThanOnce { channel: n } => n == ddr_channel_ordinal(c: c)
          DebugOnlyChannelCountUnderProductionIntent { selected: _ } => false
          ChannelCountExceedsControllerPopulation { selected: _, available: _ } => false
          ChannelPopulationIsNotAnAdmittedCount { populated: _ } => false
          ChannelHasNoDimmPositions => false
          DimmPositionRepeatedOnChannel { position: _ } => false
          PcieLanesExceedPackage { requested: _, available: _ } => false
        }
      }) {
      concat(acc, [ChannelPopulatedMoreThanOnce { channel: ddr_channel_ordinal(c: c) }])
    } else {
      acc
    }
  })
}

type AltraMinimalMotherboard {
  intent: DesignIntent
  memory: MemoryConfiguration
  pcie_lanes_broken_out: Int
}

type DesignAdmission
  = DesignAdmitted { design: AltraMinimalMotherboard }
  | DesignRefused { causes: DesignRefusalSet }

type DesignRefusalSet {
  first: DesignRefusal
  rest: List<DesignRefusal>
}

fn push_design_refusal(acc: DesignRefusalSet?, r: DesignRefusal) -> DesignRefusalSet? {
  match acc {
    Absent => Present { value: DesignRefusalSet { first: r, rest: [] } }
    Present { value: s } => Present { value: DesignRefusalSet { first: s.first, rest: concat(s.rest, [r]) } }
  }
}

fn design_refusal_count(s: DesignRefusalSet) -> Int {
  1 + fold(s.rest, init: 0, f: fn(acc, _r) { acc + 1 })
}

fn total_dimms(m: MemoryConfiguration) -> Int {
  std.types.list_length(items: topology_slot_identities(t: m.topology))
}

// EVERY BOUND IS READ FROM THE PACKAGE AUTHORITY, never retyped. The controller population and
// the lane count come from the cited datasheet rows, so a correction there moves this admission
// rather than leaving it agreeing with a number that has changed.
fn design_causes(d: AltraMinimalMotherboard) -> List<DesignRefusal> {
  let selected = topology_channel_count(t: d.memory.topology)
  let admitted = admitted_channel_count(n: selected)
  let intent_cause = match admitted {
    Absent => [ChannelPopulationIsNotAnAdmittedCount { populated: selected }]
    Present { value: c } =>
      match d.intent {
        EngineeringBringUp => []
        Production =>
          if extdeps.cpu.ampere_altra_memory_controller.channel_count_is_production_qualified(c: c) {
            []
          } else {
            [DebugOnlyChannelCountUnderProductionIntent { selected: selected }]
          }
      }
  }
  let population_cause = if selected > extdeps.cpu.ampere_altra_package.altra_ddr4_channel_count {
    [ChannelCountExceedsControllerPopulation { selected: selected, available: extdeps.cpu.ampere_altra_package.altra_ddr4_channel_count }]
  } else {
    concat([], duplicate_channel_causes(t: d.memory.topology))
  }
  let dimm_cause = if std.types.list_length(items: d.memory.topology.positions_per_channel) < 1 {
    [ChannelHasNoDimmPositions]
  } else {
    duplicate_position_causes(t: d.memory.topology)
  }
  let pcie_cause = if d.pcie_lanes_broken_out > extdeps.cpu.ampere_altra_package.altra_pcie_gen4_lane_count {
    [PcieLanesExceedPackage { requested: d.pcie_lanes_broken_out, available: extdeps.cpu.ampere_altra_package.altra_pcie_gen4_lane_count }]
  } else {
    []
  }
  concat(concat(intent_cause, population_cause), concat(dimm_cause, pcie_cause))
}

fn admit_design(d: AltraMinimalMotherboard) -> DesignAdmission {
  match fold(design_causes(d: d), init: none, f: fn(acc, c) { push_design_refusal(acc: acc, r: c) }) {
    Absent => DesignAdmitted { design: d }
    Present { value: s } => DesignRefused { causes: s }
  }
}

// THE SELECTED MINIMUM. Four channels because that is the smallest production-qualified
// population, one DIMM per channel because a second is a capacity decision rather than a
// bring-up requirement, and four PCIe lanes because the increment routes one x4 path. Every one
// of those is a floor rather than a preference, and each is checked above against the package's
// own numbers rather than asserted here.
// WHICH FOUR CONTROLLERS IS OUR DECISION AND IS RECORDED AS ONE. The board outline in placement
// is authored the same way and for the same reason: how we build our own board is not a claim
// about anyone's document. What would be a claim -- and is NOT made here -- is that this
// particular set is the vendor's recommended four. Whether Ampere's interleaving guidance
// constrains the choice is an open question against a document nobody has read on that point,
// carried on the source-document roster rather than settled by picking a set that looks
// symmetric and calling it advice.
data altra_1p_minimum: AltraMinimalMotherboard = AltraMinimalMotherboard {
  intent: Production,
  memory: MemoryConfiguration {
    topology: ActiveDdrTopology {
      populated_channels: [DdrChannel0, DdrChannel1, DdrChannel2, DdrChannel3],
      positions_per_channel: [FirstDimmOnChannel],
    },
  },
  pcie_lanes_broken_out: 4,
}
