module product.fabric.demand

import std.types { NonEmptyStr, Timestamp, Bool, List }
import std.measure { MoneyAmountMicro }
import std.currency { CurrencyCode }
import product.fabric.identity { fabric_identity_eq, FabricIdentity, DemandKey, WorkKey }

// Demand is WHO currently wants a result and WHERE to report it. Provider facts
// live here and nowhere else, which is what keeps Work provider-neutral.

// A Demand is immutable. There is deliberately no cancelled, superseded or
// rerun field on it, because those are TRANSITIONS over an identity rather
// than properties of one - and a mutable status field is the thing that later
// makes it impossible to answer what was true when a decision was taken. A
// binding interprets a provider observation into one of the normalized
// commands below and supplies authenticated evidence for that interpretation;
// the core decides the effect.
// Cancellation CANNOT live entirely in a provider binding, and the reason is a
// two-provider argument rather than a stylistic one. Suppose a GitHub demand
// and a GitLab demand attach to the same Work. If the GitHub binding cancels
// that Work directly when its pull request is superseded, it destroys work the
// GitLab demand still requires. Only the core knows the complete demand
// population, so the binding owns INTERPRETATION - this observation means
// withdraw, or supersede, or re-execute - and the core owns EFFECT: whether
// the transition is authorized, whether any other demand still requires the
// Work, whether a running Attempt should continue, whether capacity and budget
// should be released.
// Rerun is not one flag. It decomposes into three independent questions, and
// collapsing them is how re-run comes to mean delete every cache. (1) May an
// existing terminal receipt satisfy this demand? (2) Must a new Attempt exist?
// (3) May that Attempt reuse accepted step receipts and materializations? An
// ordinary duplicate demand answers yes, no, yes - it attaches to the existing
// execution. A provider rerun answers no, yes, yes - the prior verdict is not
// accepted but warm materializations remain valid. An operator clean recompute
// answers no, yes, no - prior step materializations are refused at the
// declared frame. Three separate fields, because a system that offers only
// rerun forces the third answer whenever the first is wanted.
type SatisfactionRequirement {
  terminal_receipt_may_satisfy: Bool
  new_attempt_required: Bool
  step_reuse_permitted: Bool
}

// Provenance is the binding's stable, idempotent reference to whatever the
// provider observed. The core treats it as opaque: it is carried so a result can
// be reported back, and it is never interpreted.

type ObservationReceiptRef = NonEmptyStr where brand("ObservationReceiptRef")

type BudgetAccountId = NonEmptyStr where brand("BudgetAccountId")

// Buy terms are the BUYER half of the posted-offer market. A reservation price is
// the maximum this demand will pay; a delay valuation prices waiting, without
// which a fabric optimizing money alone waits minutes to save cents.

// Three monetary facts stay separate throughout, and conflating them into one
// price field is the defect this note exists to prevent. MaximumLiability is
// the amount that must be RESERVED before a grant may issue. SelectionCost is
// the amount used to COMPARE candidates, and it includes valued availability
// delay so that a supplier who can start now is correctly preferred over a
// cheaper supplier who cannot. ActualSpend is the irreversible amount SETTLED
// after execution and release. For the first policy the maximum liability may
// equal the provider-charge portion of the selection cost; keeping the three
// named means a later expected-cost model can diverge without touching ExecutionGrant
// or settlement. maximum_buy_order is the ceiling on a single grant's
// liability - a refusal boundary, never a degradation: an ask above it refuses
// rather than selecting something cheaper and unsuitable.
// There is deliberately NO delay-valuation field yet. Selection is specified
// to compare a provider charge against a valued availability delay, which
// needs a money-per-second RATE, and this record has no honest carrier for
// one: MoneyAmountMicro would put the dimension in the field name, and the
// existing MoneyRate bundles a CurrencyCode that would let a rate disagree
// with the currency these terms already carry.
//
// Landing the field on the wrong type and describing the mismatch in a comment
// was the alternative, and it is the shape DESIGN refuses -- a dissolution note
// is a lifecycle fact, not permission to create the debt, and the author cannot
// grant himself that permission. Since nothing consumes the field yet, the
// cheaper and more honest option is simply not to ship it: the terms carry what
// they can state correctly, and the rate arrives with its carrier once the
// denomination authority -- these terms, or the referenced budget account -- is
// decided. An absent field forces that decision; a wrongly-typed one hides it.
type BuyTerms {
  budget_account: BudgetAccountId
  currency: CurrencyCode
  reservation_price: MoneyAmountMicro
  maximum_buy_order: MoneyAmountMicro
}

type AdmissionTerms {
  priority_class: NonEmptyStr
  deadline: Timestamp?
  buy: BuyTerms
}

type Demand<P> {
  id: FabricIdentity<P, DemandKey>
  work: FabricIdentity<P, WorkKey>
  origin: ObservationReceiptRef
  submitted_at: Timestamp
  admission: AdmissionTerms
  satisfaction: SatisfactionRequirement
}

// The normalized command vocabulary a binding may produce. A provider event is
// interpreted into exactly one of these; the core never sees the provider's own
// event shape.

type DemandCommand<P>
  = SubmitDemand { demand: Demand<P> }
  | WithdrawDemand { demand: FabricIdentity<P, DemandKey>, evidence: ObservationReceiptRef }
  | SupersedeDemand {
      superseded: FabricIdentity<P, DemandKey>,
      replacement: Demand<P>,
      evidence: ObservationReceiptRef,
    }

fn demand_work<P>(d: Demand<P>) -> FabricIdentity<P, WorkKey> {
  d.work
}

fn demand_reservation_price<P>(d: Demand<P>) -> MoneyAmountMicro {
  d.admission.buy.reservation_price
}

fn demand_maximum_buy_order<P>(d: Demand<P>) -> MoneyAmountMicro {
  d.admission.buy.maximum_buy_order
}

// The core effect of a command, half one: what it does to the demand
// POPULATION. This half is a pure demand fact and therefore lives here. The
// half that joins it to a running execution lives in product.fabric.arbitration,
// because a running attempt and its reservations are execution carriers and
// execution already imports this module - the join cannot live here without
// inverting that edge. Splitting on the import direction is not two
// authorities for one decision: this module answers who is registered and
// whether the transition is authorized, and nothing else answers that.

// Refusal causes are separate arms because they have different owners and
// different repairs, and the pair that matters most is the first two.
// UnknownDemand means no demand with that key is registered at all - the
// binding is out of date, or replaying. DemandPrincipalMismatch means the key
// IS registered, under a different principal: that is not a stale binding, it
// is one requester presenting another requester's demand identity, and
// collapsing it into UnknownDemand would report a cross-tenant authorization
// failure as a bookkeeping miss. The identity pair exists precisely so that
// dropping the principal is not an ordinary field access; a refusal vocabulary
// that cannot say which half failed drops it again at the diagnostic layer.
//
// There is deliberately no MissingEvidence arm. ObservationReceiptRef is
// branded over NonEmptyStr, so a command carrying no evidence has no spelling,
// and an arm for it would be permanently green by construction - cited as
// coverage while carrying no information.
// The core cannot authenticate. Evidence is an opaque provenance reference that
// this module states it never interprets, and inventing a verification of it
// here would fabricate exactly the external fact a boundary is supposed to
// refuse on. What the core CAN decide, and did not, is that a caller may only
// act as the principal it attested to being.
//
// That gap was real and it was cross-tenant. The principal-mismatch arm below
// catches a FALSELY presented principal - a key registered to someone else -
// and stops there. It says nothing about a CORRECTLY presented one, so a
// binding holding another requester's full FabricIdentity could withdraw that
// requester's demand and every check passed, because the pair genuinely
// matched. Possession of an identity was authorization to mutate it.
//
// The attestation is what the caller claims to have authenticated, carried with
// the receipt that established it. The core refuses any command acting outside
// it. What remains outside the modeled guarantee is whether the attestation is
// itself true, which is the binding's obligation at its own boundary and is
// declared here rather than silently assumed.
type CommandAttestation<P> {
  principal: P
  evidence: ObservationReceiptRef
}

type DemandRefusal<P>
  = UnknownDemand { demand: FabricIdentity<P, DemandKey> }
  | AttestationDoesNotCoverPrincipal {
      attested: P,
      acting: P,
    }
  | DemandPrincipalMismatch { demand: FabricIdentity<P, DemandKey> }
  | DuplicateDemand { demand: FabricIdentity<P, DemandKey> }
  | ReplacementAlreadyRegistered { demand: FabricIdentity<P, DemandKey> }
  | SupersedeCrossesPrincipal {
      superseded: FabricIdentity<P, DemandKey>,
      replacement: FabricIdentity<P, DemandKey>,
    }
  | ReplacementWorkMismatch {
      superseded_work: FabricIdentity<P, WorkKey>,
      replacement_work: FabricIdentity<P, WorkKey>,
    }

// Every admitted command names exactly one subject Work, and carrying it out of
// the transition is what lets the execution half be decided without a second
// lookup that could disagree. For a withdrawal the subject is the work of the
// demand that was removed, which is no longer in the advanced population - a
// consumer that had to re-derive it would have to search a population the
// answer has already left.
type DemandRegistration<P>
  = RegistrationAdvanced {
      population: List<Demand<P>>,
      subject_work: FabricIdentity<P, WorkKey>,
    }
  | RegistrationRefused { refusal: DemandRefusal<P> }

fn demands_for_work<P>(
  population: List<Demand<P>>,
  work: FabricIdentity<P, WorkKey>,
) -> List<Demand<P>> {
  population |> filter(d => fabric_identity_eq(left: d.work, right: work))
}

fn demand_matching_identity<P>(
  population: List<Demand<P>>,
  id: FabricIdentity<P, DemandKey>,
) -> List<Demand<P>> {
  population |> filter(d => fabric_identity_eq(left: d.id, right: id))
}

fn demand_matching_key<P>(population: List<Demand<P>>, key: DemandKey) -> List<Demand<P>> {
  population |> filter(d => d.id.key == key)
}

fn population_without<P>(
  population: List<Demand<P>>,
  id: FabricIdentity<P, DemandKey>,
) -> List<Demand<P>> {
  population |> filter(d => !fabric_identity_eq(left: d.id, right: id))
}

// Lookup refuses on the pair and distinguishes the two ways it can fail. The
// key-only search runs only after the pair search has already missed, so a
// match there is exactly the cross-principal case and nothing else.
type DemandLookup<P>
  = DemandFound { demand: Demand<P> }
  | DemandLookupRefused { refusal: DemandRefusal<P> }

fn lookup_demand<P>(
  population: List<Demand<P>>,
  id: FabricIdentity<P, DemandKey>,
) -> DemandLookup<P> {
  match demand_matching_identity(population: population, id: id) {
    Cons { head: d, tail: _ } => DemandFound { demand: d }
    Empty {} =>
      match demand_matching_key(population: population, key: id.key) {
        Cons { head: _, tail: _ } =>
          DemandLookupRefused { refusal: DemandPrincipalMismatch { demand: id } }
        Empty {} => DemandLookupRefused { refusal: UnknownDemand { demand: id } }
      }
  }
}

// A submission whose identity is already registered refuses rather than
// replacing silently. Replacing would mean a binding could change the
// satisfaction requirement or the buy terms of a live demand by re-submitting
// under the same identity, which is a supersede without the supersede's
// authorization checks.
fn submit_demand_into<P>(population: List<Demand<P>>, d: Demand<P>) -> DemandRegistration<P> {
  match demand_matching_identity(population: population, id: d.id) {
    Cons { head: _, tail: _ } =>
      RegistrationRefused { refusal: DuplicateDemand { demand: d.id } }
    Empty {} =>
      RegistrationAdvanced { population: concat(population, [d]), subject_work: d.work }
  }
}

// Supersede is one requester replacing its own demand on the same Work. Both
// of those are checked rather than assumed. A replacement naming a different
// Work is a withdrawal plus a submission, and admitting it here would move a
// demand across Works under a command whose whole contract is that it does
// not; a replacement under a different principal is one requester writing into
// another's population.
fn supersede_demand_in<P>(
  population: List<Demand<P>>,
  superseded: FabricIdentity<P, DemandKey>,
  replacement: Demand<P>,
) -> DemandRegistration<P> {
  match lookup_demand(population: population, id: superseded) {
    DemandLookupRefused { refusal: r } => RegistrationRefused { refusal: r }
    DemandFound { demand: prior } =>
      if prior.id.principal != replacement.id.principal {
        RegistrationRefused {
          refusal: SupersedeCrossesPrincipal {
            superseded: superseded,
            replacement: replacement.id,
          }
        }
      } else if !fabric_identity_eq(left: prior.work, right: replacement.work) {
        RegistrationRefused {
          refusal: ReplacementWorkMismatch {
            superseded_work: prior.work,
            replacement_work: replacement.work,
          }
        }
      } else {
        match demand_matching_identity(population: population, id: replacement.id) {
          Cons { head: _, tail: _ } =>
            if fabric_identity_eq(left: replacement.id, right: superseded) {
              RegistrationAdvanced {
                population: concat(
                  population_without(population: population, id: superseded),
                  [replacement],
                ),
                subject_work: prior.work,
              }
            } else {
              RegistrationRefused {
                refusal: ReplacementAlreadyRegistered { demand: replacement.id }
              }
            }
          Empty {} =>
            RegistrationAdvanced {
              population: concat(
                population_without(population: population, id: superseded),
                [replacement],
              ),
              subject_work: prior.work,
            }
        }
      }
  }
}

// The principal a command ACTS AS. For a submission it is the principal the new
// demand is registered under; for a withdrawal or a supersede it is the
// principal of the demand being removed. A supersede's replacement is checked
// separately against the superseded demand, so a command cannot act as one
// principal and land as another.
fn acting_principal<P>(command: DemandCommand<P>) -> P {
  match command {
    SubmitDemand { demand: d } => d.id.principal
    WithdrawDemand { demand: id, evidence: _ } => id.principal
    SupersedeDemand { superseded: s, replacement: _, evidence: _ } => s.principal
  }
}

// The attestation gate runs before any lookup, and that ordering is the point.
// Checking it after the lookup would let an unattested caller learn whether a
// key exists under another principal from the difference between the two
// refusals, which is a smaller leak than the mutation but a leak with the same
// owner.
fn apply_demand_command<P>(
  population: List<Demand<P>>,
  attestation: CommandAttestation<P>,
  command: DemandCommand<P>,
) -> DemandRegistration<P> {
  let acting = acting_principal(command: command)
  if attestation.principal != acting {
    RegistrationRefused {
      refusal: AttestationDoesNotCoverPrincipal {
        attested: attestation.principal,
        acting: acting,
      }
    }
  } else {
    admitted_command_transition(population: population, command: command)
  }
}

fn admitted_command_transition<P>(
  population: List<Demand<P>>,
  command: DemandCommand<P>,
) -> DemandRegistration<P> {
  match command {
    SubmitDemand { demand: d } => submit_demand_into(population: population, d: d)
    WithdrawDemand { demand: id, evidence: _ } =>
      match lookup_demand(population: population, id: id) {
        DemandLookupRefused { refusal: r } => RegistrationRefused { refusal: r }
        DemandFound { demand: d } =>
          RegistrationAdvanced {
            population: population_without(population: population, id: id),
            subject_work: d.work,
          }
      }
    SupersedeDemand { superseded: s, replacement: r, evidence: _ } =>
      supersede_demand_in(population: population, superseded: s, replacement: r)
  }
}

// Whether any demand still requires a Work is the question a binding cannot
// answer, and it is the whole reason cancellation routes through the core. The
// remaining population is carried rather than a count, because the consumer
// that keeps the attempt running needs to know WHICH demands it is still
// running for in order to report to them.
type WorkRequirement<P>
  = WorkStillRequired { remaining: List<Demand<P>> }
  | WorkNoLongerRequired { work: FabricIdentity<P, WorkKey> }

fn work_requirement<P>(
  population: List<Demand<P>>,
  work: FabricIdentity<P, WorkKey>,
) -> WorkRequirement<P> {
  let remaining = demands_for_work(population: population, work: work)
  if remaining.length() == 0 {
    WorkNoLongerRequired { work: work }
  } else {
    WorkStillRequired { remaining: remaining }
  }
}

// The three satisfaction answers, consumed independently. Each field decides a
// different arm, and none of them is reachable from the other two: flipping
// terminal_receipt_may_satisfy moves between satisfaction and execution,
// flipping new_attempt_required moves between attaching and a fresh attempt,
// and flipping step_reuse_permitted changes what that fresh attempt may reuse
// without changing whether it exists. That is the property the three-field
// decomposition claims, and a directive in which any one field could not move
// the output would be the collapse the fields exist to prevent.
type StepReusePolicy =
  | ReuseAcceptedStepReceipts
  | RefuseStepReuseAtDeclaredFrame

// Availability is supplied as a named observation rather than a Bool, so that
// the absent case reads as an observed absence at the call site instead of a
// polarity the reader has to reconstruct from the parameter name.
type TerminalReceiptAvailability =
  | TerminalReceiptPresent
  | NoTerminalReceipt

type ExecutionPresence =
  | ExecutionInFlight
  | NoExecutionInFlight

// AwaitAdmission is a real answer, not a fallthrough: the demand is registered,
// nothing is running, and nothing about this demand requires that something
// start immediately - admission and selection decide that. Folding it into
// RequireNewAttempt would let a demand that did not ask for one manufacture an
// attempt, and folding it into AttachToExistingExecution would name an
// execution that does not exist.
type SatisfactionDirective
  = SatisfiedByTerminalReceipt
  | AttachToExistingExecution
  | RequireNewAttempt { reuse: StepReusePolicy }
  | AwaitAdmission

fn satisfaction_directive(
  s: SatisfactionRequirement,
  terminal: TerminalReceiptAvailability,
  execution: ExecutionPresence,
) -> SatisfactionDirective {
  match terminal {
    TerminalReceiptPresent =>
      if s.terminal_receipt_may_satisfy {
        SatisfiedByTerminalReceipt
      } else {
        attempt_directive(s: s, execution: execution)
      }
    NoTerminalReceipt => attempt_directive(s: s, execution: execution)
  }
}

fn attempt_directive(s: SatisfactionRequirement, execution: ExecutionPresence) -> SatisfactionDirective {
  if s.new_attempt_required {
    RequireNewAttempt { reuse: step_reuse_policy(s: s) }
  } else {
    match execution {
      ExecutionInFlight => AttachToExistingExecution
      NoExecutionInFlight => AwaitAdmission
    }
  }
}

fn step_reuse_policy(s: SatisfactionRequirement) -> StepReusePolicy {
  if s.step_reuse_permitted {
    ReuseAcceptedStepReceipts
  } else {
    RefuseStepReuseAtDeclaredFrame
  }
}
