module product.fabric.execution

// An Attempt is one concrete try at a Work. Retries create attempts; they never
// create new Work and never mutate a failed attempt back into a pending one.

// Lineage is a typed reason rather than a counter, because the three reasons
// an attempt exists have different authorization, different accounting and
// different reuse rules, and a retry_count answers none of them.
// InitialAttempt is the first try for a demand. InfrastructureRetry names the
// prior attempt AND the receipt that classified the loss, so an attempt can
// never claim infrastructure loss without evidence of it - the failure mode
// that makes a real compile error retry forever is a classifier that discards
// the termination reason. RequestedReexecution is a demand-driven rerun, which
// is policy rather than infrastructure. An attempt carries no host and no
// mutable status: the host lives on the ExecutionGrant, and the position in the run is
// DERIVED from accepted receipts, never stored.
type ExecutionAttemptLineage<P>
  = InitialAttempt { initiating_demand: product.fabric.identity.FabricIdentity<P, product.fabric.identity.DemandKey> }
  | InfrastructureRetry {
      prior_attempt: product.fabric.identity.FabricIdentity<P, product.fabric.identity.ExecutionAttemptKey>,
      cause_receipt: product.fabric.demand.ObservationReceiptRef,
    }
  | RequestedReexecution { initiating_demand: product.fabric.identity.FabricIdentity<P, product.fabric.identity.DemandKey> }

type Attempt<P> {
  id: product.fabric.identity.FabricIdentity<P, product.fabric.identity.ExecutionAttemptKey>
  work: product.fabric.identity.FabricIdentity<P, product.fabric.identity.WorkKey>
  lineage: ExecutionAttemptLineage<P>
  created_at: std.types.Timestamp
}

// A resource claim is a quantity reserved against a conserved appropriation. The
// money claim and the compute claims are the same shape at different magnitudes,
// which is why one parameterized ledger serves both.

type ReservationRef = std.types.NonEmptyStr where brand("ReservationRef")

type LeaseKey = std.types.NonEmptyStr where brand("LeaseKey")

type LeaseIdentity {
  lease_key: LeaseKey
  resource_fingerprint: std.content_hash.ContentHash
  generation: Int
}

// resource_fingerprint names the EXACT reserved claim, not the host. Naming
// the host is the defect that makes two admitted slices of one machine
// indistinguishable at the fence, so a stale holder of one slice can
// invalidate a live holder of another. Ownership and generation fencing come
// from std.temporal_effect HeldLease; what that carrier does NOT supply is
// time - it has no timestamp and no expiry, and its stale arm is a supplied
// observation rather than a verdict derived from a deadline. Lease liveness is
// therefore new modeling that lands with the reservation ledger, and it is
// stated here so no reader concludes from the presence of a generation that
// expiry is already solved.
// The ExecutionGrant is an authorization decision, not a bespoke fold. It projects into
// std.access, whose AccessDecision is the only allow/deny result in the system.

// There is deliberately no FabricGrantDecision of Allowed and Denied.
// std.access is the one authorization kernel, its decision type is the only
// allow/deny result, and every denial already carries a typed cause at
// structured request coordinates. Minting a parallel decision sum here would
// be the second authority DESIGN forbids, and it would immediately diverge:
// one of the two would gain a refusal cause the other lacked. The positive
// ExecutionGrant carrier below records what an admitted request produced; it is not a
// second verdict.
type FabricGrantAction =
  | ExecuteAttempt

type FabricGrantObject<P> {
  offer: product.fabric.identity.FabricIdentity<P, product.fabric.identity.OfferKey>
  quote: product.fabric.supply.OfferQuote
}

type FabricGrantContext<P> {
  demand: product.fabric.identity.FabricIdentity<P, product.fabric.identity.DemandKey>
  work: product.fabric.identity.FabricIdentity<P, product.fabric.identity.WorkKey>
  attempt: product.fabric.identity.FabricIdentity<P, product.fabric.identity.ExecutionAttemptKey>
  executor: P
  lease: LeaseIdentity
  issued_at: std.types.Timestamp
  maximum_liability: std.measure.MoneyAmountMicro
}

type FabricGrantEvidence {
  fungibility_receipt: product.fabric.demand.ObservationReceiptRef
  offer_authority: product.fabric.demand.ObservationReceiptRef
  resource_conservation: product.fabric.demand.ObservationReceiptRef
  budget_conservation: product.fabric.demand.ObservationReceiptRef
  principal_authority: product.fabric.demand.ObservationReceiptRef
}

type ExecutionGrant<P> {
  id: product.fabric.identity.FabricIdentity<P, product.fabric.identity.GrantKey>
  object: FabricGrantObject<P>
  context: FabricGrantContext<P>
  evidence: FabricGrantEvidence
  resource_reservations: std.types.List<ReservationRef>
  money_reservation: ReservationRef
}

// Every reservation a grant requires is applied tentatively and committed only
// if EVERY ledger admits. Resource admitted with money refused must commit no
// resource reservation, and money admitted with resource refused must commit
// no money reservation; both are one canonical state transition. A partial
// commit is the state that leaks capacity or budget with no grant to account
// for it, and it is unreachable only if the join is atomic rather than
// sequential.
// Receipts are what was materialized, executed and settled. Acceptance is gated
// on the lease generation still being canonical.

type ReceiptPayload
  = MaterializationReceipt { source: std.content_hash.ContentHash, verified_at: std.types.Timestamp }
  | ExecutionReceipt {
      step_id: std.types.NonEmptyStr,
      outputs: std.content_hash.ContentHash,
      billable: std.measure.Second,
      completed_at: std.types.Timestamp,
    }
  | SettlementReceipt {
      reservation: ReservationRef,
      actual_spend: std.measure.MoneyAmountMicro,
      settled_at: std.types.Timestamp,
    }

type Receipt<P> {
  id: product.fabric.identity.FabricIdentity<P, product.fabric.identity.ReceiptKey>
  attempt: product.fabric.identity.FabricIdentity<P, product.fabric.identity.ExecutionAttemptKey>
  lease: LeaseIdentity
  payload: ReceiptPayload
}

// Elapsed execution time is NOT by itself authoritative spend, which is why
// the execution receipt carries billable seconds as an OBSERVATION and the
// settlement receipt carries the settled amount as a separate fact. The
// supplier binding owns the billing rule - when billing starts, the quantum
// and rounding, minimum charge, fixed and setup charges, caps, and when
// billing stops - because those differ per supplier and are already visible in
// the cited rows: hourly rates alongside monthly caps and setup fees.
// Settlement therefore derives from quote plus billable-usage evidence plus
// release evidence, and MISSING RELEASE EVIDENCE HOLDS THE RESERVATION rather
// than assuming the supplier stopped charging. Assuming release is the arm
// that quietly under-reserves against a machine still billing.
fn receipt_lease_generation<P>(r: Receipt<P>) -> Int {
  r.lease.generation
}

fn grant_lease_generation<P>(g: ExecutionGrant<P>) -> Int {
  g.context.lease.generation
}

// Acceptance compares the WHOLE lease identity, not the generation alone.
// Comparing generations only was a real fencing hole: generation is a small
// integer that every lease starts at and increments independently, so two
// entirely different leases sit at the same number almost immediately, and a
// receipt produced under one would have been accepted against a grant holding
// the other. The comment above this block already said resource_fingerprint
// must name the exact reserved claim so a stale holder of one slice cannot
// invalidate a live holder of another -- and then the check ignored it, which
// made the prose describe a wall the code did not build.
//
// The attempt is compared for the same reason. A receipt names the attempt
// that produced it, and a grant names the attempt it authorized; a receipt
// from a different attempt is not stale, it is unrelated, and the two
// deserve different causes rather than one Bool that says only "no".
//
// It is compared as a full FabricIdentity, not by key. Comparing keys alone
// admitted a receipt from a DIFFERENT PRINCIPAL that happened to use the same
// attempt name -- a cross-tenant fail-open in the exact carrier whose whole
// design puts the principal inside the identity so it cannot be dropped by
// accident. It was dropped by accident anyway, one field access at a time,
// which is why the pair now has an equality function rather than leaving each
// caller to remember.
//
// A cross-family fingerprint comparison REFUSES rather than reporting
// difference. Two hashes from different families are not known-different,
// they are incomparable, and collapsing that into "different" would report
// a definite mismatch where the honest answer is that no comparison happened.

type ReceiptAdmission =
  | ReceiptAdmissible
  | ReceiptFromDifferentLease
  | ReceiptFromDifferentAttempt
  | ReceiptFingerprintIncomparable
  | ReceiptGenerationStale { presented: Int, current: Int }

fn admit_receipt_for_grant<P>(r: Receipt<P>, g: ExecutionGrant<P>) -> ReceiptAdmission {
  if !product.fabric.identity.fabric_identity_eq(left: r.attempt, right: g.context.attempt) {
    ReceiptFromDifferentAttempt
  } else if r.lease.lease_key != g.context.lease.lease_key {
    ReceiptFromDifferentLease
  } else {
    match std.content_hash.compare_content_hash(
      left: r.lease.resource_fingerprint,
      right: g.context.lease.resource_fingerprint,
    ) {
      ContentHashCrossFamilyIncomparable => ReceiptFingerprintIncomparable
      ContentHashDifferent => ReceiptFromDifferentLease
      ContentHashEqual =>
        if receipt_lease_generation(r: r) == grant_lease_generation(g: g) {
          ReceiptAdmissible
        } else {
          ReceiptGenerationStale {
            presented: receipt_lease_generation(r: r),
            current: grant_lease_generation(g: g),
          }
        }
    }
  }
}
