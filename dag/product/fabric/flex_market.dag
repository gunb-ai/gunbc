// Market-level interruptible bid, ranking, cleanup pacing, and ownership. Ctrl reference
// (read-only): gunb-ai/ctrl lib/vast_bidder.mjs, vast_rentals.mjs. No second decision algebra:
// level choice and card ranking consume std.decision ValuedObjective / std.pareto.
//
// Objective relation: bid-level choice uses fabric DemandObjective CostPerAcceptedUnit
// (debt_payoff): term_money is total rental cost, term_accepted_work is productive seconds.
// Card ranking is a different decision: NetValue over flex_term_vram_hour (MoneyPerGibibyteHour
// after the held switch premium). Those identities are not fabric demand terms.
//
// DECLARED FRONTIERS (DESIGN §3c) for bright-moth-475 (wet loop, key custody, harness placement):
data flex_wet_consumes_market_policy: DissolutionCondition = unbound_dissolution(description: "Wet create/destroy loop executes flex_quoted_bid, flex_choose_bid_level (via flex_select_scored_level / select_realization), flex_select_owned_cards, flex_cleanup_dead, flex_release_pass, and flex_ours_only over gunbc-flex. TRIGGER: that loop remains if test.claim.fabric.flex_market_witness is deleted. SUFFICIENT FOR deleting this row.")

data flex_owner_label_on_create: DissolutionCondition = unbound_dissolution(description: "Wet create PUT sets label from flex_owner_label_gunbc_flex. TRIGGER: create request carries that required owner. SUFFICIENT FOR deleting this row.")

data flex_qwen_placement_consumes_rank: DissolutionCondition = unbound_dissolution(description: "Harness placement consumes flex_rented_card_fungible over a HarnessServingUnit probe (catalog authority gunbc.harness.harness_reasoning_wire), not vLLM parser spellings. TRIGGER: gunbc.harness.harness_requirement_placement refuses a rented card whose probe is not FlexCardUnitEstablished with a placeable catalog unit. SUFFICIENT FOR deleting this row.")

data flex_wet_consumes_vast_write_shapes: DissolutionCondition = unbound_dissolution(description: "Wet loop binds transport and executes vast_ai.Asks Create (label required), vast_ai.InstanceLifecycle Destroy, and ChangeBid. TRIGGER: that loop remains if test.claim.fabric.flex_market_witness is deleted. SUFFICIENT FOR deleting this row.")

// Exact ratios 0.6 / 0.8 / 1.0 (vast_rentals.LEVELS).
type FlexBidLevel
  = FlexBidLevelThreeFifths
  | FlexBidLevelFourFifths
  | FlexBidLevelMarket

fn flex_bid_level_fraction(level: FlexBidLevel) -> NonzeroNatFraction {
  match level {
    FlexBidLevelThreeFifths => NonzeroNatFraction { num: 3, denom_predecessor: 4 }
    FlexBidLevelFourFifths => NonzeroNatFraction { num: 4, denom_predecessor: 4 }
    FlexBidLevelMarket => NonzeroNatFraction { num: 1, denom_predecessor: 0 }
  }
}

fn flex_bid_levels() -> List<FlexBidLevel> {
  [FlexBidLevelThreeFifths, FlexBidLevelFourFifths, FlexBidLevelMarket]
}

fn flex_bid_level_eq(left: FlexBidLevel, right: FlexBidLevel) -> Bool {
  match left {
    FlexBidLevelThreeFifths => match right { FlexBidLevelThreeFifths => true FlexBidLevelFourFifths => false FlexBidLevelMarket => false }
    FlexBidLevelFourFifths => match right { FlexBidLevelThreeFifths => false FlexBidLevelFourFifths => true FlexBidLevelMarket => false }
    FlexBidLevelMarket => match right { FlexBidLevelThreeFifths => false FlexBidLevelFourFifths => false FlexBidLevelMarket => true }
  }
}

data flex_reconstruction: Second = second(count: 300)

// A LOADING CARD IS DEAD once it has been loading past the launch's own first-boot envelope, not past an
// arbitrary ten minutes. The envelope is set by the launch shape, and the only two shapes ever observed to
// boot a rented card (live Vast tests, 2026-10-27/28) both take far longer than 600 s: an args-mode launch
// (runtype args, onstart carried in the per-rent create args) served in about 25 minutes, and an ssh-mode
// launch sat in a per-host image build for 56+ minutes TWICE, with a third card dead at 55 minutes. A 600 s
// cut therefore destroyed cards that were booting normally, on a card whose rate we are already paying.
// 120 minutes is the policy: it is the same number ctrl runs its live bidder with (its 120 min load
// timeout), it clears both observed first boots with room, and it is a ceiling — a card still loading after
// two hours is not booting, it is stuck, and it is being paid for while stuck.
// DERIVE, DO NOT COPY: if the launch shape changes, this number moves with it. It is not a tuning knob.
data flex_stale_loading: Second = second(count: 7200)
data flex_level_min_samples: Nat = 3
data flex_explore_every: Nat = 5
data flex_switch_premium: NonzeroNatFraction = NonzeroNatFraction { num: 5, denom_predecessor: 3 }

type FlexVramClass
  = FlexVramClass96
  | FlexVramClass48
  | FlexVramClassOther { vram: ByteSize }

fn flex_vram_class(vram: ByteSize) -> FlexVramClass {
  let n = byte_size_count(b: vram)
  let class96 = byte_size_count(b: gibibyte_to_byte_size(g: gibibyte(count: 80)))
  let class48 = byte_size_count(b: gibibyte_to_byte_size(g: gibibyte(count: 40)))
  if n >= class96 {
    FlexVramClass96
  } else {
    if n >= class48 { FlexVramClass48 } else { FlexVramClassOther { vram: vram } }
  }
}

fn flex_vram_class_eq(left: FlexVramClass, right: FlexVramClass) -> Bool {
  match left {
    FlexVramClass96 => match right { FlexVramClass96 => true FlexVramClass48 => false FlexVramClassOther { vram: _ } => false }
    FlexVramClass48 => match right { FlexVramClass96 => false FlexVramClass48 => true FlexVramClassOther { vram: _ } => false }
    FlexVramClassOther { vram: a } => match right {
      FlexVramClass96 => false
      FlexVramClass48 => false
      FlexVramClassOther { vram: b } => byte_size_count(b: a) == byte_size_count(b: b)
    }
  }
}

type FlexOwnerLabel = NonEmptyStr where brand("FlexOwnerLabel")

// Policy data, not an account nickname: ctrl reserves ctrl-bidder and ctrl-pool on the
// same Vast account (ctrl PR 2342). There is no separate Vast account, so this label is
// the only isolation between the two bidders. Exact match only for cap, reconcile,
// cleanup and release.
data flex_owner_label_gunbc_flex: FlexOwnerLabel = "gunbc-flex"

type FlexWireOwner
  = FlexWireOwnerPresent { label: FlexOwnerLabel }
  | FlexWireOwnerAbsent

type FlexOwnership
  = FlexOurs { owner: FlexOwnerLabel }
  | FlexForeign { label: FlexOwnerLabel }
  | FlexUnlabelled

fn flex_ownership(wire: FlexWireOwner, ours: FlexOwnerLabel) -> FlexOwnership {
  match wire {
    FlexWireOwnerAbsent => FlexUnlabelled
    FlexWireOwnerPresent { label: l } =>
      if (l == ours) { FlexOurs { owner: l } } else { FlexForeign { label: l } }
  }
}

fn flex_ours_only(owner: FlexOwnership) -> Bool {
  match owner {
    FlexOurs { owner: _ } => true
    FlexForeign { label: _ } => false
    FlexUnlabelled => false
  }
}

type FlexOwnedCard {
  owner: FlexOwnerLabel
  id: NonEmptyStr
  vram: ByteSize
  rate: MoneyPerHour
  held: Bool
  running: Bool
  loading: Bool
  outbid: Bool
  loading_age: Second
}

type FlexMarketQuote
  = FlexMarketQuoted { median: MoneyPerHour, level: FlexBidLevel }
  | FlexMarketUnobserved

type FlexQuotedBid
  = FlexBidPriced { rate: MoneyPerHour }
  | FlexBidMarketUnobserved
  | FlexBidQuoteCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }

type FlexMedianScan {
  index: Nat
  picked: MoneyPerHour?
}

type FlexMarketMedian
  = FlexMedianFound { rate: MoneyPerHour }
  | FlexMedianEmpty
  | FlexMedianCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }

fn flex_nat_multiple_of(n: Nat, d: Nat) -> Bool {
  (d != 0) && (((n / d) * d) == n)
}

fn flex_class_market_median(floors: List<MoneyPerHour>) -> FlexMarketMedian {
  let n = floors |> length
  if n == 0 {
    FlexMedianEmpty
  } else {
    let currency_scan: CurrencyCode? = fold(floors, init: none, f: (acc, row) =>
      match acc {
        Absent => Present { value: row.currency }
        Present { value: c } =>
          if (c != row.currency) { acc } else { Present { value: c } }
      })
    match currency_scan {
      Absent => FlexMedianEmpty
      Present { value: c0 } =>
        if any(floors, r => r.currency != c0) {
          match floors.first() {
            Absent => FlexMedianEmpty
            Present { value: first } =>
              fold(
                floors,
                init: FlexMedianFound { rate: first },
                f: (acc, row) =>
                  match acc {
                    FlexMedianCurrencyMismatch { left: l, right: r } =>
                      FlexMedianCurrencyMismatch { left: l, right: r }
                    FlexMedianEmpty => FlexMedianEmpty
                    FlexMedianFound { rate: seen } =>
                      if seen.currency != row.currency {
                        FlexMedianCurrencyMismatch { left: seen.currency, right: row.currency }
                      } else {
                        FlexMedianFound { rate: seen }
                      }
                  },
              )
          }
        } else {
          let sorted = floors |> sort_by(f => money_per_hour_micros(q: f))
          let target = n / 2
          let scan = fold(
            sorted,
            init: FlexMedianScan { index: 0, picked: none },
            f: (acc, d) =>
              if (acc.index == target) {
                FlexMedianScan { index: acc.index + 1, picked: Present { value: d } }
              } else {
                FlexMedianScan { index: acc.index + 1, picked: acc.picked }
              },
          )
          match scan.picked {
            Absent => FlexMedianEmpty
            Present { value: m } => FlexMedianFound { rate: m }
          }
        }
    }
  }
}

fn flex_max_rate(a: MoneyPerHour, b: MoneyPerHour) -> FlexQuotedBid {
  if a.currency != b.currency {
    FlexBidQuoteCurrencyMismatch { left: a.currency, right: b.currency }
  } else {
    FlexBidPriced {
      rate: if measure_le(a: a.amount, b: b.amount) { b } else { a },
    }
  }
}

fn flex_quoted_bid(quote: FlexMarketQuote, floor: MoneyPerHour) -> FlexQuotedBid {
  match quote {
    FlexMarketUnobserved => FlexBidMarketUnobserved
    FlexMarketQuoted { median: median, level: level } =>
      if median.currency != floor.currency {
        FlexBidQuoteCurrencyMismatch { left: median.currency, right: floor.currency }
      } else {
        let frac = nonzero_nat_fraction_field(r: flex_bid_level_fraction(level: level))
        let scaled = MoneyPerHour {
          amount: measure_scale_fraction_ceil(m: median.amount, num: frac.num, den: frac.denom),
          currency: median.currency,
        }
        flex_max_rate(a: floor, b: scaled)
      }
  }
}

type FlexRentalSample {
  class: FlexVramClass
  level: FlexBidLevel
  bid: MoneyPerHour
  serving: Second
  ended: Bool
}

type FlexLevelTally {
  level: FlexBidLevel
  samples: Nat
  cost: MoneyAmountMicro
  productive: Second
}

fn flex_productive_serving(serving: Second) -> Second {
  match measure_sub(a: serving, b: flex_reconstruction) {
    MeasureSubtrahendExceedsMinuend => second(count: 0)
    MeasureDifference { value: v } => v
  }
}

fn flex_rental_cost(bid: MoneyPerHour, serving: Second) -> MoneyAmountMicro {
  measure_scale_fraction_ceil(
    m: bid.amount,
    num: second_count(s: serving),
    den: seconds_per_hour(),
  )
}

fn flex_empty_tally(level: FlexBidLevel) -> FlexLevelTally {
  FlexLevelTally {
    level: level,
    samples: 0,
    cost: money_amount_micro(count: 0),
    productive: second(count: 0),
  }
}

fn flex_add_sample(tally: FlexLevelTally, row: FlexRentalSample) -> FlexLevelTally {
  if (!row.ended) {
    tally
  } else {
    FlexLevelTally {
      level: tally.level,
      samples: tally.samples + 1,
      cost: measure_add(a: tally.cost, b: flex_rental_cost(bid: row.bid, serving: row.serving)),
      productive: second(count: second_count(s: tally.productive) + second_count(s: flex_productive_serving(serving: row.serving))),
    }
  }
}

fn flex_tally_level(rows: List<FlexRentalSample>, class: FlexVramClass, level: FlexBidLevel) -> FlexLevelTally {
  fold(
    rows,
    init: flex_empty_tally(level: level),
    f: (acc, row) =>
      if flex_vram_class_eq(left: row.class, right: class) && flex_bid_level_eq(left: row.level, right: level) {
        flex_add_sample(tally: acc, row: row)
      } else {
        acc
      },
  )
}

type FlexLevelChoice
  = FlexLevelChosen { level: FlexBidLevel, samples: Nat }
  | FlexLevelExplore { level: FlexBidLevel, best: FlexBidLevel }
  | FlexLevelNeedsEvidence
  | FlexLevelSelectionRefused

fn flex_young_levels(tallies: List<FlexLevelTally>) -> List<FlexBidLevel> {
  map(
    filter(tallies, t => t.samples < flex_level_min_samples),
    t => t.level,
  )
}

fn flex_scored_levels(tallies: List<FlexLevelTally>) -> List<FlexLevelTally> {
  filter(tallies, t => t.samples >= flex_level_min_samples && second_count(s: t.productive) > 0)
}

data flex_level_id_three_fifths: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_level_id_three_fifths")
data flex_level_id_four_fifths: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_level_id_four_fifths")
data flex_level_id_market: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_level_id_market")
data flex_level_field: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_level_field")
data flex_level_constraints: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_level_constraints")
data flex_level_evidence: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_level_evidence")
data flex_card_field: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_card_field")
data flex_market_subject: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_market_subject")
data flex_market_var: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_market_var")
data flex_market_param: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_market_param")
data flex_market_constraint: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_market_constraint")
