data flex_market_domain: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_market_domain")
data flex_market_coupling: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_market_coupling")
data flex_rank_subject: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_subject")
data flex_rank_objective: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_objective")
data flex_rank_var: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_var")
data flex_rank_param: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_param")
data flex_rank_constraint: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_constraint")
data flex_rank_region: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_region")
data flex_rank_domain: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_domain")
data flex_rank_coupling: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_coupling")
data flex_rank_evidence: DeclarationRef = decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_rank_evidence")

data flex_policy_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: File
    locator: "dag/gunbc/design_ruling.dag#flex_market_policy_is_operator_decided"
  }
}

data flex_policy_standing: CitedFigureStanding = CitedToAuthority { authority: flex_policy_authority }

data flex_term_vram_hour: ObjectiveTerm = ObjectiveTerm {
  identity: decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_term_vram_hour"),
  ground: flex_policy_standing,
}

fn flex_level_identity(level: FlexBidLevel) -> DeclarationRef {
  match level {
    FlexBidLevelThreeFifths => flex_level_id_three_fifths
    FlexBidLevelFourFifths => flex_level_id_four_fifths
    FlexBidLevelMarket => flex_level_id_market
  }
}

fn flex_level_from_identity(id: DeclarationRef) -> FlexBidLevel? {
  if declaration_ref_eq(a: id, b: flex_level_id_three_fifths) {
    Present { value: FlexBidLevelThreeFifths }
  } else {
    if declaration_ref_eq(a: id, b: flex_level_id_four_fifths) {
      Present { value: FlexBidLevelFourFifths }
    } else {
      if declaration_ref_eq(a: id, b: flex_level_id_market) {
        Present { value: FlexBidLevelMarket }
      } else {
        none
      }
    }
  }
}

fn flex_fewer_samples(acc: FlexLevelTally?, t: FlexLevelTally) -> FlexLevelTally? {
  match acc {
    Absent => Present { value: t }
    Present { value: cur } =>
      if (t.samples < cur.samples) { Present { value: t } } else { Present { value: cur } }
  }
}

fn flex_least_sampled_other(tallies: List<FlexLevelTally>, best: FlexBidLevel) -> FlexBidLevel? {
  let other: FlexLevelTally? = fold(
    filter(tallies, t => !flex_bid_level_eq(left: t.level, right: best)),
    init: none,
    f: (acc, t) => flex_fewer_samples(acc: acc, t: t),
  )
  match other {
    Absent => none
    Present { value: t } => Present { value: t.level }
  }
}

data flex_level_coupling_bet: CitedFigureStanding = TranscribedUncited { read_obligation: "interruptible bid-level term-variable coupling is an empirical bet (sample count makes a productive-hour reading reliable); Vast search-offers documents the offer wire, not this monotone" as NonEmptyStr }

fn flex_policy_terms() -> List<ObjectiveTerm> {
  map(fabric_demand_objective_terms(), t => ObjectiveTerm { identity: t.identity, ground: flex_policy_standing })
}

fn flex_market_assessment(coupling: CitedFigureStanding) -> DecisionAssessment {
  let term_ids = fabric_demand_required_term_ids()
  DecisionAssessment {
    subject: DecisionSubject {
      identity: flex_market_subject,
      question: "which interruptible bid level realizes cost per productive serving second" as NonEmptyStr,
      parameters: [ContextParameter { identity: flex_market_param }],
      constraints: [DecisionConstraint { identity: flex_market_constraint }],
      objective: ObjectiveMeasure {
        identity: debt_payoff_objective.profile,
        goal: LowerIsBetter,
        terms: flex_policy_terms(),
      },
      choice_domain: ChoiceDomain {
        identity: flex_market_domain,
        variables: [DecisionVariable { identity: flex_market_var }],
      },
    },
    sensitivities: map(term_ids, id =>
      VariesAlong {
        term: id,
        variable: flex_market_var,
        region: DecisionRegion { identity: flex_market_region },
        relation: MonotoneDecreasing,
        coupling: coupling,
      }
    ),
    constraints: [
      ConstraintSatisfied { constraint: flex_market_constraint, evidence: "flex market hard constraints are empty" as NonEmptyStr },
    ],
    parameters: [
      ParameterBound { parameter: flex_market_param, evidence: "flex interruptible market" as NonEmptyStr },
    ],
    selected_candidate: Absent,
    term_drops: [],
    physical_model: PhysicalModelEstablished { terms: term_ids },
    causal_model: CausalModelEstablished {
      couplings: map(term_ids, id =>
        FleetObservedCoupling {
          receipt: flex_market_coupling,
          term: id,
          variable: flex_market_var,
          subject: flex_market_subject,
        }
      ),
    },
  }
}

fn flex_select_scored_level(tallies: List<FlexLevelTally>, currency: CurrencyCode, coupling: CitedFigureStanding) -> RealizationSelectionResult<ParetoEntry> {
  select_realization(
    assessment: flex_market_assessment(coupling: coupling),
    candidate_field_identity: flex_level_field,
    field: map(flex_scored_levels(tallies: tallies), t =>
      flex_level_entry(id: flex_level_identity(level: t.level), label: "bid-level" as NonEmptyStr, tally: t)
    ),
    axes: flex_level_axes(),
    constraints: [],
    constraint_authority: flex_level_constraints,
    policy: flex_level_valued_policy(currency: currency),
    evidence_snapshot: flex_level_evidence,
  )
}

fn flex_rank_assessment() -> DecisionAssessment {
  let term_ids = [flex_term_vram_hour.identity]
  DecisionAssessment {
    subject: DecisionSubject {
      identity: flex_rank_subject,
      question: "which owned interruptible card has the lowest money per VRAM-GiB-hour" as NonEmptyStr,
      parameters: [ContextParameter { identity: flex_rank_param }],
      constraints: [DecisionConstraint { identity: flex_rank_constraint }],
      objective: ObjectiveMeasure {
        identity: flex_rank_objective,
        goal: LowerIsBetter,
        terms: [flex_term_vram_hour],
      },
      choice_domain: ChoiceDomain {
        identity: flex_rank_domain,
        variables: [DecisionVariable { identity: flex_rank_var }],
      },
    },
    sensitivities: [
      VariesAlong {
        term: flex_term_vram_hour.identity,
        variable: flex_rank_var,
        region: DecisionRegion { identity: flex_rank_region },
        relation: MonotoneDecreasing,
        coupling: flex_policy_standing,
      }
    ],
    constraints: [
      ConstraintSatisfied { constraint: flex_rank_constraint, evidence: "flex card rank hard constraints are empty" as NonEmptyStr },
    ],
    parameters: [
      ParameterBound { parameter: flex_rank_param, evidence: "flex interruptible card rank" as NonEmptyStr },
    ],
    selected_candidate: Absent,
    term_drops: [],
    physical_model: PhysicalModelEstablished { terms: term_ids },
    causal_model: CausalModelEstablished {
      couplings: [
        FleetObservedCoupling {
          receipt: flex_rank_coupling,
          term: flex_term_vram_hour.identity,
          variable: flex_rank_var,
          subject: flex_rank_subject,
        }
      ],
    },
  }
}

fn flex_select_owned_cards(entries: List<ParetoEntry>, currency: CurrencyCode) -> RealizationSelectionResult<ParetoEntry> {
  select_realization(
    assessment: flex_rank_assessment(),
    candidate_field_identity: flex_card_field,
    field: entries,
    axes: flex_rank_axes(),
    constraints: [],
    constraint_authority: flex_rank_constraint,
    policy: flex_rank_policy(currency: currency),
    evidence_snapshot: flex_rank_evidence,
  )
}

fn flex_choose_bid_level(
  rows: List<FlexRentalSample>,
  class: FlexVramClass,
  rentals_so_far: Nat,
  quote_currency: CurrencyCode,
) -> FlexLevelChoice {
  flex_choose_bid_level_under(rows: rows, class: class, rentals_so_far: rentals_so_far, quote_currency: quote_currency, coupling: flex_level_coupling_bet)
}

fn flex_choose_bid_level_under(
  rows: List<FlexRentalSample>,
  class: FlexVramClass,
  rentals_so_far: Nat,
  quote_currency: CurrencyCode,
  coupling: CitedFigureStanding,
) -> FlexLevelChoice {
  let tallies = map(flex_bid_levels(), l => flex_tally_level(rows: rows, class: class, level: l))
  match flex_young_levels(tallies: tallies).first() {
    Present { value: young } =>
      FlexLevelChosen {
        level: young,
        samples: fold(tallies, init: Zero, f: (n, t) =>
          if flex_bid_level_eq(left: t.level, right: young) { t.samples } else { n }),
      }
    Absent =>
      match flex_select_scored_level(tallies: tallies, currency: quote_currency, coupling: coupling) {
        SelectionNeedsEvidence { needs: _ } => FlexLevelNeedsEvidence
        SelectionNeedsPolicy { survivors: _ } => FlexLevelNeedsEvidence
        CandidateFieldUnestablished { causes: _ } => FlexLevelNeedsEvidence
        NoFeasibleRealization { causes: _, scope: _ } => FlexLevelNeedsEvidence
        RealizationSelectionRefused { defects: _ } => FlexLevelSelectionRefused
        SelectedWithin { candidate: c, receipt: _ } =>
          match flex_level_from_identity(id: c.identity) {
            Absent => FlexLevelSelectionRefused
            Present { value: best } =>
              if (rentals_so_far > 0) && flex_nat_multiple_of(n: rentals_so_far, d: flex_explore_every) {
                match flex_least_sampled_other(tallies: tallies, best: best) {
                  Absent => FlexLevelNeedsEvidence
                  Present { value: other } => FlexLevelExplore { level: other, best: best }
                }
              } else {
                FlexLevelChosen {
                  level: best,
                  samples: fold(tallies, init: Zero, f: (n, t) =>
                    if flex_bid_level_eq(left: t.level, right: best) { t.samples } else { n }),
                }
              }
          }
      }
  }
}

fn flex_level_valued_policy(currency: CurrencyCode) -> SelectionPolicy {
  ValuedObjective {
    identity: debt_payoff_objective.profile,
    valuations: [
      TermValuation { term: term_money.identity, scale_micro: money_amount_micro(count: 1), goal: LowerIsBetter },
      TermValuation { term: term_delay.identity, scale_micro: money_amount_micro(count: 0), goal: LowerIsBetter },
      TermValuation { term: term_interruption.identity, scale_micro: money_amount_micro(count: 0), goal: LowerIsBetter },
      TermValuation { term: term_accepted_work.identity, scale_micro: money_amount_micro(count: 1), goal: HigherIsBetter },
    ],
    measure: CostPerAcceptedUnit { unit: term_accepted_work.identity },
    currency: currency,
  }
}

fn flex_level_entry(id: DeclarationRef, label: NonEmptyStr, tally: FlexLevelTally) -> ParetoEntry {
  ParetoEntry {
    identity: id,
    display_label: label,
    readings: [
      AxisReading { axis: term_money.identity, interval_micro: degenerate_interval(point: money_amount_micro_count(m: tally.cost) as Int) },
      AxisReading { axis: term_delay.identity, interval_micro: degenerate_interval(point: 0) },
      AxisReading { axis: term_interruption.identity, interval_micro: degenerate_interval(point: 0) },
      AxisReading { axis: term_accepted_work.identity, interval_micro: degenerate_interval(point: second_count(s: tally.productive) as Int) },
    ],
    missing_inputs: [],
  }
}

fn flex_held_effective_rate(rate: MoneyPerHour, held: Bool) -> MoneyPerHour {
  if (!held) {
    rate
  } else {
    let frac = nonzero_nat_fraction_field(r: flex_switch_premium)
    MoneyPerHour {
      amount: measure_scale_fraction_ceil(m: rate.amount, num: frac.denom, den: frac.num),
      currency: rate.currency,
    }
  }
}

type FlexVramHourly
  = FlexVramHourlyQuoted { rate: MoneyPerGibibyteHour }
  | FlexVramHourlyZeroCapacity

fn flex_dollars_per_vram(rate: MoneyPerHour, vram: ByteSize) -> FlexVramHourly {
  let n = gibibyte_count(g: gibibyte_ceiling(b: vram))
  if n == 0 {
    FlexVramHourlyZeroCapacity
  } else {
    FlexVramHourlyQuoted {
      rate: MoneyRate {
        amount: money_amount_micro(count: money_per_hour_micros(q: rate) / n),
        currency: rate.currency,
      },
    }
  }
}

fn flex_rank_entry(id: DeclarationRef, label: NonEmptyStr, card: FlexOwnedCard) -> ParetoEntry {
  let effective = flex_held_effective_rate(rate: card.rate, held: card.held && (card.running || card.loading))
  match flex_dollars_per_vram(rate: effective, vram: card.vram) {
    FlexVramHourlyZeroCapacity =>
      ParetoEntry {
        identity: id,
        display_label: label,
        readings: [],
        missing_inputs: [
          AxisGap { axis: flex_term_vram_hour.identity, cause: "VRAM capacity is zero so money per GiB-hour is unwritable" as NonEmptyStr },
        ],
      }
    FlexVramHourlyQuoted { rate: ev } =>
      ParetoEntry {
        identity: id,
        display_label: label,
        readings: [
          AxisReading { axis: flex_term_vram_hour.identity, interval_micro: degenerate_interval(point: money_amount_micro_count(m: ev.amount) as Int) },
        ],
        missing_inputs: [],
      }
  }
}

fn flex_level_axes() -> List<SelectionAxis> {
  [
    SelectionAxis { identity: term_money.identity, goal: LowerIsBetter },
    SelectionAxis { identity: term_delay.identity, goal: LowerIsBetter },
    SelectionAxis { identity: term_interruption.identity, goal: LowerIsBetter },
    SelectionAxis { identity: term_accepted_work.identity, goal: HigherIsBetter },
  ]
}

fn flex_rank_axes() -> List<SelectionAxis> {
  [SelectionAxis { identity: flex_term_vram_hour.identity, goal: LowerIsBetter }]
}

fn flex_rank_policy(currency: CurrencyCode) -> SelectionPolicy {
  ValuedObjective {
    identity: flex_rank_objective,
    valuations: [
      TermValuation { term: flex_term_vram_hour.identity, scale_micro: money_amount_micro(count: 1), goal: LowerIsBetter },
    ],
    measure: NetValue,
    currency: currency,
  }
}

fn flex_card_dead(card: FlexOwnedCard) -> Bool {
  card.outbid || (card.loading && second_count(s: card.loading_age) >= second_count(s: flex_stale_loading))
}

type FlexCapAssessment
  = FlexCapUnder { occupied: MoneyPerHour, cap: MoneyPerHour }
  | FlexCapAtLimit { occupied: MoneyPerHour, cap: MoneyPerHour }
  | FlexCapOver { occupied: MoneyPerHour, cap: MoneyPerHour }
  | FlexCapNeedsExhaustedRoster
  | FlexCapUnreadable
  | FlexCapUnobserved
  | FlexCapRateUnconverted
  | FlexCapCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }

type FlexCleanupWhy
  = FlexCleanupOutbid
  | FlexCleanupStaleLoading
  | FlexCleanupNotRunningDropped
  | FlexCleanupReleasedForValue

type FlexCleanupAction
  = FlexDestroy { id: NonEmptyStr, why: FlexCleanupWhy }
  | FlexKeep { id: NonEmptyStr }

type FlexReleaseAdmit
  = FlexReleaseNow { because_over_cap: Bool, because_no_room: Bool, replacement_serving: Bool }
  | FlexReleaseHoldLast
  | FlexReleaseHoldUntilReplacement
  | FlexReleaseHoldCapUnreadable
  | FlexReleaseHoldCapUnobserved
  | FlexReleaseHoldCapPartial
  | FlexReleaseHoldRateUnconverted
  | FlexReleaseHoldCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }

type FlexReleaseWindow {
  running_count: Nat
  remaining: Nat
}

fn flex_release_window_start(running_count: Nat) -> FlexReleaseWindow
  admit_callers: [decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_release_pass")]
{
  FlexReleaseWindow { running_count: running_count, remaining: Succ { prev: Zero } }
}

fn flex_release_admit(
  running_count: Nat,
  cap: FlexCapAssessment,
  no_room: Bool,
  replacement_serving: Bool,
) -> FlexReleaseAdmit
  admit_callers: [decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_release_consider")]
{
  match cap {
    FlexCapUnreadable => FlexReleaseHoldCapUnreadable
    FlexCapUnobserved => FlexReleaseHoldCapUnobserved
    FlexCapNeedsExhaustedRoster => FlexReleaseHoldCapPartial
    FlexCapRateUnconverted => FlexReleaseHoldRateUnconverted
    FlexCapCurrencyMismatch { left: l, right: r } => FlexReleaseHoldCurrencyMismatch { left: l, right: r }
    FlexCapOver { occupied: _, cap: _ } =>
      if running_count <= 1 {
        FlexReleaseHoldLast
      } else {
        FlexReleaseNow { because_over_cap: true, because_no_room: no_room, replacement_serving: replacement_serving }
      }
    FlexCapAtLimit { occupied: _, cap: _ } =>
      if running_count <= 1 {
        FlexReleaseHoldLast
      } else {
        if no_room || replacement_serving {
          FlexReleaseNow { because_over_cap: false, because_no_room: no_room, replacement_serving: replacement_serving }
        } else {
          FlexReleaseHoldUntilReplacement
        }
      }
    FlexCapUnder { occupied: _, cap: _ } =>
      if running_count <= 1 {
        FlexReleaseHoldLast
      } else {
        if no_room || replacement_serving {
          FlexReleaseNow { because_over_cap: false, because_no_room: no_room, replacement_serving: replacement_serving }
        } else {
          FlexReleaseHoldUntilReplacement
        }
      }
  }
}

type FlexReleaseStep
  = FlexReleaseAuthorized { admit: FlexReleaseAdmit, next: FlexReleaseWindow }
  | FlexReleaseDenied { admit: FlexReleaseAdmit, window: FlexReleaseWindow }

fn flex_release_consider(
  window: FlexReleaseWindow,
  cap: FlexCapAssessment,
  no_room: Bool,
  replacement_serving: Bool,
) -> FlexReleaseStep
  admit_callers: [decl_ref(module_path: "product.fabric.flex_market", decl_name: "flex_release_pass")]
{
  let admit = flex_release_admit(
    running_count: window.running_count,
    cap: cap,
    no_room: no_room,
    replacement_serving: replacement_serving,
  )
  match admit {
    FlexReleaseNow { because_over_cap: _, because_no_room: _, replacement_serving: _ } =>
      match window.remaining {
        Zero => FlexReleaseDenied { admit: admit, window: window }
        Succ { prev: _ } =>
          FlexReleaseAuthorized {
            admit: admit,
            next: FlexReleaseWindow {
              running_count: match window.running_count {
                Zero => Zero
                Succ { prev: p } => p
              },
              remaining: Zero,
            },
          }
      }
    _ => FlexReleaseDenied { admit: admit, window: window }
  }
}

fn flex_ours_running(cards: List<FlexOwnedCard>, ours: FlexOwnerLabel) -> List<FlexOwnedCard> {
  filter(cards, c => (c.owner == ours) && c.running && !flex_card_dead(card: c))
}

fn flex_running_count(cards: List<FlexOwnedCard>) -> Nat {
  fold(cards, init: Zero, f: (n, _) => Succ { prev: n })
}

fn flex_vram_hour_worse(left: FlexOwnedCard, right: FlexOwnedCard) -> Bool {
  let left_rate = flex_held_effective_rate(rate: left.rate, held: left.held && (left.running || left.loading))
  let right_rate = flex_held_effective_rate(rate: right.rate, held: right.held && (right.running || right.loading))
  match flex_dollars_per_vram(rate: left_rate, vram: left.vram) {
    FlexVramHourlyZeroCapacity =>
      match flex_dollars_per_vram(rate: right_rate, vram: right.vram) {
        FlexVramHourlyZeroCapacity => false
        FlexVramHourlyQuoted { rate: _ } => true
      }
    FlexVramHourlyQuoted { rate: lv } =>
      match flex_dollars_per_vram(rate: right_rate, vram: right.vram) {
        FlexVramHourlyZeroCapacity => false
        FlexVramHourlyQuoted { rate: rv } =>
          money_amount_micro_count(m: lv.amount) > money_amount_micro_count(m: rv.amount)
      }
  }
}

fn flex_pick_release_card(cards: List<FlexOwnedCard>) -> FlexOwnedCard? {
  fold(
    cards,
    init: none,
    f: (acc, card) =>
      match acc {
        Absent => Present { value: card }
        Present { value: best } =>
          if flex_vram_hour_worse(left: card, right: best) {
            Present { value: card }
          } else {
            Present { value: best }
          }
      },
  )
}

type FlexReleasePlan {
  actions: List<FlexCleanupAction>
  admit: FlexReleaseAdmit
}

fn flex_release_pass(
  cards: List<FlexOwnedCard>,
  ours: FlexOwnerLabel,
  cap: FlexCapAssessment,
  no_room: Bool,
  replacement_serving: Bool,
) -> FlexReleasePlan {
  let running = flex_ours_running(cards: cards, ours: ours)
  let step = flex_release_consider(
    window: flex_release_window_start(running_count: flex_running_count(cards: running)),
    cap: cap,
    no_room: no_room,
    replacement_serving: replacement_serving,
  )
  match step {
    FlexReleaseDenied { admit: admit, window: _ } =>
      FlexReleasePlan { actions: [], admit: admit }
    FlexReleaseAuthorized { admit: admit, next: _ } =>
      match flex_pick_release_card(cards: running) {
        Absent => FlexReleasePlan { actions: [], admit: admit }
        Present { value: card } =>
          FlexReleasePlan {
            actions: [FlexDestroy { id: card.id, why: FlexCleanupReleasedForValue }],
            admit: admit,
          }
      }
  }
}

fn flex_cleanup_dead(cards: List<FlexOwnedCard>, ours: FlexOwnerLabel) -> List<FlexCleanupAction> {
  map(
    filter(cards, c => c.owner == ours && flex_card_dead(card: c)),
    c => FlexDestroy {
      id: c.id,
      why: if (c.outbid) { FlexCleanupOutbid } else { FlexCleanupStaleLoading },
    },
  )
}

// Probe result is a catalog unit, not a second spelling of vLLM parser names.
// Those names stay on harness_unit_tool_call_parser for vLLM units. A ninfer
// Qwen3_8_27bOnNinfer card is placeable.
type FlexCardProbe
  = FlexCardUnitEstablished { unit: HarnessServingUnit }
  | FlexCardUnitUnconfirmed

fn flex_catalog_unit_eq(left: HarnessServingUnit, right: HarnessServingUnit) -> Bool {
  match harness_serving_unit_compatibility(required: left, observed: right) {
    HarnessUnitsIdentical => true
    HarnessUnitsCatalogFungible => true
    HarnessUnitsIncompatible { required: _, observed: _ } => false
  }
}

fn flex_rented_card_fungible(required: HarnessServingUnit, observed: FlexCardProbe) -> Bool {
  match observed {
    FlexCardUnitUnconfirmed => false
    FlexCardUnitEstablished { unit: u } =>
      flex_catalog_unit_eq(left: required, right: u)
        && match harness_unit_placement(unit: u) {
          PlacedOnFleetSeat => true
          RunOnOperatorEndpoint => false
          LeasedFromHostedQuota => false
        }
  }
}

fn flex_ninfer_qwen_probe() -> FlexCardProbe {
  FlexCardUnitEstablished { unit: Qwen3_8_27bOnNinfer }
}

// The host driver floor is the RECIPE's fact (product.fabric.serving_recipe ServingDriverFloor), screened by
// product.fabric.flex_vast_shadow flex_offer_screen_by_recipe with its standing; this module reads the offer's
// driver only.
fn flex_offer_driver_major(offer: VastAiOffer) -> Nat? {
  match vast_ai_ingest_search_offer_driver(offer: offer) {
    VastAiDriverVersionUnread => none
    VastAiDriverVersionMalformed { raw: _ } => none
    VastAiDriverVersionRead { version: v } => Present { value: v.major }
  }
}

