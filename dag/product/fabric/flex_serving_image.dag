module product.fabric.flex_serving_image

import std.types { String, NonEmptyStr, Port }
import std.measure { ByteSize, gibibyte, gibibyte_to_byte_size, Mebibyte, mebibyte, mebibyte_count }
import extdeps.external_authority { CitedFigureStanding, TranscribedUncited }

// THE SERVING IMAGE AS ONE SUPPLIER-AGNOSTIC FACT: what a rented card runs, whoever rents it. Each supplier
// realizes it in its own launch shape (Vast: a template, product.fabric.flex_vast_template; EC2: a launch
// template whose user-data starts this image under docker, gunbc.plans.flex_supplier_generalization (deleted 2026-11-08) PR 3),
// and neither restates a field here. One image, one onstart, N realizations.
type FlexServingImage {
  // The OCI repository and the sha256 digest that pins it; the pull reference is
  // flex_serving_image_reference, never a second literal.
  repository: NonEmptyStr
  digest_sha256: NonEmptyStr
  // The port the server listens on inside the container (18000: 8000 is the image's Caddy portal).
  port: Port
  // The container's shared memory.
  shm: ByteSize
  // The serving script, run inside the container. It needs a driver 580+, a /cache with room for the
  // model and the disk KV tier, and env POOL_API_KEY and PORT; it names no supplier.
  onstart: String
}

// THE ONSTART, carried verbatim as the operator supplied it (read live on srv1 from the retired Vast
// template, 2026-10-18, relayed by deep-otter-797). It names POOL_API_KEY only to READ it from the
// container's environment; it carries no credential value. Moved here unchanged from
// product.fabric.flex_vast_template (was flex_vast_onstart), because nothing in it is a Vast fact.
// THE SERVING PROFILE: the lil-serve profile and hardware class this image serves the checkpoint with.
// They select the kernels the server tunes, so they are what a tuning cache is keyed by beside the GPU,
// driver, image and revision (product.fabric.flex_ec2_boot); cache sizes and TLS do not reach the kernels.
data flex_serving_profile: NonEmptyStr = "qwen38-flash-next" as NonEmptyStr
data flex_serving_hardware: NonEmptyStr = "rtx-pro-6000-pcie" as NonEmptyStr

fn flex_serving_profile_flags_text() -> String {
  join(["--profile ", flex_serving_profile as String, " --hardware ", flex_serving_hardware as String], "")
}

// THE MODEL'S RESIDENT HOST MEMORY: the Flash-Next PLE table is read at random per token, so it stays
// resident in host RAM, unswappable, once the model loads (26.8 GiB per the operator, calm-crab-645,
// 2026-10-23). It is a fact of this image and checkpoint, not of a supplier: the AWS screen refuses a host
// below it (product.fabric.flex_aws_row) and the onstart below sizes its RAM cache tier after it.
data flex_serving_host_resident_floor: Mebibyte = mebibyte(count: 27444)
data flex_serving_host_resident_floor_standing: CitedFigureStanding = TranscribedUncited { read_obligation: "read the Flash-Next PLE table size and the serving process's resident overhead from the lil image (lil-serve --print-config or a measured RSS on a served card); the 26.8 GiB is the operator's figure" }

// Headroom left beside the resident tables for the serving process, the kernel and page cache the loader
// streams through. Measured 2026-11-25 on a g7e.2xlarge (62 GiB visible): the OOM-killed engine held about
// 6 GB anonymous memory beside its shared memory, so 8 GiB is the smallest round figure above it.
data flex_serving_host_headroom_gib: Int = 8

fn flex_serving_mib_to_gib_ceil(m: Mebibyte) -> Int { ((mebibyte_count(m) as Int) + 1023) / 1024 }

data flex_serving_onstart: String = join([
  "#!/bin/bash\n# Qwen3.8-Flash-Next on the local-inference-lab vLLM build; the model from Hugging Face.\n# Needs: driver 580+ (CUDA 13.x; tested on 595, 610 and 615), ~400 GB disk, env POOL_API_KEY and PORT.\n# Serves HTTPS with a certificate made on first start; the dashboard pins it on first contact.\n# Logs: /root/serve/events.log (steps) and /root/serve/serve.log (server, including the download)\nD=/root/serve; mkdir -p $D /cache/kv; ev()\{ echo \"$(date -u +%FT%TZ) $*\" >> $D/events.log; }\n# Template env is on PID 1; an on-start shell may not inherit it.\nfor v in POOL_API_KEY PORT CACHE_MODE; do\n  [ -n \"$\{!v}\" ] || export $v=\"$(tr '\\0' '\\n' < /proc/1/environ | sed -n \"s/^$v=//p\")\"\ndone\nfor v in POOL_API_KEY PORT; do [ -n \"$\{!v}\" ] || \{ ev \"REFUSED: $v not set in template env\"; exit 1; }; done\nDRV=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1)\n[ \"$\{DRV%%.*}\" -ge 580 ] || \{ ev \"REFUSED: driver $DRV; this image needs 580+ (CUDA 13.x)\"; exit 1; }\numask 077; printf %s \"$POOL_API_KEY\" > /root/.pool_key\n# TLS: one key per card, kept across restarts so its pin holds. No TLS, no start.\n[ -s $D/tls.key ] && [ -s $D/tls.crt ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \\\n  -days 3650 -subj \"/CN=pool-card\" -keyout $D/tls.key -out $D/tls.crt >> $D/events.log 2>&1\numask 022\n[ -s $D/tls.key ] && [ -s $D/tls.crt ] || \{ ev \"REFUSED: no TLS certificate could be made\"; exit 1; }\nTLS=\"--ssl-keyfile $D/tls.key --ssl-certfile $D/tls.crt\"\n\n# Session caches: ram-disk (default) = LMCache, sessions evicted from the GPU go to RAM, then disk.\n# vram = GPU only; set CACHE_MODE=vram in the template env to use it.\nCACHE_MODE=$\{CACHE_MODE:-ram-disk}\n# RAM tier: half of what this container may use AFTER the model's resident host tables and a headroom,\n# at most 60 GB. MemAvailable is read before the model loads, so it still counts memory the PLE table will\n# take; sizing the tier from it alone OOM-killed the engine on a 64 GiB host (2026-11-25). The container's own limit\n# (cgroup memory.max) can be far below the host's RAM (183 of 251 GB seen 2026-10-16).\nAVAIL=$(awk '/MemAvailable/\{print int($2/1048576)}' /proc/meminfo)\nMAX=$(cat /sys/fs/cgroup/memory.max 2>/dev/null); CUR=$(cat /sys/fs/cgroup/memory.current 2>/dev/null)\n[[ \"$MAX\" =~ ^[0-9]+$ ]] && [[ \"$CUR\" =~ ^[0-9]+$ ]] && \{ C=$(( (MAX - CUR) / 1073741824 )); [ $C -lt $AVAIL ] && AVAIL=$C; }\n",
  "L1=$(( (AVAIL - ", to_string(flex_serving_mib_to_gib_ceil(m: flex_serving_host_resident_floor) + flex_serving_host_headroom_gib), ") / 2 )); [ $L1 -gt 60 ] && L1=60\n",
  "# Disk tier: 80% of the disk left after the model (~110 GB), at most 800 GB.\nL2=$(( ($(df -BG --output=avail /cache | tail -1 | tr -dc 0-9) - 110) * 8 / 10 )); [ $L2 -gt 800 ] && L2=800\nif [ \"$CACHE_MODE\" = ram-disk ] && \{ [ $L1 -lt 8 ] || [ $L2 -lt 20 ]; }; then\n  ev \"too little RAM/disk for ram-disk (L1 $\{L1}G, L2 $\{L2}G); using vram\"; CACHE_MODE=vram\nfi\n\n# The server downloads the pinned model revision from Hugging Face on first start (~103 GB),\n# and tunes its kernels on first start (~9 min); both stay on disk for restarts.\ncat > $D/run.sh <<EOS\n#!/bin/bash\nexport PORT=$PORT\n# Restart on crash; the pool stops routing to it while it is down.\nwhile true; do\n  if [ \"$CACHE_MODE\" = ram-disk ]; then\n    /usr/local/bin/lil-serve ", flex_serving_profile_flags_text(), " \\\\\n      --env LMCACHE_MODE=ram-disk --env LMCACHE_L1_GB=$L1 --env LMCACHE_L2_GB=$L2 --env LMCACHE_L2_ROOT=/cache/kv \\\\\n      -- --port $PORT $TLS --api-key \"\\$(cat /root/.pool_key)\"\n  else\n    /usr/local/bin/lil-serve ", flex_serving_profile_flags_text(), " \\\\\n      -- --cache-mode vram --port $PORT $TLS --api-key \"\\$(cat /root/.pool_key)\"\n  fi\n  echo \"\\$(date -u +%FT%TZ) lil-serve exited \\$?; restarting in 10s\" >> $D/events.log; sleep 10\ndone\nEOS\nchmod +x $D/run.sh\nev \"START (driver $DRV, cache $CACHE_MODE, L1 $\{L1}G, L2 $\{L2}G, TLS)\"\nnohup $D/run.sh >> $D/serve.log 2>&1 &\n",
], "")

data flex_lil_serving_image: FlexServingImage = FlexServingImage {
  repository: "ghcr.io/local-inference-lab/vllm" as NonEmptyStr,
  digest_sha256: "751ee72beb242b163e1124b2e0b825a509e20bacaf1423f467d65f6b8b664bc7" as NonEmptyStr,
  port: 18000,
  shm: gibibyte_to_byte_size(g: gibibyte(count: 80)),
  onstart: flex_serving_onstart,
}

fn flex_serving_image_reference(image: FlexServingImage) -> NonEmptyStr {
  join([image.repository as String, "@sha256:", image.digest_sha256 as String], "") as NonEmptyStr
}
