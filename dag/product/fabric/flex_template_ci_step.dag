module product.fabric.flex_template_ci_step

// THE CI RUN-STEP LEAF OF THE FLEX TEMPLATE DOMAIN: the `gunbc run` target and invoke of the
// flex_template_ensure step, beside the domain whose entry module it invokes
// (product.fabric.flex_vast_template_control). The shared run-step machinery is
// v2.workflow.gunbc_invoke_step_emit, gunbc.ci.ci_layer_roots and
// gunbc.ci.ci_run_step_target; the roster stays in gunbc.ci.ci_spec, which imports the
// target. A step module imports the shared machinery, never ci_spec.

import std.types { String }
import v2.workflow.gunbc_invoke_step_emit {
  gunbc_run_step_script_for_target,
}
import gunbc.ci.ci_run_step_target {
  gunbc_run_step_target,
  GunbcRunStepTarget,
}
import gunbc.ci.ci_layer_roots { witness_layer_roots }

data gunbc_ci_flex_template_ensure_target: GunbcRunStepTarget = gunbc_run_step_target(
  module: "product.fabric.flex_vast_template_control",
  function: "ensure",
)

fn gunbc_ci_flex_template_ensure_invoke() -> String {
  gunbc_run_step_script_for_target(
    source_roots: witness_layer_roots,
    target: gunbc_ci_flex_template_ensure_target,
    claim_run: false,
    receipt_rel: none
  )
}
