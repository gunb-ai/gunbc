module product.fabric.runner_shape_profile

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.measure { ByteSize, byte_size, byte_size_count, gigabyte }
import std.nat { Nat }
import extdeps.ci_runner.types {
  QuotedByteMagnitude, QuotedDecimalGigabytes, QuotedBinaryGibibytes, QuotedWithoutBasis,
  QuotedByteResolution, ResolvedBytes, QuotedBasisUnresolved, quoted_magnitude_bytes,
}
import v2.std.algebra { any }

// A RUNNER SHAPE IS ONE FACT WITH TWO COORDINATES, AND THIS EXISTS BECAUSE THE FLEET STORED IT AS
// TWO. gunbc.runner_slot_allocation declares cores_per_slot = 8 and memory_max = 16 GiB as
// independently editable literals; nothing relates them, so editing either one silently changes the
// shape's CPU:memory ratio and no consumer can tell. That is the second-representation defect DESIGN
// section 2 names -- one concept, two places to change it, no derivation between them.
//
// The replacement is an ANCHOR plus a RATIO. One coordinate is chosen (today: memory, because the
// 16 GiB figure is the one that has been validated in production), the other is derived, and the
// ratio comes from a cited profile rather than a number typed beside the anchor.

// EVIDENCE ARMS ARE ORDERED BY WHAT THEY ACTUALLY ESTABLISH, and the distinction is the point of
// having them. A published provider catalog is a market fact: this vendor sells these shapes. An
// operator adoption is a DECISION to price our own slots the same way -- it inherits none of the
// provider's engineering justification and must not be described as though it did. A normative
// standard is a document that says the ratio SHOULD be this, and no such document is known for
// Arm CI runners, so that arm exists and is deliberately uninhabited rather than being filled with
// the strongest-sounding available claim.
//
// The specific trap this closes: '1 core : 3 GB on Arm' reads like an architectural law and is not
// one. Azure's Ampere Altra families quote about 4 GiB per vCPU general-purpose and about 8 GiB
// memory-optimized. The ratio is a workload-family profile. Recording a market profile as a
// standard would be the rung inflation DESIGN 4b names, applied to a citation.
// AN ADOPTION NAMES THE AXES IT COVERS, so what it does NOT cover is a fact the substrate can read
// rather than prose beside it. The first cut recorded the storage exclusion as a bare String note,
// which DESIGN 4c rules out in as many words -- an ordinary String declaration whose sole purpose
// is commentary is misplaced or dead data, and no Accepted program can read one, so it was
// machine-invisible authority dressed as data (review 54922).
//
// The exclusion this exists for: Ubicloud's cited arm64 rows carry a per-runner disk figure (200 GB
// at 8 vCPU, 300 at 16, 400 at 30) sitting right beside the ratio being adopted. Those rows price
// standalone VMs that own their disks; a gunbc slot shares one host filesystem with every other
// slot, the OS, shared caches and swap. Copying the figure would price ~21 slots at over 4 TB
// against a 457 GB device and refuse the fleet to two slots while appearing faithful to the
// citation. With the axis list, a consumer that wants per-runner storage asks and is told no.
type AdoptedAxis
  = CpuMemoryRatio
  | PerRunnerStorage

fn adoption_covers_axis(evidence: ShapeProfileEvidence, axis: AdoptedAxis) -> Bool {
  match evidence {
    OperatorAdoption { source: _, adopted_on: _, rationale: _, adopted_axes: axes } =>
      any(axes, a => adopted_axis_eq(a: a, b: axis))
    PublishedProviderCatalog { provider: _, catalog_symbol: _ } => false
    NormativeStandard { document: _ } => false
  }
}

fn adopted_axis_eq(a: AdoptedAxis, b: AdoptedAxis) -> Bool {
  match a {
    CpuMemoryRatio => match b { CpuMemoryRatio => true, PerRunnerStorage => false }
    PerRunnerStorage => match b { CpuMemoryRatio => false, PerRunnerStorage => true }
  }
}

type ShapeProfileEvidence
  = PublishedProviderCatalog { provider: NonEmptyStr, catalog_symbol: NonEmptyStr }
  | OperatorAdoption {
      source: NonEmptyStr
      adopted_on: NonEmptyStr
      rationale: NonEmptyStr
      adopted_axes: List<AdoptedAxis>
    }
  | NormativeStandard { document: NonEmptyStr }

// THE RATIO REUSES extdeps.ci_runner.types QuotedByteMagnitude RATHER THAN RESTATING IT, and the
// first cut of this module got that wrong in the exact way its own header criticizes. It carried
// bytes: ByteSize BESIDE quoted_numeral and quoted_unit_label, with nothing deriving either from
// the other, so byte_size(3000000000) and (3, "GB") could silently disagree -- one measured quantity
// with two independent literals, which is a fork and not provenance (review 54922).
//
// The reused carrier is also strictly better than what it replaces: it states the BASIS as a
// constructor (decimal gigabytes vs binary gibibytes vs a vendor figure with no stated basis) and
// its resolution REFUSES on the basis-less arm instead of guessing. That matters here because the
// whole point is that 3 GB is 2.79 GiB -- a 7% difference, a whole slot at fleet scale -- so a
// module that could not tell the two apart would be unable to say what it means.

type RunnerShapeProfile {
  name: NonEmptyStr
  memory_per_core: QuotedByteMagnitude
  evidence: ShapeProfileEvidence
}

// THE ANCHOR IS DECLARED ARBITRARY, IN THE CARRIER, because it is -- and because an arbitrary value
// that does not say so is indistinguishable from a derived one after the author leaves. 16 GiB is
// the figure this fleet has run and validated; it is not derived from anything and is expected to
// move. What must NOT happen when it moves is a second edit to a core count.
type SlotMemoryAnchor {
  bytes: ByteSize
  chosen_because: NonEmptyStr
}

// CORES ARE ROUNDED UP, WHICH IS THE FAIL-CLOSED DIRECTION AND NOT THE OBVIOUS ONE. A 16 GiB slot
// under a 3 GB/core profile wants 5.73 cores. Rounding DOWN to 5 packs more slots onto a host and
// gives each one less CPU than the profile says its memory deserves -- the host admits more work
// than the shape justifies. Rounding UP to 6 gives each slot slightly more CPU than the profile
// implies and admits fewer slots. Since the count derived from this shape is a capacity ADMISSION,
// the error that over-admits is the one that hurts, so the rounding goes the other way.
fn cores_for_anchor(anchor: SlotMemoryAnchor, profile: RunnerShapeProfile) -> CoreCountResolution {
  match quoted_magnitude_bytes(quoted: profile.memory_per_core) {
    QuotedBasisUnresolved { numeral: n, unit_label: u } =>
      CoreCountRefused {
        reason: "runner shape profile quotes memory-per-core with no stated basis; refusing to derive a core count, because reading the same numeral as decimal GB or binary GiB differs by about 7% and changes the fleet-wide slot count",
      }
    ResolvedBytes { bytes: per_bytes } => {
      let want = byte_size_count(b: anchor.bytes)
      let per = byte_size_count(b: per_bytes)
      if per == 0 {
        CoreCountRefused {
          reason: "runner shape profile carries a zero memory-per-core figure; refusing to derive a slot shape with no CPU entitlement",
        }
      } else {
        CoreCountDerived { cores: (want + per - 1) / per }
      }
    }
  }
}

type CoreCountResolution
  = CoreCountDerived { cores: Nat }
  | CoreCountRefused { reason: NonEmptyStr }

type SlotShape {
  memory: ByteSize
  cores: Nat
  profile_name: NonEmptyStr
}

// A ZERO-OR-NEGATIVE PER-CORE FIGURE REFUSES RATHER THAN PRODUCING A SHAPE WITH NO CPU. It cannot
// arise from the cited rows today; it is refused anyway because the alternative is a slot shape of
// zero cores that every downstream count would happily divide by.
type SlotShapeResolution
  = SlotShapeDerived { shape: SlotShape }
  | SlotShapeRefused { reason: NonEmptyStr }

fn resolve_slot_shape(anchor: SlotMemoryAnchor, profile: RunnerShapeProfile) -> SlotShapeResolution {
  match cores_for_anchor(anchor: anchor, profile: profile) {
    CoreCountRefused { reason: r } => SlotShapeRefused { reason: r }
    CoreCountDerived { cores: c } =>
      SlotShapeDerived {
        shape: SlotShape { memory: anchor.bytes, cores: c, profile_name: profile.name },
      }
  }
}

// THE CITED PROFILE. extdeps.cloud.ubicloud carries five arm64 rows -- 2/6, 4/12, 8/24, 16/48 and
// 30/90 -- every one of them exactly 3 decimal GB per vCPU, and the vendor states each arm64 vCPU is
// backed by a DEDICATED physical core, so vCPU and core are the same unit here and the ratio
// transfers without a threading adjustment.
data ubicloud_standard_arm_profile: RunnerShapeProfile = RunnerShapeProfile {
  name: "ubicloud-standard-arm",
  memory_per_core: QuotedDecimalGigabytes { value: gigabyte(3) },
  evidence: PublishedProviderCatalog {
    provider: "Ubicloud",
    catalog_symbol: "extdeps.cloud.ubicloud ubicloud_runner_catalog",
  },
}

// OUR ADOPTION IS A SEPARATE ROW FROM THE PROFILE WE ADOPTED, so the reason our slots have their
// shape stays traceable to a decision rather than reading as a property of Arm. It also records the
// hardware difference honestly: Ubicloud's arm64 runners are Ampere Altra Q80-30 and this fleet is
// Altra Max M128-30, so the ratio is being carried across a hardware boundary by choice.
data gunbc_internal_arm_ci_profile: RunnerShapeProfile = RunnerShapeProfile {
  name: "gunbc-internal-arm-ci",
  memory_per_core: QuotedDecimalGigabytes { value: gigabyte(3) },
  evidence: OperatorAdoption {
    source: "product.fabric.runner_shape_profile ubicloud_standard_arm_profile",
    adopted_on: "2026-08-23",
    rationale: "operator ruling: price internal CI slots on the Ubicloud standard arm ratio. Adopted across a hardware boundary -- the cited rows are Altra Q80-30 and this fleet is Altra Max M128-30.",
    adopted_axes: [CpuMemoryRatio],
  },
}

// WHAT THE ADOPTION DELIBERATELY DOES NOT TAKE, stated here because the number is sitting in the
// same cited rows and looks like part of the same profile. Ubicloud's arm64 rows carry disk_bytes:
// 200 GB on the 8-core, 300 GB on the 16-core. Applied at this fleet's slot counts that is several
// terabytes against hosts with well under one, so a later author 'completing' the adoption would
// cap the fleet at two slots and believe they were being faithful to the citation. The rows price
// whole VMs that own their disks; these slots share a host filesystem. The storage axis is a
// separate question with separate evidence and does not come along with the ratio.
data gunbc_slot_memory_anchor: SlotMemoryAnchor = SlotMemoryAnchor {
  bytes: byte_size(17179869184),
  chosen_because: "operator ruling 2026-08-23: 16 GiB is the anchor FOR NOW and is explicitly arbitrary -- it is the per-slot figure this fleet has run and validated, not a derived quantity, and it is expected to change as the compute fabric prices slots properly. It is recorded as an anchor rather than as a slot field so that changing it moves the core count with it instead of requiring a second edit that can silently disagree.",
}

fn gunbc_slot_shape() -> SlotShapeResolution {
  resolve_slot_shape(anchor: gunbc_slot_memory_anchor, profile: gunbc_internal_arm_ci_profile)
}
