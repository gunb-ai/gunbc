module product.fabric.flex_vast_template

import std.types { String, NonEmptyStr, Bool, Int, List, Port, list_length }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.list { first_where }
import std.measure { ByteSize, Bandwidth, gibibyte, gibibyte_count, gibibyte_ceiling, gibibyte_to_byte_size }
import extdeps.cloud.vast_ai { VastAiTemplateRow }
import product.fabric.flex_vast_shadow { flex_serving_recipe, flex_flash_next_vast_filters }

// THE FLEX VAST TEMPLATE AS A DECLARED FACT, secret-free by construction. A template is the host's
// image, disk, runtype and the PORT its server listens on; the spec has no field that can hold any other
// env, so a credential env is unwritable here. The per-rental server password is not a template fact: it
// is drawn per create (product.fabric.flex_vast_loop mint_flex_pool_password) and sent in the create
// request's env, which Vast merges over the template's by key (docs.vast.ai create-instance).
type FlexTemplateSpec {
  name: NonEmptyStr
  image: NonEmptyStr
  tag: NonEmptyStr
  runtype: NonEmptyStr
  disk: ByteSize
  port: Port
  shm: ByteSize
  onstart: String
  ssh_direct: Bool
  jup_direct: Bool
  use_jupyter_lab: Bool
  min_cuda_max_good: Nat
  min_cpu_ram: ByteSize
  min_gpu_ram: ByteSize
  min_inet_down: Bandwidth
  verified_only: Bool
}

// The env string Vast stores, in its Docker-flag format: the published port, the container's shared
// memory and IPC, and PORT. Nothing else.
fn flex_template_env(spec: FlexTemplateSpec) -> String {
  join(["-p ", to_string(spec.port as Int), ":", to_string(spec.port as Int), " --shm-size ", to_string(gibibyte_count(g: gibibyte_ceiling(b: spec.shm)) as Int), "g --ipc host -e PORT=", to_string(spec.port as Int)], "")
}

// The env NAMES a flex template must never carry: the four credential names of the retired template. Names only; the
// values never enter this repository. R2 is dropped entirely (no replacement); POOL_API_KEY is
// per-rental. Used on a READBACK, so a template that carries one is refused whoever created it.
data flex_template_forbidden_env_names: List<String> = [
  "R2_ENDPOINT",
  "R2_ACCESS_KEY_ID",
  "R2_SECRET_ACCESS_KEY",
  "POOL_API_KEY",
]

fn flex_template_env_forbidden_name(env: String) -> String? {
  first_where(flex_template_forbidden_env_names, name => env.contains(name))
}

// The retired template. It is never edited, deleted or adopted by the ensure: a row with this hash is
// refused as the target even when its name matches, and its hash must still read back after a run.
data flex_template_retired_hash: NonEmptyStr = "c6793d31e3204da102145c4c331e42ae" as NonEmptyStr

type FlexTemplateDecision
  = FlexTemplateNoop { hash: String }
  | FlexTemplateApply
  | FlexTemplateRefuse { cause: String }

// Noop/Apply/Refuse over the observed rows (all named by `name`), caller-supplied; this fold neither
// lists nor creates. A matching row is Noop only if its image and env equal the spec's; a name match
// that differs is Refuse, never an in-place edit, because a template's hash changes with its content
// and others depend on hashes.
fn flex_template_decide(spec: FlexTemplateSpec, named: List<VastAiTemplateRow>) -> FlexTemplateDecision {
  if list_length(named) > 1 {
    FlexTemplateRefuse { cause: "more than one template carries the declared name" }
  } else {
    match first_where(named, r => true) {
      Absent => FlexTemplateApply
      Present { value: row } => flex_template_judge_row(spec: spec, row: row)
    }
  }
}

fn flex_template_judge_row(spec: FlexTemplateSpec, row: VastAiTemplateRow) -> FlexTemplateDecision {
  match row.hash_id {
    Absent => FlexTemplateRefuse { cause: "the template row has no hash_id" }
    Present { value: h } =>
      if h == (flex_template_retired_hash as String) {
        FlexTemplateRefuse { cause: "the declared name resolves to the retired template, which is never adopted" }
      } else {
        match row.env {
          Absent => FlexTemplateRefuse { cause: "the template row's env was not read" }
          Present { value: env } =>
            match flex_template_env_forbidden_name(env: env) {
              Present { value: n } => FlexTemplateRefuse { cause: concat("the template carries a forbidden env name ", n) }
              Absent =>
                if (row.image == (spec.image as String)) && (env == flex_template_env(spec: spec)) {
                  FlexTemplateNoop { hash: h }
                } else {
                  FlexTemplateRefuse { cause: "a template of the declared name exists with different content" }
                }
            }
        }
      }
  }
}

// THE ONSTART IS THE TEMPLATE'S REALIZATION, carried verbatim as the operator supplied it (read live on
// srv1 from the retired template, 2026-10-18, relayed by deep-otter-797). It names POOL_API_KEY only to
// READ it from the container's environment; it carries no credential value.
data flex_vast_onstart: String = "#!/bin/bash\n# Qwen3.8-Flash-Next on the local-inference-lab vLLM build; the model from Hugging Face.\n# Needs: driver 580+ (CUDA 13.x; tested on 595, 610 and 615), ~400 GB disk, env POOL_API_KEY and PORT.\n# Serves HTTPS with a certificate made on first start; the dashboard pins it on first contact.\n# Logs: /root/serve/events.log (steps) and /root/serve/serve.log (server, including the download)\nD=/root/serve; mkdir -p $D /cache/kv; ev()\{ echo \"$(date -u +%FT%TZ) $*\" >> $D/events.log; }\n# Template env is on PID 1; an on-start shell may not inherit it.\nfor v in POOL_API_KEY PORT CACHE_MODE; do\n  [ -n \"$\{!v}\" ] || export $v=\"$(tr '\\0' '\\n' < /proc/1/environ | sed -n \"s/^$v=//p\")\"\ndone\nfor v in POOL_API_KEY PORT; do [ -n \"$\{!v}\" ] || \{ ev \"REFUSED: $v not set in template env\"; exit 1; }; done\nDRV=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1)\n[ \"$\{DRV%%.*}\" -ge 580 ] || \{ ev \"REFUSED: driver $DRV; this image needs 580+ (CUDA 13.x)\"; exit 1; }\numask 077; printf %s \"$POOL_API_KEY\" > /root/.pool_key\n# TLS: one key per card, kept across restarts so its pin holds. No TLS, no start.\n[ -s $D/tls.key ] && [ -s $D/tls.crt ] || openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \\\n  -days 3650 -subj \"/CN=pool-card\" -keyout $D/tls.key -out $D/tls.crt >> $D/events.log 2>&1\numask 022\n[ -s $D/tls.key ] && [ -s $D/tls.crt ] || \{ ev \"REFUSED: no TLS certificate could be made\"; exit 1; }\nTLS=\"--ssl-keyfile $D/tls.key --ssl-certfile $D/tls.crt\"\n\n# Session caches: ram-disk (default) = LMCache, sessions evicted from the GPU go to RAM, then disk.\n# vram = GPU only; set CACHE_MODE=vram in the template env to use it.\nCACHE_MODE=$\{CACHE_MODE:-ram-disk}\n# RAM tier: half of the RAM this container may use, at most 60 GB. The container's own limit\n# (cgroup memory.max) can be far below the host's RAM (183 of 251 GB seen 2026-10-16).\nAVAIL=$(awk '/MemAvailable/\{print int($2/1048576)}' /proc/meminfo)\nMAX=$(cat /sys/fs/cgroup/memory.max 2>/dev/null); CUR=$(cat /sys/fs/cgroup/memory.current 2>/dev/null)\n[[ \"$MAX\" =~ ^[0-9]+$ ]] && [[ \"$CUR\" =~ ^[0-9]+$ ]] && \{ C=$(( (MAX - CUR) / 1073741824 )); [ $C -lt $AVAIL ] && AVAIL=$C; }\nL1=$(( AVAIL / 2 )); [ $L1 -gt 60 ] && L1=60\n# Disk tier: 80% of the disk left after the model (~110 GB), at most 800 GB.\nL2=$(( ($(df -BG --output=avail /cache | tail -1 | tr -dc 0-9) - 110) * 8 / 10 )); [ $L2 -gt 800 ] && L2=800\nif [ \"$CACHE_MODE\" = ram-disk ] && \{ [ $L1 -lt 8 ] || [ $L2 -lt 20 ]; }; then\n  ev \"too little RAM/disk for ram-disk (L1 $\{L1}G, L2 $\{L2}G); using vram\"; CACHE_MODE=vram\nfi\n\n# The server downloads the pinned model revision from Hugging Face on first start (~103 GB),\n# and tunes its kernels on first start (~9 min); both stay on disk for restarts.\ncat > $D/run.sh <<EOS\n#!/bin/bash\nexport PORT=$PORT\n# Restart on crash; the pool stops routing to it while it is down.\nwhile true; do\n  if [ \"$CACHE_MODE\" = ram-disk ]; then\n    /usr/local/bin/lil-serve --profile qwen38-flash-next --hardware rtx-pro-6000-pcie \\\\\n      --env LMCACHE_MODE=ram-disk --env LMCACHE_L1_GB=$L1 --env LMCACHE_L2_GB=$L2 --env LMCACHE_L2_ROOT=/cache/kv \\\\\n      -- --port $PORT $TLS --api-key \"\\$(cat /root/.pool_key)\"\n  else\n    /usr/local/bin/lil-serve --profile qwen38-flash-next --hardware rtx-pro-6000-pcie \\\\\n      -- --cache-mode vram --port $PORT $TLS --api-key \"\\$(cat /root/.pool_key)\"\n  fi\n  echo \"\\$(date -u +%FT%TZ) lil-serve exited \\$?; restarting in 10s\" >> $D/events.log; sleep 10\ndone\nEOS\nchmod +x $D/run.sh\nev \"START (driver $DRV, cache $CACHE_MODE, L1 $\{L1}G, L2 $\{L2}G, TLS)\"\nnohup $D/run.sh >> $D/serve.log 2>&1 &\n"

// The disk and the host-filter thresholds are NOT restated here: they derive from the recipe
// (flex_serving_recipe.disk) and the one filter row (flex_flash_next_vast_filters), so the offer screen
// and the ensured template cannot drift apart.
// THE NEW TEMPLATE: the retired template's non-secret fields, read live from srv1 on 2026-10-18
// (operator-account read), minus the four credential envs. R2 is dropped with no replacement (the model
// comes from Hugging Face, so R2 was unused). The image digest is carried in the tag field. The serving
// port is 18000: 8000 is the image's Caddy portal, so the recipe's published_tcp_port (8000) is not this
// realization's port (raised with L1, which owns the recipe).
data flex_vast_template_spec: FlexTemplateSpec = FlexTemplateSpec {
  name: "flex lil v3 (no credential env)" as NonEmptyStr,
  image: "ghcr.io/local-inference-lab/vllm@sha256" as NonEmptyStr,
  tag: "751ee72beb242b163e1124b2e0b825a509e20bacaf1423f467d65f6b8b664bc7" as NonEmptyStr,
  runtype: "ssh" as NonEmptyStr,
  disk: flex_serving_recipe.disk,
  port: 18000,
  shm: gibibyte_to_byte_size(g: gibibyte(count: 80)),
  onstart: flex_vast_onstart,
  ssh_direct: true,
  jup_direct: true,
  use_jupyter_lab: false,
  min_cuda_max_good: flex_flash_next_vast_filters.cuda_max_good_min,
  min_cpu_ram: flex_flash_next_vast_filters.cpu_ram_min,
  min_gpu_ram: flex_flash_next_vast_filters.gpu_ram_min,
  min_inet_down: flex_flash_next_vast_filters.inet_down_min,
  verified_only: flex_flash_next_vast_filters.verified,
}
