module product.fabric.flex_vast_template

import std.types { String, NonEmptyStr, Bool, Int, List, Port, list_length }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.list { first_where }
import std.measure { ByteSize, Bandwidth, gibibyte_count, gibibyte_ceiling }
import std.bytes { bytes_octets, utf8_encode_bytes }
import std.encoding { base64_encode, base64_octets, Base64Variant, Standard }
import std.integer { QualifiedOctetsReady, QualifiedOctetsRefused }
import extdeps.cloud.vast_ai { VastAiTemplateRow }
import product.fabric.flex_vast_shadow { flex_serving_recipe, flex_flash_next_vast_filters }
import product.fabric.flex_serving_image { flex_lil_serving_image }

// ---- THE LAUNCH, TYPED.
// The mode Vast runs on the rented card. Two spellings have been seen on the wire, and the wire name
// comes from this type -- never from a string a caller writes:
//   ssh    the retired shape. Its first boots on fresh hosts did not serve at 55+ min (2026-10-27).
//   args   the shape that served: instance 57968351, 2026-10-27, serving in about 25 min.
// The args launch is applied PER RENT, in the create request (flex_vast_rent_launch below), not stored
// in the template: an args command stored IN a template has never been observed to execute (template
// 782339: 50 min, empty logs). The template declares the mode so the readback and the create agree.
//
// The mode and what it may carry are ONE sum, so a mode cannot hold the other mode's field: an ssh launch
// carries a stored on-start script and no args; an args launch carries the container command and no stored
// script (its script travels base64 in the create env). Every wire field is derived from the arm.
type FlexTemplateLaunch
  = FlexSshLaunch { onstart: String }
  | FlexArgsLaunch { args: List<String> }

fn flex_launch_runtype_wire(launch: FlexTemplateLaunch) -> String {
  match launch {
    FlexSshLaunch { onstart: _ } => "ssh"
    FlexArgsLaunch { args: _ } => "args"
  }
}

fn flex_launch_args(launch: FlexTemplateLaunch) -> List<String> {
  match launch {
    FlexSshLaunch { onstart: _ } => []
    FlexArgsLaunch { args: a } => a
  }
}

fn flex_launch_onstart(launch: FlexTemplateLaunch) -> String {
  match launch {
    FlexSshLaunch { onstart: o } => o
    FlexArgsLaunch { args: _ } => ""
  }
}

// The env name the on-start script travels under, base64, in the create request's env.
data flex_vast_onstart_b64_env_name: NonEmptyStr = "ONSTART_B64" as NonEmptyStr

// The docker flag that carries it. One spelling, used by the launch builder and by the printable plan.
fn flex_vast_onstart_b64_flag() -> String {
  join(["-e ", flex_vast_onstart_b64_env_name as String, "="], "")
}

// The container command of the args launch: decode the script out of the env, run it, then hold the
// container open so the ask is not reaped while the server starts. ctrl's session-dashboard bidder
// mirrors this string (gunb-ai/ctrl scripts/session-dashboard/lib/vast_bidder.mjs ARGS_LAUNCH_COMMAND,
// merged in #2401); its R12 marker names THIS declaration the authority, and that copy retires when the
// flex pass rents.
data flex_vast_args_launch_command: String = "echo \"$ONSTART_B64\" | base64 -d > /root/onstart.sh && bash /root/onstart.sh; exec sleep infinity"

data flex_vast_args_launch: List<String> = ["bash", "-c", flex_vast_args_launch_command]

// Vast caps the env string a TEMPLATE stores at 4096 characters. The bound is on the template's own env
// (flex_template_env), which is what a template create sends; the per-rent create env is a different
// field and is NOT under it -- the launch that served carried a 5,277-character create env on instance
// 57968351 (2026-10-27), which is how its on-start script reached the card.
data flex_vast_template_env_max_chars: Int = 4096

// The per-rent CREATE env's own cap is not known. What is known is one observation: a create with an env
// of about 5,277 characters was accepted and served. That is a receipt of this repository's observation,
// not a Vast fact, so it is not stated as a limit. The cap stays unknown until read; if a create is ever
// refused for size, that refusal becomes the reading.
type FlexCreateEnvCap
  = FlexCreateEnvCapUnknown { read_obligation: NonEmptyStr }
  | FlexCreateEnvCapRead { max_chars: Int }

data flex_vast_create_env_cap: FlexCreateEnvCap = FlexCreateEnvCapUnknown {
  read_obligation: "read Vast's API docs for the create-instance env limit, or probe PUT /api/v0/asks/<id>/ for its real cap" as NonEmptyStr,
}

type FlexCreateEnvObservation {
  instance_id: Int
  date: NonEmptyStr
  env_chars: Int
  outcome: NonEmptyStr
}

data flex_vast_create_env_observed_accepted: FlexCreateEnvObservation = FlexCreateEnvObservation {
  instance_id: 57968351,
  date: "2026-10-27" as NonEmptyStr,
  env_chars: 5277,
  outcome: "accepted; served in about 25 min" as NonEmptyStr,
}

type FlexTemplateEnvStanding
  = FlexTemplateEnvWithinBound { chars: Int }
  | FlexTemplateEnvOverBound { chars: Int, max: Int }

fn flex_vast_template_env_standing(env: String) -> FlexTemplateEnvStanding {
  let chars = string_length(s: env)
  if chars > flex_vast_template_env_max_chars {
    FlexTemplateEnvOverBound { chars: chars, max: flex_vast_template_env_max_chars }
  } else {
    FlexTemplateEnvWithinBound { chars: chars }
  }
}

// ---- THE PER-RENT LAUNCH, carried in the create request (PUT /api/v0/asks/<id>/).
// The template stays secret-free; the launch belongs to the create. The script is read from the one
// serving-image fact (product.fabric.flex_serving_image flex_lil_serving_image.onstart), never from the
// template, so there is one script and one place it is written.
type FlexRentLaunch {
  mode: FlexTemplateLaunch
  env: String
}

type FlexRentLaunchRefusal
  = FlexRentLaunchNotArgsMode { runtype: String }
  | FlexRentLaunchNoOnstartScript
  | FlexRentLaunchOnstartNotEncodable
  | FlexRentLaunchEnvAlreadySetsOnstartB64

type FlexRentLaunchResult
  = FlexRentLaunchBuilt { launch: FlexRentLaunch }
  | FlexRentLaunchRefused { cause: FlexRentLaunchRefusal }

// Why a launch could not be built, in words a wall line can print. The refusal itself stays typed; this
// is only its rendering.
fn flex_rent_launch_refusal_cause(cause: FlexRentLaunchRefusal) -> String {
  match cause {
    FlexRentLaunchNotArgsMode { runtype: runtype } => join(["the template launch mode is ", runtype, "; the launch observed to serve is args"], "")
    FlexRentLaunchNoOnstartScript => "the serving image fact carries no on-start script to launch"
    FlexRentLaunchOnstartNotEncodable => "the on-start script is not base64-encodable"
    FlexRentLaunchEnvAlreadySetsOnstartB64 => "the template env already sets ONSTART_B64"
  }
}

fn flex_vast_onstart_b64(script: String) -> String? {
  match base64_octets(values: bytes_octets(b: utf8_encode_bytes(s: script))) {
    QualifiedOctetsRefused { observed: _ } => none
    QualifiedOctetsReady { value: qualified } => Present { value: base64_encode(octets: qualified, variant: Standard) }
  }
}

// The launch a create request carries, or a typed refusal. The template's docker-options string is the
// base; the script is appended to it as `-e ONSTART_B64=<base64>`, which is the form that served.
fn flex_vast_rent_launch(spec: FlexTemplateSpec) -> FlexRentLaunchResult {
  match spec.launch {
    FlexSshLaunch { onstart: _ } => FlexRentLaunchRefused { cause: FlexRentLaunchNotArgsMode { runtype: flex_launch_runtype_wire(launch: spec.launch) } }
    FlexArgsLaunch { args: args } =>
      if string_length(s: flex_lil_serving_image.onstart) == 0 {
        FlexRentLaunchRefused { cause: FlexRentLaunchNoOnstartScript }
      } else {
        let base = flex_template_env(spec: spec)
        let flag = flex_vast_onstart_b64_flag()
        if base.contains(flag) {
          FlexRentLaunchRefused { cause: FlexRentLaunchEnvAlreadySetsOnstartB64 }
        } else {
          match flex_vast_onstart_b64(script: flex_lil_serving_image.onstart) {
            Absent => FlexRentLaunchRefused { cause: FlexRentLaunchOnstartNotEncodable }
            Present { value: b64 } =>
              FlexRentLaunchBuilt {
                launch: FlexRentLaunch {
                  mode: FlexArgsLaunch { args: args },
                  env: join([base, " ", flag, b64], ""),
                },
              }
          }
        }
      }
  }
}

// THE FLEX VAST TEMPLATE AS A DECLARED FACT, secret-free by construction. A template is the host's
// image, disk, launch mode and the PORT its server listens on; the spec has no field that can hold any
// other env, so a credential env is unwritable here. The per-rental server password is not a template
// fact: it is drawn per create (product.fabric.flex_vast_loop mint_flex_create_env) and sent in the
// create request's env, which Vast merges over the template's by key (docs.vast.ai create-instance).
type FlexTemplateSpec {
  name: NonEmptyStr
  image: NonEmptyStr
  tag: NonEmptyStr
  // The launch mode with what it carries: the args container command is applied per rent
  // (flex_vast_rent_launch); an args launch stores no on-start script, because an args command stored IN
  // the template has never been observed to execute and the script travels base64 in the create env.
  launch: FlexTemplateLaunch
  disk: ByteSize
  port: Port
  shm: ByteSize
  ssh_direct: Bool
  jup_direct: Bool
  use_jupyter_lab: Bool
  min_cuda_max_good: Nat
  min_cpu_ram: ByteSize
  min_gpu_ram: ByteSize
  min_inet_down: Bandwidth
  verified_only: Bool
}

// The env string Vast stores, in its Docker-flag format: the published port, the container's shared
// memory and IPC, and PORT. Nothing else.
fn flex_template_env(spec: FlexTemplateSpec) -> String {
  join(["-p ", to_string(spec.port as Int), ":", to_string(spec.port as Int), " --shm-size ", to_string(gibibyte_count(g: gibibyte_ceiling(b: spec.shm)) as Int), "g --ipc host -e PORT=", to_string(spec.port as Int)], "")
}

// The env NAMES a flex template must never carry: the four credential names of the retired template. Names only; the
// values never enter this repository. R2 is dropped entirely (no replacement); POOL_API_KEY is
// per-rental. Used on a READBACK, so a template that carries one is refused whoever created it.
data flex_template_forbidden_env_names: List<String> = [
  "R2_ENDPOINT",
  "R2_ACCESS_KEY_ID",
  "R2_SECRET_ACCESS_KEY",
  "POOL_API_KEY",
]

fn flex_template_env_forbidden_name(env: String) -> String? {
  first_where(flex_template_forbidden_env_names, name => env.contains(name))
}

// The retired template. It is never edited, deleted or adopted by the ensure: a row with this hash is
// refused as the target even when its name matches, and its hash must still read back after a run.
data flex_template_retired_hash: NonEmptyStr = "c6793d31e3204da102145c4c331e42ae" as NonEmptyStr

type FlexTemplateDecision
  = FlexTemplateNoop { hash: String }
  | FlexTemplateApply
  | FlexTemplateRefuse { cause: String }

// Noop/Apply/Refuse over the observed rows (all named by `name`), caller-supplied; this fold neither
// lists nor creates. A matching row is Noop only if its image and env equal the spec's; a name match
// that differs is Refuse, never an in-place edit, because a template's hash changes with its content
// and others depend on hashes.
fn flex_template_decide(spec: FlexTemplateSpec, named: List<VastAiTemplateRow>) -> FlexTemplateDecision {
  if list_length(named) > 1 {
    FlexTemplateRefuse { cause: "more than one template carries the declared name" }
  } else {
    match first_where(named, r => true) {
      Absent => FlexTemplateApply
      Present { value: row } => flex_template_judge_row(spec: spec, row: row)
    }
  }
}

fn flex_template_judge_row(spec: FlexTemplateSpec, row: VastAiTemplateRow) -> FlexTemplateDecision {
  match row.hash_id {
    Absent => FlexTemplateRefuse { cause: "the template row has no hash_id" }
    Present { value: h } =>
      if h == (flex_template_retired_hash as String) {
        FlexTemplateRefuse { cause: "the declared name resolves to the retired template, which is never adopted" }
      } else {
        match row.env {
          Absent => FlexTemplateRefuse { cause: "the template row's env was not read" }
          Present { value: env } =>
            match flex_template_env_forbidden_name(env: env) {
              Present { value: n } => FlexTemplateRefuse { cause: concat("the template carries a forbidden env name ", n) }
              Absent =>
                if (row.image == (spec.image as String)) && (env == flex_template_env(spec: spec)) {
                  FlexTemplateNoop { hash: h }
                } else {
                  FlexTemplateRefuse { cause: "a template of the declared name exists with different content" }
                }
            }
        }
      }
  }
}


// The disk and the host-filter thresholds are NOT restated here: they derive from the recipe
// (flex_serving_recipe.disk) and the one filter row (flex_flash_next_vast_filters), so the offer screen
// and the ensured template cannot drift apart.
// THE NEW TEMPLATE: the retired template's non-secret fields, read live from srv1 on 2026-10-18
// (operator-account read), minus the four credential envs. R2 is dropped with no replacement (the model
// comes from Hugging Face, so R2 was unused). The image digest is carried in the tag field. The serving
// port is 18000: 8000 is the image's Caddy portal, so the recipe's published_tcp_port (8000) is not this
// realization's port (raised with L1, which owns the recipe).
// THE SUPPLIER-AGNOSTIC HALF (image repository and digest, port, shm, onstart) is read from
// product.fabric.flex_serving_image flex_lil_serving_image, which the EC2 launch template reads too; Vast
// stores the digest in its tag field, so the image field here is the repository plus "@sha256".
// The launch is args mode with an empty stored onstart: the script reaches the card base64 in the create
// request's env (flex_vast_rent_launch), which is the form observed to serve.
data flex_vast_template_spec: FlexTemplateSpec = FlexTemplateSpec {
  name: "flex lil v3 (no credential env)" as NonEmptyStr,
  image: join([flex_lil_serving_image.repository as String, "@sha256"], "") as NonEmptyStr,
  tag: flex_lil_serving_image.digest_sha256,
  launch: FlexArgsLaunch { args: flex_vast_args_launch },
  disk: flex_serving_recipe.disk,
  port: flex_lil_serving_image.port,
  shm: flex_lil_serving_image.shm,
  ssh_direct: true,
  jup_direct: true,
  use_jupyter_lab: false,
  min_cuda_max_good: flex_flash_next_vast_filters.cuda_max_good_min,
  min_cpu_ram: flex_flash_next_vast_filters.cpu_ram_min,
  min_gpu_ram: flex_flash_next_vast_filters.gpu_ram_min,
  min_inet_down: flex_flash_next_vast_filters.inet_down_min,
  verified_only: flex_flash_next_vast_filters.verified,
}
