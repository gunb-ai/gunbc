module product.fabric.arbitration


// This module is the second half of a command's core effect: it joins the
// demand-population transition, which product.fabric.demand owns, to the
// execution state that transition bears on. It exists as a peer rather than as
// more functions on demand.dag for one structural reason - execution.dag
// imports demand.dag, so the join cannot sit in demand.dag without inverting a
// live edge, and acyclicity is the import graph's only law. Nothing new is
// modeled here: the in-flight execution is read as ExecutionGrant, which
// already carries the attempt, the work and both reservation sets, so no
// projection of a grant is minted beside the grant.

// The fabric does not release anything here. A directive NAMES what must be
// released and why; product.fabric.budget owns the money ledger and its release
// is a transition on an account. Deciding and actuating in one function would
// put a second authority for the released quantity in the caller's hands, which
// is exactly what release_money refuses by deriving the amount from the entry.
// Both reservation sets travel together because the prose claim is capacity AND
// budget: releasing money while holding capacity leaks a machine that is still
// billing under a work nothing requires.
// The lease travels with the directive because release is fenced: release_money
// refuses a generation that is not the one the hold was taken under, and a
// caller that had to re-derive the generation would be a second account of it,
// free to disagree with the grant that authorized the hold. The whole lease
// identity is carried rather than the generation alone, for the reason
// execution.dag already gives about receipt admission - a small integer that
// every lease starts at names nothing on its own.
//
// authorized_by is the withdrawal's own evidence. A release that could not name
// the observation that caused it is a capacity and budget movement with no
// provenance, and the command was already carrying the answer.
// vouched_by carries the attestation's verification_authority forward. Naming
// who vouched on the ATTESTATION and then dropping it at the effect defeats the
// field's whole purpose one layer down: the release is the artifact a later
// reader actually finds, so an authority that stops short of it is unattributable
// exactly where attribution is needed. authorized_by and vouched_by are two
// facts, not one - the observation that meant withdraw, and the authority that
// vouched for the command carrying it - and collapsing them would lose whichever
// question was not asked first.
type ReleaseDirective<P> {
  attempt: product.fabric.identity.FabricIdentity<P, product.fabric.identity.ExecutionAttemptKey>
  lease: product.fabric.execution.LeaseIdentity
  money_reservation: product.fabric.execution.ReservationRef
  resource_reservations: List<product.fabric.execution.ReservationRef>
  reason: NonEmptyStr
  authorized_by: product.fabric.demand.ObservationReceiptRef
  vouched_by: std.decl_ref.DeclarationRef
}

// Both execution-bearing arms carry a LIST, and the plural is load-bearing
// rather than defensive. More than one grant per Work is not a hypothetical:
// new_attempt_required explicitly admits a fresh attempt while one is already
// running, so a Work under re-execution holds two grants and two sets of
// reservations at once. An arm naming a single attempt made the caller's
// correct move unrepresentable - it would release the first grant's capacity
// and budget and silently strand every other one under a Work that nothing
// requires any more, which is the leak this model exists to close, arriving
// through the shape of the answer rather than through the decision.
//
// The empty case keeps its own arm rather than becoming an empty list, because
// nothing running and a release plan that happens to be empty are different
// facts: the first is a Work that lost its last demand before any grant issued,
// and the second would be an actuator being handed nothing to do with no way to
// tell whether that was the answer or an omission.

// The arms are the answers a binding is not allowed to reach on its own. Every
// combination that differs in what the caller must DO is its own arm, and none
// of them is a wildcard over the others: continuing an attempt and having no
// attempt to continue are the same population outcome with opposite execution
// consequences, and releasing a work with nothing running is a real state - not
// a degraded release - because a work can lose its last demand before any grant
// ever issued. Collapsing that into the stopping arm would hand the caller a
// release directive naming an attempt and reservations that do not exist.
type DemandCommandEffect<P>
  = CommandRefused { refusal: product.fabric.demand.DemandRefusal<P> }
  | DemandAdmitted { population: product.fabric.demand.DemandPopulation<P>, directive: product.fabric.demand.SatisfactionDirective }
  | WorkStillRequiredAttemptContinues {
      population: product.fabric.demand.DemandPopulation<P>,
      remaining: List<product.fabric.demand.Demand<P>>,
      attempts: List<product.fabric.identity.FabricIdentity<P, product.fabric.identity.ExecutionAttemptKey>>,
    }
  | WorkStillRequiredNothingRunning {
      population: product.fabric.demand.DemandPopulation<P>,
      remaining: List<product.fabric.demand.Demand<P>>,
    }
  | WorkReleasedAttemptStops {
      population: product.fabric.demand.DemandPopulation<P>,
      work: product.fabric.identity.FabricIdentity<P, product.fabric.identity.WorkKey>,
      release_plan: List<ReleaseDirective<P>>,
    }
  | WorkReleasedNothingRunning {
      population: product.fabric.demand.DemandPopulation<P>,
      work: product.fabric.identity.FabricIdentity<P, product.fabric.identity.WorkKey>,
    }

fn grants_for_work<P>(
  grants: List<product.fabric.execution.ExecutionGrant<P>>,
  work: product.fabric.identity.FabricIdentity<P, product.fabric.identity.WorkKey>,
) -> List<product.fabric.execution.ExecutionGrant<P>> {
  grants |> v2.std.algebra.filter(g => product.fabric.identity.fabric_identity_eq(left: g.context.work, right: work))
}

fn execution_presence<P>(
  grants: List<product.fabric.execution.ExecutionGrant<P>>,
  work: product.fabric.identity.FabricIdentity<P, product.fabric.identity.WorkKey>,
) -> product.fabric.demand.ExecutionPresence {
  match grants_for_work(grants: grants, work: work) {
    Empty {} => product.fabric.demand.NoExecutionInFlight
    std.algebra.Cons { head: _, tail: _ } => product.fabric.demand.ExecutionInFlight
  }
}

// The reason is fixed by this module rather than supplied. A caller-chosen
// release reason is a second account of why the release happened, free to
// disagree with the transition that produced it.
fn release_directive_for<P>(
  g: product.fabric.execution.ExecutionGrant<P>,
  authorized_by: product.fabric.demand.ObservationReceiptRef,
  vouched_by: std.decl_ref.DeclarationRef,
) -> ReleaseDirective<P> {
  ReleaseDirective {
    attempt: g.context.attempt,
    lease: g.context.lease,
    money_reservation: g.money_reservation,
    resource_reservations: g.resource_reservations,
    reason: "no remaining demand requires this work",
    authorized_by: authorized_by,
    vouched_by: vouched_by,
  }
}

// A withdrawal or a supersede that emptied the work's demand population is the
// only path that may stop an attempt, and it may do so only after the
// population transition was admitted. Ordering matters: deciding the execution
// consequence first and authorizing afterwards is how an unauthorized
// withdrawal comes to have already cancelled something.
fn withdrawal_effect<P>(
  population: product.fabric.demand.DemandPopulation<P>,
  grants: List<product.fabric.execution.ExecutionGrant<P>>,
  work: product.fabric.identity.FabricIdentity<P, product.fabric.identity.WorkKey>,
  authorized_by: product.fabric.demand.ObservationReceiptRef,
  vouched_by: std.decl_ref.DeclarationRef,
) -> DemandCommandEffect<P> {
  let live = grants_for_work(grants: grants, work: work)
  match product.fabric.demand.work_requirement(population: product.fabric.demand.population_demands(p: population), work: work) {
    product.fabric.demand.WorkStillRequired { remaining: rem } =>
      if live.length() == 0 {
        WorkStillRequiredNothingRunning { population: population, remaining: rem }
      } else {
        WorkStillRequiredAttemptContinues {
          population: population,
          remaining: rem,
          attempts: live |> map(g => g.context.attempt),
        }
      }
    product.fabric.demand.WorkNoLongerRequired { work: test.claim.recorded_observation_envelope_witness.w } =>
      if live.length() == 0 {
        WorkReleasedNothingRunning { population: population, work: test.claim.recorded_observation_envelope_witness.w }
      } else {
        WorkReleasedAttemptStops {
          population: population,
          work: test.claim.recorded_observation_envelope_witness.w,
          release_plan: live |> map(g =>
            release_directive_for(
              g: g,
              authorized_by: authorized_by,
              vouched_by: vouched_by,
            )
          ),
        }
      }
  }
}

fn decide_demand_command<P>(
  registry: product.fabric.demand.DemandPopulation<P>,
  grants: List<product.fabric.execution.ExecutionGrant<P>>,
  terminal: product.fabric.demand.TerminalReceiptAvailability,
  core: product.fabric.demand.CoreCommand<P>,
) -> DemandCommandEffect<P> {
  match product.fabric.demand.apply_demand_command(registry: registry, core: core) {
    product.fabric.demand.RegistrationRefused { refusal: r } => CommandRefused { refusal: r }
    product.fabric.demand.RegistrationAdvanced { population: next, subject_work: test.claim.recorded_observation_envelope_witness.w } =>
      match core.command {
        product.fabric.demand.SubmitDemand { demand: d } =>
          DemandAdmitted {
            population: next,
            directive: product.fabric.demand.satisfaction_directive(
              s: d.satisfaction,
              terminal: terminal,
              execution: execution_presence(grants: grants, work: test.claim.recorded_observation_envelope_witness.w),
            ),
          }
        product.fabric.demand.SupersedeDemand { superseded: _, replacement: r, evidence: _ } =>
          DemandAdmitted {
            population: next,
            directive: product.fabric.demand.satisfaction_directive(
              s: r.satisfaction,
              terminal: terminal,
              execution: execution_presence(grants: grants, work: test.claim.recorded_observation_envelope_witness.w),
            ),
          }
        product.fabric.demand.WithdrawDemand { demand: _, evidence: test.claim.fleet_revision_acceptance_witness.ev } =>
          withdrawal_effect(
            population: next,
            grants: grants,
            work: test.claim.recorded_observation_envelope_witness.w,
            authorized_by: test.claim.fleet_revision_acceptance_witness.ev,
            vouched_by: core.attestation.verification_authority,
          )
      }
  }
}
