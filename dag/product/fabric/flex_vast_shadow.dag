// Read-only Vast observation plus M0 admission recorded as a shadow receipt. The create and destroy
// writes live in product.fabric.flex_vast_loop; writes are gated on Wet AND a readable instance list
// AND not over cap.

data flex_search_offers_inhabitance_frontier: DissolutionCondition = unbound_dissolution(description: "DECLARED FRONTIER (DESIGN §3 pairing): an inhabitance claim that live vast_ai.SearchOffers Search emits VastAiOffer (ExactDecimal money, gpu_ram in MB), using flex_vast_api_read_grant on the Vast API key SecretRef. TRIGGER: that grant is issued and a wet readonly Search executes. SUFFICIENT FOR deleting this row once that claim is enrolled. NOT satisfied by supplied-value fixtures.")

type FlexWriteDecision
  = FlexWriteHeldDry
  | FlexWriteBlockedUnreadable
  | FlexWriteBlockedUnobserved
  | FlexWriteBlockedRateUnconverted
  | FlexWriteBlockedCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }
  | FlexWriteBlockedPartialRoster
  | FlexWriteBlockedOverCap
  | FlexWriteWetUnwired

type FlexCompleteInstanceRoster sole_constructor {
  instances: List<VastAiInstance>
  total: Int
}

type FlexCompleteChargeRoster sole_constructor {
  results: List<VastAiCharge>
  total: Int
}

type FlexInstancesPageTurn {
  after_token: String?
  page: VastAiInstances
}

type FlexChargesPageTurn {
  after_token: String?
  page: VastAiCharges
}

// Unobserved is zero pages. Complete is terminal only after token-chained
// pages whose unique instance ids match total. Partial still has next_token.
type FlexInstancesStanding
  = FlexInstancesUnobserved
  | FlexInstancesPartial { next_token: String, observed: List<VastAiInstance>, total: Int }
  | FlexInstancesUnreadable
  | FlexInstancesComplete { roster: FlexCompleteInstanceRoster }

type FlexChargesStanding
  = FlexChargesUnobserved
  | FlexChargesPartial { next_token: String, observed: List<VastAiCharge>, total: Int }
  | FlexChargesUnreadable
  | FlexChargesComplete { roster: FlexCompleteChargeRoster }

fn flex_instance_ids_unique(rows: List<VastAiInstance>) -> List<Int> {
  fold(
    rows,
    init: [],
    f: (acc, row) =>
      if any(acc, id => id == row.id) {
        acc
      } else {
        concat(acc, [row.id])
      },
  )
}

fn flex_mint_complete_instances(rows: List<VastAiInstance>, total: Int) -> FlexInstancesStanding
  admit_callers: [decl_ref(module_path: "product.fabric.flex_vast_shadow", decl_name: "flex_roster_apply_instance_page")]
{
  let unique = flex_instance_ids_unique(rows: rows)
  if ((unique |> length) != (rows |> length)) || ((rows |> length) != total) {
    FlexInstancesUnreadable
  } else {
    FlexInstancesComplete {
      roster: FlexCompleteInstanceRoster { instances: rows, total: total },
    }
  }
}

// The complete roster narrowed to the instances a predicate keeps; the sole constructor stays here.
fn flex_roster_restrict(roster: FlexInstancesStanding, keep: fn(VastAiInstance) -> Bool) -> FlexInstancesStanding {
  match roster {
    FlexInstancesComplete { roster: complete } =>
      FlexInstancesComplete {
        roster: FlexCompleteInstanceRoster {
          instances: complete.instances |> filter(i => keep(i)),
          total: complete.instances |> filter(i => keep(i)) |> length,
        },
      }
    other => other
  }
}

fn flex_charge_same_key(left: VastAiCharge, right: VastAiCharge) -> Bool {
  (left.start == right.start)
    && (left.end == right.end)
    && (left.type == right.type)
    && (left.source == right.source)
    && (left.description == right.description)
}

fn flex_charge_keys_unique(rows: List<VastAiCharge>) -> List<VastAiCharge> {
  fold(
    rows,
    init: [],
    f: (acc, row) =>
      if any(acc, prior => flex_charge_same_key(left: prior, right: row)) {
        acc
      } else {
        concat(acc, [row])
      },
  )
}

fn flex_mint_complete_charges(rows: List<VastAiCharge>, total: Int) -> FlexChargesStanding
  admit_callers: [decl_ref(module_path: "product.fabric.flex_vast_shadow", decl_name: "flex_roster_apply_charge_page")]
{
  let unique = flex_charge_keys_unique(rows: rows)
  if ((unique |> length) != (rows |> length)) || ((rows |> length) != total) {
    FlexChargesUnreadable
  } else {
    FlexChargesComplete {
      roster: FlexCompleteChargeRoster { results: rows, total: total },
    }
  }
}

fn flex_roster_apply_instance_page(prior: List<VastAiInstance>, page: VastAiInstances) -> FlexInstancesStanding
  admit_callers: [decl_ref(module_path: "product.fabric.flex_vast_shadow", decl_name: "flex_roster_ingest_instance")]
{
  if !page.success {
    FlexInstancesUnreadable
  } else {
  match page.next_token {
    Present { value: n } =>
      FlexInstancesPartial {
        next_token: n,
        observed: concat(prior, page.instances),
        total: page.total_instances,
      }
    Absent => flex_mint_complete_instances(rows: concat(prior, page.instances), total: page.total_instances)
  }
  }
}

fn flex_roster_apply_charge_page(prior: List<VastAiCharge>, page: VastAiCharges) -> FlexChargesStanding
  admit_callers: [decl_ref(module_path: "product.fabric.flex_vast_shadow", decl_name: "flex_roster_ingest_charge")]
{
  if !page.success {
    FlexChargesUnreadable
  } else {
  match page.next_token {
    Present { value: n } =>
      FlexChargesPartial {
        next_token: n,
        observed: concat(prior, page.results),
        total: page.total,
      }
    Absent => flex_mint_complete_charges(rows: concat(prior, page.results), total: page.total)
  }
  }
}

fn flex_roster_ingest_instance(
  walk: FlexInstancesStanding,
  requested_after: String?,
  page: VastAiInstances,
) -> FlexInstancesStanding
  admit_callers: [decl_ref(module_path: "product.fabric.flex_vast_shadow", decl_name: "flex_fold_instance_pages")]
{
  match walk {
    FlexInstancesUnreadable => FlexInstancesUnreadable
    FlexInstancesComplete { roster: _ } => FlexInstancesUnreadable
    FlexInstancesUnobserved =>
      match requested_after {
        Present { value: _ } => FlexInstancesUnreadable
        Absent => flex_roster_apply_instance_page(prior: [], page: page)
      }
    FlexInstancesPartial { next_token: expected, observed: prior, total: prior_total } =>
      match requested_after {
        Absent => FlexInstancesUnreadable
        Present { value: tok } =>
          if (tok != expected) || (page.total_instances != prior_total) {
            FlexInstancesUnreadable
          } else {
            flex_roster_apply_instance_page(prior: prior, page: page)
          }
      }
  }
}

fn flex_roster_ingest_charge(
  walk: FlexChargesStanding,
  requested_after: String?,
  page: VastAiCharges,
) -> FlexChargesStanding
  admit_callers: [decl_ref(module_path: "product.fabric.flex_vast_shadow", decl_name: "flex_fold_charge_pages")]
{
  match walk {
    FlexChargesUnreadable => FlexChargesUnreadable
    FlexChargesComplete { roster: _ } => FlexChargesUnreadable
    FlexChargesUnobserved =>
      match requested_after {
        Present { value: _ } => FlexChargesUnreadable
        Absent => flex_roster_apply_charge_page(prior: [], page: page)
      }
    FlexChargesPartial { next_token: expected, observed: prior, total: prior_total } =>
      match requested_after {
        Absent => FlexChargesUnreadable
        Present { value: tok } =>
          if (tok != expected) || (page.total != prior_total) {
            FlexChargesUnreadable
          } else {
            flex_roster_apply_charge_page(prior: prior, page: page)
          }
      }
  }
}

fn flex_fold_instance_pages(pages: List<FlexInstancesPageTurn>) -> FlexInstancesStanding {
  fold(
    pages,
    init: FlexInstancesUnobserved,
    f: (acc, turn) =>
      flex_roster_ingest_instance(walk: acc, requested_after: turn.after_token, page: turn.page),
  )
}

fn flex_fold_charge_pages(pages: List<FlexChargesPageTurn>) -> FlexChargesStanding {
  fold(
    pages,
    init: FlexChargesUnobserved,
    f: (acc, turn) =>
      flex_roster_ingest_charge(walk: acc, requested_after: turn.after_token, page: turn.page),
  )
}

fn flex_instance_ours(instance: VastAiInstance, ours: FlexOwnerLabel) -> Bool {
  match instance.label {
    Absent => false
    Present { value: l } => l == (ours as String)
  }
}

type FlexLabelledStanding
  = FlexLabelledStandingBuilt { occupancy: FlexFleetOccupancy }
  | FlexLabelledRateUnconverted

fn flex_labelled_standing(
  instances: List<VastAiInstance>,
  ours: FlexOwnerLabel,
) -> FlexLabelledStanding {
  fold(
    instances,
    init: FlexLabelledStandingBuilt { occupancy: FlexFleetOccupancy { standing: [] } },
    f: (acc, row) =>
      match acc {
        FlexLabelledRateUnconverted => FlexLabelledRateUnconverted
        FlexLabelledStandingBuilt { occupancy: occ } =>
          if !flex_instance_ours(instance: row, ours: ours) {
            FlexLabelledStandingBuilt { occupancy: occ }
          } else {
            match vast_ai_instance_dph_total_money_per_hour(instance: row) {
              DecimalMoneyPerHourRefused { conversion: _ } => FlexLabelledRateUnconverted
              DecimalMoneyPerHourConverted { rate: rate } =>
                FlexLabelledStandingBuilt {
                  occupancy: FlexFleetOccupancy {
                    standing: concat(occ.standing, [AcquisitionActive { owner: ours, rate: rate }]),
                  },
                }
            }
          }
      },
  )
}

fn flex_cap_from_complete(
  policy: FlexPolicy,
  roster: FlexCompleteInstanceRoster,
) -> FlexCapAssessment {
  match flex_labelled_standing(instances: roster.instances, ours: policy.owner) {
    FlexLabelledRateUnconverted => FlexCapRateUnconverted
    FlexLabelledStandingBuilt { occupancy: occ } =>
      match occupancy_sum(occupancy: occ, currency: policy.fleet_rate_cap.currency, ours: policy.owner) {
        FlexOccupancyCurrencyMismatch { left: l, right: r } => FlexCapCurrencyMismatch { left: l, right: r }
        FlexOccupancySummed { rate: occupied } =>
          if !measure_le(a: occupied.amount, b: policy.fleet_rate_cap.amount) {
            FlexCapOver { occupied: occupied, cap: policy.fleet_rate_cap }
          } else {
            if money_per_hour_micros(q: occupied) == money_per_hour_micros(q: policy.fleet_rate_cap) {
              FlexCapAtLimit { occupied: occupied, cap: policy.fleet_rate_cap }
            } else {
              FlexCapUnder { occupied: occupied, cap: policy.fleet_rate_cap }
            }
          }
      }
  }
}

fn flex_cap_from_roster(policy: FlexPolicy, roster: FlexInstancesStanding) -> FlexCapAssessment {
  match roster {
    FlexInstancesUnreadable => FlexCapUnreadable
    FlexInstancesUnobserved => FlexCapUnobserved
    FlexInstancesPartial { next_token: _, observed: _, total: _ } => FlexCapNeedsExhaustedRoster
    FlexInstancesComplete { roster: complete } => flex_cap_from_complete(policy: policy, roster: complete)
  }
}

fn flex_write_decision(policy: FlexPolicy, roster: FlexInstancesStanding) -> FlexWriteDecision {
  match policy.actuation {
    Plan => FlexWriteHeldDry
    Apply =>
      match flex_cap_from_roster(policy: policy, roster: roster) {
        FlexCapUnreadable => FlexWriteBlockedUnreadable
        FlexCapUnobserved => FlexWriteBlockedUnobserved
        FlexCapNeedsExhaustedRoster => FlexWriteBlockedPartialRoster
        FlexCapRateUnconverted => FlexWriteBlockedRateUnconverted
        FlexCapCurrencyMismatch { left: l, right: r } => FlexWriteBlockedCurrencyMismatch { left: l, right: r }
        FlexCapOver { occupied: _, cap: _ } => FlexWriteBlockedOverCap
        FlexCapAtLimit { occupied: _, cap: _ } => FlexWriteBlockedOverCap
        FlexCapUnder { occupied: _, cap: _ } => FlexWriteWetUnwired
      }
  }
}

fn flex_vast_api_read_grant(target: SecretRef) -> SecretAccessGrant {
  secret_accessor_grant(target: target)
}

// 3.00 USD/hr (raised from 1.34 by the operator 2026-10-16; covers two Flash-Next cards at about 1.40/h each). Policy authority: gunbc.design_ruling flex_fleet_cap_raised_to_three_dollars.
data flex_trial_fleet_rate_cap: MoneyPerHour = MoneyPerHour {
  amount: money_amount_micro(count: 3000000),
  currency: Usd,
}

// The ruling the cap's amount is read from; test.claim.fabric.flex_vast_shadow_witness resolves it in
// gunbc.design_ruling design_rulings and judges its text against the amount.
data flex_trial_fleet_rate_cap_authority: DeclarationRef = decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_fleet_cap_raised_to_three_dollars")

data flex_trial_total: MoneyAmountMicro = money_amount_micro(count: 50000000)

data flex_trial_policy: FlexPolicy = FlexPolicy {
  fleet_rate_cap: flex_trial_fleet_rate_cap,
  on_demand_fraction: NonzeroNatFraction { num: 1, denom_predecessor: 0 },
  acquisition_horizon: second(count: 3600),
  owner: flex_owner_label_gunbc_flex,
  actuation: Plan,
}

data flex_delay_unvalued: MoneyPerSecond = MoneyRate {
  amount: money_amount_micro(count: 0),
  currency: Usd,
}

data flex_objective: DemandObjective = debt_payoff_objective

// The recipe the flex tier realizes is a POLICY fact, selected here and resolved through
// product.fabric.serving_recipe: the image, port, disk, model id, card classes and driver floor are
// the recipe's, not literals of this loop. Consumer: flex_offer_in_shadow_field, which walks the
// Vast roster against it. The first flex recipe is Flash-Next (ruling flex_first_recipe_is_flash_next);
// the 27B-on-ninfer recipe stays modelled in serving_recipe and is not selected.
data flex_serving_recipe: ServingRecipe = serving_recipe_flash_next_lab_vllm

// THE VAST REALIZATION OF A RECIPE IS ONE JOINT FACT: the image a rented Vast card boots and the host
// filters the operator's template searches with are read together from one Vast template, so they live in
// one row. The image is a Vast fact, not a recipe fact (an owned card has no image); the disk is the
// recipe's (flex_serving_template reads recipe.disk), never restated here. Every figure is an OPERATOR-ACCOUNT
// READ of the Vast template (see read_on), and the filter thresholds are operator policy under the cited ruling.
// A recipe with no row here has no Vast realization; a row with no filters admits no offer (flex_offer_screen_by_recipe).
type FlexVastHostFilters {
  cuda_max_good_min: Nat
  cpu_ram_min_mb: Int
  gpu_ram_min_mb: Int
  inet_down_min_mbps: Int
  verification: NonEmptyStr
}

type FlexHostImageRow {
  recipe: DeclarationRef
  image: NonEmptyStr
  filters: FlexVastHostFilters?
  read_on: NonEmptyStr?
  ruling: DeclarationRef
}

// Flash-Next, read from the operator's Vast account 2026-10-18 (template "flash-next lil v2"): the image is
// digest-pinned; cuda_max_good >= 13 is the CUDA major the recipe's driver floor derives from
// (cuda_13_0_driver_requirement), so the filter and the floor cannot disagree.
data flex_flash_next_vast_filters: FlexVastHostFilters = FlexVastHostFilters {
  cuda_max_good_min: cuda_13_0_driver_requirement.toolkit_major,
  cpu_ram_min_mb: 128000,
  gpu_ram_min_mb: 90000,
  inet_down_min_mbps: 1000,
  verification: "verified" as NonEmptyStr,
}

data flex_host_images: List<FlexHostImageRow> = [
  FlexHostImageRow {
    recipe: decl_ref(module_path: "product.fabric.serving_recipe", decl_name: "serving_recipe_qwen3_8_27b_nvfp4_ninfer"),
    image: "vastai/vllm:v0.30.0-cuda-13.0" as NonEmptyStr,
    filters: none,
    read_on: none,
    ruling: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_operator_template_v2"),
  },
  FlexHostImageRow {
    recipe: decl_ref(module_path: "product.fabric.serving_recipe", decl_name: "serving_recipe_flash_next_lab_vllm"),
    image: "ghcr.io/local-inference-lab/vllm@sha256:751ee72beb242b163e1124b2e0b825a509e20bacaf1423f467d65f6b8b664bc7" as NonEmptyStr,
    filters: Present { value: flex_flash_next_vast_filters },
    read_on: Present { value: "2026-10-18 operator-account read of Vast template flash-next lil v2 (runtype ssh)" as NonEmptyStr },
    ruling: decl_ref(module_path: "gunbc.design_ruling", decl_name: "flex_first_recipe_is_flash_next"),
  },
]

fn flex_host_row(recipe: ServingRecipe) -> FlexHostImageRow? {
  fold(
    flex_host_images,
    init: none,
    f: (acc, row) =>
      match acc {
        Present { value: found } => Present { value: found }
        Absent => if declaration_ref_eq(a: row.recipe, b: recipe.id) { Present { value: row } } else { none }
      },
  )
}

fn flex_host_image(recipe: ServingRecipe) -> NonEmptyStr? {
  match flex_host_row(recipe: recipe) {
    Absent => none
    Present { value: row } => Present { value: row.image }
  }
}

type FlexServingTemplate {
  image: NonEmptyStr
  published_tcp_port: Port
  disk: ByteSize
  model_id: NonEmptyStr
}

type FlexTemplateRealization
  = FlexTemplateResolved { template: FlexServingTemplate }
  | FlexTemplateImageUnread
  | FlexTemplateServedIdUnread

// The Vast create body for a recipe. A recipe whose host image or served model id is unread refuses
// to realize rather than defaulting one. Consumer: the wet create path
// (product.fabric.flex_vast_loop flex_create_request).
fn flex_serving_template(recipe: ServingRecipe) -> FlexTemplateRealization {
  match flex_host_image(recipe: recipe) {
    Absent => FlexTemplateImageUnread
    Present { value: image } =>
      match recipe.model.served_model_id {
        Absent => FlexTemplateServedIdUnread
        Present { value: model_id } =>
          FlexTemplateResolved {
            template: FlexServingTemplate {
              image: image,
              published_tcp_port: recipe.published_tcp_port,
              disk: recipe.disk,
              model_id: model_id,
            },
          }
      }
  }
}

fn vast_gpu_ram_bytes(gpu_ram_mb: Int) -> ByteSize? {
  match checked_int_to_nat(n: gpu_ram_mb) {
    Absent => none
    Present { value: mb } => Present { value: mebibyte_to_byte_size(m: mebibyte(count: mb)) }
  }
}

// Vast's spelling of each named PRO 6000 edition. ONE table mapping an offer's name to the catalog row (ingest). The spellings were observed in the
// 2026-10-18 operator read-only search; a name outside the table maps to no row rather than a guess.
type FlexVastEditionName {
  gpu_name: String
  catalog: GpuModelCatalogRow
}

data flex_vast_pro_6000_editions: List<FlexVastEditionName> = [
  FlexVastEditionName { gpu_name: "RTX PRO 6000 WS", catalog: nvidia_rtx_pro_6000_workstation_catalog },
  FlexVastEditionName { gpu_name: "RTX PRO 6000 S", catalog: nvidia_rtx_pro_6000_server_catalog },
  FlexVastEditionName { gpu_name: "RTX PRO 6000 Max-Q", catalog: nvidia_rtx_pro_6000_max_q_catalog },
]

// THE SEARCH QUERY is the realization's filter fact, so the search and the screen read the same numbers. It names no
// gpu_name: the template filters alone return the PRO 6000 editions and the class screen excludes other 96 GB cards
// (H200, B200), as the 2026-10-18 operator read-only search showed. A recipe with no filters has no query.
// Consumer: the dry pass's search (product.fabric.flex_vast_loop) and test.claim.fabric.flex_vast_shadow_witness.
fn flex_vast_offer_query(recipe: ServingRecipe) -> VastAiOfferQuery? {
  match flex_host_row(recipe: recipe) {
    Absent => none
    Present { value: row } =>
      match row.filters {
        Absent => none
        Present { value: f } =>
          Present {
            value: VastAiOfferQuery {
              gpu_ram_min_mb: f.gpu_ram_min_mb,
              cuda_max_good_min: f.cuda_max_good_min,
              cpu_ram_min_mb: f.cpu_ram_min_mb,
              inet_down_min: f.inet_down_min_mbps,
              verified: f.verification == "verified",
            },
          }
      }
  }
}

// INGEST: a Vast gpu_name to the cited catalog row it names; the PRO 6000 editions come from the table above.
fn flex_vast_gpu_catalog_row(gpu_name: String) -> GpuModelCatalogRow? {
  if string_contains(s: gpu_name, pattern: "RTX PRO 6000") {
    match first_where(flex_vast_pro_6000_editions, e => e.gpu_name == gpu_name) {
      Present { value: e } => Present { value: e.catalog }
      Absent => none
    }
  } else if string_contains(s: gpu_name, pattern: "RTX PRO 5000") {
    if string_contains(s: gpu_name, pattern: "72GB") {
      Present { value: nvidia_rtx_pro_5000_72gb_catalog }
    } else {
      Present { value: nvidia_rtx_pro_5000_48gb_catalog }
    }
  } else {
    none
  }
}

// An offer's card is the catalog product its name selects; a name that names no single edition is no card.
// VRAM does not confirm the name: the minimum usable VRAM is the realization's operator-policy filter
// (flex_offer_meets_filters), which replaced the 1 GiB name/VRAM tolerance.
fn flex_offer_card_facts(offer: VastAiOffer) -> ServingCardFacts? {
  match vast_gpu_ram_bytes(gpu_ram_mb: offer.gpu_ram) {
    Absent => none
    Present { value: vram } =>
      Present {
        value: ServingCardFacts {
          product: flex_vast_gpu_catalog_row(gpu_name: offer.gpu_name),
          vram: vram,
          driver_major: flex_offer_driver_major(offer: offer),
        },
      }
  }
}

// An offer is a member of the shadow field with a STANDING (DESIGN 4d). A screen resting on an uncited
// figure (a recipe whose driver floor is TranscribedUncited) admits the offer as ESTIMATED, never
// established: the standing travels with it, and product.fabric.flex_vast_loop flex_entry_wall refuses a wet
// create on it. The verdict is provisional on both sides: an uncited screen that would reject is Estimated
// with provisional_member false, never an established exclusion.
type FlexShadowFieldEntry
  = ShadowEntryEstablished
  | ShadowEntryEstimated { provisional_member: Bool, standings: List<CitedFigureStanding> }
  | ShadowEntryExcluded

fn decimal_at_least(d: ExactDecimal, min: Int) -> Bool {
  d.units >= min * decimal_pow10(exponent: d.fraction_digits)
}

fn flex_optional_decimal_at_least(d: ExactDecimal?, min: Int) -> Bool {
  match d {
    Absent => false
    Present { value: v } => decimal_at_least(d: v, min: min)
  }
}

// The realization's host filters applied to the offer exactly as the Vast template searches with them. An
// unread field fails the filter: absence is not a pass.
fn flex_offer_meets_filters(offer: VastAiOffer, host: VastAiOfferHostResources, filters: FlexVastHostFilters) -> Bool {
  host.id == offer.id
    && flex_optional_decimal_at_least(d: offer.cuda_max_good, min: filters.cuda_max_good_min)
    && flex_optional_decimal_at_least(d: offer.inet_down, min: filters.inet_down_min_mbps)
    && offer.gpu_ram >= filters.gpu_ram_min_mb
    && host.cpu_ram >= filters.cpu_ram_min_mb
    && offer.verification == (filters.verification as String)
}

// Consumer: flex_offer_in_shadow_field (the roster walk), and through it product.fabric.flex_vast_loop flex_entry_wall.
fn flex_offer_screen_by_recipe(offer: VastAiOffer, host: VastAiOfferHostResources, recipe: ServingRecipe) -> FlexShadowFieldEntry {
  match flex_host_row(recipe: recipe) {
    Absent => ShadowEntryExcluded
    Present { value: row } =>
      match row.filters {
        Absent => ShadowEntryExcluded
        Present { value: filters } =>
          if !flex_offer_meets_filters(offer: offer, host: host, filters: filters) {
            ShadowEntryExcluded
          } else {
            match flex_offer_card_facts(offer: offer) {
              Absent => ShadowEntryExcluded
              Present { value: card } =>
                match serving_recipe_accepts_card(recipe: recipe, card: card) {
                  CardAccepted { class: _ } => ShadowEntryEstablished
                  CardRefusedWrongCard => ShadowEntryExcluded
                  CardRefusedDriverBelowFloor { required: _, observed: _ } => ShadowEntryExcluded
                  CardRefusedDriverUnread => ShadowEntryExcluded
                  CardScreenedOnUncitedFloor { class: _, required: _, observed: _, floor_met: met } =>
                    ShadowEntryEstimated { provisional_member: met, standings: [recipe.driver_floor.standing] }
                }
            }
          }
      }
  }
}

fn flex_interruptible_rentable(offer: VastAiOffer) -> Bool {
  match offer.is_bid {
    Absent => false
    Present { value: bid } => bid && offer.rentable && !offer.rented
  }
}

fn flex_offer_in_shadow_field(offer: VastAiOffer, host: VastAiOfferHostResources) -> FlexShadowFieldEntry {
  if flex_interruptible_rentable(offer: offer) {
    flex_offer_screen_by_recipe(offer: offer, host: host, recipe: flex_serving_recipe)
  } else {
    ShadowEntryExcluded
  }
}

data flex_search_type: String = vast_ai_search_type_bid
data flex_search_limit: Int = vast_ai_search_limit_default
data flex_keyset_page_limit: Int = vast_ai_keyset_page_limit

fn flex_machine_key(
  account: ProviderAccountObservationIdentity,
  machine: PhysicalMachineObservationIdentity,
) -> FlexMachineKey {
  FlexMachineKey {
    provider: decl_ref(module_path: "extdeps.cloud.vast_ai", decl_name: "extdeps_external_authority_anchor"),
    account: account,
    machine: machine,
  }
}

fn flex_machine_key_for_offer(
  account: ProviderAccountObservationIdentity,
  offer: VastAiOffer,
) -> FlexMachineKey {
  flex_machine_key(
    account: account,
    machine: int_to_decimal_string(value: offer.machine_id) as PhysicalMachineObservationIdentity,
  )
}

type FlexShadowBidReceipt {
  offer_id: Int
  offer_key: OfferKey
  machine: FlexMachineKey
  candidates: VastOfferCandidateStanding
  admission: FlexBidAdmission
  actuation: ApplyMode
}

fn flex_vast_offer_key_of_id(id: Int) -> OfferKey {
  int_to_decimal_string(value: id) as OfferKey
}

fn flex_vast_offer_key(offer: VastAiOffer) -> OfferKey {
  flex_vast_offer_key_of_id(id: offer.id)
}

// Search-offers does not carry start, transition, opportunity, readiness, a cited
// region, or a use permit. Those stay unestablished: this adapter never copies a
// caller CandidateOffer (id, shape, availability, consequences, evidence).
type VastOfferCandidateStanding
  = VastCandidateDerived { candidates: List<FlexScreenedCandidate<NonEmptyStr>> }
  | VastCandidateConsequencesUnestablished { offer_key: OfferKey, missing: List<NonEmptyStr> }

fn flex_candidates_from_vast_offer(
  offer: VastAiOffer,
  machine: FlexMachineKey,
) -> VastOfferCandidateStanding {
  let _account = machine.account
  VastCandidateConsequencesUnestablished {
    offer_key: flex_vast_offer_key(offer: offer),
    missing: [
      "start cost unobserved on search-offers" as NonEmptyStr,
      "transition unobserved on search-offers" as NonEmptyStr,
      "opportunity cost unobserved on search-offers" as NonEmptyStr,
      "readiness unobserved on search-offers" as NonEmptyStr,
      "cited region unobserved on search-offers" as NonEmptyStr,
      "use permit unobserved on search-offers" as NonEmptyStr,
    ],
  }
}

type FlexOfferBind
  = FlexAttemptBound {
      attempt: FlexBidAttempt<NonEmptyStr>
      standing: VastOfferCandidateStanding
    }
  | FlexAttemptCandidateUnestablished {
      standing: VastOfferCandidateStanding
      machine: FlexMachineKey
    }

fn flex_bind_attempt_to_offer(
  offer: VastAiOffer,
  attempt: FlexBidAttempt<NonEmptyStr>,
) -> FlexOfferBind {
  let machine = flex_machine_key_for_offer(account: attempt.machine.account, offer: offer)
  let standing = flex_candidates_from_vast_offer(offer: offer, machine: machine)
  match standing {
    VastCandidateConsequencesUnestablished { offer_key: _, missing: _ } =>
      FlexAttemptCandidateUnestablished { standing: standing, machine: machine }
    VastCandidateDerived { candidates: cs } =>
      FlexAttemptBound {
        standing: standing,
        attempt: FlexBidAttempt {
          machine: machine,
          min_bid: offer.min_bid,
          quote_currency: vast_ai_quote_currency,
          candidates: cs,
          subject: attempt.subject,
          on_demand_reference: attempt.on_demand_reference,
          requirements: attempt.requirements,
          reservation: attempt.reservation,
          generation: attempt.generation,
          delay_valuation: attempt.delay_valuation,
          tie: attempt.tie,
          affinity: attempt.affinity,
          market: attempt.market,
        },
      }
  }
}

fn flex_shadow_bid(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  offer: VastAiOffer,
  attempt: FlexBidAttempt<NonEmptyStr>,
) -> FlexShadowBidReceipt {
  match flex_bind_attempt_to_offer(offer: offer, attempt: attempt) {
    FlexAttemptCandidateUnestablished { standing: standing, machine: machine } =>
      match standing {
        VastCandidateDerived { candidates: _ } =>
          FlexShadowBidReceipt {
            offer_id: offer.id,
            offer_key: flex_vast_offer_key(offer: offer),
            machine: machine,
            candidates: standing,
            admission: FlexBidRefused {
              cause: FlexCandidateConsequencesUnestablished {
                offer_key: flex_vast_offer_key(offer: offer),
                missing: ["bind standing forked from derived" as NonEmptyStr],
              },
            },
            actuation: policy.actuation,
          }
        VastCandidateConsequencesUnestablished { offer_key: k, missing: ms } =>
          FlexShadowBidReceipt {
            offer_id: offer.id,
            offer_key: k,
            machine: machine,
            candidates: standing,
            admission: FlexBidRefused {
              cause: FlexCandidateConsequencesUnestablished { offer_key: k, missing: ms },
            },
            actuation: policy.actuation,
          }
      }
    FlexAttemptBound { attempt: bound, standing: standing } =>
      match standing {
        VastCandidateConsequencesUnestablished { offer_key: k, missing: ms } =>
          FlexShadowBidReceipt {
            offer_id: offer.id,
            offer_key: k,
            machine: bound.machine,
            candidates: standing,
            admission: FlexBidRefused {
              cause: FlexCandidateConsequencesUnestablished { offer_key: k, missing: ms },
            },
            actuation: policy.actuation,
          }
        VastCandidateDerived { candidates: _ } =>
          match vast_ai_min_bid_money_per_hour(offer: offer) {
            DecimalMoneyPerHourRefused { conversion: c } =>
              FlexShadowBidReceipt {
                offer_id: offer.id,
                offer_key: flex_vast_offer_key(offer: offer),
                machine: bound.machine,
                candidates: standing,
                admission: FlexBidRefused { cause: FlexDecimalConversionRefused { conversion: c } },
                actuation: policy.actuation,
              }
            DecimalMoneyPerHourConverted { rate: _ } =>
              FlexShadowBidReceipt {
                offer_id: offer.id,
                offer_key: flex_vast_offer_key(offer: offer),
                machine: bound.machine,
                candidates: standing,
                admission: flex_bid_admission(
                  policy: policy,
                  occupancy: occupancy,
                  window: window,
                  account: account,
                  attempt: bound,
                ),
                actuation: policy.actuation,
              }
          }
      }
  }
}

type FlexCreateStanding
  = FlexCreateAnswered { instance_id: Int, machine_id: Int, ask_id: Int }
  | FlexCreateLost { ask_id: Int, machine_id: Int }
  | FlexCreateRefused { ask_id: Int, machine_id: Int }

type FlexReconcileVerdict
  = FlexAlreadyHeld { instance: VastAiInstance }
  | FlexAcquisitionUnknown
  | FlexMayAcquire
  | FlexReconcileNeedsExhaustedRoster

type FlexInstanceLookup
  = FlexLookupContractId { id: Int }
  | FlexLookupMachineId { machine_id: Int }

fn flex_find_instance(instances: List<VastAiInstance>, lookup: FlexInstanceLookup) -> VastAiInstance? {
  fold(
    instances,
    init: none,
    f: (acc, row) =>
      match acc {
        Present { value: found } => Present { value: found }
        Absent =>
          match lookup {
            FlexLookupContractId { id: id } =>
              if row.id == id { Present { value: row } } else { none }
            FlexLookupMachineId { machine_id: mid } =>
              if row.machine_id == mid { Present { value: row } } else { none }
          }
      },
  )
}

fn flex_instance_on_machine(instances: List<VastAiInstance>, machine_id: Int) -> VastAiInstance? {
  flex_find_instance(instances: instances, lookup: FlexLookupMachineId { machine_id: machine_id })
}

fn flex_reconcile_acquisition(
  standing: FlexCreateStanding,
  roster: FlexInstancesStanding,
) -> FlexReconcileVerdict {
  match roster {
    FlexInstancesUnreadable => FlexAcquisitionUnknown
    FlexInstancesUnobserved => FlexAcquisitionUnknown
    FlexInstancesPartial { next_token: _, observed: _, total: _ } => FlexReconcileNeedsExhaustedRoster
    FlexInstancesComplete { roster: complete } =>
      let instances = complete.instances
  // Answered create matches contract id only. Lost or refused may match the machine.
  match standing {
    FlexCreateAnswered { instance_id: id, machine_id: _, ask_id: _ } =>
      match flex_find_instance(instances: instances, lookup: FlexLookupContractId { id: id }) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexAcquisitionUnknown
      }
    FlexCreateLost { ask_id: _, machine_id: mid } =>
      match flex_instance_on_machine(instances: instances, machine_id: mid) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexAcquisitionUnknown
      }
    FlexCreateRefused { ask_id: _, machine_id: mid } =>
      match flex_instance_on_machine(instances: instances, machine_id: mid) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexMayAcquire
      }
  }
  }
}

type FlexPassRecord {
  roster: FlexInstancesStanding
  receipts: List<FlexShadowBidReceipt>
  cap: FlexCapAssessment
  write: FlexWriteDecision
}

fn flex_record_pass(
  policy: FlexPolicy,
  roster: FlexInstancesStanding,
  receipts: List<FlexShadowBidReceipt>,
) -> FlexPassRecord {
  FlexPassRecord {
    roster: roster,
    receipts: receipts,
    cap: flex_cap_from_roster(policy: policy, roster: roster),
    write: flex_write_decision(policy: policy, roster: roster),
  }
}

