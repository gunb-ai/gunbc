// Read-only Vast observation plus M0 admission recorded as a shadow receipt. No create or destroy
// operation is imported. Writes are gated on Wet AND a readable instance list AND not over cap;
// Wet still has no wired create.

data flex_search_offers_inhabitance_frontier: DissolutionCondition = unbound_dissolution(description: "DECLARED FRONTIER (DESIGN §3 pairing): an inhabitance claim that live vast_ai.SearchOffers Search emits VastAiOffer (ExactDecimal money, gpu_ram in MB), using flex_vast_api_read_grant on the Vast API key SecretRef. TRIGGER: that grant is issued and a wet readonly Search executes. SUFFICIENT FOR deleting this row once that claim is enrolled. NOT satisfied by supplied-value fixtures.")

data flex_m3_rent_cooldown_starts_at_ask: DissolutionCondition = unbound_dissolution(description: "M3: start the rent cooldown at ASK time, because a timed-out create may have rented. TRIGGER: the wet create loop records ask time as cooldown origin. SUFFICIENT FOR deleting this row.")

data flex_m3_pass_stops_at_first_failure: DissolutionCondition = unbound_dissolution(description: "M3: stop the observation/plan pass at the first failure so the next pass plans from what really happened. TRIGGER: the wet loop refuses to continue after the first typed failure. SUFFICIENT FOR deleting this row.")

data flex_wet_create_release_consumer_frontier: DissolutionCondition = unbound_dissolution(description: "M3 wet create/destroy loop consumes FlexCreateStanding, flex_reconcile_acquisition, flex_trial_total (reservation ceiling), flex_objective, and flex_delay_unvalued. TRIGGER: that loop is the remaining executing route if test.claim.fabric.flex_vast_shadow_witness is deleted. SUFFICIENT FOR deleting this row.")

data flex_rented_serving_allocation_join: DissolutionCondition = unbound_dissolution(description: "Wet create-answered constructs gunbc.serving.rented_allocation RentedServingAllocation keyed by rented_allocation_identity(provider: decl_ref(extdeps.cloud.vast_ai, extdeps_external_authority_anchor), contract: FlexCreateAnswered.instance_id) and hands enrollment via rented_allocation_enrollment. Origin is RentedAllocationAcquired (not yet on that module; today only RentedAllocationImported). Release and settlement standings are later slices keyed by RentedAllocationIdentity. TRIGGER: gunbc.serving.rented_allocation is on main, RentedAllocationAcquired exists, and the wet loop's remaining executing route for hold/enrollment is those two symbols. SUFFICIENT FOR deleting this row. NOT satisfied by FlexCreateStanding or flex_reconcile_acquisition. Release/settlement symbols are not this trigger.")

type FlexWriteDecision
  = FlexWriteHeldDry
  | FlexWriteBlockedUnreadable
  | FlexWriteBlockedPartialRoster
  | FlexWriteBlockedOverCap
  | FlexWriteWetUnwired

// Keyset pages: Partial still has a next_token. Exhausted is the only standing
// reconcile, confirmed-gone, cap, and wet write may consume.
type FlexInstancesStanding
  = FlexInstancesExhausted { instances: List<VastAiInstance>, total: Int }
  | FlexInstancesPartial { next_token: String, observed: List<VastAiInstance>, total: Int }
  | FlexInstancesUnreadable

type FlexChargesStanding
  = FlexChargesExhausted { results: List<VastAiCharge>, total: Int }
  | FlexChargesPartial { next_token: String, observed: List<VastAiCharge>, total: Int }
  | FlexChargesUnreadable

type FlexCapAssessment
  = FlexCapUnder { occupied: MoneyPerHour, cap: MoneyPerHour }
  | FlexCapAtLimit { occupied: MoneyPerHour, cap: MoneyPerHour }
  | FlexCapOver { occupied: MoneyPerHour, cap: MoneyPerHour }
  | FlexCapNeedsExhaustedRoster
  | FlexCapUnreadable
  | FlexCapRateUnconverted
  | FlexCapCurrencyMismatch

fn flex_instances_page(page: VastAiInstances) -> FlexInstancesStanding {
  match page.next_token {
    Present { value: tok } =>
      FlexInstancesPartial { next_token: tok, observed: page.instances, total: page.total_instances }
    Absent => FlexInstancesExhausted { instances: page.instances, total: page.total_instances }
  }
}

fn flex_charges_page(page: VastAiCharges) -> FlexChargesStanding {
  match page.next_token {
    Present { value: tok } =>
      FlexChargesPartial { next_token: tok, observed: page.results, total: page.total }
    Absent => FlexChargesExhausted { results: page.results, total: page.total }
  }
}

fn flex_instances_append(acc: FlexInstancesStanding, page: VastAiInstances) -> FlexInstancesStanding {
  match acc {
    FlexInstancesUnreadable => FlexInstancesUnreadable
    FlexInstancesPartial { next_token: _, observed: prior, total: _ } =>
      match flex_instances_page(page: page) {
        FlexInstancesUnreadable => FlexInstancesUnreadable
        FlexInstancesPartial { next_token: n, observed: more, total: t } =>
          FlexInstancesPartial { next_token: n, observed: concat(prior, more), total: t }
        FlexInstancesExhausted { instances: more, total: t } =>
          FlexInstancesExhausted { instances: concat(prior, more), total: t }
      }
    FlexInstancesExhausted { instances: prior, total: _ } =>
      match flex_instances_page(page: page) {
        FlexInstancesUnreadable => FlexInstancesUnreadable
        FlexInstancesPartial { next_token: n, observed: more, total: t } =>
          FlexInstancesPartial { next_token: n, observed: concat(prior, more), total: t }
        FlexInstancesExhausted { instances: more, total: t } =>
          FlexInstancesExhausted { instances: concat(prior, more), total: t }
      }
  }
}

fn flex_charges_append(acc: FlexChargesStanding, page: VastAiCharges) -> FlexChargesStanding {
  match acc {
    FlexChargesUnreadable => FlexChargesUnreadable
    FlexChargesPartial { next_token: _, observed: prior, total: _ } =>
      match flex_charges_page(page: page) {
        FlexChargesUnreadable => FlexChargesUnreadable
        FlexChargesPartial { next_token: n, observed: more, total: t } =>
          FlexChargesPartial { next_token: n, observed: concat(prior, more), total: t }
        FlexChargesExhausted { results: more, total: t } =>
          FlexChargesExhausted { results: concat(prior, more), total: t }
      }
    FlexChargesExhausted { results: prior, total: _ } =>
      match flex_charges_page(page: page) {
        FlexChargesUnreadable => FlexChargesUnreadable
        FlexChargesPartial { next_token: n, observed: more, total: t } =>
          FlexChargesPartial { next_token: n, observed: concat(prior, more), total: t }
        FlexChargesExhausted { results: more, total: t } =>
          FlexChargesExhausted { results: concat(prior, more), total: t }
      }
  }
}

fn flex_fold_instance_pages(pages: List<VastAiInstances>) -> FlexInstancesStanding {
  fold(
    pages,
    init: FlexInstancesExhausted { instances: [], total: 0 },
    f: (acc, page) => flex_instances_append(acc: acc, page: page),
  )
}

fn flex_fold_charge_pages(pages: List<VastAiCharges>) -> FlexChargesStanding {
  fold(
    pages,
    init: FlexChargesExhausted { results: [], total: 0 },
    f: (acc, page) => flex_charges_append(acc: acc, page: page),
  )
}

fn flex_instance_ours(instance: VastAiInstance, ours: FlexOwnerLabel) -> Bool {
  match instance.label {
    Absent => false
    Present { value: l } => l == (ours as String)
  }
}

type FlexLabelledStanding
  = FlexLabelledStandingBuilt { occupancy: FlexFleetOccupancy }
  | FlexLabelledRateUnconverted

fn flex_labelled_standing(
  instances: List<VastAiInstance>,
  ours: FlexOwnerLabel,
) -> FlexLabelledStanding {
  fold(
    instances,
    init: FlexLabelledStandingBuilt { occupancy: FlexFleetOccupancy { standing: [] } },
    f: (acc, row) =>
      match acc {
        FlexLabelledRateUnconverted => FlexLabelledRateUnconverted
        FlexLabelledStandingBuilt { occupancy: occ } =>
          if !flex_instance_ours(instance: row, ours: ours) {
            FlexLabelledStandingBuilt { occupancy: occ }
          } else {
            match vast_ai_instance_dph_total_money_per_hour(instance: row) {
              DecimalMoneyPerHourRefused { conversion: _ } => FlexLabelledRateUnconverted
              DecimalMoneyPerHourConverted { rate: rate } =>
                FlexLabelledStandingBuilt {
                  occupancy: FlexFleetOccupancy {
                    standing: concat(occ.standing, [AcquisitionActive { owner: ours, rate: rate }]),
                  },
                }
            }
          }
      },
  )
}

fn flex_cap_from_roster(policy: FlexPolicy, roster: FlexInstancesStanding) -> FlexCapAssessment {
  match roster {
    FlexInstancesUnreadable => FlexCapUnreadable
    FlexInstancesPartial { next_token: _, observed: _, total: _ } => FlexCapNeedsExhaustedRoster
    FlexInstancesExhausted { instances: rows, total: _ } =>
      match flex_labelled_standing(instances: rows, ours: policy.owner) {
        FlexLabelledRateUnconverted => FlexCapRateUnconverted
        FlexLabelledStandingBuilt { occupancy: occ } =>
          match occupancy_sum(occupancy: occ, currency: policy.fleet_rate_cap.currency, ours: policy.owner) {
            FlexOccupancyCurrencyMismatch { left: _, right: _ } => FlexCapCurrencyMismatch
            FlexOccupancySummed { rate: occupied } =>
              if !measure_le(a: occupied.amount, b: policy.fleet_rate_cap.amount) {
                FlexCapOver { occupied: occupied, cap: policy.fleet_rate_cap }
              } else {
                if money_per_hour_micros(q: occupied) == money_per_hour_micros(q: policy.fleet_rate_cap) {
                  FlexCapAtLimit { occupied: occupied, cap: policy.fleet_rate_cap }
                } else {
                  FlexCapUnder { occupied: occupied, cap: policy.fleet_rate_cap }
                }
              }
          }
      }
  }
}

fn flex_write_decision(policy: FlexPolicy, roster: FlexInstancesStanding) -> FlexWriteDecision {
  match policy.actuation {
    FlexActuationDry => FlexWriteHeldDry
    FlexActuationWet =>
      match flex_cap_from_roster(policy: policy, roster: roster) {
        FlexCapUnreadable => FlexWriteBlockedUnreadable
        FlexCapNeedsExhaustedRoster => FlexWriteBlockedPartialRoster
        FlexCapRateUnconverted => FlexWriteBlockedUnreadable
        FlexCapCurrencyMismatch => FlexWriteBlockedUnreadable
        FlexCapOver { occupied: _, cap: _ } => FlexWriteBlockedOverCap
        FlexCapAtLimit { occupied: _, cap: _ } => FlexWriteBlockedOverCap
        FlexCapUnder { occupied: _, cap: _ } => FlexWriteWetUnwired
      }
  }
}

fn flex_vast_api_read_grant(target: SecretRef) -> SecretAccessGrant {
  secret_accessor_grant(target: target)
}

// 1.34 USD/hr, deliberately distinct from ctrl's budget on the same Vast account.
data flex_trial_fleet_rate_cap: MoneyPerHour = MoneyPerHour {
  amount: money_amount_micro(count: 1340000),
  currency: Usd,
}

data flex_trial_total: MoneyAmountMicro = money_amount_micro(count: 50000000)

data flex_trial_policy: FlexPolicy = FlexPolicy {
  fleet_rate_cap: flex_trial_fleet_rate_cap,
  on_demand_fraction: NonzeroNatFraction { num: 1, denom_predecessor: 0 },
  acquisition_horizon: second(count: 3600),
  owner: flex_owner_label_gunbc_flex,
  actuation: FlexActuationDry,
}

data flex_delay_unvalued: MoneyPerSecond = MoneyRate {
  amount: money_amount_micro(count: 0),
  currency: Usd,
}

data flex_objective: DemandObjective = debt_payoff_objective

data flex_qwen_serving_image: NonEmptyStr = "vastai/vllm:v0.30.0-cuda-13.0"
data flex_qwen_published_tcp_port: Int = 8000
data flex_qwen_disk: ByteSize = gibibyte_to_byte_size(g: gibibyte(count: 32))
data flex_qwen_model_id: NonEmptyStr = "qwen"

type FlexServingTemplate {
  image: NonEmptyStr
  published_tcp_port: Int
  disk: ByteSize
  model_id: NonEmptyStr
}

data flex_qwen_serving_template: FlexServingTemplate = FlexServingTemplate {
  image: flex_qwen_serving_image,
  published_tcp_port: flex_qwen_published_tcp_port,
  disk: flex_qwen_disk,
  model_id: flex_qwen_model_id,
}

type FlexGpuClass {
  identity: NonEmptyStr
  gpu_name_contains: String?
  min_vram: ByteSize
}

data flex_gpu_class_rtx_5000_48gb: FlexGpuClass = FlexGpuClass {
  identity: "rtx-5000-class-48gb",
  gpu_name_contains: Present { value: "RTX 5000" },
  min_vram: mebibyte_to_byte_size(m: mebibyte(count: 49152)),
}

data flex_gpu_class_72gb: FlexGpuClass = FlexGpuClass {
  identity: "72gb-class",
  gpu_name_contains: none,
  min_vram: mebibyte_to_byte_size(m: mebibyte(count: 73728)),
}

data flex_gpu_class_rtx_pro_6000_96gb: FlexGpuClass = FlexGpuClass {
  identity: "rtx-pro-6000-blackwell-96gb",
  gpu_name_contains: Present { value: "RTX PRO 6000" },
  min_vram: mebibyte_to_byte_size(m: mebibyte(count: 98304)),
}

fn vast_gpu_ram_bytes(gpu_ram_mb: Int) -> ByteSize? {
  match checked_int_to_nat(n: gpu_ram_mb) {
    Absent => none
    Present { value: mb } => Present { value: mebibyte_to_byte_size(m: mebibyte(count: mb)) }
  }
}

fn flex_supported_gpu_classes() -> List<FlexGpuClass> {
  [flex_gpu_class_rtx_5000_48gb, flex_gpu_class_72gb, flex_gpu_class_rtx_pro_6000_96gb]
}

fn flex_gpu_name_matches(offer: VastAiOffer, needle: String?) -> Bool {
  match needle {
    Absent => true
    Present { value: n } => string_contains(s: offer.gpu_name, pattern: n)
  }
}

fn flex_gpu_class_matches(offer: VastAiOffer, class: FlexGpuClass) -> Bool {
  match vast_gpu_ram_bytes(gpu_ram_mb: offer.gpu_ram) {
    Absent => false
    Present { value: vram } =>
      flex_gpu_name_matches(offer: offer, needle: class.gpu_name_contains)
        && byte_size_count(b: vram) >= byte_size_count(b: class.min_vram)
  }
}

fn flex_offer_supported(offer: VastAiOffer) -> Bool {
  fold(
    flex_supported_gpu_classes(),
    init: false,
    f: (acc, class) => acc || flex_gpu_class_matches(offer: offer, class: class),
  )
}

fn flex_interruptible_rentable(offer: VastAiOffer) -> Bool {
  match offer.is_bid {
    Absent => false
    Present { value: bid } => bid && offer.rentable && !offer.rented
  }
}

fn flex_offer_in_shadow_field(offer: VastAiOffer) -> Bool {
  flex_interruptible_rentable(offer: offer)
    && flex_offer_supported(offer: offer)
    && flex_offer_meets_unit_driver(offer: offer, unit: Qwen3_8_27bOnNinfer)
}

data flex_search_type: String = vast_ai_search_type_bid
data flex_search_limit: Int = vast_ai_search_limit_default
data flex_keyset_page_limit: Int = vast_ai_keyset_page_limit

fn flex_machine_key(
  account: ProviderAccountObservationIdentity,
  machine: PhysicalMachineObservationIdentity,
) -> FlexMachineKey {
  FlexMachineKey {
    provider: decl_ref(module_path: "extdeps.cloud.vast_ai", decl_name: "extdeps_external_authority_anchor"),
    account: account,
    machine: machine,
  }
}

fn flex_machine_key_for_offer(
  account: ProviderAccountObservationIdentity,
  offer: VastAiOffer,
) -> FlexMachineKey {
  flex_machine_key(
    account: account,
    machine: int_to_decimal_string(value: offer.machine_id) as PhysicalMachineObservationIdentity,
  )
}

type FlexShadowBidReceipt {
  offer_id: Int
  offer_key: OfferKey
  machine: FlexMachineKey
  admission: FlexBidAdmission
  actuation: FlexActuationMode
}

fn flex_vast_offer_key(offer: VastAiOffer) -> OfferKey {
  int_to_decimal_string(value: offer.id) as OfferKey
}

// Search-offers does not carry start, transition, opportunity, readiness, a cited
// region, or a use permit. Those stay unestablished: this adapter never copies a
// caller CandidateOffer (id, shape, availability, consequences, evidence).
fn flex_candidates_from_vast_offer(
  offer: VastAiOffer,
  machine: FlexMachineKey,
) -> List<FlexScreenedCandidate<NonEmptyStr>> {
  []
}

fn flex_bind_attempt_to_offer(
  offer: VastAiOffer,
  attempt: FlexBidAttempt<NonEmptyStr>,
) -> FlexBidAttempt<NonEmptyStr> {
  let machine = flex_machine_key_for_offer(account: attempt.machine.account, offer: offer)
  FlexBidAttempt {
    machine: machine,
    min_bid: offer.min_bid,
    quote_currency: vast_ai_quote_currency,
    candidates: flex_candidates_from_vast_offer(offer: offer, machine: machine),
    subject: attempt.subject,
    on_demand_reference: attempt.on_demand_reference,
    requirements: attempt.requirements,
    reservation: attempt.reservation,
    generation: attempt.generation,
    delay_valuation: attempt.delay_valuation,
    tie: attempt.tie,
    affinity: attempt.affinity,
    market: attempt.market,
  }
}

fn flex_shadow_bid(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  offer: VastAiOffer,
  attempt: FlexBidAttempt<NonEmptyStr>,
) -> FlexShadowBidReceipt {
  let bound = flex_bind_attempt_to_offer(offer: offer, attempt: attempt)
  match vast_ai_min_bid_money_per_hour(offer: offer) {
    DecimalMoneyPerHourRefused { conversion: c } =>
      FlexShadowBidReceipt {
        offer_id: offer.id,
        offer_key: flex_vast_offer_key(offer: offer),
        machine: bound.machine,
        admission: FlexBidRefused { cause: FlexDecimalConversionRefused { conversion: c } },
        actuation: policy.actuation,
      }
    DecimalMoneyPerHourConverted { rate: _ } =>
      FlexShadowBidReceipt {
        offer_id: offer.id,
        offer_key: flex_vast_offer_key(offer: offer),
        machine: bound.machine,
        admission: flex_bid_admission(
          policy: policy,
          occupancy: occupancy,
          window: window,
          account: account,
          attempt: bound,
        ),
        actuation: policy.actuation,
      }
  }
}

type FlexCreateStanding
  = FlexCreateAnswered { instance_id: Int, machine_id: Int, ask_id: Int }
  | FlexCreateLost { ask_id: Int, machine_id: Int }
  | FlexCreateRefused { ask_id: Int, machine_id: Int }

type FlexReconcileVerdict
  = FlexAlreadyHeld { instance: VastAiInstance }
  | FlexAcquisitionUnknown
  | FlexMayAcquire
  | FlexReconcileNeedsExhaustedRoster

type FlexInstanceLookup
  = FlexLookupContractId { id: Int }
  | FlexLookupMachineId { machine_id: Int }

fn flex_find_instance(instances: List<VastAiInstance>, lookup: FlexInstanceLookup) -> VastAiInstance? {
  fold(
    instances,
    init: none,
    f: (acc, row) =>
      match acc {
        Present { value: found } => Present { value: found }
        Absent =>
          match lookup {
            FlexLookupContractId { id: id } =>
              if row.id == id { Present { value: row } } else { none }
            FlexLookupMachineId { machine_id: mid } =>
              if row.machine_id == mid { Present { value: row } } else { none }
          }
      },
  )
}

fn flex_instance_on_machine(instances: List<VastAiInstance>, machine_id: Int) -> VastAiInstance? {
  flex_find_instance(instances: instances, lookup: FlexLookupMachineId { machine_id: machine_id })
}

fn flex_reconcile_acquisition(
  standing: FlexCreateStanding,
  roster: FlexInstancesStanding,
) -> FlexReconcileVerdict {
  match roster {
    FlexInstancesUnreadable => FlexAcquisitionUnknown
    FlexInstancesPartial { next_token: _, observed: _, total: _ } => FlexReconcileNeedsExhaustedRoster
    FlexInstancesExhausted { instances: instances, total: _ } =>
  // Answered create matches contract id only. Lost or refused may match the machine.
  match standing {
    FlexCreateAnswered { instance_id: id, machine_id: _, ask_id: _ } =>
      match flex_find_instance(instances: instances, lookup: FlexLookupContractId { id: id }) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexAcquisitionUnknown
      }
    FlexCreateLost { ask_id: _, machine_id: mid } =>
      match flex_instance_on_machine(instances: instances, machine_id: mid) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexAcquisitionUnknown
      }
    FlexCreateRefused { ask_id: _, machine_id: mid } =>
      match flex_instance_on_machine(instances: instances, machine_id: mid) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexMayAcquire
      }
  }
  }
}

type FlexPassRecord {
  roster: FlexInstancesStanding
  receipts: List<FlexShadowBidReceipt>
  cap: FlexCapAssessment
  write: FlexWriteDecision
}

fn flex_record_pass(
  policy: FlexPolicy,
  roster: FlexInstancesStanding,
  receipts: List<FlexShadowBidReceipt>,
) -> FlexPassRecord {
  FlexPassRecord {
    roster: roster,
    receipts: receipts,
    cap: flex_cap_from_roster(policy: policy, roster: roster),
    write: flex_write_decision(policy: policy, roster: roster),
  }
}

