// Read-only Vast observation plus M0 admission recorded as a shadow receipt. No create or destroy
// operation is imported. Writes are gated on Wet AND a readable instance list AND not over cap;
// Wet still has no wired create.

data flex_search_offers_inhabitance_frontier: DissolutionCondition = unbound_dissolution(description: "DECLARED FRONTIER (DESIGN §3 pairing): an inhabitance claim that live vast_ai.SearchOffers Search emits VastAiOffer (ExactDecimal money, gpu_ram in MB). TRIGGER: the Vast API key SecretRef is granted through gunbc.auth.gcp_secret_access and a wet readonly Search executes. SUFFICIENT FOR deleting this row once that claim is enrolled. NOT satisfied by supplied-value fixtures.")

data flex_m3_rent_cooldown_starts_at_ask: DissolutionCondition = unbound_dissolution(description: "M3: start the rent cooldown at ASK time, because a timed-out create may have rented. TRIGGER: the wet create loop records ask time as cooldown origin. SUFFICIENT FOR deleting this row.")

data flex_m3_pass_stops_at_first_failure: DissolutionCondition = unbound_dissolution(description: "M3: stop the observation/plan pass at the first failure so the next pass plans from what really happened. TRIGGER: the wet loop refuses to continue after the first typed failure. SUFFICIENT FOR deleting this row.")

data flex_qwen_probe_harness_placement_frontier: DissolutionCondition = unbound_dissolution(description: "M3: wire flex_rented_card_fungible into gunbc.harness.harness_requirement_placement. TRIGGER: placement refuses a rented card whose probe is not FlexQwenProbeConfirmed with qwen3 / qwen3_coder. SUFFICIENT FOR deleting this row. NOT satisfied by declaring the requirement here.")

type FlexWriteDecision
  = FlexWriteHeldDry
  | FlexWriteBlockedUnreadable
  | FlexWriteBlockedOverCap
  | FlexWriteWetUnwired

type FlexInstanceListStanding
  = FlexInstanceListRead { instances: List<VastAiInstance> }
  | FlexInstanceListUnreadable

fn flex_write_decision(
  policy: FlexPolicy,
  instances: FlexInstanceListStanding,
  over_cap: Bool,
) -> FlexWriteDecision {
  match flex_policy_actuation(policy: policy) {
    FlexActuationDry => FlexWriteHeldDry
    FlexActuationWet =>
      match instances {
        FlexInstanceListUnreadable => FlexWriteBlockedUnreadable
        FlexInstanceListRead { instances: _ } =>
          if over_cap { FlexWriteBlockedOverCap } else { FlexWriteWetUnwired }
      }
  }
}

fn flex_vast_api_read_grant(target: SecretRef) -> SecretAccessGrant {
  secret_accessor_grant(target: target)
}

data flex_trial_fleet_rate_cap: MoneyPerHour = MoneyPerHour {
  amount: money_amount_micro(count: 1500000),
  currency: Usd,
}

data flex_trial_total: MoneyAmountMicro = money_amount_micro(count: 50000000)

data flex_trial_policy: FlexPolicy = FlexPolicy {
  fleet_rate_cap: flex_trial_fleet_rate_cap,
  floor_buffer: flex_floor_buffer,
  on_demand_fraction: NonzeroNatFraction { num: 1, denom_predecessor: 0 },
  acquisition_horizon: second(count: 3600),
  live: false,
}

data flex_delay_unvalued: MoneyPerSecond = MoneyRate {
  amount: money_amount_micro(count: 0),
  currency: Usd,
}

data flex_objective: DemandObjective = debt_payoff_objective

data flex_qwen_serving_image: NonEmptyStr = "vastai/vllm:v0.30.0-cuda-13.0"
data flex_qwen_published_tcp_port: Int = 8000
data flex_qwen_disk_gb: Int = 32
data flex_qwen_model_id: NonEmptyStr = "qwen"
data flex_qwen_reasoning_parser: NonEmptyStr = "qwen3"
data flex_qwen_tool_call_parser: NonEmptyStr = "qwen3_coder"

type FlexQwenProbeStanding
  = FlexQwenProbeConfirmed { reasoning_parser: NonEmptyStr, tool_call_parser: NonEmptyStr }
  | FlexQwenProbeUnconfirmed

fn flex_rented_card_fungible(probe: FlexQwenProbeStanding) -> Bool {
  match probe {
    FlexQwenProbeUnconfirmed => false
    FlexQwenProbeConfirmed { reasoning_parser: r, tool_call_parser: t } =>
      r == flex_qwen_reasoning_parser && t == flex_qwen_tool_call_parser
  }
}

type FlexServingTemplate {
  image: NonEmptyStr
  published_tcp_port: Int
  disk_gb: Int
  model_id: NonEmptyStr
}

data flex_qwen_serving_template: FlexServingTemplate = FlexServingTemplate {
  image: flex_qwen_serving_image,
  published_tcp_port: flex_qwen_published_tcp_port,
  disk_gb: flex_qwen_disk_gb,
  model_id: flex_qwen_model_id,
}

type FlexEngineRuntime
  = FlexNinfer
  | FlexVllm

data flex_ninfer_min_driver: Int = 580
data flex_vllm_min_driver: Int = 590

fn flex_engine_min_driver(engine: FlexEngineRuntime) -> Int {
  match engine {
    FlexNinfer => flex_ninfer_min_driver
    FlexVllm => flex_vllm_min_driver
  }
}

data flex_host_driver_unread_obligation: NonEmptyStr = "Vast search-offers as modeled carries no host driver version, so ninfer >= 580 and vLLM >= 590 cannot be decided from an offer. Read the host driver before a wet create."

type FlexGpuClass {
  identity: NonEmptyStr
  gpu_name_contains: String?
  min_vram_mb: Int
}

data flex_gpu_class_rtx_5000_48gb: FlexGpuClass = FlexGpuClass {
  identity: "rtx-5000-class-48gb",
  gpu_name_contains: Present { value: "RTX 5000" },
  min_vram_mb: 49152,
}

data flex_gpu_class_72gb: FlexGpuClass = FlexGpuClass {
  identity: "72gb-class",
  gpu_name_contains: none,
  min_vram_mb: 73728,
}

data flex_gpu_class_rtx_pro_6000_96gb: FlexGpuClass = FlexGpuClass {
  identity: "rtx-pro-6000-blackwell-96gb",
  gpu_name_contains: Present { value: "RTX PRO 6000" },
  min_vram_mb: 98304,
}

fn flex_supported_gpu_classes() -> List<FlexGpuClass> {
  [flex_gpu_class_rtx_5000_48gb, flex_gpu_class_72gb, flex_gpu_class_rtx_pro_6000_96gb]
}

fn flex_gpu_name_matches(offer: VastAiOffer, needle: String?) -> Bool {
  match needle {
    Absent => true
    Present { value: n } => string_contains(s: offer.gpu_name, pattern: n)
  }
}

fn flex_gpu_class_matches(offer: VastAiOffer, class: FlexGpuClass) -> Bool {
  flex_gpu_name_matches(offer: offer, needle: class.gpu_name_contains) && offer.gpu_ram >= class.min_vram_mb
}

fn flex_offer_supported(offer: VastAiOffer) -> Bool {
  fold(
    flex_supported_gpu_classes(),
    init: false,
    f: (acc, class) => acc || flex_gpu_class_matches(offer: offer, class: class),
  )
}

fn flex_interruptible_rentable(offer: VastAiOffer) -> Bool {
  match offer.is_bid {
    Absent => false
    Present { value: bid } => bid && offer.rentable && !offer.rented
  }
}

fn flex_offer_in_shadow_field(offer: VastAiOffer) -> Bool {
  flex_interruptible_rentable(offer: offer) && flex_offer_supported(offer: offer)
}

data flex_search_type: String = vast_ai_search_type_bid
data flex_search_limit: Int = vast_ai_search_limit_default

fn flex_machine_key(
  account: ProviderAccountObservationIdentity,
  machine: PhysicalMachineObservationIdentity,
) -> FlexMachineKey {
  FlexMachineKey {
    provider: decl_ref(module_path: "extdeps.cloud.vast_ai", decl_name: "extdeps_external_authority_anchor"),
    account: account,
    machine: machine,
  }
}

fn flex_machine_key_for_offer(
  account: ProviderAccountObservationIdentity,
  offer: VastAiOffer,
) -> FlexMachineKey {
  flex_machine_key(
    account: account,
    machine: int_to_decimal_string(value: offer.machine_id) as PhysicalMachineObservationIdentity,
  )
}

type FlexShadowBidReceipt {
  offer_id: Int
  machine: FlexMachineKey
  admission: FlexBidAdmission
  actuation: FlexActuationMode
}

fn flex_shadow_bid(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  attempt: FlexBidAttempt<NonEmptyStr>,
  offer_id: Int,
) -> FlexShadowBidReceipt {
  FlexShadowBidReceipt {
    offer_id: offer_id,
    machine: attempt.machine,
    admission: flex_bid_admission(
      policy: policy,
      occupancy: occupancy,
      window: window,
      account: account,
      attempt: attempt,
    ),
    actuation: flex_policy_actuation(policy: policy),
  }
}

fn flex_shadow_records_admission(receipt: FlexShadowBidReceipt) -> Bool {
  match receipt.admission {
    FlexBidAdmitted { bid: _, selection: _, account: _, occupancy: _, window: _ } => true
    FlexBidUnchanged { bid: _, account: _, occupancy: _, window: _ } => true
    FlexBidRefused { cause: _ } => true
  }
}

type FlexCreateStanding
  = FlexCreateAnswered { instance_id: Int, machine_id: Int }
  | FlexCreateLost { ask_id: Int, machine_id: Int }
  | FlexCreateRefused { ask_id: Int, machine_id: Int }

type FlexReconcileVerdict
  = FlexAlreadyHeld { instance: VastAiInstance }
  | FlexAcquisitionUnknown
  | FlexMayAcquire

fn flex_instance_on_machine(instances: List<VastAiInstance>, machine_id: Int) -> VastAiInstance? {
  fold(
    instances,
    init: none,
    f: (acc, row) =>
      match acc {
        Present { value: found } => Present { value: found }
        Absent => if row.machine_id == machine_id { Present { value: row } } else { none }
      },
  )
}

fn flex_reconcile_acquisition(
  standing: FlexCreateStanding,
  instances: List<VastAiInstance>,
) -> FlexReconcileVerdict {
  match standing {
    FlexCreateAnswered { instance_id: id, machine_id: mid } =>
      match fold(
        instances,
        init: none,
        f: (acc, row) =>
          match acc {
            Present { value: found } => Present { value: found }
            Absent => if row.id == id || row.machine_id == mid { Present { value: row } } else { none }
          },
      ) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexAcquisitionUnknown
      }
    FlexCreateLost { ask_id: _, machine_id: mid } =>
      match flex_instance_on_machine(instances: instances, machine_id: mid) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexAcquisitionUnknown
      }
    FlexCreateRefused { ask_id: _, machine_id: mid } =>
      match flex_instance_on_machine(instances: instances, machine_id: mid) {
        Present { value: inst } => FlexAlreadyHeld { instance: inst }
        Absent => FlexMayAcquire
      }
  }
}

fn flex_may_acquire(verdict: FlexReconcileVerdict) -> Bool {
  match verdict {
    FlexMayAcquire => true
    FlexAlreadyHeld { instance: _ } => false
    FlexAcquisitionUnknown => false
  }
}

type FlexRentalReadback
  = FlexRentalPending { ask_id: Int, machine_id: Int }
  | FlexRentalHeld { instance: VastAiInstance }
  | FlexRentalGone
  | FlexRentalUnknown

type FlexReleaseStanding
  = FlexReleaseRequested { instance_id: Int }
  | FlexReleaseLost { instance_id: Int }

type FlexReleaseReadback
  = FlexReleasePending { instance_id: Int }
  | FlexReleaseConfirmedGone
  | FlexReleaseUnknown

fn flex_release_readback(
  standing: FlexReleaseStanding,
  instances: FlexInstanceListStanding,
) -> FlexReleaseReadback {
  match instances {
    FlexInstanceListUnreadable => FlexReleaseUnknown
    FlexInstanceListRead { instances: rows } => {
      let id = match standing {
        FlexReleaseRequested { instance_id: i } => i
        FlexReleaseLost { instance_id: i } => i
      }
      match fold(
        rows,
        init: none,
        f: (acc, row) =>
          match acc {
            Present { value: found } => Present { value: found }
            Absent => if row.id == id { Present { value: row } } else { none }
          },
      ) {
        Present { value: _ } => FlexReleasePending { instance_id: id }
        Absent => FlexReleaseConfirmedGone
      }
    }
  }
}

fn flex_demand_exceeds_share(live_sessions: Nat, share: Nat) -> Bool {
  live_sessions > share
}

type FlexPassRecord {
  instances: FlexInstanceListStanding
  receipts: List<FlexShadowBidReceipt>
  over_cap: Bool
  write: FlexWriteDecision
}

fn flex_record_pass(
  policy: FlexPolicy,
  instances: FlexInstanceListStanding,
  receipts: List<FlexShadowBidReceipt>,
  over_cap: Bool,
) -> FlexPassRecord {
  FlexPassRecord {
    instances: instances,
    receipts: receipts,
    over_cap: over_cap,
    write: flex_write_decision(policy: policy, instances: instances, over_cap: over_cap),
  }
}

fn flex_rental_readback(
  standing: FlexCreateStanding,
  instances: List<VastAiInstance>,
  bound_expired: Bool,
) -> FlexRentalReadback {
  match flex_reconcile_acquisition(standing: standing, instances: instances) {
    FlexAlreadyHeld { instance: inst } => FlexRentalHeld { instance: inst }
    FlexMayAcquire => FlexRentalGone
    FlexAcquisitionUnknown =>
      if bound_expired {
        FlexRentalUnknown
      } else {
        match standing {
          FlexCreateLost { ask_id: a, machine_id: m } => FlexRentalPending { ask_id: a, machine_id: m }
          FlexCreateAnswered { instance_id: _, machine_id: m } =>
            FlexRentalPending { ask_id: 0, machine_id: m }
          FlexCreateRefused { ask_id: _, machine_id: _ } => FlexRentalGone
        }
      }
  }
}
