module product.fabric.flex_policy

import std.types { NonEmptyStr, Bool, Int, List, brand }
import std.nat { Nat, Zero, Succ }
import std.rational { NonzeroNatFraction, nonzero_nat_fraction_field }
import std.decl_ref { DeclarationRef }
import std.decimal { ExactDecimal }
import std.measure {
  MoneyAmountMicro, MoneyPerHour, MoneyPerSecond,
  money_amount_micro, money_amount_micro_count, money_per_hour_micros,
  measure_scale_fraction_ceil, Second, second_count,
  DecimalMoneyConversion, DecimalMoneyPerHourConverted, DecimalMoneyPerHourRefused,
  exact_decimal_to_money_per_hour_ceil,
}
import extdeps.currency.currency { CurrencyCode }
import product.fabric.identity { fabric_identity_eq }
import product.fabric.work { ExecutionRequirements }
import product.fabric.supply {
  EqualCostOfferTieBreak, PlacementAffinityKey, GrantDuration, ExactGrantDuration,
  seconds_per_hour, SupplierOffer, QuotedPerHour,
}
import product.fabric.execution { ReservationRef }
import product.fabric.budget {
  MoneyAccount, MoneyReservationRequest, AccountAdvanced, MoneyRefused,
  MoneyRefusal, reserve_money,
}
import product.fabric.selection {
  CandidateOffer, DispatchInputs, SupplySelection, OfferSelected, NoAdmissibleOffer, EqualCostTieUnresolved,
  AvailabilityObservation, AvailableRevocable, AvailableForInterval, AvailableIndefinitely,
  AvailabilityUnobserved, SelectedOffer, select_supply, price_over_horizon,
  OfferCandidacy, OfferPriced, OfferNotPriceable, OfferNotFungible, OfferUnavailableForGrant,
  OfferCannotHoldAnUnboundedGrant, OfferWrongCurrency, OfferUnaffordable,
  OfferLiabilityOverBuyOrder, OfferRevocationNotAdmitted, selection_liability,
}

// Fleet interruptible-bid policy. In this change the executing consumer of flex_bid_admission is
// the witness. DECLARED FRONTIER (DESIGN §3c): the production consumer is the fold that maps a
// Vast SearchOffers row through vast_ai_min_bid_money_per_hour into FlexBidAttempt (quote_currency
// = vast_ai_quote_currency) and calls flex_bid_admission. TRIGGER: that adapter exists as a
// production module (not a test) and deleting the witness still leaves an execution of the real
// path. Until then this slice is M0 model-only: no effects, no search, no bid PUT.

data flex_floor_buffer: NonzeroNatFraction = NonzeroNatFraction { num: 1, denom_predecessor: 9 }

type PhysicalMachineObservationIdentity = NonEmptyStr where brand("PhysicalMachineObservationIdentity")

type ProviderAccountObservationIdentity = NonEmptyStr where brand("ProviderAccountObservationIdentity")

type FlexMachineKey {
  provider: DeclarationRef
  account: ProviderAccountObservationIdentity
  machine: PhysicalMachineObservationIdentity
}

fn flex_machine_key_eq(left: FlexMachineKey, right: FlexMachineKey) -> Bool {
  left.provider == right.provider && left.account == right.account && left.machine == right.machine
}

// Standing rates that count against fleet_rate_cap. The cap is an aggregate: every
// Active, Pending, AutoResumable and UnknownOutcome rate plus the proposed bid.
// A machine-keyed retained ceiling is deleted: it made a previously owned card
// special and paid more for an equivalent replacement.
type FlexAcquisitionStanding
  = AcquisitionActive { rate: MoneyPerHour }
  | AcquisitionPending { rate: MoneyPerHour }
  | AcquisitionAutoResumable { rate: MoneyPerHour }
  | AcquisitionUnknownOutcome { rate: MoneyPerHour }

type FlexFleetOccupancy {
  standing: List<FlexAcquisitionStanding>
}

type FlexBidSubject
  = FlexNewAcquisition
  | FlexExistingAcquisition { current_bid: MoneyPerHour }

type FlexPolicy {
  fleet_rate_cap: MoneyPerHour
  floor_buffer: NonzeroNatFraction
  // Fraction of comparable on-demand horizon cost (setup and transfer included).
  // Not a mix of on-demand vs interruptible headcount.
  on_demand_fraction: NonzeroNatFraction
  acquisition_horizon: Second
}

type FlexAcquisitionWindow {
  remaining: Nat
}

// Comparable on-demand supply for the same work. Missing or stale refuses admission;
// it is never treated as free or as the fleet cap.
type FlexOnDemandReference<P>
  = FlexOnDemandReferenceFresh { candidate: CandidateOffer<P> }
  | FlexOnDemandReferenceStale { candidate: CandidateOffer<P> }
  | FlexOnDemandReferenceMissing

// min_bid is the wire ExactDecimal. quote_currency is the currency the wire is in (Vast:
// vast_ai_quote_currency). Admission converts with exact_decimal_to_money_per_hour_ceil using
// that currency, never the fleet cap's — stamping the cap would make FlexCurrencyMismatch
// unfirable. On-demand vs interruptible is the selected candidate's AvailabilityObservation,
// not a field here. Each candidate is tagged with the physical machine it is; admission
// refuses unless every tag equals attempt.machine, so cash cannot be reserved against B
// while the attempt names A. Machine identity does not retain a bid ceiling.
type FlexScreenedCandidate<P> {
  machine: FlexMachineKey
  candidate: CandidateOffer<P>
}

type FlexBidAttempt<P> {
  machine: FlexMachineKey
  min_bid: ExactDecimal
  quote_currency: CurrencyCode
  candidates: List<FlexScreenedCandidate<P>>
  subject: FlexBidSubject
  on_demand_reference: FlexOnDemandReference<P>
  requirements: ExecutionRequirements
  reservation: ReservationRef
  generation: Int
  delay_valuation: MoneyPerSecond
  tie: EqualCostOfferTieBreak
  affinity: PlacementAffinityKey
}

type FlexBidRefusal
  = FlexNoAcquisitionRemaining
  | FlexOnDemandReferenceUnobserved
  | FlexOnDemandReferenceCandidacyRefused { candidacy: OfferCandidacy<NonEmptyStr> }
  | FlexReservedBidCandidacyRefused { candidacy: OfferCandidacy<NonEmptyStr> }
  | FlexTargetNotRevocable
  | FlexTargetAvailabilityUnobserved
  | FlexOnDemandRelativeCeilingExceeded { ceiling: MoneyAmountMicro, projected: MoneyAmountMicro }
  | FlexCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }
  | FlexDecimalConversionRefused { conversion: DecimalMoneyConversion }
  | FlexRateCapBelowMin { cap: MoneyPerHour, min_bid: MoneyPerHour }
  | FlexRateCapOccupied { cap: MoneyPerHour, occupied: MoneyPerHour, proposed: MoneyPerHour }
  | FlexExistingBidWouldRise { current: MoneyPerHour, min_bid: MoneyPerHour }
  | FlexSupplyNotSelected { selection: SupplySelection<NonEmptyStr> }
  | FlexCandidateMachineMismatch { named: FlexMachineKey, observed: FlexMachineKey }
  | FlexMoneyRefused { refusal: MoneyRefusal }

type FlexCandidateJoin<P>
  = FlexCandidatesJoined { candidates: List<CandidateOffer<P>> }
  | FlexCandidateJoinMismatch { named: FlexMachineKey, observed: FlexMachineKey }

type FlexBidAdmission
  = FlexBidAdmitted {
      bid: MoneyPerHour
      selection: SupplySelection<NonEmptyStr>
      account: MoneyAccount
      occupancy: FlexFleetOccupancy
      window: FlexAcquisitionWindow
    }
  | FlexBidUnchanged {
      bid: MoneyPerHour
      account: MoneyAccount
      occupancy: FlexFleetOccupancy
      window: FlexAcquisitionWindow
    }
  | FlexBidRefused { cause: FlexBidRefusal }

type MoneyPerHourComparison
  = MoneyPerHourCompared { left_le_right: Bool }
  | MoneyPerHourCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }

fn money_per_hour_compare(left: MoneyPerHour, right: MoneyPerHour) -> MoneyPerHourComparison {
  if left.currency != right.currency {
    MoneyPerHourCurrencyMismatch { left: left.currency, right: right.currency }
  } else {
    MoneyPerHourCompared { left_le_right: money_per_hour_micros(q: left) <= money_per_hour_micros(q: right) }
  }
}

fn flex_horizon_duration(policy: FlexPolicy) -> GrantDuration {
  ExactGrantDuration { seconds: policy.acquisition_horizon }
}

fn flex_buffered_min(min_bid: MoneyPerHour, buffer: NonzeroNatFraction) -> MoneyPerHour {
  let frac = nonzero_nat_fraction_field(r: buffer)
  MoneyPerHour {
    amount: measure_scale_fraction_ceil(
      m: min_bid.amount,
      num: frac.denom + frac.num,
      den: frac.denom,
    ),
    currency: min_bid.currency,
  }
}

fn standing_rate(row: FlexAcquisitionStanding) -> MoneyPerHour {
  match row {
    AcquisitionActive { rate: r } => r
    AcquisitionPending { rate: r } => r
    AcquisitionAutoResumable { rate: r } => r
    AcquisitionUnknownOutcome { rate: r } => r
  }
}

type FlexOccupancySum
  = FlexOccupancySummed { micros: Nat, currency: CurrencyCode }
  | FlexOccupancyCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }

fn occupancy_sum(occupancy: FlexFleetOccupancy, currency: CurrencyCode) -> FlexOccupancySum {
  fold(occupancy.standing, init: FlexOccupancySummed { micros: 0, currency: currency }, f: (acc, row) =>
    match acc {
      FlexOccupancyCurrencyMismatch { left: l, right: r } =>
        FlexOccupancyCurrencyMismatch { left: l, right: r }
      FlexOccupancySummed { micros: n, currency: c } => {
        let rate = standing_rate(row: row)
        if rate.currency != c {
          FlexOccupancyCurrencyMismatch { left: c, right: rate.currency }
        } else {
          FlexOccupancySummed { micros: n + money_per_hour_micros(q: rate), currency: c }
        }
      }
    })
}

fn occupy_pending(occupancy: FlexFleetOccupancy, bid: MoneyPerHour) -> FlexFleetOccupancy {
  FlexFleetOccupancy {
    standing: concat([AcquisitionPending { rate: bid }], occupancy.standing),
  }
}

type FlexReservationCeiling
  = FlexReservationCeilingChosen { rate: MoneyPerHour }
  | FlexReservationCeilingCurrencyMismatch { left: CurrencyCode, right: CurrencyCode }

fn policy_reservation_ceiling(policy: FlexPolicy, min_bid: MoneyPerHour) -> FlexReservationCeiling {
  let buffered = flex_buffered_min(min_bid: min_bid, buffer: policy.floor_buffer)
  match money_per_hour_compare(left: buffered, right: policy.fleet_rate_cap) {
    MoneyPerHourCurrencyMismatch { left: cap_left, right: cap_right } =>
      FlexReservationCeilingCurrencyMismatch { left: cap_left, right: cap_right }
    MoneyPerHourCompared { left_le_right: buffered_under_cap } =>
      FlexReservationCeilingChosen {
        rate: if buffered_under_cap { buffered } else { policy.fleet_rate_cap },
      }
  }
}

fn flex_liability_for_horizon(rate: MoneyPerHour, horizon: Second) -> MoneyAmountMicro {
  measure_scale_fraction_ceil(
    m: rate.amount,
    num: second_count(s: horizon),
    den: seconds_per_hour(),
  )
}

type FlexAvailabilityStanding
  = FlexAvailabilityOnDemand
  | FlexAvailabilityRevocable
  | FlexAvailabilityUnobserved

fn flex_availability_standing(a: AvailabilityObservation) -> FlexAvailabilityStanding {
  match a {
    AvailableRevocable { delay: _, receipt: _ } => FlexAvailabilityRevocable
    AvailableForInterval { delay: _, interval: _, receipt: _ } => FlexAvailabilityOnDemand
    AvailableIndefinitely { delay: _, receipt: _ } => FlexAvailabilityOnDemand
    AvailabilityUnobserved { obligation: _ } => FlexAvailabilityUnobserved
  }
}

fn advance_window(window: FlexAcquisitionWindow) -> FlexAcquisitionWindow {
  FlexAcquisitionWindow {
    remaining: match window.remaining {
      Zero => Zero
      Succ { prev: p } => p
    },
  }
}

type FlexPricedHorizon
  = FlexHorizonPriced { cost: MoneyAmountMicro }
  | FlexHorizonUnobserved
  | FlexHorizonRefused { candidacy: OfferCandidacy<NonEmptyStr> }

fn offer_quoted_at(offer: SupplierOffer<NonEmptyStr>, rate: MoneyPerHour) -> SupplierOffer<NonEmptyStr> {
  SupplierOffer {
    id: offer.id,
    executor: offer.executor,
    route: offer.route,
    shape: offer.shape,
    capabilities: offer.capabilities,
    trust_domain: offer.trust_domain,
    isolation: offer.isolation,
    quantity_bound: offer.quantity_bound,
    ready_at: offer.ready_at,
    quote: QuotedPerHour(rate),
    billing_quantum: offer.billing_quantum,
    evidence: offer.evidence,
  }
}

fn flex_price_offer(
  offer: SupplierOffer<NonEmptyStr>,
  inputs: DispatchInputs<NonEmptyStr>,
  policy: FlexPolicy,
  attempt: FlexBidAttempt<NonEmptyStr>,
  budget_currency: CurrencyCode,
  maximum_buy_order: MoneyAmountMicro,
) -> FlexPricedHorizon {
  let candidacy = price_over_horizon(
    offer: offer,
    inputs: inputs,
    requirements: attempt.requirements,
    duration: flex_horizon_duration(policy: policy),
    maximum_buy_order: maximum_buy_order,
    budget_currency: budget_currency,
    delay_valuation: attempt.delay_valuation,
  )
  match candidacy {
    OfferPriced { offer: _, cost: c, basis: _, horizon: _ } =>
      FlexHorizonPriced { cost: selection_liability(c: c) }
    OfferLiabilityOverBuyOrder { offer: _, liability: observed, maximum: _ } =>
      FlexHorizonPriced { cost: observed }
    OfferNotPriceable { offer: _, unpriced: _ } => FlexHorizonRefused { candidacy: candidacy }
    OfferNotFungible { offer: _, fungibility: _ } => FlexHorizonRefused { candidacy: candidacy }
    OfferUnavailableForGrant { offer: _, needed: _, available: _ } => FlexHorizonRefused { candidacy: candidacy }
    OfferCannotHoldAnUnboundedGrant { offer: _, available: _ } => FlexHorizonRefused { candidacy: candidacy }
    OfferWrongCurrency { offer: _, mismatch: _ } => FlexHorizonRefused { candidacy: candidacy }
    OfferUnaffordable { offer: _, affordability: _ } => FlexHorizonRefused { candidacy: candidacy }
    OfferRevocationNotAdmitted { offer: _ } => FlexHorizonRefused { candidacy: candidacy }
  }
}

fn flex_on_demand_reference_cost(
  policy: FlexPolicy,
  attempt: FlexBidAttempt<NonEmptyStr>,
  budget_currency: CurrencyCode,
  maximum_buy_order: MoneyAmountMicro,
) -> FlexPricedHorizon {
  match attempt.on_demand_reference {
    FlexOnDemandReferenceMissing => FlexHorizonUnobserved
    FlexOnDemandReferenceStale { candidate: _ } => FlexHorizonUnobserved
    FlexOnDemandReferenceFresh { candidate: c } =>
      match flex_availability_standing(a: c.dispatch.availability) {
        FlexAvailabilityUnobserved => FlexHorizonUnobserved
        FlexAvailabilityRevocable => FlexHorizonUnobserved
        FlexAvailabilityOnDemand =>
          flex_price_offer(
            offer: c.offer,
            inputs: c.dispatch,
            policy: policy,
            attempt: attempt,
            budget_currency: budget_currency,
            maximum_buy_order: maximum_buy_order,
          )
      }
  }
}

fn flex_relative_ceiling(policy: FlexPolicy, on_demand_cost: MoneyAmountMicro) -> MoneyAmountMicro {
  let frac = nonzero_nat_fraction_field(r: policy.on_demand_fraction)
  measure_scale_fraction_ceil(m: on_demand_cost, num: frac.num, den: frac.denom)
}

fn refuse_currency(left: CurrencyCode, right: CurrencyCode) -> FlexBidAdmission {
  FlexBidRefused { cause: FlexCurrencyMismatch { left: left, right: right } }
}

fn join_attempt_candidates<P>(attempt: FlexBidAttempt<P>) -> FlexCandidateJoin<P> {
  match fold(attempt.candidates, init: FlexCandidatesJoined { candidates: [] }, f: (acc, row) =>
    match acc {
      FlexCandidateJoinMismatch { named: n, observed: o } =>
        FlexCandidateJoinMismatch { named: n, observed: o }
      FlexCandidatesJoined { candidates: acc_cs } =>
        if flex_machine_key_eq(left: row.machine, right: attempt.machine) {
          FlexCandidatesJoined { candidates: concat([row.candidate], acc_cs) }
        } else {
          FlexCandidateJoinMismatch { named: attempt.machine, observed: row.machine }
        }
    }) {
    FlexCandidateJoinMismatch { named: n, observed: o } =>
      FlexCandidateJoinMismatch { named: n, observed: o }
    FlexCandidatesJoined { candidates: acc_cs } =>
      FlexCandidatesJoined { candidates: reverse(acc_cs) }
  }
}

fn selection_names_joined_offer<P>(selected: SelectedOffer<P>, joined: List<CandidateOffer<P>>) -> Bool {
  fold(joined, init: false, f: (acc, c) =>
    acc || fabric_identity_eq(left: selected.candidate.offer.id, right: c.offer.id))
}

fn flex_bid_admission(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  attempt: FlexBidAttempt<NonEmptyStr>,
) -> FlexBidAdmission {
  if window.remaining == 0 {
    FlexBidRefused { cause: FlexNoAcquisitionRemaining }
  } else if account.currency != policy.fleet_rate_cap.currency {
    refuse_currency(left: account.currency, right: policy.fleet_rate_cap.currency)
  } else {
    match join_attempt_candidates(attempt: attempt) {
      FlexCandidateJoinMismatch { named: n, observed: o } =>
        FlexBidRefused { cause: FlexCandidateMachineMismatch { named: n, observed: o } }
      FlexCandidatesJoined { candidates: joined } =>
        match exact_decimal_to_money_per_hour_ceil(d: attempt.min_bid, currency: attempt.quote_currency) {
          DecimalMoneyPerHourRefused { conversion: c } =>
            FlexBidRefused { cause: FlexDecimalConversionRefused { conversion: c } }
          DecimalMoneyPerHourConverted { rate: min_rate } =>
            flex_bid_after_min(
              policy: policy,
              occupancy: occupancy,
              window: window,
              account: account,
              attempt: attempt,
              min_rate: min_rate,
              joined: joined,
            )
        }
    }
  }
}

fn flex_bid_after_min(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  attempt: FlexBidAttempt<NonEmptyStr>,
  min_rate: MoneyPerHour,
  joined: List<CandidateOffer<NonEmptyStr>>,
) -> FlexBidAdmission {
  match money_per_hour_compare(left: min_rate, right: policy.fleet_rate_cap) {
    MoneyPerHourCurrencyMismatch { left: l, right: r } => refuse_currency(left: l, right: r)
    MoneyPerHourCompared { left_le_right: min_under_cap } =>
      if !min_under_cap {
        FlexBidRefused {
          cause: FlexRateCapBelowMin { cap: policy.fleet_rate_cap, min_bid: min_rate },
        }
      } else {
        match policy_reservation_ceiling(policy: policy, min_bid: min_rate) {
          FlexReservationCeilingCurrencyMismatch { left: mismatch_left, right: mismatch_right } =>
            refuse_currency(left: mismatch_left, right: mismatch_right)
          FlexReservationCeilingChosen { rate: ceiling } =>
            match attempt.subject {
              FlexExistingAcquisition { current_bid: current } =>
                match money_per_hour_compare(left: min_rate, right: current) {
                  MoneyPerHourCurrencyMismatch { left: mismatch_left, right: mismatch_right } =>
                    refuse_currency(left: mismatch_left, right: mismatch_right)
                  MoneyPerHourCompared { left_le_right: min_under_current } =>
                    if !min_under_current {
                      FlexBidRefused {
                        cause: FlexExistingBidWouldRise { current: current, min_bid: min_rate },
                      }
                    } else {
                      flex_existing_unchanged(
                        policy: policy,
                        occupancy: occupancy,
                        window: window,
                        account: account,
                        current: current,
                      )
                    }
                }
              FlexNewAcquisition =>
                flex_admit_new(
                  policy: policy,
                  occupancy: occupancy,
                  window: window,
                  account: account,
                  attempt: attempt,
                  min_rate: min_rate,
                  bid: ceiling,
                  joined: joined,
                )
            }
        }
      }
  }
}

fn flex_existing_unchanged(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  current: MoneyPerHour,
) -> FlexBidAdmission {
  match money_per_hour_compare(left: current, right: policy.fleet_rate_cap) {
    MoneyPerHourCurrencyMismatch { left: mismatch_left, right: mismatch_right } =>
      refuse_currency(left: mismatch_left, right: mismatch_right)
    MoneyPerHourCompared { left_le_right: current_under_cap } =>
      if !current_under_cap {
        FlexBidRefused {
          cause: FlexRateCapBelowMin { cap: policy.fleet_rate_cap, min_bid: current },
        }
      } else {
        match occupancy_sum(occupancy: occupancy, currency: policy.fleet_rate_cap.currency) {
          FlexOccupancyCurrencyMismatch { left: occupied_left, right: occupied_right } =>
            refuse_currency(left: occupied_left, right: occupied_right)
          FlexOccupancySummed { micros: occupied, currency: occupied_currency } =>
            if !(occupied <= money_per_hour_micros(q: policy.fleet_rate_cap)) {
              FlexBidRefused {
                cause: FlexRateCapOccupied {
                  cap: policy.fleet_rate_cap,
                  occupied: MoneyPerHour {
                    amount: money_amount_micro(count: occupied),
                    currency: occupied_currency,
                  },
                  proposed: current,
                },
              }
            } else {
              FlexBidUnchanged {
                bid: current,
                account: account,
                occupancy: occupancy,
                window: window,
              }
            }
        }
      }
  }
}

fn flex_admit_new(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  attempt: FlexBidAttempt<NonEmptyStr>,
  min_rate: MoneyPerHour,
  bid: MoneyPerHour,
  joined: List<CandidateOffer<NonEmptyStr>>,
) -> FlexBidAdmission {
  match occupancy_sum(occupancy: occupancy, currency: policy.fleet_rate_cap.currency) {
    FlexOccupancyCurrencyMismatch { left: l, right: r } => refuse_currency(left: l, right: r)
    FlexOccupancySummed { micros: occupied, currency: c } => {
      if bid.currency != c {
        refuse_currency(left: c, right: bid.currency)
      } else {
        let proposed = occupied + money_per_hour_micros(q: bid)
        if !(proposed <= money_per_hour_micros(q: policy.fleet_rate_cap)) {
          FlexBidRefused {
            cause: FlexRateCapOccupied {
              cap: policy.fleet_rate_cap,
              occupied: MoneyPerHour { amount: money_amount_micro(count: occupied), currency: c },
              proposed: bid,
            },
          }
        } else {
          flex_admit_at(
            policy: policy,
            occupancy: occupancy,
            window: window,
            account: account,
            attempt: attempt,
            min_rate: min_rate,
            bid: bid,
            append_standing: true,
            joined: joined,
          )
        }
      }
    }
  }
}

type FlexTargetJoin
  = FlexTargetRevocable
  | FlexTargetHasOnDemand
  | FlexTargetHasUnobserved

fn flex_joined_target_standing(joined: List<CandidateOffer<NonEmptyStr>>) -> FlexTargetJoin {
  fold(joined, init: FlexTargetRevocable, f: (acc, row) =>
    match acc {
      FlexTargetHasUnobserved => FlexTargetHasUnobserved
      FlexTargetHasOnDemand =>
        match flex_availability_standing(a: row.dispatch.availability) {
          FlexAvailabilityUnobserved => FlexTargetHasUnobserved
          FlexAvailabilityOnDemand => FlexTargetHasOnDemand
          FlexAvailabilityRevocable => FlexTargetHasOnDemand
        }
      FlexTargetRevocable =>
        match flex_availability_standing(a: row.dispatch.availability) {
          FlexAvailabilityUnobserved => FlexTargetHasUnobserved
          FlexAvailabilityOnDemand => FlexTargetHasOnDemand
          FlexAvailabilityRevocable => FlexTargetRevocable
        }
    })
}

fn flex_admit_at(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  attempt: FlexBidAttempt<NonEmptyStr>,
  min_rate: MoneyPerHour,
  bid: MoneyPerHour,
  append_standing: Bool,
  joined: List<CandidateOffer<NonEmptyStr>>,
) -> FlexBidAdmission {
  match money_per_hour_compare(left: min_rate, right: bid) {
    MoneyPerHourCurrencyMismatch { left: l, right: r } => refuse_currency(left: l, right: r)
    MoneyPerHourCompared { left_le_right: min_under_bid } =>
      if !min_under_bid {
        FlexBidRefused {
          cause: FlexRateCapBelowMin { cap: bid, min_bid: min_rate },
        }
      } else {
        match flex_joined_target_standing(joined: joined) {
          FlexTargetHasUnobserved =>
            FlexBidRefused { cause: FlexTargetAvailabilityUnobserved }
          FlexTargetHasOnDemand =>
            FlexBidRefused { cause: FlexTargetNotRevocable }
          FlexTargetRevocable =>
            flex_admit_revocable_target(
              policy: policy,
              occupancy: occupancy,
              window: window,
              account: account,
              attempt: attempt,
              min_rate: min_rate,
              bid: bid,
              append_standing: append_standing,
              joined: joined,
            )
        }
      }
  }
}

fn flex_admit_revocable_target(
  policy: FlexPolicy,
  occupancy: FlexFleetOccupancy,
  window: FlexAcquisitionWindow,
  account: MoneyAccount,
  attempt: FlexBidAttempt<NonEmptyStr>,
  min_rate: MoneyPerHour,
  bid: MoneyPerHour,
  append_standing: Bool,
  joined: List<CandidateOffer<NonEmptyStr>>,
) -> FlexBidAdmission {
  let liability = flex_liability_for_horizon(rate: bid, horizon: policy.acquisition_horizon)
  let selection = select_supply(
          requirements: attempt.requirements,
          candidates: joined,
          duration: flex_horizon_duration(policy: policy),
          maximum_buy_order: liability,
          budget_currency: bid.currency,
          delay_valuation: attempt.delay_valuation,
          tie: attempt.tie,
          affinity: attempt.affinity,
        )
        match selection {
          NoAdmissibleOffer { considered: _ } =>
            FlexBidRefused { cause: FlexSupplyNotSelected { selection: selection } }
          EqualCostTieUnresolved { digest: _, cause: _, considered: _ } =>
            FlexBidRefused { cause: FlexSupplyNotSelected { selection: selection } }
          OfferSelected { candidate: selected, cost: _, basis: _, horizon: _, considered: _, tie_policy: _ } => {
            if !selection_names_joined_offer(selected: selected, joined: joined) {
              FlexBidRefused { cause: FlexSupplyNotSelected { selection: selection } }
            } else {
              match flex_availability_standing(a: selected.candidate.dispatch.availability) {
                FlexAvailabilityOnDemand =>
                  FlexBidRefused { cause: FlexTargetNotRevocable }
                FlexAvailabilityUnobserved =>
                  FlexBidRefused { cause: FlexTargetAvailabilityUnobserved }
                FlexAvailabilityRevocable =>
                  match flex_on_demand_reference_cost(
                    policy: policy,
                    attempt: attempt,
                    budget_currency: bid.currency,
                    maximum_buy_order: flex_liability_for_horizon(
                      rate: policy.fleet_rate_cap,
                      horizon: policy.acquisition_horizon,
                    ),
                  ) {
                    FlexHorizonUnobserved =>
                      FlexBidRefused { cause: FlexOnDemandReferenceUnobserved }
                    FlexHorizonRefused { candidacy: reference_candidacy } =>
                      FlexBidRefused {
                        cause: FlexOnDemandReferenceCandidacyRefused { candidacy: reference_candidacy },
                      }
                    FlexHorizonPriced { cost: on_demand_cost } => {
                      let ceiling = flex_relative_ceiling(policy: policy, on_demand_cost: on_demand_cost)
                      match flex_price_offer(
                        offer: offer_quoted_at(offer: selected.candidate.offer, rate: bid),
                        inputs: selected.candidate.dispatch,
                        policy: policy,
                        attempt: attempt,
                        budget_currency: bid.currency,
                        maximum_buy_order: liability,
                      ) {
                        FlexHorizonUnobserved =>
                          FlexBidRefused { cause: FlexSupplyNotSelected { selection: selection } }
                        FlexHorizonRefused { candidacy: bid_candidacy } =>
                          FlexBidRefused {
                            cause: FlexReservedBidCandidacyRefused { candidacy: bid_candidacy },
                          }
                        FlexHorizonPriced { cost: projected } =>
                          if money_amount_micro_count(m: projected) > money_amount_micro_count(m: ceiling) {
                            FlexBidRefused {
                              cause: FlexOnDemandRelativeCeilingExceeded {
                                ceiling: ceiling,
                                projected: projected,
                              },
                            }
                          } else {
                            match reserve_money(
                              a: account,
                              request: MoneyReservationRequest {
                                reference: attempt.reservation,
                                generation: attempt.generation,
                                maximum_liability: liability,
                                currency: bid.currency,
                              },
                            ) {
                              MoneyRefused { refusal: r } => FlexBidRefused { cause: FlexMoneyRefused { refusal: r } }
                              AccountAdvanced { account: next } =>
                                FlexBidAdmitted {
                                  bid: bid,
                                  selection: selection,
                                  account: next,
                                  occupancy: if append_standing {
                                    occupy_pending(occupancy: occupancy, bid: bid)
                                  } else {
                                    occupancy
                                  },
                                  window: advance_window(window: window),
                                }
                            }
                          }
                      }
                    }
                  }
              }
            }
          }
        }
}
