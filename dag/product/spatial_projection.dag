module product.spatial_projection


// SPATIAL-5A CONSUMER: A WORLD, SEEN. This is the read-only half of the projection band - it takes
// the identity-bearing world SPATIAL-4A admitted and a camera std.planar_projection admitted, and
// produces what each room looks like from there. It edits nothing and it owns no geometry.
//
// IDENTITY SURVIVES THE PROJECTION, which is the whole reason this module exists rather than a
// caller mapping project_point over a list of points. A drawing whose shapes cannot be traced back
// to the rooms they depict is a picture, not a model: nothing downstream could highlight one room,
// attribute a measurement, or report which room a refusal is about. The RoomIdentity is carried
// through unchanged, and it is the world's identity rather than a fresh index minted here.
//
// A PROJECTED ROOM IS A POINT SET, NOT A SILHOUETTE, and the field is named for what it holds. The
// corner images are the projections of the prism's corners; the outline a draughtsman would ink is
// the boundary of their convex hull in the view plane, which needs a hull with a degeneracy policy
// for the collinear edges an axis-aligned box produces under an elevation. That is real work with
// its own failure modes, so it is absent rather than approximated - the same ruling SPATIAL-3A made
// about polygon Booleans. Calling this list an outline would have been the cheaper mistake and the
// worse one: a consumer would have drawn the points in corner order and produced a bow-tie.

// DepthOrderAmbiguous IS two rooms whose page regions overlap and whose depth ranges also overlap.
// Neither is wholly in front of the other, so no single back-to-front ordering of whole rooms is
// correct, and there is no arm here that picks one anyway.
type SceneRefusal
  = SceneProjectionRefused { cause: std.planar_projection.ProjectionRefusal }
  | DepthOrderAmbiguous { nearer_candidate: product.placement_supply.RoomIdentity, farther_candidate: product.placement_supply.RoomIdentity }

type SceneConstruction<T>
  = SceneReady { value: T }
  | SceneRefused { cause: SceneRefusal }

// Nearest and farthest are the extremes of the room's depth range, both derived from the same corner
// set as the page coordinates. They are stored beside the corners rather than recomputed because
// they are computed in the same pass that projects the corners and cannot disagree with them; the
// page bounding box IS recomputed on demand, because it is a pure function of the corners and a
// stored copy could go stale.
type ProjectedRoom {
  identity: product.placement_supply.RoomIdentity
  corner_images: List<std.planar_projection.ViewPoint2>
  nearest: std.integer.Int
  farthest: std.integer.Int
}

type ProjectedScene sole_constructor {
  view: std.planar_projection.ProjectionView
  rooms: List<ProjectedRoom>
}

// THE CORNERS OF A PRISM ARE ITS FOOTPRINT VERTICES AT BOTH HEIGHTS. Deriving them here rather than
// asking the topology layer for a corner list keeps this module a consumer: it reads the footprint
// and the two elevations that already define the prism, and invents no geometry of its own.
fn space_corners(s: std.orthogonal_topology.EnclosedSpace) -> List<std.affine_space.Point3> {
  let prism = shell_prism(s: space_shell(s: s))
  let low = signed_frame_component_count(c: prism3_low(p: prism))
  let high = signed_frame_component_count(c: prism3_high(p: prism))
  let frame = space_frame(s: s)
  fold(loop2_vertices(l: space_footprint(s: s)), init: [], f: (acc, v) =>
    concat(acc, [
      point3(frame: frame, x: signed_frame_component_count(c: v.x), y: signed_frame_component_count(c: v.y), z: low),
      point3(frame: frame, x: signed_frame_component_count(c: v.x), y: signed_frame_component_count(c: v.y), z: high),
    ]))
}

// The accumulator carries a refusal rather than stopping, because a fold cannot stop: the first
// refusal is retained and every later point is skipped, so the reported cause is the first one that
// actually occurred rather than the last.
type CornerAcc {
  images: List<std.planar_projection.ViewPoint2>
  nearest: std.integer.Int
  farthest: std.integer.Int
  started: Bool
  refusal: SceneRefusal?
}

fn accumulate_corner(acc: CornerAcc, v: std.planar_projection.ProjectionView, p: std.affine_space.Point3) -> CornerAcc {
  match acc.refusal {
    v2.std.optional.Present { value: r } => CornerAcc { images: acc.images, nearest: acc.nearest, farthest: acc.farthest, started: acc.started, refusal: v2.std.optional.Present { value: r } }
    v2.std.optional.Absent =>
      match project_point(v: v, p: p) {
        ProjectionRefused { cause: c } =>
          CornerAcc { images: acc.images, nearest: acc.nearest, farthest: acc.farthest, started: acc.started, refusal: v2.std.optional.Present { value: SceneProjectionRefused { cause: c } } }
        ProjectionReady { value: image } =>
          match projection_depth(v: v, p: p) {
            ProjectionRefused { cause: c } =>
              CornerAcc { images: acc.images, nearest: acc.nearest, farthest: acc.farthest, started: acc.started, refusal: v2.std.optional.Present { value: SceneProjectionRefused { cause: c } } }
            ProjectionReady { value: d } =>
              if !acc.started {
                CornerAcc { images: concat(acc.images, [image]), nearest: d, farthest: d, started: true, refusal: none }
              } else {
                CornerAcc {
                  images: concat(acc.images, [image]),
                  nearest: if d < acc.nearest { d } else { acc.nearest },
                  farthest: if d > acc.farthest { d } else { acc.farthest },
                  started: true,
                  refusal: none,
                }
              }
          }
      }
  }
}

// A ROOM WITH NO CORNERS IS NOT REPRESENTABLE, so no arm here fabricates a depth for one: an
// OrthogonalLoop2 has at least four vertices by construction (SPATIAL-3A refuses fewer), so the
// started flag is always true by the time the fold ends. It exists so that "no corners seen yet" is
// a state distinct from "the depth so far is zero" rather than a zero standing in for both.
fn project_room(v: std.planar_projection.ProjectionView, r: product.spatial_world.PlacedSpace) -> SceneConstruction<ProjectedRoom> {
  let acc = fold(space_corners(s: r.space), init: CornerAcc { images: [], nearest: 0, farthest: 0, started: false, refusal: none }, f: (a, p) =>
    accumulate_corner(acc: a, v: v, p: p))
  match acc.refusal {
    v2.std.optional.Present { value: c } => SceneRefused { cause: c }
    v2.std.optional.Absent => SceneReady { value: ProjectedRoom { identity: r.identity, corner_images: acc.images, nearest: acc.nearest, farthest: acc.farthest } }
  }
}

type SceneAcc {
  rooms: List<ProjectedRoom>
  refusal: SceneRefusal?
}

fn project_world(w: product.spatial_world.World, v: std.planar_projection.ProjectionView) -> SceneConstruction<ProjectedScene> {
  let acc = fold(world_rooms(w: w), init: SceneAcc { rooms: [], refusal: none }, f: (a, r) =>
    match a.refusal {
      v2.std.optional.Present { value: c } => SceneAcc { rooms: a.rooms, refusal: v2.std.optional.Present { value: c } }
      v2.std.optional.Absent =>
        match project_room(v: v, r: r) {
          SceneRefused { cause: c } => SceneAcc { rooms: a.rooms, refusal: v2.std.optional.Present { value: c } }
          SceneReady { value: pr } => SceneAcc { rooms: concat(a.rooms, [pr]), refusal: none }
        }
    })
  match acc.refusal {
    v2.std.optional.Present { value: c } => SceneRefused { cause: c }
    v2.std.optional.Absent => SceneReady { value: ProjectedScene { view: v, rooms: acc.rooms } }
  }
}

fn scene_rooms(s: ProjectedScene) -> List<ProjectedRoom> { s.rooms }
fn scene_view(s: ProjectedScene) -> std.planar_projection.ProjectionView { s.view }

type PageBox {
  min_u: std.integer.Int
  max_u: std.integer.Int
  min_v: std.integer.Int
  max_v: std.integer.Int
}

type PageBoxAcc {
  box: PageBox
  started: Bool
}

fn page_bounds(r: ProjectedRoom) -> PageBox {
  let acc = fold(r.corner_images, init: PageBoxAcc { box: PageBox { min_u: 0, max_u: 0, min_v: 0, max_v: 0 }, started: false }, f: (a, p) =>
    if !a.started {
      PageBoxAcc { box: PageBox { min_u: p.u, max_u: p.u, min_v: p.v, max_v: p.v }, started: true }
    } else {
      PageBoxAcc {
        box: PageBox {
          min_u: if p.u < a.box.min_u { p.u } else { a.box.min_u },
          max_u: if p.u > a.box.max_u { p.u } else { a.box.max_u },
          min_v: if p.v < a.box.min_v { p.v } else { a.box.min_v },
          max_v: if p.v > a.box.max_v { p.v } else { a.box.max_v },
        },
        started: true,
      }
    })
  acc.box
}

// STRICT OVERLAP ON BOTH AXES. Two page boxes that merely touch along an edge share no area, so
// neither can hide any part of the other, and refusing that case would refuse every ordinary plan of
// adjacent rooms.
fn ranges_overlap_strictly(a_lo: std.integer.Int, a_hi: std.integer.Int, b_lo: std.integer.Int, b_hi: std.integer.Int) -> Bool {
  a_lo < b_hi && b_lo < a_hi
}

fn page_boxes_overlap(a: PageBox, b: PageBox) -> Bool {
  ranges_overlap_strictly(a_lo: a.min_u, a_hi: a.max_u, b_lo: b.min_u, b_hi: b.max_u)
    && ranges_overlap_strictly(a_lo: a.min_v, a_hi: a.max_v, b_lo: b.min_v, b_hi: b.max_v)
}

// THE PAGE TEST IS A BOUNDING BOX AND IT IS CONSERVATIVE IN THE SAFE DIRECTION: a box overlap that
// the true shapes do not have can only produce a refusal, never a wrong order. The reverse - an
// exact page-region test - needs the convex hull this module deliberately does not compute, so the
// frontier is stated rather than crossed. Dissolve-on: an exact view-plane region test, at which
// point this narrows and refuses strictly less.
fn rooms_contend(a: ProjectedRoom, b: ProjectedRoom) -> Bool {
  page_boxes_overlap(a: page_bounds(r: a), b: page_bounds(r: b))
    && ranges_overlap_strictly(a_lo: a.nearest, a_hi: a.farthest, b_lo: b.nearest, b_hi: b.farthest)
}

type ContentionScan {
  seen: List<ProjectedRoom>
  refusal: SceneRefusal?
}

// THE NEARER CANDIDATE is the one whose farthest corner is closer to the camera, which is the
// ordering a caller would have taken had this not refused. Naming both roles rather than reporting
// an unordered pair is what makes the DepthOrderAmbiguous refusal actionable.
fn scan_against_seen(acc: ContentionScan, r: ProjectedRoom) -> ContentionScan {
  match acc.refusal {
    v2.std.optional.Present { value: c } => ContentionScan { seen: acc.seen, refusal: v2.std.optional.Present { value: c } }
    v2.std.optional.Absent =>
      let hit = fold(acc.seen, init: none, f: (found, other) =>
        match found {
          v2.std.optional.Present { value: c } => v2.std.optional.Present { value: c }
          v2.std.optional.Absent =>
            if rooms_contend(a: other, b: r) {
              v2.std.optional.Present {
                value: if r.farthest < other.farthest {
                  DepthOrderAmbiguous { nearer_candidate: r.identity, farther_candidate: other.identity }
                } else {
                  DepthOrderAmbiguous { nearer_candidate: other.identity, farther_candidate: r.identity }
                }
              }
            } else {
              none
            }
        })
      match hit {
        v2.std.optional.Present { value: c } => ContentionScan { seen: acc.seen, refusal: v2.std.optional.Present { value: c } }
        v2.std.optional.Absent => ContentionScan { seen: concat(acc.seen, [r]), refusal: none }
      }
  }
}

type InsertAcc {
  out: List<ProjectedRoom>
  placed: Bool
}

// Farthest first, and stable: a room is inserted before the first room strictly nearer than it, so
// two rooms with equal depth keep the world's order rather than an order this fold invented.
fn insert_farthest_first(sorted: List<ProjectedRoom>, r: ProjectedRoom) -> List<ProjectedRoom> {
  let acc = fold(sorted, init: InsertAcc { out: no_rooms(), placed: false }, f: (a, cur) =>
    if !a.placed && r.farthest > cur.farthest {
      InsertAcc { out: concat(a.out, [r, cur]), placed: true }
    } else {
      InsertAcc { out: concat(a.out, [cur]), placed: a.placed }
    })
  if acc.placed { acc.out } else { concat(acc.out, [r]) }
}

// PAINTER ORDER, OR A REFUSAL - never a best effort. Sorting by a single depth scalar is not a
// hidden-surface algorithm, and the honest scope of what it proves is exactly this: when no two
// rooms contend, drawing them farthest-first cannot hide anything that should be visible, because
// any two rooms that could occlude one another are wholly separated in depth. When two rooms do
// contend the correct picture requires splitting them, and this returns the pair rather than a
// plausible order - the fabricated output DESIGN section 5 forbids, in the form a renderer would
// have believed.
// The empty seed is a named function because a bare literal in argument position has no expected
// type for the resolver to read: the fold's result type is what fixes the element type, and it is
// not known until the fold is typed.
fn no_rooms() -> List<ProjectedRoom> { [] }

fn painter_order(s: ProjectedScene) -> SceneConstruction<List<ProjectedRoom>> {
  let scanned = fold(s.rooms, init: ContentionScan { seen: [], refusal: none }, f: (acc, r) =>
    scan_against_seen(acc: acc, r: r))
  match scanned.refusal {
    v2.std.optional.Present { value: c } => SceneRefused { cause: c }
    v2.std.optional.Absent => SceneReady { value: fold(s.rooms, init: no_rooms(), f: (sorted, r) => insert_farthest_first(sorted: sorted, r: r)) }
  }
}
