module product.spatial_connectivity


// SPATIAL-4C: OPENINGS, AND WHAT THEY MAKE REACHABLE.
//
// SPATIAL-3B deliberately stopped short of this: it could say two spaces SHARE A WALL, which is a
// coincidence of geometry, but a door is not a coincidence - somebody cut it, it has a position and
// a size, and it belongs to two rooms by identity rather than to two shapes. So it lands here, above
// the world that has identities, and the geometry it needs comes from the authority that owns walls.
//
// AN OPENING IS ADMITTED AGAINST A WORLD, NEVER AUTHORED FREE. Its two rooms must exist, must be
// distinct, must share a wall, and its rectangle must lie within the region they actually share -
// checked against the SAME `shared_wall_region` that decides adjacency, so there is no second
// opinion about where two rooms meet. A door in a wall that only one room has is the failure this
// exists to make unrepresentable, and it is the one that looks fine in a plan.
//
// REACHABILITY IS BOUNDED BY CONSTRUCTION. The traversal relaxes the frontier once per room in the
// world and stops - a path visiting more rooms than exist would have to repeat one, so more rounds
// cannot reach anything new. That is a termination argument from the model rather than a visited-set
// convention someone must remember to maintain, which matters because the substrate is bounded and
// forward by design and an unbounded walk has no place in it.
//
// WHAT THIS DOES NOT CLAIM. There is no traversability: an opening is a hole, and whether a person
// or a cable can pass through one is a question about what is passing, which nothing here models.
// Height above the floor is carried because it is part of the hole's position in the wall, not
// because a sill height has been interpreted. There is no door leaf, no swing, no hardware, and no
// direction - an opening is symmetric in its two rooms, and a one-way relation would be a claim
// about access control rather than about geometry.

type OpeningIdentity = std.types.NonEmptyStr where brand("OpeningIdentity")

type ReachabilityEndpoint
  = TraversalStart
  | TraversalTarget

// OpeningOutsideSharedWall is the opening's rectangle not lying inside the region the two rooms
// actually share. Both rectangles are reported because either one may be the surprise: the caller
// usually knows what it asked for and not what the rooms have in common.
//
// ReachabilityEndpointMissing is a room the traversal was asked about that the world does not have.
// The ROLE is carried rather than forked into two near-identical arms, following std.affine_space's
// frame refusal: it is one fact - a named room is not in this world - asked from two positions, and
// the position is what a caller needs to know which of its two arguments to go and fix. An earlier
// revision answered a missing DESTINATION with a variant named for a missing start, which reads as a
// fail-closed refusal while pointing the reader at the wrong argument.
type ConnectivityRefusal
  = OpeningRoomMissing { identity: product.placement_supply.RoomIdentity }
  | OpeningJoinsRoomToItself { identity: product.placement_supply.RoomIdentity }
  | OpeningRoomsShareNoWall { first: product.placement_supply.RoomIdentity, second: product.placement_supply.RoomIdentity }
  | OpeningOutsideSharedWall {
      opening: OpeningIdentity,
      along_low: std.integer.Int,
      along_high: std.integer.Int,
      sill: std.integer.Int,
      head: std.integer.Int,
      shared_along_low: std.integer.Int,
      shared_along_high: std.integer.Int,
      shared_low: std.integer.Int,
      shared_high: std.integer.Int,
    }
  | OpeningHasNoArea { opening: OpeningIdentity }
  | OpeningDeclaredTwice { opening: OpeningIdentity }
  | ReachabilityEndpointMissing { identity: product.placement_supply.RoomIdentity, role: ReachabilityEndpoint }

type ConnectivityConstruction<T>
  = ConnectivityReady { value: T }
  | ConnectivityRefused { cause: ConnectivityRefusal }

// The rectangle is expressed in the WALL's own two directions rather than in world X and Y, because
// a wall running north-south and one running east-west would otherwise need different fields for the
// same two facts. `along` is the horizontal direction the wall runs in; sill and head are heights in
// the world frame, which is shared by every space in a world.
type Opening {
  identity: OpeningIdentity
  first: product.placement_supply.RoomIdentity
  second: product.placement_supply.RoomIdentity
  along_low: std.integer.Int
  along_high: std.integer.Int
  sill: std.integer.Int
  head: std.integer.Int
}

// Admitted openings travel as their own carrier so a consumer cannot hand an un-admitted list to the
// traversal: reachability over openings nobody checked would report rooms connected through walls
// they do not share, which is the same fabricated answer one layer up.
type OpeningPlan sole_constructor {
  openings: List<Opening>
}

fn room_identity_eq(a: product.placement_supply.RoomIdentity, b: product.placement_supply.RoomIdentity) -> Bool {
  (a as String) == (b as String)
}

fn opening_identity_eq(a: OpeningIdentity, b: OpeningIdentity) -> Bool {
  (a as String) == (b as String)
}

fn find_room(w: product.spatial_world.World, identity: product.placement_supply.RoomIdentity) -> product.spatial_world.PlacedSpace? {
  fold(world_rooms(w: w), init: none, f: (acc, r) =>
    match acc {
      Present { value: found } => Present { value: found }
      Absent => if product.spatial_connectivity.room_identity_eq(a: r.identity, b: identity) { Present { value: r } } else { none }
    })
}

// The widest region the two rooms share on any one wall. Two rooms can meet along more than one wall
// - an L-shaped pair meets twice - and an opening lies in one of them, so the admission asks whether
// ANY shared region contains it rather than picking a region first and testing against that.
fn region_contains(region: std.orthogonal_topology.WallOverlap, along_low: std.integer.Int, along_high: std.integer.Int, sill: std.integer.Int, head: std.integer.Int) -> Bool {
  region.along_low <= along_low
    && along_high <= region.along_high
    && region.low <= sill
    && head <= region.high
}

fn some_shared_region_contains(a: std.orthogonal_topology.EnclosedSpace, b: std.orthogonal_topology.EnclosedSpace, o: Opening) -> Bool {
  let b_walls = space_walls(s: b)
  fold(space_walls(s: a), init: false, f: (acc, wa) =>
    acc || fold(b_walls, init: false, f: (inner, wb) =>
      inner ||
        match shared_wall_region(a: wa, b: wb) {
          Absent => false
          Present { value: region } =>
            region_contains(region: region, along_low: o.along_low, along_high: o.along_high, sill: o.sill, head: o.head)
        }))
}

fn rooms_share_any_wall(a: std.orthogonal_topology.EnclosedSpace, b: std.orthogonal_topology.EnclosedSpace) -> Bool {
  let b_walls = space_walls(s: b)
  fold(space_walls(s: a), init: false, f: (acc, wa) =>
    acc || fold(b_walls, init: false, f: (inner, wb) =>
      inner ||
        match shared_wall_region(a: wa, b: wb) {
          Absent => false
          Present { value: _ } => true
        }))
}

// THE ORDER OF THE CHECKS IS THE ORDER OF THE REMEDIES. A missing room is an inventory error, a
// self-joining opening is an authoring slip, no shared wall is a layout fact, and a rectangle
// outside the shared region is a dimension to correct - reported last because it is the only one
// whose numbers are worth printing, and printing them for a pair of rooms that do not meet at all
// would be noise.
fn admit_opening(w: product.spatial_world.World, o: Opening) -> ConnectivityConstruction<Opening> {
  if o.along_low >= o.along_high || o.sill >= o.head {
    ConnectivityRefused { cause: OpeningHasNoArea { opening: o.identity } }
  } else {
    if product.spatial_connectivity.room_identity_eq(a: o.first, b: o.second) {
      ConnectivityRefused { cause: OpeningJoinsRoomToItself { identity: o.first } }
    } else {
      match product.spatial_connectivity.find_room(w: w, identity: o.first) {
        Absent => ConnectivityRefused { cause: OpeningRoomMissing { identity: o.first } }
        Present { value: ra } =>
          match product.spatial_connectivity.find_room(w: w, identity: o.second) {
            Absent => ConnectivityRefused { cause: OpeningRoomMissing { identity: o.second } }
            Present { value: rb } =>
              if !rooms_share_any_wall(a: ra.space, b: rb.space) {
                ConnectivityRefused { cause: OpeningRoomsShareNoWall { first: o.first, second: o.second } }
              } else {
                if some_shared_region_contains(a: ra.space, b: rb.space, o: o) {
                  ConnectivityReady { value: o }
                } else {
                  ConnectivityRefused { cause: widest_mismatch(a: ra.space, b: rb.space, o: o) }
                }
              }
          }
      }
    }
  }
}

// The reported shared region is the first one the two rooms have. With more than one it is not
// necessarily the one the caller meant, and saying so is better than guessing: the refusal names the
// opening, so the caller can see its own numbers beside a region the rooms really do share.
fn first_shared_region(a: std.orthogonal_topology.EnclosedSpace, b: std.orthogonal_topology.EnclosedSpace) -> std.orthogonal_topology.WallOverlap? {
  let b_walls = space_walls(s: b)
  fold(space_walls(s: a), init: none, f: (acc, wa) =>
    match acc {
      Present { value: r } => Present { value: r }
      Absent =>
        fold(b_walls, init: none, f: (inner, wb) =>
          match inner {
            Present { value: r } => Present { value: r }
            Absent => shared_wall_region(a: wa, b: wb)
          })
    })
}

// Its no-region arm is unreachable: the caller checked that a shared wall exists before asking. It
// is a refusal rather than a fabricated rectangle of zeroes, because a zero region would read as a
// real measurement of a wall that is not there.
fn widest_mismatch(a: std.orthogonal_topology.EnclosedSpace, b: std.orthogonal_topology.EnclosedSpace, o: Opening) -> ConnectivityRefusal {
  match first_shared_region(a: a, b: b) {
    Absent => OpeningRoomsShareNoWall { first: o.first, second: o.second }
    Present { value: region } =>
      OpeningOutsideSharedWall {
        opening: o.identity,
        along_low: o.along_low,
        along_high: o.along_high,
        sill: o.sill,
        head: o.head,
        shared_along_low: region.along_low,
        shared_along_high: region.along_high,
        shared_low: region.low,
        shared_high: region.high,
      }
  }
}

type PlanAcc {
  admitted: List<Opening>
  refusal: ConnectivityRefusal?
}

fn count_openings_named(openings: List<Opening>, wanted: OpeningIdentity) -> std.integer.Int {
  fold(openings, init: 0, f: (n, o) => if opening_identity_eq(a: o.identity, b: wanted) { n + 1 } else { n })
}

fn opening_plan(w: product.spatial_world.World, openings: List<Opening>) -> ConnectivityConstruction<OpeningPlan> {
  let acc = fold(openings, init: PlanAcc { admitted: [], refusal: none }, f: (a, o) =>
    match a.refusal {
      Present { value: c } => PlanAcc { admitted: a.admitted, refusal: Present { value: c } }
      Absent =>
        if count_openings_named(openings: openings, wanted: o.identity) > 1 {
          PlanAcc { admitted: a.admitted, refusal: Present { value: OpeningDeclaredTwice { opening: o.identity } } }
        } else {
          match admit_opening(w: w, o: o) {
            ConnectivityRefused { cause: c } => PlanAcc { admitted: a.admitted, refusal: Present { value: c } }
            ConnectivityReady { value: ok } => PlanAcc { admitted: concat(a.admitted, [ok]), refusal: none }
          }
        }
    })
  match acc.refusal {
    Present { value: c } => ConnectivityRefused { cause: c }
    Absent => ConnectivityReady { value: OpeningPlan { openings: acc.admitted } }
  }
}

fn plan_openings(p: OpeningPlan) -> List<Opening> { p.openings }

fn contains_room(rooms: List<product.placement_supply.RoomIdentity>, wanted: product.placement_supply.RoomIdentity) -> Bool {
  fold(rooms, init: false, f: (hit, r) => hit || product.spatial_connectivity.room_identity_eq(a: r, b: wanted))
}

// ONE RELAXATION: every opening with exactly one end already reached brings the other end in. An
// opening is symmetric, so both directions are tried.
fn relax_once(reached: List<product.placement_supply.RoomIdentity>, openings: List<Opening>) -> List<product.placement_supply.RoomIdentity> {
  fold(openings, init: reached, f: (acc, o) =>
    if contains_room(rooms: acc, wanted: o.first) && !contains_room(rooms: acc, wanted: o.second) {
      concat(acc, [o.second])
    } else {
      if contains_room(rooms: acc, wanted: o.second) && !contains_room(rooms: acc, wanted: o.first) {
        concat(acc, [o.first])
      } else {
        acc
      }
    })
}

// THE BOUND IS THE ROOM COUNT AND IT IS THE MODEL'S OWN. Each round adds at least one room or the
// set has stopped growing, and there are only as many rooms as the world has - so a path that needed
// more rounds would have to visit some room twice, and revisiting reaches nothing new. The world's
// room list is what the fold iterates, which is why the bound cannot drift from the thing it bounds.
fn reachable_from(w: product.spatial_world.World, p: OpeningPlan, start: product.placement_supply.RoomIdentity) -> ConnectivityConstruction<List<product.placement_supply.RoomIdentity>> {
  match product.spatial_connectivity.find_room(w: w, identity: start) {
    Absent => ConnectivityRefused { cause: ReachabilityEndpointMissing { identity: start, role: TraversalStart } }
    Present { value: _ } =>
      ConnectivityReady {
        value: fold(world_rooms(w: w), init: [start], f: (reached, _) =>
          relax_once(reached: reached, openings: plan_openings(p: p)))
      }
  }
}

fn rooms_are_connected(w: product.spatial_world.World, p: OpeningPlan, from: product.placement_supply.RoomIdentity, to: product.placement_supply.RoomIdentity) -> ConnectivityConstruction<Bool> {
  match reachable_from(w: w, p: p, start: from) {
    ConnectivityRefused { cause: c } => ConnectivityRefused { cause: c }
    ConnectivityReady { value: reached } =>
      match product.spatial_connectivity.find_room(w: w, identity: to) {
        Absent => ConnectivityRefused { cause: ReachabilityEndpointMissing { identity: to, role: TraversalTarget } }
        Present { value: _ } => ConnectivityReady { value: contains_room(rooms: reached, wanted: to) }
      }
  }
}

// A world with no rooms is vacuously connected and a world with one room is trivially so; neither is
// a special case here, because the fold starts from whichever room the world lists first and an
// empty world has none to start from. The empty answer is `true` and it is the honest one: there is
// no pair of rooms that fails to reach each other.
fn unreachable_room(w: product.spatial_world.World, p: OpeningPlan) -> product.placement_supply.RoomIdentity? {
  match world_rooms(w: w) {
    Empty => none
    Cons { head: first, tail: _ } =>
      match reachable_from(w: w, p: p, start: first.identity) {
        ConnectivityRefused { cause: _ } => none
        ConnectivityReady { value: reached } =>
          fold(world_rooms(w: w), init: none, f: (acc, r) =>
            match acc {
              Present { value: i } => Present { value: i }
              Absent => if contains_room(rooms: reached, wanted: r.identity) { none } else { Present { value: r.identity } }
            })
      }
  }
}

fn world_is_connected(w: product.spatial_world.World, p: OpeningPlan) -> Bool {
  match unreachable_room(w: w, p: p) {
    Absent => true
    Present { value: _ } => false
  }
}
