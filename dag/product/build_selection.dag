module product.build_selection

// THE DOMAIN PROJECTOR. std.pareto is the universal selection spine and knows
// nothing about hardware; this module is the one place that turns a resolved
// build into the spine's vocabulary. It is the last stage of the pipeline —
// memory_provisioning derives populations, the qualification seam grades them,
// product.build_fulfillment resolves and prices the lines, and this projects
// what survives into a comparable field.
//
// WHY THE MAGNITUDES ARE DOMAIN-TYPED AND THE SPINE'S ARE NOT. std.pareto's
// AxisReading carries a bare scalar, and that is correct FOR THE SPINE: a fold
// that compared std.measure carriers would have to enumerate them, which is a
// universal framework naming its domains. But a projector that reached for the
// bare scalar directly would lose the unit at exactly the seam where a
// wattage, a byte count and a money figure sit side by side — so the readings
// are authored here on their std.measure carriers, and the collapse to the
// spine's scalar happens in ONE total function that must name the carrier it is
// reading. A new axis cannot be added without stating what it measures.
type BuildAxisMagnitude
  = MagnitudeBytes { bytes: std.measure.ByteSize }
  | MagnitudeMoney { money: std.measure.MoneyOnce }
  | MagnitudeWatts { watts: std.measure.Watt }
  | MagnitudeBandwidth { bandwidth: std.measure.Bandwidth }
  | MagnitudeUnitCount { units: std.nat.Nat }

type BuildAxisReading {
  axis: std.decl_ref.DeclarationRef
  magnitude: BuildAxisMagnitude
}

fn magnitude_scalar(m: BuildAxisMagnitude) -> Int {
  match m {
    MagnitudeBytes { bytes: b } => std.measure.byte_size_count(b: b)
    MagnitudeMoney { money: m } => std.measure.money_once_micros(q: m)
    MagnitudeWatts { watts: w } => std.measure.watt_count(w: w)
    MagnitudeBandwidth { bandwidth: b } => std.measure.bandwidth_count(b: b)
    MagnitudeUnitCount { units: u } => u
  }
}

fn to_axis_reading(r: BuildAxisReading) -> std.pareto.AxisReading {
  std.pareto.AxisReading { axis: r.axis, value_micro: magnitude_scalar(m: r.magnitude) }
}

// THE FUNDED AXES, each named by the declaration it projects rather than by a
// label, so renaming a display string cannot move a candidate.
data capacity_axis: std.decl_ref.DeclarationRef = std.decl_ref.decl_ref(
  module_path: "product.build_selection",
  decl_name: "build_memory_capacity_axis",
)

data cash_axis: std.decl_ref.DeclarationRef = std.decl_ref.decl_ref(
  module_path: "product.build_selection",
  decl_name: "build_incremental_cash_axis",
)

data ceiling_axis: std.decl_ref.DeclarationRef = std.decl_ref.decl_ref(
  module_path: "product.build_selection",
  decl_name: "build_constructible_ceiling_axis",
)

data wall_power_axis: std.decl_ref.DeclarationRef = std.decl_ref.decl_ref(
  module_path: "product.build_selection",
  decl_name: "build_wall_power_axis",
)

data bandwidth_axis: std.decl_ref.DeclarationRef = std.decl_ref.decl_ref(
  module_path: "product.build_selection",
  decl_name: "build_memory_bandwidth_axis",
)

fn build_selection_axes() -> std.types.List<std.pareto.SelectionAxis> {
  [
    std.pareto.SelectionAxis { identity: capacity_axis, goal: std.pareto.HigherIsBetter },
    std.pareto.SelectionAxis { identity: cash_axis, goal: std.pareto.LowerIsBetter },
    std.pareto.SelectionAxis { identity: ceiling_axis, goal: std.pareto.HigherIsBetter },
    std.pareto.SelectionAxis { identity: wall_power_axis, goal: std.pareto.LowerIsBetter },
    std.pareto.SelectionAxis { identity: bandwidth_axis, goal: std.pareto.HigherIsBetter },
  ]
}

// ONE CANDIDATE AS THIS DOMAIN HOLDS IT: the recipe's own identity, what its
// memory adds up to, and the two answers the fulfillment layer produced. The
// resolutions ride along because the projector must state what is MISSING, and
// only the per-line answers know that.
type BuildCandidate {
  identity: std.decl_ref.DeclarationRef
  display_label: std.types.NonEmptyStr
  memory_capacity: std.measure.ByteSize
  wall_power: std.measure.Watt
  memory_bandwidth: std.measure.Bandwidth
  resolutions: std.types.List<product.build_fulfillment.LineResolution>
  cash: product.build_fulfillment.CashProjection
  ceiling: product.build_fulfillment.ConstructibleCeiling
}

fn one_missing(name: std.types.NonEmptyStr) -> std.types.List<std.types.NonEmptyStr> { [name] }

data no_missing: std.types.List<std.types.NonEmptyStr> = []

// WHAT MAKES A CANDIDATE INCOMPARABLE, stated by the projector rather than
// substituted for. Every one of these is a fact the candidate does not yet
// have — an unread compatibility, a line nobody could fill, a refused cash
// answer, a refused ceiling — and std.pareto's rule is that an entry declaring
// a missing input is incomparable BY ITS OWN DECLARATION. That is exactly the
// wall the brief asks for: an unread compatibility yields pending evidence,
// never a candidate that quietly ranks well because the axis it would lose on
// could not be computed.
fn line_missing(acc: std.types.List<std.types.NonEmptyStr>, r: product.build_fulfillment.LineResolution) -> std.types.List<std.types.NonEmptyStr> {
  match r {
    LineRefused { line: l, cause: _ } =>
      concat(acc, one_missing(name: join(["line ", l.display_label as String, " refused"], "") as std.types.NonEmptyStr))
    LineResolved { line: l, fulfillment: f } =>
      match f {
        CompatibilityUnread { part: _, obligation: o } =>
          concat(acc, one_missing(name: join([l.display_label as String, ": ", o as String], "") as std.types.NonEmptyStr))
        SupplyMissing { part: _, requested: _, owned_available: _, market_units: _ } =>
          concat(acc, one_missing(name: join(["line ", l.display_label as String, " cannot be filled"], "") as std.types.NonEmptyStr))
        OwnedInventory { lot: _, quantity: _, reservation: _, available_after: _ } => acc
        NewPurchase { part: _, quantity: _, unit_price: _, authority: _ } => acc
        IncludedInSystem { part: _, quantity: _ } => acc
      }
  }
}

// A CANDIDATE PRICED IN ANOTHER CURRENCY IS PENDING EVIDENCE, NOT A CHEAP ONE.
// The cash axis collapses to a scalar for the spine, and two scalars in
// different currencies compare perfectly well and mean nothing. So the field
// declares its currency once and a candidate priced elsewhere declares that as
// a missing input rather than being ranked against it — the same wall the
// deleted memory_part_selection held at its own admission, kept here where the
// pipeline actually compares.
fn cash_missing(declared: std.currency.CurrencyCode, cash: product.build_fulfillment.CashProjection) -> std.types.List<std.types.NonEmptyStr> {
  match cash {
    CashDerived { cash: c } =>
      if c.currency != declared {
        one_missing(name: "priced in a currency the field did not declare" as std.types.NonEmptyStr)
      } else {
        no_missing
      }
    CashNoPurchaseLines => no_missing
    CashRefused { cause: _ } =>
      one_missing(name: "incremental cash refused" as std.types.NonEmptyStr)
  }
}

fn ceiling_missing(ceiling: product.build_fulfillment.ConstructibleCeiling) -> std.types.List<std.types.NonEmptyStr> {
  match ceiling {
    CeilingDerived { builds: _, bottlenecks: _, bottleneck_units: _ } => no_missing
    CeilingUnconstrainedByAnyLine =>
      one_missing(name: "no line bounds the build count, so there is no ceiling to compare" as std.types.NonEmptyStr)
    CeilingRefused { cause: _ } => one_missing(name: "constructible ceiling refused" as std.types.NonEmptyStr)
  }
}

fn candidate_missing_inputs(candidate: BuildCandidate, declared: std.currency.CurrencyCode) -> std.types.List<std.types.NonEmptyStr> {
  concat(
    concat(
      fold(candidate.resolutions, init: no_missing, f: fn(acc, r) { line_missing(acc: acc, r: r) }),
      cash_missing(declared: declared, cash: candidate.cash),
    ),
    ceiling_missing(ceiling: candidate.ceiling),
  )
}

// A build that buys nothing reads ZERO on the cash axis, and that is a real
// reading rather than a substituted one: CashNoPurchaseLines means every line
// was owned or included, so the incremental cash genuinely is zero — the arm
// exists to stop a zero being invented for an UNREADABLE answer, not to stop
// one being reported for a readable one. A refused cash answer never reaches
// here at all, because it is a declared missing input above.
fn cash_reading(cash: product.build_fulfillment.CashProjection, declared: std.currency.CurrencyCode) -> BuildAxisReading {
  match cash {
    CashDerived { cash: c } => BuildAxisReading { axis: cash_axis, magnitude: MagnitudeMoney { money: c } }
    _ =>
      BuildAxisReading {
        axis: cash_axis,
        magnitude: MagnitudeMoney {
          money: std.measure.MoneyOnce { amount: std.measure.money_amount_micro(count: 0), currency: declared },
        },
      }
  }
}

// A ceiling that no line bounds has no build count to compare, so the entry
// declares it missing above and this reading is never reached for it. The zero
// here is unreachable-by-construction rather than a substituted answer: an
// entry declaring a missing input is incomparable in std.pareto and is excluded
// as a challenger, so it can neither win nor poison the field.
fn ceiling_reading(ceiling: product.build_fulfillment.ConstructibleCeiling) -> BuildAxisReading {
  match ceiling {
    CeilingDerived { builds: b, bottlenecks: _, bottleneck_units: _ } =>
      BuildAxisReading { axis: ceiling_axis, magnitude: MagnitudeUnitCount { units: b } }
    _ => BuildAxisReading { axis: ceiling_axis, magnitude: MagnitudeUnitCount { units: 0 } }
  }
}

fn candidate_readings(candidate: BuildCandidate, declared: std.currency.CurrencyCode) -> std.types.List<BuildAxisReading> {
  [
    BuildAxisReading { axis: capacity_axis, magnitude: MagnitudeBytes { bytes: candidate.memory_capacity } },
    cash_reading(cash: candidate.cash, declared: declared),
    ceiling_reading(ceiling: candidate.ceiling),
    BuildAxisReading { axis: wall_power_axis, magnitude: MagnitudeWatts { watts: candidate.wall_power } },
    BuildAxisReading { axis: bandwidth_axis, magnitude: MagnitudeBandwidth { bandwidth: candidate.memory_bandwidth } },
  ]
}

fn project_entry(candidate: BuildCandidate, declared: std.currency.CurrencyCode) -> std.pareto.ParetoEntry {
  std.pareto.ParetoEntry {
    identity: candidate.identity,
    display_label: candidate.display_label,
    readings: map(candidate_readings(candidate: candidate, declared: declared), r => to_axis_reading(r: r)),
    missing_inputs: candidate_missing_inputs(candidate: candidate, declared: declared),
  }
}

fn project_field(candidates: std.types.List<BuildCandidate>, declared: std.currency.CurrencyCode) -> std.types.List<std.pareto.ParetoEntry> {
  map(candidates, c => project_entry(candidate: c, declared: declared))
}

fn build_standing(
  subject: BuildCandidate,
  field: std.types.List<BuildCandidate>,
  declared: std.currency.CurrencyCode,
) -> std.pareto.ParetoStanding {
  std.pareto.entry_standing(
    subject: project_entry(candidate: subject, declared: declared),
    field: project_field(candidates: field, declared: declared),
    axes: build_selection_axes(),
    sensitivities: no_missing,
  )
}
