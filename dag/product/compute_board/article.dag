module product.compute_board.article


// THE DESIGN THIS ARTICLE'S IDENTITIES BELONG TO. Every component and net below is scoped to it,
// so a projection admitted against this board cannot be replayed against another whose labels agree.
data board_power_interlock_design: product.electrical.connectivity.ElectricalDesignIdentity = "compute_board.power_interlock" as product.electrical.connectivity.ElectricalDesignIdentity

data article_note: String = "ONE ARTICLE IDENTITY FEEDING EVERY INTERFACE. The analog slice, the digital control, the bonding topology, the platform-firmware contract and the physical and manufacturing standings are fields of ONE root, so a projection cannot quietly acquire its own private copy of the board. That is the property the whole design turns on and it is the one that decays silently: two projections each holding their own fixture agree until someone edits one of them, and nothing reports the divergence because there was never a shared referent to disagree with. THE ARTICLE IS DELIBERATELY SMALL — a two-rail power-good and reset interlock — and is a real future motherboard subassembly rather than a demonstration. It does not claim to implement the Altra power sequence; it crosses every interface that sequence will need, which is a different and more useful thing to have finished."

// ELECTRICAL REFERENCES ARE NOT ONE THING, and fusing them into a single `Ground` is the
// modelling error this type exists to prevent. A power return, a signal reference, a chassis
// bond, protective earth and a cable-shield termination are five distinct relations with
// different currents, different safety consequences and different physical realizations. They
// are routinely all drawn with the same triangle and then discovered to be different during
// bring-up, or worse, after an incident.
//
// The mounting-hole case is the one worth stating explicitly: a metal standoff bonds the board
// to chassis ONLY when a declared bonding relation says it does. Mechanical support and
// electrical bonding are separate facts about the same hole, and a model that infers the second
// from the first has decided a safety property by accident.
// The endpoints are IDENTITIES, not prose. An earlier revision carried every endpoint as a bare
// NonEmptyStr, which made "is this bond attached to the same terminal the circuit nets" a
// spelling coincidence between two independently authored strings rather than a decidable join
// — and a bond that referred to a terminal no component owns was perfectly constructible.
// Electrical endpoints reuse the analog module's identities so the join is the same one the
// SPICE projection performs; board and chassis features get their own brands because a chassis
// feature is not a circuit node and the two must never be comparable.
type BoardFeatureIdentity = std.types.NonEmptyStr where brand("BoardFeatureIdentity")

type ChassisFeatureIdentity = std.types.NonEmptyStr where brand("ChassisFeatureIdentity")

type EarthSourceIdentity = std.types.NonEmptyStr where brand("EarthSourceIdentity")

type ShieldIdentity = std.types.NonEmptyStr where brand("ShieldIdentity")

// A chassis-level bond is either something this board DECLARES it requires of its enclosure, or
// something an integration has been OBSERVED to provide. They are not the same claim and were
// fused in the earlier revision: a required protective-earth bond recorded as though it existed
// is a safety property asserted by authoring it. A proposed bond carries no evidence; an
// observed one names who observed it.
type ChassisBondStanding
  = ChassisBondProposed
  | ChassisBondObserved { observer: std.types.NonEmptyStr }

type ElectricalBond
  = PowerReturnConnection { domain: product.electrical.connectivity.NetIdentity, terminal: product.electrical.connectivity.ElectricalTerminalRef }
  | SignalReferenceConnection { signal_class: product.electrical.connectivity.NetIdentity, terminal: product.electrical.connectivity.ElectricalTerminalRef }
  | ChassisBond {
      board_feature: BoardFeatureIdentity,
      chassis_feature: ChassisFeatureIdentity,
      standing: ChassisBondStanding,
    }
  | ProtectiveEarthBond {
      chassis_feature: ChassisFeatureIdentity,
      earth_source: EarthSourceIdentity,
      standing: ChassisBondStanding,
    }
  | ShieldTermination {
      shield: ShieldIdentity,
      chassis_feature: ChassisFeatureIdentity,
      standing: ChassisBondStanding,
    }

// THE PLATFORM FIRMWARE STACK IS NOT ONE THING. An Ampere platform runs system control processor
// firmware, an ARM Trusted Firmware-A secure boot chain, host UEFI, baseboard management firmware
// and board CPLD logic — five independently governed pieces that boot in order, are updated
// separately, and fail in ways with nothing in common. The earlier revision named none of them:
// it carried four prose strings, one of which said "board interlock asserts reset_release; the
// host owns everything after it", which is a sentence about a signal this article DECLARES and
// could have referenced. Prose is where a fact goes when nothing joins to it.
//
// The roles are named here and the cited upstreams live in extdeps, one module each, because
// TF-A and EDK II are separately versioned projects and a Chromium-and-Safari argument applies
// unchanged: adding a sixth role must not require editing the fifth.
type PlatformFirmwareRole
  = SystemControlProcessorFirmware
  | TrustedFirmwareSecureBootChain
  | HostUefiFirmware
  | BaseboardManagementFirmware
  | BoardProgrammableLogic

// WHICH UPSTREAM FILLS A ROLE, where one is modelled. The two arms are not an Optional because
// "no cited upstream module exists in this repository" and "this role has no upstream" are
// different states with different remedies — the first is an authoring gap someone can close by
// citing a project, the second would be a claim about the world. The system control processor
// firmware and the board CPLD logic are the first: Ampere publishes SCP firmware and the CPLD is
// board-specific, and neither has a cited module here yet.
type PlatformRoleUpstream
  = UpstreamCited { subject: std.decl_ref.DeclarationRef }
  | UpstreamNotModelledHere { reason: std.types.NonEmptyStr }

fn platform_firmware_role_upstream(role: PlatformFirmwareRole) -> PlatformRoleUpstream {
  match role {
    TrustedFirmwareSecureBootChain =>
      UpstreamCited { subject: extdeps.firmware.trusted_firmware_a.subject.trusted_firmware_a_model_scope.subject.declaration }
    HostUefiFirmware =>
      UpstreamCited { subject: extdeps.firmware.tianocore_edk2.subject.tianocore_edk2_model_scope.subject.declaration }
    BaseboardManagementFirmware =>
      UpstreamCited { subject: openbmc_model_scope.subject.declaration }
    SystemControlProcessorFirmware =>
      UpstreamNotModelledHere { reason: "Ampere system control processor firmware has no cited subject module in this repository yet; extdeps.ampere carries only an SCP diagnostic surface" }
    BoardProgrammableLogic =>
      UpstreamNotModelledHere { reason: "the board CPLD's logic is authored here rather than upstream, so there is no external project to cite; its own model is the article" }
  }
}

// Board-level preconditions for host firmware to START. The distinction from what firmware then
// DOES is load-bearing: a permitted power rail and a released reset are observable at the board,
// while "UEFI executed", "DDR trained" and "devices enumerated" are later observations belonging
// to entirely different subjects. A contract that let the first imply the second would report a
// booting machine on the strength of a released reset line.
type HostFirmwareStartPreconditionKind
  = PowerPermitAsserted
  | ResetReleased
  | BootStorageReadable
  | RecoveryRequestObservable
  | ConsoleAvailable

// WHAT ESTABLISHES A PRECONDITION IS PART OF THE PRECONDITION. Listing PowerPermitAsserted said
// that power must be permitted and nothing about what permits it — so an article whose interlock
// drove no such signal declared the same contract as one that did, and the two were
// indistinguishable to every consumer. Naming the signal makes it a join: admission refuses a
// precondition established by a signal the control logic does not declare as an output, which is
// a defect that was previously unrepresentable rather than merely unchecked.
//
// The third arm is not a hole. A board article that does not establish a precondition is the
// ordinary case — this one does not own its boot storage — and saying so explicitly is different
// from omitting the row, which would read as "no such precondition exists".
type PreconditionEstablishment
  = EstablishedByBoardSignal { signal: product.compute_board.digital_control.SignalName }
  | EstablishedByPlatformComponent { role: PlatformFirmwareRole }
  | NotEstablishedByThisArticle { owner: std.types.NonEmptyStr }

type HostFirmwareStartPrecondition {
  kind: HostFirmwareStartPreconditionKind
  establishment: PreconditionEstablishment
}

// Trust is TWO simultaneous standings, not one choice among three. An earlier revision made
// "the development image is unsigned" and "production signing is unavailable" alternatives in
// one coproduct, so recording either erased the other — and both are true at once today. They
// are also owned differently: the first is what we build, the second is what the project can
// obtain.
type DevelopmentImageTrust
  = DevelopmentUnsigned
  | DevelopmentTestKey { key_identity: std.types.NonEmptyStr }

type ProductionSigningStanding
  = ProductionSigningUnavailable { reason: std.types.NonEmptyStr }
  | ProductionSigningAvailable { authority: std.types.NonEmptyStr }

// The SPI-NOR boundary is first-class rather than generic "BIOS flash" prose because its access
// and write-protection policy has had real security consequences on this exact processor family.
// Update access, write protection and recovery are therefore separate declared facts.
type FirmwareWriteProtection
  = WriteProtectionUnmodelled { reason: std.types.NonEmptyStr }
  | HardwareWriteProtect { control: std.types.NonEmptyStr }

type PlatformFirmwareContract {
  start_preconditions: List<HostFirmwareStartPrecondition>
  write_protection: FirmwareWriteProtection
  development_image_trust: DevelopmentImageTrust
  production_signing: ProductionSigningStanding
}

// The physical interface EXISTS with typed pending causes rather than prose, and this list has
// now SHRUNK by one because a cause was discharged rather than reworded. Two earlier revisions
// were wrong in different ways: the first said Millimeter is unsigned, therefore an interior
// board origin is unrepresentable, therefore an operator ruling on signedness is required — no
// such ruling was ever open. The second corrected the cause to "the affine carrier has not
// landed", which was true when written. SPATIAL-2 (#8091) has since landed on main, so that
// cause is discharged and is deleted rather than kept as a satisfied row.
//
// What remains is genuinely independent of it: #8091 fixes the quantum at millimetres, which
// cannot express a 0.5 mm pitch or a 100 um trace, and shape/topology follows separately. Each
// is its own cause so a reader can tell which one moved.
type PhysicalRealizationPendingCause
  = RequiresExactSubMillimeterCoordinateQuantum
  | RequiresShapeAndTopology
  | RequiresPackageFootprintAuthority

type PhysicalRealizationStanding
  = PhysicalRealizationPending { causes: List<PhysicalRealizationPendingCause> }
  | PhysicalRealizationAdmitted { outline: std.types.NonEmptyStr }

type ManufacturingRealizationStanding
  = ManufacturingProfileUnselected { pending: std.types.NonEmptyStr }
  | ManufacturingProfileSelected { fabricator: std.types.NonEmptyStr, authority: extdeps.external_authority.ExternalAuthority }

type BoardArticleIdentity {
  name: std.types.NonEmptyStr
  revision: std.types.NonEmptyStr
}

type BoardPowerInterfaceArticle {
  identity: BoardArticleIdentity
  analog: product.compute_board.analog.AnalogCircuitIntent
  model_bindings: List<product.compute_board.analog.ComponentModelBinding>
  reference_net: product.electrical.connectivity.NetIdentity
  digital_control: product.compute_board.digital_control.DigitalControlIntent
  bonds: List<ElectricalBond>
  platform_firmware: PlatformFirmwareContract
  physical: PhysicalRealizationStanding
  manufacturing: ManufacturingRealizationStanding
}

// The BootStorageReadable row below says this board does not own its boot storage, rather than
// omitting the row: an absent precondition reads as "this does not apply", which is a different
// and false claim.
data board_power_interlock_firmware_contract: PlatformFirmwareContract = PlatformFirmwareContract {
  start_preconditions: [
    HostFirmwareStartPrecondition {
      kind: PowerPermitAsserted,
      establishment: EstablishedByBoardSignal { signal: power_permit_signal },
    },
    HostFirmwareStartPrecondition {
      kind: ResetReleased,
      establishment: EstablishedByBoardSignal { signal: reset_release_signal },
    },
    HostFirmwareStartPrecondition {
      kind: BootStorageReadable,
      establishment: NotEstablishedByThisArticle { owner: "host SPI-NOR, owned by the platform firmware stack" },
    },
    HostFirmwareStartPrecondition {
      kind: ConsoleAvailable,
      establishment: EstablishedByPlatformComponent { role: HostUefiFirmware },
    },
    HostFirmwareStartPrecondition {
      kind: RecoveryRequestObservable,
      establishment: EstablishedByPlatformComponent { role: BaseboardManagementFirmware },
    },
  ],
  write_protection: WriteProtectionUnmodelled {
    reason: "SPI-NOR write-protect control is a host-board fact this article does not carry; it is declared unmodelled rather than defaulted to protected",
  },
  development_image_trust: DevelopmentUnsigned,
  production_signing: ProductionSigningUnavailable {
    reason: "no production signing authority exists for this project and no key material is modelled",
  },
}

// The two electrical bonds name the SAME terminals the analog circuit nets, by identity, so the
// join is decidable. The chassis bond is PROPOSED: this board requires an enclosure bond at
// mounting hole 1 and no integration has been observed providing one, which is a requirement
// this article states rather than a connection it claims exists.
data board_power_interlock_bonds: List<ElectricalBond> = [
  PowerReturnConnection {
    domain: power_return_net,
    terminal: terminal_ref(component: logic_supply_source.identity, terminal: logic_supply_source.negative_terminal),
  },
  SignalReferenceConnection {
    signal_class: pg_conditioned_net,
    terminal: terminal_ref(component: pg_conditioning_capacitor.identity, terminal: pg_conditioning_capacitor.positive_terminal),
  },
  ChassisBond {
    board_feature: "mounting_hole_1" as BoardFeatureIdentity,
    chassis_feature: "chassis_standoff_1" as ChassisFeatureIdentity,
    standing: ChassisBondProposed,
  },
]

data board_power_interlock_physical: PhysicalRealizationStanding = PhysicalRealizationPending {
  causes: [
    RequiresExactSubMillimeterCoordinateQuantum,
    RequiresShapeAndTopology,
    RequiresPackageFootprintAuthority,
  ],
}

data board_power_interlock_manufacturing: ManufacturingRealizationStanding = ManufacturingProfileUnselected {
  pending: "no fabricator selected; the artifact set a profile would carry is modelled at extdeps.ipc.dpmx and extdeps.ucamco.gerber, and which semantics survive is decided by the selected fabricator's capability profile",
}

fn article_digital_control(a: BoardPowerInterfaceArticle) -> product.compute_board.digital_control.DigitalControlIntent {
  a.digital_control
}

fn article_analog(a: BoardPowerInterfaceArticle) -> product.compute_board.analog.AnalogCircuitIntent {
  a.analog
}

// Two receipts name the same article exactly when BOTH fields agree. Revision is part of the
// comparison rather than a detail beside it: two revisions of one board share a name, and that
// is precisely the case where a stale emission is most likely and least visible. An earlier
// revision flattened the identity into a single "name rev N" label before handing it to a
// projection, which made the join a string comparison over a spelling this module happened to
// choose — and let a caller pass any string at all where the source article belonged.
fn article_identity_eq(a: BoardArticleIdentity, b: BoardArticleIdentity) -> Bool {
  (a.name as String) == (b.name as String) && (a.revision as String) == (b.revision as String)
}

// RUNG-HONEST NAMES. An earlier revision called these article_is_physically_realizable and
// article_is_manufacturable, which overclaimed in both directions: carrying an outline is not a
// physical realization, and selecting a fabricator profile establishes only which artifact
// semantics that recipient consumes — not that the article has geometry, placement, routes,
// stackup, a BOM, or any emitted artifact at all.
fn article_physical_interface_admitted(a: BoardPowerInterfaceArticle) -> Bool {
  match a.physical {
    PhysicalRealizationAdmitted { outline: _ } => true
    PhysicalRealizationPending { causes: _ } => false
  }
}

fn article_manufacturing_profile_selected(a: BoardPowerInterfaceArticle) -> Bool {
  match a.manufacturing {
    ManufacturingProfileSelected { fabricator: _, authority: _ } => true
    ManufacturingProfileUnselected { pending: _ } => false
  }
}

// THE CONCRETE ARTICLE, IN THE PRODUCT LAYER. An earlier revision declared the only instance
// inside a witness module, so the production authority had no production instance and every
// claim about "one article feeding both projections" was a statement about a test fixture. A
// root that exists only in its own test is not a root.
// The instance identity carries NO element letter. SPICE derives 'R' from the constructor, so an
// identity spelled "R1" would emit "RR1" — and the fix is not to strip a prefix at emission but to
// keep the target's naming convention out of the identity in the first place.
// TWO RESISTORS, BECAUSE ONE WAS NOT A CIRCUIT. An earlier revision had a single resistor and a
// capacitor both spanning pg_raw to return — in PARALLEL, with no node between them. That is not
// an RC low-pass and not a conditioner: it is a load and a decoupling cap sharing a rail. It
// solved in ngspice and gave a discriminating operating point, which is exactly why it survived;
// the operating point was a fact about the resistor, not about a conditioning network that did
// not exist. It could not have become copper unchanged, because there was nothing to route to the
// FPGA input.
//
// The divider brings a 12 V rail into the FPGA's input range and establishes the conditioned node
// the capacitor filters. Thevenin resistance at that node is the parallel combination, so the two
// values decide both the level AND the time constant — which is why they are a design pair rather
// than one resistor with a second added beside it.
data pg_divider_top: product.compute_board.analog.ElectricalComponentInstance = product.compute_board.analog.ResistorInstance {
  identity: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_top"),
  part: "power-good divider, upper leg",
  positive_terminal: "1" as product.electrical.connectivity.TerminalIdentity,
  negative_terminal: "2" as product.electrical.connectivity.TerminalIdentity,
  resistance: std.measure.Measure { count: 30 },
}

data pg_divider_bottom: product.compute_board.analog.ElectricalComponentInstance = product.compute_board.analog.ResistorInstance {
  identity: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_bot"),
  part: "power-good divider, lower leg",
  positive_terminal: "1" as product.electrical.connectivity.TerminalIdentity,
  negative_terminal: "2" as product.electrical.connectivity.TerminalIdentity,
  resistance: std.measure.Measure { count: 10 },
}

data pg_conditioning_capacitor: product.compute_board.analog.ElectricalComponentInstance = product.compute_board.analog.CapacitorInstance {
  identity: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_filt"),
  part: "power-good conditioning capacitor",
  positive_terminal: "1" as product.electrical.connectivity.TerminalIdentity,
  negative_terminal: "2" as product.electrical.connectivity.TerminalIdentity,
  capacitance: std.measure.Measure { count: 100 },
}

data logic_supply_source: product.compute_board.analog.ElectricalComponentInstance = product.compute_board.analog.IndependentVoltageSourceInstance {
  identity: component_instance_identity(design: board_power_interlock_design, local_identity: "logic_in"),
  part: "logic supply input",
  positive_terminal: "1" as product.electrical.connectivity.TerminalIdentity,
  negative_terminal: "2" as product.electrical.connectivity.TerminalIdentity,
  potential_difference: std.measure.Measure { count: 12 },
}

data pg_raw_net: product.electrical.connectivity.NetIdentity = net_identity(design: board_power_interlock_design, local_identity: "pg_raw")

// THE NODE THE WHOLE ARTICLE IS ABOUT, and it did not previously exist. This is what the divider
// produces, what the capacitor filters, and what the digital interlock's conditioned_good input
// observes — one net joining the analog and digital halves that were formerly unconnected.
data pg_conditioned_net: product.electrical.connectivity.NetIdentity = net_identity(design: board_power_interlock_design, local_identity: "pg_cond")

data power_return_net: product.electrical.connectivity.NetIdentity = net_identity(design: board_power_interlock_design, local_identity: "power_return")

data power_good_conditioning_intent: product.compute_board.analog.AnalogCircuitIntent = product.compute_board.analog.AnalogCircuitIntent {
  title: "power-good conditioning network",
  components: [logic_supply_source, pg_divider_top, pg_divider_bottom, pg_conditioning_capacitor],
  nets: [
    product.electrical.connectivity.ElectricalNet {
      identity: pg_raw_net,
      members: [
        terminal_ref(component: component_instance_identity(design: board_power_interlock_design, local_identity: "logic_in"), terminal: "1" as product.electrical.connectivity.TerminalIdentity),
        terminal_ref(component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_top"), terminal: "1" as product.electrical.connectivity.TerminalIdentity),
      ],
    },
    product.electrical.connectivity.ElectricalNet {
      identity: pg_conditioned_net,
      members: [
        terminal_ref(component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_top"), terminal: "2" as product.electrical.connectivity.TerminalIdentity),
        terminal_ref(component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_bot"), terminal: "1" as product.electrical.connectivity.TerminalIdentity),
        terminal_ref(component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_filt"), terminal: "1" as product.electrical.connectivity.TerminalIdentity),
      ],
    },
    product.electrical.connectivity.ElectricalNet {
      identity: power_return_net,
      members: [
        terminal_ref(component: component_instance_identity(design: board_power_interlock_design, local_identity: "logic_in"), terminal: "2" as product.electrical.connectivity.TerminalIdentity),
        terminal_ref(component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_bot"), terminal: "2" as product.electrical.connectivity.TerminalIdentity),
        terminal_ref(component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_filt"), terminal: "2" as product.electrical.connectivity.TerminalIdentity),
      ],
    },
  ],
}

data power_good_model_bindings: List<product.compute_board.analog.ComponentModelBinding> = [
  product.compute_board.analog.ComponentModelBinding {
    component: component_instance_identity(design: board_power_interlock_design, local_identity: "logic_in"),
    standing: product.compute_board.analog.ElectricalModelCited { model_card: "ideal independent source at declared fidelity", fidelity: IdealLumped },
  },
  product.compute_board.analog.ComponentModelBinding {
    component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_top"),
    standing: product.compute_board.analog.ElectricalModelCited { model_card: "ideal lumped passive at declared fidelity", fidelity: IdealLumped },
  },
  product.compute_board.analog.ComponentModelBinding {
    component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_bot"),
    standing: product.compute_board.analog.ElectricalModelCited { model_card: "ideal lumped passive at declared fidelity", fidelity: IdealLumped },
  },
  product.compute_board.analog.ComponentModelBinding {
    component: component_instance_identity(design: board_power_interlock_design, local_identity: "pg_filt"),
    standing: product.compute_board.analog.ElectricalModelCited { model_card: "ideal lumped passive at declared fidelity", fidelity: IdealLumped },
  },
]

data power_interlock_article: BoardPowerInterfaceArticle = BoardPowerInterfaceArticle {
  identity: BoardArticleIdentity { name: "board power interlock", revision: "0" },
  analog: power_good_conditioning_intent,
  model_bindings: power_good_model_bindings,
  reference_net: power_return_net,
  digital_control: board_power_interlock_intent,
  bonds: board_power_interlock_bonds,
  platform_firmware: board_power_interlock_firmware_contract,
  physical: board_power_interlock_physical,
  manufacturing: board_power_interlock_manufacturing,
}
