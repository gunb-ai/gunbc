module product.compute_board.article

import std.types { String, NonEmptyStr, List }
import extdeps.external_authority { ExternalAuthority }
import product.compute_board.digital_control {
  DigitalControlIntent,
  SignalName,
  board_power_interlock_intent,
}
import product.compute_board.spice_projection { BoardSlice }

data article_note: String = "ONE ARTICLE IDENTITY FEEDING EVERY INTERFACE. The analog slice, the digital control, the bonding topology, the platform-firmware contract and the physical and manufacturing standings are fields of ONE root, so a projection cannot quietly acquire its own private copy of the board. That is the property the whole design turns on and it is the one that decays silently: two projections each holding their own fixture agree until someone edits one of them, and nothing reports the divergence because there was never a shared referent to disagree with. THE ARTICLE IS DELIBERATELY SMALL — a two-rail power-good and reset interlock — and is a real future motherboard subassembly rather than a demonstration. It does not claim to implement the Altra power sequence; it crosses every interface that sequence will need, which is a different and more useful thing to have finished."

// ELECTRICAL REFERENCES ARE NOT ONE THING, and fusing them into a single `Ground` is the
// modelling error this type exists to prevent. A power return, a signal reference, a chassis
// bond, protective earth and a cable-shield termination are five distinct relations with
// different currents, different safety consequences and different physical realizations. They
// are routinely all drawn with the same triangle and then discovered to be different during
// bring-up, or worse, after an incident.
//
// The mounting-hole case is the one worth stating explicitly: a metal standoff bonds the board
// to chassis ONLY when a declared bonding relation says it does. Mechanical support and
// electrical bonding are separate facts about the same hole, and a model that infers the second
// from the first has decided a safety property by accident.
type ElectricalBond
  = PowerReturnConnection { domain: NonEmptyStr, terminal: NonEmptyStr }
  | SignalReferenceConnection { signal_class: NonEmptyStr, terminal: NonEmptyStr }
  | ChassisBond { board_feature: NonEmptyStr, chassis_feature: NonEmptyStr }
  | ProtectiveEarthBond { chassis_feature: NonEmptyStr, earth_source: NonEmptyStr }
  | ShieldTermination { shield: NonEmptyStr, chassis_feature: NonEmptyStr }

// Board-level preconditions for host firmware to START. These are facts the BOARD establishes,
// and the distinction from what firmware then DOES is load-bearing: PowerPermitAsserted and
// ResetReleased are observable at the board, while "UEFI executed", "DDR trained" and "devices
// enumerated" are later observations belonging to entirely different subjects. A contract that
// let the first imply the second would report a booting machine on the strength of a released
// reset line.
type HostFirmwareStartPrecondition
  = PowerPermitAsserted
  | ResetReleased
  | BootStorageReadable
  | RecoveryRequestObservable
  | ConsoleAvailable

// Trust standing is declared honestly and cannot be overstated by omission. There is no
// "signed" arm here at all: production signing is not available to this project today, so the
// state that would claim it has no constructor rather than an unset field someone later reads
// as true.
type DevelopmentTrustPolicy
  = DevelopmentUnsigned
  | DevelopmentTestKey { key_identity: NonEmptyStr }
  | ProductionSigningUnavailable { reason: NonEmptyStr }

// The SPI-NOR boundary is first-class rather than generic "BIOS flash" prose because its access
// and write-protection policy has had real security consequences on this exact processor family.
// Update access, write protection and recovery are therefore separate declared facts.
type FirmwareWriteProtection
  = WriteProtectionUnmodelled { reason: NonEmptyStr }
  | HardwareWriteProtect { control: NonEmptyStr }

type PlatformFirmwareContract {
  start_preconditions: List<HostFirmwareStartPrecondition>
  boot_storage: NonEmptyStr
  reset_owner: NonEmptyStr
  console: NonEmptyStr
  recovery_path: NonEmptyStr
  write_protection: FirmwareWriteProtection
  trust: DevelopmentTrustPolicy
}

// The physical interface EXISTS with an exact pending obligation rather than being absent. An
// omitted interface reads as "not needed"; a pending one names what it is waiting for and on
// whom. The cause here is precise and is an operator decision, not engineering work:
// std.measure's Millimeter is Measure<Length, Milli, Nat> — unsigned integer millimetres — so a
// board-local frame with an interior origin is not representable, and pad and trace geometry
// needs signed sub-millimetre coordinates. That is a single-authority change to std.measure.
type PhysicalRealizationStanding
  = PhysicalRealizationPending { cause: NonEmptyStr }
  | PhysicalRealizationAdmitted { outline: NonEmptyStr }

type ManufacturingRealizationStanding
  = ManufacturingProfileUnselected { pending: NonEmptyStr }
  | ManufacturingProfileSelected { fabricator: NonEmptyStr, authority: ExternalAuthority }

type BoardArticleIdentity {
  name: NonEmptyStr
  revision: NonEmptyStr
}

type BoardPowerInterfaceArticle {
  identity: BoardArticleIdentity
  analog_slice: BoardSlice
  digital_control: DigitalControlIntent
  bonds: List<ElectricalBond>
  platform_firmware: PlatformFirmwareContract
  physical: PhysicalRealizationStanding
  manufacturing: ManufacturingRealizationStanding
}

data board_power_interlock_firmware_contract: PlatformFirmwareContract = PlatformFirmwareContract {
  start_preconditions: [PowerPermitAsserted, ResetReleased, RecoveryRequestObservable],
  boot_storage: "host SPI-NOR, addressed by the platform firmware contract rather than by this board",
  reset_owner: "board interlock asserts reset_release; the host owns everything after it",
  console: "serial console header",
  recovery_path: "recovery request input observable at the interlock",
  write_protection: WriteProtectionUnmodelled {
    reason: "SPI-NOR write-protect control is a host-board fact this article does not carry; it is declared unmodelled rather than defaulted to protected",
  },
  trust: ProductionSigningUnavailable {
    reason: "no production signing authority exists for this project; development builds are unsigned and no key material is modelled",
  },
}

data board_power_interlock_bonds: List<ElectricalBond> = [
  PowerReturnConnection { domain: "logic supply", terminal: "power return terminal" },
  SignalReferenceConnection { signal_class: "power-good conditioning network", terminal: "power return terminal" },
  ChassisBond { board_feature: "mounting hole 1", chassis_feature: "chassis standoff 1" },
]

data board_power_interlock_physical: PhysicalRealizationStanding = PhysicalRealizationPending {
  cause: "requires an exact board-scale coordinate carrier; std.measure Millimeter is unsigned integer millimetres and cannot express a board-local frame with an interior origin or sub-millimetre pad geometry",
}

data board_power_interlock_manufacturing: ManufacturingRealizationStanding = ManufacturingProfileUnselected {
  pending: "no fabricator selected; the artifact set a profile would carry is modelled at extdeps.ipc.dpmx and extdeps.ucamco.gerber, and which semantics survive is decided by the selected fabricator's capability profile",
}

fn article_digital_control(a: BoardPowerInterfaceArticle) -> DigitalControlIntent {
  a.digital_control
}

fn article_analog_slice(a: BoardPowerInterfaceArticle) -> BoardSlice {
  a.analog_slice
}

fn article_is_physically_realizable(a: BoardPowerInterfaceArticle) -> Bool {
  match a.physical {
    PhysicalRealizationAdmitted { outline: _ } => true
    PhysicalRealizationPending { cause: _ } => false
  }
}

fn article_is_manufacturable(a: BoardPowerInterfaceArticle) -> Bool {
  match a.manufacturing {
    ManufacturingProfileSelected { fabricator: _, authority: _ } => true
    ManufacturingProfileUnselected { pending: _ } => false
  }
}
