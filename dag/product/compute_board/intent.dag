module product.compute_board.intent


data compute_board_intent_note: String = "THE MACHINE CONTRACT, WHICH IS WHERE A BOARD DESIGN STARTS INSTEAD OF A FEATURE CHECKLIST. Every element of a resolved board must trace to a capability required here or to a constraint some selected component imposes; an element that traces to neither is unearned and must not be in the design. THE TWO STRUCTURAL CHECKS THIS BUYS, and the reason the contract is modelled rather than written in prose: removing an element must identify the obligation that becomes unsatisfied, and an element whose removal breaks no obligation is detectable rather than debatable. WHAT THIS TYPE DELIBERATELY DOES NOT DECIDE: it names capabilities, never realizations. 'Needs one boot-storage path' is a requirement; 'has an M.2 connector' is a choice made downstream against authorities, and fusing the two here would smuggle a component selection into the contract that is supposed to justify it. FEATURE-MINIMAL IS NOT COST-MINIMAL, so this contract carries no instruction to minimize part count: deleting a small support device can force more layers, harder routing, more firmware, or a worse process, and the quantity that actually matters is total realized cost. Nothing here optimizes anything; it only fixes what must be true."

// The capability axis of a compute node, closed deliberately. This is OUR product contract,
// not an upstream taxonomy, so a closed enum is the right shape: a new capability is a
// considered widening of what we build, not an open extension point. Expansion estates
// (general-purpose slots, SATA/RAID, audio, display, broad USB, legacy I/O) are absent from
// the axis rather than present and disabled — an omitted feature must be unrepresentable, not
// carried as `enabled: false`, or the type keeps describing a machine we are not building.
type BoardCapability
  = Compute
  | MemorySubsystem
  | Networking
  | BootStorage
  | Management
  | PowerBoundary
  | CoolingContract
  | FirmwareInterface
  | DebugAndManufacture
  | Mechanics

// A requirement is the capability PLUS the quantity that makes it checkable. An unquantified
// requirement cannot refuse anything, which is how a contract decays into a wish list.
type CapabilityRequirement
  = ComputeCores { minimum_cores: std.measure.HardwareThreadCount }
  | MemoryCapacity { minimum_capacity: std.measure.ByteSize }
  | NetworkPaths { minimum_paths: std.nat.Nat }
  | BootStoragePaths { minimum_paths: std.nat.Nat }
  | RemoteManagement { power_control: Bool, console: Bool, recovery: Bool }
  | PowerInputBoundary { boundary: std.types.NonEmptyStr }
  | CoolingBoundary { boundary: std.types.NonEmptyStr }
  | FirmwareInterfaceSurface { boot_flash: Bool, write_protect: Bool, recovery_path: Bool }
  | ManufactureAndBringUp { programming_surface: Bool, test_access: Bool }
  | MechanicalEnvelope { envelope: std.types.NonEmptyStr }

fn requirement_capability(r: CapabilityRequirement) -> BoardCapability {
  match r {
    ComputeCores { minimum_cores: _ } => Compute
    MemoryCapacity { minimum_capacity: _ } => MemorySubsystem
    NetworkPaths { minimum_paths: _ } => Networking
    BootStoragePaths { minimum_paths: _ } => BootStorage
    RemoteManagement { power_control: _, console: _, recovery: _ } => Management
    PowerInputBoundary { boundary: _ } => PowerBoundary
    CoolingBoundary { boundary: _ } => CoolingContract
    FirmwareInterfaceSurface { boot_flash: _, write_protect: _, recovery_path: _ } => FirmwareInterface
    ManufactureAndBringUp { programming_surface: _, test_access: _ } => DebugAndManufacture
    MechanicalEnvelope { envelope: _ } => Mechanics
  }
}

// Equality via ONE ordinal projection rather than a ten-by-ten nested match. The nested form
// carried a wildcard arm per row, which meant a new capability compared unequal to everything
// including itself in nine of them and nobody would hear about it. Here a new variant is a
// typecheck failure in exactly one place, and equality is derived from the ordinal rather than
// being restated per pair.
fn capability_ordinal(c: BoardCapability) -> Int {
  match c {
    Compute => 0
    MemorySubsystem => 1
    Networking => 2
    BootStorage => 3
    Management => 4
    PowerBoundary => 5
    CoolingContract => 6
    FirmwareInterface => 7
    DebugAndManufacture => 8
    Mechanics => 9
  }
}

fn capability_eq(a: BoardCapability, b: BoardCapability) -> Bool {
  capability_ordinal(c: a) == capability_ordinal(c: b)
}

type ComputeBoardIntent {
  workload: std.types.NonEmptyStr
  requirements: List<CapabilityRequirement>
}

// The minimal narrow compute node this program targets. Quantities are the contract's, not a
// component's: no part has been chosen here, and none may be inferred from these rows.
data narrow_compute_node_intent: ComputeBoardIntent = ComputeBoardIntent {
  workload: "serve web workloads on a headless rack-resident compute node",
  requirements: [
    ComputeCores { minimum_cores: std.measure.hardware_thread_count(128) },
    MemoryCapacity { minimum_capacity: std.measure.byte_size(274877906944) },
    NetworkPaths { minimum_paths: 1 },
    BootStoragePaths { minimum_paths: 1 },
    RemoteManagement { power_control: true, console: true, recovery: true },
    PowerInputBoundary { boundary: "single DC input from rack power distribution" },
    CoolingBoundary { boundary: "chassis-owned forced air; board owns sensing and failsafe only" },
    FirmwareInterfaceSurface { boot_flash: true, write_protect: true, recovery_path: true },
    ManufactureAndBringUp { programming_surface: true, test_access: true },
    MechanicalEnvelope { envelope: "single-socket board within one rack-unit chassis" },
  ]
}
