module product.compute_board.digital_control

import std.types { String, NonEmptyStr, List }

data digital_control_note: String = "THE BOARD'S DIGITAL CONTROL INTENT, LANGUAGE-NEUTRAL BY CONSTRUCTION. This is what a board-management interlock DOES, expressed as signals and equations; it names no target language and carries no target syntax. There is no body_lexeme here and no place to put one: an equation is a tree over signal references and boolean operators, so 'assign power_permit = conditioned_good & ~fault;' cannot be authored at this layer — it can only be DERIVED by a projection that owns Verilog spelling. THE REASON THIS MATTERS more than it looks: the moment a target string can be written in the intent, the intent stops being the authority and becomes a container for pre-rendered output, and every other projection of the same board silently disagrees with it. SIGNAL IDENTITY IS A BRANDED NAME, not a substrate Symbol, and that is a deliberate departure from how v2.extdeps.formats.spice does it. That module carries a hand-written Symbol-to-spelling table covering exactly r1/c1/v1/n1/n2, because the substrate offers no general projection from a Symbol to its text — so anything it emits is bounded by a five-entry lookup nobody can extend without editing the language module. A branded identifier carries its own spelling, is validated at construction, and needs no such table."

// A LOGICAL signal identity. It is a nominal brand and nothing more, and an earlier revision of
// this comment claimed otherwise — it said validity was checked at construction so an
// unrenderable name could not reach a projection. That was false: `where brand(...)` is the same
// naming brand the corpus uses for CacheInterfaceId and ArtifactKindId, and it validates nothing.
// A space, a newline or a target keyword constructs one fine.
//
// The correction is not to bolt a predicate onto this type, because target legality is not a
// property of a logical signal at all: a name legal in Verilog may be illegal elsewhere. Identity
// and target spelling are separate facts, joined per target — see the binding table in
// product.compute_board.verilog_projection, which is where Verilog lexical admission belongs.
type SignalName = NonEmptyStr where brand("SignalName")

type SignalDirection
  = DigitalInput
  | DigitalOutput

type DigitalSignal {
  name: SignalName
  direction: SignalDirection
}

// The expression tree. Deliberately three operators and a reference: this is the profile the
// first article consumes, and an operator absent from the type is one no projection has to
// refuse at emission time because it cannot be constructed upstream.
type DigitalExpr
  = SignalRef { signal: SignalName }
  | Negation { operand: DigitalExpr }
  | Conjunction { left: DigitalExpr, right: DigitalExpr }
  | Disjunction { left: DigitalExpr, right: DigitalExpr }

// A combinational equation: one driven output, one expression. Sequential behaviour — clocked
// state, event control, latches — has no constructor here. That is the honest bound: the
// profile does not model it, so it cannot be requested and silently mis-rendered as
// combinational logic.
type DigitalEquation {
  driven: SignalName
  expression: DigitalExpr
}

type DigitalControlIntent {
  block_name: SignalName
  signals: List<DigitalSignal>
  equations: List<DigitalEquation>
}

fn signal_direction_is_output(s: DigitalSignal) -> Bool {
  match s.direction {
    DigitalOutput => true
    DigitalInput => false
  }
}

fn signal_names_equal(a: SignalName, b: SignalName) -> Bool {
  (a as NonEmptyStr) == (b as NonEmptyStr)
}

fn intent_declares_signal(intent: DigitalControlIntent, name: SignalName) -> Bool {
  fold(intent.signals, init: false, f: fn(acc, s) {
    acc || signal_names_equal(a: s.name, b: name)
  })
}

fn expr_references_undeclared(intent: DigitalControlIntent, e: DigitalExpr) -> Bool {
  match e {
    SignalRef { signal: s } => !intent_declares_signal(intent: intent, name: s)
    Negation { operand: o } => expr_references_undeclared(intent: intent, e: o)
    Conjunction { left: l, right: r } =>
      expr_references_undeclared(intent: intent, e: l) || expr_references_undeclared(intent: intent, e: r)
    Disjunction { left: l, right: r } =>
      expr_references_undeclared(intent: intent, e: l) || expr_references_undeclared(intent: intent, e: r)
  }
}

// THE FIRST ARTICLE'S INTERLOCK. Power is permitted only when the conditioned power-good signal
// is asserted and no fault is present; the host reset releases only once power has been
// permitted. Both are stated as relations between named signals, which is why the same rows can
// feed a Verilog projection, a schematic projection and a firmware start-precondition contract
// without any of them being the authority for the others.
data conditioned_good_signal: SignalName = "conditioned_good" as SignalName

data fault_signal: SignalName = "fault" as SignalName

data power_permit_signal: SignalName = "power_permit" as SignalName

data reset_release_signal: SignalName = "reset_release" as SignalName

data board_power_interlock_intent: DigitalControlIntent = DigitalControlIntent {
  block_name: "board_power_interlock" as SignalName,
  signals: [
    DigitalSignal { name: conditioned_good_signal, direction: DigitalInput },
    DigitalSignal { name: fault_signal, direction: DigitalInput },
    DigitalSignal { name: power_permit_signal, direction: DigitalOutput },
    DigitalSignal { name: reset_release_signal, direction: DigitalOutput },
  ],
  equations: [
    DigitalEquation {
      driven: power_permit_signal,
      expression: Conjunction {
        left: SignalRef { signal: conditioned_good_signal },
        right: Negation { operand: SignalRef { signal: fault_signal } },
      },
    },
    DigitalEquation {
      driven: reset_release_signal,
      expression: Conjunction {
        left: SignalRef { signal: conditioned_good_signal },
        right: SignalRef { signal: power_permit_signal },
      },
    },
  ]
}
