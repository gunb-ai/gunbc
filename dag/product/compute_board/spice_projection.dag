module product.compute_board.spice_projection


data spice_projection_note: String = "SPICE AS A PROJECTION OF A LANGUAGE-NEUTRAL ANALOG INTENT. Every piece of SPICE spelling for this article lives in this module and nowhere upstream: the element letter, the node names, the reference node '0', and the magnitude SUFFIXES. That last one is the correction that mattered — an earlier revision carried value_lexeme: '10k' in the model, which is a SPICE spelling of a resistance, so the supposed authority was holding target syntax. The magnitude is now a typed measure and 'k' is derived here from the variant's declared scale. THE PRIOR SHAPE WAS WORSE THAN A STRAY STRING: the board article held a BoardSlice imported FROM this module, so the article depended on one of its own targets and 'the article feeds every interface' was true only because that interface had already decided what the article looked like. WHAT THIS MODULE REFUSES BEFORE EMITTING A BYTE: an element with no model binding at all, an element whose vendor model this profile cannot render, and a TERMINAL ON NO NET. That last refusal is not pedantry — a floating terminal and a grounded one are different circuits, and defaulting the first to the second emits a deck that simulates cleanly and describes a different board."

type SpiceProjectionRefusal
  = ElectricalModelUnavailable { part: std.types.NonEmptyStr }
  | ModelFidelityNotEmittable { part: std.types.NonEmptyStr, model_card: std.types.NonEmptyStr }
  | ComponentModelBindingMissing { part: std.types.NonEmptyStr }
  | TerminalOnNoNet { part: std.types.NonEmptyStr }
  | TerminalOnMultipleNets { part: std.types.NonEmptyStr }
  | DuplicateModelBinding { component: std.types.NonEmptyStr }
  | IdentityNotSpellableInTarget { component: std.types.NonEmptyStr }
  | NetNotSpellableInTarget { net: std.types.NonEmptyStr }

// The receipt carries the article identity, so an emission is traceable to the root that
// produced it. Without this, two unrelated articles with equal extracted fields produce
// indistinguishable output and 'one article feeds both projections' is a convention in a
// witness rather than a property of the types.
type SpiceEmissionReceipt {
  source_article: product.compute_board.article.BoardArticleIdentity
  source: String
}

type SpiceProjection
  = SpiceSliceProjected { receipt: SpiceEmissionReceipt }
  | SpiceSliceRefused { cause: SpiceProjectionRefusal }

// The element letter and the magnitude suffix now come from ONE match, because the kind and the
// value are one constructor upstream. The earlier pair of matches over two independent fields
// could disagree — a PassiveResistor carrying nanofarads emitted "R... 100n", a deck that
// simulates and describes a part nobody specified.
// THE DECK IS BUILT AS A NETLIST AND SERIALIZED BY THE FORMAT MODULE. Every byte of SPICE
// spelling this module used to author — the element letter, the reference node "0", the space
// between fields, the newline between lines and the "k"/"n" suffixes — was a second SPICE
// authority sitting in the product layer, exactly the fork the Verilog side removed when its
// printer was deleted. What remains here is the only thing that is genuinely a projection fact:
// which target scale each modelled quantity is spelled at.
fn component_node(
  intent: product.compute_board.analog.AnalogCircuitIntent,
  reference: product.electrical.connectivity.NetIdentity,
  c: product.compute_board.analog.ElectricalComponentInstance,
  positive: Bool
) -> v2.extdeps.formats.spice.NodeRef {
  let t = if positive {
    terminal_ref(component: component_identity(c: c), terminal: component_positive_terminal(c: c))
  } else {
    terminal_ref(component: component_identity(c: c), terminal: component_negative_terminal(c: c))
  }
  match net_of_terminal(intent: intent, t: t) {
    Absent => Ground
    Present { value: n } =>
      if net_identity_eq(a: n, b: reference) {
        Ground
      } else {
        v2.extdeps.formats.spice.Named { node: v2.extdeps.formats.spice.NamedNode { name: net_local_label(n: n) as String } }
      }
  }
}

fn spice_component(
  intent: product.compute_board.analog.AnalogCircuitIntent,
  reference: product.electrical.connectivity.NetIdentity,
  c: product.compute_board.analog.ElectricalComponentInstance
) -> v2.extdeps.formats.spice.Component {
  let plus = component_node(intent: intent, reference: reference, c: c, positive: true)
  let minus = component_node(intent: intent, reference: reference, c: c, positive: false)
  let name = component_local_label(c: component_identity(c: c)) as String
  match c {
    ResistorInstance { identity: _, part: _, positive_terminal: _, negative_terminal: _, resistance: m } =>
      v2.extdeps.formats.spice.Resistor { name: name, n_plus: plus, n_minus: minus, value: v2.extdeps.formats.spice.spice_scaled_value(magnitude: to_string(measure_count(m)), suffix: v2.extdeps.formats.spice.SpiceKilo) }
    CapacitorInstance { identity: _, part: _, positive_terminal: _, negative_terminal: _, capacitance: m } =>
      v2.extdeps.formats.spice.Capacitor { name: name, n_plus: plus, n_minus: minus, value: v2.extdeps.formats.spice.spice_scaled_value(magnitude: to_string(measure_count(m)), suffix: v2.extdeps.formats.spice.SpiceNano) }
    IndependentVoltageSourceInstance { identity: _, part: _, positive_terminal: _, negative_terminal: _, potential_difference: m } =>
      v2.extdeps.formats.spice.VoltageSource { name: name, n_plus: plus, n_minus: minus, value: v2.extdeps.formats.spice.spice_scaled_value(magnitude: to_string(measure_count(m)), suffix: v2.extdeps.formats.spice.SpiceUnitScale) }
  }
}

fn spice_netlist(intent: product.compute_board.analog.AnalogCircuitIntent, reference: product.electrical.connectivity.NetIdentity) -> v2.extdeps.formats.spice.SpiceNetlist {
  v2.extdeps.formats.spice.SpiceNetlist {
    title: intent.title as String,
    body: fold(intent.components, init: std.algebra.Empty, f: fn(acc, c) {
      v2.std.algebra.list_snoc_item(xs: acc, item: v2.extdeps.formats.spice.DeckComponent { component: spice_component(intent: intent, reference: reference, c: c) })
    }),
  }
}

fn binding_for(bindings: List<product.compute_board.analog.ComponentModelBinding>, c: product.compute_board.analog.ElectricalComponentInstance) -> product.compute_board.analog.ElectricalModelStanding? {
  fold(bindings, init: none, f: fn(acc, b) {
    match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        if component_identity_eq(a: b.component, b: component_identity(c: c)) { Present { value: b.standing } } else { none }
    }
  })
}

// HOW MANY bindings claim this component. binding_for answers with the FIRST match, so two rows
// disagreeing about one component's model resolved silently by list order — an ideal-lumped row
// and a vendor-subcircuit row for the same part emit or refuse depending on which was authored
// first, which is a verdict decided by an editing accident. Ambiguity is not a model standing
// and is refused rather than resolved.
fn binding_count(bindings: List<product.compute_board.analog.ComponentModelBinding>, c: product.compute_board.analog.ElectricalComponentInstance) -> std.nat.Nat {
  fold(bindings, init: 0, f: fn(acc, b) {
    if component_identity_eq(a: b.component, b: component_identity(c: c)) { acc + 1 } else { acc }
  })
}

fn standing_refusal(c: product.compute_board.analog.ElectricalComponentInstance, s: product.compute_board.analog.ElectricalModelStanding) -> SpiceProjectionRefusal? {
  match s {
    ElectricalModelAbsent => Present { value: ElectricalModelUnavailable { part: component_part(c: c) } }
    ElectricalModelCited { model_card: mc, fidelity: f } =>
      match f {
        IdealLumped => none
        VendorSubcircuit => Present { value: ModelFidelityNotEmittable { part: component_part(c: c), model_card: mc } }
      }
  }
}

// A terminal sits in exactly one of three states and they have DIFFERENT remedies: on no net
// (floating), on one net (netted), or on several (shorted between them). The earlier check was a
// Bool over "did net_of_terminal answer", which collapsed the third into the second — so a
// terminal shorting two nets emitted a deck naming whichever net was authored first, and the
// deck simulated cleanly while describing a board that is not the one modelled. That is the
// exact failure this module's note claims to prevent for the floating case, left open for the
// shorted one.
fn terminal_netting_refusal(
  intent: product.compute_board.analog.AnalogCircuitIntent,
  c: product.compute_board.analog.ElectricalComponentInstance,
  t: product.electrical.connectivity.ElectricalTerminalRef
) -> SpiceProjectionRefusal? {
  let n = net_membership_count(intent: intent, t: t)
  if n == 0 {
    Present { value: TerminalOnNoNet { part: component_part(c: c) } }
  } else {
    if n == 1 { none } else { Present { value: TerminalOnMultipleNets { part: component_part(c: c) } } }
  }
}

fn terminals_netting_refusal(
  intent: product.compute_board.analog.AnalogCircuitIntent,
  c: product.compute_board.analog.ElectricalComponentInstance
) -> SpiceProjectionRefusal? {
  fold(component_terminals(c: c), init: none, f: fn(acc, t) {
    match acc {
      Present { value: r } => Present { value: r }
      Absent => terminal_netting_refusal(intent: intent, c: c, t: t)
    }
  })
}

fn component_refusal(
  intent: product.compute_board.analog.AnalogCircuitIntent,
  bindings: List<product.compute_board.analog.ComponentModelBinding>,
  c: product.compute_board.analog.ElectricalComponentInstance
) -> SpiceProjectionRefusal? {
  if binding_count(bindings: bindings, c: c) > 1 {
    Present { value: DuplicateModelBinding { component: component_local_label(c: component_identity(c: c)) } }
  } else {
    match binding_for(bindings: bindings, c: c) {
      Absent => Present { value: ComponentModelBindingMissing { part: component_part(c: c) } }
      Present { value: s } =>
        match standing_refusal(c: c, s: s) {
          Present { value: r } => Present { value: r }
          Absent => terminals_netting_refusal(intent: intent, c: c)
        }
    }
  }
}

fn first_refusal(
  intent: product.compute_board.analog.AnalogCircuitIntent,
  bindings: List<product.compute_board.analog.ComponentModelBinding>
) -> SpiceProjectionRefusal? {
  fold(intent.components, init: none, f: fn(acc, c) {
    match acc {
      Present { value: r } => Present { value: r }
      Absent => component_refusal(intent: intent, bindings: bindings, c: c)
    }
  })
}

// A NAME THIS FORMAT CANNOT SPELL IS REFUSED, not repaired. The format module admits an
// identifier or answers Absent, and an Absent name renders as the empty string inside the deck —
// so the refusal has to happen here, before a line is built, or a component silently loses its
// name and the deck describes a different circuit.
fn spelling_refusal(c: product.compute_board.analog.ElectricalComponentInstance) -> SpiceProjectionRefusal? {
  if v2.extdeps.formats.spice.spice_identifier_is_admissible(spelling: component_local_label(c: component_identity(c: c)) as String) {
    none
  } else {
    Present { value: IdentityNotSpellableInTarget { component: component_local_label(c: component_identity(c: c)) } }
  }
}

fn net_spelling_refusal(intent: product.compute_board.analog.AnalogCircuitIntent, reference: product.electrical.connectivity.NetIdentity) -> SpiceProjectionRefusal? {
  fold(intent.nets, init: none, f: fn(acc, net) {
    match acc {
      Present { value: r } => Present { value: r }
      Absent =>
        if net_identity_eq(a: net.identity, b: reference) || v2.extdeps.formats.spice.spice_identifier_is_admissible(spelling: net_local_label(n: net.identity) as String) {
          none
        } else {
          Present { value: NetNotSpellableInTarget { net: net_local_label(n: net.identity) } }
        }
    }
  })
}

// THE RUNNABLE DECK IS A SECOND PROJECTION OF THE SAME NETLIST, not a second netlist. What an
// analysis directive adds is a question to ask the simulator — an operating point, here — and
// that is a fact about a RUN rather than about the board, which is why the receipt's deck does
// not carry one. Both come from spice_netlist, so a run cannot exercise a circuit the receipt
// does not describe.
fn first_refusal_or_net_spelling(
  intent: product.compute_board.analog.AnalogCircuitIntent,
  bindings: List<product.compute_board.analog.ComponentModelBinding>,
  reference: product.electrical.connectivity.NetIdentity
) -> SpiceProjectionRefusal? {
  match net_spelling_refusal(intent: intent, reference: reference) {
    Present { value: r } => Present { value: r }
    Absent => product.compute_board.spice_projection.first_refusal(intent: intent, bindings: bindings)
  }
}

fn project_analog_to_spice(
  article_identity: product.compute_board.article.BoardArticleIdentity,
  intent: product.compute_board.analog.AnalogCircuitIntent,
  bindings: List<product.compute_board.analog.ComponentModelBinding>,
  reference: product.electrical.connectivity.NetIdentity
) -> SpiceProjection {
  match first_refusal_or_net_spelling(intent: intent, bindings: bindings, reference: reference) {
    Present { value: r } => SpiceSliceRefused { cause: r }
    Absent =>
      SpiceSliceProjected {
        receipt: SpiceEmissionReceipt {
          source_article: article_identity,
          source: v2.extdeps.formats.spice.spice_emit(netlist: spice_netlist(intent: intent, reference: reference)),
        },
      }
  }
}

// THE PRODUCTION ENTRY POINT, and the reason it takes the whole article rather than its parts.
// Every caller of project_analog_to_spice supplies the identity and the circuit SEPARATELY, so
// one article's identity paired with another article's circuit was perfectly constructible and
// the resulting receipt would name a board it does not describe. Taking the article closes that
// by construction: there is one value, and both facts are read out of it here.
fn project_article_to_spice(admitted: product.compute_board.admission.AdmittedBoardPowerInterfaceArticle) -> SpiceProjection {
  let article = product.compute_board.admission.admitted_article(a: admitted)
  project_analog_to_spice(
    article_identity: article.identity,
    intent: article.analog,
    bindings: article.model_bindings,
    reference: article.reference_net
  )
}

// IT RETURNS THE SAME COPRODUCT, THROUGH THE SAME GATE, and an earlier revision did not — it
// returned a bare String and built the netlist directly, so an article that admission accepts and
// this module REFUSES could still hand a runnable deck to a simulator. That is the exact fail-open
// the netting refusals exist to close, reopened on the second path: component_node maps a terminal
// on no net to Ground, so the bypassing deck would have simulated cleanly and described a
// different board. There is one refusal gate and both projections are behind it; a String return
// is what made the bypass possible, because a String has nowhere to put a refusal.
fn project_article_to_ngspice_run(admitted: product.compute_board.admission.AdmittedBoardPowerInterfaceArticle) -> SpiceProjection {
  let article = product.compute_board.admission.admitted_article(a: admitted)
  let intent = article.analog
  let reference = article.reference_net
  match first_refusal_or_net_spelling(intent: intent, bindings: article.model_bindings, reference: reference) {
    Present { value: r } => SpiceSliceRefused { cause: r }
    Absent =>
      SpiceSliceProjected {
        receipt: SpiceEmissionReceipt {
          source_article: article.identity,
          source: v2.extdeps.formats.spice.spice_emit_ngspice(netlist: v2.extdeps.formats.spice.SpiceNetlist {
            title: spice_netlist(intent: intent, reference: reference).title,
            body: v2.std.algebra.list_snoc_item(
              xs: spice_netlist(intent: intent, reference: reference).body,
              item: v2.extdeps.formats.spice.DeckDirective { directive: v2.extdeps.formats.spice.Op }
            ),
          }),
        },
      }
  }
}
