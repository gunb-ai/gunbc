module product.compute_board.emission_entry


data emission_entry_note: String = "THE ENTRY POINTS THAT ACTUALLY PRODUCE THE ARTIFACTS, AND THE REFUSAL THEY USED TO SWALLOW. Everything else in this product returns a typed projection that a witness inspects; these are the host boundary, where bytes leave. An earlier revision returned a bare String and answered a refusal with the literal 'REFUSED: article not admitted' — which is the fabricated plausible output DESIGN section 5 forbids, at the one seam where a caller is furthest from the model and least able to tell. It is also the identical defect this same lane had just fixed one layer down, where a String-returning ngspice entry bypassed the projection gate for exactly the same reason: a String has nowhere to put a refusal, so a refusal becomes prose that reads like a result. THE SHAPE: BoardEmission is parameterized by the target's own refusal type rather than fusing SPICE and Verilog causes into one coproduct, so adding a third target is an instantiation and not a widened enum. Admission refusal and projection refusal stay separate arms because they have different remedies — one means the board is incoherent, the other means this target cannot render a coherent board."

// EACH ENTRY TAKES THE ARTICLE, and the production one is a wrapper over it. That is not
// ceremony: entries hardwired to the production article have refusal arms no call can reach, so
// nothing can execute them and "it refuses" would be a claim about unexercised code. Taking the
// article means the same entry a host calls is the one a witness drives an incoherent board
// through — and the admission call stays inside, so a caller still cannot skip it.

// THE PARAMETER TAKES WHATEVER THE TARGET'S REFUSAL ACTUALLY IS, and getting that wrong is how a
// fact goes missing without the carrier being at fault. An earlier revision instantiated the pin
// chain at PinChainRefusal — one cause — while the pin chain reports a SET, so the entry passed
// cs.first and dropped every cause after the first: a board with a pin off the package AND an
// unassigned signal emitted one of the two, and the caller had no way to know a second existed.
// SPICE and Verilog really do produce one cause each, so their instantiation was right and the
// shape was never the problem; the pin chain is instantiated at its set.
//
// The refusal type is a PARAMETER because a SPICE cause and a Verilog cause are facts about
// different targets. Fusing them here would put every target's vocabulary in one enum that every
// caller has to match exhaustively, which is the widening a per-target authority exists to avoid.
type BoardEmission<R>
  = BoardEmitted { source: String }
  | BoardArticleNotAdmitted { causes: product.compute_board.admission.BoardArticleRefusalSet }
  | BoardTargetRefused { cause: R }

fn emit_spice_for(article: product.compute_board.article.BoardPowerInterfaceArticle) -> BoardEmission<product.compute_board.spice_projection.SpiceProjectionRefusal> {
  match product.compute_board.admission.admit_board_article(a: article) {
    product.compute_board.admission.BoardArticleRefused { causes: cs } => BoardArticleNotAdmitted { causes: cs }
    product.compute_board.admission.BoardArticleAdmitted { article: adm } =>
      match product.compute_board.spice_projection.project_article_to_spice(admitted: adm) {
        product.compute_board.spice_projection.SpiceSliceProjected { receipt: r } => BoardEmitted { source: r.source }
        product.compute_board.spice_projection.SpiceSliceRefused { cause: c } => BoardTargetRefused { cause: c }
      }
  }
}

fn emit_verilog_for(article: product.compute_board.article.BoardPowerInterfaceArticle) -> BoardEmission<product.compute_board.verilog_projection.VerilogProjectionRefusal> {
  match product.compute_board.admission.admit_board_article(a: article) {
    product.compute_board.admission.BoardArticleRefused { causes: cs } => BoardArticleNotAdmitted { causes: cs }
    product.compute_board.admission.BoardArticleAdmitted { article: adm } =>
      match product.compute_board.verilog_projection.project_article_to_verilog(admitted: adm, bindings: product.compute_board.verilog_projection.power_interlock_verilog_bindings) {
        product.compute_board.verilog_projection.VerilogModuleEmitted { receipt: r } => BoardEmitted { source: r.source }
        product.compute_board.verilog_projection.VerilogProjectionRefused { cause: c } => BoardTargetRefused { cause: c }
      }
  }
}

fn emit_ngspice_run_for(article: product.compute_board.article.BoardPowerInterfaceArticle) -> BoardEmission<product.compute_board.spice_projection.SpiceProjectionRefusal> {
  match product.compute_board.admission.admit_board_article(a: article) {
    product.compute_board.admission.BoardArticleRefused { causes: cs } => BoardArticleNotAdmitted { causes: cs }
    product.compute_board.admission.BoardArticleAdmitted { article: adm } =>
      match product.compute_board.spice_projection.project_article_to_ngspice_run(admitted: adm) {
        product.compute_board.spice_projection.SpiceSliceProjected { receipt: r } => BoardEmitted { source: r.source }
        product.compute_board.spice_projection.SpiceSliceRefused { cause: c } => BoardTargetRefused { cause: c }
      }
  }
}

fn emit_pin_constraints_for(
  article: product.compute_board.article.BoardPowerInterfaceArticle,
  realization: product.compute_board.device_binding.ProgrammableDeviceRealization,
  assignments: List<product.compute_board.device_binding.DevicePinAssignment>
) -> BoardEmission<product.compute_board.device_binding.PinChainRefusalSet> {
  match product.compute_board.admission.admit_board_article(a: article) {
    product.compute_board.admission.BoardArticleRefused { causes: cs } => BoardArticleNotAdmitted { causes: cs }
    product.compute_board.admission.BoardArticleAdmitted { article: adm } =>
      match product.compute_board.device_binding.project_article_to_pin_constraints(
        admitted: adm,
        realization: realization,
        bindings: product.compute_board.verilog_projection.power_interlock_verilog_bindings,
        assignments: assignments
      ) {
        product.compute_board.device_binding.PinConstraintsEmitted { receipt: r } => BoardEmitted { source: r.source }
        product.compute_board.device_binding.PinConstraintsRefused { causes: cs } => BoardTargetRefused { cause: cs }
      }
  }
}

// The production article, through the same entries. A host wanting this board's bytes calls
// these; nothing else in the product hardcodes it.
fn emit_spice() -> BoardEmission<product.compute_board.spice_projection.SpiceProjectionRefusal> {
  emit_spice_for(article: product.compute_board.article.power_interlock_article)
}

fn emit_verilog() -> BoardEmission<product.compute_board.verilog_projection.VerilogProjectionRefusal> {
  emit_verilog_for(article: product.compute_board.article.power_interlock_article)
}

fn emit_ngspice_run() -> BoardEmission<product.compute_board.spice_projection.SpiceProjectionRefusal> {
  emit_ngspice_run_for(article: product.compute_board.article.power_interlock_article)
}

fn emit_pin_constraints() -> BoardEmission<product.compute_board.device_binding.PinChainRefusalSet> {
  emit_pin_constraints_for(
    article: product.compute_board.article.power_interlock_article,
    realization: product.compute_board.device_binding.interlock_device_realization,
    assignments: product.compute_board.device_binding.interlock_pin_assignments
  )
}
