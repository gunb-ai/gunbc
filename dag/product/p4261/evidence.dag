// WHAT OUR RECORDS SUPPORT OF NVIDIA'S P4261 FACTS. A fact about the board -- which assembly part
// number, revision code and PCB code a revision carries -- is NVIDIA's, and lives upstream
// (extdeps.nvidia.p4261). What this repository did -- photograph a board's label and PCB print -- is
// ours, and lives with the specimen that was read (product.p4261.e1_b, product.p4261.k1_a). This
// module joins the two: for one upstream proposition and the specimen records bound to it, does the
// evidence support it? Placing the assessment here does not move the fact downstream; it answers a
// different question, what currently supports the fact, from which specimen.
//
// THE STANDING IS MINTED BY A FOLD, NEVER AUTHORED ONTO THE FACT. extdeps.external_authority
// ObservedByReceipt is sealed: each nullary fold below is admitted by name to observed_receipt, reads
// committed specimen records, and mints only when its own check passes; otherwise the upstream row's
// authored standing (TranscribedUncited, with what would ground it) stands.
//
// A RECEIPT IS BOUND TO ITS PROPOSITION. The check asks that the specimen be recorded against this
// very revision AND that its own label and PCB print both read it (product.p4261.findings
// assembly_revision_standing): a board of the other revision, or one whose label alone was read,
// supports nothing here, however authentic its photographs.
//
// WHAT THE SUPPORT DOES NOT SAY. One received board whose markings agree supports the revision row's
// identifiers as read on that unit; it is not a claim that every board of the revision is built
// alike, and no NVIDIA source names the P4261 (extdeps.nvidia.p4261).
//
// RUNG OF THE BINDING, STATED: the markings are transcribed from photographs into the corpus, so the
// fold executes on authored data -- a boundary transcription (DESIGN 4b, outside the modeled
// guarantee). NEXT-RUNG TRIGGER, as the capability: a photograph store whose content identity the
// specimen records cite, so a marking row is checkable against the image it was read from.

// Whether a specimen's own records support a revision row: recorded against it, and its label and PCB
// print both read and agree with it.
fn revision_supported(revision: P4261AssemblyRevision, specimen: CarrierLayoutObservation) -> Bool {
  p4261_revision_eq(a: specimen.revision, b: revision) && match assembly_revision_standing(layout: specimen) {
    RevisionReadOnBoard { revision: _ } => true
    _ => false
  }
}

fn p4261_e1_revision_standing() -> CitedFigureStanding {
  if revision_supported(revision: p4261_e1, specimen: p4261_e1_layout) {
    ObservedByReceipt { observed: observed_receipt(receipt: decl_ref(module_path: "product.p4261.e1_b", decl_name: "p4261_e1_layout")) }
  } else {
    p4261_e1.standing
  }
}

fn p4261_k1_revision_standing() -> CitedFigureStanding {
  if revision_supported(revision: p4261_k1, specimen: p4261_k1_layout) {
    ObservedByReceipt { observed: observed_receipt(receipt: decl_ref(module_path: "product.p4261.k1_a", decl_name: "p4261_k1_layout")) }
  } else {
    p4261_k1.standing
  }
}

// ── WHICH REVISION A HELD BOARD WAS BUILT TO ──────────────────────────────────────────────────

// THE RECEIVED BOARD IS NAMED BY ITS OWN LABEL. A label in a listing photograph names what was sold,
// possibly a sibling unit; only the operator's photograph of the board in hand names this one, so every
// consumer that labels the carrier reads it here rather than restating it. (Moved from
// product.p4261.findings in Stage B4: it judges what a board's markings support of NVIDIA's revision
// row, which is this layer's work, and findings now builds on this module.)
fn is_operator_photograph(e: EvidenceRef) -> Bool {
  match e {
    OperatorPhotograph { taken_on: _, locator: _ } => true
    _ => false
  }
}

fn is_received_label(m: BoardMarking) -> Bool {
  match m {
    AssemblyLabel { model: _, part_number: _, revision: _, serial: _, evidence } => is_operator_photograph(e: evidence)
    _ => false
  }
}

fn received_labels(layout: CarrierLayoutObservation) -> List<BoardMarking> {
  filter(layout.markings, m => is_received_label(m: m))
}

// WHICH REVISION A BOARD WAS BUILT TO IS READ OFF ITS OWN LABEL AND PCB PRINT. The record names the
// NVIDIA revision it claims (layout.revision, extdeps.nvidia.p4261). Any received-board marking that
// disagrees with the row wins, whatever else was read, so a board recorded against the wrong revision
// says so instead of inheriting another revision's identity. Agreement is reported only for what was
// read: the assembly label (part number and revision code) and the PCB print (PCB code) are separate
// evidence, and one agreeing does not stand for the other. A label only in a seller's listing is not
// the received board's (is_received_label).
type AssemblyRevisionStanding
  = RevisionReadOnBoard { revision: P4261AssemblyRevision }
  | RevisionLabelReadPcbUnread { revision: P4261AssemblyRevision }
  | RevisionPcbReadLabelUnread { revision: P4261AssemblyRevision }
  | RevisionContradictedOnBoard { revision: P4261AssemblyRevision, marking: BoardMarking }
  | RevisionUnreadOnBoard { revision: P4261AssemblyRevision }

fn is_received_pcb_print(m: BoardMarking) -> Bool {
  match m {
    PcbCode { code: _, printed_beside: _, evidence } => is_operator_photograph(e: evidence)
    _ => false
  }
}

fn is_revision_marking(m: BoardMarking) -> Bool {
  is_received_label(m: m) || is_received_pcb_print(m: m)
}

fn marking_contradicts_revision(m: BoardMarking, r: P4261AssemblyRevision) -> Bool {
  match m {
    AssemblyLabel { model, part_number, revision, serial: _, evidence: _ } =>
      !(model == r.model && part_number == r.assembly_part_number && revision == r.revision_code)
    PcbCode { code, printed_beside: _, evidence: _ } => !(code == r.pcb_code)
    _ => false
  }
}

fn assembly_revision_standing(layout: CarrierLayoutObservation) -> AssemblyRevisionStanding {
  let read = filter(layout.markings, m => is_revision_marking(m: m))
  let label_read = any(read, m => is_received_label(m: m))
  let pcb_read = any(read, m => is_received_pcb_print(m: m))
  match (filter(read, m => marking_contradicts_revision(m: m, r: layout.revision))).first() {
    Present { value: m } => RevisionContradictedOnBoard { revision: layout.revision, marking: m }
    Absent =>
      if label_read && pcb_read { RevisionReadOnBoard { revision: layout.revision } }
      else { if label_read { RevisionLabelReadPcbUnread { revision: layout.revision } }
      else { if pcb_read { RevisionPcbReadLabelUnread { revision: layout.revision } }
      else { RevisionUnreadOnBoard { revision: layout.revision } } } }
  }
}

// ── POPULATION: WHAT ONE BOARD'S OWN READINGS SAY OF A RECONSTRUCTED POPULATION CLAIM ─────────────
//
// A claim is NVIDIA's (extdeps.nvidia.p4261.population); what one held board's readings say of it is
// this assessment, scoped to that board and to one historical context of the position. Nothing is
// inferred from a designator's spelling, a revision's name, or another board.
//
// ATTRIBUTION FIRST. The board must be established as the claim's revision by its own label and PCB
// print (revision_supported, the Stage A judgment): a board merely recorded against a revision supplies
// nothing to that revision's claims. Then its admitted correspondence (product.p4261.carrier
// admit_correspondence) names which of our components sit at the claim's position.
//
// SCOPE: THE POSITION AS RECEIVED. A population claim is about what the position was built with, so the
// assessment reads the position before any recorded removal of a component admitted there. Each
// observation is placed against those removals (product.electrical.bench_session place_against): before
// all of them it is in scope; after one it belongs to a later context and is set aside; its order
// unstated, or an event reference unresolved, it is unplaced. A part seen before a removal later
// recorded as refitted stays in scope: the refit makes the states after it indistinguishable, not the
// state before it. Whether the observation saw a part at all is its own reading
// (product.electrical.identification observed_presence): present, absent, or unobserved.
//
// WITHIN SCOPE, READINGS MUST AGREE BEFORE THEY BEAR ON THE CLAIM. A part seen present and the footprint
// seen empty in the same context, or two markings establishing disjoint row sets, are the board's own
// conflict: returned as such, never resolved by picking one. So are two printed ratings reading one
// field differently; a field one leaves unread conflicts with nothing. An absence in scope contradicts the claim
// as the board was received; it does not show NVIDIA designed the position empty. An absence whose place
// is unknown blocks support, since it may be either.
//
// EACH PRESENT READING BEARS BY WHAT IT ESTABLISHES. A matched marking establishes one row, a code shared
// by makers the set of its rows; the claim names a row or a set. The reading supports the claim when its
// set lies within the claim's, contradicts it when the two are disjoint, and is otherwise undecided;
// candidates, unresolved markings and resistance codes establish no row. A rating claim is judged on
// the fields it asserts: a current read differently contradicts; an interrupt voltage the claim states
// and the body does not print is missing, not contradicted. A marking read only off the seller's
// listing photograph can contradict but never supports: the photograph is not ours. Any contradiction
// decides, whatever the order, and is returned beside the support it overrides.
type ObservationBearing
  = Supports
  | Undecided
  | Contradicts

type ObservationVerdict {
  observation: InstalledComponent
  bearing: ObservationBearing
}

// The one context assessed: the position as received, before every recorded removal (named) of a
// component admitted there.
type AssessmentScope = PositionAsReceived { before_removals: List<NonEmptyStr> }

type ScopedObservations {
  scope: AssessmentScope
  present: List<InstalledComponent>
  absent: List<InstalledComponent>
  later: List<InstalledComponent>
  unplaced: List<InstalledComponent>
  unobserved: List<InstalledComponent>
}

type AttributionGap
  = PositionOfAnotherRevision
  | RevisionNotEstablishedOnBoard
  | NoPopulationClaim
  | NoAdmittedReading
  | CensusOfAnotherConnector

type PopulationOutcome
  = SupportedOnSpecimen { supporting: List<InstalledComponent> }
  | EvidenceMissing { undecided: List<InstalledComponent>, unplaced: List<InstalledComponent> }
  | Contradicted { contradicting: List<InstalledComponent>, supporting: List<InstalledComponent> }
  | ObservationsConflict { observations: List<InstalledComponent> }
  | NotAttributable { gap: AttributionGap }

type PopulationAssessment {
  position: P4261DesignPosition
  asset: PhysicalAssetIdentity
  bindings: List<SpecimenPosition>
  scoped: ScopedObservations
  outcome: PopulationOutcome
}

fn row_in(rows: List<ElectronicComponentRow>, r: ElectronicComponentRow) -> Bool {
  any(rows, x => electronic_component_row_eq(a: x, b: r))
}

// Sets of rows, as sets: order and repetition never matter, and an empty set is never "disjoint".
fn rows_within(a: List<ElectronicComponentRow>, b: List<ElectronicComponentRow>) -> Bool {
  count(a) > 0 && all(a, x => row_in(rows: b, r: x))
}

fn rows_equal(a: List<ElectronicComponentRow>, b: List<ElectronicComponentRow>) -> Bool {
  rows_within(a: a, b: b) && rows_within(a: b, b: a)
}

fn rows_disjoint(a: List<ElectronicComponentRow>, b: List<ElectronicComponentRow>) -> Bool {
  count(a) > 0 && count(b) > 0 && !any(a, x => row_in(rows: b, r: x))
}

fn no_rows() -> List<ElectronicComponentRow> {
  []
}

// The row set a reading establishes: one matched row, or a shared code's rows; nothing else.
fn established_rows(i: ComponentIdentification) -> List<ElectronicComponentRow> {
  match i {
    IdentifiedByMarking { row, marking: _ } => [row]
    MarkingSharedByMakers { rows, marking: _ } => rows
    MarkingCandidate { row: _, marking: _, discriminator: _ } => no_rows()
    RatingPrintedOnBody { rating: _, marking: _ } => no_rows()
    ResistanceCodeRead { milliohms: _, marking: _ } => no_rows()
    MarkingUnresolved { marking: _, discriminator: _ } => no_rows()
    FootprintUnpopulated { evidence: _ } => no_rows()
  }
}

fn claimed_rows(claim: PopulatedPart) -> List<ElectronicComponentRow> {
  match claim {
    PartRow { row } => [row]
    PartConstrainedToRows { rows } => rows
    PrintedRatedPart { rating: _ } => no_rows()
  }
}

fn rows_bearing(claim: List<ElectronicComponentRow>, seen: List<ElectronicComponentRow>) -> ObservationBearing {
  if rows_within(a: seen, b: claim) { Supports } else { if rows_disjoint(a: seen, b: claim) { Contradicts } else { Undecided } }
}

fn printed_rating_of(i: ComponentIdentification) -> PrintedRating? {
  match i {
    RatingPrintedOnBody { rating, marking: _ } => Present { value: rating }
    _ => Absent
  }
}

// A rating claim judged on the fields it asserts.
fn rating_bearing(claim: PrintedRating, seen: PrintedRating) -> ObservationBearing {
  match claim {
    PrintedFuseRating { current: cc, interrupt_voltage: cv } => match seen {
      PrintedFuseRating { current: sc, interrupt_voltage: sv } =>
        if ampere_count(a: cc) != ampere_count(a: sc) { Contradicts } else {
          match cv {
            Absent => Supports
            Present { value: v } => match sv {
              Absent => Undecided
              Present { value: w } => if volt_count(v: v) == volt_count(v: w) { Supports } else { Contradicts }
            }
          }
        }
    }
  }
}

fn part_bearing(claim: PopulatedPart, i: ComponentIdentification) -> ObservationBearing {
  match claim {
    PrintedRatedPart { rating } => match printed_rating_of(i: i) {
      Present { value: seen } => rating_bearing(claim: rating, seen: seen)
      Absent => Undecided
    }
    PartRow { row: _ } => rows_bearing(claim: claimed_rows(claim: claim), seen: established_rows(i: i))
    PartConstrainedToRows { rows: _ } => rows_bearing(claim: claimed_rows(claim: claim), seen: established_rows(i: i))
  }
}

fn identification_evidence(i: ComponentIdentification) -> EvidenceRef? {
  match i {
    IdentifiedByMarking { row: _, marking } => Present { value: marking.evidence }
    MarkingSharedByMakers { rows: _, marking } => Present { value: marking.evidence }
    MarkingCandidate { row: _, marking, discriminator: _ } => Present { value: marking.evidence }
    RatingPrintedOnBody { rating: _, marking } => Present { value: marking.evidence }
    ResistanceCodeRead { milliohms: _, marking } => Present { value: marking.evidence }
    MarkingUnresolved { marking, discriminator: _ } => match marking { Absent => Absent, Present { value: m } => Present { value: m.evidence } }
    FootprintUnpopulated { evidence } => Present { value: evidence }
  }
}

// Evidence of ours: a photograph or statement made at our bench, not the seller's listing.
fn evidence_is_ours(e: EvidenceRef) -> Bool {
  match e {
    OperatorPhotograph { taken_on: _, locator: _ } => true
    OperatorStatement { stated_on: _, verbatim: _ } => true
    SellerListingPhotograph { listing: _, read_on: _ } => false
  }
}

// Read on a photograph or in a statement of ours, not only off the seller's listing.
fn read_on_our_board(i: ComponentIdentification) -> Bool {
  match identification_evidence(i: i) {
    Absent => false
    Present { value: e } => evidence_is_ours(e: e)
  }
}

fn observation_bearing(claim: PopulatedPart, o: InstalledComponent) -> ObservationBearing {
  let raw = part_bearing(claim: claim, i: o.identification)
  match raw {
    Supports => if read_on_our_board(i: o.identification) { Supports } else { Undecided }
    Undecided => Undecided
    Contradicts => Contradicts
  }
}

fn layout_record(layout: CarrierLayoutObservation) -> BenchRecord {
  match layout.measured {
    Absent => no_bench_record
    Present { value: b } => b.bench
  }
}

// The keys of every recorded removal of a component admitted at the position.
fn position_removals(layout: CarrierLayoutObservation, bindings: List<SpecimenPosition>) -> List<NonEmptyStr> {
  flat_map(bindings, s => map(removals_of(r: layout_record(layout: layout), asset: layout.asset, c: s.specimen), a => a.key))
}

fn at_position(layout: CarrierLayoutObservation, bindings: List<SpecimenPosition>) -> List<InstalledComponent> {
  filter(layout.components, c => any(bindings, s => component_identity_eq(a: s.specimen, b: c.component)))
}

fn in_scope(layout: CarrierLayoutObservation, keys: List<NonEmptyStr>, o: InstalledComponent) -> Bool {
  match place_against(r: layout_record(layout: layout), asset: layout.asset, seen: o.seen, keys: keys) { BeforeEvery => true, _ => false }
}

fn later(layout: CarrierLayoutObservation, keys: List<NonEmptyStr>, o: InstalledComponent) -> Bool {
  match place_against(r: layout_record(layout: layout), asset: layout.asset, seen: o.seen, keys: keys) { AfterEvent { key: _ } => true, _ => false }
}

fn with_presence(os: List<InstalledComponent>, want: ObservedPresence) -> List<InstalledComponent> {
  filter(os, o => match observed_presence(i: o.identification) {
    PartPresent => match want { PartPresent => true, _ => false }
    PartAbsent => match want { PartAbsent => true, _ => false }
    PresenceUnobserved => match want { PresenceUnobserved => true, _ => false }
  })
}

fn scoped_observations(layout: CarrierLayoutObservation, bindings: List<SpecimenPosition>) -> ScopedObservations {
  let keys = position_removals(layout: layout, bindings: bindings)
  let os = at_position(layout: layout, bindings: bindings)
  let observed = filter(os, o => match observed_presence(i: o.identification) { PresenceUnobserved => false, _ => true })
  let scoped = filter(observed, o => in_scope(layout: layout, keys: keys, o: o))
  ScopedObservations {
    scope: PositionAsReceived { before_removals: keys },
    present: with_presence(os: scoped, want: PartPresent),
    absent: with_presence(os: scoped, want: PartAbsent),
    later: filter(observed, o => later(layout: layout, keys: keys, o: o)),
    unplaced: filter(observed, o => !in_scope(layout: layout, keys: keys, o: o) && !later(layout: layout, keys: keys, o: o)),
    unobserved: with_presence(os: os, want: PresenceUnobserved),
  }
}

// The rows every set admits: the constraint a group of readings agrees on.
fn common_rows(sets: List<List<ElectronicComponentRow>>, first: List<ElectronicComponentRow>) -> List<ElectronicComponentRow> {
  filter(first, r => all(sets, s => row_in(rows: s, r: r)))
}

// In-scope readings of the position whose established row sets admit no row in common: pairwise overlap
// is not enough ({A,B}, {B,C}, {A,C} share none).
fn rows_conflict(os: List<InstalledComponent>) -> Bool {
  let sets = filter(map(os, o => established_rows(i: o.identification)), s => count(s) > 0)
  match sets.first() {
    Absent => false
    Present { value: first } => count(common_rows(sets: sets, first: first)) == 0
  }
}

// Two printed ratings disagree when they read a field differently; a field one of them leaves unread is
// compatible with any value the other reads.
fn ratings_disagree(a: PrintedRating, b: PrintedRating) -> Bool {
  match a {
    PrintedFuseRating { current: ca, interrupt_voltage: va } => match b {
      PrintedFuseRating { current: cb, interrupt_voltage: vb } =>
        ampere_count(a: ca) != ampere_count(a: cb) || match va {
          Absent => false
          Present { value: x } => match vb { Absent => false, Present { value: y } => volt_count(v: x) != volt_count(v: y) }
        }
    }
  }
}

fn ratings_conflict(os: List<InstalledComponent>) -> Bool {
  let ratings = flat_map(os, o => match printed_rating_of(i: o.identification) { Absent => no_ratings(), Present { value: r } => [r] })
  any(ratings, a => any(ratings, b => ratings_disagree(a: a, b: b)))
}

fn no_ratings() -> List<PrintedRating> {
  []
}

// In-scope readings of one position that cannot all be true of one part: row sets with no row in
// common, or printed ratings reading one field differently.
fn readings_conflict(os: List<InstalledComponent>) -> Bool {
  rows_conflict(os: os) || ratings_conflict(os: os)
}

fn is_bearing(b: ObservationBearing, want: ObservationBearing) -> Bool {
  match b {
    Supports => match want { Supports => true, _ => false }
    Undecided => match want { Undecided => true, _ => false }
    Contradicts => match want { Contradicts => true, _ => false }
  }
}

fn bearing_of(claim: PopulatedPart, os: List<InstalledComponent>, want: ObservationBearing) -> List<InstalledComponent> {
  filter(os, o => is_bearing(b: observation_bearing(claim: claim, o: o), want: want))
}

fn outcome_of(claim: PopulatedPart, s: ScopedObservations) -> PopulationOutcome {
  let supporting = bearing_of(claim: claim, os: s.present, want: Supports)
  let contradicting = bearing_of(claim: claim, os: s.present, want: Contradicts)
  if count(s.present) > 0 && count(s.absent) > 0 { ObservationsConflict { observations: concat(s.present, s.absent) } }
  else if readings_conflict(os: s.present) { ObservationsConflict { observations: s.present } }
  else if count(s.absent) > 0 || count(contradicting) > 0 { Contradicted { contradicting: concat(s.absent, contradicting), supporting: supporting } }
  else if count(supporting) > 0 && count(with_presence(os: s.unplaced, want: PartAbsent)) == 0 { SupportedOnSpecimen { supporting: supporting } }
  else { EvidenceMissing { undecided: bearing_of(claim: claim, os: s.present, want: Undecided), unplaced: s.unplaced } }
}

fn same_position(a: P4261DesignPosition, b: P4261DesignPosition) -> Bool {
  p4261_revision_eq(a: a.position.revision, b: b.position.revision) && (a.position.designator as String) == (b.position.designator as String)
}

fn unattributed(position: P4261DesignPosition, layout: CarrierLayoutObservation, bindings: List<SpecimenPosition>) -> AttributionGap? {
  unattributed_at(position: position.position, layout: layout, bindings: bindings)
}

fn unattributed_at(position: P4261Position, layout: CarrierLayoutObservation, bindings: List<SpecimenPosition>) -> AttributionGap? {
  if !p4261_revision_eq(a: position.revision, b: layout.revision) { Present { value: PositionOfAnotherRevision } }
  else if !revision_supported(revision: position.revision, specimen: layout) { Present { value: RevisionNotEstablishedOnBoard } }
  else if count(bindings) == 0 { Present { value: NoAdmittedReading } }
  else { Absent }
}

// One board's assessment of one position, over the board's admitted correspondence (computed once per
// board by the caller, admit_correspondence).
fn assess_population(position: P4261DesignPosition, layout: CarrierLayoutObservation, admitted: List<SpecimenPosition>) -> PopulationAssessment {
  let bindings = filter(admitted, s => same_position(a: s.position, b: position))
  let scoped = scoped_observations(layout: layout, bindings: bindings)
  let outcome = match position.population {
    Absent => NotAttributable { gap: NoPopulationClaim }
    Present { value: claim } => match unattributed(position: position, layout: layout, bindings: bindings) {
      Present { value: gap } => NotAttributable { gap: gap }
      Absent => outcome_of(claim: claim.part, s: scoped)
    }
  }
  PopulationAssessment { position: position, asset: layout.asset, bindings: bindings, scoped: scoped, outcome: outcome }
}

fn is_supported(o: PopulationOutcome) -> Bool {
  match o {
    SupportedOnSpecimen { supporting: _ } => true
    _ => false
  }
}

// One claimed position's assessment on its board, and the standing the claim then carries: a receipt
// naming the board's record only where the board's own readings support it, the claim's authored
// standing otherwise -- beside, never instead of, the outcome that says why.
type PositionStanding {
  assessment: PopulationAssessment
  standing: CitedFigureStanding
}

type ClaimedAssessment {
  assessment: PopulationAssessment
  claim: PopulationClaim
}

fn claimed_assessments(positions: List<P4261DesignPosition>, layout: CarrierLayoutObservation) -> List<ClaimedAssessment> {
  let admitted = admit_correspondence(layout: layout).admitted
  flat_map(positions, d => match d.population {
    Absent => []
    Present { value: c } => [ClaimedAssessment { assessment: assess_population(position: d, layout: layout, admitted: admitted), claim: c }]
  })
}

fn p4261_e1_population_standings() -> List<PositionStanding> {
  map(claimed_assessments(positions: p4261_e1_positions, layout: p4261_e1_layout), x => PositionStanding {
    assessment: x.assessment,
    standing: if is_supported(o: x.assessment.outcome) { ObservedByReceipt { observed: observed_receipt(receipt: decl_ref(module_path: "product.p4261.e1_b", decl_name: "p4261_e1_layout")) } } else { x.claim.standing },
  })
}

fn p4261_k1_population_standings() -> List<PositionStanding> {
  map(claimed_assessments(positions: p4261_k1_positions, layout: p4261_k1_layout), x => PositionStanding {
    assessment: x.assessment,
    standing: if is_supported(o: x.assessment.outcome) { ObservedByReceipt { observed: observed_receipt(receipt: decl_ref(module_path: "product.p4261.k1_a", decl_name: "p4261_k1_layout")) } } else { x.claim.standing },
  })
}

// ── CONTACT INVENTORY: WHAT ONE BOARD'S OWN CENSUS SAYS OF A RECONSTRUCTED INVENTORY ─────────────
//
// A claim is NVIDIA's (extdeps.nvidia.p4261.connectors): so many positions in each housing row at one
// revision's position. What one held board's census says of it is this assessment, on that board.
// The board must be established as the claim's revision (as for population); the census must
// describe the very component admitted at the claim's position, so another connector's count bears
// on nothing; and the census is read once, as its observed inventory (product.p4261.carrier
// observed_inventory), from the board's own records -- never generated from the claim.
//
// Against the claim's counts:
//   both rows counted, both equal          supported -- if the whole chain (the designator reading and
//                                          the census) is ours; read off the seller's listing, missing
//   both rows counted, either different    contradicted
//   a total only (no row split)            contradicted if different, otherwise missing the split
//   every position, some sides unread      contradicted if a known row already exceeds the claim or the
//                                          total differs, otherwise missing the split
//   a partial mapping                      contradicted if a row already holds more than claimed, or the
//                                          positions read exceed the claim's total; otherwise missing
//   a refused mapping                      missing, with the defect kept
// An unread side is never a zero, and an unmapped position never an absent one.
type InventoryGap
  = RowSplitUnread
  | CoverageIncomplete
  | MappingRefused { defect: MappingDefect }
  | ReadOnlyOffListing

type InventoryOutcome
  = InventorySupportedOnSpecimen
  | InventoryMissing { gap: InventoryGap }
  | InventoryContradicted { observed: ObservedInventory }
  | InventoryNotAttributable { gap: AttributionGap }

type InventoryAssessment {
  claim: P4261ContactInventory
  asset: PhysicalAssetIdentity
  bindings: List<SpecimenPosition>
  observed: ObservedInventory
  outcome: InventoryOutcome
}

fn same_p4261_position(a: P4261Position, b: P4261Position) -> Bool {
  p4261_revision_eq(a: a.revision, b: b.revision) && (a.designator as String) == (b.designator as String)
}

fn census_evidence(c: ConnectorPositionCensus) -> EvidenceRef {
  match c {
    CountedFromPhotograph { component: _, positions: _, evidence } => evidence
    MappedOnHousing { housing } => housing.sides_evidence
  }
}

fn inventory_bearing(claim: P4261ContactInventory, observed: ObservedInventory, ours: Bool) -> InventoryOutcome {
  match observed {
    InventoryByRow { latch_row, away_row } =>
      if latch_row == claim.latch_row_positions && away_row == claim.away_row_positions { if ours { InventorySupportedOnSpecimen } else { InventoryMissing { gap: ReadOnlyOffListing } } }
      else { InventoryContradicted { observed: observed } }
    InventoryTotalOnly { total } => if total != inventory_total(i: claim) { InventoryContradicted { observed: observed } } else { InventoryMissing { gap: RowSplitUnread } }
    InventorySidesUnread { latch_row_known, away_row_known, side_unread } =>
      if latch_row_known > claim.latch_row_positions || away_row_known > claim.away_row_positions || latch_row_known + away_row_known + side_unread != inventory_total(i: claim) { InventoryContradicted { observed: observed } }
      else { InventoryMissing { gap: RowSplitUnread } }
    InventoryInPart { latch_row_at_least, away_row_at_least, side_unread } =>
      if latch_row_at_least > claim.latch_row_positions || away_row_at_least > claim.away_row_positions || latch_row_at_least + away_row_at_least + side_unread > inventory_total(i: claim) { InventoryContradicted { observed: observed } }
      else { InventoryMissing { gap: CoverageIncomplete } }
    InventoryRefused { defect } => InventoryMissing { gap: MappingRefused { defect: defect } }
  }
}

// One board's assessment of one inventory claim, over the board's admitted correspondence.
fn assess_contact_inventory(claim: P4261ContactInventory, layout: CarrierLayoutObservation, admitted: List<SpecimenPosition>) -> InventoryAssessment {
  let bindings = filter(admitted, s => same_p4261_position(a: s.position.position, b: claim.position))
  let subject = census_component(census: layout.j20)
  let on_subject = filter(bindings, s => component_identity_eq(a: s.specimen, b: subject))
  let observed = observed_inventory(census: layout.j20)
  let outcome = match unattributed_at(position: claim.position, layout: layout, bindings: bindings) {
    Present { value: gap } => InventoryNotAttributable { gap: gap }
    Absent => if count(on_subject) == 0 { InventoryNotAttributable { gap: CensusOfAnotherConnector } }
      else { inventory_bearing(claim: claim, observed: observed, ours: evidence_is_ours(e: census_evidence(c: layout.j20)) && all(on_subject, s => evidence_is_ours(e: s.evidence))) }
  }
  InventoryAssessment { claim: claim, asset: layout.asset, bindings: bindings, observed: observed, outcome: outcome }
}

// The board's revision's J20 inventory claim, if any, assessed on this board's own records.
fn j20_inventory_assessment(layout: CarrierLayoutObservation) -> InventoryAssessment? {
  match (filter(p4261_contact_inventories, c => p4261_revision_eq(a: c.position.revision, b: layout.revision) && (c.position.designator as String) == "J20")).first() {
    Absent => Absent
    Present { value: c } => Present { value: assess_contact_inventory(claim: c, layout: layout, admitted: admit_correspondence(layout: layout).admitted) }
  }
}

// ── THE RECORDED J20 INVENTORY: WHAT THE RECOUNT ESTABLISHES ON THIS BOARD ───────────────────────
//
// Independent of any revision claim, and of whether one agrees: a recount establishes this board's J20
// inventory when its census is a mapping of the component admitted at this board's J20, read on our
// own board (the mapping's sides and the designator reading alike), complete, consistent, and with
// every position's row read against the latch. A count without rows, a partial or refused mapping, an
// unread side, another connector's census, or one read only off the seller's listing does not -- each
// kept as its reason, beside whatever the census did observe.
type RecountGap
  = RecountNotAMapping
  | RecountNotAtAdmittedJ20
  | RecountReadOffListing
  | RecountInPart
  | RecountSidesUnread
  | RecountRefused { defect: MappingDefect }

type RecountStanding
  = RecountEstablished { latch_row: Nat, away_row: Nat }
  | RecountNotEstablished { gap: RecountGap, observed: ObservedInventory }

fn at_j20(layout: CarrierLayoutObservation, admitted: List<SpecimenPosition>) -> List<SpecimenPosition> {
  filter(admitted, s => p4261_revision_eq(a: s.position.position.revision, b: layout.revision) && (s.position.position.designator as String) == "J20")
}

fn j20_recount(layout: CarrierLayoutObservation) -> RecountStanding {
  let observed = observed_inventory(census: layout.j20)
  let subject = census_component(census: layout.j20)
  let bound = filter(at_j20(layout: layout, admitted: admit_correspondence(layout: layout).admitted), s => component_identity_eq(a: s.specimen, b: subject))
  match layout.j20 {
    CountedFromPhotograph { component: _, positions: _, evidence: _ } => RecountNotEstablished { gap: RecountNotAMapping, observed: observed }
    MappedOnHousing { housing } =>
      if count(bound) == 0 { RecountNotEstablished { gap: RecountNotAtAdmittedJ20, observed: observed } }
      else if !evidence_is_ours(e: housing.sides_evidence) || !all(bound, s => evidence_is_ours(e: s.evidence)) { RecountNotEstablished { gap: RecountReadOffListing, observed: observed } }
      else { match observed {
        InventoryByRow { latch_row, away_row } => RecountEstablished { latch_row: latch_row, away_row: away_row }
        InventorySidesUnread { latch_row_known: _, away_row_known: _, side_unread: _ } => RecountNotEstablished { gap: RecountSidesUnread, observed: observed }
        InventoryInPart { latch_row_at_least: _, away_row_at_least: _, side_unread: _ } => RecountNotEstablished { gap: RecountInPart, observed: observed }
        InventoryRefused { defect } => RecountNotEstablished { gap: RecountRefused { defect: defect }, observed: observed }
        InventoryTotalOnly { total: _ } => RecountNotEstablished { gap: RecountNotAMapping, observed: observed }
      } }
  }
}
