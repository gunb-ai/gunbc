data enable_chain_sheet: PartialSheet = PartialSheet {
  source: "product.p4261.enable_chain_sheet",
  title: "P4261 E1-b: U1_P5's enable, P6 and the Q300 / Q301 pair (reconstructed sheet 2)",
  states: enable_states,
  layout: enable_layout,
  aliases: [],
  nodes: enable_nodes,
  links: enable_links,
  roles: enable_roles,
  voltages: enable_voltages,
  disputes: [],
  removals: [],
  hypotheses: map(enable_hypothesis, h => SheetHypothesis { key: enable_hypothesis_key, hypothesis: h, candidates: enable_candidates }),
  asks: enable_asks,
}

fn enable_chain_sheet_svg() -> String {
  sheet_svg(s: enable_chain_sheet)
}
