    pin(t: e1_q300_lone_lead, label: "lone", x: 1040, y: 190),
    pin(t: e1_q300_lead_a, label: "a", x: 1170, y: 165),
    pin(t: e1_q300_lead_b, label: "b", x: 1170, y: 230),
