module product.p4261.interface_registry

import std.types { List, NonEmptyStr, String }
import std.optional { Absent, Present }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.electronic_component.types { Designator, designator_of, designator_eq, designator_text }
import product.p4261.e1_position_receipts { PositionReceipt, e1_position_receipts }

// THE P4261 E1'S INTERFACES, ONE ROW EACH. The 2026-11-03 atlas admitted twenty-six connector designators
// and the two switch packages (product.p4261.e1_position_receipts), while the board's management-I/O
// survey (product.p4261.e1_b, management_io) still lists one header and one edge receptacle. This registry
// gives every admitted connector and each switch pole a row saying what is established about it, what is
// only a candidate, what behaviour has been seen and in which state, and what would tell the candidates
// apart without probing everything. A position on the board is the atlas's fact; nothing here adds one.
//
// A row's function is established only by a reading or a run that showed it. A candidate names its basis
// and stays a candidate; an unread function is said to be unread, never guessed from a connector's shape.
// Behaviour is recorded with its board and its state, because a switch that did nothing in one state is
// not thereby inert (the review of 2026-11-16, forwarded by the operator).
//
// A REPORTED FUNCTION IS SOMEONE ELSE'S ACCOUNT, kept apart from what this bench established. On 2026-11-16
// an owner of a running Ranger tray (NVIDIA's "TS1C RANGER COMPUTE", P/N 675-24265-2020-T1C, on ZT Systems
// boards) wrote that one E1-type P4261 runs there, started by the tray's controller, an ASPEED AST2600
// management module in the front IO board's DC-SCM slot, through four factory cables, and gave the cable map
// printed inside the tray's lid (H88-1516-001 REV X02). That owner allowed it to be recorded and is not
// named. It is evidence about an E1 in that tray, not a reading of any board held here, and it says which
// socket a cable goes to, not what any contact carries.

type InterfaceKind
  = PowerInput
  | ModuleReceptacle
  | HighSpeedData
  | LocalControl
  | ServiceOrDebug
  | UsbCandidate
  | KindUnknown

type FunctionStanding
  = FunctionEstablished { function: NonEmptyStr, basis: NonEmptyStr }
  | FunctionCandidate { candidates: NonEmptyStr, basis: NonEmptyStr }
  | FunctionReported { function: NonEmptyStr, source: NonEmptyStr, scope: NonEmptyStr }
  | FunctionUnread

type BoardInterface {
  designator: Designator
  part: NonEmptyStr?
  kind: InterfaceKind
  form: NonEmptyStr?
  function: FunctionStanding
  observed: NonEmptyStr?
  next_discriminator: NonEmptyStr?
  not_to_infer: NonEmptyStr?
}

fn unread(name: NonEmptyStr) -> BoardInterface {
  BoardInterface { designator: designator_of(verbatim: name), part: Absent, kind: KindUnknown, form: Absent, function: FunctionUnread, observed: Absent, next_discriminator: Absent, not_to_infer: Absent }
}

// A connector whose form the atlas's inventory describes and whose function nothing has read. The forms
// are the atlas pass's descriptions of its photographs (the 2026-11-07 inventory), not measurements.
fn form_only(name: NonEmptyStr, form: NonEmptyStr) -> BoardInterface {
  BoardInterface { designator: designator_of(verbatim: name), part: Absent, kind: KindUnknown, form: Present { value: form }, function: FunctionUnread, observed: Absent, next_discriminator: Absent, not_to_infer: Absent }
}

data ranger_source: NonEmptyStr = "an owner of a running Ranger tray, 2026-11-16, from the cable map on the tray's lid label H88-1516-001 REV X02"

data ranger_scope: NonEmptyStr = "an E1-type P4261 in a TS1C Ranger tray; not read on a board held here, and no contact's signal is known"

fn ranger_cable(name: NonEmptyStr, form: NonEmptyStr, function: NonEmptyStr) -> BoardInterface {
  BoardInterface {
    designator: designator_of(verbatim: name), part: Absent, kind: ServiceOrDebug, form: Present { value: form },
    function: FunctionReported { function: function, source: ranger_source, scope: ranger_scope },
    observed: Absent,
    next_discriminator: Present { value: "where each non-ground contact first lands on an unpowered bare board, the standby lines first" },
    not_to_infer: Present { value: "which contact carries which of the controller's lines, or their signalling voltage" },
  }
}

data s1_seen_on_e1b: NonEmptyStr = "E1-b, 2026-10-20, no 48 V stage on: pole 2 toward ON started the sequence from 38 mA to about 94 mA with the lamps settling; before S2 was set, neither S1 pole did anything"

data s1_seen_on_218: NonEmptyStr = "S/N 1583323120218, 2026-11-16, override held, module with heatsink and fan fitted: each S1 pole lowers the draw from 0.33 A (one combination about 0.25 A, toward the 0.09 A standby figure) and lamps go out; which pole gives which figure was not recorded, and no position raised the draw"

data s2_seen: NonEmptyStr = "E1-b, 2026-10-20: pole 1 toward ON with pole 2 away took the draw from 13 mA to 38 mA, no lamps. S/N 1583323120218, 2026-11-16, override held and a module fitted: no effect seen from either pole, which is scoped to that state"

fn switch_pole(package: NonEmptyStr, pole: NonEmptyStr, seen: NonEmptyStr) -> BoardInterface {
  BoardInterface {
    designator: designator_of(verbatim: package), part: Present { value: pole }, kind: LocalControl, form: Present { value: "one pole of a two-pole switch package" },
    function: FunctionCandidate { candidates: "gates a carrier-side domain or strap", basis: "the draw and the lamps change with it" },
    observed: Present { value: seen },
    next_discriminator: Absent,
    not_to_infer: Present { value: "that a pole with no effect in one state is inert, or sampled at any particular time" },
  }
}

data p4261_e1_interfaces: List<BoardInterface> = [
  BoardInterface { designator: designator_of(verbatim: "J20"), part: Absent, kind: PowerInput, form: Present { value: "two-row input housing" }, function: FunctionEstablished { function: "the carrier's 48 to 54 V input and return", basis: "every powered run since 2026-10-20 has been through it (product.p4261.e1_b e1_j20_housing)" }, observed: Present { value: "reported for the Ranger tray: fed from the tray's power board J4 by cable CA-03382-001, the power board fed with 48 V" }, next_discriminator: Absent, not_to_infer: Absent },
  BoardInterface { designator: designator_of(verbatim: "J3"), part: Absent, kind: ModuleReceptacle, form: Present { value: "long module receptacle" }, function: FunctionEstablished { function: "one of the carrier's two module receptacles", basis: "the module site, read 2026-10-20 (product.p4261.e1_b)" }, observed: Absent, next_discriminator: Absent, not_to_infer: Absent },
  BoardInterface { designator: designator_of(verbatim: "J4"), part: Absent, kind: ModuleReceptacle, form: Present { value: "long module receptacle" }, function: FunctionEstablished { function: "one of the carrier's two module receptacles", basis: "the module site, read 2026-10-20 (product.p4261.e1_b)" }, observed: Absent, next_discriminator: Absent, not_to_infer: Absent },
