  ranger_cable(name: "J14", form: "tall fine-pitch two-row vertical receptacle", function: "the tray controller's MGMT2 link (cable CA-03378-001 to the front IO board's J19)"),
  form_only(name: "J16", form: "1x4 single-row header"),
  form_only(name: "J540", form: "2x5 shrouded box header, one top-row position without a pin"),
