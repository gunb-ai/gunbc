// ── THE JOIN AGAINST THE ATLAS ──────────────────────────────────────────────────────────────────────

fn admitted(receipts: List<PositionReceipt>, d: Designator) -> Bool {
  any(receipts, r => designator_eq(a: r.designator, b: d))
}

fn has_row(rows: List<BoardInterface>, d: Designator) -> Bool {
  any(rows, i => designator_eq(a: i.designator, b: d))
}

// Names with no row: an interface the registry lost.
fn names_without_rows(rows: List<BoardInterface>, names: List<NonEmptyStr>) -> List<NonEmptyStr> {
  filter(names, n => !has_row(rows: rows, d: designator_of(verbatim: n)))
}

// Rows whose designator the atlas did not admit: a position the registry would be inventing.
fn rows_not_admitted(rows: List<BoardInterface>, receipts: List<PositionReceipt>) -> List<BoardInterface> {
  filter(rows, i => !admitted(receipts: receipts, d: i.designator))
}

fn is_established(i: BoardInterface) -> Bool {
  match i.function {
    FunctionEstablished { function: _, basis: _ } => true
    FunctionCandidate { candidates: _, basis: _ } => false
    FunctionReported { function: _, source: _, scope: _ } => false
    FunctionUnread => false
  }
}

fn is_reported(i: BoardInterface) -> Bool {
  match i.function {
    FunctionEstablished { function: _, basis: _ } => false
    FunctionCandidate { candidates: _, basis: _ } => false
    FunctionReported { function: _, source: _, scope: _ } => true
    FunctionUnread => false
  }
}

// ── WHAT IT PRINTS ──────────────────────────────────────────────────────────────────────────────────

fn optional_words(label: String, v: NonEmptyStr?) -> String {
  match v {
    Present { value: w } => join(["; ", label, ": ", w as String], "")
    Absent => ""
  }
}

fn function_words(f: FunctionStanding) -> String {
  match f {
    FunctionEstablished { function, basis } => join(["ESTABLISHED: ", function as String, " (", basis as String, ")"], "")
    FunctionCandidate { candidates, basis } => join(["CANDIDATE: ", candidates as String, " (", basis as String, ")"], "")
    FunctionReported { function, source, scope } => join(["REPORTED: ", function as String, " (", source as String, "; ", scope as String, ")"], "")
    FunctionUnread => "UNREAD"
  }
}

fn interface_line(i: BoardInterface) -> String {
  join([
    designator_text(designator: i.designator) as String,
    match i.part { Present { value: p } => join([" ", p as String], ""), Absent => "" },
    " -- ", function_words(f: i.function),
    optional_words(label: "form", v: i.form),
    optional_words(label: "seen", v: i.observed),
    optional_words(label: "next", v: i.next_discriminator),
    optional_words(label: "not to infer", v: i.not_to_infer),
  ], "")
}

fn interface_lines() -> List<String> {
  map(p4261_e1_interfaces, i => interface_line(i: i))
}

// The registry, one interface to a line, into a file.
fn write_interface_registry(path: NonEmptyStr) -> ProcessExit {
  let written = Filesystem.Write(path: path as String, content: join(concat(interface_lines(), [""]), "\n"))
  if written.success { ExitSuccess } else { exit_failure(reason: written.error) }
}
