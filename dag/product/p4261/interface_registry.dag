  BoardInterface { designator: designator_of(verbatim: "J620"), part: Absent, kind: ServiceOrDebug, form: Present { value: "2x5 receptacle housing, one top-row position plugged as a key; pin 1 marked" }, function: FunctionUnread, observed: Absent, next_discriminator: Absent, not_to_infer: Absent },
  BoardInterface { designator: designator_of(verbatim: "J190"), part: Absent, kind: UsbCandidate, form: Present { value: "metal-shell receptacle at the board edge, stamped Amphenol 1502, that takes a Micro-USB plug" }, function: FunctionCandidate { candidates: "a USB SuperSpeed Micro-B port", basis: "the atlas reads the Amphenol 1502 shell at J190, the plug fit was read on 2026-10-16 (product.p4261.e1_b management_io), and a TI TUSB8042A hub is read at U816" }, observed: Present { value: "2026-11-16, the operator: 'i already plugged in a usb cable to j190, it provides no interface here'; which board, its power state and the host were not said" }, next_discriminator: Present { value: "nothing more at the bench for now: no enumeration fits a hub that is unpowered or held in reset in the state tried, as well as a port that is not the hub's upstream" }, not_to_infer: Present { value: "that J190 is the hub's upstream port, or from one silent try that the port is dead" } },
