module product.p4261.e1_photographs

// THE E1'S PHOTOGRAPH STORE: the 91 frames the 2026-11-02/03 atlas holds, each identified by the SHA-256
// of its bytes. Generated by
// docs/plans/2026-11-03-p4261-e1-atlas/scripts/gen_e1_photographs_dag.py (private branch
// p4261/e1-atlas-handoff) from that folder's manifest_e1_all_photos.csv and the two photo registries, so a
// claim about this carrier cites an artefact
// rather than a sentence: a marking row and a store row are about the same frame because their digests
// match, whatever either is called in a folder.
//
// A row's byte count is the manifest's, carried as product.electrical.photograph's `PositiveByteCount`:
// a store row claims a file exists, and a zero-length frame has no constructor. The number a reader
// compares against the file they open is the manifest's own, so `predecessor` is one less than it.
//
// Rows are named for the atlas photo id the registries use (the inventories' `photos` column), or for what
// the file is called where no registry lists it. The name is for people; `content` is what resolves.
//
// The capture note in the registry names the device for 22 frames and is silent for the rest, so those rows
// carry `DeviceUnrecorded` with the note that would close it; the same holds for the capture date on frames
// the registry lists as earlier shots. Nothing here invents a device or a day.
//
// A generated image (grid overviews, zone drafts, the U10_P2 pinout, the power-path diagram) is a row too,
// typed `GeneratedImage`: it can locate a reading and cannot ground one, which
// product.electrical.photograph's `citation_is_checkable` enforces. An image we drew cannot corroborate the
// readings it was drawn from.

import std.content_hash { Sha256Digest, Sha256DigestHex }
import std.measure { positive_measure_count }
import std.types { List, NonEmptyStr }
import product.electrical.photograph {
  BottomSurface,
  AndonstarMicroscopeScreen,
  CapturedFrame,
  CapturedOn,
  CaptureDateUnrecorded,
  DeviceUnrecorded,
  GeneratedImage,
  PhoneCamera,
  Photograph,
  PositiveByteCount,
  StoreLocation,
  positive_byte_count,
  TopSurface,
  photograph_in_store,
}
import gunbc.fleet.fleet_asset_identity { p4261_e1_b }

