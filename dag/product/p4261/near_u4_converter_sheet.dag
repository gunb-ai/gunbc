// THE NEAR-U4 CONVERTER SITE (U10_P2) AS A PARTIAL SCHEMATIC SHEET, AND ITS DRAWING. The vocabulary, the
// rules a sheet is held to and the drawing are product.p4261.sheet's; these are the site's rows. The sheet names the
// E1-b's own component and terminal identities -- including parts with no designator read, which keep a
// stable photo-anchored identity (product.p4261.e1_b e1_photo_part) -- and keeps four things apart: what
// the copper is proposed to join and on what evidence, what the datasheet alone predicts, what forced-
// current millivolts suggest, and what has been done to the E1-b and is wrong with it. sheet_svg draws it;
// the drawing is regenerated from these rows whenever they change, incomplete nodes and all.
//
// NOTHING HERE IS YET A JOIN, AND THE DATA SAYS SO. A connection's terminals become members of a node only
// when its evidence joins them at the shorted-probe baseline (product.electrical.bench_session: "a zero the
// operator reports with no such baseline recorded ... joins nothing"), each sheet terminal's
// correspondence to the observed one is established, AND the path between them is claimed to be copper on
// evidence other than the ohmmeter: a baseline reading cannot tell copper from an inductor, a fuse, a shunt
// or a zero-ohm link in series, so on its own it shows a low-impedance path, never one node. Today every connection rests on the K1-a -- revision
// K, rail not shorted -- with zeros reported without a baseline, and each E1-b terminal's correspondence to
// the K1-a's is proposed by placement. So every connection is drawn as proposed, its grade and its
// correspondence shown, and every node's only member is its anchor. On the E1-b itself, every point on SW,
// OUT or the return reads about 0 ohm to every other since the 2026-10-21 short, so no E1-b resistance
// reading there is admitted as support at all.
//
// WHERE THIS GOES NEXT. Board wiring is NVIDIA's design fact (extdeps.nvidia.p4261.netlist). A connection
// moves there when a board of the E revision reads it at baseline and a frame or document shows no part in
// series; a missing silkscreen designator does not block it, because a position can be named by its
// anonymous body as this sheet names it.

// ── THE ROWS ───────────────────────────────────────────────────────────────────────────────────────

data l_out_pad: ElectricalTerminalRef = e1_terminal(c: e1_l_4r7_near, name: inductor_pad_near_u4)

data l_converter_pad: ElectricalTerminalRef = e1_terminal(c: e1_l_4r7_near, name: inductor_pad_far_u4)

fn k1_terminal(c: ComponentInstanceIdentity, name: NonEmptyStr) -> ElectricalTerminalRef {
  terminal_ref(component: c, terminal: name as TerminalIdentity)
}

fn by_placement(basis: NonEmptyStr) -> CorrespondenceStanding {
  CorrespondenceProposed { basis: basis }
}

data sw_connection: ProposedConnection = ProposedConnection {
  key: "sw-pad3-to-l-converter-pad",
  first: Correspondence { sheet: e1_pad(number: 3, name: "SW"), counterpart: k1_terminal(c: k1_converter_near, name: "pin 3 (SW)"), standing: by_placement(basis: "the K1-a's U10_P2 SW lead, read with the part fitted, sits on the pad the E1-b's footprint numbers 3; the K1-a is revision K") },
  second: Correspondence { sheet: l_converter_pad, counterpart: k1_terminal(c: k1_l_4r7_near, name: inductor_pad_far_u4), standing: by_placement(basis: "the K1-a's 4R7 nearest U4, converter-side pad, at the same place beside U10_P2") },
  path: SeriesUnresolved { why: "the MP2333C typical circuit ties SW straight to the inductor, but no frame of either board shows the copper between pad 3 and the inductor's pad, so a low-resistance part between them is not excluded" },
  observed: observed_between(os: k1_converter_pair_resistances, a: k1_terminal(c: k1_converter_near, name: "pin 3 (SW)"), b: k1_terminal(c: k1_l_4r7_near, name: inductor_pad_far_u4)),
}

data gnd_pin_connection: ProposedConnection = ProposedConnection {
  key: "gnd-pad4-to-return",
  first: Correspondence { sheet: e1_pad(number: 4, name: "GND"), counterpart: k1_terminal(c: k1_converter_near, name: "pin 4 (GND)"), standing: by_placement(basis: "the K1-a's U10_P2 GND lead, read with the part fitted, sits on the pad the E1-b's footprint numbers 4") },
  second: Correspondence { sheet: e1_ground_ref, counterpart: k1_return, standing: by_placement(basis: "J20's black lead on both boards") },
  path: SeriesUnresolved { why: "the return runs from the converter's GND pad to J20 on copper no frame follows; a sense resistor or a link in the return is not excluded" },
  observed: observed_between(os: k1_near_converter_lead_resistances, a: k1_terminal(c: k1_converter_near, name: "pin 4 (GND)"), b: k1_return),
}

// One connection per U100 dot-side lead, each with its own reading: four leads read to the return are
// four supported terminals, never one terminal carrying four readings.
fn u100_dot_connection(lead: NonEmptyStr) -> ProposedConnection {
  ProposedConnection {
    key: join(["u100-", lead as String, "-to-return"], "") as NonEmptyStr,
    first: Correspondence { sheet: e1_terminal(c: e1_u100, name: lead), counterpart: k1_terminal(c: k1_u100, name: lead), standing: by_placement(basis: "U100 on both boards, the lead counted from its pin-1 dot the same way") },
    second: Correspondence { sheet: e1_ground_ref, counterpart: k1_return, standing: by_placement(basis: "J20's black lead on both boards") },
    path: SeriesUnresolved { why: "U100's dot-side leads reach J20's return on copper no frame follows" },
    observed: observed_between(os: k1_u100_lead_resistances, a: k1_terminal(c: k1_u100, name: lead), b: k1_return),
  }
}

data u100_dot_side_leads: List<NonEmptyStr> = ["dot-side lead, bottom", "dot-side lead, second from bottom", "dot-side lead, third from bottom", "dot-side lead, top"]

fn candidate_at(t: ElectricalTerminalRef) -> CandidateEnd {
  CandidateEnd { terminal: t, readings: filter(e1_forced_current_readings, r => terminal_ref_equal(a: r.at, b: t)) }
}

fn part_candidate(label: NonEmptyStr, end: NonEmptyStr) -> CandidateEnd {
  candidate_at(t: e1_photo_part_end(label: label, end: end))
}

data sheet_sw_node: SheetNode = SheetNode {
  key: "sw",
  anchor: l_converter_pad,
  connections: [sw_connection],
  by_datasheet: [
    DatasheetMember { terminal: e1_pad(number: 5, name: "BST"), basis: "the MP2333C typical circuit returns BST to SW through 1 uF in series with 20 ohm; DC-open on both boards (BST to SW over range on the E1-b, BST to the return high on the K1-a), as a series capacitor would read" },
  ],
  candidates: [],
  continuations: [],
}

data sheet_out_node: SheetNode = SheetNode {
  key: "out",
  anchor: l_out_pad,
  connections: [],
  by_datasheet: [],
  candidates: [
    part_candidate(label: "1", end: "south end"),
    part_candidate(label: "3", end: "south end"),
    part_candidate(label: "7", end: "north end"),
    part_candidate(label: "9", end: "left end"),
    part_candidate(label: "10", end: "first end"),
    part_candidate(label: "10", end: "second end"),
    part_candidate(label: "11", end: "first end"),
    part_candidate(label: "11", end: "second end"),
  ],
  continuations: [
    UnknownContinuation { key: "out-loads", from: l_out_pad, unknown: "what OUT powers and its operating voltage: unread on either board; see the dispute on the 2026-10-21 3.2 V record" },
    UnknownContinuation { key: "out-copper-route", from: l_out_pad, unknown: "where OUT's copper visibly runs from the inductor's OUT pad" },
    UnknownContinuation { key: "out-7-8-chain", from: e1_photo_part_end(label: "7", end: "south end"), unknown: "photo part 7's south end and part 8's south end both read 50 mV under forced current; whether they are one node is unread" },
    UnknownContinuation { key: "out-9-far-end", from: e1_photo_part_end(label: "9", end: "right end"), unknown: "what photo part 9's right end reaches; it read 30 mV, so current flows through part 9" },
  ],
}

data sheet_gnd_node: SheetNode = SheetNode {
  key: "gnd",
  anchor: e1_ground_ref,
  connections: concat([gnd_pin_connection], map(u100_dot_side_leads, l => u100_dot_connection(lead: l))),
  by_datasheet: [],
  candidates: [
    part_candidate(label: "1", end: "north end"),
    part_candidate(label: "3", end: "north end"),
    part_candidate(label: "4", end: "first end"),
    part_candidate(label: "4", end: "second end"),
    part_candidate(label: "5", end: "first end"),
    part_candidate(label: "5", end: "second end"),
    part_candidate(label: "6", end: "first end"),
    part_candidate(label: "6", end: "second end"),
    part_candidate(label: "8", end: "north end"),
  ],
  continuations: [
    UnknownContinuation { key: "gnd-4-6-or-vin", from: e1_photo_part_end(label: "4", end: "first end"), unknown: "photo parts 4 to 6 read about 6 mV at every end: neither end is in OUT's class, but VIN, held near the return through about 5 kohm with the converter lifted, would read the same; which they join is unread" },
    UnknownContinuation { key: "u100-far-side", from: e1_terminal(c: e1_u100, name: "far-side lead, bottom"), unknown: "what U100's far-side leads join (6 to 10 kohm to the return on the K1-a); U100's role here is unread" },
  ],
}

fn pin_stub(key: NonEmptyStr, number: Nat, name: NonEmptyStr, unknown: NonEmptyStr) -> SheetNode {
  SheetNode {
    key: key, anchor: e1_pad(number: number, name: name), connections: [], by_datasheet: [], candidates: [],
    continuations: [UnknownContinuation { key: join([key as String, "-continuation"], "") as NonEmptyStr, from: e1_pad(number: number, name: name), unknown: unknown }],
  }
}

data sheet_vin_node: SheetNode = pin_stub(key: "vin", number: 2, name: "VIN", unknown: "the rail that feeds VIN; the K1-a's VIN reads 5.0 to 5.5 kohm to the return, at the lead and at the bare pad")

data sheet_pg_node: SheetNode = SheetNode {
  key: "pg", anchor: e1_pad(number: 1, name: "PG"), connections: [], by_datasheet: [], candidates: [candidate_at(t: e1_pad(number: 1, name: "PG"))],
  continuations: [UnknownContinuation { key: "pg-continuation", from: e1_pad(number: 1, name: "PG"), unknown: "PG's pull-up and where it goes (16 kohm to the return on the K1-a, 9 kohm on the E1-b); its 55 mV under forced current says some path reaches the forced rail, not that PG is that node: the K1-a's PG and OUT read unequal to the return" }],
}

data sheet_en_node: SheetNode = pin_stub(key: "en", number: 6, name: "EN", unknown: "what drives EN: the K1-a's bare pad reads 136 kohm to the return and 140 kohm to VIN, not the datasheet's 604 kohm auto-start to VIN")

data sheet_ss_node: SheetNode = pin_stub(key: "ss", number: 7, name: "SS", unknown: "the soft-start network (19 to 50 Mohm to the return on the K1-a, 130 Mohm on the E1-b, as a capacitor alone would read)")

data sheet_fb_node: SheetNode = pin_stub(key: "fb", number: 8, name: "FB", unknown: "the feedback divider (50 kohm to the return on both boards); photo part 9, 54 mV to 30 mV under forced current, is one candidate leg, unread")

data sheet_nodes: List<SheetNode> = [sheet_sw_node, sheet_out_node, sheet_gnd_node, sheet_vin_node, sheet_pg_node, sheet_en_node, sheet_ss_node, sheet_fb_node]

data out_voltage_dispute: AttributionDispute = AttributionDispute {
  key: "out-voltage-3v2",
  held: filter(e1_inductor_volts, v => component_identity_eq(a: v.at.component, b: e1_l_4r7_near)),
  evidence: e1_inductor_said,
  question: "the bench record holds 3.2 V on the 4R7 nearest U4, but the operator said it of 'the other r47', and the K1-a's 3.2 V inductor is the farther one; kept where it stands until adjudicated",
}

data e1_out_fault_key: NonEmptyStr = "e1-out-to-gnd-fault"

data e1_out_fault: ClassifiedHypothesis = ClassifiedHypothesis {
  hypothesis: InvestigationHypothesis {
    claim: "the E1-b's near-U4 OUT node holds about 0.05 ohm to the return through a part or copper not yet located",
    sources: [
      "0.20 V and 0.10 A forced through a taped contact read 5 mV across the board on 2026-11-02, before and after photo part 2 came off (e1_forced_current_readings)",
      "U10_P2 is off the board since 2026-11-01 (e1_u10p2_lift) and the low path remains, so the converter is not the present path",
      "photo part 2 reads open off the board (e1_photo_part_2_removal)",
      "at 1.0 A the OUT pad read 54 mV and the converter pad 55 mV, with 0 mV read directly across the inductor: no SW-side current shown, within a meter accuracy of about 1.5 mV",
      "the thermal camera at 1 to 3 A showed only the injection wire warm",
    ],
    decided_by: "a part whose removal clears the 0.20 V / 0.10 A reading and which reads near 0 ohm on its own off the board; or a located copper or via defect",
  },
  class: SpecimenDiagnostic { asset: p4261_e1_b },
  concerns: ["out", "gnd"],
}

data e1_fault_candidates: List<FaultCandidate> = [
  PartOnSheet { part: e1_photo_part(label: "1"), standing: CandidateOpen },
  PartOnSheet { part: e1_photo_part(label: "3"), standing: CandidateOpen },
  PartOnSheet { part: e1_photo_part(label: "2"), standing: CandidateExcludedAsPresentPath { why: "reads open off the board, and the 0.10 A reading was 5 mV before and after it came off" } },
  PartOnSheet { part: e1_converter_near, standing: CandidateExcludedAsPresentPath { why: "off the board since 2026-11-01 and the low path remains" } },
  NodeSideAsPath { node: "sw", standing: CandidateWeakened { why: "0 mV read across the inductor at 1.0 A; a drop under about 1.5 mV is not excluded" } },
  PartOffSheet { scope: "any part from OUT to the return that is not on the 2026-11-02 photograph, on either surface" },
  LoadOfNode { node: "out" },
  CopperOrVia { evidence: [e1_fissure_said] },
  ResidueOrBridge,
]

data lot_e1: NonEmptyStr = "the opened pair's E1 from the lot of ten: revision E, rail not shorted, module off, pad-level only (no asset identity yet)"

data baseline_outcomes: List<NonEmptyStr> = [
  "the display equals the probes-shorted display on the same fixed range: a low-impedance path at baseline on revision E, which promotes the connection only with a frame or document showing no part in series",
  "above it: not reachable at baseline; the value is kept as a link",
]

data sheet_asks: List<BenchAsk> = [
  BenchAsk {
    key: "lot-e1-sw-beep", on: lot_e1,
    procedure: "unpowered, J20 disconnected: probes shorted on a fixed range and the display noted, then U10_P2's pad 3 (or the fitted part's SW lead) to the 4R7's converter-side pad on that range",
    settles: [Settlement { target: "sw-pad3-to-l-converter-pad", observable: "the display between pad 3 and the converter-side pad against the probes-shorted display on the same range", outcomes: baseline_outcomes }],
  },
  BenchAsk {
    key: "lot-e1-part-ends", on: lot_e1,
    procedure: "unpowered, baseline first on a fixed range: each end of photo parts 1, 3 and 4 to 11 at the same site to the 4R7's OUT pad and to J20's black lead; and photo part 7's south end to part 8's south end",
    settles: [
      Settlement { target: "out", observable: "for each part end, the display to the 4R7's OUT pad against the baseline", outcomes: baseline_outcomes },
      Settlement { target: "gnd", observable: "for each part end, the display to J20's black lead against the baseline", outcomes: baseline_outcomes },
      Settlement { target: "out-7-8-chain", observable: "the display between part 7's south end and part 8's south end against the baseline", outcomes: baseline_outcomes },
      Settlement { target: "gnd-4-6-or-vin", observable: "each end of parts 4 to 6 to J20's black lead and to the footprint's VIN pad against the baseline", outcomes: ["one end at baseline to the return and the other at baseline to VIN: an input capacitor's placement", "both at baseline to the return: neither on VIN", "neither: still unresolved"] },
    ],
  },
  BenchAsk {
    key: "lot-e1-site-photo", on: lot_e1,
    procedure: "one straight-down frame of the site with the 4R7, the U10_P2 footprint, U100 and the parts around them, silkscreen legible",
    settles: [
      Settlement { target: "out-copper-route", observable: "the copper visibly leaving the 4R7's OUT pad in the frame", outcomes: ["a pour or trace visibly reaching named parts: candidate members to read", "the copper dives to a via: the route is on an inner layer and stays unresolved"] },
      Settlement { target: "sw-pad3-to-l-converter-pad", observable: "whether copper visibly runs from pad 3 to the 4R7's converter-side pad with no part between", outcomes: ["a trace or pour with no part between, both ends in frame: copper can be claimed on that frame", "the copper leaves the frame or dives to a via: the path stays series-unresolved"] },
    ],
  },
  BenchAsk {
    key: "e1b-lift-1-then-3", on: "the E1-b (the operator's 2026-11-05 hold on further removals applies until they lift it)",
    procedure: "lift photo part 1 with hot air and kapton on its neighbours, read it alone, repeat 0.20 V / 0.10 A; if unchanged, photo part 3 the same way",
    settles: [Settlement { target: "e1-out-to-gnd-fault", observable: "the board's millivolts at 0.20 V / 0.10 A after each lift, and the lifted part's own resistance", outcomes: ["the board reads well above 5 mV and the part reads near 0 ohm alone: that part was the low path", "unchanged and the part reads open: not that part; the candidates off the photograph remain"] }],
  },
]

fn label_alias(label: NonEmptyStr, pointed_at: NonEmptyStr) -> SheetAlias {
  SheetAlias { label: label, part: e1_photo_part(label: label), frame: e1_rail_photograph, pointed_at: pointed_at }
}

