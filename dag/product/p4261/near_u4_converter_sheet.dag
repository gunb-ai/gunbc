  key: "gnd",
  anchor: e1_ground_ref,
  joins: [
    ReadJoin {
      first: e1_pad(number: 4, name: "GND"), second: e1_ground_ref, readings: gnd_pin_readings,
      counterpart: "the K1-a's U10_P2 GND lead to J20's black lead, '0', read with the part fitted",
    },
    ReadJoin {
      first: e1_terminal(c: e1_u100, name: "dot-side lead, bottom"), second: e1_ground_ref, readings: u100_dot_side_readings,
      counterpart: "the K1-a's U100 dot-side leads to J20's black lead, 'ground' (the E1-b's four read 1 ohm after the short, which places nothing)",
    },
  ],
  by_datasheet: [],
  candidates: [
    end_at_1a(label: "1", end: "north end", millivolts: 6, said: injection_said_3, ask: "lot-e1-part-ends"),
    end_at_1a(label: "3", end: "north end", millivolts: 6, said: injection_said_3, ask: "lot-e1-part-ends"),
    end_at_1a(label: "4", end: "first end", millivolts: 6, said: injection_said_3, ask: "lot-e1-part-ends"),
    end_at_1a(label: "4", end: "second end", millivolts: 6, said: injection_said_3, ask: "lot-e1-part-ends"),
    end_at_1a(label: "5", end: "first end", millivolts: 6, said: injection_said_3, ask: "lot-e1-part-ends"),
    end_at_1a(label: "5", end: "second end", millivolts: 6, said: injection_said_3, ask: "lot-e1-part-ends"),
    end_at_1a(label: "6", end: "first end", millivolts: 6, said: injection_said_3, ask: "lot-e1-part-ends"),
    end_at_1a(label: "6", end: "second end", millivolts: 6, said: injection_said_3, ask: "lot-e1-part-ends"),
  ],
  continuations: [
    UnknownContinuation { key: "gnd-4-6-or-vin", from: part_end(label: "4", end: "first end"), unknown: "photo parts 4 to 6 read about 6 mV at every end: neither end is in OUT's class, but VIN, held near the return through about 5 kohm with the converter lifted, would read the same as the return; which they join is unread", observations: [], settled_by: Present { value: "lot-e1-part-ends" } },
    UnknownContinuation { key: "u100-far-side", from: e1_terminal(c: e1_u100, name: "far-side lead, bottom"), unknown: "what U100's far-side leads join (6 to 10 kohm to the return on the K1-a); U100's role beside this converter is unread", observations: [], settled_by: Absent },
  ],
}

fn pin_stub(key: NonEmptyStr, number: Nat, name: NonEmptyStr, unknown: NonEmptyStr) -> SheetNode {
  SheetNode {
    key: key, anchor: e1_pad(number: number, name: name), joins: [], by_datasheet: [], candidates: [],
    continuations: [UnknownContinuation { key: join([key as String, "-continuation"], "") as NonEmptyStr, from: e1_pad(number: number, name: name), unknown: unknown, observations: [], settled_by: Absent }],
  }
}

data sheet_vin_node: SheetNode = pin_stub(key: "vin", number: 2, name: "VIN", unknown: "the rail that feeds VIN; the K1-a's VIN reads 5.0 to 5.5 kohm to the return, at the lead and at the bare pad")

data sheet_pg_node: SheetNode = SheetNode {
  key: "pg", anchor: e1_pad(number: 1, name: "PG"), joins: [], by_datasheet: [], candidates: [],
  continuations: [UnknownContinuation { key: "pg-continuation", from: e1_pad(number: 1, name: "PG"), unknown: "PG's pull-up and where it goes (16 kohm to the return on the K1-a, 9 kohm on the E1-b); with the converter lifted the E1-b's PG pad read 55 mV under injection, which says some path reaches the forced rail, not that PG is that node -- the K1-a's PG and OUT read unequal to the return", observations: [at_1a(at: e1_pad(number: 1, name: "PG"), millivolts: 55, said: injection_said_2)], settled_by: Absent }],
}

data sheet_en_node: SheetNode = pin_stub(key: "en", number: 6, name: "EN", unknown: "what drives EN: the K1-a's bare pad reads 136 kohm to the return and 140 kohm to VIN, not the datasheet's 604 kohm auto-start to VIN, so a sequencer or a larger pull-up is not distinguished")

data sheet_ss_node: SheetNode = pin_stub(key: "ss", number: 7, name: "SS", unknown: "the soft-start network (19 to 50 Mohm to the return on the K1-a, 130 Mohm on the E1-b, as a capacitor alone would read)")

data sheet_fb_node: SheetNode = pin_stub(key: "fb", number: 8, name: "FB", unknown: "the feedback divider (50 kohm to the return on both boards); photo part 9, 54 mV to 30 mV under injection, is one candidate leg, unread")

data sheet_nodes: List<SheetNode> = [sheet_sw_node, sheet_out_node, sheet_gnd_node, sheet_vin_node, sheet_pg_node, sheet_en_node, sheet_ss_node, sheet_fb_node]

// ── THE E1-b'S STATE: WHAT WAS DONE TO IT, AND WHAT IS WRONG WITH IT ─────────────────────────────

// Photo part 2 came off on 2026-11-02 with the SMD1 alloy. Recorded here and not yet in the E1-b's bench
// record (product.p4261.e1_b e1_bench_record alterations): adding an alteration there re-places every
// later E1-b reading against a new event, which is the E1-b record's own change to make; the trigger is
// that record's next edit.
data e1_photo_part_2_removal: AssetAlteration = AssetAlteration {
  key: "2026-11-02 E1 photo part 2 removed",
  asset: p4261_e1_b,
  part: photo_part(label: "2"),
  performed_on: "2026-11-02",
  change: PartRemoved { refitted: false },
  evidence: part_2_removed_said,
}

data e1_out_fault_key: NonEmptyStr = "e1-out-to-gnd-fault"

data e1_out_fault: ClassifiedHypothesis = ClassifiedHypothesis {
  hypothesis: InvestigationHypothesis {
    claim: "the E1-b's near-U4 OUT node holds about 0.05 ohm to the return through a part or copper not yet located",
    sources: [
      "the supply at 0.20 V and 0.10 A through a taped contact read 5 mV across the board on 2026-11-02, before and after photo part 2 came off",
      "U10_P2 is off the board since 2026-11-01 (e1_u10p2_lift) and the low path remains, so the converter is not the present path",
      "photo part 2 reads open off the board",
      "at 1.0 A the OUT pad read 54 mV and the converter pad 55 mV, with 0 mV read directly across the inductor: no SW-side current shown, within a meter accuracy of about 1.5 mV",
      "the thermal camera at 1 to 3 A showed only the injection wire warm",
    ],
    decided_by: "a part whose removal clears the 0.20 V / 0.10 A reading and which reads near 0 ohm on its own off the board; or a located copper or via defect",
  },
  class: SpecimenDiagnostic { asset: p4261_e1_b },
  concerns: ["out", "gnd"],
}

data e1_fault_candidates: List<FaultCandidate> = [
  PartOnSheet { part: photo_part(label: "1"), standing: CandidateOpen },
  PartOnSheet { part: photo_part(label: "3"), standing: CandidateOpen },
  PartOnSheet { part: photo_part(label: "2"), standing: CandidateExcludedAsPresentPath { why: "reads open off the board, and the 0.10 A reading was 5 mV before and after it came off" } },
  PartOnSheet { part: e1_converter_near, standing: CandidateExcludedAsPresentPath { why: "off the board since 2026-11-01 and the low path remains" } },
  NodeSideAsPath { node: "sw", standing: CandidateWeakened { why: "0 mV read across the inductor at 1.0 A; a drop under about 1.5 mV is not excluded" } },
  PartOffSheet { scope: "any part from OUT to the return that is not on the 2026-11-02 photograph, on either surface" },
  LoadOfNode { node: "out" },
  CopperOrVia { evidence: [e1_fissure_said] },
  ResidueOrBridge,
]

// ── THE READS THAT WOULD MOVE THIS SHEET, EACH NAMING WHAT IT SETTLES ─────────────────────────────

data lot_e1: NonEmptyStr = "the opened pair's E1 from the lot of ten: the E1-b's revision, rail not shorted, module off, pad-level only (no asset identity yet)"

data sheet_asks: List<BenchAsk> = [
  BenchAsk { key: "lot-e1-sw-beep", on: lot_e1, procedure: "unpowered, J20 disconnected, probes-together baseline first: beep U10_P2's SW lead (pad 3) to the 4R7's converter-side pad", settles: ["sw"] },
  BenchAsk { key: "lot-e1-part-ends", on: lot_e1, procedure: "unpowered, baseline first: each end of photo parts 1, 3 and 4 to 11 at the same site to the 4R7's OUT pad and to J20's black lead, beep or ohms", settles: ["out", "gnd", "out-7-8-chain", "out-9-far-end", "gnd-4-6-or-vin"] },
  BenchAsk { key: "lot-e1-site-photo", on: lot_e1, procedure: "one straight-down frame of the site with the 4R7, the U10_P2 footprint, U100 and the parts around them, silkscreen legible", settles: ["out-loads"] },
  BenchAsk { key: "e1b-lift-1-then-3", on: "the E1-b (the operator's 2026-11-05 hold on further removals applies until they lift it)", procedure: "lift photo part 1 with hot air and kapton on its neighbours, read it alone, repeat 0.20 V / 0.10 A; if unchanged, photo part 3 the same way", settles: ["e1-out-to-gnd-fault"] },
]

data near_u4_converter_sheet: ConverterSheet = ConverterSheet {
  aliases: sheet_aliases,
  nodes: sheet_nodes,
  injection: injection_readings,
  e1_removals: [e1_u10p2_lift, e1_photo_part_2_removal],
  fault_key: e1_out_fault_key,
  e1_fault: e1_out_fault,
  fault_candidates: e1_fault_candidates,
  asks: sheet_asks,
}

// ── WHAT A SHEET MUST HOLD ───────────────────────────────────────────────────────────────────────

// A node's read members: its anchor and both ends of every read join. Candidates and datasheet members
// are not members.
fn node_members(n: SheetNode) -> List<ElectricalTerminalRef> {
  concat([n.anchor], flat_map(n.joins, j => [j.first, j.second]))
}

fn member_of(ts: List<ElectricalTerminalRef>, t: ElectricalTerminalRef) -> Bool {
  count(filter(ts, m => terminal_ref_equal(a: m, b: t))) > 0
}

fn nodes_share_a_member(a: SheetNode, b: SheetNode) -> Bool {
  count(filter(node_members(n: a), t => member_of(ts: node_members(n: b), t: t))) > 0
}

// Two distinct nodes of one sheet never share a read member: if they did they would be one node. SW and
// OUT are the case that matters here -- the inductor's winding sits between them.
fn nodes_disjoint(ns: List<SheetNode>) -> Bool {
  count(filter(ns, a => count(filter(ns, b => a.key != b.key && nodes_share_a_member(a: a, b: b))) > 0)) == 0
}

// A join rests on a board whose rail is not shorted: none of its readings is on the E1-b.
fn joins_off_the_shorted_board(ns: List<SheetNode>) -> Bool {
  count(filter(flat_map(ns, n => n.joins), j => count(j.readings) == 0 || count(filter(j.readings, o => on_asset(asset: p4261_e1_b, a: o.asset))) > 0)) == 0
}

fn continuation_keys(ns: List<SheetNode>) -> List<NonEmptyStr> {
  flat_map(ns, n => map(n.continuations, c => c.key))
}

fn settle_targets(s: ConverterSheet) -> List<NonEmptyStr> {
  concat(concat(map(s.nodes, n => n.key), continuation_keys(ns: s.nodes)), [s.fault_key])
}

fn key_in(ks: List<NonEmptyStr>, k: NonEmptyStr) -> Bool {
  count(filter(ks, x => x == k)) > 0
}

// Every ask names at least one thing it settles, and every name is a node, a continuation or the fault.
fn asks_settle_named_targets(s: ConverterSheet) -> Bool {
  count(filter(s.asks, a => count(a.settles) == 0 || count(filter(a.settles, k => !key_in(ks: settle_targets(s: s), k: k))) > 0)) == 0
}

fn no_keys() -> List<NonEmptyStr> {
  []
}

fn present_key(k: NonEmptyStr?) -> List<NonEmptyStr> {
  match k {
    Absent => no_keys()
    Present { value } => [value]
  }
}

fn present_keys(ks: List<NonEmptyStr?>) -> List<NonEmptyStr> {
  flat_map(ks, k => present_key(k: k))
}

// Every "settled by" a row names is an ask that exists.
fn settled_by_names_asks(s: ConverterSheet) -> Bool {
  let ask_keys = map(s.asks, a => a.key)
  let named = present_keys(ks: concat(concat(
    flat_map(s.nodes, n => map(n.candidates, c => c.settled_by)),
    flat_map(s.nodes, n => map(n.by_datasheet, d => d.settled_by))),
    flat_map(s.nodes, n => map(n.continuations, c => c.settled_by))))
  count(filter(named, k => !key_in(ks: ask_keys, k: k))) == 0
}

fn is_off_sheet(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => true
    LoadOfNode { node: _ } => false
    CopperOrVia { evidence: _ } => false
    ResidueOrBridge => false
  }
}

fn is_load(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => false
    LoadOfNode { node: _ } => true
    CopperOrVia { evidence: _ } => false
    ResidueOrBridge => false
  }
}

fn is_copper(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => false
    LoadOfNode { node: _ } => false
    CopperOrVia { evidence: _ } => true
    ResidueOrBridge => false
  }
}

// The candidate set is not the photograph: a part off it, the node's loads and the copper are each named.
fn fault_reaches_beyond_the_sheet(cs: List<FaultCandidate>) -> Bool {
  count(filter(cs, c => is_off_sheet(c: c))) > 0 && count(filter(cs, c => is_load(c: c))) > 0 && count(filter(cs, c => is_copper(c: c))) > 0
}

fn no_parts() -> List<ComponentInstanceIdentity> {
  []
}

fn candidate_part(c: FaultCandidate) -> List<ComponentInstanceIdentity> {
  match c {
    PartOnSheet { part, standing: _ } => [part]
    NodeSideAsPath { node: _, standing: _ } => no_parts()
    PartOffSheet { scope: _ } => no_parts()
    LoadOfNode { node: _ } => no_parts()
    CopperOrVia { evidence: _ } => no_parts()
    ResidueOrBridge => no_parts()
  }
}

// The parts the sheet places anywhere: in a node (member, candidate, datasheet member, continuation), in
// the E1-b's removals, in the fault candidates, or as an injection point.
fn sheet_parts(s: ConverterSheet) -> List<ComponentInstanceIdentity> {
  let ends = concat(concat(concat(
    flat_map(s.nodes, n => node_members(n: n)),
    flat_map(s.nodes, n => map(n.candidates, c => c.terminal))),
    flat_map(s.nodes, n => map(n.by_datasheet, d => d.terminal))),
    flat_map(s.nodes, n => flat_map(n.continuations, c => concat([c.from], map(c.observations, o => o.at)))))
  concat(concat(concat(
    map(ends, t => t.component),
    map(s.e1_removals, a => a.part)),
    flat_map(s.fault_candidates, c => candidate_part(c: c))),
    flat_map(s.injection, r => [r.at.component, r.reference.component]))
}

// Every alias names a part the sheet places somewhere: a label that names nothing on the sheet is a
// dangling name.
fn aliases_resolve(s: ConverterSheet) -> Bool {
  let parts = sheet_parts(s: s)
  count(filter(s.aliases, a => count(filter(parts, p => component_identity_eq(a: p, b: a.part))) == 0)) == 0
}
