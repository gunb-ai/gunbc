// THE NEAR-U4 CONVERTER SITE (U10_P2) AS A PARTIAL SCHEMATIC SHEET, AND ITS DRAWING. The sheet names the
// E1-b's own component and terminal identities -- including parts with no designator read, which keep a
// stable photo-anchored identity (product.p4261.e1_b e1_photo_part) -- and keeps four things apart: what
// the copper is proposed to join and on what evidence, what the datasheet alone predicts, what forced-
// current millivolts suggest, and what has been done to the E1-b and is wrong with it. sheet_svg draws it;
// the drawing is regenerated from these rows whenever they change, incomplete nodes and all.
//
// NOTHING HERE IS YET A JOIN, AND THE DATA SAYS SO. A connection's terminals become members of a node only
// when its evidence joins them at the shorted-probe baseline (product.electrical.bench_session: "a zero the
// operator reports with no such baseline recorded ... joins nothing") AND each sheet terminal's
// correspondence to the observed one is established. Today every connection rests on the K1-a -- revision
// K, rail not shorted -- with zeros reported without a baseline, and each E1-b terminal's correspondence to
// the K1-a's is proposed by placement. So every connection is drawn as proposed, its grade and its
// correspondence shown, and every node's only member is its anchor. On the E1-b itself, every point on SW,
// OUT or the return reads about 0 ohm to every other since the 2026-10-21 short, so no E1-b resistance
// reading there is admitted as support at all.
//
// WHERE THIS GOES NEXT. Board wiring is NVIDIA's design fact (extdeps.nvidia.p4261.netlist). A connection
// moves there when a board of the E revision reads it at baseline; a missing silkscreen designator does not
// block it, because a position can be named by its anonymous body as this sheet names it.

// ── PROPOSED CONNECTIONS, AND WHAT THEIR EVIDENCE IS WORTH ─────────────────────────────────────────

type CorrespondenceStanding
  = CorrespondenceProposed { basis: NonEmptyStr }
  | CorrespondenceEstablished { evidence: List<EvidenceRef> }

// One end of a proposed connection: the E1-b terminal the sheet draws, the terminal the evidence was read
// at, and how the two are said to be the same point of the design.
type Correspondence {
  sheet: ElectricalTerminalRef
  counterpart: ElectricalTerminalRef
  standing: CorrespondenceStanding
}

type ProposedConnection {
  key: NonEmptyStr
  first: Correspondence
  second: Correspondence
  observed: List<ResistanceObservation>
}

// What one reading can say about a connection, from its display alone.
type SupportGrade
  = JoinsAtBaseline
  | ReportedZeroNoBaseline
  | NotJoinEvidence

fn support_grade(o: ResistanceObservation) -> SupportGrade {
  if is_at_baseline(o: o) { JoinsAtBaseline } else {
    match o.display {
      DisplayZeroWithoutBaseline { reported: _ } => ReportedZeroNoBaseline
      DisplayAtProbeBaseline { shown: _, baseline: _ } => NotJoinEvidence
      DisplayValue { ohms: _, approximate: _ } => NotJoinEvidence
      DisplayAboveBaseline => NotJoinEvidence
      DisplayOverRange => NotJoinEvidence
    }
  }
}

fn is_unpowered_reading(o: ResistanceObservation) -> Bool {
  match o.conditions.power {
    Unpowered => true
    Energized => false
  }
}

fn same_pair(o: ResistanceObservation, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> Bool {
  (terminal_ref_equal(a: o.first, b: a) && terminal_ref_equal(a: o.second, b: b)) || (terminal_ref_equal(a: o.first, b: b) && terminal_ref_equal(a: o.second, b: a))
}

fn is_join_evidence(g: SupportGrade) -> Bool {
  match g {
    JoinsAtBaseline => true
    ReportedZeroNoBaseline => true
    NotJoinEvidence => false
  }
}

// A connection is admissible when it has evidence and every reading cited is (a) between exactly the two
// counterpart terminals, (b) unpowered, (c) not on the E1-b, whose readings here place nothing, and (d) a
// display that could join: at the baseline, or a reported zero. A kilohm reading, an over-range or a
// reading between other points is refused, so an unrelated or nonzero reading cannot stand as support.
fn connection_admissible(c: ProposedConnection) -> Bool {
  count(c.observed) > 0 && count(filter(c.observed, o =>
    !same_pair(o: o, a: c.first.counterpart, b: c.second.counterpart)
      || !is_unpowered_reading(o: o)
      || on_asset(asset: p4261_e1_b, a: o.asset)
      || !is_join_evidence(g: support_grade(o: o)))) == 0
}

fn established(s: CorrespondenceStanding) -> Bool {
  match s {
    CorrespondenceProposed { basis: _ } => false
    CorrespondenceEstablished { evidence: _ } => true
  }
}

// A connection joins its sheet terminals only when it is admissible, some reading joins at baseline, and
// both correspondences are established. Reported zeros and proposed correspondences never promote.
fn connection_joins(c: ProposedConnection) -> Bool {
  connection_admissible(c: c)
    && count(filter(c.observed, o => match support_grade(o: o) { JoinsAtBaseline => true, ReportedZeroNoBaseline => false, NotJoinEvidence => false })) > 0
    && established(s: c.first.standing) && established(s: c.second.standing)
}

fn connection_grade_text(c: ProposedConnection) -> String {
  if connection_joins(c: c) { "joins at baseline" } else {
    if !connection_admissible(c: c) { "REFUSED: evidence does not fit" } else {
      if count(filter(c.observed, o => match support_grade(o: o) { JoinsAtBaseline => true, ReportedZeroNoBaseline => false, NotJoinEvidence => false })) > 0 { "at baseline on the counterpart; correspondence proposed" } else { "reported 0, no baseline, on the counterpart; correspondence proposed" }
    }
  }
}

// ── NODES ──────────────────────────────────────────────────────────────────────────────────────────

type DatasheetMember {
  terminal: ElectricalTerminalRef
  basis: NonEmptyStr
}

// An end that read in a node's voltage class with current forced through the rail. A candidate is never a
// member: its readings are ForcedCurrentReading, which no join accepts.
type CandidateEnd {
  terminal: ElectricalTerminalRef
  readings: List<ForcedCurrentReading>
}

type UnknownContinuation {
  key: NonEmptyStr
  from: ElectricalTerminalRef
  unknown: NonEmptyStr
}

type SheetNode {
  key: NonEmptyStr
  anchor: ElectricalTerminalRef
  connections: List<ProposedConnection>
  by_datasheet: List<DatasheetMember>
  candidates: List<CandidateEnd>
  continuations: List<UnknownContinuation>
}

// A record the sheet relies on whose attribution is disputed; it is cited where it stands, not moved.
type AttributionDispute {
  key: NonEmptyStr
  held: List<PhaseNodeVoltage>
  evidence: EvidenceRef
  question: NonEmptyStr
}

type CandidateStanding
  = CandidateOpen
  | CandidateWeakened { why: NonEmptyStr }
  | CandidateExcludedAsPresentPath { why: NonEmptyStr }

// Where the E1-b's fault current could be going. Wider than the photograph on purpose: a part not on the
// sheet, whatever the node feeds, and the copper itself are candidates in their own right.
type FaultCandidate
  = PartOnSheet { part: ComponentInstanceIdentity, standing: CandidateStanding }
  | NodeSideAsPath { node: NonEmptyStr, standing: CandidateStanding }
  | PartOffSheet { scope: NonEmptyStr }
  | LoadOfNode { node: NonEmptyStr }
  | CopperOrVia { evidence: List<EvidenceRef> }
  | ResidueOrBridge

// What one read would settle: the target it bears on (a connection, a continuation or the fault), the
// precise observable, and the outcomes it can have. A beep or a baseline reading is reachability at the
// meter's threshold, so outcomes are written as what the display shows, not as copper.
type Settlement {
  target: NonEmptyStr
  observable: NonEmptyStr
  outcomes: List<NonEmptyStr>
}

type BenchAsk {
  key: NonEmptyStr
  on: NonEmptyStr
  procedure: NonEmptyStr
  settles: List<Settlement>
}

type SheetAlias {
  label: NonEmptyStr
  part: ComponentInstanceIdentity
  frame: EvidenceRef
  pointed_at: NonEmptyStr
}

type ConverterSheet {
  title: NonEmptyStr
  aliases: List<SheetAlias>
  nodes: List<SheetNode>
  disputes: List<AttributionDispute>
  e1_removals: List<AssetAlteration>
  fault_key: NonEmptyStr
  e1_fault: ClassifiedHypothesis
  fault_candidates: List<FaultCandidate>
  asks: List<BenchAsk>
}

// ── THE ROWS ───────────────────────────────────────────────────────────────────────────────────────

data l_out_pad: ElectricalTerminalRef = e1_terminal(c: e1_l_4r7_near, name: inductor_pad_near_u4)

data l_converter_pad: ElectricalTerminalRef = e1_terminal(c: e1_l_4r7_near, name: inductor_pad_far_u4)

fn k1_terminal(c: ComponentInstanceIdentity, name: NonEmptyStr) -> ElectricalTerminalRef {
  terminal_ref(component: c, terminal: name as TerminalIdentity)
}

fn by_placement(basis: NonEmptyStr) -> CorrespondenceStanding {
  CorrespondenceProposed { basis: basis }
}

fn observed_between(os: List<ResistanceObservation>, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> List<ResistanceObservation> {
  filter(os, o => same_pair(o: o, a: a, b: b))
}

data sw_connection: ProposedConnection = ProposedConnection {
  key: "sw-pad3-to-l-converter-pad",
  first: Correspondence { sheet: e1_pad(number: 3, name: "SW"), counterpart: k1_terminal(c: k1_converter_near, name: "pin 3 (SW)"), standing: by_placement(basis: "the K1-a's U10_P2 SW lead, read with the part fitted, sits on the pad the E1-b's footprint numbers 3; the K1-a is revision K") },
  second: Correspondence { sheet: l_converter_pad, counterpart: k1_terminal(c: k1_l_4r7_near, name: inductor_pad_far_u4), standing: by_placement(basis: "the K1-a's 4R7 nearest U4, converter-side pad, at the same place beside U10_P2") },
  observed: observed_between(os: k1_converter_pair_resistances, a: k1_terminal(c: k1_converter_near, name: "pin 3 (SW)"), b: k1_terminal(c: k1_l_4r7_near, name: inductor_pad_far_u4)),
}

data gnd_pin_connection: ProposedConnection = ProposedConnection {
  key: "gnd-pad4-to-return",
  first: Correspondence { sheet: e1_pad(number: 4, name: "GND"), counterpart: k1_terminal(c: k1_converter_near, name: "pin 4 (GND)"), standing: by_placement(basis: "the K1-a's U10_P2 GND lead, read with the part fitted, sits on the pad the E1-b's footprint numbers 4") },
  second: Correspondence { sheet: e1_ground_ref, counterpart: k1_return, standing: by_placement(basis: "J20's black lead on both boards") },
  observed: observed_between(os: k1_near_converter_lead_resistances, a: k1_terminal(c: k1_converter_near, name: "pin 4 (GND)"), b: k1_return),
}

// One connection per U100 dot-side lead, each with its own reading: four leads read to the return are
// four supported terminals, never one terminal carrying four readings.
fn u100_dot_connection(lead: NonEmptyStr) -> ProposedConnection {
  ProposedConnection {
    key: join(["u100-", lead as String, "-to-return"], "") as NonEmptyStr,
    first: Correspondence { sheet: e1_terminal(c: e1_u100, name: lead), counterpart: k1_terminal(c: k1_u100, name: lead), standing: by_placement(basis: "U100 on both boards, the lead counted from its pin-1 dot the same way") },
    second: Correspondence { sheet: e1_ground_ref, counterpart: k1_return, standing: by_placement(basis: "J20's black lead on both boards") },
    observed: observed_between(os: k1_u100_lead_resistances, a: k1_terminal(c: k1_u100, name: lead), b: k1_return),
  }
}

data u100_dot_side_leads: List<NonEmptyStr> = ["dot-side lead, bottom", "dot-side lead, second from bottom", "dot-side lead, third from bottom", "dot-side lead, top"]

fn candidate_at(t: ElectricalTerminalRef) -> CandidateEnd {
  CandidateEnd { terminal: t, readings: filter(e1_forced_current_readings, r => terminal_ref_equal(a: r.at, b: t)) }
}

fn part_candidate(label: NonEmptyStr, end: NonEmptyStr) -> CandidateEnd {
  candidate_at(t: e1_photo_part_end(label: label, end: end))
}

data sheet_sw_node: SheetNode = SheetNode {
  key: "sw",
  anchor: l_converter_pad,
  connections: [sw_connection],
  by_datasheet: [
    DatasheetMember { terminal: e1_pad(number: 5, name: "BST"), basis: "the MP2333C typical circuit returns BST to SW through 1 uF in series with 20 ohm; DC-open on both boards (BST to SW over range on the E1-b, BST to the return high on the K1-a), as a series capacitor would read" },
  ],
  candidates: [],
  continuations: [],
}

data sheet_out_node: SheetNode = SheetNode {
  key: "out",
  anchor: l_out_pad,
  connections: [],
  by_datasheet: [],
  candidates: [
    part_candidate(label: "1", end: "south end"),
    part_candidate(label: "3", end: "south end"),
    part_candidate(label: "7", end: "north end"),
    part_candidate(label: "9", end: "left end"),
    part_candidate(label: "10", end: "first end"),
    part_candidate(label: "10", end: "second end"),
    part_candidate(label: "11", end: "first end"),
    part_candidate(label: "11", end: "second end"),
  ],
  continuations: [
    UnknownContinuation { key: "out-loads", from: l_out_pad, unknown: "what OUT powers and its operating voltage: unread on either board; see the dispute on the 2026-10-21 3.2 V record" },
    UnknownContinuation { key: "out-copper-route", from: l_out_pad, unknown: "where OUT's copper visibly runs from the inductor's OUT pad" },
    UnknownContinuation { key: "out-7-8-chain", from: e1_photo_part_end(label: "7", end: "south end"), unknown: "photo part 7's south end and part 8's south end both read 50 mV under forced current; whether they are one node is unread" },
    UnknownContinuation { key: "out-9-far-end", from: e1_photo_part_end(label: "9", end: "right end"), unknown: "what photo part 9's right end reaches; it read 30 mV, so current flows through part 9" },
  ],
}

data sheet_gnd_node: SheetNode = SheetNode {
  key: "gnd",
  anchor: e1_ground_ref,
  connections: concat([gnd_pin_connection], map(u100_dot_side_leads, l => u100_dot_connection(lead: l))),
  by_datasheet: [],
  candidates: [
    part_candidate(label: "1", end: "north end"),
    part_candidate(label: "3", end: "north end"),
    part_candidate(label: "4", end: "first end"),
    part_candidate(label: "4", end: "second end"),
    part_candidate(label: "5", end: "first end"),
    part_candidate(label: "5", end: "second end"),
    part_candidate(label: "6", end: "first end"),
    part_candidate(label: "6", end: "second end"),
    part_candidate(label: "8", end: "north end"),
  ],
  continuations: [
    UnknownContinuation { key: "gnd-4-6-or-vin", from: e1_photo_part_end(label: "4", end: "first end"), unknown: "photo parts 4 to 6 read about 6 mV at every end: neither end is in OUT's class, but VIN, held near the return through about 5 kohm with the converter lifted, would read the same; which they join is unread" },
    UnknownContinuation { key: "u100-far-side", from: e1_terminal(c: e1_u100, name: "far-side lead, bottom"), unknown: "what U100's far-side leads join (6 to 10 kohm to the return on the K1-a); U100's role here is unread" },
  ],
}

fn pin_stub(key: NonEmptyStr, number: Nat, name: NonEmptyStr, unknown: NonEmptyStr) -> SheetNode {
  SheetNode {
    key: key, anchor: e1_pad(number: number, name: name), connections: [], by_datasheet: [], candidates: [],
    continuations: [UnknownContinuation { key: join([key as String, "-continuation"], "") as NonEmptyStr, from: e1_pad(number: number, name: name), unknown: unknown }],
  }
}

data sheet_vin_node: SheetNode = pin_stub(key: "vin", number: 2, name: "VIN", unknown: "the rail that feeds VIN; the K1-a's VIN reads 5.0 to 5.5 kohm to the return, at the lead and at the bare pad")

data sheet_pg_node: SheetNode = SheetNode {
  key: "pg", anchor: e1_pad(number: 1, name: "PG"), connections: [], by_datasheet: [], candidates: [candidate_at(t: e1_pad(number: 1, name: "PG"))],
  continuations: [UnknownContinuation { key: "pg-continuation", from: e1_pad(number: 1, name: "PG"), unknown: "PG's pull-up and where it goes (16 kohm to the return on the K1-a, 9 kohm on the E1-b); its 55 mV under forced current says some path reaches the forced rail, not that PG is that node: the K1-a's PG and OUT read unequal to the return" }],
}

data sheet_en_node: SheetNode = pin_stub(key: "en", number: 6, name: "EN", unknown: "what drives EN: the K1-a's bare pad reads 136 kohm to the return and 140 kohm to VIN, not the datasheet's 604 kohm auto-start to VIN")

data sheet_ss_node: SheetNode = pin_stub(key: "ss", number: 7, name: "SS", unknown: "the soft-start network (19 to 50 Mohm to the return on the K1-a, 130 Mohm on the E1-b, as a capacitor alone would read)")

data sheet_fb_node: SheetNode = pin_stub(key: "fb", number: 8, name: "FB", unknown: "the feedback divider (50 kohm to the return on both boards); photo part 9, 54 mV to 30 mV under forced current, is one candidate leg, unread")

data sheet_nodes: List<SheetNode> = [sheet_sw_node, sheet_out_node, sheet_gnd_node, sheet_vin_node, sheet_pg_node, sheet_en_node, sheet_ss_node, sheet_fb_node]

data out_voltage_dispute: AttributionDispute = AttributionDispute {
  key: "out-voltage-3v2",
  held: filter(e1_inductor_volts, v => component_identity_eq(a: v.at.component, b: e1_l_4r7_near)),
  evidence: e1_inductor_said,
  question: "the bench record holds 3.2 V on the 4R7 nearest U4, but the operator said it of 'the other r47', and the K1-a's 3.2 V inductor is the farther one; kept where it stands until adjudicated",
}

data e1_out_fault_key: NonEmptyStr = "e1-out-to-gnd-fault"

data e1_out_fault: ClassifiedHypothesis = ClassifiedHypothesis {
  hypothesis: InvestigationHypothesis {
    claim: "the E1-b's near-U4 OUT node holds about 0.05 ohm to the return through a part or copper not yet located",
    sources: [
      "0.20 V and 0.10 A forced through a taped contact read 5 mV across the board on 2026-11-02, before and after photo part 2 came off (e1_forced_current_readings)",
      "U10_P2 is off the board since 2026-11-01 (e1_u10p2_lift) and the low path remains, so the converter is not the present path",
      "photo part 2 reads open off the board (e1_photo_part_2_removal)",
      "at 1.0 A the OUT pad read 54 mV and the converter pad 55 mV, with 0 mV read directly across the inductor: no SW-side current shown, within a meter accuracy of about 1.5 mV",
      "the thermal camera at 1 to 3 A showed only the injection wire warm",
    ],
    decided_by: "a part whose removal clears the 0.20 V / 0.10 A reading and which reads near 0 ohm on its own off the board; or a located copper or via defect",
  },
  class: SpecimenDiagnostic { asset: p4261_e1_b },
  concerns: ["out", "gnd"],
}

data e1_fault_candidates: List<FaultCandidate> = [
  PartOnSheet { part: e1_photo_part(label: "1"), standing: CandidateOpen },
  PartOnSheet { part: e1_photo_part(label: "3"), standing: CandidateOpen },
  PartOnSheet { part: e1_photo_part(label: "2"), standing: CandidateExcludedAsPresentPath { why: "reads open off the board, and the 0.10 A reading was 5 mV before and after it came off" } },
  PartOnSheet { part: e1_converter_near, standing: CandidateExcludedAsPresentPath { why: "off the board since 2026-11-01 and the low path remains" } },
  NodeSideAsPath { node: "sw", standing: CandidateWeakened { why: "0 mV read across the inductor at 1.0 A; a drop under about 1.5 mV is not excluded" } },
  PartOffSheet { scope: "any part from OUT to the return that is not on the 2026-11-02 photograph, on either surface" },
  LoadOfNode { node: "out" },
  CopperOrVia { evidence: [e1_fissure_said] },
  ResidueOrBridge,
]

data lot_e1: NonEmptyStr = "the opened pair's E1 from the lot of ten: revision E, rail not shorted, module off, pad-level only (no asset identity yet)"

data baseline_outcomes: List<NonEmptyStr> = [
  "the display equals the probes-shorted display on the same fixed range: reachable at baseline, which promotes the connection on revision E",
  "above it: not reachable at baseline; the value is kept as a link",
]

data sheet_asks: List<BenchAsk> = [
  BenchAsk {
    key: "lot-e1-sw-beep", on: lot_e1,
    procedure: "unpowered, J20 disconnected: probes shorted on a fixed range and the display noted, then U10_P2's pad 3 (or the fitted part's SW lead) to the 4R7's converter-side pad on that range",
    settles: [Settlement { target: "sw-pad3-to-l-converter-pad", observable: "the display between pad 3 and the converter-side pad against the probes-shorted display on the same range", outcomes: baseline_outcomes }],
  },
  BenchAsk {
    key: "lot-e1-part-ends", on: lot_e1,
    procedure: "unpowered, baseline first on a fixed range: each end of photo parts 1, 3 and 4 to 11 at the same site to the 4R7's OUT pad and to J20's black lead; and photo part 7's south end to part 8's south end",
    settles: [
      Settlement { target: "out", observable: "for each part end, the display to the 4R7's OUT pad against the baseline", outcomes: baseline_outcomes },
      Settlement { target: "gnd", observable: "for each part end, the display to J20's black lead against the baseline", outcomes: baseline_outcomes },
      Settlement { target: "out-7-8-chain", observable: "the display between part 7's south end and part 8's south end against the baseline", outcomes: baseline_outcomes },
      Settlement { target: "gnd-4-6-or-vin", observable: "each end of parts 4 to 6 to J20's black lead and to the footprint's VIN pad against the baseline", outcomes: ["one end at baseline to the return and the other at baseline to VIN: an input capacitor's placement", "both at baseline to the return: neither on VIN", "neither: still unresolved"] },
    ],
  },
  BenchAsk {
    key: "lot-e1-site-photo", on: lot_e1,
    procedure: "one straight-down frame of the site with the 4R7, the U10_P2 footprint, U100 and the parts around them, silkscreen legible",
    settles: [Settlement { target: "out-copper-route", observable: "the copper visibly leaving the 4R7's OUT pad in the frame", outcomes: ["a pour or trace visibly reaching named parts: candidate members to read", "the copper dives to a via: the route is on an inner layer and stays unresolved"] }],
  },
  BenchAsk {
    key: "e1b-lift-1-then-3", on: "the E1-b (the operator's 2026-11-05 hold on further removals applies until they lift it)",
    procedure: "lift photo part 1 with hot air and kapton on its neighbours, read it alone, repeat 0.20 V / 0.10 A; if unchanged, photo part 3 the same way",
    settles: [Settlement { target: "e1-out-to-gnd-fault", observable: "the board's millivolts at 0.20 V / 0.10 A after each lift, and the lifted part's own resistance", outcomes: ["the board reads well above 5 mV and the part reads near 0 ohm alone: that part was the low path", "unchanged and the part reads open: not that part; the candidates off the photograph remain"] }],
  },
]

fn label_alias(label: NonEmptyStr, pointed_at: NonEmptyStr) -> SheetAlias {
  SheetAlias { label: label, part: e1_photo_part(label: label), frame: e1_rail_photograph, pointed_at: pointed_at }
}

// The leaders' ends, from the session's overlay on the stored frame, in that frame's own pixels.
data sheet_aliases: List<SheetAlias> = [
  label_alias(label: "1", pointed_at: "label 1's leader ends near (311, 997)"),
  label_alias(label: "2", pointed_at: "label 2's leader ends near (440, 1083)"),
  label_alias(label: "3", pointed_at: "label 3's leader ends near (525, 1158)"),
  label_alias(label: "4", pointed_at: "label 4's leader ends near (656, 825)"),
  label_alias(label: "5", pointed_at: "label 5's leader ends near (783, 911)"),
  label_alias(label: "6", pointed_at: "label 6's leader ends near (847, 1013)"),
  label_alias(label: "7", pointed_at: "label 7's leader ends near (1018, 697)"),
  label_alias(label: "8", pointed_at: "label 8's leader ends near (1085, 740)"),
  label_alias(label: "9", pointed_at: "label 9's leader ends near (1075, 1327)"),
  label_alias(label: "10", pointed_at: "label 10's leader ends near (938, 1549)"),
  label_alias(label: "11", pointed_at: "not in this frame: the operator's 'right next to 10'"),
  SheetAlias { label: "G", part: e1_plated_hole_g, frame: e1_rail_photograph, pointed_at: "label G's leader ends near (287, 1273)" },
  SheetAlias { label: "W", part: e1_injection_wire_w, frame: e1_rail_photograph, pointed_at: "label W's leader ends near (354, 1587)" },
  SheetAlias { label: "FP", part: e1_converter_near_footprint, frame: e1_rail_photograph, pointed_at: "label FP's leader ends near (970, 1083), the footprint's pad rows" },
]

data near_u4_converter_sheet: ConverterSheet = ConverterSheet {
  title: "P4261 E1-b near-U4 converter site (U10_P2): reconstructed sheet 1",
  aliases: sheet_aliases,
  nodes: sheet_nodes,
  disputes: [out_voltage_dispute],
  e1_removals: [e1_u10p2_lift, e1_photo_part_2_removal],
  fault_key: e1_out_fault_key,
  e1_fault: e1_out_fault,
  fault_candidates: e1_fault_candidates,
  asks: sheet_asks,
}

// ── WHAT A SHEET MUST HOLD ─────────────────────────────────────────────────────────────────────────

// A node's members: its anchor and the sheet terminals of every connection that joins. Proposed
// connections, datasheet members and candidates are not members.
fn node_members(n: SheetNode) -> List<ElectricalTerminalRef> {
  concat([n.anchor], flat_map(filter(n.connections, c => connection_joins(c: c)), c => [c.first.sheet, c.second.sheet]))
}

// Every terminal a node reaches by any route the sheet draws, joined or proposed.
fn node_reach(n: SheetNode) -> List<ElectricalTerminalRef> {
  concat([n.anchor], flat_map(n.connections, c => [c.first.sheet, c.second.sheet]))
}

fn member_of(ts: List<ElectricalTerminalRef>, t: ElectricalTerminalRef) -> Bool {
  count(filter(ts, m => terminal_ref_equal(a: m, b: t))) > 0
}

fn share_a_terminal(a: List<ElectricalTerminalRef>, b: List<ElectricalTerminalRef>) -> Bool {
  count(filter(a, t => member_of(ts: b, t: t))) > 0
}

// No two nodes reach a common terminal, joined or proposed: if they did, they would be one node, or one of
// the proposals is wrong. SW and OUT, with the inductor's winding between them, are the case that matters.
fn nodes_disjoint(ns: List<SheetNode>) -> Bool {
  count(filter(ns, a => count(filter(ns, b => a.key != b.key && share_a_terminal(a: node_reach(n: a), b: node_reach(n: b)))) > 0)) == 0
}

fn connections_of(ns: List<SheetNode>) -> List<ProposedConnection> {
  flat_map(ns, n => n.connections)
}

fn all_connections_admissible(ns: List<SheetNode>) -> Bool {
  count(filter(connections_of(ns: ns), c => !connection_admissible(c: c))) == 0
}

fn continuation_keys(ns: List<SheetNode>) -> List<NonEmptyStr> {
  flat_map(ns, n => map(n.continuations, c => c.key))
}

fn settle_targets(s: ConverterSheet) -> List<NonEmptyStr> {
  concat(concat(concat(map(s.nodes, n => n.key), continuation_keys(ns: s.nodes)), map(connections_of(ns: s.nodes), c => c.key)), [s.fault_key])
}

fn key_in(ks: List<NonEmptyStr>, k: NonEmptyStr) -> Bool {
  count(filter(ks, x => x == k)) > 0
}

// Every ask settles something, each settlement names a target the sheet carries, says what is observed,
// and lists at least two outcomes -- a read with one possible outcome decides nothing.
fn asks_settle_named_targets(s: ConverterSheet) -> Bool {
  count(filter(s.asks, a => count(a.settles) == 0 || count(filter(a.settles, t => !key_in(ks: settle_targets(s: s), k: t.target) || count(t.outcomes) < 2)) > 0)) == 0
}

fn is_off_sheet(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => true
    LoadOfNode { node: _ } => false
    CopperOrVia { evidence: _ } => false
    ResidueOrBridge => false
  }
}

fn is_load(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => false
    LoadOfNode { node: _ } => true
    CopperOrVia { evidence: _ } => false
    ResidueOrBridge => false
  }
}

fn is_copper(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => false
    LoadOfNode { node: _ } => false
    CopperOrVia { evidence: _ } => true
    ResidueOrBridge => false
  }
}

fn fault_reaches_beyond_the_sheet(cs: List<FaultCandidate>) -> Bool {
  count(filter(cs, c => is_off_sheet(c: c))) > 0 && count(filter(cs, c => is_load(c: c))) > 0 && count(filter(cs, c => is_copper(c: c))) > 0
}

fn no_parts() -> List<ComponentInstanceIdentity> {
  []
}

fn candidate_part(c: FaultCandidate) -> List<ComponentInstanceIdentity> {
  match c {
    PartOnSheet { part, standing: _ } => [part]
    NodeSideAsPath { node: _, standing: _ } => no_parts()
    PartOffSheet { scope: _ } => no_parts()
    LoadOfNode { node: _ } => no_parts()
    CopperOrVia { evidence: _ } => no_parts()
    ResidueOrBridge => no_parts()
  }
}

fn sheet_terminals(s: ConverterSheet) -> List<ElectricalTerminalRef> {
  concat(concat(concat(
    flat_map(s.nodes, n => node_reach(n: n)),
    flat_map(s.nodes, n => flat_map(n.candidates, c => concat([c.terminal], flat_map(c.readings, r => [r.at, r.reference, r.injected_at]))))),
    flat_map(s.nodes, n => map(n.by_datasheet, d => d.terminal))),
    flat_map(s.nodes, n => map(n.continuations, c => c.from)))
}

fn sheet_parts(s: ConverterSheet) -> List<ComponentInstanceIdentity> {
  concat(concat(map(sheet_terminals(s: s), t => t.component), map(s.e1_removals, a => a.part)), flat_map(s.fault_candidates, c => candidate_part(c: c)))
}

// Every alias names a part the sheet places somewhere.
fn aliases_resolve(s: ConverterSheet) -> Bool {
  let parts = sheet_parts(s: s)
  count(filter(s.aliases, a => count(filter(parts, p => component_identity_eq(a: p, b: a.part))) == 0)) == 0
}

// ── THE DRAWING ────────────────────────────────────────────────────────────────────────────────────

// Text drawn into the SVG is never escaped here, so a text holding '&' or '<' is refused rather than drawn
// broken: sheet_svg renders only when every text it would draw passes.
fn drawable(t: String) -> Bool {
  !string_contains(s: t, pattern: "&") && !string_contains(s: t, pattern: "<")
}

fn tt(t: ElectricalTerminalRef) -> String {
  join([component_local_label(c: t.component) as String, " : ", t.terminal as String], "")
}

fn nat_text(n: Nat) -> String {
  to_string(n)
}

type DrawnLine {
  kind: NonEmptyStr
  text: String
}

fn candidate_text(c: CandidateEnd) -> String {
  join([tt(t: c.terminal), "  ", join(map(c.readings, r => join([nat_text(n: r.millivolts), " mV at ", nat_text(n: r.injected_milliamps), " mA"], "")), ", ")], "")
}

fn node_lines(n: SheetNode) -> List<DrawnLine> {
  concat(concat(concat(concat(
    [DrawnLine { kind: "head", text: join(["NODE ", n.key as String, "    anchor ", tt(t: n.anchor)], "") }],
    map(n.connections, c => DrawnLine { kind: if connection_joins(c: c) { "joined" } else { "proposed" }, text: join([tt(t: c.first.sheet), "  to  ", tt(t: c.second.sheet), "   [", connection_grade_text(c: c), "]"], "") })),
    map(n.by_datasheet, d => DrawnLine { kind: "datasheet", text: join([tt(t: d.terminal), "   [datasheet only] ", d.basis as String], "") })),
    map(n.candidates, c => DrawnLine { kind: "candidate", text: join([candidate_text(c: c), "   [forced-current class, not a member]"], "") })),
    map(n.continuations, c => DrawnLine { kind: "unknown", text: join(["? ", c.key as String, ": ", c.unknown as String], "") }))
}

fn candidate_line(c: FaultCandidate) -> String {
  match c {
    PartOnSheet { part, standing } => join([component_local_label(c: part) as String, ": ", match standing { CandidateOpen => "open", CandidateWeakened { why } => join(["weakened, ", why as String], ""), CandidateExcludedAsPresentPath { why } => join(["excluded as the present path, ", why as String], "") }], "")
    NodeSideAsPath { node, standing } => join(["the ", node as String, " side: ", match standing { CandidateOpen => "open", CandidateWeakened { why } => join(["weakened, ", why as String], ""), CandidateExcludedAsPresentPath { why } => join(["excluded, ", why as String], "") }], "")
    PartOffSheet { scope } => join(["off the sheet: ", scope as String], "")
    LoadOfNode { node } => join(["whatever ", node as String, " powers"], "")
    CopperOrVia { evidence: _ } => "copper or via damage, including the felt fissure along the converter's inductor-side lead row"
    ResidueOrBridge => "residue or a bridge not seen in the photographs"
  }
}

fn side_lines(s: ConverterSheet) -> List<DrawnLine> {
  concat(concat(concat(concat(concat(concat(
    [DrawnLine { kind: "head", text: "E1-b STATE (not design)" }],
    map(s.e1_removals, a => DrawnLine { kind: "state", text: join(["removed: ", a.key as String], "") })),
    [DrawnLine { kind: "state", text: join(["fault: ", s.e1_fault.hypothesis.claim as String], "") }]),
    map(s.fault_candidates, c => DrawnLine { kind: "state", text: join(["candidate: ", candidate_line(c: c)], "") })),
    map(s.disputes, d => DrawnLine { kind: "dispute", text: join(["DISPUTED ", d.key as String, ": ", d.question as String], "") })),
    [DrawnLine { kind: "head", text: "READS, EACH NAMING WHAT IT SETTLES" }]),
    flat_map(s.asks, a => map(a.settles, t => DrawnLine { kind: "ask", text: join([a.key as String, " settles ", t.target as String, ": ", t.observable as String], "") })))
}

fn alias_lines(s: ConverterSheet) -> List<DrawnLine> {
  concat([DrawnLine { kind: "head", text: "PHOTO-NUMBER ALIASES (stored rail photograph 4c0e4692...)" }], map(s.aliases, a => DrawnLine { kind: "alias", text: join([a.label as String, " = ", component_local_label(c: a.part) as String, "   (", a.pointed_at as String, ")"], "") }))
}

fn line_style(kind: NonEmptyStr) -> String {
  if kind == "head" { "font-weight:bold;fill:#111" } else {
    if kind == "joined" { "fill:#1b7f3b" } else {
      if kind == "proposed" { "fill:#b86e00" } else {
        if kind == "datasheet" { "fill:#b86e00;font-style:italic" } else {
          if kind == "candidate" { "fill:#666;font-style:italic" } else {
            if kind == "unknown" { "fill:#444" } else {
              if kind == "state" { "fill:#8a1c1c" } else {
                if kind == "dispute" { "fill:#c62828;font-weight:bold" } else { "fill:#222" }
              }
            }
          }
        }
      }
    }
  }
}

type Placed {
  y: Nat
  out: List<String>
}

fn place_lines(x: Nat, y0: Nat, ls: List<DrawnLine>) -> Placed {
  fold(ls, init: Placed { y: y0, out: [] }, f: (acc, l) => Placed {
    y: acc.y + 17,
    out: concat(acc.out, [join(["<text x=\"", nat_text(n: x), "\" y=\"", nat_text(n: acc.y), "\" font-size=\"12\" style=\"", line_style(kind: l.kind), "\">", l.text, "</text>"], "")]),
  })
}

fn sheet_lines(s: ConverterSheet) -> List<DrawnLine> {
  flat_map(s.nodes, n => concat(node_lines(n: n), [DrawnLine { kind: "gap", text: " " }]))
}

fn every_drawn_text(s: ConverterSheet) -> List<String> {
  map(concat(concat(concat(sheet_lines(s: s), side_lines(s: s)), alias_lines(s: s)), [DrawnLine { kind: "head", text: s.title as String }]), l => l.text)
}

fn sheet_drawable(s: ConverterSheet) -> Bool {
  count(filter(every_drawn_text(s: s), t => !drawable(t: t))) == 0
}

// The sheet as SVG, one column: the nodes, then the E1-b's state, disputes and reads, then the aliases.
// Colours: green joined, amber proposed or datasheet-only, grey a forced-current candidate, dark grey an
// unknown continuation, red the E1-b's state.
fn sheet_svg(s: ConverterSheet) -> String {
  let nodes = place_lines(x: 30, y0: 88, ls: sheet_lines(s: s))
  let side = place_lines(x: 30, y0: nodes.y + 14, ls: side_lines(s: s))
  let below = place_lines(x: 30, y0: side.y + 20, ls: alias_lines(s: s))
  let height = below.y + 30
  join(concat(concat(concat(
    [join(["<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"2000\" height=\"", nat_text(n: height), "\" font-family=\"DejaVu Sans, Arial, sans-serif\">"], ""),
     join(["<rect x=\"0\" y=\"0\" width=\"2000\" height=\"", nat_text(n: height), "\" fill=\"#ffffff\"/>"], ""),
     join(["<text x=\"30\" y=\"40\" font-size=\"22\" font-weight=\"bold\">", s.title as String, "</text>"], ""),
     "<text x=\"30\" y=\"64\" font-size=\"12\" fill=\"#555\">generated from product.p4261.near_u4_converter_sheet: green joined at baseline; amber proposed or datasheet-only; grey forced-current class, never a member; ? unknown continuation; red E1-b state</text>"],
    nodes.out), side.out), concat(below.out, ["</svg>"])), "\n")
}

fn near_u4_sheet_svg() -> String {
  sheet_svg(s: near_u4_converter_sheet)
}
