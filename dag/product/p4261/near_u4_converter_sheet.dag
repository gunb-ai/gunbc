fn photo_symbol(label: NonEmptyStr, x: Nat) -> PartSymbol {
  PartSymbol { part: e1_photo_part(label: label), label: join(["#", label as String], "") as NonEmptyStr, x: nat_saturating_sub(a: x, b: 18), y: 345, w: 36, h: 90 }
}

fn photo_pin(label: NonEmptyStr, end: NonEmptyStr, short: String, x: Nat, top: Bool) -> PinPlace {
  PinPlace { terminal: e1_photo_part_end(label: label, end: end), label: short, x: x, y: if top { 322 } else { 450 } }
}

fn pad_pin(number: Nat, name: NonEmptyStr, x: Nat, y: Nat) -> PinPlace {
  PinPlace { terminal: e1_pad(number: number, name: name), label: join([to_string(number), " ", name as String], ""), x: x, y: y }
}

fn u100_pin(lead: NonEmptyStr, short: String, x: Nat, y: Nat) -> PinPlace {
  PinPlace { terminal: e1_terminal(c: e1_u100, name: lead), label: short, x: x, y: y }
}

// The U10_P2 footprint centre-left with its eight pads, the inductor above it, the photo-numbered parts in
// a row to the right (each part's OUT-class end on top where it has one; parts 4 to 6 and the removed
// part 2 at the right), U100 and J20's return below.
data near_u4_layout: SheetLayout = SheetLayout {
  width: 2000,
  height: 800,
  symbols: [
    PartSymbol { part: e1_converter_near_footprint, label: "U10_P2 footprint", x: 480, y: 300, w: 170, h: 260 },
    PartSymbol { part: e1_converter_near, label: "U10_P2 chip", x: 490, y: 258, w: 150, h: 30 },
    PartSymbol { part: e1_l_4r7_near, label: "4R7 nearest U4", x: 820, y: 170, w: 160, h: 40 },
    PartSymbol { part: e1_ground_ref.component, label: "J20 return (black lead)", x: 1180, y: 700, w: 200, h: 40 },
    PartSymbol { part: e1_u100, label: "U100", x: 760, y: 600, w: 120, h: 150 },
    photo_symbol(label: "1", x: 1060), photo_symbol(label: "3", x: 1130), photo_symbol(label: "7", x: 1200),
    photo_symbol(label: "8", x: 1270), photo_symbol(label: "9", x: 1340), photo_symbol(label: "10", x: 1410),
    photo_symbol(label: "11", x: 1480), photo_symbol(label: "4", x: 1590), photo_symbol(label: "5", x: 1660),
    photo_symbol(label: "6", x: 1730), photo_symbol(label: "2", x: 1830),
  ],
  pins: [
    pad_pin(number: 2, name: "VIN", x: 480, y: 340), pad_pin(number: 6, name: "EN", x: 480, y: 400),
    pad_pin(number: 7, name: "SS", x: 480, y: 460), pad_pin(number: 8, name: "FB", x: 480, y: 520),
    pad_pin(number: 3, name: "SW", x: 650, y: 340), pad_pin(number: 5, name: "BST", x: 650, y: 400),
    pad_pin(number: 1, name: "PG", x: 650, y: 460), pad_pin(number: 4, name: "GND", x: 650, y: 520),
    PinPlace { terminal: l_converter_pad, label: "", x: 820, y: 190 },
