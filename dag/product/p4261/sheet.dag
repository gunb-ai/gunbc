// A PARTIAL SCHEMATIC SHEET OF THE P4261, BUILT FROM READINGS. One vocabulary for every sheet: a sheet
// names one carrier's own component and terminal identities -- including parts with no designator read,
// which keep a stable photo-anchored identity -- and keeps apart what the copper is proposed to join and
// on what evidence, what a measurement between two points bounds without joining them, what the
// datasheet alone predicts, which role a physical lead is a candidate for, what forced-current millivolts
// and energized voltages suggest, and what has been done to the specimen and what is suspected of it.
// export_sheet draws it -- a circuit view over the report it comes from -- or refuses it with reasons.
//
// A SHEET IS OF DECLARED BOARD STATES. Each carrier whose readings a sheet uses is named with the one
// state it is drawn in (product.p4261.readings BoardState: the board after named dividing events, in one
// module configuration). A reading is admitted only when product.electrical.bench_session places it in
// that state; a reading of the same points in another state, in another configuration, or of an order
// the record does not cover is kept on the sheet as exactly that, never joined into this state's view.
//
// NOTHING JOINS ON AN OHMMETER ALONE. A connection's terminals join the node reachable from its anchor
// only when its evidence joins them at the shorted-probe baseline (bench_session: "a zero the operator
// reports with no such baseline recorded ... joins nothing"), each sheet terminal's correspondence to
// the observed one is established, AND the path between them is claimed to be copper on evidence other
// than the ohmmeter: a baseline reading cannot tell copper from an inductor, a fuse, a shunt or a
// zero-ohm link in series. A measurement of some value between two points bounds what lies between them
// and joins nothing at any value.

// ── PROPOSED CONNECTIONS, AND WHAT THEIR EVIDENCE IS WORTH ─────────────────────────────────────────

// How a sheet terminal is said to be the terminal a reading was taken at: the same terminal of the same
// carrier (CorrespondenceIdentical, admissible only when the two are equal), or a counterpart on another
// carrier, by placement or on cited evidence.
type CorrespondenceStanding
  = CorrespondenceIdentical
  | CorrespondenceProposed { basis: NonEmptyStr }
  | CorrespondenceEstablished { evidence: List<EvidenceRef> }

type Correspondence {
  sheet: ElectricalTerminalRef
  counterpart: ElectricalTerminalRef
  standing: CorrespondenceStanding
}

// What the path between a connection's two terminals is claimed to be. An ohmmeter at its baseline shows a
// low-impedance path; whether it runs on external copper, through a part in series, or through the very
// part whose terminals these are is a separate fact, read from a frame that shows the copper or a document
// that names it, never from the reading. Two terminals of one footprint, connector or IC can be tied by
// external copper; that is claimed like any other copper. A path through a winding, fuse or shunt is
// ThroughPart, which never joins.
type PathClaim
  = CopperClaimed { basis: NonEmptyStr, evidence: List<EvidenceRef> }
  | SeriesUnresolved { why: NonEmptyStr }
  | ThroughPart { part: ComponentInstanceIdentity, why: NonEmptyStr }

type ProposedConnection {
  key: NonEmptyStr
  first: Correspondence
  second: Correspondence
  path: PathClaim
  observed: List<ResistanceObservation>
}

// What one reading can say about a connection, from its display alone.
type SupportGrade
  = JoinsAtBaseline
  | ReportedZeroNoBaseline
  | NotJoinEvidence

fn support_grade(o: ResistanceObservation) -> SupportGrade {
  if is_at_baseline(o: o) { JoinsAtBaseline } else {
    match o.display {
      DisplayZeroWithoutBaseline { reported: _ } => ReportedZeroNoBaseline
      DisplayAtProbeBaseline { shown: _, baseline: _ } => NotJoinEvidence
      DisplayValue { ohms: _, approximate: _ } => NotJoinEvidence
      DisplayAboveBaseline => NotJoinEvidence
      DisplayOverRange => NotJoinEvidence
    }
  }
}

fn is_unpowered_reading(o: ResistanceObservation) -> Bool {
  match o.conditions.power {
    Unpowered => true
    Energized => false
  }
}

fn same_pair(o: ResistanceObservation, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> Bool {
  (terminal_ref_equal(a: o.first, b: a) && terminal_ref_equal(a: o.second, b: b)) || (terminal_ref_equal(a: o.first, b: b) && terminal_ref_equal(a: o.second, b: a))
}

fn observed_between(os: List<ResistanceObservation>, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> List<ResistanceObservation> {
  filter(os, o => same_pair(o: o, a: a, b: b))
}

fn is_join_evidence(g: SupportGrade) -> Bool {
  match g {
    JoinsAtBaseline => true
    ReportedZeroNoBaseline => true
    NotJoinEvidence => false
  }
}

// ── THE DECLARED STATES ────────────────────────────────────────────────────────────────────────────

fn is_in_selection(d: ReadingDisposition) -> Bool {
  match d {
    InSelection => true
    OfAnotherState => false
    OfAnotherConfiguration => false
    Uncovered => false
    Unresolved => false
  }
}

fn disposition_text(d: ReadingDisposition) -> String {
  match d {
    InSelection => "in the sheet's state"
    OfAnotherState => "of another state"
    OfAnotherConfiguration => "of another module configuration"
    Uncovered => "order against the dividing events not recorded"
    Unresolved => "names an event the record does not hold"
  }
}

// How a reading of this asset, this order and these conditions stands against the sheet's declared
// states: in one of them, or why not. A carrier the sheet declares no state for is not admitted at all.
fn dispositions(states: List<BoardState>, asset: PhysicalAssetIdentity, order: ReadingOrder, conditions: BenchConditions) -> List<ReadingDisposition> {
  map(filter(states, s => physical_asset_identity_eq(a: s.board.asset, b: asset)), s => reading_disposition(r: s.board.bench, s: s.state, o: order, c: conditions))
}

fn in_states(states: List<BoardState>, asset: PhysicalAssetIdentity, order: ReadingOrder, conditions: BenchConditions) -> Bool {
  count(filter(dispositions(states: states, asset: asset, order: order, conditions: conditions), d => is_in_selection(d: d))) > 0
}

fn why_not_in_state(states: List<BoardState>, asset: PhysicalAssetIdentity, order: ReadingOrder, conditions: BenchConditions) -> String {
  let ds = dispositions(states: states, asset: asset, order: order, conditions: conditions)
  if count(ds) == 0 { "of a carrier the sheet declares no state for" } else { join(map(ds, d => disposition_text(d: d)), ", ") }
}

fn reading_admitted(states: List<BoardState>, o: ResistanceObservation) -> Bool {
  in_states(states: states, asset: o.asset, order: o.order, conditions: o.conditions)
}

fn voltage_admitted(states: List<BoardState>, v: NodeVoltageObservation) -> Bool {
  in_states(states: states, asset: v.asset, order: v.order, conditions: v.conditions)
}

// Every resistance and voltage reading the declared boards' records hold, whatever state it is of.
fn record_resistances(states: List<BoardState>) -> List<ResistanceObservation> {
  flat_map(states, s => s.board.bench.resistances)
}

fn record_voltages(states: List<BoardState>) -> List<NodeVoltageObservation> {
  flat_map(states, s => s.board.bench.voltages)
}

// The readings of one pair outside the sheet's states: kept and shown as such, never dropped.
fn outside_between(states: List<BoardState>, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> List<ResistanceObservation> {
  filter(observed_between(os: record_resistances(states: states), a: a, b: b), o => !reading_admitted(states: states, o: o))
}

fn outside_voltages_at(states: List<BoardState>, t: ElectricalTerminalRef) -> List<NodeVoltageObservation> {
  filter(record_voltages(states: states), v => terminal_ref_equal(a: v.at, b: t) && !voltage_admitted(states: states, v: v))
}

fn module_text(m: ModuleState) -> String {
  match m {
    ModuleRemoved => "module removed"
    ModuleInstalled { asset } => join(["module ", asset as String, " installed"], "")
    ModuleUnrecorded => "module unrecorded"
  }
}

fn keys_text(ks: List<NonEmptyStr>) -> String {
  join(map(ks, k => k as String), ", ")
}

// The declared state as the bench reader needs it: the carrier, the dividing events it is after, those
// it is before, and the module configuration.
fn state_text(s: BoardState) -> String {
  let later = filter(state_boundaries(r: s.board.bench, asset: s.board.asset), k => !key_listed(keys: s.state.after, k: k))
  join([s.board.asset as String, ": ", if count(s.state.after) == 0 { "intact (as received)" } else { join(["after ", keys_text(ks: s.state.after)], "") }, if count(later) == 0 { "" } else { join([", before ", keys_text(ks: later)], "") }, "; ", module_text(m: s.state.module)], "")
}

// ── ADMISSION ──────────────────────────────────────────────────────────────────────────────────────

fn correspondence_consistent(c: Correspondence) -> Bool {
  match c.standing {
    CorrespondenceIdentical => terminal_ref_equal(a: c.sheet, b: c.counterpart)
    CorrespondenceProposed { basis: _ } => true
    CorrespondenceEstablished { evidence: _ } => true
  }
}

// A path through a part names a part whose terminals both ends are.
fn path_consistent(c: ProposedConnection) -> Bool {
  match c.path {
    CopperClaimed { basis: _, evidence: _ } => true
    SeriesUnresolved { why: _ } => true
    ThroughPart { part, why: _ } => component_identity_eq(a: c.first.sheet.component, b: part) && component_identity_eq(a: c.second.sheet.component, b: part)
  }
}

// Why a connection is refused, each reason once; empty when it is admissible. A connection is admissible
// when its correspondences and path claim are consistent and it has evidence, every reading of which is
// (a) between exactly the two counterpart terminals, (b) unpowered, (c) in one of the sheet's declared
// states, and (d) a display that could join: at the baseline, or a reported zero. A kilohm reading, an
// over-range or a reading between other points is refused, so an unrelated or nonzero reading cannot
// stand as support; such a reading is a measurement.
fn connection_refusals(states: List<BoardState>, c: ProposedConnection) -> List<String> {
  concat(concat(concat(concat(concat(concat(concat(
    if correspondence_consistent(c: c.first) && correspondence_consistent(c: c.second) { [] } else { ["an identical correspondence names two different terminals"] },
    if path_consistent(c: c) { [] } else { ["the path is claimed through a part whose terminals these are not"] }),
    if count(c.observed) > 0 { [] } else { ["no reading is cited"] }),
    if count(filter(c.observed, o => !same_pair(o: o, a: c.first.counterpart, b: c.second.counterpart))) == 0 { [] } else { ["a cited reading is between other points"] }),
    if count(filter(c.observed, o => !is_unpowered_reading(o: o))) == 0 { [] } else { ["a cited reading was taken energized"] }),
    map(filter(c.observed, o => !reading_admitted(states: states, o: o)), o => join(["a cited reading is ", why_not_in_state(states: states, asset: o.asset, order: o.order, conditions: o.conditions)], ""))),
    if count(filter(c.observed, o => !is_join_evidence(g: support_grade(o: o)))) == 0 { [] } else { ["a cited reading is a value, over range or above the baseline, which cannot join"] }),
    [])
}

fn connection_admissible(states: List<BoardState>, c: ProposedConnection) -> Bool {
  count(connection_refusals(states: states, c: c)) == 0
}

// An established correspondence must cite its evidence; an empty list establishes nothing.
fn established(s: CorrespondenceStanding) -> Bool {
  match s {
    CorrespondenceIdentical => true
    CorrespondenceProposed { basis: _ } => false
    CorrespondenceEstablished { evidence } => count(evidence) > 0
  }
}

fn copper_claimed(p: PathClaim) -> Bool {
  match p {
    CopperClaimed { basis: _, evidence } => count(evidence) > 0
    SeriesUnresolved { why: _ } => false
    ThroughPart { part: _, why: _ } => false
  }
}

fn at_baseline_somewhere(c: ProposedConnection) -> Bool {
  count(filter(c.observed, o => match support_grade(o: o) { JoinsAtBaseline => true, ReportedZeroNoBaseline => false, NotJoinEvidence => false })) > 0
}

// A connection is a copper edge only when it is admissible, some reading joins at baseline, both
// correspondences are established, and the path is claimed to be copper on cited evidence. Reported zeros,
// proposed correspondences, an unresolved series path and a path through a part never promote.
fn connection_joins(states: List<BoardState>, c: ProposedConnection) -> Bool {
  connection_admissible(states: states, c: c) && at_baseline_somewhere(c: c)
    && established(s: c.first.standing) && established(s: c.second.standing)
    && copper_claimed(p: c.path)
}

fn same_carrier(c: ProposedConnection) -> Bool {
  match c.first.standing {
    CorrespondenceIdentical => match c.second.standing { CorrespondenceIdentical => true, CorrespondenceProposed { basis: _ } => false, CorrespondenceEstablished { evidence: _ } => false }
    CorrespondenceProposed { basis: _ } => false
    CorrespondenceEstablished { evidence: _ } => false
  }
}

fn evidence_grade_text(c: ProposedConnection) -> String {
  if at_baseline_somewhere(c: c) { "at baseline" } else { "reported 0, no baseline" }
}

fn correspondence_text(c: ProposedConnection) -> String {
  if same_carrier(c: c) { "read on this carrier" } else {
    if established(s: c.first.standing) && established(s: c.second.standing) { "cross-specimen, correspondence established" } else { "cross-specimen, correspondence proposed" }
  }
}

fn path_text(p: PathClaim) -> String {
  match p {
    CopperClaimed { basis: _, evidence: _ } => "copper claimed"
    SeriesUnresolved { why: _ } => "series parts unresolved"
    ThroughPart { part, why: _ } => join(["through ", component_local_label(c: part) as String], "")
  }
}

fn connection_grade_text(states: List<BoardState>, c: ProposedConnection) -> String {
  if connection_joins(states: states, c: c) { "joins at baseline; copper claimed" } else {
    if !connection_admissible(states: states, c: c) { join(["REFUSED: ", join(connection_refusals(states: states, c: c), "; ")], "") } else {
      join([evidence_grade_text(c: c), "; ", correspondence_text(c: c), "; ", path_text(p: c.path)], "")
    }
  }
}

// ── MEASUREMENTS, ROLES AND VOLTAGES ───────────────────────────────────────────────────────────────

// A measurement: readings of any value between exactly two points of a declared carrier. It bounds what
// lies between them -- 26 kohm across a resistor, 8 kohm from a gate to the return, a value that moves
// with the meter's range -- and joins nothing; it may span one part, since a reading across a part is what
// says what the part is. The circuit view marks its two points with its number; the readings are listed in
// the measurement table, not drawn as a trace.
type MeasuredLink {
  key: NonEmptyStr
  first: ElectricalTerminalRef
  second: ElectricalTerminalRef
  observed: List<ResistanceObservation>
  beeps: List<ContinuityObservation>
}

// A beep or a silence is reachability at the meter's threshold between two points, under that reading's
// conditions: it is a measurement, never copper, and joins nothing here.
fn same_beep_pair(o: ContinuityObservation, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> Bool {
  (terminal_ref_equal(a: o.first, b: a) && terminal_ref_equal(a: o.second, b: b)) || (terminal_ref_equal(a: o.first, b: b) && terminal_ref_equal(a: o.second, b: a))
}

fn beeps_between(os: List<ContinuityObservation>, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> List<ContinuityObservation> {
  filter(os, o => same_beep_pair(o: o, a: a, b: b))
}

fn beep_admitted(states: List<BoardState>, o: ContinuityObservation) -> Bool {
  in_states(states: states, asset: o.asset, order: o.order, conditions: o.conditions)
}

fn record_beeps(states: List<BoardState>) -> List<ContinuityObservation> {
  flat_map(states, s => s.board.continuity)
}

fn outside_beeps_between(states: List<BoardState>, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> List<ContinuityObservation> {
  filter(beeps_between(os: record_beeps(states: states), a: a, b: b), o => !beep_admitted(states: states, o: o))
}

fn link_refusals(states: List<BoardState>, l: MeasuredLink) -> List<String> {
  concat(concat(concat(concat(
    if count(l.observed) + count(l.beeps) > 0 { [] } else { ["no reading is cited"] },
    if count(filter(l.observed, o => !same_pair(o: o, a: l.first, b: l.second))) == 0 && count(filter(l.beeps, o => !same_beep_pair(o: o, a: l.first, b: l.second))) == 0 { [] } else { ["a cited reading is between other points"] }),
    map(filter(l.observed, o => !reading_admitted(states: states, o: o)), o => join(["a cited reading is ", why_not_in_state(states: states, asset: o.asset, order: o.order, conditions: o.conditions)], ""))),
    map(filter(l.beeps, o => !beep_admitted(states: states, o: o)), o => join(["a cited beep is ", why_not_in_state(states: states, asset: o.asset, order: o.order, conditions: o.conditions)], ""))),
    [])
}

fn link_admissible(states: List<BoardState>, l: MeasuredLink) -> Bool {
  count(link_refusals(states: states, l: l)) == 0
}

// The role a physical lead is a candidate for, and the identification it rests on. A role is never a
// terminal's name: the lead keeps its physical name until a reading maps it.
type RoleCandidate {
  terminal: ElectricalTerminalRef
  role: NonEmptyStr
  basis: NonEmptyStr
}

// Energized readings at one point in the sheet's states, each with the source setting it was read at.
// A voltage note places nothing; it is drawn beside the point it was read at.
type VoltageNote {
  at: ElectricalTerminalRef
  readings: List<NodeVoltageObservation>
}

fn voltage_note_refusals(states: List<BoardState>, v: VoltageNote) -> List<String> {
  concat(concat(
    if count(v.readings) > 0 { [] } else { ["no reading is cited"] },
    if count(filter(v.readings, r => !terminal_ref_equal(a: r.at, b: v.at))) == 0 { [] } else { ["a cited voltage was read at another point"] }),
    map(filter(v.readings, r => !voltage_admitted(states: states, v: r)), r => join(["a cited voltage is ", why_not_in_state(states: states, asset: r.asset, order: r.order, conditions: r.conditions)], "")))
}

fn voltage_note_consistent(states: List<BoardState>, v: VoltageNote) -> Bool {
  count(voltage_note_refusals(states: states, v: v)) == 0
}

// ── PROPOSITIONS ───────────────────────────────────────────────────────────────────────────────────

// A reconstructed wiring proposition of the design (extdeps.nvidia.p4261.netlist) shown with the standing
// this board's own records give it (product.p4261.evidence NetPropositionAssessment). Listing a
// proposition asks a question; the sheet draws its assessed answer -- supported reachability,
// counterevidence, conflict, unresolved with its gap, or not attributable -- on the part it is about,
// never its presence in the roster as a wire.
//
// THE PART IS A SPECIMEN IDENTITY, NOT A NAME. A proposition names a design position; the part on this
// board at that position is whatever the board's own position-to-specimen attribution
// (product.p4261.carrier admit_correspondence) admits there. A bound view carries the layout it was bound
// through, so the export re-derives that attribution and checks the assessment, the layout and the
// sheet's states are of one asset: another specimen's same-named component, or another board's
// assessment, is refused rather than given this board's standing. The drawing outlines the part by
// component identity. A proposition that cannot be bound stays on the sheet as an unavailable entry with
// its reason; a key with no assessment at all refuses the export.
type PropositionView
  = PropositionBound { layout: CarrierLayoutObservation, assessment: NetPropositionAssessment, part: ComponentInstanceIdentity }
  | PropositionUnavailable { key: NonEmptyStr, asset: PhysicalAssetIdentity, why: PropositionUnavailability }

type PropositionUnavailability
  = NoAssessmentOfKey
  | NoSpecimenAtPosition { designator: NonEmptyStr, standing: NetRevisionOutcome }
  | SeveralSpecimensAtPosition { designator: NonEmptyStr, parts: List<ComponentInstanceIdentity> }

fn proposition_key(v: PropositionView) -> NonEmptyStr {
  match v {
    PropositionBound { layout: _, assessment, part: _ } => assessment.proposition.key
    PropositionUnavailable { key, asset: _, why: _ } => key
  }
}

// The position a proposition is about: the target a connector row reaches, or the part asked to span the input.
fn proposition_subject(r: NetRelation) -> P4261Position {
  match r {
    RowReachesPosition { connector: _, row: _, target } => target
    SpansInput { component, input: _ } => component
  }
}

fn distinct_parts(cs: List<ComponentInstanceIdentity>) -> List<ComponentInstanceIdentity> {
  fold(cs, init: no_parts(), f: (acc, c) => if any(acc, x => component_identity_eq(a: x, b: c)) { acc } else { concat(acc, [c]) })
}

// The specimen parts the layout's own attribution admits at a position.
fn admitted_parts(layout: CarrierLayoutObservation, p: P4261Position) -> List<ComponentInstanceIdentity> {
  distinct_parts(cs: map(bindings_at(admitted: admit_correspondence(layout: layout).admitted, p: p), b => b.specimen))
}

fn part_text(c: ComponentInstanceIdentity) -> String {
  join([c.design as String, " ", component_local_label(c: c) as String], "")
}

// The one way a sheet lists a proposition: the board's assessment of the key, bound to the one specimen
// part the board admits at the position the proposition is about.
fn proposition_on(layout: CarrierLayoutObservation, key: NonEmptyStr) -> PropositionView {
  match net_assessment(layout: layout, key: key) {
    Absent => PropositionUnavailable { key: key, asset: layout.asset, why: NoAssessmentOfKey }
    Present { value: a } => {
      let p = proposition_subject(r: a.proposition.relation)
      let parts = admitted_parts(layout: layout, p: p)
      match parts.first() {
        Absent => PropositionUnavailable { key: key, asset: layout.asset, why: NoSpecimenAtPosition { designator: designator_text(designator: p.designator), standing: a.revision } }
        Present { value: c } => if count(parts) > 1 {
          PropositionUnavailable { key: key, asset: layout.asset, why: SeveralSpecimensAtPosition { designator: designator_text(designator: p.designator), parts: parts } }
        } else { PropositionBound { layout: layout, assessment: a, part: c } }
      }
    }
  }
}

fn unavailability_text(u: PropositionUnavailability) -> String {
  match u {
    NoAssessmentOfKey => "no proposition of this key is in the reconstructed roster, so it has no assessment"
    NoSpecimenAtPosition { designator, standing } => join(["no specimen part is admitted at ", designator as String, ", so it is drawn on no part; the assessment reads ", revision_outcome_text(o: standing)], "")
    SeveralSpecimensAtPosition { designator, parts } => join([to_string(count(parts)), " specimen parts are admitted at ", designator as String, " (", join(map(parts, c => part_text(c: c)), ", "), "), so it is drawn on none"], "")
  }
}

// Why a listed proposition may not be exported as drawn; empty when it may.
fn proposition_refusals(s: PartialSheet, v: PropositionView) -> List<String> {
  match v {
    PropositionUnavailable { key: _, asset, why } => concat(
      if any(s.states, st => physical_asset_identity_eq(a: st.board.asset, b: asset)) { [] } else { [join(["it is listed as unavailable on ", asset as String, ", which no state of the sheet is of"], "")] },
      match why {
        NoAssessmentOfKey => [unavailability_text(u: why)]
        NoSpecimenAtPosition { designator: _, standing: _ } => []
        SeveralSpecimensAtPosition { designator: _, parts: _ } => []
      })
    PropositionBound { layout, assessment, part } => {
      let p = proposition_subject(r: assessment.proposition.relation)
      concat(concat(concat(concat(
        if physical_asset_identity_eq(a: assessment.asset, b: layout.asset) { [] } else { [join(["the assessment is of ", assessment.asset as String, ", not of ", layout.asset as String, " whose layout binds it"], "")] },
        if any(s.states, st => physical_asset_identity_eq(a: st.board.asset, b: layout.asset)) { [] } else { [join(["it is bound through the layout of ", layout.asset as String, ", which no state of the sheet is of"], "")] }),
        if p4261_revision_eq(a: p.revision, b: layout.revision) { [] } else { ["the proposition is of another revision than the layout that binds it"] }),
        if any(admitted_parts(layout: layout, p: p), c => component_identity_eq(a: c, b: part)) { [] } else { [join(["the part ", part_text(c: part), " is not the specimen the layout of ", layout.asset as String, " admits at ", designator_text(designator: p.designator) as String], "")] }),
        if any(s.layout.symbols, y => component_identity_eq(a: y.part, b: part)) { [] } else { [join(["the part it is bound to, ", part_text(c: part), ", is not drawn"], "")] })
    }
  }
}

fn relation_text(r: NetRelation) -> String {
  match r {
    RowReachesPosition { connector, row: _, target } => join(["every contact of a ", designator_text(designator: connector.designator) as String, " row reaches one terminal of ", designator_text(designator: target.designator) as String], "")
    SpansInput { component, input } => join([designator_text(designator: component.designator) as String, " has one terminal in each of ", designator_text(designator: input.designator) as String, "'s two row classes"], "")
  }
}

fn gap_text(g: NetGap) -> String {
  match g {
    OccupantNotPresentInState => "no part present at the position in that state"
    ConnectorNotMappedWhole => "the connector is not mapped whole"
    RowContactNotReached => "a row contact is not reached"
    InputClassesNotEstablished => "the input's two row classes are not established"
    PartNotPlaced { gap } => match gap {
      InputPolarityNotEstablished => "the input's polarity is not established"
      NotTwoTerminals => "the part is not read as two terminals"
      TerminalsNotPlaced => "the part's terminals are not placed in the row classes"
    }
  }
}

fn attribution_text(g: NetAttributionGap) -> String {
  match g {
    NetPositionOfAnotherRevision => "the proposition is of another revision"
    NetRevisionNotEstablishedOnBoard => "the board's revision is not established"
    NetPositionNotAdmitted { designator } => join(["the position ", designator as String, " is not admitted on this board"], "")
    InputNotTheProposedConnector => "the board's input is not the proposed connector"
    NoMeasuredBoard => "the board has no measured record"
  }
}

fn state_outcome_text(o: NetStateOutcome) -> String {
  match o {
    NetSupported { terminals, readings } => join(["supported: reachability through ", to_string(count(terminals)), " terminal(s) on ", to_string(count(readings)), " beep(s)"], "")
    NetCounterevidence { terminals, readings } => join(["counterevidence: ", to_string(count(terminals)), " terminal(s) in one class on ", to_string(count(readings)), " beep(s)"], "")
    NetEvidenceConflict { readings, occupants } => join(["conflict: ", to_string(count(readings)), " beep(s), ", to_string(count(occupants)), " occupant(s)"], "")
    NetUnresolved { gap } => join(["unresolved: ", gap_text(g: gap)], "")
  }
}

fn revision_outcome_text(o: NetRevisionOutcome) -> String {
  match o {
    NetRevisionSupported => "SUPPORTED (reachability, as received)"
    NetRevisionCounterevidence => "COUNTEREVIDENCE (as received)"
    NetRevisionConflict => "CONFLICT (as received)"
    NetRevisionUnresolved => "UNRESOLVED (as received)"
    NetRevisionNotAttributable { gap } => join(["NOT ATTRIBUTABLE: ", attribution_text(g: gap)], "")
  }
}

fn revision_outcome_colour(o: NetRevisionOutcome) -> String {
  match o {
    NetRevisionSupported => "#2e7d32"
    NetRevisionCounterevidence => "#c62828"
    NetRevisionConflict => "#c62828"
    NetRevisionUnresolved => "#757575"
    NetRevisionNotAttributable { gap: _ } => "#757575"
  }
}

// The received state's reason when the proposition is unresolved as received.
fn received_gap_text(a: NetPropositionAssessment) -> String {
  join(map(filter(a.states, a => received(s: a.state)), a => match a.outcome {
    NetUnresolved { gap } => gap_text(g: gap)
    NetSupported { terminals: _, readings: _ } => ""
    NetCounterevidence { terminals: _, readings: _ } => ""
    NetEvidenceConflict { readings: _, occupants: _ } => ""
  }), "")
}

// ── NODES ──────────────────────────────────────────────────────────────────────────────────────────

// A datasheet-only relation: the member the datasheet's circuit puts on the node, and the elements it puts
// between them (a capacitor, a resistor), each drawn as a hypothetical element rather than erased.
type DatasheetMember {
  terminal: ElectricalTerminalRef
  elements: List<NonEmptyStr>
  basis: NonEmptyStr
}

// An end that read in a node's voltage class with current forced through the rail. A candidate is never a
// member: its readings are ForcedCurrentReading, which no join accepts.
type CandidateEnd {
  terminal: ElectricalTerminalRef
  readings: List<ForcedCurrentReading>
}

type UnknownContinuation {
  key: NonEmptyStr
  from: ElectricalTerminalRef
  unknown: NonEmptyStr
}

type SheetNode {
  key: NonEmptyStr
  anchor: ElectricalTerminalRef
  connections: List<ProposedConnection>
  by_datasheet: List<DatasheetMember>
  candidates: List<CandidateEnd>
  continuations: List<UnknownContinuation>
}

// A record the sheet relies on whose attribution is disputed; it is cited where it stands, not moved.
type AttributionDispute {
  key: NonEmptyStr
  held: List<PhaseNodeVoltage>
  evidence: EvidenceRef
  question: NonEmptyStr
}

type CandidateStanding
  = CandidateOpen
  | CandidateWeakened { why: NonEmptyStr }
  | CandidateExcludedAsPresentPath { why: NonEmptyStr }

// Where a suspected cause could be. A hypothesis's candidates may be wider than the sheet on purpose: a
// part not on the sheet, whatever a node feeds, and the copper itself are candidates in their own right.
type FaultCandidate
  = PartOnSheet { part: ComponentInstanceIdentity, standing: CandidateStanding }
  | NodeSideAsPath { node: NonEmptyStr, standing: CandidateStanding }
  | PartOffSheet { scope: NonEmptyStr }
  | LoadOfNode { node: NonEmptyStr }
  | CopperOrVia { evidence: List<EvidenceRef> }
  | ResidueOrBridge

// A hypothesis the sheet bears on, by key, with the candidates it is weighed over.
type SheetHypothesis {
  key: NonEmptyStr
  hypothesis: ClassifiedHypothesis
  candidates: List<FaultCandidate>
}

// What one read would settle: the target it bears on (a node, a connection, a measurement, a continuation
// or a hypothesis), the precise observable, and the outcomes it can have. A beep or a baseline reading is
// reachability at the meter's threshold, so outcomes are written as what the display shows, not as copper.
type Settlement {
  target: NonEmptyStr
  observable: NonEmptyStr
  outcomes: List<NonEmptyStr>
}

// A read the next session can make, on the physical asset named: the board a sheet is drawn from, or a
// comparison specimen, whose readings bind to that asset and to no other board's records.
type BenchAsk {
  key: NonEmptyStr
  asset: PhysicalAssetIdentity
  on: NonEmptyStr
  procedure: NonEmptyStr
  settles: List<Settlement>
}

type SheetAlias {
  label: NonEmptyStr
  part: ComponentInstanceIdentity
  frame: EvidenceRef
  pointed_at: NonEmptyStr
}

// ── WHERE THINGS SIT ON THE DRAWING ────────────────────────────────────────────────────────────────
// Placement is authored, but what is drawn between the points is derived from the rows: a connection,
// measurement, candidate or continuation reaches the drawing only through its row, and a row whose
// terminal has no place refuses the drawing instead of being left off it (layout_complete).
type PartSymbol {
  part: ComponentInstanceIdentity
  label: NonEmptyStr
  x: Nat
  y: Nat
  w: Nat
  h: Nat
}

type PinPlace {
  terminal: ElectricalTerminalRef
  label: String
  x: Nat
  y: Nat
}

type StubSide
  = StubTextLeft
  | StubTextRight
  | StubTextBelow

type StubPlace {
  key: NonEmptyStr
  x: Nat
  y: Nat
  side: StubSide
}

type SheetLayout {
  width: Nat
  height: Nat
  symbols: List<PartSymbol>
  pins: List<PinPlace>
  stubs: List<StubPlace>
}

type PartialSheet {
  source: NonEmptyStr
  title: NonEmptyStr
  states: List<BoardState>
  layout: SheetLayout
  aliases: List<SheetAlias>
  nodes: List<SheetNode>
  links: List<MeasuredLink>
  propositions: List<PropositionView>
  roles: List<RoleCandidate>
  voltages: List<VoltageNote>
  disputes: List<AttributionDispute>
  removals: List<AssetAlteration>
  hypotheses: List<SheetHypothesis>
  asks: List<BenchAsk>
}

// ── WHAT A SHEET MUST HOLD ─────────────────────────────────────────────────────────────────────────

fn member_of(ts: List<ElectricalTerminalRef>, t: ElectricalTerminalRef) -> Bool {
  count(filter(ts, m => terminal_ref_equal(a: m, b: t))) > 0
}

fn joined_edges(states: List<BoardState>, n: SheetNode) -> List<ProposedConnection> {
  filter(n.connections, c => connection_joins(states: states, c: c))
}

// One pass over the copper edges: every edge with exactly one end already reached adds its other end.
fn grow(es: List<ProposedConnection>, ts: List<ElectricalTerminalRef>) -> List<ElectricalTerminalRef> {
  fold(es, init: ts, f: (acc, c) =>
    if member_of(ts: acc, t: c.first.sheet) && !member_of(ts: acc, t: c.second.sheet) { concat(acc, [c.second.sheet]) } else {
      if member_of(ts: acc, t: c.second.sheet) && !member_of(ts: acc, t: c.first.sheet) { concat(acc, [c.first.sheet]) } else { acc }
    })
}

// A node's members: the terminals reachable from its anchor over copper edges only. As many passes as
// there are edges reach every terminal a chain of them can, so a joined pair with no copper path back to
// the anchor -- isolated, or behind a proposed bridge -- is never a member.
fn node_members(states: List<BoardState>, n: SheetNode) -> List<ElectricalTerminalRef> {
  let es = joined_edges(states: states, n: n)
  fold(es, init: [n.anchor], f: (acc, _) => grow(es: es, ts: acc))
}

// Every terminal a node reaches by any route the sheet draws, joined or proposed.
fn node_reach(n: SheetNode) -> List<ElectricalTerminalRef> {
  concat([n.anchor], flat_map(n.connections, c => [c.first.sheet, c.second.sheet]))
}

fn share_a_terminal(a: List<ElectricalTerminalRef>, b: List<ElectricalTerminalRef>) -> Bool {
  count(filter(a, t => member_of(ts: b, t: t))) > 0
}

// No two nodes reach a common terminal, joined or proposed: if they did, they would be one node, or one of
// the proposals is wrong.
fn nodes_disjoint(ns: List<SheetNode>) -> Bool {
  count(filter(ns, a => count(filter(ns, b => a.key != b.key && share_a_terminal(a: node_reach(n: a), b: node_reach(n: b)))) > 0)) == 0
}

fn connections_of(ns: List<SheetNode>) -> List<ProposedConnection> {
  flat_map(ns, n => n.connections)
}

fn all_connections_admissible(states: List<BoardState>, ns: List<SheetNode>) -> Bool {
  count(filter(connections_of(ns: ns), c => !connection_admissible(states: states, c: c))) == 0
}

fn all_links_admissible(s: PartialSheet) -> Bool {
  count(filter(s.links, l => !link_admissible(states: s.states, l: l))) == 0
}

fn all_voltage_notes_consistent(s: PartialSheet) -> Bool {
  count(filter(s.voltages, v => !voltage_note_consistent(states: s.states, v: v))) == 0
}

fn continuation_keys(ns: List<SheetNode>) -> List<NonEmptyStr> {
  flat_map(ns, n => map(n.continuations, c => c.key))
}

fn settle_targets(s: PartialSheet) -> List<NonEmptyStr> {
  concat(concat(concat(concat(
    map(s.nodes, n => n.key),
    continuation_keys(ns: s.nodes)),
    map(connections_of(ns: s.nodes), c => c.key)),
    concat(map(s.links, l => l.key), map(s.propositions, v => proposition_key(v: v)))),
    map(s.hypotheses, h => h.key))
}

fn key_in(ks: List<NonEmptyStr>, k: NonEmptyStr) -> Bool {
  count(filter(ks, x => x == k)) > 0
}

fn ask_refusals(s: PartialSheet) -> List<String> {
  concat(
    map(filter(s.asks, a => count(a.settles) == 0), a => join(["read ", a.key as String, " settles nothing"], "")),
    flat_map(s.asks, a => concat(
      map(filter(a.settles, t => !key_in(ks: settle_targets(s: s), k: t.target)), t => join(["read ", a.key as String, " settles ", t.target as String, ", which the sheet does not carry"], "")),
      map(filter(a.settles, t => count(t.outcomes) < 2), t => join(["read ", a.key as String, " on ", t.target as String, " has fewer than two outcomes"], "")))))
}

// Every ask settles something, each settlement names a target the sheet carries, says what is observed,
// and lists at least two outcomes -- a read with one possible outcome decides nothing.
fn asks_settle_named_targets(s: PartialSheet) -> Bool {
  count(ask_refusals(s: s)) == 0
}

fn is_off_sheet(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => true
    LoadOfNode { node: _ } => false
    CopperOrVia { evidence: _ } => false
    ResidueOrBridge => false
  }
}

fn is_load(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => false
    LoadOfNode { node: _ } => true
    CopperOrVia { evidence: _ } => false
    ResidueOrBridge => false
  }
}

fn is_copper(c: FaultCandidate) -> Bool {
  match c {
    PartOnSheet { part: _, standing: _ } => false
    NodeSideAsPath { node: _, standing: _ } => false
    PartOffSheet { scope: _ } => false
    LoadOfNode { node: _ } => false
    CopperOrVia { evidence: _ } => true
    ResidueOrBridge => false
  }
}

// A short's candidate set reaches beyond the photograph: a part off the sheet, whatever the node powers,
// and the copper itself.
fn fault_reaches_beyond_the_sheet(cs: List<FaultCandidate>) -> Bool {
  count(filter(cs, c => is_off_sheet(c: c))) > 0 && count(filter(cs, c => is_load(c: c))) > 0 && count(filter(cs, c => is_copper(c: c))) > 0
}

// Any hypothesis's candidate set holds at least one candidate the sheet does not draw.
fn candidates_reach_off_the_sheet(cs: List<FaultCandidate>) -> Bool {
  count(filter(cs, c => is_off_sheet(c: c))) > 0
}

fn no_parts() -> List<ComponentInstanceIdentity> {
  []
}

fn candidate_part(c: FaultCandidate) -> List<ComponentInstanceIdentity> {
  match c {
    PartOnSheet { part, standing: _ } => [part]
    NodeSideAsPath { node: _, standing: _ } => no_parts()
    PartOffSheet { scope: _ } => no_parts()
    LoadOfNode { node: _ } => no_parts()
    CopperOrVia { evidence: _ } => no_parts()
    ResidueOrBridge => no_parts()
  }
}

fn sheet_terminals(s: PartialSheet) -> List<ElectricalTerminalRef> {
  concat(concat(concat(concat(concat(
    flat_map(s.nodes, n => node_reach(n: n)),
    flat_map(s.nodes, n => flat_map(n.candidates, c => concat([c.terminal], flat_map(c.readings, r => [r.at, r.reference, r.injected_at]))))),
    flat_map(s.nodes, n => map(n.by_datasheet, d => d.terminal))),
    flat_map(s.nodes, n => map(n.continuations, c => c.from))),
    flat_map(s.links, l => [l.first, l.second])),
    map(s.roles, r => r.terminal))
}

fn sheet_parts(s: PartialSheet) -> List<ComponentInstanceIdentity> {
  concat(concat(map(sheet_terminals(s: s), t => t.component), map(s.removals, a => a.part)), flat_map(s.hypotheses, h => flat_map(h.candidates, c => candidate_part(c: c))))
}

fn unresolved_aliases(s: PartialSheet) -> List<SheetAlias> {
  let parts = sheet_parts(s: s)
  filter(s.aliases, a => count(filter(parts, p => component_identity_eq(a: p, b: a.part))) == 0)
}

// Every alias names a part the sheet places somewhere.
fn aliases_resolve(s: PartialSheet) -> Bool {
  count(unresolved_aliases(s: s)) == 0
}

// ── THE REPORT ─────────────────────────────────────────────────────────────────────────────────────

// Text drawn into the SVG is never escaped here, so a text holding '&' or '<' is refused rather than drawn
// broken.
fn drawable(t: String) -> Bool {
  !string_contains(s: t, pattern: "&") && !string_contains(s: t, pattern: "<")
}

fn tt(t: ElectricalTerminalRef) -> String {
  join([component_local_label(c: t.component) as String, " : ", t.terminal as String], "")
}

fn nat_text(n: Nat) -> String {
  to_string(n)
}

type DrawnLine {
  kind: NonEmptyStr
  text: String
}

fn candidate_text(c: CandidateEnd) -> String {
  join([tt(t: c.terminal), "  ", join(map(c.readings, r => join([nat_text(n: r.millivolts), " mV at ", nat_text(n: r.injected_milliamps), " mA on ", r.asset as String, order_text(o: r.order)], "")), "; ")], "")
}

// Each reading with its range and which point the red probe was on: a pair read both ways round, or on
// more than one range, is evidence by its direction and range, not only its value.
fn reading_line(o: ResistanceObservation) -> String {
  join(["      ", resistance_display_text(d: o.display), range_text(r: o.range), polarity_text(o: o)], "")
}

fn outside_lines(states: List<BoardState>, os: List<ResistanceObservation>) -> List<DrawnLine> {
  map(os, o => DrawnLine { kind: "outside", text: join([reading_line(o: o), "   [outside the sheet's state: ", why_not_in_state(states: states, asset: o.asset, order: o.order, conditions: o.conditions), "]"], "") })
}

fn node_lines(states: List<BoardState>, n: SheetNode) -> List<DrawnLine> {
  concat(concat(concat(concat(
    [DrawnLine { kind: "head", text: join(["NODE ", n.key as String, "    anchor ", tt(t: n.anchor)], "") }],
    flat_map(n.connections, c => concat(
      [DrawnLine { kind: if connection_joins(states: states, c: c) { "joined" } else { if connection_admissible(states: states, c: c) { "proposed" } else { "refused" } }, text: join([tt(t: c.first.sheet), "  to  ", tt(t: c.second.sheet), "   [", connection_grade_text(states: states, c: c), "]"], "") }],
      outside_lines(states: states, os: outside_between(states: states, a: c.first.counterpart, b: c.second.counterpart))))),
    map(n.by_datasheet, d => DrawnLine { kind: "datasheet", text: join([tt(t: d.terminal), "   [datasheet only, through ", join(map(d.elements, e => e as String), " and "), "] ", d.basis as String], "") })),
    map(n.candidates, c => DrawnLine { kind: "candidate", text: join([candidate_text(c: c), "   [forced-current class, not a member]"], "") })),
    map(n.continuations, c => DrawnLine { kind: "unknown", text: join(["? ", c.key as String, ": ", c.unknown as String], "") }))
}

type NumberedLink {
  number: Nat
  link: MeasuredLink
}

fn numbered_links(ls: List<MeasuredLink>) -> List<NumberedLink> {
  fold(ls, init: [], f: (acc, l) => concat(acc, [NumberedLink { number: count(acc) + 1, link: l }]))
}

fn measurement_tag(n: Nat) -> String {
  join(["M", nat_text(n: n)], "")
}

fn link_lines(s: PartialSheet) -> List<DrawnLine> {
  concat([DrawnLine { kind: "head", text: "MEASUREMENTS (bound the path, join nothing; M-numbers mark their points on the drawing)" }],
    flat_map(numbered_links(ls: s.links), m => concat(concat(
      [DrawnLine { kind: if link_admissible(states: s.states, l: m.link) { "link" } else { "refused" }, text: join([measurement_tag(n: m.number), "  ", m.link.key as String, ": ", tt(t: m.link.first), "  to  ", tt(t: m.link.second), if link_admissible(states: s.states, l: m.link) { "" } else { join(["   [REFUSED: ", join(link_refusals(states: s.states, l: m.link), "; "), "]"], "") }], "") }],
      concat(map(m.link.observed, o => DrawnLine { kind: "link", text: reading_line(o: o) }), map(m.link.beeps, o => DrawnLine { kind: "link", text: beep_line(o: o) }))),
      concat(outside_lines(states: s.states, os: outside_between(states: s.states, a: m.link.first, b: m.link.second)),
        map(outside_beeps_between(states: s.states, a: m.link.first, b: m.link.second), o => DrawnLine { kind: "outside", text: join([beep_line(o: o), "   [outside the sheet's state: ", why_not_in_state(states: s.states, asset: o.asset, order: o.order, conditions: o.conditions), "]"], "") })))))
}

fn point_text(p: PointProvenance, which: String) -> String {
  match p {
    PointRecorded => ""
    PointInferred { basis } => join(["; ", which, " point inferred (", basis as String, ")"], "")
  }
}

fn beep_line(o: ContinuityObservation) -> String {
  join(["      ", match o.result { BuzzerAsserted => "beeped", BuzzerNotAsserted => "did not beep" }, point_text(p: o.record.first, which: "first"), point_text(p: o.record.second, which: "second")], "")
}

fn proposition_lines(s: PartialSheet) -> List<DrawnLine> {
  concat([DrawnLine { kind: "head", text: "WIRING PROPOSITIONS, WITH THE STANDING THIS BOARD'S RECORDS GIVE EACH (a listed proposition asks; it asserts nothing)" }],
    flat_map(s.propositions, v => match v {
      PropositionBound { layout: _, assessment, part } => concat(
        [DrawnLine { kind: "proposition", text: join([assessment.proposition.key as String, ": ", relation_text(r: assessment.proposition.relation), "   -- ", revision_outcome_text(o: assessment.revision)], "") },
         DrawnLine { kind: "link", text: join(["      of ", assessment.asset as String, ", drawn on ", part_text(c: part), " (the part its attribution admits at the position)"], "") }],
        map(assessment.states, a => DrawnLine { kind: "link", text: join(["      in ", if count(a.state.after) == 0 { "the received state" } else { join(["the state after ", keys_text(ks: a.state.after)], "") }, ", ", module_text(m: a.state.module), ": ", state_outcome_text(o: a.outcome)], "") }))
      PropositionUnavailable { key, asset, why } => [DrawnLine { kind: "proposition", text: join([key as String, ": UNAVAILABLE on ", asset as String, " -- ", unavailability_text(u: why)], "") }]
    }))
}

fn role_lines(s: PartialSheet) -> List<DrawnLine> {
  concat([DrawnLine { kind: "head", text: "CANDIDATE LEAD ROLES (not terminal names)" }],
    map(s.roles, r => DrawnLine { kind: "role", text: join([tt(t: r.terminal), "  may be the ", r.role as String, ": ", r.basis as String], "") }))
}

fn voltage_text(v: NodeVoltageObservation) -> String {
  join([value_text(v: v.value), " at ", nat_text(n: volt_count(v: v.source)), " V in"], "")
}

fn voltage_lines(s: PartialSheet) -> List<DrawnLine> {
  concat([DrawnLine { kind: "head", text: "ENERGIZED READINGS (place nothing)" }],
    flat_map(s.voltages, v => concat(
      [DrawnLine { kind: if voltage_note_consistent(states: s.states, v: v) { "voltage" } else { "refused" }, text: join([tt(t: v.at), "   ", join(map(v.readings, r => voltage_text(v: r)), "; "), "   against ", join(map(v.readings, r => tt(t: r.reference)), ", ")], "") }],
      map(outside_voltages_at(states: s.states, t: v.at), r => DrawnLine { kind: "outside", text: join(["      ", voltage_text(v: r), "   [outside the sheet's state: ", why_not_in_state(states: s.states, asset: r.asset, order: r.order, conditions: r.conditions), "]"], "") }))))
}

fn standing_text(s: CandidateStanding) -> String {
  match s {
    CandidateOpen => "not ruled out"
    CandidateWeakened { why } => join(["weakened, ", why as String], "")
    CandidateExcludedAsPresentPath { why } => join(["excluded as the present path, ", why as String], "")
  }
}

fn candidate_line(c: FaultCandidate) -> String {
  match c {
    PartOnSheet { part, standing } => join([component_local_label(c: part) as String, ": ", standing_text(s: standing)], "")
    NodeSideAsPath { node, standing } => join(["the ", node as String, " side: ", standing_text(s: standing)], "")
    PartOffSheet { scope } => join(["off the sheet: ", scope as String], "")
    LoadOfNode { node } => join(["whatever ", node as String, " powers"], "")
    CopperOrVia { evidence: _ } => "copper or via damage"
    ResidueOrBridge => "residue or a bridge not seen in the photographs"
  }
}

// The specimen's state and hypotheses, the disputes, then each read with the carrier it is asked of and
// its procedure -- where a hold on removals is stated -- before what it settles.
fn side_lines(s: PartialSheet) -> List<DrawnLine> {
  concat(concat(concat(concat(concat(
    [DrawnLine { kind: "head", text: "SPECIMEN STATE AND HYPOTHESES (not design)" }],
    map(s.removals, a => DrawnLine { kind: "state", text: join(["removed: ", a.key as String], "") })),
    flat_map(s.hypotheses, h => concat(
      [DrawnLine { kind: "state", text: join(["hypothesis ", h.key as String, ": ", h.hypothesis.hypothesis.claim as String], "") }],
      map(h.candidates, c => DrawnLine { kind: "state", text: join(["candidate: ", candidate_line(c: c)], "") })))),
    map(s.disputes, d => DrawnLine { kind: "dispute", text: join(["DISPUTED ", d.key as String, ": ", d.question as String], "") })),
    [DrawnLine { kind: "head", text: "READS, EACH NAMING WHAT IT SETTLES" }]),
    flat_map(s.asks, a => concat(
      [DrawnLine { kind: "ask", text: join([a.key as String, " -- on ", a.asset as String, " (", a.on as String, "): ", a.procedure as String], "") }],
      flat_map(a.settles, t => concat(
        [DrawnLine { kind: "ask", text: join(["      settles ", t.target as String, ": ", t.observable as String], "") }],
        map(t.outcomes, o => DrawnLine { kind: "outcome", text: join(["            if ", o as String], "") }))))))
}

fn alias_lines(s: PartialSheet) -> List<DrawnLine> {
  concat([DrawnLine { kind: "head", text: "PHOTO-NUMBER ALIASES" }], map(s.aliases, a => DrawnLine { kind: "alias", text: join([a.label as String, " = ", component_local_label(c: a.part) as String, "   (", a.pointed_at as String, ")"], "") }))
}

fn line_style(kind: NonEmptyStr) -> String {
  if kind == "head" { "font-weight:bold;fill:#111" } else {
    if kind == "joined" { "fill:#1b7f3b" } else {
      if kind == "proposed" { "fill:#b86e00" } else {
        if kind == "refused" { "fill:#c62828;font-weight:bold" } else {
          if kind == "datasheet" { "fill:#b86e00;font-style:italic" } else {
            if kind == "candidate" { "fill:#666;font-style:italic" } else {
              if kind == "unknown" { "fill:#444" } else {
                if kind == "state" { "fill:#8a1c1c" } else {
                  if kind == "dispute" { "fill:#c62828;font-weight:bold" } else {
                    if kind == "link" { "fill:#555" } else {
                      if kind == "outside" { "fill:#999;font-style:italic" } else {
                        if kind == "role" { "fill:#6b21a8" } else {
                          if kind == "voltage" { "fill:#0e7490" } else { if kind == "proposition" { "fill:#111;font-weight:bold" } else { "fill:#222" } }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

type Placed {
  y: Nat
  out: List<String>
}

// THE TABLE STAYS INSIDE THE CANVAS. The SVG viewport clips a text that runs past its width, so a long
// line would lose its tail with nothing to show it had one. Each line is broken at spaces into rows of
// at most text_budget characters -- 7 px a character at 12 px, above DejaVu Sans's average and with the
// margin the canvas keeps for a bold run -- each continuation row indented under its line. A single word longer than the budget stays one
// row, never cut. Rows keep their leading spaces when drawn (xml:space), so an indent shows.
fn text_budget(width: Nat) -> Nat {
  nat_div_rem_by_succ(a: nat_saturating_sub(a: width, b: 40), divisor_prev: 6).quotient
}

type WrapState {
  done: List<String>
  line: String
  lead: String
  has_word: Bool
  started: Bool
}

fn no_rows() -> List<String> {
  []
}

// A continuation row starts four spaces deeper than the line it continues.
fn wrapped_text(t: String, budget: Nat) -> List<String> {
  let st = fold(split(s: t, delimiter: " "), init: WrapState { done: no_rows(), line: "", lead: "", has_word: false, started: false }, f: (acc, w) =>
    if !acc.started { WrapState { done: acc.done, line: w, lead: "", has_word: !(w == ""), started: true } }
    else { if !(w == "") && acc.has_word && string_length(s: acc.line) + 1 + string_length(s: w) > budget {
      WrapState { done: concat(acc.done, [acc.line]), line: join([acc.lead, "    ", w], ""), lead: acc.lead, has_word: true, started: true }
    } else {
      WrapState { done: acc.done, line: join([acc.line, " ", w], ""), lead: if acc.has_word || (w == "") { acc.lead } else { join([acc.line, " "], "") }, has_word: acc.has_word || !(w == ""), started: true }
    } })
  concat(st.done, [st.line])
}

fn wrapped_lines(ls: List<DrawnLine>, budget: Nat) -> List<DrawnLine> {
  flat_map(ls, l => map(wrapped_text(t: l.text, budget: budget), t => DrawnLine { kind: l.kind, text: t }))
}

fn place_lines(x: Nat, y0: Nat, budget: Nat, ls: List<DrawnLine>) -> Placed {
  fold(wrapped_lines(ls: ls, budget: budget), init: Placed { y: y0, out: [] }, f: (acc, l) => Placed {
    y: acc.y + 17,
    out: concat(acc.out, [join(["<text x=\"", nat_text(n: x), "\" y=\"", nat_text(n: acc.y), "\" font-size=\"12\" xml:space=\"preserve\" style=\"", line_style(kind: l.kind), "\">", l.text, "</text>"], "")]),
  })
}

fn sheet_lines(s: PartialSheet) -> List<DrawnLine> {
  concat(concat(concat(
    flat_map(s.nodes, n => concat(node_lines(states: s.states, n: n), [DrawnLine { kind: "gap", text: " " }])),
    concat(if count(s.propositions) > 0 { concat(proposition_lines(s: s), [DrawnLine { kind: "gap", text: " " }]) } else { [] }, if count(s.links) > 0 { concat(link_lines(s: s), [DrawnLine { kind: "gap", text: " " }]) } else { [] })),
    if count(s.roles) > 0 { concat(role_lines(s: s), [DrawnLine { kind: "gap", text: " " }]) } else { [] }),
    if count(s.voltages) > 0 { voltage_lines(s: s) } else { [] })
}

fn distinct_terminals(ts: List<ElectricalTerminalRef>) -> List<ElectricalTerminalRef> {
  fold(ts, init: [], f: (acc, t) => if member_of(ts: acc, t: t) { acc } else { concat(acc, [t]) })
}

// What the bench reader needs before the drawing: the state each carrier is drawn in, the points the
// energized readings were taken against, and where the connections' evidence comes from.
fn header_lines(s: PartialSheet) -> List<String> {
  let cs = connections_of(ns: s.nodes)
  let refs = flat_map(s.voltages, v => map(v.readings, r => r.reference))
  let forced = flat_map(s.nodes, n => flat_map(n.candidates, c => c.readings))
  concat(concat(concat(
    map(s.states, b => join(["Evidence read in: ", state_text(s: b)], "")),
    if count(refs) == 0 { [] } else { [join(["Energized readings against: ", join(map(distinct_terminals(ts: refs), r => tt(t: r)), ", ")], "")] }),
    if count(forced) == 0 { [] } else { [join(["Forced-current millivolts: candidates only, read against ", join(map(distinct_terminals(ts: map(forced, r => r.reference)), r => tt(t: r)), ", "), if count(filter(forced, r => match r.record.second { PointInferred { basis: _ } => true, PointRecorded => false })) > 0 { " (the meter's reference inferred, not recorded, on some)" } else { "" }, "; each reading's specimen state is in the report"], "")] }),
    [join(["Connections: ", nat_text(n: count(filter(cs, c => same_carrier(c: c)))), " read on this carrier, ", nat_text(n: count(filter(cs, c => !same_carrier(c: c)))), " cross-specimen (correspondence shown per connection)"], "")])
}

// ── THE CIRCUIT VIEW ───────────────────────────────────────────────────────────────────────────────

// Every terminal the circuit view draws: node anchors, both ends of every connection and measurement,
// datasheet members, forced-current candidates, the starts of unknown continuations, candidate roles and
// the points energized readings were taken at.
fn drawn_terminals(s: PartialSheet) -> List<ElectricalTerminalRef> {
  concat(concat(concat(concat(concat(concat(concat(
    map(s.nodes, n => n.anchor),
    flat_map(connections_of(ns: s.nodes), c => [c.first.sheet, c.second.sheet])),
    flat_map(s.nodes, n => map(n.by_datasheet, d => d.terminal))),
    flat_map(s.nodes, n => map(n.candidates, c => c.terminal))),
    flat_map(s.nodes, n => map(n.continuations, c => c.from))),
    flat_map(s.links, l => [l.first, l.second])),
    map(s.roles, r => r.terminal)),
    map(s.voltages, v => v.at))
}

fn pins_at(l: SheetLayout, t: ElectricalTerminalRef) -> List<PinPlace> {
  filter(l.pins, p => terminal_ref_equal(a: p.terminal, b: t))
}

fn symbols_of(l: SheetLayout, c: ComponentInstanceIdentity) -> List<PartSymbol> {
  filter(l.symbols, y => component_identity_eq(a: y.part, b: c))
}

fn stubs_for(l: SheetLayout, k: NonEmptyStr) -> List<StubPlace> {
  filter(l.stubs, x => x.key == k)
}

fn unplaced_terminals(s: PartialSheet) -> List<ElectricalTerminalRef> {
  filter(drawn_terminals(s: s), t => !(count(pins_at(l: s.layout, t: t)) == 1))
}

fn layout_refusals(s: PartialSheet) -> List<String> {
  concat(concat(
    map(unplaced_terminals(s: s), t => join(["no single place for ", tt(t: t)], "")),
    map(filter(s.layout.pins, p => !(count(symbols_of(l: s.layout, c: p.terminal.component)) == 1)), p => join(["the pin ", tt(t: p.terminal), " sits on no single drawn part"], ""))),
    map(filter(continuation_keys(ns: s.nodes), k => !(count(stubs_for(l: s.layout, k: k)) == 1)), k => join(["no single stub for ", k as String], "")))
}

// The drawing is complete when every drawn terminal has exactly one place, every placed pin sits on
// exactly one drawn part, and every unknown continuation has exactly one stub.
fn layout_complete(s: PartialSheet) -> Bool {
  count(layout_refusals(s: s)) == 0
}

fn half(n: Nat) -> Nat {
  nat_div_rem_by_succ(a: n, divisor_prev: 1).quotient
}

fn lifted(n: Nat, by: Nat) -> Nat {
  nat_saturating_sub(a: n, b: by)
}

// The point i+1 of k+1 equal steps from a to b, in naturals: (a(k-i) + b(i+1)) / (k+1).
fn step_point(a: Nat, b: Nat, i: Nat, k: Nat) -> Nat {
  nat_div_rem_by_succ(a: a * nat_saturating_sub(a: k, b: i) + b * (i + 1), divisor_prev: k).quotient
}

fn removed_part(s: PartialSheet, p: ComponentInstanceIdentity) -> Bool {
  count(filter(s.removals, a => component_identity_eq(a: a.part, b: p))) > 0
}

fn text_at(x: Nat, y: Nat, anchor: String, size: Nat, style: String, t: String) -> String {
  join(["<text x=\"", nat_text(n: x), "\" y=\"", nat_text(n: y), "\" text-anchor=\"", anchor, "\" font-size=\"", nat_text(n: size), "\" ", style, ">", t, "</text>"], "")
}

fn segment(a: PinPlace, b: PinPlace, style: String) -> String {
  join(["<line x1=\"", nat_text(n: a.x), "\" y1=\"", nat_text(n: a.y), "\" x2=\"", nat_text(n: b.x), "\" y2=\"", nat_text(n: b.y), "\" ", style, "/>"], "")
}

fn between(l: SheetLayout, a: ElectricalTerminalRef, b: ElectricalTerminalRef, style: String, label: String, label_style: String) -> List<String> {
  flat_map(pins_at(l: l, t: a), pa => flat_map(pins_at(l: l, t: b), pb =>
    concat([segment(a: pa, b: pb, style: style)], if label == "" { [] } else { [text_at(x: half(n: pa.x + pb.x), y: lifted(n: half(n: pa.y + pb.y), by: 4), anchor: "middle", size: 10, style: label_style, t: label)] })))
}

data joined_style: String = "stroke=\"#1b7f3b\" stroke-width=\"2.2\""
data proposed_style: String = "stroke=\"#b86e00\" stroke-width=\"2\" stroke-dasharray=\"9 5\""
data cross_specimen_style: String = "stroke=\"#8d6e63\" stroke-width=\"2\" stroke-dasharray=\"6 3 1 3\""
data through_part_style: String = "stroke=\"#6b21a8\" stroke-width=\"1.4\" stroke-dasharray=\"2 3\""
data refused_style: String = "stroke=\"#c62828\" stroke-width=\"2\" stroke-dasharray=\"1 3\""
data datasheet_style: String = "stroke=\"#b86e00\" stroke-width=\"1.4\" stroke-dasharray=\"2 4\""
data candidate_style: String = "stroke=\"#8a8a8a\" stroke-width=\"1.1\" stroke-dasharray=\"1 4\""
data stub_style: String = "stroke=\"#444\" stroke-width=\"1.4\""

fn symbol_svg(s: PartialSheet, y: PartSymbol) -> String {
  let removed = removed_part(s: s, p: y.part)
  join([
    "<rect x=\"", nat_text(n: y.x), "\" y=\"", nat_text(n: y.y), "\" width=\"", nat_text(n: y.w), "\" height=\"", nat_text(n: y.h), "\" fill=\"#ffffff\" stroke-width=\"1.6\" ",
    if removed { "stroke=\"#c62828\" stroke-dasharray=\"6 4\"/>" } else { "stroke=\"#222\"/>" },
    text_at(x: y.x + half(n: y.w), y: y.y + half(n: y.h) + 4, anchor: "middle", size: 11, style: if removed { "fill=\"#c62828\"" } else { "fill=\"#111\"" }, t: if removed { join([y.label as String, " (removed)"], "") } else { y.label as String }),
  ], "")
}

fn pin_svg(p: PinPlace) -> String {
  join([
    "<circle cx=\"", nat_text(n: p.x), "\" cy=\"", nat_text(n: p.y), "\" r=\"3.5\" fill=\"#111\"/>",
    if p.label == "" { "" } else { text_at(x: p.x + 6, y: p.y + 15, anchor: "start", size: 10, style: "fill=\"#333\"", t: p.label) },
  ], "")
}

// A connection drawn by what it is: a copper edge, a proposal on this carrier, a cross-specimen proposal,
// a path through a part, or a refused claim -- never a refused or cross-specimen claim in the style of an
// ordinary proposal.
fn connection_style(states: List<BoardState>, c: ProposedConnection) -> String {
  if connection_joins(states: states, c: c) { joined_style } else {
    if !connection_admissible(states: states, c: c) { refused_style } else {
      match c.path {
        ThroughPart { part: _, why: _ } => through_part_style
        CopperClaimed { basis: _, evidence: _ } => if same_carrier(c: c) { proposed_style } else { cross_specimen_style }
        SeriesUnresolved { why: _ } => if same_carrier(c: c) { proposed_style } else { cross_specimen_style }
      }
    }
  }
}

fn connection_label(states: List<BoardState>, c: ProposedConnection) -> String {
  if !connection_admissible(states: states, c: c) { "REFUSED" } else {
    match c.path {
      ThroughPart { part, why: _ } => join(["through ", component_local_label(c: part) as String], "")
      CopperClaimed { basis: _, evidence: _ } => ""
      SeriesUnresolved { why: _ } => ""
    }
  }
}

fn connection_svg(s: PartialSheet, c: ProposedConnection) -> List<String> {
  between(l: s.layout, a: c.first.sheet, b: c.second.sheet, style: connection_style(states: s.states, c: c), label: connection_label(states: s.states, c: c), label_style: "fill=\"#c62828\"")
}

fn first_of(ns: List<Nat>) -> List<Nat> {
  fold(ns, init: [], f: (acc, n) => if count(acc) == 0 { [n] } else { acc })
}

fn last_of(ns: List<Nat>) -> List<Nat> {
  fold(ns, init: [], f: (acc, n) => [n])
}

// The measurement numbers that touch a point: listed when few, a span when many.
fn tags_at(ms: List<NumberedLink>, t: ElectricalTerminalRef) -> List<Nat> {
  map(filter(ms, m => terminal_ref_equal(a: m.link.first, b: t) || terminal_ref_equal(a: m.link.second, b: t)), m => m.number)
}

fn tags_text(ns: List<Nat>) -> String {
  if count(ns) > 3 {
    join([join(map(first_of(ns: ns), n => measurement_tag(n: n)), ""), "...", join(map(last_of(ns: ns), n => measurement_tag(n: n)), ""), " (", nat_text(n: count(ns)), ")"], "")
  } else { join(map(ns, n => measurement_tag(n: n)), " ") }
}

fn measurement_tags_svg(s: PartialSheet) -> List<String> {
  let ms = numbered_links(ls: s.links)
  flat_map(s.layout.pins, p => if count(tags_at(ms: ms, t: p.terminal)) == 0 { [] } else {
    [text_at(x: lifted(n: p.x, by: 6), y: lifted(n: p.y, by: 6), anchor: "end", size: 9, style: "fill=\"#777\"", t: tags_text(ns: tags_at(ms: ms, t: p.terminal)))]
  })
}

type NumberedElement {
  index: Nat
  element: NonEmptyStr
}

fn numbered_elements(es: List<NonEmptyStr>) -> List<NumberedElement> {
  fold(es, init: [], f: (acc, e) => concat(acc, [NumberedElement { index: count(acc), element: e }]))
}

// A datasheet-only relation is drawn with the elements the datasheet puts in it, each as a dashed,
// question-marked box along the dotted line: hypothetical, and never erased into a bare connection.
fn datasheet_svg(l: SheetLayout, n: SheetNode, d: DatasheetMember) -> List<String> {
  let k = count(d.elements)
  concat(between(l: l, a: n.anchor, b: d.terminal, style: datasheet_style, label: "", label_style: ""),
    flat_map(pins_at(l: l, t: n.anchor), pa => flat_map(pins_at(l: l, t: d.terminal), pb => flat_map(numbered_elements(es: d.elements), e =>
      [join(["<rect x=\"", nat_text(n: lifted(n: step_point(a: pa.x, b: pb.x, i: e.index, k: k), by: 26)), "\" y=\"", nat_text(n: lifted(n: step_point(a: pa.y, b: pb.y, i: e.index, k: k), by: 9)), "\" width=\"52\" height=\"18\" fill=\"#fff8ec\" stroke=\"#b86e00\" stroke-dasharray=\"3 2\"/>"], ""),
       text_at(x: step_point(a: pa.x, b: pb.x, i: e.index, k: k), y: step_point(a: pa.y, b: pb.y, i: e.index, k: k) + 4, anchor: "middle", size: 9, style: "fill=\"#b86e00\" font-style=\"italic\"", t: join([e.element as String, "?"], ""))]))))
}

// A proposition is drawn on the part it names: an outline in its standing's colour and its standing above
// the part, the same for every proposition, whatever the roster lists.
fn proposition_svg(s: PartialSheet, v: PropositionView) -> List<String> {
  match v {
    PropositionUnavailable { key: _, asset: _, why: _ } => []
    PropositionBound { layout: _, assessment, part } => {
      let colour = revision_outcome_colour(o: assessment.revision)
      let gap = received_gap_text(a: assessment)
      flat_map(filter(s.layout.symbols, y => component_identity_eq(a: y.part, b: part)), y =>
        [join(["<rect x=\"", nat_text(n: lifted(n: y.x, by: 5)), "\" y=\"", nat_text(n: lifted(n: y.y, by: 5)), "\" width=\"", nat_text(n: y.w + 10), "\" height=\"", nat_text(n: y.h + 10), "\" fill=\"none\" stroke=\"", colour, "\" stroke-width=\"2.4\" stroke-dasharray=\"5 2\"/>"], ""),
         text_at(x: y.x, y: lifted(n: y.y, by: 9), anchor: "start", size: 10, style: join(["fill=\"", colour, "\" font-weight=\"bold\""], ""), t: join([revision_outcome_text(o: assessment.revision), if gap == "" { "" } else { join([": ", gap], "") }], ""))])
    }
  }
}

fn millivolts_text(c: CandidateEnd) -> String {
  join(map(c.readings, r => join([nat_text(n: r.millivolts), " mV"], "")), ", ")
}

fn candidate_svg(l: SheetLayout, n: SheetNode, c: CandidateEnd) -> List<String> {
  concat(between(l: l, a: n.anchor, b: c.terminal, style: candidate_style, label: "", label_style: ""),
    map(pins_at(l: l, t: c.terminal), p => text_at(x: lifted(n: p.x, by: 5), y: lifted(n: p.y, by: 6), anchor: "end", size: 11, style: "fill=\"#666\" font-style=\"italic\"", t: millivolts_text(c: c))))
}

fn role_svg(l: SheetLayout, r: RoleCandidate) -> List<String> {
  map(pins_at(l: l, t: r.terminal), p => text_at(x: p.x + 6, y: p.y + 27, anchor: "start", size: 10, style: "fill=\"#6b21a8\" font-style=\"italic\"", t: join([r.role as String, "?"], "")))
}

fn voltage_svg(l: SheetLayout, v: VoltageNote) -> List<String> {
  map(pins_at(l: l, t: v.at), p => text_at(x: p.x + 6, y: p.y + 39, anchor: "start", size: 10, style: "fill=\"#0e7490\"", t: join(map(v.readings, r => voltage_text(v: r)), "; ")))
}

fn stub_text(x: StubPlace, k: NonEmptyStr) -> String {
  let t = join(["? ", k as String], "")
  match x.side {
    StubTextLeft => text_at(x: lifted(n: x.x, by: 4), y: x.y + 4, anchor: "end", size: 11, style: "fill=\"#444\"", t: t)
    StubTextRight => text_at(x: x.x + 4, y: x.y + 4, anchor: "start", size: 11, style: "fill=\"#444\"", t: t)
    StubTextBelow => text_at(x: x.x, y: x.y + 14, anchor: "middle", size: 11, style: "fill=\"#444\"", t: t)
  }
}

fn continuation_svg(l: SheetLayout, c: UnknownContinuation) -> List<String> {
  flat_map(pins_at(l: l, t: c.from), p => flat_map(stubs_for(l: l, k: c.key), x =>
    [segment(a: p, b: PinPlace { terminal: c.from, label: "", x: x.x, y: x.y }, style: stub_style), stub_text(x: x, k: c.key)]))
}

fn node_label_svg(l: SheetLayout, n: SheetNode) -> List<String> {
  map(pins_at(l: l, t: n.anchor), p => text_at(x: p.x + 6, y: lifted(n: p.y, by: 8), anchor: "start", size: 13, style: "fill=\"#1d4ed8\" font-weight=\"bold\"", t: n.key as String))
}

// The circuit view: parts as boxes with their terminals, every connection component-preserving and drawn
// by what it is, measurements as numbers at their points, datasheet-only relations with their
// hypothetical elements, and every unknown continuation as a stub ending in its key.
fn circuit_svg(s: PartialSheet) -> List<String> {
  let l = s.layout
  concat(concat(concat(concat(concat(concat(concat(concat(concat(
    map(l.symbols, y => symbol_svg(s: s, y: y)),
    flat_map(s.nodes, n => flat_map(n.candidates, c => candidate_svg(l: l, n: n, c: c)))),
    flat_map(s.nodes, n => flat_map(n.by_datasheet, d => datasheet_svg(l: l, n: n, d: d)))),
    flat_map(connections_of(ns: s.nodes), c => connection_svg(s: s, c: c))),
    flat_map(s.nodes, n => flat_map(n.continuations, c => continuation_svg(l: l, c: c)))),
    map(l.pins, p => pin_svg(p: p))),
    concat(measurement_tags_svg(s: s), flat_map(s.propositions, v => proposition_svg(s: s, v: v)))),
    flat_map(s.roles, r => role_svg(l: l, r: r))),
    flat_map(s.voltages, v => voltage_svg(l: l, v: v))),
    flat_map(s.nodes, n => node_label_svg(l: l, n: n)))
}

fn every_drawn_text(s: PartialSheet) -> List<String> {
  concat(concat(concat(concat(
    map(concat(concat(concat(sheet_lines(s: s), side_lines(s: s)), alias_lines(s: s)), [DrawnLine { kind: "head", text: s.title as String }]), l => l.text),
    header_lines(s: s)),
    map(s.layout.symbols, y => y.label as String)),
    map(s.layout.pins, p => p.label)),
    map(s.layout.stubs, x => x.key as String))
}

fn sheet_drawable(s: PartialSheet) -> Bool {
  layout_complete(s: s) && count(filter(every_drawn_text(s: s), t => !drawable(t: t))) == 0
}

// ── ONE VALIDATION RESULT, AT THE EXPORT BOUNDARY ──────────────────────────────────────────────────

// Every reason the sheet is not fit to export, named; empty when it is.
fn sheet_findings(s: PartialSheet) -> List<String> {
  concat(concat(concat(concat(concat(concat(concat(concat(
    if count(s.states) > 0 { [] } else { ["the sheet declares no board state, so no reading can be admitted"] },
    flat_map(connections_of(ns: s.nodes), c => map(connection_refusals(states: s.states, c: c), r => join(["connection ", c.key as String, ": ", r], "")))),
    flat_map(s.links, l => map(link_refusals(states: s.states, l: l), r => join(["measurement ", l.key as String, ": ", r], "")))),
    flat_map(s.voltages, v => map(voltage_note_refusals(states: s.states, v: v), r => join(["voltages at ", tt(t: v.at), ": ", r], "")))),
    concat(if nodes_disjoint(ns: s.nodes) { [] } else { ["two nodes reach a common terminal"] },
      flat_map(s.propositions, v => map(proposition_refusals(s: s, v: v), r => join(["proposition ", proposition_key(v: v) as String, ": ", r], ""))))),
    ask_refusals(s: s)),
    layout_refusals(s: s)),
    map(filter(every_drawn_text(s: s), t => !drawable(t: t)), t => "a text holds '&' or '<' and would draw broken SVG")),
    map(unresolved_aliases(s: s), a => join(["alias ", a.label as String, " names no part on the sheet"], "")))
}

fn sheet_valid(s: PartialSheet) -> Bool {
  count(sheet_findings(s: s)) == 0
}

// The sheet as SVG: a header with the declared states, the readings' reference and the evidence's
// standing; the circuit view; then the report it is drawn from. Colours: green joined; amber dashed a
// proposal read on this carrier; brown dash-dot a cross-specimen proposal; purple dotted a path through a
// part; red dotted a refused claim; amber dotted with boxes a datasheet-only relation; grey dotted a
// forced-current class (never a member); grey M-numbers a measurement's points; purple a candidate lead
// role; teal an energized reading; ? an unknown continuation; red dashed a removed part.
fn sheet_svg(s: PartialSheet) -> String {
  let headers = header_lines(s: s)
  let shift = 30 + 16 * count(headers)
  let top = s.layout.height + shift + 40
  let budget = text_budget(width: s.layout.width)
  let nodes = place_lines(x: 30, y0: top, budget: budget, ls: sheet_lines(s: s))
  let side = place_lines(x: 30, y0: nodes.y + 14, budget: budget, ls: side_lines(s: s))
  let below = place_lines(x: 30, y0: side.y + 20, budget: budget, ls: alias_lines(s: s))
  let height = below.y + 30
  join(concat(concat(concat(concat(concat(concat(
    [join(["<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"", nat_text(n: s.layout.width), "\" height=\"", nat_text(n: height), "\" font-family=\"DejaVu Sans, Arial, sans-serif\">"], ""),
     join(["<rect x=\"0\" y=\"0\" width=\"", nat_text(n: s.layout.width), "\" height=\"", nat_text(n: height), "\" fill=\"#ffffff\"/>"], ""),
     join(["<text x=\"30\" y=\"40\" font-size=\"22\" font-weight=\"bold\">", s.title as String, "</text>"], ""),
     join(["<text x=\"30\" y=\"62\" font-size=\"11\" fill=\"#555\">generated from ", s.source as String, ". Key: green joined; amber dashed proposed here; brown dash-dot cross-specimen; purple dotted through a part; red dotted refused; amber boxes datasheet-only; grey dotted forced-current; M# measurements (table); role?; teal energized; ? unknown; red dashed removed</text>"], "")],
    map(numbered_lines(ls: headers), h => text_at(x: 30, y: 80 + 16 * h.index, anchor: "start", size: 12, style: "fill=\"#0b3d91\" font-weight=\"bold\"", t: h.text))),
    [join(["<g transform=\"translate(0,", nat_text(n: shift), ")\">"], "")]),
    circuit_svg(s: s)),
    ["</g>", join(["<line x1=\"20\" y1=\"", nat_text(n: s.layout.height + shift + 10), "\" x2=\"", nat_text(n: lifted(n: s.layout.width, by: 20)), "\" y2=\"", nat_text(n: s.layout.height + shift + 10), "\" stroke=\"#ccc\"/>"], "")]),
    concat(nodes.out, side.out)), concat(below.out, ["</svg>"])), "\n")
}

type NumberedLine {
  index: Nat
  text: String
}

fn numbered_lines(ls: List<String>) -> List<NumberedLine> {
  fold(ls, init: [], f: (acc, t) => concat(acc, [NumberedLine { index: count(acc), text: t }]))
}

// What leaves the sheet: its drawing, or the reasons it was refused. The render entry writes only the
// former, so a sheet with a refused claim, a reading outside its states, an unplaced terminal or an
// unsettled read never reaches the bench as a drawing.
type SheetExport
  = SheetExported { svg: String }
  | SheetRefused { reasons: List<String> }

fn export_sheet(s: PartialSheet) -> SheetExport {
  let findings = sheet_findings(s: s)
  if count(findings) == 0 { SheetExported { svg: sheet_svg(s: s) } } else { SheetRefused { reasons: findings } }
}
