import extdeps.electronic_component.intel_10cx085f672_boundary_scan {
  cyclone_10_gx_10cx085_f672_boundary_scan, cyclone_10_gx_10cx085_f672_described_component,
}
import extdeps.standards.ieee_1149_1 {
  BoundaryScanDescription, CellReading, DeviceKeepsItsPins, NotThisStandards, PinDrive, PinLevel, PinObservation,
  ScanTakesThePins, TapInstruction, all_ones_instruction, bit_pattern_value, driven_ports, identification_register_bits, identification_word,
  instruction_is_private, instruction_named, pin_observations, port_balls, ports_that_moved, read_capture,
  reported_word_identifies, standard_instruction_effect,
}
import extdeps.tools.openocd {
  openocd_field_hex_digits, openocd_irscan_within, openocd_longest_instruction_bits, openocd_newtap, openocd_report_identified,
  openocd_report_register, openocd_stop_unless_identified, openocd_stop_unless_version,
}
