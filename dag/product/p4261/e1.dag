  e1_route_read(to: e1_route_toward_j1, display: DisplayValue { ohms: 2000, approximate: true }, certainty: StatedHedged { verbatim: "2k ohms" }),
]

// SHEET ZB (2026-10-20, unpowered, after the probe bridge). The operator re-read the zeros asked for.
// The shorted probes read '.005' and, later, '.03 or something at 2k'; no pair names its dial
// position, and the decimal places differ across them ('.005', '0.00', '0.0'), so no pair shares a
// recorded range with a shorted-probe display and none of these zeros joins
// (product.electrical.bench_session). Across the resistor beside Q301, 26 kohm: in circuit a resistor
// reads at or below its value, so it is at least about 26 kohm, and '180' read as 18 ohm is excluded.
// Q300's lead b reads 8 kohm to J20's black lead and 24 kohm to VDD's point, and the via reads 0.0 to
// Q301's lead b.
data e1_q300_lead_b: ElectricalTerminalRef = e1_terminal(c: e1_q300, name: "lead b: two-lead side, beside the silkscreen triangle")

data e1_zb_baseline_said: NonEmptyStr = "ZB0: .005 / ZB0: .03 or something at 2k"

data e1_resistor_marking_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session upload 40bc2a29, Q300, Q301 and the resistor between them; the resistor's marking enlarged in the reply, and the points V3 and ZV2 marked (not on Drive)")

fn e1_zb_read(a: ElectricalTerminalRef, b: ElectricalTerminalRef, display: ResistanceDisplay, said: NonEmptyStr) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: a, second: b,
    record: both_points_recorded,
    conditions: e1_bench, polarity: PolarityUnrecorded, range: RangeUnrecorded, display: display, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-20", verbatim: said }, OperatorStatement { stated_on: "2026-10-20", verbatim: e1_zb_baseline_said }, e1_q300_q301_photo],
  }
}

data e1_zb_resistances: List<ResistanceObservation> = [
  e1_zb_read(a: e1_q301_lone_lead, b: e1_terminal(c: e1_back_cluster, name: "P6"), display: DisplayZeroWithoutBaseline { reported: "0.00ohm" }, said: "ZB2: 0.00ohm"),
  e1_zb_read(a: e1_q301_lead_a, b: e1_ground_ref, display: DisplayZeroWithoutBaseline { reported: "0.00 ohm" }, said: "ZB3: 0.00 ohm"),
  e1_zb_read(a: e1_q301_lead_b, b: e1_q300_lone_lead, display: DisplayZeroWithoutBaseline { reported: "0.00ohm" }, said: "ZB4: 0.00ohm"),
  e1_zb_read(a: e1_q300_lead_a, b: e1_ground_ref, display: DisplayZeroWithoutBaseline { reported: "0.00ohm" }, said: "ZB5:  0.00ohm"),
  e1_zb_read(a: e1_q301_resistor_near, b: e1_q301_lead_b, display: DisplayZeroWithoutBaseline { reported: "0.00ohm" }, said: "ZB6:  0.00ohm"),
  e1_zb_read(a: e1_q301_resistor_near, b: e1_q301_resistor_far, display: DisplayValue { ohms: 26000, approximate: false }, said: "ZB7: 26kohm"),
  e1_zb_read(a: e1_q301_b_via, b: e1_q301_lead_b, display: DisplayZeroWithoutBaseline { reported: "0.0ohm" }, said: "R6: 0.0ohm"),
  e1_zb_read(a: e1_q300_lead_b, b: e1_ground_ref, display: DisplayValue { ohms: 8000, approximate: false }, said: "R4: 8k ohm, 24kohm"),
  e1_zb_read(a: e1_q300_lead_b, b: e1_beige_top, display: DisplayValue { ohms: 24000, approximate: false }, said: "R4: 8k ohm, 24kohm"),
]

// Q300'S LEAD B AGAINST U51 (2026-10-20, unpowered, after the switches were found). The first report,
// '20 ohm' to pins 8 and 6, was read on the 200k range and is 20 kohm, withdrawn by the operator as a
// range misread. Re-read on the 20k range with the red probe on Q300's lead b, U51's pins 1 to 8 read
// 2.5 to 6 kohm; pin 8, GND under SCLS402R, reads the same 2.5 kohm as J20's black lead on that range
// (R4b); and the pin 8 pair reads about 600 ohm on the 2k range, 1.7 and 2.5 kohm on 20k, 20 kohm on
// 200k, and 1.8 kohm with the probes swapped. A pair whose value moves with the range holds a junction
// (product.electrical.bench_session pair_range_standing), so none of these joins and no U51 pin is read
// as Q300's lead b's node: the readings to U51's pins are the gate node's own path to the return, plus
// each pin's protection. The pin on which the trace followed by eye arrives stays unread.
data e1_u51_first_said: NonEmptyStr = "Q300 -> U51 - it has 20ohm resistance to several legs on U51 - we'd have to number the legs - in this picture, its the bottom left leg of u51, and two above that one - it also has ~5k ohm resistance to other legs / In that picture it's 8 and 6"

data e1_u51_range_said: NonEmptyStr = "8 is reading like, 600 ohms or something - my complaint is that, it dfepends on what settings i use- 2k ohms it reads ~600, and 20k ohms it reads 1700 / i think 20 ohms, i was on 200k and didn't realize"

data e1_u51_pins_said: NonEmptyStr = "reading all of these on 20k ohms: 8: 2.5 / 7: 6 / 6: 2.5 / 5: 6 / 4: 6 / 3: 5 / 2: 5 / 1: 5 - This is with red on Q300, and black on the pins"

data e1_u51_swapped_said: NonEmptyStr = "ZB15: at 20k, red on pin 8, black on Q300: 1800 ohms / R4b: 2.5k ohms"

data e1_u51_pins_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session upload, U51 with its pins numbered 1 to 8 along the row nearer Q300's trace in the crop u51_pins (not on Drive)")

fn e1_u51_pin(n: NonEmptyStr) -> ElectricalTerminalRef {
  e1_terminal(c: e1_u51, name: n)
}

fn e1_ranged_read(b: ElectricalTerminalRef, ohms: Nat, full_scale: Nat, polarity: ProbePolarity, said: NonEmptyStr) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: e1_q300_lead_b, second: b,
    record: both_points_recorded,
    conditions: e1_bench, polarity: polarity, range: RangeFullScale { ohms: full_scale }, display: DisplayValue { ohms: ohms, approximate: true }, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-20", verbatim: said }, e1_u51_pins_photo, e1_lv165a_photo],
  }
}

data e1_u51_resistances: List<ResistanceObservation> = [
  e1_ranged_read(b: e1_u51_pin(n: "pin 8"), ohms: 20000, full_scale: 200000, polarity: PolarityUnrecorded, said: e1_u51_range_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 6"), ohms: 20000, full_scale: 200000, polarity: PolarityUnrecorded, said: e1_u51_first_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 8"), ohms: 600, full_scale: 2000, polarity: PolarityUnrecorded, said: e1_u51_range_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 8"), ohms: 1700, full_scale: 20000, polarity: PolarityUnrecorded, said: e1_u51_range_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 8"), ohms: 2500, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_pins_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 7"), ohms: 6000, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_pins_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 6"), ohms: 2500, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_pins_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 5"), ohms: 6000, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_pins_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 4"), ohms: 6000, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_pins_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 3"), ohms: 5000, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_pins_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 2"), ohms: 5000, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_pins_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 1"), ohms: 5000, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_pins_said),
  e1_ranged_read(b: e1_u51_pin(n: "pin 8"), ohms: 1800, full_scale: 20000, polarity: RedOnSecond, said: e1_u51_swapped_said),
  e1_ranged_read(b: e1_ground_ref, ohms: 2500, full_scale: 20000, polarity: RedOnFirst, said: e1_u51_swapped_said),
]

// U55 (2026-10-20): on the front beside U92, a small square package with four terminals on each of its
// four edges and a printed triangle at its pin 1; below it a bare two-pad footprint. Its marking is two
// lines, 'ZVK' over '22J', read by eye and then legible in a photograph. TI's part marking ZVK is the
// SN74AVC4T774 in its 16-terminal UQFN (RSV; SCES693I package option addendum), and TI's lot trace
// marking is a separate line, so U55 is a MarkingCandidate for that row with '22J' recorded as the trace
// line: no TI logo is read and a code can be reused by another maker, so the candidate credits no
// property until the orientation reads (pin 8 to the return, pins 13 and 14 to the capacitors above it).
// Under the candidate pinout the top edge, counted left to right with the triangle at the upper left,
// is DIR2, DIR1, VCCA, VCCB: no data port. The operator's readings from Q300's lead b toward the bare
// footprint and U55 join the record once their points are named.
data e1_u55: ComponentInstanceIdentity = e1_component(local: "U55")

data e1_u55_footprint: ComponentInstanceIdentity = e1_component(local: "bare two-pad footprint below U55 (designator unread)")

data e1_u55_pins: List<NonEmptyStr> = ["pin 1", "pin 2", "pin 3", "pin 4", "pin 5", "pin 6", "pin 7", "pin 8", "pin 9", "pin 10", "pin 11", "pin 12", "pin 13", "pin 14", "pin 15", "pin 16"]

// U55 READ AGAINST THE CANDIDATE PINOUT (2026-10-20, unpowered, 2k range). Pin 8 reads as ground to J20's
// black lead and the left bare pad below U55 reads '0ohm' to pin 6 (DIR4) and 1 kohm to pins 5 and 7:
// both zeros are reported with no baseline and join nothing, but they are the shape the candidate
// orientation predicts, and the empty footprint sits on DIR4's net. From Q300's lead b, pins 16, 15
// and 14 (DIR2, DIR1, VCCA under the candidate pinout) each read 500 ohm and pin 13 (VCCB) 1200 ohm;
// two direction inputs reading what the supply pin reads says they are tied to VCCA, and a supply rail
// 500 ohm from the gate is the simplest reading of every front-side 500 ohm point: the gate reaching
// that rail through a junction, with U500's one 500 ohm contact then its supply pin rather than a
// signal. The unpowered readings cannot separate the two; the hypothesis names the powered read that
// does. The data ports (pins 1 to 4 and 12 to 9) read 'most of these are all 1500', recorded hedged.
// Pin 14 reads '0.00' to the end of the left capacitor nearer U55 and pin 13 about 500 ohm, hedged ('the
// probes are too fat'), to the near end of the right one; the right bare pad reads over range to each of
// pins 5 to 8, so it sits on none of DIR3, DIR4, OE or GND.
data e1_u55_said: NonEmptyStr = "ZB20: ground / ZB21: this is very hard to measure, the probes are too fat - i think its 500 ohms at 2k but i'm not sure / ZB22: 0.00 / ZB23: 5: 1k, 6: 0ohm, 7: 1k, 8: ?? / ZB24: N/A don't see anything? / ZB25: 500, 500, 500, 1200 / ZB26: most of these are all 1500 / yeah the display showed over range 1 - for the ends of the capacitors - it was the closer ends"

data e1_u55_left_capacitor: ComponentInstanceIdentity = e1_component(local: "left tan capacitor above U55 (designator unread)")

data e1_u55_right_capacitor: ComponentInstanceIdentity = e1_component(local: "right tan capacitor above U55 (designator unread)")

data e1_u55_right_pad: ElectricalTerminalRef = e1_terminal(c: e1_u55_footprint, name: "right pad")

data e1_u55_lower_pins: List<NonEmptyStr> = ["pin 5", "pin 6", "pin 7", "pin 8"]

data e1_u55_data_ports: List<NonEmptyStr> = ["pin 1", "pin 2", "pin 3", "pin 4", "pin 12", "pin 11", "pin 10", "pin 9"]

fn e1_u55_pin(n: NonEmptyStr) -> ElectricalTerminalRef {
  e1_terminal(c: e1_u55, name: n)
}

fn e1_u55_read(a: ElectricalTerminalRef, b: ElectricalTerminalRef, display: ResistanceDisplay, certainty: StatementCertainty) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: a, second: b,
    record: both_points_recorded,
    conditions: e1_bench, polarity: RedOnFirst, range: RangeFullScale { ohms: 2000 }, display: display, stability: StabilityUnrecorded, certainty: certainty,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-20", verbatim: e1_u55_said }, e1_u55_photo],
  }
}

fn e1_u55_about(a: ElectricalTerminalRef, b: ElectricalTerminalRef, ohms: Nat) -> ResistanceObservation {
  e1_u55_read(a: a, b: b, display: DisplayValue { ohms: ohms, approximate: true }, certainty: StatedPlainly)
}

data e1_u55_left_pad: ElectricalTerminalRef = e1_terminal(c: e1_u55_footprint, name: "left pad")

data e1_u55_resistances: List<ResistanceObservation> = concat([
  e1_u55_read(a: e1_u55_pin(n: "pin 8"), b: e1_ground_ref, display: DisplayZeroWithoutBaseline { reported: "ground" }, certainty: StatedPlainly),
  e1_u55_about(a: e1_u55_left_pad, b: e1_u55_pin(n: "pin 5"), ohms: 1000),
  e1_u55_read(a: e1_u55_left_pad, b: e1_u55_pin(n: "pin 6"), display: DisplayZeroWithoutBaseline { reported: "0ohm" }, certainty: StatedPlainly),
  e1_u55_about(a: e1_u55_left_pad, b: e1_u55_pin(n: "pin 7"), ohms: 1000),
  e1_u55_about(a: e1_q300_lead_b, b: e1_u55_pin(n: "pin 16"), ohms: 500),
  e1_u55_about(a: e1_q300_lead_b, b: e1_u55_pin(n: "pin 15"), ohms: 500),
  e1_u55_about(a: e1_q300_lead_b, b: e1_u55_pin(n: "pin 14"), ohms: 500),
  e1_u55_about(a: e1_q300_lead_b, b: e1_u55_pin(n: "pin 13"), ohms: 1200),
  e1_u55_read(a: e1_u55_pin(n: "pin 14"), b: e1_terminal(c: e1_u55_left_capacitor, name: "end nearer U55"), display: DisplayZeroWithoutBaseline { reported: "0.00" }, certainty: StatedPlainly),
  e1_u55_read(a: e1_u55_pin(n: "pin 13"), b: e1_terminal(c: e1_u55_right_capacitor, name: "end nearer U55"), display: DisplayValue { ohms: 500, approximate: true }, certainty: StatedHedged { verbatim: "this is very hard to measure, the probes are too fat - i think its 500 ohms at 2k but i'm not sure" }),
  e1_u55_read(a: e1_u55_right_pad, b: e1_u55_pin(n: "pin 5"), display: DisplayOverRange, certainty: StatedPlainly),
  e1_u55_read(a: e1_u55_right_pad, b: e1_u55_pin(n: "pin 6"), display: DisplayOverRange, certainty: StatedPlainly),
  e1_u55_read(a: e1_u55_right_pad, b: e1_u55_pin(n: "pin 7"), display: DisplayOverRange, certainty: StatedPlainly),
  e1_u55_read(a: e1_u55_right_pad, b: e1_u55_pin(n: "pin 8"), display: DisplayOverRange, certainty: StatedPlainly),
], map(e1_u55_data_ports, n => e1_u55_read(a: e1_q300_lead_b, b: e1_u55_pin(n: n), display: DisplayValue { ohms: 1500, approximate: true }, certainty: StatedHedged { verbatim: "most of these are all 1500" })))

data e1_u55_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session uploads de4b3131, a5fed232, 19a48d02 and 6320a44a: U55 beside U92 and U93 with the FCC mark and MODEL:P4261 below, the triangle at its left, two bare pads under it; the marking 'ZVK' over '22J' legible in the last (not on Drive)")

// THE FRONT-SIDE 500 OHM CHAIN, U43, Y50 AND U500 (2026-10-20, unpowered, 2k range, red on Q300's lead b).
// Following the gate network on the front, the operator finds a run of points that each read about
// 500 ohm from Q300's lead b: the pad beside Y50's upper corner, both ends of a small resistor beside
// U43, the near end of the capacitor at U43's right, and the lower pad of a small two-terminal part
// directly above U500, from which a trace runs to U500's upper-right contact. U500's eight contacts,
// counted clockwise from the upper-left as photographed, read 1500, 500, 800, 1400, 1400, unread,
// unread, 1500 ohm; the 800 ohm contact reads '0.00' to J20's black lead (no baseline, so it joins
// nothing) and a via beside the chain reads 800 ohm too, so the gate's path to the return reads
// 800 ohm on this range and the 500 ohm points are a distinct net nearer the gate. U500 therefore
// meets the gate network at one contact. A 400 ohm reading the operator first reported at that via did
// not repeat: it is kept, hedged with the withdrawal, beside the 800 ohm that replaced it, and the
// hypothesis reads the repeated value. U43 is a five-lead SC70 marked WEJ, a MarkingCandidate for TI's
// SN74LV1T08 two-input AND gate (SCLS739F); Y50's marking is carried without decoding a frequency. Read each way, the pad reads 500 ohm to the return with red on the
// pad and 300 ohm swapped, and 500 then 1000 ohm to Q300's lead b: directional, so these are paths
// holding junctions, not a resistor chain (pair_polarity_standing). Y50 is a four-pad crystal marked 'T327K / EV13'; U43 a five-lead part marked WEJ; U500's marking reads 'FZ' over 'YY' with a corner dot, unresolved. None of these
// readings is a join; the powered reads at the 500 ohm pad (p4261_enable_network_hypothesis decided_by)
// decide whether U500 holds the node.
data e1_u43: ComponentInstanceIdentity = e1_component(local: "U43")

data e1_y50: ComponentInstanceIdentity = e1_component(local: "Y50")

data e1_u500: ComponentInstanceIdentity = e1_component(local: "U500")

data e1_u43_resistor: ComponentInstanceIdentity = e1_component(local: "small resistor beside U43 (designator unread)")

data e1_u43_capacitor: ComponentInstanceIdentity = e1_component(local: "capacitor at U43's right (designator unread)")

data e1_u500_upper_part: ComponentInstanceIdentity = e1_component(local: "small two-terminal part directly above U500 (designator unread)")

data e1_u43_chain_via: ComponentInstanceIdentity = e1_component(local: "via beside the U43 chain, below the small resistor")

data e1_u500_contacts: List<NonEmptyStr> = ["upper-left contact", "upper-right contact", "right contact 2", "right contact 3", "lower-right contact", "lower-left contact", "left contact 3", "left contact 2"]

data e1_u43_leads: List<NonEmptyStr> = ["pin 1", "pin 2", "pin 3", "pin 4", "pin 5"]

data e1_y50_pads: List<NonEmptyStr> = ["pad 1", "pad 2", "pad 3", "pad 4"]

data e1_u500_photo: EvidenceRef = e1_photo(taken_on: "2026-10-20", locator: "bench-session uploads be91d8be, the pair 29/30, 2cecb409 and 488510ac: Y50 ('T327K / EV13'), U500 ('FZ' over 'YY', a corner dot, eight contacts), U43 above with its triangle, the small resistor and capacitor beside U43, the two-terminal part above U500 with a trace to U500's upper-right contact; the operator's 500 and 800 marks (not on Drive)")

// THE MODULE SITE (2026-10-20). J3 and J4 are the carrier's two module receptacles, the long
// high-density connectors the module's two mate with. U3 is a six-lead small-outline part on the back,
// directly below Q300 and Q301 toward the site, with a marking partly read as 'B5', a via and passives
// above it (upload fe0f5816 places it; 049a64e1 is the close-up; 1749253a is the same part at a
// magnification where it looked like a bare footprint, read that way at first and withdrawn). The
// operator reports that many pads in the clusters
// beside both receptacles read about 500 ohm from Q300's lead b on the 2k range and declines to name
// them: 'my goal isn't to build an exact netlist'. That is recorded as the statement it is, with no
// pad named; one point is named as a reference, U3's lower-right lead as photographed, 500 ohm. It is
// the fourth place the 500 ohm relationship appears, after U55's supply and direction pins, the
// U43 / Y50 / U500 corner and the pad above U500, which is what a rail looks like from a point
// reaching it through a junction.
data e1_j3: ComponentInstanceIdentity = e1_component(local: "J3")

data e1_j4: ComponentInstanceIdentity = e1_component(local: "J4")

data e1_u3: ComponentInstanceIdentity = e1_component(local: "U3")

// U4 (2026-10-21): the heatsinked device below J4 whose marking the K1 listing left hidden. The operator
// lifted the finned heatsink (its push-pins would not release from the top: the split legs lock under
// the board), tearing the thermal pad, which was scraped off the heatsink; thermal paste is on hand for
// the refit, which is not yet reported. The marking reads Intel's Cyclone 10 GX, 10CX085YF672E6G, with
// the Intel logo, so the row is identified, not a candidate. Its 672 balls are not named as terminals.
data e1_u4: ComponentInstanceIdentity = e1_component(local: "U4")

data e1_u4_photo: EvidenceRef = e1_photo(taken_on: "2026-10-21", locator: "bench-session uploads e39a6d7c (U4 with its neighbours: 4R7 and 2R2 inductors, U10_P2, U9_P2, Q6_P2, U100 above; U21, Q1_2, U108, Y2 and Y361 around) and ddbe372b (the marking close up: intel / Cyclone 10 / 10CX085YF672E6G / P CBABF2243A / TAIWAN / S241AK47 / 305PA2U0D / e1) (not on Drive)")

data e1_u4_heatsink_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "basically the plastic clips are very easy to push in put kind of expand and will not pull out no matter what i tried / The pad ripped so I scraped it and cleaned it off the heatsink, I have plenty of thermal paste here / Sorry - I put the heatsink on already, do you want me to take it off again?" }

data e1_u4_heatsink_alteration: AssetAlteration = AssetAlteration {
  key: "2026-10-21 U4 heatsink lifted",
  asset: p4261_e1_b,
  part: e1_u4,
  performed_on: "2026-10-21",
  removed: ThermalPad,
  applied: Present { value: InterfaceUnstated },
  evidence: e1_u4_heatsink_said,
}

// THE TRUSTED-BOOT ISLAND BELOW U4 (2026-10-21). U5_2 carries the Microchip logo over 'CEC1736 /
// BAS723G / 2242QB1': a platform root of trust, identified. Beside it three Micron-format BGAs, U3_2
// and U2_2 marked '2NA17 / RW188' and a third, designator unread, '2RA17 / RW251' (Micron's FBGA
// part-marking decoder gives the part numbers; not yet run), and DS1_2, the indicator the operator had placed 'near U1_TFP'. The '_2'
// suffix (Q1_2, U1_2, U2_2, U3_2, U5_2, DS1_2) reads as that island's designator family, as '_P2' reads
// as U4's power stage and '_P5' as the 48 V hot-swap channel. Energized and settled, two videos
// (2026-10-21) were measured frame by frame: DS1_2 on about 1.0 s and off about 1.5 s, DS6 beside J68
// on about 1.36 s and off about 1.32 s, DS5 beside it steady, the four-lamp group near U1_TFP steady.
data e1_u5_2: ComponentInstanceIdentity = e1_component(local: "U5_2")

data e1_u2_2: ComponentInstanceIdentity = e1_component(local: "U2_2")

data e1_u3_2: ComponentInstanceIdentity = e1_component(local: "U3_2")

data e1_rw251_bga: ComponentInstanceIdentity = e1_component(local: "BGA marked 2RA17 / RW251 right of U3_2 (designator unread; U39 is the small two-terminal part beside it)")

data e1_u41: ComponentInstanceIdentity = e1_component(local: "U41")

data e1_u22: ComponentInstanceIdentity = e1_component(local: "U22")

data e1_j24: ComponentInstanceIdentity = e1_component(local: "J24")

// J24's ten positions, named by the operator (2026-10-21): row A holds the plugged position, A1 is the
// position farthest from the board edge and A5 the nearest; row B runs the same way. A3 is plugged as
// a key, and a contact under the plug read at the housing base, so it is a terminal with that note.
data e1_j24_positions: List<NonEmptyStr> = ["A1", "A2", "A3 (keyed; read at the housing base)", "A4", "A5", "B1", "B2", "B3", "B4", "B5"]

// About 1.3 mm along a row and 2.5 mm between rows, within 0.3 mm either way: the tape lay along the
// board edge, aligned to neither axis of the connector and nearer the camera, so this is a candidate
// pitch and never a connector-standard match; a caliper span replaces it.
data e1_j24_pitch: PhotographicSpan = PhotographicSpan { along_row_tenths_mm: 13, between_rows_tenths_mm: 25, tolerance_tenths_mm: 3, basis: e1_j24_tape_photo }

data e1_j24_tape_photo: EvidenceRef = e1_photo(taken_on: "2026-10-21", locator: "bench-session uploads 3667d943 (J24 close, the tape along the board edge below it) and 2939aa04 (both carriers side by side, the tape along the gap, J24 near its 6 3/4 inch mark) (not on Drive)")

data e1_j24_said: NonEmptyStr = "A3 doesn't help much with numbering because, its in the middle and the pin is symettric - so, the pin innermost to the board on the A3 column (row?) is A1 - at 2k range: A1: 428 A2: 420 A3: 405 (plugged though - i'm reading at the base) A4: 405 A5: high B1: 485 B2: 484 B3: 484 B4: 484 B5: high"

fn e1_j24_pin(n: NonEmptyStr) -> ElectricalTerminalRef { e1_terminal(c: e1_j24, name: n) }

fn e1_j24_read(n: NonEmptyStr, display: ResistanceDisplay) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: e1_j24_pin(n: n), second: e1_ground_ref,
    record: both_points_recorded,
    conditions: e1_bench, polarity: PolarityUnrecorded, range: RangeFullScale { ohms: 2000 }, display: display, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-21", verbatim: e1_j24_said }, e1_j24_photo],
  }
}

// Each of J24's positions to J20's black lead on the 2k range (2026-10-21): no position reads near
// zero, the A row 405 to 428 ohm and the B row 484 to 485, the fifth position of each row over range.
// Which probe was on the pin is unrecorded, and no baseline was taken, so nothing here joins.
data e1_j24_resistances: List<ResistanceObservation> = [
  e1_j24_read(n: "A1", display: DisplayValue { ohms: 428, approximate: false }),
  e1_j24_read(n: "A2", display: DisplayValue { ohms: 420, approximate: false }),
  e1_j24_read(n: "A3 (keyed; read at the housing base)", display: DisplayValue { ohms: 405, approximate: false }),
  e1_j24_read(n: "A4", display: DisplayValue { ohms: 405, approximate: false }),
  e1_j24_read(n: "A5", display: DisplayOverRange),
  e1_j24_read(n: "B1", display: DisplayValue { ohms: 485, approximate: false }),
  e1_j24_read(n: "B2", display: DisplayValue { ohms: 484, approximate: false }),
  e1_j24_read(n: "B3", display: DisplayValue { ohms: 484, approximate: false }),
  e1_j24_read(n: "B4", display: DisplayValue { ohms: 484, approximate: false }),
  e1_j24_read(n: "B5", display: DisplayOverRange),
]

// DS1_2 AND U104 (2026-10-21, unpowered, 2k range). One side of DS1_2 reads '.000' to U104's middle pin on
// the side away from the board edge, a zero without a baseline that joins nothing; the meter's test
// current lights the lamp when the probes sit the forward way, which is how the operator found the
// pair. A pad near U5_2 read 200 ohm from the lamp, the pad and the lamp's side unrecorded: a statement.
data e1_ds1_2: ComponentInstanceIdentity = e1_component(local: "DS1_2")

data e1_u104: ComponentInstanceIdentity = e1_component(local: "U104")

// U104's six leads by position: three on the side away from the board edge, three on the edge side,
// each top to bottom as photographed (upload d0a17790); which is pin 1 is unread.
data e1_u104_leads: List<NonEmptyStr> = ["inner side, top", "inner side, middle", "inner side, bottom", "edge side, top", "edge side, middle", "edge side, bottom"]

data e1_ds1_2_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "there are a lot of pads around U5_2 - i saw one near U5_2 (the big chip?) that has .200 on 2k - actually on ohms mode the light itself lights up sometimes when its high I guess - to U104 - the lights one side has a .000 reading to the middle pin on th e side far from the edge of the board" }

data e1_ds1_2_resistances: List<ResistanceObservation> = [
  ResistanceObservation {
    asset: p4261_e1_b, first: e1_terminal(c: e1_ds1_2, name: "one side (which of the two unrecorded)"), second: e1_terminal(c: e1_u104, name: "inner side, middle"),
    record: both_points_recorded,
    conditions: e1_bench, polarity: PolarityUnrecorded, range: RangeFullScale { ohms: 2000 }, display: DisplayZeroWithoutBaseline { reported: ".000" }, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [e1_ds1_2_said, e1_erot_photo],
  },
]

data e1_j24_photo: EvidenceRef = e1_photo(taken_on: "2026-10-21", locator: "bench-session uploads 76936961 and 1d24f35f (the second with a tape measure along the board edge): J24, a two-row five-position shrouded female receptacle between J68 and U53 with the middle position of one row plugged as a key, nine live positions; U21, U69 and U53 (eight-lead parts) around it; U1_2, U100, the 4R7 and 2R2 inductors and the 330 capacitors above (not on Drive)")

data e1_erot_photo: EvidenceRef = e1_photo(taken_on: "2026-10-21", locator: "bench-session uploads db5163ea and 914927cc (U5_2 'CEC1736 / BAS723G / 2242QB1' with the Microchip logo; U3_2 and U2_2 '2NA17 / RW188', a third BGA '2RA17 / RW251'; Q1_2, U21, U69, U104, U105, DS1_2 around), dda6b3a6 (energized: DS1_2 lit beside U5_2, U1_TFP below, the DS1x group lit at the right), d0a17790 (unpowered: the U5_2 designator read plainly, DS1_2 below-right of it, Q1_2, U104, U1_TFP) and 52e248d1 (unpowered: U3_2 and U2_2 with their corner dots, the 'U39' label beside a small two-terminal part between them, U105, U104, DS1_2, DS7, and the lamp row labelled DS10, DS11, DS13, DS12) (not on Drive)")

