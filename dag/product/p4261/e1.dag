fn e1_pad_read(a: ElectricalTerminalRef, b: ElectricalTerminalRef, ohms: Nat, polarity: ProbePolarity) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: a, second: b,
    record: both_points_recorded,
    conditions: e1_bench, polarity: polarity, range: RangeFullScale { ohms: 2000 }, display: DisplayValue { ohms: ohms, approximate: true }, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-20", verbatim: e1_pad_each_way_said }, e1_u500_photo],
  }
}

fn e1_front_read(b: ElectricalTerminalRef, ohms: Nat, said: NonEmptyStr) -> ResistanceObservation {
