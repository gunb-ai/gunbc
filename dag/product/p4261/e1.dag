    asset: p4261_e1_b, first: e1_q300_lead_b, second: b,
    record: both_points_recorded,
    conditions: e1_bench, polarity: RedOnFirst, range: RangeFullScale { ohms: 2000 }, display: DisplayValue { ohms: ohms, approximate: true }, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: AfterIncidents { keys: [e1_bridge_incident.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-20", verbatim: said }, e1_u500_photo],
  }
}

