// THE K1 UNIT (design p4261-k1-a): its listing photographs, bench records and phases.

// ── THE K1 UNIT (listing photographs; design p4261-k1-a) ────────────────────────────────────

data k1_design: ElectricalDesignIdentity = "p4261-k1-a" as ElectricalDesignIdentity

data k1_listing: EvidenceRef = SellerListingPhotograph { listing: "eBay item 168742238639", read_on: "2026-10-04" }

data k1_label_photo: EvidenceRef = OperatorPhotograph { taken_on: "2026-10-16", locator: "K1 label photograph sent in the session" }

fn k1_component(local: NonEmptyStr) -> ComponentInstanceIdentity {
  component_instance_identity(design: k1_design, local_identity: local)
}

fn k1_marking(text: NonEmptyStr) -> MarkingReading {
  MarkingReading { text: text, evidence: k1_listing }
}

// THE K1 ON THE BENCH (2026-10-19, unpowered, with nothing wired to it). Read with the probe held on the
// leads, for comparison with the E1 at U1_P5. The K1 is an earlier revision (694-24261-0000-100, PCB
// 180-14261-DAAF-A01; the E1 is -201 on -DAAF-B00), so a K1 reading is a lead for the E1 and never one
// of its readings: each names the K1 asset and the K1's own parts. Whether a module sat on the K1 was
// not said. No range was named for any of these, and which probe touched which point was not said.
//
// The K1's pin 7 is reported at 0 ohm to one end of a '200' resistor and not to the ringed via, hedged on
// the operator's "seem": the comparison was with E1 readings taken from the taped wire, whose attachment
// to pin 7 is disputed (e1_pin7_attachment), and those are not recorded yet. Pin 22 is reported connected to the point directly across from
// it, and pin 21 at 0 ohm to the top end of a beige two-terminal part across from it, with a visible
// trace. No baseline was recorded for any of these, so none joins its points.
data k1_bench: BenchConditions = BenchConditions { power: Unpowered, module: ModuleUnrecorded }

fn k1_photo(locator: NonEmptyStr) -> EvidenceRef {
  OperatorPhotograph { taken_on: "2026-10-19", locator: locator }
}

fn k1_said(verbatim: NonEmptyStr) -> EvidenceRef {
  OperatorStatement { stated_on: "2026-10-19", verbatim: verbatim }
}

fn k1_point(local: NonEmptyStr, name: NonEmptyStr) -> ElectricalTerminalRef {
  terminal_ref(component: k1_component(local: local), terminal: name as TerminalIdentity)
}

data k1_arrow_photo: EvidenceRef = k1_photo(locator: "K1 photograph of U1_P5 with an arrow toward the '200' resistor and an oval beside the right-hand column, sent in the session")

data k1_pin22_photo: EvidenceRef = k1_photo(locator: "K1 photograph of U1_P5 with a line from the right-hand column's seventh lead from the top (pin 22), sent in the session")

data k1_pin21_photo: EvidenceRef = k1_photo(locator: "K1 photograph of U1_P5 with a thick line at pin 22 and a thin line from pin 21 to the beige part, sent in the session")

data k1_u1_p5: ComponentInstanceIdentity = k1_component(local: "U1_P5")

data k1_200: ComponentInstanceIdentity = k1_component(local: "'200' resistor below U1_P5, under the '95C' resistor")

data k1_beige: ComponentInstanceIdentity = k1_component(local: "beige two-terminal part directly across from U1_P5 pin 21")

data k1_ringed_via: ComponentInstanceIdentity = k1_component(local: "via ringed in silkscreen, below-right of U1_P5")

data k1_pin22_point: ComponentInstanceIdentity = k1_component(local: "point directly across from U1_P5 pin 22 (the round via or the small square pad beside it, which unrecorded)")

data boards_differ_said: NonEmptyStr = "the two boards seem electrically different here: on the E1, its the circle you pointed to, on the K1, its a resistor I tried to point to with my arrow"

data boards_differ_hedge: StatementCertainty = StatedHedged { verbatim: "the two boards seem electrically different here" }

fn k1_u1_pin(pin: NonEmptyStr) -> ElectricalTerminalRef {
  terminal_ref(component: k1_u1_p5, terminal: pin as TerminalIdentity)
}

fn k1_read(first: ElectricalTerminalRef, second: ElectricalTerminalRef, record: ProbeRecord, display: ResistanceDisplay, certainty: StatementCertainty, evidence: List<EvidenceRef>) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_k1_a, first: first, second: second, record: record, conditions: k1_bench, polarity: PolarityUnrecorded,
    range: RangeUnrecorded, display: display, stability: StabilityUnrecorded, certainty: certainty, order: BeforeIncidents { keys: [] }, evidence: evidence,
  }
}

data k1_resistances: List<ResistanceObservation> = [
  k1_read(first: k1_point(local: "back-side via pad behind U1_P5, the operator's match for the E1's pad beside the 01B resistor", name: "pad"), second: k1_point(local: "ground point the operator named (which unrecorded)", name: "point"),
    record: second_point_inferred(basis: "'to ground': which ground point the probe touched is unrecorded"), display: DisplayValue { ohms: 3500, approximate: false }, certainty: StatedPlainly,
    evidence: [k1_said(verbatim: "For reference, on the other board i have, that pad also reads 3.5k to ground")]),
  k1_read(first: k1_u1_pin(pin: "pin 7"), second: terminal_ref(component: k1_200, terminal: "end read from pin 7 (which end unrecorded)" as TerminalIdentity), record: both_points_recorded,
    display: DisplayZeroWithoutBaseline { reported: "0 ohms" }, certainty: StatedHedged { verbatim: "I think this point is 0 ohms to pin 7" },
    evidence: [k1_said(verbatim: "I think this point is 0 ohms to pin 7"), k1_said(verbatim: boards_differ_said), k1_said(verbatim: "its the \"200\" resistor - the resistors on both boards are slightly different colors"), k1_arrow_photo]),
  k1_read(first: k1_u1_pin(pin: "pin 7"), second: terminal_ref(component: k1_ringed_via, terminal: "via" as TerminalIdentity),
    record: second_point_inferred(basis: "'the two boards seem electrically different here': on the K1 the point reported at 0 ohm to pin 7 is the '200' resistor's, not the ringed via; that the via was read from pin 7 is taken from that statement"),
    display: DisplayAboveBaseline, certainty: boards_differ_hedge, evidence: [k1_said(verbatim: boards_differ_said), k1_arrow_photo]),
  k1_read(first: terminal_ref(component: k1_pin22_point, terminal: "point" as TerminalIdentity), second: k1_u1_pin(pin: "pin 22"),
    record: second_point_inferred(basis: "'This pin 21 is connected to this pad directly across from it', corrected by 'i was on the wrong leg ... i thought you were asking for 8th from the bottom': the eighth lead up the right-hand column is U1_P5 pin 22, where the photograph's line is drawn"),
    display: DisplayZeroWithoutBaseline { reported: "connected" }, certainty: StatedPlainly,
    evidence: [k1_said(verbatim: "This pin 21 is connected to this pad directly across from it"), k1_said(verbatim: "oh sorry, i was on the wrong leg / This is K1, i thought you were asking for 8th from the bottom"), k1_pin22_photo]),
  k1_read(first: k1_u1_pin(pin: "pin 21"), second: terminal_ref(component: k1_beige, terminal: "top end" as TerminalIdentity), record: both_points_recorded,
    display: DisplayZeroWithoutBaseline { reported: "0" }, certainty: StatedPlainly,
    evidence: [k1_said(verbatim: "sorry, the 8th pin is wired to this component directly across - you can see the trace on the board"), k1_said(verbatim: "yes, it read 0 there"), k1_pin21_photo]),
]

// THE K1'S TWO RECORDED STATES (2026-10-21, energized at 48 V; the source's setting, the module's
// presence and the order the poles were moved are unrecorded). It starts at 13 mA 'like the other
// board' and, with every pole toward ON, reaches 40 mA with no lamp lit and goes no further: the E1's
// auxiliary-domain draw, reached and never left. In that state J68's positions read no voltage under
// the labelled map, R2 included: the FPGA's programming reference that the E1 holds at 1.8 V in its
// settled state is absent on the K1, so the K1 stops before U4's domain powers; the E1 reached a more
// advanced powered state, and whether U4 configured there is unread. The six positions recorded are the six
// the operator was asked for; the statement names the header.
data k1_j68: ComponentInstanceIdentity = k1_component(local: "J68")

data k1_s1: ComponentInstanceIdentity = k1_component(local: "S1")

data k1_s2: ComponentInstanceIdentity = k1_component(local: "S2")

data k1_return: ElectricalTerminalRef = k1_point(local: "J20", name: "black lead")

data k1_live_bench: BenchConditions = BenchConditions { power: Energized, module: ModuleUnrecorded }

data k1_40ma_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "the untouched K1 starts at .013A like the other board, and with all the switches on, it only gets to .040 for some reason, no LEDs turn on." }

data k1_j68_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "I didn't read any voltage on that pin header on K1 at 40ma" }

fn k1_pole(package: ComponentInstanceIdentity, pole: Nat, position: SwitchPolePosition) -> SwitchPoleState {
  SwitchPoleState { package: package, pole: pole, position: position }
}

data k1_vector_all_on: List<SwitchPoleState> = [k1_pole(package: k1_s2, pole: 1, position: TowardOnLegend), k1_pole(package: k1_s2, pole: 2, position: TowardOnLegend), k1_pole(package: k1_s1, pole: 1, position: TowardOnLegend), k1_pole(package: k1_s1, pole: 2, position: TowardOnLegend)]

data k1_vector_p0: List<SwitchPoleState> = [k1_pole(package: k1_s2, pole: 1, position: PolePositionUnrecorded), k1_pole(package: k1_s2, pole: 2, position: PolePositionUnrecorded), k1_pole(package: k1_s1, pole: 1, position: PolePositionUnrecorded), k1_pole(package: k1_s1, pole: 2, position: PolePositionUnrecorded)]

fn k1_j68_volt(point: NonEmptyStr, millivolts: Nat) -> PhaseNodeVoltage {
  PhaseNodeVoltage { at: terminal_ref(component: k1_j68, terminal: point as TerminalIdentity), reference: k1_return, value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly, evidence: k1_j68_said }
}

data k1_j68_volts_at_40ma: List<PhaseNodeVoltage> = map(["R1", "R5", "R2", "L1", "L3", "L5"], n => k1_j68_volt(point: n, millivolts: 0))

// J30 on the K1 in the same state, under the labelled positions A, B, C: A 0 V, B and C 0.26 V. Where the
// E1 settled holds one of J30's points at 3.1 V, 0.26 V is a pulled-up line whose pull-up's rail is not
// up, the same reading of the K1 as J68's.
data k1_j30: ComponentInstanceIdentity = k1_component(local: "J30")

data k1_j30_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "j30 on k1 - two pins, B and C are .26v, and A is 0v" }

fn k1_j30_volt(point: NonEmptyStr, millivolts: Nat) -> PhaseNodeVoltage {
  PhaseNodeVoltage { at: terminal_ref(component: k1_j30, terminal: point as TerminalIdentity), reference: k1_return, value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly, evidence: k1_j30_said }
}

data k1_j30_volts_at_40ma: List<PhaseNodeVoltage> = [k1_j30_volt(point: "A", millivolts: 0), k1_j30_volt(point: "B", millivolts: 260), k1_j30_volt(point: "C", millivolts: 260)]

// THE THREE INDUCTORS BESIDE U4 ON THE K1 AT 40 mA (2026-10-21), at their pads against J20's black
// lead: the 2R2 0 V, the 4R7 nearest U4 0 V, the farther 4R7 3.2 V at its pad closer to U4 and 3.0 V
// at its other pad. Read as the outputs of U4's '_P2' converters, one of the three runs on the K1 and
// two do not, where the E1 settled reads about 3.2 V at the nearest 4R7 and 0.94 V at the 2R2
// (e1_inductor_volts): the K1's U4 domain is partly up, its 1.8 V programming reference absent at J68
// R2 with it; whether each absent output is a missing input, an inactive enable, a converter fault or an
// overloaded load is unread until the converters are identified and read at their pins. Which
// pad of the 2R2 and of the nearest 4R7 was read is unrecorded; the 0.2 V between the farther 4R7's
// pads is recorded, not explained (a meter averaging a switching node reads below the output).
data k1_l_4r7_near: ComponentInstanceIdentity = k1_component(local: "4R7 inductor nearest U4")

data k1_l_4r7_far: ComponentInstanceIdentity = k1_component(local: "the farther 4R7 inductor beside U4")

data k1_l_2r2: ComponentInstanceIdentity = k1_component(local: "2R2 inductor beside U4")

data k1_inductor_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "2R2 is 0v - the nearest 4R7 to U4 is 0v, the farther one is 3.2v, and 3.0v respectively (the closer pad to U4 is 3.2v)" }

fn k1_l_volt(c: ComponentInstanceIdentity, pad: NonEmptyStr, millivolts: Nat) -> PhaseNodeVoltage {
  PhaseNodeVoltage { at: terminal_ref(component: c, terminal: pad as TerminalIdentity), reference: k1_return, value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly, evidence: k1_inductor_said }
}

data k1_inductor_volts_at_40ma: List<PhaseNodeVoltage> = [
  k1_l_volt(c: k1_l_2r2, pad: inductor_pad_unrecorded, millivolts: 0),
  k1_l_volt(c: k1_l_4r7_near, pad: inductor_pad_unrecorded, millivolts: 0),
  k1_l_volt(c: k1_l_4r7_far, pad: inductor_pad_near_u4, millivolts: 3200),
  k1_l_volt(c: k1_l_4r7_far, pad: inductor_pad_far_u4, millivolts: 3000),
]

// TWO STIMULI THAT MOVE THE E1 AND NOT THE K1 (2026-10-21). Asked for 'K1 at 40 mA, J30 A to B tapped:
// any change in current or lamps', the operator answered '1. no change as far as i can see'; asked for
// 'K1, S1's pole 2 cycled alone with S2 set as on the E1's P1 (pole 1 toward ON, pole 2 away), watching
// the current', '5. nothing seems to happen to the current'. On the E1 the J30 tap lights DS3 and DS4 and
// S1's pole 2 starts the sequence; on the K1 neither does anything, consistent with the logic that
// answers them sitting in the domain the inductor pads read as unpowered. The draw in the S2-as-P1
// states was not read as a number, so those phases carry no current and classify as unread; S1's pole 1
// is recorded toward ON from the all-poles state because the pole was cycled 'alone'.
data k1_j30_tap_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "1. no change as far as i can see" }

data k1_s1_cycle_said: EvidenceRef = OperatorStatement { stated_on: "2026-10-21", verbatim: "5. nothing seems to happen to the current" }

data k1_j30_tap: HeaderBridge = HeaderBridge { header: k1_j30, first: k1_point(local: "J30", name: "A"), second: k1_point(local: "J30", name: "B"), coupling: DirectBridge, hold: MomentaryTouch }

data k1_vector_s2_as_p1: List<SwitchPoleState> = [k1_pole(package: k1_s2, pole: 1, position: TowardOnLegend), k1_pole(package: k1_s2, pole: 2, position: AwayFromOnLegend), k1_pole(package: k1_s1, pole: 1, position: TowardOnLegend), k1_pole(package: k1_s1, pole: 2, position: TowardOnLegend)]

data k1_vector_s2_as_p1_s1_2_away: List<SwitchPoleState> = [k1_pole(package: k1_s2, pole: 1, position: TowardOnLegend), k1_pole(package: k1_s2, pole: 2, position: AwayFromOnLegend), k1_pole(package: k1_s1, pole: 1, position: TowardOnLegend), k1_pole(package: k1_s1, pole: 2, position: AwayFromOnLegend)]

fn k1_phase_at(key: NonEmptyStr, supply: SupplyReading, vector: List<SwitchPoleState>, indicators: IndicatorPattern, volts: List<PhaseNodeVoltage>, evidence: List<EvidenceRef>) -> CarrierPhaseObservation {
  CarrierPhaseObservation {
    key: key, asset: p4261_k1_a, conditions: k1_live_bench, setting: SettingUnrecorded, supply: supply, switch_vector: vector,
    held: Absent, recovering_from: Absent, settling: SettlingUnrecorded, indicators: indicators, node_voltages: volts, aliased_voltages: [], evidence: evidence,
  }
}

fn k1_phase(key: NonEmptyStr, ma: Nat, vector: List<SwitchPoleState>, indicators: IndicatorPattern, volts: List<PhaseNodeVoltage>, evidence: List<EvidenceRef>) -> CarrierPhaseObservation {
  k1_phase_at(key: key, supply: e1_read_ma(count: ma), vector: vector, indicators: indicators, volts: volts, evidence: evidence)
}

fn k1_transition(key: NonEmptyStr, from_phase: NonEmptyStr, stimulus: PhaseStimulus, to_phase: NonEmptyStr, supply_trace: List<SupplyReading>, indicator_trace: List<IndicatorPattern>, evidence: List<EvidenceRef>) -> CarrierTransitionObservation {
  CarrierTransitionObservation { key: key, asset: p4261_k1_a, from_phase: from_phase, stimulus: stimulus, to_phase: to_phase, supply_trace: supply_trace, indicator_trace: indicator_trace, audible: NoSoundReported, evidence: evidence }
}

data k1_phases: List<CarrierPhaseObservation> = [
  k1_phase(key: "k1-p0-bias", ma: 13, vector: k1_vector_p0, indicators: IndicatorsUnobserved, volts: [], evidence: [k1_40ma_said]),
  k1_phase(key: "k1-all-poles-on", ma: 40, vector: k1_vector_all_on, indicators: NoIndicatorSeen { evidence: k1_40ma_said }, volts: concat(concat(k1_j68_volts_at_40ma, k1_j30_volts_at_40ma), k1_inductor_volts_at_40ma), evidence: [k1_40ma_said, k1_j68_said, k1_j30_said, k1_inductor_said]),
  k1_phase(key: "k1-after-j30-tap", ma: 40, vector: k1_vector_all_on, indicators: NoIndicatorSeen { evidence: k1_j30_tap_said }, volts: [], evidence: [k1_j30_tap_said]),
  k1_phase_at(key: "k1-s2-as-p1", supply: e1_draw_unrecorded, vector: k1_vector_s2_as_p1, indicators: IndicatorsUnobserved, volts: [], evidence: [k1_s1_cycle_said]),
  k1_phase_at(key: "k1-s2-as-p1-s1-2-away", supply: e1_draw_unrecorded, vector: k1_vector_s2_as_p1_s1_2_away, indicators: IndicatorsUnobserved, volts: [], evidence: [k1_s1_cycle_said]),
]

data k1_transitions: List<CarrierTransitionObservation> = [
  k1_transition(key: "k1-all-poles-set", from_phase: "k1-p0-bias", stimulus: SwitchPolesMoved { poles: k1_vector_all_on, timing: MoveTimingUnrecorded }, to_phase: "k1-all-poles-on", supply_trace: [e1_read_ma(count: 13), e1_read_ma(count: 40)], indicator_trace: [NoIndicatorSeen { evidence: k1_40ma_said }], evidence: [k1_40ma_said]),
  k1_transition(key: "k1-j30-tapped", from_phase: "k1-all-poles-on", stimulus: HeaderBridgeApplied { bridge: k1_j30_tap }, to_phase: "k1-after-j30-tap", supply_trace: [e1_read_ma(count: 40), e1_read_ma(count: 40)], indicator_trace: [NoIndicatorSeen { evidence: k1_j30_tap_said }], evidence: [k1_j30_tap_said]),
  k1_transition(key: "k1-s2-set-as-p1", from_phase: "k1-after-j30-tap", stimulus: SwitchPolesMoved { poles: [k1_pole(package: k1_s2, pole: 2, position: AwayFromOnLegend)], timing: MoveTimingUnrecorded }, to_phase: "k1-s2-as-p1", supply_trace: [], indicator_trace: [], evidence: [k1_s1_cycle_said]),
  k1_transition(key: "k1-s1-pole2-away", from_phase: "k1-s2-as-p1", stimulus: SwitchPolesMoved { poles: [k1_pole(package: k1_s1, pole: 2, position: AwayFromOnLegend)], timing: MoveTimingUnrecorded }, to_phase: "k1-s2-as-p1-s1-2-away", supply_trace: [], indicator_trace: [], evidence: [k1_s1_cycle_said]),
  k1_transition(key: "k1-s1-pole2-back", from_phase: "k1-s2-as-p1-s1-2-away", stimulus: SwitchPolesMoved { poles: [k1_pole(package: k1_s1, pole: 2, position: TowardOnLegend)], timing: MoveTimingUnrecorded }, to_phase: "k1-s2-as-p1", supply_trace: [], indicator_trace: [], evidence: [k1_s1_cycle_said]),
]

data k1_measured: MeasuredBoard = MeasuredBoard {
  asset: p4261_k1_a,
  continuity: [],
  diode_readings: [],
  source_draws: [],
  bench: BenchRecord { incidents: [], attachments: [], alterations: [], voltages: [], resistances: concat(k1_resistances, [k1_l_4r7_near_resistance]) },
  phases: k1_phases,
  transitions: k1_transitions, pole_closures: [],
}

// "Rework" beside the PCB code is a printed marking; whether any rework was performed, and what, is
// unknown. The labels read "0000-100" where the listing title says "000-100"; the label is the reading.
data p4261_k1_layout: CarrierLayoutObservation = CarrierLayoutObservation {
  asset: p4261_k1_a,
  design: k1_design,
  markings: [
    AssemblyLabel { model: "P4261", part_number: "694-24261-0000-100", revision: "K1", serial: "1582023110038", evidence: k1_listing },
    AssemblyLabel { model: "P4261", part_number: "694-24261-0000-100", revision: "K1", serial: "1582023110033", evidence: k1_listing },
    AssemblyLabel { model: "P4261", part_number: "694-24261-0000-100", revision: "K1", serial: "1582023110038", evidence: k1_label_photo },
    PcbCode { code: "180-14261-DAAF-A01", printed_beside: Present { value: "Rework" }, evidence: k1_label_photo },
    RevisionSticker { revision: "215-EV1", serial: "1582023110033", evidence: OperatorStatement { stated_on: "2026-10-16", verbatim: "the k1 board has the ev1 sticker on it" } },
    FabricationMark { text: "TTM 94V0 RFB1 2923", evidence: k1_listing },
  ],
  module_receptacles: ["J3", "J4"],
  backplane_connectors: [
    BackplaneConnectorObservation { seen: 2, face: Absent, guide_pin_seen: false, power_blade_seen: false, evidence: k1_listing },
  ],
  j20: CountedFromPhotograph { positions: 16, evidence: k1_listing },
  j20_calipers: [],
  edge_high_speed_connectors: CensusPartial {
