// THE RENDERED REPORT (diagnostics only): text over the records and their derivations, and the
// narrow findings for consumers that cite one fact.

fn state_text(s: BoardState) -> String {
  match s.state.after.first() {
    Absent => "the intact board"
    Present { value: _ } => join(["the board after ", join(map(s.state.after, k => k as String), " and ")], "")
  }
}

fn netlist_reading(layout: CarrierLayoutObservation) -> String {
  match layout.measured {
    Absent => "no board measured, so no measured netlist"
    Present { value: b } => match analysis_state(b: b) {
      Absent => "the board's analysis selection names no state of its record, so no measured netlist"
      Present { value: s } => {
        let rs = board_readings(s: s)
        join([
          state_text(s: s), ": ", netlist_text(net: board_netlist(s: s)),
          " (not folded in: ", to_string(rs.excluded_other_state), " readings of other states, ", to_string(rs.excluded_other_configuration), " of another module configuration, ",
          to_string(rs.excluded_order_uncovered), " whose order against a dividing event is not stated, ", to_string(rs.excluded_event_unresolved), " naming no recorded event)",
        ], "")
      }
    }
  }
}

fn input_draw_gap_text(g: InputDrawGap) -> String {
  match g {
    NoEnergizedInputReading => "no energized reading across the input"
    DrawPolarityNotEstablished => "the input's polarity is not established, so no reading is placed across it"
    InputReadingsInconclusive { standings } => join(map(standings, s => source_draw_text(s: s)), "; ")
  }
}

fn input_draw_text(d: InputDrawStanding) -> String {
  match d {
    InputDrawBounded { bounded, observed: _ } => join(["energized across its fused and return rows, module removed: ", join(map(bounded, s => source_draw_text(s: s)), "; ")], "")
    InputDrawContradicted { contradicted, observed: _ } => join(["energized across its fused and return rows, the draw bound is CONTRADICTED: ", join(map(contradicted, s => source_draw_text(s: s)), "; ")], "")
    InputDrawUnestablished { gaps } => join(["no energized draw established (", join(map(gaps, g => input_draw_gap_text(g: g)), "; "), ")"], "")
  }
}


fn configuration_scheme_text(s: ConfigurationScheme) -> String {
  match s {
    ActiveSerial { data_lanes, flash_family } => join(["active serial x", to_string(data_lanes), " from a ", flash_family as String, " flash"], "")
    AvalonStreaming => "Avalon streaming from a host"
    JtagDownload => "JTAG download"
  }
}

// WHAT U4 IS, AND WHERE WHETHER IT IS DOING ANYTHING IS READ. An identified programmable-logic row says
// how its configuration arrives and what its pins do until it is configured; the text names the signal
// that reports configuration, because a volatile device whose pins are weak pull-ups until then drives
// nothing on the board, Q300's gate included, before that signal goes high.
fn u4_configuration_text(layout: CarrierLayoutObservation) -> String {
  match installed(layout: layout, c: e1_u4) {
    Absent => join([component_text(c: e1_u4), " is not a component of this carrier's observation"], "")
    Present { value: x } => match identified_row(c: x) {
      Absent => join([component_text(c: e1_u4), "'s marking is unread or unresolved, so what drives Q300's gate stays a candidate"], "")
      Present { value: row } => match logic_of(c: x) {
        Absent => join([component_text(c: e1_u4), " reads ", row.ordering_code as String, ", a row that carries no programmable-logic specification"], "")
        Present { value: l } => join([
          component_text(c: e1_u4), " reads ", row.ordering_code as String, ": programmable logic, ", to_string(l.logic_elements), " logic elements, ",
          match l.memory { VolatileConfiguration => "its configuration volatile and loaded at every power-up", NonVolatileConfiguration => "its configuration held without power" },
          " over one of ", to_string(count(l.schemes)), " schemes (", join(map(l.schemes, s => configuration_scheme_text(s: s)), "; "), "); its user pins are ",
          match l.io_before_configuration { WeakPullUp => "weak pull-ups", HighImpedance => "high impedance", PullUpByStrap { strap } => join(["weak pull-ups if its ", strap as String, " strap enables them, else high impedance"], "") },
          " until it is configured, so whether it drives anything is read at ",
          match configuration_done_signal(spec: l) { Present { value: s } => s.name as String, Absent => "a status signal the row does not name" },
          match initialization_done_signal(spec: l) { Present { value: s } => join([" and user mode at ", s.name as String, " where enabled"], ""), Absent => "" },
          if count(l.por_monitored_supplies) == 0 { "" } else { join(["; its power-on reset also holds until ", join(map(l.por_monitored_supplies, r => r as String), ", "), " is present"], "") },
        ], "")
      }
    }
  }
}

// J24 AS THE RECORD HAS IT: its positions, the photographic pitch, its readings to the return by kind,
// and what they say of the return (product.p4261.readings j24_reading).

// J68 BY ITS UNPOWERED SHAPE: which positions read as the return, which are open, and whether two
// positions of the other row read alike, the facts a JTAG header's layout predicts.

fn jtag_standing_text(s: JtagHeaderStanding) -> String {
  match s {
    JtagFingerprintAbsent => "the unpowered readings do not fit the layout"
    CandidateByResistanceFingerprint => "a candidate by its resistance fingerprint; the labelled powered re-read (R1 and R5 at 0 V, R2 near 1.8 V) and a read-only chain scan are not yet taken"
    PoweredCorroborated => "corroborated powered (returns at 0 V, the reference near 1.8 V); a read-only chain scan returning an IDCODE is not yet taken"
    FunctionallyIdentified => "functionally identified by a chain scan"
  }
}


fn alteration_text(a: AssetAlteration) -> String {
  match a.change {
    ThermalInterfaceChanged { removed, applied } => join([
      a.key as String, ": ", component_text(c: a.part), " had ", thermal_interface_text(t: removed), " removed",
      match applied { Present { value: t } => join([" and ", thermal_interface_text(t: t), " applied"], ""), Absent => ", and no refit is yet reported" },
      " (", evidence_ref_text(e: a.evidence), ")",
    ], "")
    PartRemoved { refitted } => join([
      a.key as String, ": ", component_text(c: a.part), " was lifted off the board",
      if refitted { " and refitted" } else { " and not refitted, so its footprint is bare and readings there are of the board without it" },
      " (", evidence_ref_text(e: a.evidence), ")",
    ], "")
  }
}

fn alterations_text(layout: CarrierLayoutObservation) -> String {
  match layout.measured {
    Absent => "no alteration of the asset is recorded"
    Present { value: b } => if count(b.bench.alterations) == 0 { "no alteration of the asset is recorded" } else { join(map(b.bench.alterations, a => alteration_text(a: a)), "; ") }
  }
}

// THE FLASHES BESIDE U5_2, BY CAPACITY. Which image each holds is unread; the text gives the sizes the
// record identifies so that a later reading of the bus can be set against them.
fn island_flash_text(layout: CarrierLayoutObservation) -> String {
  let parts = [e1_u3_2, e1_u2_2, e1_rw251_bga]
  let texts = map(parts, c => match installed(layout: layout, c: c) {
    Absent => join([component_text(c: c), " is not a component of this carrier's observation"], "")
    Present { value: x } => match flash_of(c: x) {
      Absent => join([component_text(c: c), " carries no serial-flash row"], "")
      Present { value: f } => join([component_text(c: c), " ", to_string(f.capacity_mbit), " Mbit (", to_string(f.data_lanes), " lanes, signature ", f.jedec_signature as String, ")"], "")
    }
  })
  join(["Serial flashes beside U5_2: ", join(texts, "; "), "; which image each holds is unread"], "")
}

// WHAT MAY STAND BETWEEN U4 AND ITS FLASH. An identified root-of-trust row with secure boot among its
// protections says what U5_2 can do: authenticate a flash before the part it guards runs. Whether it
// guards U4, and which of the three flashes beside it belongs to U4, to U5_2 or to another consumer, is
// unread; the text says so, and the relation stays a candidate until a bus capture, a traced release
// line or a configuration-status read decides it.
fn u5_2_root_of_trust_text(layout: CarrierLayoutObservation) -> String {
  match installed(layout: layout, c: e1_u5_2) {
    Absent => join([component_text(c: e1_u5_2), " is not a component of this carrier's observation"], "")
    Present { value: x } => match identified_row(c: x) {
      Absent => join([component_text(c: e1_u5_2), "'s marking is unread or unresolved"], "")
      Present { value: row } => match root_of_trust_of(c: x) {
        Absent => join([component_text(c: e1_u5_2), " reads ", row.ordering_code as String, ", a row that carries no root-of-trust specification"], "")
        Present { value: r } => join([
          component_text(c: e1_u5_2), " reads ", row.ordering_code as String, ": a platform root of trust (", r.core as String, ") with ", to_string(count(r.protections)), " protections",
          if guards_boot(spec: r) { ", secure boot among them, so it can authenticate a flash before the part it guards runs; whether it guards U4, and which flash is whose, is unread, so U4's configuration has that release as a condition only under that candidate relation" } else { ", secure boot not among them" },
        ], "")
      }
    }
  }
}


// Which way a net meeting one of a shift register's pins runs, from the pin's datasheet role; a part not
// identified as one has no pin roles to read.
fn register_pin_direction_text(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity, number: Nat) -> String {
  match installed(layout: layout, c: c) {
    Absent => join([component_text(c: c), " is not a component of this carrier's observation"], "")
    Present { value: x } => match register_of(c: x) {
      Absent => join([component_text(c: c), " is not identified as a shift register, so its pin ", to_string(number), " has no role to read"], "")
      Present { value: r } => match logic_pin_direction(spec: r, number: number) {
        ReadByThePart { pin } => join([component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is READ by the part: a net there is an input it samples"], "")
        DrivenByThePart { pin } => join([component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is DRIVEN by the part: a net there could be driven or forwarded by it"], "")
        ControlOrClockIntoThePart { pin } => join([component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is a control or clock into the part: a net there is shared with whatever clocks it"], "")
        SupplyOrReturn { pin } => join([component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is its supply or return"], "")
        NoLogicPinNumbered { number: n } => join([component_text(c: c), " has no pin ", to_string(n)], "")
      }
    }
  }
}

fn projection_text(p: EnableProjection) -> String {
  match p {
    EnableUnreachableWithinInputBound { component, readings, turn_on_millivolts, bound } => join([
      component_text(c: component), "'s enable tracks the input and would reach its threshold minimum only near ", millivolt_text(n: turn_on_millivolts),
      ", above the input's ", to_string(volt_count(v: bound)), " V bound (a rated working limit, not a clamp level): the input alone does not enable it within its rating (", join(map(readings, o => node_voltage_text(o: o)), "; "), readings_caveat(vs: readings), ")",
    ], "")
    EnableReachableWithinInputBound { component, readings, turn_on_millivolts, bound } => join([
      component_text(c: component), "'s enable tracks the input and reaches its threshold minimum near ", millivolt_text(n: turn_on_millivolts),
      ", within the input's ", to_string(volt_count(v: bound)), " V bound (", join(map(readings, o => node_voltage_text(o: o)), "; "), readings_caveat(vs: readings), ")",
    ], "")
    EnableProjectionUnestablished { component, gap } => join([component_text(c: component), "'s enable is not projected onto the input (",
      match gap {
        ProjectionControllerNotIdentified => "not identified as a hot-swap controller"
        FewerThanTwoSourceSettings => "no two values read under different source settings"
        NotProportionalToSource => "its readings do not scale with the source"
        NoInputBound => "the input has no established upper bound"
        ProjectionReadOnlyAtAttachment { attachments } => join(["its only readings are at ", attachment_points_text(attachments: attachments)], "")
      }, ")"], "")
  }
}

fn readings_caveat(vs: List<NodeVoltageObservation>) -> String {
  join([
    if any(vs, o => !is_before_incidents(o: o.order)) { "; rests on readings taken after an incident or of unrecorded order" } else { "" },
    if any(vs, o => is_hedged(c: o.certainty)) { "; rests on a hedged statement" } else { "" },
  ], "")
}

fn switch_text(s: InputSwitchStanding) -> String {
  match s {
    SwitchBlocking { component, drain, sources } => join([
      component_text(c: component), " is BLOCKING: drain ", join(map(drain, o => node_voltage_text(o: o)), "; "), "; sources ", join(map(sources, o => node_voltage_text(o: o)), "; "), readings_caveat(vs: concat(drain, sources)),
    ], "")
    SwitchConducting { component, drain, sources } => join([
      component_text(c: component), " is CONDUCTING: drain ", join(map(drain, o => node_voltage_text(o: o)), "; "), "; sources ", join(map(sources, o => node_voltage_text(o: o)), "; "), readings_caveat(vs: concat(drain, sources)),
    ], "")
    SwitchStateUnestablished { component, gap } => join([component_text(c: component), " state not established (",
      match gap {
        SwitchNotIdentified => "not identified as a MOSFET, so no terminal roles"
        DrainUnread => "no drain value read"
        SourcesUnread => "no source read"
        SourcesBetweenStates => "sources neither far below nor near the drain"
      }, ")"], "")
  }
}

fn pin_word(which: ThresholdPin) -> String {
  match which {
    EnablePin => "enable (UVLO/EN)"
    OvervoltagePin => "overvoltage lockout (OVLO)"
  }
}

fn below_meaning(which: ThresholdPin) -> String {
  match which {
    EnablePin => "HELD BELOW its threshold, so the gate is held off"
    OvervoltagePin => "BELOW its threshold, so it does not lock the input out"
  }
}

fn above_meaning(which: ThresholdPin) -> String {
  match which {
    EnablePin => "ABOVE its threshold, so it does not hold the gate off"
    OvervoltagePin => "ABOVE its threshold, so it locks the input out"
  }
}

fn pin_standing_text(s: ControllerPinStanding, which: ThresholdPin) -> String {
  match s {
    PinBelowThreshold { component, readings, minimum } => join([
      component_text(c: component), "'s ", pin_word(which: which), " is ", below_meaning(which: which), " (minimum ", millivolt_text(n: millivolt_count(v: minimum)), "): ", join(map(readings, o => node_voltage_text(o: o)), "; "), readings_caveat(vs: readings),
    ], "")
    PinAboveThreshold { component, readings, maximum } => join([
      component_text(c: component), "'s ", pin_word(which: which), " is ", above_meaning(which: which), " (maximum ", millivolt_text(n: millivolt_count(v: maximum)), "): ", join(map(readings, o => node_voltage_text(o: o)), "; "), readings_caveat(vs: readings),
    ], "")
    PinThresholdUnestablished { component, readings, gap } => join([component_text(c: component), "'s ", pin_word(which: which), " state not established (",
      match gap {
        ControllerNotIdentified => "not identified as a hot-swap controller"
        NoSuchPin => "its datasheet names no such pin"
        PinUnread => "the pin is unread"
        BoundNotBelowMinimum { bound, minimum } => join(["the reading is a stated bound of ", millivolt_text(n: millivolt_count(v: bound)), ", not below the threshold minimum of ", millivolt_text(n: millivolt_count(v: minimum)), ": read the pin's value"], "")
        ReadWithinWindow => "the value read lies within the threshold window"
        ReadOnlyAtAttachment { attachments } => join(["its only readings are at ", attachment_points_text(attachments: attachments), ": read that point's resistance to the pin's own lead"], "")
        AccessPointUnseparated { points, neighbours } => join([
          "the readings are at ", join(map(points, x => terminal_text(t: x)), ", "), ", joined to the pin at the shorted-probe baseline but not separated from its neighbouring ",
          join(map(neighbours, x => terminal_text(t: x)), " and "), ", so they may be a neighbour's: read the point's resistance to each neighbour",
        ], "")
      },
      match readings.first() {
        Absent => ""
        Present { value: _ } => join(["; ", join(map(readings, o => node_voltage_text(o: o)), "; ")], "")
      },
      ")"], "")
  }
}

fn attachment_word(s: AttachmentStanding) -> String {
  match s {
    AttachmentJoined { attachment: _, joins: _ } => "joined"
    AttachmentRuled { attachment: _ } => "ruled on by the operator"
    AttachmentDisputed { attachment: _ } => "disputed"
    AttachmentUnconfirmed { attachment: _ } => "unconfirmed"
  }
}

fn attachment_points_text(attachments: List<AttachmentStanding>) -> String {
  join([
    join(map(attachments, s => join([terminal_text(t: attachment_of(s: s).point), " (attachment ", attachment_word(s: s), ")"], "")), " and "),
    ", which no reading joins to the pin at the shorted-probe baseline",
  ], "")
}

fn disputes_text(a: ProbeAttachment) -> String {
  match a.disputes.first() {
    Absent => ""
    Present { value: _ } => join(["; the operator has since doubted where it sat: ", join(map(a.disputes, e => evidence_ref_text(e: e)), "; ")], "")
  }
}

fn attachment_text(s: AttachmentStanding) -> String {
  let a = attachment_of(s: s)
  join([
    terminal_text(t: a.point), ", attached at ", terminal_text(t: a.intended), " on the operator's word (", evidence_ref_text(e: a.statement), "), is ",
    match s {
      AttachmentJoined { attachment: _, joins } => join(["JOINED to it at the shorted-probe baseline (", join(map(joins, o => resistance_text(o: o)), "; "), ")"], "")
      AttachmentRuled { attachment: _ } => join(["RULED on by the operator (", join(map(a.ruling, e => evidence_ref_text(e: e)), "; "), "): settled in the record, though no reading joins it to ", terminal_text(t: a.intended), " at the shorted-probe baseline"], "")
      AttachmentDisputed { attachment: _ } => join(["DISPUTED: no reading joins it to ", terminal_text(t: a.intended), " at the shorted-probe baseline"], "")
      AttachmentUnconfirmed { attachment: _ } => join(["UNCONFIRMED: no reading joins it to ", terminal_text(t: a.intended), " at the shorted-probe baseline"], "")
    },
    disputes_text(a: a),
  ], "")
}

fn attachments_text(layout: CarrierLayoutObservation) -> String {
  match attachments_of(layout: layout).first() {
    Absent => ""
    Present { value: _ } => join(["Probe attachments: ", join(map(attachments_of(layout: layout), a => attachment_text(s: attachment_standing(layout: layout, a: a))), "; ")], "")
  }
}

fn enable_text(s: ControllerPinStanding) -> String {
  pin_standing_text(s: s, which: EnablePin)
}

fn overvoltage_text(s: ControllerPinStanding) -> String {
  pin_standing_text(s: s, which: OvervoltagePin)
}

fn regulator_pin_text(layout: CarrierLayoutObservation, c: InstalledComponent, ctl: HotSwapControllerSpecification, pin: ControllerPin) -> String {
  let t = controller_pin_terminal(c: c, p: pin)
  let neighbours = neighbour_terminals(c: c, ctl: ctl, pin: pin)
  let joined = concat([t], joined_at_baseline(layout: layout, t: t))
  let readings = readings_at(vs: bench_of(layout: layout), ts: joined)
  let unseparated = filter(readings, o => !terminal_ref_equal(a: o.at, b: t) && !is_access_point(layout: layout, x: o.at, neighbours: neighbours))
  let reported = readings_at(vs: bench_of(layout: layout), ts: filter(reported_zero_to(layout: layout, t: t), x => !any(joined, j => terminal_ref_equal(a: j, b: x))))
  join([
    component_text(c: c.component), " ", pin.name as String, " (pin ", to_string(pin.number), ", internal-regulator output): ",
    match (concat(readings, reported)).first() {
      Absent => "unread"
      Present { value: _ } => join([
        join(map(concat(readings, reported), o => node_voltage_text(o: o)), "; "),
        match unseparated.first() {
          Absent => ""
          Present { value: _ } => join(["; read at a point joined to the pin at the baseline that no reading separates from ", join(map(neighbours, n => terminal_text(t: n)), " and "), ", so not yet the pin's access point"], "")
        },
        match reported.first() {
          Absent => ""
          Present { value: _ } => "; read at a point reported at zero to the pin with no shorted-probe baseline recorded, so not joined to it"
        },
        "; no window is read from it",
      ], "")
    },
  ], "")
}

fn regulator_output_text(layout: CarrierLayoutObservation, c: InstalledComponent) -> String {
  match controller_of(c: c) {
    Absent => ""
    Present { value: ctl } => match (filter(ctl.pins, p => is_regulator_output(p: p))).first() {
      Absent => ""
      Present { value: pin } => regulator_pin_text(layout: layout, c: c, ctl: ctl, pin: pin)
    }
  }
}

fn bench_record_text(layout: CarrierLayoutObservation) -> String {
  match layout.measured {
    Absent => ""
    Present { value: b } => join([
      join(map(b.bench.incidents, i => incident_text(i: i)), ". "),
      match b.bench.resistances.first() {
        Absent => ""
        Present { value: _ } => join([". Unpowered resistance: ", join(map(b.bench.resistances, o => resistance_text(o: o)), "; ")], "")
      },
    ], "")
  }
}

fn phases_reading(layout: CarrierLayoutObservation) -> String {
  match layout.measured {
    Absent => "no carrier phase recorded"
    Present { value: b } => join([phases_text(phases: b.phases, transitions: b.transitions, bias_ceiling: bias_ceiling(b: b), downstream: downstream_terminals(layout: layout)), ". ", pole_closures_text(closures: b.pole_closures, vector: e1_vector_all_on)], "")
  }
}

// ── RENDERING (diagnostics only) ──────────────────────────────────────────────────────────────

fn component_text(c: ComponentInstanceIdentity) -> String {
  component_local_label(c: c) as String
}

fn withstand_kind_text(k: VoltageWithstandKind) -> String {
  match k {
    TvsReverseStandoff => "TVS reverse standoff"
    CapacitorRatedVoltage => "capacitor rated voltage"
    DrainSourceMaximum => "drain-source maximum"
    FuseInterruptRating => "fuse voltage rating"
    RectifierRepetitivePeak => "rectifier peak repetitive reverse"
  }
}

fn row_side_text(s: RowSide) -> String {
  match s {
    SideUnrecorded => "side unrecorded"
    RowRead { row } => match row { LatchRow => "on the latch side", AwayFromLatchRow => "away from the latch" }
  }
}

fn polarity_gap_text(g: PolarityGap) -> String {
  match g {
    SidesUnrecorded => "a contact's side is unrecorded"
    HousingNotMappedWhole => "the housing is not mapped whole and consistently"
    NoMeasuredBoard => "no measured board"
    InputUnmapped => "J20's contacts are not mapped on this board"
    BeepsNotOfOneState => "the board's beeps are not all of one physical state and module configuration"
    FusedSideNotReached => "not every fused-side contact is read to the fuse"
    ReturnSideNotJoined => "the return-side contacts are not read joined"
    IsolationUnread => "no reading separates the two sides"
  }
}

fn polarity_text(p: InputPolarity) -> String {
  match p {
    PolarityEstablished { fused_side, return_side, fused: _, returns: _, isolation: _ } => join([
      "polarity established ", evidence_grade_text(g: polarity_grade(p: p)), ": fused contacts ", row_side_text(s: fused_side), ", return contacts ", row_side_text(s: return_side),
    ], "")
    PolarityContradicted { readings } => join(["polarity CONTRADICTED (", join(map(readings, o => continuity_text(o: o)), "; "), "): re-read before any connection"], "")
    PolarityUnestablished { gaps } => join(["polarity UNESTABLISHED (", join(map(gaps, g => polarity_gap_text(g: g)), "; "), "): re-read before any connection"], "")
  }
}

fn across_text(s: AcrossInputStanding) -> String {
  match s {
    AcrossInput { component, on_fused, on_return, fused_path: _, return_path: _ } => join([
      component_text(c: component), " across the input ('", terminal_text(t: on_fused), "' on the fused side, '", terminal_text(t: on_return), "' on the return side)",
    ], "")
    AcrossInputContradicted { component, readings } => join([component_text(c: component), " placement CONTRADICTED (", join(map(readings, o => continuity_text(o: o)), "; "), ")"], "")
    AcrossInputUnestablished { component, gap } => join([component_text(c: component), " not placed across the input (", across_gap_text(g: gap), ")"], "")
  }
}

fn observed_rating_text(o: ObservedRating) -> String {
  join([component_text(c: o.component), ": ", to_string(volt_count(v: o.rated.maximum)), " V ", withstand_kind_text(k: o.rated.kind), "; ", across_text(s: o.placement)], "")
}

fn bound_text(b: InputBoundStanding) -> String {
  match b {
    BoundEstablished { bound, equally_limiting, observed: _ } => join([
      "at most ", to_string(volt_count(v: bound.rated.maximum)), " V, limited by ", component_text(c: bound.limiting_component), "'s ", withstand_kind_text(k: bound.rated.kind),
      " (", across_text(s: bound.placement), "; ", evidence_grade_text(g: bound.grade), ")",
      match equally_limiting.first() {
        Absent => ""
        Present { value: _ } => join(["; equally limited by ", join(map(equally_limiting, x => component_text(c: x.limiting_component)), ", ")], "")
      },
    ], "")
    BoundContradicted { contradicted, observed: _ } => join(["bound CONTRADICTED: ", join(map(contradicted, o => observed_rating_text(o: o)), "; ")], "")
    BoundUnestablished { observed } => match observed.first() {
      Absent => "no rated part read, and no input bound"
      Present { value: _ } => join(["no input bound established; observed ratings (", join(map(observed, o => observed_rating_text(o: o)), "; "), ") bound nothing"], "")
    }
  }
}

// The J20 positions the board's census establishes, from its observed inventory (product.p4261.carrier
// observed_inventory): a count only where the census gives one; a partial or refused mapping gives none.
fn j20_position_count(layout: CarrierLayoutObservation) -> Nat? {
  match observed_inventory(census: layout.j20) {
    InventoryByRow { latch_row, away_row } => Present { value: latch_row + away_row }
    InventoryTotalOnly { total } => Present { value: total }
    InventorySidesUnread { latch_row_known, away_row_known, side_unread } => Present { value: latch_row_known + away_row_known + side_unread }
    InventoryInPart { latch_row_at_least: _, away_row_at_least: _, side_unread: _ } => Absent
    InventoryRefused { defect: _ } => Absent
  }
}


// Whether every caliper span is consistent with a pitch, given bounds on the cavity width.

fn fit_word(b: Bool) -> String {
  if b { "fit" } else { "do not fit" }
}


fn observed_inventory_text(i: ObservedInventory) -> String {
  match i {
    InventoryByRow { latch_row, away_row } => join([to_string(latch_row + away_row), " positions mapped, ", to_string(latch_row), " in the latch-side row and ", to_string(away_row), " in the row away from the latch"], "")
    InventoryTotalOnly { total } => join([to_string(total), " positions counted, no row read"], "")
    InventorySidesUnread { latch_row_known, away_row_known, side_unread } => join([to_string(latch_row_known + away_row_known + side_unread), " positions mapped: ", to_string(latch_row_known), " latch-side, ", to_string(away_row_known), " away from the latch, ", to_string(side_unread), " of unread side"], "")
    InventoryInPart { latch_row_at_least, away_row_at_least, side_unread } => join(["mapped in part: at least ", to_string(latch_row_at_least), " latch-side and ", to_string(away_row_at_least), " away from the latch, ", to_string(side_unread), " of unread side"], "")
    InventoryRefused { defect } => match defect {
      TerminalAtTwoCoordinates { terminal } => join(["mapping refused: ", terminal as String, " is placed at two positions"], "")
      TwoTerminalsAtOneCoordinate { side, index } => join(["mapping refused: two terminals at position ", to_string(index), " ", row_side_text(s: side)], "")
    }
  }
}

fn j20_text_of(ctx: J20ObservationContext) -> String {
  match ctx.census {
    CountedFromPhotograph { component: _, positions: n, evidence: _ } => join([to_string(n), " positions counted from a photograph; pin continuity unread", caliper_text(fits: ctx.calipers)], "")
    MappedOnHousing { housing: _ } => join([observed_inventory_text(i: ctx.observed), caliper_text(fits: ctx.calipers)], "")
  }
}

fn j20_text(layout: CarrierLayoutObservation) -> String {
  j20_text_of(ctx: j20_context(layout: layout))
}

// What the board's census says of its revision's reconstructed J20 inventory (product.p4261.evidence).
fn j20_agreement_text(a: InventoryAssessment?) -> String {
  match a {
    Absent => "no reconstructed J20 inventory for this revision"
    Present { value: x } => {
      let claimed = join([to_string(x.claim.latch_row_positions), " and ", to_string(x.claim.away_row_positions)], "")
      match x.outcome {
        InventorySupportedOnSpecimen => join(["this supports the reconstructed ", x.claim.position.revision.revision_code as String, " inventory of ", claimed, " on ", x.asset as String], "")
        InventoryContradicted { observed: _ } => join(["this contradicts the reconstructed ", x.claim.position.revision.revision_code as String, " inventory of ", claimed], "")
        InventoryMissing { gap } => join(["the reconstructed ", x.claim.position.revision.revision_code as String, " inventory of ", claimed, " is not established by it: ", match gap {
          RowSplitUnread => "the rows' split is unread"
          CoverageIncomplete => "the mapping is partial"
          MappingRefused { defect: _ } => "the mapping is refused"
          ReadOnlyOffListing => "it was read only off the seller's listing"
        }], "")
        InventoryNotAttributable { gap: _ } => join(["the reconstructed ", x.claim.position.revision.revision_code as String, " inventory is not attributable to this board's census"], "")
      }
    }
  }
}

// ── NARROW FINDINGS, RENDERED ────────────────────────────────────────────────────────────────
//
// A finding is judged in product.p4261.findings (judge_finding, finding_established); here it is only
// worded. The arm of the rendered result is chosen by finding_established and nothing else, and the
// words come from the judgment handed in, never from another look at the board.
type FindingStanding
  = FindingEstablished { text: String }
  | FindingNotEstablished { reason: String }







// The input switches and controllers this observation identifies, rendered from their standings.
fn input_stage_text(layout: CarrierLayoutObservation) -> String {
  let switches = filter(layout.components, c => match mosfet_of(c: c) {
    Present { value: _ } => true
    Absent => false
  })
  let controllers = filter(layout.components, c => match controller_of(c: c) {
    Present { value: _ } => true
    Absent => false
  })
  let bench = bench_record_text(layout: layout)
  let attached = attachments_text(layout: layout)
  join([
    match switches.first() {
      Absent => "no input switch identified"
      Present { value: _ } => join(map(switches, c => switch_text(s: input_switch_standing(layout: layout, c: c))), ". ")
    },
    match controllers.first() {
      Absent => ""
      Present { value: _ } => join([". ", join(map(controllers, c => join([enable_text(s: controller_enable_standing(layout: layout, c: c)), ". ", overvoltage_text(s: controller_overvoltage_standing(layout: layout, c: c)), ". ", projection_text(p: enable_projection(layout: layout, c: c)), ". ", regulator_output_text(layout: layout, c: c)], "")), ". ")], "")
    },
    if attached == "" { "" } else { join([". ", attached], "") },
    if bench == "" { "" } else { join([". ", bench], "") },
  ], "")
}

// Q300'S LEAD B TOWARD U51: what the pair reads across ranges, derived from the record, never from the
// trace followed by eye. Rendered only where U51 is a component of the observation.

fn carrier_input_reading(layout: CarrierLayoutObservation) -> String {
  join([
    "J20 (", j20_text(layout: layout), "; ", polarity_text(p: input_polarity(layout: layout)), "): ", bound_text(b: input_bound(layout: layout)),
    ". J20 ", input_draw_text(d: input_draw(layout: layout)),
    ". ", input_stage_text(layout: layout),
    ". ", netlist_reading(layout: layout),
    ". ", net_propositions_text(layout: layout),
    ". ", phases_reading(layout: layout),
    ". ", q300_gate_path_reading(layout: layout),
    ". ", u4_configuration_text(layout: layout),
    ". ", u5_2_root_of_trust_text(layout: layout),
    ". ", island_flash_text(layout: layout),
    ". ", j24_text(layout: layout),
    ". ", j68_shape_text(layout: layout),
    ". ", alterations_text(layout: layout),
    ". ", hypotheses_text(),
    ". Which connector carries the module's power is not established. The input voltage contract is unknown: no rail, pin assignment, standby rail or sequence is established",
  ], "")
}

fn sensor_role_text(r: SensorPinRole) -> String {
  match r {
    SerialData { bus: _, open_drain: _ } => "serial data"
    SerialClock { bus: _ } => "serial clock"
    AlertOutput { open_drain: _ } => "alert output"
    GroundReturn => "ground"
    SupplyInput => "supply"
    AddressSelect { bit } => join(["address bit ", to_string(bit)], "")
  }
}

fn is_trace_target(r: SensorPinRole) -> Bool {
  match r {
    SerialData { bus: _, open_drain: _ } => true
    SerialClock { bus: _ } => true
    AlertOutput { open_drain: _ } => true
    GroundReturn => false
    SupplyInput => false
    AddressSelect { bit: _ } => false
  }
}

fn sensor_pins_text(c: InstalledComponent, row: ElectronicComponentRow, marking: MarkingReading) -> List<String> {
  match row.specification {
    TemperatureSensorSpec { sensor } => [join([
      component_text(c: c.component), " ('", marking_text(marking), "') is ", row.ordering_code as String,
      "; trace pins ", join(map(filter(sensor.pins, p => is_trace_target(r: p.role)), p => join([to_string(p.number), " ", p.name as String, " (", sensor_role_text(r: p.role), ")"], "")), ", "),
    ], "")]
    TvsDiodeSpec { tvs: _ } => []
    CapacitorSpec { capacitor: _ } => []
    MosfetSpec { mosfet: _ } => []
    ConnectorSpec { connector: _ } => []
    HotSwapControllerSpec { controller: _ } => []
    ShiftRegisterSpec { register: _ } => []
    LevelTranslatorSpec { translator: _ } => []
    LogicGateSpec { gate: _ } => []
    ProgrammableLogicSpec { logic: _ } => []
    RootOfTrustSpec { root_of_trust: _ } => []
    SerialFlashSpec { flash: _ } => []
    SwitchingRegulatorSpec { regulator: _ } => []
    BusMultiplexerSpec { multiplexer: _ } => []
    UsbHubSpec { hub: _ } => []
    RectifierSpec { rectifier: _ } => []
    ClockFanoutSpec { clock: _ } => []
  }
}

// A part identified as a temperature sensor renders its bus pins as trace targets, from its typed roles.
fn sensor_trace_text(c: InstalledComponent) -> List<String> {
  match c.identification {
    IdentifiedByMarking { row, observation } => sensor_pins_text(c: c, row: row, marking: observation.relied_on)
    MarkingSharedByMakers { rows: _, marking: _ } => []
    MarkingCandidate { row: _, marking: _, discriminator: _ } => []
    RatingPrintedOnBody { rating: _, marking: _ } => []
    ResistanceCodeRead { milliohms: _, marking: _ } => []
    MarkingUnresolved { marking: _, discriminator: _ } => []
    FootprintUnpopulated { evidence: _ } => []
    BodySeenMarkingUnread { evidence: _ } => []
  }
}

fn candidate_text(c: ReceptacleCandidate) -> String {
  match c {
    UsbMicroB => "USB Micro-B"
    UsbSuperSpeedMicroB => "USB 3.0 SuperSpeed Micro-B"
  }
}

fn width_text(w: Micrometer) -> String {
  join([to_string(micrometer_count(m: w)), " um"], "")
}

fn management_io_item_text(o: ManagementIoObservation) -> String {
  match o {
    PinHeader { designator, rows, columns, pin_one_marked, evidence: _ } => join([
      match designator {
        Absent => "a"
        Present { value: d } => d as String
      },
      " ", to_string(rows), " x ", to_string(columns), " pin header", if pin_one_marked { " with a pin-1 mark" } else { "" }, ", function and pinout unread",
    ], "")
    EdgeReceptacle { marking, opening_widths, plug_fit, candidates, evidence: _ } => join([
      "an edge receptacle",
      match marking {
        Absent => ""
        Present { value: m } => join([" marked '", m as String, "'"], "")
      },
      match opening_widths.first() {
        Absent => ""
        Present { value: _ } => join([" with openings of about ", join(map(opening_widths, w => width_text(w: w)), " and ")], "")
      },
      match plug_fit {
        MicroUsbPlugFits => ", into which a micro-USB plug fits"
        PlugFitUntried => ""
      },
      "; candidate families ", join(map(candidates, c => candidate_text(c: c)), ", "), " (part number, protocol and role unestablished)",
    ], "")
    FlatCableConnectors { count: n, evidence: _ } => join([to_string(n), " thin flat-cable connectors, function unread"], "")
  }
}

fn assembly_revision_text(s: AssemblyRevisionStanding) -> String {
  match s {
    RevisionReadOnBoard { revision: r } =>
      join(["NVIDIA assembly revision ", r.revision_code as String, " (", r.assembly_part_number as String, ", PCB ", r.pcb_code as String, "), as its own label and PCB print read; no NVIDIA source names it"], "")
    RevisionLabelReadPcbUnread { revision: r } =>
      join(["NVIDIA assembly revision ", r.revision_code as String, " (", r.assembly_part_number as String, "), as its own label reads; its PCB print is unread; no NVIDIA source names it"], "")
    RevisionPcbReadLabelUnread { revision: r } =>
      join(["recorded as NVIDIA assembly revision ", r.revision_code as String, ", whose PCB ", r.pcb_code as String, " its own PCB print reads; its assembly label is unread; no NVIDIA source names it"], "")
    RevisionContradictedOnBoard { revision: r, marking: _ } =>
      join(["recorded as NVIDIA assembly revision ", r.revision_code as String, " (", r.assembly_part_number as String, ", PCB ", r.pcb_code as String, "), which its own label or PCB print CONTRADICTS"], "")
    RevisionUnreadOnBoard { revision: r } =>
      join(["recorded as NVIDIA assembly revision ", r.revision_code as String, ", unread on the board itself"], "")
  }
}

fn carrier_label_text(layout: CarrierLayoutObservation) -> String {
  let texts = flat_map(received_labels(layout: layout), m => match m {
    AssemblyLabel { model, part_number, revision, serial, evidence: _ } =>
      [join([model as String, " ", part_number as String, " rev ", revision as String, ", S/N ", serial as String], "")]
    _ => []
  })
  let revision = assembly_revision_text(s: assembly_revision_standing(layout: layout))
  match texts.first() {
    Absent => join(["a carrier whose label is unread on the received unit; ", revision], "")
    Present { value: _ } => join([join(texts, "; "), "; ", revision], "")
  }
}

fn carrier_model_text(layout: CarrierLayoutObservation) -> String {
  let models = flat_map(received_labels(layout: layout), m => match m {
    AssemblyLabel { model, part_number: _, revision: _, serial: _, evidence: _ } => [model as String]
    _ => []
  })
  match models.first() {
    Absent => "unlabelled"
    Present { value: m } => m
  }
}

fn management_io_text(layout: CarrierLayoutObservation) -> String {
  let items = join(map(layout.management_io, o => management_io_item_text(o: o)), "; ")
  let io = match layout.management_io_survey {
    WholeBoardPhotographed => match layout.management_io.first() {
      Absent => "the photographed P4261 shows no RJ45, USB, video, console header or coin cell"
      Present { value: _ } => join(["the photographed P4261 shows no RJ45, video or coin cell; it shows ", items], "")
    }
    PartlyPhotographed { not_covered } => match layout.management_io.first() {
      Absent => join(["this P4261's management I/O is unsurveyed: ", not_covered as String], "")
      Present { value: _ } => join(["this P4261 is partly photographed, so no absence of management I/O is established (", not_covered as String, "); it shows ", items], "")
    }
  }
  let sensors = flat_map(layout.components, c => sensor_trace_text(c: c))
  match sensors.first() {
    Absent => io
    Present { value: _ } => join([io, ". Identified management-bus parts: ", join(sensors, "; ")], "")
  }
}

fn family_spec_text(row: ElectronicComponentRow) -> String {
  match row.specification {
    ConnectorSpec { connector } => join([" (", connector.series as String, ", ", to_string(connector.positions), " positions)"], "")
    TvsDiodeSpec { tvs: _ } => ""
    RectifierSpec { rectifier: _ } => ""
    CapacitorSpec { capacitor: _ } => ""
    MosfetSpec { mosfet: _ } => ""
    TemperatureSensorSpec { sensor: _ } => ""
    HotSwapControllerSpec { controller: _ } => ""
    ShiftRegisterSpec { register: _ } => ""
    LevelTranslatorSpec { translator: _ } => ""
    LogicGateSpec { gate: _ } => ""
    ProgrammableLogicSpec { logic: _ } => ""
    RootOfTrustSpec { root_of_trust: _ } => ""
    SerialFlashSpec { flash: _ } => ""
    SwitchingRegulatorSpec { regulator } => join([" (synchronous step-down converter, ", millivolt_text(n: millivolt_count(v: regulator.input.minimum)), " to ", millivolt_text(n: millivolt_count(v: regulator.input.maximum)), " in, ", to_string(ampere_count(a: regulator.continuous_output_current)), " A, ", to_string(count(regulator.pins)), " pins)"], "")
    BusMultiplexerSpec { multiplexer } => join([" (bus multiplexer, ", to_string(multiplexer.channels), " channels of ", to_string(multiplexer.inputs_per_channel), ")"], "")
    UsbHubSpec { hub } => join([" (USB hub, ", to_string(hub.downstream_ports), " downstream ports, ", hub.generation as String, ", ", to_string(hub.upstream_ports), " upstream)"], "")
    ClockFanoutSpec { clock } => join([" (clock fan-out, ", to_string(clock.inputs), " inputs, ", to_string(clock.outputs), " outputs)"], "")
  }
}

fn read_on_text(r: ReadOnUnit) -> String {
  match r {
    ReadOnAsset { asset } => asset as String
    UnitUnrecorded => "one of the operator's two carriers, which one unrecorded"
  }
}

fn edge_connector_text(layout: CarrierLayoutObservation) -> String {
  match layout.edge_high_speed_connectors {
    CensusComplete { count: n, family } => join([to_string(n), " ", family.ordering_code as String, " connectors"], "")
    CensusPartial { counted_at_least: n, designators_read, family_candidate, obligation } => join([
      "at least ", to_string(n), " cabled high-speed connectors",
      match designators_read.first() {
        Absent => ""
        Present { value: _ } => join([" (", join(map(designators_read, d => d as String), ", "), " read)"], "")
      },
      " (", obligation as String, ")",
      match family_candidate {
        Absent => ""
        // fc.marking is a CensusPartial text (carrier.dag:250), not a MarkingReading: this candidate carries
        // what was written, not a reading with content, so it renders as it stands.
        Present { value: fc } => join(["; family candidate ", fc.row.ordering_code as String, family_spec_text(row: fc.row), ", marking '", fc.marking as String, "' read on ", read_on_text(r: fc.read_on)], "")
      },
    ], "")
  }
}

// ── THE E1 AGAINST THE K1 (product.p4261.comparison), RENDERED ──────────────────────────────────
// Rendering only: every word below is read off the comparison's typed result, and no finding reads it.

fn comparison_rows_text(rows: List<ElectronicComponentRow>) -> String {
  join(map(rows, r => join([r.vendor.legal_name as String, " ", r.ordering_code as String], "")), " or ")
}

fn comparison_conclusion_text(c: ObservedRelation) -> String {
  match c {
    SameIdentifiedPart { row } => join(["both read ", comparison_rows_text(rows: [row])], "")
    DifferentParts { e1, k1 } => join(["different parts: the E1 reads ", comparison_rows_text(rows: e1), ", the K1 ", comparison_rows_text(rows: k1)], "")
    SameCandidateConstraint { rows } => join(["both read a code shared by ", comparison_rows_text(rows: rows), ", which does not make the fitted parts the same"], "")
    DifferenceUndetermined { e1, k1 } => join(["undetermined: the E1 reads ", comparison_rows_text(rows: e1), ", the K1 ", comparison_rows_text(rows: k1)], "")
    ComparisonIncomplete { boards } => join(["incomplete: no part row established as received on ", join(map(boards, b => b as String), " or ")], "")
    BoardReadingsDisagree { asset, observations } => join([asset as String, "'s own ", to_string(count(observations)), " readings there disagree"], "")
  }
}

fn population_outcome_text(o: PopulationOutcome) -> String {
  match o {
    SupportedOnSpecimen { supporting: _ } => "supported on this board"
    EvidenceMissing { undecided: _ } => "not established by this board's readings"
    Contradicted { contradicting: _, supporting: _ } => "contradicted by this board's readings"
    ObservationsConflict { observations: _ } => "undecidable: this board's own readings there disagree"
    NotAttributable { gap: _ } => "not attributable to this board"
  }
}

fn installation_snapshot_text(i: InstallationSnapshot) -> String {
  match i {
    RemovedBy { key } => join(["now removed (", key as String, ")"], "")
    RemovalRefitIndistinguishable => "removed and refitted in one recorded event, so its state since is not distinguishable"
    SeenWithNoLaterRemoval => "seen fitted, no removal recorded since"
    SeenAbsent => "seen absent"
    InstallationUnknown => "presence unrecorded"
  }
}

fn compared_side_text(s: ComparedSide) -> String {
  let claim = match s.assessment {
    Absent => "no population claim"
    Present { value: a } => join(["reconstructed claim ", population_outcome_text(o: a.outcome)], "")
  }
  join([s.asset as String, ": ", claim, ", ", installation_snapshot_text(i: s.installation)], "")
}

fn population_comparison_text(c: P4261Comparison) -> String {
  join([
    "at the designators both revisions' silkscreens carry (a shared label, not an established circuit correspondence): ",
    join(map(c.positions, p => join([designator_text(designator: p.designator) as String, " as received ", comparison_conclusion_text(c: p.observed), " (", compared_side_text(s: p.e1), "; ", compared_side_text(s: p.k1), ")"], "")), "; "),
    ". Not covered: ", to_string(count(c.e1.uncovered)), " components observed on ", c.e1.asset as String, " and ", to_string(count(c.k1.uncovered)), " on ", c.k1.asset as String,
    " have no admitted designator reading, and ", to_string(count(c.e1.refused) + count(c.k1.refused)), " readings were refused",
  ], "")
}

// ── FORMATTERS OF READINGS THE REPORT USED TO INTERPRET ITSELF (product.p4261.readings, Stage B4) ──

fn caliper_text(fits: List<PitchFit>) -> String {
  match fits.first() {
    Absent => ""
    Present { value: _ } => join([
      "; caliper spans ",
      join(map(fits, f => join([if f.fits { "fit" } else { "do not fit" }, " a ", to_string(micrometer_count(m: f.pitch) / 1000), ".", to_string((micrometer_count(m: f.pitch) % 1000) / 100), " mm pitch"], "")), " and "),
      ", for a cavity of 2.0 to 2.6 mm",
    ], "")
  }
}

fn j24_text(layout: CarrierLayoutObservation) -> String {
  match j24_reading(layout: layout) {
    J24NotObserved => join([component_text(c: e1_j24), " is not a component of this carrier's observation"], "")
    J24Unmeasured { positions } => join(["J24 has ", to_string(positions), " positions and no reading"], "")
    J24Read { reading: r } => j24_text_of(r: r)
  }
}

fn j24_text_of(r: J24Reading) -> String {
  join([
      "J24 has ", to_string(r.positions), " positions, one keyed (A3's mating cavity is plugged; its board-side contact was read at the housing base), at about ", to_string(e1_j24_pitch.along_row_tenths_mm), "/10 mm along a row and ", to_string(e1_j24_pitch.between_rows_tenths_mm), "/10 mm between rows, within ", to_string(e1_j24_pitch.tolerance_tenths_mm), "/10 mm, by a photograph against a tape aligned to neither axis; ",
      to_string(r.readings), " readings recorded to J20's black lead, covering ", to_string(r.positions_read), " of the ", to_string(r.positions), " positions; ", to_string(r.valued), " with a value (", match r.least_positive { Absent => "none above zero", Present { value: o } => join([to_string(ohm_count(r: o)), " ohm the least"], "") }, "), ",
      to_string(r.reported_zero), " reporting zero without a baseline, ", to_string(r.at_baseline), " recorded at the probe baseline",
    ], "")
}

fn j68_shape_text_of(shape: J68Shape) -> String {
  join([
    "J68 unpowered: ", to_string(count(shape.read)), " positions read to J20's black lead; ", to_string(count(shape.reported_zero)), " report zero without a baseline (", join(map(shape.reported_zero, o => terminal_text(t: o.first)), ", "), "), ", to_string(count(shape.over_range)), " over range (", join(map(shape.over_range, o => terminal_text(t: o.first)), ", "), ")",
    "; L3 and L5 ", if shape.l3_l5_alike { "read alike" } else { "do not read alike" },
    ": the shape of Intel's ten-pin JTAG layout with L as the odd pins and R the even, a candidate the powered re-read decides",
  ], "")
}

fn j68_shape_text(layout: CarrierLayoutObservation) -> String {
  match j68_reading(layout: layout) {
    J68Unmeasured => "J68 has no unpowered reading"
    J68Read { shape, jtag } => join([j68_shape_text_of(shape: shape), ". J68 as a JTAG header is ", jtag_standing_text(s: jtag), "; under the candidate map R2 is the reference rail and R1, R5 the returns, so no bridge is placed between any two of its positions again"], "")
  }
}

fn pin_basis(candidate: Bool) -> String {
  if candidate { "under the candidate pinout, " } else { "" }
}

fn gate_pin_text_of(c: ComponentInstanceIdentity, number: Nat, r: PinRoleReading<GatePinStanding>) -> String {
  match r {
    PinComponentAbsent => join([component_text(c: c), " is not a component of this carrier's observation"], "")
    PinNoRowOfKind => join([component_text(c: c), " carries no logic-gate row, so its pin ", to_string(number), " has no role to read"], "")
    PinRole { standing, candidate } => match standing {
      GateInputPin { pin } => join([pin_basis(candidate: candidate), component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is an input the gate reads"], "")
      GateOutputPin { pin } => join([pin_basis(candidate: candidate), component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is its output, the AND of its inputs"], "")
      GateSupplyOrReturn { pin } => join([pin_basis(candidate: candidate), component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is its supply or return"], "")
      NoGatePinNumbered { number: n } => join([component_text(c: c), " has no pin ", to_string(n)], "")
    }
  }
}

fn translator_pin_text_of(c: ComponentInstanceIdentity, number: Nat, r: PinRoleReading<TranslatorPinStanding>) -> String {
  match r {
    PinComponentAbsent => join([component_text(c: c), " is not a component of this carrier's observation"], "")
    PinNoRowOfKind => join([component_text(c: c), " carries no level-translator row, so its pin ", to_string(number), " has no role to read"], "")
    PinRole { standing, candidate } => match standing {
      DataPortOfChannel { pin, channel, b_side } => join([pin_basis(candidate: candidate), component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is the ", if b_side { "B" } else { "A" }, " end of channel ", to_string(channel), ": a data port whose direction is that channel's direction input, a live fact"], "")
      ControlIntoTheTranslator { pin } => join([pin_basis(candidate: candidate), component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is a direction or enable input into the part"], "")
      TranslatorSupplyOrReturn { pin } => join([pin_basis(candidate: candidate), component_text(c: c), " pin ", to_string(number), " (", pin.name as String, ") is its supply or return"], "")
      NoTranslatorPinNumbered { number: n } => join([component_text(c: c), " has no pin ", to_string(n)], "")
    }
  }
}

fn q300_gate_path_reading(layout: CarrierLayoutObservation) -> String {
  match q300_gate_path(layout: layout) {
    Q300U51NotObserved => join([component_text(c: e1_u51), " is not a component of this carrier's observation"], "")
    Q300Unmeasured => "no reading from Q300 lead b toward U51"
    Q300PathRead { path: q } => join([
      "Q300 lead b to U51 pin 8 ", pair_range_text(s: q.to_u51_pin8),
      "; Q300 lead b to J20's black lead ", pair_range_text(s: q.to_return),
      "; no U51 pin is read as Q300 lead b's node. On the front, ", to_string(count(q.u500_at_most_500)), " of U500's contacts read at or below 500 ohm from Q300 lead b on the 2k range (", join(map(q.u500_at_most_500, n => n as String), ", "), "), against 800 ohm to its ground contact and to the via beside the U43 chain; the pad above U500 to J20's black lead ", pair_polarity_text(s: q.pad_to_return, a: e1_u500_pad, b: e1_ground_ref), "; Q300 lead b to that pad ", pair_polarity_text(s: q.lead_to_pad, a: e1_q300_lead_b, b: e1_u500_pad), ". Of U55's pins, ", to_string(count(q.u55_at_most_500)), " read at or below 500 ohm from Q300 lead b on the 2k range (", join(map(q.u55_at_most_500, n => n as String), ", "), "). ", gate_pin_text_of(c: e1_u43, number: 4, r: q.u43_pin4), "; ", translator_pin_text_of(c: e1_u55, number: 13, r: q.u55_pin13), "; ", translator_pin_text_of(c: e1_u55, number: 16, r: q.u55_pin16), "; ", translator_pin_text_of(c: e1_u55, number: 12, r: q.u55_pin12),
    ], "")
  }
}

fn recount_gap_text(gap: RecountGap) -> String {
  match gap {
    RecountNotAMapping => "J20 is only counted, its rows unmapped"
    RecountNotAtAdmittedJ20 => "the mapping is not of a component admitted at this board's J20"
    RecountReadOffListing => "the mapping was read only off the seller's listing"
    RecountInPart => "J20 is mapped only in part"
    RecountSidesUnread => "a mapped position's row is unread"
    RecountRefused { defect: _ } => "J20's mapping is refused"
  }
}

fn identification_said(x: InstalledComponent) -> String {
  match identification_text(i: x.identification) {
    Absent => "nothing read on it identifies a part"
    Present { value: t } => t
  }
}

// The words of one judgment: what an established finding says, or why it is not established. Which of
// the two it is, the caller takes from finding_established.
fn judgment_words(j: FindingJudgment, established: Bool) -> String {
  match j {
    J20InventoryJudged { recount, agreement, context } => match recount {
      RecountEstablished { latch_row: _, away_row: _ } => join(["J20: ", j20_text_of(ctx: context), ". ", j20_agreement_text(a: agreement)], "")
      RecountNotEstablished { gap, observed: _ } => join([recount_gap_text(gap: gap), ": ", j20_text_of(ctx: context)], "")
    }
    J20AgreementJudged { agreement, context } => match agreement {
      Absent => join([j20_agreement_text(a: Absent), "; J20: ", j20_text_of(ctx: context)], "")
      Present { value: _ } => join(["J20: ", j20_text_of(ctx: context), "; ", j20_agreement_text(a: agreement)], "")
    }
    PolarityJudged { polarity } => if established { join(["J20 ", polarity_text(p: polarity)], "") } else { polarity_text(p: polarity) }
    AcrossJudged { standing } => across_text(s: standing)
    IdentificationJudged { observed } => if established { join([component_text(c: observed.component), " is ", identification_said(x: observed)], "") } else { join([component_text(c: observed.component), " is not identified: ", identification_said(x: observed)], "") }
    BoundJudged { bound } => if established { join(["J20 input ", bound_text(b: bound)], "") } else { bound_text(b: bound) }
    DrawJudged { draw } => if established { join(["J20 ", input_draw_text(d: draw)], "") } else { input_draw_text(d: draw) }
    SwitchJudged { standing } => switch_text(s: standing)
    EnableJudged { standing } => enable_text(s: standing)
    OvervoltageJudged { standing } => overvoltage_text(s: standing)
    ProjectionJudged { projection } => projection_text(p: projection)
    PhaseJudged { key, standing } => match standing {
      Absent => join(["no phase '", key as String, "' is recorded on this carrier"], "")
      Present { value: x } => phase_standing_text(s: x)
    }
    BusJudged { key, standing } => match standing {
      Absent => join(["no phase '", key as String, "' is recorded on this carrier"], "")
      Present { value: x } => protected_bus_text(s: x)
    }
    NotAComponent { component } => join([component_text(c: component), " is not a component of this carrier's observation"], "")
    // The census, in the sheet's own words: how many readings the carrier carries, how many can be
    // re-read from bytes the store holds, and what is owed. Broken rows are NAMED, because each is a defect
    // with a designator on it and a reader has to be able to go fix it; the rows awaiting bytes are counted
    // here and named by product.p4261.evidence's `gap_groundings`, which is the worklist. Naming 94
    // designators inside a dossier sentence would bury the one number the reader needs.
    ImageReadingsJudged { grounding } => match grounding {
      // The census in the sheet's own words. Broken rows are NAMED, each with the reason
      // product.electrical.photograph's `citation_explanation` gives for it -- a row can be broken because
      // the store holds nothing under its digest OR because the frame is our own drawing, and saying "names
      // bytes the store does not hold" about the second would be a false report about our own file. The rows
      // awaiting bytes are counted here and listed by product.p4261.evidence's `gap_groundings`, which is
      // the worklist. Naming every designator inside a dossier sentence would bury the one number the
      // reader needs.
      FromStore { read, checkable, broken, gaps } => join([
        to_string(read), " image-readings on this carrier: ", to_string(checkable), " rest on frames we hold for it; ",
        to_string(count(broken)), " cannot carry a reading", grounding_row_names(gs: broken), "; ",
        to_string(count(gaps)), " were read off frames whose bytes never reached the store",
        if count(gaps) == 0 { "" } else { "; they are listed by product.p4261.evidence.gap_groundings" }], "")
      // A different absence, said plainly: this carrier has never been photographed into a store, so no
      // reading on it is image-checkable and no number would say so. The obligation travels with it.
      NoPhotographStore { board, obligation } => join([
        "no photograph store is held for '", (board as String), "': no image-reading on this carrier is checkable. ",
        (obligation as String)], "")
      // Named, not filtered: the store row disagrees with itself about which board it pictures, so nothing
      // in it grounds this carrier. The foreign digests are printed because the fix is to correct those rows.
      StoreHoldsAnotherBoardsFrames { board, foreign } => join([
        "the photograph store held for '", (board as String), "' carries ", to_string(count(foreign)),
        " frame(s) attributed to another board (", foreign_frame_digests(rows: foreign),
        "); nothing in it is taken as grounding for this carrier until those store rows are corrected"], "")
    }
    NetPropositionJudged { key, assessment } => match assessment {
      Absent => join(["no reconstructed wiring proposition '", key as String, "'"], "")
      Present { value: a } => net_assessment_text(a: a)
    }
  }
}

// The designators behind broken rows, each with why its citation cannot carry the reading -- the digest to
// go look up, or the fact that the frame is our own drawing. product.electrical.photograph's
// `citation_explanation` writes that reason so that no consumer reaches into a standing for it. Empty when
// there are none, so a clean census reads as a sentence and not as a sentence with an empty bracket on it.
// The digests of frames a store row carries that belong to no board it names, so the sheet can point at the
// exact rows to fix rather than at a count.
fn foreign_frame_digests(rows: List<Photograph>) -> String {
  join(map(rows, f => f.content.hex as String), ", ")
}

fn grounding_row_names(gs: List<ReadingGrounding>) -> String {
  if count(gs) == 0 { "" } else { join([" (", join(map(gs, g => join([g.read_of as String, ": ", citation_explanation(standing: g.standing)], "")), ", "), ")"], "") }
}

fn render_finding(j: FindingJudgment) -> FindingStanding {
  if finding_established(j: j) { FindingEstablished { text: judgment_words(j: j, established: true) } } else { FindingNotEstablished { reason: judgment_words(j: j, established: false) } }
}

fn carrier_finding(layout: CarrierLayoutObservation, f: CarrierFinding) -> FindingStanding {
  render_finding(j: judge_finding(layout: layout, f: f))
}

// Public compositions of a typed reading and its formatter, for consumers that hold a layout.
fn gate_pin_text(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity, number: Nat) -> String {
  gate_pin_text_of(c: c, number: number, r: gate_pin_reading(layout: layout, c: c, number: number))
}

fn translator_pin_text(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity, number: Nat) -> String {
  translator_pin_text_of(c: c, number: number, r: translator_pin_reading(layout: layout, c: c, number: number))
}

fn j68_shape_from(all: List<ResistanceObservation>) -> String {
  j68_shape_text_of(shape: j68_shape(all: all))
}

// ── WIRING PROPOSITIONS ON THIS BOARD (product.p4261.evidence assess_net_proposition), RENDERED ─────

fn across_gap_text(g: AcrossGap) -> String {
  match g {
    InputPolarityNotEstablished => "the input polarity is not established"
    NotTwoTerminals => "not a two-terminal part"
    TerminalsNotPlaced => "its terminals are not read to the two sides"
  }
}

fn net_gap_text(g: NetGap) -> String {
  match g {
    OccupantNotPresentInState => "no part present at the position in that state"
    ConnectorNotMappedWhole => "the connector is not mapped whole"
    RowContactNotReached => "no terminal of the part is reached by every position of the row"
    InputClassesNotEstablished => "the input's two row classes are not established"
    PartNotPlaced { gap } => across_gap_text(g: gap)
  }
}

fn net_state_outcome_text(o: NetStateOutcome) -> String {
  match o {
    NetSupported { terminals, readings: _ } => join(["supported at ", join(map(terminals, t => terminal_text(t: t)), " and ")], "")
    NetCounterevidence { terminals, readings: _ } => join(["not so: ", join(map(terminals, t => terminal_text(t: t)), " and "), " both in one class"], "")
    NetEvidenceConflict { readings, occupants } => if count(occupants) > 1 { join([to_string(count(occupants)), " distinct parts present at the position"], "") } else { join(["readings disagree (", to_string(count(readings)), ")"], "") }
    NetUnresolved { gap } => join(["unresolved: ", net_gap_text(g: gap)], "")
  }
}

fn net_state_text(a: NetStateAssessment) -> String {
  join([if count(a.state.after) == 0 { "as received" } else { join(["after ", join(map(a.state.after, k => k as String), ", ")], "") }, ": ", net_state_outcome_text(o: a.outcome)], "")
}

fn net_revision_text(r: NetRevisionOutcome) -> String {
  match r {
    NetRevisionSupported => "supported by this board as received"
    NetRevisionCounterevidence => "contradicted by this board as received"
    NetRevisionConflict => "this board's readings as received disagree"
    NetRevisionUnresolved => "not established by this board as received"
    NetRevisionNotAttributable { gap: _ } => "not attributable to this board"
  }
}

fn net_assessment_text(a: NetPropositionAssessment) -> String {
  join([a.proposition.key as String, " (reconstructed, ", net_revision_text(r: a.revision), "; ", join(map(a.states, s => net_state_text(a: s)), "; "), ")"], "")
}

fn net_propositions_text(layout: CarrierLayoutObservation) -> String {
  let assessed = flat_map(p4261_net_propositions, p => match net_assessment(layout: layout, key: p.key) { Absent => no_net_assessments(), Present { value: a } => [a] })
  let applicable = filter(assessed, a => match a.revision { NetRevisionNotAttributable { gap: _ } => false, _ => true })
  match applicable.first() {
    Absent => "no reconstructed wiring proposition applies to this board"
    Present { value: _ } => join(["Reconstructed wiring propositions (low-impedance reachability, not copper identity): ", join(map(applicable, a => net_assessment_text(a: a)), "; ")], "")
  }
}

fn no_net_assessments() -> List<NetPropositionAssessment> {
  []
}

// OUR HYPOTHESES (product.p4261.investigation), each with what it is about and the typed wiring
// propositions it argues about. They are hypotheses, not derivations; nothing reads their prose.
fn hypothesis_class_text(c: HypothesisClass) -> String {
  match c {
    DesignRelationRemainder { positions } => if count(positions) == 0 { "about the board's design, not yet modeled" } else { join(["about the board's design at ", join(map(positions, p => designator_text(designator: p.designator) as String), ", "), ", not yet modeled"], "") }
    SpecimenDiagnostic { asset } => join(["about ", asset as String, " as we hold it"], "")
    DesignAndSpecimen { positions, asset } => join(["about the board's design at ", join(map(positions, p => designator_text(designator: p.designator) as String), ", "), " and about ", asset as String, " as we hold it"], "")
  }
}

fn classified_hypothesis_text(h: ClassifiedHypothesis) -> String {
  join([hypothesis_text(h: h.hypothesis), " [", hypothesis_class_text(c: h.class), if count(h.concerns) == 0 { "" } else { join(["; argues about ", join(map(h.concerns, k => k as String), ", ")], "") }, "]"], "")
}

fn hypotheses_text() -> String {
  join(map(p4261_hypotheses, h => classified_hypothesis_text(h: h)), ". ")
}
