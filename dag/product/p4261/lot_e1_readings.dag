  on_s(first: r_pin(n: "pin 1"), second: r_pin(n: "pin 2"), record: both_on_r, polarity: RedOnSecond, display: about(ohms: 16000000), stability: StabilityUnrecorded, said: [s_transistors_said]),
  on_s(first: l_pin(n: "tab"), second: l_pin(n: "pin 2"), record: both_points_recorded, polarity: RedOnFirst, display: about(ohms: 25000), stability: StabilityUnrecorded, said: [s_transistors_said]),
  on_s(first: l_pin(n: "tab"), second: l_pin(n: "pin 2"), record: both_points_recorded, polarity: RedOnSecond, display: about(ohms: 25000), stability: StabilityUnrecorded, said: [s_transistors_said]),
