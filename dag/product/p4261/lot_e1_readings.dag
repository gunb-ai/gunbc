  on_s(first: e1_f300_one, second: e1_f300_other, record: both_points_recorded, polarity: PolarityUnrecorded, display: at_probe_level(shown: ".6ohm"), stability: StabilityUnrecorded, said: [s_fuses_said]),
]

// The underside parts A and B, late on 2026-11-14. The operator numbered the answers 1 to 4 in the order the
// four readings were asked (A1 to A2, B1 to B2, A1 to B1, A2 to B2) and gave the gate leads as a fifth; the
// probes-together value asked for first was not given. That order is also the only one the operator's '148
// is the same but, B1 -> B2 seems open' allows, since it makes this board's B1 to B2 something other than
// open. 'ohm' was typed on the second and fourth answers, and the first is taken in ohms too. 5.8 ohm is
// held as about 6, an ohm count; the figures as given are in the statement. 'Goes to' is kept as the
// operator's words with no figure, so in the netlist it is a link and joins nothing
// (product.electrical.measured_netlist).
data lot_e1_s218_gate_part_resistances: List<ResistanceObservation> = [
  on_s(first: gate_a_1, second: gate_a_2, record: both_points_recorded, polarity: PolarityUnrecorded, display: about(ohms: 6), stability: StabilityUnrecorded, said: [s_gate_parts_said, gate_parts_labels_said, gate_parts_photo]),
  on_s(first: gate_b_1, second: gate_b_2, record: both_points_recorded, polarity: PolarityUnrecorded, display: about(ohms: 6), stability: StabilityUnrecorded, said: [s_gate_parts_said, gate_parts_labels_said, gate_parts_photo]),
  on_s(first: gate_a_1, second: gate_b_1, record: both_points_recorded, polarity: PolarityUnrecorded, display: DisplayOverRange, stability: StabilityUnrecorded, said: [s_gate_parts_said, gate_parts_labels_said, gate_parts_photo]),
  on_s(first: gate_a_2, second: gate_b_2, record: both_points_recorded, polarity: PolarityUnrecorded, display: shown(ohms: 12), stability: StabilityUnrecorded, said: [s_gate_parts_said, gate_parts_labels_said, gate_parts_photo]),
  on_s(first: l_pin(n: "pin 1"), second: gate_a_2, record: both_points_recorded, polarity: PolarityUnrecorded, display: at_probe_level(shown: "goes to"), stability: StabilityUnrecorded, said: [s_gate_parts_said, gate_parts_labels_said]),
  on_s(first: l_pin(n: "pin 1"), second: gate_b_2, record: both_points_recorded, polarity: PolarityUnrecorded, display: DisplayOverRange, stability: StabilityUnrecorded, said: [s_gate_parts_said, gate_parts_labels_said]),
  on_s(first: r_pin(n: "pin 1"), second: gate_b_2, record: first_on_r, polarity: PolarityUnrecorded, display: at_probe_level(shown: "goes to"), stability: StabilityUnrecorded, said: [s_gate_parts_said, gate_parts_labels_said]),
  on_s(first: r_pin(n: "pin 1"), second: gate_a_2, record: first_on_r, polarity: PolarityUnrecorded, display: DisplayOverRange, stability: StabilityUnrecorded, said: [s_gate_parts_said, gate_parts_labels_said]),
]

// WHAT THESE READINGS CANNOT ALL BE. Every point here is joined by passive copper and parts, where no
// path reads more than two paths that meet add to, so three groups of readings cannot all hold. They are
// owed again figure by figure before any is built on, and nothing here says which is wrong. On S/N
// 1583323120218, L's gate goes to A2 and A2 reads 12 ohm to B2, which puts L's gate within about 12 ohm
// of B2, yet L's gate reads open to B2 (and R's gate to A2 likewise). On both boards A1 reads open to B1
// although the photograph shows the long trace running between them, and on S/N 1583323120218 the 12 ohm
// from A2 to B2 is about A's 5.8 and B's 5.8 in series, which is what a path through both parts and a
// whole trace reads, near the 10 ohm read between the gates earlier that evening. On S/N 1583323120148,
// 'the same' would put 12 ohm between A2 and B2 with each gate going to its own end 2, yet its gates read
// open to each other three times after the attempt (the leg check of 2026-11-13 and check A both ways),
// and with B open no path through both parts reads 12 ohm. Since then, with B off S/N 1583323120148, B1's
// bare pad reads at the probes' level to A1: on that board the trace does join the two end 1s, so the open
// read between A1 and B1 there was not the trace, and on S/N 1583323120218 it is owed again. Part B open on
// S/N 1583323120148 also does not
// account for L's gate reading 700 ohm one way and 31 kohm the other to its source there (the reviewer,
// 2026-11-14), which stays a question of its own.

data lot_e1_s218_diodes: List<DiodeModeObservation> = [
  diode_s(red: l_pin(n: "pin 1"), black: l_pin(n: "pin 2"), display: OverLimit, said: s_transistors_said),
  diode_s(red: l_pin(n: "pin 2"), black: l_pin(n: "pin 1"), display: mv(millivolts: 1600), said: s_transistors_said),
  diode_s(red: r_pin(n: "pin 1"), black: r_pin(n: "pin 2"), display: OverLimit, said: s_transistors_said),
  diode_s(red: r_pin(n: "pin 2"), black: r_pin(n: "pin 1"), display: mv(millivolts: 1600), said: s_transistors_said),
  diode_s(red: l_pin(n: "tab"), black: l_pin(n: "pin 2"), display: OverLimit, said: s_transistors_said),
  diode_s(red: l_pin(n: "pin 2"), black: l_pin(n: "tab"), display: mv(millivolts: 460), said: s_transistors_said),
  diode_s(red: r_pin(n: "tab"), black: r_pin(n: "pin 2"), display: OverLimit, said: s_transistors_said),
  diode_s(red: r_pin(n: "pin 2"), black: r_pin(n: "tab"), display: mv(millivolts: 460), said: s_transistors_said),
  diode_s(red: e1_q300_lone_lead, black: e1_q300_lead_a, display: mv(millivolts: 1800), said: s_q300_diode_said),
  diode_s(red: e1_q300_lead_a, black: e1_q300_lone_lead, display: mv(millivolts: 451), said: s_q300_diode_said),
  diode_s(red: e1_q300_lone_lead, black: e1_q300_lead_b, display: mv(millivolts: 1900), said: s_q300_diode_said),
  diode_s(red: e1_q300_lead_b, black: e1_q300_lone_lead, display: mv(millivolts: 800), said: s_q300_diode_said),
  diode_s(red: e1_q300_lead_a, black: e1_q300_lead_b, display: mv(millivolts: 400), said: s_q300_diode_said),
  diode_s(red: e1_q300_lead_b, black: e1_q300_lead_a, display: mv(millivolts: 600), said: s_q300_diode_said),
]

data lot_e1_s218_board: MeasuredBoard = MeasuredBoard {
  analysis: AnalysisSelection { after: [], module: ModuleUnrecorded },
  asset: p4261_e1_s1583323120218,
  continuity: [],
  diode_readings: lot_e1_s218_diodes,
  source_draws: [],
  bench: BenchRecord { incidents: [], attachments: [], alterations: [], voltages: [], resistances: concat(lot_e1_s218_resistances, lot_e1_s218_gate_part_resistances) },
  phases: [],
  transitions: [],
  pole_closures: [],
}

// ── PUTTING TWO BOARDS SIDE BY SIDE ─────────────────────────────────────────────────────────────────

// THE GRAIN TWO BOARDS' DISPLAYS ARE COMPARED AT. These are in-circuit readings on an auto-ranging meter,
// taken by hand at different times: each includes every parallel path on its board, and a value that
// keeps rising depends on how long it was held. So two displays agree when both are at the probes' level
// (a few ohms or less), both are beyond what an in-circuit path reads (10 Mohm or more, or over range), or
// both are values within a factor of three of each other; anything else differs, and a display with no
// value recorded compares with nothing. In diode mode a reading under 1000 mV is a junction conducting
// and agrees with another within 150 mV; a reading of 1000 mV or more, still charging as read, or over
// the limit, is no junction conducting. A finer rule would claim precision these readings do not have.
data probe_level_ohms: Nat = 3

data beyond_reach_ohms: Nat = 10000000

data agreement_factor: Nat = 3

data junction_ceiling_millivolts: Nat = 1000

data junction_tolerance_millivolts: Nat = 150

type DisplayMagnitude
  = AtProbeLevel
  | ValueOhms { ohms: Nat }
  | BeyondInCircuitReach
  | ValueUnrecorded

fn display_magnitude(d: ResistanceDisplay) -> DisplayMagnitude {
  match d {
    DisplayZeroWithoutBaseline { reported: _ } => AtProbeLevel
    DisplayAtProbeBaseline { shown: _, baseline: _ } => AtProbeLevel
    DisplayValue { ohms, approximate: _ } => if ohms <= probe_level_ohms { AtProbeLevel } else { if ohms >= beyond_reach_ohms { BeyondInCircuitReach } else { ValueOhms { ohms: ohms } } }
    DisplayOverRange => BeyondInCircuitReach
    DisplayAboveBaseline => ValueUnrecorded
  }
}

type ReadingAgreement
  = DisplaysAgree
  | DisplaysDiffer
  | NotComparable { why: NonEmptyStr }

data no_value_recorded: ReadingAgreement = NotComparable { why: "a display whose value was not recorded compares with nothing" }

fn within_factor(a: Nat, b: Nat) -> Bool {
  a <= b * agreement_factor && b <= a * agreement_factor
}

fn agree_if(same: Bool) -> ReadingAgreement {
  if same { DisplaysAgree } else { DisplaysDiffer }
}

fn magnitude_is_probe_level(m: DisplayMagnitude) -> Bool {
  match m {
    AtProbeLevel => true
    ValueOhms { ohms: _ } => false
    BeyondInCircuitReach => false
    ValueUnrecorded => false
  }
}

fn magnitude_is_beyond(m: DisplayMagnitude) -> Bool {
  match m {
    AtProbeLevel => false
    ValueOhms { ohms: _ } => false
    BeyondInCircuitReach => true
    ValueUnrecorded => false
  }
}

fn magnitude_unrecorded(m: DisplayMagnitude) -> Bool {
  match m {
    AtProbeLevel => false
    ValueOhms { ohms: _ } => false
    BeyondInCircuitReach => false
    ValueUnrecorded => true
  }
}

fn magnitude_value(m: DisplayMagnitude) -> Nat? {
  match m {
    AtProbeLevel => Absent
    ValueOhms { ohms } => Present { value: ohms }
    BeyondInCircuitReach => Absent
    ValueUnrecorded => Absent
  }
}

fn magnitudes_agree(a: DisplayMagnitude, b: DisplayMagnitude) -> ReadingAgreement {
  if magnitude_unrecorded(m: a) || magnitude_unrecorded(m: b) { no_value_recorded } else {
    match magnitude_value(m: a) {
      Present { value: va } => match magnitude_value(m: b) {
        Present { value: vb } => agree_if(same: within_factor(a: va, b: vb))
        Absent => DisplaysDiffer
      }
      Absent => agree_if(same: (magnitude_is_probe_level(m: a) && magnitude_is_probe_level(m: b)) || (magnitude_is_beyond(m: a) && magnitude_is_beyond(m: b)))
    }
  }
}

fn displays_agree(a: ResistanceDisplay, b: ResistanceDisplay) -> ReadingAgreement {
  magnitudes_agree(a: display_magnitude(d: a), b: display_magnitude(d: b))
}

type JunctionReading
  = JunctionConducts { millivolts: Nat }
  | NoJunctionConduction

fn junction_reading(d: DiodeDisplay) -> JunctionReading {
  match d {
    ForwardMillivolts { millivolts } => if millivolts < junction_ceiling_millivolts { JunctionConducts { millivolts: millivolts } } else { NoJunctionConduction }
    OverLimit => NoJunctionConduction
  }
}

fn junction_millivolts(j: JunctionReading) -> Nat? {
  match j {
    JunctionConducts { millivolts } => Present { value: millivolts }
    NoJunctionConduction => Absent
  }
}

fn nat_distance(a: Nat, b: Nat) -> Nat {
  if a >= b { a - b } else { b - a }
}

fn diode_displays_agree(a: DiodeDisplay, b: DiodeDisplay) -> ReadingAgreement {
  match junction_millivolts(j: junction_reading(d: a)) {
    Present { value: ma } => match junction_millivolts(j: junction_reading(d: b)) {
      Present { value: mb } => agree_if(same: nat_distance(a: ma, b: mb) <= junction_tolerance_millivolts)
      Absent => DisplaysDiffer
    }
    Absent => match junction_millivolts(j: junction_reading(d: b)) {
      Present { value: _ } => DisplaysDiffer
      Absent => DisplaysAgree
    }
  }
}

// WHICH READINGS ARE THE SAME READING ON TWO BOARDS: the same two points, and the red probe on the same one
// of them when both readings recorded it. A reading whose probe placement was not recorded stands beside
// either direction.
fn red_point(o: ResistanceObservation) -> ElectricalTerminalRef? {
  match o.polarity {
    RedOnFirst => Present { value: o.first }
    RedOnSecond => Present { value: o.second }
    PolarityUnrecorded => Absent
  }
}

fn same_points(a: ResistanceObservation, b: ResistanceObservation) -> Bool {
  (terminal_ref_equal(a: a.first, b: b.first) && terminal_ref_equal(a: a.second, b: b.second)) || (terminal_ref_equal(a: a.first, b: b.second) && terminal_ref_equal(a: a.second, b: b.first))
}

fn compatible_red(a: ResistanceObservation, b: ResistanceObservation) -> Bool {
  match red_point(o: a) {
    Absent => true
    Present { value: ra } => match red_point(o: b) {
      Absent => true
      Present { value: rb } => terminal_ref_equal(a: ra, b: rb)
    }
  }
}

fn readings_match(a: ResistanceObservation, b: ResistanceObservation) -> Bool {
  same_points(a: a, b: b) && compatible_red(a: a, b: b)
}

fn diode_red(o: DiodeModeObservation) -> ElectricalTerminalRef {
  match o.probes {
    RedBlack { red, black: _ } => red
    ProbesUnrecorded { a, b: _ } => a
  }
}

fn diode_black(o: DiodeModeObservation) -> ElectricalTerminalRef {
  match o.probes {
    RedBlack { red: _, black } => black
    ProbesUnrecorded { a: _, b } => b
  }
}

fn diode_oriented(o: DiodeModeObservation) -> Bool {
  match o.probes {
    RedBlack { red: _, black: _ } => true
    ProbesUnrecorded { a: _, b: _ } => false
  }
}

fn diodes_match(a: DiodeModeObservation, b: DiodeModeObservation) -> Bool {
  let direct = terminal_ref_equal(a: diode_red(o: a), b: diode_red(o: b)) && terminal_ref_equal(a: diode_black(o: a), b: diode_black(o: b))
  let crossed = terminal_ref_equal(a: diode_red(o: a), b: diode_black(o: b)) && terminal_ref_equal(a: diode_black(o: a), b: diode_red(o: b))
  if diode_oriented(o: a) && diode_oriented(o: b) { direct } else { direct || crossed }
}

fn is_differ(a: ReadingAgreement) -> Bool {
  match a {
    DisplaysAgree => false
    DisplaysDiffer => true
    NotComparable { why: _ } => false
  }
}

fn is_not_comparable(a: ReadingAgreement) -> Bool {
  match a {
    DisplaysAgree => false
    DisplaysDiffer => false
    NotComparable { why: _ } => true
  }
}

// A reading compared with every matching reading on the other board: it differs if any of them differs.
fn combined(agreements: List<ReadingAgreement>) -> ReadingAgreement {
  if any(agreements, a => is_differ(a: a)) { DisplaysDiffer } else {
    match filter(agreements, a => is_not_comparable(a: a)).first() {
      Present { value: n } => n
      Absent => DisplaysAgree
    }
  }
}

type ComparedReading {
  altered: ResistanceObservation
  reference: List<ResistanceObservation>
  agreement: ReadingAgreement
}

type ComparedDiodeReading {
  altered: DiodeModeObservation
  reference: List<DiodeModeObservation>
  agreement: ReadingAgreement
}

// The altered board's readings beside the reference board's, in one state of each. Readings with no
// counterpart on the other board are listed apart and compared with nothing.
type BoardsSideBySide {
  altered: BoardState
  reference: BoardState
  resistances: List<ComparedReading>
  diodes: List<ComparedDiodeReading>
  only_on_altered: List<ResistanceObservation>
  only_on_reference: List<ResistanceObservation>
  diodes_only_on_altered: List<DiodeModeObservation>
  diodes_only_on_reference: List<DiodeModeObservation>
  stated_on_altered: List<StatedWithoutFigure>
}

fn compare_one(a: ResistanceObservation, reference: List<ResistanceObservation>) -> ComparedReading {
  let ms = filter(reference, r => readings_match(a: a, b: r))
  ComparedReading { altered: a, reference: ms, agreement: combined(agreements: map(ms, r => displays_agree(a: a.display, b: r.display))) }
}

fn compare_one_diode(a: DiodeModeObservation, reference: List<DiodeModeObservation>) -> ComparedDiodeReading {
  let ms = filter(reference, r => diodes_match(a: a, b: r))
  ComparedDiodeReading { altered: a, reference: ms, agreement: combined(agreements: map(ms, r => diode_displays_agree(a: a.display, b: r.display))) }
}

fn diodes_of(b: MeasuredBoard) -> List<DiodeModeObservation> {
  filter(b.diode_readings, o => physical_asset_identity_eq(a: o.asset, b: b.asset))
}

fn side_by_side(altered: BoardState, reference: BoardState, altered_diodes: List<DiodeModeObservation>, reference_diodes: List<DiodeModeObservation>, stated: List<StatedWithoutFigure>) -> BoardsSideBySide {
  let ar = board_readings(s: altered).resistances
  let rr = board_readings(s: reference).resistances
  BoardsSideBySide {
    altered: altered,
    reference: reference,
    resistances: map(filter(ar, a => any(rr, r => readings_match(a: a, b: r))), a => compare_one(a: a, reference: rr)),
    diodes: map(filter(altered_diodes, a => any(reference_diodes, r => diodes_match(a: a, b: r))), a => compare_one_diode(a: a, reference: reference_diodes)),
    only_on_altered: filter(ar, a => !any(rr, r => readings_match(a: a, b: r))),
    only_on_reference: filter(rr, r => !any(ar, a => readings_match(a: a, b: r))),
    diodes_only_on_altered: filter(altered_diodes, a => !any(reference_diodes, r => diodes_match(a: a, b: r))),
    diodes_only_on_reference: filter(reference_diodes, r => !any(altered_diodes, a => diodes_match(a: a, b: r))),
    stated_on_altered: filter(stated, s => physical_asset_identity_eq(a: s.asset, b: altered.board.asset)),
  }
}

// S/N 1583323120148 after both of its events, beside S/N 1583323120218 untouched. Absent if the altered
// board's state does not resolve against its own record.
fn lot_e1_side_by_side() -> BoardsSideBySide? {
  match board_after(b: lot_e1_c_board, keys: lot_e1_c_after_both, module: ModuleRemoved) {
    Absent => Absent
    Present { value: altered } => Present {
      value: side_by_side(
        altered: altered,
        reference: board_intact(b: lot_e1_s218_board, module: ModuleUnrecorded),
        altered_diodes: diodes_of(b: lot_e1_c_board),
        reference_diodes: diodes_of(b: lot_e1_s218_board),
        stated: concat(lot_e1_c_stated_without_figures, lot_e1_c_gate_parts_stated),
      )
    }
  }
}

// ── WHAT IT PRINTS ──────────────────────────────────────────────────────────────────────────────────

fn agreement_text(a: ReadingAgreement) -> String {
  match a {
    DisplaysAgree => "AGREES"
    DisplaysDiffer => "DIFFERS"
    NotComparable { why } => join(["NOT COMPARABLE (", why as String, ")"], "")
  }
}

fn polarity_words(o: ResistanceObservation) -> String {
  match red_point(o: o) {
    Present { value: r } => join([", red on ", terminal_text(t: r)], "")
    Absent => ""
  }
}

fn compared_line(c: ComparedReading) -> String {
  join([
    agreement_text(a: c.agreement), ": ", terminal_text(t: c.altered.first), " to ", terminal_text(t: c.altered.second), polarity_words(o: c.altered),
    " -- altered board ", resistance_display_text(d: c.altered.display),
    "; reference board ", join(map(c.reference, r => resistance_display_text(d: r.display)), " / "),
  ], "")
}

fn diode_display_words(d: DiodeDisplay) -> String {
  match d {
    ForwardMillivolts { millivolts } => join([to_string(millivolts), " mV"], "")
    OverLimit => "over the limit"
  }
}

fn compared_diode_line(c: ComparedDiodeReading) -> String {
  join([
    agreement_text(a: c.agreement), ": diode mode, red on ", terminal_text(t: diode_red(o: c.altered)), ", black on ", terminal_text(t: diode_black(o: c.altered)),
    " -- altered board ", diode_display_words(d: c.altered.display),
    "; reference board ", join(map(c.reference, r => diode_display_words(d: r.display)), " / "),
  ], "")
}

fn stated_line(s: StatedWithoutFigure) -> String {
  join(["STATED, NO FIGURE (altered board): ", terminal_text(t: s.first), " to ", terminal_text(t: s.second), ", ", s.stated as String], "")
}

fn side_by_side_lines(s: BoardsSideBySide) -> List<String> {
  concat(concat(concat(concat(concat(concat(
    map(filter(s.resistances, c => is_differ(a: c.agreement)), c => compared_line(c: c)),
    map(filter(s.diodes, c => is_differ(a: c.agreement)), c => compared_diode_line(c: c))),
    map(filter(s.resistances, c => !is_differ(a: c.agreement)), c => compared_line(c: c))),
    map(filter(s.diodes, c => !is_differ(a: c.agreement)), c => compared_diode_line(c: c))),
    map(s.only_on_altered, o => join(["ONLY ON THE ALTERED BOARD: ", resistance_text(o: o)], ""))),
    map(s.only_on_reference, o => join(["ONLY ON THE REFERENCE BOARD: ", resistance_text(o: o)], ""))),
    map(s.stated_on_altered, x => stated_line(s: x)))
}

// One board's measured netlist in its state (product.p4261.readings board_netlist): the joined nodes, then
// every link, one to a line.
fn netlist_lines(title: String, net: MeasuredNetlist) -> List<String> {
  concat(concat(
    [title],
    map(filter(net.nodes, n => count(n.members) > 1), n => join(["NODE: ", node_text(n: n)], ""))),
    map(net.links, l => join(["LINK: ", link_text(l: l)], "")))
}

fn write_report(path: NonEmptyStr, lines: List<String>) -> ProcessExit {
  let written = Filesystem.Write(path: path as String, content: join(concat(lines, [""]), "\n"))
  if written.success { ExitSuccess } else { exit_failure(reason: written.error) }
}

// S/N 1583323120148 after part B's removal, its own state: its measured netlist.
fn after_removal_lines() -> List<String> {
  match board_after(b: lot_e1_c_board, keys: concat(lot_e1_c_after_both, [lot_e1_c_b_removal_key]), module: ModuleRemoved) {
    Absent => ["MEASURED NETLIST, S/N 1583323120148 after part B's removal: the state does not resolve against the board's record"]
    Present { value: s } => netlist_lines(title: "MEASURED NETLIST, S/N 1583323120148 after part B's removal:", net: board_netlist(s: s))
  }
}

// The two lot E1s side by side, the differences first, then each board's measured netlist, into a file.
fn write_lot_e1_side_by_side(path: NonEmptyStr) -> ProcessExit {
  match lot_e1_side_by_side() {
    Absent => exit_failure(reason: "the altered board's state does not resolve against its own record")
    Present { value: s } => write_report(path: path, lines: concat(concat(concat(
      side_by_side_lines(s: s),
      netlist_lines(title: "MEASURED NETLIST, S/N 1583323120148 after both events, before part B's removal:", net: board_netlist(s: s.altered))),
      netlist_lines(title: "MEASURED NETLIST, S/N 1583323120218 untouched:", net: board_netlist(s: s.reference))), after_removal_lines()))
  }
}
