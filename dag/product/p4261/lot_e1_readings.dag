  on_s(first: r_pin(n: "pin 2"), second: r_pin(n: "pin 7"), record: both_on_r, polarity: PolarityUnrecorded, display: at_probe_level(shown: ".3ohm"), stability: StabilityUnrecorded, said: [s_transistors_said]),
  on_s(first: l_pin(n: "pin 1"), second: l_pin(n: "pin 2"), record: both_points_recorded, polarity: RedOnFirst, display: DisplayOverRange, stability: StabilityUnrecorded, said: [s_transistors_said]),
