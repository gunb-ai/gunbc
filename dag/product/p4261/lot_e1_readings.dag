  on_s(first: u1_lead(n: "pin 2"), second: r_pin(n: "pin 1"), record: second_on_r, polarity: PolarityUnrecorded, display: about(ohms: 600000), stability: StabilityUnrecorded, said: [s_part_1_said]),
  on_s(first: u1_lead(n: "pin 1"), second: l_pin(n: "pin 2"), record: both_points_recorded, polarity: PolarityUnrecorded, display: DisplayOverRange, stability: StabilityUnrecorded, said: [s_part_1_said]),
  on_s(first: l_pin(n: "pin 1"), second: r_pin(n: "pin 1"), record: second_on_r, polarity: PolarityUnrecorded, display: shown(ohms: 10), stability: StabilityUnrecorded, said: [s_part_1_said]),
  on_s(first: l_pin(n: "pin 2"), second: r_pin(n: "pin 2"), record: second_on_r, polarity: PolarityUnrecorded, display: at_probe_level(shown: "0ohm"), stability: StabilityUnrecorded, said: [s_part_1_said]),
  on_s(first: l_pin(n: "tab"), second: r_pin(n: "tab"), record: second_on_r, polarity: PolarityUnrecorded, display: at_probe_level(shown: "1ohm"), stability: StabilityUnrecorded, said: [s_part_1_said]),
  // Part 2, U1_P5's leads; lead 7 to P6 was not taken.
