  on_s(first: e1_q300_lone_lead, second: e1_ground_ref, record: second_on_return, polarity: PolarityUnrecorded, display: DisplayOverRange, stability: StabilityUnrecorded, said: [s_q300_ohms_said]),
  // Part 5, the fuses.
