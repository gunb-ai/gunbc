  on_s(first: u1_lead(n: "pin 4"), second: l_pin(n: "tab"), record: second_on_tab, polarity: PolarityUnrecorded, display: shown(ohms: 2), stability: StabilityUnrecorded, said: [s_u1_said]),
  on_s(first: u1_lead(n: "pin 5"), second: l_pin(n: "tab"), record: second_on_tab, polarity: PolarityUnrecorded, display: shown(ohms: 2), stability: StabilityUnrecorded, said: [s_u1_said]),
  on_s(first: u1_lead(n: "pin 9"), second: e1_ground_ref, record: second_on_return, polarity: PolarityUnrecorded, display: at_probe_level(shown: "~1ohm"), stability: StabilityUnrecorded, said: [s_u1_said]),
  on_s(first: u1_lead(n: "pin 10"), second: e1_ground_ref, record: second_on_return, polarity: PolarityUnrecorded, display: at_probe_level(shown: "~1ohm"), stability: StabilityUnrecorded, said: [s_u1_said]),
  // Part 3, the two transistors.
  on_s(first: l_pin(n: "pin 2"), second: l_pin(n: "pin 3"), record: both_points_recorded, polarity: PolarityUnrecorded, display: at_probe_level(shown: "1ohm"), stability: StabilityUnrecorded, said: [s_transistors_said]),
  on_s(first: l_pin(n: "pin 2"), second: l_pin(n: "pin 5"), record: both_points_recorded, polarity: PolarityUnrecorded, display: at_probe_level(shown: ".6ohm"), stability: StabilityUnrecorded, said: [s_transistors_said]),
  on_s(first: l_pin(n: "pin 2"), second: l_pin(n: "pin 6"), record: both_points_recorded, polarity: PolarityUnrecorded, display: at_probe_level(shown: ".6ohm"), stability: StabilityUnrecorded, said: [s_transistors_said]),
  on_s(first: l_pin(n: "pin 2"), second: l_pin(n: "pin 7"), record: both_points_recorded, polarity: PolarityUnrecorded, display: at_probe_level(shown: ".3ohm"), stability: StabilityUnrecorded, said: [s_transistors_said]),
  on_s(first: r_pin(n: "pin 2"), second: r_pin(n: "pin 3"), record: both_on_r, polarity: PolarityUnrecorded, display: at_probe_level(shown: "1ohm"), stability: StabilityUnrecorded, said: [s_transistors_said]),
  on_s(first: r_pin(n: "pin 2"), second: r_pin(n: "pin 5"), record: both_on_r, polarity: PolarityUnrecorded, display: at_probe_level(shown: ".6ohm"), stability: StabilityUnrecorded, said: [s_transistors_said]),
