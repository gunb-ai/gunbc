  on_s(first: e1_q300_lone_lead, second: e1_q301_lead_b, record: both_points_recorded, polarity: PolarityUnrecorded, display: at_probe_level(shown: "1ohm"), stability: StabilityUnrecorded, said: [s_q300_ohms_said]),
