    order: BetweenIncidents { after: [e1_bridge_incident.key], before: [e1_inductor_short_incident.key, e1_u10p2_lift.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-20", verbatim: e1_pad_each_way_said }, e1_u500_photo],
  }
}

fn e1_front_read(b: ElectricalTerminalRef, ohms: Nat, said: NonEmptyStr) -> ResistanceObservation {
  ResistanceObservation {
    asset: p4261_e1_b, first: e1_q300_lead_b, second: b,
    record: both_points_recorded,
    conditions: e1_bench, polarity: RedOnFirst, range: RangeFullScale { ohms: 2000 }, display: DisplayValue { ohms: ohms, approximate: true }, stability: StabilityUnrecorded, certainty: StatedPlainly,
    order: BetweenIncidents { after: [e1_bridge_incident.key], before: [e1_inductor_short_incident.key, e1_u10p2_lift.key] },
