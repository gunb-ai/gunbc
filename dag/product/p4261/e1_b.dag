    InstalledComponent { seen: seen_unordered(), component: e1_u100, terminals: names(ns: u100_lead_terminals), identification: MarkingUnresolved { marking: Present { value: MarkingReading { content: Transcribed { leading: [], first: GlyphSpan { preceded_by: "", span: "C3U / S22 / 25", sighting: Absent }, rest: [], followed_by: "" }, evidence: e1_u100_photo } }, discriminator: "an 8-lead package (four leads a side, pin-1 dot) beside the 4R7 nearest U4 (e1_u100_photo); its eight leads read on both carriers 2026-10-23 (e1_u100_lead_resistances, k1_u100_lead_resistances): the dot side at the return on both, the far side kilohms, and no lead at the baseline to either inductor pad on the K1, so it is not the inductor's converter. Its code C3U is undecoded; a maker's marking table or the part's own pinout would name it" } },
    InstalledComponent { seen: BeforeIncidents { keys: [e1_u10p2_lift.key] }, component: e1_converter_near, terminals: names(ns: converter_pin_terminals), identification: MarkingCandidate { row: mp2333cgtl, marking: MarkingReading { content: Transcribed { leading: [], first: GlyphSpan { preceded_by: "", span: "DFP 528", sighting: Absent }, rest: [], followed_by: "" }, evidence: e1_u100_photo }, discriminator: "the first glyph of this carrier's own part under the Andonstar: a B completes MPS's MP2333CGTL top-marking code 'BDFY / LLL' (year code P, lot 528, the lot the K1's part reads in full); the package (8 leads, four a side, 0.5 mm pitch) and the lead on the inductor's pad fit the row, and the 2026-10-21 photograph counted its leads as five" } },
