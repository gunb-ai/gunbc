    conditions: e1_live_bench, source: volt(count: 48), value: ReadAbout { value: millivolt(count: millivolts) }, certainty: StatedPlainly,
    order: BetweenIncidents { after: [e1_bridge_incident.key], before: [e1_inductor_short_incident.key, e1_u10p2_lift.key] },
    evidence: [OperatorStatement { stated_on: "2026-10-19", verbatim: e1_leads_said }],
  }
}

