// Q300'S LEAD B AGAINST U51 (2026-10-20, unpowered, after the switches were found). The first report,
// '20 ohm' to pins 8 and 6, was read on the 200k range and is 20 kohm, withdrawn by the operator as a
// range misread. Re-read on the 20k range with the red probe on Q300's lead b, U51's pins 1 to 8 read
// 2.5 to 6 kohm; pin 8, GND under SCLS402R, reads the same 2.5 kohm as J20's black lead on that range
// (R4b); and the pin 8 pair reads about 600 ohm on the 2k range, 1.7 and 2.5 kohm on 20k, 20 kohm on
// 200k, and 1.8 kohm with the probes swapped. A pair whose value moves with the range holds a junction
// (product.electrical.bench_session pair_range_standing), so none of these joins and no U51 pin is read
// as Q300's lead b's node: the readings to U51's pins are the gate node's own path to the return, plus
// each pin's protection. The pin on which the trace followed by eye arrives stays unread.
data e1_u51_first_said: NonEmptyStr = "Q300 -> U51 - it has 20ohm resistance to several legs on U51 - we'd have to number the legs - in this picture, its the bottom left leg of u51, and two above that one - it also has ~5k ohm resistance to other legs / In that picture it's 8 and 6"

data e1_u51_range_said: NonEmptyStr = "8 is reading like, 600 ohms or something - my complaint is that, it dfepends on what settings i use- 2k ohms it reads ~600, and 20k ohms it reads 1700 / i think 20 ohms, i was on 200k and didn't realize"

data e1_u51_pins_said: NonEmptyStr = "reading all of these on 20k ohms: 8: 2.5 / 7: 6 / 6: 2.5 / 5: 6 / 4: 6 / 3: 5 / 2: 5 / 1: 5 - This is with red on Q300, and black on the pins"

data e1_u51_swapped_said: NonEmptyStr = "ZB15: at 20k, red on pin 8, black on Q300: 1800 ohms / R4b: 2.5k ohms"

data e1_u51_pins_photo: EvidenceRef = e1_unstored_photo(taken_on: "2026-10-20", locator: "bench-session upload, U51 with its pins numbered 1 to 8 along the row nearer Q300's trace in the crop u51_pins (not on Drive)")

// The terminals of U51 the bench actually probed, named by the position counted on the body -- the NUMBER,
// not TI's name for that position. The 2026-10-20 session put red on Q300's lead b and black on pins 1
// through 8 in turn ("8: 2.5 / 7: 6 / 6: 2.5 / 5: 6 / 4: 6 / 3: 5 / 2: 5 / 1: 5"); 9 through 16 were never
// touched, so nothing claims them here. TI's names for those numbers (GND, SH/LD, the Q outputs) belong to
// the PART and are reachable only through identified_row(c), so a U51 that stands only as a candidate
// exposes no TI name. These 16 names used to be written onto the specimen from lv165a_pins, which made the
// datasheet a second authority for what the specimen is; the fix is that a specimen's body is what was seen.
// WHAT THE BENCH ESTABLISHED ABOUT TWO BODIES, apart from what the parts are. One row per
// observation, each citing the frame or statement it came from -- the carriers are in
// product.electrical.identification, and the guard that reads them is
// product.p4261.carrier_layout_witness's a_specimens_body_is_what_was_probed_and_not_a_named_parts_numbering:
// a specimen's terminals are the leads counted here or the positions probed below, never the numbering
// of a row its identification names (gunbc.design_argument::epistemic_humility).
//
// U55: the bench counted sixteen leads on the body, which is why the row's body has sixteen positions.
// The frame is the one whose reading record has 'ZVK' over '22J' beside U92 and U93; the count is read
// off the body, and no SN74AVC4T774 table is consulted for it -- the candidate's own pin table is where
// the datasheet could have crept in, because that table also happens to have sixteen entries.
// U43: five leads on an SC70 body, the bench's words "U43, a five-lead SC70 marked WEJ", in the frame
// recorded by e1_u43_photo. TI's DCK numbering has five entries too; it is not where this five came from.
data e1_observed_lead_counts: List<ObservedLeadCount> = [
  ObservedLeadCount {
    component: e1_u55,
    count: 16,
    counted_from: "leads counted on the body from the pin-1 mark",
    evidence: e1_u55_photo,
  },
  ObservedLeadCount {
    component: e1_u43,
    count: 5,
    counted_from: "five leads counted on the SC70 body",
    evidence: e1_u43_photo,
  },
]

// Every position a probe touched on an E1 body, one row each. U51's eight are the 2026-10-20 session's
// own sweep -- red on Q300's lead b, black on pins 1 through 8 in turn, "8: 2.5 / 7: 6 / 6: 2.5 / 5: 6 /
// 4: 6 / 3: 5 / 2: 5 / 1: 5" -- and pins 9 through 16 were never touched, so they are absent here and
// absent from the specimen's body. The names are positions counted on the body; TI's names for those
// numbers belong to the part and are reachable only through identified_row(c).
data e1_observed_probed_positions: List<ObservedProbedPosition> = [
  ObservedProbedPosition { component: e1_u51, position: "pin 1", evidence: e1_lv165a_photo },
  ObservedProbedPosition { component: e1_u51, position: "pin 2", evidence: e1_lv165a_photo },
  ObservedProbedPosition { component: e1_u51, position: "pin 3", evidence: e1_lv165a_photo },
  ObservedProbedPosition { component: e1_u51, position: "pin 4", evidence: e1_lv165a_photo },
  ObservedProbedPosition { component: e1_u51, position: "pin 5", evidence: e1_lv165a_photo },
  ObservedProbedPosition { component: e1_u51, position: "pin 6", evidence: e1_lv165a_photo },
  ObservedProbedPosition { component: e1_u51, position: "pin 7", evidence: e1_lv165a_photo },
  ObservedProbedPosition { component: e1_u51, position: "pin 8", evidence: e1_lv165a_photo },
]

// The positions of one body that were probed, selected by COMPONENT IDENTITY -- the design is part of
// the comparison, so a K1 designator can never select an E1 row.
fn e1_probed_positions(c: ComponentInstanceIdentity) -> List<NonEmptyStr> {
  map(filter(e1_observed_probed_positions, p => component_identity_eq(a: p.component, b: c)), p => p.position)
}

// How many leads the bench counted on that body; zero rows means no count was ever recorded, which is
// not the same as a count of zero.
fn e1_lead_count_rows(c: ComponentInstanceIdentity) -> List<ObservedLeadCount> {
  filter(e1_observed_lead_counts, r => component_identity_eq(a: r.component, b: c))
}

data e1_u51_probed_pins: List<NonEmptyStr> = e1_probed_positions(c: e1_u51)

fn e1_u51_pin(n: NonEmptyStr) -> ElectricalTerminalRef {
  e1_terminal(c: e1_u51, name: n)
}

