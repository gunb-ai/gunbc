    InstalledComponent { seen: seen_unordered(), component: e1_u500, terminals: names(ns: e1_u500_contacts), identification: MarkingUnresolved { marking: Present { value: MarkingReading { content: Transcribed { leading: [], first: GlyphSpan { preceded_by: "", span: "FZ / YY", sighting: Absent }, rest: [Annotation { annotation: BodyFeature { preceded_by: " (", span: "a dot at one corner", described: "a physical mark on the package, not printed text: the pin-1 indicator", sighting: Absent } }], followed_by: ")" }, evidence: e1_u500_photo } }, discriminator: "an eight-contact leadless package beside the crystal Y50: match the code in a maker's table (TI uses FZ on unrelated six-pin parts, excluded by the eight contacts); its ground contact (right contact 2, '0.00' to J20's black lead) and the crystal pads anchor the numbering" }},
    InstalledComponent { seen: seen_unordered(), component: e1_y50, terminals: names(ns: e1_y50_pads), identification: MarkingUnresolved { marking: Present { value: MarkingReading { content: Transcribed { leading: [], first: GlyphSpan { preceded_by: "", span: "T327K / EV13", sighting: Absent }, rest: [], followed_by: "" }, evidence: e1_u500_photo } }, discriminator: "a four-pad crystal by its Y designator and package; whether 'T327K' (or '1327K') encodes its frequency is unread until a maker's table says so" } },
