// The device code read on the body of the four rectifiers at D2_P1, D8_P1, D2_P5 and D8_P5, projected
// exactly. Only the transcriptions the receipts record are accepted, compared whole, so no other string
// can support the claim by resembling one, and nothing here parses a text into pieces. Substring matching
// is declined deliberately, not for want of it -- std has .contains -- because deciding WHICH GLYPHS of a
// body print make up the device code is a judgment that belongs to the receipt, not to a matcher inside
// the model. A matcher would be a second, unaudited authority over the print, disagreeing with the first
// one quietly (gunbc.design_argument::single_authority).
fn fsv20100v_device_code(reading: MarkingReading) -> NonEmptyStr? {
  match reading.content {
    Transcribed { leading, first, rest, followed_by: _ } =>
      match map(leading, a => Annotation { annotation: a }) + rest {
        // ONE shape for all four bodies, and the annotation is part of it: the two codes as glyphs, with
        // onsemi's mark as a PrintedLogo and nothing else written beside them. The _P1 pair had the mark
        // written as letters among the codes; rev 6 moved that word out of the transcription, because
        // "ON logo" is the bench NAMING a mark rather than what is printed on the body, and the two pairs
        // now carry it identically. A reading with no annotation at all is refused rather than trusted:
        // the _P5 identifications rest on that logo ("the ON logo establishes the maker"), so accepting
        // its absence would accept a body whose mark was never read.
        Empty => Absent
        Cons { head: beside, tail: after } =>
          match one_printed_logo(beside: beside, after: after) {
            Present { value: mark } =>
              if (glyph_text_eq(a: first.span, b: "FSV20100V / JC03")
                  || glyph_text_eq(a: first.span, b: "JC03 FSV20100V"))
                && glyph_text_eq(a: mark, b: "ON logo") {
                Present { value: "FSV20100V" }
              } else {
                Absent
              }
            Absent => Absent
          }
      }
    LookedNothingReadable { circumstances: _, followed_by: _ } => Absent
  }
}

// The identification is CONSTRUCTED from the join rather than asserted beside it: the device code we
// read must BE the mark the vendor row prints, or the position stays a lead with its obligation named.
// Pair these rows with the wrong component, or corrupt one glyph of the print, and they land in
// MarkingCandidate where the witnesses say so loudly (gunbc.design_argument::guarantee_ladder: construction over proof).
fn fsv20100v_identification(subject: ComponentInstanceIdentity, marking: MarkingReading) -> ComponentIdentification {
  match fsv20100v_device_code(reading: marking) {
    Absent => MarkingCandidate { row: onsemi_schottky_fsv20100v, marking: marking,
      discriminator: "the print we read is not one of the two receipt transcriptions, so no device code joins the vendor mark" }
    Present { value: code } => if published_fixed_line_contains(row: onsemi_schottky_fsv20100v, code: code) {
      identify_by_marking(roster: e1_board_sightings, row: onsemi_schottky_fsv20100v, readings: MarkingReadingSet { subject: subject, relied_on: marking, others: [] }, discriminator: "the roster does not attribute this reading's frame and box to this part")
    } else {
      MarkingCandidate { row: onsemi_schottky_fsv20100v, marking: marking,
        discriminator: "the observed device code is not a fixed line the vendor row lists; this joins one listed line, not the whole mark (FSV20100V's diagram has a further logo/plant/date line)" }
    }
  }
}

