data e1_board_sightings: BoardSightings = BoardSightings {
  rows: map(e1_board_sighting_rows, r => SpecimenSighting {
    specimen: r.specimen,
    sighting: InStore { content: r.frame, region: Present { value: r.region } },
  }),
}
