  BoundUnestablished,
  ControllerPinStanding,
  EnableProjection,
  EnableProjectionUnestablished,
  EnableReachableWithinInputBound,
  EnableUnreachableWithinInputBound,
  InputBoundStanding,
  InputDrawBounded,
  InputDrawContradicted,
  InputDrawStanding,
  InputDrawUnestablished,
  InputPolarity,
  InputSwitchStanding,
  PinAboveThreshold,
  PinBelowThreshold,
  PinThresholdUnestablished,
  PitchFit,
  PolarityContradicted,
  PolarityEstablished,
  PolarityUnestablished,
  SwitchBlocking,
  SwitchConducting,
  SwitchStateUnestablished,
  across_input,
  caliper_pitch_fits,
  controller_enable_standing,
  controller_overvoltage_standing,
