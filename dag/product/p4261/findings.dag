  InventoryAssessment,
  InventoryContradicted,
  InventoryMissing,
  InventoryNotAttributable,
  InventorySupportedOnSpecimen,
  RecountEstablished,
  RecountNotEstablished,
  RecountStanding,
  j20_inventory_assessment,
  j20_recount,
}

// WHAT THE P4261 RECORDS ESTABLISH, AS TYPED RESULTS A CONSUMER READS BEFORE ANYTHING IS RENDERED.
// product.p4261.readings and product.p4261.evidence interpret selected observations; this module
// names the findings consumers cite and judges each into a typed result; product.p4261.report only
// renders a judgment it is handed, so rewording, omitting or translating a sentence cannot change
// whether a finding holds. A consumer that decides (the private qualification) asks
// finding_established here; one that shows text asks the report.
//
// A consumer cites ONE finding, not the whole carrier report, so that removing or contradicting that
// fact reopens that consumer and nothing else.
type CarrierFinding
  = J20ContactInventory
  | J20InventoryMatchesRevision
  | J20Polarity
  | ComponentAcrossInput { component: ComponentInstanceIdentity }
  | ComponentIdentified { component: ComponentInstanceIdentity }
  | InputUpperBound
  | J20EnergizedDraw
  | InputSwitchState { component: ComponentInstanceIdentity }
  | ControllerEnableState { component: ComponentInstanceIdentity }
  | ControllerOvervoltageState { component: ComponentInstanceIdentity }
  | EnableInputProjection { component: ComponentInstanceIdentity }
  | CarrierPhaseObserved { key: NonEmptyStr }
  | ProtectedInputBusInPhase { key: NonEmptyStr }

// THE J20 OBSERVATION A J20 FINDING RESTS ON, captured with the judgment so that its rendering needs no
// second look at the board: the census as recorded, its observed inventory, and the caliper spans'
// fit to the pitches J20's family could have.
type J20ObservationContext {
  census: ConnectorPositionCensus
  observed: ObservedInventory
  calipers: List<PitchFit>
}

// ONE FINDING, JUDGED: the typed result it rests on, with what its rendering needs. A component finding
// whose component is not in the board's observation is NotAComponent, never a guess.
type FindingJudgment
  = J20InventoryJudged { recount: RecountStanding, agreement: InventoryAssessment?, context: J20ObservationContext }
  | J20AgreementJudged { agreement: InventoryAssessment?, context: J20ObservationContext }
  | PolarityJudged { polarity: InputPolarity }
  | AcrossJudged { standing: AcrossInputStanding }
  | IdentificationJudged { observed: InstalledComponent }
  | BoundJudged { bound: InputBoundStanding }
  | DrawJudged { draw: InputDrawStanding }
  | SwitchJudged { standing: InputSwitchStanding }
  | EnableJudged { standing: ControllerPinStanding }
  | OvervoltageJudged { standing: ControllerPinStanding }
  | ProjectionJudged { projection: EnableProjection }
  | PhaseJudged { key: NonEmptyStr, standing: CarrierPhaseStanding? }
  | BusJudged { key: NonEmptyStr, standing: ProtectedBusStanding? }
  | NotAComponent { component: ComponentInstanceIdentity }

fn j20_context(layout: CarrierLayoutObservation) -> J20ObservationContext {
  J20ObservationContext { census: layout.j20, observed: observed_inventory(census: layout.j20), calipers: caliper_pitch_fits(spans: layout.j20_calipers) }
}

fn judge_component(layout: CarrierLayoutObservation, c: ComponentInstanceIdentity, f: CarrierFinding) -> FindingJudgment {
  match installed(layout: layout, c: c) {
    Absent => NotAComponent { component: c }
    Present { value: x } => match f {
      ComponentAcrossInput { component: _ } => AcrossJudged { standing: across_input(layout: layout, c: x) }
      ComponentIdentified { component: _ } => IdentificationJudged { observed: x }
      InputSwitchState { component: _ } => SwitchJudged { standing: input_switch_standing(layout: layout, c: x) }
      ControllerEnableState { component: _ } => EnableJudged { standing: controller_enable_standing(layout: layout, c: x) }
      ControllerOvervoltageState { component: _ } => OvervoltageJudged { standing: controller_overvoltage_standing(layout: layout, c: x) }
      EnableInputProjection { component: _ } => ProjectionJudged { projection: enable_projection(layout: layout, c: x) }
      J20ContactInventory => NotAComponent { component: c }
      J20InventoryMatchesRevision => NotAComponent { component: c }
      J20Polarity => NotAComponent { component: c }
      InputUpperBound => NotAComponent { component: c }
      J20EnergizedDraw => NotAComponent { component: c }
      CarrierPhaseObserved { key: _ } => NotAComponent { component: c }
      ProtectedInputBusInPhase { key: _ } => NotAComponent { component: c }
    }
  }
}

fn judge_finding(layout: CarrierLayoutObservation, f: CarrierFinding) -> FindingJudgment {
  match f {
    J20ContactInventory => J20InventoryJudged { recount: j20_recount(layout: layout), agreement: j20_inventory_assessment(layout: layout), context: j20_context(layout: layout) }
    J20InventoryMatchesRevision => J20AgreementJudged { agreement: j20_inventory_assessment(layout: layout), context: j20_context(layout: layout) }
    J20Polarity => PolarityJudged { polarity: input_polarity(layout: layout) }
    ComponentAcrossInput { component } => judge_component(layout: layout, c: component, f: f)
    ComponentIdentified { component } => judge_component(layout: layout, c: component, f: f)
    InputUpperBound => BoundJudged { bound: input_bound(layout: layout) }
    J20EnergizedDraw => DrawJudged { draw: input_draw(layout: layout) }
    InputSwitchState { component } => judge_component(layout: layout, c: component, f: f)
    ControllerEnableState { component } => judge_component(layout: layout, c: component, f: f)
    ControllerOvervoltageState { component } => judge_component(layout: layout, c: component, f: f)
    EnableInputProjection { component } => judge_component(layout: layout, c: component, f: f)
    CarrierPhaseObserved { key } => PhaseJudged { key: key, standing: phase_standing_in(layout: layout, key: key) }
    ProtectedInputBusInPhase { key } => BusJudged { key: key, standing: protected_bus_in(layout: layout, key: key) }
  }
}

// WHETHER THE FINDING HOLDS, from its typed result alone, exhaustively. "Established" means this finding
// is established -- a switch read blocking, a pin read below its threshold, a phase classified -- not
// that the hardware is healthy or any operation authorized. The J20 inventory finding rests on the
// recount, never on whether the revision agrees; an identification on whether its arm establishes one.
fn finding_established(j: FindingJudgment) -> Bool {
  match j {
    J20InventoryJudged { recount, agreement: _, context: _ } => match recount {
      RecountEstablished { latch_row: _, away_row: _ } => true
      RecountNotEstablished { gap: _, observed: _ } => false
    }
    J20AgreementJudged { agreement, context: _ } => match agreement {
      Absent => false
      Present { value: a } => match a.outcome {
        InventorySupportedOnSpecimen => true
        InventoryContradicted { observed: _ } => false
        InventoryMissing { gap: _ } => false
        InventoryNotAttributable { gap: _ } => false
      }
    }
    PolarityJudged { polarity } => match polarity {
      PolarityEstablished { fused_side: _, return_side: _, fused: _, returns: _, isolation: _ } => true
      PolarityContradicted { readings: _ } => false
      PolarityUnestablished { gaps: _ } => false
    }
    AcrossJudged { standing } => match standing {
      AcrossInput { component: _, on_fused: _, on_return: _, fused_path: _, return_path: _ } => true
      AcrossInputContradicted { component: _, readings: _ } => false
      AcrossInputUnestablished { component: _, gap: _ } => false
    }
    IdentificationJudged { observed } => identification_established(i: observed.identification)
    BoundJudged { bound } => match bound {
      BoundEstablished { bound: _, equally_limiting: _, observed: _ } => true
      BoundContradicted { contradicted: _, observed: _ } => false
      BoundUnestablished { observed: _ } => false
    }
    DrawJudged { draw } => match draw {
      InputDrawBounded { bounded: _, observed: _ } => true
      InputDrawContradicted { contradicted: _, observed: _ } => false
      InputDrawUnestablished { gaps: _ } => false
    }
    SwitchJudged { standing } => match standing {
      SwitchBlocking { component: _, drain: _, sources: _ } => true
      SwitchConducting { component: _, drain: _, sources: _ } => true
      SwitchStateUnestablished { component: _, gap: _ } => false
    }
    EnableJudged { standing } => pin_standing_read(s: standing)
    OvervoltageJudged { standing } => pin_standing_read(s: standing)
    ProjectionJudged { projection } => match projection {
      EnableUnreachableWithinInputBound { component: _, readings: _, turn_on_millivolts: _, bound: _ } => true
      EnableReachableWithinInputBound { component: _, readings: _, turn_on_millivolts: _, bound: _ } => true
      EnableProjectionUnestablished { component: _, gap: _ } => false
    }
    PhaseJudged { key: _, standing } => match standing {
      Absent => false
      Present { value: s } => match s {
        InputBiasOnly { phase: _, draw: _, bias_ceiling: _ } => true
        AuxiliaryDomainActive { phase: _, draw: _, bias_ceiling: _ } => true
        SequenceTransient { phase: _ } => true
        ControlSteady { phase: _ } => true
        BridgeHeld { phase: _, bridge: _ } => true
        BridgeReleaseRecovery { phase: _, bridge: _ } => true
        PhaseUnclassified { phase: _, gap: _ } => false
      }
    }
    BusJudged { key: _, standing } => match standing {
      Absent => false
      Present { value: s } => match s {
        ProtectedInputBusActive { phase: _, readings: _, source: _ } => true
        ProtectedInputBusHeldOff { phase: _, readings: _, source: _ } => true
        ProtectedBusInconsistent { phase: _, readings: _, source: _ } => false
        ProtectedBusUnread { phase: _, gap: _ } => false
      }
    }
    NotAComponent { component: _ } => false
  }
}

fn pin_standing_read(s: ControllerPinStanding) -> Bool {
  match s {
    PinBelowThreshold { component: _, readings: _, minimum: _ } => true
    PinAboveThreshold { component: _, readings: _, maximum: _ } => true
    PinThresholdUnestablished { component: _, readings: _, gap: _ } => false
  }
}
