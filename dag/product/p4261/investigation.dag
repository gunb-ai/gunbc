module product.p4261.investigation

import std.types { List, NonEmptyStr }
import product.placement_supply { PhysicalAssetIdentity }
import product.electrical.investigation_hypothesis { InvestigationHypothesis }
import gunbc.fleet.fleet_asset_identity { p4261_e1_b }
import extdeps.nvidia.p4261 { p4261_e1 }
import extdeps.nvidia.p4261.population { P4261Position, p4261_position }

// OUR HYPOTHESES ABOUT THE P4261, AND WHAT EACH ONE IS ABOUT. Each InvestigationHypothesis is our
// record: a claim we have not established, the sources we argue it from, and what would decide it
// (product.electrical.investigation_hypothesis). It is ours whatever it is about -- but what it is about
// is classified, because the subject of a claim does not become ours by being written in prose:
//   DesignRelationRemainder  a relation of NVIDIA's board design not yet modeled as a typed
//                            proposition (extdeps.nvidia.p4261.netlist); the positions it names
//   SpecimenDiagnostic       why one held board behaves as it does: its state, faults and our work on it
//   DesignAndSpecimen        both, not yet separated
// and each names the typed wiring propositions it argues about, by key, where any exist. Nothing here
// is a modeled design fact: a typed proposition is the only such record, and a hypothesis that becomes
// one is rendered from it.
type HypothesisClass
  = DesignRelationRemainder { positions: List<P4261Position> }
  | SpecimenDiagnostic { asset: PhysicalAssetIdentity }
  | DesignAndSpecimen { positions: List<P4261Position>, asset: PhysicalAssetIdentity }

type ClassifiedHypothesis {
  hypothesis: InvestigationHypothesis
  class: HypothesisClass
  concerns: List<NonEmptyStr>
}

fn no_keys() -> List<NonEmptyStr> {
  []
}

fn no_positions() -> List<P4261Position> {
  []
}

fn e1_at(d: NonEmptyStr) -> P4261Position {
  p4261_position(revision: p4261_e1, designator: d)
}

data p4261_j20_main_input_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "J20 is the P4261's main input, and the input-stage MOSFETs switch it toward the module",
  sources: [
    "the E1's measured board puts F300 (75 V / 100 A) and the probed input-stage MOSFET's drain -- its tab and pin 4 on the IPB017N10N5LF pinout -- on J20's fused side, with none of that MOSFET's pins reaching ground: a hot-swap stage's shape, read on inferred probe points",
    "J20's nine fused positions on a 3.0 mm-pitch housing could carry a 1 kW module's input current at 48-54 V, where its 12 A F1 could not -- so F1 is either a branch or the input is elsewhere",
    "energized 2026-10-18 with the module removed, J20 fed a real load at up to 52 V without tripping a 100 mA over-current limit (input_draw): it accepts a 48-54 V-class voltage, and nothing large drew from J20 up to 52 V",
  ],
  decided_by: "where the probed MOSFET's sources go: terminal readings from its source pins toward the module receptacles' power contacts",
}

data p4261_grey_path_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "the grey blind-mate connectors carry the P4261's main input, and it is a 48-54 V-class bus",
  sources: [
    "the input-stage MOSFETs beside the grey blocks are Infineon IPB017N10N5LF, a 100 V part its vendor presents for hot-swap and e-fuse use and characterizes at VDS=56V (extdeps.electronic_component.infineon_ipb017n10n5lf): consistent with a 48-54 V stage, not a determination of one",
    "the module part number 699-2G530-0215 reads as SKU215, which an uncited earlier NVIDIA guide revision tied to a 54 V module rail (extdeps.systems.nvidia_gh200 gh200_rail_variants): a lead about the module, not the carrier's input",
    "counter-lead: a grey edge connector photographed face-on on the E1 (2026-10-16) shows fine contacts and no power blade",
  ],
  decided_by: "the grey blocks' contacts traced by terminal readings to the input stage, plus the input rating read off the original power-distribution board or harness, the carrier's schematic or vendor documentation, or a measurement of the original system's supply output",
}

// THE LOCAL CONTROLS PUT THE CARRIER THROUGH RECORDED STATES; NONE IS NAMED BY FUNCTION. What S1, S2,
// J30 and J68 are for is unread: their effects are the recorded phases and transitions
// (product.electrical.carrier_phase), and a bridge held across a header's points reads the same
// whether it pulls a logic input low or collapses a rail until the resistor-coupled test separates
// the two.
data p4261_local_control_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "on J20 power alone with the module absent, the carrier's local controls put it through recorded states: S2's poles select between the bias-only draw (about 13 mA, nothing lit) and a further domain drawing about 38 mA with nothing lit; from there, S1's pole 2 moved toward ON starts a sequence (about 80 mA, indicators lit) that settles at about 94 mA with a subset lit and one blinking; S2 returned takes it back to the bias-only state; a bridge held across J30's A and B lights DS3 and DS4 and, released, replays the sequence; a bridge held across J68's R1 and R2 extinguishes every indicator with an audible click and, released, restarts the sequence. U49 and U51, beside the end of Q300's lead b trace, are SN74LV165A parallel-load shift registers, parts that each read eight inputs and shift them out serially: the switch poles, the header points and Q300's node may be collected by them into a serial word for whatever clocks them. With all four poles toward ON at 48 V (97 mA, CV), and again settled after a J30 tap, Q21_P5's small output legs read about 1.7 V, so the protected input bus reads held off in those two states and is unread in the others; in the all-on state Q300's lead b reads 0 V, the via 4.37 V and pin 7 0 V, as before the switches were found. The module installed changes no step's draw. Unpowered, every pole of S1 and S2 reads about 0 ohm across its terminals toward the ON legend and over range on the 2 Mohm range away from it, so each closes toward ON (pole_closures_text). None of this names J68 a reset, J30 a button, S1 or S2 a power switch, S1's pole 1 inert, or any 0 V header point a ground",
  sources: [
    "2026-10-20, all four poles toward ON, 48 V, 97 mA with CV lit (p3-all-poles-on): Q21_P5's small output legs about 1.66 V (which lead, unrecorded), the via on Q301's lead b node 4.37 V, Q300's lead b 0 V, the resistor's far end 48 V; re-read from the pin 1 marker, pin 7 0 V, pin 8 1.8 V, P6 0 V. The first report's 'pin 7 is 1.8v i believe' matched pin 8 and is superseded. The protected bus reads held off from the legs (ProtectedInputBusInPhase p3-all-poles-on); the enable chain reads as before the switches were found",
    "2026-10-20, the module installed and the steps repeated: 'the module doesn't change any of the supply current numbers' (p0 to p3 recorded again with the module installed, at the same draws; how it was seated, and under what cooling, unrecorded). After a J30 tap, 'it just repeats the power phases'; settled, Q21_P5's small output legs about 1.7 V with the module's state at that reading unrecorded (p3-after-j30-tap), so the bus reads held off there too",
    "2026-10-20, module absent: 'found some literal on off switches - the current jumped a bit and some lights turned on'; the source's display read 54.00 V, 0.085 A, 4.587 W with CV lit and OCP armed, and green and red-or-amber indicators were lit (first-lit-state); which poles were moved, and whether with the output on, is unrecorded",
    "the staircase, one pole set at a time (e1_phases, e1_transitions): S2.1 off / S2.2 on, 0.013 A, nothing lit; S2.1 on / S2.2 off, 0.038 A, nothing lit, 'toggling either S1 switch does nothing' there; S1 pole 2 on, about 0.08 A then 0.094 A as 'the lights settle (from all lit to a few lit/one blinking near U1_TFP)'; S1 pole 1 off afterwards 'doesn't matter'; S2 returned 'returns back to the initial state'. The attribution to S1's pole 2 is the operator's; a later sentence says 'switch 1', so which S1 pole started the sequence is recorded with that doubt. Whether S1 is sampled only at a start or a restart is unread",
    "J30 bridged ('A and B'): 'a softer reset through the same sort of phase', 'slowly returns to .94A' (typed; 0.094 A or 0.94 A, unresolved), DS3 and DS4 lit 'as long as I hold J30 short'; energized in the settled state, 'J30 reads 3.1v, on pin 1 it's 0v'. A pulled-up input bridged to its return reads this way; so does a 3.3 V rail bridged to a point that happens to read 0 V",
    "J68's bridge R1 to R2, re-read under the labelled positions and the candidate JTAG map (2026-10-21): R1 reads as the return unpowered and R2 a 57 ohm path, the reference-rail position, so the bridge most simply shorted that rail to the return; the lamps going out, the click and the restart on release are a management-island brownout and cold restart, and a reset input was not established. The 2026-10-20 powered map's orientation is disputed (it named R1 high) and its rows carry that hedge",
    "J68 bridged (R1 to R2): 'an audible click, and the circuit repeats/resets a phase (or it holds it down, and then when i release again it automatically tries to boot again)'; 'stalls at .7A, until I let go', confirmed as 0.07 A ('yes, its .07A'); 'holding j68 turns all lights off, releasing starts boot sequence over'. Energized in the settled state its ten points read 'R1, L2-5 are all 1.8v, the rest are 0v': a 0 V point is a point that read 0 V, joined to the return only by an unpowered reading at a baseline, which none has. A shorted logic regulator in hiccup extinguishes a domain and restarts on release exactly as an active-low input would; the click's origin (carrier or source) is unrecorded, and the source's CV / CC / OCP state during the hold is unrecorded",
    "U49 and U51 both read 'LV165A / 2BKG4 / AEC0' (operator photographs, 2026-10-20): SN74LV165APW by TI's package marking (extdeps.electronic_component.ti_sn74lv165a). A 2 x 5 header is a common debug footprint whose geometry fixes no pinout; which U49 / U51 pin each switch pole, header point and Q300's node meets is unread; Q300's lead b reads a junction path, not a join, to every U51 pin on the 20k range (2026-10-20)",
    "the bench ceiling did not shape the staircase: the operator ran these states under a 0.6 A limit as often as under 0.10 A, with the supply at 48 V, and the draw was the same ('i had the amperage at .6A regularly so .1A was definitely not capping it, its not taking more'); which limit any one recorded step ran under is unrecorded, so the phases carry both as candidates and the voltage from their agreement. The switch-event photographs alone show 54.00 V",
    "the Q21_P5 / Q22_P5 source-side terminals, P6, Q301's lead b node, Q300's lead b and the resistor's far end are unread in every recorded phase; the readings before the switch event were taken with the vector unrecorded",
    "U4 read 2026-10-21 as Intel's Cyclone 10 GX 10CX085YF672E6G: the local controls, the headers and the shift registers are consistent with inputs an FPGA reads, and the indicator sequence with outputs it drives; a blinking indicator after settling is then a configured device running, which its CONF_DONE confirms or denies",
    "two indicators blink in the settled state with different periods (DS1_2 about 2.5 s, DS6 about 2.7 s, videos of 2026-10-21): if DS1_2 is driven by U5_2, the root of trust is running; if DS6 is driven by U4, U4 is configured and running; which part drives each is unread, and a pattern that is an error code rather than a heartbeat is not excluded",
    "J68 unpowered to J20's black lead on the 2k range (2026-10-21, under the labelled photograph): R1 '0.00' and R5 'ground', R2 57 ohm, R3, R4 and L4 over range, L1 937 ohm, L2 538, L3 and L5 both 1153. Position by position that is Intel's ten-pin JTAG layout with L as the odd pins (TCK with a pull-down, TDO, TMS and TDI with matching pull-ups, a no-connect at 7) and R the even (ground at 2 and 10, VCC at 4, no connection at 6 and 8): the FPGA's JTAG header, at VCCPGM if R2 reads 1.8 V powered, which the 10-20 map's '1.8v' points suggest under a count that named R1 high and so was oriented differently; a candidate until R2 reads 1.8 V and R1, R5 0 V under the labelled positions",
    "2026-10-21, the K1 carrier (untouched by the probe bridge): 'starts at .013A like the other board, and with all the switches on, it only gets to .040 for some reason, no LEDs turn on' (k1_phases). The E1's P1 draw with nothing lit, reached by the K1 and never left: the K1 does not start the sequence the E1 runs, so the two carriers sit in two different states, neither reaching the bus, and damage on the E1 is not the simplest reading of either. In that state J68 reads no voltage on the K1 under the labelled map, R2 included ('I didn't read any voltage on that pin header on K1 at 40ma'), where the E1 settled holds R2 at 1.8 V, and J30's B and C at 0.26 V with A at 0 V where the E1 holds a J30 point at 3.1 V: the FPGA's programming reference is absent and the control domain's pull-ups sit at a fraction of a volt, so U4's domain is unpowered on the K1, while the E1 reached a more advanced powered state; U4's configuration state on the E1 is unread until CONF_DONE or INIT_DONE is read or a chain scan answers, and the K1's cause is unread among a missing input, an inactive enable, a converter fault and an overloaded load. In the same state a momentary bridge across J30's A and B, which lights DS3 and DS4 on the E1, changed nothing ('no change as far as i can see'), and S1's pole 2 cycled alone with S2 set as on the E1's P1, which starts the E1's sequence, left the current where it was ('nothing seems to happen to the current'): the controls that move the E1 do not move the K1 (k1_transitions). A photograph sent with those readings (board-corner photograph of 2026-10-21; which carrier is not stated) shows S1 and S2 beside J22 at the board edge, the MCIO receptacles J5, J7 and J8 along it and the regulatory silkscreen 'NVIDIA CORP MODEL: P4261'. The K1's pole order, the source's limit and the module's presence are unrecorded",
  ],
  decided_by: "Unpowered and discharged, each of J68's ten points and J30's three to J20's black lead on a recorded range against the shorted-probe baseline, which alone joins a point to the return. Then, in the settled state, J30's 3.1 V point taken low through 1 kohm to a point so joined, reading the point while held and the source's V, A and CV / CC / OCP: the same hold-and-release with the source in CV and the point near 0 V reads as a logic input; the point staying high, or CC or OCP appearing, reads otherwise. J68's hold test is withdrawn: under the candidate JTAG map R1 is a return and R2 the reference rail, so the 2026-10-20 bridge R1 to R2 read as a rail collapse (lamps out, a click, a restart on release) and established no reset input; no bridge is placed between J68's positions again, on either carrier. In each stable phase, Q21_P5's source-side terminals (ProtectedInputBusInPhase), P6, Q301's lead b node, Q300's lead b and the resistor's far end. Unpowered, Q300's lead b to the exact U51 pin its trace meets, and each S1 / S2 pole, J30's high point and J68's 1.8 V points to U49 / U51 pins. Each S1 pole moved with the output off, then across a cold start. A video holding the board and the source's display through a J30 and a J68 hold and release. Nothing is bridged hard again before the unpowered map, and nothing drives Q300's lead b or pin 7 until a reviewed decision",
}

data p4261_q4_temperature_diode_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "Q4_P5 is the diode-configured MMBT3904-class transistor on U1_P5's DIODE pin (pin 16), sensing the input MOSFETs' temperature, and is not part of the enable path",
  sources: [
    "TI SNVS950C pin 16 DIODE: connect a diode-configured MMBT3904 NPN transistor for temperature monitoring",
    "operator photograph 2026-10-19: Q4_P5 is a SOT-23 beside Q21_P5 with a capacitor across two of its leads",
  ],
  decided_by: "Q4_P5's marking, and unpowered readings from its leads to U1_P5 pin 16 and to J20's return",
}

data p4261_vdd_bypass_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "on each carrier, the beige two-terminal part directly across from U1_P5 pin 21 is VDD's bypass capacitor",
  sources: [
    "TI SNVS950C pin 21 VDD: 'Internally sub-regulated 4.85-V bias supply. Connect a 1-uF capacitor on this pin to ground for bypassing'; section 8.3.7: a ceramic bypass of 1 uF or greater, placed as close to the VDD pin as the PCB layout allows",
    "on both the E1 and the K1, pin 21 is reported at 0 ohm to the part's top end (no baseline recorded), with a visible trace between them; the two boards' parts are each their own",
    "an unmarked beige body is how a ceramic chip capacitor commonly looks, which does not identify one",
  ],
  decided_by: "its bottom end at the shorted-probe baseline to J20's return and its top end not; then its capacitance read out of circuit or from the board's documentation",
}

// PIN 7 IS HELD AT 0 V; Q301, HELD ON, IS THE LEADING CANDIDATE. Read on its own lead at 48 V, pin 7 is
// far below its threshold (controller_enable_standing), so the input stage is held off by its enable. Unpowered, the
// lead's path to ground is one-way, and its node reaches bare pads on the back; no in-circuit
// resistance names a part on it, and arithmetic over two such readings is a lead for a direct reading,
// never a component's value (product.electrical.measured_netlist).
data p4261_enable_network_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "U1_P5's UVLO/EN (pin 7) reads 0 V with the source at 48 V, read with the probe on its own lead: below its 2.41 V minimum, so the tested configuration has not shown a permissive enable input and the input stage is held off by its enable. The leading candidate for what holds it is Q301, held on with nothing to release it: at 54 V, Q301's lead b node reads about 4.9 V and the far end of the resistor feeding it 54 V, the input itself; Q300's lead b -- the input that would pull Q301's lead b down -- reads 0 V; and P6, on Q301's lone lead, reads 0 V. Under the candidate BSS138 pinout (K38) that is Q300 off, Q301 on and P6 at the return; P6 is pin 7's by the operator's ruling and the third wire's signature, not by a reading, and Q300's lead b, followed by eye toward U51, is where an enable would arrive. Other causes stay live: P6 not being pin 7's node after all, another pull-down, no pull-up to raise pin 7 once Q301 releases it, another protection or logic condition, or damage from the probe incident",
  sources: [
    "energized at 48 V with nothing wired to the chip, the probe held on the leads: pin 8 about 1.8 V -- what its back-side pad read at 48 V, so the count from the pin 1 marker holds -- and pin 7 0 V (controller_enable_standing). A probe touching nothing also reads 0 V; pin 8 was read the same way just before. One source setting, so whether pin 7 moves with the input is unread (enable_projection)",
    "Q21_P5 and Q22_P5 read blocking at 48 V (input_switch_standing), and U1_P5's OVLO reads below its 2.39 V minimum at 48 V on its own lead (controller_overvoltage_standing), as the pad reported on pin 8 (no baseline recorded) did at 48 V and 36 V: overvoltage lockout is not what holds it off. TI SNVS950C's design example, section 9.2.1.2.6 option B (R3 = 95.3 kohm, R4 = 3.74 kohm), predicts the OVLO readings -- a reference circuit, not this board's parts",
    "unpowered, pin 7's own lead to J20's black lead: over range on the 200 ohm range both ways; about 535 ohm with the red probe on J20's lead; over range on the 2k range and about 11 kohm on the 20k range with the red probe on pin 7. The path is one-way; which way it conducts waits on this meter's resistance-mode polarity, which is unverified. The first wire read the same pattern to the ground pad, consistent with its having been on pin 7 then -- still no join of it, and its later readings stay disputed (e1_pin7_attachment)",
    "a close photograph of U1_P5's left-hand row, no wire on it, shows no solder bridge between leads 1 and 10; and a bridge to pin 8 or to ground would have read low from pin 7's lead",
    "unpowered, the ringed point RP1 right of U1_P5 read about 1.3 kohm from pin 7's own lead, the lowest the operator found near the lead on the front; no point near pin 7 on the front reads at the baseline to it",
    "a third wire, W4, taped at the left-hand row, reads pin 7's signature (about 11 kohm to ground with the red probe on it) and 16 kohm to pin 8's pad; three bare pads on the back beside Q5_P5 and D5_P5 (P5, P6, P7 of the labelled photograph) read 0 ohm from it, with no baseline recorded, and it still read about 12 kohm to ground afterwards. No reading joins W4 to the lead (the tape covers it), so P5 to P7 are pin 7's only by the wire's signature and by the operator's ruling of 2026-10-19 ('yes i am hyper confident that p6 == pin 7'), which settles the question in the record without being a reading. The cluster's pads carry no parts on the E1, and the same cluster is bare on the K1 (photograph, bench-session upload c21ab386): its empty places are the design's, not a part missing from the E1",
    "unpowered, the cluster's other pads read to J20's black lead, J20's red lead and VDD's point (the top end of pin 21's beige part): P10 is reported as ground (no baseline recorded); P1 to P4, P8 and P9 read above the baseline to all three. No pad of the cluster joins pin 7's pads to the return, the input or VDD directly, so its empty places are not a missing direct pull-up or pull-down to those; P9 beside the grounded P10 reads to none and did not read 0 from the third wire. Within about a centimetre on both faces, the third wire's node reaches only the three bare pads",
    "unpowered, the lone lead of Q301's three-lead package on the back reads 0.00 ohm to P6: the first fitted part found at P6, which no reading yet joins to pin 7's lead (it is pin 7's only by the third wire's signature and the operator's ruling). Q301's 'K38' marking is a candidate for Diodes Incorporated's BSS138, whose pinout puts the drain on the lone lead -- the open-drain device TI describes for holding UVLO/EN low -- a lead, not Q301's established role. Q300 and Q301 both carry the marking 'K38' (operator, photograph bench-session upload 42ffb97b); the code matches Diodes Incorporated's marking table, but no maker is read from the parts themselves, so neither's type nor pinout is established (e1_k38_candidate)",
    "unpowered, Q301's lead a reads 0 ohm and Q300's lead a 0.00 ohm to J20's return, and Q301's lead b 0.00 ohm to Q300's lone lead. No session recorded a shorted-probe baseline or the range, so these zeros, the third wire's to P5 to P7 and Q301's lone lead's to P6 are reported zeros, not joins (product.electrical.bench_session), and the netlist keeps each pair's points apart. Read as joins, Q300's lone lead drives Q301's lead b, and Q301's lone lead is on P6. Under the candidate BSS138 pinout with the silkscreen triangle on pin 1 -- lead b the gate, lead a the source, the lone lead the drain -- that is two N-channel low-side stages, Q300 able to pull Q301's gate to the return and Q301 able to pull P6 to it. The K38 identification is a candidate, so this shape is a lead, not the circuit's established role",
    "unpowered, the resistor beside Q301 has its nearer end reported equal to Q301's lead b ('==' and later '0.00ohm', no baseline recorded); its far end's trace, followed by eye, runs on the front toward D5's tab beside J20 and up past the bare U2_P5 and U3_P5 footprints toward U1_TSE beside J1, reading 0 ohm as far as about U2_P5 and about 2 kohm beyond (hedged, points named by place). The operator reads the layout as two input sides, J1's backplane and J20; with J20 energized at 54 V the far end reads 54 V",
    "energized, the via on Q301's lead b node (by the visible trace and a reported 0.0 ohm, not a baselined reading) reads about 3.8 V with the source at 38 V and about 4.9 V at 54 V, against J20's black lead: it rises with the input, not in proportion. If lead b is Q301's gate, as the candidate BSS138 pinout has it, a few volts there -- above that part's 1.5 V maximum gate threshold (DS30144) -- would switch Q301 on and hold P6 at the return, consistent with pin 7's 0 V if P6 is pin 7's node; and the voltage comes from the input itself, so with J20 energized the stage is held off unless Q300 pulls that node down",
    "energized at 54 V (2026-10-20), against J20's black lead: Q300's lead b 0 V, P6 0 V, and the far end of the resistor beside Q301 54 V -- the input. With the via's 4.9 V at 54 V, Q301's lead b sits near a tenth of the input, fed from it through that resistor, and Q300's lead b at 0 V says nothing drives Q300 on. These are readings at P6 and at the parts' pads, not at pin 7, which read 0 V at 48 V on its own lead",
    "unpowered (2026-10-20): across the resistor beside Q301, 26 kohm -- in circuit a resistor reads at or below its value, so it is at least about 26 kohm and '180' as 18 ohm is excluded; enlarged, its marking reads '18D', 150 kohm by the EIA-96 code, unresolved until the third character is confirmed (e1_q301_resistor). Q300's lead b reads 8 kohm to J20's black lead and 24 kohm to VDD's point; the via reads 0.0 to Q301's lead b. The zeros re-read (ZB2 to ZB6) name no dial position, and the shorted probes read '.005' and '.03 or something at 2k', so none of them joins",
    "Q300's lead b's trace, followed by eye on the back (bench-session upload 54ded557, drawn by hand), runs the length of the board to beside U51, a two-row package next to U49; no reading joins the trace's end to Q300's lead b. Both read 'LV165A / 2BKG4 / AEC0' (2026-10-20), TI's marking for the SN74LV165A parallel-load shift register: a part that reads eight inputs and shifts them out serially, with two serial outputs. Unpowered on the 20k range (2026-10-20), Q300's lead b reads 2.5 to 6 kohm to each of U51's pins 1 to 8, pin 8 (GND under SCLS402R) the same 2.5 kohm as J20's black lead, and the pin 8 pair moves with the range (about 600 ohm on 2k, 20 kohm on 200k; the first report of '20 ohm' was that 200k reading): a path holding a junction, not a join, so no U51 pin is read as the gate node's (q300_gate_path_reading). On the front, beside U92, the operator reports a point near U55 (sixteen terminals, marked 'ZVK' over '22J': a candidate SN74AVC4T774 level translator, extdeps.electronic_component.ti_sn74avc4t774, whose top edge under that pinout is DIR2, DIR1, VCCA, VCCB and no data port). Further along the front, a run of points each about 500 ohm from Q300's lead b on the 2k range: the pad beside Y50's upper corner, both ends of a small resistor beside U43, the capacitor at U43's right, and the lower pad of the part above U500, whose trace runs to U500's upper-right contact, itself 500 ohm; U500's other read contacts are 800 ohm (its ground, '0.00' to J20's black lead, no baseline) to 1.5 kohm, and the via beside the chain 800 ohm. Read each way, the pad reads 500 ohm to the return with red on it and 300 ohm swapped, and 500 then 1000 ohm to Q300's lead b, so these are paths holding junctions, not a resistor chain (pair_polarity_standing). So the gate's path to the return reads 800 ohm there, the 500 ohm points are a distinct net nearer the gate, and U500 (eight contacts, marked 'FZ' over 'YY', unresolved, beside the crystal Y50 'T327K / EV13' and U43, a five-lead SC70 marked WEJ that TI's SCLS739F addendum gives to the SN74LV1T08 two-input AND gate, extdeps.electronic_component.ti_sn74lv1t08, a candidate) meets that net at one contact (q300_gate_path_reading). U55's pins 16, 15 and 14 (DIR2, DIR1, VCCA under the candidate pinout) each read 500 ohm from Q300's lead b and pin 13 (VCCB) 1200 ohm, the data ports about 1500 ohm: two direction inputs reading what the supply pin reads are tied to VCCA, and a supply rail 500 ohm from the gate is the simplest reading of every front-side 500 ohm point, the gate reaching that rail through a junction, which would make U500's one 500 ohm contact its supply pin rather than a signal. The operator further reports many pads in the unpopulated clusters beside both module receptacles J3 and J4 (U3's neighbourhood on the back below Q300 and Q301, and the like cluster at the other receptacle) reading about 500 ohm from the gate, unnamed (e1_site_clusters_said), and one of them named as a reference, U3's lower-right lead as photographed (U3 a six-lead part marked 'B5' and more, unresolved), 500 ohm: a fourth place the same relationship appears, which is what a rail looks like. Whether the 500 ohm points are a rail or a signal is a powered reading, not yet taken: a rail sits at a steady few volts in every phase, and where the gate's pull-up would come from, if it has one, is then the open question. A crystal beside a candidate AND gate and an eight-contact part, with traces leaving toward the module receptacles, reads more like a qualified timing, reset or sideband distribution than part of the 48 V power path; whether U43's inputs come from Y50 or the board's controls and its output goes to U500 or the receptacles is unread (gate_pin_text) reading lower to Q300's lead b than the return does; its readings join the record once their points are named. Whether U51 reads Q300's node or could drive it is the role of the exact pin the trace meets (register_pin_direction_text), which is unread: a parallel input reads it, a serial output could drive it, a control or clock pin would be shared with whatever clocks the part",
    "TI SNVS950C: the load can be remotely switched off by taking UVLO/EN below its threshold with an open-collector or open-drain device; released, the LM5066I switches on (extdeps.electronic_component.ti_lm5066i vendor statement) -- a mechanism the part admits, not one read on this board",
    "a pasted report, not read against its source: OCP MGX gates a tray's power-on on a management presence and standby handshake (PRSNT, STBY_EN, STBY_RDY). The P4261 is not established as an MGX tray, and no such signal is traced to pin 7",
    "unpowered, the K1's pin 7, read with the probe held on the lead, is reported at 0 ohm to one end of a '200' resistor and not to the ringed via below-right of U1_P5 (hedged: 'seem electrically different'). The K1 is an earlier revision (-100, PCB A01; the E1 -201, PCB B00), so it is a lead about the design, not the E1's network, and it does not separate whether the 2026-10-19 bridge changed the E1's pin 7 network; the bridge was a MOSFET's source to its drain, not on pin 7's network",
    "energized at 48 V, the top end of the part across from pin 21 (reported at 0 ohm to pin 21, read directly, not through the wire, no baseline recorded) read about 4.86 V, hedged ('like 4.86 or something'; first 'it reads 5v'): U1_P5's bias supply reads live at a VDD-like level -- at a point reported at 0 ohm to pin 21, not joined to it by a baseline and not yet separated from pins 20 and 22 -- so on that reading the controller is not off for want of its own supply",
    "the 11-13 mA draw does not establish which circuits are powered, so it neither shows nor excludes other powered logic",
    "U4, the heatsinked device below J4, read 2026-10-21 with its heatsink lifted: Intel's Cyclone 10 GX 10CX085YF672E6G (extdeps.electronic_component.intel_10cx085), an SRAM-based FPGA that loads its configuration at every power-up from a serial flash it masters, a host, or JTAG, and whose user pins, before configuration, pull up or float as its nIO_PULLUP strap selects (the row names the strap rather than the pull-up). The device that would drive Q300's gate is therefore programmable logic whose configuration source and state are unread: the three Micron-format BGAs beside it (K1 listing) are the configuration-flash candidates and the 2 x 5 header below it the JTAG candidate. A gate node at 0 V with 800 ohm to the return is what an unconfigured FPGA's pin, or a configured one holding it low, both look like from outside, so the gate's level does not by itself identify the FPGA's state",
    "U5_2, below U4, read 2026-10-21 with the Microchip logo as CEC1736 (extdeps.electronic_component.microchip_cec1736): a platform root of trust with secure boot, the part NVDebug's debug dumps name beside the FPGA as the ERoT. Three Micron-format BGAs sit beside it (U2_2 and U3_2 'RW188', a third 'RW251'). If U4's configuration flash is one of them and U5_2 guards it, a relation the part's capabilities admit but no reading on this board yet establishes, U4 configures only once U5_2 releases it, and a flash image the root of trust declines, or a root of trust not provisioned on an engineering unit, leaves U4 unconfigured with no switch able to change it. The three flashes decode (Micron's FBGA decoder, 2026-10-21) to two MT25QU01G (U3_2 and U2_2, 1 Gbit each, two die) and one MT25QU02G (2 Gbit, four die), all 1.8 V quad-SPI: a pair of 1 Gbit parts fits a primary and a recovery FPGA image (about 92 Mbit each for this device) and a single 2 Gbit part fits a firmware store, but which image each holds is unread. Energized and settled, DS1_2 beside U5_2 blinks on 1.0 s, off 1.5 s and DS6 beside J68 on 1.36 s, off 1.32 s (two videos, measured frame by frame); two different periods are two different sources, and which part drives each is unread",
    "energized (2026-10-21), at the pads of the three inductors beside U4 against J20's black lead: on the K1 at 40 mA the 2R2 0 V, the 4R7 nearest U4 0 V, the farther 4R7 3.2 V at its pad closer to U4 and 3.0 V at the other; on the E1 settled the nearest 4R7 about 3.2 V and the 2R2 0.94 V (k1_inductor_volts_at_40ma, e1_inductor_volts; the farther 4R7 unread on the E1). Later that day the probe joined the E1's nearest 4R7 to the ground pads under it while energized (e1_inductor_short_incident): the source then cycled CC, 13 mA, 97 mA, CC, and unpowered both of that 4R7's pads read 0 on the 2k range to J20's black lead where the K1's reads about 4 kohm, so that rail is shorted to the return since the incident, a fault on a rail downstream of the enable network, and the E1 is unpowered until it is split at the inductor. Photographed afterward (e1_near_4r7_area_photo), U21 sits directly above the inductor and the silkscreen 'U1_2' at the frame's edge; U21 reads 'P617A / 01 14 / 226' (e1_u21_marking_photo), NXP's PCA9617ADP I2C-bus repeater, as does U53 below it, so U21 is not the inductor's converter and J24 beside them is an I2C / SMBus header candidate; the converter is the 8-lead part beside the inductor marked 'BDFP / 528' (the U10_P2 silkscreen beside it on the E1), MPS's MP2333CGTL by its documented top marking (extdeps.electronic_component.mps_mp2333c), with its SW lead on the inductor's pad; U100 ('C3U / S22 / 25'), first taken for the converter, has no lead on the switch node (e1_u100_lead_resistances, k1_u100_lead_resistances, read 2026-10-23). Which loads the rail supplies, the island included, is unread. Read as converter outputs, one of the three inductor outputs recorded is present on the K1 and two are absent where the E1 had all three; whether an absent output is a missing input, an inactive enable, a converter fault or an overloaded load is unread, and the missing 1.8 V at J68 R2 is a fourth absent output of the same standing. On the K1 a momentary bridge across J30's A and B at 40 mA changed neither the current nor the lamps, and S1's pole 2 cycled alone with S2 set as on the E1's P1 left the current where it was (k1_transitions): the logic that answers both on the E1 is in the domain the K1 has not powered",
  ],
  decided_by: "Gated on the E1's rail repair: the converter beside the 4R7 nearest U4 is identified and its readings and the separation that decides the casualty are p4261_near_4r7_converter_hypothesis's; the E1 is not energized until that rail reads no unexplained low-resistance path to J20's black lead, and the post-repair start is a new phase, never a rewrite of the pre-incident ones. Then, once repaired and settled, the farther 4R7's two pads against J20's black lead (3.2 and 3.0 V on the K1), and what enables the two converters the K1 holds at 0 V: U9_P2's and U10_P2's enable pins, traced unpowered to the part that drives them, then read energized on both carriers, which names the step the K1 does not take. With the USB Blaster's I/O referenced to R2, a read-only chain scan: the IDCODE, CONF_DONE and nSTATUS, never a configuration, erase or nCONFIG pulse. J24's positions energized in P0, P1 and the settled state against J20's black lead (a position at a steady logic voltage is a supply reference, three that idle high and one that idles low or toggles are the JTAG shape), and unpowered against a baseline to U53, U69 and U21; U4's VCCBAT, read energized at a pad against J20's black lead (its power-on reset holds until it is present). Which part drives DS1_2 and DS6 (U5_2's or U4's pin, traced unpowered), so that each blink names its source; U5_2's release of U4 (its reset or release output to U4's nCONFIG, traced unpowered, then read energized); and the three BGAs' part numbers from Micron's decoder. Energized and settled, CONF_DONE's state (at the FPGA's status LED or a test point once its ball is traced; high reads configured, low unconfigured), which separates a sequencer holding the gate low from one that never loaded; the markings of the three BGAs beside U4 and whether the 2 x 5 header is JTAG (its pins to U4's TCK, TMS, TDI and TDO once traced), through which an unconfigured device reports CONF_DONE directly. Unpowered, first the probes shorted on one recorded range, then on that range: pin 7's own lead to P6, which joins P6 to pin 7 or separates them; the reported zeros re-read so they join or separate (Q301's lone lead to P6, Q301's and Q300's lead a to J20's black lead, Q301's lead b to Q300's lone lead, the resistor's nearer end to lead b, and the via to lead b); Q300's lead b to the exact U51 pin its trace meets, on that range, then that pin's role under SCLS402R (a parallel input reads the node, a serial output could drive it); the resistor's third character confirmed; and whether pin 7 has a pull-up, pin 7's lead to J20's red lead. U51's and U49's markings read 'LV165A' (SN74LV165A, 2026-10-20), so what clocks them is the next part to name. The K38 maker read from a date-code line or another maker's table before any reading names a terminal by the BSS138's pinout. Read (2026-10-20): the pad to J20's black lead 500 ohm with red on the pad and 300 ohm swapped, Q300's lead b to the pad 500 and 1000 ohm, so the paths hold junctions. Then energized at 48 V with all four poles toward ON and settled, against J20's black lead and at pads rather than the UQFN contacts: the lower pad of the part above U500 (the 500 ohm point) and the end of U43's capacitor nearer U43, then the same pad with only S2's poles toward ON; the 500 ohm pad at about 0 V while Q300's lead b reads 0 V says U500's contact holds the node, a few volts there says the 500 ohm path is not a wire. U500's marking read sharply and its dot's corner, then the maker's table. Nothing drives Q300's lead b or pin 7 until a reviewed decision. Later, read-only PMBus status (STATUS_INPUT 7Ch, DIAGNOSTIC_WORD E1h)",
}

// THE CONVERTER IS THE LEADING CANDIDATE FOR THE E1'S RAIL SHORT, NOT YET THE VERDICT. Read against the
// K1 lead by lead, three of the E1's leads sit near the return where the K1's read kilohms: SW, which
// the shorted rail explains by itself; VIN, 5 kohm there and 10 ohm here; and BST, 134 kohm there and a
// reported zero here. VIN and BST are nodes, not isolated pins: the input capacitors and whatever feeds
// VIN sit on the one, the bootstrap capacitor and the device's internal charging path on the other, so
// a resistance reading names the node and not yet the part on it. What separates the device from the
// parts around it is a read with one of them gone.
data p4261_near_4r7_converter_hypothesis: InvestigationHypothesis = InvestigationHypothesis {
  claim: "the separation is read: removing the converter beside the 4R7 nearest U4, MPS's MP2333CGTL (marked BDFP 528), and cleaning its footprint cleared the VIN-SW short (the bare footprint's VIN at 5.3 kohm to the return against the K1's 5.5 kohm, where it read 0-30 ohm with the part fitted), so the converter, or a connection its removal disturbed, carried it; which of the two is not distinguished, the lifted part being unread. And a low reading remains on the rail with the converter gone: the inductor's terminal away from the converter still reads about 1 ohm to the return with the converter off the board, where the K1's SW pad reads 8.4 kohm, so replacing the converter alone has not been shown sufficient; the reading does not name a capacitor, a load or the copper. Before the separation the claim stood: its VIN reads 0 ohm to the switch node both ways, metallic, where the K1's same converter reads 13 kohm, and VIN and SW both read near the return where the K1's read 5 kohm and 8 kohm. Not yet the verdict: a 0 between VIN and SW is the device's high-side switch, a bridge between those adjacent leads, or two separate paths to the return (an input capacitor shorted beside the shorted rail) reading as one, and the three are separated only with the device off the board; the bootstrap node reads as the K1's does once re-read; the rail's own parts are separated only by a lift; and U100 is not on the switch node",
  sources: [
    "E1 against the K1's same converter (U10_P2), lead by lead, 2026-10-31 (e1_converter_lead_resistances, k1_near_converter_lead_resistances): GND 0 / 0; SW 10-30 ohm unsettled / 8 kohm; VIN 10 ohm / 5 kohm; PG 9 kohm / 16 kohm; BST 0 / over range; EN 130 kohm / 130 kohm; SS over range / 19 Mohm; FB 50 kohm / 50 kohm. PG's difference is the rail's own, seen through a pull-up. The K1's farther converter (U2_P2, k1_converter_lead_resistances, read first that evening) agrees lead for lead except BST at 134 kohm and SS at 50 Mohm, so the BST node's DC path to the return differs by instance or by circuit, and the E1's 0 at BST is read against U10_P2's over range",
    "VIN and BST are nodes, not isolated pins: VIN carries the input capacitors and whatever feeds it, BST the bootstrap capacitor and the device's internal charging path (the datasheet's block diagram), so a low reading at either names the node and not yet the part on it",
    "the SW lead at 10-30 ohm, unsettled, against the inductor's pads at 'ground' on the 2 kohm range on 2026-10-21 (e1_after_short_resistances), a range whose last digit is 1 ohm: not reconciled. Probe contact on a 0.5 mm lead, the lead's attribution, the site or the copper between lead and pad; the SW-to-pad read decides",
    "the datasheet's circuit joins BST to SW through a 1 uF capacitor in series with 20 ohm (extdeps.electronic_component.mps_mp2333c): a shorted bootstrap capacitor would read about 20 ohm from BST to SW if the board fits that resistor, and the baseline if it does not or if the short is inside the device",
    "U100's eight leads (e1_u100_lead_resistances, k1_u100_lead_resistances): the dot side at the return on both carriers, the far side kilohms, and on the K1 no lead at the baseline to either pad of the inductor beside it",
    "the five pair readings of 2026-10-31 (e1_converter_pair_resistances, k1_converter_pair_resistances): SW to the 4R7's converter-side terminal 0 on both carriers, so the pin map holds on the K1 (a comparison board, its health not established) and the E1's SW lead is on its pad; the E1's far terminal (OUT) to the return 0 after the cleaning; the E1's BST to SW open, so the bootstrap capacitor is not shorted and BST's earlier 0 to the return cannot stand beside it; the E1's VIN to SW 0: the device's high-side switch, a bridge between those adjacent 0.5 mm leads, or VIN and SW each shorted to the return by separate parts, which reads the same in circuit (the earlier VIN to the return at 10 ohm and SW near the return are the two legs of that reading)",
    "a line the operator can feel along the row of the converter's inductor-side leads, from the via at their right (e1_fissure_said, e1_converter_lead_row_photos_1031), where the probe slipped on 2026-10-21: a probe dragged across 0.5 mm leads can smear solder between two of them, and a bridge between VIN and SW reads 0 ohm exactly as a shorted high-side switch does, so the 0 at VIN to SW is not yet the device's; and a VIN-to-SW bridge made while the board was energized would have put the converter's input voltage on the inductor and the rail, so the rail's 0 to the return may be a part downstream that died of that, with the device alive or dead",
    "the consistency checks of 2026-11-01 (e1_converter_pair_resistances, k1_converter_pair_resistances): BST to the return over range with red on the lead and 8.4 Mohm reversed, so the first sweep's 0 at BST is retired by two readings and kept only as the contradiction it is; VIN to the inductor's converter-side terminal 0 both ways, the VIN-SW path confirmed metallic without two tips on adjacent leads, against 13 kohm at the K1's same converter; VIN to the return 0-30 ohm, a little jumpy, low as a VIN-SW path onto the shorted rail predicts and read on a 0.5 mm lead",
    "read with every reported zero as a join, the E1 record contradicts itself at six readings, every one a non-zero reading at a lead whose node a zero joins to the return: SW and VIN to the return at 20, 10 and 0-30 ohm where SW to its pad, VIN to SW, VIN to the pad and the pad to the return read 0, and three readings at BST (open to SW, over range and 8.4 Mohm to the return) where the first sweep's BST read 0 to the return. The first group is near-zero figures at leads beside true zeros at the same nodes; the second is one first-sweep reading every later one disagrees with. That reading is hypothetical: the measured netlist joins only readings at a recorded baseline (is_at_baseline refuses a zero with no baseline and an auto-ranging join), so it joins none of these zeros and the six are not contradictions there. Under the hypothetical reading none is read diagnostically, none has its cause assigned (probe contact on 0.5 mm leads is a candidate for the near-zero figures, not an established cause), and nothing is deleted",
    "the E1's cleaned footprint (e1_footprint_resistances, e1_after_lift_rail_resistances, photographs e1_footprint_photos_1101 showing no bridge): SW about 0 to the GND pad and to the return; VIN 5.3 kohm to the return; VIN to SW 2.7 and 5.5 kohm by the probes' way, VIN's own path with SW at the return; OUT 1.4 ohm to the return. The lifted part itself was not read (too small to hold), so 'the part or something removed with it' carried the VIN-SW short; the footprint's photographs show nothing left between those pads",
    "after the footprint was brushed, the probes together read about .03 ohm and the SW pad to the 4R7's terminal away from the converter the same (e1_footprint_resistances, e1_sw_out_said): SW and OUT are one node through the inductor, so SW's ~0 against OUT's 1.4 ohm to the return is a contact difference at the return end, not two faults; one short holds that node between about 0 and 1.4 ohm to the return",
    "the K1's bare footprint (k1_footprint_resistances): VIN 5.5 kohm and SW 8.4 kohm to the return and VIN to SW 13.3 kohm both ways, about those two in series, so on the K1 the VIN-SW figure read with the part fitted was the board's, through the return; the E1's footprint read on the same pads decides whether the E1's 0 went with its part",
    "the E1's converter lifted 2026-11-01 (e1_u10p2_lift), the inductor in place; the first reading after it, SW 'shorted' to GND (e1_footprint_resistances), was taken before the footprint was reported cleaned, so a residue bridge between those adjacent pads is not excluded",
    "the device's 4.2 V to 18 V input range bounds the path feeding VIN (pin 2), which is unread; it says nothing about J20's voltage (p4261_j20_main_input_hypothesis)",
    "both sites cleaned and inspected under the Andonstar 2026-10-31 with nothing broken, cracked or singed (e1_inductor_short_incident); the carriers differ in population around the inductor (two 0603 parts under the E1's, four empty pads under the K1's; two large ceramics against one), so the K1 is a reference for the converter and not for every part on the rail",
  ],
  decided_by: "The SW-inductor-OUT connection is read at the probe baseline after the rework (e1_sw_out_said). The supply tested alone, no board connected (0.30 V and 0.50 A set, OCP shutdown off with the current limit kept, the no-load output read with the Fluke in DC volts, then a lead across the terminals for the limited voltage, current and CC). Then a bounded thermal test with the converter off the board: the positive lead on a wire soldered to the 4R7's terminal away from the converter, never a hand-held probe, the return at J20's black lead, starting at 0.30 V and 0.25 A and stepping toward at most 1.0 V and 1.0 A, under the rail's 3.2 V working level, at most 30 s per step, the camera on the inductor, its ceramics and the parts near them. Removing the converter removed its own path back to VIN, not every path: an injected rail can back-power other parts through their protection structures, which the low voltage limits but does not exclude. A warm part is where power dissipates, not by itself the cause; it is lifted and OUT re-read before anything is fitted. The inductor lifted instead separates the SW node's parts from the rail's if the image is ambiguous. Which loads the rail supplies waits on that."
}

data p4261_hypotheses: List<ClassifiedHypothesis> = [
  ClassifiedHypothesis { hypothesis: p4261_j20_main_input_hypothesis, class: DesignAndSpecimen { positions: [e1_at(d: "J20"), e1_at(d: "F1"), e1_at(d: "F300")], asset: p4261_e1_b }, concerns: ["e1-j20-away-row-reaches-f1", "e1-f300-spans-j20-input"] },
  ClassifiedHypothesis { hypothesis: p4261_grey_path_hypothesis, class: DesignRelationRemainder { positions: no_positions() }, concerns: no_keys() },
  ClassifiedHypothesis { hypothesis: p4261_enable_network_hypothesis, class: DesignAndSpecimen { positions: [e1_at(d: "U1_P5")], asset: p4261_e1_b }, concerns: no_keys() },
  ClassifiedHypothesis { hypothesis: p4261_local_control_hypothesis, class: SpecimenDiagnostic { asset: p4261_e1_b }, concerns: no_keys() },
  ClassifiedHypothesis { hypothesis: p4261_q4_temperature_diode_hypothesis, class: DesignRelationRemainder { positions: [e1_at(d: "Q4_P5"), e1_at(d: "U1_P5")] }, concerns: no_keys() },
  ClassifiedHypothesis { hypothesis: p4261_vdd_bypass_hypothesis, class: DesignRelationRemainder { positions: [e1_at(d: "U1_P5")] }, concerns: no_keys() },
  ClassifiedHypothesis { hypothesis: p4261_near_4r7_converter_hypothesis, class: SpecimenDiagnostic { asset: p4261_e1_b }, concerns: no_keys() },
]
