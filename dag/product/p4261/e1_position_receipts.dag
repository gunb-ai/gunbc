module product.p4261.e1_position_receipts

import product.p4261.e1_candidate_source { E1CandidateSource }

// THE 2026-11-03 E1 ATLAS RECEIPTS, AS DATA. Which designators the pass was entitled to put on NVIDIA's
// design list, which it held back, and what each of those rests on. The receipts are the referent, so the
// model is joined against them rather than against its own totals: a count cannot tell a dropped position
// from a swapped one (gunbc.design_argument::fail_closed, "Completeness is an identity join, not a count equality").
//
// GENERATED by gunb-ai/gunbc-private, branch p4261/e1-atlas-handoff, docs/plans/2026-11-03-p4261-e1-atlas/scripts/gen_e1_position_receipts_dag.py at b90d949
// (the hash is this script's own last commit on that branch, which is what a reader re-running it needs; a
// '-dirty' suffix means the script had uncommitted changes at the time and the output is NOT reproducible
// from any commit); do not hand-edit. The script reads inventory_top.csv and inventory_bottom.csv
// for the designator reads, per_photo_readings.jsonl and per_photo_readings_sd_2026-11-03.jsonl for the
// sightings the merged inventory lost, and final_pass_corrections.json for the reads the final pass settled.
//
// The base rule for admission, stated so a reader can re-run it: the row's kind is above the passive level
// (or it is one of the model's own bulk capacitors, which the handoff puts in scope), the designator is
// transcribed 'clear', its standing is 'confirmed' or 'final-pass critic', and the designator carries no
// '?' or '*'. Admitted: 261, of which 249 come from the rule alone and 12 are
// declared exceptions naming the receipt that carries them. Held: 25, each with its reason.
// Excluded entirely -- and so countable only from the receipts, never from the model -- are the 81
// distinct designators whose read carries a '?' or a '*': a character no read was entered for is not a
// designator, and a position would put our unread character into NVIDIA's design facts.
//
// `standing` is what the merged inventory recorded. What licenses an exact designator is a typed
// authority, and it is the SAME type in both places a name is minted -- a position's exception and a
// held exact read -- so both are checked by the same rules: either a receipt read the label in full,
// or somebody read it off named frames in the store, which says who, when, and where on each image.
// Nothing on that path can say 'read, but not in full', and there is no arm for 'nobody read it': a
// label only partly transcribed and a label nobody read are both one DesignatorCandidate arm, which
// holds a plain proposed_name and never a Designator, with `receipt_read` saying which of the two the
// receipts recorded and so what the obligation owes next. So a
// spelling nobody read, or one read only in part, cannot become the identity the model joins on --
// not because a test refuses it, but because there is nothing here to write it in. The generator
// classifies each row from the receipts (the merged inventory's `designator_read` column or a
// per-photo item's `designator_legibility`, whichever reads stronger) and STOPS rather than guess an
// arm for a state it has none for. `basis`, beside a receipt authority, names the frame when a
// per-photo frame carried the read and quotes the merged column when the two disagree; it is
// provenance for a reader to check and nothing in the model branches on it. The rule itself lives in
// the generator, which is the only thing that reads the CSVs.

import std.types { List, NonEmptyStr }
import std.content_hash { Sha256Digest, Sha256DigestHex }
import product.electrical.photograph { PixelRegion, PhotographCitation }
import extdeps.electronic_component.types { Designator, designator_of }

// How the receipts recorded one designator, and whether admitting it took more than the rule.
type PositionReceipt {
  designator: Designator
    // the label read verbatim; Designator's own equality is what joins it to a position. A
    // label no receipt transcribed never becomes one -- see UntranscribedCandidate.
  standing: NonEmptyStr
    // what the inventory's reading_standing column said
  rests_on: ReceiptBasis
    // how it was admitted, and -- inside the arm that needed an exception -- how well the
    // label was read. Which arm you must write IS the claim you are making: a row the base
    // rule reached has no field in which to say the label was only partly read, so that
    // contradiction is not tested away, it is unauthorable.
}

// How a row was admitted. The base rule admits a label read in full, so `rests_on: RuleRead`
// beside a claim of 'partial' has no constructor; it carries no field at all, because there
// is nothing to record beyond that the rule reached it. An exception carries the one thing
// that makes an exact designator legitimate at all: what its spelling is backed by.
type ReceiptBasis =
  | RuleRead {
    }
  | NamedException {
      why: NonEmptyStr
        // the receipt that carries the admission, said out loud
      authority: DesignatorAuthority
    }

// One frame a label was seen in, as someone stated it: which bytes, where in those bytes the
// label sits, and which file the store keeps those bytes under. The bytes are the identity and
// they are spelled the way the store spells them -- a PhotographCitation, which is already a
// digest plus an optional region -- because the join that decides whether a board reading points
// at these very pixels is defined on that type, and a second spelling of the same pair would
// have had to be hand-joined everywhere it met one. It used to be three loose columns, and the
// witness carried the join. The file name stays beside the citation for a reader, and the
// witness checks the two agree in the store, so a name typed beside the wrong digest is caught
// rather than trusted. A citation whose region is Absent is a box gap, not a missing file.
type LabelSighting {
  citation: PhotographCitation
  file_name: NonEmptyStr
}

// What backs the exact spelling of a designator, wherever one is minted: a position's
// exception and a held exact read carry this same type and are checked by the same rules
// (gunbc.design_argument::single_authority -- one vocabulary, one checker). This is the invariant the module exists for:
// a Designator is minted only where someone states where every character came from -- a
// receipt that read the label in full, or a person who read it off named frames in the store.
// There is no arm for 'nobody read it' and no field that can say 'read, but not in full':
// nothing here can license a partial spelling, so a Designator whose characters were only
// partly read is not merely rare, it is unauthorable. The states below a full read are the
// candidate arms of HeldReceipt, which carry a plain proposed_name and never a Designator.
type DesignatorAuthority =
  | FromReceipt {
      basis: NonEmptyStr?
        // where the read came from when a per-photo frame carried it rather than the merged
        // inventory row: the frame named and the merged column quoted beside it, so the two
        // disagree in the open instead of one silently winning. Provenance only -- nothing in
        // the model branches on it. Its absence means the merged inventory's own column.
    }
  | FromStoredFrames {
      read_by: NonEmptyStr
        // who read the label off the frames; 'the receipts' is not an answer, a person is
      read_on: NonEmptyStr
        // the day it was read, which need not be the day the frames were captured
      frames: List<LabelSighting>
        // the frames it was read off. Checked the same way wherever this type appears: every
        // digest resolves in the store by content, every file name matches the stored frame,
        // and at least one frame carries the box the label was read inside -- a read that
        // claims every character has to say where on the image it read them. A position
        // carrying this arm additionally has to be read on the board by one of the same
        // frames, digest and region both, so this arm cannot mint a name nothing read.
    }

// A read the pass refused to mint, with the reason. `why` names what would close it. The two
// arms are not interchangeable: a held READ still carries the exact label it did read, while
// a candidate has no exact spelling to carry -- its name is plain text, because Designator is
// the identity the model joins on and an unsettled spelling must not enter it. C3_F1 is a
// candidate: the final pass added the row and named the frame, and no receipt transcribed its
// label. A label read in part and a label never read are ONE arm here, because they hold the
// same fields and every consumer treats them alike -- two arms would be two copies of every
// check kept in step by review. What the receipts said about the label is a field instead.
type HeldReceipt =
  | HeldExactDesignator {
      designator: Designator
        // the label as read, every character of it: this arm exists only where the receipts
        // read the label in full, which is why it carries no legibility field. A row that
        // says otherwise is one of the candidate arms, and a legibility cannot be written
        // here because there is nothing here for it to sit on.
      standing: NonEmptyStr
      authority: DesignatorAuthority
        // the same authority a position's exception carries, checked by the same rules
      why: NonEmptyStr
    }
  | DesignatorCandidate {
      source: E1CandidateSource
        // WHICH candidate this is, by arm: the identity the model joins on. Citing an arm the
        // pass does not emit is a resolution error at compile time, so renaming or deleting a
        // candidate cannot leave board rows pointing at something that is gone. Nothing in the
        // model compares text to find a candidate -- `atlas_row` below is prose, for a reader.
      atlas_row: NonEmptyStr
        // the inventory row that saw it, said plainly so a reader can walk back to it. No join
        // reads this: it is what `source_key` was, kept for the human and demoted from being
        // the identity, because two candidates were once found sharing one such string.
      proposed_name: NonEmptyStr
        // what the pass calls it, as text only: the spelling is not settled -- some
        // characters were read and not all, or none were, and one unread character makes
        // the whole of it unsafe to mint -- see C3_F1's first draft
      standing: NonEmptyStr
      receipt_read: ReceiptRead
        // what the receipts said about this label, which is what the obligation owes next
      partly_legible_in: List<LabelSighting>
        // the frames that show the label, from the receipts that said so; resolved in the
        // store by content and file name, without inventing a box nobody drew. 'No receipt
        // read it' is not 'no frame shows it': where somebody can see the label in a stored
        // frame it is cited here, and still does not mint a Designator. Empty means nobody
        // has named a frame, which is a different gap and the obligation says so.
      obligation: NonEmptyStr
        // what would close it, named: which frame to read, or which closer shot to take
      why: NonEmptyStr
    }

// What the receipts said about a candidate's label. Either way the row stays a candidate:
// a partly-read label has unread characters and an unread one has no characters at all. The
// distinction is not decoration -- it says what the next read owes, the remaining characters
// of a label some of which was read, or a first transcription of one nobody has read. It
// lives on the candidate arm only: nothing that carries a Designator can hold it, which is
// the whole reason this module has a candidate arm at all.
type ReceiptRead =
  | PartlyRead { }
  | NotRead { }

