module product.p4261.e1_position_receipts

// THE 2026-11-03 E1 ATLAS RECEIPTS, AS DATA. Which designators the pass was entitled to put on NVIDIA's
// design list, which it held back, and what each of those rests on. The receipts are the referent, so the
// model is joined against them rather than against its own totals: a count cannot tell a dropped position
// from a swapped one (DESIGN §5, "Completeness is an identity join, not a count equality").
//
// GENERATED by docs/plans/2026-11-03-p4261-e1-atlas/scripts/gen_e1_position_receipts_dag.py at fa61d30
// on the private branch p4261/e1-atlas-handoff (the hash is this script's own last commit, which is what a
// reader re-running it needs; a '-dirty' suffix would mean the script had uncommitted changes at the time);
// do not hand-edit. The script reads inventory_top.csv and inventory_bottom.csv
// for the designator reads, per_photo_readings.jsonl and per_photo_readings_sd_2026-11-03.jsonl for the
// sightings the merged inventory lost, and final_pass_corrections.json for the reads the final pass settled.
//
// The base rule for admission, stated so a reader can re-run it: the row's kind is above the passive level
// (or it is one of the model's own bulk capacitors, which the handoff puts in scope), the designator is
// transcribed 'clear', its standing is 'confirmed' or 'final-pass critic', and the designator carries no
// '?' or '*'. Admitted: 262, of which 249 come from the rule alone and 13 are
// declared exceptions naming the receipt that carries them. Held: 24, each with its reason.
// Excluded entirely -- and so countable only from the receipts, never from the model -- are the 81
// distinct designators whose read carries a '?' or a '*': a character no read was entered for is not a
// designator, and a position would put our unread character into NVIDIA's design facts.
//
// `standing` and `transcribed` are provenance for a reader comparing this file with the CSV; nothing in the
// model branches on them. The rule itself lives in the generator, which is the only thing that reads the
// CSVs.

import std.types { List, NonEmptyStr }
import extdeps.electronic_component.types { Designator, designator_of }

// How the receipts recorded one designator, and whether admitting it took more than the rule.
type PositionReceipt {
  designator: Designator
    // the label read verbatim; Designator's own equality is what joins it to a position
  standing: NonEmptyStr
    // what the inventory's reading_standing column said
  transcribed: NonEmptyStr
    // what its designator_read column said, or 'not transcribed'
  rests_on: ReceiptBasis
}

type ReceiptBasis =
  | RuleRead {
      // the base rule reached it
    }
  | NamedException {
      why: NonEmptyStr
        // the receipt that carries the admission, said out loud
    }

// A read the pass refused to mint, with the reason. `why` names what would close it.
type HeldReceipt {
  designator: Designator
  standing: NonEmptyStr
  transcribed: NonEmptyStr
  why: NonEmptyStr
}

data e1_position_receipts: List<PositionReceipt> = [
  PositionReceipt { designator: designator_of(verbatim: "C10_P1"), standing: "confirmed", transcribed: "clear", rests_on: RuleRead { } },
