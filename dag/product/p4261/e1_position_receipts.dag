module product.p4261.e1_position_receipts

// THE 2026-11-03 E1 ATLAS RECEIPTS, AS DATA. Which designators the pass was entitled to put on NVIDIA's
// design list, which it held back, and what each of those rests on. The receipts are the referent, so the
// model is joined against them rather than against its own totals: a count cannot tell a dropped position
// from a swapped one (DESIGN §5, "Completeness is an identity join, not a count equality").
//
// GENERATED by gunb-ai/gunbc-private, branch p4261/e1-atlas-handoff, docs/plans/2026-11-03-p4261-e1-atlas/scripts/gen_e1_position_receipts_dag.py at 6bc9183
// (the hash is this script's own last commit on that branch, which is what a reader re-running it needs; a
// '-dirty' suffix means the script had uncommitted changes at the time and the output is NOT reproducible
// from any commit); do not hand-edit. The script reads inventory_top.csv and inventory_bottom.csv
// for the designator reads, per_photo_readings.jsonl and per_photo_readings_sd_2026-11-03.jsonl for the
// sightings the merged inventory lost, and final_pass_corrections.json for the reads the final pass settled.
//
// The base rule for admission, stated so a reader can re-run it: the row's kind is above the passive level
// (or it is one of the model's own bulk capacitors, which the handoff puts in scope), the designator is
// transcribed 'clear', its standing is 'confirmed' or 'final-pass critic', and the designator carries no
// '?' or '*'. Admitted: 261, of which 249 come from the rule alone and 12 are
// declared exceptions naming the receipt that carries them. Held: 25, each with its reason.
// Excluded entirely -- and so countable only from the receipts, never from the model -- are the 81
// distinct designators whose read carries a '?' or a '*': a character no read was entered for is not a
// designator, and a position would put our unread character into NVIDIA's design facts.
//
// `standing` is what the merged inventory recorded. How well the strongest receipt read that
// designator's own label -- the merged inventory's `designator_read` column or a per-photo item's
// `designator_legibility`, whichever is stronger -- is carried INSIDE the arm that needed it: a row the
// base rule reached records no legibility at all, because 'the label was read in full' is what resting
// on the rule means, and a state that cannot be written needs no test. Only a declared exception can
// record a legibility, because only an exception admits a row the rule could not reach -- one read
// partly, or never at all. Beside either, `transcription_basis` names the frame when a per-photo frame
// carried the read and quotes the merged column when the two disagree; it is provenance for a reader to
// check and nothing in the model branches on it. The rule itself lives in the generator, which is the
// only thing that reads the CSVs.

import std.types { List, NonEmptyStr }
import extdeps.electronic_component.types { Designator, designator_of }

// How well a receipt read one designator's own label. The five words are the receipts' own
// columns verbatim (designator_read, designator_legibility); nothing here is a sentence a
// reader has to re-parse, and the admission rule's precondition is a match on this value,
// never a substring search inside one. NotTranscribed is neither 'unreadable' nor an empty
// string: it is the receipt saying it saw the position and never read its label, which is
// itself an observation.
type DesignatorTranscription =
  | Clear {
      // every character of the label read
    }
  | Partial {
      // read, but not every character of it
    }
  | Unreadable {
      // the label was looked at and could not be read
    }
  | NotVisible {
      // the label was not visible to that receipt
    }
  | NotTranscribed {
      // no receipt entered a read for the label at all
    }

// How the receipts recorded one designator, and whether admitting it took more than the rule.
type PositionReceipt {
  designator: Designator
    // the label read verbatim; Designator's own equality is what joins it to a position. A
    // label no receipt transcribed never becomes one -- see UntranscribedCandidate.
  standing: NonEmptyStr
    // what the inventory's reading_standing column said
  rests_on: ReceiptBasis
    // how it was admitted, and -- inside the arm that needed an exception -- how well the
    // label was read. Which arm you must write IS the claim you are making: a row the base
    // rule reached has no field in which to say the label was only partly read, so that
    // contradiction is not tested away, it is unauthorable.
}

// How a row was admitted, and what the admission had to say about the label. The base rule
// admits a label read in full, so `rests_on: RuleRead` beside a claim of 'partial' has no
// constructor. An exception admits rows the rule could not reach, and those may have been
// read partly or never at all -- for them the legibility is data, and it lives in this arm
// and nowhere else.
type ReceiptBasis =
  | RuleRead {
      // the base rule reached it: read in full, which is why nothing here says so
      transcription_basis: NonEmptyStr?
        // where the read came from when a per-photo frame carried it rather than the merged
        // inventory row: the frame named and the merged column quoted beside it, so the two
        // disagree in the open instead of one silently winning. Provenance only -- nothing in
        // the model branches on it, and its absence means the merged column spoke for itself.
    }
  | NamedException {
      why: NonEmptyStr
        // the receipt that carries the admission, said out loud
      transcription: DesignatorTranscription
        // how well the strongest receipt read the label. NotTranscribed is reachable only
        // here: an exception is how a position the design list carries, and no bench receipt
        // ever read, is recorded honestly instead of quietly dropped.
      transcription_basis: NonEmptyStr?
        // as above
    }

// A read the pass refused to mint, with the reason. `why` names what would close it. The two
// arms are not interchangeable: a held READ still carries the exact label it did read, while
// a candidate whose label was never transcribed has no exact spelling to carry -- its name is
// plain text, because Designator is the identity the model joins on and an unread spelling
// must not enter it. C3_F1 is the second case: the final pass added the row and named the
// frame, and no receipt ever transcribed its label.
// How well a label that WAS read was read. NotTranscribed has no arm here: a label no
// receipt ever transcribed is not a read with a poor legibility, it is the candidate arm
// below, and minting a Designator for it was the contradiction this module exists to remove.
// Their names differ from DesignatorTranscription's because the compiler wants one name per
// variant across the graph, and the two vocabularies are not the same: this one describes a
// read that happened, that one reports on a label including the case where no receipt read it.
type ReadTranscription =
  | Fully {
      // every character of the label read
    }
  | InPart {
      // read, but not every character of it
    }
  | Illegible {
      // the label was looked at and could not be read
    }
  | Hidden {
      // the label was not visible to that receipt
    }

type HeldReceipt =
  | HeldDesignatorRead {
      designator: Designator
      standing: NonEmptyStr
      transcription: ReadTranscription
        // a held row was read, so it has a legibility; how poor is data, and NotTranscribed
        // is not an arm it can reach
      transcription_basis: NonEmptyStr?
      why: NonEmptyStr
    }
  | UntranscribedCandidate {
      source_key: NonEmptyStr
        // the receipt row that saw it, so a reader can find it again
      proposed_name: NonEmptyStr
        // what the pass calls it, as text only: the characters were never read
      standing: NonEmptyStr
      why: NonEmptyStr
    }

