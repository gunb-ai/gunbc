data e1_held_receipts: List<HeldReceipt> = [
  DesignatorCandidate { source: C3_F1 { }, atlas_row: "merged inventory, top side, placed cell A1, photos 't4_07', label read as C3_F1", proposed_name: "C3_F1", standing: "final-pass critic", receipt_read: NotRead { }, partly_legible_in: [LabelSighting { citation: InStore { content: Sha256Digest { hex: "6cec21f5e4c890ea69f895c929eedf84529b4ef8dc6b9d8aa3eb84113930fd99" as Sha256DigestHex }, region: Absent }, file_name: "p4261_e1b_top_A1-B2_J1_150uF-caps_U521_017N10LF_R150_2026-11-02_26.jpg" }], obligation: "transcribe the label in full from frame 26 (its bytes are in the store, digest 6cec21f5e4c8...), or from a closer shot, and mark the box it sits in; until then there is no exact spelling and this row stays a candidate, never a position", why: "the merged inventory recorded standing 'final-pass critic' with its designator_read column empty, and neither per-photo file carries a record of this designator, so no atlas receipt transcribed it -- which is not the same as no frame showing it: the operator reads the label as PARTLY legible in stored frame 26, cited in partly_legible_in. Partly legible is not a clear read, so the admission rule keeps it off the position list, and we do not have its full characters, so there is no exact spelling to mint" },
  HeldExactDesignator { designator: designator_of(verbatim: "D17"), standing: "confirmed", authority: FromReceipt { basis: Absent }, why: "the atlas's final pass reads this bottom-side label as D17_5 or D17_P2 truncated and refused to count it separately; the read is kept as an unresolved row, not as a position" },
  HeldExactDesignator { designator: designator_of(verbatim: "D5_P1"), standing: "confirmed", authority: FromReceipt { basis: Absent }, why: "an empty footprint the handoff says needs a visual check before anything is claimed about it" },
  HeldExactDesignator { designator: designator_of(verbatim: "DS10-DS13"), standing: "uncertain", authority: FromReceipt { basis: Absent }, why: "the merged inventory recorded standing 'uncertain' and designator_read 'clear', which is not the certain, complete read a position needs; where a receipt reads the label more strongly, this row's obligation names the frame to read first" },
  DesignatorCandidate { source: J141 { }, atlas_row: "merged inventory, top side, placed cell C5, photos 'p004', label read as J141", proposed_name: "J141", standing: "uncertain", receipt_read: PartlyRead { }, partly_legible_in: [LabelSighting { citation: InStore { content: Sha256Digest { hex: "a2bb0d2349f8cd9a2ba3d7943c41ba54d94ae9e9de2c8edebbcf984f250d55fb" as Sha256DigestHex }, region: Absent }, file_name: "p4261_e1b_top_C5-C6-D5-D6_U41_J10_U19_U22_2026-11-03_sd004.JPG" }], obligation: "read the remaining characters in `p4261_e1b_top_C5-C6-D5-D6_U41_J10_U19_U22_2026-11-03_sd004.JPG`; the merged inventory said 'partial'. Transcribe every character and it becomes an exact read; until then it stays a candidate, never a position", why: "the merged inventory recorded standing 'uncertain' and designator_read 'partial', which is not the certain, complete read a position needs; where a receipt reads the label more strongly, this row's obligation names the frame to read first" },
  HeldExactDesignator { designator: designator_of(verbatim: "Q10_P2"), standing: "uncertain", authority: FromReceipt { basis: Absent }, why: "the merged inventory recorded standing 'uncertain' and designator_read 'clear', which is not the certain, complete read a position needs; where a receipt reads the label more strongly, this row's obligation names the frame to read first" },
