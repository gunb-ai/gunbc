module product.p4261.photograph_store

import std.list { first_where }
import std.optional { Absent, Present }
import std.types { List, NonEmptyStr }
import product.electrical.photograph { Photograph }
import product.placement_supply { PhysicalAssetIdentity, physical_asset_identity_eq }
import gunbc.fleet.fleet_asset_identity { p4261_e1_b }
import product.p4261.e1_photographs { e1_photographs }

// WHICH FRAMES WE HOLD FOR A BOARD: ONE FACT, ONE HOME.
//
// A board's photographs are not a payload a consumer can hand to a check. If the set of frames arrives as
// an argument, then whoever holds the argument holds the verdict -- a private strategy, a fixture, or a
// stale copy could establish photo coverage by passing a list it liked, fabricated rows included, and the
// model would have no way to tell that the coverage was asserted rather than held. So the binding
// board -> frames lives HERE, one row per board, and everything that needs the answer asks this module
// (gunbc.design_argument::single_authority: a fact has one home; the same reason `product.p4261.carrier` owns which layout belongs to
// which board rather than letting callers pair them).
//
// The store PARAMETER stays at the evidence level -- product.p4261.evidence's `reading_groundings(store:,
// layout:)` and `judge_image_readings(store:, layout:)` take one, which is where the "judge this board
// against a set that does not hold its frames" control belongs, and belongs only: it is a check on the
// judgement, not a way to author a verdict.
//
// A BOARD WITH NO STORE IS A TYPED STANDING, not an empty list. An empty list would make two different
// claims indistinguishable -- "we hold no frames for this board" and "this board has no photograph record
// at all" -- and would let a board that was never surveyed read as one that was surveyed and found bare.
// `NoStoreForBoard` names the board and the obligation that would close it. The K1 is in that state today:
// its Drive folders exist and nobody has hashed them.

type BoardPhotographStore {
  board: PhysicalAssetIdentity
  // The frames themselves, identified by content (product.electrical.photograph). Generated views are in
  // the store and are REFUSED as grounding there, so including them costs nothing and keeps the sheets
  // able to cite the picture they show.
  frames: List<Photograph>
  // Where the rows came from, so a reader can re-derive the whole store. A store nobody can audit is a
  // list of numbers somebody typed.
  receipts: NonEmptyStr
}

// The E1: 201 rows -- 192 captured frames and the 9 views we drew ourselves, which the store keeps and
// REFUSES as grounding. The captured half arrives from two manifests, because the atlas has two batches:
// 82 frames from manifest_e1_all_photos.csv (the 2026-10-15 to 10-31 bench sessions, hashed by the atlas
// from the Drive folder named in `receipts`) and 110 from manifest_e1_sd_photos_2026-11-03.csv (the
// Andonstar's own SD-card batch, 2026-11-03). Generated by
// docs/plans/2026-11-03-p4261-e1-atlas/scripts/gen_e1_photographs_dag.py, which lives with its inputs on
// the handoff branch p4261/e1-atlas-handoff of the PRIVATE repo (gunb-ai/gunbc-private): the manifests and
// registries it reads are the private atlas receipts, so no copy in this repo could run it. Re-running it
// there reproduces product.p4261.e1_photographs byte for byte and prints this census.
data p4261_e1_photograph_store: BoardPhotographStore = BoardPhotographStore {
  board: p4261_e1_b,
  frames: e1_photographs,
  receipts: "docs/plans/2026-11-03-p4261-e1-atlas: manifest_e1_all_photos.csv (82 captured frames), manifest_e1_sd_photos_2026-11-03.csv (110 SD-card frames), photo_registry_top_2026-11-03.csv + photo_registry_bottom_2026-11-03.csv + photo_registry_sd_2026-11-03.csv (173 rows: 106 top / 60 bottom / 7 unplaced), atlas_snapshot_2026-11-03b.json (the 9 drawn views; supersedes 2026-11-03, nothing under tables/superseded/ is read); produced by scripts/gen_e1_photographs_dag.py at a755faf on branch p4261/e1-atlas-handoff",
}

// One row per board whose frames have been hashed. The K1 has no row because its Drive folders are
// unhashed -- that absence is the `NoStoreForBoard` standing, and its obligation says what closes it.
data p4261_photograph_stores: List<BoardPhotographStore> = [p4261_e1_photograph_store]

type PhotographStoreForBoard
  = StoreHeld { store: BoardPhotographStore }
  // A STORE ROW THAT IS WRONG ABOUT WHICH BOARD IT PICTURES. The digest says which BYTES, not which
  // specimen they depict; `Photograph.board` is the specimen, so a frame attributed to another board cannot
  // ground a reading about this one. Such a row is not filtered away on the way to a verdict -- a store that
  // says E1 and holds K1 frames is broken evidence, and the only honest thing a lookup can do with it is
  // refuse and name the foreign rows, so the person who assembled the store sees exactly which rows to fix
  // (gunbc.design_argument::epistemic_humility: a defect stays visible rather than being smoothed into a passing check).
  | StoreRowHoldsForeignFrames { board: PhysicalAssetIdentity, foreign: List<Photograph> }
  | NoStoreForBoard { board: PhysicalAssetIdentity, obligation: NonEmptyStr }

// The frames a store row carries that do not belong to the board the row names. Identity is compared by the
// asset's own equality, never by casting an identity to a string (a cast that succeeds on a lookalike is how
// two assets start sharing evidence).
fn frames_of_another_board(store: BoardPhotographStore) -> List<Photograph> {
  filter(store.frames, f => !physical_asset_identity_eq(a: f.board, b: store.board))
}

// The one lookup. Consumers ask this; none of them carries a frame list of its own. A store whose frames
// are not all its own board's is refused here, so no caller has to remember to check.
// A row is only held if every frame in it is a picture of the board the row names.
fn store_row_judgment(held: BoardPhotographStore) -> PhotographStoreForBoard {
  let foreign = frames_of_another_board(store: held)
  if count(foreign) > 0 {
    StoreRowHoldsForeignFrames { board: held.board, foreign: foreign }
  } else {
    StoreHeld { store: held }
  }
}

fn photograph_store_for(board: PhysicalAssetIdentity) -> PhotographStoreForBoard {
  match first_where(p4261_photograph_stores, s => physical_asset_identity_eq(a: s.board, b: board)) {
    Present { value: held } => store_row_judgment(held: held)
    Absent => NoStoreForBoard {
      board: board,
      obligation: "hash this board's photographs from its atlas receipts and add its row to p4261_photograph_stores; product.p4261.e1_photographs is the pattern the E1 store was generated from",
    }
  }
}
