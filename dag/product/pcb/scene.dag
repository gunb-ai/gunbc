module product.pcb.scene

import std.types { String, NonEmptyStr, List }
import std.integer { Int }
import std.decl_ref { DeclarationRef, declaration_ref_display_key }
import std.measure { Micrometer }
import std.affine_space { Point2 }
import std.orthogonal_geometry { AxisAlignedRectangle2 }
import product.pcb.world {
  PcbWorld,
  PcbPhysicalWorld,
  PcbBodyLayoutStanding,
  PcbObligationCause,
  MissingDocument,
  CommercialAccess,
  LegalCarriage,
  UnselectedPart,
  DrawingMustBeRead,
  pcb_world_physical,
  pcb_world_design,
  pcb_body_layout,
  pcb_component_count,
  pcb_cause_counts,
}

data scene_note: String = "A TARGET-NEUTRAL ENGINEERING SCENE. The world is projected into elements that name geometry and typed causes, not a drawing medium. SVG is one realization of this scene; a second target must not require a second fold of the world. Known body envelopes are scene bodies; whether those bodies are a complete layout check lives on the legend as PcbBodyLayoutStanding, never inferred from the body count. Empty capabilities stay on the world as standings and do not appear here as empty element lists."

type PcbSceneLegend {
  established: Int
  missing_document: Int
  commercial_access: Int
  legal_carriage: Int
  unselected_part: Int
  drawing_must_be_read: Int
  body_layout: PcbBodyLayoutStanding
  design: DeclarationRef
}

type PcbSceneElement
  = SceneBoardOutline { outline: AxisAlignedRectangle2 }
  | SceneEstablishedBody {
      identity: NonEmptyStr
      origin: Point2
      body_width: Micrometer
      body_height: Micrometer
    }
  | SceneObligationMarker {
      identity: NonEmptyStr
      origin: Point2
      cause: PcbObligationCause
    }
  | SceneAttachmentMarker {
      layer: NonEmptyStr
      cause: PcbObligationCause
    }
  | SceneLegend { counts: PcbSceneLegend }

type PcbEngineeringScene sole_constructor {
  world: PcbWorld
  elements: List<PcbSceneElement>
}

fn pcb_engineering_scene(world: PcbWorld, elements: List<PcbSceneElement>) -> PcbEngineeringScene {
  PcbEngineeringScene { world: world, elements: elements }
}

fn legend_of(w: PcbWorld) -> PcbSceneLegend {
  let p = pcb_world_physical(w: w)
  let causes = pcb_cause_counts(p: p)
  PcbSceneLegend {
    established: pcb_component_count(p: p),
    missing_document: causes.missing_document,
    commercial_access: causes.commercial_access,
    legal_carriage: causes.legal_carriage,
    unselected_part: causes.unselected_part,
    drawing_must_be_read: causes.drawing_must_be_read,
    body_layout: pcb_body_layout(p: p),
    design: pcb_world_design(w: w),
  }
}

fn established_elements(p: PcbPhysicalWorld) -> List<PcbSceneElement> {
  fold(p.components, init: [], f: fn(acc, c) {
    concat(acc, [SceneEstablishedBody {
      identity: c.identity,
      origin: c.origin,
      body_width: c.body_envelope.body_width,
      body_height: c.body_envelope.body_height,
    }])
  })
}

fn obligation_elements(p: PcbPhysicalWorld) -> List<PcbSceneElement> {
  fold(p.obligations, init: [], f: fn(acc, o) {
    concat(acc, [SceneObligationMarker {
      identity: o.identity,
      origin: o.origin,
      cause: o.cause,
    }])
  })
}

fn attachment_elements(p: PcbPhysicalWorld) -> List<PcbSceneElement> {
  fold(p.attachment_obligations, init: [], f: fn(acc, a) {
    concat(acc, [SceneAttachmentMarker {
      layer: a.layer,
      cause: a.cause,
    }])
  })
}

fn project_engineering_scene(w: PcbWorld) -> PcbEngineeringScene {
  let p = pcb_world_physical(w: w)
  let outline = [SceneBoardOutline { outline: p.board.outline }]
  let legend = [SceneLegend { counts: legend_of(w: w) }]
  pcb_engineering_scene(
    world: w,
    elements: concat(
      concat(outline, legend),
      concat(established_elements(p: p), concat(obligation_elements(p: p), attachment_elements(p: p)))
    ),
  )
}

fn scene_element_identity(e: PcbSceneElement) -> NonEmptyStr? {
  match e {
    SceneBoardOutline { outline: _ } => none
    SceneEstablishedBody { identity: id, origin: _, body_width: _, body_height: _ } => Present { value: id }
    SceneObligationMarker { identity: id, origin: _, cause: _ } => Present { value: id }
    SceneAttachmentMarker { layer: layer, cause: _ } => Present { value: concat("attachment: ", layer as String) as NonEmptyStr }
    SceneLegend { counts: c } => Present { value: declaration_ref_display_key(ref: c.design) as NonEmptyStr }
  }
}

fn first_unrepresented_scene_identity(scene: PcbEngineeringScene, document: String) -> NonEmptyStr? {
  fold(scene.elements, init: none, f: fn(acc, e) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent =>
        match scene_element_identity(e: e) {
          Absent => none
          Present { value: id } =>
            if string_contains(s: document, pattern: id as String) {
              none
            } else {
              Present { value: id }
            }
        }
    }
  })
}

fn obligation_cause_label(c: PcbObligationCause) -> String {
  match c {
    MissingDocument { what_is_missing: w } => concat("missing document:", w as String)
    CommercialAccess { subject: s } => concat("commercial access:", s as String)
    LegalCarriage { reason: r } => concat("legal carriage:", r as String)
    UnselectedPart { because: b } => concat("unselected part:", b as String)
    DrawingMustBeRead { figure: f, what_is_drawn: _ } => concat("drawing must be read:", f as String)
  }
}
