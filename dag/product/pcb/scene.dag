module product.pcb.scene


// A TARGET-NEUTRAL ENGINEERING SCENE. The world is projected into elements that name geometry and
// typed causes, not a drawing medium. SVG is one realization of this scene; a second target must
// not require a second fold of the world. Known body envelopes are scene bodies; whether those
// bodies are a complete layout check lives on the legend as PcbBodyLayoutStanding, never inferred
// from the body count. An established envelope's source is formatted as the declaration this board
// read — a DeclarationRef display key — never reconstructed into a datasheet section, and never
// labelled verified: nothing here checks that those refs resolve. Empty capabilities stay on the
// world as standings and do not appear here as empty element lists. A scene identity is
// represented only by an exact emitted label: a longer label that merely contains it as a prefix
// is not a representation.
type PcbSceneLegend {
  established: Int
  missing_document: Int
  commercial_access: Int
  legal_carriage: Int
  unselected_part: Int
  drawing_must_be_read: Int
  named_attachment_part_unresolved: Int
  functional_obligation: Int
  body_layout: product.pcb.world.PcbBodyLayoutStanding
  design: std.decl_ref.DeclarationRef
  envelope_reads: List<std.decl_ref.DeclarationRef>
}

type PcbSceneElement
  = SceneBoardOutline { outline: std.orthogonal_geometry.AxisAlignedRectangle2 }
  | SceneEstablishedBody {
      identity: std.types.NonEmptyStr
      origin: std.affine_space.Point2
      body_width: std.measure.Micrometer
      body_height: std.measure.Micrometer
      source: std.decl_ref.DeclarationRef?
    }
  | SceneObligationMarker {
      identity: std.types.NonEmptyStr
      origin: std.affine_space.Point2
      cause: product.pcb.world.PcbObligationCause
    }
  | SceneAttachmentMarker {
      layer: std.types.NonEmptyStr
      cause: product.pcb.world.PcbObligationCause
    }
  | SceneFunctionalMarker {
      function: std.types.NonEmptyStr
      cause: product.pcb.world.PcbObligationCause
    }
  | SceneLegend { counts: PcbSceneLegend }

type PcbEngineeringScene sole_constructor {
  world: product.pcb.world.PcbWorld
  elements: List<PcbSceneElement>
}

fn pcb_engineering_scene(world: product.pcb.world.PcbWorld, elements: List<PcbSceneElement>) -> PcbEngineeringScene {
  PcbEngineeringScene { world: world, elements: elements }
}

fn legend_of(w: product.pcb.world.PcbWorld) -> PcbSceneLegend {
  let p = product.pcb.world.pcb_world_physical(w: w)
  let causes = product.pcb.world.pcb_cause_counts(p: p)
  PcbSceneLegend {
    established: product.pcb.world.pcb_component_count(p: p),
    missing_document: causes.missing_document,
    commercial_access: causes.commercial_access,
    legal_carriage: causes.legal_carriage,
    unselected_part: causes.unselected_part,
    drawing_must_be_read: causes.drawing_must_be_read,
    named_attachment_part_unresolved: causes.named_attachment_part_unresolved,
    functional_obligation: product.pcb.world.pcb_functional_obligation_count(p: product.pcb.world.pcb_world_physical(w: w)),
    body_layout: product.pcb.world.pcb_body_layout(p: p),
    design: product.pcb.world.pcb_world_design(w: w),
    envelope_reads: fold(product.pcb.world.pcb_envelope_reads(p: p), init: [], f: fn(acc, r) {
      concat(acc, [r.source])
    }),
  }
}

fn envelope_read_for(reads: List<product.pcb.world.EstablishedEnvelopeRead>, identity: std.types.NonEmptyStr) -> std.decl_ref.DeclarationRef? {
  fold(reads, init: none, f: fn(acc, r) {
    match acc {
      Present { value: v } => Present { value: v }
      Absent =>
        if (r.identity as String) == (identity as String) {
          Present { value: r.source }
        } else {
          none
        }
    }
  })
}

fn established_elements(p: product.pcb.world.PcbPhysicalWorld) -> List<PcbSceneElement> {
  fold(p.components, init: [], f: fn(acc, c) {
    concat(acc, [SceneEstablishedBody {
      identity: c.identity,
      origin: c.origin,
      body_width: c.body_envelope.body_width,
      body_height: c.body_envelope.body_height,
      source: envelope_read_for(reads: product.pcb.world.pcb_envelope_reads(p: p), identity: c.identity),
    }])
  })
}

fn obligation_elements(p: product.pcb.world.PcbPhysicalWorld) -> List<PcbSceneElement> {
  fold(p.obligations, init: [], f: fn(acc, o) {
    concat(acc, [SceneObligationMarker {
      identity: o.identity,
      origin: o.origin,
      cause: o.cause,
    }])
  })
}

fn functional_elements(p: product.pcb.world.PcbPhysicalWorld) -> List<PcbSceneElement> {
  fold(p.functional_obligations, init: [], f: fn(acc, f) {
    concat(acc, [SceneFunctionalMarker {
      function: f.function,
      cause: f.cause,
    }])
  })
}

fn attachment_elements(p: product.pcb.world.PcbPhysicalWorld) -> List<PcbSceneElement> {
  fold(p.attachment_obligations, init: [], f: fn(acc, a) {
    concat(acc, [SceneAttachmentMarker {
      layer: a.layer,
      cause: a.cause,
    }])
  })
}

fn project_engineering_scene(w: product.pcb.world.PcbWorld) -> PcbEngineeringScene {
  let p = product.pcb.world.pcb_world_physical(w: w)
  let outline = [SceneBoardOutline { outline: p.board.outline }]
  let legend = [SceneLegend { counts: legend_of(w: w) }]
  pcb_engineering_scene(
    world: w,
    elements: concat(
      concat(outline, legend),
      concat(established_elements(p: p), concat(obligation_elements(p: p), concat(attachment_elements(p: p), functional_elements(p: p))))
    ),
  )
}

fn scene_element_identities(e: PcbSceneElement) -> List<std.types.NonEmptyStr> {
  match e {
    SceneBoardOutline { outline: _ } => []
    SceneEstablishedBody { identity: id, origin: _, body_width: _, body_height: _, source: src } =>
      match src {
        Absent => [id]
        Present { value: r } => [id, std.decl_ref.declaration_ref_display_key(ref: r) as std.types.NonEmptyStr]
      }
    SceneObligationMarker { identity: id, origin: _, cause: _ } => [id]
    SceneAttachmentMarker { layer: layer, cause: _ } => [concat("attachment: ", layer as String) as std.types.NonEmptyStr]
    SceneFunctionalMarker { function: f, cause: _ } => [concat("function unrealized: ", f as String) as std.types.NonEmptyStr]
    SceneLegend { counts: c } =>
      concat(
        [std.decl_ref.declaration_ref_display_key(ref: c.design) as std.types.NonEmptyStr],
        fold(c.envelope_reads, init: [], f: fn(acc, r) {
          concat(acc, [std.decl_ref.declaration_ref_display_key(ref: r) as std.types.NonEmptyStr])
        })
      )
  }
}

fn scene_identities(scene: PcbEngineeringScene) -> List<std.types.NonEmptyStr> {
  fold(scene.elements, init: [], f: fn(acc, e) {
    concat(acc, scene_element_identities(e: e))
  })
}

fn label_is_represented(represented: List<std.types.NonEmptyStr>, id: std.types.NonEmptyStr) -> Bool {
  fold(represented, init: false, f: fn(acc, r) {
    acc || (r as String) == (id as String)
  })
}

fn first_unrepresented_scene_identity(scene: PcbEngineeringScene, represented: List<std.types.NonEmptyStr>) -> std.types.NonEmptyStr? {
  fold(scene.elements, init: none, f: fn(acc, e) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent =>
        fold(scene_element_identities(e: e), init: none, f: fn(inner, id) {
          match inner {
            Present { value: found } => Present { value: found }
            Absent =>
              if label_is_represented(represented: represented, id: id) {
                none
              } else {
                Present { value: id }
              }
          }
        })
    }
  })
}

fn obligation_cause_label(c: product.pcb.world.PcbObligationCause) -> String {
  match c {
    product.pcb.world.MissingDocument { what_is_missing: w } => concat("missing document:", w as String)
    product.pcb.world.CommercialAccess { subject: s } => concat("commercial access:", s as String)
    product.pcb.world.LegalCarriage { reason: r } => concat("legal carriage:", r as String)
    product.pcb.world.UnselectedPart { because: b } => concat("unselected part:", b as String)
    product.pcb.world.DrawingMustBeRead { figure: f, what_is_drawn: _ } => concat("drawing must be read:", f as String)
    product.pcb.world.StandingIsSelfContradictory { what_is_wrong: w } => concat("standing is self-contradictory:", w as String)
    product.pcb.world.NamedAttachmentTypePartUnresolved { designation: d, missing: m } => concat(concat(d as String, " part unresolved:"), m as String)
  }
}
