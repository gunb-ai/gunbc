module product.pcb.copper


// COPPER REALIZES A NET; IT DOES NOT DEFINE ONE. The logical net authority is
// product.electrical.connectivity's ElectricalNet, and this module consumes it. A second net type
// here would be the fork DESIGN section 3 forbids, and it would be the expensive kind: the two
// would drift silently, because a copper net and a schematic net that disagree still both compile.
//
// What this module adds is the fact copper has that a schematic does not: WHERE the conductor is.
// That is a position in the stackup, and it is the join that has to be made unforgeable.

// A LAYER REFERENCE THAT CANNOT NAME A LAYER THAT DOES NOT EXIST. The obvious modelling is an Int
// index into the stackup's layer list, and it is wrong twice over. It is a positional citation of
// a thing the stackup already names structurally (DESIGN section 3), and it silently survives a
// stackup edit: insert a ply and every trace below it is now on a different layer, with nothing to
// notice. So a CopperLayerRef is sealed, and the only route to one is selecting from an admitted
// stackup — which means a reference cannot outlive the stackup that produced it without someone
// re-selecting against the new one. MEASURED, not read: a probe constructing CopperLayerRef inside
// the witness module returned "sole_constructor type 'CopperLayerRef' cannot be constructed outside
// its defining module" (zesty-heron-736, 2026-08-16). The probe was removed after measurement; what
// keeps the wall honest in the enrolled suite is that every realization there reaches its layer
// through select_copper_layer.
// THE REFERENCE CARRIES THE STACKUP IT WAS SELECTED AGAINST. Without it, ordinal 1 from a
// three-layer board and ordinal 1 from a twelve-layer board are the same value, so copper selected
// against one stackup could be admitted against another - the sealing would prove the ref came from
// SOME admitted stackup and never which one. That is the reference-without-a-referent class, and it
// is the same one admit_stackup closed one layer up by carrying the declaration it judged.
type CopperLayerRef sole_constructor {
  stackup_authority: std.decl_ref.DeclarationRef
  ordinal: Int
  function: product.pcb.stackup.CopperLayerFunction
}

type LayerSelection
  = LayerSelected { layer: CopperLayerRef }
  | LayerOutsideStackup { requested: Int, layer_count: Int }

fn mint_layer_ref(stackup_authority: std.decl_ref.DeclarationRef, ordinal: Int, function: product.pcb.stackup.CopperLayerFunction) -> LayerSelection
  admit_callers: [
    decl_ref(module_path: "product.pcb.copper", decl_name: "select_copper_layer"),
  ]
  = LayerSelected {
      layer: CopperLayerRef {
        stackup_authority: stackup_authority,
        ordinal: ordinal,
        function: function,
      },
    }

// Ordinals count from the top copper layer at 0, which is the fabricator's own convention and the
// order the stackup already carries. Out of range REFUSES with both numbers rather than clamping to
// the nearest layer — a clamp would put copper on a real layer that nobody asked for, which is the
// fabricated-plausible-output failure with a board attached (DESIGN section 5).
fn select_copper_layer(a: product.pcb.stackup.AdmittedStackup, ordinal: Int) -> LayerSelection {
  let layers = product.pcb.stackup.stackup_copper_layers(s: product.pcb.stackup.admitted_stackup_body(a: a))
  let n = product.pcb.stackup.stackup_copper_layer_count(s: product.pcb.stackup.admitted_stackup_body(a: a))
  if ordinal < 0 || ordinal >= n {
    LayerOutsideStackup { requested: ordinal, layer_count: n }
  } else {
    mint_layer_ref(
      stackup_authority: product.pcb.stackup.admitted_stackup_authority(a: a),
      ordinal: ordinal,
      function: nth_layer_function(layers: layers, ordinal: ordinal),
    )
  }
}

// SELECTION IS A FOLD WITH A COUNTER, because the substrate offers no list indexing primitive and
// inventing one here to reach a layer would be a std-shaped fact authored in a product module. The
// accumulator carries how many layers have been passed and the layers matched so far; at most one
// can match, and the caller has already refused the out-of-range case, so the match is nonempty.
type LayerScan {
  seen: Int
  picked: List<product.pcb.stackup.CopperLayer>
}

fn scan_for_ordinal(layers: List<product.pcb.stackup.CopperLayer>, ordinal: Int) -> LayerScan {
  v2.std.algebra.fold_list(
    xs: layers,
    empty: LayerScan { seen: 0, picked: [] },
    cons: fn(acc, c) {
      LayerScan {
        seen: acc.seen + 1,
        picked: if acc.seen == ordinal { acc.picked + [c] } else { acc.picked },
      }
    },
  )
}

fn nth_layer_function(layers: List<product.pcb.stackup.CopperLayer>, ordinal: Int) -> product.pcb.stackup.CopperLayerFunction {
  scan_for_ordinal(layers: layers, ordinal: ordinal).picked.first().function
}

fn copper_layer_ordinal(r: CopperLayerRef) -> Int {
  r.ordinal
}

fn copper_layer_function(r: CopperLayerRef) -> product.pcb.stackup.CopperLayerFunction {
  r.function
}

// A REALIZATION NAMES A LOGICAL NET AND A LAYER. It carries the NetIdentity rather than a copy of
// the net's members, because membership is the schematic's fact and duplicating it here is how the
// two representations start to disagree.
type NetCopperRealization {
  net: product.electrical.connectivity.NetIdentity
  layer: CopperLayerRef
}

type CopperRefusalCause
  = RealizationNamesNoSuchNet { net: product.electrical.connectivity.NetIdentity }
  | RealizationSelectedAgainstAnotherStackup { net: product.electrical.connectivity.NetIdentity }
  | NetSplitAcrossLayersWithoutAConnection { net: product.electrical.connectivity.NetIdentity }
  | NetHasTwoConductorsOnOneLayer { net: product.electrical.connectivity.NetIdentity }
  | InterlayerConnectionNamesNoSuchNet { net: product.electrical.connectivity.NetIdentity }
  | InterlayerConnectionSelectedAgainstAnotherStackup { net: product.electrical.connectivity.NetIdentity }
  | InterlayerConnectionJoinsALayerToItself { net: product.electrical.connectivity.NetIdentity, ordinal: Int }
  | InterlayerConnectionEndpointHasNoConductor { net: product.electrical.connectivity.NetIdentity, ordinal: Int }

// ADMISSION IS AN IDENTITY JOIN, NOT A COUNT. The failure this catches is ordinary and quiet: a net
// is renamed in the schematic and its copper realization keeps the old identity, so the board has a
// conductor belonging to nothing and a net with no conductor. Counting realizations against nets
// would report both boards as fine, because the count did not change (DESIGN section 5 - completeness
// is an identity join).
// COPPER TAKES THE NET ROSTER, NOT THE CIRCUIT INTENT. The first cut took an AnalogCircuitIntent,
// which looks harmless because the only field it read was .nets -- but that type carries components,
// and ElectricalComponentInstance is a CLOSED coproduct of resistor, capacitor and independent
// voltage source. A CPU, a BMC, a DDR slot, a regulator or a connector has no variant there, so the
// copper carrier could only have acquired the motherboard as a consumer by making the motherboard
// impersonate a three-part analog board.
//
// ElectricalNet was already general: its members are component-and-terminal identities, which say
// nothing about what kind of component. Only the wrapper was specimen-bound, which is why the fix
// was to extract the general grain rather than to move the specimen -- product.electrical
// .connectivity now owns it and the analog article consumes it on the same footing this module
// does, so neither is the other's authority.
fn net_exists(nets: List<product.electrical.connectivity.ElectricalNet>, net: product.electrical.connectivity.NetIdentity) -> Bool {
  count(filter(nets, n => n.identity == net)) > 0
}

fn realizations_of_net(rs: List<NetCopperRealization>, net: product.electrical.connectivity.NetIdentity) -> List<NetCopperRealization> {
  filter(rs, r => r.net == net)
}

// A NET REALIZED TWICE ON ONE LAYER IS TWO CONDUCTORS CLAIMING ONE NAME, and that is an authority
// fork in copper rather than a redundant route. A net legitimately present on SEVERAL layers is a
// different fact, carried by InterlayerConnection below and judged by the connectivity refusal - the
// two questions were one check until this increment split them.
// ONE CAUSE PER NET FOR THE NET-GRAIN CAUSES, because those are facts ABOUT A NET rather than about
// a row: a net on four layers with no via is one problem, not four, and two rows on one layer is one
// fork however many rows are involved. Deriving them from the realization list emitted one per row,
// which is a duplicate wearing the counted-causes policy, and DESIGN section 3 rules a duplicate a
// fork whether or not the copies agree. The row-grain causes stay per-row because theirs genuinely
// are: each realization naming a net the schematic lacks is its own row to fix. The net-grain causes
// derive from intent.nets, so the population is the schematic's, and a realization naming a net the
// schematic lacks is still caught by RealizationNamesNoSuchNet rather than silently skipped.
fn copper_refusal_causes(
  nets: List<product.electrical.connectivity.ElectricalNet>,
  board: product.pcb.stackup.AdmittedStackup,
  rs: List<NetCopperRealization>,
  vs: List<InterlayerConnection>,
) -> List<CopperRefusalCause> {
  let unknown = map(
    filter(rs, r => !net_exists(nets: nets, net: r.net)),
    r => RealizationNamesNoSuchNet { net: r.net },
  )
  let duplicated = map(
    filter(nets, n => net_split_is_unrouted(rs: rs, vs: vs, net: n.identity)),
    n => NetSplitAcrossLayersWithoutAConnection { net: n.identity },
  )
  let stacked = map(
    filter(nets, n => net_has_duplicate_on_one_layer(rs: rs, net: n.identity)),
    n => NetHasTwoConductorsOnOneLayer { net: n.identity },
  )
  let foreign = map(
    filter(rs, r => r.layer.stackup_authority != product.pcb.stackup.admitted_stackup_authority(a: board)),
    r => RealizationSelectedAgainstAnotherStackup { net: r.net },
  )
  unknown + duplicated + stacked + foreign + interlayer_refusal_causes(nets: nets, board: board, rs: rs, vs: vs)
}

// A VIA IS A CONDUCTOR BETWEEN TWO LAYERS OF ONE NET. It is what makes a net legitimately present
// on more than one layer, which the previous increment had to refuse outright because it had no way
// to tell a routed layer change from two conductors forking one name.
//
// Both endpoints are CopperLayerRefs, so both inherit the stackup binding: a via cannot join a layer
// of one board to a layer of another, and it cannot name an ordinal that board does not have.
// What the reference cannot carry is the two endpoints being DIFFERENT - that is a relation between
// two values rather than a property of either, so it is a checked refusal, and a via from a layer to
// itself is a drilled hole that connects nothing.
type InterlayerConnection {
  net: product.electrical.connectivity.NetIdentity
  from_layer: CopperLayerRef
  to_layer: CopperLayerRef
}

fn interlayer_ordinals(v: InterlayerConnection) -> List<Int> {
  [copper_layer_ordinal(r: v.from_layer), copper_layer_ordinal(r: v.to_layer)]
}

fn interlayer_touches_ordinal(v: InterlayerConnection, ordinal: Int) -> Bool {
  count(filter(interlayer_ordinals(v: v), o => o == ordinal)) > 0
}

fn connections_of_net(vs: List<InterlayerConnection>, net: product.electrical.connectivity.NetIdentity) -> List<InterlayerConnection> {
  filter(vs, v => v.net == net)
}

// WHETHER A SPLIT NET IS ONE CONDUCTOR OR SEVERAL ISLANDS. The first cut of this asked only that
// every realized layer be TOUCHED by some connection of the net, and said so honestly: a net on
// layers 0, 1, 2, 3 with connections 0-1 and 2-3 satisfied it while being two electrically separate
// islands, and it admitted. That is the state-space conflation DESIGN section 5 names - "every layer
// is reached by something" and "every layer is reached by the same something" are different facts,
// and the weaker one was standing in for the stronger.
//
// It is now the real question, because the graph is bounded and both endpoints already carry exact
// layer identity: reachability from the net's first realized layer, expanded to a fixpoint over the
// net's own connections, and every realized layer must land in that one component.
//
// WHY THE ITERATION COUNT IS THE REALIZATION COUNT AND NOT A GUESS. Each expansion pass adds at
// least one new ordinal or the set is already closed, and the set can never exceed the number of
// realized layers, so count(on) passes reach the fixpoint for any connection population. The fold is
// over the realization list itself purely to supply that many passes - its elements are unread.
fn ordinal_is_reached(reached: List<Int>, ordinal: Int) -> Bool {
  count(filter(reached, o => o == ordinal)) > 0
}

// One expansion pass: a connection whose one endpoint is already reached contributes its other
// endpoint. Appending only the absent ones keeps the set a set, so the growth bound above holds.
fn expand_reached(
  conns: List<InterlayerConnection>,
  reached: List<Int>,
) -> List<Int> {
  v2.std.algebra.fold_list(
    xs: conns,
    empty: reached,
    cons: fn(acc, c) {
      let from = copper_layer_ordinal(r: c.from_layer)
      let to = copper_layer_ordinal(r: c.to_layer)
      let with_to = if ordinal_is_reached(reached: acc, ordinal: from) && !ordinal_is_reached(reached: acc, ordinal: to) {
        acc + [to]
      } else {
        acc
      }
      if ordinal_is_reached(reached: with_to, ordinal: to) && !ordinal_is_reached(reached: with_to, ordinal: from) {
        with_to + [from]
      } else {
        with_to
      }
    },
  )
}

fn net_reached_ordinals(
  rs: List<NetCopperRealization>,
  vs: List<InterlayerConnection>,
  net: product.electrical.connectivity.NetIdentity,
  seed: Int,
) -> List<Int> {
  let conns = connections_of_net(vs: vs, net: net)
  let on = realizations_of_net(rs: rs, net: net)
  v2.std.algebra.fold_list(
    xs: on,
    empty: [seed],
    cons: fn(acc, _unused) { expand_reached(conns: conns, reached: acc) },
  )
}

// TWO ROWS FOR ONE NET ON ONE LAYER IS THE ORIGINAL FORK, AND NARROWING THE SPLIT REFUSAL LOST IT.
// Before vias, any net with more than one realization refused, which caught this case by accident.
// Replacing that with a via-reachability question asked only whether each REALIZED LAYER is reached
// by a via - and two rows on layer 0 are both on a layer a via reaches, so both passed. Confirmed by
// execution before fixing: a probe with vcc realized twice on layer 0 plus a vcc via 0 to 1 was
// ADMITTED.
//
// The lesson is worth the comment: narrowing a refusal is a deletion, and it silently drops every
// case the old form caught for reasons the new form does not model. Same-layer duplication and
// cross-layer routing are different questions, so they are now two causes rather than one that got
// re-aimed.
//
// The cause carries the net and not the ordinal. Naming WHICH layer is duplicated needs a fold over
// distinct ordinals that this increment does not build, and picking one of them would name a layer
// the model did not establish as the offender.
fn net_has_duplicate_on_one_layer(rs: List<NetCopperRealization>, net: product.electrical.connectivity.NetIdentity) -> Bool {
  let on = realizations_of_net(rs: rs, net: net)
  count(filter(on, r =>
    count(filter(on, other => copper_layer_ordinal(r: other.layer) == copper_layer_ordinal(r: r.layer))) > 1
  )) > 0
}

// THE REFUSAL, ASKED WITHOUT PICKING A SEED. Rather than extracting a head realization to start
// from - which would need a sentinel for the empty case, and a sentinel here is the absorbing
// fallback DESIGN section 5 forbids - this asks the question from EVERY realized layer and refuses
// if any of them fails to reach all the others. For a connected net every start reaches everything,
// so the two readings agree; for an islanded net every start fails, so the refusal is not sensitive
// to which layer it began from.
fn net_split_is_unrouted(rs: List<NetCopperRealization>, vs: List<InterlayerConnection>, net: product.electrical.connectivity.NetIdentity) -> Bool {
  let on = realizations_of_net(rs: rs, net: net)
  if count(on) <= 1 {
    false
  } else {
    count(filter(on, r => {
      let reached = net_reached_ordinals(rs: rs, vs: vs, net: net, seed: copper_layer_ordinal(r: r.layer))
      count(filter(on, other => !ordinal_is_reached(reached: reached, ordinal: copper_layer_ordinal(r: other.layer)))) > 0
    })) > 0
  }
}

// AN ENDPOINT THAT LANDS ON NO CONDUCTOR IS A HOLE INTO NOTHING. The stackup checks establish that
// an endpoint names a layer this board HAS; they say nothing about whether the net being connected
// is actually realized in copper there. Without this, a VCC connection could terminate on a layer
// carrying no VCC conductor - or sit on an entirely unrouted net - and admission would call it
// harmless, because every check it faced was about the layer rather than about the join.
data no_refusal_causes: List<CopperRefusalCause> = []

fn connection_orphan_endpoints(
  rs: List<NetCopperRealization>,
  v: InterlayerConnection,
) -> List<CopperRefusalCause> {
  let on = realizations_of_net(rs: rs, net: v.net)
  let realized = map(on, r => copper_layer_ordinal(r: r.layer))
  v2.std.algebra.fold_list(
    xs: interlayer_ordinals(v: v),
    empty: no_refusal_causes,
    cons: fn(acc, o) {
      if ordinal_is_reached(reached: realized, ordinal: o) {
        acc
      } else {
        acc + [InterlayerConnectionEndpointHasNoConductor { net: v.net, ordinal: o }]
      }
    },
  )
}

fn interlayer_refusal_causes(
  nets: List<product.electrical.connectivity.ElectricalNet>,
  board: product.pcb.stackup.AdmittedStackup,
  rs: List<NetCopperRealization>,
  vs: List<InterlayerConnection>,
) -> List<CopperRefusalCause> {
  let unknown = map(
    filter(vs, v => !net_exists(nets: nets, net: v.net)),
    v => InterlayerConnectionNamesNoSuchNet { net: v.net },
  )
  let foreign = map(
    filter(vs, v =>
      v.from_layer.stackup_authority != admitted_stackup_authority(a: board)
        || v.to_layer.stackup_authority != admitted_stackup_authority(a: board)),
    v => InterlayerConnectionSelectedAgainstAnotherStackup { net: v.net },
  )
  let degenerate = map(
    filter(vs, v => copper_layer_ordinal(r: v.from_layer) == copper_layer_ordinal(r: v.to_layer)),
    v => InterlayerConnectionJoinsALayerToItself { net: v.net, ordinal: copper_layer_ordinal(r: v.from_layer) },
  )
  let orphaned = v2.std.algebra.fold_list(
    xs: vs,
    empty: no_refusal_causes,
    cons: fn(acc, v) { acc + connection_orphan_endpoints(rs: rs, v: v) },
  )
  unknown + foreign + degenerate + orphaned
}

// THE ADMITTED VALUE CARRIES EVERY INPUT ADMISSION JUDGED, not only the realizations. The first cut
// returned the realization list alone while the interlayer connections had been read to decide the
// verdict - so two different connection populations could justify one admitted result, and nothing
// downstream (a renderer, a DRC, a KiCad projection) could recover which joins were supposed to make
// the split nets whole. Evidence that decides a verdict may not vanish across the admission boundary.
//
// The board binding is carried for the same reason it is carried on AdmittedStackup: VCC on one
// board is not the same net as VCC on another, and an admitted result must not be replayable against
// a different board whose net labels happen to agree.
type AdmittedCopper sole_constructor {
  board: std.decl_ref.DeclarationRef
  realizations: List<NetCopperRealization>
  interlayer_connections: List<InterlayerConnection>
}

type CopperAdmission
  = CopperAdmitted { admitted: AdmittedCopper }
  | CopperRefused { causes: List<CopperRefusalCause> }

fn mint_admitted_copper(
  board: std.decl_ref.DeclarationRef,
  rs: List<NetCopperRealization>,
  vs: List<InterlayerConnection>,
) -> CopperAdmission
  admit_callers: [
    decl_ref(module_path: "product.pcb.copper", decl_name: "admit_copper"),
  ]
  = CopperAdmitted { admitted: AdmittedCopper { board: board, realizations: rs, interlayer_connections: vs } }

fn admitted_copper_realizations(a: AdmittedCopper) -> List<NetCopperRealization> {
  a.realizations
}

fn admitted_copper_connections(a: AdmittedCopper) -> List<InterlayerConnection> {
  a.interlayer_connections
}

fn admitted_copper_board(a: AdmittedCopper) -> std.decl_ref.DeclarationRef {
  a.board
}

fn admit_copper(
  nets: List<product.electrical.connectivity.ElectricalNet>,
  board: product.pcb.stackup.AdmittedStackup,
  rs: List<NetCopperRealization>,
  vs: List<InterlayerConnection>,
) -> CopperAdmission {
  let causes = copper_refusal_causes(nets: nets, board: board, rs: rs, vs: vs)
  if count(causes) > 0 {
    CopperRefused { causes: causes }
  } else {
    mint_admitted_copper(board: admitted_stackup_authority(a: board), rs: rs, vs: vs)
  }
}

// THE COVERAGE READ, KEPT SEPARATE FROM ADMISSION. A board whose copper is internally consistent is
// not a board that is finished: admission says nothing wrong is realized, coverage says how much is
// realized at all. Fusing them would let a board with two correct traces and forty unrouted nets
// report as admitted-and-therefore-done, which is the completeness-versus-verdict conflation
// PcbBodyLayoutStanding already had to split into separate arms.
fn unrealized_nets(nets: List<product.electrical.connectivity.ElectricalNet>, rs: List<NetCopperRealization>) -> List<product.electrical.connectivity.ElectricalNet> {
  filter(nets, n => count(realizations_of_net(rs: rs, net: n.identity)) == 0)
}

fn copper_is_complete_over_nets(nets: List<product.electrical.connectivity.ElectricalNet>, rs: List<NetCopperRealization>) -> Bool {
  count(unrealized_nets(nets: nets, rs: rs)) == 0
}
