module product.pcb.world


// ONE PCB WORLD, AND EMPTY IS NOT A DEFAULT. Established body envelopes occupy components. Every
// other planned identity is an obligation that carries a typed cause — missing document,
// commercial access, legal carriage, unselected part, or a drawing a human must read — rather than
// a role string those distinctions collapse into. A figure already cited is not a missing
// document: collapsing that into MissingDocument sends someone to search a bibliography that
// already returned a location. Body-envelope geometry is a standing, not a Bool over the envelopes
// that happen to exist: the complete arm is reachable only when every required part was in the
// check, and the subset arm carries the count of parts the geometry never saw, so a consumer
// cannot read a clean answer without also receiving what it did not cover. Design is an IDENTITY
// (a DeclarationRef naming the declaration the plan was built from), not a revision: it
// distinguishes two designs and does not change when one design's contents are edited in place. An
// established envelope's source is the same kind of identity: which declaration this board read,
// not a sentence about a datasheet section, and not a verified citation — nothing here checks that
// those refs resolve. Capabilities that have no row type yet (stackup, footprints, pads, routes,
// nets, manufacturing artifacts) are not empty lists: an empty list cannot tell a board that needs
// none from a board whose routing has not been modeled from a board whose routing completed at
// zero. Each of those fields is a capability standing, pending with a nonempty obligation,
// refused with a cause, or established with a DeclarationRef naming where the delivered value
// lives. The established arm carries a REF and not the value because one standing type serves all
// six capabilities and they have six different value shapes; asking whether the stackup is settled
// is a different question from asking what the stackup is, and a world needs only the first. That
// ref is an identity like the others above -- nothing here checks that it resolves, and an
// established standing is a claim about modelling progress, not a verified citation. NO capability
// is established today: every field on every world this repository builds is still pending, so the
// arm changes what the type can express rather than what any board carries. A PARTIAL world is a
// preview whose outline constructed; it is not an admitted board.
type PcbBoard {
  frame: std.coordinate_frame.CoordinateFrameIdentity
  outline: std.orthogonal_geometry.AxisAlignedRectangle2
}

type PcbObligationCause
  = MissingDocument { what_is_missing: std.types.NonEmptyStr }
  | CommercialAccess { subject: std.types.NonEmptyStr }
  | LegalCarriage { reason: std.types.NonEmptyStr }
  | UnselectedPart { because: std.types.NonEmptyStr }
  | DrawingMustBeRead { figure: std.types.NonEmptyStr, what_is_drawn: std.types.NonEmptyStr }
  | StandingIsSelfContradictory { what_is_wrong: std.types.NonEmptyStr }
  | NamedAttachmentTypePartUnresolved { designation: std.types.NonEmptyStr, missing: std.types.NonEmptyStr }

type PcbComponentObligation {
  identity: std.types.NonEmptyStr
  origin: std.affine_space.Point2
  cause: PcbObligationCause
}

type PcbAttachmentObligation {
  layer: std.types.NonEmptyStr
  cause: PcbObligationCause
}

// A REQUIRED FUNCTION WITH NO REALIZATION YET, carried without geometry on purpose: it has no
// identity, no origin and no extent, because how many parts provide it is exactly what is not
// known. Reporting it here is what keeps it from being dropped between the design's requirement
// and the physical roster.
type PcbFunctionalObligation {
  function: std.types.NonEmptyStr
  cause: PcbObligationCause
}

type PcbCapabilityObligation {
  what_is_owed: std.types.NonEmptyStr
}

type NonemptyCapabilityObligations {
  first: PcbCapabilityObligation
  rest: List<PcbCapabilityObligation>
}

// THE ESTABLISHED ARM, which this type did not have. Its absence is why AdmittedPcbWorld was
// unreachable for every world this repository can build -- a capability could be owed or refused
// and never delivered, so "the stackup exists" was not merely unmodelled but UNREPRESENTABLE.
//
// IT CARRIES A DeclarationRef, NOT THE VALUE. Two reasons, and the first is the weaker one: it
// matches EstablishedEnvelopeRead a few lines below, which already points at where an established
// physical fact lives rather than copying it. The load-bearing reason is that PcbCapabilityStanding
// is one type used for stackup, footprints, pads, routes, nets and manufacturing artifacts, which
// are six different value shapes. Carrying values would make this generic in six places and force
// PcbWorld to grow type parameters for facts it only needs to know the STANDING of; a world asking
// "is the stackup settled" is a different question from "what is the stackup", and fusing them is
// what makes a status record start impersonating the thing it reports on.
type PcbCapabilityStanding
  = CapabilityPending { owed: NonemptyCapabilityObligations }
  | CapabilityRefused { cause: std.types.NonEmptyStr }
  | CapabilityEstablished { authority: std.decl_ref.DeclarationRef }

// FOUR ARMS, BECAUSE "CHECKED" WAS HIDING A REFUSAL. The subset arm previously carried only a
// count, and the projection that produced it discarded the nested geometry result -- so a world
// with two established components whose bodies COLLIDE and thirteen parts still owed rendered as
// "checked over established subset only", which reads as an incomplete but clean board. It was
// neither: the part of it that was checked had failed. Completeness and verdict are two axes and
// one arm cannot carry both, so each combination is now its own arm and a refusal survives at
// either population.
type PcbBodyLayoutStanding
  = PcbBodyLayoutAdmittedOverEveryRequiredPart
  | PcbBodyLayoutAdmittedOverEstablishedSubsetOnly { parts_still_owed: Int }
  | PcbBodyLayoutRefusedOverEstablishedSubset { parts_still_owed: Int, causes: product.pcb.physical.PhysicalRefusalSet }
  | PcbBodyLayoutRefusedOverCompletePopulation { causes: product.pcb.physical.PhysicalRefusalSet }

type EstablishedEnvelopeRead {
  identity: std.types.NonEmptyStr
  source: std.decl_ref.DeclarationRef
}

type PcbPhysicalWorld {
  board: PcbBoard
  components: List<product.pcb.physical.ComponentPlacement>
  envelope_reads: List<EstablishedEnvelopeRead>
  obligations: List<PcbComponentObligation>
  attachment_obligations: List<PcbAttachmentObligation>
  functional_obligations: List<PcbFunctionalObligation>
  body_layout: PcbBodyLayoutStanding
  stackup: PcbCapabilityStanding
  footprints: PcbCapabilityStanding
  pads: PcbCapabilityStanding
  routes: PcbCapabilityStanding
}

type PcbElectricalWorld {
  nets: PcbCapabilityStanding
}

type PcbManufacturingWorld {
  artifacts: PcbCapabilityStanding
}

type PcbWorld sole_constructor {
  design: std.decl_ref.DeclarationRef
  electrical: PcbElectricalWorld
  physical: PcbPhysicalWorld
  manufacturing: PcbManufacturingWorld
}

type PcbWorldRefusal
  = PcbBoardOutlineRefused { cause: std.orthogonal_geometry.OrthogonalRefusal }
  | PcbDesignPlanUnavailable { only_available: std.decl_ref.DeclarationRef }
  | PcbPlanWasBuiltFromADifferentDesign { plan_design: std.decl_ref.DeclarationRef, admitted_against: std.decl_ref.DeclarationRef }
  | PcbCapabilityStillPending { capability: std.types.NonEmptyStr }
  | PcbCapabilityRefused { capability: std.types.NonEmptyStr, cause: std.types.NonEmptyStr }
  | PcbPlacementNotAdmitted
  | PcbOutlineCopiedFromCitedForeignBoard

type PcbWorldConstruction<T>
  = PartialPcbWorldReady { value: T }
  | AdmittedPcbWorld { value: T }
  | PcbWorldRefused { cause: PcbWorldRefusal }

fn pcb_world_design(w: PcbWorld) -> std.decl_ref.DeclarationRef { w.design }
fn pcb_worlds_share_design(a: PcbWorld, b: PcbWorld) -> Bool {
  std.decl_ref.declaration_ref_eq(a: a.design, b: b.design)
}
fn pcb_world_physical(w: PcbWorld) -> PcbPhysicalWorld { w.physical }
fn pcb_envelope_reads(p: PcbPhysicalWorld) -> List<EstablishedEnvelopeRead> { p.envelope_reads }
fn pcb_body_layout(p: PcbPhysicalWorld) -> PcbBodyLayoutStanding { p.body_layout }
fn pcb_world_electrical(w: PcbWorld) -> PcbElectricalWorld { w.electrical }
fn pcb_world_manufacturing(w: PcbWorld) -> PcbManufacturingWorld { w.manufacturing }

fn capability_pending(what_is_owed: std.types.NonEmptyStr) -> PcbCapabilityStanding {
  CapabilityPending {
    owed: NonemptyCapabilityObligations {
      first: PcbCapabilityObligation { what_is_owed: what_is_owed },
      rest: [],
    }
  }
}

// EVERY NON-ESTABLISHED CAPABILITY BLOCKS ADMISSION, and a refused one blocks LOUDER than a
// pending one rather than quieter. An earlier revision answered Absent for CapabilityRefused,
// which read a world whose stackup, footprints, pads, routes, nets and artifacts had all been
// REFUSED as a world with nothing outstanding -- the empty-observation narrow DESIGN names, and
// the worse half of it, because the narrow is silently uncovered rather than merely expensive.
// PcbCapabilityStanding now HAS an established arm, so AdmittedPcbWorld is reachable in principle
// rather than by construction impossible. That is a change in what the type can express and not a
// claim about any world: every capability the Altra board carries is still pending, and this
// function is what keeps that fact deciding admission rather than whichever unrelated check
// happens to fail first.
fn unsettled_capability(s: PcbCapabilityStanding, name: std.types.NonEmptyStr) -> PcbWorldRefusal? {
  match s {
    CapabilityPending { owed: _ } => Present { value: PcbCapabilityStillPending { capability: name } }
    CapabilityRefused { cause: c } =>
      Present { value: PcbCapabilityRefused { capability: name, cause: c } }
    CapabilityEstablished { authority: _ } => Absent
  }
}

fn capability_established(authority: std.decl_ref.DeclarationRef) -> PcbCapabilityStanding {
  CapabilityEstablished { authority: authority }
}


fn first_present_refusal(a: PcbWorldRefusal?, b: PcbWorldRefusal?) -> PcbWorldRefusal? {
  match a {
    Present { value: v } => Present { value: v }
    Absent => b
  }
}

fn pcb_component_count(p: PcbPhysicalWorld) -> Int {
  fold(p.components, init: 0, f: fn(acc, _c) { acc + 1 })
}

fn pcb_obligation_count(p: PcbPhysicalWorld) -> Int {
  fold(p.obligations, init: 0, f: fn(acc, _o) { acc + 1 })
}

fn pcb_functional_obligation_count(p: PcbPhysicalWorld) -> Int {
  fold(p.functional_obligations, init: 0, f: fn(acc, _f) { acc + 1 })
}

fn pcb_attachment_obligation_count(p: PcbPhysicalWorld) -> Int {
  fold(p.attachment_obligations, init: 0, f: fn(acc, _o) { acc + 1 })
}

type PcbCauseCounts {
  missing_document: Int
  commercial_access: Int
  legal_carriage: Int
  unselected_part: Int
  drawing_must_be_read: Int
  standing_self_contradictory: Int
  named_attachment_part_unresolved: Int
}

fn pcb_cause_counts(p: PcbPhysicalWorld) -> PcbCauseCounts {
  fold(p.obligations, init: PcbCauseCounts {
    missing_document: 0,
    commercial_access: 0,
    legal_carriage: 0,
    unselected_part: 0,
    drawing_must_be_read: 0,
    standing_self_contradictory: 0,
    named_attachment_part_unresolved: 0,
  }, f: fn(acc, o) {
    match o.cause {
      MissingDocument { what_is_missing: _ } => PcbCauseCounts {
        missing_document: acc.missing_document + 1,
        commercial_access: acc.commercial_access,
        legal_carriage: acc.legal_carriage,
        unselected_part: acc.unselected_part,
        drawing_must_be_read: acc.drawing_must_be_read,
        standing_self_contradictory: acc.standing_self_contradictory,
        named_attachment_part_unresolved: acc.named_attachment_part_unresolved,
      }
      CommercialAccess { subject: _ } => PcbCauseCounts {
        missing_document: acc.missing_document,
        commercial_access: acc.commercial_access + 1,
        legal_carriage: acc.legal_carriage,
        unselected_part: acc.unselected_part,
        drawing_must_be_read: acc.drawing_must_be_read,
        standing_self_contradictory: acc.standing_self_contradictory,
        named_attachment_part_unresolved: acc.named_attachment_part_unresolved,
      }
      LegalCarriage { reason: _ } => PcbCauseCounts {
        missing_document: acc.missing_document,
        commercial_access: acc.commercial_access,
        legal_carriage: acc.legal_carriage + 1,
        unselected_part: acc.unselected_part,
        drawing_must_be_read: acc.drawing_must_be_read,
        standing_self_contradictory: acc.standing_self_contradictory,
        named_attachment_part_unresolved: acc.named_attachment_part_unresolved,
      }
      UnselectedPart { because: _ } => PcbCauseCounts {
        missing_document: acc.missing_document,
        commercial_access: acc.commercial_access,
        legal_carriage: acc.legal_carriage,
        unselected_part: acc.unselected_part + 1,
        drawing_must_be_read: acc.drawing_must_be_read,
        standing_self_contradictory: acc.standing_self_contradictory,
        named_attachment_part_unresolved: acc.named_attachment_part_unresolved,
      }
      DrawingMustBeRead { figure: _, what_is_drawn: _ } => PcbCauseCounts {
        missing_document: acc.missing_document,
        commercial_access: acc.commercial_access,
        legal_carriage: acc.legal_carriage,
        unselected_part: acc.unselected_part,
        drawing_must_be_read: acc.drawing_must_be_read + 1,
        standing_self_contradictory: acc.standing_self_contradictory,
        named_attachment_part_unresolved: acc.named_attachment_part_unresolved,
      }
      NamedAttachmentTypePartUnresolved { designation: _, missing: _ } => PcbCauseCounts {
        missing_document: acc.missing_document,
        commercial_access: acc.commercial_access,
        legal_carriage: acc.legal_carriage,
        unselected_part: acc.unselected_part,
        named_attachment_part_unresolved: acc.named_attachment_part_unresolved + 1,
        drawing_must_be_read: acc.drawing_must_be_read,
        standing_self_contradictory: acc.standing_self_contradictory,
      }
      StandingIsSelfContradictory { what_is_wrong: _ } => PcbCauseCounts {
        missing_document: acc.missing_document,
        commercial_access: acc.commercial_access,
        legal_carriage: acc.legal_carriage,
        unselected_part: acc.unselected_part,
        drawing_must_be_read: acc.drawing_must_be_read,
        standing_self_contradictory: acc.standing_self_contradictory + 1,
        named_attachment_part_unresolved: acc.named_attachment_part_unresolved,
      }
    }
  })
}

fn obligation_cause_tag(c: PcbObligationCause) -> std.types.NonEmptyStr {
  match c {
    MissingDocument { what_is_missing: _ } => "missing-document"
    CommercialAccess { subject: _ } => "commercial-access"
    LegalCarriage { reason: _ } => "legal-carriage"
    UnselectedPart { because: _ } => "unselected-part"
    DrawingMustBeRead { figure: _, what_is_drawn: _ } => "drawing-must-be-read"
    StandingIsSelfContradictory { what_is_wrong: _ } => "standing-self-contradictory"
    NamedAttachmentTypePartUnresolved { designation: _, missing: _ } => "named-attachment-type-part-unresolved"
  }
}

fn pcb_missing_document_count(p: PcbPhysicalWorld) -> Int {
  pcb_cause_counts(p: p).missing_document
}

fn pcb_commercial_access_count(p: PcbPhysicalWorld) -> Int {
  pcb_cause_counts(p: p).commercial_access
}

fn pcb_legal_carriage_count(p: PcbPhysicalWorld) -> Int {
  pcb_cause_counts(p: p).legal_carriage
}

fn pcb_unselected_part_count(p: PcbPhysicalWorld) -> Int {
  pcb_cause_counts(p: p).unselected_part
}

fn pcb_drawing_must_be_read_count(p: PcbPhysicalWorld) -> Int {
  pcb_cause_counts(p: p).drawing_must_be_read
}

fn pcb_standing_self_contradictory_count(p: PcbPhysicalWorld) -> Int {
  pcb_cause_counts(p: p).standing_self_contradictory
}

fn pcb_named_attachment_part_unresolved_count(p: PcbPhysicalWorld) -> Int {
  pcb_cause_counts(p: p).named_attachment_part_unresolved
}

fn pcb_population_count(p: PcbPhysicalWorld) -> Int {
  pcb_component_count(p: p) + pcb_obligation_count(p: p)
}

fn first_unsettled_capability(w: PcbWorld) -> PcbWorldRefusal? {
  first_present_refusal(
    a: unsettled_capability(s: w.physical.stackup, name: "stackup"),
    b: first_present_refusal(
      a: unsettled_capability(s: w.physical.footprints, name: "footprints"),
      b: first_present_refusal(
        a: unsettled_capability(s: w.physical.pads, name: "pads"),
        b: first_present_refusal(
          a: unsettled_capability(s: w.physical.routes, name: "routes"),
          b: first_present_refusal(
            a: unsettled_capability(s: w.electrical.nets, name: "nets"),
            b: unsettled_capability(s: w.manufacturing.artifacts, name: "artifacts"),
          ),
        ),
      ),
    ),
  )
}

fn pcb_world(
  design: std.decl_ref.DeclarationRef,
  electrical: PcbElectricalWorld,
  physical: PcbPhysicalWorld,
  manufacturing: PcbManufacturingWorld,
) -> PcbWorld {
  PcbWorld {
    design: design,
    electrical: electrical,
    physical: physical,
    manufacturing: manufacturing,
  }
}
