module product.printing.cad_runtime_spec

import std.types { NonEmptyStr, List }
import extdeps.cadquery.cadquery { cadquery_distribution_name, cadquery_version, cadquery_ocp_distribution }
import extdeps.opencascade.ocp { ocp_distribution_name, ocp_distribution_version }

// WHAT THE PRINT RUNTIME'S CAD INTERPRETER MUST IMPORT, AND AT WHICH VERSION. This is the one roster
// the runtime check reads back against, and the one a CAD environment convergence will install.
// The system libraries OCP links against are not here: on the direct Ubuntu host they are apt
// packages (extdeps.opencascade.ocp ocp_ubuntu2404_runtime_packages, joined in
// product.printing.runtime_dependencies runtime_packages), so naming a second provider for the same
// SONAMEs would be two answers to one question.
type PythonDistributionRequirement sole_constructor {
  distribution: NonEmptyStr
  version: NonEmptyStr
}

fn python_distribution_name(r: PythonDistributionRequirement) -> NonEmptyStr { r.distribution }
fn python_distribution_version(r: PythonDistributionRequirement) -> NonEmptyStr { r.version }

data cadquery_requirement: PythonDistributionRequirement = PythonDistributionRequirement {
  distribution: cadquery_distribution_name,
  version: cadquery_version,
}

data ocp_requirement: PythonDistributionRequirement = PythonDistributionRequirement {
  distribution: ocp_distribution_name(d: cadquery_ocp_distribution),
  version: ocp_distribution_version,
}

// The selected kernel distribution is pinned beside CadQuery, so an installed distribution of the
// other OCP flavour cannot satisfy the roster by name alone.
data cad_runtime_python_requirements: List<PythonDistributionRequirement> = [
  ocp_requirement,
  cadquery_requirement,
]
