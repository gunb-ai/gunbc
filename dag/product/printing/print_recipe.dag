module product.printing.print_recipe
import std.types { String, NonEmptyStr, List, Int, Bool }
import extdeps.printing.fdm { FilamentMaterial, Pla, Petg }
import extdeps.printing.orca_slicer { OrcaProfileKind, OrcaMachineProfile, OrcaFilamentProfile, OrcaProcessProfile, orca_bbl_profile_path }
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.languages.json.emit { JsonValue, JsonKeyValue, JsonObject, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, json_kv, json_string, json_array }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable }
import product.printing.process_geometry { prototype_support_policy, support_settings }

// A PRINT RECIPE IS THE WHOLE SLICER INPUT, NAMED ONCE. Selecting a material alone would leave the
// machine, filament and process profiles to whichever files a host happens to hold. A recipe names
// three system profiles of the pinned Orca release (extdeps.printing.orca_slicer) and the process
// keys this product imposes over them; the support keys come from
// product.printing.process_geometry support_settings, never restated here. A changed override is a
// new recipe name.
type PrintRecipe {
  name: NonEmptyStr
  material: FilamentMaterial
  machine: NonEmptyStr
  filament: NonEmptyStr
  process: NonEmptyStr
  process_name: NonEmptyStr
  process_overrides: List<JsonKeyValue>
}

// The speed, acceleration, wall and infill policy of the unpowered cassette prototypes, read as the
// difference between the profiles those prints used and Orca 2.4.2's 0.20mm Standard @BBL A1M.
data a1_mini_slow_strong_process: List<JsonKeyValue> = [
  json_kv(key: "bottom_shell_layers", value: json_string(s: "5")),
  json_kv(key: "bridge_speed", value: json_string(s: "25")),
  json_kv(key: "brim_type", value: json_string(s: "outer_only")),
  json_kv(key: "brim_width", value: json_string(s: "4")),
  json_kv(key: "curr_bed_type", value: json_string(s: "Textured PEI Plate")),
  json_kv(key: "default_acceleration", value: json_string(s: "1000")),
  json_kv(key: "inner_wall_acceleration", value: json_string(s: "1000")),
  json_kv(key: "inner_wall_speed", value: json_string(s: "100")),
  json_kv(key: "internal_solid_infill_speed", value: json_string(s: "100")),
  json_kv(key: "outer_wall_acceleration", value: json_string(s: "500")),
  json_kv(key: "outer_wall_speed", value: json_string(s: "60")),
  json_kv(key: "raft_first_layer_expansion", value: json_string(s: "0")),
  json_kv(key: "sparse_infill_density", value: json_string(s: "20%")),
  json_kv(key: "sparse_infill_pattern", value: json_string(s: "gyroid")),
  json_kv(key: "sparse_infill_speed", value: json_string(s: "120")),
  json_kv(key: "wall_loops", value: json_string(s: "4")),
]

data a1_mini_pla_prototype_v1: PrintRecipe = PrintRecipe {
  name: "a1-mini-pla-prototype-v1",
  material: Pla,
  machine: "Bambu Lab A1 mini 0.4 nozzle",
  filament: "Generic PLA @BBL A1M",
  process: "0.20mm Standard @BBL A1M",
  process_name: "Cassette unpowered prototype 0.20 PLA supported",
  process_overrides: a1_mini_slow_strong_process,
}

// Same process policy over Orca's own PETG temperatures and flow limit. Fit, heat and service
// acceptance are separate observations of the printed part, not properties of this recipe.
data a1_mini_petg_functional_v1: PrintRecipe = PrintRecipe {
  name: "a1-mini-petg-functional-v1",
  material: Petg,
  machine: "Bambu Lab A1 mini 0.4 nozzle",
  filament: "Generic PETG @BBL A1M",
  process: "0.20mm Standard @BBL A1M",
  process_name: "Functional 0.20 PETG supported",
  process_overrides: a1_mini_slow_strong_process,
}

data print_recipes: List<PrintRecipe> = [a1_mini_pla_prototype_v1, a1_mini_petg_functional_v1]

fn print_recipe_from_wire(s: String) -> PrintRecipe? {
  filter(print_recipes, r => (r.name as String) == s).first()
}

fn recipe_process_overrides(r: PrintRecipe) -> List<JsonKeyValue> {
  concat(concat(r.process_overrides, support_settings(p: prototype_support_policy)), [
    json_kv(key: "name", value: json_string(s: r.process_name as String)),
    json_kv(key: "from", value: json_string(s: "user")),
  ])
}

// FLATTENING FOLLOWS THE UPSTREAM INHERITANCE RULE AND REFUSES EVERYTHING ELSE: an unreadable file,
// a file whose `name` is not its stem, a non-object, or a chain deeper than the bound.
type OrcaProfileFlattening
  = OrcaProfileFlattened { members: List<JsonKeyValue> }
  | OrcaProfileRefused { name: String, cause: NonEmptyStr }

data orca_profile_inheritance_bound: Int = 8

fn keyed(members: List<JsonKeyValue>, key: String) -> Bool { any(members, m => m.key == key) }

fn overlay(base: List<JsonKeyValue>, top: List<JsonKeyValue>) -> List<JsonKeyValue> {
  concat(filter(base, m => !keyed(members: top, key: m.key)), top)
}

fn string_member(members: List<JsonKeyValue>, key: String) -> String? {
  match filter(members, m => m.key == key).first() {
    Absent => none
    Present { value: m } => match m.value { JsonString { value: v } => Present { value: v } _ => none }
  }
}

fn flatten_orca_profile(extracted_into: String, kind: OrcaProfileKind, name: String, depth: Int) -> OrcaProfileFlattening {
  if depth <= 0 { return OrcaProfileRefused { name: name, cause: "Profile inheritance deeper than the declared bound" } }
  let read = Filesystem.Read(path: orca_bbl_profile_path(extracted_into: extracted_into, kind: kind, name: name))
  if !read.success { return OrcaProfileRefused { name: name, cause: "Profile file unreadable in the extracted archive" } }
  let members = match parse_json_document(s: read.content) {
    JsonDocumentParsed { value: JsonObject { members: m } } => m
    _ => return OrcaProfileRefused { name: name, cause: "Profile is not a JSON object" }
  }
  match string_member(members: members, key: "name") {
    Present { value: n } => if n != name { return OrcaProfileRefused { name: name, cause: "Profile name differs from its file stem" } }
    Absent => return OrcaProfileRefused { name: name, cause: "Profile carries no name" }
  }
  let own = filter(members, m => m.key != "inherits" && m.key != "instantiation")
  match string_member(members: members, key: "inherits") {
    Absent => OrcaProfileFlattened { members: own }
    Present { value: parent } => match flatten_orca_profile(extracted_into: extracted_into, kind: kind, name: parent, depth: depth - 1) {
      OrcaProfileFlattened { members: base } => OrcaProfileFlattened { members: overlay(base: base, top: own) }
      refused => refused
    }
  }
}
