module product.electrical.photograph

import std.content_hash { Sha256Digest }
import std.list { first_where }
import std.measure { PositiveByteSize, positive_byte_size_bytes }
import std.nat { Nat }
import std.optional { Absent, Present }
import std.types { Bool, List, NonEmptyStr }
import product.placement_supply { PhysicalAssetIdentity, physical_asset_identity_eq }

// WHAT A PHOTOGRAPH IS IN THE MODEL. A reading of a board is read off an image, and the image is what
// lets someone who was not at the bench re-check the reading. So a photograph is a row identified by its
// CONTENT -- the SHA-256 of its bytes, std.content_hash's `Sha256Digest` -- and not by the sentence
// describing it or the name it has in a folder: a name gets reassigned, a sentence gets rewritten, and
// the bytes are what a later reader re-hashes against the claim. A store row says the bytes exist and
// where to get them; a citation names one by digest, so claim and artefact meet at a value rather than
// at a paraphrase. product.p4261.evidence names exactly this as the rung its own support rises on.
//
// WHY THE GAP IS TYPED AND NOT LEFT OUT. Bench sessions before the store existed sent frames into a
// chat; their bytes are not ours to hash. Deleting such a citation would quietly delete the reading it
// carries, and minting a digest nobody computed would make an uncheckable claim look checkable -- the one
// thing a content identity exists to prevent. So `BytesNotInStore` keeps what we do have (the date, the
// locator, and the obligation that would close it) and stays visibly a gap. A consumer that requires
// checkable evidence refuses it, by name, rather than trusting it.
//
// WHY A DRAWING WE MADE IS NOT EVIDENCE. The atlas also generated images: grid overviews, function-zone
// drafts, a pinout, a power-path diagram. They show where a reading came from; they are not a record of
// what the board carries, because we drew them from the readings. `GeneratedImage` keeps them addressable
// and `citation_verdict` refuses them as grounding: an image cannot corroborate what it was drawn
// from. This is the atlas manifest's own caveat ("derived (not evidence on its own)") in the model.
// Each one names the atlas snapshot whose annotations it carries, and keeps two dates apart: the day
// the view was drawn, and the capture day of the pixels underneath it, which belongs to the raw
// capture and is not this row's to invent.

// WHICH FACE OF THE CARRIER A FRAME SHOWS. Said of the frame, not of a part: which face a component sits
// on is product.p4261.carrier's BoardSide, judged from the board. This is what the camera was pointed at.
type PhotographSurface
  = TopSurface
  | BottomSurface
  // A frame nobody has placed on a face. Batch 5's unplaced SD frames are cap tops and label-less shots;
  // guessing a face would put a part on the wrong side of the board, so the absence is named instead, with
  // the word that would close it. `is_captured_on` treats it as neither side.
  | SurfaceUnrecorded { obligation: NonEmptyStr }

// WHEN THE FRAME WAS TAKEN, as the receipts record it. An atlas frame's file name carries its day; a
// frame the registry lists as an earlier shot carries only the day it was uploaded, so its capture date
// is a gap with what would close it. `CaptureDateUnrecorded` is not an unknown standing in for a fact:
// it says which note would fix it.
type PhotographDate
  = CapturedOn { on: NonEmptyStr }
  | CaptureDateUnrecorded { obligation: NonEmptyStr }

// WHAT MADE THE FRAME. Recorded because grain follows the device: a marking legible on the microscope
// screen and a shape in a phone frame are not read at the same resolution, and a claim should be able to
// say which it rested on. Where the receipts are silent the device is a named gap, not a default.
type CaptureDevice
  = AndonstarMicroscopeScreen
  // The Andonstar writing the frame itself, from its own sensor, onto its SD card: no screen and no phone
  // in the path, so the frame carries the sensor's full 4032x3024 and no moire. It is a different grain
  // from a screen capture and must not borrow its value -- a marking legible in one of these need not be
  // legible in a picture of the screen, and a claim resting on the difference has to say which it read.
  | AndonstarSdCardSensor
  | PhoneCamera
  | DeviceUnrecorded { obligation: NonEmptyStr }

// WHERE THE IMAGE CAME FROM. A captured frame is the board's own evidence. A generated image is ours: it
// depicts the board only through the readings it was drawn from, so it can locate a reading and cannot
// ground one.
type PhotographOrigin
  = CapturedFrame { surface: PhotographSurface, capture: CaptureDevice, taken_on: PhotographDate }
  | GeneratedImage {
      depicts: NonEmptyStr,
      drawn_by: NonEmptyStr,
      drawn_on: NonEmptyStr,
      atlas_revision: NonEmptyStr,
    }

// WHERE THE BYTES ARE HELD, so a row can be re-checked rather than believed: a Drive folder and the name
// inside it. The digest is what says the file there is the file this row is about.
type StoreLocation {
  folder_id: NonEmptyStr,
  folder_name: NonEmptyStr,
  file_name: NonEmptyStr,
}

// ONE PHOTOGRAPH THE STORE HOLDS. `bytes` is kept because content identity is checked by re-hashing
// bytes: it says how many a reader should get, and what is wrong with what they got if they get otherwise.
type Photograph {
  content: Sha256Digest,
  board: PhysicalAssetIdentity,
  origin: PhotographOrigin,
  bytes: PositiveByteSize,
  store: StoreLocation,
}

// A BOX INSIDE A FRAME, in the cited frame's own pixels, origin at its top-left. The atlas boxes readings
// this way ("the label at about (175-240,120-160) px original"), so a claim can point at the part instead
// of at the whole board the part happens to be on.
type PixelRegion {
  left: Nat,
  top: Nat,
  width: Nat,
  height: Nat,
}

// A CITATION OF A PHOTOGRAPH FROM A CLAIM. `InStore` names bytes the store holds, and the region is
// absent when the whole frame is what was read. `BytesNotInStore` is the typed gap for a frame whose
// bytes never reached the store: it carries the text locator the bench recorded and the obligation that
// would close it, and it never carries a digest somebody guessed.
type PhotographCitation
  = InStore { content: Sha256Digest, region: PixelRegion? }
  | BytesNotInStore { taken_on: NonEmptyStr, locator: NonEmptyStr, obligation: NonEmptyStr }

// WHAT THE STORE MAKES OF A CITATION, in words a report can use. A Bool would say only "no"; each
// refusal here names what is missing, so the gap is a work item rather than a mystery.
type CitationStanding
  = CheckableAgainstStoredBytes { surface: PhotographSurface, region: PixelRegion? }
  | BytesNeverStored { taken_on: NonEmptyStr, locator: NonEmptyStr, obligation: NonEmptyStr }
  | DigestNotInStore { content: Sha256Digest }
  | FrameIsOurOwnDrawing { depicts: NonEmptyStr, obligation: NonEmptyStr }
  // THE DIGEST RESOLVES, BUT TO A PICTURE OF A DIFFERENT OBJECT. A content hash says which bytes; it does
  // not say what they depict. `Photograph.board` is the specimen the frame is of, and a frame of another
  // board cannot be re-read to check a reading taken off this one -- the pixels would show a different
  // board's silkscreen, a different part's body. Broken rather than quietly dropped: a citation that points
  // at another specimen's frame is a record defect, and the sheet has to say so.
  | FrameDepictsAnotherBoard { content: Sha256Digest, depicted_on: PhysicalAssetIdentity, obligation: NonEmptyStr }

fn sha256_digest_eq(a: Sha256Digest, b: Sha256Digest) -> Bool {
  a.hex == b.hex
}

// The store's lookup, and the only way a digest becomes a frame.
fn photograph_in_store(store: List<Photograph>, content: Sha256Digest) -> Photograph? {
  first_where(store, p => sha256_digest_eq(a: p.content, b: content))
}

// WHAT A CITATION RESTS ON. Resolved by content, never by text: two rows with the same file name are
// still two frames, and a row we drew cannot ground a reading of the board.
fn cite(store: List<Photograph>, citation: PhotographCitation, judged: PhysicalAssetIdentity) -> CitationStanding {
  match citation {
    InStore { content, region } => match photograph_in_store(store: store, content: content) {
      Present { value } =>
        // The digest found a row; the row says which board that picture is of. Both must agree with the
        // board under judgement, or the citation cannot carry a reading about it.
        if physical_asset_identity_eq(a: value.board, b: judged) {
          match value.origin {
            CapturedFrame { surface, capture: _, taken_on: _ } =>
              CheckableAgainstStoredBytes { surface: surface, region: region }
            GeneratedImage { depicts, drawn_by: _, drawn_on: _, atlas_revision: _ } =>
              frame_is_our_own_drawing(depicts: depicts)
          }
        } else {
          frame_depicts_another_board(content: content, depicted_on: value.board)
        }
      Absent => DigestNotInStore { content: content }
    }
    BytesNotInStore { taken_on, locator, obligation } =>
      BytesNeverStored { taken_on: taken_on, locator: locator, obligation: obligation }
  }
}

// The refusal for citing a frame that pictures some other board. Same reason as the drawing refusal: the
// obligation travels with the standing so no caller has to re-type (and could forget) the remedy.
fn frame_depicts_another_board(content: Sha256Digest, depicted_on: PhysicalAssetIdentity) -> CitationStanding {
  FrameDepictsAnotherBoard {
    content: content,
    depicted_on: depicted_on,
    obligation: "cite a frame photographed on the board this reading was taken from; a frame of another specimen cannot corroborate this board's markings, whatever bytes it holds",
  }
}

// The refusal for citing an image we generated. The obligation is the same at every site, so it lives
// here instead of being re-typed where someone might make the mistake.
fn frame_is_our_own_drawing(depicts: NonEmptyStr) -> CitationStanding {
  FrameIsOurOwnDrawing {
    depicts: depicts,
    obligation: "cite the captured frame this image was drawn from; a drawing cannot corroborate the readings it was drawn from",
  }
}

// WHAT A CITATION CAN CARRY, decided once. The store classifies the bytes and this fold is the only
// place that decision is written: the census in product.p4261.evidence and the photograph witnesses
// both read it, so checkability is not re-derived consumer by consumer. Checkable -- the bytes are in
// the store, so the reading can be re-checked against the frame. Gap -- the bytes were never hashed,
// so the reading stands on a locator and an obligation rather than on bytes. Broken -- the citation
// points at something that cannot carry a reading: bytes we do not hold under that digest, or a frame
// we drew ourselves.
// EXHAUSTIVE ON PURPOSE, with no `_`: a fifth standing would have to be classified here rather than
// silently landing in no partition, which is how a board of unread rows would come to count as fully
// grounded.
type CitationVerdict
  = Checkable
  | Gap
  | Broken

fn citation_verdict(standing: CitationStanding) -> CitationVerdict {
  match standing {
    CheckableAgainstStoredBytes { surface: _, region: _ } => Checkable
    BytesNeverStored { taken_on: _, locator: _, obligation: _ } => Gap
    DigestNotInStore { content: _ } => Broken
    FrameIsOurOwnDrawing { depicts: _, obligation: _ } => Broken
    FrameDepictsAnotherBoard { content: _, depicted_on: _, obligation: _ } => Broken
  }
}

// WHAT THE CITATION SAYS ABOUT ITSELF, in words. A consumer that has to name a failure reads this
// instead of reaching into an arm, so why a citation cannot carry a reading is written down once
// (product.p4261.report renders it, and a photograph witness asserts it). A digest prints in full: a
// truncated one invites believing without checking, and the whole point of a digest is that a reader
// can look it up.
fn citation_explanation(standing: CitationStanding) -> String {
  match standing {
    CheckableAgainstStoredBytes { surface: _, region: region } => match region {
      Present { value } => join(
        ["the frame's own pixels, box (", to_string(value.left), ",", to_string(value.top), ") ", to_string(value.width), " by ", to_string(value.height), " px"],
        ""
      )
      Absent => join(["the frame's own pixels, whole frame"], "")
    }
    BytesNeverStored { taken_on: taken_on, locator: locator, obligation: obligation } => join(
      ["bytes never hashed; the locator says ", locator as String, " taken ", taken_on as String, ". To close it: ", obligation as String],
      ""
    )
    DigestNotInStore { content: content } => join(
      ["no stored frame carries the cited digest ", content.hex as String],
      ""
    )
    FrameIsOurOwnDrawing { depicts: depicts, obligation: obligation } => join(
      ["the cited frame is our own drawing of ", depicts as String, "; an image we drew from a reading cannot corroborate it. To close it: ", obligation as String],
      ""
    )
    FrameDepictsAnotherBoard { content: content, depicted_on: depicted_on, obligation: obligation } => join(
      ["the cited digest ", content.hex as String, " is held as a picture of '", depicted_on as String, "', not of the board this reading was taken from. To close it: ", obligation as String],
      ""
    )
  }
}

// How a citation reads in a sentence a person or a report can quote. The digest is printed in full: a
// truncated one invites believing without checking, and the whole point of the digest is that it can be
// looked up. A gap prints its locator and date, so the sentence never reads better than the claim.
fn photograph_citation_text(citation: PhotographCitation) -> String {
  match citation {
    InStore { content, region } => match region {
      Present { value } => join(
        ["photograph ", content.hex as String, " at (", to_string(value.left), ",", to_string(value.top), ") ", to_string(value.width), " by ", to_string(value.height), " px"],
        ""
      )
      Absent => join(["photograph ", content.hex as String, " (whole frame)"], "")
    }
    BytesNotInStore { taken_on, locator, obligation: _ } =>
      join(["photograph ", locator as String, " (", taken_on as String, ", bytes not in the store)"], "")
  }
}
