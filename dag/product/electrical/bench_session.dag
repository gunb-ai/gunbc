module product.electrical.bench_session

import std.logic { Bool }
import std.types { String, NonEmptyStr, List }
import std.nat { Nat, nat_min, nat_max }
import std.measure { Millivolt, Volt, millivolt_count, volt_count }
import product.placement_supply { PhysicalAssetIdentity, physical_asset_identity_eq }
import product.electrical.connectivity { ElectricalTerminalRef, ComponentInstanceIdentity, terminal_ref_equal }
import product.electrical.continuity {
  AfterIncidents,
  BeforeIncidents,
  BenchConditions,
  ContinuityObservation,
  EvidenceRef,
  OrderUnrecorded,
  ReadingOrder,
  ProbeRecord,
  probe_record_inferred,
  terminal_text,
}

// WHAT A MULTIMETER READ ON A POWERED BOARD, AND WHAT HAPPENED TO THE BOARD BETWEEN READINGS.
// product.electrical.continuity keeps unpowered buzzer and diode-mode receipts; this module keeps a
// node's voltage against a reference while the board is energized, a resistance read on a stated
// range, and the bench incidents that divide one session's readings from another's.
//
// A READING KNOWS WHERE IT STANDS AGAINST EACH INCIDENT. An accidental bridge on a live board can
// change what a later reading means, so every reading here says whether it came before or after the
// session's incidents, or that its order against them is unrecorded, and a standing derived from it
// carries that; a reading taken after an incident, or of unrecorded order, is never presented as one
// taken before.
//
// A VOLTAGE KNOWS THE SOURCE IT WAS READ UNDER. Each node reading carries the bench source's setting,
// so two readings of one node under different settings say whether the node tracks the source.
//
// A RESISTANCE DISPLAY IS READ ON ITS RANGE, WITH ITS PROBES' PLACEMENT. A range's full scale fixes the display's unit, so a value
// is kept in ohms only with its range; a display at the shorted-probe baseline, above it with its value
// unrecorded, or over range, is its own reading, never a number. In-circuit resistance runs through
// every parallel path, so a value is what the meter saw between two points, not a component's value.
//
// A ZERO IS READ AGAINST THE PROBES' OWN ZERO. The leads have resistance of their own, and a display's
// last digit is one count of its range, so "0.00" on one range is a bound another range shows as a
// value. A display joins two points only against the display the same meter gave with its probes
// shorted, on the reading's own range, recorded with the session's readings; a zero the operator
// reports with no such baseline recorded is kept as reported and joins nothing.
//
// A STATED BOUND IS NOT A VALUE. "Well below 2.5 V" bounds the reading from above and says nothing
// finer; a derivation may use the bound, never a number inside it. Whether the operator stated a
// reading plainly or hedged it is kept beside it.

type DamageInspection
  = NoDamageSeen { looked_at: NonEmptyStr }
  | DamageSeen { description: NonEmptyStr }
  | NotInspected

// An accidental bridge or similar event on the bench. bridged are the terminals the operator says the
// probe joined; record says whether each point was recorded or inferred.
type BenchIncident {
  key: NonEmptyStr
  asset: PhysicalAssetIdentity
  bridged: List<ElectricalTerminalRef>
  record: ProbeRecord
  conditions: BenchConditions
  observed: NonEmptyStr
  inspection: DamageInspection
  evidence: EvidenceRef
}


type StatementCertainty
  = StatedPlainly
  | StatedHedged { verbatim: NonEmptyStr }

type VoltageValue
  = ReadAbout { value: Millivolt }
  | ReadBelow { bound: Millivolt }

// at is the probed node, reference where the black probe sat, source the bench source's setting.
type NodeVoltageObservation {
  asset: PhysicalAssetIdentity
  at: ElectricalTerminalRef
  reference: ElectricalTerminalRef
  record: ProbeRecord
  conditions: BenchConditions
  source: Volt
  value: VoltageValue
  certainty: StatementCertainty
  order: ReadingOrder
  evidence: List<EvidenceRef>
}

// AutoRanging is a meter choosing its own range per reading (the Fluke's default mode): the display
// carries the unit it chose, so a figure read on it is a value, but no shorted-probe baseline joins
// across it, because the baseline's range and the reading's need not be the same one, and it adds no
// range to the judgment of whether a pair's reading moves with the range.
type MeterRange
  = RangeFullScale { ohms: Nat }
  | AutoRanging
  | RangeUnrecorded

// full_scale_ohms is the range the baseline was read on; shown is what the display gave with the probes
// shorted.
type ShortedProbeBaseline {
  full_scale_ohms: Nat
  shown: NonEmptyStr
  evidence: EvidenceRef
}

// reported is the operator's words for the display ("0.00", "0 ohm", "ground").
type ResistanceDisplay
  = DisplayValue { ohms: Nat, approximate: Bool }
  | DisplayAtProbeBaseline { shown: NonEmptyStr, baseline: ShortedProbeBaseline }
  | DisplayZeroWithoutBaseline { reported: NonEmptyStr }
  | DisplayAboveBaseline
  | DisplayOverRange

// WHICH PROBE TOUCHED WHICH POINT. A path holding a junction reads differently with the probes swapped,
// so a reading keeps which of its two points the red probe touched. It does not say which probe is
// positive: on a meter whose resistance-mode source polarity has not been verified, red-positive is a
// convention, not an established fact, and a derivation of a junction's direction waits on that check.
type ProbePolarity
  = RedOnFirst
  | RedOnSecond
  | PolarityUnrecorded

// Stability is whether the display held or kept moving, which a capacitor behind the path makes it do.
type ReadingStability
  = HeldSteady
  | KeptMoving
  | StabilityUnrecorded

type ResistanceObservation {
  asset: PhysicalAssetIdentity
  first: ElectricalTerminalRef
  second: ElectricalTerminalRef
  record: ProbeRecord
  conditions: BenchConditions
  polarity: ProbePolarity
  range: MeterRange
  display: ResistanceDisplay
  stability: ReadingStability
  certainty: StatementCertainty
  order: ReadingOrder
  evidence: List<EvidenceRef>
}

// Whether a resistance reading is a zero the operator reported with no shorted-probe baseline recorded.
fn is_reported_zero(o: ResistanceObservation) -> Bool {
  match o.display {
    DisplayZeroWithoutBaseline { reported: _ } => true
    DisplayAtProbeBaseline { shown: _, baseline: _ } => false
    DisplayValue { ohms: _, approximate: _ } => false
    DisplayAboveBaseline => false
    DisplayOverRange => false
  }
}

// Whether a resistance reading joins its two points at the shorted-probe baseline: only against a
// baseline read on the reading's own recorded range.
fn is_at_baseline(o: ResistanceObservation) -> Bool {
  match o.display {
    DisplayAtProbeBaseline { shown: _, baseline } => match o.range {
      RangeFullScale { ohms } => ohms == baseline.full_scale_ohms
      AutoRanging => false
      RangeUnrecorded => false
    }
    DisplayZeroWithoutBaseline { reported: _ } => false
    DisplayValue { ohms: _, approximate: _ } => false
    DisplayAboveBaseline => false
    DisplayOverRange => false
  }
}

// A PROBE WIRE FIXED TO A LEAD IS ITS OWN POINT. What the meter touched was the wire; that the wire sat
// on the terminal the operator named, and on it alone, is the operator's statement, not a reading. So
// readings taken at the wire are recorded at the wire's point, and intended names the terminal the wire
// was meant for. Whether it stands for that terminal is derived from readings joining the two, in the
// layer that reads the board, and never stored here; disputes are the operator's own later statements
// doubting where it sat. A ruling is the operator's statement settling that the wire sits on the
// terminal: it closes the question in the record, and it is still not a reading.
type ProbeAttachment {
  point: ElectricalTerminalRef
  intended: ElectricalTerminalRef
  statement: EvidenceRef
  disputes: List<EvidenceRef>
  ruling: List<EvidenceRef>
}

// A CHANGE THE OPERATOR MADE TO THE ASSET THAT IS NEITHER A PROBE NOR A READING: a part's heatsink
// lifted to read its marking, its thermal interface removed and another applied. Readings before and
// after are of different physical states, so the alteration is keyed and dated; what was applied is
// Absent until the refit is reported, and a report says so rather than assuming it.
type ThermalInterface
  = ThermalPad
  | ThermalPaste
  | InterfaceUnstated

// What an alteration did: a thermal interface changed under a part, or a part lifted off the board. A
// lifted part's footprint is bare until a refit is reported, and readings at that footprint are of a
// different physical state from readings at the part's leads, so the alteration carries whether the
// refit has happened rather than assuming it.
type AlterationChange
  = ThermalInterfaceChanged { removed: ThermalInterface, applied: ThermalInterface? }
  | PartRemoved { refitted: Bool }

type AssetAlteration {
  key: NonEmptyStr
  asset: PhysicalAssetIdentity
  part: ComponentInstanceIdentity
  performed_on: NonEmptyStr
  change: AlterationChange
  evidence: EvidenceRef
}

fn thermal_interface_text(t: ThermalInterface) -> String {
  match t {
    ThermalPad => "a thermal pad"
    ThermalPaste => "thermal paste"
    InterfaceUnstated => "an interface the operator did not state"
  }
}

type BenchRecord {
  incidents: List<BenchIncident>
  attachments: List<ProbeAttachment>
  alterations: List<AssetAlteration>
  voltages: List<NodeVoltageObservation>
  resistances: List<ResistanceObservation>
}

data no_bench_record: BenchRecord = BenchRecord { incidents: [], attachments: [], alterations: [], voltages: [], resistances: [] }

// Whether a reading may stand for the board's state before every incident it is ordered against.
fn is_before_incidents(o: ReadingOrder) -> Bool {
  match o {
    BeforeIncidents { keys: _ } => true
    AfterIncidents { keys: _ } => false
    OrderUnrecorded { relative_to: _ } => false
  }
}

// ── PHYSICAL STATE: WHICH READINGS DESCRIBE ONE STATE OF THE ASSET ─────────────────────────────────
//
// A FOLD OVER READINGS IS A FOLD OVER ONE PHYSICAL STATE, chosen before the fold. A join read before a
// converter was lifted and a reading of its bare footprint after are of two different boards; a fold
// that takes both as one board's readings invents a circuit no one measured. So a derivation names
// the state it reads (SpecimenState) and its readings are selected for that state first.
//
// WHICH RECORDED EVENTS DIVIDE STATES, and the reason each does or does not, is decided once here:
// - a part removed (refitted or not) divides: the circuit had the part, then did not, and a refit is a
//   second soldering whose joints are not the factory's;
// - a thermal interface changed does not: no electrical terminal was touched;
// - an incident divides unless it was inspected and no damage was seen: a damage seen, or no
//   inspection at all, leaves the board's state after it unknown, so readings either side are kept
//   apart rather than assumed equal (fail closed). An incident inspected without damage is not a
//   boundary, and the state carries no claim that the inspection could see everything.
//
// A reading belongs to a state when the boundary events it follows are exactly the state's. A reading
// whose order is unrecorded against a BOUNDARY event belongs to no state: it stays recorded, and a
// selection counts it among the readings it excluded instead of folding it into a current-state
// result. Unrecorded order against an event that divides no state places the reading as well as any
// other: by the ReadingOrder convention it follows no recorded event it does not list.
type SpecimenState sole_constructor {
  asset: PhysicalAssetIdentity
  after: List<NonEmptyStr>
}

fn alteration_divides_state(a: AssetAlteration) -> Bool {
  match a.change {
    ThermalInterfaceChanged { removed: _, applied: _ } => false
    PartRemoved { refitted: _ } => true
  }
}

fn incident_divides_state(i: BenchIncident) -> Bool {
  match i.inspection {
    NoDamageSeen { looked_at: _ } => false
    DamageSeen { description: _ } => true
    NotInspected => true
  }
}

fn state_boundaries(r: BenchRecord) -> List<NonEmptyStr> {
  concat(map(filter(r.alterations, a => alteration_divides_state(a: a)), a => a.key), map(filter(r.incidents, i => incident_divides_state(i: i)), i => i.key))
}

fn key_listed(keys: List<NonEmptyStr>, k: NonEmptyStr) -> Bool {
  any(keys, x => (x as String) == (k as String))
}

fn same_keys(a: List<NonEmptyStr>, b: List<NonEmptyStr>) -> Bool {
  all(a, k => key_listed(keys: b, k: k)) && all(b, k => key_listed(keys: a, k: k))
}

// The intact state: before every boundary event. Always a state of the asset, whatever its record.
fn intact_state(asset: PhysicalAssetIdentity) -> SpecimenState {
  SpecimenState { asset: asset, after: [] }
}

// The state after the named boundary events and before every other one. Refuses (Absent) a key the
// record does not hold as a boundary: naming an event that does not divide states would select no
// reading at all, an empty result indistinguishable from a board with nothing read.
fn state_after(r: BenchRecord, asset: PhysicalAssetIdentity, keys: List<NonEmptyStr>) -> SpecimenState? {
  let boundaries = state_boundaries(r: r)
  if all(keys, k => key_listed(keys: boundaries, k: k)) { Present { value: SpecimenState { asset: asset, after: keys } } } else { Absent }
}

fn follows_no_boundary() -> List<NonEmptyStr>? {
  Present { value: [] }
}

// The boundary events a reading follows, or Absent when its order against some boundary is unrecorded.
fn boundaries_followed(boundaries: List<NonEmptyStr>, o: ReadingOrder) -> List<NonEmptyStr>? {
  match o {
    BeforeIncidents { keys: _ } => follows_no_boundary()
    AfterIncidents { keys } => Present { value: filter(keys, k => key_listed(keys: boundaries, k: k)) }
    OrderUnrecorded { relative_to } => if any(relative_to, k => key_listed(keys: boundaries, k: k)) { Absent } else { follows_no_boundary() }
  }
}

fn order_in_state(boundaries: List<NonEmptyStr>, s: SpecimenState, o: ReadingOrder) -> Bool {
  match boundaries_followed(boundaries: boundaries, o: o) {
    Absent => false
    Present { value: follows } => same_keys(a: follows, b: s.after)
  }
}

fn order_placed(boundaries: List<NonEmptyStr>, o: ReadingOrder) -> Bool {
  match boundaries_followed(boundaries: boundaries, o: o) {
    Absent => false
    Present { value: _ } => true
  }
}

// One state's readings, and how many of the asset's readings were left out and why: of another
// state, or of unrecorded order. Readings of another asset are not this asset's and are not counted.
type StateReadings {
  state: SpecimenState
  continuity: List<ContinuityObservation>
  resistances: List<ResistanceObservation>
  voltages: List<NodeVoltageObservation>
  excluded_other_state: Nat
  excluded_order_unrecorded: Nat
}

fn state_readings(r: BenchRecord, continuity: List<ContinuityObservation>, s: SpecimenState) -> StateReadings {
  let boundaries = state_boundaries(r: r)
  let cs = filter(continuity, o => physical_asset_identity_eq(a: o.asset, b: s.asset))
  let rs = filter(r.resistances, o => physical_asset_identity_eq(a: o.asset, b: s.asset))
  let vs = filter(r.voltages, o => physical_asset_identity_eq(a: o.asset, b: s.asset))
  let orders = concat(concat(map(cs, o => o.order), map(rs, o => o.order)), map(vs, o => o.order))
  StateReadings {
    state: s,
    continuity: filter(cs, o => order_in_state(boundaries: boundaries, s: s, o: o.order)),
    resistances: filter(rs, o => order_in_state(boundaries: boundaries, s: s, o: o.order)),
    voltages: filter(vs, o => order_in_state(boundaries: boundaries, s: s, o: o.order)),
    excluded_other_state: count(filter(orders, o => order_placed(boundaries: boundaries, o: o) && !order_in_state(boundaries: boundaries, s: s, o: o))),
    excluded_order_unrecorded: count(filter(orders, o => !order_placed(boundaries: boundaries, o: o))),
  }
}

// The upper bound a reading places on its node, in millivolts.
fn value_ceiling(v: VoltageValue) -> Nat {
  match v {
    ReadAbout { value } => millivolt_count(v: value)
    ReadBelow { bound } => millivolt_count(v: bound)
  }
}

fn is_read_value(v: VoltageValue) -> Bool {
  match v {
    ReadAbout { value: _ } => true
    ReadBelow { bound: _ } => false
  }
}

fn is_hedged(c: StatementCertainty) -> Bool {
  match c {
    StatedPlainly => false
    StatedHedged { verbatim: _ } => true
  }
}

fn millivolt_text(n: Nat) -> String {
  join([to_string(n / 1000), ".", if n % 1000 < 100 { if n % 1000 < 10 { "00" } else { "0" } } else { "" }, to_string(n % 1000), " V"], "")
}

fn value_text(v: VoltageValue) -> String {
  match v {
    ReadAbout { value } => join(["about ", millivolt_text(n: millivolt_count(v: value))], "")
    ReadBelow { bound } => join(["below ", millivolt_text(n: millivolt_count(v: bound)), " (a stated bound, not a value)"], "")
  }
}

fn certainty_text(c: StatementCertainty) -> String {
  match c {
    StatedPlainly => ""
    StatedHedged { verbatim } => join([", hedged ('", verbatim as String, "')"], "")
  }
}

fn keys_text(keys: List<NonEmptyStr>) -> String {
  join(map(keys, k => join(["incident ", k as String], "")), " and ")
}

fn order_text(o: ReadingOrder) -> String {
  match o {
    BeforeIncidents { keys } => match keys.first() {
      Absent => ""
      Present { value: _ } => join([", read before ", keys_text(keys: keys)], "")
    }
    AfterIncidents { keys } => join([", read after ", keys_text(keys: keys)], "")
    OrderUnrecorded { relative_to } => join([", order against ", keys_text(keys: relative_to), " unrecorded"], "")
  }
}

fn node_voltage_text(o: NodeVoltageObservation) -> String {
  join([
    terminal_text(t: o.at), " read ", value_text(v: o.value), " against ", terminal_text(t: o.reference), " with the source at ", to_string(volt_count(v: o.source)), " V", certainty_text(c: o.certainty),
    if probe_record_inferred(r: o.record) { ", on probe points inferred from the operator's words" } else { "" },
    order_text(o: o.order),
  ], "")
}

fn stability_text(s: ReadingStability) -> String {
  match s {
    HeldSteady => ", steady"
    KeptMoving => ", still moving"
    StabilityUnrecorded => ", stability unrecorded"
  }
}

fn resistance_display_text(d: ResistanceDisplay) -> String {
  match d {
    DisplayValue { ohms, approximate } => join([if approximate { "about " } else { "" }, to_string(ohms), " ohm"], "")
    DisplayAtProbeBaseline { shown, baseline } => join(["'", shown as String, "', at the shorted-probe baseline ('", baseline.shown as String, "' with the probes shorted on the ", to_string(baseline.full_scale_ohms), " ohm range)"], "")
    DisplayZeroWithoutBaseline { reported } => join(["reported as '", reported as String, "' with no shorted-probe baseline recorded"], "")
    DisplayAboveBaseline => "above the shorted-probe baseline (value unrecorded)"
    DisplayOverRange => "over range"
  }
}

fn range_text(r: MeterRange) -> String {
  match r {
    RangeFullScale { ohms } => join([" on the ", to_string(ohms), " ohm range"], "")
    AutoRanging => ", meter auto-ranging"
    RangeUnrecorded => ", range unrecorded"
  }
}

fn polarity_text(o: ResistanceObservation) -> String {
  match o.polarity {
    RedOnFirst => join([", red probe on ", terminal_text(t: o.first)], "")
    RedOnSecond => join([", red probe on ", terminal_text(t: o.second)], "")
    PolarityUnrecorded => ""
  }
}

fn resistance_text(o: ResistanceObservation) -> String {
  join([
    terminal_text(t: o.first), " to ", terminal_text(t: o.second), " read ", resistance_display_text(d: o.display), range_text(r: o.range), polarity_text(o: o), stability_text(s: o.stability),
    certainty_text(c: o.certainty), order_text(o: o.order),
  ], "")
}

// ONE PAIR READ ON MORE THAN ONE RANGE. Each range drives its own test current, so a plain conductor
// shows the same value on every range within the display's counts, and a path holding a junction does
// not: its apparent resistance moves with the current. The agreement factor is the display's: a
// 1999-count reading above ten counts cannot double from rounding alone, so a pair whose valued
// readings on recorded ranges differ by more than a factor of two reads as moving with the range. A
// pair valued on one recorded range only, or never valued on a recorded range, is not read either way.
data range_agreement_factor: Nat = 2

type PairRangeStanding
  = ReadingMovesWithRange { readings: List<ResistanceObservation>, lowest_ohms: Nat, highest_ohms: Nat }
  | ReadingHoldsAcrossRanges { readings: List<ResistanceObservation>, lowest_ohms: Nat, highest_ohms: Nat }
  | PairValuedOnOneRange { readings: List<ResistanceObservation> }
  | PairRangeUnread

fn observation_reads_pair(o: ResistanceObservation, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> Bool {
  (terminal_ref_equal(a: o.first, b: a) && terminal_ref_equal(a: o.second, b: b)) || (terminal_ref_equal(a: o.first, b: b) && terminal_ref_equal(a: o.second, b: a))
}

fn valued_ohms(o: ResistanceObservation) -> Nat? {
  match o.display {
    DisplayValue { ohms, approximate: _ } => match o.range {
      RangeFullScale { ohms: _ } => Present { value: ohms }
      AutoRanging => Present { value: ohms }
      RangeUnrecorded => Absent
    }
    DisplayAtProbeBaseline { shown: _, baseline: _ } => Absent
    DisplayZeroWithoutBaseline { reported: _ } => Absent
    DisplayAboveBaseline => Absent
    DisplayOverRange => Absent
  }
}

// An auto-ranging reading sits on a range the meter chose and did not record, so it carries a value but
// contributes no range to the range-dependence judgment.
fn recorded_full_scale(o: ResistanceObservation) -> Nat? {
  match o.range {
    RangeFullScale { ohms } => Present { value: ohms }
    AutoRanging => Absent
    RangeUnrecorded => Absent
  }
}

fn distinct_full_scales(os: List<ResistanceObservation>) -> List<Nat> {
  let scales = flat_map(os, o => match recorded_full_scale(o: o) { Present { value: n } => [n], Absent => [] })
  match scales.first() {
    Absent => []
    Present { value: f } => fold(scales, init: [f], f: (acc, n) => if any(acc, m => m == n) { acc } else { concat(acc, [n]) })
  }
}

// The judgment is over readings whose range is recorded: an auto-ranging value is a value for the
// netlist, but it carries no range, so it neither counts as a range nor enters the extrema here; a
// pair valued only while auto-ranging has no reading on a recorded range.
fn pair_range_standing(os: List<ResistanceObservation>, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> PairRangeStanding {
  let ranged = filter(os, o => observation_reads_pair(o: o, a: a, b: b)
    && match valued_ohms(o: o) { Present { value: _ } => true, Absent => false }
    && match recorded_full_scale(o: o) { Present { value: _ } => true, Absent => false })
  let ohms = flat_map(ranged, o => match valued_ohms(o: o) { Present { value: n } => [n], Absent => [] })
  match ohms.first() {
    Absent => PairRangeUnread
    Present { value: f } => {
      let lo = fold(ohms, init: f, f: (acc, n) => nat_min(a: acc, b: n))
      let hi = fold(ohms, init: f, f: (acc, n) => nat_max(a: acc, b: n))
      if count(distinct_full_scales(os: ranged)) < 2 { PairValuedOnOneRange { readings: ranged } }
      else if hi > lo * range_agreement_factor { ReadingMovesWithRange { readings: ranged, lowest_ohms: lo, highest_ohms: hi } }
      else { ReadingHoldsAcrossRanges { readings: ranged, lowest_ohms: lo, highest_ohms: hi } }
    }
  }
}

fn pair_range_text(s: PairRangeStanding) -> String {
  match s {
    ReadingMovesWithRange { readings, lowest_ohms, highest_ohms } => join(["reads MOVING WITH THE RANGE, ", to_string(lowest_ohms), " to ", to_string(highest_ohms), " ohm across ", to_string(count(distinct_full_scales(os: readings))), " recorded ranges in ", to_string(count(readings)), " readings: a path holding a junction, not a conductor, and no join"], "")
    ReadingHoldsAcrossRanges { readings, lowest_ohms, highest_ohms } => join(["reads the same across ", to_string(count(distinct_full_scales(os: readings))), " recorded ranges, ", to_string(lowest_ohms), " to ", to_string(highest_ohms), " ohm in ", to_string(count(readings)), " readings"], "")
    PairValuedOnOneRange { readings } => join(["is valued on one recorded range only (", to_string(count(readings)), " readings), so whether it moves with the range is unread"], "")
    PairRangeUnread => "has no valued reading on a recorded range"
  }
}

// ONE PAIR READ WITH THE PROBES EACH WAY. The meter's resistance source has a polarity, so a path holding
// a junction reads differently with the probes swapped and a resistor does not. The tolerance is
// declared, not measured: the two values agree when they differ by at most a tenth of the larger,
// pending a modeled accuracy figure for the meter. Which probe touched which point is read from each
// observation's own polarity against the pair's order, so the standing does not depend on how the
// pair was written down.
data polarity_agreement_tenths: Nat = 1

type PairPolarityStanding
  = ReadsAlikeBothWays { red_on_first_ohms: Nat, red_on_second_ohms: Nat }
  | ReadsDirectionally { red_on_first_ohms: Nat, red_on_second_ohms: Nat }
  | ReadOneWayOnly { readings: List<ResistanceObservation> }
  | PairPolarityUnread

fn red_was_on(o: ResistanceObservation, a: ElectricalTerminalRef) -> Bool {
  match o.polarity {
    RedOnFirst => terminal_ref_equal(a: o.first, b: a)
    RedOnSecond => terminal_ref_equal(a: o.second, b: a)
    PolarityUnrecorded => false
  }
}

fn valued_with_red_on(os: List<ResistanceObservation>, a: ElectricalTerminalRef, b: ElectricalTerminalRef, red: ElectricalTerminalRef) -> List<Nat> {
  flat_map(filter(os, o => observation_reads_pair(o: o, a: a, b: b) && red_was_on(o: o, a: red)), o => match valued_ohms(o: o) { Present { value: n } => [n], Absent => [] })
}

fn pair_polarity_standing(os: List<ResistanceObservation>, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> PairPolarityStanding {
  let on_a = valued_with_red_on(os: os, a: a, b: b, red: a)
  let on_b = valued_with_red_on(os: os, a: a, b: b, red: b)
  match on_a.first() {
    Absent => match on_b.first() {
      Absent => PairPolarityUnread
      Present { value: _ } => ReadOneWayOnly { readings: filter(os, o => observation_reads_pair(o: o, a: a, b: b)) }
    }
    Present { value: x } => match on_b.first() {
      Absent => ReadOneWayOnly { readings: filter(os, o => observation_reads_pair(o: o, a: a, b: b)) }
      Present { value: y } => {
        let larger = nat_max(a: x, b: y)
        let diff = larger - nat_min(a: x, b: y)
        if diff * 10 <= larger * polarity_agreement_tenths { ReadsAlikeBothWays { red_on_first_ohms: x, red_on_second_ohms: y } } else { ReadsDirectionally { red_on_first_ohms: x, red_on_second_ohms: y } }
      }
    }
  }
}

fn pair_polarity_text(s: PairPolarityStanding, a: ElectricalTerminalRef, b: ElectricalTerminalRef) -> String {
  match s {
    ReadsAlikeBothWays { red_on_first_ohms, red_on_second_ohms } => join(["reads alike both ways (", to_string(red_on_first_ohms), " ohm with red on ", terminal_text(t: a), ", ", to_string(red_on_second_ohms), " ohm with red on ", terminal_text(t: b), ")"], "")
    ReadsDirectionally { red_on_first_ohms, red_on_second_ohms } => join(["reads DIRECTIONALLY (", to_string(red_on_first_ohms), " ohm with red on ", terminal_text(t: a), ", ", to_string(red_on_second_ohms), " ohm with red on ", terminal_text(t: b), "): a path holding a junction, not a resistor"], "")
    ReadOneWayOnly { readings } => join(["is read with the probes one way only (", to_string(count(readings)), " readings), so whether it holds a junction is unread"], "")
    PairPolarityUnread => "has no valued reading with a recorded probe polarity"
  }
}

fn inspection_text(d: DamageInspection) -> String {
  match d {
    NoDamageSeen { looked_at } => join(["no damage seen (", looked_at as String, ")"], "")
    DamageSeen { description } => join(["damage seen: ", description as String], "")
    NotInspected => "not inspected"
  }
}

fn incident_text(i: BenchIncident) -> String {
  join([
    "incident ", i.key as String, ": ", join(map(i.bridged, t => terminal_text(t: t)), " bridged to "), " (", i.observed as String, "; ", inspection_text(d: i.inspection), ")",
  ], "")
}
