module product.spatial_dimension


// The first product-layer binding of SPATIAL-1, and the reason it is not an unconsumed generic
// guard. It supplies the four things std cannot: the room IDENTITY (from placement_supply, the
// SPATIAL-0 authority — a second room identity would be the fork this lane already found once),
// the EVIDENCE type (a real claim-evidence relation, not a prose string), the OBLIGATION type (a
// survey obligation is a workflow fact and is homed here rather than in std), and the METHOD type
// (std.claim_evidence.InferenceRuleId — a method that derives an estimate from evidence is exactly
// an inference rule, so it is reused rather than nicknamed as a SpatialMethodId).

type SurveyObligationId = std.types.NonEmptyStr where brand("SurveyObligationId")

// Length uncertainty is an ordered closed interval bounding the true value. It is the ONE-
// DIMENSIONAL case, deliberately named for a length rather than for space in general: a point
// needs a radius or bounding box and a pose needs separate translation and rotation error, and
// those are separate carriers rather than a widened low/high.
type LengthInterval = std.interval.OrderedClosedInterval<std.measure.Millimeter>

fn millimeter_le(a: std.measure.Millimeter, b: std.measure.Millimeter) -> Bool {
  std.measure.millimeter_count(m: a) <= std.measure.millimeter_count(m: b)
}

fn length_interval(low: std.measure.Millimeter, high: std.measure.Millimeter) -> std.interval.IntervalConstruction<std.measure.Millimeter> {
  std.interval.closed_interval(low: low, high: high, le: millimeter_le)
}

// Width comparison without subtraction: for ordered intervals,
//   (high_a - low_a) <= (high_b - low_b)  <=>  (high_a + low_b) <= (high_b + low_a)
// The additive form is used because the magnitude carrier counts in Nat, where a subtraction would
// need a partiality story of its own; this needs none.
fn length_uncertainty_admissible(actual: LengthInterval, budget: LengthInterval) -> Bool {
  let a_hi = std.measure.millimeter_count(m: std.interval.interval_high(interval: actual))
  let a_lo = std.measure.millimeter_count(m: std.interval.interval_low(interval: actual))
  let b_hi = std.measure.millimeter_count(m: std.interval.interval_high(interval: budget))
  let b_lo = std.measure.millimeter_count(m: std.interval.interval_low(interval: budget))
  (a_hi + b_lo) <= (b_hi + a_lo)
}

type RoomDimensionAxis
  = ClearWidth
  | ClearDepth
  | ClearHeight

// The evidence payload is an admitted claim-evidence link, so a dimension carries provenance, the
// inference rule that produced it, freshness, fidelity, and probe independence — the facts a bare
// string silently omitted while looking equally authoritative.
type RoomDimensionEvidence =
  std.claim_evidence.EvidenceLink<std.types.NonEmptyStr, std.types.NonEmptyStr, std.types.NonEmptyStr, std.types.NonEmptyStr, std.types.NonEmptyStr>

type RoomDimensionStanding =
  std.spatial_knowledge.SpatialKnowledge<std.measure.Millimeter, LengthInterval, RoomDimensionEvidence, std.claim_evidence.InferenceRuleId, SurveyObligationId>

type RoomDimensionAdmission =
  std.spatial_knowledge.SpatialAdmission<std.measure.Millimeter, LengthInterval, std.claim_evidence.InferenceRuleId, SurveyObligationId>

type RoomDimensionRendering =
  std.spatial_knowledge.SpatialRenderProjection<std.measure.Millimeter, LengthInterval, SurveyObligationId>

// A dimension fact is never loose: it names the room it belongs to and the axis it measures, so a
// refusal receipt can say WHICH dimension of WHICH room was insufficient.
type RoomDimensionKnowledge {
  room: product.placement_supply.RoomIdentity
  axis: RoomDimensionAxis
  standing: RoomDimensionStanding
}

fn admit_room_dimension(
  dimension: RoomDimensionKnowledge,
  requirement: std.spatial_knowledge.SpatialRequirement<LengthInterval>,
) -> RoomDimensionAdmission {
  std.spatial_knowledge.admit_spatial_decision_input(
    knowledge: dimension.standing,
    requirement: requirement,
    uncertainty_admissible: length_uncertainty_admissible,
  )
}

fn render_room_dimension(dimension: RoomDimensionKnowledge) -> RoomDimensionRendering {
  std.spatial_knowledge.project_spatial_rendering(knowledge: dimension.standing)
}

// The renderer's style is DERIVED from the standing rather than coordinated with it by hand. The
// deleted site packet had precisely these four visual distinctions and chose them manually beside
// a hand-authored world model, which is how a hypothesis came to be drawn like a measurement.
type RenderStyle
  = StrokeSolid
  | StrokeUncertaintyBand
  | StrokeHypothesisDashed
  | NotDrawnObligationOnly

fn render_style(rendering: RoomDimensionRendering) -> RenderStyle {
  match rendering {
    std.spatial_knowledge.RenderMeasured { value: _, uncertainty: _ } => StrokeSolid
    std.spatial_knowledge.RenderEstimated { region: _ } => StrokeUncertaintyBand
    std.spatial_knowledge.RenderHypothesis { value: _, purpose: _ } => StrokeHypothesisDashed
    std.spatial_knowledge.RenderUnknown { obligation: _ } => NotDrawnObligationOnly
  }
}

fn render_style_wire(style: RenderStyle) -> String {
  match style {
    StrokeSolid => "stroke-solid"
    StrokeUncertaintyBand => "stroke-band"
    StrokeHypothesisDashed => "stroke-dashed-hypothesis"
    NotDrawnObligationOnly => "not-drawn-obligation"
  }
}

// Unknown geometry produces NO shape — an obligation notice instead. This is the projection half
// of the rule that unknown must not default to a rectangle: there is no arm here that could emit
// one, so the absence is structural rather than a convention the renderer is trusted to follow.
fn render_wire(dimension: RoomDimensionKnowledge) -> String {
  let rendering = render_room_dimension(dimension: dimension)
  let style = render_style_wire(style: render_style(rendering: rendering))
  match rendering {
    std.spatial_knowledge.RenderMeasured { value: v, uncertainty: _ } =>
      "<line class={style} data-mm={millimeter_count(m: v)}/>"
    std.spatial_knowledge.RenderEstimated { region: r } =>
      "<band class={style} data-low={millimeter_count(m: interval_low(interval: r))} data-high={millimeter_count(m: interval_high(interval: r))}/>"
    std.spatial_knowledge.RenderHypothesis { value: v, purpose: _ } =>
      "<line class={style} data-mm={millimeter_count(m: v)}/>"
    std.spatial_knowledge.RenderUnknown { obligation: o } =>
      "<obligation class={style} data-survey={o as String}/>"
  }
}
