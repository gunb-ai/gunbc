module product.hardware_selection


type Milliwatt = Measure<Power, Milli, std.nat.Nat>

fn milliwatt(count: std.nat.Nat) -> Milliwatt {
  Milliwatt { count: count }
}

fn milliwatt_count(w: Milliwatt) -> std.nat.Nat {
  measure_count(m: w)
}

type HardwareAxes {
  throughput: Int
  capacity: ByteSize
  bandwidth: Bandwidth
  power: Watt
  cost: MoneyAmountMicro
}

type Platform {
  label: NonEmptyStr
  memory_channels: Int
  slots_per_channel: Int
  max_data_rate_mts: Int
}

fn dram_channel_bus_bytes() -> Int {
  bit_width_count(b: dram_data_word_width) / bits_per_byte()
}

fn effective_data_rate_mts(platform: Platform, dimms_per_channel: Int, rank_count: Int) -> Int {
  if dimms_per_channel <= 1 {
    platform.max_data_rate_mts
  } else {
    if rank_count >= 4 {
      min_int(a: platform.max_data_rate_mts, b: 2400)
    } else {
      if rank_count >= 2 {
        min_int(a: platform.max_data_rate_mts, b: 2933)
      } else {
        platform.max_data_rate_mts
      }
    }
  }
}

fn min_int(a: Int, b: Int) -> Int {
  if a < b { a } else { b }
}

type MemoryConfig {
  module: DramModuleCatalogRow
  jedec: JedecDdrGenerationCatalogRow
  dimms_per_channel: Int
  power_per_chip: Milliwatt
  price_per_stick: MoneyAmountMicro
}

fn memory_stick_count(platform: Platform, cfg: MemoryConfig) -> Int {
  platform.memory_channels * cfg.dimms_per_channel
}

fn memory_total_capacity(platform: Platform, cfg: MemoryConfig) -> ByteSize {
  byte_size(count: byte_size_count(b: cfg.module.capacity_bytes) * memory_stick_count(platform: platform, cfg: cfg))
}

fn rank_interleave_percent(rank_count: Int) -> Int {
  if rank_count >= 2 { 100 } else { 90 }
}

fn memory_bandwidth(platform: Platform, cfg: MemoryConfig) -> Bandwidth {
  let rated = min_int(a: cfg.module.data_rate_mts, b: effective_data_rate_mts(platform: platform, dimms_per_channel: cfg.dimms_per_channel, rank_count: cfg.module.rank_count))
  let interleaved = rated * rank_interleave_percent(rank_count: cfg.module.rank_count) / 100
  Bandwidth { count: interleaved * 1000000 * dram_channel_bus_bytes() * platform.memory_channels }
}

fn chips_per_rank(module: DramModuleCatalogRow) -> Int {
  dram_chips_per_rank(module: module)
}

fn devices_per_stick(module: DramModuleCatalogRow) -> Int {
  chips_per_rank(module: module) * module.rank_count
}

fn memory_power(platform: Platform, cfg: MemoryConfig) -> Watt {
  let total_mw = milliwatt_count(w: cfg.power_per_chip) * devices_per_stick(module: cfg.module) * memory_stick_count(platform: platform, cfg: cfg)
  watt(count: total_mw / 1000)
}

fn memory_cost(platform: Platform, cfg: MemoryConfig) -> MoneyAmountMicro {
  money_amount_micro(count: money_amount_micro_count(m: cfg.price_per_stick) * memory_stick_count(platform: platform, cfg: cfg))
}

type CpuCandidate {
  catalog: CpuModelCatalogRow
  typical_draw: Watt
  price: MoneyAmountMicro
  aggregate_throughput: Int
}

type Motherboard {
  label: NonEmptyStr
  socket: CpuSocket
  memory_channels: Int
  max_dimms_per_channel: Int
  idle_draw: Watt
  price: MoneyAmountMicro
}

type EfficiencyRating = Plus80 | Bronze | Silver | Gold | Platinum | Titanium

type PsuModel {
  label: NonEmptyStr
  max_output: Watt
  efficiency: EfficiencyRating
  price: MoneyAmountMicro
}

fn efficiency_percent(e: EfficiencyRating) -> Int {
  match e {
    Plus80 => 80
    Bronze => 85
    Silver => 88
    Gold => 90
    Platinum => 92
    Titanium => 94
  }
}

type SystemConfig {
  platform: Platform
  cpu: CpuCandidate
  memory: MemoryConfig
  board: Motherboard
  psu: PsuModel
}

fn dc_load_watts(cfg: SystemConfig) -> Int {
  let cpu_w = watt_count(w: cfg.cpu.typical_draw)
  let mem_w = watt_count(w: memory_power(platform: cfg.platform, cfg: cfg.memory))
  let board_w = watt_count(w: cfg.board.idle_draw)
  cpu_w + mem_w + board_w
}

fn wall_draw_watts(cfg: SystemConfig) -> Watt {
  watt(count: dc_load_watts(cfg: cfg) * 100 / efficiency_percent(e: cfg.psu.efficiency))
}

fn psu_is_adequate(cfg: SystemConfig) -> Bool {
  dc_load_watts(cfg: cfg) <= watt_count(w: cfg.psu.max_output)
}

fn config_total_cost(cfg: SystemConfig) -> MoneyAmountMicro {
  let mem_cost = money_amount_micro_count(m: memory_cost(platform: cfg.platform, cfg: cfg.memory))
  let total = money_amount_micro_count(m: cfg.cpu.price) + mem_cost + money_amount_micro_count(m: cfg.board.price) + money_amount_micro_count(m: cfg.psu.price)
  money_amount_micro(count: total)
}

fn config_axes(cfg: SystemConfig) -> HardwareAxes {
  HardwareAxes {
    throughput: cfg.cpu.aggregate_throughput,
    capacity: memory_total_capacity(platform: cfg.platform, cfg: cfg.memory),
    bandwidth: memory_bandwidth(platform: cfg.platform, cfg: cfg.memory),
    power: wall_draw_watts(cfg: cfg),
    cost: config_total_cost(cfg: cfg)
  }
}

fn config_is_realizable(cfg: SystemConfig) -> Bool {
  dram_module_is_realizable(module: cfg.memory.module, jedec: cfg.memory.jedec)
}

fn axes_comparisons(a: HardwareAxes, b: HardwareAxes) -> List<AxisComparison> {
  [
    axis_comparison_int(goal: HigherIsBetter, a: a.throughput, b: b.throughput),
    axis_comparison_int(goal: HigherIsBetter, a: byte_size_count(b: a.capacity), b: byte_size_count(b: b.capacity)),
    axis_comparison_int(goal: HigherIsBetter, a: bandwidth_count(b: a.bandwidth), b: bandwidth_count(b: b.bandwidth)),
    axis_comparison_int(goal: LowerIsBetter, a: watt_count(w: a.power), b: watt_count(w: b.power)),
    axis_comparison_int(goal: LowerIsBetter, a: money_amount_micro_count(m: a.cost), b: money_amount_micro_count(m: b.cost))
  ]
}

fn dominates(a: HardwareAxes, b: HardwareAxes) -> DominanceVerdict {
  dominance_of_comparisons(comparisons: axes_comparisons(a: a, b: b))
}

fn axes_on_front(candidate: HardwareAxes, pool: List<HardwareAxes>) -> Bool {
  on_pareto_front(verdicts: map(pool, p => dominates(a: p, b: candidate)))
}

fn as_int(n: Int) -> Int {
  n
}

fn gib(bytes: Int) -> Int {
  bytes / 1073741824
}

fn cost_micros_per_gib(a: HardwareAxes) -> Int {
  let cap_gib = gib(bytes: byte_size_count(b: a.capacity))
  let denom = if cap_gib <= 0 { 1 } else { cap_gib }
  as_int(n: money_amount_micro_count(m: a.cost)) / denom
}

fn bandwidth_per_watt(a: HardwareAxes) -> Int {
  let p = as_int(n: watt_count(w: a.power))
  let denom = if p <= 0 { 1 } else { p }
  bandwidth_count(b: a.bandwidth) / denom
}
