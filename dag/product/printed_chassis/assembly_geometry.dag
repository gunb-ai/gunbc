module product.printed_chassis.assembly_geometry

import std.types { Int, String, List, Bool }
import std.measure { Micrometer, micrometer }
import std.affine_space { Point3, point3 }
import std.coordinate_frame { coordinate_frame_identity }
import std.euclidean_geometry { Axis3, AxisDirection3, PositiveX, PositiveY, PositiveZ, NegativeZ, axis3_index, axis_direction_axis, axis_direction_is_negative }
import product.printed_chassis.coupon { PlateDimensions, plate_dimensions }

// Review geometry for the first assembled cassette. It is NOT AdmittedRealizationV0 and
// cannot enter the coupon's fabrication admission through a cast. The generic CAD adapter
// must validate positive primitives, solid connectivity, output extents and A1-mini fit.
// This explicit review rung replaces the former Three.js-only geometric authority.
// Coordinates use existing affine points; quantum is one micrometre, X across rear I/O,
// Y up, Z from rear toward the handle. Part-local frame 5100; assembly frame 5101.
// A PROFILE PRISM is a closed outline extruded along one axis: the shape boxes and cylinders cannot make --
// a curved air path, a 45-degree roof that prints without support. The outline's vertices are signed
// micrometre offsets from the centre in the two other axes, in X-Y-Z order (axis X: Y then Z; axis Y: X then
// Z; axis Z: X then Y), and the prism runs half its length either side of the centre along its axis. A curve
// is carried as the vertices of its polyline (quarter_arc), so every bound the checks read is a vertex.
type ProfileVertex { u: Int, v: Int }
type Primitive = Block { size: PlateDimensions, center: Point3 }
  | RoundPrism { diameter: Micrometer, length: Micrometer, axis: Axis3, center: Point3 }
  | ProfilePrism { outline: List<ProfileVertex>, axis: Axis3, length: Micrometer, center: Point3 }
type PartKind = Printed | Purchased | Metal | Clearance
// Orientation of the part's assembly-local coordinates when laid on a print bed.
type PrintPlane = LayOnXZ | LayOnXY | LayOnYZ
// THE PRINT POSE, derived once from the declared plane: the part-frame direction each build axis reads, so
// build_z names the part-frame direction that points away from the bed. The oriented STL the CAD check
// exports, the plate the packer builds and the conformance readback of the sliced archive all apply this one
// transform; none of them re-decides the tilt, and a plate plan may add only a turn about build Z
// (product.printing.process_geometry preserves_print_plane). Each row is a signed unit axis, so the pose is a
// signed axis permutation; print_pose_is_proper checks it is a rotation rather than a mirror.
type PrintPose { build_x: AxisDirection3, build_y: AxisDirection3, build_z: AxisDirection3 }
fn print_pose(plane: PrintPlane) -> PrintPose {
  match plane {
    LayOnXY => PrintPose { build_x: PositiveX, build_y: PositiveY, build_z: PositiveZ }
    LayOnXZ => PrintPose { build_x: PositiveX, build_y: NegativeZ, build_z: PositiveY }
    LayOnYZ => PrintPose { build_x: NegativeZ, build_y: PositiveY, build_z: PositiveX }
  }
}
fn axis_direction_component(d: AxisDirection3, k: Int) -> Int {
  if axis3_index(a: axis_direction_axis(d: d)) != k { 0 } else { if axis_direction_is_negative(d: d) { 0 - 1 } else { 1 } }
}
// The pose as matrix rows (build = rows x part), the form every realization consumes.
fn print_pose_rows(p: PrintPose) -> List<List<Int>> {
  map([p.build_x, p.build_y, p.build_z], d => map([0, 1, 2], k => axis_direction_component(d: d, k: k)))
}
// A rotation, not a mirror: build_z is build_x cross build_y.
fn print_pose_is_proper(p: PrintPose) -> Bool {
  let a = p.build_x
  let b = p.build_y
  all([0, 1, 2], k => {
    let i = (k + 1) % 3
    let j = (k + 2) % 3
    axis_direction_component(d: a, k: i) * axis_direction_component(d: b, k: j) - axis_direction_component(d: a, k: j) * axis_direction_component(d: b, k: i) == axis_direction_component(d: p.build_z, k: k)
  })
}
// Scope prevents rack power equipment being cloned into each moving cassette.
type PartScope = Cassette | FixedFrame

type AssemblyPart {
  id: String, name: String, kind: PartKind, scope: PartScope,
  adds: List<Primitive>, cuts: List<Primitive>, at: Point3, explode: Point3,
  print_plane: PrintPlane, notes: String,
}
type InterfaceStatus = Proposed | OriginalPlateFitOnly | Unresolved
type FastenerKind = M3PanelClamp | M4FanThroughBolt | M4SocketThroughBolt | PrintedRetainingPin | BoardSupportPending | GravitySeatOnLocatingNubs | ProtectedDcBranch | BondingHardwarePending | FanSelfTappingScrew | FrictionFitPlug | FrictionFitSleeve | LocatingSleeveNoRetention | M3IntoCardInsert | M5FanScrewIntoBlowerLug

type MechanicalInterface {
  id: String, members: List<String>, fastener: FastenerKind, quantity: Int,
  status: InterfaceStatus, requirement: String,
  // The purchased or metal members of this interface that INTENTIONALLY interpenetrate its printed members
  // (a screw tapping into a lug). Every other printed-vs-purchased/metal overlap refuses in the CAD check.
  intended_overlap: List<String>,
}
fn local(x: Int, y: Int, z: Int) -> Point3 { point3(frame: coordinate_frame_identity(occurrence: 5100), x: x, y: y, z: z) }
fn placed(x: Int, y: Int, z: Int) -> Point3 { point3(frame: coordinate_frame_identity(occurrence: 5101), x: x, y: y, z: z) }
fn block(w: Int, h: Int, d: Int, x: Int, y: Int, z: Int) -> Primitive {
  Block { size: plate_dimensions(size_x: micrometer(count: w), size_y: micrometer(count: h), size_z: micrometer(count: d)), center: local(x: x,y: y,z: z) }
}
fn round(diameter: Int, length: Int, axis: Axis3, x: Int, y: Int, z: Int) -> Primitive {
  RoundPrism { diameter: micrometer(count: diameter), length: micrometer(count: length), axis: axis, center: local(x: x,y: y,z: z) }
}
fn prism(outline: List<ProfileVertex>, axis: Axis3, length: Int, x: Int, y: Int, z: Int) -> Primitive {
  ProfilePrism { outline: outline, axis: axis, length: micrometer(count: length), center: local(x: x, y: y, z: z) }
}

// A quarter circle as 17 vertices, 5.625 degrees apart, CENTRE (cu, cv) and radius r, in quadrant q (0: from
// +u to +v, 1: from +v to -u, 2: from -u to -v, 3: from -v to +u), counter-clockwise. The table is the unit
// quarter circle (cos, sin of k * 5.625 deg) to five places. A radius of zero yields the corner point.
data unit_quarter_circle: List<ProfileVertex> = [ProfileVertex { u: 100000, v: 0 }, ProfileVertex { u: 99518, v: 9802 }, ProfileVertex { u: 98079, v: 19509 }, ProfileVertex { u: 95694, v: 29028 }, ProfileVertex { u: 92388, v: 38268 }, ProfileVertex { u: 88192, v: 47140 }, ProfileVertex { u: 83147, v: 55557 }, ProfileVertex { u: 77301, v: 63439 }, ProfileVertex { u: 70711, v: 70711 }, ProfileVertex { u: 63439, v: 77301 }, ProfileVertex { u: 55557, v: 83147 }, ProfileVertex { u: 47140, v: 88192 }, ProfileVertex { u: 38268, v: 92388 }, ProfileVertex { u: 29028, v: 95694 }, ProfileVertex { u: 19509, v: 98079 }, ProfileVertex { u: 9802, v: 99518 }, ProfileVertex { u: 0, v: 100000 }]

fn quarter_arc(cu: Int, cv: Int, r: Int, q: Int) -> List<ProfileVertex> {
  if r <= 0 { return [ProfileVertex { u: cu, v: cv }] }
  map(unit_quarter_circle, p => {
    let c = r * p.u / 100000
    let s = r * p.v / 100000
    if q == 0 { ProfileVertex { u: cu + c, v: cv + s } }
    else { if q == 1 { ProfileVertex { u: cu - s, v: cv + c } }
    else { if q == 2 { ProfileVertex { u: cu - c, v: cv - s } }
    else { ProfileVertex { u: cu + s, v: cv - c } } } }
  })
}

// A rectangle in (u, v) with each corner rounded to its own radius (zero keeps it square), counter-clockwise
// from the bottom-right corner.
fn rounded_rectangle(u_lo: Int, u_hi: Int, v_lo: Int, v_hi: Int, r_bottom_left: Int, r_bottom_right: Int, r_top_right: Int, r_top_left: Int) -> List<ProfileVertex> {
  concat(concat(concat(
    quarter_arc(cu: u_hi - r_bottom_right, cv: v_lo + r_bottom_right, r: r_bottom_right, q: 3),
    quarter_arc(cu: u_hi - r_top_right, cv: v_hi - r_top_right, r: r_top_right, q: 0)),
    quarter_arc(cu: u_lo + r_top_left, cv: v_hi - r_top_left, r: r_top_left, q: 1)),
    quarter_arc(cu: u_lo + r_bottom_left, cv: v_lo + r_bottom_left, r: r_bottom_left, q: 2))
}

// HOW A PART'S PRINT PLANE PUTS IT ON THE BED, in words, for the instructions generated beside it. The plane is
// the one fact (the CAD check rotates the exported STL by it, product.printed_chassis.review_realization);
// this only renders it, so a readme cannot state a pose the geometry was not exported in.
fn print_plane_pose(plane: PrintPlane) -> String {
  match plane {
    LayOnXY => "flat, its part-frame Z axis vertical"
    LayOnXZ => "on its side, its part-frame Y axis vertical"
    LayOnYZ => "standing on its end, its part-frame X axis vertical"
  }
}

fn part(id: String, name: String, kind: PartKind, scope: PartScope, adds: List<Primitive>, cuts: List<Primitive>, x: Int,y: Int,z: Int, ex: Int,ey: Int,ez: Int, plane: PrintPlane, notes: String) -> AssemblyPart {
  AssemblyPart { id: id,name: name,kind: kind,scope: scope,adds: adds,cuts: cuts,at: placed(x: x,y: y,z: z),explode: placed(x: ex,y: ey,z: ez),print_plane: plane,notes: notes }
}
// The interface, declaring which of its members are meant to overlap a printed member.
fn tapping_into(i: MechanicalInterface, members: List<String>) -> MechanicalInterface {
  MechanicalInterface { id: i.id,members: i.members,fastener: i.fastener,quantity: i.quantity,status: i.status,requirement: i.requirement,intended_overlap: members }
}
fn mechanical_interface(id: String,members: List<String>,fastener: FastenerKind,quantity: Int,status: InterfaceStatus,requirement: String) -> MechanicalInterface {
  MechanicalInterface { id: id,members: members,fastener: fastener,quantity: quantity,status: status,requirement: requirement,intended_overlap: [] }
}
