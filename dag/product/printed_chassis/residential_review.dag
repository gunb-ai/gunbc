module product.printed_chassis.residential_review
import product.printed_chassis.assembly_inventory { required_slots_json }
import std.measure {micrometer,micrometer_count,millimeter}
import product.printed_chassis.harness_census {selected_fan_harness_json}
import product.printed_chassis.cassette {printed_parts,tray_w,tray_d,board_w,board_d,rear_socket_bolt_clearances}
import product.printed_chassis.rack_assembly {hardware}
import product.printed_chassis.cooler_configuration {noctua_envelope,residential_cooler}
import product.printed_chassis.stack_geometry {stack_pitch_for_cooler}
import product.printed_chassis.rear_cooling {RearFanGeometry,RearCoolingInvalidInput,RearCoolingNoFit,rear_opening,select_rear_fans,rear_fan_candidates,rear_cooling_json}
import product.printed_chassis.cassette_review {part_json,interface_json}
import product.printed_chassis.stack_joinery {stack_joinery,StackJoineryGeometry,StackJoineryHeightUnsupported}
import product.printed_chassis.rear_fan_assembly {rear_assembly,RearAssemblyGeometry,RearAssemblyUnsupportedBank,RearAssemblyMountRefused}
import product.printed_chassis.cadquery_realization {realize_review_parts,ReviewCadQueryEmitted,ReviewCadQueryRefused,review_program_source}
import extdeps.languages.json.emit {serialize_json,json_object,json_kv,json_array,json_string,json_int}
import gunbc.cli_wire {CliWireResponse,CliWirePrintable}
import std.process {ExitSuccess,exit_failure}

import std.types {List,Int,String}
import product.printed_chassis.rear_cooling {RearCoolingReading}
import product.printed_chassis.assembly_geometry {AssemblyPart,MechanicalInterface}

type ResidentialAssembly = ResidentialAssemblyReady {parts:List<AssemblyPart>,joints:List<MechanicalInterface>,pitch:Int,cooling:RearCoolingReading} | ResidentialAssemblyRefused {reason:String}
fn residential_assembly() -> ResidentialAssembly {
 let pitch=stack_pitch_for_cooler(cooler:residential_cooler,contact_plane_um:micrometer(count: 30000))
 let selection=select_rear_fans(candidates:rear_fan_candidates,opening:rear_opening(width_um:tray_w,pitch_um:micrometer(count: pitch),left_um:micrometer(count: 20000),right_um:micrometer(count: 20000),bottom_um:micrometer(count: 20000),top_um:micrometer(count: 20000),depth_um:micrometer(count: 60000)),bed_um:micrometer(count: 170000))
 match selection {
  RearFanGeometry {bank:b}=>{
   if b.count!=1 || micrometer_count(m:b.fan.pattern.frame_edge)!=140000 {return ResidentialAssemblyRefused {reason:"Residential configuration requires single 140 mm fan"}}
   match rear_assembly(bank:b) {
    RearAssemblyGeometry {parts:rear,interfaces:joints}=>match stack_joinery(pitch_um:micrometer(count: pitch)) {
     StackJoineryGeometry {parts:posts}=>ResidentialAssemblyReady {
      parts:concat(filter(printed_parts(),p=>p.id=="P1"||p.id=="P2"||p.id=="P3"||p.id=="P4"),concat(filter(hardware(),p=>p.id=="BOARD"||p.id=="RAM1"||p.id=="RAM2"||p.id=="IO"),concat([noctua_envelope(contact_plane_um:micrometer(count: 30000))],concat(rear,concat(posts,rear_socket_bolt_clearances()))))),joints:joints,pitch:pitch,cooling:selection}
     StackJoineryHeightUnsupported=>ResidentialAssemblyRefused {reason:"Stack joinery height unsupported"}
    }
    RearAssemblyUnsupportedBank=>ResidentialAssemblyRefused {reason:"Rear assembly refused"} RearAssemblyMountRefused=>ResidentialAssemblyRefused {reason:"Rear assembly refused"}
   }
  }
  RearCoolingInvalidInput=>ResidentialAssemblyRefused {reason:"Rear fan selection refused"} RearCoolingNoFit=>ResidentialAssemblyRefused {reason:"Rear fan selection refused"}
 }
}
fn main() -> CliWireResponse {
 match residential_assembly() {
  ResidentialAssemblyRefused {reason:r}=>CliWirePrintable {bytes:r,exit:exit_failure(reason:r)}
  ResidentialAssemblyReady {parts:parts,joints:joints,pitch:pitch,cooling:cooling}=>match realize_review_parts(parts:parts) {
   ReviewCadQueryRefused {reason:_}=>CliWirePrintable {bytes:"Review CAD refused",exit:exit_failure(reason:"Review CAD refused")}
   ReviewCadQueryEmitted {program:p}=>CliWirePrintable {bytes:serialize_json(v:json_object(members:[json_kv(key:"program",value:json_string(s:review_program_source(p:p))),json_kv(key:"desired_inventory",value:required_slots_json(parts:parts)), json_kv(key:"parts",value:json_array(elements:map(parts,p=>part_json(p:p)))),json_kv(key:"interfaces",value:json_array(elements:map(joints,j=>interface_json(i:j)))),json_kv(key:"pitch_um",value:json_int(n:pitch)),json_kv(key:"tray_um",value:json_array(elements:[json_int(n:micrometer_count(m: tray_w)),json_int(n:micrometer_count(m: tray_d))])),json_kv(key:"board_um",value:json_array(elements:[json_int(n:micrometer_count(m: board_w)),json_int(n:micrometer_count(m: board_d))])),json_kv(key:"cooling",value:rear_cooling_json(reading:cooling)),json_kv(key:"fan_harness",value:selected_fan_harness_json(reading:cooling,service_allowance:millimeter(count:100)))])),exit:ExitSuccess}
  }
 }
}
