  OutletMount, EdgeAlongY, outlet_mount_unfit, run_for_label, housing_half, outlet_socket_adds, outlet_socket_cuts, lug_arm_adds, lug_arm_cuts,
  socket_edge_lo, socket_edge_hi, opening_edge_lo, opening_edge_hi, opening_half_thickness, outlet_mount_note, label_side_stack, lug_screw_part, housing_box,
}
