module product.printed_chassis.slice_run
import std.types { String, FilePath }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.printing.orca_slicer { with_verified_orca, orca_version_probe_command, orca_slice_to_project_command }
import extdeps.exec.command { LocalExec, ArgvCommand, env_prefixed_command_in }
import extdeps.shell.exec { ProcessRefused, ProcessOutputAbsent, ProcessOutputPresent }
import gunbc.command_runner { run_shell_command_capture }

// THE VERIFIED ORCA EXECUTION BOUNDARY, AND NOTHING ELSE. Process policy (supports, walls, infill,
// temperatures) is product.printed_chassis.print_preparation required_settings, read back from the
// sliced archive; this module carries no settings of its own, so there is no second process
// authority to drift from it.

// Orca also writes result/log files relative to cwd. Fleet preparation gives every
// plate its own directory so independent preparations do not share those files.
fn slice_command_in(directory:String,command:ArgvCommand) -> ArgvCommand {
 if directory=="" {command} else {env_prefixed_command_in(directory:directory,bindings:[],command:command)}
}
fn slice_profile_in(directory:String,appimage:String,model:String,output:String,machine:String,filament:String,process:String) -> ProcessExit {
  match with_verified_orca(appimage: appimage as FilePath, use: executable => {
    let probe = run_shell_command_capture(command: slice_command_in(directory:directory,command:orca_version_probe_command(executable: executable)), transport: LocalExec)
    match probe {
      ProcessRefused { exit_code: _, stderr: _ } => return probe
      ProcessOutputAbsent => {}
      ProcessOutputPresent {text:_} => {}
    }
    run_shell_command_capture(command: slice_command_in(directory:directory,command:orca_slice_to_project_command(
        executable: executable, input_model: model, output_project: output,
        printer_profile: machine, filament_profile: filament, process_profile: process,
      )), transport: LocalExec)
  }) {
    ProcessRefused { exit_code: _, stderr: e } => exit_failure(reason: e)
    ProcessOutputAbsent=>ExitSuccess ProcessOutputPresent {text:_}=>ExitSuccess
  }
}
