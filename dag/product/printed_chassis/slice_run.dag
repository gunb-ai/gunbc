module product.printed_chassis.slice_run
import std.types { String, FilePath }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.printing.orca_slicer { with_verified_orca, OrcaRunCapture, OrcaCleanupStanding, OrcaCleanupClean, OrcaCleanupOutstanding, orca_version_probe_command, orca_slice_to_project_command }
import gunbc.command_runner { ProcessCaptureOutcome }
import extdeps.exec.command { LocalExec, ArgvCommand, env_prefixed_command_in }
import extdeps.shell.exec { ProcessRefused, ProcessOutputAbsent, ProcessOutputPresent, ProcessCaptureNotSpawned, ProcessCaptured}
import gunbc.command_runner { run_shell_command_capture}

// THE VERIFIED ORCA EXECUTION BOUNDARY, AND NOTHING ELSE. Process policy (supports, walls, infill,
// temperatures) is product.printed_chassis.print_preparation required_settings, read back from the
// sliced archive; this module carries no settings of its own, so there is no second process
// authority to drift from it.

// Orca also writes result/log files relative to cwd. Fleet preparation gives every
// plate its own directory so independent preparations do not share those files.
fn slice_command_in(directory:String,command:ArgvCommand) -> ArgvCommand {
 if directory=="" {command} else {env_prefixed_command_in(directory:directory,bindings:[],command:command)}
}
fn slice_profile_in(directory:String,appimage:String,model:String,output:String,machine:String,filament:String,process:String) -> ProcessExit {
  match with_verified_orca(appimage: appimage as FilePath, use: executable => {
    let probe = run_shell_command_capture(command: slice_command_in(directory:directory,command:orca_version_probe_command(executable: executable)), transport: LocalExec)
    match probe {
      // The version probe never ran, so the slice is not attempted: the closure returns that capture
      // unchanged, program and cause included -- the reason the slice never happened.
      ProcessCaptureNotSpawned { program: _, cause: _ } => return probe
      ProcessCaptured { outcome: probed } => match probed {
      // The probe child ran and refused: return the ORIGINAL capture (wrapper included),
      // never the inner ProcessOutcome, which is the wrong grain for this callback.
      ProcessRefused { exit_code: _, stderr: _ } => return probe
      ProcessOutputAbsent => {}
      ProcessOutputPresent {text:_} => {}
      }
    }
    run_shell_command_capture(command: slice_command_in(directory:directory,command:orca_slice_to_project_command(
        executable: executable, input_model: model, output_project: output,
        printer_profile: machine, filament_profile: filament, process_profile: process,
      )), transport: LocalExec)
  }) {
    OrcaRunCapture { outcome: capture, cleanup: standing } => slice_exit_for(capture: capture, standing: standing)
  }
}

// THE SLICE'S FINAL EXIT over the realization: the child's own verdict decides, and a leaked private
// realization fails the run ON TOP of it -- never ExitSuccess over a leak (fail_closed: the leak is a
// fact the caller must act on, carried separately from the capture, exactly as the printer report CLI
// fails on an outstanding credential-bound file).
fn slice_exit_for(capture: ProcessCaptureOutcome, standing: OrcaCleanupStanding) -> ProcessExit {
  match standing {
    OrcaCleanupOutstanding { detail: d } => match capture {
      ProcessCaptureNotSpawned { program: p, cause: why } =>
        exit_failure(reason: join(["Orca was never spawned for the slice: ", p as String, " -- ", why as String, " (AND the Orca realization leaked: ", d, ")"], ""))
      ProcessCaptured { outcome: slice } => match slice {
        ProcessRefused { exit_code: _, stderr: e } =>
          exit_failure(reason: join([e, " (AND the Orca realization leaked: ", d, ")"], ""))
        ProcessOutputAbsent => exit_failure(reason: join(["Orca slice cleanup outstanding: ", d], ""))
        ProcessOutputPresent { text: _ } => exit_failure(reason: join(["Orca slice cleanup outstanding: ", d], ""))
      }
    }
    OrcaCleanupClean => match capture {
      ProcessCaptureNotSpawned { program: p, cause: why } => exit_failure(reason: join(["Orca was never spawned for the slice: ", p as String, " -- ", why as String], ""))
      ProcessCaptured { outcome: slice } => match slice {
        ProcessRefused { exit_code: _, stderr: e } => exit_failure(reason: e)
        ProcessOutputAbsent => ExitSuccess
        ProcessOutputPresent { text: _ } => ExitSuccess
      }
    }
  }
}
