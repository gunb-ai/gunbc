module product.printed_chassis.printable_assembly_selection

import std.types { String, List }
import product.printed_chassis.printable_assembly {
  PrintedAssemblyRoot, ResidentialCassette, CassetteRackReview, A16PlugDuct, A16SleeveDuct, A16PlugFitRing, A16SleeveFitRing,
  PrintableAssembly, PrintableAssemblySelection, PrintableAssemblyReady, PrintableAssemblyRefused, printed_assembly_root_wire,
}
import product.printed_chassis.assembly_geometry { Clearance, Printed, Purchased, Metal }
import product.printed_chassis.residential_review { residential_assembly, ResidentialAssemblyReady, ResidentialAssemblyRefused }
import product.printed_chassis.cassette { rear_socket_bolt_clearances }
import product.printed_chassis.cassette_review { cassette_printable, rack_review_assembly }
import product.printed_chassis.gpu_duct {
  GpuDuctAdmitted, GpuDuctInsertReadingsDisagree, GpuDuctFinsAtTheWindowFace, GpuDuctFanMountRefused,
  GpuDuctWindowDeeperThanFan, GpuDuctPlugPassageClosed, DuctCardMount, DuctExtent, PlugAndFlange, SleeveOverCardEnd,
  FullDuct, CardFitRing, a16_end_face, a16_duct_design, admit_gpu_duct, duct_presentation_members, duct_readme,
}

// THE ONE PLACE A ROOT BECOMES PARTS. Every consumer on the print path -- the CAD check, preparation
// identity and the inventory verbs -- asks here instead of calling an assembly's producer itself, so
// adding a printable assembly is an arm and a row rather than a new set of call sites.
//
// Each arm declares its own required keep-outs and combined-assembly membership. The residential
// cassette keeps the rear-socket hardware envelopes it has always required; the A16 duct requires
// its 8-pin power keep-out, so the CAD kernel checks that clearance on solids as well as the
// source-model construction in gpu_duct.
fn select_printable_assembly(root: PrintedAssemblyRoot) -> PrintableAssemblySelection {
  match root {
    ResidentialCassette => match residential_assembly() {
      ResidentialAssemblyReady { parts: parts, joints: joints, pitch: _, cooling: _ } =>
        PrintableAssemblyReady { assembly: cassette_printable(root: root, parts: parts, joints: joints, keepouts: map(rear_socket_bolt_clearances(), p => p.id)) }
      ResidentialAssemblyRefused { reason: r } => PrintableAssemblyRefused { reason: r }
    }
    CassetteRackReview => PrintableAssemblyReady { assembly: rack_review_assembly() }
    A16PlugDuct => a16_selection(root: root, mount: PlugAndFlange, extent: FullDuct)
    A16SleeveDuct => a16_selection(root: root, mount: SleeveOverCardEnd, extent: FullDuct)
    A16PlugFitRing => a16_selection(root: root, mount: PlugAndFlange, extent: CardFitRing)
    A16SleeveFitRing => a16_selection(root: root, mount: SleeveOverCardEnd, extent: CardFitRing)
  }
}

// Each A16 root is one (mount, extent) admission of the same duct model; the package takes the root's
// wire spelling so the four packages cannot overwrite one another.
fn a16_selection(root: PrintedAssemblyRoot, mount: DuctCardMount, extent: DuctExtent) -> PrintableAssemblySelection {
  match admit_gpu_duct(f: a16_end_face, d: a16_duct_design, mount: mount, extent: extent) {
    GpuDuctAdmitted { parts: parts, interfaces: joints } => PrintableAssemblyReady {
      assembly: PrintableAssembly {
        root: root,
        parts: parts,
        interfaces: joints,
        required_keepouts: ["POWER-KEEPOUT"],
        assembly_members: map(filter(parts, p => match p.kind { Clearance => false Printed => true Purchased => true Metal => true }), p => p.id),
        package: printed_assembly_root_wire(root: root),
        schema: "gunbc.a16-inlet-duct-review.v2",
        readme: duct_readme(mount: mount, extent: extent),
        presentation: duct_presentation_members(),
      }
    }
    GpuDuctInsertReadingsDisagree { implied_face_length: _, face_length: _ } => PrintableAssemblyRefused { reason: "A16 end-cap insert readings do not close on the face length" }
    GpuDuctFinsAtTheWindowFace { fin_setback: _, fin_margin: _ } => PrintableAssemblyRefused { reason: "A16 fins too close to the window face for a plug lip" }
    GpuDuctFanMountRefused { mount: _ } => PrintableAssemblyRefused { reason: "A16 duct fan mount refused" }
    GpuDuctWindowDeeperThanFan { window_depth: _, fan_edge: _ } => PrintableAssemblyRefused { reason: "A16 fin window deeper than the fan frame" }
    GpuDuctPlugPassageClosed { plug_depth: _, wall: _ } => PrintableAssemblyRefused { reason: "A16 duct plug passage closed" }
  }
}
