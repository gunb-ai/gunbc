module product.printed_chassis.cad_check_run
import extdeps.shell.exec {ProcessOutputAbsent,ProcessOutputPresent}

import std.types {String}
import std.process {ProcessExit,ExitSuccess,exit_failure}
import product.printed_chassis.review_realization {program_for}
import product.printed_chassis.printable_assembly {PrintedAssemblyRoot,PrintableAssemblyReady,PrintableAssemblyRefused,printable_manifest}
import product.printed_chassis.printable_assembly_selection {select_printable_assembly,printed_assembly_root_from_wire}
import gunbc.cli_wire {CliWirePrintable,CliWireUnprintable}
import extdeps.filesystem.filesystem_io {Filesystem}
import extdeps.languages.json.emit {serialize_json,json_array,json_string}
import product.printing.print_runtime {CadRuntimeReady,cad_program_command,observe_cad_runtime,CadRuntimeObserved,CadRuntimeRefused}
import extdeps.exec.command {LocalExec}
import gunbc.command_runner {run_shell_command_capture}
import extdeps.shell.exec {ProcessRefused}

// The workflow executes the existing realization/check adapter, rather than only
// emitting it and relying on a caller's Python script. Source checks, kernel solids,
// mesh/STEP round trips, assembly intersections, the selected root's required
// keep-outs and per-part bed fit are mandatory. Output is still an unqualified review
// artifact, never thermal/load qualification. The selected root is written into the
// checked manifest, so preparation reads it back from cad/assembly.json.
fn check_printable_cad(cad:CadRuntimeReady,root:PrintedAssemblyRoot,output:String) -> ProcessExit {
 if output=="" {return exit_failure(reason:"CAD check output path is required")}
 match select_printable_assembly(root:root) {
  PrintableAssemblyRefused {reason:r}=>exit_failure(reason:r)
  PrintableAssemblyReady {assembly:a}=>match program_for(a:a) {
   CliWireUnprintable {cause:_}=>exit_failure(reason:"Cannot render CAD check program")
   CliWirePrintable {bytes:program,exit:ExitSuccess}=>{
    let manifest_path=concat(output,".manifest.json")
    let script_path=concat(output,".cad-check.py")
    let argv=serialize_json(v:json_array(elements:map([script_path,manifest_path,output],s=>json_string(s:s))))
    let source=join(["import sys\nsys.argv = ",argv,"\n",program],"")
    if !Filesystem.Write(path:manifest_path,content:serialize_json(v:printable_manifest(a:a))).success || !Filesystem.Write(path:script_path,content:source).success {return exit_failure(reason:"Cannot stage generated CAD checks")}
    match run_shell_command_capture(command:cad_program_command(c:cad,script_path:script_path),transport:LocalExec) {
     ProcessRefused {exit_code:_,stderr:e}=>exit_failure(reason:e)
     ProcessOutputAbsent=>ExitSuccess ProcessOutputPresent {text:_}=>ExitSuccess
    }
   }
   CliWirePrintable {bytes:_,exit:e}=>e
  }
 }
}

fn run(root:String,output:String) -> ProcessExit {
 match printed_assembly_root_from_wire(s:root) {
  Present {value:r}=>match observe_cad_runtime() {
   CadRuntimeObserved {runtime:c}=>check_printable_cad(cad:c,root:r,output:output)
   CadRuntimeRefused {reason:why}=>exit_failure(reason:why)
  }
  Absent=>exit_failure(reason:"Unknown printed assembly root")
 }
}
