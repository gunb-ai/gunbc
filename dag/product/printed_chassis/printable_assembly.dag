module product.printed_chassis.printable_assembly

import std.types { Int, String, List }
import std.measure { micrometer_count, millimeter_count }
import std.affine_space { Point3, signed_frame_component_count }
import std.euclidean_geometry { Axis3X, Axis3Y, Axis3Z }
import product.printed_chassis.assembly_geometry {
  Primitive, Block, RoundPrism, AssemblyPart, MechanicalInterface, Printed, Purchased, Metal, Clearance, Cassette, FixedFrame,
  LayOnXZ, LayOnXY, LayOnYZ, InterfaceStatus, Proposed, OriginalPlateFitOnly, Unresolved, FastenerKind, M3PanelClamp,
  PrintedRetainingPin, M4FanThroughBolt, M4SocketThroughBolt, BoardSupportPending, ProtectedDcBranch, BondingHardwarePending,
  FanSelfTappingScrew, FrictionFitPlug, FrictionFitSleeve, LocatingSleeveNoRetention, M3IntoCardInsert,
}
import product.printed_chassis.assembly_inventory { required_slots_json }
import product.printed_chassis.export_profile { exercised_stl_knobs }
import extdeps.printing.bambu_lab_a1_mini { a1_mini_build_envelope }
import extdeps.printing.fdm { build_envelope_x, build_envelope_y, build_envelope_z }
import extdeps.languages.json.emit { JsonValue, JsonKeyValue, json_object, json_kv, json_string, json_int, json_array }

// WHAT IS BEING PRINTED IS SELECTED, NOT HARD-WIRED. The print path (CAD check, plate preparation,
// prepared-output identity) was written against one assembly and reached it by calling that
// assembly's producer at every site. Each selectable assembly is one arm here; the selection that
// maps an arm to its parts lives in printable_assembly_selection, so this module stays importable
// by the roots themselves.
//
// CassetteRackReview is the full r06 rack the review site displays (product.printed_chassis.
// cassette_review all_parts). It was already a distinct selection -- a different part set from the
// residential print assembly -- reached implicitly through review_realization main. Naming it keeps
// the two from being confused for one another.
// The four A16 axial roots are the two card mounts, each as a full duct and as a fit ring; the blower
// root is the radial-blower duct on the plug mount; the flat-on-end root is the third blower home, admitted
// 2026-10-26 on the operator's declared conservative bounds (product.printed_chassis.card_cooling_route
// PlaneOnEnd, gunbc.design_ruling a16_rear_clearance_and_sides_are_operator_declared_bounds). It gets its
// OWN root rather than a mode of A16BlowerDuct, because its geometry differs in kind: that one is a socket
// the blower drops into beside the plug end, this one carries the housing on an open shoulder behind the end
// with a channel turned back into the window. Two shapes, two attempts, two names to point at at the printer.
type PrintedAssemblyRoot = ResidentialCassette | CassetteRackReview | A16PlugDuct | A16SleeveDuct | A16PlugFitRing | A16SleeveFitRing | A16BlowerDuct | A16BlowerFlatOnEndDuct

data printed_assembly_roots: List<PrintedAssemblyRoot> = [ResidentialCassette, CassetteRackReview, A16PlugDuct, A16SleeveDuct, A16PlugFitRing, A16SleeveFitRing, A16BlowerDuct, A16BlowerFlatOnEndDuct]

fn printed_assembly_root_wire(root: PrintedAssemblyRoot) -> String {
  match root {
    ResidentialCassette => "residential-cassette"
    CassetteRackReview => "cassette-rack-review"
    A16PlugDuct => "a16-plug-duct"
    A16SleeveDuct => "a16-sleeve-duct"
    A16PlugFitRing => "a16-plug-fit-ring"
    A16SleeveFitRing => "a16-sleeve-fit-ring"
    A16BlowerDuct => "a16-blower-duct"
    A16BlowerFlatOnEndDuct => "a16-blower-flat-on-end-duct"
  }
}

fn printed_assembly_root_from_wire(s: String) -> PrintedAssemblyRoot? {
  fold(printed_assembly_roots, init: none, f: (acc, r) =>
    match acc {
      Present { value: found } => Present { value: found }
      Absent => if printed_assembly_root_wire(root: r) == s { Present { value: r } } else { none }
    })
}

// THE PRINTING PROJECTION OF A SELECTED ASSEMBLY: only what the CAD check and preparation consume.
// required_keepouts and assembly_members are each root's own declaration; the check adapter no
// longer infers membership from PartScope or receives keep-outs out of band. Presentation members
// are the root's review-only fields, passed through to the package unchanged.
type PrintableAssembly {
  root: PrintedAssemblyRoot
  parts: List<AssemblyPart>
  interfaces: List<MechanicalInterface>
  required_keepouts: List<String>
  assembly_members: List<String>
  package: String
  schema: String
  readme: String
  presentation: List<JsonKeyValue>
}

type PrintableAssemblySelection
  = PrintableAssemblyReady { assembly: PrintableAssembly }
  | PrintableAssemblyRefused { reason: String }

data review_release: String = "review-only; no print or powered-operation admission"

fn xyz(p: Point3) -> JsonValue { json_array(elements: [json_int(n: signed_frame_component_count(c: p.x)), json_int(n: signed_frame_component_count(c: p.y)), json_int(n: signed_frame_component_count(c: p.z))]) }
fn text(s: String) -> JsonValue { json_string(s: s) }
fn primitive_json(p: Primitive) -> JsonValue {
 match p {
  Block {size:s,center:c} => json_object(members:[json_kv(key:"op",value:text(s:"box")),json_kv(key:"size_um",value:json_array(elements:[json_int(n:micrometer_count(m:s.size_x)),json_int(n:micrometer_count(m:s.size_y)),json_int(n:micrometer_count(m:s.size_z))])),json_kv(key:"center_um",value:xyz(p:c))]),
  RoundPrism {diameter:d,length:l,axis:a,center:c} => json_object(members:[json_kv(key:"op",value:text(s:"cylinder")),json_kv(key:"diameter_um",value:json_int(n:micrometer_count(m:d))),json_kv(key:"length_um",value:json_int(n:micrometer_count(m:l))),json_kv(key:"axis",value:text(s:match a {Axis3X=>"x",Axis3Y=>"y",Axis3Z=>"z"})),json_kv(key:"center_um",value:xyz(p:c))]),
 }
}
fn part_json(p: AssemblyPart) -> JsonValue {
 json_object(members:[json_kv(key:"id",value:text(s:p.id)),json_kv(key:"name",value:text(s:p.name)),json_kv(key:"kind",value:text(s:match p.kind {Printed=>"printed",Purchased=>"purchased",Metal=>"metal",Clearance=>"clearance"})),json_kv(key:"scope",value:text(s:match p.scope {Cassette=>"cassette",FixedFrame=>"fixed"})),json_kv(key:"adds",value:json_array(elements:p.adds |> map(a=>primitive_json(p:a)))),json_kv(key:"cuts",value:json_array(elements:p.cuts |> map(a=>primitive_json(p:a)))),json_kv(key:"at_um",value:xyz(p:p.at)),json_kv(key:"explode_um",value:xyz(p:p.explode)),json_kv(key:"print_plane",value:text(s:match p.print_plane {LayOnXZ=>"XZ",LayOnXY=>"XY",LayOnYZ=>"YZ"})),json_kv(key:"notes",value:text(s:p.notes))])
}
fn fastener_display(f: FastenerKind) -> String {
 match f {M3PanelClamp=>"M3 top-accessible panel clamp + nut" M4SocketThroughBolt=>"M4 socket through-bolt + washers + nut" M4FanThroughBolt=>"M4 diagonal through-bolt + nut" PrintedRetainingPin=>"Broad-grip printed retaining pin" BoardSupportPending=>"Standoff hardware unresolved" ProtectedDcBranch=>"Rated protected/isolatable DC branch" BondingHardwarePending=>"Permanent metal bonding hardware unresolved" FanSelfTappingScrew=>"Fan self-tapping screw into the printed plate" FrictionFitPlug=>"Friction-fit plug, no hardware" FrictionFitSleeve=>"Friction-fit sleeve, no hardware" LocatingSleeveNoRetention=>"Locating sleeve, not retained: hold or tape the blower in place" M3IntoCardInsert=>"M3 screw into a threaded insert on the card"}
}
fn status_display(s: InterfaceStatus) -> String {match s {Proposed=>"proposed" OriginalPlateFitOnly=>"original plate fit passed; new stack proposed" Unresolved=>"unresolved"}}
fn interface_json(i: MechanicalInterface) -> JsonValue {
 json_object(members:[json_kv(key:"id",value:text(s:i.id)),json_kv(key:"members",value:json_array(elements:i.members |> map(x=>text(s:x)))),json_kv(key:"fastener",value:text(s:fastener_display(f:i.fastener))),json_kv(key:"quantity",value:json_int(n:i.quantity)),json_kv(key:"status",value:text(s:status_display(s:i.status))),json_kv(key:"requirement",value:text(s:i.requirement))])
}

// THE ONE MANIFEST THE CHECK ADAPTER READS. A root's presentation members are nested under their own
// key rather than spliced beside the common facts: the JSON object model does not refuse a repeated
// key, so a root contributing its own "root" or "parts" would otherwise produce a manifest whose
// meaning depends on which duplicate a reader keeps. No consumer reads a presentation member by a
// top-level key.
fn printable_manifest(a: PrintableAssembly) -> JsonValue {
 json_object(members: [
  json_kv(key:"schema",value:text(s:a.schema)),
  json_kv(key:"root",value:text(s:printed_assembly_root_wire(root:a.root))),
  json_kv(key:"quantum",value:text(s:"micrometre")),
  json_kv(key:"release",value:text(s:review_release)),
  json_kv(key:"package",value:text(s:a.package)),
  json_kv(key:"readme",value:text(s:a.readme)),
  json_kv(key:"presentation",value:json_object(members:a.presentation)),
  json_kv(key:"export",value:json_object(members:[json_kv(key:"linear_tolerance_um",value:json_int(n:micrometer_count(m:exercised_stl_knobs.linear_tolerance))),json_kv(key:"angular_tolerance_radians",value:text(s:exercised_stl_knobs.angular_tolerance_text as String))])),
  json_kv(key:"print_envelope_mm",value:json_array(elements:[json_int(n:millimeter_count(m:build_envelope_x(e:a1_mini_build_envelope))),json_int(n:millimeter_count(m:build_envelope_y(e:a1_mini_build_envelope))),json_int(n:millimeter_count(m:build_envelope_z(e:a1_mini_build_envelope)))])),
  json_kv(key:"desired_inventory",value:required_slots_json(parts:a.parts)),
  json_kv(key:"parts",value:json_array(elements:map(a.parts,p=>part_json(p:p)))),
  json_kv(key:"interfaces",value:json_array(elements:map(a.interfaces,i=>interface_json(i:i)))),
  json_kv(key:"required_keepouts",value:json_array(elements:map(a.required_keepouts,s=>text(s:s)))),
  json_kv(key:"assembly_members",value:json_array(elements:map(a.assembly_members,s=>text(s:s)))),
 ])
}
