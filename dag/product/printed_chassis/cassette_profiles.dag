module product.printed_chassis.cassette_profiles
import std.measure {micrometer_count}
import std.types {List}
import product.printed_chassis.cassette_profile {CassetteProfile,BoardOutline,BoardOutlineKnown,BoardOutlinePending,RetainPlatformPowerAssembly,IndependentPowerCassette,transplant_obligations,retained_platform_subsystems}
import product.printed_chassis.board_mechanical_reference {standard_location_reference,fit_confirmation_for,fit_confirmed_location_reference,ImageLocationReference,MountingReferencePending,jade_image_mount_reading}
import extdeps.external_authority {CitedToAuthority}
import extdeps.ocp.mt_jade.platform {mt_jade_motherboard_mechanical}
import extdeps.ocp.mt_jade.subject {mt_jade_subject_authority_anchor}
import extdeps.portwell.aptsa_627211_b4 {collins_datasheet_mechanicals}
import extdeps.boards.asrock_rack {asrock_altrad8ud_extent_along_rear_io,asrock_altrad8ud_extent_depth,asrock_altrad8ud_standard_location_roster,extdeps_external_authority_anchor}
import extdeps.standards.motherboard_mounting_location {MountingLocationId}
import product.printed_chassis.standoff_gauge {altrad8ud_standoff_gauge_a,altrad8ud_standoff_gauge_b}
import product.printed_chassis.fit_gauges {follow_on_fit_gauge_pairs}
import product.printed_chassis.fit_observations {altra_fit_gauge_set_fit,FittedGauge}
import extdeps.standards.micro_atx {micro_atx_mounting_locations,micro_atx_standard_hole_diameter}
import std.types {NonEmptyStr}
import extdeps.boards.supermicro_h11ssl {supermicro_h11ssl_family_mechanical,supermicro_h11ssl_standard_location_roster}
// Configuration rows for one generator. Each profile carries its mounting
// evidence directly; changing an id cannot detach it from that evidence.
// THE ALTRA'S GAUGES AS DECLARED NOW, in the shape the fit record names them: the F-C gauge and each
// follow-on pair, every end resolved against the microATX coordinates the gauges are cut from, with the
// standard hole diameter. A location that does not resolve once yields no gauge, which the comparison
// with the record then refuses.
fn declared_gauge(name:NonEmptyStr,a:MountingLocationId,b:MountingLocationId) -> List<FittedGauge> {
 flat_map(filter(micro_atx_mounting_locations,m=>m.id==a),ma=>map(filter(micro_atx_mounting_locations,m=>m.id==b),mb=>FittedGauge {name:name,a:a,a_along:ma.along_rear_edge,a_depth:ma.depth_from_rear_edge,b:b,b_along:mb.along_rear_edge,b_depth:mb.depth_from_rear_edge,hole_diameter:micro_atx_standard_hole_diameter}))
}
fn declared_altra_gauges() -> List<FittedGauge> {
 concat(declared_gauge(name:"F-C",a:altrad8ud_standoff_gauge_a,b:altrad8ud_standoff_gauge_b),flat_map(follow_on_fit_gauge_pairs,p=>declared_gauge(name:p.name,a:p.a,b:p.b)))
}
data altra_profile:CassetteProfile = CassetteProfile {
 id:"altrad8ud",requested_hardware:"ASRock Rack ALTRAD8UD-1L2T",
 outline:BoardOutlineKnown {width:asrock_altrad8ud_extent_along_rear_io,depth:asrock_altrad8ud_extent_depth,standing:CitedToAuthority {authority:extdeps.boards.asrock_rack.extdeps_external_authority_anchor}},
 mounting:fit_confirmed_location_reference(confirmation:fit_confirmation_for(roster:asrock_altrad8ud_standard_location_roster,record:altra_fit_gauge_set_fit.value,current:declared_altra_gauges())),
 power:IndependentPowerCassette,retain:[],open:transplant_obligations
}
// The H11SSL-i (operator, 2026-11-04: one of the three boards the operator's own residence receives
// on cassettes). Outline and holes are the vendor's ATX claim read through ATX 2.2; the fit print
// discharges the hole correspondence. It keeps a complete PSU of its own in the power cassette.
data h11ssl_i_profile:CassetteProfile = CassetteProfile {
 id:"h11ssl-i",requested_hardware:"Supermicro H11SSL-i rev 2.x (single SP3; EPYC 7002 requires board revision 2.x)",
 outline:BoardOutlineKnown {width:supermicro_h11ssl_family_mechanical.extent_along_rear_io,depth:supermicro_h11ssl_family_mechanical.extent_depth,standing:supermicro_h11ssl_family_mechanical.extents_standing},
 mounting:standard_location_reference(roster:supermicro_h11ssl_standard_location_roster),
 power:IndependentPowerCassette,retain:[],open:transplant_obligations
}
data gh200_p4261_profile:CassetteProfile = CassetteProfile {
 id:"gh200-p4261",requested_hardware:"NVIDIA P4261 / 694-24261-000-100 K1",outline:BoardOutlinePending,
 mounting:MountingReferencePending {read_obligation:"Revision-matched P4261 mechanical drawing and mounting map required; no other NVIDIA board substituted."},
 power:RetainPlatformPowerAssembly,retain:retained_platform_subsystems,open:transplant_obligations
}
data mt_jade_profile:CassetteProfile = CassetteProfile {
 id:"mt-jade",requested_hardware:"Ampere Mt. Jade board transplant",
 outline:BoardOutlineKnown {width:mt_jade_motherboard_mechanical.outline_width,depth:mt_jade_motherboard_mechanical.outline_depth,standing:CitedToAuthority {authority:mt_jade_subject_authority_anchor}},
 mounting:ImageLocationReference {reading:jade_image_mount_reading},
 power:RetainPlatformPowerAssembly,retain:retained_platform_subsystems,open:transplant_obligations
}
// Axis assignment is this product's inference from Portwell's two dimensions and
// chassis width. Only the short side fits across the chassis. A changed source
// that no longer discriminates the axes refuses instead of silently rotating.
fn collins_outline() -> BoardOutline {
 let r=collins_datasheet_mechanicals
 if micrometer_count(m:r.first_board_dimension)>micrometer_count(m:r.chassis_width) && micrometer_count(m:r.second_board_dimension)<micrometer_count(m:r.chassis_width) {
 BoardOutlineKnown {width:r.second_board_dimension,depth:r.first_board_dimension,standing:r.standing}
 } else {BoardOutlinePending}
}
data mt_collins_profile:CassetteProfile = CassetteProfile {
 id:"mt-collins",requested_hardware:"Ampere Mt. Collins board transplant; exact chassis/board revision pending",outline:collins_outline(),
 mounting:MountingReferencePending {read_obligation:"Full-board revision-matched drawing required. Guide Figures 11/12 are cropped or occluded; do not copy Jade's map. Recheck Portwell metric/inch disagreement and inferred axis assignment."},
 power:RetainPlatformPowerAssembly,retain:retained_platform_subsystems,open:transplant_obligations
}
data cassette_profiles:List<CassetteProfile> = [altra_profile,h11ssl_i_profile,gh200_p4261_profile,mt_collins_profile,mt_jade_profile]
