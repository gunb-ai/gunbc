import product.printed_chassis.slice_run {slice_profile_in}
import extdeps.shell

// Product decisions stay in modeled inputs; the kernel applies rigid transforms,
// checks the realized solids, and preserves instance names through the archive.
type PlatePlacement {id:String,rx:Int,ry:Int,rz:Int,x_um:Micrometer,y_um:Micrometer}
type PlatePreparation {placements:List<PlatePlacement>,support_free:List<String>}
data deposited_path_edge_allowance_um:Micrometer=micrometer(count: 250)
fn placement_admitted(p:PlatePlacement) -> Bool {
 preserves_print_plane(rx:p.rx,ry:p.ry) && p.id!="" && micrometer_count(m: p.x_um)>=0 && micrometer_count(m: p.y_um)>=0 && all([p.rx,p.ry,p.rz],n=>n==0||n==90||n==180||n==0-90||n==0-180)
}
fn placement_json(p:PlatePlacement) -> JsonValue {
 json_object(members:[json_kv(key:"id",value:json_string(s:p.id)),json_kv(key:"rotation_degrees",value:json_array(elements:map([p.rx,p.ry,p.rz],v=>json_int(n:v)))),json_kv(key:"minimum_xy_um",value:json_array(elements:map([micrometer_count(m: p.x_um) as Int,micrometer_count(m: p.y_um) as Int],v=>json_int(n:v))))])
}
fn envelope_json() -> JsonValue {
 json_array(elements:map([build_envelope_x(e:a1_mini_build_envelope),build_envelope_y(e:a1_mini_build_envelope),build_envelope_z(e:a1_mini_build_envelope)],m=>json_int(n:millimeter_count(m:m))))
}
fn literal(s:String) -> String {serialize_json(v:json_string(s:s))}
fn run_kernel(cad_runtime:CadRuntimeReady,script:String,call:String) -> ProcessExit {
 if !Filesystem.WriteCreateNew(path:script,content:concat(source(),call)).success {return exit_failure(reason:"Preparation script path already exists or is not writable")}
 match run_shell_command_capture(command:cad_program_command(c:cad_runtime,script_path:script),transport:LocalExec) {ProcessRefused {exit_code:_,stderr:e}=>exit_failure(reason:e) ProcessOutputAbsent=>ExitSuccess ProcessOutputPresent {text:_}=>ExitSuccess}
}

// THE SLICER PROFILES ARE MATERIALIZED ONCE PER INVOCATION, from the recipe and the verified Orca
// archive, and every plate of one request slices against those bytes. The readback requirements
// are the same profiles' values for the keys this product admits on, so the sliced archive is
// checked against what was fed rather than against a second hand-written table.
type StagedProfiles sole_constructor {machine:String,filament:String,process:String,required:JsonValue}
type RecipeStaging = RecipeStaged {profiles:StagedProfiles} | RecipeStagingRefused {cause:NonEmptyStr}

data required_machine_keys: List<String> = ["printer_model","nozzle_diameter"]
data required_filament_keys: List<String> = ["filament_type","nozzle_temperature","textured_plate_temp"]
data required_process_keys: List<String> = ["print_sequence","wall_loops","sparse_infill_density","enable_support","support_type","support_threshold_angle","support_on_build_plate_only","support_top_z_distance","support_bottom_z_distance","support_object_xy_distance"]

fn selected(members:List<JsonKeyValue>,keys:List<String>) -> List<JsonKeyValue>? {
 if all(keys,k=>count(filter(members,m=>m.key==k))==1) {Present {value:filter(members,m=>any(keys,k=>k==m.key))}} else {none}
}

fn stage_recipe_profiles(output:String,appimage:String,recipe:PrintRecipe) -> RecipeStaging {
 let temp=shell.Mktemp.Dir()
 if !temp.success {return RecipeStagingRefused {cause:"Cannot create a private profile extraction directory"}}
 let dir=temp.path as String
 let staged=stage_recipe_profiles_in(dir:dir,output:output,appimage:appimage,recipe:recipe)
 if shell.Remove.RecursiveForce(path:temp.path).success {staged} else {RecipeStagingRefused {cause:"Profile extraction cleanup failed"}}
}
fn keys_refused() -> RecipeStaging {RecipeStagingRefused {cause:"A required readback key is absent or duplicated in the recipe's profiles"}}
fn stage_recipe_profiles_in(dir:String,output:String,appimage:String,recipe:PrintRecipe) -> RecipeStaging {
 match with_verified_orca(appimage:appimage as FilePath,use:executable=>run_shell_command_capture(command:env_prefixed_command_in(directory:dir,bindings:[],command:orca_extract_bbl_profiles_command(executable:executable)),transport:LocalExec)) {
  ProcessRefused {exit_code:_,stderr:e}=>return RecipeStagingRefused {cause:concat("Orca profile extraction refused: ",e) as NonEmptyStr}
  ProcessOutputAbsent=>{} ProcessOutputPresent {text:_}=>{}
 }
 let machine=match flatten_orca_profile(extracted_into:dir,kind:OrcaMachineProfile,name:recipe.machine as String,depth:orca_profile_inheritance_bound) {OrcaProfileFlattened {members:m}=>m OrcaProfileRefused {name:n,cause:c}=>return RecipeStagingRefused {cause:join([c as String,": ",n],"") as NonEmptyStr}}
 let filament=match flatten_orca_profile(extracted_into:dir,kind:OrcaFilamentProfile,name:recipe.filament as String,depth:orca_profile_inheritance_bound) {OrcaProfileFlattened {members:m}=>m OrcaProfileRefused {name:n,cause:c}=>return RecipeStagingRefused {cause:join([c as String,": ",n],"") as NonEmptyStr}}
 let process=match flatten_orca_profile(extracted_into:dir,kind:OrcaProcessProfile,name:recipe.process as String,depth:orca_profile_inheritance_bound) {OrcaProfileFlattened {members:m}=>overlay(base:m,top:recipe_process_overrides(r:recipe)) OrcaProfileRefused {name:n,cause:c}=>return RecipeStagingRefused {cause:join([c as String,": ",n],"") as NonEmptyStr}}
 let a=match selected(members:machine,keys:required_machine_keys) {Present {value:v}=>v Absent=>return keys_refused()}
 let b=match selected(members:filament,keys:required_filament_keys) {Present {value:v}=>v Absent=>return keys_refused()}
 let c=match selected(members:process,keys:required_process_keys) {Present {value:v}=>v Absent=>return keys_refused()}
 let required=json_object(members:concat(concat(a,b),c))
 let machine_text=serialize_json(v:json_object(members:machine))
 let filament_text=serialize_json(v:json_object(members:filament))
 let process_text=serialize_json(v:json_object(members:process))
 let profiles=StagedProfiles {machine:concat(output,".machine.json"),filament:concat(output,".filament.json"),process:concat(output,".process.json"),required:required}
 let written=Filesystem.WriteCreateNew(path:profiles.machine,content:machine_text).success &&
  Filesystem.WriteCreateNew(path:profiles.filament,content:filament_text).success &&
  Filesystem.WriteCreateNew(path:profiles.process,content:process_text).success
 if written {RecipeStaged {profiles:profiles}} else {RecipeStagingRefused {cause:"Profile outputs already exist or are not writable"}}
}
fn readback_call(project:String,plan:PlatePreparation,receipt:String,profiles:StagedProfiles,runtime_receipt_sha256:String) -> String {
 let paths=serialize_json(v:json_object(members:[json_kv(key:"machine",value:json_string(s:profiles.machine)),json_kv(key:"filament",value:json_string(s:profiles.filament)),json_kv(key:"process",value:json_string(s:profiles.process))]))
 join(["\nreport=readback(",literal(s:project),",",serialize_json(v:json_array(elements:map(plan.placements,p=>json_string(s:p.id)))),",",serialize_json(v:profiles.required),",",serialize_json(v:envelope_json()),",",serialize_json(v:json_array(elements:map(plan.support_free,s=>json_string(s:s)))),",['bed_temperature_too_high_than_filament','not_support_traditional_timelapse'],",to_string(micrometer_count(m: deposited_path_edge_allowance_um)),")\nsupport_geometry=report['paths'].pop('support_geometry')\nsupport_path=pathlib.Path(",literal(s:concat(project,".supports.json")),")\nsupport_payload=json.dumps(dict(schema='gunbc.generated-support-centerlines.v1',project_sha256=report['project_sha256'],policy=json.loads(",literal(s:serialize_json(v:support_policy_json(p:prototype_support_policy))),"),objects=support_geometry),indent=2).encode()\nsupport_path.write_bytes(support_payload)\nreport['support_geometry_sha256']=hashlib.sha256(support_payload).hexdigest()\nreport['cad_binding']=json.loads(pathlib.Path(",literal(s:concat(project,".source.3mf.cad-binding.json")),").read_text())\nreport['source_project_sha256']=hashlib.sha256(pathlib.Path(",literal(s:concat(project,".source.3mf")),").read_bytes()).hexdigest()\nreport['profile_sha256']=dict((k,hashlib.sha256(pathlib.Path(v).read_bytes()).hexdigest()) for k,v in ",paths,".items())\nreport['orca_archive_sha256']=",literal(s:orca_slicer_linux_aarch64_appimage_sha256 as String),"\nreport['print_runtime_receipt_sha256']=",literal(s:runtime_receipt_sha256),"\nreport['reader_program_sha256']=hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest()\npathlib.Path(",literal(s:receipt),").write_text(json.dumps(report,indent=2)+'\\n')\n"],"")
}
fn prepare(runtime:PrintRuntimeReady,cad:String,plan:PlatePreparation,output:String,appimage:String,profiles:StagedProfiles) -> ProcessExit {
 if count(plan.placements)==0 || !all(plan.placements,p=>placement_admitted(p:p)) {return exit_failure(reason:"Invalid placements or rotation away from modeled print plane; build-stage stability review required")}
 let scratch=concat(output,".orca")
 if !shell.Mkdir.Parents(path:scratch as FilePath).success {return exit_failure(reason:"Cannot isolate slicer scratch output")}
 let model=concat(output,".source.3mf")
 let pack=join(["\npack_plate(",literal(s:cad),",",serialize_json(v:json_array(elements:map(plan.placements,p=>placement_json(p:p)))),",",literal(s:model),",",serialize_json(v:envelope_json()),")\n"],"")
 match run_kernel(cad_runtime:print_runtime_cad(r:runtime),script:concat(output,".pack.py"),call:pack) {
  ExitSuccess=>match slice_profile_in(directory:scratch,appimage:appimage,model:model,output:output,machine:profiles.machine,filament:profiles.filament,process:profiles.process) {
   ExitSuccess=>run_kernel(cad_runtime:print_runtime_cad(r:runtime),script:concat(output,".readback.py"),call:readback_call(project:output,plan:plan,receipt:concat(output,".readback.json"),profiles:profiles,runtime_receipt_sha256:print_runtime_receipt_sha256(r:runtime)))
   other=>other
  }
  other=>other
 }
}

// Read an existing immutable archive through the same process observer as admission.
// Retrospective evidence never authorizes a start or rewrites an original receipt.
fn observe_process_batch(projects_json:String,output:String) -> ProcessExit {
 if !starts_with(s:output,prefix:"/") || !shell.Mkdir.Parents(path:output as FilePath).success {return exit_failure(reason:"Observation output must be an absolute writable directory")}
 let cad_runtime=match observe_cad_runtime(tree:host_state_tree()) {CadRuntimeObserved {runtime:c}=>c CadRuntimeRefused {reason:why}=>return exit_failure(reason:why)}
 run_kernel(cad_runtime:cad_runtime,script:concat(output,"/process-reader.py"),call:join(["\nprojects=json.loads(",literal(s:projects_json),")\nassert isinstance(projects,list) and projects and all(isinstance(p,str) and p for p in projects)\nfor project in projects:\n    report=observe_archived_process(project)\n    (pathlib.Path(",literal(s:output),")/(report['project_sha256']+'.process.json')).open('x').write(json.dumps(report,indent=2)+'\\n')\n"],""))
}
