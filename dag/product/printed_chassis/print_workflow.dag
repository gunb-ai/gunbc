// A single invocation prepares every requested plate and writes one receipt. It starts nothing:
// gunbc.fleet.printer_actuation is the only start authority.
type PreparedPlate {path:String,digest:Sha256Digest,attempt:String}
type PreparedQueue {printer:PhysicalAssetIdentity,version:NonEmptyStr,plates:List<PreparedPlate>}
type QueuePrepared = QueueReadyForApproval {queue:PreparedQueue} | QueuePreparationRefused {reason:String}
// Plan shape (unique printers and attempts, numeric versions) is product.printed_chassis.print_batch_plan
// parse_plan's, and each plate's digest is typed; this checks only that the printer is known and
// every plate has a working path.
fn queue_valid(queue:PreparedQueue) -> Bool {
 (match select_printer(name:queue.printer as String) {PrinterSelected {printer:_}=>true PrinterSelectionRefused=>false}) &&
 all(queue.plates,p=>p.path!="")
}
fn queues_valid(queues:List<PreparedQueue>) -> Bool {all(queues,q=>queue_valid(queue:q))}
fn plate_path(output:String,printer:PrinterSpec,plate:PlateSpec) -> String {
 let key=serialize_json(v:json_array(elements:[json_string(s:printer.printer as String),json_string(s:plate.attempt)]))
 join([output,"/",sha256_hex(message:bytes_octets(b:utf8_encode_bytes(s:key))) as String,".3mf"],"")
}
// PREPARATION IS RECOMPUTED, NOT CACHED. A prepared plate is identified by the sha256 of its bytes,
// read back from the sliced archive; its path is a locator re-hashed by every consumer. No store or
// preparation key sits beside std.materialization_provider: by the materialization ladder (DESIGN
// section 2) a cache answers a reuse obligation, and prints are rare, take minutes to prepare and
// share no preparation across requests, so there is none. A recurring, measured reuse is the trigger
// to key preparation as a std.materialization_provider ArtifactRequest and serve it from the local
// materialization store, not to grow a second one here.
fn prepare_plate(runtime:PrintRuntimeReady,path:String,plan:PlatePreparation,output:String,appimage:String,profiles:StagedProfiles) -> Sha256Digest? {
 match prepare(runtime:runtime,cad:concat(output,"/cad"),plan:plan,output:path,appimage:appimage,profiles:profiles) {
  ExitFailure {code:_,reason:_}=>none
  ExitSuccess=>{
   let read=Filesystem.Read(path:concat(path,".readback.json"))
   let read_digest=if read.success {match parse_json_document(s:read.content) {JsonDocumentParsed {value:v}=>match json_field_string(obj:v,key:"project_sha256") {FieldRead {value:d}=>sha256_hex_digest(hex:d) FieldAbsent=>none FieldMalformed {cause:_}=>none} JsonDocumentUnreadable {gap:_}=>none}} else {none}
   read_digest
  }
 }
}
fn prepared_queue_plate(runtime:PrintRuntimeReady,path:String,plate:PlateSpec,output:String,appimage:String,profiles:StagedProfiles) -> PreparedPlate? {
 match prepare_plate(runtime:runtime,path:path,plan:plate.plan,output:output,appimage:appimage,profiles:profiles) {Present {value:d}=>Present {value:PreparedPlate {path:path,digest:d,attempt:plate.attempt}} Absent=>none}
}
fn prepare_queue(runtime:PrintRuntimeReady,spec:PrinterSpec,output:String,appimage:String,profiles:StagedProfiles) -> QueuePrepared {
 let results=map(spec.plates,p=>prepared_queue_plate(runtime:runtime,path:plate_path(output:output,printer:spec,plate:p),plate:p,output:output,appimage:appimage,profiles:profiles))
 if any(results,r=>match r {Absent=>true Present {value:_}=>false}) {QueuePreparationRefused {reason:"A plate failed CAD packing, pinned slicing or readback"}}
 else {QueueReadyForApproval {queue:PreparedQueue {printer:spec.printer,version:spec.version,plates:flat_map(results,r=>match r {Present {value:p}=>[p] Absent=>[]})}}}
}
fn run(plan_file:String,recipe:String,source_revision:String,root:String) -> ProcessExit {
 let appimage=match acquire_orca_archive(tree:host_state_tree()) {SlicerArchiveReady {path:p}=>p SlicerArchiveRefused {cause:c}=>return exit_failure(reason:c)}
 let selected=match printed_assembly_root_from_wire(s:root) {Present {value:r}=>r Absent=>return exit_failure(reason:"Unknown printed assembly root")}
 let chosen=match print_recipe_from_wire(s:recipe) {Present {value:r}=>r Absent=>return exit_failure(reason:"Unknown print recipe")}
 if source_revision=="" {return exit_failure(reason:"Preparation needs the source revision its geometry is generated at")}
 let read=Filesystem.Read(path:plan_file)
 if !read.success {return exit_failure(reason:"Cannot read fleet print plan")}
 let specs=match parse_plan(text:read.content) {Present {value:p}=>p Absent=>return exit_failure(reason:"Malformed printer queues, duplicate identities or invalid placements")}
 let bundle=match prepared_bundle(tree:host_state_tree(),plan_text:read.content) {PreparedBundleReady {bundle:b}=>b PreparedBundleUnready {detail:d}=>return exit_failure(reason:d)}
 let output=prepared_bundle_directory(bundle:bundle)
 let runtime=match observe_print_runtime(tree:host_state_tree(),appimage:appimage,receipt:concat(output,"/runtime.json")) {PrintRuntimeObserved {runtime:r}=>r PrintRuntimeRefused {reason:why}=>return exit_failure(reason:why)}
 let profiles=match stage_recipe_profiles(output:concat(output,"/inputs"),appimage:appimage,recipe:chosen) {RecipeStaged {profiles:p}=>p RecipeStagingRefused {cause:c}=>return exit_failure(reason:c as String)}
 match check_printable_cad(cad:print_runtime_cad(r:runtime),root:selected,output:concat(output,"/cad")) {ExitSuccess=>{} cad_refusal=>return cad_refusal}
 let results=map(specs,s=>prepare_queue(runtime:runtime,spec:s,output:output,appimage:appimage,profiles:profiles))
 if any(results,r=>match r {QueuePreparationRefused {reason:_}=>true QueueReadyForApproval {queue:_}=>false}) {return exit_failure(reason:"Fleet preparation refused; inspect per-plate preparation logs; nothing was started")}
 let queues=flat_map(results,r=>match r {QueueReadyForApproval {queue:q}=>[q] QueuePreparationRefused {reason:_}=>[]})
 if !queues_valid(queues:queues) {return exit_failure(reason:"Prepared fleet queues failed final admission")}
 let receipt=serialize_json(v:json_array(elements:map(queues,q=>json_object(members:[json_kv(key:"printer",value:json_string(s:q.printer as String)),json_kv(key:"version",value:json_string(s:q.version as String)),json_kv(key:"recipe",value:json_string(s:recipe)),json_kv(key:"source_revision",value:json_string(s:source_revision)),json_kv(key:"plates",value:json_array(elements:map(q.plates,p=>json_object(members:[json_kv(key:"path",value:json_string(s:p.path)),json_kv(key:"digest",value:json_string(s:p.digest.hex as String)),json_kv(key:"attempt",value:json_string(s:p.attempt))]))))]))))
 match prepared_bundle_write_receipt(bundle:bundle,content:receipt) {PreparedReceiptWritten=>ExitSuccess PreparedReceiptRefused {cause:c}=>exit_failure(reason:c)}
}

// ONE PLATE FOR ONE PRINT REQUEST (gunbc.fleet.print_converge). The plate plan names only objects,
// placements, orientation and support policy; the recipe is the machine and process, and the printer
// belongs to the request, so nothing here names a physical printer or a credential.
// THE REQUEST PASS OBSERVES THE RUNTIME; IT DOES NOT PROVISION IT. It runs as the CI job user, which
// holds no apt or root grant, so a package install from here could only refuse (and the package
// route is SSH as a login principal the job user is not). observe_print_runtime below reads the OS,
// packages, CAD interpreter and pinned slicer on this host and refuses naming what is missing;
// provisioning stays the explicit converge_runtime / provision_and_run route.
type RequestPlatePreparation = RequestPlatePrepared {artifact:Sha256Digest,path:String} | RequestPlateRefused {cause:String}
fn prepare_request_plate(plate_file:String,output:String,recipe:String,source_revision:String,root:String) -> RequestPlatePreparation {
 let appimage=match acquire_orca_archive(tree:host_state_tree()) {SlicerArchiveReady {path:p}=>p SlicerArchiveRefused {cause:c}=>return RequestPlateRefused {cause:c}}
 let selected=match printed_assembly_root_from_wire(s:root) {Present {value:r}=>r Absent=>return RequestPlateRefused {cause:"Unknown printed assembly root"}}
 let chosen=match print_recipe_from_wire(s:recipe) {Present {value:r}=>r Absent=>return RequestPlateRefused {cause:"Unknown print recipe"}}
 if source_revision=="" {return RequestPlateRefused {cause:"Preparation needs the source revision its geometry is generated at"}}
 let read=Filesystem.Read(path:plate_file)
 if !read.success {return RequestPlateRefused {cause:concat("Cannot read the plate plan ",plate_file)}}
 let plate=match parse_plate_plan(text:read.content) {Present {value:p}=>p Absent=>return RequestPlateRefused {cause:"Malformed plate plan or invalid placements"}}
 if !starts_with(s:output,prefix:"/") || !shell.Mkdir.Parents(path:output as FilePath).success {return RequestPlateRefused {cause:"Preparation output must be an absolute writable directory"}}
 let runtime=match observe_print_runtime(tree:host_state_tree(),appimage:appimage,receipt:concat(output,"/runtime.json")) {PrintRuntimeObserved {runtime:r}=>r PrintRuntimeRefused {reason:why}=>return RequestPlateRefused {cause:why}}
 let profiles=match stage_recipe_profiles(output:concat(output,"/inputs"),appimage:appimage,recipe:chosen) {RecipeStaged {profiles:p}=>p RecipeStagingRefused {cause:c}=>return RequestPlateRefused {cause:c as String}}
 match check_printable_cad(cad:print_runtime_cad(r:runtime),root:selected,output:concat(output,"/cad")) {ExitSuccess=>{} ExitFailure {code:_,reason:r}=>return RequestPlateRefused {cause:concat("CAD check refused: ",r)}}
 match prepare_plate(runtime:runtime,path:concat(output,"/plate.3mf"),plan:plate,output:output,appimage:appimage,profiles:profiles) {
  Present {value:d}=>RequestPlatePrepared {artifact:d,path:concat(output,"/plate.3mf")}
  Absent=>RequestPlateRefused {cause:"Pinned slicing or readback refused the plate; see the preparation output"}
 }
}

// Explicit dependency-provisioning phase. Preparation only observes; callers
// request convergence through this same workflow root when the host needs setup.
// Host packages first (the CAD interpreter links against them), then the CAD environment;
// a refusal at either stops here.
fn converge_runtime(receipt:String) -> ProcessExit {
 match converge(receipt:receipt) {
  ExitSuccess=>converge_cad_runtime(tree:host_state_tree(),receipt:concat(receipt,".cad"))
  package_refusal=>package_refusal
 }
}

// Explicitly requested provisioning followed by ordinary preparation.
// This composes the existing phases in one invocation; the default run remains
// observe-only with respect to host packages. A convergence refusal stops here.
fn provision_and_run(plan_file:String,recipe:String,source_revision:String,root:String) -> ProcessExit {
 let runtime_host=os.Hostname.ReadShort()
 if !runtime_host.success || trim(s:runtime_host.value)!=(printer_lan_host_identity() as String) {return exit_failure(reason:"Provision-and-prepare must run on the modeled printer LAN host")}
 match printed_assembly_root_from_wire(s:root) {Absent=>return exit_failure(reason:"Unknown printed assembly root") Present {value:_}=>{}}
 let plan_read=Filesystem.Read(path:plan_file)
 if !plan_read.success {return exit_failure(reason:"Cannot read print plan before provisioning")}
 match parse_plan(text:plan_read.content) {Absent=>return exit_failure(reason:"Invalid print plan before provisioning") Present {value:_}=>{}}
 let bundle=match prepared_bundle(tree:host_state_tree(),plan_text:plan_read.content) {PreparedBundleReady {bundle:b}=>b PreparedBundleUnready {detail:d}=>return exit_failure(reason:d)}
 match converge_runtime(receipt:concat(prepared_bundle_directory(bundle:bundle),"/runtime-convergence.txt")) {
  ExitSuccess=>run(plan_file:plan_file,recipe:recipe,source_revision:source_revision,root:root)
  provisioning_refusal=>provisioning_refusal
 }
}


// Preparation is the revision authority. No operator-authored revision labels are admitted.
// THE ROOT IS READ BACK, NEVER RE-ASSERTED, and from the same bytes the slots were verified against
// (preparation_identity read_prepared_assembly). The durable inventory is still the cassette's own
// store and schema (assembly_inventory_store, gunbc.cassette-inventory.v2), so every other root
// refuses here until that store is keyed by root.
type InventoryRoot = InventoryRootReady {parts:List<AssemblyPart>,bindings:List<PreparedSlot>} | InventoryRootRefused
fn inventory_root(plan_file:String) -> InventoryRoot {
 let plan=Filesystem.Read(path:plan_file)
 if !plan.success {InventoryRootRefused} else {
  match prepared_bundle(tree:host_state_tree(),plan_text:plan.content) {
   PreparedBundleUnready {detail:_}=>InventoryRootRefused
   PreparedBundleReady {bundle:bundle}=>match read_prepared_assembly(bundle:bundle) {
    Absent=>InventoryRootRefused
    Present {value:prepared}=>match printed_assembly_root_from_wire(s:prepared.root_wire) {
     Absent=>InventoryRootRefused
     Present {value:r}=>match r {
      ResidentialCassette=>match select_printable_assembly(root:r) {
       PrintableAssemblyReady {assembly:a}=>cassette_inventory_root(parts:a.parts,bindings:prepared.slots)
       PrintableAssemblyRefused {reason:_}=>InventoryRootRefused
      }
      CassetteRackReview=>InventoryRootRefused
      DuctCardRoot {card:_,kind:_}=>InventoryRootRefused
     }
    }
   }
  }
 }
}
fn cassette_inventory_root(parts:List<AssemblyPart>,bindings:List<PreparedSlot>) -> InventoryRoot {
 let desired=required_printed_parts(parts:parts,bindings:bindings)
 if any(bindings,b=>!any(desired,d=>d.slot==b.slot)) {InventoryRootRefused} else {InventoryRootReady {parts:parts,bindings:bindings}}
}
fn preparation_refused() -> CliWireResponse {CliWirePrintable {bytes:"Prepared projects, CAD binding or assembly membership refused",exit:exit_failure(reason:"Preparation identity refused")}}

// Shadow reconciliation consumes an independent inventory capture and verified preparation.
fn plan_remaining(inventory_file:String,plan_file:String) -> CliWireResponse {
 match inventory_root(plan_file:plan_file) {
  InventoryRootRefused=>preparation_refused()
  InventoryRootReady {parts:p,bindings:bindings}=>inventory_report(parts:p,bindings:bindings,path:inventory_file)
 }
}

// Explicit inventory import initializes once; subsequent changes are fenced transitions.
fn inventory_initialize(capture_file:String) -> ProcessExit {
 let read=Filesystem.Read(path:capture_file)
 if !read.success {return exit_failure(reason:"Inventory capture unreadable")}
 match cassette_inventory_store(tree:host_state_tree()) {
  CassetteInventoryStoreUnready {detail:d}=>exit_failure(reason:d)
  CassetteInventoryStoreReady {store:store}=>initialize_inventory(store:store,capture:read.content)
 }
}
fn record_inspection(plan_file:String,baseline:String,receipt:String,slot:String,attempt:String,physical_item:String,observed_at:String,accepted:Bool) -> CliWireResponse {
 let bindings=match inventory_root(plan_file:plan_file) {InventoryRootReady {parts:_,bindings:b}=>b InventoryRootRefused=>return preparation_refused()}
 let binding=match filter(bindings,b=>b.slot==slot && b.attempt==attempt).first() {Present {value:b}=>b Absent=>return preparation_refused()}
 let store=match cassette_inventory_store(tree:host_state_tree()) {CassetteInventoryStoreReady {store:s}=>s CassetteInventoryStoreUnready {detail:d}=>return CliWirePrintable {bytes:d,exit:exit_failure(reason:d)}}
 match mutate_inventory(store:store,mutation:InspectPart {baseline:baseline,next_snapshot:receipt,part:RequiredPart {slot:slot,revision:Present {value:binding.revision}},attempt:binding.attempt,physical_item:physical_item,evidence:InspectionEvidence {reference:receipt,observed_at:observed_at},accepted:accepted}) {
 ExitSuccess=>plan_remaining_stored(plan_file:plan_file)
 ExitFailure {code:_,reason:r}=>CliWirePrintable {bytes:r,exit:exit_failure(reason:r)}
 }
}

// Reservations consume generated, byte-verified queues. This verb sends no start command.
fn reserve_plan(plan_file:String,baseline:String,receipt:String) -> ProcessExit {
 let bindings=match inventory_root(plan_file:plan_file) {InventoryRootReady {parts:_,bindings:b}=>b InventoryRootRefused=>return exit_failure(reason:"Preparation identity refused")}
 let requests=map(bindings,b=>PartReservation {part:RequiredPart {slot:b.slot,revision:Present {value:b.revision}},attempt:b.attempt})
 let store=match cassette_inventory_store(tree:host_state_tree()) {CassetteInventoryStoreReady {store:s}=>s CassetteInventoryStoreUnready {detail:d}=>return exit_failure(reason:d)}
 mutate_inventory(store:store,mutation:ReserveParts {baseline:baseline,next_snapshot:receipt,reservations:requests})
}

fn plan_remaining_stored(plan_file:String) -> CliWireResponse {
 let prepared=inventory_root(plan_file:plan_file)
 let store=match cassette_inventory_store(tree:host_state_tree()) {CassetteInventoryStoreReady {store:s}=>s CassetteInventoryStoreUnready {detail:d}=>return CliWirePrintable {bytes:d,exit:exit_failure(reason:d)}}
 let captured=match observe_stored_inventory(store:store) {ObservationEstablished {observed:c}=>c ObservationRefused {cause:InventoryUnread {reason:r}}=>return CliWirePrintable {bytes:r,exit:exit_failure(reason:r)}}
 match prepared {
 InventoryRootRefused=>preparation_refused()
 InventoryRootReady {parts:p,bindings:bindings}=>captured_inventory_report(parts:p,bindings:bindings,capture:captured)
 }
}
