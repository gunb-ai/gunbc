module product.printed_chassis.blower_outlet_mount

import std.types { Bool, Int, List, String }
import std.optional { Present, Absent }
import std.measure { Micrometer, micrometer, micrometer_count }
import std.euclidean_geometry { Axis3X, Axis3Y }
import product.printed_chassis.assembly_geometry { Primitive, AssemblyPart, Metal, FixedFrame, LayOnXY, block, round, part }
import product.printed_chassis.fit_observations { bfb1012m_received_reading }
import extdeps.fans.types { RadialBlowerOutlet, RadialBlowerMountingHole }
import extdeps.fans.delta { delta_bfb1012m_outlet, delta_bfb1012m_outlet_side_hole }

// ═══ HOW A PRINTED PART HOLDS THE DELTA BFB1012M: A SOCKET ON ITS OUTLET AND ONE SCREW IN ITS LUG ═══
//
// One mount for every duct that carries the blower (operator, 2026-11-04): the socket takes only the outlet's
// frame (extdeps.fans.delta delta_bfb1012m_outlet, 57.9 mm along the edge), not the whole housing edge, and the
// blower is retained by ONE screw through an arm on the label face into the lug of the hole nearer the outlet
// (delta_bfb1012m_outlet_side_hole). The arm can lie flat on the label face because that lug is flush with it,
// and the label face may face a wall or a card because the intake is on the other face only; both are the
// operator's readings of a received unit (product.printed_chassis.fit_observations bfb1012m_received_reading),
// and a reading that says otherwise refuses the mount (outlet_mount_unfit).
//
// THE SCREW is the operator's M5 x 10 fan screw (head 5.66 mm across, 1.09 mm high). It is driven from the arm's
// outer face and cuts its own thread: the arm's hole is the lug's own 4.5 mm, the size the screw is made to
// tap, so it holds in the arm and in the lug. It retains the blower against backing out of the socket; it is
// not a clamp.
//
// PLACEMENT, in the caller's part frame: the outlet edge lies along X or along Y (`edge`), and runs from its
// corner at `corner` (a coordinate on that axis) in the direction `run` (+1 or -1); the housing's thickness lies
// along the other of X and Y, centred on `centre`; the outlet mouth lies in the plane Z = `mouth_z` and the
// housing body rises from it in the direction `body` (+1 or -1). Which way the label face points then follows
// from the blower's handedness (label_normal), not from the caller.
type MountEdgeAxis = EdgeAlongX | EdgeAlongY
type OutletMount { edge: MountEdgeAxis, corner: Int, run: Int, centre: Int, mouth_z: Int, body: Int }

data blower_lug_screw_length: Micrometer = micrometer(count: 10000)
data blower_lug_screw_head_height: Micrometer = micrometer(count: 1090)
// The arm: thick enough to carry the screw's thread, and reaching this far past the hole centre each way.
data blower_lug_arm_thickness: Micrometer = micrometer(count: 4000)
data blower_lug_arm_margin: Micrometer = micrometer(count: 6000)
// The boss under the hole closes the socket clearance, so the arm bears on the lug.
data blower_lug_boss_diameter: Micrometer = micrometer(count: 11000)
data blower_lug_hole_diameter: Micrometer = micrometer(count: 4500)

fn um(m: Micrometer) -> Int { micrometer_count(m: m) as Int }

fn lo(a: Int, b: Int) -> Int { if a < b { a } else { b } }
fn hi(a: Int, b: Int) -> Int { if a < b { b } else { a } }

// A box between two corners given in any order.
fn span_block(x_a: Int, x_b: Int, y_a: Int, y_b: Int, z_a: Int, z_b: Int) -> Primitive {
  block(w: hi(a: x_a, b: x_b) - lo(a: x_a, b: x_b), h: hi(a: y_a, b: y_b) - lo(a: y_a, b: y_b), d: hi(a: z_a, b: z_b) - lo(a: z_a, b: z_b),
    x: (x_a + x_b) / 2, y: (y_a + y_b) / 2, z: (z_a + z_b) / 2)
}

// The same box given along the edge (e) and across the thickness (t), placed on whichever axes the mount uses.
fn mount_block(m: OutletMount, e_a: Int, e_b: Int, t_a: Int, t_b: Int, z_a: Int, z_b: Int) -> Primitive {
  match m.edge {
    EdgeAlongX => span_block(x_a: e_a, x_b: e_b, y_a: t_a, y_b: t_b, z_a: z_a, z_b: z_b)
    EdgeAlongY => span_block(x_a: t_a, x_b: t_b, y_a: e_a, y_b: e_b, z_a: z_a, z_b: z_b)
  }
}

// A cylinder whose axis runs through the thickness.
fn mount_round(m: OutletMount, diameter: Int, length: Int, e: Int, t: Int, z: Int) -> Primitive {
  match m.edge {
    EdgeAlongX => round(diameter: diameter, length: length, axis: Axis3Y, x: e, y: t, z: z)
    EdgeAlongY => round(diameter: diameter, length: length, axis: Axis3X, x: t, y: e, z: z)
  }
}

// The reading this mount rests on, refused when it does not hold.
fn outlet_mount_unfit() -> String? {
  let r = bfb1012m_received_reading.value
  if r.side_hole_lug_flush_with_label_face == false { return Present { value: "the blower's lug is not read flush with its label face, so an arm on that face does not reach it" } }
  if r.intake_only_on_unlabelled_face == false { return Present { value: "the blower's intake is not read to be on the unlabelled face only, so its label face may not face a wall" } }
  Absent
}

// The direction, +1 or -1 along the thickness axis, the label face points. Held label toward the reader with the
// outlet down, the outlet is at the reader's right: the right is the corner side (-run along the edge axis), up is
// the body (+body along Z), and the face toward the reader is right x up. With the edge along X that is
// +run*body along Y (X x Z = -Y); with the edge along Y it is -run*body along X (Y x Z = +X).
fn label_normal(m: OutletMount) -> Int {
  let handed = if bfb1012m_received_reading.value.outlet_at_right_with_label_toward_reader_and_outlet_down { 1 } else { 0 - 1 }
  match m.edge { EdgeAlongX => handed * m.run * m.body EdgeAlongY => 0 - handed * m.run * m.body }
}

// The run that puts the label face toward `toward` (+1 or -1 along the thickness axis), for a caller that
// knows which side the label must face.
fn run_for_label(edge: MountEdgeAxis, body: Int, toward: Int) -> Int {
  if label_normal(m: OutletMount { edge: edge, corner: 0, run: 1, centre: 0, mouth_z: 0, body: body }) == toward { 1 } else { 0 - 1 }
}

// The housing's thickness, at its tolerance, as the socket receives it.
fn housing_half(thickness: Micrometer, tolerance: Micrometer) -> Int { (um(m: thickness) + um(m: tolerance)) / 2 }

fn frame_end(m: OutletMount) -> Int { m.corner + m.run * um(m: delta_bfb1012m_outlet.frame_along_edge) }

// The outlet opening along the edge: centred in the frame, whose two end walls the drawing gives as equal.
fn opening_edge_lo(m: OutletMount) -> Int {
  let f = um(m: delta_bfb1012m_outlet.frame_along_edge)
  let o = um(m: delta_bfb1012m_outlet.opening_along_edge)
  lo(a: m.corner + m.run * (f - o) / 2, b: m.corner + m.run * (f + o) / 2)
}
fn opening_edge_hi(m: OutletMount) -> Int { opening_edge_lo(m: m) + um(m: delta_bfb1012m_outlet.opening_along_edge) }
fn opening_half_thickness() -> Int { um(m: delta_bfb1012m_outlet.opening_across_thickness) / 2 }

// The socket's outer extent along the edge, for a caller that builds the duct body around it.
fn socket_edge_lo(m: OutletMount, clearance: Micrometer, wall: Micrometer) -> Int { lo(a: m.corner, b: frame_end(m: m)) - um(m: clearance) - um(m: wall) }
fn socket_edge_hi(m: OutletMount, clearance: Micrometer, wall: Micrometer) -> Int { hi(a: m.corner, b: frame_end(m: m)) + um(m: clearance) + um(m: wall) }

fn outlet_socket_adds(m: OutletMount, half: Int, clearance: Micrometer, wall: Micrometer, depth: Micrometer) -> List<Primitive> {
  let o = half + um(m: clearance) + um(m: wall)
  [mount_block(m: m, e_a: socket_edge_lo(m: m, clearance: clearance, wall: wall), e_b: socket_edge_hi(m: m, clearance: clearance, wall: wall), t_a: m.centre - o, t_b: m.centre + o, z_a: m.mouth_z, z_b: m.mouth_z + m.body * um(m: depth))]
}

// The cavity the outlet frame enters, open past the rim. The floor below it is the caller's: whatever it
// leaves around the opening is the ledge the outlet's end walls rest on.
fn outlet_socket_cuts(m: OutletMount, half: Int, clearance: Micrometer, depth: Micrometer) -> List<Primitive> {
  let c = um(m: clearance)
  [mount_block(m: m, e_a: lo(a: m.corner, b: frame_end(m: m)) - c, e_b: hi(a: m.corner, b: frame_end(m: m)) + c, t_a: m.centre - half - c, t_b: m.centre + half + c, z_a: m.mouth_z, z_b: m.mouth_z + m.body * (um(m: depth) + 1000))]
}

fn hole_edge(m: OutletMount) -> Int { m.corner + m.run * um(m: delta_bfb1012m_outlet_side_hole.from_outlet_corner) }
fn hole_z(m: OutletMount) -> Int { m.mouth_z + m.body * um(m: delta_bfb1012m_outlet_side_hole.from_outlet_edge) }

// The arm's faces across the thickness: inner at the socket's clearance off the label face, outer one arm
// thickness beyond.
fn arm_inner(m: OutletMount, half: Int, clearance: Micrometer) -> Int { m.centre + label_normal(m: m) * (half + um(m: clearance)) }
fn arm_outer(m: OutletMount, half: Int, clearance: Micrometer) -> Int { arm_inner(m: m, half: half, clearance: clearance) + label_normal(m: m) * um(m: blower_lug_arm_thickness) }

// How far the arm and the screw head stand beyond the socket's outer wall on the label side: what a caller
// with something on that side (a card) must leave room for.
fn lug_arm_protrusion(wall: Micrometer) -> Int { um(m: blower_lug_arm_thickness) - um(m: wall) + um(m: blower_lug_screw_head_height) }

// How far the arm and the screw head stand beyond the housing's label face: what a caller that must keep the
// whole mount inside a height reads.
fn label_side_stack(clearance: Micrometer) -> Int { um(m: clearance) + um(m: blower_lug_arm_thickness) + um(m: blower_lug_screw_head_height) }

// The arm runs from the socket's corner end, past the frame, to the hole, flat on the label face.
fn lug_arm_adds(m: OutletMount, half: Int, clearance: Micrometer, wall: Micrometer) -> List<Primitive> {
  let margin = um(m: blower_lug_arm_margin)
  let e_start = m.corner - m.run * (um(m: clearance) + um(m: wall))
  let ti = arm_inner(m: m, half: half, clearance: clearance)
  let n = label_normal(m: m)
  let c = um(m: clearance)
  [
    mount_block(m: m, e_a: e_start, e_b: hole_edge(m: m) + m.run * margin, t_a: ti, t_b: arm_outer(m: m, half: half, clearance: clearance), z_a: m.mouth_z, z_b: hole_z(m: m) + m.body * margin),
    mount_round(m: m, diameter: um(m: blower_lug_boss_diameter), length: c, e: hole_edge(m: m), t: ti - n * c / 2, z: hole_z(m: m)),
  ]
}

fn lug_arm_cuts(m: OutletMount, half: Int, clearance: Micrometer) -> List<Primitive> {
  let ti = arm_inner(m: m, half: half, clearance: clearance)
  let to = arm_outer(m: m, half: half, clearance: clearance)
  [mount_round(m: m, diameter: um(m: blower_lug_hole_diameter), length: um(m: blower_lug_arm_thickness) + um(m: clearance) + 2000, e: hole_edge(m: m), t: (ti + to) / 2, z: hole_z(m: m))]
}

// THE SCREW, as the part that mates the arm's hole: its core is the hole it taps, and it runs from the arm's
// outer face through the arm and the boss into the lug.
fn lug_screw_part(m: OutletMount, half: Int, clearance: Micrometer, id: String) -> AssemblyPart {
  let n = label_normal(m: m)
  let to = arm_outer(m: m, half: half, clearance: clearance)
  let l = um(m: blower_lug_screw_length)
  part(id: id, name: "M5 x 10 fan screw, self-tapping into the blower's lug", kind: Metal, scope: FixedFrame,
    adds: [mount_round(m: m, diameter: um(m: blower_lug_hole_diameter), length: l, e: hole_edge(m: m), t: to - n * l / 2, z: hole_z(m: m))],
    cuts: [], x: 0, y: 0, z: 0, ex: 0, ey: 0, ez: m.body * 30000, plane: LayOnXY,
    notes: "Purchased hardware: the operator's M5 x 10 fan screw (head 5.66 mm across, 1.09 mm high), shown at the core of the hole it taps.")
}

// The housing's bounding box, for a caller's envelope part: the edge is the housing's depth edge (the outlet's,
// extdeps.fans.delta delta_bfb1012m_outlet), and the body rises the housing's length from the mouth.
fn housing_box(m: OutletMount, half: Int, edge_length: Micrometer, rise: Micrometer) -> Primitive {
  mount_block(m: m, e_a: m.corner, e_b: m.corner + m.run * um(m: edge_length), t_a: m.centre - half, t_b: m.centre + half, z_a: m.mouth_z, z_b: m.mouth_z + m.body * um(m: rise))
}

fn outlet_mount_note() -> String {
  join(["Push the blower's outlet into the socket, label face against the arm, then drive one M5 x 10 fan screw through the arm's hole into the blower's lug (the hole ",
    to_string(value: um(m: delta_bfb1012m_outlet_side_hole.from_outlet_edge) / 1000), " mm up from the outlet). It cuts its own thread; stop when the head seats."], "")
}
