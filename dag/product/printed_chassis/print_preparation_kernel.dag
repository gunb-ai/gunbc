module product.printed_chassis.print_preparation_kernel
import std.types {String}
import std.dissolution {DissolutionCondition}
import product.printing.deposited_geometry {deposited_geometry_source, printed_chassis_python_kernel_dissolve_on}
import product.printed_chassis.review_realization {print_pose_kernel_source}

// Host geometry/archive/G-code adapter. It consumes modeled placements, envelope,
// expected instances and process constraints; no board geometry is authored here.
// Called only by print_preparation, never an operator-maintained script.
fn python_kernel_dissolve_on() -> DissolutionCondition { printed_chassis_python_kernel_dissolve_on }
fn source() -> String {join([
 deposited_geometry_source(),
 print_pose_kernel_source(),
 "import json, pathlib, zipfile, hashlib, math, re, collections\n" ,
 "import xml.etree.ElementTree as ET\n" ,
 "\n" ,
 "def pack_plate(cad, rows, output, envelope, settings, edge_allowance_um):\n" ,
 "    import cadquery as cq\n" ,
 "    assert settings['brim_type'] in ('no_brim','outer_only'), 'Unmodeled brim type'\n" ,
 "    reach=edge_allowance_um/1000+(0 if settings['brim_type']=='no_brim' else float(settings['brim_width']))\n" ,
 "    manifest_bytes=(pathlib.Path(cad)/'assembly.json').read_bytes()\n" ,
 "    manifest=json.loads(manifest_bytes)\n" ,
 "    step_hashes=\{\}\n" ,
 "    known=\{p['id']:p for p in manifest['parts']\}\n" ,
 "    assert rows and len(\{r['id'] for r in rows\})==len(rows), 'Empty/duplicate instances'\n" ,
 "    shapes=[]\n" ,
 "    for row in rows:\n" ,
 "        assert row['id'] in known and known[row['id']]['kind']=='printed', 'Unknown or purchased instance'\n" ,
 "        step=pathlib.Path(cad)/(row['id']+'.step')\n" ,
 "        step_hashes[row['id']]=hashlib.sha256(step.read_bytes()).hexdigest()\n" ,
 "        assert step_hashes[row['id']]==known[row['id']]['step_sha256'], 'Checked CAD artifact changed'\n" ,
 "        shape=cq.importers.importStep(str(step)).val()\n" ,
 "        assert shape.isValid() and shape.Volume()>0 and len(shape.Solids())==1\n" ,
 "        shape=posed(shape,known[row['id']]['print_pose'])\n" ,
 "        for axis, angle in zip(((1,0,0),(0,1,0),(0,0,1)),row['rotation_degrees']):\n" ,
 "            assert type(angle) is int and math.isfinite(angle)\n" ,
 "            if angle:shape=shape.rotate((0,0,0),axis,angle)\n" ,
 "        b=shape.BoundingBox();x,y=row['minimum_xy_um'];shape=shape.translate((x/1000-b.xmin,y/1000-b.ymin,-b.zmin))\n" ,
 "        b=shape.BoundingBox()\n" ,
 "        assert min(b.xmin,b.ymin,b.zmin)>=-1e-6 and all(a<=b+1e-6 for a,b in zip((b.xmax,b.ymax,b.zmax),envelope)), 'Plate exceeds bed'\n" ,
 "        assert min(b.xmin,b.ymin)>=reach-1e-6 and b.xmax<=envelope[0]-reach+1e-6 and b.ymax<=envelope[1]-reach+1e-6, 'Part with its brim exceeds the bed edge allowance'\n" ,
 "        shapes.append(shape)\n" ,
 "    for i,a in enumerate(shapes):\n" ,
 "        for b in shapes[i+1:]:assert a.intersect(b).Volume()<1e-6, 'Packed solid collision'\n" ,
 "    model=ET.Element('model',xmlns='http://schemas.microsoft.com/3dmanufacturing/core/2015/02',unit='millimeter')\n" ,
 "    resources=ET.SubElement(model,'resources');build=ET.SubElement(model,'build')\n" ,
 "    for index,(shape,row) in enumerate(zip(shapes,rows),1):\n" ,
 "        obj=ET.SubElement(resources,'object',id=str(index),type='model',name=row['id']);mesh=ET.SubElement(obj,'mesh');vs=ET.SubElement(mesh,'vertices');ts=ET.SubElement(mesh,'triangles')\n" ,
 "        vertices,faces=shape.tessellate(manifest['export']['linear_tolerance_um']/1000,float(manifest['export']['angular_tolerance_radians']))\n" ,
 "        for v in vertices:ET.SubElement(vs,'vertex',**dict(zip(('x','y','z'),map(str,v.toTuple()))))\n" ,
 "        for a,b,c in faces:ET.SubElement(ts,'triangle',v1=str(a),v2=str(b),v3=str(c))\n" ,
 "        ET.SubElement(build,'item',objectid=str(index))\n" ,
 "    with zipfile.ZipFile(output,'x',zipfile.ZIP_DEFLATED) as z:\n" ,
 "        z.writestr('3D/3dmodel.model',ET.tostring(model,encoding='utf-8',xml_declaration=True))\n" ,
 "        z.writestr('[Content_Types].xml','<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"model\" ContentType=\"application/vnd.ms-package.3dmanufacturing-3dmodel+xml\"/></Types>')\n" ,
 "        z.writestr('_rels/.rels','<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Target=\"/3D/3dmodel.model\" Id=\"rel0\" Type=\"http://schemas.microsoft.com/3dmanufacturing/2013/01/3dmodel\"/></Relationships>')\n" ,
 "\n" ,
 "    pathlib.Path(str(output)+'.cad-binding.json').write_text(json.dumps(dict(cad_manifest_sha256=hashlib.sha256(manifest_bytes).hexdigest(),steps=step_hashes,poses=dict((r['id'],known[r['id']]['print_pose']) for r in rows),placements=rows,pack_program_sha256=hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest()),indent=2)+'\\n')\n" ,
 "\n" ,
 "def sliced_instances(archive):\n",
 "    core='\{http://schemas.microsoft.com/3dmanufacturing/core/2015/02\}';path_key='\{http://schemas.microsoft.com/3dmanufacturing/production/2015/06\}path'\n",
 "    def matrix(t):\n",
 "        v=list(map(float,(t or '1 0 0 0 1 0 0 0 1 0 0 0').split()));assert len(v)==12 and all(math.isfinite(x) for x in v), 'Malformed 3MF transform'\n",
 "        return [[v[0],v[3],v[6]],[v[1],v[4],v[7]],[v[2],v[5],v[8]]]\n",
 "    def objects(root):return dict((o.attrib['id'],o) for o in root.iter(core+'object'))\n",
 "    def mesh(o):\n",
 "        m=o.find(core+'mesh');assert m is not None, 'A sliced object has no mesh'\n",
 "        vs=[tuple(float(v.attrib[k]) for k in 'xyz') for v in m.iter(core+'vertex')]\n",
 "        return vs,[tuple(int(t.attrib[k]) for k in ('v1','v2','v3')) for t in m.iter(core+'triangle')]\n",
 "    root=ET.fromstring(archive.read('3D/3dmodel.model'));top=objects(root)\n",
 "    settings=ET.fromstring(archive.read('Metadata/model_settings.config'))\n",
 "    names=dict((o.attrib['id'],[m.attrib['value'] for m in o.findall('metadata') if m.attrib.get('key')=='name']) for o in settings.findall('object'))\n",
 "    out=dict()\n",
 "    for item in root.iter(core+'item'):\n",
 "        oid=item.attrib['objectid'];assert len(names.get(oid,[]))==1, 'A sliced object is unnamed'\n",
 "        name=names[oid][0];assert name not in out, 'A part is placed twice'\n",
 "        linear=matrix(item.get('transform'));o=top[oid];parts=list(o.iter(core+'component'))\n",
 "        if parts:\n",
 "            assert len(parts)==1, 'A multi-volume sliced object is not modeled'\n",
 "            c=parts[0];source=ET.fromstring(archive.read(c.attrib[path_key].lstrip('/'))) if path_key in c.attrib else root\n",
 "            inner=matrix(c.get('transform'));linear=[[sum(linear[i][k]*inner[k][j] for k in range(3)) for j in range(3)] for i in range(3)];o=objects(source)[c.attrib['objectid']]\n",
 "        out[name]=(linear,)+mesh(o)\n",
 "    return out\n",
 "\n",
 "def pose_conformance(project, cad, rows, tolerance_um):\n",
 "    import cadquery as cq\n",
 "    from OCP.Bnd import Bnd_Box\n",
 "    from OCP.BRepBndLib import BRepBndLib\n",
 "    def bounds(shape):\n",
 "        box=Bnd_Box();BRepBndLib.AddOptimal_s(shape.wrapped,box,False,False);return box.Get()\n",
 "    tol=tolerance_um/1000\n",
 "    known=dict((p['id'],p) for p in json.loads((pathlib.Path(cad)/'assembly.json').read_bytes())['parts'])\n",
 "    with zipfile.ZipFile(project) as archive:instances=sliced_instances(archive)\n",
 "    assert sorted(instances)==sorted(r['id'] for r in rows), 'Sliced instances differ from the plate plan'\n",
 "    report=dict()\n",
 "    for row in rows:\n",
 "        part=known[row['id']];linear,vertices,triangles=instances[row['id']]\n",
 "        assert abs(linear[2][2]-1)<1e-6 and all(abs(linear[i][2])<1e-6 and abs(linear[2][i])<1e-6 for i in (0,1)), 'Sliced instance is tilted off its print pose'\n",
 "        assert abs(linear[0][0]*linear[1][1]-linear[0][1]*linear[1][0]-1)<1e-6 and abs(linear[0][0]-linear[1][1])<1e-6 and abs(linear[0][1]+linear[1][0])<1e-6, 'Sliced instance is mirrored or scaled'\n",
 "        turn=math.degrees(math.atan2(linear[1][0],linear[0][0]))\n",
 "        step=pathlib.Path(cad)/(row['id']+'.step');assert hashlib.sha256(step.read_bytes()).hexdigest()==part['step_sha256'], 'Checked CAD artifact changed'\n",
 "        expected=posed(cq.importers.importStep(str(step)).val(),part['print_pose'])\n",
 "        for axis,angle in zip(((1,0,0),(0,1,0),(0,0,1)),row['rotation_degrees']):\n",
 "            if angle:expected=expected.rotate((0,0,0),axis,angle)\n",
 "        if turn:expected=expected.rotate((0,0,0),(0,0,1),turn)\n",
 "        points=[tuple(sum(linear[i][k]*v[k] for k in range(3)) for i in range(3)) for v in vertices]\n",
 "        lo=[min(p[i] for p in points) for i in range(3)];hi=[max(p[i] for p in points) for i in range(3)];b=bounds(expected)\n",
 "        assert all(abs((hi[i]-lo[i])-(b[i+3]-b[i]))<=tol for i in range(3)), 'Sliced instance extent differs from its posed CAD'\n",
 "        shifted=[tuple(p[i]-lo[i]+b[i] for i in range(3)) for p in points]\n",
 "        volume=abs(sum(a[0]*(c[1]*d[2]-c[2]*d[1])-a[1]*(c[0]*d[2]-c[2]*d[0])+a[2]*(c[0]*d[1]-c[1]*d[0]) for a,c,d in ((shifted[i],shifted[j],shifted[k]) for i,j,k in triangles)))/6\n",
 "        assert math.isclose(volume,expected.Volume(),rel_tol=1e-2), 'Sliced instance volume differs from its posed CAD'\n",
 "        surface=cq.Compound.makeCompound(expected.Faces());sample=shifted[::max(1,len(shifted)//400)]\n",
 "        worst=max(surface.distance(cq.Vertex.makeVertex(*p)) for p in sample)\n",
 "        assert worst<=tol, 'Sliced geometry departs from its posed CAD'\n",
 "        report[row['id']]=dict(pose=part['print_pose'],bed_turn_degrees=round(turn,6),sampled_vertices=len(sample),max_deviation_um=round(worst*1000,3),volume_mm3=round(volume,3),tolerance_um=tolerance_um)\n",
 "    return report\n",
 "\n",
 "def readback(project, expected, settings, envelope, no_support, allowed_warnings, edge_allowance_um):\n" ,
 "    payload=pathlib.Path(project).read_bytes()\n" ,
 "    with zipfile.ZipFile(project) as archive:\n" ,
 "        names=archive.namelist();g,actual=read_process_archive(archive)\n",
 "        assert all(actual.get(k)==v for k,v in settings.items()), 'Sliced settings mismatch'\n" ,
 "        assert json.loads(archive.read('Metadata/plate_1.json'))['filament_ids']==[0], 'AMS mapping mismatch'\n" ,
 "        meta=ET.fromstring(archive.read('Metadata/slice_info.config'))\n" ,
 "        objects=meta.findall('.//object');assert sorted(e.attrib['name'] for e in objects)==sorted(expected), 'Sliced instance membership mismatch'\n" ,
 "        assert all(e.attrib.get('skipped')=='false' for e in objects)\n" ,
 "        values=\{e.attrib['key']:e.attrib['value'] for e in meta.findall('.//plate/metadata')\};assert values['outside']=='false'\n" ,
 "        warnings=[e.attrib for e in meta.findall('.//warning')];assert all(w['msg'] in allowed_warnings for w in warnings), 'Unreviewed slicer warning'\n" ,
 "        for name in names:\n" ,
 "            if name.endswith('.model'):\n" ,
 "                root=ET.fromstring(archive.read(name));assert root.attrib.get('unit','millimeter')=='millimeter'\n" ,
 "                for elem in root.iter():\n" ,
 "                    if 'transform' in elem.attrib:\n" ,
 "                        v=list(map(float,elem.attrib['transform'].split()));assert len(v)==12 and all(math.isfinite(x) for x in v)\n" ,
 "                        assert all(abs(sum(v[i*3+k]*v[j*3+k] for k in range(3))-(i==j))<1e-6 for i in range(3) for j in range(3)), 'Scaling transform'\n" ,
 "        paths=toolpaths(g.decode())\n" ,
 "        for i,maximum in enumerate(envelope):\n" ,
 "            margin=edge_allowance_um/1000 if i<2 else 0\n" ,
 "            assert paths['bounds'][i]>=margin-1e-6 and paths['bounds'][i+3]<=maximum-margin+1e-6, 'Deposited toolpath exceeds envelope'\n" ,
 "        assert all(paths['supports'].get(i,0)==0 for i in no_support), 'Support in a support-free functional part'\n" ,
 "        return dict(project_sha256=hashlib.sha256(payload).hexdigest(),objects=expected,seconds=int(values['prediction']),grams=float(values['weight']),paths=paths,sliced_project_settings=actual,support_fraction=sum(paths['supports'].values())/sum(paths['extrusion'].values()),warnings=warnings)\n",
 "def read_process_archive(archive):\n",
 "    names=archive.namelist();assert len(set(names))==len(names) and archive.testzip() is None\n",
 "    assert [n for n in names if re.fullmatch(r'Metadata/plate_\\d+\\.gcode',n)]==['Metadata/plate_1.gcode'], 'Expected exactly one physical plate'\n",
 "    g=archive.read('Metadata/plate_1.gcode');assert hashlib.md5(g).hexdigest()==archive.read('Metadata/plate_1.gcode.md5').decode().strip().lower()\n",
 "    actual=json.loads(archive.read('Metadata/project_settings.config'))\n",
 "    return g,actual\n",
 "\n" ,
 "def observe_archived_process(project):\n",
 "    payload=pathlib.Path(project).read_bytes()\n" ,
 "    with zipfile.ZipFile(project) as archive:g,settings=read_process_archive(archive)\n",
 "    paths=toolpaths(g.decode())\n",
 "    return dict(schema='gunbc.archived-print-process.v1',project_sha256=hashlib.sha256(payload).hexdigest(),reader_program_sha256=hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest(),standing='retrospective observation only; does not authorize a print',sliced_project_settings=settings,object_bounds=paths['object_bounds'],process_observation=paths['process_observation'])\n",
])}
