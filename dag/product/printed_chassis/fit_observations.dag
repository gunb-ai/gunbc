module product.printed_chassis.fit_observations
import std.types {String,Bool}
import std.claim_evidence {RecordedFact,EvidenceProvenance}

type FanFitProposition { original_plate_accepts_fan: Bool }
data rear_fan_fit: RecordedFact<FanFitProposition> = RecordedFact {
 id:"rear-fan-plate-fit-2026-10-04",value:FanFitProposition {original_plate_accepts_fan:true},
}
data rear_fan_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/rear-fan-fit-2026-10-04",activity:"unpowered-fan-plate-fit",agent:"operator",
}
// This qualitative observation establishes the original plate/fan pairing only. It
// supplies no measured length, thread, load, guard rating or new-frame fit evidence.
fn fan_fit_display() -> String {
 if rear_fan_fit.value.original_plate_accepts_fan {"Operator reports the original printed rear fan plate fits (4 October 2026). The revised frame/guard stack remains proposed; no further gauge sequence."} else {"Original plate fit not established."}
}

// THE PLUG FIT RING FITS. Recorded 2026-10-26 by the operator, after the ring printed out-of-band
// (artifacts/printing/a16-plug-fit-ring/manual-start-2026-10-26.json). This is the fact the fit ring was
// printed to produce: it says the MEASURED END FACE -- product.printed_chassis.gpu_duct a16_end_face, the
// caliper record every duct dimension is derived from -- is a usable datum on a real card, because a ring
// machined from it seats on the card. What it does NOT establish: any length, the duct's route, the
// blower's fit, or clearance to anything in the chassis. It is one part on one card, reported by hand.
type PlugFitRingProposition { ring_seats_on_a16: Bool }
data plug_fit_ring_fit: RecordedFact<PlugFitRingProposition> = RecordedFact {
 id:"a16-plug-fit-ring-fit-2026-10-26",value:PlugFitRingProposition {ring_seats_on_a16:true},
}
data plug_fit_ring_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/a16-plug-fit-ring-fit-2026-10-26",activity:"manual-print-and-hand-fit",agent:"operator",
}
fn plug_fit_ring_fit_display() -> String {
 if plug_fit_ring_fit.value.ring_seats_on_a16 {"Operator reports the printed A16 plug fit ring fits (26 October 2026), which confirms the measured end face and the plug/flange geometry as a datum. No length, duct route, blower fit or chassis clearance follows from it."} else {"Plug fit ring fit not established."}
}

// THE A2 ROW FIT PLATE, printed 2026-11-02 (product.printed_chassis.group_duct, root a2-altra-row-fit-plate,
// 3MF sha256 5c8689985eb3d1ae87facdfc901c0cd74748ebd527e3f26f1a5300128bb8e539, printer-02). Operator: "it fits
// okay" -- it went over the four card ends, so the installed separation and the read openings are the right
// datum -- "it kind of seems like it's a bit too loose over the pieces in general", and the top band tab "is
// hitting" the band's slope, "so the top side does not sit fully flush". The tabs were thin blades placed by
// the band's length alone, before the taper's shape was read; the lip had the unqualified 0.3 mm sleeve
// allowance. Neither is a qualified figure, and this observation is what the next plate answers to.
type GroupFitPlateProposition { plate_goes_over_the_row: Bool, lip_too_loose: Bool, top_tabs_seat_flush: Bool }
data a2_row_fit_plate_fit: RecordedFact<GroupFitPlateProposition> = RecordedFact {
 id:"a2-row-fit-plate-fit-2026-11-02",value:GroupFitPlateProposition {plate_goes_over_the_row:true,lip_too_loose:true,top_tabs_seat_flush:false},
}
data a2_row_fit_plate_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/a2-row-fit-plate-fit-2026-11-02",activity:"manual-print-and-hand-fit",agent:"operator",
}
// THE SECOND A2 ROW FIT PLATE, printed 2026-11-02 on printer-02 after the first plate's reading: the lip at
// 0.1 mm and each band tab cut as the band's whole section, reaching to within 0.3 mm of the expected first
// fin. Operator, 2026-11-03: "the lip seems okay", and "one of the triangles hits the fins, so something is a
// bit off - i'm not sure i got the slope/face measurements right". So the lip allowance holds, and a tab
// placed within a fraction of a millimetre of the fins by the band readings does not; which reading is off is
// not established.
type GroupFitPlateSecondProposition { lip_fits: Bool, band_tabs_clear_fins: Bool }
data a2_row_fit_plate_second_fit: RecordedFact<GroupFitPlateSecondProposition> = RecordedFact {
 id:"a2-row-fit-plate-fit-2026-11-03",value:GroupFitPlateSecondProposition {lip_fits:true,band_tabs_clear_fins:false},
}
data a2_row_fit_plate_second_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/a2-row-fit-plate-fit-2026-11-03",activity:"manual-print-and-hand-fit",agent:"operator",
}
fn a2_row_fit_plate_fit_display() -> String {
 let v=a2_row_fit_plate_fit.value
 let w=a2_row_fit_plate_second_fit.value
 join([if v.plate_goes_over_the_row {"The first A2 row fit plate went over all four card ends (2 November 2026): the installed separation and the read openings hold as the datum."} else {"The first A2 row fit plate did not go over the row."},
  if v.lip_too_loose {" Its lip was loose at the 0.3 mm allowance, so the lip clearance is tightened."} else {""},
  if v.top_tabs_seat_flush {""} else {" Its thin band tabs struck the band slope and kept the top from seating, so the tabs follow the read band taper."},
  if w.lip_fits {" The second plate's 0.1 mm lip fits (3 November 2026)."} else {" The second plate's 0.1 mm lip does not fit."},
  if w.band_tabs_clear_fins {""} else {" Its band tabs, each the band's whole section to within 0.3 mm of the first fin, struck the fins at one end, so the tabs now grip only the start of the slope, well clear of the fins."}],"")
}
