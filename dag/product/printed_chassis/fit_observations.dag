module product.printed_chassis.fit_observations
import std.types {String,Bool,List,NonEmptyStr,Int}
import std.measure {Micrometer,micrometer}
import extdeps.standards.motherboard_mounting_location {MountingLocationId,LocB,LocC,LocF,LocH,LocL,LocM,LocR}
import std.claim_evidence {RecordedFact,EvidenceProvenance}

type FanFitProposition { original_plate_accepts_fan: Bool }
data rear_fan_fit: RecordedFact<FanFitProposition> = RecordedFact {
 id:"rear-fan-plate-fit-2026-10-04",value:FanFitProposition {original_plate_accepts_fan:true},
}
data rear_fan_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/rear-fan-fit-2026-10-04",activity:"unpowered-fan-plate-fit",agent:"operator",
}
// This qualitative observation establishes the original plate/fan pairing only. It
// supplies no measured length, thread, load, guard rating or new-frame fit evidence.
fn fan_fit_display() -> String {
 if rear_fan_fit.value.original_plate_accepts_fan {"Operator reports the original printed rear fan plate fits (4 October 2026). The revised frame/guard stack remains proposed; no further gauge sequence."} else {"Original plate fit not established."}
}

// THE PLUG FIT RING FITS. Recorded 2026-10-26 by the operator, after the ring printed out-of-band
// (artifacts/printing/a16-plug-fit-ring/manual-start-2026-10-26.json). This is the fact the fit ring was
// printed to produce: it says the MEASURED END FACE -- product.printed_chassis.gpu_duct a16_end_face, the
// caliper record every duct dimension is derived from -- is a usable datum on a real card, because a ring
// machined from it seats on the card. What it does NOT establish: any length, the duct's route, the
// blower's fit, or clearance to anything in the chassis. It is one part on one card, reported by hand.
// Nor the screws: the ring was printed with 3.4 mm holes for M3, and on 2026-11-10 the operator found M3
// does not go into the inserts (product.printed_chassis.card_end_interface a16_insert_thread); the seating
// surfaces this fact is about are unchanged by the move to M2.5 holes.
type PlugFitRingProposition { ring_seats_on_a16: Bool }
data plug_fit_ring_fit: RecordedFact<PlugFitRingProposition> = RecordedFact {
 id:"a16-plug-fit-ring-fit-2026-10-26",value:PlugFitRingProposition {ring_seats_on_a16:true},
}
data plug_fit_ring_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/a16-plug-fit-ring-fit-2026-10-26",activity:"manual-print-and-hand-fit",agent:"operator",
}
fn plug_fit_ring_fit_display() -> String {
 if plug_fit_ring_fit.value.ring_seats_on_a16 {"Operator reports the printed A16 plug fit ring fits (26 October 2026), which confirms the measured end face and the plug/flange geometry as a datum. No length, duct route, blower fit or chassis clearance follows from it."} else {"Plug fit ring fit not established."}
}

// THE A2 ROW FIT PLATE, printed 2026-11-02 (product.printed_chassis.group_duct, root a2-altra-row-fit-plate,
// 3MF sha256 5c8689985eb3d1ae87facdfc901c0cd74748ebd527e3f26f1a5300128bb8e539, printer-02). Operator: "it fits
// okay" -- it went over the four card ends, so the installed separation and the read openings are the right
// datum -- "it kind of seems like it's a bit too loose over the pieces in general", and the top band tab "is
// hitting" the band's slope, "so the top side does not sit fully flush". The tabs were thin blades placed by
// the band's length alone, before the taper's shape was read; the lip had the unqualified 0.3 mm sleeve
// allowance. Neither is a qualified figure, and this observation is what the next plate answers to.
type GroupFitPlateProposition { plate_goes_over_the_row: Bool, lip_too_loose: Bool, top_tabs_seat_flush: Bool }
data a2_row_fit_plate_fit: RecordedFact<GroupFitPlateProposition> = RecordedFact {
 id:"a2-row-fit-plate-fit-2026-11-02",value:GroupFitPlateProposition {plate_goes_over_the_row:true,lip_too_loose:true,top_tabs_seat_flush:false},
}
data a2_row_fit_plate_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/a2-row-fit-plate-fit-2026-11-02",activity:"manual-print-and-hand-fit",agent:"operator",
}
// THE SECOND A2 ROW FIT PLATE, printed 2026-11-02 on printer-02 after the first plate's reading: the lip at
// 0.1 mm and each band tab cut as the band's whole section, reaching to within 0.3 mm of the expected first
// fin. Operator, 2026-11-03: "the lip seems okay", and "one of the triangles hits the fins, so something is a
// bit off - i'm not sure i got the slope/face measurements right". So the lip allowance holds, and a tab
// placed within a fraction of a millimetre of the fins by the band readings does not; which reading is off is
// not established.
type GroupFitPlateSecondProposition { lip_fits: Bool, band_tabs_clear_fins: Bool }
data a2_row_fit_plate_second_fit: RecordedFact<GroupFitPlateSecondProposition> = RecordedFact {
 id:"a2-row-fit-plate-fit-2026-11-03",value:GroupFitPlateSecondProposition {lip_fits:true,band_tabs_clear_fins:false},
}
data a2_row_fit_plate_second_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/a2-row-fit-plate-fit-2026-11-03",activity:"manual-print-and-hand-fit",agent:"operator",
}
// THE THIRD A2 ROW FIT PLATE, printed 2026-11-03 on printer-02 (3MF sha256 ad2599f674af9a6bfb6379e30b6ea1ee9a4af55e9ef69b6332e29885e029ddbf),
// its tabs gripping only the first 1.5 mm of each band's slope. Operator, 2026-11-04: "the a2 plate fits okay,
// but its still not resting totally flat on the back of the fan" (the plate's face side; no fan is fitted).
// The tabs were the only part that entered a face; which tab held the plate off is not established.
type GroupFitPlateThirdProposition { fits_row: Bool, rests_flat: Bool }
data a2_row_fit_plate_third_fit: RecordedFact<GroupFitPlateThirdProposition> = RecordedFact {
 id:"a2-row-fit-plate-fit-2026-11-04",value:GroupFitPlateThirdProposition {fits_row:true,rests_flat:false},
}
data a2_row_fit_plate_third_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/a2-row-fit-plate-fit-2026-11-04",activity:"manual-print-and-hand-fit",agent:"operator",
}
fn a2_row_fit_plate_fit_display() -> String {
 let v=a2_row_fit_plate_fit.value
 let w=a2_row_fit_plate_second_fit.value
 let x=a2_row_fit_plate_third_fit.value
 join([if v.plate_goes_over_the_row {"The first A2 row fit plate went over all four card ends (2 November 2026): the installed separation and the read openings hold as the datum."} else {"The first A2 row fit plate did not go over the row."},
  if v.lip_too_loose {" Its lip was loose at the 0.3 mm allowance, so the lip clearance is tightened."} else {""},
  if v.top_tabs_seat_flush {""} else {" Its thin band tabs struck the band slope and kept the top from seating, so the tabs follow the read band taper."},
  if w.lip_fits {" The second plate's 0.1 mm lip fits (3 November 2026)."} else {" The second plate's 0.1 mm lip does not fit."},
  if w.band_tabs_clear_fins {""} else {" Its band tabs, each the band's whole section to within 0.3 mm of the first fin, struck the fins at one end, so the tabs were cut to grip only the start of the slope."},
  if x.fits_row {" The third plate fits the row (4 November 2026)"} else {" The third plate does not fit the row"},
  if x.rests_flat {"."} else {" but does not rest flat on the faces, so the tabs are removed and a deeper sleeve holds the plate."}],"")
}

// THE RECEIVED DELTA BFB1012M, read by the operator on 2026-11-04 with four units in hand. The intake is on one
// face only, the face WITHOUT the label. The lug around the hole nearer the outlet is flush with the label face.
// Held with the label toward the reader and the outlet pointing down, the outlet is at the RIGHT end of the
// bottom edge. That hole's centre is 28 mm along the edge past the end of the outlet mouth and 18 mm up from
// the outlet edge, which is the datasheet's hole (extdeps.fans.delta delta_bfb1012m_outlet_side_hole) to 0.1 mm.
// Read by product.printed_chassis.blower_outlet_mount, which mounts the blower by that hole from the label face.
type ReceivedBlowerProposition { intake_only_on_unlabelled_face: Bool, side_hole_lug_flush_with_label_face: Bool, outlet_at_right_with_label_toward_reader_and_outlet_down: Bool }
data bfb1012m_received_reading: RecordedFact<ReceivedBlowerProposition> = RecordedFact {
 id:"bfb1012m-received-reading-2026-11-04",value:ReceivedBlowerProposition {intake_only_on_unlabelled_face:true,side_hole_lug_flush_with_label_face:true,outlet_at_right_with_label_toward_reader_and_outlet_down:true},
}
data bfb1012m_received_reading_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/bfb1012m-received-reading-2026-11-04",activity:"caliper-reading-of-received-units",agent:"operator",
}

// THE ALTRA FIT GAUGES SEAT. Operator, 2026-11-05: "yes all the gauges are fine, we have the altra holes
// modeled correctly already" -- the F-C gauge (product.printed_chassis.standoff_gauge altrad8ud_standoff_gauge)
// and the five follow-on pairs (product.printed_chassis.fit_gauges follow_on_fit_gauge_pairs), all printed and
// tried on the board in hand. What this establishes: every gauged hole is present on that board, and every
// gauged pair's spacing holds. What it does not: the whole map's relative angles (fit_gauges records that the
// connected pairs do not fix them), the board's hole diameter, standoff height or any underside clearance.
// Mounting the board on a tray discharges those (extdeps.boards.asrock_rack asrock_altrad8ud_open_mounting_unknowns).
// THE EXPERIMENT SUBJECT IS RECORDED WITH THE RESULT (review 5789345655). A report that "every gauge seats"
// confirms only the gauges that were printed and tried, so the record names each one: its two locations, the
// coordinates its holes were cut at, and the hole diameter. These are the declarations the gauges were
// generated from -- the F-C gauge (standoff_gauge altrad8ud_standoff_gauge) and the five follow-on pairs
// (fit_gauges follow_on_fit_gauge_pairs) over extdeps.standards.micro_atx's coordinates, none of which has
// changed since 2026-09-02 (the pairs and gauge only moved file in the 2026-10-12 source-layout cutover). The
// consumer (product.printed_chassis.board_mechanical_reference fit_confirmation_for) compares this record
// against the CURRENT gauge declarations and refuses on any difference, so a gauge moved, added or re-cut
// later never inherits this fit.
type FittedGauge {
 name:NonEmptyStr,a:MountingLocationId,a_along:Micrometer,a_depth:Micrometer,
 b:MountingLocationId,b_along:Micrometer,b_depth:Micrometer,hole_diameter:Micrometer
}
fn fitted(name:NonEmptyStr,a:MountingLocationId,aa:Int,ad:Int,b:MountingLocationId,ba:Int,bd:Int) -> FittedGauge {
 FittedGauge {name:name,a:a,a_along:micrometer(count:aa),a_depth:micrometer(count:ad),b:b,b_along:micrometer(count:ba),b_depth:micrometer(count:bd),hole_diameter:micrometer(count:3962)}
}
type AltraFitGaugeSetProposition { every_gauge_seats: Bool, gauges: List<FittedGauge> }
data altra_fit_gauge_set_fit: RecordedFact<AltraFitGaugeSetProposition> = RecordedFact {
 id:"altra-fit-gauge-set-fit-2026-11-05",value:AltraFitGaugeSetProposition {every_gauge_seats:true,gauges:[
  fitted(name:"F-C",a:LocF,aa:6350,ad:33020,b:LocC,ba:163830,bd:10160),
  fitted(name:"C-B",a:LocC,aa:163830,ad:10160,b:LocB,ba:209550,bd:10160),
  fitted(name:"C-H",a:LocC,aa:163830,ad:10160,b:LocH,ba:163830,bd:165100),
  fitted(name:"H-L",a:LocH,aa:163830,ad:165100,b:LocL,ba:163830,bd:237490),
  fitted(name:"L-M",a:LocL,aa:163830,ad:237490,b:LocM,ba:6350,bd:237490),
  fitted(name:"H-R",a:LocH,aa:163830,ad:165100,b:LocR,ba:229870,bd:165100)]},
}
data altra_fit_gauge_set_fit_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/altra-fit-gauge-set-fit-2026-11-05",activity:"manual-print-and-hand-fit",agent:"operator",
}

// THE R06 ALTRA CASSETTE, PRINTED. Operator, 2026-11-05: "the print was fine"; the tray "had no actual
// standoffs", and "we need to have space cut out for the backplate of the socket because it gets hot". So the
// r06 panels print as generated, and the next revision owes the two features r06 never carried: standoffs at
// the board's holes, and an opening under the socket's retention backplate. No board was mounted on it, so
// nothing here reads a fit of the board to the tray.
type CassetteR06PrintProposition { printed_without_defect: Bool, carries_board_standoffs: Bool, clears_socket_backplate: Bool }
data cassette_r06_print: RecordedFact<CassetteR06PrintProposition> = RecordedFact {
 id:"cassette-r06-print-2026-11-05",value:CassetteR06PrintProposition {printed_without_defect:true,carries_board_standoffs:false,clears_socket_backplate:false},
}
data cassette_r06_print_provenance: EvidenceProvenance = EvidenceProvenance {
 entity:"operator-conversation/cassette-r06-print-2026-11-05",activity:"manual-print-and-inspection",agent:"operator",
}
fn cassette_r06_print_display() -> String {
 let v=cassette_r06_print.value
 join([if v.printed_without_defect {"Operator reports the r06 tray printed without defect (5 November 2026)."} else {"The r06 tray did not print cleanly."},
  if v.carries_board_standoffs {""} else {" It carries no board standoffs, so the board cannot be fastened to it."},
  if v.clears_socket_backplate {""} else {" It has no opening under the CPU socket's retention backplate, which runs hot; the next revision owes one."}],"")
}
