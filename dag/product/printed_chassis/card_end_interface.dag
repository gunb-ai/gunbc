module product.printed_chassis.card_end_interface

import std.types { Bool, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.measure { Micrometer, micrometer }
import extdeps.climbing_holds.types { FastenerThread, MetricCoarseThread, ImperialUncThread, FastenerThreadUnread }
import extdeps.iso.iso_273 { m2_5_thread, m3_thread }

// ═══ WHAT A DUCT MEETS AT A CARD'S END: THE SHARED INTERFACE AND THE FEATURES ONLY SOME CARDS HAVE ═══
//
// Every passive card a duct serves presents an end face with an air opening: its outer extent, the fin
// opening at its tightest, where that opening sits, and how far the fins sit behind it. Those are what any
// duct needs. What a duct can FASTEN to or must KEEP CLEAR of differs per card: the A16's end cap has two
// threaded inserts and its 8-pin header on that face; the A2's intake end has neither. Those are features,
// and each is in exactly one of three states, because "this card has none" and "nobody has looked" are
// different facts and a duct may only rely on the first (2026-11-02, after the A2 was measured).
//
// The reading is this repository's observation of a held card, not the vendor's (product.printed_chassis
// .duct_card_catalog says why); the frame is the one the A16 was read in. Lengths along the face are from
// its TOP end; depths across it are from its BACK face.

type EndFaceFeature<V>
  = FeaturePresent { value: V }
  | FeatureAbsentObserved
  | FeatureNotObserved { read_obligation: NonEmptyStr }

fn feature_value<V>(f: EndFaceFeature<V>) -> V? {
  match f { FeaturePresent { value: v } => Present { value: v } FeatureAbsentObserved => Absent FeatureNotObserved { read_obligation: _ } => Absent }
}

// WHAT THREAD THE INSERTS TAKE, AND HOW THAT IS KNOWN. A thread is established by a screw that threads in;
// short of that, trial screws that do not fit can bracket it, and the bracket is a narrower claim: it names
// the one standard metric size between them, not a thread anyone has driven. A consumer that prints a
// clearance hole may use either, and says which in what it hands the builder.
type InsertThreadStanding
  = BracketedByTrialScrews { too_small: FastenerThread, too_large: FastenerThread, observed: NonEmptyStr }
  | ConfirmedByScrewThatThreads { observed: NonEmptyStr }

type InsertThread {
  thread: FastenerThread
  standing: InsertThreadStanding
}

fn insert_thread_standing_note(t: InsertThread) -> String {
  match t.standing {
    BracketedByTrialScrews { too_small: s, too_large: l, observed: o } =>
      join(["bracketed, not confirmed: ", thread_designation(t: s), " is too small and ", thread_designation(t: l), " too large (", o as String, "); no screw of this thread has been driven into it yet"], "")
    ConfirmedByScrewThatThreads { observed: o } => join(["confirmed by a screw that threads in (", o as String, ")"], "")
  }
}

fn thread_designation(t: FastenerThread) -> String {
  match t {
    MetricCoarseThread { designation: d } => d as String
    ImperialUncThread { designation: d } => d as String
    FastenerThreadUnread { obligation: _ } => "unread thread"
  }
}

// Two threaded inserts in the end cap, each read to its NEAR edge: top edge of the upper hole from the top
// end, bottom edge of the lower hole from the bottom end, nearest edge from the back face.
type EndCapInserts {
  thread: InsertThread
  spacing: Micrometer
  near_edge_from_back: Micrometer
  upper_near_edge_from_top: Micrometer
  lower_near_edge_from_bottom: Micrometer
}

// An auxiliary power header on the end face: its outer pin's distance from the top end.
type FaceConnector { from_top: Micrometer }

// A PLATE THAT RUNS PAST THE FACE'S ENDS: a strip parallel to the PCB (the T10's backplate) that stands proud of
// the face's top and bottom ends, so anything that closes around the face's outline at its ends -- a sleeve --
// strikes it. Read across from the back face to its near edge, its thickness, and how far it runs past each end.
type EdgeOverhang {
  near_edge_from_back: Micrometer
  thickness: Micrometer
  past_top: Micrometer
  past_bottom: Micrometer
}

type CardEndInterface {
  source: NonEmptyStr
  face_length: Micrometer
  face_thickness: Micrometer
  window_length: Micrometer
  window_depth: Micrometer
  window_from_top: Micrometer
  window_from_back: Micrometer
  fin_setback: Micrometer
  inserts: EndFaceFeature<EndCapInserts>
  connector: EndFaceFeature<FaceConnector>
  overhang: EndFaceFeature<EdgeOverhang>
}

// The features a realization would need and this reading does not supply, each named with its state. A
// realization that fastens into inserts or keeps clear of a header reads this before building anything.
fn missing_feature<V>(name: String, f: EndFaceFeature<V>) -> List<String> {
  match f {
    FeaturePresent { value: _ } => []
    FeatureAbsentObserved => [join([name, ": the card has none (observed)"], "")]
    FeatureNotObserved { read_obligation: o } => [join([name, ": not observed; ", o as String], "")]
  }
}

// ═══ THE A16, READ 2026-10-23 ═══
// Caliper readings by the operator on an A16 PG171 in hand. The window sides are pitched and the window was
// read at its tightest point.
// THE THREAD. Until 2026-11-10 the duct took the inserts as M3 x 4, credited to the operator on 2026-10-23
// (#14924); no thread reading stands behind that, and the operator reports M3 does not go in. Their trial
// screws bracket it: M2 is too small, M3 too large, so the inserts are read as M2.5, the one ISO metric
// coarse size between. The 3.0 mm bore below is the caliper reading of the opening, not a thread size.
data m2_trial_thread: FastenerThread = MetricCoarseThread { designation: "M2" }

data a16_insert_thread: InsertThread = InsertThread {
  thread: m2_5_thread,
  standing: BracketedByTrialScrews {
    too_small: m2_trial_thread,
    too_large: m3_thread,
    observed: "operator, 2026-11-10, trying an M2 and an M3 screw in a held A16's end-cap inserts",
  },
}

data a16_end_cap_inserts: EndCapInserts = EndCapInserts {
  thread: a16_insert_thread,
  spacing: micrometer(count: 27620),
  near_edge_from_back: micrometer(count: 8860),
  upper_near_edge_from_top: micrometer(count: 59720),
  lower_near_edge_from_bottom: micrometer(count: 7540),
}

data a16_face_connector: FaceConnector = FaceConnector { from_top: micrometer(count: 2560) }

data a16_card_end: CardEndInterface = CardEndInterface {
  source: "Operator caliper readings on a held A16 PG171, 2026-10-23",
  face_length: micrometer(count: 97840),
  face_thickness: micrometer(count: 38600),
  window_length: micrometer(count: 88030),
  window_depth: micrometer(count: 23940),
  window_from_top: micrometer(count: 5540),
  window_from_back: micrometer(count: 13090),
  fin_setback: micrometer(count: 6000),
  inserts: FeaturePresent { value: a16_end_cap_inserts },
  connector: FeaturePresent { value: a16_face_connector },
  overhang: FeatureNotObserved { read_obligation: "operator, on a held A16: whether any plate (the backplate, a shroud lip) runs past the end face's top or bottom end within the first 20 mm behind the face, and if so its near edge from the back face, its thickness and how far past each end" },
}

// ═══ THE A2, READ 2026-11-02 ═══
// Operator caliper readings on a held A2, intake end (opposite the bracket), with the bracket removed. The
// face's TOP end is the end away from the slot; its BACK edge is the PCB side. The opening sits 2.2 mm below
// the top and 2 mm in from the PCB-side edge, with 2 mm read on the other side too: the widths sum 0.42 mm
// short of the face because the opening's sides are pitched and it was read at its tightest, as on the A16.
// The bottom border (55.6 - 52.37 - 2.2 = 1.03 mm) was not read on its own. The fins sit about 1 mm behind
// the face ("very close, like 1 mm"), and the top and bottom 4.9 mm of the opening are tapered and fin-free.
// The taper was read after the first fit plate (operator, 2026-11-02): "a tiny lip, say about 1 mm, and then a
// sharp right angle inward; the horizontal distance until the triangle terminates into a flat plane parallel
// to the top and bottom of the card is 4 mm", and "between where that flat parallel plane sits and the first
// fin is another 1 mm". So the band's section is a right triangle with legs 4.9 mm (along the face) and 4 mm
// (into the card) behind a 1 mm lip.
// Those band readings were carried as FinFreeBands and BandTaper (this module at 4507aeaea0c2) while the fit
// plate's tabs gripped the bands. The tabs are gone and nothing else reads the bands, so the readings stay
// here as the record of what was measured, not as a field of the interface.
// The intake end has no threaded holes and no power header: the only holes are on the bracket end, and the
// card is powered from the slot (extdeps.gpu.nvidia_a2 a2_card_row auxiliary_power is the cited empty list).
data a2_card_end: CardEndInterface = CardEndInterface {
  source: "Operator caliper readings on a held A2, intake end, 2026-11-02",
  face_length: micrometer(count: 55600),
  face_thickness: micrometer(count: 18620),
  window_length: micrometer(count: 52370),
  window_depth: micrometer(count: 14200),
  window_from_top: micrometer(count: 2200),
  window_from_back: micrometer(count: 2000),
  fin_setback: micrometer(count: 1000),
  inserts: FeatureAbsentObserved,
  connector: FeatureAbsentObserved,
  // Nothing runs past the face's ends where a sleeve closes: the A2 row fit plate's sleeve went over all four
  // ends at 0.1 mm per side (product.printed_chassis.fit_observations a2_row_fit_plate_second_fit, "the lip seems
  // okay"), and the fourth plate's 20 mm sleeve held (operator, 2026-11-04).
  overhang: FeatureAbsentObserved,
}

// ═══ THE TESLA T10, READ 2026-11-16 ═══
// Operator readings on a held T10, intake end (opposite the bracket), relayed in conversation 2026-11-16; the
// face's TOP end is the end away from the slot, its BACK face the backplate side. The face is 95.70 x 18.18 mm.
// THE OPENING IS ROUGH, AND NOTHING SEALS ON IT. About half the thickness is open air channel and half is board
// and chip; the open half is on the FRONT-PLATE side. Read: "effectively" the full length "minus a few mm at
// the top and a few mm at the bottom", then "4 mm on top and bottom"; about 8 mm across ("the open space is
// 8mm"), 1 mm in from the front face ("its 1mm IIUC"), so 18.18 - 1 - 8 = 9.18 mm from the back; wide steel
// fins about 10 mm in ("its basically an empty hole - there are a few steel fins but they're wide - like 10mm
// in"). The operator: "the port shape is very odd, without a real mechanical drawing it would be too hard to
// capture", so the duct for this card is a SLEEVE around the outline and the opening only says where the
// plate is open.
// THE 8-PIN is on this face: it starts 10.2 mm below the top, in the backplate half, 4 mm in from the
// backplate; the plugged head is 19 x 12 mm with its latch flush with the face, and the cable leaves straight
// out. FaceConnector carries the near edge from the top (the A16's carries its outer pin there); the head's
// footprint is not a field because the group keep-out is cut across the face's whole thickness.
// THE BACKPLATE STRIP is 1.50 mm thick, 98.38 mm overall against the face's 95.70, "inset 2.40 mm from the back
// side", and runs 1.35 mm past the top and 1.35 mm past the bottom (as read; they sum 2.70 against the 2.68 the
// overall lengths give).
// THE END-CAP SCREW HOLES are present and are not to be used (operator: a sleeve fit holds it instead); their
// count, bore and positions were not read, so they are not given a placeholder.
data t10_face_connector: FaceConnector = FaceConnector { from_top: micrometer(count: 10200) }

data t10_backplate_overhang: EdgeOverhang = EdgeOverhang {
  near_edge_from_back: micrometer(count: 2400),
  thickness: micrometer(count: 1500),
  past_top: micrometer(count: 1350),
  past_bottom: micrometer(count: 1350),
}

data t10_card_end: CardEndInterface = CardEndInterface {
  source: "Operator readings on a held Tesla T10, intake end, 2026-11-16 (face caliper-read; the opening, its 4 mm borders, the 1 mm front wall and the 10 mm fin depth are rough readings of an irregular port)",
  face_length: micrometer(count: 95700),
  face_thickness: micrometer(count: 18180),
  window_length: micrometer(count: 87700),
  window_depth: micrometer(count: 8000),
  window_from_top: micrometer(count: 4000),
  window_from_back: micrometer(count: 9180),
  fin_setback: micrometer(count: 10000),
  inserts: FeatureNotObserved { read_obligation: "operator, on a held T10: the end-cap screw holes are present but were not read (count, bore, spacing, near edges); no T10 duct fastens to them (operator, 2026-11-16: a sleeve fit holds it instead)" },
  connector: FeaturePresent { value: t10_face_connector },
  overhang: FeaturePresent { value: t10_backplate_overhang },
}
