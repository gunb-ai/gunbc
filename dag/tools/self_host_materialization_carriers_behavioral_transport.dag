module tools.self_host_materialization_carriers_behavioral_transport

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.cargo_build
import extdeps.git
import extdeps.gunbc
import std.logic { Bool }
import tools.host_prelude { witness_bin, witness_bin_ensure_built_typed, witness_bin_release_path }

data smc_doc: String = "Wave 2 Band A (materialization_carriers self-emit): seed-linked behavioral receipt mirroring tools.self_host_discovery_enumeration_behavioral_transport. Emit v2.compiler.materialization_carriers closure via gunbc compile --entry; post-emit fixup injects v2_std_text mod + extdeps import patches; gunbc-emitted lib.rs carries the std import closure (no hand dep shims beyond v2_std_text). Seed oracle: v1_compiler::v2_compiler_materialization_carriers. Behavioral bar: cargo-green witness pairs emitted vs seed (plain + --inject-fault RED) plus claim-run on compiler_materialization_witness_test."

data smc_source_rel: String = "src/v2/compiler/materialization_carriers.dag"
data smc_test_entry_rel: String = "src/v2/test/claim/compiler_materialization_witness_test.dag"
data smc_shim_text_rel: String = "dag/tools/self_host_materialization_carriers_shims/v2_std_text.rs"
data smc_shim_driver_rel: String = "dag/tools/self_host_materialization_carriers_shims/witness_main.rs"
data smc_fixup_script_rel: String = "dag/tools/self_host_materialization_carriers_shims/emit_closure_fixup.py"
data smc_scaffold_dissolution_trigger: String = "dissolve-on: dag/tools/self_host_materialization_carriers_shims/* + smc_cargo_toml + emit_closure_fixup.py — v2_std_text shim, post-emit patch script, witness driver. DISSOLVES WHEN emit closure is self-compiling without post-emit patch and modeled harness emits comparison driver + manifest."
data smc_receipt_pass_marker: String = "SELF_HOST_MATERIALIZATION_CARRIERS_BEHAVIORAL_RECEIPT: PASS"

fn smc_repo_path(root: String, rel: String) -> String {
  concat(root, concat("/", rel))
}

fn smc_cargo_toml(root: String) -> String {
  concat(
    "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n\n[dependencies]\nim-rc = { version = \"15.1\", features = [\"serde\"] }\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\nlazy_static = \"1\"\nunicode-ident = \"1\"\nunicode-properties = { version = \"0.1\", features = [\"emoji\"] }\nv1-compiler = { path = \"",
    concat(root, "/src/v1/stage0\" }\n")
  )
}

fn smc_behavioral_receipt_holds() -> Bool {
  let root = git.Core.Toplevel()
  let module_read = Filesystem.Read(path: smc_repo_path(root: root.path, rel: smc_source_rel))
  let text_read = Filesystem.Read(path: smc_repo_path(root: root.path, rel: smc_shim_text_rel))
  let driver_read = Filesystem.Read(path: smc_repo_path(root: root.path, rel: smc_shim_driver_rel))
  let fixup_read = Filesystem.Read(path: smc_repo_path(root: root.path, rel: smc_fixup_script_rel))

  let out_dir = shell.Mktemp.Dir()
  let gunbc_built = witness_bin_ensure_built_typed(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
  let gunbc_bin = witness_bin_release_path(root: root.path, bin_name: "gunbc")
  let emit = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "compile",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", smc_source_rel,
      "--output-dir", out_dir.path,
      "--target", "rust",
      "--dependency-pool-index", "primary-precedence"
    ]
  )

  let fixup = shell.Exec.Run(
    script: concat(
      "python3 ",
      concat(smc_repo_path(root: root.path, rel: smc_fixup_script_rel), concat(" ", concat(out_dir.path, "/src")))
    )
  )

  let text_written = Filesystem.Write(path: concat(out_dir.path, "/src/v2_std_text.rs"), content: text_read.content)
  let manifest = Filesystem.Write(path: concat(out_dir.path, "/Cargo.toml"), content: smc_cargo_toml(root: root.path))
  let main_rs = Filesystem.Write(path: concat(out_dir.path, "/src/main.rs"), content: driver_read.content)

  let build = cargo.Build.BuildManifest(
    workdir: out_dir.path,
    manifest_path: concat(out_dir.path, "/Cargo.toml"),
    target_dir: concat(out_dir.path, "/target"),
    extra_args: ["--release"]
  )

  let witness_bin_path = concat(out_dir.path, "/target/release/witness")
  let pass_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path)
  let fault_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path, args: ["--inject-fault"])

  let eval_ladder = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "run", "--claim-run",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", smc_test_entry_rel,
      "--function", "compiler_materialization_ladder_holds"
    ]
  )

  let cleanup_out = shell.Remove.RecursiveForce(path: out_dir.path)

  module_read.success
    && text_read.success && driver_read.success && fixup_read.success
    && out_dir.success && gunbc_built && emit.success
    && fixup.success
    && text_written.success
    && manifest.success && main_rs.success
    && build.success
    && pass_run.success && string_contains(s: pass_run.stdout, pattern: smc_receipt_pass_marker)
    && (fault_run.success == false)
    && eval_ladder.success
    && cleanup_out.success
}
