module tools.self_host_curated_seed_linked_harness

import std.dissolution { DissolutionCondition, dissolution_description, unbound_dissolution }

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.cargo_build
import extdeps.git
import extdeps.git.inspect
import extdeps.gunbc
import std.logic { Bool }
import v2.std.algebra { fold_list, length }
import v2.std.collection { List }
import v2.std.text { String }
import tools.host_prelude { witness_bin, witness_bin_ready, witness_bin_release_path }

data cssl_doc: String = "Reusable curated seed-linked self-host harness (Wave 2 easy-flip lane): factors the duplicated emit->shim-assemble->cargo->witness(fault) spine shared by Band A behavioral transports. Probe lane consumes only cssl_v1_compiled_probe_lib_cargo_toml via tools.self_host_curated_probe_cargo. Curated = gunbc emit must succeed, then seed-retained dep shims + shim lib.rs replace the emitted closure so the entry module rustc-links against v1-compiler without waiting for full std self-emit or emitter Track-B body fixes. Each module lane supplies its own shim file paths, witness driver, pass marker, and zero or more supplementary claim-runs. Empty shim_lib_rel = keep gunbc-emitted lib.rs (runtime closure only). Empty claim_runs = skip supplementary claim-runs. LANDED: the per-module copy-paste this note names is dissolved by tools.self_host_module_behavioral_transport_roster — one config row per frontier module, one generic compiler_module_behavioral_receipt_for(module_path) dispatch, this kernel unchanged as the sole executor."

data cssl_cargo_features_note: String = "Mirrors slb_cargo_features_note: text_lookup_work_counter feature declared for -D warnings consumers."

data cssl_std_seed_link_followup_note: String = "LANDED (2026-07-17): generic seed-shim closure assembly via cssl_assemble bin + cssl_seed_linked_closure_assembly.rs (typed Refused final arm; explicit dag/std · lens · peripheral emit-retain). Former assembly Refused arms (compiler dep absent from seed lib.rs; v2_std module without shared std-bridge shim) fold into byte-untouched emit-retain — refusal relocates to cargo verdict, not silent green (the sanitize scaffold debt on this path dissolved 2026-07-23 when strip_repeated_use_symbols landed in v1.compiler.emit_rust). Invoked from cssl_seed_linked_behavioral_receipt when shim_lib_rel empty and shim_writes empty. cssl_assemble IS the assembly entrypoint (a modeled bin, invoked directly); the hand probe runners that used to drive it under CSSL_STD_SEED_LINK=1 lived in scripts/ and were deleted 2026-07-23 — their measurement receipts are in docs/probes, and re-measuring goes through cssl_assemble, not a restored shell wrapper."

data cssl_std_bridge_shims_rel: String = "dag/tools/self_host_std_bridge_shims"

data cssl_std_bridge_scaffold_dissolution_trigger: DissolutionCondition = unbound_dissolution(description: "dissolve-on: dag/tools/self_host_std_bridge_shims/* shared std-bridge (emitted-side ONLY; seed oracle uses v1_compiler real std). DISSOLVES WHEN v2 std self-emits and gunbc emits seed-linked extern imports without hand ABI bridges.")

data cssl_is_not_a_seed_admission_path_note: String = "CSSL DOES NOT ADD MODULES TO THE v1 SEED, AND THE ABSENCE OF THIS SENTENCE HAS A MEASURED COST. cssl_assemble writes into out_dir ONLY -- the gunbc-emitted CANDIDATE crate. AS OF THIS REVISION IT DOES NOT READ src/v1/stage0/src AT ALL, AND THAT IS A STRENGTHENING OF THIS PARAGRAPH, NOT A CHANGE OF SUBJECT. It formerly had exactly one such read: seed_has_pub_mod, an oracle deciding whether a compiler-family module in the CANDIDATE should become a re-export of the seed rather than keep its emitted body. That oracle text-parsed the seed lib.rs for a pub mod line, which made it a SECOND authority over seed mod-tree membership beside the modeled one, v2.compiler.self_host.stage0_crate_layout -- and the two disagree exactly during drift. It is deleted with the arm it fed, which was already UNREACHABLE: the arm required a closure member to be absent from the emitted lib.rs manifest that the loop had just drawn it from, a negation false by construction. Verified by execution before deletion (a panic substituted for the arm body left all nine module tests identical in outcome), with the discriminating control closure_compiler_mod_emit_retained_when_seed_also_has_pub_mod kept enrolled. So the claim below no longer rests on reading which paths the arms write: no arm of assemble_seed_linked_closure reads OR writes any path under src/v1, so running it can never make the seed declare a module it did not already declare. THERE IS EXACTLY ONE WAY A MODULE ENTERS THE SEED: compile_stage0() emits it and the emitted bytes are committed, or v2.compiler.self_host.stage0_crate_layout registers it as seed-retained. claim_executor --required-regen refusing an unregistered committed file (committed_not_emitted) is that single path WORKING; it is not a second mechanism disagreeing with this harness. WHY THIS IS WRITTEN DOWN. cssl_closure_assembly_note beside it describes the assembly RULE correctly and never says what the rule is not, and the gap was read as a fork: an escalation concluded the repository had lost the ability to add a seed module, a lane was dispatched on it, the premise was retracted, and the re-scoped item still carried 'two paths -- cssl_assemble and --required-regen' forward until someone read what assemble_seed_linked_closure actually writes. A refusal doing its job was read as evidence of a fork. The distinction costs one paragraph here and cost a wrong work item without it."

data cssl_closure_assembly_note: String = "Generic closure assembly: the dep population is the EMITTED-POPULATION MANIFEST the compiler writes into the same out_dir (src/emitted_population.rs), read under the grammar both ends resolve from gunbc.stage0_emitted_population_manifest -- split on the separator, strip the line prefix. Entry module bytes hash-locked. Emit-retain rule: every path the emitter DECLARED it produced must be materialized in out_dir, byte-untouched; a declared path with no file is a typed refusal (RefusedDeclaredMember), and refusal for anything the bytes then say relocates to the cargo verdict. THIS REPLACED THE LAST RUST TEXT-PARSE ON THIS PATH (the prior revision scraped src/lib.rs pub mod lines to recover closure membership), and the swap is a strengthening rather than a rename: lib.rs mod list is rendered FROM the same module file list the writer then writes out, so that check could only agree with itself on the real path and its only reachable red came from a hand-authored lib.rs -- while the manifest declares Cargo.toml, lib.rs, main.rs, every module, every test file and itself, so the declared-versus-materialized question is answerable at the grain that matters. BOOTSTRAP_INLINE_MODS is deleted with it: the manifest never declares NonEmptyVec/NonEmptyBTreeSet because they are inlined structs and not files, so the state that skip tolerated is not representable in the population assembly reads. The seed lib.rs is still NOT consulted: the compiler-seed-re-export arm and its seed_has_pub_mod oracle are deleted (see cssl_is_not_a_seed_admission_path_note), so seed mod-tree membership has one authority, v2.compiler.self_host.stage0_crate_layout, and this harness is not a second reader of it. Hand shim_lib_rel/shim_writes = optional fast-path override (body_producer / behavioral receipts)."

data cssl_medium_as_string_scaffold_debt: String = "SCAFFOLD — tracked debt: Cargo.toml TOML markup authored via concat string literals in cssl_v1_compiled_cargo_* (same class as slb_cargo_toml / ssuv_cargo_toml / peh_cargo_toml). Probe-only throwaway measurement — not gate-side substrate. dissolve-on: extdeps cargo manifest grammar rows + bash-emit #5828 OR harness consolidation; until then one concat producer per variant ([[bin]] witness vs [lib] probe), consumed only via tools.self_host_curated_probe_cargo."

fn cssl_repo_path(root: String, rel: String) -> String {
  concat(root, concat("/", rel))
}

fn cssl_v1_compiled_cargo_deps_block(root: String) -> String {
  concat(
    "[dependencies]\nim = { version = \"15.1\", features = [\"serde\"] }\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\nlazy_static = \"1\"\nunicode-ident = \"1\"\nunicode-properties = { version = \"0.1\", features = [\"emoji\"] }\nv1-compiler = { path = \"",
    concat(root, "/src/v1/stage0\" }\n")
  )
}

fn cssl_v1_compiled_cargo_package_header() -> String {
  "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n"
}

data cssl_witness_bin_variant_note: String = "Witness-driver [[bin]] layout (cssl_v1_compiled_cargo_toml) for ferret flip lanes. Probe does not consume this variant — probe uses cssl_v1_compiled_probe_lib_cargo_toml only."

fn cssl_v1_compiled_cargo_toml(root: String) -> String {
  concat(
    cssl_v1_compiled_cargo_package_header(),
    concat(
      "[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n\n",
      cssl_v1_compiled_cargo_deps_block(root: root)
    )
  )
}

// Probe-lib [lib] layout (cssl_v1_compiled_probe_lib_cargo_toml): single authority for curated_cargo_probe_one — no shell sed fork.
fn cssl_v1_compiled_probe_lib_cargo_toml(root: String) -> String {
  concat(
    cssl_v1_compiled_cargo_package_header(),
    concat(
      "[lib]\npath = \"src/lib.rs\"\n\n",
      cssl_v1_compiled_cargo_deps_block(root: root)
    )
  )
}

type CuratedSeedLinkedShimWrite {
  dest_rel: String
  source_rel: String
}

fn cssl_write_shim_from_repo(
  root: String,
  out_dir: String,
  shim: CuratedSeedLinkedShimWrite
) -> Bool {
  let read = Filesystem.Read(path: cssl_repo_path(root: root, rel: shim.source_rel))
  let write = Filesystem.Write(
    path: concat(out_dir, concat("/src/", shim.dest_rel)),
    content: read.content
  )
  read.success && write.success
}

fn cssl_write_shims_from_repo(
  root: String,
  out_dir: String,
  shims: List<CuratedSeedLinkedShimWrite>
) -> Bool {
  fold_list(
    xs: shims,
    empty: true,
    cons: fn(ok, shim) {
      ok && cssl_write_shim_from_repo(root: root, out_dir: out_dir, shim: shim)
    }
  )
}

fn cssl_write_shim_lib_from_repo(
  root: String,
  out_dir: String,
  shim_lib_rel: String
) -> Bool {
  if shim_lib_rel == "" {
    true
  } else {
    let read = Filesystem.Read(path: cssl_repo_path(root: root, rel: shim_lib_rel))
    let write = Filesystem.Write(path: concat(out_dir, "/src/lib.rs"), content: read.content)
    read.success && write.success
  }
}

fn cssl_uses_hand_shim_fast_path(shim_lib_rel: String, shim_writes: List<CuratedSeedLinkedShimWrite>) -> Bool {
  shim_lib_rel != "" || length(xs: shim_writes) > 0
}

fn cssl_run_generic_closure_assembly(
  root: String,
  out_dir: String,
  source_rel: String,
  cssl_assemble_bin: String
) -> Bool {
  let assemble = gunbc.WitnessBin.Run(
    workdir: root,
    bin_path: cssl_assemble_bin,
    args: [
      "--out-dir", out_dir,
      "--entry-dag", source_rel,
      "--root", root,
      "--std-bridge-dir", cssl_std_bridge_shims_rel
    ]
  )
  assemble.success && string_contains(s: assemble.stdout, pattern: "CSSL_ASSEMBLE: PASS")
}

type CuratedSeedLinkedClaimRun {
  entry_rel: String
  function: String
}

fn cssl_supplemental_claim_run_ok(
  root: String,
  gunbc_bin: String,
  run: CuratedSeedLinkedClaimRun
) -> Bool {
  let eval = gunbc.WitnessBin.Run(
    workdir: root,
    bin_path: gunbc_bin,
    args: [
      "run", "--claim-run",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", run.entry_rel,
      "--function", run.function
    ]
  )
  eval.success
}

fn cssl_supplemental_claims_ok(
  root: String,
  gunbc_bin: String,
  claim_runs: List<CuratedSeedLinkedClaimRun>
) -> Bool {
  fold_list(
    xs: claim_runs,
    empty: true,
    cons: fn(ok, run) {
      ok && cssl_supplemental_claim_run_ok(root: root, gunbc_bin: gunbc_bin, run: run)
    }
  )
}

// ---------------------------------------------------------------------------------------------
// THE FAULT-DETECTION CONJUNCT, AND WHY IT CHANGED.
//
// This conjunct used to read `fault_run.success == false`, and that predicate cannot establish the
// proposition the receipt cites it for. The claim is "the planted fault was REACHED AND DETECTED".
// The predicate is true whenever the process failed to exit zero, which includes: the binary was
// never built, the path does not exist, the loader failed, the process was killed, the host was out
// of memory, or the driver crashed before reaching the comparison at all. Every one of those is a
// TRANSPORT OBSERVATION -- a fact about the pipe, not about the subject -- and every one of them
// made this receipt pass. The predicate's truth set is simply wider than the proposition, which is
// the cause-aliasing violation of the claim-entailing evidence rule (v2.std.subject_evidence).
//
// THE REPAIR REQUIRED NO NEW OBSERVATION. Every one of the sixteen drivers this harness runs
// already prints an EXACT fault marker on the inject-fault path -- `dag/tools/
// self_host_00_compile_shims/witness_main.rs` prints `SELF_HOST_00_COMPILE_BEHAVIORAL_RECEIPT: FAIL`
// before exiting nonzero, and its fifteen siblings print the matching line for their own module.
// The evidence was being produced at the subject and discarded at the point of consumption, which
// is the same shape as every other member of this class. So this is not "design a way to observe
// the fault", it is "stop throwing away the observation that already exists".
//
// THE MARKER IS DERIVED FROM THE PASS MARKER RATHER THAN CONFIGURED, and that is deliberate. Every
// driver builds both markers from one stem, so a second roster column would be a second authority
// for one fact -- and the failure mode of a configured fault marker is silent: a row whose fault
// marker was mistyped matches nothing, the conjunct goes false, and the receipt reports a fault
// that was not detected when in truth it was. Deriving it means the two markers cannot disagree.
fn cssl_pass_marker_stem(pass_marker: String) -> String {
  let n = string_length(s: pass_marker)
  let k = string_length(s: "PASS")
  if n >= k && substring(s: pass_marker, start: n - k, end: n) == "PASS" {
    substring(s: pass_marker, start: 0, end: n - k)
  } else {
    ""
  }
}

// THE THREE CONJUNCTS ARE NOT REDUNDANT, and dropping any one re-opens a distinct hole.
//
//   fault_exit_ok == false        the driver reported failure. Necessary but nowhere near
//                                 sufficient -- this is the OLD predicate, retained as one conjunct
//                                 rather than as the whole test.
//   contains(FAIL marker)         the driver REACHED its comparison, ran it, and reported
//                                 disagreement. This is the conjunct that ENTAILS the proposition:
//                                 a binary that does not exist cannot print it.
//   not contains(PASS marker)     the planted fault did not leave the comparison agreeing anyway.
//
// A binary that never ran satisfies the first and fails the second. That is the cause swap, and it
// is exercised directly in test.claim.claim_entailing_evidence_cause_swap_witness.
//
// THE PARAMETERS ARE THE TWO OBSERVATIONS RATHER THAN THE RUN RECORD, and that is what makes the
// control authorable at all. gunbc.WitnessBin.Run returns an anonymous output record with no name a
// fixture could construct, so a function taking the run could only ever be exercised by performing
// the host effect -- which the hermetic floor refuses. Taking `success` and `stdout` as scalars
// moves the decision into a pure function that a fixture CAN call with fabricated inputs, so the
// evidence rule is checked where it is decided instead of only where it is used.
fn cssl_fault_run_detected_the_planted_fault(
  fault_exit_ok: Bool,
  fault_stdout: String,
  pass_marker: String
) -> Bool {
  let stem = cssl_pass_marker_stem(pass_marker: pass_marker)
  stem != ""
    && (fault_exit_ok == false)
    && string_contains(s: fault_stdout, pattern: concat(stem, "FAIL"))
    && !string_contains(s: fault_stdout, pattern: pass_marker)
}

fn cssl_seed_linked_behavioral_receipt(
  source_rel: String,
  shim_lib_rel: String,
  shim_writes: List<CuratedSeedLinkedShimWrite>,
  driver_rel: String,
  pass_marker: String,
  claim_runs: List<CuratedSeedLinkedClaimRun>,
  run_closure_assembly: Bool
) -> Bool {
  let root = git.Inspect.Toplevel()
  let module_read = Filesystem.Read(path: cssl_repo_path(root: root.path, rel: source_rel))
  let driver_read = Filesystem.Read(path: cssl_repo_path(root: root.path, rel: driver_rel))

  let out_dir = shell.Mktemp.Dir()
  let gunbc_built = witness_bin_ready(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
  let cssl_assemble_built = witness_bin_ready(root: root.path, bin: witness_bin(var_name: "CSSL_ASSEMBLE", bin_name: "cssl_assemble"))
  let gunbc_bin = witness_bin_release_path(root: root.path, bin_name: "gunbc")
  let cssl_assemble_bin = witness_bin_release_path(root: root.path, bin_name: "cssl_assemble")
  let emit = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "compile",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", source_rel,
      "--output-dir", out_dir.path,
      "--target", "rust",
      "--dependency-pool-index", "primary-precedence"
    ]
  )

  let src_dir = shell.Mkdir.Parents(path: concat(out_dir.path, "/src"))
  let hand_shim_path = cssl_uses_hand_shim_fast_path(shim_lib_rel: shim_lib_rel, shim_writes: shim_writes)
  let generic_assembly_ok = if hand_shim_path && !run_closure_assembly {
    true
  } else {
    cssl_run_generic_closure_assembly(
      root: root.path,
      out_dir: out_dir.path,
      source_rel: source_rel,
      cssl_assemble_bin: cssl_assemble_bin
    )
  }
  let lib_written = cssl_write_shim_lib_from_repo(root: root.path, out_dir: out_dir.path, shim_lib_rel: shim_lib_rel)
  let shims_written = cssl_write_shims_from_repo(root: root.path, out_dir: out_dir.path, shims: shim_writes)
  let manifest = Filesystem.Write(path: concat(out_dir.path, "/Cargo.toml"), content: cssl_v1_compiled_cargo_toml(root: root.path))
  let main_rs = Filesystem.Write(path: concat(out_dir.path, "/src/main.rs"), content: driver_read.content)

  let build = cargo.Build.BuildManifest(
    workdir: out_dir.path,
    manifest_path: concat(out_dir.path, "/Cargo.toml"),
    target_dir: concat(out_dir.path, "/target"),
    extra_args: ["--release"]
  )

  let witness_bin_path = concat(out_dir.path, "/target/release/witness")
  let pass_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path)
  let fault_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path, args: ["--inject-fault"])
  let fault_detected = cssl_fault_run_detected_the_planted_fault(
    fault_exit_ok: fault_run.success,
    fault_stdout: fault_run.stdout,
    pass_marker: pass_marker
  )
  let claim_ok = cssl_supplemental_claims_ok(
    root: root.path,
    gunbc_bin: gunbc_bin,
    claim_runs: claim_runs
  )

  let cleanup_out = shell.Remove.RecursiveForce(path: out_dir.path)

  module_read.success && driver_read.success
    && out_dir.success && gunbc_built && cssl_assemble_built && emit.success
    && src_dir.success
    && generic_assembly_ok
    && lib_written && shims_written
    && manifest.success && main_rs.success
    && build.success
    && pass_run.success && string_contains(s: pass_run.stdout, pattern: pass_marker)
    && fault_detected
    && claim_ok
    && cleanup_out.success
}
