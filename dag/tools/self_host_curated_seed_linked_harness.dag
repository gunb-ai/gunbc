module tools.self_host_curated_seed_linked_harness

import v2.std.text { String }

data cssl_doc: String = "Curated seed-linked harness cargo authority (probe slice vendored pending ferret #6782 on main). Probe lane consumes only cssl_v1_compiled_probe_lib_cargo_toml via tools.self_host_curated_probe_cargo; full behavioral-receipt spine lands with ferret flip authority and dedupes this copy. Dissolve-on: modeled self-host behavioral-equivalence harness producer (parallel to slb/ssuv_scaffold_dissolution_trigger)."

data cssl_cargo_features_note: String = "Mirrors slb_cargo_features_note: text_lookup_work_counter feature declared for -D warnings consumers."

data cssl_std_seed_link_followup_note: String = "SCAFFOLD — dissolve-on: generic std-seed-link assembly (entry-only emit + v1_compiler std re-exports, clears HARNESS_ARTIFACT_std_dup) lands as modeled cssl_seed_linked_probe_assembly in ferret #6782 harness authority — NOT hand-shell in scripts/lib/. Probe runners: CSSL_STD_SEED_LINK=1 opt-in measurement tooling."

data cssl_medium_as_string_scaffold_debt: String = "SCAFFOLD — tracked debt (v2.lens.medium_structure_containment roster): Cargo.toml TOML markup authored via concat string literals in cssl_v1_compiled_cargo_* (same class as slb_cargo_toml / ssuv_cargo_toml / peh_cargo_toml). Probe-only throwaway measurement — not gate-side substrate. dissolve-on: extdeps cargo manifest grammar rows + bash-emit #5828 OR ferret #6782 harness consolidation; until then one concat producer per variant ([[bin]] witness vs [lib] probe), consumed only via tools.self_host_curated_probe_cargo."

fn cssl_v1_compiled_cargo_deps_block(root: String) -> String {
  concat(
    "[dependencies]\nim-rc = { version = \"15.1\", features = [\"serde\"] }\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\nlazy_static = \"1\"\nunicode-ident = \"1\"\nunicode-properties = { version = \"0.1\", features = [\"emoji\"] }\nv1-compiler = { path = \"",
    concat(root, "/src/v1/stage0\" }\n")
  )
}

fn cssl_v1_compiled_cargo_package_header() -> String {
  "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n"
}

data cssl_witness_bin_variant_note: String = "Witness-driver [[bin]] layout (cssl_v1_compiled_cargo_toml) for ferret flip lanes. Probe does not consume this variant — probe uses cssl_v1_compiled_probe_lib_cargo_toml only."

fn cssl_v1_compiled_cargo_toml(root: String) -> String {
  concat(
    cssl_v1_compiled_cargo_package_header(),
    concat(
      "[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n\n",
      cssl_v1_compiled_cargo_deps_block(root: root)
    )
  )
}

data cssl_probe_lib_variant_note: String = "Probe-lib [lib] layout (cssl_v1_compiled_probe_lib_cargo_toml): single authority for curated_cargo_probe_one — no shell sed fork."

fn cssl_v1_compiled_probe_lib_cargo_toml(root: String) -> String {
  concat(
    cssl_v1_compiled_cargo_package_header(),
    concat(
      "[lib]\npath = \"src/lib.rs\"\n\n",
      cssl_v1_compiled_cargo_deps_block(root: root)
    )
  )
}
