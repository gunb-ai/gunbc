module tools.self_host_curated_seed_linked_harness

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.cargo_build
import extdeps.git
import extdeps.gunbc
import std.logic { Bool }
import v2.std.algebra { fold_list }
import v2.std.collection { List }
import v2.std.text { String }
import tools.host_prelude { witness_bin, witness_bin_ensure_built_typed, witness_bin_release_path }

data cssl_doc: String = "Reusable curated seed-linked self-host harness (Wave 2 easy-flip lane): factors the duplicated emit->shim-assemble->cargo->witness(fault) spine shared by Band A behavioral transports. Probe lane consumes only cssl_v1_compiled_probe_lib_cargo_toml via tools.self_host_curated_probe_cargo. Curated = gunbc emit must succeed, then seed-retained dep shims + shim lib.rs replace the emitted closure so the entry module rustc-links against v1-compiler without waiting for full std self-emit or emitter Track-B body fixes. Each module lane supplies its own shim file paths, witness driver, pass marker, and optional supplementary claim-run. Empty shim_lib_rel = keep gunbc-emitted lib.rs (runtime closure only). Empty claim_entry_rel = skip supplementary claim-run. Dissolve-on: modeled self-host behavioral-equivalence harness producer emits this carrier's operations without per-module copy-paste (parallel to slb/ssuv_scaffold_dissolution_trigger)."

data cssl_cargo_features_note: String = "Mirrors slb_cargo_features_note: text_lookup_work_counter feature declared for -D warnings consumers."

data cssl_std_seed_link_followup_note: String = "SCAFFOLD — dissolve-on: generic std-seed-link assembly (entry-only emit + v1_compiler std re-exports, clears HARNESS_ARTIFACT_std_dup) lands as modeled cssl_seed_linked_probe_assembly in this harness authority — NOT hand-shell in scripts/lib/. Probe runners: CSSL_STD_SEED_LINK=1 opt-in measurement tooling."

data cssl_medium_as_string_scaffold_debt: String = "SCAFFOLD — tracked debt (v2.lens.medium_structure_containment roster): Cargo.toml TOML markup authored via concat string literals in cssl_v1_compiled_cargo_* (same class as slb_cargo_toml / ssuv_cargo_toml / peh_cargo_toml). Probe-only throwaway measurement — not gate-side substrate. dissolve-on: extdeps cargo manifest grammar rows + bash-emit #5828 OR harness consolidation; until then one concat producer per variant ([[bin]] witness vs [lib] probe), consumed only via tools.self_host_curated_probe_cargo."

fn cssl_repo_path(root: String, rel: String) -> String {
  concat(root, concat("/", rel))
}

fn cssl_repo_path(root: String, rel: String) -> String {
  concat(root, concat("/", rel))
}

fn cssl_v1_compiled_cargo_deps_block(root: String) -> String {
  concat(
    "[dependencies]\nim-rc = { version = \"15.1\", features = [\"serde\"] }\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\nlazy_static = \"1\"\nunicode-ident = \"1\"\nunicode-properties = { version = \"0.1\", features = [\"emoji\"] }\nv1-compiler = { path = \"",
    concat(root, "/src/v1/stage0\" }\n")
  )
}

fn cssl_v1_compiled_cargo_package_header() -> String {
  "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n"
}

data cssl_witness_bin_variant_note: String = "Witness-driver [[bin]] layout (cssl_v1_compiled_cargo_toml) for ferret flip lanes. Probe does not consume this variant — probe uses cssl_v1_compiled_probe_lib_cargo_toml only."

fn cssl_v1_compiled_cargo_toml(root: String) -> String {
  concat(
    cssl_v1_compiled_cargo_package_header(),
    concat(
      "[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n\n",
      cssl_v1_compiled_cargo_deps_block(root: root)
    )
  )
}

data cssl_probe_lib_variant_note: String = "Probe-lib [lib] layout (cssl_v1_compiled_probe_lib_cargo_toml): single authority for curated_cargo_probe_one — no shell sed fork."

fn cssl_v1_compiled_probe_lib_cargo_toml(root: String) -> String {
  concat(
    cssl_v1_compiled_cargo_package_header(),
    concat(
      "[lib]\npath = \"src/lib.rs\"\n\n",
      cssl_v1_compiled_cargo_deps_block(root: root)
    )
  )
}

type CuratedSeedLinkedShimWrite {
  dest_rel: String
  source_rel: String
}

fn cssl_write_shim_from_repo(
  root: String,
  out_dir: String,
  shim: CuratedSeedLinkedShimWrite
) -> Bool {
  let read = Filesystem.Read(path: cssl_repo_path(root: root, rel: shim.source_rel))
  let write = Filesystem.Write(
    path: concat(out_dir, concat("/src/", shim.dest_rel)),
    content: read.content
  )
  read.success && write.success
}

fn cssl_write_shims_from_repo(
  root: String,
  out_dir: String,
  shims: List<CuratedSeedLinkedShimWrite>
) -> Bool {
  fold_list(
    xs: shims,
    empty: true,
    cons: fn(ok, shim) {
      ok && cssl_write_shim_from_repo(root: root, out_dir: out_dir, shim: shim)
    }
  )
}

fn cssl_write_shim_lib_from_repo(
  root: String,
  out_dir: String,
  shim_lib_rel: String
) -> Bool {
  if shim_lib_rel == "" {
    true
  } else {
    let read = Filesystem.Read(path: cssl_repo_path(root: root, rel: shim_lib_rel))
    let write = Filesystem.Write(path: concat(out_dir, "/src/lib.rs"), content: read.content)
    read.success && write.success
  }
}

fn cssl_supplemental_claim_ok(
  root: String,
  gunbc_bin: String,
  claim_entry_rel: String,
  claim_function: String
) -> Bool {
  if claim_entry_rel == "" {
    true
  } else {
    let eval = gunbc.WitnessBin.Run(
      workdir: root,
      bin_path: gunbc_bin,
      args: [
        "run", "--claim-run",
        "--source-root", "dag",
        "--source-root", "src/v2",
        "--entry", claim_entry_rel,
        "--function", claim_function
      ]
    )
    eval.success
  }
}

fn cssl_seed_linked_behavioral_receipt(
  source_rel: String,
  shim_lib_rel: String,
  shim_writes: List<CuratedSeedLinkedShimWrite>,
  driver_rel: String,
  pass_marker: String,
  claim_entry_rel: String,
  claim_function: String
) -> Bool {
  let root = git.Core.Toplevel()
  let module_read = Filesystem.Read(path: cssl_repo_path(root: root.path, rel: source_rel))
  let driver_read = Filesystem.Read(path: cssl_repo_path(root: root.path, rel: driver_rel))

  let out_dir = shell.Mktemp.Dir()
  let gunbc_built = witness_bin_ensure_built_typed(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
  let gunbc_bin = witness_bin_release_path(root: root.path, bin_name: "gunbc")
  let emit = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "compile",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", source_rel,
      "--output-dir", out_dir.path,
      "--target", "rust",
      "--dependency-pool-index", "primary-precedence"
    ]
  )

  let src_dir = shell.Mkdir.Parents(path: concat(out_dir.path, "/src"))
  let lib_written = cssl_write_shim_lib_from_repo(root: root.path, out_dir: out_dir.path, shim_lib_rel: shim_lib_rel)
  let shims_written = cssl_write_shims_from_repo(root: root.path, out_dir: out_dir.path, shims: shim_writes)
  let manifest = Filesystem.Write(path: concat(out_dir.path, "/Cargo.toml"), content: cssl_v1_compiled_cargo_toml(root: root.path))
  let main_rs = Filesystem.Write(path: concat(out_dir.path, "/src/main.rs"), content: driver_read.content)

  let build = cargo.Build.BuildManifest(
    workdir: out_dir.path,
    manifest_path: concat(out_dir.path, "/Cargo.toml"),
    target_dir: concat(out_dir.path, "/target"),
    extra_args: ["--release"]
  )

  let witness_bin_path = concat(out_dir.path, "/target/release/witness")
  let pass_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path)
  let fault_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path, args: ["--inject-fault"])
  let claim_ok = cssl_supplemental_claim_ok(
    root: root.path,
    gunbc_bin: gunbc_bin,
    claim_entry_rel: claim_entry_rel,
    claim_function: claim_function
  )

  let cleanup_out = shell.Remove.RecursiveForce(path: out_dir.path)

  module_read.success && driver_read.success
    && out_dir.success && gunbc_built && emit.success
    && src_dir.success
    && lib_written && shims_written
    && manifest.success && main_rs.success
    && build.success
    && pass_run.success && string_contains(s: pass_run.stdout, pattern: pass_marker)
    && (fault_run.success == false)
    && claim_ok
    && cleanup_out.success
}
