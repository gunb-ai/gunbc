module tools.rust_stage0_gates

import std.list { List }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.lens.module_graph { entry_affected_by_touched_paths }
import gunbc.ci_layer_roots { witness_layer_roots }

fn rust_monolith_suffixes() -> List<String> {
  [".rs", "Cargo.toml", "Cargo.lock", "rust-toolchain.toml",
   "clippy.toml", "rustfmt.toml", ".cargo/config.toml"]
}

fn path_is_rust_monolith(path: String) -> Bool {
  fold(rust_monolith_suffixes(), false, fn(acc, suffix) { acc || ends_with(s: path, suffix: suffix) })
}

fn any_rust_monolith(paths: List<String>) -> Bool {
  fold(paths, false, fn(acc, p) { acc || path_is_rust_monolith(path: p) })
}

data consumed_input_closure_concept_note: Disposition = Terminal {
  reason: "consume-input vs produce-artifact is a permanent §3 distinction (different direction + domain from NodeArtifactProvenance). The declared fact here is ENROLLMENT ONLY (unit + entry_path): the consumed .dag closure itself is DERIVED at read time from the single authority v2.lens.module_graph.import_closure_live (via entry_affected_by_touched_paths over gunbc.ci_layer_roots.witness_layer_roots), so declared-vs-derived closure drift is unwritable by construction. The former drift walls (src/v1 consumed_input_closure_drift_test.rs and the import_closure_completeness floor witness) were deleted with the hand-typed path list they guarded, not relocated"
}

type ConsumedInputUnit {
  unit: String
  entry_path: String
}

data coproduct_reflection_conformance_consumed_unit: ConsumedInputUnit = ConsumedInputUnit {
  unit: "coproduct_reflection_conformance_test",
  entry_path: "src/v2/test/claim/manual/coproduct_reflection_conformance_test.dag"
}

data declared_consumed_input_units: List<ConsumedInputUnit> = [
  coproduct_reflection_conformance_consumed_unit
]

fn unit_is_affected(u: ConsumedInputUnit, paths: List<String>) -> Bool {
  entry_affected_by_touched_paths(
    entry_path: u.entry_path,
    pool_roots: witness_layer_roots,
    touched_paths: paths
  )
}

fn any_declared_unit_affected(paths: List<String>) -> Bool {
  fold(declared_consumed_input_units, false, fn(acc, u) { acc || unit_is_affected(u: u, paths: paths) })
}

data unit_must_run_failclosed_note: Disposition = Terminal {
  reason: "fail-closed per-unit selection is a permanent §5 invariant: absent declaration = must-run, keeping coverage sound while declarations are added incrementally"
}

data unit_must_run_staged_note: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "tools.rust_stage0_gates",
    decl_name: "per_unit_test_selector",
    field: WholeDeclaration
  }
}

fn unit_must_run(unit: String, paths: List<String>) -> Bool {
  fold(declared_consumed_input_units, true, fn(acc, u) {
    if u.unit == unit { unit_is_affected(u: u, paths: paths) } else { acc }
  })
}

data should_run_gates_coverage_note: Disposition = Terminal {
  reason: "Coverage fire (Edge-(b)) is a permanent §5 design invariant: the rust gate ALSO runs when a changed .dag affects a declared unit's derived import closure, only ever ADDING fires, never newly skipping"
}

fn should_run_gates(paths: List<String>, git_success: Bool) -> Bool {
  if git_success {
    any_rust_monolith(paths: paths) || any_declared_unit_affected(paths: paths)
  } else {
    true
  }
}
