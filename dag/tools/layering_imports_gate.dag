module tools.layering_imports_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.layering_imports_transport { run_layering_imports_claims }

func run_layering_imports_gate_body() -> ProcessExit {
  return if run_layering_imports_claims() {
    ExitSuccess
  } else {
    exit_failure(
      reason: "layering imports gate failed: clean_tree and/or scanner-execution perturb receipts (failing claim named in the pooled claim_batch FAIL lines)"
    )
  }
}

func main() -> ProcessExit {
  run_layering_imports_gate_body()
}

func run_layering_imports_ci_gate() -> ProcessExit {
  run_layering_imports_gate_body()
}
