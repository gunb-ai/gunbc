module tools.dag_compile_clean_cli_floor_agreement

import gunbc.compile_clean_diagnostic_policy {
  compile_clean_unlisted_import_use_blocks,
  unlisted_import_use_blocks_compile_clean,
  compile_clean_unlisted_import_use_enforcement,
  FloorNotYet,
  Enforced
}

data cli_floor_agreement_note: String = "CLI-vs-floor compile-clean agreement witness (issue 11). Both realizations read gunbc.compile_clean_diagnostic_policy.compile_clean_unlisted_import_use_enforcement — the fork is a declared counted frontier (FloorNotYet), not two silent opposites. GREEN: current row is FloorNotYet (non-blocking) AND flipping the row to Enforced makes the predicate true (RED control — proves both consumers would move together on promotion). The whole-tree verdict-equivalence receipt lives in witness_compile_clean_cli_floor_verdicts_agree (host intrinsic, cargo test #[ignore])."

fn witness_policy_row_is_floor_not_yet() -> Bool {
  compile_clean_unlisted_import_use_enforcement == FloorNotYet
    && compile_clean_unlisted_import_use_blocks() == false
}

fn witness_policy_row_drives_predicate() -> Bool {
  compile_clean_unlisted_import_use_blocks() == unlisted_import_use_blocks_compile_clean(enforcement: compile_clean_unlisted_import_use_enforcement)
}

fn witness_enforced_flip_red_control() -> Bool {
  unlisted_import_use_blocks_compile_clean(enforcement: Enforced) == true
    && unlisted_import_use_blocks_compile_clean(enforcement: FloorNotYet) == false
}

fn witness_cli_floor_policy_agreement_holds() -> Bool {
  witness_policy_row_is_floor_not_yet()
    && witness_policy_row_drives_predicate()
    && witness_enforced_flip_red_control()
}
