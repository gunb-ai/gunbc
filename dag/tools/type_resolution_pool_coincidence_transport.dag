module tools.type_resolution_pool_coincidence_transport

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import extdeps.filesystem.filesystem_io { Filesystem }

data pool_coincidence_fixture_dir: String = "dag/test/fixtures/type_resolution_pool_coincidence"

data pool_coincidence_transport_note: String = "CI floor transport for type-resolution pool-coincidence probes: compiles fixture modules through the ordinary, policy-free compile_dag_dag_fixture_witness_check realization. Fixture sources are read live from disk at witness eval time. The bridge has no mask or policy switch: the witness observes the same binding/refusal behavior as production compile. HAND-RUST receipt authority: tools.type_resolution_pool_coincidence_transport (pool_coincidence_compile_fixture_hand_rust_scaffold + pool_coincidence_compile_fixture_receipt_plan_anchor). Transport-side scaffold: pool_coincidence_fixture_witness_check_dissolution_trigger — dissolves when fixture compile witnesses are modeled as pure .dag transport without cli_run::compile_dag_dag_fixture_witness_check."

data pool_coincidence_compile_fixture_hand_rust_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v1_compiler.cli_run",
    decl_name: "compile_dag_dag_fixture_witness_check",
    field: WholeDeclaration
  }
}

data pool_coincidence_compile_fixture_dissolve_trigger: String = "🟡 dissolve-on: cli_run::compile_dag_dag_fixture_witness_check — policy-free host bridge for ordinary fixture compiles, mirrored by src/v1/tests/src/type_resolution_pool_coincidence_test.rs. DISSOLVES WHEN tools.type_resolution_pool_coincidence_transport compiles fixtures through modeled substrate transport without the HAND-Rust compile driver (witness-realization lane schedules native runs; floor/witness execution chunk in docs/plans/cli-run-hollowing-plan.md §2)."

data pool_coincidence_compile_fixture_receipt_plan_anchor: String = "docs/plans/cli-run-hollowing-plan.md §2 Floor / witness execution · docs/plans/witness-realization-plan.md · ROADMAP §7 ts-seed-interim (hand-Rust review bar: named dissolution trigger + plan anchor — not indefinite interim debt)."

data pool_coincidence_compile_fixture_equivalence_test: String = "type_resolution_pool_coincidence_test"

data pool_coincidence_fixture_witness_check_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "tools.type_resolution_pool_coincidence_transport",
    decl_name: "pool_coincidence_probe_witness_check",
    field: WholeDeclaration
  }
}

fn pool_coincidence_fixture_roots() -> List<String> {
  [pool_coincidence_fixture_dir]
}

fn pool_coincidence_fixture_path(name: String) -> String {
  concat(pool_coincidence_fixture_dir, concat("/", name))
}

fn pool_coincidence_fixture_source(name: String) -> String {
  let read = Filesystem.Read(path: pool_coincidence_fixture_path(name: name))
  if read.success { read.content } else { "" }
}

fn pool_coincidence_probe_witness_check(
  entry_name: String,
  expect_clean: Bool,
  required_unresolved_type: String,
  forbidden_diagnostic_substrings: List<String>,
) -> Bool {
  compile_dag_dag_fixture_witness_check(
    entry_path: pool_coincidence_fixture_path(name: entry_name),
    source: pool_coincidence_fixture_source(name: entry_name),
    extra_source_roots: pool_coincidence_fixture_roots(),
    expect_clean: expect_clean,
    required_unresolved_type_name: required_unresolved_type,
    forbidden_diagnostic_substrings: forbidden_diagnostic_substrings
  )
}

fn probe_green_compiles_clean() -> Bool {
  pool_coincidence_probe_witness_check(
    entry_name: "probe_green.dag",
    expect_clean: true,
    required_unresolved_type: "",
    forbidden_diagnostic_substrings: []
  )
}

fn probe_silent_refuses_content_hash() -> Bool {
  pool_coincidence_probe_witness_check(
    entry_name: "probe_silent.dag",
    expect_clean: false,
    required_unresolved_type: "ContentHash",
    forbidden_diagnostic_substrings: []
  )
}

fn probe_one_import_refuses_content_hash() -> Bool {
  pool_coincidence_probe_witness_check(
    entry_name: "probe_one_import.dag",
    expect_clean: false,
    required_unresolved_type: "ContentHash",
    forbidden_diagnostic_substrings: ["incompatible types"]
  )
}

fn probe_crossboundary_refuses_content_hash() -> Bool {
  pool_coincidence_probe_witness_check(
    entry_name: "probe_crossboundary.dag",
    expect_clean: false,
    required_unresolved_type: "ContentHash",
    forbidden_diagnostic_substrings: []
  )
}

fn probe_alias_rhs_green_compiles_clean() -> Bool {
  pool_coincidence_probe_witness_check(
    entry_name: "probe_alias_rhs_green.dag",
    expect_clean: true,
    required_unresolved_type: "",
    forbidden_diagnostic_substrings: []
  )
}

fn probe_alias_rhs_refuses_remote_type() -> Bool {
  pool_coincidence_probe_witness_check(
    entry_name: "probe_alias_rhs_unbound.dag",
    expect_clean: false,
    required_unresolved_type: "RemoteType",
    forbidden_diagnostic_substrings: []
  )
}

fn type_resolution_pool_coincidence_witness_holds() -> Bool {
  probe_green_compiles_clean()
    && probe_silent_refuses_content_hash()
    && probe_one_import_refuses_content_hash()
    && probe_crossboundary_refuses_content_hash()
    && probe_alias_rhs_green_compiles_clean()
    && probe_alias_rhs_refuses_remote_type()
}
