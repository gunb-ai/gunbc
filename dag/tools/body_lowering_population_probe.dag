module gunbc.tools.body_lowering_population_probe

import gunbc.tools.frontier_ingestion_probe {
  CensusRefusedAtReconciliation,
  CensusRefusedAtWorld,
  CensusTaken,
  FrontendCensusReceipt,
  FrontierMember,
  FrontendStage,
  LexRefused,
  MemberObservation,
  NormalizeAccepted,
  NormalizeGraftRefused,
  NormalizeOther,
  NormalizeRetained,
  ParseRefused,
  take_census_over
}
import v2.std.algebra { fold_list }
import v2.std.collection { List }
import v2.std.integer { Int }
import v2.std.live_tree { LiveTreeDisposition, ReadsLiveTree }
import v2.std.logic { Bool }
import v2.std.compilers.lexing { symbol_lexeme }
import v2.std.node { Symbol }
import v2.std.text { String }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

data body_lowering_population_probe_note: String = "BL-2 REPRODUCTION INSTRUMENT, homed outside a *_test.dag module for the same reason gunbc.tools.frontier_ingestion_probe is: what it reports is a revision-scoped OBSERVATION of the present frontier, and enrolling that as a test declaration would make an assertion that goes RED on the repair and GREEN on a regression. It reuses take_census_over and classify_source rather than reproducing them, so there is one stage classifier in the repository and not two.\n\nWHY IT EXISTS. The body-lowering wall cannot be scheduled against an unmeasured population. normalize today returns Accepted for a tree whose diagnostics carry wrapper-retention, and resolve consumes it, so retention is kept out of resolve by propagation rather than by construction. Making retention unconstructible is the right wall and it CHANGES WHICH MODULES NORMALIZE ACCEPTS — so the population that would newly refuse has to be known before the wall lands, not discovered from a red tree afterwards.\n\nWHAT THIS ROSTER IS. The body-lowering subjects: the two SH-D shards with measured door receipts, the four std members the pre-repair frontier observation recorded as retained plus the one it never re-ran, and the bare-expression specimens v2.lens.vacuity independently found rejecting at this seam. It is deliberately NOT the whole corpus — a per-file census over every module is a different and much larger instrument — so a count taken here is a count over THESE members and carries no claim about the rest.\n\nWHAT A READER MAY NOT DO WITH IT. The per-member stage is the observation. There is no aggregate pass/fail, because the population is the finding and a Boolean over it would be a verdict on subjects that have not all been separately established."

data body_lowering_population_roster: List<FrontierMember> = [
  FrontierMember { label: ^use_site_verdict, path: "src/v2/compiler/use_site_verdict.dag" },
  FrontierMember { label: ^materialization_carriers, path: "src/v2/compiler/materialization_carriers.dag" },
  FrontierMember { label: ^logic, path: "src/v2/std/logic.dag" },
  FrontierMember { label: ^optional, path: "src/v2/std/optional.dag" },
  FrontierMember { label: ^diagnostic, path: "src/v2/std/diagnostic.dag" },
  FrontierMember { label: ^occurrence_identity, path: "dag/std/occurrence_identity.dag" },
  FrontierMember { label: ^nat, path: "src/v2/std/nat.dag" },
  FrontierMember { label: ^body_lowering_fold, path: "src/v2/compiler/body_lowering_fold.dag" },
  FrontierMember { label: ^body_producer_forward, path: "src/v2/compiler/body_producer_forward.dag" },
  FrontierMember { label: ^normalized_tree, path: "src/v2/compiler/normalized_tree.dag" },
]

fn take_body_lowering_population_census() -> FrontendCensusReceipt {
  take_census_over(rows: body_lowering_population_roster)
}

fn stage_label_of(s: FrontendStage) -> String {
  match s {
    LexRefused => "LEX"
    ParseRefused => "PARSE"
    NormalizeGraftRefused => "NORM_GRAFT_REFUSED"
    NormalizeRetained => "NORM_RETAINED"
    NormalizeOther => "NORM_OTHER"
    NormalizeAccepted => "NORM_ACCEPTED"
  }
}

fn observation_line(o: MemberObservation) -> String {
  concat(symbol_lexeme(sym: o.label), concat(" ", stage_label_of(s: o.stage)))
}

fn census_report() -> String {
  match take_body_lowering_population_census() {
    CensusRefusedAtWorld => "REFUSED_AT_WORLD"
    CensusRefusedAtReconciliation { cause: _ } => "REFUSED_AT_RECONCILIATION"
    CensusTaken { roster_identity: _, observations: obs } =>
      fold_list(
        xs: obs,
        empty: "",
        cons: fn(acc, o) {
          if acc == "" { observation_line(o: o) } else { concat(acc, concat(" | ", observation_line(o: o))) }
        }
      )
  }
}

fn count_stage_matching(target: String) -> Int {
  match take_body_lowering_population_census() {
    CensusRefusedAtWorld => 0 - 1
    CensusRefusedAtReconciliation { cause: _ } => 0 - 2
    CensusTaken { roster_identity: _, observations: obs } =>
      fold_list(
        xs: obs,
        empty: 0,
        cons: fn(n, o) { if stage_label_of(s: o.stage) == target { n + 1 } else { n } }
      )
  }
}

fn retained_member_count() -> Int {
  count_stage_matching(target: "NORM_RETAINED")
}
