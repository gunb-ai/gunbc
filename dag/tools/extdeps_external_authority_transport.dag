module tools.extdeps_external_authority_transport

import std.logic { Bool }
import tools.host_prelude { ClaimRun, run_gunbc_claims }

data transport_note: String = "Witness transport for the extdeps external-authority gate, rewired 2026-07-22 onto the mandatory-tag dissolution: the verdict authority is v2.lens.mandatory_tag (compile-gate fold, red/green-controlled at the v2 parse grain in v2.lens.mandatory_tag.gate_witness_test, discovery-enrolled); this transport runs the CORPUS-cadence rows - the retained host anchor projection (v2.lens.mandatory_tag.corpus_scan, a declared shrunken scaffold whose dissolution trigger is witness realization of the parse-grain corpus witness) plus the uri modeling witnesses. The old per-module lens_unit rows retired with v2.lens.extdeps_external_authority; their grain is covered by the gate witnesses."

data uri_witness_entry: String = "dag/test/claim/uri_witness_test.dag"
data uri_witness_fn: String = "uri_witnesses"

data corpus_scan_entry: String = "src/v2/lens/mandatory_tag/corpus_scan_witness_test.dag"

data extdeps_external_authority_source_roots: List<String> = ["dag", "src/v2"]

fn run_extdeps_external_authority_uri_witnesses() -> Bool {
  run_gunbc_claims(
    source_roots: extdeps_external_authority_source_roots,
    claims: [ClaimRun { entry: uri_witness_entry, function: uri_witness_fn }]
  )
}

fn run_extdeps_external_authority_live_corpus_witness() -> Bool {
  run_gunbc_claims(
    source_roots: extdeps_external_authority_source_roots,
    claims: [
      ClaimRun { entry: corpus_scan_entry, function: "corpus_live_clean_tree_wall_holds" }
    ]
  )
}

fn run_extdeps_external_authority_lens_unit_red() -> Bool {
  run_gunbc_claims(
    source_roots: extdeps_external_authority_source_roots,
    claims: [
      ClaimRun { entry: corpus_scan_entry, function: "corpus_projection_missing_plant_reads_absent" },
      ClaimRun { entry: corpus_scan_entry, function: "corpus_projection_file_plant_reads_non_external_scheme" },
      ClaimRun { entry: corpus_scan_entry, function: "corpus_projection_real_anchor_reads_https" }
    ]
  )
}
