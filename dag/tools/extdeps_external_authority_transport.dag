module tools.extdeps_external_authority_transport

import tools.host_prelude { ClaimRun }

data transport_note: String = "Witness transport for the extdeps external-authority gate, rewired 2026-07-22 onto the mandatory-tag dissolution: the verdict authority is v2.lens.mandatory_tag (compile-gate fold, red/green-controlled at the v2 parse grain in v2.lens.mandatory_tag.gate_witness_test, discovery-enrolled); this transport runs the CORPUS-cadence rows - the retained host anchor projection (v2.lens.mandatory_tag.corpus_scan, a declared shrunken scaffold whose dissolution trigger is witness realization of the parse-grain corpus witness) plus the uri modeling witnesses. The old per-module lens_unit rows retired with v2.lens.extdeps_external_authority; their grain is covered by the gate witnesses. Pooled 2026-07-23 (the cold-child class, attribution doc section 9): the three per-concern fns' calls collapse into ONE claim_batch child; SUPERSEDED same day by the batch-0 pool (CI floor endgame D1, tools.cheap_gate_pool — one child for the whole cheap batch, so this concern's claims no longer pay their own index build). This module is the concern authority only (the claim list below); the gate module beside it is the enrollment wall. The former extdeps_external_authority_source_roots datum was a nickname of witness_layer_roots and dissolved into it."

data uri_witness_entry: String = "dag/test/claim/uri_witness_test.dag"
data uri_witness_fn: String = "uri_witnesses"

data corpus_scan_entry: String = "src/v2/lens/mandatory_tag/corpus_scan_witness_test.dag"

fn extdeps_external_authority_claims() -> List<ClaimRun> {
  [
    ClaimRun { entry: uri_witness_entry, function: uri_witness_fn },
    ClaimRun { entry: corpus_scan_entry, function: "corpus_live_clean_tree_wall_holds" },
    ClaimRun { entry: corpus_scan_entry, function: "corpus_projection_missing_plant_reads_absent" },
    ClaimRun { entry: corpus_scan_entry, function: "corpus_projection_file_plant_reads_non_external_scheme" },
    ClaimRun { entry: corpus_scan_entry, function: "corpus_projection_real_anchor_reads_https" }
  ]
}
