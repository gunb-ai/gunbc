module tools.bootstrap_witness_transport

import extdeps.shell
import extdeps.languages.bash.program {
  ShellProgram,
  lit, var_ref, command, serialize_bash
}
import tools.host_prelude { ensure_bootstrap_witness_built }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

fn bootstrap_witness_program() -> ShellProgram {
  let root = var_ref(name: "ROOT")
  ShellProgram {
    set_e: true,
    statements: concat(ensure_bootstrap_witness_built(), [
      command(words: [lit(text: "cd"), root]),
      command(words: [
        var_ref(name: "BOOTSTRAP_WITNESS"),
        lit(text: "--suite"),
        lit(text: "floor")
      ])
    ])
  }
}

data bootstrap_witness_transport_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.languages.bash.program",
    decl_name: "serialize_bash",
    field: WholeDeclaration
  }
}

fn run_bootstrap_witness() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: bootstrap_witness_program()))
  result.success
}
