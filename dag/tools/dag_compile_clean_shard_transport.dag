module tools.dag_compile_clean_shard_transport


data shard_a_exemplar_entry_path: String = "dag/std/logic.dag"

fn single_module_shard_compile_typed(entry_rel_path: String) -> Bool {
  let root = git.Core.Toplevel()
  if dcc_gunbc_ready(root: root.path) {
    let stage = shell.Mktemp.Dir()
    let out = shell.Mktemp.Dir()
    if stage.success && out.success {
      let staged = shell.Copy.File(
        source: concat(root.path, concat("/", entry_rel_path)),
        destination: stage.path
      )
      let compile = gunbc.WitnessBin.Run(
        workdir: root.path,
        bin_path: dcc_gunbc_path(root: root.path),
        args: concat(
          ["compile", "--source-root", stage.path],
          dcc_compile_tail_args(out_dir: out.path)
        )
      )
      let cleaned_out = shell.Remove.RecursiveForce(path: out.path)
      let cleaned_stage = shell.Remove.RecursiveForce(path: stage.path)
      staged.success && compile.success && cleaned_out.success && cleaned_stage.success
    } else {
      false
    }
  } else {
    false
  }
}

fn run_shard_a_exemplar_compile() -> Bool {
  single_module_shard_compile_typed(entry_rel_path: shard_a_exemplar_entry_path)
}
