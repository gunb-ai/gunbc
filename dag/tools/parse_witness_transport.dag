module tools.parse_witness_transport

import extdeps.shell
import extdeps.languages.bash.program {
  ShellProgram,
  lit, var_ref, command, serialize_bash
}
import tools.host_prelude { ensure_parse_witness_built }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

fn parse_witness_program(suite: String) -> ShellProgram {
  let root = var_ref(name: "ROOT")
  ShellProgram {
    set_e: true,
    statements: concat(ensure_parse_witness_built(), [
      command(words: [lit(text: "cd"), root]),
      command(words: [
        var_ref(name: "PARSE_WITNESS"),
        lit(text: "--suite"),
        lit(text: suite)
      ])
    ])
  }
}

data parse_witness_transport_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.languages.bash.program",
    decl_name: "serialize_bash",
    field: WholeDeclaration
  }
}

fn run_parse_witness_floor() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: parse_witness_program(suite: "floor")))
  result.success
}

fn run_parse_witness_perf() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: parse_witness_program(suite: "perf")))
  result.success
}
