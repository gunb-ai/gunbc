module tools.emit_determinism_transport

import extdeps.shell
import extdeps.git
import extdeps.gunbc
import std.logic { Bool }
import tools.host_prelude { witness_bin, witness_bin_ensure_built_typed, witness_bin_release_path }
import v2.lens.duplicate_computation { ReplicationIntent, ReplicatedOracle, TypedArgvInvocation }

data ed_typed_transport_doc: String = "Emit-determinism transport, typed. The receipt is a composition of typed service operations (shell.Mktemp.Dir, gunbc.WitnessBin.Run twice on the gunbc binary, shell.Diff.Recursive on the two output trees, shell.Remove.RecursiveForce) - no bash is serialized or executed. The former ShellProgram builder and its RealizationDispatch scaffold row dissolved with the flip. The two compile runs are one declared ReplicatedOracle pair: the duplicate_computation lens projects both invocations from ed_typed_compile_invocation - the same construction the run path executes - so the declared-pair witness and the run path cannot drift."

data emit_determinism_corpus_roots: List<String> = ["dag", "src/v2"]

data emit_determinism_replication_intent: ReplicationIntent = ReplicatedOracle { runs: 2 }

data ed_gunbc_bin_name: String = "gunbc"

fn ed_source_root_args() -> List<String> {
  fold(emit_determinism_corpus_roots, init: [], f: (acc, r) => concat(acc, ["--source-root", r]))
}

fn ed_compile_args(out_dir: String) -> List<String> {
  concat(
    concat(["compile"], ed_source_root_args()),
    [
      "--dependency-pool-index", "primary-precedence",
      "--output-dir", out_dir,
      "--target", "rust"
    ]
  )
}

fn ed_typed_compile_invocation(run_site: String, out_dir: String) -> TypedArgvInvocation {
  TypedArgvInvocation {
    site: run_site,
    tool: ed_gunbc_bin_name,
    args: ed_compile_args(out_dir: out_dir)
  }
}

fn ed_gunbc_ready(root: String) -> Bool {
  witness_bin_ensure_built_typed(root: root, bin: witness_bin(var_name: "GUNBC", bin_name: ed_gunbc_bin_name))
}

fn ed_run_compile(root: String, invocation: TypedArgvInvocation) -> Bool {
  let run = gunbc.WitnessBin.Run(
    workdir: root,
    bin_path: witness_bin_release_path(root: root, bin_name: ed_gunbc_bin_name),
    args: invocation.args
  )
  run.success
}

fn run_emit_corpus_x2_diff_zero() -> Bool {
  let root = git.Core.Toplevel()
  if ed_gunbc_ready(root: root.path) {
    let out1 = shell.Mktemp.Dir()
    let out2 = shell.Mktemp.Dir()
    if out1.success && out2.success {
      let first = ed_run_compile(
        root: root.path,
        invocation: ed_typed_compile_invocation(run_site: "tools.emit_determinism_transport.run_emit_corpus_x2_diff_zero#first", out_dir: out1.path)
      )
      let second = ed_run_compile(
        root: root.path,
        invocation: ed_typed_compile_invocation(run_site: "tools.emit_determinism_transport.run_emit_corpus_x2_diff_zero#second", out_dir: out2.path)
      )
      let compared = shell.Diff.Recursive(left: out1.path, right: out2.path)
      let cleaned1 = shell.Remove.RecursiveForce(path: out1.path)
      let cleaned2 = shell.Remove.RecursiveForce(path: out2.path)
      first && second && compared.identical && cleaned1.success && cleaned2.success
    } else {
      false
    }
  } else {
    false
  }
}
