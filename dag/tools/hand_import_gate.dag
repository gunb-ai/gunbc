module tools.hand_import_gate

import std.types { List, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }

data hand_import_gate_scope_note: String = "Gate scans only dag/** paths changed vs base_ref — compiler src/v1/*.dag edits are out of scope (not corpus import churn)."

data hand_import_allowed_path_prefixes: List<String> = [
  "dag/test/claim/",
  "dag/test/fixtures/type_resolution_pool_coincidence/",
  "dag/test/fixtures/value_resolution_unreachable_callee/",
  "dag/tools/hand_import_gate.dag",
  "dag/tools/type_resolution_pool_coincidence_transport.dag",
  "dag/std/os/invocation.dag",
]

data hand_import_gate_note: String = "Pre-corpus-wide gate: zero import additions vs origin/main outside operator-allowed witness roster and type-resolution / value-resolution probe fixture dirs (hand_import_allowed_path_prefixes). Host realization: hand_import_gate_passes (git diff + per-file import-block compare). Operator ruling (clever-pike-49, keen-wolf-121): blocks hand-import churn before projection-generator corpus-wide runs. HAND-RUST receipt authority: tools.hand_import_gate (hand_import_gate_hand_rust_scaffold + hand_import_gate_receipt_plan_anchor — shell→intent Phase 3 lane). Counted fail-open residue: allowed-prefix mirror (§3 parallel representation until on-carrier roster) — hand_import_allowed_prefixes_mirror_dissolution_trigger."

data hand_import_gate_hand_rust_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "v1_compiler.cli_run",
    decl_name: "hand_import_gate_passes",
    field: WholeDeclaration
  }
}

data hand_import_gate_dissolve_trigger: String = "🟡 dissolve-on: cli_run::hand_import_gate_passes — git diff + single-line import-block compare host realization (mirrors tools.hand_import_gate roster). DISSOLVES WHEN hand_import_gate_passes_for_pr is enrolled as a CI floor witness without a hand-written shell carrier (gunbc orchestration emit / host_effect_apply routes gate eval — shell→intent lane ROADMAP shell→intent Phase 3, docs/plans/shell-intent-emit-realization-design.md)."

data hand_import_gate_receipt_plan_anchor: String = "docs/plans/shell-intent-emit-realization-design.md Phase 3 · docs/plans/cli-run-hollowing-plan.md §2 Corpus discovery · ROADMAP §7 ts-seed-interim (hand-Rust review bar: named lane + concrete plan row — operator ruling clever-pike-49 keen-wolf-121 pre-corpus-wide import gate)."

data hand_import_gate_equivalence_witness: String = "dag/test/claim/hand_import_gate_witness_test.dag"

data hand_import_allowed_prefixes_mirror_note: String = "ALLOWED_PREFIXES in cli_run.rs host realization mirrors hand_import_allowed_path_prefixes (§3 parallel representation until the gate reads the on-carrier roster at eval time)."

data hand_import_allowed_prefixes_mirror_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "tools.hand_import_gate",
    decl_name: "hand_import_allowed_path_prefixes",
    field: WholeDeclaration
  }
}

data hand_import_gate_shell_emit_dissolution_trigger: String = "🟡 dissolve-on: scripts/check_hand_import_gate.sh — foreign-executor claim_batch argv scaffold (set -euo pipefail + target/release/claim_batch --claim-run). DISSOLVES WHEN hand_import_gate_passes is enrolled as a CI floor witness without a hand-written shell carrier (gunbc orchestration emit / host_effect_apply routes gate eval — shell→intent lane, ROADMAP shell→intent Phase 3)."

data hand_import_gate_shell_runner_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "tools.hand_import_gate",
    decl_name: "hand_import_gate_shell_emit_dissolution_trigger",
    field: WholeDeclaration
  }
}

fn hand_import_gate_passes_for_pr() -> Bool {
  hand_import_gate_passes(base_ref: "origin/main")
}
