module tools.walk_target_alias_apply_transport

import tools.host_prelude { run_witness_bin }
import tools.walk_target_alias_apply {
  walk_target_alias_apply_module_fold
}
import v2.std.diagnostic { Accepted, Rejected }
import v2.std.logic { Bool }
import std.types { list_length }

data wtaa_transport_doc: String = "§13 walk-target alias APPLY transport: the walk_target_alias_apply driver bin projects module paths and file text at the host boundary, calls walk_target_alias_apply_module_fold in-process, and realizes the returned splices (dry-run prints; --write refuses via the fold's corpus write gate until the v1 alias parse arm lands). Wet plan production remains on the walk_target_alias_plan WitnessBin (#6984 seed-retained)."

fn walk_target_alias_apply_dry_run_receipt_holds() -> Bool {
  match walk_target_alias_apply_module_fold(
    inputs: [],
    source_scope_label: "dry-run-receipt",
    write_requested: false
  ) {
    Accepted { value: report, diagnostics: _ } =>
      report.binding_identity_static_oracle_passed
        && !report.write_requested
        && (list_length(items: report.refused) == 0)
        && (list_length(items: report.edits) == 0)
    Rejected { diagnostics: _ } => false
  }
}

fn run_walk_target_alias_plan_bin_smoke() -> Bool {
  run_witness_bin(
    var_name: "WALK_TARGET_ALIAS_PLAN",
    bin_name: "walk_target_alias_plan",
    args: ["--source-root", "dag/std"]
  )
}

fn run_walk_target_alias_apply_witness() -> Bool {
  walk_target_alias_apply_dry_run_receipt_holds()
}
