module tools.host_prelude

import extdeps.shell
import extdeps.cargo_build
import extdeps.git
import extdeps.gunbc
import std.logic { Bool }
import extdeps.languages.bash.program {
  ShellProgram, ShellStmt, ShellWord,
  Command, If, Subshell, AndOr, WithRedir, Exit,
  Lit, VarRef, Concat, CmdSubst,
  AndThen, OrElse, StderrToNull,
  lit, var_ref, command, assign, test_not_executable
}
import tools.build_step { BuildArtifact, emit_verifications }

fn assign_root_stmt() -> ShellStmt {
  assign(name: "ROOT", value: CmdSubst { body: AndOr {
    left: WithRedir {
      stmt: command(words: [lit(text: "git"), lit(text: "rev-parse"), lit(text: "--show-toplevel")]),
      redir: StderrToNull
    },
    op: OrElse,
    right: command(words: [lit(text: "pwd")])
  } })
}

fn build_bin_if_absent_stmt(bin_path: ShellWord, root: ShellWord, bin_name: String) -> ShellStmt {
  build_bin_if_absent_stmt_with_features(bin_path: bin_path, root: root, bin_name: bin_name, features: "")
}

fn build_bin_if_absent_stmt_with_features(bin_path: ShellWord, root: ShellWord, bin_name: String, features: String) -> ShellStmt {
  let cargo_build = if features == "" {
    command(words: [
      lit(text: "cargo"), lit(text: "build"), lit(text: "-p"), lit(text: "v1-compiler"),
      lit(text: "--release"), lit(text: "--bin"), lit(text: bin_name)
    ])
  } else {
    command(words: [
      lit(text: "cargo"), lit(text: "build"), lit(text: "-p"), lit(text: "v1-compiler"),
      lit(text: "--release"), lit(text: "--features"), lit(text: features),
      lit(text: "--bin"), lit(text: bin_name)
    ])
  }
  If {
    cond: test_not_executable(path: bin_path),
    then: [
      AndOr {
        left: Subshell { body: [
          AndOr {
            left: command(words: [lit(text: "cd"), root]),
            op: AndThen,
            right: cargo_build
          }
        ] },
        op: OrElse,
        right: Exit { code: 1 }
      }
    ]
  }
}

fn ensure_bin_built_and_verified_with_features(var_name: String, bin_name: String, features: String) -> List<ShellStmt> {
  let root = var_ref(name: "ROOT")
  let bin = var_ref(name: var_name)
  concat(
    [
      assign_root_stmt(),
      assign(name: var_name, value: Concat { parts: [root, lit(text: concat("/target/release/", bin_name))] }),
      build_bin_if_absent_stmt_with_features(bin_path: bin, root: root, bin_name: bin_name, features: features)
    ],
    emit_verifications(
      produces: [BuildArtifact { path: bin, name: bin_name }]
    )
  )
}

fn ensure_bin_built_and_verified(var_name: String, bin_name: String) -> List<ShellStmt> {
  let root = var_ref(name: "ROOT")
  let bin = var_ref(name: var_name)
  concat(
    [
      assign_root_stmt(),
      assign(name: var_name, value: Concat { parts: [root, lit(text: concat("/target/release/", bin_name))] }),
      build_bin_if_absent_stmt(bin_path: bin, root: root, bin_name: bin_name)
    ],
    emit_verifications(
      produces: [BuildArtifact { path: bin, name: bin_name }]
    )
  )
}

fn ensure_gunbc_built() -> List<ShellStmt> {
  ensure_bin_built_and_verified(var_name: "GUNBC", bin_name: "gunbc")
}

fn toolchain_provision_shell_exec(script: String) -> Bool {
  let result = shell.Exec.Run(script: script)
  result.success
}

data witness_invocation_doc: String = "Shared witness-binary invocation. A dag/tools transport states WHICH binaries must exist (WitnessBin: prereqs + the one to invoke) and its argv Strings; this module realizes that intent as TYPED service operations (shell.Test.IsExecutable, cargo.Build.Build, gunbc.WitnessBin.Run at the git.Core.Toplevel root) - no bash is serialized or executed on the run path, per the shell-emission-model rule that runtime-present sites are argv invocations wearing bash syntax and need no shell. The former ShellProgram builders (witness_bin_program, gunbc_claims_program) dissolved with the oracle flip to emitter-independent goldens in v2.test.claim.bash_program_fold; ensure_gunbc_built remains as a scaffold for emit_determinism_transport (lane C)."

type WitnessBin {
  var_name: String
  bin_name: String
  features: String
}

fn witness_bin(var_name: String, bin_name: String) -> WitnessBin {
  WitnessBin { var_name: var_name, bin_name: bin_name, features: "" }
}

fn witness_bin_release_path(root: String, bin_name: String) -> String {
  concat(root, concat("/target/release/", bin_name))
}

fn witness_bin_build_args(bin: WitnessBin) -> List<String> {
  if bin.features == "" {
    ["-p", "v1-compiler", "--release", "--bin", bin.bin_name]
  } else {
    ["-p", "v1-compiler", "--release", "--features", bin.features, "--bin", bin.bin_name]
  }
}

fn witness_bin_artifact_verified(path: String) -> Bool {
  let exec = shell.Test.IsExecutable(path: path)
  if exec.executable {
    let nonempty = shell.Test.IsNonEmpty(path: path)
    nonempty.nonempty
  } else {
    false
  }
}

fn witness_bin_ensure_built_typed(root: String, bin: WitnessBin) -> Bool {
  let path = witness_bin_release_path(root: root, bin_name: bin.bin_name)
  let present = shell.Test.IsExecutable(path: path)
  let build_ok = if present.executable {
    true
  } else {
    let built = cargo.Build.BuildInheritEnv(workdir: root, extra_args: witness_bin_build_args(bin: bin))
    built.success
  }
  if build_ok {
    witness_bin_artifact_verified(path: path)
  } else {
    false
  }
}

fn run_witness_bin_program(invoke: WitnessBin, prereqs: List<WitnessBin>, args: List<String>) -> Bool {
  let root = git.Core.Toplevel()
  let prereqs_ok = fold(prereqs, init: true, f: (acc, b) =>
    acc && witness_bin_ensure_built_typed(root: root.path, bin: b))
  if prereqs_ok && witness_bin_ensure_built_typed(root: root.path, bin: invoke) {
    let result = gunbc.WitnessBin.Run(
      workdir: root.path,
      bin_path: witness_bin_release_path(root: root.path, bin_name: invoke.bin_name),
      args: args
    )
    result.success
  } else {
    false
  }
}

fn run_witness_bin(var_name: String, bin_name: String, args: List<String>) -> Bool {
  run_witness_bin_program(
    invoke: witness_bin(var_name: var_name, bin_name: bin_name),
    prereqs: [],
    args: args
  )
}

type ClaimRun {
  entry: String
  function: String
}

fn gunbc_claim_run_args(source_roots: List<String>, claim: ClaimRun) -> List<String> {
  concat(
    concat(
      ["run"],
      fold(source_roots, init: [], f: (acc, r) => concat(acc, ["--source-root", r]))
    ),
    ["--entry", claim.entry, "--function", claim.function, "--claim-run"]
  )
}

fn run_gunbc_claims(source_roots: List<String>, claims: List<ClaimRun>) -> Bool {
  let root = git.Core.Toplevel()
  if witness_bin_ensure_built_typed(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc")) {
    fold(claims, init: true, f: (acc, c) => {
      let result = gunbc.WitnessBin.Run(
        workdir: root.path,
        bin_path: witness_bin_release_path(root: root.path, bin_name: "gunbc"),
        args: gunbc_claim_run_args(source_roots: source_roots, claim: c)
      )
      acc && result.success
    })
  } else {
    false
  }
}
