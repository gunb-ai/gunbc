module tools.dag_compile_clean_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.dag_compile_clean_transport { run_clean_tree_compile }

func run_dag_compile_clean_gate_body() -> ProcessExit {
  if run_clean_tree_compile() {
    ExitSuccess
  } else {
    exit_failure(
      reason: "dag compile-clean gate failed: clean-tree compile over witness layer roots"
    )
  }
}

func run_dag_compile_clean_gate() -> ProcessExit {
  run_dag_compile_clean_gate_body()
}

data dag_compile_clean_failure_receipt_note: String = "The loudness half: the floor witness collapses this gate's ProcessExit to Bool via tools.ci_gates.exit_ok, so a compile-clean red reported only returned Bool(false) without the located reason run_dag_compile_clean_gate_body already builds. This projects the SAME verdict (one authority, never a second decision path) into the claim_executor failure-receipt companion channel."

fn dag_compile_clean_failure_reason(exit: ProcessExit) -> String {
  match exit {
    ExitSuccess => ""
    ExitFailure { code: _, reason: reason } => reason
  }
}

func dag_compile_clean_failure_receipt() -> String {
  dag_compile_clean_failure_reason(exit: run_dag_compile_clean_gate_body())
}

func main() -> ProcessExit {
  run_dag_compile_clean_gate_body()
}
