module tools.dag_compile_clean_shard_totality_transport

import extdeps.shell
import extdeps.git
import std.types { String, Bool, List }

type LiveDagEntryGlobResult {
  success: Bool
  stdout: String
  stderr: String
}

fn run_live_dag_entry_glob() -> LiveDagEntryGlobResult {
  let toplevel = git.Core.Toplevel()
  let result = shell.Find.Files(workdir: toplevel.path, root: "dag", name_glob: "*.dag")
  LiveDagEntryGlobResult { success: result.success, stdout: result.stdout, stderr: result.stderr }
}
