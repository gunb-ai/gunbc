module tools.dag_compile_clean_shard_totality_transport


type LiveDagEntryGlobResult {
  success: Bool
  stdout: String
  stderr: String
}

fn live_dag_entry_glob_seed() -> LiveDagEntryGlobResult {
  LiveDagEntryGlobResult { success: true, stdout: "", stderr: "" }
}

fn run_live_dag_entry_glob() -> LiveDagEntryGlobResult {
  let toplevel = git.Core.Toplevel()
  fold(
    compile_clean_partition_boundary().entry_roots,
    init: live_dag_entry_glob_seed(),
    f: fn(acc, root) {
      let result = shell.Find.Files(workdir: toplevel.path, root: root, name_glob: "*.dag")
      LiveDagEntryGlobResult {
        success: acc.success && result.success,
        stdout: concat(acc.stdout, concat("\n", result.stdout)),
        stderr: concat(acc.stderr, concat("\n", result.stderr))
      }
    }
  )
}
