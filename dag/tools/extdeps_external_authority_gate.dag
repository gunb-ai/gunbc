module tools.extdeps_external_authority_gate


data extdeps_enrollment_wall_note: String = "ENROLLMENT WALL (CI floor endgame D1, 2026-07-23): the extdeps external-authority claims EXECUTE in the batch-0 pooled claim_batch child (tools.cheap_gate_pool — one child per batch, per-claim verdicts named in its PASS/FAIL lines); this gate is the pure construction wall that the concern's every claim survives the K-chunking transform into some pooled child's roster (chunk-transform totality — the pool itself is the union of the concern lists by construction, so membership alone would be vacuous; the chunker between pool and children is the code that could drop a claim, and that drop reds here before the pool even runs). Concern authority stays tools.extdeps_external_authority_transport.extdeps_external_authority_claims; execution authority is the pool."

func run_extdeps_external_authority_gate_body() -> ProcessExit {
  return if claims_covered_by_cheap_pool_chunks(claims: extdeps_external_authority_claims()) {
    ExitSuccess
  } else {
    exit_failure(
      reason: "extdeps external authority enrollment wall failed: an extdeps claim does not survive the pool's K-chunking transform (tools.cheap_gate_pool.chunk_claims) — its execution would be silently dropped"
    )
  }
}

func main() -> ProcessExit {
  run_extdeps_external_authority_gate_body()
}

func run_extdeps_external_authority_ci_gate() -> ProcessExit {
  run_extdeps_external_authority_gate_body()
}
