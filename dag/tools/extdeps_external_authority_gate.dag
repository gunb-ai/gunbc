module tools.extdeps_external_authority_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.extdeps_external_authority_transport { run_extdeps_external_authority_claims }

func run_extdeps_external_authority_gate_body() -> ProcessExit {
  return if run_extdeps_external_authority_claims() {
    ExitSuccess
  } else {
    exit_failure(
      reason: "extdeps external authority gate failed: uri witnesses, live corpus, and/or RED perturb receipts (failing claim named in the pooled claim_batch FAIL lines)"
    )
  }
}

func main() -> ProcessExit {
  run_extdeps_external_authority_gate_body()
}

func run_extdeps_external_authority_ci_gate() -> ProcessExit {
  run_extdeps_external_authority_gate_body()
}
