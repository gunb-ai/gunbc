module tools.self_host_realized_comparison_transport


data realized_comparison_stable_dir_rel: String = "target/v2-emit-fresh-realize"
data realized_comparison_emitted_src_root_rel: String = "target/v2-emit-fresh-realize/src"
data realized_comparison_committed_src_root_rel: String = "src/v1/stage0/src"
data realized_comparison_roster_manifest_rel: String = "target/v2-emit-fresh-realize/roster_manifest.txt"

fn realized_comparison_repo_path(rel: String) -> String {
  let root = git.Core.Toplevel()
  concat(root.path, concat("/", rel))
}

fn realized_comparison_stable_dir() -> String {
  realized_comparison_repo_path(rel: realized_comparison_stable_dir_rel)
}

fn realized_comparison_emitted_src_root() -> String {
  realized_comparison_repo_path(rel: realized_comparison_emitted_src_root_rel)
}

fn realized_comparison_committed_src_root() -> String {
  realized_comparison_repo_path(rel: realized_comparison_committed_src_root_rel)
}

fn realized_comparison_roster_manifest_path() -> String {
  realized_comparison_repo_path(rel: realized_comparison_roster_manifest_rel)
}

fn realized_comparison_invoke() -> WitnessBin {
  witness_bin(var_name: "REGEN_STAGE0", bin_name: "regen_stage0")
}

fn realized_comparison_args() -> List<String> {
  [
    "--emit-fresh", realized_comparison_stable_dir(),
    "--write-manifest", realized_comparison_roster_manifest_path()
  ]
}

fn realized_comparison_verify_args() -> List<String> {
  concat(realized_comparison_args(), ["--verify"])
}

fn run_self_host_realized_comparison_emit() -> Bool {
  run_witness_bin_program(
    invoke: realized_comparison_invoke(),
    prereqs: [],
    args: realized_comparison_args()
  )
}
