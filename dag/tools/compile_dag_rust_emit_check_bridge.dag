module tools.compile_dag_rust_emit_check_bridge

import v2.std.text { String }
import v2.std.algebra { List }

data compile_dag_rust_emit_check_bridge_note: String = "Host-scaffold bridge: self-recursive body dispatches to the compile_dag_rust_emit_check builtin at eval time (same pattern as v2.lens.inert_lens substrate stubs)."

fn compile_dag_rust_emit_check(
  source: String,
  relative_output_path: String,
  includes: List<String>,
  excludes: List<String>
) -> Bool {
  compile_dag_rust_emit_check(
    source: source,
    relative_output_path: relative_output_path,
    includes: includes,
    excludes: excludes
  )
}
