module tools.hand_import_ci_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.hand_import_gate { hand_import_gate_passes_for_pr }

data hand_import_ci_gate_note: String = "CI floor gate body for HandImportGate: branch-wide dag/** import-churn check vs origin/main (tools.hand_import_gate.hand_import_gate_passes_for_pr). Enrolled on GithubActionsCiJob as RunnableSingleClaim — not discovery/affected-set selection (review 43609)."

func run_hand_import_ci_gate_body() -> ProcessExit {
  if hand_import_gate_passes_for_pr() {
    ExitSuccess
  } else {
    exit_failure(
      reason: "hand-import gate failed: import additions detected outside hand_import_allowed_path_prefixes vs origin/main (authority: tools.hand_import_gate)"
    )
  }
}

func main() -> ProcessExit {
  run_hand_import_ci_gate_body()
}

func run_hand_import_ci_gate() -> ProcessExit {
  run_hand_import_ci_gate_body()
}
