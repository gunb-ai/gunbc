module tools.cross_pr_contradiction_instrument

import std.types { Bool, GitRef, Int, NonEmptyStr, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.git
import extdeps.git.inspect
import extdeps.github.pulls
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.languages.json.parse { parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text, json_object_unique_member, JsonMemberFound, JsonMemberAbsent, JsonMemberDuplicated, JsonMemberNotAnObject, json_string_value_or_empty }
import extdeps.languages.json.emit { JsonValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject }
import gunbc.cross_pr_contradiction {
  DiffFileScope,
  EveryFileInDiff,
  IdentityExtractionRule,
  ContradictionReport,
  PrDiffObservation,
  PrDiffRead,
  PrDiffEmptyDerived,
  PrDiffEmptyCorroborated,
  PrDiffUnobserved,
  PrDiffUnobservedCause,
  HeadRefUnresolved,
  HeadRefStale,
  MergeBaseUnavailable,
  DiffEmptyUnderived,
  changed_identities,
  pr_identity_directions,
  contradiction_report,
  contradiction_report_text,
  report_is_complete,
  report_unobserved,
  cross_pr_extraction_rule
}

// THE CROSS-PR CONTRADICTION INSTRUMENT: the observation half.
//
// The model, the predicate, and every reason this exists are in `gunbc.cross_pr_contradiction`.
// This module only supplies the live population -- the open pull requests and their net diffs --
// and renders what the model returns. It REPORTS: it closes nothing, comments nothing, merges
// nothing, and it is enrolled in no required phase.
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/tools/cross_pr_contradiction_instrument.dag --function scan \
//     --arg repo=gunb-ai/gunbc --arg report=/tmp/cross-pr-contradictions.tsv
//
// THE DIFF IS READ FROM THE LOCAL CLONE, NOT FROM THE FORGE, and the staleness that route invites
// is closed by construction rather than by hoping the clone is fresh. GitHub is the authority for
// WHICH pull requests are open and for what each one's head commit IS; the local object store is
// the authority for what that commit CONTAINS. So every branch's local ref is resolved and
// compared against the head oid GitHub reports, and a disagreement REFUSES that pull request by
// name instead of reading a diff that describes a different branch state. A prune-fetch runs first
// so the ordinary case converges rather than refusing.
//
// THE EXIT STATUS REPORTS THE INSTRUMENT, NOT THE SUBJECT. Finding contradictions is a successful
// scan and exits zero -- the report carries them. Failing to READ some pull request exits nonzero,
// because a report over a population that could not be fully observed must not be mistaken for a
// clean one. That is the only mapping under which a broken instrument is distinguishable from a
// fleet with no contradictions in it.

type CrossPrScan
  = CrossPrScanned { report: ContradictionReport }
  | CrossPrFetchRefused { detail: String }
  | CrossPrListingRefused { detail: String }
  | CrossPrListingUnreadable { detail: String }

type PullRequestRow {
  pull_number: Int
  head_ref_name: String
  head_oid: String
  changed_files: Int
}

type PullRequestRowsRead
  = PullRequestRowsParsed { rows: List<PullRequestRow> }
  | PullRequestRowsUnreadable { detail: String }

fn json_member_string(value: JsonValue, key: String) -> String {
  match json_object_unique_member(v: value, key: key) {
    JsonMemberFound { value: found } => json_string_value_or_empty(v: found)
    JsonMemberAbsent => ""
    JsonMemberDuplicated { count: _ } => ""
    JsonMemberNotAnObject => ""
  }
}

// A JSON NUMBER THAT COULD NOT BE READ IS NOT ZERO. `changedFiles` is legitimately 0 for a
// contentless pull request and that value decides whether an empty diff is CORROBORATED or a
// refusal, so collapsing "absent" into 0 would let a listing-shape change silently promote every
// unreadable row to "the forge agrees this branch is empty" -- the state-space conflation this
// whole instrument exists to refuse, committed in its own decoder.
type JsonIntField
  = JsonIntPresent { value: Int }
  | JsonIntUnreadable

fn json_member_int(value: JsonValue, key: String) -> JsonIntField {
  match json_object_unique_member(v: value, key: key) {
    JsonMemberFound { value: found } =>
      match found {
        JsonNumber { lexeme: lex } => JsonIntPresent { value: parse_int(s: lex as String) }
        JsonNull => JsonIntUnreadable
        JsonBool { value: _ } => JsonIntUnreadable
        JsonString { value: _ } => JsonIntUnreadable
        JsonArray { elements: _ } => JsonIntUnreadable
        JsonObject { members: _ } => JsonIntUnreadable
      }
    JsonMemberAbsent => JsonIntUnreadable
    JsonMemberDuplicated { count: _ } => JsonIntUnreadable
    JsonMemberNotAnObject => JsonIntUnreadable
  }
}

type PullRequestRowRead
  = PullRequestRowOk { row: PullRequestRow }
  | PullRequestRowUnreadable

fn pull_request_row(value: JsonValue) -> PullRequestRowRead {
  match json_member_int(value: value, key: "number") {
    JsonIntUnreadable => PullRequestRowUnreadable
    JsonIntPresent { value: number } =>
      match json_member_int(value: value, key: "changedFiles") {
        JsonIntUnreadable => PullRequestRowUnreadable
        JsonIntPresent { value: changed_files } => {
          let head_ref_name = json_member_string(value: value, key: "headRefName")
          let head_oid = json_member_string(value: value, key: "headRefOid")
          if number <= 0 || head_ref_name == "" || head_oid == "" || changed_files < 0 {
            PullRequestRowUnreadable
          } else {
            PullRequestRowOk {
              row: PullRequestRow {
                pull_number: number,
                head_ref_name: head_ref_name,
                head_oid: head_oid,
                changed_files: changed_files
              }
            }
          }
        }
      }
  }
}

fn pull_request_row_read_is_ok(read: PullRequestRowRead) -> Bool {
  match read {
    PullRequestRowOk { row: _ } => true
    PullRequestRowUnreadable => false
  }
}

fn pull_request_row_read_rows(reads: List<PullRequestRowRead>) -> List<PullRequestRow> {
  flat_map(
    reads,
    read => match read {
      PullRequestRowOk { row: row } => [row]
      PullRequestRowUnreadable => []
    }
  )
}

fn pull_request_rows(listing: String) -> PullRequestRowsRead {
  match parse_json_document(s: listing) {
    JsonDocumentUnreadable { gap: gap } =>
      PullRequestRowsUnreadable {
        detail: concat("gh pr list --json output is ", json_document_gap_text(gap: gap))
      }
    JsonDocumentParsed { value: value } =>
      match value {
        JsonArray { elements: elements } => {
          let reads = map(elements, element => pull_request_row(value: element))
          let rows = pull_request_row_read_rows(reads: reads)
          let broken = filter(reads, read => !pull_request_row_read_is_ok(read: read))
          if broken.length() > 0 {
            PullRequestRowsUnreadable {
              detail: concat(
                to_string(broken.length()),
                " listed pull request(s) carried no readable number, head ref name, head oid, or changed-file count — the listing shape changed and no scan may be reported over it"
              )
            }
          } else {
            PullRequestRowsParsed { rows: rows }
          }
        }
        JsonNull => PullRequestRowsUnreadable { detail: "gh pr list returned a JSON null, not an array" }
        JsonBool { value: _ } => PullRequestRowsUnreadable { detail: "gh pr list returned a JSON boolean, not an array" }
        JsonNumber { lexeme: _ } => PullRequestRowsUnreadable { detail: "gh pr list returned a JSON number, not an array" }
        JsonString { value: _ } => PullRequestRowsUnreadable { detail: "gh pr list returned a JSON string, not an array" }
        JsonObject { members: _ } => PullRequestRowsUnreadable { detail: "gh pr list returned a JSON object, not an array" }
      }
  }
}

// ONE PULL REQUEST. Every arm that cannot answer produces a NAMED refusal carrying the pull number,
// and none of them produces an empty direction list: an unread branch and a branch that touches no
// identity are different states and are spelled differently.
// THE DIFF IS TAKEN AGAINST THE MERGE BASE, WHICH IS WHAT `base...head` MEANS. The three-dot
// operation is not reachable: `git.Core.DiffUnified0` carries a call expression in its argv, which
// materialization does not evaluate, and it is one of the seven operations
// `operation_argv_corpus_witness_test` pins for exactly that deficit. Passing the already-resolved
// merge-base commit to the two-dot operation is the SAME revision pair, computed here rather than
// by git's range syntax.
fn observe_pull_request(
  base: String,
  repository_path: String,
  extraction: IdentityExtractionRule,
  row: PullRequestRow
) -> PrDiffObservation {
  let local_ref = concat("origin/", row.head_ref_name)
  let resolved = git.Inspect.ResolveRefCommit(ref: local_ref as GitRef)
  if !resolved.success || (resolved.sha as String) == "" {
    PrDiffUnobserved {
      pull_number: row.pull_number,
      cause: HeadRefUnresolved { ref_name: local_ref, detail: resolved.stderr }
    }
  } else {
    let local_oid = resolved.sha as String
    if local_oid != row.head_oid {
      PrDiffUnobserved {
        pull_number: row.pull_number,
        cause: HeadRefStale { ref_name: local_ref, expected_oid: row.head_oid, local_oid: local_oid }
      }
    } else {
      let baseline = git.Inspect.MergeBase(
        repository_path: repository_path,
        left: base as GitRef,
        right: local_oid as GitRef
      )
      if !baseline.success || (baseline.sha as String) == "" {
        PrDiffUnobserved {
          pull_number: row.pull_number,
          cause: MergeBaseUnavailable { head_oid: local_oid, detail: baseline.stderr }
        }
      } else {
        if (baseline.sha as String) == local_oid {
          PrDiffEmptyDerived { pull_number: row.pull_number, head_oid: local_oid }
        } else {
          let observed = git.Core.Diff(
            base: (baseline.sha as String) as GitRef,
            head: local_oid as GitRef
          )
          {
            if observed.diff == "" {
              if row.changed_files == 0 {
                PrDiffEmptyCorroborated { pull_number: row.pull_number, head_oid: local_oid }
              } else {
                PrDiffUnobserved {
                  pull_number: row.pull_number,
                  cause: DiffEmptyUnderived { head_oid: local_oid, forge_changed_files: row.changed_files }
                }
              }
            } else {
              let changed = changed_identities(diff: observed.diff, rule: extraction)
              PrDiffRead {
                pull_number: row.pull_number,
                head_oid: local_oid,
                changed_lines: changed.changed_lines,
                directions: pr_identity_directions(pull_number: row.pull_number, changed: changed)
              }
            }
          }
        }
      }
    }
  }
}

fn scan_open_pull_requests(repo: String, base: String, repository_path: String) -> CrossPrScan {
  let fetched = git.Core.FetchPrune(remote: "origin")
  if !fetched.success {
    CrossPrFetchRefused {
      detail: concat("git fetch --prune origin refused: ", fetched.stderr)
    }
  } else {
    let listing = github.CliPulls.ListOpenJson(repo: repo as NonEmptyStr)
    if !listing.success {
      CrossPrListingRefused {
        detail: concat("gh pr list refused: ", listing.stderr)
      }
    } else {
      match pull_request_rows(listing: listing.stdout) {
        PullRequestRowsUnreadable { detail: detail } => CrossPrListingUnreadable { detail: detail }
        PullRequestRowsParsed { rows: rows } =>
          CrossPrScanned {
            report: contradiction_report(
              file_scope: EveryFileInDiff,
              extraction: cross_pr_extraction_rule,
              observations: map(
                rows,
                row => observe_pull_request(
                  base: base,
                  repository_path: repository_path,
                  extraction: cross_pr_extraction_rule,
                  row: row
                )
              )
            )
          }
      }
    }
  }
}

fn cross_pr_scan_text(scan: CrossPrScan) -> String {
  match scan {
    CrossPrScanned { report: report } => contradiction_report_text(report: report)
    CrossPrFetchRefused { detail: detail } => concat(concat("scan_refused\tfetch\t", detail), "\n")
    CrossPrListingRefused { detail: detail } => concat(concat("scan_refused\tlisting\t", detail), "\n")
    CrossPrListingUnreadable { detail: detail } => concat(concat("scan_refused\tlisting_shape\t", detail), "\n")
  }
}

fn cross_pr_scan_complete(scan: CrossPrScan) -> Bool {
  match scan {
    CrossPrScanned { report: report } => report_is_complete(report: report)
    CrossPrFetchRefused { detail: _ } => false
    CrossPrListingRefused { detail: _ } => false
    CrossPrListingUnreadable { detail: _ } => false
  }
}

fn scan(repo: String, report: String) -> ProcessExit {
  if repo == "" {
    exit_failure(reason: "scan: --arg repo=<owner/name> is required")
  } else {
    if report == "" {
      exit_failure(reason: "scan: --arg report=<path> is required — the scan is written, not printed")
    } else {
      let scanned = scan_open_pull_requests(repo: repo, base: "origin/main", repository_path: ".")
      let write = Filesystem.Write(path: report, content: cross_pr_scan_text(scan: scanned))
      if !write.success {
        exit_failure(reason: concat("scan: could not write the report to ", report))
      } else {
        if cross_pr_scan_complete(scan: scanned) {
          ExitSuccess
        } else {
          exit_failure(
            reason: concat(
              "scan: the observation is INCOMPLETE — the report at ",
              concat(report, " names every pull request that could not be read; the contradictions it lists are real but are not all of them")
            )
          )
        }
      }
    }
  }
}
