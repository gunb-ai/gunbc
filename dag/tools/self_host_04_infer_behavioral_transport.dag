module tools.self_host_04_infer_behavioral_transport

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.cargo_build
import extdeps.git
import extdeps.gunbc
import std.logic { Bool }
import tools.host_prelude { witness_bin, witness_bin_ensure_built_typed, witness_bin_release_path }

data i4_doc: String = "Gate-A flip prep (04_infer self-emit): shim-free seed-linked behavioral receipt mirroring tools.self_host_target_carriers_behavioral_transport (stc). Emit ONLY v2.compiler.infer via gunbc compile --entry; the emitted lib.rs carries its full std import closure (no hand dep shims — 49 files, 0 diagnostics measured). Seed oracle: v1_compiler::v2_compiler_infer in src/v1/stage0 (hand-retained, independent of the emitted artifact). Behavioral bar: cargo-green witness pairs emitted vs seed on infer_arrow_domain_binding_heuristic_note (04_infer.dag module authority constant) with --inject-fault RED control, plus supplementary claim-run on pipeline_infer_add_fixture_relationship_green. Full infer-tree behavioral oracle deferred until post-#6775 Rc/Optional emit surface greens (curated_cargo_frontier_probe_report.md row 04_infer: cargo build --lib refuses on HARNESS_ARTIFACT_std_dup Int128 dup under the probe-lib layout; this receipt uses the [[bin]] witness layout instead, which does not hit that dup). Frontier NOT flipped until rustc-green receipt — migration_trigger stays ^migrate_when_closure_self_emits_cargo_green (compiler_frontier_row_04_infer, src/v2/compiler/self_host/frontier.dag)."

data i4_seed_retained_note: String = "Seed oracle: v1_compiler::v2_compiler_infer in src/v1/stage0 (hand-retained, independent of emitted artifact). Dissolve-on: same as i4_scaffold_dissolution_trigger."

data i4_source_rel: String = "src/v2/compiler/04_infer.dag"

data i4_test_entry_rel: String = "src/v2/test/compiler/pipeline/infer_stage_test.dag"

data i4_shim_driver_rel: String = "dag/tools/self_host_04_infer_shims/witness_main.rs"

data i4_scaffold_dissolution_trigger: String = "dissolve-on: dag/tools/self_host_04_infer_shims/witness_main.rs + i4_cargo_toml — hand-written equivalence driver + driver-crate manifest (mirrors stc scaffold debt; shim-free for std deps only). DISSOLVES WHEN a modeled self-host behavioral-equivalence harness producer emits the comparison driver + manifest without hand shims."

data i4_receipt_pass_marker: String = "SELF_HOST_04_INFER_BEHAVIORAL_RECEIPT: PASS"

data i4_cargo_features_note: String = "Mirrors stc_cargo_features_note: text_lookup_work_counter feature declared for -D warnings consumers."

fn i4_repo_path(root: String, rel: String) -> String {
  concat(root, concat("/", rel))
}

fn i4_cargo_toml(root: String) -> String {
  concat(
    "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n\n[dependencies]\nim-rc = { version = \"15.1\", features = [\"serde\"] }\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\nlazy_static = \"1\"\nunicode-ident = \"1\"\nunicode-properties = { version = \"0.1\", features = [\"emoji\"] }\nv1-compiler = { path = \"",
    concat(root, "/src/v1/stage0\" }\n")
  )
}

fn i4_behavioral_receipt_holds() -> Bool {
  let root = git.Core.Toplevel()
  let module_read = Filesystem.Read(path: i4_repo_path(root: root.path, rel: i4_source_rel))
  let driver_read = Filesystem.Read(path: i4_repo_path(root: root.path, rel: i4_shim_driver_rel))

  let out_dir = shell.Mktemp.Dir()
  let gunbc_built = witness_bin_ensure_built_typed(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
  let gunbc_bin = witness_bin_release_path(root: root.path, bin_name: "gunbc")
  let emit = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "compile",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", i4_source_rel,
      "--output-dir", out_dir.path,
      "--target", "rust",
      "--dependency-pool-index", "primary-precedence"
    ]
  )

  let manifest = Filesystem.Write(path: concat(out_dir.path, "/Cargo.toml"), content: i4_cargo_toml(root: root.path))
  let main_rs = Filesystem.Write(path: concat(out_dir.path, "/src/main.rs"), content: driver_read.content)

  let build = cargo.Build.BuildManifest(
    workdir: out_dir.path,
    manifest_path: concat(out_dir.path, "/Cargo.toml"),
    target_dir: concat(out_dir.path, "/target"),
    extra_args: ["--release"]
  )

  let witness_bin_path = concat(out_dir.path, "/target/release/witness")
  let pass_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path)
  let fault_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path, args: ["--inject-fault"])

  let eval_pipeline = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "run", "--claim-run",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", i4_test_entry_rel,
      "--function", "pipeline_infer_add_fixture_relationship_green"
    ]
  )

  let cleanup_out = shell.Remove.RecursiveForce(path: out_dir.path)

  module_read.success && driver_read.success
    && out_dir.success && gunbc_built && emit.success
    && manifest.success && main_rs.success
    && build.success
    && pass_run.success && string_contains(s: pass_run.stdout, pattern: i4_receipt_pass_marker)
    && (fault_run.success == false)
    && eval_pipeline.success
    && cleanup_out.success
}
