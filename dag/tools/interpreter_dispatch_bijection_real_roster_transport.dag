module tools.interpreter_dispatch_bijection_real_roster_transport

import extdeps.git.inspect
import extdeps.shell
import gunbc.retained_shell_script { retained_foreign }
import std.logic { Bool }

data interpreter_dispatch_bijection_real_roster_transport_note: String = "R1 closeout item TWO real-crate bijection receipt (gunbc#7825): executes the two #[ignore] integration tests in src/v1/stage0/tests/interpreter_dispatch_bijection_real_roster_red.rs via shell.Exec.Run with RUSTC_WRAPPER cleared — real git clone, real gunbc run main_wet regen, real cargo build -p v1-compiler on the clone. cargo.Build.Test routes through ctrl-build remote in this environment and is intentionally not used here. Claim-A compile-red siblings stay in the default local cargo test run; this transport is the falsifier_self_host_wet enrollment path for claim-B."

data interpreter_dispatch_bijection_real_roster_memory_envelope_note: String = "MEMORY PREDICTION (Lane D, 2026-08-06, pre-cadence enrollment per still-bat-561 msg_f0ca134d). WITNESS NEEDS: per direction — git clone --local of the full workspace (no target/), gunbc run main_wet on the clone (uses the pre-built release gunbc binary, not a recompile), cold release cargo build -p v1-compiler --lib inside the clone; transport runs two directions sequentially so peak memory is max(per-direction), not sum. DOMINANT PEAK: the in-clone cold rustc lib build (same class as other falsifier_self_host_wet emit+cargo receipts). ANCHORS: gunbc_ci_native_bundle_batch_clamp_basis_note measured cgroup peak 11940978688 B (~11.1 GiB) for a cold cargo compile with CARGO_BUILD_JOBS=4 on the fleet runner; v1 whole-corpus width-1 floor receipt 10.7 GiB cgroup under the 15 GiB throttle line; claim_batch resolve for this witness ~2.4 GiB host RSS before the shell starts. PREDICTED PEAK on falsifier: ~10–12 GiB cgroup for the shell subtree (resolve overhead released + one clone build at a time), ~4–5 GiB headroom under gunbc_runner_slot_desired().memory_max (16 GiB kill / 15 GiB high — live falsifier run 31047744902 srv3-03 read both lines). VERDICT: memory fits the declared runner slot IF rustc parallelism stays at CARGO_BUILD_JOBS=4 (transport does not pin it today; falsifier-build sets jobs=4 but the falsifier job floor step does not re-export — fleet parity gap, not a witness shrink). RISK UNDER TONIGHT'S FLEET PRESSURE: co-resident batch-1 discovery RSS (~5–6 GiB observed mid-sweep) stacks before batch-2 wet rows; stranded sccache cgroup inheritance is NOT on this path (RUSTC_WRAPPER cleared). LOCAL SIGKILL (dashboard session, 31.27 GiB cap): claim_batch --wet killed rustc at 97s wall during host-tree cargo test compile BEFORE the integration test reached clone+build — children-max-rss 2.7 GiB is not the clone peak and is not slot-equivalent; standalone direction-1 completed the clone path in 346s wall on the same host. SEPARATE WALL FINDING (Lane B / swift-wren-710): two directions measured ~346s each → ~692s whole transport vs gunbc_falsifier_self_host_wet_receipt_wall_budget 600s — will hit kill-at-deadline unless fleet is materially faster or the budget row moves; that is a cost-envelope finding, not grounds to shrink the witness."

fn interpreter_dispatch_bijection_real_roster_red_shell(root: String) -> String {
  concat(
    "set -euo pipefail\n",
    concat(
      "cd ",
      concat(
        root,
        concat(
          "\n",
          concat(
            "env RUSTC_WRAPPER= CTRL_BUILD_MODE=local /opt/cargo/bin/cargo test -p v1-compiler --test interpreter_dispatch_bijection_real_roster_red --release -- --ignored --exact w_red_real_roster_row_with_no_real_handler_arm_refuses_compile\n",
            "env RUSTC_WRAPPER= CTRL_BUILD_MODE=local /opt/cargo/bin/cargo test -p v1-compiler --test interpreter_dispatch_bijection_real_roster_red --release -- --ignored --exact w_red_real_handler_arm_with_no_real_roster_row_refuses_compile\n"
          )
        )
      )
    )
  )
}

fn run_interpreter_dispatch_bijection_real_roster_red() -> Bool {
  let root = git.Inspect.Toplevel()
  let run = shell.Exec.Run(
    script: retained_foreign(
      body: interpreter_dispatch_bijection_real_roster_red_shell(root: root.path),
      reason: "interpreter dispatch bijection real roster cargo integration tests"
    )
  )
  run.success
}
