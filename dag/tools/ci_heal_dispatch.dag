module tools.ci_heal_dispatch

import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.types { CommitSha, NonEmptyStr }
import extdeps.shell
import extdeps.github.workflows

data ci_heal_dispatch_owner: String = "gunb-ai"
data ci_heal_dispatch_repo: String = "gunbc"
data ci_heal_dispatch_workflow_id: String = "ci.yml"

data ci_heal_dispatch_authority_note: String = "The heal job does not mint a gh-api shell call. It invokes the modeled github.Workflows.CreateDispatch operation, whose REST transport is the realization handler. CreateDispatch ref is the healed commit SHA (GitHub REST: ref may be a branch, tag, or commit SHA), not the PR branch pointer, so the workflow run subject and executed tree bind to the same immutable head. expected_healed_sha repeats that SHA as the workflow input; checkout and preflight refuse on byte mismatch. GITHUB_TOKEN is resolved solely by the service's auth_source; CreateDispatch has no unused caller-supplied auth_token input and this tool passes no empty sentinel."

fn required_env(name: NonEmptyStr) -> String? {
  let observed = shell.Env.Get(name: name)
  match observed.value {
    Present { value: raw } =>
      if trim(raw) == "" { none } else { Present { value: trim(raw) } }
    Absent => none
  }
}

func main() -> ProcessExit {
  let healed_head = match required_env(name: "GUNBC_HEALED_HEAD") {
    Present { value: value } => value as CommitSha
    Absent => return exit_failure(reason: "HealDispatchRefused: GUNBC_HEALED_HEAD is absent")
  }
  let receipt = github.Workflows.CreateDispatch(
    owner: ci_heal_dispatch_owner,
    repo: ci_heal_dispatch_repo,
    workflow_id: ci_heal_dispatch_workflow_id,
    ref: healed_head,
    expected_healed_sha: healed_head
  )
  if receipt.workflow_run_id > 0 {
    ExitSuccess
  } else {
    exit_failure(reason: "HealDispatchRefused: dispatch response carried no workflow run identity")
  }
}
