module tools.regen_verify_transport


data regen_verify_capture_note: String = "The regen-verify gate must surface drifted generated file names on failure. regen_stage0 writes the located reason to stderr (Changed generated file(s): ...) and regen_divergence_count=N to stdout; WitnessBin.Run captures both so the gate verdict and failure receipt share one observation without a second regen invocation."

fn regen_verify_failure_detail(stdout: String, stderr: String) -> String {
  if !string_is_empty(s: stderr) {
    stderr
  } else if !string_is_empty(s: stdout) {
    concat("regen-verify gate failed: ", stdout)
  } else {
    "regen-verify gate failed: witness binary exited nonzero with no diagnostic output"
  }
}

fn run_regen_verify_verdict() -> ProcessExit {
  let root = git.Inspect.Toplevel()
  if witness_bin_ready(root: root.path, bin: realized_comparison_invoke()) {
    let result = gunbc.WitnessBin.Run(
      workdir: root.path,
      bin_path: witness_bin_release_path(root: root.path, bin_name: realized_comparison_invoke().bin_name),
      args: realized_comparison_verify_args()
    )
    if result.success {
      ExitSuccess
    } else {
      exit_failure(
        reason: regen_verify_failure_detail(stdout: result.stdout, stderr: result.stderr)
      )
    }
  } else {
    exit_failure(reason: "regen-verify gate failed: regen_stage0 witness binary unavailable")
  }
}

fn run_regen_verify() -> Bool {
  match run_regen_verify_verdict() {
    ExitSuccess => true
    _ => false
  }
}
