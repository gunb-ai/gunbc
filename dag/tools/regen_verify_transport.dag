module tools.regen_verify_transport

import tools.host_prelude { run_witness_bin_program }
import tools.self_host_realized_comparison_transport {
  realized_comparison_args,
  realized_comparison_invoke
}

fn run_regen_verify() -> Bool {
  run_witness_bin_program(
    invoke: realized_comparison_invoke(),
    prereqs: [],
    args: concat(realized_comparison_args(), ["--verify"])
  )
}
