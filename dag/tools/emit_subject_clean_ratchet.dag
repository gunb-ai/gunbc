module tools.emit_subject_clean_ratchet

import std.types { String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.ci_layer_roots { witness_layer_roots }
import tools.dag_compile_clean_shard_roster {
  CompileCleanShardEntryPathsBuilt,
  CompileCleanShardEntryPathsDuplicatePath,
  compile_clean_shard_entry_paths
}
import tools.emission_entry_instrument { EmissionMeasurement, measure_entry_emission }
import extdeps.shell
import gunbc.emit_subject_clean_frontier {
  RatchetUniverse,
  DualUniverse,
  IndexOnlyUniverse,
  EmitSubjectCleanRatchet,
  EmitRatchetStanding,
  EmitRatchetHeld,
  EmitRatchetRefused,
  EmitRatchetEnrolment,
  EnrolledAsGate,
  EmitRatchetEnrolmentAdmission,
  EnrolmentPermitted,
  EnrolmentRefusedNoUniverse,
  EnrolmentRefusedDenominator,
  EnrolmentRefusedUnevaluated,
  EmitRatchetObservation,
  ObservationTaken,
  ObservationNotTaken,
  RosterDiscoveryPolicy,
  DeclarationIndexUnderRoots,
  SubjectSelection,
  SelectionWholeRoster,
  SelectionSubset,
  subject_selection_entries,
  emit_subject_clean_admissions,
  emit_ratchet_report_text,
  emit_ratchet_standing,
  emit_ratchet_observation,
  emit_ratchet_observation_text,
  emit_ratchet_enrolment_admission,
  emit_ratchet_enrolment_admission_text,
  fold_emit_subject_clean_ratchet
}

// THE RUNNER: the peripheral half of the ratchet, where the host effects live.
//
// gunbc.emit_subject_clean_frontier is a pure fold over measurements someone already took. This
// module is the realization that takes them: it discovers the roster, invokes the per-entry
// instrument once per subject, and hands both to the fold. The split is deliberate rather than
// tidy -- the fold is the thing witnessed by execution on controlled fixtures, and a fold that
// shells a compiler cannot be witnessed at all.
//
// A PARTIAL RUN CANNOT ANSWER A CLOSED-UNIVERSE CLAIM, and the carrier already knows it. `entries`
// selects a SUBSET to measure, which is how a lane measures one entry without an hours-long run;
// every roster subject the subset omits arrives at the fold as RatchetSubjectUnmeasured and the
// standing REFUSES. That is not a limitation worked around, it is the contract: the ratchet holds
// only over a roster measured whole, and a subset run reports exactly which subjects were missing.

data emit_subject_clean_roster_policy: RosterDiscoveryPolicy = DeclarationIndexUnderRoots {
  roots: witness_layer_roots
}



// THE ROSTER IS DISCOVERED, NEVER AUTHORED. compile_clean_shard_entry_paths reads the parsed
// declaration index under the declared source roots, so the universe is not derived from imports,
// from successful resolution, or from anything the ratchet is measuring -- a module no import edge
// reaches is still a subject. A duplicate path is a refusal there and stays a refusal here rather
// than being deduplicated into a smaller universe.
type EmitRatchetRosterRead
  = EmitRatchetRosterEntries { entries: List<String> }
  | EmitRatchetRosterUnreadable { cause: String }

fn emit_ratchet_roster() -> EmitRatchetRosterRead {
  match compile_clean_shard_entry_paths() {
    CompileCleanShardEntryPathsBuilt { paths: ps } => EmitRatchetRosterEntries { entries: ps }
    CompileCleanShardEntryPathsDuplicatePath { path: p, first: f, duplicate: d } =>
      EmitRatchetRosterUnreadable {
        cause: concat(
          concat("the discovered roster carries ", p),
          concat(
            concat(" twice — declared by ", f.module),
            concat(" and by ", d.module)
          )
        )
      }
  }
}

// ---------------------------------------------------------------------------------------------
// THE SECOND DENOMINATOR: the file inventory.
//
// WHY IT IS A FIND AND NOT A SECOND INDEX. The declaration index answers "which modules parsed";
// this answers "which .dag files EXIST". A file that the index cannot classify is invisible to the
// first question and plainly visible to the second, and no amount of care inside the index closes
// that -- `module_path_index` documents its own unclassified arm as inseparable, and it is
// inseparable FROM THE INDEX. Presence on disk does not depend on whether the header parsed.
//
// SORTED, so two runs over an unchanged tree produce the same roster and therefore the same digest.
// Traversal order is not a fact about the corpus and must not reach the identity.
type ModuleInventoryRead
  = ModuleInventoryFiles { paths: List<String> }
  | ModuleInventoryUnreadable { root: String, cause: String }

fn inventory_lines(stdout: String) -> List<String> {
  fold(
    split(s: stdout, delimiter: "\n"),
    init: [],
    f: (acc, line) => if line == "" { acc } else { concat(acc, [line]) }
  )
}

// A ROOT THAT CANNOT BE LISTED REFUSES, and does not contribute an empty list. An unreadable root
// rendered as "no files here" is the empty-observation narrow at the point where the denominator is
// built -- the failure would shrink the universe, which is the precise defect this denominator was
// added to close, committed by the thing closing it.
fn module_inventory_for_root(root: String) -> ModuleInventoryRead {
  let found = shell.Find.FilesByNameSorted(root: root, name_glob: "*.dag")
  if !found.success {
    ModuleInventoryUnreadable { root: root, cause: found.stderr }
  } else {
    ModuleInventoryFiles { paths: inventory_lines(stdout: found.stdout) }
  }
}

fn module_inventory(roots: List<String>) -> ModuleInventoryRead {
  fold(
    roots,
    init: ModuleInventoryFiles { paths: [] },
    f: (acc, root) =>
      match acc {
        ModuleInventoryUnreadable { root: r, cause: c } => ModuleInventoryUnreadable { root: r, cause: c }
        ModuleInventoryFiles { paths: so_far } =>
          match module_inventory_for_root(root: root) {
            ModuleInventoryUnreadable { root: r, cause: c } => ModuleInventoryUnreadable { root: r, cause: c }
            ModuleInventoryFiles { paths: more } => ModuleInventoryFiles { paths: concat(so_far, more) }
          }
      }
  )
}

// An empty `entries` is WHOLE-ROSTER and not an empty subset. That is the one place the two could
// have been conflated, and the coproduct is what keeps them apart all the way to the report.
fn subject_selection(entries: String, roster: List<String>) -> SubjectSelection {
  if entries == "" {
    SelectionWholeRoster
  } else {
    SelectionSubset {
      entries: filter(split(s: entries, delimiter: ","), e => e != "")
    }
  }
}

fn measure_selected(selection: List<String>) -> List<EmissionMeasurement> {
  map(selection, entry => measure_entry_emission(entry: entry))
}

// ONE SELECTION, READ TWICE. The list the instrument is invoked over and the selection the fold
// classifies against are derived from the same value rather than computed twice from `entries` --
// two derivations could disagree, and a disagreement here would render as an UNMEASURED subject
// the run had in fact measured, which is the precise confusion the selection carrier removes.
fn run_emit_subject_clean_ratchet(
  entries: String,
  roster: List<String>,
  inventory: List<String>
) -> EmitSubjectCleanRatchet {
  let selection = subject_selection(entries: entries, roster: roster)
  fold_emit_subject_clean_ratchet(
    universe: DualUniverse {
      policy: emit_subject_clean_roster_policy,
      entries: roster,
      inventory: inventory
    },
    admissions: emit_subject_clean_admissions,
    selection: selection,
    measurements: measure_selected(
      selection: subject_selection_entries(selection: selection, roster: roster)
    )
  )
}

// ---------------------------------------------------------------------------------------------
// THE ATTEMPT, WHICH IS WHERE THE HOST HALF'S EXECUTION PROVENANCE LIVES.
//
// Two things can go wrong before a fold exists at all: the roster cannot be read, or a source root
// cannot be listed. Neither is a standing about the corpus and neither may be folded into one -- a
// run that never reached the fold and a run that folded and found nothing are the two states DESIGN
// says must not render alike, and here they are separated at the point where the difference is
// still knowable. Below this line every consumer holds a fold or a typed cause, never a silence.
// ---------------------------------------------------------------------------------------------
type RatchetRunAttempt
  = RatchetRunFolded { ratchet: EmitSubjectCleanRatchet }
  | RatchetRunUnattempted { cause: String }

fn attempt_emit_subject_clean_ratchet(entries: String) -> RatchetRunAttempt {
  match emit_ratchet_roster() {
    EmitRatchetRosterUnreadable { cause: c } =>
      RatchetRunUnattempted { cause: concat("the entry roster could not be read — ", c) }
    EmitRatchetRosterEntries { entries: roster } =>
      match module_inventory(roots: witness_layer_roots) {
        ModuleInventoryUnreadable { root: rt, cause: c } =>
          RatchetRunUnattempted {
            cause: concat(
              concat("the file inventory could not list ", rt),
              concat(
                " — refusing rather than folding an unreadable root into an empty one: ",
                c
              )
            )
          }
        ModuleInventoryFiles { paths: inventory } =>
          RatchetRunFolded {
            ratchet: run_emit_subject_clean_ratchet(
              entries: entries,
              roster: roster,
              inventory: inventory
            )
          }
      }
  }
}

fn write_ratchet_report(report: String, r: EmitSubjectCleanRatchet) -> Bool {
  Filesystem.Write(path: report, content: emit_ratchet_report_text(r: r)).success
}

// ---------------------------------------------------------------------------------------------
// THE CLI SURFACE: TWO VERBS, BECAUSE ENROLMENT IS TWO QUESTIONS.
//
//   gunbc run --source-root dag --source-root src/v2 \
//     --entry dag/tools/emit_subject_clean_ratchet.dag --function observe \
//     --arg entries=dag/std/logic.dag --arg report=/tmp/ratchet.tsv
//
// The report is WRITTEN rather than returned for the same reason the instrument's is: `gunbc run`
// maps a returned value to an exit status and has no value-printing verb.
//
// `observe` REPORTS AND DOES NOT JUDGE THE CORPUS. Its exit status answers one question and it is
// not the one a reader expects: did the observation happen. A refusing standing -- a regressed
// entry, a stale admission row, a subject with no verdict -- exits SUCCESS, because the observation
// succeeded and its content is bad news that belongs in the report a human reads. What exits
// FAILURE is being unable to observe: the roster unreadable, a source root unlistable, the report
// unwritable, or a universe of no subjects. That is the split DESIGN's execution-provenance row
// demands, placed on the one channel a CI step actually reads.
//
// `check` IS THE GATE VERB AND IT REFUSES TO BE ONE TODAY. It routes through the enrolment
// admission first, so a consumer that wires it into a merge decision receives a typed refusal
// naming what disqualifies the carrier -- a single denominator, or roster subjects with no verdict
// at all -- rather than a verdict computed over a universe the fold could not evaluate. The
// refusal is a construction rather than a note precisely because no `Accepted` program can read a
// note, and the note is what this repository has already watched fail.
// ---------------------------------------------------------------------------------------------
fn observe(entries: String, report: String) -> ProcessExit {
  if report == "" {
    exit_failure(reason: "observe: --arg report=<path> is required — the observation is written, not printed")
  } else {
    match attempt_emit_subject_clean_ratchet(entries: entries) {
      RatchetRunUnattempted { cause: c } =>
        exit_failure(reason: concat("observe: the observation was not taken — ", c))
      RatchetRunFolded { ratchet: r } =>
        if !write_ratchet_report(report: report, r: r) {
          exit_failure(
            reason: concat(
              "observe: the observation was taken and could not be written to ",
              report
            )
          )
        } else {
          match emit_ratchet_observation(r: r) {
            ObservationTaken { roster: _, standing: _ } => ExitSuccess
            ObservationNotTaken { admission: a } =>
              exit_failure(
                reason: concat(
                  "observe: the observation was not taken — ",
                  emit_ratchet_enrolment_admission_text(admission: a)
                )
              )
          }
        }
    }
  }
}

fn check(entries: String, report: String) -> ProcessExit {
  if report == "" {
    exit_failure(reason: "check: --arg report=<path> is required — the standing is written, not printed")
  } else {
    match attempt_emit_subject_clean_ratchet(entries: entries) {
      RatchetRunUnattempted { cause: c } =>
        exit_failure(reason: concat("check: ", c))
      RatchetRunFolded { ratchet: r } =>
        if !write_ratchet_report(report: report, r: r) {
          exit_failure(reason: concat("check: could not write the standing to ", report))
        } else {
          match emit_ratchet_enrolment_admission(enrolment: EnrolledAsGate, r: r) {
            EnrolmentPermitted { enrolment: _ } => check_standing(r: r, report: report)
            EnrolmentRefusedNoUniverse { enrolment: e } =>
              exit_failure(
                reason: concat(
                  "check: this carrier may not decide a merge — ",
                  emit_ratchet_enrolment_admission_text(
                    admission: EnrolmentRefusedNoUniverse { enrolment: e }
                  )
                )
              )
            EnrolmentRefusedDenominator { enrolment: e, missing: m } =>
              exit_failure(
                reason: concat(
                  "check: this carrier may not decide a merge — ",
                  emit_ratchet_enrolment_admission_text(
                    admission: EnrolmentRefusedDenominator { enrolment: e, missing: m }
                  )
                )
              )
            EnrolmentRefusedUnevaluated { enrolment: e, subjects: ss } =>
              exit_failure(
                reason: concat(
                  "check: this carrier may not decide a merge — ",
                  emit_ratchet_enrolment_admission_text(
                    admission: EnrolmentRefusedUnevaluated { enrolment: e, subjects: ss }
                  )
                )
              )
          }
        }
    }
  }
}

fn check_standing(r: EmitSubjectCleanRatchet, report: String) -> ProcessExit {
  match emit_ratchet_standing(r: r) {
    EmitRatchetHeld { subject_count: _ } => ExitSuccess
    EmitRatchetRefused { failing_rows: rows } =>
      exit_failure(
        reason: concat(
          concat("check: the emit-subject clean ratchet refused — ", to_string(count(rows))),
          concat(" row(s), named in ", report)
        )
      )
  }
}
