module gunbc.tools.frontier_ingestion_probe

import v2.std.text { String }
import v2.std.logic { Bool }
import v2.std.algebra { fold_list }
import v2.std.collection { List }
import v2.std.node { Symbol }
import v2.std.grammar { ParseTree }
import v2.std.diagnostic { Diagnostic, NonEmptyDiagnostics }
import v2.std.compilers.lexing { lex_artifact_semantic_tokens }
import v2.compiler.tokenize { lex_walk_artifact }
import v2.compiler.parse { parse_module, ParseArtifact }
import v2.compiler.normalize { normalize }
import v2.extdeps.languages.dag { dag_lex_rules, dag_grammar }
import extdeps.filesystem.filesystem_io

data frontier_read_refusal_disposition_note: String = "WHY THERE IS NO READ-REFUSAL ARM HERE, and what is owed instead. A read refusal collapsing into a frontend verdict would be the empty-observation conflation one layer earlier than the one this instrument guards, so it was worth checking. It is not reachable through this primitive: the seed's filesystem_read returns FilesystemReadResult, declared in v1_method filesystem_read_result_type and emitted by v1.runtime_rust rt_filesystem, and that record carries EXACTLY ONE field, content. There is no success or error field to consult — the service-level Filesystem.Read operation is a different carrier with a different shape, and reading its three-field contract onto this primitive would be a citation to the wrong authority.\n\nWhat the primitive does on failure is panic: rt_filesystem calls read_to_string with unwrap_or_else(|e| panic!). So a missing or unreadable member aborts the run loudly rather than presenting as LEX, PARSE or ACCEPTED, and a guard branching on a success flag this record does not carry would be machinery with no producer — a scaffold defending against a state the type cannot express.\n\nWHAT IS OWED: the primitive has no TYPED refusal, only an abort. A caller cannot distinguish absent from unreadable from empty, and cannot continue past either. That is a real modeling gap in the primitive rather than in this probe, and it dissolves when filesystem_read returns an outcome instead of panicking — at which point this fn gains a refusal arm and a discriminating control, both of which would be untestable today."

data frontier_ingestion_probe_note: String = "THE REPRODUCTION INSTRUMENT for docs/plans/v2-frontend-std-ingestion-frontier-exact-head.md, deliberately homed OUTSIDE a *_test.dag module. Its per-member fns read the live tree and report which frontend stage a std module currently reaches. That reading is a revision-scoped OBSERVATION of the present frontier, not a claim that must hold: promoting it to a test declaration would enroll an assertion whose success depends on the current defects continuing to exist, so it would go RED on the repair and GREEN on a regression. The durable claims — that the stage classifier separates its states and that reasons are read by containment — live in gunbc.test.claim.normalize_retention_contract_probe_test and import classify_source from here, so there is one classifier authority and not two.\n\nReason reads are CONTAINMENT reads, never head reads: rejected_with_pending PREPENDS accepted-carrier diagnostics (the wrapper-retention carriers, which are not failures) to a later rejection, so the head of the list is systematically the retention carrier rather than the cause.\n\nStages are DISTINCT STATES. An earlier draft returned an empty reason list for both 'normalize accepted' and 'lex/parse rejected', which is the empty-observation narrow: an unlexable member read as an accepted one. classify_source matches each stage's Outcome in sequence so that collapse is unrepresentable."

fn artifact_tree(artifact: ParseArtifact) -> ParseTree {
  artifact.tree
}

fn diagnostic_reason(d: Diagnostic) -> Symbol {
  d.reason
}

fn all_reasons(d: NonEmptyDiagnostics) -> List<Symbol> {
  fold_list(xs: d.tail, empty: [diagnostic_reason(d: d.head)], cons: fn(acc, item) {
    concat(acc, [diagnostic_reason(d: item)])
  })
}

fn reasons_contain(reasons: List<Symbol>, sym: Symbol) -> Bool {
  fold_list(xs: reasons, empty: false, cons: fn(acc, r) {
    acc || (r == sym)
  })
}

// An EMPTY reason set is not an accepted stage; it is an impossible input. classify_source
// handles a genuine Accepted outcome before ever calling here, and a rejection carries
// NonEmptyDiagnostics, so production cannot supply an empty list. Mapping empty to ACCEPTED
// would render a missing observation as a successful stage — the same collapse this instrument
// exists to remove. It is its own invalid state, and deliberately NOT NORM_OTHER, which would
// only move the collapse somewhere quieter. The structurally strongest form takes
// NonEmptyDiagnostics directly; that is owed with the census instrument.
fn classify_normalize_reasons(rs: List<Symbol>) -> String {
  if (rs |> count) == 0 {
    "NORM_REASON_SET_INVALID_EMPTY"
  } else if reasons_contain(reasons: rs, sym: ^namespace_graft_body_dissolved_refused) {
    "NORM_GRAFT_REFUSED"
  } else if reasons_contain(reasons: rs, sym: ^body_lowering_reason_wrapper_retained_emitted)
    && reasons_contain(reasons: rs, sym: ^normalize_reason_post_normalize_not_well_formed) {
    "NORM_RETAINED"
  } else {
    "NORM_OTHER"
  }
}

fn classify_source(source: String) -> String {
  match lex_walk_artifact(source: source, file: ^frontier_probe, rules: dag_lex_rules()) {
    v2.std.diagnostic.Rejected { diagnostics: _ } => "LEX"
    v2.std.diagnostic.Accepted { value: a, diagnostics: _ } =>
      match parse_module(tokens: lex_artifact_semantic_tokens(artifact: a), grammar: dag_grammar()) {
        v2.std.diagnostic.Rejected { diagnostics: _ } => "PARSE"
        v2.std.diagnostic.Accepted { value: artifact, diagnostics: _ } =>
          match normalize(parse_tree: artifact_tree(artifact: artifact)) {
            v2.std.diagnostic.Accepted { value: _, diagnostics: _ } => "ACCEPTED"
            v2.std.diagnostic.Rejected { diagnostics: d } =>
              classify_normalize_reasons(rs: all_reasons(d: d))
          }
      }
  }
}

fn classify_member(path: String) -> String {
  let r = filesystem_read(path: path)
  classify_source(source: r.content)
}

fn m_entry() -> String { classify_member(path: "src/v2/test/claim/manual/cross_tree_constructor_binding_test.dag") }
fn m_primitives() -> String { classify_member(path: "dag/std/primitives.dag") }
fn m_collection() -> String { classify_member(path: "src/v2/std/collection.dag") }
fn m_witness() -> String { classify_member(path: "src/v2/std/witness.dag") }
fn m_types() -> String { classify_member(path: "dag/std/types.dag") }
fn m_node() -> String { classify_member(path: "src/v2/std/node.dag") }
fn m_content_hash() -> String { classify_member(path: "dag/std/content_hash.dag") }
fn m_dag_algebra() -> String { classify_member(path: "dag/std/algebra.dag") }
fn m_v2_algebra() -> String { classify_member(path: "src/v2/std/algebra.dag") }
fn m_logic() -> String { classify_member(path: "src/v2/std/logic.dag") }
fn m_optional() -> String { classify_member(path: "src/v2/std/optional.dag") }
fn m_diagnostic() -> String { classify_member(path: "src/v2/std/diagnostic.dag") }
fn m_occurrence() -> String { classify_member(path: "dag/std/occurrence_identity.dag") }
fn m_live_tree() -> String { classify_member(path: "src/v2/std/live_tree.dag") }
fn m_error_primitives() -> String { classify_member(path: "dag/std/error_primitives.dag") }

data wall_attribution_probe_note: String = "MINIMAL-PAIR PROBES for the two frontend walls that are still hypotheses rather than findings. Neither may become a finding from a description: the roadmap row's own RED control refuses a repair asserted separable without execution, and the em-dash misattribution earlier in this lane is the standing receipt for why. Each fn below is one construct in an otherwise-minimal module, so a refusal names the construct rather than the file."

fn p_hex_escape() -> String { classify_source(source: "module frontier_probe\n\ndata d: String = \"a\\x0db\"\n") }
fn p_hex_escape_control() -> String { classify_source(source: "module frontier_probe\n\ndata d: String = \"ab\"\n") }
fn p_qualified_record_ctor() -> String { classify_source(source: "module frontier_probe\n\nfn f() -> Int {\n  a.b.C { id: 1 }\n}\n") }
fn p_bare_record_ctor_control() -> String { classify_source(source: "module frontier_probe\n\nfn f() -> Int {\n  C { id: 1 }\n}\n") }
fn p_where_refinement() -> String { classify_source(source: "module frontier_probe\n\ntype H = String where lower_hex_16\n") }
fn p_type_alias_control() -> String { classify_source(source: "module frontier_probe\n\ntype H = String\n") }
