module tools.dag_compile_clean_shard_roster



type CompileCleanModuleDeclFact {
  module: String
  path: String
}

fn compile_clean_path_key_eq(a: String, b: String) -> Bool {
  a == b
}

fn compile_clean_decl_facts_to_keyed_rows(
  decl_facts: List<CompileCleanModuleDeclFact>
) -> List<std.keyed_row.KeyedRow<String, CompileCleanModuleDeclFact>> {
  map(decl_facts, decl => std.keyed_row.KeyedRow { row_key: decl.path, value: decl })
}

fn compile_clean_shard_roster_build_from(
  decl_facts: List<CompileCleanModuleDeclFact>
) -> std.keyed_roster.KeyedRosterBuild<String, CompileCleanModuleDeclFact> {
  std.keyed_roster.keyed_roster_build(
    incomings: compile_clean_decl_facts_to_keyed_rows(decl_facts: decl_facts),
    key_eq: compile_clean_path_key_eq,
  )
}

fn compile_clean_entry_module_facts() -> List<CompileCleanModuleDeclFact> {
  module_declaration_facts(pool_roots: compile_clean_partition_boundary().entry_roots)
}

fn compile_clean_module_shard_from_decl(decl: CompileCleanModuleDeclFact) -> tools.dag_compile_clean_partition.CompileCleanModuleShard {
  tools.dag_compile_clean_partition.CompileCleanModuleShard { entry_path: decl.path }
}

type CompileCleanModuleShardRoster
  = CompileCleanModuleShardRosterBuilt { shards: List<tools.dag_compile_clean_partition.CompileCleanModuleShard> }
  | CompileCleanModuleShardRosterDuplicatePath {
      path: String
      first: CompileCleanModuleDeclFact
      duplicate: CompileCleanModuleDeclFact
    }

type CompileCleanShardEntryPaths
  = CompileCleanShardEntryPathsBuilt { paths: List<String> }
  | CompileCleanShardEntryPathsDuplicatePath {
      path: String
      first: CompileCleanModuleDeclFact
      duplicate: CompileCleanModuleDeclFact
    }

fn compile_clean_module_shard_roster_from(
  decl_facts: List<CompileCleanModuleDeclFact>
) -> CompileCleanModuleShardRoster {
  match compile_clean_shard_roster_build_from(decl_facts: decl_facts) {
    KeyedRosterBuilt { rows: rows } =>
      CompileCleanModuleShardRosterBuilt {
        shards: map(rows, row => compile_clean_module_shard_from_decl(decl: row.value))
      }
    std.keyed_roster.KeyedRosterBuildDuplicateKey { key: k, first: f, duplicate: d } =>
      CompileCleanModuleShardRosterDuplicatePath {
        path: k,
        first: f.value,
        duplicate: d.value,
      }
  }
}

fn compile_clean_module_shard_roster() -> CompileCleanModuleShardRoster {
  compile_clean_module_shard_roster_from(decl_facts: compile_clean_entry_module_facts())
}

fn compile_clean_shard_entry_paths_from(
  decl_facts: List<CompileCleanModuleDeclFact>
) -> CompileCleanShardEntryPaths {
  match compile_clean_module_shard_roster_from(decl_facts: decl_facts) {
    CompileCleanModuleShardRosterBuilt { shards: shards } =>
      CompileCleanShardEntryPathsBuilt {
        paths: map(shards, shard => shard.entry_path)
      }
    CompileCleanModuleShardRosterDuplicatePath { path: p, first: f, duplicate: d } =>
      CompileCleanShardEntryPathsDuplicatePath { path: p, first: f, duplicate: d }
  }
}

fn compile_clean_shard_entry_paths() -> CompileCleanShardEntryPaths {
  compile_clean_shard_entry_paths_from(decl_facts: compile_clean_entry_module_facts())
}

fn list_contains_path(xs: List<String>, target: String) -> Bool {
  fold(xs, init: false, f: fn(found, p) { found || (p == target) })
}

fn witness_shard_roster_boundary_is_witness_layer_roots() -> Bool {
  compile_clean_partition_boundary().entry_roots == gunbc.ci_layer_roots.witness_layer_roots
}

data compile_clean_shard_roster_mechanism_fixture_facts: List<CompileCleanModuleDeclFact> = [
  CompileCleanModuleDeclFact { module: "fixture.alpha", path: "dag/fixture/alpha.dag" },
  CompileCleanModuleDeclFact { module: "fixture.beta", path: "dag/fixture/beta.dag" },
  CompileCleanModuleDeclFact { module: "fixture.gamma", path: "dag/fixture/gamma.dag" }
]

data compile_clean_shard_roster_mechanism_fixture_duplicate_facts: List<CompileCleanModuleDeclFact> = [
  CompileCleanModuleDeclFact { module: "fixture.alpha", path: "dag/fixture/alpha.dag" },
  CompileCleanModuleDeclFact { module: "fixture.alpha_reexport", path: "dag/fixture/alpha.dag" }
]

data compile_clean_shard_roster_mechanism_fixture_note: String = "Class C split (docs/plans/test-decomposition-wcf-cut.md §5, session bright-newt-31 2026-07-25): the shard-selection MECHANISM (roster construction via keyed_roster_build, nonempty, duplicate-key refusal) is proven per-PR on this small synthetic decl-fact fixture — no module_declaration_facts scan of the real ~1,700-file pool. The real corpus's roster claim (does the LIVE tree's roster stay nonempty/duplicate-free) is a corpus-totality claim, same class as compile_clean_shard_totality_holds_on_live_tree, and is not re-derived here; see the falsifier-rehomed row in gunbc.ci_layer_roots."

fn witness_roster_nonempty_on_fixture_facts() -> Bool {
  match compile_clean_module_shard_roster_from(
    decl_facts: compile_clean_shard_roster_mechanism_fixture_facts
  ) {
    CompileCleanModuleShardRosterBuilt { shards: shards } => list_length(items: shards) > 0
    CompileCleanModuleShardRosterDuplicatePath { path: _, first: _, duplicate: _ } => false
  }
}

fn witness_roster_build_admits_on_fixture_facts() -> Bool {
  match compile_clean_shard_roster_build_from(decl_facts: compile_clean_shard_roster_mechanism_fixture_facts) {
    KeyedRosterBuilt { rows: _ } => true
    std.keyed_roster.KeyedRosterBuildDuplicateKey { key: _, first: _, duplicate: _ } => false
  }
}

fn witness_roster_build_refuses_synthetic_duplicate_facts() -> Bool {
  match compile_clean_shard_roster_build_from(
    decl_facts: compile_clean_shard_roster_mechanism_fixture_duplicate_facts
  ) {
    KeyedRosterBuilt { rows: _ } => false
    std.keyed_roster.KeyedRosterBuildDuplicateKey { key: k, first: f, duplicate: d } =>
      k == "dag/fixture/alpha.dag"
        && f.value.module == "fixture.alpha"
        && d.value.module == "fixture.alpha_reexport"
  }
    && match compile_clean_module_shard_roster_from(
      decl_facts: compile_clean_shard_roster_mechanism_fixture_duplicate_facts
    ) {
      CompileCleanModuleShardRosterBuilt { shards: _ } => false
      CompileCleanModuleShardRosterDuplicatePath { path: p, first: f, duplicate: d } =>
        p == "dag/fixture/alpha.dag"
          && f.module == "fixture.alpha"
          && d.module == "fixture.alpha_reexport"
    }
    && match compile_clean_shard_entry_paths_from(
      decl_facts: compile_clean_shard_roster_mechanism_fixture_duplicate_facts
    ) {
      CompileCleanShardEntryPathsBuilt { paths: _ } => false
      CompileCleanShardEntryPathsDuplicatePath { path: p, first: f, duplicate: d } =>
        p == "dag/fixture/alpha.dag"
          && f.module == "fixture.alpha"
          && d.module == "fixture.alpha_reexport"
    }
}

fn witness_roster_empty_facts_are_not_nonempty() -> Bool {
  match compile_clean_module_shard_roster_from(decl_facts: []) {
    CompileCleanModuleShardRosterBuilt { shards: shards } => list_length(items: shards) == 0
    CompileCleanModuleShardRosterDuplicatePath { path: _, first: _, duplicate: _ } => false
  }
}

