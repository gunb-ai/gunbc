module tools.merge_admission_current_context



fn optional_env(name: std.types.NonEmptyStr) -> String? {
  let observed = shell.Env.Get(name: name)
  match observed.value {
    Present { value: raw } =>
      let value = trim(raw)
      if value == "" { none } else { Present { value: value } }
    Absent => none
  }
}

fn merge_admission_context_walk_attempt_id() -> gunbc.merge_admission_subject.WalkAttemptId? {
  match optional_env(name: "GUNBC_WALK_ATTEMPT_ID") {
    Present { value: explicit } => compose_explicit_walk_attempt_id(explicit: explicit)
    Absent =>
      compose_walk_attempt_id(
        run_id: match optional_env(name: "GITHUB_RUN_ID") {
          Present { value: value } => value
          Absent => ""
        },
        run_attempt: match optional_env(name: "GITHUB_RUN_ATTEMPT") {
          Present { value: value } => value
          Absent => ""
        },
        job: match optional_env(name: "GITHUB_JOB") {
          Present { value: value } => value
          Absent => ""
        },
      )
  }
}

fn denied_exit(verdict: gunbc.merge_admission.MergeAdmissionVerdict) -> std.process.ProcessExit {
  exit_failure(
    reason: concat(
      "merge_admission_current_context: blocked (",
      concat(merge_admission_verdict_label(v: verdict), ")")
    )
  )
}

func main() -> std.process.ProcessExit {
  let attempt = match merge_admission_context_walk_attempt_id() {
    Present { value: value } => value
    Absent => return exit_failure(reason: "merge_admission_current_context: walk attempt identity absent or invalid")
  }
  let root = git.Inspect.Toplevel().path as String
  let subject_read = Filesystem.Read(
    path: merge_admission_tested_subject_path(root: root, attempt_id: attempt)
  )
  if !subject_read.success {
    return exit_failure(reason: "merge_admission_current_context: tested-subject wire missing")
  }
  let subject = match parse_tested_subject_wire(text: subject_read.content) {
    Present { value: value } => value
    Absent => return exit_failure(reason: "merge_admission_current_context: tested-subject wire invalid")
  }
  let receipt_read = Filesystem.Read(
    path: merge_admission_floor_receipt_path(root: root, attempt_id: attempt)
  )
  if !receipt_read.success {
    return exit_failure(reason: "merge_admission_current_context: floor-receipt wire missing")
  }
  let receipt = match parse_receipt_wire_v2(text: receipt_read.content) {
    Present { value: value } => value
    Absent => return exit_failure(reason: "merge_admission_current_context: floor-receipt wire invalid")
  }
  let fetch_parts = git_remote_ref_parts(ref: merge_admission_merge_base_ref as std.types.GitRef)
  let fetched = git.Core.FetchNoTags(
    remote: fetch_parts.remote,
    ref: fetch_parts.ref_name,
    stall_deadline_seconds: tools.merge_admission_walk.merge_admission_fetch_stall_deadline_seconds
  )
  if !fetched.success {
    return exit_failure(reason: "merge_admission_current_context: current merge target fetch refused")
  }
  let observed = git.Inspect.ShowTree(ref: merge_admission_merge_base_ref as std.types.GitRef)
  if !observed.success {
    return exit_failure(reason: "merge_admission_current_context: current merge target tree observation refused")
  }
  let target = match git_decode_object_id_text(
    format: git_object_id_format(oid: receipt.tested_base_tree_hash),
    text: shell_stdout_line(raw: observed.tree),
  ) {
    GitObjectIdTextDecoded { oid: oid } => oid
    GitObjectIdTextRefused { cause: _ } =>
      return exit_failure(reason: "merge_admission_current_context: current merge target object id refused")
  }
  let verdict = classify_merge_admission_verdict_v2(
    current_attempt_id: attempt,
    tested_subject: subject,
    receipt: receipt,
    merge_target_tree_hash: target,
    current_roster_hash: current_gate_roster_hash,
  )
  match verdict {
    MergeAdmitted => ExitSuccess
    MergeDeniedStaleBase => denied_exit(verdict: verdict)
    MergeDeniedStaleRoster => denied_exit(verdict: verdict)
    MergeDeniedNotSuccess => denied_exit(verdict: verdict)
    MergeDeniedWrongAttempt => denied_exit(verdict: verdict)
    MergeDeniedSubjectMismatch => denied_exit(verdict: verdict)
  }
}
