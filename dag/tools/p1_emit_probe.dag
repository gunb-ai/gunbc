module tools.p1_emit_probe

import v2.compiler.ingest { cross_language_compile, parse_tree_to_target_model_bridge }
import v2.std.inhabitant_neutralization { neutralize_core_for_target }
import v2.compiler.infer { infer }
import v2.compiler.emit { emit }
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }
import v2.extdeps.languages.dag { dag_language_model, dag_target_model_lossless_fidelity_quotient }
import v2.extdeps.languages.rust { rust_target_model }
import v2.std.diagnostic { Outcome, Accepted, Rejected }

data live_tree_disposition: LiveTreeDisposition = ReadsLiveTree

// P1 PRODUCER PROBE. Answers ONE question by execution: does the v2 emitter's own semantics,
// executed under the v1 interpreter, reach an emitted Rust artifact for a REAL source file, or
// does it refuse first -- and if so, at WHICH stage.
//
// This is a transport, not a second compiler. Every stage called below is the existing v2 stage
// function; nothing here decides tokenization, parsing, normalization, resolution or translation.
// It writes no files: the producer question is answered by whether translate returns Accepted,
// and adding an effect surface would mix in failure modes that are not the subject.
//
// The stages are matched SEPARATELY rather than bound into one chain on purpose. The answer being
// measured is WHICH stage refuses; a single bind chain collapses five distinguishable refusals
// into one Rejected and discards exactly that fact.
//
// dissolve-on: a native v2 compile entry, or a modeled production transport consuming the same
// request. This probe has no consumer beyond the two-arm producer receipt it exists to produce.

fn p1_emit_probe(path: String) -> String {
  let lm = dag_language_model()
  let target = rust_target_model()
  let text = filesystem_read(path: path).content
  match tokenize(text: text, file: ^p1_probe_source_file, rules: lm.lex) {
    Rejected { diagnostics: d } => "REFUSED at tokenize"
    Accepted { value: toks } =>
      match parse(tokens: toks, grammar: lm.grammar) {
        Rejected { diagnostics: d } => "REFUSED at parse"
        Accepted { value: pt } =>
          match cross_language_compile(
            parse_tree: pt,
            source_model: dag_target_model_lossless_fidelity_quotient(),
            target_model: target
          ) {
            Rejected { diagnostics: d } =>
              concat("REFUSED in bridge/infer/emit, first reason: ", symbol_lexeme(sym: d.head.reason))
            Accepted { value: src } =>
              if string_length(s: src.carried) == 0 { "EMITTED but EMPTY" } else { "EMITTED nonempty" }
          }
      }
  }
}

fn p1_probe_eval() -> String {
  p1_emit_probe(path: "src/v2/compiler/05_eval.dag")
}

// Control: the same probe on a small real module. If the eval subject refuses at a stage but this
// one does not, the refusal is about that subject rather than about the probe being miswired.
fn p1_probe_small_control() -> String {
  p1_emit_probe(path: "dag/std/nat.dag")
}
