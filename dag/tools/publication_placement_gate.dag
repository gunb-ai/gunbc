module tools.publication_placement_gate

import std.types { Bool, CommitSha, FilePath, GitRef, Int, List, String }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import std.effect_grant {
  Publish, NamespacePosition, EffectAdmission, Admitted, EffectOutsideGrant,
  admit_effect, position_under,
}
import std.materialization_ladder { Frame }
import std.visibility_grant { world_audience }
import std.filesystem_path_grant { absolute_path_segments, repo_rel_path_position }
import extdeps.git {
  GitDiffStatusEntry, DiffAddedStatus, DiffCopiedStatus, DiffRenamedStatus,
  DiffUnknownGitStatus,
  GitDiffNameStatusComplete, GitDiffNameStatusTruncated,
  GitDiffNameStatusParsePending,
  AwaitingStatusToken, AwaitingSinglePath, AwaitingOldPath, AwaitingNewPath,
  TwoDot, git_diff_name_status_parse,
}
import extdeps.git
import gunbc.publication_grant {
  PublicRootPublishBaseline, SubtreePublishGrant, PublicPublicationGrantRoster,
  public_publication_grant_roster,
}
import gunbc.publication_cutover {
  public_publication_root, public_publication_cutover_sha,
}

data publication_placement_gate_note: String = "Server-side Stage-0 publication wall. Before observing a diff it validates the roster baseline against the fixed gunbc.publication_cutover authority, so a roster edit cannot advance the grandfathered corpus. It observes ONLY the mounted public checkout, computes new public paths whose cutover-to-HEAD git status is Added, Copied, or Renamed, resolves each path's nearest covering SubtreePublishGrant through the filesystem containment authority, and delegates the Publish World decision to std.effect_grant.admit_effect. Subtree defaults flow downward; a descendant may narrow its inherited audience, while a descendant that widens below a narrower ancestor is the local Rule 2 refusal SubtreePublishGrantWidensAncestor. A changed baseline, missing/ambiguous subtree defaults, duplicate roots, downward-closure violations, refused grants, git failures, truncated parses, and unknown statuses are distinct typed PublishGuardLocalViolation causes; none widens to a scan or proceeds. The coverage receipt names exactly the public mount, subtree defaults, and new paths checked. It makes no composed-graph PublishClosureGap claim. This becomes the enforcement wall when the operator makes the CI check required in branch protection; no client hook is an authority."

type PublishGuardPublicRootOnly {}

type PublishGuardOwnSubtreeDefaultsAndAddedPathsOnly {}

type PublishGuardBaselineMarkerChecked {}

type PublishGuardLocalCoverageReceipt {
  mount: PublishGuardPublicRootOnly
  coverage: PublishGuardOwnSubtreeDefaultsAndAddedPathsOnly
  root: FilePath
  cutover: String
  head: String
  baseline_marker: PublishGuardBaselineMarkerChecked
  subtree_grant_roots: List<FilePath>
  added_paths: List<FilePath>
}

type PublishGuardLocalViolation
  = BaselinePlacementPolicyNotPinned {
      declared_root: FilePath,
      pinned_root: FilePath,
      declared_cutover: CommitSha,
      pinned_cutover: CommitSha,
    }
  | BaselinePublishGrantRefused {
      root: FilePath,
      cutover: String,
      verb: std.effect_grant.Verb,
      target: NamespacePosition,
      frame: Frame,
    }
  | AddedPathSubtreeGrantAbsent {
      path: FilePath,
      root: FilePath,
      audience: NamespacePosition,
    }
  | SubtreePublishGrantRootRepeated {
      subtree_root: FilePath,
      root: FilePath,
    }
  | SubtreePublishGrantWidensAncestor {
      subtree_root: FilePath,
      ancestor_root: FilePath,
      root: FilePath,
    }
  | AddedPathPublishGrantAmbiguous {
      path: FilePath,
      root: FilePath,
      audience: NamespacePosition,
      marker_count: Int,
    }
  | AddedPathPublishGrantRefused {
      path: FilePath,
      root: FilePath,
      verb: std.effect_grant.Verb,
      target: NamespacePosition,
      frame: Frame,
    }
  | PublicRootDiffReadFailure {
      root: FilePath,
      cutover: String,
      head: String,
    }
  | PublicRootDiffParseTruncated {
      root: FilePath,
      cutover: String,
      head: String,
      pending: GitDiffNameStatusParsePending,
    }
  | PublicRootDiffStatusUnknown {
      path: FilePath,
      root: FilePath,
      cutover: String,
      head: String,
      raw_status: String,
    }

type PublishGuardLocalOutcome
  = PublishGuardLocalAccepted { receipt: PublishGuardLocalCoverageReceipt }
  | PublishGuardLocalRefused {
      receipt: PublishGuardLocalCoverageReceipt?,
      violations: List<PublishGuardLocalViolation>,
    }

type SubtreePublishGrantLookup
  = SubtreePublishGrantAbsent
  | SubtreePublishGrantFound { grant: SubtreePublishGrant, depth: Int }
  | SubtreePublishGrantAmbiguous { subtree_root: FilePath, marker_count: Int, depth: Int }

type SubtreeGrantAuditState {
  seen_roots: List<FilePath>
  violations: List<PublishGuardLocalViolation>
}

fn subtree_publish_grant_lookup(
  path: FilePath,
  grants: List<SubtreePublishGrant>,
  exclude_exact: Bool,
) -> SubtreePublishGrantLookup {
  fold(grants, init: SubtreePublishGrantAbsent, f: fn(state, row) {
    let covers = position_under(
      target: repo_rel_path_position(rel: path),
      root: repo_rel_path_position(rel: row.root),
    )
    if !covers || (exclude_exact && row.root == path) {
      state
    } else {
      let depth = absolute_path_segments(path: row.root).count()
      match state {
        SubtreePublishGrantAbsent => SubtreePublishGrantFound { grant: row, depth: depth }
        SubtreePublishGrantFound { grant: prior, depth: prior_depth } =>
          if depth > prior_depth {
            SubtreePublishGrantFound { grant: row, depth: depth }
          } else if depth == prior_depth {
            SubtreePublishGrantAmbiguous {
              subtree_root: row.root,
              marker_count: 2,
              depth: depth,
            }
          } else {
            state
          }
        SubtreePublishGrantAmbiguous { subtree_root: prior_root, marker_count: n, depth: prior_depth } =>
          if depth > prior_depth {
            SubtreePublishGrantFound { grant: row, depth: depth }
          } else if depth == prior_depth {
            SubtreePublishGrantAmbiguous {
              subtree_root: prior_root,
              marker_count: n + 1,
              depth: prior_depth,
            }
          } else {
            state
          }
      }
    }
  })
}

fn admission_refusal_for_baseline(
  baseline: PublicRootPublishBaseline,
  admission: EffectAdmission,
) -> List<PublishGuardLocalViolation> {
  match admission {
    Admitted { via_root: via_root } => []
    EffectOutsideGrant { verb: verb, target: target, frame: frame } => [
      BaselinePublishGrantRefused {
        root: baseline.root,
        cutover: baseline.cutover,
        verb: verb,
        target: target,
        frame: frame,
      }
    ]
  }
}

fn baseline_policy_violations(
  baseline: PublicRootPublishBaseline,
) -> List<PublishGuardLocalViolation> {
  if baseline.root == public_publication_root
    && baseline.cutover == public_publication_cutover_sha {
    []
  } else {
    [BaselinePlacementPolicyNotPinned {
      declared_root: baseline.root,
      pinned_root: public_publication_root,
      declared_cutover: baseline.cutover,
      pinned_cutover: public_publication_cutover_sha,
    }]
  }
}

fn admission_refusal_for_path(
  path: FilePath,
  root: FilePath,
  admission: EffectAdmission,
) -> List<PublishGuardLocalViolation> {
  match admission {
    Admitted { via_root: via_root } => []
    EffectOutsideGrant { verb: verb, target: target, frame: frame } => [
      AddedPathPublishGrantRefused {
        path: path,
        root: root,
        verb: verb,
        target: target,
        frame: frame,
      }
    ]
  }
}

fn envelope_publishes_world(grant: SubtreePublishGrant) -> Bool {
  match admit_effect(env: grant.envelope, verb: Publish, target: world_audience()) {
    Admitted { via_root: via_root } => true
    EffectOutsideGrant { verb: verb, target: target, frame: frame } => false
  }
}

fn downward_closure_violations(
  grant: SubtreePublishGrant,
  grants: List<SubtreePublishGrant>,
  root: FilePath,
) -> List<PublishGuardLocalViolation> {
  match subtree_publish_grant_lookup(path: grant.root, grants: grants, exclude_exact: true) {
    SubtreePublishGrantFound { grant: ancestor, depth: depth } =>
      if envelope_publishes_world(grant: grant) && !envelope_publishes_world(grant: ancestor) {
        [SubtreePublishGrantWidensAncestor {
          subtree_root: grant.root,
          ancestor_root: ancestor.root,
          root: root,
        }]
      } else {
        []
      }
    _ => []
  }
}

fn subtree_grant_audit(
  grants: List<SubtreePublishGrant>,
  root: FilePath,
) -> SubtreeGrantAuditState {
  fold(grants, init: SubtreeGrantAuditState { seen_roots: [], violations: [] }, f: fn(state, grant) {
    let repeated = any(state.seen_roots, seen => seen == grant.root)
    let repeated_violation = if repeated {
      [SubtreePublishGrantRootRepeated { subtree_root: grant.root, root: root }]
    } else {
      []
    }
    SubtreeGrantAuditState {
      seen_roots: if repeated { state.seen_roots } else { append(state.seen_roots, items: [grant.root]) },
      violations: append(
        append(state.violations, items: repeated_violation),
        items: downward_closure_violations(grant: grant, grants: grants, root: root),
      ),
    }
  })
}

fn added_path_violations(
  path: FilePath,
  roster: PublicPublicationGrantRoster,
) -> List<PublishGuardLocalViolation> {
  let audience = world_audience()
  match subtree_publish_grant_lookup(path: path, grants: roster.subtree_grants, exclude_exact: false) {
    SubtreePublishGrantAbsent => [AddedPathSubtreeGrantAbsent {
      path: path,
      root: roster.baseline.root,
      audience: audience,
    }]
    SubtreePublishGrantAmbiguous { subtree_root: subtree_root, marker_count: marker_count, depth: depth } => [AddedPathPublishGrantAmbiguous {
      path: path,
      root: roster.baseline.root,
      audience: audience,
      marker_count: marker_count,
    }]
    SubtreePublishGrantFound { grant: grant, depth: depth } => admission_refusal_for_path(
      path: path,
      root: roster.baseline.root,
      admission: admit_effect(env: grant.envelope, verb: Publish, target: audience),
    )
  }
}

fn subtree_publish_grant_roots(grants: List<SubtreePublishGrant>) -> List<FilePath> {
  map(grants, row => row.root)
}

fn publication_guard_local_check(
  roster: PublicPublicationGrantRoster,
  added_paths: List<FilePath>,
  head: String,
) -> PublishGuardLocalOutcome {
  let audience = world_audience()
  let baseline_violations = append(
    baseline_policy_violations(baseline: roster.baseline),
    items: admission_refusal_for_baseline(
      baseline: roster.baseline,
      admission: admit_effect(env: roster.baseline.envelope, verb: Publish, target: audience),
    ),
  )
  let marker_audit = subtree_grant_audit(
    grants: roster.subtree_grants,
    root: roster.baseline.root,
  )
  let path_violations = fold(added_paths, init: [], f: fn(acc, path) {
    append(acc, items: added_path_violations(path: path, roster: roster))
  })
  let violations = append(
    append(baseline_violations, items: marker_audit.violations),
    items: path_violations,
  )
  let receipt = PublishGuardLocalCoverageReceipt {
    mount: PublishGuardPublicRootOnly {},
    coverage: PublishGuardOwnSubtreeDefaultsAndAddedPathsOnly {},
    root: roster.baseline.root,
    cutover: roster.baseline.cutover,
    head: head,
    baseline_marker: PublishGuardBaselineMarkerChecked {},
    subtree_grant_roots: subtree_publish_grant_roots(grants: roster.subtree_grants),
    added_paths: added_paths,
  }
  if violations.count() == 0 {
    PublishGuardLocalAccepted { receipt: receipt }
  } else {
    PublishGuardLocalRefused { receipt: Present { value: receipt }, violations: violations }
  }
}

fn added_paths_from(entries: List<GitDiffStatusEntry>) -> List<FilePath> {
  fold(entries, init: [], f: fn(paths, entry) {
    match entry.status {
      DiffAddedStatus => append(paths, items: [entry.path])
      DiffCopiedStatus { similarity: similarity } => append(paths, items: [entry.path])
      DiffRenamedStatus { similarity: similarity } => append(paths, items: [entry.path])
      _ => paths
    }
  })
}

fn unknown_status_violations(
  entries: List<GitDiffStatusEntry>,
  baseline: PublicRootPublishBaseline,
  head: String,
) -> List<PublishGuardLocalViolation> {
  fold(entries, init: [], f: fn(violations, entry) {
    match entry.status {
      DiffUnknownGitStatus { raw: raw } => append(violations, items: [PublicRootDiffStatusUnknown {
        path: entry.path,
        root: baseline.root,
        cutover: baseline.cutover,
        head: head,
        raw_status: raw,
      }])
      _ => violations
    }
  })
}

fn observe_publication_guard_local(
  roster: PublicPublicationGrantRoster,
  head: String,
) -> PublishGuardLocalOutcome {
  let baseline = roster.baseline
  let policy_violations = baseline_policy_violations(baseline: baseline)
  if policy_violations.count() > 0 {
    PublishGuardLocalRefused { receipt: Absent, violations: policy_violations }
  } else {
    let diff = git.Core.DiffNameStatus(
      base: public_publication_cutover_sha as GitRef,
      head: head as GitRef,
      range: TwoDot,
    )
    if !diff.success {
    PublishGuardLocalRefused {
      receipt: Absent,
      violations: [PublicRootDiffReadFailure {
        root: baseline.root,
        cutover: baseline.cutover,
        head: head,
      }],
    }
    } else {
      match git_diff_name_status_parse(raw: diff.raw) {
      GitDiffNameStatusTruncated { pending: pending, entries: entries } => PublishGuardLocalRefused {
        receipt: Absent,
        violations: [PublicRootDiffParseTruncated {
          root: baseline.root,
          cutover: baseline.cutover,
          head: head,
          pending: pending,
        }],
      }
      GitDiffNameStatusComplete { entries: entries } => {
        let unknown = unknown_status_violations(entries: entries, baseline: baseline, head: head)
        if unknown.count() > 0 {
          PublishGuardLocalRefused { receipt: Absent, violations: unknown }
        } else {
          publication_guard_local_check(
            roster: roster,
            added_paths: added_paths_from(entries: entries),
            head: head,
          )
        }
      }
      }
    }
  }
}

fn render_diff_parse_pending(pending: GitDiffNameStatusParsePending) -> String {
  match pending {
    AwaitingStatusToken => "AwaitingStatusToken"
    AwaitingSinglePath { status: status } => "AwaitingSinglePath"
    AwaitingOldPath { status: status } => "AwaitingOldPath"
    AwaitingNewPath { status: status, old_path: old_path } => "AwaitingNewPath"
  }
}

fn render_publish_guard_local_violation(violation: PublishGuardLocalViolation) -> String {
  match violation {
    BaselinePlacementPolicyNotPinned { declared_root, pinned_root, declared_cutover, pinned_cutover } =>
      join(["publication baseline is not the pinned policy: declared_root=", declared_root, " pinned_root=", pinned_root, " declared_cutover=", declared_cutover, " pinned_cutover=", pinned_cutover], "")
    BaselinePublishGrantRefused { root, cutover, verb, target, frame } =>
      join(["baseline Publish World grant refused: root=", root, " cutover=", cutover, " frame=", frame.name], "")
    AddedPathSubtreeGrantAbsent { path, root, audience } =>
      join(["added public path has no covering publication subtree: path=", path, " root=", root], "")
    AddedPathPublishGrantAmbiguous { path, root, audience, marker_count } =>
      join(["added public path has ambiguous publication grants: path=", path, " root=", root, " markers=", to_string(marker_count)], "")
    SubtreePublishGrantRootRepeated { subtree_root, root } =>
      join(["publication subtree root is repeated: subtree_root=", subtree_root, " root=", root], "")
    SubtreePublishGrantWidensAncestor { subtree_root, ancestor_root, root } =>
      join(["publication subtree widens its nearest ancestor: subtree_root=", subtree_root, " ancestor_root=", ancestor_root, " root=", root], "")
    AddedPathPublishGrantRefused { path, root, verb, target, frame } =>
      join(["added public path is not granted Publish World: path=", path, " root=", root, " frame=", frame.name], "")
    PublicRootDiffReadFailure { root, cutover, head } =>
      join(["public-root git.Core.DiffNameStatus failed: root=", root, " cutover=", cutover, " head=", head], "")
    PublicRootDiffParseTruncated { root, cutover, head, pending } =>
      join(["public-root name-status parse truncated: root=", root, " cutover=", cutover, " head=", head, " pending=", render_diff_parse_pending(pending: pending)], "")
    PublicRootDiffStatusUnknown { path, root, cutover, head, raw_status } =>
      join(["public-root name-status unknown: path=", path, " root=", root, " cutover=", cutover, " head=", head, " status=", raw_status], "")
  }
}

fn render_publish_guard_receipt(receipt: PublishGuardLocalCoverageReceipt) -> String {
  join([
    "checked public mount only: root=", receipt.root,
    " cutover=", receipt.cutover,
    " head=", receipt.head,
    " baseline_marker=checked",
    " subtree_defaults=", to_string(receipt.subtree_grant_roots.count()),
    " subtree_grant_roots=[", join(receipt.subtree_grant_roots, ","), "]",
    " additions=", to_string(receipt.added_paths.count()),
    " added_paths=[", join(receipt.added_paths, ","), "]",
    " composed_graph_closure=not_checked",
  ], "")
}

fn publication_guard_process_exit(outcome: PublishGuardLocalOutcome) -> ProcessExit {
  match outcome {
    PublishGuardLocalAccepted { receipt: receipt } => ExitSuccess
    PublishGuardLocalRefused { receipt: receipt, violations: violations } => {
      let rendered = join(map(violations, violation => render_publish_guard_local_violation(violation: violation)), " | ")
      let coverage = match receipt {
        Present { value: value } => render_publish_guard_receipt(receipt: value)
        Absent => "coverage receipt unavailable because public-root observation refused"
      }
      exit_failure(reason: join([
        "PublishGuardLocalViolation count=", to_string(violations.count()),
        ": ", rendered, " — ", coverage,
      ], ""))
    }
  }
}

func run_publication_placement_gate() -> ProcessExit {
  publication_guard_process_exit(
    outcome: observe_publication_guard_local(
      roster: public_publication_grant_roster,
      head: "HEAD",
    ),
  )
}

func main() -> ProcessExit {
  run_publication_placement_gate()
}
