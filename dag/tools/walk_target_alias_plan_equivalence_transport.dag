module tools.walk_target_alias_plan_equivalence_transport

import tools.host_prelude { run_witness_bin }
import tools.walk_target_alias_plan {
  walk_target_alias_plan_row_eq,
  WalkTargetAliasPlanRow,
  WalkTargetAliasPlanRowKey,
  GlobalBareLcp,
  FnParentFirstHit
}
import v2.std.logic { Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data wtaa_plan_equivalence_doc: String = "Phase 7 (#6984 fold-in, operator ruling msg_b6c9153f): PLACEHOLDER for the dual-run equivalence gate — NOT yet the gate itself. The wet Rust arm (seed-retained walk_target_alias_plan bin) is NOT ingested into any comparison here, so nothing in this module can go red on a real Rust/.dag divergence. wtaa_plan_equivalence_pure_arm_self_consistent only checks that a pure-arm golden WalkTargetAliasPlanRow is self-consistent under walk_target_alias_plan_row_eq (reflexivity) — green here does NOT establish equivalence and does NOT gate Phase 7 Rust deletion (§5: green must not read as a dual-run receipt). Dissolution (wtaa_plan_equivalence_placeholder_scaffold): wire the wet arm's captured rows into a real dual-run comparison once walk_target_alias_plan_from_census lands in .dag (seed-gap row 1)."

data wtaa_plan_equivalence_placeholder_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "tools.walk_target_alias_plan_equivalence_transport",
    decl_name: "wtaa_plan_equivalence_pure_arm_self_consistent",
    field: WholeDeclaration
  }
}

fn walk_target_alias_plan_equivalence_golden_global_bare_lcp() -> WalkTargetAliasPlanRow {
  WalkTargetAliasPlanRow {
    key: WalkTargetAliasPlanRowKey {
      class: GlobalBareLcp,
      declaring_module: "test.aliasplan.near.consumer",
      binding: "AmbigType",
      walk_target_qualified_path: "test.aliasplan.near.AmbigType"
    },
    pre_flip_qualified_path: "test.aliasplan.near.AmbigType",
    walk_verified: true,
    lookup_events: 1
  }
}

fn walk_target_alias_plan_equivalence_golden_fn_parent() -> WalkTargetAliasPlanRow {
  WalkTargetAliasPlanRow {
    key: WalkTargetAliasPlanRowKey {
      class: FnParentFirstHit,
      declaring_module: "test.aliasplan.fn_parent.leaf",
      binding: "shared_pick",
      walk_target_qualified_path: "test.aliasplan.fn_parent.a.shared_pick"
    },
    pre_flip_qualified_path: "test.aliasplan.fn_parent.a.shared_pick",
    walk_verified: true,
    lookup_events: 1
  }
}

fn wtaa_plan_equivalence_pure_arm_self_consistent() -> Bool {
  let g = walk_target_alias_plan_equivalence_golden_global_bare_lcp()
  walk_target_alias_plan_row_eq(a: g, b: g)
}

fn run_walk_target_alias_plan_bin_smoke() -> Bool {
  run_witness_bin(
    var_name: "WALK_TARGET_ALIAS_PLAN",
    bin_name: "walk_target_alias_plan",
    args: ["--source-root", "dag/std"]
  )
}

fn run_walk_target_alias_plan_equivalence_witness() -> Bool {
  wtaa_plan_equivalence_pure_arm_self_consistent()
}
