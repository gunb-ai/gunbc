module tools.self_host_curated_probe_cargo

import extdeps.git
import extdeps.git.inspect
import extdeps.filesystem.filesystem_io { Filesystem }
import std.process { ProcessExit, ExitSuccess, exit_failure }
import tools.self_host_curated_seed_linked_harness { cssl_v1_compiled_probe_lib_cargo_toml }

data curated_probe_cargo_scaffold_note: String = "SCAFFOLD — dissolve-on: deletes when cssl exposes probe-lib manifest projection or bash-emit #5828 realizes curated_cargo_probe_one transport. Single authority: cssl_v1_compiled_probe_lib_cargo_toml (tools.self_host_curated_seed_linked_harness). Host export is ProcessExit-shaped (out_path write) because gunbc run maps only ProcessExit to a process status (#8286); a String return refuses as NotProcessExit and the probe harness reads that as down."

fn curated_probe_cargo_toml_from_cssl_authority(out_path: String) -> ProcessExit {
  let root = git.Inspect.Toplevel()
  let content = cssl_v1_compiled_probe_lib_cargo_toml(root: root.path)
  if content == "" {
    exit_failure(reason: "curated_probe_cargo_toml_from_cssl_authority: refused empty export")
  }
  let w = Filesystem.Write(path: out_path, content: content)
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat(concat("write failed for ", out_path), concat(": ", w.error)))
  }
}
