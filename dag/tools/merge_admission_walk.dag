module tools.merge_admission_walk

import std.types { GitRef, Seconds, String }
import extdeps.git { git_remote_ref_parts }
import extdeps.git
import extdeps.git.inspect
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.github.checks { Success }
import gunbc.merge_admission {
  MergeAdmissionReceiptV2,
  MergeAdmitted,
  classify_merge_admission_verdict_v2,
  current_gate_roster_hash,
}
import gunbc.merge_admission_subject {
  TestedSubject,
  WalkAttemptId,
  merge_admission_floor_receipt_path,
  merge_admission_merge_base_ref,
  merge_admission_tested_subject_path,
  parse_tested_subject_wire,
}
import gunbc.merge_admission_produce {
  MergeTargetTreeHashOk,
  MergeTargetTreeHashRefused,
  observe_merge_target_tree_hash,
  parse_receipt_wire_v2,
  render_receipt_wire_v2,
}
import gunbc.ci_failure_class { merge_freshness_verdict_is_consumed_to_block }
import tools.merge_admission_capture { current_walk_attempt_id, observed_git_object_id }

data merge_admission_walk_note: String = "The live merge-admission path is an ordinary first-batch capture followed by stamp_tested_floor and refresh_current_target_and_gate as two singleton success stages in ONE shared stage entry. Capture has a smaller entry because it consumes only walk-attempt/tested-subject identity; importing the downstream classifier and commit-roster closure before discovery made the authored Negligible profile false in production. The WalkPlan carries two ordering laws instead of shell: stamp is reachable only after the whole ordinary floor and its finalization passed, and stage 2 is unreachable until stage 1 passed. The two non-heavy claims take spawned lanes, so each stage may resolve the entry independently; the disk-visible stage-1 receipt is the intentional barrier, not an in-memory memo promise. The stage-2 claim stays composite because fetch MUST precede classification; two sibling claims would have no ordering guarantee."

data merge_admission_checkout_ancestry_note: String = "The tested base is captured from the CHECKOUT'S ancestry, never from the moving target ref. On pull_request and merge_group, GitHub checks out the synthetic merge result: HEAD is the exact tree the floor tests and HEAD^1 is the target-side parent whose tree that result was built on. On push and workflow_dispatch, HEAD itself is the tested target tree. The captured subject persists that object id before substantive floor work. Stamp reads this file and does not re-read HEAD or the target; stage 2 alone fetches the CURRENT target, then compares it with the captured tree. A target advance during the floor therefore produces StaleBase instead of a receipt claiming the new target was tested."

data merge_admission_pr_number_deferred_note: String = "MergeAdmissionReceiptV2.pr_number is optional and is not an admission key: attempt, head, base tree, roster, and conclusion are the complete classifier inputs. The retired cold stamp process parsed GITHUB_EVENT_PATH through retained jq shell solely to populate this display field. The warm path deliberately writes Absent rather than carry that shell transport into the runtime-present claim. dissolve-on: a typed GitHub event payload projection supplies the optional number; admission behavior is unchanged because no verdict arm reads it."

data merge_admission_current_main_cold_baseline_note: String = "CURRENT-MAIN BEFORE RECEIPT (not the stale pre-unification estimate): GitHub Actions run 30671526012, job 91291716818, head ddbc5fd6aa, 2026-07-31. The cold stamp process occupied 94.26s from the floor group's final receipt at 23:28:39.602Z through ExitSuccess at 23:30:13.861Z. The separate gate step occupied 102.87s from its step start at 23:30:16.977Z through ExitSuccess at 23:31:59.849Z. Combined merge-admission cold-process wall was therefore 197.13s per PR on that current-main receipt. The after number must come from this PR's own on-success receipt; no projected saving is asserted here."

data merge_admission_fetch_stall_deadline_seconds: Seconds = 240 as Seconds

data merge_admission_fetch_deadline_note: String = "Stage 2 reserves five minutes for the whole postcondition population and gives FetchNoTags a stricter typed 240-second no-progress deadline. The git transport binds that value to http.lowSpeedTime with a one-byte-per-second floor, so a stalled remote read returns through FetchNoTags's located failure result while time remains to write the stage receipt; the 60-minute workflow wrapper is not the fetch watchdog."

fn read_tested_subject(root: String, attempt_id: WalkAttemptId) -> TestedSubject? {
  let read = Filesystem.Read(
    path: merge_admission_tested_subject_path(root: root, attempt_id: attempt_id)
  )
  if !read.success {
    none
  } else {
    parse_tested_subject_wire(text: read.content)
  }
}

fn read_floor_receipt(root: String, attempt_id: WalkAttemptId) -> MergeAdmissionReceiptV2? {
  let read = Filesystem.Read(
    path: merge_admission_floor_receipt_path(root: root, attempt_id: attempt_id)
  )
  if !read.success {
    none
  } else {
    parse_receipt_wire_v2(text: read.content)
  }
}

func stamp_tested_floor() -> Bool {
  match current_walk_attempt_id() {
    Absent => false
    Present { value: attempt_id } =>
      let root = git.Inspect.Toplevel().path as String
      match read_tested_subject(root: root, attempt_id: attempt_id) {
        Absent => false
        Present { value: subject } =>
          let _pr_number_note = merge_admission_pr_number_deferred_note
          let receipt = MergeAdmissionReceiptV2 {
            attempt_id: attempt_id,
            pr_number: none,
            tested_head_sha: subject.head_sha,
            tested_base_tree: subject.base_tree,
            gate_roster_hash: current_gate_roster_hash,
            conclusion: Success,
          }
          Filesystem.Write(
            path: merge_admission_floor_receipt_path(root: root, attempt_id: attempt_id),
            content: render_receipt_wire_v2(receipt: receipt)
          ).success
      }
  }
}

func refresh_current_target_and_gate() -> Bool {
  let parts = git_remote_ref_parts(ref: merge_admission_merge_base_ref as GitRef)
  let fetched = git.Core.FetchNoTags(
    remote: parts.remote,
    ref: parts.ref_name,
    stall_deadline_seconds: merge_admission_fetch_stall_deadline_seconds
  )
  if !fetched.success {
    false
  } else {
    match current_walk_attempt_id() {
      Absent => false
      Present { value: attempt_id } =>
        let root = git.Inspect.Toplevel().path as String
        match read_tested_subject(root: root, attempt_id: attempt_id) {
          Absent => false
          Present { value: subject } =>
            match read_floor_receipt(root: root, attempt_id: attempt_id) {
              Absent => false
              Present { value: receipt } =>
                match observe_merge_target_tree_hash(ref: merge_admission_merge_base_ref as GitRef) {
                  MergeTargetTreeHashRefused { ref: _, cause: _ } => false
                  MergeTargetTreeHashOk { hash: current_tree_text } =>
                    match observed_git_object_id(raw: current_tree_text as String) {
                      Absent => false
                      Present { value: current_tree } =>
                        let verdict = classify_merge_admission_verdict_v2(
                          current_attempt_id: attempt_id,
                          tested_subject: subject,
                          receipt: receipt,
                          merge_target_tree: current_tree,
                          current_roster_hash: current_gate_roster_hash
                        )
                        if merge_freshness_verdict_is_consumed_to_block() {
                          match verdict {
                            MergeAdmitted => true
                            _ => false
                          }
                        } else {
                          true
                        }
                    }
                }
            }
        }
    }
  }
}
