module tools.self_host_use_site_verdict_behavioral_transport

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.cargo_build
import extdeps.git
import extdeps.gunbc
import std.logic { Bool }
import tools.host_prelude { witness_bin, witness_bin_ready, witness_bin_release_path }

data ssuv_doc: String = "Wave 2 Band A pilot (use_site_verdict self-emit): seed-linked behavioral receipt mirroring tools.self_host_logic_behavioral_transport. Emit ONLY the entry module (v2.compiler.use_site_verdict) via gunbc compile --entry; compile it in a v1_compiled driver crate linked against the v1-compiler seed path dependency. Seed-retained import deps (v2.std.node / v2.std.algebra surfaces) are NOT re-emitted into the cargo graph — minimal typed shims under dag/tools/self_host_use_site_verdict_shims/ supply the ABI until those std modules self-emit on their own lane (DESIGN section 7 typed frontier). Behavioral bar: cargo-green witness pairs v1_compiled::v2_compiler_use_site_verdict with v1_compiler::v2_compiler_use_site_verdict (emit->compile->run equals-seed, plain + --inject-fault RED) plus supplementary claim-run on use_site_verdict_test. Shim bytes read via Filesystem.Read at run time (provenance)."

data ssuv_seed_retained_note: String = "Seed oracle: v1_compiler::v2_compiler_use_site_verdict + usv_pilot_v2_std_* scaffold in src/v1/stage0 (hand-retained, independent of the emitted artifact). Dissolve-on: same as ssuv_scaffold_dissolution_trigger — modeled harness producer emits comparison driver + seed-linked extern imports without hand shims."

data ssuv_source_rel: String = "src/v2/compiler/use_site_verdict.dag"

data ssuv_test_entry_rel: String = "src/v2/test/claim/use_site_verdict_test.dag"

data ssuv_shim_lib_rel: String = "dag/tools/self_host_use_site_verdict_shims/lib.rs"

data ssuv_shim_node_rel: String = "dag/tools/self_host_use_site_verdict_shims/v2_std_node.rs"

data ssuv_shim_algebra_rel: String = "dag/tools/self_host_use_site_verdict_shims/v2_std_algebra.rs"

data ssuv_shim_collection_rel: String = "dag/tools/self_host_use_site_verdict_shims/v2_std_collection.rs"

data ssuv_shim_driver_rel: String = "dag/tools/self_host_use_site_verdict_shims/witness_main.rs"

data ssuv_ownership_rc_default_fail_open_finding: String = "section 5 construct finding (Wave 2 use_site_verdict pilot, SUPERSEDED by wrap_decision_gate #6776 + 06_translate routing #6775): the v1 Rust emitter silently applied default Rc<> wrapping on Node / UseSiteVerdict / fn params with no typed ownership refusal. v2 translate now routes through wrap_decision_gate (WrapGateInapplicable passes through unchanged; catalog miss rejects). UseSiteVerdict enrolled in rust_sg_rc_use_site_ownership_catalog (owned-at-all-sites). v1 shared_types silent wrap remains on gunbc compile --target rust until v1 retirement (S3); not a blocker for this pilot."

data ssuv_scaffold_dissolution_trigger: String = "dissolve-on: dag/tools/self_host_use_site_verdict_shims/* + ssuv_cargo_toml + witness_main shim — seed-linked dep shim files, driver-crate manifest (ssuv_cargo_toml fn, mirrors slb_cargo_toml: static Cargo.toml via concat handed to Filesystem.Write, not modeled-emit-fn output spliced through string ops; tracked scaffold debt on this carrier, not untracked medium-as-string), and witness driver. DISSOLVES WHEN v2.std.node self-emits and gunbc emits seed-linked extern imports against v1-compiler for seed-retained modules without hand shims, and a modeled self-host behavioral-equivalence harness producer emits the comparison driver + manifest (parallel to slb_scaffold_dissolution_trigger)."

data ssuv_receipt_pass_marker: String = "SELF_HOST_USE_SITE_VERDICT_BEHAVIORAL_RECEIPT: PASS"

data ssuv_cargo_features_note: String = "Mirrors slb_cargo_features_note: text_lookup_work_counter feature declared for -D warnings consumers."

fn ssuv_repo_path(root: String, rel: String) -> String {
  concat(root, concat("/", rel))
}

fn ssuv_cargo_toml(root: String) -> String {
  concat(
    "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n\n[dependencies]\nim = { version = \"15.1\", features = [\"serde\"] }\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\nlazy_static = \"1\"\nunicode-ident = \"1\"\nunicode-properties = { version = \"0.1\", features = [\"emoji\"] }\nv1-compiler = { path = \"",
    concat(root, "/src/v1/stage0\" }\n")
  )
}

fn ssuv_behavioral_receipt_holds() -> Bool {
  let root = git.Core.Toplevel()
  let module_read = Filesystem.Read(path: ssuv_repo_path(root: root.path, rel: ssuv_source_rel))
  let lib_read = Filesystem.Read(path: ssuv_repo_path(root: root.path, rel: ssuv_shim_lib_rel))
  let node_read = Filesystem.Read(path: ssuv_repo_path(root: root.path, rel: ssuv_shim_node_rel))
  let algebra_read = Filesystem.Read(path: ssuv_repo_path(root: root.path, rel: ssuv_shim_algebra_rel))
  let collection_read = Filesystem.Read(path: ssuv_repo_path(root: root.path, rel: ssuv_shim_collection_rel))
  let driver_read = Filesystem.Read(path: ssuv_repo_path(root: root.path, rel: ssuv_shim_driver_rel))

  let out_dir = shell.Mktemp.Dir()
  let gunbc_built = witness_bin_ready(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
  let gunbc_bin = witness_bin_release_path(root: root.path, bin_name: "gunbc")
  let emit = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "compile",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", ssuv_source_rel,
      "--output-dir", out_dir.path,
      "--target", "rust",
      "--dependency-pool-index", "primary-precedence"
    ]
  )

  let src_dir = shell.Mkdir.Parents(path: concat(out_dir.path, "/src"))
  let lib_written = Filesystem.Write(path: concat(out_dir.path, "/src/lib.rs"), content: lib_read.content)
  let node_shim_written = Filesystem.Write(path: concat(out_dir.path, "/src/v2_std_node.rs"), content: node_read.content)
  let alg_shim_written = Filesystem.Write(path: concat(out_dir.path, "/src/v2_std_algebra.rs"), content: algebra_read.content)
  let coll_shim_written = Filesystem.Write(path: concat(out_dir.path, "/src/v2_std_collection.rs"), content: collection_read.content)
  let manifest = Filesystem.Write(path: concat(out_dir.path, "/Cargo.toml"), content: ssuv_cargo_toml(root: root.path))
  let main_rs = Filesystem.Write(path: concat(out_dir.path, "/src/main.rs"), content: driver_read.content)

  let build = cargo.Build.BuildManifest(
    workdir: out_dir.path,
    manifest_path: concat(out_dir.path, "/Cargo.toml"),
    target_dir: concat(out_dir.path, "/target"),
    extra_args: ["--release"]
  )

  let witness_bin_path = concat(out_dir.path, "/target/release/witness")
  let pass_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path)
  let fault_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path, args: ["--inject-fault"])

  let eval_round_trips = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "run", "--claim-run",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", ssuv_test_entry_rel,
      "--function", "use_site_verdict_round_trips_every_variant"
    ]
  )
  let eval_absent = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "run", "--claim-run",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", ssuv_test_entry_rel,
      "--function", "use_site_verdict_absent_edge_is_distinguishable_from_unclassified"
    ]
  )

  let cleanup_out = shell.Remove.RecursiveForce(path: out_dir.path)

  module_read.success
    && lib_read.success && node_read.success && algebra_read.success && collection_read.success && driver_read.success
    && out_dir.success && gunbc_built && emit.success
    && src_dir.success
    && lib_written.success && node_shim_written.success && alg_shim_written.success && coll_shim_written.success
    && manifest.success && main_rs.success
    && build.success
    && pass_run.success && string_contains(s: pass_run.stdout, pattern: ssuv_receipt_pass_marker)
    && (fault_run.success == false)
    && eval_round_trips.success && eval_absent.success
    && cleanup_out.success
}
