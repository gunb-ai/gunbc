module tools.proactive_verification_ledger_transport


fn run_family_ledger_row(row: gunbc.proactive_verification_ledger.FamilyVerificationLedgerRow) -> Bool {
  match row.execution {
    gunbc.proactive_verification_ledger.ClaimWitness { entry: e, function: f } =>
      tools.host_prelude.run_gunbc_claims(
        source_roots: gunbc.ci_layer_roots.witness_layer_roots,
        claims: [tools.host_prelude.ClaimRun { entry: e, function: f }]
      )
    FalsifierPredictOnlyBatch => false
    CompileCleanGate => false
    RequiredRegenGate => false
  }
}

fn run_executable_ledger_rows() -> Bool {
  v2.std.algebra.fold_list(
    xs: gunbc.proactive_verification_ledger.ledger_executable_family_rows(),
    empty: true,
    cons: fn(acc, row) { acc && run_family_ledger_row(row: row) }
  )
}
