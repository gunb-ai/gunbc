module tools.module_impact_query_front_door


data front_door_note: String = "The real-corpus front door for the impact reading (operator ruling 2026-08-08, recut C): a person asks 'what depends on this?' about the LIVE tree and gets a rendered answer, so the reading's first consumer is not only its own witness suite. Run it with: gunbc run --source-root dag --source-root src/v2 --entry dag/tools/module_impact_query_front_door.dag --function dependents_of_module_graph_report (or dependents_of_path_report). This is a tools entry, not a new Rust CLI arm - no seed growth."

data no_lines: List<String> = []

data front_door_pool_roots: List<String> = ["dag", "src/v2"]

data front_door_importer_roots: List<String> = ["dag", "src/v2"]

data front_door_exclude_substrings: List<String> = []

data front_door_admissions_note: String = "The standing the front door reports is NOT asserted here: these are the two dependency-projection capabilities that gunbc.namespace_reference_derived_closure_admission reports Unavailable, carried as the admission rows the reading consumes, so a live query renders PoolIndependentProjectionUnavailable with the trigger that owns the climb. When the namespace lane establishes pool-independent projection, this roster is what changes and the rendered standing follows automatically rather than this module being edited to say something new. Dissolve-on: the front door reads the production admissions directly once they are projectable under the dag/src-v2 source roots (they live under src/v1 today)."

data front_door_dogfooding_cost_receipt_note: String = "MEASURED COST OF CONSUMING THIS READING PER PR, and why the per-PR CI consumer was withdrawn (2026-08-09). A PR-close delivery check was built on this front door and run on real pull requests; it is closed unmerged at gunbc#8064, branch head afc52ff39ffc5405e61ede484ceb32a31cd0288c, which is the quarry pointer for the mechanism and its witnesses. Three facts it measured are kept because they price the displaced cost that declaration-grain consumption would remove, and none of them is recoverable by re-reading this module. ONE: on ten ordinary subjects, eight modification-only diffs rendered DeclarationGrainUnavailable, so the module grain named in front_door_disclosure_note is not a rare edge but the common case for ordinary edits. TWO: the delivery step cost five minutes thirty-five seconds of wall on the ordinary PR path, measured as a CI step interval rather than locally (a full front-door resolve exceeds a session container lifetime, so a local timing is not obtainable and any local figure would be a guess). THREE: splitting the fold so that a diff with no added paths takes a declaration census and never builds the corpus-wide edge index is the correct shape and was not sufficient — the resolve of this module's own closure is paid before any census begins. The operator's criterion was that a non-negligible common-path cost closes the consumer rather than levying a permanent CI tax for a mostly-undecidable report, and five minutes thirty-five seconds fired it. What was withdrawn is the per-PR step, NOT the acceptance question it asked, which is whether anything consumes what a change built; that question survives for humans and for the eventual lens suite. Dissolve-on: a cheap exact-subject fact pack makes the reading consumable inside a warm budget, at which point these figures become the before side of its receipt rather than a standing caution."

data front_door_admissions: List<gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureAdmission> = [
  gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
    capability: UnrelatedLoadedFileExcluded,
    trigger: P2aPoolIndependentDependencyProjection7515
  },
  gunbc.namespace_reference_derived_closure_admission.ReferenceDerivedClosureUnavailable {
    capability: RepeatedMentionsCollapseDependency,
    trigger: P2aReferenceDependencyProjection7515
  },
]

fn front_door_nodes() -> List<v2.lens.module_graph.ModuleDeclarationFact> {
  v2.lens.module_graph.module_declaration_facts_live(pool_roots: front_door_pool_roots)
}

fn front_door_edges() -> List<v2.lens.module_graph.ModuleDependencyEdge> {
  v2.lens.module_graph.dependency_resolution_facts_live(
    pool_roots: front_door_pool_roots,
    importer_roots: front_door_importer_roots,
    exclude_substrings: front_door_exclude_substrings
  )
}

fn front_door_import_facts() -> List<v2.lens.module_graph.ImportResolutionFact> {
  v2.lens.module_graph.import_resolution_facts_live(
    pool_roots: front_door_pool_roots,
    importer_roots: front_door_importer_roots,
    exclude_substrings: front_door_exclude_substrings
  )
}

fn dependents_of_module(module_name: String) -> v2.lens.module_impact_query.ImpactReading {
  v2.lens.module_impact_query.module_impact_reading(
    seeds: [v2.lens.module_impact_query.ModuleIdentity { name: module_name }],
    direction: v2.lens.module_impact_query.DependentsOf,
    edges: front_door_edges(),
    nodes: front_door_nodes(),
    import_facts: front_door_import_facts(),
    admissions: front_door_admissions
  )
}

fn dependencies_of_module(module_name: String) -> v2.lens.module_impact_query.ImpactReading {
  v2.lens.module_impact_query.module_impact_reading(
    seeds: [v2.lens.module_impact_query.ModuleIdentity { name: module_name }],
    direction: v2.lens.module_impact_query.DependenciesOf,
    edges: front_door_edges(),
    nodes: front_door_nodes(),
    import_facts: front_door_import_facts(),
    admissions: front_door_admissions
  )
}

fn dependents_of_path(path: String) -> v2.lens.module_impact_query.ImpactReading {
  v2.lens.module_impact_query.module_impact_reading(
    seeds: v2.lens.module_impact_query.impact_seeds_for_path(nodes: front_door_nodes(), path: path),
    direction: v2.lens.module_impact_query.DependentsOf,
    edges: front_door_edges(),
    nodes: front_door_nodes(),
    import_facts: front_door_import_facts(),
    admissions: front_door_admissions
  )
}

fn render_standing(reading: v2.lens.module_impact_query.ImpactReading) -> String {
  match reading.standing {
    ExactForGraphSubject => "ExactForGraphSubject"
    ProvisionalForObservedPool => "ProvisionalForObservedPool — observed pool only; pool independence not established"
    Incomplete { causes: _ } => "Incomplete — see causes below"
    PoolIndependentProjectionUnavailable { trigger: _ } =>
      "PoolIndependentProjectionUnavailable — the observed pool may contain SPURIOUS as well as missing edges, so this reading is neither an upper nor a lower bound. Trigger: P2a pool-independent dependency projection (namespace lane)."
  }
}

fn render_cause(cause: v2.lens.module_impact_query.ImpactStandingCause) -> String {
  match cause {
    UndeclaredTargetModule { dependent_module, target_module } =>
      "    undeclared-target  {dependent_module.name} -> {target_module}"
    DeclaredTargetAbsentFromPool { dependent_module, target_module } =>
      "    declared-but-absent-from-pool  {dependent_module.name} -> {target_module}"
  }
}

fn render_cycle(cycle: v2.lens.module_impact_query.ImpactCycle) -> String {
  match cycle {
    ImpactImportAcyclicityViolation { members } =>
      "    IMPORT-ACYCLICITY VIOLATION: {render_modules(modules: members)}"
    ImpactCycleReferenceAdmissible { members } =>
      "    reference-admissible cycle: {render_modules(modules: members)}"
  }
}

fn render_modules(modules: List<v2.lens.module_impact_query.ModuleIdentity>) -> String {
  v2.std.algebra.fold_list(
    xs: modules,
    empty: "",
    cons: fn(acc, m) {
      if acc == "" {
        m.name
      } else {
        "{acc}, {m.name}"
      }
    }
  )
}

fn render_lines(lines: List<String>) -> String {
  v2.std.algebra.fold_list(
    xs: lines,
    empty: "",
    cons: fn(acc, line) {
      if acc == "" {
        line
      } else {
        "{acc}\n{line}"
      }
    }
  )
}

fn render_reading(
  subject: String,
  reading: v2.lens.module_impact_query.ImpactReading,
  nodes: List<v2.lens.module_graph.ModuleDeclarationFact>
) -> String {
  let reached_lines = v2.std.algebra.list_reverse(xs: v2.std.algebra.fold_list(
    xs: reading.reached,
    empty: no_lines,
    cons: fn(acc, m) {
      std.algebra.Cons {
        head: "    {m.name}   [{render_modules_paths(paths: impact_paths_for_module(nodes: nodes, module_id: m))}]",
        tail: acc
      }
    }
  ))
  let cause_lines = v2.std.algebra.list_reverse(xs: v2.std.algebra.fold_list(
    xs: reading.causes,
    empty: no_lines,
    cons: fn(acc, c) { std.algebra.Cons { head: render_cause(cause: c), tail: acc } }
  ))
  let analysis = v2.lens.module_impact_query.module_cycle_analysis(reading: reading)
  let cycle_lines = v2.std.algebra.list_reverse(xs: v2.std.algebra.fold_list(
    xs: analysis.cycles,
    empty: no_lines,
    cons: fn(acc, c) { std.algebra.Cons { head: render_cycle(cycle: c), tail: acc } }
  ))
  render_lines(lines: [
    "impact reading — dependents of {subject}",
    "  standing: {render_standing(reading: reading)}",
    "  reached ({count_text(xs: reading.reached)} module(s)):",
    render_lines(lines: reached_lines),
    "  causes ({count_text(xs: reading.causes)}):",
    render_lines(lines: cause_lines),
    "  cycles ({count_text(xs: analysis.cycles)}):",
    render_lines(lines: cycle_lines),
  ])
}

fn render_modules_paths(paths: List<String>) -> String {
  v2.std.algebra.fold_list(
    xs: paths,
    empty: "",
    cons: fn(acc, p) {
      if acc == "" {
        p
      } else {
        "{acc}, {p}"
      }
    }
  )
}

fn count_text<T>(xs: List<T>) -> String {
  v2.std.algebra.fold_list(xs: xs, empty: 0, cons: fn(acc, _) { acc + 1 }) as String
}

data front_door_default_subject: String = "v2.lens.module_graph"

data front_door_render_cost_note: String = "front_door_nodes() is evaluated ONCE per report and threaded into render_reading. An earlier draft called it inside the per-reached-module fold, which recomputed the live module-declaration facts once per reached module - the copied-accumulator cost shape DESIGN 6 forbids regardless of realized n, and on a corpus-sized reading that is hundreds of live fact scans for one report."

fn dependents_of_module_graph_report() -> String {
  tools.module_impact_query_front_door.render_reading(
    subject: front_door_default_subject,
    reading: dependents_of_module(module_name: front_door_default_subject),
    nodes: front_door_nodes()
  )
}

fn dependents_of_path_report() -> String {
  tools.module_impact_query_front_door.render_reading(
    subject: "src/v2/lens/module_graph.dag",
    reading: dependents_of_path(path: "src/v2/lens/module_graph.dag"),
    nodes: front_door_nodes()
  )
}

data changed_surface_front_door_note: String = "CAPSULE 2 applied consumer, reworked under the operator ruling 2026-08-08. Changed paths AND departed paths both come from v2.workflow.floor_diff_observe, the existing single authority for the CI diff observation - this adds no second diff producer. Deletions are no longer discarded: a departed path becomes a ResolveInBase subject, which cannot resolve against the head population and therefore lands as a typed BaseGraphUnavailable unresolved subject, contaminating the outcome to Partial. A diff-observation FAILURE refuses with the observation's own reason and computes NO impact - it never widens to the whole corpus. Run: gunbc run --source-root dag --source-root src/v2 --entry dag/tools/module_impact_query_front_door.dag --function changed_surface_impact_report"

fn render_changed_path_seeds(row: v2.lens.module_impact_query.ChangedPathSeeds) -> String {
  if any(xs: row.seeds, predicate: fn(_) { true }) {
    "    {row.path}  ->  {render_modules(modules: row.seeds)}"
  } else {
    "    {row.path}  ->  (unresolved)"
  }
}

fn render_unresolved_subject(subject: v2.lens.module_impact_query.UnresolvedSubject) -> String {
  match subject.cause {
    NoModuleDeclaredAtPath =>
      "    {subject.path}  —  no module declared at this path in the observed pool"
    BaseGraphUnavailable =>
      "    {subject.path}  —  DELETED: needs the BASE population, which no revision-scoped fact producer can supply today"
  }
}

fn render_skip_authority(authority: v2.lens.module_impact_query.SkipAuthority) -> String {
  match authority {
    SkipAuthorityGranted { affected: _ } =>
      "GRANTED — the answer is exact and whole for this subject"
    SkipAuthorityWithheld { cause } =>
      match cause {
        SkipWithheldUnresolvedSubjects =>
          "WITHHELD — the outcome is Partial (unresolved subjects); a partial answer may never authorize skipping work"
        SkipWithheldObservationRefused =>
          "WITHHELD — the diff observation refused"
        SkipWithheldStandingNotExact =>
          "WITHHELD — the reading is pool-relative, not exact"
      }
  }
}

fn render_outcome(outcome: v2.lens.module_impact_query.ChangedSurfaceImpactOutcome) -> String {
  match outcome {
    ChangedSurfaceRefused { reason } =>
      "change impact REFUSED — no impact computed and NOTHING widened to the whole corpus. reason: {reason}"
    ChangedSurfaceComplete { reading } =>
      render_lines(lines: [
        "change impact — outcome: COMPLETE",
        "  standing: {render_standing(reading: reading)}",
        "  skip authority: {render_skip_authority(authority: changed_surface_skip_authority(outcome: outcome))}",
        "  may be affected — DependentsOf ({count_text(xs: reading.reached)} module(s))",
        "  causes ({count_text(xs: reading.causes)}):",
        render_lines(lines: v2.std.algebra.list_reverse(xs: v2.std.algebra.fold_list(
          xs: reading.causes,
          empty: no_lines,
          cons: fn(acc, c) { std.algebra.Cons { head: render_cause(cause: c), tail: acc } }
        ))),
      ])
    ChangedSurfacePartial { reading, unresolved_subjects } =>
      render_lines(lines: [
        "change impact — outcome: PARTIAL (the answer is NOT whole; unresolved subjects below)",
        "  standing: {render_standing(reading: reading)}",
        "  skip authority: {render_skip_authority(authority: changed_surface_skip_authority(outcome: outcome))}",
        "  may be affected — DependentsOf ({count_text(xs: reading.reached)} module(s))",
        "  unresolved subjects ({count_text(xs: unresolved_subjects)}):",
        render_lines(lines: v2.std.algebra.list_reverse(xs: v2.std.algebra.fold_list(
          xs: unresolved_subjects,
          empty: no_lines,
          cons: fn(acc, u) { std.algebra.Cons { head: render_unresolved_subject(subject: u), tail: acc } }
        ))),
        "  causes ({count_text(xs: reading.causes)}):",
        render_lines(lines: v2.std.algebra.list_reverse(xs: v2.std.algebra.fold_list(
          xs: reading.causes,
          empty: no_lines,
          cons: fn(acc, c) { std.algebra.Cons { head: render_cause(cause: c), tail: acc } }
        ))),
      ])
  }
}

fn front_door_changed_surface_outcome() -> v2.lens.module_impact_query.ChangedSurfaceImpactOutcome {
  match v2.workflow.floor_diff_observe.floor_observe_git_diff_name_status_for_ci() {
    NameStatusDiffFail { reason } => v2.lens.module_impact_query.ChangedSurfaceRefused { reason: reason }
    NameStatusDiffOk { changed_paths, departed_paths } =>
      v2.lens.module_impact_query.changed_surface_impact_outcome(
        changed_paths: changed_paths,
        departed_paths: departed_paths,
        edges: front_door_edges(),
        nodes: front_door_nodes(),
        import_facts: front_door_import_facts(),
        admissions: front_door_admissions
      )
  }
}

fn changed_surface_impact_report() -> String {
  render_outcome(outcome: front_door_changed_surface_outcome())
}
