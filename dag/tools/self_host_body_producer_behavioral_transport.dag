module tools.self_host_body_producer_behavioral_transport

import tools.self_host_curated_seed_linked_harness {
  CuratedSeedLinkedShimWrite,
  cssl_seed_linked_behavioral_receipt
}
import v2.std.collection { List }
import std.logic { Bool }

data sbp_doc: String = "Wave 2 easy-flip lane (03_body_producer self-emit): curated seed-linked behavioral receipt via tools.self_host_curated_seed_linked_harness. Emit ONLY v2.compiler.body_producer via gunbc compile --entry; seed-retained v2.std.node/diagnostic/algebra surfaces are NOT re-emitted — minimal typed shims under dag/tools/self_host_body_producer_shims/ supply the ABI (text-free, low-Rc; independent of emitter Track-B body fixes). Seed oracle: v1_compiler::v2_compiler_body_producer. Behavioral bar: cargo-green witness pairs emitted vs seed on dispatch/produce (plain + --inject-fault RED) plus supplementary claim-run on structured_body_dispatch."

data sbp_source_rel: String = "src/v2/compiler/03_body_producer.dag"

data sbp_test_entry_rel: String = "src/v2/test/claim/manual/structured_body_dispatch.dag"

data sbp_shim_lib_rel: String = "dag/tools/self_host_body_producer_shims/lib.rs"

data sbp_shim_driver_rel: String = "dag/tools/self_host_body_producer_shims/witness_main.rs"

data sbp_scaffold_dissolution_trigger: String = "dissolve-on: dag/tools/self_host_body_producer_shims/* + sbp behavioral transport wiring — seed-linked dep shim files, driver-crate manifest via cssl_v1_compiled_cargo_toml, and witness driver. DISSOLVES WHEN v2.std.node and v2.std.diagnostic self-emit and gunbc emits seed-linked extern imports without hand shims, and a modeled self-host behavioral-equivalence harness producer emits the comparison driver + manifest (parallel to cssl_doc dissolution)."

data sbp_receipt_pass_marker: String = "SELF_HOST_BODY_PRODUCER_BEHAVIORAL_RECEIPT: PASS"

data sbp_body_producer_shim_writes: List<CuratedSeedLinkedShimWrite> = [
  CuratedSeedLinkedShimWrite {
    dest_rel: "v2_std_node.rs",
    source_rel: "dag/tools/self_host_body_producer_shims/v2_std_node.rs"
  },
  CuratedSeedLinkedShimWrite {
    dest_rel: "v2_std_algebra.rs",
    source_rel: "dag/tools/self_host_body_producer_shims/v2_std_algebra.rs"
  },
  CuratedSeedLinkedShimWrite {
    dest_rel: "v2_std_diagnostic.rs",
    source_rel: "dag/tools/self_host_body_producer_shims/v2_std_diagnostic.rs"
  }
]

fn sbp_behavioral_receipt_holds() -> Bool {
  cssl_seed_linked_behavioral_receipt(
    source_rel: sbp_source_rel,
    shim_lib_rel: sbp_shim_lib_rel,
    shim_writes: sbp_body_producer_shim_writes,
    driver_rel: sbp_shim_driver_rel,
    pass_marker: sbp_receipt_pass_marker,
    claim_entry_rel: sbp_test_entry_rel,
    claim_function: "structured_body_dispatch_accepts_transform_call"
  )
}
