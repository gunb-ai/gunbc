module tools.chore_heal

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.generated_artifact { GeneratedArtifact, committed_generated_artifacts, artifact_path }
import gunbc.generated_artifact_emit { artifact_generate }
import gunbc.ci_gate { GeneratedArtifactDriftGate }
import gunbc.ci_remedy {
  HealPlan, AttemptDerivation, DeclineJudgment, RemedyCommand,
  chore_heal_plan
}

data chore_heal_tool_note: String = "Runnable heal ADVISOR (ci-chores lane, operator-directed 2026-07-23). Invoke: gunbc run --source-root dag --source-root src/v2 --entry dag/tools/chore_heal.dag --function main. It reads the live committed generated artifacts, and if any has drifted from its authority (the generated-artifact drift gate is red), it reports the chore-heal PLAN for that gate — the exact command whose output would heal it — WITHOUT running or pushing anything (DRY-RUN, the ci-chores frontier default chore_heal_armed=false). A clean tree exits success ('nothing to heal'). This is the exercisable seam under the CI heal job that lands with the arming decision: the job runs this classification, then (when armed) runs the command, re-verifies the gate on the output (fixed point), and commits/pushes via the branch-protection-declared identity. Fail-closed: a judgment-class remedy reports 'not auto-healable' with the located debt, never a fabricated fix."

fn artifact_current_drift(a: GeneratedArtifact) -> Bool {
  let committed = Filesystem.Read(path: artifact_path(a: a))
  !committed.success || !(committed.content == artifact_generate(a: a))
}

fn any_artifact_drifted() -> Bool {
  fold(committed_generated_artifacts(), init: false, f: fn(acc, a) {
    acc || artifact_current_drift(a: a)
  })
}

fn first_drifted_path() -> String {
  fold(committed_generated_artifacts(), init: "", f: fn(acc, a) {
    if acc == "" && artifact_current_drift(a: a) { artifact_path(a: a) } else { acc }
  })
}

fn heal_command_string(cmd: RemedyCommand) -> String {
  concat(
    concat("gunbc run --source-root dag --source-root src/v2 --entry ", cmd.entry),
    concat(" --function ", cmd.function)
  )
}

fn drift_heal_report() -> ProcessExit {
  match chore_heal_plan(g: GeneratedArtifactDriftGate) {
    AttemptDerivation { command, delivery: _ } =>
      exit_failure(
        reason: concat(
          concat("chore-heal DRY-RUN — generated-artifact drift is AUTO-HEALABLE (first drifted: ", first_drifted_path()),
          concat("); heal command: ", heal_command_string(cmd: command))
        )
      )
    DeclineJudgment { located_debt } =>
      exit_failure(reason: concat("chore-heal — NOT auto-healable (judgment): ", located_debt))
  }
}

func main() -> ProcessExit {
  if any_artifact_drifted() {
    drift_heal_report()
  } else {
    ExitSuccess
  }
}
