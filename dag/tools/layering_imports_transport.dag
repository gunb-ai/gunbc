module tools.layering_imports_transport

import gunbc.ci_layer_roots { witness_layer_roots }
import std.logic { Bool }
import tools.host_prelude { ClaimRun, run_gunbc_claims }

data scanner_dir: String = "src/v2/test/claim/layering_imports/scanner/"
data clean_tree_entry: String = "src/v2/test/claim/layering_imports/clean_tree_test.dag"
data clean_tree_function: String = "clean_tree_no_wrong_direction_imports_holds"

fn scanner_claim(scenario: String, function: String) -> ClaimRun {
  ClaimRun {
    entry: concat(scanner_dir, concat(scenario, ".dag")),
    function: function
  }
}

fn run_clean_tree_gate() -> Bool {
  run_gunbc_claims(
    source_roots: witness_layer_roots,
    claims: [ClaimRun { entry: clean_tree_entry, function: clean_tree_function }]
  )
}

fn run_scanner_perturb_receipts() -> Bool {
  run_gunbc_claims(
    source_roots: witness_layer_roots,
    claims: [
      scanner_claim(scenario: "std_v4_prefix", function: "scanner_std_v4_prefix_detects_holds"),
      scanner_claim(scenario: "extdeps_v4_prefix", function: "scanner_extdeps_v4_prefix_detects_holds"),
      scanner_claim(scenario: "dag_extdeps_v4_exact", function: "scanner_dag_extdeps_v4_exact_detects_holds"),
      scanner_claim(scenario: "parse_level_pre_resolve", function: "scanner_parse_level_pre_resolve_detects_holds"),
      scanner_claim(scenario: "std_imports_extdeps", function: "scanner_std_imports_extdeps_detects_holds")
    ]
  )
}

fn run_reference_only_perturb_receipt() -> Bool {
  run_gunbc_claims(
    source_roots: witness_layer_roots,
    claims: [
      ClaimRun {
        entry: "src/v2/test/claim/layering_imports/lens_unit/reference_only_compiler_fixture.dag",
        function: "detects_reference_only_compiler_import_holds"
      }
    ]
  )
}
