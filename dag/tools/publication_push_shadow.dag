module tools.publication_push_shadow


data publication_push_shadow_note: String = "Slice-1 shadow witness: read-only stopped-line-audit observer replaying observed public pushes through the modeled admission stack. Reports typed, located, counted refusals; does not green, gate, or mutate live push paths. Ordinary sessions still reach the public remote in this slice — the ledger sizes the enforcement stage."

type ObservedPublicPush {
  session: tools.publication_publisher.ModeledSessionId
  head: String
  push: extdeps.git.hooks.PrePushStdinRow
  candidate: gunbc.public_projection.PublicProjectionPlan
  decisions: List<gunbc.publication_decision.PublicationDecisionReceipt>
}

type ShadowPushLedgerEntry
  = ShadowPushWouldAdmit {
      session: tools.publication_publisher.ModeledSessionId
      head: String
      push: extdeps.git.hooks.PrePushStdinRow
    }
  | ShadowPushWouldRefuse {
      session: tools.publication_publisher.ModeledSessionId
      head: String
      push: extdeps.git.hooks.PrePushStdinRow
      admission: tools.publication_publisher.PublicWriteAdmission
    }

fn shadow_push_admission(
  current: gunbc.public_projection.PublicProjectionPlan?,
  observed: ObservedPublicPush,
) -> tools.publication_publisher.PublicWriteAdmission {
  tools.publication_publisher.admit_public_write(
    session: observed.session,
    current: current,
    candidate: observed.candidate,
    decisions: observed.decisions,
    pushed_refs: [observed.push],
  )
}

fn shadow_push_ledger_entry(
  current: gunbc.public_projection.PublicProjectionPlan?,
  observed: ObservedPublicPush,
) -> ShadowPushLedgerEntry {
  let admission = shadow_push_admission(current: current, observed: observed)
  match admission {
    tools.publication_publisher.PublicWriteAdmitted { authority: _ } =>
      ShadowPushWouldAdmit {
        session: observed.session,
        head: observed.head,
        push: observed.push,
      }
    tools.publication_publisher.PublicWriteRefused { session: session, cause: cause } =>
      ShadowPushWouldRefuse {
        session: session,
        head: observed.head,
        push: observed.push,
        admission: admission,
      }
  }
}

fn shadow_replay_public_pushes(
  current: gunbc.public_projection.PublicProjectionPlan?,
  events: List<ObservedPublicPush>,
) -> List<ShadowPushLedgerEntry> {
  map(events, event => shadow_push_ledger_entry(current: current, observed: event))
}

fn shadow_refusal_count(entries: List<ShadowPushLedgerEntry>) -> Int {
  fold(entries, init: 0, f: fn(count, entry) {
    match entry {
      ShadowPushWouldAdmit { session: _, head: _, push: _ } => count
      ShadowPushWouldRefuse { session: _, head: _, push: _, admission: _ } => count + 1
    }
  })
}

fn shadow_would_refuse_ordinary_session(
  current: gunbc.public_projection.PublicProjectionPlan?,
  observed: ObservedPublicPush,
) -> Bool {
  match shadow_push_ledger_entry(current: current, observed: observed) {
    ShadowPushWouldAdmit { session: _, head: _, push: _ } => false
    ShadowPushWouldRefuse { session: _, head: _, push: _, admission: admission } =>
      match admission {
        tools.publication_publisher.PublicWriteRefused { session: _, cause: cause } =>
          match cause {
            tools.publication_publisher.NotTheSolePublisher { session: _, sole_publisher: _ } => true
            tools.publication_publisher.ProjectionNotAdmitted { session: _, detail: _ } => false
            tools.publication_publisher.DecisionReceiptMissing { session: _, subject_identity: _ } => false
            tools.publication_publisher.DecisionReceiptNotAuthorizing { session: _, subject_identity: _, detail: _ } => false
            tools.publication_publisher.UnauthorizedPublicPush { session: _, local_ref: _, local_sha: _, detail: _ } => false
            tools.publication_publisher.NoPushedRefsPresented { session: _ } => false
          }
        tools.publication_publisher.PublicWriteAdmitted { authority: _ } => false
      }
  }
}
