module tools.merge_admission_capture_transport


// The pre-walk capture transport is a typed argv invocation, not shell-as-string and not an ad-hoc executor command. claim_executor resolves this narrow transport entry, supplies the plan-authored source roots and claim identity, and evaluates this function. gunbc.WitnessBin.Run launches the already-built claim_batch child; the child alone resolves and evaluates capture_tested_subject, so address-space death structurally reclaims its evaluator arena before discovery. A nonzero child exit returns false and the executor reports a located pre-walk refusal before batch 1.
fn source_root_argv(roots: List<String>) -> List<String> {
  fold(roots, init: [], f: fn(args, root) {
    concat(args, ["--source-root", root])
  })
}

func run_merge_admission_capture_subprocess(
  source_roots: List<String>,
  claim_entry: String,
  claim_function: String
) -> Bool {
  let root = git.Inspect.Toplevel().path
  let args = concat(
    source_root_argv(roots: source_roots),
    ["--entry", claim_entry, "--function", claim_function, "--claim-run", "--wet"]
  )
  WitnessBin.Run(
    workdir: root,
    bin_path: concat(concat(root as String, "/"), gunbc.cli_invoke.release_bin_rel_path(bin_name: "claim_batch")) as std.types.FilePath,
    args: args
  ).success
}
