module tools.zzz_regen_apply

import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.live_deploy.emit { expected_live_deploy_apply_script, expected_live_deploy_retract_script }
import std.process { ProcessExit, ExitSuccess, exit_failure }

func regen_live_deploy_goldens() -> ProcessExit {
  let a = Filesystem.Write(path: ".github/live-deploy-srv1-apply.sh", content: expected_live_deploy_apply_script())
  if a.success {
    let r = Filesystem.Write(path: ".github/live-deploy-srv1-retract.sh", content: expected_live_deploy_retract_script())
    if r.success { ExitSuccess } else { exit_failure(reason: concat("retract write failed: ", r.error)) }
  } else {
    exit_failure(reason: concat("apply write failed: ", a.error))
  }
}
