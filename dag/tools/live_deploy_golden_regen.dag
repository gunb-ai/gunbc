module tools.live_deploy_golden_regen

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.generated_artifact {
  LiveDeployApplyScriptArtifact, LiveDeployRetractScriptArtifact,
  artifact_path
}
import gunbc.generated_artifact_emit { artifact_generate }

func live_deploy_golden_regen_wet() -> ProcessExit {
  let a = Filesystem.Write(
    path: artifact_path(a: LiveDeployApplyScriptArtifact),
    content: artifact_generate(a: LiveDeployApplyScriptArtifact)
  )
  if a.success {
    let r = Filesystem.Write(
      path: artifact_path(a: LiveDeployRetractScriptArtifact),
      content: artifact_generate(a: LiveDeployRetractScriptArtifact)
    )
    if r.success { ExitSuccess } else { exit_failure(reason: concat("retract write failed: ", r.error)) }
  } else {
    exit_failure(reason: concat("apply write failed: ", a.error))
  }
}
