module tools.dag_compile_clean_scope

import gunbc.ci_layer_roots { witness_layer_roots }
import tools.dag_compile_clean_partition { compile_clean_partition_boundary }
import tools.dag_compile_clean_shard_roster { compile_clean_shard_entry_paths }
import v2.lens.affected_set.corpus_dependency_view {
  corpus_dependency_view_per_pr_substrate_ready
}
import v2.lens.affected_set.entry_selection {
  entry_affected_by_dependency_view
}
import std.types { String, Bool, List, list_length }

type CompileCleanScopeDisposition
  = ScopedRun { entry_paths: List<String> }
  | SkipNoAffectedEntries { reason: String }
  | RequireWholeTree { reason: String }

fn compile_clean_touched_path_norm(path: String) -> String {
  if starts_with(s: path, prefix: "./") {
    substring(s: path, start: 2, end: string_length(s: path))
  } else {
    path
  }
}

fn compile_clean_touched_path_is_docs_only(path: String) -> Bool {
  starts_with(
    s: compile_clean_touched_path_norm(path: path),
    prefix: "docs/"
  )
}

fn compile_clean_all_touched_paths_docs_universe(touched_paths: List<String>) -> Bool {
  list_length(items: touched_paths) > 0
    && fold(
      touched_paths,
      init: true,
      f: fn(ok, p) { ok && compile_clean_touched_path_is_docs_only(path: p) }
    )
}

fn compile_clean_pool_roots() -> List<String> {
  compile_clean_partition_boundary().pool_roots
}

fn compile_clean_entry_root() -> String {
  compile_clean_partition_boundary().entry_root
}

fn compile_clean_affected_entry_paths_from_roster(
  pool_roots: List<String>,
  touched_paths: List<String>,
  roster: List<String>
) -> List<String> {
  fold(
    roster,
    init: [],
    f: fn(acc, entry_path) {
      if entry_affected_by_dependency_view(
        entry_path: entry_path,
        pool_roots: pool_roots,
        touched_paths: touched_paths
      ) {
        concat(acc, [entry_path])
      } else {
        acc
      }
    }
  )
}

fn compile_clean_affected_entry_paths(
  pool_roots: List<String>,
  touched_paths: List<String>
) -> List<String> {
  compile_clean_affected_entry_paths_from_roster(
    pool_roots: pool_roots,
    touched_paths: touched_paths,
    roster: compile_clean_shard_entry_paths()
  )
}

fn compile_clean_scope_disposition_from_touched_with_roster(
  touched_paths: List<String>,
  roster: List<String>
) -> CompileCleanScopeDisposition {
  if list_length(items: touched_paths) == 0 {
    SkipNoAffectedEntries {
      reason: "no touched paths in diff observation"
    }
  } else if corpus_dependency_view_per_pr_substrate_ready() == false {
    RequireWholeTree {
      reason: "DependencyView per-PR selection blocked-on-#6239 (fn_arrow_decl_substrate_is_whole_tree false)"
    }
  } else {
    let pool_roots = compile_clean_pool_roots()
    let affected = compile_clean_affected_entry_paths_from_roster(
      pool_roots: pool_roots,
      touched_paths: touched_paths,
      roster: roster
    )
    if list_length(items: affected) > 0 {
      ScopedRun { entry_paths: affected }
    } else if compile_clean_all_touched_paths_docs_universe(touched_paths: touched_paths) {
      SkipNoAffectedEntries {
        reason: "docs-only diff — no compile-clean entry selection required (Ruling 1 path grain)"
      }
    } else {
      RequireWholeTree {
        reason: "non-empty diff with no shard intersection — whole-tree baseline"
      }
    }
  }
}

fn compile_clean_scope_disposition_from_touched(
  touched_paths: List<String>
) -> CompileCleanScopeDisposition {
  compile_clean_scope_disposition_from_touched_with_roster(
    touched_paths: touched_paths,
    roster: compile_clean_shard_entry_paths()
  )
}

fn witness_pool_roots_match_witness_layer_roots() -> Bool {
  fold(witness_layer_roots, init: true, f: fn(ok, root) {
    ok && fold(compile_clean_pool_roots(), init: false, f: fn(found, pool_root) {
      found || (pool_root == root)
    })
  })
}

fn witness_entry_root_is_first_witness_layer_root() -> Bool {
  compile_clean_entry_root() == witness_layer_roots.first()
}

fn witness_empty_touched_skips() -> Bool {
  match compile_clean_scope_disposition_from_touched(touched_paths: []) {
    SkipNoAffectedEntries { reason: _ } => true
    ScopedRun { entry_paths: _ } => false
    RequireWholeTree { reason: _ } => false
  }
}

type ScopeDispositionExpectation
  = ExpectSkip
  | ExpectScopedContaining { required_entry: String }
  | ExpectWholeTree

type ScopeDispositionRow {
  touched: String
  expect: ScopeDispositionExpectation
}

data scope_disposition_rows: List<ScopeDispositionRow> = [
  ScopeDispositionRow { touched: "docs/plans/example.md", expect: ExpectSkip },
  ScopeDispositionRow { touched: "./docs/plans/example.md", expect: ExpectSkip },
  ScopeDispositionRow { touched: "dag/gunbc/plans/example.dag", expect: ExpectWholeTree },
  ScopeDispositionRow { touched: "dag/std/logic.dag", expect: ExpectScopedContaining { required_entry: "dag/std/logic.dag" } },
  ScopeDispositionRow { touched: "src/v1/stage0/src/cli_run.rs", expect: ExpectWholeTree },
  ScopeDispositionRow { touched: ".github/workflows/ci.yml", expect: ExpectWholeTree },
  ScopeDispositionRow { touched: "src/v2/std/logic.dag", expect: ExpectScopedContaining { required_entry: "dag/test/claim/parse_test.dag" } }
]

fn touched_path_disposition_matches_with_roster(
  row: ScopeDispositionRow,
  roster: List<String>
) -> Bool {
  match compile_clean_scope_disposition_from_touched_with_roster(
    touched_paths: [row.touched],
    roster: roster
  ) {
    SkipNoAffectedEntries { reason: _ } =>
      match row.expect {
        ExpectSkip => true
        ExpectScopedContaining { required_entry: _ } => false
        ExpectWholeTree => false
      }
    ScopedRun { entry_paths: paths } =>
      match row.expect {
        ExpectSkip => false
        ExpectScopedContaining { required_entry: req } =>
          fold(paths, init: false, f: fn(found, p) { found || (p == req) })
        ExpectWholeTree => false
      }
    RequireWholeTree { reason: _ } =>
      match row.expect {
        ExpectSkip => false
        ExpectScopedContaining { required_entry: _ } =>
          !corpus_dependency_view_per_pr_substrate_ready()
        ExpectWholeTree => true
      }
  }
}

fn touched_path_disposition_matches(row: ScopeDispositionRow) -> Bool {
  touched_path_disposition_matches_with_roster(
    row: row,
    roster: compile_clean_shard_entry_paths()
  )
}

fn witness_touched_path_dispositions_hold() -> Bool {
  let roster = compile_clean_shard_entry_paths()
  fold(scope_disposition_rows, init: true, f: fn(acc, row) {
    acc && touched_path_disposition_matches_with_roster(row: row, roster: roster)
  })
}

fn lever_a_local_receipts_hold() -> Bool {
  witness_empty_touched_skips()
    && witness_touched_path_dispositions_hold()
    && witness_entry_root_is_first_witness_layer_root()
    && witness_pool_roots_match_witness_layer_roots()
}
