module tools.gunbc_ci


import std.process { ProcessExit, ExitSuccess, exit_failure }
import gunbc.retained_shell_script { retained_foreign }
import gunbc.ci_spec { gunbc_ci_spec }
import v2.workflow.ci_release_build_emit { gunbc_ci_run_script }



func main() -> ProcessExit {
  let script = gunbc_ci_run_script(spec: gunbc_ci_spec)
  let result = shell.Exec.Run(script: retained_foreign(body: script, reason: "gunbc ci generate + run ci floor script"))
  return if result.success {
    ExitSuccess
  } else {
    exit_failure(
      reason: concat(
        concat("gunbc ci failed (exit ", to_string(result.exit_code)),
        concat("): ", result.stderr)
      )
    )
  }
}
