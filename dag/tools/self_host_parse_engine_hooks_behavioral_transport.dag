module tools.self_host_parse_engine_hooks_behavioral_transport

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.cargo_build
import extdeps.git
import extdeps.gunbc
import std.logic { Bool }
import tools.host_prelude { witness_bin, witness_bin_ready, witness_bin_release_path }

data peh_doc: String = "Wave 2 Band A (parse_engine_hooks self-emit): seed-linked behavioral receipt mirroring tools.self_host_use_site_verdict_behavioral_transport. Emit ONLY v2.compiler.parse_engine_hooks via gunbc compile --entry; compile the gunbc-emitted entry module in a v1_compiled driver crate linked against the v1-compiler seed path dependency. Seed-retained import dep (v2.std.node Symbol surface) is NOT re-emitted — minimal typed shim under dag/tools/self_host_parse_engine_hooks_shims/ supplies the ABI until v2.std.node self-emits on its own lane (DESIGN section 7 typed frontier). Behavioral bar: cargo-green witness pairs v1_compiled::v2_compiler_parse_engine_hooks (gunbc-emitted rs, not overwritten) with v1_compiler::v2_compiler_parse_engine_hooks (plain + --inject-fault RED) plus supplementary claim-run on parse_engine_hooks_test. Shim bytes read via Filesystem.Read at run time (provenance)."

data peh_seed_retained_note: String = "Seed oracle: v1_compiler::v2_compiler_parse_engine_hooks in src/v1/stage0 (hand-retained, independent of the emitted artifact). Dissolve-on: same as peh_scaffold_dissolution_trigger."

data peh_source_rel: String = "src/v2/compiler/parse_engine_hooks.dag"

data peh_test_entry_rel: String = "src/v2/test/claim/parse_engine_hooks_test.dag"

data peh_shim_lib_rel: String = "dag/tools/self_host_parse_engine_hooks_shims/lib.rs"

data peh_shim_node_rel: String = "dag/tools/self_host_parse_engine_hooks_shims/v2_std_node.rs"

data peh_shim_driver_rel: String = "dag/tools/self_host_parse_engine_hooks_shims/witness_main.rs"

data peh_scaffold_dissolution_trigger: String = "dissolve-on: dag/tools/self_host_parse_engine_hooks_shims/* + peh_cargo_toml + witness driver — seed-linked dep shim files (Symbol-only v2_std_node), driver-crate manifest (peh_cargo_toml fn, mirrors ssuv_cargo_toml), and witness driver. DISSOLVES WHEN v2.std.node self-emits and gunbc emits seed-linked extern imports against v1-compiler for seed-retained modules without hand shims, and a modeled self-host behavioral-equivalence harness producer emits the comparison driver + manifest (parallel to ssuv_scaffold_dissolution_trigger)."

data peh_receipt_pass_marker: String = "SELF_HOST_PARSE_ENGINE_HOOKS_BEHAVIORAL_RECEIPT: PASS"

data peh_cargo_features_note: String = "Mirrors ssuv_cargo_features_note: text_lookup_work_counter feature declared for -D warnings consumers."

fn peh_repo_path(root: String, rel: String) -> String {
  concat(root, concat("/", rel))
}

fn peh_cargo_toml(root: String) -> String {
  concat(
    "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n\n[dependencies]\nim = { version = \"15.1\", features = [\"serde\"] }\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\nlazy_static = \"1\"\nunicode-ident = \"1\"\nunicode-properties = { version = \"0.1\", features = [\"emoji\"] }\nv1-compiler = { path = \"",
    concat(root, "/src/v1/stage0\" }\n")
  )
}

fn peh_behavioral_receipt_holds() -> Bool {
  let root = git.Core.Toplevel()
  let module_read = Filesystem.Read(path: peh_repo_path(root: root.path, rel: peh_source_rel))
  let lib_read = Filesystem.Read(path: peh_repo_path(root: root.path, rel: peh_shim_lib_rel))
  let node_read = Filesystem.Read(path: peh_repo_path(root: root.path, rel: peh_shim_node_rel))
  let driver_read = Filesystem.Read(path: peh_repo_path(root: root.path, rel: peh_shim_driver_rel))

  let out_dir = shell.Mktemp.Dir()
  let gunbc_built = witness_bin_ready(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
  let gunbc_bin = witness_bin_release_path(root: root.path, bin_name: "gunbc")
  let emit = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "compile",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", peh_source_rel,
      "--output-dir", out_dir.path,
      "--target", "rust",
      "--dependency-pool-index", "primary-precedence"
    ]
  )

  let src_dir = shell.Mkdir.Parents(path: concat(out_dir.path, "/src"))
  let lib_written = Filesystem.Write(path: concat(out_dir.path, "/src/lib.rs"), content: lib_read.content)
  let node_shim_written = Filesystem.Write(path: concat(out_dir.path, "/src/v2_std_node.rs"), content: node_read.content)
  let manifest = Filesystem.Write(path: concat(out_dir.path, "/Cargo.toml"), content: peh_cargo_toml(root: root.path))
  let main_rs = Filesystem.Write(path: concat(out_dir.path, "/src/main.rs"), content: driver_read.content)

  let build = cargo.Build.BuildManifest(
    workdir: out_dir.path,
    manifest_path: concat(out_dir.path, "/Cargo.toml"),
    target_dir: concat(out_dir.path, "/target"),
    extra_args: ["--release"]
  )

  let witness_bin_path = concat(out_dir.path, "/target/release/witness")
  let pass_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path)
  let fault_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path, args: ["--inject-fault"])

  let eval_symbols = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "run", "--claim-run",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", peh_test_entry_rel,
      "--function", "parse_engine_hooks_symbols_match_grammar_productions"
    ]
  )

  let cleanup_out = shell.Remove.RecursiveForce(path: out_dir.path)

  module_read.success
    && lib_read.success && node_read.success && driver_read.success
    && out_dir.success && gunbc_built && emit.success
    && src_dir.success
    && lib_written.success && node_shim_written.success
    && manifest.success && main_rs.success
    && build.success
    && pass_run.success && string_contains(s: pass_run.stdout, pattern: peh_receipt_pass_marker)
    && (fault_run.success == false)
    && eval_symbols.success
    && cleanup_out.success
}
