module tools.merge_admission_capture



data merge_admission_capture_profile_note: String = "This wet capture entry imports only the walk-attempt/tested-subject identity carrier plus typed git/filesystem services. Merge classification, commit-roster hashing, and CI failure taxonomy are deliberately downstream and absent from this closure. The entry runs in the plan's typed pre-walk claim_batch subprocess, so its evaluator arena dies before the ordinary floor and discovery cannot retain it."

data merge_admission_capture_refusal_wire_note: String = "TYPED CAUSE ACROSS THE CLAIM BOUNDARY (review 47517, §5). The pre-walk transport's channel is a Bool claim result, which cannot carry the refusal cause — so the capture core returns the typed sum below, and the Bool projection durably writes the labeled cause to target/merge-admission-capture-refusal.txt (the floor-population-budget-refusal.txt pattern) BEFORE returning false; claim_executor's run_pre_walk_execution reads that wire into its located PRE-WALK-REFUSED line. The wire is best-effort-cleared at capture start so a stale cause from a prior attempt cannot masquerade as this attempt's; a false result with no wire is itself a distinct reported state (child died before writing), never silently folded into a generic failure."

fn env_var(name: std.types.NonEmptyStr) -> String? {
  let env = shell.Env.Get(name: name)
  match env.value {
    Present { value: raw } =>
      let line = std.algebra.trim(raw)
      if line == "" { none } else { Present { value: line } }
    Absent => none
  }
}

fn capture_walk_attempt_id() -> gunbc.merge_admission_subject.WalkAttemptId? {
  match env_var(name: "GUNBC_WALK_ATTEMPT_ID") {
    Present { value: explicit } => gunbc.merge_admission_subject.compose_explicit_walk_attempt_id(explicit: explicit)
    Absent =>
      match env_var(name: "GITHUB_RUN_ID") {
        Absent => none
        Present { value: run_id } =>
          match env_var(name: "GITHUB_RUN_ATTEMPT") {
            Absent => none
            Present { value: run_attempt } =>
              match env_var(name: "GITHUB_JOB") {
                Absent => none
                Present { value: job } => gunbc.merge_admission_subject.compose_walk_attempt_id(
                  run_id: run_id,
                  run_attempt: run_attempt,
                  job: job
                )
              }
          }
      }
  }
}

fn tested_checkout_base_ref(event_name: String) -> std.types.GitRef {
  if (event_name == "pull_request") || (event_name == "merge_group") {
    "HEAD^1" as std.types.GitRef
  } else {
    "HEAD" as std.types.GitRef
  }
}

fn current_event_name() -> String {
  match env_var(name: "GITHUB_EVENT_NAME") {
    Present { value: event_name } => event_name
    Absent => "workflow_dispatch"
  }
}

type TestedSubjectCaptureRefusal
  = CaptureAttemptIdentityAbsent
  | CaptureHeadCommitRefused
  | CaptureBaseCommitRefused
  | CaptureAttemptDirClearRefused
  | CaptureAttemptDirCreateRefused
  | CaptureSubjectWriteRefused

type TestedSubjectCapture
  = TestedSubjectCaptured
  | TestedSubjectCaptureRefused { cause: TestedSubjectCaptureRefusal }

fn tested_subject_capture_refusal_label(cause: TestedSubjectCaptureRefusal) -> String {
  match cause {
    CaptureAttemptIdentityAbsent => "attempt-identity-absent"
    CaptureHeadCommitRefused => "head-commit-refused"
    CaptureBaseCommitRefused => "base-commit-refused"
    CaptureAttemptDirClearRefused => "attempt-dir-clear-refused"
    CaptureAttemptDirCreateRefused => "attempt-dir-create-refused"
    CaptureSubjectWriteRefused => "subject-write-refused"
  }
}

data merge_admission_capture_refusal_wire_relpath: String = "target/merge-admission-capture-refusal.txt"

data merge_admission_capture_refusal_wire_seed_pairing: String = "PAIRED LITERAL (review 47596): claim_executor.rs MERGE_ADMISSION_CAPTURE_REFUSAL_WIRE reads this exact relpath — the seed cannot import a .dag datum, so a rename here lands with the paired seed edit or the parent's read degrades to its loud wire-absent arm. Same pairing class as floor-population-budget-refusal.txt, under walk_plan_run_stage_claim_executor_seed_deferral."

func tested_subject_capture() -> TestedSubjectCapture {
  match capture_walk_attempt_id() {
    Absent => TestedSubjectCaptureRefused { cause: CaptureAttemptIdentityAbsent }
    Present { value: attempt_id } =>
      let head = git.Inspect.HeadCommit()
      if !head.success {
        TestedSubjectCaptureRefused { cause: CaptureHeadCommitRefused }
      } else {
        let base_ref = tested_checkout_base_ref(event_name: current_event_name())
        let base_commit = git.Inspect.ResolveRefCommit(ref: base_ref)
        if !base_commit.success {
          TestedSubjectCaptureRefused { cause: CaptureBaseCommitRefused }
        } else {
              let root = git.Inspect.Toplevel().path as String
              let attempt_dir = gunbc.merge_admission_subject.merge_admission_attempt_dir(root: root, attempt_id: attempt_id)
              let cleared = shell.Remove.RecursiveForce(path: attempt_dir as std.types.FilePath)
              if !cleared.success {
                TestedSubjectCaptureRefused { cause: CaptureAttemptDirClearRefused }
              } else {
                let ready = shell.Mkdir.Parents(path: attempt_dir as std.types.FilePath)
                if !ready.success {
                  TestedSubjectCaptureRefused { cause: CaptureAttemptDirCreateRefused }
                } else {
                  let subject = gunbc.merge_admission_subject.TestedSubject {
                    attempt_id: attempt_id,
                    head_sha: head.sha,
                    base_ref: gunbc.merge_admission_subject.merge_admission_merge_base_ref,
                    base_commit_sha: base_commit.sha,
                  }
                  let written = extdeps.filesystem.filesystem_io.Filesystem.Write(
                    path: gunbc.merge_admission_subject.merge_admission_tested_subject_path(root: root, attempt_id: attempt_id),
                    content: gunbc.merge_admission_subject.render_tested_subject_wire(subject: subject)
                  )
                  if written.success {
                    TestedSubjectCaptured
                  } else {
                    TestedSubjectCaptureRefused { cause: CaptureSubjectWriteRefused }
                  }
                }
              }
        }
      }
  }
}

func capture_refusal_wire_path() -> std.types.FilePath {
  let root = git.Inspect.Toplevel().path as String
  concat(concat(root, "/"), merge_admission_capture_refusal_wire_relpath) as std.types.FilePath
}

func write_capture_refusal_wire(cause: TestedSubjectCaptureRefusal) -> Bool {
  extdeps.filesystem.filesystem_io.Filesystem.Write(
    path: capture_refusal_wire_path(),
    content: concat(concat("cause=", tested_subject_capture_refusal_label(cause: cause)), "\n")
  ).success
}

func capture_tested_subject() -> Bool {
  let _ = shell.Remove.RecursiveForce(path: capture_refusal_wire_path())
  match tested_subject_capture() {
    TestedSubjectCaptured => true
    TestedSubjectCaptureRefused { cause: cause } =>
      let _ = write_capture_refusal_wire(cause: cause)
      false
  }
}
