module tools.build_step


// Shell text emission for build-artifact verification lives in v2.workflow.build_step_emit (grammar-row serializer via bash_command_fold_serialize.bash_fold_serialize_program). This module retains v2.std.node.Node stmt construction only.
type BuildArtifact {
  path: v2.std.node.Node
  name: String
}

fn build_verify_echo(msg: v2.std.node.Node) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_with_redir(
    inner: v2.extdeps.languages.bash_build.bash_build_command_with_words(
      words: [
        v2.extdeps.languages.bash_build.bash_build_word_lit(text: "echo"),
        msg
      ]
    ),
    redir: ^bash_production_fold_redir_stdout_to_stderr
  )
}

fn build_test_not_executable(path: v2.std.node.Node) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_test_bracket(
    words: [
      v2.extdeps.languages.bash_build.bash_build_word_lit(text: "!"),
      v2.extdeps.languages.bash_build.bash_build_word_lit(text: "-x"),
      path
    ]
  )
}

fn build_test_empty(path: v2.std.node.Node) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_test_bracket(
    words: [
      v2.extdeps.languages.bash_build.bash_build_word_lit(text: "!"),
      v2.extdeps.languages.bash_build.bash_build_word_lit(text: "-s"),
      path
    ]
  )
}

fn verify_artifact_exists(art: BuildArtifact) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_if(
    cond: build_test_not_executable(path: art.path),
    body: v2.extdeps.languages.bash_build.bash_build_stmt_list_from_nodes(stmts: [
      build_verify_echo(
        msg: v2.extdeps.languages.bash_build.bash_build_word_concat_parts(parts: [
          v2.extdeps.languages.bash_build.bash_build_word_lit(
            text: concat(
              "::error::build verification: declared artifact '",
              concat(art.name, "' absent or not executable after a 'successful' build (sccache/cache corruption — DESIGN §5 fail-open); failing closed: ")
            )
          ),
          art.path
        ])
      ),
      v2.extdeps.languages.bash_build.bash_build_exit(code: "1")
    ])
  )
}

fn verify_artifact_nonempty(art: BuildArtifact) -> v2.std.node.Node {
  v2.extdeps.languages.bash_build.bash_build_if(
    cond: build_test_empty(path: art.path),
    body: v2.extdeps.languages.bash_build.bash_build_stmt_list_from_nodes(stmts: [
      build_verify_echo(
        msg: v2.extdeps.languages.bash_build.bash_build_word_concat_parts(parts: [
          v2.extdeps.languages.bash_build.bash_build_word_lit(
            text: concat(
              "::error::build verification: declared artifact '",
              concat(art.name, "' is zero-byte after a 'successful' build (sccache served a truncated/empty cached artifact — DESIGN §5 fail-open); failing closed: ")
            )
          ),
          art.path
        ])
      ),
      v2.extdeps.languages.bash_build.bash_build_exit(code: "1")
    ])
  )
}

fn verify_artifact(art: BuildArtifact) -> List<v2.std.node.Node> {
  [verify_artifact_exists(art: art), verify_artifact_nonempty(art: art)]
}

fn emit_verifications(produces: List<BuildArtifact>) -> List<v2.std.node.Node> {
  fold(produces, init: [], f: (acc, art) => concat(acc, verify_artifact(art: art)))
}
