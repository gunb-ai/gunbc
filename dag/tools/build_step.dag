module tools.build_step

import extdeps.languages.bash.program {
  ShellStmt, ShellWord, ShellProgram,
  Command, If, Exit, WithRedir,
  Lit, Concat, StdoutToStderr,
  lit, command, serialize_bash
}

type BuildArtifact {
  path: ShellWord

  name: String
}

fn build_verify_echo(msg: ShellWord) -> ShellStmt {
  WithRedir {
    stmt: command(words: [lit(text: "echo"), msg]),
    redir: StdoutToStderr
  }
}

fn verify_artifact_exists(art: BuildArtifact) -> ShellStmt {
  If {
    cond: command(words: [lit(text: "["), lit(text: "!"), lit(text: "-x"), art.path, lit(text: "]")]),
    then: [
      build_verify_echo(msg: Concat { parts: [
        lit(text: concat("::error::build verification: declared artifact '", concat(art.name, "' absent or not executable after a 'successful' build (sccache/cache corruption — DESIGN §5 fail-open); failing closed: "))),
        art.path
      ] }),
      Exit { code: 1 }
    ]
  }
}

fn verify_artifact_nonempty(art: BuildArtifact) -> ShellStmt {
  If {
    cond: command(words: [lit(text: "["), lit(text: "!"), lit(text: "-s"), art.path, lit(text: "]")]),
    then: [
      build_verify_echo(msg: Concat { parts: [
        lit(text: concat("::error::build verification: declared artifact '", concat(art.name, "' is zero-byte after a 'successful' build (sccache served a truncated/empty cached artifact — DESIGN §5 fail-open); failing closed: "))),
        art.path
      ] }),
      Exit { code: 1 }
    ]
  }
}

fn verify_artifact(art: BuildArtifact) -> List<ShellStmt> {
  [verify_artifact_exists(art: art), verify_artifact_nonempty(art: art)]
}

fn emit_verifications(produces: List<BuildArtifact>) -> List<ShellStmt> {
  fold(produces, init: [], f: (acc, art) => concat(acc, verify_artifact(art: art)))
}

fn verifications_script(produces: List<BuildArtifact>) -> String {
  serialize_bash(p: ShellProgram {
    set_e: false,
    statements: emit_verifications(produces: produces)
  })
}
