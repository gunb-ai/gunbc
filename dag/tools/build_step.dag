module tools.build_step


data build_step_serialize_dissolution_note: String = "Shell text emission for build-artifact verification lives in v2.workflow.build_step_emit (grammar-row serializer via bash_command_fold_serialize.bash_fold_serialize_program). This module retains Node stmt construction only."

type BuildArtifact {
  path: Node
  name: String
}

fn build_verify_echo(msg: Node) -> Node {
  bash_build_with_redir(
    inner: bash_build_command_with_words(
      words: [
        bash_build_word_lit(text: "echo"),
        msg
      ]
    ),
    redir: ^bash_production_fold_redir_stdout_to_stderr
  )
}

fn build_test_not_executable(path: Node) -> Node {
  bash_build_test_bracket(
    words: [
      bash_build_word_lit(text: "!"),
      bash_build_word_lit(text: "-x"),
      path
    ]
  )
}

fn build_test_empty(path: Node) -> Node {
  bash_build_test_bracket(
    words: [
      bash_build_word_lit(text: "!"),
      bash_build_word_lit(text: "-s"),
      path
    ]
  )
}

fn verify_artifact_exists(art: BuildArtifact) -> Node {
  bash_build_if(
    cond: build_test_not_executable(path: art.path),
    body: bash_build_stmt_list_from_nodes(stmts: [
      build_verify_echo(
        msg: bash_build_word_concat_parts(parts: [
          bash_build_word_lit(
            text: concat(
              "::error::build verification: declared artifact '",
              concat(art.name, "' absent or not executable after a 'successful' build (sccache/cache corruption — DESIGN §5 fail-open); failing closed: ")
            )
          ),
          art.path
        ])
      ),
      bash_build_exit(code: "1")
    ])
  )
}

fn verify_artifact_nonempty(art: BuildArtifact) -> Node {
  bash_build_if(
    cond: build_test_empty(path: art.path),
    body: bash_build_stmt_list_from_nodes(stmts: [
      build_verify_echo(
        msg: bash_build_word_concat_parts(parts: [
          bash_build_word_lit(
            text: concat(
              "::error::build verification: declared artifact '",
              concat(art.name, "' is zero-byte after a 'successful' build (sccache served a truncated/empty cached artifact — DESIGN §5 fail-open); failing closed: ")
            )
          ),
          art.path
        ])
      ),
      bash_build_exit(code: "1")
    ])
  )
}

fn verify_artifact(art: BuildArtifact) -> List<Node> {
  [verify_artifact_exists(art: art), verify_artifact_nonempty(art: art)]
}

fn emit_verifications(produces: List<BuildArtifact>) -> List<Node> {
  fold(produces, init: [], f: (acc, art) => concat(acc, verify_artifact(art: art)))
}
