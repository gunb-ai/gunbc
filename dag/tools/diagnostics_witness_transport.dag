module tools.diagnostics_witness_transport

import extdeps.shell
import extdeps.languages.bash.program {
  ShellProgram,
  lit, var_ref, command, serialize_bash
}
import tools.host_prelude { ensure_diagnostics_witness_built }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.logic { Bool }

data diagnostics_import_resolution_suite: String = "import_resolution"
data diagnostics_reexport_surface_suite: String = "reexport_surface"
data diagnostics_type_and_arity_suite: String = "type_and_arity"
data diagnostics_empty_list_context_suite: String = "empty_list_context"
data diagnostics_constructor_owner_suite: String = "constructor_owner"

fn diagnostics_witness_program(suite: String) -> ShellProgram {
  let root = var_ref(name: "ROOT")
  ShellProgram {
    set_e: true,
    statements: concat(ensure_diagnostics_witness_built(), [
      command(words: [lit(text: "cd"), root]),
      command(words: [var_ref(name: "DIAGNOSTICS_WITNESS"), lit(text: suite)])
    ])
  }
}

data diagnostics_witness_transport_disposition: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.languages.bash.program",
    decl_name: "serialize_bash",
    field: WholeDeclaration
  }
}

fn run_diagnostics_import_resolution_witness() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: diagnostics_witness_program(suite: diagnostics_import_resolution_suite)))
  result.success
}

fn run_diagnostics_reexport_surface_witness() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: diagnostics_witness_program(suite: diagnostics_reexport_surface_suite)))
  result.success
}

fn run_diagnostics_type_and_arity_witness() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: diagnostics_witness_program(suite: diagnostics_type_and_arity_suite)))
  result.success
}

fn run_diagnostics_empty_list_context_witness() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: diagnostics_witness_program(suite: diagnostics_empty_list_context_suite)))
  result.success
}

fn run_diagnostics_constructor_owner_witness() -> Bool {
  let result = shell.Exec.Run(script: serialize_bash(p: diagnostics_witness_program(suite: diagnostics_constructor_owner_suite)))
  result.success
}
