module tools.emit_falsifier_yaml


func main() -> ProcessExit {
  let path = artifact_path(a: FalsifierYamlArtifact)
  let content = expected_falsifier_yml()
  let w = Filesystem.Write(path: path, content: content)
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat(concat("write failed for ", path), concat(": ", w.error)))
  }
}
