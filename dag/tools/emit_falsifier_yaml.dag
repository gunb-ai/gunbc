module tools.emit_falsifier_yaml

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.falsifier_workflow { expected_falsifier_yml }
import gunbc.generated_artifact { FalsifierYamlArtifact, artifact_path }

func main() -> ProcessExit {
  let path = artifact_path(a: FalsifierYamlArtifact)
  let content = expected_falsifier_yml()
  let w = Filesystem.Write(path: path, content: content)
  if w.success {
    ExitSuccess
  } else {
    exit_failure(reason: concat(concat("write failed for ", path), concat(": ", w.error)))
  }
}
