module tools.cheap_gate_pool


data cheap_gate_pool_note: String = "ONE pooled claim_batch child for the whole cheap batch (CI floor endgame D1, 2026-07-23; the cold-child class, attribution doc section 9/9.2): after #7122's per-gate pooling, batch 0 still spawned one child per claim-backed gate (layering ~88s + extdeps ~64s on run 30009199696), each paying its own corpus-denominated MultiEntryIndex build over the SAME source roots. The union pool runs every batch-0 claim in one child (srv1 counterfactual: all 12 claims in ONE process 93.4s vs 480s serial), so the shared std/spec closure typechecks once per batch instead of once per gate. The pool membership is DERIVED — layering_imports_claims plus extdeps_external_authority_claims, the two concern authorities — never a third hand-kept roster (roster_registry: ByDerivation). Per-claim verdicts stay named by claim_batch's own PASS-per-function / FAIL-per-function loop with no short-circuit, and the per-gate concern rows survive as pure ENROLLMENT WALLS asserting chunk-transform totality for their claims (see chunk_totality_wall_note — bare pool membership would be vacuous since the pool is their union by construction). Gate-grain attribution deliberately moves to the pool gate: a failing claim names ITSELF in the child's FAIL line, which is the finer grain."

data cheap_gate_pool_slot_sizing_note: String = "K sub-pools sized to the slot (attribution doc section 9.1, the pooling memory cliff): on the Pi bench a pooled process whose UNIONED closure thrashes under the memory envelope loses the whole pooling win (pooled 73m vs spawn-sum 66m), and the same cliff exists inside 16GiB slot cgroups under fleet pressure. So the pool is chunked: at most cheap_gate_pool_max_claims_per_child claims per child, K children serial when the union exceeds it — never one unbounded union. Today's batch-0 union is 12 claims over small fixture closures (K=1); the cap is the declared wall that keeps a future enrollment from silently growing one child past the slot. The pooled child is a SEPARATE process from the executor by design (never in-executor evaluation: the executor is the 16GiB-pinned process of the 2026-07-23 crawl; the child dies and frees). Raising the cap is a conscious data edit here, priced against the slot budget."

data cheap_gate_pool_max_claims_per_child: Int = 16

fn claim_key(c: ClaimRun) -> String {
  concat(c.entry, concat("::", c.function))
}

fn cheap_claim_pool_claims() -> List<ClaimRun> {
  concat(layering_imports_claims(), extdeps_external_authority_claims())
}

type CheapPoolChunkAcc {
  chunks: List<List<ClaimRun>>
  current: List<ClaimRun>
  current_len: Int
}

fn chunk_step(acc: CheapPoolChunkAcc, c: ClaimRun, max_per_child: Int) -> CheapPoolChunkAcc {
  if acc.current_len >= max_per_child {
    CheapPoolChunkAcc {
      chunks: concat(acc.chunks, [acc.current]),
      current: [c],
      current_len: 1
    }
  } else {
    CheapPoolChunkAcc {
      chunks: acc.chunks,
      current: concat(acc.current, [c]),
      current_len: acc.current_len + 1
    }
  }
}

fn chunk_claims(claims: List<ClaimRun>, max_per_child: Int) -> List<List<ClaimRun>> {
  let folded = fold(
    claims,
    init: CheapPoolChunkAcc { chunks: [], current: [], current_len: 0 },
    f: fn(acc, c) { chunk_step(acc: acc, c: c, max_per_child: max_per_child) }
  )
  if folded.current_len > 0 {
    concat(folded.chunks, [folded.current])
  } else {
    folded.chunks
  }
}

fn run_cheap_claim_pool() -> Bool {
  let chunks = chunk_claims(
    claims: cheap_claim_pool_claims(),
    max_per_child: cheap_gate_pool_max_claims_per_child
  )
  fold(chunks, init: true, f: fn(acc, chunk) {
    let ok = run_gunbc_claims(source_roots: witness_layer_roots, claims: chunk)
    acc && ok
  })
}

fn claim_in_pool(c: ClaimRun, pool: List<ClaimRun>) -> Bool {
  fold(pool, init: false, f: fn(found, p) {
    found || (claim_key(c: p) == claim_key(c: c))
  })
}

data chunk_totality_wall_note: String = "The non-vacuous wall (review catch, endgame D1): the derived pool CANNOT drop a concern row — it is the union of the two concern lists by construction, so a bare membership check against the pool would be a tautology (an inert gate, the coverage-by-illusion class). What CAN drop a claim is the K-chunking transform between the pool and the spawned children — new fold code sitting between declaration and execution. So each concern gate asserts chunk-transform TOTALITY for its claims: every claim reaches some chunked child's roster (the compile_clean_shard_totality pattern, applied to this partition). The RED direction is real: a chunker edit that loses or fuses rows reds both concern gates before the pool even spawns."

fn cheap_pool_chunked_claims() -> List<ClaimRun> {
  fold(
    chunk_claims(
      claims: cheap_claim_pool_claims(),
      max_per_child: cheap_gate_pool_max_claims_per_child
    ),
    init: [],
    f: fn(acc, chunk) { concat(acc, chunk) }
  )
}

fn claims_covered_by_cheap_pool_chunks(claims: List<ClaimRun>) -> Bool {
  let chunked = cheap_pool_chunked_claims()
  fold(claims, init: true, f: fn(ok, c) {
    ok && claim_in_pool(c: c, pool: chunked)
  })
}
