module tools.walk_target_alias_apply

import std.algebra { Cons, Empty }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, Terminal }
import std.types { String, Bool, Int, list_length }
import tools.walk_target_alias_plan {
  WalkTargetAliasPlan,
  WalkTargetAliasPlanRow,
  walk_target_alias_plan_class_label
}
import v2.std.algebra { fold_list_node, list_append, list_snoc_item }
import v2.std.collection { Optional, Absent, Present, optional_absent, optional_present }
import v2.std.diagnostic {
  Outcome,
  Accepted,
  Rejected,
  Diagnostic,
  None,
  bind_outcome,
  outcome_rejected,
  outcome_accepted
}
import v2.std.node {
  Node,
  Symbol,
  Edge,
  Named,
  Positional,
  TypeNode,
  Conj,
  Atom,
  SyntheticOccurrence
}
import v2.std.namespace_alias { AliasBindingRow }
import v2.std.qualified_name { QualifiedName, qualified_name_from_dotted_string }
import v2.std.node_query { find_named_child }
import v2.compiler.tokenize { tokenize }
import v2.compiler.parse { parse }
import v2.compiler.translate { target_serialize_source_from_model }
import v2.extdeps.languages.dag {
  dag_language_model,
  dag_target_model,
  parse_production_emitted_identity_optional,
  emit_alias_decl_emitted_node,
  emit_bound_token
}

data walk_target_alias_apply_authority_note: String = "§13 walk-target alias codemod APPLY phase (namespace-resolution-design.md). Pure fold over plan rows → typed effect plan; alias surface text via grammar emit/serialize (never Rust format!); corpus writes gated on #6979; insert anchor derived from parsed module Node tree (operator ruling msg_774deff3). Plan types/fold authority: tools.walk_target_alias_plan (Phase 7 #6984 Rust retirement gated on equivalence receipt). dissolve-on: stern-owl-401 Phase 3 refusal flip."

data walk_target_alias_apply_corpus_write_gated_reason: String = "corpus --write refused: alias decl surface is unparseable until #6979 alias parse arm merges (operator ruling 2026-07-22); use dry-run apply + pre-edit oracles now; post-edit whole-tree binding-identity oracle discharges after #6979"

data walk_target_alias_apply_executed_oracle_seed_scaffold: Disposition = Scaffold {
  dissolves_to: Terminal,
  bind: DeclarationRef {
    module_path: "tools.walk_target_alias_apply",
    decl_name: "walk_target_alias_binding_identity_oracle_executed_refused",
    field: WholeDeclaration
  }
}

data walk_target_alias_apply_executed_oracle_dissolve_trigger: String = "dissolve-on: executed binding-identity oracle requires whole-tree resolve + census replay in-workflow; until .dag-callable resolve bridge lands, transport refuses with walk_target_alias_binding_identity_oracle_executed_refused (seed-gap row 1 escalation)"

data walk_target_alias_apply_module_index_seed_gap: String = "module_path_index: build_module_path_index / v2.compiler.source_authority bridge not yet callable from .dag workflow (seed-gap row 2 — escalate before live corpus apply)"

type WalkTargetAliasApplyEdit {
  declaring_module: String
  rel_source_path: String
  binding: String
  alias_line: String
  written: Bool
}

type WalkTargetAliasApplyReport {
  edits: List<WalkTargetAliasApplyEdit>
  skipped_existing: Int
  refused: List<String>
  source_scope_label: String
  binding_identity_oracle_passed: Bool
  write_requested: Bool
}

type ModuleInsertAnchor {
  child_index: Int
}

type ChildEdgeSplit {
  prefix: List<Edge>
  suffix: List<Edge>
}

fn walk_target_alias_corpus_write_refused(write_requested: Bool) -> Optional<String> {
  if write_requested {
    optional_present(value: walk_target_alias_apply_corpus_write_gated_reason)
  } else {
    optional_absent()
  }
}

fn walk_target_alias_binding_identity_oracle_static(
  rows: List<WalkTargetAliasPlanRow>
) -> Optional<String> {
  fold(
    rows,
    init: optional_absent(),
    f: fn(acc, row) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if !row.walk_verified {
            optional_present(
              value: concat(
                "BINDING_IDENTITY_ORACLE: module=",
                concat(
                  row.key.declaring_module,
                  concat(
                    " binding=",
                    concat(
                      row.key.binding,
                      concat(" class=", walk_target_alias_plan_class_label(class: row.key.class))
                    )
                  )
                )
              )
            )
          } else if row.key.walk_target_qualified_path != row.pre_flip_qualified_path {
            optional_present(
              value: concat(
                "BINDING_IDENTITY_ORACLE: module=",
                concat(
                  row.key.declaring_module,
                  concat(
                    " binding=",
                    concat(
                      row.key.binding,
                      concat(
                        " walk_target=",
                        concat(
                          row.key.walk_target_qualified_path,
                          concat(" != pre_flip_qn=", row.pre_flip_qualified_path)
                        )
                      )
                    )
                  )
                )
              )
            )
          } else {
            optional_absent()
          }
      }
    }
  )
}

fn walk_target_alias_binding_identity_oracle_executed_refused() -> String {
  "BINDING_IDENTITY_ORACLE_EXECUTED: whole-tree resolve replay not yet wired in .dag workflow (seed-gap row 1 — escalate before enabling live corpus apply)"
}

fn alias_apply_subtree_has_emitted_identity(node: Node, emitted: Symbol) -> Bool {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == emitted {
        true
      } else {
        alias_apply_subtree_has_emitted_identity_in_children(node: node, emitted: emitted)
      }
    Absent => alias_apply_subtree_has_emitted_identity_in_children(node: node, emitted: emitted)
  }
}

fn alias_apply_subtree_has_emitted_identity_in_children(node: Node, emitted: Symbol) -> Bool {
  fold(
    node.children,
    init: false,
    f: fn(found, edge) {
      if found {
        true
      } else {
        alias_apply_subtree_has_emitted_identity(node: edge.target, emitted: emitted)
      }
    }
  )
}

fn alias_apply_node_is_import_decl(node: Node) -> Bool {
  alias_apply_subtree_has_emitted_identity(node: node, emitted: ^dag_surface_import_decl)
}

type AliasApplyInsertScan
  = AliasApplyInsertScanContinue { index: Int, anchor: Int }
  | AliasApplyInsertScanDone { anchor: Int }

fn alias_apply_node_is_module_header(node: Node) -> Bool {
  alias_apply_subtree_has_emitted_identity(node: node, emitted: ^dag_surface_module_header)
}

fn alias_apply_insert_scan_step(
  state: AliasApplyInsertScan,
  edge: Edge
) -> AliasApplyInsertScan {
  match state {
    AliasApplyInsertScanDone { anchor: a } => AliasApplyInsertScanDone { anchor: a }
    AliasApplyInsertScanContinue { index: i, anchor: a } =>
      if alias_apply_node_is_module_header(node: edge.target) {
        AliasApplyInsertScanContinue { index: i + 1, anchor: a }
      } else if alias_apply_node_is_import_decl(node: edge.target) {
        AliasApplyInsertScanContinue { index: i + 1, anchor: i + 1 }
      } else {
        AliasApplyInsertScanDone { anchor: a }
      }
  }
}

fn alias_apply_find_module_root_in_children(node: Node) -> Optional<Node> {
  fold(
    node.children,
    init: optional_absent(),
    f: fn(acc, edge) {
      match acc {
        Present { value: _ } => acc
        Absent => alias_apply_find_module_root(node: edge.target)
      }
    }
  )
}

fn alias_apply_find_module_root(node: Node) -> Optional<Node> {
  match parse_production_emitted_identity_optional(node: node) {
    Present { value: id } =>
      if id == ^dag_surface_module {
        optional_present(value: node)
      } else {
        alias_apply_find_module_root_in_children(node: node)
      }
    Absent => alias_apply_find_module_root_in_children(node: node)
  }
}

fn alias_apply_insert_scan_root(node: Node) -> Outcome<ModuleInsertAnchor> {
  let final_state = fold(
    node.children,
    init: AliasApplyInsertScanContinue { index: 0, anchor: 0 },
    f: fn(state, edge) { alias_apply_insert_scan_step(state: state, edge: edge) }
  )
  match final_state {
    AliasApplyInsertScanDone { anchor: a } =>
      outcome_accepted(value: ModuleInsertAnchor { child_index: a })
    AliasApplyInsertScanContinue { index: _, anchor: a } =>
      outcome_accepted(value: ModuleInsertAnchor { child_index: a })
  }
}

fn alias_apply_insert_anchor_after_import_block(module_root: Node) -> Outcome<ModuleInsertAnchor> {
  match alias_apply_find_module_root(node: module_root) {
    Present { value: root } => alias_apply_insert_scan_root(node: root)
    Absent => alias_apply_insert_scan_root(node: module_root)
  }
}

fn alias_apply_sym_atom(sym: Symbol) -> Node {
  Node {
    kind: TypeNode { connective: Atom { identity: sym } },
    children: [],
    occurrence_id: SyntheticOccurrence
  }
}

fn alias_apply_qualified_name_emit_node(qn: QualifiedName) -> Node {
  fold_list_node(xs: qn, item_node: fn(sym) { alias_apply_sym_atom(sym: sym) })
}

fn alias_apply_row_node_from_binding_row(row: AliasBindingRow) -> Node {
  emit_alias_decl_emitted_node(
    binding: emit_bound_token(token_class: ^dag_token_ident, binding: row.binding),
    target: alias_apply_qualified_name_emit_node(qn: row.target)
  )
}

fn alias_apply_source_line_from_row(row: AliasBindingRow) -> Outcome<String> {
  let decl = alias_apply_row_node_from_binding_row(row: row)
  bind_outcome(
    o: target_serialize_source_from_model(target: dag_target_model(), emitted: decl),
    f: fn(medium) {
      outcome_accepted(value: medium.carried)
    }
  )
}

fn alias_apply_parse_module_source(text: String, file_anchor: Symbol) -> Outcome<Node> {
  let lm = dag_language_model()
  bind_outcome(
    o: tokenize(text: text, file: file_anchor, rules: lm.lex),
    f: fn(token_stream) {
      parse(tokens: token_stream, grammar: lm.grammar)
    }
  )
}

fn alias_apply_split_children_at(children: List<Edge>, at: Int) -> ChildEdgeSplit {
  fold(
    children,
    init: ChildEdgeSplit { prefix: [], suffix: [] },
    f: fn(state, edge) {
      if list_length(items: state.prefix) < at {
        ChildEdgeSplit {
          prefix: list_snoc_item(xs: state.prefix, item: edge),
          suffix: state.suffix
        }
      } else {
        ChildEdgeSplit {
          prefix: state.prefix,
          suffix: list_snoc_item(xs: state.suffix, item: edge)
        }
      }
    }
  )
}

fn alias_apply_module_with_inserted_row(
  module_root: Node,
  anchor: ModuleInsertAnchor,
  row: AliasBindingRow
) -> Node {
  let split = alias_apply_split_children_at(children: module_root.children, at: anchor.child_index)
  let new_edge = Edge {
    label: Positional,
    target: alias_apply_row_node_from_binding_row(row: row)
  }
  Node {
    kind: module_root.kind,
    children: list_append(
      left: split.prefix,
      right: list_append(left: [new_edge], right: split.suffix)
    ),
    occurrence_id: module_root.occurrence_id
  }
}

fn alias_apply_module_tree_has_binding(module_root: Node, binding: Symbol) -> Bool {
  fold(
    module_root.children,
    init: false,
    f: fn(found, edge) {
      if found {
        true
      } else {
        match parse_production_emitted_identity_optional(node: edge.target) {
          Present { value: id } =>
            if id == ^dag_surface_alias_decl {
              match find_named_child(root: edge.target, name: ^dag_surface_alias_decl_binding) {
                Accepted { value: binding_node, diagnostics: _ } =>
                  match parse_production_emitted_identity_optional(node: binding_node) {
                    Present { value: bound } => bound == binding
                    Absent => false
                  }
                Rejected { diagnostics: _ } => false
              }
            } else {
              false
            }
          Absent => false
        }
      }
    }
  )
}

fn alias_apply_binding_row_from_plan_row(row: WalkTargetAliasPlanRow) -> AliasBindingRow {
  AliasBindingRow {
    binding: row.key.binding,
    target: qualified_name_from_dotted_string(dotted: row.pre_flip_qualified_path)
  }
}

fn walk_target_alias_apply_plan_pure(
  plan: WalkTargetAliasPlan,
  write_requested: Bool
) -> Outcome<WalkTargetAliasApplyReport> {
  match walk_target_alias_corpus_write_refused(write_requested: write_requested) {
    Present { value: reason } => outcome_rejected(Diagnostic { reason: reason, at: none, correction: none })
    Absent =>
      match walk_target_alias_binding_identity_oracle_static(rows: plan.rows) {
        Present { value: oracle_msg } =>
          outcome_rejected(Diagnostic { reason: oracle_msg, at: none, correction: none })
        Absent =>
          outcome_accepted(
            value: WalkTargetAliasApplyReport {
              edits: [],
              skipped_existing: 0,
              refused: [walk_target_alias_apply_module_index_seed_gap],
              source_scope_label: plan.source_scope_label,
              binding_identity_oracle_passed: true,
              write_requested: write_requested
            }
          )
      }
  }
}

