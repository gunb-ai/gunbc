
module tools.generated_artifact_gate

import std.process { ProcessExit, ExitSuccess, exit_failure }
import extdeps.filesystem.filesystem_io { Filesystem }
import gunbc.generated_artifact {
  GeneratedArtifact,
  committed_generated_artifacts,
  artifact_path
}
import gunbc.generated_artifact_observation {
  observe_generated_artifact_population
}
import gunbc.generated_artifact_assessment {
  assess_generated_artifact_population,
  first_failing_diagnostic_path,
  GeneratedArtifactObservation,
  GeneratedArtifactObserved,
  GeneratedArtifactObservationRefused
}

fn exit_ok(e: ProcessExit) -> Bool {
  match e { ExitSuccess => true  _ => false }
}

data run_generated_artifact_drift_gate_body_note: String = "One live pass: observe_generated_artifact_population() reads each committed file and generates each artifact exactly once (gunbc.generated_artifact_observation). The pure group and leaf assessments, and the failure diagnostic, all read that SAME retained population — no re-invocation of the producer (operator ruling: cost and correctness must not ride on incidental memoization of a repeated producer call)."

func run_generated_artifact_drift_gate_body() -> ProcessExit {
  let observations = observe_generated_artifact_population()
  let all_ok = assess_generated_artifact_population(expected: committed_generated_artifacts(), observations: observations)
  let reason = if all_ok {
    ""
  } else {
    concat(
      concat("generated-artifact drift/validation failed: ", first_failing_diagnostic_path(expected: committed_generated_artifacts(), observations: observations)),
      " — it is a GENERATED projection of its .dag authority; do not hand-edit, regenerate via main_wet on dag/tools/generated_artifact_gate.dag"
    )
  }
  if !all_ok {
    record_generated_artifact_drift_gate_failure_detail(detail: reason)
  }
  return if all_ok {
    ExitSuccess
  } else {
    exit_failure(reason: reason)
  }
}

func main() -> ProcessExit {
  run_generated_artifact_drift_gate_body()
}

func run_generated_artifact_drift_gate() -> ProcessExit {
  run_generated_artifact_drift_gate_body()
}

data generated_artifact_drift_failure_receipt_note: String = "The loudness half: the floor witness collapses this gate's ProcessExit to Bool via tools.ci_gates.exit_ok, so a generated-artifact drift red reported only returned Bool(false) without the located path. The gate body records the reason from its single observe_generated_artifact_population pass; the failure-receipt companion consumes that retained detail instead of re-observing."

fn generated_artifact_drift_failure_reason(exit: ProcessExit) -> String {
  match exit {
    ExitSuccess => ""
    ExitFailure { code: _, reason: reason } => reason
  }
}

func generated_artifact_drift_failure_receipt() -> String {
  consume_generated_artifact_drift_gate_failure_detail()
}

data heal_writes_the_assessed_bytes_note: String = "HEAL WRITES WHAT DRIFT ASSESSED, and does not produce its own. The previous body folded committed_generated_artifacts() calling artifact_generate again, so the bytes written were a SECOND generation that the gate had never seen — merely expected to match it. Any input that moved between the two passes, or any nondeterminism in the generator, and the repository received content no gate approved. It also wrote every registered artifact unconditionally, having assessed nothing, so a clean tree was fully rewritten on every heal. Now the write set is a projection of the same observation population the drift gate reads: one Filesystem.Read and one artifact_generate per artifact, in one pass, and a write exactly where the generated bytes differ from the committed ones. A refused observation refuses the heal rather than being skipped, because an artifact that could not be generated or read is not an artifact known to be clean."

fn heal_observation(acc: ProcessExit, o: GeneratedArtifactObservation) -> ProcessExit {
  if !exit_ok(e: acc) {
    acc
  } else {
    match o {
      GeneratedArtifactObservationRefused { artifact: _, path: path, cause: cause } =>
        exit_failure(reason: concat(concat("heal refused for ", path), concat(": ", cause)))
      GeneratedArtifactObserved {
        artifact: _,
        path: path,
        generated_content: generated,
        committed_content: committed,
        extra_validation: _
      } =>
        if generated == committed {
          ExitSuccess
        } else {
          let w = Filesystem.Write(path: path, content: generated)
          if w.success {
            ExitSuccess
          } else {
            exit_failure(reason: concat(concat("write failed for ", path), concat(": ", w.error)))
          }
        }
    }
  }
}

func main_wet() -> ProcessExit {
  fold(observe_generated_artifact_population(), init: ExitSuccess, f: heal_observation)
}
