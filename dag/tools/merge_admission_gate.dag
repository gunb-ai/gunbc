module tools.merge_admission_gate


fn verdict_reason(v: MergeAdmissionVerdict) -> String {
  match v {
    MergeAdmitted => "admitted"
    MergeDeniedStaleBase => "stale base tree — re-run CI against current main"
    MergeDeniedStaleRoster => "stale gate roster — re-run CI after criteria change"
    MergeDeniedNotSuccess => "receipt conclusion is not success"
  }
}

func main() -> ProcessExit {
  let root = git.Core.Toplevel().path as String
  let path = merge_admission_receipt_path(root: root)
  let read = Filesystem.Read(path: path)
  if !read.success {
    return exit_failure(
      reason: concat(
        "merge_admission_gate: receipt missing at ",
        concat(path, " — CI floor must stamp a receipt on green")
      )
    )
  }
  match parse_receipt_wire(text: read.content) {
    Absent =>
      exit_failure(reason: "merge_admission_gate: receipt wire format invalid")
    Present { value: receipt } =>
      match observe_merge_target_tree_hash(ref: merge_admission_merge_base_ref as GitRef) {
        MergeTargetTreeHashRefused { ref: ref, cause: cause } =>
          exit_failure(
            reason: merge_target_tree_hash_refusal_reason(
              prefix: "merge_admission_gate",
              ref: ref,
              cause: cause
            )
          )
        MergeTargetTreeHashOk { hash: target } => {
          let verdict = classify_merge_admission_verdict(
            receipt: receipt,
            merge_target_tree_hash: target,
            current_roster_hash: current_gate_roster_hash,
          )
          if merge_admission_blocks_merge(
            receipt: receipt,
            merge_target_tree_hash: target,
            current_roster_hash: current_gate_roster_hash,
          ) {
            exit_failure(
              reason: concat(
                "merge_admission_gate: blocked (",
                concat(verdict_reason(v: verdict), ")")
              )
            )
          } else {
            ExitSuccess
          }
        }
      }
  }
}
