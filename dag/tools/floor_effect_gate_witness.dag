}

func scope_placement_gate_loudness_seed_probe_passes() -> Bool {
  false
}

func scope_placement_gate_loudness_seed_probe_failure_receipt() -> String {
  scope_placement_failure_reason(
    exit: scope_placement_membership_verdict(
      observation: gunbc.extdeps_scope_frontier.AddedPathsObserved { paths: ["dag/extdeps/browser/opera.dag"] }
    )
  )
}

func dag_compile_clean_gate_failure_receipt() -> String {
  dag_compile_clean_failure_receipt()
}

func generated_artifact_drift_gate_failure_receipt() -> String {
  generated_artifact_drift_failure_receipt()
}

func regen_verify_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: RegenVerifyGate))
}

func regen_verify_gate_failure_receipt() -> String {
