module tools.floor_effect_gate_witness

import gunbc.ci_gate { EmitHostGate, CheapClaimPoolGate, LayeringImportsGate }
import gunbc.ci_spec {
  ExtdepsExternalAuthorityGate, DagCompileCleanGate, GeneratedArtifactDriftGate,
  RegenVerifyGate
}
import tools.ci_gates { exit_ok, run_spec_gate }

func emit_host_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: EmitHostGate))
}

func cheap_claim_pool_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: CheapClaimPoolGate))
}

func layering_imports_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: LayeringImportsGate))
}

func extdeps_external_authority_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: ExtdepsExternalAuthorityGate))
}

func dag_compile_clean_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: DagCompileCleanGate))
}

func generated_artifact_drift_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: GeneratedArtifactDriftGate))
}

func regen_verify_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: RegenVerifyGate))
}
