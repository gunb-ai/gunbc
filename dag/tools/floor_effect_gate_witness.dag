module tools.floor_effect_gate_witness

import gunbc.ci_gate { EmitHostGate, CheapClaimPoolGate }
import gunbc.ci_spec {
  ExtdepsExternalAuthorityGate, DagCompileCleanGate, GeneratedArtifactDriftGate, ExtdepsScopePlacementGate,
  RegenVerifyGate
}
import tools.ci_gates { exit_ok, run_spec_gate }
import tools.extdeps_scope_placement_gate { scope_placement_failure_receipt }

data floor_gate_failure_receipt_note: String = "claim_executor derives a failure-receipt companion from a Bool witness's own name and evaluates it in THIS entry's context, so the companion must be declared here beside the witness it explains — not only in the gate module that builds the reason. Naming is mechanical: <witness>_passes yields <witness>_failure_receipt. Only the placement gate carries one today; the other gates keep the bare Bool until each has a located reason worth projecting, which is a coverage gap in those gates rather than a property of this channel."

func emit_host_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: EmitHostGate))
}

func cheap_claim_pool_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: CheapClaimPoolGate))
}

func extdeps_external_authority_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: ExtdepsExternalAuthorityGate))
}

func dag_compile_clean_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: DagCompileCleanGate))
}

func generated_artifact_drift_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: GeneratedArtifactDriftGate))
}

func extdeps_scope_placement_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: ExtdepsScopePlacementGate))
}

func extdeps_scope_placement_gate_failure_receipt() -> String {
  tools.extdeps_scope_placement_gate.scope_placement_failure_receipt()
}

func regen_verify_gate_passes() -> Bool {
  tools.ci_gates.exit_ok(e: run_spec_gate(g: RegenVerifyGate))
}
