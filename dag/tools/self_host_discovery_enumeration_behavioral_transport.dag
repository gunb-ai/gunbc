module tools.self_host_discovery_enumeration_behavioral_transport

import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.cargo_build
import extdeps.git
import extdeps.gunbc
import std.logic { Bool }
import tools.host_prelude { witness_bin, witness_bin_ready, witness_bin_release_path }

data sde_doc: String = "Wave 2 Band A (discovery_enumeration self-emit): shim-free seed-linked behavioral receipt. Emit ONLY v2.compiler.discovery_enumeration via gunbc compile --entry; the emitted lib.rs carries its std import closure (no hand dep shims). Seed oracle: v1_compiler::v2_compiler_discovery_enumeration (hand-retained in src/v1/stage0). Behavioral bar: cargo-green witness pairs emitted vs seed on data constants + OwnedDataDeclInitializer / OwnedDataDiscoveryReceipt shapes (plain + --inject-fault RED). String authority: std.string_type (not v2.std.text) keeps the emit closure free of v2.std.nat diagnostic debt."

data sde_seed_retained_note: String = "Seed oracle: v1_compiler::v2_compiler_discovery_enumeration in src/v1/stage0 (hand-retained, independent of emitted artifact). Dissolve-on: same as sde_scaffold_dissolution_trigger."

data sde_source_rel: String = "src/v2/compiler/discovery_enumeration.dag"

data sde_test_entry_rel: String = "src/v2/test/claim/discovery_enumeration_test.dag"

data sde_shim_driver_rel: String = "dag/tools/self_host_discovery_enumeration_shims/witness_main.rs"

data sde_scaffold_dissolution_trigger: String = "dissolve-on: dag/tools/self_host_discovery_enumeration_shims/witness_main.rs + sde_cargo_toml — hand-written equivalence driver + driver-crate manifest (mirrors slb/ssuv scaffold debt; shim-free for std deps only). DISSOLVES WHEN a modeled self-host behavioral-equivalence harness producer emits the comparison driver + manifest without hand shims."

data sde_receipt_pass_marker: String = "SELF_HOST_DISCOVERY_ENUMERATION_BEHAVIORAL_RECEIPT: PASS"

data sde_cargo_features_note: String = "Mirrors slb_cargo_features_note: text_lookup_work_counter feature declared for -D warnings consumers."

fn sde_repo_path(root: String, rel: String) -> String {
  concat(root, concat("/", rel))
}

fn sde_cargo_toml(root: String) -> String {
  concat(
    "[package]\nname = \"v1_compiled\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[features]\ntext_lookup_work_counter = []\n\n[[bin]]\nname = \"witness\"\npath = \"src/main.rs\"\n\n[dependencies]\nim = { version = \"15.1\", features = [\"serde\"] }\nserde = { version = \"1\", features = [\"derive\", \"rc\"] }\nserde_json = \"1\"\nstacker = \"0.1\"\nlazy_static = \"1\"\nunicode-ident = \"1\"\nunicode-properties = { version = \"0.1\", features = [\"emoji\"] }\nv1-compiler = { path = \"",
    concat(root, "/src/v1/stage0\" }\n")
  )
}

fn sde_behavioral_receipt_holds() -> Bool {
  let root = git.Core.Toplevel()
  let module_read = Filesystem.Read(path: sde_repo_path(root: root.path, rel: sde_source_rel))
  let driver_read = Filesystem.Read(path: sde_repo_path(root: root.path, rel: sde_shim_driver_rel))

  let out_dir = shell.Mktemp.Dir()
  let gunbc_built = witness_bin_ready(root: root.path, bin: witness_bin(var_name: "GUNBC", bin_name: "gunbc"))
  let gunbc_bin = witness_bin_release_path(root: root.path, bin_name: "gunbc")
  let emit = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "compile",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", sde_source_rel,
      "--output-dir", out_dir.path,
      "--target", "rust",
      "--dependency-pool-index", "primary-precedence"
    ]
  )

  let manifest = Filesystem.Write(path: concat(out_dir.path, "/Cargo.toml"), content: sde_cargo_toml(root: root.path))
  let main_rs = Filesystem.Write(path: concat(out_dir.path, "/src/main.rs"), content: driver_read.content)

  let build = cargo.Build.BuildManifest(
    workdir: out_dir.path,
    manifest_path: concat(out_dir.path, "/Cargo.toml"),
    target_dir: concat(out_dir.path, "/target"),
    extra_args: ["--release"]
  )

  let witness_bin_path = concat(out_dir.path, "/target/release/witness")
  let pass_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path)
  let fault_run = gunbc.WitnessBin.Run(workdir: out_dir.path, bin_path: witness_bin_path, args: ["--inject-fault"])

  let eval_constants = gunbc.WitnessBin.Run(
    workdir: root.path,
    bin_path: gunbc_bin,
    args: [
      "run", "--claim-run",
      "--source-root", "dag",
      "--source-root", "src/v2",
      "--entry", sde_test_entry_rel,
      "--function", "discovery_enumeration_unified_claim_arm_modules_holds"
    ]
  )

  let cleanup_out = shell.Remove.RecursiveForce(path: out_dir.path)

  module_read.success && driver_read.success
    && out_dir.success && gunbc_built && emit.success
    && manifest.success && main_rs.success
    && build.success
    && pass_run.success && string_contains(s: pass_run.stdout, pattern: sde_receipt_pass_marker)
    && (fault_run.success == false)
    && eval_constants.success
    && cleanup_out.success
}
