module scratch_pb2
import std.process { ProcessExit, ExitSuccess, exit_failure }
import test.claim.fleet.site_pxe_edge_live_evidence_witness { a_served_file_is_measured_at_the_path_asked_and_the_digest_printed, a_served_answer_that_is_not_the_asked_files_is_unread, an_extraction_is_a_receipt_only_when_all_three_readings_were_read, a_tftp_path_outside_the_root_is_refused_before_dispatch, a_served_file_resolving_outside_the_root_is_not_contained, realpath_output_must_be_one_absolute_line_for_root_and_file }
fn main() -> ProcessExit {
  if !a_served_file_is_measured_at_the_path_asked_and_the_digest_printed() { exit_failure(reason: "a_served_file_is_measured_at_the_path_asked_and_the_digest_printed") } else if !a_served_answer_that_is_not_the_asked_files_is_unread() { exit_failure(reason: "a_served_answer_that_is_not_the_asked_files_is_unread") } else if !an_extraction_is_a_receipt_only_when_all_three_readings_were_read() { exit_failure(reason: "an_extraction_is_a_receipt_only_when_all_three_readings_were_read") } else if !a_tftp_path_outside_the_root_is_refused_before_dispatch() { exit_failure(reason: "a_tftp_path_outside_the_root_is_refused_before_dispatch") } else if !a_served_file_resolving_outside_the_root_is_not_contained() { exit_failure(reason: "a_served_file_resolving_outside_the_root_is_not_contained") } else if !realpath_output_must_be_one_absolute_line_for_root_and_file() { exit_failure(reason: "realpath_output_must_be_one_absolute_line_for_root_and_file") } else { ExitSuccess }
}
