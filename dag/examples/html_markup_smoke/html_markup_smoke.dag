module examples.html_markup_smoke

import std.markup { Fragment, Element, FragmentText, attr, escape_text }
import extdeps.languages.html { try_serialize_html_source, EmitOk, EmitRejected }
import std.process { exit_code_general_error }

data tiny: Fragment = Element {
  tag: "p",
  attributes: [],
  children: [ FragmentText { content: "ok" } ],
}

data with_attr: Fragment = Element {
  tag: "a",
  attributes: [ attr(name: "href", value: "/tree/dag" ) ],
  children: [ FragmentText { content: "dag" } ],
}

data href_amp: Fragment = Element {
  tag: "a",
  attributes: [ attr(name: "href", value: "/x?a=1&b=2" ) ],
  children: [ FragmentText { content: "link" } ],
}

data href_hostile: Fragment = Element {
  tag: "a",
  attributes: [ attr(name: "href", value: "x\"&<y onmouseover=z" ) ],
  children: [],
}

data href_javascript: Fragment = Element {
  tag: "a",
  attributes: [ attr(name: "href", value: "javascript:alert(1)" ) ],
  children: [ FragmentText { content: "click" } ],
}

fn serialize_ok(node: Fragment, expected: String) -> Bool {
  match try_serialize_html_source(node: node) {
    EmitOk { html: h } => h == expected
    EmitRejected { reason: _ } => false
  }
}

fn serialize_rejects(node: Fragment) -> Bool {
  match try_serialize_html_source(node: node) {
    EmitRejected { reason: _ } => true
    EmitOk { html: _ } => false
  }
}

func main() -> ProcessExit {
  if serialize_ok(node: tiny, expected: "<p>ok</p>")
    && serialize_ok(node: with_attr, expected: "<a href=\"/tree/dag\">dag</a>")
    && serialize_ok(node: href_amp, expected: "<a href=\"/x?a=1&amp;b=2\">link</a>")
    && serialize_ok(
      node: href_hostile,
      expected: "<a href=\"x%22&amp;%3Cy%20onmouseover=z\"></a>"
    )
    && serialize_rejects(node: href_javascript)
    && escape_text(s: "<b>") == "&lt;b&gt;" {
    ExitSuccess
  } else {
    ExitFailure { code: exit_code_general_error, reason: "html_markup_smoke mismatch" }
  }
}
