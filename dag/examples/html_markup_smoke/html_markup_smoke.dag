module examples.html_markup_smoke


data tiny: MarkupNode = ElementNode {
  tag: "p",
  attrs: [],
  children: [ TextNode { text: "ok" } ],
}

data with_attr: MarkupNode = ElementNode {
  tag: "a",
  attrs: [ MarkupAttr { name: "href", value: "/tree/dag" } ],
  children: [ TextNode { text: "dag" } ],
}

data href_amp: MarkupNode = ElementNode {
  tag: "a",
  attrs: [ MarkupAttr { name: "href", value: "/x?a=1&b=2" } ],
  children: [ TextNode { text: "link" } ],
}

data href_hostile: MarkupNode = ElementNode {
  tag: "a",
  attrs: [ MarkupAttr { name: "href", value: "x\"&<y onmouseover=z" } ],
  children: [],
}

data href_javascript: MarkupNode = ElementNode {
  tag: "a",
  attrs: [ MarkupAttr { name: "href", value: "javascript:alert(1)" } ],
  children: [ TextNode { text: "click" } ],
}

fn serialize_ok(node: MarkupNode, expected: String) -> Bool {
  match try_serialize_html_source(node: node) {
    EmitOk { html: h } => h == expected
    EmitRejected { reason: _ } => false
  }
}

fn serialize_rejects(node: MarkupNode) -> Bool {
  match try_serialize_html_source(node: node) {
    EmitRejected { reason: _ } => true
    EmitOk { html: _ } => false
  }
}

func main() -> ProcessExit {
  if serialize_ok(node: tiny, expected: "<p>ok</p>")
    && serialize_ok(node: with_attr, expected: "<a href=\"/tree/dag\">dag</a>")
    && serialize_ok(node: href_amp, expected: "<a href=\"/x?a=1&amp;b=2\">link</a>")
    && serialize_ok(
      node: href_hostile,
      expected: "<a href=\"x%22&amp;%3Cy%20onmouseover=z\"></a>"
    )
    && serialize_rejects(node: href_javascript)
    && escape_text(s: "<b>") == "&lt;b&gt;" {
    ExitSuccess
  } else {
    ExitFailure { code: exit_code_general_error, reason: "html_markup_smoke mismatch" }
  }
}
