module examples.cost_estimate


type CostProjection {
  expected_hours: Float
  utilization: Float
  currency: CurrencyCode
}

fn billable_hours(p: CostProjection) -> Float {
  p.expected_hours * p.utilization
}

fn demo_projection() -> CostProjection {
  CostProjection {
    expected_hours: 3.0,
    utilization: 0.75,
    currency: Eur,
  }
}

fn cost_projection_float_witness() -> Bool {
  let p = demo_projection()
  let hours = billable_hours(p: p)
  let float_evaluates = (hours > 2.24) && (hours < 2.26)
  let currency_evaluates = (currency_minor_unit_exponent(c: Eur) == 2) && (currency_minor_unit_exponent(c: Usd) == 2)
  float_evaluates && currency_evaluates
}
