module examples.js_site


type JsSitePageId = Home | Browse | About

type JsSitePage {
  id: JsSitePageId
  path: String
  tsx_fn_name: String
  node: std.markup.Fragment
}

fn js_site_nav_link(href: String, label: String) -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "a",
    attributes: [ attr(name: "href", value: href ) ],
    children: [ FragmentText { content: label } ],
  }
}

fn js_site_header() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "header",
    attributes: [],
    children: [
      extdeps.browser.Element {
        tag: "h1",
        attributes: [],
        children: [ FragmentText { content: "gunbc" } ],
      },
      extdeps.browser.Element {
        tag: "nav",
        attributes: [],
        children: [
          js_site_nav_link(href: "/", label: "Home"),
          js_site_nav_link(href: "/about", label: "About"),
          js_site_nav_link(href: "/browse", label: "Browse"),
        ],
      },
    ],
  }
}

fn js_site_page_shell(title: String, main: std.markup.Fragment) -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "html",
    attributes: [],
    children: [
      extdeps.browser.Element {
        tag: "head",
        attributes: [],
        children: [
          extdeps.browser.Element {
            tag: "title",
            attributes: [],
            children: [ FragmentText { content: title } ],
          },
        ],
      },
      extdeps.browser.Element {
        tag: "body",
        attributes: [],
        children: [
          js_site_header(),
          extdeps.browser.Element {
            tag: "main",
            attributes: [],
            children: [ main ],
          },
        ],
      },
    ],
  }
}

fn js_site_home_main() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "p",
    attributes: [],
    children: [
      FragmentText { content: "DAG-modeled compiler. One Fragment source, two realizations.",
      },
    ],
  }
}

fn js_site_about_main() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "p",
    attributes: [],
    children: [
      FragmentText { content: "gunbc models programs as dependency graphs. Rust is bootstrap seed.",
      },
    ],
  }
}

fn js_site_doc_link(name: String, path: String) -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "li",
    attributes: [],
    children: [
      extdeps.browser.Element {
        tag: "a",
        attributes: [ attr(name: "href", value: path ) ],
        children: [ FragmentText { content: name } ],
      },
    ],
  }
}

fn js_site_browse_main() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "ul",
    attributes: [],
    children: [
      js_site_doc_link(name: "dag", path: "/dag"),
      js_site_doc_link(name: "src", path: "/src"),
      js_site_doc_link(name: "DESIGN.md", path: "/DESIGN.md"),
      js_site_doc_link(name: "ROADMAP.md", path: "/ROADMAP.md"),
    ],
  }
}

fn js_site_home_page() -> std.markup.Fragment {
  js_site_page_shell(title: "gunbc — Home", main: js_site_home_main())
}

fn js_site_about_page() -> std.markup.Fragment {
  js_site_page_shell(title: "gunbc — About", main: js_site_about_main())
}

fn js_site_browse_page() -> std.markup.Fragment {
  js_site_page_shell(title: "gunbc — Browse", main: js_site_browse_main())
}

fn js_site_pages() -> List<JsSitePage> {
  [
    JsSitePage {
      id: Home,
      path: "/",
      tsx_fn_name: "JsSiteHomePage",
      node: js_site_home_page(),
    },
    JsSitePage {
      id: Browse,
      path: "/browse",
      tsx_fn_name: "JsSiteBrowsePage",
      node: js_site_browse_page(),
    },
    JsSitePage {
      id: About,
      path: "/about",
      tsx_fn_name: "JsSiteAboutPage",
      node: js_site_about_page(),
    },
  ]
}

fn js_site_page_count() -> Int {
  count(xs: js_site_pages())
}

fn js_site_interactivity_exhaustion_exemplar() -> std.markup.Fragment {
  extdeps.browser.Element {
    tag: "button",
    attributes: [ attr(name: "onClick", value: "handleClick" ) ],
    children: [ FragmentText { content: "Go" } ],
  }
}

data js_site_markup_to_jsx_interactivity_medium: Medium<std.markup.Fragment> = extdeps.communication.medium.Medium {
  carried: js_site_interactivity_exhaustion_exemplar(),
  fidelity: Lossy
}

data js_site_expression_prop_markup_debt: std.disposition.Disposition = Scaffold {
  dissolves_to: SubstrateMandatoryTag,
  bind: std.decl_ref.DeclarationRef {
    module_path: "std.markup",
    decl_name: "Attribute",
    field: WholeDeclaration
  }
}
