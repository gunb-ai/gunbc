// Dialogue patching for Animal Crossing on the GameCube. A patch set is a directory holding BASE
// (the SHA-1 of the disc image it was written against) and .acmsg files of message replacements.
// Everything that interprets bytes is modeled here and in the extdeps format modules; the only work
// done outside .dag is literal byte I/O -- xxd reads ranges and writes octets, dd copies ranges, cp
// copies the image. The interpreter never holds the image or the 2.8 MB of message text: only
// headers, the message table and the messages being edited.

// ---- reading the base ----

type AcBase {
  path: String
  sha1: String
  codes: List<ControlCode>
  image_size: Int
  disc: GcmHeader
  disc_files: List<GcmFile>
  archive: GcmFile
  archive_head: List<Int>
  archive_header: RarcHeader
  archive_files: List<RarcFile>
  data_file: RarcFile
  table_file: RarcFile
  ends: List<Int>
}

type Loaded<T>
  = LoadedOk { value: T }
  | LoadRefused { reason: String }

fn read_range(path: String, offset: Int, length: Int) -> List<Int>? {
  if length == 0 { Present { value: [] } }
  else {
    let r = xxd.Xxd.PlainRange(path: path, offset: offset, length: length)
    if r.success { hex_octets(hex: r.hex) } else { none }
  }
}

// The control-code table is a fact of the build, so a base is admitted only when its table is
// pinned. Adding a build is one arm here and one pinned table in extdeps.
fn codes_for_base(sha1: String) -> List<ControlCode>? {
  if sha1 == deluxe_build_image_sha1 { Present { value: deluxe_control_codes() } } else { none }
}

fn archive_messages(path: String, sha1: String, codes: List<ControlCode>, disc: GcmHeader, files: List<GcmFile>, size: Int, archive: GcmFile, h: RarcHeader, head: List<Int>) -> Loaded<AcBase> {
  let members = rarc_files(head: head, header: h)
  match rarc_find(files: members, path: message_data_path) {
    Absent => LoadRefused { reason: "no message data in forest_2nd.arc" }
    Present { value: data_member } =>
      match rarc_find(files: members, path: message_table_path) {
        Absent => LoadRefused { reason: "no message table in forest_2nd.arc" }
        Present { value: table } =>
          match read_range(path: path, offset: archive.offset + h.data_start + table.data_offset, length: table.size) {
            Absent => LoadRefused { reason: "could not read the message table" }
            Present { value: table_octets } =>
              match message_table_ends(table: table_octets) {
                MessageRefused { reason: r } => LoadRefused { reason: r }
                MessageAccepted { value: ends } =>
                  if (get(ends, count(ends) - 1) ?? -1) != data_member.size { LoadRefused { reason: "message table does not end at the end of the message data" } }
                  else {
                    LoadedOk {
                      value: AcBase {
                        path: path, sha1: sha1, codes: codes, image_size: size, disc: disc, disc_files: files,
                        archive: archive, archive_head: head, archive_header: h, archive_files: members,
                        data_file: data_member, table_file: table, ends: ends,
                      },
                    }
                  }
              }
          }
      }
  }
}

fn load_archive(path: String, sha1: String, codes: List<ControlCode>, disc: GcmHeader, files: List<GcmFile>, size: Int) -> Loaded<AcBase> {
  match gcm_find(files: files, path: message_archive_path) {
    Absent => LoadRefused { reason: "no forest_2nd.arc on the disc" }
    Present { value: archive } =>
      match read_range(path: path, offset: archive.offset, length: rarc_prefix_length) {
        Absent => LoadRefused { reason: "could not read the archive header" }
        Present { value: prefix } =>
          match rarc_header(head: prefix) {
            RarcRejected { reason: r } => LoadRefused { reason: r }
            RarcDecoded { value: h } =>
              match read_range(path: path, offset: archive.offset, length: h.data_start) {
                Absent => LoadRefused { reason: "could not read the archive's header region" }
                Present { value: head } => archive_messages(path: path, sha1: sha1, codes: codes, disc: disc, files: files, size: size, archive: archive, h: h, head: head)
              }
          }
      }
  }
}

fn load_image(path: String, sha1: String, codes: List<ControlCode>) -> Loaded<AcBase> {
  match file_byte_count_via_wc(path: path as FilePath) {
    FileByteCountUnavailable { reason: r } => LoadRefused { reason: join(["could not size ", path, ": ", r as String], "") }
    FileByteCountObserved { count: size } =>
      match read_range(path: path, offset: 0, length: gcm_header_read_length) {
        Absent => LoadRefused { reason: "could not read the disc header" }
        Present { value: header_octets } =>
          match gcm_header(header: header_octets) {
            GcmRejected { reason: r } => LoadRefused { reason: r }
            GcmDecoded { value: disc } =>
              match read_range(path: path, offset: disc.fst_offset, length: disc.fst_size) {
                Absent => LoadRefused { reason: "could not read the file system table" }
                Present { value: fst } =>
                  match gcm_files(fst: fst) {
                    GcmRejected { reason: r } => LoadRefused { reason: r }
                    GcmDecoded { value: files } => load_archive(path: path, sha1: sha1, codes: codes, disc: disc, files: files, size: size)
                  }
              }
          }
      }
  }
}

fn load_base(path: String) -> Loaded<AcBase> {
  match sha1_file(path: path) {
    Absent => LoadRefused { reason: join(["could not digest ", path], "") }
    Present { value: digest } =>
      match codes_for_base(sha1: digest.hex) {
        Absent => LoadRefused { reason: join(["no control-code table is pinned for base image ", digest.hex], "") }
        Present { value: codes } => load_image(path: path, sha1: digest.hex, codes: codes)
      }
  }
}

fn message_data_offset(base: AcBase) -> Int {
  base.archive.offset + base.archive_header.data_start + base.data_file.data_offset
}

fn read_message(base: AcBase, id: Int) -> List<Int>? {
  let s = message_start(ends: base.ends, id: id)
  read_range(path: base.path, offset: message_data_offset(base: base) + s, length: message_end(ends: base.ends, id: id) - s)
}

fn read_message_text(base: AcBase, id: Int) -> String? {
  match read_message(base: base, id: id) {
    Absent => none
    Present { value: m } =>
      match message_tokens(codes: base.codes, message: m) {
        MessageAccepted { value: t } => Present { value: message_text(tokens: t) }
        MessageRefused { reason: _ } => none
      }
  }
}

// ---- the patch set ----

type PatchSet {
  base_sha1: String
  edits: List<AcmsgEdit>
}

fn read_text(path: String) -> Loaded<String> {
  let r = Filesystem.Read(path: path)
  match filesystem_read_outcome(content: r.content, success: r.success, error: r.error) {
    FilesystemReadSucceeded { content: c } => LoadedOk { value: c }
    FilesystemReadRefused { error: e } => LoadRefused { reason: join(["could not read ", path, ": ", e], "") }
  }
}

type EditsFold {
  edits: List<AcmsgEdit>
  refusal: String
}

fn add_edit(acc: EditsFold, edit: AcmsgEdit) -> EditsFold {
  if acc.refusal != "" { acc }
  else {
    match acc.edits |> filter(e => e.block.id == edit.block.id) |> first {
      null => EditsFold { edits: list_push(acc.edits, edit), refusal: "" }
      other => EditsFold { edits: acc.edits, refusal: join(["message ", to_string(edit.block.id), " is patched twice: ", other.source, " and ", edit.source], "") }
    }
  }
}

fn add_file_edits(root: String, acc: EditsFold, path: String) -> EditsFold {
  if acc.refusal != "" { acc }
  else {
    let source = if path.starts_with(prefix: concat(root, "/")) { substring(s: path, start: root.length() + 1, end: path.length()) } else { path }
    match read_text(path: path) {
      LoadRefused { reason: r } => EditsFold { edits: acc.edits, refusal: r }
      LoadedOk { value: content } =>
        match parse_acmsg(source: source, content: content) {
          AcmsgRefused { reason: r } => EditsFold { edits: acc.edits, refusal: r }
          AcmsgAccepted { value: edits } => fold(edits, init: acc, f: (a, e) => add_edit(acc: a, edit: e))
        }
    }
  }
}

fn load_patch_set(root: String) -> Loaded<PatchSet> {
  match read_text(path: concat(root, "/BASE")) {
    LoadRefused { reason: _ } => LoadRefused { reason: join([root, " has no BASE file pinning the base image sha1"], "") }
    LoadedOk { value: base_text } => {
      let listing = shell.Find.FilesByNameSorted(root: root as FilePath, name_glob: "*.acmsg" as NonEmptyStr)
      if listing.success == false { LoadRefused { reason: join(["could not list ", root, ": ", listing.stderr], "") } }
      else {
        let paths = split(s: listing.stdout, delimiter: "\n") |> filter(p => trim(s: p) != "")
        let r = fold(paths, init: EditsFold { edits: [], refusal: "" }, f: (acc, p) => add_file_edits(root: root, acc: acc, path: p))
        if r.refusal != "" { LoadRefused { reason: r.refusal } }
        else { LoadedOk { value: PatchSet { base_sha1: get(split(s: trim(s: base_text), delimiter: " "), 0) ?? "", edits: r.edits } } }
      }
    }
  }
}

// ---- validating edits ----

type ValidEdit {
  edit: AcmsgEdit
  old_size: Int
  octets: List<Int>
}

type ValidateFold {
  valid: List<ValidEdit>
  refusals: List<String>
  warnings: List<String>
}

// Edits that passed, and what the checks could not settle about them.
type CheckedEdits {
  edits: List<ValidEdit>
  warnings: List<String>
}

fn edit_where(edit: AcmsgEdit) -> String {
  join([edit.source, " (message ", to_string(edit.block.id), ")"], "")
}

fn refuse_edit(acc: ValidateFold, edit: AcmsgEdit, reason: String) -> ValidateFold {
  ValidateFold { valid: acc.valid, refusals: list_push(acc.refusals, join([edit_where(edit: edit), ": ", reason], "")), warnings: acc.warnings }
}

fn line_where(line: TextLine) -> String {
  join(["page ", to_string(line.page + 1), " line ", to_string(line.line + 1)], "")
}

// A line that certainly overflows is refused; one that only might (an inserted name that could be
// long, a line that rescales itself) is a warning.
fn line_width_finding(line: TextLine, units: Int) -> LineFinding {
  match line.extent {
    LineWidthRange { min: lo, max: hi } =>
      if lo > units { LineOverflows { reason: join([line_where(line: line), " is ", to_string(lo), " units wide; the window shows ", to_string(units)], "") } }
      else if hi > units { LineMayOverflow { reason: join([line_where(line: line), " reaches ", to_string(hi), " of ", to_string(units), " units if its inserted strings are long"], "") } }
      else { LineFits }
    LineUnbounded { reason: r } => LineMayOverflow { reason: join([line_where(line: line), " cannot be measured: ", r], "") }
  }
}

type LineFinding
  = LineFits
  | LineOverflows { reason: String }
  | LineMayOverflow { reason: String }

fn layout_findings(lines: List<TextLine>) -> List<LineFinding> {
  let pages = lines |> filter(l => l.line >= page_line_limit) |> map(l => LineOverflows { reason: join(["page ", to_string(l.page + 1), " draws more than ", to_string(page_line_limit), " lines"], "") })
  let widths = match message_window_line_width {
    LineWidthMeasured { units: u } => lines |> map(l => line_width_finding(line: l, units: u))
    LineWidthUncalibrated => []
  }
  concat(pages, widths)
}

fn accept_edit(acc: ValidateFold, edit: AcmsgEdit, old_octets: List<Int>, new_octets: List<Int>, lines: List<TextLine>) -> ValidateFold {
  let findings = layout_findings(lines: lines)
  let refusals = findings |> filter(f => match f { LineOverflows { reason: _ } => true  LineMayOverflow { reason: _ } => false  LineFits => false })
  let maybes = findings |> filter(f => match f { LineMayOverflow { reason: _ } => true  LineOverflows { reason: _ } => false  LineFits => false })
  if count(refusals) > 0 {
    fold(refusals, init: acc, f: (a, r) => match r { LineOverflows { reason: why } => refuse_edit(acc: a, edit: edit, reason: why)  LineMayOverflow { reason: _ } => a  LineFits => a })
  } else {
    ValidateFold {
      valid: list_push(acc.valid, ValidEdit { edit: edit, old_size: count(old_octets), octets: new_octets }),
      refusals: acc.refusals,
      warnings: concat(acc.warnings, maybes |> map(m => match m { LineMayOverflow { reason: why } => join([edit_where(edit: edit), ": ", why], "")  LineOverflows { reason: why } => why  LineFits => "" })),
    }
  }
}

fn steering_text(codes: List<ControlCode>, steering: List<List<Int>>) -> String {
  let flat = fold(steering, init: [], f: (acc, t) => concat(acc, t))
  match message_tokens(codes: codes, message: flat) {
    MessageAccepted { value: t } => if count(t) == 0 { "(none)" } else { message_text(tokens: t) }
    MessageRefused { reason: r } => r
  }
}

fn validate_tokens(base: AcBase, acc: ValidateFold, edit: AcmsgEdit, old_octets: List<Int>, new_octets: List<Int>) -> ValidateFold {
  match message_tokens(codes: base.codes, message: old_octets) {
    MessageRefused { reason: r } => refuse_edit(acc: acc, edit: edit, reason: join(["the original does not tokenize: ", r], ""))
    MessageAccepted { value: old_tokens } =>
      match message_tokens(codes: base.codes, message: new_octets) {
        MessageRefused { reason: r } => refuse_edit(acc: acc, edit: edit, reason: r)
        MessageAccepted { value: new_tokens } => {
          let want = steering_tokens(tokens: old_tokens)
          let got = steering_tokens(tokens: new_tokens)
          if want != got {
            refuse_edit(acc: acc, edit: edit, reason: join(["conversation-steering codes changed; they must stay exactly ", steering_text(codes: base.codes, steering: want), " in order, got ", steering_text(codes: base.codes, steering: got)], ""))
          } else if count(new_octets) > message_octet_limit {
            refuse_edit(acc: acc, edit: edit, reason: join([to_string(count(new_octets)), " octets exceeds the ", to_string(message_octet_limit), "-octet message buffer"], ""))
          } else {
            accept_edit(acc: acc, edit: edit, old_octets: old_octets, new_octets: new_octets, lines: message_lines(tokens: new_tokens))
          }
        }
      }
  }
}

fn validate_edit(base: AcBase, acc: ValidateFold, edit: AcmsgEdit) -> ValidateFold {
  if edit.block.id < 0 || edit.block.id >= count(base.ends) { refuse_edit(acc: acc, edit: edit, reason: join(["no such message; the table has ", to_string(count(base.ends))], "")) }
  else {
    match text_message(codes: base.codes, text: edit.block.text) {
      MessageRefused { reason: r } => refuse_edit(acc: acc, edit: edit, reason: r)
      MessageAccepted { value: new_octets } =>
        match read_message(base: base, id: edit.block.id) {
          Absent => refuse_edit(acc: acc, edit: edit, reason: "could not read the original message")
          Present { value: old_octets } => validate_tokens(base: base, acc: acc, edit: edit, old_octets: old_octets, new_octets: new_octets)
        }
    }
  }
}

data uncalibrated_width_warning: String = "line widths are not checked: the message window's width has not been measured in game (extdeps.games.animal_crossing.font message_window_line_width)"

fn validate(base: AcBase, patches: PatchSet) -> Loaded<CheckedEdits> {
  if patches.base_sha1 != base.sha1 { LoadRefused { reason: join(["patch set is pinned to base ", patches.base_sha1, ", but the image is ", base.sha1], "") } }
  else {
    let r = fold(patches.edits, init: ValidateFold { valid: [], refusals: [], warnings: [] }, f: (acc, e) => validate_edit(base: base, acc: acc, edit: e))
    let calibration = match message_window_line_width {
      LineWidthMeasured { units: _ } => []
      LineWidthUncalibrated => [uncalibrated_width_warning]
    }
    if count(r.refusals) > 0 { LoadRefused { reason: r.refusals |> join(separator: "\n") } }
    else { LoadedOk { value: CheckedEdits { edits: sort_by(r.valid, fn(v) { v.edit.block.id }), warnings: concat(calibration, r.warnings) } } }
  }
}

// ---- the plan ----

// Everything the output image needs beyond a copy of the base: byte ranges copied from the base,
// and literal octets written. Copies read only the base, so their order does not matter; literal
// writes never overlap them.
type BuildPlan {
  copies: List<DdRangeCopy>
  writes: List<OctetPatch>
  archive_offset: Int
  archive_size: Int
}

type EndsFold {
  ends: List<Int>
  delta: Int
  next: Int
  id: Int
}

fn ends_step(edits: List<ValidEdit>, acc: EndsFold, end: Int) -> EndsFold {
  match get(edits, acc.next) {
    null => EndsFold { ends: list_push(acc.ends, end + acc.delta), delta: acc.delta, next: acc.next, id: acc.id + 1 }
    other =>
      if other.edit.block.id == acc.id {
        let delta = acc.delta + count(other.octets) - other.old_size
        EndsFold { ends: list_push(acc.ends, end + delta), delta: delta, next: acc.next + 1, id: acc.id + 1 }
      } else {
        EndsFold { ends: list_push(acc.ends, end + acc.delta), delta: acc.delta, next: acc.next, id: acc.id + 1 }
      }
  }
}

// Edits are sorted by id, so one pass shifts every later end by the growth so far.
fn new_ends(base: AcBase, edits: List<ValidEdit>) -> List<Int> {
  fold(base.ends, init: EndsFold { ends: [], delta: 0, next: 0, id: 0 }, f: (acc, e) => ends_step(edits: edits, acc: acc, end: e)).ends
}

type SpliceFold {
  copies: List<DdRangeCopy>
  writes: List<OctetPatch>
  source: Int
  target: Int
}

fn splice_step(base: AcBase, acc: SpliceFold, edit: ValidEdit) -> SpliceFold {
  let start = message_start(ends: base.ends, id: edit.edit.block.id)
  let gap = start - acc.source
  let copies = if gap > 0 { list_push(acc.copies, DdRangeCopy { source_offset: message_data_offset(base: base) + acc.source, target_offset: acc.target, length: gap }) } else { acc.copies }
  SpliceFold {
    copies: copies,
    writes: list_push(acc.writes, OctetPatch { offset: acc.target + gap, octets: edit.octets }),
    source: message_end(ends: base.ends, id: edit.edit.block.id),
    target: acc.target + gap + count(edit.octets),
  }
}

// The new message data at `target`: the base's own bytes between edits, copied, and each edited
// message written.
fn splice_message_data(base: AcBase, edits: List<ValidEdit>, target: Int) -> SpliceFold {
  let r = fold(edits, init: SpliceFold { copies: [], writes: [], source: 0, target: target }, f: (acc, e) => splice_step(base: base, acc: acc, edit: e))
  let rest = base.data_file.size - r.source
  if rest > 0 {
    SpliceFold { copies: list_push(r.copies, DdRangeCopy { source_offset: message_data_offset(base: base) + r.source, target_offset: r.target, length: rest }), writes: r.writes, source: base.data_file.size, target: r.target + rest }
  } else { r }
}

fn zeros_from(n: Int, acc: List<Int>) -> List<Int> {
  if count(acc) >= n { acc } else { zeros_from(n: n, acc: list_push(acc, 0)) }
}

fn zeros(n: Int) -> List<Int> {
  zeros_from(n: n, acc: [])
}

fn overwrite(bytes: List<Int>, patch: OctetPatch) -> List<Int> {
  concat(concat(bytes.take(n: patch.offset), patch.octets), bytes.skip(n: patch.offset + count(patch.octets)))
}

fn header_region(base: AcBase, repack: RarcRepack) -> List<Int> {
  fold(repack.header_patches, init: base.archive_head, f: (acc, p) => overwrite(bytes: acc, patch: p))
}

type MemberFold {
  copies: List<DdRangeCopy>
  writes: List<OctetPatch>
  cursor: Int
}

fn member_step(base: AcBase, edits: List<ValidEdit>, table: List<Int>, data_at: Int, in_place: Bool, acc: MemberFold, p: RarcPlacement) -> MemberFold {
  let target = data_at + p.new_offset
  let gap = p.new_offset - acc.cursor
  let writes = if gap > 0 { list_push(acc.writes, OctetPatch { offset: data_at + acc.cursor, octets: zeros(n: gap) }) } else { acc.writes }
  let end = p.new_offset + p.new_size
  if p.file.path == message_table_path {
    MemberFold { copies: acc.copies, writes: list_push(writes, OctetPatch { offset: target, octets: table }), cursor: end }
  } else if p.file.path == message_data_path {
    let s = splice_message_data(base: base, edits: edits, target: target)
    MemberFold { copies: concat(acc.copies, s.copies), writes: concat(writes, s.writes), cursor: end }
  } else if in_place && p.new_offset == p.file.data_offset {
    MemberFold { copies: acc.copies, writes: writes, cursor: end }
  } else {
    let source = base.archive.offset + base.archive_header.data_start + p.file.data_offset
    MemberFold { copies: list_push(acc.copies, DdRangeCopy { source_offset: source, target_offset: target, length: p.file.size }), writes: writes, cursor: end }
  }
}

fn build_plan(base: AcBase, edits: List<ValidEdit>) -> Loaded<BuildPlan> {
  let ends = new_ends(base: base, edits: edits)
  let table = message_table_octets(ends: ends)
  let data_size = get(ends, count(ends) - 1) ?? 0
  let repack = rarc_repack(header: base.archive_header, files: base.archive_files, resizes: [
    RarcResize { path: message_data_path, size: data_size },
    RarcResize { path: message_table_path, size: count(table) },
  ])
  let at = gcm_placement(header: base.disc, files: base.disc_files, target: base.archive, new_size: repack.archive_size, image_size: base.image_size)
  let in_place = at == base.archive.offset
  let members = fold(repack.placements, init: MemberFold { copies: [], writes: [], cursor: 0 }, f: (acc, p) => member_step(base: base, edits: edits, table: table, data_at: at + base.archive_header.data_start, in_place: in_place, acc: acc, p: p))
  let old_end = base.archive.offset + base.archive.size
  let new_end = at + repack.archive_size
  let tail = if in_place && new_end < old_end { [OctetPatch { offset: new_end, octets: zeros(n: old_end - new_end) }] } else { [] }
  match gcm_fst_entry_location_octets(offset: at, size: repack.archive_size) {
    Absent => LoadRefused { reason: "archive placement does not fit the file system table's 32-bit fields" }
    Present { value: fst_octets } => {
      let head = OctetPatch { offset: at, octets: header_region(base: base, repack: repack) }
      let fst = OctetPatch { offset: gcm_fst_entry_location_offset(header: base.disc, target: base.archive), octets: fst_octets }
      LoadedOk { value: BuildPlan { copies: members.copies, writes: concat(concat([head, fst], members.writes), tail), archive_offset: at, archive_size: repack.archive_size } }
    }
  }
}

// ---- executing and confirming ----

fn revert_lines(writes: List<OctetPatch>) -> List<XxdRevertLine> {
  fold(writes, init: [], f: (acc, w) => concat(acc, xxd_revert_lines(offset: w.offset, octets: w.octets)))
}

fn execute(base: AcBase, plan: BuildPlan, out: String) -> Loaded<Bool> {
  let copied = shell.Copy.File(source: base.path as FilePath, destination: out as FilePath)
  if copied.success == false { LoadRefused { reason: join(["could not copy the base image to ", out], "") } }
  else {
    let failed = plan.copies |> filter(c => dd_copy_range(source: base.path, target: out, copy: c) == false)
    if count(failed) > 0 { LoadRefused { reason: join([to_string(count(failed)), " byte-range copies into ", out, " failed"], "") } }
    else {
      let patch_path = concat(out, ".xxd")
      let w = Filesystem.Write(path: patch_path, content: xxd_revert_patch_text(lines: revert_lines(writes: plan.writes)))
      if w.success == false { LoadRefused { reason: join(["could not write ", patch_path, ": ", w.error], "") } }
      else {
        let r = xxd.Xxd.RevertInto(patch: patch_path, target: out)
        let removed = Filesystem.Delete(path: patch_path)
        if r.success == false { LoadRefused { reason: join(["xxd could not write the patch into ", out, ": ", r.stderr], "") } }
        else if removed.success == false { LoadRefused { reason: join(["the patch was applied but ", patch_path, " could not be removed: ", removed.error], "") } }
        else { LoadedOk { value: true } }
      }
    }
  }
}

fn edit_landed(patched: AcBase, edit: ValidEdit) -> Bool {
  read_message(base: patched, id: edit.edit.block.id) == Present { value: edit.octets }
}

// The output is read back through the same decoders, decoded with the base's code table (its
// digest is new, so it is not admitted by pin), and every edited message must be exactly what was
// written.
fn confirm(base: AcBase, out: String, edits: List<ValidEdit>) -> Loaded<Bool> {
  match load_image(path: out, sha1: "", codes: base.codes) {
    LoadRefused { reason: r } => LoadRefused { reason: join(["the patched image does not decode: ", r], "") }
    LoadedOk { value: patched } =>
      if count(patched.ends) != count(base.ends) { LoadRefused { reason: "the patched image has a different number of messages" } }
      else {
        match edits |> filter(e => edit_landed(patched: patched, edit: e) == false) |> first {
          null => LoadedOk { value: true }
          other => LoadRefused { reason: join(["message ", to_string(other.edit.block.id), " did not land in the patched image"], "") }
        }
      }
  }
}

fn manifest_row(e: ValidEdit) -> String {
  join(["  ", to_string(e.edit.block.id), "  ", e.edit.source, "  ", to_string(e.old_size), " -> ", to_string(count(e.octets)), " octets  ", e.edit.block.label, "\n"], "")
}

fn manifest(base: AcBase, edits: List<ValidEdit>, plan: BuildPlan, out_sha1: String) -> String {
  let where = if plan.archive_offset == base.archive.offset { "in place" } else { "relocated" }
  join([
    "base    ", base.sha1, "\n",
    "output  ", out_sha1, "\n",
    "archive ", message_archive_path, " at ", to_string(plan.archive_offset), ", ", to_string(plan.archive_size), " octets, ", where, "\n",
    "edits   ", to_string(count(edits)), "\n",
    edits |> map(e => manifest_row(e: e)) |> join(separator: ""),
  ], "")
}

fn say(text: String) -> ProcessExit {
  let w = Filesystem.Write(path: "/dev/stdout", content: text)
  if w.success { ExitSuccess } else { exit_failure(reason: w.error) }
}

// ---- entry points ----

fn checked_edits(base: AcBase, patches: String) -> Loaded<CheckedEdits> {
  match load_patch_set(root: patches) {
    LoadRefused { reason: r } => LoadRefused { reason: r }
    LoadedOk { value: set } =>
      match validate(base: base, patches: set) {
        LoadRefused { reason: r } => LoadRefused { reason: join(["REFUSED\n", r], "") }
        LoadedOk { value: edits } => LoadedOk { value: edits }
      }
  }
}

fn check(base: String, patches: String) -> ProcessExit {
  match load_base(path: base) {
    LoadRefused { reason: r } => exit_failure(reason: r)
    LoadedOk { value: b } =>
      match checked_edits(base: b, patches: patches) {
        LoadRefused { reason: r } => exit_failure(reason: r)
        LoadedOk { value: checked } => say(text: join([warning_lines(warnings: checked.warnings), "ok: ", to_string(count(checked.edits)), " message edits apply cleanly\n"], ""))
      }
  }
}

fn warning_lines(warnings: List<String>) -> String {
  warnings |> map(w => join(["warning: ", w, "\n"], "")) |> join(separator: "")
}

fn build_into(b: AcBase, checked: CheckedEdits, out: String) -> ProcessExit {
  let edits = checked.edits
  match build_plan(base: b, edits: edits) {
    LoadRefused { reason: r } => exit_failure(reason: r)
    LoadedOk { value: plan } =>
      match execute(base: b, plan: plan, out: out) {
        LoadRefused { reason: r } => exit_failure(reason: r)
        LoadedOk { value: _ } =>
          match confirm(base: b, out: out, edits: edits) {
            LoadRefused { reason: r } => exit_failure(reason: r)
            LoadedOk { value: _ } =>
              match sha1_file(path: out) {
                Absent => exit_failure(reason: join(["could not digest ", out], ""))
                Present { value: d } => {
                  let text = concat(manifest(base: b, edits: edits, plan: plan, out_sha1: d.hex), warning_lines(warnings: checked.warnings))
                  let w = Filesystem.Write(path: concat(out, ".manifest"), content: text)
                  if w.success { say(text: text) } else { exit_failure(reason: join(["built ", out, " but could not write its manifest: ", w.error], "")) }
                }
              }
          }
      }
  }
}

fn build(base: String, patches: String, out: String) -> ProcessExit {
  match load_base(path: base) {
    LoadRefused { reason: r } => exit_failure(reason: r)
    LoadedOk { value: b } =>
      match checked_edits(base: b, patches: patches) {
        LoadRefused { reason: r } => exit_failure(reason: r)
        LoadedOk { value: checked } => build_into(b: b, checked: checked, out: out)
      }
  }
}

fn message_block(base: AcBase, id: Int, octets: List<Int>) -> AcmsgBlock? {
  match message_tokens(codes: base.codes, message: octets) {
    MessageAccepted { value: t } => Present { value: AcmsgBlock { id: id, label: "", text: message_text(tokens: t) } }
    MessageRefused { reason: _ } => none
  }
}

fn say_blocks(comments: List<String>, blocks: List<AcmsgBlock>) -> ProcessExit {
  match render_acmsg(comments: comments, blocks: blocks) {
    AcmsgAccepted { value: text } => say(text: text)
    AcmsgRefused { reason: r } => exit_failure(reason: r)
  }
}

type ShowFold {
  blocks: List<AcmsgBlock>
  refusal: String
}

fn show_step(base: AcBase, acc: ShowFold, token: String) -> ShowFold {
  if acc.refusal != "" { acc }
  else {
    match message_id_of(token: trim(s: token)) {
      Absent => ShowFold { blocks: acc.blocks, refusal: join(["not a message id: ", token], "") }
      Present { value: id } =>
        if id < 0 || id >= count(base.ends) { ShowFold { blocks: acc.blocks, refusal: join(["no message ", to_string(id)], "") } }
        else {
          match read_message(base: base, id: id) {
            Absent => ShowFold { blocks: acc.blocks, refusal: join(["message ", to_string(id), " could not be read"], "") }
            Present { value: octets } =>
              match message_block(base: base, id: id, octets: octets) {
                Absent => ShowFold { blocks: acc.blocks, refusal: join(["message ", to_string(id), " does not tokenize"], "") }
                Present { value: b } => ShowFold { blocks: list_push(acc.blocks, b), refusal: "" }
              }
          }
        }
    }
  }
}

// Message ids separated by commas, decimal or 0x-hex, printed as .acmsg blocks ready to copy into a
// patch set.
fn show(base: String, ids: String) -> ProcessExit {
  match load_base(path: base) {
    LoadRefused { reason: r } => exit_failure(reason: r)
    LoadedOk { value: b } => {
      let r = fold(split(s: ids, delimiter: ","), init: ShowFold { blocks: [], refusal: "" }, f: (acc, t) => show_step(base: b, acc: acc, token: t))
      if r.refusal != "" { exit_failure(reason: r.refusal) } else { say_blocks(comments: [], blocks: r.blocks) }
    }
  }
}

type DumpFold {
  blocks: List<AcmsgBlock>
  id: Int
  refusal: String
}

fn dump_step(base: AcBase, octets: List<Int>, first_start: Int, acc: DumpFold) -> DumpFold {
  if acc.refusal != "" { acc }
  else {
    let s = message_start(ends: base.ends, id: acc.id) - first_start
    let e = message_end(ends: base.ends, id: acc.id) - first_start
    match message_block(base: base, id: acc.id, octets: octets.skip(n: s).take(n: e - s)) {
      Absent => DumpFold { blocks: acc.blocks, id: acc.id + 1, refusal: join(["message ", to_string(acc.id), " does not tokenize"], "") }
      Present { value: b } => DumpFold { blocks: list_push(acc.blocks, b), id: acc.id + 1, refusal: "" }
    }
  }
}

// `number` consecutive messages from `from`, read as one byte range, printed as .acmsg.
fn dump(base: String, from: String, number: String) -> ProcessExit {
  match load_base(path: base) {
    LoadRefused { reason: r } => exit_failure(reason: r)
    LoadedOk { value: b } =>
      match message_id_of(token: from) {
        Absent => exit_failure(reason: join(["not a message id: ", from], ""))
        Present { value: first_id } =>
          match parse_int(number) {
            Absent => exit_failure(reason: join(["not a count: ", number], ""))
            Present { value: n } =>
              if first_id < 0 || n < 1 || first_id + n > count(b.ends) { exit_failure(reason: "the range runs outside the message table") }
              else {
                let start = message_start(ends: b.ends, id: first_id)
                let end = message_end(ends: b.ends, id: first_id + n - 1)
                match read_range(path: b.path, offset: message_data_offset(base: b) + start, length: end - start) {
                  Absent => exit_failure(reason: "could not read the message range")
                  Present { value: octets } => {
                    let r = fold(zeros(n: n), init: DumpFold { blocks: [], id: first_id, refusal: "" }, f: (acc, _) => dump_step(base: b, octets: octets, first_start: start, acc: acc))
                    if r.refusal != "" { exit_failure(reason: r.refusal) }
                    else { say_blocks(comments: [join(["messages ", to_string(first_id), "..", to_string(first_id + n - 1), " of base ", b.sha1], "")], blocks: r.blocks) }
                  }
                }
              }
          }
      }
  }
}

// ---- the catalog ----

fn evidence_word(e: CatalogEvidence) -> String {
  match e {
    TextVerified => "text-verified"
    FormulaOnly => "formula-only"
  }
}

fn table_word(t: DialogueTable) -> String {
  match t {
    MessageDataTable => "message_data"
    MailTable => "mail"
  }
}

fn range_word(entry: CatalogEntry, p: Personality) -> String {
  match catalog_range(entry: entry, p: p) {
    Absent => join([personality_name(p: p), " -"], "")
    Present { value: r } => join([personality_name(p: p), " ", to_string(r.first_id), "+", to_string(r.count)], "")
  }
}

fn topic_line(entry: CatalogEntry) -> String {
  join([
    entry.topic, "\n",
    "  ", entry.context, "\n",
    "  ", table_word(t: entry.table), ", ", evidence_word(e: entry.evidence), ": ",
    personalities |> map(p => range_word(entry: entry, p: p)) |> join(separator: ", "), "\n",
  ], "")
}

fn topic_matches(entry: CatalogEntry, search: String) -> Bool {
  search == "" || string_contains(s: entry.topic, pattern: search) || string_contains(s: entry.context, pattern: search)
}

// Catalog entries whose topic or context contains `search` ("" lists all).
fn topics(search: String) -> ProcessExit {
  let found = dialogue_catalog |> filter(e => topic_matches(entry: e, search: search))
  say(text: join([found |> map(e => topic_line(entry: e)) |> join(separator: ""), to_string(count(found)), " of ", to_string(count(dialogue_catalog)), " entries\n"], ""))
}

fn personality_named(name: String) -> Personality? {
  match personalities |> filter(p => personality_name(p: p) == name) |> first {
    null => none
    other => Present { value: other }
  }
}

fn label_block(acc: List<AcmsgBlock>, b: AcmsgBlock, topic: String, p: Personality, total: Int) -> List<AcmsgBlock> {
  list_push(acc, AcmsgBlock { id: b.id, label: join([topic, " / ", personality_name(p: p), " ", to_string(count(acc) + 1), " of ", to_string(total)], ""), text: b.text })
}

fn label_blocks(blocks: List<AcmsgBlock>, topic: String, p: Personality) -> List<AcmsgBlock> {
  fold(blocks, init: [], f: (acc, b) => label_block(acc: acc, b: b, topic: topic, p: p, total: count(blocks)))
}

// Every entry message one personality can hear for one catalog topic (named exactly), as .acmsg
// blocks labelled with the topic, ready to rewrite into a patch set.
fn dump_topic(base: String, topic: String, personality: String) -> ProcessExit {
  match dialogue_catalog |> filter(e => e.topic == topic) |> first {
    null => exit_failure(reason: join(["no catalog topic named '", topic, "' (list them with the topics entry point)"], ""))
    entry =>
      match personality_named(name: personality) {
        Absent => exit_failure(reason: join(["not a personality: ", personality, " (normal, peppy, lazy, jock, cranky, snooty)"], ""))
        Present { value: p } =>
          match entry.table {
            MailTable => exit_failure(reason: "letters live in the mail tables, which this workflow does not read yet")
            MessageDataTable =>
              match catalog_range(entry: entry, p: p) {
                Absent => exit_failure(reason: "the catalog has no range for that personality")
                Present { value: r } =>
                  match load_base(path: base) {
                    LoadRefused { reason: why } => exit_failure(reason: why)
                    LoadedOk { value: b } => {
                      let start = message_start(ends: b.ends, id: r.first_id)
                      let end = message_end(ends: b.ends, id: r.first_id + r.count - 1)
                      match read_range(path: b.path, offset: message_data_offset(base: b) + start, length: end - start) {
                        Absent => exit_failure(reason: "could not read the message range")
                        Present { value: octets } => {
                          let d = fold(zeros(n: r.count), init: DumpFold { blocks: [], id: r.first_id, refusal: "" }, f: (acc, _) => dump_step(base: b, octets: octets, first_start: start, acc: acc))
                          if d.refusal != "" { exit_failure(reason: d.refusal) }
                          else {
                            say_blocks(
                              comments: [entry.topic, entry.context, join(["source: ", entry.source], ""), join(["personality: ", personality_name(p: p), "; evidence: ", evidence_word(e: entry.evidence)], "")],
                              blocks: label_blocks(blocks: d.blocks, topic: entry.topic, p: p),
                            )
                          }
                        }
                      }
                    }
                  }
              }
          }
      }
  }
}
