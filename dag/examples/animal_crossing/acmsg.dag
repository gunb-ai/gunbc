module examples.animal_crossing.acmsg

import std.types { Bool, Int, List, String }
import std.algebra { trim }
import std.octet_read { hex_octets }

// The .acmsg patch format, read and written by one grammar. A file is optional `#` comment and
// blank lines, then blocks:
//
//   === <id> [label] ===
//   <message text, any number of lines>
//
// The id is decimal or 0x-hex; the label is free text without surrounding spaces. A body runs to
// the next header line; the one newline that separates it from that header (or ends the file) is
// not part of the message, so a message that ends in a line break renders as a trailing blank
// line. `render_acmsg` refuses exactly the blocks `parse_acmsg` could not read back as themselves.

type AcmsgBlock {
  id: Int
  label: String
  text: String
}

// A parsed block and the `file:line` of its header.
type AcmsgEdit {
  block: AcmsgBlock
  source: String
}

type AcmsgOutcome<T>
  = AcmsgAccepted { value: T }
  | AcmsgRefused { reason: String }

fn hex_int(digits: String) -> Int? {
  match hex_octets(hex: if digits.length() % 2 == 1 { concat("0", digits) } else { digits }) {
    Absent => none
    Present { value: o } => Present { value: fold(o, init: 0, f: (acc, x) => acc * 256 + x) }
  }
}

fn message_id_of(token: String) -> Int? {
  if token.starts_with(prefix: "0x") { hex_int(digits: substring(s: token, start: 2, end: token.length())) } else { parse_int(token) }
}

fn is_header_line(line: String) -> Bool {
  line.starts_with(prefix: "=== ") && line.ends_with(suffix: " ===") && line.length() > 8
}

// ---- reading ----

type AcmsgFold {
  edits: List<AcmsgEdit>
  open: Bool
  id: Int
  label: String
  header_line: Int
  body: List<String>
  line: Int
  refusal: String
}

fn acmsg_close(acc: AcmsgFold, source: String) -> List<AcmsgEdit> {
  if acc.open {
    list_push(acc.edits, AcmsgEdit { block: AcmsgBlock { id: acc.id, label: acc.label, text: acc.body |> join(separator: "\n") }, source: join([source, ":", to_string(acc.header_line)], "") })
  } else { acc.edits }
}

fn acmsg_refused(acc: AcmsgFold, source: String, line: Int, reason: String) -> AcmsgFold {
  AcmsgFold { edits: acc.edits, open: false, id: 0, label: "", header_line: 0, body: [], line: line, refusal: join([source, ":", to_string(line), ": ", reason], "") }
}

fn acmsg_header(acc: AcmsgFold, source: String, line: Int, text: String) -> AcmsgFold {
  let inner = substring(s: text, start: 4, end: text.length() - 4)
  let id_token = get(split(s: inner, delimiter: " "), 0) ?? ""
  match message_id_of(token: id_token) {
    Absent => acmsg_refused(acc: acc, source: source, line: line, reason: "header does not start with a message id")
    Present { value: id } => AcmsgFold {
      edits: acmsg_close(acc: acc, source: source), open: true, id: id,
      label: trim(s: substring(s: inner, start: id_token.length(), end: inner.length())),
      header_line: line, body: [], line: line, refusal: "",
    }
  }
}

fn acmsg_step(source: String, acc: AcmsgFold, text: String) -> AcmsgFold {
  let n = acc.line + 1
  if acc.refusal != "" { acc }
  else if is_header_line(line: text) { acmsg_header(acc: acc, source: source, line: n, text: text) }
  else if acc.open {
    AcmsgFold { edits: acc.edits, open: true, id: acc.id, label: acc.label, header_line: acc.header_line, body: list_push(acc.body, text), line: n, refusal: "" }
  } else if trim(s: text) == "" || text.starts_with(prefix: "#") {
    AcmsgFold { edits: acc.edits, open: false, id: 0, label: "", header_line: 0, body: [], line: n, refusal: "" }
  } else { acmsg_refused(acc: acc, source: source, line: n, reason: "text before the first '=== id ===' header") }
}

fn parse_acmsg(source: String, content: String) -> AcmsgOutcome<List<AcmsgEdit>> {
  let body = if content.ends_with(suffix: "\n") { substring(s: content, start: 0, end: content.length() - 1) } else { content }
  let r = fold(split(s: body, delimiter: "\n"), init: AcmsgFold { edits: [], open: false, id: 0, label: "", header_line: 0, body: [], line: 0, refusal: "" }, f: (acc, l) => acmsg_step(source: source, acc: acc, text: l))
  if r.refusal != "" { AcmsgRefused { reason: r.refusal } } else { AcmsgAccepted { value: acmsg_close(acc: r, source: source) } }
}

// ---- writing ----

fn acmsg_header_text(block: AcmsgBlock) -> String {
  if block.label == "" { join(["=== ", to_string(block.id), " ==="], "") }
  else { join(["=== ", to_string(block.id), " ", block.label, " ==="], "") }
}

// Why `block` would not read back as itself, or "" when it would.
fn acmsg_block_unrenderable(block: AcmsgBlock) -> String {
  if block.id < 0 { "a message id is never negative" }
  else if string_contains(s: block.label, pattern: "\n") { "a label is one line" }
  else if trim(s: block.label) != block.label { "a label has no leading or trailing spaces" }
  else if split(s: block.text, delimiter: "\n") |> any(l => is_header_line(line: l)) { "a message line would read as a block header" }
  else { "" }
}

fn acmsg_comment_unrenderable(comment: String) -> Bool {
  string_contains(s: comment, pattern: "\n")
}

// `comments` become `# ` lines above the first block.
fn render_acmsg(comments: List<String>, blocks: List<AcmsgBlock>) -> AcmsgOutcome<String> {
  match blocks |> filter(b => acmsg_block_unrenderable(block: b) != "") |> first {
    null =>
      if comments |> any(c => acmsg_comment_unrenderable(comment: c)) { AcmsgRefused { reason: "a comment is one line" } }
      else {
        let head = comments |> map(c => join(["# ", c, "\n"], "")) |> join(separator: "")
        let gap = if count(comments) > 0 { "\n" } else { "" }
        AcmsgAccepted { value: join([head, gap, blocks |> map(b => join([acmsg_header_text(block: b), "\n", b.text, "\n"], "")) |> join(separator: "")], "") }
      }
    other => AcmsgRefused { reason: join(["message ", to_string(other.id), ": ", acmsg_block_unrenderable(block: other)], "") }
  }
}
