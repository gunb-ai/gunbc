module std.trait_derive_shape

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.algebra { Cons, Empty }
import v2.std.node { Symbol }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data trait_derive_shape_note: String = "Target-AGNOSTIC half of the capability model: the TargetCapabilityKey brand, the ReprGroundingDeriveElemShape source-shape vocabulary, and the GENERIC table lookup and completeness predicate that take a TargetCapabilityShapeTable as a parameter. THE ROWS ARE NOT HERE. B1 (operator ruling 2026-08-19) replaced the ReprGroundingDeriveTrait coproduct -- sixteen Rust and serde trait names sitting in a std interface -- with TargetCapabilityKey, and moved every Rust-specific row (the shape-by-capability table, the derive-trait list builders, the emission rank, the spellings) into extdeps.languages.rust, so a new target is ROWS in its own extdeps module and never an edit to this fold (DESIGN section 4 N-times-M; section 3 puts realization-selecting dispatch peripheral, never in the interface). THIS FIRES THIS MODULE OWN DECLARED TRIGGER rather than overriding it: trait_derive_shape_dissolve_on said those members migrate beside each target spelling table WHEN A SECOND CONSUMER EXISTS, and the C-linkage realization is that second consumer. DECLARED RESIDUE: this module name now says derive_shape for something that is a capability authority -- a section 3 nickname for what it has become. Not renamed here because a mechanical rename across every importer bundled into a migration that is already reshaping contents makes both unreviewable; the trigger is the next change that touches this module for its own sake. Consumed by v2.compiler.trait_derive_completeness and v1.compiler.trait_derive_emit. #7174 (operator 2026-07-25): v1 emit wires (a) clone bounds on generic params for fn signatures and derive-only generic struct items and (c) serde/Debug/Ord #[derive] on named structs/enums. Root-4 arm (b): predicate-gated supplemental impl { … } blocks for coproduct-native arithmetic carriers — see trait_derive_shape_grounding_lane_handoff; ReprDeriveAdd/Sub/… rows on KernelInt are capability-table authority for repr_grounding_derive_completeness_predicate, not spellings."

data trait_derive_shape_grounding_lane_handoff: String = "Root-4 arm (b): coproduct-native arithmetic + PartialOrd/PartialEq impl blocks for algebra carriers (GroupCompletion<Nat>, Vector). Capability table + repr_grounding_derive_completeness_predicate remain the shared authority; v1.compiler.trait_derive_emit emits impl { … } from shape rows (not #[derive]) through the seed emitter. GroupCompletion<M> pos/neg pair Add/Sub/Mul/Div landed in #7197 (dissolves interim CommutativeSemiring<Magnitude> stubs)."

type TargetCapabilityKey = Symbol where brand("TargetCapabilityKey")

type TargetCapabilityShapeRow {
  shape: ReprGroundingDeriveElemShape
  capabilities: List<TargetCapabilityKey>
}

type TargetCapabilityShapeTable {
  rows: List<TargetCapabilityShapeRow>
}

type ReprGroundingDeriveElemShape
  = ReprDeriveElemKernelString
  | ReprDeriveElemKernelInt
  | ReprDeriveElemKernelBool
  | ReprDeriveElemKernelUnit
  | ReprDeriveElemNullaryEnumCopy
  | ReprDeriveElemSymbolWrappedOrdCarrier
  | ReprDeriveElemPayloadCoproduct
  | ReprDeriveElemUnknown

fn repr_grounding_elem_shape_rank(shape: ReprGroundingDeriveElemShape) -> Int {
  match shape {
    ReprDeriveElemKernelString => 0
    ReprDeriveElemKernelInt => 1
    ReprDeriveElemKernelBool => 2
    ReprDeriveElemKernelUnit => 3
    ReprDeriveElemNullaryEnumCopy => 4
    ReprDeriveElemSymbolWrappedOrdCarrier => 5
    ReprDeriveElemPayloadCoproduct => 6
    ReprDeriveElemUnknown => 7
  }
}

fn repr_grounding_derive_shape_has_trait(
  table: TargetCapabilityShapeTable,
  shape: ReprGroundingDeriveElemShape,
  capability_key: TargetCapabilityKey
) -> Bool {
  table.rows
    |> any(row => repr_grounding_elem_shape_rank(shape: row.shape)
                    == repr_grounding_elem_shape_rank(shape: shape)
                  && (row.capabilities |> any(k => k == capability_key)))
}

fn repr_grounding_derive_completeness_predicate(
  table: TargetCapabilityShapeTable,
  required: List<TargetCapabilityKey>,
  shape: ReprGroundingDeriveElemShape
) -> Bool {
  required |> all(k => repr_grounding_derive_shape_has_trait(
    table: table,
    shape: shape,
    capability_key: k
  ))
}

data pair_completion_shape_note: String = "Target-agnostic authority for the Grothendieck pair-completion operator BODIES on GroupCompletion<M> (std.algebra). Each output component is a polynomial over the four operand components self.pos, self.neg, rhs.pos, rhs.neg: an arm is a sum of terms, a term is a product of factors, a factor names one operand component. Selection (which traits apply) stays in the capability table above; SPELLING (trait paths, where-clauses, field syntax) lives per target in extdeps.languages.rust.emit. Reuses ReprGroundingDeriveTrait as the op key rather than minting a parallel operator enum."

type PairCompletionOperand
  = PairCompletionSelf
  | PairCompletionRhs

type PairCompletionComponent
  = PairCompletionPos
  | PairCompletionNeg

type PairCompletionFactor {
  operand: PairCompletionOperand
  component: PairCompletionComponent
}

type PairCompletionTerm {
  factors: List<PairCompletionFactor>
}

type PairCompletionArm {
  terms: List<PairCompletionTerm>
}

type PairCompletionBody
  = PairCompletionSumOfProducts { pos: PairCompletionArm, neg: PairCompletionArm }
  | PairCompletionNegatedAddend
  | PairCompletionCanonicalQuotient

type PairCompletionOpRow {
  op: TargetCapabilityKey
  body: PairCompletionBody
}

fn pair_completion_factor(
  operand: PairCompletionOperand,
  component: PairCompletionComponent
) -> PairCompletionFactor {
  PairCompletionFactor { operand: operand, component: component }
}

fn pair_completion_op_rows() -> List<PairCompletionOpRow> {
  [
    PairCompletionOpRow {
      op: ^target_capability_neg,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionNeg)]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionPos)]
            }
          ]
        }
      }
    },
    PairCompletionOpRow {
      op: ^target_capability_add,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionPos)]
            },
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionRhs, PairCompletionPos)]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionNeg)]
            },
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionRhs, PairCompletionNeg)]
            }
          ]
        }
      }
    },
    PairCompletionOpRow { op: ^target_capability_sub, body: PairCompletionNegatedAddend },
    PairCompletionOpRow {
      op: ^target_capability_mul,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionPos),
                pair_completion_factor(PairCompletionRhs, PairCompletionPos)
              ]
            },
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionNeg),
                pair_completion_factor(PairCompletionRhs, PairCompletionNeg)
              ]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionPos),
                pair_completion_factor(PairCompletionRhs, PairCompletionNeg)
              ]
            },
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionNeg),
                pair_completion_factor(PairCompletionRhs, PairCompletionPos)
              ]
            }
          ]
        }
      }
    },
    PairCompletionOpRow { op: ^target_capability_div, body: PairCompletionCanonicalQuotient }
  ]
}

fn pair_completion_arm_uses_rhs(arm: PairCompletionArm) -> Bool {
  arm.terms |> any(term => term.factors |> any(f => match f.operand { PairCompletionRhs => true  PairCompletionSelf => false }))
}

fn pair_completion_body_uses_rhs(body: PairCompletionBody) -> Bool {
  match body {
    PairCompletionSumOfProducts { pos: pos, neg: neg } =>
      pair_completion_arm_uses_rhs(pos) || pair_completion_arm_uses_rhs(neg)
    PairCompletionNegatedAddend => true
    PairCompletionCanonicalQuotient => true
  }
}

data repr_grounding_group_completion_carrier_note: String = "Interim carrier identity for capability-table selection of GroupCompletion pair-completion bodies (#7272 A1 / #7286 handoff). The struct trait surface is selected once via v1_emit_struct_from_capability_table (#[derive] attrs + KernelInt arithmetic impl bodies); the old v1_emit_struct_supplemental_impls door is deleted. The rename from supplemental_*_target is NOT the fix while selection is still name-match (module_path == \"std.algebra\" && name == \"GroupCompletion\") — see dissolve-on."

data repr_grounding_group_completion_carrier_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.algebra",
    decl_name: "Ring",
    field: WholeDeclaration
  }
}

fn repr_grounding_group_completion_carrier(module_path: String, name: String) -> Bool {
  module_path == "std.algebra" && name == "GroupCompletion"
}

fn repr_grounding_supplemental_bool_host_bridge_target(module_path: String, name: String) -> Bool {
  module_path == "std.types" && name == "Bool"
}

data pair_completion_shape_dissolve_on: DissolutionCondition = unbound_dissolution(description: "Dissolves when v2 derives these rows from the std.algebra Ring/AbelianGroup inhabitance witnesses directly, so the Grothendieck construction is read off the algebra rather than tabulated here; tracked by the numeric-tower grounding lane.")

data pair_completion_uses_rhs_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: std.trait_derive_shape.pair_completion_arm_uses_rhs / pair_completion_body_uses_rhs — variant-discriminating Bool predicates over PairCompletionOperand / PairCompletionBody, retained only because operand arity is DERIVED from the formula rather than stored (storing an arity field would be a second representation of what the arms already say). They dissolve into an arity projection car")

data repr_grounding_bool_host_bridge_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: repr_grounding_supplemental_bool_host_bridge_target / v1_emit_enum_supplemental_impls — Bool↔host-bool bridge door. Dissolves with the Value::Null-split / Bool True|False ↔ Value::Bool grounding lane (DESIGN open thread; gunbc.plans.value_null_split). Kept as the remaining half of the old supplemental door; do not ground the bridge in an emitter cleanup (§3).")

data repr_grounding_group_completion_carrier_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: repr_grounding_group_completion_carrier — name-match module_path/name selection. Dissolves when capability selection for GroupCompletion pair-completion is derived from std.algebra Ring/AbelianGroup inhabitance witnesses (same terminal as pair_completion_shape_dissolve_on / numeric-tower grounding), so the carrier is identified by inhabitance rather than string equality. Terminal trig")

data trait_derive_shape_dissolve_on: DissolutionCondition = unbound_dissolution(description: "ReprGroundingDeriveTrait members that name Rust-specific authorities (ReprDeriveSerialize, ReprDeriveAdd, …) migrate beside each target's spelling table when a second consumer exists; until then capability roles stay in std/ with spellings in extdeps.languages.rust.emit.")
