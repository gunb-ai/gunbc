module std.trait_derive_shape

import std.algebra { Cons, Empty }

data trait_derive_shape_note: String = "Target-agnostic authority for ReprGroundingDeriveTrait × ReprGroundingDeriveElemShape capability table and derive-trait list builders. Rust spellings: extdeps.languages.rust.emit. Consumed by v2.compiler.trait_derive_completeness and v1.compiler.trait_derive_emit."

type ReprGroundingDeriveTrait
  = ReprDeriveClone
  | ReprDeriveCopy
  | ReprDerivePartialEq
  | ReprDeriveEq
  | ReprDerivePartialOrd
  | ReprDeriveOrd
  | ReprDeriveSerialize
  | ReprDeriveDeserialize
  | ReprDeriveAdd
  | ReprDeriveSub
  | ReprDeriveMul
  | ReprDeriveDiv
  | ReprDeriveRem
  | ReprDeriveNeg

type ReprGroundingDeriveElemShape
  = ReprDeriveElemKernelString
  | ReprDeriveElemKernelInt
  | ReprDeriveElemKernelBool
  | ReprDeriveElemKernelUnit
  | ReprDeriveElemNullaryEnumCopy
  | ReprDeriveElemUnknown

fn repr_grounding_derive_shape_has_trait(
  shape: ReprGroundingDeriveElemShape,
  derive_trait: ReprGroundingDeriveTrait
) -> Bool {
  match shape {
    ReprDeriveElemKernelString =>
      match derive_trait {
        ReprDeriveClone => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemKernelInt =>
      match derive_trait {
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        ReprDeriveAdd => true
        ReprDeriveSub => true
        ReprDeriveMul => true
        ReprDeriveDiv => true
        ReprDeriveRem => true
        ReprDeriveNeg => true
      }
    ReprDeriveElemKernelBool =>
      match derive_trait {
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemKernelUnit =>
      match derive_trait {
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemNullaryEnumCopy =>
      match derive_trait {
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemUnknown => false
  }
}

fn repr_grounding_derive_completeness_predicate(
  required: List<ReprGroundingDeriveTrait>,
  shape: ReprGroundingDeriveElemShape
) -> Bool {
  required |> all(dt => repr_grounding_derive_shape_has_trait(shape, dt))
}

fn record_derive_traits_heap() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveClone,
    tail: Cons {
      head: ReprDerivePartialEq,
      tail: Cons {
        head: ReprDeriveSerialize,
        tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
      }
    }
  }
}

fn record_derive_traits_copy() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveClone,
    tail: Cons {
      head: ReprDeriveCopy,
      tail: Cons {
        head: ReprDerivePartialEq,
        tail: Cons {
          head: ReprDeriveSerialize,
          tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
        }
      }
    }
  }
}

fn nullary_coproduct_derive_traits() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveClone,
    tail: Cons {
      head: ReprDeriveCopy,
      tail: Cons {
        head: ReprDerivePartialEq,
        tail: Cons {
          head: ReprDeriveEq,
          tail: Cons {
            head: ReprDerivePartialOrd,
            tail: Cons {
              head: ReprDeriveOrd,
              tail: Cons {
                head: ReprDeriveSerialize,
                tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
              }
            }
          }
        }
      }
    }
  }
}

fn payload_coproduct_derive_traits() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveClone,
    tail: Cons {
      head: ReprDerivePartialEq,
      tail: Cons {
        head: ReprDeriveSerialize,
        tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
      }
    }
  }
}
