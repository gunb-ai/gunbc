module std.trait_derive_shape

import std.algebra { Cons, Empty }

data trait_derive_shape_note: String = "Target-agnostic authority for ReprGroundingDeriveTrait × ReprGroundingDeriveElemShape capability table and derive-trait list builders. Rust spellings: extdeps.languages.rust.emit. Consumed by v2.compiler.trait_derive_completeness and v1.compiler.trait_derive_emit. #7174 (operator 2026-07-25): v1 emit wires (a) clone bounds and (c) serde/Debug/Ord #[derive] on named structs/enums. Root-4 arm (b): predicate-gated supplemental impl { … } blocks for coproduct-native arithmetic carriers — see trait_derive_shape_grounding_lane_handoff; ReprDeriveAdd/Sub/… rows on KernelInt are capability-table authority for repr_grounding_derive_completeness_predicate, not spellings."

data trait_derive_shape_grounding_lane_handoff: String = "Root-4 arm (b): coproduct-native arithmetic + PartialOrd/PartialEq impl blocks for algebra carriers (GroupCompletion<Nat>, Vector). Capability table + repr_grounding_derive_completeness_predicate remain the shared authority; v1.compiler.trait_derive_emit emits impl { … } from shape rows (not #[derive]) through the seed emitter. GroupCompletion<M> pos/neg pair Add/Sub/Mul/Div landed in #7197 (dissolves interim CommutativeSemiring<Magnitude> stubs)."

data trait_derive_shape_dissolve_on: String = "ReprGroundingDeriveTrait members that name Rust-specific authorities (ReprDeriveSerialize, ReprDeriveAdd, …) migrate beside each target's spelling table when a second consumer exists; until then capability roles stay in std/ with spellings in extdeps.languages.rust.emit."

type ReprGroundingDeriveTrait
  = ReprDeriveDebug
  | ReprDeriveClone
  | ReprDeriveCopy
  | ReprDerivePartialEq
  | ReprDeriveEq
  | ReprDerivePartialOrd
  | ReprDeriveOrd
  | ReprDeriveSerialize
  | ReprDeriveDeserialize
  | ReprDeriveAdd
  | ReprDeriveSub
  | ReprDeriveMul
  | ReprDeriveDiv
  | ReprDeriveRem
  | ReprDeriveNeg

type ReprGroundingDeriveElemShape
  = ReprDeriveElemKernelString
  | ReprDeriveElemKernelInt
  | ReprDeriveElemKernelBool
  | ReprDeriveElemKernelUnit
  | ReprDeriveElemNullaryEnumCopy
  | ReprDeriveElemSymbolWrappedOrdCarrier
  | ReprDeriveElemPayloadCoproduct
  | ReprDeriveElemUnknown

fn repr_grounding_derive_shape_has_trait(
  shape: ReprGroundingDeriveElemShape,
  derive_trait: ReprGroundingDeriveTrait
) -> Bool {
  match shape {
    ReprDeriveElemKernelString =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemKernelInt =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        ReprDeriveAdd => true
        ReprDeriveSub => true
        ReprDeriveMul => true
        ReprDeriveDiv => true
        ReprDeriveRem => true
        ReprDeriveNeg => true
      }
    ReprDeriveElemKernelBool =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemKernelUnit =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemNullaryEnumCopy =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemSymbolWrappedOrdCarrier =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemPayloadCoproduct =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDerivePartialEq => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemUnknown => false
  }
}

fn repr_grounding_derive_completeness_predicate(
  required: List<ReprGroundingDeriveTrait>,
  shape: ReprGroundingDeriveElemShape
) -> Bool {
  required |> all(dt => repr_grounding_derive_shape_has_trait(shape, dt))
}

fn record_derive_traits_heap() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveDebug,
    tail: Cons {
      head: ReprDeriveClone,
      tail: Cons {
        head: ReprDerivePartialEq,
        tail: Cons {
          head: ReprDeriveSerialize,
          tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
        }
      }
    }
  }
}

fn record_derive_traits_copy() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveDebug,
    tail: Cons {
      head: ReprDeriveClone,
      tail: Cons {
        head: ReprDeriveCopy,
        tail: Cons {
          head: ReprDerivePartialEq,
          tail: Cons {
            head: ReprDeriveSerialize,
            tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
          }
        }
      }
    }
  }
}

fn nullary_coproduct_derive_traits() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveDebug,
    tail: Cons {
      head: ReprDeriveClone,
      tail: Cons {
        head: ReprDeriveCopy,
        tail: Cons {
          head: ReprDerivePartialEq,
          tail: Cons {
            head: ReprDeriveEq,
            tail: Cons {
              head: ReprDerivePartialOrd,
              tail: Cons {
                head: ReprDeriveOrd,
                tail: Cons {
                  head: ReprDeriveSerialize,
                  tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn symbol_wrapped_ord_carrier_derive_traits() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveDebug,
    tail: Cons {
      head: ReprDeriveClone,
      tail: Cons {
        head: ReprDerivePartialEq,
        tail: Cons {
          head: ReprDeriveEq,
          tail: Cons {
            head: ReprDerivePartialOrd,
            tail: Cons {
              head: ReprDeriveOrd,
              tail: Cons {
                head: ReprDeriveSerialize,
                tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
              }
            }
          }
        }
      }
    }
  }
}

fn fn_field_derive_traits() -> List<ReprGroundingDeriveTrait> {
  Cons { head: ReprDeriveClone, tail: Empty }
}

fn payload_coproduct_derive_traits() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveDebug,
    tail: Cons {
      head: ReprDeriveClone,
      tail: Cons {
        head: ReprDerivePartialEq,
        tail: Cons {
          head: ReprDeriveSerialize,
          tail: Cons { head: ReprDeriveDeserialize, tail: Empty }
        }
      }
    }
  }
}

fn kernel_int_arithmetic_traits() -> List<ReprGroundingDeriveTrait> {
  Cons {
    head: ReprDeriveAdd,
    tail: Cons {
      head: ReprDeriveSub,
      tail: Cons {
        head: ReprDeriveMul,
        tail: Cons {
          head: ReprDeriveDiv,
          tail: Cons {
            head: ReprDeriveRem,
            tail: Cons {
              head: ReprDeriveNeg,
              tail: Cons {
                head: ReprDerivePartialEq,
                tail: Cons { head: ReprDerivePartialOrd, tail: Empty }
              }
            }
          }
        }
      }
    }
  }
}

data pair_completion_shape_note: String = "Target-agnostic authority for the Grothendieck pair-completion operator BODIES on GroupCompletion<M> (std.algebra). Each output component is a polynomial over the four operand components self.pos, self.neg, rhs.pos, rhs.neg: an arm is a sum of terms, a term is a product of factors, a factor names one operand component. Selection (which traits apply) stays in the capability table above; SPELLING (trait paths, where-clauses, field syntax) lives per target in extdeps.languages.rust.emit. Reuses ReprGroundingDeriveTrait as the op key rather than minting a parallel operator enum."

data pair_completion_shape_dissolve_on: String = "Dissolves when v2 derives these rows from the std.algebra Ring/AbelianGroup inhabitance witnesses directly, so the Grothendieck construction is read off the algebra rather than tabulated here; tracked by the numeric-tower grounding lane."

type PairCompletionOperand
  = PairCompletionSelf
  | PairCompletionRhs

type PairCompletionComponent
  = PairCompletionPos
  | PairCompletionNeg

type PairCompletionFactor {
  operand: PairCompletionOperand
  component: PairCompletionComponent
}

type PairCompletionTerm {
  factors: List<PairCompletionFactor>
}

type PairCompletionArm {
  terms: List<PairCompletionTerm>
}

type PairCompletionBody
  = PairCompletionSumOfProducts { pos: PairCompletionArm, neg: PairCompletionArm }
  | PairCompletionNegatedAddend
  | PairCompletionCanonicalQuotient

type PairCompletionOpRow {
  op: ReprGroundingDeriveTrait
  body: PairCompletionBody
}

fn pair_completion_factor(
  operand: PairCompletionOperand,
  component: PairCompletionComponent
) -> PairCompletionFactor {
  PairCompletionFactor { operand: operand, component: component }
}

fn pair_completion_op_rows() -> List<PairCompletionOpRow> {
  [
    PairCompletionOpRow {
      op: ReprDeriveNeg,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionNeg)]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionPos)]
            }
          ]
        }
      }
    },
    PairCompletionOpRow {
      op: ReprDeriveAdd,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionPos)]
            },
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionRhs, PairCompletionPos)]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionNeg)]
            },
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionRhs, PairCompletionNeg)]
            }
          ]
        }
      }
    },
    PairCompletionOpRow { op: ReprDeriveSub, body: PairCompletionNegatedAddend },
    PairCompletionOpRow {
      op: ReprDeriveMul,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionPos),
                pair_completion_factor(PairCompletionRhs, PairCompletionPos)
              ]
            },
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionNeg),
                pair_completion_factor(PairCompletionRhs, PairCompletionNeg)
              ]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionPos),
                pair_completion_factor(PairCompletionRhs, PairCompletionNeg)
              ]
            },
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionNeg),
                pair_completion_factor(PairCompletionRhs, PairCompletionPos)
              ]
            }
          ]
        }
      }
    },
    PairCompletionOpRow { op: ReprDeriveDiv, body: PairCompletionCanonicalQuotient }
  ]
}

data pair_completion_uses_rhs_dissolve_on: String = "dissolve-on: std.trait_derive_shape.pair_completion_arm_uses_rhs / pair_completion_body_uses_rhs — variant-discriminating Bool predicates over PairCompletionOperand / PairCompletionBody, retained only because operand arity is DERIVED from the formula rather than stored (storing an arity field would be a second representation of what the arms already say). They dissolve into an arity projection carried on PairCompletionOpRow at construction the moment a second consumer needs arity, or the moment refinement predicates become construction-enforced so the projection can be made total by construction; until then the derivation is the single authority and these are its only readers."

fn pair_completion_arm_uses_rhs(arm: PairCompletionArm) -> Bool {
  arm.terms |> any(term => term.factors |> any(f => match f.operand { PairCompletionRhs => true  PairCompletionSelf => false }))
}

fn pair_completion_body_uses_rhs(body: PairCompletionBody) -> Bool {
  match body {
    PairCompletionSumOfProducts { pos: pos, neg: neg } =>
      pair_completion_arm_uses_rhs(pos) || pair_completion_arm_uses_rhs(neg)
    PairCompletionNegatedAddend => true
    PairCompletionCanonicalQuotient => true
  }
}

fn repr_grounding_supplemental_group_completion_target(module_path: String, name: String) -> Bool {
  module_path == "std.algebra" && name == "GroupCompletion"
}

fn repr_grounding_supplemental_bool_host_bridge_target(module_path: String, name: String) -> Bool {
  module_path == "std.types" && name == "Bool"
}
