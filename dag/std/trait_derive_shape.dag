module std.trait_derive_shape



data trait_derive_shape_note: String = "Target-agnostic authority for ReprGroundingDeriveTrait × ReprGroundingDeriveElemShape capability table and derive-trait list builders. Rust spellings: extdeps.languages.rust.emit. Consumed by v2.compiler.trait_derive_completeness and v1.compiler.trait_derive_emit. #7174 (operator 2026-07-25): v1 emit wires (a) clone bounds on generic params for fn signatures and derive-only generic struct items and (c) serde/Debug/Ord #[derive] on named structs/enums. Root-4 arm (b): predicate-gated supplemental impl { … } blocks for coproduct-native arithmetic carriers — see trait_derive_shape_grounding_lane_handoff; ReprDeriveAdd/Sub/… rows on KernelInt are capability-table authority for repr_grounding_derive_completeness_predicate, not spellings."

data trait_derive_shape_grounding_lane_handoff: String = "Root-4 arm (b): coproduct-native arithmetic + PartialOrd/PartialEq impl blocks for algebra carriers (GroupCompletion<Nat>, Vector). Capability table + repr_grounding_derive_completeness_predicate remain the shared authority; v1.compiler.trait_derive_emit emits impl { … } from shape rows (not #[derive]) through the seed emitter. GroupCompletion<M> pos/neg pair Add/Sub/Mul/Div landed in #7197 (dissolves interim CommutativeSemiring<Magnitude> stubs)."

type ReprGroundingDeriveTrait
  = ReprDeriveDebug
  | ReprDeriveClone
  | ReprDeriveCopy
  | ReprDerivePartialEq
  | ReprDeriveEq
  | ReprDerivePartialOrd
  | ReprDeriveOrd
  | ReprDeriveHash
  | ReprDeriveSerialize
  | ReprDeriveDeserialize
  | ReprDeriveAdd
  | ReprDeriveSub
  | ReprDeriveMul
  | ReprDeriveDiv
  | ReprDeriveRem
  | ReprDeriveNeg

type ReprGroundingDeriveElemShape
  = ReprDeriveElemKernelString
  | ReprDeriveElemKernelInt
  | ReprDeriveElemKernelBool
  | ReprDeriveElemKernelUnit
  | ReprDeriveElemNullaryEnumCopy
  | ReprDeriveElemSymbolWrappedOrdCarrier
  | ReprDeriveElemPayloadCoproduct
  | ReprDeriveElemUnknown

fn repr_grounding_derive_shape_has_trait(
  shape: ReprGroundingDeriveElemShape,
  derive_trait: ReprGroundingDeriveTrait
) -> Bool {
  match shape {
    ReprDeriveElemKernelString =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveHash => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemKernelInt =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveHash => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        ReprDeriveAdd => true
        ReprDeriveSub => true
        ReprDeriveMul => true
        ReprDeriveDiv => true
        ReprDeriveRem => true
        ReprDeriveNeg => true
      }
    ReprDeriveElemKernelBool =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveHash => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemKernelUnit =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveHash => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemNullaryEnumCopy =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDeriveCopy => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveHash => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemSymbolWrappedOrdCarrier =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDerivePartialOrd => true
        ReprDeriveOrd => true
        ReprDeriveHash => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemPayloadCoproduct =>
      match derive_trait {
        ReprDeriveDebug => true
        ReprDeriveClone => true
        ReprDerivePartialEq => true
        ReprDeriveEq => true
        ReprDeriveHash => true
        ReprDeriveSerialize => true
        ReprDeriveDeserialize => true
        _ => false
      }
    ReprDeriveElemUnknown => false
  }
}

// Eq and Hash on a payload coproduct are CAPABILITY rows, not roster rows, and the distinction is why
// they read false until the usage-derived requirement needed them. The capability table answers what a
// shape CAN derive; the roster answers what it DOES. Rust derives Eq and Hash on an enum with payloads
// exactly as it derives PartialEq — the macro emits an impl bounded by the payload types, so the
// capability is the payload types' problem and not the enum shape's, and PartialEq was already true
// here for that same reason. Setting these false conflated the two questions: it said the shape cannot
// support the trait when the fact was only that payload_coproduct_derive_traits does not ask for it.
// The rows change no existing emission, because the completeness predicate is evaluated against the
// roster actually chosen and that roster is unchanged; what they unblock is a payload coproduct
// reaching a map-key position, which before this refused with compile_error! at a shape that could
// have carried the derive. Where a payload genuinely is not Eq or Hash — a Float, a callable field —
// the emitted impl fails at rustc with a located E0277 against the offending payload, which is a
// better refusal than one against the enum, because it names the field that cannot hold rather than
// the shape that could.
fn repr_grounding_derive_completeness_predicate(
  required: List<ReprGroundingDeriveTrait>,
  shape: ReprGroundingDeriveElemShape
) -> Bool {
  required |> all(dt => repr_grounding_derive_shape_has_trait(shape, dt))
}

fn record_derive_traits_heap() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons {
    head: ReprDeriveDebug,
    tail: std.algebra.Cons {
      head: ReprDeriveClone,
      tail: std.algebra.Cons {
        head: ReprDerivePartialEq,
        tail: std.algebra.Cons {
          head: ReprDeriveSerialize,
          tail: std.algebra.Cons { head: ReprDeriveDeserialize, tail: std.algebra.Empty }
        }
      }
    }
  }
}

fn record_derive_traits_copy() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons {
    head: ReprDeriveDebug,
    tail: std.algebra.Cons {
      head: ReprDeriveClone,
      tail: std.algebra.Cons {
        head: ReprDeriveCopy,
        tail: std.algebra.Cons {
          head: ReprDerivePartialEq,
          tail: std.algebra.Cons {
            head: ReprDeriveSerialize,
            tail: std.algebra.Cons { head: ReprDeriveDeserialize, tail: std.algebra.Empty }
          }
        }
      }
    }
  }
}

fn nullary_coproduct_derive_traits() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons {
    head: ReprDeriveDebug,
    tail: std.algebra.Cons {
      head: ReprDeriveClone,
      tail: std.algebra.Cons {
        head: ReprDeriveCopy,
        tail: std.algebra.Cons {
          head: ReprDerivePartialEq,
          tail: std.algebra.Cons {
            head: ReprDeriveEq,
            tail: std.algebra.Cons {
              head: ReprDerivePartialOrd,
              tail: std.algebra.Cons {
                head: ReprDeriveOrd,
                tail: std.algebra.Cons {
                  head: ReprDeriveSerialize,
                  tail: std.algebra.Cons { head: ReprDeriveDeserialize, tail: std.algebra.Empty }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn symbol_wrapped_ord_carrier_derive_traits() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons {
    head: ReprDeriveDebug,
    tail: std.algebra.Cons {
      head: ReprDeriveClone,
      tail: std.algebra.Cons {
        head: ReprDerivePartialEq,
        tail: std.algebra.Cons {
          head: ReprDeriveEq,
          tail: std.algebra.Cons {
            head: ReprDerivePartialOrd,
            tail: std.algebra.Cons {
              head: ReprDeriveOrd,
              tail: std.algebra.Cons {
                head: ReprDeriveSerialize,
                tail: std.algebra.Cons { head: ReprDeriveDeserialize, tail: std.algebra.Empty }
              }
            }
          }
        }
      }
    }
  }
}

fn fn_field_derive_traits() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons { head: ReprDeriveClone, tail: std.algebra.Empty }
}

fn payload_coproduct_derive_traits() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons {
    head: ReprDeriveDebug,
    tail: std.algebra.Cons {
      head: ReprDeriveClone,
      tail: std.algebra.Cons {
        head: ReprDerivePartialEq,
        tail: std.algebra.Cons {
          head: ReprDeriveSerialize,
          tail: std.algebra.Cons { head: ReprDeriveDeserialize, tail: std.algebra.Empty }
        }
      }
    }
  }
}

// USAGE-DERIVED half of the roster, distinct from the SHAPE-derived rosters above and additive to
// them. The rosters above answer what a type's own structure can support; they cannot answer what a
// type's USE demands, so a record reaching a keyed-collection key position carries a requirement no
// shape classification produces. map_key_required_derive_traits names that requirement once: a keyed
// collection realized as a hash map bounds its key parameter by Hash + Eq (im 15.1.0 HashMap<K, V>
// declares K: Hash + Eq, matching std::collections::HashMap), so the key type must derive both. The
// requirement is target-agnostic here and spelled per target in extdeps.languages.rust.emit. Union is
// append-only and idempotent (derive_traits_union), so a type that already earns a trait from its
// shape roster gains nothing and its emitted bytes do not move — the asymmetry a fixed wider roster
// cannot express: a Symbol-wrapped ord carrier already derives Eq and needs only Hash, while a plain
// record needs both. NOT the same axis as the Ord requirement BTreeSet elements carry
// (rust_btree_set_element_ord_eligible), which is answered today by refusing at the use site rather
// than by propagating to the declaration; unifying the two on this fn is the named next step and
// deliberately not taken here.
fn phantom_opaque_carrier_derive_traits() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons {
    head: ReprDeriveDebug,
    tail: std.algebra.Cons {
      head: ReprDeriveClone,
      tail: std.algebra.Cons {
        head: ReprDeriveCopy,
        tail: std.algebra.Cons {
          head: ReprDerivePartialEq,
          tail: std.algebra.Cons {
            head: ReprDeriveEq,
            tail: std.algebra.Cons {
              head: ReprDeriveSerialize,
              tail: std.algebra.Cons { head: ReprDeriveDeserialize, tail: std.algebra.Empty }
            }
          }
        }
      }
    }
  }
}

fn map_key_required_derive_traits() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons { head: ReprDeriveEq, tail: std.algebra.Cons { head: ReprDeriveHash, tail: std.algebra.Empty } }
}

fn repr_grounding_derive_trait_rank(derive_trait: ReprGroundingDeriveTrait) -> Int {
  match derive_trait {
    ReprDeriveDebug => 0
    ReprDeriveClone => 1
    ReprDeriveCopy => 2
    ReprDerivePartialEq => 3
    ReprDeriveEq => 4
    ReprDerivePartialOrd => 5
    ReprDeriveOrd => 6
    ReprDeriveHash => 7
    ReprDeriveSerialize => 8
    ReprDeriveDeserialize => 9
    ReprDeriveAdd => 10
    ReprDeriveSub => 11
    ReprDeriveMul => 12
    ReprDeriveDiv => 13
    ReprDeriveRem => 14
    ReprDeriveNeg => 15
  }
}

fn derive_traits_contain(
  traits: List<ReprGroundingDeriveTrait>,
  derive_trait: ReprGroundingDeriveTrait
) -> Bool {
  traits |> any(t => repr_grounding_derive_trait_rank(t) == repr_grounding_derive_trait_rank(derive_trait))
}

fn derive_traits_union(
  base: List<ReprGroundingDeriveTrait>,
  extra: List<ReprGroundingDeriveTrait>
) -> List<ReprGroundingDeriveTrait> {
  extra |> fold(init: base, f: (acc, t) =>
    if derive_traits_contain(traits: acc, derive_trait: t) { acc } else { concat(acc, [t]) }
  )
}

fn kernel_int_arithmetic_traits() -> List<ReprGroundingDeriveTrait> {
  std.algebra.Cons {
    head: ReprDeriveAdd,
    tail: std.algebra.Cons {
      head: ReprDeriveSub,
      tail: std.algebra.Cons {
        head: ReprDeriveMul,
        tail: std.algebra.Cons {
          head: ReprDeriveDiv,
          tail: std.algebra.Cons {
            head: ReprDeriveRem,
            tail: std.algebra.Cons {
              head: ReprDeriveNeg,
              tail: std.algebra.Cons {
                head: ReprDerivePartialEq,
                tail: std.algebra.Cons { head: ReprDerivePartialOrd, tail: std.algebra.Empty }
              }
            }
          }
        }
      }
    }
  }
}

data pair_completion_shape_note: String = "Target-agnostic authority for the Grothendieck pair-completion operator BODIES on GroupCompletion<M> (std.algebra). Each output component is a polynomial over the four operand components self.pos, self.neg, rhs.pos, rhs.neg: an arm is a sum of terms, a term is a product of factors, a factor names one operand component. Selection (which traits apply) stays in the capability table above; SPELLING (trait paths, where-clauses, field syntax) lives per target in extdeps.languages.rust.emit. Reuses ReprGroundingDeriveTrait as the op key rather than minting a parallel operator enum."

type PairCompletionOperand
  = PairCompletionSelf
  | PairCompletionRhs

type PairCompletionComponent
  = PairCompletionPos
  | PairCompletionNeg

type PairCompletionFactor {
  operand: PairCompletionOperand
  component: PairCompletionComponent
}

type PairCompletionTerm {
  factors: List<PairCompletionFactor>
}

type PairCompletionArm {
  terms: List<PairCompletionTerm>
}

type PairCompletionBody
  = PairCompletionSumOfProducts { pos: PairCompletionArm, neg: PairCompletionArm }
  | PairCompletionNegatedAddend
  | PairCompletionCanonicalQuotient

type PairCompletionOpRow {
  op: ReprGroundingDeriveTrait
  body: PairCompletionBody
}

fn pair_completion_factor(
  operand: PairCompletionOperand,
  component: PairCompletionComponent
) -> PairCompletionFactor {
  PairCompletionFactor { operand: operand, component: component }
}

fn pair_completion_op_rows() -> List<PairCompletionOpRow> {
  [
    PairCompletionOpRow {
      op: ReprDeriveNeg,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionNeg)]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionPos)]
            }
          ]
        }
      }
    },
    PairCompletionOpRow {
      op: ReprDeriveAdd,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionPos)]
            },
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionRhs, PairCompletionPos)]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionSelf, PairCompletionNeg)]
            },
            PairCompletionTerm {
              factors: [pair_completion_factor(PairCompletionRhs, PairCompletionNeg)]
            }
          ]
        }
      }
    },
    PairCompletionOpRow { op: ReprDeriveSub, body: PairCompletionNegatedAddend },
    PairCompletionOpRow {
      op: ReprDeriveMul,
      body: PairCompletionSumOfProducts {
        pos: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionPos),
                pair_completion_factor(PairCompletionRhs, PairCompletionPos)
              ]
            },
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionNeg),
                pair_completion_factor(PairCompletionRhs, PairCompletionNeg)
              ]
            }
          ]
        },
        neg: PairCompletionArm {
          terms: [
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionPos),
                pair_completion_factor(PairCompletionRhs, PairCompletionNeg)
              ]
            },
            PairCompletionTerm {
              factors: [
                pair_completion_factor(PairCompletionSelf, PairCompletionNeg),
                pair_completion_factor(PairCompletionRhs, PairCompletionPos)
              ]
            }
          ]
        }
      }
    },
    PairCompletionOpRow { op: ReprDeriveDiv, body: PairCompletionCanonicalQuotient }
  ]
}

fn pair_completion_arm_uses_rhs(arm: PairCompletionArm) -> Bool {
  arm.terms |> any(term => term.factors |> any(f => match f.operand { PairCompletionRhs => true  PairCompletionSelf => false }))
}

fn pair_completion_body_uses_rhs(body: PairCompletionBody) -> Bool {
  match body {
    PairCompletionSumOfProducts { pos: pos, neg: neg } =>
      pair_completion_arm_uses_rhs(pos) || pair_completion_arm_uses_rhs(neg)
    PairCompletionNegatedAddend => true
    PairCompletionCanonicalQuotient => true
  }
}

data repr_grounding_group_completion_carrier_note: String = "Interim carrier identity for capability-table selection of GroupCompletion pair-completion bodies (#7272 A1 / #7286 handoff). The struct trait surface is selected once via v1_emit_struct_from_capability_table (#[derive] attrs + KernelInt arithmetic impl bodies); the old v1_emit_struct_supplemental_impls door is deleted. The rename from supplemental_*_target is NOT the fix while selection is still name-match (module_path == \"std.algebra\" && name == \"GroupCompletion\") — see dissolve-on."

data repr_grounding_group_completion_carrier_trigger: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "std.algebra",
    decl_name: "Ring",
    field: WholeDeclaration
  }
}

fn repr_grounding_group_completion_carrier(module_path: String, name: String) -> Bool {
  module_path == "std.algebra" && name == "GroupCompletion"
}

fn repr_grounding_supplemental_bool_host_bridge_target(module_path: String, name: String) -> Bool {
  module_path == "std.types" && name == "Bool"
}

data pair_completion_shape_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "Dissolves when v2 derives these rows from the std.algebra Ring/AbelianGroup inhabitance witnesses directly, so the Grothendieck construction is read off the algebra rather than tabulated here; tracked by the numeric-tower grounding lane.")

data pair_completion_uses_rhs_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "dissolve-on: std.trait_derive_shape.pair_completion_arm_uses_rhs / pair_completion_body_uses_rhs — variant-discriminating Bool predicates over PairCompletionOperand / PairCompletionBody, retained only because operand arity is DERIVED from the formula rather than stored (storing an arity field would be a second representation of what the arms already say). They dissolve into an arity projection car")

data repr_grounding_bool_host_bridge_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "dissolve-on: repr_grounding_supplemental_bool_host_bridge_target / v1_emit_enum_supplemental_impls — Bool↔host-bool bridge door. Dissolves with the Value::Null-split / Bool True|False ↔ Value::Bool grounding lane (DESIGN open thread; gunbc.plans.value_null_split). Kept as the remaining half of the old supplemental door; do not ground the bridge in an emitter cleanup (§3).")

data repr_grounding_group_completion_carrier_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "dissolve-on: repr_grounding_group_completion_carrier — name-match module_path/name selection. Dissolves when capability selection for GroupCompletion pair-completion is derived from std.algebra Ring/AbelianGroup inhabitance witnesses (same terminal as pair_completion_shape_dissolve_on / numeric-tower grounding), so the carrier is identified by inhabitance rather than string equality. Terminal trig")

data trait_derive_shape_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "ReprGroundingDeriveTrait members that name Rust-specific authorities (ReprDeriveSerialize, ReprDeriveAdd, …) migrate beside each target's spelling table when a second consumer exists; until then capability roles stay in std/ with spellings in extdeps.languages.rust.emit.")
