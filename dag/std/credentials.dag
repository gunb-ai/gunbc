module std.credentials

import std.types { NonEmptyStr, String, Int, Bool, EpochMs }
import std.optional { Present, Absent }
import std.measure {
  ObservationInstant, ClockDomain, ProcessMonotonic, WallClock, Nanosecond, nanosecond, nanosecond_count,
}
import std.checked_arithmetic { CheckedInt, CheckedIntReady, CheckedIntOverflow, checked_int_add, checked_int_multiply, checked_int_to_nat }
import extdeps.time.rfc3339 {
  Rfc3339Instant, rfc3339_instant_nanoseconds_after, rfc3339_instant_of_unix,
}
import std.credential_refusal { ValidityUnestablishedCause, DeadlineArithmeticOverflow }
import extdeps.clock { clock_unix_millis_read, ClockUnixMillisObserved, ClockUnixMillisRefused }

type FactoryLogin {
  username: NonEmptyStr
  published_password: NonEmptyStr
}

type CredentialSource
  = EnvVar { name: String }

type CredentialFlow
  = Stored { secret_name: NonEmptyStr }
  | Chained { steps: List<CredentialFlow> }

// ── WHEN A CREDENTIAL MAY STILL BE PRESENTED ──────────────────────────────────────────────────
// CONFIDENTIALITY AND VALIDITY ARE TWO FACTS. std.types Secret is the first: the bytes are not read
// back into text. Whether those bytes still authenticate anyone is the second, and before this module
// every acquisition path in the tree answered it by dropping it -- generateAccessToken's expireTime,
// STS's expires_in and the installation token's expires_at were all decoded or available and then
// discarded, so a consumer could not tell a five-minute token minted nine minutes ago from a fresh
// one (heal-publish run 42261422824: issued 17:40:28 for 300 s, presented 17:49:20, 401
// ACCESS_TOKEN_EXPIRED). This is the carrier those facts now land in.
//
// CONSUMPTION (gunbc.design_argument::consumption). In this change the carrier is consumed by std.credential_admission
// credential_validity_decision and by the two provider acquisitions that build it
// (extdeps.cloud.gcp.iam acquire_impersonated_access, extdeps.github.app
// acquire_scoped_installation_token), executed through test.claim.credential_validity_witness. Those
// acquisitions have no production caller yet: that is a DECLARED FRONTIER, consumed by the transport
// dispatch admission (P2: the REST auth input becomes the credential and the transport admits it per
// dispatch attempt) and by heal publication's credential route (P3, stacked on gunbc#15929), whose
// landing is this frontier's trigger.
//
// THE DEADLINE LIVES ON THE PROCESS'S MONOTONIC CLOCK, NOT ON THE WALL. A provider states expiry in
// wall time; the acquisition reads BOTH clocks at the send, and the deadline is the monotonic send
// reading plus the provider's span. Admission then compares monotonic readings only, so a wall clock
// stepped backwards after acquisition cannot lengthen a credential's life within the process, and the
// reading the transport takes at dispatch needs no regression check of its own (CLOCK_MONOTONIC does
// not run backwards). What this does NOT cover is stated where it applies: provider/local wall skew at
// the instant of acquisition (the operation's declared skew margin), and any crossing of a process
// boundary (a monotonic origin is process-local, so a deadline read in another process is
// incomparable and refuses -- see ValidityUnestablished below).

// THE DOMAIN LABEL NAMES THE CLOCK, NOT THE PROCESS, and process-crossing is excluded another way: a
// CredentialDeadline has no wire encoder, so it cannot leave the process that read its monotonic
// origin, and a token that arrives in another process arrives as bare bytes (AcquiredOutsideThisProcess).
// Any future encoder of this carrier must carry a process identity in its domain first; that is its
// trigger, not an assumption this module makes.
//
// Both clocks, read at the request send. Sealed: the real reading is observe_acquisition_clock, and the
// only other mint is the declared fixture supplier of the credential witnesses (gunbc.design_argument::witness_one_interface, a
// witness supplies values at one interface), whose real-path pairing is the heal acquisition route.
type AcquisitionClockReading sole_constructor {
  send_monotonic: ObservationInstant
  send_wall: Rfc3339Instant
}

type AcquisitionClockRead
  = AcquisitionClockObserved { reading: AcquisitionClockReading }
  | AcquisitionClockUnread { detail: String }

data credential_clock_process: NonEmptyStr = "gunbc-credential-acquisition" as NonEmptyStr

fn credential_clock_domain() -> ClockDomain {
  ProcessMonotonic { process: credential_clock_process }
}

// THE CLOCK READS DECLARE THE CLOCK. A function with no `uses` is a pure call, and the interpreter's
// pure-call memo may serve a repeated call from its first answer (v1 eval_pure_named_call stores a
// call that dispatched no effect, and the monotonic builtin dispatches none). A memoized monotonic
// reading paired with a fresh wall reading makes a newly issued credential look already expired, so
// both reads declare std.resources Clock and never enter the memo.
//
// The monotonic reading is a non-negative count by construction of the realization; a negative one is
// not a reading, and refuses rather than being cast into one.
fn observe_credential_monotonic(label: String) -> ObservationInstant?
  uses clk: std.resources.Clock
{
  match checked_int_to_nat(n: observed_monotonic_nanos(label)) {
    Absent => none
    Present { value: n } => Present { value: ObservationInstant { domain: credential_clock_domain(), basis: WallClock, since_origin: nanosecond(count: n) } }
  }
}

// Both clocks in ONE function, so no unrestricted helper can pair a caller-supplied monotonic instant
// with a genuine wall reading: the only route to an AcquisitionClockReading is this read (and the
// declared fixture supplier).
fn observe_acquisition_clock(label: String) -> AcquisitionClockRead
  uses clk: std.resources.Clock
{
  match observe_credential_monotonic(label: concat(label, "-send-monotonic")) {
    Absent => AcquisitionClockUnread { detail: "the monotonic clock reading was negative, which is not a reading" }
    Present { value: mono } =>
      match clock_unix_millis_read() {
        ClockUnixMillisRefused { detail: d } => AcquisitionClockUnread { detail: d }
        ClockUnixMillisObserved { millis: ms } =>
          match rfc3339_instant_of_unix(unix_seconds: (ms as Int) / 1000, nanos: ((ms as Int) - ((ms as Int) / 1000) * 1000) * 1000000) {
            Absent => AcquisitionClockUnread { detail: "the wall clock reading did not form an instant" }
            Present { value: wall } => acquisition_clock_reading_of(send_monotonic: mono, send_wall: wall)
          }
      }
  }
}

fn acquisition_clock_reading_of(send_monotonic: ObservationInstant, send_wall: Rfc3339Instant) -> AcquisitionClockRead
  admit_callers: [
    decl_ref(module_path: "std.credentials", decl_name: "observe_acquisition_clock"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "fx_acquisition"),
    decl_ref(module_path: "test.claim.credential_validity_witness", decl_name: "fx_acquisition_on_this_clock"),
    decl_ref(module_path: "test.claim.credential_dispatch_probe", decl_name: "probe_credential"),
  ]
{
  AcquisitionClockObserved { reading: AcquisitionClockReading { send_monotonic: send_monotonic, send_wall: send_wall } }
}

// HOW THE DEADLINE WAS ESTABLISHED, kept beside it because a tag alone cannot say how a deadline was
// calculated. IssuerStated: the provider returned an absolute expiry (generateAccessToken expireTime,
// the installation token's expires_at). RelativeToSend: the provider returned a span (RFC 6749 section
// 5.1 expires_in, STS); the span is defined from response generation, so anchoring it at the request
// SEND reading starts the local interval earlier than the provider's and never grants lifetime spent in
// transit.
type ValidityBasis
  = IssuerStated { stated_expiry: Rfc3339Instant, acquisition: AcquisitionClockReading }
  | RelativeToSend { returned_span: Nanosecond, acquisition: AcquisitionClockReading }

// THE DEADLINE IS DERIVED, NEVER ASSIGNED: sealed, minted only by credential_validity_of from its basis,
// so the two cannot disagree.
type CredentialDeadline sole_constructor {
  basis: ValidityBasis
  usable_until: ObservationInstant
}

type CredentialValidity
  = UsableUntil { deadline: CredentialDeadline }
  | ValidityUnestablished { cause: ValidityUnestablishedCause }

// Sealed to its one caller: a deadline whose span and basis were supplied independently would be a
// deadline that disagrees with the basis it carries, which is the assignment this module refuses.
fn deadline_after(acquisition: AcquisitionClockReading, span_nanos: Int, basis: ValidityBasis) -> CredentialValidity
  admit_callers: [
    decl_ref(module_path: "std.credentials", decl_name: "credential_validity_of"),
  ]
{
  // A span that is already non-positive at the send is a credential that arrived expired; its
  // deadline is the send reading itself, which every admission refuses (the boundary is exclusive).
  let start = nanosecond_count(n: acquisition.send_monotonic.since_origin) as Int
  if span_nanos <= 0 {
    UsableUntil { deadline: CredentialDeadline { basis: basis, usable_until: acquisition.send_monotonic } }
  } else {
    match checked_int_add(a: start, b: span_nanos) {
      CheckedIntOverflow { cause: _ } => ValidityUnestablished { cause: DeadlineArithmeticOverflow }
      CheckedIntReady { value: until_int } =>
        match checked_int_to_nat(n: until_int) {
          Absent => ValidityUnestablished { cause: DeadlineArithmeticOverflow }
          Present { value: until } =>
        UsableUntil {
          deadline: CredentialDeadline {
            basis: basis,
            usable_until: ObservationInstant {
              domain: acquisition.send_monotonic.domain,
              basis: acquisition.send_monotonic.basis,
              since_origin: nanosecond(count: until),
            },
          }
        }
        }
    }
  }
}

fn credential_validity_of(basis: ValidityBasis) -> CredentialValidity {
  match basis {
    IssuerStated { stated_expiry: expiry, acquisition: acq } =>
      match rfc3339_instant_nanoseconds_after(later: expiry, earlier: acq.send_wall) {
        CheckedIntOverflow { cause: _ } => ValidityUnestablished { cause: DeadlineArithmeticOverflow }
        CheckedIntReady { value: span } => deadline_after(acquisition: acq, span_nanos: span, basis: basis)
      }
    RelativeToSend { returned_span: span, acquisition: acq } =>
      deadline_after(acquisition: acq, span_nanos: nanosecond_count(n: span) as Int, basis: basis)
  }
}

fn credential_deadline_basis(d: CredentialDeadline) -> ValidityBasis { d.basis }
fn credential_deadline_instant(d: CredentialDeadline) -> ObservationInstant { d.usable_until }

// WHAT ONE PRESENTATION NEEDS, declared by the OPERATION, not the provider. required_remaining is the
// life the request needs after dispatch (one request, never a whole job: a long job makes many admitted
// requests and renews between them). skew_margin covers provider/local wall disagreement at the
// acquisition instant; it is policy with a stated reason at its declaration, never a default here.
type CredentialUseRequirement {
  required_remaining: Nanosecond
  skew_margin: Nanosecond
}
