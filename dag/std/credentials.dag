module std.credentials


type FactoryLogin {
  username: std.types.NonEmptyStr
  published_password: std.types.NonEmptyStr
}

type CredentialSource
  = EnvVar { name: String }

type CredentialFlow
  = Stored { secret_name: std.types.NonEmptyStr }
  | Chained { steps: std.types.List<CredentialFlow> }
