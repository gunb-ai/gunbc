module std.roster_frontier

import std.keyed_row { KeyedRow }
import std.decl_ref {
  DeclarationRef,
  DeclField,
  WholeDeclaration,
  NamedField,
  decl_ref,
  decl_field_ref,
  declaration_ref_eq,
  declaration_ref_in_list,
}
import std.dissolution {
  DissolutionCondition,
  BoundDissolution,
  UnboundDissolution,
  DeclarationAppears,
  dissolution_trigger_ref,
  DissolutionUnbound,
  DissolutionPending,
  DissolutionFired,
  dissolution_status,
  bound_dissolution,
  unbound_dissolution,
}
import std.keyed_roster {
  KeyedRosterBuild,
  KeyedRosterBuilt,
  KeyedRosterBuildDuplicateKey,
  keyed_roster_build,
}
import std.types { NonEmptyStr }

data roster_frontier_note: String = "The typed declared-frontier row (DESIGN section 7 self-host-frontier pattern generalized to any group of units, operator ruling 2026-07-22): a row is admissible only as a counted carrier beside its subject, carrying reason and a typed expiry condition — never a bare string in a nickname list. subject anchors the annotated declaration (DeclSubject) or a path-keyed roster member (PathSubject); reason says why the row exists; dissolution is the std.dissolution.DissolutionCondition under which the row deletes, which is either bound to a declaration whose appearance is decidable against the tree or explicitly unbound and unable to fire. The group-grain taxonomy and enrolled roster registry live in gunbc.roster_registry; this module owns only the row shape so std-, lens-, and workflow-layer rosters share one carrier instead of re-minting it per file."

type FrontierSubject
  = PathSubject { path: String }
  | DeclSubject { ref: DeclarationRef }

data frontier_dissolution_carrier_note: String = "The row's expiry is std.dissolution.DissolutionCondition and nothing else. The deleted local DissolveTrigger was a second representation of the same concept, and its TriggerProse arm plus the caller-supplied prose_fired list that fold_frontier_expiry used to take let an uncheckable sentence report as fired whenever a caller happened to pass the same string back — the roster's own expiry check answering from the caller rather than from the tree. The prose population did not disappear with it: a condition that names no declaration is now UnboundDissolution, which is counted separately and provably cannot fire. The deleted frontier_row convenience constructor took a bare `dissolve_on: String` and is not replaced, because taking prose positionally is exactly what made the weak arm the default at 195 of 197 call sites."

type FrontierRow {
  subject: FrontierSubject
  reason: NonEmptyStr
  dissolution: DissolutionCondition
}

fn frontier_row_path(path: String, reason: String, dissolution: DissolutionCondition) -> FrontierRow {
  FrontierRow {
    subject: PathSubject { path: path },
    reason: reason as NonEmptyStr,
    dissolution: dissolution,
  }
}

fn frontier_row_decl(ref: DeclarationRef, reason: String, dissolution: DissolutionCondition) -> FrontierRow {
  FrontierRow {
    subject: DeclSubject { ref: ref },
    reason: reason as NonEmptyStr,
    dissolution: dissolution,
  }
}

fn frontier_row_well_formed(row: FrontierRow) -> Bool {
  !(row.reason as String == "")
    && match row.dissolution {
      BoundDissolution { trigger: t } =>
        !(dissolution_trigger_ref(trigger: t).module_path == "")
          && !(dissolution_trigger_ref(trigger: t).decl_name == "")
      UnboundDissolution { description: d } => !(d as String == "")
    }
    && match row.subject {
      PathSubject { path: p } => !(p == "")
      DeclSubject { ref: r } => !(r.module_path == "") && !(r.decl_name == "")
    }
}

fn frontier_rows_well_formed(rows: List<FrontierRow>) -> Bool {
  fold(rows, init: true, f: fn(acc, row) { acc && frontier_row_well_formed(row: row) })
}

fn declaration_ref_display_key(ref: DeclarationRef) -> String {
  match ref.field {
    WholeDeclaration =>
      concat(ref.module_path as String, concat("::", ref.decl_name as String))
    NamedField { field_name: f } =>
      concat(
        ref.module_path as String,
        concat("::", concat(ref.decl_name as String, concat("::", f as String))),
      )
  }
}

fn frontier_subject_eq(a: FrontierSubject, b: FrontierSubject) -> Bool {
  a == b
}

fn frontier_subject_key(subject: FrontierSubject) -> String {
  match subject {
    PathSubject { path: p } => p
    DeclSubject { ref: r } => declaration_ref_display_key(ref: r)
  }
}

fn frontier_rows_to_keyed_rows(rows: List<FrontierRow>) -> List<KeyedRow<FrontierSubject, FrontierRow>> {
  map(rows, row => KeyedRow { row_key: row.subject, value: row })
}

fn frontier_rows_keyed_roster_build(rows: List<FrontierRow>) -> KeyedRosterBuild<FrontierSubject, FrontierRow> {
  keyed_roster_build(
    incomings: frontier_rows_to_keyed_rows(rows: rows),
    key_eq: frontier_subject_eq,
  )
}

fn frontier_path_subjects(rows: List<FrontierRow>) -> List<String> {
  map(rows, row => frontier_subject_key(subject: row.subject))
}

fn frontier_units(rows: List<FrontierRow>) -> List<String> {
  frontier_path_subjects(rows: rows)
}

fn concat_frontier_row_groups(groups: List<List<FrontierRow>>) -> List<FrontierRow> {
  flat_map(groups, group => group)
}

data frontier_expiry_report_note: String = "Three counters, because the old two-counter report could not distinguish a row whose condition is checkable and has not yet fired from a row whose condition is not checkable at all — both landed in unfired_count, so the roster read as entirely pending when most of it was unmodelled. unbound_count IS the exact next frontier: it is the population that must climb by naming a declaration, and it is the number the closing claim reports rather than pretending it became checkable. Only fired_still_present_count reds — an unbound row is honest debt, not a defect, so gating on it would make naming a condition worse than leaving it prose."

type FrontierExpiryReport {
  unbound_count: Int
  pending_count: Int
  fired_still_present_count: Int
}

fn fold_frontier_expiry(
  rows: List<FrontierRow>,
  present_decls: List<DeclarationRef>,
) -> FrontierExpiryReport {
  fold(
    rows,
    init: FrontierExpiryReport { unbound_count: 0, pending_count: 0, fired_still_present_count: 0 },
    f: fn(acc, row) {
      match dissolution_status(condition: row.dissolution, present_decls: present_decls) {
        DissolutionUnbound =>
          FrontierExpiryReport {
            unbound_count: acc.unbound_count + 1,
            pending_count: acc.pending_count,
            fired_still_present_count: acc.fired_still_present_count,
          }
        DissolutionPending =>
          FrontierExpiryReport {
            unbound_count: acc.unbound_count,
            pending_count: acc.pending_count + 1,
            fired_still_present_count: acc.fired_still_present_count,
          }
        DissolutionFired =>
          FrontierExpiryReport {
            unbound_count: acc.unbound_count,
            pending_count: acc.pending_count,
            fired_still_present_count: acc.fired_still_present_count + 1,
          }
      }
    },
  )
}

fn frontier_expiry_clean(report: FrontierExpiryReport) -> Bool {
  report.fired_still_present_count == 0
}
