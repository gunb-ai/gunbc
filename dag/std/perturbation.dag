module std.perturbation

import std.types { String, Bool }

data perturbation_kernel_doc: String = "The shared perturbation-response kernel: ONE carrier read in two directions (DESIGN section 2 horizontal -- one concept, every breadth; DESIGN section 4 -- one procedure read in two directions, exactly like ingest/emit being one grammar read forward and backward). A declared input->output relation is probed by perturbing one axis (all else held fixed) and observing whether the observable output RESPONDED. The single fact the kernel owns is the POLARITY of violation per reading -- it is the one place that knows forward-responded-is-bad / backward-silent-is-bad, so no consumer re-encodes the direction (DESIGN section 3 single authority). Two readings: (forward / cache-purity) perturb an axis OUTSIDE the declared inputs, expect NO response -- a response means the output depends on something outside its declared key (impure); consumed by extdeps.realization.cache_purity. (backward / wiring-liveness) perturb a DECLARED input, expect a response -- silence means the output depends on LESS than its declared inputs (a dead wire); consumed by v2.lens.wiring_liveness (+ its corpus and preflight readers). The two influence ORACLES that feed output_responded stay deliberately separate per reading (DESIGN section 5 decidability split): static reachability over the dependence graph (wiring's compile-time wall) vs warm-vs-cold digest comparison (purity's runtime witness). Only the verdict polarity is shared; the influence detector is not, because the wall and the witness are decidably-different mechanisms. Dissolves the pre-existing fork in which wiring_liveness and cache_purity each carried their own wired/pure boolean -- two representations of one perturbation principle (gunbc wiring-liveness-preflight plan, delete-when condition (a))."

type PerturbationReading
  = ForwardSameInSameOut
  | BackwardDiffInDiffOut

type PerturbationVerdict
  = ResponseConsistent
  | ResponseViolation

fn perturbation_verdict(reading: PerturbationReading, output_responded: Bool) -> PerturbationVerdict {
  match reading {
    ForwardSameInSameOut =>
      if output_responded { ResponseViolation } else { ResponseConsistent }
    BackwardDiffInDiffOut =>
      if output_responded { ResponseConsistent } else { ResponseViolation }
  }
}

fn perturbation_is_violation(reading: PerturbationReading, output_responded: Bool) -> Bool {
  match perturbation_verdict(reading: reading, output_responded: output_responded) {
    ResponseViolation => true
    ResponseConsistent => false
  }
}

fn perturbation_consistent(reading: PerturbationReading, output_responded: Bool) -> Bool {
  match perturbation_verdict(reading: reading, output_responded: output_responded) {
    ResponseConsistent => true
    ResponseViolation => false
  }
}
