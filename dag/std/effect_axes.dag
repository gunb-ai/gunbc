module std.effect_axes


data effect_axes_note: String = "P-C derived axes (docs/plans/effect-namespace-grants.md lines 27-30, 62, owned silent-ibex-417): the OLD execution-mode axes are PROJECTIONS over the std.effect_grant Envelope, not stamped bits (dissolving derived_projections_deferred_note in effect_grant). replayable = every Read grant content-addressed (SubstrateClosure region) or Replay-bound; isolated = every Write grant root a FrameScratch region; live_tree_intersects = any Read grant that reaches the RepoTree region for real (RealTransport). Region is DERIVED from the grant root position via canonical region roots + position_under -- the SAME containment relation admit_effect walks -- never a stamped marker (DESIGN 3/4). Two fail-closed choices (DESIGN 5): (a) an UnclassifiedRegion read is ASSUMED to intersect the live tree -- retiring the machine-stamped-FALSE class that let #6654's orphan wall get skipped (design line 29); (b) live_tree_intersects is BINDING-AWARE -- a Replay-bound read is served from a fixture, not live state, so it never intersects, which is what keeps 'replayable => SubstrateInputsOnly' consistent (a Replay-bound RepoTree read is replayable per line 27, so it must NOT also read the live tree). INTERIM: canonical roots are path-prefix positions (the NamespacePosition interim, effect_grant namespace_tree_note); the scattered real roots (v2.compiler.build_transport_admission closure/workspace, std.artifact_store_scratch_grant tmp, std.filesystem_path_grant repo) consume these as their single authority at migration. FrameScratch is 'under the canonical scratch root'; the per-frame OWNERSHIP refinement (design 'owned by the frame') is a declared stub. dissolve-on = SymbolIndex-backed positions supersede the path-prefix regions AND the real-envelope roots repoint here; the Hermetic|Wet|Record presets (v2.std.execution_envelope) delete when that enum retires."

type EffectRegion
  = SubstrateClosure
  | RepoTree
  | FrameScratch
  | UnclassifiedRegion

data region_substrate_closure_root: NamespacePosition = filesystem_position(path: ["closure"])
data region_repo_root: NamespacePosition = filesystem_position(path: ["repo"])
data region_frame_scratch_root: NamespacePosition = filesystem_position(path: ["scratch"])

fn classify_region(root: NamespacePosition) -> EffectRegion {
  if position_under(target: root, root: region_substrate_closure_root) {
    SubstrateClosure
  } else if position_under(target: root, root: region_repo_root) {
    RepoTree
  } else if position_under(target: root, root: region_frame_scratch_root) {
    FrameScratch
  } else {
    UnclassifiedRegion
  }
}

fn read_grant_replayable(g: Grant) -> Bool {
  match g.binding {
    Replay { fixture_store: s } => true
    RealTransport =>
      match classify_region(root: g.root) {
        SubstrateClosure => true
        RepoTree => false
        FrameScratch => false
        UnclassifiedRegion => false
      }
  }
}

fn write_grant_isolated(g: Grant) -> Bool {
  match classify_region(root: g.root) {
    FrameScratch => true
    SubstrateClosure => false
    RepoTree => false
    UnclassifiedRegion => false
  }
}

fn read_grant_intersects_live_tree(g: Grant) -> Bool {
  match g.binding {
    Replay { fixture_store: s } => false
    RealTransport =>
      match classify_region(root: g.root) {
        RepoTree => true
        UnclassifiedRegion => true
        SubstrateClosure => false
        FrameScratch => false
      }
  }
}

fn grants_all_read_replayable(grants: List<Grant>) -> Bool {
  if grants.count() == 0 {
    true
  } else {
    let g = grants.first()
    let rest = grants.skip(n: 1)
    if verb_eq(a: g.verb, b: Read) {
      read_grant_replayable(g: g) && grants_all_read_replayable(grants: rest)
    } else {
      grants_all_read_replayable(grants: rest)
    }
  }
}

fn grants_all_write_isolated(grants: List<Grant>) -> Bool {
  if grants.count() == 0 {
    true
  } else {
    let g = grants.first()
    let rest = grants.skip(n: 1)
    if verb_eq(a: g.verb, b: Write) {
      write_grant_isolated(g: g) && grants_all_write_isolated(grants: rest)
    } else {
      grants_all_write_isolated(grants: rest)
    }
  }
}

fn grants_any_read_intersects_live_tree(grants: List<Grant>) -> Bool {
  if grants.count() == 0 {
    false
  } else {
    let g = grants.first()
    let rest = grants.skip(n: 1)
    if verb_eq(a: g.verb, b: Read) {
      read_grant_intersects_live_tree(g: g) || grants_any_read_intersects_live_tree(grants: rest)
    } else {
      grants_any_read_intersects_live_tree(grants: rest)
    }
  }
}

fn envelope_replayable(env: Envelope) -> Bool {
  grants_all_read_replayable(grants: env.grants)
}

fn envelope_isolated(env: Envelope) -> Bool {
  grants_all_write_isolated(grants: env.grants)
}

fn envelope_live_tree_intersects(env: Envelope) -> Bool {
  grants_any_read_intersects_live_tree(grants: env.grants)
}
