module std.access

import std.types { String }
import std.measure { ObservationInstant, ClockDomain, Nanosecond }
import std.credentials { ValidityUnestablishedCause, BindingRefusal }

// The one authorization decision kernel. Domain-specific authorization surfaces are typed request profiles projected into AccessRequest; they do not mint a second admitted/refused sum. Context and evidence stay distinct because ambient circumstances are not proof, and proof is not the circumstance it supports. A denial always carries a typed cause at structured request coordinates: the former optional reason made an unlocated bare deny writable. AccessPolicy is the sole policy-to-decision seam and decision_meet is the sole conjunction over decisions.
type AccessContext<C> {
  value: C
}

type AccessEvidence<E> {
  value: E
}

type AccessRequest<S, A, O, C, E> {
  subject: S
  action: A
  object: O
  context: AccessContext<C>
  evidence: AccessEvidence<E>
}

type AccessRefusalCause
  = AccessContextAbsent { context: String }
  | AccessEvidenceAbsent { evidence: String }
  | AccessEvidenceRejected { evidence: String, reason: String }
  | AccessSubjectNotRecognized { subject: String }
  | AccessActionNotGranted { action: String }
  | AccessObjectNotGranted { object: String }
  | AccessPolicyRefused { reason: String }
  | AccessEvidenceStale {
      evidence: String
      observed_at: ObservationInstant
      usable_until: ObservationInstant
      required_remaining: Nanosecond
      skew_margin: Nanosecond
    }
  | AccessEvidenceValidityUnestablished { evidence: String, cause: ValidityUnestablishedCause }
  | AccessEvidenceClockIncomparable { evidence: String, held: ClockDomain, observed: ClockDomain }
  | AccessEvidenceBindingRefused { evidence: String, cause: BindingRefusal }

type AccessRefusalLocation {
  profile: String
  subject: String
  action: String
  object: String
}

type AccessRefusal {
  cause: AccessRefusalCause
  location: AccessRefusalLocation
}

type AccessDecision
  = Permit
  | Deny { refusal: AccessRefusal }

fn access_policy_refusal(
  profile: String,
  subject: String,
  action: String,
  object: String,
  reason: String,
) -> AccessDecision {
  Deny {
    refusal: AccessRefusal {
      cause: AccessPolicyRefused { reason: reason },
      location: AccessRefusalLocation {
        profile: profile,
        subject: subject,
        action: action,
        object: object,
      },
    }
  }
}

fn access_refusal_reason(refusal: AccessRefusal) -> String {
  match refusal.cause {
    AccessContextAbsent { context: context } => context
    AccessEvidenceAbsent { evidence: evidence } => evidence
    AccessEvidenceRejected { evidence: evidence, reason: reason } => reason
    AccessSubjectNotRecognized { subject: subject } => subject
    AccessActionNotGranted { action: action } => action
    AccessObjectNotGranted { object: object } => object
    AccessPolicyRefused { reason: reason } => reason
    AccessEvidenceStale { evidence: evidence, observed_at: _, usable_until: _, required_remaining: _, skew_margin: _ } =>
      concat(evidence, " is not usable for the remaining lifetime this request requires")
    AccessEvidenceValidityUnestablished { evidence: evidence, cause: _ } =>
      concat(evidence, " has no established validity, so it cannot be presented to a request that requires remaining lifetime")
    AccessEvidenceClockIncomparable { evidence: evidence, held: _, observed: _ } =>
      concat(evidence, " was established on a clock this observation cannot be ordered against")
    AccessEvidenceBindingRefused { evidence: evidence, cause: _ } =>
      concat(evidence, " is not bound to what this request requires")
  }
}

fn decision_meet(a: AccessDecision, b: AccessDecision) -> AccessDecision {
  match a {
    Deny { refusal: refusal } => Deny { refusal: refusal }
    Permit => b
  }
}

type AccessPolicy<S, A, O, C, E> {
  decide: fn(AccessRequest<S, A, O, C, E>) -> AccessDecision
}
