module std.access


// The one authorization decision kernel. Domain-specific authorization surfaces are typed request profiles projected into AccessRequest; they do not mint a second admitted/refused sum. Context and evidence stay distinct because ambient circumstances are not proof, and proof is not the circumstance it supports. A denial always carries a typed cause at structured request coordinates: the former optional reason made an unlocated bare deny writable. AccessPolicy is the sole policy-to-decision seam and decision_meet is the sole conjunction over decisions.
type AccessContext<C> {
  value: C
}

type AccessEvidence<E> {
  value: E
}

type AccessRequest<S, A, O, C, E> {
  subject: S
  action: A
  object: O
  context: std.access.AccessContext<C>
  evidence: std.access.AccessEvidence<E>
}

type AccessRefusalCause
  = AccessContextAbsent { context: String }
  | AccessEvidenceAbsent { evidence: String }
  | AccessEvidenceRejected { evidence: String, reason: String }
  | AccessSubjectNotRecognized { subject: String }
  | AccessActionNotGranted { action: String }
  | AccessObjectNotGranted { object: String }
  | AccessPolicyRefused { reason: String }

type AccessRefusalLocation {
  profile: String
  subject: String
  action: String
  object: String
}

type AccessRefusal {
  cause: std.access.AccessRefusalCause
  location: std.access.AccessRefusalLocation
}

type AccessDecision
  = Permit
  | Deny { refusal: std.access.AccessRefusal }

fn access_policy_refusal(
  profile: String,
  subject: String,
  action: String,
  object: String,
  reason: String,
) -> std.access.AccessDecision {
  Deny {
    refusal: std.access.AccessRefusal {
      cause: AccessPolicyRefused { reason: reason },
      location: std.access.AccessRefusalLocation {
        profile: profile,
        subject: subject,
        action: action,
        object: object,
      },
    }
  }
}

fn access_refusal_reason(refusal: std.access.AccessRefusal) -> String {
  match refusal.cause {
    AccessContextAbsent { context: context } => context
    AccessEvidenceAbsent { evidence: evidence } => evidence
    AccessEvidenceRejected { evidence: evidence, reason: reason } => reason
    AccessSubjectNotRecognized { subject: subject } => subject
    AccessActionNotGranted { action: action } => action
    AccessObjectNotGranted { object: object } => object
    AccessPolicyRefused { reason: reason } => reason
  }
}

fn decision_meet(a: std.access.AccessDecision, b: std.access.AccessDecision) -> std.access.AccessDecision {
  match a {
    Deny { refusal: refusal } => Deny { refusal: refusal }
    Permit => b
  }
}

type AccessPolicy<S, A, O, C, E> {
  decide: fn(std.access.AccessRequest<S, A, O, C, E>) -> std.access.AccessDecision
}
