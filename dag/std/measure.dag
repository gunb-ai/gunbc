}

fn rpm_count(r: RevolutionsPerMinute) -> Nat {
  measure_count(r)
}

type MoneyAmount<S> = Measure<Currency, S, Nat>

type MoneyAmountMicro = MoneyAmount<Micro>

fn money_amount_micro(count: Nat) -> MoneyAmountMicro {
  MoneyAmountMicro { count: count }
}

fn money_amount_micro_count(m: MoneyAmountMicro) -> Nat {
  measure_count(m)
}

fn byte_size(count: Nat) -> ByteSize {
  ByteSize { count: count }
}

fn byte_size_count(b: ByteSize) -> Nat {
  measure_count(b)
}

fn bit_width(count: Nat) -> BitWidth {
  BitWidth { count: count }
}

fn bit_width_count(b: BitWidth) -> Nat {
  measure_count(b)
}

fn hertz(count: Nat) -> Hertz {
  Hertz { count: count }
}

fn hertz_count(h: Hertz) -> Nat {
  measure_count(h)
}

fn hardware_thread_count(count: Nat) -> HardwareThreadCount {
  HardwareThreadCount { count: count }
}

fn hardware_thread_count_value(t: HardwareThreadCount) -> Nat {
  measure_count(t)
}

fn millicore(count: Nat) -> Millicore {
  Millicore { count: count }
}

fn millicore_count(m: Millicore) -> Nat {
  measure_count(m)
}

type Bandwidth = Measure<DataRate, One, Nat>

fn bandwidth(count: Nat) -> Bandwidth {
  Bandwidth { count: count }
}

fn bandwidth_count(b: Bandwidth) -> Nat {
  measure_count(b)
}

type Nanosecond = Measure<Time, Nano, Nat>

fn nanosecond(count: Nat) -> Nanosecond {
  Nanosecond { count: count }
}

fn nanosecond_count(n: Nanosecond) -> Nat {
  measure_count(n)
}

type Microsecond = Measure<Time, Micro, Nat>

fn microsecond(count: Nat) -> Microsecond {
  Microsecond { count: count }
}

fn microsecond_count(m: Microsecond) -> Nat {
  measure_count(m)
}

type Millisecond = Measure<Time, Milli, Nat>

fn millisecond(count: Nat) -> Millisecond {
  Millisecond { count: count }
}

fn millisecond_count(m: Millisecond) -> Nat {
  measure_count(m)
