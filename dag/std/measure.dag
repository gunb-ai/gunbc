module std.measure

import std.currency { CurrencyCode }
import std.nat { Nat }
import std.types { Int }

type Quantity =
    Time
  | Length
  | Mass
  | Memory
  | Information
  | DataRate
  | Frequency
  | Count
  | Currency

  | Power

  | Energy

  | Temperature

  | RotationalSpeed

  | ElectricPotential
  | ElectricCurrent
  | Resistance
  | Capacitance
  | Inductance
  | ElectricCharge
  | MagneticFlux

  | Dimensionless

type Scale =
    Atto
  | Femto
  | Pico
  | Nano
  | Micro
  | Milli
  | One
  | Sixty
  | Kilo
  | Mega
  | Giga
  | Tera
  | Peta
  | Exa

  | Kibi
  | Mebi
  | Gibi
  | Tebi

fn scale_exponent(s: Scale) -> Int? {
  match s {
    Atto  => Present { value: -18 }
    Femto => Present { value: -15 }
    Pico  => Present { value: -12 }
    Nano  =>  Present { value:  -9 }
    Micro =>  Present { value:  -6 }
    Milli =>  Present { value:  -3 }
    One   =>  Present { value:   0 }
    Sixty =>  none
    Kilo  =>  Present { value:   3 }
    Mega  =>  Present { value:   6 }
    Giga  =>  Present { value:   9 }
    Tera  =>  Present { value:  12 }
    Peta  =>  Present { value:  15 }
    Exa   =>  Present { value:  18 }
    Kibi  =>  Present { value:  10 }
    Mebi  =>  Present { value:  20 }
    Gibi  =>  Present { value:  30 }
    Tebi  =>  Present { value:  40 }
  }
}

fn gibibyte_scale_factor_bytes() -> Nat {
  1073741824
}

fn kibi_factor() -> Nat {
  1024
}

fn milliseconds_per_second() -> Nat {
  1000
}

fn seconds_per_minute() -> Nat {
  60
}

fn minutes_per_hour() -> Nat {
  60
}

fn time_scale_factor_seconds(s: Scale) -> Nat? {
  match s {
    One => Present { value: 1 }
    Sixty => Present { value: seconds_per_minute() }
    Atto  => none
    Femto => none
    Pico  => none
    Nano  => none
    Micro => none
    Milli => none
    Kilo  => none
    Mega  => none
    Giga  => none
    Tera  => none
    Peta  => none
    Exa   => none
    Kibi  => none
    Mebi  => none
    Gibi  => none
    Tebi  => none
  }
}

fn memory_scale_factor_bytes(s: Scale) -> Nat? {
  match s {
    One  => Present { value: 1 }
    Kibi => Present { value: kibi_factor() }
    Mebi => Present { value: kibi_factor() * kibi_factor() }
    Gibi => Present { value: gibibyte_scale_factor_bytes() }
    Tebi => Present { value: gibibyte_scale_factor_bytes() * kibi_factor() }
    Atto  => none
    Femto => none
    Pico  => none
    Nano  => none
    Micro => none
    Milli => none
    Sixty => none
    Kilo  => none
    Mega  => none
    Giga  => none
    Tera  => none
    Peta  => none
    Exa   => none
  }
}

type Measure<Q, S, M> {
  count: M
}

fn measure_count<Q, S, M>(m: Measure<Q, S, M>) -> M {
  m.count
}

fn measure_scale_fraction_floor<Q, S>(m: Measure<Q, S, Nat>, num: Nat, den: Nat) -> Measure<Q, S, Nat> {

  Measure { count: if den == 0 { den } else { (m.count * num) / den } }
}

fn measure_fit_count_floor<Q, S>(capacity: Measure<Q, S, Nat>, each: Measure<Q, S, Nat>) -> Nat {

  let each_count = each.count
  if each_count == 0 { each_count } else { capacity.count / each_count }
}

fn measure_scale_fraction_ceil<Q, S>(m: Measure<Q, S, Nat>, num: Nat, den: Nat) -> Measure<Q, S, Nat> {

  Measure { count: if den == 0 { m.count * num } else { ((m.count * num) + (den - 1)) / den } }
}

fn measure_add<Q, S>(a: Measure<Q, S, Nat>, b: Measure<Q, S, Nat>) -> Measure<Q, S, Nat> {
  Measure { count: a.count + b.count }
}

fn measure_le<Q, S>(a: Measure<Q, S, Nat>, b: Measure<Q, S, Nat>) -> Bool {
  a.count <= b.count
}

fn time_measure<S>(count: Nat) -> Measure<Time, S, Nat> {
  Measure { count: count }
}

type ByteSize = Measure<Memory, One, Nat>

type Kibibyte = Measure<Memory, Kibi, Nat>

type Mebibyte = Measure<Memory, Mebi, Nat>

type Gibibyte = Measure<Memory, Gibi, Nat>

fn mebibyte(count: Nat) -> Mebibyte {
  Mebibyte { count: count }
}

fn mebibyte_count(m: Mebibyte) -> Nat {
  measure_count(m)
}

fn gibibyte(count: Nat) -> Gibibyte {
  Gibibyte { count: count }
}

fn gibibyte_count(g: Gibibyte) -> Nat {
  measure_count(g)
}

fn gibibyte_to_byte_size(g: Gibibyte) -> ByteSize {
  byte_size(count: gibibyte_count(g) * gibibyte_scale_factor_bytes())
}

type BitWidth = Measure<Information, One, Nat>

fn bits_per_byte() -> Nat {
  8
}

type Hertz = Measure<Frequency, One, Nat>

type HardwareThreadCount = Measure<Count, One, Nat>

type Millicore = Measure<Count, Milli, Nat>

type Watt = Measure<Power, One, Nat>

type Joule = Measure<Energy, One, Nat>

type Celsius = Measure<Temperature, One, Int>

type RevolutionsPerMinute = Measure<RotationalSpeed, One, Nat>

fn watt(count: Nat) -> Watt {
  Watt { count: count }
}

fn watt_count(w: Watt) -> Nat {
  measure_count(w)
}

fn joule(count: Nat) -> Joule {
  Joule { count: count }
}

fn joule_count(j: Joule) -> Nat {
  measure_count(j)
}

fn celsius(count: Int) -> Celsius {
  Celsius { count: count }
}

fn celsius_count(c: Celsius) -> Int {
  measure_count(c)
}

fn rpm(count: Nat) -> RevolutionsPerMinute {
  RevolutionsPerMinute { count: count }
}

fn rpm_count(r: RevolutionsPerMinute) -> Nat {
  measure_count(r)
}

type MoneyAmount<S> = Measure<Currency, S, Nat>

type MoneyAmountMicro = MoneyAmount<Micro>

fn money_amount_micro(count: Nat) -> MoneyAmountMicro {
  MoneyAmountMicro { count: count }
}

fn money_amount_micro_count(m: MoneyAmountMicro) -> Nat {
  measure_count(m)
}

data money_rate_billing_unit_note: String = "Billing unit is part of the fact: per-minute, per-hour, and per-month are distinct carriers — never folded into a bare amount with the unit in the field name. Cross-vendor normalization is a derived projection at read time, never a stored catalog field."

type PerMinute

type PerHour

type PerMonth

type Once

type MoneyRate<P> {
  amount: MoneyAmountMicro
  currency: CurrencyCode
}

type MoneyPerMinute = MoneyRate<PerMinute>

type MoneyPerHour = MoneyRate<PerHour>

type MoneyPerMonth = MoneyRate<PerMonth>

type MoneyOnce = MoneyRate<Once>

data money_rate_carrier_representation_note: String = "MoneyRate<P> is the §2-horizontal carrier for vendor billing period: one parameterized record (P = PerMinute | PerHour | PerMonth | Once phantom markers), not four structurally-identical records — same move as MoneyAmount<S> = Measure<Currency, S, Nat> and Vendor<Domain>. Not a Measure<Q,S,M> row: billing period is a categorical vendor unit axis, not an SI Scale on a single Quantity; the carrier also holds runtime CurrencyCode beside the micro-denominated amount. Passing PerMinute where PerHour is expected is unwritable via the type argument."

fn money_rate_micros<P>(q: MoneyRate<P>) -> Nat {
  money_amount_micro_count(m: q.amount)
}

fn money_per_minute_micros(q: MoneyPerMinute) -> Nat {
  money_rate_micros(q: q)
}

fn money_per_hour_micros(q: MoneyPerHour) -> Nat {
  money_rate_micros(q: q)
}

fn money_per_month_micros(q: MoneyPerMonth) -> Nat {
  money_rate_micros(q: q)
}

fn money_once_micros(q: MoneyOnce) -> Nat {
  money_rate_micros(q: q)
}

fn per_hour_equivalent_from_per_minute(q: MoneyPerMinute) -> MoneyPerHour {
  MoneyPerHour {
    amount: money_amount_micro(count: money_per_minute_micros(q: q) * minutes_per_hour()),
    currency: q.currency,
  }
}

fn billing_month_as_hour_count() -> Nat {
  730
}

data billing_month_as_hour_count_note: String = "Derived monthly→hourly divisor: 730 hours (365×24/12), the conventional cloud billing month used for cross-vendor hourly equivalence only — not a vendor quote."

data billing_month_as_hour_count_representation_note: String = "Nat divisor via fn not Measure<Time, One, Nat>: stage0 alias emission collapses applied-generic Measure aliases to concrete Measure<(), (), Nat> while fn/data return sites still reference the un-erased alias params (E0107). Dissolve-on: stage0 Measure-alias emitter preserves return types at data/fn sites."

fn per_hour_equivalent_from_per_month(q: MoneyPerMonth) -> MoneyPerHour {
  MoneyPerHour {
    amount: money_amount_micro(count: money_per_month_micros(q: q) / billing_month_as_hour_count()),
    currency: q.currency,
  }
}

