}

fn energy_from_power_and_time(power: Watt, time: Second) -> Joule {
  joule(watt_count(w: power) * second_count(s: time))
}

fn volt_ampere(count: std.nat.Nat) -> VoltAmpere {
  Measure { count: count }
}

fn volt_ampere_count(v: VoltAmpere) -> std.nat.Nat {
  measure_count(v)
}

// The product of a supply's nominal voltage and its rated current, which is what a supply is rated
// in. It deliberately produces apparent power rather than Watt: the datasheet figures multiply to
// volt-amperes and to nothing else.
fn apparent_power_from_supply(supply_voltage: Volt, rated_current: Ampere) -> VoltAmpere {
  volt_ampere(volt_count(v: supply_voltage) * ampere_count(a: rated_current))
}

