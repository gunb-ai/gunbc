type Millisecond = Measure<Time, Milli, std.nat.Nat>

fn millisecond(count: std.nat.Nat) -> Millisecond {
  Measure { count: count }
}

fn millisecond_count(m: Millisecond) -> std.nat.Nat {
  measure_count(m)
}

type PositiveMillisecond
  = PositiveMillisecondValue { count: PositiveMeasureCount }

fn positive_millisecond(count: PositiveMeasureCount) -> PositiveMillisecond {
  PositiveMillisecondValue { count: count }
}

fn positive_millisecond_count(m: PositiveMillisecond) -> Int {
  match m {
    PositiveMillisecondValue { count: count } =>
      positive_measure_count_value(count: count)
  }
}

fn nanoseconds_per_millisecond() -> std.nat.Nat {
  1000000
}

fn millisecond_to_nanosecond(m: Millisecond) -> Nanosecond {
  nanosecond(count: millisecond_count(m: m) * nanoseconds_per_millisecond())
}

fn nanosecond_to_millisecond_floor(n: Nanosecond) -> Millisecond {
  millisecond(count: nanosecond_count(n: n) / nanoseconds_per_millisecond())
}

data nanosecond_millisecond_projection_note: String = "Nanosecond is the canonical exact elapsed-time carrier. Millisecond remains a policy and presentation scale. Converting Millisecond to Nanosecond is exact; converting Nanosecond to Millisecond is explicitly floor-only and may be used only at a named presentation, wire, or signed-policy boundary. Measurement, ordering, joining, and attribution must retain Nanosecond."

