module std.measure

type Quantity =
    Time
  | Length
  | Mass
  | Memory
  | Information
  | DataRate
  | Frequency
  | Count
  | Currency

  | Power

  | ApparentPower

  | Energy

  | Temperature
  | TemperatureDifference

  | RotationalSpeed

  | ElectricPotential
  | ElectricPotentialDifference
  | ElectricCurrent
  | Resistance
  | Capacitance
  | Inductance
  | ElectricCharge
  | MagneticFlux

  | Area
  | Volume
  | PlaneAngle

  | Dimensionless

type Scale =
    Atto
  | Femto
  | Pico
  | Nano
  | Micro
  | Milli
  | One
  | Sixty
  | RackUnitHeight
  | SquareFootArea

  | ArcsecondAngle
  | DegreeAngle
  | TurnAngle
  | Kilo
  | Mega
  | Giga
  | Tera
  | Peta
  | Exa

  | Kibi
  | Mebi
  | Gibi
  | Tebi

fn scale_exponent(s: Scale) -> Int? {
  match s {
    Atto  => Present { value: -18 }
    Femto => Present { value: -15 }
    Pico  => Present { value: -12 }
    Nano  =>  Present { value:  -9 }
    Micro =>  Present { value:  -6 }
    Milli =>  Present { value:  -3 }
    One   =>  Present { value:   0 }
    ArcsecondAngle => none
    DegreeAngle    => none
    TurnAngle      => none
    Sixty =>  none
    RackUnitHeight => none
    SquareFootArea => none
    Kilo  =>  Present { value:   3 }
    Mega  =>  Present { value:   6 }
    Giga  =>  Present { value:   9 }
    Tera  =>  Present { value:  12 }
    Peta  =>  Present { value:  15 }
    Exa   =>  Present { value:  18 }
    Kibi  =>  Present { value:  10 }
    Mebi  =>  Present { value:  20 }
    Gibi  =>  Present { value:  30 }
    Tebi  =>  Present { value:  40 }
  }
}

fn gibibyte_scale_factor_bytes() -> std.nat.Nat {
  let k = kibi_factor()
  k * k * k
}

fn kibi_factor() -> std.nat.Nat {
  iec_kibi_factor()
}

fn seconds_per_minute() -> std.nat.Nat {
  iso8601_seconds_per_minute()
}

fn minutes_per_hour() -> std.nat.Nat {
  iso8601_minutes_per_hour()
}

fn hours_per_day() -> std.nat.Nat {
  iso8601_hours_per_day()
}

fn seconds_per_day() -> std.nat.Nat {
  hours_per_day() * minutes_per_hour() * seconds_per_minute()
}

fn milliseconds_per_second() -> std.nat.Nat {
  milli_per_unit()
}

// The decimal scale factors, declared once beside kibi_factor for the same
// reason: a consumer writing * 1000000 to turn megatransfers into transfers is
// re-stating the Mega scale the Scale coproduct above already carries.
fn milli_per_unit() -> std.nat.Nat {
  1000
}

fn mega_factor() -> std.nat.Nat {
  1000 * 1000
}

fn time_scale_factor_seconds(s: Scale) -> std.nat.Nat? {
  match s {
    One => Present { value: 1 }
    ArcsecondAngle => none
    DegreeAngle => none
    TurnAngle => none
    Sixty => Present { value: seconds_per_minute() }
    RackUnitHeight => none
    SquareFootArea => none
    Atto  => none
    Femto => none
    Pico  => none
    Nano  => none
    Micro => none
    Milli => none
    Kilo  => none
    Mega  => none
    Giga  => none
    Tera  => none
    Peta  => none
    Exa   => none
    Kibi  => none
    Mebi  => none
    Gibi  => none
    Tebi  => none
  }
}

fn memory_scale_factor_bytes(s: Scale) -> std.nat.Nat? {
  match s {
    One  => Present { value: 1 }
    Kibi => Present { value: kibi_factor() }
    Mebi => Present { value: kibi_factor() * kibi_factor() }
    Gibi => Present { value: gibibyte_scale_factor_bytes() }
    Tebi => Present { value: gibibyte_scale_factor_bytes() * kibi_factor() }
    Atto  => none
    Femto => none
    Pico  => none
    Nano  => none
    Micro => none
    Milli => none
    ArcsecondAngle => none
    DegreeAngle => none
    TurnAngle => none
    Sixty => none
    RackUnitHeight => none
    SquareFootArea => none
    Kilo  => none
    Mega  => none
    Giga  => none
    Tera  => none
    Peta  => none
    Exa   => none
  }
}

type Measure<Q, S, M> {
  count: M
}

fn measure_count<Q, S, M>(m: Measure<Q, S, M>) -> M {
  m.count
}

fn measure_scale_fraction_floor<Q, S>(m: Measure<Q, S, std.nat.Nat>, num: std.nat.Nat, den: std.nat.Nat) -> Measure<Q, S, std.nat.Nat> {

  Measure { count: if den == 0 { den } else { (m.count * num) / den } }
}

fn measure_fit_count_floor<Q, S>(capacity: Measure<Q, S, std.nat.Nat>, each: Measure<Q, S, std.nat.Nat>) -> std.nat.Nat {

  let each_count = each.count
  if each_count == 0 { each_count } else { capacity.count / each_count }
}

fn measure_scale_fraction_ceil<Q, S>(m: Measure<Q, S, std.nat.Nat>, num: std.nat.Nat, den: std.nat.Nat) -> Measure<Q, S, std.nat.Nat> {

  Measure { count: if den == 0 { m.count * num } else { ((m.count * num) + (den - 1)) / den } }
}

fn measure_add<Q, S>(a: Measure<Q, S, std.nat.Nat>, b: Measure<Q, S, std.nat.Nat>) -> Measure<Q, S, std.nat.Nat> {
  Measure { count: a.count + b.count }
}

fn measure_le<Q, S>(a: Measure<Q, S, std.nat.Nat>, b: Measure<Q, S, std.nat.Nat>) -> Bool {
  a.count <= b.count
}

fn time_measure<S>(count: std.nat.Nat) -> Measure<Time, S, std.nat.Nat> {
  Measure { count: count }
}

type ByteSize = Measure<Memory, One, std.nat.Nat>

type Kibibyte = Measure<Memory, Kibi, std.nat.Nat>

type Mebibyte = Measure<Memory, Mebi, std.nat.Nat>

type Gibibyte = Measure<Memory, Gibi, std.nat.Nat>

// THE DECIMAL SIBLING of Gibibyte, added because the two are routinely quoted
// with the same word and differ by 7.4 percent. Vendors publish "GB" meaning
// 10^9 (storage rates, CI runner catalogs) while DIMM capacity is binary, so a
// model that carries both as one type can compare them silently. Carrying them
// as two Measure types at two Scales makes the comparison a conversion the
// author must write, which is the same resolution ByteBasis reaches by
// validation and this reaches by construction.
type Gigabyte = Measure<Memory, Giga, std.nat.Nat>

fn gigabyte(count: std.nat.Nat) -> Gigabyte {
  Measure { count: count }
}

fn gigabyte_count(g: Gigabyte) -> std.nat.Nat {
  measure_count(g)
}

fn mebibyte(count: std.nat.Nat) -> Mebibyte {
  Measure { count: count }
}

fn mebibyte_count(m: Mebibyte) -> std.nat.Nat {
  measure_count(m)
}

fn gibibyte(count: std.nat.Nat) -> Gibibyte {
  Measure { count: count }
}

fn gibibyte_count(g: Gibibyte) -> std.nat.Nat {
  measure_count(g)
}

fn gibibyte_to_byte_size(g: Gibibyte) -> ByteSize {
  byte_size(count: gibibyte_count(g) * gibibyte_scale_factor_bytes())
}

type BitWidth = Measure<Information, One, std.nat.Nat>

fn bits_per_byte() -> std.nat.Nat {
  octet_bit_count()
}

type Hertz = Measure<Frequency, One, std.nat.Nat>

// DDR "MT/s": mega-TRANSFERS per second. Dimensionally a frequency-family rate (1/s at Mega
// scale), semantically distinct from both Hertz (a clock: DDR moves two transfers per clock,
// so the marketing figure is never the clock) and DataRate (bits/s: transfers x bus width).
// The alias carries the transfer semantics; the scale carries the Mega.
type MegatransfersPerSecond = Measure<Frequency, Mega, std.nat.Nat>

type HardwareThreadCount = Measure<Count, One, std.nat.Nat>

type CharacterCount = Measure<Count, One, std.nat.Nat>

type TokenCount = Measure<Count, One, std.nat.Nat>

type Millicore = Measure<Count, Milli, std.nat.Nat>

type Watt = Measure<Power, One, std.nat.Nat>

type Milliwatt = Measure<Power, Milli, std.nat.Nat>

// APPARENT POWER IS NOT POWER, and it is a separate dimension rather than a second Watt alias for
// exactly the reason std.measure exists. A supply rated 120 V at 15 A can deliver 1800 volt-amperes;
// how many WATTS that is depends on the load's power factor, which is a property of the load and is
// not on any supply's datasheet. Carrying both on the Power dimension would make Watt and VoltAmpere
// interchangeable at the type level, and the first comparison between a device's real draw and a
// supply's rating would silently assert a power factor of one - a fabricated fact about hardware
// nobody measured. They are different dimensions, so that comparison does not typecheck and a
// consumer must declare the factor it is assuming.
type VoltAmpere = Measure<ApparentPower, One, std.nat.Nat>

type Volt = Measure<ElectricPotentialDifference, One, std.nat.Nat>

// The millivolt exists for the same reason the micrometre does, one axis over: a device's
// recommended operating window is not a whole number of volts. The iCE40 core supply runs 1.14 V
// to 1.26 V and its I/O banks 1.71 V to 3.46 V, so at volt grain the entire core window collapses
// to a single value and the check that a rail sits inside it stops discriminating. Naming the
// finer step keeps every bound exact instead of forcing a rounding policy at the point where the
// bound is what matters.
type Millivolt = Measure<ElectricPotentialDifference, Milli, std.nat.Nat>

type Ampere = Measure<ElectricCurrent, One, std.nat.Nat>

// The micrometre exists as a named carrier because EIA-310's rack unit is 44.45 mm - NOT a whole
// number of millimetres - so any quantity derived from a rack unit count is inexact at millimetre
// grain and exact at micrometre grain. Naming it lets a consumer stay exact instead of choosing
// between a truncation and a rounding policy, which is the choice std.measure exists to remove.
//
// A SECOND, INDEPENDENT CONSUMER ARRIVED AT THE SAME CARRIER, recorded because two unrelated
// subjects needing one step finer is what makes this a scale argument on the Length axis rather
// than a rack-specific convenience: a printed circuit board sits on a half-millimetre package
// pitch with hundred-micrometre traces, which whole millimetres cannot express at all. Two
// declarations of it were briefly authored in parallel and one was deleted — the concept is one,
// and its reasons accumulate here rather than forking the type.
type Micrometer = Measure<Length, Micro, std.nat.Nat>

type Millimeter = Measure<Length, Milli, std.nat.Nat>

// THE SIGNED SPATIAL COMPONENT LIVES IN std.affine_space, NOT HERE. This module carried a
// SignedMillimeterComponent - Measure<Length, Milli, Int> - as the scalar behind Point3 and
// Vector3, and it was deleted once those aggregates became frame-relative. The reason is the whole
// argument of the frame work: a coordinate's unit is a property of the FRAME it is expressed in,
// which a registrar answers, so a component type that hard-codes millimetres asserts one frame's
// scale for every frame in the corpus. A board drawn on a half-millimetre package pitch and a room
// drawn in millimetres cannot share it, and nothing in the type would have said so.
//
// It is recorded rather than silently removed because the deletion is the point: leaving both
// standing would have been a second signed-spatial authority beside the frame-owned one, which is
// exactly the fork the migration existed to close. Nat-backed Millimeter above is untouched and is
// NOT widened - a wall of length -3 m must remain unwritable, and that is a magnitude rather than
// a component.

// AREA AND VOLUME carry the scale their ratio to the base unit actually has. An earlier revision
// wrote Measure<Area, Milli, Nat> and warned in a comment not to read Milli linearly - but Scale is
// not documentation, it is a fold: scale_exponent answers Milli => -3, so the carrier asserted that
// a square millimetre is 10^-3 of a square metre. It is 10^-6, and a comment cannot correct a fold.
//
// THE FIX IS THE EXISTING SCALE, NOT A NEW ONE. A revision after that minted MilliSquared => -6 and
// MilliCubed => -9, which are Micro and Nano under second names - one decimal factor spelled twice,
// the section 3 nickname, and every fold over Scale then had to grow two arms answering what an
// existing arm already answered. Scale is the decimal factor; the ALIAS is what names the unit, and
// SquareMillimeter says which unit this is. No generic linear scale conversion may be applied to
// either carrier regardless: the ratios are squared and cubed, which is why the conversions below
// DERIVE from extdeps.units.iso_80000_3 through a real import edge rather than a prose pointer - a
// citation that names an authority the module does not depend on is a floating island, and would
// let the factor here and the factor there drift with nothing to notice.
type SquareMillimeter = Measure<Area, Micro, std.nat.Nat>

type CubicMillimeter = Measure<Volume, Nano, std.nat.Nat>

// The SOURCE units of the conversions below. They exist so a conversion cannot be handed "three of
// something": square_metres_to_square_millimetres(count: 3) accepted a bare Nat and so re-created,
// at the conversion boundary, exactly the dimensional erasure this slice exists to close.
type SquareMeter = Measure<Area, One, std.nat.Nat>

// THE SQUARE FOOT is non-decimal, like Sixty and RackUnitHeight: one international foot is
// exactly 0.3048 m, so one square foot is exactly 0.09290304 square metres - not a power of
// ten, so scale_exponent answers none rather than pretending. US commercial real estate
// quotes area and rent in this unit (the MoneyRate PerSquareFootYear period marker below is
// its rent-side twin); the carrier keeps the listing's own unit rather than converting at
// ingestion, which would trade an exact quoted figure for a rounded derived one.
type SquareFoot = Measure<Area, SquareFootArea, std.nat.Nat>

type CubicMeter = Measure<Volume, One, std.nat.Nat>

// PLANE ANGLE units are non-decimal, like Sixty and RackUnitHeight already are: an arcsecond is
// 1/1296000 of a turn, which is not a power of ten, so scale_decimal_exponent answers `none` rather
// than pretending. An earlier revision typed Arcsecond as scale One, asserting it was the coherent
// base unit - it is not; the radian is.
// THE TURN IS THIS SUBSTRATE'S EXACT CANONICAL ANGLE UNIT, and that is a numeric-policy decision
// made HERE rather than a fact read off ISO 80000-3. It lived in extdeps.units.iso_80000_3 while
// being a choice about which carrier gunbc computes in, which is the layer inversion section 3
// names: extdeps states that the radian is the coherent unit and that degree, arcminute and
// arcsecond are exact rational subdivisions of the turn; picking the turn BECAUSE those
// subdivisions are rational, and therefore exact in integer arithmetic, is ours.
//
// The consequence is the one that matters: 1 turn = 2*pi rad is irrational, so no exact integer
// conversion to radian exists and NONE IS OFFERED. A total degree-to-radian function over integers
// would silently floor - inventing precision at the unit boundary, before any geometry ran. Radian
// conversion waits on the approximate-numeric realization and its declared error bound.
//
// Angle magnitude and signed angular displacement are separate types for the same reason length
// magnitude and the signed component are.
type Arcsecond = Measure<PlaneAngle, ArcsecondAngle, std.nat.Nat>

type ArcsecondDisplacement = Measure<PlaneAngle, ArcsecondAngle, Int>

type Degree = Measure<PlaneAngle, DegreeAngle, std.nat.Nat>

// A full turn as a first-class carrier, so the exact canonical unit is representable rather than
// only describable in prose.
type Turn = Measure<PlaneAngle, TurnAngle, std.nat.Nat>

// Signed area: the dot product of two displacement vectors is an AREA with a meaningful sign, not
// an untyped integer. Without this carrier a dot product returns a bare Int and its dimension is
// erased at the first operation.
type SignedSquareMillimeter = Measure<Area, Micro, Int>

fn square_meter(count: std.nat.Nat) -> SquareMeter {
  Measure { count: count }
}

fn square_meter_count(m: SquareMeter) -> std.nat.Nat {
  measure_count(m)
}

fn cubic_meter(count: std.nat.Nat) -> CubicMeter {
  Measure { count: count }
}

fn cubic_meter_count(m: CubicMeter) -> std.nat.Nat {
  measure_count(m)
}

fn degree(count: std.nat.Nat) -> Degree {
  Measure { count: count }
}

fn degree_count(d: Degree) -> std.nat.Nat {
  measure_count(d)
}

fn square_millimeter(count: std.nat.Nat) -> SquareMillimeter {
  Measure { count: count }
}

fn square_millimeter_count(m: SquareMillimeter) -> std.nat.Nat {
  measure_count(m)
}

fn cubic_millimeter(count: std.nat.Nat) -> CubicMillimeter {
  Measure { count: count }
}

fn cubic_millimeter_count(m: CubicMillimeter) -> std.nat.Nat {
  measure_count(m)
}

fn arcsecond(count: std.nat.Nat) -> Arcsecond {
  Measure { count: count }
}

fn arcsecond_count(a: Arcsecond) -> std.nat.Nat {
  measure_count(a)
}

fn arcsecond_displacement(count: Int) -> ArcsecondDisplacement {
  Measure { count: count }
}

fn arcsecond_displacement_count(a: ArcsecondDisplacement) -> Int {
  measure_count(a)
}

// EIA-310 rack unit: 1U = 1.75 in = 44.45 mm EXACTLY, which is 44450 micrometres — an
// integer, so the quantum is exact in the Nat carrier and needs no rounding. RackUnitHeight
// is a non-decimal scale in the same sense Sixty is: scale_exponent has no answer for it and
// the conversion lives in a domain factor function instead.
type RackUnit = Measure<Length, RackUnitHeight, std.nat.Nat>

type Joule = Measure<Energy, One, std.nat.Nat>

type Celsius = Measure<Temperature, One, Int>

type CelsiusDelta = Measure<TemperatureDifference, One, Int>

type PositiveMeasureCount
  = PositiveMeasureSuccessor { predecessor: std.nat.Nat }

type PositiveMeasureCountBuild
  = PositiveMeasureCountBuilt { count: PositiveMeasureCount }
  | PositiveMeasureCountRefused {
      cause: PositiveMeasureCountNonPositive,
    }

type PositiveMeasureCountNonPositive {
  observed: Int
}

fn positive_measure_count(predecessor: std.nat.Nat) -> PositiveMeasureCount {
  PositiveMeasureSuccessor { predecessor: predecessor }
}

fn positive_measure_count_from_int(
  count: Int,
) -> PositiveMeasureCountBuild {
  if count <= 0 {
    PositiveMeasureCountRefused {
      cause: PositiveMeasureCountNonPositive { observed: count },
    }
  } else {
    PositiveMeasureCountBuilt {
      count: positive_measure_count(
        predecessor: count - 1,
      ),
    }
  }
}

fn positive_measure_count_value(
  count: PositiveMeasureCount,
) -> Int {
  match count {
    PositiveMeasureSuccessor { predecessor: predecessor } =>
      predecessor + 1
  }
}

type PositiveCelsiusDelta
  = PositiveCelsiusDeltaValue { count: PositiveMeasureCount }

type RevolutionsPerMinute = Measure<RotationalSpeed, One, std.nat.Nat>

fn watt(count: std.nat.Nat) -> Watt {
  Measure { count: count }
}

fn watt_count(w: Watt) -> std.nat.Nat {
  measure_count(w)
}

fn milliwatt(count: std.nat.Nat) -> Milliwatt {
  Measure { count: count }
}

// MILLI -> ONE, ONCE, HERE. A consumer dividing a milliwatt count by a literal
// 1000 is re-stating the Milli scale this module already declares, and the
// division is FLOOR — 1,999 mW is one watt and the 999 is dropped, which is a
// property of the conversion the name says out loud rather than a rounding a
// caller has to remember.
fn milliwatt_to_watt_floor(w: Milliwatt) -> Watt {
  watt(count: milliwatt_count(w: w) / milli_per_unit())
}

fn milliwatt_count(w: Milliwatt) -> std.nat.Nat {
  measure_count(w)
}

fn volt(count: std.nat.Nat) -> Volt {
  Measure { count: count }
}

fn volt_count(v: Volt) -> std.nat.Nat {
  measure_count(v)
}

fn millivolt(count: std.nat.Nat) -> Millivolt {
  Measure { count: count }
}

fn millivolt_count(v: Millivolt) -> std.nat.Nat {
  measure_count(v)
}

fn ampere(count: std.nat.Nat) -> Ampere {
  Measure { count: count }
}

fn ampere_count(a: Ampere) -> std.nat.Nat {
  measure_count(a)
}

fn micrometer(count: std.nat.Nat) -> Micrometer {
  Measure { count: count }
}

fn micrometer_count(m: Micrometer) -> std.nat.Nat {
  measure_count(m)
}

fn millimeter(count: std.nat.Nat) -> Millimeter {
  Measure { count: count }
}

fn millimeter_count(m: Millimeter) -> std.nat.Nat {
  measure_count(m)
}

fn micrometers_per_rack_unit() -> std.nat.Nat {
  44450
}

fn rack_unit(count: std.nat.Nat) -> RackUnit {
  Measure { count: count }
}

fn rack_unit_count(u: RackUnit) -> std.nat.Nat {
  measure_count(u)
}

fn joule(count: std.nat.Nat) -> Joule {
  Measure { count: count }
}

fn joule_count(j: Joule) -> std.nat.Nat {
  measure_count(j)
}

fn celsius(count: Int) -> Celsius {
  Measure { count: count }
}

fn celsius_count(c: Celsius) -> Int {
  measure_count(c)
}

fn celsius_delta(count: Int) -> CelsiusDelta {
  Measure { count: count }
}

fn celsius_delta_count(delta: CelsiusDelta) -> Int {
  measure_count(delta)
}

fn positive_celsius_delta(
  count: PositiveMeasureCount,
) -> PositiveCelsiusDelta {
  PositiveCelsiusDeltaValue { count: count }
}

fn positive_celsius_delta_count(
  delta: PositiveCelsiusDelta,
) -> Int {
  match delta {
    PositiveCelsiusDeltaValue { count: count } =>
      positive_measure_count_value(count: count)
  }
}

fn rpm(count: std.nat.Nat) -> RevolutionsPerMinute {
  Measure { count: count }
}

fn rpm_count(r: RevolutionsPerMinute) -> std.nat.Nat {
  measure_count(r)
}

type MoneyAmount<S> = Measure<Currency, S, std.nat.Nat>

type MoneyAmountMicro = MoneyAmount<Micro>

fn money_amount_micro(count: std.nat.Nat) -> MoneyAmountMicro {
  Measure { count: count }
}

fn money_amount_micro_count(m: MoneyAmountMicro) -> std.nat.Nat {
  measure_count(m)
}

data money_rate_billing_unit_note: String = "Billing unit is part of the fact: per-minute, per-hour, and per-month are distinct carriers — never folded into a bare amount with the unit in the field name. Cross-vendor normalization is a derived projection at read time, never a stored catalog field."

type PerSecond

type PerMinute

type PerHour

type PerMonth

type Once

type MoneyRate<P> {
  amount: MoneyAmountMicro
  currency: CurrencyCode
}

type MoneyPerSecond = MoneyRate<PerSecond>

type MoneyPerMinute = MoneyRate<PerMinute>

type MoneyPerHour = MoneyRate<PerHour>

type MoneyPerMonth = MoneyRate<PerMonth>

type MoneyOnce = MoneyRate<Once>

type PerKilowattHour

type PerSquareFootYear

type MoneyPerKilowattHour = MoneyRate<PerKilowattHour>

type MoneyPerSquareFootYear = MoneyRate<PerSquareFootYear>

data money_rate_carrier_representation_note: String = "MoneyRate<P> is the §2-horizontal carrier for vendor billing period: one parameterized record (P = PerMinute | PerHour | PerMonth | Once phantom markers), not four structurally-identical records — same move as MoneyAmount<S> = Measure<Currency, S, Nat> and Vendor<Domain>. Not a Measure<Q,S,M> row: billing period is a categorical vendor unit axis, not an SI Scale on a single Quantity; the carrier also holds runtime CurrencyCode beside the micro-denominated amount. Passing PerMinute where PerHour is expected is unwritable via the type argument."

fn money_rate_micros<P>(q: MoneyRate<P>) -> std.nat.Nat {
  money_amount_micro_count(m: q.amount)
}

fn money_per_minute_micros(q: MoneyPerMinute) -> std.nat.Nat {
  money_rate_micros(q: q)
}

fn money_per_hour_micros(q: MoneyPerHour) -> std.nat.Nat {
  money_rate_micros(q: q)
}

fn money_per_month_micros(q: MoneyPerMonth) -> std.nat.Nat {
  money_rate_micros(q: q)
}

fn money_once_micros(q: MoneyOnce) -> std.nat.Nat {
  money_rate_micros(q: q)
}

fn money_per_kilowatt_hour_micros(q: MoneyPerKilowattHour) -> std.nat.Nat {
  money_rate_micros(q: q)
}

fn money_per_sqft_year_micros(q: MoneyPerSquareFootYear) -> std.nat.Nat {
  money_rate_micros(q: q)
}

fn per_hour_equivalent_from_per_minute(q: MoneyPerMinute) -> MoneyPerHour {
  MoneyPerHour {
    amount: money_amount_micro(count: money_per_minute_micros(q: q) * minutes_per_hour()),
    currency: q.currency,
  }
}

fn billing_month_as_hour_count() -> std.nat.Nat {
  730
}

data billing_month_as_hour_count_note: String = "Derived monthly→hourly divisor: 730 hours (365×24/12), the conventional cloud billing month used for cross-vendor hourly equivalence only — not a vendor quote."

data billing_month_as_hour_count_representation_note: String = "Nat divisor via fn not Measure<Time, One, Nat>: stage0 alias emission collapses applied-generic Measure aliases to concrete Measure<(), (), Nat> while fn/data return sites still reference the un-erased alias params (E0107). Dissolve-on: stage0 Measure-alias emitter preserves return types at data/fn sites."

fn per_hour_equivalent_from_per_month(q: MoneyPerMonth) -> MoneyPerHour {
  MoneyPerHour {
    amount: money_amount_micro(count: money_per_month_micros(q: q) / billing_month_as_hour_count()),
    currency: q.currency,
  }
}

