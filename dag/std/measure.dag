module std.measure

import std.nat { Nat }
import std.types { Int }

type Quantity =
    Time
  | Length
  | Mass
  | Memory
  | Information
  | DataRate
  | Frequency
  | Count
  | Currency

  | Power

  | Temperature

  | RotationalSpeed

  | ElectricPotential
  | ElectricCurrent
  | Resistance
  | Capacitance
  | Inductance
  | ElectricCharge
  | MagneticFlux

  | Dimensionless

type Scale =
    Atto
  | Femto
  | Pico
  | Nano
  | Micro
  | Milli
  | One
  | Sixty
  | Kilo
  | Mega
  | Giga
  | Tera
  | Peta
  | Exa

  | Kibi
  | Mebi
  | Gibi
  | Tebi

fn scale_exponent(s: Scale) -> Int {
  match s {
    Atto  => -18
    Femto => -15
    Pico  => -12
    Nano  =>  -9
    Micro =>  -6
    Milli =>  -3
    One   =>   0
    Sixty =>   0
    Kilo  =>   3
    Mega  =>   6
    Giga  =>   9
    Tera  =>  12
    Peta  =>  15
    Exa   =>  18
    Kibi  =>  10
    Mebi  =>  20
    Gibi  =>  30
    Tebi  =>  40
  }
}

fn gibibyte_scale_factor_bytes() -> Nat {
  1073741824
}

fn kibi_factor() -> Nat {
  1024
}

fn seconds_per_minute() -> Nat {
  60
}

fn time_scale_factor_seconds(s: Scale) -> Nat? {
  match s {
    One => Present { value: 1 }
    Sixty => Present { value: seconds_per_minute() }
    Atto  => none
    Femto => none
    Pico  => none
    Nano  => none
    Micro => none
    Milli => none
    Kilo  => none
    Mega  => none
    Giga  => none
    Tera  => none
    Peta  => none
    Exa   => none
    Kibi  => none
    Mebi  => none
    Gibi  => none
    Tebi  => none
  }
}

fn memory_scale_factor_bytes(s: Scale) -> Nat? {
  match s {
    One  => Present { value: 1 }
    Kibi => Present { value: kibi_factor() }
    Mebi => Present { value: kibi_factor() * kibi_factor() }
    Gibi => Present { value: gibibyte_scale_factor_bytes() }
    Tebi => Present { value: gibibyte_scale_factor_bytes() * kibi_factor() }
    Atto  => none
    Femto => none
    Pico  => none
    Nano  => none
    Micro => none
    Milli => none
    Sixty => none
    Kilo  => none
    Mega  => none
    Giga  => none
    Tera  => none
    Peta  => none
    Exa   => none
  }
}

type Measure<Q, S, M> {
  count: M
}

fn measure_count<Q, S, M>(m: Measure<Q, S, M>) -> M {
  m.count
}

fn measure_scale_fraction_floor<Q, S>(m: Measure<Q, S, Nat>, num: Nat, den: Nat) -> Measure<Q, S, Nat> {

  Measure { count: if den == 0 { den } else { (m.count * num) / den } }
}

fn measure_fit_count_floor<Q, S>(capacity: Measure<Q, S, Nat>, each: Measure<Q, S, Nat>) -> Nat {

  let each_count = each.count
  if each_count == 0 { each_count } else { capacity.count / each_count }
}

fn measure_scale_fraction_ceil<Q, S>(m: Measure<Q, S, Nat>, num: Nat, den: Nat) -> Measure<Q, S, Nat> {

  Measure { count: if den == 0 { m.count * num } else { ((m.count * num) + (den - 1)) / den } }
}

fn measure_add<Q, S>(a: Measure<Q, S, Nat>, b: Measure<Q, S, Nat>) -> Measure<Q, S, Nat> {
  Measure { count: a.count + b.count }
}

fn measure_le<Q, S>(a: Measure<Q, S, Nat>, b: Measure<Q, S, Nat>) -> Bool {
  a.count <= b.count
}

fn time_measure<S>(count: Nat) -> Measure<Time, S, Nat> {
  Measure { count: count }
}

type ByteSize = Measure<Memory, One, Nat>

type Kibibyte = Measure<Memory, Kibi, Nat>

type Mebibyte = Measure<Memory, Mebi, Nat>

type Gibibyte = Measure<Memory, Gibi, Nat>

fn mebibyte(count: Nat) -> Mebibyte {
  Mebibyte { count: count }
}

fn mebibyte_count(m: Mebibyte) -> Nat {
  measure_count(m)
}

fn gibibyte(count: Nat) -> Gibibyte {
  Gibibyte { count: count }
}

fn gibibyte_count(g: Gibibyte) -> Nat {
  measure_count(g)
}

fn gibibyte_to_byte_size(g: Gibibyte) -> ByteSize {
  byte_size(count: gibibyte_count(g) * gibibyte_scale_factor_bytes())
}

type BitWidth = Measure<Information, One, Nat>

fn bits_per_byte() -> Nat {
  8
}

type Hertz = Measure<Frequency, One, Nat>

type HardwareThreadCount = Measure<Count, One, Nat>

type Millicore = Measure<Count, Milli, Nat>

type Watt = Measure<Power, One, Nat>

type Celsius = Measure<Temperature, One, Int>

type RevolutionsPerMinute = Measure<RotationalSpeed, One, Nat>

fn watt(count: Nat) -> Watt {
  Watt { count: count }
}

fn watt_count(w: Watt) -> Nat {
  measure_count(w)
}

fn celsius(count: Int) -> Celsius {
  Celsius { count: count }
}

fn celsius_count(c: Celsius) -> Int {
  measure_count(c)
}

fn rpm(count: Nat) -> RevolutionsPerMinute {
  RevolutionsPerMinute { count: count }
}

fn rpm_count(r: RevolutionsPerMinute) -> Nat {
  measure_count(r)
}

type MoneyAmount<S> = Measure<Currency, S, Nat>

type MoneyAmountMicro = MoneyAmount<Micro>

fn money_amount_micro(count: Nat) -> MoneyAmountMicro {
  MoneyAmountMicro { count: count }
}

fn money_amount_micro_count(m: MoneyAmountMicro) -> Nat {
  measure_count(m)
}

fn byte_size(count: Nat) -> ByteSize {
  ByteSize { count: count }
}

fn byte_size_count(b: ByteSize) -> Nat {
  measure_count(b)
}

fn bit_width(count: Nat) -> BitWidth {
  BitWidth { count: count }
}

fn bit_width_count(b: BitWidth) -> Nat {
  measure_count(b)
}

fn hertz(count: Nat) -> Hertz {
  Hertz { count: count }
}

fn hertz_count(h: Hertz) -> Nat {
  measure_count(h)
}

fn hardware_thread_count(count: Nat) -> HardwareThreadCount {
  HardwareThreadCount { count: count }
}

fn hardware_thread_count_value(t: HardwareThreadCount) -> Nat {
  measure_count(t)
}

fn millicore(count: Nat) -> Millicore {
  Millicore { count: count }
}

fn millicore_count(m: Millicore) -> Nat {
  measure_count(m)
}

type Bandwidth = Measure<DataRate, One, Nat>

fn bandwidth(count: Nat) -> Bandwidth {
  Bandwidth { count: count }
}

fn bandwidth_count(b: Bandwidth) -> Nat {
  measure_count(b)
}

type Nanosecond = Measure<Time, Nano, Nat>

fn nanosecond(count: Nat) -> Nanosecond {
  Nanosecond { count: count }
}

fn nanosecond_count(n: Nanosecond) -> Nat {
  measure_count(n)
}

type Microsecond = Measure<Time, Micro, Nat>

fn microsecond(count: Nat) -> Microsecond {
  Microsecond { count: count }
}

fn microsecond_count(m: Microsecond) -> Nat {
  measure_count(m)
}

type Millisecond = Measure<Time, Milli, Nat>

fn millisecond(count: Nat) -> Millisecond {
  Millisecond { count: count }
}

fn millisecond_count(m: Millisecond) -> Nat {
  measure_count(m)
}

type Second = Measure<Time, One, Nat>

fn second(count: Nat) -> Second {
  Second { count: count }
}

fn second_count(s: Second) -> Nat {
  measure_count(s)
}

type Minute = Measure<Time, Sixty, Nat>

fn minute(count: Nat) -> Minute {
  Minute { count: count }
}

fn minute_count(m: Minute) -> Nat {
  measure_count(m)
}

type Percent = Measure<Dimensionless, One, Nat>

