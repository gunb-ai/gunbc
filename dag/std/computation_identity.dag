module std.computation_identity


data computation_identity_note: String = "The computation-identity lattice (census R1, landed 2026-07-22; formerly prose in docs/plans/duplicate-work-graph-lens-design.md section 4, cited by v2.std.materialize, std.interface_summary, gunbc.design_document, and the cross-entry memo sketch as the authority they defer to). One vocabulary for what 'identical computation' means, at every grain: StructurallyIdentical (equal content hash over canonicalized structure — the corner v2.std.materialize implements), NormalizedIdentical (equal after a NAMED normalizer), ExtensionallyIdentical (equal observable behavior within a declared bound), IdentityUnknown (a typed, located debt — never permanent, never treated as identical or as distinct-by-default; the cause names the missing work). Mirrors DescentEvidence: evidence-graded, fail-closed at the bottom."

type IdentityUnknownCause
  = MissingConcept { detail: String }
  | MissingEnforcement { detail: String }
  | BoundUnmodeled { detail: String }

type ComputationIdentity
  = StructurallyIdentical
  | NormalizedIdentical { normalizer: String }
  | ExtensionallyIdentical { bound: String }
  | IdentityUnknown { cause: IdentityUnknownCause }

fn identity_grade_is_known(ci: ComputationIdentity) -> Bool {
  match ci {
    StructurallyIdentical => true
    NormalizedIdentical { normalizer: _ } => true
    ExtensionallyIdentical { bound: _ } => true
    IdentityUnknown { cause: _ } => false
  }
}

fn identity_permits_share(ci: ComputationIdentity) -> Bool {
  match ci {
    StructurallyIdentical => true
    NormalizedIdentical { normalizer: _ } => true
    ExtensionallyIdentical { bound: _ } => true
    IdentityUnknown { cause: _ } => false
  }
}
