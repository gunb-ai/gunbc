module std.markdown_markup

fn markdown_inline_to_markup_nodes(inline: MarkdownInline) -> List<MarkupNode> {
  fragments_to_markup_nodes(frags: markdown_inline_to_fragments(inline: inline))
}

fn markdown_inlines_to_markup_nodes(inlines: List<MarkdownInline>) -> List<MarkupNode> {
  fragments_to_markup_nodes(frags: markdown_inlines_to_fragments(inlines: inlines))
}
