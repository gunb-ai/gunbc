module std.bit


type Bit = Bool

type Nibble { bits: std.types.List<Bit> }

type Byte { bits: std.types.List<Bit> }

type Word8 {
  bytes: List<Byte>
}

type Word16 { bytes: std.types.List<Byte> }
type Word32 { bytes: std.types.List<Byte> }
type Word64 { bytes: std.types.List<Byte> }
type Word128 { bytes: std.types.List<Byte> }
