module std.string_type

import std.algebra { FreeMonoid, Ordering, Less, Equal, Greater, ordering_is_less }
import std.types { Char }

type String = FreeMonoid<Char>

fn string_lex_compare(left: String, right: String) -> Ordering {
  let left_len = string_length(s: left)
  let right_len = string_length(s: right)
  if left_len == 0 && right_len == 0 {
    Equal
  } else if left_len == 0 {
    Less
  } else if right_len == 0 {
    Greater
  } else {
    let left_cp = code_point(c: char_at(s: left, pos: 0))
    let right_cp = code_point(c: char_at(s: right, pos: 0))
    if left_cp < right_cp {
      Less
    } else if left_cp > right_cp {
      Greater
    } else {
      string_lex_compare(
        left: substring(s: left, start: 1, end: left_len),
        right: substring(s: right, start: 1, end: right_len),
      )
    }
  }
}

fn string_is_lexicographically_before(left: String, right: String) -> Bool {
  ordering_is_less(o: string_lex_compare(left: left, right: right))
}

// CHARACTER CLASSES over Char, beside the Char-sequence carrier. They lived in std.unicode.types,
// which imported Char from std.types while std.types' Char refinement names std.unicode.types
// unicode_scalar -- a module cycle once the where atom binds as a reference.
type CharClass = Whitespace | Digit | IdentStart | IdentContinue

fn char_in_class(c: Char, class: CharClass) -> Bool =
  match class {

    Whitespace =>
      unicode_char_code_point(c: c) == 9 || unicode_char_code_point(c: c) == 10 || unicode_char_code_point(c: c) == 12
      || unicode_char_code_point(c: c) == 13 || unicode_char_code_point(c: c) == 32
    Digit => unicode_char_code_point(c: c) >= 48 && unicode_char_code_point(c: c) <= 57
    IdentStart =>
      unicode_char_code_point(c: c) >= 65 && unicode_char_code_point(c: c) <= 90
      || unicode_char_code_point(c: c) >= 97 && unicode_char_code_point(c: c) <= 122
      || unicode_char_code_point(c: c) == 95

    IdentContinue =>
      unicode_char_code_point(c: c) >= 48 && unicode_char_code_point(c: c) <= 57
      || unicode_char_code_point(c: c) >= 65 && unicode_char_code_point(c: c) <= 90
      || unicode_char_code_point(c: c) >= 97 && unicode_char_code_point(c: c) <= 122
      || unicode_char_code_point(c: c) == 95
  }

fn unicode_char_code_point(c: Char) -> Int = c + 0
