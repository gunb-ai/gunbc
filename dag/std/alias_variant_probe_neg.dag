module std.alias_variant_probe_neg

import std.types { Int, List }
import std.algebra { Cons, Empty }
import std.optional { Present }

// NEGATIVE CONTROL: `Present` is a variant of Optional, NOT of FreeMonoid. Matching it on
// a List<Int> binder (= FreeMonoid<Int>) must be refused BOTH before and after the fix:
// before, the lookup is on the authored name (List) so Present is not found; after, the
// lookup peels List to its declared coproduct FreeMonoid and Present is still not among
// FreeMonoid's variants. This pins that the fix peels to the declaring coproduct and
// checks its real variants, rather than making every named variant accepted.
fn probe_wrong_variant(param_types: List<Int>) -> Int {
  match param_types {
    Present { value: _ } => 0
    Cons { head: _, tail: _ } => 1
    Empty => 2
  }
}
