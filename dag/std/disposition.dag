module std.disposition

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef }

type ConstructionMechanism
  = SingleAuthority
  | RealizationDispatch
  | SubstrateMandatoryTag

type Disposition
  = Terminal { reason: NonEmptyStr }
  | Scaffold { dissolves_to: ConstructionMechanism, bind: DeclarationRef }
