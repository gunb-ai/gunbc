module std.hex

import std.types { String, Int, List }
import v2.std.optional { Present, Absent }

// HEXADECIMAL DIGITS AND WORDS, DECODED ONCE. A hex digit is a code point in 0-9, A-F or a-f
// (RFC 4648 §8 / ISO/IEC 9899 hexadecimal-digit); anything else is not a digit, and this fn says
// so rather than answering a number for it. A hex word is 1..max_digits digits; an empty word, a
// non-digit, or more digits than the caller's bound refuses -- the bound keeps the fold inside
// the substrate Int (fifteen digits is the widest 64-bit-safe word). A caller with a narrower
// alphabet (lowercase only, as a MAC address is written) or a wider bound keeps its own guard in
// front of this; the decoding itself lives here and nowhere else.
fn hex_digit_value(cp: Int) -> Int? {
  if cp >= 48 && cp <= 57 { Present { value: cp - 48 } }
  else if cp >= 65 && cp <= 70 { Present { value: cp - 55 } }
  else if cp >= 97 && cp <= 102 { Present { value: cp - 87 } }
  else { none }
}

fn hex_word_value(word: String, max_digits: Int) -> Int? {
  let cps = word |> chars
  if length(cps) == 0 || length(cps) > max_digits || max_digits > 15 { none } else {
    fold(cps, init: Present { value: 0 }, f: (acc, cp) =>
      match acc {
        Absent => none
        Present { value: v } =>
          match hex_digit_value(cp: cp) {
            Absent => none
            Present { value: d } => Present { value: v * 16 + d }
          }
      })
  }
}
