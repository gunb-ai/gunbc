module std.process

import std.types { NonEmptyStr }
import extdeps.process.posix_exit {
  exit_code_success,
  exit_code_general_error,
}
import extdeps.process.gnu_bash_exit { exit_code_misuse }

type ProcessExit
  = ExitSuccess
  | ExitFailure { code: Int, reason: String }

fn exit_failure(reason: String) -> ProcessExit {
  ExitFailure { code: exit_code_general_error, reason: reason }
}

// Claim-surface inhabitance of ExitSuccess. Sequencers match ProcessExit; they do not ask this for a Bool.
// This and tools.emit_host_gate emit_host_verdict_narration_scaffold were two consequences of one gap:
// the claim surface is Bool-typed. That gap's capability is stated at tools.emit_host_gate
// emit_host_verdict_narration_dissolution_trigger, and retires both; this predicate is not separately rostered.
//
// 2026-09-13 (gentle-gull-238), HALF RETIRED: the claim path now carries typed refusal reasons to
// the executor surface (cli_run.rs `ClaimOutcome::ExitFailure`, printed on the claim_batch FAIL
// row and published as the terminal ledger's detail under the "exit-failure" tag), so the
// narration scaffold half is DELETED — gate-class claims read tools.emit_host_gate's ExitFailure
// reason directly. This predicate remains for the OTHER half: the Bool wrapper witnesses
// (floor_effect_gate_witness <gate>_passes) still flatten a ProcessExit to a Bool for a claim
// surface that predates typed reasons, and their declared receipt path is the
// <witness>_failure_receipt companion, not this comment. When the wrapper witnesses flip to
// gate-class claims, this predicate loses its last caller and retires with the rest of the gap.
fn exit_ok(e: ProcessExit) -> Bool {
  match e {
    ExitSuccess => true
    ExitFailure { code, reason } => false
  }
}
