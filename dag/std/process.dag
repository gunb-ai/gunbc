module std.process

import std.types { NonEmptyStr }
import extdeps.process.posix_exit {
  exit_code_success,
  exit_code_general_error,
}
import extdeps.process.gnu_bash_exit { exit_code_misuse }

type ProcessExit
  = ExitSuccess
  | ExitFailure { code: Int, reason: String }

fn exit_failure(reason: String) -> ProcessExit {
  ExitFailure { code: exit_code_general_error, reason: reason }
}

data process_termination_note: String = "HOW A SPAWNED PROCESS ENDED, AS OBSERVED — a different concept from ProcessExit above, which is an exit this program DECLARES for itself. An observation cannot be constructed from intent, so the two do not share a carrier.\n\nWHY THE SIGNAL ARM EXISTS. A signal death has no exit code. The seed transport used to render one anyway, flattening every signalled process to the fabricated literal -1 (v1_interpreter emit_host_run_transport_cached_in_workspace), so a runner OOM-killing a build was indistinguishable from a build choosing to exit -1 and both read as an ordinary nonzero exit. That is the DESIGN section 5 fabricated-plausible-output class at the process boundary: the observation that could not be expressed was rendered as a neighbouring one that could. std.realization_schedule already states the same law for floor workers (its Rust control is named floor_worker_signal_death_is_not_flattened_to_an_exit_code); this carrier is that law where a HOST transport observes a child, and it is deliberately the one authority for the concept rather than a second spelling of it.\n\nProcessTerminationUnobserved is not an error arm. It is the honest state when the spawn itself never produced a status — the transport refused before the process existed — and it is what keeps an outage separable from a failure the process actually reported."

type ProcessTermination
  = ProcessExited { code: Int }
  | ProcessSignaled { signal: Int }
  | ProcessTerminationUnobserved
