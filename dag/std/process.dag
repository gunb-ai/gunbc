module std.process


type ProcessExit
  = ExitSuccess
  | ExitFailure { code: Int, reason: String }

data exit_code_success: Int = 0
data exit_code_general_error: Int = 1
data exit_code_misuse: Int = 2

fn exit_failure(reason: String) -> ProcessExit {
  ExitFailure { code: exit_code_general_error, reason: reason }
}
