module std.process

import std.types { NonEmptyStr }
import extdeps.process.posix_exit {
  exit_code_success,
  exit_code_general_error,
}
import extdeps.process.gnu_bash_exit { exit_code_misuse }

type ProcessExit
  = ExitSuccess
  | ExitFailure { code: Int, reason: String }

fn exit_failure(reason: String) -> ProcessExit {
  ExitFailure { code: exit_code_general_error, reason: reason }
}

// Claim-surface inhabitance of ExitSuccess. Sequencers match ProcessExit; they do not ask this for a Bool.
// This and tools.emit_host_gate emit_host_verdict_narration_scaffold are two consequences of one gap:
// the claim surface is Bool-typed. That gap's capability is stated at tools.emit_host_gate
// emit_host_verdict_narration_dissolution_trigger, and retires both; this predicate is not separately rostered.
fn exit_ok(e: ProcessExit) -> Bool {
  match e {
    ExitSuccess => true
    ExitFailure { code, reason } => false
  }
}
