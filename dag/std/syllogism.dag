module std.syllogism


type AxiomKind = LogicalAxiom | NonLogicalAxiom

type Axiom {
  id: String
  statement: String
  kind: AxiomKind
}

type Proposition {
  id: String
  statement: String
  premises: List<String>
}

type Argument {
  axioms: List<Axiom>
  propositions: List<Proposition>
}

fn argument_inference_edges(a: Argument) -> List<GraphEdge> {
  a.propositions |> flat_map(p =>
    p.premises |> map(prem => GraphEdge { caller: p.id, callee: prem })
  )
}

fn argument_node_ids(a: Argument) -> List<String> {
  concat(
    a.axioms |> map(ax => ax.id),
    a.propositions |> map(p => p.id)
  )
}

fn argument_inference_graph(a: Argument) -> CallGraph {
  CallGraph { edges: argument_inference_edges(a) }
}

fn argument_reachable_from_axioms(a: Argument) -> Set<String> {
  let ids = argument_node_ids(a)
  let views = build_adjacency_views(names: ids, graph: argument_inference_graph(a))
  let walked = a.axioms |> fold(init: DfsFinishAcc { visited: empty_set(), order: [] }, f: (acc, ax) =>
    dfs_finish_order(node: ax.id, adjacency: views.reverse, acc: acc)
  )
  walked.visited
}

fn argument_has_no_orphan(a: Argument) -> Bool {
  let reachable = argument_reachable_from_axioms(a)
  (a.propositions |> filter(p => set_contains(reachable, p.id) == false) |> count) == 0
}

fn argument_is_acyclic(a: Argument) -> Bool {
  let has_self_premise = argument_inference_edges(a) |> any(e => e.caller == e.callee)
  if has_self_premise {
    false
  } else {
    graph_has_multi_node_scc(names: argument_node_ids(a), graph: argument_inference_graph(a)) == false
  }
}

fn argument_axiom_set_is_closed(a: Argument) -> Bool {
  let covert_root_count = a.propositions |> filter(p => (p.premises |> count) == 0) |> count
  let ids = argument_node_ids(a)
  let dangling_premise_count = argument_inference_edges(a)
    |> filter(e => (ids |> any(i => i == e.callee)) == false)
    |> count
  covert_root_count == 0 && dangling_premise_count == 0
}

fn argument_is_non_vacuous(a: Argument) -> Bool {
  (a.axioms |> count) > 0 && (a.propositions |> count) > 0
}

fn argument_form_is_valid(a: Argument) -> Bool {
  argument_is_non_vacuous(a)
    && argument_has_no_orphan(a)
    && argument_is_acyclic(a)
    && argument_axiom_set_is_closed(a)
}
