module std.interval

import std.types { Bool, NonEmptyStr }

// An ordered closed interval over a totally ordered carrier. An uncertainty region needs a
// representation whose endpoints CANNOT be reversed: a hand-written `{low, high}` record admits
// `low > high`, and a reversed interval is not a wide interval — it denotes nothing, which
// downstream width arithmetic will turn into a plausible number.
//
// The wall is structural, not a check: the carrier is `sole_constructor`, so no other module can
// write the record literal or cast into it, and the single mint refuses the reversed case. The
// invalid state has no constructor outside this module (DESIGN section 4b, rung four for this
// class) rather than being validated after the fact.
//
// Ordering is supplied by the caller as `le`, because the substrate has no typeclass to demand it
// from and a carrier-specific comparison is the fact the domain owns. That seam also keeps this
// honest for richer regions: an interval is the one-dimensional case; a point, pose, or polygon
// needs a radius, bounding box, or covariance region — separate carriers, not a widened
// `low`/`high`.
type OrderedClosedInterval<T> sole_constructor {
  low: T
  high: T
}

type IntervalConstruction<T>
  = IntervalReady { interval: OrderedClosedInterval<T> }
  | IntervalRefused { reason: NonEmptyStr }

// The ONE mint. A reversed pair is refused, typed and located, never silently swapped into order —
// swapping would be the absorbing fallback (DESIGN section 5): a plausible answer that destroys the
// evidence that the caller's endpoints were wrong.
fn closed_interval<T>(
  low: T,
  high: T,
  le: fn(T, T) -> Bool,
) -> IntervalConstruction<T> {
  if le(low, high) {
    IntervalReady { interval: OrderedClosedInterval { low: low, high: high } }
  } else {
    IntervalRefused { reason: "interval endpoints reversed: low exceeds high" }
  }
}

// The degenerate interval [x, x] is TOTAL and needs no comparison: a point is ordered with itself
// by reflexivity, so no reversed pair is possible. It is the one constructor safe to offer
// unconditionally, and not a default — a caller wanting a WIDTH still goes through the refusing
// mint.
fn degenerate_interval<T>(point: T) -> OrderedClosedInterval<T> {
  OrderedClosedInterval { low: point, high: point }
}

fn interval_low<T>(interval: OrderedClosedInterval<T>) -> T {
  interval.low
}

fn interval_high<T>(interval: OrderedClosedInterval<T>) -> T {
  interval.high
}

type IntervalConstructionFold<T, R> {
  ready: fn(OrderedClosedInterval<T>) -> R
  refused: fn(NonEmptyStr) -> R
}

fn interval_construction_fold<T, R>(
  construction: IntervalConstruction<T>,
  fold: IntervalConstructionFold<T, R>,
) -> R {
  match construction {
    IntervalReady { interval: i } => fold.ready(i)
    IntervalRefused { reason: r } => fold.refused(r)
  }
}
