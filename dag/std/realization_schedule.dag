module std.realization_schedule

import std.types { ContentHash, Bool, String, List, Int }
import std.execution_mode { ExecutionMode, Hermetic, execution_mode_eq }
import std.nat { Nat }
import std.measure {
  Measure, Time, ByteSize, Watt,
  byte_size, byte_size_count, watt, time_measure, measure_count
}
import std.pareto { AxisGoal }

type CostBasis
  = Predicted
  | Measured

type CostAccount<S> {
  time: Measure<Time, S, Nat>
  space: ByteSize
  power: Watt
  basis: CostBasis
}

fn cost_account_predicted_zero<S>() -> CostAccount<S> {
  CostAccount {
    time: time_measure(count: 0)
    space: byte_size(count: 0)
    power: watt(count: 0)
    basis: Predicted
  }
}

fn cost_account_measured<S>(time: Measure<Time, S, Nat>) -> CostAccount<S> {
  CostAccount {
    time: time
    space: byte_size(count: 0)
    power: watt(count: 0)
    basis: Measured
  }
}

fn cost_account_time_count<S>(account: CostAccount<S>) -> Nat {
  measure_count(m: account.time)
}

type RealizationObjective {
  goals: List<AxisGoal>
}

type WitnessKind
  = CorpusWitnessKind
  | ExecutionWitnessKind

type WitnessSeam {
  producer: String
  consumer: String
}

type WitnessSpan
  = SpanUndeclared
  | SpanSeams { seams: List<WitnessSeam> }

fn witness_kind_eq(a: WitnessKind, b: WitnessKind) -> Bool {
  match a {
    CorpusWitnessKind => match b { CorpusWitnessKind => true  ExecutionWitnessKind => false }
    ExecutionWitnessKind => match b { ExecutionWitnessKind => true  CorpusWitnessKind => false }
  }
}

type ScheduleWitnessEntry {
  entry: String
  function: String
  kind: WitnessKind
}

data runnable_memory_class_note: String = "Memory class is a structural marker, not a quantity (operator ruling 2026-07-12): the former RunnableMemoryPeak predicted_peak bytes were hand-edited calibration constants — pins freezing derivations, the July OOM regime's root — and the width folds that consumed them are retired. Realization concurrency is now governed adaptively at run time (v1_compiler::memory_governor: AIMD admission against the slot's own cgroup budget, graceful back-off on creep, counted receipts), so the model keeps only the honest structural fact: Negligible vs Substantial residency, which co-residence structure keys on. Quantified per-runnable demand returns when it is derivable from the graph (CostAccount.space measured/derived), not as authored literals."

type RunnableMemoryClass
  = RunnableMemoryNegligible
  | RunnableMemorySubstantial

data runnable_profile_execution_mode_note: String = "execution_mode is the runnable's declared effect envelope (operator posture 2026-07-11): the runner binds the injector the profile declares — Hermetic replays published mocks/recorded fixtures and refuses unmocked effects with typed diagnostics, Wet dispatches live transports, Record dispatches and captures fixtures. The declaration lives on the profile so every runnable kind (gate claim, discovery batch, execution batch) carries it uniformly, beside its resource siblings (spawns_host_compiler is already an effect-class fact). Fail-closed default: runnable_resource_profile_negligible declares Hermetic, so an undeclared-envelope runnable cannot silently reach live effects — it refuses, loudly, at the effect boundary. Future hardening (named trigger, not built here): an OS-level harness that fail-closes on sensed bypasses (shell spawn / network / out-of-root disk IO) beneath the interpreter seam."

type RunnableResourceProfile {
  heavy_whole_tree_resolve: Bool
  spawns_host_compiler: Bool
  memory: RunnableMemoryClass
  execution_mode: ExecutionMode
}

fn runnable_memory_negligible() -> RunnableMemoryClass {
  RunnableMemoryNegligible
}

fn runnable_memory_substantial() -> RunnableMemoryClass {
  RunnableMemorySubstantial
}

fn runnable_memory_class_eq(left: RunnableMemoryClass, right: RunnableMemoryClass) -> Bool {
  match left {
    RunnableMemoryNegligible => match right {
      RunnableMemoryNegligible => true
      RunnableMemorySubstantial => false
    }
    RunnableMemorySubstantial => match right {
      RunnableMemoryNegligible => false
      RunnableMemorySubstantial => true
    }
  }
}

fn runnable_resource_profile_eq(left: RunnableResourceProfile, right: RunnableResourceProfile) -> Bool {
  (left.heavy_whole_tree_resolve == right.heavy_whole_tree_resolve)
    && (left.spawns_host_compiler == right.spawns_host_compiler)
    && runnable_memory_class_eq(left: left.memory, right: right.memory)
    && execution_mode_eq(left: left.execution_mode, right: right.execution_mode)
}

fn runnable_resource_profile_negligible() -> RunnableResourceProfile {
  RunnableResourceProfile {
    heavy_whole_tree_resolve: false
    spawns_host_compiler: false
    memory: runnable_memory_negligible()
    execution_mode: Hermetic
  }
}

fn runnable_resource_profile(
  heavy_whole_tree_resolve: Bool,
  spawns_host_compiler: Bool,
  memory: RunnableMemoryClass,
  execution_mode: ExecutionMode
) -> RunnableResourceProfile {
  RunnableResourceProfile {
    heavy_whole_tree_resolve: heavy_whole_tree_resolve
    spawns_host_compiler: spawns_host_compiler
    memory: memory
    execution_mode: execution_mode
  }
}

fn runnable_excludes_corpus_co_residence(profile: RunnableResourceProfile) -> Bool {
  match profile.memory {
    RunnableMemoryNegligible => false
    RunnableMemorySubstantial => true
  }
}

fn runnable_heavy_whole_tree_resolve(profile: RunnableResourceProfile) -> Bool {
  profile.heavy_whole_tree_resolve
}

fn runnable_profile(r: Runnable) -> RunnableResourceProfile {
  match r {
    RunnableSingleClaim { entry: _, function: _, profile: p } => p
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: p } => p
    RunnableKernelWorkload { fused_op_count: _ } => runnable_resource_profile_negligible()
  }
}

fn runnable_forbids_corpus_co_residence(r: Runnable) -> Bool {
  match r {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => false
    RunnableSingleClaim { entry: _, function: _, profile: p } => runnable_excludes_corpus_co_residence(profile: p)
    RunnableKernelWorkload { fused_op_count: _ } => false
  }
}

type NodeFrontierSelection
  = SelectionOff
  | SelectionApplied
  | SelectionPredictOnly

fn node_frontier_selection_eq(left: NodeFrontierSelection, right: NodeFrontierSelection) -> Bool {
  match left {
    SelectionOff => match right {
      SelectionOff => true
      SelectionApplied => false
      SelectionPredictOnly => false
    }
    SelectionApplied => match right {
      SelectionOff => false
      SelectionApplied => true
      SelectionPredictOnly => false
    }
    SelectionPredictOnly => match right {
      SelectionOff => false
      SelectionApplied => false
      SelectionPredictOnly => true
    }
  }
}

type Runnable
  = RunnableSingleClaim { entry: String, function: String, profile: RunnableResourceProfile }
  | RunnableDiscoveryBatch {
      source_roots: List<String>
      scan_dirs: List<String>
      explicit_entries: List<ScheduleWitnessEntry>
      node_frontier_selection: NodeFrontierSelection
      exclude_substrings: List<String>
      discovery_scope_dirs: List<String>
      profile: RunnableResourceProfile
    }
  | RunnableKernelWorkload { fused_op_count: Int }

fn node_frontier_selection_applied(sel: NodeFrontierSelection) -> Bool {
  match sel {
    SelectionApplied => true
    SelectionOff => false
    SelectionPredictOnly => false
  }
}

fn runnable_selection_applied(r: Runnable) -> Bool {
  match r {
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: sel, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } =>
      node_frontier_selection_applied(sel: sel)
    RunnableSingleClaim { entry: _, function: _, profile: _ } => false
    RunnableKernelWorkload { fused_op_count: _ } => false
  }
}

type Schedule = List<List<Runnable>>

type RealizationPlan<S> {
  target: ContentHash
  objective: RealizationObjective
  schedule: Schedule

  total: CostAccount<S>
}

fn runnable_step_label(r: Runnable) -> String {
  match r {
    RunnableSingleClaim { entry: _, function: f, profile: _ } => f
    RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => "__discovery_corpus__"
    RunnableKernelWorkload { fused_op_count: _ } => "__kernel_workload__"
  }
}

fn schedule_batch_contains_label(batch: List<Runnable>, target: String) -> Bool {
  fold(batch, init: false, f: fn(acc, r) {
    acc || (runnable_step_label(r: r) == target)
  })
}

fn schedule_generates_same_batch_count<S>(left: RealizationPlan<S>, right: RealizationPlan<S>) -> Bool {
  left.schedule.count() == right.schedule.count()
}

fn schedule_witness_entry_eq(a: ScheduleWitnessEntry, b: ScheduleWitnessEntry) -> Bool {
  (a.entry == b.entry) && (a.function == b.function) && witness_kind_eq(a: a.kind, b: b.kind)
}

fn string_list_eq(left: List<String>, right: List<String>) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else if left.first() != right.first() {
    false
  } else {
    string_list_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn schedule_witness_entry_list_eq(left: List<ScheduleWitnessEntry>, right: List<ScheduleWitnessEntry>) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else if !schedule_witness_entry_eq(a: left.first(), b: right.first()) {
    false
  } else {
    schedule_witness_entry_list_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn runnable_eq(left: Runnable, right: Runnable) -> Bool {
  match left {
    RunnableSingleClaim { entry: le, function: lf, profile: lp } => match right {
      RunnableSingleClaim { entry: re, function: rf, profile: rp } =>
        (le == re) && (lf == rf) && runnable_resource_profile_eq(left: lp, right: rp)
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => false
      RunnableKernelWorkload { fused_op_count: _ } => false
    }
    RunnableDiscoveryBatch { source_roots: lsr, scan_dirs: lsd, explicit_entries: lex, node_frontier_selection: lskip, exclude_substrings: lex2, discovery_scope_dirs: lsc, profile: lp } => match right {
      RunnableSingleClaim { entry: _, function: _, profile: _ } => false
      RunnableDiscoveryBatch { source_roots: rsr, scan_dirs: rsd, explicit_entries: rex, node_frontier_selection: rskip, exclude_substrings: rex2, discovery_scope_dirs: rsc, profile: rp } =>
        string_list_eq(left: lsr, right: rsr)
          && string_list_eq(left: lsd, right: rsd)
          && schedule_witness_entry_list_eq(left: lex, right: rex)
          && node_frontier_selection_eq(left: lskip, right: rskip)
          && string_list_eq(left: lex2, right: rex2)
          && string_list_eq(left: lsc, right: rsc)
          && runnable_resource_profile_eq(left: lp, right: rp)
      RunnableKernelWorkload { fused_op_count: _ } => false
    }
    RunnableKernelWorkload { fused_op_count: lleft } => match right {
      RunnableSingleClaim { entry: _, function: _, profile: _ } => false
      RunnableDiscoveryBatch { source_roots: _, scan_dirs: _, explicit_entries: _, node_frontier_selection: _, exclude_substrings: _, discovery_scope_dirs: _, profile: _ } => false
      RunnableKernelWorkload { fused_op_count: rcount } => lleft == rcount
    }
  }
}

fn runnable_batch_eq(left: List<Runnable>, right: List<Runnable>) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else if !runnable_eq(left: left.first(), right: right.first()) {
    false
  } else {
    runnable_batch_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn schedule_eq(left: Schedule, right: Schedule) -> Bool {
  if left.count() != right.count() {
    false
  } else if left.count() == 0 {
    true
  } else if !runnable_batch_eq(left: left.first(), right: right.first()) {
    false
  } else {
    schedule_eq(left: left.skip(n: 1), right: right.skip(n: 1))
  }
}

fn schedule_generates_identical_schedule<S>(plan: RealizationPlan<S>, schedule: Schedule) -> Bool {
  schedule_eq(left: plan.schedule, right: schedule)
}
