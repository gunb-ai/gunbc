module std.claim_evidence

import std.types { Bool, List, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.assurance.claim_evidence {
  sacm_claim_evidence_authority,
  w3c_prov_dm_authority,
  belnap_four_valued_information_authority,
}

data claim_evidence_grounding_authorities: List<ExternalAuthority> = [
  sacm_claim_evidence_authority,
  w3c_prov_dm_authority,
  belnap_four_valued_information_authority,
]

type RecordedFactId = NonEmptyStr where brand("RecordedFactId")
type ClaimId = NonEmptyStr where brand("ClaimId")
type InferenceRuleId = NonEmptyStr where brand("InferenceRuleId")
type ProvEntityId = NonEmptyStr where brand("ProvEntityId")
type ProvActivityId = NonEmptyStr where brand("ProvActivityId")
type ProvAgentId = NonEmptyStr where brand("ProvAgentId")

type RecordedFact<F> {
  id: RecordedFactId
  value: F
}

type Claim<S, T, P, Scope, Bound> {
  id: ClaimId
  subject: S
  target: T
  proposition: P
  scope: Scope
  bound: Bound
}

type EvidenceProvenance {
  entity: ProvEntityId
  activity: ProvActivityId
  agent: ProvAgentId
}

type EvidenceFreshness<Bound> {
  bound: Bound
  basis: NonEmptyStr
}

type EvidenceFidelity<Boundary> {
  boundary: Boundary
  losses: List<NonEmptyStr>
}

type EvidenceDirection
  = EvidenceSupports
  | EvidenceChallenges

type EvidenceDirectionFold<R> {
  supports: R
  challenges: R
}

fn evidence_direction_fold<R>(
  direction: EvidenceDirection,
  fold: EvidenceDirectionFold<R>,
) -> R {
  match direction {
    EvidenceSupports => fold.supports
    EvidenceChallenges => fold.challenges
  }
}

type EvidenceLink<F, C, A, FreshBound, FidelityBoundary, Independence> {
  fact: RecordedFact<F>
  direction: EvidenceDirection
  inference_rule: InferenceRuleId
  authority: A
  provenance: EvidenceProvenance
  freshness: EvidenceFreshness<FreshBound>
  fidelity: EvidenceFidelity<FidelityBoundary>
  probe_independence: Independence
  maximum_conclusion: C
}

type EvidenceInsufficiency<F, C, Independence> {
  fact: RecordedFact<F>
  claim: C
  inference_rule: InferenceRuleId
  probe_independence: Independence
  reason: NonEmptyStr
}

type EvidenceInference<F, C, A, FreshBound, FidelityBoundary, Independence>
  = EvidenceApplicable {
      link: EvidenceLink<F, C, A, FreshBound, FidelityBoundary, Independence>,
    }
  | EvidenceInsufficient {
      insufficiency: EvidenceInsufficiency<F, C, Independence>,
    }

type EvidenceInferenceFold<F, C, A, FreshBound, FidelityBoundary, Independence, R> {
  applicable: fn(
    EvidenceLink<F, C, A, FreshBound, FidelityBoundary, Independence>,
  ) -> R
  insufficient: fn(EvidenceInsufficiency<F, C, Independence>) -> R
}

fn evidence_inference_fold<F, C, A, FreshBound, FidelityBoundary, Independence, R>(
  inference: EvidenceInference<F, C, A, FreshBound, FidelityBoundary, Independence>,
  fold: EvidenceInferenceFold<F, C, A, FreshBound, FidelityBoundary, Independence, R>,
) -> R {
  match inference {
    EvidenceApplicable { link: link } => fold.applicable(link)
    EvidenceInsufficient { insufficiency: insufficiency } =>
      fold.insufficient(insufficiency)
  }
}

fn applicable_evidence_inference<F, C, A, FreshBound, FidelityBoundary, Independence>(
  link: EvidenceLink<F, C, A, FreshBound, FidelityBoundary, Independence>,
) -> EvidenceInference<F, C, A, FreshBound, FidelityBoundary, Independence> {
  EvidenceApplicable { link: link }
}

fn insufficient_evidence_inference<F, C, A, FreshBound, FidelityBoundary, Independence>(
  insufficiency: EvidenceInsufficiency<F, C, Independence>,
) -> EvidenceInference<F, C, A, FreshBound, FidelityBoundary, Independence> {
  EvidenceInsufficient { insufficiency: insufficiency }
}

fn evidence_inference_links<F, C, A, FreshBound, FidelityBoundary, Independence>(
  inference: EvidenceInference<F, C, A, FreshBound, FidelityBoundary, Independence>,
) -> List<EvidenceLink<F, C, A, FreshBound, FidelityBoundary, Independence>> {
  evidence_inference_fold(
    inference: inference,
    fold: EvidenceInferenceFold {
      applicable: fn(link) { [link] },
      insufficient: fn(_) { [] },
    },
  )
}

fn evidence_inference_insufficiencies<F, C, A, FreshBound, FidelityBoundary, Independence>(
  inference: EvidenceInference<F, C, A, FreshBound, FidelityBoundary, Independence>,
) -> List<EvidenceInsufficiency<F, C, Independence>> {
  evidence_inference_fold(
    inference: inference,
    fold: EvidenceInferenceFold {
      applicable: fn(_) { [] },
      insufficient: fn(insufficiency) { [insufficiency] },
    },
  )
}

type ClaimAssessment<F, C, A, FreshBound, FidelityBoundary, Independence> {
  evidence: List<EvidenceLink<F, C, A, FreshBound, FidelityBoundary, Independence>>
}

fn claim_assessment_from_links<F, C, A, FreshBound, FidelityBoundary, Independence>(
  claim: C,
  links: List<EvidenceLink<F, C, A, FreshBound, FidelityBoundary, Independence>>,
) -> ClaimAssessment<F, C, A, FreshBound, FidelityBoundary, Independence> {
  ClaimAssessment {
    evidence: links |> filter(link => link.maximum_conclusion == claim),
  }
}

type ClaimInformationState {
  support: Bool
  challenge: Bool
}

fn claim_information_state<F, C, A, FreshBound, FidelityBoundary, Independence>(
  claim: C,
  assessment: ClaimAssessment<F, C, A, FreshBound, FidelityBoundary, Independence>,
) -> ClaimInformationState {
  let evidence = assessment.evidence
    |> filter(link => link.maximum_conclusion == claim)
  ClaimInformationState {
    support: any(evidence, link =>
      evidence_direction_fold(
        direction: link.direction,
        fold: EvidenceDirectionFold {
          supports: true,
          challenges: false,
        },
      )
    ),
    challenge: any(evidence, link =>
      evidence_direction_fold(
        direction: link.direction,
        fold: EvidenceDirectionFold {
          supports: false,
          challenges: true,
        },
      )
    ),
  }
}

fn claim_assessment_supports_without_challenge<F, C, A, FreshBound, FidelityBoundary, Independence>(
  claim: C,
  assessment: ClaimAssessment<F, C, A, FreshBound, FidelityBoundary, Independence>,
) -> Bool {
  let state = claim_information_state(
    claim: claim,
    assessment: assessment,
  )
  state.support && !state.challenge
}

type ClaimReadinessPolicy<C> {
  required: List<C>
}

type ClaimReadinessAssessment<C>
  = ClaimReadinessSatisfied { claim: C }
  | ClaimReadinessBlocking { claim: C }

type ClaimReadinessAssessmentFold<C, R> {
  satisfied: fn(C) -> R
  blocking: fn(C) -> R
}

fn claim_readiness_assessment_fold<C, R>(
  assessment: ClaimReadinessAssessment<C>,
  fold: ClaimReadinessAssessmentFold<C, R>,
) -> R {
  match assessment {
    ClaimReadinessSatisfied { claim } => fold.satisfied(claim)
    ClaimReadinessBlocking { claim } => fold.blocking(claim)
  }
}

fn claim_supported_without_challenge_across_assessments<F, C, A, FreshBound, FidelityBoundary, Independence>(
  claim: C,
  assessments: List<ClaimAssessment<F, C, A, FreshBound, FidelityBoundary, Independence>>,
) -> Bool {
  let states = assessments
    |> map(assessment =>
      claim_information_state(
        claim: claim,
        assessment: assessment,
      )
    )
  any(states, state => state.support)
    && !any(states, state => state.challenge)
}

fn claim_readiness_assessment<F, C, A, FreshBound, FidelityBoundary, Independence>(
  policy: ClaimReadinessPolicy<C>,
  assessments: List<ClaimAssessment<F, C, A, FreshBound, FidelityBoundary, Independence>>,
) -> List<ClaimReadinessAssessment<C>> {
  policy.required |> map(required =>
    if claim_supported_without_challenge_across_assessments(
      claim: required,
      assessments: assessments,
    ) {
      ClaimReadinessSatisfied { claim: required }
    } else {
      ClaimReadinessBlocking { claim: required }
    }
  )
}

fn claim_readiness_is_ready<C>(
  assessment: List<ClaimReadinessAssessment<C>>,
) -> Bool {
  all(assessment, row =>
    claim_readiness_assessment_fold(
      assessment: row,
      fold: ClaimReadinessAssessmentFold {
        satisfied: fn(_) { true },
        blocking: fn(_) { false },
      },
    )
  )
}

data claim_evidence_boundary_note: NonEmptyStr = "A recorded fact enters a claim assessment only through an explicit EvidenceLink. ClaimAssessment stores only canonical links, never caller-supplied support or challenge lists; every information-state and readiness query re-indexes those links by maximum_conclusion and consumes direction through the canonical fold. EvidenceInference is an exclusive Applicable-with-that-canonical-link | Insufficient outcome. ClaimInformationState is the product of two independent assessment bits, so conflict and insufficiency cannot collapse into chronology or a Boolean last observation. ClaimReadinessPolicy produces one exclusive Satisfied | Blocking assessment for each named requirement and admits only support without challenge; missing, conflicting, and challenge-only assessments remain blocking."
