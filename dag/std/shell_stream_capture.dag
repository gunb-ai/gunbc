module std.shell_stream_capture

import std.types { String, Bool, Int }
import std.measure { byte_size_count, ByteSize }

data shell_stream_capture_authority_note: String = "BOUNDED SHELL STREAM CAPTURE closes the srv1 roadmap-serve wedge class where a child subprocess wrote ~59.5 MiB to stderr while exiting 0, and the host realization materialized the entire stream into an owned runtime String that downstream .dag ignored. Policy lives here; the seed interpreter in shell_stream_capture.rs drains stdout and stderr concurrently while the child runs and enforces these limits during read — never allocate-then-truncate after wait_with_output (operator brief 2026-08-09, node adhoc-02b6693e-e6a)."

type StreamCapturePolicy
  = CaptureDiscarded
  | CaptureBounded { max_retained_bytes: ByteSize }
  | CaptureDigestAndBoundedTail { max_tail_bytes: ByteSize }
  | CaptureToArtifact {
      path: String,
      max_retained_bytes: ByteSize,
    }

type CapturedStreamObservation {
  total_bytes: Int
  retained_bytes: Int
  truncated: Bool
  digest_hex: String
  retained: String
}

data default_shell_stdout_max_retained_bytes: ByteSize = byte_size(count: 8388608)

data default_shell_stderr_tail_bytes: ByteSize = byte_size(count: 16384)

fn default_shell_stdout_capture_policy() -> StreamCapturePolicy {
  CaptureBounded {
    max_retained_bytes: default_shell_stdout_max_retained_bytes,
  }
}

fn default_shell_stderr_capture_policy() -> StreamCapturePolicy {
  CaptureDigestAndBoundedTail {
    max_tail_bytes: default_shell_stderr_tail_bytes,
  }
}

fn captured_stream_truncated(
  total_bytes: Int,
  retained_bytes: Int,
) -> Bool {
  total_bytes > retained_bytes
}

fn captured_stream_retained_within_policy(
  policy: StreamCapturePolicy,
  observation: CapturedStreamObservation,
) -> Bool {
  match policy {
    CaptureDiscarded => {
      observation.retained_bytes == 0
        && observation.retained == ""
    }
    CaptureBounded { max_retained_bytes: max } => {
      observation.retained_bytes <= byte_size_count(b: max)
    }
    CaptureDigestAndBoundedTail { max_tail_bytes: max } => {
      observation.retained_bytes <= byte_size_count(b: max)
    }
    CaptureToArtifact { max_retained_bytes: max, path: _ } => {
      observation.retained_bytes <= byte_size_count(b: max)
    }
  }
}
