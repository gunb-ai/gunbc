module std.shell_stream_capture

import std.types { String, Bool }
import std.measure { byte_size, byte_size_count, measure_le, ByteSize }

data seed_host_shell_stream_bounded_drain_scaffold_note: String = "INTERIM v1_interpreter seed host-effect only (operator ruling #8087, 2026-08-09): dispatch_shell drains child stdout/stderr concurrently while the child runs — never wait_with_output-then-truncate. Stdout must be complete within seed_host_shell_stdout_complete_max_bytes or the seed refuses ShellOutputLimitExceeded; stderr keeps total byte count + digest + bounded tail with explicit truncation. This module is NOT the production policy authority — it records scaffold constants and witness predicates until emit-on-demand native serve and the shared CapturedProcessStream carrier (#8089) subsume the seed drain."

data seed_host_shell_stream_bounded_drain_dissolve_on: String = "dissolve-on: roadmap-serve-emitted-realization emit-on-demand native serve lands AND bounded shell stream capture is enforced on the production host-effect seam with CapturedProcessStream evidence consumed by the channel provider adapter — then delete this scaffold module and the v1_interpreter bounded_shell_host_drain child module."

data seed_host_shell_stdout_complete_max_bytes: ByteSize = byte_size(count: 8388608)

data seed_host_shell_stderr_tail_bytes: ByteSize = byte_size(count: 16384)

fn seed_host_stderr_tail_within_bound(
  total_bytes: ByteSize,
  retained_bytes: ByteSize,
) -> Bool {
  measure_le(a: retained_bytes, b: seed_host_shell_stderr_tail_bytes)
    && measure_le(a: retained_bytes, b: total_bytes)
}

fn seed_host_stdout_complete_within_bound(
  total_bytes: ByteSize,
  limit: ByteSize,
) -> Bool {
  measure_le(a: total_bytes, b: limit)
}

fn seed_host_stdout_overflow_would_refuse(
  total_bytes: ByteSize,
  limit: ByteSize,
) -> Bool {
  measure_le(a: limit, b: total_bytes)
    && !measure_le(a: total_bytes, b: limit)
}
