module std.content_hash

import std.types { ContentHash, NonEmptyStr }

fn content_hash_atom(value: NonEmptyStr) -> ContentHash {
  atom_identity_hash(value) as ContentHash
}

fn content_hash_combine(left: ContentHash, right: ContentHash) -> ContentHash {
  hash_combine(left, right) as ContentHash
}

fn content_hash_tagged(tag: NonEmptyStr, payload: ContentHash) -> ContentHash {
  content_hash_combine(content_hash_atom(value: tag), payload)
}
