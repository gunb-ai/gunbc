module std.error_primitives

type Result<ok, err> = Ok { value: ok } | Err { value: err }

type DivError = DivideByZero | Overflow

// Bottom lives on std.types Never: never() produces it and absurd<T> eliminates it. The Int /
// Float / String projections that used to stand here are deleted; this module stays import-free
// so Result and DivError do not cycle with std.types → std.algebra.
