module std.error_primitives

type Result<ok, err> = Ok { value: ok } | Err { value: err }

type DivError = DivideByZero | Overflow

// THE UNINHABITED TYPE, AND WHY IT LIVES HERE RATHER THAN BESIDE Unit. std.types imports
// std.algebra, so algebra cannot import types. This module imports nothing, so both can name
// Never. A dag-tree module may import it (v2.std.cross_tree.import_model: dag may not import v2).
// An arm instantiated at Never has no constructor: the binding declares that arm unreachable for
// that subject (std.goal_assessment AssessRefusal).
type Never

// THE ONE HOST PRODUCER OF NEVER. Never has no constructor. Checker narrowing is a separate
// capability (gunbc.guarantee_stall never_producer_is_runtime_divergence_stall): this function
// mints a Never from no proof. Call sites of never() / absurd(never()) are mitigatable runtime
// divergences, not a bottom-type discharge.
//
// Body shape is HostRealizedSeam (std.primitive_projection primitive_never): the interpreter
// arm free_call.never and v1_rt::never refuse by this declaration's identity if the seam is
// evaluated. The dag self-call is the seam marker, not the refusal; the named host arm is.
fn never() -> Never {
  never()
}

// THE ELIMINATOR. Zero arms are exhaustive iff the scrutinee is an uninhabited sum (a coproduct
// with zero arms, or this Never declaration by identity). An opaque without dag constructors is
// not uninhabited. absurd inhabits every T; it cannot be applied to an Int. A call
// absurd(never()) is still the host producer plus this match, not a proved unreachable arm.
fn absurd<T>(n: Never) -> T {
  match (n) {
  }
}
