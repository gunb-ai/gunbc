module std.optional_layers

import std.types { Bool }
import std.nat { Nat, Succ, Zero, nat_add }
import std.optional { Absent, Optional, Present, optional_absent, optional_present }

// INHABITANCE OPTIONALITY COUNTED ON std.nat (review 78490: OptionalLayers was a second Peano
// tower). Zero optional layers is only Required. One or more is CardOptional { extra: Nat }, where
// extra is the count BEYOND the first layer (Zero = T?, Succ{Zero} = T??). CardOptional cannot
// express zero layers; Nat cannot express a negative. gunbc#13488's named OneLayer|MoreLayers
// tower is the same successor algebra; this spelling inhabits std.nat instead of minting it again
// (DESIGN §2). Host Nat is kernel-integer cost (std.nat).
//
// CONSUMERS (DESIGN §3c): v2.std.optional_layers type_node_cardinality_read and
// wrap_type_node_cardinality. Production: v2.compiler.infer infer_match_generic_formal peels with
// peel_optional_layer; v2.std.inhabitance declared_type_inhabitance refuses two CardOptional
// counts that exact_optional_layers denies (inhabitance_optional_layer_depth_mismatch). Claims:
// test.claim.optional_layers_witness_test and v2.test.claim.compiler.optional_layers_test.
//
// Named operations, not one max-join (gunbc#13488): composition is nat_add of extras plus the
// extra first layer; peel is predecessor; exact is Nat equality of extras.
type TypeCardinality
  = Required
  | CardOptional { extra: Nat }

fn compose_optional_layers(outer: TypeCardinality, inner: TypeCardinality) -> TypeCardinality {
  match outer {
    Required => inner
    CardOptional { extra: oe } =>
      match inner {
        Required => CardOptional { extra: oe }
        CardOptional { extra: ie } => CardOptional { extra: Succ { prev: nat_add(a: oe, b: ie) } }
      }
  }
}

fn peel_optional_layer(card: TypeCardinality) -> Optional<TypeCardinality> {
  match card {
    Required => optional_absent()
    CardOptional { extra: e } =>
      match e {
        Zero => optional_present(value: Required)
        Succ { prev: rest } => optional_present(value: CardOptional { extra: rest })
      }
  }
}

fn one_optional_layer() -> TypeCardinality {
  CardOptional { extra: Zero }
}

fn two_optional_layers() -> TypeCardinality {
  CardOptional { extra: Succ { prev: Zero } }
}

fn exact_optional_layers(a: TypeCardinality, b: TypeCardinality) -> Bool {
  match a {
    Required =>
      match b {
        Required => true
        CardOptional { extra: _ } => false
      }
    CardOptional { extra: ae } =>
      match b {
        Required => false
        CardOptional { extra: be } => ae == be
      }
  }
}
