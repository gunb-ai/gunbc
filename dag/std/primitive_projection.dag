module std.primitive_projection

import std.decl_ref { DeclarationRef, decl_ref, declaration_ref_eq }
import std.types { List, NonEmptyStr, String }

// The declaration-to-primitive projection is a seed-consumed substrate authority, so its import
// closure stops at std.decl_ref/std.types and never reaches a target roster or v2 module. This
// module is a strict relocation of the projection identity, fidelity, roster, and exact-declaration
// query formerly declared inside std.primitive_identity. std.primitive_identity consumes this
// authority for its census and total disposed/undisposed answer; the stage0 resolver consumes the
// same exact-declaration query. Required regen is the mechanical wall: src/v1 importing the former
// home reached gunbc.v1.v1_interpreter_primitive_surface and then v2.std.qualified_name, which the
// src/v1 + dag bootstrap closure correctly refuses. The refusal is the seed-safety boundary
// working, not build friction.

data primitive_identity_slug_prefix: String = "primitive."

type PrimitiveIdentity { slug: NonEmptyStr }

fn primitive_identity_slug(name: String) -> PrimitiveIdentity {
  PrimitiveIdentity { slug: concat(primitive_identity_slug_prefix, name) as NonEmptyStr }
}

// The slug is the authority for a primitive's identity, so the runtime name a bridge is spelled
// with is DERIVED from it rather than stored beside it. Storing the bare name as a second field
// would let the two disagree; the prefix is one row and this is its exact inverse.
fn primitive_identity_runtime_name(identity: PrimitiveIdentity) -> String {
  let slug = identity.slug as String
  substring(s: slug, start: string_length(s: primitive_identity_slug_prefix), end: string_length(s: slug))
}

// The projection is keyed on std.decl_ref DeclarationRef, which is the namespace layer's own
// identity for a declaration (DESIGN section 3: namespace supplies declaration identity, this
// carrier supplies semantic primitive identity). No new identity type is minted here. The
// alternative shape considered and refused was a per-declaration marker row beside each fn: it is a
// second representation scattered across modules rather than one authority, it keys on a bare name
// inside a module scope so two same-named declarations collapse into one, and it has no room for a
// fidelity distinction. Module qualification answers the second; this single carrier answers the
// first; ProjectionFidelity answers the third.

// HostRealizedSeam and ModeledProjection agree at the resolver -- both mean the declaration and the
// primitive are ONE authority, so a candidate collector must not report them as two. They are kept
// apart because they are different facts with different futures, and averaging them into one flag
// would erase the difference. A HostRealizedSeam body is a SELF-CALL (v2.std.decl_index decl_facts
// is decl_facts(pool_roots: pool_roots)): it is correct by construction, because a body that could
// never survive being reached is exactly what a declared host seam should look like -- reaching it
// recurses to the evaluation-budget refusal. A ModeledProjection body is REAL CODE that the builtin
// arm intercepts ahead of user-fn dispatch (std.algebra length has a genuine fold_list body no
// bare call reaches): it is dead code that looks live, and someone will eventually edit it
// believing it runs. This carrier makes that observable rather than folklore. Repairing the
// dead-code half is NOT this carrier's job and is not claimed here.

type ProjectionFidelity
  = HostRealizedSeam
  | ModeledProjection
  | DivergentProjection { divergence: NonEmptyStr }

type PrimitiveProjection {
  primitive: PrimitiveIdentity
  declaration: DeclarationRef
  fidelity: ProjectionFidelity
}

type PrimitiveProjectionAnswer
  = DeclarationProjectsPrimitive {
      identity: PrimitiveIdentity
      fidelity: ProjectionFidelity
    }
  | DeclarationProjectsNoPrimitive
  | DeclarationPrimitiveUndisposed { authored_symbol: NonEmptyStr }

data primitive_length: PrimitiveIdentity = primitive_identity_slug(name: "length")
data primitive_map_insert: PrimitiveIdentity = primitive_identity_slug(name: "map_insert")
data primitive_map_get: PrimitiveIdentity = primitive_identity_slug(name: "map_get")
data primitive_lookup: PrimitiveIdentity = primitive_identity_slug(name: "lookup")
data primitive_get: PrimitiveIdentity = primitive_identity_slug(name: "get")
data primitive_empty_map: PrimitiveIdentity = primitive_identity_slug(name: "empty_map")
data primitive_decl_facts: PrimitiveIdentity = primitive_identity_slug(name: "decl_facts")
data primitive_decl_facts_at: PrimitiveIdentity = primitive_identity_slug(name: "decl_facts_at")
data primitive_export_signature_facts: PrimitiveIdentity = primitive_identity_slug(name: "export_signature_facts")
data primitive_data_decl_type_facts: PrimitiveIdentity = primitive_identity_slug(name: "data_decl_type_facts")
data primitive_concept_decl_facts: PrimitiveIdentity = primitive_identity_slug(name: "concept_decl_facts")
data primitive_concept_decl_facts_live: PrimitiveIdentity = primitive_identity_slug(name: "concept_decl_facts_live")
data primitive_symbol_lexeme: PrimitiveIdentity = primitive_identity_slug(name: "symbol_lexeme")
data primitive_symbol_intern_lexeme: PrimitiveIdentity = primitive_identity_slug(name: "symbol_intern_lexeme")
data primitive_data_init_decl_facts_live: PrimitiveIdentity = primitive_identity_slug(name: "data_init_decl_facts_live")
data primitive_bytes_octets: PrimitiveIdentity = primitive_identity_slug(name: "bytes_octets")
data primitive_utf8_encode_bytes: PrimitiveIdentity = primitive_identity_slug(name: "utf8_encode_bytes")
data primitive_octets_bytes: PrimitiveIdentity = primitive_identity_slug(name: "octets_bytes")
data primitive_pure_dag_seam_unreachable: PrimitiveIdentity = primitive_identity_slug(name: "pure_dag_seam_unreachable")
data primitive_to_string: PrimitiveIdentity = primitive_identity_slug(name: "to_string")

// THE DECLARATION IDENTITY of std.error_primitives Never / absurd. Emit, v1 exhaustiveness and
// v2 match coproduct-read consume these refs; they do not restate the module or name as string
// helpers. Never has no producer.
data never_type_declaration: DeclarationRef = decl_ref(module_path: "std.error_primitives", decl_name: "Never")
data never_eliminator_declaration: DeclarationRef = decl_ref(module_path: "std.error_primitives", decl_name: "absurd")
// THE PER-RESULT-TYPE ELIMINATIONS OF THE ONE DIVERGENT SEAM (std.error_primitives
// pure_dag_seam_unreachable_int / _float / _string, each absurd over the Never-typed seam). Rust emission
// gives exactly these items, and absurd, an item-level allow(unreachable_code): rustc refuses a call with
// an uninhabited argument at the caller, so the elimination lives in these items and no caller allows.
data never_projection_declarations: List<DeclarationRef> = [
  decl_ref(module_path: "std.error_primitives", decl_name: "pure_dag_seam_unreachable_int"),
  decl_ref(module_path: "std.error_primitives", decl_name: "pure_dag_seam_unreachable_float"),
  decl_ref(module_path: "std.error_primitives", decl_name: "pure_dag_seam_unreachable_string")
]

fn never_type_qualified_path() -> String {
  concat(never_type_declaration.module_path as String, ".", never_type_declaration.decl_name as String)
}
data primitive_list_push: PrimitiveIdentity = primitive_identity_slug(name: "list_push")
data primitive_shell_materialize_operation_argv: PrimitiveIdentity = primitive_identity_slug(name: "shell_materialize_operation_argv")
data primitive_map_keys: PrimitiveIdentity = primitive_identity_slug(name: "map_keys")
data primitive_string_contains: PrimitiveIdentity = primitive_identity_slug(name: "string_contains")
data primitive_chars: PrimitiveIdentity = primitive_identity_slug(name: "chars")
data primitive_sha256_hex_of_text: PrimitiveIdentity = primitive_identity_slug(name: "sha256_hex_of_text")
data primitive_machine_word_native_operate: PrimitiveIdentity = primitive_identity_slug(name: "machine_word_native_operate")
data primitive_compile_dag_diagnostic_census: PrimitiveIdentity = primitive_identity_slug(name: "compile_dag_diagnostic_census")

data symbol_lexeme_seam_disposition_note: String = "THE TWO SYMBOL BRIDGES WERE HOST SEAMS THAT NOTHING SAID WERE HOST SEAMS, and the cost of that silence is why they are rostered here rather than left alone. v2.std.compilers.lexing symbol_lexeme and symbol_intern_lexeme have self-call bodies -- the HostRealizedSeam shape exactly, correct by construction because reaching one recurses to the evaluation-budget refusal -- and the interpreter has carried real arms for both since they were written (gunbc.v1.v1_interpreter_primitive_surface v4_bridge.symbol_lexeme, v4_bridge.symbol_intern_lexeme). But with no roster row the RESOLVER saw an ordinary declaration, so Rust emission emitted the declaration, and `pub fn symbol_lexeme(sym: String) -> String { symbol_lexeme(sym) }` COMPILES. The emitted v2 compiler closure therefore carried two functions that type-check, pass every gate we own, and diverge from the interpreter by not terminating -- the DESIGN section 5 fabricated-plausible-output failure in its quietest form, since unlike the sibling seams (decl_facts and friends, which at least refuse loudly as unresolved v1_rt symbols) nothing anywhere reports this one.

WHAT MAKES THE RUST REALIZATION HONEST RATHER THAN A SHIM: extdeps.languages.rust.types already declares Symbol's target type as String, so on that target the interning table is the identity and both bridges ARE identity functions. That is a realization of the declared row, not a second opinion about it; a target where Symbol is NOT String would need a different realization and the registry is where it would say so. The interpreter's arms and the Rust registry rows now answer for the same two primitives, which is the agreement that was missing.

THE RESIDUE IS NAMED, NOT CLOSED: a self-call body is a DECIDABLE structural marker of a host seam, so the compiler could refuse an unrealized one instead of emitting it. It does not yet, and until it does this roster is the only thing standing between a new v4_bridge declaration and another silently nonterminating emission. That check is this class's next-rung trigger."

// One row per declaration that is the modeled surface of a declared primitive. Every row was
// established by READING THE DECLARATION, not by matching its name: the HostRealizedSeam rows are
// declarations whose whole body is a self-call, and the ModeledProjection rows are declarations
// with a real body that the builtin arm intercepts ahead of. The single DivergentProjection row is
// v2.std.collection map_get, whose declared return type is Outcome<Optional<V>> against the
// primitive's Optional<V>; it is carried rather than omitted because omission and divergence are
// different answers -- omission means nobody has looked, divergence means someone looked and found
// two authorities. A consumer collecting call candidates must suppress the builtin co-candidate for
// the first two fidelities and must keep refusing on the third.

fn primitive_projection_row(primitive: PrimitiveIdentity, module_path: String, decl_name: String, fidelity: ProjectionFidelity) -> PrimitiveProjection {
  PrimitiveProjection { primitive: primitive, declaration: decl_ref(module_path: module_path, decl_name: decl_name), fidelity: fidelity }
}

fn primitive_projection_roster() -> List<PrimitiveProjection> {
  [
    primitive_projection_row(primitive: primitive_decl_facts, module_path: "v2.std.decl_index", decl_name: "decl_facts", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_decl_facts_at, module_path: "v2.std.decl_index", decl_name: "decl_facts_at", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_export_signature_facts, module_path: "v2.std.decl_index", decl_name: "export_signature_facts", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_data_decl_type_facts, module_path: "v2.std.decl_index", decl_name: "data_decl_type_facts", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_concept_decl_facts, module_path: "v2.std.concept_index", decl_name: "concept_decl_facts", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_concept_decl_facts_live, module_path: "v2.std.concept_index", decl_name: "concept_decl_facts_live", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_empty_map, module_path: "std.algebra", decl_name: "empty_map_primitive_delegate", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_map_insert, module_path: "std.algebra", decl_name: "map_insert_primitive_delegate", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_lookup, module_path: "std.algebra", decl_name: "map_lookup_primitive_delegate", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_get, module_path: "std.algebra", decl_name: "list_at_primitive_delegate", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_symbol_lexeme, module_path: "v2.std.node", decl_name: "symbol_lexeme", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_symbol_intern_lexeme, module_path: "v2.std.node", decl_name: "symbol_intern_lexeme", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_data_init_decl_facts_live, module_path: "v2.std.data_index", decl_name: "data_init_decl_facts_live", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_bytes_octets, module_path: "std.bytes", decl_name: "bytes_octets", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_utf8_encode_bytes, module_path: "std.bytes", decl_name: "utf8_encode_bytes", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_octets_bytes, module_path: "std.bytes", decl_name: "octets_bytes", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_pure_dag_seam_unreachable, module_path: "std.error_primitives", decl_name: "pure_dag_seam_unreachable", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_list_push, module_path: "std.algebra", decl_name: "list_push", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_shell_materialize_operation_argv, module_path: "std.operation_argv", decl_name: "shell_materialize_operation_argv", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_map_keys, module_path: "std.algebra", decl_name: "map_keys", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_string_contains, module_path: "std.algebra", decl_name: "string_contains", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_chars, module_path: "std.host_text", decl_name: "chars", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_sha256_hex_of_text, module_path: "std.content_hash", decl_name: "sha256_hex_of_text", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_machine_word_native_operate, module_path: "std.machine_word", decl_name: "machine_word_native_operate", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_compile_dag_diagnostic_census, module_path: "gunbc.compile_diagnostic_census", decl_name: "compile_dag_diagnostic_census", fidelity: HostRealizedSeam),
    primitive_projection_row(primitive: primitive_length, module_path: "std.algebra", decl_name: "length", fidelity: ModeledProjection),
    primitive_projection_row(primitive: primitive_map_insert, module_path: "std.algebra", decl_name: "map_insert", fidelity: ModeledProjection),
    primitive_projection_row(primitive: primitive_lookup, module_path: "std.algebra", decl_name: "map_lookup", fidelity: ModeledProjection),
    primitive_projection_row(primitive: primitive_get, module_path: "std.algebra", decl_name: "list_at_optional", fidelity: ModeledProjection),
    primitive_projection_row(primitive: primitive_empty_map, module_path: "std.algebra", decl_name: "empty_map", fidelity: ModeledProjection),
    primitive_projection_row(primitive: primitive_map_get, module_path: "v2.std.witness", decl_name: "map_get_checked", fidelity: DivergentProjection { divergence: "declared return Outcome<Optional<V>> against the primitive's Optional<V>" as NonEmptyStr }),
  ]
}

fn primitive_projection_row_for_declaration(declaration: DeclarationRef) -> PrimitiveProjection? {
  primitive_projection_roster()
    |> fold(init: none, f: fn(acc, row) {
      match acc {
        Present { value: _ } => acc
        Absent => if declaration_ref_eq(a: row.declaration, b: declaration) { Present { value: row } } else { acc }
      }
    })
}
