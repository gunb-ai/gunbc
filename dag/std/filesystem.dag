module std.filesystem

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.encoding { Encoding, is_text_encoding }
import std.types { FilePath, MimeType, String }
import std.filesystem.types { EntryKind, SymlinkTarget }
import std.optional { Absent, Present }
import std.algebra { list_tail, list_head }

type FileEntry {
  path: FilePath
  kind: EntryKind
  encoding: Encoding?
  symlink_target: SymlinkTarget?
  size: Int
  mime: MimeType?
}

type FileClassification = FileEntry

type ReadableEntry = FileEntry where is_text_readable

type PartitionResult {
  readable: List<FileEntry>
  skipped: List<FileEntry>
}

fn is_text_readable(entry: FileEntry) -> Bool {
  match entry.kind {
    RegularFile => is_text_encoding_optional(e: entry.encoding)
    Symlink     => entry.symlink_target == Present { value: TargetFile } && is_text_encoding_optional(e: entry.encoding)
    Directory   => false
    Missing     => false
    Other       => false
  }
}

fn is_text_encoding_optional(e: Encoding?) -> Bool {
  match e {
    Present { value: enc } => is_text_encoding(e: enc)
    Absent => false
  }
}

fn partition_entries(entries: List<FileEntry>) -> PartitionResult {
  readable = filter(entries, e => is_text_readable(entry: e))
  skipped  = filter(entries, e => !is_text_readable(entry: e))
  return { readable: readable, skipped: skipped }
}

fn skip_reason(entry: FileEntry) -> String {
  match entry.kind {
    Directory   => "directory"
    Missing     => "missing"
    Other       => "special file"
    Symlink     => match entry.symlink_target {
      Present { value: target } => match target {
        TargetDir  => "symlink to directory"
        Broken     => "broken symlink"
        TargetFile => "binary file (via symlink)"
      }
      Absent => "unknown symlink target"
    }
    RegularFile => "binary file"
  }
}

data filesystem_is_text_encoding_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: std.filesystem.is_text_encoding — deleted duplicate Optional-lifted predicate; sole authority is std.encoding.is_text_encoding (Encoding, not Encoding?).")

// THE PARENT DIRECTORY OF A PATH, linear in the segment count: drop the last segment, keep the
// separators. An empty remainder of an absolute path is `/`; of a relative basename, `.` (POSIX dirname).
fn path_parent_directory(path: String) -> String {
  match list_tail(xs: reverse(split(s: path, delimiter: "/"))) {
    Absent => path_parent_when_no_remaining_segments(path: path)
    Present { value: rest } => {
      let joined = join(reverse(rest), "/")
      if joined == "" {
        path_parent_when_no_remaining_segments(path: path)
      } else {
        joined
      }
    }
  }
}

fn path_parent_when_no_remaining_segments(path: String) -> String {
  if path == "" {
    "."
  } else {
    match list_head(xs: split(s: path, delimiter: "/")) {
      Absent => "."
      Present { value: first } =>
        if first == "" {
          "/"
        } else {
          "."
        }
    }
  }
}

// THE LAST COMPONENT OF A PATH, the final non-empty segment. The dual of path_parent_directory.
// Empty string and "/" both yield "" (POSIX basename of "/" is "/" but no caller needs that; if
// one does it gets its own predicate). THE single spelling of this fold (root_generalization): after
// consolidating every hand-rolled copy, `grep 'fn path_basename' dag` and the fold body itself both
// resolve ONLY to this definition. Consumers, each of which formerly carried its own copy of the fold:
//   extdeps.git::is_git_program (classify the program by basename, not spelling);
//   extdeps.virtualization.firecracker (jailer exec-file basename);
//   extdeps.docker.cgroup (cgroup last segment);
//   gunbc.live_deploy.member_observe; gunbc.owned_directory (owned_directory_basename);
//   gunbc.roadmap.dispatch_worker_unit_confinement (dispatch_worktree_entry_name);
//   gunbc.gitignore_emit (its old `path_basename` copy kept a trailing-slash empty segment -- a DIFFERENT
//   meaning under the SAME name, a meaning fork; migrated here with the explicit decision that trailing-
//   slash now follows POSIX basename. Only witness-literal callers drive the matcher, and they pass no
//   trailing slash, so the emitted .gitignore bytes are unchanged -- an equal blob. NOTE the matcher's
//   OWN result does change for a trailing-slash input like "a/.DS_Store/" (now true); no current caller
//   passes one, and those callers are witness literals, not production tracked paths);
//   gunbc.site.gunb_ai_content (repository_slug).
// Other `fold(split(_, "/"))` sites are NOT this fold and are not claimed: they trim each segment
// (dispatch_credential_acquisition, runner_host_cap_bracket), build a structured accumulator
// (runner_slot_retirement, live_deploy.emit), test all-segments-safe (verified_binary_install,
// cursor_agent_realization), or take a raw last segment -- INCLUDING empty -- under a DISTINCT, accurate
// name because that behavior is load-bearing and must not be merged: gunbc.url_file_acquisition::
// url_file_final_segment (parent/leaf must agree for trailing-slash subjects) and the witness-local
// worker_git_subtree_apply wet_basename. None shares this name or meaning (single_authority).
fn path_basename(path: String) -> String {
  fold(split(s: path, delimiter: "/"), init: "", f: (acc, seg) => if seg == "" { acc } else { seg })
}
