module std.filesystem

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.encoding { Encoding, is_text_encoding }
import std.types { FilePath, MimeType, String }
import std.filesystem.types { EntryKind, SymlinkTarget }
import std.algebra { list_tail, TailFound, TailAbsent }

type FileEntry {
  path: FilePath
  kind: EntryKind
  encoding: Encoding?
  symlink_target: SymlinkTarget?
  size: Int
  mime: MimeType?
}

type FileClassification = FileEntry

type ReadableEntry = FileEntry where is_text_readable

type PartitionResult {
  readable: List<FileEntry>
  skipped: List<FileEntry>
}

fn is_text_readable(entry: FileEntry) -> Bool {
  match entry.kind {
    RegularFile => is_text_encoding_optional(e: entry.encoding)
    Symlink     => entry.symlink_target == Present { value: TargetFile } && is_text_encoding_optional(e: entry.encoding)
    Directory   => false
    Missing     => false
    Other       => false
  }
}

fn is_text_encoding_optional(e: Encoding?) -> Bool {
  match e {
    Present { value: enc } => is_text_encoding(e: enc)
    Absent => false
  }
}

fn partition_entries(entries: List<FileEntry>) -> PartitionResult {
  readable = filter(entries, e => is_text_readable(entry: e))
  skipped  = filter(entries, e => !is_text_readable(entry: e))
  return { readable: readable, skipped: skipped }
}

fn skip_reason(entry: FileEntry) -> String {
  match entry.kind {
    Directory   => "directory"
    Missing     => "missing"
    Other       => "special file"
    Symlink     => match entry.symlink_target {
      Present { value: target } => match target {
        TargetDir  => "symlink to directory"
        Broken     => "broken symlink"
        TargetFile => "binary file (via symlink)"
      }
      Absent => "unknown symlink target"
    }
    RegularFile => "binary file"
  }
}

data filesystem_is_text_encoding_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: std.filesystem.is_text_encoding — deleted duplicate Optional-lifted predicate; sole authority is std.encoding.is_text_encoding (Encoding, not Encoding?).")

// THE PARENT DIRECTORY OF A PATH, linear in the segment count: drop the last segment, keep the
// separators. An empty remainder is the root. This is the shared spelling for that fact; local
// copies (frontend_eval parent_dir, runner parent_directory_of, live_deploy path_parent_dir) are
// the same question and should call this rather than fold-concat a walk.
fn path_parent_directory(path: String) -> String {
  match list_tail(xs: reverse(split(s: path, delimiter: "/"))) {
    TailAbsent => "/"
    TailFound { tail: rest } => {
      let joined = join(reverse(rest), "/")
      if joined == "" {
        "/"
      } else {
        joined
      }
    }
  }
}
