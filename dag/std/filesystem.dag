module std.filesystem



type FileEntry {
  path: std.types.FilePath
  kind: std.filesystem.types.EntryKind
  encoding: std.encoding.Encoding?
  symlink_target: std.filesystem.types.SymlinkTarget?
  size: Int
  mime: std.types.MimeType?
}

type FileClassification = FileEntry

type ReadableEntry = FileEntry where is_text_readable

type PartitionResult {
  readable: List<FileEntry>
  skipped: List<FileEntry>
}

fn is_text_readable(entry: FileEntry) -> Bool {
  match entry.kind {
    RegularFile => is_text_encoding_optional(e: entry.encoding)
    Symlink     => entry.symlink_target == TargetFile && is_text_encoding_optional(e: entry.encoding)
    Directory   => false
    Missing     => false
    Other       => false
  }
}

fn is_text_encoding_optional(e: std.encoding.Encoding?) -> Bool {
  match e {
    Present { value: enc } => std.encoding.is_text_encoding(e: enc)
    Absent => false
  }
}

fn partition_entries(entries: List<FileEntry>) -> PartitionResult {
  readable = filter(entries, e => is_text_readable(entry: e))
  skipped  = filter(entries, e => !is_text_readable(entry: e))
  return { readable: readable, skipped: skipped }
}

fn skip_reason(entry: FileEntry) -> String {
  match entry.kind {
    Directory   => "directory"
    Missing     => "missing"
    Other       => "special file"
    Symlink     => match entry.symlink_target {
      TargetDir  => "symlink to directory"
      Broken     => "broken symlink"
      TargetFile => "binary file (via symlink)"
      _          => "unknown symlink target"
    }
    RegularFile => "binary file"
  }
}

data filesystem_is_text_encoding_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: std.filesystem.is_text_encoding — deleted duplicate Optional-lifted predicate; sole authority is std.encoding.is_text_encoding (Encoding, not Encoding?).")
