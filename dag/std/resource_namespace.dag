module std.resource_namespace

import std.types { String, NonEmptyStr, Int, Bool }

data resource_namespace_doc: String = "Resource-namespace upsert vocabulary — shared verdict/plan algebra for File/Tool/Process/SecretFile namespaces. Observation→verdict→plan is the single authority (roadmap 2-resource-namespace-upsert-a); consumers (nbd-serve lease, install-media remaster chmod, seeded ISO classify) dissolve string-scaffolded shell when host_effect_apply binds typed folds."

type FileNamespace {
  root_path: NonEmptyStr
}

type ToolNamespace {
  install_dir: NonEmptyStr
}

type ProcessNamespace {
  listen_port: Int
  expected_owner_label: NonEmptyStr
}

type SecretFileNamespace {
  path: NonEmptyStr
}

type ResourceNamespaceVerdict
  = Converged
  | Absent
  | Stale
  | Conflict
  | Inaccessible
  | UnknownRefused

type ResourceNamespacePlan
  = Noop
  | Create
  | UpsertAccess
  | DrainThenStart
  | Refuse

type ResourceNamespaceClassification {
  verdict: ResourceNamespaceVerdict
  plan: ResourceNamespacePlan
}

type ProcessPortObservation
  = PortAbsent
  | PortOwnedExpected { pid: Int }
  | PortOwnedForeign { pid: Int, cmdline: NonEmptyStr }
  | PortInaccessible

type FileAccessObservation
  = PathAbsent
  | ReadOnlyWithinNamespace
  | WritableWithinNamespace
  | PathOutsideNamespace

type SeededArtifactProbeObservation
  = ArtifactAbsent
  | ArtifactConverged
  | ArtifactStale

fn path_has_dotdot_segment(path: String) -> Bool {
  path == ".."
    || starts_with(s: path, prefix: "../")
    || string_contains(s: path, pattern: "/../")
    || string_contains(s: path, pattern: "/..")
}

fn path_within_file_namespace(ns: FileNamespace, path: NonEmptyStr) -> Bool {
  let root = ns.root_path as String
  let candidate = path as String
  if path_has_dotdot_segment(path: candidate) {
    false
  } else {
    if candidate == root {
      true
    } else {
      starts_with(s: candidate, prefix: concat(root, "/"))
    }
  }
}

fn classify_process_port(ns: ProcessNamespace, obs: ProcessPortObservation) -> ResourceNamespaceVerdict {
  match obs {
    PortAbsent => Absent
    PortOwnedExpected { pid: _ } => Converged
    PortOwnedForeign { pid: _, cmdline: _ } => Conflict
    PortInaccessible => Inaccessible
  }
}

fn plan_for_verdict(v: ResourceNamespaceVerdict) -> ResourceNamespacePlan {
  match v {
    Converged => Noop
    Absent => Create
    Stale => DrainThenStart
    Conflict => Refuse
    Inaccessible => Refuse
    UnknownRefused => Refuse
  }
}

fn classify_process_port_upsert(
  ns: ProcessNamespace,
  obs: ProcessPortObservation,
) -> ResourceNamespaceClassification {
  let verdict = classify_process_port(ns: ns, obs: obs)
  ResourceNamespaceClassification {
    verdict: verdict,
    plan: plan_for_verdict(v: verdict),
  }
}

fn classify_file_access(ns: FileNamespace, obs: FileAccessObservation) -> ResourceNamespaceVerdict {
  match obs {
    PathAbsent => Absent
    ReadOnlyWithinNamespace => Stale
    WritableWithinNamespace => Converged
    PathOutsideNamespace => Inaccessible
  }
}

fn plan_for_file_access(obs: FileAccessObservation, v: ResourceNamespaceVerdict) -> ResourceNamespacePlan {
  match obs {
    PathOutsideNamespace => Refuse
    ReadOnlyWithinNamespace => UpsertAccess
    WritableWithinNamespace => Noop
    PathAbsent =>
      match v {
        Absent => Create
        _ => Refuse
      }
  }
}

fn classify_file_access_upsert(
  ns: FileNamespace,
  obs: FileAccessObservation,
) -> ResourceNamespaceClassification {
  let verdict = classify_file_access(ns: ns, obs: obs)
  ResourceNamespaceClassification {
    verdict: verdict,
    plan: plan_for_file_access(obs: obs, v: verdict),
  }
}

fn classify_seeded_artifact_presence(obs: SeededArtifactProbeObservation) -> ResourceNamespaceVerdict {
  match obs {
    ArtifactAbsent => Absent
    ArtifactConverged => Converged
    ArtifactStale => Stale
  }
}

fn classify_seeded_artifact_upsert(
  obs: SeededArtifactProbeObservation,
) -> ResourceNamespaceClassification {
  let verdict = classify_seeded_artifact_presence(obs: obs)
  ResourceNamespaceClassification {
    verdict: verdict,
    plan: plan_for_verdict(v: verdict),
  }
}

fn seeded_artifact_converged_is_not_stale() -> Bool {
  match classify_seeded_artifact_presence(obs: ArtifactConverged) {
    Stale => false
    _ => true
  }
}

fn seeded_artifact_stale_is_not_converged() -> Bool {
  match classify_seeded_artifact_presence(obs: ArtifactStale) {
    Converged => false
    _ => true
  }
}
