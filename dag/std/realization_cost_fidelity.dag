module std.realization_cost_fidelity

import std.algebra {
  CostShape,
  Equal,
  Greater,
  Less,
  Ordering,
  operand_growth_body_disagreement,
  StructuredCost,
  operand_growth_order,
  structured_cost_growth_in_operand,
  structured_cost_operands,
  structured_cost_to_shape,
}
import std.pareto {
  AxisComparison,
  DominanceUndecided,
  Dominated,
  Dominates,
  Equivalent,
  Incomparable,
  LowerIsBetter,
  Same,
  UndecidedOnEvidence,
  axis_comparison,
  dominance_of_comparisons,
}
import std.primitive_identity { RealizationTarget, primitive_identity_eq }
import std.primitive_projection { PrimitiveIdentity }
import std.types { Int, List, String }
import std.logic { Bool }

// THE MODELED COST AND THE REALIZED COST ARE TWO FACTS, AND NOTHING JOINED THEM.
//
// std.algebra carries what the MODEL claims an operation costs. The place a realization is chosen
// is std.primitive_identity PrimitiveRealization -- primitive, target, handler. Between them sat
// nothing, so a declared cost could be realized slower, or faster, and neither direction had a
// carrier able to state it. That gap is the compile-obligation census's one row WITHOUT A HOME.
//
// WHY IT IS NOT IN THE LENS. A lens reads a tree and judges the SOURCE. Whether a realization
// preserves the cost its model declares is a fact about the realization, joined at the identity the
// realization was selected under; putting it in the complexity lens would make the lens the
// authority on a fact it cannot see (DESIGN sections 3, 3b) -- and the failure mode
// gunbc.recurring_failure_mode lens_prices_the_authority_while_the_lane_runs_the_realization is
// exactly what happens when the two are conflated.
//
// WHO CONSUMES THIS, AND WHEN — A DECLARED FRONTIER, STATED HERE AND NOT ONLY IN A PULL REQUEST
// (DESIGN section 3c). As landed, the only executing consumer of this module is its own witness,
// `test.claim.realization_cost_fidelity_witness`, which exercises every arm of the join over
// authored costs. That is deliberately NOT enough on its own, and the honest classification is the
// middle one: a named consumer landing in a named later change.
//
// THE CONSUMER: the compile-obligation census's realization-cost-fidelity row — the row the census
// currently reports as having no home — joined per (primitive, target) through
// `realization_cost_fidelity_rows`, with `count_cost_fidelity_findings`,
// `count_cost_fidelity_unmeasured`, `count_cost_model_unmigrated` and `count_cost_body_dependent`
// as its four reported populations. THE ROUTE: the census entry point folds
// `std.primitive_identity`'s modeled costs against `RealizationCostFact` rows measured from the
// emitted compiler, and reports the rows.
//
// THE TRIGGER, and it is a capability rather than an artifact: the emitted compiler being
// measurable per primitive, so a realized cost is an OBSERVATION rather than an assertion. Until
// that holds there are deliberately no `RealizationCostFact` rows in the tree, because authoring a
// realized cost by hand is exactly the fabricated fact this authority exists to catch — the model
// and the realization would then agree by construction, which is the failure this join is built to
// make impossible. A second, smaller trigger retires `ModeledCostNotStructured` independently: the
// migration of `std.primitives` contract costs into `StructuredCost`.
//
// WHAT THAT MEANS FOR A READER OF A GREEN RUN TODAY: this module can state a divergence and has
// never been asked about a real one. Its arms are proven against authored costs, and the population
// it will judge does not exist yet.

// WHY IT COMPARES PER OPERAND. The motivating divergence is not a rank regression: a contract
// declaring work over both operands against a realization charging one of them is two costs of the
// SAME rank that disagree about WHICH operand they read. A comparison that reduced each side to a
// rank first would return "preserved" on the specimen this authority exists for.

// THE DOMINANCE ALGEBRA IS std.pareto's AND IS NOT RESTATED HERE (DESIGN section 3d: growing a
// second decision algebra beside Pareto is the fork that law exists to prevent). One axis per
// operand, LowerIsBetter on cost rank, and std.pareto folds the axis comparisons into a verdict --
// including its separation of Incomparable from DominanceUndecided, which is precisely the
// distinction a cost report must not lose.
type CostFidelity
  = CostShapePreserved
  | RealizationSlowerThanModeled
  | RealizationFasterThanModeled
  | RealizationDivergesByOperand
  | RealizationCostBodyDependent
  | RealizationCostUnknown
  | ModeledCostNotStructured

// SIX ARMS WHERE THE BRIEF ASKED FOR FOUR, and every addition exists to keep an honest answer from
// being reported as one of the other five. RealizationCostBodyDependent is the newest: when two
// costs agree on growth in every operand and differ in whether a caller-supplied body runs per
// element, neither is known to be worse -- the body may be O(1) -- so the comparison is UNDECIDED
// on evidence, which std.pareto already separates from Incomparable. Answering preserved there
// would hide a real difference and answering slower would invent one. RealizationDivergesByOperand is a PROVEN TRADE-OFF -- cheaper in one operand,
// dearer in another -- which is a finding, not an absence, and collapsing it into Unknown would be
// the absorbing fallback (DESIGN section 5): it would read as "measured, nothing to report" while
// meaning "measured, and the two disagree". ModeledCostNotStructured is the migration frontier: a
// contract that has not yet stated its cost in the structured form cannot be compared at all, and
// that is a COUNTED coverage obligation rather than a pass. RealizationCostUnknown stays reachable
// only from a MISSING realization fact -- never as the answer to a comparison.

type RealizationCostFact {
  primitive: PrimitiveIdentity
  target: RealizationTarget
  cost: StructuredCost
}

type ModeledStructuredCostFact {
  primitive: PrimitiveIdentity
  cost: StructuredCost
}

// EQUALITY ON A CLOSED COPRODUCT IS A MATCH, NOT A STRING COMPARE. An earlier revision minted a
// slug per arm and compared the slugs, which is a second naming scheme for arms the type already
// names (DESIGN section 3) — and it fails silently in the direction that matters: add a fourth
// target and the match below stops compiling, while a slug table would have answered "not equal"
// for the new arm against itself the moment someone forgot a row.
fn realization_target_eq(left: RealizationTarget, right: RealizationTarget) -> Bool {
  match left {
    InterpreterHost =>
      match right {
        InterpreterHost => true
        EmitRust => false
        EmitTypeScript => false
      }
    EmitRust =>
      match right {
        InterpreterHost => false
        EmitRust => true
        EmitTypeScript => false
      }
    EmitTypeScript =>
      match right {
        InterpreterHost => false
        EmitRust => false
        EmitTypeScript => true
      }
  }
}

fn operand_union(modeled: StructuredCost, realized: StructuredCost) -> List<String> {
  let seeded = structured_cost_operands(c: modeled) |> fold(init: [], f: fn(acc, o) {
    concat([o], acc)
  })
  reverse(structured_cost_operands(c: realized) |> fold(init: seeded, f: fn(acc, o) {
    if acc |> fold(init: false, f: fn(seen, x) { seen || x == o }) {
      acc
    } else {
      concat([o], acc)
    }
  }))
}

// An operand named by only one side is not skipped: its rank on the other side is 0, which is the
// TRUE statement that the cost does not grow in it. That is what makes "declares work in both
// operands, realizes work in one" come out as a difference rather than as a missing axis.
fn operand_axis_comparisons(
  modeled: StructuredCost,
  realized: StructuredCost,
) -> List<AxisComparison> {
  operand_union(modeled: modeled, realized: realized) |> fold(init: [], f: fn(acc, o) {
    concat([operand_axis_comparison(modeled: modeled, realized: realized, operand: o)], acc)
  })
}

// AN AXIS WHOSE GROWTHS AGREE AND WHOSE BODIES DO NOT IS UNDECIDED ON EVIDENCE, not Same. The
// missing evidence is the caller's body cost, which no cost in this vocabulary carries, so the axis
// says so in std.pareto's own word for it rather than being silently called equal.
fn operand_axis_comparison(
  modeled: StructuredCost,
  realized: StructuredCost,
  operand: String,
) -> AxisComparison {
  let modeled_growth = structured_cost_growth_in_operand(c: modeled, operand: operand)
  let realized_growth = structured_cost_growth_in_operand(c: realized, operand: operand)
  match operand_growth_order(a: realized_growth, b: modeled_growth) {
    Equal =>
      if operand_growth_body_disagreement(a: realized_growth, b: modeled_growth) {
        UndecidedOnEvidence
      } else {
        Same
      }
    Less => axis_comparison(goal: LowerIsBetter, value_order: Less)
    Greater => axis_comparison(goal: LowerIsBetter, value_order: Greater)
  }
}

fn cost_fidelity_of(modeled: StructuredCost, realized: StructuredCost) -> CostFidelity {
  match dominance_of_comparisons(
    comparisons: operand_axis_comparisons(modeled: modeled, realized: realized)
  ) {
    Dominates => RealizationFasterThanModeled
    Dominated => RealizationSlowerThanModeled
    Equivalent => CostShapePreserved
    Incomparable => RealizationDivergesByOperand
    DominanceUndecided => RealizationCostBodyDependent
  }
}

type RealizationCostFidelityRow {
  primitive: PrimitiveIdentity
  target: RealizationTarget
  modeled: StructuredCost?
  realized: StructuredCost?
  fidelity: CostFidelity
  projected_shape: CostShape?
}

fn realization_cost_for(
  facts: List<RealizationCostFact>,
  primitive: PrimitiveIdentity,
  target: RealizationTarget,
) -> StructuredCost? {
  facts |> fold(init: none, f: fn(acc, fact) {
    match acc {
      Present { value: c } => Present { value: c }
      Absent =>
        if primitive_identity_eq(left: fact.primitive, right: primitive)
          && realization_target_eq(left: fact.target, right: target) {
          Present { value: fact.cost }
        } else {
          none
        }
    }
  })
}

fn realization_cost_fidelity_row(
  modeled: ModeledStructuredCostFact,
  target: RealizationTarget,
  facts: List<RealizationCostFact>,
) -> RealizationCostFidelityRow {
  let realized = realization_cost_for(facts: facts, primitive: modeled.primitive, target: target)
  RealizationCostFidelityRow {
    primitive: modeled.primitive,
    target: target,
    modeled: Present { value: modeled.cost },
    realized: realized,
    fidelity: match realized {
      Absent => RealizationCostUnknown
      Present { value: r } => cost_fidelity_of(modeled: modeled.cost, realized: r)
    },
    projected_shape: structured_cost_to_shape(c: modeled.cost),
  }
}

// A primitive whose model has not yet been restated in the structured form gets a row too, with the
// frontier arm. Omitting it would shrink the denominator by exactly the population that has not
// been migrated, which is the population the frontier is about.
fn unstructured_modeled_row(
  primitive: PrimitiveIdentity,
  target: RealizationTarget,
) -> RealizationCostFidelityRow {
  RealizationCostFidelityRow {
    primitive: primitive,
    target: target,
    modeled: none,
    realized: none,
    fidelity: ModeledCostNotStructured,
    projected_shape: none,
  }
}

fn realization_cost_fidelity_rows(
  modeled: List<ModeledStructuredCostFact>,
  unstructured: List<PrimitiveIdentity>,
  target: RealizationTarget,
  facts: List<RealizationCostFact>,
) -> List<RealizationCostFidelityRow> {
  let structured_rows = modeled |> fold(init: [], f: fn(acc, m) {
    concat([realization_cost_fidelity_row(modeled: m, target: target, facts: facts)], acc)
  })
  reverse(unstructured |> fold(init: structured_rows, f: fn(acc, p) {
    concat([unstructured_modeled_row(primitive: p, target: target)], acc)
  }))
}

fn cost_fidelity_is_finding(fidelity: CostFidelity) -> Bool {
  match fidelity {
    CostShapePreserved => false
    RealizationSlowerThanModeled => true
    RealizationFasterThanModeled => true
    RealizationDivergesByOperand => true
    RealizationCostBodyDependent => false
    RealizationCostUnknown => false
    ModeledCostNotStructured => false
  }
}

fn count_cost_fidelity_findings(rows: List<RealizationCostFidelityRow>) -> Int {
  rows |> fold(init: 0, f: fn(acc, row) {
    if cost_fidelity_is_finding(fidelity: row.fidelity) { acc + 1 } else { acc }
  })
}

fn count_cost_fidelity_unmeasured(rows: List<RealizationCostFidelityRow>) -> Int {
  rows |> fold(init: 0, f: fn(acc, row) {
    match row.fidelity {
      RealizationCostUnknown => acc + 1
      CostShapePreserved => acc
      RealizationSlowerThanModeled => acc
      RealizationFasterThanModeled => acc
      RealizationDivergesByOperand => acc
      RealizationCostBodyDependent => acc
      ModeledCostNotStructured => acc
    }
  })
}

// A MEASURED-BUT-UNDECIDED ROW MUST APPEAR IN A REPORTED POPULATION, or the arm that exists to stop
// an undecided answer being read as preserved becomes an answer nobody reads at all. It is not a
// finding (nothing is established about which side is worse), not unmeasured (both costs are known),
// and not unmigrated (both are structured), so it is its own count -- the fourth population the
// consumer reports.
fn count_cost_body_dependent(rows: List<RealizationCostFidelityRow>) -> Int {
  rows |> fold(init: 0, f: fn(acc, row) {
    match row.fidelity {
      RealizationCostBodyDependent => acc + 1
      RealizationCostUnknown => acc
      CostShapePreserved => acc
      RealizationSlowerThanModeled => acc
      RealizationFasterThanModeled => acc
      RealizationDivergesByOperand => acc
      ModeledCostNotStructured => acc
    }
  })
}

fn count_cost_model_unmigrated(rows: List<RealizationCostFidelityRow>) -> Int {
  rows |> fold(init: 0, f: fn(acc, row) {
    match row.fidelity {
      ModeledCostNotStructured => acc + 1
      RealizationCostUnknown => acc
      CostShapePreserved => acc
      RealizationSlowerThanModeled => acc
      RealizationFasterThanModeled => acc
      RealizationDivergesByOperand => acc
      RealizationCostBodyDependent => acc
    }
  })
}
