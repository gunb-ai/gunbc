module std.citation



data citation_cit0_note: String = "CIT-0 neutral citation target (operator mandate 2026-08-04). Three carriers: std.citation.CitationTarget (expected_pin + selector — no embedded observation), std.citation.CitationRetrievalObservation (dated request receipt), std.citation.CitationVerificationReceipt (exact join of target + observation + reconciliation verdict). Pin.subject is CitedRepresentationIdentity { source: ExternalSubjectRef, access_route, byte_domain }. verify_citation_representation binds observation.request.locator to target pin access_route before reconcile. citation_exact_pin accepts Sha256Digest only at an admission boundary, not a construction wall."

data citation_pin_subject_note: String = "CitedRepresentationIdentity grounds pin.subject on ExternalSubjectRef (extdeps.external_authority external_subject_symbolic_identity_note) — never a bare URI spelling. access_route is the concrete locator whose bytes are hashed at byte_domain. ExactPin versus TrackedChannel is authored-permalink versus resolved-from-a-live-URL; pin_currency_gap names citation rot when review evidence is absent."

data citation_observed_at_note: String = "observed_at on CitationRetrievalObservation is EpochMs — UTC milliseconds since the Unix epoch (std.types EpochMs refuses negatives via where range). ISO-8601 wire form is a CIT-3 transport serialization concern, not the observation fact."

data citation_verifier_scope_note: String = "A citation verifier is not a truth verifier. It may establish retrieval, representation digest match, revision identity, and selector resolution. It cannot establish that a tertiary source justifies a normative claim, that a statement is correct, or that a result generalizes."

data citation_sha256_pin_rung_note: String = "citation_exact_pin accepts Sha256Digest at an ADMISSION boundary (caller supplies a digest value; reconcile routes non-Sha256 families to Incomparable). This is not a construction wall: Pin<std.citation.CitedRepresentationIdentity> remains constructible with any Sha256Digest the caller authors. dissolve-on: sole-constructor or validating mint closes construction when the wet production path is modeled."

// Expected identity (Pin.expected_identity, authored) and observed identity (ObservedCitedRepresentation.observed_identity, wet-adapter minted) are independent facts. reconcile_citation_representation maximum conclusion is supplied-equals-supplied digest equality after identity join — the wet adapter mint is convention, not independent production evidence. A mock that echoes the expected pin into the observation arm passes only when bytes genuinely match; the echo itself is not verification. CitationVerificationReceipt names the join explicitly.
type CitedRepresentationIdentity {
  source: extdeps.external_authority.ExternalSubjectRef
  access_route: extdeps.uri.Uri
  byte_domain: std.citation.RepresentationByteDomain
}

type CitationTarget<Selector> {
  expected_pin: extdeps.pin.Pin<std.citation.CitedRepresentationIdentity>
  selector: Selector?
}

type RepresentationByteDomain
  = RawResponseBody
  | DecodedContent
  | RenderedText
  | ExtractedPageContent

// Names WHICH BYTES are hashed — not which algorithm. RawResponseBody is the exact octet sequence received after transfer decoding and before interpretation. Later domains (DecodedContent, RenderedText, ExtractedPageContent) are reserved for CIT-1+ profiles; CIT-0 admits the type names only.
type ObservedCitedRepresentation {
  identity: std.citation.CitedRepresentationIdentity
  media_type: extdeps.http.server.MediaType
  observed_identity: std.content_hash.Sha256Digest
}

type CitationRepresentationReconciliation
  = RepresentationMatch
  | RepresentationMismatch { expected: std.content_hash.Sha256Digest, observed: std.content_hash.Sha256Digest }
  | RepresentationIdentityIncomparable {
      expected: std.citation.CitedRepresentationIdentity,
      observed: std.citation.CitedRepresentationIdentity,
    }
  | ObservationMissing

type CitationVerificationRefusalCause
  = RequestLocatorMismatch { expected: extdeps.uri.Uri, observed: extdeps.uri.Uri }
  | HttpStatusNotSuccessful { status: std.types.HttpStatus }
  | ResponseObservedWithoutRepresentationObservation {
      observation: std.citation.CitationRetrievalObservation,
    }
  | CitationAccessRefusedObservation { observation: std.citation.CitationRetrievalObservation }
  | CitationUnreachableObservation { observation: std.citation.CitationRetrievalObservation }
  | CitationRateLimitedObservation { observation: std.citation.CitationRetrievalObservation }

type CitationVerificationOutcome<Selector>
  = CitationRepresentationVerified {
      receipt: std.citation.CitationVerificationReceipt<Selector>,
    }
  | CitationRepresentationMismatch {
      receipt: std.citation.CitationVerificationReceipt<Selector>,
    }
  | CitationRepresentationIdentityIncomparable {
      receipt: std.citation.CitationVerificationReceipt<Selector>,
    }
  | CitationRepresentationObservationMissing {
      receipt: std.citation.CitationVerificationReceipt<Selector>,
    }
  | CitationVerificationRefused {
      cause: std.citation.CitationVerificationRefusalCause,
    }

type CitationVerificationReceipt<Selector> {
  target: std.citation.CitationTarget<Selector>
  observation: std.citation.CitationRetrievalObservation
  reconciliation: std.citation.CitationRepresentationReconciliation
}

type FragmentSelector {
  conforms_to: extdeps.external_authority.ExternalAuthority
  value: std.types.NonEmptyStr
}

type TextQuoteSelector {
  exact: std.types.NonEmptyStr
  prefix: std.types.NonEmptyStr?
  suffix: std.types.NonEmptyStr?
}

data citation_refusal_cause_note: String = "Every refusal cause is a typed coproduct arm carrying modeled values, not prose — the PinRefusalCause precedent in extdeps.pin. Causes are countable by class so migration frontiers burn down visibly."

data text_position_selector_cross_field_note: String = "W3C Web Annotation TextPositionSelector start and end are non-negative character indices (std.integer.NonNegativeInt = Nat). end < start is refused by text_position_selector returning CitationSelectorRefused { cause: TextPositionEndBeforeStart } — VALIDATION at the constructor today, not a construction wall. dissolve-on: cross-field refinement or sole-constructor wall makes inverted ranges unwritable."

// W3C FragmentSelector conformsTo names the specification defining the SELECTOR VALUE syntax — for PDF open parameters that is RFC 8118 (extdeps.standards.rfc_8118), never Web Annotation itself. A missing governing fragment specification must refuse; there is no default_fragment_selector.
type SelectorRefusalCause
  = TextPositionEndBeforeStart { start: std.integer.NonNegativeInt, end: std.integer.NonNegativeInt }

type CitationAccessRefusalCause
  = HttpAccessRefused { status: std.types.HttpStatus }

// CitationUnreachableCause arms are class-countable transport failures. TransportUnreachable is NOT an unclassifiable catch-all — it means a transport-layer failure outside DNS, TLS handshake, connection refused, and request timeout. Unclassifiable observations must land on a separate explicit arm when the transport observation layer lands.
type CitationUnreachableCause
  = DnsResolutionFailed
  | TlsHandshakeFailed
  | ConnectionRefused
  | RequestTimedOut
  | TransportUnreachable

type TextPositionSelector {
  start: std.integer.NonNegativeInt
  end: std.integer.NonNegativeInt
}

type CitationSelector
  = FragmentSelectorVariant(FragmentSelector)
  | TextQuoteSelectorVariant(TextQuoteSelector)
  | TextPositionSelectorVariant(TextPositionSelector)

type CitationSelectorConstruction
  = CitationSelectorConstructed(CitationSelector)
  | CitationSelectorRefused { cause: std.citation.SelectorRefusalCause }

fn cited_representation_identity(
  source: extdeps.external_authority.ExternalSubjectRef,
  access_route: extdeps.uri.Uri,
  byte_domain: std.citation.RepresentationByteDomain,
) -> std.citation.CitedRepresentationIdentity {
  CitedRepresentationIdentity {
    source: source,
    access_route: access_route,
    byte_domain: byte_domain,
  }
}

fn cited_representation_identity_eq(
  left: std.citation.CitedRepresentationIdentity,
  right: std.citation.CitedRepresentationIdentity,
) -> Bool {
  external_subject_ref_eq(a: left.source, b: right.source)
    && left.access_route == right.access_route
    && left.byte_domain == right.byte_domain
}

fn http_status_is_success(status: std.types.HttpStatus) -> Bool {
  status >= 200 && status <= 299
}

fn citation_exact_pin(
  source: extdeps.external_authority.ExternalSubjectRef,
  access_route: extdeps.uri.Uri,
  byte_domain: std.citation.RepresentationByteDomain,
  version: extdeps.version.VersionIdentity,
  expected_identity: std.content_hash.Sha256Digest,
) -> extdeps.pin.Pin<std.citation.CitedRepresentationIdentity> {
  extdeps.pin.Pin {
    subject: cited_representation_identity(
      source: source,
      access_route: access_route,
      byte_domain: byte_domain,
    ),
    version: version,
    expected_identity: as_content_hash_cryptographic(digest: expected_identity),
    selection: ExactPin,
  }
}

fn citation_pin_expected_sha256(pin: extdeps.pin.Pin<std.citation.CitedRepresentationIdentity>) -> std.content_hash.Sha256Digest? {
  match pin.expected_identity {
    Sha256Hash(digest) => Present { value: digest }
    _ => none
  }
}

fn observed_cited_representation(
  identity: std.citation.CitedRepresentationIdentity,
  media_type: extdeps.http.server.MediaType,
  observed_identity: std.content_hash.Sha256Digest,
) -> std.citation.ObservedCitedRepresentation {
  ObservedCitedRepresentation {
    identity: identity,
    media_type: media_type,
    observed_identity: observed_identity,
  }
}

fn reconcile_citation_representation(
  expected_pin: extdeps.pin.Pin<std.citation.CitedRepresentationIdentity>,
  observed: std.citation.ObservedCitedRepresentation?,
) -> std.citation.CitationRepresentationReconciliation {
  match observed {
    Absent => ObservationMissing
    Present { value: o } =>
      if !cited_representation_identity_eq(left: expected_pin.subject, right: o.identity) {
        RepresentationIdentityIncomparable {
          expected: expected_pin.subject,
          observed: o.identity,
        }
      } else {
        match citation_pin_expected_sha256(pin: expected_pin) {
          Absent =>
            RepresentationIdentityIncomparable {
              expected: expected_pin.subject,
              observed: o.identity,
            }
          Present { value: expected } =>
            if content_hash_eq_cryptographic(left: expected, right: o.observed_identity) {
              RepresentationMatch
            } else {
              RepresentationMismatch {
                expected: expected,
                observed: o.observed_identity,
              }
            }
        }
      }
  }
}

fn fragment_selector(conforms_to: extdeps.external_authority.ExternalAuthority, value: std.types.NonEmptyStr) -> std.citation.CitationSelectorConstruction {
  CitationSelectorConstructed(FragmentSelectorVariant(FragmentSelector {
    conforms_to: conforms_to,
    value: value,
  }))
}

fn text_quote_selector(
  exact: std.types.NonEmptyStr,
  prefix: std.types.NonEmptyStr?,
  suffix: std.types.NonEmptyStr?,
) -> std.citation.CitationSelectorConstruction {
  CitationSelectorConstructed(TextQuoteSelectorVariant(TextQuoteSelector {
    exact: exact,
    prefix: prefix,
    suffix: suffix,
  }))
}

fn text_position_selector(start: std.integer.NonNegativeInt, end: std.integer.NonNegativeInt) -> std.citation.CitationSelectorConstruction {
  match std.nat.nat_compare(a: end, b: start) {
    Less =>
      CitationSelectorRefused {
        cause: TextPositionEndBeforeStart { start: start, end: end },
      }
    _ =>
      CitationSelectorConstructed(TextPositionSelectorVariant(TextPositionSelector {
        start: start,
        end: end,
      }))
  }
}

fn citation_target<Selector>(
  expected_pin: extdeps.pin.Pin<std.citation.CitedRepresentationIdentity>,
  selector: Selector?,
) -> std.citation.CitationTarget<Selector> {
  CitationTarget {
    expected_pin: expected_pin,
    selector: selector,
  }
}

type CitationRetrievalRequest {
  locator: extdeps.uri.Uri
}

type CitationRetrievalObservation
  = RepresentationRetrieved {
      request: std.citation.CitationRetrievalRequest,
      observed_at: std.types.EpochMs,
      http_status: std.types.HttpStatus,
      observed: std.citation.ObservedCitedRepresentation,
    }
  | ResponseObservedWithoutRepresentation {
      request: std.citation.CitationRetrievalRequest,
      observed_at: std.types.EpochMs,
      http_status: std.types.HttpStatus,
    }
  | CitationAccessRefused {
      request: std.citation.CitationRetrievalRequest,
      observed_at: std.types.EpochMs,
      cause: std.citation.CitationAccessRefusalCause,
    }
  | CitationUnreachable {
      request: std.citation.CitationRetrievalRequest,
      observed_at: std.types.EpochMs,
      cause: std.citation.CitationUnreachableCause,
    }
  | CitationRateLimited {
      request: std.citation.CitationRetrievalRequest,
      observed_at: std.types.EpochMs,
      retry_after: std.measure.Second?,
    }

fn citation_verification_outcome_from_reconciliation<Selector>(
  target: std.citation.CitationTarget<Selector>,
  observation: std.citation.CitationRetrievalObservation,
  reconciliation: std.citation.CitationRepresentationReconciliation,
) -> std.citation.CitationVerificationOutcome<Selector> {
  let receipt = CitationVerificationReceipt {
    target: target,
    observation: observation,
    reconciliation: reconciliation,
  }
  match reconciliation {
    RepresentationMatch => CitationRepresentationVerified { receipt: receipt }
    RepresentationMismatch { expected: _, observed: _ } =>
      CitationRepresentationMismatch { receipt: receipt }
    RepresentationIdentityIncomparable { expected: _, observed: _ } =>
      CitationRepresentationIdentityIncomparable { receipt: receipt }
    ObservationMissing => CitationRepresentationObservationMissing { receipt: receipt }
  }
}

fn verify_citation_representation<Selector>(
  target: std.citation.CitationTarget<Selector>,
  observation: std.citation.CitationRetrievalObservation,
) -> std.citation.CitationVerificationOutcome<Selector> {
  let expected_route = target.expected_pin.subject.access_route
  match observation {
    RepresentationRetrieved {
      request: r,
      observed_at: _,
      http_status: s,
      observed: o,
    } =>
      if r.locator != expected_route {
        CitationVerificationRefused {
          cause: RequestLocatorMismatch {
            expected: expected_route,
            observed: r.locator,
          },
        }
      } else if !http_status_is_success(status: s) {
        CitationVerificationRefused {
          cause: HttpStatusNotSuccessful { status: s },
        }
      } else {
        citation_verification_outcome_from_reconciliation(
          target: target,
          observation: observation,
          reconciliation: reconcile_citation_representation(
            expected_pin: target.expected_pin,
            observed: Present { value: o },
          ),
        )
      }
    ResponseObservedWithoutRepresentation { request: r, observed_at: _, http_status: _ } =>
      if r.locator != expected_route {
        CitationVerificationRefused {
          cause: RequestLocatorMismatch {
            expected: expected_route,
            observed: r.locator,
          },
        }
      } else {
        CitationVerificationRefused {
          cause: ResponseObservedWithoutRepresentationObservation {
            observation: observation,
          },
        }
      }
    CitationAccessRefused { request: r, observed_at: _, cause: _ } =>
      if r.locator != expected_route {
        CitationVerificationRefused {
          cause: RequestLocatorMismatch {
            expected: expected_route,
            observed: r.locator,
          },
        }
      } else {
        CitationVerificationRefused {
          cause: CitationAccessRefusedObservation { observation: observation },
        }
      }
    CitationUnreachable { request: r, observed_at: _, cause: _ } =>
      if r.locator != expected_route {
        CitationVerificationRefused {
          cause: RequestLocatorMismatch {
            expected: expected_route,
            observed: r.locator,
          },
        }
      } else {
        CitationVerificationRefused {
          cause: CitationUnreachableObservation { observation: observation },
        }
      }
    CitationRateLimited { request: r, observed_at: _, retry_after: _ } =>
      if r.locator != expected_route {
        CitationVerificationRefused {
          cause: RequestLocatorMismatch {
            expected: expected_route,
            observed: r.locator,
          },
        }
      } else {
        CitationVerificationRefused {
          cause: CitationRateLimitedObservation { observation: observation },
        }
      }
  }
}

type CitationArtifactLayer
  = ObservingProductLayer
  | UpstreamModuleLayer { module_path: std.types.NonEmptyStr }

type CitationLayerAdmission
  = CitationLayerAdmitted
  | CitationLayerRefusedUpstreamObservation

fn admit_citation_retrieval_observation(
  layer: std.citation.CitationArtifactLayer,
  observation: std.citation.CitationRetrievalObservation,
) -> std.citation.CitationLayerAdmission {
  match layer {
    ObservingProductLayer => CitationLayerAdmitted
    UpstreamModuleLayer { module_path: _ } =>
      match observation {
        RepresentationRetrieved { request: _, observed_at: _, http_status: _, observed: _ } =>
          CitationLayerRefusedUpstreamObservation
        ResponseObservedWithoutRepresentation { request: _, observed_at: _, http_status: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationAccessRefused { request: _, observed_at: _, cause: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationUnreachable { request: _, observed_at: _, cause: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationRateLimited { request: _, observed_at: _, retry_after: _ } =>
          CitationLayerRefusedUpstreamObservation
      }
  }
}

data citation_cit1_pdf_profile_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "extdeps.standards.rfc_8118",
    decl_name: "extdeps_external_authority_anchor",
    field: WholeDeclaration,
  },
}

data citation_cit2_mediawiki_provider_observation_scaffold: std.disposition.Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "extdeps.mediawiki",
    decl_name: "extdeps_external_authority_anchor",
    field: WholeDeclaration,
  },
}

type CitationRecordedFact<Selector> {
  cited: std.citation.CitationTarget<Selector>
}

fn citation_recorded_fact<Selector>(
  id: std.claim_evidence.RecordedFactId,
  cited: std.citation.CitationTarget<Selector>,
) -> RecordedFact<std.citation.CitationRecordedFact<Selector>> {
  std.claim_evidence.RecordedFact {
    id: id,
    value: std.citation.CitationRecordedFact { cited: cited },
  }
}

data citation_evidence_interface_note: String = "CitationRecordedFact is the provenance payload consumed by std.claim_evidence EvidenceLink — same authority, provenance, maximum_conclusion, fidelity, supporting/challenging, insufficiency, and EvidenceAdmissionPolicy machinery. Rich citations do not form a competing evidence system."

data citation_cit1_pdf_profile_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "dissolve-on: citation_cit1_pdf_profile — ordered RFC 8118 fragment sequence, safe profile (page, nameddest, structelem), navigable URL projection, and one real versioned PDF consumer land in CIT-1 after CIT-0 sign-off.")

data citation_cit2_mediawiki_provider_observation_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "dissolve-on: citation_cit2_mediawiki_provider_observation — provider-bound revision lookup outcomes land in CIT-2 beside generic extdeps MediaWiki protocol shapes separate from site realizations.")
