module std.citation

import std.types { NonEmptyStr, String, Int, List, Bool, EpochMs, HttpStatus }
import std.measure { Second }
import std.content_hash { ContentHash, Sha256Digest, as_content_hash_cryptographic }
import std.claim_evidence { RecordedFact, RecordedFactId }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, SubstrateMandatoryTag, RealizationDispatch }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri }
import extdeps.pin { Pin, ExactPin }
import extdeps.version { VersionIdentity }
import extdeps.http.server { MediaType }
import extdeps.standards.web_annotation { web_annotation_authority }

data citation_cit0_note: String = "CIT-0 neutral citation target (operator mandate 2026-08-04). CitedResource consumes ExternalAuthority without extending it. Selectors ground on extdeps.standards.web_annotation (W3C Web Annotation Data Model). Representation identity uses extdeps.pin Pin<CitedRepresentation>: CitedRepresentation carries the cited authority and RepresentationByteDomain (which bytes are hashed); version and expected_identity live on Pin per pin_authority_note — never a parallel RepresentationPin type or Unpinned constructor. Absent pin is an optional field, not a pin variant. Retrieval observations are dated downstream receipts with request and observed_at — never timeless facts on upstream modules. Citation verification proves reachability, media type, digest, revision match, and selector resolution — not claim truth. Evidence payloads feed std.claim_evidence EvidenceLink via CitationRecordedFact rather than a parallel evidence system."

data citation_pin_subject_note: String = "pin_subject_must_not_be_self_identifying_note case (1): a cited web representation does NOT determine its own digest — expected_identity is new information from observation — so Pin<CitedRepresentation>, not SubjectProjectedPin. RepresentationByteDomain names WHICH bytes are hashed (raw response body, decoded content, rendered text, extracted page content); a digest without that axis is meaningless. ExactPin versus TrackedChannel is authored-permalink versus resolved-from-a-live-URL; pin_currency_gap names citation rot when review evidence is absent."

data citation_observed_at_note: String = "observed_at on CitationRetrievalObservation is EpochMs — UTC milliseconds since the Unix epoch (std.types EpochMs refuses negatives via where range). ISO-8601 wire form is a CIT-3 transport serialization concern, not the observation fact."

data citation_verifier_scope_note: String = "A citation verifier is not a truth verifier. It may establish retrieval, representation digest match, revision identity, and selector resolution. It cannot establish that a tertiary source justifies a normative claim, that a statement is correct, or that a result generalizes."

type CitedRepresentation {
  authority: ExternalAuthority
  byte_domain: RepresentationByteDomain
}

type CitedResource<Representation, Selector> {
  authority: ExternalAuthority
  representation: Representation?
  selector: Selector?
}

type RepresentationByteDomain
  = RawResponseBody
  | DecodedContent
  | RenderedText
  | ExtractedPageContent

data representation_byte_domain_note: String = "Names WHICH BYTES are hashed — not which algorithm. RawResponseBody is the exact octet sequence received after transfer decoding and before interpretation. Later domains (DecodedContent, RenderedText, ExtractedPageContent) are reserved for CIT-1+ profiles; CIT-0 admits the type names only."

type RetrievedRepresentation {
  media_type: MediaType
  pin: Pin<CitedRepresentation>?
}

type FragmentSelector {
  conforms_to: ExternalAuthority
  value: NonEmptyStr
}

type TextQuoteSelector {
  exact: NonEmptyStr
  prefix: NonEmptyStr?
  suffix: NonEmptyStr?
}

type TextPositionSelector {
  start: Int
  end: Int
}

type CitationSelector
  = FragmentSelectorVariant(FragmentSelector)
  | TextQuoteSelectorVariant(TextQuoteSelector)
  | TextPositionSelectorVariant(TextPositionSelector)
  | SelectorRefused { cause: NonEmptyStr }

fn cited_representation(
  authority: ExternalAuthority,
  byte_domain: RepresentationByteDomain,
) -> CitedRepresentation {
  CitedRepresentation {
    authority: authority,
    byte_domain: byte_domain,
  }
}

fn citation_exact_pin(
  authority: ExternalAuthority,
  byte_domain: RepresentationByteDomain,
  version: VersionIdentity,
  expected_identity: ContentHash,
) -> Pin<CitedRepresentation> {
  Pin {
    subject: cited_representation(authority: authority, byte_domain: byte_domain),
    version: version,
    expected_identity: expected_identity,
    selection: ExactPin,
  }
}

fn fragment_selector(conforms_to: ExternalAuthority, value: NonEmptyStr) -> CitationSelector {
  FragmentSelectorVariant(FragmentSelector {
    conforms_to: conforms_to,
    value: value,
  })
}

fn text_quote_selector(
  exact: NonEmptyStr,
  prefix: NonEmptyStr?,
  suffix: NonEmptyStr?,
) -> CitationSelector {
  TextQuoteSelectorVariant(TextQuoteSelector {
    exact: exact,
    prefix: prefix,
    suffix: suffix,
  })
}

fn text_position_selector(start: Int, end: Int) -> CitationSelector {
  TextPositionSelectorVariant(TextPositionSelector {
    start: start,
    end: end,
  })
}

fn retrieved_representation(
  media_type: MediaType,
  pin: Pin<CitedRepresentation>?,
) -> RetrievedRepresentation {
  RetrievedRepresentation {
    media_type: media_type,
    pin: pin,
  }
}

fn cited_resource<Representation, Selector>(
  authority: ExternalAuthority,
  representation: Representation?,
  selector: Selector?,
) -> CitedResource<Representation, Selector> {
  CitedResource {
    authority: authority,
    representation: representation,
    selector: selector,
  }
}

type CitationRetrievalRequest {
  locator: Uri
}

type CitationRetrievalResponse {
  http_status: HttpStatus?
  media_type: MediaType?
  representation_pin: Pin<CitedRepresentation>?
}

type CitationRetrievalObservation
  = CitationRetrieved {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      response: CitationRetrievalResponse,
    }
  | CitationAccessRefused {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      cause: NonEmptyStr,
    }
  | CitationUnreachable {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      cause: NonEmptyStr,
    }
  | CitationRateLimited {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      retry_after: Second?,
    }

type CitationArtifactLayer
  = ObservingProductLayer
  | UpstreamModuleLayer { module_path: NonEmptyStr }

type CitationLayerAdmission
  = CitationLayerAdmitted
  | CitationLayerRefusedUpstreamObservation

fn admit_citation_retrieval_observation(
  layer: CitationArtifactLayer,
  observation: CitationRetrievalObservation,
) -> CitationLayerAdmission {
  match layer {
    ObservingProductLayer => CitationLayerAdmitted
    UpstreamModuleLayer { module_path: _ } =>
      match observation {
        CitationRetrieved { request: _, observed_at: _, response: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationAccessRefused { request: _, observed_at: _, cause: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationUnreachable { request: _, observed_at: _, cause: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationRateLimited { request: _, observed_at: _, retry_after: _ } =>
          CitationLayerRefusedUpstreamObservation
      }
  }
}

data citation_scaffold_dissolution_bind_note: String = "A Scaffold bind names a future declaration by design — the dissolution target that must come into existence before the scaffold retires — not evidence that must resolve now. When the DeclarationRef resolution gate widens beyond doc-binds, that distinction is what tells the triager whether a missing target is a stale citation or an honest forward reservation."

data citation_retrieval_observation_layer_gate_substrate_scaffold: Disposition = Scaffold {
  dissolves_to: SubstrateMandatoryTag,
  bind: DeclarationRef {
    module_path: "std.citation",
    decl_name: "admit_citation_retrieval_observation",
    field: WholeDeclaration,
  },
}

data citation_retrieval_observation_layer_gate_dissolve_on: String = "dissolve-on: citation_retrieval_observation_layer_gate — CIT-0 ships the layer check (admit_citation_retrieval_observation); DISSOLVES WHEN substrate mandatory-tag or typechecker refusal makes CitationRetrievalObservation unwritable inside extdeps upstream modules."

data citation_cit1_pdf_profile_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.standards.rfc_8118",
    decl_name: "extdeps_external_authority_anchor",
    field: WholeDeclaration,
  },
}

data citation_cit1_pdf_profile_dissolve_on: String = "dissolve-on: citation_cit1_pdf_profile — ordered RFC 8118 fragment sequence, safe profile (page, nameddest, structelem), navigable URL projection, and one real versioned PDF consumer land in CIT-1 after CIT-0 sign-off."

data citation_cit2_mediawiki_provider_observation_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.mediawiki",
    decl_name: "extdeps_external_authority_anchor",
    field: WholeDeclaration,
  },
}

data citation_cit2_mediawiki_provider_observation_dissolve_on: String = "dissolve-on: citation_cit2_mediawiki_provider_observation — provider-bound revision lookup outcomes (found, missing, suppressed) with revision identity and content digest typed through std.content_hash (Action API base-16 SHA-1 vs internal base-36 distinguished at the extdeps MediaWiki model), not as bare hex in std.citation. Lands in CIT-2 beside generic extdeps MediaWiki protocol shapes separate from site realizations."

type CitationRecordedFact<Representation, Selector> {
  cited: CitedResource<Representation, Selector>
}

fn citation_recorded_fact<Representation, Selector>(
  id: RecordedFactId,
  cited: CitedResource<Representation, Selector>,
) -> RecordedFact<CitationRecordedFact<Representation, Selector>> {
  RecordedFact {
    id: id,
    value: CitationRecordedFact { cited: cited },
  }
}

data citation_evidence_interface_note: String = "CitationRecordedFact is the provenance payload consumed by std.claim_evidence EvidenceLink — same authority, provenance, maximum_conclusion, fidelity, supporting/challenging, insufficiency, and EvidenceAdmissionPolicy machinery. Rich citations do not form a competing evidence system."

fn default_fragment_selector(value: NonEmptyStr) -> CitationSelector {
  fragment_selector(conforms_to: web_annotation_authority, value: value)
}
