module std.citation

import std.types { NonEmptyStr, String, List, Bool, EpochMs, HttpStatus }
import std.integer { NonNegativeInt }
import std.nat { nat_compare }
import std.algebra { Less, Equal, Greater }
import std.measure { Second }
import std.content_hash {
  Sha256Digest,
  Sha256Hash,
  as_content_hash_cryptographic,
  content_hash_eq_cryptographic,
}
import std.claim_evidence { RecordedFact, RecordedFactId }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, SubstrateMandatoryTag, RealizationDispatch }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri }
import extdeps.pin { Pin, ExactPin }
import extdeps.version { VersionIdentity }
import extdeps.http.server { MediaType }

data citation_cit0_note: String = "CIT-0 neutral citation target (operator mandate 2026-08-04). CitedResource.authority is the sole source identity — never duplicated on Pin.subject or ObservedCitedRepresentation. CitedRepresentation names only which bytes are hashed (RepresentationByteDomain); version and expected Sha256Digest live on Pin. ObservedCitedRepresentation carries independently observed media_type, byte_domain, and observed_identity minted by the wet adapter — never the expected pin echoed back. reconcile_citation_representation compares expected against observed into Match | Mismatch | Incomparable | ObservationMissing. Retrieval observations are dated downstream receipts; RepresentationRetrieved requires HttpStatus and ObservedCitedRepresentation; ResponseObservedWithoutRepresentation is a separate arm — partial success cannot inhabit the representation arm. citation_exact_pin accepts Sha256Digest only, not structural FNV or the ContentHash union. Evidence payloads feed std.claim_evidence via CitationRecordedFact."

data citation_pin_subject_note: String = "pin_subject_must_not_be_self_identifying_note case (1): a cited web representation does NOT determine its own digest — expected_identity is new information from observation — so Pin<CitedRepresentation>, not SubjectProjectedPin. RepresentationByteDomain names WHICH bytes are hashed; a digest without that axis is meaningless. ExactPin versus TrackedChannel is authored-permalink versus resolved-from-a-live-URL; pin_currency_gap names citation rot when review evidence is absent."

data citation_observed_at_note: String = "observed_at on CitationRetrievalObservation is EpochMs — UTC milliseconds since the Unix epoch (std.types EpochMs refuses negatives via where range). ISO-8601 wire form is a CIT-3 transport serialization concern, not the observation fact."

data citation_verifier_scope_note: String = "A citation verifier is not a truth verifier. It may establish retrieval, representation digest match, revision identity, and selector resolution. It cannot establish that a tertiary source justifies a normative claim, that a statement is correct, or that a result generalizes."

data citation_expected_observed_separation_note: String = "Expected identity (Pin.expected_identity, authored) and observed identity (ObservedCitedRepresentation.observed_identity, wet-adapter minted) are independent facts reconciled by reconcile_citation_representation. A mock that echoes the expected pin into the observation arm passes only when bytes genuinely match — the echo itself is not verification."

type CitedRepresentation {
  byte_domain: RepresentationByteDomain
}

type CitedResource<Representation, Selector> {
  authority: ExternalAuthority
  representation: Representation?
  selector: Selector?
}

type RepresentationByteDomain
  = RawResponseBody
  | DecodedContent
  | RenderedText
  | ExtractedPageContent

data representation_byte_domain_note: String = "Names WHICH BYTES are hashed — not which algorithm. RawResponseBody is the exact octet sequence received after transfer decoding and before interpretation. Later domains (DecodedContent, RenderedText, ExtractedPageContent) are reserved for CIT-1+ profiles; CIT-0 admits the type names only."

type ObservedCitedRepresentation {
  media_type: MediaType
  byte_domain: RepresentationByteDomain
  observed_identity: Sha256Digest
}

type RetrievedRepresentation {
  observed: ObservedCitedRepresentation?
}

type CitationRepresentationReconciliation
  = RepresentationMatch
  | RepresentationMismatch { expected: Sha256Digest, observed: Sha256Digest }
  | RepresentationIncomparable {
      expected_domain: RepresentationByteDomain,
      observed_domain: RepresentationByteDomain,
    }
  | ObservationMissing

type FragmentSelector {
  conforms_to: ExternalAuthority
  value: NonEmptyStr
}

type TextQuoteSelector {
  exact: NonEmptyStr
  prefix: NonEmptyStr?
  suffix: NonEmptyStr?
}

data citation_refusal_cause_note: String = "Every refusal cause is a typed coproduct arm carrying modeled values, not prose — the PinRefusalCause precedent in extdeps.pin. Causes are countable by class so migration frontiers burn down visibly."

data text_position_selector_cross_field_note: String = "W3C Web Annotation TextPositionSelector start and end are non-negative character indices (std.integer.NonNegativeInt = Nat). end < start is refused by text_position_selector returning SelectorRefused { cause: TextPositionEndBeforeStart } — VALIDATION at the constructor today, not a construction wall. dissolve-on: cross-field refinement or sole-constructor wall makes inverted ranges unwritable."

data citation_fragment_selector_conforms_to_note: String = "W3C FragmentSelector conformsTo names the specification defining the SELECTOR VALUE syntax — for PDF open parameters that is RFC 8118 (extdeps.standards.rfc_8118), never Web Annotation itself. A missing governing fragment specification must refuse; there is no default_fragment_selector."

type SelectorRefusalCause
  = TextPositionEndBeforeStart { start: NonNegativeInt, end: NonNegativeInt }

type CitationAccessRefusalCause
  = HttpAccessRefused { status: HttpStatus }

data citation_unreachable_cause_note: String = "CitationUnreachableCause arms are class-countable transport failures. TransportUnreachable is NOT an unclassifiable catch-all — it means a transport-layer failure outside DNS, TLS handshake, connection refused, and request timeout. Unclassifiable observations must land on a separate explicit arm when the transport observation layer lands."

type CitationUnreachableCause
  = DnsResolutionFailed
  | TlsHandshakeFailed
  | ConnectionRefused
  | RequestTimedOut
  | TransportUnreachable

type TextPositionSelector {
  start: NonNegativeInt
  end: NonNegativeInt
}

type CitationSelector
  = FragmentSelectorVariant(FragmentSelector)
  | TextQuoteSelectorVariant(TextQuoteSelector)
  | TextPositionSelectorVariant(TextPositionSelector)
  | SelectorRefused { cause: SelectorRefusalCause }

fn cited_representation(byte_domain: RepresentationByteDomain) -> CitedRepresentation {
  CitedRepresentation {
    byte_domain: byte_domain,
  }
}

fn citation_exact_pin(
  byte_domain: RepresentationByteDomain,
  version: VersionIdentity,
  expected_identity: Sha256Digest,
) -> Pin<CitedRepresentation> {
  Pin {
    subject: cited_representation(byte_domain: byte_domain),
    version: version,
    expected_identity: as_content_hash_cryptographic(digest: expected_identity),
    selection: ExactPin,
  }
}

fn citation_pin_expected_sha256(pin: Pin<CitedRepresentation>) -> Sha256Digest? {
  match pin.expected_identity {
    Sha256Hash(digest) => Present { value: digest }
    _ => none
  }
}

fn observed_cited_representation(
  media_type: MediaType,
  byte_domain: RepresentationByteDomain,
  observed_identity: Sha256Digest,
) -> ObservedCitedRepresentation {
  ObservedCitedRepresentation {
    media_type: media_type,
    byte_domain: byte_domain,
    observed_identity: observed_identity,
  }
}

fn reconcile_citation_representation(
  expected_pin: Pin<CitedRepresentation>,
  observed: ObservedCitedRepresentation?,
) -> CitationRepresentationReconciliation {
  match observed {
    Absent => ObservationMissing
    Present { value: o } =>
      if expected_pin.subject.byte_domain != o.byte_domain {
        RepresentationIncomparable {
          expected_domain: expected_pin.subject.byte_domain,
          observed_domain: o.byte_domain,
        }
      } else {
        match citation_pin_expected_sha256(pin: expected_pin) {
          Absent => RepresentationIncomparable {
            expected_domain: expected_pin.subject.byte_domain,
            observed_domain: o.byte_domain,
          }
          Present { value: expected } =>
            if content_hash_eq_cryptographic(left: expected, right: o.observed_identity) {
              RepresentationMatch
            } else {
              RepresentationMismatch {
                expected: expected,
                observed: o.observed_identity,
              }
            }
        }
      }
  }
}

fn fragment_selector(conforms_to: ExternalAuthority, value: NonEmptyStr) -> CitationSelector {
  FragmentSelectorVariant(FragmentSelector {
    conforms_to: conforms_to,
    value: value,
  })
}

fn text_quote_selector(
  exact: NonEmptyStr,
  prefix: NonEmptyStr?,
  suffix: NonEmptyStr?,
) -> CitationSelector {
  TextQuoteSelectorVariant(TextQuoteSelector {
    exact: exact,
    prefix: prefix,
    suffix: suffix,
  })
}

fn text_position_selector(start: NonNegativeInt, end: NonNegativeInt) -> CitationSelector {
  match nat_compare(a: end, b: start) {
    Less =>
      SelectorRefused {
        cause: TextPositionEndBeforeStart { start: start, end: end },
      }
    Equal =>
      TextPositionSelectorVariant(TextPositionSelector {
        start: start,
        end: end,
      })
    Greater =>
      TextPositionSelectorVariant(TextPositionSelector {
        start: start,
        end: end,
      })
  }
}

fn retrieved_representation(observed: ObservedCitedRepresentation?) -> RetrievedRepresentation {
  RetrievedRepresentation {
    observed: observed,
  }
}

fn cited_resource<Representation, Selector>(
  authority: ExternalAuthority,
  representation: Representation?,
  selector: Selector?,
) -> CitedResource<Representation, Selector> {
  CitedResource {
    authority: authority,
    representation: representation,
    selector: selector,
  }
}

type CitationRetrievalRequest {
  locator: Uri
}

type CitationRetrievalObservation
  = RepresentationRetrieved {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      http_status: HttpStatus,
      observed: ObservedCitedRepresentation,
    }
  | ResponseObservedWithoutRepresentation {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      http_status: HttpStatus,
    }
  | CitationAccessRefused {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      cause: CitationAccessRefusalCause,
    }
  | CitationUnreachable {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      cause: CitationUnreachableCause,
    }
  | CitationRateLimited {
      request: CitationRetrievalRequest,
      observed_at: EpochMs,
      retry_after: Second?,
    }

type CitationArtifactLayer
  = ObservingProductLayer
  | UpstreamModuleLayer { module_path: NonEmptyStr }

type CitationLayerAdmission
  = CitationLayerAdmitted
  | CitationLayerRefusedUpstreamObservation

fn admit_citation_retrieval_observation(
  layer: CitationArtifactLayer,
  observation: CitationRetrievalObservation,
) -> CitationLayerAdmission {
  match layer {
    ObservingProductLayer => CitationLayerAdmitted
    UpstreamModuleLayer { module_path: _ } =>
      match observation {
        RepresentationRetrieved { request: _, observed_at: _, http_status: _, observed: _ } =>
          CitationLayerRefusedUpstreamObservation
        ResponseObservedWithoutRepresentation { request: _, observed_at: _, http_status: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationAccessRefused { request: _, observed_at: _, cause: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationUnreachable { request: _, observed_at: _, cause: _ } =>
          CitationLayerRefusedUpstreamObservation
        CitationRateLimited { request: _, observed_at: _, retry_after: _ } =>
          CitationLayerRefusedUpstreamObservation
      }
  }
}

data citation_scaffold_dissolution_bind_note: String = "A Scaffold bind names a future declaration by design — the dissolution target that must come into existence before the scaffold retires — not evidence that must resolve now."

data citation_retrieval_observation_layer_gate_substrate_scaffold: Disposition = Scaffold {
  dissolves_to: SubstrateMandatoryTag,
  bind: DeclarationRef {
    module_path: "std.citation",
    decl_name: "admit_citation_retrieval_observation",
    field: WholeDeclaration,
  },
}

data citation_retrieval_observation_layer_gate_dissolve_on: String = "dissolve-on: citation_retrieval_observation_layer_gate — CIT-0 ships the layer check (admit_citation_retrieval_observation); DISSOLVES WHEN substrate mandatory-tag or typechecker refusal makes CitationRetrievalObservation unwritable inside extdeps upstream modules."

data citation_cit1_pdf_profile_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.standards.rfc_8118",
    decl_name: "extdeps_external_authority_anchor",
    field: WholeDeclaration,
  },
}

data citation_cit1_pdf_profile_dissolve_on: String = "dissolve-on: citation_cit1_pdf_profile — ordered RFC 8118 fragment sequence, safe profile (page, nameddest, structelem), navigable URL projection, and one real versioned PDF consumer land in CIT-1 after CIT-0 sign-off."

data citation_cit2_mediawiki_provider_observation_scaffold: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.mediawiki",
    decl_name: "extdeps_external_authority_anchor",
    field: WholeDeclaration,
  },
}

data citation_cit2_mediawiki_provider_observation_dissolve_on: String = "dissolve-on: citation_cit2_mediawiki_provider_observation — provider-bound revision lookup outcomes land in CIT-2 beside generic extdeps MediaWiki protocol shapes separate from site realizations."

type CitationRecordedFact<Representation, Selector> {
  cited: CitedResource<Representation, Selector>
}

fn citation_recorded_fact<Representation, Selector>(
  id: RecordedFactId,
  cited: CitedResource<Representation, Selector>,
) -> RecordedFact<CitationRecordedFact<Representation, Selector>> {
  RecordedFact {
    id: id,
    value: CitationRecordedFact { cited: cited },
  }
}

data citation_evidence_interface_note: String = "CitationRecordedFact is the provenance payload consumed by std.claim_evidence EvidenceLink — same authority, provenance, maximum_conclusion, fidelity, supporting/challenging, insufficiency, and EvidenceAdmissionPolicy machinery. Rich citations do not form a competing evidence system."
