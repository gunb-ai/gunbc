module std.judgment

data judgment_kernel_note: String = "A CRITERION states a question, a JUDGE answers it from evidence, a REVIEW composes judgments, and a RECOMMENDATION is a workflow projection of the review. This module is only the second and third of those, and it is deliberately the smallest shared thing that lets several criteria coexist without any of them losing its native verdict. The wrapper is generic in the verdict for exactly that reason: a grounding question is answered by a GroundingVerdict, a vacuity question by VacuityEvidence, and collapsing either into a shared Approve/RequestChanges coproduct would destroy the only information the criterion exists to produce. What is genuinely shared is not the ANSWER but the PROVENANCE -- who decided, and whether anything was decided at all -- so that is all this module owns."

data judgment_authority_note: String = "Provenance is an axis of the judgment, never of the verdict, which is why it is lifted out of the criterion's own coproduct. It also deliberately does NOT enumerate model vendors. A judge is a realization of 'typed question -> typed answer or refusal', and Claude, Cursor, Qwen or a Spark-served model are execution facts about one realization, not distinct kinds of judgment: moving the same model from a hosted endpoint onto srv5 must not change what its judgment MEANS. So the LLM arm carries only the identity of its attempt, and every execution fact -- requested and resolved model, artifact, serving runtime, machine opportunity, prompt and context policy, substrate, tokens, timing, energy -- lives in the LlmAttemptReceipt that identity resolves to. Local versus frontier is DERIVED from that receipt's opportunity and runtime; it is not two variants here. The external arm is different in kind: it points at an observed artifact rather than an execution we performed, and it must retain the author identity exactly as observed, because an artifact saying 'Cursor' is evidence about a byline and proves nothing about which model, build, host or runtime produced it."

type JudgmentAuthority
  = StructuralJudgment { rule: DeclarationRef }
  | LlmJudgment { attempt_identity: NonEmptyStr }
  | OperatorJudgment { adjudication_identity: NonEmptyStr }
  | ExternalArtifactJudgment { artifact_id: ArtifactId }

type Judgment<verdict> {
  verdict: verdict
  decided_by: JudgmentAuthority
}

data review_decision_note: String = "The three states a criterion can be in, kept apart because their remedies differ and a consumer that cannot tell them apart will fabricate one of them. DecisionReached carries a real answer. JudgeRequired says the mechanical layer could not settle it and hands over a BOUNDED question -- this is where a workflow state like the former PendingJudge belongs, not inside a domain verdict coproduct, because 'nobody has answered yet' is not an answer to 'what is this field'. DecisionRefused says the evidence cannot support any judgment, which is distinct from both a clean answer and an unanswered question: it is the fail-closed arm (DESIGN section 5), and collapsing it into a clearance is the absorbing fallback that makes an unreviewed tree read as a reviewed one. The question and cause are type parameters so each criterion states its own, rather than sharing a widened registry of everyone's failure modes."

type ReviewDecision<verdict, question, cause>
  = DecisionReached { judgment: Judgment<verdict> }
  | JudgeRequired { question: question }
  | DecisionRefused { cause: cause }

fn judgment_is_reached<verdict, question, cause>(d: ReviewDecision<verdict, question, cause>) -> Bool {
  match d {
    DecisionReached { judgment: _ } => true
    JudgeRequired { question: _ } => false
    DecisionRefused { cause: _ } => false
  }
}

data judgment_clearance_note: String = "The conjunct a promotion bar reads, stated once here so no consumer re-derives it and gets it wrong in the direction that matters. Only a REACHED decision can ever count as coverage: an unanswered question and a refusal are both absences of judgment, and counting either as a clearance is precisely the wrong-clear that a safety bar is built to make impossible. This is why the function is defined in terms of what IS decided rather than as a negation of refusal -- a future fourth state would then default to not-cleared rather than silently joining the cleared set."

fn judgment_awaits_judge<verdict, question, cause>(d: ReviewDecision<verdict, question, cause>) -> Bool {
  match d {
    DecisionReached { judgment: _ } => false
    JudgeRequired { question: _ } => true
    DecisionRefused { cause: _ } => false
  }
}

fn judgment_refused<verdict, question, cause>(d: ReviewDecision<verdict, question, cause>) -> Bool {
  match d {
    DecisionReached { judgment: _ } => false
    JudgeRequired { question: _ } => false
    DecisionRefused { cause: _ } => true
  }
}

fn judgment_authority_is_structural(a: JudgmentAuthority) -> Bool {
  match a {
    StructuralJudgment { rule: _ } => true
    LlmJudgment { attempt_identity: _ } => false
    OperatorJudgment { adjudication_identity: _ } => false
    ExternalArtifactJudgment { artifact_id: _ } => false
  }
}

fn judgment_authority_attempt_identity(a: JudgmentAuthority) -> NonEmptyStr? {
  match a {
    LlmJudgment { attempt_identity: id } => Present { value: id }
    StructuralJudgment { rule: _ } => none
    OperatorJudgment { adjudication_identity: _ } => none
    ExternalArtifactJudgment { artifact_id: _ } => none
  }
}
