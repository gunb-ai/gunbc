module std.credential_refusal

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef }
import extdeps.time.rfc3339 { Rfc3339ParseRefusal }

// THE FACTS A CREDENTIAL REFUSAL CARRIES, AND NOTHING THAT PRODUCES THEM. std.access names these in
// its refusal arms, and std.access sits under every authorization path in the tree -- including
// emitted crates such as gunbc.auth.approval_device_crypto_ingress's. When these types lived in
// std.credentials, importing them brought that module's clock reads (std.resources Clock,
// extdeps.clock) into every such closure, and an emitted crate built offline then demanded the async
// runtime the capability renders through (fleet-converge main run 42414019046). The types are
// declared here, with only value dependencies; std.credentials, the providers and the kernel import
// them, and the effectful acquisition stays in std.credentials.

// Why no deadline exists. Each is a distinct fact a reader acts on differently, and none of them is a
// deadline in disguise: unknown validity is never "valid", and it is never "non-expiring" either.
//
// NonExpiring is DELIBERATELY ABSENT. Absence of a scheduled expiry can be established only by the
// specific provider contract that says so, and no consumer of this carrier holds such a credential
// yet; the arm lands with that consumer and its cited contract (declared frontier), never as an
// arm a caller could choose for a token whose expiry it simply does not know.
type ValidityUnestablishedCause
  = ExpiryNotStated
  | ExpiryUndecodable { cause: Rfc3339ParseRefusal }
  | AcquiredOutsideThisProcess { origin: NonEmptyStr }
  | DeadlineArithmeticOverflow

// ── WHO THE CREDENTIAL AUTHENTICATES, AND FOR WHAT ───────────────────────────────────────────
// A binding is the provider's own record of what an acquisition established, declared in that
// provider's extdeps module and constructed only by its acquisition transaction from the validated
// request, the matching successful response and the provider's documented semantics. What crosses into
// the shared refusal is the axis -- the provider binding field, named by its declaration -- and the
// members on that axis in the provider's canonical identity spelling (a service-account email, a
// repository full name, a permission and level), so a member can never be paired with another axis.
type BindingAxis {
  field: DeclarationRef
}

type BindingMember {
  identity: NonEmptyStr
}

type BindingRefusal
  = BindingUnestablished { axis: BindingAxis }
  | BindingAxisMismatch { axis: BindingAxis, required: List<BindingMember>, held: List<BindingMember> }
