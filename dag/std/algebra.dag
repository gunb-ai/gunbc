fn algebra_method_template_name(name: String) -> Bool {
  all_algebra_profiles()
    |> any(profile => algebra_templates_for_profile(profile: profile) |> any(t => t.name == name))
}

fn algebra_templates_for_profile(profile: AlgebraProfile) -> FreeMonoid<AlgebraFieldTemplate> {
  match profile {
    OrderedRingProfile => ordered_ring_templates()
    OrderedSemiringProfile => ordered_semiring_templates()
    ApproximateFieldProfile => approximate_field_templates()
    BooleanAlgebraProfile => boolean_algebra_templates()
    FinitePowerSetProfile => finite_power_set_templates()
    PointwisePowerCollectionProfile => pointwise_power_collection_templates()
    FreeMonoidScalarProfile => free_monoid_scalar_templates()
    FreeMonoidCollectionProfile => free_monoid_collection_templates()
    PartialFunctionProfile => partial_function_templates()
    FinitelySupportedFunctionProfile => finitely_supported_function_templates()
  }
}

fn algebra_type_param_names(profile: AlgebraProfile) -> FreeMonoid<String> {
  match profile {
    OrderedRingProfile => []
    OrderedSemiringProfile => []
    ApproximateFieldProfile => []
    BooleanAlgebraProfile => []
    FinitePowerSetProfile => ["T"]
    PointwisePowerCollectionProfile => ["T"]
    FreeMonoidScalarProfile => []
    FreeMonoidCollectionProfile => ["T"]
    PartialFunctionProfile => ["K", "V"]
    FinitelySupportedFunctionProfile => ["K", "V"]
  }
}

fn all_algebra_profiles() -> FreeMonoid<AlgebraProfile> {
  [
    OrderedRingProfile,
    OrderedSemiringProfile,
    ApproximateFieldProfile,
    BooleanAlgebraProfile,
    FinitePowerSetProfile,
    PointwisePowerCollectionProfile,
    FreeMonoidScalarProfile,
    FreeMonoidCollectionProfile,
    PartialFunctionProfile,
    FinitelySupportedFunctionProfile,
  ]
}

fn all_algebra_field_templates() -> FreeMonoid<AlgebraFieldTemplate> {
  all_algebra_profiles()
    |> flat_map(profile => algebra_templates_for_profile(profile: profile))
}

fn all_algebra_template_names() -> FreeMonoid<String> {
  all_algebra_field_templates() |> map(template => template.name)
}

// trim is the importable free-function authority for whitespace trim on String. The declared
// substrate body is a pure-dag seam (1 / 0); semantic execution routes through free_call.trim
// (v1_rt::trim). Host realization authority: std.primitives trim_contract. Emitted host-native
// std.algebra::trim delegates to v1_rt::trim via rust_host_string_op_fn_emit. The scalar template
// row trim on FreeMonoid<String> is the method spelling on the same carrier. Free-call trim(s)
// requires explicit import std.algebra { trim } -- bare trim refuses via
// v1.compiler.infer_env bare_free_call_requires_listed_import registry even when std.algebra is
// already in the compilation pool (#6985 Class B pool coincidence closed on trim by #8062).

// Host realization routes to free_call.trim / v1_rt::trim. The declared body is the named
// String seam, so if the host arm is absent the call refuses by that identity rather than
// self-recursing. `s` is read so wiring-liveness holds.
fn trim(s: String) -> String {
  if s == s { pure_dag_seam_unreachable_string() } else { pure_dag_seam_unreachable_string() }
}

// Substring search on kernel host text (`std.types` String / v1 `&str`), not on
// `v2.std.text` `String` = `FreeMonoid<Char>`. Both arguments are already host text, so there is
// no UnicodeScalarSequenceUnfold crossing. Distinct from FreeMonoid collection `contains` (element
// membership of one Char). The scalar profile already lists this operation as `contains`
// [ReceiverSelf, ReceiverSelf] beside `trim` / `starts_with`; this free fn is the importable
// authority for that row, same placement as `trim`. It is not `std.types string_non_empty`: that
// is a where-predicate for NonEmptyStr inhabitance, not a text operation, and `std.types` already
// refuses to share `non_empty` with algebra. HostRealizedSeam is not an algebra-only class
// (`map_insert` lives on `v2.std.collection`). Contract: std.primitives string_contains_contract.
// Runtime bridge exists (`rt_function_registry` string_contains → v1_rt::string_contains), so this
// is a HostRealizedSeam self-call. Native emit: rust_host_string_op_fn_emit, selected by this
// declaration's projection row (not by the bare name `string_contains`). Import
// std.algebra { string_contains }; bare string_contains is the same Class B pool coincidence as trim.
fn string_contains(s: String, pattern: String) -> Bool {
  string_contains(s: s, pattern: pattern)
}

type FreeMonoidUniqueState<T> {
  seen: FreeMonoid<T>
  unique: Bool
}

fn fold_list<T, A>(xs: FreeMonoid<T>, empty: A, cons: fn(A, T) -> A) -> A {
  match xs {
    Empty => empty
    Cons { head: h, tail: t } => fold_list(xs: t, empty: cons(empty, h), cons: cons)
  }
}
fn fold_non_empty<T>(head: T, tail: FreeMonoid<T>, cons: fn(T, T) -> T) -> T {
  fold_list(xs: tail, empty: head, cons: cons)
}

fn join_separated<T>(fields: FreeMonoid<T>, separator: T, combine: fn(T, T) -> T, empty: T) -> T {
  match fields {
    Empty => empty
    Cons { head: first, tail: rest } =>
      fold_list(
        xs: rest,
        empty: first,
        cons: fn(acc, field) { combine(combine(acc, separator), field) }
      )
  }
}

fn string_concat_join(fields: FreeMonoid<String>, separator: String) -> String {
  join_separated(
    fields: fields,
    separator: separator,
    combine: fn(acc, field) { concat(acc, field) },
    empty: ""
  )
}

fn fold_list_right<T, A>(xs: FreeMonoid<T>, empty: A, snoc: fn(A, T) -> A) -> A {
  match xs {
    Empty => empty
    Cons { head: h, tail: t } => snoc(fold_list_right(xs: t, empty: empty, snoc: snoc), h)
  }
}

fn list_reverse<T>(xs: FreeMonoid<T>) -> FreeMonoid<T> {
  fold_list(xs: xs, empty: Empty, cons: fn(acc, item) {
    Cons { head: item, tail: acc }
  })
}

// LEFT FOLD, ONE PUSH PER ELEMENT. The right fold this replaced rebuilt the accumulator with a
// head insertion per element and recursed at list depth, a cost-shape defect (DESIGN 6); fold_list
// emits as a cursor loop and list_push appends in place, so map is one linear pass.
fn list_map<T, U>(xs: FreeMonoid<T>, f: fn(T) -> U) -> FreeMonoid<U> {
  fold_list(xs: xs, empty: Empty, cons: fn(acc, item) {
    list_push(xs: acc, item: f(item))
  })
}

fn list_flat_map<T, U>(xs: FreeMonoid<T>, f: fn(T) -> FreeMonoid<U>) -> FreeMonoid<U> {
  fold_list(xs: xs, empty: Empty, cons: fn(acc, item) {
    fold_list(xs: f(item), empty: acc, cons: fn(inner, produced) {
      list_push(xs: inner, item: produced)
    })
  })
}

fn list_tail<T>(xs: FreeMonoid<T>) -> Optional<FreeMonoid<T>> {
  match xs {
    Empty => Absent
    Cons { head: _, tail: t } => Present { value: t }
  }
}

fn list_head<T>(xs: FreeMonoid<T>) -> Optional<T> {
  match xs {
    Empty => Absent
    Cons { head: h, tail: _ } => Present { value: h }
  }
}

// list_head's mirror at the other end: the left fold keeps the item it last saw, so Empty => Absent (never a host null).
fn list_last<T>(xs: FreeMonoid<T>) -> Optional<T> {
  fold_list(xs: xs, empty: Absent, cons: fn(acc, item) { Present { value: item } })
}

fn skip<T>(xs: FreeMonoid<T>, n: Int) -> FreeMonoid<T> {
  if n <= 0 {
    xs
  } else {
    match xs {
      Empty => Empty
      Cons { head: _, tail: t } => skip(xs: t, n: n - 1)
    }
  }
}

// The first `n` members, in order. The merge sort below splits on it.
fn take_prefix<T>(xs: FreeMonoid<T>, n: Int) -> FreeMonoid<T> {
  if n <= 0 {
    Empty
  } else {
    match xs {
      Empty => Empty
      Cons { head: h, tail: t } => Cons { head: h, tail: take_prefix(xs: t, n: n - 1) }
    }
  }
}

// An item beside the key computed for it once, so the sort pays key_work n times and not per comparison
// (std.primitives sort_by_contract: n * (key_work + log n)).
type SortKeyed<T, K> {
  key: K
  item: T
}

// STABLE: on an equal key the left run's member is emitted first, so equal keys keep input order, as
// the host sort_by (a stable sort over canonical_content_cmp) does. A TAIL-RECURSIVE merge into an
// accumulator, one list_push per member and one list_append for the run left over: the head-building
// recursion it replaced constructed a Cons per member at merge depth, a clone and a head insertion
// each on the persistent carrier (DESIGN 6, a cost-shape defect fixed regardless of n).
fn sort_merge_runs<T, K>(
  left: FreeMonoid<SortKeyed<T, K>>,
  right: FreeMonoid<SortKeyed<T, K>>,
  order: TotalOrder<K>
) -> FreeMonoid<SortKeyed<T, K>> {
  sort_merge_into(left: left, right: right, order: order, acc: Empty)
}

fn sort_merge_into<T, K>(
  left: FreeMonoid<SortKeyed<T, K>>,
  right: FreeMonoid<SortKeyed<T, K>>,
  order: TotalOrder<K>,
  acc: FreeMonoid<SortKeyed<T, K>>
) -> FreeMonoid<SortKeyed<T, K>> {
  match left {
    Empty => list_append(left: acc, right: right)
    Cons { head: l, tail: lt } => match right {
      Empty => list_append(left: acc, right: left)
      Cons { head: r, tail: rt } => match order.compare(l.key, r.key) {
        Greater => sort_merge_into(left: left, right: rt, order: order, acc: list_push(xs: acc, item: r))
        Less => sort_merge_into(left: lt, right: right, order: order, acc: list_push(xs: acc, item: l))
        Equal => sort_merge_into(left: lt, right: right, order: order, acc: list_push(xs: acc, item: l))
      }
    }
  }
}

// Descent: `n` halves toward 1 on both branches (std.induction mergesort_bound, two branches,
// ProportionalShrink DivideByTwo, work_exponent 1).
fn sort_keyed_runs<T, K>(xs: FreeMonoid<SortKeyed<T, K>>, n: Int, order: TotalOrder<K>) -> FreeMonoid<SortKeyed<T, K>> {
  if n <= 1 {
    xs
  } else {
    sort_merge_runs(
      left: sort_keyed_runs(xs: take_prefix(xs: xs, n: n / 2), n: n / 2, order: order),
      right: sort_keyed_runs(xs: skip(xs: xs, n: n / 2), n: n - n / 2, order: order),
      order: order
    )
  }
}

fn int_compare_canonical(a: Int, b: Int) -> Ordering {
  if a < b { Less } else { if a > b { Greater } else { Equal } }
}

// The canonical content order on Int keys, the order the host sort_by applies to them.
fn int_total_order() -> TotalOrder<Int> {
  TotalOrder { compare: int_compare_canonical }
}

fn string_compare_canonical(a: String, b: String) -> Ordering {
  if a < b { Less } else { if a > b { Greater } else { Equal } }
}

// The canonical content order on String keys, the order the host sort_by applies to them (declared, not derived: the
// order a String key sorts under is this record's compare, which the migration's rows name explicitly).
fn string_total_order() -> TotalOrder<String> {
  TotalOrder { compare: string_compare_canonical }
}

// std.primitives sort_by_contract inhabited by a MODELED merge sort (named apart from the `sort_by` method
// spelling, which is a primitive with the host realization): no host seam, so the realization
// is this body. The key order is the caller's TotalOrder (the host admits String, Int and Bool keys
// under CanonicalOrdKey; those are the carriers whose TotalOrder is the canonical content order).
fn list_sort_by_key<T, K>(xs: FreeMonoid<T>, key: fn(T) -> K, order: TotalOrder<K>) -> FreeMonoid<T> {
  list_map(
    xs: sort_keyed_runs(
      xs: list_map(xs: xs, f: fn(item) { SortKeyed { key: key(item), item: item } }),
      n: length(xs: xs),
      order: order
    ),
    f: fn(k) { k.item }
  )
}

fn empty_map_primitive_delegate<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn empty_map<K, V>() -> Map<K, V> {
  empty_map_primitive_delegate()
}
fn map_insert_primitive_delegate<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  map_insert_primitive_delegate(m: m, key: key, value: value)
}
fn map_insert<K, V>(m: Map<K, V>, key: K, value: V) -> Map<K, V> {
  map_insert_primitive_delegate(m: m, key: key, value: value)
}

// LOOKUP IS TOTAL. A map either holds the key or does not, and both are answers — there is no
// third state in which the map fails to say. So the total form is the primitive and the
// Outcome-wrapped form below is a projection of it, not the other way round.
//
// The direction matters at the consumer. A caller reaching for `map_get_checked` must match a
// `Rejected` arm that no producer can construct, and the only arms available to it are the
// caller's own domain answers — so the unreachable arm gets bound to whichever domain answer is
// nearest, and a substrate failure would report as a domain fact. Exposing the total lookup
// removes the arm rather than asking every caller to dispose of it honestly.
fn map_lookup_primitive_delegate<K, V>(m: Map<K, V>, key: K) -> Optional<V> {
  map_lookup_primitive_delegate(m: m, key: key)
}
fn map_lookup<K, V>(m: Map<K, V>, key: K) -> Optional<V> {
  map_lookup_primitive_delegate(m: m, key: key)
}

// KEY MEMBERSHIP, the one presence predicate over a map: whether `key` has an entry, without its value.
// Callers that store a marker value (a map used as a set of paths) read membership here rather than
// each matching map_lookup's Optional to a Bool.
fn map_contains_key<K, V>(m: Map<K, V>, key: K) -> Bool {
  match map_lookup(m: m, key: key) {
    Present { value: _ } => true
    Absent => false
  }
}

// THE INDEXED READ IS THE `get` PRIMITIVE, PROJECTED TOTAL. `std.primitives` `get_contract` already
// declares its cost -- constant work on an ephemeral carrier, `log n` on the persistent one this List
// is -- so the read inhabits that contract rather than minting a second indexed read. The projection
// is total in the same way `map_lookup` is: an index outside the list is an answer (`Absent`), never a
// sentinel. The body was a fold from the head, O(index) per read, so a caller walking positions paid
// the quadratic the lexer cursor exists to remove.
fn list_at_primitive_delegate<T>(xs: FreeMonoid<T>, index: Int) -> Optional<T> {
  list_at_primitive_delegate(xs: xs, index: index)
}
fn list_at_optional<T>(xs: FreeMonoid<T>, index: Int) -> Optional<T> {
  list_at_primitive_delegate(xs: xs, index: index)
}

// THE MODELED REFERENCE FOR THE NATIVE KERNEL, and its only consumer is the equivalence witness
// `gunbc.primitive_egress` owes the `get` row: the same fixture through this fold and through the
// realized `list_at_optional`, equal answers in and out of range. It is not a second indexed read
// for callers -- it is O(index) and nothing in production reaches it.
type ListAtLookup<T>
  = ListAtMissing { remaining: Int }
  | ListAtFound { value: T }

fn list_at_reference<T>(xs: FreeMonoid<T>, index: Int) -> Optional<T> {
  match fold_list(
    xs: xs,
    empty: ListAtMissing { remaining: index },
    cons: fn(acc, item) {
      match acc {
        ListAtFound { value: _ } => acc
        ListAtMissing { remaining: r } =>
          if r == 0 {
            ListAtFound { value: item }
          } else {
            ListAtMissing { remaining: r - 1 }
          }
      }
    }
  ) {
    ListAtFound { value: v } => optional_present(value: v)
    ListAtMissing { remaining: _ } => optional_absent()
  }
}

// The key set of a map: the support of its FinitelySupportedFunction. A method call to the `map_keys`
// primitive (std.primitives map_keys_contract), so the realization is the one the method already has.
fn map_support_keys<K, V>(m: Map<K, V>) -> FreeMonoid<K> {
  m |> map_keys
}

fn is_empty<T>(xs: FreeMonoid<T>) -> Bool {
  match xs {
    Empty => true
    Cons { head: _, tail: _ } => false
  }
}

fn non_empty<T>(xs: FreeMonoid<T>) -> Bool {
  match is_empty(xs: xs) {
    true => false
    false => true
  }
}

// `count` is the primitive authority for carrier size (O(1) on the persistent-vector
// realization); the fold this replaced was O(n) per call, and the parse repeat loop calls
// length on the remaining-token list twice per element — an O(elements x tokens) quadratic
// measured at 40% of self-hosted parse self-time (2026-09-09, required-v2-native lane work).
fn length<T>(xs: FreeMonoid<T>) -> Int {
  xs |> count
}

fn for_all<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Bool {
  fold_list(xs: xs, empty: true, cons: fn(acc, item) {
    match acc {
      true => predicate(item)
      false => false
    }
  })
}

fn contains<T>(xs: FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Bool {
  xs.any(candidate => eq(candidate, item))
}

fn count_where<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Int {
  fold_list(xs: xs, empty: 0, cons: fn(count, item) {
    match predicate(item) {
      true => count + 1
      false => count
    }
  })
}

fn count_equal<T>(xs: FreeMonoid<T>, item: T, eq: fn(T, T) -> Bool) -> Int {
  count_where(xs: xs, predicate: fn(candidate) { eq(candidate, item) })
}

fn unique<T>(xs: FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  let state = fold_list(xs: xs, empty: FreeMonoidUniqueState { seen: Empty, unique: true }, cons: fn(acc, item) {
    match acc.unique {
      true => match count_equal(xs: acc.seen, item: item, eq: eq) {
        0 => FreeMonoidUniqueState { seen: Cons { head: item, tail: acc.seen }, unique: true }
        _ => FreeMonoidUniqueState { seen: acc.seen, unique: false }
      }
      false => acc
    }
  })
  state.unique
}



// FIRST MATCH, WITH THE EARLY EXIT. The closed vocabulary has any/filter/contains -- Bool, or the
// whole filtered list -- and none of them answers "the first element satisfying p, or nothing"
// without walking the rest. Expressing that as a fold over Optional is the shape this function
// exists to stop: the accumulator is already Present and the fold keeps walking, so every hit
// still pays the full length. Recursion on the cons cell RETURNS at the first hit.
//
// PROMOTED HERE FROM v2.workflow.compile_door_cause_ownership (review 64135). It was homed beside
// its single consumer under the facts-before-abstraction discipline, with the promotion rule
// written on it: "promote to std.algebra when a second consumer inhabits it, not before". The
// required-v2-native route's per-module file-refusal lookup is that second consumer, and it had
// re-expressed the shape as a non-short-circuiting fold -- net concepts growing by re-invention
// (DESIGN section 2) in a per-module x per-refusal position (section 6, bare minimum cost, which
// is fixed regardless of the realized n because n is not time-stable).
fn list_find_first<T>(xs: FreeMonoid<T>, predicate: fn(T) -> Bool) -> Optional<T> {
  match xs {
    Empty => optional_absent()
    Cons { head: h, tail: t } =>
      if predicate(h) {
        optional_present(value: h)
      } else {
        list_find_first(xs: t, predicate: predicate)
      }
  }
}

type ListPrefixState<T> {
  rest: FreeMonoid<T>
  matched: Bool
}

fn list_starts_with<T>(xs: FreeMonoid<T>, prefix: FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  let state = fold_list(
    xs: prefix,
    empty: ListPrefixState { rest: xs, matched: true },
    cons: fn(acc, item) {
      match acc.matched {
        false => acc
        true => match acc.rest {
          Empty => ListPrefixState { rest: Empty, matched: false }
          Cons { head: h, tail: t } => ListPrefixState { rest: t, matched: eq(h, item) }
        }
      }
    }
  )
  state.matched
}

fn non_empty_singleton<T>(item: T) -> FreeSemigroup<T> {
  FreeSemigroup { head: item, tail: Empty }
}

fn non_empty_append<T>(left: FreeSemigroup<T>, right: FreeSemigroup<T>) -> FreeSemigroup<T> {
  FreeSemigroup {
    head: left.head,
    tail: list_append(
      left: list_snoc_item(xs: left.tail, item: right.head),
      right: right.tail
    )
  }
}

fn non_empty_to_list<T>(xs: FreeSemigroup<T>) -> FreeMonoid<T> {
  Cons { head: xs.head, tail: xs.tail }
}

// ALL BUT THE LAST, IN ORDER. The recursion this replaced (Cons { head: h, tail: list_init(t) }) made the
// CALL DEPTH the list's length: under the seed interpreter every caller inherited an overflow at ~10^5
// members. §6 names the producer, not the reading: the RED claim
// v2.test.claim.execution.dag_emit_interface dag_string_scalar_body_read_by_slice_reaches_the_decode_lane,
// run through `claim_batch --claim-run`, re-derives that overflow on the replaced shape (it dies by stack
// overflow, not by a wrong answer), and v2.test.claim.derived_roster_seed_agreement
// rung_drop_standing_acquires_with_its_derived_roster reached the same depth through this combinator.
// DESIGN 6: a fixed cost, regardless of n. One native fold_list pass carries a lag pair — the element
// read one step ago is only committed to the kept list when its successor arrives — so the last element is
// what never gets committed, and the interpreter's stack never grows with n (fold_list is a seed native
// intercept, and the emitter lowers it to a cursor loop). The pass is linear because the accumulator grows
// by one list_push per step and BOTH realizations of that push share the spine instead of copying the
// members: the dry-lane rc_list_push (v1_rt.rs) is Rc::make_mut(..).push_back(..), and the clone make_mut
// takes when the handle is shared is im::Vector's structural-sharing clone -- O(1) per im-15.1.0
// vector/mod.rs "Clone for Vector", O(n) only up to the bounded inline threshold, never per member -- and
// the wet-lane list_push arm reads the receiver as a Value::List (value_to_list_carrier, copied = 0) and
// pushes on a clone of that same tree. What re-derives it is the interpreter's own MutationCounters
// list_push row (calls / entries copied / average per call; MutationCounters::fmt in
// src/v1/stage0/src/v1_interpreter.rs, printed as the [interp-stats] block by print_interp_stats in
// src/v1/stage0/src/bin/claim_batch.rs): a push that copied members would drive that average up with n
// instead of holding at one entry per call. A Cons-prepend fold would have rebuilt the accumulator per step.
type ListInitLag<T> {
  kept: FreeMonoid<T>
  pending: Optional<T>
}

fn list_init<T>(xs: FreeMonoid<T>) -> FreeMonoid<T> {
  fold_list(
    xs: xs,
    empty: ListInitLag { kept: Empty, pending: Absent },
    cons: fn(acc, item) {
      match acc.pending {
        Absent => ListInitLag { kept: acc.kept, pending: Present { value: item } }
        Present { value: p } =>
          ListInitLag { kept: list_push(xs: acc.kept, item: p), pending: Present { value: item } }
      }
    }
  ).kept
}

fn bag_eq<T>(xs: FreeMonoid<T>, ys: FreeMonoid<T>, eq: fn(T, T) -> Bool) -> Bool {
  if length(xs: xs) != length(xs: ys) {
    false
  } else {
    for_all(xs: xs, predicate: fn(item) {
      count_equal(xs: xs, item: item, eq: eq) == count_equal(xs: ys, item: item, eq: eq)
    })
  }
}

// ELEMENTWISE EQUALITY OF TWO SAME-LENGTH LISTS. The recursion this replaced put the call INSIDE the
// `&&` (eq(ha, hb) && zip_eq(a: ta, b: tb, eq: eq)), so the frame stayed live across the element
// comparison AND the whole rest of the list: host depth equalled the list's length. The v1 interpreter
// performs no tail-call optimization at all, so tail position would not have helped either — the only
// fixed-depth route in the wet lane is the intercepted fold_list (v1_interpreter.rs
// `native_intercept.fold_list`), which is also emitted as a __tco_loop, so it costs no host stack in
// either lane. §6: a proven cost-shape defect is always fixed, regardless of realized n.
// THE RED that re-derives the old shape: v2.test.claim.algebra.list_linear_combinators
// zip_eq_compares_a_list_too_long_to_recurse_over, run through the claim-batch binary
// src/v1/stage0/src/bin/claim_batch.rs. On the replaced shape it refuses inside this function at
// the interpreter's call-depth ceiling instead of answering. The consumer that showed up host-side
// is v2.test.claim.derived_roster_seed_agreement rung_drop_standing_acquires_with_its_derived_roster,
// which aborted on the host stack; the call-depth trace recorded in gunbc#15258 located it by
// climbing a fixed step per sibling through this function and v2.std.node node_edge_same_occurrence /
// node_same_occurrence — so the depth was a property of the list's length, not of its contents.
// The fold walks a's members once, carrying b's aligned tail in the accumulator. Once a mismatch is
// held the pass keeps its shape but stops calling `eq`, so a pair count matches the old short-circuit;
// the final is_empty over the leftover asks the question the old base case asked (a ran out before b).
type ZipEqWalk<T> {
  rest: FreeMonoid<T>
  agreed: Bool
}

fn zip_eq<T>(
  a: FreeMonoid<T>,
  b: FreeMonoid<T>,
  eq: fn(T, T) -> Bool
) -> Bool {
  let walk = fold_list(
    xs: a,
    empty: ZipEqWalk { rest: b, agreed: true },
    cons: fn(acc, item) {
      match acc.rest {
        Empty => ZipEqWalk { rest: Empty, agreed: false }
        Cons { head: hb, tail: tb } =>
          if acc.agreed {
            ZipEqWalk { rest: tb, agreed: eq(item, hb) }
          } else {
            ZipEqWalk { rest: tb, agreed: false }
          }
      }
    }
  )
  walk.agreed && is_empty(xs: walk.rest)
}

fn zip_map<A, B, C>(
  a: FreeMonoid<A>,
  b: FreeMonoid<B>,
  f: fn(A, B) -> C
) -> FreeMonoid<C> {
  match a {
    Empty => Empty
    Cons { head: ha, tail: ta } =>
      match b {
        Empty => Empty
        Cons { head: hb, tail: tb } =>
          Cons { head: f(ha, hb), tail: zip_map(a: ta, b: tb, f: f) }
      }
  }
}

fn reduce_or<T>(xs: FreeMonoid<T>, fallback: T, combine: fn(T, T) -> T) -> T {
  match xs {
    Empty => fallback
    Cons { head: h, tail: t } => fold_non_empty(head: h, tail: t, cons: combine)
  }
}

fn is_prefix_of<T>(
  prefix: FreeMonoid<T>,
  xs: FreeMonoid<T>,
  eq: fn(T, T) -> Bool
) -> Bool {
  match prefix {
    Empty => true
    Cons { head: h_prefix, tail: t_prefix } =>
      match xs {
        Empty => false
        Cons { head: h_xs, tail: t_xs } =>
          eq(h_prefix, h_xs) && is_prefix_of(prefix: t_prefix, xs: t_xs, eq: eq)
      }
  }
}
