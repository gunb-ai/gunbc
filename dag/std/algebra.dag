module std.algebra


type Magma<T> {
  op: fn(T, T) -> T
}

type Semigroup<T> {
  op: fn(T, T) -> T

}

type Monoid<T> {
  op: fn(T, T) -> T
  identity: T
}

type CommutativeMonoid<T> {
  op: fn(T, T) -> T
  identity: T

}

type Group<T> {
  op: fn(T, T) -> T
  identity: T
  inverse: fn(T) -> T
}

type AbelianGroup<T> {
  op: fn(T, T) -> T
  identity: T
  inverse: fn(T) -> T

}

type GroupCompletion<M> {
  pos: M
  neg: M
}

type FieldOfFractions<R> {
  num: R
  denom: R
}

type Semiring<T> {
  add: fn(T, T) -> T
  zero: T
  mul: fn(T, T) -> T
  one: T
}

type CommutativeSemiring<T> {
  add: fn(T, T) -> T
  zero: T
  mul: fn(T, T) -> T
  one: T
}

type Ring<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
}

type OrderedRing<T> {
  add: fn(T, T) -> T
  sub: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  div: fn(T, T) -> Result<T, std.error_primitives.DivError>
  one: T
  compare: fn(T, T) -> Ordering
  eq: fn(T, T) -> Bool
  ne: fn(T, T) -> Bool
  lt: fn(T, T) -> Bool
  le: fn(T, T) -> Bool
  gt: fn(T, T) -> Bool
  ge: fn(T, T) -> Bool
}

type Field<T> {
  add: fn(T, T) -> T
  zero: T
  negate: fn(T) -> T
  mul: fn(T, T) -> T
  one: T
  reciprocal: fn(T) -> T
  compare: fn(T, T) -> Ordering
}

type Lattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
}

type BoundedLattice<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
  top: T
  bottom: T
}

type BooleanAlgebra<T> {
  meet: fn(T, T) -> T
  join: fn(T, T) -> T
  complement: fn(T) -> T
  top: T
  bottom: T
}

type PointwisePower<T> {
  member: fn(T) -> Bool
}

// THE FINITE POWER SET -- Pfin, the set of FINITE subsets -- is the enumerable counterpart of
// `PointwisePower` above, which presents the full power set as a characteristic function. The two
// sit on the SUPPORT axis exactly as `PartialFunction` and `FinitelySupportedFunction` do below:
// one answers membership and nothing else, the other can be walked.
//
// AUTHORED HERE BECAUSE THE CONCEPT WAS ALREADY IN TREE UNDER A BORROWED NAME. Every language that
// carries an algebra inhabitant row files the finite-set realization under `"BooleanAlgebra"`:
//
//   rust        BTreeSet<{0}>            go          map[{0}]struct{}
//   python      set[{0}]                 typescript  Set<{0}>
//
// Four independent realizations, four finite-set containers, not one lattice among them -- while
// the TYPE `BooleanAlgebra<T>` is `{ meet, join, complement, top, bottom }` and its only
// construction in the corpus is `v2.std.logic` `bool_boolean_algebra`, a genuine Boolean algebra
// over `Bool`. The realization roster and the type disagreed about what the name meant, and the
// rust roster carried the tell outright: the `"BooleanAlgebra"` and `"PointwisePower"` rows were
// BYTE-IDENTICAL, two algebra names resolving to one realization with nothing saying which was
// which. This declaration takes the finite-set concept out from under the lattice's name; the
// lattice keeps its name, its type and its one construction site unchanged.
type FinitePowerSet<T> {
  member: fn(T) -> Bool
  union: fn(FinitePowerSet<T>) -> FinitePowerSet<T>
  intersect: fn(FinitePowerSet<T>) -> FinitePowerSet<T>
  diff: fn(FinitePowerSet<T>) -> FinitePowerSet<T>
  contains: fn(T) -> Bool
  count: fn() -> Int
  length: fn() -> Int
}

type FreeMonoid<T>
  = Empty
  | Cons { head: T, tail: std.algebra.FreeMonoid<T> }

type FreeSemigroup<T> {
  head: T
  tail: std.algebra.FreeMonoid<T>
}

// TWO AXES, THREE INHABITED CORNERS. The family below is a 2x2 space and the corpus lives in
// three of its corners, so three carriers are authored and the fourth is named rather than
// silently omitted.
//
// TOTALITY -- does the function answer at every point (`fn(K) -> V`) or may it decline
// (`fn(K) -> V?`) -- is independent of SUPPORT -- does it differ from the absent value at
// finitely many points, so that it can be enumerated, or at arbitrarily many, so that it cannot.
//
//                   arbitrary support           finite support
//   total           TotalMap                    (uninhabited)
//   partial         PartialFunction             FinitelySupportedFunction
//
// The uninhabited corner is REPRESENTABLE, not impossible: a total function taking a non-default
// value at finitely many points is a perfectly good object. It is unauthored because no corpus
// site needs one. The condition that fills it is a site that must both answer everywhere and be
// enumerated; author it then, and not before.
//
// The predicate family sits on the same support axis one row up: `PointwisePower` is the full
// power set presented as a characteristic function, and its finite counterpart has no carrier
// yet -- see the `Set` alias in `std.types` for that open half and its trigger.
type PartialFunction<K, V> {
  lookup: fn(K) -> V?
}

// FINITE SUPPORT IS WHAT MAKES THE ENUMERATION SURFACE HONEST. Everything below `lookup` here --
// keys, values, size, and the insert/merge that must preserve them -- is answerable only because
// the support is finite. That is exactly why these rows may not sit on `PartialFunction`: an open
// partial function cannot produce `map_keys` at all, and until this split every one of the 145
// `Map { lookup: .. }` literals in the corpus named a carrier promising ten operations it
// supplied one of. Measured before the split: 0 of those 145 supplied any field beyond `lookup`.
//
// `lookup` appears on BOTH carriers rather than being inherited, because the substrate has no
// subtyping: a finite map really does answer lookup, and saying so twice is the honest encoding
// of "this one can do everything that one can, and more".
//
// RECORDED, NOT INTRODUCED, and not dissolved here: `lookup`, `get` and `map_get` are three
// spellings of one operation, which the template rosters below carry as three rows. That is the
// same Section 3 fork `algebra_count_length_name_fork_note` records for count/length/size, it
// predates this change, and collapsing it is a corpus-wide rename touching every call site --
// its own lane. The split neither widens nor narrows it; the three spellings move together.
type FinitelySupportedFunction<K, V> {
  lookup: fn(K) -> V?
  empty: FinitelySupportedFunction<K, V>
  get: fn(K) -> V?
  insert: fn(K, V) -> PartialFunction<K, V>
  merge: fn(PartialFunction<K, V>) -> PartialFunction<K, V>
  map_keys: fn() -> std.algebra.FreeMonoid<K>
  map_values: fn() -> std.algebra.FreeMonoid<V>
  insert: fn(K, V) -> FinitelySupportedFunction<K, V>
  merge: fn(FinitelySupportedFunction<K, V>) -> FinitelySupportedFunction<K, V>
  map_keys: fn() -> FreeMonoid<K>
  map_values: fn() -> FreeMonoid<V>
  map_has: fn(K) -> Bool
  contains_key: fn(K) -> Bool
  size: fn() -> Int
}

// MOVED HERE from `v2.std.collection` by the change that split `PartialFunction`. They are the
// total corner of the family above, and leaving them in a different module from their own axis is
// where a fork starts. `TotalPolicy` travels with `TotalMap` rather than staying behind: it is the
// same total lookup carrying a context argument, and splitting a pair across two modules is the
// thing this change exists to stop doing.
//
// Both had ZERO code consumers at the time of the move -- one declaration each and two prose cells
// in `gunbc.plans.self_applying_lenses`, which marks `table_decision_tree` as an Unrealized
// scaffold and names these as its target substrate rows. So they are carriers authored ahead of a
// consumer that a plan does declare, which is weaker than an untracked scaffold and stronger than
// healthy. The home is the cheap part of the answer; the consumer is that plan's to land.
type TotalMap<K, V> {
  lookup: fn(K) -> V
}

type TotalPolicy<K, Context, RowTemplate> {
  lookup: fn(K, Context) -> RowTemplate
}

type Ordering = Less | Equal | Greater

type OrderingFold<R> {
  less: R
  equal: R
  greater: R
}

fn ordering_fold<R>(o: Ordering, fold: OrderingFold<R>) -> R {
  match o {
    Less => fold.less
    Equal => fold.equal
    Greater => fold.greater
  }
}

fn ordering_is_less(o: Ordering) -> Bool {
  ordering_fold(
    o: o,
    fold: OrderingFold {
      less: true,
      equal: false,
      greater: false,
    },
  )
}

type AlgebraProfile
  = OrderedRingProfile
  | ApproximateFieldProfile
  | BooleanAlgebraProfile
  | FinitePowerSetProfile
  | PointwisePowerCollectionProfile
  | FreeMonoidScalarProfile
  | FreeMonoidCollectionProfile
  | PartialFunctionProfile
  | FinitelySupportedFunctionProfile

type ContainerSource
  = SameAsReceiver
  | Named { name: String }

type AlgebraTypeTemplate
  = ReceiverSelf
  | ReceiverElement
  | ReceiverKey
  | ReceiverValue
  | NamedTemplate { name: String }
  | ContainerOf { source: ContainerSource, element: AlgebraTypeTemplate }
  | OptionalOf { inner: AlgebraTypeTemplate }
  | WitnessOf { inner: AlgebraTypeTemplate }
  | TupleOf { first: AlgebraTypeTemplate, second: AlgebraTypeTemplate }
  | CallableOf { params: List<AlgebraTypeTemplate>, return_type: AlgebraTypeTemplate }
  | AlgebraTypeVariable { id: String }

type CollectionSizeEffect
  = ShrinkEffect
  | ProjectionEffect
  | IdentityEffect

type CostShape
  = ShapeConstant
  | ShapeLinearScan
  | ShapeIterateBody
  | ShapeSortBody

type AlgebraFieldTemplate {
  name: String
  param_types: List<AlgebraTypeTemplate>
  return_type: AlgebraTypeTemplate
  size_effect: CollectionSizeEffect?
  cost_shape: CostShape?

  callback_element_position: Int?
}

// ONE ROSTER, DECLARED ONCE, AND EVERY SPELLING-KEYED MAP BELOW IS A FOLD OVER IT.
//
// What stood here was `kernel_algebra_profile` written out as a nest of ten `map_insert` calls
// keyed on type-name strings, beside four further hand-authored spelling maps in `std.types`
// (`container_template_algebra_rows`, `container_template_alias_rows`, `container_type_arity`,
// `canonical_container_names`). Five maps, one subject: which carrier a spelling names and what
// that carrier answers for. Nothing joined them, so a carrier existed in a map exactly insofar as
// an author remembered to write it there -- and the failure mode is not hypothetical, it is what
// the deleted note above this row recorded: `PartialFunction` had a carrier, a template set and a
// profile, and no `kernel_algebra_profile` key, so `tree.facts.lookup(node)` refused on a
// `PartialFunction` receiver while the byte-identical call on `Map` resolved. That repair was
// three inserted rows. The eleventh carrier forks the same way, in whichever of the five maps its
// author does not think of.
//
// The move is DESIGN section 2-horizontal: model the carrier once, derive every use. `AlgebraCarrier`
// carries `profile` as a required field, so a carrier row cannot be authored without one --
// the invalid state (a carrier with no algebra) has no spelling, which is section 4b structural
// impossibility for that class rather than a check. Each spelling then DECLARES its membership in
// every derived map, and `RowAbsent` carries a reason, so an omission is an authored answer
// someone had to write rather than a row nobody wrote. That is the property the five literals
// could not have: adding a carrier now means answering five questions in one place, and leaving
// one unanswered is a missing field, not a silent hole.
//
// RUNG, honestly: this is *structurally guaranteed* for "a carrier without a profile" and
// "a carrier absent from a map by oversight", and NOT a wall on the memberships themselves --
// an author can still declare `RowAbsent` with a bad reason and get exactly the old behaviour.
// The next-rung trigger is each membership becoming derivable from a property the carrier already
// has (arity from `algebra_type_param_names`, roster membership from whether the profile is a
// collection), which needs the two remaining `std.types` literals this change does not reach --
// `ordered_element_collections` and the non-carrier `Witness` row -- to be grounded first.
type CarrierRowMembership
  = RowPresent
  | RowAbsent { reason: String }

// The five derived maps, one field each. A new membership question means a new field here, and
// every existing carrier then fails to compile until it answers it -- which is the point.
type CarrierSpelling {
  text: String

  method_surface: CarrierRowMembership
  container_algebra_row: CarrierRowMembership
  container_alias_row: CarrierRowMembership
  container_roster_name: CarrierRowMembership
  container_arity_row: CarrierRowMembership
}

type AlgebraCarrier {
  name: String
  profile: AlgebraProfile
  spellings: List<CarrierSpelling>
}

data scalar_carrier_not_container_reason: String = "scalar carrier: names no container, so it holds no container-spelling row"

data snake_case_spelling_not_alias_reason: String = "snake spelling: resolves as an algebra name, not as a declared container alias"

data canonical_spelling_sorts_ahead_of_alias_reason: String = "container_alias_canonical_spelling returns the FIRST sorted key mapping to an algebra, so this key would sort ahead of its own alias and silently become the emitted canonical spelling"

data carrier_name_is_not_a_declaration_spelling_reason: String = "the carrier name is not written in declaration position; its alias carries the profile"

data arity_row_is_alias_spellings_only_reason: String = "container_type_arity is consulted by is_container_type on authored declaration spellings; adding a key here decides containerhood for that spelling"

fn scalar_carrier_spelling(text: String) -> CarrierSpelling {
  CarrierSpelling {
    text: text,
    method_surface: RowPresent,
    container_algebra_row: RowAbsent { reason: scalar_carrier_not_container_reason },
    container_alias_row: RowAbsent { reason: scalar_carrier_not_container_reason },
    container_roster_name: RowAbsent { reason: scalar_carrier_not_container_reason },
    container_arity_row: RowAbsent { reason: scalar_carrier_not_container_reason },
  }
}

fn snake_alias_spelling(text: String) -> CarrierSpelling {
  CarrierSpelling {
    text: text,
    method_surface: RowAbsent { reason: carrier_name_is_not_a_declaration_spelling_reason },
    container_algebra_row: RowPresent,
    container_alias_row: RowPresent,
    container_roster_name: RowAbsent { reason: snake_case_spelling_not_alias_reason },
    container_arity_row: RowAbsent { reason: arity_row_is_alias_spellings_only_reason },
  }
}

fn snake_algebra_spelling(text: String) -> CarrierSpelling {
  CarrierSpelling {
    text: text,
    method_surface: RowAbsent { reason: carrier_name_is_not_a_declaration_spelling_reason },
    container_algebra_row: RowPresent,
    container_alias_row: RowAbsent { reason: snake_case_spelling_not_alias_reason },
    container_roster_name: RowAbsent { reason: snake_case_spelling_not_alias_reason },
    container_arity_row: RowAbsent { reason: arity_row_is_alias_spellings_only_reason },
  }
}

// THE ALIAS SPELLING IS THE ONE WRITTEN IN DECLARATION POSITION -- `List`, `Set`, `Map` -- so it
// is the one that carries every row: the profile that decides whether a receiver has a method
// surface, the algebra it names, its own alias row, the container roster, and the arity checked
// against an authored type expression.
fn pascal_alias_spelling(text: String) -> CarrierSpelling {
  CarrierSpelling {
    text: text,
    method_surface: RowPresent,
    container_algebra_row: RowPresent,
    container_alias_row: RowPresent,
    container_roster_name: RowPresent,
    container_arity_row: RowPresent,
  }
}

// TWO ROWS BELOW ARE NOT MECHANICAL, and both are stated here rather than beside the row because
// a section 4c annotation attaches to a module-scope declaration, not to a line inside a body.
//
// `PartialFunction` carries its own alias row, unlike every other carrier name: no alias competes
// for that algebra, so the carrier name IS the declaration spelling -- which is why
// `resolve_method_receiver_type` returns a `PartialFunction` receiver as authored, type arguments
// intact. Every other canonical name declines the alias row because
// `container_alias_canonical_spelling` returns the first sorted key for an algebra, so
// `"FinitelySupportedFunction"` would sort ahead of `"Map"` and silently become the emitted
// canonical spelling.
//
// `PointwisePower` declares `method_surface` ABSENT, and the reason is a measurement not taken
// rather than a property of the carrier. Its 80 declaration positions predate the carrier split,
// its templates are a different set from `FinitePowerSet`'s, and `RowPresent` would flip the
// method-existence wall from UNDECIDED to DECIDED for all 80 at once -- turning any method absent
// from `pointwise_power_collection_templates` into a hard `MethodNotFound`. Under the five
// literals this was an omission indistinguishable from forgetting; here it is an authored row
// with a reason, which is the whole difference this change buys.
fn algebra_carriers() -> List<AlgebraCarrier> {
  [
    AlgebraCarrier {
      name: "Int",
      profile: OrderedRingProfile,
      spellings: [scalar_carrier_spelling(text: "Int")],
    },
    AlgebraCarrier {
      name: "Float",
      profile: ApproximateFieldProfile,
      spellings: [scalar_carrier_spelling(text: "Float")],
    },
    AlgebraCarrier {
      name: "BooleanAlgebra",
      profile: BooleanAlgebraProfile,
      spellings: [
        scalar_carrier_spelling(text: "Bool"),
        CarrierSpelling {
          text: "BooleanAlgebra",
          method_surface: RowAbsent { reason: carrier_name_is_not_a_declaration_spelling_reason },
          container_algebra_row: RowPresent,
          container_alias_row: RowAbsent { reason: canonical_spelling_sorts_ahead_of_alias_reason },
          container_roster_name: RowAbsent { reason: "the lattice is not a container: its container inhabitant row moved to FinitePowerSet" },
          container_arity_row: RowAbsent { reason: arity_row_is_alias_spellings_only_reason },
        },
        snake_algebra_spelling(text: "boolean_algebra"),
      ],
    },
    AlgebraCarrier {
      name: "String",
      profile: FreeMonoidScalarProfile,
      spellings: [scalar_carrier_spelling(text: "String")],
    },
    AlgebraCarrier {
      name: "FreeMonoid",
      profile: FreeMonoidCollectionProfile,
      spellings: [
        pascal_alias_spelling(text: "List"),
        snake_alias_spelling(text: "list"),
        CarrierSpelling {
          text: "FreeMonoid",
          method_surface: RowAbsent { reason: carrier_name_is_not_a_declaration_spelling_reason },
          container_algebra_row: RowPresent,
          container_alias_row: RowAbsent { reason: canonical_spelling_sorts_ahead_of_alias_reason },
          container_roster_name: RowPresent,
          container_arity_row: RowAbsent { reason: arity_row_is_alias_spellings_only_reason },
        },
        snake_algebra_spelling(text: "free_monoid"),
      ],
    },
    AlgebraCarrier {
      name: "FinitePowerSet",
      profile: FinitePowerSetProfile,
      spellings: [
        pascal_alias_spelling(text: "Set"),
        snake_alias_spelling(text: "set"),
        CarrierSpelling {
          text: "FinitePowerSet",
          method_surface: RowPresent,
          container_algebra_row: RowPresent,
          container_alias_row: RowAbsent { reason: canonical_spelling_sorts_ahead_of_alias_reason },
          container_roster_name: RowPresent,
          container_arity_row: RowAbsent { reason: arity_row_is_alias_spellings_only_reason },
        },
        snake_algebra_spelling(text: "finite_power_set"),
      ],
    },
    AlgebraCarrier {
      name: "FinitelySupportedFunction",
      profile: FinitelySupportedFunctionProfile,
      spellings: [
        pascal_alias_spelling(text: "Map"),
        snake_alias_spelling(text: "map"),
        CarrierSpelling {
          text: "FinitelySupportedFunction",
          method_surface: RowPresent,
          container_algebra_row: RowPresent,
          container_alias_row: RowAbsent { reason: canonical_spelling_sorts_ahead_of_alias_reason },
          container_roster_name: RowPresent,
          container_arity_row: RowAbsent { reason: arity_row_is_alias_spellings_only_reason },
        },
        snake_algebra_spelling(text: "finitely_supported_function"),
      ],
    },
    AlgebraCarrier {
      name: "PartialFunction",
      profile: PartialFunctionProfile,
      spellings: [
        CarrierSpelling {
          text: "PartialFunction",
          method_surface: RowPresent,
          container_algebra_row: RowPresent,
          container_alias_row: RowPresent,
          container_roster_name: RowPresent,
          container_arity_row: RowAbsent { reason: arity_row_is_alias_spellings_only_reason },
        },
        snake_alias_spelling(text: "partial_function"),
      ],
    },
    AlgebraCarrier {
      name: "PointwisePower",
      profile: PointwisePowerCollectionProfile,
      spellings: [
        CarrierSpelling {
          text: "PointwisePower",
          method_surface: RowAbsent { reason: "80 declaration positions would flip from MethodExistenceUndecided to a hard MethodNotFound for any method absent from pointwise_power_collection_templates; that measurement is not taken" },
          container_algebra_row: RowPresent,
          container_alias_row: RowAbsent { reason: canonical_spelling_sorts_ahead_of_alias_reason },
          container_roster_name: RowPresent,
          container_arity_row: RowAbsent { reason: arity_row_is_alias_spellings_only_reason },
        },
        snake_algebra_spelling(text: "pointwise_power"),
      ],
    },
  ]
}

fn carrier_spelling_row_present(m: CarrierRowMembership) -> Bool {
  match m {
    RowPresent => true
    RowAbsent { reason: _ } => false
  }
}

fn kernel_algebra_profile_value() -> Map<String, AlgebraProfile> {
  algebra_carriers() |> fold(init: empty_map(), f: (acc, carrier) =>
    carrier.spellings |> fold(init: acc, f: (inner, spelling) =>
      if carrier_spelling_row_present(m: spelling.method_surface) {
        map_insert(inner, spelling.text, carrier.profile)
      } else {
        inner
      }))
}

fn carrier_container_algebra_rows() -> Map<String, String> {
  algebra_carriers() |> fold(init: empty_map(), f: (acc, carrier) =>
    carrier.spellings |> fold(init: acc, f: (inner, spelling) =>
      if carrier_spelling_row_present(m: spelling.container_algebra_row) {
        map_insert(inner, spelling.text, carrier.name)
      } else {
        inner
      }))
}

fn carrier_container_alias_rows() -> Map<String, String> {
  algebra_carriers() |> fold(init: empty_map(), f: (acc, carrier) =>
    carrier.spellings |> fold(init: acc, f: (inner, spelling) =>
      if carrier_spelling_row_present(m: spelling.container_alias_row) {
        map_insert(inner, spelling.text, carrier.name)
      } else {
        inner
      }))
}

fn carrier_container_roster_map() -> Map<String, Bool> {
  algebra_carriers() |> fold(init: empty_map(), f: (acc, carrier) =>
    carrier.spellings |> fold(init: acc, f: (inner, spelling) =>
      if carrier_spelling_row_present(m: spelling.container_roster_name) {
        map_insert(inner, spelling.text, true)
      } else {
        inner
      }))
}

// The arity is DERIVED from the profile's own type parameters rather than restated as a number:
// `FinitePowerSet` is unary because `algebra_type_param_names` says `["T"]`, so a carrier cannot
// declare an arity that disagrees with its algebra.
fn carrier_container_arity_rows() -> Map<String, Int> {
  algebra_carriers() |> fold(init: empty_map(), f: (acc, carrier) =>
    carrier.spellings |> fold(init: acc, f: (inner, spelling) =>
      if carrier_spelling_row_present(m: spelling.container_arity_row) {
        map_insert(inner, spelling.text, algebra_type_param_names(profile: carrier.profile) |> fold(init: 0, f: (n, _) => n + 1))
      } else {
        inner
      }))
}

data kernel_algebra_profile: Map<String, AlgebraProfile> = kernel_algebra_profile_value()

fn ordered_ring_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "add", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "zero", param_types: [], return_type: ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "negate", param_types: [ReceiverSelf], return_type: ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "mul", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "one", param_types: [], return_type: ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "compare", param_types: [ReceiverSelf, ReceiverSelf], return_type: NamedTemplate { name: "Ordering" }, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "clamp", param_types: [ReceiverSelf, ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf, size_effect: none, cost_shape: Present { value: ShapeConstant }, callback_element_position: none }
  ]
}

fn approximate_field_templates() -> List<AlgebraFieldTemplate> {
  [
    { name: "add", param_types: [ReceiverSelf, ReceiverSelf], return_type: ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "zero", param_types: [], return_type: ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
    { name: "negate", param_types: [ReceiverSelf], return_type: ReceiverSelf, size_effect: none, cost_shape: none, callback_element_position: none },
