module std.encoding

import std.algebra { BoundedLattice }
import std.types { Bytes }
import std.integer { UInt8 }
import std.bytes { pure_dag_seam_unreachable }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type Encoding
  = ASCII
  | UTF8
  | Latin1
  | Text
  | Binary
  | Unknown

fn encoding_rank(e: Encoding) -> Int {
  match e {
    ASCII => 0
    UTF8 => 1
    Latin1 => 1
    Text => 2
    Binary => 2
    Unknown => 3
  }
}

fn is_text_encoding(e: Encoding) -> Bool {
  match e {
    ASCII => true
    UTF8 => true
    Latin1 => true
    Text => true
    Binary => false
    Unknown => false
  }
}

fn encoding_lattice_meet(a: Encoding, b: Encoding) -> Encoding {
  match a {
    Unknown => b
    ASCII => ASCII
    Binary => match b {
      Binary => Binary
      Unknown => Binary
      _ => ASCII
    }
    UTF8 => match b {
      Unknown => UTF8
      Text => UTF8
      UTF8 => UTF8
      _ => ASCII
    }
    Latin1 => match b {
      Unknown => Latin1
      Text => Latin1
      Latin1 => Latin1
      _ => ASCII
    }
    Text => match b {
      Unknown => Text
      Text => Text
      UTF8 => UTF8
      Latin1 => Latin1
      ASCII => ASCII
      Binary => ASCII
    }
  }
}

fn encoding_lattice_join(a: Encoding, b: Encoding) -> Encoding {
  match a {
    ASCII => b
    Unknown => Unknown
    Binary => match b {
      Binary => Binary
      ASCII => Binary
      Unknown => Unknown
      _ => Unknown
    }
    UTF8 => match b {
      ASCII => UTF8
      UTF8 => UTF8
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Latin1 => match b {
      ASCII => Latin1
      Latin1 => Latin1
      UTF8 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Text => match b {
      ASCII => Text
      UTF8 => Text
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
  }
}

data encoding_bounded_lattice: BoundedLattice<Encoding> = {
  meet: encoding_lattice_meet
  join: encoding_lattice_join
  top: Unknown
  bottom: ASCII
}

// WHETHER AN OCTET SEQUENCE IS UTF-8, DECIDED BEFORE ANY DECODE IS ATTEMPTED. utf8_decode_bytes is a
// host seam whose refusal on malformed input is a runtime error, which stops an entire run rather
// than refusing the one payload that was malformed. A caller holding bytes from outside - a file read
// from a public repository, say - asks this first and routes "not UTF-8" as a value.
//
// The grammar is RFC 3629 section 4 (UTF8-octets), table-driven by the lead octet: each lead fixes how
// many continuation octets follow and the range the FIRST of them must fall in, which is what excludes
// overlong forms (C0, C1, E0 80-9F, F0 80-8F), UTF-16 surrogates (ED A0-BF) and code points above
// U+10FFFF (F4 90-BF, F5-FF). Every later continuation is 80-BF.
type Utf8ScanState
  = Utf8AtBoundary
  | Utf8ExpectFirst { low: Int, high: Int, remaining_after: Int }
  | Utf8ExpectContinuation { remaining: Int }
  | Utf8Malformed

fn utf8_octet_value(o: UInt8) -> Int {
  o
}

fn utf8_lead_state(v: Int) -> Utf8ScanState {
  if v <= 127 { Utf8AtBoundary }
  else if v >= 194 && v <= 223 { Utf8ExpectFirst { low: 128, high: 191, remaining_after: 0 } }
  else if v == 224 { Utf8ExpectFirst { low: 160, high: 191, remaining_after: 1 } }
  else if (v >= 225 && v <= 236) || v == 238 || v == 239 { Utf8ExpectFirst { low: 128, high: 191, remaining_after: 1 } }
  else if v == 237 { Utf8ExpectFirst { low: 128, high: 159, remaining_after: 1 } }
  else if v == 240 { Utf8ExpectFirst { low: 144, high: 191, remaining_after: 2 } }
  else if v >= 241 && v <= 243 { Utf8ExpectFirst { low: 128, high: 191, remaining_after: 2 } }
  else if v == 244 { Utf8ExpectFirst { low: 128, high: 143, remaining_after: 2 } }
  else { Utf8Malformed }
}

fn utf8_scan_step(st: Utf8ScanState, v: Int) -> Utf8ScanState {
  match st {
    Utf8Malformed => Utf8Malformed
    Utf8AtBoundary => utf8_lead_state(v: v)
    Utf8ExpectFirst { low, high, remaining_after } =>
      if v < low || v > high { Utf8Malformed }
      else if remaining_after == 0 { Utf8AtBoundary }
      else { Utf8ExpectContinuation { remaining: remaining_after } }
    Utf8ExpectContinuation { remaining } =>
      if v < 128 || v > 191 { Utf8Malformed }
      else if remaining == 1 { Utf8AtBoundary }
      else { Utf8ExpectContinuation { remaining: remaining - 1 } }
  }
}

fn utf8_octets_well_formed(octets: List<UInt8>) -> Bool {
  match fold(octets, init: Utf8AtBoundary, f: (st, o) => utf8_scan_step(st: st, v: utf8_octet_value(o: o))) {
    Utf8AtBoundary => true
    Utf8ExpectFirst { low: _, high: _, remaining_after: _ } => false
    Utf8ExpectContinuation { remaining: _ } => false
    Utf8Malformed => false
  }
}

fn utf8_decode_bytes(payload: Bytes) -> String {
  from_code_point(pure_dag_seam_unreachable())
}

type Base64Variant = Standard | UrlSafe

fn base64_alphabet(variant: Base64Variant) -> String {
  match variant {
    Standard => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    UrlSafe => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  }
}

fn base64_octet_int(b: UInt8) -> Int {
  b + 0
}

fn base64_sextet_char(alphabet: String, n: Int, divisor: Int) -> String {
  char_at(alphabet, (n / divisor) % 64)
}

// INDEXED, NOT ACCUMULATED. Each output quad is a pure function of the three octets at one index, read
// with get over a list padded by two zeros, and the quads are joined once. The fold this replaces
// appended every quad to a growing string, so its cost was quadratic in the input: a 17 KB payload
// took about half a second and a 140 KB one scaled past a minute. Short final groups take "=" for the
// sextets that consumed only padding zeros, exactly as base64_encode_flush did.
fn base64_encode(octets: List<UInt8>, variant: Base64Variant) -> String {
  let alphabet = base64_alphabet(variant: variant)
  let ints = map(octets, o => base64_octet_int(b: o))
  let n = count(ints)
  let padded = concat(ints, [0, 0])
  join(map(filter(map(enumerate(ints), p => p.first), i => i % 3 == 0), i => {
    let v = get(padded, i) * 65536 + get(padded, i + 1) * 256 + get(padded, i + 2)
    concat(
      base64_sextet_char(alphabet: alphabet, n: v, divisor: 262144),
      base64_sextet_char(alphabet: alphabet, n: v, divisor: 4096),
      if i + 1 < n { base64_sextet_char(alphabet: alphabet, n: v, divisor: 64) } else { "=" },
      if i + 2 < n { char_at(alphabet, v % 64) } else { "=" }
    )
  }), "")
}

fn base64_code_point_value(cp: Int, variant: Base64Variant) -> Int? {
  if cp >= 65 && cp <= 90 {
    Present { value: cp - 65 }
  } else if cp >= 97 && cp <= 122 {
    Present { value: cp - 71 }
  } else if cp >= 48 && cp <= 57 {
    Present { value: cp + 4 }
  } else {
    match variant {
      Standard =>
        if cp == 43 { Present { value: 62 } }
        else if cp == 47 { Present { value: 63 } }
        else { none }
      UrlSafe =>
        if cp == 45 { Present { value: 62 } }
        else if cp == 95 { Present { value: 63 } }
        else { none }
    }
  }
}

fn base64_char_value(c: String, variant: Base64Variant) -> Int? {
  base64_code_point_value(cp: code_point(c), variant: variant)
}

// LINEAR IN THE TEXT, AND NEITHER A RECURSION NOR A GROWING ACCUMULATOR. The previous form called
// itself once per input character, so its depth was the length of the text: a workflow file of about
// 75 KB - a real one, read from a public repository on 2026-09-13 - produced more than 100,000 base64
// characters and the interpreter refused the whole run at its call-depth bound. The first repair, a
// fold pushing each value onto its state, removed the depth but copied the accumulated list on every
// step and took about ten seconds for 23,000 characters. So the text is split once at the padding,
// every body code point is mapped to its value in one pass, and the result is admitted only if every
// value exists and everything after the first "=" is padding - the same acceptance as before.
fn base64_collect_code_points(s: String, variant: Base64Variant) -> List<Int>? {
  let parts = split(s: s, delimiter: "=")
  let body = match parts |> first {
    Present { value: b } => b
    Absent => ""
  }
  let padding_only = all(parts |> skip(n: 1), p => p == "")
  let values = map(chars(s: body), cp => base64_code_point_value(cp: cp, variant: variant))
  if !padding_only || any(values, v => match v { Absent => true  Present { value: _ } => false }) {
    none
  } else {
    Present { value: map(values, v => match v { Present { value: x } => x  Absent => 0 }) }
  }
}

fn base64_octet_of_int(n: Int) -> UInt8 {
  n
}

// INDEXED, NOT ACCUMULATED, for the reason base64_encode states. Values are grouped four at a time by
// index; a final group of one value carries no whole octet and refuses, as base64_decode_flush did, and
// groups of two or three yield one or two octets.
fn base64_decode_values(vals: List<Int>) -> List<UInt8>? {
  let n = count(vals)
  if n % 4 == 1 {
    none
  } else {
    let padded = concat(vals, [0, 0, 0])
    Present { value: flat_map(filter(map(enumerate(vals), p => p.first), i => i % 4 == 0), i => {
      let v = get(padded, i) * 262144 + get(padded, i + 1) * 4096 + get(padded, i + 2) * 64 + get(padded, i + 3)
      let remaining = n - i
      if remaining >= 4 {
        [base64_octet_of_int(n: (v / 65536) % 256), base64_octet_of_int(n: (v / 256) % 256), base64_octet_of_int(n: v % 256)]
      } else if remaining == 3 {
        [base64_octet_of_int(n: (v / 65536) % 256), base64_octet_of_int(n: (v / 256) % 256)]
      } else {
        [base64_octet_of_int(n: (v / 65536) % 256)]
      }
    }) }
  }
}

fn base64_decode(s: String, variant: Base64Variant) -> List<UInt8>? {
  match base64_collect_code_points(s: s, variant: variant) {
    Absent => none
    Present { value: vals } =>
      match base64_decode_values(vals: vals) {
        Absent => none
        Present { value: octets } => Present { value: octets }
      }
  }
}

data utf8_decode_bytes_host_realization_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.bytes",
    decl_name: "builtin_function_registry",
    field: WholeDeclaration
  }
}

data base64_group_fill_carrier_debt_marker: Disposition = Terminal {
  reason: "Base64EncodeBuf = EncEmpty|EncOne|EncTwo and Base64DecodeBuf = DecEmpty|DecOne|DecTwo|DecThree: the hand-rolled Int count accumulator debt is paid; closed sums are declared and all arms are covered by execution in base64_rfc4648_witness_test.dag"
}
