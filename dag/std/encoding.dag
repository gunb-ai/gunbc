module std.encoding

import std.algebra { BoundedLattice }
import std.types { Bytes }
import std.integer { UInt8 }
import std.bytes { pure_dag_seam_unreachable }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type Encoding
  = ASCII
  | UTF8
  | Latin1
  | Text
  | Binary
  | Unknown

fn encoding_rank(e: Encoding) -> Int {
  match e {
    ASCII => 0
    UTF8 => 1
    Latin1 => 1
    Text => 2
    Binary => 2
    Unknown => 3
  }
}

fn is_text_encoding(e: Encoding) -> Bool {
  match e {
    ASCII => true
    UTF8 => true
    Latin1 => true
    Text => true
    Binary => false
    Unknown => false
  }
}

fn encoding_lattice_meet(a: Encoding, b: Encoding) -> Encoding {
  match a {
    Unknown => b
    ASCII => ASCII
    Binary => match b {
      Binary => Binary
      Unknown => Binary
      _ => ASCII
    }
    UTF8 => match b {
      Unknown => UTF8
      Text => UTF8
      UTF8 => UTF8
      _ => ASCII
    }
    Latin1 => match b {
      Unknown => Latin1
      Text => Latin1
      Latin1 => Latin1
      _ => ASCII
    }
    Text => match b {
      Unknown => Text
      Text => Text
      UTF8 => UTF8
      Latin1 => Latin1
      ASCII => ASCII
      Binary => ASCII
    }
  }
}

fn encoding_lattice_join(a: Encoding, b: Encoding) -> Encoding {
  match a {
    ASCII => b
    Unknown => Unknown
    Binary => match b {
      Binary => Binary
      ASCII => Binary
      Unknown => Unknown
      _ => Unknown
    }
    UTF8 => match b {
      ASCII => UTF8
      UTF8 => UTF8
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Latin1 => match b {
      ASCII => Latin1
      Latin1 => Latin1
      UTF8 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Text => match b {
      ASCII => Text
      UTF8 => Text
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
  }
}

data encoding_bounded_lattice: BoundedLattice<Encoding> = {
  meet: encoding_lattice_meet
  join: encoding_lattice_join
  top: Unknown
  bottom: ASCII
}

fn utf8_decode_bytes(payload: Bytes) -> String {
  from_code_point(pure_dag_seam_unreachable())
}

type Base64Variant = Standard | UrlSafe

fn base64_alphabet(variant: Base64Variant) -> String {
  match variant {
    Standard => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    UrlSafe => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  }
}

type Base64EncodeBuf
  = EncEmpty
  | EncOne { b0: Int }
  | EncTwo { b0: Int, b1: Int }

type Base64EncodeState {
  out: String
  buf: Base64EncodeBuf
}

fn base64_octet_int(b: UInt8) -> Int {
  b + 0
}

fn base64_sextet_char(alphabet: String, n: Int, divisor: Int) -> String {
  char_at(alphabet, (n / divisor) % 64)
}

fn base64_encode_step(st: Base64EncodeState, octet: Int, alphabet: String) -> Base64EncodeState {
  match st.buf {
    EncEmpty => Base64EncodeState { out: st.out, buf: EncOne { b0: octet } }
    EncOne { b0: x } => Base64EncodeState { out: st.out, buf: EncTwo { b0: x, b1: octet } }
    EncTwo { b0: x, b1: y } => {
      let n = x * 65536 + y * 256 + octet
      let quad = concat(
        base64_sextet_char(alphabet: alphabet, n: n, divisor: 262144),
        base64_sextet_char(alphabet: alphabet, n: n, divisor: 4096),
        base64_sextet_char(alphabet: alphabet, n: n, divisor: 64),
        char_at(alphabet, n % 64)
      )
      Base64EncodeState { out: concat(st.out, quad), buf: EncEmpty }
    }
  }
}

fn base64_encode_flush(st: Base64EncodeState, alphabet: String) -> String {
  match st.buf {
    EncEmpty => st.out
    EncOne { b0: x } => {
      let n = x * 65536
      concat(
        st.out,
        base64_sextet_char(alphabet: alphabet, n: n, divisor: 262144),
        base64_sextet_char(alphabet: alphabet, n: n, divisor: 4096),
        "=="
      )
    }
    EncTwo { b0: x, b1: y } => {
      let n = x * 65536 + y * 256
      concat(
        st.out,
        base64_sextet_char(alphabet: alphabet, n: n, divisor: 262144),
        base64_sextet_char(alphabet: alphabet, n: n, divisor: 4096),
        base64_sextet_char(alphabet: alphabet, n: n, divisor: 64),
        "="
      )
    }
  }
}

fn base64_encode(octets: List<UInt8>, variant: Base64Variant) -> String {
  let alphabet = base64_alphabet(variant: variant)
  let st = fold(octets,
    init: Base64EncodeState { out: "", buf: EncEmpty },
    f: (acc, octet) => base64_encode_step(st: acc, octet: base64_octet_int(b: octet), alphabet: alphabet)
  )
  base64_encode_flush(st: st, alphabet: alphabet)
}

fn base64_char_value(c: String, variant: Base64Variant) -> Int? {
  let cp = code_point(c)
  if cp >= 65 && cp <= 90 {
    Present { value: cp - 65 }
  } else if cp >= 97 && cp <= 122 {
    Present { value: cp - 71 }
  } else if cp >= 48 && cp <= 57 {
    Present { value: cp + 4 }
  } else {
    match variant {
      Standard =>
        if cp == 43 { Present { value: 62 } }
        else if cp == 47 { Present { value: 63 } }
        else { none }
      UrlSafe =>
        if cp == 45 { Present { value: 62 } }
        else if cp == 95 { Present { value: 63 } }
        else { none }
    }
  }
}

fn base64_collect_values(s: String, i: Int, len: Int, variant: Base64Variant, seen_pad: Bool, acc: List<Int>) -> List<Int>? {
  if i >= len {
    Present { value: acc }
  } else {
    let c = char_at(s, i)
    if c == "=" {
      base64_collect_values(s: s, i: i + 1, len: len, variant: variant, seen_pad: true, acc: acc)
    } else if seen_pad {
      none
    } else {
      match base64_char_value(c: c, variant: variant) {
        Absent => none
        Present { value: v } =>
          base64_collect_values(s: s, i: i + 1, len: len, variant: variant, seen_pad: false, acc: acc |> list_push(v))
      }
    }
  }
}

type Base64DecodeBuf
  = DecEmpty
  | DecOne { v0: Int }
  | DecTwo { v0: Int, v1: Int }
  | DecThree { v0: Int, v1: Int, v2: Int }

type Base64DecodeState {
  out: List<Int>
  buf: Base64DecodeBuf
}

fn base64_decode_step(st: Base64DecodeState, v: Int) -> Base64DecodeState {
  match st.buf {
    DecEmpty => Base64DecodeState { out: st.out, buf: DecOne { v0: v } }
    DecOne { v0: a } => Base64DecodeState { out: st.out, buf: DecTwo { v0: a, v1: v } }
    DecTwo { v0: a, v1: b } => Base64DecodeState { out: st.out, buf: DecThree { v0: a, v1: b, v2: v } }
    DecThree { v0: a, v1: b, v2: c } => {
      let n = a * 262144 + b * 4096 + c * 64 + v
      let byte0 = (n / 65536) % 256
      let byte1 = (n / 256) % 256
      let byte2 = n % 256
      Base64DecodeState {
        out: st.out |> list_push(byte0) |> list_push(byte1) |> list_push(byte2),
        buf: DecEmpty
      }
    }
  }
}

fn base64_decode_flush(st: Base64DecodeState) -> List<Int>? {
  match st.buf {
    DecEmpty => Present { value: st.out }
    DecOne { v0: _ } => none
    DecTwo { v0: a, v1: b } => {
      let n = a * 262144 + b * 4096
      Present { value: st.out |> list_push((n / 65536) % 256) }
    }
    DecThree { v0: a, v1: b, v2: c } => {
      let n = a * 262144 + b * 4096 + c * 64
      Present { value: st.out |> list_push((n / 65536) % 256) |> list_push((n / 256) % 256) }
    }
  }
}

fn base64_octet_of_int(n: Int) -> UInt8 {
  n
}

fn base64_decode_values(vals: List<Int>) -> List<UInt8>? {
  let st = fold(vals,
    init: Base64DecodeState { out: [], buf: DecEmpty },
    f: (acc, v) => base64_decode_step(st: acc, v: v)
  )
  match base64_decode_flush(st: st) {
    Absent => none
    Present { value: octets } => Present { value: octets |> map(n => base64_octet_of_int(n: n)) }
  }
}

fn base64_decode(s: String, variant: Base64Variant) -> List<UInt8>? {
  match base64_collect_values(s: s, i: 0, len: string_length(s), variant: variant, seen_pad: false, acc: []) {
    Absent => none
    Present { value: vals } =>
      match base64_decode_values(vals: vals) {
        Absent => none
        Present { value: octets } => Present { value: octets }
      }
  }
}

// THE FALLIBLE, PURE UTF-8 DECODER, beside utf8_decode_bytes and for a different question:
// utf8_decode_bytes is a total host seam and so cannot refuse, while a consumer reading attacker
// input (first: gunbc.auth.approval_device_wire decode_path_segment) must tell "no text was decoded"
// apart from "text". Pure .dag, so it answers the same on every realization.
// UTF-8 per RFC 3629, from octets; a malformed sequence is Absent, never a replacement character.
// Each completed scalar is checked against its sequence length, so overlong forms (a value encodable
// in fewer bytes), UTF-16 surrogates (U+D800..U+DFFF) and values above U+10FFFF are malformed here --
// no valid identity was decoded -- rather than reaching the canonical check as an alternate spelling.
// THE DECODER'S STATE IS A CLOSED SUM, as base64's Base64EncodeBuf is beside it: each arm carries
// exactly what it owns, so "refused but still waiting" or a length no lead byte produces cannot be
// written. Pending arms name how many continuation bytes remain; the sequence length they carry is
// only the lengths possible at that point (three remaining can only be a four-byte sequence).
type Utf8SequenceLength = Utf8TwoByte | Utf8ThreeByte | Utf8FourByte

type Utf8DecodeState
  = Utf8Ready { out: List<Int> }
  | Utf8NeedOne { out: List<Int>, length: Utf8SequenceLength, acc: Int }
  | Utf8NeedTwo { out: List<Int>, length: Utf8SequenceLength, acc: Int }
  | Utf8NeedThree { out: List<Int>, acc: Int }
  | Utf8Refused

fn utf8_scalar_admissible(cp: Int, length: Utf8SequenceLength) -> Bool {
  match length {
    Utf8TwoByte => cp >= 128
    Utf8ThreeByte => cp >= 2048 && !(cp >= 55296 && cp <= 57343)
    Utf8FourByte => cp >= 65536 && cp <= 1114111
  }
}

fn utf8_is_continuation(o: Int) -> Bool {
  o >= 128 && o < 192
}

fn utf8_step(d: Utf8DecodeState, o: Int) -> Utf8DecodeState {
  match d {
    Utf8Refused => Utf8Refused
    Utf8Ready { out: out } =>
      if o < 128 { Utf8Ready { out: concat(out, [o]) } }
      else if o >= 194 && o < 224 { Utf8NeedOne { out: out, length: Utf8TwoByte, acc: o - 192 } }
      else if o >= 224 && o < 240 { Utf8NeedTwo { out: out, length: Utf8ThreeByte, acc: o - 224 } }
      else if o >= 240 && o < 245 { Utf8NeedThree { out: out, acc: o - 240 } }
      else { Utf8Refused }
    Utf8NeedThree { out: out, acc: acc } =>
      if utf8_is_continuation(o: o) { Utf8NeedTwo { out: out, length: Utf8FourByte, acc: acc * 64 + (o - 128) } } else { Utf8Refused }
    Utf8NeedTwo { out: out, length: len, acc: acc } =>
      if utf8_is_continuation(o: o) { Utf8NeedOne { out: out, length: len, acc: acc * 64 + (o - 128) } } else { Utf8Refused }
    Utf8NeedOne { out: out, length: len, acc: acc } =>
      if !utf8_is_continuation(o: o) { Utf8Refused }
      else {
        let cp = acc * 64 + (o - 128)
        if utf8_scalar_admissible(cp: cp, length: len) { Utf8Ready { out: concat(out, [cp]) } } else { Utf8Refused }
      }
  }
}

fn utf8_decode_octets(octets: List<UInt8>) -> List<Int>? {
  match fold(octets, init: Utf8Ready { out: [] }, f: (d, octet) => utf8_step(d: d, o: base64_octet_int(b: octet))) {
    Utf8Ready { out: out } => Present { value: out }
    _ => none
  }
}

data utf8_decode_bytes_host_realization_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.bytes",
    decl_name: "builtin_function_registry",
    field: WholeDeclaration
  }
}

data base64_group_fill_carrier_debt_marker: Disposition = Terminal {
  reason: "Base64EncodeBuf = EncEmpty|EncOne|EncTwo and Base64DecodeBuf = DecEmpty|DecOne|DecTwo|DecThree: the hand-rolled Int count accumulator debt is paid; closed sums are declared and all arms are covered by execution in base64_rfc4648_witness_test.dag"
}
