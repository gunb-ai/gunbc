module std.encoding

import std.algebra { BoundedLattice }
import std.types { Bytes }
import std.integer { UInt8 }
import std.machine_word { Word, Width8, Width32, WordResult, WordReady, WordRefused, OctetsResult, OctetsReady, OctetsRefused, Octet, OctetResult, OctetReady, OctetRefused, octet_of_int, octet_value, word_of_int, word_from_octets, word_to_octets, word_shift_left, word_shift_right, word_and, word_or, octet_int_values, octets_of_ints }
import extdeps.toolchain.architecture_profile { BigEndian }
import std.bytes { pure_dag_seam_unreachable, pure_dag_seam_unreachable_string }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

type Encoding
  = ASCII
  | UTF8
  | Latin1
  | Text
  | Binary
  | Unknown

fn encoding_rank(e: Encoding) -> Int {
  match e {
    ASCII => 0
    UTF8 => 1
    Latin1 => 1
    Text => 2
    Binary => 2
    Unknown => 3
  }
}

fn is_text_encoding(e: Encoding) -> Bool {
  match e {
    ASCII => true
    UTF8 => true
    Latin1 => true
    Text => true
    Binary => false
    Unknown => false
  }
}

fn encoding_lattice_meet(a: Encoding, b: Encoding) -> Encoding {
  match a {
    Unknown => b
    ASCII => ASCII
    Binary => match b {
      Binary => Binary
      Unknown => Binary
      _ => ASCII
    }
    UTF8 => match b {
      Unknown => UTF8
      Text => UTF8
      UTF8 => UTF8
      _ => ASCII
    }
    Latin1 => match b {
      Unknown => Latin1
      Text => Latin1
      Latin1 => Latin1
      _ => ASCII
    }
    Text => match b {
      Unknown => Text
      Text => Text
      UTF8 => UTF8
      Latin1 => Latin1
      ASCII => ASCII
      Binary => ASCII
    }
  }
}

fn encoding_lattice_join(a: Encoding, b: Encoding) -> Encoding {
  match a {
    ASCII => b
    Unknown => Unknown
    Binary => match b {
      Binary => Binary
      ASCII => Binary
      Unknown => Unknown
      _ => Unknown
    }
    UTF8 => match b {
      ASCII => UTF8
      UTF8 => UTF8
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Latin1 => match b {
      ASCII => Latin1
      Latin1 => Latin1
      UTF8 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Text => match b {
      ASCII => Text
      UTF8 => Text
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
  }
}

data encoding_bounded_lattice: BoundedLattice<Encoding> = {
  meet: encoding_lattice_meet
  join: encoding_lattice_join
  top: Unknown
  bottom: ASCII
}

fn utf8_decode_bytes(payload: Bytes) -> String {
  from_code_point(pure_dag_seam_unreachable())
}

type Base64Variant = Standard | UrlSafe

fn base64_alphabet(variant: Base64Variant) -> String {
  match variant {
    Standard => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    UrlSafe => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  }
}

type Base64EncodeBuf
  = EncEmpty
  | EncOne { b0: Octet }
  | EncTwo { b0: Octet, b1: Octet }

type Base64EncodeState {
  out: String
  buf: Base64EncodeBuf
}

// BASE64 IS A BIT PACKING, AND UNTIL NOW IT SAID SO IN LITERALS. Three octets become one 24-bit
// group and four six-bit fields; the previous form spelled that as x * 65536 + y * 256 + octet and
// (n / 262144) % 64, where 65536 is a byte shift, 262144 is a sextet shift and 64 is a six-bit
// mask. Those are shifts and masks written as decimal magic numbers, which is width and place as
// PROSE -- nothing in the corpus could tell that 4096 was a shift rather than a quantity, no
// refusal existed for an octet outside the byte range, and the crossings in and out of UInt8 were
// `b + 0` and `n`, two identity functions asserting a width they never checked. std.machine_word
// now carries the width as a fact the value holds, so this file states the packing and the
// substrate states the arithmetic. THE ENCODING MODEL IS UNCHANGED -- alphabet, grouping, padding
// and variant behaviour are exactly as before, byte for byte; only the arithmetic moved, and the
// refusal channel appears because an out-of-range octet previously produced a wrong answer rather
// than an error. std.encoding's Base64 authority is ENCODING-0's (gunbc#11629) to grow; this change
// is NUMERIC-BIT-0 (gunbc#11627) substituting the bit arithmetic underneath it.

// THE GROUP IS ASSEMBLED IN OCTETS AND ONLY ITS RESULT IS A WORD. The previous form converted each
// octet to a Width8 Word first and packed Words, which meant three conversions that could refuse
// and a leading zero Word minted separately. With Octet as the member type the packing takes the
// members directly, so the only refusal left is the one word_from_octets raises about the WIDTH --
// and the conversions, along with their unreachable arms, are gone rather than handled.
fn base64_group_word(octets: List<Octet>) -> WordResult {
  word_from_octets(width: Width32, octets: octets, endianness: BigEndian)
}

// THE ONE PLACE AN OCTET IS MADE, AND THEREFORE THE ONE PLACE IT IS REFUSED.
//
// base64_encode previously returned String? so that an out-of-range octet could refuse at the
// ENCODER. That was a widening, and a widening is defeated at every caller: main's
// gunbc.auth.approval_device_wire joined the Optional straight into a URL path and rendered
// "id-Present \{ value: ... \}" into a route identity, with nothing in the type system objecting.
// One unhandled arm undid the whole channel.
//
// An out-of-range octet is a CONSTRUCTION failure, not an encoding failure, so it belongs here.
// base64_octets admits a List<UInt8> into the qualified carrier once; past this point an octet
// cannot be out of range BY TYPE, so base64_encode is total again and every caller stops carrying
// an arm that cannot occur for it. This is the same move std.machine_word makes with Octet, applied
// at the boundary where raw values enter.
fn base64_octets(values: List<UInt8>) -> OctetsResult {
  octets_of_ints(octets: [], remaining: values |> map(v => v + 0))
}

fn base64_sextet_mask() -> WordResult {
  word_of_int(width: Width32, value: 63)
}

// The group is a 32-bit word whose top octet is zero, because 24 is not a machine width this
// substrate realizes and inventing a Width24 for one caller would be a width authority minted for
// a convenience. The leading zero octet is the packing's own statement that the group occupies the
// low three octets, and every field offset below is measured from that.
fn base64_zero_octet() -> OctetResult {
  octet_of_int(value: 0)
}

fn base64_sextet_at(group: Word, offset: Int) -> Int? {
  match word_shift_right(a: group, amount: offset) {
    WordRefused { cause: _ } => none
    WordReady { word: shifted } =>
      match base64_sextet_mask() {
        WordRefused { cause: _ } => none
        WordReady { word: mask } =>
          match word_and(a: shifted, b: mask) {
            WordRefused { cause: _ } => none
            WordReady { word: field } => Present { value: field.value }
          }
      }
  }
}

fn base64_sextet_char_at(alphabet: String, group: Word, offset: Int) -> String? {
  match base64_sextet_at(group: group, offset: offset) {
    Absent => none
    Present { value: n } => Present { value: char_at(alphabet, n) }
  }
}

fn base64_group_of_octets(x: Octet, y: Octet, z: Octet) -> WordResult {
  match base64_zero_octet() {
    OctetRefused { cause: c } => WordRefused { cause: c }
    OctetReady { octet: zero } => base64_group_word(octets: [zero, x, y, z])
  }
}

fn base64_quad(alphabet: String, group: Word) -> String? {
  match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 18) {
    Absent => none
    Present { value: c0 } =>
      match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 12) {
        Absent => none
        Present { value: c1 } =>
          match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 6) {
            Absent => none
            Present { value: c2 } =>
              match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 0) {
                Absent => none
                Present { value: c3 } => Present { value: concat(c0, c1, c2, c3) }
              }
          }
      }
  }
}

fn base64_encode_step(st: Base64EncodeState, octet: Octet, alphabet: String) -> Base64EncodeState? {
  match st.buf {
    EncEmpty => Present { value: Base64EncodeState { out: st.out, buf: EncOne { b0: octet } } }
    EncOne { b0: x } => Present { value: Base64EncodeState { out: st.out, buf: EncTwo { b0: x, b1: octet } } }
    EncTwo { b0: x, b1: y } =>
      match base64_group_of_octets(x: x, y: y, z: octet) {
        WordRefused { cause: _ } => none
        WordReady { word: group } =>
          match base64_quad(alphabet: alphabet, group: group) {
            Absent => none
            Present { value: quad } => Present { value: Base64EncodeState { out: concat(st.out, quad), buf: EncEmpty } }
          }
      }
  }
}

fn base64_encode_step_optional(st: Base64EncodeState?, octet: Octet, alphabet: String) -> Base64EncodeState? {
  match st {
    Absent => none
    Present { value: s } => base64_encode_step(st: s, octet: octet, alphabet: alphabet)
  }
}

fn base64_encode_flush(st: Base64EncodeState, alphabet: String) -> String? {
  match st.buf {
    EncEmpty => Present { value: st.out }
    EncOne { b0: x } =>
      match base64_zero_octet() {
        OctetRefused { cause: _ } => none
        OctetReady { octet: zero } =>
          match base64_group_of_octets(x: x, y: zero, z: zero) {
            WordRefused { cause: _ } => none
            WordReady { word: group } =>
              match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 18) {
                Absent => none
                Present { value: c0 } =>
                  match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 12) {
                    Absent => none
                    Present { value: c1 } => Present { value: concat(st.out, c0, c1, "==") }
                  }
              }
          }
      }
    EncTwo { b0: x, b1: y } =>
      match base64_zero_octet() {
        OctetRefused { cause: _ } => none
        OctetReady { octet: zero } =>
          match base64_group_of_octets(x: x, y: y, z: zero) {
            WordRefused { cause: _ } => none
            WordReady { word: group } =>
              match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 18) {
                Absent => none
                Present { value: c0 } =>
                  match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 12) {
                    Absent => none
                    Present { value: c1 } =>
                      match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 6) {
                        Absent => none
                        Present { value: c2 } => Present { value: concat(st.out, c0, c1, c2, "=") }
                      }
                  }
              }
          }
      }
  }
}

fn base64_encode_optional(octets: List<Octet>, variant: Base64Variant) -> String? {
  let alphabet = base64_alphabet(variant: variant)
  let st = fold(octets,
    init: Present { value: Base64EncodeState { out: "", buf: EncEmpty } },
    f: (acc, octet) => base64_encode_step_optional(st: acc, octet: octet, alphabet: alphabet)
  )
  match st {
    Absent => none
    Present { value: s } => base64_encode_flush(st: s, alphabet: alphabet)
  }
}

// THE DIVERGENCE IS NAMED, BECAUSE AN ABORT THAT IDENTIFIES NOTHING IS NOT A LOCATED FAILURE.
//
// std.bytes' seam is a bare 1 / 0. Diverging through it directly would abort with a generic
// divide-by-zero naming neither the carrier that was forged nor the operation that was running --
// loud, but anonymous. .dag has no throw-with-message, so the only thing that carries identity at
// an abort is the FUNCTION NAME on the stack. This wrapper exists to put both facts there: the
// operation (base64 encode) and the cause (a forged qualified octet). It has one caller and no
// other reason to exist.
fn base64_encode_forged_qualified_octet_diverges() -> String {
  pure_dag_seam_unreachable_string()
}

// TOTAL FOR EVERY OCTET THE SANCTIONED CONSTRUCTOR PRODUCES.
//
// Every member produced by base64_octets is an established Width8 octet, so no shift, mask or
// packing can refuse for any input this module can construct, and the encoder needs no refusal
// channel. The one way to reach the arm below is to forge the carrier; that possibility, its rung
// and its trigger are stated ONCE at their home -- std.machine_word's Octet annotation -- and are
// not restated here, because a fact with two statements is a fact that can disagree with itself,
// which is what two earlier cuts of this annotation did: the first claimed the arm unreachable
// outright, the second claimed forgery was the only route while the carrier in use at the time
// (QualifiedWord) admitted a SANCTIONED Width16 value that reached it.
//
// Returning "" instead would be a fabricated plausible output: "" is the legitimate encoding of the
// empty input, so it would stand where a failure happened and be indistinguishable from success.
fn base64_encode(octets: List<Octet>, variant: Base64Variant) -> String {
  match base64_encode_optional(octets: octets, variant: variant) {
    Present { value: encoded } => encoded
    Absent => base64_encode_forged_qualified_octet_diverges()
  }
}

fn base64_char_value(c: String, variant: Base64Variant) -> Int? {
  let cp = code_point(c)
  if cp >= 65 && cp <= 90 {
    Present { value: cp - 65 }
  } else if cp >= 97 && cp <= 122 {
    Present { value: cp - 71 }
  } else if cp >= 48 && cp <= 57 {
    Present { value: cp + 4 }
  } else {
    match variant {
      Standard =>
        if cp == 43 { Present { value: 62 } }
        else if cp == 47 { Present { value: 63 } }
        else { none }
      UrlSafe =>
        if cp == 45 { Present { value: 62 } }
        else if cp == 95 { Present { value: 63 } }
        else { none }
    }
  }
}

fn base64_collect_values(s: String, i: Int, len: Int, variant: Base64Variant, seen_pad: Bool, acc: List<Int>) -> List<Int>? {
  if i >= len {
    Present { value: acc }
  } else {
    let c = char_at(s, i)
    if c == "=" {
      base64_collect_values(s: s, i: i + 1, len: len, variant: variant, seen_pad: true, acc: acc)
    } else if seen_pad {
      none
    } else {
      match base64_char_value(c: c, variant: variant) {
        Absent => none
        Present { value: v } =>
          base64_collect_values(s: s, i: i + 1, len: len, variant: variant, seen_pad: false, acc: acc |> list_push(v))
      }
    }
  }
}

type Base64DecodeBuf
  = DecEmpty
  | DecOne { v0: Int }
  | DecTwo { v0: Int, v1: Int }
  | DecThree { v0: Int, v1: Int, v2: Int }

type Base64DecodeState {
  out: List<Int>
  buf: Base64DecodeBuf
}

// The decode direction is the same packing read backwards: four six-bit fields are placed into one
// 32-bit group and the group's low three octets ARE the answer, so word_to_octets replaces the
// previous (n / 65536) % 256 ladder outright. The leading octet is dropped rather than masked away
// because it is the zero octet base64_group_of_octets put there.
fn base64_group_of_sextets(a: Int, b: Int, c: Int, v: Int) -> WordResult {
  match base64_place_sextet(value: a, offset: 18) {
    WordRefused { cause: cause } => WordRefused { cause: cause }
    WordReady { word: wa } =>
      match base64_place_sextet(value: b, offset: 12) {
        WordRefused { cause: cause } => WordRefused { cause: cause }
        WordReady { word: wb } =>
          match base64_place_sextet(value: c, offset: 6) {
            WordRefused { cause: cause } => WordRefused { cause: cause }
            WordReady { word: wc } =>
              match base64_place_sextet(value: v, offset: 0) {
                WordRefused { cause: cause } => WordRefused { cause: cause }
                WordReady { word: wv } => base64_or_all(a: wa, b: wb, c: wc, d: wv)
              }
          }
      }
  }
}

fn base64_place_sextet(value: Int, offset: Int) -> WordResult {
  match word_of_int(width: Width32, value: value) {
    WordRefused { cause: cause } => WordRefused { cause: cause }
    WordReady { word: w } => word_shift_left(a: w, amount: offset)
  }
}

fn base64_or_all(a: Word, b: Word, c: Word, d: Word) -> WordResult {
  match word_or(a: a, b: b) {
    WordRefused { cause: cause } => WordRefused { cause: cause }
    WordReady { word: ab } =>
      match word_or(a: ab, b: c) {
        WordRefused { cause: cause } => WordRefused { cause: cause }
        WordReady { word: abc } => word_or(a: abc, b: d)
      }
  }
}

fn base64_group_octet_values(group: Word) -> List<Int>? {
  match word_to_octets(a: group, endianness: BigEndian) {
    OctetsRefused { cause: _ } => none
    OctetsReady { octets: octets } => Present { value: octet_int_values(octets: octets.skip(n: 1)) }
  }
}

fn base64_decode_step(st: Base64DecodeState, v: Int) -> Base64DecodeState? {
  match st.buf {
    DecEmpty => Present { value: Base64DecodeState { out: st.out, buf: DecOne { v0: v } } }
    DecOne { v0: a } => Present { value: Base64DecodeState { out: st.out, buf: DecTwo { v0: a, v1: v } } }
    DecTwo { v0: a, v1: b } => Present { value: Base64DecodeState { out: st.out, buf: DecThree { v0: a, v1: b, v2: v } } }
    DecThree { v0: a, v1: b, v2: c } =>
      match base64_group_of_sextets(a: a, b: b, c: c, v: v) {
        WordRefused { cause: _ } => none
        WordReady { word: group } =>
          match base64_group_octet_values(group: group) {
            Absent => none
            Present { value: octets } => Present { value: Base64DecodeState { out: concat(st.out, octets), buf: DecEmpty } }
          }
      }
  }
}

fn base64_decode_step_optional(st: Base64DecodeState?, v: Int) -> Base64DecodeState? {
  match st {
    Absent => none
    Present { value: s } => base64_decode_step(st: s, v: v)
  }
}

fn base64_decode_flush(st: Base64DecodeState) -> List<Int>? {
  match st.buf {
    DecEmpty => Present { value: st.out }
    DecOne { v0: _ } => none
    DecTwo { v0: a, v1: b } =>
      match base64_group_of_sextets(a: a, b: b, c: 0, v: 0) {
        WordRefused { cause: _ } => none
        WordReady { word: group } =>
          match base64_group_octet_values(group: group) {
            Absent => none
            Present { value: octets } => Present { value: concat(st.out, octets.take(n: 1)) }
          }
      }
    DecThree { v0: a, v1: b, v2: c } =>
      match base64_group_of_sextets(a: a, b: b, c: c, v: 0) {
        WordRefused { cause: _ } => none
        WordReady { word: group } =>
          match base64_group_octet_values(group: group) {
            Absent => none
            Present { value: octets } => Present { value: concat(st.out, octets.take(n: 2)) }
          }
      }
  }
}

// The crossing back to UInt8 was `fn base64_octet_of_int(n: Int) -> UInt8 { n }` -- an identity
// function whose whole content was an assertion about width that it never checked, so a value
// outside the byte range became a "UInt8" by being named one. It is deleted: every value here came
// out of word_to_octets as a Width8 word, so the range is established by the operation that
// produced it rather than re-asserted by a cast.
fn base64_decode_values(vals: List<Int>) -> List<UInt8>? {
  let st = fold(vals,
    init: Present { value: Base64DecodeState { out: [], buf: DecEmpty } },
    f: (acc, v) => base64_decode_step_optional(st: acc, v: v)
  )
  match st {
    Absent => none
    Present { value: s } => base64_decode_flush(st: s)
  }
}

fn base64_decode(s: String, variant: Base64Variant) -> List<UInt8>? {
  match base64_collect_values(s: s, i: 0, len: string_length(s), variant: variant, seen_pad: false, acc: []) {
    Absent => none
    Present { value: vals } =>
      match base64_decode_values(vals: vals) {
        Absent => none
        Present { value: octets } => Present { value: octets }
      }
  }
}

// THE FALLIBLE, PURE UTF-8 DECODER, beside utf8_decode_bytes and for a different question:
// utf8_decode_bytes is a total host seam and so cannot refuse, while a consumer reading attacker
// input (first: gunbc.auth.approval_device_wire decode_path_segment) must tell "no text was decoded"
// apart from "text". Pure .dag, so it answers the same on every realization.
// UTF-8 per RFC 3629, from octets; a malformed sequence is Absent, never a replacement character.
// Each completed scalar is checked against its sequence length, so overlong forms (a value encodable
// in fewer bytes), UTF-16 surrogates (U+D800..U+DFFF) and values above U+10FFFF are malformed here --
// no valid identity was decoded -- rather than reaching the canonical check as an alternate spelling.
// THE DECODER'S STATE IS A CLOSED SUM, as base64's Base64EncodeBuf is beside it: each arm carries
// exactly what it owns, so "refused but still waiting" or a length no lead byte produces cannot be
// written. Pending arms name how many continuation bytes remain; the sequence length they carry is
// only the lengths possible at that point (three remaining can only be a four-byte sequence).
type Utf8SequenceLength = Utf8TwoByte | Utf8ThreeByte | Utf8FourByte

// Two continuations remain only in a three- or four-byte sequence, so that arm's length cannot be
// two bytes.
type Utf8TwoRemainingLength = Utf8ThreeOfThree | Utf8FourOfFour

fn utf8_two_remaining_length(l: Utf8TwoRemainingLength) -> Utf8SequenceLength {
  match l {
    Utf8ThreeOfThree => Utf8ThreeByte
    Utf8FourOfFour => Utf8FourByte
  }
}

type Utf8DecodeState
  = Utf8Ready { out: List<Int> }
  | Utf8NeedOne { out: List<Int>, length: Utf8SequenceLength, acc: Int }
  | Utf8NeedTwo { out: List<Int>, length: Utf8TwoRemainingLength, acc: Int }
  | Utf8NeedThree { out: List<Int>, acc: Int }
  | Utf8Refused

fn utf8_scalar_admissible(cp: Int, length: Utf8SequenceLength) -> Bool {
  match length {
    Utf8TwoByte => cp >= 128
    Utf8ThreeByte => cp >= 2048 && !(cp >= 55296 && cp <= 57343)
    Utf8FourByte => cp >= 65536 && cp <= 1114111
  }
}

fn utf8_is_continuation(o: Int) -> Bool {
  o >= 128 && o < 192
}

fn utf8_step(d: Utf8DecodeState, o: Int) -> Utf8DecodeState {
  match d {
    Utf8Refused => Utf8Refused
    Utf8Ready { out: out } =>
      if o < 128 { Utf8Ready { out: concat(out, [o]) } }
      else if o >= 194 && o < 224 { Utf8NeedOne { out: out, length: Utf8TwoByte, acc: o - 192 } }
      else if o >= 224 && o < 240 { Utf8NeedTwo { out: out, length: Utf8ThreeOfThree, acc: o - 224 } }
      else if o >= 240 && o < 245 { Utf8NeedThree { out: out, acc: o - 240 } }
      else { Utf8Refused }
    Utf8NeedThree { out: out, acc: acc } =>
      if utf8_is_continuation(o: o) { Utf8NeedTwo { out: out, length: Utf8FourOfFour, acc: acc * 64 + (o - 128) } } else { Utf8Refused }
    Utf8NeedTwo { out: out, length: len, acc: acc } =>
      if utf8_is_continuation(o: o) { Utf8NeedOne { out: out, length: utf8_two_remaining_length(l: len), acc: acc * 64 + (o - 128) } } else { Utf8Refused }
    Utf8NeedOne { out: out, length: len, acc: acc } =>
      if !utf8_is_continuation(o: o) { Utf8Refused }
      else {
        let cp = acc * 64 + (o - 128)
        if utf8_scalar_admissible(cp: cp, length: len) { Utf8Ready { out: concat(out, [cp]) } } else { Utf8Refused }
      }
  }
}

// THE OCTET IS ADMITTED, NOT ASSERTED. This fold read each member through base64_octet_int, the
// `b + 0` identity whose whole content was a width claim it never checked -- NUMERIC-BIT-0
// (gunbc#11627) deleted it, and this consumer arrived on main from gunbc#11660 while that cut was
// in review, so the two are correct separately and refuse together. A semantic conflict, not a
// textual one: nothing overlaps in the diff and the merge is clean.
//
// The replacement admits the member through word_of_int at Width8, so a value outside the byte
// range REFUSES instead of being renamed. It admits ONE member rather than going through
// base64_octets, which admits a whole list: this fold already visits members one at a time and
// already has a per-member refusal state to land on. Utf8Refused is the honest destination for that -- a decoder handed something that
// is not an octet has not been handed UTF-8 -- and it is the state this fold already uses for every
// other malformed input, so no new refusal vocabulary is minted for a case the model already had a
// word for.
fn utf8_admit_octet(d: Utf8DecodeState, b: UInt8) -> Utf8DecodeState {
  match word_of_int(width: Width8, value: b + 0) {
    WordRefused { cause: _ } => Utf8Refused
    WordReady { word: w } => utf8_step(d: d, o: w.value)
  }
}

fn utf8_decode_octets(octets: List<UInt8>) -> List<Int>? {
  match fold(octets, init: Utf8Ready { out: [] }, f: (d, octet) => utf8_admit_octet(d: d, b: octet)) {
    Utf8Ready { out: out } => Present { value: out }
    _ => none
  }
}

data utf8_decode_bytes_host_realization_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.bytes",
    decl_name: "builtin_function_registry",
    field: WholeDeclaration
  }
}

