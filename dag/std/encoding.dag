module std.encoding

import std.algebra { BoundedLattice, FreeMonoid, Empty, list_snoc_item }
import std.coercion { unicode_scalar_fold }
import std.types { Bytes, Char }
import std.integer { UInt8Result, UInt8Ready, UInt8OutOfRange, uint8_of_int, QualifiedOctets, QualifiedOctetsResult, QualifiedOctetsReady, QualifiedOctetsRefused, uint8_octets_of_ints, qualified_octet_members }
import std.machine_word { Word, Width8, Width32, WordResult, WordReady, WordRefused, WordValueOutOfRange, OctetsResult, OctetsReady, OctetsRefused, word_of_int, word_from_octets, word_to_octets, word_shift_left, word_shift_right, word_and, word_or }
import extdeps.toolchain.architecture_profile { BigEndian }
import std.bytes { pure_dag_seam_unreachable_string }
import std.disposition { Disposition, Scaffold, Terminal, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.unicode.types { unicode_scalar, unicode_scalar_utf8_octet_count }

type Encoding
  = ASCII
  | UTF8
  | Latin1
  | Text
  | Binary
  | Unknown

fn encoding_rank(e: Encoding) -> Int {
  match e {
    ASCII => 0
    UTF8 => 1
    Latin1 => 1
    Text => 2
    Binary => 2
    Unknown => 3
  }
}

fn is_text_encoding(e: Encoding) -> Bool {
  match e {
    ASCII => true
    UTF8 => true
    Latin1 => true
    Text => true
    Binary => false
    Unknown => false
  }
}

fn encoding_lattice_meet(a: Encoding, b: Encoding) -> Encoding {
  match a {
    Unknown => b
    ASCII => ASCII
    Binary => match b {
      Binary => Binary
      Unknown => Binary
      ASCII => ASCII
      UTF8 => ASCII
      Latin1 => ASCII
      Text => ASCII
    }
    UTF8 => match b {
      Unknown => UTF8
      Text => UTF8
      UTF8 => UTF8
      ASCII => ASCII
      Latin1 => ASCII
      Binary => ASCII
    }
    Latin1 => match b {
      Unknown => Latin1
      Text => Latin1
      Latin1 => Latin1
      ASCII => ASCII
      UTF8 => ASCII
      Binary => ASCII
    }
    Text => match b {
      Unknown => Text
      Text => Text
      UTF8 => UTF8
      Latin1 => Latin1
      ASCII => ASCII
      Binary => ASCII
    }
  }
}

fn encoding_lattice_join(a: Encoding, b: Encoding) -> Encoding {
  match a {
    ASCII => b
    Unknown => Unknown
    Binary => match b {
      Binary => Binary
      ASCII => Binary
      Unknown => Unknown
      UTF8 => Unknown
      Latin1 => Unknown
      Text => Unknown
    }
    UTF8 => match b {
      ASCII => UTF8
      UTF8 => UTF8
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Latin1 => match b {
      ASCII => Latin1
      Latin1 => Latin1
      UTF8 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
    Text => match b {
      ASCII => Text
      UTF8 => Text
      Latin1 => Text
      Text => Text
      Unknown => Unknown
      Binary => Unknown
    }
  }
}

data encoding_bounded_lattice: BoundedLattice<Encoding> = {
  meet: encoding_lattice_meet
  join: encoding_lattice_join
  top: Unknown
  bottom: ASCII
}

fn utf8_decode_bytes(payload: Bytes) -> String {
  pure_dag_seam_unreachable_string()
}

type Base64Variant = Standard | UrlSafe

fn base64_alphabet(variant: Base64Variant) -> String {
  match variant {
    Standard => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    UrlSafe => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
  }
}

type Base64EncodeBuf
  = EncEmpty
  | EncOne { b0: Int }
  | EncTwo { b0: Int, b1: Int }

type Base64EncodeState {
  out: String
  buf: Base64EncodeBuf
}

// BASE64 IS A BIT PACKING, AND UNTIL NOW IT SAID SO IN LITERALS. Three octets become one 24-bit
// group and four six-bit fields; the previous form spelled that as x * 65536 + y * 256 + octet and
// (n / 262144) % 64, where 65536 is a byte shift, 262144 is a sextet shift and 64 is a six-bit
// mask. Those are shifts and masks written as decimal magic numbers, which is width and place as
// PROSE -- nothing in the corpus could tell that 4096 was a shift rather than a quantity, no
// refusal existed for an octet outside the byte range, and the crossings in and out of UInt8 were
// `b + 0` and `n`, two identity functions asserting a width they never checked. std.machine_word
// now carries the width as a fact the value holds, so this file states the packing and the
// substrate states the arithmetic. THE ENCODING MODEL IS UNCHANGED -- alphabet, grouping, padding
// and variant behaviour are exactly as before, byte for byte; only the arithmetic moved, and the
// refusal channel appears because an out-of-range octet previously produced a wrong answer rather
// than an error. std.encoding's Base64 authority is ENCODING-0's (gunbc#11629) to grow; this change
// is NUMERIC-BIT-0 (gunbc#11627) substituting the bit arithmetic underneath it.

// THE GROUP IS ASSEMBLED IN OCTETS AND ONLY ITS RESULT IS A WORD. The previous form converted each
// octet to a Width8 Word first and packed Words, which meant three conversions that could refuse
// and a leading zero Word minted separately. With UInt8 as the member type the packing takes the
// members directly, so the only refusal left is the one word_from_octets raises about the WIDTH --
// and the conversions, along with their unreachable arms, are gone rather than handled.
fn base64_group_word(octets: QualifiedOctets) -> WordResult {
  word_from_octets(width: Width32, octets: octets, endianness: BigEndian)
}

// THE ONE PLACE AN OCTET IS MADE, AND THEREFORE THE ONE PLACE IT IS REFUSED.
//
// base64_encode previously returned String? so that an out-of-range octet could refuse at the
// ENCODER. That was a widening, and a widening is defeated at every caller: main's
// gunbc.auth.approval_device_wire joined the Optional straight into a URL path and rendered
// "id-Present \{ value: ... \}" into a route identity, with nothing in the type system objecting.
// One unhandled arm undid the whole channel.
//
// An out-of-range octet is a CONSTRUCTION failure, not an encoding failure, so it belongs here.
//
// THE PREVIOUS CUT OF THIS FUNCTION TOOK List<UInt8> AND THAT MADE IT DECORATIVE. UInt8 is a phantom
// transparent to Int, so `base64_octets([256, 0, 0])` type-checked, and a caller could skip this
// function entirely and hand [256, 0, 0] straight to base64_encode -- which answered "AAAA", a
// fabricated plausible output for input it had never admitted. The admission was beside the route,
// not on it. It now takes raw List<Int> and returns the SEALED QualifiedOctets, so this is the only
// way to obtain a value base64_encode will accept, and "past this point an octet cannot be out of
// range" is carried by the type rather than asserted by this annotation.
fn base64_octets(values: List<Int>) -> QualifiedOctetsResult {
  uint8_octets_of_ints(values: values)
}

fn base64_sextet_mask() -> WordResult {
  word_of_int(width: Width32, value: 63)
}

// The group is a 32-bit word whose top octet is zero, because 24 is not a machine width this
// substrate realizes and inventing a Width24 for one caller would be a width authority minted for
// a convenience. The leading zero octet is the packing's own statement that the group occupies the
// low three octets, and every field offset below is measured from that.
fn base64_zero_octet() -> UInt8Result {
  uint8_of_int(value: 0)
}

fn base64_sextet_at(group: Word, offset: Int) -> Int? {
  match word_shift_right(a: group, amount: offset) {
    WordRefused { cause: _ } => none
    WordReady { word: shifted } =>
      match base64_sextet_mask() {
        WordRefused { cause: _ } => none
        WordReady { word: mask } =>
          match word_and(a: shifted, b: mask) {
            WordRefused { cause: _ } => none
            WordReady { word: field } => Present { value: field.value }
          }
      }
  }
}

fn base64_sextet_char_at(alphabet: String, group: Word, offset: Int) -> String? {
  match base64_sextet_at(group: group, offset: offset) {
    Absent => none
    Present { value: n } => Present { value: char_at(alphabet, n) }
  }
}

// BOTH PATHS CARRY `Int` (2026-09-24). `UInt8` is `Compose<UInt, MachineWidth<8>>`, a `Phantom`
// with no inhabitant, so a `UInt8`-typed parameter named a width nothing carried or checked. The
// encode side was retyped first (fed by `qualified_octet_members`, whose sealed carrier says `Int`).
// The decode side -- `base64_decode_values`, `base64_decode`, `utf8_admit_octet`,
// `utf8_decode_octets` -- was left spelled `UInt8` as a separate producer whose retype was to be
// decided when a retained closure first emitted it. That closure is the App Attest native program,
// not on main when this was written (gunbc.recurring_failure_mode
// bounded_natural_arithmetic_evaluated_as_unbounded_int records where it was observed), and the
// decision is `List<Int>`: every
// decoded value leaves word_to_octets as a Width8 word, so its range is established by the operation
// that produced it and the element type states what it holds (gunbc.recurring_failure_mode
// bounded_natural_arithmetic_evaluated_as_unbounded_int, receipt of that date). Consumers that still
// spell `UInt8` downstream (extdeps.npm, extdeps.mercurial's octetNN fields and others) remain that
// row's open members; retyping this producer moves no mismatch onto them in the interpreter, and each
// meets its own emission when a closure reaches it.
fn base64_group_of_octets(x: Int, y: Int, z: Int) -> WordResult {
  match uint8_octets_of_ints(values: [0, x, y, z]) {
    QualifiedOctetsRefused { observed: o } => WordRefused { cause: WordValueOutOfRange { width: Width8, value: o } }
    QualifiedOctetsReady { value: q } => base64_group_word(octets: q)
  }
}

fn base64_quad(alphabet: String, group: Word) -> String? {
  match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 18) {
    Absent => none
    Present { value: c0 } =>
      match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 12) {
        Absent => none
        Present { value: c1 } =>
          match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 6) {
            Absent => none
            Present { value: c2 } =>
              match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 0) {
                Absent => none
                Present { value: c3 } => Present { value: concat(c0, c1, c2, c3) }
              }
          }
      }
  }
}

fn base64_encode_step(st: Base64EncodeState, octet: Int, alphabet: String) -> Base64EncodeState? {
  match st.buf {
    EncEmpty => Present { value: Base64EncodeState { out: st.out, buf: EncOne { b0: octet } } }
    EncOne { b0: x } => Present { value: Base64EncodeState { out: st.out, buf: EncTwo { b0: x, b1: octet } } }
    EncTwo { b0: x, b1: y } =>
      match base64_group_of_octets(x: x, y: y, z: octet) {
        WordRefused { cause: _ } => none
        WordReady { word: group } =>
          match base64_quad(alphabet: alphabet, group: group) {
            Absent => none
            Present { value: quad } => Present { value: Base64EncodeState { out: concat(st.out, quad), buf: EncEmpty } }
          }
      }
  }
}

fn base64_encode_step_optional(st: Base64EncodeState?, octet: Int, alphabet: String) -> Base64EncodeState? {
  match st {
    Absent => none
    Present { value: s } => base64_encode_step(st: s, octet: octet, alphabet: alphabet)
  }
}

// THE PADDING AFTER A FINAL GROUP OF N SEXTETS, the one statement of it: the encoder emits exactly
// this, and base64_decode_canonical admits exactly this, so a consumer that needs one spelling per
// value reads it from here rather than restating the encoder's table.
fn base64_padding_after(values_in_final_group: Int) -> String {
  if values_in_final_group == 2 { "==" } else if values_in_final_group == 3 { "=" } else { "" }
}

fn base64_encode_flush(st: Base64EncodeState, alphabet: String) -> String? {
  match st.buf {
    EncEmpty => Present { value: st.out }
    EncOne { b0: x } =>
      match base64_zero_octet() {
        UInt8OutOfRange { observed: _ } => none
        UInt8Ready { value: zero } =>
          match base64_group_of_octets(x: x, y: zero, z: zero) {
            WordRefused { cause: _ } => none
            WordReady { word: group } =>
              match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 18) {
                Absent => none
                Present { value: c0 } =>
                  match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 12) {
                    Absent => none
                    Present { value: c1 } => Present { value: concat(st.out, c0, c1, base64_padding_after(values_in_final_group: 2)) }
                  }
              }
          }
      }
    EncTwo { b0: x, b1: y } =>
      match base64_zero_octet() {
        UInt8OutOfRange { observed: _ } => none
        UInt8Ready { value: zero } =>
          match base64_group_of_octets(x: x, y: y, z: zero) {
            WordRefused { cause: _ } => none
            WordReady { word: group } =>
              match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 18) {
                Absent => none
                Present { value: c0 } =>
                  match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 12) {
                    Absent => none
                    Present { value: c1 } =>
                      match base64_sextet_char_at(alphabet: alphabet, group: group, offset: 6) {
                        Absent => none
                        Present { value: c2 } => Present { value: concat(st.out, c0, c1, c2, base64_padding_after(values_in_final_group: 3)) }
                      }
                  }
              }
          }
      }
  }
}

fn base64_encode_optional(octets: QualifiedOctets, variant: Base64Variant) -> String? {
  let alphabet = base64_alphabet(variant: variant)
  let st = fold(qualified_octet_members(q: octets),
    init: Present { value: Base64EncodeState { out: "", buf: EncEmpty } },
    f: (acc, octet) => base64_encode_step_optional(st: acc, octet: octet, alphabet: alphabet)
  )
  match st {
    Absent => none
    Present { value: s } => base64_encode_flush(st: s, alphabet: alphabet)
  }
}

// THE FORGED-OCTET DIVERGENCE IS DELETED, AND WHAT REPLACES IT IS NARROWER ON PURPOSE.
//
// The arm that stood here was named for a forged qualified octet, and with QualifiedOctets sealed
// that cause no longer has an input: the only route to the parameter is std.integer's admission
// fold, so an unadmitted member cannot reach this function at all. Keeping the old name would have
// left a function asserting a cause that can no longer occur -- the annotation rot DESIGN section 4c
// forbids, in the one place a reader would most trust it.
//
// WHAT REMAINS IS NOT THE SAME FACT AND IS NOT CLAIMED TO BE ZERO. The internal chain still threads
// Optional because the word operations it uses are total functions returning typed results --
// shift, mask, and the Width32 packing each have a refusal arm. For members this carrier admits,
// none of those arms has a reachable input: the values are in [0, 255], the shifts are 18/12/6/0
// against a Width32 word, and the packing is exactly four members. So the residual is a PACKING
// INVARIANT of this module, not a statement about the caller's data, and the name says so. Diverging
// through std.bytes' bare seam directly would abort with a generic divide-by-zero naming neither the
// operation nor the invariant; .dag has no throw-with-message, so the function name on the stack is
// the only thing that carries identity at an abort.
//
// Returning "" instead would be a fabricated plausible output: "" is the legitimate encoding of the
// empty input, so it would stand where a failure happened and be indistinguishable from success.
fn base64_encode_packing_invariant_diverges() -> String {
  pure_dag_seam_unreachable_string()
}

// TOTAL, AND THIS TIME THE SIGNATURE IS WHAT MAKES IT SO.
//
// The parameter is the sealed carrier, so every member reached it through std.integer's admission
// fold and is in [0, 255] BY TYPE. There is no caller-supplied input to this function for which the
// arm below has a reachable cause; the residual is this module's own packing invariant, named at the
// divergence rather than restated here.
fn base64_encode(octets: QualifiedOctets, variant: Base64Variant) -> String {
  match base64_encode_optional(octets: octets, variant: variant) {
    Present { value: encoded } => encoded
    Absent => base64_encode_packing_invariant_diverges()
  }
}

fn base64_char_value(c: String, variant: Base64Variant) -> Int? {
  let cp = code_point(c)
  if cp >= 65 && cp <= 90 {
    Present { value: cp - 65 }
  } else if cp >= 97 && cp <= 122 {
    Present { value: cp - 71 }
  } else if cp >= 48 && cp <= 57 {
    Present { value: cp + 4 }
  } else {
    match variant {
      Standard =>
        if cp == 43 { Present { value: 62 } }
        else if cp == 47 { Present { value: 63 } }
        else { none }
      UrlSafe =>
        if cp == 45 { Present { value: 62 } }
        else if cp == 95 { Present { value: 63 } }
        else { none }
    }
  }
}

fn base64_collect_values(s: String, i: Int, len: Int, variant: Base64Variant, seen_pad: Bool, acc: List<Int>) -> List<Int>? {
  if i >= len {
    Present { value: acc }
  } else {
    let c = char_at(s, i)
    if c == "=" {
      base64_collect_values(s: s, i: i + 1, len: len, variant: variant, seen_pad: true, acc: acc)
    } else if seen_pad {
      none
    } else {
      match base64_char_value(c: c, variant: variant) {
        Absent => none
        Present { value: v } =>
          base64_collect_values(s: s, i: i + 1, len: len, variant: variant, seen_pad: false, acc: acc |> list_push(v))
      }
    }
  }
}

type Base64DecodeBuf
  = DecEmpty
  | DecOne { v0: Int }
  | DecTwo { v0: Int, v1: Int }
  | DecThree { v0: Int, v1: Int, v2: Int }

type Base64DecodeState {
  out: List<Int>
  buf: Base64DecodeBuf
}

// The decode direction is the same packing read backwards: four six-bit fields are placed into one
// 32-bit group and the group's low three octets ARE the answer, so word_to_octets replaces the
// previous (n / 65536) % 256 ladder outright. The leading octet is dropped rather than masked away
// because it is the zero octet base64_group_of_octets put there.
// THE FOUR SEXTETS OCCUPY DISJOINT BIT RANGES (18, 12, 6, 0; each below 2^6, as base64_char_value
// produces them), so their OR is their weighted sum and the group is ONE word_of_int. The earlier
// placement built four words and folded three word_or over all 32 bit places per group -- the
// dominant per-character cost of every base64 decode (~860 eval steps per character, measured
// 2026-10-01) for an answer a single range-checked construction states.
fn base64_group_of_sextets(a: Int, b: Int, c: Int, v: Int) -> WordResult {
  word_of_int(width: Width32, value: a * 262144 + b * 4096 + c * 64 + v)
}

fn base64_group_octet_values(group: Word) -> List<Int>? {
  match word_to_octets(a: group, endianness: BigEndian) {
    OctetsRefused { cause: _ } => none
    OctetsReady { octets: octets } => Present { value: qualified_octet_members(q: octets).skip(n: 1) }
  }
}

fn base64_decode_step(st: Base64DecodeState, v: Int) -> Base64DecodeState? {
  match st.buf {
    DecEmpty => Present { value: Base64DecodeState { out: st.out, buf: DecOne { v0: v } } }
    DecOne { v0: a } => Present { value: Base64DecodeState { out: st.out, buf: DecTwo { v0: a, v1: v } } }
    DecTwo { v0: a, v1: b } => Present { value: Base64DecodeState { out: st.out, buf: DecThree { v0: a, v1: b, v2: v } } }
    DecThree { v0: a, v1: b, v2: c } =>
      match base64_group_of_sextets(a: a, b: b, c: c, v: v) {
        WordRefused { cause: _ } => none
        WordReady { word: group } =>
          match base64_group_octet_values(group: group) {
            Absent => none
            Present { value: octets } => Present { value: Base64DecodeState { out: concat(st.out, octets), buf: DecEmpty } }
          }
      }
  }
}

fn base64_decode_step_optional(st: Base64DecodeState?, v: Int) -> Base64DecodeState? {
  match st {
    Absent => none
    Present { value: s } => base64_decode_step(st: s, v: v)
  }
}

// CANONICAL DECODING (RFC 4648 §3.5): a final partial group carries pad bits -- the low 4 bits of the
// second sextet when one octet remains, the low 2 bits of the third when two do -- which a conforming
// encoder sets to zero. They are discarded, so a decoder that ignores them admits several spellings of
// one octet string ("Zg==" and "Zh==" both read as "f"), and every consumer that needs one spelling
// per value has to re-encode to find out which it was handed (gunbc.auth.approval_capability
// capability_tag_hex does, until d0_store_operation_wall PR 4 deletes that re-encode on top of this).
// Non-zero pad bits are therefore refused here, once, for every consumer: the spelling is canonical by
// construction rather than by a second encoding.
fn base64_decode_flush(st: Base64DecodeState) -> List<Int>? {
  match st.buf {
    DecEmpty => Present { value: st.out }
    DecOne { v0: _ } => none
    DecTwo { v0: a, v1: b } =>
      if b % 16 != 0 { none } else { base64_decode_final_octets(out: st.out, a: a, b: b, c: 0, keep: 1) }
    DecThree { v0: a, v1: b, v2: c } =>
      if c % 4 != 0 { none } else { base64_decode_final_octets(out: st.out, a: a, b: b, c: c, keep: 2) }
  }
}

fn base64_decode_final_octets(out: List<Int>, a: Int, b: Int, c: Int, keep: Int) -> List<Int>? {
  match base64_group_of_sextets(a: a, b: b, c: c, v: 0) {
    WordRefused { cause: _ } => none
    WordReady { word: group } =>
      match base64_group_octet_values(group: group) {
        Absent => none
        Present { value: octets } => Present { value: concat(out, octets.take(n: keep)) }
      }
  }
}

// The crossing back to UInt8 was `fn base64_octet_of_int(n: Int) -> UInt8 { n }` -- an identity
// function whose whole content was an assertion about width that it never checked, so a value
// outside the byte range became a "UInt8" by being named one. It is deleted: every value here came
// out of word_to_octets as a Width8 word, so the range is established by the operation that
// produced it rather than re-asserted by a cast.
fn base64_decode_values(vals: List<Int>) -> List<Int>? {
  let st = fold(vals,
    init: Present { value: Base64DecodeState { out: [], buf: DecEmpty } },
    f: (acc, v) => base64_decode_step_optional(st: acc, v: v)
  )
  match st {
    Absent => none
    Present { value: s } => base64_decode_flush(st: s)
  }
}

// CANONICAL DECODING WITH CANONICAL PADDING: the same decode, admitting only the padding
// base64_padding_after says the encoder emits for this many values. base64_decode stays lenient about
// padding for its existing consumers; a consumer that needs exactly one spelling per value (an
// authenticated tag) reads this instead of re-encoding to find out.
fn base64_decode_canonical(s: String, variant: Base64Variant) -> List<Int>? {
  let total = string_length(s)
  let pads = base64_trailing_pad_count(s: s, i: total, n: 0)
  if pads != string_length(base64_padding_after(values_in_final_group: (total - pads) % 4)) { none }
  else { base64_decode(s: s, variant: variant) }
}

fn base64_trailing_pad_count(s: String, i: Int, n: Int) -> Int {
  if i <= 0 { n } else if char_at(s, i - 1) == "=" { base64_trailing_pad_count(s: s, i: i - 1, n: n + 1) } else { n }
}

fn base64_decode(s: String, variant: Base64Variant) -> List<Int>? {
  match base64_collect_values(s: s, i: 0, len: string_length(s), variant: variant, seen_pad: false, acc: []) {
    Absent => none
    Present { value: vals } =>
      match base64_decode_values(vals: vals) {
        Absent => none
        Present { value: octets } => Present { value: octets }
      }
  }
}

// THE FALLIBLE, PURE UTF-8 DECODER, beside utf8_decode_bytes and for a different question:
// utf8_decode_bytes is a total host seam and so cannot refuse, while a consumer reading attacker
// input (first: gunbc.auth.approval_device_wire decode_path_segment) must tell "no text was decoded"
// apart from "text". Pure .dag, so it answers the same on every realization.
// UTF-8 per RFC 3629, from octets; a malformed sequence is Absent, never a replacement character.
// Each completed scalar is checked against its sequence length, so overlong forms (a value encodable
// in fewer bytes), UTF-16 surrogates (U+D800..U+DFFF) and values above U+10FFFF are malformed here --
// no valid identity was decoded -- rather than reaching the canonical check as an alternate spelling.
// THE DECODER'S STATE IS A CLOSED SUM, as base64's Base64EncodeBuf is beside it: each arm carries
// exactly what it owns, so "refused but still waiting" or a length no lead byte produces cannot be
// written. Pending arms name how many continuation bytes remain; the sequence length they carry is
// only the lengths possible at that point (three remaining can only be a four-byte sequence).
type Utf8SequenceLength = Utf8TwoByte | Utf8ThreeByte | Utf8FourByte

// Two continuations remain only in a three- or four-byte sequence, so that arm's length cannot be
// two bytes.
type Utf8TwoRemainingLength = Utf8ThreeOfThree | Utf8FourOfFour

fn utf8_two_remaining_length(l: Utf8TwoRemainingLength) -> Utf8SequenceLength {
  match l {
    Utf8ThreeOfThree => Utf8ThreeByte
    Utf8FourOfFour => Utf8FourByte
  }
}

type Utf8DecodeState
  = Utf8Ready { out: List<Char> }
  | Utf8NeedOne { out: List<Char>, length: Utf8SequenceLength, acc: Int }
  | Utf8NeedTwo { out: List<Char>, length: Utf8TwoRemainingLength, acc: Int }
  | Utf8NeedThree { out: List<Char>, acc: Int }
  | Utf8Refused

fn utf8_sequence_octet_count(length: Utf8SequenceLength) -> Int {
  match length {
    Utf8TwoByte => 2
    Utf8ThreeByte => 3
    Utf8FourByte => 4
  }
}

// Shortest form is decided by the one octet-count table (std.unicode.types
// unicode_scalar_utf8_octet_count), and scalar-ness by unicode_scalar; this function only joins
// them, so the range boundaries are not restated here.
fn utf8_scalar_admissible(cp: Int, length: Utf8SequenceLength) -> Bool {
  unicode_scalar(code_point: cp)
    && unicode_scalar_utf8_octet_count(code_point: cp) == utf8_sequence_octet_count(length: length)
}

fn utf8_is_continuation(o: Int) -> Bool {
  o >= 128 && o < 192
}

fn utf8_step(d: Utf8DecodeState, o: Int) -> Utf8DecodeState {
  match d {
    Utf8Refused => Utf8Refused
    Utf8Ready { out: out } =>
      if o < 128 { Utf8Ready { out: concat(out, [o]) } }
      else if o >= 194 && o < 224 { Utf8NeedOne { out: out, length: Utf8TwoByte, acc: o - 192 } }
      else if o >= 224 && o < 240 { Utf8NeedTwo { out: out, length: Utf8ThreeOfThree, acc: o - 224 } }
      else if o >= 240 && o < 245 { Utf8NeedThree { out: out, acc: o - 240 } }
      else { Utf8Refused }
    Utf8NeedThree { out: out, acc: acc } =>
      if utf8_is_continuation(o: o) { Utf8NeedTwo { out: out, length: Utf8FourOfFour, acc: acc * 64 + (o - 128) } } else { Utf8Refused }
    Utf8NeedTwo { out: out, length: len, acc: acc } =>
      if utf8_is_continuation(o: o) { Utf8NeedOne { out: out, length: utf8_two_remaining_length(l: len), acc: acc * 64 + (o - 128) } } else { Utf8Refused }
    Utf8NeedOne { out: out, length: len, acc: acc } =>
      if !utf8_is_continuation(o: o) { Utf8Refused }
      else {
        let cp = acc * 64 + (o - 128)
        if utf8_scalar_admissible(cp: cp, length: len) { Utf8Ready { out: concat(out, [cp]) } } else { Utf8Refused }
      }
  }
}

// THE OCTET IS ADMITTED, NOT ASSERTED. This fold read each member through base64_octet_int, the
// `b + 0` identity whose whole content was a width claim it never checked -- NUMERIC-BIT-0
// (gunbc#11627) deleted it, and this consumer arrived on main from gunbc#11660 while that cut was
// in review, so the two are correct separately and refuse together. A semantic conflict, not a
// textual one: nothing overlaps in the diff and the merge is clean.
//
// The replacement admits the member through word_of_int at Width8, so a value outside the byte
// range REFUSES instead of being renamed. It admits ONE member rather than going through
// base64_octets, which admits a whole list: this fold already visits members one at a time and
// already has a per-member refusal state to land on. Utf8Refused is the honest destination for that -- a decoder handed something that
// is not an octet has not been handed UTF-8 -- and it is the state this fold already uses for every
// other malformed input, so no new refusal vocabulary is minted for a case the model already had a
// word for.
fn utf8_admit_octet(d: Utf8DecodeState, b: Int) -> Utf8DecodeState {
  match word_of_int(width: Width8, value: b) {
    WordRefused { cause: _ } => Utf8Refused
    WordReady { word: w } => utf8_step(d: d, o: w.value)
  }
}

// THE DECODER YIELDS SCALARS, AND SAYS SO IN ITS TYPE. Every member it appends has passed this
// fold's own admission (an octet below 128, or a completed sequence that passes
// utf8_scalar_admissible), so it is a Unicode scalar, and the result is declared List<Char> rather
// than List<Int>. Returning List<Int> threw that proof away and made every caller spell the
// scalars through a partial Int route whose refusal could not fire. A caller now spells the text
// through the total std.coercion unicode_scalar_fold. THE TYPE STATES THE SHAPE, AND THE ADMISSION
// ABOVE IS THE GUARANTEE: the seed does not enforce Char's `where unicode_scalar` refinement at an
// argument or field, so the Char annotation is not itself a proof.
fn utf8_decode_octets(octets: List<Int>) -> List<Char>? {
  match fold(octets, init: Utf8Ready { out: [] }, f: (d, octet) => utf8_admit_octet(d: d, b: octet)) {
    Utf8Ready { out: out } => Present { value: out }
    Utf8NeedOne { out: _, length: _, acc: _ } => none
    Utf8NeedTwo { out: _, length: _, acc: _ } => none
    Utf8NeedThree { out: _, acc: _ } => none
    Utf8Refused => none
  }
}

data utf8_decode_bytes_host_realization_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.bytes",
    decl_name: "builtin_function_registry",
    field: WholeDeclaration
  }
}

data base64_group_fill_carrier_debt_marker: Disposition = Terminal {
  reason: "Base64EncodeBuf = EncEmpty|EncOne|EncTwo and Base64DecodeBuf = DecEmpty|DecOne|DecTwo|DecThree: the hand-rolled Int count accumulator debt is paid; closed sums are declared and all arms are covered by execution in base64_rfc4648_witness_test.dag"
}

// THE ASCII DECODE: a NAMED, PARTIAL octet -> text conversion plan (DESIGN section 4: a crossing that
// may refuse is never implicit). ASCII is ANSI X3.4-1986 / ISO/IEC 646 IRV: the seven-bit code,
// octets 0x00..0x7F, and Unicode 17.0 Basic Latin (U+0000..U+007F) assigns each of those octets the
// scalar with the same number -- so on its domain the route is exact, lossless and needs no table.
// 0x00 (NUL) IS in the domain: it is an ASCII control. A caller for whom NUL is a delimiter rather
// than content (a git NUL-framed field) refuses it under its own policy, not here.
// Octets 0x80..0xFF are NOT ASCII and are NOT read as Latin-1: this route refuses them, naming the
// first offending position and octet. A byte-to-Latin-1 reading would be a different meaning of
// "the character for this byte" and is not declared, because no current consumer's upstream
// specifies it (gunbc.recurring_failure_mode bare_from_code_point_binds_the_total_seed_builtin,
// kind OCTET-AS-CHAR).
type AsciiDecodeOutcome
  = AsciiDecoded { text: String }
  | AsciiNonAscii { at: Int, octet: Int }

type AsciiDecodeState
  = AsciiDecoding { at: Int, scalars: FreeMonoid<Char> }
  | AsciiDecodeRefused { at: Int, octet: Int }

fn ascii_octet(octet: Int) -> Bool {
  octet >= 0 && octet < 128
}

fn ascii_decode_step(state: AsciiDecodeState, octet: Int) -> AsciiDecodeState {
  match state {
    AsciiDecodeRefused { at, octet: refused } => AsciiDecodeRefused { at: at, octet: refused }
    AsciiDecoding { at, scalars } =>
      if ascii_octet(octet: octet) {
        AsciiDecoding { at: at + 1, scalars: list_snoc_item(xs: scalars, item: octet) }
      } else {
        AsciiDecodeRefused { at: at, octet: octet }
      }
  }
}

fn ascii_decode_octets(octets: List<Int>) -> AsciiDecodeOutcome {
  match fold(octets, init: AsciiDecoding { at: 0, scalars: Empty }, f: (st, o) => ascii_decode_step(state: st, octet: o)) {
    AsciiDecoding { at: _, scalars } => AsciiDecoded { text: unicode_scalar_fold(xs: scalars) }
    AsciiDecodeRefused { at, octet } => AsciiNonAscii { at: at, octet: octet }
  }
}
