module std.unicode.types


data unicode_scalar_max_code_point: Int = 1114111
data unicode_surrogate_first_code_point: Int = 55296
data unicode_surrogate_last_code_point: Int = 57343
data unicode_scalar_authority_note: String = "Unicode Standard 17.0 Core Specification section 3.9, definition D76 (https://www.unicode.org/versions/U0/core-spec/chapter-3/#G7404): scalar values are U+0000..U+D7FF and U+E000..U+10FFFF inclusive. Therefore U+10FFFF is the maximum and the surrogate code points U+D800..U+DFFF are excluded."

fn unicode_scalar(code_point: Int) -> Bool {
  code_point >= 0
    && code_point <= unicode_scalar_max_code_point
    && !(code_point >= unicode_surrogate_first_code_point && code_point <= unicode_surrogate_last_code_point)
}

type CharClass = Whitespace | Digit | IdentStart | IdentContinue

type DisplayWidth = ZeroWidth | Narrow | Wide

fn display_width_columns(w: DisplayWidth) -> Int {
  match w {
    ZeroWidth => 0
    Narrow    => 1
    Wide      => 2
  }
}

type UnicodeBlock {
  name: String
  start: Int
  end_inclusive: Int
  default_width: DisplayWidth
}

fn char_in_class(c: std.types.Char, class: CharClass) -> Bool =
  match class {

    Whitespace =>
      unicode_char_code_point(c: c) == 9 || unicode_char_code_point(c: c) == 10 || unicode_char_code_point(c: c) == 12
      || unicode_char_code_point(c: c) == 13 || unicode_char_code_point(c: c) == 32
    Digit => unicode_char_code_point(c: c) >= 48 && unicode_char_code_point(c: c) <= 57
    IdentStart =>
      unicode_char_code_point(c: c) >= 65 && unicode_char_code_point(c: c) <= 90
      || unicode_char_code_point(c: c) >= 97 && unicode_char_code_point(c: c) <= 122
      || unicode_char_code_point(c: c) == 95

    IdentContinue =>
      unicode_char_code_point(c: c) >= 48 && unicode_char_code_point(c: c) <= 57
      || unicode_char_code_point(c: c) >= 65 && unicode_char_code_point(c: c) <= 90
      || unicode_char_code_point(c: c) >= 97 && unicode_char_code_point(c: c) <= 122
      || unicode_char_code_point(c: c) == 95
  }

fn unicode_char_code_point(c: std.types.Char) -> Int = c + 0

fn in_block(cp: Int, block: UnicodeBlock) -> Bool {
  cp >= block.start && cp <= block.end_inclusive
}
