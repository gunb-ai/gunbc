module std.fabric_storage

import std.types { NonEmptyStr, String, Int, Bool, List }
import std.content_hash { ContentHash, content_hash_of_value, serialize_content_hash, compare_content_hash, ContentHashEqual, ContentHashDifferent, ContentHashCrossFamilyIncomparable, content_hash_from_structural_digest }
import std.durable_compare_and_set { CasGeneration, CasStoreFailure, CasSlotObservationRefused, CasGenerationPublicationRefused, cas_unreadable_slot_detail }

// THE FABRIC DB INTERFACE: IMMUTABLE CONTENT-ADDRESSED OBJECTS AND COMPARE-AND-SET NAMED HEADS.
//
// Two facts the corpus already owns, composed rather than re-coined (DESIGN 3b):
//
//   an object is addressed by its std.content_hash digest, the keying relation std.artifact_store
//   uses; and a named head is one std.durable_compare_and_set slot whose value is an object ref,
//   advanced by that module's generation-carrying compare-and-set and refused in its vocabulary
//   (CasStoreFailure) when the store cannot read or publish.
//
// DIVERGENCE FROM std.artifact_store, STATED: that store is an evicting cache (least-recently-used
// packing to a byte budget). An object here is history a head may reach, so it is never evicted --
// retention is released-never, which store_over_provider deliberately does not realize. The key
// relation is shared; the retention policy is not, and borrowing the cache would make an old event
// silently unreachable, the P0-B hole in a new costume.
//
// THE STORE SEES THE LINKS. An object carries the refs it points at as data the STORE reads, not
// only bytes inside its body. The git realization this replaces kept an event's parent inside the
// event's JSON, where git could not see it, so a ref fetch transferred only the tip and every
// deeper read refused. Here a closure read follows links the store holds, so the whole chain from a
// head is one store-side walk.
//
// Transport is not a fact of this module (DESIGN 3): a file store, an ssh-reached verb and a later
// R2 tier are handlers bound to these shapes. Replication and chunking are not modeled here; the
// program is docs/plans/fabric-storage.md.

// AN OBJECT REF IS MINTED FROM THE BYTES IT NAMES, and from nothing else a caller supplies. The
// unverified content/digest pairing std.durable_compare_and_set declares as a boundary obligation
// ("the obligation belongs to the immutable object store ... it can verify bytes against digest")
// is closed here: fabric_object_ref_of derives the digest, and fabric_object_ref_of_wire parses a
// ref only for a READ, whose fetched bytes are then checked against it (fabric_object_verified).
type FabricObjectRef sole_constructor {
  digest: ContentHash
}

// The object: its links (the refs the store must be able to walk from it) and its body. The body is
// NonEmptyStr, so an empty object has no constructor -- the git realization once published git's
// empty blob as a partition head; that state is unwritable here, not refused.
type FabricObject {
  links: List<FabricObjectRef>
  body: NonEmptyStr
}

// The canonical preimage of an object: every link in order, then the body, each length-prefixed so
// no two distinct objects share a preimage.
fn fabric_object_preimage(object: FabricObject) -> NonEmptyStr {
  let link_words = fold(object.links, init: "", f: (acc, l) => join([acc, "L", fabric_object_ref_wire(object: l) as String, ";"], ""))
  join(["fabric_storage.object;", link_words, "B", to_string(length(object.body as String)), ":", object.body as String], "") as NonEmptyStr
}

fn fabric_object_ref_of(object: FabricObject) -> FabricObjectRef {
  FabricObjectRef { digest: content_hash_of_value(value: fabric_object_preimage(object: object)) }
}

fn fabric_object_ref_wire(object: FabricObjectRef) -> NonEmptyStr {
  serialize_content_hash(hash: object.digest)
}

fn fabric_object_ref_of_wire(wire: String) -> FabricObjectRef? {
  match content_hash_from_structural_digest(digest: wire) {
    Present { value: h } => Present { value: FabricObjectRef { digest: h } }
    Absent => none
  }
}

fn fabric_object_ref_eq(a: FabricObjectRef, b: FabricObjectRef) -> Bool {
  match compare_content_hash(left: a.digest, right: b.digest) {
    ContentHashEqual => true
    ContentHashDifferent => false
    ContentHashCrossFamilyIncomparable => false
  }
}

// A HEAD READING: absent, or at an object and the generation that published it. The generation is
// the compare-and-set's; the ref is the head's value.
type FabricHeadReading
  = FabricHeadAbsent
  | FabricHeadAt { object: FabricObjectRef, generation: CasGeneration }

// WHAT A WRITER EXPECTS, BY VALUE. A writer knows the object it built on, not a slot generation, so
// the store compares the expected object against the head it reads and performs the generation CAS
// itself -- one store-owned operation, so no caller supplies an observation (the key-relation
// obligation of std.durable_compare_and_set closed by the same move durable_cas_file_store makes).
type FabricHeadExpectation
  = ExpectHeadAbsent
  | ExpectHeadAt { object: FabricObjectRef }

fn fabric_head_admits(expected: FabricHeadExpectation, observed: FabricHeadReading) -> Bool {
  match expected {
    ExpectHeadAbsent => match observed { FabricHeadAbsent => true  FabricHeadAt { object: _, generation: _ } => false }
    ExpectHeadAt { object: e } => match observed { FabricHeadAbsent => false  FabricHeadAt { object: o, generation: _ } => fabric_object_ref_eq(a: e, b: o) }
  }
}

// WHY AN OPERATION FAILED, AS TYPED ARMS WITH DIFFERENT OWNERS AND REMEDIES.
//
//   FabricStoreUnreachable   the transport never reached the store (ssh exit 255, a refused
//                            connection). Retry the transport; the store is not implicated.
//   FabricStoreRefused       the store was reached and could not read or publish, in the CAS
//                            vocabulary. Investigate the store.
//   FabricObjectMissing      a ref the operation needed names no object the store holds.
//   FabricObjectCorrupt      the store holds bytes under a ref they do not hash to, or two objects
//                            collide on one digest. Never read through; repair by hand.
//   FabricReplyUndecodable   the store answered and the answer is not this protocol -- a version
//                            skew between handler and store, not a store fault.
//   FabricHeadNameRefused    the head name does not address one head (it would navigate); the
//                            caller's defect, refused before the store is touched.
//
// A lost race is NOT a fault and has no arm here: it is FabricHeadMoved, an outcome carrying both
// sides. The git realization answered both "lost race" and "unreachable" with exit 128.
type FabricStorageFault
  = FabricStoreUnreachable { detail: NonEmptyStr }
  | FabricStoreRefused { cause: CasStoreFailure }
  | FabricObjectMissing { object: FabricObjectRef }
  | FabricObjectCorrupt { object: FabricObjectRef, detail: NonEmptyStr }
  | FabricReplyUndecodable { detail: NonEmptyStr }
  | FabricHeadNameRefused { name: NonEmptyStr }

type FabricPut
  = FabricObjectStored { object: FabricObjectRef }
  | FabricPutRefused { fault: FabricStorageFault }

type FabricObjectGet
  = FabricObjectFetched { stored: FabricStoredObject }
  | FabricObjectGetRefused { fault: FabricStorageFault }

type FabricHeadRead
  = FabricHeadObserved { reading: FabricHeadReading }
  | FabricHeadReadRefused { fault: FabricStorageFault }

// ADVANCING A HEAD. The store refuses to point a head at an object it does not hold
// (FabricObjectMissing), so a head is never published over a hole.
type FabricHeadAdvance
  = FabricHeadAdvanced { object: FabricObjectRef, generation: CasGeneration }
  | FabricHeadMoved { expected: FabricHeadExpectation, observed: FabricHeadReading }
  | FabricHeadAdvanceRefused { fault: FabricStorageFault }

// READING THE CLOSURE OF A HEAD: the head and every object reachable from it along links, newest
// first, bounded. Exhausting the bound refuses rather than truncating.
type FabricStoredObject {
  object: FabricObjectRef
  content: FabricObject
}

type FabricClosureRead
  = FabricClosureRead { reading: FabricHeadReading, newest_first: List<FabricStoredObject> }
  | FabricClosureBudgetExhausted { at: FabricObjectRef, bound: Int }
  | FabricClosureRefused { fault: FabricStorageFault }

// VERIFYING FETCHED BYTES AGAINST THE REF THEY WERE ASKED FOR. The single authority every handler
// routes a fetched object through: a store that answered with other bytes is corrupt, never trusted.
type FabricObjectVerification
  = FabricObjectVerified { stored: FabricStoredObject }
  | FabricObjectVerificationFailed { fault: FabricStorageFault }

fn fabric_object_verified(asked: FabricObjectRef, content: FabricObject) -> FabricObjectVerification {
  let actual = fabric_object_ref_of(object: content)
  if fabric_object_ref_eq(a: asked, b: actual) {
    FabricObjectVerified { stored: FabricStoredObject { object: asked, content: content } }
  } else {
    FabricObjectVerificationFailed {
      fault: FabricObjectCorrupt {
        object: asked,
        detail: join(["held bytes hash to ", fabric_object_ref_wire(object: actual) as String], "") as NonEmptyStr,
      }
    }
  }
}

fn fabric_storage_fault_wire(fault: FabricStorageFault) -> String {
  match fault {
    FabricStoreUnreachable { detail: d } => join(["store unreachable: ", d as String], "")
    FabricStoreRefused { cause: c } => match c {
      CasSlotObservationRefused { cause: u } => join(["store could not read the head: ", cas_unreadable_slot_detail(cause: u)], "")
      CasGenerationPublicationRefused { detail: d } => join(["store refused publication: ", d as String], "")
    }
    FabricObjectMissing { object: o } => join(["object missing: ", fabric_object_ref_wire(object: o) as String], "")
    FabricObjectCorrupt { object: o, detail: d } => join(["object corrupt: ", fabric_object_ref_wire(object: o) as String, " ", d as String], "")
    FabricReplyUndecodable { detail: d } => join(["reply undecodable: ", d as String], "")
    FabricHeadNameRefused { name: n } => join(["head name refused: ", n as String], "")
  }
}

// DECODING THE CANONICAL PREIMAGE: the inverse of fabric_object_preimage, the one byte form an
// object is held and carried in by any realization. The body's declared length delimits it, so a
// preimage is self-delimiting: a stream of them decodes without a separator, and a truncated object
// decodes to nothing rather than to a prefix.
type FabricObjectDecoded {
  object: FabricObject
  rest: String
}

fn fabric_object_decode(preimage: String) -> FabricObject? {
  match fabric_object_decode_next(text: preimage) {
    Absent => none
    Present { value: d } => if d.rest == "" { Present { value: d.object } } else { none }
  }
}

// A STREAM OF PREIMAGES, as a closure reply carries them. Any undecodable member refuses the whole
// stream: a partial list would be a chain with a silent hole.
fn fabric_objects_decode_stream(text: String, acc: List<FabricObject>) -> List<FabricObject>? {
  if text == "" {
    Present { value: acc }
  } else {
    match fabric_object_decode_next(text: text) {
      Absent => none
      Present { value: d } => fabric_objects_decode_stream(text: d.rest, acc: concat(acc, [d.object]))
    }
  }
}

fn fabric_object_decode_next(text: String) -> FabricObjectDecoded? {
  let prefix = "fabric_storage.object;"
  if !starts_with(s: text, prefix: prefix) {
    none
  } else {
    fabric_object_decode_links(rest: substring(s: text, start: length(prefix), end: length(text)), links: [])
  }
}

fn fabric_object_decode_links(rest: String, links: List<FabricObjectRef>) -> FabricObjectDecoded? {
  if starts_with(s: rest, prefix: "L") {
    let tail = substring(s: rest, start: 1, end: length(rest))
    match first(split(tail, separator: ";")) {
      Absent => none
      Present { value: wire } =>
        if length(wire) == length(tail) {
          none
        } else {
          match fabric_object_ref_of_wire(wire: wire) {
            Absent => none
            Present { value: r } => fabric_object_decode_links(rest: substring(s: tail, start: length(wire) + 1, end: length(tail)), links: concat(links, [r]))
          }
        }
    }
  } else {
    if starts_with(s: rest, prefix: "B") {
      let tail = substring(s: rest, start: 1, end: length(rest))
      match first(split(tail, separator: ":")) {
        Absent => none
        Present { value: digits } =>
          match parse_int(s: digits) {
            Absent => none
            Present { value: n } => {
              let body_start = length(digits) + 1
              if n < 1 || length(digits) == length(tail) || body_start + n > length(tail) {
                none
              } else {
                Present { value: FabricObjectDecoded {
                  object: FabricObject { links: links, body: substring(s: tail, start: body_start, end: body_start + n) as NonEmptyStr },
                  rest: substring(s: tail, start: body_start + n, end: length(tail)),
                } }
              }
            }
          }
      }
    } else {
      none
    }
  }
}
