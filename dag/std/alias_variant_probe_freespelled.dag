module std.alias_variant_probe_freespelled

import std.types { Int }
import std.algebra { Cons, Empty, FreeMonoid, AlgebraTypeTemplate }

// DISCRIMINATOR / POSITIVE (coproduct spelling): the identical match on a binder spelled
// with the declared coproduct FreeMonoid<AlgebraTypeTemplate>. FreeMonoid is a generic
// (non-container) alias use, so the variant lookup resolves its Cons/Empty arms directly
// and this compiles both before and after the fix. It proves the variants are valid on the
// coproduct, isolating List-alias-not-peeling as the sole defect in the RED
// (std.alias_variant_probe). If this module also refused, the defect would be in the
// coproduct itself, not in the container-alias peel.
fn is_collection_filter_param_types_freespelled(param_types: FreeMonoid<AlgebraTypeTemplate>) -> Int {
  match param_types {
    Cons { head: _, tail: _ } => 1
    Empty => 0
  }
}
