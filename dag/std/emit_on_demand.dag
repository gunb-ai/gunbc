module std.emit_on_demand

import std.types { ContentHash, String, List, Bool, Int, list_length }
import std.content_hash { content_hash_atom, content_hash_combine }
import std.artifact_store {
  ArtifactKey, artifact_key_hash, ArtifactStore,
  StoreHit, StoreMiss, store_get,
}
import std.realization { Materialization, Share, Recompute }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data emit_on_demand_module_note: String = "Witness-realization kernel (plan P3): the pure-spec authority for emit-on-demand native execution — closure ContentHash -> artifact store lookup -> cold (emit+build+run+put) | warm (run-only, compile skipped). Composes P2 std.artifact_store (ContentKeyed, eviction counted) and std.realization (Share on store hit). Source grain (toolchain: source-artifact) is the emit cache; native grain (toolchain: native-artifact) is the zero-compile warm path. The interpreter's surviving roles are named here with dissolution triggers (P3 ACCEPT (c)). Host transport: extdeps.realization.emit_on_demand_host; spine/realize_pack scheduling: v2.std.emit_on_demand. Serial kernel family: emit_host_add (#6879). Fan-out lane 2 (swift-stag-662): emit_host_field_access + emit_host_complement. Width-5 partition ratified on #6879 comment."

data emit_on_demand_cache_key_authority_note: String = "Cache identity has three derived parts. emit_on_demand_key hashes the authored computation identity ArtifactKey { closure_digest, emitter_identity, target_language, artifact grain }; then the native handler appends artifact_realization_digest over the exact materialized workspace files and build argv, followed by resolved_build_context_identity over the resolved tools, constructed subprocess environment, and Cargo configuration. The inner parts are required because inferred_tree_digest does NOT contain target-model runtime rows or host realization inputs: an emitter/dispatcher, compiler, admitted environment, or Cargo configuration change can preserve the tree while changing native bytes. This was the srv2-05 divergence root cause: key 8f21f541808ddb22 selected a warm pre-change family binary. The effective path now changes for either a subject change (family_crate_member_change_cold_rebuild_holds), a same-tree realization change (family_crate_dispatch_change_cold_rebuild_holds), or a build-context change. Test-id directories remain isolation-only and are not identity."

data emit_on_demand_native_cache_root_note: String = "Single authority for the native-cache scratch prefix (the durable-cache contract): every family cache root = concat(this root, '_<family>'). The prefix is load-bearing three ways: (a) the artifact-store scratch grant admits /tmp/gunbc_-prefixed roots; (b) the cached host transport (v1_interpreter emit_host_run_transport_cached) rebases exactly this /tmp/gunbc_ prefix onto GUNBC_NATIVE_CACHE_ROOT when set (durable re-root: the root is WHERE, never WHAT — the computation, input-realization, and resolved-toolchain content-hash path components stay the key); (c) the falsifier cold control (GUNBC_CI_NATIVE_CACHE_COLD_CONTROL) forces cold rebuilds against whatever root is active, widen-only. Realization row: extdeps.realization.native_artifact_cache."

data emit_on_demand_native_cache_root: String = "/tmp/gunbc_emit_on_demand"

fn emit_on_demand_family_cache_root(family: String) -> String {
  concat(emit_on_demand_native_cache_root, "_", family)
}

data witness_family_build_grain_ruling: String = "Build-grain ruling (operator-directed 2026-07-21, answered by measurement): per-witness native crates cost ~17s of cargo build EACH and lose to the interpreter on wall clock; ONE family-grain crate — every member fn concatenated into one emitted source with an argv-dispatched main — pays the build once, and every member run after the first is compile_skipped. Build at family grain, never per witness. This supersedes witness-realization-plan FLAG B v0 (one binary per entry closure). The family artifact reuses the SAME key authority: emit_on_demand_key over family_closure_digest(member digests) — the family is a different closure input, not a second key scheme. Member LIST ORDER is declared key material (concat order and dispatcher arm order are artifact content); the digest is tag-seeded so a singleton family never collides with its bare member digest. Receipt by execution: emit_on_demand_family_crate_witness_test (one-build-members-warm, unknown-member RED, member-change cold rebuild)."

fn family_closure_digest(members: List<ContentHash>) -> ContentHash {
  fold(
    members,
    init: content_hash_atom(value: "witness-family-closure"),
    f: (acc, member) => content_hash_combine(left: acc, right: member)
  )
}

type ArtifactGrain
  = SourceArtifact
  | NativeArtifact

fn toolchain_for_grain(grain: ArtifactGrain) -> String {
  match grain {
    SourceArtifact => "source-artifact"
    NativeArtifact => "native-artifact"
  }
}

fn emit_on_demand_key(
  closure_digest: ContentHash,
  emitter_identity: String,
  target_language: String,
  grain: ArtifactGrain
) -> ContentHash {
  artifact_key_hash(key: ArtifactKey {
    closure_digest: closure_digest,
    emitter_identity: emitter_identity,
    target_language: target_language,
    toolchain: toolchain_for_grain(grain: grain)
  })
}

type EmitOnDemandCacheReceipt {
  key: ContentHash
  compile_skipped: Bool
}

type EmitOnDemandLookup
  = EmitOnDemandHit { receipt: EmitOnDemandCacheReceipt }
  | EmitOnDemandMiss

fn emit_on_demand_lookup(store: ArtifactStore, key: ContentHash) -> EmitOnDemandLookup {
  match store_get(store: store, key: key) {
    StoreHit { store: _, row: _ } =>
      EmitOnDemandHit {
        receipt: EmitOnDemandCacheReceipt { key: key, compile_skipped: true }
      }
    StoreMiss { store: _ } => EmitOnDemandMiss
  }
}

fn materialization_for_lookup(lookup: EmitOnDemandLookup) -> Materialization {
  match lookup {
    EmitOnDemandHit { receipt: _ } => Share
    EmitOnDemandMiss => Recompute
  }
}

type InterpreterSurvivingRole {
  id: String
  purpose: String
  dissolution_trigger: String
}

type InterpreterWetSurfaceMembership
  = NodeTreeDerived { authority: DeclarationRef }
  | DeclaredFrontier {
      authorities: List<DeclarationRef>,
      reason: String,
      dissolve_on: String
    }

type InterpreterWetSurface {
  id: String
  membership: InterpreterWetSurfaceMembership
}

fn wet_surface_ref(module_path: String, decl_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path,
    decl_name: decl_name,
    field: WholeDeclaration
  }
}

data emitted_effect_family_boundary_authority: DeclarationRef = wet_surface_ref(
  module_path: "v2.std.host_transport",
  decl_name: "EmittedEffectFamily"
)

data emitted_effect_family_boundary_note: String = "Boundary citation, not a shared authority for the five rows: v2.std.host_transport.EmittedEffectFamily is the closed FilesystemReadFamily | ShellExecRunFamily sum for the emitted-native host-effect subset. It does not represent socket acceptance, Filesystem.Write, generic shell/argv transports, or the full probe-bin surface. Each wet surface below therefore cites only its own nearest authorities; this role adds no effect-family variants and does not fork the ts-effects-providers lane."

data interpreter_wet_surface_decl_ref_frontier_note: String = "Every current member is DeclaredFrontier because field-granular declaration-Node enumeration does not yet exist (the std.decl_ref / gunbc#5364 wall-after-grounding). Each row still names the closest .dag authorities plus its own reason and dissolution route; none is silently omitted. A row graduates to NodeTreeDerived when the compile graph can resolve its exact declaration reference. interpreter_surviving_roles is derived from this membership and drops wet-effect-surfaces when the roster reaches zero."

data gunbc_serve_wet_surface: InterpreterWetSurface = InterpreterWetSurface {
  id: "gunbc-serve-accept-loop-and-belt-dispatch",
  membership: DeclaredFrontier {
    authorities: [
      wet_surface_ref(module_path: "gunbc.roadmap_serve", decl_name: "roadmap_serve_handle"),
      wet_surface_ref(module_path: "gunbc.roadmap_belt_actuate", decl_name: "belt_dispatch_node")
    ],
    reason: "the in-process belt dispatch is modeled, but the gunbc serve socket accept-loop remains a seed Rust seam and exact declaration-Node resolution is unavailable",
    dissolve_on: "emit-on-demand materializes the serve closure and its host accept-loop, then the seed handle_serve seam deletes"
  }
}

data main_wet_regen_surface: InterpreterWetSurface = InterpreterWetSurface {
  id: "main-wet-generated-artifact-emission",
  membership: DeclaredFrontier {
    authorities: [
      wet_surface_ref(module_path: "tools.generated_artifact_gate", decl_name: "main_wet")
    ],
    reason: "main_wet is a .dag declaration, but its live Filesystem.Write dispatch still crosses the seed interpreter and exact declaration-Node resolution is unavailable",
    dissolve_on: "generated-artifact emission runs through a v2-emitted per-grant HandlerBinding and the seed main_wet dispatch path deletes"
  }
}

data gunbc_ci_emission_surface: InterpreterWetSurface = InterpreterWetSurface {
  id: "gunbc-ci-emission",
  membership: DeclaredFrontier {
    authorities: [
      wet_surface_ref(module_path: "tools.gunbc_ci", decl_name: "main")
    ],
    reason: "gunbc ci is modeled, but its shell Exec.Run realization still dispatches through the seed interpreter and exact declaration-Node resolution is unavailable",
    dissolve_on: "the typed CI plan runs through the v2-emitted shell handler selected from its covering grant"
  }
}

data pre_push_transport_surface: InterpreterWetSurface = InterpreterWetSurface {
  id: "pre-push-transport",
  membership: DeclaredFrontier {
    authorities: [
      wet_surface_ref(module_path: "gunbc.githooks_pre_push_cli", decl_name: "githooks_pre_push_cli_stage0_receiver_disposition"),
      wet_surface_ref(module_path: "gunbc.githooks_pre_push_plan", decl_name: "pre_push_active_kinds")
    ],
    reason: "the typed pre-push plan is modeled, while its on-demand claim_batch argv/stdin transport remains in seed Rust and exact declaration-Node resolution is unavailable",
    dissolve_on: "the emitted crate partition deletes pre_push.rs and the on-demand seed transport, or a usage census proves the transport has no consumers"
  }
}

data probe_bins_surface: InterpreterWetSurface = InterpreterWetSurface {
  id: "probe-bins",
  membership: DeclaredFrontier {
    authorities: [
      wet_surface_ref(module_path: "gunbc.ci_release_bins", decl_name: "witness_declared_release_bins")
    ],
    reason: "witness_declared_release_bins is the exact production WitnessBin transport-name frontier; the binaries remain seed host transports and exact declaration-Node resolution is unavailable",
    dissolve_on: "probe-bin consumers migrate to v2-emitted execution surfaces and witness_declared_release_bins reaches its host-census-derived form"
  }
}

data interpreter_wet_surfaces: List<InterpreterWetSurface> = [
  gunbc_serve_wet_surface,
  main_wet_regen_surface,
  gunbc_ci_emission_surface,
  pre_push_transport_surface,
  probe_bins_surface
]

data interpreter_base_surviving_roles: List<InterpreterSurvivingRole> = [
  InterpreterSurvivingRole {
    id: "bootstrap-receipts",
    purpose: "S1 parse census and seed-honesty receipts until native artifacts cover the corpus",
    dissolution_trigger: "witness_family_fanout complete + ci_floor_cutover on v2-emitted execution"
  },
  InterpreterSurvivingRole {
    id: "compile-time-eval",
    purpose: "EqualsClaim expected arm and emit-vs-eval oracle during the emit_host transition",
    dissolution_trigger: "emit_on_demand agreement witnesses green for every enrolled family"
  },
  InterpreterSurvivingRole {
    id: "terminal-bootstrap-kernel",
    purpose: "claim_executor host physics (pinned HAND roster — recorded_fixture, resolved_graph_cache)",
    dissolution_trigger: "v1_quarantine — seed crates frozen as bootstrap artifact only"
  }
]

fn interpreter_surviving_roles_from_wet_surfaces(
  wet_surfaces: List<InterpreterWetSurface>
) -> List<InterpreterSurvivingRole> {
  if list_length(items: wet_surfaces) == 0 {
    interpreter_base_surviving_roles
  } else {
    concat(
      interpreter_base_surviving_roles,
      [
        InterpreterSurvivingRole {
          id: "wet-effect-surfaces",
          purpose: "Wet/Record live-effect dispatch for the countable interpreter_wet_surfaces membership",
          dissolution_trigger: "interpreter_wet_surfaces reaches zero after every effect dispatch selects HandlerBinding from covering_grant + ci_floor_cutover on v2-emitted execution"
        }
      ]
    )
  }
}

data interpreter_surviving_roles: List<InterpreterSurvivingRole> = interpreter_surviving_roles_from_wet_surfaces(wet_surfaces: interpreter_wet_surfaces)

data interpreter_surviving_roles_ceiling_note: String = "Policy ceiling (independent of current occupancy): bootstrap headroom for interpreter-surviving roles until witness_family_fanout lands (P3 ACCEPT (c); docs/plans/witness-realization-plan.md). Occupancy is count(interpreter_surviving_roles); wet-effect-surfaces is derived from nonempty interpreter_wet_surfaces membership and dissolves at zero. The ceiling is an upper bound so roster growth is checked against declared headroom, never conflated with a hand count of current entries."

data interpreter_surviving_roles_ceiling: Int = 8

fn interpreter_surviving_roles_occupancy() -> Int {
  list_length(items: interpreter_surviving_roles)
}

fn interpreter_surviving_roles_occupancy_within_ceiling() -> Bool {
  interpreter_surviving_roles_occupancy() <= interpreter_surviving_roles_ceiling
}

fn interpreter_surviving_roles_bounded() -> Bool {
  interpreter_surviving_roles_occupancy() > 0
    && interpreter_surviving_roles_occupancy_within_ceiling()
}
