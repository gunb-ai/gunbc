module std.emit_on_demand

import std.types { ContentHash, String, List, Bool, Int, list_length }
import std.content_hash { content_hash_atom, content_hash_combine }
import std.artifact_store {
  ArtifactKey, artifact_key_hash, ArtifactStore,
  StoreHit, StoreMiss, store_get,
}
import std.realization { Materialization, Share, Recompute }

data emit_on_demand_module_note: String = "Witness-realization kernel (plan P3): the pure-spec authority for emit-on-demand native execution — closure ContentHash -> artifact store lookup -> cold (emit+build+run+put) | warm (run-only, compile skipped). Composes P2 std.artifact_store (ContentKeyed, eviction counted) and std.realization (Share on store hit). Source grain (toolchain: source-artifact) is the emit cache; native grain (toolchain: native-artifact) is the zero-compile warm path. The interpreter's surviving roles are named here with dissolution triggers (P3 ACCEPT (c)). Host transport: extdeps.realization.emit_on_demand_host; spine/realize_pack scheduling: v2.std.emit_on_demand. Serial kernel family: emit_host_add (#6879). Fan-out lane 2 (swift-stag-662): emit_host_field_access + emit_host_complement. Width-5 partition ratified on #6879 comment."

data emit_on_demand_cache_key_authority_note: String = "Cache key purity (§5 cache-impurity): emit_on_demand_key hashes ArtifactKey { closure_digest, emitter_identity, target_language, toolchain } — closure_digest is the content hash of declared inputs (inferred_tree_digest over the witness root + evaluated facts; emitted source + build inputs derive from that tree). Witness test_id subdirectories under /tmp are isolation-only shims; they are NOT key material. A changed subject changes closure_digest -> new key -> new workspace path -> cold rebuild (witness: the one-build receipts, e.g. emit_on_demand_kernel_native_one_build_holds's alt-key cold leg and family_crate_member_change_cold_rebuild_holds)."

data emit_on_demand_native_cache_root_note: String = "Single authority for the native-cache scratch prefix (the durable-cache contract): every family cache root = concat(this root, '_<family>'). The prefix is load-bearing three ways: (a) the artifact-store scratch grant admits /tmp/gunbc_-prefixed roots; (b) the cached host transport (v1_interpreter emit_host_run_transport_cached) rebases exactly this /tmp/gunbc_ prefix onto GUNBC_NATIVE_CACHE_ROOT when set (durable re-root: the root is WHERE, never WHAT — content-hash path components stay the key); (c) the falsifier cold control (GUNBC_CI_NATIVE_CACHE_COLD_CONTROL) forces cold rebuilds against whatever root is active, widen-only. Realization row: extdeps.realization.native_artifact_cache."

data emit_on_demand_native_cache_root: String = "/tmp/gunbc_emit_on_demand"

fn emit_on_demand_family_cache_root(family: String) -> String {
  concat(emit_on_demand_native_cache_root, "_", family)
}

data witness_family_build_grain_ruling: String = "Build-grain ruling (operator-directed 2026-07-21, answered by measurement): per-witness native crates cost ~17s of cargo build EACH and lose to the interpreter on wall clock; ONE family-grain crate — every member fn concatenated into one emitted source with an argv-dispatched main — pays the build once, and every member run after the first is compile_skipped. Build at family grain, never per witness. This supersedes witness-realization-plan FLAG B v0 (one binary per entry closure). The family artifact reuses the SAME key authority: emit_on_demand_key over family_closure_digest(member digests) — the family is a different closure input, not a second key scheme. Member LIST ORDER is declared key material (concat order and dispatcher arm order are artifact content); the digest is tag-seeded so a singleton family never collides with its bare member digest. Receipt by execution: emit_on_demand_family_crate_witness_test (one-build-members-warm, unknown-member RED, member-change cold rebuild)."

fn family_closure_digest(members: List<ContentHash>) -> ContentHash {
  fold(
    members,
    init: content_hash_atom(value: "witness-family-closure"),
    f: (acc, member) => content_hash_combine(left: acc, right: member)
  )
}

type ArtifactGrain
  = SourceArtifact
  | NativeArtifact

fn toolchain_for_grain(grain: ArtifactGrain) -> String {
  match grain {
    SourceArtifact => "source-artifact"
    NativeArtifact => "native-artifact"
  }
}

fn emit_on_demand_key(
  closure_digest: ContentHash,
  emitter_identity: String,
  target_language: String,
  grain: ArtifactGrain
) -> ContentHash {
  artifact_key_hash(key: ArtifactKey {
    closure_digest: closure_digest,
    emitter_identity: emitter_identity,
    target_language: target_language,
    toolchain: toolchain_for_grain(grain: grain)
  })
}

type EmitOnDemandCacheReceipt {
  key: ContentHash
  compile_skipped: Bool
}

type EmitOnDemandLookup
  = EmitOnDemandHit { receipt: EmitOnDemandCacheReceipt }
  | EmitOnDemandMiss

fn emit_on_demand_lookup(store: ArtifactStore, key: ContentHash) -> EmitOnDemandLookup {
  match store_get(store: store, key: key) {
    StoreHit { store: _, row: _ } =>
      EmitOnDemandHit {
        receipt: EmitOnDemandCacheReceipt { key: key, compile_skipped: true }
      }
    StoreMiss { store: _ } => EmitOnDemandMiss
  }
}

fn materialization_for_lookup(lookup: EmitOnDemandLookup) -> Materialization {
  match lookup {
    EmitOnDemandHit { receipt: _ } => Share
    EmitOnDemandMiss => Recompute
  }
}

type InterpreterSurvivingRole {
  id: String
  purpose: String
  dissolution_trigger: String
}

data interpreter_surviving_roles: List<InterpreterSurvivingRole> = [
  InterpreterSurvivingRole {
    id: "bootstrap-receipts",
    purpose: "S1 parse census and seed-honesty receipts until native artifacts cover the corpus",
    dissolution_trigger: "witness_family_fanout complete + ci_floor_cutover on v2-emitted execution"
  },
  InterpreterSurvivingRole {
    id: "compile-time-eval",
    purpose: "EqualsClaim expected arm and emit-vs-eval oracle during the emit_host transition",
    dissolution_trigger: "emit_on_demand agreement witnesses green for every enrolled family"
  },
  InterpreterSurvivingRole {
    id: "terminal-bootstrap-kernel",
    purpose: "claim_executor host physics (pinned HAND roster — recorded_fixture, resolved_graph_cache)",
    dissolution_trigger: "v1_quarantine — seed crates frozen as bootstrap artifact only"
  }
]

data interpreter_surviving_roles_ceiling_note: String = "Policy ceiling (independent of current occupancy): bootstrap headroom for interpreter-surviving roles until witness_family_fanout lands (P3 ACCEPT (c); docs/plans/witness-realization-plan.md). Occupancy is count(interpreter_surviving_roles); the ceiling is an upper bound so roster growth is checked against declared headroom, never conflated with a hand count of current entries."

data interpreter_surviving_roles_ceiling: Int = 8

fn interpreter_surviving_roles_occupancy() -> Int {
  list_length(items: interpreter_surviving_roles)
}

fn interpreter_surviving_roles_occupancy_within_ceiling() -> Bool {
  interpreter_surviving_roles_occupancy() <= interpreter_surviving_roles_ceiling
}

fn interpreter_surviving_roles_bounded() -> Bool {
  interpreter_surviving_roles_occupancy() > 0
    && interpreter_surviving_roles_occupancy_within_ceiling()
}
