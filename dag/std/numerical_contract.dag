module std.numerical_contract

import std.approximate_field {
  RoundingMode,
  ToNearestEven,
}
import std.types { Bool }

data numerical_contract_approximate_field_reuse_note: String = "NumericalContract.FloatApproximate.rounding reuses std.approximate_field.RoundingMode; new axes are integer|float domain split + FmaContractionPolicy only (reuse-first vs minting a parallel rounding authority)."

data numerical_contract_dissolution_trigger: String = "dissolve-on: resolve accelerator-demo-roundtrip.md open thread — fold FmaContractionPolicy into std.approximate_field when float-numerics authority lands there; until then NumericalContract is the declared sum for DecodeFidelity coupling."

type FmaContractionPolicy
  = FmaContractionPermitted
  | FmaContractionRefused

type NumericalContract
  = IntegerExact
  | FloatApproximate {
      rounding: RoundingMode
      fma_contraction: FmaContractionPolicy
    }

fn integer_exact_contract() -> NumericalContract {
  IntegerExact
}

fn float_contract(
  rounding: RoundingMode,
  fma: FmaContractionPolicy
) -> NumericalContract {
  FloatApproximate {
    rounding: rounding
    fma_contraction: fma
  }
}
