module std.numerical_contract
import std.approximate_field { RoundingMode }


type FmaContractionPolicy
  = FmaContractionPermitted
  | FmaContractionRefused

type NumericalContract
  = IntegerExact
  | FloatApproximate {
      rounding: std.approximate_field.RoundingMode
      fma_contraction: FmaContractionPolicy
    }

fn integer_exact_contract() -> NumericalContract {
  IntegerExact
}

fn float_contract(
  rounding: std.approximate_field.RoundingMode,
  fma: FmaContractionPolicy
) -> NumericalContract {
  FloatApproximate {
    rounding: rounding
    fma_contraction: fma
  }
}
