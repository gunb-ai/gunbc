module std.artifact_store

import std.types { ContentHash, NonEmptyStr, List, Int, Bool, String }
import std.content_hash { content_hash_atom, content_hash_combine, content_hash_tagged }
import std.measure { ByteSize, byte_size, measure_count }
import std.materialization_ladder { CacheProvider, EvictionClass, ScopeExit, SpacePacked }
import std.disposition { Disposition, Terminal }

data artifact_store_module_note: String = "Witness-realization plan P2 (pure-spec half): the content-addressed artifact store - the corpus's first CacheProvider whose eviction field is READ (memory-control audit F5: eviction was write-only; here it gates construction and drives packing). The store is modeled as a pure fold: get bumps recency, put packs to budget by least-recent eviction with every eviction COUNTED in the returned receipt (a failure arm must refuse or count, never widen - DESIGN section 5). Keying is ContentHash BY SHAPE: no mtime, no existence input exists to consult, so ExistenceKeyed is unwritable here (the #6352 wall by construction). The host transport (real artifact directory + build wiring) is P2's second half; this spec is its single authority. Dissolve-on for the budget parameter: EvictionClass's budget field currently carries cited upstream policy PROSE in extdeps rows (two concepts in one field - our enforceable budget vs their described mechanism); when that splits into typed variants, store_over_provider derives the budget from the row instead of taking it beside the row."

type ArtifactKey {
  closure_digest: ContentHash
  emitter_identity: NonEmptyStr
  target_language: NonEmptyStr
  toolchain: NonEmptyStr
}

type ArtifactRealizationInput {
  identity: NonEmptyStr
  content_digest: ContentHash
}

fn artifact_realization_input_digest(realization_input: ArtifactRealizationInput) -> ContentHash {
  content_hash_tagged(
    tag: realization_input.identity,
    payload: realization_input.content_digest
  )
}

fn artifact_realization_digest(inputs: List<ArtifactRealizationInput>) -> ContentHash {
  fold(
    inputs,
    init: content_hash_atom(value: "artifact_store.realization"),
    f: (acc, realization_input) => content_hash_combine(
      left: acc,
      right: artifact_realization_input_digest(realization_input: realization_input)
    )
  )
}

fn artifact_key_hash(key: ArtifactKey) -> ContentHash {
  content_hash_tagged(
    tag: "artifact_store.key",
    payload: content_hash_combine(
      left: key.closure_digest,
      right: content_hash_combine(
        left: content_hash_atom(value: key.emitter_identity),
        right: content_hash_combine(
          left: content_hash_atom(value: key.target_language),
          right: content_hash_atom(value: key.toolchain)
        )
      )
    )
  )
}

type ArtifactRow {
  key: ContentHash
  artifact_bytes: ByteSize
  last_use_ordinal: Int
}

type ArtifactStore {
  budget: ByteSize
  next_ordinal: Int
  rows: List<ArtifactRow>
}

type StoreConstruction
  = StoreReady { store: ArtifactStore }
  | StoreRefusedEviction { provider_id: String, declared: EvictionClass }

fn store_over_provider(provider: CacheProvider, budget: ByteSize) -> StoreConstruction {
  match provider.eviction {
    SpacePacked { budget: _ } =>
      StoreReady { store: ArtifactStore { budget: budget, next_ordinal: 1, rows: [] } }
    ScopeExit =>
      StoreRefusedEviction { provider_id: provider.id, declared: provider.eviction }
  }
}

type StoreLookup
  = StoreHit { store: ArtifactStore, row: ArtifactRow }
  | StoreMiss { store: ArtifactStore }

fn store_bytes_used(store: ArtifactStore) -> Int {
  fold(store.rows, init: 0, f: (acc, r) => acc + measure_count(m: r.artifact_bytes))
}

fn store_get(store: ArtifactStore, key: ContentHash) -> StoreLookup {
  match store.rows |> filter(r => r.key == key) |> first {
    Present { value: row } =>
      let bumped = ArtifactRow { key: row.key, artifact_bytes: row.artifact_bytes, last_use_ordinal: store.next_ordinal }
      StoreHit {
        store: ArtifactStore {
          budget: store.budget,
          next_ordinal: store.next_ordinal + 1,
          rows: concat(store.rows |> filter(r => (r.key == key) == false), [bumped])
        },
        row: bumped
      }
    Absent => StoreMiss { store: store }
  }
}

data no_evicted_keys: List<ContentHash> = []

type StorePutReceipt {
  store: ArtifactStore
  evicted: List<ContentHash>
}

fn least_recent_row(rows: List<ArtifactRow>) -> ArtifactRow? {
  match rows |> first {
    Present { value: seed } =>
      Present { value: fold(rows, init: seed, f: (best, r) => if r.last_use_ordinal < best.last_use_ordinal { r } else { best }) }
    Absent => none
  }
}

fn evict_until_within_budget(store: ArtifactStore, evicted: List<ContentHash>) -> StorePutReceipt {
  if store_bytes_used(store: store) <= measure_count(m: store.budget) {
    StorePutReceipt { store: store, evicted: evicted }
  } else {
    match least_recent_row(rows: store.rows) {
      Present { value: victim } =>
        evict_until_within_budget(
          store: ArtifactStore {
            budget: store.budget,
            next_ordinal: store.next_ordinal,
            rows: store.rows |> filter(r => (r.key == victim.key) == false)
          },
          evicted: concat(evicted, [victim.key])
        )
      Absent => StorePutReceipt { store: store, evicted: evicted }
    }
  }
}

data store_put_totality_note: String = "store_put is TOTAL over its two real outcomes, and the fit test runs BEFORE any eviction (operator scope call, 2026-07-29; reproduction receipt on PR 7385). The prior signature returned a StorePutReceipt unconditionally, which conflated two states that need opposite remedies: an artifact LARGER than the whole budget fell into the eviction loop, evicted every legitimate row, then evicted ITSELF (the fresh row carries the highest ordinal, so it is the last victim), and returned a receipt whose evicted list contained the key the caller had just put — indistinguishable at the type level from 'stored, and these older ones were evicted'. Measured: 500 bytes into a 100-byte budget holding one valid 40-byte row returned TWO evictions and an empty store, so an oversized put was not merely mislabelled, it was DESTRUCTIVE — it discarded valid cached entries and stored nothing while reporting success. The repair is construction, not a louder report (DESIGN section 5): the fit test precedes eviction, so the destructive path is unwritable rather than detected after the damage, and the two outcomes are distinct VALUES rather than one value whose fields the caller must interpret. Because artifact_bytes <= budget is established before the loop runs, the fresh row can never be its own victim — the self-eviction is gone by construction, not by a guard inside the loop."

type StorePutOutcome
  = StorePutAdmitted { store: ArtifactStore, evicted: List<ContentHash> }
  | StorePutDidNotFit { artifact_bytes: ByteSize, budget: ByteSize }

fn store_put(store: ArtifactStore, key: ContentHash, artifact_bytes: ByteSize) -> StorePutOutcome {
  if measure_count(m: artifact_bytes) > measure_count(m: store.budget) {
    StorePutDidNotFit { artifact_bytes: artifact_bytes, budget: store.budget }
  } else {
    let fresh = ArtifactRow { key: key, artifact_bytes: artifact_bytes, last_use_ordinal: store.next_ordinal }
    let grown = ArtifactStore {
      budget: store.budget,
      next_ordinal: store.next_ordinal + 1,
      rows: concat(store.rows |> filter(r => (r.key == key) == false), [fresh])
    }
    let packed = evict_until_within_budget(store: grown, evicted: [])
    StorePutAdmitted { store: packed.store, evicted: packed.evicted }
  }
}

data store_put_reader_contract: Disposition = Terminal {
  reason: "store_put_fold is the only match over StorePutOutcome; the readers below derive from it and contain no match of their own, so a third outcome is a type error at exactly one site. There is deliberately NO store_put_store(outcome, fallback) projection — answering DidNotFit with a caller-supplied store is the absorbing fallback DESIGN section 5 forbids, and it is precisely what would let the destructive behavior this type exists to remove return in a new shape. Discriminating corpus: dag/test/claim/artifact_store_witness_test.dag."
}

fn store_put_fold<T>(
  outcome: StorePutOutcome,
  admitted: fn(ArtifactStore, List<ContentHash>) -> T,
  did_not_fit: fn(ByteSize, ByteSize) -> T
) -> T {
  match outcome {
    StorePutAdmitted { store: s, evicted: e } => admitted(s, e)
    StorePutDidNotFit { artifact_bytes: a, budget: b } => did_not_fit(a, b)
  }
}

fn store_put_is_admitted(outcome: StorePutOutcome) -> Bool {
  store_put_fold(outcome: outcome, admitted: (s, e) => true, did_not_fit: (a, b) => false)
}

fn store_put_evicted_keys(outcome: StorePutOutcome) -> List<ContentHash> {
  store_put_fold(outcome: outcome, admitted: (s, e) => e, did_not_fit: (a, b) => no_evicted_keys)
}
