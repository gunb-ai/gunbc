module std.artifact_store

import std.types { NonEmptyStr, List, Int, Bool, String }
import std.content_hash {
  ContentHash,
  Fnv1a64Structural,
  content_hash_atom,
  content_hash_combine_structural,
  content_hash_tagged,
  content_hash_tagged_structural,
  as_content_hash_structural,
}
import std.measure { ByteSize, byte_size, measure_count }
import std.materialization_ladder { CacheProvider }
import std.cache_interface {
  ProviderRetention,
  ReleasedAtProviderScopeExit,
  ReleasedNever,
  ReleasedManually,
  CapacityPolicy,
  CapacityUnbounded,
  CapacityBounded,
  CapacityUnobserved,
  CapacityLimit,
  ByteCapacity,
  EntryCountCapacity,
  ExactLimit,
  RuntimeDerivedLimit,
  EffectiveLimitUnobserved,
  AtCapacityDisposition,
  RefuseNewStore,
  ReplaceExisting,
  AtCapacityUnobserved,
  ReplacementStrategy,
  LeastRecentlyUsed,
  ProviderNativeReplacement,
}
import std.disposition { Disposition, Terminal }
import std.decl_ref { declaration_ref_eq }
import gunbc.materialization_store_capacity { StoreCeiling, materialization_store_byte_ceiling_authority }

// Witness-realization plan P2 (pure-spec half): the content-addressed artifact store - the corpus's
// first CacheProvider whose eviction field is READ (memory-control audit F5: eviction was
// write-only; here it gates construction and drives packing). The store is modeled as a pure fold:
// get bumps recency, put packs to budget by least-recent eviction with every eviction COUNTED in
// the returned receipt (a failure arm must refuse or count, never widen - DESIGN section 5). Keying
// is ContentHash BY SHAPE: no mtime, no existence input exists to consult, so ExistenceKeyed is
// unwritable here (the #6352 wall by construction). The host transport (real artifact directory +
// build wiring) is P2's second half; this spec is its single authority. THAT DISSOLVE-ON HAS FIRED
// (2026-08-07). The budget parameter is gone: store_over_provider(provider) now DERIVES the ceiling
// from the provider's own CapacityBounded/ByteCapacity/ExactLimit, because a caller-supplied
// ByteSize beside a provider that declares its own capacity was two authorities for one fact, and
// the fixtures proved they contradicted - providers declaring EffectiveLimitUnobserved were handed
// exact budgets of 100 and 1000000 bytes and the store believed the caller. It also realized every
// bounded provider as least-recently-used regardless of what at_capacity said, so a RefuseNewStore
// row would silently have evicted. Each way the derivation can fail now has its own cause rather
// than one StoreRefusedRetention the caller must re-interpret. store_over_provider_resolved
// extends the same derivation to a RuntimeDerivedLimit: the value then arrives as the ceiling home's
// sole_constructor StoreCeiling, for the one authority that home is, never as a caller's ByteSize,
// and the store is built by artifact_store_for_ceiling, the one construction of a store from that
// ceiling.

type ArtifactKey {
  closure_digest: Fnv1a64Structural
  emitter_identity: NonEmptyStr
  target_language: NonEmptyStr
  toolchain: NonEmptyStr
}

type ArtifactRealizationInput {
  identity: NonEmptyStr
  content_digest: Fnv1a64Structural
}

fn artifact_realization_input_digest(realization_input: ArtifactRealizationInput) -> Fnv1a64Structural {
  content_hash_tagged_structural(
    tag: realization_input.identity,
    payload: realization_input.content_digest
  )
}

fn artifact_realization_digest(inputs: List<ArtifactRealizationInput>) -> ContentHash {
  as_content_hash_structural(
    structural: fold(
      inputs,
      init: content_hash_atom(value: "artifact_store.realization"),
      f: (acc, realization_input) => content_hash_combine_structural(
        left: acc,
        right: artifact_realization_input_digest(realization_input: realization_input)
      )
    )
  )
}

fn artifact_key_hash(key: ArtifactKey) -> ContentHash {
  content_hash_tagged(
    tag: "artifact_store.key",
    payload: content_hash_combine_structural(
      left: key.closure_digest,
      right: content_hash_combine_structural(
        left: content_hash_atom(value: key.emitter_identity),
        right: content_hash_combine_structural(
          left: content_hash_atom(value: key.target_language),
          right: content_hash_atom(value: key.toolchain)
        )
      )
    )
  )
}

type ArtifactRow {
  key: ContentHash
  artifact_bytes: ByteSize
  last_use_ordinal: Int
}

type ArtifactStore {
  budget: ByteSize
  next_ordinal: Int
  rows: List<ArtifactRow>
}

// THE ONE CONSTRUCTION OF A STORE FROM A CEILING (M1.c, spec gunbc#12581 revision 3, section 7.2).
// The store is empty, counts from ordinal 1, and its budget is the ceiling's apparent file bytes. The
// argument is gunbc.materialization_store_capacity's StoreCeiling, which is sole_constructor and
// minted only by materialization_store_byte_ceiling, never a ByteSize, so a store built here is sized
// by a number that home answered. It needs no CacheProvider and no ProviderRetention, so the commit
// can build its store without the provider door. The door, store_over_provider_resolved, makes its
// checks and then answers exactly this construction; it does not build a store of its own. The
// ExactLimit arm of store_from_limit builds from a provider's stated number, which is not a
// StoreCeiling, and is not a construction from this ceiling.
//
// WHY THE COMMIT MAY SKIP THE DOOR, AND THE ONE CHECK IT RELIES ON. The policy a store built here
// is realized under belongs on the local store's catalog row, extdeps.realization.materialization_store_local
// materialization_store_local_facts (spec section 2.6 moves the row to
// materialization_store_local_catalog): a RuntimeDerivedLimit whose authority is
// materialization_store_byte_ceiling_authority, least-recently-used replacement, and a release policy
// that outlives the provider's scope. The row is constant data, so it is judged once, by a witness,
// and not by every commit. The witness runs the constant row through store_over_provider_resolved and
// asserts StoreReady with exactly this function's store for the same ceiling. If the row's authority,
// replacement or release policy changed, the door would refuse the row and the witness would go red,
// so the commit's direct call stays equivalent to the door's answer. That witness is the check the
// commit path relies on: test.claim.artifact_store_witness
// the_store_catalog_row_admits_exactly_the_ceiling_store.
//
// DECLARED FRONTIER (DESIGN section 3c). Today's consumers are store_from_limit's resolved arm and
// test.claim.artifact_store_witness, which executes this function directly and through the door. The
// production consumer is M1.c landing unit L5b's local store commit: the ceiling of the root it
// opened, this construction, artifact_store_with_occupancy, and one store_put. The catalog-row
// witness named above does not exist yet. It lands in L5b together with the row's retention (spec
// section 8, L5b "catalog retention"), because until then the row declares CapacityUnobserved, and
// that is true: nothing applies a ceiling to that store or evicts from it yet, and the row's own
// retention evidence says it stays unobserved until this accounting binds to the store. Declaring the
// bounded policy before the commit enforces it would overstate the store. TRIGGER: L5b's catalog
// retention row names materialization_store_byte_ceiling_authority and L5b's local_store_commit calls
// artifact_store_for_ceiling; the commit does not land without that witness green.
fn artifact_store_for_ceiling(ceiling: StoreCeiling) -> ArtifactStore {
  ArtifactStore { budget: ceiling.apparent_file_bytes, next_ordinal: 1, rows: [] }
}

// EXACT CAUSES, not one carrier the caller must re-read. The remedies differ:
// a wrong UNIT means this provider is the wrong cache for a byte-budgeted
// store; an unresolved value means the deriving authority has to run first; an
// unobserved one needs a citation; an unsupported at-capacity action means the
// LRU realization below is not what that provider does. The two resolution
// causes belong to store_over_provider_resolved: a ceiling handed over for a
// limit some OTHER authority derives would size the store by the wrong fact,
// and a ceiling handed over beside an exact limit the provider already states
// would be a second authority for one number.
type StoreRefusalCause
  = ProviderScopeReleased
  | ProviderCapacityUnbounded
  | ProviderCapacityUnobserved
  | CapacityUnitMismatch
  | CapacityValueUnobserved
  | CapacityValueUnresolved
  | CapacityAuthorityMismatch
  | ResolvedCeilingBesideExactLimit
  | StoreAtCapacityUnobserved
  | RefuseNewStoreUnsupported
  | ReplacementStrategyUnsupported

type StoreConstruction
  = StoreReady { store: ArtifactStore }
  | StoreRefusedRetention {
      provider_id: String,
      declared: ProviderRetention,
      cause: StoreRefusalCause
    }

// A persistent store needs BOTH halves: storage that outlives the provider's
// scope, AND a byte ceiling whose value is in hand. The budget is no longer a
// parameter, so a store cannot be built over a provider that never established
// the number it is being sized by.
fn store_over_provider(provider: CacheProvider) -> StoreConstruction {
  store_over_provider_with(provider: provider, resolved: none)
}

// THE RUNTIME-DERIVED ARM, RESOLVED. A provider whose byte ceiling is RuntimeDerivedLimit { authority }
// names the authority that computes the number instead of stating it, and store_over_provider refuses
// it as CapacityValueUnresolved because no value is in hand. This door accepts the value -- but only
// as a gunbc.materialization_store_capacity StoreCeiling, which is sole_constructor and minted only
// by materialization_store_byte_ceiling, and only for a provider whose authority IS that function
// (materialization_store_byte_ceiling_authority). Release policy, capacity unit and at-capacity action
// are judged exactly as store_over_provider judges them, so a scope-released provider, an entry-count
// ceiling and a non-LRU at_capacity still refuse with their own causes. Then, and only then, the
// store is artifact_store_for_ceiling's: this door checks and does not build a store of its own. No
// ByteSize is accepted here, so a caller cannot size eviction by a number the ceiling's home did not
// answer.
//
// WHAT THIS DOOR IS FOR. The commit does not call it: the commit builds its store with
// artifact_store_for_ceiling and needs no CacheProvider (spec gunbc#12581 revision 3, sections 2.6 and
// 9.1 Q11). This door is where a provider row's policy is judged against that construction, and the
// row it exists to judge is the local store's catalog row, whose policy is constant.
//
// DECLARED FRONTIER (DESIGN section 3c). Today's consumer is test.claim.artifact_store_witness, whose
// fixture providers execute every arm. The consumer the commit path relies on is the witness named in
// artifact_store_for_ceiling's leading comment, which runs the constant catalog row through this door.
// TRIGGER: M1.c landing unit L5b's catalog retention row names
// materialization_store_byte_ceiling_authority.
fn store_over_provider_resolved(provider: CacheProvider, resolved: StoreCeiling) -> StoreConstruction {
  store_over_provider_with(provider: provider, resolved: Present { value: resolved })
}

fn store_over_provider_with(provider: CacheProvider, resolved: StoreCeiling?) -> StoreConstruction {
  match provider.retention.release_policy {
    ReleasedAtProviderScopeExit => store_refused(provider: provider, cause: ProviderScopeReleased)
    ReleasedNever => store_from_capacity(provider: provider, c: provider.retention.capacity, resolved: resolved)
    ReleasedManually => store_from_capacity(provider: provider, c: provider.retention.capacity, resolved: resolved)
  }
}

fn store_refused(provider: CacheProvider, cause: StoreRefusalCause) -> StoreConstruction {
  StoreRefusedRetention {
    provider_id: provider.id,
    declared: provider.retention,
    cause: cause
  }
}

fn store_from_capacity(provider: CacheProvider, c: CapacityPolicy, resolved: StoreCeiling?) -> StoreConstruction {
  match c {
    CapacityUnbounded => store_refused(provider: provider, cause: ProviderCapacityUnbounded)
    CapacityUnobserved => store_refused(provider: provider, cause: ProviderCapacityUnobserved)
    CapacityBounded { limit: l, at_capacity: action } =>
      match store_replacement_supported(action: action) {
        Present { value: cause } => store_refused(provider: provider, cause: cause)
        Absent => store_from_limit(provider: provider, l: l, resolved: resolved)
      }
  }
}

// THE REALIZATION BELOW IS LEAST-RECENTLY-USED, so it may only be built over a
// provider that says so. The former shape read at_capacity not at all and
// packed by LRU whatever the row declared.
fn store_replacement_supported(action: AtCapacityDisposition) -> StoreRefusalCause? {
  match action {
    AtCapacityUnobserved => Present { value: StoreAtCapacityUnobserved }
    RefuseNewStore => Present { value: RefuseNewStoreUnsupported }
    ReplaceExisting { strategy: s } => match s {
      LeastRecentlyUsed => none
      ProviderNativeReplacement => Present { value: ReplacementStrategyUnsupported }
    }
  }
}

fn store_from_limit(provider: CacheProvider, l: CapacityLimit, resolved: StoreCeiling?) -> StoreConstruction {
  match l {
    EntryCountCapacity { limit: _ } => store_refused(provider: provider, cause: CapacityUnitMismatch)
    ByteCapacity { limit: v } => match v {
      ExactLimit { value: bytes } => match resolved {
        Absent => StoreReady { store: ArtifactStore { budget: bytes, next_ordinal: 1, rows: [] } }
        Present { value: _ } => store_refused(provider: provider, cause: ResolvedCeilingBesideExactLimit)
      }
      RuntimeDerivedLimit { authority: a } => match resolved {
        Absent => store_refused(provider: provider, cause: CapacityValueUnresolved)
        Present { value: ceiling } =>
          if declaration_ref_eq(a: a, b: materialization_store_byte_ceiling_authority) {
            StoreReady { store: artifact_store_for_ceiling(ceiling: ceiling) }
          } else {
            store_refused(provider: provider, cause: CapacityAuthorityMismatch)
          }
      }
      EffectiveLimitUnobserved =>
        store_refused(provider: provider, cause: CapacityValueUnobserved)
    }
  }
}

// ONE OBSERVED ROW PER STORED ENTRY: its key and its size in APPARENT FILE BYTES, the unit
// gunbc.materialization_store_capacity's StoreCeiling bounds (spec gunbc#12581 revision 3, section
// 9.1 Q11), named on the field so the unit reaches the fold the ceiling sizes.
type ArtifactOccupancyRow {
  key: ContentHash
  apparent_file_bytes: ByteSize
}

// A STORE THAT ALREADY HAS CONTENTS, BUILT FROM WHAT IS ON DISK (M1.c, spec gunbc#12581 revision 3,
// section 7.2). A persistent store's accounting does not survive the process: each commit re-reads
// the entries that exist and must rebuild this fold's state from them before its one store_put.
//
// THE STORE IS BUILT FIRST, AND THIS ONLY SEEDS IT. The argument is an ArtifactStore that was
// already built -- for the local store, artifact_store_for_ceiling over the StoreCeiling of the root
// the commit opened -- and its budget is kept as it is. There is no budget parameter: the budget is
// the one the store carries, which on the commit's route is the ceiling's. The seal is on this ROUTE,
// not on the type: ArtifactStore is an open record that gunbc.spark.v41_runtime_realized and several
// witness fixtures construct directly, and sealing it is not this unit's change (the spec's
// std.artifact_store_provider carve constructs it from a second module).
//
// The observed rows are listed in RECENCY ORDER, LEAST RECENTLY USED FIRST; row i (from 0) takes
// last_use_ordinal store.next_ordinal + i, and next_ordinal moves one past the last. So the order the
// census observed IS the order eviction will consult, and every observed row is more recent than any
// row the store already held. On the empty store StoreReady carries, that is ordinals 1..N and a next
// ordinal of N + 1.
//
// NO PER-ROW REPLAY. Building the store by store_put-ing each observed row would re-run eviction
// while merely READING the disk: a lowered ceiling would silently drop entries during construction,
// and those evictions would appear in no receipt, because a put's receipt belongs to the put that
// made it. Here construction decides nothing. Every observed row is kept, even when the total
// already exceeds the ceiling (the operator lowered it, for instance), and the ONE store_put the
// commit then makes packs the store back within the ceiling by its ordinary least-recent eviction,
// with every eviction counted in that put's receipt. An artifact larger than the whole ceiling is
// StorePutDidNotFit before anything is evicted, over-ceiling occupancy included.
//
// KEY UNIQUENESS IS THE CENSUS'S. A stored entry is named by its key, so a directory listing yields
// each key once; this fold does not re-check it, and the commit seeds the empty store, so no key the
// store already held can repeat one the census observed.
//
// DECLARED FRONTIER (DESIGN section 3c). Today's consumer is test.claim.artifact_store_witness. The
// production consumer is the local store commit in M1.c landing unit L5b
// (extdeps.realization.materialization_store_local: census, reclaim dead classes, the ceiling of the
// opened root, artifact_store_for_ceiling, this seed, one store_put).
// TRIGGER: L5b's local_store_commit calls artifact_store_with_occupancy.
fn artifact_store_with_occupancy(store: ArtifactStore, occupancy: List<ArtifactOccupancyRow>) -> ArtifactStore {
  ArtifactStore {
    budget: store.budget,
    next_ordinal: store.next_ordinal + (occupancy |> count),
    rows: concat(store.rows, enumerate(occupancy) |> map(pair => ArtifactRow {
      key: pair.second.key,
      artifact_bytes: pair.second.apparent_file_bytes,
      last_use_ordinal: store.next_ordinal + pair.first
    }))
  }
}

type StoreLookup
  = StoreHit { store: ArtifactStore, row: ArtifactRow }
  | StoreMiss { store: ArtifactStore }

fn store_bytes_used(store: ArtifactStore) -> Int {
  fold(store.rows, init: 0, f: (acc, r) => acc + measure_count(m: r.artifact_bytes))
}

fn store_get(store: ArtifactStore, key: ContentHash) -> StoreLookup {
  match store.rows |> filter(r => r.key == key) |> first {
    Present { value: row } =>
      let bumped = ArtifactRow { key: row.key, artifact_bytes: row.artifact_bytes, last_use_ordinal: store.next_ordinal }
      StoreHit {
        store: ArtifactStore {
          budget: store.budget,
          next_ordinal: store.next_ordinal + 1,
          rows: concat(store.rows |> filter(r => (r.key == key) == false), [bumped])
        },
        row: bumped
      }
    Absent => StoreMiss { store: store }
  }
}

data no_evicted_keys: List<ContentHash> = []

type StorePutReceipt {
  store: ArtifactStore
  evicted: List<ContentHash>
}

fn least_recent_row(rows: List<ArtifactRow>) -> ArtifactRow? {
  match rows |> first {
    Present { value: seed } =>
      Present { value: fold(rows, init: seed, f: (best, r) => if r.last_use_ordinal < best.last_use_ordinal { r } else { best }) }
    Absent => none
  }
}

fn evict_until_within_budget(store: ArtifactStore, evicted: List<ContentHash>) -> StorePutReceipt {
  if store_bytes_used(store: store) <= measure_count(m: store.budget) {
    StorePutReceipt { store: store, evicted: evicted }
  } else {
    match least_recent_row(rows: store.rows) {
      Present { value: victim } =>
        evict_until_within_budget(
          store: ArtifactStore {
            budget: store.budget,
            next_ordinal: store.next_ordinal,
            rows: store.rows |> filter(r => (r.key == victim.key) == false)
          },
          evicted: concat(evicted, [victim.key])
        )
      Absent => StorePutReceipt { store: store, evicted: evicted }
    }
  }
}

// store_put is TOTAL over its two real outcomes, and the fit test runs BEFORE any eviction
// (operator scope call, 2026-07-29; reproduction receipt on PR 7385). The prior signature returned
// a StorePutReceipt unconditionally, which conflated two states that need opposite remedies: an
// artifact LARGER than the whole budget fell into the eviction loop, evicted every legitimate row,
// then evicted ITSELF (the fresh row carries the highest ordinal, so it is the last victim), and
// returned a receipt whose evicted list contained the key the caller had just put —
// indistinguishable at the type level from 'stored, and these older ones were evicted'. Measured:
// 500 bytes into a 100-byte budget holding one valid 40-byte row returned TWO evictions and an
// empty store, so an oversized put was not merely mislabelled, it was DESTRUCTIVE — it discarded
// valid cached entries and stored nothing while reporting success. The repair is construction, not
// a louder report (DESIGN section 5): the fit test precedes eviction, so the destructive path is
// unwritable rather than detected after the damage, and the two outcomes are distinct VALUES rather
// than one value whose fields the caller must interpret. Because artifact_bytes <= budget is
// established before the loop runs, the fresh row can never be its own victim — the self-eviction
// is gone by construction, not by a guard inside the loop.

type StorePutOutcome
  = StorePutAdmitted { store: ArtifactStore, evicted: List<ContentHash> }
  | StorePutDidNotFit { artifact_bytes: ByteSize, budget: ByteSize }

fn store_put(store: ArtifactStore, key: ContentHash, artifact_bytes: ByteSize) -> StorePutOutcome {
  if measure_count(m: artifact_bytes) > measure_count(m: store.budget) {
    StorePutDidNotFit { artifact_bytes: artifact_bytes, budget: store.budget }
  } else {
    let fresh = ArtifactRow { key: key, artifact_bytes: artifact_bytes, last_use_ordinal: store.next_ordinal }
    let grown = ArtifactStore {
      budget: store.budget,
      next_ordinal: store.next_ordinal + 1,
      rows: concat(store.rows |> filter(r => (r.key == key) == false), [fresh])
    }
    let packed = evict_until_within_budget(store: grown, evicted: [])
    StorePutAdmitted { store: packed.store, evicted: packed.evicted }
  }
}

data store_put_reader_contract: Disposition = Terminal {
  reason: "store_put_fold is the only match over StorePutOutcome; the readers below derive from it and contain no match of their own, so a third outcome is a type error at exactly one site. There is deliberately NO store_put_store(outcome, fallback) projection — answering DidNotFit with a caller-supplied store is the absorbing fallback DESIGN section 5 forbids, and it is precisely what would let the destructive behavior this type exists to remove return in a new shape. Discriminating corpus: dag/test/claim/artifact_store_witness_test.dag."
}

fn store_put_fold<T>(
  outcome: StorePutOutcome,
  admitted: fn(ArtifactStore, List<ContentHash>) -> T,
  did_not_fit: fn(ByteSize, ByteSize) -> T
) -> T {
  match outcome {
    StorePutAdmitted { store: s, evicted: e } => admitted(s, e)
    StorePutDidNotFit { artifact_bytes: a, budget: b } => did_not_fit(a, b)
  }
}

fn store_put_is_admitted(outcome: StorePutOutcome) -> Bool {
  store_put_fold(outcome: outcome, admitted: (s, e) => true, did_not_fit: (a, b) => false)
}

fn store_put_evicted_keys(outcome: StorePutOutcome) -> List<ContentHash> {
  store_put_fold(outcome: outcome, admitted: (s, e) => e, did_not_fit: (a, b) => no_evicted_keys)
}
