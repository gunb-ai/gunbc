module std.artifact_store


data artifact_store_module_note: String = "Witness-realization plan P2 (pure-spec half): the content-addressed artifact store - the corpus's first CacheProvider whose eviction field is READ (memory-control audit F5: eviction was write-only; here it gates construction and drives packing). The store is modeled as a pure fold: get bumps recency, put packs to budget by least-recent eviction with every eviction COUNTED in the returned receipt (a failure arm must refuse or count, never widen - DESIGN section 5). Keying is ContentHash BY SHAPE: no mtime, no existence input exists to consult, so ExistenceKeyed is unwritable here (the #6352 wall by construction). The host transport (real artifact directory + build wiring) is P2's second half; this spec is its single authority. THAT DISSOLVE-ON HAS FIRED (2026-08-07). The budget parameter is gone: store_over_provider(provider) now DERIVES the ceiling from the provider's own CapacityBounded/ByteCapacity/ExactLimit, because a caller-supplied ByteSize beside a provider that declares its own capacity was two authorities for one fact, and the fixtures proved they contradicted - providers declaring EffectiveLimitUnobserved were handed exact budgets of 100 and 1000000 bytes and the store believed the caller. It also realized every bounded provider as least-recently-used regardless of what at_capacity said, so a RefuseNewStore row would silently have evicted. Each way the derivation can fail now has its own cause rather than one StoreRefusedRetention the caller must re-interpret."

type ArtifactKey {
  closure_digest: std.content_hash.Fnv1a64Structural
  emitter_identity: std.types.NonEmptyStr
  target_language: std.types.NonEmptyStr
  toolchain: std.types.NonEmptyStr
}

type ArtifactRealizationInput {
  identity: std.types.NonEmptyStr
  content_digest: std.content_hash.Fnv1a64Structural
}

fn artifact_realization_input_digest(realization_input: ArtifactRealizationInput) -> std.content_hash.Fnv1a64Structural {
  std.content_hash.content_hash_tagged_structural(
    tag: realization_input.identity,
    payload: realization_input.content_digest
  )
}

fn artifact_realization_digest(inputs: List<ArtifactRealizationInput>) -> std.content_hash.ContentHash {
  std.content_hash.as_content_hash_structural(
    structural: fold(
      inputs,
      init: std.content_hash.content_hash_atom(value: "artifact_store.realization"),
      f: (acc, realization_input) => std.content_hash.content_hash_combine_structural(
        left: acc,
        right: artifact_realization_input_digest(realization_input: realization_input)
      )
    )
  )
}

fn artifact_key_hash(key: ArtifactKey) -> std.content_hash.ContentHash {
  std.content_hash.content_hash_tagged(
    tag: "artifact_store.key",
    payload: std.content_hash.content_hash_combine_structural(
      left: key.closure_digest,
      right: std.content_hash.content_hash_combine_structural(
        left: std.content_hash.content_hash_atom(value: key.emitter_identity),
        right: std.content_hash.content_hash_combine_structural(
          left: std.content_hash.content_hash_atom(value: key.target_language),
          right: std.content_hash.content_hash_atom(value: key.toolchain)
        )
      )
    )
  )
}

type ArtifactRow {
  key: std.content_hash.ContentHash
  artifact_bytes: std.measure.ByteSize
  last_use_ordinal: Int
}

type ArtifactStore {
  budget: std.measure.ByteSize
  next_ordinal: Int
  rows: List<ArtifactRow>
}

// EXACT CAUSES, not one carrier the caller must re-read. The remedies differ:
// a wrong UNIT means this provider is the wrong cache for a byte-budgeted
// store; an unresolved value means the deriving authority has to run first; an
// unobserved one needs a citation; an unsupported at-capacity action means the
// LRU realization below is not what that provider does.
type StoreRefusalCause
  = ProviderScopeReleased
  | ProviderCapacityUnbounded
  | ProviderCapacityUnobserved
  | CapacityUnitMismatch
  | CapacityValueUnobserved
  | CapacityValueUnresolved
  | StoreAtCapacityUnobserved
  | RefuseNewStoreUnsupported
  | ReplacementStrategyUnsupported

type StoreConstruction
  = StoreReady { store: ArtifactStore }
  | StoreRefusedRetention {
      provider_id: String,
      declared: std.cache_interface.ProviderRetention,
      cause: StoreRefusalCause
    }

// A persistent store needs BOTH halves: storage that outlives the provider's
// scope, AND a byte ceiling whose value is in hand. The budget is no longer a
// parameter, so a store cannot be built over a provider that never established
// the number it is being sized by.
fn store_over_provider(provider: std.materialization_ladder.CacheProvider) -> StoreConstruction {
  match provider.retention.release_policy {
    std.cache_interface.ReleasedAtProviderScopeExit => store_refused(provider: provider, cause: ProviderScopeReleased)
    std.cache_interface.ReleasedNever => store_from_capacity(provider: provider, c: provider.retention.capacity)
    std.cache_interface.ReleasedManually => store_from_capacity(provider: provider, c: provider.retention.capacity)
  }
}

fn store_refused(provider: std.materialization_ladder.CacheProvider, cause: StoreRefusalCause) -> StoreConstruction {
  StoreRefusedRetention {
    provider_id: provider.id,
    declared: provider.retention,
    cause: cause
  }
}

fn store_from_capacity(provider: std.materialization_ladder.CacheProvider, c: std.cache_interface.CapacityPolicy) -> StoreConstruction {
  match c {
    std.cache_interface.CapacityUnbounded => store_refused(provider: provider, cause: ProviderCapacityUnbounded)
    std.cache_interface.CapacityUnobserved => store_refused(provider: provider, cause: ProviderCapacityUnobserved)
    std.cache_interface.CapacityBounded { limit: l, at_capacity: action } =>
      match store_replacement_supported(action: action) {
        Present { value: cause } => store_refused(provider: provider, cause: cause)
        Absent => store_from_limit(provider: provider, l: l)
      }
  }
}

// THE REALIZATION BELOW IS LEAST-RECENTLY-USED, so it may only be built over a
// provider that says so. The former shape read at_capacity not at all and
// packed by LRU whatever the row declared.
fn store_replacement_supported(action: std.cache_interface.AtCapacityDisposition) -> StoreRefusalCause? {
  match action {
    std.cache_interface.AtCapacityUnobserved => Present { value: StoreAtCapacityUnobserved }
    std.cache_interface.RefuseNewStore => Present { value: RefuseNewStoreUnsupported }
    std.cache_interface.ReplaceExisting { strategy: s } => match s {
      std.cache_interface.LeastRecentlyUsed => none
      std.cache_interface.ProviderNativeReplacement => Present { value: ReplacementStrategyUnsupported }
    }
  }
}

fn store_from_limit(provider: std.materialization_ladder.CacheProvider, l: std.cache_interface.CapacityLimit) -> StoreConstruction {
  match l {
    std.cache_interface.EntryCountCapacity { limit: _ } => store_refused(provider: provider, cause: CapacityUnitMismatch)
    std.cache_interface.ByteCapacity { limit: v } => match v {
      std.cache_interface.ExactLimit { value: bytes } =>
        StoreReady { store: ArtifactStore { budget: bytes, next_ordinal: 1, rows: [] } }
      std.cache_interface.RuntimeDerivedLimit { authority: _ } =>
        store_refused(provider: provider, cause: CapacityValueUnresolved)
      std.cache_interface.EffectiveLimitUnobserved =>
        store_refused(provider: provider, cause: CapacityValueUnobserved)
    }
  }
}

type StoreLookup
  = StoreHit { store: ArtifactStore, row: ArtifactRow }
  | StoreMiss { store: ArtifactStore }

fn store_bytes_used(store: ArtifactStore) -> Int {
  fold(store.rows, init: 0, f: (acc, r) => acc + std.measure.measure_count(m: r.artifact_bytes))
}

fn store_get(store: ArtifactStore, key: std.content_hash.ContentHash) -> StoreLookup {
  match store.rows |> filter(r => r.key == key) |> first {
    Present { value: row } =>
      let bumped = ArtifactRow { key: row.key, artifact_bytes: row.artifact_bytes, last_use_ordinal: store.next_ordinal }
      StoreHit {
        store: ArtifactStore {
          budget: store.budget,
          next_ordinal: store.next_ordinal + 1,
          rows: concat(store.rows |> filter(r => (r.key == key) == false), [bumped])
        },
        row: bumped
      }
    Absent => StoreMiss { store: store }
  }
}

data no_evicted_keys: List<std.content_hash.ContentHash> = []

type StorePutReceipt {
  store: ArtifactStore
  evicted: List<std.content_hash.ContentHash>
}

fn least_recent_row(rows: List<ArtifactRow>) -> ArtifactRow? {
  match rows |> first {
    Present { value: seed } =>
      Present { value: fold(rows, init: seed, f: (best, r) => if r.last_use_ordinal < best.last_use_ordinal { r } else { best }) }
    Absent => none
  }
}

fn evict_until_within_budget(store: ArtifactStore, evicted: List<std.content_hash.ContentHash>) -> StorePutReceipt {
  if store_bytes_used(store: store) <= std.measure.measure_count(m: store.budget) {
    StorePutReceipt { store: store, evicted: evicted }
  } else {
    match least_recent_row(rows: store.rows) {
      Present { value: victim } =>
        evict_until_within_budget(
          store: ArtifactStore {
            budget: store.budget,
            next_ordinal: store.next_ordinal,
            rows: store.rows |> filter(r => (r.key == victim.key) == false)
          },
          evicted: concat(evicted, [victim.key])
        )
      Absent => StorePutReceipt { store: store, evicted: evicted }
    }
  }
}

data store_put_totality_note: String = "store_put is TOTAL over its two real outcomes, and the fit test runs BEFORE any eviction (operator scope call, 2026-07-29; reproduction receipt on PR 7385). The prior signature returned a StorePutReceipt unconditionally, which conflated two states that need opposite remedies: an artifact LARGER than the whole budget fell into the eviction loop, evicted every legitimate row, then evicted ITSELF (the fresh row carries the highest ordinal, so it is the last victim), and returned a receipt whose evicted list contained the key the caller had just put — indistinguishable at the type level from 'stored, and these older ones were evicted'. Measured: 500 bytes into a 100-byte budget holding one valid 40-byte row returned TWO evictions and an empty store, so an oversized put was not merely mislabelled, it was DESTRUCTIVE — it discarded valid cached entries and stored nothing while reporting success. The repair is construction, not a louder report (DESIGN section 5): the fit test precedes eviction, so the destructive path is unwritable rather than detected after the damage, and the two outcomes are distinct VALUES rather than one value whose fields the caller must interpret. Because artifact_bytes <= budget is established before the loop runs, the fresh row can never be its own victim — the self-eviction is gone by construction, not by a guard inside the loop."

type StorePutOutcome
  = StorePutAdmitted { store: ArtifactStore, evicted: List<std.content_hash.ContentHash> }
  | StorePutDidNotFit { artifact_bytes: std.measure.ByteSize, budget: std.measure.ByteSize }

fn store_put(store: ArtifactStore, key: std.content_hash.ContentHash, artifact_bytes: std.measure.ByteSize) -> StorePutOutcome {
  if std.measure.measure_count(m: artifact_bytes) > std.measure.measure_count(m: store.budget) {
    StorePutDidNotFit { artifact_bytes: artifact_bytes, budget: store.budget }
  } else {
    let fresh = ArtifactRow { key: key, artifact_bytes: artifact_bytes, last_use_ordinal: store.next_ordinal }
    let grown = ArtifactStore {
      budget: store.budget,
      next_ordinal: store.next_ordinal + 1,
      rows: concat(store.rows |> filter(r => (r.key == key) == false), [fresh])
    }
    let packed = evict_until_within_budget(store: grown, evicted: [])
    StorePutAdmitted { store: packed.store, evicted: packed.evicted }
  }
}

data store_put_reader_contract: std.disposition.Disposition = std.disposition.Terminal {
  reason: "store_put_fold is the only match over StorePutOutcome; the readers below derive from it and contain no match of their own, so a third outcome is a type error at exactly one site. There is deliberately NO store_put_store(outcome, fallback) projection — answering DidNotFit with a caller-supplied store is the absorbing fallback DESIGN section 5 forbids, and it is precisely what would let the destructive behavior this type exists to remove return in a new shape. Discriminating corpus: dag/test/claim/artifact_store_witness_test.dag."
}

fn store_put_fold<T>(
  outcome: StorePutOutcome,
  admitted: fn(ArtifactStore, List<std.content_hash.ContentHash>) -> T,
  did_not_fit: fn(std.measure.ByteSize, std.measure.ByteSize) -> T
) -> T {
  match outcome {
    StorePutAdmitted { store: s, evicted: e } => admitted(s, e)
    StorePutDidNotFit { artifact_bytes: a, budget: b } => did_not_fit(a, b)
  }
}

fn store_put_is_admitted(outcome: StorePutOutcome) -> Bool {
  store_put_fold(outcome: outcome, admitted: (s, e) => true, did_not_fit: (a, b) => false)
}

fn store_put_evicted_keys(outcome: StorePutOutcome) -> List<std.content_hash.ContentHash> {
  store_put_fold(outcome: outcome, admitted: (s, e) => e, did_not_fit: (a, b) => no_evicted_keys)
}
