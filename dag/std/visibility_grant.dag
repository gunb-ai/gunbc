module std.visibility_grant

import std.types { Bool, String, List }
import std.effect_grant {
  Verb, Reference, Publish,
  NamespacePosition, AudienceScopeTree,
  Grant, grant_coverage, grant_coverage_fold, position_under,
}

data visibility_grant_note: String = "P-A model for node/subtree visibility grants (docs/plans/node-subtree-visibility-grants.md, section 6). Reference and Publish are two readings of the existing (verb x subtree) Grant algebra, never a parallel permission mechanism. This module is PURE and changes no resolver, storage, or publication behavior. Reference asks whether a code-name edge may be formed. Publish asks whether source may inhabit an audience projection. Audience breadth is encoded as one fixed containment tree so the existing position_under/grant_covers fold remains the comparison authority. P-B supplies the first file-grain storage consumer; P-C later checks the composed graph."

fn world_audience() -> NamespacePosition {
  NamespacePosition { tree: AudienceScopeTree, path: [] }
}

fn network_audience() -> NamespacePosition {
  NamespacePosition { tree: AudienceScopeTree, path: ["network"] }
}

fn org_audience() -> NamespacePosition {
  NamespacePosition { tree: AudienceScopeTree, path: ["network", "org"] }
}

fn repo_audience() -> NamespacePosition {
  NamespacePosition { tree: AudienceScopeTree, path: ["network", "org", "repo"] }
}

type VisibilityStatus
  = LegacyOpen
  | Declared { grants: List<Grant> }

type NodeVisibility {
  node: NamespacePosition
  status: VisibilityStatus
}

fn declaring_container(node: NamespacePosition) -> NamespacePosition {
  NamespacePosition {
    tree: node.tree,
    path: if node.path.count() == 0 {
      []
    } else {
      node.path.take(n: node.path.count() - 1)
    }
  }
}

type ReferenceAdmission
  = ReferenceAdmitted
  | NameNotVisible { node: NamespacePosition, referrer: NamespacePosition }

fn visible_from(visibility: NodeVisibility, referrer: NamespacePosition) -> ReferenceAdmission {
  match visibility.status {
    LegacyOpen => ReferenceAdmitted
    Declared { grants: grants } => {
      let reference_granted = grant_coverage_fold(
        coverage: grant_coverage(grants: grants, verb: Reference, target: referrer),
        on_covered: fn(grant) { true },
        on_not_covered: fn(v, t) { false },
      )
      if position_under(target: referrer, root: declaring_container(node: visibility.node))
        || reference_granted {
        ReferenceAdmitted
      } else {
        NameNotVisible { node: visibility.node, referrer: referrer }
      }
    }
  }
}

type PublishAdmission
  = PublishAdmitted { node: NamespacePosition, audience: NamespacePosition }
  | PublishAudienceNotGranted { node: NamespacePosition, audience: NamespacePosition }

fn publish_to(visibility: NodeVisibility, audience: NamespacePosition) -> PublishAdmission {
  match visibility.status {
    LegacyOpen =>
      if position_under(target: audience, root: repo_audience()) {
        PublishAdmitted { node: visibility.node, audience: audience }
      } else {
        PublishAudienceNotGranted { node: visibility.node, audience: audience }
      }
    Declared { grants: grants } => {
      let publish_granted = grant_coverage_fold(
        coverage: grant_coverage(grants: grants, verb: Publish, target: audience),
        on_covered: fn(grant) { true },
        on_not_covered: fn(v, t) { false },
      )
      if publish_granted {
        PublishAdmitted { node: visibility.node, audience: audience }
      } else {
        PublishAudienceNotGranted { node: visibility.node, audience: audience }
      }
    }
  }
}

fn publish_admission_fold<T>(
  admission: PublishAdmission,
  on_admitted: fn(NamespacePosition, NamespacePosition) -> T,
  on_not_granted: fn(NamespacePosition, NamespacePosition) -> T,
) -> T {
  match admission {
    PublishAdmitted { node: node, audience: audience } => on_admitted(node, audience)
    PublishAudienceNotGranted { node: node, audience: audience } => on_not_granted(node, audience)
  }
}

type PublishAncestorVerdict
  = PublishAncestorCompatible
  | PublishAncestorNarrower {
      ancestor: NamespacePosition,
      child: NamespacePosition,
      audience: NamespacePosition,
    }

fn publish_ancestor_rule(
  ancestor: NodeVisibility,
  child: NodeVisibility,
  audience: NamespacePosition,
) -> PublishAncestorVerdict {
  let child_admitted = publish_admission_fold(
    admission: publish_to(visibility: child, audience: audience),
    on_admitted: fn(node, admitted_audience) { true },
    on_not_granted: fn(node, denied_audience) { false },
  )
  let ancestor_admitted = publish_admission_fold(
    admission: publish_to(visibility: ancestor, audience: audience),
    on_admitted: fn(node, admitted_audience) { true },
    on_not_granted: fn(node, denied_audience) { false },
  )
  if child_admitted && !ancestor_admitted {
    PublishAncestorNarrower {
      ancestor: ancestor.node,
      child: child.node,
      audience: audience,
    }
  } else {
    PublishAncestorCompatible
  }
}

type PublishClosureVerdict
  = PublishClosureClosed
  | PublishClosureGap {
      referrer: NamespacePosition,
      referenced: NamespacePosition,
      audience: NamespacePosition,
    }

fn publish_closure_rule(
  referrer: NodeVisibility,
  referenced: NodeVisibility,
  audience: NamespacePosition,
) -> PublishClosureVerdict {
  let referrer_admitted = publish_admission_fold(
    admission: publish_to(visibility: referrer, audience: audience),
    on_admitted: fn(node, admitted_audience) { true },
    on_not_granted: fn(node, denied_audience) { false },
  )
  let referenced_admitted = publish_admission_fold(
    admission: publish_to(visibility: referenced, audience: audience),
    on_admitted: fn(node, admitted_audience) { true },
    on_not_granted: fn(node, denied_audience) { false },
  )
  if referrer_admitted && !referenced_admitted {
    PublishClosureGap {
      referrer: referrer.node,
      referenced: referenced.node,
      audience: audience,
    }
  } else {
    PublishClosureClosed
  }
}
