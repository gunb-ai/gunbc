module std.occurrence_binding



data occurrence_binding_staged_adoption_scaffold_note: String = "STAGED ADOPTION: v1 and v2 execute over distinct Node algebras, so their shared occurrence-binding semantics must land here before either concrete Node instantiation. The next consumers are #7306/P1's fresh-successor v1 declaration-backed resolver instantiation, followed by the v2 resolver instantiation and its DependencyView BindsTo projection. LexicalLookup is not an interim consumer: it has no exact reference-occurrence Node or occurrence containment identity, so binding it here would fabricate the relation this carrier preserves."

type ContainmentPath<N> {
  ancestors: std.algebra.FreeMonoid<N>
  terminal: N
}

type BindingOccurrence<N> {
  containment: ContainmentPath<N>
}

type BindingCandidate<N> {
  containment: ContainmentPath<N>
}

type OccurrenceBinding<N> {
  occurrence: BindingOccurrence<N>
  candidate: BindingCandidate<N>
}

type AmbiguousBindingCandidates<N> {
  first: BindingCandidate<N>
  second: BindingCandidate<N>
  rest: std.algebra.FreeMonoid<BindingCandidate<N>>
}

type OccurrenceBindingResult<N>
  = OccurrenceBound { binding: OccurrenceBinding<N> }
  | OccurrenceUnbound { occurrence: BindingOccurrence<N> }
  | OccurrenceAmbiguous {
      occurrence: BindingOccurrence<N>
      candidates: AmbiguousBindingCandidates<N>
    }

type OccurrenceBindingFoldState<N>
  = OccurrenceBindingFoldZero
  | OccurrenceBindingFoldOne {
      first: BindingCandidate<N>
    }
  | OccurrenceBindingFoldMany {
      first: BindingCandidate<N>
      second: BindingCandidate<N>
      rest_reversed: std.algebra.FreeMonoid<BindingCandidate<N>>
    }

fn occurrence_binding_from_candidates<N>(
  occurrence: BindingOccurrence<N>,
  candidates: std.algebra.FreeMonoid<BindingCandidate<N>>
) -> OccurrenceBindingResult<N> {
  let state = fold(
    candidates,
    init: OccurrenceBindingFoldZero,
    f: (state, candidate) => match state {
      OccurrenceBindingFoldZero =>
        OccurrenceBindingFoldOne {
          first: candidate,
        }
      OccurrenceBindingFoldOne { first: first } =>
        OccurrenceBindingFoldMany {
          first: first,
          second: candidate,
          rest_reversed: std.algebra.Empty,
        }
      OccurrenceBindingFoldMany {
        first: first,
        second: second,
        rest_reversed: rest_reversed,
      } =>
        OccurrenceBindingFoldMany {
          first: first,
          second: second,
          rest_reversed: std.algebra.Cons {
            head: candidate,
            tail: rest_reversed,
          },
        }
    },
  )
  match state {
    OccurrenceBindingFoldZero =>
      OccurrenceUnbound {
        occurrence: occurrence,
      }
    OccurrenceBindingFoldOne { first: first } =>
      OccurrenceBound {
        binding: OccurrenceBinding {
          occurrence: occurrence,
          candidate: first,
        },
      }
    OccurrenceBindingFoldMany {
      first: first,
      second: second,
      rest_reversed: rest_reversed,
    } =>
      OccurrenceAmbiguous {
        occurrence: occurrence,
        candidates: AmbiguousBindingCandidates {
          first: first,
          second: second,
          rest: reverse(rest_reversed),
        },
      }
  }
}

data occurrence_binding_staged_adoption_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "DISSOLVE-ON: both production resolver paths consume OccurrenceBindingResult by execution — v1 emits declaration-backed occurrence bindings, and v2 emits the same result and derives DependencyView BindsTo from OccurrenceBound — then delete this staged-adoption scaffold note and this dissolution row.")
