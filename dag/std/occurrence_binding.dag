module std.occurrence_binding

import std.algebra { FreeMonoid }

type ContainmentPath<N> = FreeMonoid<N>

type BindingOccurrence<N> {
  node: N
  containment: ContainmentPath<N>
}

type BindingCandidate<N> {
  declaration: N
  containment: ContainmentPath<N>
}

type OccurrenceBinding<N> {
  occurrence: BindingOccurrence<N>
  candidate: BindingCandidate<N>
}

type OccurrenceBindingResult<N>
  = OccurrenceBound { binding: OccurrenceBinding<N> }
  | OccurrenceUnbound { occurrence: BindingOccurrence<N> }
  | OccurrenceAmbiguous {
      occurrence: BindingOccurrence<N>
      candidates: FreeMonoid<BindingCandidate<N>>
    }

fn occurrence_binding_from_candidates<N>(
  occurrence: BindingOccurrence<N>,
  candidates: FreeMonoid<BindingCandidate<N>>
) -> OccurrenceBindingResult<N> {
  fold(
    candidates,
    init: OccurrenceUnbound { occurrence: occurrence },
    f: (state, candidate) => match state {
      OccurrenceUnbound { occurrence: observed } =>
        OccurrenceBound {
          binding: OccurrenceBinding {
            occurrence: observed,
            candidate: candidate,
          },
        }
      OccurrenceBound { binding: observed } =>
        OccurrenceAmbiguous {
          occurrence: observed.occurrence,
          candidates: candidates,
        }
      OccurrenceAmbiguous {
        occurrence: observed,
        candidates: observed_candidates,
      } =>
        OccurrenceAmbiguous {
          occurrence: observed,
          candidates: observed_candidates,
        }
    },
  )
}
