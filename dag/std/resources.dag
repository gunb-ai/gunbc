module std.resources

import std.filesystem { FileClassification }
import std.types { Timestamp, FilePath, TextFilePath }
import std.integer { UInt8 }
import std.measure { ByteSize }

// WHAT A RESOURCE DECLARATION STATES ABOUT ITSELF: the closed values of its `kind:` and `mode:`
// entries. These are the homes the v2 lowering reads a declaration's entries against
// (v2.compiler.body_lowering_fold body_lower_resource_decl), so an unknown value refuses at its entry
// instead of riding as an unclassified name. A Capability is held and used; an Observation is read
// from the world without being held (Clock, Entropy).
type ResourceKind
  = Capability
  | Observation

type ResourceMode
  = Read
  | ReadWrite

type ResourceHandle {
  type: String
  resource_id: String
  key: String
  cap: Secret
}

resource Filesystem {
  kind: Capability
  mode: ReadWrite
  acquire {}
  release {}

  capability probe {
    input { path: FilePath }
    output { classification: FileClassification }
  }

  capability read {
    input { path: TextFilePath }
    output { content: String }
  }

  capability read_bytes {
    input { path: FilePath }
    output { content: Bytes }
  }

  capability write {
    input { path: FilePath, content: String }
    output { written: Bool }
  }
}

resource Network {
  kind: Capability
  mode: Read
  acquire {}
  release {}
}

resource Clock {
  kind: Observation
  mode: Read
  acquire { hermetic }
  release {}

  capability now {
    input {}
    output { timestamp: Timestamp }
  }

}

resource AuthContext {
  kind: Capability
  mode: Read
  expires: true
  acquire {

  }
  release {}
}

resource Entropy {
  kind: Observation
  mode: Read
  acquire {}
  release {}

  capability read_bytes {
    input { count: ByteSize }
    output { octets: List<UInt8> }
  }
}
