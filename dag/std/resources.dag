module std.resources

import std.filesystem { FileClassification }
import std.types { Timestamp, FilePath, TextFilePath }
import std.integer { UInt8 }
import std.measure { ByteSize }

type ResourceHandle {
  type: String
  resource_id: String
  key: String
  cap: Secret
}

resource Filesystem {
  kind: Capability
  mode: ReadWrite
  acquire {}
  release {}

  capability probe {
    input { path: FilePath }
    output { classification: FileClassification }
  }

  capability read {
    input { path: TextFilePath }
    output { content: String }
  }

  capability read_bytes {
    input { path: FilePath }
    output { content: Bytes }
  }

  capability write {
    input { path: FilePath, content: String }
    output { written: Bool }
  }
}

resource Network {
  kind: Capability
  mode: Read
  acquire {}
  release {}
}

resource Clock {
  kind: Observation
  mode: Read
  acquire { hermetic }
  release {}

  capability now {
    input {}
    output { timestamp: Timestamp }
  }

}

resource AuthContext {
  kind: Capability
  mode: Read
  expires: true
  acquire {

  }
  release {}
}

resource Entropy {
  kind: Observation
  mode: Read
  acquire {}
  release {}

  capability read_bytes {
    input { count: ByteSize }
    output { octets: List<UInt8> }
  }
}
