module std.resources


type ResourceHandle {
  type: String
  resource_id: String
  key: String
  cap: Secret
}

resource Filesystem {
  kind: Capability
  mode: ReadWrite
  acquire {}
  release {}

  capability probe {
    input { path: std.types.FilePath }
    output { classification: std.filesystem.FileClassification }
  }

  capability read {
    input { path: std.types.TextFilePath }
    output { content: String }
  }

  capability read_bytes {
    input { path: std.types.FilePath }
    output { content: Bytes }
  }

  capability write {
    input { path: std.types.FilePath, content: String }
    output { written: Bool }
  }
}

resource Network {
  kind: Capability
  mode: Read
  acquire {}
  release {}
}

resource Clock {
  kind: Observation
  mode: Read
  acquire { hermetic }
  release {}

  capability now {
    input {}
    output { timestamp: std.types.Timestamp }
  }

}

resource AuthContext {
  kind: Capability
  mode: Read
  expires: true
  acquire {

  }
  release {}
}

resource Entropy {
  kind: Observation
  mode: Read
  acquire {}
  release {}

  capability read_bytes {
    input { count: std.measure.ByteSize }
    output { octets: List<std.integer.UInt8> }
  }
}
