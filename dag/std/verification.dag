module std.verification


type NanosecondDuration = Measure<Time, Nano, Nat>

fn nanosecond_duration(count: Nat) -> NanosecondDuration {
  NanosecondDuration { count: count }
}

fn nanosecond_duration_count(d: NanosecondDuration) -> Nat {
  measure_count(m: d)
}

type AssertKind
  = AssertEqual
  | AssertTrue
  | AssertSome
  | AssertNone

type AssertionClaim {
  kind: AssertKind
  label: String
}

type TestCase {
  name: String
  claims: List<AssertionClaim>
  ignored: Bool
}

type TestNodeRef
  = TestCaseNode(TestCase)

type TestNodeCostDimension {
  node: TestNodeRef
  budget_time: NanosecondDuration
  measured_time: NanosecondDuration
}

fn test_node_cost_within_budget(fact: TestNodeCostDimension) -> Bool {
  nanosecond_duration_count(d: fact.measured_time) <= nanosecond_duration_count(d: fact.budget_time)
}
