module std.machine_shape


type DomainId = std.types.NonEmptyStr where brand("DomainId")
type LevelId = std.types.NonEmptyStr where brand("LevelId")

type MemoryLevel {
  id: std.machine_shape.LevelId
  capacity: std.measure.ByteSize
  transfer_grain: std.measure.ByteSize?
  bandwidth: std.measure.Bandwidth?
  latency: std.measure.Nanosecond?
}

type MemoryShape = List<std.machine_shape.MemoryLevel>

type LaneGrouping
  = IndependentLanes
  | Lockstep { group_width: std.measure.HardwareThreadCount }

type ExecutionShape {
  lane_count: std.measure.HardwareThreadCount
  grouping: std.machine_shape.LaneGrouping
}

type ExecutionDomain {
  id: std.machine_shape.DomainId
  execution: std.machine_shape.ExecutionShape
  memory: List<std.machine_shape.MemoryLevel>
}

type InterconnectLink {
  bandwidth: std.measure.Bandwidth
  latency: std.measure.Nanosecond?
}

type InterconnectEdge
  = LinkEdge { from: std.machine_shape.DomainId, to: std.machine_shape.DomainId, link: std.machine_shape.InterconnectLink }
  | SharedLevelEdge { owner: std.machine_shape.DomainId, sharer: std.machine_shape.DomainId, level: std.machine_shape.LevelId }

type MachineShape {
  domains: List<std.machine_shape.ExecutionDomain>
  edges: List<std.machine_shape.InterconnectEdge>
}

type MachineShapeRefusalCause
  = UnknownDomain { id: std.machine_shape.DomainId }
  | UnknownLevel { owner: std.machine_shape.DomainId, level: std.machine_shape.LevelId }

type MachineShapeConstruction
  = MachineShapeOk { shape: std.machine_shape.MachineShape }
  | MachineShapeRefused { cause: std.machine_shape.MachineShapeRefusalCause }

type MachineShapeValidationIndex {
  domain_ids: Map<std.machine_shape.DomainId, Bool>
  owner_levels: Map<std.machine_shape.DomainId, Map<std.machine_shape.LevelId, Bool>>
}

fn execution_shape_independent_lanes(lane_count: std.measure.HardwareThreadCount) -> std.machine_shape.ExecutionShape {
  ExecutionShape { lane_count: lane_count, grouping: IndependentLanes }
}

fn memory_level_id_index(levels: List<std.machine_shape.MemoryLevel>) -> std.types.Map<std.machine_shape.LevelId, Bool> {
  fold(levels, init: empty_map(), f: (acc, level) => map_insert(acc, level.id, true))
}

fn machine_shape_build_validation_index(domains: List<std.machine_shape.ExecutionDomain>) -> std.machine_shape.MachineShapeValidationIndex {
  fold(domains, init: std.machine_shape.MachineShapeValidationIndex { domain_ids: empty_map(), owner_levels: empty_map() }, f: (acc, domain) =>
    MachineShapeValidationIndex {
      domain_ids: map_insert(acc.domain_ids, domain.id, true)
      owner_levels: map_insert(acc.owner_levels, domain.id, memory_level_id_index(levels: domain.memory))
    })
}

fn machine_shape_validate_edge(index: std.machine_shape.MachineShapeValidationIndex, edge: std.machine_shape.InterconnectEdge) -> std.machine_shape.MachineShapeConstruction? {
  match edge {
    LinkEdge { from: from_id, to: to_id, link: _ } =>
      if !map_contains_key(index.domain_ids, from_id) {
        Present { value: MachineShapeRefused { cause: UnknownDomain { id: from_id } } }
      } else if !map_contains_key(index.domain_ids, to_id) {
        Present { value: MachineShapeRefused { cause: UnknownDomain { id: to_id } } }
      } else {
        none
      }
    SharedLevelEdge { owner: owner_id, sharer: sharer_id, level: level_id } =>
      if !map_contains_key(index.domain_ids, owner_id) {
        Present { value: MachineShapeRefused { cause: UnknownDomain { id: owner_id } } }
      } else if !map_contains_key(index.domain_ids, sharer_id) {
        Present { value: MachineShapeRefused { cause: UnknownDomain { id: sharer_id } } }
      } else {
        match map_get(index.owner_levels, owner_id) {
          Present { value: owner_level_index } =>
            if !map_contains_key(owner_level_index, level_id) {
              Present { value: MachineShapeRefused { cause: UnknownLevel { owner: owner_id, level: level_id } } }
            } else {
              none
            }
          Absent =>
            Present { value: MachineShapeRefused { cause: UnknownLevel { owner: owner_id, level: level_id } } }
        }
      }
  }
}

fn machine_shape_validate(shape: std.machine_shape.MachineShape) -> std.machine_shape.MachineShapeConstruction {
  let index = machine_shape_build_validation_index(domains: shape.domains)
  match fold(shape.edges, init: none, f: (refused, edge) =>
    match refused {
      Present { value: _ } => refused
      Absent => machine_shape_validate_edge(index: index, edge: edge)
    }) {
    Present { value: refused } => refused
    Absent => MachineShapeOk { shape: shape }
  }
}

fn machine_shape_is_single_domain(shape: std.machine_shape.MachineShape) -> Bool {
  list_length(items: shape.domains) == 1
}

fn machine_shape_domain_lane_count(shape: std.machine_shape.MachineShape) -> std.measure.HardwareThreadCount? {
  fold(shape.domains, init: Absent, f: (found, d) =>
    match found {
      Present { value: _ } => found
      Absent => Present { value: d.execution.lane_count }
    })
}

fn first_memory_level_capacity(levels: List<std.machine_shape.MemoryLevel>) -> std.measure.ByteSize? {
  fold(levels, init: Absent, f: (lvl_found, m) =>
    match lvl_found {
      Present { value: _ } => lvl_found
      Absent => Present { value: m.capacity }
    })
}

fn first_memory_level_bandwidth(levels: List<std.machine_shape.MemoryLevel>) -> std.measure.Bandwidth? {
  fold(levels, init: Absent, f: (lvl_found, m) =>
    match lvl_found {
      Present { value: _ } => lvl_found
      Absent => m.bandwidth
    })
}

fn machine_shape_device_level_capacity(shape: std.machine_shape.MachineShape) -> std.measure.ByteSize? {
  fold(shape.domains, init: Absent, f: (found, d) =>
    match found {
      Present { value: _ } => found
      Absent => first_memory_level_capacity(levels: d.memory)
    })
}

fn machine_shape_device_level_bandwidth(shape: std.machine_shape.MachineShape) -> std.measure.Bandwidth? {
  fold(shape.domains, init: Absent, f: (found, d) =>
    match found {
      Present { value: _ } => found
      Absent => first_memory_level_bandwidth(levels: d.memory)
    })
}
