module std.machine_shape

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.cache_identity { ExecutionReceiptDigest }
import std.disposition { Disposition, Scaffold, SingleAuthority }

type Estimate<T>
  = Exact { value: T }
  | Interval { lo: T, hi: T }

type Evidence
  = Cited { source: DeclarationRef }
  | MeasuredBy { receipt: ExecutionReceiptDigest }
  | DerivedFrom { derivation: DeclarationRef }

type Quantified<T>
  = Known { estimate: Estimate<T>, evidence: Evidence }
  | UnknownQuantity

data quantified_known_evidence_construction_wall: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.machine_shape",
    decl_name: "quantified_known",
    field: WholeDeclaration
  }
}

fn quantified_unknown<T>() -> Quantified<T> {
  UnknownQuantity
}

fn quantified_known<T>(estimate: Estimate<T>, evidence: Evidence) -> Quantified<T> {
  Known { estimate: estimate, evidence: evidence }
}

fn quantified_known_exact<T>(value: T, evidence: Evidence) -> Quantified<T> {
  quantified_known(estimate: Exact { value: value }, evidence: evidence)
}

fn quantified_known_interval<T>(lo: T, hi: T, evidence: Evidence) -> Quantified<T> {
  quantified_known(estimate: Interval { lo: lo, hi: hi }, evidence: evidence)
}

fn quantified_estimate<T>(q: Quantified<T>) -> Estimate<T>? {
  match q {
    UnknownQuantity => Absent
    Known { estimate: e, evidence: _ } => Present { value: e }
  }
}

fn quantified_evidence<T>(q: Quantified<T>) -> Evidence? {
  match q {
    UnknownQuantity => Absent
    Known { estimate: _, evidence: e } => Present { value: e }
  }
}

fn evidence_cited(source: DeclarationRef) -> Evidence {
  Cited { source: source }
}

fn evidence_measured_by(receipt: ExecutionReceiptDigest) -> Evidence {
  MeasuredBy { receipt: receipt }
}

fn evidence_derived_from(derivation: DeclarationRef) -> Evidence {
  DerivedFrom { derivation: derivation }
}
