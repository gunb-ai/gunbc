module std.pareto


type DominanceVerdict = Dominates | Dominated | Equivalent | Incomparable

type AxisGoal = HigherIsBetter | LowerIsBetter

type AxisComparison = Better | Same | Worse

fn compare_int(a: Int, b: Int) -> Ordering {
  if a < b { Less } else { if a > b { Greater } else { Equal } }
}

fn axis_comparison(goal: AxisGoal, value_order: Ordering) -> AxisComparison {
  match goal {
    HigherIsBetter => match value_order {
      Greater => Better
      Equal => Same
      Less => Worse
    }
    LowerIsBetter => match value_order {
      Greater => Worse
      Equal => Same
      Less => Better
    }
  }
}

fn axis_comparison_int(goal: AxisGoal, a: Int, b: Int) -> AxisComparison {
  axis_comparison(goal: goal, value_order: compare_int(a: a, b: b))
}

type DominanceTally { saw_better: Bool, saw_worse: Bool }

fn tally_step(acc: DominanceTally, cmp: AxisComparison) -> DominanceTally {
  match cmp {
    Better => DominanceTally { saw_better: true, saw_worse: acc.saw_worse }
    Worse => DominanceTally { saw_better: acc.saw_better, saw_worse: true }
    Same => acc
  }
}

fn tally_verdict(t: DominanceTally) -> DominanceVerdict {
  if t.saw_better {
    if t.saw_worse { Incomparable } else { Dominates }
  } else {
    if t.saw_worse { Dominated } else { Equivalent }
  }
}

fn dominance_of_comparisons(comparisons: List<AxisComparison>) -> DominanceVerdict {
  tally_verdict(
    t: fold(
      comparisons,
      init: DominanceTally { saw_better: false, saw_worse: false },
      f: (acc, c) => tally_step(acc: acc, cmp: c)
    )
  )
}

fn verdict_dominates(v: DominanceVerdict) -> Bool {
  match v {
    Dominates => true
    Dominated => false
    Equivalent => false
    Incomparable => false
  }
}

fn verdict_is_dominated(v: DominanceVerdict) -> Bool {
  match v {
    Dominated => true
    Dominates => false
    Equivalent => false
    Incomparable => false
  }
}

fn verdict_is_equivalent(v: DominanceVerdict) -> Bool {
  match v {
    Equivalent => true
    Dominates => false
    Dominated => false
    Incomparable => false
  }
}

fn verdict_is_incomparable(v: DominanceVerdict) -> Bool {
  match v {
    Incomparable => true
    Dominates => false
    Dominated => false
    Equivalent => false
  }
}

fn any_dominates(verdicts: List<DominanceVerdict>) -> Bool {
  fold(verdicts, init: false, f: (acc, v) => acc || verdict_dominates(v: v))
}

fn on_pareto_front(verdicts: List<DominanceVerdict>) -> Bool {
  !any_dominates(verdicts: verdicts)
}
