module std.pareto

import std.types { Int, List, NonEmptyStr }
import std.logic { Bool }
import std.algebra { Ordering }
import std.decl_ref { DeclarationRef, declaration_ref_eq, declaration_ref_display_key }
import std.interval { OrderedClosedInterval, interval_low, interval_high }

// EVIDENCE IS A REGION, AND A POINT IS THE DEGENERATE ONE. A reading used to be a single Int, which
// made every axis adjudicate: two candidates always compared Better, Same or Worse, whatever the
// measurement was actually worth. That is a total answer computed from evidence that does not
// support one, and its failure mode is the quiet kind -- a dominance verdict derived as if the axis
// were settled, indistinguishable downstream from one that was.
//
// So the two states this vocabulary could not previously tell apart are now separate. INCOMPARABLE
// means the evidence DECIDED a trade-off: better here, worse there, proven. UNDECIDED means the
// evidence is too coarse to say which way this axis goes at all. They have opposite remedies --
// accept the trade-off and choose on other grounds, versus go and measure more sharply -- and
// collapsing them into one word made the second look like the first.
type DominanceVerdict
  = Dominates
  | Dominated
  | Equivalent
  | Incomparable
  | DominanceUndecided

type AxisGoal = HigherIsBetter | LowerIsBetter

type AxisComparison = Better | Same | Worse | UndecidedOnEvidence

fn compare_int(a: Int, b: Int) -> Ordering {
  if a < b { Less } else { if a > b { Greater } else { Equal } }
}

// ORIENTATION IS SHARP AND STAYS SHARP. Turning a raw value order into a better/worse order is a
// total operation on a total relation -- it needs no evidence vocabulary, and a caller comparing
// exact quantities should not have to acquire one. So orientation answers in `Ordering`, the
// universal sharp relation, and AxisComparison is built ON it rather than instead of it.
//
// This exists because the alternative was measured and rejected: when AxisComparison widened to
// carry UndecidedOnEvidence, every sharp consumer matching on it inherited an arm its inputs cannot
// construct. product.fabric.contention is the live case -- its comparator comes from a total
// Ordering over exact rates -- and giving it an unreachable "evidence could not decide" arm would
// have been an unreachable state modeled ahead of any carrier that can produce it, which that
// module's own annotation already refuses to do for exactly this reason.
fn oriented_ordering(goal: AxisGoal, value_order: Ordering) -> Ordering {
  match goal {
    HigherIsBetter => value_order
    LowerIsBetter => match value_order {
      Greater => Less
      Equal => Equal
      Less => Greater
    }
  }
}

fn axis_comparison(goal: AxisGoal, value_order: Ordering) -> AxisComparison {
  match oriented_ordering(goal: goal, value_order: value_order) {
    Greater => Better
    Equal => Same
    Less => Worse
  }
}

fn axis_comparison_int(goal: AxisGoal, a: Int, b: Int) -> AxisComparison {
  axis_comparison(goal: goal, value_order: compare_int(a: a, b: b))
}

// SEPARATION IS THE ONLY THING THAT DECIDES AN AXIS. Two regions settle their order exactly when
// they do not touch: every value one could take beats every value the other could take. Anything
// else -- overlap, containment, a shared endpoint -- leaves at least one pair of true values that
// would order the other way, so the axis is undecided ON THIS EVIDENCE rather than equal.
//
// A SHARED BOUNDARY IS NOT SEPARATION. [10,20] against [20,30] admits both true values being
// exactly 20, so the strict comparison is the right one and the touching case falls through to
// undecided.
//
// IDENTICAL WIDE INTERVALS ARE NOT `Same`, and this is the case most easily got wrong. Two readings
// of [10,20] say both true values lie in one region; they do not say the true values are equal. Only
// the DEGENERATE interval carries that claim, because [x,x] admits exactly one value. Answering
// `Same` for equal wide regions would manufacture an equality the measurement never established.
fn intervals_are_equal_points(a: OrderedClosedInterval<Int>, b: OrderedClosedInterval<Int>) -> Bool {
  interval_low(interval: a) == interval_high(interval: a)
    && interval_low(interval: b) == interval_high(interval: b)
    && interval_low(interval: a) == interval_low(interval: b)
}

fn axis_comparison_interval(
  goal: AxisGoal,
  a: OrderedClosedInterval<Int>,
  b: OrderedClosedInterval<Int>,
) -> AxisComparison {
  if intervals_are_equal_points(a: a, b: b) {
    Same
  } else {
    if interval_high(interval: a) < interval_low(interval: b) {
      axis_comparison(goal: goal, value_order: Less)
    } else {
      if interval_high(interval: b) < interval_low(interval: a) {
        axis_comparison(goal: goal, value_order: Greater)
      } else {
        UndecidedOnEvidence
      }
    }
  }
}

// The tally carries WHETHER an axis was undecided, not WHICH. Naming the axes is a located
// diagnostic and belongs where axis identities are in scope -- the pair standing below, which folds
// over SelectionAxis. This layer is reached by callers holding bare comparisons with no identities
// at all (std.cache_interface compares exact reach counts), and giving the verdict a payload they
// cannot supply would force an empty list that reads as "undecided, naming nothing".
type DominanceTally { saw_better: Bool, saw_worse: Bool, saw_undecided: Bool }

fn tally_step(acc: DominanceTally, cmp: AxisComparison) -> DominanceTally {
  match cmp {
    Better => DominanceTally { saw_better: true, saw_worse: acc.saw_worse, saw_undecided: acc.saw_undecided }
    Worse => DominanceTally { saw_better: acc.saw_better, saw_worse: true, saw_undecided: acc.saw_undecided }
    Same => acc
    UndecidedOnEvidence => DominanceTally { saw_better: acc.saw_better, saw_worse: acc.saw_worse, saw_undecided: true }
  }
}

// A PROVEN TRADE-OFF OUTRANKS UNCERTAINTY ELSEWHERE, and this precedence is the load-bearing law of
// the new tally. Once one axis is known better and another known worse, the pair IS incomparable:
// no amount of sharpening a third axis can un-prove either of those two facts, so reporting
// "undecided" there would understate what the evidence already established and send someone to
// measure a question that is already answered.
//
// Everywhere else uncertainty wins, because an undecided axis could still fall either way and so
// could still change the conclusion. A one-sided advantage with an undecided axis beside it is NOT
// dominance -- the undecided axis might turn out worse -- and no observed difference at all with an
// undecided axis beside it is NOT equivalence, for the same reason in both directions.
fn tally_verdict(t: DominanceTally) -> DominanceVerdict {
  if t.saw_better && t.saw_worse {
    Incomparable
  } else {
    if t.saw_undecided {
      DominanceUndecided
    } else {
      if t.saw_better {
        Dominates
      } else {
        if t.saw_worse { Dominated } else { Equivalent }
      }
    }
  }
}

fn dominance_of_comparisons(comparisons: List<AxisComparison>) -> DominanceVerdict {
  tally_verdict(
    t: fold(
      comparisons,
      init: DominanceTally { saw_better: false, saw_worse: false, saw_undecided: false },
      f: (acc, c) => tally_step(acc: acc, cmp: c)
    )
  )
}

fn verdict_dominates(v: DominanceVerdict) -> Bool {
  match v {
    DominanceUndecided => false
    Dominates => true
    Dominated => false
    Equivalent => false
    Incomparable => false
  }
}

fn verdict_is_dominated(v: DominanceVerdict) -> Bool {
  match v {
    DominanceUndecided => false
    Dominated => true
    Dominates => false
    Equivalent => false
    Incomparable => false
  }
}

fn verdict_is_equivalent(v: DominanceVerdict) -> Bool {
  match v {
    DominanceUndecided => false
    Equivalent => true
    Dominates => false
    Dominated => false
    Incomparable => false
  }
}

fn verdict_is_incomparable(v: DominanceVerdict) -> Bool {
  match v {
    DominanceUndecided => false
    Incomparable => true
    Dominates => false
    Dominated => false
    Equivalent => false
  }
}

fn any_dominates(verdicts: List<DominanceVerdict>) -> Bool {
  fold(verdicts, init: false, f: (acc, v) => acc || verdict_dominates(v: v))
}

fn any_undecided(verdicts: List<DominanceVerdict>) -> Bool {
  fold(verdicts, init: false, f: (acc, v) => acc || match v {
    DominanceUndecided => true
    Dominates => false
    Dominated => false
    Equivalent => false
    Incomparable => false
  })
}

// on_pareto_front WAS HERE AND IS DELETED, for the reason pair_dominates was deleted above and now
// applies one layer out. It answered `!any_dominates`, which was total and correct while every
// verdict was decided -- but the moment a verdict can be DominanceUndecided, "nobody was shown to
// dominate me" stops meaning "I am on the front". A pool with one undecided comparison and no
// proven dominator answered `true`: on the frontier, asserted from evidence that established no
// such thing. That is the fail-open this change exists to close, so the Boolean is replaced by the
// three-state rather than patched, and a caller that wants a yes/no must first say what it intends
// to do about pending evidence.
type FrontStanding = OnFront | OffFront | FrontPendingEvidence

// Same precedence as the tally: a PROVEN dominator outranks uncertainty elsewhere. Being dominated
// is established by the dominating comparison alone, and no undecided axis in some other pairing
// can un-establish it.
fn front_standing(verdicts: List<DominanceVerdict>) -> FrontStanding {
  if any_dominates(verdicts: verdicts) {
    OffFront
  } else {
    if any_undecided(verdicts: verdicts) { FrontPendingEvidence } else { OnFront }
  }
}

// PARETO SELECTION OVER PARTIALLY OBSERVED EVIDENCE - the entry/field layer over the
// dominance kernel above (hoisted from the private strategy tree 2026-08-18, operator
// directive: the spine is a universal framework and its authority belongs here). A domain
// projects its candidates into ParetoEntry rows, one reading per funded axis, and gets
// standings back; the fold knows nothing about the domain.
//
// IDENTITY IS STRUCTURAL, NEVER A RENDERED LABEL (review ruling 2026-08-18): a candidate
// and an axis are each named by a DeclarationRef - the domain declaration the row projects -
// and display_label is presentation only. Two entries sharing a label still compare; a
// duplicate identity in the axes or the field REFUSES (a duplicate would otherwise be
// silently skipped as self-comparison or first-one-wins, the sentinel-through-presence-test
// shape), and no standing discriminant carries a label, so renaming one cannot move it.
//
// FAIL-CLOSED RULE, and the reason readings are looked up by axis identity rather than
// zipped by position: a reading that is absent - or duplicated - for a compared axis
// REFUSES the pair; the fold never compares the intersection, because surviving a partial
// comparison would be mistaken for surviving the question (the absorbing-fallback shape).
// A refusal outranks a domination WHEREVER either sits in the field: the field fold
// accumulates every challenge instead of latching the first, so the standing is invariant
// under candidate and axis reordering. Per-axis orientation is the AxisGoal vocabulary
// above; per-axis comparison is axis_comparison_int, so the selection layer adds partial
// observation and standings, never a second ordering.

type SelectionAxis {
  identity: DeclarationRef
  goal: AxisGoal
}

// The reading is the region the evidence supports. A sharp measurement is degenerate_interval(x)
// and carries the claim that the true value IS x; a coarse one carries a width and says so. There
// is no second sharp representation beside this one, because a point is already this one.
type AxisReading {
  axis: DeclarationRef
  interval_micro: OrderedClosedInterval<Int>
}

// One candidate as the spine sees it: a structural identity, a display label, its
// funded-axis readings, and the inputs it is missing. A nonempty missing_inputs list makes
// the entry incomparable BY ITS OWN declaration - the projector states what is absent
// instead of substituting a zero or an average, the same rule the node-build model already
// enforces for missing rates.
type ParetoEntry {
  identity: DeclarationRef
  display_label: NonEmptyStr
  readings: List<AxisReading>
  missing_inputs: List<NonEmptyStr>
}

type Domination {
  candidate: DeclarationRef
  winning_axes: List<DeclarationRef>
}

// IncomparablePendingEvidence IS SPLIT IN TWO HERE, and the split matters more than the rename that
// prompted it. The old arm already carried two states -- a subject with declared missing inputs, and
// a comparison that REFUSED because an entry claimed complete inputs while lacking a reading -- and
// folding overlapping readings in beside them would have made three. They are not one answer:
//
//   NotComputable  - the SUBJECT honestly declares an input it does not have. Nothing is broken:
//                    the projector said what is absent instead of substituting a zero. The remedy
//                    is to supply the input, and until then no standing is derivable.
//   PendingEvidence - a standing WAS derived and it is "not established either way". Every reading
//                    is present and consistent; they are simply too coarse to separate. The remedy
//                    is to measure more sharply, and the answer may legitimately stay this way.
//
// A THIRD STATE WAS HIDING IN THE OLD ARM AND IS ROUTED OUT OF IT ENTIRELY. An entry that declares
// COMPLETE inputs while lacking a funded-axis reading is not missing evidence -- it is evidence
// contradicting its own declaration, a projector defect. That belongs with the other structural
// contradictions in SelectionRefused, which already means "the selection inputs contradict their
// own contract", and NOT beside an honest declaration of absence. Keeping it in NotComputable made
// a defect and a truthful report share one arm, so no consumer could act differently on them.
//
// The old name also said "Incomparable" about a standing that is precisely NOT a comparison result,
// which is the fork the rename closes: Incomparable now means only what the verdict means by it, a
// trade-off the evidence proved.
type ParetoStanding
  = ProvisionallyNonDominated { sensitivities: List<NonEmptyStr> }
  | DominatedBy { dominators: List<Domination> }
  | NotComputable { missing: NonEmptyStr }
  | PendingEvidence { undecided: NonEmptyStr }
  | SelectionRefused { cause: NonEmptyStr }

type ReadingLookup
  = ReadingFound { interval_micro: OrderedClosedInterval<Int> }
  | ReadingAbsent { absent_axis: DeclarationRef }
  | ReadingDuplicated { duplicated_axis: DeclarationRef }

// PairEvidenceIncomplete IS NOT PairNoDominance AND IS NOT PairRefused, and keeping the three apart
// is the whole point of this arm. A candidate that DECLARES a gap has not been shown not to
// dominate - nothing was shown about it at all - and it is not malformed either: declaring your
// missing inputs is the honest thing the spine asks for. It is simply not ELIGIBLE to be shown
// dominating anyone, because dominance is a claim over evidence it says it does not have.
//
// Without this arm compare_pair answered the dominance question while ignoring missing_inputs
// entirely, so it could return PairDominates for a candidate whose own standing is NotComputable -
// and entry_standing disagreed with it, because challenger_applies excluded exactly those
// challengers. Two answers to one question, with the exported one permissive.
type PairStanding
  = PairDominates { winning_axes: List<DeclarationRef> }
  | PairNoDominance
  | PairPendingEvidence { undecided_axes: List<DeclarationRef> }
  | PairEvidenceIncomplete { missing: NonEmptyStr }
  | PairRefused { cause: NonEmptyStr }

fn reading_matches(e: ParetoEntry, wanted: DeclarationRef) -> Int {
  fold(e.readings, init: 0, f: fn(acc, r) {
    if declaration_ref_eq(a: r.axis, b: wanted) { acc + 1 } else { acc }
  })
}

fn reading_for(e: ParetoEntry, wanted: DeclarationRef) -> ReadingLookup {
  let matches = reading_matches(e: e, wanted: wanted)
  if matches > 1 {
    ReadingDuplicated { duplicated_axis: wanted }
  } else {
    fold(e.readings, init: ReadingAbsent { absent_axis: wanted }, f: fn(acc, r) {
      match acc {
        ReadingFound { interval_micro } => acc,
        ReadingDuplicated { duplicated_axis } => acc,
        ReadingAbsent { absent_axis } =>
          if declaration_ref_eq(a: r.axis, b: absent_axis) { ReadingFound { interval_micro: r.interval_micro } } else { acc },
      }
    })
  }
}

// The per-pair accumulator: refusal_causes collects axes where either side has no reading
// (or a duplicated one), a_worse_somewhere kills dominance, winning_axes names where a is
// strictly better.
type PairAccum {
  refusal_causes: List<NonEmptyStr>
  a_worse_somewhere: Bool
  winning_axes: List<DeclarationRef>
  undecided_axes: List<DeclarationRef>
}

data no_names: List<NonEmptyStr> = []
data no_axis_ids: List<DeclarationRef> = []
data no_dominators: List<Domination> = []

fn one_name(name: NonEmptyStr) -> List<NonEmptyStr> { [name] }

fn one_axis_id(id: DeclarationRef) -> List<DeclarationRef> { [id] }

fn accum_refusal(acc: PairAccum, axis: SelectionAxis, defect: NonEmptyStr) -> PairAccum {
  PairAccum {
    refusal_causes: concat(acc.refusal_causes, one_name(name: join(["axis ", declaration_ref_display_key(ref: axis.identity), " ", defect], ""))),
    a_worse_somewhere: acc.a_worse_somewhere,
    winning_axes: acc.winning_axes,
    undecided_axes: acc.undecided_axes,
  }
}

fn accum_both_read(
  acc: PairAccum,
  axis: SelectionAxis,
  a_interval: OrderedClosedInterval<Int>,
  b_interval: OrderedClosedInterval<Int>,
) -> PairAccum {
  match axis_comparison_interval(goal: axis.goal, a: a_interval, b: b_interval) {
    Better => PairAccum {
      refusal_causes: acc.refusal_causes,
      a_worse_somewhere: acc.a_worse_somewhere,
      winning_axes: concat(acc.winning_axes, one_axis_id(id: axis.identity)),
      undecided_axes: acc.undecided_axes,
    },
    Worse => PairAccum {
      refusal_causes: acc.refusal_causes,
      a_worse_somewhere: true,
      winning_axes: acc.winning_axes,
      undecided_axes: acc.undecided_axes,
    },
    Same => acc,
    UndecidedOnEvidence => PairAccum {
      refusal_causes: acc.refusal_causes,
      a_worse_somewhere: acc.a_worse_somewhere,
      winning_axes: acc.winning_axes,
      undecided_axes: concat(acc.undecided_axes, one_axis_id(id: axis.identity)),
    },
  }
}

fn accum_with_a(acc: PairAccum, axis: SelectionAxis, a_interval: OrderedClosedInterval<Int>, b_read: ReadingLookup) -> PairAccum {
  match b_read {
    ReadingAbsent { absent_axis } => accum_refusal(acc: acc, axis: axis, defect: "has no reading on one side"),
    ReadingDuplicated { duplicated_axis } => accum_refusal(acc: acc, axis: axis, defect: "has duplicate readings on one side"),
    ReadingFound { interval_micro } => accum_both_read(acc: acc, axis: axis, a_interval: a_interval, b_interval: interval_micro),
  }
}

fn axis_pair_step(acc: PairAccum, axis: SelectionAxis, a: ParetoEntry, b: ParetoEntry) -> PairAccum {
  let a_read = reading_for(e: a, wanted: axis.identity)
  match a_read {
    ReadingAbsent { absent_axis } => accum_refusal(acc: acc, axis: axis, defect: "has no reading on one side"),
    ReadingDuplicated { duplicated_axis } => accum_refusal(acc: acc, axis: axis, defect: "has duplicate readings on one side"),
    ReadingFound { interval_micro } => accum_with_a(acc: acc, axis: axis, a_interval: interval_micro, b_read: reading_for(e: b, wanted: axis.identity)),
  }
}

// THE DIRECTIONAL PATH IS NOT THE SYMMETRIC ONE, and the difference is deliberate. This asks only
// "does a dominate b", so a challenger KNOWN WORSE on any axis has already lost the question --
// sharpening an undecided axis cannot make it dominate, because dominance requires no worse axis at
// all. That stays ordinary PairNoDominance rather than being promoted to pending: reporting it as
// pending would send someone to measure a question whose answer cannot change the outcome.
//
// Only a challenger with NO known worse axis and at least one undecided axis is genuinely pending:
// there, sharpening the undecided axis really can decide it either way.
fn pair_from_accum(folded: PairAccum) -> PairStanding {
  if count(folded.refusal_causes) > 0 {
    PairRefused { cause: join(folded.refusal_causes, " ; ") }
  } else {
    if folded.a_worse_somewhere {
      PairNoDominance
    } else {
      if count(folded.undecided_axes) > 0 {
        PairPendingEvidence { undecided_axes: folded.undecided_axes }
      } else {
        if count(folded.winning_axes) > 0 { PairDominates { winning_axes: folded.winning_axes } } else { PairNoDominance }
      }
    }
  }
}

// THE DECLARED GAPS ARE READ BEFORE ANY AXIS IS. This check used to live only in
// challenger_applies, one layer up, so a caller reaching compare_pair directly got a dominance
// verdict computed from readings while the entry's own declaration said its inputs were incomplete.
// Measured on the private node-build field: a board declaring unproven supply depth was reported
// DOMINATING a peer at the low memory price, while entry_standing reported it NotComputable.
//
// Either side's gap makes the question unanswerable, not answerable-in-the-negative: a is not
// eligible to be shown dominating, and a b that cannot be evaluated cannot be shown dominated.
fn declared_gap_cause(a: ParetoEntry, b: ParetoEntry) -> List<NonEmptyStr> {
  let from_a = if count(a.missing_inputs) > 0 {
    one_name(name: join([declaration_ref_display_key(ref: a.identity), " declares missing inputs, so it is not eligible to be shown dominating: ", join(a.missing_inputs, " ; ")], ""))
  } else { no_names }
  let from_b = if count(b.missing_inputs) > 0 {
    one_name(name: join([declaration_ref_display_key(ref: b.identity), " declares missing inputs, so it cannot be shown dominated: ", join(b.missing_inputs, " ; ")], ""))
  } else { no_names }
  concat(from_a, from_b)
}

// MALFORMED BEATS INCOMPLETE, AND THE SHARED FUNCTION IS THE WHOLE POINT - compare_pair and
// field_contradictions consume ONE projector-contradiction reader, entry_contradicts_its_declaration,
// so the two paths cannot answer differently about the same evidence. That reader exempts an ABSENT
// reading when the entry declares its gaps, and pointedly does NOT exempt a DUPLICATE: two readings
// on one axis identity is malformed evidence whatever else the entry declares, because the spine
// would have to pick one.
//
// duplicate_reading_causes WAS HERE AND IS DELETED (2026-09-02). It was a second, weaker copy of
// that reader - identical duplicate arm, right down to the message string, with the absent arm
// dropped - and a second authority for one question is the §3 violation whichever copy is wrong.
// This one was wrong in a specific way: an entry declaring complete inputs while missing a funded
// reading is a projector defect the field path refuses as SelectionRefused, but the pair path never
// reached its axis fold to see it, because an HONEST declared gap on the OTHER operand
// short-circuited first. So malformed evidence on one entry was masked by truthful incompleteness on
// its opponent - the same masking review 58743 caught one arm earlier, surviving in the arm that
// review did not name. Reported on review 5091604216, which was right.
//
// The precedence now falls out of the shared reader rather than being restated here: projector
// contradiction (duplicate anywhere, or absent-while-declaring-complete) > honest declared
// incompleteness > ordinary axis comparison.
fn compare_pair(a: ParetoEntry, b: ParetoEntry, axes: List<SelectionAxis>) -> PairStanding {
  let malformed = concat(entry_contradicts_its_declaration(e: a, axes: axes), entry_contradicts_its_declaration(e: b, axes: axes))
  if count(malformed) > 0 {
    PairRefused { cause: join(malformed, " ; ") }
  } else {
    let gaps = declared_gap_cause(a: a, b: b)
    if count(gaps) > 0 {
      PairEvidenceIncomplete { missing: join(gaps, " ; ") }
    } else {
      pair_from_accum(folded: fold(axes, init: PairAccum { refusal_causes: no_names, a_worse_somewhere: false, winning_axes: no_axis_ids, undecided_axes: no_axis_ids }, f: fn(acc, axis) {
        axis_pair_step(acc: acc, axis: axis, a: a, b: b)
      }))
    }
  }
}

// pair_dominates WAS HERE AND IS DELETED (2026-08-19). It answered Bool over
// the three-state PairStanding, and its PairRefused arm answered false — so a
// consumer asking the cheap Boolean question read MALFORMED EVIDENCE as
// ordinary non-dominance, which is the state-space conflation this spine's
// whole design exists to refuse one layer up. Giving it a typed three-state
// would have made it compare_pair with a different name, so it is deleted
// rather than repaired: the standing path is the only path, and a caller that
// wants a Boolean must first say what it intends to do about a refusal.

// Duplicate-identity refusals: an axis roster or a candidate field carrying one identity
// twice REFUSES the whole selection, because the fold would otherwise resolve the collision
// silently (first-reading-wins for axes, skipped-as-self for candidates).
fn count_axis_identity(axes: List<SelectionAxis>, id: DeclarationRef) -> Int {
  fold(axes, init: 0, f: fn(acc, ax) { if declaration_ref_eq(a: ax.identity, b: id) { acc + 1 } else { acc } })
}

fn axes_have_duplicate_identity(axes: List<SelectionAxis>) -> Bool {
  fold(axes, init: false, f: fn(acc, ax) { acc || count_axis_identity(axes: axes, id: ax.identity) > 1 })
}

fn count_entry_identity(field: List<ParetoEntry>, id: DeclarationRef) -> Int {
  fold(field, init: 0, f: fn(acc, e) { if declaration_ref_eq(a: e.identity, b: id) { acc + 1 } else { acc } })
}

fn field_has_duplicate_identity(field: List<ParetoEntry>) -> Bool {
  fold(field, init: false, f: fn(acc, e) { acc || count_entry_identity(field: field, id: e.identity) > 1 })
}

// A challenger participates only when it is a DIFFERENT candidate (by identity, never by
// label) that declares complete inputs.
// A CONTRADICTION IS A PROPERTY OF ONE ENTRY, NOT OF A PAIRING, so it is found by scanning the
// field rather than by whichever comparison happened to trip over it. Deriving it pairwise made the
// diagnostic name the innocent side as often as the guilty one, and made a subject that honestly
// declares a missing input generate refusals ABOUT ITSELF the moment anything was compared to it.
// THE EXEMPTION IS PER DEFECT CLASS, NOT PER ENTRY, and getting that wrong was a fail-open. An
// entry declaring missing inputs has explained why a reading is ABSENT -- that is the truth it told,
// and holding an absence against it would punish the honest declaration. It has explained nothing
// about a DUPLICATE. Two readings on one axis identity is malformed evidence whatever else the entry
// declares: the spine would have to pick one, which is the first-one-wins accident the duplicate
// rule exists to refuse. Exempting the whole entry let a duplicate ride in behind an unrelated
// declared gap and surface as NotComputable -- a projector defect wearing the report of an honest
// one, which is exactly the conflation this split was made to end.
fn entry_contradicts_its_declaration(e: ParetoEntry, axes: List<SelectionAxis>) -> List<NonEmptyStr> {
  let declares_its_gaps = count(e.missing_inputs) > 0
  fold(axes, init: no_names, f: fn(acc, ax) {
    match reading_for(e: e, wanted: ax.identity) {
      ReadingFound { interval_micro } => acc
      ReadingAbsent { absent_axis } =>
        if declares_its_gaps {
          acc
        } else {
          concat(acc, one_name(name: join([
            declaration_ref_display_key(ref: e.identity),
            " declares complete inputs but has no reading on funded axis ",
            declaration_ref_display_key(ref: absent_axis)], "")))
        }
      ReadingDuplicated { duplicated_axis } => concat(acc, one_name(name: join([
        declaration_ref_display_key(ref: e.identity),
        " has duplicate readings on funded axis ",
        declaration_ref_display_key(ref: duplicated_axis)], "")))
    }
  })
}

fn field_contradictions(field: List<ParetoEntry>, axes: List<SelectionAxis>) -> List<NonEmptyStr> {
  fold(field, init: no_names, f: fn(acc, e) {
    concat(acc, entry_contradicts_its_declaration(e: e, axes: axes))
  })
}

// ONE AUTHORITY FOR ELIGIBILITY, NOW THAT compare_pair CARRIES IT. This used to restate the
// gap rule beside compare_pair's silence about it; the rule lives in compare_pair, and the fold
// below reads its PairEvidenceIncomplete arm. All that is left here is the self-comparison guard,
// which is about identity rather than evidence.
fn challenger_applies(subject: ParetoEntry, other: ParetoEntry) -> Bool {
  !declaration_ref_eq(a: other.identity, b: subject.identity)
}

// The field accumulator: every refusal and every dominator is collected, so the derived
// standing cannot depend on which challenger the fold happened to visit first.
type FieldAccum {
  refusal_causes: List<NonEmptyStr>
  dominators: List<Domination>
  pending_causes: List<NonEmptyStr>
}

fn one_domination(d: Domination) -> List<Domination> { [d] }

fn field_step(subject: ParetoEntry, other: ParetoEntry, axes: List<SelectionAxis>, acc: FieldAccum) -> FieldAccum {
  if challenger_applies(subject: subject, other: other) {
    match compare_pair(a: other, b: subject, axes: axes) {
      PairDominates { winning_axes } => FieldAccum {
        refusal_causes: acc.refusal_causes,
        dominators: concat(acc.dominators, one_domination(d: Domination { candidate: other.identity, winning_axes: winning_axes })),
        pending_causes: acc.pending_causes,
      },
      PairNoDominance => acc,
      PairPendingEvidence { undecided_axes } => FieldAccum {
        refusal_causes: acc.refusal_causes,
        dominators: acc.dominators,
        pending_causes: concat(acc.pending_causes, one_name(name: join([
          "challenger ", declaration_ref_display_key(ref: other.identity),
          " is not shown either way on ",
          join(fold(undecided_axes, init: no_names, f: fn(a2, ax) { concat(a2, one_name(name: declaration_ref_display_key(ref: ax))) }), ", "),
          " - the readings overlap, so whether it dominates is undecided on this evidence"], ""))),
      },
      PairEvidenceIncomplete { missing } => acc,
      PairRefused { cause } => FieldAccum {
        refusal_causes: concat(acc.refusal_causes, one_name(name: join(["comparison against ", declaration_ref_display_key(ref: other.identity), " refused - ", cause, " - a field entry lacking a funded-axis reading while declaring complete inputs is a projector contradiction, and no standing in its field is computable until it is fixed"], ""))),
        dominators: acc.dominators,
        pending_causes: acc.pending_causes,
      },
    }
  } else { acc }
}

// THE FULL FIELD PRECEDENCE, and the order is the whole safety argument:
//
//   malformed evidence  >  subject not computable  >  proven domination
//                       >  pending interval evidence  >  provisionally non-dominated
//
// Malformed evidence stays FIRST and outranks even a proven domination, which is the pre-existing
// fail-closed rule and is deliberately not weakened here: if the field contradicts its own
// declaration, the domination was computed from evidence that cannot be trusted to mean what it
// says, so it is not a result to report. "Proven domination outranks pending" is a law about the
// NEW interval-pending state only, and applying it one step higher would have quietly demoted the
// malformed-evidence wall.
//
// Below that it is the tally law at field grain: a proven dominator settles the standing, because
// being dominated is established by that one comparison and no undecided pairing elsewhere can
// un-establish it. Only when nothing dominates does pending evidence decide -- and there it MUST,
// because "no proven dominator" is not "on the frontier" when a challenger's comparison never
// resolved.
fn standing_from_accum(folded: FieldAccum, sensitivities: List<NonEmptyStr>) -> ParetoStanding {
  if count(folded.refusal_causes) > 0 {
    SelectionRefused { cause: join(folded.refusal_causes, " ; ") }
  } else {
    if count(folded.dominators) > 0 {
      DominatedBy { dominators: folded.dominators }
    } else {
      if count(folded.pending_causes) > 0 {
        PendingEvidence { undecided: join(folded.pending_causes, " ; ") }
      } else {
        ProvisionallyNonDominated { sensitivities: sensitivities }
      }
    }
  }
}

// THE SUBJECT IS SCANNED EXACTLY ONCE, WHETHER OR NOT IT SITS IN THE FIELD. Callers normally pass
// a field that already contains the subject, so appending it unconditionally scanned it twice and
// emitted its contradiction twice in one cause string -- a diagnostic that overstates how many
// things are wrong, which is its own small dishonesty in a message a human reads to decide what to
// repair. Membership is decided on IDENTITY through the same counter the duplicate-identity refusal
// uses, not by position or by trusting the caller's convention.
fn scanned_population(subject: ParetoEntry, field: List<ParetoEntry>) -> List<ParetoEntry> {
  if count_entry_identity(field: field, id: subject.identity) > 0 {
    field
  } else {
    concat(field, [subject])
  }
}

// The contradiction scan runs BEFORE the subject's own missing-input check, because a field that
// lies about its completeness invalidates every standing derived in it -- including the honest
// report that this particular subject is short an input.
fn entry_standing(subject: ParetoEntry, field: List<ParetoEntry>, axes: List<SelectionAxis>, sensitivities: List<NonEmptyStr>) -> ParetoStanding {
  if axes_have_duplicate_identity(axes: axes) {
    SelectionRefused { cause: "two selection axes share one identity - a duplicate axis would resolve first-one-wins, so the selection refuses" }
  } else {
    if field_has_duplicate_identity(field: field) {
      SelectionRefused { cause: "two field entries share one candidate identity - a duplicate would be skipped as self-comparison, so the selection refuses" }
    } else {
      let contradictions = field_contradictions(field: scanned_population(subject: subject, field: field), axes: axes)
      if count(contradictions) > 0 {
        SelectionRefused { cause: join(contradictions, " ; ") }
      } else {
      if count(subject.missing_inputs) > 0 {
        NotComputable { missing: join(subject.missing_inputs, " ; ") }
      } else {
        standing_from_accum(
          folded: fold(field, init: FieldAccum { refusal_causes: no_names, dominators: no_dominators, pending_causes: no_names }, f: fn(acc, other) {
            field_step(subject: subject, other: other, axes: axes, acc: acc)
          }),
          sensitivities: sensitivities,
        )
      }
      }
    }
  }
}

fn dominator_names(dominators: List<Domination>) -> List<NonEmptyStr> {
  fold(dominators, init: no_names, f: fn(acc, d) { concat(acc, one_name(name: declaration_ref_display_key(ref: d.candidate))) })
}

fn pareto_label(s: ParetoStanding) -> NonEmptyStr {
  match s {
    ProvisionallyNonDominated { sensitivities } => "on the frontier",
    DominatedBy { dominators } => join(["dominated by ", join(dominator_names(dominators: dominators), ", ")], ""),
    NotComputable { missing } => "not computable",
    PendingEvidence { undecided } => "pending evidence",
    SelectionRefused { cause } => "selection refused",
  }
}
