fn completeness_missing(c: ArtifactCompleteness) -> List<ArtifactOutputId> {
  match c {
    ArtifactComplete => no_output_ids
    ArtifactMissingOutputs { missing: m } => m
  }
}

fn completeness_is_complete(c: ArtifactCompleteness) -> Bool {
  completeness_missing(c: c).count() == 0
}
