module std.observation


data observation_module_note: String = "P0 of the progress-and-observation lane (docs/plans/progress-observation-design.md, operator-signed 2026-07-23; CI-rework delta in that doc section 6b). One event vocabulary emitted by the process and consumed by every renderer — a progress line is a PROJECTION of a fact the process already has, never a hand-authored string with a hand-chosen level. This module carries the model, the five laws as rows, and the derived attention/presentation assignment; it renders nothing (renderers are P1 and later). Displaced cost priced in the design doc: the 10-minute silent crawl window of run 30044816605, a 55-minute triage cycle burned on a receipt that only wrote at walk end, and workers hand-rolling the discipline ad hoc."

// Naming diligence (DESIGN section 3): std.upsert_decision.ObservationVerdict is a DIFFERENT concept that shares the word — it classifies a desired-versus-observed STATE for reconcile/upsert (Converged, Drifted, Conflict). This module observes a PROCESS advancing through time. Neither is a nickname for the other; they are not to be consolidated. The distinguishing question: upsert asks what is true of the world, observation asks how far the work has got.
type ObservationSegment
  = RunSegment { id: std.types.NonEmptyStr }
  | BatchSegment { index: std.nat.Nat, label: std.types.NonEmptyStr }
  | EntrySegment { source_path: std.types.NonEmptyStr }
  | ModuleSegment { module_path: std.types.NonEmptyStr }
  | DeclarationSegment { declaration: std.decl_ref.DeclarationRef }
  | PhaseSegment { name: std.types.NonEmptyStr }

data observation_segment_grounding_note: String = "The subject is a CONTAINMENT PATH — run contains batch contains entry contains module contains declaration contains phase, the tree the floor already walks — decomposed into typed segments rather than carried as one opaque string (DESIGN section 2 deep decomposition). DeclarationSegment carries std.decl_ref.DeclarationRef (already imported), the single declaration-identity authority — never a parallel function String. Two other segments name identities other authorities own, and are carried here in the same representation std already uses for them, not in a fresh one: module_path matches DeclarationRef.module_path, and source_path is a repo-relative source path. Convergence, not fork: module_path becomes v2.std.qualified_name.QualifiedName and source_path becomes the typed SourceRef when the namespace and module-identity lanes land those carriers (DESIGN open threads). Until then the representation is std's existing one, so there is nothing new to migrate."

type ObservationSubject {
  segments: List<ObservationSegment>
}

fn observation_decl_field_key(field: std.decl_ref.DeclField) -> String {
  match field {
    WholeDeclaration => "whole"
    NamedField { field_name: f } => concat("field=", f)
  }
}

fn observation_declaration_key(d: std.decl_ref.DeclarationRef) -> String {
  concat(
    "decl=",
    concat(
      d.module_path,
      concat("::", concat(d.decl_name, concat("#", observation_decl_field_key(field: d.field))))
    )
  )
}

fn observation_segment_key(seg: ObservationSegment) -> String {
  match seg {
    RunSegment { id: i } => concat("run=", i)
    BatchSegment { index: n, label: l } => concat("batch=", concat(to_string(n), concat(":", l)))
    EntrySegment { source_path: p } => concat("entry=", p)
    ModuleSegment { module_path: m } => concat("module=", m)
    DeclarationSegment { declaration: d } => observation_declaration_key(d: d)
    PhaseSegment { name: n } => concat("phase=", n)
  }
}

fn observation_subject_path(subject: ObservationSubject) -> List<String> {
  map(subject.segments, seg => observation_segment_key(seg: seg))
}

data observation_prefix_reuse_note: String = "Ancestry reuses std.effect_grant.path_is_prefix — the ONE prefix relation already carrying the containment question for effect targets, rather than a second walk written here (DESIGN section 3). Observation is one more consumer of the containment structure the resolver walks, content-addressing hashes, and effect admissibility tests. The subject tree is deliberately NOT added as a std.effect_grant.NamespaceTree variant in this phase: that enum is another lane's authority and the seed does not check match exhaustiveness, so a new variant would fall through silently in its existing consumers. Dissolve-on: the SymbolIndex-backed position supersedes the path-string interim, per the convergence commitment already declared in std.effect_grant.namespace_tree_note."

fn observation_subject_contains(ancestor: ObservationSubject, descendant: ObservationSubject) -> Bool {
  path_is_prefix(
    prefix: observation_subject_path(subject: ancestor),
    path: observation_subject_path(subject: descendant)
  )
}

type ObservationGrain
  = RunGrain
  | BatchGrain
  | EntryGrain
  | ModuleGrain
  | DeclarationGrain
  | PhaseGrain

fn observation_grain_of_segment(seg: ObservationSegment) -> ObservationGrain {
  match seg {
    RunSegment { id: _ } => RunGrain
    BatchSegment { index: _, label: _ } => BatchGrain
    EntrySegment { source_path: _ } => EntryGrain
    ModuleSegment { module_path: _ } => ModuleGrain
    DeclarationSegment { declaration: _ } => DeclarationGrain
    PhaseSegment { name: _ } => PhaseGrain
  }
}

fn observation_grain_depth(g: ObservationGrain) -> std.nat.Nat {
  match g {
    RunGrain => 0
    BatchGrain => 1
    EntryGrain => 2
    ModuleGrain => 3
    DeclarationGrain => 4
    PhaseGrain => 5
  }
}

fn observation_subject_grain(subject: ObservationSubject) -> ObservationGrain {
  fold(subject.segments, init: RunGrain, f: (acc, seg) => observation_grain_of_segment(seg: seg))
}

fn observation_subject_entry_path(subject: ObservationSubject) -> std.types.NonEmptyStr? {
  fold(subject.segments, init: Absent, f: (acc, seg) =>
    match seg {
      EntrySegment { source_path: p } => Present { value: p }
      RunSegment { id: _ } => acc
      BatchSegment { index: _, label: _ } => acc
      ModuleSegment { module_path: _ } => acc
      DeclarationSegment { declaration: _ } => acc
      PhaseSegment { name: _ } => acc
    }
  )
}

fn observation_subject_declaration(subject: ObservationSubject) -> std.decl_ref.DeclarationRef? {
  fold(subject.segments, init: Absent, f: (acc, seg) =>
    match seg {
      DeclarationSegment { declaration: d } => Present { value: d }
      RunSegment { id: _ } => acc
      BatchSegment { index: _, label: _ } => acc
      EntrySegment { source_path: _ } => acc
      ModuleSegment { module_path: _ } => acc
      PhaseSegment { name: _ } => acc
    }
  )
}

fn observation_subject_phase_name(subject: ObservationSubject) -> std.types.NonEmptyStr? {
  fold(subject.segments, init: Absent, f: (acc, seg) =>
    match seg {
      PhaseSegment { name: n } => Present { value: n }
      RunSegment { id: _ } => acc
      BatchSegment { index: _, label: _ } => acc
      EntrySegment { source_path: _ } => acc
      ModuleSegment { module_path: _ } => acc
      DeclarationSegment { declaration: _ } => acc
    }
  )
}

fn observation_subject_module_path(subject: ObservationSubject) -> std.types.NonEmptyStr? {
  fold(subject.segments, init: Absent, f: (acc, seg) =>
    match seg {
      ModuleSegment { module_path: p } => Present { value: p }
      RunSegment { id: _ } => acc
      BatchSegment { index: _, label: _ } => acc
      EntrySegment { source_path: _ } => acc
      DeclarationSegment { declaration: _ } => acc
      PhaseSegment { name: _ } => acc
    }
  )
}

fn observation_grain_at_or_above_entry(g: ObservationGrain) -> Bool {
  observation_grain_depth(g: g) <= observation_grain_depth(g: EntryGrain)
}

type Measured<T>
  = MeasuredValue { value: T }
  | MeasuredUnavailable { cause: std.types.NonEmptyStr }

data observation_measured_note: String = "Absence of a measurement is a NAMED state carrying its cause, never a fabricated zero (DESIGN section 5). This mirrors the discipline the floor heartbeat already keeps in the seed: an unreadable cgroup field prints unreadable and refuses to invent a number. A renderer projecting MeasuredUnavailable prints the cause; it never prints 0 and never omits the field, because a silently omitted number is the same fabrication one layer up."

type TimedMeasurement {
  basis: std.measure.ClockBasis
  elapsed: Measured<std.measure.Nanosecond>
}

data observation_timed_measurement_note: String = "One duration, tagged with the clock it came from. THE BASIS IS NOT OPTIONAL AND THE VALUE IS: you always know which clock you tried to read, and you may fail to read it. So basis is a plain ClockBasis while elapsed is Measured, which keeps the cause of an unreadable clock (observation_measured_note: never a fabricated zero, never a silently omitted field) without inventing a basis nobody observed. The inverse shape -- Measured<TimedMeasurement> -- was rejected because an Unavailable arm would then carry no basis, so a failed CPU read and a failed wall read would be indistinguishable."

fn timed_measurement_basis(t: TimedMeasurement) -> std.measure.ClockBasis {
  t.basis
}

fn timed_measurement_elapsed(t: TimedMeasurement) -> Measured<std.measure.Nanosecond> {
  t.elapsed
}

type ObservationOutcome
  = Done
  | Refused { diagnostic: std.types.NonEmptyStr }
  | Failed { error: std.types.NonEmptyStr, output: String }
  | TimedOut { basis: std.measure.ClockBasis, budget: std.measure.Millisecond, elapsed: std.measure.Millisecond }
  | Skipped { reason: std.types.NonEmptyStr }
  | Final { shown_failures: std.nat.Nat }

data observation_timed_out_basis_note: String = "TimedOut names the clock its cap was enforced on, so a crossing says WHICH cap it crossed. Before this, budget and elapsed were two bare magnitudes and a reader could not tell a CPU fail-stop from a wall ceiling -- the live specimen being a 5000ms CPU eval budget and a 600000ms wall receipt budget, both surfacing as TimedOut with no way to distinguish them. ONE basis governs BOTH fields rather than each carrying its own: a budget and the elapsed figure compared against it must be on the same clock or the comparison is meaningless, so two independently-based fields would make the incoherent state representable. Same reason the seed's BudgetKind sits beside the pair rather than inside each half."

data observation_refused_distinct_note: String = "Refused is DISTINCT from Failed, and this is the point of the sum, not a nicety. A typed refusal is the house's fail-closed spine (DESIGN section 5): the line stopped deliberately, located, with a diagnostic — the stopped line the operator is meant to analyse. A failure is the process breaking. The reference implementation studied for this lane conflates them behind one red glyph, which is exactly how a deliberate refusal reads as a crash and a crash reads as policy. They get different glyphs and different rendering; a renderer that maps both to one symbol is a regression the presentation census reds."

type ObservationTransition
  = Begin
  | Step { k: std.nat.Nat, n: std.nat.Nat }
  | Concluded { outcome: ObservationOutcome }

type ObservationEvent {
  subject: ObservationSubject
  transition: ObservationTransition
  durations: List<TimedMeasurement>
  rss: Measured<std.measure.ByteSize>
}

data observation_event_durations_note: String = "THE FIELD THAT USED TO BE CALLED wall. It held a Measured<Nanosecond> whose clock lived entirely in the four letters of its name, and every producer filled it from a wall reading while the fast-lane budget it was compared against is enforced on thread CPU — the exact defect std.measure measure_clock_basis_note prices. Renaming it would have moved the nickname, not retired it, so the clock became data (operator ruling 2026-08-05). WHY A LIST AND NOT ONE TAGGED DURATION: a transition is one event and may be measured on more than one clock at once. The seed already holds both for every witness occurrence — v1 cli_run run_claim_measured computes cpu_nanos and wall_nanos from a single run and 7820A put both on PerformanceReceipt — so a carrier admitting one would have forced the producer to choose which truth to drop, which is how the receipt came to disagree with the cap in the first place. AND THE SECOND CLOCK EARNS ITS PLACE BY BEING A REMEDY DISCRIMINATOR, not by being a second threshold (operator ruling 2026-08-05, relayed through the v1-deletion lane): where a witness threshold is stated on wall, the CPU figure beside it is what tells an author WHICH fix applies — high wall with high CPU is algorithm or repeated evaluation, high wall with low CPU is waiting, I/O, subprocess or scheduling. One clock cannot make that distinction, and two untagged clocks cannot be trusted to be the ones you think they are. WHY NOT A RECORD WITH A cpu FIELD AND A wall FIELD: that is the nickname again, twice, and it is what the operator refused when the first draft of this work proposed cpu as a third measured quantity beside wall and rss. WHAT IS NOT WALLED: nothing prevents two entries sharing one basis. A total function from a closed sum to a value is the construction that would make it unwritable, and this substrate has no such carrier — Map is a closure, is not wire-serializable, and its projections are refused by the determinism gate. So the ambiguity is representable and REFUSED AT READ instead: observation_duration returns MeasuredUnavailable carrying the duplicate as its cause, never a silent first-match pick (DESIGN section 5 — a failure arm must refuse, never widen). Rung: mechanically preventable, ceiling structurally impossible, next trigger a total-over-closed-sum carrier in the substrate."

type ClockLookup
  = ClockNotFound
  | ClockFound { elapsed: Measured<std.measure.Nanosecond> }
  | ClockAmbiguous

fn observation_clock_lookup(
  durations: List<TimedMeasurement>,
  basis: std.measure.ClockBasis
) -> ClockLookup {
  fold(durations, init: ClockNotFound, f: (acc, t) =>
    if clock_basis_eq(a: timed_measurement_basis(t: t), b: basis) {
      match acc {
        ClockNotFound => ClockFound { elapsed: timed_measurement_elapsed(t: t) }
        ClockFound { elapsed: _ } => ClockAmbiguous
        ClockAmbiguous => ClockAmbiguous
      }
    } else {
      acc
    }
  )
}

fn observation_duration_of(
  durations: List<TimedMeasurement>,
  basis: std.measure.ClockBasis
) -> Measured<std.measure.Nanosecond> {
  match observation_clock_lookup(durations: durations, basis: basis) {
    ClockNotFound =>
      MeasuredUnavailable {
        cause: concat(
          concat("no ", clock_basis_label(b: basis) as String),
          " duration was recorded on this event"
        ) as std.types.NonEmptyStr
      }
    ClockFound { elapsed: e } => e
    ClockAmbiguous =>
      MeasuredUnavailable {
        cause: concat(
          concat("two ", clock_basis_label(b: basis) as String),
          " durations were recorded on one event; the observation is ambiguous"
        ) as std.types.NonEmptyStr
      }
  }
}

fn observation_duration(event: ObservationEvent, basis: std.measure.ClockBasis) -> Measured<std.measure.Nanosecond> {
  observation_duration_of(durations: event.durations, basis: basis)
}

fn observation_wall(event: ObservationEvent) -> Measured<std.measure.Nanosecond> {
  observation_duration(event: event, basis: WallClock)
}

fn observation_durations_wall(elapsed: std.measure.Nanosecond) -> List<TimedMeasurement> {
  [TimedMeasurement { basis: WallClock, elapsed: MeasuredValue { value: elapsed } }]
}

fn observation_durations_wall_unavailable(cause: std.types.NonEmptyStr) -> List<TimedMeasurement> {
  [TimedMeasurement { basis: WallClock, elapsed: MeasuredUnavailable { cause: cause } }]
}

fn observation_durations_cpu_and_wall(
  cpu: std.measure.Nanosecond,
  wall: std.measure.Nanosecond
) -> List<TimedMeasurement> {
  [
    TimedMeasurement { basis: CpuClock, elapsed: MeasuredValue { value: cpu } },
    TimedMeasurement { basis: WallClock, elapsed: MeasuredValue { value: wall } }
  ]
}

data observation_wall_facade_note: String = "observation_wall is the strict wall projection every pre-ruling consumer already wanted, and it is NOT a compatibility shim: an attention threshold, a CI clamp constant and a dwell escalation are all wall notions, so a consumer asking for wall is asking correctly and now says so. What it replaces is the field access event.wall, which asked for nothing — it returned whatever the producer happened to put there. The three durations_* builders exist so a producer states its clock once at the construction site rather than at 49 of them; a producer needing a shape they do not cover constructs TimedMeasurement directly, which is still explicit about the basis. There is deliberately no observation_durations_cpu builder: a CPU-only observation has no wall figure, which no producer in this corpus can honestly claim, and minting the builder before a producer exists would be the orphan this house rejects."

type SchedulerHold
  = WindowFull { active: std.nat.Nat, target: std.nat.Nat }
  | CurrentHighWater { current: std.measure.ByteSize, high_water: std.measure.ByteSize }
  | PsiPressure { avg10: std.measure.BasisPoint }
  | SwapGrowth { delta: std.measure.ByteSize }
  | AwaitFirstCost { undigested: std.nat.Nat }
  | InsufficientHeadroom { current: std.measure.ByteSize, share: std.measure.ByteSize, high_water: std.measure.ByteSize }
  | AdmissionCeiling { current: std.measure.ByteSize, ceiling: std.measure.ByteSize }

data observation_scheduler_hold_note: String = "SchedulerHold is the substrate authority for why admission was withheld this poll; the seed's v1_compiler memory_governor HoldReason is the realization that must stay in lockstep with it (the .dag graph is the authority and Rust is the seed). The lockstep witness proves arity and variant names match by reading the live seed, so a variant added on one side and not the other reds instead of drifting."

type ContendedResource
  = MemoryBudget
  | AdmissionWindow
  | MaturationReserve

type ContentionRemaining
  = RemainingUnknown { cause: std.types.NonEmptyStr }
  | RemainingBounded { by: std.measure.Millisecond }

type BlockedOn {
  resource: ContendedResource
  holders: List<ObservationSubject>
  remaining: ContentionRemaining
}

fn observation_hold_resource(hold: SchedulerHold) -> ContendedResource {
  match hold {
    WindowFull { active: _, target: _ } => AdmissionWindow
    CurrentHighWater { current: _, high_water: _ } => MemoryBudget
    PsiPressure { avg10: _ } => MemoryBudget
    SwapGrowth { delta: _ } => MemoryBudget
    AwaitFirstCost { undigested: _ } => MaturationReserve
    InsufficientHeadroom { current: _, share: _, high_water: _ } => MemoryBudget
    AdmissionCeiling { current: _, ceiling: _ } => MaturationReserve
  }
}

data observation_blocked_on_derived_note: String = "BlockedOn is DERIVED from scheduler and governor state and has no hand-set constructor path in any renderer (design doc section 2). The governor already knows why it held; the crawl window that priced this lane was invisible only because that knowledge never reached the log. holders are the subjects currently occupying the contended resource — existing scheduler state, not a new telemetry source (design doc section 7 forbids new sources in P0 and P1). remaining is a named coproduct because the governor does not always have a bound to give: RemainingUnknown carries why, so the renderer prints the cause rather than an invented estimate."

fn observation_blocked_on(hold: SchedulerHold, holders: List<ObservationSubject>, remaining: ContentionRemaining) -> BlockedOn {
  BlockedOn {
    resource: observation_hold_resource(hold: hold),
    holders: holders,
    remaining: remaining
  }
}

type AttentionLevel
  = Ambient
  | Notable
  | Anomaly

type AttentionBasis {
  average: std.measure.Millisecond
  maximum: std.measure.Millisecond
}

// AttentionLevel is DERIVED, never chosen at an emit site — there are no per-site log levels in this model (law 5). The basis is the pair of signed cost constants the CI clamp model carries (design doc section 6b): over the signed average is Notable, over the signed maximum is Anomaly. No threshold is invented here — the basis is a parameter supplied by the consumer that owns those constants, so this module cannot smuggle a number of its own. A refusal, failure, timeout, or orphaned begin is an Anomaly on its own terms, independent of any basis.
fn observation_outcome_is_anomaly(o: ObservationOutcome) -> Bool {
  match o {
    Done => false
    Refused { diagnostic: _ } => true
    Failed { error: _, output: _ } => true
    TimedOut { basis: _, budget: _, elapsed: _ } => true
    Skipped { reason: _ } => false
    Final { shown_failures: _ } => false
  }
}

fn observation_attention_of_elapsed(elapsed: std.measure.Nanosecond, basis: AttentionBasis) -> AttentionLevel {
  if measure_le(a: elapsed, b: millisecond_to_nanosecond(m: basis.average)) {
    Ambient
  } else if measure_le(a: elapsed, b: millisecond_to_nanosecond(m: basis.maximum)) {
    Notable
  } else {
    Anomaly
  }
}

type ObservationAttention
  = AttentionAssigned { level: AttentionLevel }
  | AttentionRefused { cause: std.types.NonEmptyStr }

data observation_attention_availability_note: String = "Attention is a projection over the event wall and the consumer-owned basis, with precedence made explicit. Begin is Ambient and intrinsic Refused/Failed/TimedOut are Anomaly without consulting either measurement. A routine event with an unavailable wall remains Ambient because no elapsed comparison is possible and the wall's absence is already rendered on the line. A routine event with a measured wall may compare only against a measured basis; an unavailable basis returns a typed refusal preserving its exact cause, never a dummy threshold. observation_attention is retained as the strict MeasuredValue facade for existing callers, so its result cannot diverge from observation_attention_under on an available basis."

fn observation_attention_with_measured_basis(
  event: ObservationEvent,
  basis: AttentionBasis
) -> AttentionLevel {
  match event.transition {
    Begin => Ambient
    Concluded { outcome: o } =>
      if observation_outcome_is_anomaly(o: o) {
        Anomaly
      } else {
        match observation_wall(event: event) {
          MeasuredUnavailable { cause: _ } => Ambient
          MeasuredValue { value: w } => observation_attention_of_elapsed(elapsed: w, basis: basis)
        }
      }
    Step { k: _, n: _ } =>
      match observation_wall(event: event) {
        MeasuredUnavailable { cause: _ } => Ambient
        MeasuredValue { value: w } => observation_attention_of_elapsed(elapsed: w, basis: basis)
      }
  }
}

fn observation_attention_under(event: ObservationEvent, basis: Measured<AttentionBasis>) -> ObservationAttention {
  match basis {
    MeasuredValue { value: b } =>
      AttentionAssigned {
        level: observation_attention_with_measured_basis(event: event, basis: b)
      }
    MeasuredUnavailable { cause: basis_cause } =>
      match event.transition {
        Begin => AttentionAssigned { level: Ambient }
        Concluded { outcome: o } =>
          if observation_outcome_is_anomaly(o: o) {
            AttentionAssigned { level: Anomaly }
          } else {
            match observation_wall(event: event) {
              MeasuredUnavailable { cause: _ } => AttentionAssigned { level: Ambient }
              MeasuredValue { value: _ } => AttentionRefused { cause: basis_cause }
            }
          }
        Step { k: _, n: _ } =>
          match observation_wall(event: event) {
            MeasuredUnavailable { cause: _ } => AttentionAssigned { level: Ambient }
            MeasuredValue { value: _ } => AttentionRefused { cause: basis_cause }
          }
      }
  }
}

fn observation_attention(event: ObservationEvent, basis: AttentionBasis) -> AttentionLevel {
  observation_attention_with_measured_basis(event: event, basis: basis)
}

type ObservationEventClass
  = ClassBegin
  | ClassStep
  | ClassDone
  | ClassRefused
  | ClassFailed
  | ClassTimedOut
  | ClassSkipped
  | ClassFinal
  | ClassBlocked
  | ClassDwellEscalation

data observation_event_classes: List<ObservationEventClass> = [
  ClassBegin,
  ClassStep,
  ClassDone,
  ClassRefused,
  ClassFailed,
  ClassTimedOut,
  ClassSkipped,
  ClassFinal,
  ClassBlocked,
  ClassDwellEscalation
]

fn observation_outcome_class(o: ObservationOutcome) -> ObservationEventClass {
  match o {
    Done => ClassDone
    Refused { diagnostic: _ } => ClassRefused
    Failed { error: _, output: _ } => ClassFailed
    TimedOut { basis: _, budget: _, elapsed: _ } => ClassTimedOut
    Skipped { reason: _ } => ClassSkipped
    Final { shown_failures: _ } => ClassFinal
  }
}

fn observation_event_class(event: ObservationEvent) -> ObservationEventClass {
  match event.transition {
    Begin => ClassBegin
    Step { k: _, n: _ } => ClassStep
    Concluded { outcome: o } => observation_outcome_class(o: o)
  }
}

type ObservationPresentation {
  glyph: std.symbols.SymbolId
  collapsible: Bool
  expands_fully: Bool
}

data observation_collapse_axes_note: String = "collapsible and expands_fully are two axes, not one flag with a middle value, because three states are real and conflating them loses one. Routine progress collapses and does not expand. An intrinsic anomaly neither collapses nor stays terse: it expands fully and names itself. The run's Final summary is the third state — it never collapses, because a summary that hid itself would defeat its purpose, yet it is NOT an anomaly and must not be rendered as one. A single collapsible flag would force Final to borrow the anomaly's presentation, which is the state-space conflation the house splits into named variants."

// Event class to presentation is a TOTAL assignment over the class roster, censused and walled the way the register censuses unthemed colors. The presentation carries only the SymbolId: the glyph text per tier and the register colour role are read from the ONE glyph authority (std.symbols identity, extdeps.render.glyphs rows), never restated here, so perturbing a glyph row moves every renderer and a renderer that hardcodes a glyph is provably not reading the table. collapsible and expands_fully carry law 4: sub-threshold work collapses, an anomaly expands fully and names itself, and the two flags are never both permissive for an intrinsically anomalous class.
type ObservationDensity
  = RoutineCollapsible
  | SummaryAlwaysShown
  | AnomalyExpanded

data observation_density_single_authority_note: String = "The three display states of law 4 live in ONE table. Density is the authority; collapsible, expands_fully and intrinsic-anomaly are all DERIVED from it. The earlier shape carried two hand-written tables — a class-to-anomaly predicate beside a class-to-presentation assignment — with a witness asserting they agreed. That witness was validation standing exactly where construction was available (DESIGN section 5): it conceded the two tables could disagree and merely promised to notice. They cannot disagree now, because there is only one of them, and the review finding that named this duplication is what collapsed it."

fn observation_class_density(c: ObservationEventClass) -> ObservationDensity {
  match c {
    ClassBegin => RoutineCollapsible
    ClassStep => RoutineCollapsible
    ClassDone => RoutineCollapsible
    ClassRefused => AnomalyExpanded
    ClassFailed => AnomalyExpanded
    ClassTimedOut => AnomalyExpanded
    ClassSkipped => RoutineCollapsible
    ClassFinal => SummaryAlwaysShown
    ClassBlocked => AnomalyExpanded
    ClassDwellEscalation => AnomalyExpanded
  }
}

fn observation_density_collapsible(d: ObservationDensity) -> Bool {
  match d {
    RoutineCollapsible => true
    SummaryAlwaysShown => false
    AnomalyExpanded => false
  }
}

fn observation_density_expands_fully(d: ObservationDensity) -> Bool {
  match d {
    RoutineCollapsible => false
    SummaryAlwaysShown => false
    AnomalyExpanded => true
  }
}

fn observation_class_is_intrinsic_anomaly(c: ObservationEventClass) -> Bool {
  observation_density_expands_fully(d: observation_class_density(c: c))
}

fn observation_class_glyph(c: ObservationEventClass) -> std.symbols.SymbolId {
  match c {
    ClassBegin => NodeRunning
    ClassStep => NodeRunning
    ClassDone => NodeCompleted
    ClassRefused => StatusRefused
    ClassFailed => NodeFailed
    ClassTimedOut => StatusTimedOut
    ClassSkipped => NodeSkipped
    ClassFinal => StatusFinal
    ClassBlocked => StatusBlocked
    ClassDwellEscalation => StatusDwell
  }
}

fn observation_presentation(c: ObservationEventClass) -> ObservationPresentation {
  let density = observation_class_density(c: c)
  ObservationPresentation {
    glyph: observation_class_glyph(c: c),
    collapsible: observation_density_collapsible(d: density),
    expands_fully: observation_density_expands_fully(d: density)
  }
}

data observation_change_presentation_note: String = "Change kind is NOT re-declared here. std.change.KeyedDiffHunk already carries the added, removed and modified discriminant — it is the house's one diff carrier — so a fresh three-variant enum on this module would be a nickname for it, duplicated again in everything derived from it. What observation owns is the PRESENTATION of that discriminant: a symbol whose register colour role follows the git-diff convention the operator signed, and a text tag. The tag is not optional decoration: colour is never the only channel, so a pipe, a colourless terminal, or a screen reader loses nothing. A presentation with an empty tag is the failure the witness reds."

type ChangePresentation {
  symbol: std.symbols.SymbolId
  tag: std.types.NonEmptyStr
}

fn observation_change_presentation<K, V>(hunk: std.change.KeyedDiffHunk<K, V>) -> ChangePresentation {
  match hunk {
    KeyedDiffAddedHunk { hunk_key: _, to: _ } =>
      ChangePresentation { symbol: ChangeAdded, tag: "new" as std.types.NonEmptyStr }
    KeyedDiffRemovedHunk { hunk_key: _, from: _ } =>
      ChangePresentation { symbol: ChangeRemoved, tag: "removed" as std.types.NonEmptyStr }
    KeyedDiffModifiedHunk { hunk_key: _, from: _, to: _ } =>
      ChangePresentation { symbol: ChangeModified, tag: "edited" as std.types.NonEmptyStr }
  }
}

type SelectionNoOp
  = DocsPolicy
  | Uncovered { declaration: std.types.NonEmptyStr }
  | NoDeclsTouched
  | GeneratedArtifactNoOp { drift_gate_authority: std.types.NonEmptyStr }
  | DepartedPath { cause: std.types.NonEmptyStr }

data observation_selection_no_op_note: String = "A touched file that selected no work is a CLOSED SUM, never a bare nothing. Nothing meaning five different things is the state-space conflation the house splits into named variants, and here the remedies genuinely differ: docs select no executable work and that is correct and quiet; a touched declaration no witness references is a COVERAGE GAP surfaced at review time, so it renders as a visible nudge rather than a comfort; only comments or whitespace intersected is fine and says so; a generated artifact is checked by the drift gate against its authority, not by witnesses, so nothing must never appear beside it; and a departed path is NOT a no-op at all — a deleted module cannot be scoped, so selection widens to baseline and the line says why. Because the sum is closed and the presentation assignment below is total, an unlabelled nothing is UNWRITABLE rather than censused after the fact — construction where a census would have conceded the bad line was writable."

data selection_noop_generated_artifact_mint_note: String = "Mint helper for the SelectionNoOp.GeneratedArtifactNoOp arm. The former bare constructor name `GeneratedArtifact` collided under whole-tree compile-clean with v2.std.artifact.GeneratedArtifact and gunbc.generated_artifact.GeneratedArtifact — three unrelated carriers that share a noun. Naming the disposition rather than relying on defining-module resolution keeps the closed no-op sum unambiguous in every import closure; callers still construct through this helper."

data selection_noop_generated_artifact_rename_scaffold_note: String = "DECLARED SCAFFOLD (review 44094, DESIGN 6). The rename above is a LOCAL disambiguation, not a fix: three unrelated carriers still share the noun GeneratedArtifact — this no-op disposition, v2.std.artifact.GeneratedArtifact (the emitted artifact), and gunbc.generated_artifact.GeneratedArtifact (the committed drift-gated file). Only one of them was renamed, so the collision is dodged at this site and left standing everywhere else, which is exactly the shape DESIGN 3 warns about: a fork gets consolidated later, so deferring is a cost decision, not a clean one. Three same-named types is NOT automatically three authorities — they may be genuinely different concepts that deserve distinct nouns, or two of them may be one concept forked — and deciding which is a modeling question this rename does not answer. DISSOLVES ON: the namespace-only resolution lane landing containment-derived qualified names (docs/plans/namespace-resolution-design.md), at which point a bare same-name is resolved by position and the disambiguating suffix is dead weight; or, sooner, a DFS over the three carriers that either renames each to what it actually IS or proves two of them one concept and merges them. Whichever lands first deletes this row and the NoOp suffix with it."

fn selection_noop_generated_artifact(drift_gate_authority: std.types.NonEmptyStr) -> SelectionNoOp {
  GeneratedArtifactNoOp { drift_gate_authority: drift_gate_authority }
}

fn observation_no_op_is_actually_a_widen(n: SelectionNoOp) -> Bool {
  match n {
    DocsPolicy => false
    Uncovered { declaration: _ } => false
    NoDeclsTouched => false
    GeneratedArtifactNoOp { drift_gate_authority: _ } => false
    DepartedPath { cause: _ } => true
  }
}

fn observation_no_op_attention(n: SelectionNoOp) -> AttentionLevel {
  match n {
    DocsPolicy => Ambient
    Uncovered { declaration: _ } => Notable
    NoDeclsTouched => Ambient
    GeneratedArtifactNoOp { drift_gate_authority: _ } => Ambient
    DepartedPath { cause: _ } => Notable
  }
}

fn observation_no_op_symbol(n: SelectionNoOp) -> std.symbols.SymbolId {
  match n {
    DocsPolicy => NodeSkipped
    Uncovered { declaration: _ } => StatusWarning
    NoDeclsTouched => NodeSkipped
    GeneratedArtifactNoOp { drift_gate_authority: _ } => StatusInfo
    DepartedPath { cause: _ } => StatusWarning
  }
}

fn observation_no_op_explanation(n: SelectionNoOp) -> std.types.NonEmptyStr {
  match n {
    DocsPolicy => "documentation never selects executable work" as std.types.NonEmptyStr
    Uncovered { declaration: d } => concat("no witness covers this change: ", d) as std.types.NonEmptyStr
    NoDeclsTouched => "only comments or whitespace changed" as std.types.NonEmptyStr
    GeneratedArtifactNoOp { drift_gate_authority: a } => concat("generated artifact — checked by drift against ", a) as std.types.NonEmptyStr
    DepartedPath { cause: c } => concat("a deleted module cannot be scoped, so selection widened: ", c) as std.types.NonEmptyStr
  }
}

data observation_human_units_contract: String = "Rendered magnitudes are in human units, and a raw telemetry dump is a census violation rather than a projection. The named negative example is the floor memory heartbeat's current shape: sixty-plus identical context-free byte dumps an hour, current=16111669248 with no subject attached, which is precisely the line that was present throughout the ten-minute crawl window and told the operator nothing. A projection states the magnitude at a scale a human reads and attaches the subject it belongs to. This contract is stated on the model so the P3 census has an authority to check against; the renderers that satisfy it are P1 and later."

data observation_heartbeat_period: std.measure.Millisecond = millisecond(count: 60000)

data observation_heartbeat_period_note: String = "The heartbeat cadence is a measured fact of the running system, not a preference: the floor's memory heartbeat already samples and prints once per minute, and the lockstep witness reads that period out of the live seed rather than trusting this row. It is stated here because the dwell threshold is derived from it."

type DwellThreshold {
  period: std.measure.Millisecond
  basis: std.types.NonEmptyStr
}

data observation_dwell_threshold: DwellThreshold = DwellThreshold {
  period: observation_heartbeat_period,
  basis: "one heartbeat period — the log's existing clock. Law 2 requires that no subject stay quiet past T without a line naming it, and the heartbeat is already the cadence at which the log speaks, so T is DERIVED from the emitter's own period rather than picked. Escalation at 2T and 4T rides the same clock, which is why depth is a division and not a table of tuned constants."
}

data observation_dwell_threshold_disposition: std.disposition.Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "std.observation",
    decl_name: "observation_dwell_threshold",
    field: WholeDeclaration
  }
}

data observation_dwell_recalibration_note: String = "Declared scaffold, with its trigger: the design doc says T's basis is the measured quiet-time distribution. That distribution is not yet collected — the gauntlet and falsifier whole-corpus runs are the context that will produce it (design doc section 6b names that lane as the escalation law's primary home). Deriving T from the heartbeat period is a grounded interim, not taste, because the period is itself measured and law 2 is stated in terms of it. Dissolve-on: the first measured quiet-time distribution from a gauntlet cadence replaces the basis, and this row's period becomes a projection of it."

fn observation_escalation_depth(quiet: std.measure.Millisecond, t: DwellThreshold) -> std.nat.Nat {
  millisecond_count(m: quiet) / millisecond_count(m: t.period)
}

// Law 3: attention escalates by dwell time, RECURSIVELY. A subject quiet past T surfaces its current child, past 2T the grandchild, and so on to the leaf — the collapse rule of law 4 run in reverse under time pressure, over the same tree and the same events. Depth is floor of quiet over T, so one law covers every level instead of a special case per level; the reference implementation expands one level only, and only on a TTY, which is why the CI crawl window stayed silent.
fn observation_escalation_reveal_depth(quiet_subject: ObservationSubject, quiet: std.measure.Millisecond, t: DwellThreshold) -> std.nat.Nat {
  count(quiet_subject.segments) + observation_escalation_depth(quiet: quiet, t: t)
}

fn observation_escalation_subject(quiet_subject: ObservationSubject, active_leaf: ObservationSubject, quiet: std.measure.Millisecond, t: DwellThreshold) -> ObservationSubject {
  if observation_subject_contains(ancestor: quiet_subject, descendant: active_leaf) {
    ObservationSubject {
      segments: active_leaf.segments.take(n: observation_escalation_reveal_depth(quiet_subject: quiet_subject, quiet: quiet, t: t))
    }
  } else {
    quiet_subject
  }
}

type WatchdogVerdict
  = WatchdogQuiet
  | WatchdogOrphanedBegin { subject: ObservationSubject, elapsed: std.measure.Millisecond, budget: std.measure.Millisecond }

data observation_watchdog_note: String = "Law 1: every subject at entry grain and above emits a matched Begin and exactly one Outcome, so an orphaned Begin is a DETECTABLE DEFECT rather than a silence to be interpreted. The watchdog converts quiet-past-budget into a typed line, which also closes the batch-wall hang gap — a batch that never completes currently rides silently to the step cap. The exceeded-budget arithmetic is not restated here: it calls std.temporal_effect.stall_budget_verdict, the one carrier already answering elapsed-against-limit, so there is a single authority for what over-budget means and this module only adds the subject the verdict is about."

fn observation_watchdog(subject: ObservationSubject, elapsed: std.measure.Millisecond, budget: std.measure.Millisecond) -> WatchdogVerdict {
  match stall_budget_verdict(budget: std.temporal_effect.EffectStallBudget {
    step_id: observation_subject_render(subject: subject),
    limit_ms: budget,
    elapsed_ms: elapsed
  }) {
    StallWithinBudget => WatchdogQuiet
    StallBudgetExceeded { step_id: _, elapsed_ms: e, limit_ms: l } =>
      WatchdogOrphanedBegin { subject: subject, elapsed: e, budget: l }
  }
}

data observation_empty_subject_note: String = "The empty-path arm NAMES the absence rather than inventing a subject, and it does not widen: unattributed is a label for a caller that built a subject with no identity, not a plausible substitute for one. It is not the absorbing fallback the house forbids — nothing is rerun, nothing is scanned wholesale, and the line is as loud as any other. It is nonetheless a CONSTRUCTION GAP, declared rather than left silent: the right shape is a segment list that cannot be empty, which the substrate cannot express today — a record-field where clause over a list is named future work in the where-clause lowering plan, and no list refinement exists in the corpus. Dissolve-on: when that lowering lands, ObservationSubject.segments takes the non-empty refinement, this arm becomes unreachable by construction, and it deletes."

fn observation_subject_render(subject: ObservationSubject) -> std.types.NonEmptyStr {
  match join(observation_subject_path(subject: subject), " ") {
    "" => "run=unattributed" as std.types.NonEmptyStr
    rendered => rendered as std.types.NonEmptyStr
  }
}

fn observation_watchdog_attention(v: WatchdogVerdict) -> AttentionLevel {
  match v {
    WatchdogQuiet => Ambient
    WatchdogOrphanedBegin { subject: _, elapsed: _, budget: _ } => Anomaly
  }
}

type ObservationLaw {
  id: std.types.NonEmptyStr
  statement: std.types.NonEmptyStr
  enforced_by: std.decl_ref.DeclarationRef
}

data observation_laws_note: String = "The five laws land as DATA ROWS, operator-signed 2026-07-23. Each row names the declaration that enforces it, so a law with no enforcement is a detectable orphan rather than a sentence in a document nobody executes — the lockstep witness reads this module out of the live tree and reds when a named declaration is absent. Candidate convergence, flagged not assumed: the enforcement-intent lane models the operator's recurring standing directives as StandingIntent rows with a lens contract and a coverage receipt. These five are directives of exactly that shape, but StandingIntent's fields today are lens-enforcement machinery (scope roster, consumer requirement, narrowing reasons) that these rows would fill hollowly, so they stay plain rows and the consolidation is the operator's call when that lane generalizes."

data observation_law_process_to_outcome: ObservationLaw = ObservationLaw {
  id: "observation.process-to-outcome" as std.types.NonEmptyStr,
  statement: "Every subject at entry grain and above emits a matched Begin and exactly one Outcome; quiet past budget becomes a typed line, never an interpreted silence." as std.types.NonEmptyStr,
  enforced_by: std.decl_ref.DeclarationRef {
    module_path: "std.observation",
    decl_name: "observation_watchdog",
    field: WholeDeclaration
  }
}

data observation_law_heartbeat_identity: ObservationLaw = ObservationLaw {
  id: "observation.heartbeat-carries-identity" as std.types.NonEmptyStr,
  statement: "The heartbeat carries identity, not just vitals: phase, entry, module and k of n. No phase exceeds T without a line naming its current subject." as std.types.NonEmptyStr,
  enforced_by: std.decl_ref.DeclarationRef {
    module_path: "std.observation",
    decl_name: "observation_subject_render",
    field: WholeDeclaration
  }
}

data observation_law_dwell_escalation: ObservationLaw = ObservationLaw {
  id: "observation.attention-escalates-by-dwell" as std.types.NonEmptyStr,
  statement: "Attention escalates by dwell time, recursively: quiet past T surfaces the child, past 2T the grandchild, down to the leaf. T is a data row with a measured basis." as std.types.NonEmptyStr,
  enforced_by: std.decl_ref.DeclarationRef {
    module_path: "std.observation",
    decl_name: "observation_escalation_subject",
    field: WholeDeclaration
  }
}

data observation_law_quiet_at_arms_length: ObservationLaw = ObservationLaw {
  id: "observation.quiet-at-arms-length" as std.types.NonEmptyStr,
  statement: "Sub-threshold work is silent and collapses to summaries; a red or a refusal expands fully and names itself. The asymmetry is the design, and expansion stays bounded." as std.types.NonEmptyStr,
  enforced_by: std.decl_ref.DeclarationRef {
    module_path: "std.observation",
    decl_name: "observation_presentation",
    field: WholeDeclaration
  }
}

data observation_law_every_response_true: ObservationLaw = ObservationLaw {
  id: "observation.every-response-true" as std.types.NonEmptyStr,
  statement: "Every rendered number is a projection of a receipt fact. No vibes strings, no per-site log levels, no fabricated value standing in for an unavailable measurement." as std.types.NonEmptyStr,
  enforced_by: std.decl_ref.DeclarationRef {
    module_path: "std.observation",
    decl_name: "observation_attention",
    field: WholeDeclaration
  }
}

data observation_laws: List<ObservationLaw> = [
  observation_law_process_to_outcome,
  observation_law_heartbeat_identity,
  observation_law_dwell_escalation,
  observation_law_quiet_at_arms_length,
  observation_law_every_response_true
]

data observation_outcome_predicate_contract: std.disposition.Disposition = Terminal {
  reason: "Structural coproduct readers over ObservationOutcome and ObservationEventClass (observation_outcome_is_anomaly, observation_outcome_class, observation_event_class, observation_class_density and the density projections) — closed by the declared outcome and class variants, not interim scaffolds. Terminal because the sums are closed by construction and the class roster is censused: a new variant cannot be added without the totality witness naming it. Discriminating corpus: dag/test/claim/observation_model_witness_test.dag, which reds when a class loses its presentation, when Refused and Failed collapse onto one glyph, and when the density authority disagrees with what the presentation projects."
}

data observation_subject_predicate_contract: std.disposition.Disposition = Terminal {
  reason: "Structural readers over ObservationSegment, ObservationGrain and SchedulerHold (observation_grain_of_segment, observation_grain_depth, observation_subject_grain, observation_subject_entry_path, observation_subject_declaration, observation_subject_phase_name, observation_subject_module_path, observation_grain_at_or_above_entry, observation_hold_resource) — closed by declared variants. The hold reader is Terminal on the .dag side and additionally pinned to its realization: the lockstep witness reads the seed governor by execution, so a variant added on one side without the other reds rather than drifting."
}

data observation_selection_predicate_contract: std.disposition.Disposition = Terminal {
  reason: "Structural coproduct readers over SelectionNoOp (observation_no_op_is_actually_a_widen, observation_no_op_attention, observation_no_op_symbol, observation_no_op_explanation) — closed by the declared no-op variants. Terminal, and load-bearing rather than decorative: the widen reader is what keeps a departed path from being rendered as a no-op, which is the distinction the operator's closed-sum ruling exists to preserve."
}

data observation_renders_nothing_disposition: std.disposition.Disposition = Terminal {
  reason: "P0 carries the model only. Renderers are P1 and later, and the CI renderer's wiring lands after the atomic CI PR because both touch the floor's emit sites and churning them twice is the migration class the operator ruled out. This module therefore holds no line formatting, no glyph text, and no ANSI: it holds the vocabulary those renderers project from."
}

// ---------------------------------------------------------------------------
// Routine rollup — the fold that makes the collapse in law 4 actually happen.
// ---------------------------------------------------------------------------

// The module already carried the HIERARCHY (ObservationSubject is a containment path;
// ObservationGrain names its levels) and the DENSITY (observation_class_density: routine collapses,
// anomalies expand, summaries always show). What it did not carry is the operation that turns those
// two facts into one line instead of hundreds: a fold that accumulates routine leaf events into the
// ancestor subject at a declared grain. Measured on a green floor run (31480965027, 6188 console
// lines): 4110 lines were one-per-passing-witness, 1074 per-entry retention rows, 359 compile
// micro-events, 91 raw worker polls, and 26 semantic heartbeats — 99.6% leaf facts against the
// handful of lines that answer what is running and whether it is healthy. Density alone could not
// fix that, because collapsible is a per-line formatting verdict and the defect is that 4110 events
// became 4110 lines at all. Accumulation is the missing operation, and it belongs here beside the
// vocabulary it folds rather than in a renderer, so every renderer projects the same counts.

type ObservationCounts {
  begun: std.nat.Nat
  done: std.nat.Nat
  skipped: std.nat.Nat
  refused: std.nat.Nat
  failed: std.nat.Nat
  timed_out: std.nat.Nat
}

// Anomaly classes are COUNTED here even though they are never collapsed. Counting and emission are
// orthogonal axes and fusing them loses the summary: a batch conclusion that says `0 failed` is
// only trustworthy if failures were tallied on the same fold that tallied the passes, and a rollup
// that skipped them could only ever report an absence it never looked for. The collapse decision
// stays where it already lives (observation_class_density); this record answers how many, not
// whether to print.

fn observation_counts_zero() -> ObservationCounts {
  ObservationCounts { begun: 0, done: 0, skipped: 0, refused: 0, failed: 0, timed_out: 0 }
}

fn observation_counts_accept(counts: ObservationCounts, c: ObservationEventClass) -> ObservationCounts {
  match c {
    ClassBegin => ObservationCounts { begun: counts.begun + 1, done: counts.done, skipped: counts.skipped, refused: counts.refused, failed: counts.failed, timed_out: counts.timed_out }
    ClassStep => counts
    ClassDone => ObservationCounts { begun: counts.begun, done: counts.done + 1, skipped: counts.skipped, refused: counts.refused, failed: counts.failed, timed_out: counts.timed_out }
    ClassSkipped => ObservationCounts { begun: counts.begun, done: counts.done, skipped: counts.skipped + 1, refused: counts.refused, failed: counts.failed, timed_out: counts.timed_out }
    ClassRefused => ObservationCounts { begun: counts.begun, done: counts.done, skipped: counts.skipped, refused: counts.refused + 1, failed: counts.failed, timed_out: counts.timed_out }
    ClassFailed => ObservationCounts { begun: counts.begun, done: counts.done, skipped: counts.skipped, refused: counts.refused, failed: counts.failed + 1, timed_out: counts.timed_out }
    ClassTimedOut => ObservationCounts { begun: counts.begun, done: counts.done, skipped: counts.skipped, refused: counts.refused, failed: counts.failed, timed_out: counts.timed_out + 1 }
    ClassFinal => counts
    ClassBlocked => counts
    ClassDwellEscalation => counts
  }
}

fn observation_counts_anomalies(counts: ObservationCounts) -> std.nat.Nat {
  counts.refused + counts.failed + counts.timed_out
}

fn observation_subject_prefix_at_grain(
  subject: ObservationSubject,
  grain: ObservationGrain,
) -> ObservationSubject? {
  let target = observation_grain_depth(g: grain)
  let kept = filter(subject.segments, seg =>
    observation_grain_depth(g: observation_grain_of_segment(seg: seg)) <= target)
  let prefix = ObservationSubject { segments: kept }
  if count(kept) == target + 1 {
    Present { value: prefix }
  } else {
    none
  }
}

// Absent means the subject has no segment at the requested grain — a run-scoped event asked for its
// batch ancestor, or a malformed subject that skipped a level. It is NOT the empty prefix and NOT
// the subject itself, because either substitution would silently attribute an event to a scope
// nobody observed it in, which is the empty-observation narrow DESIGN names: rendering `could not
// locate the ancestor` as `belongs to the root`. The length check is what distinguishes the two: a
// well-formed path of the target depth keeps exactly target+1 segments, so a skipped level fails
// the count rather than closing the gap.

type ObservationRollup {
  subject: ObservationSubject
  counts: ObservationCounts
  active_leaf: ObservationSubject?
  elapsed: Measured<std.measure.Nanosecond>
  peak_rss: Measured<std.measure.ByteSize>
  measurement_absent: std.nat.Nat
}

// elapsed ACCUMULATES the measured walls and peak_rss keeps the MAXIMUM measured reading, because a
// batch summary answers two different questions with them: how much work-time the batch spent, and
// how close it came to the memory envelope. Summing rss would be meaningless (leaf readings overlap
// in time) and maximising elapsed would report the slowest leaf as the batch cost.
// measurement_absent counts the events whose reading was MeasuredUnavailable. Without it a partially
// measured batch would report a sum that silently omits its unmeasured members while reading as a
// total — the same shape as a count-completeness claim that only counts what it remembered to look
// at. The renderer can then say `41m02s over 4,878 witnesses (12 unmeasured)` rather than implying
// full coverage, and a rollup where every reading was absent stays MeasuredUnavailable rather than
// collapsing to a fabricated zero.

fn observation_rollup_open(subject: ObservationSubject) -> ObservationRollup {
  ObservationRollup {
    subject: subject,
    counts: observation_counts_zero(),
    active_leaf: none,
    elapsed: MeasuredUnavailable { cause: "no measured observation folded yet" },
    peak_rss: MeasuredUnavailable { cause: "no measured observation folded yet" },
    measurement_absent: 0,
  }
}

fn observation_rollup_add_elapsed(
  acc: Measured<std.measure.Nanosecond>,
  reading: Measured<std.measure.Nanosecond>,
) -> Measured<std.measure.Nanosecond> {
  match reading {
    MeasuredUnavailable { cause: _ } => acc
    MeasuredValue { value: v } =>
      match acc {
        MeasuredUnavailable { cause: _ } => MeasuredValue { value: v }
        MeasuredValue { value: a } => MeasuredValue { value: measure_add(a: a, b: v) }
      }
  }
}

fn observation_rollup_max_rss(
  acc: Measured<std.measure.ByteSize>,
  reading: Measured<std.measure.ByteSize>,
) -> Measured<std.measure.ByteSize> {
  match reading {
    MeasuredUnavailable { cause: _ } => acc
    MeasuredValue { value: v } =>
      match acc {
        MeasuredUnavailable { cause: _ } => MeasuredValue { value: v }
        MeasuredValue { value: a } => if measure_le(a: a, b: v) { MeasuredValue { value: v } } else { acc }
      }
  }
}

fn observation_measurement_absent_delta(reading: Measured<std.measure.Nanosecond>) -> std.nat.Nat {
  match reading {
    MeasuredUnavailable { cause: _ } => 1
    MeasuredValue { value: _ } => 0
  }
}

type ObservationRollupAccept
  = RollupAccepted { rollup: ObservationRollup }
  | RollupSubjectOutOfScope { subject: ObservationSubject }

// An event whose subject the rollup does not contain is REFUSED, not silently dropped and not
// folded anyway. Both silent arms are the absorbing fallback in miniature: folding a foreign event
// inflates a batch's counts with work that happened elsewhere, and dropping it makes the count
// quietly incomplete while still reading as a total. The caller holds the rollup roster and knows
// which one should have matched, so the refusal carries the subject that found no home and the
// caller decides — open a rollup, or surface the event on its own.

fn observation_rollup_accept(
  rollup: ObservationRollup,
  event: ObservationEvent,
) -> ObservationRollupAccept {
  if observation_subject_contains(ancestor: rollup.subject, descendant: event.subject) {
    RollupAccepted {
      rollup: ObservationRollup {
        subject: rollup.subject,
        counts: observation_counts_accept(counts: rollup.counts, c: observation_event_class(event: event)),
        active_leaf: Present { value: event.subject },
        elapsed: observation_rollup_add_elapsed(acc: rollup.elapsed, reading: observation_wall(event: event)),
        peak_rss: observation_rollup_max_rss(acc: rollup.peak_rss, reading: event.rss),
        measurement_absent: rollup.measurement_absent + observation_measurement_absent_delta(reading: observation_wall(event: event)),
      }
    }
  } else {
    RollupSubjectOutOfScope { subject: event.subject }
  }
}

data observation_rollup_contract: std.disposition.Disposition = Terminal {
  reason: "The rollup fold is a pure reader over the vocabulary this module already owns — subject containment (observation_subject_contains, itself std.effect_grant.path_is_prefix), grain depth, and the single density table. It mints no grain taxonomy, no second collapse rule and no threshold: which grain to roll up to is the consumer's parameter, and when to emit is the renderer's projection over these counts. Terminal because the fold is total over the closed event-class roster; a new class must extend observation_counts_accept, which the exhaustive match forces."
}

// Whether a ledger producer can still append. Three arms, not two, because the reader is not always
// the coordinator: `explain <attempt-dir>` runs with no child handles at all, so every liveness
// input try_wait provided is gone and the reader has files and nothing else. Defaulting that to
// Dead reports a torn record on a healthy run; defaulting it to Live hangs explain on a finished
// one. Unknown is a verdict, not a missing value.
//
// A completed attempt is NOT unknown: all its producers are dead by construction, so explain over a
// terminated attempt gets ProducerDead and a torn tail is genuinely torn.
// The bytes at the end of a producer's file, before any liveness is consulted.
type LedgerTail
  = TailComplete
  | TailIncomplete { bytes: std.nat.Nat }

type ProducerState
  = ProducerLive
  | ProducerDead
  | ProducerLivenessUnknown { cause: std.types.NonEmptyStr }

// THE ORDERING IS THE CARRIER'S SHAPE, not its name. An earlier revision paired a tail with a
// liveness in a record called LivenessAfterRead and claimed the ordering was structural; it was not,
// because both arrived as parameters, so a caller could probe first, read second, and satisfy the
// constructor with the ordering already violated. That is the trap DESIGN section 4b names outright:
// a brand is cosmetic until construction enforces the distinction. Sealing it makes the claim true:
// `probe_liveness_for` is the sole mint and it REQUIRES a LedgerTail, so no
// ProducerLiveness value can come into existence before a tail value does. Check-first has no
// expressible form rather than merely no sanctioned one.
//
// The ordering is load-bearing because liveness is one-way. Check-then-read misclassifies a producer
// that dies in between as live, so its torn tail reads as "poll again" and the reader waits forever
// on a file that will never grow. Read-then-check is sound in both directions: dead after the read
// means the tail can never grow, so it is torn; live means it may still grow, so poll. Deadness does
// not reverse.
//
// WHAT THIS STILL DOES NOT CLOSE, stated so the wall is not read as covering it: the caller goes to
// the filesystem, and no carrier can witness that the tail it passes is the CURRENT tail rather than
// one read earlier and held. Sealing closes "liveness before tail"; it does not close "stale tail,
// fresh liveness". The control at the read seam is therefore still owed, and per DESIGN section 4b
// it stays enrolled as this wall's regression evidence rather than being retired by it.
type ProducerLiveness sole_constructor {
  tail_witnessed: LedgerTail
  state: ProducerState
}

fn probe_liveness_for(tail: LedgerTail, observed: ProducerState) -> ProducerLiveness {
  ProducerLiveness { tail_witnessed: tail, state: observed }
}

type LedgerTailVerdict
  = TailRecordsComplete
  | TailTorn { bytes: std.nat.Nat }
  | TailPending { bytes: std.nat.Nat }
  | TailIndeterminate { bytes: std.nat.Nat, cause: std.types.NonEmptyStr }

fn classify_ledger_tail(observed: ProducerLiveness) -> LedgerTailVerdict {
  match observed.tail_witnessed {
    TailComplete => TailRecordsComplete
    TailIncomplete { bytes: n } =>
      match observed.state {
        ProducerDead => TailTorn { bytes: n }
        ProducerLive => TailPending { bytes: n }
        ProducerLivenessUnknown { cause: c } => TailIndeterminate { bytes: n, cause: c }
      }
  }
}

// ---------------------------------------------------------------------------
// The recorded envelope: what a producer appends, as distinct from what it observed.
// ---------------------------------------------------------------------------

// WHY AN ENVELOPE AND NOT SIX MORE FIELDS ON ObservationEvent. The event answers what happened to
// which subject; the envelope answers who recorded it, when on whose clock, and where it sits in
// the causal tree. Those are facts about the RECORDING, and a producer that could omit them is a
// producer whose output cannot be reduced. Putting them on the event would also make every
// existing constructor of an event carry recording facts it has no business knowing — a render-
// time projection would have to invent an attempt id to build one. The subject path is a
// CONTAINMENT address and the occurrence pair is a CAUSAL edge; they are not the same relation and
// collapsing them loses the distinction between a witness that ran under a batch and one that was
// spawned by another witness.

// A producer is one appending process. There is exactly one file per producer per attempt, and
// sequence numbers are per producer, because a global counter across processes would require the
// coordination the per-producer split exists to avoid.
type ObservationProducer
  = CoordinatorProducer
  | OrdinaryWorkerProducer { worker_index: std.nat.Nat }
  | ScopedWorkerProducer { scope_id: std.types.NonEmptyStr }

fn observation_producer_key(p: ObservationProducer) -> String {
  match p {
    CoordinatorProducer => "coordinator"
    OrdinaryWorkerProducer { worker_index: i } => concat("ordinary-worker-", to_string(i))
    ScopedWorkerProducer { scope_id: s } => concat("scoped-", s)
  }
}

fn observation_producer_eq(a: ObservationProducer, b: ObservationProducer) -> Bool {
  observation_producer_key(p: a) == observation_producer_key(p: b)
}

// AN OCCURRENCE ID IS AN ATTEMPT-LOCAL COORDINATE, so it carries the attempt it is local to. The
// bare-string form typechecked a comparison across two attempts and answered it — and comparing
// receipts from two attempts is the whole point of the falsifier, so the meaningless join was on the
// path of the first consumer. It is the cross-family comparison the ContentHash family grounding
// closed, with attempts standing where hash families
// stood: same representation, different universes, comparable by construction and meaningless when
// compared.
//
// THE RULE THIS MAKES STRUCTURAL: a cross-attempt join keys on the SUBJECT — the containment path,
// which is the semantic thing two attempts genuinely share — never on occurrence. Occurrences are
// minted independently per attempt, so an id appearing in both is either the same string by accident
// or the same subject by luck, and nothing in a bare string distinguishes those.
type OccurrenceId {
  attempt: std.types.NonEmptyStr
  id: std.types.NonEmptyStr
}

// Three-valued for the same reason `compare_instants` is: a cross-attempt pair is not "different",
// it is UNANSWERABLE, and the two carry different remedies. Different means these are two occurrences
// in one run; cross-attempt means the caller asked a question occurrence identity cannot answer and
// should have keyed on the subject.
type OccurrenceComparison
  = SameOccurrence
  | DifferentOccurrence
  | OccurrenceCrossAttempt { left: std.types.NonEmptyStr, right: std.types.NonEmptyStr }

fn compare_occurrences(a: OccurrenceId, b: OccurrenceId) -> OccurrenceComparison {
  if a.attempt != b.attempt {
    OccurrenceCrossAttempt { left: a.attempt, right: b.attempt }
  } else {
    if a.id == b.id { SameOccurrence } else { DifferentOccurrence }
  }
}

// THE PARENT CARRIES ONLY ITS ID, AND THE ATTEMPT IS DERIVED FROM THE CHILD. A spawn edge cannot
// cross attempts — a process in one attempt did not spawn an occurrence in another — so a full
// OccurrenceId here would have made that impossible edge writable, the same hole one level down.
// Reconstruct the parent through `parent_occurrence`, which takes the attempt from the record that
// declares the edge.
type OccurrenceOrigin
  = RootOccurrence
  | ChildOf { parent_id: std.types.NonEmptyStr }

// NO SEPARATE `attempt` FIELD: the occurrence carries it, and a second copy beside it is a fact with
// two homes that can disagree (DESIGN section 3). The attempt of a record is read through its
// occurrence.
type RecordedObservation {
  producer: ObservationProducer
  producer_sequence: std.nat.Nat
  occurrence: OccurrenceId
  origin: OccurrenceOrigin
  at: std.measure.ObservationInstant
  event: ObservationEvent
}

fn recorded_attempt(r: RecordedObservation) -> std.types.NonEmptyStr {
  r.occurrence.attempt
}

fn parent_occurrence(r: RecordedObservation) -> OccurrenceId? {
  match r.origin {
    RootOccurrence => Absent
    ChildOf { parent_id: p } => Present { value: OccurrenceId { attempt: r.occurrence.attempt, id: p } }
  }
}

// ---------------------------------------------------------------------------
// Per-file sequence integrity.
// ---------------------------------------------------------------------------

// A GAP AND A REORDER ARE DIFFERENT FACTS WITH DIFFERENT REMEDIES, so they are different verdicts.
// A gap means records exist that this read did not see — a lost write, a truncated middle, a
// reader that skipped — and the reduction is INCOMPLETE, so any attribution derived from it
// understates. A reorder means the file is not what the append protocol promises and the producer
// itself is wrong. Reporting either as the other sends the investigation to the wrong layer. And a
// records-from-two-producers verdict is not a sequence defect at all: sequences are per producer,
// so two producers in one file means the layout invariant broke upstream of any ordering question.

type SequenceVerdict
  = SequenceIntact
  | SequenceGap { after: std.nat.Nat, before: std.nat.Nat }
  | SequenceReordered { at_index: std.nat.Nat, previous: std.nat.Nat, observed: std.nat.Nat }
  | SequenceForeignProducer { expected: String, observed: String }
  | SequenceEmpty

// Enumerated rather than wildcarded: a `_ => a` arm here would keep every future verdict silently on
// the first-defect-wins side, which is right for a defect and wrong for any arm that means "nothing
// seen yet". Listing them makes a new verdict a compile-time decision instead of an inherited one.
fn sequence_verdict_meet(a: SequenceVerdict, b: SequenceVerdict) -> SequenceVerdict {
  match a {
    SequenceIntact => b
    SequenceEmpty => b
    SequenceGap { after: _, before: _ } => a
    SequenceReordered { at_index: _, previous: _, observed: _ } => a
    SequenceForeignProducer { expected: _, observed: _ } => a
  }
}

type SequenceScan {
  started: Bool
  prev_key: String
  prev_sequence: std.nat.Nat
  verdict: SequenceVerdict
}

fn sequence_scan_step(acc: SequenceScan, r: RecordedObservation) -> SequenceScan {
  let key = observation_producer_key(p: r.producer)
  let seq = r.producer_sequence
  if !acc.started {
    SequenceScan { started: true, prev_key: key, prev_sequence: seq, verdict: SequenceIntact }
  } else {
    let step =
      if key != acc.prev_key {
        SequenceForeignProducer { expected: acc.prev_key, observed: key }
      } else {
        if seq <= acc.prev_sequence {
          SequenceReordered { at_index: seq, previous: acc.prev_sequence, observed: seq }
        } else {
          if seq > acc.prev_sequence + 1 {
            SequenceGap { after: acc.prev_sequence, before: seq }
          } else {
            SequenceIntact
          }
        }
      }
    SequenceScan {
      started: true,
      prev_key: key,
      prev_sequence: seq,
      verdict: sequence_verdict_meet(a: acc.verdict, b: step),
    }
  }
}

// The first defect wins and later records cannot green it: once a gap is seen the reduction is
// incomplete no matter how clean the tail reads.
fn classify_producer_file(records: List<RecordedObservation>) -> SequenceVerdict {
  fold_list(
    records,
    SequenceScan { started: false, prev_key: "", prev_sequence: 0, verdict: SequenceEmpty },
    (acc, r) => sequence_scan_step(acc: acc, r: r)
  ).verdict
}

// ---------------------------------------------------------------------------
// Resolving a spawn edge, which crosses producer files.
// ---------------------------------------------------------------------------

// A PARENT THAT RESOLVES TO NOTHING IS TWO FACTS WITH OPPOSITE MEANINGS. The active stack walks
// ChildOf across producer files — a worker occurrence is
// ChildOf an occurrence the COORDINATOR recorded, because the coordinator is what spawned the
// worker — so a parent absent from the file in hand is the NORMAL case for every worker-rooted
// occurrence, not damage; it means the reader was handed one file where it needed the attempt's
// union. A parent absent from every file of the attempt is a real integrity failure: a Begin was
// never written, or a record was lost somewhere other than the torn tail. Collapsed into one
// DanglingParent arm the failure runs both ways — a single-file read reports damage on a healthy
// attempt, or a genuinely lost parent reads as 'probably in another file' and the stack SILENTLY
// RE-ROOTS. The second is the dangerous one, because a re-rooted occurrence does not look like an
// error; it looks like a shallower stack, which is a plausible answer to 'where was it' that
// happens to be wrong. The discriminator is whether the read was scoped to one producer or to the
// union, which the READER knows and the record does not — so, exactly like producer liveness, it
// is a required input rather than a fact derivable from the bytes.

type LedgerReadScope
  = SingleProducerRead { producer: ObservationProducer }
  | AttemptUnionRead

type ParentResolution
  = OccurrenceIsRoot
  | ParentResolved { parent: OccurrenceId }
  | ParentOutsideReadScope { scope: ObservationProducer, parent_id: std.types.NonEmptyStr }
  | ParentMissingFromAttempt { parent_id: std.types.NonEmptyStr }

fn occurrence_present_in(records: List<RecordedObservation>, target: OccurrenceId) -> Bool {
  fold_list(records, false, (acc, r) =>
    acc || (r.occurrence.id == target.id && r.occurrence.attempt == target.attempt))
}

// The scope is a PARAMETER, so a caller holding one producer's file cannot reach the
// missing-from-attempt verdict at all — that arm is unreachable under SingleProducerRead, and the
// only way to claim a parent is lost is to have read the union.
fn resolve_parent(
  child: RecordedObservation,
  records: List<RecordedObservation>,
  scope: LedgerReadScope,
) -> ParentResolution {
  match parent_occurrence(r: child) {
    Absent => OccurrenceIsRoot
    Present { value: p } =>
      if occurrence_present_in(records: records, target: p) {
        ParentResolved { parent: p }
      } else {
        match scope {
          SingleProducerRead { producer: prod } =>
            ParentOutsideReadScope { scope: prod, parent_id: p.id }
          AttemptUnionRead => ParentMissingFromAttempt { parent_id: p.id }
        }
      }
  }
}

// ---------------------------------------------------------------------------
// The active set: which occurrences a killed attempt was inside.
// ---------------------------------------------------------------------------

// AN UNFINISHED OCCURRENCE IS A POPULATION, NOT A LATEST RECORD. When a producer is SIGKILLed the
// question 'what was it doing' has a set answer — every occurrence that recorded a Begin and no
// conclusion — because occurrences nest: a gate inside a batch inside a worker inside the attempt
// are all unfinished at once, and reporting only the deepest one, or only the last record written,
// discards the containment that makes the answer useful. THE LAST COMPLETE RECORD IS NOT THE LAST
// ACTIVE OCCURRENCE, and conflating them is how a torn tail produces a confident wrong answer: the
// final bytes may belong to a sibling that finished while its parent was still running, so 'the
// last thing in the file' names something already over. The set is derived from Begin-without-
// conclusion across the records actually read, and it is therefore only as complete as the read —
// which is why the read scope travels with it rather than being assumed.

type ActiveOccurrences {
  scope: LedgerReadScope
  occurrences: List<OccurrenceId>
}

fn occurrence_concluded_in(records: List<RecordedObservation>, target: OccurrenceId) -> Bool {
  fold_list(records, false, (acc, r) =>
    acc || (r.occurrence.id == target.id
      && r.occurrence.attempt == target.attempt
      && match r.event.transition { Concluded { outcome: _ } => true, _ => false }))
}

fn active_occurrences(
  records: List<RecordedObservation>,
  scope: LedgerReadScope,
) -> ActiveOccurrences {
  let begun = filter(records, r => match r.event.transition { Begin => true, _ => false })
  let unfinished = filter(begun, r => !occurrence_concluded_in(records: records, target: r.occurrence))
  ActiveOccurrences { scope: scope, occurrences: map(unfinished, r => r.occurrence) }
}
