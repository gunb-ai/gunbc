module std.decl_ref

import std.types { NonEmptyStr, String, Bool }

type DeclField
  = WholeDeclaration
  | NamedField { field_name: NonEmptyStr }

type DeclarationRef {
  module_path: NonEmptyStr
  decl_name: NonEmptyStr
  field: DeclField
}

data decl_ref_constructor_authority_note: String = "The constructors live HERE, beside the type they construct — single authority (DESIGN section 3). Two parallel lanes each minted an identical fn decl_ref/decl_field_ref pair (std.primitive_identity and std.roster_frontier, both 2026-08-01), and because v1-seed fn names are not module-scoped, any closure containing both modules refused every bare decl_ref reference as ambiguous — the collision that redded the primitive_identity_join witness closure on main. Both duplicates are deleted in favor of these; a module needing a DeclarationRef imports the constructor from the type's own module, never re-mints it."

// WHETHER A TRUE CITATION IS EVEN ASKABLE OF THE RESOLVER. Distinct from whether it resolves:
// `v2.std.decl_index` `decl_facts` SKIPS TEST .dag FILES DELIBERATELY (gunbc.ci_layer_roots records
// the exclusion in the row that exists because a second walk must NOT skip them), so a declaration
// authored in a witness module is absent from the index while its MODULE is present in
// `module_declaration_facts_live`. A reference to it is TRUE and UNRESOLVABLE at the same time, and
// those are different facts: resolution answers "does this name a real declaration", coverage
// answers "is this declaration inside the universe the resolver indexes".
//
// This exists so the second answer is CARRIED AND COUNTED rather than handled by dropping the row
// from a population. A carrier that excluded its uncitable rows would report a green meaning
// "nothing left to check"; carrying the disposition makes it mean "N resolved, M outside the index,
// here is which and why" — the number stays readable, which is the whole difference.
// One axis, one variant per reason a declaration sits outside the index — NOT a wrapper carrying a
// nested class enum. A single-variant coproduct is read as a type ALIAS here, which is the §3
// hollow-alias shape and, measured, does not even export its name.
type CitationIndexCoverage
  = CitableThroughDeclIndex
  | OutsideDeclIndexTestWitnessModule

fn citation_is_outside_index(coverage: CitationIndexCoverage) -> Bool {
  match coverage {
    CitableThroughDeclIndex => false
    OutsideDeclIndexTestWitnessModule => true
  }
}

fn decl_ref(module_path: String, decl_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path as NonEmptyStr,
    decl_name: decl_name as NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn decl_field_ref(module_path: String, decl_name: String, field_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path as NonEmptyStr,
    decl_name: decl_name as NonEmptyStr,
    field: NamedField { field_name: field_name as NonEmptyStr },
  }
}

// ONE STABLE TOKEN PER DeclField ARM, DECLARED BESIDE THE TYPE IT PROJECTS.
//
// A consumer folding a DeclarationRef into a content address needs a String for the field, and two
// consumers now do. Spelling that projection at each consumer would fork it, and the fork would be
// invisible: two addresses over one reference, each internally consistent, disagreeing only where
// nobody compares them.
//
// THE ARM TAG IS NOT DECORATION AND ITS ABSENCE WAS A REAL DEFECT. Returning the field name bare
// makes NamedField { field_name: "whole_declaration" } and WholeDeclaration fold to the same value
// while decl_field_eq correctly reports them different -- the comparison and the address disagreeing
// about what a reference is. ":" cannot appear inside a bare field name, so the tag makes a payload
// unable to impersonate the nullary arm. A total match guarantees every arm is CONSIDERED; only a
// distinct codomain makes the labelling injective, and a hash fold needs the second.
//
// A THIRD PROJECTION EXISTS AND IS NAMED RATHER THAN QUIETLY TOLERATED: std.observation
// `observation_decl_field_key` spells the same arms "whole" and "field=<n>". It is injective, so it
// is not defective, but it is a second answer to one question living outside this type's authority.
// It is NOT dissolved here because its output is a key other carriers build on, so changing its
// spelling is a behavioural change to those consumers rather than a rename -- that dissolution is
// its own change under its own owner. Recorded so the next author folding a DeclField picks a
// projection deliberately instead of discovering the fork by minting a fourth.
fn decl_field_label(field: DeclField) -> String {
  match field {
    WholeDeclaration => "whole_declaration"
    NamedField { field_name: n } => concat("named_field:", n)
  }
}

fn decl_field_eq(a: DeclField, b: DeclField) -> Bool {
  match a {
    WholeDeclaration =>
      match b {
        WholeDeclaration => true
        NamedField { field_name: _ } => false
      }
    NamedField { field_name: fa } =>
      match b {
        WholeDeclaration => false
        NamedField { field_name: fb } => fa == fb
      }
  }
}

fn declaration_ref_eq(a: DeclarationRef, b: DeclarationRef) -> Bool {
  a.module_path == b.module_path
    && a.decl_name == b.decl_name
    && decl_field_eq(a: a.field, b: b.field)
}

fn declaration_ref_in_list(target: DeclarationRef, refs: List<DeclarationRef>) -> Bool {
  fold(refs, init: false, f: fn(acc, r) { acc || declaration_ref_eq(a: target, b: r) })
}

fn declaration_ref_display_key(ref: DeclarationRef) -> String {
  match ref.field {
    WholeDeclaration =>
      concat(ref.module_path as String, concat("::", ref.decl_name as String))
    NamedField { field_name: f } =>
      concat(
        ref.module_path as String,
        concat("::", concat(ref.decl_name as String, concat("::", f as String))),
      )
  }
}
