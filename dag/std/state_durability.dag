module std.state_durability


data state_durability_boundary_contract: std.disposition.Disposition = std.disposition.Terminal {
  reason: "Desired world-state lifetime is explicit before realization: RuntimeLifetimeOnly or DurableAcross named lifecycle boundaries. The closed boundary coproduct prevents a generic Persistent label from standing in for service restart, control-plane restart, host restart, power loss, software replacement, or factory reset."
}

data state_durability_separation_note: String = "State durability is neither extdeps.storage.types.PersistenceKind nor std.materialization_ladder. PersistenceKind describes a storage device/medium; the materialization ladder decides where redundant computation is retained. This module asks a different reconciliation question: across WHICH lifecycle boundary must desired world state remain effective, can the selected realizer provide that lifetime with a commit barrier, and has that exact target + desired state + realization + capability generation been qualified by a perturbation and independent readback? Keeping the facts separate prevents a writable filesystem, an extant file, current runtime effectiveness, or a stale receipt from being misclassified as durable convergence."

type LifecycleRestartMode
  = LifecycleGracefulRestart
  | LifecycleForcedRestart

type PowerLossScope
  = ControlPlanePowerLoss
  | HostPowerLoss
  | SitePowerLoss

type SoftwareReplacementScope
  = ControlPlaneFirmwareReplacement
  | HostOsReplacement
  | ApplicationReplacement

type StateDurabilityBoundary
  = ServiceRestartBoundary
  | ControlPlaneRestartBoundary { mode: std.state_durability.LifecycleRestartMode }
  | HostRestartBoundary { mode: std.state_durability.LifecycleRestartMode }
  | PowerLossBoundary { scope: std.state_durability.PowerLossScope }
  | SoftwareReplacementBoundary { scope: std.state_durability.SoftwareReplacementScope }
  | FactoryResetBoundary

type StateDurabilityIntent
  = DurabilityUnspecified
  | RuntimeLifetimeOnly
  | DurableAcross { boundaries: std.state_durability.StateDurabilityBoundaryRequirements }

type StateDurabilityBoundaryRequirements {
  first: std.state_durability.StateDurabilityBoundary
  additional_unique: List<std.state_durability.StateDurabilityBoundary>
}

data state_durability_boundary_uniqueness_scaffold_note: String = "🟡 dissolve-on: docs/plans/hollow-alias-construction-wall.md makes refinement/bodyless declarations construction-enforced after its lens-first corpus proof. Nonemptiness is already unwritable through first + additional_unique. Uniqueness is decidable but remains a typed, reachable, counted refusal because .dag record literals are public and refinements are not construction-enforced; Set is the non-enumerable PointwisePower while durability qualification must enumerate every boundary. This is a corpus-wide language gap also visible in bare proof wrappers such as ValidatedGrammarRoot and ValidatedBmcFanCurve, not a license for a Map-as-set or bitset nickname."

type StateDurabilityBoundaryRequirementBuild {
  ordered: List<std.state_durability.StateDurabilityBoundary>
}

fn state_durability_boundary_requirements(
  first: std.state_durability.StateDurabilityBoundary,
  additional: List<std.state_durability.StateDurabilityBoundary>,
) -> std.state_durability.StateDurabilityBoundaryRequirements {
  let built = fold(
    additional,
    init: std.state_durability.StateDurabilityBoundaryRequirementBuild {
      ordered: [first],
    },
    f: (acc, boundary) =>
      if any(acc.ordered, existing => existing == boundary) {
        acc
      } else {
        StateDurabilityBoundaryRequirementBuild {
          ordered: append(acc.ordered, items: [boundary]),
        }
      },
  )
  StateDurabilityBoundaryRequirements {
    first: first,
    additional_unique: built.ordered.skip(n: 1),
  }
}

fn state_durability_boundary_requirement_list(
  requirements: std.state_durability.StateDurabilityBoundaryRequirements,
) -> std.types.List<std.state_durability.StateDurabilityBoundary> {
  append([requirements.first], items: requirements.additional_unique)
}

type DurabilityCommitBarrier
  = NoDurabilityCommitBarrier
  | SynchronizedCommit

type StateRealizationIdentity {
  realization_id: std.types.NonEmptyStr
  definition_linkages: std.state_durability.StateRealizationDefinitionLinkages
}

// Authored ONCE and projected through every row. The condition is one fact
// about the whole class -- caller-asserted linkage retires when the namespace
// lane lands its content-addressed SymbolIndex subtree digest -- so copying the
// sentence per row would be the same prose duplication this migration removes.
data symbol_index_subtree_digest_dissolution: std.dissolution.DissolutionCondition = unbound_dissolution(description: "namespace content-addressed SymbolIndex subtree digest")

type StateDefinitionLinkage
  = CallerAssertedDefinitionLinkage {
      reason: std.types.NonEmptyStr,
      dissolution: std.dissolution.DissolutionCondition,
    }

type StateDefinitionRole
  = RealizationProjectionDefinition
  | RealizationVerifierDefinition
  | RealizationObserverDefinition
  | RealizationTransportDefinition
  | RealizationActuatorDefinition
  | DurabilityCapabilityDefinition

type StateDefinitionCallerAssertion {
  role: std.state_durability.StateDefinitionRole
  reason: std.types.NonEmptyStr
  dissolution: std.dissolution.DissolutionCondition
}

type StateRealizationDefinitionLinkages {
  projection: std.state_durability.StateDefinitionLinkage
  verifier: std.state_durability.StateDefinitionLinkage
  observer: std.state_durability.StateDefinitionLinkage
  transport: std.state_durability.StateDefinitionLinkage
  actuator: std.state_durability.StateDefinitionLinkage
}

data state_definition_linkage_frontier_note: String = "🟡 dissolve-on: the namespace-only resolution lane lands its content-addressed SymbolIndex containment tree. Until then, every realization and capability definition is CallerAssertedDefinitionLinkage and durable qualification refuses with typed, located, counted assertions. The future mechanically-hashed arm MUST carry an opaque subtree-digest type whose only constructor is the SymbolIndex subtree-hashing operation; a bare ContentHash field is forbidden because callers could forge it from a label and recreate the lie this frontier removes."

type StateDefinitionLinkageVerdict
  = StateDefinitionLinkageEvidence {
      role: std.state_durability.StateDefinitionRole,
    }
  | StateDefinitionLinkageUnavailable {
      assertion: std.state_durability.StateDefinitionCallerAssertion,
    }

type StateDefinitionLinkageAdmissionVerdict
  = StateDefinitionLinkageAdmissionPermitted
  | StateDefinitionLinkageAdmissionBlocked {
      assertions: List<std.state_durability.StateDefinitionCallerAssertion>,
    }

fn state_definition_linkage_verdict(
  role: std.state_durability.StateDefinitionRole,
  linkage: std.state_durability.StateDefinitionLinkage,
) -> std.state_durability.StateDefinitionLinkageVerdict {
  match linkage {
    CallerAssertedDefinitionLinkage {
      reason: reason,
      dissolution: dissolution,
    } =>
      StateDefinitionLinkageUnavailable {
        assertion: std.state_durability.StateDefinitionCallerAssertion {
          role: role,
          reason: reason,
          dissolution: dissolution,
        },
      }
  }
}

fn state_durability_definition_linkage_verdicts<Target, ReadbackSubject>(
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
) -> std.types.List<std.state_durability.StateDefinitionLinkageVerdict> {
  [
    state_definition_linkage_verdict(
      role: RealizationProjectionDefinition,
      linkage: admission.realization.definition_linkages.projection,
    ),
    state_definition_linkage_verdict(
      role: RealizationVerifierDefinition,
      linkage: admission.realization.definition_linkages.verifier,
    ),
    state_definition_linkage_verdict(
      role: RealizationObserverDefinition,
      linkage: admission.realization.definition_linkages.observer,
    ),
    state_definition_linkage_verdict(
      role: RealizationTransportDefinition,
      linkage: admission.realization.definition_linkages.transport,
    ),
    state_definition_linkage_verdict(
      role: RealizationActuatorDefinition,
      linkage: admission.realization.definition_linkages.actuator,
    ),
    state_definition_linkage_verdict(
      role: DurabilityCapabilityDefinition,
      linkage: admission.capability_version.definition_linkage,
    ),
  ]
}

fn state_durability_definition_linkage_unavailable_assertions(
  verdicts: List<std.state_durability.StateDefinitionLinkageVerdict>,
) -> std.types.List<std.state_durability.StateDefinitionCallerAssertion> {
  fold(
    verdicts,
    init: [],
    f: (assertions, verdict) =>
      match verdict {
        StateDefinitionLinkageUnavailable { assertion: assertion } =>
          append(assertions, items: [assertion])
        StateDefinitionLinkageEvidence { role: _ } => assertions
      },
  )
}

fn state_durability_definition_linkage_admission_verdict(
  verdicts: List<std.state_durability.StateDefinitionLinkageVerdict>,
) -> std.state_durability.StateDefinitionLinkageAdmissionVerdict {
  let unavailable = state_durability_definition_linkage_unavailable_assertions(
    verdicts: verdicts,
  )
  if list_length(unavailable) > 0 {
    StateDefinitionLinkageAdmissionBlocked {
      assertions: unavailable,
    }
  } else {
    StateDefinitionLinkageAdmissionPermitted
  }
}

fn state_durability_definition_linkage_refusal<Target, ReadbackSubject>(
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
) -> std.state_durability.StateDurabilityRefusal<Target, ReadbackSubject>? {
  match state_durability_definition_linkage_admission_verdict(
    verdicts: state_durability_definition_linkage_verdicts(admission: admission),
  ) {
    StateDefinitionLinkageAdmissionBlocked { assertions: assertions } =>
      Present {
        value: DurabilityDefinitionLinkageUnavailable {
          realization: admission.realization,
          capability: admission.capability_version,
          assertions: assertions,
          count: list_length(assertions),
        },
      }
    StateDefinitionLinkageAdmissionPermitted => none
  }
}

type StateDurabilityCapabilityVersion {
  version: std.types.NonEmptyStr
  definition_linkage: std.state_durability.StateDefinitionLinkage
}

type StatePerturbationGeneration =
  Int where range(min: 1), brand("StatePerturbationGeneration")

type StateDurabilityInstant = std.types.EpochMs

type StateDurabilityAdmission<Target, ReadbackSubject> {
  target: Target
  desired_state_digest: extdeps.crypto.hash.Digest
  realization: std.state_durability.StateRealizationIdentity
  capability_version: std.state_durability.StateDurabilityCapabilityVersion
  perturbation_generation: std.state_durability.StatePerturbationGeneration
  readback_subject: ReadbackSubject
}

type StateDurabilityCapability {
  realization: std.state_durability.StateRealizationIdentity
  capability_version: std.state_durability.StateDurabilityCapabilityVersion
  supported_boundaries: List<std.state_durability.StateDurabilityBoundary>
  commit_barrier: std.state_durability.DurabilityCommitBarrier
}

type StatePerturbationReceipt<Target> {
  receipt_id: std.types.NonEmptyStr
  target: Target
  boundary: std.state_durability.StateDurabilityBoundary
  generation: std.state_durability.StatePerturbationGeneration
  started_after_before_readback: std.measure.PositiveMillisecond
  duration: std.measure.PositiveMillisecond
}

type StateBeforeReadbackReceipt<Target, ReadbackSubject> {
  perturbation_receipt_id: std.types.NonEmptyStr
  target: Target
  subject: ReadbackSubject
  state_digest: extdeps.crypto.hash.Digest
  observed_at: std.state_durability.StateDurabilityInstant
}

type StateAfterReadbackReceipt<Target, ReadbackSubject> {
  perturbation_receipt_id: std.types.NonEmptyStr
  target: Target
  subject: ReadbackSubject
  state_digest: extdeps.crypto.hash.Digest
  observed_after_perturbation_completion: std.measure.PositiveMillisecond
}

fn state_durability_perturbation_started_at<Target, ReadbackSubject>(
  before: std.state_durability.StateBeforeReadbackReceipt<Target, ReadbackSubject>,
  perturbation: std.state_durability.StatePerturbationReceipt<Target>,
) -> std.state_durability.StateDurabilityInstant {
  let instant = before.observed_at + positive_millisecond_count(
    m: perturbation.started_after_before_readback,
  )
  instant
}

fn state_durability_perturbation_completed_at<Target, ReadbackSubject>(
  before: std.state_durability.StateBeforeReadbackReceipt<Target, ReadbackSubject>,
  perturbation: std.state_durability.StatePerturbationReceipt<Target>,
) -> std.state_durability.StateDurabilityInstant {
  let instant = state_durability_perturbation_started_at(
    before: before,
    perturbation: perturbation,
  ) + positive_millisecond_count(
    m: perturbation.duration,
  )
  instant
}

fn state_durability_after_readback_at<Target, ReadbackSubject>(
  before: std.state_durability.StateBeforeReadbackReceipt<Target, ReadbackSubject>,
  perturbation: std.state_durability.StatePerturbationReceipt<Target>,
  after: std.state_durability.StateAfterReadbackReceipt<Target, ReadbackSubject>,
) -> std.state_durability.StateDurabilityInstant {
  let instant = state_durability_perturbation_completed_at(
    before: before,
    perturbation: perturbation,
  ) + positive_millisecond_count(
    m: after.observed_after_perturbation_completion,
  )
  instant
}

type StateActivationReceipt<Target, ReadbackSubject> {
  perturbation_receipt_id: std.types.NonEmptyStr
  target: Target
  subject: ReadbackSubject
  desired_state_digest: extdeps.crypto.hash.Digest
  realization: std.state_durability.StateRealizationIdentity
  capability_version: std.state_durability.StateDurabilityCapabilityVersion
  perturbation_generation: std.state_durability.StatePerturbationGeneration
}

type StateActivationEvidence<Target, ReadbackSubject>
  = ActivationVerified {
      receipt: std.state_durability.StateActivationReceipt<Target, ReadbackSubject>,
    }
  | ActivationUnverified { reason: String }

type StatePreservationOutcome<Target, ReadbackSubject>
  = StatePreserved {
      before: std.state_durability.StateBeforeReadbackReceipt<Target, ReadbackSubject>,
      after: std.state_durability.StateAfterReadbackReceipt<Target, ReadbackSubject>,
      activation: std.state_durability.StateActivationEvidence<Target, ReadbackSubject>,
    }
  | StateLost {
      before: std.state_durability.StateBeforeReadbackReceipt<Target, ReadbackSubject>,
      after: std.state_durability.StateAfterReadbackReceipt<Target, ReadbackSubject>,
      reason: String,
    }
  | StatePreservationObservationRefused { reason: String }

type StateDurabilityEvidence<Target, ReadbackSubject> {
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>
  perturbation: std.state_durability.StatePerturbationReceipt<Target>
  outcome: std.state_durability.StatePreservationOutcome<Target, ReadbackSubject>
}

type StateReadbackPosition
  = BeforeBoundaryReadback
  | AfterBoundaryReadback

type StateDurabilityRefusal<Target, ReadbackSubject>
  = DurabilityIntentUnspecified
  | DurabilityRequirementDuplicate {
      boundary: std.state_durability.StateDurabilityBoundary,
      count: Int,
    }
  | DurabilityCapabilityMissing
  | DurabilityDefinitionLinkageUnavailable {
      realization: std.state_durability.StateRealizationIdentity,
      capability: std.state_durability.StateDurabilityCapabilityVersion,
      assertions: List<std.state_durability.StateDefinitionCallerAssertion>,
      count: Int,
    }
  | DurabilityCapabilityAdmissionMismatch {
      expected_realization: std.state_durability.StateRealizationIdentity,
      observed_realization: std.state_durability.StateRealizationIdentity,
      expected_capability_version: std.state_durability.StateDurabilityCapabilityVersion,
      observed_capability_version: std.state_durability.StateDurabilityCapabilityVersion,
    }
  | DurabilityCommitBarrierMissing {
      realization: std.state_durability.StateRealizationIdentity,
    }
  | DurabilityBoundaryUnsupported {
      realization: std.state_durability.StateRealizationIdentity,
      boundary: std.state_durability.StateDurabilityBoundary,
    }
  | DurabilityEvidenceMissing {
      admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
      boundary: std.state_durability.StateDurabilityBoundary,
    }
  | DurabilityEvidenceAmbiguous {
      admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
      boundary: std.state_durability.StateDurabilityBoundary,
      count: Int,
    }
  | DurabilityPerturbationTargetMismatch {
      expected: Target,
      observed: Target,
    }
  | DurabilityPerturbationBoundaryMismatch {
      expected: std.state_durability.StateDurabilityBoundary,
      observed: std.state_durability.StateDurabilityBoundary,
    }
  | DurabilityPerturbationGenerationMismatch {
      expected: std.state_durability.StatePerturbationGeneration,
      observed: std.state_durability.StatePerturbationGeneration,
    }
  | DurabilityReadbackReceiptLinkMismatch {
      position: std.state_durability.StateReadbackPosition,
      expected_receipt_id: std.types.NonEmptyStr,
      observed_receipt_id: std.types.NonEmptyStr,
    }
  | DurabilityReadbackTargetMismatch {
      position: std.state_durability.StateReadbackPosition,
      expected: Target,
      observed: Target,
    }
  | DurabilityReadbackSubjectMismatch {
      position: std.state_durability.StateReadbackPosition,
      expected: ReadbackSubject,
      observed: ReadbackSubject,
    }
  | DurabilityDesiredStateMismatch {
      desired: extdeps.crypto.hash.Digest,
      before: extdeps.crypto.hash.Digest,
      after: extdeps.crypto.hash.Digest,
    }
  | DurabilityActivationReceiptLinkMismatch {
      expected_receipt_id: std.types.NonEmptyStr,
      observed_receipt_id: std.types.NonEmptyStr,
    }
  | DurabilityActivationScopeMismatch {
      expected: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
      observed: std.state_durability.StateActivationReceipt<Target, ReadbackSubject>,
    }
  | DurabilityActivationUnverified { reason: String }
  | DurabilityStateLost {
      before: std.state_durability.StateBeforeReadbackReceipt<Target, ReadbackSubject>,
      after: std.state_durability.StateAfterReadbackReceipt<Target, ReadbackSubject>,
      reason: String,
    }
  | DurabilityObservationRefused { reason: String }

type StateDurabilityQualification<Target, ReadbackSubject>
  = RuntimeLifetimeQualification {
      admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
    }
  | DurableLifetimeQualification {
      admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
      capability: std.state_durability.StateDurabilityCapability,
      boundaries: std.state_durability.StateDurabilityBoundaryRequirements,
      evidence: List<std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>>,
    }

type StateDurabilityVerdict<Target, ReadbackSubject>
  = StateDurabilityQualified {
      qualification: std.state_durability.StateDurabilityQualification<Target, ReadbackSubject>,
    }
  | StateDurabilityRefused {
      cause: std.state_durability.StateDurabilityRefusal<Target, ReadbackSubject>,
    }

type StateDurabilityEvidenceCardinality<Target, ReadbackSubject>
  = NoMatchingDurabilityEvidence
  | OneMatchingDurabilityEvidence {
      evidence: std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>,
    }
  | MultipleMatchingDurabilityEvidence { count: Int }

type StateDurabilityEvidenceVerdict<Target, ReadbackSubject>
  = StateDurabilityEvidenceAccepted {
      evidence: List<std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>>,
    }
  | StateDurabilityEvidenceRefused {
      cause: std.state_durability.StateDurabilityRefusal<Target, ReadbackSubject>,
    }

type StateDurabilityBoundaryUniquenessFold {
  seen: List<std.state_durability.StateDurabilityBoundary>
  duplicate: std.state_durability.StateDurabilityBoundary?
  duplicate_count: Int
}

fn state_durability_boundary_requirements_refusal<Target, ReadbackSubject>(
  requirements: std.state_durability.StateDurabilityBoundaryRequirements,
) -> std.state_durability.StateDurabilityRefusal<Target, ReadbackSubject>? {
  let boundaries = state_durability_boundary_requirement_list(
    requirements: requirements,
  )
  let folded = fold(
    boundaries,
    init: std.state_durability.StateDurabilityBoundaryUniquenessFold {
      seen: [],
      duplicate: none,
      duplicate_count: 0,
    },
    f: (acc, boundary) =>
      match acc.duplicate {
        Present { value: duplicate } =>
          if boundary == duplicate {
            StateDurabilityBoundaryUniquenessFold {
              seen: acc.seen,
              duplicate: acc.duplicate,
              duplicate_count: acc.duplicate_count + 1,
            }
          } else {
            acc
          }
        Absent =>
          if any(acc.seen, existing => existing == boundary) {
            StateDurabilityBoundaryUniquenessFold {
              seen: acc.seen,
              duplicate: Present { value: boundary },
              duplicate_count: 2,
            }
          } else {
            StateDurabilityBoundaryUniquenessFold {
              seen: append(acc.seen, items: [boundary]),
              duplicate: none,
              duplicate_count: 0,
            }
          }
      },
  )
  match folded.duplicate {
    Present { value: boundary } =>
      Present {
        value: DurabilityRequirementDuplicate {
          boundary: boundary,
          count: folded.duplicate_count,
        },
      }
    Absent => none
  }
}

fn state_durability_admission_eq<Target, ReadbackSubject>(
  a: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
  b: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
) -> Bool {
  a.target == b.target
    && a.desired_state_digest == b.desired_state_digest
    && a.realization == b.realization
    && a.capability_version == b.capability_version
    && a.perturbation_generation == b.perturbation_generation
    && a.readback_subject == b.readback_subject
}

fn state_durability_capability_matches_admission<Target, ReadbackSubject>(
  capability: std.state_durability.StateDurabilityCapability,
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
) -> Bool {
  capability.realization == admission.realization
    && capability.capability_version == admission.capability_version
}

fn state_durability_evidence_cardinality<Target, ReadbackSubject>(
  evidence: List<std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>>,
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
  boundary: std.state_durability.StateDurabilityBoundary,
) -> std.state_durability.StateDurabilityEvidenceCardinality<Target, ReadbackSubject> {
  fold(
    evidence,
    init: NoMatchingDurabilityEvidence,
    f: (cardinality, candidate) =>
      if state_durability_admission_eq(
        a: candidate.admission,
        b: admission,
      ) && candidate.perturbation.boundary == boundary {
        match cardinality {
          NoMatchingDurabilityEvidence =>
            OneMatchingDurabilityEvidence { evidence: candidate }
          OneMatchingDurabilityEvidence { evidence: _ } =>
            MultipleMatchingDurabilityEvidence { count: 2 }
          MultipleMatchingDurabilityEvidence { count: count } =>
            MultipleMatchingDurabilityEvidence { count: count + 1 }
        }
      } else {
        cardinality
      },
  )
}

fn state_durability_admission_evidence_cardinality<Target, ReadbackSubject>(
  evidence: List<std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>>,
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
) -> std.state_durability.StateDurabilityEvidenceCardinality<Target, ReadbackSubject> {
  fold(
    evidence,
    init: NoMatchingDurabilityEvidence,
    f: (cardinality, candidate) =>
      if state_durability_admission_eq(
        a: candidate.admission,
        b: admission,
      ) {
        match cardinality {
          NoMatchingDurabilityEvidence =>
            OneMatchingDurabilityEvidence { evidence: candidate }
          OneMatchingDurabilityEvidence { evidence: _ } =>
            MultipleMatchingDurabilityEvidence { count: 2 }
          MultipleMatchingDurabilityEvidence { count: count } =>
            MultipleMatchingDurabilityEvidence { count: count + 1 }
        }
      } else {
        cardinality
      },
  )
}

fn state_durability_evidence_refusal<Target, ReadbackSubject>(
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
  boundary: std.state_durability.StateDurabilityBoundary,
  evidence: std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>,
) -> std.state_durability.StateDurabilityRefusal<Target, ReadbackSubject>? {
  if evidence.perturbation.target != admission.target {
    Present {
      value: DurabilityPerturbationTargetMismatch {
        expected: admission.target,
        observed: evidence.perturbation.target,
      },
    }
  } else if evidence.perturbation.boundary != boundary {
    Present {
      value: DurabilityPerturbationBoundaryMismatch {
        expected: boundary,
        observed: evidence.perturbation.boundary,
      },
    }
  } else if evidence.perturbation.generation != admission.perturbation_generation {
    Present {
      value: DurabilityPerturbationGenerationMismatch {
        expected: admission.perturbation_generation,
        observed: evidence.perturbation.generation,
      },
    }
  } else {
    match evidence.outcome {
      StatePreservationObservationRefused { reason: reason } =>
        Present {
          value: DurabilityObservationRefused { reason: reason },
        }
      StateLost {
        before: before,
        after: after,
        reason: reason,
      } =>
        Present {
          value: DurabilityStateLost {
            before: before,
            after: after,
            reason: reason,
          },
        }
      StatePreserved {
        before: before,
        after: after,
        activation: activation,
      } =>
        if before.perturbation_receipt_id != evidence.perturbation.receipt_id {
          Present {
            value: DurabilityReadbackReceiptLinkMismatch {
              position: BeforeBoundaryReadback,
              expected_receipt_id: evidence.perturbation.receipt_id,
              observed_receipt_id: before.perturbation_receipt_id,
            },
          }
        } else if after.perturbation_receipt_id != evidence.perturbation.receipt_id {
          Present {
            value: DurabilityReadbackReceiptLinkMismatch {
              position: AfterBoundaryReadback,
              expected_receipt_id: evidence.perturbation.receipt_id,
              observed_receipt_id: after.perturbation_receipt_id,
            },
          }
        } else if before.target != admission.target {
          Present {
            value: DurabilityReadbackTargetMismatch {
              position: BeforeBoundaryReadback,
              expected: admission.target,
              observed: before.target,
            },
          }
        } else if after.target != admission.target {
          Present {
            value: DurabilityReadbackTargetMismatch {
              position: AfterBoundaryReadback,
              expected: admission.target,
              observed: after.target,
            },
          }
        } else if before.subject != admission.readback_subject {
          Present {
            value: DurabilityReadbackSubjectMismatch {
              position: BeforeBoundaryReadback,
              expected: admission.readback_subject,
              observed: before.subject,
            },
          }
        } else if after.subject != admission.readback_subject {
          Present {
            value: DurabilityReadbackSubjectMismatch {
              position: AfterBoundaryReadback,
              expected: admission.readback_subject,
              observed: after.subject,
            },
          }
        } else if before.state_digest != admission.desired_state_digest
          || after.state_digest != admission.desired_state_digest {
          Present {
            value: DurabilityDesiredStateMismatch {
              desired: admission.desired_state_digest,
              before: before.state_digest,
              after: after.state_digest,
            },
          }
        } else {
          match activation {
            ActivationUnverified { reason: reason } =>
              Present {
                value: DurabilityActivationUnverified { reason: reason },
              }
            ActivationVerified { receipt: receipt } =>
              if receipt.perturbation_receipt_id != evidence.perturbation.receipt_id {
                Present {
                  value: DurabilityActivationReceiptLinkMismatch {
                    expected_receipt_id: evidence.perturbation.receipt_id,
                    observed_receipt_id: receipt.perturbation_receipt_id,
                  },
                }
              } else if receipt.target != admission.target
                || receipt.subject != admission.readback_subject
                || receipt.desired_state_digest != admission.desired_state_digest
                || receipt.realization != admission.realization
                || receipt.capability_version != admission.capability_version
                || receipt.perturbation_generation != admission.perturbation_generation {
                Present {
                  value: DurabilityActivationScopeMismatch {
                    expected: admission,
                    observed: receipt,
                  },
                }
              } else {
                none
              }
          }
        }
    }
  }
}

fn state_durability_boundary_evidence_verdict<Target, ReadbackSubject>(
  boundary: std.state_durability.StateDurabilityBoundary,
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
  capability: std.state_durability.StateDurabilityCapability,
  evidence: List<std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>>,
) -> std.state_durability.StateDurabilityEvidenceVerdict<Target, ReadbackSubject> {
  if !any(
    capability.supported_boundaries,
    supported => supported == boundary,
  ) {
    StateDurabilityEvidenceRefused {
      cause: DurabilityBoundaryUnsupported {
        realization: capability.realization,
        boundary: boundary,
      },
    }
  } else {
    match state_durability_evidence_cardinality(
      evidence: evidence,
      admission: admission,
      boundary: boundary,
    ) {
      NoMatchingDurabilityEvidence =>
        match state_durability_admission_evidence_cardinality(
          evidence: evidence,
          admission: admission,
        ) {
          OneMatchingDurabilityEvidence { evidence: mismatched } =>
            match state_durability_evidence_refusal(
              admission: admission,
              boundary: boundary,
              evidence: mismatched,
            ) {
              Present { value: cause } =>
                StateDurabilityEvidenceRefused { cause: cause }
              Absent =>
                StateDurabilityEvidenceRefused {
                  cause: DurabilityEvidenceMissing {
                    admission: admission,
                    boundary: boundary,
                  },
                }
            }
          _ =>
            StateDurabilityEvidenceRefused {
              cause: DurabilityEvidenceMissing {
                admission: admission,
                boundary: boundary,
              },
            }
        }
      MultipleMatchingDurabilityEvidence { count: count } =>
        StateDurabilityEvidenceRefused {
          cause: DurabilityEvidenceAmbiguous {
            admission: admission,
            boundary: boundary,
            count: count,
          },
        }
      OneMatchingDurabilityEvidence { evidence: receipt } =>
        match state_durability_evidence_refusal(
          admission: admission,
          boundary: boundary,
          evidence: receipt,
        ) {
          Present { value: cause } =>
            StateDurabilityEvidenceRefused { cause: cause }
          Absent =>
            StateDurabilityEvidenceAccepted {
              evidence: [receipt],
            }
        }
    }
  }
}

type StateDurabilityEvidenceFold<Target, ReadbackSubject> {
  refusal: std.state_durability.StateDurabilityRefusal<Target, ReadbackSubject>?
  accepted: List<std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>>
}

fn state_durability_boundaries_evidence_verdict<Target, ReadbackSubject>(
  required: std.state_durability.StateDurabilityBoundaryRequirements,
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
  capability: std.state_durability.StateDurabilityCapability,
  evidence: List<std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>>,
) -> std.state_durability.StateDurabilityEvidenceVerdict<Target, ReadbackSubject> {
  let required_list = state_durability_boundary_requirement_list(
    requirements: required,
  )
  let folded = fold(
    required_list,
    init: std.state_durability.StateDurabilityEvidenceFold {
      refusal: none,
      accepted: [],
    },
    f: (acc, boundary) =>
      match acc.refusal {
        Present { value: _ } => acc
        Absent =>
          match state_durability_boundary_evidence_verdict(
            boundary: boundary,
            admission: admission,
            capability: capability,
            evidence: evidence,
          ) {
            StateDurabilityEvidenceRefused { cause: cause } =>
              StateDurabilityEvidenceFold {
                refusal: Present { value: cause },
                accepted: acc.accepted,
              }
            StateDurabilityEvidenceAccepted { evidence: matched } =>
              StateDurabilityEvidenceFold {
                refusal: none,
                accepted: append(acc.accepted, items: matched),
              }
          }
      },
  )
  match folded.refusal {
    Present { value: cause } =>
      StateDurabilityEvidenceRefused { cause: cause }
    Absent =>
      StateDurabilityEvidenceAccepted {
        evidence: folded.accepted,
      }
  }
}

fn state_durability_verdict<Target, ReadbackSubject>(
  intent: std.state_durability.StateDurabilityIntent,
  admission: std.state_durability.StateDurabilityAdmission<Target, ReadbackSubject>,
  capability: std.state_durability.StateDurabilityCapability?,
  evidence: List<std.state_durability.StateDurabilityEvidence<Target, ReadbackSubject>>,
) -> std.state_durability.StateDurabilityVerdict<Target, ReadbackSubject> {
  match intent {
    DurabilityUnspecified =>
      StateDurabilityRefused { cause: DurabilityIntentUnspecified }
    RuntimeLifetimeOnly =>
      StateDurabilityQualified {
        qualification: RuntimeLifetimeQualification {
          admission: admission,
        },
      }
    DurableAcross { boundaries: boundaries } =>
      match state_durability_boundary_requirements_refusal(
        requirements: boundaries,
      ) {
        Present { value: cause } =>
          StateDurabilityRefused { cause: cause }
        Absent =>
          match capability {
            Absent =>
              StateDurabilityRefused { cause: DurabilityCapabilityMissing }
            Present { value: realizer } =>
              if !state_durability_capability_matches_admission(
                capability: realizer,
                admission: admission,
              ) {
                StateDurabilityRefused {
                  cause: DurabilityCapabilityAdmissionMismatch {
                    expected_realization: admission.realization,
                    observed_realization: realizer.realization,
                    expected_capability_version: admission.capability_version,
                    observed_capability_version: realizer.capability_version,
                  },
                }
              } else {
                match realizer.commit_barrier {
                  NoDurabilityCommitBarrier =>
                    StateDurabilityRefused {
                      cause: DurabilityCommitBarrierMissing {
                        realization: realizer.realization,
                      },
                    }
                  SynchronizedCommit =>
                    match state_durability_definition_linkage_refusal(
                      admission: admission,
                    ) {
                      Present { value: cause } =>
                        StateDurabilityRefused { cause: cause }
                      Absent =>
                        match state_durability_boundaries_evidence_verdict(
                          required: boundaries,
                          admission: admission,
                          capability: realizer,
                          evidence: evidence,
                        ) {
                          StateDurabilityEvidenceRefused { cause: cause } =>
                            StateDurabilityRefused { cause: cause }
                          StateDurabilityEvidenceAccepted {
                            evidence: accepted,
                          } =>
                            StateDurabilityQualified {
                              qualification: DurableLifetimeQualification {
                                admission: admission,
                                capability: realizer,
                                boundaries: boundaries,
                                evidence: accepted,
                              },
                            }
                        }
                    }
                }
              }
          }
      }
  }
}
