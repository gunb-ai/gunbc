module std.measurement_subject

import std.types { Bool, String, List, Int, NonEmptyStr, list_length }
import std.measure { Nanosecond, time_measure, measure_le, measure_count }
import std.content_hash {
  Fnv1a64Structural,
  content_hash_atom,
  content_hash_combine_structural,
  content_hash_tagged_structural,
  content_hash_eq_structural,
}

// WHY THIS CARRIER EXISTS, at the strength the evidence supports.
// Four measurement instruments failed in one week, and every one of them
// reported a well-formed answer rather than refusing: a fixed-point harness
// printed YES from three regen passes that had all FAILED (three empty patches
// compare equal); a background wrapper exited 0 while the remote work it
// wrapped died with 127; an A/B floor pair returned identical tallies because
// both arms measured the same subject and neither arm could say so; and a
// residue classifier printed NONE FOUND for every row because its extraction
// was broken and it had no denominator to check itself against. None was a
// measurement error. All four were ADMISSION errors - the instrument had no
// representation for "I did not observe this", so it rendered ignorance as a
// value. That is the empty-observation narrow at the instrument layer, and it
// is why the subject is modeled here as a first-class identity rather than
// left implicit in whatever the producer happened to print.

// A measured run's subject: what was measured, stated so that two runs can be
// compared or REFUSED. Wall time is an outcome, never identity - a subject that
// derived any field from the measurement it labels could not detect the case
// where two arms measured the same thing, which is the exact defect that made
// an A/B pair agree.
type MeasurementSubject {
  commit: NonEmptyStr
  binary_digest: Fnv1a64Structural
  command: NonEmptyStr
  source_roots: List<NonEmptyStr>
  source_inventory_digest: Fnv1a64Structural
  module_population: Int
  host: NonEmptyStr
  process: Int
}

// One span's observation. calls and the two wall figures are independent
// counters precisely so they can be reconciled against each other; a carrier
// that stored only the total could not detect a producer that emitted a
// plausible total over samples it never took.
type MeasurementSample {
  span: NonEmptyStr
  parent_span: NonEmptyStr?
  calls: Int
  inclusive_wall: Nanosecond
  exclusive_wall: Nanosecond
  work_units: Int?
}

type MeasurementRun {
  subject: MeasurementSubject
  producer_exit: Int
  expected_spans: List<NonEmptyStr>
  samples: List<MeasurementSample>
}

// Every refusal names the invalid state and carries enough to locate it. There
// is deliberately no arm meaning "measurement unavailable, proceeding" - an
// instrument that cannot observe its subject has nothing to report and must
// stop the line.
type MeasurementRefusalCause
  = ProducerExitNonZero { code: Int }
  | ZeroSamples
  | ExpectedSpanAbsent { span: NonEmptyStr }
  | SpanReportedTwice { span: NonEmptyStr }
  | ExclusiveExceedsInclusive { span: NonEmptyStr, inclusive_wall: Nanosecond, exclusive_wall: Nanosecond }
  | SampleWithoutCalls { span: NonEmptyStr, inclusive_wall: Nanosecond }
  | ParentSpanAbsent { span: NonEmptyStr, parent_span: NonEmptyStr }
  | ParentIsSelf { span: NonEmptyStr }
  | SubjectHasNoSourceRoots
  | SubjectPopulationNonPositive { module_population: Int }
  | SubjectMismatch { expected_digest: Fnv1a64Structural, actual_digest: Fnv1a64Structural }

// A sealed verdict. The digest covers every subject field, so an admitted
// receipt detached from the run that produced it is unwritable rather than
// merely discouraged.
type AdmittedMeasurementRun sole_constructor {
  subject_digest: Fnv1a64Structural
  span_count: Int
  total_calls: Int
  producer_exit: Int
}

type MeasurementAdmission
  = MeasurementAdmitted { admitted: AdmittedMeasurementRun }
  | MeasurementRefused { causes: List<MeasurementRefusalCause> }

fn measurement_subject_digest(subject: MeasurementSubject) -> Fnv1a64Structural {
  let roots = fold(
    subject.source_roots,
    init: content_hash_atom(value: "measurement-subject-roots-v1" as NonEmptyStr),
    f: fn(acc, root) { content_hash_combine_structural(left: acc, right: content_hash_atom(value: root)) },
  )
  let identity = content_hash_combine_structural(
    left: content_hash_atom(value: subject.commit),
    right: content_hash_atom(value: subject.command),
  )
  let digests = content_hash_combine_structural(left: subject.binary_digest, right: subject.source_inventory_digest)
  content_hash_tagged_structural(
    tag: "measurement-subject-v1" as NonEmptyStr,
    payload: content_hash_combine_structural(
      left: content_hash_combine_structural(left: identity, right: roots),
      right: digests,
    ),
  )
}

fn measurement_subject_eq(a: MeasurementSubject, b: MeasurementSubject) -> Bool {
  content_hash_eq_structural(
    left: measurement_subject_digest(subject: a),
    right: measurement_subject_digest(subject: b),
  )
}

fn measurement_nes_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  (a as String) == (b as String)
}

fn measurement_span_present(samples: List<MeasurementSample>, span: NonEmptyStr) -> Bool {
  list_length(items: samples |> filter(s => measurement_nes_eq(a: s.span, b: span))) > 0
}

fn measurement_span_occurrences(samples: List<MeasurementSample>, span: NonEmptyStr) -> Int {
  list_length(items: samples |> filter(s => measurement_nes_eq(a: s.span, b: span)))
}

fn measurement_subject_causes(acc: List<MeasurementRefusalCause>, subject: MeasurementSubject) -> List<MeasurementRefusalCause> {
  let with_roots = if list_length(items: subject.source_roots) == 0 {
    acc + [SubjectHasNoSourceRoots]
  } else {
    acc
  }
  if subject.module_population <= 0 {
    with_roots + [SubjectPopulationNonPositive { module_population: subject.module_population }]
  } else {
    with_roots
  }
}

// A span that reports elapsed time over zero calls is the fabricated-total
// shape: something rendered a duration for work it never observed, which is
// why the calls counter is carried beside the two wall figures rather than
// derived from them.
fn measurement_sample_causes(
  acc: List<MeasurementRefusalCause>,
  sample: MeasurementSample,
  samples: List<MeasurementSample>,
) -> List<MeasurementRefusalCause> {
  let dup = if measurement_span_occurrences(samples: samples, span: sample.span) > 1 {
    acc + [SpanReportedTwice { span: sample.span }]
  } else {
    acc
  }
  let bounds = if !measure_le(a: sample.exclusive_wall, b: sample.inclusive_wall) {
    dup + [ExclusiveExceedsInclusive {
      span: sample.span,
      inclusive_wall: sample.inclusive_wall,
      exclusive_wall: sample.exclusive_wall,
    }]
  } else {
    dup
  }
  let calls = if sample.calls <= 0 && measure_count(m: sample.inclusive_wall) > 0 {
    bounds + [SampleWithoutCalls { span: sample.span, inclusive_wall: sample.inclusive_wall }]
  } else {
    bounds
  }
  match sample.parent_span {
    Absent => calls
    Present { value: parent } =>
      if measurement_nes_eq(a: parent, b: sample.span) {
        calls + [ParentIsSelf { span: sample.span }]
      } else {
        if measurement_span_present(samples: samples, span: parent) {
          calls
        } else {
          calls + [ParentSpanAbsent { span: sample.span, parent_span: parent }]
        }
      }
  }
}

fn measurement_expected_span_causes(
  acc: List<MeasurementRefusalCause>,
  expected: List<NonEmptyStr>,
  samples: List<MeasurementSample>,
) -> List<MeasurementRefusalCause> {
  fold(
    expected,
    init: acc,
    f: fn(inner, span) {
      if measurement_span_present(samples: samples, span: span) {
        inner
      } else {
        inner + [ExpectedSpanAbsent { span: span }]
      }
    },
  )
}

fn measurement_total_calls(samples: List<MeasurementSample>) -> Int {
  fold(samples, init: 0, f: fn(acc, s) { acc + s.calls })
}

// Zero samples is its own arm, ahead of the per-sample fold, because a fold
// over an empty list produces no causes at all - which is exactly how an
// instrument that observed nothing reports as clean.
fn measurement_run_causes(run: MeasurementRun) -> List<MeasurementRefusalCause> {
  let exit_acc = if run.producer_exit != 0 {
    [ProducerExitNonZero { code: run.producer_exit }]
  } else {
    []
  }
  let subject_acc = measurement_subject_causes(acc: exit_acc, subject: run.subject)
  let empty_acc = if list_length(items: run.samples) == 0 {
    subject_acc + [ZeroSamples]
  } else {
    subject_acc
  }
  let sample_acc = fold(
    run.samples,
    init: empty_acc,
    f: fn(acc, sample) { measurement_sample_causes(acc: acc, sample: sample, samples: run.samples) },
  )
  measurement_expected_span_causes(acc: sample_acc, expected: run.expected_spans, samples: run.samples)
}

fn admit_measurement_run(run: MeasurementRun) -> MeasurementAdmission {
  let causes = measurement_run_causes(run: run)
  if list_length(items: causes) == 0 {
    MeasurementAdmitted {
      admitted: AdmittedMeasurementRun {
        subject_digest: measurement_subject_digest(subject: run.subject),
        span_count: list_length(items: run.samples),
        total_calls: measurement_total_calls(samples: run.samples),
        producer_exit: run.producer_exit,
      },
    }
  } else {
    MeasurementRefused { causes: causes }
  }
}

// THE EXPECTATION ARM, and why it is a separate entry rather than an optional
// field on the run. A harness knows the commit and binary it intends to measure
// BEFORE the producer runs, so "this run is of the thing I asked for" is a
// question the carrier can answer -- but only if the expectation is supplied.
// Carrying it as an optional field on MeasurementRun would make the unchecked
// case the default and the check something a caller must remember, which is the
// escape hatch DESIGN section 5 forbids; carrying it as a distinct entry point
// makes the checked and unchecked cases two named calls instead of one call
// with a silent mode. admit_measurement_run remains for a measurement recorded
// with no prior expectation, which is a real case and not a weaker one.
fn admit_measurement_run_against(expected: MeasurementSubject, run: MeasurementRun) -> MeasurementAdmission {
  let expected_digest = measurement_subject_digest(subject: expected)
  let actual_digest = measurement_subject_digest(subject: run.subject)
  let mismatch = if content_hash_eq_structural(left: expected_digest, right: actual_digest) {
    []
  } else {
    [SubjectMismatch { expected_digest: expected_digest, actual_digest: actual_digest }]
  }
  let causes = mismatch + measurement_run_causes(run: run)
  if list_length(items: causes) == 0 {
    MeasurementAdmitted {
      admitted: AdmittedMeasurementRun {
        subject_digest: actual_digest,
        span_count: list_length(items: run.samples),
        total_calls: measurement_total_calls(samples: run.samples),
        producer_exit: run.producer_exit,
      },
    }
  } else {
    MeasurementRefused { causes: causes }
  }
}

// THE A/B ARM. A delta between two runs is meaningless unless both were
// admitted AND their subjects actually differ: an A/B pair whose two arms
// carry one subject digest measured one thing twice, and its agreement is a
// tautology rather than a result. This is the exact shape that let a floor
// pair report identical tallies with the change absent from both arms.
type MeasurementDeltaRefusalCause
  = BaselineRefused { causes: List<MeasurementRefusalCause> }
  | CandidateRefused { causes: List<MeasurementRefusalCause> }
  | SubjectsIdentical { subject_digest: Fnv1a64Structural }

type MeasurementDelta
  = DeltaAdmitted {
      baseline_digest: Fnv1a64Structural
      candidate_digest: Fnv1a64Structural
      baseline_calls: Int
      candidate_calls: Int
    }
  | DeltaRefused { causes: List<MeasurementDeltaRefusalCause> }

fn admit_measurement_delta(baseline: MeasurementRun, candidate: MeasurementRun) -> MeasurementDelta {
  let base_causes = measurement_run_causes(run: baseline)
  let cand_causes = measurement_run_causes(run: candidate)
  let base_acc = if list_length(items: base_causes) > 0 {
    [BaselineRefused { causes: base_causes }]
  } else {
    []
  }
  let cand_acc = if list_length(items: cand_causes) > 0 {
    base_acc + [CandidateRefused { causes: cand_causes }]
  } else {
    base_acc
  }
  let base_digest = measurement_subject_digest(subject: baseline.subject)
  let cand_digest = measurement_subject_digest(subject: candidate.subject)
  let all_causes = if content_hash_eq_structural(left: base_digest, right: cand_digest) {
    cand_acc + [SubjectsIdentical { subject_digest: base_digest }]
  } else {
    cand_acc
  }
  if list_length(items: all_causes) == 0 {
    DeltaAdmitted {
      baseline_digest: base_digest,
      candidate_digest: cand_digest,
      baseline_calls: measurement_total_calls(samples: baseline.samples),
      candidate_calls: measurement_total_calls(samples: candidate.samples),
    }
  } else {
    DeltaRefused { causes: all_causes }
  }
}

data measurement_subject_rung_note: String = "TWO REFUSALS FROM THE COMMISSIONING SPEC WERE MISSING FROM THE FIRST REVISION, and one of them was this carrier committing the defect it exists to refuse. The spec names 'wrong commit or binary' and 'unknown metric rendered as zero' among the states a measurement harness must refuse. (1) Wrong commit or binary had no representation: SubjectsIdentical catches two arms that measured ONE subject, but nothing compared a run against the subject it was SUPPOSED to measure, because no expectation was ever supplied. admit_measurement_run_against now takes that expectation and refuses SubjectMismatch, carrying both digests. (2) work_units was a bare Int, so a span whose work units were never measured could only be rendered as zero -- unknown collapsed into a legitimate value, inside the carrier whose entire subject is that ignorance must not be rendered as an answer. It is now Int?, so 'not measured' and 'measured zero' are distinct states. Note the asymmetry deliberately: the spec asked for a REFUSAL on rendering unknown as zero, and the repair makes the rendering UNWRITABLE instead, which is the higher rung -- a refusal would have conceded that the bad state is constructible. Both gaps were found by re-reading the commissioning spec against the built carrier after it was already approved and green, which is the only reason they are recorded here rather than shipped.

THE DURATION AXIS IS GROUNDED, recorded first because an earlier revision of this carrier got it wrong. The two wall figures were declared as bare Int fields named inclusive_wall_nanos and exclusive_wall_nanos -- a unit carried in a field NAME, which is a second representation of a quantity std.measure already owns, and in a std/ carrier at that. They are now Nanosecond, which is Measure<Time, Nano, Nat>: the scale lives in the type, so the field name no longer carries it, the refusal causes that propagate the figures outward carry the same type rather than re-flattening it, and the inclusive/exclusive ordering check is measure_le rather than a scalar comparison. No dissolution trigger is attached because nothing is deferred -- the fork is removed rather than admitted. Caught in review on gunbc#8545; the remedy the review named (std.measure.Duration) does not exist, and Nanosecond is the carrier that does.

RUNG, stated honestly rather than by the carrier's name. MeasurementSubject and MeasurementSample are ordinary records and remain directly constructible, so an author can still write a subject whose fields do not describe the run they label - this carrier cannot make a LIE about an observation unwritable, because the observation happens outside the model. What IS structural is the verdict: AdmittedMeasurementRun is sole_constructor with one in-module mint inside admit_measurement_run, so an admitted receipt that never passed the causes fold has no representation, and a delta over an unadmitted or self-identical pair likewise has none. So the class sits at mechanically preventable for the ADMISSION question and at mitigatable for the FAITHFULNESS question. NEXT-RUNG TRIGGER for the second half: the subject's binary_digest and source_inventory_digest are produced by the harness at launch rather than declared by the author, at which point a subject detached from its run stops being writable at the boundary that mints it. NOT CLAIMED: that any measurement in this repository currently routes through this carrier. It has one consumer, its witness, and the profiler spans that would feed it are blocked behind the stage0 regeneration; enrolling a producer is separate work and until it lands this is a modeled admission with no production subject."
