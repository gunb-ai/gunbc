module std.interface_summary





type InterfaceHash = std.content_hash.Fnv1a64Structural where brand("InterfaceHash")
type ModuleKey = std.content_hash.Fnv1a64Structural where brand("ModuleKey")
type SignatureFingerprint = std.content_hash.Fnv1a64Structural where brand("SignatureFingerprint")
type TypedModuleKey = std.content_hash.Fnv1a64Structural where brand("TypedModuleKey")

type InterfaceContract
  = ContractAbsent
  | SignatureContract { signature: SignatureFingerprint }

type ExportKind
  = ExportFn
  | ExportType
  | ExportData
  | ExportService

type ExportEntry {
  name: std.types.NonEmptyStr
  kind: ExportKind
  contract: InterfaceContract
}

type InterfaceSummary {
  module_path: std.types.NonEmptyStr
  exports: List<ExportEntry>
  interface_hash: InterfaceHash
}

data interface_summary_v0_dissolution_trigger: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: std.disposition.SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "std.interface_summary",
    decl_name: "export_entry_fingerprint",
    field: std.decl_ref.WholeDeclaration
  }
}

fn signature_contract(signature: SignatureFingerprint) -> InterfaceContract {
  SignatureContract { signature: signature }
}

fn contract_absent() -> InterfaceContract {
  ContractAbsent
}

fn export_kind_tag(kind: ExportKind) -> std.types.NonEmptyStr {
  match kind {
    ExportFn => "fn"
    ExportType => "type"
    ExportData => "data"
    ExportService => "service"
  }
}

fn export_entry_fingerprint(entry: ExportEntry) -> std.content_hash.Fnv1a64Structural {
  match entry.contract {
    ContractAbsent =>
      std.content_hash.content_hash_tagged_structural(
        tag: "export",
        payload: std.content_hash.content_hash_combine_structural(
          left: std.content_hash.content_hash_atom(value: entry.name),
          right: std.content_hash.content_hash_atom(value: export_kind_tag(kind: entry.kind))
        )
      )
    SignatureContract { signature: signature } =>
      std.content_hash.content_hash_tagged_structural(
        tag: "export",
        payload: std.content_hash.content_hash_combine_structural(
          left: std.content_hash.content_hash_combine_structural(
            left: std.content_hash.content_hash_atom(value: entry.name),
            right: std.content_hash.content_hash_atom(value: export_kind_tag(kind: entry.kind))
          ),
          right: signature
        )
      )
  }
}

fn interface_summary_rollup(exports: List<ExportEntry>) -> InterfaceHash {
  fold(
    exports,
    init: std.content_hash.content_hash_atom(value: "interface-summary-v0"),
    f: fn(acc, entry) {
      std.content_hash.content_hash_combine_structural(
        left: acc,
        right: export_entry_fingerprint(entry: entry)
      )
    }
  )
}

fn module_key(source_hash: std.content_hash.Fnv1a64Structural, direct_import_interface_hashes: List<InterfaceHash>) -> ModuleKey {
  fold(
    direct_import_interface_hashes,
    init: std.content_hash.content_hash_tagged_structural(tag: "module-key-source", payload: source_hash),
    f: fn(acc, import_hash) {
      std.content_hash.content_hash_tagged_structural(
        tag: "module-key-import",
        payload: std.content_hash.content_hash_combine_structural(left: acc, right: import_hash)
      )
    }
  )
}

data typed_module_key_note: std.types.NonEmptyStr = "A typed module's content-key = its interface module_key (source hash + direct-import interface hashes) + the compiler's own identity. The compiler is itself an input to the typed result (a seed regen changes inference), so a memo keyed on module_key alone would serve a stale typed module across a rebuild. compiler_identity is consumed here, not authored here — its derivation is the store realization's concern. This is the pure key for the cross-entry typed-module memo (docs/plans/cross-entry-typed-module-memo-sketch.md); the store, eviction, and ComputationIdentity wrapping land downstream."

data typed_module_key_v1_seed_bridge_note: String = "Seed-retained hand-Rust bridge (review 45298): src/v1/stage0/src/cli_run.rs typed_module_content_key is the v1 host realization of std.interface_summary.module_key and typed_module_key — the only adaptation is wrapping reconcile-path digest strings via std.content_hash.structural_content_hash before the .dag authority runs, because the v1 store boundary still carries interface hashes as digest strings. DELETE SCAFFOLD — this is not a new digest concept; it is the string→Fnv1a64Structural coercion the authority already requires. CENSUS SHRINK — one call site (typed_module_content_key); no parallel key authority. EXPLICIT DEFERRAL — dissolves when cross-entry typed-module memo routes through emitted typed_module_key end-to-end without cli_run string wrapping; ROADMAP row 'Make native materialization the shared execution kernel' (docs/plans/witness-realization-plan.md P3/P6) and gunbc.v1_deletion_plan ^witness_realization_kernel; aligns with docs/plans/cross-entry-typed-module-memo-sketch.md Half B."

fn typed_module_key(interface_key: ModuleKey, compiler_identity: std.content_hash.Fnv1a64Structural) -> TypedModuleKey {
  std.content_hash.content_hash_tagged_structural(
    tag: "typed-module-compiler",
    payload: std.content_hash.content_hash_combine_structural(left: interface_key, right: compiler_identity)
  )
}
