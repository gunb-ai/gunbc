module std.selected_witness_bundle

import std.types { ContentHash, NonEmptyStr, List, Int, Bool }
import std.verification { NanosecondDuration }
import std.content_hash {
  content_hash_atom,
  content_hash_combine,
  content_hash_tagged,
}

data selected_witness_bundle_note: NonEmptyStr = "Selected-entry native execution authority (native-selected-witness-bundle, 2026-08-01). Selection and realization remain separate facts: SelectedWitnessPlan records the complete production-selected population; each member is either NativeSelected or a counted InterpreterFrontier row with a reason and dissolution trigger. A native bundle contains only NativeSelected members, runs them as direct calls in one process, and returns a typed receipt. InterpreterFrontier is coverage-preserving compatibility, never an uncounted skip. During cutover the interpreter is the equivalence oracle; a family enters native-consumed production only after every selected member has executed verdict equivalence and the family has a live discriminating RED. Native-vs-interpreter divergence is a hard refusal, never an auto-pick."

data selected_witness_bundle_hash_family_note: NonEmptyStr = "HASH-FAMILY BOUNDARY (DESIGN section 3 ContentHash residue): NativeWitnessBundleIdentity is an fnv1a64 STRUCTURAL fingerprint, never an OCI/cryptographic digest. Its only constructor in this module composes std.content_hash outputs. The required family is stated at this carrier because ContentHash itself cannot yet express it; feature:content-hash-family-grounded makes that requirement structural and dissolves this boundary note."

type SelectedWitnessIdentity {
  entry: NonEmptyStr
  function: NonEmptyStr
  subject_digest: ContentHash
}

type NativeRealizationIdentity {
  family: NonEmptyStr
  realization_digest: ContentHash
}

type NativeUnavailableCause
  = NativeRealizationAbsent
  | NativeRealizationRefused { reason: NonEmptyStr }

type SelectedWitnessMember
  = NativeSelected {
      witness: SelectedWitnessIdentity
      realization: NativeRealizationIdentity
    }
  | InterpreterFrontier {
      witness: SelectedWitnessIdentity
      cause: NativeUnavailableCause
      reason: NonEmptyStr
      dissolve_on: NonEmptyStr
    }

type NativeBundleShardPolicy
  = OneSelectedBundle { reason: NonEmptyStr }
  | StableBundleShards { shard_count: Int, reason: NonEmptyStr }

type SelectedWitnessPlan {
  compiler_identity: ContentHash
  shard_policy: NativeBundleShardPolicy
  members: List<SelectedWitnessMember>
}

type NativeWitnessBundleIdentity {
  structural_fingerprint: ContentHash
}

type NativeWitnessBundleMember {
  witness: SelectedWitnessIdentity
  realization: NativeRealizationIdentity
}

type NativeWitnessBundle {
  identity: NativeWitnessBundleIdentity
  compiler_identity: ContentHash
  members: List<NativeWitnessBundleMember>
}

fn selected_witness_identity_hash(witness: SelectedWitnessIdentity) -> ContentHash {
  content_hash_tagged(
    tag: "selected-witness-identity",
    payload: content_hash_combine(
      left: content_hash_atom(value: witness.entry),
      right: content_hash_combine(
        left: content_hash_atom(value: witness.function),
        right: witness.subject_digest
      )
    )
  )
}

fn native_realization_identity_hash(realization: NativeRealizationIdentity) -> ContentHash {
  content_hash_tagged(
    tag: "selected-witness-native-realization",
    payload: content_hash_combine(
      left: content_hash_atom(value: realization.family),
      right: realization.realization_digest
    )
  )
}

fn native_bundle_member_hash(member: NativeWitnessBundleMember) -> ContentHash {
  content_hash_tagged(
    tag: "selected-witness-native-member",
    payload: content_hash_combine(
      left: selected_witness_identity_hash(witness: member.witness),
      right: native_realization_identity_hash(realization: member.realization)
    )
  )
}

fn selected_witness_plan_native_members(plan: SelectedWitnessPlan) -> List<NativeWitnessBundleMember> {
  reverse(fold(
    plan.members,
    init: [],
    f: (acc, member) => match member {
      NativeSelected { witness: witness, realization: realization } =>
        concat([NativeWitnessBundleMember {
          witness: witness,
          realization: realization
        }], acc)
      InterpreterFrontier { witness: _, cause: _, reason: _, dissolve_on: _ } => acc
    }
  ))
}

fn selected_witness_plan_interpreter_frontier_count(plan: SelectedWitnessPlan) -> Int {
  fold(
    plan.members,
    init: 0,
    f: (count, member) => match member {
      NativeSelected { witness: _, realization: _ } => count
      InterpreterFrontier { witness: _, cause: _, reason: _, dissolve_on: _ } => count + 1
    }
  )
}

fn native_bundle_shard_policy_hash(policy: NativeBundleShardPolicy) -> ContentHash {
  match policy {
    OneSelectedBundle { reason: _ } => content_hash_atom(value: "one-selected-bundle")
    StableBundleShards { shard_count: count, reason: _ } => content_hash_tagged(
      tag: "stable-selected-bundle-shards",
      payload: native_bundle_shard_count_hash(count: count)
    )
  }
}

fn native_bundle_shard_count_hash(count: Int) -> ContentHash {
  if count <= 0 {
    content_hash_atom(value: "selected-bundle-shard-count-zero")
  } else {
    content_hash_tagged(
      tag: "selected-bundle-shard-count-successor",
      payload: native_bundle_shard_count_hash(count: count - 1)
    )
  }
}

fn native_witness_bundle_identity(plan: SelectedWitnessPlan) -> NativeWitnessBundleIdentity {
  let members = selected_witness_plan_native_members(plan: plan)
  let member_fingerprint = fold(
    members,
    init: content_hash_atom(value: "selected-witness-native-members"),
    f: (acc, member) => content_hash_combine(
      left: acc,
      right: native_bundle_member_hash(member: member)
    )
  )
  NativeWitnessBundleIdentity {
    structural_fingerprint: content_hash_tagged(
      tag: "selected-witness-native-bundle-v1",
      payload: content_hash_combine(
        left: plan.compiler_identity,
        right: content_hash_combine(
          left: native_bundle_shard_policy_hash(policy: plan.shard_policy),
          right: member_fingerprint
        )
      )
    )
  }
}

fn native_witness_bundle_from_plan(plan: SelectedWitnessPlan) -> NativeWitnessBundle {
  NativeWitnessBundle {
    identity: native_witness_bundle_identity(plan: plan),
    compiler_identity: plan.compiler_identity,
    members: selected_witness_plan_native_members(plan: plan)
  }
}

type NativeBundleAdmission
  = NativeBundleAdmitted { bundle: NativeWitnessBundle }
  | NativeBundleRefusedStaleCompiler {
      bundle_compiler_identity: ContentHash
      current_compiler_identity: ContentHash
    }
  | NativeBundleRefusedStalePlanCompiler {
      plan_compiler_identity: ContentHash
      current_compiler_identity: ContentHash
    }
  | NativeBundleRefusedPlanIdentity {
      observed: NativeWitnessBundleIdentity
      required: NativeWitnessBundleIdentity
    }
  | NativeBundleRefusedMemberCoverage {
      observed: List<NativeWitnessBundleMember>
      required: List<NativeWitnessBundleMember>
    }

fn native_witness_bundle_admit(
  plan: SelectedWitnessPlan,
  bundle: NativeWitnessBundle,
  current_compiler_identity: ContentHash
) -> NativeBundleAdmission {
  let required = native_witness_bundle_identity(plan: plan)
  let required_members = selected_witness_plan_native_members(plan: plan)
  if bundle.compiler_identity != current_compiler_identity {
    NativeBundleRefusedStaleCompiler {
      bundle_compiler_identity: bundle.compiler_identity,
      current_compiler_identity: current_compiler_identity
    }
  } else if plan.compiler_identity != current_compiler_identity {
    NativeBundleRefusedStalePlanCompiler {
      plan_compiler_identity: plan.compiler_identity,
      current_compiler_identity: current_compiler_identity
    }
  } else if bundle.identity.structural_fingerprint != required.structural_fingerprint {
    NativeBundleRefusedPlanIdentity {
      observed: bundle.identity,
      required: required
    }
  } else if bundle.members != required_members {
    NativeBundleRefusedMemberCoverage {
      observed: bundle.members,
      required: required_members
    }
  } else {
    NativeBundleAdmitted { bundle: bundle }
  }
}

type SelectedWitnessVerdict
  = SelectedWitnessPassed
  | SelectedWitnessFailed

type NativeBundleMemberEquivalence {
  witness: SelectedWitnessIdentity
  family: NonEmptyStr
  interpreted: SelectedWitnessVerdict
  native: SelectedWitnessVerdict
}

type NativeWitnessBundleExecutionReceipt {
  bundle_identity: NativeWitnessBundleIdentity
  compiler_identity: ContentHash
  process_count: Int
  compile_skipped: Bool
  native_wall_nanos: NanosecondDuration
  interpreted_wall_nanos: NanosecondDuration
  member_equivalence: List<NativeBundleMemberEquivalence>
  interpreter_frontier_count: Int
}

type NativeBundleFamilyCutoverEvidence {
  planted_plan: SelectedWitnessPlan
  execution: NativeWitnessBundleExecutionReceipt
}

type NativeWitnessBundleExecutionVerdict
  = NativeBundleExecutionAccepted { receipt: NativeWitnessBundleExecutionReceipt }
  | NativeBundleExecutionRefusedNoNativeMembers
  | NativeBundleExecutionRefusedStaleCompiler {
      receipt_compiler_identity: ContentHash
      current_compiler_identity: ContentHash
    }
  | NativeBundleExecutionRefusedStalePlanCompiler {
      plan_compiler_identity: ContentHash
      current_compiler_identity: ContentHash
    }
  | NativeBundleExecutionRefusedPlanIdentity {
      observed: NativeWitnessBundleIdentity
      required: NativeWitnessBundleIdentity
    }
  | NativeBundleExecutionRefusedMemberCoverage {
      observed: ContentHash
      required: ContentHash
    }
  | NativeBundleExecutionRefusedFrontierCount { observed: Int, required: Int }
  | NativeBundleExecutionRefusedDivergence {
      witness: SelectedWitnessIdentity
      interpreted: SelectedWitnessVerdict
      native: SelectedWitnessVerdict
    }
  | NativeBundleExecutionRefusedMissingDiscriminatingRed { family: NonEmptyStr }
  | NativeBundleExecutionRefusedProcessCount { observed: Int }
  | NativeBundleExecutionRefusedWarmArtifactMiss

fn native_bundle_execution_member_hash(
  witness: SelectedWitnessIdentity,
  family: NonEmptyStr
) -> ContentHash {
  content_hash_tagged(
    tag: "selected-witness-executed-member",
    payload: content_hash_combine(
      left: selected_witness_identity_hash(witness: witness),
      right: content_hash_atom(value: family)
    )
  )
}

fn native_bundle_required_execution_roster_hash(
  members: List<NativeWitnessBundleMember>
) -> ContentHash {
  fold(
    members,
    init: content_hash_atom(value: "selected-witness-execution-roster"),
    f: (acc, member) => content_hash_combine(
      left: acc,
      right: native_bundle_execution_member_hash(
        witness: member.witness,
        family: member.realization.family
      )
    )
  )
}

fn native_bundle_observed_execution_roster_hash(
  rows: List<NativeBundleMemberEquivalence>
) -> ContentHash {
  fold(
    rows,
    init: content_hash_atom(value: "selected-witness-execution-roster"),
    f: (acc, row) => content_hash_combine(
      left: acc,
      right: native_bundle_execution_member_hash(
        witness: row.witness,
        family: row.family
      )
    )
  )
}

type NativeBundleDivergenceSearch
  = NativeBundleDivergenceAbsent
  | NativeBundleDivergenceFound { row: NativeBundleMemberEquivalence }

fn first_native_bundle_divergence(
  rows: List<NativeBundleMemberEquivalence>
) -> NativeBundleDivergenceSearch {
  fold(
    rows,
    init: NativeBundleDivergenceAbsent,
    f: (found, row) => match found {
      NativeBundleDivergenceFound { row: prior } =>
        NativeBundleDivergenceFound { row: prior }
      NativeBundleDivergenceAbsent =>
        if row.interpreted == row.native {
          NativeBundleDivergenceAbsent
        } else {
          NativeBundleDivergenceFound { row: row }
        }
    }
  )
}

fn native_bundle_red_receipt_matches_plan(
  evidence: NativeBundleFamilyCutoverEvidence,
  current_compiler_identity: ContentHash
) -> Bool {
  let planted_bundle = native_witness_bundle_from_plan(plan: evidence.planted_plan)
  let required_members = planted_bundle.members
  let required_roster = native_bundle_required_execution_roster_hash(members: required_members)
  let observed_roster = native_bundle_observed_execution_roster_hash(
    rows: evidence.execution.member_equivalence
  )
  evidence.planted_plan.compiler_identity == current_compiler_identity
    && evidence.execution.compiler_identity == current_compiler_identity
    && evidence.execution.process_count == 1
    && evidence.execution.bundle_identity.structural_fingerprint == planted_bundle.identity.structural_fingerprint
    && evidence.execution.interpreter_frontier_count == selected_witness_plan_interpreter_frontier_count(
      plan: evidence.planted_plan
    )
    && required_members.count() > 0
    && observed_roster == required_roster
}

fn planted_red_row_matches_production_member(
  row: NativeBundleMemberEquivalence,
  family: NonEmptyStr,
  production_members: List<NativeWitnessBundleMember>
) -> Bool {
  fold(
    production_members,
    init: false,
    f: (found, member) => found || (
      member.realization.family == family
        && row.family == family
        && row.witness.entry == member.witness.entry
        && row.witness.function == member.witness.function
        && row.witness.subject_digest != member.witness.subject_digest
        && row.interpreted == SelectedWitnessPassed
        && row.native == SelectedWitnessFailed
    )
  )
}

fn family_has_discriminating_red(
  family: NonEmptyStr,
  production_plan: SelectedWitnessPlan,
  current_compiler_identity: ContentHash,
  evidence: List<NativeBundleFamilyCutoverEvidence>
) -> Bool {
  let production_members = selected_witness_plan_native_members(plan: production_plan)
  fold(
    evidence,
    init: false,
    f: (found, candidate) => found || (
      native_bundle_red_receipt_matches_plan(
        evidence: candidate,
        current_compiler_identity: current_compiler_identity
      ) && fold(
        candidate.execution.member_equivalence,
        init: false,
        f: (row_found, row) => row_found || planted_red_row_matches_production_member(
          row: row,
          family: family,
          production_members: production_members
        )
      )
    )
  )
}

type NativeBundleFamilyRedSearch
  = NativeBundleFamiliesHaveRed
  | NativeBundleFamilyMissingRed { family: NonEmptyStr }

fn first_native_bundle_family_without_red(
  rows: List<NativeBundleMemberEquivalence>,
  production_plan: SelectedWitnessPlan,
  current_compiler_identity: ContentHash,
  evidence: List<NativeBundleFamilyCutoverEvidence>
) -> NativeBundleFamilyRedSearch {
  fold(
    rows,
    init: NativeBundleFamiliesHaveRed,
    f: (found, row) => match found {
      NativeBundleFamilyMissingRed { family: prior } =>
        NativeBundleFamilyMissingRed { family: prior }
      NativeBundleFamiliesHaveRed =>
        if family_has_discriminating_red(
          family: row.family,
          production_plan: production_plan,
          current_compiler_identity: current_compiler_identity,
          evidence: evidence
        ) {
          NativeBundleFamiliesHaveRed
        } else {
          NativeBundleFamilyMissingRed { family: row.family }
        }
    }
  )
}

fn native_witness_bundle_execution_admit(
  plan: SelectedWitnessPlan,
  current_compiler_identity: ContentHash,
  receipt: NativeWitnessBundleExecutionReceipt,
  family_evidence: List<NativeBundleFamilyCutoverEvidence>
) -> NativeWitnessBundleExecutionVerdict {
  let required_bundle = native_witness_bundle_from_plan(plan: plan)
  let required_members = required_bundle.members
  let required_frontier_count = selected_witness_plan_interpreter_frontier_count(plan: plan)
  let required_roster = native_bundle_required_execution_roster_hash(members: required_members)
  let observed_roster = native_bundle_observed_execution_roster_hash(
    rows: receipt.member_equivalence
  )
  if receipt.process_count != 1 {
    NativeBundleExecutionRefusedProcessCount { observed: receipt.process_count }
  } else if receipt.compiler_identity != current_compiler_identity {
    NativeBundleExecutionRefusedStaleCompiler {
      receipt_compiler_identity: receipt.compiler_identity,
      current_compiler_identity: current_compiler_identity
    }
  } else if plan.compiler_identity != current_compiler_identity {
    NativeBundleExecutionRefusedStalePlanCompiler {
      plan_compiler_identity: plan.compiler_identity,
      current_compiler_identity: current_compiler_identity
    }
  } else if receipt.bundle_identity.structural_fingerprint != required_bundle.identity.structural_fingerprint {
    NativeBundleExecutionRefusedPlanIdentity {
      observed: receipt.bundle_identity,
      required: required_bundle.identity
    }
  } else if required_members.count() == 0 {
    NativeBundleExecutionRefusedNoNativeMembers
  } else if receipt.interpreter_frontier_count != required_frontier_count {
    NativeBundleExecutionRefusedFrontierCount {
      observed: receipt.interpreter_frontier_count,
      required: required_frontier_count
    }
  } else if observed_roster != required_roster {
    NativeBundleExecutionRefusedMemberCoverage {
      observed: observed_roster,
      required: required_roster
    }
  } else if !receipt.compile_skipped {
    NativeBundleExecutionRefusedWarmArtifactMiss
  } else {
    match first_native_bundle_divergence(rows: receipt.member_equivalence) {
      NativeBundleDivergenceFound { row: row } => NativeBundleExecutionRefusedDivergence {
        witness: row.witness,
        interpreted: row.interpreted,
        native: row.native
      }
      NativeBundleDivergenceAbsent => match first_native_bundle_family_without_red(
        rows: receipt.member_equivalence,
        production_plan: plan,
        current_compiler_identity: current_compiler_identity,
        evidence: family_evidence
      ) {
        NativeBundleFamilyMissingRed { family: family } =>
          NativeBundleExecutionRefusedMissingDiscriminatingRed { family: family }
        NativeBundleFamiliesHaveRed => NativeBundleExecutionAccepted { receipt: receipt }
      }
    }
  }
}
