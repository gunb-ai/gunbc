module std.markup

import std.layout { DocLine, LayoutProtocol, render }


type EscapeContext = TextContext | AttributeContext | UrlContext

type Attribute {
  name: String
  ctx: EscapeContext
  value: String
}

type Fragment
  = Element { tag: String, attributes: List<Attribute>, children: List<Fragment> }
  | FragmentText { content: String }
  | RawNode { content: String }
  // A markup comment. The BODY is carried, never assembled: the delimiters are the medium's
  // comment_open / comment_close, so "<!-- " exists once per language model instead of once per
  // author — which is the whole reason this arm exists (three sites in this repo spelled the
  // delimiters by hand, and one of them interpolated a value into the middle of them).
  // The body is emitted as-written, like a raw-text element's content: HTML defines no escape syntax
  // inside a comment ("comment state" consumes to the first "-->" and decodes nothing), so escaping
  // would corrupt it rather than protect it. What a body must never do is terminate early, and that
  // is refused rather than filtered — see extdeps.languages.html comment_hazard, which every
  // guarded route consults before serializing.
  | MarkupComment { body: String }
  // A whole document: the document-type declaration and the root element. This is the HTML parser's
  // own node ("the Document node is the root node, with the doctype and <html> as children", HTML
  // Living Standard §13.2.4), and it is why the doctype is an ARM and not a Fragment variant: a
  // doctype is not an element and is not inside <html>, so Element or FragmentText could only model
  // it wrongly. It is also why it is not spelled at the call site — the two sites that emit one
  // today concatenate "<!DOCTYPE html>\n" OUTSIDE the serializer, so they cannot be guarded, and
  // they no longer do.
  // The keyword is the NAME after <!DOCTYPE ("html" selects standards mode); the "<!DOCTYPE " prefix
  // is the medium's doctype_open spelling, so a document cannot carry its own punctuation.
  | Document { doctype: String, root: Fragment }

fn escape_text(s: String) -> String {
  replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
}

fn unescape_text(s: String) -> String {
  replace(replace(replace(s, "&lt;", "<"), "&gt;", ">"), "&amp;", "&")
}

fn escape_attribute(s: String) -> String {
  replace(replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;")
}

fn unescape_attribute(s: String) -> String {
  replace(replace(replace(replace(s, "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&amp;", "&")
}

fn escape_url(s: String) -> String {
  replace(replace(replace(replace(replace(s, "%", "%25"), "&", "&amp;"), "\"", "%22"), " ", "%20"), "<", "%3C")
}

fn unescape_url(s: String) -> String {
  replace(replace(replace(replace(replace(s, "%22", "\""), "%20", " "), "%3C", "<"), "&amp;", "&"), "%25", "%")
}

fn escape_in(ctx: EscapeContext, s: String) -> String {
  match ctx {
    TextContext => escape_text(s)
    AttributeContext => escape_attribute(s)
    UrlContext => escape_url(s)
  }
}

fn unescape_in(ctx: EscapeContext, s: String) -> String {
  match ctx {
    TextContext => unescape_text(s)
    AttributeContext => unescape_attribute(s)
    UrlContext => unescape_url(s)
  }
}

type EscapeMode = EscapeHtml | EscapeRaw

type MarkupBracket {
  tag_open: String
  end_tag_open: String
  tag_close: String
  attr_sep: String
  attr_assign: String
  attr_quote: String
}

type TagDelimiter {
  tag: String
  open: String
  close: String
}

type VoidTagRendering = OmitClose | SelfClose

type MarkupMedium {
  tag_overrides: List<TagDelimiter>
  bracket: MarkupBracket
  text_escape: EscapeMode
  void_tags: List<String>
  void_rendering: VoidTagRendering
  raw_text_tags: List<String>
  // Comment delimiters, required on every medium. They are spellings OF the language, so they live
  // with its other spellings (bracket) rather than in whichever module emits a comment: std.languages
  // already records a language's block comment delimiters for the text-generation path, and a markup
  // medium is the object a serializer is allowed to consult. Requiring the field (rather than
  // defaulting to "<!-- ") is deliberate — JSX's comment is {/* … */} and an HTML comment inside JSX
  // is parsed as text, so a default would be wrong for a real medium in this repo.
  comment_open: String
  comment_close: String
  // The keyword that introduces a document-type declaration, "<!DOCTYPE " with the trailing space
  // the tokenizer requires between keyword and name. The declaration's terminator is
  // bracket.tag_close like every other tag's — one spelling for ">" — so it is not repeated here.
  // Required, not Optional: the keyword is one spelling across the languages that have a doctype at
  // all (HTML, XML, and CommonMark, which passes "<!DOCTYPE" through as an HTML block), so every
  // medium here answers correctly; a medium that never builds the fragment still answers the question.
  doctype_open: String
  // What ENDS a comment in this language, as the tokenizer sees it: HTML "-->" (HTML §13.1.1 "comment
  // end state"), JSX "*/" (the terminator of a JSX expression-container comment). Distinct from
  // comment_close, which is what WE WRITE: HTML's emitter puts a space before the terminator for
  // readability (" -->"), and collapsing the two is what lets "a-->b" through — the collapse is a
  // measured control (C5), not a hypothetical.
  //
  // Required, and a guarded route REFUSES a medium whose terminator is empty rather than treating it
  // as "no rule". A medium with no terminator cannot guard a comment at all: there is no string to
  // search for, so "contains the terminator" is vacuously false and every comment passes. A required
  // String is already the shape that makes the omission a type error; the empty value is the
  // remaining way to get there, and it is refused where it would matter.
  comment_terminator: String
  // Whether THIS medium can carry a document-type declaration at all. True for HTML, XML/SVG and
  // CommonMark (which passes "<!DOCTYPE" through as an HTML block, §4.2); FALSE for JSX, whose files
  // are ECMAScript modules — "<!DOCTYPE html>" inside a JSX expression container is not valid TSX, and
  // before review 82181 the guarded JSX route serialized one anyway and returned JsxOk.
  //
  // A Bool on the medium rather than a check written in the JSX module, because the walk is shared: a
  // per-language refusal would be the second copy that got JSX missed in the first place (§6b). A new
  // medium answers the question when it is written; it cannot forget the rule, only state it wrongly.
  document_declaration_allowed: Bool
  // Whether a body ENDING in "-" closes the comment. True for HTML and XML, where the tokenizer's
  // comment-end state is reached from "--" and the emitter's own "-" supplies the third character;
  // false for JSX, where "- */" is an ordinary comment. This is a per-language fact, not a policy
  // knob: it sits beside comment_terminator because the two together are the language's comment
  // grammar, and a medium must answer it — there is no "unset" inhabitant.
  comment_trailing_dash_closes: Bool
}

fn tag_in_set(tag: String, tags: List<String>) -> Bool {
  fold(tags, init: false, f: (acc, t) => acc || t == tag)
}

fn is_void_tag(tag: String, void_tags: List<String>) -> Bool {
  tag_in_set(tag: tag, tags: void_tags)
}

fn escape_text_for(mode: EscapeMode, s: String) -> String {
  match mode {
    EscapeHtml => escape_text(s: s)
    EscapeRaw => s
  }
}

type TagLookup
  = FoundTag { delim: TagDelimiter }
  | NoTag

fn lookup_tag_delimiter(overrides: List<TagDelimiter>, tag: String) -> TagLookup {
  fold(overrides, init: NoTag, f: (acc, d) =>
    match acc {
      FoundTag { delim: r } => FoundTag { delim: r }
      NoTag => if d.tag == tag { FoundTag { delim: d } } else { NoTag }
    }
  )
}

fn serialize_attribute_with(a: Attribute, bracket: MarkupBracket) -> String {
  join([bracket.attr_sep, a.name, bracket.attr_assign, bracket.attr_quote, escape_in(ctx: a.ctx, s: a.value), bracket.attr_quote], "")
}

fn serialize_attributes_with(attrs: List<Attribute>, bracket: MarkupBracket) -> String {
  fold(attrs, init: "", f: (acc, a) => concat(acc, serialize_attribute_with(a: a, bracket: bracket)))
}

fn serialize_fragment_with(frag: Fragment, medium: MarkupMedium) -> String {
  match frag {
    FragmentText { content: c } => escape_text_for(mode: medium.text_escape, s: c)
    RawNode { content: c } => c
    MarkupComment { body: b } => join([medium.comment_open, b, medium.comment_close], "")
    Document { doctype: d, root: r } =>
      join(
        [medium.doctype_open, d, medium.bracket.tag_close, document_line_ending(), serialize_fragment_with(frag: r, medium: medium)],
        "",
      )
    Element { tag: t, attributes: attrs, children: kids } => {
      let attrs_str = serialize_attributes_with(attrs: attrs, bracket: medium.bracket)
      if is_void_tag(tag: t, void_tags: medium.void_tags) {
        match medium.void_rendering {
          OmitClose =>
            join([medium.bracket.tag_open, t, attrs_str, medium.bracket.tag_close], "")
          SelfClose =>
            join([medium.bracket.tag_open, t, attrs_str, " /", medium.bracket.tag_close], "")
        }
      } else {
        let child_medium = if tag_in_set(tag: t, tags: medium.raw_text_tags) {
          MarkupMedium { tag_overrides: medium.tag_overrides, bracket: medium.bracket, text_escape: EscapeRaw, void_tags: medium.void_tags, void_rendering: medium.void_rendering, raw_text_tags: medium.raw_text_tags, comment_open: medium.comment_open, comment_close: medium.comment_close, doctype_open: medium.doctype_open, comment_terminator: medium.comment_terminator, comment_trailing_dash_closes: medium.comment_trailing_dash_closes, document_declaration_allowed: medium.document_declaration_allowed }
        } else {
          medium
        }
        let inner = fold(kids, init: "", f: (acc, k) => concat(acc, serialize_fragment_with(frag: k, medium: child_medium)))
        match lookup_tag_delimiter(overrides: medium.tag_overrides, tag: t) {
          FoundTag { delim: d } =>
            join([d.open, inner, d.close], "")
          NoTag =>
            join([
              medium.bracket.tag_open,
              t,
              attrs_str,
              medium.bracket.tag_close,
              inner,
              medium.bracket.end_tag_open,
              t,
              medium.bracket.tag_close
            ], "")
        }
      }
    }
  }
}

fn attr_is_url_attr(name: String) -> Bool {
  name == "href" || name == "src"
}

fn attribute_escape_context(name: String) -> EscapeContext {
  if attr_is_url_attr(name: name) {
    UrlContext
  } else {
    AttributeContext
  }
}

fn attr(name: String, value: String) -> Attribute {
  Attribute {
    name: name,
    ctx: attribute_escape_context(name: name),
    value: value,
  }
}

// The line break between a document's doctype line and its root element. NOT spelled as a literal
// here: derived from std.layout, which already renders a line break for every generated document in
// the repo, so markup and layout cannot disagree about what ends a line. The protocol is the flat
// one, because a lone DocLine never consults indent_unit (nesting is what reads it).
fn document_line_ending() -> String {
  render(doc: DocLine, proto: LayoutProtocol { indent_unit: "" })
}

type MarkupSerializeResult
  = Serialized { html: String }
  | Rejected { reason: String }

// THE CLOSED OUTCOME OF A HAZARD CHECK, for every medium and every hazard in this layer.
//
// WHY A SUM AND NOT A STRING. The first shape of these checks returned String, with "" meaning
// "clean" and any other value the diagnostic (review 82181 on #14351). That makes the empty string
// carry the load-bearing answer, so a check that ever returns "" — a bug, a stub, a copy-paste of
// itself — PASSES, and the two states are indistinguishable at every call site: `if hazard == ""`
// is a string test, not a type test. DESIGN §5: "every path succeeds fully or fails with a typed,
// located diagnostic, and no plausible output is fabricated." A closed sum means the caller has to
// name both outcomes to compile, and there is no inhabitant that means both.
//
// ONE SUM FOR ALL THE HAZARDS, not one per hazard: the caller's job is "may I serialize this, and
// if not why", which does not vary by hazard. Each reason is located (it names the terminator or
// tag involved) and the hazard that fired is recoverable from its text, which is what a refusal
// surface needs; nothing branches on WHICH hazard.
type MarkupHazard
  = HazardFree
  | HazardFound { reason: String }

// ── ONE HAZARD WALKER, DRIVEN BY THE MEDIUM ─────────────────────────────────────────────────────
// WHY IT LIVES HERE AND NOT BESIDE THE HTML ROWS. The first shape of this check existed once per
// language (review 82181 on #14351): the HTML guarded route consulted a comment hazard and its JSX
// sibling did not, so a comment body containing "*/" closed early and the remainder was parsed as
// TSX, and a Document inside a JSX expression serialized as "<!DOCTYPE html>" where no parser reads
// it — both came back JsxOk. That is §6b's repeated pattern left un-generalized: the two routes
// answered their own language and the shared defect went unguarded. The walk is a fact about
// Fragments and Media, not about HTML, so it is written once in the layer that owns both. A new
// medium gets the check by carrying its comment grammar; it cannot forget to call it.
//
// THREE HAZARDS, ONE WALK:
//   1. a comment body that holds the medium's terminator (or ends in a dash, where that closes),
//   2. a doctype name that is not one bare token,
//   3. a raw-text element whose content contains its own close sequence.
// Each is refused rather than filtered: escaping cannot fix (1) — a comment decodes nothing — and
// stripping the sequence would change what the comment says. (2) is refused because the tokenizer
// reads ONE token after the keyword, so anything else changes how the document parses. (3) is
// refused for the same reason <script> content is: the browser would end the element early.
//
// A MEDIUM WITH NO COMMENT GRAMMAR IS ITSELF A FINDING, not a pass: string_contains(body, "") is
// true of every string, so an empty terminator would refuse everything, and a missing terminator
// treated as "no rule" would pass everything. Neither is acceptable, so an unterminated medium
// refuses with a diagnostic that says which field is unset (§5: located, never silent).

fn comment_body_hazard(body: String, medium: MarkupMedium) -> MarkupHazard {
  if medium.comment_terminator == "" {
    HazardFound { reason: "medium declares no comment terminator (MarkupMedium.comment_terminator is empty) — a comment in this medium cannot be checked for early termination; fill the field or forbid comments in this medium" }
  } else if string_contains(s: body, pattern: medium.comment_terminator) {
    HazardFound { reason: join(["markup comment body contains the comment terminator '", medium.comment_terminator, "' — refusing to serialize (the remainder would be parsed as markup); restructure the comment"], "") }
  } else if medium.comment_trailing_dash_closes && ends_with(s: body, suffix: "-") {
    // "--" before the delimiter's own "-" also reaches the tokenizer's comment end state, so a body
    // ending in a dash closes early even with no terminator in the middle. The remedy differs from
    // the case above (shorten the body vs remove a sequence from it), so the reason differs.
    HazardFound { reason: join(["markup comment body ends in '-' — adjacent to the close delimiter this forms an abrupt '", medium.comment_terminator, "' close; restructure the comment"], "") }
  } else {
    HazardFree
  }
}

// A <!DOCTYPE> name is a production, not free text: the tokenizer reads at most ONE token after the
// keyword, so a name holding whitespace or angle brackets makes the declaration swallow text and the
// document parse in the wrong mode (a page can silently land in quirks mode). Refusing anything but a
// single bare token is construction-side, so a malformed doctype cannot be written.
fn doctype_name_hazard(keyword: String) -> MarkupHazard {
  if keyword == "" {
    HazardFound { reason: "doctype declares no document type — the name after the doctype keyword is what selects the parsing mode" }
  } else if string_contains(s: keyword, pattern: "<") || string_contains(s: keyword, pattern: ">") || string_contains(s: keyword, pattern: " ") {
    HazardFound { reason: join(["doctype name '", keyword, "' is not a single bare token — the tokenizer reads one token after the doctype keyword; anything else changes how the document parses"], "") }
  } else {
    HazardFree
  }
}

fn first_hazard_in(children: List<Fragment>, medium: MarkupMedium) -> MarkupHazard {
  fold(children,
    init: HazardFree,
    f: (acc, c) => match acc {
      HazardFound { reason: r } => HazardFound { reason: r }
      HazardFree => fragment_hazard(node: c, medium: medium)
    })
}

fn raw_text_children_text(children: List<Fragment>) -> String {
  fold(children, init: "", f: (acc, c) => match c {
    FragmentText { content: t } => concat(acc, t)
    RawNode { content: t } => concat(acc, t)
    // A comment is not character data of the raw-text element, and a Document inside one is not
    // legitimate markup; neither contributes text to the close-sequence check, which is about what
    // the raw-text element's own content would terminate early.
    MarkupComment { body: _ } => acc
    Document { doctype: _, root: _ } => acc
    Element { tag: _, attributes: _, children: _ } => acc
  })
}

// THE ONE WALK. Exhaustive over Fragment by construction — a new arm is a compile error here, which
// is the point: an arm that quietly passed would certify an unchecked shape, and a guard that looks
// like it checked is worse than one that is absent.
fn fragment_hazard(node: Fragment, medium: MarkupMedium) -> MarkupHazard {
  match node {
    FragmentText { content: _ } => HazardFree
    RawNode { content: _ } => HazardFree
    MarkupComment { body: b } => comment_body_hazard(body: b, medium: medium)
    Document { doctype: d, root: r } =>
      if !medium.document_declaration_allowed {
        // Refused, not stripped. Dropping the declaration would hand back a fragment whose bytes claim
        // a different document than the caller built, and silently dropping part of a page is the
        // degradation §5 counts; the caller asked for a document type in a medium that has no such
        // thing, which is a construction error at the call site.
        HazardFound { reason: join(["a document-type declaration '", medium.doctype_open, d, "' has no meaning in this medium — it declares ECMAScript/JSX-style modules, not documents; emit the root fragment instead"], "") }
      } else {
        let bad_doctype = doctype_name_hazard(keyword: d)
        match bad_doctype {
          HazardFound { reason: rs } => HazardFound { reason: rs }
          HazardFree => fragment_hazard(node: r, medium: medium)
        }
      }
    Element { tag: t, attributes: _, children: kids } =>
      if tag_in_set(tag: t, tags: medium.raw_text_tags) {
        if string_contains(s: raw_text_children_text(children: kids), pattern: concat("</", t)) {
          HazardFound { reason: join(["raw-text element <", t, "> content contains its own close sequence '</", t, "' — refusing to serialize (corruption otherwise); restructure the content"], "") }
        } else {
          first_hazard_in(children: kids, medium: medium)
        }
      } else {
        first_hazard_in(children: kids, medium: medium)
      }
  }
}
