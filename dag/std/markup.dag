module std.markup

import std.layout { DocLine, LayoutProtocol, render }
import std.types { NonEmptyStr }
import std.error_primitives { pure_dag_seam_unreachable_string }


type EscapeContext = TextContext | AttributeContext | UrlContext

type Attribute {
  name: String
  ctx: EscapeContext
  value: String
}

type Fragment
  = Element { tag: String, attributes: List<Attribute>, children: List<Fragment> }
  | FragmentText { content: String }
  | RawNode { content: String }
  // A markup comment. The BODY is carried, never assembled: the delimiters are the medium's
  // comment_open / comment_close, so "<!-- " exists once per language model instead of once per
  // author — which is the whole reason this arm exists (three sites in this repo spelled the
  // delimiters by hand, and one of them interpolated a value into the middle of them).
  // The body is emitted as-written, like a raw-text element's content: HTML defines no escape syntax
  // inside a comment ("comment state" consumes to the first "-->" and decodes nothing), so escaping
  // would corrupt it rather than protect it. What a body must never do is terminate early, and that
  // is refused rather than filtered — see extdeps.languages.html comment_hazard, which every
  // guarded route consults before serializing.
  | MarkupComment { body: String }

fn escape_text(s: String) -> String {
  replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
}

fn unescape_text(s: String) -> String {
  replace(replace(replace(s, "&lt;", "<"), "&gt;", ">"), "&amp;", "&")
}

fn escape_attribute(s: String) -> String {
  replace(replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;")
}

fn unescape_attribute(s: String) -> String {
  replace(replace(replace(replace(s, "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&amp;", "&")
}

fn escape_url(s: String) -> String {
  replace(replace(replace(replace(replace(s, "%", "%25"), "&", "&amp;"), "\"", "%22"), " ", "%20"), "<", "%3C")
}

fn unescape_url(s: String) -> String {
  replace(replace(replace(replace(replace(s, "%22", "\""), "%20", " "), "%3C", "<"), "&amp;", "&"), "%25", "%")
}

fn escape_in(ctx: EscapeContext, s: String) -> String {
  match ctx {
    TextContext => escape_text(s)
    AttributeContext => escape_attribute(s)
    UrlContext => escape_url(s)
  }
}

fn unescape_in(ctx: EscapeContext, s: String) -> String {
  match ctx {
    TextContext => unescape_text(s)
    AttributeContext => unescape_attribute(s)
    UrlContext => unescape_url(s)
  }
}

type EscapeMode = EscapeHtml | EscapeRaw

type MarkupBracket {
  tag_open: String
  end_tag_open: String
  tag_close: String
  attr_sep: String
  attr_assign: String
  attr_quote: String
}

type TagDelimiter {
  tag: String
  open: String
  close: String
}

type VoidTagRendering = OmitClose | SelfClose

// A language's comment grammar, held as ONE value: the two delimiters the emitter writes, the sequence
// the tokenizer actually stops on, and whether a body ending in "-" reaches that stop state. They are
// carried together because they only make sense together -- HTML writes " -->" but stops on "-->", and
// the gap between those two is exactly where "a-->b" escapes (measured as control C5), so a medium that
// could carry one without the other was a medium that could be wrong by construction.
//
// WHY NO "NO COMMENTS" ARM. A NoCommentGrammar variant was considered and rejected: no medium in this
// repo lacks comments (HTML, XML, Markdown and JSX all have one), so the arm would be a declaration whose
// only consumer is a hypothetical (§3c), and its serializer arm would have to invent behaviour for a
// state nothing reaches. When a comment-less medium is actually written, the arm and its behaviour arrive
// together, from a real need.
type CommentGrammar {
  open: NonEmptyStr
  close: NonEmptyStr
  terminator: NonEmptyStr
  // True for HTML and XML, whose tokenizer reaches the comment end state from "--" and takes the third
  // "-" from the emitter's own close delimiter; false for JSX, where "- */}" is an ordinary comment. A
  // genuine per-language Bool -- it hides no sum, which is why it survives where
  // document_declaration_allowed did not: there is no third state to express, and no field is left over
  // when it is false.
  trailing_dash_closes: Bool
}

type DocumentGrammar
  = DeclaresDocument {
    open: NonEmptyStr
    // The character that ENDS the token after the doctype keyword (HTML §13.1.1 "before the name" state).
    // It rides here rather than being spelled in std/ because which character that is belongs to the
    // language that declares a document type -- the same reason CommentGrammar carries `terminator`, and
    // the shape review 82268 asked for. The angle brackets that also end the token are NOT duplicated
    // here: the walk reads them off MarkupBracket, the pair the serializer writes.
    name_end_whitespace: NonEmptyStr
  }
  | NoDocumentGrammar

type MarkupMedium {
  tag_overrides: List<TagDelimiter>
  bracket: MarkupBracket
  text_escape: EscapeMode
  void_tags: List<String>
  void_rendering: VoidTagRendering
  raw_text_tags: List<String>
  // The language's COMMENT GRAMMAR, as one value. Four facts had to be carried together (open, close,
  // terminator, and whether a trailing dash closes) and each was a separate required field, which let a
  // medium be built with delimiters and no terminator -- and a medium with no terminator cannot guard a
  // comment at all, because there is no string to search for and "body contains the terminator" is then
  // vacuously false for every body. Bundling them makes that state unnameable rather than refused at
  // runtime (§5: "Stronger than catching a wrong state is making it unwritable").
  //
  // The fields are NonEmptyStr, which retires the empty-string sentinel for good: review 82181 replaced
  // the ""-means-clean RETURN with a closed sum, and review 82209 (on #14351) correctly pointed out the
  // sentinel still existed on the INPUT side -- `if medium.comment_terminator == ""` was still a runtime
  // test standing where a type belonged. Now the empty value is not an inhabitant of the field's type.
  // Measured, not assumed: a bare "" literal in one of these positions fails to resolve.
  comment_grammar: CommentGrammar
  // The language's DOCUMENT-TYPE grammar, as a closed sum with two inhabitants, both of them real.
  // HTML, XML/SVG and CommonMark DECLARE (CommonMark 0.30 §4.2 passes "<!DOCTYPE" through as an HTML
  // block); JSX does NOT -- a JSX file is an ECMAScript module, and "<!DOCTYPE html>" inside a JSX
  // expression container is not valid TSX.
  //
  // THE BOOL IT REPLACES, AND WHY ITS ABSENCE WAS A DEFECT. This field was `doctype_open: String` plus
  // `document_declaration_allowed: Bool`, and JSX set the Bool false while STILL being forced to supply a
  // doctype keyword -- which its own comment then called "not applicable". That is a sum expressed as a
  // flag: the type admits an inhabitant that means "there is no such thing, here is a spelling for it",
  // and fragment_hazard had to check the flag at runtime to recover the distinction the type threw away
  // (review 82209 on #14351). Now a medium that declares no document type has no doctype field to fill,
  // and the walk matches on the arm.
  document_grammar: DocumentGrammar
}

fn tag_in_set(tag: String, tags: List<String>) -> Bool {
  fold(tags, init: false, f: (acc, t) => acc || t == tag)
}

fn is_void_tag(tag: String, void_tags: List<String>) -> Bool {
  tag_in_set(tag: tag, tags: void_tags)
}

fn escape_text_for(mode: EscapeMode, s: String) -> String {
  match mode {
    EscapeHtml => escape_text(s: s)
    EscapeRaw => s
  }
}

// A WHOLE DOCUMENT: the document-type declaration and the root element. This is the HTML parser's own
// node ("the Document node is the root node, with the doctype and <html> as children", HTML Living
// Standard §13.2.4), which is why the doctype is a FIELD of a document node and not an element: a doctype
// is not an element and is not inside <html>, so Element or FragmentText could only model it wrongly.
//
// WHY IT IS A TYPE OF ITS OWN AND NOT A FRAGMENT ARM. As a Fragment arm it was representable anywhere a
// Fragment was, including a JSX expression container, where "<!DOCTYPE html>" is not valid TSX. Nothing in
// the type said "only a medium with a document grammar may hold this", so the refusal had to be written on
// each route -- and review 82244 on #14351 found the route that had not been written (the unguarded
// serialize_jsx_fragment / serialize_jsx_component called the serializer directly and would have reached a
// seam labelled unreachable that in fact diverges). §5: "Stronger than catching a wrong state is making it
// unwritable." A Fragment now CANNOT contain a document, so:
//   - serialize_fragment_with is TOTAL (it returns String and has no refusal to skip and no divergent arm),
//   - every Fragment walker loses the Document arm it had to carry (seventeen of them, all added by this
//     change and all now deleted -- the arms existed only because the type allowed the shape),
//   - a document is serialized only through serialize_document_with, whose refusal is a typed result.
// The keyword is the NAME after <!DOCTYPE ("html" selects standards mode); the "<!DOCTYPE " prefix is the
// medium's spelling, so a document cannot carry its own punctuation. The name is NonEmptyStr: an empty
// name is not a document type, and `MarkupDocument { doctype: "", .. }` fails to resolve (measured), so no
// check anywhere asks whether it is empty.
type MarkupDocument {
  doctype: NonEmptyStr
  root: Fragment
}

type TagLookup
  = FoundTag { delim: TagDelimiter }
  | NoTag

fn lookup_tag_delimiter(overrides: List<TagDelimiter>, tag: String) -> TagLookup {
  fold(overrides, init: NoTag, f: (acc, d) =>
    match acc {
      FoundTag { delim: r } => FoundTag { delim: r }
      NoTag => if d.tag == tag { FoundTag { delim: d } } else { NoTag }
    }
  )
}

fn serialize_attribute_with(a: Attribute, bracket: MarkupBracket) -> String {
  join([bracket.attr_sep, a.name, bracket.attr_assign, bracket.attr_quote, escape_in(ctx: a.ctx, s: a.value), bracket.attr_quote], "")
}

fn serialize_attributes_with(attrs: List<Attribute>, bracket: MarkupBracket) -> String {
  fold(attrs, init: "", f: (acc, a) => concat(acc, serialize_attribute_with(a: a, bracket: bracket)))
}

fn serialize_fragment_with(frag: Fragment, medium: MarkupMedium) -> String {
  match frag {
    FragmentText { content: c } => escape_text_for(mode: medium.text_escape, s: c)
    RawNode { content: c } => c
    MarkupComment { body: b } => join([medium.comment_grammar.open as String, b, medium.comment_grammar.close as String], "")
    Element { tag: t, attributes: attrs, children: kids } => {
      let attrs_str = serialize_attributes_with(attrs: attrs, bracket: medium.bracket)
      if is_void_tag(tag: t, void_tags: medium.void_tags) {
        match medium.void_rendering {
          OmitClose =>
            join([medium.bracket.tag_open, t, attrs_str, medium.bracket.tag_close], "")
          SelfClose =>
            join([medium.bracket.tag_open, t, attrs_str, " /", medium.bracket.tag_close], "")
        }
      } else {
        let child_medium = if tag_in_set(tag: t, tags: medium.raw_text_tags) {
          MarkupMedium { tag_overrides: medium.tag_overrides, bracket: medium.bracket, text_escape: EscapeRaw, void_tags: medium.void_tags, void_rendering: medium.void_rendering, raw_text_tags: medium.raw_text_tags, comment_grammar: medium.comment_grammar, document_grammar: medium.document_grammar }
        } else {
          medium
        }
        let inner = fold(kids, init: "", f: (acc, k) => concat(acc, serialize_fragment_with(frag: k, medium: child_medium)))
        match lookup_tag_delimiter(overrides: medium.tag_overrides, tag: t) {
          FoundTag { delim: d } =>
            join([d.open, inner, d.close], "")
          NoTag =>
            join([medium.bracket.tag_open, t, attrs_str, medium.bracket.tag_close, inner, medium.bracket.end_tag_open, t, medium.bracket.tag_close], "")
        }
      }
    }
  }
}

fn attr_is_url_attr(name: String) -> Bool {
  name == "href" || name == "src"
}

fn attribute_escape_context(name: String) -> EscapeContext {
  if attr_is_url_attr(name: name) {
    UrlContext
  } else {
    AttributeContext
  }
}

fn attr(name: String, value: String) -> Attribute {
  Attribute {
    name: name,
    ctx: attribute_escape_context(name: name),
    value: value,
  }
}

// THE ONLY WAY A DOCUMENT IS SERIALIZED. Returns a TYPED RESULT rather than a String for one reason: a
// medium with NoDocumentGrammar has no spelling for a document-type declaration, so there is no string to
// return, and the alternative (a labelled-unreachable seam) was measured to diverge. Review 82244 on
// #14351: the guard lived on one route and the unguarded routes reached the seam. Here there is no route
// around it -- serialize_fragment_with cannot be handed a document at all -- and the refusal is a value
// the caller must match on (§5: "every path succeeds fully or fails with a typed, located diagnostic").
fn serialize_document_with(doc: MarkupDocument, medium: MarkupMedium) -> MarkupSerializeResult {
  match medium.document_grammar {
    NoDocumentGrammar =>
      // Located: it names the medium's own grammar as the reason, and what to do instead.
      Rejected { reason: "this medium declares no document grammar (DocumentGrammar is NoDocumentGrammar), so a document-type declaration has no spelling in it — serialize the root Fragment instead" }
    DeclaresDocument { open: kw } =>
      Serialized { html: join(
        [kw as String, doc.doctype as String, medium.bracket.tag_close, document_line_ending(), serialize_fragment_with(frag: doc.root, medium: medium)],
        "",
      ) }
  }
}

// The document half of the hazard walk, kept beside the type it checks. The doctype NAME is checked here
// (a bare token, or the document parses in the wrong mode) and the root is handed to the fragment walk, so
// a URL or a self-terminating comment inside a document's subtree is found by the same code as anywhere
// else. No "does this medium allow documents" test: serialize_document_with owns that refusal, and asking
// twice is how two answers get to disagree (§3).
fn document_hazard(doc: MarkupDocument, medium: MarkupMedium) -> MarkupHazard {
  match doctype_name_hazard(keyword: doc.doctype, grammar: medium.document_grammar, bracket: medium.bracket) {
    HazardFound { reason: rs } => HazardFound { reason: rs }
    HazardFree => fragment_hazard(node: doc.root, medium: medium)
  }
}

fn document_line_ending() -> String {
  render(doc: DocLine, proto: LayoutProtocol { indent_unit: "" })
}

type MarkupSerializeResult
  = Serialized { html: String }
  | Rejected { reason: String }

// THE CLOSED OUTCOME OF A HAZARD CHECK, for every medium and every hazard in this layer.
//
// WHY A SUM AND NOT A STRING. The first shape of these checks returned String, with "" meaning
// "clean" and any other value the diagnostic (review 82181 on #14351). That makes the empty string
// carry the load-bearing answer, so a check that ever returns "" — a bug, a stub, a copy-paste of
// itself — PASSES, and the two states are indistinguishable at every call site: `if hazard == ""`
// is a string test, not a type test. DESIGN §5: "every path succeeds fully or fails with a typed,
// located diagnostic, and no plausible output is fabricated." A closed sum means the caller has to
// name both outcomes to compile, and there is no inhabitant that means both.
//
// ONE SUM FOR ALL THE HAZARDS, not one per hazard: the caller's job is "may I serialize this, and
// if not why", which does not vary by hazard. Each reason is located (it names the terminator or
// tag involved) and the hazard that fired is recoverable from its text, which is what a refusal
// surface needs; nothing branches on WHICH hazard.
type MarkupHazard
  = HazardFree
  | HazardFound { reason: String }

// ── ONE HAZARD WALKER, DRIVEN BY THE MEDIUM ─────────────────────────────────────────────────────
// WHY IT LIVES HERE AND NOT BESIDE THE HTML ROWS. The first shape of this check existed once per
// language (review 82181 on #14351): the HTML guarded route consulted a comment hazard and its JSX
// sibling did not, so a comment body containing "*/" closed early and the remainder was parsed as
// TSX, and a Document inside a JSX expression serialized as "<!DOCTYPE html>" where no parser reads
// it — both came back JsxOk. That is §6b's repeated pattern left un-generalized: the two routes
// answered their own language and the shared defect went unguarded. The walk is a fact about
// Fragments and Media, not about HTML, so it is written once in the layer that owns both. A new
// medium gets the check by carrying its comment grammar; it cannot forget to call it.
//
// THREE HAZARDS, ONE WALK:
//   1. a comment body that holds the medium's terminator (or ends in a dash, where that closes),
//   2. a doctype name that is not one bare token,
//   3. a raw-text element whose content contains its own close sequence.
// Each is refused rather than filtered: escaping cannot fix (1) — a comment decodes nothing — and
// stripping the sequence would change what the comment says. (2) is refused because the tokenizer
// reads ONE token after the keyword, so anything else changes how the document parses. (3) is
// refused for the same reason <script> content is: the browser would end the element early.
//
// WHAT THIS FUNCTION NO LONGER DOES: it never asks whether the medium's terminator is empty. That
// question was review 82209's second finding -- the closed sum (HazardFree | HazardFound) had retired
// "" as a RETURN value while "" remained a legal INPUT, so the walk had to test for it at runtime.
// CommentGrammar.terminator is NonEmptyStr, so there is no empty inhabitant to test for: the check is
// gone because the state is gone, and the witness that pinned the refusal
// (witness_a_medium_without_a_terminator_refuses_rather_than_passes) was deleted with it rather than
// kept asserting a value the type no longer admits.

fn comment_body_hazard(body: String, grammar: CommentGrammar) -> MarkupHazard {
  if string_contains(s: body, pattern: grammar.terminator as String) {
    HazardFound { reason: join(["markup comment body contains the comment terminator '", grammar.terminator as String, "' — refusing to serialize (the remainder would be parsed as markup); restructure the comment"], "") }
  } else if grammar.trailing_dash_closes && ends_with(s: body, suffix: "-") {
    // "--" before the delimiter's own "-" also reaches the tokenizer's comment end state, so a body
    // ending in a dash closes early even with no terminator in the middle. The remedy differs from the
    // case above (shorten the body vs remove a sequence from it), so the reason differs. Read from the
    // grammar, never hardcoded: witness_medium_grammar_decides_the_dash_rule reds if this line stops
    // consulting the field (control C7).
    HazardFound { reason: join(["markup comment body ends in '-' — adjacent to the close delimiter this forms an abrupt '", grammar.terminator as String, "' close; restructure the comment"], "") }
  } else {
    HazardFree
  }
}

// A <!DOCTYPE> name is a production, not free text: the tokenizer reads at most ONE token after the
// keyword, so a name holding whitespace or an angle bracket makes the declaration swallow text and the
// document parse in the wrong mode (a page can silently land in quirks mode).
//
// WHICH CHARACTERS, AND WHERE THEY COME FROM. Review 82268 on #14351: this read "<", ">" and " " as
// literals inside std/, which is twice wrong -- which characters end that token is a fact about the
// tokenizer of the language that declares a doctype (§4: "a new target language is rows in
// extdeps/languages/, never an edit to the fold"), and the two angle brackets were a SECOND home for a
// spelling the medium already carries, since MarkupBracket.tag_open / tag_close are what
// serialize_fragment_with writes for every tag. So the brackets are READ off the bracket, and the
// whitespace boundary rides DocumentGrammar.DeclaresDocument, the same way CommentGrammar carries
// `terminator`. No language's character is spelled as a literal in this module.
//
// NO EMPTINESS CHECK on the name: NonEmptyStr has no empty inhabitant (measured against the checker), so
// asserting a refusal of one would be asserting an invalid value as expected.
fn doctype_name_hazard(keyword: NonEmptyStr, grammar: DocumentGrammar, bracket: MarkupBracket) -> MarkupHazard {
  let s = keyword as String
  // Read off the grammar that DECLARES a document type, so a medium with no document grammar can never
  // supply a boundary by accident. The NoDocumentGrammar arm answers "no boundary" because it is never
  // consulted: serialize_document_with refuses that grammar before this runs, which is claimed by
  // witness_a_document_medium_refuses_to_write_a_document. Being total here and returning a clean value
  // beats a divergent seam whose reachability was the last finding.
  let whitespace_ends_name = match grammar {
    DeclaresDocument { name_end_whitespace: w } => w as String
    NoDocumentGrammar => ""
  }
  if string_contains(s: s, pattern: bracket.tag_open)
    || string_contains(s: s, pattern: bracket.tag_close)
    || (whitespace_ends_name != "" && string_contains(s: s, pattern: whitespace_ends_name)) {
    HazardFound { reason: join(["doctype name '", s, "' is not a single bare token — the tokenizer reads one token after the doctype keyword; anything else changes how the document parses"], "") }
  } else {
    HazardFree
  }
}

fn first_hazard_in(children: List<Fragment>, medium: MarkupMedium) -> MarkupHazard {
  fold(children,
    init: HazardFree,
    f: (acc, c) => match acc {
      HazardFound { reason: r } => HazardFound { reason: r }
      HazardFree => fragment_hazard(node: c, medium: medium)
    })
}

fn raw_text_children_text(children: List<Fragment>) -> String {
  fold(children, init: "", f: (acc, c) => match c {
    FragmentText { content: t } => concat(acc, t)
    RawNode { content: t } => concat(acc, t)
    // A comment is not character data of the raw-text element, so it contributes no text to the
    // close-sequence check, which is about what the raw-text element's own content would terminate early.
    MarkupComment { body: _ } => acc
    Element { tag: _, attributes: _, children: _ } => acc
  })
}

// THE ONE WALK, over FRAGMENTS ONLY. Exhaustive by construction — a new Fragment arm is a compile error
// here, which is the point: an arm that quietly passed would certify an unchecked shape, and a guard that
// looks like it checked is worse than one that is absent.
//
// It does not walk documents, and cannot be handed one: MarkupDocument is a type of its own, so the shape
// does not exist inside a Fragment. That is what removed this function's Document arm and the seventeen
// others across the repo (review 82244 on #14351). document_hazard is the document half, and it calls here
// for the subtree.
fn fragment_hazard(node: Fragment, medium: MarkupMedium) -> MarkupHazard {
  match node {
    FragmentText { content: _ } => HazardFree
    RawNode { content: _ } => HazardFree
    MarkupComment { body: b } => comment_body_hazard(body: b, grammar: medium.comment_grammar)
    Element { tag: t, attributes: _, children: kids } =>
      if tag_in_set(tag: t, tags: medium.raw_text_tags) {
        // THE SEQUENCE THE EMITTER WILL ACTUALLY WRITE, read from the same medium: bracket.end_tag_open
        // is what serialize_fragment_with puts before the tag name, so a medium that spells an end tag
        // differently gets a guard that looks for THAT spelling. Hardcoding "</" here was review 82268's
        // first finding -- the comment grammar had already been made one value read by both emitter and
        // checker, and this line had been left behind as the second home. §3: "Minimization holds only if
        // each fact lives in exactly one place."
        if string_contains(s: raw_text_children_text(children: kids), pattern: concat(medium.bracket.end_tag_open, t)) {
          HazardFound { reason: join(["raw-text element <", t, "> content contains its own close sequence '</", t, "' — refusing to serialize (corruption otherwise); restructure the content"], "") }
        } else {
          first_hazard_in(children: kids, medium: medium)
        }
      } else {
        first_hazard_in(children: kids, medium: medium)
      }
  }
}
