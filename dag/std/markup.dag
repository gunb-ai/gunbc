module std.markup


type EscapeContext = TextContext | AttributeContext | UrlContext

type Attribute {
  name: std.string_type.String
  ctx: EscapeContext
  value: std.string_type.String
}

type Fragment
  = Element { tag: std.string_type.String, attributes: List<Attribute>, children: List<Fragment> }
  | FragmentText { content: std.string_type.String }
  | RawNode { content: std.string_type.String }

fn escape_text(s: std.string_type.String) -> std.string_type.String {
  replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
}

fn unescape_text(s: std.string_type.String) -> std.string_type.String {
  replace(replace(replace(s, "&lt;", "<"), "&gt;", ">"), "&amp;", "&")
}

fn escape_attribute(s: std.string_type.String) -> std.string_type.String {
  replace(replace(replace(replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;")
}

fn unescape_attribute(s: std.string_type.String) -> std.string_type.String {
  replace(replace(replace(replace(s, "&lt;", "<"), "&gt;", ">"), "&quot;", "\""), "&amp;", "&")
}

fn escape_url(s: std.string_type.String) -> std.string_type.String {
  replace(replace(replace(replace(replace(s, "%", "%25"), "&", "&amp;"), "\"", "%22"), " ", "%20"), "<", "%3C")
}

fn unescape_url(s: std.string_type.String) -> std.string_type.String {
  replace(replace(replace(replace(replace(s, "%22", "\""), "%20", " "), "%3C", "<"), "&amp;", "&"), "%25", "%")
}

fn escape_in(ctx: EscapeContext, s: std.string_type.String) -> std.string_type.String {
  match ctx {
    TextContext => escape_text(s)
    AttributeContext => escape_attribute(s)
    UrlContext => escape_url(s)
  }
}

fn unescape_in(ctx: EscapeContext, s: std.string_type.String) -> std.string_type.String {
  match ctx {
    TextContext => unescape_text(s)
    AttributeContext => unescape_attribute(s)
    UrlContext => unescape_url(s)
  }
}

type EscapeMode = EscapeHtml | EscapeRaw

type MarkupBracket {
  tag_open: std.string_type.String
  end_tag_open: std.string_type.String
  tag_close: std.string_type.String
  attr_sep: std.string_type.String
  attr_assign: std.string_type.String
  attr_quote: std.string_type.String
}

type TagDelimiter {
  tag: std.string_type.String
  open: std.string_type.String
  close: std.string_type.String
}

type VoidTagRendering = OmitClose | SelfClose

type MarkupMedium {
  tag_overrides: List<TagDelimiter>
  bracket: MarkupBracket
  text_escape: EscapeMode
  void_tags: List<std.string_type.String>
  void_rendering: VoidTagRendering
  raw_text_tags: List<std.string_type.String>
}

fn tag_in_set(tag: std.string_type.String, tags: List<std.string_type.String>) -> Bool {
  fold(tags, init: false, f: (acc, t) => acc || t == tag)
}

fn is_void_tag(tag: std.string_type.String, void_tags: List<std.string_type.String>) -> Bool {
  tag_in_set(tag: tag, tags: void_tags)
}

fn escape_text_for(mode: EscapeMode, s: std.string_type.String) -> std.string_type.String {
  match mode {
    EscapeHtml => escape_text(s: s)
    EscapeRaw => s
  }
}

type TagLookup
  = FoundTag { delim: TagDelimiter }
  | NoTag

fn lookup_tag_delimiter(overrides: List<TagDelimiter>, tag: std.string_type.String) -> TagLookup {
  fold(overrides, init: NoTag, f: (acc, d) =>
    match acc {
      FoundTag { delim: r } => FoundTag { delim: r }
      NoTag => if d.tag == tag { FoundTag { delim: d } } else { NoTag }
    }
  )
}

fn serialize_attribute_with(a: Attribute, bracket: MarkupBracket) -> std.string_type.String {
  join([bracket.attr_sep, a.name, bracket.attr_assign, bracket.attr_quote, escape_in(ctx: a.ctx, s: a.value), bracket.attr_quote], "")
}

fn serialize_attributes_with(attrs: List<Attribute>, bracket: MarkupBracket) -> std.string_type.String {
  fold(attrs, init: "", f: (acc, a) => concat(acc, serialize_attribute_with(a: a, bracket: bracket)))
}

fn serialize_fragment_with(frag: Fragment, medium: MarkupMedium) -> std.string_type.String {
  match frag {
    FragmentText { content: c } => escape_text_for(mode: medium.text_escape, s: c)
    RawNode { content: c } => c
    Element { tag: t, attributes: attrs, children: kids } => {
      let attrs_str = serialize_attributes_with(attrs: attrs, bracket: medium.bracket)
      if is_void_tag(tag: t, void_tags: medium.void_tags) {
        match medium.void_rendering {
          OmitClose =>
            join([medium.bracket.tag_open, t, attrs_str, medium.bracket.tag_close], "")
          SelfClose =>
            join([medium.bracket.tag_open, t, attrs_str, " /", medium.bracket.tag_close], "")
        }
      } else {
        let child_medium = if tag_in_set(tag: t, tags: medium.raw_text_tags) {
          MarkupMedium { tag_overrides: medium.tag_overrides, bracket: medium.bracket, text_escape: EscapeRaw, void_tags: medium.void_tags, void_rendering: medium.void_rendering, raw_text_tags: medium.raw_text_tags }
        } else {
          medium
        }
        let inner = fold(kids, init: "", f: (acc, k) => concat(acc, serialize_fragment_with(frag: k, medium: child_medium)))
        match lookup_tag_delimiter(overrides: medium.tag_overrides, tag: t) {
          FoundTag { delim: d } =>
            join([d.open, inner, d.close], "")
          NoTag =>
            join([
              medium.bracket.tag_open,
              t,
              attrs_str,
              medium.bracket.tag_close,
              inner,
              medium.bracket.end_tag_open,
              t,
              medium.bracket.tag_close
            ], "")
        }
      }
    }
  }
}

fn attr_is_url_attr(name: std.string_type.String) -> Bool {
  name == "href" || name == "src"
}

fn attribute_escape_context(name: std.string_type.String) -> EscapeContext {
  if attr_is_url_attr(name: name) {
    UrlContext
  } else {
    AttributeContext
  }
}

fn attr(name: std.string_type.String, value: std.string_type.String) -> Attribute {
  Attribute {
    name: name,
    ctx: attribute_escape_context(name: name),
    value: value,
  }
}

type MarkupSerializeResult
  = Serialized { html: std.string_type.String }
  | Rejected { reason: std.string_type.String }
