module std.types


data kernel_type_set: Map<String, Bool> = {
  "String": true, "Int": true, "Bool": true, "Float": true,
  "Secret": true, "Json": true, "Unit": true, "Bytes": true
}

fn is_kernel_type(name: String) -> Bool {
  match map_get(kernel_type_set, name) {
    Present { value: _ } => true
    Absent => false
  }
}

data container_type_arity: Map<String, Int> = {
  "List": 1, "Set": 1, "Map": 2, "Witness": 1
}

fn is_container_type(name: String) -> Bool {
  match container_expected_arity(name: name) {
    Present { value: _ } => true
    Absent => false
  }
}

fn container_expected_arity(name: String) -> Int? {
  map_get(container_type_arity, name)
}

fn container_param_names_for(kind_name: String) -> List<String> {
  if kind_name == "Witness" {
    ["T"]
  } else {
    match map_get(kernel_algebra_profile, kind_name) {
      Present { value: p } => algebra_type_param_names(profile: p)
      Absent => []
    }
  }
}

fn container_param_name(kind_name: String, index: Int) -> String? {
  let names = container_param_names_for(kind_name: kind_name)
  match names |> enumerate |> filter(pair => pair.first == index) |> map(pair => pair.second) |> first {
    Present { value: name } => Present { value: name }
    Absent => none
  }
}

data ordered_element_collections: Map<String, Bool> = {
  "List": true
}

fn is_ordered_element_collection(name: String) -> Bool {
  map_contains_key(ordered_element_collections, name)
}

data container_template_algebra_rows: Map<String, String> = {
  "List": "FreeMonoid",
  "list": "FreeMonoid",
  "Set": "PointwisePower",
  "set": "PointwisePower",
  "Map": "PartialFunction",
  "map": "PartialFunction",
  "FreeMonoid": "FreeMonoid",
  "free_monoid": "FreeMonoid",
  "BooleanAlgebra": "BooleanAlgebra",
  "boolean_algebra": "BooleanAlgebra",
  "PartialFunction": "PartialFunction",
  "partial_function": "PartialFunction",
  "PointwisePower": "PointwisePower",
  "pointwise_power": "PointwisePower"
}

data container_template_alias_rows: Map<String, String> = {
  "List": "FreeMonoid",
  "list": "FreeMonoid",
  "Set": "PointwisePower",
  "set": "PointwisePower",
  "Map": "PartialFunction",
  "map": "PartialFunction"
}

fn container_template_algebra(name: String) -> String? {
  map_get(container_template_algebra_rows, name)
}

fn container_template_alias_algebra(name: String) -> String? {
  map_get(container_template_alias_rows, name)
}

fn canonical_container_names() -> List<String> {
  ["BooleanAlgebra", "FreeMonoid", "List", "Map", "PartialFunction", "Set", "Witness"]
}

type Bool = True | False

type Unit

type Json
type Bytes

type Char = Int where unicode_scalar, brand("Char")

type List<element> = FreeMonoid<element>
type Set<element> = PointwisePower<element>
type Map<key, value> = PartialFunction<key, value>

fn list_length<T>(items: List<T>) -> Int {
  fold(items, init: 0, f: (acc, _) => acc + 1)
}

type CommitSha    = String

type Sha256       = String
type RetryCount   = Int where range(min: 1, max: 5)
type HttpStatus   = Int where range(min: 100, max: 599)

type Email        = String
type Port         = Int where range(min: 1, max: 65535)

type GistId       = String
type Secret       nominal_opaque = String
type SecretValue  = Secret where non_empty

type SemVer       = String
type NonEmptyStr     = String where non_empty
type LanguageId      = String where non_empty
type SecretName      = String where non_empty

type PathSegment   = NonEmptyStr where brand("PathSegment")
type GlobSegment   = NonEmptyStr where brand("GlobSegment")
type FilePathParts {
  segments: List<PathSegment>
}
type GlobPattern {
  segments: List<GlobSegment>
}
type FilePath      = String where non_empty

type SourceSpan {
  file: FilePath
  start: Int
  end: Int
}

type Timestamp    = String
type EpochMs       = Int where range(min: 0)
type Duration      = Int where range(min: 0)
type Milliseconds  = Int where range(min: 0), brand("Milliseconds")
type Seconds       = Int where range(min: 0), brand("Seconds")

type LogicalTime   = NonEmptyStr where brand("LogicalTime")

type IntentId     = NonEmptyStr where brand("IntentId")
type IssueId      = NonEmptyStr where brand("IssueId")
type RunKey       = NonEmptyStr where brand("RunKey")
type ArtifactId   = NonEmptyStr where brand("ArtifactId")
type LeaseToken   = NonEmptyStr where brand("LeaseToken")
type WorkerId     = NonEmptyStr where brand("WorkerId")
type CommentId    = NonEmptyStr where brand("CommentId")
type SignalKey    = NonEmptyStr where brand("SignalKey")
type ContentHash  = NonEmptyStr where brand("ContentHash")

type WorkflowProducerId = NonEmptyStr where brand("WorkflowProducerId")
type WorkflowObserverId = NonEmptyStr where brand("WorkflowObserverId")
type WorkflowProverId = NonEmptyStr where brand("WorkflowProverId")
type WorkflowRunId = NonEmptyStr where brand("WorkflowRunId")

type GitRef       = String where non_empty

type TopologyNodeKind = Pure | Transport | SubDag | Env
type DocSourceKind    = Template | Generated | Static

type FermiDepth = Xs | S | M | L | Xl

type TextFilePath   = FilePath

type BinaryFilePath = FilePath

type MimeType = String

type HttpMethod = GET | POST | PUT | PATCH | DELETE | HEAD | OPTIONS

type AuthScheme
  = Bearer
  | Header { name: String }
  | Basic { username: String }
  | ApiKey

type AccessToken {
  token: Secret
  scheme: AuthScheme
  expires_at: Timestamp?
}

type Credential {
  token: Secret
  scheme: AuthScheme
  header_name: String?
  source_id: String
  required_scopes: List<String>
  expires_in: Int?
}

type FilesystemHandle = FilePath where brand("FilesystemHandle")
type NetworkHandle    = Unit where brand("NetworkHandle")
type ToolHandle       = String where brand("ToolHandle")

type TransportRequest {
  method: HttpMethod
  url: String
  headers: Json
  body: String
}

type TransportResponse {
  status: Int
  headers: Json
  body: String
}

type FileResponse {
  path: String
  success: Bool
  content: String
}

type ShellResponse {
  exit_code: Int
  stdout: String
  stderr: String
}

type RestResponse {
  status: Int
  headers: Json
  body: Json
}

type TestResult {
  name: String
  ok: Bool
  stdout: String
  stderr: String
  duration_ms: Milliseconds
}

type Summary {
  total: Int
  passed: Int
  failed: Int
}

type StageResult {
  name: String
  success: Bool
  stdout: String
  stderr: String
  skipped: Bool
}

type RenderedTextFile {
  path: String
  content: String
}

type ToolEntry {
  name: String
  command: String
  description: String?
}

type ToolRegistry {
  tools: List<ToolEntry>
}

type DagTopology {
  nodes: List<TopologyNode>
  edges: List<TopologyEdge>
  subdag_boundaries: List<String>
}

type TopologyNode {
  id: String
  label: String
  kind: TopologyNodeKind
  parent: String?
}

type TopologyEdge {
  from: String
  to: String
  port: String?
}

type DagDiff {
  added: List<String>
  removed: List<String>
  changed: List<String>
}

type PragmaDirective {
  key: String
  value: String
  scope: String?
}

type DocSource {
  path: FilePath
  kind: DocSourceKind
}

type ReferenceModel<T>
