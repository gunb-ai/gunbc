  token: std.types.Secret
  scheme: std.types.AuthScheme
  header_name: String?
  source_id: String
  required_scopes: std.types.List<String>
  expires_in: Int?
}

type FilesystemHandle = FilePath where brand("FilesystemHandle")
type NetworkHandle    = Unit where brand("NetworkHandle")
type ToolHandle       = String where brand("ToolHandle")

