module std.kind

import std.occurrence_identity { OccurrenceSynthetic }
import v2.std.algebra { filter, fold_list, list_flat_map }
import v2.std.collection { List, empty_map, map_insert, map_lookup }
import std.types { Map }
import v2.std.node { Atom, Node, Symbol, TypeNode, node_subtree_nodes }
import v2.std.node_query { NamedChildAmbiguous, NamedChildFound, NamedChildMissing, named_child_lookup }
import v2.std.optional { Optional }

// THE KIND OF A TYPE-LEVEL NODE, AT ONE LEVEL (Type_0 only, no universe tower). A node that DENOTES
// a type -- the Int inhabitant, a fn Arrow between inhabitants -- has a type too, and that type is
// its kind, never itself (self-evidence) and never the roster it was found under (provenance, which
// is not a type). Two kinds, because a language authority's declared-inhabitants roster carries two
// different sorts of node: the types it declares, and the facts it states ABOUT each type (surface
// spelling, representation, std projection). Giving both one kind would give that kind two
// meanings (DESIGN section 3's meaning fork), so each has its own.
//
// Checked and rejected as a home: std.syllogism Proposition, an argument record (a String
// statement with premises), which is a different concept from the kind of a fact node.
type Kind
  = TypeDenotationKind
  | TypeFactKind

fn kind_node(kind: Kind) -> Node {
  match kind {
    TypeDenotationKind =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^kind_type_denotation } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
    TypeFactKind =>
      Node {
        kind: TypeNode { connective: Atom { identity: ^kind_type_fact } },
        children: [],
        occurrence_id: OccurrenceSynthetic
      }
  }
}

// WHAT INHABITS EACH KIND, stated by structure so a new member's kind is derived, not chosen. A
// TYPE-DENOTATION RECORD is a Conj carrying an edge labelled with its language's SUBJECT FIELD; that
// edge's target is the type the record declares. Within a roster:
//   - TypeFactKind: every node reachable through a record's OTHER edges -- a facts Conj and its
//     atoms, or a spelling atom hung directly off the record. They describe the subject; none is a
//     type.
//   - TypeDenotationKind: every other member -- the records themselves, their subject atoms, and
//     composites built from records (e.g. a fn Arrow whose positions are records).
// A node that is not a member of the roster has no kind here (Absent).

// THE ROSTER-KIND INDEX, DERIVED ONCE PER ROSTER AND KEYED BY THE NODE. A member's kind is a fact
// about the ROSTER, not about the node that asks: it is fixed when the roster is declared, so it is
// derived once and every query reads it (DESIGN section 2: the demand is shared at its least common
// ancestor, the run that consults the roster, never re-produced per query and never cached per
// query node). The index is a v2.std.collection Map from each member to its kind: every member is
// entered as TypeDenotationKind, then every fact a record states is entered as TypeFactKind over
// it, so a member that is also a fact answers TypeFactKind, exactly as the definition above
// requires. A query is one keyed lookup, so a run's cost is (nodes + roster), not (nodes x roster)
// (DESIGN section 6, bare minimum cost).
//
// LINEAR IN THE ROSTER. A record's facts are its subtree minus the record and its subject, and only
// a RECORD (a member carrying the subject field) walks a subtree -- every other member answers at
// the named-child lookup -- so building the index visits each record's subtree once, never a
// subtree per member and never through a copied accumulator. That bound holds because records do
// not nest in the declared-inhabitants rosters; a record inside another record's facts would be
// walked once per enclosing record. A record is found through the canonical accessor
// v2.std.node_query named_child_lookup, which already requires a Conj; an ambiguous subject field
// is not a record (the language authorities declare one subject edge per record).

type RosterKindIndex {
  kinds: Map<Node, Kind>
}

fn kind_record_fact_nodes(record: Node, subject_field: Symbol) -> List<Node> {
  match named_child_lookup(root: record, name: subject_field) {
    NamedChildFound { target: subject } =>
      filter(
        xs: node_subtree_nodes(root: record),
        predicate: fn(member) { !(member == record) && !(member == subject) }
      )
    NamedChildMissing => []
    NamedChildAmbiguous => []
  }
}

fn roster_kind_enter(kinds: Map<Node, Kind>, nodes: List<Node>, kind: Kind) -> Map<Node, Kind> {
  fold_list(
    xs: nodes,
    empty: kinds,
    cons: fn(acc, n) { roster_kind_enter_one(kinds: acc, n: n, kind: kind) }
  )
}

fn roster_kind_enter_one(kinds: Map<Node, Kind>, n: Node, kind: Kind) -> Map<Node, Kind> {
  map_insert(m: kinds, key: n, value: kind)
}

fn roster_kind_index(roster: Node, subject_field: Symbol) -> RosterKindIndex {
  let members = node_subtree_nodes(root: roster)
  let denotations = roster_kind_enter(kinds: empty_map(), nodes: members, kind: TypeDenotationKind)
  RosterKindIndex {
    kinds: roster_kind_enter(
      kinds: denotations,
      nodes: list_flat_map(
        xs: members,
        f: fn(record) { kind_record_fact_nodes(record: record, subject_field: subject_field) }
      ),
      kind: TypeFactKind
    )
  }
}

fn roster_kind_index_lookup(index: RosterKindIndex, n: Node) -> Optional<Kind> {
  map_lookup(m: index.kinds, key: n)
}
