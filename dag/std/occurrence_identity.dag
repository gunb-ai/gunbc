module std.occurrence_identity



data occurrence_identity_scope_law: String = "OccurrenceId values are unique only inside one explicit graph-scoped OccurrenceIdAllocator. A production source graph threads one allocator across every parsed source; a standalone parse creates one isolated allocator scope. Filename, SourceSpan, authored name, structural Node equality, content hash, and module-local allocator reset are forbidden identity inputs."

data authored_token_ordinal_typed_bridge_note: String = "AuthoredTokenOrdinalSpace carries the opaque shared allocator state, not an arithmetic quantity: callers advance only through the shared allocator boundary and cannot substitute a bare scalar or a differently-denominated measure."

type AuthoredTokenOrdinalSpace {
  allocator: OccurrenceIdAllocator
}

fn authored_token_ordinal_space_initial() -> AuthoredTokenOrdinalSpace {
  AuthoredTokenOrdinalSpace {
    allocator: occurrence_id_allocator_initial()
  }
}

data authored_token_ordinal_value_bridge_note: String = "AuthoredTokenOrdinal is the comparable source-order carrier (strictly-before gating for ModuleExposure). It is a bare Int brand today — not yet Measure<Count, One, Nat> — because the same feature:occurrence-ordinal-value-measure wall that gates AuthoredTokenOrdinalSpace still blocks a faithful HostNative measure projection. Single authority lives here beside AuthoredTokenOrdinalSpace; consumers import the brand, never re-mint a parallel Int wrapper."

type AuthoredTokenOrdinal {
  value: Int
}

fn authored_token_ordinal_before(
  earlier: AuthoredTokenOrdinal,
  later: AuthoredTokenOrdinal
) -> Bool {
  earlier.value < later.value
}

fn authored_token_ordinal_eq(
  left: AuthoredTokenOrdinal,
  right: AuthoredTokenOrdinal
) -> Bool {
  left.value == right.value
}

type OccurrenceId {
  value: Int
}

data occurrence_containment_storage_projection_note: String = "OccurrenceContainmentPath is the concrete compact storage projection of std.occurrence_binding.ContainmentPath<OccurrenceId>. Generic stage0 emission of ContainmentPath<N> with #[derive] carriers needed v1.compiler.trait_derive_emit item-level Clone bounds (PR #7570); that emitter work is prerequisite but does not by itself dissolve this projection — std_occurrence_binding is not on the stage0 roster until PR #7515 lands and proves ContainmentPath<OccurrenceId> compiles there."

type OccurrenceContainmentPath {
  ancestors: std.algebra.FreeMonoid<OccurrenceId>
  terminal: OccurrenceId
}

type OccurrenceCategory
  = LexicalValueOccurrence
  | TypeOccurrence
  | CallableOccurrence
  | ConstructorOccurrence
  | NamespaceSegmentOccurrence
  | FieldOccurrence
  | MethodOccurrence

type OccurrenceCategoryModuleScopeExposureVerdict
  = OccurrenceCategoryModuleScopeExposed
  | OccurrenceCategoryModuleScopeNotExposed {
      category: OccurrenceCategory,
    }

data occurrence_category_module_scope_exposure_verdict_note: String = "Canonical module-scope exposure surface for declaration categories (review 45716 predicate-dissolution): consumers match OccurrenceCategoryModuleScopeExposureVerdict directly — not a parallel Bool predicate over the OccurrenceCategory coproduct. CallableOccurrence, TypeOccurrence, ConstructorOccurrence, and NamespaceSegmentOccurrence are module-scope members; LexicalValueOccurrence, FieldOccurrence, and MethodOccurrence are not."

fn occurrence_category_module_scope_exposure_verdict(
  category: OccurrenceCategory
) -> OccurrenceCategoryModuleScopeExposureVerdict {
  match category {
    CallableOccurrence => OccurrenceCategoryModuleScopeExposed
    TypeOccurrence => OccurrenceCategoryModuleScopeExposed
    ConstructorOccurrence => OccurrenceCategoryModuleScopeExposed
    NamespaceSegmentOccurrence => OccurrenceCategoryModuleScopeExposed
    LexicalValueOccurrence =>
      OccurrenceCategoryModuleScopeNotExposed { category: category }
    FieldOccurrence =>
      OccurrenceCategoryModuleScopeNotExposed { category: category }
    MethodOccurrence =>
      OccurrenceCategoryModuleScopeNotExposed { category: category }
  }
}

type OccurrenceCategoryClauseEDependencyInducingVerdict
  = OccurrenceCategoryClauseEDependencyInducing
  | OccurrenceCategoryClauseEDependencyNotInducing {
      category: OccurrenceCategory,
    }

data occurrence_category_clause_e_dependency_inducing_verdict_note: String = "Canonical clause-(e) reference-category filter surface (review 50193 predicate-dissolution): consumers match OccurrenceCategoryClauseEDependencyInducingVerdict directly — not a parallel inline match over the OccurrenceCategory coproduct. LexicalValueOccurrence, CallableOccurrence, ConstructorOccurrence, and NamespaceSegmentOccurrence references may induce cross-file file dependencies; TypeOccurrence is N2's resolve_type_reference_containment_binding lane; FieldOccurrence and MethodOccurrence do not participate in clause-(e) structural walks."

fn occurrence_category_clause_e_dependency_inducing_verdict(
  category: OccurrenceCategory
) -> OccurrenceCategoryClauseEDependencyInducingVerdict {
  match category {
    LexicalValueOccurrence => OccurrenceCategoryClauseEDependencyInducing
    CallableOccurrence => OccurrenceCategoryClauseEDependencyInducing
    ConstructorOccurrence => OccurrenceCategoryClauseEDependencyInducing
    NamespaceSegmentOccurrence => OccurrenceCategoryClauseEDependencyInducing
    TypeOccurrence =>
      OccurrenceCategoryClauseEDependencyNotInducing { category: category }
    FieldOccurrence =>
      OccurrenceCategoryClauseEDependencyNotInducing { category: category }
    MethodOccurrence =>
      OccurrenceCategoryClauseEDependencyNotInducing { category: category }
  }
}

type OccurrenceRole
  = DeclarationRole
  | ReferenceRole

type OccurrenceProjection {
  occurrence: OccurrenceId
  authored_name: String
  diagnostic_span: std.types.SourceSpan
}

type OccurrenceIndexEntry {
  projection: OccurrenceProjection
  containment: OccurrenceContainmentPath
}

type OccurrenceIndex {
  entries: List<OccurrenceIndexEntry>
}

type DeclarationOccurrence {
  occurrence: OccurrenceId
  containment: OccurrenceContainmentPath
  category: OccurrenceCategory
  diagnostic_span: std.types.SourceSpan
}

type ReferenceOccurrence {
  occurrence: OccurrenceId
  containment: OccurrenceContainmentPath
  category: OccurrenceCategory
  diagnostic_span: std.types.SourceSpan
}

type OccurrenceTransport {
  index: OccurrenceIndex
  declarations: List<DeclarationOccurrence>
  references: List<ReferenceOccurrence>
}

type OccurrenceIdentityAcceptanceLaw {
  id: String
  required_receipt: String
}

data occurrence_identity_acceptance_law_rebuilt_reference: OccurrenceIdentityAcceptanceLaw = OccurrenceIdentityAcceptanceLaw {
  id: "rebuilt-reference-identity-preservation",
  required_receipt: "A production reference rebuild preserves the exact sidecar occurrence identity and containment path; dropping or reminting the occurrence must make the consumer RED.",
}

data occurrence_identity_acceptance_law_collector_dedupe: OccurrenceIdentityAcceptanceLaw = OccurrenceIdentityAcceptanceLaw {
  id: "one-occurrence-collector-dedupe",
  required_receipt: "Two observations of one authored occurrence enter the collector once by exact occurrence identity, never by spelling, SourceSpan, or Node structure.",
}

data occurrence_identity_acceptance_law_distinct_occurrences: OccurrenceIdentityAcceptanceLaw = OccurrenceIdentityAcceptanceLaw {
  id: "structurally-equal-distinct-occurrences",
  required_receipt: "Structurally equal and equally spelled authored occurrences with distinct IDs remain two collector entries.",
}

data occurrence_identity_acceptance_law_pattern_reachability: OccurrenceIdentityAcceptanceLaw = OccurrenceIdentityAcceptanceLaw {
  id: "pattern-declaration-reachability",
  required_receipt: "Authoritative collection reaches every parser-minted pattern declaration occurrence, including nested pattern binders.",
}

data occurrence_identity_acceptance_law_parser_isolation: OccurrenceIdentityAcceptanceLaw = OccurrenceIdentityAcceptanceLaw {
  id: "same-spelling-parser-declaration-isolation",
  required_receipt: "Same-spelling declarations and references in sibling match arms, nested lets, lambdas, and parameters retain distinct authored identities and containment paths without overwrite.",
}

data occurrence_identity_acceptance_laws: List<OccurrenceIdentityAcceptanceLaw> = [
  occurrence_identity_acceptance_law_rebuilt_reference,
  occurrence_identity_acceptance_law_collector_dedupe,
  occurrence_identity_acceptance_law_distinct_occurrences,
  occurrence_identity_acceptance_law_pattern_reachability,
  occurrence_identity_acceptance_law_parser_isolation,
]

type OccurrenceTransportRefusal
  = MissingAuthoredOccurrenceIdentity { diagnostic_span: std.types.SourceSpan }
  | DuplicateAuthoredOccurrenceIdentity { occurrence: OccurrenceId, diagnostic_span: std.types.SourceSpan }
  | DuplicateSuppliedCandidateIdentity { occurrence: OccurrenceId, diagnostic_span: std.types.SourceSpan }
  | InconsistentOccurrenceContainment {
      occurrence: OccurrenceId,
      diagnostic_span: std.types.SourceSpan,
    }
  | WrongOccurrenceRole {
      occurrence: OccurrenceId,
      expected: OccurrenceRole,
      observed: OccurrenceRole,
      diagnostic_span: std.types.SourceSpan,
    }
  | UnknownOccurrenceIdentity { occurrence: OccurrenceId }

data occurrence_identity_constructor_spelling_note: String = "NodeOccurrenceIdentity uses collision-free neutral constructors because .dag variant names are closure-global: the legacy v2 SyntheticOccurrence/MintedOccurrence facade and identically named shared constructors cannot coexist in one conversion closure. The constructor spelling is representation; this shared carrier and its allocator remain the semantic authority."

type NodeOccurrenceIdentity
  = OccurrenceSynthetic
  | OccurrenceMinted { id: OccurrenceId }

type OccurrenceIdAllocator {
  next_id: Int
}

type OccurrenceIdAllocResult {
  id: OccurrenceId
  alloc: OccurrenceIdAllocator
}

fn occurrence_id_allocator_initial() -> OccurrenceIdAllocator {
  OccurrenceIdAllocator { next_id: 0 }
}

fn alloc_occurrence_id(alloc: OccurrenceIdAllocator) -> OccurrenceIdAllocResult {
  OccurrenceIdAllocResult {
    id: OccurrenceId { value: alloc.next_id },
    alloc: OccurrenceIdAllocator { next_id: alloc.next_id + 1 },
  }
}

fn occurrence_id_eq(left: OccurrenceId, right: OccurrenceId) -> Bool {
  left.value == right.value
}

fn occurrence_id_allocator_advance_to(
  alloc: OccurrenceIdAllocator,
  min_next: AuthoredTokenOrdinalSpace
) -> OccurrenceIdAllocator {
  let min_next_value = min_next.allocator.next_id
  if alloc.next_id < min_next_value {
    OccurrenceIdAllocator { next_id: min_next_value }
  } else {
    alloc
  }
}

fn authored_token_ordinal_space_from_allocator(
  alloc: OccurrenceIdAllocator
) -> AuthoredTokenOrdinalSpace {
  AuthoredTokenOrdinalSpace {
    allocator: alloc
  }
}

fn node_occurrence_identity_minted(id: OccurrenceId) -> NodeOccurrenceIdentity {
  OccurrenceMinted { id: id }
}

data occurrence_transport_validation_complexity_law: String = "occurrence_transport_refusal builds each graph-local identity/category index exactly once, then validates declaration and reference rows by indexed lookup. It must never rescan a full occurrence population per authored occurrence."

fn occurrence_containment_matches_occurrence(
  containment: OccurrenceContainmentPath,
  occurrence: OccurrenceId
) -> Bool {
  containment.terminal.value == occurrence.value
}

fn occurrence_containment_paths_equal(
  left: OccurrenceContainmentPath,
  right: OccurrenceContainmentPath
) -> Bool {
  left.ancestors == right.ancestors &&
  left.terminal.value == right.terminal.value
}

data occurrence_containment_path_prefix_note: String = "Canonical containment-prefix predicates for structural exposure (review 45716 single-authority; review 47424 fold surface): declaration containment is exposed to a reference when prefix is a prefix of path. Ancestors are compared by projecting each FreeMonoid through fold (never a local Empty/Cons recursive match — DESIGN predicate/walker dissolution). Consumers import these from std.occurrence_identity — never reproduce locally."

fn occurrence_containment_path_contains_ancestor(
  ancestors: std.algebra.FreeMonoid<OccurrenceId>,
  target: OccurrenceId
) -> Bool {
  fold(
    ancestors,
    init: false,
    f: (found, id) => found || id.value == target.value,
  )
}

fn occurrence_containment_ancestors_as_list(
  ancestors: std.algebra.FreeMonoid<OccurrenceId>
) -> List<OccurrenceId> {
  reverse(fold(
    ancestors,
    init: [],
    f: (acc, id) => concat([id], acc),
  ))
}

type OccurrenceIdListPrefixAcc {
  path_remaining: List<OccurrenceId>
  ok: Bool
}

fn occurrence_id_list_is_prefix_of(
  prefix: List<OccurrenceId>,
  path: List<OccurrenceId>
) -> Bool {
  fold(
    prefix,
    init: OccurrenceIdListPrefixAcc {
      path_remaining: path,
      ok: true,
    },
    f: (acc, expected) =>
      if !acc.ok {
        acc
      } else if (acc.path_remaining |> count) == 0 {
        OccurrenceIdListPrefixAcc {
          path_remaining: [],
          ok: false,
        }
      } else if occurrence_id_eq(
        left: acc.path_remaining.first(),
        right: expected,
      ) {
        OccurrenceIdListPrefixAcc {
          path_remaining: acc.path_remaining.skip(n: 1),
          ok: true,
        }
      } else {
        OccurrenceIdListPrefixAcc {
          path_remaining: acc.path_remaining,
          ok: false,
        }
      },
  ).ok
}

fn occurrence_containment_ancestors_are_prefix_of(
  prefix_ancestors: std.algebra.FreeMonoid<OccurrenceId>,
  path_ancestors: std.algebra.FreeMonoid<OccurrenceId>
) -> Bool {
  occurrence_id_list_is_prefix_of(
    prefix: occurrence_containment_ancestors_as_list(ancestors: prefix_ancestors),
    path: occurrence_containment_ancestors_as_list(ancestors: path_ancestors),
  )
}

fn occurrence_containment_path_is_prefix_of(
  prefix: OccurrenceContainmentPath,
  path: OccurrenceContainmentPath
) -> Bool {
  if occurrence_containment_paths_equal(left: prefix, right: path) {
    true
  } else if prefix.terminal.value == path.terminal.value {
    occurrence_containment_ancestors_are_prefix_of(
      prefix_ancestors: prefix.ancestors,
      path_ancestors: path.ancestors,
    )
  } else {
    occurrence_containment_path_contains_ancestor(
      ancestors: path.ancestors,
      target: prefix.terminal,
    )
  }
}

type OccurrenceTransportIndexBuild {
  entries_by_id: Map<Int, OccurrenceIndexEntry>
  refusal: OccurrenceTransportRefusal?
}

fn occurrence_transport_index_build(
  index: OccurrenceIndex
) -> OccurrenceTransportIndexBuild {
  fold(
    index.entries,
    init: OccurrenceTransportIndexBuild {
      entries_by_id: empty_map(),
      refusal: none,
    },
    f: (build, entry) =>
      match build.refusal {
        Present { value: _ } => build
        Absent =>
          match map_get(
            build.entries_by_id,
            entry.projection.occurrence.value
          ) {
            Present { value: existing } =>
              OccurrenceTransportIndexBuild {
                entries_by_id: build.entries_by_id,
                refusal: Present {
                  value: DuplicateAuthoredOccurrenceIdentity {
                    occurrence: existing.projection.occurrence,
                    diagnostic_span: existing.projection.diagnostic_span,
                  },
                },
              }
            Absent =>
              if occurrence_containment_matches_occurrence(
                containment: entry.containment,
                occurrence: entry.projection.occurrence
              ) {
                OccurrenceTransportIndexBuild {
                  entries_by_id: map_insert(
                    build.entries_by_id,
                    entry.projection.occurrence.value,
                    entry
                  ),
                  refusal: none,
                }
              } else {
                OccurrenceTransportIndexBuild {
                  entries_by_id: build.entries_by_id,
                  refusal: Present {
                    value: InconsistentOccurrenceContainment {
                      occurrence: entry.projection.occurrence,
                      diagnostic_span: entry.projection.diagnostic_span,
                    },
                  },
                }
              }
          }
      }
  )
}

type OccurrenceTransportRoleIndexBuild {
  declarations_by_id: Map<Int, DeclarationOccurrence>
  references_by_id: Map<Int, ReferenceOccurrence>
  refusal: OccurrenceTransportRefusal?
}

fn occurrence_transport_role_index_build(
  declarations: List<DeclarationOccurrence>,
  references: List<ReferenceOccurrence>
) -> OccurrenceTransportRoleIndexBuild {
  let declaration_build = fold(
    declarations,
    init: OccurrenceTransportRoleIndexBuild {
      declarations_by_id: empty_map(),
      references_by_id: empty_map(),
      refusal: none,
    },
    f: (build, declaration) =>
      match build.refusal {
        Present { value: _ } => build
        Absent =>
          match map_get(
            build.declarations_by_id,
            declaration.occurrence.value
          ) {
            Present { value: existing } =>
              OccurrenceTransportRoleIndexBuild {
                declarations_by_id: build.declarations_by_id,
                references_by_id: build.references_by_id,
                refusal: Present {
                  value: DuplicateAuthoredOccurrenceIdentity {
                    occurrence: existing.occurrence,
                    diagnostic_span: existing.diagnostic_span,
                  },
                },
              }
            Absent =>
              OccurrenceTransportRoleIndexBuild {
                declarations_by_id: map_insert(
                  build.declarations_by_id,
                  declaration.occurrence.value,
                  declaration
                ),
                references_by_id: build.references_by_id,
                refusal: none,
              }
          }
      }
  )
  match declaration_build.refusal {
    Present { value: _ } => declaration_build
    Absent =>
      fold(
        references,
        init: declaration_build,
        f: (build, reference) =>
          match build.refusal {
            Present { value: _ } => build
            Absent =>
              match map_get(
                build.references_by_id,
                reference.occurrence.value
              ) {
                Present { value: existing } =>
                  OccurrenceTransportRoleIndexBuild {
                    declarations_by_id: build.declarations_by_id,
                    references_by_id: build.references_by_id,
                    refusal: Present {
                      value: DuplicateAuthoredOccurrenceIdentity {
                        occurrence: existing.occurrence,
                        diagnostic_span: existing.diagnostic_span,
                      },
                    },
                  }
                Absent =>
                  OccurrenceTransportRoleIndexBuild {
                    declarations_by_id: build.declarations_by_id,
                    references_by_id: map_insert(
                      build.references_by_id,
                      reference.occurrence.value,
                      reference
                    ),
                    refusal: none,
                  }
              }
          }
      )
  }
}

fn declaration_occurrence_refusal(
  index_by_id: Map<Int, OccurrenceIndexEntry>,
  references_by_id: Map<Int, ReferenceOccurrence>,
  declaration: DeclarationOccurrence
) -> OccurrenceTransportRefusal? {
  match map_get(index_by_id, declaration.occurrence.value) {
    Absent =>
      Present {
        value: MissingAuthoredOccurrenceIdentity {
          diagnostic_span: declaration.diagnostic_span,
        },
      }
    Present { value: entry } =>
      if occurrence_containment_paths_equal(
        left: declaration.containment,
        right: entry.containment
      ) {
        match map_get(references_by_id, declaration.occurrence.value) {
          Present { value: reference } =>
            Present {
              value: WrongOccurrenceRole {
                occurrence: declaration.occurrence,
                expected: DeclarationRole,
                observed: ReferenceRole,
                diagnostic_span: declaration.diagnostic_span,
              },
            }
          Absent => none
        }
      } else {
        Present {
          value: InconsistentOccurrenceContainment {
            occurrence: declaration.occurrence,
            diagnostic_span: declaration.diagnostic_span,
          },
        }
      }
  }
}

fn reference_occurrence_refusal(
  index_by_id: Map<Int, OccurrenceIndexEntry>,
  declarations_by_id: Map<Int, DeclarationOccurrence>,
  reference: ReferenceOccurrence
) -> OccurrenceTransportRefusal? {
  match map_get(index_by_id, reference.occurrence.value) {
    Absent =>
      Present {
        value: MissingAuthoredOccurrenceIdentity {
          diagnostic_span: reference.diagnostic_span,
        },
      }
    Present { value: entry } =>
      if occurrence_containment_paths_equal(
        left: reference.containment,
        right: entry.containment
      ) {
        match map_get(declarations_by_id, reference.occurrence.value) {
          Present { value: declaration } =>
            Present {
              value: WrongOccurrenceRole {
                occurrence: reference.occurrence,
                expected: ReferenceRole,
                observed: DeclarationRole,
                diagnostic_span: reference.diagnostic_span,
              },
            }
          Absent => none
        }
      } else {
        Present {
          value: InconsistentOccurrenceContainment {
            occurrence: reference.occurrence,
            diagnostic_span: reference.diagnostic_span,
          },
        }
      }
  }
}

type ValidatedOccurrenceTransport {
  entries_by_id: Map<Int, OccurrenceIndexEntry>
  declarations_by_id: Map<Int, DeclarationOccurrence>
  references_by_id: Map<Int, ReferenceOccurrence>
  declarations: List<DeclarationOccurrence>
  references: List<ReferenceOccurrence>
}

type OccurrenceTransportValidation
  = OccurrenceTransportValidated { transport: ValidatedOccurrenceTransport }
  | OccurrenceTransportRefused { refusal: OccurrenceTransportRefusal }

data occurrence_transport_validation_authority_note: String = "Canonical transport validity boundary: occurrence_transport_validate builds each graph-local identity/category index exactly once and either refuses or yields ValidatedOccurrenceTransport whose entries_by_id, declarations_by_id, and references_by_id are the exact lookup authorities. Resolvers consume the validated carrier and never rescan OccurrenceIndex.entries or either role population per supplied identity. The declaration/reference lists remain as the authored transport order, not as lookup paths."

fn occurrence_transport_validate(
  transport: OccurrenceTransport
) -> OccurrenceTransportValidation {
  let index_build = occurrence_transport_index_build(
    index: transport.index
  )
  match index_build.refusal {
    Present { value: refusal } => OccurrenceTransportRefused { refusal: refusal }
    Absent =>
      let role_index_build = occurrence_transport_role_index_build(
        declarations: transport.declarations,
        references: transport.references
      )
      match role_index_build.refusal {
        Present { value: refusal } => OccurrenceTransportRefused { refusal: refusal }
        Absent =>
          let declaration_refusal = fold(
            transport.declarations,
            init: none,
            f: (refusal, declaration) =>
              match refusal {
                Present { value: _ } => refusal
                Absent => declaration_occurrence_refusal(
                  index_by_id: index_build.entries_by_id,
                  references_by_id: role_index_build.references_by_id,
                  declaration: declaration
                )
              }
          )
          match declaration_refusal {
            Present { value: refusal } => OccurrenceTransportRefused { refusal: refusal }
            Absent =>
              let reference_refusal = fold(
                transport.references,
                init: none,
                f: (refusal, reference) =>
                  match refusal {
                    Present { value: _ } => refusal
                    Absent => reference_occurrence_refusal(
                      index_by_id: index_build.entries_by_id,
                      declarations_by_id: role_index_build.declarations_by_id,
                      reference: reference
                    )
                  }
              )
              match reference_refusal {
                Present { value: refusal } => OccurrenceTransportRefused { refusal: refusal }
                Absent => OccurrenceTransportValidated {
                  transport: ValidatedOccurrenceTransport {
                    entries_by_id: index_build.entries_by_id,
                    declarations_by_id: role_index_build.declarations_by_id,
                    references_by_id: role_index_build.references_by_id,
                    declarations: transport.declarations,
                    references: transport.references,
                  },
                }
              }
          }
      }
  }
}

fn occurrence_transport_refusal(
  transport: OccurrenceTransport
) -> OccurrenceTransportRefusal? {
  match occurrence_transport_validate(transport: transport) {
    OccurrenceTransportRefused { refusal: refusal } => Present { value: refusal }
    OccurrenceTransportValidated { transport: _ } => none
  }
}

data authored_token_ordinal_typed_bridge_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "feature:occurrence-ordinal-value-measure — DISSOLVE-ON: std.nat converges on the modeled Nat inhabitant and Measure<Count, One, Nat> has a compiled faithful/HostNative serde projection; then replace the allocator-backed space payload with that canonical measure and delete both typed-bridge rows.")

data authored_token_ordinal_value_bridge_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "feature:occurrence-ordinal-value-measure — DISSOLVE-ON: same trigger as authored_token_ordinal_typed_bridge_dissolve_on; replace AuthoredTokenOrdinal.value with Measure<Count, One, Nat> (or the converged Nat inhabitant) and delete both value-bridge rows with the space-bridge rows.")

data occurrence_containment_storage_projection_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "DISSOLVE-ON: PR #7515 lands std_occurrence_binding on the stage0 roster and proves ContainmentPath<OccurrenceId> compiles without supplemental derive bounds; then replace OccurrenceContainmentPath with std.occurrence_binding.ContainmentPath<OccurrenceId> across consumers and delete both storage-projection rows.")
