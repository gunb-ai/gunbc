module std.occurrence_identity

import std.types { Bool, Int, String }

data occurrence_identity_scope_law: String = "OccurrenceId values are unique only inside one explicit graph-scoped occurrence space. Production parsing assigns every source a disjoint authored-token ordinal range. Identity is the packed authored-token ordinal plus a typed edge role; filename, SourceSpan, authored name, structural Node equality, content hash, and module-local reset are forbidden identity inputs."

data occurrence_identity_constructor_spelling_note: String = "Shared NodeOccurrenceId uses collision-free neutral constructors because .dag variant names are closure-global: legacy v2 SyntheticOccurrence/MintedOccurrence and identically named shared constructors cannot coexist in one conversion closure. Constructor spelling is representation; this shared carrier remains the sole semantic authority."

data occurrence_identity_slots_per_authored_token: Int = 4

type OccurrenceId {
  value: Int
}

type NodeOccurrenceId
  = OccurrenceSynthetic
  | OccurrenceMinted { id: OccurrenceId }

type DeclarationOccurrence {
  identity: OccurrenceId
}

type ReferenceOccurrence {
  identity: OccurrenceId
}

type AuthoredOccurrence
  = AuthoredDeclarationOccurrence { occurrence: DeclarationOccurrence }
  | AuthoredReferenceOccurrence { occurrence: ReferenceOccurrence }

type AuthoredOccurrenceRole
  = DeclarationOccurrenceRole
  | PrimaryReferenceOccurrenceRole
  | LabelReferenceOccurrenceRole

type DeclarationOccurrenceProjection
  = DeclarationOccurrenceAccepted { occurrence: DeclarationOccurrence }
  | DeclarationOccurrenceWrongCategory { identity: OccurrenceId }
  | DeclarationOccurrenceMalformed { identity: OccurrenceId }

type ReferenceOccurrenceProjection
  = ReferenceOccurrenceAccepted { occurrence: ReferenceOccurrence }
  | ReferenceOccurrenceWrongCategory { identity: OccurrenceId }
  | ReferenceOccurrenceMalformed { identity: OccurrenceId }

type OccurrenceIdAllocator {
  next_id: Int
}

type OccurrenceIdAllocResult {
  id: OccurrenceId
  alloc: OccurrenceIdAllocator
}

fn occurrence_id_allocator_initial() -> OccurrenceIdAllocator {
  OccurrenceIdAllocator { next_id: 0 }
}

fn alloc_occurrence_id(alloc: OccurrenceIdAllocator) -> OccurrenceIdAllocResult {
  OccurrenceIdAllocResult {
    id: OccurrenceId { value: alloc.next_id },
    alloc: OccurrenceIdAllocator { next_id: alloc.next_id + 1 },
  }
}

fn occurrence_id_eq(left: OccurrenceId, right: OccurrenceId) -> Bool {
  left.value == right.value
}

fn occurrence_id_allocator_advance_to(
  alloc: OccurrenceIdAllocator,
  min_next: Int
) -> OccurrenceIdAllocator {
  if alloc.next_id < min_next {
    OccurrenceIdAllocator { next_id: min_next }
  } else {
    alloc
  }
}

fn authored_occurrence_role_slot(role: AuthoredOccurrenceRole) -> Int {
  match role {
    DeclarationOccurrenceRole => 0
    PrimaryReferenceOccurrenceRole => 1
    LabelReferenceOccurrenceRole => 2
  }
}

fn authored_occurrence_identity(
  token_ordinal: Int,
  role: AuthoredOccurrenceRole
) -> OccurrenceId {
  OccurrenceId {
    value: (token_ordinal * occurrence_identity_slots_per_authored_token)
      + authored_occurrence_role_slot(role: role),
  }
}

fn declaration_occurrence_for_token(token_ordinal: Int) -> DeclarationOccurrence {
  DeclarationOccurrence {
    identity: authored_occurrence_identity(
      token_ordinal: token_ordinal,
      role: DeclarationOccurrenceRole,
    ),
  }
}

fn primary_reference_occurrence_for_token(token_ordinal: Int) -> ReferenceOccurrence {
  ReferenceOccurrence {
    identity: authored_occurrence_identity(
      token_ordinal: token_ordinal,
      role: PrimaryReferenceOccurrenceRole,
    ),
  }
}

fn label_reference_occurrence_for_token(token_ordinal: Int) -> ReferenceOccurrence {
  ReferenceOccurrence {
    identity: authored_occurrence_identity(
      token_ordinal: token_ordinal,
      role: LabelReferenceOccurrenceRole,
    ),
  }
}

fn authored_declaration_occurrence(
  occurrence: DeclarationOccurrence
) -> AuthoredOccurrence {
  AuthoredDeclarationOccurrence { occurrence: occurrence }
}

fn authored_reference_occurrence(
  occurrence: ReferenceOccurrence
) -> AuthoredOccurrence {
  AuthoredReferenceOccurrence { occurrence: occurrence }
}

fn occurrence_identity_slot(identity: OccurrenceId) -> Int {
  identity.value % occurrence_identity_slots_per_authored_token
}

fn declaration_occurrence_from_identity(
  identity: OccurrenceId
) -> DeclarationOccurrenceProjection {
  if identity.value < 0 || occurrence_identity_slot(identity: identity) == 3 {
    DeclarationOccurrenceMalformed { identity: identity }
  } else if occurrence_identity_slot(identity: identity) == 0 {
    DeclarationOccurrenceAccepted {
      occurrence: DeclarationOccurrence { identity: identity },
    }
  } else {
    DeclarationOccurrenceWrongCategory { identity: identity }
  }
}

fn reference_occurrence_from_identity(
  identity: OccurrenceId
) -> ReferenceOccurrenceProjection {
  if identity.value < 0 || occurrence_identity_slot(identity: identity) == 3 {
    ReferenceOccurrenceMalformed { identity: identity }
  } else if occurrence_identity_slot(identity: identity) == 0 {
    ReferenceOccurrenceWrongCategory { identity: identity }
  } else {
    ReferenceOccurrenceAccepted {
      occurrence: ReferenceOccurrence { identity: identity },
    }
  }
}

fn occurrence_node_minted(id: OccurrenceId) -> NodeOccurrenceId {
  OccurrenceMinted { id: id }
}
