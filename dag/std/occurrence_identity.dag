    required_receipt: "Structurally equal and equally spelled authored occurrences with distinct IDs remain two collector entries.",
    owner: "namespace-canonical-binding",
    dissolve_on: "DISSOLVE-ON: the distinct-authored-occurrences collector RED executes against the sidecar consumer; delete this row in the same PR.",
  },
  OccurrenceIdentityConsumerRedDebt {
