module std.occurrence_binding_resolve


data occurrence_binding_resolve_authority_note: String = "THE one exact name-binding decision for a supplied candidate population. P1 validates transport and exact reference/declaration identities, excludes category-inadmissible declarations, converts the remaining exact declarations to BindingCandidate<OccurrenceId>, and calls std.occurrence_binding.occurrence_binding_from_candidates exactly once. It does not derive visibility, source order, spelling equivalence, or a candidate catalogue: those are the downstream structural-candidate producer's responsibility."

data occurrence_binding_resolve_transport_boundary_note: String = "Transport validity is outside OccurrenceBindingResult: malformed transports or supplied identities that do not name the validated reference/declaration roles refuse as OccurrenceReferenceBindingTransportRefused before any Bound/Unbound/Ambiguous decision. ValidatedOccurrenceTransport entries_by_id, references_by_id, and declarations_by_id are the exact lookup authorities; the resolver never rescans a transported population."

data occurrence_binding_resolve_duplicate_identity_law: String = "A supplied candidate population contains semantic declarations, not discovery observations. P2 candidate construction collapses repeated discovery of one exact full identity before supplying the population. If a raw supplied list nevertheless repeats an OccurrenceId, P1 refuses with DuplicateSuppliedCandidateIdentity before the cardinality fold; it never silently deduplicates a defective producer input and never reports one declaration as genuine ambiguity."

type OccurrenceCategoryBindingVerdict
  = OccurrenceCategoryBindingAdmissible
  | OccurrenceCategoryBindingInadmissible {
      reference: std.occurrence_identity.OccurrenceCategory,
      declaration: std.occurrence_identity.OccurrenceCategory,
    }

data occurrence_category_binding_verdict_note: String = "Canonical namespace-binding reference×declaration category compatibility surface (review 44773 predicate-dissolution): consumers match OccurrenceCategoryBindingVerdict directly — not a parallel Bool predicate over the OccurrenceCategory coproduct. Occurrence identity carries each category; this binding authority alone decides their admissibility relation."

fn occurrence_category_binding_verdict(
  reference: std.occurrence_identity.OccurrenceCategory,
  declaration: std.occurrence_identity.OccurrenceCategory
) -> OccurrenceCategoryBindingVerdict {
  match reference {
    TypeOccurrence =>
      match declaration {
        TypeOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    LexicalValueOccurrence =>
      match declaration {
        LexicalValueOccurrence => OccurrenceCategoryBindingAdmissible
        CallableOccurrence => OccurrenceCategoryBindingAdmissible
        ConstructorOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    CallableOccurrence =>
      match declaration {
        CallableOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    ConstructorOccurrence =>
      match declaration {
        ConstructorOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    FieldOccurrence =>
      match declaration {
        FieldOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    MethodOccurrence =>
      match declaration {
        MethodOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    NamespaceSegmentOccurrence =>
      match declaration {
        NamespaceSegmentOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
  }
}

fn occurrence_containment_to_binding_path(
  path: std.occurrence_identity.OccurrenceContainmentPath
) -> ContainmentPath<std.occurrence_identity.OccurrenceId> {
  std.occurrence_binding.ContainmentPath {
    ancestors: path.ancestors,
    terminal: path.terminal,
  }
}

fn binding_occurrence_from_reference(
  reference: std.occurrence_identity.ReferenceOccurrence
) -> BindingOccurrence<std.occurrence_identity.OccurrenceId> {
  std.occurrence_binding.BindingOccurrence {
    containment: occurrence_containment_to_binding_path(
      path: reference.containment,
    ),
  }
}

fn binding_candidate_from_declaration(
  declaration: std.occurrence_identity.DeclarationOccurrence
) -> BindingCandidate<std.occurrence_identity.OccurrenceId> {
  std.occurrence_binding.BindingCandidate {
    containment: occurrence_containment_to_binding_path(
      path: declaration.containment,
    ),
  }
}

type OccurrenceCandidatePopulationBuild {
  candidates: FreeMonoid<BindingCandidate<std.occurrence_identity.OccurrenceId>>
  seen_candidate_ids: Map<Int, std.occurrence_identity.OccurrenceId>
  refusal: std.occurrence_identity.OccurrenceTransportRefusal?
}

fn binding_candidates_from_supplied_declarations(
  validated: std.occurrence_identity.ValidatedOccurrenceTransport,
  reference: std.occurrence_identity.ReferenceOccurrence,
  supplied_candidates: List<std.occurrence_identity.OccurrenceId>
) -> OccurrenceCandidatePopulationBuild {
  fold(
    supplied_candidates,
    init: OccurrenceCandidatePopulationBuild {
      candidates: Empty,
      seen_candidate_ids: empty_map(),
      refusal: none,
    },
    f: (build, candidate_occurrence) =>
      match build.refusal {
        Present { value: _ } => build
        Absent =>
          match map_get(
            validated.entries_by_id,
            candidate_occurrence.value,
          ) {
            Absent =>
              OccurrenceCandidatePopulationBuild {
                candidates: build.candidates,
                seen_candidate_ids: build.seen_candidate_ids,
                refusal: Present {
                  value: std.occurrence_identity.UnknownOccurrenceIdentity {
                    occurrence: candidate_occurrence,
                  },
                },
              }
            Present { value: entry } =>
              match map_get(
                build.seen_candidate_ids,
                candidate_occurrence.value,
              ) {
                Present { value: _ } =>
                  OccurrenceCandidatePopulationBuild {
                    candidates: build.candidates,
                    seen_candidate_ids: build.seen_candidate_ids,
                    refusal: Present {
                      value: std.occurrence_identity.DuplicateSuppliedCandidateIdentity {
                        occurrence: candidate_occurrence,
                        diagnostic_span: entry.projection.diagnostic_span,
                      },
                    },
                  }
                Absent =>
                  match map_get(
                    validated.declarations_by_id,
                    candidate_occurrence.value,
                  ) {
                    Absent =>
                      match map_get(
                        validated.references_by_id,
                        candidate_occurrence.value,
                      ) {
                        Present { value: observed_reference } =>
                          OccurrenceCandidatePopulationBuild {
                            candidates: build.candidates,
                            seen_candidate_ids: build.seen_candidate_ids,
                            refusal: Present {
                              value: std.occurrence_identity.WrongOccurrenceRole {
                                occurrence: candidate_occurrence,
                                expected: DeclarationRole,
                                observed: ReferenceRole,
                                diagnostic_span: observed_reference.diagnostic_span,
                              },
                            },
                          }
                        Absent =>
                          OccurrenceCandidatePopulationBuild {
                            candidates: build.candidates,
                            seen_candidate_ids: build.seen_candidate_ids,
                            refusal: Present {
                              value: std.occurrence_identity.MissingAuthoredOccurrenceIdentity {
                                diagnostic_span: entry.projection.diagnostic_span,
                              },
                            },
                          }
                      }
                    Present { value: declaration } =>
                      let seen_candidate_ids = map_insert(
                        build.seen_candidate_ids,
                        candidate_occurrence.value,
                        candidate_occurrence,
                      )
                      match occurrence_category_binding_verdict(
                        reference: reference.category,
                        declaration: declaration.category,
                      ) {
                        OccurrenceCategoryBindingAdmissible =>
                          OccurrenceCandidatePopulationBuild {
                            candidates: concat(
                              build.candidates,
                              [binding_candidate_from_declaration(
                                declaration: declaration,
                              )],
                            ),
                            seen_candidate_ids: seen_candidate_ids,
                            refusal: none,
                          }
                        OccurrenceCategoryBindingInadmissible {
                          reference: _,
                          declaration: _,
                        } =>
                          OccurrenceCandidatePopulationBuild {
                            candidates: build.candidates,
                            seen_candidate_ids: seen_candidate_ids,
                            refusal: none,
                          }
                      }
                  }
              }
          }
      },
  )
}

type OccurrenceReferenceBindingOutcome
  = OccurrenceReferenceBindingDecided {
      result: OccurrenceBindingResult<std.occurrence_identity.OccurrenceId>,
    }
  | OccurrenceReferenceBindingTransportRefused {
      refusal: std.occurrence_identity.OccurrenceTransportRefusal,
    }

fn reference_occurrence_by_id(
  validated: std.occurrence_identity.ValidatedOccurrenceTransport,
  occurrence: std.occurrence_identity.OccurrenceId
) -> std.occurrence_identity.ReferenceOccurrence? {
  map_get(validated.references_by_id, occurrence.value)
}

fn resolve_reference_occurrence_binding_validated(
  validated: std.occurrence_identity.ValidatedOccurrenceTransport,
  occurrence: std.occurrence_identity.OccurrenceId,
  supplied_candidates: List<std.occurrence_identity.OccurrenceId>
) -> OccurrenceReferenceBindingOutcome {
  match map_get(validated.entries_by_id, occurrence.value) {
    Absent =>
      match reference_occurrence_by_id(validated: validated, occurrence: occurrence) {
        Present { value: reference } =>
          OccurrenceReferenceBindingTransportRefused {
            refusal: std.occurrence_identity.MissingAuthoredOccurrenceIdentity {
              diagnostic_span: reference.diagnostic_span,
            },
          }
        Absent =>
          OccurrenceReferenceBindingTransportRefused {
            refusal: std.occurrence_identity.UnknownOccurrenceIdentity { occurrence: occurrence },
          }
      }
    Present { value: entry } =>
      match reference_occurrence_by_id(validated: validated, occurrence: occurrence) {
        Absent =>
          match map_get(validated.declarations_by_id, occurrence.value) {
            Present { value: observed_declaration } =>
              OccurrenceReferenceBindingTransportRefused {
                refusal: std.occurrence_identity.WrongOccurrenceRole {
                  occurrence: occurrence,
                  expected: ReferenceRole,
                  observed: DeclarationRole,
                  diagnostic_span: observed_declaration.diagnostic_span,
                },
              }
            Absent =>
              OccurrenceReferenceBindingTransportRefused {
                refusal: std.occurrence_identity.MissingAuthoredOccurrenceIdentity {
                  diagnostic_span: entry.projection.diagnostic_span,
                },
              }
          }
        Present { value: reference } =>
          let build = binding_candidates_from_supplied_declarations(
            validated: validated,
            reference: reference,
            supplied_candidates: supplied_candidates,
          )
          match build.refusal {
            Present { value: refusal } =>
              OccurrenceReferenceBindingTransportRefused {
                refusal: refusal,
              }
            Absent =>
              OccurrenceReferenceBindingDecided {
                result: occurrence_binding_from_candidates(
                  occurrence: binding_occurrence_from_reference(
                    reference: reference,
                  ),
                  candidates: build.candidates,
                ),
              }
          }
      }
  }
}

fn resolve_reference_occurrence_binding(
  transport: std.occurrence_identity.OccurrenceTransport,
  occurrence: std.occurrence_identity.OccurrenceId,
  supplied_candidates: List<std.occurrence_identity.OccurrenceId>
) -> OccurrenceReferenceBindingOutcome {
  match occurrence_transport_validate(transport: transport) {
    OccurrenceTransportRefused { refusal: refusal } =>
      OccurrenceReferenceBindingTransportRefused { refusal: refusal }
    OccurrenceTransportValidated { transport: validated } =>
      resolve_reference_occurrence_binding_validated(
        validated: validated,
        occurrence: occurrence,
        supplied_candidates: supplied_candidates,
      )
  }
}
