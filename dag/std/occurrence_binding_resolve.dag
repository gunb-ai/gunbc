module std.occurrence_binding_resolve

import std.algebra { FreeMonoid, Empty, Cons }
import std.types { String, List, Int }
import std.coercion {
  TypeDeclarationProvenance,
  CorpusDeclared,
  KernelMinted,
  DeclarationIdentityAbsent,
}
import std.occurrence_binding {
  ContainmentPath,
  BindingOccurrence,
  BindingCandidate,
  OccurrenceBindingResult,
  occurrence_binding_from_candidates,
}
import std.occurrence_identity {
  OccurrenceId,
  OccurrenceContainmentPath,
  OccurrenceTransport,
  OccurrenceTransportRefusal,
  OccurrenceTransportValidated,
  OccurrenceTransportRefused,
  MissingAuthoredOccurrenceIdentity,
  UnknownOccurrenceIdentity,
  ValidatedOccurrenceTransport,
  DeclarationOccurrence,
  ReferenceOccurrence,
  OccurrenceCategory,
  LexicalValueOccurrence,
  TypeOccurrence,
  CallableOccurrence,
  ConstructorOccurrence,
  NamespaceSegmentOccurrence,
  FieldOccurrence,
  MethodOccurrence,
  DeclarationRole,
  ReferenceRole,
  DuplicateSuppliedCandidateIdentity,
  WrongOccurrenceRole,
  occurrence_transport_validate,
}

// THE one exact name-binding decision for a supplied candidate population. P1 validates transport
// and exact reference/declaration identities, excludes category-inadmissible declarations, converts
// the remaining exact declarations to BindingCandidate<OccurrenceId>, and calls
// std.occurrence_binding.occurrence_binding_from_candidates exactly once. It does not derive
// visibility, source order, spelling equivalence, or a candidate catalogue: those are the
// downstream structural-candidate producer's responsibility.

// Transport validity is outside OccurrenceBindingResult: malformed transports or supplied
// identities that do not name the validated reference/declaration roles refuse as
// OccurrenceReferenceBindingTransportRefused before any Bound/Unbound/Ambiguous decision.
// ValidatedOccurrenceTransport entries_by_id, references_by_id, and declarations_by_id are the
// exact lookup authorities; the resolver never rescans a transported population.

// A supplied candidate population contains semantic declarations, not discovery observations. P2
// candidate construction collapses repeated discovery of one exact full identity before supplying
// the population. If a raw supplied list nevertheless repeats an OccurrenceId, P1 refuses with
// DuplicateSuppliedCandidateIdentity before the cardinality fold; it never silently deduplicates a
// defective producer input and never reports one declaration as genuine ambiguity.

type OccurrenceCategoryBindingVerdict
  = OccurrenceCategoryBindingAdmissible
  | OccurrenceCategoryBindingInadmissible {
      reference: OccurrenceCategory,
      declaration: OccurrenceCategory,
    }

// Canonical namespace-binding reference×declaration category compatibility surface (review 44773
// predicate-dissolution): consumers match OccurrenceCategoryBindingVerdict directly — not a
// parallel Bool predicate over the OccurrenceCategory coproduct. Occurrence identity carries each
// category; this binding authority alone decides their admissibility relation.

fn occurrence_category_binding_verdict(
  reference: OccurrenceCategory,
  declaration: OccurrenceCategory
) -> OccurrenceCategoryBindingVerdict {
  match reference {
    TypeOccurrence =>
      match declaration {
        TypeOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    LexicalValueOccurrence =>
      match declaration {
        LexicalValueOccurrence => OccurrenceCategoryBindingAdmissible
        CallableOccurrence => OccurrenceCategoryBindingAdmissible
        ConstructorOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    CallableOccurrence =>
      match declaration {
        CallableOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    ConstructorOccurrence =>
      match declaration {
        ConstructorOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    FieldOccurrence =>
      match declaration {
        FieldOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    MethodOccurrence =>
      match declaration {
        MethodOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
    NamespaceSegmentOccurrence =>
      match declaration {
        NamespaceSegmentOccurrence => OccurrenceCategoryBindingAdmissible
        _ => OccurrenceCategoryBindingInadmissible {
          reference: reference,
          declaration: declaration,
        }
      }
  }
}

fn occurrence_containment_to_binding_path(
  path: OccurrenceContainmentPath
) -> ContainmentPath<OccurrenceId> {
  ContainmentPath {
    ancestors: path.ancestors,
    terminal: path.terminal,
  }
}

fn binding_occurrence_from_reference(
  reference: ReferenceOccurrence
) -> BindingOccurrence<OccurrenceId> {
  BindingOccurrence {
    containment: occurrence_containment_to_binding_path(
      path: reference.containment,
    ),
  }
}

fn binding_candidate_from_declaration(
  declaration: DeclarationOccurrence
) -> BindingCandidate<OccurrenceId> {
  BindingCandidate {
    containment: occurrence_containment_to_binding_path(
      path: declaration.containment,
    ),
  }
}

type OccurrenceCandidatePopulationBuild {
  candidates: FreeMonoid<BindingCandidate<OccurrenceId>>
  seen_candidate_ids: Map<Int, OccurrenceId>
  refusal: OccurrenceTransportRefusal?
}

fn binding_candidates_from_supplied_declarations(
  validated: ValidatedOccurrenceTransport,
  reference: ReferenceOccurrence,
  supplied_candidates: List<OccurrenceId>
) -> OccurrenceCandidatePopulationBuild {
  fold(
    supplied_candidates,
    init: OccurrenceCandidatePopulationBuild {
      candidates: Empty,
      seen_candidate_ids: empty_map(),
      refusal: none,
    },
    f: (build, candidate_occurrence) =>
      match build.refusal {
        Present { value: _ } => build
        Absent =>
          match map_get(
            validated.entries_by_id,
            candidate_occurrence.value,
          ) {
            Absent =>
              OccurrenceCandidatePopulationBuild {
                candidates: build.candidates,
                seen_candidate_ids: build.seen_candidate_ids,
                refusal: Present {
                  value: UnknownOccurrenceIdentity {
                    occurrence: candidate_occurrence,
                  },
                },
              }
            Present { value: entry } =>
              match map_get(
                build.seen_candidate_ids,
                candidate_occurrence.value,
              ) {
                Present { value: _ } =>
                  OccurrenceCandidatePopulationBuild {
                    candidates: build.candidates,
                    seen_candidate_ids: build.seen_candidate_ids,
                    refusal: Present {
                      value: DuplicateSuppliedCandidateIdentity {
                        occurrence: candidate_occurrence,
                        diagnostic_span: entry.projection.diagnostic_span,
                      },
                    },
                  }
                Absent =>
                  match map_get(
                    validated.declarations_by_id,
                    candidate_occurrence.value,
                  ) {
                    Absent =>
                      match map_get(
                        validated.references_by_id,
                        candidate_occurrence.value,
                      ) {
                        Present { value: observed_reference } =>
                          OccurrenceCandidatePopulationBuild {
                            candidates: build.candidates,
                            seen_candidate_ids: build.seen_candidate_ids,
                            refusal: Present {
                              value: WrongOccurrenceRole {
                                occurrence: candidate_occurrence,
                                expected: DeclarationRole,
                                observed: ReferenceRole,
                                diagnostic_span: observed_reference.diagnostic_span,
                              },
                            },
                          }
                        Absent =>
                          OccurrenceCandidatePopulationBuild {
                            candidates: build.candidates,
                            seen_candidate_ids: build.seen_candidate_ids,
                            refusal: Present {
                              value: MissingAuthoredOccurrenceIdentity {
                                diagnostic_span: entry.projection.diagnostic_span,
                              },
                            },
                          }
                      }
                    Present { value: declaration } =>
                      let seen_candidate_ids = map_insert(
                        build.seen_candidate_ids,
                        candidate_occurrence.value,
                        candidate_occurrence,
                      )
                      match occurrence_category_binding_verdict(
                        reference: reference.category,
                        declaration: declaration.category,
                      ) {
                        OccurrenceCategoryBindingAdmissible =>
                          OccurrenceCandidatePopulationBuild {
                            candidates: concat(
                              build.candidates,
                              [binding_candidate_from_declaration(
                                declaration: declaration,
                              )],
                            ),
                            seen_candidate_ids: seen_candidate_ids,
                            refusal: none,
                          }
                        OccurrenceCategoryBindingInadmissible {
                          reference: _,
                          declaration: _,
                        } =>
                          OccurrenceCandidatePopulationBuild {
                            candidates: build.candidates,
                            seen_candidate_ids: seen_candidate_ids,
                            refusal: none,
                          }
                      }
                  }
              }
          }
      },
  )
}

type OccurrenceReferenceBindingOutcome
  = OccurrenceReferenceBindingDecided {
      result: OccurrenceBindingResult<OccurrenceId>,
    }
  | OccurrenceReferenceBindingTransportRefused {
      refusal: OccurrenceTransportRefusal,
    }

fn reference_occurrence_by_id(
  validated: ValidatedOccurrenceTransport,
  occurrence: OccurrenceId
) -> ReferenceOccurrence? {
  map_get(validated.references_by_id, occurrence.value)
}

type ReferenceBindingCandidatePopulation
  = ReferenceBindingCandidatePopulationReady {
      reference: ReferenceOccurrence,
      candidates: FreeMonoid<BindingCandidate<OccurrenceId>>,
    }
  | ReferenceBindingCandidatePopulationRefused {
      refusal: OccurrenceTransportRefusal,
    }

fn reference_binding_candidates_validated(
  validated: ValidatedOccurrenceTransport,
  occurrence: OccurrenceId,
  supplied_candidates: List<OccurrenceId>
) -> ReferenceBindingCandidatePopulation {
  match map_get(validated.entries_by_id, occurrence.value) {
    Absent =>
      match reference_occurrence_by_id(validated: validated, occurrence: occurrence) {
        Present { value: reference } =>
          ReferenceBindingCandidatePopulationRefused {
            refusal: MissingAuthoredOccurrenceIdentity {
              diagnostic_span: reference.diagnostic_span,
            },
          }
        Absent =>
          ReferenceBindingCandidatePopulationRefused {
            refusal: UnknownOccurrenceIdentity { occurrence: occurrence },
          }
      }
    Present { value: entry } =>
      match reference_occurrence_by_id(validated: validated, occurrence: occurrence) {
        Absent =>
          match map_get(validated.declarations_by_id, occurrence.value) {
            Present { value: observed_declaration } =>
              ReferenceBindingCandidatePopulationRefused {
                refusal: WrongOccurrenceRole {
                  occurrence: occurrence,
                  expected: ReferenceRole,
                  observed: DeclarationRole,
                  diagnostic_span: observed_declaration.diagnostic_span,
                },
              }
            Absent =>
              ReferenceBindingCandidatePopulationRefused {
                refusal: MissingAuthoredOccurrenceIdentity {
                  diagnostic_span: entry.projection.diagnostic_span,
                },
              }
          }
        Present { value: reference } =>
          let build = binding_candidates_from_supplied_declarations(
            validated: validated,
            reference: reference,
            supplied_candidates: supplied_candidates,
          )
          match build.refusal {
            Present { value: refusal } =>
              ReferenceBindingCandidatePopulationRefused {
                refusal: refusal,
              }
            Absent =>
              ReferenceBindingCandidatePopulationReady {
                reference: reference,
                candidates: build.candidates,
              }
          }
      }
  }
}

fn resolve_reference_occurrence_binding_validated(
  validated: ValidatedOccurrenceTransport,
  occurrence: OccurrenceId,
  supplied_candidates: List<OccurrenceId>
) -> OccurrenceReferenceBindingOutcome {
  match reference_binding_candidates_validated(
    validated: validated,
    occurrence: occurrence,
    supplied_candidates: supplied_candidates,
  ) {
    ReferenceBindingCandidatePopulationRefused { refusal: refusal } =>
      OccurrenceReferenceBindingTransportRefused { refusal: refusal }
    ReferenceBindingCandidatePopulationReady { reference: reference, candidates: candidates } =>
      OccurrenceReferenceBindingDecided {
        result: occurrence_binding_from_candidates(
          occurrence: binding_occurrence_from_reference(reference: reference),
          candidates: candidates,
        ),
      }
  }
}

fn resolve_reference_occurrence_binding(
  transport: OccurrenceTransport,
  occurrence: OccurrenceId,
  supplied_candidates: List<OccurrenceId>
) -> OccurrenceReferenceBindingOutcome {
  match occurrence_transport_validate(transport: transport) {
    OccurrenceTransportRefused { refusal: refusal } =>
      OccurrenceReferenceBindingTransportRefused { refusal: refusal }
    OccurrenceTransportValidated { transport: validated } =>
      resolve_reference_occurrence_binding_validated(
        validated: validated,
        occurrence: occurrence,
        supplied_candidates: supplied_candidates,
      )
  }
}


// Identity and declaration evidence are different coordinates. A reference or scope retains its
// authored identity with DeclarationIdentityAbsent: it is not a type declaration. Kernel terminals
// carry the actual producer's KernelMinted evidence and have no authored OccurrenceId. In
// particular, CorpusDeclared.decl_file never replaces the declaration's exact occurrence identity.
type TypeBindingIdentity {
  occurrence: OccurrenceId?
  provenance: TypeDeclarationProvenance
}

type TypeDeclarationOccurrenceEvidence {
  occurrence: OccurrenceId
  provenance: TypeDeclarationProvenance
}

type TypeBindingEvidenceRefusal
  = TypeBindingReferenceCategoryRefused {
      occurrence: OccurrenceId,
      observed: OccurrenceCategory,
    }
  | TypeBindingDeclarationEvidenceMissing {
      occurrence: OccurrenceId,
    }
  | TypeBindingDeclarationEvidenceRepeated {
      occurrence: OccurrenceId,
      first: TypeDeclarationProvenance,
      repeated: TypeDeclarationProvenance,
    }
  | TypeBindingAuthoredDeclarationEvidenceRefused {
      occurrence: OccurrenceId,
      observed: TypeDeclarationProvenance,
    }
  | TypeBindingKernelDeclarationEvidenceRefused {
      observed: TypeDeclarationProvenance,
    }
  | TypeBindingKernelDeclarationRepeated {
      observed: TypeDeclarationProvenance,
    }

type TypeOccurrenceReferenceBindingOutcome
  = TypeOccurrenceReferenceBindingDecided {
      result: OccurrenceBindingResult<TypeBindingIdentity>,
    }
  | TypeOccurrenceReferenceBindingTransportRefused {
      refusal: OccurrenceTransportRefusal,
    }
  | TypeOccurrenceReferenceBindingEvidenceRefused {
      refusal: TypeBindingEvidenceRefusal,
    }

type TypeDeclarationEvidenceIndexBuild {
  evidence: Map<Int, TypeDeclarationProvenance>
  refusal: TypeBindingEvidenceRefusal?
}

fn type_declaration_evidence_index(
  rows: List<TypeDeclarationOccurrenceEvidence>
) -> TypeDeclarationEvidenceIndexBuild {
  fold(
    rows,
    init: TypeDeclarationEvidenceIndexBuild { evidence: empty_map(), refusal: none },
    f: (build, row) => match build.refusal {
      Present { value: _ } => build
      Absent => match map_get(build.evidence, row.occurrence.value) {
        Present { value: first } => TypeDeclarationEvidenceIndexBuild {
          evidence: build.evidence,
          refusal: Present { value: TypeBindingDeclarationEvidenceRepeated {
            occurrence: row.occurrence,
            first: first,
            repeated: row.provenance,
          } },
        }
        Absent => TypeDeclarationEvidenceIndexBuild {
          evidence: map_insert(build.evidence, row.occurrence.value, row.provenance),
          refusal: none,
        }
      }
    },
  )
}

fn type_binding_nondeclaration_identity(occurrence: OccurrenceId) -> TypeBindingIdentity {
  TypeBindingIdentity { occurrence: Present { value: occurrence }, provenance: DeclarationIdentityAbsent }
}

fn type_binding_reference_path(path: OccurrenceContainmentPath) -> ContainmentPath<TypeBindingIdentity> {
  ContainmentPath {
    ancestors: map(path.ancestors, ancestor => type_binding_nondeclaration_identity(occurrence: ancestor)),
    terminal: type_binding_nondeclaration_identity(occurrence: path.terminal),
  }
}

type TypeBindingCandidateUnionBuild {
  candidates_reversed: List<BindingCandidate<TypeBindingIdentity>>
  kernel_names: Map<String, TypeDeclarationProvenance>
  refusal: TypeBindingEvidenceRefusal?
}

fn type_binding_authored_candidate_step(
  build: TypeBindingCandidateUnionBuild,
  candidate: BindingCandidate<OccurrenceId>,
  evidence: Map<Int, TypeDeclarationProvenance>
) -> TypeBindingCandidateUnionBuild {
  match build.refusal {
    Present { value: _ } => build
    Absent => match map_get(evidence, candidate.containment.terminal.value) {
      Absent => TypeBindingCandidateUnionBuild {
        candidates_reversed: build.candidates_reversed,
        kernel_names: build.kernel_names,
        refusal: Present { value: TypeBindingDeclarationEvidenceMissing {
          occurrence: candidate.containment.terminal,
        } },
      }
      Present { value: provenance } => match provenance {
        CorpusDeclared { decl_file: _ } => TypeBindingCandidateUnionBuild {
          candidates_reversed: Cons {
            head: BindingCandidate { containment: ContainmentPath {
              ancestors: map(candidate.containment.ancestors, ancestor => type_binding_nondeclaration_identity(occurrence: ancestor)),
              terminal: TypeBindingIdentity {
                occurrence: Present { value: candidate.containment.terminal },
                provenance: provenance,
              },
            } },
            tail: build.candidates_reversed,
          },
          kernel_names: build.kernel_names,
          refusal: none,
        }
        _ => TypeBindingCandidateUnionBuild {
          candidates_reversed: build.candidates_reversed,
          kernel_names: build.kernel_names,
          refusal: Present { value: TypeBindingAuthoredDeclarationEvidenceRefused {
            occurrence: candidate.containment.terminal,
            observed: provenance,
          } },
        }
      }
    }
  }
}

fn type_binding_kernel_candidate_step(
  build: TypeBindingCandidateUnionBuild,
  provenance: TypeDeclarationProvenance
) -> TypeBindingCandidateUnionBuild {
  match build.refusal {
    Present { value: _ } => build
    Absent => match provenance {
      KernelMinted { minted_name: minted_name } => match map_get(build.kernel_names, minted_name) {
        Present { value: _ } => TypeBindingCandidateUnionBuild {
          candidates_reversed: build.candidates_reversed,
          kernel_names: build.kernel_names,
          refusal: Present { value: TypeBindingKernelDeclarationRepeated { observed: provenance } },
        }
        Absent => TypeBindingCandidateUnionBuild {
          candidates_reversed: Cons {
            head: BindingCandidate { containment: ContainmentPath {
              ancestors: Empty,
              terminal: TypeBindingIdentity { occurrence: none, provenance: provenance },
            } },
            tail: build.candidates_reversed,
          },
          kernel_names: map_insert(build.kernel_names, minted_name, provenance),
          refusal: none,
        }
      }
      _ => TypeBindingCandidateUnionBuild {
        candidates_reversed: build.candidates_reversed,
        kernel_names: build.kernel_names,
        refusal: Present { value: TypeBindingKernelDeclarationEvidenceRefused { observed: provenance } },
      }
    }
  }
}

// The caller supplies structurally selected declarations, just as for the authored-only P1 seam.
// Kernel evidence is read from the compiler's actual declaration producer. This function neither
// selects a name nor manufactures provenance. There is exactly one cardinality decision, AFTER
// the two candidate populations have been combined; an authored/kernel collision cannot privilege
// either class. A non-type reference refuses before this type-specific union can be constructed.
fn resolve_type_occurrence_binding_with_kernel_candidates(
  transport: OccurrenceTransport,
  occurrence: OccurrenceId,
  supplied_candidates: List<OccurrenceId>,
  declaration_evidence: List<TypeDeclarationOccurrenceEvidence>,
  kernel_candidates: List<TypeDeclarationProvenance>
) -> TypeOccurrenceReferenceBindingOutcome {
  match occurrence_transport_validate(transport: transport) {
    OccurrenceTransportRefused { refusal: refusal } =>
      TypeOccurrenceReferenceBindingTransportRefused { refusal: refusal }
    OccurrenceTransportValidated { transport: validated } =>
      match reference_binding_candidates_validated(
        validated: validated,
        occurrence: occurrence,
        supplied_candidates: supplied_candidates,
      ) {
        ReferenceBindingCandidatePopulationRefused { refusal: refusal } =>
          TypeOccurrenceReferenceBindingTransportRefused { refusal: refusal }
        ReferenceBindingCandidatePopulationReady { reference: reference, candidates: candidates } =>
          match reference.category {
            TypeOccurrence =>
              let evidence = type_declaration_evidence_index(rows: declaration_evidence)
              match evidence.refusal {
                Present { value: refusal } => TypeOccurrenceReferenceBindingEvidenceRefused { refusal: refusal }
                Absent =>
                  let authored = fold(
                    candidates,
                    init: TypeBindingCandidateUnionBuild {
                      candidates_reversed: Empty,
                      kernel_names: empty_map(),
                      refusal: none,
                    },
                    f: (build, candidate) => type_binding_authored_candidate_step(
                      build: build,
                      candidate: candidate,
                      evidence: evidence.evidence,
                    ),
                  )
                  let combined = fold(
                    kernel_candidates,
                    init: authored,
                    f: (build, provenance) => type_binding_kernel_candidate_step(build: build, provenance: provenance),
                  )
                  match combined.refusal {
                    Present { value: refusal } => TypeOccurrenceReferenceBindingEvidenceRefused { refusal: refusal }
                    Absent => TypeOccurrenceReferenceBindingDecided {
                      result: occurrence_binding_from_candidates(
                        occurrence: BindingOccurrence { containment: type_binding_reference_path(path: reference.containment) },
                        candidates: reverse(combined.candidates_reversed),
                      ),
                    }
                  }
              }
            _ => TypeOccurrenceReferenceBindingEvidenceRefused { refusal: TypeBindingReferenceCategoryRefused {
              occurrence: reference.occurrence,
              observed: reference.category,
            } }
          }
      }
  }
}
