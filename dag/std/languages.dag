data go_collection_ops: CollectionOps = {
  count: "len(\{recv\})",
  first: "\{recv\}[0]",
  last: "\{recv\}[len(\{recv\})-1]",
  enumerate: "\{recv\}",
  join: "strings.Join(\{recv\}, \{arg\})",
  map: "func() []interface{} { var r []interface{}; for _, v := range \{recv\} { r = append(r, \{body\}) }; return r }()",
  filter: "func() []interface{} { var r []interface{}; for _, v := range \{recv\} { if \{body\} { r = append(r, v) } }; return r }()",
  flat_map: "func() []interface{} { var r []interface{}; for _, v := range \{recv\} { r = append(r, \{body\}...) }; return r }()",
  fold: "func() interface{} { acc := \{init\}; for _, v := range \{recv\} { acc = \{body\} }; return acc }()",
  any: "func() bool { for _, v := range \{recv\} { if \{body\} { return true } }; return false }()",
  all: "func() bool { for _, v := range \{recv\} { if !(\{body\}) { return false } }; return true }()",
  empty_list: "nil",
  list_literal: "[]\{type\}{ \{elements\} }"
}

data go_string_ops: StringOps = {
  split: "strings.Split(\{recv\}, \{arg\})",
  chars: "strings.Split(\{recv\}, \"\")",
  concat: "fmt.Sprintf(\"\{fmt\}\", \{args\})",
  string_literal: "\"\{value\}\"",
  string_interp: "fmt.Sprintf(\"\{fmt\}\", \{args\})",
  code_point: "int64([]rune(\{recv\})[0])",
  from_code_point: "string(rune(\{arg\}))"
}

data go_map_ops: MapOps = {
