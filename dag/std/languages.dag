  map_insert: "\{recv\}[\{key\}] = \{value\}",
  map_get: "\{recv\}[\{key\}]",
  map_contains: "func() bool { _, ok := \{recv\}[\{key\}]; return ok }()"
}

data go_null_coalesce: NullCoalesceStrategy = IIFEBased {
