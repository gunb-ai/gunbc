data python_collection_ops: CollectionOps = {
  count: "len(\{recv\})",
  first: "\{recv\}[0] if \{recv\} else None",
  last: "\{recv\}[-1] if \{recv\} else None",
  enumerate: "list(enumerate(\{recv\}))",
  join: "\{arg\}.join(\{recv\})",
  map: "[\{body\} for \{param\} in \{recv\}]",
  filter: "[x for x in \{recv\} if \{body\}]",
  flat_map: "[item for sublist in [\{body\} for \{param\} in \{recv\}] for item in sublist]",
  fold: "functools.reduce(\{body\}, \{recv\}, \{init\})",
  any: "any(\{body\} for \{param\} in \{recv\})",
  all: "all(\{body\} for \{param\} in \{recv\})",
  empty_list: "[]",
  list_literal: "[\{elements\}]"
}

