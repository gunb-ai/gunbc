module std.associativity_evidence

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_ref_eq }
import std.cache_identity { ExecutionReceiptDigest }
import std.disposition { Disposition, Scaffold, SingleAuthority }

data associativity_evidence_plan_doc_provenance: String = "bind: docs/plans/machine-shape-orthogonal-scheduling.md §6 — subject-bound associativity license carrier; combine must structurally match the scheduled combine (fail-closed on mismatch)"

type AssociativityEvidence
  = WitnessedAssociative {
      combine: DeclarationRef
      inhabitant: DeclarationRef
      law: DeclarationRef
      receipt: ExecutionReceiptDigest
    }
  | NotWitnessed

type AssociativityLicenseVerdict
  = AssociativityLicenseGranted
  | AssociativityLicenseMissing
  | AssociativityLicenseCombineMismatch
  | AssociativityLicenseSubjectMismatch

fn associativity_decl_ref(module_path: String, decl_name: String) -> DeclarationRef {
  DeclarationRef {
    module_path: module_path as NonEmptyStr
    decl_name: decl_name as NonEmptyStr
    field: WholeDeclaration
  }
}

data associativity_nat_add_associativity_law_ref: DeclarationRef = associativity_decl_ref(
  module_path: "v2.test.algebra_laws.nat_semiring",
  decl_name: "claim_nat_add_associativity"
)

data associativity_int_add_associativity_law_ref: DeclarationRef = associativity_decl_ref(
  module_path: "v2.test.algebra_laws.int_additive",
  decl_name: "claim_int_add_associativity"
)

data associativity_nat_inhabitant_ref: DeclarationRef = associativity_decl_ref(
  module_path: "std.nat",
  decl_name: "Nat"
)

data associativity_int_inhabitant_ref: DeclarationRef = associativity_decl_ref(
  module_path: "std.integer",
  decl_name: "Int"
)

fn associativity_law_expected_inhabitant(law: DeclarationRef) -> DeclarationRef? {
  if decl_ref_eq(left: law, right: associativity_nat_add_associativity_law_ref) {
    Present { value: associativity_nat_inhabitant_ref }
  } else if decl_ref_eq(left: law, right: associativity_int_add_associativity_law_ref) {
    Present { value: associativity_int_inhabitant_ref }
  } else {
    none
  }
}

fn associativity_subject_bound(inhabitant: DeclarationRef, law: DeclarationRef) -> Bool {
  match associativity_law_expected_inhabitant(law: law) {
    Absent => false
    Present { value: expected } => decl_ref_eq(left: inhabitant, right: expected)
  }
}

fn associativity_receipt_executed_for_law(
  receipt: ExecutionReceiptDigest,
  law: DeclarationRef
) -> Bool {
  false
}

fn associativity_evidence_not_witnessed() -> AssociativityEvidence {
  NotWitnessed
}

fn associativity_license_verdict(
  evidence: AssociativityEvidence,
  scheduled_combine: DeclarationRef
) -> AssociativityLicenseVerdict {
  match evidence {
    NotWitnessed => AssociativityLicenseMissing
    WitnessedAssociative { combine: combine, inhabitant: inhabitant, law: law, receipt: receipt } =>
      if !decl_ref_eq(left: combine, right: scheduled_combine) {
        AssociativityLicenseCombineMismatch
      } else if !associativity_subject_bound(inhabitant: inhabitant, law: law) {
        AssociativityLicenseSubjectMismatch
      } else if !associativity_receipt_executed_for_law(receipt: receipt, law: law) {
        AssociativityLicenseMissing
      } else {
        AssociativityLicenseGranted
      }
  }
}

data associativity_license_verdict_receipt_scaffold_note: String = "bind: docs/plans/witness-realization-plan.md — grant arm requires associativity_receipt_executed_for_law (executed law-claim receipt); until witness-realization stamps Evidence.MeasuredBy, WitnessedAssociative rows refuse as Missing even when subject-bound. Refusal arms (NotWitnessed, combine/subject mismatch) are honest today."

data associativity_license_verdict_receipt_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.associativity_evidence",
    decl_name: "associativity_license_verdict",
    field: WholeDeclaration
  }
}
