module std.euclidean_geometry


// SPATIAL-2, metric half. This is where integer millimetres stop being sufficient, so it is where
// the numeric policy has to become structural.
//
// The split that makes the slice honest: the SQUARED magnitude of an integer vector is always an
// exact integer, while the magnitude itself is a square root and generally irrational. So
// norm_squared is TOTAL and exact, and norm is PARTIAL - and its refusal carries the exact squared
// value, so a consumer holding an approximate realization can finish the computation without
// re-deriving anything. A refusal that discarded the squared magnitude would force the caller to
// recompute what this module already knew exactly.
//
// What is deliberately NOT here: a norm that floors, a normalize that divides, and any trigonometry.
// Rotating (1000, 0) by 30 degrees gives (866.025..., 500). A total integer answer would be an
// invented precision at the very bottom of the spatial stack, where every later claim inherits it.

// THE UNRESOLVED ARM NAMES THE KERNEL, NOT THE MATHEMATICS, and it took two corrections to get
// there. It was first LengthRequiresApproximateRealization, false for (3,4,0) whose magnitude is
// exactly 5. Renaming it to LengthExactRootNotRecognised fixed that population and broke the
// mirror one: for (1,1,0) there IS no exact integer root to fail to recognise, so the arm then
// overclaimed in the other direction. Both spellings asserted something about the ROOT. This one
// asserts only what is true across the whole arm: this exact kernel did not resolve the magnitude.
// Which of the two reasons applies is a fact about the vector, and a later kernel with an integer
// square root splits them.
type ExactLength
  = LengthExact { value: std.measure.Millimeter }
  | LengthRootUnresolvedInExactKernel {
      squared: std.measure.SquareMillimeter
      reason: std.types.NonEmptyStr
    }


// THE METRIC OPERATIONS REFUSE A FRAME THEY CANNOT LABEL. Components became unit-neutral when the
// frame took ownership of the quantum, and these three operations are the ones that put a unit
// BACK on their result: a dot product is an area, a norm is a length, and both are spelled in
// millimetres here. That spelling is only true when the frame's quantum is the millimetre. On a
// micrometre-registered board frame the same arithmetic would return millimeter(1000) for a
// thousand-micrometre vector - a number that is right and a label that is a lie, which travels
// further than an error because nothing about it looks wrong.
//
// The remedy is a refusal rather than a conversion, and rather than a silently rescaled answer.
// A frame that is not registered at all also refuses: an unregistered frame has no quantum, so
// there is no unit to check the label against, and assuming the default is how the convention
// this whole layer removed would come back.
//
// NEXT RUNG: derive the result's unit from the frame the way std.orthogonal_geometry now derives
// its extents. The length half is reachable today through FrameExtent; the area half needs a
// frame-relative area carrier, which nothing in the corpus consumes yet - so it is named here
// rather than invented ahead of a consumer.
fn frame_is_millimetre(registry: std.spatial_frame.SpatialFrameRegistry, identity: std.coordinate_frame.CoordinateFrameIdentity) -> Bool {
  match frame_length_scale(r: registry, identity: identity) {
    Absent => false
    Present { value: s } => scales_agree(a: s, b: Milli)
  }
}

fn metric_frame_refusal(op: std.affine_space.SpatialOperationIdentity, frame: std.coordinate_frame.CoordinateFrameIdentity) -> std.affine_space.SpatialFrameRefusal {
  std.affine_space.SpatialFrameRefusal { operation: op, left_frame: frame, right_frame: frame, relation: MillimetreFrameRequired }
}

// Dot product of two DISPLACEMENTS is an AREA with a meaningful sign - millimetre times millimetre
// is millimetre squared. Returning a bare Int erased that dimension at the first operation, and an
// erased dimension is how a plausible-looking wrong quantity travels. Sign is retained because a
// negative dot product means the displacements point away from each other.
fn dot3(registry: std.spatial_frame.SpatialFrameRegistry, a: std.affine_space.Vector3, b: std.affine_space.Vector3) -> std.affine_space.SpatialResult<std.measure.SignedSquareMillimeter> {
  if !coordinate_frame_identity_eq(a: a.frame, b: b.frame) {
    std.affine_space.SpatialFrameRefused { refusal: std.affine_space.SpatialFrameRefusal { operation: OpDot3, left_frame: a.frame, right_frame: b.frame, relation: SameFrameOperandsRequired } }
  } else {
  if !frame_is_millimetre(registry: registry, identity: a.frame) {
    std.affine_space.SpatialFrameRefused { refusal: metric_frame_refusal(op: OpDot3, frame: a.frame) }
  } else {
  let px = checked_int_multiply(a: signed_frame_component_count(c: a.x), b: signed_frame_component_count(c: b.x))
  let py = checked_int_multiply(a: signed_frame_component_count(c: a.y), b: signed_frame_component_count(c: b.y))
  let pz = checked_int_multiply(a: signed_frame_component_count(c: a.z), b: signed_frame_component_count(c: b.z))
  match checked_add_results(a: checked_add_results(a: px, b: py), b: pz) {
    CheckedIntOverflow { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
    CheckedIntReady { value: total } =>
      std.affine_space.SpatialReady { value: signed_square_millimeter(count: total) }
  }
  }
  }
}

// An AREA vector, NOT a displacement vector. Its components are millimetre squared, and an earlier
// revision returned Vector3 - whose components are millimetre displacements - so the numbers
// were areas wearing a length type. That made translate_point3(point, by: cross3(a, b)) writable:
// a cross-product area consumed as a physical translation. A separate carrier makes it unwritable
// rather than merely wrong, and it is deliberately NOT an alias of Vector3: sharing three numeric
// components is not sharing a dimension.
type AreaVector3 {
  frame: std.coordinate_frame.CoordinateFrameIdentity
  x: std.measure.SignedSquareMillimeter
  y: std.measure.SignedSquareMillimeter
  z: std.measure.SignedSquareMillimeter
}

// THREE LABELS RATHER THAN ONE, which is why leaving this unguarded was worse than the scalar
// case it was grouped with rather than merely equal to it: every component of the returned
// AreaVector3 is spelled in square millimetres, so an unguarded micrometre frame mislabels a
// whole vector at once and each component then travels independently.
fn cross3(registry: std.spatial_frame.SpatialFrameRegistry, a: std.affine_space.Vector3, b: std.affine_space.Vector3) -> std.affine_space.SpatialResult<AreaVector3> {
  if !coordinate_frame_identity_eq(a: a.frame, b: b.frame) {
    std.affine_space.SpatialFrameRefused { refusal: std.affine_space.SpatialFrameRefusal { operation: OpCross3, left_frame: a.frame, right_frame: b.frame, relation: SameFrameOperandsRequired } }
  } else {
  if !frame_is_millimetre(registry: registry, identity: a.frame) {
    std.affine_space.SpatialFrameRefused { refusal: metric_frame_refusal(op: OpCross3, frame: a.frame) }
  } else {
  let ax = signed_frame_component_count(c: a.x)
  let ay = signed_frame_component_count(c: a.y)
  let az = signed_frame_component_count(c: a.z)
  let bx = signed_frame_component_count(c: b.x)
  let by = signed_frame_component_count(c: b.y)
  let bz = signed_frame_component_count(c: b.z)
  let cx = checked_subtract_results(a: checked_int_multiply(a: ay, b: bz), b: checked_int_multiply(a: az, b: by))
  let cy = checked_subtract_results(a: checked_int_multiply(a: az, b: bx), b: checked_int_multiply(a: ax, b: bz))
  let cz = checked_subtract_results(a: checked_int_multiply(a: ax, b: by), b: checked_int_multiply(a: ay, b: bx))
  area_vector3_from_checked(frame: a.frame, x: cx, y: cy, z: cz)
  }
  }
}

// NOT GUARDED, AND THAT IS THE CORRECT SCOPE RATHER THAN AN OVERSIGHT. This labels components in
// square millimetres and takes no registry, so read alone it is the same defect as the unguarded
// cross3 - the difference is reachability. It has exactly one caller, cross3 above, which checks
// the frame before reaching here, and no module imports it. A census over this file flags it as
// the sole remaining labeller without a guard, so this note is what tells the next reader of that
// census that the answer is a call-graph fact rather than a miss. If it ever gains a second
// caller or leaves the module, it takes the guard with it.
//
// The same first-crossing-wins fold std.affine_space applies to displacement components, over the
// area carrier. It is not shared with that one: these components are millimetre SQUARED, and the
// whole reason AreaVector3 is a separate type from Vector3 is that three numbers of a different
// dimension are a different thing (this module's own cross3 comment, one dimension up).
fn area_vector3_from_checked(frame: std.coordinate_frame.CoordinateFrameIdentity, x: std.checked_arithmetic.CheckedInt, y: std.checked_arithmetic.CheckedInt, z: std.checked_arithmetic.CheckedInt) -> std.affine_space.SpatialResult<AreaVector3> {
  match x {
    CheckedIntOverflow { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
    CheckedIntReady { value: xv } =>
      match y {
        CheckedIntOverflow { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
        CheckedIntReady { value: yv } =>
          match z {
            CheckedIntOverflow { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
            CheckedIntReady { value: zv } =>
              std.affine_space.SpatialReady { value: AreaVector3 {
                frame: frame,
                x: signed_square_millimeter(count: xv),
                y: signed_square_millimeter(count: yv),
                z: signed_square_millimeter(count: zv),
              } }
          }
      }
  }
}

// EXACT IN THE MATHEMATICS, BOUNDED IN THE REALIZATION. The squared magnitude of an integer vector
// is an integer, with no root and no rounding - that part was always true, and it is why every
// consumer that only needs to COMPARE magnitudes should use this and never touch norm. What the
// earlier revision added to it was the word TOTAL, on a function whose three squares and two sums
// run on i64: the squared magnitude of a vector a few million millimetres long crosses the bound,
// and the answer was whatever the realization did about it.
//
// Nonnegativity is still by construction - a sum of squares - which is why the crossing into the
// Nat-backed area carrier is a magnitude read rather than a clamp.
fn norm_squared3(registry: std.spatial_frame.SpatialFrameRegistry, v: std.affine_space.Vector3) -> std.affine_space.SpatialResult<std.measure.SquareMillimeter> {
  if !frame_is_millimetre(registry: registry, identity: v.frame) {
    std.affine_space.SpatialFrameRefused { refusal: metric_frame_refusal(op: OpNormSquared3, frame: v.frame) }
  } else {
  let x = signed_frame_component_count(c: v.x)
  let y = signed_frame_component_count(c: v.y)
  let z = signed_frame_component_count(c: v.z)
  let sx = checked_int_multiply(a: x, b: x)
  let sy = checked_int_multiply(a: y, b: y)
  let sz = checked_int_multiply(a: z, b: z)
  match checked_add_results(a: checked_add_results(a: sx, b: sy), b: sz) {
    CheckedIntOverflow { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
    CheckedIntReady { value: total } =>
      match checked_int_magnitude(a: total) {
        CheckedNatOverflow { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
        CheckedNatReady { value: n } => std.affine_space.SpatialReady { value: square_millimeter(count: n) }
      }
  }
  }
}

// PARTIAL, deliberately. Exact when the displacement lies along a single axis, where the magnitude
// is that component's absolute value and no root is taken. Widening the exact set is a later
// increment; answering approximately is not.
// TWO INDEPENDENT REASONS THIS CANNOT ANSWER A LENGTH, kept apart because their remedies differ.
// The outer SpatialArithmeticResult is the finite machine: the squared magnitude the unresolved arm
// carries can itself cross the bound. The inner ExactLength is the kernel: even with unbounded
// integers, a diagonal has no magnitude this axis kernel resolves. Collapsing them would tell a
// caller holding a rational realization to go get a bigger integer, or the reverse.
fn norm3(registry: std.spatial_frame.SpatialFrameRegistry, v: std.affine_space.Vector3) -> std.affine_space.SpatialResult<ExactLength> {
  if !frame_is_millimetre(registry: registry, identity: v.frame) {
    std.affine_space.SpatialFrameRefused { refusal: metric_frame_refusal(op: OpNorm3, frame: v.frame) }
  } else {
  let x = signed_frame_component_count(c: v.x)
  let y = signed_frame_component_count(c: v.y)
  let z = signed_frame_component_count(c: v.z)
  let nonzero_axes = axis_count(value: x) + axis_count(value: y) + axis_count(value: z)
  if nonzero_axes <= 1 {
    match checked_int_magnitude(a: x + y + z) {
      CheckedNatOverflow { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
      CheckedNatReady { value: n } =>
        std.affine_space.SpatialReady { value: LengthExact { value: millimeter(count: n) } }
    }
  } else {
    match norm_squared3(registry: registry, v: v) {
      SpatialArithmeticRefused { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
      SpatialFrameRefused { refusal: fr } => std.affine_space.SpatialFrameRefused { refusal: fr }
      SpatialReady { value: sq } =>
        std.affine_space.SpatialReady { value: LengthRootUnresolvedInExactKernel {
          squared: sq,
          reason: "this exact kernel resolves a magnitude only for an axis-aligned displacement; the root may itself be exact ((3,4,0) has magnitude 5, which an integer square root would find) or irrational ((1,1,0) has none), and this arm distinguishes neither",
        } }
    }
  }
  }
}

fn axis_count(value: Int) -> std.nat.Nat {
  if value == 0 { 0 } else { 1 }
}

// Distance is the norm of the displacement, and inherits both partialities exactly. It is NOT a
// separate approximation: one operation, asked of the vector between two points - and the point
// subtraction is itself bounded, which is the third place this composite can refuse.
fn distance3(registry: std.spatial_frame.SpatialFrameRegistry, from: std.affine_space.Point3, to: std.affine_space.Point3) -> std.affine_space.SpatialResult<ExactLength> {
  match displacement_between3(from: from, to: to) {
    SpatialArithmeticRefused { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
    SpatialFrameRefused { refusal: fr } => std.affine_space.SpatialFrameRefused { refusal: fr }
    SpatialReady { value: d } => norm3(registry: registry, v: d)
  }
}

// Squared distance takes no root, and is what a comparison should use.
fn distance_squared3(registry: std.spatial_frame.SpatialFrameRegistry, from: std.affine_space.Point3, to: std.affine_space.Point3) -> std.affine_space.SpatialResult<std.measure.SquareMillimeter> {
  match displacement_between3(from: from, to: to) {
    SpatialArithmeticRefused { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
    SpatialFrameRefused { refusal: fr } => std.affine_space.SpatialFrameRefused { refusal: fr }
    SpatialReady { value: d } => norm_squared3(registry: registry, v: d)
  }
}

// Comparing magnitudes needs no square root: the ordering of squares agrees with the ordering of
// nonnegative magnitudes. This is the operation most callers of "distance" actually want, and it
// stays exact wherever both squared distances are representable - a comparison whose operands
// cannot be computed has no answer, and returning false would be a verdict rather than a refusal.
fn closer_than3(registry: std.spatial_frame.SpatialFrameRegistry, a_from: std.affine_space.Point3, a_to: std.affine_space.Point3, b_from: std.affine_space.Point3, b_to: std.affine_space.Point3) -> std.affine_space.SpatialResult<Bool> {
  match distance_squared3(registry: registry, from: a_from, to: a_to) {
    SpatialArithmeticRefused { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
    SpatialFrameRefused { refusal: fr } => std.affine_space.SpatialFrameRefused { refusal: fr }
    SpatialReady { value: a2 } =>
      match distance_squared3(registry: registry, from: b_from, to: b_to) {
        SpatialArithmeticRefused { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
        SpatialFrameRefused { refusal: fr } => std.affine_space.SpatialFrameRefused { refusal: fr }
        SpatialReady { value: b2 } =>
          std.affine_space.SpatialReady {
            value: square_millimeter_count(m: a2) < square_millimeter_count(m: b2)
          }
      }
  }
}

// A DIRECTION IS DIMENSIONLESS. An earlier revision returned Vector3 with components of -1, 0
// or 1 MILLIMETRES, which is not a direction at all - it is a one-millimetre displacement, and it
// made translate_point3(point, by: normalized.direction) writable, moving the point by 1 mm. For
// the exact integer-only slice the honest carrier is the axis enum: it names the six directions
// integer arithmetic can represent exactly and carries no magnitude to be mistaken for one. A
// general normalized direction needs division and arrives with the approximate realization.
// THE UNSIGNED AXIS, HOMED WITH ITS SIGNED COMPANION. AxisDirection3 IS Axis3 crossed with a sign,
// so the two are one authority and splitting them across modules put the decomposition helpers in a
// module that could not import the type they decompose.
type Axis3
  = Axis3X
  | Axis3Y
  | Axis3Z

fn axis3_index(a: Axis3) -> Int {
  match a {
    Axis3X => 0
    Axis3Y => 1
    Axis3Z => 2
  }
}

fn axis3_eq(a: Axis3, b: Axis3) -> Bool {
  axis3_index(a: a) == axis3_index(a: b)
}
type AxisDirection3
  = PositiveX
  | NegativeX
  | PositiveY
  | NegativeY
  | PositiveZ
  | NegativeZ

// PREDICATE AND PROJECTION OVER AxisDirection3, HOMED WITH THE TYPE. These lived in
// std.orthogonal_geometry, which forked the single authority for this carrier (DESIGN section 3):
// a consumer asking which axis a direction lies on had two places to look, and a second projection
// could have been minted in a third module without contradicting either. The type owns its own
// axis/sign decomposition and its own reconstruction from that pair.
fn axis_direction_axis(d: AxisDirection3) -> Axis3 {
  match d {
    PositiveX => Axis3X
    NegativeX => Axis3X
    PositiveY => Axis3Y
    NegativeY => Axis3Y
    PositiveZ => Axis3Z
    NegativeZ => Axis3Z
  }
}

fn axis_direction_is_negative(d: AxisDirection3) -> Bool {
  match d {
    PositiveX => false
    NegativeX => true
    PositiveY => false
    NegativeY => true
    PositiveZ => false
    NegativeZ => true
  }
}

fn axis_direction_of(axis: Axis3, negative: Bool) -> AxisDirection3 {
  match axis {
    Axis3X => if negative { NegativeX } else { PositiveX }
    Axis3Y => if negative { NegativeY } else { PositiveY }
    Axis3Z => if negative { NegativeZ } else { PositiveZ }
  }
}

type Direction3Result
  = DirectionExact { frame: std.coordinate_frame.CoordinateFrameIdentity, direction: AxisDirection3 }
  | DirectionZeroVectorHasNone
  | DirectionUnresolvedInAxisKernel {
      squared_magnitude: std.measure.SquareMillimeter
      reason: std.types.NonEmptyStr
    }

// Normalization refuses the zero vector because zero has magnitude but no direction - that is a
// genuine mathematical absence, not a kernel limitation, and it is a DIFFERENT arm from the
// unresolved one. Collapsing the two would conflate "this has no direction" with "this kernel did
// not resolve the direction", which have different remedies.
//
// A unit direction is representable in this axis kernel only when the displacement is axis-aligned.
// The unresolved arm does NOT say approximation is the remedy: (3,4,0) has the exact rational
// direction (3/5, 4/5, 0), so a rational realization resolves it with no error bound at all.
//
// THE AXIS CASE ANALYSIS IS INLINE ON PURPOSE, and that is the whole reason the helper is gone. It
// was a callable axis_direction_of(x, y, z) whose precondition - exactly one component nonzero -
// lived only in a comment above it, so axis_direction_of(0, 0, 0) answered PositiveZ and
// axis_direction_of(1, 1, 0) answered PositiveX. Both are fabricated answers reachable by any
// caller, safe today only because the single call site happened to be guarded. Inlined, the guard
// is the enclosing branch and the case analysis cannot be reached without it.
fn normalize3(registry: std.spatial_frame.SpatialFrameRegistry, v: std.affine_space.Vector3) -> std.affine_space.SpatialResult<Direction3Result> {
  let x = signed_frame_component_count(c: v.x)
  let y = signed_frame_component_count(c: v.y)
  let z = signed_frame_component_count(c: v.z)
  let nonzero_axes = axis_count(value: x) + axis_count(value: y) + axis_count(value: z)
  if nonzero_axes == 0 {
    std.affine_space.SpatialReady { value: DirectionZeroVectorHasNone }
  } else {
    if nonzero_axes == 1 {
      std.affine_space.SpatialReady { value: DirectionExact {
        frame: v.frame,
        direction: if x != 0 {
          if x < 0 { NegativeX } else { PositiveX }
        } else {
          if y != 0 {
            if y < 0 { NegativeY } else { PositiveY }
          } else {
            if z < 0 { NegativeZ } else { PositiveZ }
          }
        },
      } }
    } else {
      match norm_squared3(registry: registry, v: v) {
        SpatialArithmeticRefused { cause: c } => std.affine_space.SpatialArithmeticRefused { cause: c }
        SpatialFrameRefused { refusal: fr } => std.affine_space.SpatialFrameRefused { refusal: fr }
        SpatialReady { value: sq } =>
          std.affine_space.SpatialReady { value: DirectionUnresolvedInAxisKernel {
            squared_magnitude: sq,
            reason: "this axis kernel resolves a unit direction only for an axis-aligned displacement; the direction may still be exactly representable ((3,4,0) is exactly (3/5,4/5,0)) and a richer realization - rational, algebraic, or error-bounded approximate - resolves it",
          } }
      }
    }
  }
}
