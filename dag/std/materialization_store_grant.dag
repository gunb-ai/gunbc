module std.materialization_store_grant

import std.types { String, Bool, List }
import std.access { AccessDecision }
import std.effect_grant {
  Verb, Read, Write,
  NamespacePosition,
  RealTransport,
  LifecycleByConvention,
  Grant, Envelope,
  admit_effect,
}
import std.filesystem_path_grant { absolute_path_position }
import std.materialization_ladder { Frame, SharedStateFrame }
import std.artifact_store_scratch_grant { artifact_store_scratch_root, is_gunbc_tmp_scratch_store_root }

// THE STORE ROOT IS A COPRODUCT SO DURABILITY IS CONSTRUCTED, NOT INFERRED FROM A PATH.
//
// DurableHostVolume is fieldless: the live host volume is one declared path
// (`materialization_store_host_volume_path`). DurableAcrossRuns, no unconstrained path operand.
//
// Two fieldless workspace arms share the leaf `materialization-store` under the instance root
// and differ only in LIFETIME:
//   PersistentInstanceWorkspace — DurableAcrossRuns. Only constructors whose instance_root is
//     a declared literal (macbook_local, srv2_deploy) pick this arm.
//   FrameJobWorkspace — EphemeralToFrame. Constructors that take the root as a parameter
//     (isolated_dashboard_instance, fleet_compute_hermetic_dashboard_instance_at) pick this arm.
// Same leaf is not a nickname: durability is the modeled consequence.
//
// WitnessScratchRoot is the only arm that takes a path; it admits only /tmp/gunbc_* scratch.
//
// scope_root is a path-resolution operand at realization, not a store identity. It is
// HostDashboardInstance.instance_root. DurableHostVolume ignores it.
//
// DECLARED FRONTIER: this module grants the guest-side PATH. Attaching a gunbc-owned host volume
// as a Firecracker drive is the runner lane's act. Until that attachment lands, a DurableHostVolume
// open on a runner guest finds no initialized store and REFUSES as unavailable
// (extdeps.realization.materialization_store_local), never falls back to scratch. srv1's instance
// declares DurableHostVolume; discharged there by gunbc.live_deploy.spec
// deployment_ensured_srv1_host_directories.

type MaterializationStoreRoot
  = DurableHostVolume
  | PersistentInstanceWorkspace
  | FrameJobWorkspace
  | WitnessScratchRoot { root: String }

type MaterializationStoreDurability
  = DurableAcrossRuns
  | EphemeralToFrame

data materialization_store_frame: Frame = Frame {
  name: "materialization-store",
  kind: SharedStateFrame
}

data materialization_store_host_volume_path: String = "/var/lib/gunbc/materialization-store"

data materialization_store_workspace_leaf: String = "materialization-store"

fn materialization_store_root_path(root: MaterializationStoreRoot, scope_root: String) -> String {
  match root {
    DurableHostVolume => materialization_store_host_volume_path
    PersistentInstanceWorkspace => join([scope_root, "/", materialization_store_workspace_leaf], "")
    FrameJobWorkspace => join([scope_root, "/", materialization_store_workspace_leaf], "")
    WitnessScratchRoot { root: r } => r
  }
}

fn materialization_store_staging_root_path(root: MaterializationStoreRoot, scope_root: String) -> String {
  join([materialization_store_root_path(root: root, scope_root: scope_root), "-staging"], "")
}

fn materialization_store_durability(root: MaterializationStoreRoot) -> MaterializationStoreDurability {
  match root {
    DurableHostVolume => DurableAcrossRuns
    PersistentInstanceWorkspace => DurableAcrossRuns
    FrameJobWorkspace => EphemeralToFrame
    WitnessScratchRoot { root: _ } => EphemeralToFrame
  }
}

fn materialization_store_durability_name(d: MaterializationStoreDurability) -> String {
  match d {
    DurableAcrossRuns => "durable_across_runs"
    EphemeralToFrame => "ephemeral_to_frame"
  }
}

fn materialization_store_host_volume_envelope(path: String) -> Envelope {
  Envelope {
    frame: materialization_store_frame,
    grants: materialization_store_grants(root_position: absolute_path_position(path: path))
  }
}

fn materialization_store_grants(root_position: NamespacePosition) -> List<Grant> {
  [
    Grant { verb: Read, root: root_position, binding: RealTransport, lifecycle: LifecycleByConvention },
    Grant { verb: Write, root: root_position, binding: RealTransport, lifecycle: LifecycleByConvention },
  ]
}

fn materialization_store_envelope(root: MaterializationStoreRoot, scope_root: String) -> Envelope {
  match root {
    DurableHostVolume => materialization_store_host_volume_envelope(path: materialization_store_host_volume_path)
    PersistentInstanceWorkspace => materialization_store_host_volume_envelope(
      path: materialization_store_root_path(root: root, scope_root: scope_root)
    )
    FrameJobWorkspace => materialization_store_host_volume_envelope(
      path: materialization_store_root_path(root: root, scope_root: scope_root)
    )
    WitnessScratchRoot { root: r } =>
      if is_gunbc_tmp_scratch_store_root(store_root: r) {
        Envelope {
          frame: materialization_store_frame,
          grants: materialization_store_grants(root_position: artifact_store_scratch_root)
        }
      } else {
        Envelope { frame: materialization_store_frame, grants: [] }
      }
  }
}

fn materialization_store_admissible(root: MaterializationStoreRoot, scope_root: String, verb: Verb) -> AccessDecision {
  admit_effect(
    env: materialization_store_envelope(root: root, scope_root: scope_root),
    verb: verb,
    target: absolute_path_position(path: materialization_store_root_path(root: root, scope_root: scope_root))
  )
}
