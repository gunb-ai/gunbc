module std.materialization_store_grant

import std.types { String, Bool, List }
import std.measure { ByteSize }
import std.access { AccessDecision }
import std.effect_grant {
  Verb, Read, Write,
  NamespacePosition,
  RealTransport,
  LifecycleByConvention,
  Grant, Envelope,
  admit_effect,
}
import std.filesystem_path_grant { absolute_path_position }
import std.materialization_ladder { Frame, SharedStateFrame }
import std.artifact_store_scratch_grant { artifact_store_scratch_root, is_gunbc_tmp_scratch_store_root }
import extdeps.freedesktop.xdg_base_directory { XdgCacheHome, xdg_cache_path }

// THE DURABLE ROOT GRANT FOR THE MATERIALIZATION STORE, AND WHY IT IS A COPRODUCT RATHER THAN A PATH.
//
// std.artifact_store_scratch_grant admits /tmp/gunbc_* roots, which are frame-owned scratch: on a
// Firecracker runner the guest /tmp dies with the attempt, so a store rooted there is a per-attempt
// cache and can never discharge a reuse obligation whose lifetime spans runs (DESIGN section 2:
// retention must span the obligated lifetime). The native CI job needs a store that outlives the
// attempt, so its root is a gunbc-owned PERSISTENT HOST VOLUME reached through the declared guest
// boundary, not guest /tmp.
//
// NO CALLER SUPPLIES A DURABLE PATH. A durable root is exactly one of two things: the declared host
// volume (`DurableHostVolumeRoot`, which carries no field -- its path is the one datum below), or the
// per-user cache home resolved by the cited XDG authority (`UserCacheRoot`, whose only field is an
// XdgCacheHome; XdgCacheHome is sole_constructor, minted only by
// extdeps.freedesktop.xdg_base_directory xdg_cache_home from the environment readings it is
// handed). So a consumer that asks for durability cannot be handed an arbitrary directory under that
// name: it gets the host volume, or the directory the spec's rules selected. The per-user store root
// is <cache home>/gunbc/materialization-store (materialization_store_user_cache_relative_path,
// joined by the spec module's own xdg_cache_path). `WitnessScratchRoot` is the only arm that takes a
// path; it admits only the existing /tmp/gunbc_* scratch grant, its durability is DERIVED as
// ephemeral -- so an executed control can exercise the real store realization in a throwaway
// directory without that directory ever being able to answer "durable" -- and it carries the byte
// `ceiling` its fixture evicts under, which gunbc.materialization_store_capacity (the one home of
// the ceiling) returns for it, so tests need no second ceiling authority.
//
// A STATED DIVERGENCE (DESIGN section 3b) FROM THIS MODULE'S EARLIER INVARIANT, which read
// "`DurableHostVolumeRoot` carries no field ... `WitnessScratchRoot` is the only arm that takes a
// path". UserCacheRoot's location comes from the ENVIRONMENT: XDG_CACHE_HOME=/tmp/x yields a root
// that answers DurableAcrossRuns while it lives under /tmp. That is deliberate. DurableAcrossRuns on
// this arm means what XDG means by the cache home -- "user-specific non-essential data" kept across
// runs until the user removes it -- so the claim is scoped to that user's environment: the store
// outlives the run and is not released by frame teardown, and the user (or a tmpfs) may remove it at
// any time. Removal costs entries, never correctness: an open reads the store's identity marker
// first (extdeps.realization.materialization_store_local), so a removed or replaced directory is
// never served from as though it were this store. DurableHostVolumeRoot is unchanged and stays the
// fleet runner's root.
//
// DECLARED FRONTIER FOR UserCacheRoot (DESIGN section 3c): no production path constructs one yet.
// Its consumers today are this module's projections (path, durability, envelope, admission), executed
// by test.claim.materialization_store_grant_witness, and gunbc.materialization_store_capacity,
// executed by test.claim.materialization_store_capacity_witness. The production constructor is M1.c's store
// root (landing unit L8: the route root mints the XdgCacheHome from the process environment and
// opens the per-user store), and the commit that sizes it arrives in landing unit L5b. TRIGGER: L8's
// route root opens a UserCacheRoot.
//
// DECLARED FRONTIER, stated so the grant is not read as the whole boundary: this module grants the
// guest-side PATH. Attaching the gunbc-owned host volume as a Firecracker drive and mounting it at
// that path inside the guest is the runner lane's act (gunbc.runner runner_attempt_launch attaches
// drives today; it attaches no materialization-store volume yet). Until that attachment lands, a
// durable-root open on a runner guest finds no initialized store and REFUSES as unavailable
// (extdeps.realization.materialization_store_local), never falls back to scratch -- there is no
// shadow store. TRIGGER: the runner attempt launch attaches the persistent host volume at
// materialization_store_durable_root_path.
//
// LIFECYCLE GRADE: LifecycleByConvention, honestly. A durable store is not released by frame
// teardown -- that is its purpose -- so it cannot claim LifecycleByConstruction; its release is the
// retention and eviction the provider machinery owns (std.artifact_store accounting under the
// provider), which is a cleanup that can fail or be forgotten, i.e. the weaker grade.

type MaterializationStoreRoot
  = DurableHostVolumeRoot
  | UserCacheRoot { cache_home: XdgCacheHome }
  | WitnessScratchRoot { root: String, ceiling: ByteSize }

type MaterializationStoreDurability
  = DurableAcrossRuns
  | EphemeralToFrame

data materialization_store_frame: Frame = Frame {
  name: "materialization-store",
  kind: SharedStateFrame
}

data materialization_store_durable_root_path: String = "/var/lib/gunbc/materialization-store"

data materialization_store_user_cache_relative_path: String = "gunbc/materialization-store"

// DERIVED from the path, never restated as segments (review 63898): the grant root and the
// admission target are the same projection of one datum, so they cannot drift apart.
data materialization_store_durable_root: NamespacePosition = absolute_path_position(
  path: materialization_store_durable_root_path
)

fn materialization_store_root_path(root: MaterializationStoreRoot) -> String {
  match root {
    DurableHostVolumeRoot => materialization_store_durable_root_path
    UserCacheRoot { cache_home: h } =>
      xdg_cache_path(cache_home: h, relative: materialization_store_user_cache_relative_path)
    WitnessScratchRoot { root: r, ceiling: _ } => r
  }
}

fn materialization_store_durability(root: MaterializationStoreRoot) -> MaterializationStoreDurability {
  match root {
    DurableHostVolumeRoot => DurableAcrossRuns
    UserCacheRoot { cache_home: _ } => DurableAcrossRuns
    WitnessScratchRoot { root: _, ceiling: _ } => EphemeralToFrame
  }
}

fn materialization_store_durability_name(d: MaterializationStoreDurability) -> String {
  match d {
    DurableAcrossRuns => "durable_across_runs"
    EphemeralToFrame => "ephemeral_to_frame"
  }
}

fn materialization_store_grants(root_position: NamespacePosition) -> List<Grant> {
  [
    Grant { verb: Read, root: root_position, binding: RealTransport, lifecycle: LifecycleByConvention },
    Grant { verb: Write, root: root_position, binding: RealTransport, lifecycle: LifecycleByConvention },
  ]
}

fn materialization_store_envelope(root: MaterializationStoreRoot) -> Envelope {
  match root {
    DurableHostVolumeRoot =>
      Envelope {
        frame: materialization_store_frame,
        grants: materialization_store_grants(root_position: materialization_store_durable_root)
      }
    UserCacheRoot { cache_home: _ } =>
      Envelope {
        frame: materialization_store_frame,
        grants: materialization_store_grants(
          root_position: absolute_path_position(path: materialization_store_root_path(root: root))
        )
      }
    WitnessScratchRoot { root: r, ceiling: _ } =>
      if is_gunbc_tmp_scratch_store_root(store_root: r) {
        Envelope {
          frame: materialization_store_frame,
          grants: materialization_store_grants(root_position: artifact_store_scratch_root)
        }
      } else {
        Envelope { frame: materialization_store_frame, grants: [] }
      }
  }
}

fn materialization_store_admissible(root: MaterializationStoreRoot, verb: Verb) -> AccessDecision {
  admit_effect(
    env: materialization_store_envelope(root: root),
    verb: verb,
    target: absolute_path_position(path: materialization_store_root_path(root: root))
  )
}
