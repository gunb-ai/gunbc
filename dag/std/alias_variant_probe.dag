module std.alias_variant_probe

import std.types { Int, List }
import std.algebra { Cons, Empty, AlgebraTypeTemplate }

// SPECIMEN (recurring_failure_mode match_variant_lookup_does_not_peel_type_alias, gunbc#10699),
// minimal RED: a Cons arm on a binder declared List<AlgebraTypeTemplate>, where
// List<element> = FreeMonoid<element>. Under the container-alias lookup gap the expander
// looks up the authored name (List) rather than the declared coproduct (FreeMonoid), so
// Cons is not found and inference refuses "variant Cons not found in type List" here.
// This is the discriminating RED: refused before the fix, compiles after.
fn is_collection_filter_param_types(param_types: List<AlgebraTypeTemplate>) -> Int {
  match param_types {
    Cons { head: _, tail: _ } => 1
    Empty => 0
  }
}
