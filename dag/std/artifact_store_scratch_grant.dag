module std.artifact_store_scratch_grant


data artifact_store_scratch_grant_note: String = "P-B scratch-grant authority (docs/plans/effect-namespace-grants.md 6): the artifact-store host transport's /tmp/gunbc_* store roots are declared frame-owned scratch grants (LifecycleByConvention). extdeps.realization.artifact_store_fs dispatches Write/Read only on Admitted verdicts from artifact_store_scratch_target_admissible — the SINGLE admission entry. INTERIM HONESTY (segment-prefix limit): grant roots use filesystem_position on segment tmp because NamespacePosition prefix is segment-exact — it cannot express in-segment /tmp/gunbc_* naming; is_gunbc_tmp_scratch_store_root is the precision gate in this same module until SymbolIndex-backed positions dissolve the path-string interim (std.filesystem_path_grant note). dissolve-on = P-C region model + envelope-derived LiveTreeDisposition retires hand-stamped ReadsLiveTree on witness rows."

data artifact_store_scratch_frame: std.materialization_ladder.Frame = std.materialization_ladder.Frame {
  name: "artifact-store-scratch",
  kind: std.materialization_ladder.SharedStateFrame
}

data artifact_store_scratch_root: std.effect_grant.NamespacePosition = std.effect_grant.filesystem_position(path: ["tmp"])

fn is_gunbc_tmp_scratch_store_root(store_root: String) -> Bool {
  starts_with(s: store_root, prefix: "/tmp/gunbc_")
}

fn artifact_store_scratch_envelope() -> std.effect_grant.Envelope {
  std.effect_grant.Envelope {
    frame: artifact_store_scratch_frame,
    grants: [
      std.effect_grant.Grant {
        verb: std.effect_grant.Read,
        root: artifact_store_scratch_root,
        binding: std.effect_grant.RealTransport,
        lifecycle: std.effect_grant.LifecycleByConvention
      },
      std.effect_grant.Grant {
        verb: std.effect_grant.Write,
        root: artifact_store_scratch_root,
        binding: std.effect_grant.RealTransport,
        lifecycle: std.effect_grant.LifecycleByConvention
      },
    ]
  }
}

fn artifact_store_scratch_target_admissible(
  store_root: String,
  verb: std.effect_grant.Verb
) -> std.access.AccessDecision {
  let env = if is_gunbc_tmp_scratch_store_root(store_root: store_root) {
    artifact_store_scratch_envelope()
  } else {
    std.effect_grant.Envelope { frame: artifact_store_scratch_frame, grants: [] }
  }
  std.effect_grant.admit_effect(
    env: env,
    verb: verb,
    target: std.filesystem_path_grant.absolute_path_position(path: store_root)
  )
}

fn artifact_store_scratch_write_admissible(store_root: String) -> std.access.AccessDecision {
  artifact_store_scratch_target_admissible(store_root: store_root, verb: std.effect_grant.Write)
}

fn artifact_store_scratch_read_admissible(store_root: String) -> std.access.AccessDecision {
  artifact_store_scratch_target_admissible(store_root: store_root, verb: std.effect_grant.Read)
}
