module std.language_target_identity

import std.decl_ref { DeclarationRef }
import std.roster_frontier { declaration_ref_eq }
import std.types { Bool, Int, List, String }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef, external_subject_ref_eq }

data language_target_identity_law: String = "ONE JOIN KEY ACROSS EVERY TARGET-BEARING SURFACE (operator verdict, 2026-08-04). A language or medium target is identified by its UPSTREAM SUBJECT — extdeps.external_authority's ExternalSubjectRef, whose declaration is symbolic per external_subject_symbolic_identity_note — never by a name string, a target-model value, an emit function, or a module path. The surfaces this repository writes are joined TO that subject; they are not candidate identities for it. Modelled on std.primitive_identity, which already performs exactly this join for five independently-writable primitive surfaces with typed join violations; the two modules are siblings in shape and deliberately share no rows, because a primitive and a target are different subjects. WHY NOT THE FIVE OBVIOUS CANDIDATES, each rejected for a stated reason: std.languages Language.id is a LanguageId string inside a syntax-template catalogue whose live population is rust/go/python/typescript only — Bash is absent — so it is at most a presentation key; v2.std.compilers.target_model TargetModel carries bundle, lexing, spellings, authority text and runtime configuration but NO identity field, which is correct because one target may have several target-model revisions without changing identity; tools.emit_host_gate's per-language smoke fns are evidence producers, not subjects; std.primitive_identity RealizationTarget is deliberately a three-arm primitive-realization DISPATCH surface (InterpreterHost | EmitRust | EmitTypeScript), not a general language identity, and widening it would fuse two unrelated join keys; gunbc.plans.language_target_self_host_frontier is a markdown prose table that says in its own text that its typed carrier does not yet exist."

data language_target_uncited_refusal_note: String = "AN UNGROUNDED TARGET IS UNWRITABLE, not admitted-then-flagged (DESIGN section 5 construction over validation; direction from loyal-ant-382 and the grounding correction from the operator, 2026-08-04). A registration carries TargetGrounding as a required field and derives its subject from it, so a target with no authority behind it cannot be constructed and there is no Absent arm to fall into. For an external target the grounding IS the ExternalModelScope, whose citations are nonempty by construction (external_model_scope_citations_shape_note), so an uncited external target is unwritable for the same structural reason. Nothing is copied: the scope is held, never restated (DESIGN section 3). CORRECTED 2026-08-04 — an earlier revision of this row described a two-field subject-plus-scope shape that has been retired precisely because it let the two disagree; see target_grounding_law. The residual honesty boundary is unchanged and named: that a referenced declaration RESOLVES on disk is the existing roster machinery's job (gunbc.extdeps_scope_frontier), not a second check minted here."

data language_target_scope_boundary_note: String = "WHAT THIS MODULE IS NOT (operator ruling relayed 2026-08-04). It carries target IDENTITY and the surface join only. It carries NO profile, NO capability set, NO residue row, and NO completion predicate, because those are governed by rules this module deliberately does not encode: profile relevance is an OBLIGATION JOIN rather than an authored label (a candidate is relevant when its target matches the profile's target, its violated obligation is in the profile's required obligations, and it lies inside that obligation's declared applicability scope), residue is separated from capability gaps so one incompleteness never gets two representations, and a profile-relevant-residue verdict is three-state with only its Empty arm — carrying a completeness receipt — admissible as completion evidence. Fusing any of that into the identity kernel would make one carrier serve as both the completion WALL and the migration RATCHET, which the same ruling forbids at different grains. Those rows land on the census and profile carriers when the relevance rule is registered."

type LanguageTargetSurfaceAuthority
  = StdLanguageCatalogue
  | TargetModelDeclaration
  | EmitHostExecution
  | TargetVocabulary
  | RuntimeChecker
  | LegacyFrontier

data surface_locus_grain_note: String = "A target-bearing surface is sometimes a DECLARATION and sometimes a whole MODULE, and collapsing the two loses the case this registry most needs to see. v2.lens.realization_vocabulary_containment confines target vocabulary at MODULE grain — target_ast_vocab_modules and target_ast_vocab_module_prefixes are module-path lists — so a vocabulary surface has no declaration to name, and forcing one would mean inventing a decl_name that denotes nothing (a nickname for a module, DESIGN section 3). std.languages rows and emit-host smoke fns are genuinely declarations. Both grains are therefore first-class, and a locus carries which it is rather than one being encoded as a degenerate case of the other."

type LanguageTargetSurfaceLocus
  = SurfaceDeclaration { ref: DeclarationRef }
  | SurfaceModule { module_path: String }

fn surface_locus_eq(a: LanguageTargetSurfaceLocus, b: LanguageTargetSurfaceLocus) -> Bool {
  match a {
    SurfaceDeclaration { ref: ra } =>
      match b {
        SurfaceDeclaration { ref: rb } => declaration_ref_eq(a: ra, b: rb)
        SurfaceModule { module_path: _ } => false
      }
    SurfaceModule { module_path: ma } =>
      match b {
        SurfaceModule { module_path: mb } => ma == mb
        SurfaceDeclaration { ref: _ } => false
      }
  }
}

data target_grounding_law: String = "IDENTITY IS DERIVED FROM GROUNDING, NEVER AUTHORED BESIDE IT (operator ruling, 2026-08-04). An earlier shape carried subject and scope as two fields, which still permitted them to DISAGREE — a registration could name one subject while grounding it in another's authority. Here the subject is a projection of the grounding carrier, so the disagreeing state has no representation and RegisteredTargetHasNoAuthoritySubject dissolves into construction rather than surviving as a validation class. WHY GROUNDING IS TWO ARMS: ExternalSubjectRef is documented as a symbolic reference to an INDEPENDENTLY GOVERNED upstream subject, which is true of Bash, TypeScript, C++, Verilog and SPICE but false of this project's own targets — the .dag language itself and the controlled-English medium are real target surfaces that are not external products, and forcing them through an external scope would make them pretend to an upstream governance they do not have. So canonical identity is the subject DeclarationRef; external targets derive it from ExternalModelScope.subject.declaration and project targets from their own declared authority. A dangling reference is not a construction failure but a resolution one, and surfaces as TargetSubjectUnresolvable."

type TargetGrounding
  = ExternalGrounding { scope: ExternalModelScope }
  | ProjectGrounding { authority: DeclarationRef }

type LanguageTargetRegistration {
  grounding: TargetGrounding
  disposition: TargetDisposition
}

fn registration_subject(registration: LanguageTargetRegistration) -> DeclarationRef {
  match registration.grounding {
    ExternalGrounding { scope: s } => s.subject.declaration
    ProjectGrounding { authority: a } => a
  }
}

data target_disposition_note: String = "A registered target with no live surface is legitimate ONLY with an explicit disposition, so a strategy promise cannot vanish merely because implementation has not begun, and Parked never renders as a vacuous zero-of-zero complete. GovernedByContract is the Rust arrangement: this registry REFERENCES the self-host and production-cutover verdicts and never recomputes them, so no second status authority for one subject exists."

type TargetDisposition
  = TargetActive
  | TargetParked { reason: String }
  | TargetDecisionPending { decision_id: String }
  | TargetMaintenanceOnly
  | TargetGovernedByContract { contract_id: String }

type LanguageTargetSurfaceRow {
  authority: LanguageTargetSurfaceAuthority
  surface: LanguageTargetSurfaceLocus
  target: ExternalSubjectRef?
}

type LanguageTargetJoinViolation
  = SurfaceMissingTargetIdentity {
      authority: LanguageTargetSurfaceAuthority
      surface: LanguageTargetSurfaceLocus
    }
  | SurfaceNamesUnknownTarget {
      authority: LanguageTargetSurfaceAuthority
      surface: LanguageTargetSurfaceLocus
      named: ExternalSubjectRef
    }
  | SurfaceJoinsMultipleTargets {
      authority: LanguageTargetSurfaceAuthority
      surface: LanguageTargetSurfaceLocus
      first: ExternalSubjectRef
      second: ExternalSubjectRef
    }
  | TargetVocabularyHasNoRegistryTarget { surface: LanguageTargetSurfaceLocus }
  | DuplicateRegistryTarget { target: ExternalSubjectRef }

data language_target_resolution_note: String = "THE RESIDUE CENSUS DERIVES ITS TARGET THROUGH THIS JOIN; it never carries an independently authored target field (operator verdict, 2026-08-04). An authored target beside an observed sink is a second writable representation of one fact, and the two can disagree — a row reading sink = extdeps.languages.typescript.program alongside target = Bash is well-formed under an authored field and unwritable under a derived one. The observed sink, imported vocabulary, target-model declaration, source artifact, or runtime binding is the input; this is the function. Every non-resolving outcome is a TYPED, LOCATED result rather than an inability to report the site: a Bash sink whose subject is unregistered still reports as a Bash sink observation carrying TargetSurfaceUnregistered, which is what keeps a missing registry entry a registry refusal instead of a census blind spot (DESIGN section 5 — a failure arm must refuse, never widen, and never narrow to nothing)."

type LanguageTargetResolution
  = TargetResolved { target: ExternalSubjectRef }
  | TargetSurfaceUnregistered { surface: LanguageTargetSurfaceLocus }
  | TargetSurfaceAmbiguous {
      surface: LanguageTargetSurfaceLocus
      candidates: List<ExternalSubjectRef>
    }
  | TargetSubjectUnresolvable { subject: ExternalSubjectRef }

data named_target_tally_note: String = "The 0 / 1 / more-than-1 distinction is carried as three NAMED states rather than recovered from a list length, so the ambiguous case cannot be read as resolved by a caller that forgets to check the count. This is also why the fold below never needs a list-length primitive."

type NamedTargetTally
  = TallyNone
  | TallyOne { target: ExternalSubjectRef }
  | TallyMany {
      first: ExternalSubjectRef
      second: ExternalSubjectRef
      rest: List<ExternalSubjectRef>
    }

fn tally_many_candidates(first: ExternalSubjectRef, second: ExternalSubjectRef, rest: List<ExternalSubjectRef>) -> List<ExternalSubjectRef> {
  concat([first, second], rest)
}

data language_target_projection_law: String = "LEGACY KEYS BECOME PROJECTIONS, NEVER PARALLEL IDENTITIES (operator requirement D, 2026-08-04). LanguageId, display name, file extensions, short labels and the old prose-table names are attributes hanging off the canonical subject and are DERIVED from it where needed; none of them may be keyed on. The distinction is enforced by DIRECTION, which is the whole content of this row: asking the registry for a target's LanguageId is a projection and total for a registered subject, while asking which target a LanguageId denotes is a LOOKUP that REFUSES when no registered subject claims it. Before this, std.languages Language.id was the closest thing to a language key in the tree and nothing stopped a consumer from treating it as identity; after this, a legacy id that resolves nowhere is a typed refusal at the lookup rather than a second identity quietly in use. That refusal is not hypothetical today: std.languages carries rust, go, python and typescript rows and NO bash row, so the target this repository emits most has no legacy id at all — which is why the projection carries the legacy id as OPTIONAL rather than pretending every subject has one."

type LanguageTargetProjection {
  subject: ExternalSubjectRef
  display_name: String
  file_extensions: List<String>
  legacy_language_id: String?
  legacy_frontier_label: String?
}

type LanguageIdLookup
  = LanguageIdResolved { target: ExternalSubjectRef }
  | LanguageIdUnregistered { language_id: String }

fn projection_for_subject(
  subject: ExternalSubjectRef,
  projections: List<LanguageTargetProjection>
) -> LanguageTargetProjection? {
  fold(projections, init: none, f: fn(acc, p) {
    if external_subject_ref_eq(a: p.subject, b: subject) { Present { value: p } } else { acc }
  })
}

fn display_name_for_subject(
  subject: ExternalSubjectRef,
  projections: List<LanguageTargetProjection>
) -> String? {
  match projection_for_subject(subject: subject, projections: projections) {
    Absent => none
    Present { value: p } => Present { value: p.display_name }
  }
}

fn language_id_to_subject(
  language_id: String,
  projections: List<LanguageTargetProjection>
) -> LanguageIdLookup {
  fold(projections, init: LanguageIdUnregistered { language_id: language_id }, f: fn(acc, p) {
    match p.legacy_language_id {
      Absent => acc
      Present { value: lid } =>
        if lid == language_id { LanguageIdResolved { target: p.subject } } else { acc }
    }
  })
}

fn projection_subject_is_registered(
  projection: LanguageTargetProjection,
  registry: List<LanguageTargetRegistration>
) -> Bool {
  subject_in_list(
    target: projection.subject,
    subjects: registration_subjects(registry: registry)
  )
}

fn registration_subjects(registry: List<LanguageTargetRegistration>) -> List<ExternalSubjectRef> {
  fold(registry, init: [], f: fn(acc, r) {
    concat(acc, [ExternalSubjectRef { declaration: registration_subject(registration: r) }])
  })
}

fn subject_in_list(target: ExternalSubjectRef, subjects: List<ExternalSubjectRef>) -> Bool {
  fold(subjects, init: false, f: fn(acc, s) { acc || external_subject_ref_eq(a: s, b: target) })
}

fn subject_occurrence_count(
  target: ExternalSubjectRef,
  subjects: List<ExternalSubjectRef>
) -> Int {
  fold(subjects, init: 0, f: fn(acc, s) {
    if external_subject_ref_eq(a: s, b: target) { acc + 1 } else { acc }
  })
}

fn tally_push(tally: NamedTargetTally, next: ExternalSubjectRef) -> NamedTargetTally {
  match tally {
    TallyNone => TallyOne { target: next }
    TallyOne { target: only } => TallyMany { first: only, second: next, rest: [] }
    TallyMany { first: f, second: sec, rest: r } =>
      TallyMany { first: f, second: sec, rest: concat(r, [next]) }
  }
}

fn surface_named_targets(
  surface: LanguageTargetSurfaceLocus,
  rows: List<LanguageTargetSurfaceRow>
) -> NamedTargetTally {
  fold(rows, init: TallyNone, f: fn(acc, r) {
    if surface_locus_eq(a: r.surface, b: surface) {
      match r.target {
        Absent => acc
        Present { value: t } => tally_push(tally: acc, next: t)
      }
    } else {
      acc
    }
  })
}

fn resolve_target_for_surface(
  surface: LanguageTargetSurfaceLocus,
  rows: List<LanguageTargetSurfaceRow>,
  registry: List<LanguageTargetRegistration>
) -> LanguageTargetResolution {
  match surface_named_targets(surface: surface, rows: rows) {
    TallyNone => TargetSurfaceUnregistered { surface: surface }
    TallyMany { first: f, second: sec, rest: r } =>
      TargetSurfaceAmbiguous {
        surface: surface,
        candidates: tally_many_candidates(first: f, second: sec, rest: r)
      }
    TallyOne { target: t } =>
      if subject_in_list(target: t, subjects: registration_subjects(registry: registry)) {
        TargetResolved { target: t }
      } else {
        TargetSubjectUnresolvable { subject: t }
      }
  }
}

fn surface_row_violations(
  row: LanguageTargetSurfaceRow,
  registry: List<LanguageTargetRegistration>
) -> List<LanguageTargetJoinViolation> {
  match row.target {
    Absent =>
      match row.authority {
        TargetVocabulary => [TargetVocabularyHasNoRegistryTarget { surface: row.surface }]
        StdLanguageCatalogue => [SurfaceMissingTargetIdentity { authority: row.authority, surface: row.surface }]
        TargetModelDeclaration => [SurfaceMissingTargetIdentity { authority: row.authority, surface: row.surface }]
        EmitHostExecution => [SurfaceMissingTargetIdentity { authority: row.authority, surface: row.surface }]
        RuntimeChecker => [SurfaceMissingTargetIdentity { authority: row.authority, surface: row.surface }]
        LegacyFrontier => [SurfaceMissingTargetIdentity { authority: row.authority, surface: row.surface }]
      }
    Present { value: t } =>
      if subject_in_list(target: t, subjects: registration_subjects(registry: registry)) {
        []
      } else {
        [SurfaceNamesUnknownTarget {
          authority: row.authority,
          surface: row.surface,
          named: t
        }]
      }
  }
}

data multi_target_detector_note: String = "SurfaceJoinsMultipleTargets is emitted ONCE PER SURFACE, not once per row: a surface named by three disagreeing rows is one malformed surface, and emitting three violations would make the count a function of how the disagreement happened to be spread across rows rather than of how many surfaces are malformed. The accumulator therefore carries the loci already reported. This is the registry-INPUT class; TargetSurfaceAmbiguous is the LOOKUP outcome over the same shape, and they are deliberately distinct — one says the rows are wrong, the other says a question cannot be answered."

type MultiTargetScan {
  reported: List<LanguageTargetSurfaceLocus>
  violations: List<LanguageTargetJoinViolation>
}

fn locus_in_list(target: LanguageTargetSurfaceLocus, xs: List<LanguageTargetSurfaceLocus>) -> Bool {
  fold(xs, init: false, f: fn(acc, l) { acc || surface_locus_eq(a: l, b: target) })
}

fn multi_target_surface_violations(
  rows: List<LanguageTargetSurfaceRow>
) -> List<LanguageTargetJoinViolation> {
  let scanned = fold(rows, init: MultiTargetScan { reported: [], violations: [] }, f: fn(acc, r) {
    if locus_in_list(target: r.surface, xs: acc.reported) {
      acc
    } else {
      match surface_named_targets(surface: r.surface, rows: rows) {
        TallyMany { first: f, second: sec, rest: _ } =>
          MultiTargetScan {
            reported: concat(acc.reported, [r.surface]),
            violations: concat(acc.violations, [SurfaceJoinsMultipleTargets {
              authority: r.authority,
              surface: r.surface,
              first: f,
              second: sec
            }])
          }
        TallyOne { target: _ } => acc
        TallyNone => acc
      }
    }
  })
  scanned.violations
}

fn duplicate_registration_violations(
  registry: List<LanguageTargetRegistration>
) -> List<LanguageTargetJoinViolation> {
  let subjects = registration_subjects(registry: registry)
  fold(registry, init: [], f: fn(acc, r) {
    let subj = ExternalSubjectRef { declaration: registration_subject(registration: r) }
    if subject_occurrence_count(target: subj, subjects: subjects) > 1 {
      concat(acc, [DuplicateRegistryTarget { target: subj }])
    } else {
      acc
    }
  })
}

fn language_target_join_violations(
  rows: List<LanguageTargetSurfaceRow>,
  registry: List<LanguageTargetRegistration>
) -> List<LanguageTargetJoinViolation> {
  concat(
    fold(rows, init: [], f: fn(acc, r) {
      concat(acc, surface_row_violations(row: r, registry: registry))
    }),
    concat(
      multi_target_surface_violations(rows: rows),
      duplicate_registration_violations(registry: registry)
    )
  )
}

fn language_target_join_clean(
  rows: List<LanguageTargetSurfaceRow>,
  registry: List<LanguageTargetRegistration>
) -> Bool {
  fold(
    language_target_join_violations(rows: rows, registry: registry),
    init: true,
    f: fn(acc, v) { false }
  )
}
