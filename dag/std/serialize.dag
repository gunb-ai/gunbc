module std.serialize

fn serial_scalar(text: String) -> std.languages.SerialValue {
  std.languages.ScalarValue { text: text }
}

fn serial_field(key: String, value: std.languages.SerialValue) -> std.languages.SerialField {
  std.languages.SerialField { key: key, value: value }
}

fn serialize_value_doc(knobs: std.languages.SerializationKnobs, v: std.languages.SerialValue) -> std.layout.Doc {
  match v {
    std.languages.ScalarValue { text: t } =>
      match knobs.value_quote {
        null => std.layout.doc_text(text: t)
        q => std.layout.doc_text(text: concat(concat(q, t), q))
      }
    std.languages.RecordValue { fields: fields } =>
      serialize_record_doc(knobs: knobs, fields: fields)
  }
}

fn serialize_field_doc(knobs: std.languages.SerializationKnobs, f: std.languages.SerialField) -> std.layout.Doc {
  let key_text = if knobs.quote_keys {
    concat(concat("\"", f.key), "\"")
  } else {
    f.key
  }
  std.layout.doc_concat(parts: [
    std.layout.doc_text(text: concat(key_text, knobs.assign)),
    serialize_value_doc(knobs: knobs, v: f.value)
  ])
}

fn serialize_fields_doc(knobs: std.languages.SerializationKnobs, fields: List<std.languages.SerialField>) -> std.layout.Doc {
  std.layout.doc_concat(parts: reverse(
    fields
      |> map(fld => serialize_field_doc(knobs: knobs, f: fld))
      |> fold(init: [], f: fn(acc, doc) {
        if count(acc) == 0 {
          [doc]
        } else {
          concat([doc], concat([std.layout.doc_text(text: knobs.entry_separator)], acc))
        }
      })
  ))
}

fn serialize_record_doc(knobs: std.languages.SerializationKnobs, fields: List<std.languages.SerialField>) -> std.layout.Doc {
  std.layout.doc_concat(parts: [
    std.layout.doc_text(text: knobs.open),
    serialize_fields_doc(knobs: knobs, fields: fields),
    std.layout.doc_text(text: knobs.close)
  ])
}
