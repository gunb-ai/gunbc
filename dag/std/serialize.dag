module std.serialize

fn serial_scalar(text: String) -> SerialValue {
  ScalarValue { text: text }
}

fn serial_field(key: String, value: SerialValue) -> SerialField {
  SerialField { key: key, value: value }
}

fn serialize_value_doc(knobs: SerializationKnobs, v: SerialValue) -> Doc {
  match v {
    ScalarValue { text: t } =>
      match knobs.value_quote {
        null => doc_text(text: t)
        q => doc_text(text: concat(concat(q, t), q))
      }
    RecordValue { fields: fields } =>
      serialize_record_doc(knobs: knobs, fields: fields)
  }
}

fn serialize_field_doc(knobs: SerializationKnobs, f: SerialField) -> Doc {
  let key_text = if knobs.quote_keys {
    concat(concat("\"", f.key), "\"")
  } else {
    f.key
  }
  doc_concat(parts: [
    doc_text(text: concat(key_text, knobs.assign)),
    serialize_value_doc(knobs: knobs, v: f.value)
  ])
}

fn serialize_fields_doc(knobs: SerializationKnobs, fields: List<SerialField>) -> Doc {
  doc_concat(parts: reverse(
    fields
      |> map(fld => serialize_field_doc(knobs: knobs, f: fld))
      |> fold(init: [], f: fn(acc, doc) {
        if count(acc) == 0 {
          [doc]
        } else {
          concat([doc], concat([doc_text(text: knobs.entry_separator)], acc))
        }
      })
  ))
}

fn serialize_record_doc(knobs: SerializationKnobs, fields: List<SerialField>) -> Doc {
  doc_concat(parts: [
    doc_text(text: knobs.open),
    serialize_fields_doc(knobs: knobs, fields: fields),
    doc_text(text: knobs.close)
  ])
}
