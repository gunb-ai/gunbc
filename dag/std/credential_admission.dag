module std.credential_admission

import std.types { String, Int, Bool, Secret }
import std.optional { Present, Absent }
import std.decl_ref { decl_ref }
import std.measure {
  ObservationInstant, Nanosecond, nanosecond_count, compare_instants,
  InstantBefore, InstantSame, InstantAfter, InstantIncomparable,
}
import std.checked_arithmetic { CheckedIntReady, CheckedIntOverflow, checked_int_add }
import std.access {
  AccessDecision, Permit, Deny, AccessRefusal, AccessRefusalLocation, AccessContextAbsent,
  AccessEvidenceStale, AccessEvidenceValidityUnestablished, AccessEvidenceClockIncomparable,
  AccessEvidenceBindingRefused,
}
import std.credentials {
  CredentialValidity, UsableUntil, ValidityUnestablished, CredentialDeadline, CredentialUseRequirement, credential_deadline_instant,
  observe_credential_monotonic,
}
import std.credential_refusal { BindingRefusal, DeadlineArithmeticOverflow }

// THE PRESENTATION JUDGMENT: may this credential be presented to this request at this observation?
// It is PURE over three inputs -- the credential's established validity, an observation the transport
// took immediately before dispatch, and the operation's requirement -- and it answers in the one
// decision type, std.access AccessDecision, rather than a second admitted/refused sum. Acquisition and
// renewal stay outside it: a refusal here is a fact the caller's renewal policy reads, never a trigger
// this function acts on.
//
// THE EXPIRY INSTANT REFUSES. A credential is usable only while
//   observed_at + required_remaining + skew_margin < usable_until
// with the sum checked. This is deliberately NOT std.scoped_authorization grant_not_expired_at, whose
// `<=` admits the expiry instant (a grant "valid through"): a provider's expiry is the instant the
// bearer stops authenticating, so it belongs to the refused interval, as in
// gunbc.auth.approval_capability capability_live_at.
//
// SUITABILITY, NOT AUTHORIZATION. A Permit here says this credential may be presented to this
// request; it says nothing about whether the attempt is authorized to perform the action, which stays
// with std.scoped_authorization and std.effect_grant. Renewing a credential extends neither.
fn credential_validity_decision(
  evidence: String,
  validity: CredentialValidity,
  observed_at: ObservationInstant,
  requirement: CredentialUseRequirement,
  location: AccessRefusalLocation,
) -> AccessDecision {
  match validity {
    ValidityUnestablished { cause: c } =>
      Deny { refusal: AccessRefusal { cause: AccessEvidenceValidityUnestablished { evidence: evidence, cause: c }, location: location } }
    UsableUntil { deadline: d } => deadline_decision(evidence: evidence, deadline: d, observed_at: observed_at, requirement: requirement, location: location)
  }
}

fn deadline_decision(
  evidence: String,
  deadline: CredentialDeadline,
  observed_at: ObservationInstant,
  requirement: CredentialUseRequirement,
  location: AccessRefusalLocation,
) -> AccessDecision {
  let until = credential_deadline_instant(d: deadline)
  match compare_instants(a: observed_at, b: until) {
    InstantIncomparable { left: observed_domain, right: held_domain } =>
      Deny { refusal: AccessRefusal { cause: AccessEvidenceClockIncomparable { evidence: evidence, held: held_domain, observed: observed_domain }, location: location } }
    _ => {
      let stale = Deny { refusal: AccessRefusal {
        cause: AccessEvidenceStale {
          evidence: evidence, observed_at: observed_at, usable_until: until,
          required_remaining: requirement.required_remaining, skew_margin: requirement.skew_margin,
        },
        location: location,
      } }
      match checked_int_add(a: nanosecond_count(n: observed_at.since_origin) as Int, b: nanosecond_count(n: requirement.required_remaining) as Int) {
        CheckedIntOverflow { cause: _ } =>
          Deny { refusal: AccessRefusal { cause: AccessEvidenceValidityUnestablished { evidence: evidence, cause: DeadlineArithmeticOverflow }, location: location } }
        CheckedIntReady { value: needed } =>
          match checked_int_add(a: needed, b: nanosecond_count(n: requirement.skew_margin) as Int) {
            CheckedIntOverflow { cause: _ } =>
              Deny { refusal: AccessRefusal { cause: AccessEvidenceValidityUnestablished { evidence: evidence, cause: DeadlineArithmeticOverflow }, location: location } }
            CheckedIntReady { value: latest } =>
              if latest < (nanosecond_count(n: until.since_origin) as Int) { Permit } else { stale }
          }
      }
    }
  }
}

// A provider's binding judgment answers in the same decision: a refusal names the axis and members.
fn credential_binding_decision(evidence: String, refusal: BindingRefusal?, location: AccessRefusalLocation) -> AccessDecision {
  match refusal {
    Absent => Permit
    Present { value: r } => Deny { refusal: AccessRefusal { cause: AccessEvidenceBindingRefused { evidence: evidence, cause: r }, location: location } }
  }
}

// ── ADMISSION AT THE CALL: THE OBSERVATION IS TAKEN HERE, NOT SUPPLIED ──────────────────────────
// The one effectful judgment of presentation. It reads the process monotonic clock at the moment a
// provider's presentation helper is about to release a secret, so the observation cannot be a caller's
// earlier reading and every call -- including each retry a caller drives -- is judged at its own
// instant. Validity is judged first (a stale or unestablished credential is refused whatever it binds),
// then the binding against what the operation requires. A clock that cannot be read refuses: there is
// no observation, so there is no judgment, and nothing is released.
fn credential_admission_now(
  evidence: String,
  validity: CredentialValidity,
  binding_refusal: BindingRefusal?,
  requirement: CredentialUseRequirement,
  location: AccessRefusalLocation,
) -> AccessDecision uses clk: std.resources.Clock {
  match observe_credential_monotonic(label: "credential-presentation") {
    Absent => Deny { refusal: AccessRefusal { cause: AccessContextAbsent { context: "the process monotonic clock could not be read at presentation" }, location: location } }
    Present { value: observed } =>
      match credential_validity_decision(evidence: evidence, validity: validity, observed_at: observed, requirement: requirement, location: location) {
        Deny { refusal: r } => Deny { refusal: r }
        Permit => credential_binding_decision(evidence: evidence, refusal: binding_refusal, location: location)
      }
  }
}

// THE PRESENTATION: the one value that carries a released secret. It is sealed to this module and
// built only by present_credential, whose callers are the providers' presentation functions, so a
// CredentialPresented exists only where admission at the call permitted it. A caller matches it and
// sends at once: the secret is under secret_released_only_by_admission, the name the grep receipt
// counts (gunbc.integration_concern credential_secret_field_reads_confined_by_name_not_construction).
type CredentialPresentation sole_constructor
  = CredentialPresented { secret_released_only_by_admission: Secret }
  | CredentialPresentationRefused { refusal: AccessRefusal }

fn present_credential(
  secret: Secret,
  evidence: String,
  validity: CredentialValidity,
  binding_refusal: BindingRefusal?,
  requirement: CredentialUseRequirement,
  location: AccessRefusalLocation,
) -> CredentialPresentation uses clk: std.resources.Clock
  admit_callers: [
    decl_ref(module_path: "extdeps.cloud.gcp.iam", decl_name: "gcp_impersonated_presentation"),
    decl_ref(module_path: "extdeps.github.app", decl_name: "github_installation_presentation"),
  ]
{
  match credential_admission_now(evidence: evidence, validity: validity, binding_refusal: binding_refusal, requirement: requirement, location: location) {
    Permit => CredentialPresented { secret_released_only_by_admission: secret }
    Deny { refusal: r } => CredentialPresentationRefused { refusal: r }
  }
}
