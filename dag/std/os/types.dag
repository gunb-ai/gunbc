module std.os.types

import std.types { NonEmptyStr }

type KernelFamily = Linux | Darwin | WindowsNt | LinuxGuestOnWindows
type FileSystemSemantics = Posix | Ntfs | Apfs | WslPathTranslation
type ProcessSemantics = PosixProcess | WindowsProcess | HybridWslGuest

type OperatingSystemSurface {
  kernel: KernelFamily
  distro_or_product: NonEmptyStr?
  version: NonEmptyStr?
  filesystem_semantics: FileSystemSemantics
  process_semantics: ProcessSemantics
}

// MODELING GAP (crisp-wren-896 finding, PR #8590), PARTIALLY CLOSED for srv1's software side:
// gunbc.host.host_software_surface host_operating_system_surface joins srv1's OS release to
// UbuntuDistributionCatalogRow (Noble Numbat / Apt). srv2-4 and gunbc.ci.ci_fleet still carry
// OperatingSystemSurface { distro_or_product: none } via fleet_intent_os_surface, which remains the
// fleet-wide execution-surface default. The catalog rows below already model package_manager; the
// remaining gap is those other hosts and a package-set/tool-availability authority cited to the
// distro's own package index. Until those land, tool-presence questions stay at the wet-probe rung
// for every host that has not joined.

type UbuntuDistribution = | NobleNumbat2404Lts
type WindowsDistribution = | Windows1124H2Build26100
type MacosDistribution = | Sequoia15

type OperatingSystemProduct
  = UbuntuOs { distro: UbuntuDistribution }
  | WindowsOs { distro: WindowsDistribution }
  | MacosOs { distro: MacosDistribution }

type OsPackageManager = Apt | Winget | HomebrewDeFacto

type LibcFamily = GnuGlibc | Ucrt | LibSystem

type UbuntuDistributionCatalogRow {
  distribution: UbuntuDistribution
  release_label: NonEmptyStr
  kernel_version: NonEmptyStr
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: NonEmptyStr?
  security_maintenance_until: NonEmptyStr
}

type WindowsDistributionCatalogRow {
  distribution: WindowsDistribution
  release_label: NonEmptyStr
  os_build: NonEmptyStr
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: NonEmptyStr?
  end_of_servicing: NonEmptyStr
}

type MacosDistributionCatalogRow {
  distribution: MacosDistribution
  release_label: NonEmptyStr
  darwin_version: NonEmptyStr?
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: NonEmptyStr?
  annual_release_label: NonEmptyStr
}
