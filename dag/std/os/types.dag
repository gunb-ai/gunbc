module std.os.types


type KernelFamily = Linux | Darwin | WindowsNt | LinuxGuestOnWindows
type FileSystemSemantics = Posix | Ntfs | Apfs | WslPathTranslation
type ProcessSemantics = PosixProcess | WindowsProcess | HybridWslGuest

type OperatingSystemSurface {
  kernel: KernelFamily
  distro_or_product: std.types.NonEmptyStr?
  version: std.types.NonEmptyStr?
  filesystem_semantics: FileSystemSemantics
  process_semantics: ProcessSemantics
}

data operating_system_surface_package_authority_gap_note: String = "MODELING GAP (crisp-wren-896 finding, PR #8590): no host instance anywhere in gunbc.fleet_intent or gunbc.ci_fleet populates distro_or_product -- srv1-4 (gunbc.fleet_intent, ComputeHost rows) and our own CI/falsifier runner (gunbc.ci_fleet) all carry `OperatingSystemSurface \{ distro_or_product: none, ... \}`. This is not a missing field on the type: UbuntuDistributionCatalogRow / WindowsDistributionCatalogRow / MacosDistributionCatalogRow below already model a distro's package_manager, libc, and libc_version, and OsPackageManager is a closed enum -- the catalog authority a real per-host join would need already exists in this module. What is missing is the JOIN: no OperatingSystemSurface instance in the tree carries a distro_or_product value that resolves to one of those catalog rows, so no typed question of the form \"does this host's package manager provide tool X\" is answerable for ANY host in the fleet, our own CI runner included. This is why extdeps.shell's shell.PosixCommandV.Check / former shell.Which.Check presence probes are wet shell round-trips rather than typed catalog lookups: there is no typed fact to look up. CLOSING THIS: populate distro_or_product (and version) on each ComputeHost's OperatingSystemSurface with a real, cited observation of that host's actual OS -- not a default or an assumption -- so it joins to a *DistributionCatalogRow, and extend that catalog with a package-set/tool-availability authority (e.g. which apt packages provide which binaries) cited to the distro's own package index. Until both land, tool-presence questions stay at the wet-probe rung (mitigatable, not mechanically preventable) for every host in this fleet."

type UbuntuDistribution = | NobleNumbat2404Lts
type WindowsDistribution = | Windows1124H2Build26100
type MacosDistribution = | Sequoia15

type OperatingSystemProduct
  = UbuntuOs { distro: UbuntuDistribution }
  | WindowsOs { distro: WindowsDistribution }
  | MacosOs { distro: MacosDistribution }

type OsPackageManager = Apt | Winget | HomebrewDeFacto

type LibcFamily = GnuGlibc | Ucrt | LibSystem

type UbuntuDistributionCatalogRow {
  distribution: UbuntuDistribution
  release_label: std.types.NonEmptyStr
  kernel_version: std.types.NonEmptyStr
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: std.types.NonEmptyStr?
  security_maintenance_until: std.types.NonEmptyStr
}

type WindowsDistributionCatalogRow {
  distribution: WindowsDistribution
  release_label: std.types.NonEmptyStr
  os_build: std.types.NonEmptyStr
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: std.types.NonEmptyStr?
  end_of_servicing: std.types.NonEmptyStr
}

type MacosDistributionCatalogRow {
  distribution: MacosDistribution
  release_label: std.types.NonEmptyStr
  darwin_version: std.types.NonEmptyStr?
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: std.types.NonEmptyStr?
  annual_release_label: std.types.NonEmptyStr
}
