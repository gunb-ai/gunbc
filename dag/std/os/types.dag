module std.os.types


type KernelFamily = Linux | Darwin | WindowsNt | LinuxGuestOnWindows
type FileSystemSemantics = Posix | Ntfs | Apfs | WslPathTranslation
type ProcessSemantics = PosixProcess | WindowsProcess | HybridWslGuest

type OperatingSystemSurface {
  kernel: KernelFamily
  distro_or_product: std.types.NonEmptyStr?
  version: std.types.NonEmptyStr?
  filesystem_semantics: FileSystemSemantics
  process_semantics: ProcessSemantics
}

type UbuntuDistribution = | NobleNumbat2404Lts
type WindowsDistribution = | Windows1124H2Build26100
type MacosDistribution = | Sequoia15

type OperatingSystemProduct
  = UbuntuOs { distro: UbuntuDistribution }
  | WindowsOs { distro: WindowsDistribution }
  | MacosOs { distro: MacosDistribution }

type OsPackageManager = Apt | Winget | HomebrewDeFacto

type LibcFamily = GnuGlibc | Ucrt | LibSystem

type UbuntuDistributionCatalogRow {
  distribution: UbuntuDistribution
  release_label: std.types.NonEmptyStr
  kernel_version: std.types.NonEmptyStr
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: std.types.NonEmptyStr?
  security_maintenance_until: std.types.NonEmptyStr
}

type WindowsDistributionCatalogRow {
  distribution: WindowsDistribution
  release_label: std.types.NonEmptyStr
  os_build: std.types.NonEmptyStr
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: std.types.NonEmptyStr?
  end_of_servicing: std.types.NonEmptyStr
}

type MacosDistributionCatalogRow {
  distribution: MacosDistribution
  release_label: std.types.NonEmptyStr
  darwin_version: std.types.NonEmptyStr?
  package_manager: OsPackageManager
  libc: LibcFamily
  libc_version: std.types.NonEmptyStr?
  annual_release_label: std.types.NonEmptyStr
}
