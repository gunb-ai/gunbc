module std.os.invocation

import std.types { NonEmptyStr }
import std.abi { CallingConvention }

type SyscallEntry {
  number: Int
  name: NonEmptyStr
  arg_count: Int
}

type SyscallAbi {
  table: List<SyscallEntry>
  convention: CallingConvention
}

type ApiEntry {
  symbol: NonEmptyStr
  module: NonEmptyStr
}

type LibraryApiBoundary {
  exports: List<ApiEntry>
}

type StableInvocationSurface
  = SyscallAbiSurface { abi: SyscallAbi }
  | LibraryApiBoundarySurface { boundary: LibraryApiBoundary }
