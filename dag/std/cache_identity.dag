module std.cache_identity

import std.dissolution { DissolutionCondition, unbound_dissolution }

import std.types { NonEmptyStr }
import std.content_hash { ContentHash, content_hash_of_value }

type CacheInterfaceId = NonEmptyStr where brand("CacheInterfaceId")
type ArtifactKindId = NonEmptyStr where brand("ArtifactKindId")

type ExecutionReceiptDigest {
  digest: ContentHash
}

fn execution_receipt_digest_from_content_hash(hash: ContentHash) -> ExecutionReceiptDigest {
  ExecutionReceiptDigest { digest: hash }
}

fn execution_receipt_digest_of_value(value: NonEmptyStr) -> ExecutionReceiptDigest {
  execution_receipt_digest_from_content_hash(hash: content_hash_of_value(value: value))
}

data resolved_graph_artifact_kind: ArtifactKindId = "resolved_graph"

data parse_table_artifact_kind: ArtifactKindId = "parse_table"

data parse_source_artifact_kind: ArtifactKindId = "parse_source"

data typed_module_artifact_kind: ArtifactKindId = "typed_module"

data hermetic_fixture_artifact_kind: ArtifactKindId = "hermetic_fixture"

data cache_interface_product_dissolve_on: DissolutionCondition = unbound_dissolution(description: "dissolve-on: std.cache_identity.CacheInterfaceProduct — deleted closed enum fork; sole cache-backend identity authority is CacheInterfaceId (extdeps/cache/*.dag cited rows keyed by id).")
