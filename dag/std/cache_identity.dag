module std.cache_identity



type CacheInterfaceId = std.types.NonEmptyStr where brand("CacheInterfaceId")
type ArtifactKindId = std.types.NonEmptyStr where brand("ArtifactKindId")

type ExecutionReceiptDigest {
  digest: std.content_hash.ContentHash
}

fn execution_receipt_digest_from_content_hash(hash: std.content_hash.ContentHash) -> ExecutionReceiptDigest {
  ExecutionReceiptDigest { digest: hash }
}

fn execution_receipt_digest_of_value(value: std.types.NonEmptyStr) -> ExecutionReceiptDigest {
  execution_receipt_digest_from_content_hash(hash: std.content_hash.content_hash_of_value(value: value))
}

data resolved_graph_artifact_kind: ArtifactKindId = "resolved_graph"

data parse_table_artifact_kind: ArtifactKindId = "parse_table"

data parse_source_artifact_kind: ArtifactKindId = "parse_source"

data typed_module_artifact_kind: ArtifactKindId = "typed_module"

data hermetic_fixture_artifact_kind: ArtifactKindId = "hermetic_fixture"

data cache_interface_product_dissolve_on: std.dissolution.DissolutionCondition = std.dissolution.unbound_dissolution(description: "dissolve-on: std.cache_identity.CacheInterfaceProduct — deleted closed enum fork; sole cache-backend identity authority is CacheInterfaceId (extdeps/cache/*.dag cited rows keyed by id).")
