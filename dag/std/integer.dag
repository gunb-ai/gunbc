module std.integer
import std.optional { Absent, Present }

import std.algebra { GroupCompletion, OrderedRing, TotalOrder, Ordering, Less, Equal, Greater, collection_concat_shape }
import std.error_primitives { DivError, Result, DivideByZero, Ok, Err }
import std.nat { Nat, DecimalDigit, D0, D1, D2, D3, D4, D5, D6, D7, D8, D9, decimal_digit_value, decimal_digit_glyph, decimal_digit_successor, DecimalDigitNext, DecimalDigitCarry }
import std.machine_constraints { Compose, MachineWidth, PointerWidth }
import std.measure { bit_width, bit_width_count, bits_per_byte }
import std.induction { int_pow_bounded }
import std.types { Bool, gt_zero, List, String }

type Int8 = Compose<Int, MachineWidth<8>>
type Int16 = Compose<Int, MachineWidth<16>>
type Int32 = Compose<Int, MachineWidth<32>>
type Int64 = Compose<Int, MachineWidth<64>>
type Int128 = Compose<Int, MachineWidth<128>>

type UInt8 = Compose<UInt, MachineWidth<8>>
type UInt16 = Compose<UInt, MachineWidth<16>>
type UInt32 = Compose<UInt, MachineWidth<32>>
type UInt64 = Compose<UInt, MachineWidth<64>>
type UInt128 = Compose<UInt, MachineWidth<128>>

// THE ONE LANGUAGE-FACING INTEGER, AS A CANONICAL STRUCTURAL CARRIER (operator ruling 2026-10-19, the
// kernel-type layer rule). NonNegative { n } denotes n and Negative { pred } denotes -(pred + 1): one zero, and
// the negative arm cannot spell a second one, so given admitted naturals every integer has exactly one
// constructor value and STRUCTURAL equality -- the tag and its Nat payload, not pointer or provenance
// equality -- is integer equality. The integer is a VALUE, not the structures over it: its algebra is
// int_ordered_ring below, a value over Int, and GroupCompletion<Nat> is a construction that normalizes
// onto it (int_of_group_completion). Its host realization is the machine integer, by the signed
// KernelGrounding row in gunbc.structural_realization_bindings, which folds both constructors and their
// patterns into kernel integers; where the machine integer cannot compute a value exactly the
// realization refuses rather than wrapping. The previous body, AbelianGroup<GroupCompletion<Nat>>, was a
// record of operations standing where the value belonged.
//
// v2.std.integer still declares its own Int (GroupCompletion<Nat>); it is frozen -- nothing new may consume
// it -- until the declared-name rehoming migration repoints its importers and deletes it. This delivery
// does not complete that de-fork.
type Int
  = NonNegative { n: Nat }
  | Negative { pred: Nat }
type UInt = Nat

// THE OCTET CONSTRUCTOR LIVES WITH THE OCTET'S TYPE, AND THE OCTET'S TYPE IS UInt8.
//
// extdeps.network.mac settled this concept already: UInt8 is the universal authority for an 8-bit
// unsigned integer, ipv4's `type Octet = Int where range(min: 0, max: 255)` is a pre-existing
// duplicate left deliberately untouched, and a second spelling would be the section 2 re-invention.
// std.machine_word briefly carried a THIRD name, an Octet record of its own; it is deleted, and
// what it was reaching for lands here instead.
//
// WHAT UInt8 ALREADY ESTABLISHES AND WHAT IT DOES NOT, measured rather than assumed. UInt8 is
// Compose<UInt, MachineWidth<8>>, so "the width is eight" is STRUCTURAL -- there is no width field
// to write wrongly, which is the construction rung. INHABITANCE is not: the composition is a
// phantom and transparent to Int at a formal, so a bare Int reaches a UInt8 parameter unchecked.
// The receipt is in the corpus rather than in an argument: std.encoding base64_octets declares
// List<UInt8> and test.claim.machine_word_witness calls it with [256, 0, 0], and that claim
// COMPILED AND EXECUTED in the floor receipt at 9ca9d9ab -- 256 crossed a UInt8 formal with no
// refusal.
//
// So this constructor is the wall, and it is MITIGATION, not construction: nothing stops a caller
// bypassing it with a bare Int. Rung: mitigatable. NEXT-RUNG TRIGGER, shared with std.machine_word's
// word carrier: sole construction over UInt8, which makes the unconstructed value unwritable and
// turns this refusal into a state with no constructor.
// THE READY ARM CARRIES AN `Int`, AND SAYING `UInt8` HERE WAS THE DEFECT.
//
// `UInt8` is `Compose<UInt, MachineWidth<8>>` and `Compose` is `Phantom`: it has NO INHABITANT. So
// this arm claimed to hold a value of a type that cannot hold one, and `uint8_of_int` below
// constructed it by putting an `Int` there -- which the checker admitted only because the
// composition is transparent to `Int` at a formal. The emitted target is not transparent, and the
// first consumer to emit this closure got `E0308 expected PhantomData<(i64, MachineWidth<()>)>,
// found i64`. The field now says what it holds.
//
// THE ADMISSION IS UNCHANGED AND SO IS THE RUNG. `uint8_of_int` still refuses anything outside
// [0, 2^8), and this arm is still reachable only through it; what changed is that the arm no longer
// asserts a width in its TYPE that nothing checks and no value can carry. NO ENFORCED RUNG DROPS:
// no wall is removed, because there was never a wall here -- a phantom brand checks nothing.
// Stating the width in the type is the (b) climb, and it needs a NEWTYPE over the carrier with sole
// construction, which is the trigger on
// `gunbc.recurring_failure_mode.bounded_natural_arithmetic_evaluated_as_unbounded_int`.
type UInt8Result
  = UInt8Ready { value: Int }
  | UInt8OutOfRange { observed: Int }

fn uint8_of_int(value: Int) -> UInt8Result {
  match int_pow_bounded(base: 2, exp: uint8_channel_bit_width_int()) {
    Absent => UInt8OutOfRange { observed: value }
    Present { value: modulus } =>
      if value < 0 || value >= modulus {
        UInt8OutOfRange { observed: value }
      } else {
        UInt8Ready { value: value }
      }
  }
}

// THE ADMISSION IS CARRIED BY A SEALED CARRIER, BECAUSE A PHANTOM BRAND CANNOT CARRY IT.
//
// UInt8 is Compose<UInt, MachineWidth<8>>, and the composition is transparent to Int at a formal --
// so `List<UInt8>` at a parameter establishes NOTHING about its members, and uint8_of_int beside the
// route is a wall with a door next to it. That is not reasoning, it is measured on the head this
// carrier replaces: word_from_octets(Width16, [1, 256], BigEndian) answered WordReady 512,
// octet_int_values([256]) answered [256], and base64_encode([256, 0, 0], Standard) answered "AAAA"
// -- a fabricated plausible output, which DESIGN section 5 forbids outright, reached without forging
// anything. The RED that was supposed to cover this tested uint8_of_int BESIDE the production route
// rather than on it.
//
// So the carried fact gets its own type. QualifiedOctets does not mean "a list of octets"; it means
// EVERY MEMBER PASSED uint8_of_int ADMISSION. It is not a third spelling of the octet -- the octet is
// still UInt8 and there is still one of those -- it is the PROOF ABOUT a list of them, which is a
// different fact and therefore a different carrier.
type QualifiedOctets sole_constructor {
  members: List<Int>
}

type QualifiedOctetsResult
  = QualifiedOctetsReady { value: QualifiedOctets }
  | QualifiedOctetsRefused { observed: Int }

// THE ONE MINT, CALLER-SEALED BY NAME, modelled on extdeps.exec.command argv_command -- the corpus
// already runs this wall and it refuses at resolve, so this is an existing capability being consumed
// rather than a mechanism invented here.
//
// The roster is deliberately CLOSED AND NAMED, and each entry states its own reason. uint8_octets_of_ints is
// the admission fold: it runs every member through uint8_of_int and mints ONLY from the list it has
// just proved in full, so an outside caller cannot reach a QualifiedOctets carrying an unadmitted
// value at all. It used to be an accumulator with a caller-supplied `admitted` prefix in this slot,
// and that was a proxy in exactly the sense stated below: `admitted: [256], remaining: []` minted a
// sealed value nothing had checked (side-chat HOLD on e08f937d). The mint now has no formal a caller
// can pre-load -- the proved list and the minted list are the same value.
//
// word_to_octets is admitted because its members are COMPUTED in range -- they are remainders modulo
// the octet radix, each already through uint8_of_int -- so routing it through the fold would add a
// refusal arm no input can reach, which is the unreachable-arm trap this change deletes elsewhere.
//
// base16_decode_lower and sha256_hex are admitted on THAT SAME GROUND and on no weaker one, which
// is why they are named rather than the roster being opened. Each member base16_decode_lower mints
// is `high * 16 + low` over two digits drawn from base16_digit_rows, so it is computed in [0, 255]
// by the operation that produced it; each member sha256_hex mints came out of sha256_word_octets,
// which is the same modulo-radix decomposition word_to_octets performs. NEITHER IS A PROXY, which
// is the property that decides whether a roster entry is safe: base16_decode_lower's only formal
// is the hex STRING and sha256_hex's is the message, so no caller can pre-load the member list the
// mint seals -- the proved list and the minted list are the same value, as they are above.
//
// THE RUNG THIS REACHES, MEASURED IN BOTH DIRECTIONS RATHER THAN CLAIMED. Three routes were probed
// against this carrier as real modules compiled through the real acceptance path:
//
// CLOSED AT COMPILE TIME, structurally impossible outside the defining module --
//   QualifiedOctets { members: [256] }            refuses: "sole_constructor type 'QualifiedOctets'
//                                                  cannot be constructed outside its defining module"
//   qualified_octets(members: [256])              refuses: "constructor call admission refused"
//   RealizableWidth { width: Width64, modulus: 1} refuses, same sole_constructor wall
//
// NOT CLOSED AT COMPILE TIME, and this is stated because the alternative is inflation -- handing a
// raw List where the carrier is declared still type-checks. base64_encode(octets: [256, 0, 0], ...)
// compiles and dies at RUNTIME with `TypeError: cannot access field 'members' on List`. That is a
// real climb and not the whole one: on the head this replaces the same call ANSWERED "AAAA", a
// fabricated plausible output, and now nothing wrong is produced -- but a loud untyped abort is
// rung 1, not rung 3.
//
// The gap is List-against-Product at a formal, and it is not a weakness in this carrier: Product
// against Product IS decided (qualified_word_value(q: Word { ... }) refuses with "expected
// Product(QualifiedWord), got Product(Word)"), and a TYPED List<UInt8> crosses just as a literal
// does, so it is the list position and not the literal. NEXT-RUNG TRIGGER: inhabitance decided for a
// List argument at a non-List declared type -- a compiler capability, named here so the stall is
// tracked rather than silent (DESIGN section 4b(2)).
//
// WHAT admit_callers DOES AND DOES NOT ESTABLISH, stated here because the distinction decides the
// rung. It constrains the CALL EDGE, not the egress of the returned value: an admitted producer that
// accepted a caller's list and handed back the sealed value would be a PROXY, and the seal would be
// worth nothing. Neither admitted caller is one -- the fold mints only the list it has verified in
// full, and word_to_octets takes a Word and a width rather than a member list. That is the property a reviewer should check when the roster
// grows, and it is why the roster is a named list rather than a convenience.
fn qualified_octets(members: List<Int>) -> QualifiedOctets
  admit_callers: [
    decl_ref(module_path: "std.integer", decl_name: "uint8_octets_of_ints"),
    decl_ref(module_path: "std.machine_word", decl_name: "word_to_octets"),
    decl_ref(module_path: "extdeps.numeric.base16", decl_name: "base16_decode_lower"),
    decl_ref(module_path: "extdeps.crypto.sha2", decl_name: "sha256_hex")
  ]
{
  QualifiedOctets { members: members }
}

// The admission fold: the ONE route from raw Ints to the carried proof. It refuses on the FIRST
// out-of-range member and names the observed value, so the refusal is located rather than a count.
fn uint8_octets_of_ints(values: List<Int>) -> QualifiedOctetsResult {
  match first_uint8_out_of_range(remaining: values) {
    Present { value: observed } => QualifiedOctetsRefused { observed: observed }
    Absent => QualifiedOctetsReady { value: qualified_octets(members: values) }
  }
}

// The scan behind the fold. It carries no admitted prefix on purpose: a prefix formal is a value a
// caller can supply unproved, and the mint above must have nothing of that shape reachable from it.
fn first_uint8_out_of_range(remaining: List<Int>) -> Int? {
  match remaining.first() {
    Absent => Absent
    Present { value: head } =>
      match uint8_of_int(value: head) {
        UInt8OutOfRange { observed: o } => Present { value: o }
        UInt8Ready { value: _ } => first_uint8_out_of_range(remaining: remaining.skip(n: 1))
      }
  }
}

// The reader. It is total and needs no refusal: the carrier IS the proof, so there is nothing left to
// check, and that is the whole point of having made it a type.
fn qualified_octet_members(q: QualifiedOctets) -> List<Int> {
  q.members
}

type Signedness
  = Signed
  | Unsigned

type OverflowReturnValueRule
  = ReturnWrapping
  | ReturnSaturating

type IntegerOverflowSemantics<E>
  = OverflowReturns { value_rule: OverflowReturnValueRule }
  | OverflowRaises { effect: E }
  | OverflowUndefined

// P3b PR2 overflow authority: IntegerOverflowSemantics<E> separates return-value rules (wrapping vs
// saturating) from raise effects (parameter E — panic and trap are different inhabitants of E, not
// aliases for one arm) and from undefined overflow (its own arm — not a raise and not a return).
// Honest rung: accepted refinement with executing refusal at language admission boundaries;
// carriers are directly constructible until sole_constructor or a construction wall lands on E.
// v2.std.integer OverflowDisposition is the legacy conflated surface
// (Wrapping|Saturating|UndefinedBehavior|Trapping) — intentionally not migrated in this bounded PR
// per operator mandate (no corpus-wide overflow defork); feature:overflow-disposition-defork
// dissolve-on routes language overflow facts through this type and retires OverflowDisposition.
// Parallel authority is tracked debt with a named trigger, not permission to drift independently.

// std.nat Nat is the ONE declaration of the naturals (operator ruling A, 2026-09-30): the
// inductive carrier, realized as the kernel integer. The second declaration v2.std.nat carried, and
// the parallel nat_compare beside it, are gone, so a bare reference to Nat or nat_compare names one
// thing in every closure.

type IntPlatform  = Compose<Int,  MachineWidth<PointerWidth>>
type UIntPlatform = Compose<UInt, MachineWidth<PointerWidth>>

type NonNegativeInt = Nat
type PositiveInt    = Nat where gt_zero

fn uint8_channel_bit_width_int() -> Int {
  NonNegative { n: bit_width_count(b: bit_width(count: bits_per_byte())) }
}

fn uint8_channel_inclusive_max_value_derived() -> Int? {
  match int_pow_bounded(base: 2, exp: uint8_channel_bit_width_int()) {
    Present { value: two_pow } => Present { value: two_pow - 1 }
    Absent => none
  }
}

// THE UNITS DIGIT OF A MACHINE INTEGER'S MAGNITUDE, for EVERY Int. A value of ten or more steps
// down by ten and a value below minus nine steps up by ten (neither step changes the units digit of
// the magnitude), so the walk below receives only -9..9.
// The digit is CONSTRUCTED, never looked up: zero is D0 and each unit above it advances the digit
// through the one successor table in std.nat (a carry out of D9 wraps to D0, which IS the units
// digit of ten), and a value in -9..-1 is its own negation's digit (no overflow: its magnitude is
// at most nine). No Int-to-digit selection exists to be out of range and no default arm exists to
// answer one (DESIGN section 5: a failure arm must refuse, never widen; section 4b: construction
// over validation) -- -1 is D1, 9 is D9, 10 is D0, 99 is D9, each by derivation.
fn decimal_digit_of_units(value: Int) -> DecimalDigit {
  if value >= 10 {
    decimal_digit_of_units(value: value - 10)
  } else if value < -9 {
    decimal_digit_of_units(value: value + 10)
  } else if value < 0 {
    decimal_digit_of_units(value: 0 - value)
  } else if value == 0 {
    D0
  } else {
    decimal_digit_advance(d: decimal_digit_of_units(value: value - 1))
  }
}

fn decimal_digit_advance(d: DecimalDigit) -> DecimalDigit {
  match decimal_digit_successor(d: d) {
    DecimalDigitNext { digit: next } => next
    DecimalDigitCarry => D0
  }
}

// MACHINE INTEGER TO DECIMAL TEXT. Int realizes as the host integer, so host division and
// remainder are its declared operations (std.operator_realization HostOperator); the digit glyph
// comes from the one table in std.nat. It moved here from v2.std.integer so a seed-emitted dag
// module can name it (DESIGN section 3: a fact's home is its layer).
// EXACT AND LOSSLESS: the canonical decimal spelling (a leading "-" only for negatives, no leading
// zeros) is injective over Int, so this is the declared conversion an interpolation hole over an
// Int names (DESIGN section 4: no implicit stringify).
fn int_to_decimal_string(value: Int) -> String {
  if value < 0 {
    concat("-", int_digits_to_decimal_string(value: value))
  } else {
    int_digits_to_decimal_string(value: value)
  }
}

// DECIMAL TEXT TO MACHINE INTEGER: the one declared home of the ambient seed name parse_int (NAMESPACE-XL, a
// root-coordinator decision approved by sleek-owl-397), the partial inverse of int_to_decimal_string above. The
// result carries refusal, never a default: Present { value } when the whole text is an optional `+` or `-` followed
// by one or more ASCII decimal digits whose value fits the host integer, and Absent otherwise -- empty text, any other
// character (whitespace included, so a caller trims first), or an out-of-range magnitude. Its spelling is wider than
// int_to_decimal_string's image (a leading `+` and leading zeros parse), so it is a left inverse there, not a
// bijection. A pure declared operation whose host realization binds by THIS declaration's identity
// (std.primitive_projection primitive_parse_int, a HostRealizedSeam row; v1_rt::parse_int, Rust i64 FromStr), so
// the body is a self-call no realization ever reaches. The std.primitives parse_int_contract row that let the bare
// name resolve with no import is retired: a caller reaches it by `import std.integer { parse_int }`.
fn parse_int(s: String) -> Int? {
  parse_int(s: s)
}

// The digits of an Int's magnitude WITHOUT negating it: the minimum host integer has no
// representable negation, so the recursion divides the signed value by ten and reads each units
// digit through decimal_digit_of_units, which answers for either sign of remainder.
fn int_digits_to_decimal_string(value: Int) -> String {
  let rest = value / 10
  let digit = decimal_digit_glyph(d: decimal_digit_of_units(value: value - (rest * 10)))
  if rest == 0 {
    digit
  } else {
    concat(int_digits_to_decimal_string(value: rest), digit)
  }
}

// ---------------------------------------------------------------------------------------------
// THE ALGEBRA OVER Int: values over the carrier, not the carrier. Each operation is an explicit host
// terminal on the grounded kernel integer -- `+`, `-`, `*`, `/` and `<` on Int realize as the host operator
// for a carrier declared in a numeric-realization module (v1.compiler.coercion
// numeric_realization_declaring_modules), never by reading int_ordered_ring back -- so the record cannot
// form the cycle int_add -> + -> int_ordered_ring.add -> int_add. The record states which operations the
// ring IS made of; it is not by itself evidence that the machine operations satisfy the ring laws for every
// integer: they do so exactly where the realization admits them, and overflow refuses (the realization's
// boundary, gunbc.structural_realization_bindings).
// ---------------------------------------------------------------------------------------------

fn int_add(a: Int, b: Int) -> Int {
  a + b
}

fn int_negate(a: Int) -> Int {
  0 - a
}

// DIRECT, NOT a + (-b): on the overflow-refusing realization, negating the most negative machine integer
// refuses before any addition, so MIN - MIN and -1 - MIN -- whose answers 0 and MAX are representable --
// would refuse. Subtraction is its own refusing operation and refuses only where its answer is not.
fn int_sub(a: Int, b: Int) -> Int {
  a - b
}

fn int_mul(a: Int, b: Int) -> Int {
  a * b
}

fn int_div_result(a: Int, b: Int) -> Result<Int, DivError> {
  if b == 0 {
    Err { value: DivideByZero }
  } else {
    Ok { value: a / b }
  }
}

// INTEGER ORDER IS AN OPERATION, NOT THE CONSTRUCTORS' ORDER: Negative { pred: 2 } < Negative { pred: 1 } <
// NonNegative { n: 0 } (-3 < -2 < 0) by the values they denote, whatever order the arms are declared in.
fn int_compare(a: Int, b: Int) -> Ordering {
  if a < b {
    Less
  } else {
    if a == b {
      Equal
    } else {
      Greater
    }
  }
}

fn int_eq(a: Int, b: Int) -> Bool {
  match int_compare(a: a, b: b) {
    Less => false
    Equal => true
    Greater => false
  }
}

fn int_ne(a: Int, b: Int) -> Bool {
  match int_compare(a: a, b: b) {
    Less => true
    Equal => false
    Greater => true
  }
}

data int_ordered_ring: OrderedRing<Int> = OrderedRing {
  add: int_add,
  sub: int_sub,
  zero: 0,
  negate: int_negate,
  mul: int_mul,
  div: int_div_result,
  one: 1,
  order: TotalOrder { compare: int_compare },
  eq: int_eq,
  ne: int_ne
}

// ---------------------------------------------------------------------------------------------
// GroupCompletion<Nat> AS A CONSTRUCTION OF THE INTEGERS: a pair (pos, neg) denotes pos - neg, so many pairs
// denote one integer. The two mappings are NOT raw inverses: f(g(i)) = i, and g(f(pair)) = normalize(pair) --
// (2, 0) and (4, 2) both map to NonNegative { n: 2 }, and g gives the canonical pair back. A negative value's
// pair needs neg = pred + 1, so on the machine integer the most negative Int has no Nat to carry its pair and
// g refuses there (overflow-refusing arithmetic) rather than produce a wrong pair.
// ---------------------------------------------------------------------------------------------

// Each difference re-enters the naturals inside the branch that has established it is not negative,
// under std.nat nat_sub's discipline: pos - neg where pos >= neg, and neg - pos - 1 where neg > pos.
fn int_of_group_completion(g: GroupCompletion<Nat>) -> Int {
  if g.pos >= g.neg {
    NonNegative { n: g.pos - g.neg }
  } else {
    Negative { pred: g.neg - g.pos - 1 }
  }
}

fn group_completion_of_int(i: Int) -> GroupCompletion<Nat> {
  match i {
    NonNegative { n: n } => GroupCompletion { pos: n, neg: 0 }
    Negative { pred: p } => GroupCompletion { pos: 0, neg: p + 1 }
  }
}
