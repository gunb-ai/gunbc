module std.optional

import std.types { Bool }

type Optional<T>
  = Absent
  | Present { value: T }

fn optional_absent<T>() -> Optional<T> {
  Absent
}

fn optional_present<T>(value: T) -> Optional<T> {
  Present { value: value }
}

fn optional_prefer_first_present<T>(left: Optional<T>, right: Optional<T>) -> Optional<T> {
  match left {
    Present { value: _ } => left
    Absent => right
  }
}

fn optional_both_present_unequal<T>(left: Optional<T>, right: Optional<T>) -> Bool {
  match left {
    Absent => false
    Present { value: a } =>
      match right {
        Absent => false
        Present { value: b } => a != b
      }
  }
}
