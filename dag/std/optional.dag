module std.optional

type Optional<T>
  = Absent
  | Present { value: T }

fn optional_absent<T>() -> Optional<T> {
  Absent
}

fn optional_present<T>(value: T) -> Optional<T> {
  Present { value: value }
}

// Equality lifted through Optional: both absent, or both present with eq on the values. The Optional
// sibling of std.algebra zip_eq, for element types whose equality is a route rather than derived `==`.
fn optional_eq<T>(a: Optional<T>, b: Optional<T>, eq: fn(T, T) -> Bool) -> Bool {
  match a {
    Absent =>
      match b {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: x } =>
      match b {
        Absent => false
        Present { value: y } => eq(x, y)
      }
  }
}

fn optional_prefer_first_present<T>(left: Optional<T>, right: Optional<T>) -> Optional<T> {
  match left {
    Present { value: _ } => left
    Absent => right
  }
}
