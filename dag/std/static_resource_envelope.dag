module std.static_resource_envelope

import std.types { Bool }
import std.nat { Nat, nat_min, nat_max }
import std.measure {
  Measure,
  ByteSize,
  byte_size,
  DiskSize,
  disk_size,
  HardwareThreadCount,
  hardware_thread_count,
  Watt,
  watt,
  measure_saturating_sub,
  measure_fit_count_floor,
}

type DemandProvenance
  = StaticDerived
  | Measured
  | ConvergedState
  | Fixture

type ResourceAxis
  = MemoryAxis
  | ComputeAxis
  | StorageAxis
  | EnergyAxis

type StaticPeakDemand {
  memory: ByteSize
  compute: HardwareThreadCount
  storage: DiskSize
  energy: Watt
  provenance: DemandProvenance
}

type ResourceCap {
  memory: ByteSize
  compute: HardwareThreadCount
  storage: DiskSize
  energy: Watt
}

type WidthVerdict {
  width: Nat
  binding_axis: ResourceAxis
}

fn zero_demand() -> StaticPeakDemand {
  StaticPeakDemand {
    memory: byte_size(0),
    compute: hardware_thread_count(0),
    storage: disk_size(0),
    energy: watt(0),
    provenance: StaticDerived
  }
}

fn demand_admitted_for_production(demand: StaticPeakDemand) -> Bool {
  match demand.provenance {
    Fixture => false
    StaticDerived => true
    Measured => true
    ConvergedState => true
  }
}

fn axis_derived_width<Q, S>(
  cap: Measure<Q, S, Nat>,
  base: Measure<Q, S, Nat>,
  per_shard: Measure<Q, S, Nat>,
  unconstrained: Nat
) -> Nat {
  if per_shard.count == 0 {
    unconstrained
  } else {
    let available = measure_saturating_sub(a: cap, b: base)
    measure_fit_count_floor(capacity: available, each: per_shard)
  }
}

fn shard_demand_positive(shard_demand: Nat) -> Nat {
  nat_max(a: shard_demand, b: 1)
}

fn unconstrained_width() -> Nat {
  1000000
}

fn derive_spawn_width(
  cap: ResourceCap,
  base: StaticPeakDemand,
  per_shard: StaticPeakDemand,
  shard_demand: Nat
) -> WidthVerdict {
  let u = unconstrained_width()
  let w_memory = axis_derived_width(cap: cap.memory, base: base.memory, per_shard: per_shard.memory, unconstrained: u)
  let w_compute = axis_derived_width(cap: cap.compute, base: base.compute, per_shard: per_shard.compute, unconstrained: u)
  let w_storage = axis_derived_width(cap: cap.storage, base: base.storage, per_shard: per_shard.storage, unconstrained: u)
  let w_energy = axis_derived_width(cap: cap.energy, base: base.energy, per_shard: per_shard.energy, unconstrained: u)

  let binding_axis = if w_memory <= w_compute && w_memory <= w_storage && w_memory <= w_energy { MemoryAxis }
    else if w_compute <= w_storage && w_compute <= w_energy { ComputeAxis }
    else if w_storage <= w_energy { StorageAxis }
    else { EnergyAxis }

  let axis_bound = nat_min(a: nat_min(a: w_memory, b: w_compute), b: nat_min(a: w_storage, b: w_energy))
  let width = nat_min(a: axis_bound, b: shard_demand_positive(shard_demand: shard_demand))

  WidthVerdict { width: width, binding_axis: binding_axis }
}

fn envelope_reconciled(
  cap: ResourceCap,
  base: StaticPeakDemand,
  per_shard: StaticPeakDemand,
  scheduled_width: Nat
) -> Bool {
  axis_fits(cap: cap.memory, base: base.memory, per_shard: per_shard.memory, width: scheduled_width)
    && axis_fits(cap: cap.compute, base: base.compute, per_shard: per_shard.compute, width: scheduled_width)
    && axis_fits(cap: cap.storage, base: base.storage, per_shard: per_shard.storage, width: scheduled_width)
    && axis_fits(cap: cap.energy, base: base.energy, per_shard: per_shard.energy, width: scheduled_width)
}

fn axis_fits<Q, S>(
  cap: Measure<Q, S, Nat>,
  base: Measure<Q, S, Nat>,
  per_shard: Measure<Q, S, Nat>,
  width: Nat
) -> Bool {
  (base.count + (width * per_shard.count)) <= cap.count
}
