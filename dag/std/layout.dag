module std.layout

import std.render_repeat_string_bootstrap { repeat_string }

type Doc
  = DocEmpty
  | DocText { text: String }
  | DocLine
  | DocConcat { parts: List<Doc> }
  | DocNest { levels: Int, body: Doc }
  | DocNestBy { unit: String, body: Doc }

type LayoutProtocol {
  indent_unit: String
}

type RenderState {
  out: String
  at_line_start: Bool
}

fn doc_text(text: String) -> Doc {
  DocText { text: text }
}

fn doc_concat(parts: List<Doc>) -> Doc {
  DocConcat { parts: parts }
}

fn doc_nest(levels: Int, body: Doc) -> Doc {
  DocNest { levels: levels, body: body }
}

fn doc_line_of(text: String) -> Doc {
  DocConcat { parts: [DocText { text: text }, DocLine] }
}

fn doc_blank() -> Doc {
  DocLine
}

// DocNestBy is DocNest with the unit named by the producer rather than the protocol: a document
// assembled from a target's grammar rows nests by the unit that TARGET spells, so the one render
// needs no target-specific protocol. Like DocNest it is a tree, so a block cannot be left open.
fn doc_is_empty(doc: Doc) -> Bool {
  match doc {
    DocEmpty => true
    DocText { text: t } => t == ""
    DocLine => false
    DocConcat { parts: parts } => fold(parts, init: true, f: (acc, part) => acc && doc_is_empty(doc: part))
    DocNest { levels: _, body: body } => doc_is_empty(doc: body)
    DocNestBy { unit: _, body: body } => doc_is_empty(doc: body)
  }
}

fn render_go(doc: Doc, indent: String, proto: LayoutProtocol, st: RenderState) -> RenderState {
  match doc {
    DocEmpty => st
    DocText { text: t } =>
      if t == "" {
        st
      } else if st.at_line_start {
        RenderState { out: concat(concat(st.out, indent), t), at_line_start: false }
      } else {
        RenderState { out: concat(st.out, t), at_line_start: false }
      }
    DocLine => RenderState { out: concat(st.out, "\n"), at_line_start: true }
    DocConcat { parts: parts } =>
      fold(parts, init: st, f: (acc, part) => render_go(doc: part, indent: indent, proto: proto, st: acc))
    DocNest { levels: n, body: body } => render_go(doc: body, indent: concat(indent, repeat_string(s: proto.indent_unit, n: n)), proto: proto, st: st)
    DocNestBy { unit: u, body: body } => render_go(doc: body, indent: concat(indent, u), proto: proto, st: st)
  }
}

fn render(doc: Doc, proto: LayoutProtocol) -> String {
  render_go(doc: doc, indent: "", proto: proto, st: RenderState { out: "", at_line_start: true }).out
}
