module std.layout

import std.render_repeat_string_bootstrap { repeat_string }

type Doc
  = DocEmpty
  | DocText { text: String }
  | DocLine
  | DocConcat { parts: List<Doc> }
  | DocNest { indent: NestIndent, body: Doc }

// ONE NEST, TWO SOURCES FOR WHAT IT INDENTS BY. A document built against a LayoutProtocol nests by
// levels of the protocol's unit; a document assembled from a target's grammar rows nests by the unit
// that TARGET spells (v2.std.compilers.target_model target_text_nested), because one render serves
// every target and no single protocol knows each target's unit. Either way the nest is a tree, so a
// block cannot be left open.
type NestIndent
  = ProtocolIndent { levels: Int }
  | SpelledIndent { unit: String }

type LayoutProtocol {
  indent_unit: String
}

type RenderState {
  out: String
  at_line_start: Bool
}

fn doc_text(text: String) -> Doc {
  DocText { text: text }
}

fn doc_concat(parts: List<Doc>) -> Doc {
  DocConcat { parts: parts }
}

fn doc_nest(levels: Int, body: Doc) -> Doc {
  DocNest { indent: ProtocolIndent { levels: levels }, body: body }
}

fn doc_nest_by(unit: String, body: Doc) -> Doc {
  DocNest { indent: SpelledIndent { unit: unit }, body: body }
}

fn nest_indent_text(indent: NestIndent, proto: LayoutProtocol) -> String {
  match indent {
    ProtocolIndent { levels: n } => repeat_string(s: proto.indent_unit, n: n)
    SpelledIndent { unit: u } => u
  }
}

fn doc_line_of(text: String) -> Doc {
  DocConcat { parts: [DocText { text: text }, DocLine] }
}

fn doc_blank() -> Doc {
  DocLine
}

fn render_go(doc: Doc, indent: String, proto: LayoutProtocol, st: RenderState) -> RenderState {
  match doc {
    DocEmpty => st
    DocText { text: t } =>
      if t == "" {
        st
      } else if st.at_line_start {
        RenderState { out: concat(concat(st.out, indent), t), at_line_start: false }
      } else {
        RenderState { out: concat(st.out, t), at_line_start: false }
      }
    DocLine => RenderState { out: concat(st.out, "\n"), at_line_start: true }
    DocConcat { parts: parts } =>
      fold(parts, init: st, f: (acc, part) => render_go(doc: part, indent: indent, proto: proto, st: acc))
    DocNest { indent: by, body: body } => render_go(doc: body, indent: concat(indent, nest_indent_text(indent: by, proto: proto)), proto: proto, st: st)
  }
}

fn render(doc: Doc, proto: LayoutProtocol) -> String {
  render_go(doc: doc, indent: "", proto: proto, st: RenderState { out: "", at_line_start: true }).out
}
