fn primitive_identity_lookup(
  authority: PrimitiveSurfaceAuthority,
  authored_symbol: String,
) -> PrimitiveIdentity? {
  primitive_d0_surface_alias_bindings
    |> fold(init: none, f: fn(acc, binding) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if binding.authority == authority
            && (binding.authored_symbol as String) == authored_symbol {
            Present { value: binding.identity }
          } else {
            none
          }
      }
    })
}

data primitive_identity_for_symbol_note: String = "The census join. It asks the D0 surface-scoped alias table first, then the DECLARED population by canonical name. The second arm is not a spelling rule: an authored symbol joins only if a PrimitiveDefinition for that canonical name has been declared in primitive_declared_definitions, so a surface that grows a new symbol nobody has declared stays UNJOINED and is counted by primitive_undisposed_surface_symbol_count rather than being admitted on the strength of matching itself."

fn primitive_identity_for_symbol(
  authority: PrimitiveSurfaceAuthority,
  authored_symbol: String,
) -> PrimitiveIdentity? {
  match primitive_identity_lookup(authority: authority, authored_symbol: authored_symbol) {
    Present { value: id } => Present { value: id }
    Absent => primitive_identity_for_canonical_name(authored_symbol: authored_symbol)
  }
}

fn registry_contains_symbol(sym: String) -> Bool {
  builtin_registry_surface_names() |> any(name => name == sym)
}

fn algebra_contains_template_name(name: String) -> Bool {
  all_algebra_template_names() |> any(template_name => template_name == name)
}

fn emit_contains_symbol(sym: String) -> Bool {
  rt_function_registry |> any(entry => entry.name == sym)
}

fn contract_contains_name(name: String) -> Bool {
  primitive_contract_roster() |> any(contract => contract.name == name)
}

fn primitive_registry_surface_rows() -> List<PrimitiveSurfaceRow> {
  builtin_registry_surface_names()
    |> map(sym =>
      surface_row(
        authority: BuiltinRegistry,
        authored_symbol: sym,
        authority_ref: decl_ref(module_path: "std.primitives", decl_name: "builtin_registry_surface_names"),
        primitive: primitive_identity_for_symbol(authority: BuiltinRegistry, authored_symbol: sym),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_contract_surface_rows() -> List<PrimitiveSurfaceRow> {
  primitive_contract_roster()
    |> map(contract =>
      surface_row(
        authority: PrimitiveContractRow,
        authored_symbol: contract.name,
        authority_ref: decl_field_ref(
          module_path: "std.primitives",
          decl_name: concat(contract.name, "_contract"),
          field_name: "name",
        ),
        primitive: primitive_identity_for_symbol(
          authority: PrimitiveContractRow,
          authored_symbol: contract.name,
        ),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_algebra_surface_rows() -> List<PrimitiveSurfaceRow> {
  all_algebra_field_templates()
    |> map(template =>
      surface_row(
        authority: AlgebraTemplate,
        authored_symbol: template.name,
        authority_ref: decl_ref(module_path: "std.algebra", decl_name: "all_algebra_field_templates"),
        primitive: primitive_identity_for_symbol(authority: AlgebraTemplate, authored_symbol: template.name),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_emit_surface_rows() -> List<PrimitiveSurfaceRow> {
  rt_function_registry
    |> map(entry =>
      surface_row(
        authority: EmitHandler,
        authored_symbol: entry.name,
        authority_ref: decl_ref(module_path: "extdeps.languages.rust.emit", decl_name: "rt_function_registry"),
        primitive: primitive_identity_for_symbol(authority: EmitHandler, authored_symbol: entry.name),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_interpreter_surface_rows() -> List<PrimitiveSurfaceRow> {
  v1_interpreter_primitive_arms()
    |> map(arm =>
      surface_row(
        authority: InterpreterDispatch,
        authored_symbol: arm.authored_spelling as String,
        authority_ref: decl_ref(
          module_path: "gunbc.v1_interpreter_primitive_surface",
          decl_name: "v1_interpreter_primitive_arms",
        ),
        primitive: primitive_identity_for_symbol(
          authority: InterpreterDispatch,
          authored_symbol: arm.authored_spelling as String,
        ),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_surface_census_derived() -> List<PrimitiveSurfaceRow> {
  concat(
    concat(
      concat(
        concat(
          primitive_registry_surface_rows(),
          primitive_contract_surface_rows()
        ),
        primitive_algebra_surface_rows()
      ),
      primitive_emit_surface_rows()
    ),
    primitive_interpreter_surface_rows()
  )
}

fn primitive_d0_surface_census() -> List<PrimitiveSurfaceRow> {
  primitive_surface_census_derived()
}

data primitive_map_keys_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_map_keys,
  order: HostUnspecifiedOrder,
}

data primitive_sorted_map_keys_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_sorted_map_keys,
  order: CanonicalOrder,
}

// The traversal fact is the choice between the two key-list constructors at the
// mandatory determinism gate: map_keys exposes host map order, while
// sorted_map_keys sorts by K's declared Ord. Before the sorted primitive joined
// PrimitiveIdentity, its green witness was acceptance by non-membership rather
// than an answered order classification. This wall does not claim map_keys caused
// the emitter's observed byte drift; the corpus sweep found no such path.

data primitive_map_values_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_map_values,
  order: HostUnspecifiedOrder,
}

data primitive_fold_list_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_fold_list,
  order: SourcePreservingOrder,
}

data primitive_index_by_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_index_by,
  order: TraversalOrderUnclassified,
}

data primitive_d0_traversal_facts: List<PrimitiveTraversalOrderFact> = [
  primitive_map_keys_traversal,
  primitive_sorted_map_keys_traversal,
  primitive_map_values_traversal,
  primitive_fold_list_traversal,
  primitive_index_by_traversal,
]

data primitive_map_keys_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_map_keys,
  cost: ShapeLinearScan,
}

data primitive_sorted_map_keys_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_sorted_map_keys,
  cost: ShapeSortBody,
}

data primitive_map_values_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_map_values,
  cost: ShapeLinearScan,
}

data primitive_fold_list_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_fold_list,
  cost: ShapeIterateBody,
}

data primitive_index_by_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_index_by,
  cost: ShapeIterateBody,
}

fn primitive_surface_missing_identity_violation(row: PrimitiveSurfaceRow) -> PrimitiveJoinViolation? {
  match row.primitive {
    Present { value: _ } => none
    Absent =>
      Present {
        value: SurfaceMissingPrimitiveIdentity {
          authority: row.authority,
          authored_symbol: row.authored_symbol,
        },
      }
  }
}

fn primitive_surface_row_identity_violation(
  row: PrimitiveSurfaceRow,
  expected: PrimitiveIdentity,
) -> PrimitiveJoinViolation? {
  match row.primitive {
    Present { value: id } =>
      if primitive_identity_eq(left: id, right: expected) {
        none
      } else {
        Present {
          value: IncompatibleInvocationAssignment {
            authored_symbol: row.authored_symbol,
            first: id,
            second: expected,
          },
        }
      }
    Absent =>
      Present {
        value: SurfaceMissingPrimitiveIdentity {
          authority: row.authority,
          authored_symbol: row.authored_symbol,
        },
      }
  }
}

fn primitive_surface_joins_two_identities_violation(
  left: PrimitiveSurfaceRow,
  right: PrimitiveSurfaceRow,
) -> PrimitiveJoinViolation? {
  if (left.authored_symbol as String) != (right.authored_symbol as String) {
    none
  } else {
    match left.primitive {
      Present { value: first } =>
        match right.primitive {
          Present { value: second } =>
            if primitive_identity_eq(left: first, right: second) {
              none
            } else if left.authority == right.authority {
              Present {
                value: SurfaceJoinsTwoIdentities {
                  authority: left.authority,
                  authored_symbol: left.authored_symbol,
                  first: first,
                  second: second,
                },
              }
            } else {
              Present {
                value: IncompatibleInvocationAssignment {
                  authored_symbol: left.authored_symbol,
                  first: first,
                  second: second,
                },
              }
            }
          Absent => none
        }
      Absent => none
    }
  }
}

fn primitive_incompatible_invocation_assignment_violation(
  authored_symbol: String,
  first: PrimitiveIdentity,
  second: PrimitiveIdentity,
) -> PrimitiveJoinViolation? {
  if primitive_identity_eq(left: first, right: second) {
    none
  } else {
    Present {
      value: IncompatibleInvocationAssignment {
        authored_symbol: authored_symbol as NonEmptyStr,
        first: first,
        second: second,
      },
    }
  }
}

fn primitive_surface_rows_missing_identity_violations(
  rows: List<PrimitiveSurfaceRow>
) -> List<PrimitiveJoinViolation> {
  rows |> fold(init: [], f: fn(acc, row) {
    match primitive_surface_missing_identity_violation(row: row) {
      Present { value: violation } => concat([violation], acc)
      Absent => acc
    }
  })
}

fn primitive_definition_identity(definition: PrimitiveDefinition) -> PrimitiveIdentity {
  definition.identity
}

fn primitive_duplicate_semantic_definition_violation(
  definitions: List<PrimitiveDefinition>,
  target: PrimitiveIdentity
) -> PrimitiveJoinViolation? {
  if count(
    definitions |> filter(fn(d) { primitive_identity_eq(left: d.identity, right: target) })
  ) > 1 {
    Present { value: DuplicateSemanticDefinition { identity: target } }
  } else {
    none
  }
}

fn primitive_realization_unknown_primitive_violation(
  realization: PrimitiveRealization,
  definitions: List<PrimitiveDefinition>
) -> PrimitiveJoinViolation? {
  let known = definitions
    |> any(fn(d) { primitive_identity_eq(left: d.identity, right: realization.primitive) })
  if known {
    none
  } else {
    Present {
      value: RealizationNamesUnknownPrimitive {
        target: realization.target,
        handler: realization.handler,
      },
    }
  }
}

fn primitive_d0_derived_rows_missing_identity_count() -> Int {
  count(primitive_surface_rows_missing_identity_violations(rows: primitive_surface_census_derived()))
}

fn primitive_d0_interpreter_surface_row_count() -> Int {
  count(primitive_interpreter_surface_rows())
}

fn primitive_d0_interpreter_census_matches_roster() -> Bool {
  primitive_d0_interpreter_surface_row_count() == v1_interpreter_row_count()
}

fn primitive_d0_open_denominator_receipt_holds() -> Bool {
  primitive_d0_derived_surface_authority_count == 5
    && primitive_d0_open_surface_authority_count == 0
    && primitive_d0_interpreter_census_matches_roster()
    && primitive_d0_derived_rows_missing_identity_count() > 0
}

fn primitive_d0_surface_census_row_count() -> Int {
  count(primitive_d0_surface_census())
}

fn primitive_d0_surface_census_derived_row_count() -> Int {
  count(primitive_surface_census_derived())
}

fn primitive_d0_surface_census_missing_identity_count() -> Int {
  count(primitive_surface_rows_missing_identity_violations(rows: primitive_d0_surface_census()))
}

fn primitive_d0_surface_census_rows_for(
  authority: PrimitiveSurfaceAuthority,
  authored_symbol: String,
) -> List<PrimitiveSurfaceRow> {
  primitive_d0_surface_census()
    |> filter(fn(row) {
      row.authority == authority && (row.authored_symbol as String) == authored_symbol
    })
}

fn primitive_d0_surface_census_row_identity_coherent(
  authority: PrimitiveSurfaceAuthority,
  authored_symbol: String,
  expected: PrimitiveIdentity,
) -> Bool {
  let rows = primitive_d0_surface_census_rows_for(
    authority: authority,
    authored_symbol: authored_symbol,
  )
  count(rows) == 1
    && match rows |> first {
      Present { value: row } =>
        match primitive_surface_row_identity_violation(row: row, expected: expected) {
          Absent => true
          Present { value: _ } => false
        }
      Absent => false
    }
}

fn primitive_d0_fold_list_spelling_fork_holds() -> Bool {
  primitive_d0_surface_census_row_identity_coherent(
    authority: PrimitiveContractRow,
    authored_symbol: "fold",
    expected: primitive_fold_list,
  )
    && primitive_d0_surface_census_row_identity_coherent(
      authority: InterpreterDispatch,
      authored_symbol: "fold_list",
      expected: primitive_fold_list,
    )
    && !registry_contains_symbol(sym: "fold_list")
}

fn primitive_d0_index_by_registry_algebra_gap_holds() -> Bool {
  !registry_contains_symbol(sym: "index_by")
    && !algebra_contains_template_name(name: "index_by")
    && contract_contains_name(name: "index_by")
    && emit_contains_symbol(sym: "index_by")
}

fn primitive_d0_fold_list_registry_gap_holds() -> Bool {
  !registry_contains_symbol(sym: "fold_list")
    && primitive_d0_surface_census_row_identity_coherent(
      authority: InterpreterDispatch,
      authored_symbol: "fold_list",
      expected: primitive_fold_list,
    )
}

fn primitive_d0_authority_map_keys_rows_coherent(authority: PrimitiveSurfaceAuthority) -> Bool {
  let rows = primitive_d0_surface_census()
    |> filter(fn(row) {
      row.authority == authority && (row.authored_symbol as String) == "map_keys"
    })
  count(rows) >= 1
    && rows |> all(fn(row) {
      match primitive_surface_row_identity_violation(row: row, expected: primitive_map_keys) {
        Absent => true
        Present { value: _ } => false
      }
    })
}

fn primitive_d0_map_keys_five_surface_join_holds() -> Bool {
  primitive_d0_authority_map_keys_rows_coherent(authority: BuiltinRegistry)
    && primitive_d0_authority_map_keys_rows_coherent(authority: PrimitiveContractRow)
    && primitive_d0_authority_map_keys_rows_coherent(authority: AlgebraTemplate)
    && primitive_d0_authority_map_keys_rows_coherent(authority: EmitHandler)
    && primitive_d0_authority_map_keys_rows_coherent(authority: InterpreterDispatch)
}

fn primitive_d0_interpreter_rows_are_from_authority() -> Bool {
  primitive_interpreter_surface_rows()
    |> all(fn(row) { row.provenance == DerivedFromAuthority })
}

fn primitive_d0_derived_rows_are_from_authority() -> Bool {
  primitive_surface_census_derived()
    |> all(fn(row) { row.provenance == DerivedFromAuthority })
}

fn primitive_d0_host_unspecified_traversal_classified() -> Bool {
  primitive_d0_traversal_facts
    |> all(fn(fact) {
      if primitive_identity_eq(left: fact.primitive, right: primitive_map_keys)
        || primitive_identity_eq(left: fact.primitive, right: primitive_map_values) {
        fact.order == HostUnspecifiedOrder
      } else {
        true
      }
    })
}

type PrimitiveJoinProjectionViolation
  = ProjectionNamesUnknownPrimitive {
      declaration: DeclarationRef
      identity: PrimitiveIdentity
    }
  | DuplicateProjectionForDeclaration { declaration: DeclarationRef }

data primitive_declared_population_note: String = "The declared semantic-primitive population. It is the join's denominator: a projection row or a surface row naming an identity that is not declared here REFUSES rather than being admitted on the strength of its spelling. It is NOT yet the whole primitive vocabulary -- primitive_undisposed_surface_symbol_count measures what is still undeclared, and the roadmap node primitive-identity-join keeps population-wide closure as its terminal bar."

fn primitive_definition_of(name: String) -> PrimitiveDefinition {
  PrimitiveDefinition {
    identity: primitive_identity_slug(name: name),
    semantic_contract: PrimitiveSemanticContract {
      canonical_name: name as NonEmptyStr,
      signature: SignatureUngrounded {
        reason: "projection-target identity minted by canonical name alone; no algebra profile is known for it at this grain, and picking one would be a guess." as NonEmptyStr
      },
    },
  }
}

data primitive_projection_target_canonical_names: List<String> = [
  "length",
  "map_insert",
  "map_get",
  "empty_map",
  "decl_facts",
  "export_signature_facts",
  "data_decl_type_facts",
  "concept_decl_facts",
  "concept_decl_facts_live",
]

fn primitive_declared_definitions() -> List<PrimitiveDefinition> {
  concat(
    primitive_d0_definitions,
    primitive_projection_target_canonical_names |> map(name => primitive_definition_of(name: name))
  )
}

fn primitive_identity_is_declared(identity: PrimitiveIdentity) -> Bool {
  primitive_declared_definitions()
    |> any(fn(d) { primitive_identity_eq(left: d.identity, right: identity) })
}

data primitive_projection_query_note: String = "The question a candidate collector asks, and it is TOTAL: every DeclarationRef gets an answer. Absence and divergence are different states at the consumer, which is the distinction a boolean suppress flag could not carry.

AND ABSENCE ITSELF IS TWO STATES, NOT ONE -- the top-as-answer / top-as-ignorance split, in the arm where it is most expensive. DeclarationProjectsNoPrimitive means CLASSIFIED: no primitive-bearing surface carries this declaration's name at all, so no builtin co-candidate can exist and a consumer may treat two candidates as two authorities. DeclarationPrimitiveUndisposed means UNCLASSIFIED: a surface does carry the name, but nobody has declared whether this declaration projects it. Collapsing them would hand a consumer one answer meaning both -this is genuinely not a projection- and -I do not know-, and at a candidate-resolution wall the ignorance arm lands on the REFUSING side: measured at the time of writing, 13 symbols are disposed against 196 undisposed, so the collapsed answer is the shortest path to a corpus-wide false-refusal storm. Requested by gunbc#8952, which consumes this query, and correct independently of that consumer.

The discrimination is DERIVED, not declared: it asks whether the five-surface census carries the declaration's name, so it stays right as the disposition population grows without anyone maintaining a second list."

fn primitive_surface_carries_symbol(authored_symbol: String) -> Bool {
  primitive_surface_census_derived()
    |> any(fn(row) { (row.authored_symbol as String) == authored_symbol })
}

fn primitive_projection_for_declaration(declaration: DeclarationRef) -> PrimitiveProjectionAnswer {
  match primitive_projection_row_for_declaration(declaration: declaration) {
    Present { value: row } =>
      DeclarationProjectsPrimitive { identity: row.primitive, fidelity: row.fidelity }
    Absent =>
      if primitive_surface_carries_symbol(authored_symbol: declaration.decl_name as String) {
        DeclarationPrimitiveUndisposed { authored_symbol: declaration.decl_name }
      } else {
        DeclarationProjectsNoPrimitive
      }
  }
}

fn projection_fidelity_is_one_authority(fidelity: ProjectionFidelity) -> Bool {
  match fidelity {
    HostRealizedSeam => true
    ModeledProjection => true
    DivergentProjection { divergence: _ } => false
  }
}

fn declaration_and_primitive_are_one_authority(
  declaration: DeclarationRef,
  primitive: PrimitiveIdentity,
) -> Bool {
  match primitive_projection_for_declaration(declaration: declaration) {
    DeclarationProjectsNoPrimitive => false
    DeclarationPrimitiveUndisposed { authored_symbol: _ } => false
    DeclarationProjectsPrimitive { identity: id, fidelity: fidelity } =>
      primitive_identity_eq(left: id, right: primitive)
        && projection_fidelity_is_one_authority(fidelity: fidelity)
  }
}

fn primitive_projection_unknown_primitive_violations_in(
  rows: List<PrimitiveProjection>
) -> List<PrimitiveJoinProjectionViolation> {
  rows
    |> fold(init: [], f: fn(acc, row) {
      if primitive_identity_is_declared(identity: row.primitive) {
        acc
      } else {
        concat(
          [ProjectionNamesUnknownPrimitive { declaration: row.declaration, identity: row.primitive }],
          acc
        )
      }
    })
}

fn primitive_projection_declaration_row_count_in(
  rows: List<PrimitiveProjection>,
  declaration: DeclarationRef,
) -> Int {
  count(
    rows
      |> filter(fn(row) { declaration_ref_eq(a: row.declaration, b: declaration) })
  )
}

fn primitive_projection_duplicate_declaration_violations_in(
  rows: List<PrimitiveProjection>
) -> List<PrimitiveJoinProjectionViolation> {
  rows
    |> fold(init: [], f: fn(acc, row) {
      if primitive_projection_declaration_row_count_in(rows: rows, declaration: row.declaration) > 1 {
        concat([DuplicateProjectionForDeclaration { declaration: row.declaration }], acc)
      } else {
        acc
      }
    })
}

fn primitive_projection_violation_count_in(rows: List<PrimitiveProjection>) -> Int {
  count(primitive_projection_unknown_primitive_violations_in(rows: rows))
    + count(primitive_projection_duplicate_declaration_violations_in(rows: rows))
}

fn primitive_projection_violation_count() -> Int {
  primitive_projection_violation_count_in(rows: primitive_projection_roster())
}

fn primitive_projection_roster_row_count() -> Int {
  count(primitive_projection_roster())
}

fn primitive_projection_one_authority_row_count() -> Int {
  count(
    primitive_projection_roster()
      |> filter(fn(row) { projection_fidelity_is_one_authority(fidelity: row.fidelity) })
  )
}

fn primitive_projection_divergent_row_count() -> Int {
  count(
    primitive_projection_roster()
      |> filter(fn(row) { !projection_fidelity_is_one_authority(fidelity: row.fidelity) })
  )
}

// ---------------------------------------------------------------------------
// Typed, counted residue: what the population-wide join has NOT disposed of
// ---------------------------------------------------------------------------

data primitive_undisposed_residue_note: String = "What remains is a COUNTED DISPOSITION at symbol grain, not a sentence. A prose 'the denominator is still open' has no size, so it never ranks for closing; primitive_surface_symbol_dispositions enumerates every distinct authored symbol on the five-surface census as either SymbolJoinsDeclaredPrimitive or SymbolUndisposed, and primitive_undisposed_surface_symbol_count is a number the next session re-derives by running it. TERMINAL BAR, unchanged and owned by roadmap node primitive-identity-join: primitive_undisposed_surface_symbol_count reaches zero, at which point every surface row joins exactly one declared identity. This carrier does NOT claim that bar; it makes the distance to it observable."

type PrimitiveSymbolDisposition
  = SymbolJoinsDeclaredPrimitive {
      authored_symbol: NonEmptyStr
      identity: PrimitiveIdentity
    }
  | SymbolUndisposed { authored_symbol: NonEmptyStr }

fn primitive_surface_distinct_symbols() -> List<String> {
  primitive_surface_census_derived()
    |> fold(init: [], f: fn(acc, row) {
      let sym = row.authored_symbol as String
      if acc |> any(seen => seen == sym) {
        acc
      } else {
        concat(acc, [sym])
      }
    })
}

fn primitive_symbol_disposition(authored_symbol: String) -> PrimitiveSymbolDisposition {
  if primitive_identity_is_declared(identity: primitive_identity_slug(name: authored_symbol)) {
    SymbolJoinsDeclaredPrimitive {
      authored_symbol: authored_symbol as NonEmptyStr,
      identity: primitive_identity_slug(name: authored_symbol),
    }
  } else {
    SymbolUndisposed { authored_symbol: authored_symbol as NonEmptyStr }
  }
}

fn primitive_surface_symbol_dispositions() -> List<PrimitiveSymbolDisposition> {
  primitive_surface_distinct_symbols()
    |> map(sym => primitive_symbol_disposition(authored_symbol: sym))
}

fn primitive_symbol_disposition_is_undisposed(d: PrimitiveSymbolDisposition) -> Bool {
  match d {
    SymbolJoinsDeclaredPrimitive { authored_symbol: _, identity: _ } => false
    SymbolUndisposed { authored_symbol: _ } => true
  }
}

fn primitive_surface_distinct_symbol_count() -> Int {
  count(primitive_surface_distinct_symbols())
}

fn primitive_undisposed_surface_symbol_count() -> Int {
  count(
    primitive_surface_symbol_dispositions()
      |> filter(fn(d) { primitive_symbol_disposition_is_undisposed(d: d) })
  )
}

fn primitive_disposed_surface_symbol_count() -> Int {
  count(
    primitive_surface_symbol_dispositions()
      |> filter(fn(d) { !primitive_symbol_disposition_is_undisposed(d: d) })
  )
}

// ---------------------------------------------------------------------------
// The other direction: given a SYMBOL on a surface, does any runtime row join it?
// ---------------------------------------------------------------------------

data primitive_runtime_coverage_note: String = "The projection query asks, of a DECLARATION, which primitive it projects. This asks the opposite and the two catch different defects. A primitive registered on the typecheck surface with NO row on any runtime-bearing surface typechecks clean at every call site and answers NoSuchFunction when one is actually evaluated -- the class gunbc#8952 found in emit_map_has by probing, where every one of its 21 live call sites happened to reach a same-named declaration through its own import closure so nobody noticed. The projection direction is blind to it BY CONSTRUCTION, because the defect is a primitive with no declaration rather than a declaration with a divergent primitive.

WHAT THIS ANSWERS AND WHAT IT DOES NOT, AND IT IS THE SAME NAMED CLASS AS THE PROJECTION QUERY'S ABSENCE SPLIT, ONE LAYER DOWN. RuntimeRowAbsentFromEnumeratedSurfaces is top-as-answer about the DENOMINATOR -- nothing on the runtime-bearing surfaces of the derived census joins this symbol. It is NOT top-as-answer about the INTERPRETER -- 'no runtime exists' is a different and stronger claim this carrier cannot make, because a dispatch site the interpreter roster does not enumerate is invisible here exactly as it is invisible to every other consumer of that roster, which is the standing limit gunbc.v1_interpreter_primitive_surface records for itself. So the answer is a CANDIDATE SET, never a defect count: a consumer that reads it as the latter has performed the same conflation primitive_projection_query_note refuses in the projection direction.

THE ARM IS NAMED FOR WHAT IT MEASURES, WHICH IS WHY IT IS NOT CALLED NoRuntimeRow. absence-of-OBSERVATION and observation-of-ABSENCE are two states with opposite repairs -- the first is closed by enumerating a dispatch site on the roster, the second by supplying a runtime -- and a name that spells the first while reading as the second hands every consumer the conflation for free. RuntimeRowAbsentFromEnumeratedSurfaces says the rosters do not enumerate this; it does not say nothing runs it. to_int and with are exactly the symbols where that distinction decides whether someone files a defect against a live method-dispatch path. Carried as a TYPE rather than a caveat deliberately: a caveat is read later as hedging and dropped, a variant has to be named to compile."

type PrimitiveSurfaceRuntimeCoverage
  = RuntimeRowOnInterpreterDispatch
  | RuntimeRowOnEmitHandlerOnly
  | RuntimeRowAbsentFromEnumeratedSurfaces

fn surface_rows_carry_symbol_on(
  rows: List<PrimitiveSurfaceRow>,
  authority: PrimitiveSurfaceAuthority,
  authored_symbol: String,
) -> Bool {
  rows |> any(fn(row) {
    row.authority == authority && (row.authored_symbol as String) == authored_symbol
  })
}

fn primitive_runtime_coverage_in(
  rows: List<PrimitiveSurfaceRow>,
  authored_symbol: String,
) -> PrimitiveSurfaceRuntimeCoverage {
  if surface_rows_carry_symbol_on(
    rows: rows,
    authority: InterpreterDispatch,
    authored_symbol: authored_symbol,
  ) {
    RuntimeRowOnInterpreterDispatch
  } else if surface_rows_carry_symbol_on(
    rows: rows,
    authority: EmitHandler,
    authored_symbol: authored_symbol,
  ) {
    RuntimeRowOnEmitHandlerOnly
  } else {
    RuntimeRowAbsentFromEnumeratedSurfaces
  }
}

fn primitive_runtime_coverage(authored_symbol: String) -> PrimitiveSurfaceRuntimeCoverage {
  primitive_runtime_coverage_in(
    rows: primitive_surface_census_derived(),
    authored_symbol: authored_symbol,
  )
}

fn primitive_runtime_coverage_is_unenumerated(coverage: PrimitiveSurfaceRuntimeCoverage) -> Bool {
  match coverage {
    RuntimeRowOnInterpreterDispatch => false
    RuntimeRowOnEmitHandlerOnly => false
    RuntimeRowAbsentFromEnumeratedSurfaces => true
  }
}

fn registry_symbols_with_no_enumerated_runtime_row_in(rows: List<PrimitiveSurfaceRow>) -> List<String> {
  rows
    |> filter(fn(row) { row.authority == BuiltinRegistry })
    |> map(row => row.authored_symbol as String)
    |> filter(fn(sym) {
      primitive_runtime_coverage_is_unenumerated(
        coverage: primitive_runtime_coverage_in(rows: rows, authored_symbol: sym)
      )
    })
}

fn registry_symbols_with_no_enumerated_runtime_row() -> List<String> {
  registry_symbols_with_no_enumerated_runtime_row_in(rows: primitive_surface_census_derived())
}

fn registry_symbols_with_no_enumerated_runtime_row_count() -> Int {
  count(registry_symbols_with_no_enumerated_runtime_row())
}

// ---------------------------------------------------------------------------
// Traversal-order denominator (determinism-denominator-closure first slice).
//
// v2.lens.determinism used to carry its own two-row registry keyed on a raw
// authored Symbol. That registry was the WallAfterGrounding this section is the
// ground for: its own compile_gate_law recorded that absence from it was not
// evidence of determinism, because nothing related the roster to the declared
// primitive population. The relation now exists in one direction only -- every
// DECLARED PrimitiveDefinition must carry exactly one PrimitiveTraversalOrderFact,
// and a definition with no fact is a typed refusal, not a silent Deterministic.

data primitive_order_free_result_note: String = "OrderFreeResult is a fourth classified answer, not a synonym for TraversalOrderUnclassified. The two are the not-applicable / malformed conflation DESIGN names as a recurring failure mode read on the traversal axis: OrderFreeResult says the primitive's result exposes no traversal at all (a count, a lookup, a constructed Map -- the order question belongs to whatever later TRAVERSES the result, not here), while TraversalOrderUnclassified says nobody has answered the question. They have opposite owners and opposite repairs: OrderFreeResult is terminal, Unclassified ranks for classification work and refuses at every call site until it is done. Collapsing them would have made every length/map_get call an order leak, which is false, or made every unclassified primitive silently safe, which is the fail-open this slice closes."

data primitive_length_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_length, order: OrderFreeResult }

data primitive_map_insert_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_map_insert, order: OrderFreeResult }

data primitive_map_get_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_map_get, order: OrderFreeResult }

data primitive_empty_map_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_empty_map, order: OrderFreeResult }

data primitive_decl_facts_traversal_note: String = "The four parse-only reflection primitives are CanonicalOrder by EXECUTED READING of their realizations, not by their names. decl_facts routes through coproduct_reflection decl_facts_corpus_walk, whose final step sorts every fact by (rel_path, name, kind_ord) before returning. export_signature_facts derives from decl_facts_for_roots and preserves that order. concept_decl_facts and data_decl_type_facts route through decls_parse_only_fail_closed, which sorts its module list (decls_parse_only_from_disk) or its inventory entries by source path (decls_parse_only_from_inventory) before walking items in source order. concept_decl_facts_live is the one that is NOT canonical: eval_concept_decl_facts_live walks ctx.modules and module.items directly, so its order is the program's own module-load and source order -- deterministic for a fixed program, which is what SourcePreservingOrder means, and NOT a host hash order."

data primitive_decl_facts_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_decl_facts, order: CanonicalOrder }

data primitive_export_signature_facts_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_export_signature_facts, order: CanonicalOrder }

data primitive_data_decl_type_facts_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_data_decl_type_facts, order: CanonicalOrder }

data primitive_concept_decl_facts_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_concept_decl_facts, order: CanonicalOrder }

data primitive_concept_decl_facts_live_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact { primitive: primitive_concept_decl_facts_live, order: SourcePreservingOrder }

data primitive_projection_traversal_facts: List<PrimitiveTraversalOrderFact> = [
  primitive_length_traversal,
  primitive_map_insert_traversal,
  primitive_map_get_traversal,
  primitive_empty_map_traversal,
  primitive_decl_facts_traversal,
  primitive_export_signature_facts_traversal,
  primitive_data_decl_type_facts_traversal,
  primitive_concept_decl_facts_traversal,
  primitive_concept_decl_facts_live_traversal,
]

fn primitive_declared_traversal_facts() -> List<PrimitiveTraversalOrderFact> {
  concat(primitive_d0_traversal_facts, primitive_projection_traversal_facts)
}

fn primitive_traversal_order_for_identity(identity: PrimitiveIdentity) -> TraversalOrder? {
  primitive_declared_traversal_facts()
    |> fold(init: none, f: fn(acc, fact) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if primitive_identity_eq(left: fact.primitive, right: identity) {
            Present { value: fact.order }
          } else {
            none
          }
      }
    })
}

data primitive_identity_for_canonical_name_note: String = "The declaration-scoped half of primitive_identity_for_symbol, lifted out so a consumer that is NOT one of the five realization surfaces can ask the same question without naming a surface it does not inhabit. A call node in a compiled tree is a SOURCE invocation, so passing it any PrimitiveSurfaceAuthority would be a fabricated join key; it may only ask whether the authored name IS a declared primitive's canonical name. primitive_identity_for_symbol's second arm now calls this, so the two cannot drift."

fn primitive_identity_for_canonical_name(authored_symbol: String) -> PrimitiveIdentity? {
  if primitive_identity_is_declared(identity: primitive_identity_slug(name: authored_symbol)) {
    Present { value: primitive_identity_slug(name: authored_symbol) }
  } else {
    none
  }
}

data primitive_traversal_denominator_note: String = "The closure predicate the determinism gate is enrolled on. It is deliberately one-directional: it asks that every DECLARED definition carry a fact, not that every fact name a declared definition, because an orphan fact is inert while a factless definition is a call site the gate would classify Deterministic by silence. Naming a new primitive in primitive_projection_target_canonical_names without classifying its traversal order therefore reds the determinism gate on the NEXT COMPILE OF ANY TREE -- before any caller uses it -- rather than being discovered when some emitted artifact turns out to differ between runs."

fn primitive_definitions_missing_traversal_fact_in(defs: List<PrimitiveDefinition>) -> List<PrimitiveDefinition> {
  defs
    |> filter(fn(d) {
      match primitive_traversal_order_for_identity(identity: d.identity) {
        Present { value: _ } => false
        Absent => true
      }
    })
}

fn primitive_definitions_missing_traversal_fact() -> List<PrimitiveDefinition> {
  primitive_definitions_missing_traversal_fact_in(defs: primitive_declared_definitions())
}

fn primitive_traversal_denominator_is_closed() -> Bool {
  count(primitive_definitions_missing_traversal_fact()) == 0
}
