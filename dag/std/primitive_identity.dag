fn primitive_identity_lookup(
  authority: PrimitiveSurfaceAuthority,
  authored_symbol: String,
) -> PrimitiveIdentity? {
  primitive_d0_surface_alias_bindings
    |> fold(init: none, f: fn(acc, binding) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if binding.authority == authority
            && (binding.authored_symbol as String) == authored_symbol {
            Present { value: binding.identity }
          } else {
            none
          }
      }
    })
}

fn registry_contains_symbol(sym: String) -> Bool {
  builtin_registry_surface_names() |> any(name => name == sym)
}

fn algebra_contains_template_name(name: String) -> Bool {
  all_algebra_template_names() |> any(template_name => template_name == name)
}

fn emit_contains_symbol(sym: String) -> Bool {
  rt_function_registry |> any(entry => entry.name == sym)
}

fn contract_contains_name(name: String) -> Bool {
  primitive_contract_roster() |> any(contract => contract.name == name)
}

fn primitive_registry_surface_rows() -> List<PrimitiveSurfaceRow> {
  builtin_registry_surface_names()
    |> map(sym =>
      surface_row(
        authority: BuiltinRegistry,
        authored_symbol: sym,
        authority_ref: decl_ref(module_path: "std.primitives", decl_name: "builtin_registry_surface_names"),
        primitive: primitive_identity_lookup(authority: BuiltinRegistry, authored_symbol: sym),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_contract_surface_rows() -> List<PrimitiveSurfaceRow> {
  primitive_contract_roster()
    |> map(contract =>
      surface_row(
        authority: PrimitiveContractRow,
        authored_symbol: contract.name,
        authority_ref: decl_field_ref(
          module_path: "std.primitives",
          decl_name: concat(contract.name, "_contract"),
          field_name: "name",
        ),
        primitive: primitive_identity_lookup(
          authority: PrimitiveContractRow,
          authored_symbol: contract.name,
        ),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_algebra_surface_rows() -> List<PrimitiveSurfaceRow> {
  all_algebra_field_templates()
    |> map(template =>
      surface_row(
        authority: AlgebraTemplate,
        authored_symbol: template.name,
        authority_ref: decl_ref(module_path: "std.algebra", decl_name: "all_algebra_field_templates"),
        primitive: primitive_identity_lookup(authority: AlgebraTemplate, authored_symbol: template.name),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_emit_surface_rows() -> List<PrimitiveSurfaceRow> {
  rt_function_registry
    |> map(entry =>
      surface_row(
        authority: EmitHandler,
        authored_symbol: entry.name,
        authority_ref: decl_ref(module_path: "extdeps.languages.rust.emit", decl_name: "rt_function_registry"),
        primitive: primitive_identity_lookup(authority: EmitHandler, authored_symbol: entry.name),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_interpreter_surface_rows() -> List<PrimitiveSurfaceRow> {
  v1_interpreter_primitive_arms()
    |> map(arm =>
      surface_row(
        authority: InterpreterDispatch,
        authored_symbol: arm.authored_spelling as String,
        authority_ref: decl_ref(
          module_path: "gunbc.v1_interpreter_primitive_surface",
          decl_name: "v1_interpreter_primitive_arms",
        ),
        primitive: primitive_identity_lookup(
          authority: InterpreterDispatch,
          authored_symbol: arm.authored_spelling as String,
        ),
        provenance: DerivedFromAuthority,
      )
    )
}

fn primitive_surface_census_derived() -> List<PrimitiveSurfaceRow> {
  concat(
    concat(
      concat(
        concat(
          primitive_registry_surface_rows(),
          primitive_contract_surface_rows()
        ),
        primitive_algebra_surface_rows()
      ),
      primitive_emit_surface_rows()
    ),
    primitive_interpreter_surface_rows()
  )
}

fn primitive_d0_surface_census() -> List<PrimitiveSurfaceRow> {
  primitive_surface_census_derived()
}

data primitive_map_keys_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_map_keys,
  order: HostUnspecifiedOrder,
}

data primitive_map_values_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_map_values,
  order: HostUnspecifiedOrder,
}

data primitive_fold_list_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_fold_list,
  order: SourcePreservingOrder,
}

data primitive_index_by_traversal: PrimitiveTraversalOrderFact = PrimitiveTraversalOrderFact {
  primitive: primitive_index_by,
  order: TraversalOrderUnclassified,
}

data primitive_d0_traversal_facts: List<PrimitiveTraversalOrderFact> = [
  primitive_map_keys_traversal,
  primitive_map_values_traversal,
  primitive_fold_list_traversal,
  primitive_index_by_traversal,
]

data primitive_map_keys_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_map_keys,
  cost: ShapeLinearScan,
}

data primitive_map_values_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_map_values,
  cost: ShapeLinearScan,
}

data primitive_fold_list_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_fold_list,
  cost: ShapeIterateBody,
}

data primitive_index_by_cost: PrimitiveCostFact = PrimitiveCostFact {
  primitive: primitive_index_by,
  cost: ShapeIterateBody,
}

fn primitive_surface_missing_identity_violation(row: PrimitiveSurfaceRow) -> PrimitiveJoinViolation? {
  match row.primitive {
    Present { value: _ } => none
    Absent =>
      Present {
        value: SurfaceMissingPrimitiveIdentity {
          authority: row.authority,
          authored_symbol: row.authored_symbol,
        },
      }
  }
}

fn primitive_surface_row_identity_violation(
  row: PrimitiveSurfaceRow,
  expected: PrimitiveIdentity,
) -> PrimitiveJoinViolation? {
  match row.primitive {
    Present { value: id } =>
      if primitive_identity_eq(left: id, right: expected) {
        none
      } else {
        Present {
          value: IncompatibleInvocationAssignment {
            authored_symbol: row.authored_symbol,
            first: id,
            second: expected,
          },
        }
      }
    Absent =>
      Present {
        value: SurfaceMissingPrimitiveIdentity {
          authority: row.authority,
          authored_symbol: row.authored_symbol,
        },
      }
  }
}

fn primitive_surface_joins_two_identities_violation(
  left: PrimitiveSurfaceRow,
  right: PrimitiveSurfaceRow,
) -> PrimitiveJoinViolation? {
  if (left.authored_symbol as String) != (right.authored_symbol as String) {
    none
  } else {
    match left.primitive {
      Present { value: first } =>
        match right.primitive {
          Present { value: second } =>
            if primitive_identity_eq(left: first, right: second) {
              none
            } else if left.authority == right.authority {
              Present {
                value: SurfaceJoinsTwoIdentities {
                  authority: left.authority,
                  authored_symbol: left.authored_symbol,
                  first: first,
                  second: second,
                },
              }
            } else {
              Present {
                value: IncompatibleInvocationAssignment {
                  authored_symbol: left.authored_symbol,
                  first: first,
                  second: second,
                },
              }
            }
          Absent => none
        }
      Absent => none
    }
  }
}

fn primitive_incompatible_invocation_assignment_violation(
  authored_symbol: String,
  first: PrimitiveIdentity,
  second: PrimitiveIdentity,
) -> PrimitiveJoinViolation? {
  if primitive_identity_eq(left: first, right: second) {
    none
  } else {
    Present {
      value: IncompatibleInvocationAssignment {
        authored_symbol: authored_symbol as std.types.NonEmptyStr,
        first: first,
        second: second,
      },
    }
  }
}

fn primitive_surface_rows_missing_identity_violations(
  rows: List<PrimitiveSurfaceRow>
) -> List<PrimitiveJoinViolation> {
  rows |> fold(init: [], f: fn(acc, row) {
    match primitive_surface_missing_identity_violation(row: row) {
      Present { value: violation } => concat([violation], acc)
      Absent => acc
    }
  })
}

fn primitive_definition_identity(definition: PrimitiveDefinition) -> PrimitiveIdentity {
  definition.identity
}

fn primitive_duplicate_semantic_definition_violation(
  definitions: List<PrimitiveDefinition>,
  target: PrimitiveIdentity
) -> PrimitiveJoinViolation? {
  if count(
    definitions |> filter(fn(d) { primitive_identity_eq(left: d.identity, right: target) })
  ) > 1 {
    Present { value: DuplicateSemanticDefinition { identity: target } }
  } else {
    none
  }
}

fn primitive_realization_unknown_primitive_violation(
  realization: PrimitiveRealization,
  definitions: List<PrimitiveDefinition>
) -> PrimitiveJoinViolation? {
  let known = definitions
    |> any(fn(d) { primitive_identity_eq(left: d.identity, right: realization.primitive) })
  if known {
    none
  } else {
    Present {
      value: RealizationNamesUnknownPrimitive {
        target: realization.target,
        handler: realization.handler,
      },
    }
  }
}

fn primitive_d0_derived_rows_missing_identity_count() -> Int {
  count(primitive_surface_rows_missing_identity_violations(rows: primitive_surface_census_derived()))
}

fn primitive_d0_interpreter_surface_row_count() -> Int {
  count(primitive_interpreter_surface_rows())
}

fn primitive_d0_interpreter_census_matches_roster() -> Bool {
  primitive_d0_interpreter_surface_row_count() == v1_interpreter_row_count()
}

fn primitive_d0_open_denominator_receipt_holds() -> Bool {
  primitive_d0_derived_surface_authority_count == 5
    && primitive_d0_open_surface_authority_count == 0
    && primitive_d0_interpreter_census_matches_roster()
    && primitive_d0_derived_rows_missing_identity_count() > 0
}

fn primitive_d0_surface_census_row_count() -> Int {
  count(primitive_d0_surface_census())
}

fn primitive_d0_surface_census_derived_row_count() -> Int {
  count(primitive_surface_census_derived())
}

fn primitive_d0_surface_census_missing_identity_count() -> Int {
  count(primitive_surface_rows_missing_identity_violations(rows: primitive_d0_surface_census()))
}

fn primitive_d0_surface_census_rows_for(
  authority: PrimitiveSurfaceAuthority,
  authored_symbol: String,
) -> List<PrimitiveSurfaceRow> {
  primitive_d0_surface_census()
    |> filter(fn(row) {
      row.authority == authority && (row.authored_symbol as String) == authored_symbol
    })
}

fn primitive_d0_surface_census_row_identity_coherent(
  authority: PrimitiveSurfaceAuthority,
  authored_symbol: String,
  expected: PrimitiveIdentity,
) -> Bool {
  let rows = primitive_d0_surface_census_rows_for(
    authority: authority,
    authored_symbol: authored_symbol,
  )
  count(rows) == 1
    && match rows |> first {
      Present { value: row } =>
        match primitive_surface_row_identity_violation(row: row, expected: expected) {
          Absent => true
          Present { value: _ } => false
        }
      Absent => false
    }
}

fn primitive_d0_fold_list_spelling_fork_holds() -> Bool {
  primitive_d0_surface_census_row_identity_coherent(
    authority: PrimitiveContractRow,
    authored_symbol: "fold",
    expected: primitive_fold_list,
  )
    && primitive_d0_surface_census_row_identity_coherent(
      authority: InterpreterDispatch,
      authored_symbol: "fold_list",
      expected: primitive_fold_list,
    )
    && !registry_contains_symbol(sym: "fold_list")
}

fn primitive_d0_index_by_registry_algebra_gap_holds() -> Bool {
  !registry_contains_symbol(sym: "index_by")
    && !algebra_contains_template_name(name: "index_by")
    && contract_contains_name(name: "index_by")
    && emit_contains_symbol(sym: "index_by")
}

fn primitive_d0_fold_list_registry_gap_holds() -> Bool {
  !registry_contains_symbol(sym: "fold_list")
    && primitive_d0_surface_census_row_identity_coherent(
      authority: InterpreterDispatch,
      authored_symbol: "fold_list",
      expected: primitive_fold_list,
    )
}

fn primitive_d0_authority_map_keys_rows_coherent(authority: PrimitiveSurfaceAuthority) -> Bool {
  let rows = primitive_d0_surface_census()
    |> filter(fn(row) {
      row.authority == authority && (row.authored_symbol as String) == "map_keys"
    })
  count(rows) >= 1
    && rows |> all(fn(row) {
      match primitive_surface_row_identity_violation(row: row, expected: primitive_map_keys) {
        Absent => true
        Present { value: _ } => false
      }
    })
}

fn primitive_d0_map_keys_five_surface_join_holds() -> Bool {
  primitive_d0_authority_map_keys_rows_coherent(authority: BuiltinRegistry)
    && primitive_d0_authority_map_keys_rows_coherent(authority: PrimitiveContractRow)
    && primitive_d0_authority_map_keys_rows_coherent(authority: AlgebraTemplate)
    && primitive_d0_authority_map_keys_rows_coherent(authority: EmitHandler)
    && primitive_d0_authority_map_keys_rows_coherent(authority: InterpreterDispatch)
}

fn primitive_d0_interpreter_rows_are_from_authority() -> Bool {
  primitive_interpreter_surface_rows()
    |> all(fn(row) { row.provenance == DerivedFromAuthority })
}

fn primitive_d0_derived_rows_are_from_authority() -> Bool {
  primitive_surface_census_derived()
    |> all(fn(row) { row.provenance == DerivedFromAuthority })
}

fn primitive_d0_host_unspecified_traversal_classified() -> Bool {
  primitive_d0_traversal_facts
    |> all(fn(fact) {
      if primitive_identity_eq(left: fact.primitive, right: primitive_map_keys)
        || primitive_identity_eq(left: fact.primitive, right: primitive_map_values) {
        fact.order == HostUnspecifiedOrder
      } else {
        true
      }
    })
}
