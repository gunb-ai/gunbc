]

data compiler_recursive_types: Map<String, Bool> = {
  "Node": true,
  "InferredNode": true,
  "MatchPattern": true,
  "MethodSemantics": true
}

fn is_compiler_recursive_type(name: String) -> Bool {
  match map_get(compiler_recursive_types, name) {
    Present { value: _ } => true
    Absent => false
  }
}
