module std.float

import std.algebra { Field, FieldOfFractions }
import std.integer { Int }
import std.machine_constraints { Compose, MachineWidth }
import std.approximate_field { ApproximateField }

type Ieee754Float

type Real = ApproximateField<FieldOfFractions<Int>>

type Real32 = Compose<Real, MachineWidth<32>>
type Real64 = Compose<Real, MachineWidth<64>>

type Float32 = Real32
type Float64 = Real64

type Float = Float64
