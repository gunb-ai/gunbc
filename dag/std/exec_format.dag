module std.exec_format

import std.types { Bool }

type ExecutableFormatFamily
  = Elf
  | Pe
  | MachO

type ExecutableFormat {
  family: ExecutableFormatFamily
}

type SegmentPermission {
  readable: Bool
  writable: Bool
  executable: Bool
}

type LoadSegment {
  file_offset: Int
  virtual_address: Int
  file_size: Int
  memory_size: Int
  permissions: SegmentPermission
  alignment: Int
}

type EntryPoint {
  virtual_address: Int
}

type Relocation {
  offset: Int
  symbol_index: Int
  relocation_type: Int
}
