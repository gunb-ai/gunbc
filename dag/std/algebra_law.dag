module std.algebra_law

import std.types { Float, NonEmptyStr, Int, is_kernel_type }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, Scaffold, SingleAuthority }

data algebra_law_slice_note: String = "Slice-1 associativity (AssociativityOperationSubject / AssociativityFloatAdd). Slice-A classical path additivity (ClassicalPathAdditivityOperationSubject / ClassicalPathAdditivityBach2013) — exclusive-alternative mixture refutation from cited arrival-count rows, executed derivation in gunbc.bach_double_slit_path_additivity_observation. Lattice distributivity (Slice B) is deferred. LawExhaustivelyVerified and LawDeclaredByAuthority remain omitted."

data algebra_law_subject_coproduct_expansion_disposition: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "std.algebra_law",
    decl_name: "AssociativityOperationSubject",
    field: WholeDeclaration
  }
}

type AssociativityCounterexampleWitness<T> {
  left_operand: T
  middle_operand: T
  right_operand: T
  left_fold_result: T
  right_fold_result: T
}

type AssociativityOperationSubject
  = AssociativityFloatAdd {}

type AssociativityRefutationReceipt<T> {
  subject: AssociativityOperationSubject
  witness: AssociativityCounterexampleWitness<T>
}

type ClassicalPathAdditivityCounterexampleWitness {
  left_alternative_count: Int
  right_alternative_count: Int
  both_open_observed_count: Int
  classical_additive_prediction: Int
}

type ClassicalPathAdditivityOperationSubject
  = ClassicalPathAdditivityBach2013 {}

type ClassicalPathAdditivityRefutationReceipt {
  subject: ClassicalPathAdditivityOperationSubject
  witness: ClassicalPathAdditivityCounterexampleWitness
  location_label: NonEmptyStr
}

fn float_kernel_type_in_authority_roster() -> Bool {
  is_kernel_type(name: "Float")
}

fn float_add_associativity_witness_matches_execution(
  witness: AssociativityCounterexampleWitness<Float>,
) -> Bool {
  let left = (witness.left_operand + witness.middle_operand) + witness.right_operand
  let right = witness.left_operand + (witness.middle_operand + witness.right_operand)
  (left != right)
    && (left == witness.left_fold_result)
    && (right == witness.right_fold_result)
}

fn associativity_refutation_holds_for_float_add(
  receipt: AssociativityRefutationReceipt<Float>,
) -> Bool {
  match receipt.subject {
    AssociativityFloatAdd {} =>
      float_add_associativity_witness_matches_execution(witness: receipt.witness)
  }
}

fn classical_path_additivity_witness_matches_additive_prediction(
  witness: ClassicalPathAdditivityCounterexampleWitness,
) -> Bool {
  witness.classical_additive_prediction == (witness.left_alternative_count + witness.right_alternative_count)
}

fn classical_path_additivity_witness_is_counterexample(
  witness: ClassicalPathAdditivityCounterexampleWitness,
) -> Bool {
  classical_path_additivity_witness_matches_additive_prediction(witness: witness)
    && (witness.both_open_observed_count < witness.classical_additive_prediction)
}

fn classical_path_additivity_refutation_holds_for_bach_2013(
  receipt: ClassicalPathAdditivityRefutationReceipt,
) -> Bool {
  match receipt.subject {
    ClassicalPathAdditivityBach2013 {} =>
      classical_path_additivity_witness_is_counterexample(witness: receipt.witness)
  }
}
