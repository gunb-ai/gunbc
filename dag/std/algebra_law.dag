module std.algebra_law

import std.syntax { BinOp, Add }
import std.types { NonEmptyStr }

data algebra_law_slice_note: String = "Slice-1 associativity evidence only: AssociativityCounterexampleWitness plus AssociativityRefutationReceipt bound to std.syntax.BinOp and KernelTypeName enum variants — not string carrier or operation nicknames. LawExhaustivelyVerified and LawDeclaredByAuthority are omitted until an exhaustive checker or cited proposition producer exists. Float binary + has no DeclarationRef-producing surface (compiler builtin); extdeps.numeric.ieee754_float records that grounding gap beside the receipt."

type KernelTypeName
  = KernelFloat
  | KernelInt
  | KernelBool
  | KernelString

type AssociativityCounterexampleWitness<T> {
  left_operand: T
  middle_operand: T
  right_operand: T
  left_fold_result: T
  right_fold_result: T
}

type AssociativityOperationSubject {
  carrier: KernelTypeName
  binop: BinOp
}

type AssociativityRefutationReceipt<T> {
  subject: AssociativityOperationSubject
  witness: AssociativityCounterexampleWitness<T>
}

fn associativity_subject_is_float_add(subject: AssociativityOperationSubject) -> Bool {
  subject.carrier == KernelFloat && subject.binop == Add
}

fn float_add_associativity_witness_matches_execution(
  witness: AssociativityCounterexampleWitness<Float>,
) -> Bool {
  let left = (witness.left_operand + witness.middle_operand) + witness.right_operand
  let right = witness.left_operand + (witness.middle_operand + witness.right_operand)
  (left != right)
    && (left == witness.left_fold_result)
    && (right == witness.right_fold_result)
}

fn associativity_refutation_holds_for_float_add(
  receipt: AssociativityRefutationReceipt<Float>,
) -> Bool {
  associativity_subject_is_float_add(subject: receipt.subject)
    && float_add_associativity_witness_matches_execution(witness: receipt.witness)
}
