module std.algebra_law


data algebra_law_slice_note: String = "Slice-1 associativity evidence only: AssociativityCounterexampleWitness plus AssociativityRefutationReceipt bound to the closed AssociativityOperationSubject coproduct (sole variant AssociativityFloatAdd — kernel Float addition, rostered in std.types kernel_type_set). LawExhaustivelyVerified and LawDeclaredByAuthority are omitted until an exhaustive checker or cited proposition producer exists. Float binary + has no DeclarationRef-producing surface (compiler builtin); extdeps.standards.ieee_754_2019 owns the cited standard subject and gunbc.float_add_associativity_observation records the execution receipt."

data algebra_law_subject_coproduct_expansion_disposition: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "std.algebra_law",
    decl_name: "AssociativityOperationSubject",
    field: WholeDeclaration
  }
}

type AssociativityCounterexampleWitness<T> {
  left_operand: T
  middle_operand: T
  right_operand: T
  left_fold_result: T
  right_fold_result: T
}

type AssociativityOperationSubject
  = AssociativityFloatAdd {}

type AssociativityRefutationReceipt<T> {
  subject: AssociativityOperationSubject
  witness: AssociativityCounterexampleWitness<T>
}

fn float_kernel_type_in_authority_roster() -> Bool {
  is_kernel_type(name: "Float")
}

fn float_add_associativity_witness_matches_execution(
  witness: AssociativityCounterexampleWitness<Float>,
) -> Bool {
  let left = (witness.left_operand + witness.middle_operand) + witness.right_operand
  let right = witness.left_operand + (witness.middle_operand + witness.right_operand)
  (left != right)
    && (left == witness.left_fold_result)
    && (right == witness.right_fold_result)
}

fn associativity_refutation_holds_for_float_add(
  receipt: AssociativityRefutationReceipt<Float>,
) -> Bool {
  match receipt.subject {
    AssociativityFloatAdd {} =>
      float_add_associativity_witness_matches_execution(witness: receipt.witness)
  }
}
