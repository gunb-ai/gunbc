module std.checkpointed_workspace

import std.types { String, NonEmptyStr, Int, Bool, List }
import v2.std.optional { Present, Absent }
import std.algebra { Cons, Empty }
import std.measure { ByteSize, measure_count, Nanosecond, nanosecond, nanosecond_count, ObservationInstant, InstantOrder, InstantBefore, InstantSame, InstantAfter, InstantIncomparable, compare_instants }
import std.nat { nat_sub, NatDifference, NatSubtrahendExceedsMinuend }
import std.fabric_blob { FabricBlobAddress, fabric_blob_object_name }
import std.fabric_storage {
  FabricObject, FabricObjectRef,
  FabricHeadExpectation, ExpectHeadAbsent, ExpectHeadAt,
  FabricHeadReading, FabricHeadAbsent, FabricHeadAt, fabric_object_ref_eq,
  FabricHeadAdvance, FabricHeadAdvanced, FabricHeadMoved, FabricHeadAdvanceRefused,
  FabricStorageFault,
}

// THE CHECKPOINTED WORKSPACE: ONE PERSISTENT SURFACE, COMMITTED BY REVISION, FENCED BY EPOCH.
//
// The contract is the private plan row volume-durability-contract (recoverable_workspace_ruling,
// operator 2026-10-02): writes are acknowledged by a volatile local working copy; a checkpoint
// uploads changed content-addressed chunks and then an immutable manifest naming the complete
// revision; the revision is COMMITTED only when the head accepts it for the current writer epoch;
// restore always selects the last committed revision. This module is the shape of that contract and
// nothing else. It mints no store (DESIGN 3b): chunks are std.fabric_blob objects addressed by their
// own SHA-256, the manifest is a std.fabric_storage object, and the committed-revision head is one
// std.fabric_storage head, whose compare-and-set is the only linearization the contract needs.
//
// THE EPOCH IS FENCED BY THE SAME COMPARE-AND-SET THAT COMMITS, NOT BY A SECOND READ. A writer that
// checked "is my epoch current" against a separate epoch record and then advanced the head would
// race the revocation between the two steps -- a stale writer could commit after being fenced. So
// revocation is itself an advance of the workspace head: the control plane publishes a fence entry
// carrying the new epoch, linked to the last committed revision. Every writer advances with the
// expectation "the head is at the entry I built on", so a fenced writer's advance observes the moved
// head and is refused; the observed entry's epoch says whether the loss was a race inside one epoch
// or a stale epoch. One head, one CAS, no window between the check and the commit.
//
// STORE-VISIBLE LINKS. A revision links its parent head entry (a revision or a fence) through
// FabricObject.links, so a closure read from the head reaches every committed revision in one
// store-side walk. Chunk addresses live in the body: they name blob-plane objects, which are not
// metadata-plane objects and so are not links the metadata store may walk (std.fabric_blob).
//
// CONSUMERS, A DECLARED FRONTIER (DESIGN 3c). Executed today only by test.claim.std_checkpointed_workspace
// over supplied values. The real-path consumers are, by name:
//   * the demo stage-1 restore entry (create, edit, barrier, destroy, recreate), which commits and
//     restores through std.fabric_storage heads on R2. TRIGGER: gunbc.fabric_storage_r2_head
//     (gunbc#13088) on main AND a durable workspace bucket placement with minted credentials (the
//     operator escalation of 2026-10-03). It owes the pairing claim the witness rule demands: one
//     claim that runs a real head advance and restore, so the supplied-value witnesses stop being the
//     only execution of this module;
//   * the control-plane reconciler that publishes WorkspaceFence entries (docs/plans/
//     workspace-control-plane.md, gunbc#13084). TRIGGER: the same head realization on main.

type WorkspaceWriterEpoch {
  workspace: NonEmptyStr
  epoch: Int
}

// One file of the revision: its path inside the workspace, the blob holding its bytes (the chunk's
// own SHA-256, so the fetch verifies the reading's digest equals the address), and its size. Whole
// files are one chunk until docs/plans/fabric-storage.md step 5 (chunked objects); a file larger than
// the placement's whole-object bound is refused by fabric_blob_put_plan, never split here.
type WorkspaceEntry {
  path: NonEmptyStr
  chunk: FabricBlobAddress
  size: ByteSize
}

// What the head points at. A revision is a complete manifest committed under an epoch; a fence
// carries a new epoch and the revision it inherits, and commits no content.
type WorkspaceHeadEntry
  = WorkspaceRevision { writer: WorkspaceWriterEpoch, parent: FabricObjectRef?, entries: List<WorkspaceEntry> }
  | WorkspaceFence { writer: WorkspaceWriterEpoch, parent: FabricObjectRef? }

fn workspace_head_entry_epoch(entry: WorkspaceHeadEntry) -> Int {
  match entry {
    WorkspaceRevision { writer: w, parent: _, entries: _ } => w.epoch
    WorkspaceFence { writer: w, parent: _ } => w.epoch
  }
}

// The head the workspace commits on. The name carries the workspace identity, so heads shard by
// workspace as fabric-storage.md step 5 anticipates.
fn workspace_head_name(workspace: NonEmptyStr) -> NonEmptyStr {
  join(["workspace.", workspace as String, ".committed"], "") as NonEmptyStr
}

fn workspace_parent_links(parent: FabricObjectRef?) -> List<FabricObjectRef> {
  match parent {
    Present { value: p } => [p]
    Absent => []
  }
}

fn workspace_entry_line(entry: WorkspaceEntry) -> String {
  join(["F", to_string(length(entry.path as String)), ":", entry.path as String, " ",
        fabric_blob_object_name(address: entry.chunk) as String, " ", to_string(measure_count(m: entry.size)), ";"], "")
}

// The canonical body: kind, workspace, epoch, then every entry length-prefixed in order, so no two
// distinct entries share a body.
fn workspace_head_entry_object(entry: WorkspaceHeadEntry) -> FabricObject {
  match entry {
    WorkspaceRevision { writer: w, parent: p, entries: es } => FabricObject {
      links: workspace_parent_links(parent: p),
      body: join(["workspace.revision;", w.workspace as String, ";epoch=", to_string(w.epoch), ";",
                  fold(es, init: "", f: (acc, e) => join([acc, workspace_entry_line(entry: e)], ""))], "") as NonEmptyStr,
    }
    WorkspaceFence { writer: w, parent: p } => FabricObject {
      links: workspace_parent_links(parent: p),
      body: join(["workspace.fence;", w.workspace as String, ";epoch=", to_string(w.epoch), ";"], "") as NonEmptyStr,
    }
  }
}

// AN ENTRY TOGETHER WITH THE REF IT WAS READ UNDER, one value, so an entry without its ref (or a ref
// without its entry) has no representation. The decoded closure read (std.fabric_storage
// FabricClosureRead, newest first) maps onto it one-to-one.
type WorkspaceStoredEntry {
  ref: FabricObjectRef
  entry: WorkspaceHeadEntry
}

// WHAT A WRITER ASKS THE HEAD FOR: the object to put, and the expectation to advance under. The
// expectation is the head entry the writer built on -- absent only for the first revision of a new
// workspace -- so the epoch fence above is the expectation itself. The writer must also never BUILD
// on an entry of a later epoch: rebuilding on a fence would make the fence the expectation and the
// advance would succeed, so a built-on entry whose epoch exceeds the new entry's is refused here,
// before any put.
type WorkspaceAdvancePlan {
  object: FabricObject
  expected: FabricHeadExpectation
}

type WorkspaceAdvanceDecision
  = WorkspaceAdvancePlanned { plan: WorkspaceAdvancePlan }
  | WorkspaceAdvanceStaleEpoch { writer_epoch: Int, current_epoch: Int }

fn workspace_advance_plan(entry: WorkspaceHeadEntry, built_on: WorkspaceStoredEntry?) -> WorkspaceAdvanceDecision {
  match built_on {
    Absent => WorkspaceAdvancePlanned { plan: WorkspaceAdvancePlan { object: workspace_head_entry_object(entry: entry), expected: ExpectHeadAbsent } }
    Present { value: b } =>
      if workspace_head_entry_epoch(entry: b.entry) > workspace_head_entry_epoch(entry: entry) {
        WorkspaceAdvanceStaleEpoch { writer_epoch: workspace_head_entry_epoch(entry: entry), current_epoch: workspace_head_entry_epoch(entry: b.entry) }
      } else {
        WorkspaceAdvancePlanned { plan: WorkspaceAdvancePlan { object: workspace_head_entry_object(entry: entry), expected: ExpectHeadAt { object: b.ref } } }
      }
  }
}

// THE COMMIT OUTCOME, CLASSIFIED FROM THE HEAD ADVANCE. A moved head whose entry carries a later
// epoch is a stale writer: it must stop writing, its pending writes are not the workspace's, and it
// must never retry. A moved head inside the writer's own epoch is a lost race against itself (a
// duplicate checkpointer) and is retried by rebuilding on the observed entry, through
// workspace_advance_plan. A moved head whose entry the caller could not decode -- or whose decoded
// ref is not the head the store reported -- is NOT a race: the epoch is unknown, so it is its own
// arm, which a writer may not retry (DESIGN 5: a failure arm refuses, never widens).
type WorkspaceCommit
  = WorkspaceCommitted { revision: FabricObjectRef }
  | WorkspaceCommitStaleEpoch { writer_epoch: Int, current_epoch: Int }
  | WorkspaceCommitRaced { observed: WorkspaceStoredEntry }
  | WorkspaceCommitObservedUndecoded { observed: FabricHeadReading }
  | WorkspaceCommitFailed { fault: FabricStorageFault }

fn workspace_commit_classify(writer: WorkspaceWriterEpoch, advance: FabricHeadAdvance, observed_entry: WorkspaceStoredEntry?) -> WorkspaceCommit {
  match advance {
    FabricHeadAdvanced { object: o, generation: _ } => WorkspaceCommitted { revision: o }
    FabricHeadAdvanceRefused { fault: f } => WorkspaceCommitFailed { fault: f }
    FabricHeadMoved { expected: _, observed: seen } =>
      match seen {
        FabricHeadAbsent => WorkspaceCommitObservedUndecoded { observed: seen }
        FabricHeadAt { object: head, generation: _ } =>
          match observed_entry {
            Absent => WorkspaceCommitObservedUndecoded { observed: seen }
            Present { value: e } =>
              if !fabric_object_ref_eq(a: e.ref, b: head) {
                WorkspaceCommitObservedUndecoded { observed: seen }
              } else {
                if workspace_head_entry_epoch(entry: e.entry) > writer.epoch {
                  WorkspaceCommitStaleEpoch { writer_epoch: writer.epoch, current_epoch: workspace_head_entry_epoch(entry: e.entry) }
                } else {
                  WorkspaceCommitRaced { observed: e }
                }
              }
          }
      }
  }
}

// RESTORE SELECTS THE LAST COMMITTED REVISION: walking newest first from the head, skip fences
// (they commit no content) and take the first revision. A workspace with no revision restores empty;
// it is never restored from anything but a committed entry, so uncommitted uploads -- chunks put
// without a head advance -- are never read.

type WorkspaceRestorePoint
  = WorkspaceRestoreRevision { revision: FabricObjectRef, entries: List<WorkspaceEntry> }
  | WorkspaceRestoreEmpty

fn workspace_restore_point(newest_first: List<WorkspaceStoredEntry>) -> WorkspaceRestorePoint {
  match newest_first {
    Empty => WorkspaceRestoreEmpty
    Cons { head: s, tail: rest } => match s.entry {
      WorkspaceRevision { writer: _, parent: _, entries: es } => WorkspaceRestoreRevision { revision: s.ref, entries: es }
      WorkspaceFence { writer: _, parent: _ } => workspace_restore_point(newest_first: rest)
    }
  }
}

// ── COVERAGE: THE RECOVERY-POINT INVARIANT IS COVERAGE, NOT FRESHNESS ──────────────────────────
//
// Instants are std.measure ObservationInstant (a clock domain and basis plus nanoseconds since its
// origin) and spans are std.measure Nanosecond, the canonical exact elapsed-time carrier. An age is
// defined only between two instants of ONE clock; across domains, or backwards in time, there is no
// age, and that is a typed refusal the caller must treat as unable to decide coverage -- never as zero
// and never as clean. Clean means every acknowledged write is in a committed revision. Dirty carries
// the instant of the oldest acknowledged write no committed revision contains, so its age is zero
// while clean and an idle workspace owes no commit.
type WorkspaceCoverage
  = WorkspaceClean
  | WorkspaceDirty { oldest_uncommitted_write_at: ObservationInstant }

type WorkspaceAge
  = WorkspaceAgeOf { age: Nanosecond }
  | WorkspaceAgeUndefined { order: InstantOrder }

fn workspace_age_between(from: ObservationInstant, to: ObservationInstant) -> WorkspaceAge {
  match compare_instants(a: from, b: to) {
    InstantIncomparable { left: l, right: r } => WorkspaceAgeUndefined { order: InstantIncomparable { left: l, right: r } }
    InstantAfter => WorkspaceAgeUndefined { order: InstantAfter }
    InstantSame => WorkspaceAgeOf { age: nanosecond(count: 0) }
    InstantBefore =>
      match nat_sub(a: nanosecond_count(n: to.since_origin), b: nanosecond_count(n: from.since_origin)) {
        NatDifference { value: d } => WorkspaceAgeOf { age: nanosecond(count: d) }
        NatSubtrahendExceedsMinuend => WorkspaceAgeUndefined { order: InstantAfter }
      }
  }
}

fn oldest_uncommitted_write_age(coverage: WorkspaceCoverage, now: ObservationInstant) -> WorkspaceAge {
  match coverage {
    WorkspaceClean => WorkspaceAgeOf { age: nanosecond(count: 0) }
    WorkspaceDirty { oldest_uncommitted_write_at: t } => workspace_age_between(from: t, to: now)
  }
}

// An acknowledged write starts the age only if none is pending; it never resets an older one.
fn workspace_coverage_after_write(coverage: WorkspaceCoverage, at: ObservationInstant) -> WorkspaceCoverage {
  match coverage {
    WorkspaceClean => WorkspaceDirty { oldest_uncommitted_write_at: at }
    WorkspaceDirty { oldest_uncommitted_write_at: t } => WorkspaceDirty { oldest_uncommitted_write_at: t }
  }
}

// A commit covers every write acknowledged before its snapshot. Writes acknowledged after the
// snapshot remain pending, so the age is advanced to the first of them, or cleared.
fn workspace_coverage_after_commit(first_write_after_snapshot: ObservationInstant?) -> WorkspaceCoverage {
  match first_write_after_snapshot {
    Present { value: t } => WorkspaceDirty { oldest_uncommitted_write_at: t }
    Absent => WorkspaceClean
  }
}

// The three published numbers' timing spans, kept apart: the internal checkpoint target while dirty,
// the deadline by which a still-failing commit becomes a declared outage, and the published window.
// The values are the operator's to ratify from the stage-0 measurement; none is authored here.
//
// THE ORDER target < deadline < window IS CONSTRUCTED, NOT CHECKED. sole_constructor means the one
// producer is workspace_durability_policy, which refuses any other order, so a policy whose outage
// precedes its commit attempt, or whose window does not exceed its outage deadline, has no value
// every consumer below could receive (DESIGN 5: construction over validation).
type WorkspaceDurabilityPolicy sole_constructor {
  checkpoint_target: Nanosecond
  outage_deadline: Nanosecond
  window: Nanosecond
}

type WorkspacePolicyRefusal
  = PolicyTargetNotBeforeDeadline { target: Nanosecond, deadline: Nanosecond }
  | PolicyDeadlineNotBeforeWindow { deadline: Nanosecond, window: Nanosecond }

type WorkspacePolicyAdmission
  = WorkspacePolicyAdmitted { policy: WorkspaceDurabilityPolicy }
  | WorkspacePolicyRefused { refusal: WorkspacePolicyRefusal }

fn workspace_durability_policy(checkpoint_target: Nanosecond, outage_deadline: Nanosecond, window: Nanosecond) -> WorkspacePolicyAdmission {
  if nanosecond_count(n: checkpoint_target) >= nanosecond_count(n: outage_deadline) {
    WorkspacePolicyRefused { refusal: PolicyTargetNotBeforeDeadline { target: checkpoint_target, deadline: outage_deadline } }
  } else {
    if nanosecond_count(n: outage_deadline) >= nanosecond_count(n: window) {
      WorkspacePolicyRefused { refusal: PolicyDeadlineNotBeforeWindow { deadline: outage_deadline, window: window } }
    } else {
      WorkspacePolicyAdmitted { policy: WorkspaceDurabilityPolicy { checkpoint_target: checkpoint_target, outage_deadline: outage_deadline, window: window } }
    }
  }
}

fn at_least(span: Nanosecond, bound: Nanosecond) -> Bool {
  nanosecond_count(n: span) >= nanosecond_count(n: bound)
}

// THE DECLARED STORAGE OUTAGE: entered when the oldest pending write reaches the outage deadline
// with no commit having covered it. The commit is attempted first (WorkspaceCommitDue from the
// target on); the outage refuses FURTHER writes and makes nothing already pending recoverable, which
// is why it is declared and receipted rather than silent.
type DeclaredStorageOutage {
  workspace: NonEmptyStr
  declared_at: ObservationInstant
  oldest_uncommitted_write_at: ObservationInstant
}

// A standing whose age cannot be computed (WorkspaceCoverageUndecidable) admits no write: the caller
// cannot show the pending write is younger than the deadline, so it refuses as the outage would.
type WorkspaceWriteStanding
  = WorkspaceWritable
  | WorkspaceCommitDue { age: Nanosecond }
  | WorkspaceStorageOutage { outage: DeclaredStorageOutage }
  | WorkspaceCoverageUndecidable { order: InstantOrder }

fn workspace_write_standing(policy: WorkspaceDurabilityPolicy, workspace: NonEmptyStr, coverage: WorkspaceCoverage, now: ObservationInstant) -> WorkspaceWriteStanding {
  match coverage {
    WorkspaceClean => WorkspaceWritable
    WorkspaceDirty { oldest_uncommitted_write_at: t } =>
      match workspace_age_between(from: t, to: now) {
        WorkspaceAgeUndefined { order: o } => WorkspaceCoverageUndecidable { order: o }
        WorkspaceAgeOf { age: a } =>
          if at_least(span: a, bound: policy.outage_deadline) {
            WorkspaceStorageOutage { outage: DeclaredStorageOutage { workspace: workspace, declared_at: now, oldest_uncommitted_write_at: t } }
          } else {
            if at_least(span: a, bound: policy.checkpoint_target) { WorkspaceCommitDue { age: a } } else { WorkspaceWritable }
          }
      }
  }
}

// ── LOSS OF THE VOLATILE COPY: ORDINARY RECOVERY OR THE NAMED COMPOUND FAILURE ─────────────────
//
// Losing the host, drive or rack loses the working copy. Restoring the last committed revision is
// the ORDINARY recovery when every write it loses is younger than the window. Losing the sole copy
// while coverage could not be kept -- during a declared outage, or with a pending write already past
// the window before one was entered -- is the COMPOUND FAILURE: outside the ordinary guarantee,
// typed and receipted with its billing disposition (failure-billing-semantics), never reported as an
// ordinary recovery. A loss whose age cannot be computed is not classified as either: it is its own
// arm, receipted for investigation, because claiming "within window" without an age is the
// fabricated plausible answer DESIGN 5 forbids.
type WorkspaceCompoundCause
  = LostDuringDeclaredOutage { outage: DeclaredStorageOutage }
  | CoverageLapsedBeforeOutage { oldest_uncommitted_write_age: Nanosecond, window: Nanosecond }

type WorkspaceLoss
  = WorkspaceLossWithinWindow { uncovered_age: Nanosecond }
  | WorkspaceCompoundFailure { cause: WorkspaceCompoundCause }
  | WorkspaceLossUnclassifiable { order: InstantOrder }

fn workspace_loss_classify(policy: WorkspaceDurabilityPolicy, standing: WorkspaceWriteStanding, coverage: WorkspaceCoverage, lost_at: ObservationInstant) -> WorkspaceLoss {
  match standing {
    WorkspaceStorageOutage { outage: o } => WorkspaceCompoundFailure { cause: LostDuringDeclaredOutage { outage: o } }
    WorkspaceCoverageUndecidable { order: o } => WorkspaceLossUnclassifiable { order: o }
    WorkspaceWritable => workspace_loss_by_age(policy: policy, coverage: coverage, lost_at: lost_at)
    WorkspaceCommitDue { age: _ } => workspace_loss_by_age(policy: policy, coverage: coverage, lost_at: lost_at)
  }
}

fn workspace_loss_by_age(policy: WorkspaceDurabilityPolicy, coverage: WorkspaceCoverage, lost_at: ObservationInstant) -> WorkspaceLoss {
  match oldest_uncommitted_write_age(coverage: coverage, now: lost_at) {
    WorkspaceAgeUndefined { order: o } => WorkspaceLossUnclassifiable { order: o }
    WorkspaceAgeOf { age: a } =>
      if at_least(span: a, bound: policy.window) {
        WorkspaceCompoundFailure { cause: CoverageLapsedBeforeOutage { oldest_uncommitted_write_age: a, window: policy.window } }
      } else {
        WorkspaceLossWithinWindow { uncovered_age: a }
      }
  }
}
