module std.determinism


type Determinism
  = Deterministic
  | NonDeterministic { source: std.decl_ref.DeclarationRef }

fn determinism_from_perturbation(verdict: std.perturbation.PerturbationVerdict, reached: std.decl_ref.DeclarationRef) -> Determinism {
  match verdict {
    ResponseConsistent => Deterministic
    ResponseViolation => NonDeterministic { source: reached }
  }
}

fn determinism_compose(outer: Determinism, inner: Determinism) -> Determinism {
  match outer {
    NonDeterministic { source: s } => NonDeterministic { source: s }
    Deterministic => inner
  }
}
