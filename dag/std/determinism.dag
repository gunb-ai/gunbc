module std.determinism

import std.perturbation { PerturbationVerdict, ResponseConsistent, ResponseViolation }
import std.decl_ref { DeclarationRef }

type Determinism
  = Deterministic
  | NonDeterministic { source: DeclarationRef }

fn determinism_from_perturbation(verdict: PerturbationVerdict, reached: DeclarationRef) -> Determinism {
  match verdict {
    ResponseConsistent => Deterministic
    ResponseViolation => NonDeterministic { source: reached }
  }
}

fn determinism_compose(outer: Determinism, inner: Determinism) -> Determinism {
  match outer {
    NonDeterministic { source: s } => NonDeterministic { source: s }
    Deterministic => inner
  }
}
