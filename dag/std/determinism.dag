module std.determinism


type DeterminismAxis
  = Deterministic
  | NonDeterministic { source: DeclarationRef }

fn determinism_from_perturbation(verdict: PerturbationVerdict, reached: DeclarationRef) -> DeterminismAxis {
  match verdict {
    ResponseConsistent => Deterministic
    ResponseViolation => NonDeterministic { source: reached }
  }
}

fn determinism_compose(outer: DeterminismAxis, inner: DeterminismAxis) -> DeterminismAxis {
  match outer {
    NonDeterministic { source: s } => NonDeterministic { source: s }
    Deterministic => inner
  }
}
