module std.machine_width_range

import std.types { Int, Bool }
import std.integer { Signedness, Signed, Unsigned }
import std.integer_interval { integer_extent_admits, integer_machine_interval_spec }
import std.measure { BitWidth, bit_width_count }

// HOME: a module of its own beside std.machine_constraints, not a declaration inside it, because
// std.machine_constraints is in the stage0 seed closure and this reads std.measure and std.power_of_two,
// which that closure has no crate for (heal: Stage0EmittedEdgesNotCovered). The meaning is still ONE
// declaration; only its module differs.
// WHICH INTEGERS A MACHINE WIDTH ADMITS, AS THE WIDTH'S OWN MEANING AND NOT A CONSUMER'S TABLE.
// `unsigned` bits N is [0, 2^N - 1]; signed bits N is [-2^(N-1), 2^(N-1) - 1]. A literal at a
// position typed Compose<A, MachineWidth<N>> is admitted only when this holds (v2.compiler.infer
// infer_int_literal_value_at); it is the checked reading of the width rule -- a width is a
// refinement on Int, narrowing into it is a checked, named route, and same-signedness widening is
// the implicit-safe coercion of gunbc.design_ruling coercion_is_the_implicit_safe_subset, so nothing
// is silently truncated -- applied at the literal boundary.
//
// The host Int is converted to exact decimal magnitude without negating its minimum.
// Membership then reads the shared interval authority; no second host-width range table.
// This accepts only values the caller can carry exactly, not unrepresentable wide literals.
//
// WIDTH ZERO, STATED ONCE: the unsigned range [0, 2^0 - 1] is {0}; the signed range [-2^(N-1), 2^(N-1) - 1]
// at N = 0 is empty (2^-1 is not an integer), so a signed zero width admits nothing. Whether a zero width
// is a VALID machine width is a separate question, left to the declaration that names MachineWidth<0>
// (std.machine_word's WordWidth has no zero member); this function answers only membership.
fn machine_width_admits(signedness: Signedness, bits: BitWidth, value: Int) -> Bool {
  integer_extent_admits(extent: integer_machine_interval_spec(signedness: signedness, width_bits: bit_width_count(b: bits)), value: value)
}
