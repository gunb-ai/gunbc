module std.machine_width_range

import std.types { Int, Bool, List, String }
import std.integer { Signedness, Signed, Unsigned }
import std.power_of_two { bitwise_pow2 }
import std.measure { BitWidth, bit_width_count }
import std.optional { Absent, Optional, Present }
import std.decl_ref { DeclarationRef, decl_ref }
import std.algebra { Cons, Empty }

// HOME: a module of its own beside std.machine_constraints, not a declaration inside it, because
// std.machine_constraints is in the stage0 seed closure and this reads std.measure and std.power_of_two,
// which that closure has no crate for (heal: Stage0EmittedEdgesNotCovered). The meaning is still ONE
// declaration; only its module differs.
// WHICH INTEGERS A MACHINE WIDTH ADMITS, AS THE WIDTH'S OWN MEANING AND NOT A CONSUMER'S TABLE.
// `unsigned` bits N is [0, 2^N - 1]; signed bits N is [-2^(N-1), 2^(N-1) - 1]. A literal at a
// position typed Compose<A, MachineWidth<N>> is admitted only when this holds (v2.compiler.infer
// infer_int_literal_value_at); it is the CHECKED reading of the operator ruling -- a width is a
// refinement on Int, never a silent truncation or widening -- applied at the literal boundary.
//
// THE HOST BOUND: a source literal is a host Int (signed 64), so every host value fits width >= 64
// when signed, and every non-negative one fits width >= 64 when unsigned; the table-driven range
// below is therefore only consulted where 2^N or 2^(N-1) is itself a host Int, which std.power_of_two covers totally.
//
// WIDTH ZERO, STATED ONCE: the unsigned range [0, 2^0 - 1] is {0}; the signed range [-2^(N-1), 2^(N-1) - 1]
// at N = 0 is empty (2^-1 is not an integer), so a signed zero width admits nothing. Whether a zero width
// is a VALID machine width is a separate question, left to the declaration that names MachineWidth<0>
// (std.machine_word's WordWidth has no zero member); this function answers only membership.
fn machine_width_admits(signedness: Signedness, bits: BitWidth, value: Int) -> Bool {
  let n = bit_width_count(b: bits)
  let signed = match signedness {
    Signed => true
    Unsigned => false
  }
  if n < 1 {
    !signed && n == 0 && value == 0
  } else if n >= 64 || (!signed && n >= 63) {
    signed || value >= 0
  } else if signed {
    let half = bitwise_pow2(n: n - 1)
    value >= 0 - half && value < half
  } else {
    value >= 0 && value < bitwise_pow2(n: n)
  }
}

// WHAT A TYPE SAYS ABOUT ITS MACHINE WIDTH, IN THREE ANSWERS, DECIDED ONCE (fail closed, DESIGN section 5). A
// type is NotWidthConstrained when it names no MachineWidth, so the grounding and homomorphism path decides;
// WidthReadable when it is Compose<A, MachineWidth<N>> with a literal N and a carrier A whose signedness is
// declared (the kernel Int signed, std.nat Nat unsigned); and WidthUnreadable when it IS width-constrained but
// the width cannot be read -- a malformed Compose, a named width such as MachineWidth<PointerWidth>
// (std.integer IntPlatform, UIntPlatform), a carrier whose signedness is not declared. An unreadable width
// refuses, typed: it is neither admitted by guessing a width nor handed to ordinary grounding, which would
// accept any value the carrier accepts.
// ONE DERIVATION FOR EVERY COMPILER THAT READS A WIDTH. Each compiler walks its own Node tree, so what it hands
// here is the parts it extracted (MachineWidthTypeArgument), never a judgment: whether those parts make a
// width, and which, is this function's answer. A reader that re-derives it from its own tree is a second
// authority for one fact (DESIGN section 3).
type MachineWidthReading
  = NotWidthConstrained
  | WidthReadable { signedness: Signedness, bits: BitWidth }
  | WidthUnreadable { cause: MachineWidthUnreadable }

type MachineWidthUnreadable
  = WidthComposeMalformed
  | WidthNotStatic
  | WidthCarrierSignednessUndeclared

// ONE TYPE ARGUMENT, AS ITS COMPILER EXTRACTED IT: the declaration it names (absent for a kernel type or an
// unnamed one), whether it is the kernel Int, and its own sole argument when that argument is an integer
// literal (MachineWidth<8> -> 8; MachineWidth<PointerWidth> and MachineWidth<> -> absent).
type MachineWidthTypeArgument {
  head: Optional<DeclarationRef>
  is_kernel_int: Bool
  sole_literal_argument: Optional<BitWidth>
}

fn machine_width_reading(head: Optional<DeclarationRef>, arguments: List<MachineWidthTypeArgument>) -> MachineWidthReading {
  if machine_width_head_is(head: head, decl_name: "Compose") {
    match arguments {
      Cons { head: carrier, tail: Cons { head: width, tail: Empty } } =>
        if machine_width_head_is(head: width.head, decl_name: "MachineWidth") {
          match width.sole_literal_argument {
            Absent => WidthUnreadable { cause: WidthNotStatic }
            Present { value: bits } =>
              match machine_width_carrier_signedness(carrier: carrier) {
                Absent => WidthUnreadable { cause: WidthCarrierSignednessUndeclared }
                Present { value: signedness } => WidthReadable { signedness: signedness, bits: bits }
              }
          }
        } else {
          NotWidthConstrained
        }
      Cons { head: _, tail: _ } => WidthUnreadable { cause: WidthComposeMalformed }
      Empty => WidthUnreadable { cause: WidthComposeMalformed }
    }
  } else {
    NotWidthConstrained
  }
}

// THE CARRIER'S SIGNEDNESS IS DECLARED BY WHICH CARRIER IT IS: the kernel Int is signed and std.nat Nat is
// unsigned. std.integer UInt = Nat unfolds to Nat before a compiler extracts it, so it needs no case here.
fn machine_width_carrier_signedness(carrier: MachineWidthTypeArgument) -> Optional<Signedness> {
  if carrier.is_kernel_int {
    Present { value: Signed }
  } else {
    match carrier.head {
      Present { value: d } =>
        if d == decl_ref(module_path: "std.nat", decl_name: "Nat") { Present { value: Unsigned } } else { Absent }
      Absent => Absent
    }
  }
}

fn machine_width_head_is(head: Optional<DeclarationRef>, decl_name: String) -> Bool {
  match head {
    Present { value: d } => d == decl_ref(module_path: "std.machine_constraints", decl_name: decl_name)
    Absent => false
  }
}
