module std.spatial_knowledge

import std.types { Bool, NonEmptyStr }

// SPATIAL-1: the epistemic layer for physical-world quantities, landed BEFORE any geometry
// carrier (points, surfaces, openings, enclosed spaces) per the spatial-world-kernel directive's
// ordering: epistemics before geometry. It exists because the opposite was tried and measured — a
// site packet rendered a dimensioned 25 x 30 ft floor plan from hand-authored constants while the
// typed authority held zero measured dimensions, and its premise was refuted by parcel records.
// No lens could see that defect: the fabricated geometry was ordinary data of an ordinary type.
//
// The move is construction, not validation (DESIGN section 5): a spatial quantity is never a bare
// magnitude. It is a magnitude WITH the epistemic standing that produced it, and the standing has
// no erasing projection — there is deliberately no total fn(SpatialKnowledge<T, Ev>) -> T. A
// consumer that wants a number must present the standing it requires and accept a typed refusal.
//
// Evidence is a TYPE PARAMETER, never a field set minted here: std.claim_evidence already owns the
// evidence relation (RecordedFact, EvidenceLink, EvidenceProvenance, EvidenceFidelity), so a
// {value, tolerance, evidence-provenance-fields} record authored here would fork that authority
// (DESIGN section 3). Ev is whatever the consuming layer already grounds its facts with.
//
// Identity is likewise absent by construction: product.placement_supply is SPATIAL-0, the existing
// authority for SiteIdentity / RoomIdentity / PhysicalContainment. This module binds geometry to
// nothing; the product layer binds standing-carrying quantities to the identities it already owns.

type SurveyObligationId = NonEmptyStr where brand("SurveyObligationId")

type SpatialMethodId = NonEmptyStr where brand("SpatialMethodId")

// The four standings a physical quantity can hold. Distinguishing these is the whole point: an
// estimate and a measurement differ in what they license, and collapsing them is how a prior
// becomes a fact. SpatialUnknown is a FIRST-CLASS arm, not an absence — "we did not observe it"
// is a state with a remedy (the named survey obligation), never a hole to be filled by a default.
type SpatialEvidenceClass
  = SpatialClassMeasured
  | SpatialClassEstimated
  | SpatialClassHypothesis
  | SpatialClassUnknown

// A measurement carries its tolerance because a measurement without one is a claim of exactness
// no instrument makes. An estimate carries a RANGE and its method, never a midpoint — collapsing
// a range to its centre is the fabricated-plausible-output failure at the arithmetic layer. A
// hypothesis carries the PURPOSE it was raised for, so an unfalsified guess cannot drift into
// evidence by being useful. Unknown carries the obligation that discharges it.
type SpatialKnowledge<T, Ev>
  = SpatialMeasured { value: T, tolerance: T, evidence: Ev }
  | SpatialEstimated { low: T, high: T, method: SpatialMethodId, evidence: Ev }
  | SpatialHypothesis { value: T, purpose: NonEmptyStr }
  | SpatialUnknown { survey_obligation: SurveyObligationId }

type SpatialKnowledgeFold<T, Ev, R> {
  measured: fn(T, T, Ev) -> R
  estimated: fn(T, T, SpatialMethodId, Ev) -> R
  hypothesis: fn(T, NonEmptyStr) -> R
  unknown: fn(SurveyObligationId) -> R
}

fn spatial_knowledge_fold<T, Ev, R>(
  knowledge: SpatialKnowledge<T, Ev>,
  fold: SpatialKnowledgeFold<T, Ev, R>,
) -> R {
  match knowledge {
    SpatialMeasured { value: v, tolerance: t, evidence: e } => fold.measured(v, t, e)
    SpatialEstimated { low: lo, high: hi, method: m, evidence: e } => fold.estimated(lo, hi, m, e)
    SpatialHypothesis { value: v, purpose: p } => fold.hypothesis(v, p)
    SpatialUnknown { survey_obligation: s } => fold.unknown(s)
  }
}

// The projection a renderer MUST consult (directive witness control 14: hypothesis geometry must
// render as hypothesis). It reports standing and nothing else — it cannot leak a magnitude, so a
// renderer cannot use it to draw while ignoring what it says.
fn spatial_evidence_class<T, Ev>(
  knowledge: SpatialKnowledge<T, Ev>,
) -> SpatialEvidenceClass {
  match knowledge {
    SpatialMeasured { value: _, tolerance: _, evidence: _ } => SpatialClassMeasured
    SpatialEstimated { low: _, high: _, method: _, evidence: _ } => SpatialClassEstimated
    SpatialHypothesis { value: _, purpose: _ } => SpatialClassHypothesis
    SpatialUnknown { survey_obligation: _ } => SpatialClassUnknown
  }
}

// The ONLY route from a standing-carrying quantity to a bare magnitude, and it is partial by
// construction. Directive witness control 2 — unknown geometry cannot default to a rectangle — is
// discharged here: Absent is the sole answer for the three non-measured arms, and no sibling
// function offers a fallback (a `spatial_value_or` would BE the absorbing fallback, so none exists).
fn spatial_measured_value<T, Ev>(knowledge: SpatialKnowledge<T, Ev>) -> T? {
  match knowledge {
    SpatialMeasured { value: v, tolerance: _, evidence: _ } => Present { value: v }
    SpatialEstimated { low: _, high: _, method: _, evidence: _ } => Absent
    SpatialHypothesis { value: _, purpose: _ } => Absent
    SpatialUnknown { survey_obligation: _ } => Absent
  }
}

// What a consuming decision demands. The directive's metrology rule states that required tolerance
// is set by the CONSUMING DECISION, never by the instrument, so the requirement is an input to
// admission rather than a property of the quantity: furniture layout admits an estimate, a code
// or egress clearance does not.
type SpatialRequirement
  = RequiresMeasured
  | RequiresMeasuredOrEstimated

type SpatialRefusalCause
  = SpatialGeometryUnknown { survey_obligation: SurveyObligationId }
  | SpatialHypothesisNotAdmissible { purpose: NonEmptyStr }
  | SpatialEstimateBelowRequiredStanding { method: SpatialMethodId }

// Admission preserves range-ness: an admitted ESTIMATE stays a range. There is no arm carrying a
// single T for an estimated quantity, so "admitted, therefore a number" is unwritable — the
// midpoint collapse has no constructor. A refusal is typed and located (it names the obligation,
// the purpose, or the method), so the deficit stays countable instead of being absorbed.
type SpatialAdmission<T>
  = SpatialAdmittedMeasured { value: T, tolerance: T }
  | SpatialAdmittedEstimated { low: T, high: T }
  | SpatialRefused { cause: SpatialRefusalCause }

fn admit_spatial_quantity<T, Ev>(
  knowledge: SpatialKnowledge<T, Ev>,
  requirement: SpatialRequirement,
) -> SpatialAdmission<T> {
  match knowledge {
    SpatialMeasured { value: v, tolerance: t, evidence: _ } =>
      SpatialAdmittedMeasured { value: v, tolerance: t }
    SpatialEstimated { low: lo, high: hi, method: m, evidence: _ } =>
      match requirement {
        RequiresMeasured => SpatialRefused { cause: SpatialEstimateBelowRequiredStanding { method: m } }
        RequiresMeasuredOrEstimated => SpatialAdmittedEstimated { low: lo, high: hi }
      }
    SpatialHypothesis { value: _, purpose: p } =>
      SpatialRefused { cause: SpatialHypothesisNotAdmissible { purpose: p } }
    SpatialUnknown { survey_obligation: s } =>
      SpatialRefused { cause: SpatialGeometryUnknown { survey_obligation: s } }
  }
}

fn spatial_admission_is_refused<T>(admission: SpatialAdmission<T>) -> Bool {
  match admission {
    SpatialAdmittedMeasured { value: _, tolerance: _ } => false
    SpatialAdmittedEstimated { low: _, high: _ } => false
    SpatialRefused { cause: _ } => true
  }
}

// A quantity is renderable as definite geometry only when it is measured. Every other standing is
// renderable only as itself — which is what the site packet now does, and what it previously did
// not: it drew a hypothesis at the confidence of a measurement.
fn spatial_renders_as_definite<T, Ev>(knowledge: SpatialKnowledge<T, Ev>) -> Bool {
  match spatial_evidence_class(knowledge: knowledge) {
    SpatialClassMeasured => true
    SpatialClassEstimated => false
    SpatialClassHypothesis => false
    SpatialClassUnknown => false
  }
}
