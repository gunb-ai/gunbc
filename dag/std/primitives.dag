}

// replace(s, from, to): every occurrence of `from` (length m) in `s` (length n) replaced by `to`
// (length k). The bound is total over accepted inputs, including an empty `from`, which matches at
// every one of the n + 1 boundaries: at most n + 1 matches each write k, so the output is at most
// n + (n + 1) * k. Work covers comparing each position against `from` and writing that output:
// n * m + m + n + (n + 1) * k, below (n + 1) * (m + k + 1).
data replace_contract: PrimitiveContract = {
  name: "replace",
  work: "(n + 1) * (m + k + 1)",
  output_size: "n + (n + 1) * k",
  certainty: Conservative,
  carrier_cost: CarrierInsensitive
}

