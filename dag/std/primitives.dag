module std.primitives
import std.types { List }

type Certainty = Proven | Amortized | Expected | Conservative

type CarrierCostSensitivity
  = CarrierInsensitive
  | CarrierSensitive { ephemeral_work: String, persistent_work: String }

type PrimitiveContract {
  name: String
  work: String
  output_size: String
  certainty: Certainty
  carrier_cost: CarrierCostSensitivity
}

data char_at_contract: PrimitiveContract = {
  name: "char_at",
  work: "pos",
  output_size: "1",
  certainty: Proven,
  carrier_cost: CarrierInsensitive
}

data string_length_contract: PrimitiveContract = {
  name: "string_length",
  work: "n",
  output_size: "1",
  certainty: Proven,
  carrier_cost: CarrierInsensitive
}

// Work is linear in the message, as any MAC over it must be. The output is one bit -- deliberately,
// since extdeps.crypto.mac exposes no computed tag: the comparison happens inside the bound
// implementation, in constant time, and a caller that could see the tag could compare it in
// variable time instead.
data hmac_sha256_verify_hex_contract: PrimitiveContract = {
  name: "hmac_sha256_verify_hex",
  work: "n",
  output_size: "1",
  certainty: Proven,
  carrier_cost: CarrierInsensitive
}

// Issuance: work linear in the message, output the 64 lowercase hex digits of a 32-octet tag. A
// SECOND contract rather than a widened verify, because only the key holder mints; a verifier keeps
// its one-bit answer (hmac_sha256_verify_hex_contract above) and never sees a tag to compare.
data hmac_sha256_hex_contract: PrimitiveContract = {
  name: "hmac_sha256_hex",
  work: "n",
  output_size: "64",
  certainty: Proven,
  carrier_cost: CarrierInsensitive
}

