data primitive_contract_roster_note: String = "Hand-maintained parallel enumeration of every *_contract data declaration in this module. A new foo_contract row silently under-reports on primitive_surface_census_derived until this roster is updated — the open-denominator class D0 is designed to expose. Dissolve-on: derive the roster by enumerating *_contract declarations once declaration introspection lands, so contract surfaces read the module rather than a second list."

fn primitive_contract_roster() -> List<PrimitiveContract> {
  [
    char_at_contract,
    string_length_contract,
    substring_contract,
    string_contains_contract,
    starts_with_contract,
    ends_with_contract,
    trim_contract,
    concat_contract,
    split_contract,
    repeat_contract,
    chars_contract,
    to_string_contract,
    parse_int_contract,
    str_eq_contract,
    replace_section_contract,
    code_point_contract,
    from_code_point_contract,
    scan_while_contract,
    skip_horizontal_ws_contract,
    scan_to_eol_contract,
    scan_string_end_contract,
    map_contract,
    filter_contract,
    filter_map_contract,
    flat_map_contract,
    fold_contract,
    any_contract,
    all_contract,
    contains_contract,
    join_contract,
    sort_contract,
    sort_by_contract,
    dedup_contract,
    len_contract,
    count_contract,
    sum_contract,
    first_contract,
    last_contract,
    get_contract,
    max_by_contract,
    reverse_contract,
    list_push_contract,
    append_contract,
    skip_contract,
    zip_contract,
    enumerate_contract,
    empty_map_contract,
    map_insert_contract,
    map_get_contract,
    map_contains_key_contract,
    lookup_contract,
    map_merge_contract,
    map_keys_contract,
    map_values_contract,
    index_by_contract,
    with_contract,
    filesystem_read_contract,
    to_bytes_contract,
    to_json_contract,
    hash_contract,
    hash_combine_contract,
    atom_identity_hash_contract,
    contiguous_loop_elementwise_kernel_contract,
    contiguous_loop_elementwise_float_kernel_contract,
  ]
}
