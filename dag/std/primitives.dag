data primitive_contract_roster_note: String = "Hand-maintained parallel enumeration of every *_contract data declaration in this module. A new foo_contract row silently under-reports on primitive_surface_census_derived until this roster is updated — the open-denominator class D0 is designed to expose. Dissolve-on: derive the roster by enumerating *_contract declarations once declaration introspection lands, so contract surfaces read the module rather than a second list."

fn primitive_contract_roster() -> List<PrimitiveContract> {
  [
    char_at_contract,
    string_length_contract,
    hmac_sha256_verify_hex_contract,
    hmac_sha256_hex_contract,
    substring_contract,
    string_contains_contract,
    starts_with_contract,
    ends_with_contract,
    trim_contract,
    concat_contract,
    split_contract,
    repeat_contract,
    machine_word_native_operate_contract,
    to_string_contract,
    parse_int_contract,
    str_eq_contract,
    replace_section_contract,
    replace_contract,
    code_point_contract,
    scan_while_contract,
    skip_horizontal_ws_contract,
    scan_to_eol_contract,
    scan_string_end_contract,
    json_unescape_checked_contract,
    map_contract,
    filter_contract,
    filter_map_contract,
    flat_map_contract,
    fold_contract,
    any_contract,
    all_contract,
    contains_contract,
    join_contract,
    sort_contract,
    sort_by_contract,
    dedup_contract,
    len_contract,
    count_contract,
    sum_contract,
    first_contract,
    last_contract,
    get_contract,
    max_by_contract,
    reverse_contract,
    append_contract,
    skip_contract,
    take_contract,
    zip_contract,
    enumerate_contract,
    empty_map_contract,
    map_insert_contract,
    map_get_contract,
    map_contains_key_contract,
    lookup_contract,
    map_merge_contract,
    map_values_contract,
    sorted_map_keys_contract,
    index_by_contract,
    with_contract,
    filesystem_read_contract,
    to_bytes_contract,
    to_json_contract,
    hash_contract,
    hash_combine_contract,
    atom_identity_hash_contract,
    contiguous_loop_elementwise_kernel_contract,
    contiguous_loop_elementwise_float_kernel_contract,
  ]
}

// ---------------------------------------------------------------------------
// ConstructorTag: the typed arm identity of a coproduct inhabitant.
//
// WHY IT IS SHAPED THIS WAY. A tag must be comparable only through `same_arm`, never through
// `==`, and must never expose the discriminant it identifies. Both are enforced by the shape
// itself, with no new vocabulary:
//   * the one member is function-valued, and a function value has no equality denotation --
//     `==` and `!=` on a ConstructorTag refuse at typecheck (the accepted rule behind
//     `v1.compiler.infer.equality_admission_wall_note`: `==` on a function-valued member is
//     the refusal, not a convention);
//   * `sole_constructor` makes construction legal only inside THIS file, and `tag_of` is the only
//     function that builds one, so no consumer can mint a tag or choose what a tag matches.
// A record with an Int tag or a String name would fail the second clause twice over: it would
// carry a discriminant in its public shape and derive a structural `==` (both measured; see
// dag/gunbc/recurring_failure_mode/one_type_variable_bound_to_two_distinct_coproducts.dag).
//
// NAMED ARMS. `tag_of(v: Unit0)` names a unit arm as a value at a user function's argument
// position and works generically. A PAYLOAD arm cannot be named outside `discriminant`'s own
// argument -- the tag-reference result is granted only when the callee IS `discriminant`
// (v1.compiler.infer payload_arm_tag_reference_waiver_results, enumerated arm declarations only), so `tag_of(v: WithPayload {})`
// refuses. Naming a payload arm as a value is the trigger for the frontier recorded on
// dag/gunbc/recurring_failure_mode/one_type_variable_bound_to_two_distinct_coproducts.dag;
// until then a payload arm's tag comes from a value of that arm.
type ConstructorTag<T> sole_constructor {
  accepts: fn(T) -> Bool
}

// THE ONLY WAY TO MINT A TAG. The caller supplies a VALUE (or, for a unit arm, the arm spelled
// as a value) and nothing else -- the predicate below is the only `fn` ever stored in a
// ConstructorTag, and it is written in this file. That is deliberate and load-bearing: an
// earlier shape exposed `constructor_tag<T>(accepts: fn(T) -> Bool)`, and because
// `sole_constructor` guards only the RECORD LITERAL, `constructor_tag(accepts: fn(_w) { true })`
// minted a tag that `same_arm` reported as matching EVERY arm (measured PASS, so it was real).
// A predicate-taking entry is a forgery route by construction, and DESIGN section 4b is explicit
// that a brand is cosmetic until construction enforces it -- so the entry is gone rather than
// documented as "elaboration-only". There is no visibility mechanism to fall back on either:
// `public` is not a gate in resolve, and type modifiers are dropped at parse
// (v1.compiler.parse drop_leading_type_modifier), so `sole_constructor` is the only construction
// control the language has.
//
// The identity is what `discriminant` yields, keyed on T's declaration. `discriminant` still returns a String internally, but the carrier
// stores only a predicate over T and exposes no string, so a
// tag cannot be forged from text either. Elaboration for `x is V` calls THIS function on the arm
// it resolved against T's declared roster; it needs no separate entry, because for a unit arm the
// arm reference is exactly the value `tag_of` takes. For a payload arm there is no arm-reference
// value to pass (see the frontier note on
// dag/gunbc/recurring_failure_mode/one_type_variable_bound_to_two_distinct_coproducts.dag), so
// elaboration passes a value of that arm -- which is the same identity, and is a control.
fn tag_of<T>(v: T) -> ConstructorTag<T> {
  ConstructorTag { accepts: fn(w) { discriminant(v: v) == discriminant(v: w) } }
}

// THE one exposed comparison, and the only equality between two arms: does `v` inhabit the
// arm `tag` names? Payloads are blind -- same arm with different payloads answers true, a
// different arm answers false. There is no `==` on ConstructorTag itself.
//
// Bind-then-call is required: a member call on a record receiver has no method surface, and
// the corpus invokes fn-valued members through a binding (`monoid.op(acc, patch)`).
fn same_arm<T>(tag: ConstructorTag<T>, v: T) -> Bool {
  let accepts = tag.accepts
  accepts(v)
}
