module std.http_path

type UrlPathToken
  = LiteralToken { text: String }
  | ParamToken   { name: String }

type PathTemplate {
  tokens: List<UrlPathToken>
}

fn has_path_params(template: PathTemplate) -> Bool {
  any(template.tokens, t =>
    match t {
      ParamToken => true
      LiteralToken => false
    })
}

fn last_path_param(template: PathTemplate) -> String? {
  let params = template.tokens |> filter(t =>
    match t {
      ParamToken => true
      LiteralToken => false
    })
  match params |> last {
    Present { value: tok } =>
      match tok {
        ParamToken { name: n } => Present { value: n }
        LiteralToken => none
      }
    Absent => none
  }
}

type PathParamBinding {
  name: String
  value: String
}

fn path_param_value(params: List<PathParamBinding>, name: String) -> String {
  fold(params, init: "", f: (acc, binding) => {
    if acc != "" {
      acc
    } else if binding.name == name {
      binding.value
    } else {
      acc
    }
  })
}

fn render_path_template(template: PathTemplate, params: List<PathParamBinding>) -> String {
  fold(template.tokens, init: "", f: (acc, tok) => match tok {
    LiteralToken { text: t } => concat(acc, t)
    ParamToken { name: n } => concat(acc, path_param_value(params: params, name: n))
  })
}
