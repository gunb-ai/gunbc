module std.effects

import std.types { HttpMethod, GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS, String, List }
import std.realization_schedule { string_list_eq }
import std.http_path {
  PathTemplate,
  has_path_params, last_path_param
}

type EffectShape
  = ReadEffect
  | UpsertEffect { key_source: KeySource }
  | DeleteEffect { key_source: KeySource }
  | CreateEffect { cause: CreateCause }
  | AppendEffect

type CreateCause
  = PostAlways
  | CreateIfAbsent { key_source: KeySource }

type KeySource
  = PathParam { param: String }
  | InputField { field: String }
  | CompositeKey { fields: List<String> }

type IdempotencyEvidence
  = LatticeEffect { shape: EffectShape }
  | IdentityEffect
  | NonIdempotent { shape: EffectShape, reason: String }

fn is_idempotent_effect(shape: EffectShape) -> Bool {
  match shape {
    ReadEffect => true
    UpsertEffect => true
    DeleteEffect => true
    CreateEffect { cause: cause } =>
      match cause {
        CreateIfAbsent { key_source: key_source } => true
        PostAlways => false
      }
    AppendEffect => false
  }
}

fn key_source_eq(left: KeySource, right: KeySource) -> Bool {
  match left {
    PathParam { param: pa } => match right {
      PathParam { param: pb } => pa == pb
      _ => false
    }
    InputField { field: fa } => match right {
      InputField { field: fb } => fa == fb
      _ => false
    }
    CompositeKey { fields: fa } => match right {
      CompositeKey { fields: fb } => string_list_eq(left: fa, right: fb)
      _ => false
    }
  }
}

fn create_effect_is_dedupable(shape: EffectShape) -> Bool {
  match shape {
    CreateEffect { cause: cause } =>
      match cause {
        CreateIfAbsent { key_source: key_source } => true
        PostAlways => false
      }
    _ => false
  }
}

fn create_double_init_collapsible(a: EffectShape, b: EffectShape) -> Bool {
  match a {
    CreateEffect { cause: cause_a } =>
      match cause_a {
        CreateIfAbsent { key_source: ka } =>
          match b {
            CreateEffect { cause: cause_b } =>
              match cause_b {
                CreateIfAbsent { key_source: kb } => key_source_eq(left: ka, right: kb)
                PostAlways => false
              }
            _ => false
          }
        PostAlways => false
      }
    _ => false
  }
}

type OperationEffect {
  operation_name: String
  shape: EffectShape
  evidence: IdempotencyEvidence
}

type CompositionVerdict
  = IdempotentComposition
  | BrokenBy { first_breaker: OperationEffect }

fn compose_effects(effects: List<OperationEffect>) -> CompositionVerdict {
  fold(effects, init: IdempotentComposition, f: (acc, e) =>
    match acc {
      BrokenBy { first_breaker: breaker } => acc
      IdempotentComposition =>
        match e.evidence {
          NonIdempotent { shape: shape, reason: reason } => BrokenBy { first_breaker: e }
          LatticeEffect { shape: shape } => IdempotentComposition
          IdentityEffect => IdempotentComposition
        }
    }
  )
}

fn composition_is_idempotent(v: CompositionVerdict) -> Bool {
  match v {
    IdempotentComposition => true
    BrokenBy { first_breaker: breaker } => false
  }
}

fn composition_first_breaker_name(v: CompositionVerdict) -> String {
  match v {
    BrokenBy { first_breaker: breaker } => breaker.operation_name
    IdempotentComposition => ""
  }
}

type DerivedOpEffect {
  operation_name: String
  method: HttpMethod
  path_template: PathTemplate
  shape: EffectShape
}

type DeriveOpEffectResult
  = DerivedEffect { effect: DerivedOpEffect }
  | MalformedPathInput {
      operation_name: String,
      method: HttpMethod,
      raw_path: String,
      segment: String,
      reason: String
    }

fn derive_effect_shape(
  method: HttpMethod,
  path: PathTemplate
) -> EffectShape {
  match method {
    GET     => ReadEffect
    HEAD    => ReadEffect
    OPTIONS => ReadEffect
    POST    => CreateEffect { cause: PostAlways }
    DELETE =>
      match last_path_param(template: path) {
        Present { value: p } => DeleteEffect { key_source: PathParam { param: p } }
        Absent => CreateEffect { cause: PostAlways }
      }
    PUT =>
      match last_path_param(template: path) {
        Present { value: p } => UpsertEffect { key_source: PathParam { param: p } }
        Absent => CreateEffect { cause: PostAlways }
      }
    PATCH =>
      match last_path_param(template: path) {
        Present { value: p } => UpsertEffect { key_source: PathParam { param: p } }
        Absent => CreateEffect { cause: PostAlways }
      }
  }
}

fn derive_op_effect(
  operation_name: String,
  method: HttpMethod,
  path: PathTemplate
) -> DeriveOpEffectResult {
  let shape = derive_effect_shape(method: method, path: path)
  DerivedEffect { effect: DerivedOpEffect {
    operation_name: operation_name,
    method: method,
    path_template: path,
    shape: shape
  } }
}

type ModifierAgreement
  = Agrees
  | Disagrees          { reason: String }
  | DerivationUnknown  { reason: String }

type ModifierCheck {
  operation_name: String
  declared_idempotent: Bool
  declared_readonly: Bool
  derived_shape: EffectShape
  agreement: ModifierAgreement
}

fn check_modifier_vs_derivation(
  op: DerivedOpEffect,
  declared_idempotent: Bool,
  declared_readonly: Bool
) -> ModifierCheck {
  let derived_idempotent = is_idempotent_effect(shape: op.shape)
  let agreement = if declared_idempotent && derived_idempotent {
    Agrees
  } else if declared_idempotent && !derived_idempotent {
    match op.shape {
      CreateEffect { cause: PostAlways } =>
        DerivationUnknown { reason: "POST with no path key derives CreateEffect; idempotency may be spec-declared" }
      _ =>
        Disagrees { reason: "derivation says non-idempotent but modifier declares idempotent" }
    }
  } else if !declared_idempotent && derived_idempotent {
    match op.shape {
      CreateEffect { cause: CreateIfAbsent { key_source: key_source } } =>
        Disagrees { reason: "create-if-absent has proven identity but modifier declares non-idempotent" }
      _ =>
        Agrees
    }
  } else if !declared_idempotent && declared_readonly {
    match op.method {
      GET => Agrees
      HEAD => Agrees
      OPTIONS => Agrees
      _ => Disagrees { reason: "readonly declared but method is not GET/HEAD/OPTIONS" }
    }
  } else {
    Agrees
  }
  ModifierCheck {
    operation_name: op.operation_name,
    declared_idempotent: declared_idempotent,
    declared_readonly: declared_readonly,
    derived_shape: op.shape,
    agreement: agreement
  }
}

type IdempotencyTestObligation {
  operation_name: String
  effect_shape: EffectShape
  claim: String
  witness_required: Bool
}

fn generate_idempotency_obligations(
  ops: List<DerivedOpEffect>
) -> List<IdempotencyTestObligation> {
  ops |> filter(o => is_idempotent_effect(shape: o.shape))
      |> map(o => IdempotencyTestObligation {
           operation_name: o.operation_name,
           effect_shape: o.shape,
           claim: "f(f(x)) == f(x)",
           witness_required: true
         })
}

type WorkflowEffectConcern {
  workflow_name: String
  create_op: String
  reason: String
}
