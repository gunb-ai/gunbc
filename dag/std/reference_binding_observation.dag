module std.reference_binding_observation


data reference_binding_observation_note: String = "Neutral structural-binding observation carrier (N3-A). Carries reference occurrence, P2a+P1 resolution (including typed index-build refusals — never collapsed to UnknownOccurrenceIdentity), and clause-local containment anchors. Carries NO ReferenceDerivedClosureCapability, ScenarioFailure, or roadmap trigger vocabulary — capability projection lives in gunbc.namespace_reference_derived_closure_admission."

type StructuralBindingResolution
  = StructuralBindingResolved {
      binding_outcome: std.occurrence_binding_resolve.OccurrenceReferenceBindingOutcome,
    }
  | StructuralBindingIndexTransportRefused {
      refusal: std.occurrence_identity.OccurrenceTransportRefusal,
    }
  | StructuralBindingIndexModulePathRefused {
      refusal: std.occurrence_binding_candidates.OccurrenceModulePathIndexRefusal,
    }
  | StructuralBindingIndexExposureRefused {
      refusal: std.occurrence_binding_candidates.DeclarationExposureIndexRefusal,
    }
  | StructuralBindingIndexAuthoredOrderRefused {
      refusal: std.occurrence_binding_candidates.AuthoredOrderIndexRefusal,
    }
  | StructuralBindingIndexDeclarationBucketRefused {
      occurrence: std.occurrence_identity.OccurrenceId,
    }
  | StructuralBindingProductionRefused {
      gap: ReferenceBindingProductionGap,
    }

type ReferenceBindingProductionGap
  = ReferenceBindingParserTransportRefused
  | ReferenceBindingNamedReferenceAbsent
  | ReferenceBindingNamedDeclarationAbsent

type ReferenceBindingObservation
  = SameFileNeighbourObservation {
      neighbour: std.occurrence_identity.OccurrenceId,
      resolution: StructuralBindingResolution,
    }
  | SameFileNeighbourProductionRefused {
      gap: ReferenceBindingProductionGap,
    }
  | SiblingBranchObservation {
      own_branch_declaration: std.occurrence_identity.OccurrenceId,
      sibling_branch_declaration: std.occurrence_identity.OccurrenceId,
      resolution: StructuralBindingResolution,
    }
  | SiblingBranchProductionRefused {
      gap: ReferenceBindingProductionGap,
    }
  | LaterDeclarationObservation {
      later_declaration: std.occurrence_identity.OccurrenceId,
      resolution: StructuralBindingResolution,
    }
  | LaterDeclarationProductionRefused {
      gap: ReferenceBindingProductionGap,
    }
  | DistinctHomonymObservation {
      first_declaration: std.occurrence_identity.OccurrenceId,
      second_declaration: std.occurrence_identity.OccurrenceId,
      resolution: StructuralBindingResolution,
    }
  | DistinctHomonymProductionRefused {
      gap: ReferenceBindingProductionGap,
    }
  | RepeatedMentionDependencyObservation {
      provider_file: std.types.FilePath,
      projected_dependencies: List<std.types.FilePath>,
    }
  | UnrelatedLoadedFileObservation {
      provider_file: std.types.FilePath,
      unrelated_loaded_file: std.types.FilePath,
      projected_dependencies: List<std.types.FilePath>,
    }

fn structural_binding_resolution_from_candidates(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: std.occurrence_binding_candidates.OccurrenceBindingCandidateInputs,
  reference: std.occurrence_identity.ReferenceOccurrence,
) -> StructuralBindingResolution {
  match std.occurrence_binding_candidates.occurrence_candidate_index_build(transport: transport, inputs: inputs) {
    std.occurrence_binding_candidates.OccurrenceCandidateIndexReady { index: index } =>
      StructuralBindingResolved {
        binding_outcome: std.occurrence_binding_resolve.resolve_reference_occurrence_binding(
          transport: transport,
          occurrence: reference.occurrence,
          supplied_candidates: std.occurrence_binding_candidates.candidate_occurrence_ids_for_reference(
            index: index,
            reference: reference,
          ),
        ),
      }
    std.occurrence_binding_candidates.OccurrenceCandidateIndexTransportRefused { refusal: refusal } =>
      StructuralBindingIndexTransportRefused { refusal: refusal }
    std.occurrence_binding_candidates.OccurrenceCandidateIndexModulePathRefused { refusal: refusal } =>
      StructuralBindingIndexModulePathRefused { refusal: refusal }
    std.occurrence_binding_candidates.OccurrenceCandidateIndexExposureRefused { refusal: refusal } =>
      StructuralBindingIndexExposureRefused { refusal: refusal }
    std.occurrence_binding_candidates.OccurrenceCandidateIndexAuthoredOrderRefused { refusal: refusal } =>
      StructuralBindingIndexAuthoredOrderRefused { refusal: refusal }
    std.occurrence_binding_candidates.OccurrenceCandidateIndexDeclarationBucketRefused { occurrence: occurrence } =>
      StructuralBindingIndexDeclarationBucketRefused { occurrence: occurrence }
  }
}
