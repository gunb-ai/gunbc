module std.reference_binding_observation

import std.occurrence_identity {
  OccurrenceId,
  OccurrenceTransportRefusal,
  ReferenceOccurrence,
  OccurrenceTransport,
}
import std.occurrence_binding_candidates {
  OccurrenceModulePathIndexRefusal,
  DeclarationExposureIndexRefusal,
  AuthoredOrderIndexRefusal,
  OccurrenceBindingCandidateInputs,
  occurrence_candidate_index_build,
  candidate_occurrence_ids_for_reference,
  OccurrenceCandidateIndexReady,
  OccurrenceCandidateIndexTransportRefused,
  OccurrenceCandidateIndexModulePathRefused,
  OccurrenceCandidateIndexExposureRefused,
  OccurrenceCandidateIndexAuthoredOrderRefused,
  OccurrenceCandidateIndexDeclarationBucketRefused,
}
import std.occurrence_binding_resolve {
  OccurrenceReferenceBindingOutcome,
  resolve_reference_occurrence_binding_validated,
}
import std.types { Bool, FilePath, Int, List, String }

// Neutral structural-binding observation carrier (N3-A). Carries reference occurrence, P2a+P1
// resolution (including typed index-build refusals — never collapsed to UnknownOccurrenceIdentity),
// and clause-local containment anchors. Carries NO ReferenceDerivedClosureCapability,
// ScenarioFailure, or roadmap trigger vocabulary — capability projection lives in
// gunbc.namespace_reference_derived_closure_admission.

type StructuralBindingResolution
  = StructuralBindingResolved {
      binding_outcome: OccurrenceReferenceBindingOutcome,
    }
  | StructuralBindingIndexTransportRefused {
      refusal: OccurrenceTransportRefusal,
    }
  | StructuralBindingIndexModulePathRefused {
      refusal: OccurrenceModulePathIndexRefusal,
    }
  | StructuralBindingIndexExposureRefused {
      refusal: DeclarationExposureIndexRefusal,
    }
  | StructuralBindingIndexAuthoredOrderRefused {
      refusal: AuthoredOrderIndexRefusal,
    }
  | StructuralBindingIndexDeclarationBucketRefused {
      occurrence: OccurrenceId,
    }
  | StructuralBindingProductionRefused {
      gap: ReferenceBindingProductionGap,
    }

type ReferenceBindingProductionGap
  = ReferenceBindingParserTransportRefused
  | ReferenceBindingNamedReferenceAbsent
  | ReferenceBindingNamedDeclarationAbsent

// THE SUBJECT'S OWN IDENTITY IS AN OBSERVATION, NOT A STRING.
//
// A consumer asking "which module did this subject declare itself to be" gets an answer only when
// the parse produced one. Rendering the no-answer case as an empty path would make "the parse
// refused" and "the module path is empty" the same value, so a consumer comparing paths reads a
// refusal as a subject that simply does not match -- fail-closed by accident of what that one
// consumer does with the string, and silent for the next one. The refusal reuses the same
// ReferenceBindingProductionGap vocabulary as every other production refusal in this carrier, so
// there is one gap authority and not a second spelling beside it.
type StructuralObservationSubjectModule
  = SubjectModuleProduced {
      module_path: String,
    }
  | SubjectModuleProductionRefused {
      gap: ReferenceBindingProductionGap,
    }

type ReferenceBindingObservation
  = SameFileNeighbourObservation {
      neighbour: OccurrenceId,
      resolution: StructuralBindingResolution,
    }
  | SameFileNeighbourProductionRefused {
      gap: ReferenceBindingProductionGap,
    }
  | SiblingBranchObservation {
      own_branch_declaration: OccurrenceId,
      sibling_branch_declaration: OccurrenceId,
      resolution: StructuralBindingResolution,
    }
  | SiblingBranchProductionRefused {
      gap: ReferenceBindingProductionGap,
    }
  | LaterDeclarationObservation {
      later_declaration: OccurrenceId,
      resolution: StructuralBindingResolution,
    }
  | LaterDeclarationProductionRefused {
      gap: ReferenceBindingProductionGap,
    }
  | DistinctHomonymObservation {
      first_declaration: OccurrenceId,
      second_declaration: OccurrenceId,
      resolution: StructuralBindingResolution,
    }
  | DistinctHomonymProductionRefused {
      gap: ReferenceBindingProductionGap,
    }
  | RepeatedMentionDependencyObservation {
      provider_file: FilePath,
      projected_dependencies: List<FilePath>,
    }
  | UnrelatedLoadedFileObservation {
      provider_file: FilePath,
      unrelated_loaded_file: FilePath,
      projected_dependencies: List<FilePath>,
    }

// THE SECOND SITE OF THE VALIDATED-TRANSPORT REPAIR, carried here rather than left for later
// because one fact with two homes is exactly what lets a repaired path sit beside an unrepaired
// one answering the same question -- and the next author picks whichever they read first.
// occurrence_candidate_index_build has ALREADY validated this transport, so calling the
// unvalidated std.occurrence_binding_resolve entry point would re-fold the whole population for
// THIS ONE reference: the O(references x population) shape measured on the resolve path.
fn structural_binding_resolution_from_candidates(
  transport: OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
  reference: ReferenceOccurrence,
) -> StructuralBindingResolution {
  match occurrence_candidate_index_build(transport: transport, inputs: inputs) {
    OccurrenceCandidateIndexReady { index: index } =>
      StructuralBindingResolved {
        binding_outcome: resolve_reference_occurrence_binding_validated(
          validated: index.validated,
          occurrence: reference.occurrence,
          supplied_candidates: candidate_occurrence_ids_for_reference(
            index: index,
            reference: reference,
          ),
        ),
      }
    OccurrenceCandidateIndexTransportRefused { refusal: refusal } =>
      StructuralBindingIndexTransportRefused { refusal: refusal }
    OccurrenceCandidateIndexModulePathRefused { refusal: refusal } =>
      StructuralBindingIndexModulePathRefused { refusal: refusal }
    OccurrenceCandidateIndexExposureRefused { refusal: refusal } =>
      StructuralBindingIndexExposureRefused { refusal: refusal }
    OccurrenceCandidateIndexAuthoredOrderRefused { refusal: refusal } =>
      StructuralBindingIndexAuthoredOrderRefused { refusal: refusal }
    OccurrenceCandidateIndexDeclarationBucketRefused { occurrence: occurrence } =>
      StructuralBindingIndexDeclarationBucketRefused { occurrence: occurrence }
  }
}
