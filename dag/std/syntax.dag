module std.syntax

type BinOp
  = Add | Sub | Mul | Div | Mod
  | Eq | Ne | Lt | Gt | Le | Ge
  | And | Or | NullCoalesce

type LiteralValue
  = LitStr { value: String }
  | LitInt { value: Int }
  | LitFloat { value: String }
  | LitBool { value: Bool }
  | LitNull

  | LitSymbol { value: String }

type BodyKind
  = ExprBody
  | BlockBody
  | TypeBody
  | ValueBody
  | NoBody
  | ServiceBody
  | ResourceBody
  | AliasBody

type ItemFormKind
  = FuncForm
  | StructForm
  | EnumForm
  | TypeAliasForm
  | ModuleForm
  | OtherForm

type ItemForm {
  kind: ItemFormKind
  keyword: String
  has_type_params: Bool
  has_params: Bool
  has_return_type: Bool
  return_required: Bool
  has_uses: Bool
  body_kind: BodyKind
}

type AlgebraFieldKind
  = AlgAdd | AlgMul | AlgReciprocal | AlgQuotient | AlgRemainder | AlgCompare | AlgMeet | AlgJoin

type AlgebraFieldEntry {
  kind: AlgebraFieldKind
  field_name: String
}

data algebra_field_entries: List<AlgebraFieldEntry> = [
  { kind: AlgAdd, field_name: "add" },
  { kind: AlgMul, field_name: "mul" },
  { kind: AlgReciprocal, field_name: "reciprocal" },
  { kind: AlgQuotient, field_name: "quotient" },
  { kind: AlgRemainder, field_name: "remainder" },
  { kind: AlgCompare, field_name: "compare" },
  { kind: AlgMeet, field_name: "meet" },
  { kind: AlgJoin, field_name: "join" }
]

type OperatorSpec {
  symbol: String
  left_bp: Int
  right_bp: Int
  binop: BinOp?
  algebra_field: AlgebraFieldKind?
}

type SyntaxSpec {
  item_forms: List<ItemForm>
  operators: List<OperatorSpec>
  keyword_literals: Map<String, LiteralValue>
  keyword_set: Map<String, Bool>
}

// THE COMPLETE DECLARATIVE PARSE ENVIRONMENT OF ONE LANGUAGE REALIZATION AT ONE REVISION, carried
// as a value so that reading a revision's source does not mean reading it under whatever grammar
// the RUNNING binary was built with. The type is language-agnostic, like every sibling in this
// module: it is a `SyntaxSpec` plus a non-name-keyword roster, which is the shape any language
// realization needs. The dag-specific INSTANCE is `extdeps.languages.dag.syntax`
// `dag_parse_environment`, and a second language contributes another instance here rather than
// another type -- naming this carrier after one language would be the fork section 2 prices as
// growing net concepts by re-invention.
//
// A `SyntaxSpec` ALONE IS NOT THAT ENVIRONMENT: the tokenizer classifies words against
// `keyword_set` before any spec is consulted, and the parser refuses a keyword in name position
// against a SEPARATE non-name roster that lives beside the spec rather than inside it. A carrier
// holding only the spec would therefore be revision-relative for item forms and head-relative for
// tokenization, which is the half-fix that reads as green.
//
// WHY THIS EXISTS AT ALL, since the running binary already has one. A cross-revision comparison --
// what a merge base declared versus what a head declares -- parses BOTH sides, and only one of them
// was authored under the head's grammar. Handing base text to the head's compiled-in environment
// assumes the two revisions share a grammar, and that assumption is silently false for exactly the
// changes that alter the grammar. The class is
// gunbc.recurring_failure_mode.base_readability_gate_refuses_a_grammar_change.
//
// WHAT IT DOES NOT CARRY, stated because the boundary is the whole value of the type. This is the
// DECLARATIVE environment: which words are keywords, which item forms exist and what fields they
// admit, which operators bind how, which keywords are literals. It is NOT the parser's realization.
// `parse_item_by_form` dispatches on `body_kind` to hand-written body parsers, so a revision whose
// body parser behaved differently is not reproduced by supplying its environment -- and must not be
// claimed to be. That population stays outside the covered set and refuses rather than answering.
//
// CONSUMED BY EXECUTION (DESIGN section 3c). An earlier revision of this annotation declared a
// frontier here: every producer was the head's own `dag_parse_environment`, no caller read a revision
// under another revision's grammar, and the trigger was named as the base environment loader landing
// with a cross-revision read green by execution and a discriminating red when the head's environment
// is substituted. THAT TRIGGER HAS FIRED. `v1_compiler.namespace_baseline`
// `load_parse_environment_at` reads this value out of the git object store at a base revision,
// `environment_agreement` decides by blob identity over the declaring closure whether the base and
// head grammars differ, and `reconstruct_base_index` reads the base under the base's own
// environment when they do. (It was the deleted wave-admission wall's loader until 2026-09-19;
// the floor's base-side reconstruction is the consumer that survives.) The enrolled evidence is the
// decode roundtrip witness (src/v1/stage0/tests/parse_environment_decode_roundtrip.rs): green by
// execution over a committed revision whose environment diverges from the worktree's, red when the
// loader reads the worktree instead of the revision. The climb
// is recorded on gunbc.recurring_failure_mode.base_readability_gate_refuses_a_grammar_change, and
// this sentence does not restate its rung -- the row does.
//
// THE BOUNDARY THAT CONSUMPTION DRAWS, stated here because this type is what gets loaded: a base
// whose grammar differs from the head's is readable so long as this type's own declaring closure --
// thirteen modules at this writing, asked of the resolver rather than listed -- is itself readable
// under the head's grammar. A grammar change that reaches into that closure is the compiler's own
// bootstrap boundary and refuses as `ClosureNotEvaluable`. The residual trigger is a
// revision-relative read in .dag, where a read is a fold over this value with no head-built index
// in the path.
type ParseEnvironment {
  syntax_spec: SyntaxSpec
  non_name_keywords: Map<String, Bool>
}
