module std.realize_pack

import std.types { Int, Bool, String }
import std.measure { ByteSize, byte_size, byte_size_count, HardwareThreadCount, hardware_thread_count, hardware_thread_count_value }
import std.realization_width { memory_bounded_shard_count, int_min }
import std.realization_schedule { CostAccount, CostBasis, Measured, Predicted }

data realize_pack_module_note: String = "Witness-realization plan P4 (realize v0 — the memory-safe packing half of `realize`, spine FLAG D). Packs concurrent width = min(independence_width, budget / MEASURED peak), consuming P1's CostAccount.space with basis:Measured (audit F2/F7: measured peak was unproducible, so this half of realize was unbuildable). Three typed verdicts, none fabricated: PackedWidth when the peak is Measured and the budget is readable; MaturationReserve(width 1) when the peak is unknown (a first-run subject with no receipt yet — it runs alone, then its receipt converts it next round, exactly the governor's admission logic made modeled); BudgetRefused when the host budget read fails — REFUSING, never the conservative_fallback_width fabrication realization_width.dag:109 emits (the live §5 absorbing-fallback the audit flagged: budget unreadable answered with a number). The exit-137 failure mode (memory-blind packing OOMs) becomes arithmetic: width never exceeds budget/peak by construction. Space composes as P1's dual — concurrent shards CO-RESIDE, so W shards at peak P need W*P <= budget, which is exactly budget/peak >= W."

type MeasuredPeak
  = PeakMeasured { bytes: ByteSize }
  | PeakUnknown

fn measured_peak_of(cost: CostAccount<Int>) -> MeasuredPeak {
  match cost.basis {
    Measured => PeakMeasured { bytes: cost.space }
    Predicted => PeakUnknown
  }
}

type HostBudget
  = BudgetReadable { bytes: ByteSize }
  | BudgetUnreadable

type RealizeVerdict
  = PackedWidth { width: HardwareThreadCount }
  | MaturationReserve { width: HardwareThreadCount }
  | BudgetRefused

fn realize_pack_width(peak: MeasuredPeak, budget: HostBudget, independence_width: Int) -> RealizeVerdict {
  match budget {
    BudgetUnreadable => BudgetRefused
    BudgetReadable { bytes: budget_bytes } =>
      match peak {
        PeakUnknown => MaturationReserve { width: hardware_thread_count(count: 1) }
        PeakMeasured { bytes: peak_bytes } =>
          let mem_width = memory_bounded_shard_count(memory_budget: budget_bytes, per_shard_peak: peak_bytes)
          let packed = int_min(a: independence_width, b: mem_width)
          PackedWidth { width: hardware_thread_count(count: packed) }
      }
  }
}

fn realize_verdict_width(v: RealizeVerdict) -> Int {
  match v {
    PackedWidth { width: w } => hardware_thread_count_value(t: w)
    MaturationReserve { width: w } => hardware_thread_count_value(t: w)
    BudgetRefused => 0
  }
}

fn realize_fits_budget(v: RealizeVerdict, peak: MeasuredPeak, budget: HostBudget) -> Bool {
  match budget {
    BudgetUnreadable => match v { BudgetRefused => true  _ => false }
    BudgetReadable { bytes: budget_bytes } =>
      match peak {
        PeakUnknown => true
        PeakMeasured { bytes: peak_bytes } =>
          let w = realize_verdict_width(v: v)
          (w * byte_size_count(peak_bytes)) <= byte_size_count(budget_bytes)
      }
  }
}
