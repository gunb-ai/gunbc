module std.graph

import std.termination {
  ProofEdge,
  DescentEvidence, Strict, NonIncreasing, DescentUnknown,
  TerminationProof
}

type GraphEdge<V> {
  caller: V
  callee: V
}

type CallGraph<V> {
  edges: List<GraphEdge<V>>
}

type CallGraphAdjacencyViews<V> {
  forward: Map<V, List<V>>
  reverse: Map<V, List<V>>
}

type DfsFinishAcc<V> {
  visited: Set<V>
  order: List<V>
}

type SccComponentAcc<V> {
  visited: Set<V>
  members: List<V>
}

fn seed_adjacency_map<V>(names: List<V>) -> Map<V, List<V>> {
  names |> fold(init: empty_map(), f: (acc, name) =>
    map_insert(acc, name, [])
  )
}

fn build_call_graph_from_proof_edges(names: List<String>, edges: List<ProofEdge>) -> CallGraph<String> {
  CallGraph {
    edges: edges
      |> filter(e => e.caller != e.callee)
      |> map(e => GraphEdge { caller: e.caller, callee: e.callee })
  }
}

fn build_adjacency_views<V>(names: List<V>, graph: CallGraph<V>) -> CallGraphAdjacencyViews<V> {
  let initial_forward = seed_adjacency_map(names: names)
  let initial_reverse = seed_adjacency_map(names: names)
  graph.edges |> fold(init: CallGraphAdjacencyViews { forward: initial_forward, reverse: initial_reverse }, f: (acc, edge) =>
    let forward_neighbors = match map_get(acc.forward, edge.caller) {
      Present { value: ns } => concat(ns, [edge.callee])
      Absent => [edge.callee]
    }
    let reverse_neighbors = match map_get(acc.reverse, edge.callee) {
      Present { value: ns } => concat(ns, [edge.caller])
      Absent => [edge.caller]
    }
    CallGraphAdjacencyViews {
      forward: map_insert(acc.forward, edge.caller, forward_neighbors),
      reverse: map_insert(acc.reverse, edge.callee, reverse_neighbors)
    }
  )
}

fn forward_adjacency<V>(names: List<V>, graph: CallGraph<V>) -> Map<V, List<V>> {
  build_adjacency_views(names: names, graph: graph).forward
}

fn reverse_adjacency<V>(names: List<V>, graph: CallGraph<V>) -> Map<V, List<V>> {
  build_adjacency_views(names: names, graph: graph).reverse
}

fn dfs_finish_order<V>(node: V, adjacency: Map<V, List<V>>, acc: DfsFinishAcc<V>) -> DfsFinishAcc<V> {
  if set_contains(acc.visited, node) {
    acc
  } else {
    let next_visited = set_insert(acc.visited, node)
    let neighbors = match map_get(adjacency, node) {
      Present { value: ns } => ns
      Absent => []
    }
    let explored = neighbors |> fold(init: DfsFinishAcc { visited: next_visited, order: acc.order }, f: (inner, neighbor) =>
      dfs_finish_order(node: neighbor, adjacency: adjacency, acc: inner)
    )
    DfsFinishAcc { visited: explored.visited, order: explored.order |> list_push(node) }
  }
}

fn dfs_collect_component<V>(node: V, adjacency: Map<V, List<V>>, acc: SccComponentAcc<V>) -> SccComponentAcc<V> {
  if set_contains(acc.visited, node) {
    acc
  } else {
    let next_visited = set_insert(acc.visited, node)
    let next_members = acc.members |> list_push(node)
    let neighbors = match map_get(adjacency, node) {
      Present { value: ns } => ns
      Absent => []
    }
    neighbors |> fold(init: SccComponentAcc { visited: next_visited, members: next_members }, f: (inner, neighbor) =>
      dfs_collect_component(node: neighbor, adjacency: adjacency, acc: inner)
    )
  }
}

type SccComponentsAcc<V> {
  visited: Set<V>
  components: List<List<V>>
}

// Kosaraju: the second pass visits the transpose in decreasing finish order, so the components
// arrive in topological order of the condensation -- a component precedes every component its
// members reach. Consumers that want dependencies first reverse the list; the order is a fact of
// the algorithm, not a presentation choice.
fn graph_strongly_connected_components<V>(
  names: List<V>,
  graph: CallGraph<V>,
) -> List<List<V>> {
  let adjacency = build_adjacency_views(names: names, graph: graph)
  let finish = names |> fold(init: DfsFinishAcc { visited: empty_set(), order: [] }, f: (acc, name) =>
    dfs_finish_order(node: name, adjacency: adjacency.forward, acc: acc)
  )
  let result = finish.order |> reverse |> fold(init: SccComponentsAcc { visited: empty_set(), components: [] }, f: (acc, name) =>
    if set_contains(acc.visited, name) {
      acc
    } else {
      let component = dfs_collect_component(node: name, adjacency: adjacency.reverse, acc: SccComponentAcc { visited: acc.visited, members: [] })
      SccComponentsAcc {
        visited: component.visited,
        components: acc.components |> list_push(component.members)
      }
    }
  )
  result.components
}

fn graph_multi_node_scc_members<V>(
  names: List<V>,
  graph: CallGraph<V>,
) -> List<V> {
  graph_strongly_connected_components(names: names, graph: graph)
    |> fold(init: [], f: (acc, component) =>
      if (component |> count) > 1 {
        concat(acc, component)
      } else {
        acc
      }
    )
}

fn graph_has_multi_node_scc<V>(names: List<V>, graph: CallGraph<V>) -> Bool {
  count(graph_multi_node_scc_members(names: names, graph: graph)) > 0
}

fn graph_cycle_members<V>(
  names: List<V>,
  graph: CallGraph<V>,
) -> List<V> {
  let self_scan = graph.edges
    |> filter(edge => edge.caller == edge.callee)
    |> fold(
      init: DfsFinishAcc { visited: empty_set(), order: [] },
      f: fn(acc, edge) {
        if set_contains(acc.visited, edge.caller) {
          acc
        } else {
          DfsFinishAcc {
            visited: set_insert(acc.visited, edge.caller),
            order: list_push(acc.order, edge.caller),
          }
        }
      },
    )
  let self_cycles = self_scan.order
  concat(
    self_cycles,
    graph_multi_node_scc_members(names: names, graph: graph)
      |> filter(member =>
        !any(self_cycles, self_cycle => self_cycle == member)
      ),
  )
}

fn graph_reverse_reachable_members<V>(
  names: List<V>,
  graph: CallGraph<V>,
  start: V,
) -> List<V> {
  let reached = dfs_collect_component(
    node: start,
    adjacency: reverse_adjacency(names: names, graph: graph),
    acc: SccComponentAcc {
      visited: empty_set(),
      members: [],
    },
  )
  reached.members |> filter(member => member != start)
}

fn is_lexicographic_descent(evidence: List<DescentEvidence>) -> Bool {
  match evidence |> first {
    Absent => false
    Present { value: e } =>
      match e {
        Strict => true
        NonIncreasing => is_lexicographic_descent(evidence: evidence |> skip(1))
        DescentUnknown => false
      }
  }
}

fn is_valid_proof(proof: TerminationProof, edges: List<ProofEdge>) -> Bool {
  let expected_dims = proof.dimensions |> count
  let non_descending = edges |> filter(e =>
    (e.evidence |> count != expected_dims) || is_lexicographic_descent(evidence: e.evidence) == false
  )
  let has_self_cycle = non_descending |> any(e => e.caller == e.callee)
  if has_self_cycle { false }
  else {
    let members = edges |> flat_map(e => [e.caller, e.callee])
    let nd_graph = build_call_graph_from_proof_edges(names: members, edges: non_descending)
    graph_has_multi_node_scc(names: members, graph: nd_graph) == false
  }
}
