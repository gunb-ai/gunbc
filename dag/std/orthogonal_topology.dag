module std.orthogonal_topology


// SPATIAL-3B: ORTHOGONAL TOPOLOGY. An EnclosedSpace is DERIVED FROM A CLOSED SHELL and can never be
// authored as width x depth x height. That is the whole point of the band, so it is worth saying
// exactly what it buys: a space authored as three numbers has a volume that agrees with nothing -
// it does not know its own footprint, so it cannot say whether a point is inside it, whether two
// spaces overlap, or whether they share a wall, and every one of those questions would then be
// answered by a SECOND authored fact that can silently disagree with the first. Here they are all
// projections of one boundary, so disagreement has no representation.
//
// THE SHELL IS CLOSED BY CONSTRUCTION, NOT BY A CHECK. A ClosedShell is minted only from an
// OrthogonalPrism3, and a footprint loop extruded between two parallel planes is closed for the
// same reason 3A's loop is closed: the mint takes vertices and derives the edges including the
// closing one. So there is no unclosed shell for a refusal arm to reject, and no such arm exists -
// declaring one would be rung inflation on the sum, the same class 3A deleted LoopNotClosed for.
//
// WHAT THIS BAND DOES NOT CLAIM. The shell is a prism: a rectilinear footprint with one floor and
// one ceiling. A shell with a stepped roof, an internal void, or a non-manifold junction is not
// representable, not approximated. Those need a general face-set shell with an orientation and a
// closure proof over it, which is a different construction from this one and arrives with its own
// witnesses when a consumer needs it. Outward face normals are likewise absent: nothing this band
// answers needs to know which side of a wall is inside, and a field no consumer reads is a fact
// that gets to be wrong for free.
//
// EXACTNESS IS THE SAME PROMISE 3A MAKES. Areas come from the shoelace sum over integer millimetre
// coordinates, volumes from area times height, containment from a crossing count. No square roots,
// no rounding, no tolerance parameter - and every arithmetic step is checked, so a magnitude that
// leaves the representable range is a typed refusal carrying its operands rather than a wrapped
// number that looks plausible.
//
// ONE REFUSAL VOCABULARY FOR THE BAND, which is why this module extends std.orthogonal_geometry's
// OrthogonalRefusal rather than declaring a TopologyRefusal beside it. A frame mismatch here is the
// same fact with the same remedy as a frame mismatch there; a second spelling of it would be the
// nicknaming DESIGN section 3 forbids, and a consumer handling both bands would have to match two
// vocabularies to learn one thing.

// A WALL IS DERIVED FROM THE FOOTPRINT EDGE, never stored. Storing the walls beside the prism would
// be a second representation of the footprint: an edit to the loop would leave them stale, and
// nothing in the type could notice. The span is the edge; the vertical extent is the prism's.
type ShellWall {
  start: std.affine_space.Point2
  end: std.affine_space.Point2
  low: std.integer.Int
  high: std.integer.Int
}

type ClosedShell sole_constructor {
  prism: std.orthogonal_geometry.OrthogonalPrism3
}

// Total: a prism IS a closed shell, so there is nothing here to refuse and the return type says so.
fn closed_shell_of_prism(prism: std.orthogonal_geometry.OrthogonalPrism3) -> ClosedShell {
  ClosedShell { prism: prism }
}

fn shell_prism(s: ClosedShell) -> std.orthogonal_geometry.OrthogonalPrism3 { s.prism }
fn shell_frame(s: ClosedShell) -> std.coordinate_frame.CoordinateFrameIdentity { prism3_frame(p: s.prism) }

fn shell_walls(s: ClosedShell) -> List<ShellWall> {
  let lo = signed_frame_component_count(c: prism3_low(p: s.prism))
  let hi = signed_frame_component_count(c: prism3_high(p: s.prism))
  reverse(fold(loop_edges(vertices: loop2_vertices(l: prism3_footprint(p: s.prism))), init: [], f: (acc, e) =>
    concat([ShellWall { start: e.start, end: e.end, low: lo, high: hi }], acc)))
}

// The face count is DERIVED and is the one place the closure claim is legible as a number: a prism
// over an n-vertex footprint has n walls plus a floor and a ceiling. It is not stored, so it cannot
// disagree with the footprint it counts.
fn shell_face_count(s: ClosedShell) -> std.integer.Int {
  length(shell_walls(s: s)) + 2
}

type EnclosedSpace sole_constructor {
  shell: ClosedShell
}

// Total for the same reason: every closed shell encloses a space. The refusals in this band are on
// the QUESTIONS asked of a space (its area may overflow, two spaces may be in different frames),
// never on its existence.
fn enclosed_space(shell: ClosedShell) -> EnclosedSpace {
  EnclosedSpace { shell: shell }
}

fn space_shell(s: EnclosedSpace) -> ClosedShell { s.shell }
fn space_frame(s: EnclosedSpace) -> std.coordinate_frame.CoordinateFrameIdentity { shell_frame(s: s.shell) }
fn space_footprint(s: EnclosedSpace) -> std.orthogonal_geometry.OrthogonalLoop2 { prism3_footprint(p: s.shell.prism) }
fn space_height(registry: std.spatial_frame.SpatialFrameRegistry, s: EnclosedSpace) -> std.spatial_frame.FrameExtent { prism3_height(registry: registry, p: s.shell.prism) }
fn space_walls(s: EnclosedSpace) -> List<ShellWall> { shell_walls(s: s.shell) }

// EQUALITY IS OVER THE REGION, NOT THE VERTEX LIST. Two spaces are the same when they occupy the
// same volume in the same frame, and the loop that describes a region is not unique: the same
// rectangle can be written starting at any of its corners, in either winding. An earlier revision
// compared vertices pairwise at matching list positions, which made a claim about VOLUME while
// implementing one about REPRESENTATION - so a room whose boundary merely started at a different
// corner compared unequal, and (because product.spatial_world uses this as its compare-and-swap
// judgment) a geometrically identical patch could be refused as stale.
//
// The comparison is therefore invariant under cyclic rotation and under reversal, which are exactly
// the two freedoms orthogonal_loop2 leaves in the representation: it stores the caller's sequence
// unchanged, choosing neither a canonical start vertex nor a canonical winding. It is implemented
// over the edge set rather than by trying rotations, because one structural fact covers both.
//
// Dissolve-on: canonicalising the loop AT ITS MINT - canonical start plus canonical winding - which
// is the stronger fix because it makes this comparison trivial and gives every future hashing,
// diffing or interning consumer one normal form instead of each re-deriving these two invariances.
// It is not done here because it changes what loop2_vertices returns for already-merged callers,
// which is a substrate change that deserves its own increment rather than riding a product band.
//
// There is no identity field to compare because identity is the product layer's fact, not
// geometry's (std.spatial_knowledge draws the same separation). A consumer asking "is this the same
// ROOM" must ask the layer that allocates room identities.
fn space_eq(a: EnclosedSpace, b: EnclosedSpace) -> Bool {
  coordinate_frame_identity_eq(a: space_frame(s: a), b: space_frame(s: b))
    && signed_frame_component_count(c: prism3_low(p: a.shell.prism)) == signed_frame_component_count(c: prism3_low(p: b.shell.prism))
    && signed_frame_component_count(c: prism3_high(p: a.shell.prism)) == signed_frame_component_count(c: prism3_high(p: b.shell.prism))
    && loops_describe_same_region(
         a: loop2_vertices(l: space_footprint(s: a)),
         b: loop2_vertices(l: space_footprint(s: b)),
       )
}

// THE COMPARISON IS OVER THE EDGE SET, which is what makes it invariant under both freedoms at once
// rather than by enumerating rotations. A simple closed loop gives every vertex degree two, so its
// set of edges determines the cycle and therefore the region; and an edge is an UNORDERED pair of
// endpoints, so writing the loop backwards produces the same set. Rotating the start vertex does
// not change which edges exist either. One structural fact covers both cases.
fn same_undirected_edge(a: std.orthogonal_geometry.LoopEdge, b: std.orthogonal_geometry.LoopEdge) -> Bool {
  (point2_same_position(a: a.start, b: b.start) && point2_same_position(a: a.end, b: b.end))
    || (point2_same_position(a: a.start, b: b.end) && point2_same_position(a: a.end, b: b.start))
}

fn count_edge(edges: List<std.orthogonal_geometry.LoopEdge>, wanted: std.orthogonal_geometry.LoopEdge) -> std.integer.Int {
  fold(edges, init: 0, f: (acc, e) => if same_undirected_edge(a: e, b: wanted) { acc + 1 } else { acc })
}

// Multiplicity is compared, not mere membership: two loops can draw on the same set of distinct
// edges while traversing one of them a different number of times, and a membership test would call
// those equal.
fn loops_describe_same_region(a: List<std.affine_space.Point2>, b: List<std.affine_space.Point2>) -> Bool {
  if length(a) != length(b) {
    false
  } else {
    let a_edges = loop_edges(vertices: a)
    let b_edges = loop_edges(vertices: b)
    fold(a_edges, init: true, f: (acc, e) =>
      acc && count_edge(edges: a_edges, wanted: e) == count_edge(edges: b_edges, wanted: e))
  }
}

// THE SHOELACE SUM, CHECKED AT EVERY STEP. The sum is twice the signed area, and for a closed
// integer loop it is always even, so halving it is exact rather than a rounding policy. Each term
// is a product of two coordinates and can leave the range on its own, so the fold carries a
// CheckedInt and the FIRST crossing wins - a partial sum plus a default would be the fabricated
// plausible output DESIGN section 5 forbids, and it would be a plausible AREA, which is worse than
// an implausible one because nothing downstream would question it.
fn shoelace_term(e: std.orthogonal_geometry.LoopEdge) -> std.checked_arithmetic.CheckedInt {
  let a = checked_int_multiply(a: point2_x(p: e.start), b: point2_y(p: e.end))
  let b = checked_int_multiply(a: point2_x(p: e.end), b: point2_y(p: e.start))
  match a {
    CheckedIntOverflow { cause: c } => std.checked_arithmetic.CheckedIntOverflow { cause: c }
    CheckedIntReady { value: av } =>
      match b {
        CheckedIntOverflow { cause: c } => std.checked_arithmetic.CheckedIntOverflow { cause: c }
        CheckedIntReady { value: bv } => checked_int_subtract(a: av, b: bv)
      }
  }
}

fn shoelace_double_area(l: std.orthogonal_geometry.OrthogonalLoop2) -> std.checked_arithmetic.CheckedInt {
  fold(loop_edges(vertices: loop2_vertices(l: l)), init: std.checked_arithmetic.CheckedIntReady { value: 0 }, f: (acc, e) =>
    match acc {
      CheckedIntOverflow { cause: c } => std.checked_arithmetic.CheckedIntOverflow { cause: c }
      CheckedIntReady { value: sum } =>
        match shoelace_term(e: e) {
          CheckedIntOverflow { cause: c } => std.checked_arithmetic.CheckedIntOverflow { cause: c }
          CheckedIntReady { value: t } => checked_int_add(a: sum, b: t)
        }
    })
}

// THE MILLIMETRE GUARD FOR THE METRIC FOLDS. The extents answer in the frame; these do not, so
// they must not run on a frame they cannot label. An unregistered frame refuses for the same
// reason it does in std.euclidean_geometry: no declared quantum means no unit to check against.
fn metric_frame_is_millimetre(registry: std.spatial_frame.SpatialFrameRegistry, identity: std.coordinate_frame.CoordinateFrameIdentity) -> Bool {
  match frame_length_scale(r: registry, identity: identity) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: sc } => scales_agree(a: sc, b: Milli)
  }
}

fn loop2_area(registry: std.spatial_frame.SpatialFrameRegistry, l: std.orthogonal_geometry.OrthogonalLoop2) -> std.orthogonal_geometry.OrthogonalConstruction<std.measure.SquareMillimeter> {
  if !metric_frame_is_millimetre(registry: registry, identity: l.frame) {
    std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.MillimetreFrameRequiredForMetric { frame: l.frame } }
  } else {
  match shoelace_double_area(l: l) {
    CheckedIntOverflow { cause: c } => std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.ShellArithmeticRefused { cause: c } }
    CheckedIntReady { value: doubled } =>
      match checked_int_magnitude(a: doubled) {
        CheckedNatOverflow { cause: c } => std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.ShellArithmeticRefused { cause: c } }
        CheckedNatReady { value: magnitude } => std.orthogonal_geometry.OrthogonalReady { value: square_millimeter(count: magnitude / 2) }
      }
  }
  }
}

fn space_floor_area(registry: std.spatial_frame.SpatialFrameRegistry, s: EnclosedSpace) -> std.orthogonal_geometry.OrthogonalConstruction<std.measure.SquareMillimeter> {
  loop2_area(registry: registry, l: space_footprint(s: s))
}

// Volume is area times height and nothing else. There is no stored volume to disagree with the
// footprint, and no arm that answers when the multiplication leaves the range.
// THE HEIGHT PROJECTION REFUSES, AND AN EARLIER REVISION OF THIS FUNCTION DID NOT. It returned
// millimeter(count: 0) when the extent could not be projected or the frame was unregistered - and
// space_volume multiplied an area by that zero, so a space whose height nobody could state
// reported a volume of nothing rather than refusing. That is the absorbing fallback DESIGN section
// 5 forbids, in its most deniable form: the answer is a number, it is in the right unit, and it is
// the one value a reader is least likely to question for an empty-looking result. The comment
// above it claimed the projection refused exactly, which is how it survived being written.
//
// The refusal is typed and reaches the caller, so a volume over an unlabelable frame is now
// OrthogonalRefused rather than zero.
//
// REACHABILITY, STATED BECAUSE IT IS LESS THAN IT LOOKS. Both refusal arms below are unreachable
// through space_volume, the only caller: it consults space_floor_area first, whose guard refuses
// on exactly the frames that would make this projection fail, so control never arrives here on a
// bad frame. They are a defence for a future direct caller, not an executing check, and the
// witness that covers the volume path is exercising the AREA guard rather than these arms - which
// was worth finding, because the control was first written claiming otherwise and a mutation of
// both arms left it green. What the fix delivers is that this function no longer fabricates a
// zero; what it does not deliver is an executed proof of these arms.
fn space_height_millimetres(registry: std.spatial_frame.SpatialFrameRegistry, s: EnclosedSpace) -> std.orthogonal_geometry.OrthogonalConstruction<std.measure.Millimeter> {
  match space_height(registry: registry, s: s) {
    ExtentFrameUnregistered { identity: f } =>
      std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.MillimetreFrameRequiredForMetric { frame: f } }
    std.spatial_frame.ExtentInFrame { length: l } =>
      match frame_length_as_millimeter(l: l) {
        LengthProjected { value: mm } => std.orthogonal_geometry.OrthogonalReady { value: mm }
        LengthProjectionRefused { cause: _ } =>
          std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.MillimetreFrameRequiredForMetric { frame: space_frame(s: s) } }
      }
  }
}

fn space_volume(registry: std.spatial_frame.SpatialFrameRegistry, s: EnclosedSpace) -> std.orthogonal_geometry.OrthogonalConstruction<std.measure.CubicMillimeter> {
  match space_floor_area(registry: registry, s: s) {
    OrthogonalRefused { cause: c } => std.orthogonal_geometry.OrthogonalRefused { cause: c }
    OrthogonalReady { value: area } =>
      match space_height_millimetres(registry: registry, s: s) {
        OrthogonalRefused { cause: hc } => std.orthogonal_geometry.OrthogonalRefused { cause: hc }
        OrthogonalReady { value: h } =>
      match checked_int_multiply(a: square_millimeter_count_as_int(m: area), b: millimeter_count_as_int(m: h)) {
        CheckedIntOverflow { cause: c } => std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.ShellArithmeticRefused { cause: c } }
        CheckedIntReady { value: v } =>
          match checked_int_magnitude(a: v) {
            CheckedNatOverflow { cause: c } => std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.ShellArithmeticRefused { cause: c } }
            CheckedNatReady { value: n } => std.orthogonal_geometry.OrthogonalReady { value: cubic_millimeter(count: n) }
          }
      }
      }
  }
}

fn square_millimeter_count_as_int(m: std.measure.SquareMillimeter) -> std.integer.Int { square_millimeter_count(m: m) }
fn millimeter_count_as_int(m: std.measure.Millimeter) -> std.integer.Int { millimeter_count(m: m) }

fn cubic_millimeter_count_as_int(m: std.measure.CubicMillimeter) -> std.integer.Int { cubic_millimeter_count(m: m) }

// CONTAINMENT IS THREE-VALUED, and collapsing it to a Bool would destroy the distinction a consumer
// most needs. A point ON the boundary is on a wall: it is not in the interior and it is not
// outside, and a fixture placed there is touching the wall rather than intersecting it or standing
// clear of it. Those are three different situations with three different remedies, so they are
// three arms - the same ruling std.spatial_knowledge records against Bool projections.
type PointLocation2
  = PointInsideLoop
  | PointOnLoopBoundary
  | PointOutsideLoop

fn min_of(a: std.integer.Int, b: std.integer.Int) -> std.integer.Int { if a < b { a } else { b } }
fn max_of(a: std.integer.Int, b: std.integer.Int) -> std.integer.Int { if a > b { a } else { b } }

fn spans_overlap(a_lo: std.integer.Int, a_hi: std.integer.Int, b_lo: std.integer.Int, b_hi: std.integer.Int) -> Bool {
  max_of(a: a_lo, b: b_lo) < min_of(a: a_hi, b: b_hi)
}

fn between_inclusive(v: std.integer.Int, a: std.integer.Int, b: std.integer.Int) -> Bool {
  (a <= v && v <= b) || (b <= v && v <= a)
}

// The edge is carried as four integers at a caller-chosen SCALE so the containment test has exactly
// one implementation. The overlap test below needs to evaluate points at cell centres, which are
// half-integers in millimetre coordinates; running it at scale 2 makes them integers without a
// second copy of the crossing rule that could drift from this one.
type EdgeInts {
  sx: std.integer.Int
  sy: std.integer.Int
  ex: std.integer.Int
  ey: std.integer.Int
}

fn scaled_edges(l: std.orthogonal_geometry.OrthogonalLoop2, scale: std.integer.Int) -> List<EdgeInts> {
  reverse(fold(loop_edges(vertices: loop2_vertices(l: l)), init: [], f: (acc, e) =>
    concat([EdgeInts {
      sx: point2_x(p: e.start) * scale,
      sy: point2_y(p: e.start) * scale,
      ex: point2_x(p: e.end) * scale,
      ey: point2_y(p: e.end) * scale,
    }], acc)))
}

fn on_edge(px: std.integer.Int, py: std.integer.Int, e: EdgeInts) -> Bool {
  (e.sx == e.ex && px == e.sx && between_inclusive(v: py, a: e.sy, b: e.ey))
    || (e.sy == e.ey && py == e.sy && between_inclusive(v: px, a: e.sx, b: e.ex))
}

// The crossing count uses the HALF-OPEN rule on the vertical span: an edge counts when the ray's y
// is at or above its lower endpoint and strictly below its upper one. That is what makes a ray
// passing exactly through a vertex count once rather than twice, which is the entire correctness
// question in a crossing test and the reason a tolerance is never needed here. The witness sends a
// ray through a vertex specifically to hold this rule down.
fn crosses_ray(px: std.integer.Int, py: std.integer.Int, e: EdgeInts) -> Bool {
  if e.sx != e.ex {
    false
  } else {
    let lo = min_of(a: e.sy, b: e.ey)
    let hi = max_of(a: e.sy, b: e.ey)
    lo <= py && py < hi && px < e.sx
  }
}

fn location_from_edges(edges: List<EdgeInts>, px: std.integer.Int, py: std.integer.Int) -> PointLocation2 {
  let boundary = fold(edges, init: false, f: (acc, e) => acc || on_edge(px: px, py: py, e: e))
  if boundary {
    PointOnLoopBoundary
  } else {
    let crossings = fold(edges, init: 0, f: (acc, e) => if crosses_ray(px: px, py: py, e: e) { acc + 1 } else { acc })
    if crossings % 2 == 1 { PointInsideLoop } else { PointOutsideLoop }
  }
}

fn point_location_in_loop(l: std.orthogonal_geometry.OrthogonalLoop2, px: std.integer.Int, py: std.integer.Int) -> PointLocation2 {
  location_from_edges(edges: scaled_edges(l: l, scale: 1), px: px, py: py)
}

type PointLocation3
  = PointInsideSpace
  | PointOnSpaceBoundary
  | PointOutsideSpace

fn space_locate_point(s: EnclosedSpace, p: std.affine_space.Point3) -> std.orthogonal_geometry.OrthogonalConstruction<PointLocation3> {
  if !coordinate_frame_identity_eq(a: space_frame(s: s), b: p.frame) {
    std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.OrthogonalFrameMismatch { expected: space_frame(s: s), observed: p.frame } }
  } else {
    let z = signed_frame_component_count(c: p.z)
    let lo = signed_frame_component_count(c: prism3_low(p: s.shell.prism))
    let hi = signed_frame_component_count(c: prism3_high(p: s.shell.prism))
    let plan = point_location_in_loop(
      l: space_footprint(s: s),
      px: signed_frame_component_count(c: p.x),
      py: signed_frame_component_count(c: p.y),
    )
    if z < lo || z > hi {
      std.orthogonal_geometry.OrthogonalReady { value: PointOutsideSpace }
    } else {
      match plan {
        PointOutsideLoop => std.orthogonal_geometry.OrthogonalReady { value: PointOutsideSpace }
        PointOnLoopBoundary => std.orthogonal_geometry.OrthogonalReady { value: PointOnSpaceBoundary }
        PointInsideLoop =>
          if z == lo || z == hi {
            std.orthogonal_geometry.OrthogonalReady { value: PointOnSpaceBoundary }
          } else {
            std.orthogonal_geometry.OrthogonalReady { value: PointInsideSpace }
          }
      }
    }
  }
}

// INTERPENETRATION IS EXACT, AND IT IS DECIDED BY SAMPLING CELLS, not by comparing bounding boxes
// and not by the vertex-and-edge-crossing test this function used first.
//
// THE REFUTED VERSION, kept here because the argument for it is persuasive and wrong: two
// footprints overlap iff a vertex of one is strictly inside the other or two of their edges
// properly cross - since otherwise they are disjoint or one contains the other, and containment
// puts a vertex of the inner strictly inside the outer. That last step fails exactly when the
// boundaries COINCIDE. Two identical footprints have every vertex on the other's boundary rather
// than strictly inside it, and no pair of edges crosses transversally, so the test answered "no
// overlap" for two spaces occupying the same volume - a fail-open in the predicate a complex's
// admission wall depends on. It was found by mutating the vertical-range rule and noticing that a
// claim which should have flipped did not, i.e. by a control, not by reading the code.
//
// WHAT IS EXACT INSTEAD. The x-coordinates of both footprints cut the plane into vertical strips
// and the y-coordinates into horizontal ones; inside one such cell neither region's membership can
// change, so if the intersection has any area at all, some whole cell lies inside both. Testing
// the centre of every cell is therefore complete, and since a centre strictly inside both regions
// IS an overlap, it is also sound. Centres are half-integers, so the whole test runs at scale 2
// where they are integers - no rounding enters, which is the same promise the rest of the band
// makes.
//
// COST, stated rather than discovered later: finding the adjacent coordinate pairs is quadratic in
// the vertex count per axis and the cell scan is the product of the two axes' pair counts times the
// per-point edge walk. For architectural footprints (four to a few dozen vertices) that is small,
// and it is bounded by construction rather than by a limit anyone has to remember. Dissolve-on: a
// sorted coordinate sweep makes the adjacency search linear if a consumer ever brings footprints
// where this shows up in a measurement.
fn loop_axis_coords(l: std.orthogonal_geometry.OrthogonalLoop2, want_x: Bool) -> List<std.integer.Int> {
  reverse(fold(loop2_vertices(l: l), init: [], f: (acc, v) =>
    concat([if want_x { point2_x(p: v) } else { point2_y(p: v) }], acc)))
}

fn value_lies_strictly_between(v: std.integer.Int, lo: std.integer.Int, hi: std.integer.Int) -> Bool {
  lo < v && v < hi
}

// A pair is adjacent when no other coordinate falls strictly between them, which is the sorted-order
// neighbour relation computed without sorting. The midpoint is returned at scale 2, where it is an
// integer: the centre of the strip between lo and hi is (lo + hi) / 2, so at scale 2 it is lo + hi.
fn adjacent_pair_centres(coords: List<std.integer.Int>) -> List<std.integer.Int> {
  reverse(fold(coords, init: [], f: (outer_acc, lo) =>
    fold(coords, init: outer_acc, f: (acc, hi) =>
      if lo < hi && !fold(coords, init: false, f: (found, other) => found || value_lies_strictly_between(v: other, lo: lo, hi: hi)) {
        concat([lo + hi], acc)
      } else {
        acc
      })))
}

// The boundary arm is UNREACHABLE FROM THIS CALLER and that is a property of the cell construction,
// not an untested branch: every boundary line of either footprint sits at one of the coordinates the
// cells are cut on, and a centre is the midpoint of two ADJACENT coordinates, so it is strictly
// between them. Mutating the arm to true changes no claim, which is the expected result rather than
// a weak control - the arm is here because location_from_edges is three-valued and this caller is
// answering a two-valued question about the interior.
fn strictly_inside_scaled(edges: List<EdgeInts>, px: std.integer.Int, py: std.integer.Int) -> Bool {
  match location_from_edges(edges: edges, px: px, py: py) {
    PointInsideLoop => true
    PointOnLoopBoundary => false
    PointOutsideLoop => false
  }
}

fn footprints_overlap(a: std.orthogonal_geometry.OrthogonalLoop2, b: std.orthogonal_geometry.OrthogonalLoop2) -> Bool {
  let a_edges = scaled_edges(l: a, scale: 2)
  let b_edges = scaled_edges(l: b, scale: 2)
  let xs = concat(loop_axis_coords(l: a, want_x: true), loop_axis_coords(l: b, want_x: true))
  let ys = concat(loop_axis_coords(l: a, want_x: false), loop_axis_coords(l: b, want_x: false))
  let centre_ys = adjacent_pair_centres(coords: ys)
  fold(adjacent_pair_centres(coords: xs), init: false, f: (acc, cx) =>
    acc || fold(centre_ys, init: false, f: (inner, cy) =>
      inner || (strictly_inside_scaled(edges: a_edges, px: cx, py: cy)
        && strictly_inside_scaled(edges: b_edges, px: cx, py: cy))))
}

fn vertical_ranges_overlap(a: EnclosedSpace, b: EnclosedSpace) -> Bool {
  let a_lo = signed_frame_component_count(c: prism3_low(p: a.shell.prism))
  let a_hi = signed_frame_component_count(c: prism3_high(p: a.shell.prism))
  let b_lo = signed_frame_component_count(c: prism3_low(p: b.shell.prism))
  let b_hi = signed_frame_component_count(c: prism3_high(p: b.shell.prism))
  a_lo < b_hi && b_lo < a_hi
}

fn spaces_interpenetrate(a: EnclosedSpace, b: EnclosedSpace) -> std.orthogonal_geometry.OrthogonalConstruction<Bool> {
  if !coordinate_frame_identity_eq(a: space_frame(s: a), b: space_frame(s: b)) {
    std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.OrthogonalFrameMismatch { expected: space_frame(s: a), observed: space_frame(s: b) } }
  } else {
    std.orthogonal_geometry.OrthogonalReady {
      value: vertical_ranges_overlap(a: a, b: b)
        && footprints_overlap(a: space_footprint(s: a), b: space_footprint(s: b))
    }
  }
}

// THE SHARED REGION OF TWO WALLS, and adjacency is derived from it rather than decided beside it.
// An earlier revision answered only the Bool, so a consumer that needed to know WHERE two rooms meet
// - to put a door there, which is the whole reason the relation exists - had to recompute the
// overlap with its own copy of the rule. Two copies of one geometric fact is the fork DESIGN section
// 3 forbids, and the copy would have been in a downstream module where a drift in either direction
// admits an opening in a wall that is not shared.
//
// The region is empty rather than degenerate when the walls touch without overlapping: a coincident
// corner and a zero-height band are both absences of a place to cut a hole, so the comparison is
// strict on both axes and returns nothing rather than a rectangle with no area.
type WallOverlap {
  runs_north_south: Bool
  position: std.integer.Int
  along_low: std.integer.Int
  along_high: std.integer.Int
  low: std.integer.Int
  high: std.integer.Int
}

fn wall_runs_north_south(w: ShellWall) -> Bool {
  point2_x(p: w.start) == point2_x(p: w.end)
}

fn wall_along_low(w: ShellWall) -> std.integer.Int {
  if wall_runs_north_south(w: w) {
    min_of(a: point2_y(p: w.start), b: point2_y(p: w.end))
  } else {
    min_of(a: point2_x(p: w.start), b: point2_x(p: w.end))
  }
}

fn wall_along_high(w: ShellWall) -> std.integer.Int {
  if wall_runs_north_south(w: w) {
    max_of(a: point2_y(p: w.start), b: point2_y(p: w.end))
  } else {
    max_of(a: point2_x(p: w.start), b: point2_x(p: w.end))
  }
}

fn wall_position(w: ShellWall) -> std.integer.Int {
  if wall_runs_north_south(w: w) { point2_x(p: w.start) } else { point2_y(p: w.start) }
}

fn shared_wall_region(a: ShellWall, b: ShellWall) -> WallOverlap? {
  if wall_runs_north_south(w: a) != wall_runs_north_south(w: b) {
    none
  } else {
    if wall_position(w: a) != wall_position(w: b) {
      none
    } else {
      let low = max_of(a: a.low, b: b.low)
      let high = min_of(a: a.high, b: b.high)
      let along_low = max_of(a: wall_along_low(w: a), b: wall_along_low(w: b))
      let along_high = min_of(a: wall_along_high(w: a), b: wall_along_high(w: b))
      if low >= high || along_low >= along_high {
        none
      } else {
        v2.std.optional.Present {
          value: WallOverlap {
            runs_north_south: wall_runs_north_south(w: a),
            position: wall_position(w: a),
            along_low: along_low,
            along_high: along_high,
            low: low,
            high: high,
          }
        }
      }
    }
  }
}

// ADJACENCY IS SHARING A WALL, which is a coincidence of geometry and never an authored edge. Two
// spaces are adjacent when a wall of one is collinear with a wall of the other and their spans
// overlap in both the horizontal and the vertical direction. Touching at a single point or along a
// zero-length span is not adjacency: you cannot put a door there, which is what the relation is
// for, so the comparison is strict on both axes - and it is strict because the region above is,
// which is now the single place that rule is written.
fn walls_are_shared(a: ShellWall, b: ShellWall) -> Bool {
  match shared_wall_region(a: a, b: b) {
    v2.std.optional.Absent => false
    v2.std.optional.Present { value: _ } => true
  }
}

fn spaces_are_adjacent(a: EnclosedSpace, b: EnclosedSpace) -> std.orthogonal_geometry.OrthogonalConstruction<Bool> {
  if !coordinate_frame_identity_eq(a: space_frame(s: a), b: space_frame(s: b)) {
    std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.OrthogonalFrameMismatch { expected: space_frame(s: a), observed: space_frame(s: b) } }
  } else {
    let b_walls = space_walls(s: b)
    std.orthogonal_geometry.OrthogonalReady {
      value: fold(space_walls(s: a), init: false, f: (acc, wa) =>
        acc || fold(b_walls, init: false, f: (inner_acc, wb) => inner_acc || walls_are_shared(a: wa, b: wb)))
    }
  }
}

// A COMPLEX IS THE CONSTRUCTION WALL, and it is what makes every question above total for its
// members. Once a set of spaces is admitted, no two of them interpenetrate and all of them share a
// frame - so a consumer folding over a complex never re-asks, and a downstream operation cannot be
// handed the overlapping pair that a per-call check would have let through whenever someone forgot
// to call it. The pair test is quadratic and inherently so; what would NOT have been inherent is
// re-deriving each member's walls inside the inner loop, so the walls are derived once per member.
type SpaceComplex sole_constructor {
  spaces: List<EnclosedSpace>
}

type ComplexAccum {
  admitted: List<EnclosedSpace>
  refusal: std.orthogonal_geometry.OrthogonalRefusal?
}

fn admit_space(acc: ComplexAccum, s: EnclosedSpace) -> ComplexAccum {
  match acc.refusal {
    v2.std.optional.Present { value: r } => ComplexAccum { admitted: acc.admitted, refusal: v2.std.optional.Present { value: r } }
    v2.std.optional.Absent =>
      let conflict = fold(acc.admitted, init: none, f: (found, other) =>
        match found {
          v2.std.optional.Present { value: r } => v2.std.optional.Present { value: r }
          v2.std.optional.Absent =>
            match spaces_interpenetrate(a: other, b: s) {
              OrthogonalRefused { cause: c } => v2.std.optional.Present { value: c }
              OrthogonalReady { value: overlaps } =>
                if overlaps { v2.std.optional.Present { value: SpacesInterpenetrate } } else { none }
            }
        })
      match conflict {
        v2.std.optional.Present { value: r } => ComplexAccum { admitted: acc.admitted, refusal: v2.std.optional.Present { value: r } }
        v2.std.optional.Absent => ComplexAccum { admitted: concat([s], acc.admitted), refusal: none }
      }
  }
}

fn space_complex(spaces: List<EnclosedSpace>) -> std.orthogonal_geometry.OrthogonalConstruction<SpaceComplex> {
  let acc = fold(spaces, init: ComplexAccum { admitted: [], refusal: none }, f: (a, s) => admit_space(acc: a, s: s))
  match acc.refusal {
    v2.std.optional.Present { value: r } => std.orthogonal_geometry.OrthogonalRefused { cause: r }
    v2.std.optional.Absent => std.orthogonal_geometry.OrthogonalReady { value: SpaceComplex { spaces: spaces } }
  }
}

fn complex_spaces(c: SpaceComplex) -> List<EnclosedSpace> { c.spaces }

fn complex_space_count(c: SpaceComplex) -> std.integer.Int { length(c.spaces) }

// The total volume of a complex is a sum the members cannot double-count, because admission already
// proved they do not overlap. That is the payoff of the wall being at the mint rather than here:
// this fold is a sum, not a sum plus an inclusion-exclusion correction nobody would get right.
fn complex_total_volume(registry: std.spatial_frame.SpatialFrameRegistry, c: SpaceComplex) -> std.orthogonal_geometry.OrthogonalConstruction<std.measure.CubicMillimeter> {
  fold(c.spaces, init: std.orthogonal_geometry.OrthogonalReady { value: cubic_millimeter(count: 0) }, f: (acc, s) =>
    match acc {
      OrthogonalRefused { cause: r } => std.orthogonal_geometry.OrthogonalRefused { cause: r }
      OrthogonalReady { value: total } =>
        match space_volume(registry: registry, s: s) {
          OrthogonalRefused { cause: r } => std.orthogonal_geometry.OrthogonalRefused { cause: r }
          OrthogonalReady { value: v } =>
            match checked_int_add(a: cubic_millimeter_count_as_int(m: total), b: cubic_millimeter_count_as_int(m: v)) {
              CheckedIntOverflow { cause: c } => std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.ShellArithmeticRefused { cause: c } }
              CheckedIntReady { value: sum } =>
                match checked_int_magnitude(a: sum) {
                  CheckedNatOverflow { cause: c } => std.orthogonal_geometry.OrthogonalRefused { cause: std.orthogonal_geometry.ShellArithmeticRefused { cause: c } }
                  CheckedNatReady { value: n } => std.orthogonal_geometry.OrthogonalReady { value: cubic_millimeter(count: n) }
                }
            }
        }
    })
}
