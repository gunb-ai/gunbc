module std.fold_parallelism

import std.types { Int }
import std.measure {
  HardwareThreadCount,
  hardware_thread_count,
  hardware_thread_count_value,
}
import std.induction { ceil_log }
import std.int_ops { int_min, int_max, int_ceil_div }

data fold_parallelism_plan_doc_provenance: String = "bind: docs/plans/machine-shape-orthogonal-scheduling.md §6 — within-fold serial vs tree-reduce; depth/width derive from lane_count (one axis, no machine kind)"

type FoldParallelism
  = SerialFold
  | TreeReduce { tree_depth: Int, lane_width: HardwareThreadCount }

fn serial_fold_parallelism() -> FoldParallelism {
  SerialFold
}

fn tree_reduce_lane_width_eq(left: HardwareThreadCount, right: HardwareThreadCount) -> Bool {
  hardware_thread_count_value(t: left) == hardware_thread_count_value(t: right)
}

fn fold_parallelism_eq(left: FoldParallelism, right: FoldParallelism) -> Bool {
  match left {
    SerialFold => match right {
      SerialFold => true
      TreeReduce { tree_depth: _, lane_width: _ } => false
    }
    TreeReduce { tree_depth: ld, lane_width: lw } => match right {
      SerialFold => false
      TreeReduce { tree_depth: rd, lane_width: rw } =>
        (ld == rd) && tree_reduce_lane_width_eq(left: lw, right: rw)
    }
  }
}

fn derive_tree_reduce_parallelism(
  lane_count: HardwareThreadCount,
  element_count: Int
) -> FoldParallelism? {
  let lanes = hardware_thread_count_value(t: lane_count)
  if lanes < 1 || element_count < 1 {
    none
  } else {
    let lane_width_count = int_min(a: lanes, b: element_count)
    match int_ceil_div(numerator: element_count, denominator: lane_width_count) {
      Absent => none
      Present { value: segment_count } =>
        match ceil_log(base: 2, argument: segment_count) {
          Absent => none
          Present { value: depth } =>
            Present {
              value: TreeReduce {
                tree_depth: depth
                lane_width: hardware_thread_count(count: lane_width_count)
              }
            }
        }
    }
  }
}

fn idle_lane_count(lane_count: HardwareThreadCount) -> Int {
  let lanes = hardware_thread_count_value(t: lane_count)
  int_max(a: lanes - 1, b: 0)
}
