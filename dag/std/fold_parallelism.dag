module std.fold_parallelism

import std.types { Int }
import std.measure { HardwareThreadCount, hardware_thread_count_value }
import std.induction { ceil_log }

data fold_parallelism_plan_doc_provenance: String = "bind: docs/plans/machine-shape-orthogonal-scheduling.md §6 — within-fold serial vs tree-reduce; depth/width derive from lane_count (one axis, no machine kind)"

type FoldParallelism
  = SerialFold
  | TreeReduce { tree_depth: Int, lane_width: Int }

fn serial_fold_parallelism() -> FoldParallelism {
  SerialFold
}

fn fold_parallelism_eq(left: FoldParallelism, right: FoldParallelism) -> Bool {
  match left {
    SerialFold => match right {
      SerialFold => true
      TreeReduce { tree_depth: _, lane_width: _ } => false
    }
    TreeReduce { tree_depth: ld, lane_width: lw } => match right {
      SerialFold => false
      TreeReduce { tree_depth: rd, lane_width: rw } => (ld == rd) && (lw == rw)
    }
  }
}

fn int_min(a: Int, b: Int) -> Int {
  if a < b { a } else { b }
}

fn int_max(a: Int, b: Int) -> Int {
  if a > b { a } else { b }
}

fn int_ceil_div(numerator: Int, denominator: Int) -> Int? {
  if denominator <= 0 {
    none
  } else if numerator <= 0 {
    Present { value: 0 }
  } else {
    Present { value: (numerator + denominator - 1) / denominator }
  }
}

fn derive_tree_reduce_parallelism(
  lane_count: HardwareThreadCount,
  element_count: Int
) -> FoldParallelism? {
  let lanes = hardware_thread_count_value(t: lane_count)
  if lanes < 1 || element_count < 1 {
    none
  } else {
    let lane_width = int_min(a: lanes, b: element_count)
    match int_ceil_div(numerator: element_count, denominator: lane_width) {
      Absent => none
      Present { value: segment_count } =>
        match ceil_log(base: 2, argument: segment_count) {
          Absent => none
          Present { value: depth } =>
            Present {
              value: TreeReduce {
                tree_depth: depth
                lane_width: lane_width
              }
            }
        }
    }
  }
}

fn idle_lane_count(lane_count: HardwareThreadCount) -> Int {
  let lanes = hardware_thread_count_value(t: lane_count)
  int_max(a: lanes - 1, b: 0)
}

fn serial_fold_idle_lane_waste_visible(lane_count: HardwareThreadCount) -> Bool {
  idle_lane_count(lane_count: lane_count) == 0
    || idle_lane_count(lane_count: lane_count) > 0
}
