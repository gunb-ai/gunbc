module std.frame_boundary


data frame_boundary_note: String = "Frame-boundary SPEC (docs/plans/effect-namespace-grants.md 6, owned silent-ibex-417): the effect-grants Envelope says what is INSIDE a frame (its grants); this says how the frame's BOUNDARY -- everything OUTSIDE the envelope -- is enforced, per LAYER (operator framing 2026-07-20: isolation is a per-layer property; each std.effect_grant.NamespaceTree is a layer; netns/container/seccomp/mock are different MATERIALIZATIONS of different layers' boundaries). This is the frame-grain sibling of std.effect_grant.HandlerBinding (RealTransport|Replay = reach-for-real vs mock/simulate, at the per-grant grain): the boundary is that same real-vs-simulate idea lifted to the whole frame. §3 SEAM (the load-bearing split): this module is the AGNOSTIC SPEC -- is a layer closed, at what LifecycleGrade -- and names NO mechanism. The mechanisms (netns, container, seccomp, the mock/Simulated baseline) are REALIZATION HANDLERS in extdeps that CONSTRUCT a BoundaryMaterialization; dispatch lives in extdeps, not std (the lane's own rule). Two things wear the word 'materialization' and DESIGN 3 splits them here: (A) the boundary SPEC = this carrier, a REACH fact, NOT std.realization.Materialization=Recompute|Memoize|Share (that is the redundant-COMPUTATION axis -- folding reach into it is a state-space conflation); (B) the boundary PROVISIONING (spawn a netns/container) = a realized host-effect through std.realization when a ByConstruction mechanism lands (its 'create isolation context' a CreateEffect keyed by the envelope, so the kernel schedules/costs/Shares it). The single common implementation is (B)-free: the mock/Simulated handler closes a layer at LifecycleByConvention with nothing to provision -- always available, ships the P3-native native run fail-closed; netns/container upgrade the SAME boundary to LifecycleByConstruction later, a row not a fork. dissolve-on = extdeps Simulated handler + the emit_host_run_transport intrinsic runs only when boundary_admits its required layers (the build's UriTree/network layer); netns/container handlers land as the ByConstruction upgrade."

type BoundaryClosure {
  tree: std.effect_grant.NamespaceTree
  grade: std.effect_grant.LifecycleGrade
}

type BoundaryMaterialization {
  closures: List<BoundaryClosure>
}

type TreeCoverage
  = Covered { grade: std.effect_grant.LifecycleGrade }
  | Uncovered

type BoundaryAdmission
  = BoundaryMaterialized { grade: std.effect_grant.LifecycleGrade }
  | BoundaryUnmaterialized { tree: std.effect_grant.NamespaceTree }

fn boundary_grade_meet(a: std.effect_grant.LifecycleGrade, b: std.effect_grant.LifecycleGrade) -> std.effect_grant.LifecycleGrade {
  match a {
    LifecycleByConvention => LifecycleByConvention
    LifecycleByConstruction => b
  }
}

fn tree_coverage(closures: List<BoundaryClosure>, tree: std.effect_grant.NamespaceTree) -> TreeCoverage {
  fold(
    closures,
    init: Uncovered,
    f: (acc, c) => match acc {
      Covered { grade: g } => acc
      Uncovered =>
        if namespace_tree_eq(a: c.tree, b: tree) {
          Covered { grade: c.grade }
        } else {
          Uncovered
        }
    }
  )
}

fn boundary_admit_tree(
  acc: BoundaryAdmission,
  tree: std.effect_grant.NamespaceTree,
  provided: BoundaryMaterialization
) -> BoundaryAdmission {
  match acc {
    BoundaryUnmaterialized { tree: t } => acc
    BoundaryMaterialized { grade: g } =>
      match tree_coverage(closures: provided.closures, tree: tree) {
        Uncovered => BoundaryUnmaterialized { tree: tree }
        Covered { grade: gc } =>
          BoundaryMaterialized { grade: boundary_grade_meet(a: g, b: gc) }
      }
  }
}

fn boundary_admits(
  required_trees: List<std.effect_grant.NamespaceTree>,
  provided: BoundaryMaterialization
) -> BoundaryAdmission {
  fold(
    required_trees,
    init: BoundaryMaterialized { grade: LifecycleByConstruction },
    f: (acc, tree) => boundary_admit_tree(acc: acc, tree: tree, provided: provided)
  )
}
