module std.occurrence_binding_candidates



data occurrence_binding_candidates_authority_note: String = "P2a: THE structural candidate producer that hands supplied candidates to std.occurrence_binding_resolve.resolve_reference_occurrence_binding (P1). P1 owns exact-identity transport validation, category admissibility, and the single occurrence_binding_from_candidates cardinality fold; it decides nothing about which declarations are structurally exposed to a reference. This module owns exactly that: exposure (namespace-resolution-design.md 13 / namespace-unique-on-chain-operational-plan.md 2), deterministic source-order gating, an indexed candidate catalogue (declarations bucketed by authored spelling, so per-reference lookup is not an O(declarations) rescan), and the BoundReferenceProvider / DirectModuleDependency projections of an accepted P1 decision. It never folds cardinality itself and never treats an authored import list as visibility evidence. ROADMAP lane: namespace-reference-derived-closure."

data occurrence_binding_candidates_roadmap_anchor: String = "gunbc.roadmap_authority namespace-reference-derived-closure"

data occurrence_binding_candidates_prefix_bug_note: String = "The pre-strip P1 exposure predicate (git show ba4d1f22671^:dag/std/occurrence_binding_resolve.dag, declaration_exposed_on_reference_chain) tested only occurrence_containment_path_is_prefix_of(declaration.containment, reference.containment): a declaration is exposed exactly when its own occurrence id sits somewhere on the reference's ancestor chain. That is correct for genuine lexical nesting (a let, a lambda/function parameter, a pattern binder all scope-wrap what they enclose, so the binder's own node is a literal ancestor of every reference inside it) but it structurally MISSES module-scope siblings: two ordinary functions declared side by side in one module do not nest inside each other, so neither's occurrence id is ever an ancestor of a reference in the other's body, and the prefix test alone always answers false. occurrence_containment_path_is_prefix_of is imported from std.occurrence_identity (single authority) and the module-sibling disjunct is added beside it, never in place of it."

data occurrence_module_path_row_note: String = "OccurrenceModulePathRow is the P2a-owned association between one occurrence and the module path its authored text belongs to — which authored source unit the text lives in. It is deliberately independent of OccurrenceContainmentPath and of DeclarationExposure: module membership for projection is not proof of module-scope exposure, and a nested declaration can share a module path without being a module sibling candidate."

data occurrence_module_path_convergence_note: String = "Convergence, not fork: OccurrenceModulePathRow.module_path matches std.decl_ref.DeclarationRef.module_path (NonEmptyStr) — the single declaration-identity authority's existing representation, not a weaker String parallel and not a premature v2.std.qualified_name import (zero dag/std→v2 imports exist today). module_path becomes v2.std.qualified_name.QualifiedName when the namespace and module-identity lanes land those carriers (same trigger as std.observation observation_segment_grounding_note). Until then the representation is std's existing one, so there is nothing new to migrate."

data declaration_exposure_note: String = "DeclarationExposure is THE deciding authority for whether a declaration is structurally exposed to a reference (namespace-resolution-design.md 13 / namespace-unique-on-chain-operational-plan.md 2). LexicalExposure\{exposing_scope\} exposes exactly when its exposing_scope contains the reference (occurrence_containment_path_is_prefix_of); ModuleExposure\{module\} exposes when the reference shares that module and the declaration's AuthoredTokenOrdinal is strictly before the reference's; RootExposure exposes on every candidate lookup (root declarations on every applicable chain). Raw declaration.containment must never remain a parallel binding rule beside the carrier — containment may derive LexicalExposure when rows are produced, but the decision reads only DeclarationExposure. Category must never be substituted for exposure."

type DeclarationExposure
  = LexicalExposure { exposing_scope: std.occurrence_identity.OccurrenceContainmentPath }
  | ModuleExposure { module: std.types.NonEmptyStr }
  | RootExposure

type DeclarationExposureRow {
  occurrence: std.occurrence_identity.OccurrenceId
  exposure: DeclarationExposure
}

data authored_order_note: String = "AuthoredOrderRow carries the authored token ordinal for one occurrence — the source-order axis, distinct from OccurrenceId identity. Module-sibling gating compares ordinals only; never OccurrenceId.value as a proxy for authored order. AuthoredTokenOrdinal authority is std.occurrence_identity (feature:occurrence-ordinal-value-measure dissolve-on) — this module does not mint a parallel Int brand."

type AuthoredOrderRow {
  occurrence: std.occurrence_identity.OccurrenceId
  ordinal: std.occurrence_identity.AuthoredTokenOrdinal
}

type OccurrenceBindingCandidateInputs {
  module_paths: List<OccurrenceModulePathRow>
  exposure_rows: List<DeclarationExposureRow>
  authored_order_rows: List<AuthoredOrderRow>
}

type OccurrenceModulePathRow {
  occurrence: std.occurrence_identity.OccurrenceId
  module_path: std.types.NonEmptyStr
}

type OccurrenceModulePathIndexRefusal
  = DuplicateOccurrenceModulePathRow {
      occurrence: std.occurrence_identity.OccurrenceId,
      first_module_path: std.types.NonEmptyStr,
      conflicting_module_path: std.types.NonEmptyStr,
    }
  | MissingOccurrenceModulePathRow { occurrence: std.occurrence_identity.OccurrenceId }

type OccurrenceModulePathIndexBuild {
  module_by_occurrence: Map<Int, std.types.NonEmptyStr>
  refusal: OccurrenceModulePathIndexRefusal?
}

fn module_by_occurrence_fold_step(
  build: OccurrenceModulePathIndexBuild,
  row: OccurrenceModulePathRow
) -> OccurrenceModulePathIndexBuild {
  match build.refusal {
    Present { value: _ } => build
    Absent =>
      match map_get(build.module_by_occurrence, row.occurrence.value) {
        Present { value: existing } =>
          if existing == row.module_path {
            build
          } else {
            OccurrenceModulePathIndexBuild {
              module_by_occurrence: build.module_by_occurrence,
              refusal: Present {
                value: DuplicateOccurrenceModulePathRow {
                  occurrence: row.occurrence,
                  first_module_path: existing,
                  conflicting_module_path: row.module_path,
                },
              },
            }
          }
        Absent =>
          OccurrenceModulePathIndexBuild {
            module_by_occurrence: map_insert(
              build.module_by_occurrence,
              row.occurrence.value,
              row.module_path,
            ),
            refusal: none,
          }
      }
  }
}

fn module_by_occurrence_build(
  rows: List<OccurrenceModulePathRow>
) -> OccurrenceModulePathIndexBuild {
  fold(
    rows,
    init: OccurrenceModulePathIndexBuild {
      module_by_occurrence: empty_map(),
      refusal: none,
    },
    f: (build, row) => module_by_occurrence_fold_step(build: build, row: row),
  )
}

type DeclarationExposureIndexRefusal
  = MissingDeclarationExposure {
      occurrence: std.occurrence_identity.OccurrenceId,
    }
  | ConflictingDeclarationExposure {
      occurrence: std.occurrence_identity.OccurrenceId,
      first_exposure: DeclarationExposure,
      conflicting_exposure: DeclarationExposure,
    }

type DeclarationExposureIndexBuild {
  exposure_by_occurrence: Map<Int, DeclarationExposure>
  refusal: DeclarationExposureIndexRefusal?
}

fn declaration_exposure_eq(
  left: DeclarationExposure,
  right: DeclarationExposure
) -> Bool {
  match left {
    LexicalExposure { exposing_scope: left_scope } =>
      match right {
        LexicalExposure { exposing_scope: right_scope } =>
          occurrence_containment_paths_equal(left: left_scope, right: right_scope)
        _ => false
      }
    ModuleExposure { module: left_module } =>
      match right {
        ModuleExposure { module: right_module } => left_module == right_module
        _ => false
      }
    RootExposure =>
      match right {
        RootExposure => true
        _ => false
      }
  }
}

data declaration_exposure_from_containment_note: String = "Single authority for declaration exposure from containment prefix shape and module path. OccurrenceCategory is never consulted. DeclarationExposureGrounding selects how module-root and direct-module-child shapes map to DeclarationExposure: NamespaceStructuralRootExposure (N2 resolve path — empty ancestors => RootExposure); ModuleLocalMemberExposure (in-module binding walk — module-root and direct-module-child => ModuleExposure); CrossFileProviderExportedExposure (cross-file provider declarations exported to consumers — module-root and direct-module-child => RootExposure at derivation, never via a post-hoc upgrade). Nested declarations always derive LexicalExposure via occurrence_containment_parent_scope."

type DeclarationExposureGrounding
  = NamespaceStructuralRootExposure
  | ModuleLocalMemberExposure
  | CrossFileProviderExportedExposure

fn occurrence_containment_parent_scope(
  ancestors: FreeMonoid<std.occurrence_identity.OccurrenceId>
) -> std.occurrence_identity.OccurrenceContainmentPath? {
  match reverse(ancestors) {
    Empty => none
    Cons { head: parent_terminal, tail: parent_ancestors_reversed } =>
      Present {
        value: std.occurrence_identity.OccurrenceContainmentPath {
          ancestors: reverse(parent_ancestors_reversed),
          terminal: parent_terminal,
        },
      }
  }
}

fn declaration_exposure_module_local_member(
  module_path: std.types.NonEmptyStr,
  containment: std.occurrence_identity.OccurrenceContainmentPath
) -> DeclarationExposure {
  match occurrence_containment_parent_scope(ancestors: containment.ancestors) {
    Absent =>
      ModuleExposure { module: module_path }
    Present { value: exposing_scope } =>
      match exposing_scope.ancestors {
        Empty =>
          ModuleExposure { module: module_path }
        Cons { head: _, tail: _ } =>
          LexicalExposure { exposing_scope: exposing_scope }
      }
  }
}

fn declaration_exposure_namespace_structural_root(
  module_path: std.types.NonEmptyStr,
  containment: std.occurrence_identity.OccurrenceContainmentPath,
) -> DeclarationExposure {
  match occurrence_containment_parent_scope(
    ancestors: containment.ancestors,
  ) {
    Absent =>
      RootExposure

    Present { value: exposing_scope } =>
      match exposing_scope.ancestors {
        Empty =>
          ModuleExposure { module: module_path }

        Cons { head: _, tail: _ } =>
          LexicalExposure { exposing_scope: exposing_scope }
      }
  }
}

fn declaration_exposure_from_containment(
  module_path: std.types.NonEmptyStr,
  containment: std.occurrence_identity.OccurrenceContainmentPath,
  grounding: DeclarationExposureGrounding
) -> DeclarationExposure {
  match grounding {
    NamespaceStructuralRootExposure =>
      declaration_exposure_namespace_structural_root(
        module_path: module_path,
        containment: containment,
      )
    ModuleLocalMemberExposure =>
      declaration_exposure_module_local_member(
        module_path: module_path,
        containment: containment,
      )
    CrossFileProviderExportedExposure =>
      match declaration_exposure_module_local_member(
        module_path: module_path,
        containment: containment,
      ) {
        ModuleExposure { module: _ } => RootExposure
        LexicalExposure { exposing_scope: exposing_scope } =>
          LexicalExposure { exposing_scope: exposing_scope }
        RootExposure => RootExposure
      }
  }
}

fn declaration_exposure_fold_step(
  build: DeclarationExposureIndexBuild,
  row: DeclarationExposureRow
) -> DeclarationExposureIndexBuild {
  match build.refusal {
    Present { value: _ } => build
    Absent =>
      match map_get(build.exposure_by_occurrence, row.occurrence.value) {
        Present { value: existing } =>
          if declaration_exposure_eq(left: existing, right: row.exposure) {
            build
          } else {
            DeclarationExposureIndexBuild {
              exposure_by_occurrence: build.exposure_by_occurrence,
              refusal: Present {
                value: ConflictingDeclarationExposure {
                  occurrence: row.occurrence,
                  first_exposure: existing,
                  conflicting_exposure: row.exposure,
                },
              },
            }
          }
        Absent =>
          DeclarationExposureIndexBuild {
            exposure_by_occurrence: map_insert(
              build.exposure_by_occurrence,
              row.occurrence.value,
              row.exposure,
            ),
            refusal: none,
          }
      }
  }
}

fn exposure_by_occurrence_build(
  rows: List<DeclarationExposureRow>
) -> DeclarationExposureIndexBuild {
  fold(
    rows,
    init: DeclarationExposureIndexBuild {
      exposure_by_occurrence: empty_map(),
      refusal: none,
    },
    f: (build, row) => declaration_exposure_fold_step(build: build, row: row),
  )
}

type AuthoredOrderIndexRefusal
  = MissingAuthoredOrderRow {
      occurrence: std.occurrence_identity.OccurrenceId,
    }
  | ConflictingAuthoredOrderRow {
      occurrence: std.occurrence_identity.OccurrenceId,
      first_ordinal: std.occurrence_identity.AuthoredTokenOrdinal,
      conflicting_ordinal: std.occurrence_identity.AuthoredTokenOrdinal,
    }

type AuthoredOrderIndexBuild {
  order_by_occurrence: Map<Int, std.occurrence_identity.AuthoredTokenOrdinal>
  refusal: AuthoredOrderIndexRefusal?
}

fn authored_order_fold_step(
  build: AuthoredOrderIndexBuild,
  row: AuthoredOrderRow
) -> AuthoredOrderIndexBuild {
  match build.refusal {
    Present { value: _ } => build
    Absent =>
      match map_get(build.order_by_occurrence, row.occurrence.value) {
        Present { value: existing } =>
          if authored_token_ordinal_eq(left: existing, right: row.ordinal) {
            build
          } else {
            AuthoredOrderIndexBuild {
              order_by_occurrence: build.order_by_occurrence,
              refusal: Present {
                value: ConflictingAuthoredOrderRow {
                  occurrence: row.occurrence,
                  first_ordinal: existing,
                  conflicting_ordinal: row.ordinal,
                },
              },
            }
          }
        Absent =>
          AuthoredOrderIndexBuild {
            order_by_occurrence: map_insert(
              build.order_by_occurrence,
              row.occurrence.value,
              row.ordinal,
            ),
            refusal: none,
          }
      }
  }
}

fn authored_order_by_occurrence_build(
  rows: List<AuthoredOrderRow>
) -> AuthoredOrderIndexBuild {
  fold(
    rows,
    init: AuthoredOrderIndexBuild {
      order_by_occurrence: empty_map(),
      refusal: none,
    },
    f: (build, row) => authored_order_fold_step(build: build, row: row),
  )
}

fn ordinal_of_occurrence(
  order_by_occurrence: Map<Int, std.occurrence_identity.AuthoredTokenOrdinal>,
  occurrence: std.occurrence_identity.OccurrenceId
) -> std.occurrence_identity.AuthoredTokenOrdinal? {
  map_get(order_by_occurrence, occurrence.value)
}

fn exposure_of_occurrence(
  exposure_by_occurrence: Map<Int, DeclarationExposure>,
  occurrence: std.occurrence_identity.OccurrenceId
) -> DeclarationExposure? {
  map_get(exposure_by_occurrence, occurrence.value)
}

fn module_exposure_declaration_missing_path_refusal(
  module_by_occurrence: Map<Int, std.types.NonEmptyStr>,
  exposure_by_occurrence: Map<Int, DeclarationExposure>,
  declaration: std.occurrence_identity.DeclarationOccurrence
) -> OccurrenceModulePathIndexRefusal? {
  match map_get(exposure_by_occurrence, declaration.occurrence.value) {
    Absent => none
    Present { value: exposure } =>
      match exposure {
        ModuleExposure { module: _ } =>
          match map_get(module_by_occurrence, declaration.occurrence.value) {
            Absent =>
              Present {
                value: MissingOccurrenceModulePathRow {
                  occurrence: declaration.occurrence,
                },
              }
            Present { value: _ } => none
          }
        LexicalExposure { exposing_scope: _ } => none
        RootExposure => none
      }
  }
}

fn reference_missing_module_path_refusal(
  module_by_occurrence: Map<Int, std.types.NonEmptyStr>,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> OccurrenceModulePathIndexRefusal? {
  match map_get(module_by_occurrence, reference.occurrence.value) {
    Absent =>
      Present {
        value: MissingOccurrenceModulePathRow {
          occurrence: reference.occurrence,
        },
      }
    Present { value: _ } => none
  }
}

fn module_paths_validate_transport(
  transport: std.occurrence_identity.ValidatedOccurrenceTransport,
  module_by_occurrence: Map<Int, std.types.NonEmptyStr>,
  exposure_by_occurrence: Map<Int, DeclarationExposure>
) -> OccurrenceModulePathIndexRefusal? {
  let declaration_refusal = fold(
    transport.declarations,
    init: none,
    f: (refusal, declaration) =>
      match refusal {
        Present { value: _ } => refusal
        Absent =>
          module_exposure_declaration_missing_path_refusal(
            module_by_occurrence: module_by_occurrence,
            exposure_by_occurrence: exposure_by_occurrence,
            declaration: declaration,
          )
      },
  )
  match declaration_refusal {
    Present { value: refusal } => Present { value: refusal }
    Absent =>
      fold(
        transport.references,
        init: none,
        f: (refusal, reference) =>
          match refusal {
            Present { value: _ } => refusal
            Absent =>
              reference_missing_module_path_refusal(
                module_by_occurrence: module_by_occurrence,
                reference: reference,
              )
          },
      )
  }
}

fn module_of_occurrence(
  module_by_occurrence: Map<Int, std.types.NonEmptyStr>,
  occurrence: std.occurrence_identity.OccurrenceId
) -> std.types.NonEmptyStr? {
  map_get(module_by_occurrence, occurrence.value)
}

fn exposure_validate_transport_declarations(
  declarations: List<std.occurrence_identity.DeclarationOccurrence>,
  exposure_by_occurrence: Map<Int, DeclarationExposure>
) -> DeclarationExposureIndexRefusal? {
  fold(
    declarations,
    init: none,
    f: (refusal, declaration) =>
      match refusal {
        Present { value: _ } => refusal
        Absent =>
          match map_get(exposure_by_occurrence, declaration.occurrence.value) {
            Present { value: _ } => none
            Absent =>
              Present {
                value: MissingDeclarationExposure {
                  occurrence: declaration.occurrence,
                },
              }
          }
      },
  )
}

fn authored_order_validate_transport_occurrence(
  order_by_occurrence: Map<Int, std.occurrence_identity.AuthoredTokenOrdinal>,
  occurrence: std.occurrence_identity.OccurrenceId
) -> AuthoredOrderIndexRefusal? {
  match map_get(order_by_occurrence, occurrence.value) {
    Present { value: _ } => none
    Absent =>
      Present {
        value: MissingAuthoredOrderRow {
          occurrence: occurrence,
        },
      }
  }
}

fn authored_order_validate_transport(
  transport: std.occurrence_identity.ValidatedOccurrenceTransport,
  order_by_occurrence: Map<Int, std.occurrence_identity.AuthoredTokenOrdinal>
) -> AuthoredOrderIndexRefusal? {
  let declaration_refusal = fold(
    transport.declarations,
    init: none,
    f: (refusal, declaration) =>
      match refusal {
        Present { value: _ } => refusal
        Absent =>
          authored_order_validate_transport_occurrence(
            order_by_occurrence: order_by_occurrence,
            occurrence: declaration.occurrence,
          )
      },
  )
  match declaration_refusal {
    Present { value: refusal } => Present { value: refusal }
    Absent =>
      fold(
        transport.references,
        init: none,
        f: (refusal, reference) =>
          match refusal {
            Present { value: _ } => refusal
            Absent =>
              authored_order_validate_transport_occurrence(
                order_by_occurrence: order_by_occurrence,
                occurrence: reference.occurrence,
              )
          },
      )
  }
}

data occurrence_module_sibling_exposure_note: String = "ModuleExposure arm of the DeclarationExposure authority (namespace-unique-on-chain-operational-plan.md 2, rule 1): a declaration is exposed as a module sibling only when its DeclarationExposure is ModuleExposure for the same module as the reference, the declaration's AuthoredTokenOrdinal is strictly before the reference's ordinal (rule 4 — never a declaration below the occurrence), and both module paths are present for projection. OccurrenceCategory is not consulted. LexicalExposure and RootExposure are decided on their own arms — never by falling through to a raw containment-prefix test. Index build refuses MissingDeclarationExposure / MissingAuthoredOrderRow before any reference is answered, so Absent ordinal/exposure arms below are defensive dead code, never a silent Unbound."

fn declaration_lexically_exposed(
  exposing_scope: std.occurrence_identity.OccurrenceContainmentPath,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> Bool {
  occurrence_containment_path_is_prefix_of(
    prefix: exposing_scope,
    path: reference.containment,
  )
}

fn declaration_module_sibling_exposed(
  declaration: std.occurrence_identity.DeclarationOccurrence,
  reference: std.occurrence_identity.ReferenceOccurrence,
  exposure_module: std.types.NonEmptyStr,
  module_by_occurrence: Map<Int, std.types.NonEmptyStr>,
  order_by_occurrence: Map<Int, std.occurrence_identity.AuthoredTokenOrdinal>
) -> Bool {
  match ordinal_of_occurrence(
    order_by_occurrence: order_by_occurrence,
    occurrence: declaration.occurrence,
  ) {
    Absent => false
    Present { value: declaration_ordinal } =>
      match ordinal_of_occurrence(
        order_by_occurrence: order_by_occurrence,
        occurrence: reference.occurrence,
      ) {
        Absent => false
        Present { value: reference_ordinal } =>
          authored_token_ordinal_before(
            earlier: declaration_ordinal,
            later: reference_ordinal,
          ) && match module_of_occurrence(
            module_by_occurrence: module_by_occurrence,
            occurrence: reference.occurrence,
          ) {
            Absent => false
            Present { value: reference_module } =>
              reference_module == exposure_module
          }
      }
  }
}

fn declaration_exposed_on_reference_chain(
  declaration: std.occurrence_identity.DeclarationOccurrence,
  reference: std.occurrence_identity.ReferenceOccurrence,
  module_by_occurrence: Map<Int, std.types.NonEmptyStr>,
  exposure_by_occurrence: Map<Int, DeclarationExposure>,
  order_by_occurrence: Map<Int, std.occurrence_identity.AuthoredTokenOrdinal>
) -> Bool {
  match exposure_of_occurrence(
    exposure_by_occurrence: exposure_by_occurrence,
    occurrence: declaration.occurrence,
  ) {
    Absent => false
    Present { value: exposure } =>
      match exposure {
        LexicalExposure { exposing_scope: exposing_scope } =>
          declaration_lexically_exposed(
            exposing_scope: exposing_scope,
            reference: reference,
          )
        ModuleExposure { module: exposure_module } =>
          declaration_module_sibling_exposed(
            declaration: declaration,
            reference: reference,
            exposure_module: exposure_module,
            module_by_occurrence: module_by_occurrence,
            order_by_occurrence: order_by_occurrence,
          )
        RootExposure => true
      }
  }
}

data occurrence_candidate_index_note: String = "OccurrenceCandidateIndex is built exactly once per transport (occurrence_candidate_index_build). declarations_by_name buckets every declaration by its authored spelling so a single reference's candidate lookup is a map_get plus a scan of only the same-spelled declarations, never a rescan of the whole declaration population -- the O(declarations x references) shape the pre-strip candidate scan had. entries_by_id is the same validated lookup authority std.occurrence_binding_resolve builds internally; it is retained here only to read authored_name, never to re-decide cardinality."

type OccurrenceCandidateIndex {
  entries_by_id: Map<Int, std.occurrence_identity.OccurrenceIndexEntry>
  declarations_by_name: Map<String, List<std.occurrence_identity.DeclarationOccurrence>>
  module_by_occurrence: Map<Int, std.types.NonEmptyStr>
  exposure_by_occurrence: Map<Int, DeclarationExposure>
  order_by_occurrence: Map<Int, std.occurrence_identity.AuthoredTokenOrdinal>
}

fn declarations_by_name_insert(
  acc: Map<String, List<std.occurrence_identity.DeclarationOccurrence>>,
  name: String,
  declaration: std.occurrence_identity.DeclarationOccurrence
) -> Map<String, List<std.occurrence_identity.DeclarationOccurrence>> {
  match map_get(acc, name) {
    Absent => map_insert(acc, name, [declaration])
    Present { value: existing } =>
      map_insert(acc, name, concat([declaration], existing))
  }
}

data declarations_by_name_build_note: String = "declarations_by_name_build refuses MissingDeclarationIndexEntry when a transported declaration is absent from entries_by_id — never silent-skips (Absent => acc). A vanished declaration would shrink the candidate population and reopen the vanishing-population fail-open. After occurrence_transport_validate the Absent arm is unreachable (declaration_occurrence_refusal already demands index membership); the typed refusal keeps that impossibility loud if the constructor is ever reached with an inconsistent pair."

type DeclarationsByNameBuild
  = DeclarationsByNameReady {
      by_name: Map<String, List<std.occurrence_identity.DeclarationOccurrence>>,
    }
  | DeclarationsByNameMissingIndexEntry {
      occurrence: std.occurrence_identity.OccurrenceId,
    }

type DeclarationsByNameFold
  = DeclarationsByNameFoldReady {
      by_name: Map<String, List<std.occurrence_identity.DeclarationOccurrence>>,
    }
  | DeclarationsByNameFoldMissing {
      occurrence: std.occurrence_identity.OccurrenceId,
    }

fn declarations_by_name_build(
  entries_by_id: Map<Int, std.occurrence_identity.OccurrenceIndexEntry>,
  declarations: List<std.occurrence_identity.DeclarationOccurrence>
) -> DeclarationsByNameBuild {
  let fold_result = fold(
    declarations,
    init: DeclarationsByNameFoldReady { by_name: empty_map() },
    f: (acc, declaration) =>
      match acc {
        DeclarationsByNameFoldMissing { occurrence: _ } => acc
        DeclarationsByNameFoldReady { by_name: by_name } =>
          match map_get(entries_by_id, declaration.occurrence.value) {
            Absent =>
              DeclarationsByNameFoldMissing {
                occurrence: declaration.occurrence,
              }
            Present { value: entry } =>
              DeclarationsByNameFoldReady {
                by_name: declarations_by_name_insert(
                  acc: by_name,
                  name: entry.projection.authored_name,
                  declaration: declaration,
                ),
              }
          }
      },
  )
  match fold_result {
    DeclarationsByNameFoldReady { by_name: by_name } =>
      DeclarationsByNameReady { by_name: by_name }
    DeclarationsByNameFoldMissing { occurrence: occurrence } =>
      DeclarationsByNameMissingIndexEntry { occurrence: occurrence }
  }
}

type OccurrenceCandidateIndexBuild
  = OccurrenceCandidateIndexReady { index: OccurrenceCandidateIndex }
  | OccurrenceCandidateIndexTransportRefused { refusal: std.occurrence_identity.OccurrenceTransportRefusal }
  | OccurrenceCandidateIndexModulePathRefused { refusal: OccurrenceModulePathIndexRefusal }
  | OccurrenceCandidateIndexExposureRefused { refusal: DeclarationExposureIndexRefusal }
  | OccurrenceCandidateIndexAuthoredOrderRefused { refusal: AuthoredOrderIndexRefusal }
  | OccurrenceCandidateIndexDeclarationBucketRefused { occurrence: std.occurrence_identity.OccurrenceId }

fn occurrence_candidate_index_build(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs
) -> OccurrenceCandidateIndexBuild {
  match occurrence_transport_validate(transport: transport) {
    OccurrenceTransportRefused { refusal: refusal } =>
      OccurrenceCandidateIndexTransportRefused { refusal: refusal }
    OccurrenceTransportValidated { transport: validated } =>
      let module_path_build = module_by_occurrence_build(rows: inputs.module_paths)
      let exposure_build = exposure_by_occurrence_build(rows: inputs.exposure_rows)
      let order_build = authored_order_by_occurrence_build(rows: inputs.authored_order_rows)
      match module_path_build.refusal {
        Present { value: refusal } =>
          OccurrenceCandidateIndexModulePathRefused { refusal: refusal }
        Absent =>
          match exposure_build.refusal {
            Present { value: refusal } =>
              OccurrenceCandidateIndexExposureRefused { refusal: refusal }
            Absent =>
              match order_build.refusal {
                Present { value: refusal } =>
                  OccurrenceCandidateIndexAuthoredOrderRefused { refusal: refusal }
                Absent =>
                  match module_paths_validate_transport(
                    transport: validated,
                    module_by_occurrence: module_path_build.module_by_occurrence,
                    exposure_by_occurrence: exposure_build.exposure_by_occurrence,
                  ) {
                    Present { value: refusal } =>
                      OccurrenceCandidateIndexModulePathRefused { refusal: refusal }
                    Absent =>
                      match exposure_validate_transport_declarations(
                        declarations: validated.declarations,
                        exposure_by_occurrence: exposure_build.exposure_by_occurrence,
                      ) {
                        Present { value: refusal } =>
                          OccurrenceCandidateIndexExposureRefused { refusal: refusal }
                        Absent =>
                          match authored_order_validate_transport(
                            transport: validated,
                            order_by_occurrence: order_build.order_by_occurrence,
                          ) {
                            Present { value: refusal } =>
                              OccurrenceCandidateIndexAuthoredOrderRefused { refusal: refusal }
                            Absent =>
                              match declarations_by_name_build(
                                entries_by_id: validated.entries_by_id,
                                declarations: validated.declarations,
                              ) {
                                DeclarationsByNameMissingIndexEntry {
                                  occurrence: occurrence,
                                } =>
                                  OccurrenceCandidateIndexDeclarationBucketRefused {
                                    occurrence: occurrence,
                                  }
                                DeclarationsByNameReady { by_name: by_name } =>
                                  OccurrenceCandidateIndexReady {
                                    index: OccurrenceCandidateIndex {
                                      entries_by_id: validated.entries_by_id,
                                      declarations_by_name: by_name,
                                      module_by_occurrence: module_path_build.module_by_occurrence,
                                      exposure_by_occurrence: exposure_build.exposure_by_occurrence,
                                      order_by_occurrence: order_build.order_by_occurrence,
                                    },
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }
}

data occurrence_candidate_cardinality_note: String = "candidate_occurrence_ids_for_reference produces a population, never a decision: zero, one, or many exposed declarations all pass through unchanged as a plain List<OccurrenceId>. Cardinality (0/1/many -> Unbound/Bound/Ambiguous) is decided exactly once, downstream, by std.occurrence_binding_resolve.resolve_reference_occurrence_binding's call into std.occurrence_binding.occurrence_binding_from_candidates -- never here, and never by deduping same-spelled candidates: two structurally exposed declarations with equal text are two distinct OccurrenceIds and both are supplied (namespace-unique-on-chain-operational-plan.md 2 rule 5)."

fn candidate_occurrence_ids_for_reference(
  index: OccurrenceCandidateIndex,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> List<std.occurrence_identity.OccurrenceId> {
  match map_get(index.entries_by_id, reference.occurrence.value) {
    Absent => []
    Present { value: entry } =>
      match map_get(index.declarations_by_name, entry.projection.authored_name) {
        Absent => []
        Present { value: same_spelling } =>
          reverse(same_spelling)
            |> filter(declaration => declaration_exposed_on_reference_chain(
              declaration: declaration,
              reference: reference,
              module_by_occurrence: index.module_by_occurrence,
              exposure_by_occurrence: index.exposure_by_occurrence,
              order_by_occurrence: index.order_by_occurrence,
            ))
            |> map(declaration => declaration.occurrence)
      }
  }
}

data bound_reference_provider_note: String = "BoundReferenceProvider is the post-bind projection of one accepted OccurrenceBound decision: which reference resolved to which declaration, and which module each side's authored text belongs to. It is produced only from OccurrenceBound (never Unbound or Ambiguous) and only when both occurrences carry an OccurrenceModulePathRow -- a missing module row is a typed, located ReferenceBindingProjectionModulePathMissing refusal, never a silently-omitted edge. Same-module ruling (operator on PR 7515 / slice A): a BoundReferenceProvider whose consumer_module equals provider_module is retained as a binding receipt; the DirectModuleDependency projection emits NO M→M self-edge from it."

type BoundReferenceProvider {
  reference_occurrence: std.occurrence_identity.OccurrenceId
  declaration_occurrence: std.occurrence_identity.OccurrenceId
  consumer_module: std.types.NonEmptyStr
  provider_module: std.types.NonEmptyStr
}

data direct_module_dependency_note: String = "DirectModuleDependency is a projection of accepted bindings, never a second authored dependency statement (namespace-resolution-design.md 7.2 / roadmap recut 7517): it dedupes BoundReferenceProvider down to the distinct (consumer_module, provider_module) pairs the bindings require — the reference-derived successor to an authored import list. Same-module ruling (carrier law): same-module BoundReferenceProvider rows are preserved; this projection emits NO DirectModuleDependency self-edge (consumer_module == provider_module is skipped in direct_module_dependency_dedup_step — M→M is not a dependency and invites self-cycles). Dedup happens ONLY at this module-edge projection via a typed two-level index (Map consumer_module → Set provider_module; membership is map_get + set_contains, never a NUL-concatenated string key), with first-seen edges accumulated in provider-traversal order (prepend during fold, single reverse at end — never map_values hash-order readback). Output order is first occurrence of each cross-module edge in the input provider list. direct_module_dependencies_from_bound_population refuses unless BoundReferencePopulation is AllReferencesBound — a refused population never becomes an empty edge list."

type DirectModuleDependency {
  consumer_module: std.types.NonEmptyStr
  provider_module: std.types.NonEmptyStr
}

fn direct_module_dependency_from_provider(
  provider: BoundReferenceProvider
) -> DirectModuleDependency {
  DirectModuleDependency {
    consumer_module: provider.consumer_module,
    provider_module: provider.provider_module,
  }
}

type DirectModuleDependencyDedupBuild {
  providers_by_consumer: Map<std.types.NonEmptyStr, Set<String>>
  edges_first_seen: List<DirectModuleDependency>
}

fn direct_module_dependency_dedup_step(
  acc: DirectModuleDependencyDedupBuild,
  provider: BoundReferenceProvider
) -> DirectModuleDependencyDedupBuild {
  let edge = direct_module_dependency_from_provider(provider: provider)
  if edge.consumer_module == edge.provider_module {
    acc
  } else {
    match map_get(acc.providers_by_consumer, edge.consumer_module) {
      Absent =>
        DirectModuleDependencyDedupBuild {
          providers_by_consumer: map_insert(
            acc.providers_by_consumer,
            edge.consumer_module,
            set_insert(empty_set(), edge.provider_module as String),
          ),
          edges_first_seen: concat([edge], acc.edges_first_seen),
        }
      Present { value: existing_providers } =>
        if set_contains(existing_providers, edge.provider_module as String) {
          acc
        } else {
          DirectModuleDependencyDedupBuild {
            providers_by_consumer: map_insert(
              acc.providers_by_consumer,
              edge.consumer_module,
              set_insert(existing_providers, edge.provider_module as String),
            ),
            edges_first_seen: concat([edge], acc.edges_first_seen),
          }
        }
    }
  }
}

fn direct_module_dependencies_from_providers(
  providers: List<BoundReferenceProvider>
) -> List<DirectModuleDependency> {
  reverse(
    fold(
      providers,
      init: DirectModuleDependencyDedupBuild {
        providers_by_consumer: empty_map(),
        edges_first_seen: [],
      },
      f: (acc, provider) => direct_module_dependency_dedup_step(acc: acc, provider: provider),
    ).edges_first_seen,
  )
}

type BoundReferencePopulation
  = AllReferencesBound { providers: List<BoundReferenceProvider> }
  | ReferencePopulationRefused {
      first_failure: ReferenceBindingProjection
      more_failures: List<ReferenceBindingProjection>
    }

data bound_reference_population_note: String = "BoundReferencePopulation is total over a required reference projection list: either every reference is ReferenceBindingProjectionBound (AllReferencesBound) or at least one failure is surfaced (ReferencePopulationRefused with a nonempty failure list). No direct module dependency graph may be derived from a partial success — callers must use bound_reference_population_from_projections and refuse on ReferencePopulationRefused rather than fabricating a partial provider list."

type BoundReferencePopulationBuild {
  providers_reversed: List<BoundReferenceProvider>
  first_failure: ReferenceBindingProjection?
  more_failures_reversed: List<ReferenceBindingProjection>
}

fn bound_reference_population_fold_step(
  acc: BoundReferencePopulationBuild,
  projection: ReferenceBindingProjection
) -> BoundReferencePopulationBuild {
  match projection {
    ReferenceBindingProjectionBound { provider: provider } =>
      BoundReferencePopulationBuild {
        providers_reversed: concat([provider], acc.providers_reversed),
        first_failure: acc.first_failure,
        more_failures_reversed: acc.more_failures_reversed,
      }
    ReferenceBindingProjectionUnbound { occurrence: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
    ReferenceBindingProjectionAmbiguous { occurrence: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
    ReferenceBindingProjectionTransportRefused { refusal: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
    ReferenceBindingProjectionModulePathRefused { refusal: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
    ReferenceBindingProjectionExposureRefused { refusal: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
    ReferenceBindingProjectionAuthoredOrderRefused { refusal: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
    ReferenceBindingProjectionDeclarationBucketRefused { occurrence: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
    ReferenceBindingProjectionModulePathMissing { occurrence: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
    ReferenceBindingProjectionWrongCategory { occurrence: _, observed: _ } =>
      match acc.first_failure {
        Absent =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          BoundReferencePopulationBuild {
            providers_reversed: acc.providers_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
  }
}

fn bound_reference_population_from_projections(
  projections: List<ReferenceBindingProjection>
) -> BoundReferencePopulation {
  let build = fold(
    projections,
    init: BoundReferencePopulationBuild {
      providers_reversed: [],
      first_failure: none,
      more_failures_reversed: [],
    },
    f: (acc, projection) => bound_reference_population_fold_step(acc: acc, projection: projection),
  )
  match build.first_failure {
    Absent =>
      AllReferencesBound {
        providers: reverse(build.providers_reversed),
      }
    Present { value: first_failure } =>
      ReferencePopulationRefused {
        first_failure: first_failure,
        more_failures: reverse(build.more_failures_reversed),
      }
  }
}

type DirectModuleDependencyBuild
  = DirectModuleDependencyListReady { edges: List<DirectModuleDependency> }
  | DirectModuleDependencyPopulationRefused {
      population: BoundReferencePopulation
    }

fn direct_module_dependencies_from_bound_population(
  population: BoundReferencePopulation
) -> DirectModuleDependencyBuild {
  match population {
    AllReferencesBound { providers: providers } =>
      DirectModuleDependencyListReady {
        edges: direct_module_dependencies_from_providers(providers: providers),
      }
    ReferencePopulationRefused { first_failure: _, more_failures: _ } =>
      DirectModuleDependencyPopulationRefused {
        population: population,
      }
  }
}

data module_path_file_row_note: String = "ModulePathFileRow is the parser-embedded storage-realization join for cross-file binding provenance at the N3-B substrate seam: one symbolic module path maps to exactly one authored file path. Single authority for path⇄module binding is v2.compiler.source_authority.ModuleStorageBinding / ModuleStorageIndex (module_storage_binding_authority_note); this row is a scaffold projection of that fact from parser-walk inputs until B2 wires OrdinaryLoadedCompilationClosure through source_authority directly. Deliberately separate from OccurrenceModulePathRow (module membership only) and from import lists (transitional loading data). File projection refuses when either side of a bound reference lacks a row — never fabricates a path from module_to_filename heuristics at this seam. Duplicate identical rows are ModulePathFileDuplicateSame; conflicting paths for one module are ModulePathFileConflict — last-write-wins map_insert is forbidden."

data module_path_file_row_dissolution_note: String = "See module_path_file_row_dissolution_note_dissolve_on for the lifecycle condition this row's rationale accompanies."

data module_path_file_row_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "Dissolve-on: cross-file binding production consumes ModuleStorageBinding rows from v2.compiler.source_authority (module_storage_binding_module_dotted × module_storage_binding_file_path) on OrdinaryLoadedCompilationClosure; ModulePathFileRow, ModulePathFileIndex, and this note delete in the completing change. Until then parser-walk supplies rows with ParsedFromSource provenance only.")

type ModulePathFileRow {
  module_path: std.types.NonEmptyStr
  file_path: std.types.FilePath
}

type ModulePathFileIndexRefusal
  = ModulePathFileDuplicateSame { module_path: std.types.NonEmptyStr, file_path: std.types.FilePath }
  | ModulePathFileConflict {
      module_path: std.types.NonEmptyStr,
      first_file: std.types.FilePath,
      second_file: std.types.FilePath,
    }

type ModulePathFileIndexBuild {
  entries: Map<String, std.types.FilePath>
  refusal: ModulePathFileIndexRefusal?
}

type ModulePathFileIndex
  = ModulePathFileIndexReady { entries: Map<String, std.types.FilePath> }
  | ModulePathFileIndexRefused { refusal: ModulePathFileIndexRefusal }

fn module_path_file_index_fold_step(
  build: ModulePathFileIndexBuild,
  row: ModulePathFileRow
) -> ModulePathFileIndexBuild {
  match build.refusal {
    Present { value: _ } => build
    Absent =>
      let key = row.module_path as String
      match map_get(build.entries, key) {
        Absent =>
          ModulePathFileIndexBuild {
            entries: map_insert(build.entries, key, row.file_path),
            refusal: none,
          }
        Present { value: existing } =>
          if (existing as String) == (row.file_path as String) {
            ModulePathFileIndexBuild {
              entries: build.entries,
              refusal: Present {
                value: ModulePathFileDuplicateSame {
                  module_path: row.module_path,
                  file_path: row.file_path,
                },
              },
            }
          } else {
            ModulePathFileIndexBuild {
              entries: build.entries,
              refusal: Present {
                value: ModulePathFileConflict {
                  module_path: row.module_path,
                  first_file: existing,
                  second_file: row.file_path,
                },
              },
            }
          }
      }
  }
}

fn module_path_file_index_from_rows(rows: List<ModulePathFileRow>) -> ModulePathFileIndex {
  let build = fold(
    rows,
    init: ModulePathFileIndexBuild {
      entries: empty_map(),
      refusal: none,
    },
    f: (acc, row) => module_path_file_index_fold_step(build: acc, row: row),
  )
  match build.refusal {
    Present { value: refusal } =>
      ModulePathFileIndexRefused { refusal: refusal }
    Absent =>
      ModulePathFileIndexReady { entries: build.entries }
  }
}

data structural_binding_walk_refusal_note: String = "StructuralBindingWalkRefused wraps the exact index-build refusal payload (transport / module-path / exposure / authored-order / declaration-bucket). Coarse unit variants that discard nested refusal evidence are forbidden (operator blocker 6 / review on PR 7515). Single authority (std.occurrence_binding_candidates): the parser-walk local copy of this type/refusal/fn is deleted, and every consumer imports this one."

type StructuralBindingIndexRefusal
  = StructuralBindingTransportRefusal {
      refusal: std.occurrence_identity.OccurrenceTransportRefusal,
    }
  | StructuralBindingModulePathRefusal {
      refusal: OccurrenceModulePathIndexRefusal,
    }
  | StructuralBindingExposureRefusal {
      refusal: DeclarationExposureIndexRefusal,
    }
  | StructuralBindingAuthoredOrderRefusal {
      refusal: AuthoredOrderIndexRefusal,
    }
  | StructuralBindingDeclarationBucketRefusal {
      occurrence: std.occurrence_identity.OccurrenceId,
    }

type StructuralBindingWalk
  = StructuralBindingWalkReady { population: BoundReferencePopulation }
  | StructuralBindingWalkRefused { refusal: StructuralBindingIndexRefusal }

data cross_file_binding_provenance_note: String = "CrossFileBindingProvenance is the file-grain post-bind receipt parallel to BoundReferenceProvider: which reference resolved to which declaration, and which storage file each side's authored text belongs to. It is produced only from OccurrenceBound providers after joining consumer_module and provider_module through ModulePathFileRow — a missing row is ReferenceBindingProjectionFilePathMissing, never a silent omission. Same-file ruling (carrier law, parallel to DirectModuleDependency): consumer_file == provider_file rows are retained as binding receipts; the file-dependency projection emits NO self-edge from them."

type CrossFileBindingProvenance {
  reference_occurrence: std.occurrence_identity.OccurrenceId
  declaration_occurrence: std.occurrence_identity.OccurrenceId
  consumer_file: std.types.FilePath
  provider_file: std.types.FilePath
}

fn file_for_module_path(
  module_files: Map<String, std.types.FilePath>,
  module_path: std.types.NonEmptyStr
) -> std.types.FilePath? {
  map_get(module_files, module_path as String)
}

fn cross_file_binding_provenance_from_provider(
  provider: BoundReferenceProvider,
  module_files: Map<String, std.types.FilePath>
) -> CrossFileBindingProvenanceProjection {
  match file_for_module_path(module_files: module_files, module_path: provider.consumer_module) {
    Absent =>
      CrossFileBindingProvenanceProjectionFilePathMissing {
        module_path: provider.consumer_module,
      }
    Present { value: consumer_file } =>
      match file_for_module_path(module_files: module_files, module_path: provider.provider_module) {
        Absent =>
          CrossFileBindingProvenanceProjectionFilePathMissing {
            module_path: provider.provider_module,
          }
        Present { value: provider_file } =>
          CrossFileBindingProvenanceProjectionBound {
            provenance: CrossFileBindingProvenance {
              reference_occurrence: provider.reference_occurrence,
              declaration_occurrence: provider.declaration_occurrence,
              consumer_file: consumer_file,
              provider_file: provider_file,
            },
          }
      }
  }
}

type CrossFileBindingProvenanceProjection
  = CrossFileBindingProvenanceProjectionBound { provenance: CrossFileBindingProvenance }
  | CrossFileBindingProvenanceProjectionFilePathMissing { module_path: std.types.NonEmptyStr }

type CrossFileBindingProvenancePopulation
  = AllCrossFileBindingsBound { provenances: List<CrossFileBindingProvenance> }
  | CrossFileBindingPopulationBindingRefused { population: BoundReferencePopulation }
  | CrossFileBindingPopulationRefused {
      first_failure: CrossFileBindingProvenanceProjection
      more_failures: List<CrossFileBindingProvenanceProjection>
    }

type CrossFileBindingProvenanceBuild {
  module_files: Map<String, std.types.FilePath>
  provenances_reversed: List<CrossFileBindingProvenance>
  first_failure: CrossFileBindingProvenanceProjection?
  more_failures_reversed: List<CrossFileBindingProvenanceProjection>
}

fn cross_file_binding_provenance_fold_step(
  acc: CrossFileBindingProvenanceBuild,
  provider: BoundReferenceProvider
) -> CrossFileBindingProvenanceBuild {
  let projection = cross_file_binding_provenance_from_provider(provider: provider, module_files: acc.module_files)
  match projection {
    CrossFileBindingProvenanceProjectionBound { provenance: provenance } =>
      CrossFileBindingProvenanceBuild {
        module_files: acc.module_files,
        provenances_reversed: concat([provenance], acc.provenances_reversed),
        first_failure: acc.first_failure,
        more_failures_reversed: acc.more_failures_reversed,
      }
    CrossFileBindingProvenanceProjectionFilePathMissing { module_path: _ } =>
      match acc.first_failure {
        Absent =>
          CrossFileBindingProvenanceBuild {
            module_files: acc.module_files,
            provenances_reversed: acc.provenances_reversed,
            first_failure: Present { value: projection },
            more_failures_reversed: acc.more_failures_reversed,
          }
        Present { value: _ } =>
          CrossFileBindingProvenanceBuild {
            module_files: acc.module_files,
            provenances_reversed: acc.provenances_reversed,
            first_failure: acc.first_failure,
            more_failures_reversed: concat([projection], acc.more_failures_reversed),
          }
      }
  }
}

fn cross_file_binding_provenance_from_bound_population(
  population: BoundReferencePopulation,
  module_files: Map<String, std.types.FilePath>
) -> CrossFileBindingProvenancePopulation {
  match population {
    ReferencePopulationRefused { first_failure: _, more_failures: _ } =>
      CrossFileBindingPopulationBindingRefused { population: population }
    AllReferencesBound { providers: providers } =>
      let build = fold(
        providers,
        init: CrossFileBindingProvenanceBuild {
          module_files: module_files,
          provenances_reversed: [],
          first_failure: none,
          more_failures_reversed: [],
        },
        f: (acc, provider) => cross_file_binding_provenance_fold_step(acc: acc, provider: provider),
      )
      match build.first_failure {
        Absent =>
          AllCrossFileBindingsBound {
            provenances: reverse(build.provenances_reversed),
          }
        Present { value: first_failure } =>
          CrossFileBindingPopulationRefused {
            first_failure: first_failure,
            more_failures: reverse(build.more_failures_reversed),
          }
      }
  }
}

data direct_file_dependency_note: String = "DirectFileDependency is the file-grain projection of accepted cross-file bindings (namespace-reference-derived-closure clause e / P2aReferenceDependencyProjection7515): it dedupes CrossFileBindingProvenance down to distinct (consumer_file, provider_file) pairs required by the bindings — the reference-derived successor to import-list loading edges at storage grain. Same-file ruling: consumer_file == provider_file rows are preserved in the provenance population; this projection emits NO self-edge. Dedup happens ONLY here via a two-level index (Map consumer_file → Set provider_file), with first-seen provider files accumulated in provider-traversal order (prepend during fold, single reverse at end)."

type DirectFileDependency {
  consumer_file: std.types.FilePath
  provider_file: std.types.FilePath
}

type DirectFileDependencyDedupBuild {
  providers_by_consumer: Map<std.types.FilePath, Set<String>>
  edges_first_seen: List<DirectFileDependency>
}

fn direct_file_dependency_from_provenance(
  provenance: CrossFileBindingProvenance
) -> DirectFileDependency {
  DirectFileDependency {
    consumer_file: provenance.consumer_file,
    provider_file: provenance.provider_file,
  }
}

fn direct_file_dependency_dedup_step(
  acc: DirectFileDependencyDedupBuild,
  provenance: CrossFileBindingProvenance
) -> DirectFileDependencyDedupBuild {
  let edge = direct_file_dependency_from_provenance(provenance: provenance)
  if edge.consumer_file == edge.provider_file {
    acc
  } else {
    match map_get(acc.providers_by_consumer, edge.consumer_file) {
      Absent =>
        DirectFileDependencyDedupBuild {
          providers_by_consumer: map_insert(
            acc.providers_by_consumer,
            edge.consumer_file,
            set_insert(empty_set(), edge.provider_file as String),
          ),
          edges_first_seen: concat([edge], acc.edges_first_seen),
        }
      Present { value: existing_providers } =>
        if set_contains(existing_providers, edge.provider_file as String) {
          acc
        } else {
          DirectFileDependencyDedupBuild {
            providers_by_consumer: map_insert(
              acc.providers_by_consumer,
              edge.consumer_file,
              set_insert(existing_providers, edge.provider_file as String),
            ),
            edges_first_seen: concat([edge], acc.edges_first_seen),
          }
        }
    }
  }
}

fn provider_files_for_consumer_file(
  provenances: List<CrossFileBindingProvenance>,
  consumer_file: std.types.FilePath
) -> List<std.types.FilePath> {
  reverse(
    fold(
      provenances,
      init: DirectFileDependencyDedupBuild {
        providers_by_consumer: empty_map(),
        edges_first_seen: [],
      },
      f: (acc, provenance) =>
        match provenance.consumer_file == consumer_file {
          true => direct_file_dependency_dedup_step(acc: acc, provenance: provenance)
          false => acc
        },
    ).edges_first_seen,
  )
    |> map(edge => edge.provider_file)
}

fn direct_file_dependencies_from_provenances(
  provenances: List<CrossFileBindingProvenance>
) -> List<DirectFileDependency> {
  reverse(
    fold(
      provenances,
      init: DirectFileDependencyDedupBuild {
        providers_by_consumer: empty_map(),
        edges_first_seen: [],
      },
      f: (acc, provenance) => direct_file_dependency_dedup_step(acc: acc, provenance: provenance),
    ).edges_first_seen,
  )
}

type DirectFileDependencyBuild
  = DirectFileDependencyListReady { dependencies: List<DirectFileDependency> }
  | DirectFileDependencyPopulationRefused {
      population: CrossFileBindingProvenancePopulation
    }

fn direct_file_dependencies_from_cross_file_population(
  population: CrossFileBindingProvenancePopulation
) -> DirectFileDependencyBuild {
  match population {
    AllCrossFileBindingsBound { provenances: provenances } =>
      DirectFileDependencyListReady {
        dependencies: direct_file_dependencies_from_provenances(provenances: provenances),
      }
    CrossFileBindingPopulationBindingRefused { population: _ } =>
      DirectFileDependencyPopulationRefused {
        population: population,
      }
    CrossFileBindingPopulationRefused { first_failure: _, more_failures: _ } =>
      DirectFileDependencyPopulationRefused {
        population: population,
      }
  }
}

fn reference_derived_provider_files_for_consumer(
  population: BoundReferencePopulation,
  module_files: Map<String, std.types.FilePath>,
  consumer_file: std.types.FilePath
) -> ReferenceDerivedProviderFileProjection {
  match cross_file_binding_provenance_from_bound_population(
    population: population,
    module_files: module_files,
  ) {
    AllCrossFileBindingsBound { provenances: provenances } =>
      ReferenceDerivedProviderFileProjectionReady {
        provider_files: provider_files_for_consumer_file(
          provenances: provenances,
          consumer_file: consumer_file,
        ),
      }
    CrossFileBindingPopulationBindingRefused { population: _ } =>
      ReferenceDerivedProviderFileProjectionBindingRefused { population: population }
    CrossFileBindingPopulationRefused { first_failure: first_failure, more_failures: more_failures } =>
      ReferenceDerivedProviderFileProjectionFileRefused {
        first_failure: first_failure,
        more_failures: more_failures,
      }
  }
}

type ReferenceDerivedProviderFileProjection
  = ReferenceDerivedProviderFileProjectionReady { provider_files: List<std.types.FilePath> }
  | ReferenceDerivedProviderFileProjectionBindingRefused { population: BoundReferencePopulation }
  | ReferenceDerivedProviderFileProjectionFileRefused {
      first_failure: CrossFileBindingProvenanceProjection
      more_failures: List<CrossFileBindingProvenanceProjection>
    }

data reference_derived_dependency_projection_note: String = "ReferenceDerivedDependencyProjection is the clause-(e) seam exposing BOTH products required by namespace-reference-derived-closure and its N3-C successor: (1) binding_provenance — one CrossFileBindingProvenance per accepted reference, occurrence grain, NO collapse; (2) file_dependencies — distinct (consumer_file, provider_file) edges with repeated-mention collapse ONLY here. bound_population is carried intact for pool-perturbation differential (N3-C): a pool coincidence can reselect the target declaration while leaving the target-file set unchanged, so file_dependencies alone is insufficient."

type ReferenceDerivedDependencyProjection
  = ReferenceDerivedDependencyProjectionReady {
      binding_provenance: List<CrossFileBindingProvenance>,
      file_dependencies: List<DirectFileDependency>,
      bound_population: BoundReferencePopulation,
    }
  | ReferenceDerivedDependencyProjectionBindingRefused { population: BoundReferencePopulation }
  | ReferenceDerivedDependencyProjectionFileRefused {
      first_failure: CrossFileBindingProvenanceProjection
      more_failures: List<CrossFileBindingProvenanceProjection>
    }

fn reference_derived_dependency_projection(
  population: BoundReferencePopulation,
  module_files: Map<String, std.types.FilePath>
) -> ReferenceDerivedDependencyProjection {
  match cross_file_binding_provenance_from_bound_population(
    population: population,
    module_files: module_files,
  ) {
    AllCrossFileBindingsBound { provenances: provenances } =>
      ReferenceDerivedDependencyProjectionReady {
        binding_provenance: provenances,
        file_dependencies: direct_file_dependencies_from_provenances(provenances: provenances),
        bound_population: population,
      }
    CrossFileBindingPopulationBindingRefused { population: refused_population } =>
      ReferenceDerivedDependencyProjectionBindingRefused { population: refused_population }
    CrossFileBindingPopulationRefused { first_failure: first_failure, more_failures: more_failures } =>
      ReferenceDerivedDependencyProjectionFileRefused {
        first_failure: first_failure,
        more_failures: more_failures,
      }
  }
}

data reference_derived_dependency_binding_reference_filter_note: String = "Clause-(e) structural walks bind only reference categories that occurrence_category_clause_e_dependency_inducing_verdict classifies as OccurrenceCategoryClauseEDependencyInducing. TypeOccurrence references are N2's resolve_type_reference_containment_binding lane — parser-produced return-type annotations must not refuse the whole population when Int is not module-declared. Parser witnesses that need per-name resolution already avoid whole-transport walks for this reason; production assembled-closure projection applies the same boundary here."

fn reference_derived_dependency_binding_references(
  references: List<std.occurrence_identity.ReferenceOccurrence>
) -> List<std.occurrence_identity.ReferenceOccurrence> {
  let build = fold(
    references,
    init: ReferenceDerivedDependencyBindingReferenceBuild { references_reversed: [] },
    f: (acc, reference) =>
      match occurrence_category_clause_e_dependency_inducing_verdict(
        category: reference.category,
      ) {
        OccurrenceCategoryClauseEDependencyInducing =>
          ReferenceDerivedDependencyBindingReferenceBuild {
            references_reversed: concat([reference], acc.references_reversed),
          }
        OccurrenceCategoryClauseEDependencyNotInducing { category: _ } => acc
      },
  )
  reverse(build.references_reversed)
}

type ReferenceDerivedDependencyBindingReferenceBuild {
  references_reversed: List<std.occurrence_identity.ReferenceOccurrence>
}

fn structural_binding_walk_selected_references(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
  references: List<std.occurrence_identity.ReferenceOccurrence>
) -> StructuralBindingWalk {
  match occurrence_candidate_index_build(transport: transport, inputs: inputs) {
    OccurrenceCandidateIndexTransportRefused { refusal: refusal } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingTransportRefusal { refusal: refusal },
      }
    OccurrenceCandidateIndexModulePathRefused { refusal: refusal } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingModulePathRefusal { refusal: refusal },
      }
    OccurrenceCandidateIndexExposureRefused { refusal: refusal } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingExposureRefusal { refusal: refusal },
      }
    OccurrenceCandidateIndexAuthoredOrderRefused { refusal: refusal } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingAuthoredOrderRefusal { refusal: refusal },
      }
    OccurrenceCandidateIndexDeclarationBucketRefused { occurrence: occurrence } =>
      StructuralBindingWalkRefused {
        refusal: StructuralBindingDeclarationBucketRefusal {
          occurrence: occurrence,
        },
      }
    OccurrenceCandidateIndexReady { index: index } =>
      StructuralBindingWalkReady {
        population: bound_reference_population_from_projections(
          projections: resolve_all_references_via_structural_candidates(
            transport: transport,
            index: index,
            references: references,
          ),
        ),
      }
  }
}

fn structural_binding_walk(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs
) -> StructuralBindingWalk {
  structural_binding_walk_selected_references(
    transport: transport,
    inputs: inputs,
    references: transport.references,
  )
}

data cross_file_binding_closure_assembly_note: String = "Collision-free cross-file assembly substrate (N3-B0): two independently parsed transports each mint raw OccurrenceId values from their own zero-based allocator, so a naive merge collides. occurrence_id_remap_state_with_fresh_map gives each transport its own old-ID => closure-ID remap keyed by the RAW id.value (never reused across transports); remap_occurrence_id/remap_containment_path/rekey_occurrence_transport/rekey_occurrence_binding_inputs rekey index, declarations, references, module paths, exposure rows, and authored-order rows TOGETHER against that one remap map, so every row for one transport lands on the SAME closure identity for the same raw id. assemble_cross_file_binding_closure rekeys the consumer with a fresh allocator and a fresh remap map, then folds providers each with a FRESH remap map but the ALLOCATOR CARRIED FORWARD from the prior step -- this is the mechanism that makes two transports that both minted raw id 0 land on distinct closure ids. module_path_file_index_from_rows validates the accumulated module=>file rows fail-closed (ModulePathFileDuplicateSame vs ModulePathFileConflict), never last-write-wins."

type OccurrenceIdRemapState {
  allocator: std.occurrence_identity.OccurrenceIdAllocator
  remap: Map<Int, std.occurrence_identity.OccurrenceId>
}

fn occurrence_id_remap_state_with_fresh_map(
  allocator: std.occurrence_identity.OccurrenceIdAllocator
) -> OccurrenceIdRemapState {
  OccurrenceIdRemapState {
    allocator: allocator,
    remap: empty_map(),
  }
}

type OccurrenceIdRemapResult {
  id: std.occurrence_identity.OccurrenceId
  state: OccurrenceIdRemapState
}

fn remap_occurrence_id(
  id: std.occurrence_identity.OccurrenceId,
  state: OccurrenceIdRemapState
) -> OccurrenceIdRemapResult {
  match map_get(state.remap, id.value) {
    Present { value: remapped } =>
      OccurrenceIdRemapResult { id: remapped, state: state }
    Absent =>
      let allocated = alloc_occurrence_id(alloc: state.allocator)
      OccurrenceIdRemapResult {
        id: allocated.id,
        state: OccurrenceIdRemapState {
          allocator: allocated.alloc,
          remap: map_insert(state.remap, id.value, allocated.id),
        },
      }
  }
}

type OccurrenceContainmentRemapResult {
  path: std.occurrence_identity.OccurrenceContainmentPath
  state: OccurrenceIdRemapState
}

type OccurrenceAncestorRemapBuild {
  ancestors: FreeMonoid<std.occurrence_identity.OccurrenceId>
  state: OccurrenceIdRemapState
}

fn remap_containment_path(
  path: std.occurrence_identity.OccurrenceContainmentPath,
  state: OccurrenceIdRemapState
) -> OccurrenceContainmentRemapResult {
  let ancestors_build = fold(
    path.ancestors,
    init: OccurrenceAncestorRemapBuild {
      ancestors: std.algebra.Empty,
      state: state,
    },
    f: (acc, ancestor) => {
      let remapped = remap_occurrence_id(id: ancestor, state: acc.state)
      OccurrenceAncestorRemapBuild {
        ancestors: std.algebra.Cons { head: remapped.id, tail: acc.ancestors },
        state: remapped.state,
      }
    },
  )
  let terminal_remapped = remap_occurrence_id(
    id: path.terminal,
    state: ancestors_build.state,
  )
  OccurrenceContainmentRemapResult {
    path: std.occurrence_identity.OccurrenceContainmentPath {
      ancestors: reverse(ancestors_build.ancestors),
      terminal: terminal_remapped.id,
    },
    state: terminal_remapped.state,
  }
}

type OccurrenceTransportRekeyResult {
  transport: std.occurrence_identity.OccurrenceTransport
  state: OccurrenceIdRemapState
}

type OccurrenceIndexRekeyBuild {
  entries_reversed: List<std.occurrence_identity.OccurrenceIndexEntry>
  state: OccurrenceIdRemapState
}

type OccurrenceDeclarationRekeyBuild {
  declarations_reversed: List<std.occurrence_identity.DeclarationOccurrence>
  state: OccurrenceIdRemapState
}

type OccurrenceReferenceRekeyBuild {
  references_reversed: List<std.occurrence_identity.ReferenceOccurrence>
  state: OccurrenceIdRemapState
}

fn rekey_occurrence_transport(
  transport: std.occurrence_identity.OccurrenceTransport,
  state: OccurrenceIdRemapState
) -> OccurrenceTransportRekeyResult {
  let index_build = fold(
    transport.index.entries,
    init: OccurrenceIndexRekeyBuild { entries_reversed: [], state: state },
    f: (acc, entry) => {
      let remapped_occ = remap_occurrence_id(
        id: entry.projection.occurrence,
        state: acc.state,
      )
      let remapped_containment = remap_containment_path(
        path: entry.containment,
        state: remapped_occ.state,
      )
      OccurrenceIndexRekeyBuild {
        entries_reversed: concat([
          std.occurrence_identity.OccurrenceIndexEntry {
            projection: std.occurrence_identity.OccurrenceProjection {
              occurrence: remapped_occ.id,
              authored_name: entry.projection.authored_name,
              diagnostic_span: entry.projection.diagnostic_span,
            },
            containment: remapped_containment.path,
          },
        ], acc.entries_reversed),
        state: remapped_containment.state,
      }
    },
  )
  let declarations_build = fold(
    transport.declarations,
    init: OccurrenceDeclarationRekeyBuild {
      declarations_reversed: [],
      state: index_build.state,
    },
    f: (acc, declaration) => {
      let remapped_occ = remap_occurrence_id(
        id: declaration.occurrence,
        state: acc.state,
      )
      let remapped_containment = remap_containment_path(
        path: declaration.containment,
        state: remapped_occ.state,
      )
      OccurrenceDeclarationRekeyBuild {
        declarations_reversed: concat([
          std.occurrence_identity.DeclarationOccurrence {
            occurrence: remapped_occ.id,
            containment: remapped_containment.path,
            category: declaration.category,
            diagnostic_span: declaration.diagnostic_span,
          },
        ], acc.declarations_reversed),
        state: remapped_containment.state,
      }
    },
  )
  let references_build = fold(
    transport.references,
    init: OccurrenceReferenceRekeyBuild {
      references_reversed: [],
      state: declarations_build.state,
    },
    f: (acc, reference) => {
      let remapped_occ = remap_occurrence_id(
        id: reference.occurrence,
        state: acc.state,
      )
      let remapped_containment = remap_containment_path(
        path: reference.containment,
        state: remapped_occ.state,
      )
      OccurrenceReferenceRekeyBuild {
        references_reversed: concat([
          std.occurrence_identity.ReferenceOccurrence {
            occurrence: remapped_occ.id,
            containment: remapped_containment.path,
            category: reference.category,
            diagnostic_span: reference.diagnostic_span,
          },
        ], acc.references_reversed),
        state: remapped_containment.state,
      }
    },
  )
  OccurrenceTransportRekeyResult {
    transport: std.occurrence_identity.OccurrenceTransport {
      index: std.occurrence_identity.OccurrenceIndex { entries: reverse(index_build.entries_reversed) },
      declarations: reverse(declarations_build.declarations_reversed),
      references: reverse(references_build.references_reversed),
    },
    state: references_build.state,
  }
}

type OccurrenceBindingInputsRekeyResult {
  inputs: OccurrenceBindingCandidateInputs
  state: OccurrenceIdRemapState
}

type OccurrenceModulePathRekeyBuild {
  rows_reversed: List<OccurrenceModulePathRow>
  state: OccurrenceIdRemapState
}

type OccurrenceExposureRekeyBuild {
  rows_reversed: List<DeclarationExposureRow>
  state: OccurrenceIdRemapState
}

type OccurrenceOrderRekeyBuild {
  rows_reversed: List<AuthoredOrderRow>
  state: OccurrenceIdRemapState
}

fn rekey_occurrence_binding_inputs(
  inputs: OccurrenceBindingCandidateInputs,
  state: OccurrenceIdRemapState
) -> OccurrenceBindingInputsRekeyResult {
  let module_paths_build = fold(
    inputs.module_paths,
    init: OccurrenceModulePathRekeyBuild { rows_reversed: [], state: state },
    f: (acc, row) => {
      let remapped_occ = remap_occurrence_id(id: row.occurrence, state: acc.state)
      OccurrenceModulePathRekeyBuild {
        rows_reversed: concat([
          OccurrenceModulePathRow {
            occurrence: remapped_occ.id,
            module_path: row.module_path,
          },
        ], acc.rows_reversed),
        state: remapped_occ.state,
      }
    },
  )
  let exposure_rows_build = fold(
    inputs.exposure_rows,
    init: OccurrenceExposureRekeyBuild {
      rows_reversed: [],
      state: module_paths_build.state,
    },
    f: (acc, row) => {
      let remapped_occ = remap_occurrence_id(id: row.occurrence, state: acc.state)
      match row.exposure {
        LexicalExposure { exposing_scope: exposing_scope } => {
          let remapped_scope = remap_containment_path(
            path: exposing_scope,
            state: remapped_occ.state,
          )
          OccurrenceExposureRekeyBuild {
            rows_reversed: concat([
              DeclarationExposureRow {
                occurrence: remapped_occ.id,
                exposure: LexicalExposure { exposing_scope: remapped_scope.path },
              },
            ], acc.rows_reversed),
            state: remapped_scope.state,
          }
        }
        ModuleExposure { module: module } =>
          OccurrenceExposureRekeyBuild {
            rows_reversed: concat([
              DeclarationExposureRow {
                occurrence: remapped_occ.id,
                exposure: ModuleExposure { module: module },
              },
            ], acc.rows_reversed),
            state: remapped_occ.state,
          }
        RootExposure =>
          OccurrenceExposureRekeyBuild {
            rows_reversed: concat([
              DeclarationExposureRow {
                occurrence: remapped_occ.id,
                exposure: RootExposure,
              },
            ], acc.rows_reversed),
            state: remapped_occ.state,
          }
      }
    },
  )
  let order_rows_build = fold(
    inputs.authored_order_rows,
    init: OccurrenceOrderRekeyBuild {
      rows_reversed: [],
      state: exposure_rows_build.state,
    },
    f: (acc, row) => {
      let remapped_occ = remap_occurrence_id(id: row.occurrence, state: acc.state)
      OccurrenceOrderRekeyBuild {
        rows_reversed: concat([
          AuthoredOrderRow {
            occurrence: remapped_occ.id,
            ordinal: row.ordinal,
          },
        ], acc.rows_reversed),
        state: remapped_occ.state,
      }
    },
  )
  OccurrenceBindingInputsRekeyResult {
    inputs: OccurrenceBindingCandidateInputs {
      module_paths: reverse(module_paths_build.rows_reversed),
      exposure_rows: reverse(exposure_rows_build.rows_reversed),
      authored_order_rows: reverse(order_rows_build.rows_reversed),
    },
    state: order_rows_build.state,
  }
}

fn merge_occurrence_transports(
  left: std.occurrence_identity.OccurrenceTransport,
  right: std.occurrence_identity.OccurrenceTransport
) -> std.occurrence_identity.OccurrenceTransport {
  std.occurrence_identity.OccurrenceTransport {
    index: std.occurrence_identity.OccurrenceIndex {
      entries: concat(left.index.entries, right.index.entries),
    },
    declarations: concat(left.declarations, right.declarations),
    references: concat(left.references, right.references),
  }
}

fn cross_file_binding_closure_row(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
  module_path: std.types.NonEmptyStr,
  file_path: std.types.FilePath
) -> CrossFileBindingClosureRow {
  CrossFileBindingClosureRow {
    transport: transport,
    inputs: inputs,
    module_path: module_path,
    file_path: file_path,
  }
}

type CrossFileBindingClosureRow {
  transport: std.occurrence_identity.OccurrenceTransport
  inputs: OccurrenceBindingCandidateInputs
  module_path: std.types.NonEmptyStr
  file_path: std.types.FilePath
}

type AssembledCrossFileBindingClosureRefusal
  = AssembledCrossFileBindingClosureModulePathFileRefused {
      refusal: ModulePathFileIndexRefusal,
    }

type AssembledCrossFileBindingClosure
  = AssembledCrossFileBindingClosureReady {
      transport: std.occurrence_identity.OccurrenceTransport,
      inputs: OccurrenceBindingCandidateInputs,
      module_files: List<ModulePathFileRow>,
      consumer_file: std.types.FilePath,
    }
  | AssembledCrossFileBindingClosureRefused {
      refusal: AssembledCrossFileBindingClosureRefusal,
    }

type AssembledCrossFileFold {
  entries_reversed: List<std.occurrence_identity.OccurrenceIndexEntry>
  declarations_reversed: List<std.occurrence_identity.DeclarationOccurrence>
  references_reversed: List<std.occurrence_identity.ReferenceOccurrence>
  module_paths_reversed: List<OccurrenceModulePathRow>
  exposure_rows_reversed: List<DeclarationExposureRow>
  order_rows_reversed: List<AuthoredOrderRow>
  module_files_reversed: List<ModulePathFileRow>
  remap_state: OccurrenceIdRemapState
}

data assemble_cross_file_binding_closure_cost_note: String = "The provider fold accumulates each provider's rekeyed rows by PREPENDING onto seven `_reversed` populations (index entries, declarations, references, module paths, exposure rows, authored-order rows, module=>file rows) rather than by re-concatenating the whole left-hand assembled graph onto each small provider chunk -- that pairwise-append shape cost O(total assembled rows) per provider (O(n^2) over all providers) because concat's cost is proportional to its first argument's length. Prepending a provider's own (small, per-file-bounded) chunk onto the accumulator costs O(that provider's row count) regardless of how much has already been assembled, so the fold is linear in the total row count across all providers. Each `_reversed` population is reversed exactly once, at the end, never per provider."

fn assemble_cross_file_binding_closure(
  consumer: CrossFileBindingClosureRow,
  providers: List<CrossFileBindingClosureRow>
) -> AssembledCrossFileBindingClosure {
  let consumer_state = occurrence_id_remap_state_with_fresh_map(
    allocator: occurrence_id_allocator_initial(),
  )
  let consumer_transport_rekey = rekey_occurrence_transport(
    transport: consumer.transport,
    state: consumer_state,
  )
  let consumer_inputs_rekey = rekey_occurrence_binding_inputs(
    inputs: consumer.inputs,
    state: consumer_transport_rekey.state,
  )
  let seed = AssembledCrossFileFold {
    entries_reversed: reverse(consumer_transport_rekey.transport.index.entries),
    declarations_reversed: reverse(consumer_transport_rekey.transport.declarations),
    references_reversed: reverse(consumer_transport_rekey.transport.references),
    module_paths_reversed: reverse(consumer_inputs_rekey.inputs.module_paths),
    exposure_rows_reversed: reverse(consumer_inputs_rekey.inputs.exposure_rows),
    order_rows_reversed: reverse(consumer_inputs_rekey.inputs.authored_order_rows),
    module_files_reversed: [
      ModulePathFileRow {
        module_path: consumer.module_path,
        file_path: consumer.file_path,
      },
    ],
    remap_state: consumer_inputs_rekey.state,
  }
  let assembled = fold(
    providers,
    init: seed,
    f: (acc, provider) => {
      let provider_state = occurrence_id_remap_state_with_fresh_map(
        allocator: acc.remap_state.allocator,
      )
      let provider_transport_rekey = rekey_occurrence_transport(
        transport: provider.transport,
        state: provider_state,
      )
      let provider_inputs_rekey = rekey_occurrence_binding_inputs(
        inputs: provider.inputs,
        state: provider_transport_rekey.state,
      )
      AssembledCrossFileFold {
        entries_reversed: concat(
          reverse(provider_transport_rekey.transport.index.entries),
          acc.entries_reversed,
        ),
        declarations_reversed: concat(
          reverse(provider_transport_rekey.transport.declarations),
          acc.declarations_reversed,
        ),
        references_reversed: concat(
          reverse(provider_transport_rekey.transport.references),
          acc.references_reversed,
        ),
        module_paths_reversed: concat(
          reverse(provider_inputs_rekey.inputs.module_paths),
          acc.module_paths_reversed,
        ),
        exposure_rows_reversed: concat(
          reverse(provider_inputs_rekey.inputs.exposure_rows),
          acc.exposure_rows_reversed,
        ),
        order_rows_reversed: concat(
          reverse(provider_inputs_rekey.inputs.authored_order_rows),
          acc.order_rows_reversed,
        ),
        module_files_reversed: concat([
          ModulePathFileRow {
            module_path: provider.module_path,
            file_path: provider.file_path,
          },
        ], acc.module_files_reversed),
        remap_state: provider_inputs_rekey.state,
      }
    },
  )
  let assembled_module_files = reverse(assembled.module_files_reversed)
  match module_path_file_index_from_rows(rows: assembled_module_files) {
    ModulePathFileIndexRefused { refusal: refusal } =>
      AssembledCrossFileBindingClosureRefused {
        refusal: AssembledCrossFileBindingClosureModulePathFileRefused {
          refusal: refusal,
        },
      }
    ModulePathFileIndexReady { entries: _ } =>
      AssembledCrossFileBindingClosureReady {
        transport: std.occurrence_identity.OccurrenceTransport {
          index: std.occurrence_identity.OccurrenceIndex { entries: reverse(assembled.entries_reversed) },
          declarations: reverse(assembled.declarations_reversed),
          references: reverse(assembled.references_reversed),
        },
        inputs: OccurrenceBindingCandidateInputs {
          module_paths: reverse(assembled.module_paths_reversed),
          exposure_rows: reverse(assembled.exposure_rows_reversed),
          authored_order_rows: reverse(assembled.order_rows_reversed),
        },
        module_files: assembled_module_files,
        consumer_file: consumer.file_path,
      }
  }
}

type AssembledClosureDependencyProjectionRefusal
  = AssembledClosureDependencyProjectionStructuralRefused {
      refusal: StructuralBindingIndexRefusal,
    }
  | AssembledClosureDependencyProjectionModulePathFileRefused {
      refusal: ModulePathFileIndexRefusal,
    }
  | AssembledClosureDependencyProjectionBindingRefused {
      population: BoundReferencePopulation,
    }
  | AssembledClosureDependencyProjectionFileRefused {
      first_failure: CrossFileBindingProvenanceProjection,
      more_failures: List<CrossFileBindingProvenanceProjection>,
    }

type AssembledClosureDependencyProjection
  = AssembledClosureDependencyProjectionReady {
      projection: ReferenceDerivedDependencyProjection,
    }
  | AssembledClosureDependencyProjectionRefused {
      refusal: AssembledClosureDependencyProjectionRefusal,
    }

fn reference_derived_dependency_projection_for_assembled_closure(
  closure: AssembledCrossFileBindingClosure
) -> AssembledClosureDependencyProjection {
  match closure {
    AssembledCrossFileBindingClosureRefused { refusal: refusal } =>
      AssembledClosureDependencyProjectionRefused {
        refusal: AssembledClosureDependencyProjectionModulePathFileRefused {
          refusal: match refusal {
            AssembledCrossFileBindingClosureModulePathFileRefused { refusal: module_refusal } =>
              module_refusal
          },
        },
      }
    AssembledCrossFileBindingClosureReady {
      transport: transport,
      inputs: inputs,
      module_files: module_file_rows,
      consumer_file: _,
    } =>
      match module_path_file_index_from_rows(rows: module_file_rows) {
        ModulePathFileIndexRefused { refusal: refusal } =>
          AssembledClosureDependencyProjectionRefused {
            refusal: AssembledClosureDependencyProjectionModulePathFileRefused {
              refusal: refusal,
            },
          }
        ModulePathFileIndexReady { entries: module_files } =>
          match structural_binding_walk_selected_references(
            transport: transport,
            inputs: inputs,
            references: reference_derived_dependency_binding_references(
              references: transport.references,
            ),
          ) {
            StructuralBindingWalkReady { population: population } =>
              match reference_derived_dependency_projection(
                population: population,
                module_files: module_files,
              ) {
                ReferenceDerivedDependencyProjectionReady {
                  binding_provenance: binding_provenance,
                  file_dependencies: file_dependencies,
                  bound_population: bound_population,
                } =>
                  AssembledClosureDependencyProjectionReady {
                    projection: ReferenceDerivedDependencyProjectionReady {
                      binding_provenance: binding_provenance,
                      file_dependencies: file_dependencies,
                      bound_population: bound_population,
                    },
                  }
                ReferenceDerivedDependencyProjectionBindingRefused { population: refused_population } =>
                  AssembledClosureDependencyProjectionRefused {
                    refusal: AssembledClosureDependencyProjectionBindingRefused {
                      population: refused_population,
                    },
                  }
                ReferenceDerivedDependencyProjectionFileRefused {
                  first_failure: first_failure,
                  more_failures: more_failures,
                } =>
                  AssembledClosureDependencyProjectionRefused {
                    refusal: AssembledClosureDependencyProjectionFileRefused {
                      first_failure: first_failure,
                      more_failures: more_failures,
                    },
                  }
              }
            StructuralBindingWalkRefused { refusal: refusal } =>
              AssembledClosureDependencyProjectionRefused {
                refusal: AssembledClosureDependencyProjectionStructuralRefused {
                  refusal: refusal,
                },
              }
          }
      }
  }
}

type ReferenceDerivedProviderFilesForAssembledClosure
  = ReferenceDerivedProviderFilesForAssembledClosureReady { provider_files: List<std.types.FilePath> }
  | ReferenceDerivedProviderFilesForAssembledClosureRefused {
      refusal: AssembledClosureDependencyProjectionRefusal,
    }

fn reference_derived_provider_files_for_assembled_closure(
  closure: AssembledCrossFileBindingClosure
) -> ReferenceDerivedProviderFilesForAssembledClosure {
  match reference_derived_dependency_projection_for_assembled_closure(closure: closure) {
    AssembledClosureDependencyProjectionReady {
      projection: ReferenceDerivedDependencyProjectionReady {
        file_dependencies: dependencies,
        binding_provenance: _,
        bound_population: _,
      },
    } =>
      ReferenceDerivedProviderFilesForAssembledClosureReady {
        provider_files: dependencies |> map(edge => edge.provider_file),
      }
    AssembledClosureDependencyProjectionRefused { refusal: refusal } =>
      ReferenceDerivedProviderFilesForAssembledClosureRefused { refusal: refusal }
  }
}

type ReferenceDerivedClauseEProductionRefusal
  = ReferenceDerivedClauseEProductionProjectionRefused {
      refusal: AssembledClosureDependencyProjectionRefusal,
    }
  | ReferenceDerivedClauseEProductionAssemblyRefused {
      refusal: AssembledCrossFileBindingClosureRefusal,
    }
  | ReferenceDerivedClauseEProductionConsumerParseRefused {
      file: std.types.FilePath,
    }
  | ReferenceDerivedClauseEProductionProviderParseRefused {
      file: std.types.FilePath,
    }

type ReferenceDerivedClauseEProduction
  = ReferenceDerivedClauseEProductionReady {
      projection: ReferenceDerivedDependencyProjection,
      consumer_file: std.types.FilePath,
    }
  | ReferenceDerivedClauseEProductionRefused {
      refusal: ReferenceDerivedClauseEProductionRefusal,
    }

fn reference_derived_clause_e_production_from_assembled_closure(
  closure: AssembledCrossFileBindingClosure
) -> ReferenceDerivedClauseEProduction {
  match closure {
    AssembledCrossFileBindingClosureRefused { refusal: refusal } =>
      ReferenceDerivedClauseEProductionRefused {
        refusal: ReferenceDerivedClauseEProductionAssemblyRefused {
          refusal: refusal,
        },
      }
    AssembledCrossFileBindingClosureReady {
      transport: _,
      inputs: _,
      module_files: _,
      consumer_file: consumer_file,
    } =>
      match reference_derived_dependency_projection_for_assembled_closure(closure: closure) {
        AssembledClosureDependencyProjectionReady {
          projection: ReferenceDerivedDependencyProjectionReady {
            binding_provenance: provenances,
            file_dependencies: dependencies,
            bound_population: bound_population,
          },
        } =>
          ReferenceDerivedClauseEProductionReady {
            projection: ReferenceDerivedDependencyProjectionReady {
              binding_provenance: provenances,
              file_dependencies: dependencies,
              bound_population: bound_population,
            },
            consumer_file: consumer_file,
          }
        AssembledClosureDependencyProjectionRefused { refusal: refusal } =>
          ReferenceDerivedClauseEProductionRefused {
            refusal: ReferenceDerivedClauseEProductionProjectionRefused {
              refusal: refusal,
            },
          }
      }
  }
}

type ReferenceBindingProjection
  = ReferenceBindingProjectionBound { provider: BoundReferenceProvider }
  | ReferenceBindingProjectionUnbound { occurrence: std.occurrence_identity.OccurrenceId }
  | ReferenceBindingProjectionAmbiguous { occurrence: std.occurrence_identity.OccurrenceId }
  | ReferenceBindingProjectionTransportRefused { refusal: std.occurrence_identity.OccurrenceTransportRefusal }
  | ReferenceBindingProjectionModulePathRefused { refusal: OccurrenceModulePathIndexRefusal }
  | ReferenceBindingProjectionExposureRefused { refusal: DeclarationExposureIndexRefusal }
  | ReferenceBindingProjectionAuthoredOrderRefused { refusal: AuthoredOrderIndexRefusal }
  | ReferenceBindingProjectionDeclarationBucketRefused { occurrence: std.occurrence_identity.OccurrenceId }
  | ReferenceBindingProjectionModulePathMissing { occurrence: std.occurrence_identity.OccurrenceId }
  | ReferenceBindingProjectionWrongCategory {
      occurrence: std.occurrence_identity.OccurrenceId,
      observed: std.occurrence_identity.OccurrenceCategory,
    }

data resolve_type_reference_containment_binding_note: String = "N2 typed entry (gunbc.type_reference_containment_binding slice 1): refuses non-TypeOccurrence references at the API boundary before candidate enumeration — category is part of the binding contract, not an after-the-fact filter. TypeOccurrence references delegate to resolve_reference_binding_via_structural_candidates unchanged."

fn resolve_type_reference_containment_binding(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> ReferenceBindingProjection {
  match reference.category {
    TypeOccurrence =>
      resolve_reference_binding_via_structural_candidates(
        transport: transport,
        inputs: inputs,
        reference: reference,
      )
    _ =>
      ReferenceBindingProjectionWrongCategory {
        occurrence: reference.occurrence,
        observed: reference.category,
      }
  }
}

data resolve_reference_via_structural_candidates_note: String = "THE P2a entry point. It builds the exact candidate population for one reference from the precomputed index (candidate_occurrence_ids_for_reference) and hands that population to std.occurrence_binding_resolve.resolve_reference_occurrence_binding as supplied_candidates -- P1's fold over occurrence_binding_from_candidates is the only cardinality decision in this path. Only the OccurrenceBound arm is projected into a BoundReferenceProvider; Unbound and Ambiguous are surfaced as their own typed, located outcomes so a caller can never mistake 'no edge' for 'one edge'."

fn resolve_reference_via_structural_candidates(
  transport: std.occurrence_identity.OccurrenceTransport,
  index: OccurrenceCandidateIndex,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> ReferenceBindingProjection {
  let candidates = candidate_occurrence_ids_for_reference(
    index: index,
    reference: reference,
  )
  match resolve_reference_occurrence_binding(
    transport: transport,
    occurrence: reference.occurrence,
    supplied_candidates: candidates,
  ) {
    OccurrenceReferenceBindingTransportRefused { refusal: refusal } =>
      ReferenceBindingProjectionTransportRefused { refusal: refusal }
    OccurrenceReferenceBindingDecided { result: result } =>
      match result {
        OccurrenceUnbound { occurrence: _ } =>
          ReferenceBindingProjectionUnbound { occurrence: reference.occurrence }
        OccurrenceAmbiguous { occurrence: _, candidates: _ } =>
          ReferenceBindingProjectionAmbiguous { occurrence: reference.occurrence }
        OccurrenceBound { binding: binding } =>
          let declaration_occurrence = binding.candidate.containment.terminal
          match module_of_occurrence(
            module_by_occurrence: index.module_by_occurrence,
            occurrence: reference.occurrence,
          ) {
            Absent =>
              ReferenceBindingProjectionModulePathMissing {
                occurrence: reference.occurrence,
              }
            Present { value: consumer_module } =>
              match module_of_occurrence(
                module_by_occurrence: index.module_by_occurrence,
                occurrence: declaration_occurrence,
              ) {
                Absent =>
                  ReferenceBindingProjectionModulePathMissing {
                    occurrence: declaration_occurrence,
                  }
                Present { value: provider_module } =>
                  ReferenceBindingProjectionBound {
                    provider: BoundReferenceProvider {
                      reference_occurrence: reference.occurrence,
                      declaration_occurrence: declaration_occurrence,
                      consumer_module: consumer_module,
                      provider_module: provider_module,
                    },
                  }
              }
          }
      }
  }
}

fn resolve_reference_binding_via_structural_candidates(
  transport: std.occurrence_identity.OccurrenceTransport,
  inputs: OccurrenceBindingCandidateInputs,
  reference: std.occurrence_identity.ReferenceOccurrence
) -> ReferenceBindingProjection {
  match occurrence_candidate_index_build(transport: transport, inputs: inputs) {
    OccurrenceCandidateIndexTransportRefused { refusal: refusal } =>
      ReferenceBindingProjectionTransportRefused { refusal: refusal }
    OccurrenceCandidateIndexModulePathRefused { refusal: refusal } =>
      ReferenceBindingProjectionModulePathRefused { refusal: refusal }
    OccurrenceCandidateIndexExposureRefused { refusal: refusal } =>
      ReferenceBindingProjectionExposureRefused { refusal: refusal }
    OccurrenceCandidateIndexAuthoredOrderRefused { refusal: refusal } =>
      ReferenceBindingProjectionAuthoredOrderRefused { refusal: refusal }
    OccurrenceCandidateIndexDeclarationBucketRefused { occurrence: occurrence } =>
      ReferenceBindingProjectionDeclarationBucketRefused { occurrence: occurrence }
    OccurrenceCandidateIndexReady { index: index } =>
      resolve_reference_via_structural_candidates(
        transport: transport,
        index: index,
        reference: reference,
      )
  }
}

fn resolve_all_references_via_structural_candidates(
  transport: std.occurrence_identity.OccurrenceTransport,
  index: OccurrenceCandidateIndex,
  references: List<std.occurrence_identity.ReferenceOccurrence>
) -> List<ReferenceBindingProjection> {
  references |> map(reference => resolve_reference_via_structural_candidates(
    transport: transport,
    index: index,
    reference: reference,
  ))
}

data occurrence_binding_candidates_section13_conformance_note: String = "P2a first-slice scoped conformance roster (namespace-unique-on-chain-operational-plan.md section 2 population laws). Acceptance requires zero declared laws lacking either a joined exact-head executing observation or an explicitly admitted deferred row — the closed-denominator pattern. Section13PopulationLawExecuting is never self-attesting: section13_population_law_roster_adjudicate joins each Executing receipt to an exact-head Section13ExactHeadExecutionObservation (passed=true at required_head). DeclarationRef.module_path rows are symbolic module names (test.claim.x), never file paths. Section13RepeatedDiscoverySameIdentityCollapse stays Deferred with blocker ProductionOccurrenceCollectorMissing (dissolve_on occurrence_safe_collector_dedup_receipt). No roster-count pin: coverage is derived by section13_roster_covers_all_laws, not (count == N)."

data occurrence_safe_collector_dedup_receipt: String = "SCAFFOLD: production occurrence collector must deduplicate repeated discovery of the same identity before candidate binding. Dissolves when a live collector path executes the receipt and Section13RepeatedDiscoverySameIdentityCollapse moves to Executing via exact-head join."

type Section13PopulationLawId
  = Section13StructuralVisibility
  | Section13SiblingArmExclusion
  | Section13LexicalEnclosure
  | Section13SourceOrderGate
  | Section13DistinctIdentityAmbiguity
  | Section13RepeatedDiscoverySameIdentityCollapse

type Section13ExactHeadExecutionObservation {
  head: std.types.CommitSha
  declaration: std.decl_ref.DeclarationRef
  passed: Bool
}

type Section13PopulationLawEvidence
  = Section13PopulationLawExecuting { receipt: std.decl_ref.DeclarationRef }
  | Section13PopulationLawDeferredProductionOccurrenceCollectorMissing {
      dissolve_on: std.decl_ref.DeclarationRef?,
    }

type Section13PopulationLawRosterRow {
  law: Section13PopulationLawId
  evidence: Section13PopulationLawEvidence
}

type Section13PopulationLawRosterVerdict
  = Section13PopulationLawRosterHolds
  | Section13PopulationLawRosterRefusedDuplicateLaw {
      law: Section13PopulationLawId,
    }
  | Section13PopulationLawRosterRefusedUncoveredLaw {
      law: Section13PopulationLawId,
    }
  | Section13PopulationLawRosterRefusedPositionalModulePath {
      receipt: std.decl_ref.DeclarationRef,
    }
  | Section13PopulationLawRosterRefusedMissingObservation {
      receipt: std.decl_ref.DeclarationRef,
    }
  | Section13PopulationLawRosterRefusedFailedOrStaleObservation {
      receipt: std.decl_ref.DeclarationRef,
    }
  | Section13PopulationLawRosterRefusedDeferredMissingTrigger

fn section13_executing_receipt(
  module_path: std.types.NonEmptyStr,
  decl_name: std.types.NonEmptyStr
) -> std.decl_ref.DeclarationRef {
  std.decl_ref.DeclarationRef {
    module_path: module_path,
    decl_name: decl_name,
    field: WholeDeclaration,
  }
}

fn section13_collector_dedup_dissolve_on() -> std.decl_ref.DeclarationRef {
  std.decl_ref.DeclarationRef {
    module_path: "std.occurrence_binding_candidates" as std.types.NonEmptyStr,
    decl_name: "occurrence_safe_collector_dedup_receipt" as std.types.NonEmptyStr,
    field: WholeDeclaration,
  }
}

fn section13_witness_module_path() -> std.types.NonEmptyStr {
  "test.claim.occurrence_binding_candidates_witness_test" as std.types.NonEmptyStr
}

data section13_population_law_roster: List<Section13PopulationLawRosterRow> = [
  Section13PopulationLawRosterRow {
    law: Section13StructuralVisibility,
    evidence: Section13PopulationLawExecuting {
      receipt: section13_executing_receipt(
        module_path: section13_witness_module_path(),
        decl_name: "module_scope_sibling_is_visible_holds" as std.types.NonEmptyStr,
      ),
    },
  },
  Section13PopulationLawRosterRow {
    law: Section13SiblingArmExclusion,
    evidence: Section13PopulationLawExecuting {
      receipt: section13_executing_receipt(
        module_path: section13_witness_module_path(),
        decl_name: "sibling_match_arm_not_visible_holds" as std.types.NonEmptyStr,
      ),
    },
  },
  Section13PopulationLawRosterRow {
    law: Section13LexicalEnclosure,
    evidence: Section13PopulationLawExecuting {
      receipt: section13_executing_receipt(
        module_path: section13_witness_module_path(),
        decl_name: "nested_lexical_only_inside_scope_holds" as std.types.NonEmptyStr,
      ),
    },
  },
  Section13PopulationLawRosterRow {
    law: Section13SourceOrderGate,
    evidence: Section13PopulationLawExecuting {
      receipt: section13_executing_receipt(
        module_path: section13_witness_module_path(),
        decl_name: "declaration_below_occurrence_not_visible_holds" as std.types.NonEmptyStr,
      ),
    },
  },
  Section13PopulationLawRosterRow {
    law: Section13DistinctIdentityAmbiguity,
    evidence: Section13PopulationLawExecuting {
      receipt: section13_executing_receipt(
        module_path: section13_witness_module_path(),
        decl_name: "same_text_distinct_identities_is_ambiguous_holds" as std.types.NonEmptyStr,
      ),
    },
  },
  Section13PopulationLawRosterRow {
    law: Section13RepeatedDiscoverySameIdentityCollapse,
    evidence: Section13PopulationLawDeferredProductionOccurrenceCollectorMissing {
      dissolve_on: Present {
        value: section13_collector_dedup_dissolve_on(),
      },
    },
  },
]

fn section13_population_law_id_eq(
  left: Section13PopulationLawId,
  right: Section13PopulationLawId
) -> Bool {
  match left {
    Section13StructuralVisibility =>
      match right {
        Section13StructuralVisibility => true
        _ => false
      }
    Section13SiblingArmExclusion =>
      match right {
        Section13SiblingArmExclusion => true
        _ => false
      }
    Section13LexicalEnclosure =>
      match right {
        Section13LexicalEnclosure => true
        _ => false
      }
    Section13SourceOrderGate =>
      match right {
        Section13SourceOrderGate => true
        _ => false
      }
    Section13DistinctIdentityAmbiguity =>
      match right {
        Section13DistinctIdentityAmbiguity => true
        _ => false
      }
    Section13RepeatedDiscoverySameIdentityCollapse =>
      match right {
        Section13RepeatedDiscoverySameIdentityCollapse => true
        _ => false
      }
  }
}

data section13_module_path_is_symbolic_note: String = "Interim oracle only: refuses DeclarationRef.module_path strings that look positional (contain '/' or '.dag'). This is a §5 heuristic standing where a type should stand — the same class occurrence_module_path_convergence_note names. It is NOT the long-term authority for symbolic vs positional module identity."

fn section13_module_path_is_symbolic(module_path: std.types.NonEmptyStr) -> Bool {
  let path = module_path as String
  !string_contains(s: path, pattern: "/")
    && !string_contains(s: path, pattern: ".dag")
}

fn section13_roster_has_law(
  rows: List<Section13PopulationLawRosterRow>,
  law: Section13PopulationLawId
) -> Bool {
  rows |> any(row => section13_population_law_id_eq(left: row.law, right: law))
}

fn section13_roster_covers_all_laws(rows: List<Section13PopulationLawRosterRow>) -> Bool {
  section13_roster_has_law(rows: rows, law: Section13StructuralVisibility)
    && section13_roster_has_law(rows: rows, law: Section13SiblingArmExclusion)
    && section13_roster_has_law(rows: rows, law: Section13LexicalEnclosure)
    && section13_roster_has_law(rows: rows, law: Section13SourceOrderGate)
    && section13_roster_has_law(rows: rows, law: Section13DistinctIdentityAmbiguity)
    && section13_roster_has_law(
      rows: rows,
      law: Section13RepeatedDiscoverySameIdentityCollapse,
    )
}

fn section13_roster_has_duplicate_law(rows: List<Section13PopulationLawRosterRow>) -> Bool {
  fold(
    rows,
    init: false,
    f: (found, row) =>
      match found {
        true => true
        false =>
          fold(
            rows,
            init: 0,
            f: (count, other) =>
              match section13_population_law_id_eq(left: row.law, right: other.law) {
                true => count + 1
                false => count
              },
          ) > 1
      },
  )
}

fn section13_first_duplicate_law(
  rows: List<Section13PopulationLawRosterRow>
) -> Section13PopulationLawId? {
  fold(
    rows,
    init: none,
    f: (found, row) =>
      match found {
        Present { value: _ } => found
        Absent =>
          if fold(
            rows,
            init: 0,
            f: (count, other) =>
              match section13_population_law_id_eq(left: row.law, right: other.law) {
                true => count + 1
                false => count
              },
          ) > 1 {
            Present { value: row.law }
          } else {
            none
          }
      },
  )
}

fn section13_first_uncovered_law(
  rows: List<Section13PopulationLawRosterRow>
) -> Section13PopulationLawId? {
  if !section13_roster_has_law(rows: rows, law: Section13StructuralVisibility) {
    Present { value: Section13StructuralVisibility }
  } else if !section13_roster_has_law(rows: rows, law: Section13SiblingArmExclusion) {
    Present { value: Section13SiblingArmExclusion }
  } else if !section13_roster_has_law(rows: rows, law: Section13LexicalEnclosure) {
    Present { value: Section13LexicalEnclosure }
  } else if !section13_roster_has_law(rows: rows, law: Section13SourceOrderGate) {
    Present { value: Section13SourceOrderGate }
  } else if !section13_roster_has_law(rows: rows, law: Section13DistinctIdentityAmbiguity) {
    Present { value: Section13DistinctIdentityAmbiguity }
  } else if !section13_roster_has_law(
    rows: rows,
    law: Section13RepeatedDiscoverySameIdentityCollapse,
  ) {
    Present { value: Section13RepeatedDiscoverySameIdentityCollapse }
  } else {
    none
  }
}

fn section13_observation_joins_receipt(
  receipt: std.decl_ref.DeclarationRef,
  observations: List<Section13ExactHeadExecutionObservation>,
  required_head: std.types.CommitSha
) -> Bool? {
  fold(
    observations,
    init: none,
    f: (found, observation) =>
      match found {
        Present { value: _ } => found
        Absent =>
          if declaration_ref_eq(
            a: observation.declaration,
            b: receipt,
          ) && observation.head == required_head {
            Present { value: observation.passed }
          } else {
            none
          }
      },
  )
}

fn section13_adjudicate_row(
  row: Section13PopulationLawRosterRow,
  observations: List<Section13ExactHeadExecutionObservation>,
  required_head: std.types.CommitSha
) -> Section13PopulationLawRosterVerdict {
  match row.evidence {
    Section13PopulationLawExecuting { receipt: receipt } =>
      if !section13_module_path_is_symbolic(module_path: receipt.module_path) {
        Section13PopulationLawRosterRefusedPositionalModulePath { receipt: receipt }
      } else {
        match section13_observation_joins_receipt(
          receipt: receipt,
          observations: observations,
          required_head: required_head,
        ) {
          Absent =>
            Section13PopulationLawRosterRefusedMissingObservation { receipt: receipt }
          Present { value: false } =>
            Section13PopulationLawRosterRefusedFailedOrStaleObservation { receipt: receipt }
          Present { value: true } => Section13PopulationLawRosterHolds
        }
      }
    Section13PopulationLawDeferredProductionOccurrenceCollectorMissing {
      dissolve_on: dissolve_on,
    } =>
      match dissolve_on {
        Present { value: trigger } =>
          if section13_module_path_is_symbolic(module_path: trigger.module_path) {
            Section13PopulationLawRosterHolds
          } else {
            Section13PopulationLawRosterRefusedPositionalModulePath { receipt: trigger }
          }
        Absent => Section13PopulationLawRosterRefusedDeferredMissingTrigger
      }
  }
}

fn section13_population_law_roster_adjudicate(
  observations: List<Section13ExactHeadExecutionObservation>,
  required_head: std.types.CommitSha
) -> Section13PopulationLawRosterVerdict {
  let rows = section13_population_law_roster
  match section13_first_duplicate_law(rows: rows) {
    Present { value: law } =>
      Section13PopulationLawRosterRefusedDuplicateLaw { law: law }
    Absent =>
      match section13_first_uncovered_law(rows: rows) {
        Present { value: law } =>
          Section13PopulationLawRosterRefusedUncoveredLaw { law: law }
        Absent =>
          fold(
            rows,
            init: Section13PopulationLawRosterHolds,
            f: (verdict, row) =>
              match verdict {
                Section13PopulationLawRosterHolds =>
                  section13_adjudicate_row(
                    row: row,
                    observations: observations,
                    required_head: required_head,
                  )
                _ => verdict
              },
          )
      }
  }
}

fn section13_population_law_roster_denominator_holds(
  observations: List<Section13ExactHeadExecutionObservation>,
  required_head: std.types.CommitSha
) -> Bool {
  match section13_population_law_roster_adjudicate(
    observations: observations,
    required_head: required_head,
  ) {
    Section13PopulationLawRosterHolds => true
    _ => false
  }
}

data section13_module_path_is_symbolic_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "feature:module-path-qualified-name — DISSOLVE-ON: DeclarationRef.module_path / OccurrenceModulePathRow.module_path become v2.std.qualified_name.QualifiedName (same trigger as occurrence_module_path_convergence_note / std.observation observation_segment_grounding_note); then positional file-path inhabitance is unwritable, this string-grep oracle deletes, and section13_adjudicate_row stops calling i")
