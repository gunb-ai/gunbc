module std.annotation_reference

import std.types { Char, List, NonEmptyStr, String }
import std.algebra { Cons, Empty, FreeMonoid, length, list_at_optional, list_map, list_reverse, list_snoc_item }
import std.coercion { unicode_scalar_fold, unicode_scalar_unfold }
import std.optional { Absent, Optional, Present }
import std.decl_ref { DeclarationRef, DeclField, WholeDeclaration, NamedField, TypeParameter }
import std.unicode.char_class { unicode_char_code_point }
import std.unicode.types { unicode_scalar_utf8_octet_count }

// AN EXPLICIT DECLARATION REFERENCE INSIDE A SOURCE ANNOTATION. A comment stays best-effort prose
// (gunbc.design_argument::source_annotations): nothing here reads what it claims. What an author
// deliberately MARKS is a reference to a declaration, and a marked reference is an obligation the
// comment carries until it resolves or the comment is deleted. Unmarked text -- examples, external
// spec section signs, qualified names written as code -- is never a reference, so the marker is
// what makes intent decidable rather than a guess about which `a::b` spans were meant.
//
// THE GRAMMAR. The operator chose the hashtag form on 2026-11-19 ("yeah i'd like to use the
// hashtag thanks"). A marker is `#` IMMEDIATELY FOLLOWED BY a COORDINATE:
//   module.path::decl              a whole declaration
//   module.path::decl::field       a named field of decl
//   module.path::decl::<T>         a type parameter of decl
// and each segment is an ASCII identifier. The coordinate ends at the first character that cannot
// continue it (identifier characters, `.`, `:`, `<`, `>` continue; everything else ends the span --
// a `(` or `\` breaks it hard, a `#` ends it and may open the next marker, a `)` ends it as
// sentence-adjacent punctuation so a marker in parentheses -- (#gunbc.design_argument::fail_closed)
// -- still resolves). A trailing `.` or `:` not followed by an identifier character is sentence punctuation
// and is excluded from the coordinate. The coordinate is parsed straight into the std.decl_ref
// carrier; it is NOT the inverse of `declaration_ref_display_key`, which is a presentation and can
// give two refs one string. Here a decl or field segment cannot contain `::`, so each accepted
// coordinate has exactly one reading.
//
// A `#` SPANS INTO A MARKER ONLY IF IT REACHES `::`. That is what keeps the hashtag literate in
// ordinary prose: `#16630`, `#define`, `#f4f1ec`, `#comment` and `#a.b:c` stay text -- not markers,
// not findings. A `#` preceded by an ASCII identifier character or `/` never opens a marker, so URL
// fragments (issues/1#issuecomment) and path anchors (x/y#a::b) stay prose. The escape is `\#`.
//
// THE SEGMENT ALPHABET is ASCII identifier characters. A declaration whose name lies outside it is
// not citable by marker; such a coordinate reports CoordinateMalformed rather than a guessed target.
//
// THE TRADE-OFF, stated plainly (gunbc.design_argument::fail_closed, gunbc.design_argument::epistemic_humility).
// Under the old `\#` COORDINATE `)` form, every unescaped marker was accounted for: a marker
// whose body broke was a located finding, so no deliberately-marked reference could vanish. Under
// `#`, a span that never reaches `::` is indistinguishable from prose, so a typo like `#a.b:c` is
// SILENT PROSE and is no longer a finding. That is the accepted cost of a marker the rest of the
// world already uses: accounting for every `#` would put every issue number and colour code in
// every comment on the diagnostic path. What stays fail-closed is the accounted half: everything
// that reaches `::` is either a parsed reference or a located CoordinateMalformed finding, and the
// marker-to-marker rename/move rules still surface a reference whose target has moved.
//
// OFFSETS ARE UTF-8 OCTETS, the unit every lexer offset uses (v2.compiler.tokenize advances by
// std.unicode.types unicode_scalar_utf8_octet_count), so `start` of the scanned text plus an offset
// within it is an absolute source position on non-ASCII text too.

type AnnotationReference {
  reference: DeclarationRef
  start: Int
  end: Int
}

// A span that reached `::` and does not parse. There is exactly one way to fail, so there is no
// cause enum: the old `MarkerUnterminated` cause died with the closing parenthesis that made it
// meaningful, and its remains were deleted rather than kept as a dead arm. A span that never
// reaches `::` is prose by the grammar above and never becomes a finding at all.
type MalformedReferenceMarker {
  text: String
  start: Int
  end: Int
}

type AnnotationReferenceExtraction {
  references: List<AnnotationReference>
  malformed: List<MalformedReferenceMarker>
}

fn code_point_is_ascii_letter(cp: Int) -> Bool {
  (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
}

fn code_point_is_ascii_digit(cp: Int) -> Bool {
  cp >= 48 && cp <= 57
}

fn code_point_is_identifier_continue(cp: Int) -> Bool {
  code_point_is_ascii_letter(cp: cp) || code_point_is_ascii_digit(cp: cp) || cp == 95
}

// What continues a coordinate span: identifier characters and the coordinate punctuation `. : < >`.
// A `#`, `(`, `)` or `\` breaks the span; everything else ends it as an ordinary character (and,
// for `.` `:` `,` after a coordinate, as sentence punctuation excluded from the coordinate).
fn code_point_is_coordinate_continue(cp: Int) -> Bool {
  code_point_is_identifier_continue(cp: cp) || cp == 46 || cp == 58 || cp == 60 || cp == 62
}

// A `#` directly after one of these is not the start of a marker: it is a URL fragment, an anchor
// inside a path, or a hashtag glued to a word.
fn code_point_is_marker_predecessor(cp: Int) -> Bool {
  code_point_is_identifier_continue(cp: cp) || cp == 47
}

// Trailing sentence punctuation excluded from a finished coordinate: `.` and `:`. A `,` never
// enters the coordinate at all -- it ends the span as a non-continuing character.
fn code_point_is_strippable_trailing(cp: Int) -> Bool {
  cp == 46 || cp == 58
}

// Characters that break a span HARD: `(` (never a coordinate character; the old form's opening
// paren was balanced by a closing delimiter the hashtag does not have) and `\` (escape territory).
// While the span has reached `::` a hard break is a CoordinateMalformed finding; before that it is
// prose. A `#` is not hard: it ENDS this span (which is then evaluated) and may open the next
// marker. A `)` is not hard either: it ends the span as an ordinary character, so a marker written
// in sentence parentheses -- (#gunbc.design_argument::guarantee_ladder) -- still resolves, and the
// parenthesis stays out of the coordinate.
fn code_point_is_hard_break(cp: Int) -> Bool {
  cp == 40 || cp == 92
}

// THE MARKER'S SPELLING, ONCE. The scan reads it a scalar at a time, the check's spelling tests,
// the prefilter and every rendered finding read it whole; none spells it again.
data annotation_reference_marker: String = "#"

data annotation_reference_marker_scalars: List<Int> = list_map(xs: unicode_scalar_unfold(s: annotation_reference_marker), f: fn(c) { unicode_char_code_point(c: c) })

data marker_length: Int = length(xs: annotation_reference_marker_scalars)

fn marker_code_point_at(k: Int) -> Int {
  match list_at_optional(xs: annotation_reference_marker_scalars, index: k) {
    Present { value: cp } => cp
    Absent => 0 - 1
  }
}

type ReferenceScanMode
  = Seeking { progress: Int, marker_start: Int, escaped: Bool, pred: Int }
  | Candidate { marker_start: Int, body: FreeMonoid<Char>, reached_double_colon: Bool, pending_colon: Bool }

type ReferenceScan {
  mode: ReferenceScanMode
  position: Int
  previous: Int
  references: List<AnnotationReference>
  malformed: List<MalformedReferenceMarker>
}

fn reference_scan_initial(start: Int) -> ReferenceScan {
  ReferenceScan {
    mode: Seeking { progress: 0, marker_start: start, escaped: false, pred: 0 },
    position: start,
    previous: 0,
    references: [],
    malformed: [],
  }
}

// ---- coordinate parsing ------------------------------------------------------------------------

// The body split on `::`. A single `:` not followed by another is a malformed coordinate, caught by
// the segment check (`:` is not an identifier character).
type CoordinateSplit {
  segments: List<FreeMonoid<Char>>
  current: FreeMonoid<Char>
  pending_colon: Bool
  broken: Bool
}

fn coordinate_split_step(acc: CoordinateSplit, c: Char) -> CoordinateSplit {
  let cp = unicode_char_code_point(c: c)
  if acc.broken {
    acc
  } else if cp == 58 {
    if acc.pending_colon {
      CoordinateSplit { segments: list_snoc_item(xs: acc.segments, item: list_reverse(xs: acc.current)), current: Empty, pending_colon: false, broken: false }
    } else {
      CoordinateSplit { segments: acc.segments, current: acc.current, pending_colon: true, broken: false }
    }
  } else if acc.pending_colon {
    CoordinateSplit { segments: acc.segments, current: acc.current, pending_colon: false, broken: true }
  } else {
    CoordinateSplit { segments: acc.segments, current: Cons { head: c, tail: acc.current }, pending_colon: false, broken: false }
  }
}

fn coordinate_segments(body: FreeMonoid<Char>) -> Optional<List<FreeMonoid<Char>>> {
  let split = fold(body, init: CoordinateSplit { segments: [], current: Empty, pending_colon: false, broken: false }, f: (acc, c) => coordinate_split_step(acc: acc, c: c))
  if split.broken || split.pending_colon {
    Absent
  } else {
    Present { value: list_snoc_item(xs: split.segments, item: list_reverse(xs: split.current)) }
  }
}

fn segment_is_identifier(segment: FreeMonoid<Char>) -> Bool {
  match segment {
    Empty => false
    Cons { head: h, tail: t } =>
      !code_point_is_ascii_digit(cp: unicode_char_code_point(c: h))
        && fold(segment, init: true, f: (ok, c) => ok && code_point_is_identifier_continue(cp: unicode_char_code_point(c: c)))
  }
}

// A module path: one or more identifiers joined by `.`.
type ModulePathCheck {
  current_empty: Bool
  ok: Bool
}

fn segment_is_module_path(segment: FreeMonoid<Char>) -> Bool {
  let checked = fold(segment, init: ModulePathCheck { current_empty: true, ok: true }, f: (acc, c) =>
    let cp = unicode_char_code_point(c: c)
    if cp == 46 {
      ModulePathCheck { current_empty: true, ok: acc.ok && !acc.current_empty }
    } else if acc.current_empty {
      ModulePathCheck { current_empty: false, ok: acc.ok && code_point_is_identifier_continue(cp: cp) && !code_point_is_ascii_digit(cp: cp) }
    } else {
      ModulePathCheck { current_empty: false, ok: acc.ok && code_point_is_identifier_continue(cp: cp) }
    })
  checked.ok && !checked.current_empty
}

// `<T>` -> T, when the segment is a bracketed identifier.
fn segment_type_parameter(segment: FreeMonoid<Char>) -> Optional<FreeMonoid<Char>> {
  match segment {
    Empty => Absent
    Cons { head: open, tail: rest } =>
      if unicode_char_code_point(c: open) != 60 {
        Absent
      } else {
        match list_reverse(xs: rest) {
          Empty => Absent
          Cons { head: close, tail: inner_reversed } =>
            if unicode_char_code_point(c: close) != 62 {
              Absent
            } else {
              let inner = list_reverse(xs: inner_reversed)
              if segment_is_identifier(segment: inner) { Present { value: inner } } else { Absent }
            }
        }
      }
  }
}

fn segment_text(segment: FreeMonoid<Char>) -> NonEmptyStr {
  unicode_scalar_fold(xs: segment) as NonEmptyStr
}

fn coordinate_field(segment: FreeMonoid<Char>) -> Optional<DeclField> {
  if segment_is_identifier(segment: segment) {
    Present { value: NamedField { field_name: segment_text(segment: segment) } }
  } else {
    match segment_type_parameter(segment: segment) {
      Present { value: inner } => Present { value: TypeParameter { name: segment_text(segment: inner) } }
      Absent => Absent
    }
  }
}

fn coordinate_reference_of(module: FreeMonoid<Char>, decl: FreeMonoid<Char>, field: Optional<DeclField>) -> Optional<DeclarationRef> {
  if !segment_is_module_path(segment: module) || !segment_is_identifier(segment: decl) {
    Absent
  } else {
    match field {
      Absent => Absent
      Present { value: f } =>
        Present { value: DeclarationRef { module_path: segment_text(segment: module), decl_name: segment_text(segment: decl), field: f } }
    }
  }
}

// THE COORDINATE, parsed into the reference carrier, or Absent when it is not one of the three forms.
fn annotation_reference_coordinate(body: FreeMonoid<Char>) -> Optional<DeclarationRef> {
  match coordinate_segments(body: body) {
    Absent => Absent
    Present { value: segments } =>
      match segments {
        Cons { head: module, tail: Cons { head: decl, tail: Empty } } =>
          coordinate_reference_of(module: module, decl: decl, field: Present { value: WholeDeclaration })
        Cons { head: module, tail: Cons { head: decl, tail: Cons { head: field, tail: Empty } } } =>
          coordinate_reference_of(module: module, decl: decl, field: coordinate_field(segment: field))
        _ => Absent
      }
  }
}

// ---- the scan -----------------------------------------------------------------------------------

// Drop the run of trailing `.` / `:` sentence punctuation from a finished coordinate: walk the
// reversed body, dropping while still inside the trailing run, then keep everything else.
type CoordinateTrim {
  inside_trailing_run: Bool
  kept: FreeMonoid<Char>
}

fn trim_trailing_coordinate(body: FreeMonoid<Char>) -> FreeMonoid<Char> {
  let kept = fold(list_reverse(xs: body), init: CoordinateTrim { inside_trailing_run: true, kept: Empty }, f: (acc, c) =>
    let cp = unicode_char_code_point(c: c)
    if !acc.inside_trailing_run {
      CoordinateTrim { inside_trailing_run: false, kept: list_snoc_item(xs: acc.kept, item: c) }
    } else if code_point_is_strippable_trailing(cp: cp) {
      acc
    } else {
      CoordinateTrim { inside_trailing_run: false, kept: list_snoc_item(xs: acc.kept, item: c) }
    })
  list_reverse(xs: kept.kept)
}

fn reference_scan_advanced(scan: ReferenceScan, mode: ReferenceScanMode, cp: Int) -> ReferenceScan {
  ReferenceScan {
    mode: mode,
    position: scan.position + unicode_scalar_utf8_octet_count(code_point: cp),
    previous: cp,
    references: scan.references,
    malformed: scan.malformed,
  }
}

fn reference_scan_accept(scan: ReferenceScan, reference: AnnotationReference) -> ReferenceScan {
  ReferenceScan {
    mode: scan.mode,
    position: scan.position,
    previous: scan.previous,
    references: list_snoc_item(xs: scan.references, item: reference),
    malformed: scan.malformed,
  }
}

fn reference_scan_malformed(scan: ReferenceScan, marker_start: Int, text: String, end: Int) -> ReferenceScan {
  ReferenceScan {
    mode: scan.mode,
    position: scan.position,
    previous: scan.previous,
    references: scan.references,
    malformed: list_snoc_item(xs: scan.malformed, item: MalformedReferenceMarker { text: text, start: marker_start, end: end }),
  }
}

// The character after a completed marker, or any character while seeking. On a completed marker the
// `#` was already consumed by the match; here the coordinate itself is grown or the span is ended.
// While seeking, a scalar matching the marker continues the attempt; the marker's first scalar
// restarts it.
fn reference_scan_seek(scan: ReferenceScan, progress: Int, marker_start: Int, escaped: Bool, pred: Int, c: Char) -> ReferenceScan {
  let cp = unicode_char_code_point(c: c)
  if cp == marker_code_point_at(k: progress) {
    let started = if progress == 0 { scan.position } else { marker_start }
    let is_escaped = if progress == 0 { scan.previous == 92 } else { escaped }
    let is_prose = if progress == 0 { code_point_is_marker_predecessor(cp: pred) } else { false }
    if progress + 1 == marker_length {
      if is_escaped || is_prose {
        // The `#` is a fragment, an anchor, or escaped: prose, and the `#` is consumed by this
        // advance; a following `#` is a fresh marker attempt from the next step.
        reference_scan_advanced(scan: scan, mode: Seeking { progress: 0, marker_start: started, escaped: false, pred: 0 }, cp: cp)
      } else {
        reference_scan_advanced(scan: scan, mode: Candidate { marker_start: started, body: Empty, reached_double_colon: false, pending_colon: false }, cp: cp)
      }
    } else {
      reference_scan_advanced(scan: scan, mode: Seeking { progress: progress + 1, marker_start: started, escaped: is_escaped, pred: pred }, cp: cp)
    }
  } else if progress > 0 && cp == marker_code_point_at(k: 0) {
    reference_scan_advanced(scan: scan, mode: Seeking { progress: 1, marker_start: scan.position, escaped: scan.previous == 92, pred: scan.previous }, cp: cp)
  } else {
    reference_scan_advanced(scan: scan, mode: Seeking { progress: 0, marker_start: scan.position, escaped: false, pred: 0 }, cp: cp)
  }
}

// The span ended on `c` (which is NOT part of the coordinate and is scanned again from Seeking, so
// it may itself open the next marker). A span that never reached `::` was prose and leaves no
// trace. A span that reached `::` is a marker: its coordinate is trimmed of trailing sentence
// punctuation and parsed; anything that does not parse -- or that broke on a hard-break character
// after reaching `::` -- is a located CoordinateMalformed finding.
fn reference_scan_terminate(scan: ReferenceScan, marker_start: Int, body: FreeMonoid<Char>, reached_double_colon: Bool, hard: Bool, c: Char) -> ReferenceScan {
  if !reached_double_colon {
    reference_scan_seek(scan: scan, progress: 0, marker_start: scan.position, escaped: false, pred: scan.previous, c: c)
  } else {
    let coordinate = trim_trailing_coordinate(body: body)
    let reported = if hard {
      reference_scan_malformed(scan: scan, marker_start: marker_start, text: concat(annotation_reference_marker, unicode_scalar_fold(xs: coordinate)), end: scan.position)
    } else {
      match annotation_reference_coordinate(body: coordinate) {
        Absent =>
          reference_scan_malformed(scan: scan, marker_start: marker_start, text: concat(annotation_reference_marker, unicode_scalar_fold(xs: coordinate)), end: scan.position)
        Present { value: reference } =>
          reference_scan_accept(
            scan: scan,
            reference: AnnotationReference {
              reference: reference,
              start: marker_start,
              end: marker_start + marker_length + length(xs: coordinate),
            },
          )
      }
    }
    reference_scan_seek(scan: reported, progress: 0, marker_start: reported.position, escaped: false, pred: reported.previous, c: c)
  }
}

fn reference_scan_step(scan: ReferenceScan, c: Char) -> ReferenceScan {
  match scan.mode {
    Seeking { progress: progress, marker_start: marker_start, escaped: escaped, pred: pred } =>
      if progress == 0 {
        // A fresh attempt: the marker's predecessor is the character just consumed, and the
        // marker starts here.
        reference_scan_seek(scan: scan, progress: 0, marker_start: scan.position, escaped: false, pred: scan.previous, c: c)
      } else {
        reference_scan_seek(scan: scan, progress: progress, marker_start: marker_start, escaped: escaped, pred: pred, c: c)
      }
    Candidate { marker_start: marker_start, body: body, reached_double_colon: reached_double_colon, pending_colon: pending_colon } =>
      let cp = unicode_char_code_point(c: c)
      if code_point_is_coordinate_continue(cp: cp) {
        reference_scan_advanced(
          scan: scan,
          mode: Candidate {
            marker_start: marker_start,
            body: list_snoc_item(xs: body, item: c),
            reached_double_colon: if cp == 58 && pending_colon { true } else { reached_double_colon },
            pending_colon: cp == 58,
          },
          cp: cp,
        )
      } else {
        reference_scan_terminate(scan: scan, marker_start: marker_start, body: body, reached_double_colon: reached_double_colon, hard: code_point_is_hard_break(cp: cp), c: c)
      }
  }
}

fn reference_scan_finish(scan: ReferenceScan) -> AnnotationReferenceExtraction {
  let closed = match scan.mode {
    Seeking { progress: _, marker_start: _, escaped: _, pred: _ } => scan
    Candidate { marker_start: marker_start, body: body, reached_double_colon: reached_double_colon, pending_colon: _ } =>
      if !reached_double_colon {
        // End of text with a span that never reached `::`: prose, never a marker, never a finding.
        scan
      } else {
        let coordinate = trim_trailing_coordinate(body: body)
        match annotation_reference_coordinate(body: coordinate) {
          Absent =>
            reference_scan_malformed(scan: scan, marker_start: marker_start, text: concat(annotation_reference_marker, unicode_scalar_fold(xs: coordinate)), end: scan.position)
          Present { value: reference } =>
            reference_scan_accept(
              scan: scan,
              reference: AnnotationReference {
                reference: reference,
                start: marker_start,
                end: marker_start + marker_length + length(xs: coordinate),
              },
            )
        }
      }
  }
  AnnotationReferenceExtraction { references: closed.references, malformed: closed.malformed }
}

// THE ONE EXTRACTOR. `text` is the annotation's RAW lexeme (delimiter included), `start` its octet
// offset in the source, so every reported start/end is a source offset. Every realization that
// captures annotations calls this, the way both tokenizers call
// std.source_annotation advance_line_prefix_indent_only.
fn annotation_references(text: FreeMonoid<Char>, start: Int) -> AnnotationReferenceExtraction {
  reference_scan_finish(scan: fold(text, init: reference_scan_initial(start: start), f: (acc, c) => reference_scan_step(scan: acc, c: c)))
}

// The host-text form, for a caller holding kernel text: the same scan over the unfold, never a
// second grammar.
fn annotation_references_text(text: String, start: Int) -> AnnotationReferenceExtraction {
  annotation_references(text: unicode_scalar_unfold(s: text), start: start)
}

fn annotation_reference_extraction_empty() -> AnnotationReferenceExtraction {
  AnnotationReferenceExtraction { references: [], malformed: [] }
}

fn annotation_reference_extraction_concat(left: AnnotationReferenceExtraction, right: AnnotationReferenceExtraction) -> AnnotationReferenceExtraction {
  AnnotationReferenceExtraction {
    references: concat(left.references, right.references),
    malformed: concat(left.malformed, right.malformed),
  }
}
