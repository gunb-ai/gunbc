module std.durable_append_log

import std.types { NonEmptyStr, String, Bool, Int, List, list_length }
import std.nat { Nat }
import std.checked_arithmetic { checked_int_to_nat }
import std.measure { ByteSize, byte_size }
import std.optional { Present, Absent }
import std.durable_compare_and_set {
  CasGeneration, CasExpectation, ExpectSlotAbsent, ExpectSlotGeneration, CasUnreadableSlot, CasUnreadableMalformed,
  cas_generation_successor, CasSuccessorGeneration, CasSuccessorExhausted, cas_generation,
}
import std.durable_exclusive_hold {
  DurableHoldOwnerRef, durable_hold_owner_equal, DurableHoldSectionCompletion, SectionObservedComplete, SectionCompletionUnobservable,
}

// THE APPEND-ONLY LOG CONTRACT AND THE WRITER WINDOW, AS PURE SEMANTICS (no store, no codec, no path).
//
// WHY THIS IS NOT A NEW PRIMITIVE. A log is a slot whose generation line is its audit trail kept whole
// (DESIGN 3b, leasing row: "a slot whose generation line is an audit trail keeps it whole"), so the
// HOST-AUTHORED shape is std.durable_compare_and_set unwindowed: a record is a create-once generation,
// its position is its CasGeneration, its order is generation succession, and append is the one CAS
// operation with the expectation derived from the observed head. gunbc.fabric.fabric_event_log is the
// content-addressed realization of the same shape (one immutable object per event, a head advanced by a
// compare-and-set on the expected head) and stays the authority for capacity partitions; nothing here
// re-derives it. What the CAS line does NOT cover is the other shape every Blocked member of the
// sealed-store migration actually has: a FOREIGN-WRITTEN STREAM. The host creates the file, a sandboxed
// worker process appends newline-terminated records to it, and the host can only read. No generation
// file can be imposed on a process the host does not author, so for that shape the contract is a
// readback law plus a writer window, and the exclusion is std.durable_exclusive_hold's, not a second one.
//
// RECORD AND POSITION. A record is opaque text here; its codec is the log owner's, exactly as
// fabric_event_log takes the codec as a value. Position is CasGeneration for the host-authored shape and
// the line index (1-based, the same CasGeneration) for the stream shape, so one position type orders both.

// HOW A RECORD IS DELIMITED, because atomicity per record is a property of the framing and not of the file.
//   RecordPerGeneration   the record is one generation; it is whole or absent (create-once commit).
//   NewlineDelimitedStream the record is the bytes through a terminating line feed; a record without its
//                         terminator is NOT a record, it is a tail.
//   InPlaceRecordFile     the file is ONE record written in place by its writer (no rename, no create-once
//                         publish): it can be observed torn, and it is whole only if the OWNER'S decoder
//                         accepts the bytes. No terminator is assumed, so none is required.
type AppendFraming
  = RecordPerGeneration
  | NewlineDelimitedStream
  | InPlaceRecordFile

// The head a reader can state without interpreting a record: how many whole records, how many bytes.
type AppendLogHead {
  record_count: Nat
  byte_length: ByteSize
}

// ── (a) THE APPEND CONTRACT ───────────────────────────────────────────────────────────────────────

// THE EXPECTATION OF AN APPEND IS DERIVED FROM THE OBSERVED HEAD, NEVER SUPPLIED. An empty log expects the
// slot absent; a log of n records expects generation n. A caller that could name its own expectation could
// overwrite a record by naming a stale one, which is the append-only law's only way to break.
type AppendExpectation
  = AppendExpected { expectation: CasExpectation, position: CasGeneration }
  | AppendPositionExhausted { head: Nat }

fn append_log_expectation(head: AppendLogHead) -> AppendExpectation {
  if head.record_count == 0 {
    AppendExpected { expectation: ExpectSlotAbsent {}, position: 1 }
  } else {
    match cas_generation(n: head.record_count) {
      Absent => AppendPositionExhausted { head: head.record_count }
      Present { value: at } => match cas_generation_successor(g: at) {
        CasSuccessorExhausted { head: _ } => AppendPositionExhausted { head: head.record_count }
        CasSuccessorGeneration { generation: next } => AppendExpected { expectation: ExpectSlotGeneration { generation: at }, position: next }
      }
    }
  }
}

// WHAT A READER OF A STREAM OBSERVED, before any judgement: the whole lines, the byte count of whatever
// follows the last line feed, and the byte length of the file. `tail_bytes == 0` means the file ends on a
// terminator.
type AppendStreamObservation {
  complete_records: List<String>
  settled_bytes: ByteSize
  tail_bytes: ByteSize
}

// WHETHER THE ONE AUTHORIZED WRITER STILL HAS THE WINDOW, observed from the hold and nothing else.
type AppendWriterStanding
  = WriterHoldsWindow { owner: DurableHoldOwnerRef }
  | WriterWindowReleased
  | WriterStandingUnobserved { cause: NonEmptyStr }

// READBACK. Five arms, each with a different remedy; two of them are refusals.
//   AppendLogSettled      the window is released and the file ends on a terminator: every record is whole.
//   AppendLogOpenPrefix   a writer still holds the window: the whole lines are a PREFIX of the log, a partial
//                         tail is in flight and is excluded without being reported as damage. A reader of
//                         an open log is a reader of a prefix, and the type says so.
//   AppendLogTornTail     THE TORN-TAIL REFUSAL. The window is released and bytes follow the last
//                         terminator: the writer ended mid-record. The complete records are carried so the
//                         caller can see what was lost; they are never presented as the log.
//   AppendLogStandingUnobserved  the writer's standing could not be read: neither settled nor open, because
//                         answering either would be fabricating the other (DESIGN 5).
type AppendLogReadback
  = AppendLogSettled { records: List<String>, head: AppendLogHead }
  | AppendLogOpenPrefix { records: List<String>, head: AppendLogHead, writer: DurableHoldOwnerRef }
  | AppendLogTornTail { complete_records: List<String>, torn_bytes: ByteSize, head: AppendLogHead }
  | AppendLogStandingUnobserved { cause: NonEmptyStr }
  | AppendLogUnreadable { cause: CasUnreadableSlot }

// THE RECORD COUNT IS DERIVED from the returned records by the one list length (std.types list_length) and
// the one checked crossing to a natural number, never carried beside them: a second count could disagree with
// the list and position the next append over a record that already exists.
fn append_stream_head(observed: AppendStreamObservation) -> AppendLogHead? {
  match checked_int_to_nat(n: list_length(items: observed.complete_records)) {
    Present { value: n } => Present { value: AppendLogHead { record_count: n, byte_length: observed.settled_bytes } }
    Absent => Absent
  }
}

// WHAT A READER OF ONE RECORD FILE OBSERVED: nothing, bytes the owner's decoder accepted, or bytes it did not.
// The decoder is the log owner's (a codec is a value here, as for every record), so "decoded" is the one
// completeness evidence a file with no terminator can offer.
type InPlaceRecordObservation
  = InPlaceRecordAbsent
  | InPlaceRecordDecoded { record: String, bytes: ByteSize }
  | InPlaceRecordUndecodable { bytes: ByteSize }

type AppendObservation
  = StreamObserved { stream: AppendStreamObservation }
  | InPlaceRecordObserved { record: InPlaceRecordObservation }

// THE READBACK LAW PER FRAMING. The observation's shape must be the one the framing declares; a different
// shape is a refusal, never a reinterpretation. A RecordPerGeneration member is whole-or-absent by its commit,
// so undecodable bytes in one are a violated promise (unreadable), where an InPlaceRecordFile can legitimately
// be torn and reads as the torn-tail refusal.
fn append_readback(framing: AppendFraming, observation: AppendObservation, standing: AppendWriterStanding) -> AppendLogReadback {
  match observation {
    StreamObserved { stream: o } => match framing {
      NewlineDelimitedStream => append_stream_readback(observed: o, standing: standing)
      _ => append_observation_shape_refused()
    }
    InPlaceRecordObserved { record: r } => match framing {
      NewlineDelimitedStream => append_observation_shape_refused()
      InPlaceRecordFile => append_record_readback(observed: r, standing: standing, tearable: true)
      RecordPerGeneration => append_record_readback(observed: r, standing: standing, tearable: false)
    }
  }
}

fn append_observation_shape_refused() -> AppendLogReadback {
  AppendLogUnreadable { cause: CasUnreadableMalformed { detail: "observation shape does not match the declared framing" as NonEmptyStr } }
}

fn append_record_readback(observed: InPlaceRecordObservation, standing: AppendWriterStanding, tearable: Bool) -> AppendLogReadback {
  let empty = AppendLogHead { record_count: 0, byte_length: byte_size(count: 0) }
  match standing {
    WriterStandingUnobserved { cause: c } => AppendLogStandingUnobserved { cause: c }
    WriterHoldsWindow { owner: o } => match observed {
      InPlaceRecordDecoded { record: r, bytes: b } => AppendLogOpenPrefix { records: [r], head: AppendLogHead { record_count: 1, byte_length: b }, writer: o }
      _ => AppendLogOpenPrefix { records: [], head: empty, writer: o }
    }
    WriterWindowReleased => match observed {
      InPlaceRecordAbsent => AppendLogSettled { records: [], head: empty }
      InPlaceRecordDecoded { record: r, bytes: b } => AppendLogSettled { records: [r], head: AppendLogHead { record_count: 1, byte_length: b } }
      InPlaceRecordUndecodable { bytes: b } => if tearable {
        AppendLogTornTail { complete_records: [], torn_bytes: b, head: empty }
      } else {
        AppendLogUnreadable { cause: CasUnreadableMalformed { detail: "a whole-or-absent record is undecodable" as NonEmptyStr } }
      }
    }
  }
}

fn append_stream_readback(observed: AppendStreamObservation, standing: AppendWriterStanding) -> AppendLogReadback {
  match append_stream_head(observed: observed) {
    Absent => AppendLogUnreadable { cause: CasUnreadableMalformed { detail: "record count is not a natural number" as NonEmptyStr } }
    Present { value: head } => append_stream_readback_at(observed: observed, standing: standing, head: head)
  }
}

fn append_stream_readback_at(observed: AppendStreamObservation, standing: AppendWriterStanding, head: AppendLogHead) -> AppendLogReadback {
  match standing {
    WriterStandingUnobserved { cause: c } => AppendLogStandingUnobserved { cause: c }
    WriterHoldsWindow { owner: o } => AppendLogOpenPrefix { records: observed.complete_records, head: head, writer: o }
    WriterWindowReleased => if observed.tail_bytes.count == 0 {
      AppendLogSettled { records: observed.complete_records, head: head }
    } else {
      AppendLogTornTail { complete_records: observed.complete_records, torn_bytes: observed.tail_bytes, head: head }
    }
  }
}

// ── (b) THE MULTI-WRITER CONTRACT ─────────────────────────────────────────────────────────────────

// "MULTI-WRITER" IN THE DISPOSITION TABLES NAMES TWO PRINCIPALS, NOT CONCURRENT WRITERS: the host creates
// the member (create-new, group-writable under a dedicated worker account) and the sandboxed worker writes
// it. The contract is therefore a SEQUENCE of exclusive windows, never two writers at once:
//   HostCreatesThenSandboxWrites   host create-new (empty), then ONE sandbox window, then host reads only.
// The create and the append are DIFFERENT admissions, and THE APPEND ADMISSION REFUSES EVERY CREATE FIRST --
// before any standing, policy or principal is read, host or sandbox. append_write_admission judges appends only
// (policy, writer, standing, existence); the ONE admitted create route is
// append_host_create_admission(policy, existence), which has NO standing argument -- a create is exclusive
// through create-new, so a standing there could only ever be fabricated by the caller.
//   HostOnly                       the host is the only writer; the record shape is RecordPerGeneration.
type MemberWriterPolicy
  = HostOnly
  | HostCreatesThenSandboxWrites { principal: DurableHoldOwnerRef }

type AppendWriter
  = HostWriter
  | SandboxWriter { principal: DurableHoldOwnerRef }

type AppendWriteIntent
  = IntentCreateEmpty
  | IntentAppendRecord

type AppendWriteRefusal
  = WriterNotAuthorizedByPolicy
  | WriterWindowHeldByAnother { holder: DurableHoldOwnerRef }
  | WriterWindowNotOpen
  | HostWriteDuringSandboxWindow { holder: DurableHoldOwnerRef }
  | WriterStandingUnknown { cause: NonEmptyStr }
  | CreateOverExistingMember
  // A create handed to the APPEND admission, by ANY writer -- host or sandbox, under any policy, with the
  // window held by that writer or by nobody. Not a policy judgement and not a standing judgement: the create
  // route is a different fn (append_host_create_admission) that takes no standing and no window at all, and it
  // is the only admitted create. Every create reaching this admission is a caller reaching for the route
  // review 90279 closed, so it is refused before the standing, the policy or the principal is consulted --
  // a standing can never be what decides a create, in either direction.
  | CreateRequiresCreateAdmission

type AppendWriteAdmission
  = AppendWriteAdmitted
  | AppendWriteRefused { refusal: AppendWriteRefusal }

// WHO MAY DO WHAT, in one fold over (policy, writer, intent, window standing, member existence).
// The host's only write under HostCreatesThenSandboxWrites is the create, and only while the member does
// not exist; every sandbox append needs the window held BY THAT PRINCIPAL; a held window refuses every
// other writer including the host. Nothing here frees a window: release is the hold library's
// ReleasedOnEvidence, below.
fn append_write_admission(
  policy: MemberWriterPolicy,
  writer: AppendWriter,
  intent: AppendWriteIntent,
  standing: AppendWriterStanding,
  member_exists: Bool,
) -> AppendWriteAdmission {
  match intent {
    // FIRST, and before ANYTHING else: not the standing, not the policy, not the principal. A create is never
    // admitted here for any writer under any policy -- including a sandbox writer holding its own window, which
    // used to be a second admitted create route. One admitted create route exists: append_host_create_admission.
    IntentCreateEmpty => AppendWriteRefused { refusal: CreateRequiresCreateAdmission }
    IntentAppendRecord => match standing {
      WriterStandingUnobserved { cause: c } => AppendWriteRefused { refusal: WriterStandingUnknown { cause: c } }
      _ => match policy {
        HostOnly => match writer {
          HostWriter => append_host_admission(intent: intent, standing: standing, member_exists: member_exists)
          SandboxWriter { principal: _ } => AppendWriteRefused { refusal: WriterNotAuthorizedByPolicy }
        }
        HostCreatesThenSandboxWrites { principal: allowed } => match writer {
          HostWriter => match standing {
            WriterHoldsWindow { owner: o } => AppendWriteRefused { refusal: HostWriteDuringSandboxWindow { holder: o } }
            _ => AppendWriteRefused { refusal: WriterNotAuthorizedByPolicy }
          }
          SandboxWriter { principal: p } => append_sandbox_admission(allowed: allowed, principal: p, intent: intent, standing: standing, member_exists: member_exists)
        }
      }
    }
  }
}

// THE HOST APPEND ROUTE (HostOnly): appends are what a standing can speak about, so the standing is consulted
// here -- a held window refuses the host (WriterWindowHeldByAnother). append_write_admission refuses a create
// before it ever calls this fn; the create arm stays as the answer to a DIRECT call, so this helper can never
// admit a create either. member_exists is carried for the create route's shape only; an append does not read it.
fn append_host_admission(intent: AppendWriteIntent, standing: AppendWriterStanding, member_exists: Bool) -> AppendWriteAdmission {
  match intent {
    IntentCreateEmpty => AppendWriteRefused { refusal: CreateRequiresCreateAdmission }
    IntentAppendRecord => match standing {
      WriterHoldsWindow { owner: o } => AppendWriteRefused { refusal: WriterWindowHeldByAnother { holder: o } }
      _ => AppendWriteAdmitted
    }
  }
}

// THE HOST CREATE ROUTE, STANDING-FREE BY CONSTRUCTION (review 90279, done in this PR). A create needs exactly
// one fact -- whether the member is already there -- because the effect it authorizes is an EXCLUSIVE create
// (Filesystem.WriteCreateNew / WriteCreateNewWithMode): a second create over an existing member fails at the
// effect, so a writer-window standing cannot add a refusal here and a caller would have to FABRICATE one to
// satisfy the old signature. There is no standing parameter to fabricate; policy still decides WHO may create,
// and under HostCreatesThenSandboxWrites the host may create only while the member is absent.
fn append_host_create_admission(policy: MemberWriterPolicy, member_exists: Bool) -> AppendWriteAdmission {
  match policy {
    HostOnly => if member_exists { AppendWriteRefused { refusal: CreateOverExistingMember } } else { AppendWriteAdmitted }
    HostCreatesThenSandboxWrites { principal: _ } => if member_exists { AppendWriteRefused { refusal: CreateOverExistingMember } } else { AppendWriteAdmitted }
  }
}

// THE SANDBOX APPEND ROUTE. A held window owned by the declared principal admits an APPEND and nothing else:
// it used to admit a create too, which was a second admitted create route (a sandbox worker creating its own
// member outside the host's exclusive create-new). The create is refused here as well as in
// append_write_admission, so no call shape reaches an admitted create (review 90279).
fn append_sandbox_admission(allowed: DurableHoldOwnerRef, principal: DurableHoldOwnerRef, intent: AppendWriteIntent, standing: AppendWriterStanding, member_exists: Bool) -> AppendWriteAdmission {
  match intent {
    IntentCreateEmpty => AppendWriteRefused { refusal: CreateRequiresCreateAdmission }
    IntentAppendRecord => if !durable_hold_owner_equal(left: allowed, right: principal) {
      AppendWriteRefused { refusal: WriterNotAuthorizedByPolicy }
    } else {
      match standing {
        WriterHoldsWindow { owner: o } => if durable_hold_owner_equal(left: o, right: principal) {
          AppendWriteAdmitted
        } else {
          AppendWriteRefused { refusal: WriterWindowHeldByAnother { holder: o } }
        }
        _ => AppendWriteRefused { refusal: WriterWindowNotOpen }
      }
    }
  }
}

// THE WINDOW ENDS ON EVIDENCE, NOT ON THE WRITER'S WORD. What was observed when the section is judged
// complete is the stream and the writer's exit: a process that exited has no further append, whatever its
// tail looks like. A tail left behind by an exited writer is the NEXT read's torn-tail refusal, so ending
// the window and judging the log are two facts, never one. An exit that could not be observed is not a
// completion (durable_hold's own third verdict).
type WriterExit
  = WriterExitedClean
  | WriterExitedAbnormal { detail: NonEmptyStr }

// WHETHER THE EXIT WAS SEEN. Only a seen exit completes the section; an unseen one is the hold library's
// SectionCompletionUnobservable, which refuses the release and leaves the window held.
type WriterExitObservation
  = WriterExitSeen { exit: WriterExit }
  | WriterExitUnseen { cause: NonEmptyStr }

fn append_window_completion(observed: WriterExitObservation) -> DurableHoldSectionCompletion<WriterExit> {
  match observed {
    WriterExitSeen { exit: e } => SectionObservedComplete { observation: e }
    WriterExitUnseen { cause: c } => SectionCompletionUnobservable { cause: c }
  }
}
