module std.workflow_recursive


type VerdictTree
  = Leaf { verdict: std.reducible.ReduceVerdict }
  | Decomposed { children: List<VerdictTree> }

fn settle_verdict_tree(w: VerdictTree) -> std.reducible.ReduceVerdict {
  match w {
    Leaf { verdict: v } => v
    Decomposed { children: cs } => settle_verdict_children(cs)
  }
}

fn settle_verdict_children(cs: List<VerdictTree>) -> std.reducible.ReduceVerdict {
  std.reducible.reduce_verdicts_located(
    verdicts: map(
      collection: cs,
      f: fn(w) { settle_verdict_tree(w: w) }
    ),
    empty_missing: "verdict-tree:empty-decomposition"
  )
}

fn linearize_verdicts(verdicts: List<std.reducible.ReduceVerdict>) -> VerdictTree {
  Decomposed {
    children: map(
      collection: verdicts,
      f: fn(v) { Leaf { verdict: v } }
    )
  }
}
