module extdeps.safetensors.format

import std.types { Bool, String, NonEmptyStr, List }
import std.nat { Nat, nat_max }
import std.keyed_row { KeyedRow }
import std.keyed_roster {
  KeyedRosterBuild,
  KeyedRosterBuilt,
  KeyedRosterBuildDuplicateKey,
  keyed_roster_build,
}
import std.measure { ByteSize, byte_size, byte_size_count, measure_add, measure_sub, MeasureSubtraction, MeasureDifference, MeasureSubtrahendExceedsMinuend }
import extdeps.external_authority {
  ExternalAuthority,
  CitedFigureStanding,
  CitedToAuthority,
  TranscribedUncited,
  cited_figure_read_obligation,
}
import extdeps.uri { Uri, Https }

// SAFETENSORS, THE STORAGE FORMAT, AS ITS OWN UPSTREAM AUTHORITY. It is an independently
// versioned specification (huggingface/safetensors) and not a property of any model that happens
// to ship in it, so the header grammar lives here and every checkpoint module cites it. Without
// this module a checkpoint's tensor rows would each re-coin "name, dtype, shape, byte span", and
// the second checkpoint to need them would fork the first.
//
// WHAT A HEADER IS, AND WHAT IT IS NOT. A safetensors file is an 8-byte little-endian header
// length, a JSON header mapping tensor name to { dtype, shape, data_offsets }, then the payload.
// The header DECLARES structure. It is not a reading of the payload bytes and it is not evidence
// that the payload matches what it declares -- an intact header over a truncated or corrupted
// payload parses exactly as well as an intact one. That distinction is carried in the types below
// rather than in prose, because collapsing it is how a manifest comes to stand for verified
// content.

// THE DTYPE ROSTER IS THE WHOLE-BYTE SUBSET THIS REPOSITORY HAS GROUNDED, and the byte-width fold
// below is total over it. SUB-BYTE DTYPES ARE DELIBERATELY ABSENT: a whole-byte width function
// cannot express a 4-bit element without either lying or rounding, so the state has no constructor
// here instead of a width function that returns a wrong number for it. Adding a sub-byte dtype is
// a modelling change to the width carrier, not a row -- which is the point.
type SafetensorsDtype
  = SafeBool
  | SafeU8
  | SafeI8
  | SafeF8E5M2
  | SafeF8E4M3
  | SafeF8E8M0
  | SafeI16
  | SafeU16
  | SafeF16
  | SafeBf16
  | SafeI32
  | SafeU32
  | SafeF32
  | SafeI64
  | SafeU64
  | SafeF64

fn safetensors_dtype_wire(d: SafetensorsDtype) -> NonEmptyStr {
  match d {
    SafeBool => "BOOL" as NonEmptyStr
    SafeU8 => "U8" as NonEmptyStr
    SafeI8 => "I8" as NonEmptyStr
    SafeF8E5M2 => "F8_E5M2" as NonEmptyStr
    SafeF8E4M3 => "F8_E4M3" as NonEmptyStr
    SafeF8E8M0 => "F8_E8M0" as NonEmptyStr
    SafeI16 => "I16" as NonEmptyStr
    SafeU16 => "U16" as NonEmptyStr
    SafeF16 => "F16" as NonEmptyStr
    SafeBf16 => "BF16" as NonEmptyStr
    SafeI32 => "I32" as NonEmptyStr
    SafeU32 => "U32" as NonEmptyStr
    SafeF32 => "F32" as NonEmptyStr
    SafeI64 => "I64" as NonEmptyStr
    SafeU64 => "U64" as NonEmptyStr
    SafeF64 => "F64" as NonEmptyStr
  }
}

fn safetensors_dtype_byte_width(d: SafetensorsDtype) -> ByteSize {
  match d {
    SafeBool => byte_size(count: 1)
    SafeU8 => byte_size(count: 1)
    SafeI8 => byte_size(count: 1)
    SafeF8E5M2 => byte_size(count: 1)
    SafeF8E4M3 => byte_size(count: 1)
    SafeF8E8M0 => byte_size(count: 1)
    SafeI16 => byte_size(count: 2)
    SafeU16 => byte_size(count: 2)
    SafeF16 => byte_size(count: 2)
    SafeBf16 => byte_size(count: 2)
    SafeI32 => byte_size(count: 4)
    SafeU32 => byte_size(count: 4)
    SafeF32 => byte_size(count: 4)
    SafeI64 => byte_size(count: 8)
    SafeU64 => byte_size(count: 8)
    SafeF64 => byte_size(count: 8)
  }
}

// ONE HEADER ENTRY, SPELLED AS THE FORMAT SPELLS IT. data_offsets are begin and end, relative to
// the start of the payload region, end exclusive.
type SafetensorsEntry sole_constructor {
  name: NonEmptyStr
  dtype: SafetensorsDtype
  shape: List<Nat>
  begin_offset: Nat
  end_offset: Nat
}

fn safetensors_entry(
  name: NonEmptyStr,
  dtype: SafetensorsDtype,
  shape: List<Nat>,
  begin_offset: Nat,
  end_offset: Nat,
) -> SafetensorsEntry {
  SafetensorsEntry {
    name: name,
    dtype: dtype,
    shape: shape,
    begin_offset: begin_offset,
    end_offset: end_offset,
  }
}

// A NON-ASCENDING SPAN IS ZERO BYTES HERE AND IS SEPARATELY A REFUSAL BELOW.
//
// EVERY DERIVED BYTE QUANTITY IN THIS FILE IS A ByteSize, and these were the exception that the
// file's own rule at `safetensors_shard_file` forbids.
//
// `safetensors_dtype_byte_width` is one of them and was the last to be caught: a dtype-to-width table
// is NOT a transcribed spec field -- safetensors publishes the dtype NAME, and the width is this
// repository's knowledge about it -- so the carve-out below does not reach it. It is the size of one
// element, which is a size.
//
// AND THE ONE PLACE AN UNWRAP IS STILL RIGHT is where a dimensionless COUNT multiplies a size:
// elements x width cannot be written as a product of two ByteSize values, so `byte_size_count` appears
// at that multiplication and nowhere else. That is the honest line between the two cases -- unwrapping
// to MULTIPLY BY A COUNT is arithmetic the carrier cannot express, while unwrapping to COMPARE is the
// smell, because it is reconciling two representations of one quantity by hand. `begin_offset` and `end_offset` stay bare `Nat`
// because they ARE the spec's `data_offsets` integers and this module's job is to model what safetensors
// publishes -- but their DIFFERENCE is a size we computed, not a field we transcribed, and the same goes
// for elements x dtype width. Leaving them as `Nat` is what forced `byte_size_count` unwrapping at every
// comparison, which is two representations of one quantity reconciled by hand: DESIGN §2's test that net
// concepts must not grow by re-invention.
data safetensors_no_bytes: ByteSize = byte_size(count: 0)

fn safetensors_entry_span(e: SafetensorsEntry) -> ByteSize {
  if e.end_offset >= e.begin_offset { byte_size(count: e.end_offset - e.begin_offset) } else { safetensors_no_bytes }
}

fn safetensors_shape_elements(shape: List<Nat>) -> Nat {
  fold(shape, init: 1, f: (acc, d) => acc * d)
}

// THE DECLARED SPAN AND THE DECLARED SHAPE MUST AGREE. This is an internal-consistency relation
// over the header alone -- it establishes that the manifest is well formed, and establishes
// nothing whatever about the payload. Keeping the two apart is the whole reason this file exists.
fn safetensors_entry_declared_bytes(e: SafetensorsEntry) -> ByteSize {
  byte_size(count: safetensors_shape_elements(shape: e.shape) * byte_size_count(b: safetensors_dtype_byte_width(d: e.dtype)))
}

type SafetensorsEntryDefect
  = EntrySpanNotAscending { name: NonEmptyStr }
  | EntryShapeEmpty { name: NonEmptyStr }
  | EntryShapeHasZeroDimension { name: NonEmptyStr }
  | EntrySpanDisagreesWithShape { name: NonEmptyStr, span: ByteSize, declared: ByteSize }
  | EntryNameDuplicated { name: NonEmptyStr }

fn safetensors_entry_defect_display(d: SafetensorsEntryDefect) -> NonEmptyStr {
  match d {
    EntrySpanNotAscending { name: n } =>
      join(["safetensors entry ", n as String, " declares end_offset <= begin_offset"], "") as NonEmptyStr
    EntryShapeEmpty { name: n } =>
      join(["safetensors entry ", n as String, " declares an empty shape"], "") as NonEmptyStr
    EntryShapeHasZeroDimension { name: n } =>
      join(["safetensors entry ", n as String, " declares a zero-length dimension"], "") as NonEmptyStr
    EntrySpanDisagreesWithShape { name: n, span: s, declared: dd } =>
      join([
        "safetensors entry ", n as String, " spans ", to_string(byte_size_count(b: s)),
        " bytes but its shape and dtype declare ", to_string(byte_size_count(b: dd)),
      ], "") as NonEmptyStr
    EntryNameDuplicated { name: n } =>
      join([
        "safetensors tensor name ", n as String,
        " occurs more than once in one population; a tensor subject must be unique",
      ], "") as NonEmptyStr
  }
}

fn safetensors_shape_is_well_formed(shape: List<Nat>) -> Bool {
  count(shape) > 0 && all(shape, d => d > 0)
}

fn safetensors_entry_defects(e: SafetensorsEntry) -> List<SafetensorsEntryDefect> {
  concat(
    concat(
      if e.end_offset > e.begin_offset { [] } else { [EntrySpanNotAscending { name: e.name }] },
      if count(e.shape) > 0 { [] } else { [EntryShapeEmpty { name: e.name }] }),
    concat(
      if all(e.shape, d => d > 0) { [] } else { [EntryShapeHasZeroDimension { name: e.name }] },
      if safetensors_shape_is_well_formed(shape: e.shape)
        && e.end_offset > e.begin_offset
        && byte_size_count(b: safetensors_entry_span(e: e)) == byte_size_count(b: safetensors_entry_declared_bytes(e: e)) {
        []
      } else {
        if safetensors_shape_is_well_formed(shape: e.shape) && e.end_offset > e.begin_offset {
          [EntrySpanDisagreesWithShape {
            name: e.name,
            span: safetensors_entry_span(e: e),
            declared: safetensors_entry_declared_bytes(e: e),
          }]
        } else { [] }
      }))
}

// DUPLICATE-KEY-OVER-A-ROSTER HAS A HOME AND THIS FILE NOW USES IT. A first cut hand-rolled the
// occurrence count and the first-seen accumulator here, which is DESIGN section 2's failed
// decomposition -- minting a fresh authority for a concept that already exists -- and section 3b's
// only red, a divergence with no stated reason. `std.keyed_roster` owns it, `std.roster_frontier`
// already adapts it exactly this way, and the adapter below is the whole of what this format
// contributes: which field is the key.
//
// THE DEFECT NO LONGER CARRIES AN OCCURRENCE COUNT, deliberately. The DUPLICATION is the defect and
// the multiplicity is decoration -- and `keyed_occurrence_count` returns an `Int` against what was a
// `Nat` field, which is precisely the cross-type reconciliation that compiles clean and ANSWERS rather
// than refusing. This corpus has a failure-mode row for that class. Carrying the count would have
// re-minted the hazard in order to render one number.
//
// THE ROSTER REPORTS THE FIRST DUPLICATE RATHER THAN ALL OF THEM, which is the same behaviour
// `frontier_rows_keyed_roster_build` has: one located duplicate is enough to refuse, and a refusal
// does not become more true by enumerating the rest.
fn safetensors_entry_name_eq(a: NonEmptyStr, b: NonEmptyStr) -> Bool {
  (a as String) == (b as String)
}

fn safetensors_entry_keyed_rows(entries: List<SafetensorsEntry>) -> List<KeyedRow<NonEmptyStr, SafetensorsEntry>> {
  map(entries, e => KeyedRow { row_key: e.name, value: e })
}

fn safetensors_duplicate_defects(entries: List<SafetensorsEntry>) -> List<SafetensorsEntryDefect> {
  match keyed_roster_build(
    incomings: safetensors_entry_keyed_rows(entries: entries),
    key_eq: safetensors_entry_name_eq,
  ) {
    KeyedRosterBuilt { rows: _ } => []
    KeyedRosterBuildDuplicateKey { key: k, first: _, duplicate: _ } => [EntryNameDuplicated { name: k }]
  }
}

// ── A SCAN THAT FAILED IS NOT AN EMPTY POPULATION ─────────────────────────────────────────────
//
// The reading is the outer fact and the entries are inside it, so there is no way to hand a fold
// an entry list that has silently lost the information that the scan did not finish. A partial
// read keeps BOTH the rows it got and the obligation for the rest; it can never be consumed as a
// complete population, because the completeness fold below has no arm that accepts it.
// ── THE INDEX AND THE HEADERS ARE TWO SOURCES, AND A POPULATION IS THE JOIN OF THEM ────────────
//
// A checkpoint's `model.safetensors.index.json` maps every tensor NAME to the shard that holds it.
// A shard's own header declares each tensor's dtype, shape and byte span but knows nothing about
// which shard it is in. So neither source alone identifies a component's population:
//
//   the index says WHICH tensors exist and WHERE they live
//   the header says WHAT each tensor is and WHICH BYTES it occupies
//
// A first cut checked only the header side -- non-emptiness, per-entry shape/span consistency, and
// duplicate names -- and called that established. It was not. Any internally consistent list of
// entries passed, so RENAMING one tensor to another unique name of the same dtype, shape and span
// preserved both the count and the byte total and nothing caught it. Equal totals establish
// arithmetic, never membership: they cannot tell you that a population is THE population at a
// revision rather than some other set that happens to add up.
//
// So membership is a RECONCILIATION against index rows read at the same revision, and its refusal
// keeps the five ways it can fail apart, because they have different remedies: a MISSING member
// means the header scan is incomplete, an EXTRA entry means the header holds something the index
// does not name, a MISASSIGNED one means the two sources disagree about where it lives, a
// DUPLICATED one means the population is ambiguous, and an OVERLAPPING span means two tensors claim
// the same bytes.
type SafetensorsIndexMember sole_constructor {
  name: NonEmptyStr
  shard: NonEmptyStr
}

fn safetensors_index_member(name: NonEmptyStr, shard: NonEmptyStr) -> SafetensorsIndexMember {
  SafetensorsIndexMember { name: name, shard: shard }
}

// AN ENTRY KEEPS ITS SHARD THROUGH EVERY COMBINATION. The first cut concatenated two per-shard
// lists into one flat population, at which point per-shard placement, non-overlap and coverage were
// no longer decidable from the value -- offsets are shard-relative, so two entries from different
// shards legitimately share a span and the flat list cannot tell that from a real collision.
type SafetensorsShardedEntry sole_constructor {
  shard: NonEmptyStr
  entry: SafetensorsEntry
}

fn safetensors_sharded_entry(shard: NonEmptyStr, entry: SafetensorsEntry) -> SafetensorsShardedEntry {
  SafetensorsShardedEntry { shard: shard, entry: entry }
}

fn safetensors_sharded_entries(shard: NonEmptyStr, entries: List<SafetensorsEntry>) -> List<SafetensorsShardedEntry> {
  map(entries, e => safetensors_sharded_entry(shard: shard, entry: e))
}

type SafetensorsMembershipDefect
  = MemberMissingFromHeaders { name: NonEmptyStr, shard: NonEmptyStr }
  | EntryAbsentFromIndex { name: NonEmptyStr, shard: NonEmptyStr }
  | MemberInWrongShard { name: NonEmptyStr, index_shard: NonEmptyStr, header_shard: NonEmptyStr }
  | MemberDuplicatedInIndex { name: NonEmptyStr }
  | EntrySpansOverlapWithinShard { shard: NonEmptyStr, left: NonEmptyStr, right: NonEmptyStr }

fn safetensors_membership_defect_display(d: SafetensorsMembershipDefect) -> NonEmptyStr {
  match d {
    MemberMissingFromHeaders { name: n, shard: sh } =>
      join([
        "the index at this revision names ", n as String, " in ", sh as String,
        " and no header entry was read for it; a member the headers do not carry is an unfinished scan, not a smaller component",
      ], "") as NonEmptyStr
    EntryAbsentFromIndex { name: n, shard: sh } =>
      join([
        "a header entry in ", sh as String, " declares ", n as String,
        ", which the index at this revision does not name; equal counts and equal byte totals do not establish membership",
      ], "") as NonEmptyStr
    MemberInWrongShard { name: n, index_shard: i, header_shard: h } =>
      join([
        "the index places ", n as String, " in ", i as String,
        " and its header entry was read from ", h as String, "; the two sources disagree about where it lives",
      ], "") as NonEmptyStr
    MemberDuplicatedInIndex { name: n } =>
      join([
        "the index rows name ", n as String, " more than once; a member must be unique",
      ], "") as NonEmptyStr
    EntrySpansOverlapWithinShard { shard: sh, left: l, right: r } =>
      join([
        "within ", sh as String, ", ", l as String, " and ", r as String,
        " claim overlapping byte spans, so they cannot both be what their header says",
      ], "") as NonEmptyStr
  }
}

fn safetensors_entry_for_name(entries: List<SafetensorsShardedEntry>, name: NonEmptyStr) -> SafetensorsShardedEntry? {
  (filter(entries, se => (se.entry.name as String) == (name as String))).first()
}

// THE INDEX SIDE CONSUMES THE SAME AUTHORITY. Two rosters, one duplicate-key concept, one home.
fn safetensors_index_keyed_rows(members: List<SafetensorsIndexMember>) -> List<KeyedRow<NonEmptyStr, SafetensorsIndexMember>> {
  map(members, m => KeyedRow { row_key: m.name, value: m })
}

fn safetensors_index_duplicate_defects(members: List<SafetensorsIndexMember>) -> List<SafetensorsMembershipDefect> {
  match keyed_roster_build(
    incomings: safetensors_index_keyed_rows(members: members),
    key_eq: safetensors_entry_name_eq,
  ) {
    KeyedRosterBuilt { rows: _ } => []
    KeyedRosterBuildDuplicateKey { key: k, first: _, duplicate: _ } => [MemberDuplicatedInIndex { name: k }]
  }
}

fn safetensors_index_has_name(members: List<SafetensorsIndexMember>, name: NonEmptyStr) -> Bool {
  any(members, m => safetensors_entry_name_eq(a: m.name, b: name))
}

fn safetensors_spans_overlap(a: SafetensorsEntry, b: SafetensorsEntry) -> Bool {
  a.begin_offset < b.end_offset && b.begin_offset < a.end_offset
}

// OVERLAP IS A WITHIN-SHARD QUESTION, SO THE SCAN IS PARTITIONED BY SHARD FIRST. A first cut scanned
// the WHOLE population for every entry and discarded the other shards' rows inside the predicate, so a
// checkpoint of forty-eight shards paid the full n squared to answer a question that only ever compares
// rows sharing a shard. Partitioning makes the cost the sum of the per-shard squares instead of the
// square of the sum, and it composes with the sweep below.
fn safetensors_overlap_defects(entries: List<SafetensorsShardedEntry>) -> List<SafetensorsMembershipDefect> {
  flat_map(
    safetensors_shard_names(entries: entries),
    sh => safetensors_overlap_defects_within(
      shard: sh,
      entries: filter(entries, se => (se.shard as String) == (sh as String))))
}

// AND THE WITHIN-SHARD SCAN IS AN ORDERED SWEEP RATHER THAN A PAIRWISE COMPARISON.
//
// A SECOND CUT DECLARED THIS RESIDUE AS A §4b(3) DROP against a missing ordering primitive, on the
// grounds that std carries a mergesort COST BOUND (std.induction mergesort_bound) and no sort. That was
// WRONG, and the way it was wrong is worth recording: `sort_by` exists as a list METHOD
// (std.methods sort_by_method, costed at n*(key_work + log n) with certainty Proven in
// std.primitives sort_by_contract), so searching the std MODULE where ordering would live finds only
// the bound and misses the capability. An absence established by looking where the thing ought to be
// is not an absence. The drop would have become a permanent false limitation cited as known.
//
// THE SWEEP IS CORRECT BECAUSE IT TRACKS THE WIDEST END, NOT THE PREDECESSOR. Sorting by begin_offset
// and comparing each entry only to the one before it MISSES overlaps: over [0,10], [1,2], [3,4] the
// adjacent test catches the first pair and never compares [0,10] with [3,4]. Carrying the entry with
// the greatest end seen so far catches both, because any later entry that starts before that end
// overlaps it.
//
// ONE LOCATED OVERLAP IS ENOUGH TO REFUSE, which is the same judgement `safetensors_duplicate_defects`
// makes about duplicate keys: a refusal does not become more true by enumerating the rest, and
// accumulating every pair would reintroduce both a growing accumulator and an output-quadratic worst
// case for the sake of a longer message.
type SafetensorsOverlapScan sole_constructor {
  widest: SafetensorsShardedEntry?
  found: SafetensorsMembershipDefect?
}

fn safetensors_overlap_defects_within(
  shard: NonEmptyStr,
  entries: List<SafetensorsShardedEntry>,
) -> List<SafetensorsMembershipDefect> {
  match safetensors_overlap_sweep(shard: shard, ordered: entries.sort_by(se => se.entry.begin_offset)).found {
    Present { value: d } => [d]
    Absent => []
  }
}

fn safetensors_overlap_sweep(
  shard: NonEmptyStr,
  ordered: List<SafetensorsShardedEntry>,
) -> SafetensorsOverlapScan {
  fold(ordered, init: SafetensorsOverlapScan { widest: none, found: none }, f: (acc, se) =>
    match acc.widest {
      Absent => SafetensorsOverlapScan { widest: Present { value: se }, found: acc.found }
      Present { value: w } =>
        if se.entry.begin_offset < w.entry.end_offset {
          SafetensorsOverlapScan {
            widest: Present { value: safetensors_wider_end(a: w, b: se) },
            found: match acc.found {
              Present { value: d } => Present { value: d }
              Absent => Present { value: EntrySpansOverlapWithinShard {
                shard: shard, left: w.entry.name, right: se.entry.name } }
            },
          }
        } else {
          SafetensorsOverlapScan { widest: Present { value: se }, found: acc.found }
        }
    })
}

fn safetensors_wider_end(a: SafetensorsShardedEntry, b: SafetensorsShardedEntry) -> SafetensorsShardedEntry {
  if b.entry.end_offset > a.entry.end_offset { b } else { a }
}

fn safetensors_membership_defects(
  members: List<SafetensorsIndexMember>,
  entries: List<SafetensorsShardedEntry>,
) -> List<SafetensorsMembershipDefect> {
  concat(
    concat(
      flat_map(members, m =>
        match safetensors_entry_for_name(entries: entries, name: m.name) {
          Absent => [MemberMissingFromHeaders { name: m.name, shard: m.shard }]
          Present { value: se } =>
            if (se.shard as String) == (m.shard as String) {
              []
            } else {
              [MemberInWrongShard { name: m.name, index_shard: m.shard, header_shard: se.shard }]
            }
        }),
      flat_map(entries, se =>
        if !safetensors_index_has_name(members: members, name: se.entry.name) {
          [EntryAbsentFromIndex { name: se.entry.name, shard: se.shard }]
        } else { [] })),
    concat(
      safetensors_index_duplicate_defects(members: members),
      safetensors_overlap_defects(entries: entries)))
}

// ── HOW FAR THE RECONCILIATION CLOSES, AS A VALUE A FOLD CAN READ ─────────────────────────────
//
// Reconciling against index rows SOMEONE READ establishes that the header population is exactly the
// set those rows name. It does not establish that those rows are every member at the revision --
// that needs the full index population, which a caller may not have enumerated. The two are
// different claims and the weaker one leaves a residual: a member the index holds but nobody listed
// would be neither reconciled nor refused.
//
// THAT RESIDUAL IS CARRIED, NOT ANNOTATED. A scoped claim whose remainder lives in a comment is how
// a partial population comes to be read as complete by the next author: prose cannot refuse, and
// nothing downstream can tell the two closures apart. So the closure is a field on the established
// population, its obligation is reachable by a fold, and discharging it is a value change rather
// than an edit to a sentence.
type MembershipClosure
  = MembershipClosedAgainstFullIndex { index_population_count: Nat, how: NonEmptyStr }
  | MembershipScopedToReadRows { read_rows: Nat, unenumerated: NonEmptyStr }

fn membership_closure_obligations(c: MembershipClosure) -> List<NonEmptyStr> {
  match c {
    MembershipClosedAgainstFullIndex { index_population_count: _, how: _ } => []
    MembershipScopedToReadRows { read_rows: k, unenumerated: u } =>
      [join([
        "membership is reconciled against ", to_string(k),
        " index rows that were read, not against the revision's full index population: ", u as String,
      ], "") as NonEmptyStr]
  }
}

// THE PARTIAL ROWS SURVIVE THE STANDING. A first cut reduced them to a COUNT, which is exactly the
// discard this section exists to prevent one level down: a reader holding the standing could say how
// many rows were read and could not say which, so re-reading only the missing shard was impossible and
// the rows had to be scanned again from nothing. They are carried whole, and they are carried on the
// INCOMPLETE arm, so no fold can reach them believing it holds a complete population -- `PopulationEstablished`
// remains the only arm `SafetensorsPopulation` is constructed on.
//
// A SCAN THAT FAILED IS NOT AN EMPTY POPULATION. The reading is the outer fact and the entries are
// inside it, so there is no way to hand a fold an entry list that has silently lost the information
// that the scan did not finish. A partial read keeps BOTH the rows it got and the obligation for the
// rest; it can never be consumed as a complete population, because the fold below has no arm that
// accepts it.
type SafetensorsPopulationReading
  = PopulationScanned { entries: List<SafetensorsShardedEntry> }
  | PopulationPartiallyScanned { entries: List<SafetensorsShardedEntry>, unread: NonEmptyStr }
  | PopulationUnscanned { obligation: NonEmptyStr }

type SafetensorsPopulation sole_constructor {
  members: List<SafetensorsShardedEntry>
  declared_bytes: ByteSize
  closure: MembershipClosure
}

type SafetensorsPopulationStanding
  = PopulationEstablished { population: SafetensorsPopulation }
  | PopulationIncomplete { obligation: NonEmptyStr, partial_entries: List<SafetensorsShardedEntry> }
  | PopulationRefused { defects: List<NonEmptyStr> }

// RECONCILIATION DOES NOT BOUND THE PAYLOAD, AND THAT IS THE GAP THIS FOLD CLOSES. Membership asks
// which names are present and in which shard; the entry defects ask whether spans are well formed and
// non-overlapping WITHIN the population. Shift every offset in one shard up by a single byte and all of
// that still holds -- same names, same shards, same lengths, same non-overlap -- while the last tensor
// now ends one byte past the payload the shard's own header declares.
//
// THE CHECK IS DRIVEN BY THE SHARDS THE ENTRIES OCCUPY, NOT BY THE ROWS SOMEONE SUPPLIED. A first cut
// folded over the supplied bound rows, so the validation was REMOVABLE BY DELETING ITS OWN INPUT: shift
// one shard's offsets and omit that shard's bounds row, and no extent check ran at all. An empty bounds
// list was the extreme case -- every shard unchecked, reported as established. So the occupied shard
// identities are reconciled against the bound-row identities FIRST, and only an exact one-to-one
// resolution permits the comparison. Missing bounds are an evidence obligation; duplicate bounds are a
// defect, because two payload figures for one shard mean neither is the shard's payload.
//
// Supplying bounds for shards the entries do NOT occupy is allowed and is not an error: a component
// occupying two shards of forty-eight needs those two reconciled, not all forty-eight enumerated.
type ShardBoundsResolution
  = ShardBoundsResolved { shard: NonEmptyStr, file: SafetensorsShardFile }
  | ShardBoundsDuplicated { shard: NonEmptyStr, rows: Nat }
  | ShardBoundsAbsent { shard: NonEmptyStr }

fn safetensors_shard_bounds_resolution(
  shards: List<SafetensorsShardFile>,
  shard: NonEmptyStr,
) -> ShardBoundsResolution {
  let rows = filter(shards, sh => (sh.path as String) == (shard as String))
  if count(rows) == 1 {
    match first(rows) {
      Present { value: f } => ShardBoundsResolved { shard: shard, file: f }
      Absent => ShardBoundsAbsent { shard: shard }
    }
  } else {
    if count(rows) == 0 {
      ShardBoundsAbsent { shard: shard }
    } else {
      ShardBoundsDuplicated { shard: shard, rows: count(rows) }
    }
  }
}

fn safetensors_shard_bounds_resolutions(
  shards: List<SafetensorsShardFile>,
  entries: List<SafetensorsShardedEntry>,
) -> List<ShardBoundsResolution> {
  map(
    safetensors_shard_names(entries: entries),
    n => safetensors_shard_bounds_resolution(shards: shards, shard: n))
}

// A DUPLICATE BOUND ROW IS A DEFECT AND REFUSES. Two payload figures for one shard identity means the
// input contradicts itself, and picking either would be the absorbing fallback DESIGN section 5 names.
fn safetensors_shard_bounds_defects(
  shards: List<SafetensorsShardFile>,
  entries: List<SafetensorsShardedEntry>,
) -> List<NonEmptyStr> {
  flat_map(safetensors_shard_bounds_resolutions(shards: shards, entries: entries), r => match r {
    ShardBoundsDuplicated { shard: sd, rows: n } =>
      [join([
        "safetensors shard ", sd as String, " has ", to_string(n),
        " bound rows, so it carries that many payload figures and none of them is the shard's payload",
      ], "") as NonEmptyStr]
    ShardBoundsResolved { shard: _, file: _ } => []
    ShardBoundsAbsent { shard: _ } => []
  })
}

// A MISSING BOUND ROW IS AN OBLIGATION, NOT A PASS. The entries occupy a shard nobody stated the size
// of, so the extent comparison has no second operand -- which is a thing not yet read rather than a
// thing found wrong, and it keeps the population off `PopulationEstablished` either way.
fn safetensors_shard_bounds_obligations(
  shards: List<SafetensorsShardFile>,
  entries: List<SafetensorsShardedEntry>,
) -> List<NonEmptyStr> {
  flat_map(safetensors_shard_bounds_resolutions(shards: shards, entries: entries), r => match r {
    ShardBoundsAbsent { shard: sd } =>
      [join([
        "the admitted entries occupy safetensors shard ", sd as String,
        ", and no bound row states that shard's header and file size, so nothing bounds where those tensors end",
      ], "") as NonEmptyStr]
    ShardBoundsResolved { shard: _, file: _ } => []
    ShardBoundsDuplicated { shard: _, rows: _ } => []
  })
}

fn safetensors_shard_extent_defects(
  shards: List<SafetensorsShardFile>,
  entries: List<SafetensorsShardedEntry>,
) -> List<NonEmptyStr> {
  flat_map(safetensors_shard_bounds_resolutions(shards: shards, entries: entries), r => match r {
    ShardBoundsResolved { shard: sd, file: f } => safetensors_extent_within_payload(shard: sd, file: f, entries: entries)
    ShardBoundsDuplicated { shard: _, rows: _ } => []
    ShardBoundsAbsent { shard: _ } => []
  })
}

fn safetensors_extent_within_payload(
  shard: NonEmptyStr,
  file: SafetensorsShardFile,
  entries: List<SafetensorsShardedEntry>,
) -> List<NonEmptyStr> {
  match safetensors_shard_payload(shard: file) {
    ShardHeaderExceedsFile { path: _, declared_overhead: _, file_bytes: _ } =>
      safetensors_shard_payload_defects(shard: file)
    ShardPayloadDeclared { bytes: payload } =>
      if safetensors_shard_extent(entries: entries, shard: shard) > byte_size_count(b: payload) {
        [join([
          "safetensors shard ", shard as String, " carries tensors reaching byte ",
          to_string(safetensors_shard_extent(entries: entries, shard: shard)),
          " while the shard's own header declares a payload of only ",
          to_string(byte_size_count(b: payload)),
          " bytes; names, lengths and non-overlap all reconcile and the population still does not fit the file",
        ], "") as NonEmptyStr]
      } else {
        []
      }
  }
}

fn safetensors_shard_extent(entries: List<SafetensorsShardedEntry>, shard: NonEmptyStr) -> Nat {
  fold(
    filter(entries, se => (se.shard as String) == (shard as String)),
    init: 0,
    f: (acc, se) => nat_max(a: acc, b: se.entry.end_offset))
}

fn safetensors_population_defects(
  members: List<SafetensorsIndexMember>,
  shards: List<SafetensorsShardFile>,
  entries: List<SafetensorsShardedEntry>,
) -> List<NonEmptyStr> {
  concat(
    concat(
      if count(members) > 0 {
        []
      } else {
        ["a population reconciled against no index rows is not reconciled; an empty expectation admits anything, which is the shape a dropped read takes" as NonEmptyStr]
      },
      if count(entries) > 0 {
        []
      } else {
        ["a safetensors population with no entries is not a component; an empty list is the shape a failed scan takes when its failure was discarded" as NonEmptyStr]
      }),
    concat(
      map(
        concat(
          flat_map(entries, se => safetensors_entry_defects(e: se.entry)),
          safetensors_duplicate_defects(entries: map(entries, se => se.entry))),
        d => safetensors_entry_defect_display(d: d)),
      concat(
        map(
          safetensors_membership_defects(members: members, entries: entries),
          d => safetensors_membership_defect_display(d: d)),
        concat(
          safetensors_shard_extent_defects(shards: shards, entries: entries),
          safetensors_shard_bounds_defects(shards: shards, entries: entries)))))
}

// THE TOTAL IS ACCUMULATED IN THE UNIT CARRIER. A bare-Nat accumulator re-wrapped at the boundary is a
// second representation of what ByteSize already carries, reconciled by hand at each hop.
fn safetensors_population_total(entries: List<SafetensorsShardedEntry>) -> ByteSize {
  fold(
    entries,
    init: byte_size(count: 0),
    f: (acc, se) => measure_add(a: acc, b: safetensors_entry_span(e: se.entry)))
}

fn safetensors_shard_names(entries: List<SafetensorsShardedEntry>) -> List<NonEmptyStr> {
  fold(entries, init: [], f: (acc, se) =>
    if any(acc, n => (n as String) == (se.shard as String)) { acc } else { concat(acc, [se.shard]) })
}

// DEFECTS ARE DECIDED BEFORE OBLIGATIONS, so a population with a real defect still REFUSES even when
// its shard bounds were never supplied. Reversing the two would let a missing bound row downgrade a
// duplicate tensor subject from refused to merely incomplete -- an absorbing arm that answers with less
// than it knows, and one that would have quietly weakened every existing refusal control here.
//
// THE ONLY PRODUCER OF AN ESTABLISHED POPULATION. Membership is reconciled against the index rows
// read at the same revision, and the total is DERIVED from the entries that reconciliation admitted
// -- there is no parameter here for a size summary, so a caller cannot supply one.
fn safetensors_population_standing(
  members: List<SafetensorsIndexMember>,
  shards: List<SafetensorsShardFile>,
  closure: MembershipClosure,
  reading: SafetensorsPopulationReading,
) -> SafetensorsPopulationStanding {
  match reading {
    PopulationUnscanned { obligation: o } => PopulationIncomplete { obligation: o, partial_entries: [] }
    PopulationPartiallyScanned { entries: es, unread: u } =>
      PopulationIncomplete { obligation: u, partial_entries: es }
    PopulationScanned { entries: es } => {
      let defects = safetensors_population_defects(members: members, shards: shards, entries: es)
      if count(defects) > 0 {
        PopulationRefused { defects: defects }
      } else {
        let bounds_open = safetensors_shard_bounds_obligations(shards: shards, entries: es)
        if count(bounds_open) > 0 {
          PopulationIncomplete {
            obligation: join(map(bounds_open, o => o as String), "; ") as NonEmptyStr,
            partial_entries: es,
          }
        } else {
          PopulationEstablished {
            population: SafetensorsPopulation {
              members: es,
              declared_bytes: safetensors_population_total(entries: es),
              closure: closure,
            },
          }
        }
      }
    }
  }
}

fn safetensors_population_members(s: SafetensorsPopulationStanding) -> List<SafetensorsShardedEntry> {
  match s {
    PopulationEstablished { population: p } => p.members
    PopulationIncomplete { obligation: _, partial_entries: _ } => []
    PopulationRefused { defects: _ } => []
  }
}

fn safetensors_population_entries(s: SafetensorsPopulationStanding) -> List<SafetensorsEntry> {
  map(safetensors_population_members(s: s), se => se.entry)
}

// THE RESIDUAL TRAVELS WITH THE POPULATION. A consumer that establishes a subject over this reads
// the obligation and carries it onto its own evidence axis, so an unenumerated index shows up as an
// open question in the decision rather than as a sentence in this file.
fn safetensors_population_closure_obligations(s: SafetensorsPopulationStanding) -> List<NonEmptyStr> {
  match s {
    PopulationEstablished { population: p } => membership_closure_obligations(c: p.closure)
    PopulationIncomplete { obligation: _, partial_entries: _ } => []
    PopulationRefused { defects: _ } => []
  }
}

fn safetensors_population_declared_bytes(s: SafetensorsPopulationStanding) -> ByteSize? {
  match s {
    PopulationEstablished { population: p } => Present { value: p.declared_bytes }
    PopulationIncomplete { obligation: _, partial_entries: _ } => none
    PopulationRefused { defects: _ } => none
  }
}

// ── THE SHARD FILE: DECLARED STRUCTURE AND CRYPTOGRAPHIC BYTES ARE TWO FACTS ───────────────────
//
// header_bytes is the JSON header length the 8-byte prefix declares, so a file's total size is
// 8 + header_bytes + payload. Carrying all three lets the arithmetic be checked rather than
// asserted -- and the sha256 is over the FILE, which is a different subject from the population
// the header declares. A digest match proves the bytes are the published bytes. It does not prove
// the header's shapes describe them, and the header's shapes do not prove the bytes arrived.
//
// EVERY FIELD IS A ByteSize. A first cut typed `header_bytes` as a bare `Nat` beside two `ByteSize`
// siblings on the same record -- two representations of one quantity, which then forced
// `byte_size_count` unwrapping purely to reconcile them. The prefix length is a byte count like the
// other two and is carried as one.
//
// AND THERE IS NO STORED payload_bytes. The first cut computed it in the constructor and answered
// ZERO when the declared header exceeded the file size -- a fabricated quantity with no refusal
// anywhere behind it, so an impossible shard row read as a shard with an empty payload and the
// agreement test below compared that zero against a real population total. DESIGN section 5's
// failure arm must refuse, never widen, so the payload is a FOLD with a refusing arm rather than a
// field, and the impossible state can no longer be carried at all.
type SafetensorsShardFile sole_constructor {
  path: NonEmptyStr
  header_bytes: ByteSize
  file_bytes: ByteSize
}

fn safetensors_shard_file(path: NonEmptyStr, header_bytes: ByteSize, file_bytes: ByteSize) -> SafetensorsShardFile {
  SafetensorsShardFile { path: path, header_bytes: header_bytes, file_bytes: file_bytes }
}

// THE SOURCE THIS MODULE TRANSCRIBES, AS A VALUE RATHER THAN AS A PARENTHETICAL. Every fact in this
// file is transcribed spec -- the dtype wire names, the 8-byte little-endian length prefix, the
// data_offsets semantics -- and a first cut pointed at the source only in an annotation. DESIGN §4c is
// explicit that an annotation is never evidence a machine claim holds, because no Accepted program can
// read one, and §3 requires an extdeps module to cite the source AND declare its version.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/huggingface/safetensors"
  }
}

// THE VERSION IS UNCITED AND SAYS SO, WHICH IS THE HONEST HALF. The format is specified in that
// repository's own documentation rather than as a numbered standard, and this module was written
// against the format as described there WITHOUT a pinned spec revision. Writing a version label here
// would be an invented figure asserted as a cited one, which is the over-assertion arm of §4d. So the
// standing carries uncitedness explicitly and names what would discharge it -- the same
// CitedFigureStanding the corpus uses for every other figure whose ground is incomplete, and the same
// arm deepseek_v4_1_flash_engram_population_standing would take if its authority were absent.
data safetensors_specification_version_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "this module was written against the safetensors format as documented at the cited repository, with NO pinned spec revision recorded. A commit or release tag of huggingface/safetensors read at a known date, against which the dtype wire names, the 8-byte little-endian header-length prefix and the data_offsets semantics were checked, would replace this with CitedToAuthority and make a later divergence in the upstream format detectable rather than silent" as NonEmptyStr,
}

// THE FACTS THIS MODULE ASSERTS ABOUT THE FORMAT point at the authority above. What that citation
// establishes is the SOURCE, not the revision: the version standing is the separate fact, and keeping
// them apart is why a reader can tell that the source is known and the revision is not.
data safetensors_specification_standing: CitedFigureStanding = CitedToAuthority {
  authority: extdeps_external_authority_anchor,
}

data safetensors_header_length_prefix_bytes: ByteSize = byte_size(count: 8)

// THE TWO STANDINGS, READ AS ONE LIST OF WHAT IS STILL OWED. A consumer asking whether this module's
// spec facts are grounded gets the source citation's silence and the version's obligation from the
// same fold, so neither can be consulted without the other being available.
fn safetensors_specification_obligations() -> List<NonEmptyStr> {
  concat(
    match cited_figure_read_obligation(standing: safetensors_specification_standing) {
      Present { value: o } => [o]
      Absent => []
    },
    match cited_figure_read_obligation(standing: safetensors_specification_version_standing) {
      Present { value: o } => [o]
      Absent => []
    })
}

fn safetensors_shard_declared_overhead(header_bytes: ByteSize) -> ByteSize {
  measure_add(a: safetensors_header_length_prefix_bytes, b: header_bytes)
}

// THE PAYLOAD IS DERIVABLE OR THE SHARD IS IMPOSSIBLE, and those are two values rather than one
// number the caller has to interpret. A file smaller than its own declared prefix-plus-header is
// not a file with no tensors in it: it is a row whose two figures contradict each other, and the
// remedy is to re-read the header rather than to proceed with a zero.
type SafetensorsShardPayload
  = ShardPayloadDeclared { bytes: ByteSize }
  | ShardHeaderExceedsFile { path: NonEmptyStr, declared_overhead: ByteSize, file_bytes: ByteSize }

// THE GUARD IS NOT HAND-WRITTEN, IT IS THE SUBTRACTION'S OWN RESULT. Naturals are not closed under
// subtraction, which is why std.measure returns a coproduct rather than flooring at zero -- and this
// function's two arms ARE that coproduct's two arms. Unwrapping both operands to compare them, then
// subtracting and re-wrapping, re-derives in this module the case split the operation already makes.
fn safetensors_shard_payload(shard: SafetensorsShardFile) -> SafetensorsShardPayload {
  let overhead = safetensors_shard_declared_overhead(header_bytes: shard.header_bytes)
  match measure_sub(a: shard.file_bytes, b: overhead) {
    MeasureDifference { value: payload } => ShardPayloadDeclared { bytes: payload }
    MeasureSubtrahendExceedsMinuend => ShardHeaderExceedsFile {
      path: shard.path,
      declared_overhead: overhead,
      file_bytes: shard.file_bytes,
    }
  }
}

fn safetensors_shard_payload_defects(shard: SafetensorsShardFile) -> List<NonEmptyStr> {
  match safetensors_shard_payload(shard: shard) {
    ShardPayloadDeclared { bytes: _ } => []
    ShardHeaderExceedsFile { path: pth, declared_overhead: o, file_bytes: fb } =>
      [join([
        "safetensors shard ", pth as String, " declares an 8-byte prefix plus a header totalling ",
        to_string(byte_size_count(b: o)), " bytes inside a file of ", to_string(byte_size_count(b: fb)),
        " bytes; the two figures contradict each other and no payload size follows from them",
      ], "") as NonEmptyStr]
  }
}

// THE AGREEMENT HAS THREE ANSWERS AND NONE OF THEM IS A BARE FALSE. A shard whose payload cannot be
// derived at all is a different state from one whose derivable payload is the wrong size, and only
// the first is a defect in the shard row rather than in the join.
type SafetensorsShardAgreement
  = ShardPayloadMatchesPopulation { bytes: ByteSize }
  | ShardPayloadDisagreesWithPopulation { path: NonEmptyStr, payload_bytes: ByteSize, declared: ByteSize }
  | ShardPayloadUnderivable { path: NonEmptyStr, because: NonEmptyStr }

fn safetensors_shard_payload_agreement(shard: SafetensorsShardFile, declared: ByteSize) -> SafetensorsShardAgreement {
  match safetensors_shard_payload(shard: shard) {
    ShardHeaderExceedsFile { path: pth, declared_overhead: o, file_bytes: fb } =>
      ShardPayloadUnderivable {
        path: pth,
        because: join([
          "the declared prefix plus header is ", to_string(byte_size_count(b: o)),
          " bytes against a file of ", to_string(byte_size_count(b: fb)), " bytes",
        ], "") as NonEmptyStr,
      }
    ShardPayloadDeclared { bytes: b } =>
      if byte_size_count(b: b) == byte_size_count(b: declared) {
        ShardPayloadMatchesPopulation { bytes: b }
      } else {
        ShardPayloadDisagreesWithPopulation { path: shard.path, payload_bytes: b, declared: declared }
      }
  }
}

