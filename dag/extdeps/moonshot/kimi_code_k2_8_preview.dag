module extdeps.moonshot.kimi_code_k2_8_preview

import std.types { NonEmptyStr, String, Bool, List }
import std.measure { TokenCount, token_count }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.dissolution { unbound_dissolution }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import extdeps.external_authority {
  ExternalAuthority, ExternalModelScope, ExternalSubjectRef, FactCitation,
}
import extdeps.uri { Uri, Https }

// KIMI CODE K2.8 PREVIEW as a SERVICE RELEASE, not a local serving candidate. Kimi Code is an
// independently versioned Moonshot product; wire-compatible OpenAI/Anthropic shapes live elsewhere
// and do not become this product. No moonshot/kimi vendor module existed to inhabit.

data kimi_code_whats_new_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.kimi.com/code/docs/en/kimi-code/whats-new.html" as NonEmptyStr,
  }
}

data kimi_code_models_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.kimi.com/code/docs/en/kimi-code/models.html" as NonEmptyStr,
  }
}

data extdeps_external_authority_anchor: ExternalAuthority = kimi_code_whats_new_authority

data kimi_for_coding_wire_id: NonEmptyStr = "kimi-for-coding" as NonEmptyStr
data kimi_k3_wire_id: NonEmptyStr = "k3" as NonEmptyStr
data kimi_k3_256k_wire_id: NonEmptyStr = "k3-256k" as NonEmptyStr
data kimi_for_coding_highspeed_wire_id: NonEmptyStr = "kimi-for-coding-highspeed" as NonEmptyStr
data kimi_k28_preview_served_version_name: NonEmptyStr = "K2.8 Preview" as NonEmptyStr
data kimi_k27_code_highspeed_served_version_name: NonEmptyStr = "K2.7 Code HighSpeed" as NonEmptyStr
data kimi_k3_served_version_name: NonEmptyStr = "K3" as NonEmptyStr

type KimiCodeAliasEnd
  = AliasEndNotPublished
  | AliasEndPublished { on: NonEmptyStr }

type KimiCodeEffectiveFrom
  = CitedAvailableOn { on: NonEmptyStr }
  | StartDateNotPublishedOnCitedAuthorities { read_obligation: NonEmptyStr }

type KimiCodeAliasAssignment {
  model_id: NonEmptyStr
  served_version: NonEmptyStr
  effective_from: KimiCodeEffectiveFrom
  effective_until: KimiCodeAliasEnd
  authority: ExternalAuthority
}

// THE WIRE ID IS STABLE; THE SERVED VERSION IS TIME-BOUNDED. Overwriting a timeless "current
// version" row would collapse two epochs onto one name. K2.8 Preview is the 2026-09-11
// rollout; the cited docs do not publish an until date.
data kimi_for_coding_k28_preview_assignment: KimiCodeAliasAssignment = KimiCodeAliasAssignment {
  model_id: kimi_for_coding_wire_id,
  served_version: kimi_k28_preview_served_version_name,
  effective_from: CitedAvailableOn { on: "2026-09-11" as NonEmptyStr },
  effective_until: AliasEndNotPublished,
  authority: kimi_code_whats_new_authority,
}

// HighSpeed "is now available" is the v0.24.0 whats-new heading dated July 14, 2026 — not the
// 2026-09-11 catalog observation, and not an uncited July 9.
data kimi_for_coding_highspeed_assignment: KimiCodeAliasAssignment = KimiCodeAliasAssignment {
  model_id: kimi_for_coding_highspeed_wire_id,
  served_version: kimi_k27_code_highspeed_served_version_name,
  effective_from: CitedAvailableOn { on: "2026-07-14" as NonEmptyStr },
  effective_until: AliasEndNotPublished,
  authority: kimi_code_whats_new_authority,
}

data kimi_k3_assignment: KimiCodeAliasAssignment = KimiCodeAliasAssignment {
  model_id: kimi_k3_wire_id,
  served_version: kimi_k3_served_version_name,
  effective_from: CitedAvailableOn { on: "2026-07-16" as NonEmptyStr },
  effective_until: AliasEndNotPublished,
  authority: kimi_code_whats_new_authority,
}

data kimi_k3_256k_assignment: KimiCodeAliasAssignment = KimiCodeAliasAssignment {
  model_id: kimi_k3_256k_wire_id,
  served_version: kimi_k3_served_version_name,
  effective_from: StartDateNotPublishedOnCitedAuthorities {
    read_obligation: "whats-new.html and models.html list k3-256k but do not publish a first-available date" as NonEmptyStr,
  },
  effective_until: AliasEndNotPublished,
  authority: kimi_code_models_authority,
}

data kimi_code_catalog_observed_as_of: NonEmptyStr = "2026-09-11" as NonEmptyStr

data kimi_for_coding_k28_preview_assignment_citation: FactCitation = FactCitation {
  fact: DeclarationRef {
    module_path: "extdeps.moonshot.kimi_code_k2_8_preview" as NonEmptyStr,
    decl_name: "kimi_for_coding_k28_preview_assignment" as NonEmptyStr,
    field: WholeDeclaration,
  },
  authority: kimi_code_whats_new_authority,
}

type KimiCodeRequestId
  = KimiForCoding
  | KimiK3
  | KimiK3_256k
  | KimiForCodingHighspeed

fn kimi_code_request_id_wire(id: KimiCodeRequestId) -> NonEmptyStr {
  match id {
    KimiForCoding => kimi_for_coding_wire_id
    KimiK3 => kimi_k3_wire_id
    KimiK3_256k => kimi_k3_256k_wire_id
    KimiForCodingHighspeed => kimi_for_coding_highspeed_wire_id
  }
}

data kimi_code_request_id_wires: List<NonEmptyStr> = [
  kimi_code_request_id_wire(id: KimiForCoding),
  kimi_code_request_id_wire(id: KimiK3),
  kimi_code_request_id_wire(id: KimiK3_256k),
  kimi_code_request_id_wire(id: KimiForCodingHighspeed),
]

fn kimi_code_is_request_model_id(spelling: NonEmptyStr) -> Bool {
  kimi_code_request_id_wires |> any(w => (w as String) == (spelling as String))
}

type KimiK28ThinkingEffort
  = KimiK28EffortLow
  | KimiK28EffortHigh
  | KimiK28EffortMax

fn kimi_k28_thinking_effort_wire(effort: KimiK28ThinkingEffort) -> NonEmptyStr {
  match effort {
    KimiK28EffortLow => "low" as NonEmptyStr
    KimiK28EffortHigh => "high" as NonEmptyStr
    KimiK28EffortMax => "max" as NonEmptyStr
  }
}

data kimi_k28_thinking_effort_wires: List<NonEmptyStr> = [
  kimi_k28_thinking_effort_wire(effort: KimiK28EffortLow),
  kimi_k28_thinking_effort_wire(effort: KimiK28EffortHigh),
  kimi_k28_thinking_effort_wire(effort: KimiK28EffortMax),
]

data kimi_k28_default_thinking_effort: KimiK28ThinkingEffort = KimiK28EffortMax

type KimiCodeThinkingControl
  = KimiThinkingOn { effort: KimiK28ThinkingEffort }
  | KimiThinkingOff
  | KimiHighSpeedThinkingOn

type KimiCodeServedVersion
  = ServedK28Preview
  | ServedK3
  | ServedK27CodeHighspeed

fn kimi_code_served_version_name(v: KimiCodeServedVersion) -> NonEmptyStr {
  match v {
    ServedK28Preview => kimi_k28_preview_served_version_name
    ServedK3 => kimi_k3_served_version_name
    ServedK27CodeHighspeed => kimi_k27_code_highspeed_served_version_name
  }
}

type KimiCodeThinkingOnPolicy
  = ThinkingOnWithK28Effort
  | HighSpeedThinkingOnOnly

type KimiCodeThinkingOffPolicy
  = ThinkingOffServes { version: KimiCodeServedVersion }
  | ThinkingOffNotDocumented

type KimiCodeCatalogRow {
  request_id: KimiCodeRequestId
  assignment: KimiCodeAliasAssignment
  served_when_thinking_on: KimiCodeServedVersion
  thinking_on: KimiCodeThinkingOnPolicy
  thinking_off: KimiCodeThinkingOffPolicy
}

type KimiCodeCatalogEpoch {
  observed_as_of: NonEmptyStr
  kimi_for_coding: KimiCodeCatalogRow
  kimi_k3: KimiCodeCatalogRow
  kimi_k3_256k: KimiCodeCatalogRow
  kimi_for_coding_highspeed: KimiCodeCatalogRow
}

data kimi_code_catalog_as_of_2026_09_11: KimiCodeCatalogEpoch = KimiCodeCatalogEpoch {
  observed_as_of: kimi_code_catalog_observed_as_of,
  kimi_for_coding: KimiCodeCatalogRow {
    request_id: KimiForCoding,
    assignment: kimi_for_coding_k28_preview_assignment,
    served_when_thinking_on: ServedK28Preview,
    thinking_on: ThinkingOnWithK28Effort,
    thinking_off: ThinkingOffServes { version: ServedK28Preview },
  },
  kimi_k3: KimiCodeCatalogRow {
    request_id: KimiK3,
    assignment: kimi_k3_assignment,
    served_when_thinking_on: ServedK3,
    thinking_on: ThinkingOnWithK28Effort,
    thinking_off: ThinkingOffServes { version: ServedK28Preview },
  },
  kimi_k3_256k: KimiCodeCatalogRow {
    request_id: KimiK3_256k,
    assignment: kimi_k3_256k_assignment,
    served_when_thinking_on: ServedK3,
    thinking_on: ThinkingOnWithK28Effort,
    thinking_off: ThinkingOffServes { version: ServedK28Preview },
  },
  kimi_for_coding_highspeed: KimiCodeCatalogRow {
    request_id: KimiForCodingHighspeed,
    assignment: kimi_for_coding_highspeed_assignment,
    served_when_thinking_on: ServedK27CodeHighspeed,
    thinking_on: HighSpeedThinkingOnOnly,
    thinking_off: ThinkingOffNotDocumented,
  },
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.moonshot.kimi_code_k2_8_preview" as NonEmptyStr,
      decl_name: "kimi_code_catalog_as_of_2026_09_11" as NonEmptyStr,
      field: WholeDeclaration,
    }
  },
  first_citation: kimi_code_whats_new_authority,
  further_citations: [kimi_code_models_authority],
}

fn kimi_code_catalog_row(epoch: KimiCodeCatalogEpoch, requested: KimiCodeRequestId) -> KimiCodeCatalogRow {
  match requested {
    KimiForCoding => epoch.kimi_for_coding
    KimiK3 => epoch.kimi_k3
    KimiK3_256k => epoch.kimi_k3_256k
    KimiForCodingHighspeed => epoch.kimi_for_coding_highspeed
  }
}

type KimiCodeRoute {
  requested_id: KimiCodeRequestId
  served_version: KimiCodeServedVersion
  served_thinking: KimiCodeThinkingControl
}

type KimiCodeRouteResult
  = KimiCodeRouteResolved { route: KimiCodeRoute }
  | KimiCodeThinkingControlNotDocumented {
      requested_id: KimiCodeRequestId
      thinking: KimiCodeThinkingControl
    }

// ROUTING CONSUMES THE CATALOG EPOCH. Thinking-off for the K3 family and K2.8 Preview is served as
// K2.8 Preview; the request id is not rewritten. HighSpeed is Thinking:ON only — effort levels and
// thinking-off are not documented for that id, so those combinations refuse rather than ignore the control.
fn kimi_code_route(requested: KimiCodeRequestId, thinking: KimiCodeThinkingControl) -> KimiCodeRouteResult {
  let row = kimi_code_catalog_row(epoch: kimi_code_catalog_as_of_2026_09_11, requested: requested)
  match thinking {
    KimiThinkingOff => match row.thinking_off {
      ThinkingOffServes { version: v } => KimiCodeRouteResolved {
        route: KimiCodeRoute {
          requested_id: requested,
          served_version: v,
          served_thinking: thinking,
        },
      }
      ThinkingOffNotDocumented => KimiCodeThinkingControlNotDocumented {
        requested_id: requested,
        thinking: thinking,
      }
    }
    KimiThinkingOn { effort: _ } => match row.thinking_on {
      ThinkingOnWithK28Effort => KimiCodeRouteResolved {
        route: KimiCodeRoute {
          requested_id: requested,
          served_version: row.served_when_thinking_on,
          served_thinking: thinking,
        },
      }
      HighSpeedThinkingOnOnly => KimiCodeThinkingControlNotDocumented {
        requested_id: requested,
        thinking: thinking,
      }
    }
    KimiHighSpeedThinkingOn => match row.thinking_on {
      HighSpeedThinkingOnOnly => KimiCodeRouteResolved {
        route: KimiCodeRoute {
          requested_id: requested,
          served_version: row.served_when_thinking_on,
          served_thinking: thinking,
        },
      }
      ThinkingOnWithK28Effort => KimiCodeThinkingControlNotDocumented {
        requested_id: requested,
        thinking: thinking,
      }
    }
  }
}

data kimi_k28_declared_context_ceiling: TokenCount = token_count(count: 1048576)

data kimi_k28_context_ceiling_citation: FactCitation = FactCitation {
  fact: DeclarationRef {
    module_path: "extdeps.moonshot.kimi_code_k2_8_preview" as NonEmptyStr,
    decl_name: "kimi_k28_declared_context_ceiling" as NonEmptyStr,
    field: WholeDeclaration,
  },
  authority: kimi_code_models_authority,
}

type KimiVendorMeasurementStanding
  = MeasurementUnestablished
  | MeasurementEstablished { instrument: NonEmptyStr }

type VendorCharacterization {
  claim: NonEmptyStr
  measurement: KimiVendorMeasurementStanding
}

data kimi_k28_vendor_characterization_performance_close_to_k3: VendorCharacterization = VendorCharacterization {
  claim: "Performance close to K3" as NonEmptyStr,
  measurement: MeasurementUnestablished,
}

data kimi_k28_vendor_characterization_more_efficient_thinking: VendorCharacterization = VendorCharacterization {
  claim: "more efficient thinking" as NonEmptyStr,
  measurement: MeasurementUnestablished,
}

type KimiQualityReadingConstruction
  = KimiQualityReadingRefusedUnestablishedMeasurement { characterization: VendorCharacterization }
  | KimiQualityReadingRefusedVendorCharacterization { characterization: VendorCharacterization }

fn kimi_vendor_characterization_as_quality_reading(
  characterization: VendorCharacterization,
) -> KimiQualityReadingConstruction {
  match characterization.measurement {
    MeasurementUnestablished => KimiQualityReadingRefusedUnestablishedMeasurement {
      characterization: characterization,
    }
    MeasurementEstablished { instrument: _ } => KimiQualityReadingRefusedVendorCharacterization {
      characterization: characterization,
    }
  }
}

fn kimi_code_k28_preview_fact(decl_name: NonEmptyStr) -> DeclarationRef {
  DeclarationRef {
    module_path: "extdeps.moonshot.kimi_code_k2_8_preview" as NonEmptyStr,
    decl_name: decl_name,
    field: WholeDeclaration,
  }
}

data kimi_code_k28_preview_provider_integration_frontier: List<FrontierRow> = [
  frontier_row_decl(
    ref: kimi_code_k28_preview_fact(decl_name: "kimi_code_route" as NonEmptyStr),
    reason: "KIMI28-1 provider integration binds routing; this change does not",
    dissolution: unbound_dissolution(description: "KIMI28-1 provider integration consumes kimi_code_route on a live request path"),
  ),
  frontier_row_decl(
    ref: kimi_code_k28_preview_fact(decl_name: "kimi_for_coding_k28_preview_assignment" as NonEmptyStr),
    reason: "effective_from is a cited Gregorian day carried as NonEmptyStr; v2.std.datetime CalendarDate has no corpus constructor (zero CalendarDate constructors in use; pin.dag pin_currency_gap dissolve names the same gap)",
    dissolution: unbound_dissolution(description: "this assignment's effective_from is a v2.std.datetime CalendarDate constructed from the cited YMD 2026-09-11"),
  ),
]
