module extdeps.wiwynn.sv328r.specifications

import std.types { String, NonEmptyStr, Bool }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.measure {
  Bandwidth, Gram, Hertz, MegatransfersPerSecond, Micrometer, Millimeter, RackUnit,
  bandwidth, gram, gram_count, hertz, megatransfers_per_second, micrometer, micrometer_count,
  millimeter, rack_unit,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, CitedFigureStanding, TranscribedUncited }
import extdeps.standards.nic_attachment { OnboardControllerUnstated, OnboardNetworkController }
import extdeps.wiwynn.sv328r.subject {
  WiwynnSv328rProduct, sv328r_datasheet_authority, wiwynn_sv328r_product,
}

data extdeps_external_authority_anchor: ExternalAuthority = sv328r_datasheet_authority

data sv328r_specifications_subject: WiwynnSv328rProduct = wiwynn_sv328r_product

// PHYSICAL AND PACKAGING ROW OF THE 2021-11-04 DATASHEET. Depth is 770.2 mm, carried as
// micrometres so the tenth of a millimetre is exact. Weight is printed 14.47 kg = 14470 g.
// The sheet does not say whether that mass includes processors, PSUs, or rails.
type Sv328rChassisDimensions {
  height: Millimeter
  width: Millimeter
  depth: Micrometer
  rack_units: RackUnit
}

data sv328r_dimensions: Sv328rChassisDimensions = Sv328rChassisDimensions {
  height: millimeter(count: 87),
  width: millimeter(count: 438),
  depth: micrometer(count: 770200),
  rack_units: rack_unit(count: 2),
}

data sv328r_stated_weight: Gram = gram(count: 14470)

type Sv328rCooling {
  fan_count: Nat
  frame_width: Millimeter
  frame_thickness: Millimeter
}

data sv328r_cooling: Sv328rCooling = Sv328rCooling {
  fan_count: 6,
  frame_width: millimeter(count: 60),
  frame_thickness: millimeter(count: 56),
}

type Sv328rPowerSupply {
  psu_count: Nat
  form_factor_label: NonEmptyStr
  redundant: Bool
}

data sv328r_power: Sv328rPowerSupply = Sv328rPowerSupply {
  psu_count: 2,
  form_factor_label: "CRPS",
  redundant: true,
}

data sv328r_crps_ac_inlet: CitedFigureStanding = TranscribedUncited {
  read_obligation: "The SV328R datasheet names 2x CRPS form factor, redundant, and does not name IEC 60320 C14 vs C20, a 120 V vs 200-240 V rating, or a shipped cord. Discriminator: a photograph of the fitted PSU inlet on a unit of this class, or a PSU OPN whose vendor sheet names the inlet.",
}

data sv328r_bmc_manageability_network: OnboardNetworkController = OnboardNetworkController {
  controller: OnboardControllerUnstated {
    read_obligation: "The SV328R datasheet names One GbE Dedicated BMC Port and iKVM over IP. It does not name a PHY or MAC controller OPN. Discriminator: a board silkscreen, FRU, or lspci/ethtool census of a unit of this class.",
  },
  port_count: 1,
  per_port_bandwidth: bandwidth(count: 1000000000),
  purpose: "BMC manageability",
}

type Sv328rProcessorConfiguration {
  socket_count: Nat
  cores_per_socket_stated_max: Nat
  architecture_label: NonEmptyStr
  max_core_clock: Hertz
}

data sv328r_processors: Sv328rProcessorConfiguration = Sv328rProcessorConfiguration {
  socket_count: 2,
  cores_per_socket_stated_max: 80,
  architecture_label: "Ampere Altra, 64-bit Arm",
  max_core_clock: hertz(count: 3000000000),
}

type Sv328rMemoryConfiguration {
  dimm_slots_total: Nat
  dimms_per_processor: Nat
  channels_per_processor: Nat
  max_data_rate: MegatransfersPerSecond
  module_class_label: NonEmptyStr
}

data sv328r_memory: Sv328rMemoryConfiguration = Sv328rMemoryConfiguration {
  dimm_slots_total: 32,
  dimms_per_processor: 16,
  channels_per_processor: 8,
  max_data_rate: megatransfers_per_second(count: 3200),
  module_class_label: "RDIMM",
}

type Sv328rStorageBays {
  front_u2_bays: Nat
  onboard_m2_nvme_slots: Nat
}

data sv328r_storage: Sv328rStorageBays = Sv328rStorageBays {
  front_u2_bays: 24,
  onboard_m2_nvme_slots: 2,
}

type Sv328rOcpSlotStanding
  = OcpNic30SffSlotPresent { occupancy_note: NonEmptyStr }

data sv328r_ocp_slot: Sv328rOcpSlotStanding = OcpNic30SffSlotPresent {
  occupancy_note: "Datasheet states One PCI-E 4.0 x16 OCP NIC 3.0 (small form factor). It does not state a bundled card. Occupancy of that slot, or of a PCIe riser NIC, is a per-unit observation.",
}

data sv328r_specifications_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.wiwynn.sv328r.specifications",
      decl_name: "sv328r_dimensions",
      field: WholeDeclaration,
    }
  },
  first_citation: sv328r_datasheet_authority,
  further_citations: [],
}

data extdeps_model_scope: ExternalModelScope = sv328r_specifications_model_scope

fn sv328r_weight_grams() -> Nat {
  gram_count(g: sv328r_stated_weight)
}

fn sv328r_depth_micrometers() -> Nat {
  micrometer_count(m: sv328r_dimensions.depth)
}
