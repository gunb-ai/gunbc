module extdeps.storage.te_m2_ngff_connector


// Application Specification 114-115006, "67 Positions 0.5 Pitch M.2(NGFF) MINICARD", Rev C dated
// 04JAN23, read 2026-08-14. The fetched file is the Rev B delivery URL and its content is Rev C;
// the revision recorded below is the one printed on the sheets.
data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.te.com/commerce/DocumentDelivery/DDEController?Action=showdoc&DocId=Specification+Or+Standard%7F114-115006%7FB%7Fpdf%7FEnglish%7FENG_SS_114-115006_B_114-115006_REV_B.pdf%7F2199119-3"
  }
}

data te_m2_ngff_note: String = "THIS ROW IS A CONNECTOR FAMILY, NOT AN ORDERING SELECTION, AND THE DIFFERENCE IS WHAT THE READ DOCUMENT SUPPORTS. The specification establishes 67 positions on 0.50 mm centres, surface-mount solder tails onto pads, and the stack-height and mid-plane variants it governs. It does NOT say which ordering part number is M-keyed: the key is a property of the individual part, carried on the per-part customer drawing, and this row carries no such drawing. SO THERE IS NO KEY FIELD HERE. An M2Key field would have had to be filled, and filling it from the design intent rather than from a document is precisely how an intent becomes indistinguishable from a fact. The M-key decision is real and was made at the product layer; what is missing is the part number that satisfies it. THE BOARD PATTERN IS OUTSTANDING, AND WHAT IS RECORDED ABOUT IT IS A FACT ABOUT THE DOCUMENT RATHER THAN ABOUT ANY READER: the specification publishes a recommended PCB layout as Figures 2 and 3, and defers to the per-part customer drawing where the two conflict, so the pattern exists and is published and is simply not transcribed here. Which fetches on which day did or did not yield text is an observation this repository made about its own tooling, and it belongs in the observing layer downstream rather than inside an upstream module."

type M2ConnectorCatalogRow {
  specification_number: std.types.NonEmptyStr
  specification_revision: std.types.NonEmptyStr
  vendor: Vendor<extdeps.hardware.Hardware>
  position_count: std.nat.Nat
  contact_pitch: std.measure.Micrometer
  attachment: extdeps.land_pattern.types.BoardAttachmentStyle
  board_pattern: extdeps.land_pattern.types.SurfaceMountPatternStanding
}

data m2_ngff_minicard_67_position: M2ConnectorCatalogRow = M2ConnectorCatalogRow {
  specification_number: "114-115006",
  specification_revision: "C",
  vendor: extdeps.vendor.tyco_electronics_amp_kk.tyco_electronics_amp_kk,
  position_count: 67,
  contact_pitch: micrometer(count: 500),
  attachment: SurfaceMountTerminals,
  board_pattern: extdeps.land_pattern.types.SurfaceMountPatternNotEstablished {
    what_is_missing: "the recommended PCB layout that application specification 114-115006 publishes as Figures 2 and 3, and which the per-part customer drawing governs where the two conflict. An orderable M-keyed part number is owed with it, since the key is a per-part fact this specification does not carry",
  },
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.storage.te_m2_ngff_connector",
      decl_name: "m2_ngff_minicard_67_position",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
