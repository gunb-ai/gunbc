module extdeps.storage.nbd

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "manpages.debian.org/bookworm/nbd-server/nbd-server.5.en.html",
  }
}

type NbdExport {
  export_name: NonEmptyStr
  backing_path: NonEmptyStr
  port: Port
  read_only: Bool
}

// NbdExport is the typed authority; this renders it into nbd-server's INI config-file
// format — a rendered artifact like grub_config_render, not shell — with the
// section/key layout joined inline.
//
// It dissolves when a shared ini/config-file grammar (the emit direction of
// extdeps.languages) renders NbdExport structurally, at which point the inline join
// `nbd_server_config_text` is deleted rather than edited. The trigger names that
// declaration, so the obligation is answered by the corpus rather than by reading this
// paragraph.
data nbd_server_config_render_dissolution_trigger: DissolutionCondition = retires_dissolution(
  ref: decl_ref(module_path: "extdeps.storage.nbd", decl_name: "nbd_server_config_text")
)

fn nbd_bool_word(b: Bool) -> String {
  if b { "true" } else { "false" }
}

fn nbd_server_config_text(export: NbdExport) -> String {
  join(
    [
      "[generic]",
      join(["    port = ", to_string(export.port)], ""),
      "    allowlist = false",
      join(["[", export.export_name as String, "]"], ""),
      join(["    exportname = ", export.backing_path as String], ""),
      join(["    readonly = ", nbd_bool_word(b: export.read_only)], ""),
      "",
    ],
    "\n",
  )
}

// PATH-RESOLVED, AND THE TWO PROGRAMS RUN IN DIFFERENT PLACES, which is worth stating because a
// single "the BMC" would be wrong about half of it: nbd-server runs on the host serving the image
// and nbd-client attaches on the BMC (gunbc.bmc_virtual_media renders both to text for an operator).
// This repository has read neither filesystem. An absolute path for either would be a guess whose
// failure mode is a hard spawn error on hardware nobody is watching, so the spelling stays exactly
// what the call sites used before this conversion and the not-knowing stays visible.
data nbd_server_program: NonEmptyStr = "nbd-server"
data nbd_client_program: NonEmptyStr = "nbd-client"

fn nbd_server_command(config_path: NonEmptyStr) -> ArgvCommand {
  argv_command(program: nbd_server_program, arguments: ["-C", config_path as String])
}

type NbdClientAttach {
  server: NonEmptyStr
  port: Port
  export_name: NonEmptyStr
  device: NonEmptyStr
}

fn nbd_client_attach_command(attach: NbdClientAttach) -> ArgvCommand {
  argv_command(
    program: nbd_client_program,
    arguments: [
      "-N", attach.export_name as String,
      attach.server as String,
      to_string(attach.port),
      attach.device as String,
    ],
  )
}

fn nbd_client_disconnect_command(device: NonEmptyStr) -> ArgvCommand {
  argv_command(program: nbd_client_program, arguments: ["-d", device as String])
}
