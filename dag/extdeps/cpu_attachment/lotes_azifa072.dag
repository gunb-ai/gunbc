module extdeps.cpu_attachment.lotes_azifa072

import std.types { Bool, List, NonEmptyStr, String }
import std.integer { Int }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, File, Https }
import extdeps.vendor.lotes { lotes }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }

// THE SOCKET BODY, WHICH IS A DIFFERENT PART FROM THE RETENTION ASSEMBLY AND HAS ITS OWN
// AUTHORITY. extdeps.cpu_attachment.ilm4926 carries the DESIGNATION -- what ILM4926 names, and
// how strongly each publisher attests it -- and resolved one constituent, the ILM-and-backplate
// assembly AZIF0222. This module is a second, independently versioned Lotes product: the item
// that receives the processor and solders to the board. Two orderable parts from one vendor are
// two subjects, not one (DESIGN section 3, external upstream decomposition), so a revision of
// this drawing must not require editing the designation module.
//
// WHY IT LANDS HERE RATHER THAN INSIDE ilm4926: that module's whole content is a designation
// whose referent no cited document fixed. Folding a resolved part into it would make the
// unresolved-referent question look answered by the part's arrival, and it is not -- what the
// four-letter designator EXPANDS to is still unattested. A part number resolves procurement; it
// does not retroactively expand an initialism.
data azifa072_drawing_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: File
    locator: "docs/extdeps/lotes_azifa072/GAP-AZIFA072-P001CCS_2_20250807.pdf"
  }
}

// THE ANCHOR IS A BINDING, NOT A SECOND URI. extdeps.cpu_attachment.ilm4926 does the same thing
// with the Ampere datasheet locators: the conventional anchor name points at the declaration that
// already holds the authority, so the locator is typed once and a consumer that wants to name the
// drawing specifically has a name for it that does not collide across modules.
data extdeps_external_authority_anchor: ExternalAuthority = azifa072_drawing_authority

// THE DRAWING IS COMMITTED, AND THAT IS WHY THE CITATION IS A FILE URI. It arrived by direct
// vendor correspondence rather than from a catalogue page, so there is no public locator to
// point at; a citation naming a document only this repository's authors have seen is not a
// citation. Committing the bytes is what makes the reference resolvable by a later reader, and
// the absence of any confidentiality marking is what makes committing them permissible.
data lotes_correspondence_note: String = "Drawing supplied by Lotes in direct response to a request for the socket-body part that mates with AZIF0222 and its recommended PCB land pattern -- the public route recorded in extdeps.cpu_attachment.ilm4926 lga4926_land_pattern_public_route. Not access-gated and carrying no confidentiality marking, so unlike the Ampere Customer Connect route its content is carriable in a public repository."

data lotes_catalogue_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.lotes.cc/en/about.php"
  }
}

// DOCUMENT IDENTITY IS CARRIED, NOT SUMMARISED. A drawing is only an authority for the revision
// it is; a geometry fact read off revision 2 is not a fact about revision 3, and a reader who
// finds a newer PDF needs enough here to tell whether this module's numbers still stand.
type CustomerDrawing {
  drawing_number: NonEmptyStr
  part_number: NonEmptyStr
  title: NonEmptyStr
  revision: NonEmptyStr
  engineering_change_notice: NonEmptyStr
  sheet_count: Int
  authority: ExternalAuthority
}

data azifa072_drawing: CustomerDrawing = CustomerDrawing {
  drawing_number: "GAP-AZIFA072",
  part_number: "AZIFA072-P001CCS",
  title: "LGA4926 SOCKET",
  revision: "2",
  engineering_change_notice: "N230045, 04/10'2023",
  sheet_count: 5,
  authority: azifa072_drawing_authority,
}

data azifa072_socket_body_vendor: Vendor<Hardware> = lotes

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cpu_attachment.lotes_azifa072",
      decl_name: "azifa072_drawing",
      field: WholeDeclaration
    }
  },
  first_citation: azifa072_drawing_authority,
  further_citations: [lotes_catalogue_authority]
}

// ================= THE LAND PATTERN =================
//
// EVERY FIELD BELOW IS A DRAWING FACT OR A CROSS-CHECKED EXTRACTION, AND THE TWO ARE DIFFERENT
// EPISTEMIC STATES. A callout is what the vendor wrote; an extraction is what this repository
// measured off the vector content. They are separated because their failure modes differ -- a
// callout can be misread, an extraction can be mis-scaled -- and because a reader deciding
// whether to trust a number needs to know which kind it is. Where both exist and agree, that
// agreement is itself recorded rather than collapsed into one unlabelled number.
type GeometryProvenance
  = VendorCallout { sheet: Int, wording: NonEmptyStr }
  | ExtractedFromDrawingVectors { method: NonEmptyStr }
  | CalloutConfirmedByExtraction { sheet: Int, wording: NonEmptyStr, agreement: NonEmptyStr }

// THE LATTICE IS CARRIED AS PARAMETERS, NOT AS 4,926 ROWS. The array is generated by a staggered
// lattice with voids; storing every centre in this module would be storing a derivable fact
// 4,926 times (DESIGN section 2). The positions ARE committed, as a CSV beside the drawing, because
// the voids are not derivable from the parameters -- but the CSV is a derived artifact of the
// drawing, not a second authority for the pitch.
type StaggeredLattice {
  column_pitch_um: Int
  row_pitch_um: Int
  row_stagger_um: Int
  nearest_neighbour_um: Int
}

// MICROMETRES, BECAUSE THE PITCH IS EXACT AND A DECIMAL IS NOT. 1.000 mm and 0.870 mm are exact
// vendor quantities; carrying them as Int micrometres makes the exactness structural rather than
// dependent on how a float prints.
data azifa072_lattice: StaggeredLattice = StaggeredLattice {
  column_pitch_um: 1000,
  row_pitch_um: 870,
  row_stagger_um: 500,
  nearest_neighbour_um: 1000,
}

data azifa072_lattice_provenance: GeometryProvenance = ExtractedFromDrawingVectors {
  method: "sheet 3 pad view, per-row column-index fit over the drawn pad centres; scale fixed by setting the within-row pitch to 1.000 mm and confirmed independently against the sheet 4 detail circle, which measures 0.4599 mm at its stated 80:1 against a 0.46 callout",
}

type PadGeometry {
  pad_count: Int
  pad_diameter_um: Int
  pad_diameter_tolerance_um: Int
  array_extent_x_um: Int
  array_extent_y_um: Int
  row_count: Int
}

data azifa072_pad_geometry: PadGeometry = PadGeometry {
  pad_count: 4926,
  pad_diameter_um: 460,
  pad_diameter_tolerance_um: 50,
  array_extent_x_um: 63449,
  array_extent_y_um: 75470,
  row_count: 84,
}

data azifa072_pad_count_provenance: GeometryProvenance = CalloutConfirmedByExtraction {
  sheet: 3,
  wording: "4926 X Ø0.46 ±0.05 PCB PADS",
  agreement: "the sheet 3 pad view yields exactly 4926 drawn pad elements after eleven off-block strays are dropped; the callout count and the drawn count were obtained independently and match exactly",
}

data azifa072_pad_positions_artifact: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: File
    locator: "docs/extdeps/lotes_azifa072/lga4926_pcb_pads.csv"
  }
}

// THE INTERIOR VOIDS ARE WHY THE CSV EXISTS. A lattice plus an outline does not reproduce this
// array: filling the perimeter the 3D model carries gives 5,285 positions against an actual
// 4,926, so 359 interior positions are depopulated by a pattern no parameter here encodes.
data azifa072_interior_voids_note: String = "The array is not a filled lattice. A naive fill of the outline the STEP solid carries gives 5285 positions against the drawing's 4926, so 359 interior positions are depopulated -- including a central void roughly 13.9 mm wide by 25 mm tall and a 4.13 mm gap splitting the array into two banks of 42 rows whose X phases differ. Those voids are recoverable only from the drawing's own vector content, which is why the extracted positions are committed as an artifact rather than regenerated from azifa072_lattice."

type SolderTermination {
  ball_diameter_before_smt_um: Int
  ball_centre_height_before_smt_um: Int
}

data azifa072_termination: SolderTermination = SolderTermination {
  ball_diameter_before_smt_um: 520,
  ball_centre_height_before_smt_um: 260,
}

data azifa072_termination_provenance: GeometryProvenance = CalloutConfirmedByExtraction {
  sheet: 2,
  wording: "4926 X Ø0.52 SOLDER BALLS BEFORE SMT",
  agreement: "the STEP solid models 650 spherical faces at radius exactly 0.26, so the callout diameter and the modelled radius agree without either being read from the other",
}

// ================= OUTLINE AND KEEPOUT =================
//
// THE WIDEST PLANE IS ASYMMETRIC AND A KEEPOUT TAKEN FROM THE HOUSING OUTLINE IS WRONG. The body
// is symmetric about the pad-array centre; the plane at +2.38 mm is not, reaching 5.118 mm
// further on +X than on -X. That protrusion is the drawing's 2X FINGER ACCESS -- the actuation
// side -- and it is the single measurement most likely to be missed, because every other outline
// on the part is symmetric and invites the assumption.
type SocketOutline {
  housing_bottom_x_um: Int
  housing_bottom_y_um: Int
  housing_top_x_um: Int
  housing_top_y_um: Int
  widest_plane_x_um: Int
  widest_plane_y_um: Int
  widest_plane_height_um: Int
  asymmetric_protrusion_plus_x_um: Int
  height_above_pcb_before_smt_um: Int
}

data azifa072_outline: SocketOutline = SocketOutline {
  housing_bottom_x_um: 70900,
  housing_bottom_y_um: 80900,
  housing_top_x_um: 72300,
  housing_top_y_um: 82300,
  widest_plane_x_um: 77418,
  widest_plane_y_um: 82300,
  widest_plane_height_um: 2380,
  asymmetric_protrusion_plus_x_um: 5118,
  height_above_pcb_before_smt_um: 4680,
}

data azifa072_outline_provenance: GeometryProvenance = ExtractedFromDrawingVectors {
  method: "STEP solid AZIFA072_B_220208(LGA4926 SKT)-1, planar point extents at each Z band, expressed relative to the PCB pad plane taken as the solder-ball tangent before SMT",
}

// ================= WHAT THIS DRAWING DOES NOT ESTABLISH =================
//
// NAMED HERE RATHER THAN LEFT TO BE REDISCOVERED, and typed rather than written as prose, because
// a footprint release has to be able to ASK whether these are closed. A gap recorded only in a
// README is a gap a generator cannot consult.
type LandPatternGap
  = StencilApertureUnread { reason: NonEmptyStr }
  | PinOneCornerUnlocated { reason: NonEmptyStr }
  | SolderMaskOpeningUnidentified { reason: NonEmptyStr }

data azifa072_open_gaps: List<LandPatternGap> = [
  StencilApertureUnread {
    reason: "sheet 4 carries the STENCIL APERTURE detail at 80:1, but its dimension values are drawn as vector outlines rather than text and the only closed shape recoverable at that scale is the Ø0.46 pad itself. The aperture must be read off the drawing by eye before paste is released.",
  },
  PinOneCornerUnlocated {
    reason: "sheet 2 carries MARKING FOR Pin1 and the array is demonstrably not symmetric -- the two banks depopulate differently -- so the orientation is recoverable, but no extraction has established WHICH corner is A1 and a guessed A1 rotates the whole board.",
  },
  SolderMaskOpeningUnidentified {
    reason: "sheet 3's second view draws the same 4926-position lattice with a larger circle measuring about 0.73 to 0.77 mm. No recovered callout attaches a name to it, so whether it is the mask opening, the contact-tip footprint or a keepout is unestablished.",
  },
]

fn land_pattern_gap_count() -> Int {
  count(azifa072_open_gaps)
}

// A FOOTPRINT MAY NOT EMIT WHILE ANY GAP STANDS. This is the predicate a footprint emitter
// consults. It is deliberately not a warning: a paste layer released without its aperture and a
// board rotated by a guessed A1 are both unrecoverable at fabrication, so the failure arm refuses
// rather than proceeding with a default (DESIGN section 5).
fn azifa072_footprint_may_emit() -> Bool {
  land_pattern_gap_count() == 0
}
