module extdeps.provisioning.ubuntu_seeded_install_media_remaster

import gunbc.output_policy { OutcomeIsData }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.shell
import extdeps.filesystem.filesystem_io { Filesystem }
import extdeps.tools.xorriso
import extdeps.tools.grep
import extdeps.tools.sed
import extdeps.tools.sha256sum {
  Sha256FileDigest,
  Sha256FileDigestUnavailable,
  Sha256Matches,
  Sha256Mismatch,
  Sha256VerifyInfraFailure,
  sha256sum_file_digest_via_shell,
  sha256sum_verify_via_shell,
}
import extdeps.provisioning.ubuntu_seeded_install_media {
  NoCloudSeedFile,
  UbuntuSeededInstallMediaBuildInput,
}
import std.types { Bool, List, String, NonEmptyStr, FilePath }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/tutorial/providing-autoinstall.html"
  }
}

// xorriso -boot_image any replay modifies the stock ISO by mapping in only the NoCloud seed dir and
// grub.cfg, so the arm64 El Torito/ESP boot structure survives; an -as mkisofs rebuild destroyed it
// and the media stopped booting (root-caused live on srv4, PR #7027); instance-id derives from the
// artifact's nocloud dir basename, never a hardcoded host name

data el_torito_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pdos.csail.mit.edu/6.828/2014/readings/boot-cdrom.pdf"
  }
}

data esp_boot_structure_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "uefi.org/specs/UEFI/2.10/13_Protocols_Media_Access.html"
  }
}

// THE BUILDER STOPS AT A STAGED IMAGE AND ITS MEASURED DIGEST. Where the image is published, under
// which name, and who may write there are the publishing layer's decisions; this module's answer is
// only "these inputs produced bytes whose sha256 is D, and they are at the staging path". The digest
// is READ from the written file, never computed from the inputs, so a builder that wrote something
// other than what its inputs describe cannot report the inputs' identity for it.
type SeededInstallMediaStageOutcome
  = SeededInstallMediaStaged { staging_path: NonEmptyStr, output_digest: NonEmptyStr }
  | SeededInstallMediaStageRefused { reason: NonEmptyStr }

// grep exits non-zero when the pattern is ABSENT, and absence is precisely the question this fn
// asks — the idempotence probe deciding whether to substitute or leave the file alone. Both answers
// are ordinary: on a fresh image the cmdline is missing and gets inserted; on a re-run it is present
// and nothing happens. The §5 guard holds on the belt_program_available shape: the Bool is consumed
// as the branch discriminator, never discarded. A grep that could not RUN is a different event and
// does not travel this arm.
fn install_media_remaster_ensure_grub_cmdline(grub_cfg: NonEmptyStr, cmdline: NonEmptyStr) -> Bool {
  let already_present = grep.Grep.MatchesFixedString(pattern: cmdline, path: grub_cfg, expect: OutcomeIsData).matches
  let substituted = if already_present {
    true
  } else {
    let expression = concat(
      "s|\\(linux[[:space:]].*\\) ---|\\1 ",
      concat(cmdline as String, " ---|g"),
    ) as NonEmptyStr
    sed.Sed.InPlaceSubstitute(expression: expression, path: grub_cfg).success
  }
  substituted && grep.Grep.MatchesFixedString(pattern: cmdline, path: grub_cfg).matches
}

fn install_media_remaster_instance_seed_name(nocloud_dir_on_iso: NonEmptyStr) -> String {
  fold(
    split(s: nocloud_dir_on_iso as String, delimiter: "/"),
    init: "",
    f: (acc, segment) => segment,
  )
}

fn install_media_remaster_write_seed_file(nocloud_dir: NonEmptyStr, file: NoCloudSeedFile) -> Bool {
  Filesystem.Write(
    path: concat(nocloud_dir as String, "/", file.name as String),
    content: file.content as String,
  ).success
}

fn install_media_remaster_write_nocloud_seed(work_dir: NonEmptyStr, input: UbuntuSeededInstallMediaBuildInput) -> Bool {
  let nocloud_dir = concat(work_dir as String, "/", input.nocloud_dir_on_iso as String) as NonEmptyStr
  let mkdir_nocloud = shell.Mkdir.Parents(path: nocloud_dir as FilePath)
  if mkdir_nocloud.success == false {
    false
  } else {
    let wrote_user_data = Filesystem.Write(
      path: concat(nocloud_dir as String, "/user-data"),
      content: input.user_data_body as String,
    )
    let wrote_meta_data = Filesystem.Write(
      path: concat(nocloud_dir as String, "/meta-data"),
      content: concat(
        "instance-id: gunbc-",
        install_media_remaster_instance_seed_name(nocloud_dir_on_iso: input.nocloud_dir_on_iso),
        "-seeded\n",
      ),
    )
    let wrote_files = fold(
      input.seed_files,
      init: true,
      f: (acc, file) => acc && install_media_remaster_write_seed_file(nocloud_dir: nocloud_dir, file: file),
    )
    wrote_user_data.success && wrote_meta_data.success && wrote_files
  }
}

fn install_media_remaster_measure_staged(staging_path: NonEmptyStr) -> SeededInstallMediaStageOutcome {
  match sha256sum_file_digest_via_shell(path: staging_path) {
    Sha256FileDigestUnavailable { path: _, reason: r } =>
      SeededInstallMediaStageRefused { reason: concat("the staged image's digest could not be read: ", r) as NonEmptyStr }
    Sha256FileDigest { digest: d } =>
      SeededInstallMediaStaged { staging_path: staging_path, output_digest: d.hex }
  }
}

fn install_media_remaster_replay(
  input: UbuntuSeededInstallMediaBuildInput,
  stock_path: NonEmptyStr,
  staging_path: NonEmptyStr,
  work_dir: NonEmptyStr,
) -> SeededInstallMediaStageOutcome {
  let built = xorriso.Iso.ReplayBuildPinnedDates(
    stock_iso_path: stock_path,
    output_path: staging_path,
    volume_id: input.volume_id,
    volume_uuid: input.pinned_dates.volume_uuid,
    file_date: input.pinned_dates.file_date,
    seed_source: concat(work_dir as String, "/", input.nocloud_dir_on_iso as String) as NonEmptyStr,
    seed_iso_path: concat("/", input.nocloud_dir_on_iso as String) as NonEmptyStr,
    grub_cfg_source: concat(work_dir as String, "/boot/grub/grub.cfg") as NonEmptyStr,
  )
  if built.success == false {
    SeededInstallMediaStageRefused { reason: "xorriso -boot_image any replay build failed" as NonEmptyStr }
  } else {
    install_media_remaster_measure_staged(staging_path: staging_path)
  }
}

fn install_media_remaster_from_tree(
  input: UbuntuSeededInstallMediaBuildInput,
  stock_path: NonEmptyStr,
  staging_path: NonEmptyStr,
  work_dir: NonEmptyStr,
) -> SeededInstallMediaStageOutcome {
  let extracted = xorriso.Iso.ExtractTree(iso_path: stock_path, destination: work_dir)
  if extracted.success == false {
    SeededInstallMediaStageRefused { reason: "xorriso -osirrox extract failed" as NonEmptyStr }
  } else if shell.Chmod.RecursiveWritable(path: work_dir as FilePath).success == false {
    SeededInstallMediaStageRefused { reason: "chmod -R u+w failed" as NonEmptyStr }
  } else if install_media_remaster_write_nocloud_seed(work_dir: work_dir, input: input) == false {
    SeededInstallMediaStageRefused { reason: "writing NoCloud seed files failed" as NonEmptyStr }
  } else {
    let grub_cfg = concat(work_dir as String, "/boot/grub/grub.cfg") as NonEmptyStr
    if shell.Test.IsFile(path: grub_cfg as FilePath).is_file == false {
      SeededInstallMediaStageRefused { reason: concat("missing grub.cfg at ", grub_cfg as String) as NonEmptyStr }
    } else if install_media_remaster_ensure_grub_cmdline(grub_cfg: grub_cfg, cmdline: input.grub_kernel_cmdline) == false {
      SeededInstallMediaStageRefused { reason: "grub kernel cmdline not applied" as NonEmptyStr }
    } else {
      install_media_remaster_replay(input: input, stock_path: stock_path, staging_path: staging_path, work_dir: work_dir)
    }
  }
}

fn install_media_remaster_in_scratch(
  input: UbuntuSeededInstallMediaBuildInput,
  stock_path: NonEmptyStr,
  staging_path: NonEmptyStr,
) -> SeededInstallMediaStageOutcome {
  let work = shell.Mktemp.Dir()
  if work.success == false {
    SeededInstallMediaStageRefused { reason: "mktemp -d failed" as NonEmptyStr }
  } else {
    let outcome = install_media_remaster_from_tree(
      input: input,
      stock_path: stock_path,
      staging_path: staging_path,
      work_dir: work.path as NonEmptyStr,
    )
    let cleaned = shell.Remove.RecursiveForce(path: work.path)
    outcome
  }
}

// THE UPSTREAM BYTES ARE VERIFIED BEFORE THEY ARE BUILT FROM. The derivation key names the stock
// image by its pinned sha256; a stock file at the expected path whose bytes differ would otherwise
// produce an image whose recorded derivation is false. A mismatch and an unverifiable stock are
// separate refusals -- the second says nothing about the file.
fn seeded_install_media_stage(
  input: UbuntuSeededInstallMediaBuildInput,
  stock_path: NonEmptyStr,
  staging_path: NonEmptyStr,
) -> SeededInstallMediaStageOutcome {
  if shell.Test.IsFile(path: stock_path as FilePath).is_file == false {
    SeededInstallMediaStageRefused { reason: concat("stock ISO missing at ", stock_path as String) as NonEmptyStr }
  } else {
    match sha256sum_verify_via_shell(path: stock_path, expected_digest: input.stock_artifact.content_sha256 as NonEmptyStr) {
      Sha256VerifyInfraFailure { reason: r } =>
        SeededInstallMediaStageRefused { reason: concat("stock ISO digest could not be verified: ", r as String) as NonEmptyStr }
      Sha256Mismatch =>
        SeededInstallMediaStageRefused {
          reason: concat("stock ISO at ", stock_path as String, " does not hash to the pinned ", input.stock_artifact.content_sha256 as String) as NonEmptyStr
        }
      Sha256Matches => install_media_remaster_in_scratch(input: input, stock_path: stock_path, staging_path: staging_path)
    }
  }
}
