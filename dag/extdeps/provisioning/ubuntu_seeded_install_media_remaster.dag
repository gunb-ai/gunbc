module extdeps.provisioning.ubuntu_seeded_install_media_remaster


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/tutorial/providing-autoinstall.html"
  }
}

data install_media_remaster_bash_emit_dissolution_trigger: std.disposition.Disposition = std.disposition.Terminal {
  reason: "in-process typed reconcile (shell.Test.IsFile, xorriso.Iso.*, grep.Grep.MatchesFixedString, sed.Sed.InPlaceSubstitute, Filesystem.Write, shell.Move.File) replaces ShellProgram/serialize_bash - no shell text is built or serialized"
}

data install_media_remaster_classification_scaffold: std.disposition.Disposition = std.disposition.Terminal {
  reason: "InstallMediaRemasterObservation (Absent|Valid|Stale|VerifyInfraFailure) is the single classification authority, derived by observe_install_media_remaster - no parallel ad hoc staleness check remains"
}

data install_media_remaster_classification_dissolution_trigger: std.disposition.Disposition = std.disposition.Terminal {
  reason: "install_media_remaster_reconcile dispatches on InstallMediaRemasterObservation directly, not on inline shell text"
}

data install_media_remaster_chmod_access_upsert_scaffold: std.disposition.Disposition = std.disposition.Terminal {
  reason: "shell.Chmod.RecursiveWritable is the single typed authority for making the extracted work tree writable - no inline chmod RawLine remains"
}

data install_media_remaster_chmod_access_upsert_dissolution_trigger: std.disposition.Disposition = std.disposition.Terminal {
  reason: "install_media_remaster_build calls shell.Chmod.RecursiveWritable directly"
}

data install_media_remaster_probe_refusal_shape_doc: String = "DESIGN §5 refusal-shape fix (cursor review, PR #6596): install_media_remaster_probe_verdict now returns a 3-way InstallMediaRemasterProbeVerdict (Valid|Stale|InfraFailure\{reason\}) instead of collapsing the mktemp probe into a Bool, so a shell.Mktemp.Dir failure stays distinguishable from a genuine content/grub/seed mismatch (InstallMediaRemasterVerifyInfraFailure vs InstallMediaRemasterStale). observe_install_media_remaster matches this verdict directly, and install_media_remaster_reconcile refuses fail-closed on infra failure instead of silently treating an indeterminate probe as stale-and-rebuild."

data install_media_remaster_boot_fidelity_doc: String = "xorriso -boot_image any replay modifies the stock ISO by mapping in only the NoCloud seed dir and grub.cfg, so the arm64 El Torito/ESP boot structure survives; an -as mkisofs rebuild destroyed it and the media stopped booting (root-caused live on srv4, PR #7027); instance-id derives from the artifact's nocloud dir basename, never a hardcoded host name"

data el_torito_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "pdos.csail.mit.edu/6.828/2014/readings/boot-cdrom.pdf"
  }
}

data esp_boot_structure_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "uefi.org/specs/UEFI/2.10/13_Protocols_Media_Access.html"
  }
}

// The boot structure the replay preserves is owned by two specs the fidelity doc names in prose: the El Torito Bootable CD-ROM Format Specification 1.0 (Phoenix/IBM 1995; anchor is a hosted copy of the original) and the UEFI spec's EFI System Partition / media-access section (UEFI 2.10 §13). These are the entities the mkisofs rebuild violated.
type InstallMediaRemasterProbeVerdict
  = InstallMediaRemasterProbeValid
  | InstallMediaRemasterProbeStale
  | InstallMediaRemasterProbeInfraFailure { reason: std.types.NonEmptyStr }

type InstallMediaRemasterObservation
  = InstallMediaRemasterAbsent
  | InstallMediaRemasterValid
  | InstallMediaRemasterStale
  | InstallMediaRemasterVerifyInfraFailure { reason: std.types.NonEmptyStr }

type InstallMediaRemasterOutcome
  = InstallMediaRemasterAlreadyPresent { path: std.types.NonEmptyStr }
  | InstallMediaRemasterRemastered { path: std.types.NonEmptyStr }
  | InstallMediaRemasterRefused { reason: std.types.NonEmptyStr }

fn install_media_remaster_sidecar_path(final_path: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat(final_path as String, ".gunbc-content-hash") as std.types.NonEmptyStr
}

fn install_media_remaster_sidecar_matches(final_path: std.types.NonEmptyStr, expected_hash: std.types.NonEmptyStr) -> Bool {
  let read = Filesystem.Read(path: install_media_remaster_sidecar_path(final_path: final_path) as String)
  read.success && (read.content == expected_hash as String)
}

fn install_media_remaster_probe_verdict(artifact: extdeps.provisioning.ubuntu_seeded_install_media.UbuntuSeededInstallMediaArtifactRow, final_path: std.types.NonEmptyStr) -> InstallMediaRemasterProbeVerdict {
  let probe = shell.Mktemp.Dir()
  if probe.success == false {
    InstallMediaRemasterProbeInfraFailure { reason: "mktemp -d failed for staleness probe" as std.types.NonEmptyStr }
  } else {
    let grub_probe = concat(probe.path as String, "/grub.cfg") as std.types.NonEmptyStr
    let user_probe = concat(probe.path as String, "/user-data") as std.types.NonEmptyStr
    let user_internal = concat("/", concat(artifact.nocloud_dir_on_iso as String, "/user-data")) as std.types.NonEmptyStr
    let grub_extracted = xorriso.Iso.ExtractPathBestEffort(
      iso_path: final_path,
      iso_internal_path: "/boot/grub/grub.cfg" as std.types.NonEmptyStr,
      destination: grub_probe,
    )
    let user_extracted = xorriso.Iso.ExtractPathBestEffort(
      iso_path: final_path,
      iso_internal_path: user_internal,
      destination: user_probe,
    )
    let sidecar_matches = install_media_remaster_sidecar_matches(
      final_path: final_path,
      expected_hash: artifact.content_hash as std.types.NonEmptyStr,
    )
    let grub_present = shell.Test.IsFile(path: grub_probe as std.types.FilePath)
    let grub_has_cmdline = grub_present.is_file
      && grep.Grep.MatchesFixedString(pattern: artifact.grub_kernel_cmdline, path: grub_probe).matches
    let user_nonempty = shell.Test.IsNonEmpty(path: user_probe as std.types.FilePath).nonempty
    let cleaned = shell.Remove.RecursiveForce(path: probe.path)
    if sidecar_matches && grub_has_cmdline && user_nonempty {
      InstallMediaRemasterProbeValid
    } else {
      InstallMediaRemasterProbeStale
    }
  }
}

fn observe_install_media_remaster(artifact: extdeps.provisioning.ubuntu_seeded_install_media.UbuntuSeededInstallMediaArtifactRow) -> InstallMediaRemasterObservation {
  let final_path = ubuntu_seeded_install_media_install_path(artifact: artifact)
  let present = shell.Test.IsFile(path: final_path as std.types.FilePath)
  if present.is_file == false {
    InstallMediaRemasterAbsent
  } else {
    match install_media_remaster_probe_verdict(artifact: artifact, final_path: final_path) {
      InstallMediaRemasterProbeValid => InstallMediaRemasterValid
      InstallMediaRemasterProbeStale => InstallMediaRemasterStale
      InstallMediaRemasterProbeInfraFailure { reason: r } => InstallMediaRemasterVerifyInfraFailure { reason: r }
    }
  }
}

// grep exits non-zero when the pattern is ABSENT, and absence is precisely the question this fn asks — it is the idempotence probe that decides whether to substitute or leave the file alone. Both answers are ordinary: on a fresh image the cmdline is missing and gets inserted, on a re-run it is present and nothing happens. The §5 guard holds on the belt_program_available shape: the Bool is consumed as the branch discriminator, never discarded. A grep that could not RUN is a different event and does not travel this arm.
fn install_media_remaster_ensure_grub_cmdline(grub_cfg: std.types.NonEmptyStr, cmdline: std.types.NonEmptyStr) -> Bool {
  let already_present = grep.Grep.MatchesFixedString(pattern: cmdline, path: grub_cfg, expect: OutcomeIsData).matches
  let substituted = if already_present {
    true
  } else {
    let expression = concat(
      "s|\\(linux[[:space:]].*\\) ---|\\1 ",
      concat(cmdline as String, " ---|g"),
    ) as std.types.NonEmptyStr
    sed.Sed.InPlaceSubstitute(expression: expression, path: grub_cfg).success
  }
  substituted && grep.Grep.MatchesFixedString(pattern: cmdline, path: grub_cfg).matches
}

fn install_media_remaster_instance_seed_name(nocloud_dir_on_iso: std.types.NonEmptyStr) -> String {
  fold(
    split(s: nocloud_dir_on_iso as String, delimiter: "/"),
    init: "",
    f: (acc, segment) => segment,
  )
}

fn install_media_remaster_write_nocloud_seed(
  work_dir: std.types.NonEmptyStr,
  nocloud_dir_on_iso: std.types.NonEmptyStr,
  user_data_body: std.types.NonEmptyStr,
) -> Bool {
  let nocloud_dir = concat(work_dir as String, concat("/", nocloud_dir_on_iso as String)) as std.types.NonEmptyStr
  let mkdir_nocloud = shell.Mkdir.Parents(path: nocloud_dir as std.types.FilePath)
  if mkdir_nocloud.success == false {
    false
  } else {
    let wrote_user_data = Filesystem.Write(
      path: concat(nocloud_dir as String, "/user-data"),
      content: user_data_body as String,
    )
    let wrote_meta_data = Filesystem.Write(
      path: concat(nocloud_dir as String, "/meta-data"),
      content: concat(
        "instance-id: gunbc-",
        concat(install_media_remaster_instance_seed_name(nocloud_dir_on_iso: nocloud_dir_on_iso), "-seeded\n"),
      ),
    )
    wrote_user_data.success && wrote_meta_data.success
  }
}

fn install_media_remaster_build_iso(
  stock_path: std.types.NonEmptyStr,
  final_path: std.types.NonEmptyStr,
  part_path: std.types.NonEmptyStr,
  content_hash: std.types.NonEmptyStr,
  work_dir: std.types.NonEmptyStr,
  nocloud_dir_on_iso: std.types.NonEmptyStr,
) -> InstallMediaRemasterOutcome {
  let built = xorriso.Iso.ReplayBuildWithTwoMaps(
    stock_iso_path: stock_path,
    output_path: part_path,
    volume_id: "UBUNTU_SEEDED" as std.types.NonEmptyStr,
    map_one_source: concat(work_dir as String, concat("/", nocloud_dir_on_iso as String)) as std.types.NonEmptyStr,
    map_one_iso_path: concat("/", nocloud_dir_on_iso as String) as std.types.NonEmptyStr,
    map_two_source: concat(work_dir as String, "/boot/grub/grub.cfg") as std.types.NonEmptyStr,
    map_two_iso_path: "/boot/grub/grub.cfg" as std.types.NonEmptyStr,
  )
  if built.success == false {
    InstallMediaRemasterRefused { reason: "xorriso -boot_image any replay build failed" as std.types.NonEmptyStr }
  } else {
    let moved = shell.Move.File(source: part_path as std.types.FilePath, destination: final_path as std.types.FilePath)
    if moved.success == false {
      InstallMediaRemasterRefused { reason: "mv failed after replay build" as std.types.NonEmptyStr }
    } else {
      let wrote_sidecar = Filesystem.Write(
        path: install_media_remaster_sidecar_path(final_path: final_path) as String,
        content: content_hash as String,
      )
      if wrote_sidecar.success == false {
        InstallMediaRemasterRefused { reason: "writing content-hash sidecar failed" as std.types.NonEmptyStr }
      } else {
        InstallMediaRemasterRemastered { path: final_path }
      }
    }
  }
}

fn install_media_remaster_build(
  artifact: extdeps.provisioning.ubuntu_seeded_install_media.UbuntuSeededInstallMediaArtifactRow,
  stock_path: std.types.NonEmptyStr,
  final_path: std.types.NonEmptyStr,
  part_path: std.types.NonEmptyStr,
  work_dir: std.types.NonEmptyStr,
) -> InstallMediaRemasterOutcome {
  let extracted = xorriso.Iso.ExtractTree(iso_path: stock_path, destination: work_dir)
  if extracted.success == false {
    InstallMediaRemasterRefused { reason: "xorriso -osirrox extract failed" as std.types.NonEmptyStr }
  } else {
    let chmod = shell.Chmod.RecursiveWritable(path: work_dir as std.types.FilePath)
    if chmod.success == false {
      InstallMediaRemasterRefused { reason: "chmod -R u+w failed" as std.types.NonEmptyStr }
    } else if install_media_remaster_write_nocloud_seed(
      work_dir: work_dir,
      nocloud_dir_on_iso: artifact.nocloud_dir_on_iso,
      user_data_body: artifact.autoinstall_user_data_body,
    ) == false {
      InstallMediaRemasterRefused { reason: "writing NoCloud seed files failed" as std.types.NonEmptyStr }
    } else {
      let grub_cfg = concat(work_dir as String, "/boot/grub/grub.cfg") as std.types.NonEmptyStr
      let grub_present = shell.Test.IsFile(path: grub_cfg as std.types.FilePath)
      if grub_present.is_file == false {
        InstallMediaRemasterRefused {
          reason: concat("InstallMediaRemasterRefusal: missing grub.cfg at ", grub_cfg as String) as std.types.NonEmptyStr
        }
      } else if install_media_remaster_ensure_grub_cmdline(grub_cfg: grub_cfg, cmdline: artifact.grub_kernel_cmdline) == false {
        InstallMediaRemasterRefused { reason: "InstallMediaRemasterRefusal: grub kernel cmdline not applied" as std.types.NonEmptyStr }
      } else {
        install_media_remaster_build_iso(
          stock_path: stock_path,
          final_path: final_path,
          part_path: part_path,
          content_hash: artifact.content_hash as std.types.NonEmptyStr,
          work_dir: work_dir,
          nocloud_dir_on_iso: artifact.nocloud_dir_on_iso,
        )
      }
    }
  }
}

fn install_media_remaster_apply(artifact: extdeps.provisioning.ubuntu_seeded_install_media.UbuntuSeededInstallMediaArtifactRow) -> InstallMediaRemasterOutcome {
  let stock_path = ubuntu_install_media_install_path(artifact: artifact.stock_artifact)
  let final_path = ubuntu_seeded_install_media_install_path(artifact: artifact)
  let part_path = ubuntu_seeded_install_media_part_path(install_path: final_path)
  let stock_present = shell.Test.IsFile(path: stock_path as std.types.FilePath)
  if stock_present.is_file == false {
    InstallMediaRemasterRefused {
      reason: concat("InstallMediaRemasterRefusal: stock ISO missing at ", stock_path as String) as std.types.NonEmptyStr
    }
  } else {
    let mkdir = shell.Mkdir.Parents(path: ubuntu_install_media_artifacts_dir() as std.types.FilePath)
    if mkdir.success == false {
      InstallMediaRemasterRefused { reason: "mkdir -p failed" as std.types.NonEmptyStr }
    } else {
      let work = shell.Mktemp.Dir()
      if work.success == false {
        InstallMediaRemasterRefused { reason: "mktemp -d failed" as std.types.NonEmptyStr }
      } else {
        let outcome = install_media_remaster_build(
          artifact: artifact,
          stock_path: stock_path,
          final_path: final_path,
          part_path: part_path,
          work_dir: work.path as std.types.NonEmptyStr,
        )
        let cleaned = shell.Remove.RecursiveForce(path: work.path)
        outcome
      }
    }
  }
}

fn install_media_remaster_reconcile(artifact: extdeps.provisioning.ubuntu_seeded_install_media.UbuntuSeededInstallMediaArtifactRow) -> InstallMediaRemasterOutcome {
  let final_path = ubuntu_seeded_install_media_install_path(artifact: artifact)
  match observe_install_media_remaster(artifact: artifact) {
    InstallMediaRemasterValid => InstallMediaRemasterAlreadyPresent { path: final_path }
    InstallMediaRemasterAbsent => install_media_remaster_apply(artifact: artifact)
    InstallMediaRemasterStale => install_media_remaster_apply(artifact: artifact)
    InstallMediaRemasterVerifyInfraFailure { reason: r } => InstallMediaRemasterRefused {
      reason: concat("VerifyInfraFailureRefusal: ", r as String) as std.types.NonEmptyStr
    }
  }
}
