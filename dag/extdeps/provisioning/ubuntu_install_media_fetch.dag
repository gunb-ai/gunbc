module extdeps.os.ubuntu_install_media_fetch

import std.disposition { Disposition, Terminal }

import std.types { NonEmptyStr, List, String, Bool, FilePath }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.shell
import extdeps.http.client
import extdeps.tools.sha256sum { sha256sum_verify_via_shell, Sha256Matches, Sha256Mismatch, Sha256VerifyInfraFailure }
import extdeps.os.ubuntu_install_media {
  UbuntuInstallMediaArtifactRow,
  ubuntu_install_media_install_path,
  ubuntu_install_media_part_path,
  ubuntu_install_media_mirror_urls,
  ubuntu_install_media_artifacts_dir,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cdimage.ubuntu.com/releases/24.04/release/SHA256SUMS"
  }
}

data install_media_fetch_bash_emit_dissolution_trigger: Disposition = Terminal {
  reason: "in-process typed reconcile (shell.Test.IsFile, sha256sum_verify_via_shell, http.Client.DownloadToFile, shell.Move.File) replaces ShellProgram/serialize_bash - no shell text is built or serialized"
}

data install_media_fetch_hash_convergence_note: String = "§3 convergence note: this file verifies fetched content against Canonical's published cryptographic SHA-256 digest (extdeps_external_authority_anchor above) via the Sha256Verify shape - a genuine external-authority digest check, distinct from std.content_hash's fnv1a64 internal structural fingerprint (dag/std/content_hash.dag, used for our own generated-artifact freshness, e.g. srv3_seeded_install_media's remaster sidecar). Do not unify the two: one is a cryptographic authority citation, the other is an internal identity fingerprint with no external-authority meaning."

type InstallMediaFetchObservation
  = InstallMediaFetchAbsent
  | InstallMediaFetchVerified
  | InstallMediaFetchHashMismatch
  | InstallMediaFetchVerifyInfraFailure { reason: NonEmptyStr }

type InstallMediaFetchReconcileOutcome
  = InstallMediaFetchAlreadyPresent { path: NonEmptyStr }
  | InstallMediaFetchFetched { path: NonEmptyStr, mirror_url: NonEmptyStr }
  | InstallMediaFetchRefused { reason: NonEmptyStr }

data refusal_shape_doc: String = "DESIGN §5 refusal-shape fix (cursor review, PR #6596): the fetch reconcile path now matches Sha256VerifyVerdict directly instead of collapsing it through a Bool predicate, so a mktemp/checksum-write infra failure stays distinguishable from a genuine digest mismatch (InstallMediaFetchVerifyInfraFailure vs InstallMediaFetchHashMismatch), and a post-download shell.Move.File failure aborts with its own typed refusal instead of falling through the mirror fold to a misleading 'all mirrors unreachable'. The Bool-collapsing install_media_hash_matches helper was deleted (cursor review, PR #6596) - its two wet witnesses now assert on observe_install_media_fetch's Sha256VerifyVerdict-derived outcome directly, so no predicate-dissolution surface remains anywhere in this module."

type MirrorAttempt
  = MirrorTerminal { outcome: InstallMediaFetchReconcileOutcome }
  | MirrorHashMismatch
  | MirrorUnreachable

type MirrorFoldAcc = MirrorFoldAcc { terminal: InstallMediaFetchReconcileOutcome?, saw_mismatch: Bool }

data mirror_fold_refusal_doc: String = "DESIGN §5 fix (cursor review, PR #6596): install_media_fetch_try_mirror previously returned `none` for BOTH an unreachable mirror (transport miss, keep trying) AND a Sha256Mismatch (a genuine digest failure), so a run where every mirror downloaded but none verified fell through the fold to 'all mirrors unreachable' - a state-space conflation between reachability and digest correctness. MirrorAttempt now names the three outcomes distinctly, and the fold tracks saw_mismatch so the final refusal reads 'digest verification failed' when that's what actually happened."

fn observe_install_media_fetch(path: NonEmptyStr, expected_hash: NonEmptyStr) -> InstallMediaFetchObservation {
  let present = shell.Test.IsFile(path: path as FilePath)
  if present.is_file == false {
    InstallMediaFetchAbsent
  } else {
    match sha256sum_verify_via_shell(path: path, expected_digest: expected_hash) {
      Sha256Matches => InstallMediaFetchVerified
      Sha256Mismatch => InstallMediaFetchHashMismatch
      Sha256VerifyInfraFailure { reason: r } => InstallMediaFetchVerifyInfraFailure { reason: r }
    }
  }
}

fn install_media_fetch_try_mirror(
  url: NonEmptyStr,
  part_path: NonEmptyStr,
  final_path: NonEmptyStr,
  expected_hash: NonEmptyStr,
) -> MirrorAttempt {
  let downloaded = http.Client.DownloadToFile(url: url, destination: part_path)
  if downloaded.success == false {
    MirrorUnreachable
  } else {
    match sha256sum_verify_via_shell(path: part_path, expected_digest: expected_hash) {
      Sha256Matches => {
        let moved = shell.Move.File(source: part_path as FilePath, destination: final_path as FilePath)
        if moved.success {
          MirrorTerminal { outcome: InstallMediaFetchFetched { path: final_path, mirror_url: url } }
        } else {
          MirrorTerminal {
            outcome: InstallMediaFetchRefused {
              reason: concat("MoveFailureRefusal: mv failed after successful download+verify from ", url as String) as NonEmptyStr
            }
          }
        }
      }
      Sha256Mismatch => {
        let cleaned = shell.Remove.RecursiveForce(path: part_path as FilePath)
        MirrorHashMismatch
      }
      Sha256VerifyInfraFailure { reason: r } => {
        let cleaned = shell.Remove.RecursiveForce(path: part_path as FilePath)
        MirrorTerminal {
          outcome: InstallMediaFetchRefused {
            reason: concat("VerifyInfraFailureRefusal: ", r as String) as NonEmptyStr
          }
        }
      }
    }
  }
}

fn install_media_fetch_try_mirrors(
  urls: List<NonEmptyStr>,
  part_path: NonEmptyStr,
  final_path: NonEmptyStr,
  expected_hash: NonEmptyStr,
) -> InstallMediaFetchReconcileOutcome {
  let attempted = fold(
    urls,
    init: MirrorFoldAcc { terminal: none, saw_mismatch: false },
    f: (acc, url) => match acc.terminal {
      Present { value: _ } => acc
      Absent => match install_media_fetch_try_mirror(
        url: url,
        part_path: part_path,
        final_path: final_path,
        expected_hash: expected_hash,
      ) {
        MirrorTerminal { outcome: o } => MirrorFoldAcc { terminal: Present { value: o }, saw_mismatch: acc.saw_mismatch }
        MirrorHashMismatch => MirrorFoldAcc { terminal: none, saw_mismatch: true }
        MirrorUnreachable => acc
      }
    },
  )
  match attempted.terminal {
    Present { value: outcome } => outcome
    Absent => if attempted.saw_mismatch {
      InstallMediaFetchRefused {
        reason: "InstallMediaFetchRefusal: digest verification failed on every reachable mirror" as NonEmptyStr
      }
    } else {
      InstallMediaFetchRefused {
        reason: "InstallMediaFetchRefusal: all mirrors unreachable" as NonEmptyStr
      }
    }
  }
}

fn install_media_fetch_reconcile(artifact: UbuntuInstallMediaArtifactRow) -> InstallMediaFetchReconcileOutcome {
  let final_path = ubuntu_install_media_install_path(artifact: artifact)
  let part_path = ubuntu_install_media_part_path(install_path: final_path)
  let expected_hash = artifact.content_sha256 as NonEmptyStr
  match observe_install_media_fetch(path: final_path, expected_hash: expected_hash) {
    InstallMediaFetchVerified => InstallMediaFetchAlreadyPresent { path: final_path }
    InstallMediaFetchHashMismatch => InstallMediaFetchRefused {
      reason: concat(
        "HashMismatchRefusal: path=",
        concat(final_path as String, concat(" expected=", expected_hash as String)),
      ) as NonEmptyStr
    }
    InstallMediaFetchVerifyInfraFailure { reason: r } => InstallMediaFetchRefused {
      reason: concat("VerifyInfraFailureRefusal: ", r as String) as NonEmptyStr
    }
    InstallMediaFetchAbsent => {
      let mkdir = shell.Mkdir.Parents(path: ubuntu_install_media_artifacts_dir() as FilePath)
      if mkdir.success == false {
        InstallMediaFetchRefused { reason: "mkdir -p failed" as NonEmptyStr }
      } else {
        install_media_fetch_try_mirrors(
          urls: ubuntu_install_media_mirror_urls(artifact: artifact),
          part_path: part_path,
          final_path: final_path,
          expected_hash: expected_hash,
        )
      }
    }
  }
}
