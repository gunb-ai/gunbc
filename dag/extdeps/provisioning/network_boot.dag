module extdeps.provisioning.network_boot


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "uefi.org/specs/UEFI/2.10/24_Network_Protocols_UDP_and_MTFTP.html"
  }
}

type ClientNetworkBootMode =
    LegacyBiosPxe { tftp_root: extdeps.uri.Uri }
  | UefiPxe { tftp_root: extdeps.uri.Uri }
  | UefiHttpBoot

type DhcpBootDirection =
    NativeDhcpBootOptions
  | ProxyDhcp

fn network_uefi_bootloader_artifact(arch: extdeps.toolchain.types.Architecture) -> std.types.NonEmptyStr? {
  match arch {
    Aarch64 => Present { value: "grubnetaa64.efi" }
    X86_64 => Present { value: "grubnetx64.efi" }
    X86 => Absent
    Arm => Absent
    Armv7 => Absent
    Mips => Absent
    Mipsel => Absent
    Mips64 => Absent
    Mips64el => Absent
    Riscv64 => Absent
    Wasm32 => Absent
  }
}

type NetworkBootChain {
  boot_mode: ClientNetworkBootMode
  dhcp_direction: DhcpBootDirection
  image_http_root: extdeps.uri.Uri
}
