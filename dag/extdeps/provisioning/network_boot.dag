module extdeps.provisioning.network_boot


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "uefi.org/specs/UEFI/2.10/24_Network_Protocols_UDP_and_MTFTP.html"
  }
}

type ClientNetworkBootMode =
    LegacyBiosPxe { tftp_root: extdeps.uri.Uri }
  | UefiPxe { tftp_root: extdeps.uri.Uri }
  | UefiHttpBoot

type DhcpBootDirection =
    NativeDhcpBootOptions
  | ProxyDhcp

fn network_uefi_bootloader_artifact(arch: extdeps.toolchain.types.Architecture) -> std.types.NonEmptyStr? {
  match arch {
    extdeps.toolchain.types.Aarch64 => Present { value: "grubnetaa64.efi" }
    extdeps.toolchain.types.X86_64 => Present { value: "grubnetx64.efi" }
    extdeps.toolchain.types.X86 => Absent
    extdeps.toolchain.types.Arm => Absent
    extdeps.toolchain.types.Armv7 => Absent
    extdeps.toolchain.types.Mips => Absent
    extdeps.toolchain.types.Mipsel => Absent
    extdeps.toolchain.types.Mips64 => Absent
    extdeps.toolchain.types.Mips64el => Absent
    extdeps.toolchain.types.Riscv64 => Absent
    extdeps.toolchain.types.Wasm32 => Absent
  }
}

type NetworkBootChain {
  boot_mode: ClientNetworkBootMode
  dhcp_direction: DhcpBootDirection
  image_http_root: extdeps.uri.Uri
}
