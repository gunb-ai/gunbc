module extdeps.provisioning.ubuntu_install_media

import std.os.types { NobleNumbat2404Lts }
import std.types { List, NonEmptyStr, Sha256, String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https, uri_wire }
import std.algebra { FreeSemigroup }
import extdeps.provisioning.network_boot {
  NetworkBootLoaderChain,
  NetworkBootLoaderMember,
  FirstStageLoader,
  SecondStageLoader,
  LoaderConfiguration,
  KernelImage,
  InitrdImage,
  FirmwareSignatureDatabase,
  ShimVendorCertificate,
  ShimLockProtocol,
  NotAuthenticated,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cdimage.ubuntu.com/releases/24.04/release/SHA256SUMS"
  }
}

type UbuntuInstallMediaFlavor = | UbuntuLiveServer

type UbuntuInstallMediaArchitecture
  = Aarch64
  | Amd64

type UbuntuInstallMediaMirrorHost
  = ReleasesUbuntuCom
  | CdimageUbuntuCom
  | OldReleasesUbuntuCom

type UbuntuInstallMediaMirrorRow {
  host: UbuntuInstallMediaMirrorHost
  locator: NonEmptyStr
}

type UbuntuInstallMediaArtifactRow {
  distribution: NobleNumbat2404Lts
  point_release: NonEmptyStr
  architecture: UbuntuInstallMediaArchitecture
  flavor: UbuntuInstallMediaFlavor
  content_sha256: Sha256
  sha256sums_authority: ExternalAuthority
}

fn ubuntu_install_media_architecture_wire(arch: UbuntuInstallMediaArchitecture) -> NonEmptyStr {
  match arch {
    Aarch64 => "arm64"
    Amd64 => "amd64"
  }
}

fn ubuntu_install_media_flavor_wire(flavor: UbuntuInstallMediaFlavor) -> NonEmptyStr {
  match flavor {
    UbuntuLiveServer => "live-server"
  }
}

fn ubuntu_install_media_filename(artifact: UbuntuInstallMediaArtifactRow) -> NonEmptyStr {
  concat(
    concat(
      concat(
        concat("ubuntu-", artifact.point_release as String),
        "-",
      ),
      ubuntu_install_media_flavor_wire(flavor: artifact.flavor) as String,
    ),
    concat(
      "-",
      concat(
        ubuntu_install_media_architecture_wire(arch: artifact.architecture) as String,
        ".iso",
      ),
    ),
  ) as NonEmptyStr
}

fn ubuntu_install_media_mirror_path_segment(host: UbuntuInstallMediaMirrorHost) -> NonEmptyStr {
  match host {
    ReleasesUbuntuCom => "24.04"
    CdimageUbuntuCom => "releases/24.04/release"
    OldReleasesUbuntuCom => "releases/24.04/release"
  }
}

fn ubuntu_install_media_mirror_url(
  artifact: UbuntuInstallMediaArtifactRow,
  mirror: UbuntuInstallMediaMirrorRow,
) -> NonEmptyStr {
  let filename = ubuntu_install_media_filename(artifact: artifact)
  uri_wire(uri: Uri {
    scheme: Https,
    locator: concat(
      concat(
        concat(mirror.locator as String, "/"),
        ubuntu_install_media_mirror_path_segment(host: mirror.host) as String,
      ),
      concat("/", filename as String),
    ) as NonEmptyStr,
  })
}

data ubuntu_install_media_mirror_rows: List<UbuntuInstallMediaMirrorRow> = [
  UbuntuInstallMediaMirrorRow {
    host: ReleasesUbuntuCom,
    locator: "releases.ubuntu.com",
  },
  UbuntuInstallMediaMirrorRow {
    host: CdimageUbuntuCom,
    locator: "cdimage.ubuntu.com",
  },
  UbuntuInstallMediaMirrorRow {
    host: OldReleasesUbuntuCom,
    locator: "old-releases.ubuntu.com",
  },
]

// WHERE CANONICAL PUBLISHES EACH ARCHITECTURE'S RELEASE: the amd64 live-server ISO on
// releases.ubuntu.com (cdimage.ubuntu.com/releases/24.04/release answers 404 for it), the arm64 one on
// cdimage.ubuntu.com, each beside the SHA256SUMS that lists it.
fn ubuntu_install_media_publishing_mirror(arch: UbuntuInstallMediaArchitecture) -> UbuntuInstallMediaMirrorRow {
  match arch {
    Amd64 => UbuntuInstallMediaMirrorRow { host: ReleasesUbuntuCom, locator: "releases.ubuntu.com" }
    Aarch64 => UbuntuInstallMediaMirrorRow { host: CdimageUbuntuCom, locator: "cdimage.ubuntu.com" }
  }
}

fn ubuntu_install_media_mirror_urls(artifact: UbuntuInstallMediaArtifactRow) -> List<NonEmptyStr> {
  map(
    ubuntu_install_media_mirror_rows,
    m => ubuntu_install_media_mirror_url(artifact: artifact, mirror: m),
  )
}

// THE INSTALL ROOT IS RECEIVED, NOT CARRIED (cohort C-host): this module carries upstream facts
// only -- the cited rows, their filenames and digests. The host directory the media is installed into
// is a gunbc host-state fact, declared under the ONE tree by gunbc.provisioning.install_media_store
// (install_media_slots, member "artifacts"); it passes the directory here, and the old
// ubuntu_install_media_artifacts_dir() with its "/var/lib/gunbc/artifacts" literal is DELETED.
fn ubuntu_install_media_install_path(dir: NonEmptyStr, artifact: UbuntuInstallMediaArtifactRow) -> NonEmptyStr {
  concat(
    concat(dir as String, "/"),
    ubuntu_install_media_filename(artifact: artifact) as String,
  ) as NonEmptyStr
}

fn ubuntu_install_media_part_path(install_path: NonEmptyStr) -> NonEmptyStr {
  concat(install_path as String, ".part") as NonEmptyStr
}

data ubuntu_noble_2404_sha256sums_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cdimage.ubuntu.com/releases/24.04/release/SHA256SUMS"
  }
}

data noble_numbat_2404_3_live_server_arm64: UbuntuInstallMediaArtifactRow = UbuntuInstallMediaArtifactRow {
  distribution: NobleNumbat2404Lts,
  point_release: "24.04.3",
  architecture: Aarch64,
  flavor: UbuntuLiveServer,
  content_sha256: "2ee2163c9b901ff5926400e80759088ff3b879982a3956c02100495b489fd555",
  sha256sums_authority: ubuntu_noble_2404_sha256sums_authority,
}

// The 24.04.5 point release, listed beside 24.04.3 in the same SHA256SUMS and served from the same
// release directory. Both rows cite the one release-series authority above.
data noble_numbat_2404_5_live_server_arm64: UbuntuInstallMediaArtifactRow = UbuntuInstallMediaArtifactRow {
  distribution: NobleNumbat2404Lts,
  point_release: "24.04.5",
  architecture: Aarch64,
  flavor: UbuntuLiveServer,
  content_sha256: "f12484464c7d4d73e2167e0a7dbda1e669f8fae9bcf778dc0944937034b320cb",
  sha256sums_authority: ubuntu_noble_2404_sha256sums_authority,
}

// THE amd64 RELEASE IS PUBLISHED ON releases.ubuntu.com, NOT cdimage: its SHA256SUMS lists the amd64
// live-server ISO, and SHA256SUMS.gpg is signed by the Ubuntu CD Image Automatic Signing Key (2012),
// fingerprint 8439 38DF 228D 22F7 B374 2BC0 D94A A3F0 EFE2 1092 (the key the arm64 cdimage list is
// signed with). The authority is per point release because that directory is the one the line lives in.
data ubuntu_noble_2404_3_releases_sha256sums_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "releases.ubuntu.com/24.04.3/SHA256SUMS"
  }
}

data ubuntu_cd_image_signing_key_fingerprint: NonEmptyStr = "843938DF228D22F7B3742BC0D94AA3F0EFE21092"

data noble_numbat_2404_3_live_server_amd64: UbuntuInstallMediaArtifactRow = UbuntuInstallMediaArtifactRow {
  distribution: NobleNumbat2404Lts,
  point_release: "24.04.3",
  architecture: Amd64,
  flavor: UbuntuLiveServer,
  content_sha256: "c3514bf0056180d09376462a7a1b4f213c1d6e8ea67fae5c25099c6fd3d8274b",
  sha256sums_authority: ubuntu_noble_2404_3_releases_sha256sums_authority,
}

// THE MEDIA ROWS THIS MODULE CITES, each a line of the SHA256SUMS its authority names. A consumer that pins
// artefacts read out of an ISO admits only one of these, so a row assembled elsewhere (one ISO's digest under
// another architecture's label, say) has no origin built over it.
data ubuntu_install_media_published_rows: List<UbuntuInstallMediaArtifactRow> = [
  noble_numbat_2404_3_live_server_arm64,
  noble_numbat_2404_5_live_server_arm64,
  noble_numbat_2404_3_live_server_amd64,
]

fn ubuntu_install_media_row_is_published(row: UbuntuInstallMediaArtifactRow) -> Bool {
  any(ubuntu_install_media_published_rows, r => r == row)
}

// ── The amd64 UEFI network-boot chain Canonical documents ────────────────────────────────────────
// Canonical's how-to serves, from one TFTP root: the signed shim as bootx64.efi, the signed network
// GRUB as grubx64.efi (shim loads that name from beside itself), grub/grub.cfg under GRUB's network
// prefix, and the live-server ISO's casper kernel and initrd as vmlinuz and initrd. Each member's
// verifier is the boot chain's own: the firmware db checks shim (Microsoft UEFI CA), shim checks GRUB
// against Canonical's certificate built into it, and GRUB checks the kernel through shim-lock; nobody
// checks grub.cfg or the initrd. The netboot TARBALL is not a source: it is unhashed and moves to later
// point releases (24.04.3/netboot/amd64 serves a 7.0 kernel and boots the 24.04.5 ISO).
data ubuntu_amd64_netboot_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "documentation.ubuntu.com/server/how-to/installation/how-to-netboot-the-server-installer-on-amd64/"
  }
}

// WHERE A SERVED MEMBER'S BYTES COME FROM, inside the pinned ISO. A pool member is checked twice by
// Canonical's own signatures: the ISO's dists/<suite>/Release (signed by the CD key) names Packages.gz
// by sha256, which names the .deb by sha256. The digests of the files INSIDE the .deb, and of the casper
// members, are not published by Canonical; their pins live with the observer in gunbc.
type UbuntuNetworkBootMemberSource
  = IsoMember { iso_path: NonEmptyStr }
  | PoolPackageMember { package: NonEmptyStr, version: NonEmptyStr, pool_path: NonEmptyStr, deb_sha256: NonEmptyStr, member_path: NonEmptyStr }
  | RenderedByConsumer

type UbuntuNetworkBootMember {
  member: NetworkBootLoaderMember
  source: UbuntuNetworkBootMemberSource
}

type UbuntuNetworkBootChain {
  media: UbuntuInstallMediaArtifactRow
  members: FreeSemigroup<UbuntuNetworkBootMember>
}

fn ubuntu_network_boot_loader_chain(chain: UbuntuNetworkBootChain) -> NetworkBootLoaderChain {
  NetworkBootLoaderChain {
    members: FreeSemigroup { head: chain.members.head.member, tail: map(chain.members.tail, m => m.member) },
  }
}

// Package versions and .deb digests as the 24.04.3 amd64 ISO's pool and its signed Release ->
// main/binary-amd64/Packages.gz (sha256 6f7f931d0e4231140c9bae627a107149ba29d2c51473a296a8206d9c15fc02c9) list them.
data noble_numbat_2404_3_amd64_uefi_network_boot_chain: UbuntuNetworkBootChain = UbuntuNetworkBootChain {
  media: noble_numbat_2404_3_live_server_amd64,
  members: FreeSemigroup {
    head: UbuntuNetworkBootMember {
      member: NetworkBootLoaderMember { role: FirstStageLoader, served_path: "bootx64.efi", verifier: FirmwareSignatureDatabase },
      source: PoolPackageMember {
        package: "shim-signed",
        version: "1.58+15.8-0ubuntu1",
        pool_path: "pool/main/s/shim-signed/shim-signed_1.58+15.8-0ubuntu1_amd64.deb",
        deb_sha256: "ba9b5d80e5d886c30664f2bebfb5c2fcce3b9b40f16fc46cba49c19a91c8059c",
        member_path: "usr/lib/shim/shimx64.efi.signed.latest",
      },
    },
    tail: [
      UbuntuNetworkBootMember {
        member: NetworkBootLoaderMember { role: SecondStageLoader, served_path: "grubx64.efi", verifier: ShimVendorCertificate },
        source: PoolPackageMember {
          package: "grub-efi-amd64-signed",
          version: "1.202.5+2.12-1ubuntu7.3",
          pool_path: "pool/main/g/grub2-signed/grub-efi-amd64-signed_1.202.5+2.12-1ubuntu7.3_amd64.deb",
          deb_sha256: "8bd5cd99c3af82aab23af0f15f54c91799f343416412e122df661ef36a44a511",
          member_path: "usr/lib/grub/x86_64-efi-signed/grubnetx64.efi.signed",
        },
      },
      UbuntuNetworkBootMember {
        member: NetworkBootLoaderMember { role: LoaderConfiguration, served_path: "grub/grub.cfg", verifier: NotAuthenticated },
        source: RenderedByConsumer,
      },
      UbuntuNetworkBootMember {
        member: NetworkBootLoaderMember { role: KernelImage, served_path: "vmlinuz", verifier: ShimLockProtocol },
        source: IsoMember { iso_path: "casper/vmlinuz" },
      },
      UbuntuNetworkBootMember {
        member: NetworkBootLoaderMember { role: InitrdImage, served_path: "initrd", verifier: NotAuthenticated },
        source: IsoMember { iso_path: "casper/initrd" },
      },
    ],
  },
}

// ── The arm64 UEFI network-boot chain ────────────────────────────────────────────────────────────
// Canonical's arm64 UEFI PXE how-to serves the signed network GRUB (grubnetaa64.efi.signed) with grub/grub.cfg
// under GRUB's network prefix and the live-server ISO's casper kernel and initrd. This chain puts the signed shim
// in front of it, as the amd64 chain does: shim's aarch64 build loads \grubaa64.efi from beside itself (shim
// README, DEFAULT_LOADER), so the chain boots whether or not the firmware enforces Secure Boot. The loaders
// carry the aa64 names, which keep them apart from the amd64 chain's in one TFTP root; the kernel and initrd
// sit under arm64/ for the same reason. grubnetaa64.efi.signed embeds the prefix /grub, as the amd64 build
// does, so both architectures read one grub/grub.cfg-01-<mac> per host and one fallback grub/grub.cfg.
data ubuntu_arm64_netboot_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "documentation.ubuntu.com/server/how-to/installation/netboot-the-server-installer-via-uefi-pxe-on-arm-aarch64-arm64-and-x86-64-amd64/"
  }
}

// Package versions and .deb digests as the 24.04.3 arm64 ISO's pool and its signed Release ->
// main/binary-arm64/Packages.gz (sha256 8aa714cd402e420d2132c86211a4133cd3211be275811d1da79adec633ccaba3) list them.
data noble_numbat_2404_3_arm64_uefi_network_boot_chain: UbuntuNetworkBootChain = UbuntuNetworkBootChain {
  media: noble_numbat_2404_3_live_server_arm64,
  members: FreeSemigroup {
    head: UbuntuNetworkBootMember {
      member: NetworkBootLoaderMember { role: FirstStageLoader, served_path: "bootaa64.efi", verifier: FirmwareSignatureDatabase },
      source: PoolPackageMember {
        package: "shim-signed",
        version: "1.58+15.8-0ubuntu1",
        pool_path: "pool/main/s/shim-signed/shim-signed_1.58+15.8-0ubuntu1_arm64.deb",
        deb_sha256: "58b0f8a0f43bdff2122af8f52b05a5eb73b1964079e36e3eed8d06b4d5164917",
        member_path: "usr/lib/shim/shimaa64.efi.signed.latest",
      },
    },
    tail: [
      UbuntuNetworkBootMember {
        member: NetworkBootLoaderMember { role: SecondStageLoader, served_path: "grubaa64.efi", verifier: ShimVendorCertificate },
        source: PoolPackageMember {
          package: "grub-efi-arm64-signed",
          version: "1.202.5+2.12-1ubuntu7.3",
          pool_path: "pool/main/g/grub2-signed/grub-efi-arm64-signed_1.202.5+2.12-1ubuntu7.3_arm64.deb",
          deb_sha256: "728d506c28c56d3e4372f5f5b143d837d96b202c82ed05cbbd3ec27a5d4de955",
          member_path: "usr/lib/grub/arm64-efi-signed/grubnetaa64.efi.signed",
        },
      },
      UbuntuNetworkBootMember {
        member: NetworkBootLoaderMember { role: LoaderConfiguration, served_path: "grub/grub.cfg", verifier: NotAuthenticated },
        source: RenderedByConsumer,
      },
      UbuntuNetworkBootMember {
        member: NetworkBootLoaderMember { role: KernelImage, served_path: "arm64/vmlinuz", verifier: ShimLockProtocol },
        source: IsoMember { iso_path: "casper/vmlinuz" },
      },
      UbuntuNetworkBootMember {
        member: NetworkBootLoaderMember { role: InitrdImage, served_path: "arm64/initrd", verifier: NotAuthenticated },
        source: IsoMember { iso_path: "casper/initrd" },
      },
    ],
  },
}

// The live-server ISO's casper directory is a layout Canonical authors: the kernel and initrd a
// network boot serves are these members. Their digests are not Canonical's (no upstream file lists
// them), so the pins live with the observer, gunbc.provisioning.ubuntu_network_origin_observation.
fn ubuntu_casper_kernel_member_path() -> NonEmptyStr {
  "casper/vmlinuz"
}

fn ubuntu_casper_initrd_member_path() -> NonEmptyStr {
  "casper/initrd"
}

// THE STOCK MEDIUM'S BOOT CONFIGURATION, AS A MEMBER OF THE PINNED ARTIFACT. /boot/grub/grub.cfg of
// ubuntu-24.04.3-live-server-arm64.iso (the artifact above, sha256 2ee2163c...) is fixed by that
// digest, so its bytes are an upstream fact like the digest itself: read once from the artifact
// (2026-09-28) and carried here with their own sha256. A builder that edits this file checks the
// extracted member against `content_sha256` on the host where it runs and writes its edit of
// `content`, rather than reading the file back through a process whose captured stdout is not the
// file's exact bytes.
type UbuntuInstallMediaGrubConfig {
  artifact_sha256: NonEmptyStr
  content: String
  content_sha256: NonEmptyStr
}

data noble_numbat_2404_3_live_server_arm64_grub_cfg: UbuntuInstallMediaGrubConfig = UbuntuInstallMediaGrubConfig {
  artifact_sha256: "2ee2163c9b901ff5926400e80759088ff3b879982a3956c02100495b489fd555",
  content: "set timeout=30\n\nloadfont unicode\n\nset menu_color_normal=white/black\nset menu_color_highlight=black/light-gray\n\nmenuentry \"Try or Install Ubuntu Server\" \{\n\tset gfxpayload=keep\n\tlinux\t/casper/vmlinuz  --- console=tty0\n\tinitrd\t/casper/initrd\n\}\nmenuentry \"Ubuntu Server with the HWE kernel\" \{\n\tset gfxpayload=keep\n\tlinux\t/casper/hwe-vmlinuz  --- console=tty0\n\tinitrd\t/casper/hwe-initrd\n\}\nmenuentry 'Boot from next volume' \{\n\texit 1\n\}\nmenuentry 'UEFI Firmware Settings' \{\n\tfwsetup\n\}\n",
  content_sha256: "e1280b6cab9d57cf5a1e3b67153164cda0f730f85ebdcda14eda629995ecafe7",
}

data ubuntu_install_media_grub_configs: List<UbuntuInstallMediaGrubConfig> = [noble_numbat_2404_3_live_server_arm64_grub_cfg]

// The grub.cfg member of a pinned artifact, or none: an artifact with no carried member has no
// modeled boot configuration to edit, and a builder refuses it rather than reading one back.
fn ubuntu_install_media_grub_cfg_for(artifact: UbuntuInstallMediaArtifactRow) -> UbuntuInstallMediaGrubConfig? {
  first(flat_map(ubuntu_install_media_grub_configs, g => if (g.artifact_sha256 as String) == (artifact.content_sha256 as String) { [g] } else { [] }))
}
