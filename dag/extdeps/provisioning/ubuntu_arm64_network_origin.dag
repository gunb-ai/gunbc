module extdeps.provisioning.ubuntu_arm64_network_origin

// SEAM: extdeps keeps what Canonical publishes; gunbc keeps what we concluded. This module adds
// to extdeps.provisioning.ubuntu_install_media (the one home of the Ubuntu release, architecture
// spelling, mirror URL construction and ISO row) only what a NETWORK origin needs beyond it: the
// 24.04.5 row, which the same SHA256SUMS lists beside the 24.04.3 row, and the aarch64 gate.
// The casper member layout is owned by gunbc.machine_intake.mtcollins1_census_member_readback.
// What a mirror served, our sizes, and the kernel/initrd digests WE extracted
// are in gunbc.provisioning.ubuntu_arm64_network_origin_observation.
import std.types { NonEmptyStr }
import std.optional { Absent, Present }
import std.os.types { NobleNumbat2404Lts }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.provisioning.ubuntu_install_media {
  UbuntuInstallMediaArtifactRow,
  UbuntuLiveServer,
  Aarch64,
  Amd64,
  noble_numbat_2404_3_live_server_arm64_sha256sums_authority,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/explanations/pxe-booting.html"
  }
}

// WHERE THIS ORIGIN DIFFERS FROM ubuntu_seeded_install_media. That module derives an ISO whose
// identity is the digest of bytes WE built. A network origin is bytes CANONICAL publishes and a
// mirror serves: nothing here is built, so the identity is a pin per artefact plus a verdict on
// whether what a mirror served equals it. The media-shaped parts (NoCloud seed dir, volume id,
// pinned dates, grub cmdline) are absent, because the seed arrives over HTTP via the kernel command
// line, not on the medium.
//
// DIVERGES FROM THE 24.04.3 ROW ubuntu_install_media pins, with a reason: that row is the medium
// the USB/ISO path installs from; the network origin pins the point release the release directory
// currently serves as its kernel/initrd source. Both rows name the same SHA256SUMS, so the authority
// is reused (its symbol predates this row and names 24.04.3 only because that row came first).
//
// CONSUMER (DESIGN 3c): consumed by gunbc.provisioning.ubuntu_arm64_network_origin_observation in
// this change, and through it by a declared later change of cut 6 of
// gunbc.plans.physical_machine_boot_program (the PXE-edge arm serving kernel/initrd and the ISO url).

data noble_numbat_2404_5_live_server_arm64: UbuntuInstallMediaArtifactRow = UbuntuInstallMediaArtifactRow {
  distribution: NobleNumbat2404Lts,
  point_release: "24.04.5",
  architecture: Aarch64,
  flavor: UbuntuLiveServer,
  content_sha256: "f12484464c7d4d73e2167e0a7dbda1e669f8fae9bcf778dc0944937034b320cb",
  sha256sums_authority: noble_numbat_2404_3_live_server_arm64_sha256sums_authority,
}

// An origin over aarch64 netboot artefacts admits only the aarch64 row: a row for another
// architecture is absence, not a pin the origin could be built over.
fn ubuntu_install_media_row_for_aarch64(row: UbuntuInstallMediaArtifactRow) -> UbuntuInstallMediaArtifactRow? {
  match row.architecture {
    Aarch64 => Present { value: row }
    Amd64 => Absent
  }
}
