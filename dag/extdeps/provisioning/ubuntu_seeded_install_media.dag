module extdeps.provisioning.ubuntu_seeded_install_media


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/tutorial/providing-autoinstall.html"
  }
}

type UbuntuSeededInstallMediaFlavor = | UbuntuLiveServerSeeded

type UbuntuSeededInstallMediaArtifactRow {
  stock_artifact: extdeps.provisioning.ubuntu_install_media.UbuntuInstallMediaArtifactRow
  autoinstall: extdeps.os.ubuntu_autoinstall.UbuntuAutoinstallPayload
  autoinstall_user_data_body: std.types.NonEmptyStr
  grub_kernel_cmdline: std.types.NonEmptyStr
  nocloud_dir_on_iso: std.types.NonEmptyStr
  content_hash: std.content_hash.ContentHash
}

// The ds= NoCloud seedfrom carries a ';' (e.g. ds=nocloud;s=<path>). In a grub.cfg linux line ';' is grub's command separator, so the arg MUST be double-quoted or grub truncates the cmdline at ';' and the kernel never sees s=<seedfrom> — autoinstall then falls to interactive. These builders emit grub cmdline strings (injected by the remaster sed), so they quote the ds arg here; the List<KernelCmdlineArg> grub path quotes structurally in grub_cmdline_arg_render.
fn ubuntu_seeded_install_media_grub_kernel_cmdline(nocloud_dir: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat("autoinstall \"ds=nocloud;s=/cdrom/", concat(nocloud_dir as String, "/\"")) as std.types.NonEmptyStr
}

fn ubuntu_seeded_install_media_grub_kernel_cmdline_net(seed_url: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat("autoinstall ip=dhcp \"ds=nocloud-net;s=", concat(seed_url as String, "\"")) as std.types.NonEmptyStr
}

fn ubuntu_seeded_install_media_default_nocloud_dir(hostname: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat("nocloud/", hostname as String) as std.types.NonEmptyStr
}

fn seeded_install_media_content_hash(
  stock_content_sha256: std.types.NonEmptyStr,
  autoinstall_user_data_body: std.types.NonEmptyStr,
  grub_kernel_cmdline: std.types.NonEmptyStr,
  nocloud_dir_on_iso: std.types.NonEmptyStr,
) -> std.content_hash.ContentHash {
  std.content_hash.content_hash_tagged(
    tag: "ubuntu-seeded-install-media/v2",
    payload: std.content_hash.content_hash_combine_structural(
      std.content_hash.content_hash_combine_structural(
        std.content_hash.content_hash_combine_structural(
          std.content_hash.content_hash_atom(value: stock_content_sha256),
          std.content_hash.content_hash_atom(value: autoinstall_user_data_body),
        ),
        std.content_hash.content_hash_atom(value: grub_kernel_cmdline),
      ),
      std.content_hash.content_hash_atom(value: nocloud_dir_on_iso),
    ),
  )
}

fn ubuntu_seeded_install_media_filename(artifact: UbuntuSeededInstallMediaArtifactRow) -> std.types.NonEmptyStr {
  concat(
    concat(
      concat("ubuntu-", artifact.stock_artifact.point_release as String),
      "-live-server-",
    ),
    concat(
      concat(artifact.autoinstall.identity.hostname as String, "-seeded.iso"),
    ),
  ) as std.types.NonEmptyStr
}

fn ubuntu_seeded_install_media_install_path(artifact: UbuntuSeededInstallMediaArtifactRow) -> std.types.NonEmptyStr {
  concat(
    concat(extdeps.provisioning.ubuntu_install_media.ubuntu_install_media_artifacts_dir() as String, "/"),
    ubuntu_seeded_install_media_filename(artifact: artifact) as String,
  ) as std.types.NonEmptyStr
}

fn ubuntu_seeded_install_media_part_path(install_path: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat(install_path as String, ".part") as std.types.NonEmptyStr
}
