module extdeps.bmc.openbmc_password_ssh_transport


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https,
    locator: "sourceforge.net/projects/sshpass/",
  },
}

data openbmc_password_ssh_authority_anchor_scaffold_note: String = "SCAFFOLD (mandatory-tag corpus cadence) - the host scanner reads the correct sshpass_authority alias as absent, so the literal anchor duplicates its projection; sshpass_authority remains the semantic authority. This copy dissolves with the host seam under the corpus_scan_scaffold_note in v2.lens.mandatory_tag.corpus_scan when native witness realization runs the parse-grain corpus witness."

data openbmc_password_ssh_transport_note: String = "Every transport operation has fixed argv selected by the closed OpenBmcOperation interpreter. There is no command-string or caller-authored argv input. SSH verifies the target-specific known-hosts file and password material stays on inherited fd 0."

service openbmc.PasswordSshTransport {
  operation ReadFile {
    input { host: std.types.NonEmptyStr, username: std.types.NonEmptyStr, password: Secret, known_hosts_path: std.types.NonEmptyStr, path: std.types.NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["sshpass", "-d", "0", "ssh", "-T", "-o", "PreferredAuthentications=password,keyboard-interactive", "-o", "PubkeyAuthentication=no", "-o", "StrictHostKeyChecking=yes", "-o", "UserKnownHostsFile={known_hosts_path}", "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=10", "{username}@{host}", "--", "cat", "{path}"]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "closed OpenBMC password-SSH operation failed"
    }
  }

  operation ResolvePath {
    input { host: std.types.NonEmptyStr, username: std.types.NonEmptyStr, password: Secret, known_hosts_path: std.types.NonEmptyStr, path: std.types.NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["sshpass", "-d", "0", "ssh", "-T", "-o", "PreferredAuthentications=password,keyboard-interactive", "-o", "PubkeyAuthentication=no", "-o", "StrictHostKeyChecking=yes", "-o", "UserKnownHostsFile={known_hosts_path}", "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=10", "{username}@{host}", "--", "readlink", "-f", "{path}"]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "closed OpenBMC password-SSH operation failed"
    }
  }

  operation ParentDirectory {
    input { host: std.types.NonEmptyStr, username: std.types.NonEmptyStr, password: Secret, known_hosts_path: std.types.NonEmptyStr, path: std.types.NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["sshpass", "-d", "0", "ssh", "-T", "-o", "PreferredAuthentications=password,keyboard-interactive", "-o", "PubkeyAuthentication=no", "-o", "StrictHostKeyChecking=yes", "-o", "UserKnownHostsFile={known_hosts_path}", "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=10", "{username}@{host}", "--", "dirname", "{path}"]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "closed OpenBMC password-SSH operation failed"
    }
  }

  operation SystemdIsActive {
    input { host: std.types.NonEmptyStr, username: std.types.NonEmptyStr, password: Secret, known_hosts_path: std.types.NonEmptyStr, service: std.types.NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["sshpass", "-d", "0", "ssh", "-T", "-o", "PreferredAuthentications=password,keyboard-interactive", "-o", "PubkeyAuthentication=no", "-o", "StrictHostKeyChecking=yes", "-o", "UserKnownHostsFile={known_hosts_path}", "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=10", "{username}@{host}", "--", "systemctl", "is-active", "{service}"]
      stdin: password
    }
    exit {
      0 => Unit
      nonzero => String "closed OpenBMC password-SSH operation failed"
    }
  }

  operation SystemdRestart {
