module extdeps.bmc.redfish


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "dmtf.org/standards/redfish"
  }
}

fn redfish_memory_summary_from_gib(total_gib: std.measure.Gibibyte) -> extdeps.bmc.types.RedfishMemorySummary {
  extdeps.bmc.types.RedfishMemorySummary { total_memory_bytes: gibibyte_to_byte_size(g: total_gib) }
}

fn redfish_processor_summary(
  model: std.types.NonEmptyStr,
  processor_count: Int,
  core_count: std.measure.HardwareThreadCount,
  logical_processor_count: std.measure.HardwareThreadCount?
) -> extdeps.bmc.types.RedfishProcessorSummary {
  extdeps.bmc.types.RedfishProcessorSummary {
    model: model,
    processor_count: processor_count,
    core_count: core_count,
    logical_processor_count: logical_processor_count,
  }
}

fn redfish_system_inventory(
  model: std.types.NonEmptyStr,
  manufacturer: std.types.NonEmptyStr?,
  processor_model: std.types.NonEmptyStr,
  processor_count: Int,
  processor_core_count: std.measure.HardwareThreadCount,
  total_memory_gib: std.measure.Gibibyte,
  power_state: extdeps.bmc.types.RedfishPowerState,
  logical_processor_count: std.measure.HardwareThreadCount?
) -> extdeps.bmc.types.RedfishSystemInventory {
  extdeps.bmc.types.RedfishSystemInventory {
    model: model,
    manufacturer: manufacturer,
    serial_number: none,
    processor: redfish_processor_summary(
      model: processor_model,
      processor_count: processor_count,
      core_count: processor_core_count,
      logical_processor_count: logical_processor_count
    ),
    memory: redfish_memory_summary_from_gib(total_gib: total_memory_gib),
    power_state: power_state,
  }
}

fn redfish_power_consumed_total_watts(controls: List<extdeps.bmc.types.RedfishPowerControl>) -> std.measure.Watt? {
  fold(
    controls,
    init: v2.std.optional.Absent,
    f: (acc, ctrl) =>
      match ctrl.power_consumed_watts {
        v2.std.optional.Absent => acc
        v2.std.optional.Present { value: w } =>
          match acc {
            v2.std.optional.Absent => v2.std.optional.Present { value: w }
            v2.std.optional.Present { value: sum } => v2.std.optional.Present { value: watt(count: watt_count(sum) + watt_count(w)) }
          }
      }
  )
}

fn redfish_sensors_power_total_watts(sensors: List<extdeps.bmc.types.RedfishSensorReading>) -> std.measure.Watt? {
  fold(
    sensors,
    init: v2.std.optional.Absent,
    f: (acc, sensor) =>
      match sensor {
        PowerSensor { name: _, watts: reading } =>
          match reading {
            v2.std.optional.Absent => acc
            v2.std.optional.Present { value: w } =>
              match acc {
                v2.std.optional.Absent => v2.std.optional.Present { value: w }
                v2.std.optional.Present { value: sum } => v2.std.optional.Present { value: watt(count: watt_count(sum) + watt_count(w)) }
              }
          }
        TemperatureSensor { name: _, celsius: _ } => acc
        FanTachSensor { name: _, rpm: _ } => acc
      }
  )
}

fn bmc_telemetry_power_consumed_watts(snapshot: extdeps.bmc.types.BmcTelemetrySnapshot) -> std.measure.Watt? {
  match snapshot.power {
    v2.std.optional.Present { value: p } =>
      match redfish_power_consumed_total_watts(controls: p.controls) {
        v2.std.optional.Present { value: w } => v2.std.optional.Present { value: w }
        v2.std.optional.Absent =>
          match snapshot.sensors {
            v2.std.optional.Absent => none
            v2.std.optional.Present { value: s } => redfish_sensors_power_total_watts(sensors: s.sensors)
          }
      }
    v2.std.optional.Absent =>
      match snapshot.sensors {
        v2.std.optional.Absent => none
        v2.std.optional.Present { value: s } => redfish_sensors_power_total_watts(sensors: s.sensors)
      }
  }
}

fn redfish_primary_power_control(power: extdeps.bmc.types.RedfishPowerSubsystem) -> extdeps.bmc.types.RedfishPowerControl? {
  fold(
    power.controls,
    init: v2.std.optional.Absent,
    f: (acc, ctrl) =>
      match acc {
        v2.std.optional.Present { value: _ } => acc
        v2.std.optional.Absent => v2.std.optional.Present { value: ctrl }
      }
  )
}

fn bmc_ground_host_observations(snapshot: extdeps.bmc.types.BmcTelemetrySnapshot) -> extdeps.bmc.types.BmcGroundedHostObservations {
  extdeps.bmc.types.BmcGroundedHostObservations {
    processor_model: snapshot.system.processor.model,
    processor_core_count: snapshot.system.processor.core_count,
    total_memory_bytes: snapshot.system.memory.total_memory_bytes,
    power_consumed_watts: bmc_telemetry_power_consumed_watts(snapshot: snapshot),
  }
}

fn redfish_system_total_memory_bytes(inv: extdeps.bmc.types.RedfishSystemInventory) -> std.measure.ByteSize {
  inv.memory.total_memory_bytes
}
