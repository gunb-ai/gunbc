module extdeps.bmc.redfish


import extdeps.external_authority { ExternalAuthority }
import extdeps.firmware.types { FirmwareSemanticVersion }
import extdeps.uri { Uri, Https }
import std.measure { ByteSize, Gibibyte, HardwareThreadCount, Second, gibibyte_to_byte_size, second, watt, watt_count }
import extdeps.bmc.types { BmcGroundedHostObservations, BmcTelemetrySnapshot, FanTachSensor, RedfishAccountRole, RedfishMemorySummary, RedfishPowerControl, RedfishPowerState, RedfishPowerSubsystem, RedfishProcessorSummary, RedfishSensorReading, RedfishSystemInventory, TemperatureSensor, redfish_account_role_from_wire, redfish_account_role_wire }
import std.types { Bool, Int, List, NonEmptyStr, String, list_length, range }
import std.algebra { list_head, skip }
import std.optional { Present, Absent }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.languages.json.parse {
  parse_json_document, json_document_gap_text, json_field, json_field_string, json_field_bool, json_field_int,
  JsonDocumentParsed, JsonDocumentUnreadable, JsonFieldRead, FieldRead, FieldAbsent, FieldMalformed,
}
import extdeps.languages.json.emit { JsonValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject, json_object, json_kv, json_string, json_bool, json_int, json_array, serialize_json }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "dmtf.org/standards/redfish"
  }
}

fn redfish_memory_summary_from_gib(total_gib: Gibibyte) -> RedfishMemorySummary {
  RedfishMemorySummary { total_memory_bytes: gibibyte_to_byte_size(g: total_gib) }
}

fn redfish_processor_summary(
  model: NonEmptyStr,
  processor_count: Int,
  core_count: HardwareThreadCount,
  logical_processor_count: HardwareThreadCount?
) -> RedfishProcessorSummary {
  RedfishProcessorSummary {
    model: model,
    processor_count: processor_count,
    core_count: core_count,
    logical_processor_count: logical_processor_count,
  }
}

fn redfish_system_inventory(
  model: NonEmptyStr,
  manufacturer: NonEmptyStr?,
  processor_model: NonEmptyStr,
  processor_count: Int,
  processor_core_count: HardwareThreadCount,
  total_memory_gib: Gibibyte,
  power_state: RedfishPowerState,
  logical_processor_count: HardwareThreadCount?
) -> RedfishSystemInventory {
  RedfishSystemInventory {
    model: model,
    manufacturer: manufacturer,
    serial_number: none,
    processor: redfish_processor_summary(
      model: processor_model,
      processor_count: processor_count,
      core_count: processor_core_count,
      logical_processor_count: logical_processor_count
    ),
    memory: redfish_memory_summary_from_gib(total_gib: total_memory_gib),
    power_state: power_state,
  }
}

fn redfish_power_consumed_total_watts(controls: List<RedfishPowerControl>) -> Watt? {
  fold(
    controls,
    init: Absent,
    f: (acc, ctrl) =>
      match ctrl.power_consumed_watts {
        Absent => acc
        Present { value: w } =>
          match acc {
            Absent => Present { value: w }
            Present { value: sum } => Present { value: watt(count: watt_count(sum) + watt_count(w)) }
          }
      }
  )
}

fn redfish_sensors_power_total_watts(sensors: List<RedfishSensorReading>) -> Watt? {
  fold(
    sensors,
    init: Absent,
    f: (acc, sensor) =>
      match sensor {
        PowerSensor { name: _, watts: reading } =>
          match reading {
            Absent => acc
            Present { value: w } =>
              match acc {
                Absent => Present { value: w }
                Present { value: sum } => Present { value: watt(count: watt_count(sum) + watt_count(w)) }
              }
          }
        TemperatureSensor { name: _, celsius: _ } => acc
        FanTachSensor { name: _, rpm: _ } => acc
      }
  )
}

fn bmc_telemetry_power_consumed_watts(snapshot: BmcTelemetrySnapshot) -> Watt? {
  match snapshot.power {
    Present { value: p } =>
      match redfish_power_consumed_total_watts(controls: p.controls) {
        Present { value: w } => Present { value: w }
        Absent =>
          match snapshot.sensors {
            Absent => none
            Present { value: s } => redfish_sensors_power_total_watts(sensors: s.sensors)
          }
      }
    Absent =>
      match snapshot.sensors {
        Absent => none
        Present { value: s } => redfish_sensors_power_total_watts(sensors: s.sensors)
      }
  }
}

fn redfish_primary_power_control(power: RedfishPowerSubsystem) -> RedfishPowerControl? {
  fold(
    power.controls,
    init: Absent,
    f: (acc, ctrl) =>
      match acc {
        Present { value: _ } => acc
        Absent => Present { value: ctrl }
      }
  )
}

fn bmc_ground_host_observations(snapshot: BmcTelemetrySnapshot) -> BmcGroundedHostObservations {
  BmcGroundedHostObservations {
    processor_model: snapshot.system.processor.model,
    processor_core_count: snapshot.system.processor.core_count,
    total_memory_bytes: snapshot.system.memory.total_memory_bytes,
    power_consumed_watts: bmc_telemetry_power_consumed_watts(snapshot: snapshot),
  }
}

fn redfish_system_total_memory_bytes(inv: RedfishSystemInventory) -> ByteSize {
  inv.memory.total_memory_bytes
}

// DMTF REDFISH BASE MESSAGE REGISTRY, PasswordChangeRequired (DSP8011, Base 1.x): a service
// answers an authenticated request with this message when the account's password must be changed
// before any other access is granted, and the only admitted request is a PATCH of that account's
// Password property. It is not an authentication failure: the credential was accepted. Observed on
// ASRock Rack ALTRAD8UD-1L2T OpenBMC 3.22.00 (srv13, 2026-10-08) as HTTP 403 whose top-level
// @Message.ExtendedInfo carries MessageId "Base.1.16.0.PasswordChangeRequired"; a wrong password on
// the same service is a bare 401. The registry version varies by service, so the id is matched as
// the "Base." registry prefix plus the ".PasswordChangeRequired" key, and the message is read from
// either the top-level annotation (bmcweb) or the standard error object's annotation.
// THREE ARMS, BECAUSE THERE ARE THREE THINGS THE BODY CAN SAY, and the third one is not the second.
//
//   - it names the message, and the id it names TRAVELS with the arm. A verdict that reports "the message
//     was named" and then lets the consumer re-type the id is a verdict that invites a copy of a string
//     somebody else wrote; the only reading of this arm that says anything about a particular response is
//     the id the response itself contained (§4c: an annotation is never evidence that a machine claim holds,
//     and neither is a comment quoting a registry version).
//   - it was read, and does not name it.
//   - it could not be read at all. That is NOT the arm above: "the body is truncated", "the transport
//     returned nothing", "the JSON has a gap" are facts about the CAPTURE, and a consumer that reads them as
//     "the service did not ask for a password change" is drawing a conclusion about a service from the state
//     of its own notebook (§4d: do not assert as deduced what is only inferred). This module used to fold the
//     unreadable case into RedfishPasswordChangeNotIndicated, which is exactly that inference, made silently,
//     by a function whose name promises a verdict about the service.
// A BUILD THAT FORCES THE PUBLISHED CREDENTIAL'S CHANGE ON FIRST LOGIN, as the vendor's catalogue
// records it: the exact MessageId the build answers with and the version it was read on. Rows live in the
// vendor's module beside the release they describe (extdeps.boards.asrock_rack
// asrock_altrad8ud_bmc_3_22_00_first_login_password_change), so the next unit on that build inherits the
// fact; a build with no row asserts nothing. Which of our controllers answered it is a receipt in the
// observing layer, not a field here.
type RedfishFirstLoginPasswordChange {
  message_id: NonEmptyStr
  read_on: FirmwareSemanticVersion
  authority: ExternalAuthority
}

type RedfishPasswordChangeVerdict
  = RedfishPasswordChangeRequired { message_id: String }
  | RedfishPasswordChangeNotIndicated
  | RedfishResponseBodyUnreadable { cause: NonEmptyStr }

fn redfish_message_id_is_password_change_required(id: String) -> Bool {
  starts_with(s: id, prefix: "Base.") && ends_with(s: id, suffix: ".PasswordChangeRequired")
}

// THE ID IS RETURNED, NOT MERELY CONFIRMED. The id is the String that was READ, kept as a String rather
// than cast into a NonEmptyStr: the cast would be a claim about a byte string this module has not examined,
// and the reader that matters (redfish_message_id_is_password_change_required, above) has already checked the
// only structure that is being asserted. Nothing downstream needs a proof of non-emptiness; they need to know
// what the service said.
//
// A FieldMalformed MessageId is answered "no" rather than "unreadable", because this is a scan of an
// ANNOTATION LIST: one entry that is not shaped like an annotation does not make the response unreadable,
// and the fold keeps looking at the other entries. It is the whole @Message.ExtendedInfo member that cannot
// be read that earns RedfishResponseBodyUnreadable, below.
fn redfish_message_id_if_password_change_required(message: JsonValue) -> Optional<String> {
  match json_field_string(obj: message, key: "MessageId") {
    FieldRead { value: id } =>
      if redfish_message_id_is_password_change_required(id: id) {
        Present { value: id }
      } else {
        Absent
      }
    FieldAbsent => Absent
    FieldMalformed { cause: _ } => Absent
  }
}

// THE ANNOTATION LIST AS A SUM, because "there is no annotation" and "the annotation could not be read"
// are different answers, and the second is a fact about the capture rather than about the service.
fn redfish_extended_info_message_id(holder: JsonValue) -> RedfishExtendedInfoScan {
  match json_field(obj: holder, key: "@Message.ExtendedInfo") {
    FieldRead { value: v } =>
      match v {
        JsonArray { elements: elements } =>
          match fold(elements, init: Absent, f: fn(acc, m) {
            match acc {
              Present { value: found } => acc
              Absent => redfish_message_id_if_password_change_required(message: m)
            }
          }) {
            Present { value: found } => RedfishExtendedInfoNamesTheMessage { message_id: found }
            Absent => RedfishExtendedInfoHoldsNothing { scanned: list_length(items: elements) }
          }
        JsonNull => RedfishExtendedInfoHoldsNothing { scanned: 0 }
        JsonBool { value: _ } => RedfishExtendedInfoUnreadable { cause: "the annotation is a boolean, not the array the registry publishes" }
        JsonNumber { lexeme: _ } => RedfishExtendedInfoUnreadable { cause: "the annotation is a number, not the array the registry publishes" }
        JsonString { value: _ } => RedfishExtendedInfoUnreadable { cause: "the annotation is a string, not the array the registry publishes" }
        JsonObject { members: _ } => RedfishExtendedInfoUnreadable { cause: "the annotation is an object, not the array the registry publishes" }
      }
    FieldAbsent => RedfishExtendedInfoAbsent
    FieldMalformed { cause: cause } => RedfishExtendedInfoUnreadable { cause: cause }
  }
}

fn redfish_password_change_verdict(body: String) -> RedfishPasswordChangeVerdict {
  match parse_json_document(s: body) {
    // THE CAPTURE IS BROKEN, AND THAT IS SAID RATHER THAN RECORDED AS A VERDICT ABOUT THE SERVICE.
    JsonDocumentUnreadable { gap: gap } =>
      RedfishResponseBodyUnreadable { cause: join(["the response body did not parse as a JSON document: ", json_document_gap_text(gap: gap)], "") as NonEmptyStr }
    JsonDocumentParsed { value: doc } =>
      match redfish_extended_info_message_id(holder: doc) {
        RedfishExtendedInfoNamesTheMessage { message_id: message_id } =>
          RedfishPasswordChangeRequired { message_id: message_id }
        RedfishExtendedInfoHoldsNothing { scanned: _ } =>
          match redfish_password_change_verdict_in_error_object(doc: doc) {
            RedfishPasswordChangeRequired { message_id: message_id } =>
              RedfishPasswordChangeRequired { message_id: message_id }
            RedfishPasswordChangeNotIndicated => RedfishPasswordChangeNotIndicated
            RedfishResponseBodyUnreadable { cause: cause } => RedfishResponseBodyUnreadable { cause: cause }
          }
        // bmcweb publishes the annotation at the top level; if it is there and unreadable, the body cannot
        // answer the question and must not be recorded as having said "no".
        RedfishExtendedInfoUnreadable { cause: cause } => RedfishResponseBodyUnreadable { cause: cause }
        RedfishExtendedInfoAbsent =>
          match redfish_password_change_verdict_in_error_object(doc: doc) {
            RedfishPasswordChangeRequired { message_id: message_id } =>
              RedfishPasswordChangeRequired { message_id: message_id }
            RedfishPasswordChangeNotIndicated => RedfishPasswordChangeNotIndicated
            RedfishResponseBodyUnreadable { cause: cause } => RedfishResponseBodyUnreadable { cause: cause }
          }
      }
  }
}

// THE STANDARD ERROR OBJECT, same three-way answer. A present-but-unreadable `error` member is a capture
// fault, not a negative answer from the service.
fn redfish_password_change_verdict_in_error_object(doc: JsonValue) -> RedfishPasswordChangeVerdict {
  match json_field(obj: doc, key: "error") {
    FieldRead { value: err } =>
      match redfish_extended_info_message_id(holder: err) {
        RedfishExtendedInfoNamesTheMessage { message_id: message_id } =>
          RedfishPasswordChangeRequired { message_id: message_id }
        RedfishExtendedInfoHoldsNothing { scanned: _ } => RedfishPasswordChangeNotIndicated
        RedfishExtendedInfoUnreadable { cause: cause } => RedfishResponseBodyUnreadable { cause: cause }
        RedfishExtendedInfoAbsent => RedfishPasswordChangeNotIndicated
      }
    FieldAbsent => RedfishPasswordChangeNotIndicated
    FieldMalformed { cause: cause } => RedfishResponseBodyUnreadable { cause: cause }
  }
}

// HOW THE ANNOTATION ANSWERED, as four arms rather than a Bool, because the unreadable arms are what stop a
// consumer concluding "no password change requested" from a body it could not read.
type RedfishExtendedInfoScan
  = RedfishExtendedInfoNamesTheMessage { message_id: String }
  | RedfishExtendedInfoHoldsNothing { scanned: Int }
  | RedfishExtendedInfoAbsent
  | RedfishExtendedInfoUnreadable { cause: NonEmptyStr }

// THE DMTF REDFISH `ResetToDefaultsType` ENUM ──────────────────────────────────────────────────
//
// WHY THIS LIVES HERE AND NOT IN WHICHEVER MODULE HAPPENS TO ACTUATE A RESET. The three arms below are
// not a workflow's vocabulary: they are the members DMTF publishes for the Manager's ResetToDefaults
// action, and they are versioned by DMTF, not by this repository. DESIGN §3 requires an independently
// versioned upstream to be declared in its own extdeps module, with its source cited and its real names
// kept -- which is also what makes it reusable: a second Redfish consumer (a fleet-wide factory-reset job,
// a network-configuration audit) would otherwise have to import a machine-intake route, or re-mint the
// enum and drift from it.
//
// SOURCED FROM THE PUBLISHED SCHEMA, not from a transcription. The members, their meanings and the
// parameter name below were read out of the DMTF-published Manager schema at
// https://redfish.dmtf.org/schemas/v1/Manager.v1_19_3.json, `#/definitions/ResetToDefaults`:
//   parameters: { "ResetType": { "$ref": "#/definitions/ResetToDefaultsType", "requiredParameter": true } }
//   ResetToDefaultsType.enum: ["ResetAll", "PreserveNetworkAndUsers", "PreserveNetwork"]
// with the enumDescriptions quoted per arm below. Two facts that were NOT carried over, both because the
// schema says otherwise:
//   * The action's parameter is spelled `ResetType`, NOT `ResetToDefaultsType` -- the latter is the NAME OF
//     THE TYPE, not of the field. An implementation that puts the type's name in the body has not read the
//     action, and a firmware that demands it has not published it; that difference is a reported device
//     observation and lives in the observing layer, never here (§3: an observation this repository makes
//     is a receipt downstream, not a property of the upstream).
//   * `SensorThresholds` appears in some vendor implementations' generated enum (bmcweb's
//     redfish-core/include/generated/enums/manager.hpp) but is NOT in DMTF's published enum for this
//     schema version. A vendor extension is a vendor fact, not a DMTF fact; it does not join this sum from
//     an assumption about what a Redfish implementation ought to accept.
//
// THE WIRE NAMES ARE KEPT EXACTLY AS PUBLISHED, in the schema's own PascalCase, because that is the
// string an implementation puts in the parameter. The recovery route's judgement about which arm clears
// the user table is NOT here: that is a question about BMC recovery, not about the schema, and it stays in
// the module that asks it. What IS here is what each member PUBLISHES itself to do, in the schema's words,
// because that is the fact the route's judgement is made from.
type RedfishResetToDefaultsType
  = ResetAll
  | PreserveNetworkAndUsers
  | PreserveNetwork

// ── REDFISH ACCOUNT SERVICE: THE MANAGER ACCOUNT COLLECTION AND ITS ACCOUNTS ─────────────────
//
// THE UPSTREAM IS DMTF'S REDFISH ACCOUNT SCHEMA. The account resource is published as
// `ManagerAccount` and its collection as `ManagerAccountCollection` in the DMTF Redfish Account
// schema bundle (the schema that also carries the `AccountService` singleton); the wire spellings
// below -- `@odata.id`, `Members`, `Members@odata.count`, `UserName`, `Password`, `Enabled`,
// `RoleId`, `Locked` -- are taken verbatim from that schema's published PropertyNames and are NOT
// renamed. The `Role`/`RoleId` vocabulary is the same one `extdeps.bmc.types.RedfishAccountRole`
// owns; this module only reads it back through `redfish_account_role_from_wire`, so the schema's
// three published role words have exactly one authority in the tree.
//
// WHAT THE CAPTURES GROUND, AND WHAT THEY DO NOT. Two committed captures are the witnesses this
// section models itself against, both under artifacts/bmc/ with SHA256SUMS:
//   * srv13-first-contact-2026-10-07/AccountService_Accounts.json -- the ManagerAccountCollection as
//     served by the ASRock ALTRAD8UD-1L2T on OpenBMC 03.22.00. It carries `Members` as an array of
//     objects each holding exactly one string `@odata.id` ("/redfish/v1/AccountService/Accounts/root"), a
//     `Members@odata.count`, and the collection `@odata.type`
//     "#ManagerAccountCollection.ManagerAccountCollection". THIS is the grounding for an account's
//     identity as read from the collection: the `UserName` is the segment after the final `/` of a
//     member's `@odata.id`.
//   * srv13-first-contact-2026-10-07/bmc-3.22.00-factory-login-403.json -- the 403 body the factory
//     build answers an authenticated request with while the account's password must change; its
//     `@Message.ExtendedInfo` shape and `MessageId` ("Base.1.16.0.PasswordChangeRequired") ground
//     `redfish_password_change_required_body`, whose message id is supplied by the caller (the build's
//     policy row) rather than hardcoded, exactly as `redfish_password_change_verdict` reads it back.
//   * srv14-first-contact-2026-10-28 -- a managed (already-rotated) controller of the same board; its
//     captures are of inventory resources, confirming the `@odata.id`/`Members` idiom is the served
//     shape and not a srv13 artifact.
//
// THE CAPTURES CARRY NO ManagerAccount RESOURCE BODY. No committed capture holds a single account
// resource with `UserName`/`Enabled`/`RoleId`/`Locked` populated, so this module does not pretend a
// default for any of them: each is read as a `JsonFieldRead` whose `FieldAbsent` means "the served
// resource did not carry it" and whose `FieldMalformed` means "it carried something that is not the
// property." Turning an absent `Enabled` into `false`, or an absent `RoleId` into `ReadOnly`, is the
// fabricated default DESIGN §5 forbids; the reader hands the distinction up and lets the caller decide
// what an unread field means for its claim. Only the collection member's `@odata.id` is read as
// REQUIRED of a member, because a collection member with no identity could not be matched to anything.
//
// NOT DECLARED HERE: the `AccountService` singleton's lockout properties
// (`AccountLockoutThreshold`, `AccountLockoutDuration`, the counter-reset pair) are the property of
// the lockout lane and are declared by it in this same module (sibling, see the collision boundary;
// `RedfishAccountServiceLockoutServed` / `RedfishAccountServiceLockoutVerdict`). This section models
// only the account census, the account resource, and the two bodies the forced first-login flow reads
// and writes. It deliberately declares no `AccountService` resource type of its own, so the two lanes
// cannot drift on the one account-service surface.

// A ManagerAccount as read from a resource body. Every field is a typed read: present, absent, or
// malformed -- never a default. The password is NOT here: it is write-only, admitted only as the single
// member of the PATCH body built by `redfish_account_password_patch_body`, and no reader should ever
// surface it from a GET.
type RedfishManagerAccountRead {
  odata_id: JsonFieldRead<String>,
  user_name: JsonFieldRead<String>,
  enabled: JsonFieldRead<Bool>,
  locked: JsonFieldRead<Bool>,
  role_id: RedfishRoleIdRead,
}

// The `RoleId` reading kept honest: the schema publishes three role words, and a served value outside
// them is REPORTED (`Unknown`), not filed under the nearest published role.
type RedfishRoleIdRead
  = RedfishRoleIdAbsent
  | RedfishRoleIdServed { role: RedfishAccountRole }
  | RedfishRoleIdUnknown { word: String }
  | RedfishRoleIdMalformed { cause: String }

fn redfish_read_role_id(doc: JsonValue) -> RedfishRoleIdRead {
  match json_field_string(obj: doc, key: "RoleId") {
    FieldAbsent => RedfishRoleIdAbsent
    FieldMalformed { cause: c } => RedfishRoleIdMalformed { cause: c }
    FieldRead { value: word } => match redfish_account_role_from_wire(word: word) {
      Present { value: role } => RedfishRoleIdServed { role: role }
      Absent => RedfishRoleIdUnknown { word: word }
    }
  }
}

type RedfishAccountResourceRead
  = RedfishAccountResourceUnreadable { cause: String }
  | RedfishAccountResource { account: RedfishManagerAccountRead }

// Read one ManagerAccount resource. A document that does not parse is `Unreadable`; anything that parses
// is returned field-by-field as read, so an absent property stays absent rather than becoming a value.
fn redfish_manager_account_from_json(body: String) -> RedfishAccountResourceRead {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: g } =>
      RedfishAccountResourceUnreadable {
        cause: concat("the ManagerAccount resource is not a JSON document: ", json_document_gap_text(gap: g))
      }
    JsonDocumentParsed { value } => RedfishAccountResource {
      account: RedfishManagerAccountRead {
        odata_id: json_field_string(obj: value, key: "@odata.id"),
        user_name: json_field_string(obj: value, key: "UserName"),
        enabled: json_field_bool(obj: value, key: "Enabled"),
        locked: json_field_bool(obj: value, key: "Locked"),
        role_id: redfish_read_role_id(doc: value),
      }
    }
  }
}

// The ManagerAccountCollection census as served. The MEMBERS ARRAY is the census; the
// `Members@odata.count` is kept as a separate, honestly-read served field (the two can disagree on a
// real device -- srv13's sibling registry collection has a count of 4 over five members -- and which
// one the device "meant" is a device observation made downstream, never a silent reconciliation here).
type RedfishAccountCollectionRead
  = RedfishAccountCollectionUnreadable { cause: String }
  | RedfishAccountCollection {
      member_odata_ids: List<String>,
      members_odata_count: JsonFieldRead<Int>,
    }

// THE MEMBERS ARRAY IS THE CENSUS, read in one pass, and the reading REFUSES (no partial census) the
// moment any member fails to carry its single string `@odata.id`. There is no fill-in default and no
// pre-check that a later reader re-does (DESIGN §5: correctness by construction, not validation) -- the
// fold accumulates a `List<String>?` and, once it has seen a member it cannot name, stays `Absent`, so an
// unreadable census can never be assembled from partially-missing members. A malformed `@odata.id` is
// refused exactly as an absent one is: a member whose identity is not a string cannot be named.
fn redfish_member_odata_ids(members: List<JsonValue>) -> List<String>? {
  let start: List<String>? = Present { value: [] }
  fold(members, init: start, f: (acc, member) =>
    match acc {
      Absent => Absent
      Present { value: ids } => match json_field_string(obj: member, key: "@odata.id") {
        FieldRead { value: s } => Present { value: concat(ids, [s]) }
        FieldAbsent => Absent
        FieldMalformed { cause: _ } => Absent
      }
    }
  )
}

// THE COLLECTION DECIDES THE CENSUS, and only a document that parses and carries a Members array of
// single-string-`@odata.id` members can decide it. An unreadable collection is NOT an empty one -- an
// empty census would say "there is no root account," which is the widening that would let a managed
// credential be planned against a controller whose accounts nobody actually saw.
fn redfish_manager_account_collection_from_json(body: String) -> RedfishAccountCollectionRead {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: g } =>
      RedfishAccountCollectionUnreadable {
        cause: concat("the ManagerAccountCollection is not a JSON document: ", json_document_gap_text(gap: g))
      }
    JsonDocumentParsed { value } => match json_field(obj: value, key: "Members") {
      FieldAbsent => RedfishAccountCollectionUnreadable { cause: "the ManagerAccountCollection carries no Members member" }
      FieldMalformed { cause: c } => RedfishAccountCollectionUnreadable { cause: c }
      FieldRead { value: JsonArray { elements: elements } } =>
        match redfish_member_odata_ids(members: elements) {
          Absent => RedfishAccountCollectionUnreadable { cause: "a ManagerAccountCollection member carries no single string @odata.id" }
          Present { value: ids } => RedfishAccountCollection {
            member_odata_ids: ids,
            members_odata_count: json_field_int(obj: value, key: "Members@odata.count"),
          }
        }
      FieldRead { value: JsonNull } => RedfishAccountCollectionUnreadable { cause: "the ManagerAccountCollection Members member is null" }
      FieldRead { value: JsonBool { value: _ } } => RedfishAccountCollectionUnreadable { cause: "the ManagerAccountCollection Members member is not an array" }
      FieldRead { value: JsonNumber { lexeme: _ } } => RedfishAccountCollectionUnreadable { cause: "the ManagerAccountCollection Members member is not an array" }
      FieldRead { value: JsonString { value: _ } } => RedfishAccountCollectionUnreadable { cause: "the ManagerAccountCollection Members member is not an array" }
      FieldRead { value: JsonObject { members: _ } } => RedfishAccountCollectionUnreadable { cause: "the ManagerAccountCollection Members member is not an array" }
    }
  }
}

// THE ACCOUNT NAME A COLLECTION MEMBER PUBLISHES: the segment after the final `/` of its `@odata.id`
// ("/redfish/v1/AccountService/Accounts/root" -> "root"). This is the grounding for an account's `UserName` where no
// resource body was captured; where a resource is served its own `UserName` member is the stronger
// reading. A trailing slash, or an id that is only slashes, yields `Absent` -- an empty name is not an
// account name, and inventing one would name an account the device never listed.
fn redfish_manager_account_name_from_odata_id(id: String) -> String? {
  let segments = split(s: id, delimiter: "/")
  let count = list_length(items: segments)
  if count == 0 {
    Absent
  } else {
    match list_head(xs: skip(xs: segments, n: count - 1)) {
      Present { value: last } => if last == "" { Absent } else { Present { value: last } }
      Absent => Absent
    }
  }
}

// The PATCH body that writes a ManagerAccount's password -- the ONLY request the factory build admits
// while the forced change stands. It is a single-member object carrying `Password` (the schema's
// write-only property); nothing else belongs in it, and the caller must not read what it just wrote back.
fn redfish_account_password_patch_body(password: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "Password", value: json_string(s: password))
  ]))
}

// THE 403 BODY the 03.22.00 factory build serves for every authenticated request that is not the
// password change, while the account's forced change stands. It reproduces, member-for-member, srv13's
// committed capture (artifacts/bmc/srv13-first-contact-2026-10-07/bmc-3.22.00-factory-login-403.json):
// the `@Message.ExtendedInfo` array holds one `#Message.v1_1_1.Message` whose `Message` embeds the target
// URI, whose `MessageArgs` is the single target URI, and whose `MessageSeverity`/`Resolution` are the
// served strings. So the dry world answers a forced-change request with a body that
// `redfish_password_change_verdict` reads back exactly as it reads the capture -- the inhabitance check.
// The `MessageId` is the BUILD's: the caller (the build's policy row) supplies it, e.g.
// "Base.1.16.0.PasswordChangeRequired", matching what srv13 served. The target URI is the account's
// `@odata.id`, which srv13's ManagerAccountCollection published as "/redfish/v1/AccountService/Accounts/root".
fn redfish_password_change_required_body(account_odata_id: String, message_id: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "@Message.ExtendedInfo", value: json_array(elements: [
      json_object(members: [
        json_kv(key: "@odata.type", value: json_string(s: "#Message.v1_1_1.Message")),
        json_kv(key: "Message", value: json_string(s: concat("The password provided for this account must be changed before access is granted.  PATCH the Password property for this account located at the target URI '", account_odata_id, "' to complete this process."))),
        json_kv(key: "MessageArgs", value: json_array(elements: [
          json_string(s: account_odata_id)
        ])),
        json_kv(key: "MessageId", value: json_string(s: message_id)),
        json_kv(key: "MessageSeverity", value: json_string(s: "Critical")),
        json_kv(key: "Resolution", value: json_string(s: "Change the password for this account using a PATCH to the Password property at the URI provided."))
      ])
    ]))
  ]))
}

// THE BODY THE CONTROLLER SERVES for GET /redfish/v1/AccountService/Accounts: the ManagerAccountCollection,
// whose Members are the account `@odata.id`s and whose `Members@odata.count` is their count -- the same shape
// srv13 committed at artifacts/bmc/srv13-first-contact-2026-10-07/AccountService_Accounts.json (one member,
// root). It is the writer twin of `redfish_manager_account_collection_from_json`: the dry census read
// (gunbc.machine_intake.bmc_secure.dry_read_bmc_redfish_account_census) parses THESE bytes back through that
// reader, so what it reads are the bytes a controller would serve -- not a structure handed to it ready-made.
// The caller (gunbc.bmc_model) supplies the account odata ids the world carries; none are invented here.
// referenced-by: gunbc.bmc_model.bmc_redfish_account_collection_body
// schema: DMTF Redfish ManagerAccountCollection (RedfishAccountCollection), dmtf.org/standards/redfish
fn redfish_manager_account_collection_body(member_odata_ids: List<String>) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "@odata.id", value: json_string(s: "/redfish/v1/AccountService/Accounts")),
    json_kv(key: "@odata.type", value: json_string(s: "#ManagerAccountCollection.ManagerAccountCollection")),
    json_kv(key: "Name", value: json_string(s: "Accounts Collection")),
    json_kv(key: "Members", value: json_array(elements: map(member_odata_ids, id =>
      json_object(members: [json_kv(key: "@odata.id", value: json_string(s: id))])
    ))),
    json_kv(key: "Members@odata.count", value: json_int(n: list_length(items: member_odata_ids))),
  ]))
}

// THE BODY THE CONTROLLER SERVES for GET one ManagerAccount resource: the account's UserName, Enabled,
// Locked and RoleId, spelled the way the reader `redfish_manager_account_from_json` reads them back (a
// `RoleId` carrying one of the schema's three wire words). The caller (gunbc.bmc_model) supplies the fields
// from the world's account; the census read parses these bytes, so an unreadable or malformed body is a
// census the read must refuse rather than a value the model hands it.
// referenced-by: gunbc.bmc_model.bmc_redfish_account_member_body
// schema: DMTF Redfish ManagerAccount (RedfishAccountRole), dmtf.org/standards/redfish
fn redfish_manager_account_member_body(odata_id: String, user_name: String, enabled: Bool, locked: Bool, role: RedfishAccountRole) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "@odata.id", value: json_string(s: odata_id)),
    json_kv(key: "UserName", value: json_string(s: user_name)),
    json_kv(key: "Enabled", value: json_bool(b: enabled)),
    json_kv(key: "Locked", value: json_bool(b: locked)),
    json_kv(key: "RoleId", value: json_string(s: redfish_account_role_wire(role: role) as String)),
  ]))
}
// ── THE SERVED ACCOUNT-LOCKOUT POLICY ───────────────────────────────────────────────────────────────
//
// Whether a failed login locks an account, after how many, and for how long is NOT a fact this
// repository holds about a build. It is a property the SERVICE SERVES, on its own AccountService
// resource, and so it is read per controller beside the other account readings -- never declared per
// board or per firmware release here. What is declared here is only the upstream SHAPE: the published
// property names, their units, and what each published value itself says it does.
//
// UPSTREAM (the authority below; the four property definitions were read out of the DMTF-published
// schema in full today, not from a summary):
//   DMTF Redfish Account Service v1.19.0, resource AccountService,
//   https://redfish.dmtf.org/schemas/v1/AccountService.v1_19_0.json
//   retrieved 2026-10-29. Cited verbatim, in the schema's own words:
//     AccountLockoutThreshold (integer|null)
//       "This property shall contain the threshold of failed login attempts before a user account is
//       locked.  If `0`, the account shall never be locked."
//     AccountLockoutDuration (integer|null)
//       "... the period of time, in seconds, that an account is locked after the number of failed login
//       attempts reaches the `AccountLockoutThreshold` value, within the `AccountLockoutCounterResetAfter`
//       window of time.  The value shall be greater than or equal to the AccountLockoutCounterResetAfter
//       value.  If this value is `0`, no lockout shall occur.  If AccountLockoutCounterResetEnabled value
//       is `false`, this property shall be ignored."
//     AccountLockoutCounterResetAfter (integer)
//       "... the period of time, in seconds, from the last failed login attempt when the
//       AccountLockoutThreshold counter, which counts the number of failed login attempts, is reset to 0.
//       ... The threshold counter also resets to 0 after each successful login.  If the
//       AccountLockoutCounterResetEnabled value is `false`, this property shall be ignored."
//     AccountLockoutCounterResetEnabled (boolean)
//       "... whether the threshold counter is reset after the AccountLockoutCounterResetAfter expires.
//       If `true`, it is reset.  If `false`, only a successful login resets the threshold counter and if
//       the user reaches the AccountLockoutThreshold limit, the account shall be locked out indefinitely
//       and only an administrator-issued reset clears the threshold counter.  IF THIS PROPERTY IS ABSENT,
//       THE DEFAULT IS `true`."
//
// THE ABSENT-NESS OF A PROPERTY IS NOT A DEFAULT THIS REPOSITORY MAY SUBSTITUTE. Each field below is
// therefore an optional, except the threshold, which the budget cannot read as anything but served or
// not-served; the reading layer says which. `AccountLockoutCounterResetEnabled` keeps the schema's own
// documented default as a NAMED reading (`redfish_account_lockout_counter_reset_enabled_reads`), cited
// to the sentence quoted above -- the schema's default, not ours -- and a caller that will not read the
// schema's sentence is free to pass the property's absence through as `Bool?` = none and refuse.
//
// CONSUMER: gunbc.machine_intake.bmc_secure reads this shape per controller into its account-state
// observation (BmcLockoutSurfaceReading) and spends plans against it (the failed-login budget). Sibling
// consumer, agreed 2026-10-29: gunbc.bmc_model's BmcWorld locks a Redfish account when its failed-login
// counter reaches `account_lockout_threshold`, and never locks when that threshold is 0 (upstream text,
// quoted above, not an inference).

data redfish_account_service_lockout_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "redfish.dmtf.org/schemas/v1/AccountService.v1_19_0.json"
  }
}

// The four published properties, with the schema's PascalCase names carried in the field comments
// because those are the strings a service puts on the wire. The names in the record are snake_case for
// the same reason every other record here is snake_case; the citation is the comment, and the reading
// layer never re-derives a name from an assumption.
// ONE UPSTREAM TYPE FOR ALL THREE OF THESE PROPERTIES. Redfish declares
// AccountLockoutThreshold, AccountLockoutDuration and AccountLockoutCounterResetAfter
// all as the same Edm type with the same bounds, and a constraint cannot be written
// inside a generic argument (the checker wants Optional<X>, not Optional<X where …>),
// so the bounds are named once here and every field below says the same thing.
type RedfishAccountServicePropertyCount = Int where range(min: 0, max: 4294967295)

// THE HTTP STATES THAT MEAN "THE SERVICE ANSWERED, BUT NOT WITH THESE PROPERTIES".
// Named because a union arm cannot carry a where-clause of its own (the checker
// wants the closing brace after a plain type), and because the range is the point:
// a 2xx or a 3xx is not a refusal, and this arm must not be able to hold one.
type RedfishHttpErrorStatus = Int where range(min: 400, max: 599)

type RedfishAccountServiceLockoutServed sole_constructor {
  // "AccountLockoutThreshold": the threshold of failed login attempts before a user account is locked.
  // 0 shall never lock -- read it with redfish_account_lockout_threshold_locks_after, never by
  // comparing to zero at the use site, so the upstream sentence is stated once.
  account_lockout_threshold: RedfishAccountServicePropertyCount
  // "AccountLockoutDuration": seconds an account stays locked once the threshold is reached. 0 => no
  // lockout shall occur; ignored entirely when the reset-enabled flag is false.
  account_lockout_duration: Optional<RedfishAccountServicePropertyCount>
  // "AccountLockoutCounterResetAfter": seconds from the LAST failed attempt until the failed-attempt
  // counter returns to 0. A successful login also resets it, whatever this says.
  account_lockout_counter_reset_after: Optional<RedfishAccountServicePropertyCount>
  // "AccountLockoutCounterResetEnabled": whether the counter resets after that window at all. When the
  // service does not publish it the schema's own default is true (quoted above); none below means the
  // service did not publish it, and the caller decides whether to read the schema default or refuse.
  account_lockout_counter_reset_enabled: Optional<Bool>
}

// Whether the threshold locks at all, in upstream's words: 0 never locks; anything else locks at that
// many failures. Stated as a sum so no use site re-implements the zero case differently.
type RedfishAccountLockoutThresholdReading
  = AccountIsNeverLockedByServedThreshold
  | AccountLocksAfter { failed_attempts: Int where range(min: 1, max: 4294967295) }

// THE RESET WINDOW, IN THE REPO'S TIME UNIT. AccountService.v1_19_0 says
// AccountLockoutCounterResetAfter is "The number of seconds since the last failed
// login attempt" before the failed-login counter resets, so the seconds this
// property serves become a std.measure Second HERE, at the cited-upstream boundary,
// and not in whatever module ends up comparing them with a timestamp. An absent
// property is Absent: no window is invented for it. A product layer that carried
// this as a bare Int would be re-inventing a unit std.measure already owns
// (DESIGN.md section 2, "net concepts must not grow by re-invention").
// CONSUMER: bmc_failed_attempt_window in gunbc.machine_intake.bmc_secure.
fn redfish_account_lockout_counter_reset_window(served: RedfishAccountServiceLockoutServed) -> Optional<Second> {
  match served.account_lockout_counter_reset_after {
    Present { value: secs } => Present { value: second(count: secs) }
    Absent => Absent {  }
  }
}

// THE ONLY WAY TO HOLD ONE OF THESE OUTSIDE THIS MODULE: the served values come
// from a controller's own AccountService body, and the record is sole_constructor
// so nothing outside can fabricate one field by field. Nothing here fills a gap:
// an absent property stays Absent, and redfish_account_lockout_threshold_locks_after
// turns an absent threshold into an unread answer, never into 0.
// CONSUMER: the account-state reader of gunbc.machine_intake.bmc_secure (and its
// fixture test.fixture.machine_intake.bmc_lockout, and the dry BmcWorld's lock rule
// in gunbc.bmc_model, which reads the threshold through
// redfish_account_lockout_threshold_locks_after).
fn redfish_account_service_lockout_served(
  account_lockout_threshold: RedfishAccountServicePropertyCount,
  account_lockout_duration: Optional<RedfishAccountServicePropertyCount>,
  account_lockout_counter_reset_after: Optional<RedfishAccountServicePropertyCount>,
  account_lockout_counter_reset_enabled: Optional<Bool>,
) -> RedfishAccountServiceLockoutServed {
  RedfishAccountServiceLockoutServed {
    account_lockout_threshold: account_lockout_threshold,
    account_lockout_duration: account_lockout_duration,
    account_lockout_counter_reset_after: account_lockout_counter_reset_after,
    account_lockout_counter_reset_enabled: account_lockout_counter_reset_enabled,
  }
}

fn redfish_account_lockout_threshold_locks_after(served: RedfishAccountServiceLockoutServed) -> RedfishAccountLockoutThresholdReading {
  if served.account_lockout_threshold == 0 {
    AccountIsNeverLockedByServedThreshold
  } else {
    AccountLocksAfter { failed_attempts: served.account_lockout_threshold }
  }
}

// The schema's own default for an absent AccountLockoutCounterResetEnabled is true. That default is the
// SCHEMA's, quoted above; a caller that treats an absent property as no answer at all passes the none
// through instead of calling this, and the budget then refuses rather than assuming.
fn redfish_account_lockout_counter_reset_enabled_reads(served: RedfishAccountServiceLockoutServed) -> Bool {
  match served.account_lockout_counter_reset_enabled {
    Present { value: v } => v
    Absent => true
  }
}

// THE THREE ARMS, in the same shape as this module's password-change verdict: a service that answered,
// a service that would not answer because nothing is authenticated yet (the OpenBMC 03.22.00 case --
// every authenticated read, this one included, is refused with 403 Base.1.16.0.PasswordChangeRequired
// until the forced change is made), and a read that could not be read at all. None of the three is
// collapsed into another, and none of them is a number.
type RedfishAccountServiceLockoutVerdict
  = RedfishAccountServiceLockoutPropertiesRead { served: RedfishAccountServiceLockoutServed }
  | RedfishAccountServiceLockoutPropertiesNotAuthenticated { http_status: RedfishHttpErrorStatus, detail: NonEmptyStr }
  | RedfishAccountServiceLockoutPropertiesUnreadable { detail: NonEmptyStr }

// THE FRONTIER this section's consumer is waiting on. The dry world and the live reader both take this
// shape; what does not yet exist is a live read that mints it from a controller's AccountService
// document. Not dissolved by the dry realization.
data redfish_account_service_lockout_live_read_frontier: DissolutionCondition = unbound_dissolution(
  description: "dissolves when a live read of GET /redfish/v1/AccountService mints RedfishAccountServiceLockoutVerdict over the four published lockout properties for a controller this fleet operates, with the response body committed as content-addressed evidence under artifacts/bmc/*/; NOT satisfied by the dry world supplying the record, by a transcription of another controller's document, or by a read taken with no authenticated session (which must be recorded as PropertiesNotAuthenticated, never as zeroes)" as NonEmptyStr,
)
