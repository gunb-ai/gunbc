module extdeps.bmc.netrc

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { NonEmptyStr, String, Int, Bool, Secret, FilePath, List }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/inetutils/manual/html_node/The-_002enetrc-file.html"
  }
}

type NetrcResolution
  = NetrcResolved { login: NonEmptyStr, password: Secret }
  | NetrcRefused { cause: NetrcRefusalCause }

type NetrcRefusalCause
  = NetrcNoMatchingEntry { host: NonEmptyStr }
  | NetrcMalformedFile { detail: String }
  | NetrcFileUnreadable { detail: String }

fn netrc_resolve(file: FilePath, host: NonEmptyStr) -> NetrcResolution {
  let content = Filesystem.Read(path: file)
  if content.success == false {
    return NetrcRefused { cause: NetrcFileUnreadable { detail: content.error } }
  }
  netrc_resolve_from_text(text: content.content, host: host)
}

fn netrc_resolve_from_text(text: String, host: NonEmptyStr) -> NetrcResolution {
  let tokens = netrc_tokenize(text: text)
  netrc_search(tokens: tokens, host: host, dl: none, dp: none)
}

fn netrc_tokenize(text: String) -> List<String> {
  netrc_tokenize_loop(source: text, pos: 0, acc: [], current: "")
}

fn netrc_tokenize_loop(source: String, pos: Int, acc: List<String>, current: String) -> List<String> {
  if pos >= string_length(s: source) {
    if current == "" { acc }
    else { list_push(xs: acc, x: current) }
  } else {
    let ch = char_at(s: source, i: pos)
    if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
      if current == "" {
        netrc_tokenize_loop(source: source, pos: pos + 1, acc: acc, current: current)
      } else {
        netrc_tokenize_loop(source: source, pos: pos + 1, acc: list_push(xs: acc, x: current), current: "")
      }
    } else if ch == "\"" {
      netrc_tokenize_quoted(source: source, pos: pos + 1, acc: acc, current: current, quote: "\"")
    } else if ch == "'" {
      netrc_tokenize_quoted(source: source, pos: pos + 1, acc: acc, current: current, quote: "'")
    } else if ch == "#" {
      netrc_tokenize_skip_line(source: source, pos: pos + 1, acc: acc, current: current)
    } else {
      netrc_tokenize_loop(source: source, pos: pos + 1, acc: acc, current: concat(current, ch))
    }
  }
}

fn netrc_tokenize_quoted(source: String, pos: Int, acc: List<String>, current: String, quote: String) -> List<String> {
  if pos >= string_length(s: source) {
    list_push(xs: acc, x: current)
  } else {
    let ch = char_at(s: source, i: pos)
    if ch == quote {
      netrc_tokenize_loop(source: source, pos: pos + 1, acc: list_push(xs: acc, x: current), current: "")
    } else {
      netrc_tokenize_quoted(source: source, pos: pos + 1, acc: acc, current: concat(current, ch), quote: quote)
    }
  }
}

fn netrc_tokenize_skip_line(source: String, pos: Int, acc: List<String>, current: String) -> List<String> {
  if pos >= string_length(s: source) {
    if current == "" { acc }
    else { list_push(xs: acc, x: current) }
  } else {
    let ch = char_at(s: source, i: pos)
    if ch == "\n" || ch == "\r" {
      netrc_tokenize_loop(source: source, pos: pos + 1, acc: acc, current: current)
    } else {
      netrc_tokenize_skip_line(source: source, pos: pos + 1, acc: acc, current: current)
    }
  }
}

fn netrc_search(tokens: List<String>, host: NonEmptyStr, dl: String?, dp: Secret?) -> NetrcResolution {
  if tokens.length() == 0 {
    netrc_no_match_or_default(dl: dl, dp: dp, host: host)
  } else {
    match tokens.first() {
      Present { value: kw } => {
        let rest = tokens.skip(n: 1)
        if kw == "machine" {
          match rest.first() {
            Present { value: eh } =>
              if eh == (host as String) { netrc_read_entry(tokens: rest.skip(n: 1), login: none, password: none, dl: dl, dp: dp, is_machine: true, host: host) }
              else { netrc_skip_entry(tokens: rest.skip(n: 1), host: host, dl: dl, dp: dp) }
            Absent => NetrcRefused { cause: NetrcMalformedFile { detail: "machine keyword without hostname" } }
          }
        } else if kw == "default" {
          netrc_read_entry(tokens: rest, login: none, password: none, dl: dl, dp: dp, is_machine: false, host: host)
        } else {
          netrc_search(tokens: rest, host: host, dl: dl, dp: dp)
        }
      }
      Absent => netrc_no_match_or_default(dl: dl, dp: dp, host: host)
    }
  }
}

fn netrc_skip_entry(tokens: List<String>, host: NonEmptyStr, dl: String?, dp: Secret?) -> NetrcResolution {
  if tokens.length() == 0 {
    netrc_no_match_or_default(dl: dl, dp: dp, host: host)
  } else {
    match tokens.first() {
      Present { value: kw } =>
        if kw == "machine" || kw == "default" { netrc_search(tokens: tokens, host: host, dl: dl, dp: dp) }
        else { netrc_skip_entry(tokens: tokens.skip(n: 1), host: host, dl: dl, dp: dp) }
      Absent => netrc_no_match_or_default(dl: dl, dp: dp, host: host)
    }
  }
}

fn netrc_read_entry(tokens: List<String>, login: String?, password: Secret?, dl: String?, dp: Secret?, is_machine: Bool, host: NonEmptyStr) -> NetrcResolution {
  if tokens.length() == 0 {
    netrc_finish_entry(login: login, password: password, dl: dl, dp: dp, is_machine: is_machine, host: host)
  } else {
    match tokens.first() {
      Present { value: kw } => {
        let rest = tokens.skip(n: 1)
        if kw == "login" {
          match rest.first() {
            Present { value: v } => netrc_read_entry(tokens: rest.skip(n: 1), login: Present { value: v }, password: password, dl: dl, dp: dp, is_machine: is_machine, host: host)
            Absent => NetrcRefused { cause: NetrcMalformedFile { detail: "login without value" } }
          }
        } else if kw == "password" {
          match rest.first() {
            Present { value: v } => netrc_read_entry(tokens: rest.skip(n: 1), login: login, password: Present { value: v as Secret }, dl: dl, dp: dp, is_machine: is_machine, host: host)
            Absent => NetrcRefused { cause: NetrcMalformedFile { detail: "password without value" } }
          }
        } else if kw == "machine" || kw == "default" {
          netrc_finish_entry(login: login, password: password, dl: dl, dp: dp, is_machine: is_machine, host: host)
        } else {
          netrc_read_entry(tokens: rest, login: login, password: password, dl: dl, dp: dp, is_machine: is_machine, host: host)
        }
      }
      Absent => netrc_finish_entry(login: login, password: password, dl: dl, dp: dp, is_machine: is_machine, host: host)
    }
  }
}

fn netrc_finish_entry(login: String?, password: Secret?, dl: String?, dp: Secret?, is_machine: Bool, host: NonEmptyStr) -> NetrcResolution {
  if is_machine {
    match login {
      Present { value: l } => match password {
        Present { value: p } => NetrcResolved { login: l as NonEmptyStr, password: p }
        Absent => NetrcRefused { cause: NetrcMalformedFile { detail: concat("machine ", host, " has login but no password") } }
      }
      Absent => match password {
        Present { value: _ } => NetrcRefused { cause: NetrcMalformedFile { detail: concat("machine ", host, " has password but no login") } }
        Absent => NetrcRefused { cause: NetrcMalformedFile { detail: concat("machine ", host, " has neither login nor password") } }
      }
    }
  } else {
    match login {
      Present { value: l } => match password {
        Present { value: p } => NetrcResolved { login: l as NonEmptyStr, password: p }
        Absent => NetrcRefused { cause: NetrcMalformedFile { detail: "default has login but no password" } }
      }
      Absent => match password {
        Present { value: _ } => NetrcRefused { cause: NetrcMalformedFile { detail: "default has password but no login" } }
        Absent => netrc_no_match_or_default(dl: dl, dp: dp, host: host)
      }
    }
  }
}

fn netrc_no_match_or_default(dl: String?, dp: Secret?, host: NonEmptyStr) -> NetrcResolution {
  match dl {
    Present { value: l } => match dp {
      Present { value: p } => NetrcResolved { login: l as NonEmptyStr, password: p }
      Absent => NetrcRefused { cause: NetrcMalformedFile { detail: "prior default has login but no password" } }
    }
    Absent => match dp {
      Present { value: _ } => NetrcRefused { cause: NetrcMalformedFile { detail: "prior default has password but no login" } }
      Absent => NetrcRefused { cause: NetrcNoMatchingEntry { host: host } }
    }
  }
}
