module extdeps.bmc.ipmitool_raw_reply

import std.types { Bool, Int, List, String }
import std.optional { Present, Absent }
import std.algebra { trim, list_snoc_item }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.numeric.base16 { base16_word_value }
import std.integer { uint8_of_int, UInt8Ready, UInt8OutOfRange }
import extdeps.uri { Uri, Https }

// ── HOW ipmitool `raw` SPELLS BYTES, BOTH WAYS. ipmitool prints a raw response as two-digit hex bytes
// separated by spaces, wrapping long responses across lines, and takes each request byte as one argv
// word. This is the client's format, the same for every raw command, so it lives once here: each
// command's module reads its answer and spells its request through these two functions rather than
// carrying its own copy (two copies had already diverged on whether a line break separates bytes).
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ipmitool/ipmitool"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.ipmitool_raw_reply",
      decl_name: "ipmitool_raw_reply_bytes",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// One two-digit hex byte, either case.
fn ipmitool_raw_byte_value(t: String) -> Int? {
  if length(t) != 2 { none } else { base16_word_value(word: t, max_digits: 2) }
}

// The bytes of a raw response, in wire order. Line breaks separate bytes like spaces do. Every token
// must be a two-digit hex byte and the count must be the count expected; otherwise the response is
// refused whole.
fn ipmitool_raw_reply_bytes(stdout: String, expected: Int) -> List<Int>? {
  let tokens = filter(split(s: join(split(s: trim(stdout), delimiter: "\n"), " "), delimiter: " "), t => t != "")
  let values = map(tokens, t => ipmitool_raw_byte_value(t: t))
  if count(tokens) != expected || any(values, v => match v { Absent => true Present { value: _ } => false }) { none } else {
    Present { value: flat_map(values, v => match v { Absent => [] Present { value: x } => [x] }) }
  }
}

// One request byte as ipmitool takes it: "0x" and two lowercase hex digits. A value that is not a
// byte has no spelling, so it is refused here through std.integer's byte admission rather than
// indexed into the alphabet; every caller that writes argv goes through this refusal.
fn ipmitool_raw_byte_text(n: Int) -> String? {
  match uint8_of_int(value: n) {
    UInt8OutOfRange { observed: _ } => none
    UInt8Ready { value: b } => {
      let digits = "0123456789abcdef"
      Present { value: concat("0x", char_at(s: digits, pos: b / 16), char_at(s: digits, pos: b % 16)) }
    }
  }
}

// The same byte in a report, never on a wire: a value that is not a byte is named as such rather
// than given a spelling it does not have.
fn ipmitool_raw_byte_report(n: Int) -> String {
  match ipmitool_raw_byte_text(n: n) {
    Present { value: t } => t
    Absent => concat(to_string(n), " (not a byte)")
  }
}

// ── HOW ipmitool `raw` REPORTS A REFUSED COMMAND, BOTH WAYS. When the controller answers with a nonzero
// completion code, ipmitool prints nothing on stdout and one line on stderr (lib/ipmi_raw.c, ipmi_raw_main):
//   "Unable to send RAW command (channel=0x%x netfn=0x%x lun=0x%x cmd=0x%x rsp=0x%x): %s"
// with the code's name from completion_code_vals (lib/ipmi_strings.c), and exits nonzero; when no answer
// arrived at all it prints the same prefix WITHOUT "rsp=". So "rsp=0x" is exactly the mark of an answered
// refusal, the same for every raw command -- which is why this parse lives here, once, and not per command.

// The completion code ipmitool names on stderr ("rsp=0xc7"), when it names one. Absent means the command was
// not answered with a code (a transport failure, a timeout), never that it succeeded.
fn ipmitool_raw_stderr_completion(stderr: String) -> Int? {
  let parts = split(s: stderr, delimiter: "rsp=0x")
  if count(parts) < 2 { none } else {
    let rest = match parts.skip(n: 1).first() { Absent => "" Present { value: r } => r }
    if rest.length() < 2 { none } else { ipmitool_raw_byte_value(t: substring(s: rest, start: 0, end: 2)) }
  }
}

// ipmitool's "%x": lowercase hex, no padding, no leading zeros.
fn ipmitool_raw_hex_unpadded(n: Int) -> String {
  let digits = "0123456789abcdef"
  if n < 16 { char_at(s: digits, pos: n) } else { concat(ipmitool_raw_hex_unpadded(n: n / 16), char_at(s: digits, pos: n % 16)) }
}

// The stderr line ipmitool prints for a raw command the controller refused, as the format above renders it
// for the local channel and LUN 0 -- the shape a modelled controller's refusal must take so that the same
// parse (ipmitool_raw_stderr_completion) reads it back.
fn ipmitool_raw_refusal_stderr(netfn: Int, cmd: Int, completion: Int, completion_name: String) -> String {
  join(["Unable to send RAW command (channel=0x0 netfn=0x", ipmitool_raw_hex_unpadded(n: netfn), " lun=0x0 cmd=0x", ipmitool_raw_hex_unpadded(n: cmd), " rsp=0x", ipmitool_raw_hex_unpadded(n: completion), "): ", completion_name, "\n"], "")
}

// ONE RAW REQUEST, AS THE ARGV CARRIES IT: `raw <netfn> <cmd> <data...>`, each word a byte ipmitool reads
// with strtol (the corpus spells them "0x" plus two hex digits, ipmitool_raw_byte_text). The request data is
// everything after the command byte, in wire order. A word after `raw` that is not such a byte refuses the
// whole request rather than being skipped.
type IpmitoolRawRequest {
  netfn: Int
  cmd: Int
  data: List<Int>
}

fn ipmitool_raw_request_byte(word: String) -> Int? {
  if length(word) != 4 || substring(s: word, start: 0, end: 2) != "0x" { none } else { ipmitool_raw_byte_value(t: substring(s: word, start: 2, end: 4)) }
}

fn ipmitool_raw_request_of_argv(argv: List<String>) -> IpmitoolRawRequest? {
  let after = fold(argv, init: [], f: fn(acc, w) { if count(acc) > 0 || w == "raw" { list_snoc_item(xs: acc, item: w) } else { acc } })
  let words = after.skip(n: 1)
  let bytes = map(words, w => ipmitool_raw_request_byte(word: w))
  if count(words) < 2 || any(bytes, b => match b { Absent => true Present { value: _ } => false }) { none } else {
    let values = flat_map(bytes, b => match b { Absent => [] Present { value: x } => [x] })
    Present { value: IpmitoolRawRequest {
      netfn: match values.first() { Absent => 0 Present { value: x } => x },
      cmd: match values.skip(n: 1).first() { Absent => 0 Present { value: x } => x },
      data: values.skip(n: 2),
    } }
  }
}
