module extdeps.bmc.serial_console


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openbmc/obmc-console"
  }
}

data redfish_serial_interface_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "redfish.dmtf.org/schemas/v1/SerialInterface.json"
  }
}

type SolConsoleTransport
  = ObmcConsoleCli
  | RedfishSerialInterface

type SolConsoleCaptureIntent {
  bmc_host: NonEmptyStr
  transport: SolConsoleTransport
  output_path: NonEmptyStr
}

type SolConsoleCaptureOutcome
  = CaptureRunning
  | CaptureCompleted
  | CaptureRefused { reason: NonEmptyStr }

type SolConsoleCaptureReceipt {
  bmc_host: NonEmptyStr
  transport: SolConsoleTransport
  log_path: NonEmptyStr
  bytes_captured: ByteSize
  duration_ms: Milliseconds
  outcome: SolConsoleCaptureOutcome
}

fn sol_console_transport_wire(transport: SolConsoleTransport) -> NonEmptyStr {
  match transport {
    ObmcConsoleCli => "obmc-console"
    RedfishSerialInterface => "redfish-serial-interface"
  }
}

fn sol_console_transport_authority_for(transport: SolConsoleTransport) -> ExternalAuthority {
  match transport {
    ObmcConsoleCli => extdeps_external_authority_anchor
    RedfishSerialInterface => redfish_serial_interface_authority
  }
}

data sol_console_capture_bash_emit_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.bmc.serial_console",
    decl_name: "sol_console_capture_script",
    field: WholeDeclaration
  }
}

fn sol_console_capture_script(intent: SolConsoleCaptureIntent) -> String {
  let transport_wire = sol_console_transport_wire(transport: intent.transport)
  concat(
    concat(
      concat(
        concat(
          concat("#!/usr/bin/env bash\nset -euo pipefail\nLOG=", intent.output_path as String),
          "\nobmc-console-client ",
        ),
        intent.bmc_host as String,
      ),
      concat(" > \"", intent.output_path as String),
    ),
    concat("\" 2>&1 &\necho \"SolConsoleCaptureReceipt: transport=", transport_wire as String, " log=", intent.output_path as String, "\"\n"),
  )
}
