module extdeps.bmc.megarac_fan_policy

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.bmc.endpoint { BmcProtocol, Ipmi }
import extdeps.external_authority {
  CitedFigureStanding,
  ExternalAuthority,
  ExternalModelScope,
  ExternalSubjectRef,
  TranscribedUncited,
  cited_figure_read_obligation,
}
import extdeps.uri { Https, Uri }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.ami.com/megarac/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.megarac_fan_policy",
      decl_name: "megarac_fan_policy_standing",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE MEGARAC FAN POLICY AUTHORITY, SEPARATE FROM extdeps.bmc.phosphor_fan_control BECAUSE THE TWO
// FAMILIES ARE TWO UPSTREAMS. This module and that one answer the same QUESTION - under what
// condition does a controller stop tracking host thermals and hold a fixed duty - and they must
// never answer it through one shared enum. A single FanControlFamily variant would make a MegaRAC
// change editable only by touching OpenBMC's row, which is the fusion DESIGN §3 'External upstream
// decomposition' forbids. What is shared is the consuming vocabulary in product.fan_policy_standing,
// which takes the family's authority as a REFERENCE rather than enumerating families.
//
// IT IS A SEPARATE FILE FROM extdeps.bmc.megarac for the reason that module's own header gives:
// rows there are the SP-X REST operation shapes this repository has executed, with one declared
// subject. Fan policy is a different subject with a different evidentiary standing - nothing here
// has been executed at all - and mixing an unexecuted policy claim into a module of executed
// operation shapes is how an unexecuted claim gets read as an executed one.

// WHAT THIS REPOSITORY HAS ACTUALLY READ ABOUT MEGARAC FAN POLICY: NOTHING, AND THAT IS THE ROW.
//
// This is the §4d instrument used for exactly its purpose. It would be easy to write a plausible
// family row here - 'MegaRAC runs a vendor thermal loop that reaches full duty when host sensors are
// absent' - and it might even be true. It is not CITED, and the receipt DESIGN §4d records
// (node_power_envelope's altra_two_dpc_ceilings) is precisely a transcribed figure that a consumer
// then read as a wall. So the family's policy is carried as a bet with a named discriminator, and
// the consumer that reads it refuses rather than concluding.
//
// WHAT WOULD GROUND IT, stated so a later reader knows what to go and get: AMI's MegaRAC fan/thermal
// control documentation for the build under test, naming (a) whether the controller has a failsafe
// state at all, (b) what enters and leaves it, and (c) the duty it holds. Until one of those is
// read, the answer to 'why does Mt. Collins not sit at failsafe' may not be sourced from this
// module - it comes from the observation producer in the observing layer.
data megarac_fan_policy_standing: CitedFigureStanding = TranscribedUncited { read_obligation: "AMI MegaRAC fan/thermal control documentation for the build under test: whether a failsafe state exists, what enters and leaves it, and the duty held in it. No arm of this module may be read as established until that document is cited here." }

fn megarac_fan_policy_read_obligation() -> NonEmptyStr? {
  cited_figure_read_obligation(standing: megarac_fan_policy_standing)
}

// THE CONVERGE SURFACE, MODELED AS UNBOUND RATHER THAN GUESSED.
//
// A MegaRAC build sets its fan mode either through the proprietary REST surface or through an IPMI
// OEM command, and which one a build offers is a BUILD fact, not a family one. This lane was asked
// to model the surface and not to write through it, so what is declared is the shape of the binding
// that is missing - not a path and not a netfn/cmd pair. Writing plausible OEM bytes here would be
// worse than leaving it unbound: an OEM command byte that means 'set fan mode' on one vendor's build
// means something else on another, and the failure mode of guessing is a write to an unknown
// register on a machine in someone's home.
//
// The protocol floor is the one thing that IS known at family grain, and it is consumed from
// extdeps.bmc.megarac's own floor rather than restated: IPMI is guaranteed, Redfish is per-build.
type MegaRacFanModeSurface
  = MegaRacFanModeSurfaceUnbound { read_obligation: NonEmptyStr }
  | MegaRacFanModeSurfaceBound { protocol: BmcProtocol, contract_note: NonEmptyStr }

data megarac_fan_mode_surface: MegaRacFanModeSurface = MegaRacFanModeSurfaceUnbound { read_obligation: "bind this to the build's own fan-mode operation - the SP-X REST path or the documented IPMI OEM command - only after reading AMI's documentation for that build; no byte sequence may be authored from inference" }

fn megarac_fan_mode_surface_read_obligation(surface: MegaRacFanModeSurface) -> NonEmptyStr? {
  match surface {
    MegaRacFanModeSurfaceUnbound { read_obligation: o } => Present { value: o }
    MegaRacFanModeSurfaceBound { protocol: _, contract_note: _ } => Absent
  }
}

// THE ONE PROTOCOL A CONVERGE MAY ASSUME AT FAMILY GRAIN. Stated as a function over the surface
// rather than a bare row so that a bound surface answers with its OWN protocol and an unbound one
// answers with the family floor, which is IPMI. A consumer that took Redfish from a family row would
// be taking a per-build fact from the wrong grain.
fn megarac_fan_mode_protocol_floor(surface: MegaRacFanModeSurface) -> BmcProtocol {
  match surface {
    MegaRacFanModeSurfaceUnbound { read_obligation: _ } => Ipmi
    MegaRacFanModeSurfaceBound { protocol: p, contract_note: _ } => p
  }
}
