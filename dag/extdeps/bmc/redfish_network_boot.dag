module extdeps.bmc.redfish_network_boot

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.integer { int_to_decimal_string }
import std.optional { Present, Absent, Optional }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.goal_assessment { ObservationAttempt, ObservationEstablished, ObservationRefused }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.languages.json.emit { JsonValue, JsonKeyValue, JsonNull, JsonBool, JsonNumber, JsonString, JsonArray, JsonObject, json_kv, json_string, json_array, json_object, json_int, serialize_json }
import extdeps.languages.json.parse {
  parse_json_document, JsonDocumentParsed, JsonDocumentUnreadable, json_document_gap_text,
  FieldAbsent, FieldRead, FieldMalformed, json_field, json_field_string, json_field_bool, json_field_int,
}

// THE Redfish NIC AND BOOT-OPTION RESOURCES, READ (DMTF EthernetInterface and BootOption schemas).
//
// WHY THIS MODULE EXISTS. No extdeps reader consumes `Systems/<id>/EthernetInterfaces` or
// `Systems/<id>/BootOptions`, so the committed captures of both sat unread in the tree (the gap table's
// `EthernetInterfaces U` and srv13's `Systems_system_BootOptions.json`). They are the only BMC-side evidence
// that names a boot NIC at all: the IPMI boot-parameters have no NIC field, so "which port did the firmware
// boot from" is answerable from the Redfish service or not at all. Reading them here — and nowhere else — is
// what lets the boot-NIC reading in gunbc.machine_intake.bmc_first_contact_reading be a read rather than an
// inference.
//
// WHAT THIS MODULE DOES NOT DECIDE (DESIGN section 3): it says what the service published, per member. Which
// member is the boot NIC, whether an ambiguity refuses, and what standing the answer carries belong to gunbc.
// In particular this module never selects an interface: a collection of members is returned as the members it
// is, and picking one is a decision with a named owner downstream.
//
// THE RENDER SIDE SITS BESIDE THE PARSE SIDE (DESIGN §2: model a concept once and derive every use): the two render functions below emit exactly
// the shapes parsed here, so a dry controller (gunbc.bmc_dry_realization) can answer these GETs from state.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "redfish.dmtf.org/schemas/v1/EthernetInterface.json"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.redfish_network_boot",
      decl_name: "RedfishEthernetInterfaceRead",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// ONE EthernetInterface RESOURCE. `Id` is required (a resource that does not name itself is unreadable, not
// anonymous); `Name`, `MACAddress` and `LinkStatus` are kept as absent when the service omits them — an
// omitted MAC is not a zeroed MAC, and an omitted link state is not LinkDown. The MAC is kept as the string
// published: no re-formatting, no case folding, no validation. Two resources that print the same address
// differently are the caller's join problem, and normalizing here would hide that.
// THE UPSTREAM'S OWN KEY VOCABULARY, SPELLED ONCE. The readers look these keys up and the render side prints
// the same keys, so a modeled body can never be written in a shape the reader would refuse (DESIGN section 3:
// each fact lives in exactly one place). Keys a body is read for but never rendered (`Boot`,
// `BootSourceOverride*`, `message`) stay at their site: they are read once, by one reader.
data redfish_key_id: String = "Id"
data redfish_key_members: String = "Members"
data redfish_key_members_odata_count: String = "Members@odata.count"
data redfish_key_uefi_device_path: String = "UefiDevicePath"
data redfish_key_odata_type: String = "@odata.type"
data redfish_key_name: String = "Name"
data redfish_key_mac_address: String = "MACAddress"
data redfish_key_link_status: String = "LinkStatus"
data redfish_key_error: String = "error"
data redfish_key_display_name: String = "DisplayName"
data redfish_key_code: String = "code"
data redfish_key_boot_option_enabled: String = "BootOptionEnabled"

type RedfishEthernetInterfaceRead {
  id: NonEmptyStr
  name: String?
  mac_address: String?
  link_status: String?
}

// One BootOption: the UEFI device path is the only member that can name hardware, and it is kept verbatim for
// the same reason the MAC is. `BootOptionEnabled` absent is "the service did not say", not disabled.
type RedfishBootOptionRead {
  id: NonEmptyStr
  display_name: String?
  uefi_device_path: String?
  enabled: Bool?
}

// The BootOptions collection answered, or the service's own refusal. srv13's committed capture IS the second
// arm — `Systems_system_BootOptions.json` carries the Base.1.16.0.ResourceNotFound error envelope — and a
// service that says the resource does not exist has answered a question; it has not failed to answer it.
// Keeping the two apart is what lets gunbc record an ESTABLISHED negative instead of a missing read.
type RedfishBootOptionsRead
  = BootOptionsListed { options: List<RedfishBootOptionRead> }
  | BootOptionsNotServed { message: NonEmptyStr }

fn redfish_network_boot_document(body: String, what: String) -> ObservationAttempt<JsonValue, NonEmptyStr> {
  match parse_json_document(s: body) {
    JsonDocumentParsed { value: v } => ObservationEstablished { observed: v }
    JsonDocumentUnreadable { gap: g } => ObservationRefused {
      cause: concat("the ", what, " body is unreadable JSON: ", json_document_gap_text(gap: g)) as NonEmptyStr
    }
  }
}

// The optional string member, kept absent when the service omits it.
fn redfish_network_boot_optional_string(obj: JsonValue, key: String) -> String? {
  match json_field_string(obj: obj, key: key) {
    FieldAbsent => none
    FieldMalformed { cause: c } => none
    FieldRead { value: s } => if s == "" { none } else { Present { value: s } }
  }
}

fn redfish_network_boot_optional_bool(obj: JsonValue, key: String) -> Bool? {
  match json_field_bool(obj: obj, key: key) {
    FieldAbsent => none
    FieldMalformed { cause: c } => none
    FieldRead { value: b } => Present { value: b }
  }
}

// ONE EthernetInterface resource body. A resource with no `Id` is refused rather than anonymous: an
// anonymous member cannot be joined to a boot option, and a silent default `Id` would fabricate the join key.
fn redfish_ethernet_interface_of(body: String) -> ObservationAttempt<RedfishEthernetInterfaceRead, NonEmptyStr> {
  match redfish_network_boot_document(body: body, what: "EthernetInterface") {
    ObservationRefused { cause: c } => ObservationRefused { cause: c }
    ObservationEstablished { observed: doc } => match json_field_string(obj: doc, key: redfish_key_id) {
      FieldAbsent => ObservationRefused { cause: "the EthernetInterface resource carries no Id" as NonEmptyStr }
      FieldMalformed { cause: c } => ObservationRefused { cause: c as NonEmptyStr }
      FieldRead { value: id } =>
        if id == "" {
          ObservationRefused { cause: "the EthernetInterface resource has an empty Id" as NonEmptyStr }
        } else {
          ObservationEstablished { observed: RedfishEthernetInterfaceRead {
            id: id as NonEmptyStr,
            name: redfish_network_boot_optional_string(obj: doc, key: redfish_key_name),
            mac_address: redfish_network_boot_optional_string(obj: doc, key: redfish_key_mac_address),
            link_status: redfish_network_boot_optional_string(obj: doc, key: redfish_key_link_status),
          } }
        }
    }
  }
}

// The error envelope a Redfish service returns for a resource it does not serve: `error.code` beside an
// `@Message.ExtendedInfo` list whose first entry carries the `MessageId`. Both spellings are read because
// services publish both, and a body carrying neither is not a refusal — it is an unreadable answer.
fn redfish_network_boot_error_code(doc: JsonValue) -> String? {
  match json_field(obj: doc, key: redfish_key_error) {
    FieldAbsent => none
    FieldMalformed { cause: c } => none
    FieldRead { value: error } => match json_field_string(obj: error, key: redfish_key_code) {
      FieldRead { value: code } => if code == "" { none } else { Present { value: code } }
      FieldAbsent => none
      FieldMalformed { cause: c } => none
    }
  }
}

// THE BOOT OPTIONS COLLECTION. An error envelope refuses as NOT SERVED with the service's own code; a body
// without a Members array is unreadable rather than empty, because "no boot options" is a claim a service
// makes by publishing an empty Members array, not by omitting one.
fn redfish_boot_options_of(body: String) -> ObservationAttempt<RedfishBootOptionsRead, NonEmptyStr> {
  match redfish_network_boot_document(body: body, what: "BootOptions") {
    ObservationRefused { cause: c } => ObservationRefused { cause: c }
    ObservationEstablished { observed: doc } => match redfish_network_boot_error_code(doc: doc) {
      Present { value: code } => ObservationEstablished { observed: BootOptionsNotServed { message: code as NonEmptyStr } }
      Absent => match json_field(obj: doc, key: redfish_key_members) {
        FieldAbsent => ObservationRefused { cause: "the BootOptions collection carries no Members array" as NonEmptyStr }
        FieldMalformed { cause: c } => ObservationRefused { cause: c as NonEmptyStr }
        FieldRead { value: members } => match members {
          JsonArray { elements: elements } =>
            match redfish_boot_options_of_members(elements: elements) {
              ObservationRefused { cause: c } => ObservationRefused { cause: c }
              ObservationEstablished { observed: options } => ObservationEstablished {
                observed: BootOptionsListed { options: options }
              }
            }
          other => ObservationRefused { cause: "the BootOptions Members value is not an array" as NonEmptyStr }
        }
      }
    }
  }
}

fn redfish_boot_option_of_member(member: JsonValue) -> ObservationAttempt<RedfishBootOptionRead, NonEmptyStr> {
  match json_field_string(obj: member, key: redfish_key_id) {
    FieldAbsent => ObservationRefused { cause: "a BootOption member carries no Id" as NonEmptyStr }
    FieldMalformed { cause: c } => ObservationRefused { cause: c as NonEmptyStr }
    FieldRead { value: id } =>
      if id == "" {
        ObservationRefused { cause: "a BootOption member has an empty Id" as NonEmptyStr }
      } else {
        ObservationEstablished { observed: RedfishBootOptionRead {
          id: id as NonEmptyStr,
          display_name: redfish_network_boot_optional_string(obj: member, key: redfish_key_display_name),
          uefi_device_path: redfish_network_boot_optional_string(obj: member, key: redfish_key_uefi_device_path),
          enabled: redfish_network_boot_optional_bool(obj: member, key: redfish_key_boot_option_enabled),
        } }
      }
  }
}

fn redfish_boot_options_of_members(elements: List<JsonValue>) -> ObservationAttempt<List<RedfishBootOptionRead>, NonEmptyStr> {
  let empty: List<RedfishBootOptionRead> = []
  let initial: ObservationAttempt<List<RedfishBootOptionRead>, NonEmptyStr> = ObservationEstablished { observed: empty }
  fold(elements, init: initial, f: (acc, member) => match acc {
    ObservationRefused { cause: c } => ObservationRefused { cause: c }
    ObservationEstablished { observed: read } => match redfish_boot_option_of_member(member: member) {
      ObservationRefused { cause: c } => ObservationRefused { cause: c }
      ObservationEstablished { observed: option } => ObservationEstablished { observed: concat(read, [option]) }
    }
  })
}

// ── THE RENDER SIDE, BESIDE THE PARSE SIDE (DESIGN §2: model a concept once and derive every use). The corpus' own emitter writes both this
// dry controller's body and, elsewhere, a real service's recorded one, so the two cannot drift in spelling.

// The optional members are emitted only when present — a dry controller that has no MAC to report omits the
// member, exactly as a service would, rather than publishing `null` and making the parse side invent absence.
fn redfish_network_boot_optional(key: String, value: String?) -> List<JsonKeyValue> {
  match value {
    Present { value: v } => [json_kv(key: key, value: json_string(s: v))]
    Absent => []
  }
}

// THE RENDER SIDE, and what owes it. These four print the shapes above in the upstream's own envelope, from
// the same key vocabulary the readers look up -- so a body written by this module is always a body this module
// can read back. Their consumer is the modeled arm of the first-contact battery:
// `gunbc.machine_intake.bmc_first_contact_reading`'s `bmc_modeled_responses_of_world` renders a simulated
// controller's modeled network-boot state through them, and the battery parses that body back with the readers
// above, so R5's dry arm runs the same render-then-parse route a committed capture runs. This module's
// round-trip claims in `test.claim.bmc.redfish_network_boot_witness`
// (rendered_ethernet_interface_reads_back_as_the_same_resource,
// rendered_collection_reads_back_as_the_same_collection,
// rendered_not_served_envelope_reads_back_as_not_served) pin that the reader and the writer of this vocabulary
// cannot drift apart.
data redfish_collection_odata_type: String = "#Redfish.EthernetInterfaceCollection"
fn render_redfish_ethernet_interface(read: RedfishEthernetInterfaceRead) -> String {
  serialize_json(v: json_object(members: concat(
    [
      json_kv(key: redfish_key_odata_type, value: json_string(s: "#EthernetInterface.v1_5_1.EthernetInterface")),
      json_kv(key: redfish_key_id, value: json_string(s: read.id as String)),
    ],
    concat(
      redfish_network_boot_optional(key: redfish_key_name, value: read.name),
      concat(
        redfish_network_boot_optional(key: redfish_key_mac_address, value: read.mac_address),
        redfish_network_boot_optional(key: redfish_key_link_status, value: read.link_status)
      )
    )
  )))
}

fn redfish_boot_option_json(option: RedfishBootOptionRead) -> JsonValue {
  json_object(members: concat(
    [json_kv(key: redfish_key_id, value: json_string(s: option.id as String))],
    concat(
      redfish_network_boot_optional(key: redfish_key_display_name, value: option.display_name),
      concat(
        redfish_network_boot_optional(key: redfish_key_uefi_device_path, value: option.uefi_device_path),
        match option.enabled {
          Present { value: e } => [json_kv(key: redfish_key_boot_option_enabled, value: JsonBool { value: e })]
          Absent => []
        }
      )
    )
  ))
}

fn render_redfish_boot_options(options: List<RedfishBootOptionRead>) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: redfish_key_odata_type, value: json_string(s: "#BootOptionCollection.BootOptionCollection")),
    json_kv(key: redfish_key_members, value: json_array(elements: map(options, o => redfish_boot_option_json(option: o)))),
  ]))
}

// What the service says when it does not serve the collection at all: the same envelope shape the parse side
// reads the refusal out of, so the dry arm and the committed arm are the same wire fact.
fn render_redfish_boot_options_not_served(code: String) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: redfish_key_error, value: json_object(members: [
      json_kv(key: redfish_key_code, value: json_string(s: code)),
    ])),
  ]))
}

// The collection envelope, printed from the modeled collection: the members it names by id, and how many ports
// the service says it has. `Members@odata.count` is what makes a collection read that returns fewer members
// than it announced a refusal rather than a short list, so the render side prints it from the same field the
// reader fills.
fn render_redfish_ethernet_interface_collection(read: RedfishEthernetInterfaceCollectionRead) -> String {
  let count_value: JsonValue = match read.announced_count {
    Present { value: count } => json_int(n: count)
    Absent => JsonNull {}
  }
  let member_entries: List<JsonValue> = map(read.member_ids, m =>
    json_object(members: [json_kv(key: redfish_key_id, value: json_string(s: m as String))]))
  serialize_json(v: json_object(members: [
    json_kv(key: redfish_key_odata_type, value: json_string(s: redfish_collection_odata_type)),
    json_kv(key: redfish_key_members_odata_count, value: count_value),
    json_kv(key: redfish_key_members, value: json_array(elements: member_entries)),
  ]))
}
// THE COLLECTION, AS DISTINCT FROM ITS MEMBERS. `Members@odata.count` is the service saying how many ports it
// has; the member resources are what name them. Reading one and reporting the other is how a board ends up with
// "the" boot NIC picked out of a collection the service said was longer than what was read — which is why the
// count is read here, kept distinct, and never used to invent a member.
type RedfishEthernetInterfaceCollectionRead {
  member_ids: List<NonEmptyStr>
  announced_count: Int?
}

fn redfish_ethernet_interface_collection_of(body: String) -> ObservationAttempt<RedfishEthernetInterfaceCollectionRead, NonEmptyStr> {
  match redfish_network_boot_document(body: body, what: "EthernetInterfaces collection") {
    ObservationRefused { cause: c } => ObservationRefused { cause: c }
    ObservationEstablished { observed: doc } => match json_field(obj: doc, key: redfish_key_members) {
      FieldAbsent => ObservationRefused { cause: "the EthernetInterfaces collection carries no Members array" as NonEmptyStr }
      FieldMalformed { cause: c } => ObservationRefused { cause: c as NonEmptyStr }
      FieldRead { value: members } => match members {
        JsonArray { elements: elements } => ObservationEstablished { observed: RedfishEthernetInterfaceCollectionRead {
          member_ids: bmc_redfish_member_ids_of(elements: elements),
          // The count is a JSON number on the wire: read it as one. Reading it as a string silently yields
          // `none`, and a collection whose announced count went unread would let a single committed member
          // stand in for the whole fleet.
          announced_count: match json_field_int(obj: doc, key: redfish_key_members_odata_count) {
            FieldRead { value: count } => Present { value: count }
            FieldAbsent => none
            FieldMalformed { cause: c } => none
          },
        } }
        other => ObservationRefused { cause: "the EthernetInterfaces Members value is not an array" as NonEmptyStr }
      }
    }
  }
}

fn bmc_redfish_member_ids_of(elements: List<JsonValue>) -> List<NonEmptyStr> {
  let ids: List<NonEmptyStr> = []
  fold(elements, init: ids, f: (acc, member) => match json_field_string(obj: member, key: redfish_key_id) {
    FieldRead { value: id } => if id == "" { acc } else { concat(acc, [id as NonEmptyStr]) }
    FieldAbsent => acc
    FieldMalformed { cause: c } => acc
  })
}

// THE SYSTEMS RESOURCE'S BOOT OBJECT, READ. A ComputerSystem's `Boot` says which source the firmware was TOLD
// to use — `BootSourceOverrideEnabled` and `BootSourceOverrideTarget`. It names no interface and no MAC, so it
// can never BE a boot NIC: the boot NIC is a network fact joined from EthernetInterfaces (DESIGN), and the boot
// source is a controller fact that mints no capability. A resource that carries no Boot object says so; an
// empty or partial Boot object is a fact about the controller, not a failure to have read it.
type RedfishBootOverrideRead
  = BootOverrideReported { enabled: NonEmptyStr, target: NonEmptyStr }
  | BootOverrideAbsent { message: NonEmptyStr }
  | BootOverrideUnreadable { cause: NonEmptyStr }

fn redfish_boot_override_field(obj: JsonValue, key: NonEmptyStr, what: NonEmptyStr) -> ObservationAttempt<NonEmptyStr, NonEmptyStr> {
  match json_field_string(obj: obj, key: key as String) {
    FieldRead { value: text } => ObservationEstablished { observed: text as NonEmptyStr }
    FieldAbsent => ObservationRefused { cause: concat("the Boot object carries no ", what) as NonEmptyStr }
    FieldMalformed { cause: cause } => ObservationRefused { cause: concat("the Boot object's ", concat(what, " is malformed")) as NonEmptyStr }
  }
}

fn redfish_boot_override_of(body: String) -> RedfishBootOverrideRead {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: gap } => BootOverrideUnreadable { cause: concat("the Systems response is not a JSON document (", concat(json_document_gap_text(gap: gap), ")")) as NonEmptyStr }
    JsonDocumentParsed { value: value } => match json_field(obj: value, key: "Boot") {
      FieldAbsent => BootOverrideAbsent { message: "the Systems resource carries no Boot object" as NonEmptyStr }
      FieldMalformed { cause: cause } => BootOverrideUnreadable { cause: concat("the Systems Boot object is malformed (", concat(cause as String, ")")) as NonEmptyStr }
      FieldRead { value: boot } => match redfish_boot_override_field(obj: boot, key: "BootSourceOverrideEnabled", what: "BootSourceOverrideEnabled" as NonEmptyStr) {
        ObservationRefused { cause: cause } => BootOverrideUnreadable { cause: cause }
        ObservationEstablished { observed: enabled } => match redfish_boot_override_field(obj: boot, key: "BootSourceOverrideTarget", what: "BootSourceOverrideTarget" as NonEmptyStr) {
          ObservationRefused { cause: cause } => BootOverrideUnreadable { cause: cause }
          ObservationEstablished { observed: target } => BootOverrideReported { enabled: enabled, target: target }
        }
      }
    }
  }
}
