module extdeps.bmc.access_profile

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { Bool, EpochMs, Int, List, NonEmptyStr, String }
import v2.std.algebra { filter }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.credentials { FactoryLogin }
import extdeps.bmc.endpoint { BmcEndpoint, BmcFirmwareFamily }
import extdeps.boards.types { BaseboardModel }
import extdeps.firmware.types { FirmwareSemanticVersion }
import extdeps.bmc.capability { BmcFirmwareVersion, bmc_firmware_version_eq }
import extdeps.bmc.redfish_virtual_media { RedfishVirtualMediaProbe }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.dmtf.org/standards/redfish"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.access_profile",
      decl_name: "BmcAccessSurface",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data access_profile_two_carriers_note: String = "TWO CARRIERS, ONE INTERSECTION (machine-intake ruling 2026-08-29 §2). BmcAccessProfile is PLATFORM CATALOG data keyed by (baseboard, chassis part number, implementation, exact firmware): the routes and quirks a firmware release is documented or previously observed to expose. BmcAccessObservation is a LIVE, per-endpoint, per-attempt reading of what that endpoint served just now. A solver may select a surface only from their intersection — a platform row saying that firmware should expose virtual media does not establish that this endpoint currently does, and a live discovery on one endpoint does not become a platform fact. This module carries the two shapes and the intersection predicate; concrete profile rows live in the board and implementation modules that cite them, and observations are receipts in the workflow layer (DESIGN §3: observations are never authored inside an upstream module). It generalizes the strength extdeps.boards.asrock_rack already had — capabilities catalogued per exact firmware version, changing across 2.07.00, 3.06.00 and 3.22.00 — from one board's capability roster to a keyed profile any board can inhabit."

// The surfaces intake asks a BMC about. Each is a thing an endpoint either
// served or did not when probed; none is a promise. SurfaceBmcShell is the
// authenticated management shell (OpenBMC SSH) the configfs gadget transport
// rides on; SurfaceOemNbdWebsocket is the bmcweb nbd-proxy WebSocket the ASRock
// transport rides on; SurfaceOemRestRemoteMedia is the proprietary MegaRAC
// /api/settings/media surface (extdeps.bmc.megarac) the observed Mt. Collins
// build serves; SurfaceRedfishVirtualMedia is the DMTF collection.
type BmcAccessSurface
  = SurfaceManagerIdentity
  | SurfaceSystemInventory
  | SurfaceChassisInventory
  | SurfaceEventLog
  | SurfaceAccountManagement
  | SurfaceBootControl
  | SurfaceRedfishVirtualMedia
  | SurfaceOemNbdWebsocket
  | SurfaceOemRestRemoteMedia
  | SurfaceBmcShell
  | SurfaceUefiHttpBoot
  | SurfaceSensors
  | SurfaceTelemetryMetrics
  | SurfaceBmcClock

type BmcAccessProfileKey {
  baseboard: BaseboardModel
  chassis_part_number: NonEmptyStr?
  firmware: BmcFirmwareVersion
}

// A vendor-specific parameter the profile has to carry verbatim (MegaRAC's
// image_redirection, an ASRock UDC name). Named, not folded into prose.
type BmcOemParameter {
  name: NonEmptyStr
  value: NonEmptyStr
}

type BmcAccessProfile {
  key: BmcAccessProfileKey
  redfish_system_locator: NonEmptyStr
  redfish_chassis_locator: NonEmptyStr
  redfish_manager_locator: NonEmptyStr
  bootstrap_credential: FactoryLogin?
  candidate_surfaces: List<BmcAccessSurface>
  oem_parameters: List<BmcOemParameter>
}

// What the endpoint SAID it is, read at discovery: the board and chassis from
// FRU/Chassis, the family and exact firmware from the Manager. This is the key
// a profile lookup binds against — all of it, not the firmware alone, so a
// same-version endpoint cannot be paired with an unrelated board's profile.
type BmcObservedIdentity {
  baseboard: BaseboardModel
  chassis_part_number: NonEmptyStr?
  firmware: BmcFirmwareVersion
}

type BmcAccessObservation {
  endpoint: BmcEndpoint
  identity: BmcObservedIdentity
  firmware: BmcFirmwareVersion
  discovered_surfaces: List<BmcAccessSurface>
  redfish_virtual_media_probe: RedfishVirtualMediaProbe
  successful_read_surfaces: List<BmcAccessSurface>
  successful_write_surfaces: List<BmcAccessSurface>
  observed_at: EpochMs
}

// An observation is a receipt of an attempt; its absence is a state a solver
// must see, so there is no default observation and no empty one standing in
// for "not yet probed".
type BmcAccessObservationStanding
  = BmcAccessObserved { observation: BmcAccessObservation }
  | BmcAccessUnobserved { endpoint: BmcEndpoint }

fn optional_part_number_matches(profile: NonEmptyStr?, observed: NonEmptyStr?) -> Bool {
  match profile {
    Absent => true
    Present { value: p } =>
      match observed {
        Absent => false
        Present { value: o } => p == o
      }
  }
}

// The profile key binds baseboard, chassis variant where the profile names
// one, and exact firmware (family and version). Equal firmware alone is not a
// binding.
fn bmc_access_profile_key_matches(key: BmcAccessProfileKey, identity: BmcObservedIdentity) -> Bool {
  key.baseboard == identity.baseboard
    && optional_part_number_matches(profile: key.chassis_part_number, observed: identity.chassis_part_number)
    && bmc_firmware_version_eq(a: key.firmware, b: identity.firmware)
}

// The total lookup, refusing on both sides of uniqueness like
// extdeps.bmc.capability bmc_firmware_capability_row_for. AccessProfileNotLookedUp
// is the honest standing of a path that never ran the lookup at all
// (gunbc.os_install_mechanism's frozen projection); it is distinct from an
// endpoint whose identity WAS read and matched nothing.
type BmcAccessProfileStanding
  = AccessProfileKnown { profile: BmcAccessProfile, provenance: DeclarationRef }
  | AccessProfileUncatalogued { observed_identity: BmcObservedIdentity }
  | AccessProfileAmbiguous { observed_identity: BmcObservedIdentity, count: Int }
  | AccessProfileIdentityMismatch { profile: BmcAccessProfileKey, observed: BmcObservedIdentity }
  | AccessProfileNotLookedUp { endpoint: BmcEndpoint }

type BmcAccessProfileCatalogRow {
  profile: BmcAccessProfile
  provenance: DeclarationRef
}

fn bmc_access_profile_for(
  identity: BmcObservedIdentity,
  catalog: List<BmcAccessProfileCatalogRow>,
) -> BmcAccessProfileStanding {
  let hits = catalog |> filter(row => bmc_access_profile_key_matches(key: row.profile.key, identity: identity))
  let n = count(hits)
  if n == 0 {
    AccessProfileUncatalogued { observed_identity: identity }
  } else if n == 1 {
    fold(
      hits,
      init: AccessProfileUncatalogued { observed_identity: identity },
      f: (_acc, row) => AccessProfileKnown { profile: row.profile, provenance: row.provenance },
    )
  } else {
    AccessProfileAmbiguous { observed_identity: identity, count: n }
  }
}

fn bmc_surface_in(surfaces: List<BmcAccessSurface>, surface: BmcAccessSurface) -> Bool {
  fold(surfaces, init: false, f: (acc, s) => acc || s == surface)
}

// Every way the intersection can fail to admit a surface, named. A profile and
// an observation for different firmware do not intersect at all: the
// observation is a reading of a release the profile does not describe.
type BmcSurfaceEligibility
  = SurfaceEligible
  | SurfaceAbsentFromProfile
  | SurfaceAbsentFromLiveObservation
  | SurfaceProfileObservationIdentityMismatch { profile: BmcAccessProfileKey, observed: BmcObservedIdentity }

fn bmc_surface_eligibility(
  profile: BmcAccessProfile,
  observation: BmcAccessObservation,
  surface: BmcAccessSurface,
) -> BmcSurfaceEligibility {
  if bmc_access_profile_key_matches(key: profile.key, identity: observation.identity) == false {
    SurfaceProfileObservationIdentityMismatch { profile: profile.key, observed: observation.identity }
  } else if bmc_surface_in(surfaces: profile.candidate_surfaces, surface: surface) == false {
    SurfaceAbsentFromProfile
  } else if bmc_surface_in(surfaces: observation.discovered_surfaces, surface: surface) == false {
    SurfaceAbsentFromLiveObservation
  } else {
    SurfaceEligible
  }
}
