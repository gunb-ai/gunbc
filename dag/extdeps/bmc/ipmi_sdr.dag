module extdeps.bmc.ipmi_sdr

import std.algebra { list_find_first, string_contains, trim }
import std.types { Bool, Int, List, NonEmptyStr, String }
import std.measure { Celsius, Percent, RevolutionsPerMinute, celsius, percent, rpm }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "linux.die.net/man/1/ipmitool"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.ipmi_sdr",
      decl_name: "SdrTypeLine",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE RENDERING ipmitool's `sdr type` PRODUCES, WHICH IS THE TOOL'S FACT AND NOT THE SPECIFICATION'S.
//
// This module is the same split extdeps.bmc.ipmi_sel already makes and for the same reason: the
// argv lives with the transport (extdeps.bmc.ipmi), the record semantics live with the IPMI
// specification, and the five-field pipe-separated TEXT below is neither - it is how one tool chose
// to print a sensor record, it changes when the tool changes, and a Redfish reader of the same
// sensors would never see it. What a controller was observed to publish is a receipt in the
// observing layer, never a row here.
//
// THE SHAPE, as the tool prints it:
//
//   FAN1             | 41h | ok  |  7.1 | 8600 RPM
//   FAN2             | 42h | ns  |  7.2 | No Reading
//   CPU_Temp         | 01h | ok  |  3.1 | 45 degrees C
//
// name, sensor number, status, entity id, reading. The reading field is the one that carries a UNIT
// IN ITS TEXT, which is why it is decoded rather than split: "8600 RPM", "45 degrees C" and "72
// percent" are three different quantities and the field does not say which except by its own suffix.
type SdrTypeLine {
  name: NonEmptyStr
  sensor_number: NonEmptyStr
  status: NonEmptyStr
  entity_id: NonEmptyStr
  reading_text: NonEmptyStr
}

// THE SAME SHAPE READ BACKWARD: the five fields in order, separated as the tool separates them. The
// tool pads each column to a width; sdr_decode_line trims every field, so the padding is not part of
// what any reader may depend on, and a line rendered here decodes to the record it was rendered from.
fn sdr_type_line_text(line: SdrTypeLine) -> String {
  join([line.name as String, line.sensor_number as String, line.status as String, line.entity_id as String, line.reading_text as String], " | ")
}

// A LINE THAT DID NOT HAVE FIVE FIELDS IS NOT AN EMPTY LINE AND NOT A ZERO READING.
//
// ipmitool prints header noise, blank lines and, on some builds, continuation text. Dropping those
// silently would make a truncated output indistinguishable from a machine with no fans - the
// empty-observation narrow - so a line that does not decode is carried as a refusal with its own
// text, and a consumer counting sensors counts refusals too.
type SdrLineResult
  = SdrLineDecoded { line: SdrTypeLine }
  | SdrLineUnstructured { text: String }

// A LINE DECODES ONLY IF ALL FIVE FIELDS ARE PRESENT AND NON-EMPTY. An earlier revision checked the
// COUNT and then filled any empty field with a sentinel string - "SdrFieldEmpty" for a blank,
// "SdrFieldMissing" for an absent one - which is the fabricated plausible output DESIGN §5 forbids,
// landed on a REACHABLE path: a build printing `FAN1 | | ok | 7.1 | 8600 RPM` produced a
// well-formed record whose status was the literal text "SdrFieldEmpty", indistinguishable
// downstream from a controller that actually reported that word.
//
// Worse, it misattributed the fault. A malformed line is the CONTROLLER'S output being wrong, which
// SdrLineUnstructured already exists to carry; routing it onward made it surface later as
// SdrFanReadingUnrecognised, which is THIS DECODER'S gap arm. That is precisely the
// "one is the controller's report and the other is our gap" distinction this module's header
// draws, inverted by the helper that was supposed to serve it.
fn sdr_decode_line(text: String) -> SdrLineResult {
  match sdr_row_cells(text: text) {
    Absent => SdrLineUnstructured { text: text }
    Present { value: c } => match c.reading_text {
      Absent => SdrLineUnstructured { text: text }
      Present { value: rt } => SdrLineDecoded {
        line: SdrTypeLine { name: c.name, sensor_number: c.sensor_number, status: c.status, entity_id: c.entity_id, reading_text: rt }
      }
    }
  }
}

// THE ONE FIVE-CELL WALK. Four leading cells present and non-empty; the reading cell is carried as read (Absent when blank).
// sdr_decode_line projects the rows whose reading is present, sdr_empty_reading_row the rows whose reading is absent: one
// parse of one row shape, two projections.
type SdrRowCells {
  name: NonEmptyStr
  sensor_number: NonEmptyStr
  status: NonEmptyStr
  entity_id: NonEmptyStr
  reading_text: NonEmptyStr?
}

fn sdr_row_cells(text: String) -> SdrRowCells? {
  let fields = split(s: text, delimiter: "|") |> map(f => trim(f))
  if fields.length() != 5 {
    none
  } else {
    match sdr_field_at(fields: fields, index: 0) {
      Absent => none
      Present { value: n } => match sdr_field_at(fields: fields, index: 1) {
        Absent => none
        Present { value: sn } => match sdr_field_at(fields: fields, index: 2) {
          Absent => none
          Present { value: st } => match sdr_field_at(fields: fields, index: 3) {
            Absent => none
            Present { value: eid } => Present { value: SdrRowCells { name: n, sensor_number: sn, status: st, entity_id: eid, reading_text: sdr_field_at(fields: fields, index: 4) } }
          }
        }
      }
    }
  }
}

// THE INDEX HELPER REFUSES RATHER THAN SUBSTITUTING. Absent covers both "there is no field at this
// index" and "the field is blank", because to every caller here those have the same consequence -
// the line cannot be decoded - and neither is a value any controller reported.
fn sdr_field_at(fields: List<String>, index: Int) -> NonEmptyStr? {
  match fields.skip(n: index).first() {
    Absent => Absent
    Present { value: f } => if trim(f) == "" { none } else { Present { value: f as NonEmptyStr } }
  }
}

// A FIVE-CELL ROW WHOSE ONLY EMPTY CELL IS THE READING. ipmitool prints a discrete sensor that carries no reading text
// (observed on this controller family: every FANn_Failure row of artifacts/bmc/mtcollins1-32dimm/06-sdr.txt, `status ok`,
// reading cell empty) as exactly this shape; sdr_decode_line leaves it unstructured because all five fields must be
// present. This parse is the STRUCTURAL reading of that shape (name plus status); it says nothing about what an empty
// reading MEANS, which is the consumer's judgment.
type SdrEmptyReadingRow {
  name: NonEmptyStr
  status: NonEmptyStr
  text: String
}

fn sdr_empty_reading_row(text: String) -> SdrEmptyReadingRow? {
  match sdr_row_cells(text: text) {
    Absent => none
    Present { value: c } => match c.reading_text {
      Present { value: _ } => none
      Absent => Present { value: SdrEmptyReadingRow { name: c.name, status: c.status, text: text } }
    }
  }
}

fn sdr_decode_lines(stdout: String) -> List<SdrLineResult> {
  split(s: stdout, delimiter: "\n")
    |> filter(l => trim(l) != "")
    |> map(l => sdr_decode_line(text: l))
}

// WHAT A FAN SENSOR'S READING FIELD MEANT.
//
// THE PERCENT ARM IS NOT DECORATION. Several builds publish a fan sensor in percent rather than RPM,
// and a controller that publishes duty directly is the only case where a failsafe verdict can be
// reached without the fan catalog. Collapsing it into the RPM arm would lose exactly the reading
// that answers the question this decoder exists for.
//
// SdrFanNoReading IS SEPARATE FROM SdrFanReadingUnrecognised. "No Reading" and "ns" are the tool
// saying the sensor answered nothing, which is a fact about the sensor; an unrecognised suffix is
// this decoder admitting it does not know what the units are, which is a fact about this decoder.
// One is the controller's report and the other is our gap, and a consumer chasing a missing fan must
// not be sent to the wrong one.
type SdrFanReading
  = SdrFanRpm { speed: RevolutionsPerMinute }
  | SdrFanDuty { duty: Percent }
  | SdrFanNoReading
  | SdrFanReadingUnrecognised { text: String }

fn sdr_reading_words(reading_text: NonEmptyStr) -> List<String> {
  split(s: trim(reading_text as String), delimiter: " ") |> filter(w => trim(w) != "")
}

// THE SENSOR SAYING NOTHING IS A LITERAL THIS TOOL PRINTS, NOT A PARSE FAILURE, and conflating the
// two put a decoder gap on the controller's side of the ledger. An earlier revision sent every
// unparseable magnitude to SdrFanNoReading / SdrTemperatureNoReading -- "the sensor answered
// nothing" -- when the fact was "this decoder does not understand what the controller printed".
//
// MEASURED CONSEQUENCE, not a hypothetical: a build printing a fractional temperature
// (`45.5 degrees C`) failed parse_int, decoded as NoReading, made sdr_any_temperature_reading
// answer false on a SUCCESSFUL read, and so produced HostPoweredOnPrePost and then
// FailsafeBeforeHostTelemetry -- the arm whose header says it is the contract working rather than a
// finding. A decoder gap silently disabled FailsafeHeldAfterPost, which is the identical
// widen-to-benign path gunbc.machine_intake.bmc_fan_observation condemns at length for the
// unreadable thermal read. Third instance of that one path in this lane.
//
// So the sentinel is matched as the LITERAL TEXT the tool documents for an unavailable sensor, and
// everything else that will not parse is this decoder's gap and says so.
fn sdr_reading_is_absent_sentinel(reading_text: NonEmptyStr) -> Bool {
  let t = trim(reading_text as String)
  t == "No Reading" || t == "Disabled" || t == "ns"
}

fn sdr_fan_reading(reading_text: NonEmptyStr) -> SdrFanReading {
  let words = sdr_reading_words(reading_text: reading_text)
  if sdr_reading_is_absent_sentinel(reading_text: reading_text) {
    SdrFanNoReading
  } else if words.length() < 2 {
    SdrFanReadingUnrecognised { text: reading_text as String }
  } else {
    match words.first() {
      Absent => SdrFanReadingUnrecognised { text: reading_text as String }
      Present { value: magnitude } => match sdr_field_at(fields: words, index: 1) {
        Absent => SdrFanReadingUnrecognised { text: reading_text as String }
        Present { value: unit } => match parse_int(s: trim(magnitude)) {
          Absent => SdrFanReadingUnrecognised { text: reading_text as String }
          Present { value: n } => if n < 0 {
            SdrFanReadingUnrecognised { text: reading_text as String }
          } else if unit == "RPM" {
            SdrFanRpm { speed: rpm(n) }
          } else if unit == "percent" {
            SdrFanDuty { duty: percent(n) }
          } else {
            SdrFanReadingUnrecognised { text: reading_text as String }
          }
        }
      }
    }
  }
}

// A TEMPERATURE READING, DECODED ONLY FAR ENOUGH TO ANSWER "IS THE HOST PUBLISHING THERMALS AT ALL".
//
// The fan-policy question does not need a calibrated temperature; it needs to know whether the
// controller has any host thermal sensor producing a number, because that is the input whose absence
// is what failsafe exists for. So this returns degrees where it can and says so where it cannot, and
// it deliberately does not model thresholds, hysteresis or entity association - a consumer needing
// those is asking a different question and should not reach it through this decoder.
type SdrTemperatureReading
  = SdrTemperatureDegreesC { degrees: Celsius }
  | SdrTemperatureNoReading
  | SdrTemperatureUnrecognised { text: String }

fn sdr_temperature_reading(reading_text: NonEmptyStr) -> SdrTemperatureReading {
  let words = sdr_reading_words(reading_text: reading_text)
  if sdr_reading_is_absent_sentinel(reading_text: reading_text) {
    SdrTemperatureNoReading
  } else if words.length() < 2 {
    SdrTemperatureUnrecognised { text: reading_text as String }
  } else {
    match words.first() {
      Absent => SdrTemperatureUnrecognised { text: reading_text as String }
      Present { value: magnitude } => match parse_int(s: trim(magnitude)) {
        Absent => SdrTemperatureUnrecognised { text: reading_text as String }
        Present { value: n } => match sdr_field_at(fields: words, index: 1) {
          Absent => SdrTemperatureUnrecognised { text: reading_text as String }
          Present { value: unit } => if unit == "degrees" {
            SdrTemperatureDegreesC { degrees: celsius(n) }
          } else {
            SdrTemperatureUnrecognised { text: reading_text as String }
          }
        }
      }
    }
  }
}

fn sdr_decoded_lines(results: List<SdrLineResult>) -> List<SdrTypeLine> {
  fold(results, init: [], f: (acc, r) => match r {
    SdrLineDecoded { line: l } => acc.append(l)
    SdrLineUnstructured { text: _ } => acc
  })
}

fn sdr_unstructured_texts(results: List<SdrLineResult>) -> List<String> {
  flat_map(results, r => match r {
    SdrLineDecoded { line: _ } => []
    SdrLineUnstructured { text: t } => [t]
  })
}

// THE TEXTS OF TEMPERATURE READINGS THE DECODER DID NOT RECOGNISE, kept apart from sdr_temperature_publication, whose meaning is
// "was ANY temperature published": a published magnitude absorbs an unrecognised sibling there, by design, so a consumer that must not
// treat a semantic decode failure as healthy reads this list.
fn sdr_unrecognised_temperature_texts(results: List<SdrLineResult>) -> List<String> {
  flat_map(results, r => match r {
    SdrLineUnstructured { text: _ } => []
    SdrLineDecoded { line: l } => match sdr_temperature_reading(reading_text: l.reading_text) {
      SdrTemperatureDegreesC { degrees: _ } => []
      SdrTemperatureNoReading => []
      SdrTemperatureUnrecognised { text: t } => [t]
    }
  })
}

// WHAT A WHOLE TEMPERATURE READ ESTABLISHED, AS THREE STATES RATHER THAN A Bool.
//
// This is the value the fan-policy derivation actually consumes, and it was a Bool that answered
// false for BOTH "every sensor said nothing" and "this decoder could not read what they said".
// Adding SdrTemperatureUnrecognised to the reading type did not fix that: THE REPAIR STOPPED AT THE
// TYPE and the predicate consuming it still folded the new arm onto the old false. So the exact
// input the previous commit's prose claims to have fixed -- 45.5 degrees C -- still produced
// host_thermal_published: false, HostPoweredOnPrePost and FailsafeBeforeHostTelemetry, silently
// disabling the one finding this lane exists to report. A type gains an arm; every fold over it has
// to gain one too, and nothing checks that but reading the consumers.
//
// PRECEDENCE, and it is deliberate: one decoded number means the host IS publishing, whatever else
// failed to decode beside it. Undecodable only wins when nothing decoded, because that is when the
// gap actually blocks the question.
type SdrTemperaturePublication
  = TemperaturePublished
  | TemperatureSensorsSilent
  | TemperatureUndecodable
  | TemperatureNoSensorRows

// THIS FOLD TAKES THE RAW RESULTS, NOT THE DECODED SUBSET, AND THAT IS THE WHOLE CORRECTION.
//
// It used to take List<SdrTypeLine> - the lines that survived STRUCTURAL decode - and start the
// fold at TemperatureSensorsSilent. So a read whose every line failed structural decode handed this
// function an EMPTY list, the fold never ran, and the initial value was returned: "this host
// publishes no thermals", about a read where nothing was understood at all. Downstream that reads
// as pre-POST and silently disables FailsafeHeldAfterPost, which is the one finding the observation
// exists to be able to make.
//
// The caller could not have fixed it either. It held the undecoded count in its other hand and
// would have had to JOIN two folds correctly to recover the truth; taking the results here means
// there is no join to get wrong, and no way to pair this answer with someone else's count.
//
// FOUR STATES, EACH REACHABLE AND EACH MEANING SOMETHING DIFFERENT ABOUT THE EVIDENCE:
//   TemperaturePublished    at least one row carried a magnitude
//   TemperatureSensorsSilent  rows decoded, every one said No Reading - sensors present, quiet
//   TemperatureUndecodable  something failed to decode, structurally or semantically, and nothing
//                           published: the decoder's gap, not the sensor's silence
//   TemperatureNoSensorRows the read succeeded and returned nothing at all - no temperature sensors
//                           listed, which is not the same fact as sensors that are present and quiet
fn sdr_temperature_publication(results: List<SdrLineResult>) -> SdrTemperaturePublication {
  if results.length() == 0 {
    TemperatureNoSensorRows
  } else {
    fold(results, init: TemperatureSensorsSilent, f: (acc, r) => match r {
      SdrLineUnstructured { text: _ } => match acc {
        TemperaturePublished => TemperaturePublished
        TemperatureSensorsSilent => TemperatureUndecodable
        TemperatureUndecodable => TemperatureUndecodable
        TemperatureNoSensorRows => TemperatureUndecodable
      }
      SdrLineDecoded { line: l } => match sdr_temperature_reading(reading_text: l.reading_text) {
        SdrTemperatureDegreesC { degrees: _ } => TemperaturePublished
        SdrTemperatureNoReading => acc
        SdrTemperatureUnrecognised { text: _ } => match acc {
          TemperaturePublished => TemperaturePublished
          TemperatureSensorsSilent => TemperatureUndecodable
          TemperatureUndecodable => TemperatureUndecodable
          TemperatureNoSensorRows => TemperatureUndecodable
        }
      }
    })
  }
}

// VERBOSE SDR ELIST: ONE PARSER, KEYED ON THE RECORD ITSELF.
//
// ipmitool's `sdr elist -v` prints NO pipe rows. Over the whole committed capture of srv1 (run
// 41406891344, 144775 bytes) there is not one '|' line: each sensor is one block opening with
//
//   Sensor ID              : FAN1 (0x41)
//
// followed by indented ' Label  : value' continuation lines. The row-keyed grouping this file did
// before (#15562, rendered by #15649) started a record only on a five-field '|' line, so against
// real output it produced ZERO records while still reporting the read captured - dead code against
// the only bytes that matter, and the gate downstream therefore refused on an empty repository.
// The record boundary is the Sensor ID header, and the header's NAME is what joins a block to the
// elist row the gate is deciding about. The number in the header is DISPLAY TEXT: the row spells it
// EBh while the header spells it (0xeb), and no rule here compares the two - doing so would need a
// hex parse invented to make a rule pass, and a wrong one would admit a sensor nobody typed.
//
// THIS STAGE STILL MAKES NO ADMISSION DECISION. The label test below is ipmitool's own threshold
// decision, cited to the tool; the rule that consumes it lives in gunbc.machine_intake and is
// grounded on the committed capture, not on a hand-written shape.
type SdrVerboseRecord {
  name: String
  number_hex: String
  detail_lines: List<String>
}

// THE TOOL'S OWN THRESHOLD TEST, NOT A SPECIFICATION TABLE.
//
// ipmi_sdr.h:427 at be11d948 reads `#define IS_THRESHOLD_SENSOR(s) ((s)->event_type == 1)`, where
// event_type is the SDR event/reading type code (ipmi_sdr.h:380). The VERBOSE OUTPUT block PRINTS
// that single test as a label: ' Sensor Type (Discrete): %s (0x%02x)' when the test fails
// (lib/ipmi_sdr.c:1888) and ' Sensor Type (Threshold)  : %s (0x%02x)' when it holds
// (lib/ipmi_sdr.c:1952) - note the TWO SPACES before the colon in the second, which is why this
// matches the parenthesised WORD and never an aligned label. The raw code itself reaches only
// lprintf(LOG_DEBUG, " Event Type Code : 0x%02x", ...) (lib/ipmi_sdr.c:1891) and so NEVER appears
// in stdout: a rule keyed on an 'Event/Reading Type Code' line would key on a line that cannot
// exist in a capture, and would classify every row absent while looking green.
//
// Threshold is checked FIRST on purpose. ipmitool cannot print both labels for one record, but a
// capture that somehow carried both must refuse rather than admit: when the typing is ambiguous,
// the blank reading stays undecoded.
type SdrVerboseReadout
  = SdrVerboseRead { records: List<SdrVerboseRecord> }
  | SdrVerboseEmptyRepository
  | SdrVerboseUnreadable

type SdrBlockTyping
  = SdrBlockThreshold
  | SdrBlockNotThreshold
  | SdrBlockUntyped

data ipmitool_sdr_threshold_test_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ipmitool/ipmitool/blob/be11d948/include/ipmitool/ipmi_sdr.h#L427"
  }
}

// A detail line carrying one of the two labels. Absent means the repository said nothing about
// this record, which is NOT the same as saying it is not a threshold sensor.
fn sdr_block_detail_carries(record: SdrVerboseRecord, pattern: String) -> Bool {
  match list_find_first(xs: record.detail_lines, predicate: d => string_contains(s: d, pattern: pattern)) {
    Present { value: _ } => true
    Absent => false
  }
}

fn sdr_verbose_block_typing(record: SdrVerboseRecord) -> SdrBlockTyping {
  if sdr_block_detail_carries(record: record, pattern: "Sensor Type (Threshold)") {
    SdrBlockThreshold
  } else if sdr_block_detail_carries(record: record, pattern: "Sensor Type (Discrete)") {
    SdrBlockNotThreshold
  } else {
    SdrBlockUntyped
  }
}

// WHETHER A CAPTURE EVER MET BOTH SIDES OF THE LINE THE RULE RESTS ON.
//
// ipmi_sdr.h:427 at be11d948 separates threshold from not-threshold; a repository that parses into
// records of only ONE kind has not exercised that test, and minting an observation over it would say
// "these bytes typed the rows" on bytes that type nothing. Computed FROM THE PARSE rather than compared
// against a count written down beside the bytes, so no edit to a literal can satisfy it.
fn sdr_repository_carries_both_kinds(records: List<SdrVerboseRecord>) -> Bool {
  match list_find_first(xs: records, predicate: r => match sdr_verbose_block_typing(record: r) { SdrBlockThreshold => true SdrBlockNotThreshold => false SdrBlockUntyped => false }) {
    Absent => false
    Present { value: _ } => match list_find_first(xs: records, predicate: r => match sdr_verbose_block_typing(record: r) { SdrBlockThreshold => false SdrBlockNotThreshold => true SdrBlockUntyped => false }) {
      Absent => false
      Present { value: _ } => true
    }
  }
}

// WHY A BLANK CELL IS NOT AN UNDECODABLE ROW, AND WHAT IT TAKES TO SAY SO.
//
// The row's reading cell has three print paths in ipmitool (lib/ipmi_sdr.c at be11d948): a discrete
// sensor prints its ASSERTED state strings via ipmi_sdr_print_discrete_state_mini (:1858-1866),
// then "Disabled" (:1869), then "No Reading" (:1872). With no state asserted the discrete path
// prints NOTHING, which is what the committed capture of srv1 shows: the rows this rule was written
// for carry an empty cell after the last pipe, while the sensors that genuinely have no reading
// print the literal "No Reading". A blank cell therefore means "status ok, nothing asserted" - the
// reading is absent BY DESIGN - and refusing it as undecodable was refusing a healthy sensor.
//
// That is the mechanism, not an authority: it is read off the tool's print path and corroborated by
// committed bytes. The authority this judgement rests on is the label test above (ipmi_sdr.h:427 at
// be11d948), and NOTHING here reads the sensor number, the sensor type NAME (the committed capture
// types EndOfPost as 'Sensor Type (Discrete): Unknown (0xd0)', an OEM code, so a name-keyed rule
// would refuse a healthy row), or the row's position. A row is admitted only when a record in the
// repository carries it: no record, no admission.
type SdrUndecodedRowJudgement
  = SdrRowAdmittedDiscrete
  | SdrRowRefusedNotAnElistRow { row: String }
  | SdrRowRefusedCarriesReading { row: String }
  | SdrRowRefusedStatusNotOk { row: String }
  | SdrRowRefusedNoRecordNamed { row: String }
  | SdrRowRefusedNameAmbiguous { row: String }
  | SdrRowRefusedThresholdTyped { row: String }
  | SdrRowRefusedUnlabelledRecord { row: String }

// WHY a row stayed refused is a RULING, not a sentence. Each cause is its own variant carrying the row
// it refused, so a caller can match on the reason and a witness can pin each one separately (DESIGN.md
// §4c: a ruling belongs in a typed carrier; §5: refusals are typed and located). One variant with a
// String field chosen from seven hard-coded sentences is a sum type the code never declared, and the
// difference matters: the variants can be matched, counted and tested, and a typo in one is a
// compile error rather than a string nobody compares against.
fn sdr_blank_ok_row_judgement(text: String, blocks: List<SdrVerboseRecord>) -> SdrUndecodedRowJudgement {
  match sdr_row_cells(text: text) {
    Absent => SdrRowRefusedNotAnElistRow { row: text }
    Present { value: cells } => match cells.reading_text {
      Present { value: _ } => SdrRowRefusedCarriesReading { row: text }
      Absent => if cells.status != "ok" {
        SdrRowRefusedStatusNotOk { row: text }
      } else {
        // A name shared by two records is refused: which sensor typed the row would be a guess, and a
        // guess here admits a reading nobody read. Below that, the record's OWN typing decides - matched
        // straight off SdrBlockTyping, because a Bool per variant would be a second representation of the
        // distinction the type already carries (§5).
        let named = flat_map(blocks, b => if b.name == cells.name { [b] } else { [] })
        let not_threshold = flat_map(named, b => match sdr_verbose_block_typing(record: b) { SdrBlockNotThreshold => [b] SdrBlockThreshold => [] SdrBlockUntyped => [] })
        let threshold = flat_map(named, b => match sdr_verbose_block_typing(record: b) { SdrBlockThreshold => [b] SdrBlockNotThreshold => [] SdrBlockUntyped => [] })
        if named.length() == 0 {
          SdrRowRefusedNoRecordNamed { row: text }
        } else if named.length() > 1 {
          SdrRowRefusedNameAmbiguous { row: text }
        } else if not_threshold.length() == 1 {
          SdrRowAdmittedDiscrete
        } else if threshold.length() == 1 {
          SdrRowRefusedThresholdTyped { row: text }
        } else {
          // Not threshold, not not-threshold: the record printed neither label, so its event/reading type
          // is unknown, and an unknown type is not a permission to admit.
          SdrRowRefusedUnlabelledRecord { row: text }
        }
      }
    }
  }
}

// THE BLOCK ID, read off the header's own text: 'PSU2_Status (0xeb)' after a ' : ' split of a
// 'Sensor ID' label. Both halves must be there. Nothing parses the hex: it is carried as the text
// the tool printed, for a human reading the receipt, and no admission decision reads it.
type SdrBlockId {
  name: String
  number_hex: String
}

fn sdr_block_id(value: String) -> SdrBlockId? {
  let opened = split(s: value, delimiter: " (") |> map(p => trim(p))
  if opened.length() != 2 {
    none
  } else {
    match sdr_field_at(fields: opened, index: 0) {
      Absent => none
      Present { value: nm } => match sdr_field_at(fields: opened, index: 1) {
        Absent => none
        Present { value: closed } => {
          let hexes = split(s: closed, delimiter: ")") |> map(h => trim(h))
          if hexes.length() != 2 {
            none
          } else {
            match sdr_field_at(fields: hexes, index: 0) {
              Absent => none
              Present { value: hx } => if string_contains(s: hx, pattern: "0x") {
                Present { value: SdrBlockId { name: nm, number_hex: hx } }
              } else {
                none
              }
            }
          }
        }
      }
    }
  }
}

// THE HEADER TEST IS AN EXACT LABEL, not a substring: a continuation line that merely mentions
// Sensor ID must not open a block and steal the details of the record before it.
fn sdr_block_open(text: String) -> SdrVerboseRecord? {
  let parts = split(s: trim(text), delimiter: " : ") |> map(p => trim(p))
  if parts.length() != 2 {
    none
  } else {
    match sdr_field_at(fields: parts, index: 0) {
      Absent => none
      Present { value: label } => if label != "Sensor ID" {
        none
      } else {
        match sdr_field_at(fields: parts, index: 1) {
          Absent => none
          Present { value: value_text } => match sdr_block_id(value: value_text) {
            Absent => none
            Present { value: id } => Present { value: SdrVerboseRecord { name: id.name, number_hex: id.number_hex, detail_lines: [] } }
          }
        }
      }
    }
  }
}

fn sdr_verbose_group(lines: List<String>, current: SdrVerboseRecord?, acc: List<SdrVerboseRecord>) -> List<SdrVerboseRecord> {
  match lines {
    Empty => match current {
      Present { value: r } => acc.concat([r])
      Absent => acc
    }
    Cons { head: line, tail: rest } => match sdr_block_open(text: line) {
      Present { value: opened } => match current {
        Present { value: r } => sdr_verbose_group(lines: rest, current: opened, acc: acc.concat([r]))
        Absent => sdr_verbose_group(lines: rest, current: opened, acc: acc)
      }
      Absent => match current {
        Present { value: r } => if trim(line) == "" {
          sdr_verbose_group(lines: rest, current: current, acc: acc)
        } else {
          sdr_verbose_group(lines: rest, current: SdrVerboseRecord { name: r.name, number_hex: r.number_hex, detail_lines: r.detail_lines.concat([line]) }, acc: acc)
        }
        Absent => sdr_verbose_group(lines: rest, current: current, acc: acc)
      }
    }
  }
}

// A successful read that yielded NO records is its own state, never 'captured': a caller that
// treats an empty repository as a typed one would admit rows nothing typed.
fn sdr_verbose_readout(success: Bool, stdout: String) -> SdrVerboseReadout {
  if !success {
    SdrVerboseUnreadable
  } else {
    let records = sdr_verbose_group(lines: split(s: stdout, delimiter: "\n"), current: none, acc: [])
    if records.length() == 0 {
      SdrVerboseEmptyRepository
    } else {
      SdrVerboseRead { records: records }
    }
  }
}
