module extdeps.bmc.openbmc


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/openbmc/openbmc"
  }
}

data openbmc_factory_login: std.credentials.FactoryLogin = std.credentials.FactoryLogin {
  username: "root",
  published_password: "0penBmc",
}

data openbmc_supported_protocols: List<std.bmc.BmcProtocol> = [Redfish, Ipmi]

type RedfishHostStorageVisibility =
    HostStorageEnumerable
  | HostStorageBlind

data openbmc_redfish_host_storage_visibility: RedfishHostStorageVisibility = HostStorageBlind

fn bmc_firmware_factory_login(family: std.bmc.BmcFirmwareFamily) -> std.credentials.FactoryLogin {
  match family {
    OpenBmc => openbmc_factory_login
  }
}

fn bmc_firmware_supported_protocols(family: std.bmc.BmcFirmwareFamily) -> List<std.bmc.BmcProtocol> {
  match family {
    OpenBmc => openbmc_supported_protocols
  }
}

fn bmc_firmware_host_storage_visibility(family: std.bmc.BmcFirmwareFamily) -> RedfishHostStorageVisibility {
  match family {
    OpenBmc => openbmc_redfish_host_storage_visibility
  }
}
