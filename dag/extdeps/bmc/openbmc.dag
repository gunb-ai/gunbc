module extdeps.bmc.openbmc

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openbmc/openbmc"
  }
}

data openbmc_factory_login: FactoryLogin = FactoryLogin {
  username: "root",
  published_password: "0penBmc",
}

data openbmc_supported_protocols: List<BmcProtocol> = [Redfish, Ipmi]

type RedfishHostStorageVisibility =
    HostStorageEnumerable
  | HostStorageBlind

data openbmc_redfish_host_storage_visibility: RedfishHostStorageVisibility = HostStorageBlind

fn bmc_firmware_factory_login(family: BmcFirmwareFamily) -> FactoryLogin {
  match family {
    OpenBmc => openbmc_factory_login
  }
}

fn bmc_firmware_supported_protocols(family: BmcFirmwareFamily) -> List<BmcProtocol> {
  match family {
    OpenBmc => openbmc_supported_protocols
  }
}

fn bmc_firmware_host_storage_visibility(family: BmcFirmwareFamily) -> RedfishHostStorageVisibility {
  match family {
    OpenBmc => openbmc_redfish_host_storage_visibility
  }
}
