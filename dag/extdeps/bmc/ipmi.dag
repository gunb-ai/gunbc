module extdeps.bmc.ipmi

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { Bool, Int, List, NonEmptyStr, String, Unit }
import std.optional { Present, Absent }
import std.algebra { trim }
import std.resources { Network }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
// THE SUBJECT IS THE IPMITOOL TRANSPORT, NOT THE IPMI WIRE SPEC. diagnostic.ipmi.Tool is the
// module's bound realization of ipmitool(1)'s command surface (argv, -I/-H/-U/-f flags, output
// parsing), so the primary citation is the tool's own man page (doc/ipmitool.1.in; latest release
// 1.8.19). The Intel IPMI v2.0 rev1.1 spec stays as a further citation for the wire semantics the
// tool drives -- the live PDF this repository already cites in extdeps.bmc.ipmi_sel; the earlier
// HTML locator redirected to Intel's 404 and was dropped.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ipmitool/ipmitool/blob/master/doc/ipmitool.1.in"
  }
}

data extdeps_intel_ipmi_spec_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.intel.com/content/dam/www/public/us/en/documents/product-briefs/ipmi-second-gen-interface-spec-v2-rev1-1.pdf"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.ipmi",
      decl_name: "diagnostic.ipmi.Tool",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [extdeps.bmc.ipmi.extdeps_intel_ipmi_spec_citation]
}

// THE WRITE HALF OF THE IPMI CHASSIS INTERFACE was added 2026-09-05 beside the three readonly
// operations this service already carried (IPMI v2.0 rev1.1 §28, Chassis Device Commands: Set
// System Boot Options and Chassis Control). ChassisBootDev and ChassisPowerControl are not
// `readonly`; the rest are. They exist because a converge arm that drives a host with NO
// OPERATING SYSTEM has no other way in — every other transport in this repository reaches a machine
// THROUGH the thing being installed.
//
// CREDENTIALS NEVER REACH ARGV. ipmitool's -f takes a file holding the password, which keeps the
// secret out of the process table on a shared host; the caller materializes that file and passes its
// path. A -P arm is deliberately NOT modeled: it is the shorter spelling and it publishes the
// credential to every `ps` on the box.
//
// CREDENTIAL ROTATION IS DELIBERATELY NOT MODELED HERE, and its absence is the finding. A
// UserSetPassword operation was authored on 2026-09-05 and is REMOVED rather than repaired: it
// rendered `ipmitool -f CURRENT user set password ID -f NEW`, and the second -f is not an
// instruction to read the replacement password from a file. Upstream documents -f as the
// SESSION-AUTHENTICATION password option; the replacement password is a positional argument to
// `user set password`. So the operation did not do what its name said, and the only spellings that
// work put the new secret into argv — where every `ps` on the box can read it — which is the one
// thing the -f convention above exists to prevent.
//
// WHAT WOULD ADMIT IT BACK: a verified non-argv secret-input mechanism for this transport, and an
// acceptance test that opens a FRESH AUTHENTICATED SESSION with the replacement credential before
// reporting rotation complete. A command that returns zero establishes that ipmitool exited, not
// that the account was re-keyed. Until then the operator ruling that rotation is a converge phase
// stands with no operation to perform it, which is an honest gap rather than a broken one.
//
// NOTE THE ASYMMETRY, because it is a real gap rather than a
// style difference — the three original readonly operations carry no credential at all and so
// cannot authenticate to a controller that requires one, which is why the Mt. Collins intake pass
// could not use them.
//
// DEVICE AND ACTION ARE PARAMETERS, NOT LITERALS. Which boot device a workflow selects, and whether
// it cycles or resets, is business policy and belongs to the workflow layer (DESIGN §3); an argv
// carrying a baked "pxe" here would be the policy leak that section names, and would need a second
// near-identical operation the first time anything wanted `cdrom`.
//
// ChassisBootParamGet IS WHAT MAKES ChassisBootDev OBSERVABLE. A set command's own exit status says
// the controller ACCEPTED the request; boot parameter 5 says what it now holds, and only the second
// distinguishes a controller that applied the override from one that ignored it. Measured on the
// Mt. Collins unit 2026-09-05: before "No override", after "Force PXE", "Options apply to only next
// boot".
//
// ChassisStatus AND ChassisBootParamGet RUN UNDER coreutils `timeout` AND HAVE NO UNBOUNDED TWIN.
// Every caller polls or gates on them (the boot handoff's power read-back, the fan series, the boot
// diagnostics), and an unbounded read is a step that can outlive its derived timeout. The bound is
// the caller's policy, passed in as deadline and kill_after; one operation per command, so the argv
// has one home (review 71095 on gunbc#12263 refused a second, bounded copy of each).
//
// THIS PROSE SITS ABOVE THE SERVICE AND NOT BESIDE EACH OPERATION because §4c admits annotations at
// module-item grain only; a `//` block inside a declaration body is a hard error, which is how the
// first draft of these operations was caught.
// SelListAuthenticated IS SelList WITH A CREDENTIAL, FOR THE SAME REASON SdrTypeList IS SdrList
// WITH ONE: every controller in this fleet refuses an unauthenticated session, and changing what
// SelList means would silently change its existing readers. It binds stderr and exit_code because
// its consumer (gunbc.machine_intake.megarac_boot_diagnostic_bundle) records WHY a read failed,
// and it runs under coreutils `timeout` (extdeps.tools.gnu_coreutils timeout_command's argv shape,
// --kill-after included; exit 124 on expiry) with the caller's bound, so a controller that does not
// answer is a bounded reading, not a hung step, whatever ipmitool's own retry schedule is.
//
// FruPrint RUNS UNDER coreutils `timeout` LIKE ITS BOUNDED SIBLINGS, since the boot's read-only
// pre-power phase now gates on it (#15193, review 86419): an unbounded `fru print` against a
// controller that does not answer would outlive the phase it belongs to, and the bound is caller
// policy (deadline + kill_after, exit 124 on expiry), one operation per command.
//
// SdrDumpAuthenticated AND SelListAuthenticatedCached ARE ONE READ SPLIT AT THE SDR. ipmitool(1)
// (ipmitool 1.8.19, OPTIONS and SEL COMMANDS): `sel elist` "cross-references event records with
// sensor data records to produce descriptive event output", so an uncached elist reads the whole SDR
// repository from the controller before it prints a record; `sdr dump <file>` writes that repository
// to a local file, and `-S <sdr_cache_file>` "use[s] local file for remote SDR cache", which the page
// says "can drastically increase performance for commands that require knowledge of the entire SDR,
// such as sdr, sel elist". The cached read is a second operation rather than an optional flag on the
// first because an absent cache file is not the same argv with a blank: SelListAuthenticated keeps
// meaning "the controller supplies its own SDR". Both run under coreutils `timeout` for the reason
// SelListAuthenticated does.
//
// SdrElistAuthenticatedCached IS THE WHOLE SENSOR TABLE THROUGH THE SAME CACHE. ipmitool(1) SDR
// COMMANDS: `sdr elist` prints every sensor with its sensor number, status, ENTITY ID and reading,
// and the entity id ("<entity>.<instance>", IPMI v2.0 §43.14 and Table 43-13) is what attributes a
// sensor to a physical subject such as one processor package. It reads through -S for the reason
// SelListAuthenticatedCached does, and it is readonly: reading a sensor does not change it.
//
// MasterWriteReadAuthenticated IS IPMI v2.0 §22.11 (NetFn App 06h, command 52h) through `ipmitool raw`,
// with the request's framing modeled in extdeps.bmc.ipmi_master_write_read. Its write carries exactly
// two data bytes because the one consumer's device protocol (extdeps.ampere.smpro_register: register
// address, value size) is two bytes; a device with a different write length is a second operation,
// not a variadic argv this transport cannot express. It is deliberately NOT `readonly`: the command
// performs an I2C write on the BMC's bus, and whether that write changes the addressed device is a
// fact about the device, which the caller's register model states and this operation cannot.
//
// SdrTypeList IS THE AUTHENTICATED, TYPE-SELECTED READ, AND IT EXISTS BECAUSE SdrList COULD NOT BE
// USED. The three original readonly operations carry no credential, which the asymmetry paragraph
// above already records as a real gap; every controller in this fleet now requires one, so a sensor
// read had no reachable operation at all. Rather than add a credential to SdrList and change what an
// existing operation means, this is a second operation whose whole contract is authenticated,
// type-selected sensor reading.
//
// THE SENSOR TYPE IS A PARAMETER FOR THE SAME REASON THE BOOT DEVICE IS. "Fan" and "Temperature" are
// the two a fan-policy observation wants today and they are business policy, not facts about the
// IPMI interface; baking either into argv here would need a second near-identical operation the
// first time anything wanted "Power Supply". The values are the SDR sensor-type strings ipmitool
// itself accepts, which come from the IPMI specification's sensor-type table.
// WHY `sol activate` REFUSED, AS ipmitool 1.8.19 SAYS IT (lib/ipmi_sol.c ipmi_sol_activate, which the
// Ubuntu 1.8.19-7ubuntu0.24.04.3 patch series leaves untouched). The first five are its renderings of
// the Activate Payload response (IPMI v2.0 §24.1: payload already active, payload disabled,
// activation limit, and the two encryption mismatches); "Error activating SOL payload" carries any
// other completion code; "No response activating SOL payload" is no response at all.
type IpmitoolSolActivateRefusal
  = SolPayloadAlreadyActive
  | SolPayloadDisabled
  | SolPayloadActivationLimitReached
  | SolPayloadEncryptionMismatch { detail: String }
  | SolPayloadActivationError { detail: String }
  | SolPayloadActivationUnanswered

// THE SESSION IS OPERATIONAL, AS ipmitool 1.8.19 SAYS IT: ipmi_sol_activate prints this banner on
// STDOUT once the Activate Payload exchange (and any port handoff) has succeeded, immediately before
// ipmi_sol_red_pill starts receiving -- so it is the first thing the session writes to stdout, ahead
// of any host byte. It is printf-buffered; a consumer that needs it promptly must line-buffer stdout.
data ipmitool_sol_operational_banner: String = "[SOL Session operational."

fn ipmitool_sol_activate_line(output: String, pattern: String) -> String {
  let hits: List<String> = filter(split(s: output, delimiter: "\n"), l => string_contains(s: l, pattern: pattern))
  match hits.first() {
    Present { value: l } => trim(s: l)
    Absent => ""
  }
}

fn ipmitool_sol_activate_refusal(output: String) -> IpmitoolSolActivateRefusal? {
  if string_contains(s: output, pattern: "SOL payload already active on another session") {
    Present { value: SolPayloadAlreadyActive }
  } else if string_contains(s: output, pattern: "SOL payload disabled") {
    Present { value: SolPayloadDisabled }
  } else if string_contains(s: output, pattern: "SOL payload activation limit reached") {
    Present { value: SolPayloadActivationLimitReached }
  } else if string_contains(s: output, pattern: "cannot activate SOL payload with") {
    Present { value: SolPayloadEncryptionMismatch { detail: ipmitool_sol_activate_line(output: output, pattern: "cannot activate SOL payload with") } }
  } else if string_contains(s: output, pattern: "Error activating SOL payload") {
    Present { value: SolPayloadActivationError { detail: ipmitool_sol_activate_line(output: output, pattern: "Error activating SOL payload") } }
  } else if string_contains(s: output, pattern: "No response activating SOL payload") {
    Present { value: SolPayloadActivationUnanswered }
  } else {
    none
  }
}

fn ipmitool_sol_activate_refusal_text(refusal: IpmitoolSolActivateRefusal) -> String {
  match refusal {
    SolPayloadAlreadyActive => "the SOL payload is already active on another session"
    SolPayloadDisabled => "the SOL payload is disabled on the BMC"
    SolPayloadActivationLimitReached => "the BMC's SOL payload activation limit is reached"
    SolPayloadEncryptionMismatch { detail: d } => concat("SOL payload encryption mismatch: ", d)
    SolPayloadActivationError { detail: d } => d
    SolPayloadActivationUnanswered => "no response activating the SOL payload"
  }
}

// THE CIPHER SUITE IS THE ROUTE'S, AND EVERY LANPLUS OPERATION TAKES IT. ipmitool(1): "-C <ciphersuite>  The
// remote server authentication, integrity, and encryption algorithms to use for IPMIv2.0 lanplus connections",
// with ipmitool's own default when the option is absent. Which suite a BMC admits at ADMINISTRATOR is that BMC's
// fact (its lan print's cipher-suite privilege levels, extdeps.bmc.ipmitool_print_read
// ipmi_cipher_suites_admitting_admin), so this module holds NO default suite: each route supplies its own,
// Absent renders no -C at all and the argv is exactly what it was before the option existed, and Present renders
// "-C" and the suite. The input is required on every operation, so a call site cannot leave it to a default.
// THE CIPHER SUITE IDS, as the IPMI v2.0 specification assigns them (extdeps_intel_ipmi_spec_citation, its Cipher Suite
// IDs table: Table 22-20 in the rev 1.1 numbering the operator cites). Each ID names one authentication algorithm
// (RAKP), one integrity algorithm and one confidentiality algorithm, and the spec's ID is kept as the suite's id,
// never renumbered. The rows are transcribed from ipmitool's implementation of that table
// (github.com/ipmitool/ipmitool src/plugins/lanplus/lanplus.c, lanplus_get_requested_ciphers), whose comment
// cites "table 22-19": the numbering differs between revisions of the spec, and the spec PDF could not be read as
// text here to settle which. Only IDs 0 to 17 are transcribed, because that is what the read source confirms; the
// spec's later rows and its OEM range are not, so an ID outside this table has no IpmiCipherSuite and a reader
// carries it as unlisted rather than as a guessed row.
type IpmiAuthenticationAlgorithm
  = RakpNone
  | RakpHmacSha1
  | RakpHmacMd5
  | RakpHmacSha256

type IpmiIntegrityAlgorithm
  = IntegrityNone
  | HmacSha1_96
  | HmacMd5_128
  | Md5_128
  | HmacSha256_128

type IpmiConfidentialityAlgorithm
  = ConfidentialityNone
  | AesCbc128
  | Xrc4_128
  | Xrc4_40

type IpmiCipherSuite sole_constructor {
  id: Int
  authentication: IpmiAuthenticationAlgorithm
  integrity: IpmiIntegrityAlgorithm
  confidentiality: IpmiConfidentialityAlgorithm
}

data ipmi_cipher_suite_table: List<IpmiCipherSuite> = [
  IpmiCipherSuite { id: 0, authentication: RakpNone, integrity: IntegrityNone, confidentiality: ConfidentialityNone },
  IpmiCipherSuite { id: 1, authentication: RakpHmacSha1, integrity: IntegrityNone, confidentiality: ConfidentialityNone },
  IpmiCipherSuite { id: 2, authentication: RakpHmacSha1, integrity: HmacSha1_96, confidentiality: ConfidentialityNone },
  IpmiCipherSuite { id: 3, authentication: RakpHmacSha1, integrity: HmacSha1_96, confidentiality: AesCbc128 },
  IpmiCipherSuite { id: 4, authentication: RakpHmacSha1, integrity: HmacSha1_96, confidentiality: Xrc4_128 },
  IpmiCipherSuite { id: 5, authentication: RakpHmacSha1, integrity: HmacSha1_96, confidentiality: Xrc4_40 },
  IpmiCipherSuite { id: 6, authentication: RakpHmacMd5, integrity: IntegrityNone, confidentiality: ConfidentialityNone },
  IpmiCipherSuite { id: 7, authentication: RakpHmacMd5, integrity: HmacMd5_128, confidentiality: ConfidentialityNone },
  IpmiCipherSuite { id: 8, authentication: RakpHmacMd5, integrity: HmacMd5_128, confidentiality: AesCbc128 },
  IpmiCipherSuite { id: 9, authentication: RakpHmacMd5, integrity: HmacMd5_128, confidentiality: Xrc4_128 },
  IpmiCipherSuite { id: 10, authentication: RakpHmacMd5, integrity: HmacMd5_128, confidentiality: Xrc4_40 },
  IpmiCipherSuite { id: 11, authentication: RakpHmacMd5, integrity: Md5_128, confidentiality: ConfidentialityNone },
  IpmiCipherSuite { id: 12, authentication: RakpHmacMd5, integrity: Md5_128, confidentiality: AesCbc128 },
  IpmiCipherSuite { id: 13, authentication: RakpHmacMd5, integrity: Md5_128, confidentiality: Xrc4_128 },
  IpmiCipherSuite { id: 14, authentication: RakpHmacMd5, integrity: Md5_128, confidentiality: Xrc4_40 },
  IpmiCipherSuite { id: 15, authentication: RakpHmacSha256, integrity: IntegrityNone, confidentiality: ConfidentialityNone },
  IpmiCipherSuite { id: 16, authentication: RakpHmacSha256, integrity: HmacSha256_128, confidentiality: ConfidentialityNone },
  IpmiCipherSuite { id: 17, authentication: RakpHmacSha256, integrity: HmacSha256_128, confidentiality: AesCbc128 },
]

// The suite the spec assigns to an ID, or Absent for an ID this table does not list.
fn ipmi_cipher_suite_of_id(id: Int) -> IpmiCipherSuite? {
  first(filter(ipmi_cipher_suite_table, s => s.id == id))
}

// THE OPERATIONS TAKE THE SUITE AS WORDS, NOT AS THE TYPE: a stated divergence (DESIGN 3b). The typed suite is
// rendered here, by this one function, and each diagnostic.ipmi.Tool operation receives the words as
// cipher_suite_argv: List<String>, because (1) std.operation_argv shell_materialize_operation_argv refuses a call in
// an argv element as ArgvExpressionUnsupported (its own declared residue, operation_argv_expression_residue_note),
// and the byte-equality control over mtcollins1's argv (test.claim.bmc.ipmi_cipher_suite_argv_witness) materializes
// through it; and (2) a sealed record input does not splice at execution: the seed splices only a native List or a
// std.compilers.cli_surface ProcessArgvExpansion into an argv and renders any other record as one Debug-text word
// (gunbc.v1.v1_maintenance_standing records that seam as unreachable and its repair as not admitted in the seed,
// with this design as its near-miss). The operations switch to cipher_suite: IpmiCipherSuite? when argv element
// evaluation lands in std.operation_argv, or when the v2 realization of the shell transport splices a declared
// sealed role type.
fn ipmi_cipher_suite_argv(suite: IpmiCipherSuite?) -> List<String> {
  match suite {
    Absent => []
    Present { value: s } => ["-C", to_string(s.id)]
  }
}

service diagnostic.ipmi.Tool {
  operation SensorList {
    requires Network
    input { bmc_host: NonEmptyStr, cipher_suite_argv: List<String> }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell { argv: ["ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "sensor"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool sensor failed"
    }
  }

  operation SdrList {
    requires Network
    input { bmc_host: NonEmptyStr, cipher_suite_argv: List<String> }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell { argv: ["ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "sdr", "elist"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool sdr failed"
    }
  }

  operation SdrTypeList {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, sensor_type: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr, cipher_suite_argv: List<String> }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell { argv: ["timeout", "--kill-after", "{kill_after}", "{deadline}", "ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "sdr", "type", "{sensor_type}"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool sdr type failed"
    }
  }

  operation SelList {
    requires Network
    input { bmc_host: NonEmptyStr, cipher_suite_argv: List<String> }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell { argv: ["ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "sel", "elist"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool sel failed"
    }
  }

  operation SelListAuthenticated {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr, cipher_suite_argv: List<String> }
    output {
      stdout: String from "stdout",
      transport_stderr: String from "stderr",
      exit_code: Int from "exit_code",
      success: Bool from "exit_success",
    }
    readonly
    transport shell { argv: ["timeout", "--kill-after", "{kill_after}", "{deadline}", "ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "sel", "elist"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool authenticated sel elist failed"
    }
  }

  operation SdrDumpAuthenticated {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, sdr_cache_file: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr, cipher_suite_argv: List<String> }
    output {
      stdout: String from "stdout",
      transport_stderr: String from "stderr",
      exit_code: Int from "exit_code",
      success: Bool from "exit_success",
    }
    transport shell { argv: ["timeout", "--kill-after", "{kill_after}", "{deadline}", "ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "sdr", "dump", "{sdr_cache_file}"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool authenticated sdr dump failed"
    }
  }

  operation SelListAuthenticatedCached {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, sdr_cache_file: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr, cipher_suite_argv: List<String> }
    output {
      stdout: String from "stdout",
      transport_stderr: String from "stderr",
      exit_code: Int from "exit_code",
      success: Bool from "exit_success",
    }
    readonly
    transport shell { argv: ["timeout", "--kill-after", "{kill_after}", "{deadline}", "ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "-S", "{sdr_cache_file}", "sel", "elist"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool authenticated cached sel elist failed"
    }
  }

  operation SdrElistAuthenticatedCached {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, sdr_cache_file: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr, cipher_suite_argv: List<String> }
    output {
      stdout: String from "stdout",
      transport_stderr: String from "stderr",
      exit_code: Int from "exit_code",
      success: Bool from "exit_success",
    }
    readonly
    transport shell { argv: ["timeout", "--kill-after", "{kill_after}", "{deadline}", "ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "-S", "{sdr_cache_file}", "sdr", "elist"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool authenticated cached sdr elist failed"
    }
  }

  operation MasterWriteReadAuthenticated {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, bus: NonEmptyStr, slave_address: NonEmptyStr, read_count: NonEmptyStr, write_first: NonEmptyStr, write_second: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr, cipher_suite_argv: List<String> }
    output {
      stdout: String from "stdout",
      transport_stderr: String from "stderr",
      exit_code: Int from "exit_code",
      success: Bool from "exit_success",
    }
    transport shell { argv: ["timeout", "--kill-after", "{kill_after}", "{deadline}", "ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "raw", "0x06", "0x52", "{bus}", "{slave_address}", "{read_count}", "{write_first}", "{write_second}"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool raw master write-read failed"
    }
  }

  operation ChassisBootDev {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, device: NonEmptyStr, cipher_suite_argv: List<String> }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    transport shell { argv: ["ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "chassis", "bootdev", "{device}"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool chassis bootdev failed"
    }
  }

  operation ChassisBootDevWithOptions {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, device: NonEmptyStr, options: NonEmptyStr, cipher_suite_argv: List<String> }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    transport shell { argv: ["ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "chassis", "bootdev", "{device}", "options={options}"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool chassis bootdev with options failed"
    }
  }

  operation SolDeactivate {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, cipher_suite_argv: List<String> }
    output { stdout: String from "stdout", success: Bool from "exit_success" }
    transport shell { argv: ["ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "sol", "deactivate"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool sol deactivate failed"
    }
  }

  operation ChassisBootParamGet {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, parameter: NonEmptyStr, deadline: NonEmptyStr, kill_after: NonEmptyStr, cipher_suite_argv: List<String> }
    output {
      stdout: String from "stdout",
      transport_stderr: String from "stderr",
      exit_code: Int from "exit_code",
      success: Bool from "exit_success",
    }
    readonly
    transport shell { argv: ["timeout", "--kill-after", "{kill_after}", "{deadline}", "ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "chassis", "bootparam", "get", "{parameter}"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool chassis bootparam get failed"
    }
  }

