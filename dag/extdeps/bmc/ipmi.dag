    }
    transport shell { argv: ["timeout", "--kill-after", "{kill_after}", "{deadline}", "ipmitool", "-H", "{bmc_host}", "-I", "lanplus", cipher_suite_argv, "-U", "{username}", "-f", "{password_file}", "chassis", "power", "{action}"] }
    exit {
      0 => Unit
      nonzero => String "ipmitool chassis power failed"
    }
  }

