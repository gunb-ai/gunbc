fn openbmc_make_directory(
  session: PasswordSshSession,
  path: NonEmptyStr,
  parents: Bool,
) -> PasswordSshExecResult {
  if parents {
    password_ssh_session_exec_argv(
      session: session,
      argv: ["mkdir", "-p", path as String],
    )
  } else {
    password_ssh_session_exec_argv(
      session: session,
      argv: ["mkdir", path as String],
    )
  }
}

fn openbmc_remove_directory(
  session: PasswordSshSession,
  path: NonEmptyStr,
) -> PasswordSshExecResult {
  password_ssh_session_exec_argv(
    session: session,
    argv: ["rmdir", path as String],
  )
}

