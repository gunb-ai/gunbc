  if parents {
    openbmc_execute(
      session: session,
      operation: OpenBmcMakeDirectory { path: path, parents: true },
    )
  } else {
    openbmc_execute(
      session: session,
      operation: OpenBmcMakeDirectory { path: path, parents: false },
    )
