data extdeps_external_authority_anchor: ExternalAuthority = openbmc_busctl_authority

data openbmc_json_projection_authority: ExternalAuthority = jq_authority

type OpenBmcLocalTransformResult {
  exit_code: Int
  success: Bool
  content: String
  stderr: String
}

fn openbmc_threshold_interface(threshold: OpenBmcThresholdProperty) -> NonEmptyStr {
  match threshold {
    OpenBmcWarningLow => "xyz.openbmc_project.Sensor.Threshold.Warning"
    OpenBmcCriticalLow => "xyz.openbmc_project.Sensor.Threshold.Critical"
  }
}

fn openbmc_threshold_property(threshold: OpenBmcThresholdProperty) -> NonEmptyStr {
  match threshold {
    OpenBmcWarningLow => "WarningLow"
    OpenBmcCriticalLow => "CriticalLow"
  }
}

type OpenBmcSelection<T>
  = OpenBmcSelectionZero
  | OpenBmcSelectionOne { value: T }
  | OpenBmcSelectionMany { count: Int }

type OpenBmcCollection<T>
  = OpenBmcCollectionZero
  | OpenBmcCollectionOne { value: T }
  | OpenBmcCollectionMany { values: List<T> }

fn openbmc_collection_from_values<T>(
  values: List<T>,
) -> OpenBmcCollection<T> {
  if values.length() == 0 {
    OpenBmcCollectionZero
  } else if values.length() == 1 {
    OpenBmcCollectionOne { value: values.first() }
  } else {
    OpenBmcCollectionMany { values: values }
  }
}

type OpenBmcStepwiseController {
  minimum_duty: Percent
  zone_failsafe_duty: Percent
  sensor_failsafe_duty: Percent
  positive_hysteresis: CelsiusDelta
  negative_hysteresis: CelsiusDelta
  readings: List<Celsius>
  outputs: List<Percent>
}

fn openbmc_fan_config_desired_json(desired: OpenBmcFanConfigDesired) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "minimum", value: json_int(n: percent_count(desired.minimum_duty))),
    json_kv(key: "zone_failsafe_duty", value: json_int(n: percent_count(desired.zone_failsafe_duty))),
    json_kv(key: "sensor_failsafe", value: json_int(n: percent_count(desired.sensor_failsafe_duty))),
    json_kv(key: "positive_hysteresis", value: json_int(n: celsius_delta_count(desired.positive_hysteresis))),
    json_kv(key: "negative_hysteresis", value: json_int(n: celsius_delta_count(desired.negative_hysteresis))),
    json_kv(
      key: "readings",
      value: json_array(elements: desired.readings |> map(value => json_int(n: celsius_count(value)))),
    ),
    json_kv(
      key: "outputs",
      value: json_array(elements: desired.outputs |> map(value => json_int(n: percent_count(value)))),
    ),
    json_kv(
      key: "fan_pid_entry",
      value: json_string(s: desired.fan_controller_name as String),
    ),
    json_kv(
      key: "fan_inputs",
      value: json_array(elements: desired.fan_inputs |> map(value =>
        json_string(s: value as String)
      )),
    ),
  ]))
}

type OpenBmcFanController {
  name: NonEmptyStr
  inputs: List<NonEmptyStr>
}

type OpenBmcFanConfigObservation {
  stepwise: OpenBmcSelection<OpenBmcStepwiseController>
  fan_controllers: OpenBmcCollection<OpenBmcFanController>
}

type OpenBmcFanConfigObservationResult
  = OpenBmcFanConfigObserved { observation: OpenBmcFanConfigObservation }
  | OpenBmcFanConfigObservationRefused { reason: String }

fn openbmc_fan_config_selector(query: OpenBmcFanConfigQuery) -> NonEmptyStr {
  match query {
    OpenBmcStepwiseCount =>
      "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")] | length"
    OpenBmcMinimumDuty =>
      "[.zones[] | select(any(.pids[]; .name == \"TEMP_SOC\" and .type == \"stepwise\"))][0].minThermalOutput | floor"
    OpenBmcZoneFailsafeDuty =>
      "[.zones[] | select(any(.pids[]; .name == \"TEMP_SOC\" and .type == \"stepwise\"))][0].failsafePercent | floor"
    OpenBmcSensorFailsafeDuty =>
      "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")][0].failsafePercent | floor"
    OpenBmcPositiveHysteresis =>
      "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")][0].pid.positiveHysteresis | floor"
    OpenBmcNegativeHysteresis =>
      "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")][0].pid.negativeHysteresis | floor"
    OpenBmcReadingCount =>
      "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")][0].pid.reading | length"
    OpenBmcOutputCount =>
      "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")][0].pid.output | length"
    OpenBmcReadingAt { index: _ } =>
      "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")][0].pid.reading | to_entries | sort_by(.key | tonumber) | .[$index].value | floor"
    OpenBmcOutputAt { index: _ } =>
      "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")][0].pid.output | to_entries | sort_by(.key | tonumber) | .[$index].value | floor"
    OpenBmcFanControllerCount =>
      "[.zones[].pids[] | select(.type == \"fan\")] | length"
    OpenBmcFanControllerNameAt { index: _ } =>
      "[.zones[].pids[] | select(.type == \"fan\")][$index].name"
    OpenBmcFanInputCountAt { fan_index: _ } =>
      "[.zones[].pids[] | select(.type == \"fan\")][$fan_index].inputs | length"
    OpenBmcFanInputAt { fan_index: _, input_index: _ } =>
      "[.zones[].pids[] | select(.type == \"fan\")][$fan_index].inputs[$input_index]"
  }
}

fn openbmc_fan_config_query_args(query: OpenBmcFanConfigQuery) -> List<String> {
  match query {
    OpenBmcReadingAt { index } => ["--argjson", "index", to_string(index)]
    OpenBmcOutputAt { index } => ["--argjson", "index", to_string(index)]
    OpenBmcFanControllerNameAt { index } => ["--argjson", "index", to_string(index)]
    OpenBmcFanInputCountAt { fan_index } => ["--argjson", "fan_index", to_string(fan_index)]
    OpenBmcFanInputAt { fan_index, input_index } => [
      "--argjson",
      "fan_index",
      to_string(fan_index),
      "--argjson",
      "input_index",
      to_string(input_index),
    ]
    _ => []
  }
}

fn openbmc_operation_argv(operation: OpenBmcOperation) -> List<String> {
  match operation {
    OpenBmcReadFile { path } => ["cat", path as String]
    OpenBmcResolvePath { path } => ["readlink", "-f", path as String]
    OpenBmcParentDirectory { path } => ["dirname", path as String]
    OpenBmcSystemdIsActive { service } => ["systemctl", "is-active", service as String]
    OpenBmcSystemdRestart { service } => ["systemctl", "restart", service as String]
    OpenBmcZoneFailsafe { zone_path } => [
      "busctl",
      "get-property",
      "xyz.openbmc_project.State.FanCtrl",
      zone_path as String,
      "xyz.openbmc_project.Control.Mode",
      "FailSafe",
    ]
    OpenBmcSensorServices { sensor_path } => [
      "busctl",
      "--json=short",
      "call",
      "xyz.openbmc_project.ObjectMapper",
      "/xyz/openbmc_project/object_mapper",
      "xyz.openbmc_project.ObjectMapper",
      "GetObject",
      "sas",
      sensor_path as String,
      "1",
      "xyz.openbmc_project.Sensor.Value",
    ]
    OpenBmcSensorValue { service, sensor_path } => [
      "busctl",
      "--json=short",
      "get-property",
      service as String,
      sensor_path as String,
      "xyz.openbmc_project.Sensor.Value",
      "Value",
    ]
    OpenBmcSensorThreshold { service, sensor_path, threshold } => [
      "busctl",
      "--json=short",
      "get-property",
      service as String,
      sensor_path as String,
      openbmc_threshold_interface(threshold: threshold) as String,
      openbmc_threshold_property(threshold: threshold) as String,
    ]
    OpenBmcFanConfigScalar { config_path, query } =>
      append(
        append(["jq", "-er"], items: openbmc_fan_config_query_args(query: query)),
        items: [openbmc_fan_config_selector(query: query) as String, config_path as String],
      )
    OpenBmcFanConfigValidate { config_path } => ["jq", "empty", config_path as String]
    OpenBmcFanConfigVerify { config_path, desired } => [
      "jq",
      "-e",
      "--argjson",
      "desired",
      openbmc_fan_config_desired_json(desired: desired),
      "([.zones[] | select(any(.pids[]; .name == \"TEMP_SOC\" and .type == \"stepwise\"))]) as $zones | ([.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")]) as $pids | ([.zones[].pids[] | select(.name == $desired.fan_pid_entry and .type == \"fan\")]) as $fans | (($zones | length) == 1) and (($pids | length) == 1) and (($fans | length) == 1) and ($zones[0].minThermalOutput == $desired.minimum) and ($zones[0].failsafePercent == $desired.zone_failsafe_duty) and ($pids[0].failsafePercent == $desired.sensor_failsafe) and ($pids[0].pid.positiveHysteresis == $desired.positive_hysteresis) and ($pids[0].pid.negativeHysteresis == $desired.negative_hysteresis) and ($pids[0].pid.reading == ($desired.readings | to_entries | map(\{key: (.key | tostring), value: .value}) | from_entries)) and ($pids[0].pid.output == ($desired.outputs | to_entries | map(\{key: (.key | tostring), value: .value}) | from_entries)) and ($fans[0].inputs == $desired.fan_inputs)",
      config_path as String,
    ]
    OpenBmcPathIsWritable { path } => ["test", "-w", path as String]
    OpenBmcPathExists { path } => ["test", "-e", path as String]
    OpenBmcPathIsNonemptyFile { path } => ["test", "-s", path as String]
    OpenBmcDiskUsageKib { path } => ["df", "-Pk", path as String]
    OpenBmcFileSha256 { path } => ["sha256sum", "--", path as String]
    OpenBmcUtcTimestamp => ["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"]
    OpenBmcMakeDirectory { path, parents } =>
      if parents { ["mkdir", "-p", path as String] } else { ["mkdir", path as String] }
    OpenBmcRemoveDirectory { path } => ["rmdir", path as String]
    OpenBmcRemoveFile { path } => ["rm", "-f", path as String]
    OpenBmcCopyFilePreservingMetadata { source_path, destination_path } =>
      ["cp", "-p", source_path as String, destination_path as String]
    OpenBmcRenameReplace { source_path, destination_path } =>
      ["mv", "-f", source_path as String, destination_path as String]
    OpenBmcSynchronizeFilesystems => ["sync"]
    OpenBmcWaitSeconds { duration } => ["sleep", to_string(second_count(duration))]
  }
}

fn openbmc_execute(
  session: PasswordSshSession,
  operation: OpenBmcOperation,
) -> PasswordSshExecResult {
  let result = match operation {
    OpenBmcReadFile { path } =>
      openbmc.PasswordSshTransport.ReadFile(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcResolvePath { path } =>
      openbmc.PasswordSshTransport.ResolvePath(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcParentDirectory { path } =>
      openbmc.PasswordSshTransport.ParentDirectory(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcSystemdIsActive { service } =>
      openbmc.PasswordSshTransport.SystemdIsActive(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
      )
    OpenBmcSystemdRestart { service } =>
      openbmc.PasswordSshTransport.SystemdRestart(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
      )
    OpenBmcZoneFailsafe { zone_path } =>
      openbmc.PasswordSshTransport.ZoneFailsafe(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        zone_path: zone_path,
      )
    OpenBmcSensorServices { sensor_path } =>
      openbmc.PasswordSshTransport.SensorServices(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        sensor_path: sensor_path,
      )
    OpenBmcSensorValue { service, sensor_path } =>
      openbmc.PasswordSshTransport.SensorValue(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
        sensor_path: sensor_path,
      )
    OpenBmcSensorThreshold { service, sensor_path, threshold } =>
      match threshold {
        OpenBmcWarningLow =>
          openbmc.PasswordSshTransport.SensorWarningLow(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
        sensor_path: sensor_path,
      )
        OpenBmcCriticalLow =>
          openbmc.PasswordSshTransport.SensorCriticalLow(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
        sensor_path: sensor_path,
      )
      }
    OpenBmcFanConfigScalar { config_path, query } =>
      match query {
        OpenBmcStepwiseCount =>
          openbmc.PasswordSshTransport.FanStepwiseCount(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcMinimumDuty =>
          openbmc.PasswordSshTransport.FanMinimumDuty(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcZoneFailsafeDuty =>
          openbmc.PasswordSshTransport.FanZoneFailsafeDuty(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcSensorFailsafeDuty =>
          openbmc.PasswordSshTransport.FanSensorFailsafeDuty(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcPositiveHysteresis =>
          openbmc.PasswordSshTransport.FanPositiveHysteresis(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcNegativeHysteresis =>
          openbmc.PasswordSshTransport.FanNegativeHysteresis(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcReadingCount =>
          openbmc.PasswordSshTransport.FanReadingCount(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcOutputCount =>
          openbmc.PasswordSshTransport.FanOutputCount(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcReadingAt { index } =>
          openbmc.PasswordSshTransport.FanReadingAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        index: index,
      )
        OpenBmcOutputAt { index } =>
          openbmc.PasswordSshTransport.FanOutputAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        index: index,
      )
        OpenBmcFanControllerCount =>
          openbmc.PasswordSshTransport.FanControllerCount(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcFanControllerNameAt { index } =>
          openbmc.PasswordSshTransport.FanControllerNameAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        index: index,
      )
        OpenBmcFanInputCountAt { fan_index } =>
          openbmc.PasswordSshTransport.FanInputCountAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        fan_index: fan_index,
      )
        OpenBmcFanInputAt { fan_index, input_index } =>
          openbmc.PasswordSshTransport.FanInputAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        fan_index: fan_index,
        input_index: input_index,
      )
      }
    OpenBmcFanConfigValidate { config_path } =>
      openbmc.PasswordSshTransport.FanConfigValidate(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
    OpenBmcFanConfigVerify { config_path, desired } =>
      openbmc.PasswordSshTransport.FanConfigVerify(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        desired_json: openbmc_fan_config_desired_json(desired: desired),
      )
    OpenBmcPathIsWritable { path } =>
      openbmc.PasswordSshTransport.PathIsWritable(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcPathExists { path } =>
      openbmc.PasswordSshTransport.PathExists(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcPathIsNonemptyFile { path } =>
      openbmc.PasswordSshTransport.PathIsNonemptyFile(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcDiskUsageKib { path } =>
      openbmc.PasswordSshTransport.DiskUsageKib(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcFileSha256 { path } =>
      openbmc.PasswordSshTransport.FileSha256(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcUtcTimestamp =>
      openbmc.PasswordSshTransport.UtcTimestamp(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
      )
    OpenBmcMakeDirectory { path, parents } =>
      if parents {
        openbmc.PasswordSshTransport.MakeDirectoryParents(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
      } else {
        openbmc.PasswordSshTransport.MakeDirectory(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
      }
    OpenBmcRemoveDirectory { path } =>
      openbmc.PasswordSshTransport.RemoveDirectory(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcRemoveFile { path } =>
      openbmc.PasswordSshTransport.RemoveFile(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcCopyFilePreservingMetadata { source_path, destination_path } =>
      openbmc.PasswordSshTransport.CopyFilePreservingMetadata(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        source_path: source_path,
        destination_path: destination_path,
      )
    OpenBmcRenameReplace { source_path, destination_path } =>
      openbmc.PasswordSshTransport.RenameReplace(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        source_path: source_path,
        destination_path: destination_path,
      )
    OpenBmcSynchronizeFilesystems =>
      openbmc.PasswordSshTransport.SynchronizeFilesystems(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
      )
    OpenBmcWaitSeconds { duration } =>
      openbmc.PasswordSshTransport.WaitSeconds(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        seconds: second_count(duration),
      )
  }
  PasswordSshExecResult {
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

service openbmc.JsonProjection {
  operation ProjectFanConfig {
    input {
      desired_json: String
      path: NonEmptyStr
    }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: [
        "jq",
        "--argjson",
        "desired",
        "{desired_json}",
        "if ([.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")] | length) != 1 then error(\"expected exactly one TEMP_SOC stepwise controller\") elif ([.zones[].pids[] | select(.name == $desired.fan_pid_entry and .type == \"fan\")] | length) != 1 then error(\"expected exactly one projected aggregate fan PID entry\") else .zones |= map(if any(.pids[]; .name == \"TEMP_SOC\" and .type == \"stepwise\") then .minThermalOutput = $desired.minimum | .failsafePercent = $desired.zone_failsafe_duty | .pids |= map(if .name == $desired.fan_pid_entry and .type == \"fan\" then .inputs = $desired.fan_inputs elif .name == \"TEMP_SOC\" and .type == \"stepwise\" then .failsafePercent = $desired.sensor_failsafe | .pid.positiveHysteresis = $desired.positive_hysteresis | .pid.negativeHysteresis = $desired.negative_hysteresis | .pid.reading = ($desired.readings | to_entries | map(\{key: (.key | tostring), value: .value}) | from_entries) | .pid.output = ($desired.outputs | to_entries | map(\{key: (.key | tostring), value: .value}) | from_entries) else . end) else . end) end",
        "{path}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "OpenBMC fan config projection failed"
    }
  }

  operation ObjectMapperServiceCount {
    input { content: String }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["jq", "-er", ".data[0] | keys | length"]
      stdin: content
    }
    exit {
      0 => Unit
      nonzero => String "ObjectMapper service count projection failed"
    }
  }

  operation ObjectMapperServiceAt {
    input { content: String, index: Int }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["jq", "-er", "--argjson", "index", "{index}", ".data[0] | keys | .[$index]"]
      stdin: content
    }
    exit {
      0 => Unit
      nonzero => String "ObjectMapper service projection failed"
    }
  }

  operation SensorIntegerValue {
    input { content: String }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["jq", "-r", "if (.data | type) == \"number\" then (.data | round) else empty end"]
      stdin: content
    }
    exit {
      0 => Unit
      nonzero => String "sensor integer projection failed"
    }
  }
}

