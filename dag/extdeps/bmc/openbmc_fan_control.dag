fn openbmc_copy_file_preserving_metadata(
  session: PasswordSshSession,
  source_path: NonEmptyStr,
  destination_path: NonEmptyStr,
) -> PasswordSshExecResult {
  password_ssh_session_exec_argv(
    session: session,
    argv: ["cp", "-p", source_path as String, destination_path as String],
  )
