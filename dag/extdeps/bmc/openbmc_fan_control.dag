type OpenBmcSensorServicesResult
  = OpenBmcSensorServicesObserved {
      services: OpenBmcCollection<NonEmptyStr>,
    }
  | OpenBmcSensorServicesRefused { reason: String }

type OpenBmcSensorValueResult
  = OpenBmcSensorValueObserved { value: Int }
  | OpenBmcSensorValueAbsent
  | OpenBmcSensorValueRefused { reason: String }

// exit_code, not `success: Bool`. Two fields for one fact is a second representation: success is
// exactly exit_code == 0, derived here where the three states are decided rather than carried
// alongside them.
// THE PROGRAM IS THE DOMAIN'S, THE FLAGS ARE JQ'S. This module states what it wants extracted;
// it never spells -r, --raw-output or an argv position. `else empty end` is deliberate and
// load-bearing: a non-numeric reading emits NOTHING and exits zero, which the decoder below reads
// as OpenBmcSensorValueAbsent -- a real third state beside Refused and Observed. That is why this
// path must NOT carry jq's --exit-status: it would collapse Absent into Refused on a live sensor.
data openbmc_sensor_integer_program: String = "if (.data | type) == \"number\" then (.data | round) else empty end"

// One place builds the sensor projection invocation, so both call sites cannot drift apart.
fn openbmc_sensor_integer_projection(content: String) -> OpenBmcSensorValueResult {
  match jq_invocation_process_plan(invocation: JqInvocation {
    program: JqProgram { source: openbmc_sensor_integer_program },
    bindings: Empty,
    input: JqInputStdin { content: content },
    output_encoding: JqRawOutput,
    exit_policy: JqProgramExit,
  }) {
    Rejected { diagnostics: _ } =>
      OpenBmcSensorValueRefused { reason: "sensor value projection could not be lowered to a jq invocation" }
    Accepted { value: plan, diagnostics: _ } => {
      let observed = jq_execute_admitted_plan(plan: plan)
      openbmc_sensor_integer_projection_result(
        outcome: jq_classify_observation(plan: plan, observation: observed),
      )
    }
  }
}

// THIS DECODER NO LONGER READS AN EXIT CODE, and that is the point of the arm it matches instead.
// It previously took exit_code/stdout/stderr and mapped every nonzero exit to a refusal -- correct
// under JqProgramExit, silently wrong under any other exit policy, and nothing connected the two.
// jq_classify_observation now owns that reading, against the policy carried on the plan, so this
// function decides only what OpenBMC alone can decide: whether a present projection is an integer.
fn openbmc_sensor_integer_projection_result(
  outcome: JqOutcome,
) -> OpenBmcSensorValueResult {
  match outcome {
    JqExecutionRefused { exit_code: _, stderr: stderr } =>
      OpenBmcSensorValueRefused { reason: stderr }
    JqOutputAbsent => OpenBmcSensorValueAbsent
    JqOutputPresent { text: text } =>
      match parse_int(s: trim(text)) {
        Absent =>
          OpenBmcSensorValueRefused {
            reason: "sensor value projection is not an integer",
          }
        Present { value: parsed } => OpenBmcSensorValueObserved { value: parsed }
      }
  }
}

// WAVE 1A, LANDED. The two ObjectMapper projections the sensor-service enumeration makes were
// argv-spelled shell operations (["jq","-er","--argjson","index","{index}", ...] and
// ["jq","-er",".data[0] | keys | length"]). Each is now a semantic JqInvocation whose flags and
// bindings are derived: the program is the domain's, --argjson and --exit-status are jq's. The
// callers below decode a JqOutcome and stop reading success/value/stderr.
//
// ServiceAt carries a typed JSON binding (index) through --argjson and reads under JqLastResultExit:
// the program emits the service name at that index, or nothing/exit-1 for an out-of-range index.
type OpenBmcServiceProjectionResult
  = OpenBmcServiceObserved { service: NonEmptyStr }
  | OpenBmcServiceProjectionRefused { reason: String }

type OpenBmcServiceCountResult
  = OpenBmcServiceCountObserved { count: Int }
  | OpenBmcServiceCountRefused { reason: String }

// `// empty` is load-bearing, not defensive: for an out-of-range index `.[$index]` yields NULL
// (jq's array-index contract), and under JqLastResultExit a null last output is a legitimate
// value -- exit 1 with stdout "null" -- which would decode as a service named "null". `null //
// empty` turns the out-of-range arm into NO output, so the observation is absence (exit 4), the
// missing-index refusal, never an observed service.
data openbmc_object_mapper_service_at_program: String = ".data[0] | keys | .[$index] // empty"
data openbmc_object_mapper_service_count_program: String = ".data[0] | keys | length"

fn openbmc_object_mapper_service_at(content: String, index: Int) -> OpenBmcServiceProjectionResult {
  match jq_invocation_process_plan(invocation: JqInvocation {
    program: JqProgram { source: openbmc_object_mapper_service_at_program },
    bindings: [
      JqJsonBinding {
        name: JqBindingName { name: "index" },
        value: json_int(n: index),
      }
    ],
    input: JqInputStdin { content: content },
    output_encoding: JqRawOutput,
    exit_policy: JqLastResultExit,
  }) {
    Rejected { diagnostics: _ } =>
      OpenBmcServiceProjectionRefused {
        reason: "ObjectMapper service projection could not be lowered to a jq invocation",
      }
    Accepted { value: plan, diagnostics: _ } => {
      let observed = jq_execute_admitted_plan(plan: plan)
      openbmc_object_mapper_service_at_result(
        outcome: jq_classify_observation(plan: plan, observation: observed),
      )
    }
  }
}

fn openbmc_object_mapper_service_at_result(
  outcome: JqOutcome,
) -> OpenBmcServiceProjectionResult {
  match outcome {
    JqExecutionRefused { exit_code: _, stderr: stderr } =>
      OpenBmcServiceProjectionRefused { reason: stderr }
    JqOutputAbsent =>
      OpenBmcServiceProjectionRefused {
        reason: "ObjectMapper has no service at this index",
      }
    JqOutputPresent { text: text } =>
      match trim(text) {
        Empty =>
          OpenBmcServiceProjectionRefused {
            reason: "ObjectMapper service name is blank",
          }
        non_empty => OpenBmcServiceObserved { service: non_empty as NonEmptyStr }
      }
  }
}

fn openbmc_object_mapper_service_count(content: String) -> OpenBmcServiceCountResult {
  match jq_invocation_process_plan(invocation: JqInvocation {
    program: JqProgram { source: openbmc_object_mapper_service_count_program },
    bindings: Empty,
    input: JqInputStdin { content: content },
    output_encoding: JqRawOutput,
    exit_policy: JqLastResultExit,
  }) {
    Rejected { diagnostics: _ } =>
      OpenBmcServiceCountRefused {
        reason: "ObjectMapper service count could not be lowered to a jq invocation",
      }
    Accepted { value: plan, diagnostics: _ } => {
      let observed = jq_execute_admitted_plan(plan: plan)
      openbmc_object_mapper_service_count_result(
        outcome: jq_classify_observation(plan: plan, observation: observed),
      )
    }
  }
}

fn openbmc_object_mapper_service_count_result(
  outcome: JqOutcome,
) -> OpenBmcServiceCountResult {
  match outcome {
    JqExecutionRefused { exit_code: _, stderr: stderr } =>
      OpenBmcServiceCountRefused { reason: stderr }
    JqOutputAbsent =>
      OpenBmcServiceCountRefused {
        reason: "ObjectMapper service count is absent",
      }
    JqOutputPresent { text: text } =>
      match parse_int(s: trim(text)) {
        Absent =>
          OpenBmcServiceCountRefused {
            reason: "ObjectMapper service count is not an integer",
          }
        Present { value: count } =>
          if count < 0 {
            OpenBmcServiceCountRefused {
              reason: "ObjectMapper service count is negative",
            }
          } else {
            OpenBmcServiceCountObserved { count: count }
          }
      }
  }
}

type OpenBmcTachThresholdSource
  = OpenBmcWarningLowThreshold
  | OpenBmcCriticalLowThreshold

type OpenBmcTachHealth
  = OpenBmcTachThresholdUnstated { sensor: NonEmptyStr, reason: String }
  | OpenBmcTachBelowThreshold {
      sensor: NonEmptyStr,
      reading_rpm: RevolutionsPerMinute,
      minimum_rpm: RevolutionsPerMinute,
      source: OpenBmcTachThresholdSource,
    }
  | OpenBmcTachAtOrAboveThreshold {
      sensor: NonEmptyStr,
      reading_rpm: RevolutionsPerMinute,
      minimum_rpm: RevolutionsPerMinute,
      source: OpenBmcTachThresholdSource,
    }

fn openbmc_tach_health_sensor(
  health: OpenBmcTachHealth,
) -> NonEmptyStr {
  match health {
    OpenBmcTachThresholdUnstated { sensor, reason: _ } => sensor
    OpenBmcTachBelowThreshold { sensor, reading_rpm: _, minimum_rpm: _, source: _ } => sensor
    OpenBmcTachAtOrAboveThreshold { sensor, reading_rpm: _, minimum_rpm: _, source: _ } => sensor
  }
}

type OpenBmcTachHealthResult
  = OpenBmcTachHealthObserved { health: OpenBmcTachHealth }
  | OpenBmcTachHealthRefused { reason: String }

type OpenBmcDigestResult
  = OpenBmcDigestObserved { digest: Digest }
  | OpenBmcDigestRefused { reason: String }

fn openbmc_object_mapper_services_rec(
  content: String,
  index: Int,
  count: Int,
  built: List<NonEmptyStr>,
) -> OpenBmcSensorServicesResult {
  if index >= count {
    OpenBmcSensorServicesObserved {
      services: openbmc_collection_from_values(values: built),
    }
  } else {
    match openbmc_object_mapper_service_at(content: content, index: index) {
      OpenBmcServiceObserved { service: service } =>
        openbmc_object_mapper_services_rec(
          content: content,
          index: index + 1,
          count: count,
          built: append(built, items: [service]),
        )
      OpenBmcServiceProjectionRefused { reason: reason } =>
        OpenBmcSensorServicesRefused {
          reason: join(["ObjectMapper service projection failed: ", reason], ""),
        }
    }
  }
}

fn openbmc_sensor_service(
  session: PasswordSshSession,
  sensor_path: NonEmptyStr,
) -> OpenBmcSensorServicesResult {
  let remote = openbmc_execute(
    session: session,
    operation: OpenBmcSensorServices { sensor_path: sensor_path },
  )
  if !remote.success {
    OpenBmcSensorServicesRefused { reason: remote.stderr }
  } else {
    match openbmc_object_mapper_service_count(content: remote.stdout) {
      OpenBmcServiceCountRefused { reason: reason } =>
        OpenBmcSensorServicesRefused {
          reason: join(["ObjectMapper service count failed: ", reason], ""),
        }
      OpenBmcServiceCountObserved { count: count } =>
        openbmc_object_mapper_services_rec(
          content: remote.stdout,
          index: 0,
          count: count,
          built: [],
        )
    }
  }
}

fn openbmc_sensor_value(
  session: PasswordSshSession,
  service: NonEmptyStr,
  sensor_path: NonEmptyStr,
) -> OpenBmcSensorValueResult {
  let remote = openbmc_execute(
    session: session,
    operation: OpenBmcSensorValue {
      service: service,
      sensor_path: sensor_path,
    },
  )
  if !remote.success {
    OpenBmcSensorValueRefused { reason: remote.stderr }
  } else {
    openbmc_sensor_integer_projection(content: remote.stdout)
  }
}

fn openbmc_sensor_threshold_value(
  session: PasswordSshSession,
  service: NonEmptyStr,
  sensor_path: NonEmptyStr,
  threshold: OpenBmcThresholdProperty,
) -> OpenBmcSensorValueResult {
  let remote = openbmc_execute(
    session: session,
    operation: OpenBmcSensorThreshold {
      service: service,
      sensor_path: sensor_path,
      threshold: threshold,
    },
  )
  openbmc_sensor_threshold_result(remote: remote)
}

fn openbmc_sensor_threshold_result(
  remote: PasswordSshExecResult,
) -> OpenBmcSensorValueResult {
  if !remote.success {
    OpenBmcSensorValueRefused { reason: remote.stderr }
  } else {
    openbmc_sensor_integer_projection(content: remote.stdout)
  }
}

fn openbmc_tach_health_from_floor(
  sensor: NonEmptyStr,
  reading: RevolutionsPerMinute,
  minimum: RevolutionsPerMinute,
  source: OpenBmcTachThresholdSource,
) -> OpenBmcTachHealthResult {
  OpenBmcTachHealthObserved {
    health: if rpm_count(reading) < rpm_count(minimum) {
      OpenBmcTachBelowThreshold {
        sensor: sensor,
        reading_rpm: reading,
        minimum_rpm: minimum,
        source: source,
      }
    } else {
      OpenBmcTachAtOrAboveThreshold {
        sensor: sensor,
        reading_rpm: reading,
        minimum_rpm: minimum,
        source: source,
      }
    },
  }
}

fn openbmc_tach_health_for_binding(
  session: PasswordSshSession,
  sensor: NonEmptyStr,
  sensor_path: NonEmptyStr,
  service: NonEmptyStr,
) -> OpenBmcTachHealthResult {
  match openbmc_sensor_value(
    session: session,
    service: service,
    sensor_path: sensor_path,
  ) {
    OpenBmcSensorValueAbsent =>
      OpenBmcTachHealthObserved {
        health: OpenBmcTachThresholdUnstated {
          sensor: sensor,
          reason: "tach reading is absent",
        },
      }
    OpenBmcSensorValueRefused { reason } => OpenBmcTachHealthRefused { reason: reason }
    OpenBmcSensorValueObserved { value: reading } =>
      if reading < 0 {
        OpenBmcTachHealthRefused { reason: "tach reading is negative" }
      } else {
      match openbmc_sensor_threshold_value(
        session: session,
        service: service,
        sensor_path: sensor_path,
        threshold: OpenBmcWarningLow,
      ) {
        OpenBmcSensorValueObserved { value: minimum } =>
          if minimum < 0 {
            OpenBmcTachHealthRefused { reason: "tach warning threshold is negative" }
          } else {
            openbmc_tach_health_from_floor(
              sensor: sensor,
              reading: rpm(reading),
              minimum: rpm(minimum),
              source: OpenBmcWarningLowThreshold,
            )
          }
        OpenBmcSensorValueRefused { reason } => OpenBmcTachHealthRefused { reason: reason }
        OpenBmcSensorValueAbsent =>
          match openbmc_sensor_threshold_value(
            session: session,
            service: service,
            sensor_path: sensor_path,
            threshold: OpenBmcCriticalLow,
          ) {
            OpenBmcSensorValueObserved { value: minimum } =>
              if minimum < 0 {
                OpenBmcTachHealthRefused { reason: "tach critical threshold is negative" }
              } else {
                openbmc_tach_health_from_floor(
                  sensor: sensor,
                  reading: rpm(reading),
                  minimum: rpm(minimum),
                  source: OpenBmcCriticalLowThreshold,
                )
              }
            OpenBmcSensorValueRefused { reason } => OpenBmcTachHealthRefused { reason: reason }
            OpenBmcSensorValueAbsent =>
              OpenBmcTachHealthObserved {
                health: OpenBmcTachThresholdUnstated {
                  sensor: sensor,
                  reason: "OpenBMC publishes neither WarningLow nor CriticalLow",
                },
              }
          }
      }
      }
  }
}

fn openbmc_tach_health(
  session: PasswordSshSession,
  sensor: NonEmptyStr,
) -> OpenBmcTachHealthResult {
  let sensor_path = join(
    ["/xyz/openbmc_project/sensors/fan_tach/", sensor as String],
    "",
  ) as NonEmptyStr
  match openbmc_sensor_service(session: session, sensor_path: sensor_path) {
    OpenBmcSensorServicesRefused { reason } => OpenBmcTachHealthRefused { reason: reason }
    OpenBmcSensorServicesObserved { services } =>
      match services {
        OpenBmcCollectionZero =>
          OpenBmcTachHealthObserved {
            health: OpenBmcTachThresholdUnstated {
              sensor: sensor,
              reason: "ObjectMapper has no service for the tach",
            },
          }
        OpenBmcCollectionMany { values: _ } =>
          OpenBmcTachHealthObserved {
            health: OpenBmcTachThresholdUnstated {
              sensor: sensor,
              reason: "ObjectMapper service binding is ambiguous",
            },
          }
        OpenBmcCollectionOne { value: selected_service } =>
          openbmc_tach_health_for_binding(
            session: session,
            sensor: sensor,
            sensor_path: sensor_path,
            service: selected_service,
          )
      }
  }
}

fn openbmc_file_sha256(
  session: PasswordSshSession,
  path: NonEmptyStr,
) -> OpenBmcDigestResult {
  let result = openbmc_execute(
    session: session,
    operation: OpenBmcFileSha256 { path: path },
  )
  if !result.success {
    OpenBmcDigestRefused { reason: result.stderr }
  } else {
    let words = split(s: trim(result.stdout), delimiter: " ")
      |> filter(word => word != "")
    match words.first() {
      Absent =>
        OpenBmcDigestRefused { reason: "OpenBMC SHA-256 response is empty" }
      Present { value: hex } =>
        if hex.length() != 64 {
          OpenBmcDigestRefused { reason: "OpenBMC SHA-256 response is not 64 hexadecimal digits" }
        } else {
          OpenBmcDigestObserved { digest: sha256_digest(hex: hex) }
        }
    }
  }
}

type OpenBmcIntegerResult
  = OpenBmcIntegerObserved { value: Int }
  | OpenBmcIntegerRefused { reason: String }

type OpenBmcStringResult
  = OpenBmcStringObserved { value: NonEmptyStr }
  | OpenBmcStringRefused { reason: String }

type OpenBmcIntegerListResult
  = OpenBmcIntegerListObserved { values: List<Int> }
  | OpenBmcIntegerListRefused { reason: String }

type OpenBmcFanControllerListResult
  = OpenBmcFanControllerListObserved { values: List<OpenBmcFanController> }
  | OpenBmcFanControllerListRefused { reason: String }

type OpenBmcFanSeries = OpenBmcReadings | OpenBmcOutputs

// ---------------------------------------------------------------------------------------------
// WAVE 2: THE REMOTE REALIZATION. The local vertical (Waves 1A/1B) executes a JqAdmittedProcessPlan
// with jq.Process; the remote population runs jq on the BMC over the password-SSH transport, and
// that is a SECOND language target (docs/plans/cli-invocation-emission-design.md §7, Wave 2). The
// inner argv must travel as ONE RFC 4254 command string, quoted by the grammar-owned emitter
// (gunbc.remote_shell_command remote_exec_command_string) -- never as append(ssh_prefix, inner.argv).
//
// FILE-INPUT-ONLY ADMISSION. Remote jq reads the config file itself on the BMC filesystem
// (JqInputFile lowers to a file operand), so the remote realization accepts JqProcessNoStdin only.
// A stdin-fed remote jq is a TYPED refusal, not an accidental limitation: sshpass -d 0 occupies
// fd 0 with the password, so a remote stdin payload would collide with it (design §10, question 2).
//
// THE DECOMPOSITION IS PURE WHERE IT CAN BE. openbmc_remote_jq_command refuses stdin and emits the
// RFC 4254 command string without touching the transport -- witnessable hermetically.
// openbmc_remote_jq_execute runs the transport (no mock_response, so the hermetic floor refuses
// it), which is why the witnesses below assert the pure halves and the refusal arm, and never
// claim the transport executed.
//
// THE PRODUCTION CUTOVER IS GATED ON THE REMOTE-SHELL INTERPRETATION, AND NO LIVE TARGET HAS
// CONFIRMED ONE (review 38602, REQUEST_CHANGES). Whether the far side hands the RFC 4254 command
// string to a POSIX shell is an OBSERVED deployment fact (gunbc.remote_shell_command
// remote_exec_command_interpretation_note). openbmc_dropbear_interpretation is the repo's
// documented best understanding of OpenBMC, but it is UNVERIFIED until remote_exec_command_live_confirmation
// runs against a live target -- and that receipt is declared Unexecuted. DESIGN 4b: external
// reality is observed, refused, or mitigated at a declared boundary, never fabricated. DESIGN 5:
// a failure arm must refuse, never widen -- and never emit a plausible guess. So the production
// path passes Unknown and REFUSES until the live confirmation lands and supplies the observed
// interpretation; the pure emitter remains witnessable by passing an interpretation explicitly.
type OpenBmcRemoteJqRefusal
  = OpenBmcRemoteJqStdinUnwired
  | OpenBmcRemoteJqCommandStringRefused { cause: RemoteExecCommandRefusalCause }

type OpenBmcRemoteJqCommandOutcome
  = OpenBmcRemoteJqCommandBuilt { command: RemoteExecCommand }
  | OpenBmcRemoteJqCommandRefused { cause: OpenBmcRemoteJqRefusal }

// The remote words are the jq executable plus the already-emitted surface words -- the semantic
// layer chose every flag, and this function adds only the executable identity (from jq's own
// `jq_executable` row, never a literal), exactly as the local realization's handler does.
fn openbmc_remote_jq_words(surface: CliSurface) -> List<NonEmptyStr> {
  append(
    [jq_executable],
    items: cli_surface_arguments(surface: surface) |> map(arg => cli_argument_text(argument: arg) as NonEmptyStr),
  )
}

fn openbmc_remote_jq_command(
  plan: JqAdmittedProcessPlan,
  interpretation: RemoteExecCommandInterpretation,
) -> OpenBmcRemoteJqCommandOutcome {
  match plan.process_input {
    JqProcessStdin { content: _ } =>
      OpenBmcRemoteJqCommandRefused { cause: OpenBmcRemoteJqStdinUnwired }
    JqProcessNoStdin =>
      match remote_exec_command_string(
        argv: openbmc_remote_jq_words(surface: jq_admitted_plan_surface(plan: plan)),
        interpretation: interpretation,
      ) {
        RemoteExecCommandRefused { cause: cause } =>
          OpenBmcRemoteJqCommandRefused { cause: OpenBmcRemoteJqCommandStringRefused { cause: cause } }
        RemoteExecCommandBuilt { command: command } =>
          OpenBmcRemoteJqCommandBuilt { command: command }
      }
  }
}

type OpenBmcRemoteJqOutcome
  = OpenBmcRemoteJqExecuted { observation: ProcessObservation }
  | OpenBmcRemoteJqRefused { cause: OpenBmcRemoteJqRefusal }

// The production remote-jq execution is DRIVEN by the live confirmation receipt.
// remote_exec_command_live_confirmation is a module-scope data row whose variant determines
// the interpretation:
//
//   - RemoteExecCommandLiveConfirmationObserved: the live check WAS RUN and confirmed a
//     POSIX-shell interpretation. The path uses openbmc_dropbear_interpretation (the repo's
//     documented best understanding, now corroborated by observation).
//
//   - RemoteExecCommandLiveConfirmationUnexecuted: the live check has NOT been run. The path
//     passes Unknown and REFUSES with RemoteExecInterpretationUnknown (DESIGN 4b: external
//     reality is observed, refused, or mitigated at a declared boundary, never fabricated).
//
// The receipt is LOAD-BEARING: observing and recording it genuinely unlocks execution, so the
// design 4b(2) trigger is genuine (not a permanent stall wearing a trigger's clothes). When an
// operator runs remote_exec_command_live_confirmation against a live target and records the
// observation, this match resolves to the Observed arm and the path opens.

// PURE DERIVATION: extract an interpretation from the confirmation receipt. Exists as a named
// function so that witnesses can test BOTH arms with a fixture — the Observed arm returns
// openbmc_dropbear_interpretation (the citation, not a bare constant), the Unexecuted arm
// returns Unknown. No BMC is needed: a witness constructs the confirmation value as a fixture
// and asserts the derived interpretation without ever touching the transport.
fn openbmc_remote_jq_interpretation(confirmation: RemoteExecCommandLiveConfirmation) -> RemoteExecCommandInterpretation {
  match confirmation {
    RemoteExecCommandLiveConfirmationObserved { target: _, interpretation: interp } =>
      interp
    RemoteExecCommandLiveConfirmationUnexecuted { trigger: _ } =>
      Unknown
  }
}

fn openbmc_remote_jq_execute(
  session: PasswordSshSession,
  plan: JqAdmittedProcessPlan,
) -> OpenBmcRemoteJqOutcome {
  let interpretation = openbmc_remote_jq_interpretation(confirmation: remote_exec_command_live_confirmation)
  match openbmc_remote_jq_command(plan: plan, interpretation: interpretation) {
    OpenBmcRemoteJqCommandRefused { cause: cause } =>
      OpenBmcRemoteJqRefused { cause: cause }
    OpenBmcRemoteJqCommandBuilt { command: sealed } => {
      let command = remote_exec_command_rendered(command: sealed)
      let ran = openbmc.PasswordSshTransport.RunCommand(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        command: command,
      )
      OpenBmcRemoteJqExecuted {
        observation: process_observation(exit_code: ran.exit_code, stdout: ran.stdout, stderr: ran.stderr),
      }
    }
  }
}

fn openbmc_remote_jq_refusal_text(cause: OpenBmcRemoteJqRefusal) -> String {
  match cause {
    OpenBmcRemoteJqStdinUnwired =>
      "remote jq over the password-SSH transport cannot carry stdin: sshpass -d 0 occupies fd 0 with the password"
    OpenBmcRemoteJqCommandStringRefused { cause: cause } =>
      match cause {
        RemoteExecInterpretationUnknown =>
          "remote jq cutover is gated on the remote-shell interpretation: the RFC 4254 command string must be single-quote encoded for a POSIX shell, but no live target has confirmed one -- run remote_exec_command_live_confirmation against a live OpenBMC/Dropbear target and supply the observed interpretation (DESIGN 4b/5: refuse rather than fabricate)"
        SimpleCommandArgvRefused { cause: _ } =>
          "remote jq command string could not be emitted by the grammar-owned shell encoder"
      }
  }
}

// THE FIRST SSH MIGRATION: OpenBmcStepwiseCount. The old FanStepwiseCount operation (raw argv
// ["jq","-er","<program>","{config_path}"] behind the sshpass/ssh prefix) is DELETED at the root;
// the caller now describes a semantic JqInvocation -- file input, raw output, last-result exit --
// and the remote realization derives the flags and the RFC 4254 command string. The decode reads
// JqOutcome, never success/stdout/stderr.
data openbmc_fan_stepwise_count_program: String = "[.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")] | length"

// LOSSY REFUSAL CARRIER — §4b(3) RUNG DROP: OpenBmcIntegerResult carries a rendered String
// (reason), not a typed cause. openbmc_remote_jq_refusal_text converts the typed
// OpenBmcRemoteJqRefusal to prose at this boundary, so every consumer downstream of this
// function is cause-blind for refusals — they can test the prose or nothing.
//
//   Previous rung (4b-2):  mechanically preventable — the typed cause was preserved through
//                           the execute layer (OpenBmcRemoteJqRefused), reachable to any
//                           function that calls openbmc_remote_jq_execute before this one.
//   This rung (4b-3):       structurally guaranteed — the typed cause survives up to this
//                           boundary and is replaceable at the caller by inserting between.
//   Reason:                  the consumer (openbmc_fan_config_observe, the only caller) calls
//                           openbmc_fan_config_stepwise_count then decodes the Int from
//                           OpenBmcIntegerObserved, and the only tool reading the refusal
//                           is the operator-console error display which needs prose.
//   Bounded population:      count=1 (openbmc_fan_config_observe, same module).
//   Restoration trigger:     OpenBmcIntegerResult carries a typed OpenBmcRemoteJqRefusal cause
//                           instead of String reason; the renderer moves to the presentation
//                           edge. The typed-variant test at remote_jq_execute_gates_on_unknown_
//                           interpretation must remain the canonical assertion until then.
fn openbmc_fan_config_stepwise_count(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
) -> OpenBmcIntegerResult {
  match jq_invocation_process_plan(invocation: JqInvocation {
    program: JqProgram { source: openbmc_fan_stepwise_count_program },
    bindings: Empty,
    input: JqInputFile { path: config_path },
    output_encoding: JqRawOutput,
    exit_policy: JqLastResultExit,
  }) {
    Rejected { diagnostics: _ } =>
      OpenBmcIntegerRefused { reason: "OpenBMC fan stepwise count could not be lowered to a jq invocation" }
    Accepted { value: plan, diagnostics: _ } =>
      match openbmc_remote_jq_execute(session: session, plan: plan) {
        OpenBmcRemoteJqRefused { cause: cause } =>
          OpenBmcIntegerRefused { reason: openbmc_remote_jq_refusal_text(cause: cause) }
        OpenBmcRemoteJqExecuted { observation: observation } =>
          openbmc_fan_config_stepwise_count_result(
            outcome: jq_classify_observation(plan: plan, observation: observation),
          )
      }
  }
}

fn openbmc_fan_config_stepwise_count_result(outcome: JqOutcome) -> OpenBmcIntegerResult {
  match outcome {
    JqExecutionRefused { exit_code: _, stderr: stderr } =>
      OpenBmcIntegerRefused { reason: stderr }
    JqOutputAbsent =>
      OpenBmcIntegerRefused { reason: "OpenBMC fan stepwise count is absent" }
    JqOutputPresent { text: text } =>
      match parse_int(s: trim(text)) {
        Absent =>
          OpenBmcIntegerRefused { reason: "OpenBMC fan stepwise count is not an integer" }
        Present { value: count } =>
          OpenBmcIntegerObserved { value: count }
      }
  }
}

fn openbmc_fan_config_raw(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  query: OpenBmcFanConfigQuery,
) -> PasswordSshExecResult {
  openbmc_execute(
    session: session,
    operation: OpenBmcFanConfigScalar {
      config_path: config_path,
      query: query,
    },
  )
}

fn openbmc_fan_config_integer(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  query: OpenBmcFanConfigQuery,
) -> OpenBmcIntegerResult {
  let result = openbmc_fan_config_raw(
    session: session,
    config_path: config_path,
    query: query,
  )
  if !result.success {
    OpenBmcIntegerRefused { reason: result.stderr }
  } else {
    match parse_int(s: trim(result.stdout)) {
      Absent => OpenBmcIntegerRefused { reason: "OpenBMC integer response is invalid" }
      Present { value } => OpenBmcIntegerObserved { value: value }
    }
  }
}

fn openbmc_fan_config_string(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  query: OpenBmcFanConfigQuery,
) -> OpenBmcStringResult {
  let result = openbmc_fan_config_raw(
    session: session,
    config_path: config_path,
    query: query,
  )
  if !result.success || trim(result.stdout) == "" {
    OpenBmcStringRefused { reason: result.stderr }
  } else {
    OpenBmcStringObserved { value: trim(result.stdout) as NonEmptyStr }
  }
}

fn openbmc_fan_series_query(series: OpenBmcFanSeries, index: Int) -> OpenBmcFanConfigQuery {
  match series {
    OpenBmcReadings => OpenBmcReadingAt { index: index }
    OpenBmcOutputs => OpenBmcOutputAt { index: index }
  }
}

fn openbmc_fan_config_integer_list_rec(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  series: OpenBmcFanSeries,
  index: Int,
  count: Int,
  built: List<Int>,
) -> OpenBmcIntegerListResult {
  if index >= count {
    OpenBmcIntegerListObserved { values: built }
  } else {
    match openbmc_fan_config_integer(
      session: session,
      config_path: config_path,
      query: openbmc_fan_series_query(series: series, index: index),
    ) {
      OpenBmcIntegerRefused { reason } => OpenBmcIntegerListRefused { reason: reason }
      OpenBmcIntegerObserved { value } =>
        openbmc_fan_config_integer_list_rec(
          session: session,
          config_path: config_path,
          series: series,
          index: index + 1,
          count: count,
          built: append(built, items: [value]),
        )
    }
  }
}

fn openbmc_fan_config_integer_list(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  series: OpenBmcFanSeries,
) -> OpenBmcIntegerListResult {
  let count_query = match series {
    OpenBmcReadings => OpenBmcReadingCount
    OpenBmcOutputs => OpenBmcOutputCount
  }
  match openbmc_fan_config_integer(
    session: session,
    config_path: config_path,
    query: count_query,
  ) {
    OpenBmcIntegerRefused { reason } => OpenBmcIntegerListRefused { reason: reason }
    OpenBmcIntegerObserved { value: count } =>
      if count < 0 {
        OpenBmcIntegerListRefused { reason: "OpenBMC series count is negative" }
      } else {
        openbmc_fan_config_integer_list_rec(
          session: session,
          config_path: config_path,
          series: series,
          index: 0,
          count: count,
          built: [],
        )
      }
  }
}

fn openbmc_fan_input_list_rec(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  fan_index: Int,
  input_index: Int,
  count: Int,
  built: List<NonEmptyStr>,
) -> OpenBmcFanControllerListResult {
  if input_index >= count {
    match openbmc_fan_config_string(
      session: session,
      config_path: config_path,
      query: OpenBmcFanControllerNameAt { index: fan_index },
    ) {
      OpenBmcStringRefused { reason } => OpenBmcFanControllerListRefused { reason: reason }
      OpenBmcStringObserved { value: name } =>
        OpenBmcFanControllerListObserved {
          values: [OpenBmcFanController { name: name, inputs: built }],
        }
    }
  } else {
    match openbmc_fan_config_string(
      session: session,
      config_path: config_path,
      query: OpenBmcFanInputAt {
        fan_index: fan_index,
        input_index: input_index,
      },
    ) {
      OpenBmcStringRefused { reason } => OpenBmcFanControllerListRefused { reason: reason }
      OpenBmcStringObserved { value } =>
        openbmc_fan_input_list_rec(
          session: session,
          config_path: config_path,
          fan_index: fan_index,
          input_index: input_index + 1,
          count: count,
          built: append(built, items: [value]),
        )
    }
  }
}

fn openbmc_fan_controller_at(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  fan_index: Int,
) -> OpenBmcFanControllerListResult {
  match openbmc_fan_config_integer(
    session: session,
    config_path: config_path,
    query: OpenBmcFanInputCountAt { fan_index: fan_index },
  ) {
    OpenBmcIntegerRefused { reason } => OpenBmcFanControllerListRefused { reason: reason }
    OpenBmcIntegerObserved { value: count } =>
      if count < 0 {
        OpenBmcFanControllerListRefused { reason: "OpenBMC fan input count is negative" }
      } else {
        openbmc_fan_input_list_rec(
          session: session,
          config_path: config_path,
          fan_index: fan_index,
          input_index: 0,
          count: count,
          built: [],
        )
      }
  }
}

fn openbmc_fan_controllers_rec(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  index: Int,
  count: Int,
  built: List<OpenBmcFanController>,
) -> OpenBmcFanControllerListResult {
  if index >= count {
    OpenBmcFanControllerListObserved { values: built }
  } else {
    match openbmc_fan_controller_at(
      session: session,
      config_path: config_path,
      fan_index: index,
    ) {
      OpenBmcFanControllerListRefused { reason } =>
        OpenBmcFanControllerListRefused { reason: reason }
      OpenBmcFanControllerListObserved { values } =>
        openbmc_fan_controllers_rec(
          session: session,
          config_path: config_path,
          index: index + 1,
          count: count,
          built: append(built, items: values),
        )
    }
  }
}

fn openbmc_fan_controllers(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
) -> OpenBmcFanControllerListResult {
  match openbmc_fan_config_integer(
    session: session,
    config_path: config_path,
    query: OpenBmcFanControllerCount,
  ) {
    OpenBmcIntegerRefused { reason } => OpenBmcFanControllerListRefused { reason: reason }
    OpenBmcIntegerObserved { value: count } =>
      if count < 0 {
        OpenBmcFanControllerListRefused { reason: "OpenBMC fan controller count is negative" }
      } else {
        openbmc_fan_controllers_rec(
          session: session,
          config_path: config_path,
          index: 0,
          count: count,
          built: [],
        )
      }
  }
}

fn openbmc_fan_controller_collection(
  values: List<OpenBmcFanController>,
) -> OpenBmcCollection<OpenBmcFanController> {
  if values.length() == 0 {
    OpenBmcCollectionZero
  } else if values.length() == 1 {
    OpenBmcCollectionOne { value: values.first() }
  } else {
    OpenBmcCollectionMany { values: values }
  }
}

fn openbmc_fan_config_queries_rec(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  queries: List<OpenBmcFanConfigQuery>,
  built: List<Int>,
) -> OpenBmcIntegerListResult {
  if queries.length() == 0 {
    OpenBmcIntegerListObserved { values: built }
  } else {
    match openbmc_fan_config_integer(
      session: session,
      config_path: config_path,
      query: queries.first(),
    ) {
      OpenBmcIntegerRefused { reason } => OpenBmcIntegerListRefused { reason: reason }
      OpenBmcIntegerObserved { value } =>
        openbmc_fan_config_queries_rec(
          session: session,
          config_path: config_path,
          queries: queries.skip(n: 1),
          built: append(built, items: [value]),
        )
    }
  }
}

fn openbmc_fan_config_finish_observation(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  stepwise: OpenBmcSelection<OpenBmcStepwiseController>,
) -> OpenBmcFanConfigObservationResult {
  match openbmc_fan_controllers(session: session, config_path: config_path) {
    OpenBmcFanControllerListRefused { reason } =>
      OpenBmcFanConfigObservationRefused { reason: reason }
    OpenBmcFanControllerListObserved { values } =>
      OpenBmcFanConfigObserved {
        observation: OpenBmcFanConfigObservation {
          stepwise: stepwise,
          fan_controllers: openbmc_fan_controller_collection(values: values),
        },
      }
  }
}

fn openbmc_fan_config_observe_one(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
) -> OpenBmcFanConfigObservationResult {
  let scalar_queries = [
    OpenBmcMinimumDuty,
    OpenBmcZoneFailsafeDuty,
    OpenBmcSensorFailsafeDuty,
    OpenBmcPositiveHysteresis,
    OpenBmcNegativeHysteresis,
  ]
  match openbmc_fan_config_queries_rec(
    session: session,
    config_path: config_path,
    queries: scalar_queries,
    built: [],
  ) {
    OpenBmcIntegerListRefused { reason } =>
      OpenBmcFanConfigObservationRefused { reason: reason }
    OpenBmcIntegerListObserved { values: scalars } =>
      match openbmc_fan_config_integer_list(
        session: session,
        config_path: config_path,
        series: OpenBmcReadings,
      ) {
        OpenBmcIntegerListRefused { reason } =>
          OpenBmcFanConfigObservationRefused { reason: reason }
        OpenBmcIntegerListObserved { values: readings } =>
          match openbmc_fan_config_integer_list(
            session: session,
            config_path: config_path,
            series: OpenBmcOutputs,
          ) {
            OpenBmcIntegerListRefused { reason } =>
              OpenBmcFanConfigObservationRefused { reason: reason }
            OpenBmcIntegerListObserved { values: outputs } =>
              if scalars.length() != 5 || readings.length() != outputs.length()
                || scalars |> any(value => value < 0)
                || outputs |> any(value => value < 0) {
                OpenBmcFanConfigObservationRefused {
                  reason: "OpenBMC fan config response has invalid structured cardinality or negative duty",
                }
              } else {
                openbmc_fan_config_finish_observation(
                  session: session,
                  config_path: config_path,
                  stepwise: OpenBmcSelectionOne {
                    value: OpenBmcStepwiseController {
                      minimum_duty: percent(scalars.first()),
                      zone_failsafe_duty: percent(scalars.skip(n: 1).first()),
                      sensor_failsafe_duty: percent(scalars.skip(n: 2).first()),
                      positive_hysteresis: celsius_delta(scalars.skip(n: 3).first()),
                      negative_hysteresis: celsius_delta(scalars.skip(n: 4).first()),
                      readings: readings |> map(value => celsius(value)),
                      outputs: outputs |> map(value => percent(value)),
                    },
                  },
                )
              }
          }
      }
  }
}

fn openbmc_fan_config_observe(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
) -> OpenBmcFanConfigObservationResult {
  match openbmc_fan_config_stepwise_count(
    session: session,
    config_path: config_path,
  ) {
    OpenBmcIntegerRefused { reason } =>
      OpenBmcFanConfigObservationRefused { reason: reason }
    OpenBmcIntegerObserved { value: count } =>
      if count < 0 {
        OpenBmcFanConfigObservationRefused {
          reason: "OpenBMC stepwise controller count is negative",
        }
      } else if count == 0 {
        openbmc_fan_config_finish_observation(
          session: session,
          config_path: config_path,
          stepwise: OpenBmcSelectionZero,
        )
      } else if count == 1 {
        openbmc_fan_config_observe_one(session: session, config_path: config_path)
      } else {
        openbmc_fan_config_finish_observation(
          session: session,
          config_path: config_path,
          stepwise: OpenBmcSelectionMany { count: count },
        )
      }
  }
}

fn openbmc_fan_config_validate(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
) -> PasswordSshExecResult {
  openbmc_execute(
    session: session,
    operation: OpenBmcFanConfigValidate { config_path: config_path },
  )
}

fn openbmc_fan_config_verify(
  session: PasswordSshSession,
  config_path: NonEmptyStr,
  desired: OpenBmcFanConfigDesired,
) -> PasswordSshExecResult {
  openbmc_execute(
    session: session,
    operation: OpenBmcFanConfigVerify {
      config_path: config_path,
      desired: desired,
    },
  )
}

fn openbmc_fan_config_project_local(
  input_path: NonEmptyStr,
  desired: OpenBmcFanConfigDesired,
) -> OpenBmcLocalTransformResult {
  let result = openbmc.JsonProjection.ProjectFanConfig(
    desired_json: openbmc_fan_config_desired_json(desired: desired),
    path: input_path,
  )
  OpenBmcLocalTransformResult {
    exit_code: result.exit_code,
    success: result.success,
    content: result.value,
    stderr: result.stderr,
  }
}

