data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.freedesktop.org/software/systemd/man/latest/busctl.html",
  },
}

// SCAFFOLD (mandatory-tag corpus cadence) - the host scanner reads the correct
// openbmc_busctl_authority alias as absent, so the literal anchor duplicates its projection;
// openbmc_busctl_authority remains the semantic authority. This copy dissolves with the host seam
// under the corpus_scan_scaffold_note in v2.lens.mandatory_tag.corpus_scan when native witness
// realization runs the parse-grain corpus witness.

// The systemctl(1) is-active contract names the unit-state tokens and assigns a nonzero exit status
// when no named unit is active. This decoder admits only the exact inactive token as the typed
// false observation; other non-active states remain typed refusals rather than being collapsed into
// inactive.

data openbmc_systemctl_is_active_authority: ExternalAuthority = systemctl_authority

data openbmc_json_projection_authority: ExternalAuthority = jq_authority

type OpenBmcLocalTransformResult {
  exit_code: Int
  success: Bool
  content: String
  stderr: String
}

type OpenBmcSelection<T>
  = OpenBmcSelectionZero
  | OpenBmcSelectionOne { value: T }
  | OpenBmcSelectionMany { count: Int }

type OpenBmcCollection<T>
  = OpenBmcCollectionZero
  | OpenBmcCollectionOne { value: T }
  | OpenBmcCollectionMany { values: List<T> }

fn openbmc_collection_from_values<T>(
  values: List<T>,
) -> OpenBmcCollection<T> {
  if values.length() == 0 {
    OpenBmcCollectionZero
  } else if values.length() == 1 {
    OpenBmcCollectionOne { value: values.first() }
  } else {
    OpenBmcCollectionMany { values: values }
  }
}

type OpenBmcStepwiseController {
  minimum_duty: Percent
  zone_failsafe_duty: Percent
  sensor_failsafe_duty: Percent
  positive_hysteresis: CelsiusDelta
  negative_hysteresis: CelsiusDelta
  readings: List<Celsius>
  outputs: List<Percent>
}

fn openbmc_fan_config_desired_json(desired: OpenBmcFanConfigDesired) -> String {
  serialize_json(v: json_object(members: [
    json_kv(key: "minimum", value: json_int(n: percent_count(desired.minimum_duty))),
    json_kv(key: "zone_failsafe_duty", value: json_int(n: percent_count(desired.zone_failsafe_duty))),
    json_kv(key: "sensor_failsafe", value: json_int(n: percent_count(desired.sensor_failsafe_duty))),
    json_kv(key: "positive_hysteresis", value: json_int(n: celsius_delta_count(desired.positive_hysteresis))),
    json_kv(key: "negative_hysteresis", value: json_int(n: celsius_delta_count(desired.negative_hysteresis))),
    json_kv(
      key: "readings",
      value: json_array(elements: desired.readings |> map(value => json_int(n: celsius_count(value)))),
    ),
    json_kv(
      key: "outputs",
      value: json_array(elements: desired.outputs |> map(value => json_int(n: percent_count(value)))),
    ),
    json_kv(
      key: "fan_pid_entry",
      value: json_string(s: desired.fan_controller_name as String),
    ),
    json_kv(
      key: "fan_inputs",
      value: json_array(elements: desired.fan_inputs |> map(value =>
        json_string(s: value as String)
      )),
    ),
  ]))
}

type OpenBmcFanController {
  name: NonEmptyStr
  inputs: List<NonEmptyStr>
}

type OpenBmcFanConfigObservation {
  stepwise: OpenBmcSelection<OpenBmcStepwiseController>
  fan_controllers: OpenBmcCollection<OpenBmcFanController>
}

type OpenBmcFanConfigObservationResult
  = OpenBmcFanConfigObserved { observation: OpenBmcFanConfigObservation }
  | OpenBmcFanConfigObservationRefused { reason: String }

type OpenBmcPathResult
  = OpenBmcPathObserved { path: NonEmptyStr }
  | OpenBmcPathRefused { reason: String }

type OpenBmcBoolResult
  = OpenBmcBoolObserved { value: Bool }
  | OpenBmcBoolRefused { reason: String }

type OpenBmcByteSizeResult
  = OpenBmcByteSizeObserved { value: ByteSize }
  | OpenBmcByteSizeRefused { reason: String }

type OpenBmcInstantResult
  = OpenBmcInstantObserved { observed_at: EpochMs }
  | OpenBmcInstantRefused { reason: String }

fn openbmc_path_result(
  remote: PasswordSshExecResult,
) -> OpenBmcPathResult {
  if remote.exit_code != 0 || !remote.success {
    let reason = if trim(remote.stderr) == "" {
      "path transport did not report exit-zero success"
    } else {
      remote.stderr
    }
    OpenBmcPathRefused { reason: reason }
  } else {
    let paths = split(s: remote.stdout, delimiter: "\n")
      |> map(path => trim(path))
      |> filter(path => path != "")
    if paths.length() == 0 {
      OpenBmcPathRefused { reason: "path response is empty" }
    } else if paths.length() == 1 {
      match paths.first() {
        Present { value: path } => OpenBmcPathObserved { path: path }
        Absent => OpenBmcPathRefused { reason: "path response is empty" }
      }
    } else {
      OpenBmcPathRefused {
        reason: "path response contains more than one non-empty path",
      }
    }
  }
}

fn openbmc_zone_failsafe_result(
  remote: PasswordSshExecResult,
) -> OpenBmcBoolResult {
  if remote.exit_code != 0 || !remote.success {
    let reason = if trim(remote.stderr) == "" {
      "zone failsafe transport did not report exit-zero success"
    } else {
      remote.stderr
    }
    OpenBmcBoolRefused { reason: reason }
  } else {
    let tokens = split(s: trim(remote.stdout), delimiter: " ")
      |> filter(token => trim(token) != "")
    if tokens.length() != 2 || trim(tokens.first()) != "b" {
      OpenBmcBoolRefused {
        reason: "zone failsafe response does not have one typed boolean payload",
      }
    } else {
      let payload = trim(tokens.skip(n: 1).first())
      if payload == "true" {
        OpenBmcBoolObserved { value: true }
      } else if payload == "false" {
        OpenBmcBoolObserved { value: false }
      } else {
        OpenBmcBoolRefused { reason: "zone failsafe payload is not boolean" }
      }
    }
  }
}

fn openbmc_path_probe_result(
  remote: PasswordSshExecResult,
) -> OpenBmcBoolResult {
  if remote.exit_code == 0 && remote.success {
    OpenBmcBoolObserved { value: true }
  } else if remote.exit_code == 1
    && !remote.success
    && trim(remote.stdout) == ""
    && trim(remote.stderr) == "" {
    OpenBmcBoolObserved { value: false }
  } else {
    let reason = if trim(remote.stderr) == "" {
      concat(
        "path predicate response is not the expected positive or negative shape; observed stdout: ",
        trim(remote.stdout),
      )
    } else {
      remote.stderr
    }
    OpenBmcBoolRefused { reason: reason }
  }
}

fn openbmc_service_active_result(
  remote: PasswordSshExecResult,
) -> OpenBmcBoolResult {
  if remote.exit_code == 0
    && remote.success
    && trim(remote.stdout) == "active"
    && trim(remote.stderr) == "" {
    OpenBmcBoolObserved { value: true }
  } else if remote.exit_code == 3
    && !remote.success
    && trim(remote.stdout) == "inactive"
    && trim(remote.stderr) == "" {
    OpenBmcBoolObserved { value: false }
  } else {
    let reason = if trim(remote.stderr) == "" {
      concat(
        "service-active response is not the expected active or inactive shape; observed stdout: ",
        trim(remote.stdout),
      )
    } else {
      remote.stderr
    }
    OpenBmcBoolRefused { reason: reason }
  }
}

fn openbmc_disk_usage_result(
  remote: PasswordSshExecResult,
) -> OpenBmcByteSizeResult {
  if remote.exit_code != 0 || !remote.success {
    let reason = if trim(remote.stderr) == "" {
      "disk usage transport did not report exit-zero success"
    } else {
      remote.stderr
    }
    OpenBmcByteSizeRefused { reason: reason }
  } else {
    let lines = split(s: trim(remote.stdout), delimiter: "\n")
    if lines.length() < 2 {
      OpenBmcByteSizeRefused { reason: "disk usage response has no data row" }
    } else {
      let fields = split(
        s: trim(lines.skip(n: 1).first()),
        delimiter: " ",
      ) |> filter(field => trim(field) != "")
      if fields.length() < 4 {
        OpenBmcByteSizeRefused {
          reason: "disk usage data row has no available-kibibyte field",
        }
      } else {
        match parse_int(s: trim(fields.skip(n: 3).first())) {
          Absent =>
            OpenBmcByteSizeRefused {
              reason: "available-kibibyte field is not an integer",
            }
          Present { value: kibibytes } =>
            if kibibytes < 0 {
              OpenBmcByteSizeRefused {
                reason: "available-kibibyte field is negative",
              }
            } else {
              OpenBmcByteSizeObserved { value: byte_size(kibibytes * 1024) }
            }
        }
      }
    }
  }
}

fn openbmc_epoch_result(
  remote: PasswordSshExecResult,
) -> OpenBmcInstantResult {
  if remote.exit_code != 0 || !remote.success {
    let reason = if trim(remote.stderr) == "" {
      "UTC timestamp transport did not report exit-zero success"
    } else {
      remote.stderr
    }
    OpenBmcInstantRefused { reason: reason }
  } else {
    match parse_int(s: trim(remote.stdout)) {
      Absent =>
        OpenBmcInstantRefused { reason: "UTC epoch-second response is not an integer" }
      Present { value: epoch_seconds } =>
        if epoch_seconds < 0 {
          OpenBmcInstantRefused { reason: "UTC epoch-second response is negative" }
        } else {
          OpenBmcInstantObserved { observed_at: epoch_seconds * 1000 }
        }
    }
  }
}

fn openbmc_execute(
  session: PasswordSshSession,
  operation: OpenBmcOperation,
) -> PasswordSshExecResult {
  let result = match operation {
    OpenBmcReadFile { path } =>
      openbmc.PasswordSshTransport.ReadFile(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcResolvePath { path } =>
      openbmc.PasswordSshTransport.ResolvePath(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcParentDirectory { path } =>
      openbmc.PasswordSshTransport.ParentDirectory(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcSystemdIsActive { service } =>
      openbmc.PasswordSshTransport.SystemdIsActive(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
      )
    OpenBmcSystemdRestart { service } =>
      openbmc.PasswordSshTransport.SystemdRestart(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
      )
    OpenBmcZoneFailsafe { zone_path } =>
      openbmc.PasswordSshTransport.ZoneFailsafe(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        zone_path: zone_path,
      )
    OpenBmcSensorServices { sensor_path } =>
      openbmc.PasswordSshTransport.SensorServices(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        sensor_path: sensor_path,
      )
    OpenBmcSensorValue { service, sensor_path } =>
      openbmc.PasswordSshTransport.SensorValue(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
        sensor_path: sensor_path,
      )
    OpenBmcSensorThreshold { service, sensor_path, threshold } =>
      match threshold {
        OpenBmcWarningLow =>
          openbmc.PasswordSshTransport.SensorWarningLow(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
        sensor_path: sensor_path,
      )
        OpenBmcCriticalLow =>
          openbmc.PasswordSshTransport.SensorCriticalLow(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        service: service,
        sensor_path: sensor_path,
      )
      }
    OpenBmcFanConfigScalar { config_path, query } =>
      match query {
        OpenBmcMinimumDuty =>
          openbmc.PasswordSshTransport.FanMinimumDuty(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcZoneFailsafeDuty =>
          openbmc.PasswordSshTransport.FanZoneFailsafeDuty(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcSensorFailsafeDuty =>
          openbmc.PasswordSshTransport.FanSensorFailsafeDuty(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcPositiveHysteresis =>
          openbmc.PasswordSshTransport.FanPositiveHysteresis(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcNegativeHysteresis =>
          openbmc.PasswordSshTransport.FanNegativeHysteresis(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcReadingCount =>
          openbmc.PasswordSshTransport.FanReadingCount(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcOutputCount =>
          openbmc.PasswordSshTransport.FanOutputCount(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcReadingAt { index } =>
          openbmc.PasswordSshTransport.FanReadingAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        index: index,
      )
        OpenBmcOutputAt { index } =>
          openbmc.PasswordSshTransport.FanOutputAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        index: index,
      )
        OpenBmcFanControllerCount =>
          openbmc.PasswordSshTransport.FanControllerCount(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
        OpenBmcFanControllerNameAt { index } =>
          openbmc.PasswordSshTransport.FanControllerNameAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        index: index,
      )
        OpenBmcFanInputCountAt { fan_index } =>
          openbmc.PasswordSshTransport.FanInputCountAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        fan_index: fan_index,
      )
        OpenBmcFanInputAt { fan_index, input_index } =>
          openbmc.PasswordSshTransport.FanInputAt(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        fan_index: fan_index,
        input_index: input_index,
      )
      }
    OpenBmcFanConfigValidate { config_path } =>
      openbmc.PasswordSshTransport.FanConfigValidate(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
      )
    OpenBmcFanConfigVerify { config_path, desired } =>
      openbmc.PasswordSshTransport.FanConfigVerify(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        config_path: config_path,
        desired_json: openbmc_fan_config_desired_json(desired: desired),
      )
    OpenBmcPathIsWritable { path } =>
      openbmc.PasswordSshTransport.PathIsWritable(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcPathExists { path } =>
      openbmc.PasswordSshTransport.PathExists(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcPathIsNonemptyFile { path } =>
      openbmc.PasswordSshTransport.PathIsNonemptyFile(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcDiskUsageKib { path } =>
      openbmc.PasswordSshTransport.DiskUsageKib(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcFileSha256 { path } =>
      openbmc.PasswordSshTransport.FileSha256(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcUtcTimestamp =>
      openbmc.PasswordSshTransport.UtcTimestamp(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
      )
    OpenBmcMakeDirectory { path, parents } =>
      if parents {
        openbmc.PasswordSshTransport.MakeDirectoryParents(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
      } else {
        openbmc.PasswordSshTransport.MakeDirectory(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
      }
    OpenBmcRemoveDirectory { path } =>
      openbmc.PasswordSshTransport.RemoveDirectory(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcRemoveFile { path } =>
      openbmc.PasswordSshTransport.RemoveFile(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        path: path,
      )
    OpenBmcCopyFilePreservingMetadata { source_path, destination_path } =>
      openbmc.PasswordSshTransport.CopyFilePreservingMetadata(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        source_path: source_path,
        destination_path: destination_path,
      )
    OpenBmcRenameReplace { source_path, destination_path } =>
      openbmc.PasswordSshTransport.RenameReplace(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        source_path: source_path,
        destination_path: destination_path,
      )
    OpenBmcSynchronizeFilesystems =>
      openbmc.PasswordSshTransport.SynchronizeFilesystems(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
      )
    OpenBmcWaitSeconds { duration } =>
      openbmc.PasswordSshTransport.WaitSeconds(
        host: session.host,
        username: session.username,
        password: session.password,
        known_hosts_path: session.known_hosts_path,
        seconds: second_count(duration),
      )
  }
  PasswordSshExecResult {
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

service openbmc.JsonProjection {
  operation ProjectFanConfig {
    input {
      desired_json: String
      path: NonEmptyStr
    }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: [
        "jq",
        "--argjson",
        "desired",
        "{desired_json}",
        "if ([.zones[].pids[] | select(.name == \"TEMP_SOC\" and .type == \"stepwise\")] | length) != 1 then error(\"expected exactly one TEMP_SOC stepwise controller\") elif ([.zones[].pids[] | select(.name == $desired.fan_pid_entry and .type == \"fan\")] | length) != 1 then error(\"expected exactly one projected aggregate fan PID entry\") else .zones |= map(if any(.pids[]; .name == \"TEMP_SOC\" and .type == \"stepwise\") then .minThermalOutput = $desired.minimum | .failsafePercent = $desired.zone_failsafe_duty | .pids |= map(if .name == $desired.fan_pid_entry and .type == \"fan\" then .inputs = $desired.fan_inputs elif .name == \"TEMP_SOC\" and .type == \"stepwise\" then .failsafePercent = $desired.sensor_failsafe | .pid.positiveHysteresis = $desired.positive_hysteresis | .pid.negativeHysteresis = $desired.negative_hysteresis | .pid.reading = ($desired.readings | to_entries | map(\{key: (.key | tostring), value: .value}) | from_entries) | .pid.output = ($desired.outputs | to_entries | map(\{key: (.key | tostring), value: .value}) | from_entries) else . end) else . end) end",
        "{path}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "OpenBMC fan config projection failed"
    }
  }

}

