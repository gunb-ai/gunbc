// OpenBMC fan observation and mutation are a composition of typed argv and typed file-transfer
// operations. ObjectMapper and sensor values are requested from busctl as JSON and projected
// through typed local jq operations; no consumer parses busctl's presentation text. The jq programs
// are confined to this extdeps realizer as fixed semantic projections; gunbc intent never
// constructs shell syntax. Password material remains on sshpass fd 0. The caller separately models
// which file-publication operations establish a durability commit barrier.

fn openbmc_upload_file(
  session: PasswordSshSession,
  local_path: NonEmptyStr,
  remote_path: NonEmptyStr,
) -> PasswordSshExecResult {
  password_ssh_session_copy_file(
    session: session,
    source_path: local_path,
    destination_path: remote_path,
  )
}
