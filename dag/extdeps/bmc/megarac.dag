module extdeps.bmc.megarac

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { String, NonEmptyStr, List }
import std.credentials { FactoryLogin }
import extdeps.bmc.endpoint { BmcProtocol, Ipmi }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.vendor.ami { ami }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.ami.com/megarac/"
  }
}

// AMI MEGARAC, THE PROPRIETARY BMC FIRMWARE STACK - subject authority:
// extdeps.firmware.megarac.subject. SCOPE DISCIPLINE, PER GRAIN: rows in this module answer at the
// FAMILY grain and each states its basis - a published vendor default, or the
// guaranteed-across-builds floor. Anything observed on one shipping build only (Redfish absence,
// firmware revision, service roster) is a BUILD-scoped fact and lives with the build binding
// (extdeps.ampere.mt_collins_product_brief.bmc for the Foxconn Mt. Collins build), never promoted
// here. The REST operation rows below are the SP-X interface shape as executed on that build - the
// one place a single-build execution grounds a family-grain row - and carry that provenance
// explicitly.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.megarac",
      decl_name: "megarac_api_operations",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data megarac_vendor: Vendor<Hardware> = ami


// The family answer is the PUBLISHED default - which is what FactoryLogin's
// published_password field means - admin/admin being AMI's widely published MegaRAC
// default; the Foxconn Mt. Collins build observation (its bmc binding module) is
// corroboration, not the basis.
//
// THIS IS THE ONE CREDENTIAL A WORKFLOW TESTS, NOT THE FIRST OF SEVERAL
// (NO-FALLBACK-0). It used to read "the first credential to TRY", which describes an
// ordered search: try this, and on refusal try the next. There is no next. An ODM
// build may ship differently, and a refusal here is a TERMINAL, typed fact about
// this unit - the build shipped other credentials, or they have already been rotated
// - which ends the attempt and is carried by a workflow-layer intake receipt. It is
// neither an error to force past nor a cue to guess again: a second credential
// attempted after the first is refused is exactly the fallback this model exists to
// refuse, and it is also how a fleet locks itself out.
data megarac_factory_login: FactoryLogin = FactoryLogin {
  username: "admin",
  published_password: "admin",
}

// The family FLOOR: protocols guaranteed across MegaRAC builds. IPMI v2 lanplus
// (chassis, sensors, SEL, FRU, SOL, bootdev) is universal to the product line; Redfish
// is advertised by AMI but shipped per ODM build, so its presence is a BUILD-scoped
// observation carried on the build's binding module, never asserted or denied here.
// A Redfish-assuming workflow must read the build row or probe.
data megarac_supported_protocols_floor: List<BmcProtocol> = [Ipmi]

// ---------------------------------------------------------------------------------------------
// THE PROPRIETARY REST SURFACE (SP-X style), as executed. Session auth: POST /api/session
// with form-encoded username/password; the JSON reply carries CSRFToken, and every
// subsequent request presents the session cookie plus header X-CSRFTOKEN.
// ---------------------------------------------------------------------------------------------

type MegaRacApiOperation {
  http_method: NonEmptyStr
  path: NonEmptyStr
  contract_note: NonEmptyStr
}

data megarac_op_session_login: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/session",
  contract_note: "form-encoded username/password; reply JSON carries CSRFToken and privilege; subsequent calls send the session cookie and X-CSRFTOKEN header",
}

data megarac_op_media_config: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "PUT",
  path: "/api/settings/media/general",
  contract_note: "JSON body: remote_media_support:1, cd_remote_server_address/source_path, cd_remote_share_type nfs|cifs, mount_cd:1; an rmedia daemon mounts on a retry interval (rmedia_retry_interval), so a mount can succeed seconds after the PUT that configured it",
}

data megarac_op_media_images: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "GET",
  path: "/api/settings/media/remote/images",
  contract_note: "lists image files visible on the mounted share; 'Could not mount the remote path' here means the rmedia daemon has not (yet) mounted - poll after the retry interval before concluding failure",
}

data megarac_op_media_start: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/settings/media/remote/start-media",
  contract_note: "JSON body MUST carry image_redirection:1 beside image_name, image_type (1 = CD) and image_index; without image_redirection the firmware refuses with opaque codes 13410/13460. Recovered from the firmware's own UI bundle (source.min.js), not from documentation. Success attaches a redirection session visible at /api/settings/media/remote/configurations (redirection_status nonzero, session_index bound)",
}

data megarac_op_media_stop: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/settings/media/remote/stop-media",
  contract_note: "counterpart of start-media, same body shape",
}

data megarac_op_media_status: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "GET",
  path: "/api/settings/media/remote/configurations",
  contract_note: "one row per media instance: media_type, image_name, session_index, redirection_status",
}

// THE EXECUTED HEADLESS BOOT-FROM-ISO SEQUENCE (Foxconn Mt. Collins build, 2026-08-29): export the
// ISO directory over NFS to the BMC address; PUT media config; wait for the rmedia retry to mount
// (images listing goes from refusal to listing); POST start-media WITH image_redirection:1;
// ipmitool chassis bootdev cdrom then power reset. Execution receipts available without any screen:
// the NFS server's read counter (bulk reads then quiet = image loaded), the configurations row
// (redirection_status/session_index), and the boot CPU's power rails rising while the second socket
// idles.

data megarac_api_operations: List<MegaRacApiOperation> = [
  megarac_op_session_login,
  megarac_op_media_config,
  megarac_op_media_images,
  megarac_op_media_start,
  megarac_op_media_stop,
  megarac_op_media_status,
]

// THE EXECUTED HEADLESS BOOT-FROM-ISO SEQUENCE (Foxconn Mt. Collins build, 2026-08-29).
// export the ISO directory over NFS to the BMC address; PUT media config; wait for the rmedia
// retry to mount (images listing goes from refusal to listing); POST start-media WITH
// image_redirection:1; ipmitool chassis bootdev cdrom then power reset. Execution receipts
// available without any screen: the NFS server's read counter (bulk reads then quiet = image
// loaded), the configurations row (redirection_status/session_index), and the boot CPU's power
// rails rising while the second socket idles.

// THE PARAMETER THE START-MEDIA CONTRACT CALLS REQUIRED, AS A TYPE. megarac_op_media_start
// says the body MUST carry image_redirection:1 or the firmware refuses with opaque codes;
// a profile for a MegaRAC build therefore carries this as a typed route fact, and a
// remote-media binding can only be constructed from the Enabled arm
// (extdeps.bmc.virtual_media MegaRacRemoteMediaParams.image_redirection).
type MegaRacImageRedirection
  = MegaRacImageRedirectionEnabled
  | MegaRacImageRedirectionUnset

type MegaRacImageRedirectionRequired
  = | MegaRacImageRedirectionOn

fn megarac_image_redirection_wire(r: MegaRacImageRedirectionRequired) -> NonEmptyStr {
  match r {
    MegaRacImageRedirectionOn => "1"
  }
}
