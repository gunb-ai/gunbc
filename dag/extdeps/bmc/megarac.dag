module extdeps.bmc.megarac

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { Bool, FilePath, String, NonEmptyStr, List }
import extdeps.shell
import extdeps.filesystem.filesystem_io
import extdeps.languages.json.parse {
  JsonArray,
  JsonDocumentParsed,
  JsonDocumentUnreadable,
  JsonMemberFound,
  JsonNumber,
  JsonString,
  JsonValue,
  json_object_unique_member,
  parse_json_document,
}
import std.credentials { FactoryLogin }
import extdeps.bmc.endpoint { BmcProtocol, Ipmi }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.vendor.ami { ami }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.ami.com/megarac/"
  }
}

// AMI MEGARAC, THE PROPRIETARY BMC FIRMWARE STACK - subject authority:
// extdeps.firmware.megarac.subject. SCOPE DISCIPLINE, PER GRAIN: rows in this module answer at the
// FAMILY grain and each states its basis - a published vendor default, or the
// guaranteed-across-builds floor. Anything observed on one shipping build only (Redfish absence,
// firmware revision, service roster) is a BUILD-scoped fact and lives with the build binding
// (extdeps.ampere.mt_collins_product_brief.bmc for the Foxconn Mt. Collins build), never promoted
// here. The REST operation rows below are the SP-X interface shape as executed on that build - the
// one place a single-build execution grounds a family-grain row - and carry that provenance
// explicitly.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.megarac",
      decl_name: "megarac_api_operations",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data megarac_vendor: Vendor<Hardware> = ami


// The family answer is the PUBLISHED default - which is what FactoryLogin's
// published_password field means - admin/admin being AMI's widely published MegaRAC
// default; the Foxconn Mt. Collins build observation (its bmc binding module) is
// corroboration, not the basis.
//
// THIS IS THE ONE CREDENTIAL A WORKFLOW TESTS, NOT THE FIRST OF SEVERAL
// (NO-FALLBACK-0). It used to read "the first credential to TRY", which describes an
// ordered search: try this, and on refusal try the next. There is no next. An ODM
// build may ship differently, and a refusal here is a TERMINAL, typed fact about
// this unit - the build shipped other credentials, or they have already been rotated
// - which ends the attempt and is carried by a workflow-layer intake receipt. It is
// neither an error to force past nor a cue to guess again: a second credential
// attempted after the first is refused is exactly the fallback this model exists to
// refuse, and it is also how a fleet locks itself out.
data megarac_factory_login: FactoryLogin = FactoryLogin {
  username: "admin",
  published_password: "admin",
}

// The family FLOOR: protocols guaranteed across MegaRAC builds. IPMI v2 lanplus
// (chassis, sensors, SEL, FRU, SOL, bootdev) is universal to the product line; Redfish
// is advertised by AMI but shipped per ODM build, so its presence is a BUILD-scoped
// observation carried on the build's binding module, never asserted or denied here.
// A Redfish-assuming workflow must read the build row or probe.
data megarac_supported_protocols_floor: List<BmcProtocol> = [Ipmi]

// ---------------------------------------------------------------------------------------------
// THE PROPRIETARY REST SURFACE (SP-X style), as executed. Session auth: POST /api/session
// with form-encoded username/password; the JSON reply carries CSRFToken, and every
// subsequent request presents the session cookie plus header X-CSRFTOKEN.
// ---------------------------------------------------------------------------------------------

type MegaRacApiOperation {
  http_method: NonEmptyStr
  path: NonEmptyStr
  contract_note: NonEmptyStr
}

data megarac_op_session_login: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/session",
  contract_note: "form-encoded username/password; reply JSON carries CSRFToken and privilege; subsequent calls send the session cookie and X-CSRFTOKEN header",
}

data megarac_op_media_config: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "PUT",
  path: "/api/settings/media/general",
  contract_note: "JSON body: remote_media_support:1, cd_remote_server_address/source_path, cd_remote_share_type nfs|cifs, mount_cd:1; an rmedia daemon mounts on a retry interval (rmedia_retry_interval), so a mount can succeed seconds after the PUT that configured it",
}

data megarac_op_media_images: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "GET",
  path: "/api/settings/media/remote/images",
  contract_note: "lists image files visible on the mounted share; 'Could not mount the remote path' here means the rmedia daemon has not (yet) mounted - poll after the retry interval before concluding failure",
}

data megarac_op_media_start: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/settings/media/remote/start-media",
  contract_note: "JSON body MUST carry image_redirection:1 beside image_name, image_type (1 = CD) and image_index; without image_redirection the firmware refuses with opaque codes 13410/13460. Recovered from the firmware's own UI bundle (source.min.js), not from documentation. Success attaches a redirection session visible at /api/settings/media/remote/configurations (redirection_status nonzero, session_index bound)",
}

data megarac_op_media_stop: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/settings/media/remote/stop-media",
  contract_note: "counterpart of start-media, same body shape",
}

data megarac_op_media_status: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "GET",
  path: "/api/settings/media/remote/configurations",
  contract_note: "one row per media instance: media_type, image_name, session_index, redirection_status",
}

// THE EXECUTED HEADLESS BOOT-FROM-ISO SEQUENCE (Foxconn Mt. Collins build, 2026-08-29): export the
// ISO directory over NFS to the BMC address; PUT media config; wait for the daemon's own retry
// interval while the images listing goes from refusing to listing the image; POST start-media WITH
// image_redirection:1; ipmitool chassis bootdev cdrom then power reset. Execution receipts
// available without any screen: the NFS server's read counter (bulk reads then quiet = image
// loaded), the configurations row (redirection_status/session_index), and the boot CPU's power
// rails rising while the second socket idles.
//
// THE WAIT IS AN ASYNCHRONOUS PENDING STATE, NOT PERMISSION TO POLL UNTIL GREEN
// (NO-FALLBACK-1). Read as prose, "wait for the listing to change" and "keep asking until it
// agrees" are the same sentence, and only one of them is admissible. The bound, the terminal
// exits and the rule that no later observation overwrites a terminal one are modelled in
// gunbc.machine_intake_mount_establishment, which is where they belong: what our polling saw is
// a receipt of OUR attempt, never a fact this vendor module owns.

data megarac_api_operations: List<MegaRacApiOperation> = [
  megarac_op_session_login,
  megarac_op_media_config,
  megarac_op_media_images,
  megarac_op_media_start,
  megarac_op_media_stop,
  megarac_op_media_status,
]

// THE PARAMETER THE START-MEDIA CONTRACT CALLS REQUIRED, AS A TYPE. megarac_op_media_start
// says the body MUST carry image_redirection:1 or the firmware refuses with opaque codes;
// a profile for a MegaRAC build therefore carries this as a typed route fact, and a
// remote-media binding can only be constructed from the Enabled arm
// (extdeps.bmc.virtual_media MegaRacRemoteMediaParams.image_redirection).
type MegaRacImageRedirection
  = MegaRacImageRedirectionEnabled
  | MegaRacImageRedirectionUnset

type MegaRacImageRedirectionRequired
  = | MegaRacImageRedirectionOn

fn megarac_image_redirection_wire(r: MegaRacImageRedirectionRequired) -> NonEmptyStr {
  match r {
    MegaRacImageRedirectionOn => "1"
  }
}

// THE TWO JSON READERS THIS MODULE NEEDS, over the repository's single recognition authority rather
// than a regex against a response body. A document the parser cannot read is unreadable rather than
// partially believed, which is what lets the session folds below distinguish "the controller said
// no" from "the controller said something we do not understand".
fn json_string_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonString { value: s } => Present { value: s }
        _ => none
      }
    _ => none
  }
}

fn json_number_member(doc: JsonValue, key: String) -> String? {
  match json_object_unique_member(v: doc, key: key) {
    JsonMemberFound { value: v } =>
      match v {
        JsonNumber { lexeme: n } => Present { value: n }
        _ => none
      }
    _ => none
  }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// THE SESSION, AS A SCOPE RATHER THAN THREE LOOSE STRINGS
// ─────────────────────────────────────────────────────────────────────────────────────────────────

// A SESSION IS A RESOURCE WITH A LIFETIME, and the first modeled caller of this API treated it as a
// bag of parameters — a host, a jar path and a token passed separately to every operation. That
// shape has no place to put acquisition or release, so both ended up as the caller's problem, and
// the caller got them wrong in the specific way this section exists to prevent: a login that
// SUCCEEDED and then failed to yield a readable CSRF token returned an outcome named
// "release not attempted", which asserts no session exists while one is open on the controller.
// The session table is finite and this lane has already exhausted one service's share of it.
//
// SO THE SCOPE IS THE UNIT, NOT THE TOKEN. Everything an acquisition creates — the scratch
// directory holding the credential, the cookie jar that is the actual bearer, the host it was
// obtained against — is carried in one value that release consumes. There is no arm of acquisition
// that creates state and returns a value which cannot release it.
type MegaRacSessionScope sole_constructor {
  bmc_host: NonEmptyStr
  scratch_dir: NonEmptyStr
  cookie_jar: NonEmptyStr
}

type MegaRacSession sole_constructor {
  scope: MegaRacSessionScope
  csrf_token: NonEmptyStr
}

// MegaRacSessionUnusable CARRIES THE SCOPE, and that is the whole point of its existence. It is the
// login-succeeded-token-unreadable case, which is a session that exists and cannot be used — so it
// must still be released, and it can be: the release measurement below shows teardown does not
// require the token. Modelling it as a plain refusal would drop the jar on the floor.
type MegaRacSessionAcquisition
  = MegaRacSessionAcquired { session: MegaRacSession }
  | MegaRacSessionDenied { detail: String }
  | MegaRacSessionUnusable { scope: MegaRacSessionScope, detail: String }
  | MegaRacSessionStagingFailed { detail: String }

// THE RELEASE OUTCOME IS DECIDED BY A PROBE, NEVER BY THE DELETE'S STATUS, and that is a measured
// requirement rather than belt-and-braces. Controlled runs against this controller on 2026-09-06,
// each with a positive control confirming the session answered 200 before teardown:
//
//   DELETE carrying the CSRF header   -> HTTP 200, session subsequently 401  (released)
//   DELETE with no CSRF header        -> HTTP 401, session subsequently 401  (RELEASED ANYWAY)
//
// The second row is the finding. A 401 on the teardown request accompanied a teardown that took
// effect, which is the same status-is-not-outcome behaviour this firmware already shows on writes,
// now confirmed for session lifetime. Keying release on the DELETE's exit would have reported a leak
// that did not happen — and, worse, would have taught a caller to retry a teardown that had already
// succeeded.
//
// IT ALSO SETTLES WHETHER THE UNUSABLE ARM CAN CLEAN UP: the no-CSRF row released, so a session
// whose token could not be read is recoverable rather than a permanent leak.
//
// MegaRacSessionStillLive IS THE LOUD ONE. It means the probe authenticated AFTER teardown, so a
// session really is stranded on the controller. That is the state the finite session table cares
// about, and it is reported as its own arm rather than folded into an unverified outcome, because
// the two license opposite actions: one is "look at the controller", the other is "look at the
// probe".
type MegaRacSessionRelease
  = MegaRacSessionReleaseConfirmed
  | MegaRacSessionStillLive { scope: MegaRacSessionScope, detail: String }
  | MegaRacSessionReleaseUnverifiable { scope: MegaRacSessionScope, detail: String }
  | MegaRacSessionNeverOpened

// THE SCRATCH DIRECTORY IS NOT ALWAYS DISCARDED, and treating it as unconditional cleanup destroyed
// the only thing that could fix a leak. That directory holds the COOKIE JAR, which is the bearer.
// When the probe says a session is still live, removing the jar removes the sole credential capable
// of issuing another authenticated teardown -- so the previous version reliably converted a
// recoverable leak into a permanent one, at exactly the moment it had detected the leak. When the
// probe is unverifiable it destroys the evidence needed to resolve the uncertainty instead.
//
// SO ONLY A CONFIRMED RELEASE LICENSES THE DELETE. Retention is a reported outcome rather than a
// silent omission, because a retained scratch directory holds a live bearer on local disk and
// someone has to know to come back for it.
type MegaRacScratchCleanup
  = MegaRacScratchDiscarded
  | MegaRacScratchRetained { scratch_dir: NonEmptyStr, reason: String }
  | MegaRacScratchDiscardFailed { scratch_dir: NonEmptyStr }

// TEARDOWN IS A PRODUCT, NOT A SUM, because the remote session and the local scratch are independent
// facts and every caller needs both. The previous renderer examined the release standing only when
// the attach had succeeded, so on any attach refusal the stranded-session signal was dropped -- the
// exact resource-accounting loss this abstraction exists to prevent, reintroduced one layer up.
type MegaRacSessionTeardown {
  standing: MegaRacSessionRelease
  cleanup: MegaRacScratchCleanup
}

// THE THREE SESSION OPERATIONS, WITH THEIR RATIONALE HOISTED HERE because an operation lives inside
// a service body and only module-item grain is modeled (DESIGN section 4c) -- the same placement
// extdeps.filesystem.filesystem_io records for its own operation rows.
//
// Open: THE CREDENTIAL REACHES CURL THROUGH A FILE, NOT ARGV. The earlier form spelled
// -d "username=...&password=..." which puts the secret in the process table for every local reader,
// and hand-concatenates a form body -- so a password containing & or = would silently change the
// fields being submitted rather than failing. --data-urlencode reads the password from a file and
// percent-encodes both fields, fixing the exposure and the encoding together.
//
// -k IS STILL HERE AND IT IS A DECLARED GAP, not an oversight. The controller presents a
// self-signed certificate and this repository has no pinned trust anchor for it, so the endpoint's
// TLS identity is UNVERIFIED: a LAN-position attacker could answer for it. The credential is no
// longer in argv, but it is still handed to whoever terminates that connection. This dissolves when
// a controller certificate is enrolled the way host keys are.
//
// Close: NO CSRF HEADER, because the measurement recorded at MegaRacSessionRelease shows teardown
// does not require one, and because omitting it is what lets the token-unreadable acquisition arm
// clean up after itself. The response status is deliberately not consulted by the fold; the probe
// decides.
//
// Probe: IT READS A BODY RATHER THAN A STATUS CODE, for a mechanical reason. curl spells the status
// with --write-out '%{http_code}', whose braces collide with this transport's own argv substitution
// syntax; reading the body avoids inventing an escape for one call site, and the two shapes are
// unambiguous and already measured -- an unauthenticated read answers
// { "cc": 7, "error": "Invalid Authentication" } and an authenticated one answers the settings
// object carrying id. --fail was rejected for the same job because it collapses every non-2xx to
// one exit: a 500 would then read as "released" while the session was still live, under-reporting
// exactly the leak this probe exists to find.
service megarac.Session {
  operation Open {
    input {
      bmc_host: NonEmptyStr
      username: NonEmptyStr
      password_file: NonEmptyStr
      cookie_jar: NonEmptyStr
    }
    output {
      body: String from "stdout"
      success: Bool from "exit_success"
    }
    transport shell {
      argv: [
        "curl", "-sS", "-k",
        "-c", "{cookie_jar}",
        "--data-urlencode", "username={username}",
        "--data-urlencode", "password@{password_file}",
        "https://{bmc_host}/api/session"
      ]
    }
    exit {
      0 => Unit
      nonzero => String "curl could not reach the controller session endpoint"
    }
  }

  operation Close {
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "-sS", "-k", "-b", "{cookie_jar}", "-X", "DELETE", "https://{bmc_host}/api/session"]
    }
    exit {
      0 => Unit
      nonzero => String "curl could not reach the controller session endpoint to close"
    }
  }

  operation Probe {
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-b", "{cookie_jar}", "https://{bmc_host}/api/settings/media/general"]
    }
    exit {
      0 => Unit
      nonzero => String "curl could not reach the controller to probe session validity"
    }
  }
}

// THE COOKIE JAR IS PRE-CREATED OWNER-ONLY, and measuring the first version is what showed why.
// curl creates a jar it is given with -c under the ambient umask, which on this host produced mode
// 0664 -- group and world readable. The jar IS the bearer once login succeeds, so that is the same
// disclosure as a readable password file, and the 0600 spent on the credential beside it bought
// nothing. Writing the path owner-only first means curl truncates an existing 0600 file rather than
// creating a new one, so the mode is established before any secret reaches it.
//
// THE ENCLOSING DIRECTORY IS 0700 AND THAT IS NOT THE ARGUMENT. It does contain the exposure today,
// which is why this is a hardening rather than an incident -- but a mode that is correct only
// because of its parent is correct by coincidence, and this lane has already shipped one guarantee
// that held by coincidence.
//
// THE ACQUISITION OWNS THE CREDENTIAL'S WHOLE LIFETIME ON DISK. mktemp -d creates the directory
// 0700, and WriteOwnerOnly writes the secret 0600 inside it, so the credential is never readable by
// another account and never appears in a process argument. The cookie jar is placed in that same
// directory rather than at a shared path: the jar IS the bearer once login succeeds, so a
// world-readable jar is the same disclosure as a world-readable password, and an attempt-owned
// directory makes two concurrent attempts unable to share one — which a fixed /tmp path allowed.
func megarac_acquire_session(
  bmc_host: NonEmptyStr,
  username: NonEmptyStr,
  password: NonEmptyStr,
) -> MegaRacSessionAcquisition
  uses net: std.resources.Network
{
  scratch = shell.Mktemp.Dir()
  if scratch.success == false {
    return MegaRacSessionStagingFailed { detail: "mktemp -d failed; refusing to place a credential at a predictable path" }
  }

  let dir = scratch.path as String
  let password_file = join([dir, "/credential"], "") as NonEmptyStr
  let cookie_jar = join([dir, "/jar"], "") as NonEmptyStr

  wrote = Filesystem.WriteOwnerOnly(path: password_file as String, content: password as String)
  if wrote.success == false {
    cleaned = shell.Remove.RecursiveForce(path: scratch.path)
    return MegaRacSessionStagingFailed { detail: concat("could not stage the credential owner-only: ", wrote.error) }
  }

  jarred = Filesystem.WriteOwnerOnly(path: cookie_jar as String, content: "")
  if jarred.success == false {
    cleaned_jar = shell.Remove.RecursiveForce(path: scratch.path)
    return MegaRacSessionStagingFailed { detail: concat("could not pre-create the cookie jar owner-only: ", jarred.error) }
  }

  let scope = MegaRacSessionScope {
    bmc_host: bmc_host,
    scratch_dir: dir as NonEmptyStr,
    cookie_jar: cookie_jar,
  }

  opened = megarac.Session.Open(
    bmc_host: bmc_host,
    username: username,
    password_file: password_file,
    cookie_jar: cookie_jar,
  )

  return megarac_discard_scratch_when_terminal(
    acquisition: megarac_classify_acquisition(scope: scope, body: opened.body, reached: opened.success),
    scratch_dir: scratch.path,
  )
}

// AN ARM THAT WILL NEVER BE RELEASED CLEANS UP HERE, because nothing else can. Release owns the
// scratch directory for every arm that hands one out, but MegaRacSessionDenied deliberately carries
// no scope -- there is no controller session to tear down -- and the first version of this fold
// therefore returned it with the staged credential still on disk. Measured: a wrong-password run
// left /tmp/tmp.XXXX/credential in place, correctly 0600 and indefinitely.
//
// STAGING FAILURES ARE NOT ROUTED HERE because they clean up at their own site, before this point is
// reached; adding them would be a second removal of a directory already gone.
func megarac_discard_scratch_when_terminal(
  acquisition: MegaRacSessionAcquisition,
  scratch_dir: FilePath,
) -> MegaRacSessionAcquisition
  uses net: std.resources.Network
{
  match acquisition {
    MegaRacSessionDenied { detail: _ } => {
      discarded = megarac_discard_scratch(scratch_dir: scratch_dir as NonEmptyStr)
      return acquisition
    }
    _ => return acquisition
  }
}

// THE CLASSIFICATION IS SEPARATE FROM THE EFFECT so the three outcomes can be reasoned about
// without a controller. The distinction that matters is between DENIED and UNUSABLE: denied means
// no session was created and there is nothing to release, unusable means one was created and its
// token could not be read. Collapsing them is precisely the defect this replaces — the earlier form
// reported the second as "release not attempted", a phrase that reads as "nothing to clean up".
fn megarac_classify_acquisition(
  scope: MegaRacSessionScope,
  body: String,
  reached: Bool,
) -> MegaRacSessionAcquisition {
  if reached == false {
    MegaRacSessionUnusable { scope: scope, detail: "the session request did not complete; a session may or may not have been created, so the jar is carried for teardown" }
  } else {
    match parse_json_document(s: body) {
      JsonDocumentUnreadable { gap: _ } =>
        MegaRacSessionUnusable { scope: scope, detail: concat("the session response was not JSON: ", body) }
      JsonDocumentParsed { value: doc } =>
        match json_string_member(doc: doc, key: "CSRFToken") {
          Present { value: token } =>
            if token.length() == 0 {
              MegaRacSessionUnusable { scope: scope, detail: "the session response carried an empty CSRFToken" }
            } else {
              MegaRacSessionAcquired {
                session: MegaRacSession { scope: scope, csrf_token: token as NonEmptyStr },
              }
            }
          Absent =>
            match json_string_member(doc: doc, key: "error") {
              Present { value: e } => MegaRacSessionDenied { detail: e }
              Absent => MegaRacSessionUnusable { scope: scope, detail: concat("the session response carried neither a CSRFToken nor an error: ", body) }
            }
        }
    }
  }
}

// AN UNREACHED PROBE IS UNVERIFIABLE, NOT RELEASED. The probe is the only thing that decides this
// outcome, so a probe that did not happen decides nothing — reporting release on a failed probe
// would make a network partition look like successful cleanup, which is the absorbing arm that
// destroys the signal the finite session table depends on.
// THE CONFIRMED SHAPE IS EXACT, and accepting any error field was an absorbing arm pointed at the
// leak this probe exists to find. The measured unauthenticated response is
// { "cc": 7, "error": "Invalid Authentication" } -- so a 500 answering { "error": "internal
// failure" } previously read as a confirmed logout, and a contradictory body carrying both an error
// and authenticated fields took the confirmed arm because the error test ran first. Confirmation now
// requires the exact code, the exact message, AND the absence of an authenticated marker;
// everything else is unverifiable, which is the arm that keeps a possible leak visible.
fn megarac_release_confirmed_shape(doc: JsonValue) -> Bool {
  let code_ok = match json_number_member(doc: doc, key: "cc") {
    Absent => false
    Present { value: c } => c == "7"
  }
  let message_ok = match json_string_member(doc: doc, key: "error") {
    Absent => false
    Present { value: e } => e == "Invalid Authentication"
  }
  let authenticated_marker = match json_number_member(doc: doc, key: "id") {
    Absent => false
    Present { value: _ } => true
  }
  code_ok && message_ok && (authenticated_marker == false)
}

// AN UNREACHED PROBE IS UNVERIFIABLE, NOT RELEASED. The probe is the only thing that decides this
// outcome, so a probe that did not happen decides nothing -- reporting release on a failed probe
// would make a network partition look like successful cleanup, which is the absorbing arm that
// destroys the signal the finite session table depends on.
fn megarac_classify_release(scope: MegaRacSessionScope, body: String, reached: Bool) -> MegaRacSessionRelease {
  if reached == false {
    MegaRacSessionReleaseUnverifiable { scope: scope, detail: "the validity probe did not complete, so whether the session was released is unknown" }
  } else {
    match parse_json_document(s: body) {
      JsonDocumentUnreadable { gap: _ } =>
        MegaRacSessionReleaseUnverifiable { scope: scope, detail: concat("the validity probe returned a body that is not JSON: ", body) }
      JsonDocumentParsed { value: doc } =>
        if megarac_release_confirmed_shape(doc: doc) {
          MegaRacSessionReleaseConfirmed
        } else {
          match json_number_member(doc: doc, key: "id") {
            Present { value: _ } =>
              MegaRacSessionStillLive { scope: scope, detail: "the cookie still authenticates after teardown; a session is stranded on the controller and the jar is RETAINED so it can be torn down again" }
            Absent =>
              MegaRacSessionReleaseUnverifiable { scope: scope, detail: concat("the validity probe returned a body matching neither the exact unauthenticated shape nor the authenticated one: ", body) }
          }
        }
    }
  }
}

// RELEASE TEARS DOWN, VERIFIES, AND ONLY THEN DECIDES WHETHER IT MAY DISCARD. The probe runs before
// any removal because the jar is the probe's input: deleting it first leaves the verification unable
// to run, which is how a cleanup step destroys its own evidence.
func megarac_release_session(scope: MegaRacSessionScope) -> MegaRacSessionTeardown
  uses net: std.resources.Network
{
  closed = megarac.Session.Close(bmc_host: scope.bmc_host, cookie_jar: scope.cookie_jar)

  probed = megarac.Session.Probe(bmc_host: scope.bmc_host, cookie_jar: scope.cookie_jar)
  let standing = megarac_classify_release(scope: scope, body: probed.body, reached: probed.success)

  return match standing {
    MegaRacSessionReleaseConfirmed =>
      MegaRacSessionTeardown { standing: standing, cleanup: megarac_discard_scratch(scratch_dir: scope.scratch_dir) }
    MegaRacSessionNeverOpened =>
      MegaRacSessionTeardown { standing: standing, cleanup: megarac_discard_scratch(scratch_dir: scope.scratch_dir) }
    MegaRacSessionStillLive { scope: _, detail: _ } =>
      MegaRacSessionTeardown {
        standing: standing,
        cleanup: MegaRacScratchRetained { scratch_dir: scope.scratch_dir, reason: "the session is still live and this directory holds the only bearer that can tear it down" },
      }
    MegaRacSessionReleaseUnverifiable { scope: _, detail: _ } =>
      MegaRacSessionTeardown {
        standing: standing,
        cleanup: MegaRacScratchRetained { scratch_dir: scope.scratch_dir, reason: "whether the session was released is unknown, and this directory holds the bearer needed to find out" },
      }
  }
}

// THE REMOVAL'S OWN RESULT IS OBSERVED, which the previous version bound and then ignored. An
// ignored cleanup means the credential or the jar can remain on disk while the modeled outcome says
// the scratch was discarded -- a claim about the filesystem that nothing checked.
func megarac_discard_scratch(scratch_dir: NonEmptyStr) -> MegaRacScratchCleanup
  uses net: std.resources.Network
{
  discarded = shell.Remove.RecursiveForce(path: scratch_dir as FilePath)
  return if discarded.success {
    MegaRacScratchDiscarded
  } else {
    MegaRacScratchDiscardFailed { scratch_dir: scratch_dir }
  }
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// REMOTE MEDIA, OVER AN ACQUIRED SESSION
// ─────────────────────────────────────────────────────────────────────────────────────────────────

// THE THREE MEDIA OPERATIONS, rationale hoisted for the module-item grain rule (DESIGN section 4c).
//
// Images: THIS LISTING ENUMERATES WHAT IS AVAILABLE TO ATTACH, NOT WHAT THE SHARE HOLDS. Measured
// on a Mt. Collins unit 2026-09-06 with two ISOs exported: the listing named both; after start-media
// attached one it returned ONLY THE OTHER, and the survivor's image_index moved from 1 to 0. The
// attached image had not vanished -- it had moved to Configurations, which is where a presented
// image lives. An earlier reading of this as a stale cache produced the operator-facing remedy
// "re-assert mount_cd", which appears to work only because toggling mount_cd DETACHES EVERYTHING,
// returning the image to the available pool. That remedy is retracted: it repairs a listing by
// undoing the attachment the caller asked for.
//
// Configurations: THE PRESENTED SET, and the authority for whether an attach is done. It is read
// BEFORE anything is written, so the converged case performs no write at all -- start-media against
// an already-presented image is a write whose effect on a booted host is unmodelled, and reading
// first is how that write is avoided rather than merely made idempotent.
//
// StartMedia: image_redirection MUST be 1 or the firmware refuses with opaque codes 13410/13460,
// recovered from the firmware's own UI bundle rather than from documentation. The body is rendered
// inside this module so a caller cannot omit it.
service megarac.Media {
  operation Images {
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}",
             "https://{bmc_host}/api/settings/media/remote/images"]
    }
    exit {
      0 => Unit
      nonzero => String "curl could not read the remote image listing"
    }
  }

  operation Configurations {
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-k", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}",
             "https://{bmc_host}/api/settings/media/remote/configurations"]
    }
    exit {
      0 => Unit
      nonzero => String "curl could not read the presented media configurations"
    }
  }

  operation Start {
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr, json_body: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "-sS", "-k", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}",
             "-H", "Content-Type: application/json", "-X", "POST", "-d", "{json_body}",
             "https://{bmc_host}/api/settings/media/remote/start-media"]
    }
    exit {
      0 => Unit
      nonzero => String "curl could not reach the start-media endpoint"
    }
  }
}

// THERE IS NO REFUSED ARM FOR THE START, AND ITS ABSENCE IS THE POINT. The previous version returned
// MegaRacStartRefused whenever start-media exited non-zero and the configurations did not yet name
// the image -- while its own prose said that exact combination is PENDING. This firmware answers
// HTTP 500 on writes that take effect (measured twice: PUT media/general code 16425 with the share
// re-mounting anyway, stop-media code 1411 with the following attach succeeding), and the session
// work in this module has now confirmed the same for DELETE. A terminal refusal derived from that
// status is a fabricated negative, and the specific harm is that it invites a caller to retry a
// write whose effect is already underway.
//
// SO THE STATUS BECOMES EVIDENCE, NOT A VERDICT. It rides inside the indeterminate arm for a human
// to read; nothing branches on it. What decides is the read-back, and when the read-back does not
// yet confirm, the honest answer is that the outcome is unknown.
//
// MegaRacPresentationUnreadable EXISTS SO NO WRITE FOLLOWS AN UNREADABLE READ. Previously a
// malformed configurations body folded to an empty row list, which is indistinguishable from "not
// attached", after which the code issued start-media. That is a write chosen on the basis of a state
// nobody could read.
type MegaRacAttachOutcome
  = MegaRacAlreadyPresented { image_name: NonEmptyStr }
  | MegaRacAttached { image_name: NonEmptyStr, image_index: String }
  | MegaRacPresentationUnreadable { detail: String }
  | MegaRacImagesUnreadable { detail: String }
  | MegaRacImageListingUnparseable { detail: String }
  | MegaRacImageListingEmpty
  | MegaRacImageNotEnumerated { image_name: NonEmptyStr }
  | MegaRacAttachIndeterminate { image_name: NonEmptyStr, start_reached: Bool, evidence: String }

fn megarac_start_body(image_name: NonEmptyStr, image_index: String) -> NonEmptyStr {
  join([
    "{\"image_name\":\"", image_name as String,
    "\",\"image_type\":1,\"image_index\":", image_index,
    ",\"image_redirection\":", megarac_image_redirection_wire(r: MegaRacImageRedirectionOn) as String,
    "}"
  ], "") as NonEmptyStr
}

fn megarac_json_elements(body: String) -> List<JsonValue>? {
  match parse_json_document(s: body) {
    JsonDocumentUnreadable { gap: _ } => none
    JsonDocumentParsed { value: v } =>
      match v {
        JsonArray { elements: es } => Present { value: es }
        _ => none
      }
  }
}

// THE INDEX IS DELIBERATELY NOT COMPARED against the configurations row. An earlier check read
// image_index there, which is absent, so every genuine attachment reported unconfirmed -- caught
// only because the check failed closed. Re-reading it as media_index passed and was still wrong:
// media_index is the virtual CD DEVICE SLOT, beside session_index, not a position in the image
// enumeration. It agreed with the resolved image_index only because this unit presents a single CD
// device, so both are 0. Joining them is nicknaming, and it would begin refusing on any controller
// offering a second slot while blaming the image.
fn megarac_row_presents(row: JsonValue, image_name: NonEmptyStr) -> Bool {
  let name_ok = match json_string_member(doc: row, key: "image_name") {
    Absent => false
    Present { value: n } => n == (image_name as String)
  }
  let active = match json_number_member(doc: row, key: "redirection_status") {
    Absent => false
    Present { value: st } => st != "0"
  }
  let cd_media = match json_number_member(doc: row, key: "media_type") {
    Absent => false
    Present { value: mt } => mt == "1"
  }
  name_ok && active && cd_media
}

fn megarac_index_of_named(elements: List<JsonValue>, image_name: String) -> String? {
  fold(elements, init: none, f: (acc, element) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match json_string_member(doc: element, key: "image_name") {
          Absent => none
          Present { value: found } =>
            if found == image_name {
              json_number_member(doc: element, key: "image_index")
            } else {
              none
            }
        }
    }
  )
}

func megarac_attach_image(session: MegaRacSession, image_name: NonEmptyStr) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  presented = megarac.Media.Configurations(
    bmc_host: session.scope.bmc_host,
    cookie_jar: session.scope.cookie_jar,
    csrf_token: session.csrf_token,
  )
  if presented.success == false {
    return MegaRacPresentationUnreadable { detail: "the presented-media listing could not be read, so whether anything is attached is unknown; refusing to write over an unknown state" }
  }
  match megarac_json_elements(body: presented.body) {
    Absent =>
      return MegaRacPresentationUnreadable { detail: concat("the presented-media listing was not a JSON array: ", presented.body) }
    Present { value: rows } =>
      if rows |> any(r => megarac_row_presents(row: r, image_name: image_name)) {
        return MegaRacAlreadyPresented { image_name: image_name }
      } else {
        return megarac_resolve_then_start(session: session, image_name: image_name)
      }
  }
}

// REACHABLE ONLY WHEN THE PRESENTED SET WAS READ AND DID NOT CONTAIN THE IMAGE, which is what keeps
// the write behind a successful read rather than merely after one.
func megarac_resolve_then_start(session: MegaRacSession, image_name: NonEmptyStr) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  images = megarac.Media.Images(
    bmc_host: session.scope.bmc_host,
    cookie_jar: session.scope.cookie_jar,
    csrf_token: session.csrf_token,
  )
  if images.success == false {
    return MegaRacImagesUnreadable { detail: "the available-image listing could not be read" }
  }
  match megarac_json_elements(body: images.body) {
    Absent => return MegaRacImageListingUnparseable { detail: images.body }
    Present { value: elements } =>
      if (elements |> count) == 0 {
        return MegaRacImageListingEmpty
      } else {
        match megarac_index_of_named(elements: elements, image_name: image_name as String) {
          Absent => return MegaRacImageNotEnumerated { image_name: image_name }
          Present { value: idx } =>
            return megarac_start_then_confirm(session: session, image_name: image_name, image_index: idx)
        }
      }
  }
}

func megarac_start_then_confirm(
  session: MegaRacSession,
  image_name: NonEmptyStr,
  image_index: String,
) -> MegaRacAttachOutcome
  uses net: std.resources.Network
{
  started = megarac.Media.Start(
    bmc_host: session.scope.bmc_host,
    cookie_jar: session.scope.cookie_jar,
    csrf_token: session.csrf_token,
    json_body: megarac_start_body(image_name: image_name, image_index: image_index),
  )

  confirmed = megarac.Media.Configurations(
    bmc_host: session.scope.bmc_host,
    cookie_jar: session.scope.cookie_jar,
    csrf_token: session.csrf_token,
  )
  if confirmed.success == false {
    return MegaRacAttachIndeterminate {
      image_name: image_name,
      start_reached: started.success,
      evidence: "start-media was issued and the confirming read could not be taken",
    }
  }
  match megarac_json_elements(body: confirmed.body) {
    Absent =>
      return MegaRacAttachIndeterminate {
        image_name: image_name,
        start_reached: started.success,
        evidence: concat("start-media was issued and the confirming listing was unreadable: ", confirmed.body),
      }
    Present { value: rows } =>
      if rows |> any(r => megarac_row_presents(row: r, image_name: image_name)) {
        return MegaRacAttached { image_name: image_name, image_index: image_index }
      } else {
        return MegaRacAttachIndeterminate {
          image_name: image_name,
          start_reached: started.success,
          evidence: concat("start-media was issued and the image is not yet presented; the mount daemon is asynchronous so this may still be settling. start body: ", started.body, " | configurations: ", confirmed.body),
        }
      }
  }
}
