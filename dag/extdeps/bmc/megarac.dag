module extdeps.bmc.megarac

import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { Bool, Int, NonEmptyStr, List, Unit }
import std.credentials { FactoryLogin }
import extdeps.bmc.endpoint { AmiMegaRac, BmcProtocol, Ipmi }
import extdeps.bmc.capability {
  BmcFirmwareReleaseIdentity,
  bmc_firmware_release_identity_eq,
  bmc_firmware_release_identity_of_wire,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.vendor.ami { ami }
import extdeps.languages.json.emit { JsonValue, json_object, json_array, json_kv, json_int, json_string, serialize_json_array }
import std.resources { Network }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.ami.com/megarac/"
  }
}

// AMI MEGARAC, THE PROPRIETARY BMC FIRMWARE STACK - subject authority:
// extdeps.firmware.megarac.subject. SCOPE DISCIPLINE, PER GRAIN: rows in this module answer at the
// FAMILY grain and each states its basis - a published vendor default, or the
// guaranteed-across-builds floor. Anything observed on one shipping build only (Redfish absence,
// firmware revision, service roster) is a BUILD-scoped fact and lives with the build binding
// (extdeps.ampere.mt_collins_product_brief.bmc for the Foxconn Mt. Collins build), never promoted
// here. The REST operation rows below are the SP-X interface shape as executed on that build - the
// one place a single-build execution grounds a family-grain row - and carry that provenance
// explicitly.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.megarac",
      decl_name: "megarac_api_operations",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data megarac_vendor: Vendor<Hardware> = ami


// The family answer is the PUBLISHED default - which is what FactoryLogin's
// published_password field means - admin/admin being AMI's widely published MegaRAC
// default; the Foxconn Mt. Collins build observation (its bmc binding module) is
// corroboration, not the basis.
//
// THIS IS THE ONE CREDENTIAL A WORKFLOW TESTS, NOT THE FIRST OF SEVERAL
// (NO-FALLBACK-0). It used to read "the first credential to TRY", which describes an
// ordered search: try this, and on refusal try the next. There is no next. An ODM
// build may ship differently, and a refusal here is a TERMINAL, typed fact about
// this unit - the build shipped other credentials, or they have already been rotated
// - which ends the attempt and is carried by a workflow-layer intake receipt. It is
// neither an error to force past nor a cue to guess again: a second credential
// attempted after the first is refused is exactly the fallback this model exists to
// refuse, and it is also how a fleet locks itself out.
data megarac_factory_login: FactoryLogin = FactoryLogin {
  username: "admin",
  published_password: "admin",
}

// The family FLOOR: protocols guaranteed across MegaRAC builds. IPMI v2 lanplus
// (chassis, sensors, SEL, FRU, SOL, bootdev) is universal to the product line; Redfish
// is advertised by AMI but shipped per ODM build, so its presence is a BUILD-scoped
// observation carried on the build's binding module, never asserted or denied here.
// A Redfish-assuming workflow must read the build row or probe.
data megarac_supported_protocols_floor: List<BmcProtocol> = [Ipmi]

// ---------------------------------------------------------------------------------------------
// THE PROPRIETARY REST SURFACE (SP-X style), as executed. Session auth: POST /api/session
// with form-encoded username/password; the JSON reply carries CSRFToken, and every
// subsequent request presents the session cookie plus header X-CSRFTOKEN.
// ---------------------------------------------------------------------------------------------
type MegaRacApiOperation {
  http_method: NonEmptyStr
  path: NonEmptyStr
  contract_note: NonEmptyStr
}

data megarac_op_session_login: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/session",
  contract_note: "form-encoded username/password; reply JSON carries CSRFToken and privilege; subsequent calls send the session cookie and X-CSRFTOKEN header",
}

data megarac_op_media_config: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "PUT",
  path: "/api/settings/media/general",
  contract_note: "JSON body (GET answers the same object; member spellings as served by the Foxconn Mt. Collins build 0.32, 2026-09-27): remote_media_support:1, cd_remote_server_address, cd_remote_source_path, cd_remote_share_type nfs|cifs, mount_cd:1, plus cd_image_name, cd_error_code, rmedia_retry_count, rmedia_retry_interval and the hd_* counterparts; an rmedia daemon mounts on a retry interval (rmedia_retry_interval), so a mount can succeed seconds after the PUT that configured it",
}

data megarac_op_media_images: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "GET",
  path: "/api/settings/media/remote/images",
  contract_note: "lists image files visible on the mounted share; 'Could not mount the remote path' here means the rmedia daemon has not (yet) mounted - poll after the retry interval before concluding failure",
}

data megarac_op_media_start: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/settings/media/remote/start-media",
  contract_note: "JSON body MUST carry image_redirection:1 beside image_name, image_type (1 = CD) and image_index; without image_redirection the firmware refuses with opaque codes 13410/13460. Recovered from the firmware's own UI bundle (source.min.js), not from documentation. Success attaches a redirection session visible at /api/settings/media/remote/configurations (redirection_status started or connecting via megarac_redirection_status_of_wire, session_index bound)",
}

data megarac_op_media_stop: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "POST",
  path: "/api/settings/media/remote/stop-media",
  contract_note: "counterpart of start-media, same body shape; stopping a presented image re-enumerates the share, so a file published to the export after the mount is offered by /remote/images within one retry interval of the stop (Foxconn Mt. Collins build, 2026-09-27, host off; PUT media/general with mount_cd 0 then 1 was refused with code 16425 and changed nothing); a stop is established only by the configurations listing no longer presenting the image (this build has answered HTTP 500 code 1411 to a stop that took effect)",
}

data megarac_op_media_status: MegaRacApiOperation = MegaRacApiOperation {
  http_method: "GET",
  path: "/api/settings/media/remote/configurations",
  contract_note: "one row per media instance: media_type, image_name, session_index, redirection_status",
}

// THE EXECUTED HEADLESS BOOT-FROM-ISO SEQUENCE (Foxconn Mt. Collins build, 2026-08-29): export the
// ISO directory over NFS to the BMC address; PUT media config; wait for the daemon's own retry
// interval while the images listing goes from refusing to listing the image; POST start-media WITH
// image_redirection:1; ipmitool chassis bootdev cdrom then power reset. Execution receipts
// available without any screen: the NFS server's read counter (bulk reads then quiet = image
// loaded), the configurations row (redirection_status/session_index), and the boot CPU's power
// rails rising while the second socket idles.
//
// THE WAIT IS AN ASYNCHRONOUS PENDING STATE, NOT PERMISSION TO POLL UNTIL GREEN
// (NO-FALLBACK-1). Read as prose, "wait for the listing to change" and "keep asking until it
// agrees" are the same sentence, and only one of them is admissible. The bound, the terminal
// exits and the rule that no later observation overwrites a terminal one are modelled in
// gunbc.machine_intake_mount_establishment, which is where they belong: what our polling saw is
// a receipt of OUR attempt, never a fact this vendor module owns.
data megarac_api_operations: List<MegaRacApiOperation> = [
  megarac_op_session_login,
  megarac_op_media_config,
  megarac_op_media_images,
  megarac_op_media_start,
  megarac_op_media_stop,
  megarac_op_media_status,
]

// THE PARAMETER THE START-MEDIA CONTRACT CALLS REQUIRED, AS A TYPE. megarac_op_media_start
// says the body MUST carry image_redirection:1 or the firmware refuses with opaque codes;
// a profile for a MegaRAC build therefore carries this as a typed route fact, and a
// remote-media binding can only be constructed from the Enabled arm
// (extdeps.bmc.virtual_media MegaRacRemoteMediaParams.image_redirection).
type MegaRacImageRedirection
  = MegaRacImageRedirectionEnabled
  | MegaRacImageRedirectionUnset

type MegaRacImageRedirectionRequired
  = | MegaRacImageRedirectionOn

fn megarac_image_redirection_wire(r: MegaRacImageRedirectionRequired) -> NonEmptyStr {
  match r {
    MegaRacImageRedirectionOn => "1"
  }
}

// ---------------------------------------------------------------------------------------------
// SERVED SP-X UI SURFACE CATALOG, keyed to firmware identity 0.32. The capture receipt (path
// and digest) is gunbc.machine_intake_megarac_served_ui_catalog_observation; this module keeps
// only firmware-identity-keyed facts about that surface. The catalog is a FACT ABOUT THIS
// FIRMWARE'S SERVED UI PATHS, not a family-wide MegaRAC claim, and not a redirection_status map:
// AMI advertises Redfish on other builds; this surface does not carry it. Status-code meanings
// are a separate fact, cited on megarac_redirection_status_of_wire.
// ---------------------------------------------------------------------------------------------
data megarac_firmware_0_32: BmcFirmwareReleaseIdentity = bmc_firmware_release_identity_of_wire(
  family: AmiMegaRac,
  wire: "0.32",
)

// THE BMC IS THE NFS CLIENT. settings/media/general carries the NFS server, source path and
// share type; the host sees a virtual CD. PXE is not a term of this route. The required
// image_redirection fact is MegaRacImageRedirectionRequired / megarac_op_media_start.
// REDIRECTION_STATUS. The 255-path catalog does not contain these mappings. The codes that this
// decoder names are the ones committed observations actually returned on firmware 0.32:
// 0 stopped (gunbc.runner_host_media_independence_receipt mtcollins1_independence_evidence), 1 started
// and 100 connecting (gunbc.machine_intake_mtcollins1_diskless_boot_receipt
// mtcollins1_diskless_boot_artifact_path, and
// gunbc.machine_intake_mtcollins1_memory_census_observation mtcollins1_media_redirection_samples).
// Connecting is presenting: the same unit booted GRUB from a session that still read 100.
// Any other numeric code on a catalogued firmware is an uncatalogued wire, not a named denial
// recovered from source.min.js (those bytes are not in the tree). A firmware identity this row
// does not catalog refuses rather than inheriting 0.32's numbers.
type MegaRacRedirectionStatus
  = RedirectionStopped
  | RedirectionStartedConnectionAccepted
  | RedirectionConnecting
  | RedirectionWireUncatalogued { wire: Int }

type MegaRacRedirectionStatusLookup
  = RedirectionStatusKnown { firmware: BmcFirmwareReleaseIdentity, status: MegaRacRedirectionStatus }
  | RedirectionStatusFirmwareUncatalogued { firmware: BmcFirmwareReleaseIdentity, wire: Int }

fn megarac_redirection_status_of_wire(
  firmware: BmcFirmwareReleaseIdentity,
  wire: Int,
) -> MegaRacRedirectionStatusLookup {
  if bmc_firmware_release_identity_eq(a: firmware, b: megarac_firmware_0_32) {
    let status = if wire == 0 {
      RedirectionStopped
    } else if wire == 1 {
      RedirectionStartedConnectionAccepted
    } else if wire == 100 {
      RedirectionConnecting
    } else {
      RedirectionWireUncatalogued { wire: wire }
    }
    RedirectionStatusKnown { firmware: firmware, status: status }
  } else {
    RedirectionStatusFirmwareUncatalogued { firmware: firmware, wire: wire }
  }
}

// A SESSION IS PRESENTING MEDIA ONLY WHILE STARTED OR CONNECTING. Stopped is known not
// presenting. Uncatalogued firmware and uncatalogued wire are not "not presenting": they are
// unread, and a Bool false here would license StartMedia.
type MegaRacRedirectionPresentationStanding
  = RedirectionPresenting
  | RedirectionKnownStopped
  | RedirectionPresentationUnknown

fn megarac_redirection_presentation_standing(
  lookup: MegaRacRedirectionStatusLookup,
) -> MegaRacRedirectionPresentationStanding {
  match lookup {
    RedirectionStatusFirmwareUncatalogued { firmware: _, wire: _ } => RedirectionPresentationUnknown
    RedirectionStatusKnown { firmware: _, status: status } =>
      match status {
        RedirectionStartedConnectionAccepted => RedirectionPresenting
        RedirectionConnecting => RedirectionPresenting
        RedirectionStopped => RedirectionKnownStopped
        RedirectionWireUncatalogued { wire: _ } => RedirectionPresentationUnknown
      }
  }
}

// CONSOLE RECORDERS. Two recorders, two subjects. video/* records the framebuffer the KVM
// renders; sol-triggers records the SOL stream. Both persist across resets. The SOL object's
// chassis-power-on field is spelled chasis_power_on_events_enable (upstream typo); the video
// object spells chassis_power_on_events_enable. Model what upstream sends.
//
// §3c frontier: megarac_recorder_trigger_power_on_field, megarac_trigger_power_on_field_wire,
// megarac_recorder_reset_survival, and the four data rows they bind. Consumer: the PreOs
// console-recorder / live-SOL axis in gunbc.machine_intake_pre_os_observation_capabilities on
// gunbc#11110 (this PR does not mint that file). Until that lands, an arming PUT cannot be keyed
// to the subject's wire spelling, and live sol activate cannot be distinguished from a recorder
// that survives reset.
type MegaRacConsoleRecorderSubject
  = FramebufferRecorder
  | SolStreamRecorder

type MegaRacTriggerPowerOnFieldName
  = ChassisPowerOnEventsEnable
  | ChasisPowerOnEventsEnable

fn megarac_recorder_trigger_power_on_field(subject: MegaRacConsoleRecorderSubject) -> MegaRacTriggerPowerOnFieldName {
  match subject {
    FramebufferRecorder => ChassisPowerOnEventsEnable
    SolStreamRecorder => ChasisPowerOnEventsEnable
  }
}

data megarac_video_trigger_power_on_field: MegaRacTriggerPowerOnFieldName = megarac_recorder_trigger_power_on_field(subject: FramebufferRecorder)

data megarac_sol_trigger_power_on_field: MegaRacTriggerPowerOnFieldName = megarac_recorder_trigger_power_on_field(subject: SolStreamRecorder)

fn megarac_trigger_power_on_field_wire(name: MegaRacTriggerPowerOnFieldName) -> NonEmptyStr {
  match name {
    ChassisPowerOnEventsEnable => "chassis_power_on_events_enable" as NonEmptyStr
    ChasisPowerOnEventsEnable => "chasis_power_on_events_enable" as NonEmptyStr
  }
}

type MegaRacResetSurvival
  = SurvivesHostAndControllerReset
  | DiesOnReset

fn megarac_recorder_reset_survival(subject: MegaRacConsoleRecorderSubject) -> MegaRacResetSurvival {
  match subject {
    FramebufferRecorder => SurvivesHostAndControllerReset
    SolStreamRecorder => SurvivesHostAndControllerReset
  }
}

data megarac_framebuffer_recorder_reset_survival: MegaRacResetSurvival = megarac_recorder_reset_survival(subject: FramebufferRecorder)

data megarac_sol_recorder_reset_survival: MegaRacResetSurvival = megarac_recorder_reset_survival(subject: SolStreamRecorder)

data megarac_live_sol_activate_reset_survival: MegaRacResetSurvival = DiesOnReset

// WHAT THIS SERVED UI CAN AND CANNOT DO, as PATH PRESENCE in the 0.32 catalog. They are not
// omissions and not unit telemetry. Per-DIMM AEP inventory and api/fru ARE in the catalog
// (api/aep_inventory/aep_dimm_info, api/fru); a controller answering nothing through those paths
// is a unit observation, not a served-surface absence. BIOS *settings* (`settings/bios`) are
// absent; flash/version (`api/maintenance/hpm/getbiosversions`) is present. MegaRacWebEventLogOemDescriptionUnknown
// was the same fork: the renderer answering unknown is not a missing path. Ampere OEM SEL
// producer layout is extdeps.ampere.oem_sel.
//
// §3c frontier: megarac_served_ui_surface_standing. Consumer: the PreOs capability axes that
// would claim Redfish or a BIOS/UEFI settings surface, on
// gunbc.machine_intake_pre_os_observation_capabilities (gunbc#11110; this PR does not mint that
// file). Until that lands, a firmware this decoder does not catalog cannot refuse an inherited
// 0.32 presence map. The coproduct carries present surfaces so Absent is not the only
// constructible known answer: a Bool that can only be true is a decoration.
type MegaRacServedUiSurface
  = RedfishService
  | BiosUefiSettings
  | FruInventory
  | AepDimmInventory
  | BiosVersionFlash

type MegaRacServedUiSurfacePresence
  = ServedUiSurfacePresent
  | ServedUiSurfaceAbsent

// THE CATALOG SUBSTRING EACH SURFACE IS NAMED BY. The presence map below is a transcription of the
// 0.32 served-UI catalog (gunbc.machine_intake_megarac_served_ui_catalog_observation, hashed and
// committed); this row is the join that makes it checkable against the bytes rather than a second
// authored list beside them (review 66694): the integrity witness asks, for every surface, that
// the catalog contains the substring exactly when the map says Present.
fn megarac_served_ui_surface_catalog_token(surface: MegaRacServedUiSurface) -> NonEmptyStr {
  match surface {
    RedfishService => "redfish"
    BiosUefiSettings => "settings/bios"
    FruInventory => "api/fru"
    AepDimmInventory => "api/aep_inventory/aep_dimm_info"
    BiosVersionFlash => "api/maintenance/hpm/getbiosversions"
  }
}

data megarac_served_ui_surfaces: List<MegaRacServedUiSurface> = [RedfishService, BiosUefiSettings, FruInventory, AepDimmInventory, BiosVersionFlash]

fn megarac_served_ui_surface_presence_at_0_32(surface: MegaRacServedUiSurface) -> MegaRacServedUiSurfacePresence {
  match surface {
    RedfishService => ServedUiSurfaceAbsent
    BiosUefiSettings => ServedUiSurfaceAbsent
    FruInventory => ServedUiSurfacePresent
    AepDimmInventory => ServedUiSurfacePresent
    BiosVersionFlash => ServedUiSurfacePresent
  }
}

type MegaRacServedUiFactLookup
  = ServedUiFactKnown { firmware: BmcFirmwareReleaseIdentity, presence: MegaRacServedUiSurfacePresence }
  | ServedUiFactFirmwareUncatalogued { firmware: BmcFirmwareReleaseIdentity }

fn megarac_served_ui_surface_standing(
  firmware: BmcFirmwareReleaseIdentity,
  surface: MegaRacServedUiSurface,
) -> MegaRacServedUiFactLookup {
  if bmc_firmware_release_identity_eq(a: firmware, b: megarac_firmware_0_32) {
    ServedUiFactKnown {
      firmware: firmware,
      presence: megarac_served_ui_surface_presence_at_0_32(surface: surface),
    }
  } else {
    ServedUiFactFirmwareUncatalogued { firmware: firmware }
  }
}

// SCREEN CAPTURE SURFACES AT 0.32. Read-only probe 2026-09-27 of the bundles served at
// https://192.168.1.228/source.min.js (gzip, sha256 5029fae278f7fc8f4dd4ad5eb8e4457e49fa25d4d0158d4bf9fbab09f57d4bf3)
// and /viewer.min.js (sha256 8bdfbb72c6449eaf64ab232a413abe257c2eec5af5d46fbe960c14534fab3e17).
// THERE IS NO SERVER-SIDE ON-DEMAND STILL. The H5 viewer's "Capture Screen" is captureScreen():
// document.getElementById("kvm").toDataURL("image/jpeg") saved as CaptureScreen.jpeg. That is a canvas
// the browser painted by decoding the AST2100 stream from wss://<bmc>/kvm (session token from
// /api/kvm/token), so a still exists only where a KVM client is running. The firmware itself
// keeps two retained screens: the last BSOD JPEG (feature CAPTURE_BSOD_JPEG, GET
// /api/settings/download_image), and framebuffer recordings made by FramebufferRecorder when an
// armed /api/settings/video/triggers event fires (chassis power on/off/reset, lpc reset, watchdog,
// critical/non-critical/non-recoverable, fan state, or a date_time schedule), listed at
// /api/logs/video with bytes at /api/logs/video-data?file=. No IPMI OEM capture command appears
// in either bundle.
type MegaRacScreenCaptureRoute
  = KvmClientCanvasJpeg
  | LastBsodJpeg
  | TriggeredFramebufferRecording
  | ServerSideOnDemandStill

type MegaRacScreenCaptureStanding
  = ScreenCaptureServedOnDemand
  | ScreenCaptureEventRetainedOnly
  | ScreenCaptureClientSideOnly
  | ScreenCaptureAbsent

fn megarac_screen_capture_standing_at_0_32(route: MegaRacScreenCaptureRoute) -> MegaRacScreenCaptureStanding {
  match route {
    KvmClientCanvasJpeg => ScreenCaptureClientSideOnly
    LastBsodJpeg => ScreenCaptureEventRetainedOnly
    TriggeredFramebufferRecording => ScreenCaptureEventRetainedOnly
    ServerSideOnDemandStill => ScreenCaptureAbsent
  }
}

type MegaRacScreenCaptureLookup
  = ScreenCaptureFactKnown { firmware: BmcFirmwareReleaseIdentity, standing: MegaRacScreenCaptureStanding }
  | ScreenCaptureFirmwareUncatalogued { firmware: BmcFirmwareReleaseIdentity }

fn megarac_screen_capture_standing(
  firmware: BmcFirmwareReleaseIdentity,
  route: MegaRacScreenCaptureRoute,
) -> MegaRacScreenCaptureLookup {
  if bmc_firmware_release_identity_eq(a: firmware, b: megarac_firmware_0_32) {
    ScreenCaptureFactKnown { firmware: firmware, standing: megarac_screen_capture_standing_at_0_32(route: route) }
  } else {
    ScreenCaptureFirmwareUncatalogued { firmware: firmware }
  }
}

// EVENT LOG SHAPE. The web log and ipmitool are two layouts. GenID1/GenID2 on the standard-event
// template are manufacturer bytes; they have no Sender constructor. Ampere's published producer
// layout for those manufacturer bytes is extdeps.ampere.oem_sel.
//
// §3c frontier: megarac_web_event_log_layout and megarac_ipmi_sel_layout. Consumer: the PreOs
// OEM-decode / SEL axis in gunbc.machine_intake_pre_os_observation_capabilities on gunbc#11110
// (this PR does not mint that file). Until that lands, a web-log empty SelData row cannot be
// refused as a preserved IPMI payload, and the two layouts remain unjoined to a decoder.
type MegaRacEventLogLayout
  = MegaRacWebEventLogOemEmptySelData
  | MegaRacIpmiSelPayloadPreserved

data megarac_web_event_log_layout: MegaRacEventLogLayout = MegaRacWebEventLogOemEmptySelData

data megarac_ipmi_sel_layout: MegaRacEventLogLayout = MegaRacIpmiSelPayloadPreserved

// THE WEB SESSION AND KVM VIEWER WIRE, AS THE 0.32 UI READS IT. Recovered from the bundles served at
// https://192.168.1.228 on 2026-09-27 (source.min.js, gzip sha256
// 5029fae278f7fc8f4dd4ad5eb8e4457e49fa25d4d0158d4bf9fbab09f57d4bf3; viewer.min.js sha256
// 8bdfbb72c6449eaf64ab232a413abe257c2eec5af5d46fbe960c14534fab3e17):
// - POST /api/session (form fields username, password) answers JSON; the login handler treats
//   `ok === 0` as success and reads CSRFToken, privilege, extendedpriv and racsession_id from it, then
//   sends X-CSRFTOKEN on every later request.
// - GET /api/settings/services answers a JSON list of service rows; the KVM launcher finds the row
//   whose service_name is "kvm" and opens viewer.html only when its viewer_count is 0.
// - DELETE /api/session (X-CSRFTOKEN) ends the session (the viewer's own logout).
// - The H5 viewer opens a WebSocket at /kvm (subprotocols binary, base64) and paints canvas#kvm.
// A REFUSED LOGIN'S BODY AND STATUS ON 0.32 HAVE NOT BEEN CAPTURED, so this module states none: what
// the UI establishes is only that a reply without ok === 0 is not a session. A simulated controller's
// refusal is its renderer's choice (gunbc.bmc_megarac_web_adapter), never this upstream's.
// These are the fields the UI reads, not the whole reply: a reply may carry more.
data megarac_kvm_websocket_path: NonEmptyStr = "/kvm"

type MegaRacLoginSession {
  csrf_token: String
  privilege: Int
  extended_privilege: Int
  racsession_id: Int
}

fn megarac_login_session_json(session: MegaRacLoginSession) -> JsonValue {
  json_object(members: [
    json_kv(key: "ok", value: json_int(n: 0)),
    json_kv(key: "CSRFToken", value: json_string(s: session.csrf_token)),
    json_kv(key: "privilege", value: json_int(n: session.privilege)),
    json_kv(key: "extendedpriv", value: json_int(n: session.extended_privilege)),
    json_kv(key: "racsession_id", value: json_int(n: session.racsession_id)),
  ])
}

fn megarac_services_kvm_json(viewer_count: Int) -> JsonValue {
  json_array(elements: [json_object(members: [
    json_kv(key: "service_name", value: json_string(s: "kvm")),
    json_kv(key: "viewer_count", value: json_int(n: viewer_count)),
  ])])
}

// THE OPERATIONS ABOVE ARE A DESCRIPTION; THESE ARE THE OPERATIONS. megarac_api_operations records
// paths and contract notes and carries no transport, so nothing in this repository could invoke the
// MegaRAC media surface — the first attach against a Mt. Collins unit was therefore driven by a
// hand-written shell script, which is exactly the unmodeled realization DESIGN §6 names. These rows
// make that surface reachable from a workflow.
//
// SESSION AUTH IS COOKIE-AND-HEADER, NOT netrc, which is why these cannot reuse the redfish.Http
// shape beside them. POST /api/session returns a CSRFToken in its body and sets a session cookie;
// every subsequent request must present BOTH the cookie jar and an X-CSRFTOKEN header.
//
// THE JAR PATH BEING A PARAMETER DOES NOT MAKE AN ATTEMPT OWN ITS JAR, and an earlier revision of
// this note claimed it did. A parameter permits a per-attempt path; it does not require one, and
// the first production caller passed a fixed literal — so two concurrent attempts shared one bearer
// file, which is the opposite of what the note asserted. Ownership is a property of the CALLER's
// allocation, and the caller is where it has to be established.
//
// A SESSION THAT IS NEVER CLOSED IS A LEAKED REMOTE RESOURCE. CloseSession exists because the
// controller's session table is finite and this lane exhausted a service's sessions by opening one
// per probe and closing none. Every operation sequence that opens a session owes a close on every
// exit, including refusals — an operation that failed still allocated the session that carried it.
//
// EVERY CALL IS BOUNDED BY ITS CALLER'S max_time, WRITES INCLUDED (side-chat review 5331991982). A
// write that runs out of time has an UNCERTAIN effect -- the controller may have applied it -- so the
// writes also return curl's exit code as a typed value (22: --fail-with-body received a complete HTTP
// error response; 28: timed out; others: transport) and its stderr, and the caller keeps that answer
// rather than reading a missing HTTP answer as a refusal.
//
// THE CREDENTIAL IS READ FROM A CALLER FILE ON OpenSession AND NOWHERE ELSE. curl --data-urlencode
// password@FILE keeps the secret out of argv; every later call carries only the cookie. THE FILE IS
// THE PASSWORD BYTES EXACTLY: curl(1) documents name@file as URL-encoding the file's content
// INCLUDING any newline, so a file ending in \n posts password=...%0A and the controller refuses the
// login as a wrong password with no hint (review 68456). The caller's prelude writes the Secret
// Manager payload bytes verbatim (base64-decoded, no trailer), so the contract lives on the stored
// payload: it is minted without a trailing newline, and boot 22 (run 35447067113) is the executed
// positive control that the stored bytes log in.
//
// StartMedia's json_body MUST CARRY image_redirection AND ITS ABSENCE IS OPAQUE. The contract note
// on the operation row above records that omitting it makes the firmware refuse with codes
// 13410/13460, recovered from the firmware's own UI bundle rather than from documentation. The body
// is a caller parameter rather than a baked literal because image_index is resolved by READING the
// images listing, never assumed, and megarac_image_redirection_wire is the authority for the field
// itself.
service megarac.Media {

  operation OpenSession {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password_file: NonEmptyStr, cookie_jar: NonEmptyStr, max_time: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--max-time", "{max_time}", "-c", "{cookie_jar}", "-X", "POST", "--data-urlencode", "username={username}", "--data-urlencode", "password@{password_file}", "https://{bmc_host}/api/session"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac session POST failed"
    }
  }

  operation ProbeSessionOnMediaRoute {
    requires Network
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr, max_time: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--max-time", "{max_time}", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}", "-w", "\\n%\{http_code}", "https://{bmc_host}/api/settings/media/remote/configurations"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac session probe on the media route failed"
    }
  }

  operation GetMediaGeneral {
    requires Network
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr, max_time: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}", "--max-time", "{max_time}", "https://{bmc_host}/api/settings/media/general"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac media general GET failed"
    }
  }

  operation GetRemoteImages {
    requires Network
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr, max_time: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}", "--max-time", "{max_time}", "https://{bmc_host}/api/settings/media/remote/images"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac remote images GET failed"
    }
  }

  operation GetRemoteConfigurations {
    requires Network
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr, max_time: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}", "--max-time", "{max_time}", "https://{bmc_host}/api/settings/media/remote/configurations"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac remote configurations GET failed"
    }
  }

  operation StartMedia {
    requires Network
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr, json_body: NonEmptyStr, max_time: NonEmptyStr }
    output { body: String from "stdout", stderr: String from "stderr", exit_code: Int from "exit_code", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--max-time", "{max_time}", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}", "-H", "Content-Type: application/json", "-X", "POST", "-d", "{json_body}", "https://{bmc_host}/api/settings/media/remote/start-media"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac start-media POST failed"
    }
  }

  operation StopMedia {
    requires Network
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr, json_body: NonEmptyStr, max_time: NonEmptyStr }
    output { body: String from "stdout", stderr: String from "stderr", exit_code: Int from "exit_code", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--max-time", "{max_time}", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}", "-H", "Content-Type: application/json", "-X", "POST", "-d", "{json_body}", "https://{bmc_host}/api/settings/media/remote/stop-media"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac stop-media POST failed"
    }
  }

  operation CloseSession {
    requires Network
    input { bmc_host: NonEmptyStr, cookie_jar: NonEmptyStr, csrf_token: NonEmptyStr, max_time: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--max-time", "{max_time}", "-b", "{cookie_jar}", "-H", "X-CSRFTOKEN: {csrf_token}", "-X", "DELETE", "https://{bmc_host}/api/session"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac session DELETE failed"
    }
  }
}

// THE VALUE THE SP-X UI STORES AS sessionStorage "features": JSON.stringify of its project-configurations
// collection, an array of {"feature": NAME} objects; the viewer's KVM view reads it with unguarded
// indexOf calls. Which names a given build carries is an OBSERVATION this repository made of that
// build's served bundle, so it is a receipt in the observing layer
// (gunbc.machine_intake_megarac_ui_features megarac_ui_features_0_32_receipt), not a fact owned here.
fn megarac_ui_features_json(names: List<NonEmptyStr>) -> String {
  serialize_json_array(elements: map(names, n => json_object(members: [json_kv(key: "feature", value: json_string(s: n as String))])))
}

// THE FIRMWARE'S OWN UI BUNDLE, SERVED AT A FIXED PATH. The SP-X web UI is one minified bundle the
// login page loads before any session exists, so the GET carries no cookie and no token and opens no
// session to release. The codes this module cites as "recovered from source.min.js" (start-media's
// 13410/13460, the served api/ surface, the KVM wire) were read from these bytes; the operation is the
// route that re-reads them instead of a hand-run probe.
//
// THE BYTES ARE WRITTEN AS SERVED. `Accept-Encoding: gzip` without --compressed asks for the encoding
// the 2026-09-27 read recorded (gzip) and leaves it undecoded, so a digest of dest_file is a digest of
// the served bytes, comparable with that read. stdout carries only the write-out: the HTTP status and
// the byte count, space-separated on one line.
data megarac_ui_bundle_path: NonEmptyStr = "/source.min.js"

service megarac.Ui {

  operation GetServedBundle {
    requires Network
    input { bmc_host: NonEmptyStr, bundle_path: NonEmptyStr, dest_file: NonEmptyStr, max_time: NonEmptyStr }
    output { writeout: String from "stdout", stderr: String from "stderr", exit_code: Int from "exit_code", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--max-time", "{max_time}", "-H", "Accept-Encoding: gzip", "-o", "{dest_file}", "-w", "%\{http_code} %\{size_download}", "https://{bmc_host}{bundle_path}"]
    }
    exit {
      0 => Unit
      nonzero => String "megarac UI bundle GET failed"
    }
  }
}
