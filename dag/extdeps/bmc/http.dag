module extdeps.bmc.http

import extdeps.external_authority { ExternalAuthority }
import extdeps.transports.rest { RestOutcome }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.disposition { Disposition, RealizationDispatch, Scaffold }
import std.types { Bool, NonEmptyStr, String }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.dmtf.org/standards/redfish"
  }
}

data redfish_http_hardwired_transport_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.bmc.http",
    decl_name: "redfish.Http",
    field: WholeDeclaration
  }
}

data redfish_http_hardwired_transport_note: String = "§3(b) declared debt, SHRINKING: GetSystem (2026-09-03) is a declarative transport rest row — auth_netrc + InsecureAcceptAnyCert + modeled success — realized by the shared HTTP-client machinery; the remaining operations below still re-spell the shell/curl transport handler per row (the hardwired-single-transport trap; the DMTF-owned interface facts are only the method x path x auth-mode axes). The note dissolves when every operation is a declarative transport row — the remaining rows need the same three axes GetSystem now carries (netrc/basic auth, insecure-TLS, request-body-from-file) plus, for the mutating ops, the inline body record or a body-from-file axis. Until then the argv rows stay — live BMC consumers (bmc_onboard*, bmc_read_telemetry, bmc_first_contact, srv3_boot_once_cd) execute them as-is."

// LOAD-BEARING: success:Bool derives from exit_success, so curl MUST fail-close on HTTP status.
// Every argv carries --fail-with-body (curl >=7.76). WITHOUT it curl exits 0 on 401/403/404/5xx and
// `success` reads a rejected auth or a missing resource as TRUE — a §5 fail-open: a factory-401
// misreads as FactoryCredentialActive (so an already-rotated BMC gets re-rotated), and a rotation
// PATCH that 401s reports rotated while changing nothing (the 'secret populated, server never
// rotated' state). --fail-with-body (not bare --fail) keeps the OpenBMC error body in `body` for
// diagnosis (e.g. PropertyValueFormatError on a rejected password). Do not drop the flag; a new
// redfish op without it re-opens the arm. Found by execution against srv4 2026-07-23.

// EVERY REDFISH OPERATION AUTHENTICATES BY FILE, AND THE ABSENCE OF `Secret` IN THIS MODULE'S
// IMPORTS IS THE RECEIPT. GetSystem, GetPower and GetThermal each declared `password: Secret` and
// interpolated it into an argv token -- `-u {username}:{password}` -- so the credential became a
// word in curl's command line. On the fleet hosts that is a real exposure: /proc is mounted with no
// hidepid, /proc/PID/cmdline is mode 0444, and the CI runner slots are ordinary host systemd
// services sharing the host pid namespace, so any job payload reads it with an unprivileged ps.
// bmc_onboard called GetSystem with the FRESHLY ROTATED password, putting the new credential in
// argv at the moment the old one was retired.
//
// THIS WAS A HALF-FINISHED REPLACEMENT MIGRATION, NOT A NEW DISCOVERY. Every MUTATING operation
// already used --netrc-file, and a GetSystemWithNetrc sat beside the leaking GetSystem answering
// the identical question. The correct shape was present and understood; the leak stayed alive
// because the old form was left standing instead of cut at the root. While X stands, callers keep
// reaching for it -- five call sites did.
//
// The cut is at the root: the three argv-borne arms are DELETED, not deprecated, and
// GetSystemWithNetrc is deleted too because once GetSystem takes no password the `WithNetrc` suffix
// distinguishes nothing and is a second name for one concept. One operation per resource,
// authenticating one way. A future operation cannot reintroduce the class by copying a neighbour,
// because no neighbour spells it.
//
// WHAT THIS DOES NOT CLAIM: the module is clean by CONSTRUCTION nowhere. Nothing refuses a new
// `password: Secret` interpolated into an argv token -- v2.std.operation_argv's binding wall
// refuses undeclared names and a non-literal executable position, but ShellTransportOperationRow
// carries declared_inputs as a List<String>, names without types, so the binder cannot see that an
// input is Secret. That missing declared-input TYPE on the row is this class's next-rung trigger;
// until it lands the class sits at mitigatable and this note is diligence.
service redfish.Http {

  // Empty base + absolute-form path templates: the bmc_host is a per-call input, so each op's
  // path carries the full https://{bmc_host}/... target (extdeps.transports.rest RestTargetForm
  // AbsoluteFormTarget; the interp/emit concat base_url + path is the current realization).
  config {
    endpoint: ""
  }

  operation GetServiceRoot {
    input { bmc_host: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "https://{bmc_host}/redfish/v1"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish service root GET failed"
    }
  }

  // LANE A MIGRATION (transport_argv_anemia_dissolution): GetSystem is a declarative
  // transport rest row. The curl argv is derived by the realization — the success flag is a
  // modeled response block (grounded 2xx), never a hand-typed `--fail-with-body`; auth is
  // netrc-file via `auth_netrc` (the credential never touches argv); TLS is the modeled
  // InsecureAcceptAnyCert posture for the fleet's self-signed BMC certs. The interpreter
  // realizes the posture through the accept-any agent (see v1_interpreter
  // RestAcceptAnyVerifier); consumers read `outcome` for graceful failure (RestStatusRefused
  // carries the OpenBMC error body), which is what bmc_onboard's credential probe requires.
  operation GetSystem {
    input { bmc_host: NonEmptyStr, netrc_file: NonEmptyStr }
    output { body: String, outcome: RestOutcome }
    readonly
    transport rest {
      method: GET,
      path: "https://{bmc_host}/redfish/v1/Systems/system",
      tls: InsecureAcceptAnyCert,
      auth_netrc: { file: netrc_file },
      response_format: Text
    }
    response {
      200 => String
      401 => String
      403 => String
      404 => String
      5xx => String
    }
  }

  operation GetChassisSensors {
    input { bmc_host: NonEmptyStr, chassis_id: NonEmptyStr, netrc_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--netrc-file", "{netrc_file}", "https://{bmc_host}/redfish/v1/Chassis/{chassis_id}/Sensors"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish chassis sensors GET failed"
    }
  }

  operation GetPower {
    input { bmc_host: NonEmptyStr, netrc_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--netrc-file", "{netrc_file}", "https://{bmc_host}/redfish/v1/Chassis/Self/Power"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish power GET failed"
    }
  }

  operation GetThermal {
    input { bmc_host: NonEmptyStr, netrc_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--netrc-file", "{netrc_file}", "https://{bmc_host}/redfish/v1/Chassis/Self/Thermal"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish thermal GET failed"
    }
  }

  operation SetAccountPassword {
    input { bmc_host: NonEmptyStr, netrc_file: NonEmptyStr, account_id: NonEmptyStr, request_body_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--netrc-file", "{netrc_file}", "-X", "PATCH", "-H", "Content-Type: application/json", "--data", "@{request_body_file}", "https://{bmc_host}/redfish/v1/AccountService/Accounts/{account_id}"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish account password PATCH failed"
    }
  }

  operation SetBootSourceOverride {
    input { bmc_host: NonEmptyStr, netrc_file: NonEmptyStr, system_id: NonEmptyStr, request_body_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--netrc-file", "{netrc_file}", "-X", "PATCH", "-H", "Content-Type: application/json", "--data", "@{request_body_file}", "https://{bmc_host}/redfish/v1/Systems/{system_id}"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish boot source override PATCH failed"
    }
  }

  operation ResetSystem {
    input { bmc_host: NonEmptyStr, netrc_file: NonEmptyStr, system_id: NonEmptyStr, request_body_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "-k", "--netrc-file", "{netrc_file}", "-X", "POST", "-H", "Content-Type: application/json", "--data", "@{request_body_file}", "https://{bmc_host}/redfish/v1/Systems/{system_id}/Actions/ComputerSystem.Reset"]
    }
    exit {
      0 => Unit
      nonzero => String "redfish system reset POST failed"
    }
  }
}
