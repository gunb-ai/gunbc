module extdeps.bmc.http
import std.resources { Network }

import std.types { Bool, Int, List, NonEmptyStr, Secret, String }
import std.measure { Second, second_count }

data openbmc_factory_login_username: NonEmptyStr = "root"
data openbmc_factory_login_published_password: String = "0penBmc#"
data asrock_altrad8ud_redfish_chassis_id: NonEmptyStr = "Self"
data asrock_altrad8ud_redfish_system_id: NonEmptyStr = "system"
data bmc_onboard_netrc_path: NonEmptyStr = "/run/bmc/srv4.netrc"
data bmc_onboard_pwbody_path: NonEmptyStr = "/run/bmc/pwbody.json"
data bmc_onboard_patchbody_path: NonEmptyStr = "/run/bmc/patchbody.json"
data bmc_onboard_resetbody_path: NonEmptyStr = "/run/bmc/resetbody.json"
data bmc_health_reader_body_path: FilePath = "/run/bmc/reader_body.json"
data bmc_health_reader_username: NonEmptyStr = "gunbc-reader"

data redfish_reset_type_wire: String = "ForceRestart"

fn netrc_write_succeeded(outcome: NetrcWriteOutcome) -> Bool {
  match outcome {
    NetrcWriteSucceeded => true
    NetrcWriteRefused { cause: _ } => false
  }
}

fn netrc_failure_reason(outcome: NetrcWriteOutcome, stage: String) -> String {
  match outcome {
    NetrcWriteRefused { cause: c } => concat("netrc write refused at ", stage, ": ", c)
    NetrcWriteSucceeded => "netrc write succeeded (unexpected query)"
  }
}

fn write_netrc_outcome(host: String, account: String, password: String) -> NetrcWriteOutcome {
  let netrc = join(["machine ", host, " login ", account, " password ", password], "")
  let w = Filesystem.WriteOwnerOnly(path: bmc_onboard_netrc_path, content: netrc)
  if w.success { NetrcWriteSucceeded } else { NetrcWriteRefused { cause: w.error } }
}

// LOAD-BEARING: success:Bool derives from exit_success, so curl MUST fail-close on HTTP status.
// Authenticated resource ops carry --fail-with-body (curl >=7.76). WITHOUT it curl exits 0 on
// 401/403/404/5xx and `success` reads a rejected auth or a missing resource as TRUE — a §5
// fail-open: a factory-401 misreads as FactoryCredentialActive (so an already-rotated BMC gets
// re-rotated), and a rotation PATCH that 401s reports rotated while changing nothing (the
// 'secret populated, server never rotated' state). --fail-with-body (not bare --fail) keeps the
// OpenBMC error body in `body` for diagnosis (e.g. PropertyValueFormatError on a rejected
// password). Do not drop the flag on those ops; a new authenticated redfish op without it
// re-opens the arm. Found by execution against srv4 2026-07-23.
//
// ONE ADMITTED EXCEPTION: ProbeServiceRoot. HTTP status is the observation, so the argv omits
// --fail-with-body and takes write_out so the caller binds a classified three-digit code. curl
// still fails closed on an unreachable host. A new op may omit the flag only when status is the
// consumed answer in that same shape, never because a caller would rather treat 404 as success.
//
// EVERY REDFISH OPERATION AUTHENTICATES BY FILE, AND THE ABSENCE OF `Secret` IN THIS MODULE'S
// IMPORTS IS THE RECEIPT. GetSystem, GetPower and GetThermal each declared `password: Secret` and
// interpolated it into an argv token -- `-u {username}:{password}` -- so the credential became a
// word in curl's command line. On the fleet hosts that is a real exposure: /proc is mounted with no
// hidepid, /proc/PID/cmdline is mode 0444, and the CI runner slots are ordinary host systemd
// services sharing the host pid namespace, so any job payload reads it with an unprivileged ps.
// bmc_onboard called GetSystem with the FRESHLY ROTATED password, putting the new credential in
// argv at the moment the old one was retired.
//
// THIS WAS A HALF-FINISHED REPLACEMENT MIGRATION, NOT A NEW DISCOVERY. Every MUTATING operation
// already used --netrc-file, and a GetSystemWithNetrc sat beside the leaking GetSystem answering
// the identical question. The correct shape was present and understood; the leak stayed alive
// because the old form was left standing instead of cut at the root. While X stands, callers keep
// reaching for it -- five call sites did.
//
// The cut is at the root: the three argv-borne arms are DELETED, not deprecated, and
// GetSystemWithNetrc is deleted too because once GetSystem takes no password the `WithNetrc` suffix
// distinguishes nothing and is a second name for one concept. One operation per resource,
// authenticating one way. A future operation cannot reintroduce the class by copying a neighbour,
// because no neighbour spells it.
//
// WHAT THIS DOES NOT CLAIM: the module is clean by CONSTRUCTION nowhere. Nothing refuses a new
// `password: Secret` interpolated into an argv token -- v2.std.operation_argv's binding wall
// refuses undeclared names and a non-literal executable position, but ShellTransportOperationRow
// carries declared_inputs as a List<String>, names without types, so the binder cannot see that an
// input is Secret. That missing declared-input TYPE on the row is this class's next-rung trigger;
// until it lands the class sits at mitigatable and this note is diligence.
//
// ABOUT ProbeServiceRoot BELOW. This note sits at module grain because the parser models only
// module-item annotations: a // block inside the service body is a located parse refusal
// ("source annotation sits inside a declaration body"), which is how this was found.
// UNAUTHENTICATED DISCOVERY, AND HTTP STATUS IS THE ANSWER. GetServiceRoot uses --fail-with-body,
// so a 404 (Collins: no Redfish) is a failed ProcessExit and cannot be stored as a first-contact
// observation. This probe keeps the body on stdout and takes write_out as an input so the caller
// binds curl_http_code_after_newline_write_out_format (newline then three-digit code). curl still
// fails closed on an unreachable host. It does not authenticate and does not identify MegaRAC
// versus OpenBMC — Redfish presence is a surface, not a family. IT IS THE ONE OPERATION HERE THAT
// BINDS stderr: -sS keeps curl's transport error there while stdout holds only the write-out, so
// on an unreachable host stdout is "\n000" and stderr is the only text naming the cause. A caller
// that refuses on this op must refuse with stderr; refusing with the stdout blob refuses with
// "\n000", which is typed but locates nothing.
// GetResourceByPath IS THE ONE READ THAT FOLLOWS A LINK THE SERVICE PUBLISHED. DSP0266 makes a
// resource's `@odata.id` and a collection's `Members@odata.nextLink` URIs the client follows as
// given, so the path is an input carried exactly, never assembled from an Id; its consumer
// (gunbc.machine_intake_mtcollins1_boot_diagnostic_bundle) admits only same-origin /redfish/v1/
// paths before calling it, because the request presents a credential. It binds stderr and
// exit_code beside the body because curl exit 7 (connection refused or unreachable), 28
// (timeout) and 22 with "error: 401" (authentication refused) are different diagnoses, and it
// takes --max-time as an input so the caller's deadline and the transport's bound are one value.
//
// LANE A DISSOLUTION (argv anemia -> transport rest):
// The service config endpoint uses the per-call bmc_host input via string concatenation.
// Each operation declares `transport rest` with:
//   - method, path (relative, interpolated, prefixed with /redfish/v1/), auth_basic (modeled dissolution of netrc/-u),
//   - tls: InsecureAcceptAnyCert (modeled dissolution of curl -k),
//   - response arms (modeled dissolution of --fail-with-body + exit code handling).
// The curl argv is now derived by realization, not hand-spelled per row.
service redfish.Http {
  config {
    // Per-call host via config endpoint expression evaluated with operation param_env.
    // Concatenated with transport path: "https://" + "{bmc_host}/redfish/v1/..." -> "https://<host>/redfish/v1/..."
    endpoint: "https://" + bmc_host
  }
  
  // Credentials are resolved from netrc by caller and passed as auth_basic inputs.
  // The caller passes username/password from the netrc file; auth_basic uses those resolved credentials.

  operation GetServiceRoot {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation ProbeServiceRoot {
    requires Network
    input { bmc_host: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/",
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      404 => String
      5xx => String
    }
  }

  operation GetManagers {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Managers",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetManager {
    requires Network
    input { bmc_host: NonEmptyStr, manager_id: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Managers/{manager_id}",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetSystem {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Systems/system",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetChassisSensors {
    requires Network
    input { bmc_host: NonEmptyStr, chassis_id: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Chassis/{chassis_id}/Sensors",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetPower {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Chassis/Self/Power",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetThermal {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Chassis/Self/Thermal",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetChassisThermal {
    requires Network
    input { bmc_host: NonEmptyStr, chassis_id: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Chassis/{chassis_id}/Thermal",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetChassisSensor {
    requires Network
    input { bmc_host: NonEmptyStr, chassis_id: NonEmptyStr, sensor_id: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Chassis/{chassis_id}/Sensors/{sensor_id}",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetSystemEventLogEntries {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "/redfish/v1/Systems/system/LogServices/EventLog/Entries",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation CreateAccount {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr, request_body_file: NonEmptyStr }
    output { body: String }
    transport rest {
      method: POST,
      path: "/redfish/v1/AccountService/Accounts",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert,
      body: { from_file: request_body_file }
    }
    response {
      201 => String
      401 => String
      409 => String
      5xx => String
    }
  }

  operation SetAccountPassword {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr, account_id: NonEmptyStr, request_body_file: NonEmptyStr }
    output { body: String }
    transport rest {
      method: PATCH,
      path: "/redfish/v1/AccountService/Accounts/{account_id}",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert,
      body: { from_file: request_body_file }
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation SetBootSourceOverride {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr, system_id: NonEmptyStr, request_body_file: NonEmptyStr }
    output { body: String }
    transport rest {
      method: PATCH,
      path: "/redfish/v1/Systems/{system_id}",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert,
      body: { from_file: request_body_file }
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation ResetSystem {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr, system_id: NonEmptyStr, request_body_file: NonEmptyStr }
    output { body: String }
    transport rest {
      method: POST,
      path: "/redfish/v1/Systems/{system_id}/Actions/ComputerSystem.Reset",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert,
      body: { from_file: request_body_file }
    }
    response {
      200 => String
      202 => String
      401 => String
      404 => String
      5xx => String
    }
  }

  operation GetResourceByPath {
    requires Network
    input { bmc_host: NonEmptyStr, username: NonEmptyStr, password: NonEmptyStr, odata_path: NonEmptyStr }
    output { body: String }
    readonly
    transport rest {
      method: GET,
      path: "{odata_path}",
      auth_basic: { username: username, password: password },
      tls: InsecureAcceptAnyCert
    }
    response {
      200 => String
      401 => String
      404 => String
      5xx => String
    }
  }
}