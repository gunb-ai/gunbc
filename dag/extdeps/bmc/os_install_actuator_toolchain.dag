module extdeps.bmc.os_install_actuator_toolchain

import std.types { NonEmptyStr, List, Bool }
import extdeps.tools { CliTool }
import extdeps.tools.curl { curl_cli_tool }
import extdeps.tools.websocat { websocat_cli_tool }
import extdeps.tools.nbdkit { nbdkit_cli_tool }
import extdeps.tools.socat { socat_cli_tool }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openbmc/docs/blob/master/designs/virtual-media.md"
  }
}

type ActuatorToolchainRequirement {
  required_tools: List<CliTool>
}

data os_install_actuator_toolchain_requirement: ActuatorToolchainRequirement = ActuatorToolchainRequirement {
  required_tools: [
    curl_cli_tool,
    websocat_cli_tool,
    nbdkit_cli_tool,
    socat_cli_tool,
  ],
}

data srv3_os_install_actuator_host_label: NonEmptyStr = "install-actuator-host"

data srv3_os_install_actuator_toolchain_grant: ActuatorToolchainRequirement = os_install_actuator_toolchain_requirement

fn actuator_toolchain_requirement_includes_tool(
  requirement: ActuatorToolchainRequirement,
  tool_name: NonEmptyStr,
) -> Bool {
  fold(
    requirement.required_tools,
    init: false,
    f: (acc, tool) => acc || tool.name == tool_name
  )
}

fn actuator_toolchain_requirement_is_complete(requirement: ActuatorToolchainRequirement) -> Bool {
  actuator_toolchain_requirement_includes_tool(
    requirement: requirement,
    tool_name: curl_cli_tool.name,
  )
    && actuator_toolchain_requirement_includes_tool(
      requirement: requirement,
      tool_name: websocat_cli_tool.name,
    )
    && actuator_toolchain_requirement_includes_tool(
      requirement: requirement,
      tool_name: nbdkit_cli_tool.name,
    )
    && actuator_toolchain_requirement_includes_tool(
      requirement: requirement,
      tool_name: socat_cli_tool.name,
    )
}

fn srv3_os_install_actuator_toolchain_is_complete() -> Bool {
  actuator_toolchain_requirement_is_complete(
    requirement: os_install_actuator_toolchain_requirement,
  )
}
