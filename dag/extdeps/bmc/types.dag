import extdeps.filesystem.linux { LinuxOverlayObservation }
import std.measure {
  ByteSize,
  Celsius,
  HardwareThreadCount,
  Percent,
  RevolutionsPerMinute,
  Watt,
  celsius_count,
  percent_count,
}
import std.nat { Nat }
import std.types { Bool, Int, List, NonEmptyStr }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.dmtf.org/standards/redfish"
  }
}

data phosphor_pid_control_stepwise_semantics_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openbmc/phosphor-pid-control/blob/master/configure.md"
  }
}

type RedfishPowerState = On | Off | PoweringOn | PoweringOff

type RedfishProcessorSummary {
  model: NonEmptyStr
  processor_count: Int
  core_count: HardwareThreadCount
  logical_processor_count: HardwareThreadCount?
}

type RedfishMemorySummary {
  total_memory_bytes: ByteSize
}

type RedfishSystemInventory {
  model: NonEmptyStr
  manufacturer: NonEmptyStr?
  serial_number: NonEmptyStr?
  processor: RedfishProcessorSummary
  memory: RedfishMemorySummary
  power_state: RedfishPowerState
}

type RedfishPowerControl {
  member_id: NonEmptyStr
  name: NonEmptyStr?
  power_consumed_watts: Watt?
  power_limit_watts: Watt?
}

type RedfishPowerSubsystem {
  controls: List<RedfishPowerControl>
}

type RedfishTemperatureReading {
  member_id: NonEmptyStr
  name: NonEmptyStr?
  reading_celsius: Celsius?
}

type RedfishThermalSubsystem {
  temperatures: List<RedfishTemperatureReading>
}

type RedfishSensorReading =
    PowerSensor { name: NonEmptyStr, watts: Watt? }
  | TemperatureSensor { name: NonEmptyStr, celsius: Celsius? }
  | FanTachSensor { name: NonEmptyStr, rpm: RevolutionsPerMinute? }

type RedfishChassisSensorCollection {
  chassis_id: NonEmptyStr
  sensors: List<RedfishSensorReading>
}

type RedfishThermalTelemetrySurface
  = RedfishThermalSubsystemSensorCollection
  | RedfishLegacyChassisThermal
  | RedfishDualThermalSurface

type RedfishFanControlSurface
  = RedfishFanControlResourceAbsent
  | RedfishInitialDutyControlResource

type BmcRedfishSurfaceObservation {
  firmware: BmcFirmwareObservation
  thermal_surface: RedfishThermalTelemetrySurface
  chassis_sensor_collection_member_count: Nat
  fan_control_surface: RedfishFanControlSurface
}

type BmcUpdateServiceObservation {
  firmware: BmcFirmwareObservation
  http_push_uri: NonEmptyStr
  multipart_http_push_uri: NonEmptyStr
  active_bmc_image_id: NonEmptyStr
  active_bmc_image_updateable: Bool
  firmware_inventory_member_count: Nat
  bmc_image_member_count: Nat
  backup_bmc_image_observed: Bool
  observed_at: NonEmptyStr
}

type RedfishThermalQueryVerdict
  = RedfishThermalQueryComplete { surface: RedfishThermalTelemetrySurface }
  | RedfishThermalQueryRefused { reason: NonEmptyStr }

fn redfish_thermal_query_verdict(
  chassis_sensors_success: Bool,
  thermal_subsystem_success: Bool,
  legacy_thermal_success: Bool
) -> RedfishThermalQueryVerdict {
  if legacy_thermal_success && thermal_subsystem_success && chassis_sensors_success {
    RedfishThermalQueryComplete { surface: RedfishDualThermalSurface }
  } else if legacy_thermal_success {
    RedfishThermalQueryComplete { surface: RedfishLegacyChassisThermal }
  } else if thermal_subsystem_success && chassis_sensors_success {
    RedfishThermalQueryComplete { surface: RedfishThermalSubsystemSensorCollection }
  } else {
    RedfishThermalQueryRefused {
      reason: "no complete Redfish thermal surface: Sensors alone is not evidence of temperature/fan coverage",
    }
  }
}

type BmcFanCurveStep {
  at_or_above: Celsius
  duty: Percent
}

type BmcFanCurve {
  control_sensor: NonEmptyStr
  steps: List<BmcFanCurveStep>
  minimum_duty: Percent
  sensor_unavailable_duty: Percent
  zone_failsafe_duty: Percent
  positive_hysteresis_degrees_celsius: Nat
  negative_hysteresis_degrees_celsius: Nat
}

type ValidatedBmcFanCurve {
  curve: BmcFanCurve
}

type BmcFanCurveInvalidCause
  = BmcFanCurveEmpty
  | BmcFanCurveTemperatureNotStrictlyIncreasing {
      previous: Celsius,
      current: Celsius,
    }
  | BmcFanCurveDutyDecreased {
      previous: Percent,
      current: Percent,
    }
  | BmcFanCurveTerminalDutyNotFull { terminal_duty: Percent }

type BmcFanCurveValidation
  = BmcFanCurveValid { curve: ValidatedBmcFanCurve }
  | BmcFanCurveInvalid { cause: BmcFanCurveInvalidCause }

fn bmc_fan_curve_step_order_refusal(
  remaining: List<BmcFanCurveStep>,
  previous: BmcFanCurveStep,
) -> BmcFanCurveInvalidCause? {
  match remaining.first() {
    Absent => none
    Present { value: current } =>
      if celsius_count(current.at_or_above) <= celsius_count(previous.at_or_above) {
        Present {
          value: BmcFanCurveTemperatureNotStrictlyIncreasing {
            previous: previous.at_or_above,
            current: current.at_or_above,
          },
        }
      } else if percent_count(current.duty) < percent_count(previous.duty) {
        Present {
          value: BmcFanCurveDutyDecreased {
            previous: previous.duty,
            current: current.duty,
          },
        }
      } else {
        bmc_fan_curve_step_order_refusal(
          remaining: remaining.skip(n: 1),
          previous: current,
        )
      }
  }
}

fn validate_bmc_fan_curve(curve: BmcFanCurve) -> BmcFanCurveValidation {
  match curve.steps.first() {
    Absent =>
      BmcFanCurveInvalid { cause: BmcFanCurveEmpty }
    Present { value: first } =>
      match bmc_fan_curve_step_order_refusal(
        remaining: curve.steps.skip(n: 1),
        previous: first,
      ) {
        Present { value: cause } =>
          BmcFanCurveInvalid { cause: cause }
        Absent => {
          let terminal = curve.steps.skip(n: curve.steps.length() - 1).first()
          match terminal {
            Absent =>
              BmcFanCurveInvalid { cause: BmcFanCurveEmpty }
            Present { value: final_step } =>
              if percent_count(final_step.duty) != 100 {
                BmcFanCurveInvalid {
                  cause: BmcFanCurveTerminalDutyNotFull {
                    terminal_duty: final_step.duty,
                  },
                }
              } else {
                BmcFanCurveValid {
                  curve: ValidatedBmcFanCurve { curve: curve },
                }
              }
          }
        }
      }
  }
}

type BmcFanDutyDecision
  = BmcFanDutyFromCurve { reading: Celsius, duty: Percent }
  | BmcFanDutyFromSensorFailsafe { duty: Percent }

data bmc_fan_duty_decision_semantics_note: String = "The curve branch is the stateless base projection of the declared step points, clamped by minimum_duty below the first point. phosphor-pid-control's cited stepwise semantics only recompute after the input moves farther than positiveHysteresis or negativeHysteresis from the prior recomputation input; the effective emergency proof therefore includes rising hysteresis. A runtime observation must retain prior state when exact transition timing matters. The coproduct keeps a base-curve request distinct from the numerically identical sensor-unavailable fail-safe request."

fn bmc_fan_curve_duty_at(
  validated: ValidatedBmcFanCurve,
  reading: Celsius,
) -> Percent {
  let curve = validated.curve
  fold(
    curve.steps,
    init: curve.minimum_duty,
    f: (selected, step) =>
      if celsius_count(reading) >= celsius_count(step.at_or_above) {
        step.duty
      } else {
        selected
      }
  )
}

fn bmc_fan_duty_decision(
  validated: ValidatedBmcFanCurve,
  reading: Celsius?,
) -> BmcFanDutyDecision {
  let curve = validated.curve
  match reading {
    Absent =>
      BmcFanDutyFromSensorFailsafe { duty: curve.sensor_unavailable_duty }
    Present { value: temperature } =>
      BmcFanDutyFromCurve {
        reading: temperature,
        duty: bmc_fan_curve_duty_at(
          validated: validated,
          reading: temperature,
        ),
      }
  }
}

type BmcFanControllerShape
  = FanPidIndependentEntries { entry_names: List<NonEmptyStr> }
  | FanPidAggregatedEntry {
      entry_name: NonEmptyStr,
      tach_inputs: List<NonEmptyStr>,
    }

type BmcFanPolicyObservation {
  firmware: BmcFirmwareVersion
  curve: BmcFanCurve
  selected_config_path: NonEmptyStr
  board_config_path: NonEmptyStr
  controller_service: NonEmptyStr
  controller_binary: NonEmptyStr
  controller_shape: BmcFanControllerShape
  observed_at: NonEmptyStr
}

type BmcConfigPersistenceObservation
  = BmcOverlayConfigObserved {
      firmware: BmcFirmwareVersion
      config_path: NonEmptyStr
      overlay: LinuxOverlayObservation
      writable: Bool
      upper_override_present: Bool
      available_bytes: ByteSize
      observed_at: NonEmptyStr
    }
  | BmcConfigPersistenceUnsupported {
      firmware: BmcFirmwareVersion
      config_path: NonEmptyStr
      reason: NonEmptyStr
      observed_at: NonEmptyStr
    }

type BmcTelemetrySnapshot {
  system: RedfishSystemInventory
  power: RedfishPowerSubsystem?
  thermal: RedfishThermalSubsystem?
  sensors: RedfishChassisSensorCollection?
}

type BmcGroundedHostObservations {
  processor_model: NonEmptyStr
  processor_core_count: HardwareThreadCount
  total_memory_bytes: ByteSize
  power_consumed_watts: Watt?
}

type RedfishBootSourceOverrideTarget =
    BootTargetNone
  | BootTargetPxe
  | BootTargetHdd
  | BootTargetCd
  | BootTargetUsb
  | BootTargetBiosSetup
  | BootTargetDiags

type RedfishBootSourceOverrideEnabled =
    BootOverrideDisabled
  | BootOverrideOnce
  | BootOverrideContinuous

type RedfishBootSourceOverrideMode =
    BootOverrideModeLegacy
  | BootOverrideModeUefi

type RedfishResetType =
    ResetForceOff
  | ResetForceOn
  | ResetForceRestart
  | ResetGracefulRestart
  | ResetGracefulShutdown
  | ResetPowerCycle

type RedfishManagerResetObservation {
  action_target: NonEmptyStr
  reset_type: RedfishResetType
  http_status: Nat
  accepted: Bool
  observed_at: NonEmptyStr
}

type RedfishAccountRole =
    AccountRoleAdministrator
  | AccountRoleOperator
  | AccountRoleReadOnly

type RedfishPrivilege =
    PrivilegeLogin
  | PrivilegeConfigureManager
  | PrivilegeConfigureUsers
  | PrivilegeConfigureComponents
  | PrivilegeConfigureSelf

fn redfish_boot_target_wire(t: RedfishBootSourceOverrideTarget) -> NonEmptyStr {
  match t {
    BootTargetNone => "None"
    BootTargetPxe => "Pxe"
    BootTargetHdd => "Hdd"
    BootTargetCd => "Cd"
    BootTargetUsb => "Usb"
    BootTargetBiosSetup => "BiosSetup"
    BootTargetDiags => "Diags"
  }
}

fn redfish_boot_override_enabled_wire(e: RedfishBootSourceOverrideEnabled) -> NonEmptyStr {
  match e {
    BootOverrideDisabled => "Disabled"
    BootOverrideOnce => "Once"
    BootOverrideContinuous => "Continuous"
  }
}

fn redfish_boot_override_mode_wire(m: RedfishBootSourceOverrideMode) -> NonEmptyStr {
  match m {
    BootOverrideModeLegacy => "Legacy"
    BootOverrideModeUefi => "UEFI"
  }
}

fn redfish_reset_type_wire(r: RedfishResetType) -> NonEmptyStr {
  match r {
    ResetForceOff => "ForceOff"
    ResetForceOn => "ForceOn"
    ResetForceRestart => "ForceRestart"
    ResetGracefulRestart => "GracefulRestart"
    ResetGracefulShutdown => "GracefulShutdown"
    ResetPowerCycle => "PowerCycle"
  }
}

fn redfish_account_role_wire(role: RedfishAccountRole) -> NonEmptyStr {
  match role {
    AccountRoleAdministrator => "Administrator"
    AccountRoleOperator => "Operator"
    AccountRoleReadOnly => "ReadOnly"
  }
}

fn redfish_privilege_wire(p: RedfishPrivilege) -> NonEmptyStr {
  match p {
    PrivilegeLogin => "Login"
    PrivilegeConfigureManager => "ConfigureManager"
    PrivilegeConfigureUsers => "ConfigureUsers"
    PrivilegeConfigureComponents => "ConfigureComponents"
    PrivilegeConfigureSelf => "ConfigureSelf"
  }
}

type RedfishSystemAction =
    SetBootSourceOverride { target: RedfishBootSourceOverrideTarget, enabled: RedfishBootSourceOverrideEnabled }
  | ResetSystem { reset_type: RedfishResetType }
  | SetAccountPassword { account_id: NonEmptyStr, new_password: Secret }
  | GetSystem
