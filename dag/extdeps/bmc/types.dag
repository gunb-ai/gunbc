  power_limit_watts: std.measure.Watt?
}

type RedfishPowerSubsystem {
  controls: List<RedfishPowerControl>
}

type RedfishTemperatureReading {
  member_id: std.types.NonEmptyStr
  name: std.types.NonEmptyStr?
