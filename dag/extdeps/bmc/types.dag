module extdeps.bmc.types


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.dmtf.org/standards/redfish"
  }
}

data phosphor_pid_control_stepwise_semantics_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "github.com/openbmc/phosphor-pid-control/blob/master/configure.md"
  }
}

type RedfishPowerState = On | Off | PoweringOn | PoweringOff

type RedfishHostPowerStateContinuityVerdict
  = RedfishHostPowerStateRemainedOn
  | RedfishHostPowerStateChanged {
      power_before: RedfishPowerState,
      power_after: RedfishPowerState,
    }

fn redfish_host_power_state_continuity_verdict(
  power_before: RedfishPowerState,
  power_after: RedfishPowerState,
) -> RedfishHostPowerStateContinuityVerdict {
  match power_before {
    On =>
      match power_after {
        On => RedfishHostPowerStateRemainedOn
        after => RedfishHostPowerStateChanged {
          power_before: On,
          power_after: after,
        }
      }
    before => RedfishHostPowerStateChanged {
      power_before: before,
      power_after: power_after,
    }
  }
}

