module extdeps.bmc.ipmi_channel

import std.types { Int, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.network.ipv4 { Ipv4Address, ipv4_address, ipv4_address_eq }

// IPMI v2.0 rev 1.1 channel numbering (section 6.3) and channel medium type
// (Table 6-3). This is the INTERFACE SHAPE Get Channel Info, Get LAN
// Configuration Parameters, and Get User Access return. It is not the
// transport: extdeps.bmc.ipmi's Tool operations today are sensor, sdr, sel,
// chassis, fru, and mc — they do not read a channel census. A workflow
// observation of one controller is a receipt in the observing product, never
// a row here. The fold that consumes this shape is
// gunbc.machine_intake_bmc_secure; the effectful producer that would invoke
// ipmitool for these three commands is that module's named rotation-actuator
// frontier, not a silent claim that the argv already exists.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.intel.com/content/dam/www/public/us/en/documents/product-briefs/ipmi-second-gen-interface-spec-v2-rev1-1.pdf"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc.ipmi_channel",
      decl_name: "IpmiChannelCensusMember",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// Section 6.3: channel numbers 0h-Fh. The brand is the range, not a nickname
// for Int: 16 has no constructor.
type IpmiChannelNumber = Int where range(min: 0, max: 15)

// Table 6-3 Channel Medium Type, split so LAN vs non-LAN cannot disagree
// with the census-member coproduct. A serial medium has no constructor on a
// LAN member; 802.3 has no constructor on a non-LAN member. Codes this corpus
// has not yet had to classify stay Other { code } on the non-LAN side.
type IpmiLanMedium
  = IpmiMedium8023Lan
  | IpmiMediumOtherLan

type IpmiNonLanMedium
  = IpmiMediumIpmb
  | IpmiMediumIcmbV1
  | IpmiMediumIcmbV09
  | IpmiMediumSerialAsync
  | IpmiMediumPciSmbus
  | IpmiMediumSmbusV1
  | IpmiMediumSmbusV2
  | IpmiMediumSystemInterface
  | IpmiMediumOther { code: Int }

// Get User Access (IPMI v2.0 rev 1.1 §22.27). User ID bits [5:0]: 00h is
// reserved; 01h-3Fh are User ID 1-63. Fh Channel Privilege Limit is NO ACCESS.
// The command is parameterized by (channel, user). Privilege without a user is
// not this command's result; a product "published factory account" join lives
// on the observing observation, never packed into the census member.
type IpmiUserId = Int where range(min: 1, max: 63)

type IpmiChannelPrivilegeLimit
  = IpmiPrivilegeCallback
  | IpmiPrivilegeUser
  | IpmiPrivilegeOperator
  | IpmiPrivilegeAdministrator
  | IpmiPrivilegeOem
  | IpmiPrivilegeNoAccess

type IpmiUserChannelAccess {
  channel: IpmiChannelNumber
  user: IpmiUserId
  privilege: IpmiChannelPrivilegeLimit
}

fn ipmi_user_channel_access(
  channel: IpmiChannelNumber,
  user: IpmiUserId,
  privilege: IpmiChannelPrivilegeLimit,
) -> IpmiUserChannelAccess {
  IpmiUserChannelAccess { channel: channel, user: user, privilege: privilege }
}

// Get LAN Configuration Parameters, IPv4 address. 0.0.0.0 is the
// unspecified address, not a probe target: it is Unassigned rather than
// Assigned { 0, 0, 0, 0 }, so a later fold cannot treat it as a rejecting host.
type IpmiLanIpv4Configuration
  = IpmiLanIpv4Assigned { address: Ipv4Address }
  | IpmiLanIpv4Unassigned

fn ipmi_lan_ipv4_configuration(address: Ipv4Address) -> IpmiLanIpv4Configuration {
  if ipv4_address_eq(a: address, b: ipv4_address(octet1: 0, octet2: 0, octet3: 0, octet4: 0)) {
    IpmiLanIpv4Unassigned
  } else {
    IpmiLanIpv4Assigned { address: address }
  }
}

// One row of a channel census. LAN and non-LAN are different members, not a
// LAN row with a skipped address: a serial channel has no IPv4 configuration
// to be empty, and an 802.3 channel with 0.0.0.0 is Unassigned.
// Get User Access is a separate list on the census: one row per (channel, user)
// the controller returned, never a published-account privilege packed here.
type IpmiChannelCensusMember
  = IpmiLanChannelMember {
      channel: IpmiChannelNumber
      medium: IpmiLanMedium
      ipv4: IpmiLanIpv4Configuration
    }
  | IpmiNonLanChannelMember {
      channel: IpmiChannelNumber
      medium: IpmiNonLanMedium
    }

fn ipmi_lan_channel_member(
  channel: IpmiChannelNumber,
  medium: IpmiLanMedium,
  address: Ipv4Address,
) -> IpmiChannelCensusMember {
  IpmiLanChannelMember {
    channel: channel,
    medium: medium,
    ipv4: ipmi_lan_ipv4_configuration(address: address),
  }
}

fn ipmi_non_lan_channel_member(
  channel: IpmiChannelNumber,
  medium: IpmiNonLanMedium,
) -> IpmiChannelCensusMember {
  IpmiNonLanChannelMember {
    channel: channel,
    medium: medium,
  }
}

type IpmiControllerChannelCensus {
  members: List<IpmiChannelCensusMember>
  user_access: List<IpmiUserChannelAccess>
}

fn ipmi_controller_channel_census(
  members: List<IpmiChannelCensusMember>,
  user_access: List<IpmiUserChannelAccess>,
) -> IpmiControllerChannelCensus {
  IpmiControllerChannelCensus { members: members, user_access: user_access }
}
