module extdeps.bmc.webui.nbd_proxy_serve


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "github.com/openbmc/jsnbd"
  }
}

data bmcweb_session_token_env_ref: std.types.NonEmptyStr = concat("$", "BMCWEB_SESSION_TOKEN") as std.types.NonEmptyStr

data srv3_nbd_proxy_local_port: Int = 10809

data nbd_proxy_serve_systemd_realization_dissolution_trigger: std.disposition.Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "extdeps.bmc.webui.nbd_proxy_serve",
    decl_name: "nbd_proxy_serve_websocat_argv",
    field: WholeDeclaration
  }
}

type NbdProxyServeTransportIntent {
  bmc_host: std.types.NonEmptyStr
  session_token: std.types.NonEmptyStr
  ws_path: std.types.NonEmptyStr
  iso_path: std.types.NonEmptyStr
  local_nbd_port: Int
}

data nbd_proxy_serve_cited_tool_names: List<std.types.NonEmptyStr> = [
  nbdkit_cli_tool.name,
  websocat_cli_tool.name,
  socat_cli_tool.name,
]

fn nbd_proxy_serve_transport_intent(
  bmc_host: std.types.NonEmptyStr,
  session_token: std.types.NonEmptyStr,
  ws_path: std.types.NonEmptyStr,
  iso_path: std.types.NonEmptyStr,
  local_nbd_port: Int,
) -> NbdProxyServeTransportIntent {
  NbdProxyServeTransportIntent {
    bmc_host: bmc_host,
    session_token: session_token,
    ws_path: ws_path,
    iso_path: iso_path,
    local_nbd_port: local_nbd_port,
  }
}

fn nbd_proxy_serve_intent_of_virtual_media(vm: extdeps.bmc.virtual_media.VirtualMediaIntent, params: extdeps.bmc.virtual_media.NbdProxyWebsocatParams) -> NbdProxyServeTransportIntent {
  NbdProxyServeTransportIntent {
    bmc_host: vm.bmc_host,
    session_token: params.session_token,
    ws_path: params.ws_path,
    iso_path: virtual_media_source_iso(intent: vm),
    local_nbd_port: params.local_nbd_port,
  }
}

fn bmcweb_session_login_curl_args(
  bmc_host: std.types.NonEmptyStr,
  request_body_file: std.types.NonEmptyStr,
  response_path: std.types.NonEmptyStr,
) -> List<String> {
  [
    "-sk",
    "-X",
    "POST",
    concat("https://", concat(bmc_host as String, "/login")),
    "-H",
    "Content-Type: application/json",
    "--data",
    concat("@", request_body_file as String),
    "-o",
    response_path as String,
  ]
}

fn bmcweb_session_login_argv(
  bmc_host: std.types.NonEmptyStr,
  request_body_file: std.types.NonEmptyStr,
  response_path: std.types.NonEmptyStr,
) -> List<String> {
  fold(
    bmcweb_session_login_curl_args(
      bmc_host: bmc_host,
      request_body_file: request_body_file,
      response_path: response_path,
    ),
    init: [curl_cli_tool.name as String],
    f: (acc, word) => list_push(acc, word),
  )
}

fn nbd_proxy_serve_session_fingerprint() -> std.types.NonEmptyStr {
  "gunbc-nbd-proxy" as std.types.NonEmptyStr
}

fn nbd_proxy_serve_nbdkit_unit_name(lease_key: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat(concat("nbd-proxy-", lease_key as String), "-nbdkit") as std.types.NonEmptyStr
}

fn nbd_proxy_serve_websocat_unit_name(lease_key: std.types.NonEmptyStr) -> std.types.NonEmptyStr {
  concat(concat("nbd-proxy-", lease_key as String), "-ws") as std.types.NonEmptyStr
}

fn nbd_proxy_serve_nbdkit_argv(intent: NbdProxyServeTransportIntent) -> List<String> {
  [
    nbdkit_cli_tool.name as String,
    "-p",
    to_string(intent.local_nbd_port),
    "--readonly",
    "file",
    concat("file=", intent.iso_path as String),
  ]
}

fn nbd_proxy_serve_websocat_argv(intent: NbdProxyServeTransportIntent) -> List<String> {
  let port = to_string(intent.local_nbd_port)
  let wss_url = concat("wss://", concat(intent.bmc_host, intent.ws_path))
  let auth_header = concat("Authorization: Token ", intent.session_token)
  let socat_bridge = concat("tcp:127.0.0.1:", port)
  [
    websocat_install_path as String,
    "--insecure",
    "--text",
    concat("--header=\"", concat(auth_header, "\"")),
    wss_url,
    socat_bridge,
  ]
}

fn nbd_proxy_serve_websocat_argv_leading_tool_is_websocat(intent: NbdProxyServeTransportIntent) -> Bool {
  fold(
    nbd_proxy_serve_websocat_argv(intent: intent),
    init: "",
    f: (acc, word) => if acc != "" { acc } else { word },
  ) == websocat_install_path as String
}

fn nbd_proxy_serve_nbdkit_argv_includes_iso(intent: NbdProxyServeTransportIntent) -> Bool {
  fold(
    nbd_proxy_serve_nbdkit_argv(intent: intent),
    init: "",
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  ).contains(intent.iso_path as String)
}

fn nbd_proxy_serve_append_argv(acc: List<String>, argv: List<String>) -> List<String> {
  fold(argv, init: acc, f: (xs, arg) => list_push(xs, arg))
}

fn nbd_proxy_serve_argv_surface_text(intent: NbdProxyServeTransportIntent) -> String {
  fold(
    nbd_proxy_serve_append_argv(
      acc: nbd_proxy_serve_nbdkit_argv(intent: intent),
      argv: nbd_proxy_serve_websocat_argv(intent: intent),
    ),
    init: "",
    f: (acc, word) => if acc == "" { word } else { concat(acc, concat(" ", word)) },
  )
}

fn nbd_proxy_serve_argv_surface_contains_supervision_marker(surface: String) -> Bool {
  surface.contains("trap")
    || surface.contains("$!")
    || surface.contains(" &")
    || surface.contains("& ")
    || surface.contains("nohup")
}

fn nbd_proxy_serve_has_no_shell_supervision_grammar(intent: NbdProxyServeTransportIntent) -> Bool {
  !nbd_proxy_serve_argv_surface_contains_supervision_marker(
    surface: nbd_proxy_serve_argv_surface_text(intent: intent),
  )
}

fn nbd_proxy_serve_requires_host_as_nbd_server() -> Bool {
  nbd_proxy_role_assignment.host_program_role == NbdServer
}
