module extdeps.bmc.webui.nbd_proxy_serve


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.bmc.virtual_media { NbdProxyWebsocatParams, VirtualMediaIntent, virtual_media_source_iso }
import extdeps.bmc.webui.nbd_proxy { NbdServer, nbd_proxy_role_assignment }
import extdeps.tools.nbdkit { nbdkit_cli_tool }
import extdeps.tools.socat { socat_cli_tool }
import extdeps.tools.websocat { websocat_cli_tool }
import std.disposition { Disposition, Terminal }
import std.types { Bool, Int, List, NonEmptyStr, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openbmc/jsnbd"
  }
}

data bmcweb_session_token_env_ref: NonEmptyStr = concat("$", "BMCWEB_SESSION_TOKEN") as NonEmptyStr

data srv3_nbd_proxy_local_port: Int = 10809

// RETIRED SCAFFOLD, RETIRING WITH ITS CARRIER. This row was a Scaffold bound to the raw
// `nbd_proxy_serve_websocat_argv` word list, dissolving into realization dispatch. Both halves of
// that condition are now met, so the scaffold retires rather than re-binds -- a trigger citing a
// declaration that no longer exists is the dead vocabulary this repository removes (std.dissolution
// DeclarationRetires note):
//
// 1. THE CARRIER ARRIVED. The serve legs are described commands minted at their tools' own extdeps
//    modules -- extdeps.tools.nbdkit nbdkit_readonly_file_serve_command and
//    extdeps.tools.websocat websocat_nbd_proxy_bridge_command, admitted at the extdeps.exec.command
//    argv_command wall -- replacing the hand-authored List<String> builders this module carried
//    (bmcweb_session_login_curl_args/_argv, nbd_proxy_serve_nbdkit_argv,
//    nbd_proxy_serve_websocat_argv, all deleted with the word lists they assembled; the word lists
//    are byte-identical at argv_words, so no realization bytes changed).
// 2. THE DISPATCH LANDED. The typed systemd transient-unit transport (#8582): start through
//    gunbc.systemd_run_transient (RunTransient), stop through gunbc.systemctl_stop_run (Stop),
//    observe through gunbc.systemctl_is_active_read (IsActive) -- typed-argv dispatch over the
//    cited extdeps.systemd authorities, which is what this scaffold's dissolve-to named.
//
// THE OPERATOR RULING THIS MODULE USED TO GUARD WITH A STRING SEARCH now holds by construction:
// the 2026-07-14 ruling (no trap/&/$! ShellStmt vocabulary) was enforced by joining the argv lists
// into a surface and searching it for supervision grammar (nbd_proxy_serve_argv_surface_text,
// nbd_proxy_serve_has_no_shell_supervision_grammar, and their detector red control -- all deleted
// here). There is no shell-statement surface left to search: the realization takes command words
// into a transient unit and offers no supervision vocabulary at all, so the law is structural
// rather than detected, and a check nothing on the production path can fail is decoration.
//
// WHAT THE TYPED CARRIER DOES NOT DISCHARGE rides in the header word, and is recorded where the
// word is minted: extdeps.tools.websocat websocat_header_argv_word_dissolution_trigger
// (gunbc.credential_argv_exposure instance 3 -- the BMCWEB session token in the `--header=` argv
// element; measured latent, repair operator-ruled).
data nbd_proxy_serve_systemd_realization_disposition: Disposition = Terminal {
  reason: "systemd transient-unit realization dispatch for the nbd-proxy serve legs landed (#8582) and the serve legs are now described commands minted at extdeps.tools.nbdkit nbdkit_readonly_file_serve_command and extdeps.tools.websocat websocat_nbd_proxy_bridge_command under the extdeps.exec.command argv_command wall, byte-identical at argv_words to the raw word lists they replace. The former Scaffold (nbd_proxy_serve_systemd_realization_dissolution_trigger, bound to the deleted nbd_proxy_serve_websocat_argv) named the arrival of exactly this dispatch and retires with its carrier. The joined-string supervision-grammar oracle and its detector retired with the raw word lists: the no-trap/&/$! law (operator ruling 2026-07-14) is enforced by construction on the transient-unit surface, not by searching a joined string. The one owed obligation moves with the word that carries it: extdeps.tools.websocat websocat_header_argv_word_dissolution_trigger (credential_argv_exposure instance 3)."
}

type NbdProxyServeTransportIntent {
  bmc_host: NonEmptyStr
  session_token: NonEmptyStr
  ws_path: NonEmptyStr
  iso_path: NonEmptyStr
  local_nbd_port: Int
}

data nbd_proxy_serve_cited_tool_names: List<NonEmptyStr> = [
  nbdkit_cli_tool.program.invocation,
  websocat_cli_tool.program.invocation,
  socat_cli_tool.program.invocation,
]

fn nbd_proxy_serve_transport_intent(
  bmc_host: NonEmptyStr,
  session_token: NonEmptyStr,
  ws_path: NonEmptyStr,
  iso_path: NonEmptyStr,
  local_nbd_port: Int,
) -> NbdProxyServeTransportIntent {
  NbdProxyServeTransportIntent {
    bmc_host: bmc_host,
    session_token: session_token,
    ws_path: ws_path,
    iso_path: iso_path,
    local_nbd_port: local_nbd_port,
  }
}

fn nbd_proxy_serve_intent_of_virtual_media(vm: VirtualMediaIntent, params: NbdProxyWebsocatParams) -> NbdProxyServeTransportIntent {
  NbdProxyServeTransportIntent {
    bmc_host: vm.bmc_host,
    session_token: params.session_token,
    ws_path: params.ws_path,
    iso_path: virtual_media_source_iso(intent: vm),
    local_nbd_port: params.local_nbd_port,
  }
}

fn nbd_proxy_serve_session_fingerprint() -> NonEmptyStr {
  "gunbc-nbd-proxy" as NonEmptyStr
}

fn nbd_proxy_serve_nbdkit_unit_name(lease_key: NonEmptyStr) -> NonEmptyStr {
  concat(concat("nbd-proxy-", lease_key as String), "-nbdkit") as NonEmptyStr
}

fn nbd_proxy_serve_websocat_unit_name(lease_key: NonEmptyStr) -> NonEmptyStr {
  concat(concat("nbd-proxy-", lease_key as String), "-ws") as NonEmptyStr
}

fn nbd_proxy_serve_requires_host_as_nbd_server() -> Bool {
  nbd_proxy_role_assignment.host_program_role == NbdServer
}
