module extdeps.bmc.access


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.dmtf.org/standards/redfish"
  }
}

data redfish_privilege_object: std.types.NonEmptyStr = "redfish"

fn redfish_privilege_permission(privilege: extdeps.bmc.types.RedfishPrivilege) -> extdeps.access.rbac.Permission {
  extdeps.access.rbac.Permission { operation: extdeps.bmc.types.redfish_privilege_wire(p: privilege), object: redfish_privilege_object }
}

fn redfish_privilege_assignment(privilege: extdeps.bmc.types.RedfishPrivilege, role: extdeps.bmc.types.RedfishAccountRole) -> extdeps.access.rbac.PermissionAssignment {
  extdeps.access.rbac.PermissionAssignment {
    permission: redfish_privilege_permission(privilege: privilege),
    role: extdeps.bmc.types.redfish_account_role_wire(role: role),
  }
}

data redfish_rbac_policy: extdeps.access.rbac.RbacPolicy = extdeps.access.rbac.RbacPolicy {
  users: [],
  roles: [
    extdeps.bmc.types.redfish_account_role_wire(role: AccountRoleAdministrator),
    extdeps.bmc.types.redfish_account_role_wire(role: extdeps.bmc.types.AccountRoleOperator),
    extdeps.bmc.types.redfish_account_role_wire(role: extdeps.bmc.types.AccountRoleReadOnly),
  ],
  user_assignments: [],
  permission_assignments: [
    redfish_privilege_assignment(privilege: PrivilegeLogin, role: AccountRoleAdministrator),
    redfish_privilege_assignment(privilege: extdeps.bmc.types.PrivilegeConfigureManager, role: AccountRoleAdministrator),
    redfish_privilege_assignment(privilege: extdeps.bmc.types.PrivilegeConfigureUsers, role: AccountRoleAdministrator),
    redfish_privilege_assignment(privilege: extdeps.bmc.types.PrivilegeConfigureComponents, role: AccountRoleAdministrator),
    redfish_privilege_assignment(privilege: extdeps.bmc.types.PrivilegeConfigureSelf, role: AccountRoleAdministrator),
    redfish_privilege_assignment(privilege: PrivilegeLogin, role: extdeps.bmc.types.AccountRoleOperator),
    redfish_privilege_assignment(privilege: extdeps.bmc.types.PrivilegeConfigureComponents, role: extdeps.bmc.types.AccountRoleOperator),
    redfish_privilege_assignment(privilege: extdeps.bmc.types.PrivilegeConfigureSelf, role: extdeps.bmc.types.AccountRoleOperator),
    redfish_privilege_assignment(privilege: PrivilegeLogin, role: extdeps.bmc.types.AccountRoleReadOnly),
    redfish_privilege_assignment(privilege: extdeps.bmc.types.PrivilegeConfigureSelf, role: extdeps.bmc.types.AccountRoleReadOnly),
  ],
  role_hierarchy: [],
}
