module extdeps.bmc.ssh

import std.types { NonEmptyStr, Bool }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/openbmc/docs/blob/master/console.md"
  }
}

service bmc.Ssh {
  operation PutFile {
    input { local_path: NonEmptyStr, remote_target: NonEmptyStr }
    output { success: Bool from "exit_success" }
    transport shell {
      argv: [
        "sshpass", "-e",
        "scp",
        "-o", "StrictHostKeyChecking=no",
        "-o", "UserKnownHostsFile=/dev/null",
        "{local_path}",
        "{remote_target}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "bmc scp put failed"
    }
    mock_response {
      0 => { success: true } "hermetic bmc.Ssh.PutFile success"
    }
  }
}
