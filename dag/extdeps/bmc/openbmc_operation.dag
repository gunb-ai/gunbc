module extdeps.bmc.openbmc_operation


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "www.freedesktop.org/software/systemd/man/latest/busctl.html",
  },
}

data openbmc_busctl_authority: extdeps.external_authority.ExternalAuthority = extdeps_external_authority_anchor

data openbmc_operation_authority_anchor_scaffold_note: String = "SCAFFOLD (mandatory-tag corpus cadence) - the host scanner reads an aliased anchor as absent, so the literal anchor grounds its projection while openbmc_busctl_authority remains the semantic authority name. This copy dissolves with the host seam under the corpus_scan_scaffold_note in v2.lens.mandatory_tag.corpus_scan when native witness realization runs the parse-grain corpus witness."

type OpenBmcOperation
  = OpenBmcReadFile { path: std.types.NonEmptyStr }
  | OpenBmcResolvePath { path: std.types.NonEmptyStr }
  | OpenBmcParentDirectory { path: std.types.NonEmptyStr }
  | OpenBmcSystemdIsActive { service: std.types.NonEmptyStr }
  | OpenBmcSystemdRestart { service: std.types.NonEmptyStr }
  | OpenBmcZoneFailsafe { zone_path: std.types.NonEmptyStr }
  | OpenBmcSensorServices { sensor_path: std.types.NonEmptyStr }
  | OpenBmcSensorValue { service: std.types.NonEmptyStr, sensor_path: std.types.NonEmptyStr }
  | OpenBmcSensorThreshold {
      service: std.types.NonEmptyStr,
      sensor_path: std.types.NonEmptyStr,
      threshold: OpenBmcThresholdProperty,
    }
  | OpenBmcFanConfigScalar {
      config_path: std.types.NonEmptyStr,
      query: OpenBmcFanConfigQuery,
    }
  | OpenBmcFanConfigValidate { config_path: std.types.NonEmptyStr }
  | OpenBmcFanConfigVerify {
      config_path: std.types.NonEmptyStr,
      desired: OpenBmcFanConfigDesired,
    }
  | OpenBmcPathIsWritable { path: std.types.NonEmptyStr }
  | OpenBmcPathExists { path: std.types.NonEmptyStr }
  | OpenBmcPathIsNonemptyFile { path: std.types.NonEmptyStr }
  | OpenBmcDiskUsageKib { path: std.types.NonEmptyStr }
  | OpenBmcFileSha256 { path: std.types.NonEmptyStr }
  | OpenBmcUtcTimestamp
  | OpenBmcMakeDirectory { path: std.types.NonEmptyStr, parents: Bool }
  | OpenBmcRemoveDirectory { path: std.types.NonEmptyStr }
  | OpenBmcRemoveFile { path: std.types.NonEmptyStr }
  | OpenBmcCopyFilePreservingMetadata {
      source_path: std.types.NonEmptyStr,
      destination_path: std.types.NonEmptyStr,
    }
  | OpenBmcRenameReplace {
      source_path: std.types.NonEmptyStr,
      destination_path: std.types.NonEmptyStr,
    }
  | OpenBmcSynchronizeFilesystems
  | OpenBmcWaitSeconds { duration: std.measure.Second }

type OpenBmcFanConfigQuery
  = OpenBmcStepwiseCount
  | OpenBmcMinimumDuty
  | OpenBmcZoneFailsafeDuty
  | OpenBmcSensorFailsafeDuty
  | OpenBmcPositiveHysteresis
  | OpenBmcNegativeHysteresis
  | OpenBmcReadingCount
  | OpenBmcOutputCount
  | OpenBmcReadingAt { index: Int }
  | OpenBmcOutputAt { index: Int }
  | OpenBmcFanControllerCount
  | OpenBmcFanControllerNameAt { index: Int }
  | OpenBmcFanInputCountAt { fan_index: Int }
  | OpenBmcFanInputAt { fan_index: Int, input_index: Int }

type OpenBmcThresholdProperty
  = OpenBmcWarningLow
  | OpenBmcCriticalLow

type OpenBmcFanConfigDesired {
  minimum_duty: std.measure.Percent
  zone_failsafe_duty: std.measure.Percent
  sensor_failsafe_duty: std.measure.Percent
  positive_hysteresis: std.measure.CelsiusDelta
  negative_hysteresis: std.measure.CelsiusDelta
  readings: List<std.measure.Celsius>
  outputs: List<std.measure.Percent>
  fan_controller_name: std.types.NonEmptyStr
  fan_inputs: List<std.types.NonEmptyStr>
}
