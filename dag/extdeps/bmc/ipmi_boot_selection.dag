module extdeps.bmc.ipmi_boot_selection

import std.types { NonEmptyStr, String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.toolchain.types { Architecture, Aarch64 }

// THE CLI SURFACE IS ipmitool's BOOT-FLAG ENCODER, not the IPMI wire itself. The IPMI 2.0
// chassis boot parameter has separate valid, persistence and boot-type bits; ipmitool exposes
// them through the final `options=...` argv word. The exact implementation authority is the
// upstream source whose option table names `valid`, `persistent` and `efiboot` and whose
// set-bootdev path sets the valid bit before writing parameter 5.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ipmitool/ipmitool/blob/master/lib/ipmi_chassis.c"
  }
}

type IpmiBootDevice
  = IpmiBootPxe
  | IpmiBootCdrom

type IpmiFirmwareBootMode
  = IpmiBootLegacy
  | IpmiBootEfi

type IpmiBootPersistence
  = IpmiBootOnce
  | IpmiBootPersistent

// A VALID BOOT SELECTION, NOT THREE INDEPENDENT SCALARS. This record is sole_constructor so a
// caller cannot place Aarch64 beside Legacy or manufacture an opaque options word. The only
// constructor currently exported is aarch64_uefi_once_boot_selection: its signature has no mode
// or persistence parameter, hence `(Aarch64, Legacy, Cdrom)` and persistent intake overrides
// have no source spelling at all. A future x86 legacy requirement adds a different constructor
// here; it does not widen this one with a Boolean or raw-string escape hatch.
//
// The wire and read-back spellings travel with the semantic axes because they are one CLI
// serialization. A caller selects `IpmiBootCdrom`; it never authors `cdrom`,
// an `options=` word, or one of the four strings used to adjudicate parameter 5.
// The chassis-bootdev device word is `ipmi_boot_device_label`; the options token is
// `ipmi_boot_selection_options_token`; parameter-5 readback words are
// `ipmi_boot_expected_*_rendering`. None of those strings is stored beside the axes.
type IpmiBootSelection sole_constructor {
  architecture: Architecture
  device: IpmiBootDevice
  firmware_mode: IpmiFirmwareBootMode
  persistence: IpmiBootPersistence
}

fn aarch64_uefi_once_boot_selection(device: IpmiBootDevice) -> IpmiBootSelection {
  match device {
    IpmiBootPxe => IpmiBootSelection {
      architecture: Aarch64,
      device: IpmiBootPxe,
      firmware_mode: IpmiBootEfi,
      persistence: IpmiBootOnce,
    }
    IpmiBootCdrom => IpmiBootSelection {
      architecture: Aarch64,
      device: IpmiBootCdrom,
      firmware_mode: IpmiBootEfi,
      persistence: IpmiBootOnce,
    }
  }
}

fn ipmi_boot_device_label(device: IpmiBootDevice) -> NonEmptyStr {
  match device {
    IpmiBootPxe => "pxe"
    IpmiBootCdrom => "cdrom"
  }
}

fn ipmi_boot_mode_label(mode: IpmiFirmwareBootMode) -> NonEmptyStr {
  match mode {
    IpmiBootLegacy => "legacy"
    IpmiBootEfi => "efi"
  }
}

fn ipmi_boot_persistence_label(persistence: IpmiBootPersistence) -> NonEmptyStr {
  match persistence {
    IpmiBootOnce => "once"
    IpmiBootPersistent => "persistent"
  }
}

fn ipmi_boot_selection_label(selection: IpmiBootSelection) -> NonEmptyStr {
  join([
    ipmi_boot_device_label(device: selection.device) as String,
    "/",
    ipmi_boot_mode_label(mode: selection.firmware_mode) as String,
    "/",
    ipmi_boot_persistence_label(persistence: selection.persistence) as String,
  ], "") as NonEmptyStr
}

fn ipmi_boot_selection_options_token(selection: IpmiBootSelection) -> NonEmptyStr {
  match selection.firmware_mode {
    IpmiBootEfi =>
      match selection.persistence {
        IpmiBootOnce => "efiboot"
        IpmiBootPersistent => "efiboot,persistent"
      }
    IpmiBootLegacy =>
      match selection.persistence {
        IpmiBootOnce => "valid"
        IpmiBootPersistent => "persistent"
      }
  }
}

data ipmi_boot_flag_valid_rendering: NonEmptyStr = "Boot Flag Valid"

fn ipmi_boot_expected_flag_rendering(selection: IpmiBootSelection) -> NonEmptyStr {
  match selection.device {
    IpmiBootPxe => ipmi_boot_flag_valid_rendering
    IpmiBootCdrom => ipmi_boot_flag_valid_rendering
  }
}

fn ipmi_boot_expected_device_rendering(selection: IpmiBootSelection) -> NonEmptyStr {
  match selection.device {
    IpmiBootPxe => "Force PXE"
    IpmiBootCdrom => "Force Boot from CD/DVD"
  }
}

fn ipmi_boot_expected_mode_rendering(selection: IpmiBootSelection) -> NonEmptyStr {
  match selection.firmware_mode {
    IpmiBootEfi => "BIOS EFI boot"
    IpmiBootLegacy => "BIOS PC Compatible (legacy) boot"
  }
}

fn ipmi_boot_expected_persistence_rendering(selection: IpmiBootSelection) -> NonEmptyStr {
  match selection.persistence {
    IpmiBootOnce => "Options apply to only next boot"
    IpmiBootPersistent => "Options apply to all future boots"
  }
}
