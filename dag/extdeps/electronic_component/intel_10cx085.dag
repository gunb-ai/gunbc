    ExternalAuthority { uri: Uri { scheme: Https, locator: "docs.altera.com/r/docs/683775/current/cyclone-10-gx-core-fabric-and-general-purpose-i/os-handbook/msel-pin-settings" } },
    ExternalAuthority { uri: Uri { scheme: Https, locator: "docs.altera.com/r/docs/683775/current/cyclone-10-gx-core-fabric-and-general-purpose-i/os-handbook/performing-bst" } },
