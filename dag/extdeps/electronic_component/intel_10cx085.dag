// MSEL[2..0], Table 71. The pins in the order the table's patterns read them.
data cyclone_10_gx_mode_select: ModeSelectTable = ModeSelectTable {
  pins: ["MSEL2", "MSEL1", "MSEL0"],
  settings: [
    ModeSelectSetting {
      pattern: "010",
      schemes: [ActiveSerial { data_lanes: 1, flash_family: "EPCQ-L" }, ActiveSerial { data_lanes: 4, flash_family: "EPCQ-L" }],
      power_on_reset: FastPowerOnReset,
      programming_supply_mv: [1800],
    },
    ModeSelectSetting {
      pattern: "011",
      schemes: [ActiveSerial { data_lanes: 1, flash_family: "EPCQ-L" }, ActiveSerial { data_lanes: 4, flash_family: "EPCQ-L" }],
      power_on_reset: StandardPowerOnReset,
      programming_supply_mv: [1800],
    },
    ModeSelectSetting {
      pattern: "000",
      schemes: [PassiveSerial, FastPassiveParallel { data_width: 8 }, FastPassiveParallel { data_width: 16 }, FastPassiveParallel { data_width: 32 }],
      power_on_reset: FastPowerOnReset,
      programming_supply_mv: [1200, 1500, 1800],
    },
    ModeSelectSetting {
      pattern: "001",
      schemes: [PassiveSerial, FastPassiveParallel { data_width: 8 }, FastPassiveParallel { data_width: 16 }, FastPassiveParallel { data_width: 32 }],
      power_on_reset: StandardPowerOnReset,
      programming_supply_mv: [1200, 1500, 1800],
    },
  ],
}

// A SAMPLE capture holds no reading at the transceivers' pins (Table 90, note 29).
data cyclone_10_gx_sample_coverage: SampleCoverage = SampleSkipsAdvancedIo

// The configuration signals that must be high for a boundary scan to read the pins (Performing BST).
// Neither has a boundary cell, so a capture cannot show that they were.
data cyclone_10_gx_boundary_scan_needs_high: List<NonEmptyStr> = ["nCONFIG", "nSTATUS"]

data cyclone_10_gx_10cx085yf672e6g: ElectronicComponentRow = ElectronicComponentRow {
  vendor: intel,
  ordering_code: "10CX085YF672E6G",
  package: "FBGA-672 (F672)",
  top_marking: Present { value: MarkDescribedNotStructured { text: "intel (logo) / Cyclone 10 / 10CX085YF672E6G / P <lot line> / TAIWAN, with a two-line trace code and a circled e1 below", why: "the document describes the mark and prints no glyph run" } },
  specification: ProgrammableLogicSpec { logic: ProgrammableLogicSpecification {
    logic_elements: 85000,
    memory: VolatileConfiguration,
    schemes: [
      JtagDownload,
      ActiveSerial { data_lanes: 1, flash_family: "EPCQ-L" },
      ActiveSerial { data_lanes: 4, flash_family: "EPCQ-L" },
      PassiveSerial,
      FastPassiveParallel { data_width: 8 },
      FastPassiveParallel { data_width: 16 },
      FastPassiveParallel { data_width: 32 },
      ConfigurationViaPcie { lane_widths: [1, 2, 4] },
    ],
    signals: [
      ConfigurationSignal { name: "nCONFIG", role: ConfigurationRequest },
      ConfigurationSignal { name: "nSTATUS", role: ConfigurationStatus },
      ConfigurationSignal { name: "CONF_DONE", role: ConfigurationDone },
      ConfigurationSignal { name: "INIT_DONE", role: InitializationDone },
    ],
    io_before_configuration: PullUpByStrap { strap: "nIO_PULLUP", pull_ups_on_at: false },
    mode_select: Present { value: cyclone_10_gx_mode_select },
    por_monitored_supplies: ["VCCBAT"],
  } },
  vendor_application_statements: [
    "Cyclone® 10 GX devices support 1.8 V programming voltage and several configuration schemes.",
    "The user I/O pins are tied to an internal weak pull-up until the device is configured.",
    "When this pin is pulled low, the nSTATUS and CONF_DONE pins are pulled low and all I/O pins are tied to an internal weak pull-up.",
    "CONF_DONE pin is high—indicates that configuration was successful.",
    "You can issue BYPASS, IDCODE, and SAMPLE JTAG instructions before, after, or during configuration without having to interrupt configuration.",
  ],
}
