      RegulatorPin { number: 7, name: "SW", role: SwitchNode },
      RegulatorPin { number: 8, name: "SW", role: SwitchNode },
      RegulatorPin { number: 9, name: "SW", role: SwitchNode },
      RegulatorPin { number: 10, name: "SW", role: SwitchNode },
      RegulatorPin { number: 15, name: "FB", role: FeedbackInput },
      RegulatorPin { number: 17, name: "SS", role: SoftStartProgram },
      RegulatorPin { number: 18, name: "GND", role: RegulatorGround },
      RegulatorPin { number: 20, name: "PGOOD", role: PowerGoodOpenDrain },
      RegulatorPin { number: 22, name: "EN/UVLO", role: EnableInput },
      RegulatorPin { number: 25, name: "GND", role: RegulatorGround },
