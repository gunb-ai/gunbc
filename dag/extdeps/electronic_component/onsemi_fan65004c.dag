// onsemi's FAN65004C, "Voltage Mode, 65 V, 6 A" synchronous buck regulator, datasheet FAN65004C/D Rev. 3,
// May 2022, read 2026-11-05; the PDF's SHA-256 is
// d68d7dcb63c02018531ed5334f66372c48ab30b253106f3fe9ea7e24e5d3b9ba. Cited: page 1 (features: 4.5 V to
// 65 V input, 6 A continuous output, PQFN35 6x6 mm CASE 483BE, and the marking diagram "FAN / 65004C /
// AWLYYWWG" with A assembly location, WL wafer lot, YY year, WW work week, G Pb-free), Table 2 on page 5
// (pins) and Table 4 on page 6 (VIN 4.5 V to 65 V); the ordering table is Table 9 on page 23.
//
// DECLARED FRONTIER CONSUMER: the post-marking-PR identification join in product.electrical.identification,
// which compares a board MarkingReading with `top_marking`. Nothing reads this row today.
//
// DISCREPANCY TO REPORT, NOT FORCED: the published third line has eight glyphs (AWLYYWWG); the board
// reading for U1_P3 has seven. Whether a trailing G is present is an operator photo question.
//
// PINS: only pins whose function maps to an existing RegulatorPinRole are listed (VIN 1-3 and 31-35, SW
// 7-10, FB 15, SS 17, GND 18 and 25, PGOOD 20, EN/UVLO 22, BOOT 29). PGND, NC, LG, MODE, ILIM, COMP, RT,
// SYNC, VCC, PVCC, EXTBIAS, HVBIAS and PH are in Table 2 but unmodeled: no consumer reads them. Switching
// frequency (100 kHz to 1 MHz set by RT) is not modeled for the same reason.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "www.onsemi.com/pdf/datasheet/fan65004c-d.pdf" }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.electronic_component.onsemi_fan65004c",
      decl_name: "fan65004c",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

