  ordering_code: "FAN65004C",
  package: "PQFN35 6 mm x 6 mm, CASE 483BE",
  top_marking: Present { value: MarkStructured { lines: [MarkLine { segments: [FixedGlyphs { text: "FAN" }] }, MarkLine { segments: [FixedGlyphs { text: "65004C" }] }, MarkLine { segments: [VariableField { legend: "A = assembly", width: Present { value: 1 } }, VariableField { legend: "WL = wafer lot", width: Present { value: 2 } }, VariableField { legend: "YY = year", width: Present { value: 2 } }, VariableField { legend: "WW = week", width: Present { value: 2 } }, FixedGlyphs { text: "G" }] }], coverage: Complete } },
  specification: SwitchingRegulatorSpec { regulator: SwitchingRegulatorSpecification {
