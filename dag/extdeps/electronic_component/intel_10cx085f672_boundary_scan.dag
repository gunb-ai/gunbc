// INTEL'S BOUNDARY-SCAN DESCRIPTION OF THE CYCLONE 10 GX 10CX085 IN THE F672 PACKAGE, AS ROWS. Transcribed
// by script from Intel's published description file, the copy the operator downloaded from the page
// cited below and handed over on 2026-11-12: "Copyright (C) 2023 Intel Corporation", "BSDL Version :
// 1.02", "Device : 10CX085F672", 92,937 bytes, sha256
// a5a5835866f784c39937973b9a6829f6e14ee665bd1d9aa9264c22614ef522d9. Its revision history reads 1.00
// (05/08/2017) "Initial release", 1.01 (25/12/2018) "Changed 24 No Connect Pins to I/O", 1.02
// (28/02/2023) "Updated IDCODE": an older copy of this description carries a different identification
// word, so a word read from a device is compared with this revision's.
//
// THE FILE SAYS WHAT IT IS FOR: "This file supports boundary scan testing (BST) before device
// configuration." What the cells of a configured device hold is the design's, and the file's own
// warning (design_warning below, verbatim as the file concatenates it) says differential pairs need
// changes to it after configuration.
//
// CARRIED: the instruction register's length and every instruction with its patterns; the capture
// pattern; the identification register's fields; the boundary register's length and all of its cells;
// the ball map; the clock's maximum; the design warning. NOT CARRIED: port directions, the
// differential port grouping and the IEEE 1149.6 pin-behaviour attributes, which nothing here reads.
// The configuration pins nSTATUS, CONF_DONE, nCONFIG and nCE are in the ball map and have no boundary
// cell (the file declares them linkage), so a boundary capture does not hold them.
//
// THE PRIVATE INSTRUCTION. The file lists ten patterns under one name and says of them: "must not be
// used as they may render the device inoperable". They are rows here so that a plan can refuse them by
// pattern as well as by name; nothing sends one.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.altera.com/v/u/resources/651419/current"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.electronic_component.intel_10cx085f672_boundary_scan",
      decl_name: "cyclone_10_gx_10cx085_f672_boundary_scan",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE COMPONENT THIS DESCRIPTION IS OF. The file names the device 10CX085 and the package F672; the
// ordering code 10CX085YF672E6G is that member in that package by Intel's code convention, as the
// component's own module reads it (extdeps.electronic_component.intel_10cx085).
data cyclone_10_gx_10cx085_f672_described_component: ElectronicComponentRow = cyclone_10_gx_10cx085yf672e6g

fn unbonded(n: Nat, design: CellDesign, function: CellFunction, safe: SafeBit) -> BoundaryCell {
  BoundaryCell { number: n, design: design, port: Absent, function: function, safe: safe, enable: Absent }
}

fn bonded(n: Nat, design: CellDesign, port: NonEmptyStr, function: CellFunction, safe: SafeBit) -> BoundaryCell {
  BoundaryCell { number: n, design: design, port: Present { value: port }, function: function, safe: safe, enable: Absent }
}

// An output cell. Every output row of this file disables on a control value of 1 and goes to "Z".
fn driver(n: Nat, design: CellDesign, port: NonEmptyStr, safe: SafeBit, control: Nat) -> BoundaryCell {
  BoundaryCell { number: n, design: design, port: Present { value: port }, function: CellOutputThreeState, safe: safe, enable: Present { value: OutputEnable { control_cell: control, disabling_value: true, disabled_state: "Z" } } }
}

