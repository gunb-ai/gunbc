  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.electronic_component.bourns_5_0smdj60a",
      decl_name: "tvs_5_0smdj60a",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data tvs_5_0smdj60a: ElectronicComponentRow = ElectronicComponentRow {
  vendor: bourns,
  ordering_code: "5.0SMDJ60A",
  package: "DO-214AB (SMC)",
  top_marking: "5PGK",
  specification: TvsDiodeSpec { tvs: TvsSpecification {
    polarity: Unidirectional,
    reverse_standoff: volt(count: 60),
    breakdown_minimum: millivolt(count: 66700),
    breakdown_maximum: millivolt(count: 73700),
  } },
