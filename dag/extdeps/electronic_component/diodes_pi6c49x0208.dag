  vendor: diodes_incorporated,
  ordering_code: "PI6C49X0208ZHIEX",
  package: "W-QFN5050-32 (ZH), 32 pins",
  top_marking: Present { value: "PI6C49X / 0208ZHIE / YYWWXX" },
  specification: ClockFanoutSpec { clock: ClockFanoutSpecification {
    inputs: 3,
    outputs: 8,
    supplies: [
      MillivoltRange { minimum: millivolt(count: 2500), maximum: millivolt(count: 2500) },
      MillivoltRange { minimum: millivolt(count: 3300), maximum: millivolt(count: 3300) },
    ],
