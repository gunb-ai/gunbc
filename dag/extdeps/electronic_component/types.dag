module extdeps.electronic_component.types

import std.logic { Bool }
import std.types { List, NonEmptyStr, String }
import std.nat { Nat }
import std.optional { Absent, Present }
import std.measure { Volt, Millivolt, Milliampere, Micrometer, Ampere }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Electronic_component"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.electronic_component.types",
      decl_name: "ElectronicComponentRow",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// A PART'S DATASHEET FACTS, BY PART CLASS. A photograph of a populated board shows top markings; a
// datasheet binds a marking to an ordering code and to that class's ratings. A TVS diode, a capacitor,
// a MOSFET, a temperature sensor, a connector and a hot-swap controller have different relevant
// specifications, so each class carries its own record and a row carries exactly one of them -- never
// one bag of optional fields where a capacitor's "drain current" is merely absent.
//
// Every figure is a typed measure; the only strings are transcriptions -- the ordering code, the
// package designator, the top marking, a pin's datasheet name, a series name, and
// vendor_application_statements, which are the vendor's own sentences verbatim: a part designed for
// one application is weak evidence of the circuit it sits in, and the evidence is the vendor's
// sentence rather than a summary of it. No consumer derives a fact from those strings.

type TvsPolarity
  = Unidirectional
  | Bidirectional

// A TVS diode's reverse working standoff is the highest voltage it holds off without conducting, so it
// bounds the normal operating voltage of the rail it sits across; the breakdown range is at the
// datasheet's stated test current.
type TvsSpecification {
  polarity: TvsPolarity
  reverse_standoff: Volt
  breakdown_minimum: Millivolt
  breakdown_maximum: Millivolt
}

/// A rectifier diode. One rating is carried, the one a consumer reads: the peak repetitive
/// reverse voltage V_RRM, the figure a rectifier is chosen by. It is a different quantity
/// from a TVS reverse standoff -- a TVS clamps and a rectifier blocks -- so it is a
/// different arm, and voltage_withstand labels it RectifierRepetitivePeak rather than
/// borrowing the TVS name.
type RectifierSpecification {
  reverse_repetitive_peak: Volt
}

type CapacitorSpecification {
  capacitance_microfarads: Nat
  rated_voltage: Volt
}

type FetChannel
  = NChannel
  | PChannel

type FetTerminalRole
  = FetGate
  | FetSource
  | FetDrain

// A package terminal: a numbered pin or the package's tab.
type PackageTerminal
  = NumberedPin { number: Nat }
  | PackageTab

type FetTerminal {
  terminal: PackageTerminal
  role: FetTerminalRole
}

type MosfetSpecification {
  channel: FetChannel
  drain_source_maximum: Volt
  continuous_drain_current: Milliampere
  terminals: List<FetTerminal>
}

type SerialBus
  = I2cOrSmbus
  | SpiInterface

type SensorPinRole
  = SerialData { bus: SerialBus, open_drain: Bool }
  | SerialClock { bus: SerialBus }
  | AlertOutput { open_drain: Bool }
  | GroundReturn
  | SupplyInput
  | AddressSelect { bit: Nat }

type SensorPin {
  number: Nat
  name: NonEmptyStr
  role: SensorPinRole
}

type MillivoltRange {
  minimum: Millivolt
  maximum: Millivolt
}

type TemperatureSensorSpecification {
  supply: MillivoltRange
  bus: SerialBus
  pins: List<SensorPin>
}

// A HOT-SWAP CONTROLLER'S PINS, BY THE FUNCTION ITS DATASHEET GIVES EACH. Supply, ground and bus pins
// carry the shared SensorPinRole rather than a second name for the same function.
type ControllerPinRole
  = GateDrive
  | OutputFeedback
  | CurrentSenseInput
  | SupplyKelvinSense
  | UndervoltageEnable
  | OvervoltageLockout
  | PowerGoodOutput
  | PowerGoodFeedback
  | FaultTimer
  | FaultRetryMode
  | PowerLimitSet
  | CurrentLimitRange
  | InternalRegulatorOutput
  | ReferenceOutput
  | TemperatureDiodeInput
  | AuxiliaryVoltageInput
  | NoConnection
  | SharedPinRole { role: SensorPinRole }

type ControllerPin {
  number: Nat
  name: NonEmptyStr
  role: ControllerPinRole
}

// A datasheet threshold over its stated minimum, typical and maximum.
type ThresholdWindow {
  minimum: Millivolt
  typical: Millivolt
  maximum: Millivolt
}

// The pin thresholds a reading is judged against: below enable_threshold's minimum the gate is held
// off; at or above overvoltage_threshold's minimum the controller may lock out.
type HotSwapControllerSpecification {
  pins: List<ControllerPin>
  enable_threshold: ThresholdWindow
  overvoltage_threshold: ThresholdWindow
}

// A SWITCHING REGULATOR WITH ITS SWITCHES INSIDE: the pins a bench reading lands on are named by what
// the datasheet says each one does, so a lead that reads to the return is read as GND, SW, VIN or
// BST by the row and not by the reader. The switch node is the pin the inductor hangs on; the
// bootstrap pin is the high-side driver's floating supply, joined to the switch node outside the part
// through a capacitor (and often a series resistor); power-good is an open drain that needs an
// external pull-up, which is why it reads as a resistance to some rail. Switching frequency and the
// on-resistances are not modeled: no consumer reads them. The first consumer re-adds them, shaping
// frequency as fixed or programmable (a programmable part has no single figure) and the on-resistances
// as optional where the document states none.
type RegulatorPinRole
  = RegulatorSupplyInput
  | SwitchNode
  | RegulatorGround
  | BootstrapSupply
  | EnableInput
  | SoftStartProgram
  | FeedbackInput
  | PowerGoodOpenDrain
  // The arms below are named as the datasheets name each pin's function. FAN65004C/D Rev. 3 Table 2
  // (page 5): NC, LG, MODE, ILIM, COMP, RT, SYNC, VCC, PVCC, EXTBIAS, HVBIAS, VINMON (current sense positive pin), PH, PGND.
  // MPQ8633A Rev. 1.1 pin table (page 11): CS, MODE, TRK/REF, RGND, VCC, PGND.
  | PowerGround
  | RegulatorNoConnection
  | LowSideGateDrive
  | RegulatorModeSelect
  | CurrentLimitSet
  | CompensationOutput
  | FrequencySet
  | SynchronizationPort
  | BiasSupply
  | BootstrapSwitchReturn
  | CurrentSense
  | TrackingReference
  | RemoteSenseGround

type RegulatorPin {
  number: Nat
  name: NonEmptyStr
  role: RegulatorPinRole
}

type SwitchingRegulatorSpecification {
  pins: List<RegulatorPin>
  input: MillivoltRange
  continuous_output_current: Ampere
}

type ConnectorOrientation
  = VerticalMount
  | RightAngleMount

type BoardTermination
  = SurfaceMountTermination
  | ThroughHoleTermination
  | PressFitTermination

type ConnectorMatingStanding
  = MatingStandardUnread { obligation: NonEmptyStr }
  | MatesCardOfThickness { card_thickness: Micrometer }

type ConnectorSpecification {
  series: NonEmptyStr
  positions: Nat
  rows: Nat
  pitch: Micrometer
  orientation: ConnectorOrientation
  termination: BoardTermination
  mating: ConnectorMatingStanding
}

// A LOGIC PIN'S ROLE ON A SHIFT REGISTER, as its datasheet's pin table names it. A parallel input is
// read by the part; a serial output is driven by it; the control pins are driven by whatever clocks
// it. Which way a net at one of these pins runs is the role's, not the package's.
type LogicPinRole
  = ParallelInput { bit: Nat }
  | SerialOutput { inverted: Bool }
  | SerialInput
  | ShiftLoadControl
  | ClockInput
  | ClockInhibit
  | LogicGround
  | LogicSupply

type LogicPin {
  number: Nat
  name: NonEmptyStr
  role: LogicPinRole
}

type ShiftRegisterSpecification {
  bits: Nat
  supply: MillivoltRange
  pins: List<LogicPin>
}

// A DUAL-SUPPLY LEVEL TRANSLATOR'S PINS, BY THE FUNCTION ITS DATASHEET GIVES EACH. A data port is one
// end of a channel and carries signal either way; which way is set by that channel's direction input,
// and the output enable places every output in three-state. The two supplies are named apart because
// each port is referenced to its own.
type TranslatorPinRole
  = PortA { channel: Nat }
  | PortB { channel: Nat }
  | DirectionControl { channel: Nat }
  | OutputEnable { three_state_when_high: Bool }
  | TranslatorGround
  | SupplyA
  | SupplyB

type TranslatorPin {
  number: Nat
  name: NonEmptyStr
  role: TranslatorPinRole
}

type LevelTranslatorSpecification {
  channels: Nat
  supply_a: MillivoltRange
  supply_b: MillivoltRange
  pins: List<TranslatorPin>
}

// A SINGLE LOGIC GATE'S PINS, BY THE FUNCTION ITS DATASHEET GIVES EACH: inputs, the output, ground and
// supply. The function is the AND of its inputs, inverted or not: the two-input positive AND gate read
// so far is { inputs: 2, inverted_output: false }, a NAND would be the same with the output inverted.
type GateFunction {
  inputs: Nat
  inverted_output: Bool
}

type GatePinRole
  = GateInput { name: NonEmptyStr }
  | GateOutput
  | GateGround
  | GateSupply

type GatePin {
  number: Nat
  name: NonEmptyStr
  role: GatePinRole
}

type LogicGateSpecification {
  function: GateFunction
  supply: MillivoltRange
  pins: List<GatePin>
}

// A PROGRAMMABLE-LOGIC DEVICE, BY WHAT DECIDES WHETHER IT IS DOING ANYTHING. Its function is whatever
// configuration it holds, which this row cannot carry; what it carries is how that configuration
// arrives (volatile parts load it at every power-up over one of the declared schemes), the signals that
// request and report configuration, and what its user pins do before it is configured. A device whose
// user pins are weak pull-ups until CONF_DONE drives nothing on a board until that signal says so.
type ConfigurationMemory
  = VolatileConfiguration
  | NonVolatileConfiguration

type ConfigurationScheme
  = ActiveSerial { data_lanes: Nat, flash_family: NonEmptyStr }
  | AvalonStreaming
  | JtagDownload

type ConfigurationSignalRole
  = ConfigurationRequest
  | ConfigurationStatus
  | ConfigurationDone
  | InitializationDone
  | ModeSelect

type ConfigurationSignal {
  name: NonEmptyStr
  role: ConfigurationSignalRole
}

// What a user pin does before the device is configured: a weak pull-up, high impedance, or one of the
// two as a strap on the named pin selects.
type UnconfiguredIoState
  = WeakPullUp
  | HighImpedance
  | PullUpByStrap { strap: NonEmptyStr }

// por_monitored_supplies names the rails the device's power-on reset watches beyond its core and I/O
// supplies; a device whose reset holds until every one is present configures nothing while one is
// missing, however the others read.
type ProgrammableLogicSpecification {
  logic_elements: Nat
  memory: ConfigurationMemory
  schemes: List<ConfigurationScheme>
  signals: List<ConfigurationSignal>
  io_before_configuration: UnconfiguredIoState
  por_monitored_supplies: List<NonEmptyStr>
}

// The signal that reports initialization complete and user mode entered, if the row names one; it is
// optional on the device and stronger evidence than configuration done.
fn initialization_done_signal(spec: ProgrammableLogicSpecification) -> ConfigurationSignal? {
  (filter(spec.signals, s => match s.role { InitializationDone => true, _ => false })).first()
}

// A SERIAL FLASH, BY WHAT A READER OF IT NEEDS: capacity, supply, how many data lanes, the clock
// ceiling, the JEDEC signature a bus read returns, and whether it has a reset pin.
type SerialFlashSpecification {
  capacity_mbit: Nat
  supply: MillivoltRange
  data_lanes: Nat
  clock_mhz: Nat
  jedec_signature: NonEmptyStr
  dies: Nat
  reset_pin: Bool
}

// A PLATFORM ROOT OF TRUST, BY WHAT IT PROTECTS. It sits between a processor and the flash that
// processor boots from; secure boot means the flash's content is authenticated before the processor
// runs, so on a board the processor it guards does nothing until it is released. Which signal releases
// the processor is a datasheet fact not yet carried.
type RootOfTrustProtection
  = SpiFlashRuntimeProtection
  | I2cSmbusFiltering
  | SecureBoot
  | ComponentAttestation
  | LifecycleManagement

type RootOfTrustSpecification {
  core: NonEmptyStr
  protections: List<RootOfTrustProtection>
}

fn guards_boot(spec: RootOfTrustSpecification) -> Bool {
  any(spec.protections, p => match p { SecureBoot => true, _ => false })
}

// The signal that reports a completed configuration, if the row names one.
fn configuration_done_signal(spec: ProgrammableLogicSpecification) -> ConfigurationSignal? {
  (filter(spec.signals, s => match s.role { ConfigurationDone => true, _ => false })).first()
}

type GatePinStanding
  = GateInputPin { pin: GatePin }
  | GateOutputPin { pin: GatePin }
  | GateSupplyOrReturn { pin: GatePin }
  | NoGatePinNumbered { number: Nat }

fn gate_pin_standing(spec: LogicGateSpecification, number: Nat) -> GatePinStanding {
  match (filter(spec.pins, p => p.number == number)).first() {
    Absent => NoGatePinNumbered { number: number }
    Present { value: pin } => match pin.role {
      GateInput { name: _ } => GateInputPin { pin: pin }
      GateOutput => GateOutputPin { pin: pin }
      GateGround => GateSupplyOrReturn { pin: pin }
      GateSupply => GateSupplyOrReturn { pin: pin }
    }
  }
}

// What a net meeting a translator pin is, from the pin's role: one end of a data channel (its direction
// a live fact of that channel's direction input, not of the pin), a direction or enable input the part
// receives, its supply or return, or no such pin.
type TranslatorPinStanding
  = DataPortOfChannel { pin: TranslatorPin, channel: Nat, b_side: Bool }
  | ControlIntoTheTranslator { pin: TranslatorPin }
  | TranslatorSupplyOrReturn { pin: TranslatorPin }
  | NoTranslatorPinNumbered { number: Nat }

fn translator_pin_standing(spec: LevelTranslatorSpecification, number: Nat) -> TranslatorPinStanding {
  match (filter(spec.pins, p => p.number == number)).first() {
    Absent => NoTranslatorPinNumbered { number: number }
    Present { value: pin } => match pin.role {
      PortA { channel } => DataPortOfChannel { pin: pin, channel: channel, b_side: false }
      PortB { channel } => DataPortOfChannel { pin: pin, channel: channel, b_side: true }
      DirectionControl { channel: _ } => ControlIntoTheTranslator { pin: pin }
      OutputEnable { three_state_when_high: _ } => ControlIntoTheTranslator { pin: pin }
      TranslatorGround => TranslatorSupplyOrReturn { pin: pin }
      SupplyA => TranslatorSupplyOrReturn { pin: pin }
      SupplyB => TranslatorSupplyOrReturn { pin: pin }
    }
  }
}

// Which way a net meeting a shift-register pin runs, from the pin's role: read into the part, driven
// out of it, a control or clock the part receives, its supply or return, or no such pin.
type LogicPinDirection
  = ReadByThePart { pin: LogicPin }
  | DrivenByThePart { pin: LogicPin }
  | ControlOrClockIntoThePart { pin: LogicPin }
  | SupplyOrReturn { pin: LogicPin }
  | NoLogicPinNumbered { number: Nat }

fn logic_pin_direction(spec: ShiftRegisterSpecification, number: Nat) -> LogicPinDirection {
  match (filter(spec.pins, p => p.number == number)).first() {
    Absent => NoLogicPinNumbered { number: number }
    Present { value: pin } => match pin.role {
      ParallelInput { bit: _ } => ReadByThePart { pin: pin }
      SerialInput => ReadByThePart { pin: pin }
      SerialOutput { inverted: _ } => DrivenByThePart { pin: pin }
      ShiftLoadControl => ControlOrClockIntoThePart { pin: pin }
      ClockInput => ControlOrClockIntoThePart { pin: pin }
      ClockInhibit => ControlOrClockIntoThePart { pin: pin }
      LogicGround => SupplyOrReturn { pin: pin }
      LogicSupply => SupplyOrReturn { pin: pin }
    }
  }
}

type ComponentSpecification
  = TvsDiodeSpec { tvs: TvsSpecification }
  | CapacitorSpec { capacitor: CapacitorSpecification }
  | MosfetSpec { mosfet: MosfetSpecification }
  | TemperatureSensorSpec { sensor: TemperatureSensorSpecification }
  | ConnectorSpec { connector: ConnectorSpecification }
  | HotSwapControllerSpec { controller: HotSwapControllerSpecification }
  | ShiftRegisterSpec { register: ShiftRegisterSpecification }
  | LevelTranslatorSpec { translator: LevelTranslatorSpecification }
  | LogicGateSpec { gate: LogicGateSpecification }
  | ProgrammableLogicSpec { logic: ProgrammableLogicSpecification }
  | RootOfTrustSpec { root_of_trust: RootOfTrustSpecification }
  | SerialFlashSpec { flash: SerialFlashSpecification }
  | SwitchingRegulatorSpec { regulator: SwitchingRegulatorSpecification }
  | BusMultiplexerSpec { multiplexer: BusMultiplexerSpecification }
  | UsbHubSpec { hub: UsbHubSpecification }
  | ClockFanoutSpec { clock: ClockFanoutSpecification }
  | RectifierSpec { rectifier: RectifierSpecification }

/// A switch or multiplexer on a shared bus: `channels` independent buses, each reachable from
/// `inputs_per_channel` candidates, powered by `supplies` (a translating switch lists one range per
/// rail domain, so a single-supply part lists one). This one shape covers both the TCA9546A (four
/// channels, one input each, one rail) and the PI3CH480QE (four channels, two inputs each, two
/// rails); minting an "I2C switch" type beside a "bus multiplexer" type would name the same
/// decomposition twice, and the two would drift.
///
/// A consumer reads it to say how many buses a position reaches and at how many candidates each
/// is loaded -- which is what the position-grain net relation needs. Terminal grain needs pin
/// numbers, and those come from the datasheet only when a pin-level relation actually asks.
type BusMultiplexerSpecification {
  channels: Nat
  inputs_per_channel: Nat
  supplies: List<MillivoltRange>
}

/// A USB hub: `downstream_ports` ports facing devices, `upstream_ports` facing the host, at the
/// generator named in `generation` (kept as the vendor's own string, because "USB 3.2 x1 Gen1" is
/// SuperSpeed 5 Gbps under a name only the vendor chose; inventing a speed type for one row would
/// be a second home for a fact USB-IF already owns).
type UsbHubSpecification {
  downstream_ports: Nat
  upstream_ports: Nat
  generation: NonEmptyStr
  /// The package's ball names, when a pin-level consumer needs them. Absent means NOT READ, which
  /// is different from an empty list: an empty list would claim the part has no pins to name.
  pins: List<NonEmptyStr>?
}

/// A clock fanout buffer: `inputs` selectable reference sources, `outputs` copies of the chosen one,
/// at the core supplies the vendor's own list offers. `pins` holds what the pin table says -- "number
/// NAME (type)" strings -- because no pin-level consumer exists yet: typing roles for a table nobody
/// reads would be a second authority waiting for a caller. Absent means NOT READ, which is not the
/// same claim as an empty list.
type ClockFanoutSpecification {
  inputs: Nat
  outputs: Nat
  supplies: List<MillivoltRange>
  pins: List<NonEmptyStr>?
}

/// One segment of one printed line of a manufacturer's top mark, in the document's own terms:
/// glyphs the document prints verbatim, or a field the document's legend names and whose glyphs vary
/// per unit. `legend` is the VENDOR's own cited wording ("YY = year"), never a cross-vendor alphabet.
/// `width` is the glyph count only where the document states one; `Absent` is "not stated", not zero.
type MarkSegment
  = FixedGlyphs { text: NonEmptyStr }
  | VariableField { legend: NonEmptyStr, width: Nat? }

type MarkLine {
  segments: List<MarkSegment>
}

/// A top mark as the cited document PUBLISHES it. `MarkStructured` lists the lines the document
/// prints, in order; a line or position the document does not describe is omitted, so the absence of a
/// further line is NOT a claim that none is printed. `MarkDescribedNotStructured` is the honest standing
/// of a document that describes the mark in prose, lists alternatives, or does not say which positions
/// are fixed or variable: the text is kept, `why` names what keeps it from being structured, and a
/// comparison against it can only be `Undecidable` (consumed by the board-reading-to-published-mark join).
type PublishedMark
  = MarkStructured { lines: List<MarkLine> }
  | MarkDescribedNotStructured { text: NonEmptyStr, why: NonEmptyStr }

// The glyphs of a mark whose LISTED structure is exactly one line holding exactly one fixed run; any
// other shape, and any mark that is only described, has no such run. It reads the list as listed: a
// row whose document names further lines without printing them is MarkDescribedNotStructured, never
// a one-line MarkStructured, so this never reports a described mark's one printed run as its only run. Consumed by the FSV20100V device-code join and the
// fsv row witnesses; the general comparison of a reading with a published mark is the join PR's.
fn mark_sole_fixed_glyphs(m: PublishedMark) -> NonEmptyStr? {
  match m {
    MarkDescribedNotStructured { text: _, why: _ } => Absent
    MarkStructured { lines } => if lines.length() == 1 {
      match lines.first() {
        Absent => Absent
        Present { value: line } => if line.segments.length() == 1 {
          match line.segments.first() {
            Absent => Absent
            Present { value: seg } => match seg {
              FixedGlyphs { text } => Present { value: text }
              VariableField { legend: _, width: _ } => Absent
            }
          }
        } else { Absent }
      }
    } else { Absent }
  }
}

fn row_sole_fixed_glyphs(row: ElectronicComponentRow) -> NonEmptyStr? {
  match row.top_marking {
    Absent => Absent
    Present { value: m } => mark_sole_fixed_glyphs(m: m)
  }
}

/// The manufacturer's own top mark. `Absent` means the cited document's marking table has not been read
/// -- it is never filled with what this repository's own bodies print: an observation this repository
/// makes is a receipt in the observing layer (product.electrical.identification's MarkingReading, or the
/// board's per-position receipts), and the unread table is a coverage obligation carried by the claim
/// that uses the row (DESIGN section 3). A document read to its marking table that publishes no top mark
/// is a third state with no row yet (PI3CH480ZHD: "Top mark is not available at this time"); it is added
/// as an arm of PublishedMark when a row needs it.
type ElectronicComponentRow {
  vendor: Vendor<Hardware>
  ordering_code: NonEmptyStr
  package: NonEmptyStr
  top_marking: PublishedMark?
  specification: ComponentSpecification
  vendor_application_statements: List<NonEmptyStr>
}

// One row is one maker's orderable part: two makers can publish the same ordering code (Bourns' and
// AOS's 5.0SMDJ60A), so a row is the vendor and the code together.
fn electronic_component_row_eq(a: ElectronicComponentRow, b: ElectronicComponentRow) -> Bool {
  (a.vendor.legal_name as String) == (b.vendor.legal_name as String) && (a.ordering_code as String) == (b.ordering_code as String)
}

// THE ONE PROJECTION A RAIL BOUND CONSUMES: the highest voltage the part tolerates across its rated
// terminals, with what kind of limit it is. Each kind bounds the rail the part sits across from above;
// none says what the rail IS. A sensor, connector or controller projects nothing.
type VoltageWithstandKind
  = TvsReverseStandoff
  | CapacitorRatedVoltage
  | DrainSourceMaximum
  | FuseInterruptRating
  | RectifierRepetitivePeak

type VoltageWithstand {
  kind: VoltageWithstandKind
  maximum: Volt
}

fn voltage_withstand(spec: ComponentSpecification) -> VoltageWithstand? {
  match spec {
    TvsDiodeSpec { tvs } => Present { value: VoltageWithstand { kind: TvsReverseStandoff, maximum: tvs.reverse_standoff } }
    RectifierSpec { rectifier } => Present { value: VoltageWithstand { kind: RectifierRepetitivePeak, maximum: rectifier.reverse_repetitive_peak } }
    CapacitorSpec { capacitor } => Present { value: VoltageWithstand { kind: CapacitorRatedVoltage, maximum: capacitor.rated_voltage } }
    MosfetSpec { mosfet } => Present { value: VoltageWithstand { kind: DrainSourceMaximum, maximum: mosfet.drain_source_maximum } }
    TemperatureSensorSpec { sensor: _ } => Absent
    ConnectorSpec { connector: _ } => Absent
    HotSwapControllerSpec { controller: _ } => Absent
    ShiftRegisterSpec { register: _ } => Absent
    LevelTranslatorSpec { translator: _ } => Absent
    LogicGateSpec { gate: _ } => Absent
    ProgrammableLogicSpec { logic: _ } => Absent
    RootOfTrustSpec { root_of_trust: _ } => Absent
    SerialFlashSpec { flash: _ } => Absent
    SwitchingRegulatorSpec { regulator: _ } => Absent
    BusMultiplexerSpec { multiplexer: _ } => Absent
    UsbHubSpec { hub: _ } => Absent
    ClockFanoutSpec { clock: _ } => Absent
  }
}

// ── THE REFERENCE DESIGNATOR: ITS SPELLING IS ITS IDENTITY ──────────────────────────────────────
//
// One position on one assembly, named the way the silkscreen names it. THE VERBATIM TEXT IS THE IDENTITY:
// U1_2 and U12 are two components, U3_2 and U32 two components, U3_P3 and U3_3 two positions, U1_P1 and
// U1_P5 two channels. This is not pedantry -- the atlas cleanup of 2026-11-03 normalised designators by
// stripping underscores and so merged U1_2 into U12, U2_2 into U22 and U3_2 into U32: it minted positions
// NVIDIA may never have placed, lost the parts that were really in the other footprint, and moved a
// PCA9617A from U12 to U1_2 on nothing but a tidied string. The merged row looked exactly like a good row.
//
// So: normalisation may produce a field for SEARCHING -- a fold, a family prefix, a sort key, a grouping
// for a zone -- and may never produce identity. Two designators that share a search key are still two
// components, and no position is resolved by anything but the verbatim text. No search key is defined here,
// because nothing groups by one yet; when the function zones want one it must be its own field, derived,
// and never what a position is looked up by.
//
// It lives in the component vocabulary rather than the board layer because both layers need ONE rule and
// the design-fact layer may not import the observation layer: NVIDIA's positions (extdeps.nvidia.p4261) and
// our silkscreen readings (product.p4261) resolve against each other, and a rule about identity that two
// sides share has to sit where both can reach it.
type Designator {
  verbatim: NonEmptyStr
}

// A designator as it was read. No case folding, no punctuation removal, no suffix-boundary rewriting, no
// leading-zero stripping -- those are the operations that made the 2026-11-03 corruption invisible.
fn designator_of(verbatim: NonEmptyStr) -> Designator {
  Designator { verbatim: verbatim }
}

// What the silkscreen says, for printing and for a search key to be derived FROM. Not a comparison.
fn designator_text(designator: Designator) -> NonEmptyStr {
  designator.verbatim
}

// Identity: character for character, with nothing done to either side first. Every comparison of
// designators in the model goes through this, so there is exactly one place a normalisation could creep
// back in -- and `p4261_designator_identity_witness.dag` holds it to the five pairs the atlas broke.
fn designator_eq(a: Designator, b: Designator) -> Bool {
  (designator_text(designator: a) as String) == (designator_text(designator: b) as String)
}
