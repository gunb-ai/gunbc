module extdeps.electronic_component.types

import std.logic { Bool }
import std.types { List, NonEmptyStr }
import std.nat { Nat }
import std.measure { Volt, Millivolt, Ampere, Micrometer }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import std.optional { Absent }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Electronic_component"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.electronic_component.types",
      decl_name: "ElectronicComponentRow",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// A PART'S DATASHEET FACTS, BY PART CLASS. A photograph of a populated board shows top markings; a
// datasheet binds a marking to an ordering code and to that class's ratings. A TVS diode, a capacitor,
// a MOSFET, a temperature sensor and a connector have different relevant specifications, so each class
// carries its own record and a row carries exactly one of them -- never one bag of optional fields
// where a capacitor's "drain current" is merely absent.
//
// Every figure is a typed measure; the only strings are transcriptions -- the ordering code, the
// package designator, the top marking, a pin's datasheet name, a series name, and
// vendor_application_statements, which are the vendor's own sentences verbatim: a part designed for
// one application is weak evidence of the circuit it sits in, and the evidence is the vendor's
// sentence rather than a summary of it. No consumer derives a fact from those strings.

type TvsPolarity
  = Unidirectional
  | Bidirectional

// A TVS diode's reverse working standoff is the highest voltage it holds off without conducting, so it
// bounds the normal operating voltage of the rail it sits across; the breakdown range is at the
// datasheet's stated test current.
type TvsSpecification {
  polarity: TvsPolarity
  reverse_standoff: Volt
  breakdown_minimum: Millivolt
  breakdown_maximum: Millivolt
}

type CapacitorSpecification {
  capacitance_microfarads: Nat
  rated_voltage: Volt
}

type FetChannel
  = NChannel
  | PChannel

type FetTerminalRole
  = FetGate
  | FetSource
  | FetDrain

// A package terminal: a numbered pin or the package's tab.
type PackageTerminal
  = NumberedPin { number: Nat }
  | PackageTab

type FetTerminal {
  terminal: PackageTerminal
  role: FetTerminalRole
}

type MosfetSpecification {
  channel: FetChannel
  drain_source_maximum: Volt
  continuous_drain_current: Ampere
  terminals: List<FetTerminal>
}

type SerialBus
  = I2cOrSmbus
  | SpiInterface

type SensorPinRole
  = SerialData { bus: SerialBus, open_drain: Bool }
  | SerialClock { bus: SerialBus }
  | AlertOutput { open_drain: Bool }
  | GroundReturn
  | SupplyInput
  | AddressSelect { bit: Nat }

type SensorPin {
  number: Nat
  name: NonEmptyStr
  role: SensorPinRole
}

type MillivoltRange {
  minimum: Millivolt
  maximum: Millivolt
}

type TemperatureSensorSpecification {
  supply: MillivoltRange
  bus: SerialBus
  pins: List<SensorPin>
}

type ConnectorOrientation
  = VerticalMount
  | RightAngleMount

type BoardTermination
  = SurfaceMountTermination
  | ThroughHoleTermination
  | PressFitTermination

type ConnectorMatingStanding
  = MatingStandardUnread { obligation: NonEmptyStr }
  | MatesCardOfThickness { card_thickness: Micrometer }

type ConnectorSpecification {
  series: NonEmptyStr
  positions: Nat
  rows: Nat
  pitch: Micrometer
  orientation: ConnectorOrientation
  termination: BoardTermination
  mating: ConnectorMatingStanding
}

type ComponentSpecification
  = TvsDiodeSpec { tvs: TvsSpecification }
  | CapacitorSpec { capacitor: CapacitorSpecification }
  | MosfetSpec { mosfet: MosfetSpecification }
  | TemperatureSensorSpec { sensor: TemperatureSensorSpecification }
  | ConnectorSpec { connector: ConnectorSpecification }

type ElectronicComponentRow {
  vendor: Vendor<Hardware>
  ordering_code: NonEmptyStr
  package: NonEmptyStr
  top_marking: NonEmptyStr
  specification: ComponentSpecification
  vendor_application_statements: List<NonEmptyStr>
}

// THE ONE PROJECTION A RAIL BOUND CONSUMES: the highest voltage the part tolerates across its rated
// terminals, with what kind of limit it is. Each kind bounds the rail the part sits across from above;
// none says what the rail IS. A sensor or connector projects nothing.
type VoltageWithstandKind
  = TvsReverseStandoff
  | CapacitorRatedVoltage
  | DrainSourceMaximum
  | FuseInterruptRating

type VoltageWithstand {
  kind: VoltageWithstandKind
  maximum: Volt
}

fn voltage_withstand(spec: ComponentSpecification) -> VoltageWithstand? {
  match spec {
    TvsDiodeSpec { tvs } => Present { value: VoltageWithstand { kind: TvsReverseStandoff, maximum: tvs.reverse_standoff } }
    CapacitorSpec { capacitor } => Present { value: VoltageWithstand { kind: CapacitorRatedVoltage, maximum: capacitor.rated_voltage } }
    MosfetSpec { mosfet } => Present { value: VoltageWithstand { kind: DrainSourceMaximum, maximum: mosfet.drain_source_maximum } }
    TemperatureSensorSpec { sensor: _ } => Absent
    ConnectorSpec { connector: _ } => Absent
  }
}
