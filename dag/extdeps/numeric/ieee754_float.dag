module extdeps.numeric.ieee754_float

import std.types { Float, NonEmptyStr }
import std.syntax { Add }
import std.algebra_law {
  AssociativityCounterexampleWitness,
  AssociativityOperationSubject,
  AssociativityRefutationReceipt,
  KernelFloat,
  associativity_refutation_holds_for_float_add,
}
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "standards.ieee.org/ieee/754/6210/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.numeric.ieee754_float",
      decl_name: "float_add_associativity_refuted",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data ieee754_float_note: String = "Cited upstream: edition-specific anchor above. For binary64 roundTiesToEven, triple (1e16, 1.0, 1.0) yields the same left fold 1e16 and right fold 1e16+2 under both the 2008 and 2019 revisions pinned at that locator family — interchange binary addition semantics did not change between them. Float binary addition has no DeclarationRef-producing operation identity — it is compiler BinOp.Add on kernel Float. The receipt binds KernelFloat plus BinOp.Add enum variants and derives witness magnitudes from execution via observe_float_add_associativity_triple, not hand-authored fold results."

data float_add_operation_identity_grounding_gap_note: String = "GROUNDING GAP (honest prerequisite, not a string nickname): Float addition is not structurally referenceable as a DeclarationRef today. This slice binds associativity evidence to KernelTypeName.KernelFloat and std.syntax.BinOp.Add — the closed kernel and syntax authorities — until primitive_identity supplies a joinable operation DeclarationRef."

data float_add_associativity_subject: AssociativityOperationSubject = AssociativityOperationSubject {
  carrier: KernelFloat,
  binop: Add,
}

fn observe_float_add_associativity_triple(a: Float, b: Float, c: Float) -> AssociativityCounterexampleWitness<Float> {
  let left = (a + b) + c
  let right = a + (b + c)
  AssociativityCounterexampleWitness {
    left_operand: a,
    middle_operand: b,
    right_operand: c,
    left_fold_result: left,
    right_fold_result: right,
  }
}

data float_add_associativity_refuted: AssociativityRefutationReceipt<Float> = AssociativityRefutationReceipt {
  subject: float_add_associativity_subject,
  witness: observe_float_add_associativity_triple(
    a: 10000000000000000.0,
    b: 1.0,
    c: 1.0,
  ),
}

fn float_add_associativity_refutation_holds() -> Bool {
  associativity_refutation_holds_for_float_add(receipt: float_add_associativity_refuted)
}
