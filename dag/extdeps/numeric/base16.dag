module extdeps.numeric.base16

import std.types { Int, String, List, Bool }
import std.integer { UInt8 }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc4648#section-3"
  }
}

// Cited upstream: RFC 4648 §3 Base 16 Encoding (retrieved 2026-07-22) — the 0-9a-f digit alphabet.
// Single authority for hexadecimal digit serialization (census item 14, msg_e9cfe443).
// Table-as-rows + fold — both extdeps.color.srgb byte_hex and extdeps.languages.json.emit
// int_to_upper_hex route here; the per-site 16-arm if-chains are dissolved.

type Base16DigitRow {
  value: Int
  lower: String
  upper: String
}

data base16_digit_rows: List<Base16DigitRow> = [
  Base16DigitRow { value: 0, lower: "0", upper: "0" },
  Base16DigitRow { value: 1, lower: "1", upper: "1" },
  Base16DigitRow { value: 2, lower: "2", upper: "2" },
  Base16DigitRow { value: 3, lower: "3", upper: "3" },
  Base16DigitRow { value: 4, lower: "4", upper: "4" },
  Base16DigitRow { value: 5, lower: "5", upper: "5" },
  Base16DigitRow { value: 6, lower: "6", upper: "6" },
  Base16DigitRow { value: 7, lower: "7", upper: "7" },
  Base16DigitRow { value: 8, lower: "8", upper: "8" },
  Base16DigitRow { value: 9, lower: "9", upper: "9" },
  Base16DigitRow { value: 10, lower: "a", upper: "A" },
  Base16DigitRow { value: 11, lower: "b", upper: "B" },
  Base16DigitRow { value: 12, lower: "c", upper: "C" },
  Base16DigitRow { value: 13, lower: "d", upper: "D" },
  Base16DigitRow { value: 14, lower: "e", upper: "E" },
  Base16DigitRow { value: 15, lower: "f", upper: "F" },
]

data base16_digit_refusal_sentinel: String = "!"

// Lookup miss returns base16_digit_refusal_sentinel (fail-loud: corrupt hex/JSON emission, never
// silent empty string). Callers gate d to [0,15] via /16 and %16;
// witness_base16_digit_refuses_out_of_range pins the miss arm.

fn base16_digit_char(rows: List<Base16DigitRow>, d: Int, upper: Bool) -> String {
  let found = fold(rows, init: "", f: (acc, row) =>
    if row.value == d {
      if upper { row.upper } else { row.lower }
    } else {
      acc
    })
  if found == "" { base16_digit_refusal_sentinel } else { found }
}

fn hex_digit_char_lower(d: Int) -> String {
  base16_digit_char(rows: base16_digit_rows, d: d, upper: false)
}

fn hex_digit_char_upper(d: Int) -> String {
  base16_digit_char(rows: base16_digit_rows, d: d, upper: true)
}

fn byte_hex_lower(v: Int) -> String {
  concat(hex_digit_char_lower(d: v / 16), hex_digit_char_lower(d: v % 16))
}

fn int_to_upper_hex_inner(n: Int, acc: String) -> String {
  if n == 0 { acc }
  else { int_to_upper_hex_inner(n: n / 16, acc: concat(hex_digit_char_upper(d: n % 16), acc)) }
}

fn int_to_upper_hex(n: Int) -> String {
  if n == 0 { "0" }
  else { int_to_upper_hex_inner(n: n, acc: "") }
}

// OCTETS <-> LOWERCASE HEX, the RFC 4648 §3 codec over whole byte strings. Decoding accepts ONLY
// the lowercase alphabet this module emits, so every octet string has exactly one hex spelling here:
// a decoder admitting "AB" beside "ab" would give one value two representations, which is the
// ambiguity extdeps.crypto.mac chose hex to avoid. An odd length or any other character is absent,
// never a best-effort partial decode.
fn base16_encode_lower(octets: List<UInt8>) -> String {
  map(octets, octet => byte_hex_lower(v: octet)) |> join(separator: "")
}

// THE ALPHABET'S OWN MEMBERSHIP TEST, derived from the digit rows rather than from a second
// spelling of them. Consumers each carried `(cp >= 48 && cp <= 57) || (cp >= 97 && cp <= 102)` --
// the 0-9a-f alphabet re-encoded as code-point ranges, which is this table said again (DESIGN
// section 3). THREE are migrated: extdeps.network.mac, gunbc.auth.approval_decision_store and
// extdeps.git.object_store.
//
// ONE IS NOT, AND SAYING SO IS THE POINT -- prose may not assert a consolidation the corpus does
// not have (DESIGN section 4c; review 69121 caught this sentence claiming all of them).
// std.content_hash content_hash_is_lower_hex_code_point still carries the identical spelling, and
// it is the only consumer in the stage0 population (gunbc.stage0 stage0_crate_partition_generated
// "std_content_hash"): its seed realization src/v1/stage0/src/std_content_hash.rs open-codes the
// same ranges, so a .dag-only edit would leave the fork alive in the committed realization, and
// regenerating that mirror would pull THIS module into the seed's emitted population, which DESIGN
// section 7 requires to be a declared row with a reason and a migration trigger rather than a
// silent one (review 69058). TRIGGER: that consumer migrates in the cut that carries the mirror
// regeneration together with the declared population change.
fn base16_is_lower_digit_code_point(cp: Int) -> Bool {
  any(base16_digit_rows, row => code_point(row.lower) == cp)
}

// Either case, for a consumer that must tell "not hexadecimal at all" from "hexadecimal but not the
// canonical lowercase spelling" -- git object ids refuse those separately.
fn base16_is_digit_code_point(cp: Int) -> Bool {
  any(base16_digit_rows, row => code_point(row.lower) == cp || code_point(row.upper) == cp)
}

// The uppercase half, for the consumer that refuses a non-canonical spelling BY NAME. A consumer
// asking this question spelled it `cp >= 65 && cp <= 70`, which is the alphabet's uppercase column
// re-encoded as an ASCII interval and would not follow the rows if they changed. Digits 0-9 have the
// same spelling in both columns, so this is true only of a row whose two columns differ.
fn base16_is_upper_digit_code_point(cp: Int) -> Bool {
  any(base16_digit_rows, row => code_point(row.upper) == cp && row.lower != row.upper)
}

// THE LOOKUP IS OVER A CODE POINT, AND THAT IS THE WHOLE OPERATION. A String-shaped wrapper stood
// here and read its argument with code_point, which returns only the FIRST scalar (and 0 for the
// empty string): "one lowercase digit" silently widened to "this text starts with one", so "aa"
// answered Present { value: 10 } (review 69058). Its only caller already holds one character from
// char_at, so the wrapper is deleted rather than guarded -- the caller's convention cannot repair an
// operation whose own contract is wrong, and there is no second contract to keep honest.
fn base16_lower_digit_value_at(cp: Int) -> Int? {
  fold(base16_digit_rows, init: none, f: (acc, row) =>
    if code_point(row.lower) == cp { Present { value: row.value } } else { acc })
}

fn base16_decode_lower_from(hex: String, i: Int, len: Int, acc: List<UInt8>) -> List<UInt8>? {
  if i >= len {
    Present { value: acc }
  } else {
    match base16_lower_digit_value_at(cp: code_point(char_at(hex, i))) {
      Absent => none
      Present { value: high } =>
        match base16_lower_digit_value_at(cp: code_point(char_at(hex, i + 1))) {
          Absent => none
          Present { value: low } =>
            base16_decode_lower_from(hex: hex, i: i + 2, len: len, acc: acc |> list_push(high * 16 + low))
        }
    }
  }
}

fn base16_decode_lower(hex: String) -> List<UInt8>? {
  let len = string_length(hex)
  if len % 2 != 0 {
    none
  } else {
    base16_decode_lower_from(hex: hex, i: 0, len: len, acc: [])
  }
}

// A DIGIT'S VALUE IN EITHER CASE, over the same rows: the consumers below read fields the kernel
// prints in uppercase (/proc/net/tcp) or a wire that admits either spelling, and refuse a code
// point that is in neither column.
fn base16_digit_value_at(cp: Int) -> Int? {
  fold(base16_digit_rows, init: none, f: (acc, row) =>
    if code_point(row.lower) == cp || code_point(row.upper) == cp { Present { value: row.value } } else { acc })
}

// A BOUNDED HEXADECIMAL WORD AS ONE INTEGER: one to `max_digits` digits in either case, most
// significant first, refused when empty, longer than the bound, or holding a non-digit. The bound
// is the consumer's field width -- four digits for a 16-bit port, six for a 24-bit run id -- and
// is capped at fifteen so the value stays inside Int; a consumer that needs a wider field is a
// different operation (base16_decode_lower yields octets).
fn base16_word_value(word: String, max_digits: Int) -> Int? {
  let cps = word |> chars
  if length(cps) == 0 || length(cps) > max_digits || max_digits > 15 { none } else {
    fold(cps, init: Present { value: 0 }, f: (acc, cp) =>
      match acc {
        Absent => none
        Present { value: v } =>
          match base16_digit_value_at(cp: cp) {
            Absent => none
            Present { value: d } => Present { value: v * 16 + d }
          }
      })
  }
}
