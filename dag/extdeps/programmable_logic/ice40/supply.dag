  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.programmable_logic.ice40.supply",
      decl_name: "ice40_inter_rail_constraints",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = ice40_supply_model_scope
