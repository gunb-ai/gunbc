module extdeps.programmable_logic.ice40.supply



data ice40_supply_note: String = "THE SUPPLY RAILS THE DEVICE REQUIRES, from Table 4.2 Recommended Operating Conditions and Table 4.12 sysI/O Recommended Operating Conditions of iCE40 LP/HX Family Data Sheet FPGA-DS-02029, Version 4.3, February 2025. It shares the subject module's citation anchor rather than minting a second one: these are rows of the same document about the same device, and a second anchor would be a second name for one authority. WHY THIS IS NOT A LIST OF VOLTAGES. Three facts in this table have shapes that a min/max pair cannot hold, and each was a fabrication waiting to happen. VPP_2V5's window DEPENDS ON THE CONFIGURATION MODE the board selects — 1.71 V to 3.46 V under slave SPI, but 2.30 V to 3.46 V under master SPI or NVCM configuration, and a narrower 2.30 V to 3.00 V while NVCM is being programmed — so a design that has not declared its configuration mode has not established what this rail must supply, and a single stored window would answer the question anyway. VPP_FAST has NO window at all: the document says leave it unconnected, which is not a voltage and must not be rendered as one. And two of the notes are constraints BETWEEN rails rather than properties of any one of them — like supplies at the same voltage must be the same supply, and an unused bank's VCCIO goes to VCC — which no per-rail record can carry."

// EVERY RAIL THE PACKAGE BONDS OUT, under the document's own symbol. These are not an enum of
// convenience: each is a distinct physical contact class on the package with its own count, and
// the pin itemisation in the subject module counts them separately for the same reason.

// This module's own citation of the same data sheet. It is a literal because the corpus wall reads
// the anchor structurally and cannot see a binding to a sibling's value - see the note in
// extdeps.programmable_logic.ice40.subject.
data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "www.latticesemi.com/-/media/LatticeSemi/Documents/DataSheets/iCE/FPGA-DS-02029-4-3-iCE40-LP-HX-Family-Data-Sheet.ashx?document_id=49312"
  }
}

type Ice40SupplyRail
  = CoreSupply
  | PllSupply
  | BankIoSupply
  | ConfigurationBankSupply
  | NvcmProgrammingSupply
  | FastProgrammingSupply

fn supply_rail_symbol(r: Ice40SupplyRail) -> std.types.NonEmptyStr {
  match r {
    CoreSupply => "VCC"
    PllSupply => "VCCPLL"
    BankIoSupply => "VCCIO"
    ConfigurationBankSupply => "VCC_SPI"
    NvcmProgrammingSupply => "VPP_2V5"
    FastProgrammingSupply => "VPP_FAST"
  }
}

// IDENTITY IS NOT SPELLING, and this is the third time that distinction has been needed in this
// lane. A discriminant exists so that comparing two rails or two modes reads a structural fact
// rather than round-tripping both through their display names — where editing documentation
// silently redefines the equality relation, and two members could be made equal by a copy-edit.
// The exhaustive match means a new member cannot be added without receiving one, and the residual
// risk becomes a shared tag, which a witness decides by execution.
fn supply_rail_tag(r: Ice40SupplyRail) -> Int {
  match r {
    CoreSupply => 1
    PllSupply => 2
    BankIoSupply => 3
    ConfigurationBankSupply => 4
    NvcmProgrammingSupply => 5
    FastProgrammingSupply => 6
  }
}

fn supply_rails_equal(a: Ice40SupplyRail, b: Ice40SupplyRail) -> Bool {
  supply_rail_tag(r: a) == supply_rail_tag(r: b)
}

// WHAT THE DISTINCTNESS WITNESS DOES AND DOES NOT COVER. The tag match is exhaustive, so the
// compiler refuses a new member that has not been given a discriminant. The ROSTER below is not
// enforced that way: it is hand-maintained, and a seventh member added without joining it would
// leave the witness walking six and passing while saying nothing about the seventh. So the
// guarantee is "every member the roster names has a distinct tag", not "every member has one" -
// and the second is what a reader would assume if this were not written down. Adding a contiguity
// check would not close it either, since an unlisted member takes the next tag and leaves the
// listed range intact. The class sits at mechanically preventable for tag ASSIGNMENT and at
// nothing at all for roster membership; closing it needs the language to enumerate a coproduct's
// members, which is not reachable from here today.
data all_supply_rails: List<Ice40SupplyRail> = [
  CoreSupply,
  PllSupply,
  BankIoSupply,
  ConfigurationBankSupply,
  NvcmProgrammingSupply,
  FastProgrammingSupply,
]

// THE CONFIGURATION MODE IS AN INPUT TO A RAIL REQUIREMENT, not a footnote on it. The device can
// be configured four ways and two of them impose a higher minimum on VPP_2V5 than the other,
// which means "what must this rail supply" has no answer until the board says how it configures.
type Ice40ConfigurationMode
  = SlaveSpiConfiguration
  | MasterSpiConfiguration
  | NvcmConfiguration
  | NvcmProgramming

fn configuration_mode_name(m: Ice40ConfigurationMode) -> std.types.NonEmptyStr {
  match m {
    SlaveSpiConfiguration => "slave SPI configuration"
    MasterSpiConfiguration => "master SPI configuration"
    NvcmConfiguration => "configuration from NVCM"
    NvcmProgramming => "NVCM programming"
  }
}

fn configuration_mode_tag(m: Ice40ConfigurationMode) -> Int {
  match m {
    SlaveSpiConfiguration => 1
    MasterSpiConfiguration => 2
    NvcmConfiguration => 3
    NvcmProgramming => 4
  }
}

fn configuration_modes_equal(a: Ice40ConfigurationMode, b: Ice40ConfigurationMode) -> Bool {
  configuration_mode_tag(m: a) == configuration_mode_tag(m: b)
}

data all_configuration_modes: List<Ice40ConfigurationMode> = [
  SlaveSpiConfiguration,
  MasterSpiConfiguration,
  NvcmConfiguration,
  NvcmProgramming,
]

// A REQUIREMENT IS NOT ALWAYS A WINDOW. VPP_FAST's row reads N/A with the instruction to leave the
// pin unconnected, so it has no minimum and no maximum — and a record with min and max fields
// would force inventing two numbers the document declines to give. That is the fabricated
// plausible output in its smallest form: two plausible volts where the answer is "do not connect
// this". The arms are separate so no consumer can read a bound off the second one.
type RailRequirement
  = OperatingWindow { minimum: std.measure.Millivolt, maximum: std.measure.Millivolt }
  | MustBeLeftUnconnected

fn requirement_admits(r: RailRequirement, v: std.measure.Millivolt) -> Bool {
  match r {
    MustBeLeftUnconnected => false
    OperatingWindow { minimum: lo, maximum: hi } =>
      millivolt_count(v: v) >= millivolt_count(v: lo)
        && millivolt_count(v: v) <= millivolt_count(v: hi)
  }
}

// MODE-INDEPENDENT RAILS AND THE MODE-DEPENDENT ONE ARE DIFFERENT SHAPES. Fusing them would give
// every rail a mode field that is meaningless for five of the six, which is how an inapplicable
// fact becomes indistinguishable from an absent one.
//
// ON THE NvcmProgrammingSupply ARM, ABSENT MEANS "ASK WITH A MODE", NOT "UNKNOWN". That rail's
// requirement is a function of the configuration mode, so the mode-free question has no answer —
// and answering it with the widest window would admit 1.71 V under master SPI, which the document
// refuses. Ask nvcm_supply_requirement instead.
fn rail_requirement(r: Ice40SupplyRail) -> RailRequirement? {
  match r {
    CoreSupply => Present { value: OperatingWindow { minimum: millivolt(count: 1140), maximum: millivolt(count: 1260) } }
    PllSupply => Present { value: OperatingWindow { minimum: millivolt(count: 1140), maximum: millivolt(count: 1260) } }
    BankIoSupply => Present { value: OperatingWindow { minimum: millivolt(count: 1710), maximum: millivolt(count: 3460) } }
    ConfigurationBankSupply => Present { value: OperatingWindow { minimum: millivolt(count: 1710), maximum: millivolt(count: 3460) } }
    FastProgrammingSupply => Present { value: MustBeLeftUnconnected }
    NvcmProgrammingSupply => none
  }
}

fn nvcm_supply_requirement(m: Ice40ConfigurationMode) -> RailRequirement {
  match m {
    SlaveSpiConfiguration => OperatingWindow { minimum: millivolt(count: 1710), maximum: millivolt(count: 3460) }
    MasterSpiConfiguration => OperatingWindow { minimum: millivolt(count: 2300), maximum: millivolt(count: 3460) }
    NvcmConfiguration => OperatingWindow { minimum: millivolt(count: 2300), maximum: millivolt(count: 3460) }
    NvcmProgramming => OperatingWindow { minimum: millivolt(count: 2300), maximum: millivolt(count: 3000) }
  }
}

// THE I/O STANDARD DECIDES THE BANK VOLTAGE, and its window is much narrower than the bank rail's
// own 1.71-to-3.46 envelope. Both are real: the rail admits any level in the wide range, but a
// bank driving LVCMOS 3.3 must sit in 3.14 to 3.46. A board that satisfied only the wide bound
// would be a board whose outputs are out of spec while every rail check passed.
type Ice40IoStandardSupply {
  standard_name: std.types.NonEmptyStr
  minimum: std.measure.Millivolt
  typical: std.measure.Millivolt
  maximum: std.measure.Millivolt
}

data ice40_lvcmos33_supply: Ice40IoStandardSupply = Ice40IoStandardSupply {
  standard_name: "LVCMOS 3.3",
  minimum: millivolt(count: 3140),
  typical: millivolt(count: 3300),
  maximum: millivolt(count: 3460),
}

data ice40_lvcmos25_supply: Ice40IoStandardSupply = Ice40IoStandardSupply {
  standard_name: "LVCMOS 2.5",
  minimum: millivolt(count: 2370),
  typical: millivolt(count: 2500),
  maximum: millivolt(count: 2620),
}

data ice40_lvcmos18_supply: Ice40IoStandardSupply = Ice40IoStandardSupply {
  standard_name: "LVCMOS 1.8",
  minimum: millivolt(count: 1710),
  typical: millivolt(count: 1800),
  maximum: millivolt(count: 1890),
}

data ice40_io_standard_supplies: List<Ice40IoStandardSupply> = [
  ice40_lvcmos33_supply,
  ice40_lvcmos25_supply,
  ice40_lvcmos18_supply,
]

// CONSTRAINTS BETWEEN RAILS, which no per-rail record can hold. Each is one of the document's
// numbered table notes, carried as its own row because they oblige different things of a board:
// the first is about supply topology, the second about what to do with a bank you are not using,
// the third about a pin that must be left alone. A design that satisfied every window and violated
// any of these would be a design the vendor does not support.
type Ice40InterRailConstraint
  = LikeVoltageRailsShareOneSupply { left: Ice40SupplyRail, right: Ice40SupplyRail }
  | UnusedBankSupplyGoesToCore { bank_rail: Ice40SupplyRail, core_rail: Ice40SupplyRail }
  | PinLeftUnconnected { rail: Ice40SupplyRail }

data ice40_inter_rail_constraints: List<Ice40InterRailConstraint> = [
  LikeVoltageRailsShareOneSupply { left: BankIoSupply, right: ConfigurationBankSupply },
  UnusedBankSupplyGoesToCore { bank_rail: BankIoSupply, core_rail: CoreSupply },
  PinLeftUnconnected { rail: FastProgrammingSupply },
]

