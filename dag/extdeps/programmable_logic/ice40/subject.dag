module extdeps.programmable_logic.ice40.subject


// THE CITATION IS PER MODULE AND IT IS A LITERAL, which is a fact about the mechanism rather than
// a preference. The corpus wall reads each extdeps module's extdeps_external_authority_anchor
// STRUCTURALLY - it projects the anchor's scheme out of the declaration's own Node tree - so an
// anchor bound to a shared value in a sibling module projects as absent and the module reads as
// uncited. Binding was tried first and refused by that wall. So the three modules of this package
// each carry the record: the citation duty is per module, and a shared binding cannot discharge it
// while the reader is structural.
data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "www.latticesemi.com/-/media/LatticeSemi/Documents/DataSheets/iCE/FPGA-DS-02029-4-3-iCE40-LP-HX-Family-Data-Sheet.ashx?document_id=49312"
  }
}

data ice40_subject_note: String = "THE iCE40 LP/HX FAMILY, FROM THE VENDOR'S OWN DATA SHEET. Pulled and read 2026-08-13: iCE40 LP/HX Family Data Sheet, document FPGA-DS-02029, Version 4.3, February 2025. THE DOCUMENT NUMBER ITSELF CHANGED and that is a modelled fact rather than a detail: this repository previously cited DS1040 Version 3.4, October 2017, and the current revision's own change history records 'Changed document number from DS1040 to FPGA-DS-02029'. So the same subject is reachable under two identifiers, and a citation naming only the old one does not fail loudly — it resolves to a real, stale document. Two substantive changes land with the refresh. The revision history records that the dedicated inputs for Bank 1 of the HX1K in CB132 and TQ144 were modified, which is exactly the population this repository joins against Project IceStorm's roster, and the configuration signal SPI_SS_B was renamed SPI_SS. WHAT IS AND IS NOT TRANSCRIBED HERE, and the distinction is deliberate rather than cautious. Short factual statements a design has to consult — the ordering part number, the package type and its physical dimensions, the per-bank I/O population, the I/O standards the buffer supports — are carried. The full pin assignment table is NOT: it is thirty-odd sheets of a copyrighted vendor document, and the pin-to-tile map this repository actually needs for place and route comes from Project IceStorm, which is an independently governed open-source project with its own license and its own module. Those are different authorities and modelling one as the other would fuse a specification with a reverse-engineering of it. The same reasoning is already recorded for the Altra package, where the split between public package facts and licensed board collateral was got wrong once and corrected. WHY THIS PART: the article needs a programmable device in a package a prototype assembler can place, driven by a toolchain this repository can pin and execute. TQ144 is a 20 by 20 mm quad flat pack on a half-millimetre pitch — not a ball grid array — and the HX1K in it is carried end to end by an open synthesis, place-and-route and bitstream chain. No NDA fact is required to design with it."

type Ice40Family
  = Ice40LowPower
  | Ice40HighPerformance

// The device, as its ordering part number names it. The family and the logic-cell count are
// separate fields rather than encoded in the part number's spelling: a part number is the
// vendor's identifier for a thing, not a structure to parse, and reading capacity out of it is
// the decomposition failure the DRAM and NVMe rows in this repository already avoid.
type Ice40Device {
  ordering_part_number: std.types.NonEmptyStr
  family: Ice40Family
  logic_cells: std.nat.Nat
  ram4k_blocks: std.nat.Nat
  phase_locked_loops: std.nat.Nat
}

// A package is a physical carrier with a footprint a board must reproduce. Dimensions are
// Micrometer — the shared Length quantity at one finer decimal step — because a half-millimetre
// pitch is not expressible in whole millimetres and the board that places this part is drawn at
// that grain. An earlier revision spelled these as plain Nat with the unit in the field NAME,
// which is the fork this repository refuses: a unit written in a name is a unit no consumer can
// read, so a micrometre and a millimetre become the same type and adding them typechecks. The
// contact COUNT stays Nat, and correctly: it is a cardinality, not a length.
type Ice40Package {
  designator: std.types.NonEmptyStr
  body_width: std.measure.Micrometer
  body_height: std.measure.Micrometer
  contact_pitch: std.measure.Micrometer
  contact_count: std.nat.Nat
}

// I/O POPULATION IS PER BANK, and per (device, package) rather than per device. The four banks
// have independent VCCIO rails, so which bank a signal lands in decides what voltage it can be
// driven at — a fact a board design consults and a flat total would erase. The configuration
// pins are counted separately because they are not general-purpose: they carry the device's
// configuration interface and a design that spends them as ordinary I/O has to say so.
type Ice40BankPopulation {
  device: std.types.NonEmptyStr
  package_designator: std.types.NonEmptyStr
  bank_0: std.nat.Nat
  bank_1: std.nat.Nat
  bank_2: std.nat.Nat
  bank_3: std.nat.Nat
  configuration: std.nat.Nat
}

fn bank_population_general_purpose(p: Ice40BankPopulation) -> std.nat.Nat {
  p.bank_0 + p.bank_1 + p.bank_2 + p.bank_3
}

fn bank_population_total(p: Ice40BankPopulation) -> std.nat.Nat {
  bank_population_general_purpose(p: p) + p.configuration
}

// The I/O buffer's supported single-ended standards, from the family's feature list. This is the
// fact that decides whether a board node can be wired to a device pin at all: a twelve-volt rail
// is not an LVCMOS level and no bank voltage makes it one.
type Ice40SingleEndedIoStandard
  = Lvcmos33
  | Lvcmos25
  | Lvcmos18

data ice40_supported_single_ended_standards: List<Ice40SingleEndedIoStandard> = [Lvcmos33, Lvcmos25, Lvcmos18]

data ice40_hx1k: Ice40Device = Ice40Device {
  ordering_part_number: "ICE40HX1K-TQ144",
  family: Ice40HighPerformance,
  logic_cells: 1280,
  ram4k_blocks: 16,
  phase_locked_loops: 1,
}

data ice40_tq144_package: Ice40Package = Ice40Package {
  designator: "TQ144",
  body_width: micrometer(count: 20000),
  body_height: micrometer(count: 20000),
  contact_pitch: micrometer(count: 500),
  contact_count: 144,
}

// Read from the extdeps.firmware.uefi_shell.Pin Information Summary table for the HX1K in TQ144: banks 0 through 3 carry 23,
// 25, 20 and 24 general-purpose pins and four configuration pins sit beside them. Ninety-two plus
// four is ninety-six, and the vendor's own Total General Purpose Single Ended I/O row for this
// column reads 96 — so the addition is the document's, not ours. That total is also exactly the
// pin population Project IceStorm carries for this package, which is now a THIRD authority
// agreeing rather than the two the earlier revision claimed.
data ice40_hx1k_tq144_banks: Ice40BankPopulation = Ice40BankPopulation {
  device: "ICE40HX1K-TQ144",
  package_designator: "TQ144",
  bank_0: 23,
  bank_1: 25,
  bank_2: 20,
  bank_3: 24,
  configuration: 4,
}

// THE VENDOR'S OWN DECOMPOSITION OF EVERY BONDED CONTACT, at the vendor's own class grain and
// under the vendor's own row names. It is carried in full rather than summarised because the
// summary is what went wrong before: this repository held three numbers for "the I/O count" and
// none of them said which contacts they counted, and the sum that was supposed to reconcile them
// was performed by a reader rather than by the document. Every field below is one row of the extdeps.firmware.uefi_shell.Pin
// Information Summary table for one (device, package) column.
//
// TWO OF THESE ARE NOT SUMMABLE WITH THE REST, and saying so is the point of separating them.
// The differential inputs are a SUBSET of the general-purpose single-ended population — the same
// physical contacts counted a second way, by capability — so adding them double-counts. And the
// general-purpose total already INCLUDES the four configuration contacts, which is why it reads
// 96 against a per-bank sum of 92. A consumer that wants a total states which rows it means.
type Ice40PackageContactItemization {
  device: std.types.NonEmptyStr
  package_designator: std.types.NonEmptyStr
  general_purpose_single_ended: std.nat.Nat
  differential_inputs_subset: std.nat.Nat
  dedicated_inputs: std.nat.Nat
  vccio: std.nat.Nat
  vcc: std.nat.Nat
  vcc_spi: std.nat.Nat
  vpp_2v5: std.nat.Nat
  vpp_fast: std.nat.Nat
  vccpll: std.nat.Nat
  ground: std.nat.Nat
  no_connect: std.nat.Nat
  declared_bonded_pins: std.nat.Nat
}

// The rows that partition the package: every contact is counted exactly once. The differential
// inputs are excluded because they are a recount of contacts already in the first term.
fn itemized_contact_total(i: Ice40PackageContactItemization) -> std.nat.Nat {
  i.general_purpose_single_ended +
    i.dedicated_inputs +
    i.vccio +
    i.vcc +
    i.vcc_spi +
    i.vpp_2v5 +
    i.vpp_fast +
    i.vccpll +
    i.ground +
    i.no_connect
}

data ice40_hx1k_tq144_contacts: Ice40PackageContactItemization = Ice40PackageContactItemization {
  device: "ICE40HX1K-TQ144",
  package_designator: "TQ144",
  general_purpose_single_ended: 96,
  differential_inputs_subset: 12,
  dedicated_inputs: 2,
  vccio: 8,
  vcc: 4,
  vcc_spi: 1,
  vpp_2v5: 1,
  vpp_fast: 1,
  vccpll: 1,
  ground: 10,
  no_connect: 19,
  declared_bonded_pins: 144,
}

// THE CONTROL COLUMN, and it is carried for exactly one reason: the TQ144 itemization does not
// cross-foot, and a single non-cross-footing column is indistinguishable from a transcription
// error by the person who transcribed it. VQ100 is read from the same table, the same rows and
// the same page, and it cross-foots exactly at 100 — so the TQ144 shortfall is a property of the
// document's TQ144 column rather than of the reading method.
data ice40_hx1k_vq100_contacts: Ice40PackageContactItemization = Ice40PackageContactItemization {
  device: "ICE40HX1K-VQ100",
  package_designator: "VQ100",
  general_purpose_single_ended: 72,
  differential_inputs_subset: 9,
  dedicated_inputs: 2,
  vccio: 9,
  vcc: 4,
  vcc_spi: 1,
  vpp_2v5: 1,
  vpp_fast: 1,
  vccpll: 0,
  ground: 10,
  no_connect: 0,
  declared_bonded_pins: 100,
}

data ice40_family_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.programmable_logic.ice40.subject",
      decl_name: "ice40_hx1k",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data ice40_vendor: Vendor<extdeps.hardware.Hardware> = lattice_semiconductor_vendor

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = ice40_family_model_scope
