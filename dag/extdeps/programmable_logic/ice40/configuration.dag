module extdeps.programmable_logic.ice40.configuration

import std.types { String, Bool, NonEmptyStr, List }
import std.integer { Int }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import extdeps.programmable_logic.ice40.subject { extdeps_external_authority_anchor }
import extdeps.programmable_logic.ice40.supply {
  Ice40ConfigurationMode,
  MasterSpiConfiguration,
  NvcmConfiguration,
  NvcmProgramming,
  SlaveSpiConfiguration,
  configuration_mode_name,
}

data ice40_configuration_note: String = "THE CONFIGURATION PORT, from Table 4.28 SPI Master or NVCM Configuration Time and Table 4.29 sysCONFIG Port Timing Specifications of iCE40 LP/HX Family Data Sheet FPGA-DS-02029, Version 4.3, February 2025. TWO THINGS IN THESE TABLES ARE NOT NUMBERS AND WOULD HAVE BECOME ONE. First, a timing row APPLIES TO SOME MODES AND NOT OTHERS: tCR_SCK is a slave-SPI row and asking for it on a master-SPI board is asking about a transaction that board never performs, which is a different state from the specification being unknown. Second, the high-frequency tCONFIG values were DELETED by a revision of this document — the change history records the deletion for every device — and note 3 says high frequency is supported only on SPI Master. A blank cell in a published table is not zero, not the low-frequency figure, and not an oversight to fill in from a previous revision; it is the vendor withdrawing a number, and a model that carried the old value would be asserting a specification the vendor has retracted. A READING NOTE ON THE TABLE ITSELF: Table 4.29 carries a condition column between Parameter and Min, so the 200 ns against tCRESET_B sits in the MINIMUM column and not the typical one. That was checked rather than assumed, because reading it one column left would have turned a minimum pulse width into a typical one — and a design built to a typical where a minimum is required fails intermittently, which is the worst way to fail."

// THE SIGNALS THE CONFIGURATION PORT PRESENTS. SPI_SS carries the name this revision gives it:
// the change history records that SPI_SS_B was renamed to SPI_SS in the Signal Descriptions table,
// so a model spelling it the old way is citing a document that no longer exists under that name.
type Ice40ConfigurationSignal
  = ConfigurationReset
  | ConfigurationDone
  | SpiSlaveSelect
  | SpiClock
  | SpiDataIn
  | SpiDataOut

fn configuration_signal_name(s: Ice40ConfigurationSignal) -> NonEmptyStr {
  match s {
    ConfigurationReset => "CRESET_B"
    ConfigurationDone => "CDONE"
    SpiSlaveSelect => "SPI_SS"
    SpiClock => "SPI_SCK"
    SpiDataIn => "SPI_SI"
    SpiDataOut => "SPI_SO"
  }
}

// A TIMING ROW HAS A SCOPE, and the scope is part of the fact. A row that applies to every mode
// and a row that applies only to slave SPI are different claims, and a consumer asking a
// master-SPI board about tCR_SCK is asking about a transaction that board does not perform.
type TimingScope
  = AllConfigurationModes
  | OnlyUnderMode { mode: Ice40ConfigurationMode }

fn scope_admits(s: TimingScope, m: Ice40ConfigurationMode) -> Bool {
  match s {
    AllConfigurationModes => true
    OnlyUnderMode { mode: only } =>
      (configuration_mode_name(m: only) as String) == (configuration_mode_name(m: m) as String)
  }
}

// THE COLUMN A VALUE CAME FROM IS CARRIED, because a minimum and a typical are different
// obligations and the table states both. A design built to a typical where the document gives a
// minimum meets the specification on average and violates it intermittently, which is the failure
// mode hardest to find. Carrying the column means a consumer wanting a guaranteed bound can
// refuse a typical rather than silently accept it.
type SpecColumn
  = MinimumColumn
  | TypicalColumn
  | MaximumColumn

type TimingBound {
  value: Int
  column: SpecColumn
  unit: NonEmptyStr
}

type ConfigurationTiming {
  symbol: NonEmptyStr
  scope: TimingScope
  bound: TimingBound
}

data ice40_creset_b_low_pulse: ConfigurationTiming = ConfigurationTiming {
  symbol: "tCRESET_B",
  scope: AllConfigurationModes,
  bound: TimingBound { value: 200, column: MinimumColumn, unit: "ns" },
}

data ice40_done_to_io_active: ConfigurationTiming = ConfigurationTiming {
  symbol: "tDONE_IO",
  scope: AllConfigurationModes,
  bound: TimingBound { value: 49, column: MinimumColumn, unit: "clock cycles" },
}

data ice40_hx1k_creset_to_first_sck: ConfigurationTiming = ConfigurationTiming {
  symbol: "tCR_SCK",
  scope: OnlyUnderMode { mode: SlaveSpiConfiguration },
  bound: TimingBound { value: 800, column: MinimumColumn, unit: "us" },
}

data ice40_cclk_write_minimum: ConfigurationTiming = ConfigurationTiming {
  symbol: "fMAX write",
  scope: OnlyUnderMode { mode: SlaveSpiConfiguration },
  bound: TimingBound { value: 1, column: MinimumColumn, unit: "MHz" },
}

data ice40_cclk_write_maximum: ConfigurationTiming = ConfigurationTiming {
  symbol: "fMAX write",
  scope: OnlyUnderMode { mode: SlaveSpiConfiguration },
  bound: TimingBound { value: 25, column: MaximumColumn, unit: "MHz" },
}

data ice40_configuration_timings: List<ConfigurationTiming> = [
  ice40_creset_b_low_pulse,
  ice40_done_to_io_active,
  ice40_hx1k_creset_to_first_sck,
  ice40_cclk_write_minimum,
  ice40_cclk_write_maximum,
]

fn timings_for_mode(m: Ice40ConfigurationMode) -> List<ConfigurationTiming> {
  fold(ice40_configuration_timings, init: [], f: fn(acc, t) {
    if scope_admits(s: t.scope, m: m) { concat(acc, [t]) } else { acc }
  })
}

// THE CONFIGURATION CLOCK SPEED SELECTION, and the arm that matters is the third one. The vendor
// published high-frequency tCONFIG values and then DELETED them: the change history records
// removing the high-frequency figure for every device in the family, and the surviving note says
// high frequency is supported only on SPI Master. A withdrawn value is not an absent one — the
// remedy for absent is to go and read; the remedy for withdrawn is that there is nothing to read,
// and carrying the retired number would assert a specification the vendor has retracted.
type ConfigurationClockSelection
  = LowFrequencyDefault
  | MediumFrequency
  | HighFrequency

type ConfigurationTimeStanding
  = ConfigurationTimeTypical { milliseconds: Int }
  | ConfigurationTimeWithdrawnByVendor { note: NonEmptyStr }

fn hx1k_configuration_time(c: ConfigurationClockSelection) -> ConfigurationTimeStanding {
  match c {
    LowFrequencyDefault => ConfigurationTimeTypical { milliseconds: 53 }
    MediumFrequency => ConfigurationTimeTypical { milliseconds: 25 }
    HighFrequency =>
      ConfigurationTimeWithdrawnByVendor {
        note: "the revision history records deleting the iCE40LP/HX1K high-frequency value; note 3 states high frequency is supported only on SPI Master",
      }
  }
}

data ice40_configuration_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.programmable_logic.ice40.configuration",
      decl_name: "ice40_configuration_timings",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: ExternalModelScope = ice40_configuration_model_scope
