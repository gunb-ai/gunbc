module extdeps.clock

import std.algebra { trim }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.types { EpochMs, EpochSecs, String, Timestamp, Unit }
import std.nat { Nat }
import std.optional { Absent, Present }
import std.interval {
  IntervalConstructionFold, OrderedClosedInterval, closed_interval, interval_construction_fold,
  interval_high, interval_low,
}
import std.measure { milliseconds_per_second }
import extdeps.units.iso8601 { iso8601_seconds_per_minute }
import extdeps.units.iso8601_calendar {
  Iso8601CivilDate, iso8601_seconds_since_midnight, iso8601_unix_seconds_at,
}
import std.decl_ref { DeclarationRef, WholeDeclaration }


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/date.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.clock",
      decl_name: "Clock",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// feature:offset-nat-carrier — dissolve-on: when the shell transport supports
// Measure<Time, One, Nat> (Second) interpolation, convert Clock.TimestampOffset
// AND Clock.TimestampAdd to accept offset: Second and unwrap to Nat only in the
// transport binder. Meanwhile both operations accept offset: Nat — still a bare
// scalar, but at least the Nat refinement (Int where non_negative) encodes the
// sign constraint that Int lacked, and the parameter name names the unit as a
// second-best signal. TimestampAdd is the same carrier family as TimestampOffset
// (seconds as Nat at the operation boundary), not a second unit surface.

service Clock {
  operation Now {
    requires none
    input {}
    output { timestamp: Timestamp from "stdout" }
    readonly
    transport shell { argv: ["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"] }
    exit {
      0 => Unit
      nonzero => String "date command failed"
    }
  }

  operation UnixMillis {
    requires none
    input {}
    output { unix_millis: String from "stdout" }
    readonly
    transport shell { argv: ["date", "+%s%3N"] }
    exit {
      0 => Unit
      nonzero => String "date command failed"
    }
  }

  operation UnixSecs {
    requires none
    input {}
    output { unix_secs: String from "stdout" }
    readonly
    transport shell { argv: ["date", "+%s"] }
    exit {
      0 => Unit
      nonzero => String "date command failed"
    }
  }

  operation TimestampOffset {
    requires none
    input { timestamp: Timestamp, offset: Nat }
    output { result: Timestamp from "stdout" }
    readonly
    transport shell { argv: ["date", "-u", "-d", "{timestamp} -{offset} seconds", "+%Y-%m-%dT%H:%M:%SZ"] }
    exit {
      0 => Unit
      nonzero => String "date offset failed"
    }
  }

  operation TimestampAdd {
    requires none
    input { timestamp: Timestamp, offset: Nat }
    output { result: Timestamp from "stdout" }
    readonly
    transport shell { argv: ["date", "-u", "-d", "{timestamp} +{offset} seconds", "+%Y-%m-%dT%H:%M:%SZ"] }
    exit {
      0 => Unit
      nonzero => String "date add failed"
    }
  }

  operation TimestampToUnixSecs {
    requires none
    input { timestamp: Timestamp }
    output { unix_secs: String from "stdout" }
    readonly
    transport shell { argv: ["date", "-u", "-d", "{timestamp}", "+%s"] }
    exit {
      0 => Unit
      nonzero => String "date conversion failed"
    }
  }
}

// UnixMillis exists because a throttle needs to ANSWER `has 20 hours passed`, and answering it from Clock.Now is not possible without a date parser: Timestamp is `String` in std.types, so Clock.Now's apparent typing is an alias over rendered ISO-8601 text, not a magnitude. UnixSecs was no better for a different reason — it declared its output as String, so the one operation in the tree that produces a number produced it as text and every consumer would have owned the decode. The output is therefore EpochMs (std.types, `Int where range(min: 0)`), which is the existing magnitude carrier for exactly this quantity, so no new time type is minted.
//
// MILLISECONDS RATHER THAN SECONDS, and not for precision — a 20-hour throttle does not need a millisecond. It is because EpochMs is what the rest of this tree already speaks (extdeps.github.pulls PullTimingObservation carries opened_at and merged_at as epoch milliseconds), so a seconds-valued Int flowing into an EpochMs-shaped world is a unit straddle waiting to happen — the field name would be the only thing saying which, which is the unit-in-the-name defect DESIGN's measure discipline rejects. `date +%s%3N` is GNU coreutils; the %3N field is not in POSIX, and that is a genuine portability narrowing recorded here rather than discovered later: this operation is used from CI runners and the fleet hosts, all GNU userland. A BSD/macOS host would need its own realization bound to the same shape, which is the ordinary gunbc.design_argument::minimize_redundancy transport story and not a change to the operation.
type ClockUnixMillisRead
  = ClockUnixMillisObserved { millis: EpochMs }
  | ClockUnixMillisRefused { detail: String }

// The OPERATION's output stays String and the TYPED read is a function over it, which is the shape every other numeric host read in this tree already has (extdeps.tools.wc, extdeps.systemd.systemd, extdeps.filesystem.linux all take a stdout String and route it through parse_int). The alternative — declaring the operation's output as EpochMs and letting the transport coerce — would put a decode inside the transport layer where it has no way to REFUSE: a stdout that is not a number would have to become some Int anyway, and the only available answers are a fabricated zero or a crash. Here an unparseable clock reading is ClockUnixMillisRefused carrying what was actually read, and a caller must answer that arm. The negative check is not redundant with parse_int: parse_int admits a leading minus, EpochMs is `Int where range(min: 0)`, and a clock that reported a pre-epoch instant is a broken clock rather than a very old one.
fn clock_unix_millis_read() -> ClockUnixMillisRead {
  let result = Clock.UnixMillis()
  match parse_int(s: trim(result.unix_millis)) {
    Absent =>
      ClockUnixMillisRefused {
        detail: concat("clock unix millis reading is not an integer: ", result.unix_millis)
      }
    Present { value: n } =>
      if n < 0 {
        ClockUnixMillisRefused {
          detail: concat("clock unix millis reading is negative: ", result.unix_millis)
        }
      } else {
        ClockUnixMillisObserved { millis: n }
      }
  }
}

// THE ONE MILLIS-TO-SECONDS CONVERSION, beside the read that produces millis. Truncation toward the
// epoch is POSIX seconds' own rounding (date +%s truncates), and both carriers are non-negative, so
// a reading that satisfied EpochMs yields one that satisfies EpochSecs.
fn epoch_secs_of_millis(millis: EpochMs) -> EpochSecs {
  millis / 1000
}
// SAME OUTPUT-SHAPE DISCIPLINE AS clock_unix_millis_read: the operation's
// output stays String, and this typed wrapper parses it with proper refusal.
// Uses EpochSecs (std.types), the same pattern clock_unix_millis_read uses
// with EpochMs — including the negative check, because parse_int admits a
// leading minus while date +%s returns a non-negative integer.
type ClockTimestampRead
  = ClockTimestampObserved { epoch_secs: EpochSecs }
  | ClockTimestampRefused { detail: String }

fn clock_timestamp_to_unix_secs(timestamp: Timestamp) -> ClockTimestampRead {
  let result = Clock.TimestampToUnixSecs(timestamp: timestamp)
  match parse_int(s: trim(result.unix_secs)) {
    Absent =>
      ClockTimestampRefused {
        detail: concat("clock timestamp conversion is not an integer: ", result.unix_secs)
      }
    Present { value: n } =>
      if n < 0 {
        ClockTimestampRefused {
          detail: concat("clock timestamp conversion is negative: ", result.unix_secs)
        }
      } else {
        ClockTimestampObserved { epoch_secs: n }
      }
  }
}

// ── CAPTURE TIME: A BAND, NOT A STOPWATCH READING ──────────────────────────────────────────────
// WHEN A READING WAS TAKEN is not always one instant. A run's own clock answers with a millisecond; a
// notebook that dates its captures to a minute, or to a "~06:5xZ" pass, licenses only an interval. An
// EpochMs field holds ONE exact instant, so a banded capture typed into one claims a precision the bytes
// do not support (gunbc.design_argument::fail_closed: "no plausible output is fabricated"; section 4d: an
// inference is a bet and travels typed as one). So the carrier of an observation's time is the INTERVAL the
// capture licenses, minted through std.interval -- a reversed pair becomes CaptureTimeBandInverted carrying
// std.interval's own words about the pair rather than being swapped into order, and there is no arm for "a
// time" at all, only for a band or for the refusal. The type lives in the clock authority because every
// observing layer mints against its own calendar; what a notebook contributes is its day and its windows,
// never a second kind of time (gunbc.design_argument::single_authority).
// ── CAPTURE TIME: A MINTED BAND, NOT A STOPWATCH READING ───────────────────────────────────────
// THE OBSERVING LAYER OWNS THE CALENDAR OF ITS OWN NOTEBOOK. These bands are statements about WHEN
// THIS REPOSITORY READ BYTES OFF A MACHINE, and the only authority for them is the capture directory
// (00_README.txt, and date fields quoted inside the captures). The route module therefore receives a
// CapturedInstant and never mints one: what the run's date is has no business inside a reusable route,
// and a band built through a hardcoded day would silently pin every observation to a date it never
// checked (gunbc.design_argument::interface_realization_policy: "Policy has leaked when an argv carries a literal it should receive as a
// parameter"). One day stands here instead, because one run's README records one day -- and it is read
// back through the calendar authority below, never asserted beside a bare literal.
//
// The artifact records its times to the precision the capture itself has, and none of them to the
// second:
//   02_inband_channel.txt   the device node's own date field: `Oct 16 06:27 /dev/ipmi0`
//   00_README.txt           `PRIVILEGED WRITE 1 ... executed in the original run ~06:40Z`
//   00_README.txt           `PRIVILEGED WRITE 2 (Redfish Manager.ResetToDefaults): executed ~06:45Z`
//   00_README.txt           `Fresh re-capture taken 2026-10-16 ~06:5xZ, AFTER the reset`
// An EpochMs field holds ONE exact instant, so every value typed into one claims second precision the
// bytes do not support (gunbc.design_argument::fail_closed: "no plausible output is fabricated"; section 4d: an
// inference is a bet and travels typed as one). So what an observation carries is the INTERVAL the
// capture licenses, minted through std.interval -- a reversed pair becomes CaptureTimeBandInverted
// carrying std.interval's own words about the pair rather than being swapped into order, and there is
// no arm for "a time" at all, only for a band or for the refusal.
type CapturedInstant
  = CaptureTimeBand { band: OrderedClosedInterval<EpochMs> }
  | CaptureTimeBandInverted { reason: String }

// THE DEGENERATE BAND, for a reading whose OWN instrument answers with one instant: a stopwatch, a
// Redfish timestamp printed to the millisecond, a CI job's own clock. Minting the band here rather than
// typing an EpochMs into the field keeps one carrier for every observation time, and it says which way the
// instant was licensed -- an instrument read, not a window narrowed by a reader. A capture dated to a
// minute or to a pass NEVER goes through this mint; it goes through captured_band or captured_minute_band
// with both bounds spelled out.
fn captured_point(at: EpochMs) -> CapturedInstant {
  captured_band(low: at, high: at)
}

// one UTC instant on a NAMED DAY, from the hour/minute/second a capture line shows. The combination of
// the calendar's scale factors is owned by extdeps.units.iso8601_calendar (gunbc.design_argument::earliest_unjustified_boundary: this was the
// third hand-written copy of it), and std.measure owns only the second-to-millisecond scale, which is
// this mint's own concern. The DAY is a parameter, and the parameter this module passes is its own
// notebook's date.
fn captured_epoch_millisecond(day: Iso8601CivilDate, hour: Int, minute: Int, second: Int) -> EpochMs {
  iso8601_unix_seconds_at(
    date: day,
    since_midnight: iso8601_seconds_since_midnight(hour: hour, minute: minute, second: second),
  ) * (milliseconds_per_second() as Int)
}

// THE ONE MINT EVERY BAND GOES THROUGH, including what a claim asks when it wants to know what an
// out-of-order pair does. A claim that re-implemented this fold would be checking a copy of the mint,
// not the mint: same shape, and no way to tell the two apart when they diverge. The ordering argument
// is spelled inline rather than behind a named function: EpochMs is a refinement of Int, the corpus'
// other EpochMs comparisons (gunbc.fleet.mtcollins_firmware_converge's later_of) are ordinary
// comparisons of the refined value, and a name for `<=` alone would be a second name for one operator.
fn captured_band(low: EpochMs, high: EpochMs) -> CapturedInstant {
  interval_construction_fold(
    construction: closed_interval(low: low, high: high, le: (earlier, later) => earlier <= later),
    fold: IntervalConstructionFold {
      ready: i => CaptureTimeBand { band: i },
      refused: r => CaptureTimeBandInverted { reason: r },
    },
  )
}

// a capture line reading `06:4x` licenses the minute it names; the closed interval runs to the last
// whole second inside it, so every reading stays inside the recorded band
fn captured_minute_band(day: Iso8601CivilDate, hour: Int, minute: Int) -> CapturedInstant {
  captured_band(
    low: captured_epoch_millisecond(day: day, hour: hour, minute: minute, second: 0),
    high: captured_epoch_millisecond(
      day: day,
      hour: hour,
      minute: minute,
      second: (iso8601_seconds_per_minute() as Int) - 1,
    ),
  )
}

// the band, read out of the carrier rather than out of a chosen point: a reader gets the ordered pair
// (with std.interval's own bounds proof attached) and cannot mistake either bound for a stopwatch
// reading. No accessor hands out one instant.
fn captured_instant_band(instant: CapturedInstant) -> Optional<OrderedClosedInterval<EpochMs>> {
  match instant {
    CaptureTimeBand { band: b } => Present { value: b }
    CaptureTimeBandInverted { reason: _ } => Absent
  }
}

// DOES ONE BAND LIE ENTIRELY BEFORE ANOTHER? Both sides have to be bands that constructed, and both
// bounds are compared: an earlier band that merely STARTS before a later one does not precede it, and
// a band that failed to construct is not allowed to look early, late, or equal -- it refuses. This is
// the only way ordering is asked of a capture time anywhere, so a claim cannot get a different answer
// from the one a fold would give.
fn captured_band_ordering(earlier: CapturedInstant, later: CapturedInstant) -> CapturedBandOrdering {
  match earlier {
    // WHICH SIDE FAILED IS THE ANSWER, not a detail. A caller that reports "the earlier thing came
    // later" when the earlier band never constructed has drawn a conclusion it never measured, and it
    // points the repair at the wrong fact: a node time that will not build is a defect in the node time.
    // The mint's own words come along, so the refusal is not a fresh claim about the capture.
    CaptureTimeBandInverted { reason: r } => EarlierBandRefuses { reason: r }
    CaptureTimeBand { band: e } =>
      match later {
        CaptureTimeBandInverted { reason: r } => LaterBandRefuses { reason: r }
        CaptureTimeBand { band: l } =>
          if interval_high(interval: e) <= interval_low(interval: l) {
            BandPrecedes
          } else {
            BandDoesNotPrecede
          }
      }
  }
}

// WHY A BAND CANNOT BE ORDERED AGAINST ANOTHER. Four answers, because there are four different facts
// and the old Bool reported all of them as "does not precede": a real late band, an earlier band that
// failed to construct, a later band that failed to construct, and a pair that does lie in order. A
// band that failed to construct is not early, not late and not equal, and saying which side failed is
// what makes the refusal actionable.
type CapturedBandOrdering
  = BandPrecedes
  | BandDoesNotPrecede
  | EarlierBandRefuses { reason: String }
  | LaterBandRefuses { reason: String }

// THE BOOLEAN PROJECTION, for the claims that only ask whether one band lies before another. It is the
// same fold, so a claim cannot get an answer different from the one a gate gets.
fn captured_band_precedes(earlier: CapturedInstant, later: CapturedInstant) -> Bool {
  captured_band_ordering(earlier: earlier, later: later) == BandPrecedes
}

