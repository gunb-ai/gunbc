import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.huggingface.hub { HubRepoId, HubModelRepo, hub_repo_https_uri }
import extdeps.safetensors.format {
  SafetensorsEntry, safetensors_entry, safetensors_entry_span, safetensors_dtype_byte_width,
  SafeU8, SafeF8E4M3, SafeF32,
}
