module extdeps.session_dashboard

import std.types { Bool, NonEmptyStr, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.optional { Present, Absent }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "github.com/gunb-ai/session-dashboard" }
}

type SessionDashboard
  = | GunbSessionDashboard

data session_dashboard: SessionDashboard = GunbSessionDashboard

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.session_dashboard",
      decl_name: "session_dashboard",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.session_dashboard.extdeps_external_authority_anchor,
  further_citations: []
}

type DashboardBaseUrl = NonEmptyStr where brand("DashboardBaseUrl")
type DashboardRelativePath = NonEmptyStr where brand("DashboardRelativePath")

data session_dashboard_tls_note: String = "The session dashboard endpoint named by DASHBOARD_URL is an operator-local HTTPS service with a locally issued certificate (the live session value fails public-root verification). GetFromDashboard admits only a validated HTTPS DashboardBaseUrl plus a root-relative DashboardRelativePath, composes them inside the transport, and still requires curl --fail: HTTP errors are refusals. The tailnet/server placement supplies reachability authorization; this operation must not be reused as a general Internet HTTP client. This landing-dashboard scaffold is owned by the gunbc served-dashboard lane. Dissolve when the dashboard publishes its CA path or the services share an in-process read interface."

fn dashboard_base_url(raw: String) -> DashboardBaseUrl? {
  if starts_with(s: raw, prefix: "https://")
    && !string_contains(s: raw, pattern: "?")
    && !string_contains(s: raw, pattern: "#") {
    Present { value: raw as DashboardBaseUrl }
  } else {
    none
  }
}

fn dashboard_relative_path(raw: String) -> DashboardRelativePath? {
  if starts_with(s: raw, prefix: "/")
    && !starts_with(s: raw, prefix: "//")
    && !string_contains(s: raw, pattern: "://") {
    Present { value: raw as DashboardRelativePath }
  } else {
    none
  }
}

service session_dashboard.Api {
  operation GetFromDashboard {
    input { base: DashboardBaseUrl, path: DashboardRelativePath }
    output {
      body: String from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["curl", "--fail-with-body", "-sS", "--insecure", "{base}{path}"]
    }
  }
}
