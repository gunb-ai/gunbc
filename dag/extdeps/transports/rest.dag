module extdeps.transports.rest



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc9110"
  }
}

data rest_basic_auth_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc7617"
  }
}

data rest_transport_fidelity: std.fidelity.TransportFidelity = std.fidelity.TransportFidelity { depth: L, hermetic: false }

type TlsPosture
  = VerifyPeer
  | InsecureAcceptAnyCert

data tls_posture_default_note: String = "Absent tls posture = VerifyPeer (fail-closed). InsecureAcceptAnyCert is an explicit per-transport-row opt-in for self-signed endpoints (BMCs); a realization must refuse an unrecognized posture value, never widen to a header or to VerifyPeer-silently."

type RestAuthScheme
  = BearerToken
  | HeaderToken { header_name: std.types.NonEmptyStr }
  | BasicCredentials

data rest_auth_value_single_authority_note: String = "The full header value (Bearer <t> / Basic <b64(user:pass)> / raw token for HeaderToken) is derived in ONE place per realization from RestAuthScheme - a dispatch site re-deriving 'Bearer ' from a header name is the §3 fork this row forbids."

data rest_auth_scheme_dissolution_note: String = "RestAuthScheme is forward-looking scaffolding: today the realizations read auth by shape (config-level Bearer/Header via svc_auth, transport-level BasicCredentials via the inline auth_basic username/password record) rather than matching this type. Dissolves when the auth axis is threaded as a first-class RestAuthScheme through parse/interp/emit - the redfish defork (PR B, extdeps.bmc.http redfish_http_hardwired_transport_dissolution_trigger) is its first BasicCredentials consumer; land the type-level consumption with that lane, or delete this row if the inline-record spelling stays the authority."

type RestTargetForm
  = OriginFormOverBase
  | AbsoluteFormTarget

data rest_target_form_note: String = "OriginFormOverBase: url = config endpoint + path template. AbsoluteFormTarget: the path template carries the full scheme://host/... target (RFC 9112 §3.2.2 absolute-form) and interpolates per-call inputs (e.g. a BMC host); a non-empty base alongside an absolute-form path is a typed refusal, never a silent concat."

data rest_target_form_dissolution_note: String = "RestTargetForm is forward-looking scaffolding: absolute-form targeting works today via an empty config base + a full-URL path template (the interp/emit concat `base_url + path`), so the realizations do not yet match this type or enforce the empty-base refusal it names. Dissolves when the empty-base-vs-absolute-path check is realized as a construction wall in parse (the redfish per-call bmc_host ops, PR B, are its first consumer); land it with that lane, or delete this row if the concat spelling stays the authority."

type RestTransportConfig {
  base_url: extdeps.uri.Uri
  auth_token: String?
  auth_header: String?
  headers: Map<String, String>
  response_format: std.serialization.WireFormat
  tls: TlsPosture?
}

data rest_outcome_note: String = "A RESPONSE THAT IS NOT 2xx IS AN ANSWER, NOT AN ABSENCE OF ONE, and until this type existed the realization threw it away. Operations already declare what a status yields - github.Pulls.List declares 200/401/404/422/5xx and twenty-two other extdeps modules declare 204 such arms between them - and the v1 seed parsed every one of those declarations onto the operation node as a response_<status> property and then never read it. dispatch_rest raised InterpError::TypeError with a rendered 'HTTP \{status\}: \{body\}' string instead, so a caller could not reach the status, could not reach the body, and could not persist either without parsing a diagnostic meant for a human. That is specification-without-execution across the whole REST surface, and it is what made a live 401 unrepresentable to the Publication observer that provoked this type.\\n\\nFOUR STATES, DELIBERATELY NOT THREE. RestOk means the operation's declared output fields carry the decoded answer. RestStatusRefused means the request was transported and a remote authority answered with a status this operation does not treat as success - the status and the body it came with are both retained, because the body is usually the only place the remote says WHY. RestTransportRefused means no status exists at all: nothing was answered, so nothing may be reported as an answer. RestBodyUndecodable means a status arrived and the payload beneath it could not be read - the status is known and is carried, and the body is not fabricated as empty. Collapsing the last two would report 'the remote said nothing' for 'we never reached the remote', which are different facts with different remedies; collapsing an unreadable body into an empty one would report silence the remote never chose.\\n\\nWHY status IS HttpStatus AND NOT Int: std.types already carries HttpStatus with its 100-599 range, so a second unconstrained integer here would be a second name for one concept, and a transport-refusal arm would then be able to hold a status that no response can have. There is deliberately no status on RestTransportRefused for the same reason in the other direction - a sentinel zero would be a plausible-looking value standing where the honest answer is that the question does not apply.\\n\\nSCOPE, STATED SO IT IS NOT MISREAD AS COMPLETE: this outcome is carried by an operation that DECLARES an outcome field, and an operation that declares none keeps raising exactly as before. That opt-in is the narrow half of the repair, not its end state - the refusal body also stays a String here rather than being decoded into the shape the response block already names for it. Both dissolve together when the response block becomes the single authority for a result and output derives from its 2xx arm, at which point every operation carries this outcome without declaring it and this field deletes as redundant."

type RestOutcome
  = RestOk
  | RestStatusRefused { status: std.types.HttpStatus, body: String }
  | RestTransportRefused { cause: std.types.NonEmptyStr }
  | RestBodyUndecodable { status: std.types.HttpStatus, cause: std.types.NonEmptyStr }

data rest_exchange_observation_note: String = "THE HTTP CLIENT BOUNDARY REPORTS FACTS AND DECIDES NO OPERATION POLICY. RestResponseObserved says a status arrived and then says separately whether its body was readable; RestExchangeRefused says no response arrived, so no status can be fabricated. The operation-facing RestOutcome above is downstream: the same dispatch_rest fold consumes this carrier whether a real HTTP handler or an exact fixture replay produced it. A replay arm that returned the operation's final output would sit one layer too high and could green while dispatch_rest was broken - the defect in mock_response and the retired recorded-value fixture seam."

type RestBodyObservation
  = RestBodyRead { body: String }
  | RestBodyReadRefused { cause: std.types.NonEmptyStr }

type RestExchangeObservation
  = RestResponseObserved { status: std.types.HttpStatus, body: RestBodyObservation }
  | RestExchangeRefused { cause: std.types.NonEmptyStr }

type RestAuthSensitiveIdentity
  = RestUnauthenticated
  | RestAuthenticated { scheme: std.types.NonEmptyStr, digest: std.content_hash.Fnv1a64Structural }

data rest_authenticated_digest_witness_note: String = "AUTHENTICATED ARM: PIN WITHDRAWN 2026-08-11 (gunbc#8146) - HEADER CORRECTED, was EXECUTED PIN; REPLAY-PATH DEFERRAL TYPED (review 47041, gunbc#7648). RestAuthenticated.digest is Fnv1a64Structural and the seed mint rest_auth_identity_value produces it via atom_identity_hash over '<scheme>\\0<secret>' - the SAME fnv1a64 primitive std.content_hash.content_hash_atom realizes, so an authored fixture reproduces the digest through the modeled surface (content_hash_atom(value: \"<scheme>\\0<secret>\")); an earlier spelling hashed with the host DefaultHasher, a value from outside the family this carrier names, which no dag fixture could ever author. WITHDRAWN EVIDENCE (2026-08-11, gunbc#8146, review 51198) - was EXECUTED EVIDENCE: rest_authenticated_identity_matches_dag_constructed_value (src/v1/tests/src/cross_representation_equality_test.rs, DELETED by the v1 Rust test-suite cutover; the assertion lived only there). It had not executed since the suite went --no-run, so this row was already nominal rather than newly broken. The seed mint itself is untouched. DISSOLVE-ON: re-establish the identity assertion as a floor witness. It previously pins the seed mint ==-equal to the dag-authored identity - RED under a bare-text digest, RED under a non-fnv1a64 digest - plus a secret-inequality control. WHAT REMAINS DEFERRED, AND WHY, TYPED: a full replay-path authenticated witness (fixture matched against a seed-produced invocation through the service dispatch) additionally requires the invocation input_digest, whose per-param limbs content_hash_service_inputs still derives via the host value_hash - not reproducible from .dag - so authoring the matching fixture is blocked on that limb pipeline migrating to the fnv1a64 primitives; that migration also moves the recorded-fixture store keys, so it is its own lane, not a fixture edit here. RUNG, CORRECTED FOR CI ENROLLMENT (calm-badger-682, verified against .github/workflows/ci.yml and gunbc.ci_layer_roots witness_layer_roots): CORRECTED AGAIN 2026-08-11 (gunbc#8146, review 51205) - this paragraph described a CI arrangement that no longer exists, and described it BACKWARDS relative to the change that removed it. It read that CI's only contact with the crate was 'cargo check -p v1-compiler-tests --tests (compile gate; no test execution)'. The build job now runs 'cargo test -p v1-compiler-tests --release' - the retained kernel EXECUTES in required CI, --no-run is gone from both authorities (v2.workflow.ci_v1_compiler_tests_compile_gate_emit and gunbc.ci_workflow) and from the emitted ci.yml. Two separate facts, deliberately not fused: the crate now executes in CI, AND this particular pin is no longer in it, because the module carrying it was deleted by that same cutover. So the reason this note names no executing consumer is deletion, not the old compile-only gate. witness_layer_roots remains dag plus src/v2, so floor discovery still never reaches src/v1/tests; measured, the pin passes locally in 1.66s and reds nothing anywhere. DESIGN 4b defines mechanically preventable as a mechanism that reliably exposes AND blocks, with safety depending on it executing and staying enrolled - so the mint seam sits BELOW that rung, and calling it mechanically prevented is rung inflation, which 4b names as worse than sitting low because an inflated class never ranks for climbing. Deleting the seam guard would leave this control present, compiling, and mute. NOT NEW DEBT FROM THIS PR: content_hash_cross_family_eq_v1_seed_bridge_note cites the same unexecuted crate for the cross-family backstop, so the whole family of seed-bridge controls shares this gap and it is recorded here rather than fixed. The end-to-end authenticated replay path remains unexecuted and must not be reported above either. HAND-RUST RECEIPT (review 47065): the ROADMAP row 'Work through the remaining hand-written files the products need' (authority dag/gunbc/v1_deletion_plan.dag, v1-hand-queue-drain lane) owns the interim seed bridge in rest_auth_identity_value, fnv1a64_structural_value, and rest_authenticated_identity_for_witness. DISSOLVE-ON: that row migrates REST invocation construction out of v1_interpreter; the checkable receipt is deletion of those three hand-Rust symbols while this discriminating equality/inequality witness remains enrolled against the replacement realization. Independently, the input-digest limb migration lands and an authenticated replay witness executes against a seed-produced invocation; this note then deletes."

data rest_bound_invocation_note: String = "REST needs a specialization of v2.std.operation_argv.BoundOperationInvocation rather than pretending its shell-only binding list is enough. OperationRef remains the declaration identity authority. The specialization adds the HTTP method, fully realized URI target, the digest of every declared input, and an auth-sensitive digest whose preimage never enters the fixture. Together those facts make a replay exact: a fixture for another operation, path/query/body input, method, target, or credential identity cannot satisfy this invocation. Query and body values are already in the declared-input digest; constants are fixed by OperationRef."

type RestBoundOperationInvocation {
  at: v2.std.operation_argv.OperationRef
  method: std.types.HttpMethod
  target: extdeps.uri.Uri
  input_digest: std.content_hash.Fnv1a64Structural
  auth_identity: RestAuthSensitiveIdentity
}

type RestExchangeFixture {
  store: std.types.NonEmptyStr
  invocation: RestBoundOperationInvocation
  observation: RestExchangeObservation
}

type RestFixtureScan {
  count: Int
  observation: RestExchangeObservation?
}

type RestFixtureLookup
  = RestFixtureFound { observation: RestExchangeObservation }
  | RestFixtureAbsent { invocation: RestBoundOperationInvocation }
  | RestFixtureAmbiguous { invocation: RestBoundOperationInvocation, count: Int }

data invocation_identity_equality_note: String = "IDENTITY CONSUMES CANONICAL EQUALITY; IT DOES NOT RE-DERIVE IT. An earlier cut carried five hand-rolled predicates - rest_http_method_eq, rest_uri_scheme_eq, rest_uri_eq, rest_operation_ref_eq, rest_auth_identity_eq - each matching every variant of a closed coproduct to decide whether two of them were the same. That is a second representation of equality standing beside the one the substrate already provides, and it is the §2/§3 failure in its most literal form: adding a variant to HttpMethod or UriScheme would leave the predicate silently answering false for the new one, so the duplicate was not merely redundant but decayed differently from the type it claimed to compare (review 46769).\n\nWHAT IS DELIBERATELY NOT COLLAPSED: the field list below, rather than a whole-record a == b. Which facts constitute an exact invocation identity is a modeled decision - operation, method, fully realized target, input digest, and auth identity - and spelling them keeps that decision reviewable at the point it is made. The equality of each named fact is canonical; the choice of which facts to compare is not equality is business."

fn rest_bound_invocation_eq(a: RestBoundOperationInvocation, b: RestBoundOperationInvocation) -> Bool {
  a.at == b.at
    && a.method == b.method
    && a.target == b.target
    && a.input_digest == b.input_digest
    && a.auth_identity == b.auth_identity
}

fn rest_fixture_scan(
  fixtures: List<RestExchangeFixture>,
  store: std.types.NonEmptyStr,
  invocation: RestBoundOperationInvocation,
  scan: RestFixtureScan,
) -> RestFixtureScan {
  if fixtures.count() == 0 {
    scan
  } else {
    let fixture = fixtures.first()
    let matches = fixture.store == store
      && rest_bound_invocation_eq(a: fixture.invocation, b: invocation)
    let next = if matches {
      RestFixtureScan {
        count: scan.count + 1,
        observation: v2.std.optional.Present { value: fixture.observation },
      }
    } else {
      scan
    }
    rest_fixture_scan(
      fixtures: fixtures.skip(n: 1),
      store: store,
      invocation: invocation,
      scan: next,
    )
  }
}

fn rest_exchange_fixture_lookup(
  fixtures: List<RestExchangeFixture>,
  store: std.types.NonEmptyStr,
  invocation: RestBoundOperationInvocation,
) -> RestFixtureLookup {
  let scan = rest_fixture_scan(
    fixtures: fixtures,
    store: store,
    invocation: invocation,
    scan: RestFixtureScan { count: 0, observation: v2.std.optional.Absent },
  )
  if scan.count == 0 {
    RestFixtureAbsent { invocation: invocation }
  } else if scan.count == 1 {
    match scan.observation {
      v2.std.optional.Present { value } => RestFixtureFound { observation: value }
      v2.std.optional.Absent => RestFixtureAbsent { invocation: invocation }
    }
  } else {
    RestFixtureAmbiguous { invocation: invocation, count: scan.count }
  }
}

fn rest_method_verb(method: std.types.HttpMethod) -> std.effect_grant.Verb {
  match method {
    GET => Read
    HEAD => Read
    OPTIONS => Read
    POST => Write
    PUT => Write
    PATCH => Write
    DELETE => Write
  }
}

fn rest_operation_position(at: v2.std.operation_argv.OperationRef) -> std.effect_grant.NamespacePosition {
  std.effect_grant.NamespacePosition {
    tree: std.effect_grant.ServiceOpTree { service: at.service },
    path: [at.operation],
  }
}

type RestHandlerSelection
  = RestHandlerSelected { binding: std.effect_grant.HandlerBinding }
  | RestHandlerUncovered { invocation: RestBoundOperationInvocation }

fn rest_handler_selection(env: std.effect_grant.Envelope, invocation: RestBoundOperationInvocation) -> RestHandlerSelection {
  match covering_grant(
    env: env,
    verb: rest_method_verb(method: invocation.method),
    target: rest_operation_position(at: invocation.at),
  ) {
    CoveredBy { grant } => RestHandlerSelected { binding: grant.binding }
    NoCoveringGrant { verb: _, target: _, frame: _ } => RestHandlerUncovered { invocation: invocation }
  }
}

type RestExchangeResolution
  = RestRealExchangeRequired
  | RestReplayExchangeFound { observation: RestExchangeObservation }
  | RestReplayExchangeAbsent { invocation: RestBoundOperationInvocation }
  | RestReplayExchangeAmbiguous { invocation: RestBoundOperationInvocation, count: Int }
  | RestExchangeHandlerUncovered { invocation: RestBoundOperationInvocation }

data rest_exchange_resolution_note: String = "THE SINGLE HANDLER-BINDING AND LOOKUP DECISION. Runtime code asks this function what the frame's existing effect grant selected; it does not re-read Hermetic/Wet and does not implement its own first-match. RealTransport asks the host HTTP client for a RestExchangeObservation. Replay names a fixture store and reaches the three-valued exact-invocation lookup above. Missing, ambiguous and uncovered are distinct refusals, and none has a real-transport fallback arm."

fn rest_exchange_resolution(
  env: std.effect_grant.Envelope,
  fixtures: List<RestExchangeFixture>,
  invocation: RestBoundOperationInvocation,
) -> RestExchangeResolution {
  match rest_handler_selection(env: env, invocation: invocation) {
    RestHandlerUncovered { invocation: i } => RestExchangeHandlerUncovered { invocation: i }
    RestHandlerSelected { binding } => match binding {
      RealTransport => RestRealExchangeRequired
      Replay { fixture_store } => match rest_exchange_fixture_lookup(
        fixtures: fixtures,
        store: fixture_store as std.types.NonEmptyStr,
        invocation: invocation,
      ) {
        RestFixtureFound { observation } => RestReplayExchangeFound { observation: observation }
        RestFixtureAbsent { invocation: i } => RestReplayExchangeAbsent { invocation: i }
        RestFixtureAmbiguous { invocation: i, count } => RestReplayExchangeAmbiguous { invocation: i, count: count }
      }
    }
  }
}

data rest_auth_scheme_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "a REST realization selects its auth by matching RestAuthScheme rather than reading auth by shape (config-level Bearer/Header via svc_auth, transport-level BasicCredentials via the inline auth_basic record); until then the type is forward-looking scaffolding with no matching consumer")

data rest_target_form_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "a REST realization matches RestTargetForm rather than reaching absolute-form targeting through an empty config base plus a full-URL path template; until then the interp/emit concat of base_url and path is the only realization and the type has no matching consumer")
