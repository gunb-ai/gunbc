module extdeps.transports.rest

import std.types { HttpMethod, FermiDepth }
import std.serialization { WireFormat }
import std.fidelity { TransportFidelity }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc9110"
  }
}

data rest_transport_fidelity: TransportFidelity = TransportFidelity { depth: L, hermetic: false }

type RestTransportConfig {
  base_url: Uri
  auth_token: String?
  auth_header: String?
  headers: Map<String, String>
  response_format: WireFormat
}
