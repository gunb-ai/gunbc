module extdeps.transports.rest

import std.types { HttpMethod, FermiDepth, NonEmptyStr, HttpStatus, Int, String }
import std.serialization { WireFormat }
import std.fidelity { TransportFidelity }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc9110"
  }
}

data rest_basic_auth_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc7617"
  }
}

data rest_transport_fidelity: TransportFidelity = TransportFidelity { depth: L, hermetic: false }

data http_status_class_authority_note: String = "RFC 9110 §15 defines five status classes. They live beside the RFC citation so callers derive class from the grounded status number instead of re-deriving a success boundary in prose or seed Rust. There is no Bool success arm: a Bool collapses five classes into two and bakes a convention the authority already names."

type HttpStatusClass
  = Informational
  | Successful
  | Redirection
  | ClientErrorStatus
  | ServerErrorStatus

fn http_status_class(status: HttpStatus) -> HttpStatusClass {
  if status < 200 { Informational }
  else if status < 300 { Successful }
  else if status < 400 { Redirection }
  else if status < 500 { ClientErrorStatus }
  else { ServerErrorStatus }
}

type RestResponseStatusPattern
  = ExactStatus { code: HttpStatus }
  | StatusHundredsRange { hundreds: Int }

data rest_response_table_authority_note: String = "The operation's declared response {} block is a status-pattern to body-type table — not a success/failure directive. Parse lowers each arm to a response_<pattern> property on the operation node; emit and interp realize the SAME table via rest_response_pattern_matches and rest_response_arm_status_class (§3 single authority). A Successful-class arm decodes into the operation's output {}; other classes decode through the declared body type (fail-closed inhabitance — missing fields or wrong JSON kind refuse before RestResponseRefused). An undeclared status is a typed refusal, never a silent widen."

type RestResponseTableRow {
  pattern: RestResponseStatusPattern
  body_type: String
}

fn rest_response_pattern_matches(pattern: RestResponseStatusPattern, status: HttpStatus) -> Bool {
  match pattern {
    ExactStatus { code: c } => status == c
    StatusHundredsRange { hundreds: h } => status >= (h * 100) && status < ((h + 1) * 100)
  }
}

fn rest_status_hundreds_class(hundreds: Int) -> HttpStatusClass {
  if hundreds == 1 { Informational }
  else if hundreds == 2 { Successful }
  else if hundreds == 3 { Redirection }
  else if hundreds == 4 { ClientErrorStatus }
  else { ServerErrorStatus }
}

fn rest_response_arm_status_class(pattern: RestResponseStatusPattern) -> HttpStatusClass {
  match pattern {
    ExactStatus { code: c } => http_status_class(c)
    StatusHundredsRange { hundreds: h } => rest_status_hundreds_class(h)
  }
}

data rest_response_table_modeled_surface_dissolution_note: String = "Parse still lowers response arms to stringly response_<k> properties on the operation node; the v1 seed interpreter projects each key to RestResponseStatusPattern and calls rest_response_pattern_matches / rest_response_arm_status_class from the caller's compilation closure (no parallel Rust predicates, no dispatch-time recompile). Body decode for error arms uses map_json_to_declared_body_type with per-field typed inhabitance (missing fields, wrong JSON kind, or wrong field type refuse before RestResponseRefused). A closure missing extdeps.transports.rest refuses via Unimplemented. Dissolves when parse stores RestResponseStatusPattern on the operation node and body decode is v2-emitted from the same carrier — owning row: gunbc.plans.transport_argv_anemia_dissolution taad_rest_response_table_interim; interim receipt: census-shrink of compile_rest_response_table_authority / rest_response_table_authority_ctx / rest_status_key_matches / rest_arm_is_success (deleted on this branch)."

type HttpTransportRefused {
  cause: String
}

type HttpResponded {
  status: HttpStatus
  body: String
}

data rest_transport_observation_note: String = "Total observation at the REST transport seam: a status-bearing response (Ok or ureq Error::Status) is HttpResponded { status, body } realized through the operation's declared response table (http_status_class, rest_response_pattern_matches). Success arms map into the operation output; declared error arms refuse via InterpError::RestResponseRefused; undeclared statuses refuse via RestUndeclaredStatus. Transport-layer failures (connection refused, DNS, timeout) refuse via InterpError::HttpTransportRefused — the modeled HttpTransportRefused { cause } carrier."

type TlsPosture
  = VerifyPeer
  | InsecureAcceptAnyCert

data tls_posture_default_note: String = "Absent tls posture = VerifyPeer (fail-closed). InsecureAcceptAnyCert is an explicit per-transport-row opt-in for self-signed endpoints (BMCs); a realization must refuse an unrecognized posture value, never widen to a header or to VerifyPeer-silently."

type RestAuthScheme
  = BearerToken
  | HeaderToken { header_name: NonEmptyStr }
  | BasicCredentials

data rest_auth_value_single_authority_note: String = "The full header value (Bearer <t> / Basic <b64(user:pass)> / raw token for HeaderToken) is derived in ONE place per realization from RestAuthScheme - a dispatch site re-deriving 'Bearer ' from a header name is the §3 fork this row forbids."

data rest_auth_scheme_dissolution_note: String = "RestAuthScheme is forward-looking scaffolding: today the realizations read auth by shape (config-level Bearer/Header via svc_auth, transport-level BasicCredentials via the inline auth_basic username/password record) rather than matching this type. Dissolves when the auth axis is threaded as a first-class RestAuthScheme through parse/interp/emit - the redfish defork (PR B, extdeps.bmc.http redfish_http_hardwired_transport_dissolution_trigger) is its first BasicCredentials consumer; land the type-level consumption with that lane, or delete this row if the inline-record spelling stays the authority."

type RestTargetForm
  = OriginFormOverBase
  | AbsoluteFormTarget

data rest_target_form_note: String = "OriginFormOverBase: url = config endpoint + path template. AbsoluteFormTarget: the path template carries the full scheme://host/... target (RFC 9112 §3.2.2 absolute-form) and interpolates per-call inputs (e.g. a BMC host); a non-empty base alongside an absolute-form path is a typed refusal, never a silent concat."

data rest_target_form_dissolution_note: String = "RestTargetForm is forward-looking scaffolding: absolute-form targeting works today via an empty config base + a full-URL path template (the interp/emit concat `base_url + path`), so the realizations do not yet match this type or enforce the empty-base refusal it names. Dissolves when the empty-base-vs-absolute-path check is realized as a construction wall in parse (the redfish per-call bmc_host ops, PR B, are its first consumer); land it with that lane, or delete this row if the concat spelling stays the authority."

type RestTransportConfig {
  base_url: Uri
  auth_token: String?
  auth_header: String?
  headers: Map<String, String>
  response_format: WireFormat
  tls: TlsPosture?
}
