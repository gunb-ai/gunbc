module extdeps.transports.fidelity



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/transports"
  }
}

data local_direct_transport_fidelity: std.fidelity.TransportFidelity = std.fidelity.TransportFidelity { depth: Xs, hermetic: true }
data interface_stub_transport_fidelity: std.fidelity.TransportFidelity = std.fidelity.TransportFidelity { depth: Xs, hermetic: true }
data unknown_transport_fidelity: std.fidelity.TransportFidelity = std.fidelity.TransportFidelity { depth: std.types.Xl, hermetic: false }

fn transport_fidelity(tc: std.fidelity.TransportClass) -> std.fidelity.TransportFidelity {
  match tc {
    LocalDirect    => local_direct_transport_fidelity
    InterfaceStub  => interface_stub_transport_fidelity
    ShellLocal     => shell_transport_fidelity
    FileBoundary   => extdeps.transports.file.file_transport_fidelity
    RestNetwork    => rest_transport_fidelity
    Unknown        => unknown_transport_fidelity
  }
}

fn transport_depth(tc: std.fidelity.TransportClass) -> std.types.FermiDepth {
  transport_fidelity(tc: tc).depth
}

fn transport_hermetic(tc: std.fidelity.TransportClass) -> Bool {
  transport_fidelity(tc: tc).hermetic
}

fn classify_transports(transports: List<std.fidelity.TransportClass>) -> std.fidelity.DerivedClassification {
  classify_fidelities(fidelities: map(transports, tc => transport_fidelity(tc: tc)))
}
