module extdeps.transports.shell

import std.types { FermiDepth }
import std.fidelity { TransportFidelity }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html"
  }
}

data shell_transport_fidelity: TransportFidelity = TransportFidelity { depth: S, hermetic: true }

type ShellOutputChannel
  = Stdout
  | Stderr
  | StdoutLines
  | ExitSuccess

type ShellTransportConfig {
  working_dir: String?
  env: Map<String, String>
}
