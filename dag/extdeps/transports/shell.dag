module extdeps.transports.shell

import std.types { FermiDepth, Int, NonEmptyStr, String }
import std.fidelity { TransportFidelity }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html"
  }
}

data shell_transport_fidelity: TransportFidelity = TransportFidelity { depth: S, hermetic: true }

// WHAT AN OPERATION'S `from "key"` NAMES ON THE SHELL TRANSPORT: one channel of the process result.
// This is the v2 home of the vocabulary the seed reads as v1.compiler.emit ShellResultChannel and
// shell_result_channel_of_key, transcribed arm for arm and key for key (aliases included) so the two
// directions agree while v1 stays frozen; it is not a narrower copy.
// A STATED CROSS-GENERATION DIVERGENCE (DESIGN section 3b), not an accidental fork. Neither copy can read
// the other: the stage0 seed carries no extdeps.transports module (v1 cannot import this one without
// growing the frozen seed), and v2's source roots do not include src/v1 (no v2 claim can import the
// seed's). The seed's list is frozen (gunbc.v1_maintenance_standing v1_seed_standing), so it changes only
// under that standing's admission test, which a change to this vocabulary must then mirror here.
// DISSOLUTION: the seed's ShellResultChannel and shell_result_channel_of_key are deleted when shell
// transport realization is emitted from v2 (the 3b sibling's consumer), leaving this the only list. The four arms that stood here
// before XL-2 PR3a had no consumer and lacked exit_code (135 corpus rows), so it was completed rather
// than kept beside a second list.
type ShellOutputChannel
  = Stdout
  | Stderr
  | ExitSuccess
  | ExitCode
  | StdoutLines
  | StderrTruncated
  | StderrTotalBytes
  | StderrRetainedBytes

// The key an author writes for a channel; `success` and `exists` are the seed's aliases of
// exit_success and are admitted by shell_output_channel_of_key, never produced here.
fn shell_output_channel_key(channel: ShellOutputChannel) -> String {
  match channel {
    Stdout => "stdout"
    Stderr => "stderr"
    ExitSuccess => "exit_success"
    ExitCode => "exit_code"
    StdoutLines => "stdout_lines"
    StderrTruncated => "stderr_truncated"
    StderrTotalBytes => "stderr_total_bytes"
    StderrRetainedBytes => "stderr_retained_bytes"
  }
}

fn shell_output_channel_of_key(key: String) -> ShellOutputChannel? {
  if key == "stdout" { Present { value: Stdout } }
  else if key == "stderr" { Present { value: Stderr } }
  else if key == "exit_success" || key == "success" || key == "exists" { Present { value: ExitSuccess } }
  else if key == "exit_code" { Present { value: ExitCode } }
  else if key == "stdout_lines" { Present { value: StdoutLines } }
  else if key == "stderr_truncated" { Present { value: StderrTruncated } }
  else if key == "stderr_total_bytes" { Present { value: StderrTotalBytes } }
  else if key == "stderr_retained_bytes" { Present { value: StderrRetainedBytes } }
  else { none }
}

// WHAT AN OPERATION'S `exit { .. }` ARM MATCHES: the process's exit status (POSIX.1-2017 2.8.2,
// extdeps.process.posix_exit). An exit status is an integer, never an HTTP status: a `5xx` class has
// no meaning here and is refused, not coerced. `nonzero` is the seed's spelling for every status but
// exit_code_success (v1.compiler.emit_rust renders it as the wildcard after the zero arm).
type ShellExitPattern
  = ShellExitCode { code: Int }
  | ShellExitNonzero

data shell_exit_nonzero_spelling: String = "nonzero"

// THE FIELDS A `transport shell { .. }` BLOCK DECLARES. This is the operation's DECLARED binding, not
// ShellTransportConfig: that record is the host's runtime configuration (working directory,
// environment), which no operation authors. argv is the command line; stdin is the bytes written to
// the process. Corpus at authoring time: argv 427, stdin 57, nothing else.
type ShellBindingField
  = ShellArgv
  | ShellStdin

fn shell_binding_field_key(field: ShellBindingField) -> String {
  match field {
    ShellArgv => "argv"
    ShellStdin => "stdin"
  }
}

fn shell_binding_field_of_key(key: String) -> ShellBindingField? {
  if key == "argv" { Present { value: ShellArgv } }
  else if key == "stdin" { Present { value: ShellStdin } }
  else { none }
}

type ShellTransportConfig {
  working_dir: String?
  env: Map<String, String>
}

// A PROGRAM THAT NEVER RAN HAS NO EXIT STATUS, and until this type existed the realization had no
// way to say so except by aborting the evaluation. When argv[0] cannot be spawned -- the binary is
// absent from PATH, or present and not executable -- no process exists, so exit_code, exit_success,
// stdout and stderr are not unfavourable answers but questions that do not apply. The seed raised
// an untyped error instead, which unwound the whole evaluation: a caller that models a refusal arm
// could not reach it, and an outer attempt that should have recorded the failure recorded nothing.
//
// TWO STATES. ShellExited means a process was spawned and ran to an exit status; the operation's
// declared output fields carry that status and its captured streams, and a nonzero exit is an
// answer read from them, not a transport failure. ShellSpawnRefused means the transport never
// produced a process: the program and the host's reason are retained, and every other declared
// field is absent rather than fabricated -- a sentinel exit code or an empty stdout would be a
// plausible-looking answer where the honest one is that nothing answered. This is the shell
// counterpart of extdeps.transports.rest RestTransportRefused, and it is kept distinct from a
// nonzero exit for the same reason RestTransportRefused is kept distinct from a status: 'the
// program said no' and 'there was no program' have different remedies.
//
// SCOPE, STATED SO IT IS NOT MISREAD AS COMPLETE: an operation carries this outcome by declaring an
// output field of type ShellOutcome, exactly as RestOutcome is opted into. An operation that
// declares none still refuses the evaluation on a spawn failure, now as the typed seed diagnostic
// shell-spawn-refused rather than a rendered type error. Both transports' opt-ins dissolve together
// when an operation's result authority derives its transport-failure arm without a declared field.
type ShellOutcome
  = ShellExited
  | ShellSpawnRefused { program: NonEmptyStr, cause: NonEmptyStr }

// WHAT THE SHELL TRANSPORT OBSERVES, as a value: a process that ran to an exit status with its two
// captured streams, or no process at all. This is the observation a modeled operation realization
// (v2.std.operation_realization) supplies in place of a spawned process; the interpreter feeds it to
// the same declared-output projection a real process result reaches, so every field an operation
// declares from stdout, stderr or the exit status is derived exactly as it would be from a real run.
type ShellExchangeObservation
  = ShellProcessExited { exit_code: Int, stdout: String, stderr: String }
  | ShellProcessSpawnRefused { program: NonEmptyStr, cause: NonEmptyStr }
