module extdeps.vendor.gitlab

import extdeps.vendor { Vendor }
import extdeps.securities { Securities }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.sec.gov/cgi-bin/browse-edgar?CIK=GTLB"
  }
}

data gitlab: Vendor<Securities> = Vendor { legal_name: "GitLab Inc." }
