module extdeps.vendor.aspeed


// THE LEGAL ENTITY BEHIND THE AST2500 DATASHEET. ASPEED Technology Inc. is the
// manufacturer named on the AST2500/AST2520 A2 datasheet; this row grounds the
// vendor axis separately from any platform document that merely names the part.
data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.aspeedtech.com/about.php"
  }
}

data aspeed_registrant_note: String = "ASPEED Technology Inc. is cited from its corporate About page as the manufacturer of the AST2500 integrated remote-management processor family. The chip's mechanical and electrical facts live in extdeps.bmc.aspeed_ast2500 under the datasheet citation there; this module owns only the company entity."

data aspeed: extdeps.vendor.Vendor<extdeps.hardware.Hardware> = extdeps.vendor.Vendor { legal_name: "ASPEED Technology Inc." }

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.vendor.aspeed",
      decl_name: "aspeed",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
