module extdeps.vendor.tyco_electronics_amp_kk

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }

// From the header of application specification 114-115006 Rev C, read 2026-08-14: "Tyco
// Electronics AMP K.K. (3-5-8 Hisamoto Takatsu-ku Kawasaki, 213-8535)".
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.te.com/commerce/DocumentDelivery/DDEController?Action=showdoc&DocId=Specification+Or+Standard%7F114-115006%7FB%7Fpdf%7FEnglish%7FENG_SS_114-115006_B_114-115006_REV_B.pdf%7F2199119-3"
  }
}

// A SEPARATE ROW FROM extdeps.vendor.tyco_electronics, DELIBERATELY. Two application
// specifications read the same day carry different header entities: the DDR4 socket document is
// issued by Tyco Electronics Corporation of Harrisburg, Pennsylvania, the M.2 document by Tyco
// Electronics AMP K.K. of Kawasaki, Japan, with its own registered address. One brand, but folding
// them into one vendor row is what DESIGN section 3 forbids: independently governed entities under
// a shared brand are not one authority, and a correction to either would edit the other. NOT
// established: their relationship - parent, subsidiary, or successor - because no document read
// establishes it; asserting one would invent corporate structure to tidy a roster.

data tyco_electronics_amp_kk: Vendor<Hardware> = Vendor { legal_name: "Tyco Electronics AMP K.K." }

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.vendor.tyco_electronics_amp_kk",
      decl_name: "tyco_electronics_amp_kk",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
