module extdeps.vendor.macronix


// Read 2026-08-14.
data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Macronix"
  }
}

data macronix_registrant_note: String = "Read 2026-08-14: an integrated device manufacturer of non-volatile memory, headquartered in Taiwan. The entry also gives the name in Chinese characters, which is not carried here because this row's legal_name is a single field and choosing which script it holds would be a decision no document read here makes; a later reader adding a script-aware name carrier is grounding something this row leaves open rather than correcting it."

data macronix: extdeps.vendor.Vendor<extdeps.hardware.Hardware> = extdeps.vendor.Vendor { legal_name: "Macronix International Co., Ltd." }

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
