module extdeps.vendor.ampere



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Ampere_Computing"
  }
}

data ampere_customer_reference_boards_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "amperecomputing.com/home/customer-reference-boards",
  }
}

data ampere_vendor: extdeps.vendor.Vendor<extdeps.hardware.Hardware> = extdeps.vendor.Vendor { legal_name: "Ampere Computing LLC" }
