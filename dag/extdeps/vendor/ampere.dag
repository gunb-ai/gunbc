module extdeps.vendor.ampere



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Ampere_Computing"
  }
}

data ampere_customer_reference_boards_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "amperecomputing.com/home/customer-reference-boards",
  }
}

data ampere_vendor: Vendor<extdeps.hardware.Hardware> = Vendor { legal_name: "Ampere Computing LLC" }
