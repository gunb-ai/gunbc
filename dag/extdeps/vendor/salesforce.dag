module extdeps.vendor.salesforce

import extdeps.vendor { Vendor }
import extdeps.securities { Securities }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.sec.gov/cgi-bin/browse-edgar?CIK=CRM"
  }
}

data salesforce: Vendor<Securities> = Vendor { legal_name: "Salesforce, Inc." }
