module extdeps.gunbc


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/gunbc"
  }
}

type CrateRole
  = TransportBoundary
  | Compiler
  | CodegenBootstrap
  | Runtime
  | Infra
  | Library
  | Tool

type WorkspacePackage {
  name: String
  role: CrateRole
  description: String
  io_boundary: Bool
}

data packages: List<WorkspacePackage> = [

  { name: "gunbc-lib-transport",
    role: TransportBoundary,
    description: "Designated I/O boundary: all filesystem, network, process I/O flows through here",
    io_boundary: true },

  { name: "gunbc-exec",
    role: Runtime,
    description: "DAG execution engine with freshness checking and CI display",
    io_boundary: false },

  { name: "gunbc-ir",
    role: Infra,
    description: "Intermediate representation types, workspace layout, transport credential",
    io_boundary: false },
  { name: "gunbc-infra",
    role: Infra,
    description: "Leaf infrastructure: ResourceId, ContentHash, hash, manifest, freshness",
    io_boundary: false },

  { name: "gunbc-codegen",
    role: CodegenBootstrap,
    description: "Code generation from IR to Rust/Go/C/MIPS targets",
    io_boundary: false },

  { name: "daglang-syntax",
    role: Compiler,
    description: "DAG lexer and parser",
    io_boundary: false },
  { name: "daglang-resolve",
    role: Compiler,
    description: "DAG module resolution and dependency graph",
    io_boundary: false },
  { name: "daglang-typecheck",
    role: Compiler,
    description: "DAG type checking and validation",
    io_boundary: false },
  { name: "daglang-lower",
    role: Compiler,
    description: "lowering to DAG IR",
    io_boundary: false },
  { name: "daglang-emit",
    role: Compiler,
    description: "Backend code emission (Rust, Go, C, MIPS)",
    io_boundary: false },
  { name: "daglang-driver",
    role: Compiler,
    description: "Compiler driver: orchestrates parse -> resolve -> typecheck -> lower -> emit",
    io_boundary: false },
  { name: "daglang-cli",
    role: Compiler,
    description: "CLI frontend for the DAG compiler",
    io_boundary: false },

  { name: "gunbc-app",
    role: CodegenBootstrap,
    description: "Workspace DAG: tool graphs, extern impls, policy, registry",
    io_boundary: false },

]

service gunbc.WitnessBin {
  operation Run {
    input { workdir: FilePath, bin_path: FilePath, args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["env", "-C", "{workdir}", "{bin_path}", args] }
    exit {
      0 => Unit
      nonzero => String "Witness binary exited nonzero"
    }
  }
}

service shell.Codegen {
  operation Check {
    input {}
    output { needed: Bool from "exit_success" }
    readonly

    transport shell { argv: ["test", "-f", "target/codegen/.stamp"] }
    exit {
      0 => Unit "File exists"
      1 => Unit "File does not exist"
    }
  }

  operation Run {
    input {}
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["cargo", "run", "--bin", "gunbc-codegen", "--", "codegen"] }
    exit {
      0 => Unit
      nonzero => String "Codegen failed"
    }
  }
}
