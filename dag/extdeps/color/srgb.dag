module extdeps.color.srgb

import std.types { Int, String, Bool }
import std.integer { uint8_channel_inclusive_max_value_derived }
import std.measure {
  basis_point_unity_count,
  permyriad_half_for_round_half_up,
  percent_scale_hundred,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.numeric.base16 { byte_hex_lower }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.w3.org/TR/css-color-4/#numeric-srgb"
  }
}

data color_srgb_note: String = "Cited upstream: W3C CSS Color Module Level 4 (retrieved 2026-07-21) — the sRGB color space (whose normative definition CSS4 cites to IEC 61966-2-1), 8-bit component notation, hex serialization (#rrggbb, section 'The RGB hexadecimal notations'), and the HSL<->sRGB conversion algorithm (section 'HSL Colors'). This module owns COLOR-SPACE facts only: what a color value IS and how representations convert. Perceptual LAW over colors (relative luminance, contrast thresholds) is extdeps.accessibility.wcag_contrast, which imports this module — accessibility consumes the color space, it does not own it (DESIGN sect 3: the conversion previously lived inside wcag_contrast; re-homed 2026-07-21). Srgb8 is the authored identity for catalogued colors — a hex literal is a SERIALIZATION of Srgb8, never the stored fact (decompress the string, DESIGN sect 2). RgbScaled is the permyriad-scale integer representation (one unit = 0.0001 of a channel) shared by the integer kernels; conversions here are exact at the representation's precision, no floats, no host math. OKLCH coordinates are the named next representation (design-register-library.md sect 10 Class 2, phase A.2): the cube-root kernel follows the same integer-Newton pattern wcag_contrast proves for the 2.4 exponent."

data color_census_frontier: String = "Staged leaf-census items dissolved in Phase-A arc (msg_e9cfe443): (1-4) srgb_byte_denominator / permyriad / hue_milli / percent-round — grounded on std.integer.uint8_channel_inclusive_max_value_derived (from bits_per_byte), std.measure.basis_point_unity_count (extdeps.units.dimensionless), hue_angle facts below; (5) Achromatic HslProjection variant per CSS4 hue-is-none; (14) hex_digit deduped onto extdeps.numeric.base16. Remaining: OKLCH reground design-register-library.md sect 10 Class 2 (explicit trigger, excluded from this PR)."

type Srgb8 {
  r: Int
  g: Int
  b: Int
}

type CitedColorRow {
  name: String
  color: Srgb8
}

fn srgb8_admissible(c: Srgb8) -> Bool {
  match uint8_channel_inclusive_max_value_derived() {
    Present { value: maxv } =>
      c.r >= 0 && c.r <= maxv
        && c.g >= 0 && c.g <= maxv
        && c.b >= 0 && c.b <= maxv
    Absent => false
  }
}

fn srgb8_hex(c: Srgb8) -> String {
  join(["#", byte_hex_lower(v: c.r), byte_hex_lower(v: c.g), byte_hex_lower(v: c.b)], "")
}

type RgbScaled {
  r: Int
  g: Int
  b: Int
}

fn srgb8_to_scaled(c: Srgb8) -> RgbScaled? {
  match uint8_channel_inclusive_max_value_derived() {
    Present { value: maxv } => {
      let denom = basis_point_unity_count()
      Present {
        value: RgbScaled {
          r: (c.r * denom) / maxv,
          g: (c.g * denom) / maxv,
          b: (c.b * denom) / maxv,
        }
      }
    }
    Absent => none
  }
}

fn iabs(v: Int) -> Int {
  if v < 0 { 0 - v } else { v }
}

fn imax(a: Int, b: Int) -> Int {
  if a > b { a } else { b }
}

fn imin(a: Int, b: Int) -> Int {
  if a < b { a } else { b }
}

data full_turn_degrees: Int = 360

data hexcone_sextant_count: Int = 6

fn sextant_arc_degrees() -> Int {
  full_turn_degrees / hexcone_sextant_count
}

data millidegrees_per_degree: Int = 1000

fn hue_milli_per_sextant() -> Int {
  sextant_arc_degrees() * millidegrees_per_degree
}

fn hue_milli_per_two_sextants() -> Int {
  hue_milli_per_sextant() * 2
}

fn hue_milli_per_four_sextants() -> Int {
  hue_milli_per_sextant() * 4
}

fn full_turn_millidegrees() -> Int {
  hue_milli_per_sextant() * hexcone_sextant_count
}

data hsl_projection_note: String = "HslProjection: chromatic rows carry h in degrees [0, 360); Achromatic rows omit hue per CSS Color 4 hue-is-none (delta=0). s_pct and l_pct are bounded Int percent counts [0, 100] from the CSS Color 4 integer algorithm. Percent carrier at register binding is deferred — see std.measure.percent_from_computed_int_frontier. OKLCH reground: design-register-library.md sect 10 Class 2."

type ColorConversionFrontier
  = HslLive
  | OklchStaged { trigger: String }

data color_conversion_frontier: ColorConversionFrontier = OklchStaged {
  trigger: "Exact OKLab/OKLCH requires Float channel math and cube-root; land when design-register-library.md sect 10 Class 2 fires; HSL projection is live now (integer-friendly, CSS Color 4 sRGB<->HSL)."
}

type HslProjection
  = Chromatic { h: Int, s_pct: Int, l_pct: Int }
  | Achromatic { l_pct: Int }

fn hsl_projection_s_pct(p: HslProjection) -> Int {
  match p {
    Chromatic { h: _, s_pct, l_pct: _ } => s_pct
    Achromatic { l_pct: _ } => 0
  }
}

fn hsl_projection_l_pct(p: HslProjection) -> Int {
  match p {
    Chromatic { h: _, s_pct: _, l_pct } => l_pct
    Achromatic { l_pct } => l_pct
  }
}

fn pct_round_from_scaled(v_scaled: Int) -> Int {
  let denom = basis_point_unity_count()
  (v_scaled * percent_scale_hundred() + permyriad_half_for_round_half_up()) / denom
}

fn srgb8_to_hsl_projection(c: Srgb8) -> HslProjection? {
  match uint8_channel_inclusive_max_value_derived() {
    Present { value: maxv } => Present {
      value: srgb8_to_hsl_projection_for_max(
        c: c,
        maxv: maxv,
        denom: basis_point_unity_count(),
      )
    }
    Absent => none
  }
}

fn srgb8_to_hsl_projection_for_max(c: Srgb8, maxv: Int, denom: Int) -> HslProjection {
  let rs = (c.r * denom) / maxv
  let gs = (c.g * denom) / maxv
  let bs = (c.b * denom) / maxv
  let maxc = imax(a: imax(a: rs, b: gs), b: bs)
  let minc = imin(a: imin(a: rs, b: gs), b: bs)
  let delta = maxc - minc
  let l_scaled = (maxc + minc) / 2
  let light_pct = pct_round_from_scaled(v_scaled: l_scaled)
  if delta == 0 {
    Achromatic { l_pct: light_pct }
  } else {
    let denom_sat = denom - iabs(v: 2 * l_scaled - denom)
    let sat_scaled = if denom_sat == 0 { 0 } else { (delta * denom) / denom_sat }
    let sat_pct = pct_round_from_scaled(v_scaled: sat_scaled)
    let hue_milli = if maxc == rs {
      ((gs - bs) * hue_milli_per_sextant()) / delta
    } else if maxc == gs {
      (((bs - rs) * hue_milli_per_sextant()) / delta) + hue_milli_per_two_sextants()
    } else {
      (((rs - gs) * hue_milli_per_sextant()) / delta) + hue_milli_per_four_sextants()
    }
    let hue_deg = ((hue_milli % full_turn_millidegrees()) + full_turn_millidegrees()) % full_turn_millidegrees() / millidegrees_per_degree
    Chromatic { h: hue_deg, s_pct: sat_pct, l_pct: light_pct }
  }
}

fn hsl_to_rgb_scaled(hue: Int, sat_pct: Int, light_pct: Int) -> RgbScaled {
  let denom = basis_point_unity_count()
  let l = light_pct * percent_scale_hundred()
  let s = sat_pct * percent_scale_hundred()
  let c = ((denom - iabs(v: 2 * l - denom)) * s) / denom
  let h2 = ((hue % full_turn_degrees) + full_turn_degrees) % full_turn_degrees
  let two_sextant_deg = sextant_arc_degrees() * 2
  let t = ((h2 % two_sextant_deg) * denom) / sextant_arc_degrees()
  let x = (c * (denom - iabs(v: t - denom))) / denom
  let m = l - c / 2
  let sextant = h2 / sextant_arc_degrees()
  if sextant == 0 {
    RgbScaled { r: c + m, g: x + m, b: m }
  } else if sextant == 1 {
    RgbScaled { r: x + m, g: c + m, b: m }
  } else if sextant == 2 {
    RgbScaled { r: m, g: c + m, b: x + m }
  } else if sextant == 3 {
    RgbScaled { r: m, g: x + m, b: c + m }
  } else if sextant == 4 {
    RgbScaled { r: x + m, g: m, b: c + m }
  } else {
    RgbScaled { r: c + m, g: m, b: x + m }
  }
}
