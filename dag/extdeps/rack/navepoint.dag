module extdeps.rack.navepoint


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.navepoint.com"
  }
}

// Operator-supplied rack identity. The exact serial and U layout are OBSERVATIONS on the
// owned instance rather than facts this catalog may author, so they are absent by intent.
data navepoint_18u_open_frame_catalog: extdeps.rack.types.RackCatalogRow = extdeps.rack.types.RackCatalogRow {
  model: "18U 4-post open-frame rack",
  manufacturer: extdeps.vendor.navepoint.navepoint,
  rack_units: std.measure.rack_unit(18),
  post_count: 4,
  open_frame: true,
}

