// Operator-supplied rack identity. The exact serial and U layout are OBSERVATIONS on the
// owned instance rather than facts this catalog may author, so they are absent by intent.
data navepoint_18u_open_frame_catalog: RackCatalogRow = RackCatalogRow {
  model: "18U 4-post open-frame rack",
  manufacturer: navepoint,
  rack_units: rack_unit(18),
  post_count: 4,
  open_frame: true,
}

