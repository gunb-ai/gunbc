module extdeps.cron


import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.types { Bool, List, Unit }
import std.decl_ref { DeclarationRef, WholeDeclaration }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/crontab.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cron",
      decl_name: "cron",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

service cron.Tab {
  operation List {
    requires none
    input {}
    output { entries: String from "stdout" }
    readonly
    transport shell { argv: ["crontab", "-l"] }
    exit {
      0 => Unit
      1 => Unit "No crontab for user"
    }
  }

  operation Replace {
    requires none
    input { entries: String }
    output { success: Bool from "exit_success", stdout: String from "stdout", stderr: String from "stderr" }
    transport shell {
      argv: ["crontab", "-"]
      stdin: entries
    }
    exit {
      0 => Unit
      nonzero => String "Crontab install failed"
    }
  }
}
