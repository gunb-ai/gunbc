module extdeps.cpu


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Central_processing_unit"
  }
}

fn cpu_vendor(cpu: extdeps.cpu.types.CpuFacts) -> Vendor<Hardware> {
  cpu.catalog.vendor
}

fn cpu_facts_cores(cpu: extdeps.cpu.types.CpuFacts) -> Int {
  cpu.catalog.cores
}

fn cpu_facts_threads(cpu: extdeps.cpu.types.CpuFacts) -> std.measure.HardwareThreadCount {
  cpu.catalog.threads
}

fn cpu_facts_architecture(cpu: extdeps.cpu.types.CpuFacts) -> extdeps.toolchain.types.Architecture {
  cpu.catalog.architecture
}

fn cpu_facts_sustained_per_thread_hz(cpu: extdeps.cpu.types.CpuFacts) -> std.measure.Hertz {
  cpu.deployment.sustained_per_thread_hz
}
