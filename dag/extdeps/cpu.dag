module extdeps.cpu


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Central_processing_unit"
  }
}

fn cpu_vendor(cpu: CpuFacts) -> Vendor<Hardware> {
  cpu.catalog.vendor
}

fn cpu_facts_cores(cpu: CpuFacts) -> Int {
  cpu.catalog.cores
}

fn cpu_facts_threads(cpu: CpuFacts) -> HardwareThreadCount {
  cpu.catalog.threads
}

fn cpu_facts_architecture(cpu: CpuFacts) -> Architecture {
  cpu.catalog.architecture
}

fn cpu_facts_sustained_per_thread_hz(cpu: CpuFacts) -> Hertz {
  cpu.deployment.sustained_per_thread_hz
}
