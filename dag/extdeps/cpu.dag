module extdeps.cpu


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.cpu.types { CpuFacts }
import extdeps.toolchain.types { Architecture }
import std.measure { HardwareThreadCount, Hertz }
import std.types { Int }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Central_processing_unit"
  }
}

// Reading: en.wikipedia.org owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its fn declaration cpu_vendor, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cpu",
      decl_name: "cpu_vendor",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

fn cpu_vendor(cpu: CpuFacts) -> Vendor<Hardware> {
  cpu.catalog.vendor
}

fn cpu_facts_cores(cpu: CpuFacts) -> Int {
  cpu.catalog.cores
}

fn cpu_facts_threads(cpu: CpuFacts) -> HardwareThreadCount {
  cpu.catalog.threads
}

fn cpu_facts_architecture(cpu: CpuFacts) -> Architecture {
  cpu.catalog.architecture
}

fn cpu_facts_sustained_per_thread_hz(cpu: CpuFacts) -> Hertz {
  cpu.deployment.sustained_per_thread_hz
}
