module extdeps.ninfer.replayed_tokens_total

import std.types { String, NonEmptyStr, Bool, List }
import std.optional { Present, Absent }
import std.nat { Nat }
import std.measure { TokenCount, token_count }
import std.checked_arithmetic { nat_from_last_space_token }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, CitedFigureStanding, TranscribedUncited }

// NINFER'S REPLAYED-TOKEN COUNTER LINE, not a gpu-bench kit schema. The metric name is
// ninfer_replayed_tokens_total; later snapshots overwrite earlier ones (phase counter).

data ninfer_replayed_tokens_total_marker: NonEmptyStr = "ninfer_replayed_tokens_total" as NonEmptyStr

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "github.com/Neroued/ninfer" as NonEmptyStr }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ninfer.replayed_tokens_total",
      decl_name: "ninfer_replayed_tokens_total_marker",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

data ninfer_replayed_tokens_total_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "Read ninfer's metric printer at github.com/Neroued/ninfer and cite the ninfer_replayed_tokens_total line as CitedToAuthority. Until then this is the observed process-log spelling, not an upstream-published contract." as NonEmptyStr
}

type NinferReplayedTokensRead
  = NinferReplayedTokensRead { tokens: TokenCount }
  | NinferReplayedTokensAbsent
  | NinferReplayedTokensMalformed { cause: NonEmptyStr }

fn ninfer_replayed_tokens_line_prefix() -> String {
  join([ninfer_replayed_tokens_total_marker as String, " "], "")
}

fn ninfer_replayed_tokens_from_line(line: String) -> NinferReplayedTokensRead? {
  if string_contains(s: line, pattern: ninfer_replayed_tokens_line_prefix()) && !string_contains(s: line, pattern: "#") {
    match nat_from_last_space_token(line: line) {
      Absent => Present {
        value: NinferReplayedTokensMalformed {
          cause: join([ninfer_replayed_tokens_total_marker as String, " last token is not a natural"], "") as NonEmptyStr
        }
      }
      Present { value: n } => Present { value: NinferReplayedTokensRead { tokens: token_count(count: n) } }
    }
  } else {
    none
  }
}

fn ninfer_replayed_tokens_total(log: String) -> NinferReplayedTokensRead {
  if log == "" {
    NinferReplayedTokensAbsent
  } else {
    fold(split(s: log, delimiter: "\n"), init: NinferReplayedTokensAbsent, f: fn(acc, line) {
      match acc {
        NinferReplayedTokensMalformed { cause: c } => NinferReplayedTokensMalformed { cause: c }
        NinferReplayedTokensAbsent =>
          match ninfer_replayed_tokens_from_line(line: line) {
            Absent => NinferReplayedTokensAbsent
            Present { value: next } => next
          }
        NinferReplayedTokensRead { tokens: t } =>
          match ninfer_replayed_tokens_from_line(line: line) {
            Absent => NinferReplayedTokensRead { tokens: t }
            Present { value: next } => next
          }
      }
    })
  }
}
