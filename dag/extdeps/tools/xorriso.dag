module extdeps.tools.xorriso


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.gnu.org/software/xorriso/"
  }
}

data xorriso_pinned_version: extdeps.version.VersionConstraint = ">= 1.5"

data xorriso_cli_tool: extdeps.tools.CliTool = extdeps.tools.CliTool {
  name: "xorriso",
  min_version: Present { value: xorriso_pinned_version },
  installable_via: [extdeps.tools.SourceApt { package: extdeps.apt.package_xorriso }],
}

service xorriso.Iso {
  operation ExtractPathBestEffort {
    input { iso_path: std.types.NonEmptyStr, iso_internal_path: std.types.NonEmptyStr, destination: std.types.NonEmptyStr }
    output { success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["xorriso", "-osirrox", "on", "-indev", "{iso_path}", "-extract", "{iso_internal_path}", "{destination}"]
    }
    exit {
      0 => Unit "extracted"
      nonzero => Unit "path not present on ISO"
    }
  }

  operation ExtractTree {
    input { iso_path: std.types.NonEmptyStr, destination: std.types.NonEmptyStr }
    output { success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["xorriso", "-osirrox", "on", "-indev", "{iso_path}", "-extract", "/", "{destination}"]
    }
    exit {
      0 => Unit
      nonzero => String "xorriso -extract / failed"
    }
  }

  operation BuildIso {
    input { volume_id: std.types.NonEmptyStr, output_path: std.types.NonEmptyStr, source_dir: std.types.NonEmptyStr }
    output { success: Bool from "exit_success" }
    transport shell {
      argv: ["xorriso", "-as", "mkisofs", "-r", "-V", "{volume_id}", "-o", "{output_path}", "-graft-points", "/={source_dir}"]
    }
    exit {
      0 => Unit
      nonzero => String "xorriso -as mkisofs failed"
    }
  }

  operation ReplayBuildWithTwoMaps {
    input {
      stock_iso_path: std.types.NonEmptyStr,
      output_path: std.types.NonEmptyStr,
      volume_id: std.types.NonEmptyStr,
      map_one_source: std.types.NonEmptyStr,
      map_one_iso_path: std.types.NonEmptyStr,
      map_two_source: std.types.NonEmptyStr,
      map_two_iso_path: std.types.NonEmptyStr,
    }
    output { success: Bool from "exit_success" }
    transport shell {
      argv: ["xorriso", "-indev", "{stock_iso_path}", "-outdev", "{output_path}", "-boot_image", "any", "replay", "-volid", "{volume_id}", "-map", "{map_one_source}", "{map_one_iso_path}", "-map", "{map_two_source}", "{map_two_iso_path}", "-commit"]
    }
    exit {
      0 => Unit
      nonzero => String "xorriso -boot_image any replay build failed"
    }
  }
}
