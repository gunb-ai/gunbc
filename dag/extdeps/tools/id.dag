module extdeps.tools.id

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { NonEmptyStr, List, Bool, Unit }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/id.1.html"
  }
}

// THE ABSOLUTE PATH IS LOAD-BEARING, NOT PEDANTRY. The builders in this module name `id` bare and
// resolve through PATH, which is right for a remote shell. A sudoers NOPASSWD rule matches on the
// command PATH, so a privileged invocation that names the binary bare is a different subject from the
// one the grant authorizes -- and gunbc.host.host_effect_realize needs both spellings for the same
// tool (its own *_absolute rows spell the binary through this path).
data id_binary_path: NonEmptyStr = "/usr/bin/id"

// THE PATH-RESOLVED SPELLING, DECLARED ONCE. Every argv row and command builder in this module names
// the same program through this identity, and spelling the word again per builder would be another
// place one word could drift. The numeric flag pairs exist ONCE, as the sealed builders below
// (id_uid_command, id_gid_command) -- the module's own header rule applied to the flags themselves.
fn id_program() -> ProgramIdentity = uncataloged_program(invocation: "id")

// NO OPERAND, DELIBERATELY: id(1) with no operand answers from the CALLING PROCESS's own
// credentials, established at its exec and never changing afterwards. The reach probe asks "which
// account did the transport actually reach", and the only account that can say is the one the session
// IS — so the probe supplies no user and reads the login name the session itself carries. A user
// operand would ask the account database about a different account and answer the wrong question.
//
// -un, NOT -u: -n selects NAMES over numeric uids (the probe records the login name it was granted,
// not a per-host uid), and -u then prints that name alone rather than the full `id` record. One flag
// for the name, one for the field; the probe trims the newline the remote shell leaves on stdout.
fn id_user_name_argv() -> List<String> {
  [id_program().invocation as String, "-un"]
}

// -gn WITH NO OPERAND: the PRIMARY GROUP NAME of THE CALLING PROCESS. -n selects NAMES over numeric gids
// and -g picks the primary group, which is the group a process may chgrp an entry to without privilege.
// It exists because find(1)'s `%g` prints the group NAME when the account database maps the gid to one
// and the number when it does not: a witness that groups its own tree to a token and then reads the tree
// back must compare against the spelling the tool used for the same inode, so it asks for the name the
// way find would print it. The no-operand rule is the one every probe in this module follows -- the
// account database cannot tell you what a process that is already running holds.
fn id_group_name_command() -> ArgvCommand {
  argv_command(program: id_program(), arguments: ["-gn"])
}

// -nG NAMES THE USER EXPLICITLY, AND THAT IS THE WHOLE REASON THIS BUILDER TAKES ONE. id(1) with an
// operand answers from the account database; id(1) with no operand answers from the CALLING
// PROCESS's own credentials, which were established at its exec and never change afterwards. A
// caller asking whether a supplementary group grant has landed must ask the database -- the running
// process cannot have picked the group up, so the no-operand form would answer the older question
// and read as a refusal of a grant that is in fact installed.
//
// -n asks for names rather than numeric gids, because the group a caller holds is named by the
// authority it came from (a udev rule naming "kvm"), not by a gid that varies per host.
fn id_group_names_command(user: NonEmptyStr) -> ArgvCommand {
  argv_command(program: id_program(), arguments: ["-nG", "--", user as String])
}

// -g WITH NO OPERAND: the PRIMARY GROUP of THE CALLING PROCESS, numeric. The counterpart of
// id_uid_command's no-operand rule, and for the same reason: install(1) takes a numeric owner:group, and
// a witness that seeds a tree must seed it with the group it actually holds. A caller asking whether a
// SUPPLEMENTARY group has landed must instead ask the account database (id_group_names_command), because
// a running process cannot have picked one up.
fn id_gid_command() -> ArgvCommand {
  argv_command(program: id_program(), arguments: ["-g"])
}

// -u WITH NO OPERAND: the uid of THE CALLING PROCESS, which is the account the transport actually
// reached -- the counterpart of id_user_name_argv's no-operand rule, in numeric form. install(1) takes a
// numeric owner, and a witness that seeds a tree must seed it with the owner it is actually allowed to
// claim; asking the account database for a name and guessing the number is how a witness ends up
// asserting a mode it never had.
fn id_uid_command() -> ArgvCommand {
  argv_command(program: id_program(), arguments: ["-u"])
}

// -u WITH AN OPERAND: the named account's numeric uid, from the account database (as above).
fn id_uid_of_command(user: NonEmptyStr) -> ArgvCommand {
  argv_command(program: id_program(), arguments: ["-u", "--", user as String])
}

service os.Id {
  operation Uid {
    requires none
    input {}
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "-u"] }
    exit {
      0 => Unit
      nonzero => String "id -u failed"
    }
    mock_response {
      0 => { value: "1000", success: true } "hermetic os.Id.Uid"
    }
  }

  operation Gid {
    requires none
    input {}
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "-g"] }
    exit {
      0 => Unit
      nonzero => String "id -g failed"
    }
    mock_response {
      0 => { value: "1000", success: true } "hermetic os.Id.Gid"
    }
  }

  operation Lookup {
    requires none
    input { user: NonEmptyStr }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "{user}"] }
    exit {
      0 => Unit
      1 => Unit "no such user (id nonzero exit)"
      nonzero => String "id failed"
    }
    mock_response {
      0 => {
        stdout: "uid=1000(demo) gid=1000(demo) groups=1000(demo)",
        success: true,
      } "hermetic os.Id.Lookup"
    }
  }
}
