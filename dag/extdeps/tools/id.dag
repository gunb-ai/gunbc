module extdeps.tools.id

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { NonEmptyStr, List, Bool, Unit, Int, String }
import std.algebra { trim }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/id.1.html"
  }
}

// THE ABSOLUTE PATH IS LOAD-BEARING, NOT PEDANTRY. The argv rows above name `id` bare and resolve
// through PATH, which is right for a remote shell. A sudoers NOPASSWD rule matches on the command
// PATH, so a privileged invocation that names the binary bare is a different subject from the one
// the grant authorizes -- and gunbc.host.host_effect_realize needs both spellings for the same tool.
data id_binary_path: NonEmptyStr = "/usr/bin/id"

// THE PATH-RESOLVED SPELLING, DECLARED ONCE. The argv rows below and the command builder all name
// the same program, and spelling it three times would be three places one word could drift.
fn id_program() -> ProgramIdentity = uncataloged_program(invocation: "id")

fn id_uid_argv() -> List<String> {
  [id_program().invocation as String, "-u"]
}

// NO OPERAND, DELIBERATELY: id(1) with no operand answers from the CALLING PROCESS's own
// credentials, established at its exec and never changing afterwards. The reach probe asks "which
// account did the transport actually reach", and the only account that can say is the one the session
// IS — so the probe supplies no user and reads the login name the session itself carries. A user
// operand would ask the account database about a different account and answer the wrong question.
//
// -un, NOT -u: -n selects NAMES over numeric uids (the probe records the login name it was granted,
// not a per-host uid), and -u then prints that name alone rather than the full `id` record. One flag
// for the name, one for the field; the probe trims the newline the remote shell leaves on stdout.
fn id_user_name_argv() -> List<String> {
  [id_program().invocation as String, "-un"]
}

fn id_gid_argv() -> List<String> {
  [id_program().invocation as String, "-g"]
}

// -nG NAMES THE USER EXPLICITLY, AND THAT IS THE WHOLE REASON THIS BUILDER TAKES ONE. id(1) with an
// operand answers from the account database; id(1) with no operand answers from the CALLING
// PROCESS's own credentials, which were established at its exec and never change afterwards. A
// caller asking whether a supplementary group grant has landed must ask the database -- the running
// process cannot have picked the group up, so the no-operand form would answer the older question
// and read as a refusal of a grant that is in fact installed.
//
// -n asks for names rather than numeric gids, because the group a caller holds is named by the
// authority it came from (a udev rule naming "kvm"), not by a gid that varies per host.
fn id_group_names_command(user: NonEmptyStr) -> ArgvCommand {
  argv_command(program: id_program(), arguments: ["-nG", "--", user as String])
}

// -u WITH AN OPERAND: the named account's numeric uid, from the account database (as above).
fn id_uid_of_command(user: NonEmptyStr) -> ArgvCommand {
  argv_command(program: id_program(), arguments: ["-u", "--", user as String])
}

// id(1) WITH AN OPERAND prints `uid=1004(gunbc-worker) gid=1004(gunbc-worker) groups=1004(gunbc-worker),1003(gunbc-attempt)`
// (man7.org id.1): the numeric id leads each `N(name)` entry. THE GRAMMAR IS THE TOOL'S, so the parse
// lives here and a consumer reads the structured result. A line that does not carry a uid, a gid and
// a groups list, or carries a non-numeric id, is unobserved with its reason, never an empty group list.
type IdCredentials
  = IdCredentialsObserved { uid: Int, primary_gid: Int, supplementary_gids: List<Int> }
  | IdCredentialsUnobserved { reason: String }

fn id_numbered_entry(segment: String) -> Int? {
  match get(xs: split(s: segment, delimiter: "("), index: 0) {
    Absent => none
    Present { value: head } => parse_int(s: head)
  }
}

fn id_field_value(fields: List<String>, prefix: String) -> String? {
  match get(xs: filter(fields, f => starts_with(s: f, prefix: prefix)), index: 0) {
    Absent => none
    Present { value: f } => Present { value: substring(s: f, start: string_length(s: prefix), end: string_length(s: f)) }
  }
}

fn id_credentials_of_line(line: String) -> IdCredentials {
  let fields = split(s: trim(s: line), delimiter: " ")
  match id_field_value(fields: fields, prefix: "uid=") {
    Absent => IdCredentialsUnobserved { reason: "id printed no uid field" }
    Present { value: u } =>
      match id_field_value(fields: fields, prefix: "gid=") {
        Absent => IdCredentialsUnobserved { reason: "id printed no gid field" }
        Present { value: g } =>
          match id_field_value(fields: fields, prefix: "groups=") {
            Absent => IdCredentialsUnobserved { reason: "id printed no groups field" }
            Present { value: gs } => {
              let segments = split(s: gs, delimiter: ",")
              let gids = flat_map(segments, seg => match id_numbered_entry(segment: seg) { Present { value: n } => [n]  Absent => [] })
              match id_numbered_entry(segment: u) {
                Absent => IdCredentialsUnobserved { reason: "id printed a uid that is not a number" }
                Present { value: uid } =>
                  match id_numbered_entry(segment: g) {
                    Absent => IdCredentialsUnobserved { reason: "id printed a gid that is not a number" }
                    Present { value: pg } =>
                      if gids.count() != segments.count() {
                        IdCredentialsUnobserved { reason: "id printed a group that is not a number" }
                      } else {
                        IdCredentialsObserved { uid: uid, primary_gid: pg, supplementary_gids: gids }
                      }
                  }
              }
            }
          }
      }
  }
}

service os.Id {
  operation Uid {
    requires none
    input {}
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "-u"] }
    exit {
      0 => Unit
      nonzero => String "id -u failed"
    }
    mock_response {
      0 => { value: "1000", success: true } "hermetic os.Id.Uid"
    }
  }

  operation Gid {
    requires none
    input {}
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "-g"] }
    exit {
      0 => Unit
      nonzero => String "id -g failed"
    }
    mock_response {
      0 => { value: "1000", success: true } "hermetic os.Id.Gid"
    }
  }

  operation Lookup {
    requires none
    input { user: NonEmptyStr }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "{user}"] }
    exit {
      0 => Unit
      1 => Unit "no such user (id nonzero exit)"
      nonzero => String "id failed"
    }
    mock_response {
      0 => {
        stdout: "uid=1000(demo) gid=1000(demo) groups=1000(demo)",
        success: true,
      } "hermetic os.Id.Lookup"
    }
  }
}
