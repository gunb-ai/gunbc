module extdeps.tools.id


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/id.1.html"
  }
}

// THE ABSOLUTE PATH IS LOAD-BEARING, NOT PEDANTRY. The argv rows above name `id` bare and resolve
// through PATH, which is right for a remote shell. A sudoers NOPASSWD rule matches on the command
// PATH, so a privileged invocation that names the binary bare is a different subject from the one
// the grant authorizes -- and gunbc.host_effect_realize needs both spellings for the same tool.
data id_binary_path: NonEmptyStr = "/usr/bin/id"

fn id_uid_argv() -> List<String> {
  ["id", "-u"]
}

fn id_gid_argv() -> List<String> {
  ["id", "-g"]
}

fn id_lookup_argv(user: std.types.NonEmptyStr) -> List<String> {
  ["id", user as String]
}

service os.Id {
  operation Uid {
    input {}
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "-u"] }
    exit {
      0 => Unit
      nonzero => String "id -u failed"
    }
    mock_response {
      0 => { value: "1000", success: true } "hermetic os.Id.Uid"
    }
  }

  operation Gid {
    input {}
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "-g"] }
    exit {
      0 => Unit
      nonzero => String "id -g failed"
    }
    mock_response {
      0 => { value: "1000", success: true } "hermetic os.Id.Gid"
    }
  }

  operation Lookup {
    input { user: std.types.NonEmptyStr }
    output {
      stdout: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["id", "{user}"] }
    exit {
      0 => Unit
      1 => Unit "no such user (id nonzero exit)"
      nonzero => String "id failed"
    }
    mock_response {
      0 => {
        stdout: "uid=1000(demo) gid=1000(demo) groups=1000(demo)",
        success: true,
      } "hermetic os.Id.Lookup"
    }
  }
}
