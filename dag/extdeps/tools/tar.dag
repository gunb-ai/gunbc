module extdeps.tools.tar

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { String, NonEmptyStr, Int, List }
import std.optional { Optional, Present, Absent }
import std.algebra { skip }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/tar/manual/tar.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tools.tar",
      decl_name: "tar_program",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// GNU TAR, NOT POSIX pax-format tar, and the distinction decides whether this module is correct on a
// given host: --strip-components is a GNU extension that the POSIX utility does not specify. A host
// shipping bsdtar answers the same request with different spellings, and that would be its own
// authority rather than a widened flag list here.
// PATH-resolved program name, deliberately: this repository has made no filesystem observation of
// the host this command runs on, and an absolute path is a claim about one. The full reasoning, the
// criterion for climbing to an absolute row, and the counter-example that makes the distinction
// load-bearing are recorded once at extdeps.exec.command program_spelling_is_an_observation_claim.
fn tar_program() -> ProgramIdentity = uncataloged_program(invocation: "tar")

// EXTRACT NAMES ITS DESTINATION AND ITS STRIP DEPTH, both as parameters. `xf` is extract-from-file;
// -C changes directory BEFORE extracting, so the archive's paths are interpreted relative to the
// destination rather than to wherever the process happened to be standing; --strip-components drops
// the leading path components a release tarball wraps its tree in. The depth is an Int rather than a
// pre-spelled flag string because it is a number the caller knows, not a token it should remember.
//
// WHAT HAPPENS TO A DIRECTORY THAT ALREADY EXISTS is the caller's to state, because only the caller knows
// whether its destination carries a mode of its own. GNU tar restores an existing directory's metadata
// from the archive's entry for it by default (--overwrite-dir), and a release tarball's leading `./`
// entry names the -C directory itself: the actions/runner archives carry it at drwxr-xr-x, which turned a
// 0700 deploy tree into 0755 (gunbc.recurring_failure_mode
// an_archive_extract_reapplies_its_directory_mode_to_the_destination). --no-overwrite-dir is "Preserve
// metadata of existing directories" (GNU tar manual, Option Summary). The default emits no word, so its
// argv is the one GNU tar has always been given here.
type TarExistingDirectoryMetadata
  = TarOverwriteDir
  | TarNoOverwriteDir

fn tar_existing_directory_metadata_arguments(existing_directories: TarExistingDirectoryMetadata) -> List<String> {
  match existing_directories {
    TarOverwriteDir => []
    TarNoOverwriteDir => ["--no-overwrite-dir"]
  }
}

fn tar_extract_command(archive: String, into_directory: String, strip_components: Int, existing_directories: TarExistingDirectoryMetadata) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: concat(
      [
        "xf", archive,
        "-C", into_directory,
        concat("--strip-components=", to_string(strip_components)),
      ],
      tar_existing_directory_metadata_arguments(existing_directories: existing_directories),
    ),
  )
}

// A REPRODUCIBLE ARCHIVE OF ONE DIRECTORY: the same files produce the same bytes. GNU tar's
// --sort=name fixes member order, and --mtime/--owner/--group/--numeric-owner fix the metadata a
// second run would otherwise vary, so a content digest over the archive names its content.
fn tar_create_reproducible_command(archive: String, from_directory: String) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: ["-C", from_directory, "--sort=name", "--mtime=@0", "--owner=0", "--group=0", "--numeric-owner", "-cf", archive, "."],
  )
}

// CREATE FROM AN EXPLICIT MEMBER LIST, AND NOTHING ELSE. -T names a file of member paths (one per
// line, relative to -C's directory); --no-recursion stops a listed directory from pulling in members
// the list did not name, so the archive's membership IS the list -- a caller that filtered the list
// has filtered the archive. --verbatim-files-from reads each line as a path, never as an option.
fn tar_create_from_list_command(archive: String, from_directory: String, member_list: String) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: ["-C", from_directory, "-cf", archive, "--no-recursion", "--verbatim-files-from", "-T", member_list],
  )
}

// LIST AN ARCHIVE'S MEMBERS, one path per line on stdout: the readback of what an archive holds,
// independent of whatever list built it.
fn tar_list_command(archive: String) -> ArgvCommand {
  argv_command(program: tar_program(), arguments: ["-tf", archive])
}

// CREATE FROM TWO MEMBER LISTS, EACH READ RELATIVE TO ITS OWN DIRECTORY, INTO ONE ARCHIVE. GNU tar
// applies -C to every member named after it, including members read from a -T file ("Changing the
// Working Directory" in the GNU tar manual), so the second list's members are taken from the second
// directory under the SAME member names the list spells. That is how a staged tree stands in for
// paths of the first: a member staged at <second>/<path> is archived as <path>. The flags are
// tar_create_from_list_command's, with the same reason for each.
fn tar_create_from_two_lists_command(archive: String, first_directory: String, first_list: String, second_directory: String, second_list: String) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: ["-cf", archive, "--no-recursion", "--verbatim-files-from", "-C", first_directory, "-T", first_list, "-C", second_directory, "-T", second_list],
  )
}

// LIST AN ARCHIVE'S MEMBERS WITH THEIR SIZES: `--list --verbose --numeric-owner --full-time
// --quoting-style=literal`. Each line is the type-and-mode word, uid/gid, the size in bytes, the
// date, the time, then the member name unescaped (GNU tar manual, "The Verbose Listing" and
// "Quoting Member Names"); numeric ids and full time keep each of the five leading fields a single
// word, so the name is whatever follows the fifth.
fn tar_list_sizes_command(archive: String) -> ArgvCommand {
  argv_command(program: tar_program(), arguments: ["--list", "--verbose", "--numeric-owner", "--full-time", "--quoting-style=literal", "-f", archive])
}

// ONE LINE OF THAT LISTING, read into its fields: the entry-type letter and the nine permission characters of the
// first word, the `uid/gid` word as printed (numeric, by --numeric-owner), the member name, and for a symbolic link
// (type letter l) the stored target, which GNU tar prints after ` -> `. The size, date and time are words three to
// five and are not kept. A line with fewer than six words, or a first word that is not ten characters, is not a
// member line and refuses; a link line without ` -> ` refuses rather than reading the arrow into the name.
type TarVerboseMember {
  type_letter: String
  permissions: String
  owner_ids: String
  name: String
  link_target: Optional<String>
}

fn tar_verbose_member_of_line(line: String) -> Optional<TarVerboseMember> {
  let words = filter(split(s: line, delimiter: " "), w => w != "")
  if count(words) < 6 {
    Absent
  } else {
    match words[0] {
      Absent => Absent
      Present { value: mode_word } =>
        match words[1] {
          Absent => Absent
          Present { value: owner_ids } =>
            if string_length(s: mode_word) != 10 {
              Absent
            } else {
              let type_letter = substring(s: mode_word, start: 0, end: 1)
              let permissions = substring(s: mode_word, start: 1, end: 10)
              let rest = join(skip(words, 5), " ")
              if type_letter == "l" {
                match tar_link_name_and_target(text: rest) {
                  Absent => Absent
                  Present { value: pair } => Present { value: TarVerboseMember { type_letter: type_letter, permissions: permissions, owner_ids: owner_ids, name: pair.name, link_target: Present { value: pair.target } } }
                }
              } else {
                Present { value: TarVerboseMember { type_letter: type_letter, permissions: permissions, owner_ids: owner_ids, name: rest, link_target: Absent } }
              }
            }
        }
    }
  }
}

type TarLinkNameAndTarget {
  name: String
  target: String
}

fn tar_link_name_and_target(text: String) -> Optional<TarLinkNameAndTarget> {
  let parts = split(s: text, delimiter: " -> ")
  if count(parts) != 2 {
    Absent
  } else {
    match parts[0] {
      Absent => Absent
      Present { value: name } =>
        match parts[1] {
          Absent => Absent
          Present { value: target } => Present { value: TarLinkNameAndTarget { name: name, target: target } }
        }
    }
  }
}

// EXTRACT EXACTLY THE LISTED MEMBERS INTO A DIRECTORY: -C first, so every member lands beneath it
// under its archived name; -T names the members; --no-recursion and --verbatim-files-from as on
// create. A listed name the archive does not hold makes tar exit nonzero.
fn tar_extract_listed_command(archive: String, into_directory: String, member_list: String) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: ["-xf", archive, "-C", into_directory, "--no-recursion", "--verbatim-files-from", "-T", member_list],
  )
}
