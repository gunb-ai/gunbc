module extdeps.tools.tar

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { String, NonEmptyStr, Int }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/tar/manual/tar.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tools.tar",
      decl_name: "tar_program",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// GNU TAR, NOT POSIX pax-format tar, and the distinction decides whether this module is correct on a
// given host: --strip-components is a GNU extension that the POSIX utility does not specify. A host
// shipping bsdtar answers the same request with different spellings, and that would be its own
// authority rather than a widened flag list here.
// PATH-resolved program name, deliberately: this repository has made no filesystem observation of
// the host this command runs on, and an absolute path is a claim about one. The full reasoning, the
// criterion for climbing to an absolute row, and the counter-example that makes the distinction
// load-bearing are recorded once at extdeps.exec.command program_spelling_is_an_observation_claim.
fn tar_program() -> ProgramIdentity = uncataloged_program(invocation: "tar")

// EXTRACT NAMES ITS DESTINATION AND ITS STRIP DEPTH, both as parameters. `xf` is extract-from-file;
// -C changes directory BEFORE extracting, so the archive's paths are interpreted relative to the
// destination rather than to wherever the process happened to be standing; --strip-components drops
// the leading path components a release tarball wraps its tree in. The depth is an Int rather than a
// pre-spelled flag string because it is a number the caller knows, not a token it should remember.
fn tar_extract_command(archive: String, into_directory: String, strip_components: Int) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: [
      "xf", archive,
      "-C", into_directory,
      concat("--strip-components=", to_string(strip_components)),
    ],
  )
}

// CREATE FROM AN EXPLICIT MEMBER LIST, AND NOTHING ELSE. -T names a file of member paths (one per
// line, relative to -C's directory); --no-recursion stops a listed directory from pulling in members
// the list did not name, so the archive's membership IS the list -- a caller that filtered the list
// has filtered the archive. --verbatim-files-from reads each line as a path, never as an option.
fn tar_create_from_list_command(archive: String, from_directory: String, member_list: String) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: ["-C", from_directory, "-cf", archive, "--no-recursion", "--verbatim-files-from", "-T", member_list],
  )
}

// LIST AN ARCHIVE'S MEMBERS, one path per line on stdout: the readback of what an archive holds,
// independent of whatever list built it.
fn tar_list_command(archive: String) -> ArgvCommand {
  argv_command(program: tar_program(), arguments: ["-tf", archive])
}

// CREATE FROM TWO MEMBER LISTS, EACH READ RELATIVE TO ITS OWN DIRECTORY, INTO ONE ARCHIVE. GNU tar
// applies -C to every member named after it, including members read from a -T file ("Changing the
// Working Directory" in the GNU tar manual), so the second list's members are taken from the second
// directory under the SAME member names the list spells. That is how a staged tree stands in for
// paths of the first: a member staged at <second>/<path> is archived as <path>. The flags are
// tar_create_from_list_command's, with the same reason for each.
fn tar_create_from_two_lists_command(archive: String, first_directory: String, first_list: String, second_directory: String, second_list: String) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: ["-cf", archive, "--no-recursion", "--verbatim-files-from", "-C", first_directory, "-T", first_list, "-C", second_directory, "-T", second_list],
  )
}

// LIST AN ARCHIVE'S MEMBERS WITH THEIR SIZES: `--list --verbose --numeric-owner --full-time
// --quoting-style=literal`. Each line is the type-and-mode word, uid/gid, the size in bytes, the
// date, the time, then the member name unescaped (GNU tar manual, "The Verbose Listing" and
// "Quoting Member Names"); numeric ids and full time keep each of the five leading fields a single
// word, so the name is whatever follows the fifth.
fn tar_list_sizes_command(archive: String) -> ArgvCommand {
  argv_command(program: tar_program(), arguments: ["--list", "--verbose", "--numeric-owner", "--full-time", "--quoting-style=literal", "-f", archive])
}

// EXTRACT EXACTLY THE LISTED MEMBERS INTO A DIRECTORY: -C first, so every member lands beneath it
// under its archived name; -T names the members; --no-recursion and --verbatim-files-from as on
// create. A listed name the archive does not hold makes tar exit nonzero.
fn tar_extract_listed_command(archive: String, into_directory: String, member_list: String) -> ArgvCommand {
  argv_command(
    program: tar_program(),
    arguments: ["-xf", archive, "-C", into_directory, "--no-recursion", "--verbatim-files-from", "-T", member_list],
  )
}
