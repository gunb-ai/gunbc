module extdeps.tools.ls

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.algebra { trim }
import extdeps.access.posix { FileMode, FileOwnership, PermissionBits }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

// ls(1) AS POSIX SPECIFIES IT (The Open Group Base Specifications Issue 8, ls, STDOUT): with -l each
// entry is printed as "%s %u %s %s %u %s %s\n", <file mode>, <number of links>, <owner name>,
// <group name>, <size>, <date and time>, <pathname>; -n is -l with the owner and group printed as
// their numeric user and group IDs; -d lists a directory operand itself rather than its contents.
// <file mode> is the entry type character followed by the three owner, group and other triples,
// each `r`/`-`, `w`/`-`, and an execute position that also carries the set-user-ID, set-group-ID and
// sticky bits (`s`/`S`, `t`/`T`), optionally followed by an implementation's alternate-access
// character.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9799919799/utilities/ls.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tools.ls",
      decl_name: "ls_program",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

fn ls_program() -> ProgramIdentity = uncataloged_program(invocation: "ls")

// ONE ENTRY'S METADATA WITH NO FORMAT WORD. stat -c needs a `%` conversion the fleet SSH edge refuses
// (gunbc.fleet.fleet_known_hosts_anchor portable_remote_word_char_allowed); the long listing carries
// the type, the mode and the numeric owner and group in a layout the standard fixes.
fn ls_long_numeric_entries_command(paths: List<String>) -> ArgvCommand {
  argv_command(program: ls_program(), arguments: concat(["-l", "-n", "-d", "--"], paths))
}

// A DIRECTORY'S ENTRIES, every one: -a includes the names beginning with a period, which is where the
// listener keeps its registration. A name absent from a listing that succeeded is absent from the
// directory; the listing's first line is its block total, which carries no mode and is not an entry.
fn ls_long_numeric_listing_command(directory: String) -> ArgvCommand {
  argv_command(program: ls_program(), arguments: ["-l", "-n", "-a", "--", directory])
}

// What one long-format entry says about a path's access. An alternate access method (an ACL on
// Linux, printed as `+` after the mode) can grant what the mode bits do not show, so an entry
// carrying one is not a reading of the path's access and refuses rather than reading as its bits.
type LsLongEntry
  = LsLongEntryRead { name: String, directory: Bool, ownership: FileOwnership, mode: FileMode }
  | LsLongEntryRefused { name: String, reason: String }

fn ls_execute_position(c: String) -> Bool? {
  if c == "x" || c == "s" || c == "t" { Present { value: true } }
  else if c == "-" || c == "S" || c == "T" { Present { value: false } }
  else { none }
}

fn ls_permission_triple(text: String, start: Int) -> PermissionBits? {
  let r = substring(s: text, start: start, end: start + 1)
  let w = substring(s: text, start: start + 1, end: start + 2)
  if (r != "r" && r != "-") || (w != "w" && w != "-") {
    none
  } else {
    match ls_execute_position(c: substring(s: text, start: start + 2, end: start + 3)) {
      Absent => none
      Present { value: x } => Present { value: PermissionBits { read: r == "r", write: w == "w", execute: x } }
    }
  }
}

fn ls_special_bit(text: String, at: Int, set: String, unset_executable: String) -> Bool {
  let c = substring(s: text, start: at, end: at + 1)
  c == set || c == unset_executable
}

fn ls_file_mode_of(mode_text: String) -> FileMode? {
  match ls_permission_triple(text: mode_text, start: 1) {
    Absent => none
    Present { value: owner } =>
      match ls_permission_triple(text: mode_text, start: 4) {
        Absent => none
        Present { value: group } =>
          match ls_permission_triple(text: mode_text, start: 7) {
            Absent => none
            Present { value: other } =>
              Present { value: FileMode {
                owner: owner,
                group: group,
                other: other,
                setuid: ls_special_bit(text: mode_text, at: 3, set: "s", unset_executable: "S"),
                setgid: ls_special_bit(text: mode_text, at: 6, set: "s", unset_executable: "S"),
                sticky: ls_special_bit(text: mode_text, at: 9, set: "t", unset_executable: "T"),
              } }
          }
      }
  }
}

fn ls_long_entry_field(fields: List<String>, index: Int) -> String {
  match get(xs: fields, index: index) {
    Absent => ""
    Present { value: f } => f
  }
}

// One line of a long listing. The mode is the first field, the owner and group ids the third and
// fourth, the pathname the last; fields are separated by one or more blanks, so a pathname carrying a
// blank is not read by this parser and the consumer's paths carry none.
fn ls_long_entry_of_line(line: String) -> LsLongEntry {
  let fields = filter(split(s: trim(s: line), delimiter: " "), f => f != "")
  let name = ls_long_entry_field(fields: fields, index: count(fields) - 1)
  let mode_text = ls_long_entry_field(fields: fields, index: 0)
  let kind = substring(s: mode_text, start: 0, end: 1)
  let alternate = substring(s: mode_text, start: 10, end: string_length(s: mode_text))
  if string_length(s: mode_text) < 10 {
    LsLongEntryRefused { name: name, reason: join(["ls printed no file mode: '", trim(s: line), "'"], "") }
  } else if alternate == "+" {
    LsLongEntryRefused { name: name, reason: "the entry carries an alternate access method (+), which can grant access its mode bits do not show" }
  } else if alternate != "" && alternate != "." {
    LsLongEntryRefused { name: name, reason: join(["unrecognized alternate-access character '", alternate, "'"], "") }
  } else {
    match ls_file_mode_of(mode_text: mode_text) {
      Absent => LsLongEntryRefused { name: name, reason: join(["unparseable file mode '", mode_text, "'"], "") }
      Present { value: mode } =>
        match parse_int(s: ls_long_entry_field(fields: fields, index: 2)) {
          Absent => LsLongEntryRefused { name: name, reason: "ls printed no numeric owner id" }
          Present { value: uid } =>
            match parse_int(s: ls_long_entry_field(fields: fields, index: 3)) {
              Absent => LsLongEntryRefused { name: name, reason: "ls printed no numeric group id" }
              Present { value: gid } =>
                LsLongEntryRead {
                  name: name,
                  directory: kind == "d",
                  ownership: FileOwnership { uid: uid, gid: gid },
                  mode: mode,
                }
            }
        }
    }
  }
}

// THE READING OF ONE ENTRY QUERY: `ls -l -n -d -- <path>`, which describes the ENTRY rather than its
// target -- so only the parent's SEARCH permission is needed, and a directory published drwx--x--- still
// answers "is this name in there" while refusing "what is in there". This is THIS module's command
// (ls_long_numeric_entries_command), so its words and its output belong here together: the presence fold
// in extdeps.filesystem.filesystem_io says what each reading licenses and never decodes these bytes
// itself. There was a fork here once, in the other direction -- a consumer of this command split its own
// stdout on single spaces and matched the name as a field, where this module's parser trims and drops
// empty fields and refuses an unparseable mode; gunbc.design_argument::single_authority calls a second
// place that decides one tool's output a fork, and the two already disagreed.
//
// FOUR OUTCOMES, and the last two are different facts for the consumer: MISSING is the host TESTIFYING
// the name is not there, REFUSED is the host saying it will not or cannot answer and carrying its reason
// (EACCES from an ACL, an LSM or a parent that will not search; EIO; ESTALE), and UNREADABLE is the
// observation not being an answer at all -- nothing printed, more than one line, a line this parser will
// not accept, a status outside the one that testifies.
type LsEntryQueryReading
  = LsEntryQueryPresent { path: String, entry: LsLongEntry }
  | LsEntryQueryMissing { path: String, diagnostic: String }
  | LsEntryQueryRefused { path: String, diagnostic: String }
  | LsEntryQueryUnreadable { path: String, cause: String }

// THE ONLY DIAGNOSTICS THAT TESTIFY A NAME IS NOT THERE: the WHOLE line, compared exactly, for the path
// that was asked about. Two shapes, both emitted on exit 2 -- ENOENT under a searchable parent, and
// ENOTDIR from a component above it. Nothing here is "contains" and nothing is "ends with": a second
// diagnostic line, or a message about some other path, is not this host's testimony about this name. An
// earlier cut of this reader asked for a substring PLUS a suffix, which let a two-line stderr --
// "ls: cannot access '/srv/instance': Permission denied" then "ls: cannot access '/tmp/other': No such
// file or directory" -- certify /srv/instance as absent while the host was refusing to answer for it.
// A path whose name contains an apostrophe is double-quoted by ls and so lands unreadable, which is the
// safe side of this law: unreadable stops a deployment, absence releases a cell.
fn ls_entry_missing_diagnostic(line: String, path: String) -> Bool {
  line == join(["ls: cannot access '", path, "': No such file or directory"], "")
    || line == join(["ls: cannot access '", path, "': Not a directory"], "")
}

// A long listing of a symbolic link prints `name -> target` after the fields, so the line DESCRIBES the
// field before the arrow; every other line describes its last field. That is ls's own format, so it is
// read here rather than by whichever consumer noticed the arrow.
fn ls_entry_query_entry_of_line(line: String) -> LsLongEntry {
  let trimmed = trim(s: line)
  match get(xs: split(s: trimmed, delimiter: " -> "), index: 0) {
    Absent => ls_long_entry_of_line(line: trimmed)
    Present { value: head } => ls_long_entry_of_line(line: head)
  }
}

// ONE CALL, ALL THREE INPUTS: the status and both streams decide the reading, because the answer depends
// on all three, and a reader that drops the words is where an invented absence would come from.
fn ls_entry_query_reading_of_output(path: String, exit_code: Int, stdout: String, stderr: String) -> LsEntryQueryReading {
  let out_lines = filter(split(s: stdout, delimiter: "\n"), line => trim(s: line) != "")
  let err_lines = filter(split(s: stderr, delimiter: "\n"), line => trim(s: line) != "")
  if exit_code == 0 {
    if count(out_lines) != 1 {
      LsEntryQueryUnreadable { path: path, cause: join(["ls exited 0 for ", path, " without printing exactly one entry line; a successful observation of something else is not an answer about this name"], "") }
    } else {
      match get(xs: out_lines, index: 0) {
        Absent => LsEntryQueryUnreadable { path: path, cause: join(["ls exited 0 but printed nothing for ", path], "") }
        Present { value: line } =>
          match ls_entry_query_entry_of_line(line: line) {
            LsLongEntryRead { name: name, directory: directory, ownership: ownership, mode: mode } =>
              if name == path {
                LsEntryQueryPresent { path: path, entry: LsLongEntryRead { name: name, directory: directory, ownership: ownership, mode: mode } }
              } else {
                LsEntryQueryUnreadable { path: path, cause: join(["ls printed an entry named ", name, " rather than ", path, "; an answer about another name is not an answer about this one"], "") }
              }
            LsLongEntryRefused { name: name, reason: reason } =>
              LsEntryQueryUnreadable { path: path, cause: join(["ls printed a line about ", name, " that this module's parser will not accept: ", reason], "") }
          }
      }
    }
  } else if exit_code == 2 {
    if count(err_lines) != 1 {
      LsEntryQueryUnreadable { path: path, cause: join(["ls exited 2 for ", path, " with ", to_string(value: count(err_lines)), " diagnostic line(s); more than one message is not this host's testimony about this name"], "") }
    } else {
      match get(xs: err_lines, index: 0) {
        Absent => LsEntryQueryUnreadable { path: path, cause: join(["ls exited 2 for ", path, " and said nothing"], "") }
        Present { value: line } =>
          if ls_entry_missing_diagnostic(line: line, path: path) {
            LsEntryQueryMissing { path: path, diagnostic: line }
          } else {
            LsEntryQueryRefused { path: path, diagnostic: line }
          }
      }
    }
  } else {
    match get(xs: err_lines, index: 0) {
      Absent => LsEntryQueryUnreadable { path: path, cause: join(["ls failed for ", path, " with exit ", to_string(value: exit_code), " and said nothing"], "") }
      Present { value: line } =>
        LsEntryQueryUnreadable { path: path, cause: join(["ls failed for ", path, " with exit ", to_string(value: exit_code), ": ", line], "") }
    }
  }
}
