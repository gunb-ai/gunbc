module extdeps.tools.ls

import std.types { String, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https locator: "www.gnu.org/software/coreutils/manual/html_node/ls-invocation.html" }
}

// One name per line, including hidden entries except dot and dot-dot. PATH resolution preserves
// the existing fleet observer's invocation; no new absolute executable location is asserted.
fn directory_listing_argv(parent: String) -> List<String> {
  ["ls", "-1", "-A", "--", parent]
}
