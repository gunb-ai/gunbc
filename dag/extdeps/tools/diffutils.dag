module extdeps.tools.diffutils


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.gnu.org/software/diffutils/manual/diffutils.html"
  }
}

data diffutils_module_scope_doc: String = "GNU diffutils interface shapes, one file per upstream (DESIGN 3: cite the real upstream - diff is diffutils, not coreutils or the shell). Homed in its own module rather than extdeps.shell so that consumers of the diff operation do not couple to the whole shell-utilities surface, and a change here does not put every extdeps.shell importer in the affected set."

service shell.Diff {
  operation Recursive {
    input { left: std.types.FilePath, right: std.types.FilePath }
    output { identical: Bool from "exit_success", exit_code: Int from "exit_code" }
    readonly
    transport shell { argv: ["diff", "-r", "{left}", "{right}"] }
    exit {
      0 => Unit "Trees are identical"
      1 => Unit "Trees differ"
      nonzero => String "diff -r failed to compare the trees"
    }
  }
}
