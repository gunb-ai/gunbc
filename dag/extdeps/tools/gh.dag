module extdeps.tools.gh

import std.types { String, List }
import extdeps.exec.program { ProgramIdentity, cataloged_program }
import extdeps.exec.command { ArgvCommand, argv_command }

import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.tools { CliTool, SourceApt }
import extdeps.package_managers.apt { apt_bin_dir, package_gh }

// THE TOOL ROW FOR THE GITHUB CLI, so that the binary every `transport shell` operation in
// extdeps.github spawns (argv word "gh") is a declared executor prerequisite that
// gunbc.host.host_cli_dependency can PROBE for before a read, rather than an exec error discovered
// mid-read. The argv templates in extdeps.github carry the literal program word because a
// service transport template cannot reference a data row; this row names that same word.
//
// min_version is none: no operation in this corpus depends on a version-gated gh feature.
// installable_via names the apt package the distribution ships; this row is a hint carried by
// the refusal, never an instruction any read-only route acts on.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cli.github.com/manual/"
  }
}

fn gh_program() -> ProgramIdentity = cataloged_program(invocation: "gh")

// `gh run download <run> --repo <owner/name> --name <artifact> --dir <dir>` (cli.github.com/manual/gh_run_download):
// the one spelling of the words, as argv (program word first) and as the sealed command built from them.
// The argv is homed here, beside the program, so a consumer that names the read -- the converge receipt's read
// spec in gunbc.runner.runner_user_session_receipt -- projects these words rather than re-spelling them.
fn gh_run_download_argv(run_id: String, repo: String, artifact: String, dir: String) -> List<String> {
  [gh_program().invocation as String, "run", "download", run_id, "--repo", repo, "--name", artifact, "--dir", dir]
}

fn gh_run_download_command(run_id: String, repo: String, artifact: String, dir: String) -> ArgvCommand {
  argv_command(program: gh_program(), arguments: gh_run_download_argv(run_id: run_id, repo: repo, artifact: artifact, dir: dir).skip(n: 1))
}

data gh_cli_tool: CliTool = CliTool {
  program: gh_program(),
  min_version: none,
  installable_via: [SourceApt { package: package_gh, bin_dir: apt_bin_dir }],
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tools.gh",
      decl_name: "gh_cli_tool",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.tools.gh.extdeps_external_authority_anchor,
  further_citations: []
}
