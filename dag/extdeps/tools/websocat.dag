module extdeps.tools.websocat

import std.types { NonEmptyStr, Int, String }
import extdeps.version { VersionConstraint }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.tools { CliTool, SourceGitHubRelease }
import std.dissolution { DissolutionCondition, unbound_dissolution }
import extdeps.exec.program { ProgramIdentity, cataloged_program }
import extdeps.exec.command { ArgvCommand, argv_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/vi/websocat/releases/tag/v1.14.0"
  }
}

data websocat_pinned_version: VersionConstraint = ">= 1.12"

data websocat_github_repo: NonEmptyStr = "vi/websocat"

data websocat_github_tag: NonEmptyStr = "v1.14.0"

data websocat_asset_aarch64: NonEmptyStr = "websocat_max.aarch64-unknown-linux-musl"

data websocat_asset_x86_64: NonEmptyStr = "websocat_max.x86_64-unknown-linux-musl"

data websocat_install_path: NonEmptyStr = "/var/lib/gunbc/bin/websocat"

fn websocat_program() -> ProgramIdentity = cataloged_program(invocation: "websocat")

data websocat_cli_tool: CliTool = CliTool {
  program: websocat_program(),
  min_version: Present { value: websocat_pinned_version },
  installable_via: [
    SourceGitHubRelease {
      repo: websocat_github_repo,
      tag: websocat_github_tag,
      asset_aarch64: websocat_asset_aarch64,
      asset_x86_64: websocat_asset_x86_64,
      install_path: websocat_install_path,
    },
  ],
}

fn websocat_github_release_download_url(tag: NonEmptyStr, asset: NonEmptyStr) -> String {
  concat(
    concat("https://github.com/", websocat_github_repo as String),
    concat("/releases/download/", concat(tag as String, concat("/", asset as String))),
  )
}

// THE BMCWEB NBD-PROXY BRIDGE the srv3 nbd-proxy serve path runs as a systemd transient unit
// (gunbc.host_effect_nbd_proxy_serve): websocat bridges the BMC's wss nbd-proxy websocket to a
// local TCP port, text mode, TLS verification refused (--insecure) because the BMC presents a
// device certificate this repository has made no observation of. The flags are this operation's
// own, minted here beside the cited upstream authority above and nowhere else -- a builder outside
// this module would re-home "which flags does websocat take" (extdeps.exec.command argv_command
// wall).
//
// THE PLACED INVOCATION, MINTED BY THE BUILDER (the busybox_httpd_command pattern: a builder of a
// cataloged tool whose placement is still spelled at the build site is an admitted caller of
// cataloged_program). The CliTool row's identity -- websocat_program() above, the bare catalog
// name -- is what tool probes and censuses cite; the word handed to execve here is the
// SourceGitHubRelease install_path above, because the systemd transient unit that runs this
// command resolves no PATH, so the bare name would not resolve on the actuator host. Catalog
// identity and placed invocation are two facts today; a uniform placement is the host-program
// lifecycle's business (extdeps.exec.program), and when it lands this mint collapses into the row.
//
// THE HEADER WORD CARRIES A QUOTING CONVENTION INSIDE ARGV, AND THAT IS A RECORDED OBLIGATION,
// NOT A CHOICE MADE HERE: the `--header=` element embeds literal double quotes and a space, which
// is byte-identical to the raw word list this builder replaces (gunbc.host_effect_nbd_proxy_serve
// realized the same words before this carrier existed) and load-bearing only for a downstream
// parser this carrier cannot name -- over an SSH transport the portable-word wall
// (gunbc.typed_argv_exec) refuses the word outright, and the production realization is the
// actuator host's own session (NbdProxySessionOnHost). See the dissolve-on below.
fn websocat_nbd_proxy_bridge_command(
  bmc_host: NonEmptyStr,
  ws_path: NonEmptyStr,
  session_token: NonEmptyStr,
  local_nbd_port: Int,
) -> ArgvCommand {
  let port = to_string(local_nbd_port)
  let wss_url = concat("wss://", concat(bmc_host, ws_path))
  let auth_header = concat("Authorization: Token ", session_token)
  let socat_bridge = concat("tcp:127.0.0.1:", port)
  argv_command(
    program: cataloged_program(invocation: websocat_install_path),
    arguments: [
      "--insecure",
      "--text",
      concat("--header=\"", concat(auth_header, "\"")),
      wss_url,
      socat_bridge,
    ],
  )
}

// THE OBLIGATION, TYPED SO A MECHANISM CAN SEE IT (the entropy.dag pattern: an unbound
// dissolution beside the declaration that owes it).
data websocat_header_argv_word_dissolution_trigger: DissolutionCondition = unbound_dissolution(
  description: "🟡 dissolve-on: the --header= argv word of websocat_nbd_proxy_bridge_command stops carrying the BMCWEB session token inside argv at all (gunbc.credential_argv_exposure instance 3: the token reaches the websocat cmdline for the served ISO's lifetime, systemd-run's own argv, and the recorded ExecStart/journal; measured latent, unexercised on all four fleet hosts 2026-08-25; repair is a systemd EnvironmentFile at 0600 or the operator-ruled alternative, with the two token-in-argv witnesses inverted deliberately), or the consuming carrier states WHICH parser re-splits these words so the embedded double quotes are a named fact instead of an accident of spelling. Until one lands, the word is the pinned obligation: refused over SSH by gunbc.typed_argv_exec, load-bearing only on the actuator host's own session, and asserted word-for-word by test.claim.srv3_os_install_actuate nbd_proxy_serve_session_token_is_literal_in_websocat_argv.",
)
