module extdeps.tools.free


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "man7.org/linux/man-pages/man1/free.1.html"
  }
}

type MemoryStats {
  total: std.measure.ByteSize
  used: std.measure.ByteSize
  free: std.measure.ByteSize
  shared: std.measure.ByteSize
  buff_cache: std.measure.ByteSize
  available: std.measure.ByteSize
}

type SwapStats {
  total: std.measure.ByteSize
  used: std.measure.ByteSize
  free: std.measure.ByteSize
}

type FreeOutput {
  memory: MemoryStats
  swap: SwapStats
}
