module extdeps.tools.findutils

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { String, NonEmptyStr, Int, List, Bool }
import std.nat { Nat }
// THE GRANTS ARE THE OTHER TOOLS' WORDS, NOT FIND'S. find owns the WALK -- the target, the bound, the
// prune group, the no-symlink predicate, and the -exec plumbing that batches an action over what it
// found. It does not own what `chmod g+w` means or what guard `chgrp` needs, and spelling those words
// here put another tool's grammar in this module: an edit to extdeps.tools.chmod's mode rows would
// change the standalone assert and leave the migration granting something else, and the two would
// disagree silently because both look correct in isolation (a readback that re-spells its key is the bug this closes). The words come from
// the modules that own the programs; find composes them into actions.
import extdeps.tools.chmod { chmod_mode_words, chmod_group_writable_mode, chmod_directory_setgid_mode, chmod_directory_sticky_mode }
import extdeps.tools.chown { chgrp_words }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.crypto.hash { sha256sum_program }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/findutils/manual/html_mono/find.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tools.findutils",
      decl_name: "find_program",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// PATH-resolved program name, deliberately: this repository has made no filesystem observation of
// the host this command runs on, and an absolute path is a claim about one. The full reasoning, the
// criterion for climbing to an absolute row, and the counter-example that makes the distinction
// load-bearing are recorded once at extdeps.exec.command program_spelling_is_an_observation_claim.
fn find_program() -> ProgramIdentity = uncataloged_program(invocation: "find")

// xargs SHIPS WITH findutils, not coreutils, which is why it is homed here beside find rather than
// in extdeps.tools.gnu_coreutils. The pairing is the usual one: find -print0 emits NUL-separated
// names so that a name containing a newline or a space cannot be split, and xargs -0 is the only
// reader that consumes that encoding. Same PATH-resolved spelling reasoning as find_program above.
data xargs_program: NonEmptyStr = "xargs"

// -lname IS A GNU EXTENSION and it matches the TARGET of a symbolic link, not the link's own name --
// which is the whole reason this operation exists rather than a plain -name walk. Its pattern is a
// GLOB, so a bracketed literal such as socket:[12345] is read as a character class and matches
// NOTHING: gunbc.build_cache.build_cache_endpoint_observe records the measurement where exactly that produced a
// zero that was then read as "the walk cannot be done". A caller passing a target pattern must
// escape or wildcard its brackets, and this note is here so the next author meets that fact before
// the empty result rather than after.
//
// THE DEPTH BOUND IS A PARAMETER AND HAS NO DEFAULT. An unbounded /proc walk is a different
// operation with a different cost, and a caller that has not thought about the depth has not thought
// about the walk.
fn find_symlink_target_glob_command(
  search_root: String,
  max_depth: Int,
  path_glob: String,
  link_target_glob: String,
) -> ArgvCommand {
  argv_command(
    program: find_program(),
    arguments: [
      search_root,
      "-maxdepth", to_string(max_depth),
      "-path", path_glob,
      "-lname", link_target_glob,
    ],
  )
}

// RUN ONE COMMAND OVER THE REGULAR FILES DIRECTLY IN A DIRECTORY THAT ONE USER OWNS. -maxdepth 1
// keeps it to that directory, -type f excludes symlinks (find does not follow them by default), and
// -user narrows it to entries the invoking principal can act on, so an entry another principal owns
// is never handed to a command that would refuse it. `-exec ... {} +` batches the paths into as few
// invocations as ARG_MAX admits; find exits nonzero when any invocation does.
fn find_owned_regular_files_exec_argv(dir: String, owner: String, command: List<String>) -> List<String> {
  concat(concat([find_program().invocation as String, dir, "-maxdepth", "1", "-type", "f", "-user", owner, "-exec"], command), ["{}", "+"])
}

fn find_owned_regular_files_exec_command(dir: String, owner: String, command: List<String>) -> ArgvCommand {
  argv_command(
    program: find_program(),
    arguments: concat(concat([dir, "-maxdepth", "1", "-type", "f", "-user", owner, "-exec"], command), ["{}", "+"]),
  )
}

// THE REGULAR FILES UNDER A ROOT, ONE `<size> <relative path>` LINE EACH (find(1) -printf: %s is the
// size in bytes, %P the path with the starting point removed). A plain argv: no shell, and find's own
// status is the one the caller reads.
fn find_regular_file_sizes_argv(root: String) -> List<String> {
  [find_program().invocation as String, root, "-type", "f", "-printf", "%s %P\n"]
}


// THREE READS OF ONE TREE THAT TOGETHER DESCRIBE ITS CONTENT: every regular file's sha256 (batched
// through sha256sum by `-exec ... {} +`, printed as `<hex>  <absolute path>`), every regular file
// with its owner-execute bit set (`x <relative path>`), and every symbolic link with its target
// (`l <relative path> -> <target>`). %P is the path with the starting point removed; the printf
// escape \n is find's own, so the argv word carries a backslash and an n, not a newline.
fn find_regular_files_sha256_command(root: String) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [root, "-type", "f", "-exec", sha256sum_program().invocation as String, "{}", "+"])
}

// A TREE'S ENTRY METADATA, ONE `<relative path>|<type>|<mode>|<owner>|<group>|<size>` LINE EACH,
// confined to the starting point's filesystem by -xdev (find(1) EXPRESSIONS, Global options), with
// the escapes find's own as above. Beside find_tree_regular_files_sha256_command it describes a tree
// closely enough that a canonical store left unchanged reads equal and any entry, mode, owner or
// byte moved reads different.
fn find_tree_metadata_command(root: String) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [root, "-xdev", "-printf", "%P|%y|%m|%u|%g|%s\\n"])
}

// Every regular file's sha256 on the starting point's filesystem only (-xdev), batched through
// sha256sum, printed `<hex>  <path>`. find_regular_files_sha256_command is the same read without the
// filesystem confinement.
fn find_tree_regular_files_sha256_command(root: String) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [root, "-xdev", "-type", "f", "-exec", sha256sum_program().invocation as String, "{}", "+"])
}

// THE DIRECT CHILDREN OF A DIRECTORY WHOSE NAME MATCHES A GLOB, one bare name per line (-maxdepth 1,
// %f is the entry's final component). The matching entry's own subtree is never walked.
fn find_children_named_command(root: String, name_glob: String) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [root, "-maxdepth", "1", "-name", name_glob, "-printf", "%f\\n"])
}

// THE ENTRY AT ONE EXACT PATH, FOUND BELOW A ROOT THAT EXISTS, printed when present and nothing when absent
// (-path is a whole-path match; -maxdepth bounds the walk). A missing ENTRY exits 0 with empty stdout; only a
// walk that could not complete (unreadable directory, bad root) exits nonzero. That split is the point: it
// lets a caller tell "not there" from "could not look" by exit status, without reading any tool's stderr.
fn find_entry_at_path_command(root: String, path: String, max_depth: Int) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [root, "-maxdepth", to_string(max_depth), "-path", path, "-print"])
}

// ENTRIES UNDER ROOTS THAT ARE NOT TRUSTED AS A ROOT-OWNED LOCUS: not owned by `owner`, writable by
// group or other (-perm /022: any of the two bits), or a symbolic link (find(1) TESTS; -P, the default,
// does not follow a starting point, so a symlinked root is seen as a link). `top_only` adds
// -maxdepth 0 to test the roots themselves rather than their contents. Every path printed is a
// violation; the caller reads empty stdout as "none", and a nonzero exit as an observation failure.
fn find_untrusted_entries_command(roots: List<String>, top_only: Bool, owner: String) -> ArgvCommand {
  argv_command(
    program: find_program(),
    arguments: concat(
      roots,
      concat(
        if top_only { ["-maxdepth", "0"] } else { [] },
        ["(", "!", "-user", owner, "-o", "-perm", "/022", "-o", "-type", "l", ")", "-print"],
      ),
    ),
  )
}

// RUN ONE COMMAND OVER EVERY DIRECT CHILD OF ROOT EXCEPT THE ONE NAMED keep_name (find(1) -mindepth 1
// -maxdepth 1 ! -name ... -exec ... {} +). The sweep is confined to one directory and keeps exactly one
// entry by exact name, so it is a retirement of siblings and cannot reach the kept one or above root.
fn find_other_children_exec_command(root: String, keep_name: String, exec_argv: List<String>) -> ArgvCommand {
  argv_command(
    program: find_program(),
    arguments: concat(
      [root, "-mindepth", "1", "-maxdepth", "1", "!", "-name", keep_name, "-exec"],
      concat(exec_argv, ["{}", "+"]),
    ),
  )
}

fn find_owner_executable_files_command(root: String) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [root, "-type", "f", "-perm", "-u+x", "-printf", "x %P\\n"])
}

// IS THIS EXACT PATH A SOCKET, IN WORDS THAT CROSS THE FLEET SSH EDGE. `-maxdepth 0` tests the named
// operand itself; `-type s` (find(1) TESTS) matches a socket; `-print` prints the operand only when it
// matched. So: the path printed is a socket; exit 0 with nothing printed is an object that is not a
// socket; a nonzero exit names a failure on stderr (find(1) EXIT STATUS). Unlike `stat -c %F`, no
// word here carries a `%`, which the fleet edge refuses.
fn find_path_is_socket_command(path: String) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [path, "-maxdepth", "0", "-type", "s", "-print"])
}

fn find_symlink_targets_command(root: String) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [root, "-type", "l", "-printf", "l %P -> %l\\n"])
}

// THE REGULAR FILES UNDER A ROOT WITH THEIR SIZE AND MODIFICATION TIME, ONE
// `<size>\t<mtime>\t<relative path>` LINE EACH, AND NOTHING READ BUT METADATA. Every -printf
// directive here is answered from the inode find already holds from its own stat(2) of the entry
// (find manual, "Format Directives"): %s is st_size in bytes, %T@ is st_mtime as seconds since the
// epoch with a fractional part, %P is the path with the starting point removed. No directive opens
// the file, and the expression carries no action that runs another program, so the command reads
// no file content -- find_command_runs_another_program below is how a consumer checks the second
// half on the value rather than on this note. The path is LAST so a name holding a tab survives as
// the rest of the line; the escapes are find's own, so the argv word carries a backslash and a
// letter, never a control character.
fn find_regular_file_size_mtime_command(root: String) -> ArgvCommand {
  argv_command(program: find_program(), arguments: [root, "-type", "f", "-printf", "%s\\t%T@\\t%P\\n"])
}

// THE ACTIONS THAT MAKE find RUN ANOTHER PROGRAM ON WHAT IT MATCHED (find manual, "Run Commands"):
// -exec and -execdir, and their prompting forms -ok and -okdir. find itself reads directory entries
// and inodes; every content reader it can reach -- cat, sha256sum, grep -- arrives through one of
// these four. find_regular_files_sha256_command above is a real builder that uses one.
data find_program_running_actions: List<String> = ["-exec", "-execdir", "-ok", "-okdir"]

fn find_command_runs_another_program(command: ArgvCommand) -> Bool {
  any(command.arguments, a => any(find_program_running_actions, x => a == x))
}

// ONE PATH'S OWN ENTRY, asked a question: `find PATH -maxdepth 0 -type KIND CLAUSE...` prints PATH iff the
// entry is of that type and the clause (-user, -perm ...) holds, and prints nothing otherwise -- the
// answer a caller reads is whether the path was printed (gunbc.fleet.host_credential_custody_converge
// classify_find_answer). -maxdepth 0 keeps it to the entry itself.
fn find_path_probe_command(path: String, kind: String, clause: List<String>) -> ArgvCommand {
  argv_command(program: find_program(), arguments: concat([path, "-maxdepth", "0", "-type", kind], clause))
}

// THE BOUNDED SUBTREE WALK, AS THREE SEALED BUILDERS (WORKER-ROOT-EQUIVALENT-3). These exist because
// the mint of extdeps.exec.command ArgvCommand admits only named builders homed in the tool's own
// module: a roadmap may not spell find's flags for find. They are also where the SHAPE of a subtree
// grant is decided once, for every consumer, so no roadmap can compose an unbounded or unsafe walk by
// hand. THE FIVE PROPERTIES, each a word in the argv below:
//   ONE, BOUNDED. `-maxdepth`: an object store nests two levels (fan-out dir + object) and a git ref
//     nest is `refs/heads/<branch>` plus its reflog mirror, so a few dozen levels bounds the walk
//     against a symlink loop or a pathological tree while staying nowhere near a real depth. The bound
//     is a word the builder owns, not a knob a caller may drop.
//   TWO, THE CALLER'S PRUNED SUBTREES ARE PRUNED BEFORE THE PREDICATE. `pruned` names entries
//     RELATIVE TO THE TARGET, and each is spliced as `<target>/<name>`; the prune precedes the
//     predicate rather than filtering after it, so a confined directory is never descended into at
//     all -- not merely excluded from the action.
//     ANCHORED, NEVER A BARE PATTERN: a bare `*/pack` (or a nameless `-name pack`) matches at ANY
//     depth, and then a perfectly legal ref whose last segment is pack, info, hooks or branches
//     (refs/heads/pack, refs/heads/branches) is pruned out of the walk and its owner can never update
//     it. The caller says which children of THIS target are confined; the builder refuses to guess.
//   THREE, NO SYMLINKS. `-not -type l` keeps the walk off links entirely: chgrp --no-dereference
//     alone would not do it, because chmod -R follows, and a link under objects/ would then carry a
//     mode change to a file outside the repository.
//   FOUR, ONE PATH PER ARGUMENT, `{} +`: batched, and never through a shell, so no path can be split
//     or reinterpreted.
//   FIVE, GROUP AND MODE ONLY, never an owner. The chgrp form carries --no-dereference and NO user
//     field, so the owner of every path in the repository stays exactly who it was.
// THE EXPRESSION'S SHAPE, which is why the parenthesisation below is load-bearing: the prunes are one
// OR-group followed by `-prune -o`, and the predicate and the actions form the right operand of that
// `-o`. `-exec`/`-type` are ANDed (juxtaposition is an implicit `-a`, which binds tighter than `-o`),
// so an unbalanced `(` is not a cosmetic defect -- find aborts with "Expected a )" and the migration's
// chmod simply never runs, while the argv still LOOKS like a grant (caught at 2dc2b8de; the executed
// claim in test.claim.roadmap.worker_dedicated_account_witness is what pins it).

// THE PRUNE GROUP, `<target>/<name>` for each RELATIVE name the caller declares. Empty pruned list
// means no prune group at all -- an empty OR-group would be a syntax error, so the words are simply
// absent. The names come from the consumer because WHICH child is confined is the consumer's fact
// (#13942's confinement list, in gunbc.roadmap.roadmap_dashboard_instance), not find's.
//
// THE SEPARATOR IS PLACED BY CONSTRUCTION, so it cannot be miscounted. Each term is emitted WITH its
// own leading "-o" (separator-before-each), and the one leading separator is then dropped. Nothing
// inspects a term or an accumulator to decide whether a separator is needed, so there is no predicate
// to get wrong. That matters because this exact fold was wrong twice in this PR, both times silently:
// first it counted "-o" WORDS in the accumulator, so after the first term it found none and emitted
// the second term without its separator -- `( -path <t>/pack -path <t>/info )`, an AND of two -path
// tests on one path, which never holds, so find pruned NOTHING and the migration chgrp'd and made
// group-writable objects/pack and objects/info: a confined attempt with a writable
// objects/info/alternates, which is how an object store is redirected at a foreign repository (found
// on the lab, where the readback showed "2775 pack / 664
// pack/pack.pack / 2775 info"). The fix that followed inferred "first term" from length(acc) == 1,
// which works but rests on an UNSTATED fact -- that a term contributes words enough to change the
// length -- and a check whose correctness depends on a fact nobody wrote down is the next bug waiting
// (the alternative is two rules that agree by accident). The join now depends on nothing but its own rule.
fn find_subtree_prune_words(target: String, pruned: List<String>) -> List<String> {
  if is_empty(xs: pruned) {
    []
  } else {
    concat(
      concat(["("], find_subtree_prune_terms_joined(target: target, pruned: pruned)),
      [")", "-prune", "-o"],
    )
  }
}

// SEPARATOR-BEFORE-EACH, THEN DROP THE LEADING ONE: the join, with no condition on the terms.
fn find_subtree_prune_terms_joined(target: String, pruned: List<String>) -> List<String> {
  skip_first_word(
    words: fold(
      pruned,
      init: [] as List<String>,
      f: (acc, name) => concat(acc, concat(["-o"], find_subtree_prune_term_words(target: target, name: name))),
    )
  )
}

fn skip_first_word(words: List<String>) -> List<String> {
  words.skip(n: 1)
}

// THE TERM, on its own: `-path <target>/<name>`, an exact anchored path (anchored to the target by
// construction -- a bare `*/<name>` prune would also match a legitimate ref whose path contains a
// segment of that name, and refs/heads/.../branches/... is not exotic). Its own function so a claim
// can pin the term's SHAPE, and so the join is the only place the separator is ever written.
fn find_subtree_prune_term_words(target: String, name: String) -> List<String> {
  ["-path", concat(target, concat("/", name))]
}

// THE WALK, up to and including the predicate: target, depth bound, prunes, no symlinks. Every one of
// the three builders below hangs its action(s) off this, so all three walk the same set of paths.
// THE DEPTH IS A PARAMETER, NOT A CONSTANT HERE. `-maxdepth` is find's own option, so the SHAPE belongs
// to this module; how deep to walk a repository's object store is a fact about git's fan-out and about
// what this deployment is willing to re-group in one bounded step, which is the consumer's -- it is a
// policy figure with a cost shape (the walk is the migration's whole runtime) and it has to be legible
// and changeable where the rest of the repository posture lives. An upstream tool module that hard-codes
// a downstream number inverts the dependency: the consumer would have to know what findutils decided.
fn find_subtree_walk_words(target: String, pruned: List<String>, depth: Nat) -> List<String> {
  concat(
    concat([target, "-maxdepth", to_string(depth)], find_subtree_prune_words(target: target, pruned: pruned)),
    ["-not", "-type", "l"],
  )
}

// THE PROOF THAT A GRANT REACHED EVERYTHING: the walk FAILS if any entry it reaches is not group-writable or not in
// `group`, naming the first such entry on stderr -- which is where a failed exec step's detail is read. The decision
// is find's own exit status (`-exec false {} +` makes "found one" non-zero), so no output is parsed to decide it,
// and a walk that cannot run (a missing target, an unreadable directory) is non-zero too. A full mode listing
// folded afterwards would say the same thing at the cost of one receipt line per entry, which on a checkout of
// thousands of files is the whole cost of the check.
fn find_subtree_ungranted_entry_refusal_command(target: String, pruned: List<String>, group: String, depth: Nat) -> ArgvCommand {
  argv_command(
    program: find_program(),
    arguments: concat(
      find_subtree_walk_words(target: target, pruned: pruned, depth: depth),
      concat(
        ["(", "-not", "-perm", "-g+w", "-o", "-not", "-group", group, ")", "-fprint", "/dev/stderr"],
        find_subtree_exec_action(words: ["false"]),
      ),
    ),
  )
}

// Re-group a subtree to one group. No user field: this cannot re-own anything.
fn find_subtree_regroup_command(target: String, group: String, pruned: List<String>, depth: Nat) -> ArgvCommand {
  argv_command(
    program: find_program(),
    arguments: concat(
      find_subtree_walk_words(target: target, pruned: pruned, depth: depth),
      find_subtree_exec_action(words: chgrp_words(group: group)),
    ),
  )
}

// ONE BATCHED ACTION OVER WHAT THE WALK FOUND: `-exec <program words> {} +`. The `{}` placeholder and
// the `+` terminator are find's OWN grammar and are written exactly here -- a tool module does not get
// to decide how find terminates an action, and when chgrp briefly carried its own `{}`/`+` the two
// layers both appended them and the argv ended in `{} + {} +`, which find rejects. `<words>` are the
// other tool's (its program word and its flags) and arrive whole. Batched with `+` rather than `\;` on
// purpose: one process for the whole walk instead of one fork per entry, which on a repository's object
// store is the difference between a migration that runs and one that never finishes inside its window.
fn find_subtree_exec_action(words: List<String>) -> List<String> {
  concat(concat(["-exec"], words), ["{}", "+"])
}

// ACTIONS ARE LISTS; AN ARGV IS NOT. Each action helper returns its own List<String> -- that is what
// lets a claim pin one action without parsing the whole walk -- and an argv is a flat list of words,
// so the two layers need exactly one join, here. Written as a fold rather than a literal of literals
// so there is no version of this builder where a nested list can reach argv_command: adding a fourth
// action means adding a line to `actions:`, and the flatten is not something each call site has to
// remember (the failure this guards against: passing List<List<String>> where find wanted
// words, and both a lenient checker and a hand-read diff could miss it).
fn flatten_actions(actions: List<List<String>>) -> List<String> {
  fold(actions, init: [] as List<String>, f: (acc, action) => concat(acc, action))
}

// ONE BATCHED ACTION ON DIRECTORIES ONLY: `( -type d -exec <words> {} + )`. The guard is find's; the
// words are the other tool's. The parenthesised group is a SEPARATE action from the unguarded one,
// which is the point: g+s and a+t are properties of directories and are no-ops or wrong on files, so
// they must not ride along with the grant that applies to everything the walk reaches.
fn find_subtree_type_directory_action(words: List<String>) -> List<String> {
  concat(
    concat(["(", "-type", "d"], find_subtree_exec_action(words: words)),
    [")"],
  )
}

// THE SUBTREE GRANT: the attempt group writes the DIRECTORIES the walk reaches (so git can create the
// next entry), setgid on those directories (so an entry created later inherits the group), and the
// sticky bit where the caller says so. WHETHER FILES THEMSELVES GET `g+w` is the caller's decision,
// carried by `files_group_writable`, and it is a real decision rather than a knob:
//
//   DERIVED, NOT ASSUMED (measured on git 2.47.3, 2026-10-19, four real linked-worktree commits). Git
//   WRITES EVERYTHING EXCEPT A REFLOG BY CREATE-THEN-RENAME: a loose object is written to a temp and
//   renamed in, a ref is written to `<name>.lock` and renamed over, the worktree entry's index and HEAD
//   likewise. A rename is a write to the PARENT DIRECTORY, not to the file -- so a pre-existing object
//   or ref at git's own 0444 does not stop any of it, and those commits succeeded with every object and
//   ref file at 0444. A REFLOG is the one path git OPENS IN APPEND MODE: with the existing
//   `logs/refs/heads/<branch>` at 0444 the commit dies with "unable to append ... Permission denied".
//   So `g+w` belongs on files EXACTLY where the subtree holds a reflog (the caller names it) and nowhere
//   else. Granting it everywhere is not merely wider than needed: it makes a base object OWNED BY THE
//   SERVE ACCOUNT group-writable, and any attempt could then rewrite a shared object IN PLACE -- an
//   object is content-addressed, so a scribbled-on one is corruption for every later attempt, not just
//   the attacker's. `false` puts `g+w` behind the same `-type d` guard as the other two actions.
//
// The `-type d` guard on the setgid action is the other whole point: setgid on a file is a privilege
// shape (and RestrictSUIDSGID would refuse it anyway), while setgid on a directory is what makes a
// fan-out directory git creates later inherit the group rather than the creating process's primary
// group. The actions and their guards are inside the walk's right operand, and every `(` that opens a
// `-type d` is CLOSED: an action list that opens a group and never closes it makes find refuse the whole
// expression.
fn find_subtree_group_writable_command(
  target: String,
  pruned: List<String>,
  sticky: Bool,
  files_group_writable: Bool,
  depth: Nat,
) -> ArgvCommand {
  argv_command(
    program: find_program(),
    arguments: concat(
      find_subtree_walk_words(target: target, pruned: pruned, depth: depth),
      concat(
        // ONE ACTION PER LINE, THEN FLATTENED: each action is its own List<String> (that is what the
        // two helpers above return, and what makes them testable one action at a time), so the list
        // holding them is a List<List<String>> and reaches the argv only through flatten_actions --
        // the one place the layers meet. Review 82028 caught this builder concat'ing the nested list
        // straight into the walk: on a checker that enforces element types it does not typecheck, and
        // on one that does not, the argv would carry whole actions where find expects single words --
        // plausible, and never run. §5's fabricated output, wearing an argv.
        flatten_actions(
          actions: [
            // THE g+w ITSELF, guarded exactly as far as the caller's DERIVED decision reaches: over
            // everything (directories and reflogs alike) when files may be written in place, and behind
            // `-type d` when they may not -- so a subtree that holds no reflog gets directories-only,
            // which is what the write-set actually needs.
            if files_group_writable {
              find_subtree_exec_action(
                words: chmod_mode_words(mode: chmod_group_writable_mode)
              )
            } else {
              find_subtree_type_directory_action(
                words: chmod_mode_words(mode: chmod_group_writable_mode)
              )
            },
            find_subtree_type_directory_action(
              words: chmod_mode_words(mode: chmod_directory_setgid_mode)
            ),
          ]
        ),
        // THE STICKY BIT, on directories only, and only where the caller says this subtree holds
        // entries the walker must not be able to remove. WHY IT EXISTS (bright-moth-475, 2026-10-18,
        // the finding this closes): rename(2) checks the PARENT for write, not the entry -- a write
        // check on the moved item applies only when it changes parent. So a group-writable objects/
        // let a confined worker do `mv objects/pack objects/pack.x` even with objects/pack at 0555,
        // and plant `ln -s <any dir> objects/pack` in its place. The named ROOT maintenance job then
        // writes new pack-*.pack files into, and `repack -d` deletes "redundant" ones from, a
        // directory the WORKER chose: root writing and deleting through a worker-planted symlink,
        // which voids the confinement against the very job this PR names. With +t the parent stays
        // group-writable for CREATING entries and only an entry's OWNER (or root) may rename or unlink
        // it -- measured on the host: mv of a foreign-owned entry under a 3775 parent returns
        // non-zero, while the owner renaming its OWN entry under the same parent still exits 0, so
        // the worker keeps replacing its own refs, objects and lock files.
        // NOT `-R`: the same reason as the g+s action. `chmod +t` recursively would follow the walk's
        // reach into files; the -type d guard keeps it where it means something.
        if sticky {
          find_subtree_type_directory_action(
            words: chmod_mode_words(mode: chmod_directory_sticky_mode)
          )
        } else {
          []
        },
      ),
    ),
  )
}

// FIND'S -printf VOCABULARY, AS ROWS. These five rows are the readback's line format and the two
// letters its reader accepts, so the code that DECIDES on a line imports THESE rather than re-typing the
// letters beside each other. find(1) defines `%y` as the entry's type letter (`d` directory, `f` regular
// file, `l` symbolic link, and others for sockets, FIFOs and devices), `%m` as the permission bits in the
// special-digit-omitted octal form, and `%P` as the path with the starting point stripped. A letter
// outside the two the model names is NOT quietly read as a third thing: the reader refuses it, because a
// symlink, a socket or a device inside a git object store is not a granted entry, and counting it as one
// would be a verdict over a tree the walk never classified.
// THE GROUP, PRINTED AS ITS OWN FACT BECAUSE THE MODE CANNOT CARRY IT AND A SILENTLY-FAILED chgrp CANNOT
// BE INFERRED FROM ANYTHING ELSE IN THE LINE: %m says the group may write, %g says WHICH GROUP. A receipt
// without it can prove the mode half of a grant and go green over a tree whose chgrp never took effect --
// and the grant whose whole purpose is the re-group is exactly the grant a gate is about to trust. find
// prints the numeric gid when no name maps to it, which is what a test that groups to its own gid needs.
data find_printf_type_field: NonEmptyStr = "%y"
data find_printf_mode_field: NonEmptyStr = "%m"
data find_printf_group_field: NonEmptyStr = "%g"
data find_printf_relative_path_field: NonEmptyStr = "%P"
data find_printf_type_directory_letter: NonEmptyStr = "d"
data find_printf_type_regular_file_letter: NonEmptyStr = "f"

// THE RECEIPT for one subtree: one line per entry, `<type-letter> <mode-in-octal> <group> <path>`, with
// nothing read but metadata -- find stat's every entry anyway, so all three facts come from the inode it
// already has. THE GROUP IS PRINTED ALONGSIDE THE MODE because a grant has two halves and a receipt that
// shows one cannot certify the other: a chgrp that failed while its chmod succeeded -- or a tree somebody
// chmod-ed by hand -- reads back GRANTED to a fold that never saw a group. find prints the numeric gid
// when no name maps to it, so a caller that grouped by number can compare what it grouped by.
// THE TYPE IS PRINTED BECAUSE THE MODE CANNOT BE ASKED TO CARRY IT: a regular file may be setgid, and
// setgid sets the owner-execute leg of the special digit, so a decision that infers "directory" from an
// executable owner bit waves a setgid FILE through as a directory -- while this PR's own migration
// comment says setgid belongs on directories alone, because setgid on a file is a privilege shape
// (the execute bit is not a type: a setgid file sets it). find prints the type as its own fact, so the
// decision reads the fact instead of guessing at it: DESIGN 4's "the richer source always exists". The
// path stays LAST, so a path holding a space survives, and the mode is a whole field rather than a head.
// The migration's readback is this command's OUTPUT, and the model's predicates decide whether it is a
// grant -- so a hand step on srv1 is a declared, bounded step whose readback the model checks rather
// than a thing a person asserts.
fn find_subtree_mode_readback_command(target: String, pruned: List<String>, depth: Nat) -> ArgvCommand {
  argv_command(
    program: find_program(),
    arguments: concat(
      find_subtree_walk_words(target: target, pruned: pruned, depth: depth),
      [
        "-printf",
        join(
          [
            find_printf_type_field as String,
            " ",
            find_printf_mode_field as String,
            " ",
            find_printf_group_field as String,
            " ",
            find_printf_relative_path_field as String,
            "\\n",
          ],
          "",
        ),
      ],
    ),
  )
}
