module extdeps.tools.env

import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/env.html"
  }
}

// ONE BINARY, TWO RESOLUTION FORMS -- AND THEY ARE TWO FACTS, NOT TWO SPELLINGS OF ONE.
//
// Before this module existed, env(1) had no upstream authority at all: the absolute path was
// declared inside a product module (gunbc.roadmap_dashboard_instance's environment binding) and
// the PATH-resolved name was re-spelled as a bare "env" literal at every other call site. That is
// the section-3 nickname in its purest form -- one binary named independently in a dozen places,
// with nothing that would refuse if two of them disagreed. The chmod authority next door records
// what that costs: its path and a product module's copy of it disagreed (/bin vs /usr/bin) and
// neither side could see the other.
//
// The dissolution is NOT "pick the winning literal". Absolute exec and PATH resolution answer
// different questions and have different failure modes:
//
//   - the ABSOLUTE path is a recorded fact about a host whose filesystem this repository has
//     observed. It is what a sudoers NOPASSWD rule can name, what a required-executable preflight
//     can test for existence, and what refuses loudly on a host where the fact is false.
//   - the PATH-RESOLVED name is the correct form when the executing host is NOT one this
//     repository has observed -- a remote target reached over ssh, a runner image, a developer
//     box. Asserting an absolute path there would be fabricating a host fact (DESIGN 5), so the
//     name defers the lookup to the host that actually knows the answer.
//
// So both forms live here, each named, each with its reason, and every call site CITES one rather
// than spelling a literal. The nickname is dissolved (no site invents a spelling) without erasing
// the distinction (a caller still declares which question it is asking).

data env_binary_path: NonEmptyStr = "/usr/bin/env"

data env_path_resolved_program: NonEmptyStr = "env"
