module extdeps.tools.env

import std.types { String, NonEmptyStr, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import v2.std.orchestration { EnvBinding, EnvSet, EnvUnset }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/env.html"
  }
}

// THE UNSET FLAG IS NOT POSIX. `env -u NAME` is a GNU coreutils extension; POSIX env offers only
// `-i` (empty the whole environment) and NAME=value assignments. The two anchors are separate
// because the guarantee is: an EnvSet argv runs anywhere env does, an EnvUnset argv requires the
// GNU implementation extdeps.tools.gnu_coreutils already pins a version constraint for.
data env_unset_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/coreutils/manual/html_node/env-invocation.html"
  }
}

// Absolute for the same reason extdeps.tools.mkdir and extdeps.tools.chmod are: a bare `env`
// resolves through PATH, so it names whatever the ambient environment decided rather than a
// binary. Callers that spelled it bare were not choosing a different binary, they were declining
// to say which one.
data env_binary_path: NonEmptyStr = "/usr/bin/env"

data env_unset_flag: NonEmptyStr = "-u"

// ONE BINDING, ONE OR TWO ARGV ELEMENTS -- which is the whole reason this returns a List rather
// than a String. An assignment occupies a single element (`NAME=value`), an unset occupies two
// (`-u`, `NAME`), so a caller that assumed one-binding-one-element would silently weld the flag
// to the name and pass a variable literally called `-uNAME`.
fn env_binding_argv(binding: EnvBinding) -> List<String> {
  match binding {
    EnvSet { name: n, value: v } => [concat(n, concat("=", v))]
    EnvUnset { name: n } => [env_unset_flag as String, n]
  }
}

fn env_bindings_argv_step(acc: List<String>, binding: EnvBinding) -> List<String> {
  concat(acc, env_binding_argv(binding: binding))
}

fn env_bindings_argv(bindings: List<EnvBinding>) -> List<String> {
  fold(bindings, [], env_bindings_argv_step)
}

// THE DIRECT-EXEC HANDLER, SIBLING TO THE BASH ONE -- not a fork of it. The same semantic request
// (run this command under these bindings) has two realizations: emitted bash text, where
// bash_orchestration_emit `bash_env_prefix` lowers it into a command line, and direct process
// execution, where there is no shell to do the prefixing and the bindings must arrive as argv
// elements. Both read the one EnvBinding authority in v2.std.orchestration, which is what keeps
// them two handlers rather than two models.
fn env_prefixed_argv(bindings: List<EnvBinding>, command_argv: List<String>) -> List<String> {
  concat(
    concat([env_binary_path as String], env_bindings_argv(bindings: bindings)),
    command_argv,
  )
}

// The tail alone, for a transport whose shape splits bin_path from args. Same split, same reason,
// as extdeps.tools.chmod: the two halves must reach one authority or they drift apart.
fn env_prefixed_args(bindings: List<EnvBinding>, command_argv: List<String>) -> List<String> {
  concat(env_bindings_argv(bindings: bindings), command_argv)
}
