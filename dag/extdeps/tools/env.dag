module extdeps.tools.env

import std.types { String, NonEmptyStr, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import v2.std.orchestration { EnvBinding, EnvSet, EnvUnset }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/env.html"
  }
}

// THE UNSET FLAG IS NOT POSIX. `env -u NAME` is a GNU coreutils extension; POSIX env offers only
// `-i` (empty the whole environment) and NAME=value assignments. The two anchors are separate
// because the guarantee is: an EnvSet argv runs anywhere env does, an EnvUnset argv requires the
// GNU implementation extdeps.tools.gnu_coreutils already pins a version constraint for.
data env_unset_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/coreutils/manual/html_node/env-invocation.html"
  }
}

// ONE BINARY, TWO RESOLUTION FORMS -- AND THEY ARE TWO FACTS, NOT TWO SPELLINGS OF ONE.
//
// Before this module existed, env(1) had no upstream authority at all: the absolute path was
// declared inside a product module (gunbc.roadmap_dashboard_instance's environment binding) and
// the PATH-resolved name was re-spelled as a bare "env" literal at every other call site. That is
// the section-3 nickname in its purest form -- one binary named independently across the corpus,
// with nothing that would refuse if two of those names disagreed. The chmod authority next door
// records what that costs: its path and a product module's copy of it disagreed (/bin vs /usr/bin)
// and neither side could see the other.
//
// A first reading of this said the bare name is a DECLINE TO SAY WHICH BINARY and that the
// absolute path is therefore the correct form everywhere. That is half right and the wrong half is
// load-bearing. Absolute exec and PATH resolution answer different questions:
//
//   - the ABSOLUTE path is a claim about a filesystem this repository has OBSERVED. It is what a
//     sudoers NOPASSWD rule can name, what a required-executable preflight can test for existence,
//     and what refuses loudly on a host where the claim is false.
//   - the PATH-RESOLVED name is correct when the executing host is NOT one this repository has
//     observed -- a machine reached over ssh, a runner image, a developer box. Asserting an
//     absolute path there does not fix the decline, it fabricates a host fact, which is the
//     DESIGN section 5 violation rather than the repair for one.
//
// So both live here, each named, each with its reason, and every call site CITES one rather than
// spelling a literal. The nickname dies -- no site invents a spelling -- without erasing the
// distinction, because a caller now has to declare which question it is asking.
data env_binary_path: NonEmptyStr = "/usr/bin/env"

// The PATH-resolved form. Its consumers are exactly the sites whose target host this repository
// has not read: gunbc.runner_host_deploy (a runner image), gunbc.fleet_ssh_credential_verify and
// gunbc.typed_remote_file_write (machines reached over ssh), gunbc.roadmap_dispatch_actuator and
// gunbc.live_deploy.deployed_tree_observation (whatever box the dispatcher is running on), and
// extdeps.llm.cli. None of them may assert /usr/bin/env; all of them were spelling "env".
data env_path_resolved_program: NonEmptyStr = "env"

data env_unset_flag: NonEmptyStr = "-u"

// ONE BINDING, ONE OR TWO ARGV ELEMENTS -- which is the whole reason this returns a List rather
// than a String. An assignment occupies a single element (`NAME=value`), an unset occupies two
// (`-u`, `NAME`), so a caller that assumed one-binding-one-element would silently weld the flag
// to the name and pass a variable literally called `-uNAME`.
fn env_binding_argv(binding: EnvBinding) -> List<String> {
  match binding {
    EnvSet { name: n, value: v } => [concat(n, concat("=", v))]
    EnvUnset { name: n } => [env_unset_flag as String, n]
  }
}

fn env_bindings_argv_step(acc: List<String>, binding: EnvBinding) -> List<String> {
  concat(acc, env_binding_argv(binding: binding))
}

fn env_bindings_argv(bindings: List<EnvBinding>) -> List<String> {
  fold(bindings, [], env_bindings_argv_step)
}

// THE DIRECT-EXEC HANDLER, SIBLING TO THE BASH ONE -- not a fork of it. The same semantic request
// (run this command under these bindings) has two realizations: emitted bash text, where
// bash_orchestration_emit `bash_env_prefix` lowers it into a command line, and direct process
// execution, where there is no shell to do the prefixing and the bindings must arrive as argv
// elements. Both read the one EnvBinding authority in v2.std.orchestration, which is what keeps
// them two handlers rather than two models.
fn env_prefixed_argv(bindings: List<EnvBinding>, command_argv: List<String>) -> List<String> {
  concat(
    concat([env_binary_path as String], env_bindings_argv(bindings: bindings)),
    command_argv,
  )
}

// The tail alone, for a transport whose shape splits bin_path from args. Same split, same reason,
// as extdeps.tools.chmod: the two halves must reach one authority or they drift apart.
fn env_prefixed_args(bindings: List<EnvBinding>, command_argv: List<String>) -> List<String> {
  concat(env_bindings_argv(bindings: bindings), command_argv)
}
