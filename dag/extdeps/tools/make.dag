module extdeps.tools.make

import std.types { String, NonEmptyStr, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/make/manual/make.html"
  }
}

// PATH-RESOLVED PROGRAM NAME, DELIBERATELY, AND NOT A DECLINE TO SAY WHICH BINARY. An absolute path
// is a CLAIM ABOUT AN OBSERVED FILESYSTEM: extdeps.tools.mkdir and extdeps.tools.chmod record theirs
// because a sudoers NOPASSWD rule names those commands by path on hosts this repository provisions,
// which is an observation with a consumer. This repository has made no such observation for the
// hosts these commands run on -- fleet members, runner images, a BMC -- so writing one here would
// replace a vague spelling with a confident false host fact, which is the fabrication DESIGN section
// 5 forbids rather than an improvement on it. The name is resolved by the target's own PATH, and
// that is what the previous hand-spelled call sites did too: this conversion changes WHERE the
// spelling lives, not WHICH program runs.
data make_program: NonEmptyStr = "make"

// -C IS PART OF THE OPERATION, THE REST IS THE CALLER'S. Which directory the build runs in is a fact
// this builder owns, because getting it from the ambient working directory is how a build silently
// operates on the wrong tree. Everything after it -- targets, and the variable assignments GNU make
// takes as ordinary operands -- is the caller's own request, which this module has no authority to
// enumerate: a builder that tried would be modeling every Makefile in the world.
fn make_command(directory: String, arguments: List<String>) -> ArgvCommand {
  argv_command(program: make_program, arguments: append(["-C", directory], items: arguments))
}
