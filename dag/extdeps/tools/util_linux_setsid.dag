module extdeps.tools.util_linux_setsid

import extdeps.exec.program { ProgramIdentity, uncataloged_program }
import extdeps.exec.command { ArgvCommand, argv_command }

import std.types { NonEmptyStr, String, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// setsid(1), util-linux: "setsid [options] program [arguments]" -- run a program in a new session. The
// program becomes a session leader with no controlling terminal, so it is not signalled when the session
// that started it hangs up. Cited to the manual page, not to any host's reading.
//
// WHAT --fork DOES TO THE STATUS THE CALLER OBSERVES: -f/--fork "always create a new process", so setsid
// forks the program and its own process returns at once. Without -w/--wait that return is exit status 0
// whatever the program later does, so a caller that detaches with --fork learns nothing about the program
// from the exit status and must judge it by an independent readback. -w/--wait makes setsid wait for the
// program and return the program's exit status, which is then not a detach at all from the caller's point of
// view. Only the detaching form is modeled; the waiting form has no consumer.
//
// THE PROGRAM'S STANDARD STREAMS ARE NOT CHANGED by setsid: a detached program whose stdout is still the
// caller's channel keeps that channel open. Directing them elsewhere is a different fact setsid does not own.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/setsid.1.html"
  }
}

fn setsid_program() -> ProgramIdentity = uncataloged_program(invocation: "setsid")

fn setsid_fork_command(command: List<String>) -> ArgvCommand {
  argv_command(program: setsid_program(), arguments: concat(["--fork"], command))
}
