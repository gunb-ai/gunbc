module extdeps.tools.sleep

import std.types { NonEmptyStr, Bool, Unit, List }
import std.string_type { String }
import std.measure { Second, second_count }
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.uri { Uri, Https }
import extdeps.tools { CliTool, SourceCoreutils }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/sleep.html"
  }
}

data sleep_cli_tool: CliTool = CliTool {
  name: "sleep",
  min_version: none,
  installable_via: [SourceCoreutils],
}

data sleep_delay_seconds_flat_scalar_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.tools.sleep",
    decl_name: "sleep_delay_seconds_second_carrier_projection",
    field: WholeDeclaration,
  }
}

fn sleep_delay_seconds_second_carrier_projection(duration: Second) -> Bool {
  let seconds = second_count(s: duration)
  if seconds <= 0 {
    false
  } else {
    sleep.Delay.Seconds(seconds: to_string(seconds) as NonEmptyStr).success
  }
}

// ── THE SAME SHAPE, RENDERED AS ARGV FOR A HANDLER THAT IS NOT THIS PROCESS ───────────────────
//
// THE SERVICE BELOW RUNS THE SLEEP HERE. A caller that must wait on ANOTHER host sends words to a
// remote execution leg instead, which is a second realization handler bound to this same shape --
// not a reason to mint `["sleep", n]` in a product module, where the non-positive refusal above
// would be dropped along with the citation.
//
// NON-POSITIVE REFUSES, exactly as the projection does. A zero or negative wait is a caller that
// computed its interval wrongly, and rendering `sleep 0` would turn a polling bug into a busy loop
// against a remote daemon.
type SleepArgvRendering
  = SleepArgv { words: List<String> }
  | SleepDurationRefused { duration: Second }

fn sleep_seconds_argv(duration: Second) -> SleepArgvRendering {
  let seconds = second_count(s: duration)
  if seconds <= 0 {
    SleepDurationRefused { duration: duration }
  } else {
    SleepArgv { words: [sleep_cli_tool.name, to_string(seconds)] }
  }
}

service sleep.Delay {
  operation Seconds {
    input { seconds: NonEmptyStr }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["sleep", "{seconds}"] }
    exit {
      0 => Unit
      nonzero => String "sleep failed"
    }
    mock_response {
      0 => { success: true } "hermetic sleep.Delay.Seconds"
    }
  }
}

// THE SAME WORDS AS A COMMAND, for a caller that waits through extdeps.exec.command's transport;
// the non-positive refusal is carried, not dropped, exactly as the argv rendering carries it.
type SleepCommandRendering
  = SleepCommand { command: ArgvCommand }
  | SleepCommandDurationRefused { duration: Second }

fn sleep_seconds_command(duration: Second) -> SleepCommandRendering {
  match sleep_seconds_argv(duration: duration) {
    SleepDurationRefused { duration: d } => SleepCommandDurationRefused { duration: d }
    SleepArgv { words: w } => SleepCommand { command: argv_command(program: sleep_cli_tool.name as NonEmptyStr, arguments: w.skip(n: 1)) }
  }
}
