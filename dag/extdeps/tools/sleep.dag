module extdeps.tools.sleep


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/sleep.html"
  }
}

data sleep_cli_tool: CliTool = CliTool {
  name: "sleep",
  min_version: none,
  installable_via: [SourceCoreutils],
}

data sleep_delay_seconds_flat_scalar_dissolution_trigger: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: RealizationDispatch,
  bind: std.decl_ref.DeclarationRef {
    module_path: "extdeps.tools.sleep",
    decl_name: "sleep_delay_seconds_second_carrier_projection",
    field: WholeDeclaration,
  }
}

fn sleep_delay_seconds_second_carrier_projection(duration: std.measure.Second) -> Bool {
  let seconds = second_count(s: duration)
  if seconds <= 0 {
    false
  } else {
    sleep.Delay.Seconds(seconds: to_string(seconds) as std.types.NonEmptyStr).success
  }
}

service sleep.Delay {
  operation Seconds {
    input { seconds: std.types.NonEmptyStr }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["sleep", "{seconds}"] }
    exit {
      0 => Unit
      nonzero => String "sleep failed"
    }
    mock_response {
      0 => { success: true } "hermetic sleep.Delay.Seconds"
    }
  }
}
