module extdeps.tools.socat


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Http
    locator: "www.dest-unreach.org/socat/doc/socat.html"
  }
}

data socat_pinned_version: extdeps.version.VersionConstraint = ">= 1.7.4"

data socat_cli_tool: CliTool = CliTool {
  name: "socat",
  min_version: Present { value: socat_pinned_version },
  installable_via: [SourceApt { package: package_socat }],
}
