module extdeps.tools.nbdkit


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "libguestfs.org/html"
  }
}

data nbdkit_pinned_version: extdeps.version.VersionConstraint = ">= 1.34"

data nbdkit_cli_tool: CliTool = CliTool {
  name: "nbdkit",
  min_version: Present { value: nbdkit_pinned_version },
  installable_via: [SourceApt { package: package_nbdkit }],
}
