module extdeps.tools.busybox


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "busybox.net/downloads/BusyBox.html"
  }
}

data busybox_pinned_version: extdeps.version.VersionConstraint = ">= 1.36"

data busybox_cli_tool: CliTool = CliTool {
  name: "busybox",
  min_version: Present { value: busybox_pinned_version },
  installable_via: [SourceApt { package: package_busybox }],
}

data busybox_source_1_36_1_url: extdeps.uri.Uri = extdeps.uri.Uri {
  scheme: Https,
  locator: "busybox.net/downloads/busybox-1.36.1.tar.bz2",
}

fn busybox_httpd_command(busybox_bin: std.types.NonEmptyStr, document_root: std.types.NonEmptyStr, port: std.types.Port) -> extdeps.exec.command.ArgvCommand {
  extdeps.exec.command.ArgvCommand {
    argv: [busybox_bin as String, "httpd", "-p", to_string(port), "-h", document_root as String],
  }
}
