module extdeps.tools.dpkg_deb

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

// dpkg-deb(1), the Debian package archive manipulation tool shipped by dpkg. `-x <archive> <dir>`
// (--extract) unpacks the archive's data member into <dir> and NOTHING ELSE: no maintainer script
// runs, the dpkg database is not touched, and no dependency is resolved or fetched. That is why it
// is the extraction a job-user install uses -- it needs no administrator and pulls in nothing the
// caller did not name (no Depends, no Recommends).
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/dpkg-deb.1.html"
  }
}

// PATH-resolved, for the reason extdeps.exec.command program_spelling_is_an_observation_claim records.
fn dpkg_deb_program() -> ProgramIdentity = uncataloged_program(invocation: "dpkg-deb")

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tools.dpkg_deb",
      decl_name: "dpkg_deb_program",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

fn dpkg_deb_extract_command(archive: String, into_directory: String) -> ArgvCommand {
  argv_command(program: dpkg_deb_program(), arguments: ["-x", archive, into_directory])
}
