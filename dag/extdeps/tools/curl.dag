module extdeps.tools.curl


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "curl.se/docs/manpage.html"
  }
}

data curl_pinned_version: extdeps.version.VersionConstraint = ">= 7.68"

data curl_cli_tool: CliTool = CliTool {
  name: "curl",
  min_version: Present { value: curl_pinned_version },
  installable_via: [SourceApt { package: package_curl }],
}

data curl_localhost_connect_timeout: std.measure.Second = second(count: 2)

data curl_localhost_max_time: std.measure.Second = second(count: 5)

fn curl_bounded_get_flags(connect_timeout: std.measure.Second, max_time: std.measure.Second) -> String {
  concat(
    concat("--connect-timeout ", to_string(second_count(s: connect_timeout))),
    concat(" --max-time ", to_string(second_count(s: max_time)))
  )
}

fn curl_bounded_localhost_get_argv_prefix(connect_timeout: std.measure.Second, max_time: std.measure.Second) -> String {
  concat("curl -sf ", curl_bounded_get_flags(connect_timeout: connect_timeout, max_time: max_time))
}

fn curl_localhost_bounded_get_argv_prefix() -> String {
  curl_bounded_localhost_get_argv_prefix(
    connect_timeout: curl_localhost_connect_timeout,
    max_time: curl_localhost_max_time
  )
}
