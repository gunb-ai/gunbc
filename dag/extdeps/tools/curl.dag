module extdeps.tools.curl

import std.types { String, NonEmptyStr, Bool, List, FilePath }
import std.measure { Second, second, second_count }
import extdeps.version { VersionConstraint }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.tools { CliTool, SourceApt }
import extdeps.apt { package_curl }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "curl.se/docs/manpage.html"
  }
}

data curl_pinned_version: VersionConstraint = ">= 7.68"

data curl_cli_tool: CliTool = CliTool {
  name: "curl",
  min_version: Present { value: curl_pinned_version },
  installable_via: [SourceApt { package: package_curl }],
}

data curl_localhost_connect_timeout: Second = second(count: 2)

data curl_localhost_max_time: Second = second(count: 5)

fn curl_bounded_get_flags(connect_timeout: Second, max_time: Second) -> String {
  concat(
    concat("--connect-timeout ", to_string(second_count(s: connect_timeout))),
    concat(" --max-time ", to_string(second_count(s: max_time)))
  )
}

fn curl_bounded_localhost_get_argv_prefix(connect_timeout: Second, max_time: Second) -> String {
  concat("curl -sf ", curl_bounded_get_flags(connect_timeout: connect_timeout, max_time: max_time))
}

fn curl_localhost_bounded_get_argv_prefix() -> String {
  curl_bounded_localhost_get_argv_prefix(
    connect_timeout: curl_localhost_connect_timeout,
    max_time: curl_localhost_max_time
  )
}

// THE DOWNLOAD, WITH ITS SUCCESS SEMANTICS ATTACHED. -f is not decoration: without it curl exits 0
// on a 404 and writes the error page to the destination, which is the fail-open class
// gunbc.plans.transport_argv_anemia_dissolution exists to remove. -s suppresses the progress meter,
// -L follows redirects, -o names the destination. Moved here from extdeps.exec.command, which is a
// generic hub and may not carry one product's flags (DESIGN section 3).
// PATH-resolved program name, deliberately: this repository has made no filesystem observation of
// the host this command runs on, and an absolute path is a claim about one. The full reasoning, the
// criterion for climbing to an absolute row, and the counter-example that makes the distinction
// load-bearing are recorded once at extdeps.exec.command program_spelling_is_an_observation_claim.
data curl_program: NonEmptyStr = "curl"

fn curl_download_command(url: String, destination: String) -> ArgvCommand {
  argv_command(program: curl_program, arguments: ["-fsL", "-o", destination, url])
}

// THE FTPS UPLOAD, WHOSE FLAGS ARE DERIVED FROM THE MODELED ENDPOINT RATHER THAN CHOSEN HERE.
//
// THE CREDENTIAL REACHES THIS BUILDER AS A BINDING, NEVER AS A SECRET. An earlier draft of this
// function took the login as `user_and_secret: String` and rendered it into `--user`, which would
// have added a new instance to the class gunbc.credential_argv_exposure exists to enumerate and
// retire: on this fleet /proc carries no hidepid and /proc/PID/cmdline is mode 0444, so an argv word
// is readable by any job payload on a runner slot. The same defect was already found and repaired on
// the Redfish side -- the `-u {username}:{password}` arms were DELETED from extdeps.bmc.http in
// favour of a 0600 netrc -- so re-spelling it here would have re-opened a closed class rather than
// discovered a new one. This builder therefore cannot express the exposed form: it has no parameter
// that could carry a secret, and the account name lives in the netrc file beside the password rather
// than on the command line. Who writes that file, at what mode, and who destroys it afterwards are
// facts of the CALLER's materialization bracket, not of curl.
//
// -T is upload, and the trailing slash on the URL is load-bearing: curl treats a URL ending in "/"
// as a directory and appends the local basename, which would put the file under whatever the local
// path happened to be called. The remote name is a modeled decision, so it is spelled explicitly.
//
// --ssl-reqd REFUSES rather than downgrades. curl's --ssl merely PREFERS TLS and silently proceeds
// in cleartext when the server declines, which would ship an access code over the wire in the clear
// and still exit 0 -- the fail-open shape this repository forbids. --ftp-ssl-control is the same
// trap one step in: it encrypts the login and leaves the DATA connection clear, so it is likewise
// never emitted. There is no arm of this builder that produces an unencrypted transfer.
//
// -k is emitted ONLY for a modeled unverifiable peer, never as a default, so a device that genuinely
// presents a verifiable certificate is still verified.
fn curl_ftps_upload_command(
  url: String,
  local_path: String,
  netrc_path: FilePath,
  skip_verification: Bool,
) -> ArgvCommand {
  argv_command(
    program: curl_program,
    arguments: concat(
      ["-fsS", "--ssl-reqd", "--netrc-file", netrc_path as String, "-T", local_path],
      concat(if skip_verification { ["-k"] } else { [] }, [url]),
    ),
  )
}

// --aws-sigv4 LANDED IN curl 7.75.0 (curl.se/docs/manpage.html, "--aws-sigv4 <provider1[:prvdr2[:reg[:srv]]]>",
// "Added in 7.75.0"). The two S3 builders below are unspellable on an older curl, so they name a
// SECOND CliTool whose min_version is this constraint rather than silently raising curl_pinned_version:
// the download and FTPS builders above genuinely need no more than 7.68, and a fleet host that
// carries 7.68 still runs them correctly. curl_cli_tool stays the 7.68 pin; the SigV4 builders
// emit curl_aws_sigv4_cli_tool.name so a 7.68 host that satisfies curl_cli_tool still owes 7.75
// on the path that spells --aws-sigv4.
data curl_aws_sigv4_min_version: VersionConstraint = ">= 7.75"

data curl_aws_sigv4_cli_tool: CliTool = CliTool {
  name: curl_program,
  min_version: Present { value: curl_aws_sigv4_min_version },
  installable_via: [SourceApt { package: package_curl }],
}

// THE SIGV4 PROVIDER STRING FOR AN S3-SHAPED ENDPOINT. curl's --aws-sigv4 value is
// provider1[:provider2[:region[:service]]]; "aws:amz" is the algorithm/header prefix pair every
// AWS-signature-compatible store expects, and region and service are the two variables an S3
// clone actually differs on. They are received rather than spelled here, because which region a
// particular store signs under is that store's fact (Cloudflare R2 signs under "auto",
// extdeps.cloudflare.r2 r2_s3_sigv4_region) and this module may not carry one product's value.
fn curl_aws_sigv4_s3_provider(region: NonEmptyStr) -> String {
  join(["aws:amz:", region as String, ":s3"], "")
}

// THE S3 UPLOAD AND DOWNLOAD, SIGNED, WITH THE CREDENTIAL REACHING curl THROUGH A NETRC FILE.
//
// THE CREDENTIAL IS NEVER AN ARGV WORD. --aws-sigv4 documents its credential as --user
// <key>:<secret>, which on this fleet is readable from /proc/PID/cmdline by any co-tenant of the
// runner slot (gunbc.credential_argv_exposure). curl also reads the same login/password pair from
// --netrc-file for the request's host, and signs with it -- measured, not assumed: against a local
// listener, a netrc carrying `machine <host> login <key> password <secret>` produced
// `Authorization: AWS4-HMAC-SHA256 Credential=<key>/...` with no --user on the command line
// (tidy-hawk-349, 2026-09-12). So these builders, like curl_ftps_upload_command above, have NO
// parameter that could carry a secret: the netrc path crosses into argv, the bytes do not.
//
// -f IS LOAD-BEARING ON BOTH. Without it curl exits 0 on a 403 or a 404 and, on the download,
// writes the store's XML error document to the destination -- a "staged object" that is really an
// error page, digested and confirmed downstream. With -f a non-2xx exits 22 and writes NOTHING to
// the destination (measured: a 404 left no file behind), so a staged path either holds the object's
// bytes or does not exist.
//
// THE STATUS IS STILL REPORTED, ON STDOUT, so the caller can tell 404 from 403 without parsing
// stderr prose: -w '%{http_code}' prints the three digits after the transfer, and prints 000 when
// no HTTP status was ever received (connect failure, timeout), which is how a caller separates
// "the store answered" from "nothing answered" -- the distinction gunbc.fabric_m0_commit's
// CommitTransportOutcome exists to keep.
//
// THE CONDITIONAL WRITE IS A PARAMETER, NOT A DEFAULT. If-None-Match: * turns the PUT into
// create-if-absent (RFC 9110 section 13.1.2, honoured by S3-shaped stores that implement
// conditional writes); whether a given object may ever be overwritten is the STORE POLICY of the
// caller, so it is passed in rather than spelled here, and the header goes into SignedHeaders
// (measured: `SignedHeaders=host;if-none-match;...`) so a proxy cannot strip it unsigned.
//
// -T names the local file to upload and the URL names the remote object EXACTLY; the trailing-slash
// directory behaviour curl_ftps_upload_command warns about is avoided the same way, by never
// emitting a URL that ends in "/".
data curl_http_code_write_out_format: String = "%\{http_code\}"

data curl_if_none_match_any_header: String = "If-None-Match: *"

fn curl_sigv4_s3_upload_command(
  url: String,
  local_path: String,
  netrc_path: FilePath,
  sigv4_region: NonEmptyStr,
  create_only: Bool,
) -> ArgvCommand {
  argv_command(
    program: curl_aws_sigv4_cli_tool.name,
    arguments: concat(
      [
        "-fsS",
        "--netrc-file", netrc_path as String,
        "--aws-sigv4", curl_aws_sigv4_s3_provider(region: sigv4_region),
        "-o", "/dev/null",
        "-w", curl_http_code_write_out_format,
      ],
      concat(
        if create_only { ["-H", curl_if_none_match_any_header] } else { [] },
        ["-T", local_path, url],
      ),
    ),
  )
}

fn curl_sigv4_s3_download_command(
  url: String,
  destination: String,
  netrc_path: FilePath,
  sigv4_region: NonEmptyStr,
) -> ArgvCommand {
  argv_command(
    program: curl_aws_sigv4_cli_tool.name,
    arguments: [
      "-fsS",
      "--netrc-file", netrc_path as String,
      "--aws-sigv4", curl_aws_sigv4_s3_provider(region: sigv4_region),
      "-o", destination,
      "-w", curl_http_code_write_out_format,
      url,
    ],
  )
}
