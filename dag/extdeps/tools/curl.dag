module extdeps.tools.curl

import extdeps.exec.program { ProgramIdentity, cataloged_program }

import std.types { String, NonEmptyStr, Bool, List, FilePath, Int, HttpStatus, http_status_of }
import std.algebra { trim }
import std.measure { Second, second, second_count, Microsecond, microsecond, microsecond_count }
import std.algebra { Less, Equal, Greater }
import extdeps.version.semver { SemVerVersion, semver_compare, semver_core_of_dotted, semver_minimum_of_constraint }
import std.checked_arithmetic { checked_int_to_nat }
import extdeps.version { VersionConstraint }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.object_storage { ObjectEntityTag, ObjectPutPrecondition, PutUnconditional, PutIfAbsent, PutIfMatch }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.tools { CliTool, SourceApt }
import extdeps.apt { apt_bin_dir, package_curl }
import v2.std.algebra { any }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "curl.se/docs/manpage.html"
  }
}

data curl_pinned_version: VersionConstraint = ">= 7.68"

data curl_cli_tool: CliTool = CliTool {
  program: curl_program(),
  min_version: Present { value: curl_pinned_version },
  installable_via: [SourceApt { package: package_curl, bin_dir: apt_bin_dir }],
}

// ── EXIT STATUSES: WHICH ONES ARE THE NETWORK ─────────────────────────────────────────────────
//
// curl(1) EXIT CODES. The ones that say the far side could not be reached: 6 could not resolve host,
// 7 failed to connect, 28 operation timeout, 35 TLS/SSL connect error, 52 empty reply from server, 56
// failure receiving network data. Anything else (22 is an HTTP error under --fail) is the source
// answering, so a caller must not read it as reachability.
data curl_unreachable_exit_statuses: List<String> = ["6", "7", "28", "35", "52", "56"]

fn curl_exit_status_is_unreachable(status: String) -> Bool {
  any(curl_unreachable_exit_statuses, s => s == status)
}

data curl_localhost_connect_timeout: Second = second(count: 2)

data curl_localhost_max_time: Second = second(count: 5)

fn curl_bounded_get_flags(connect_timeout: Second, max_time: Second) -> String {
  concat(
    concat("--connect-timeout ", to_string(second_count(s: connect_timeout))),
    concat(" --max-time ", to_string(second_count(s: max_time)))
  )
}

fn curl_bounded_localhost_get_argv_prefix(connect_timeout: Second, max_time: Second) -> String {
  concat("curl -sf ", curl_bounded_get_flags(connect_timeout: connect_timeout, max_time: max_time))
}

fn curl_localhost_bounded_get_argv_prefix() -> String {
  curl_bounded_localhost_get_argv_prefix(
    connect_timeout: curl_localhost_connect_timeout,
    max_time: curl_localhost_max_time
  )
}

// THE DOWNLOAD, WITH ITS SUCCESS SEMANTICS ATTACHED. -f is not decoration: without it curl exits 0
// on a 404 and writes the error page to the destination, which is the fail-open class
// gunbc.plans.transport_argv_anemia_dissolution exists to remove. -s suppresses the progress meter,
// -L follows redirects, -o names the destination. Moved here from extdeps.exec.command, which is a
// generic hub and may not carry one product's flags (DESIGN section 3).
// PATH-resolved program name, deliberately: this repository has made no filesystem observation of
// the host this command runs on, and an absolute path is a claim about one. The full reasoning, the
// criterion for climbing to an absolute row, and the counter-example that makes the distinction
// load-bearing are recorded once at extdeps.exec.command program_spelling_is_an_observation_claim.
fn curl_program() -> ProgramIdentity = cataloged_program(invocation: "curl")

// A bounded GET as argv words: -f makes an HTTP error a non-zero exit instead of a body, -sS keeps
// the error text on stderr while suppressing the progress meter.
fn curl_bounded_get_argv(url: String, connect_timeout: Second, max_time: Second) -> List<String> {
  [
    curl_program().invocation as String, "-fsS",
    "--connect-timeout", to_string(second_count(s: connect_timeout)),
    "--max-time", to_string(second_count(s: max_time)),
    url,
  ]
}

fn curl_download_command(url: String, destination: String) -> ArgvCommand {
  argv_command(program: curl_program(), arguments: ["-fsL", "-o", destination, url])
}

// THE BMCWEB SESSION LOGIN the srv3 install path runs (gunbc.host_effect_realize
// Srv3BmcwebSessionLogin): POST the JSON login body FROM A FILE (--data @file) and write the
// response to a file. The credential never reaches argv: the body path does, the password bytes
// stay in the file the caller's materialization bracket owns (the same bracket/argv split
// curl_ftps_upload_command below records). The word list is byte-identical to the raw flag list
// this builder replaces (extdeps.bmc.webui.nbd_proxy_serve bmcweb_session_login_curl_args,
// deleted with it); no behavior change is intended or made by this builder.
// NOT CHANGED HERE, DELIBERATELY, AND NOW VISIBLE AT THE TOOL: the list carries no --fail, so an
// HTTP error status is still exit 0 with the error body written to the response file -- the
// fail-open shape curl_download_command's comment names. Whether the login should fail closed on
// a status is the caller's convergence law (the token extract step reads the file), so the
// question moves with the carrier instead of being re-decided silently in a rename.
fn curl_bmcweb_session_login_command(
  bmc_host: NonEmptyStr,
  request_body_file: NonEmptyStr,
  response_path: NonEmptyStr,
) -> ArgvCommand {
  argv_command(
    program: curl_program(),
    arguments: [
      "-sk",
      "-X", "POST",
      concat("https://", concat(bmc_host as String, "/login")),
      "-H", "Content-Type: application/json",
      "--data", concat("@", request_body_file as String),
      "-o", response_path as String,
    ],
  )
}

// THE FTPS UPLOAD, WHOSE FLAGS ARE DERIVED FROM THE MODELED ENDPOINT RATHER THAN CHOSEN HERE.
//
// THE CREDENTIAL REACHES THIS BUILDER AS A BINDING, NEVER AS A SECRET. An earlier draft of this
// function took the login as `user_and_secret: String` and rendered it into `--user`, which would
// have added a new instance to the class gunbc.credential_argv_exposure exists to enumerate and
// retire: on this fleet /proc carries no hidepid and /proc/PID/cmdline is mode 0444, so an argv word
// is readable by any job payload on a runner slot. The same defect was already found and repaired on
// the Redfish side -- the `-u {username}:{password}` arms were DELETED from extdeps.bmc.http in
// favour of a 0600 netrc -- so re-spelling it here would have re-opened a closed class rather than
// discovered a new one. This builder therefore cannot express the exposed form: it has no parameter
// that could carry a secret, and the account name lives in the netrc file beside the password rather
// than on the command line. Who writes that file, at what mode, and who destroys it afterwards are
// facts of the CALLER's materialization bracket, not of curl.
//
// -T is upload, and the trailing slash on the URL is load-bearing: curl treats a URL ending in "/"
// as a directory and appends the local basename, which would put the file under whatever the local
// path happened to be called. The remote name is a modeled decision, so it is spelled explicitly.
//
// --ssl-reqd REFUSES rather than downgrades. curl's --ssl merely PREFERS TLS and silently proceeds
// in cleartext when the server declines, which would ship an access code over the wire in the clear
// and still exit 0 -- the fail-open shape this repository forbids. --ftp-ssl-control is the same
// trap one step in: it encrypts the login and leaves the DATA connection clear, so it is likewise
// never emitted. There is no arm of this builder that produces an unencrypted transfer.
//
// -k is emitted ONLY for a modeled unverifiable peer, never as a default, so a device that genuinely
// presents a verifiable certificate is still verified.
fn curl_ftps_upload_command(
  url: String,
  local_path: String,
  netrc_path: FilePath,
  skip_verification: Bool,
) -> ArgvCommand {
  argv_command(
    program: curl_program(),
    arguments: concat(
      ["-fsS", "--ssl-reqd", "--netrc-file", netrc_path as String, "-T", local_path],
      concat(if skip_verification { ["-k"] } else { [] }, [url]),
    ),
  )
}

// --aws-sigv4 LANDED IN curl 7.75.0 (curl.se/docs/manpage.html, "--aws-sigv4 <provider1[:prvdr2[:reg[:srv]]]>",
// "Added in 7.75.0"). The two S3 builders below are unspellable on an older curl, so they name a
// SECOND CliTool whose min_version is this constraint rather than silently raising curl_pinned_version:
// the download and FTPS builders above genuinely need no more than 7.68, and a fleet host that
// carries 7.68 still runs them correctly. curl_cli_tool stays the 7.68 pin; the SigV4 builders
// emit curl_aws_sigv4_cli_tool.program so a 7.68 host that satisfies curl_cli_tool still owes 7.75
// on the path that spells --aws-sigv4.
data curl_aws_sigv4_min_version: VersionConstraint = ">= 7.75"

data curl_aws_sigv4_cli_tool: CliTool = CliTool {
  program: curl_program(),
  min_version: Present { value: curl_aws_sigv4_min_version },
  installable_via: [SourceApt { package: package_curl, bin_dir: apt_bin_dir }],
}

// %header{} IN --write-out LANDED IN curl 7.84.0 (curl.se/docs/manpage.html, "-w, --write-out
// <format>": "header{name}" ... "Added in 7.84.0"). Only the entity-tag-reporting form of the S3
// builders spells it, so it is a THIRD row on the same pattern as the SigV4 one: a host carrying
// 7.75 still runs every status-only S3 transfer, and owes 7.84 only on the path that reads a tag.
data curl_write_out_header_min_version: VersionConstraint = ">= 7.84"

data curl_s3_entity_tag_cli_tool: CliTool = CliTool {
  program: curl_program(),
  min_version: Present { value: curl_write_out_header_min_version },
  installable_via: [SourceApt { package: package_curl, bin_dir: apt_bin_dir }],
}

// THE SIGV4 PROVIDER STRING FOR AN S3-SHAPED ENDPOINT. curl's --aws-sigv4 value is
// provider1[:provider2[:region[:service]]]; "aws:amz" is the algorithm/header prefix pair every
// AWS-signature-compatible store expects, and region and service are the two variables an S3
// clone actually differs on. They are received rather than spelled here, because which region a
// particular store signs under is that store's fact (Cloudflare R2 signs under "auto",
// extdeps.cloudflare.r2 r2_s3_sigv4_region) and this module may not carry one product's value.
fn curl_aws_sigv4_s3_provider(region: NonEmptyStr) -> String {
  join(["aws:amz:", region as String, ":s3"], "")
}

// THE S3 UPLOAD AND DOWNLOAD, SIGNED, WITH THE CREDENTIAL REACHING curl THROUGH A NETRC FILE.
//
// THE CREDENTIAL IS NEVER AN ARGV WORD. --aws-sigv4 documents its credential as --user
// <key>:<secret>, which on this fleet is readable from /proc/PID/cmdline by any co-tenant of the
// runner slot (gunbc.credential_argv_exposure). curl also reads the same login/password pair from
// --netrc-file for the request's host, and signs with it -- measured, not assumed: against a local
// listener, a netrc carrying `machine <host> login <key> password <secret>` produced
// `Authorization: AWS4-HMAC-SHA256 Credential=<key>/...` with no --user on the command line
// (tidy-hawk-349, 2026-09-12). So these builders, like curl_ftps_upload_command above, have NO
// parameter that could carry a secret: the netrc path crosses into argv, the bytes do not.
//
// -f IS LOAD-BEARING ON BOTH. Without it curl exits 0 on a 403 or a 404 and, on the download,
// writes the store's XML error document to the destination -- a "staged object" that is really an
// error page, digested and confirmed downstream. With -f a non-2xx exits 22 and writes NOTHING to
// the destination (measured: a 404 left no file behind), so a staged path either holds the object's
// bytes or does not exist.
//
// THE STATUS IS STILL REPORTED, ON STDOUT, so the caller can tell 404 from 403 without parsing
// stderr prose: -w '%{http_code}' prints the three digits after the transfer, and prints 000 when
// no HTTP status was ever received (connect failure, timeout), which is how a caller separates
// "the store answered" from "nothing answered" -- the distinction gunbc.fabric_m0_commit's
// CommitTransportOutcome exists to keep.
//
// THE CONDITIONAL WRITE IS A PARAMETER, NOT A DEFAULT. If-None-Match: * turns the PUT into
// create-if-absent (RFC 9110 section 13.1.2, honoured by S3-shaped stores that implement
// conditional writes); whether a given object may ever be overwritten is the STORE POLICY of the
// caller, so it is passed in rather than spelled here, and the header goes into SignedHeaders
// (measured: `SignedHeaders=host;if-none-match;...`) so a proxy cannot strip it unsigned.
//
// -T names the local file to upload and the URL names the remote object EXACTLY; the trailing-slash
// directory behaviour curl_ftps_upload_command warns about is avoided the same way, by never
// emitting a URL that ends in "/".
// STATUS-ONLY STDOUT. Pair with `-o` so the transfer body is not on stdout; then this format is
// the whole stdout. ProbeServiceRoot keeps the body on stdout and must not reuse this row.
data curl_http_code_write_out_format: String = "%\{http_code\}"

// BODY THEN STATUS. curl appends a newline and the three-digit code after the body. The last
// newline-delimited line is the status; it is not a trailing-three-character guess.
data curl_http_code_after_newline_write_out_format: String = "\n%\{http_code\}"

type CurlWriteOutHttpStatus
  = CurlWroteHttpStatus { status: HttpStatus }
  | CurlWroteNoHttpStatus { cause: NonEmptyStr }

fn classify_curl_write_out_stdout(stdout: String) -> CurlWriteOutHttpStatus {
  let code = trim(s: stdout)
  match parse_int(s: code) {
    Present { value: n } => match http_status_of(n: n) {
      Present { value: status } => CurlWroteHttpStatus { status: status }
      Absent => CurlWroteNoHttpStatus {
        cause: "curl write-out printed a status outside HTTP's range" as NonEmptyStr,
      }
    }
    Absent => CurlWroteNoHttpStatus {
      cause: "curl write-out stdout was not an HTTP status" as NonEmptyStr,
    }
  }
}

fn classify_curl_http_code_after_newline(stdout: String) -> CurlWriteOutHttpStatus {
  match split(s: stdout, delimiter: "\n").last() {
    Absent => CurlWroteNoHttpStatus {
      cause: "curl wrote no newline-delimited HTTP status" as NonEmptyStr,
    }
    Present { value: line } => classify_curl_write_out_stdout(stdout: line)
  }
}

data curl_if_none_match_any_header: String = "If-None-Match: *"

// If-Match carries the entity tag verbatim as the store returned it, quotes included (RFC 9110
// section 8.8.3: the quotes are part of the entity-tag).
fn curl_if_match_header(tag: ObjectEntityTag) -> String {
  join(["If-Match: ", tag.value as String], "")
}

fn curl_put_precondition_arguments(precondition: ObjectPutPrecondition) -> List<String> {
  match precondition {
    PutUnconditional => []
    PutIfAbsent => ["-H", curl_if_none_match_any_header]
    PutIfMatch { tag: t } => ["-H", curl_if_match_header(tag: t)]
  }
}

// WHAT A TRANSFER REPORTS ON STDOUT. Status alone is the form every existing consumer reads (an
// emitted shell compares the whole stdout to "200"). A store used as a compare-and-set also needs the
// representation's entity tag, the validator its next If-Match must carry, so that form prints the
// tag on a second line from the response header (curl's %header{} write-out variable, curl 7.84.0,
// curl_s3_entity_tag_cli_tool). An absent header
// prints an empty line, which the classifier reads as no tag rather than an empty one.
type S3TransferReport
  = ReportStatus
  | ReportStatusAndEntityTag

data curl_http_code_then_etag_write_out_format: String = "%\{http_code\}\n%header\{etag\}"

fn curl_s3_write_out_format(report: S3TransferReport) -> String {
  match report {
    ReportStatus => curl_http_code_write_out_format
    ReportStatusAndEntityTag => curl_http_code_then_etag_write_out_format
  }
}

fn curl_sigv4_s3_upload_command(
  url: String,
  local_path: String,
  netrc_path: FilePath,
  sigv4_region: NonEmptyStr,
  precondition: ObjectPutPrecondition,
  report: S3TransferReport,
) -> ArgvCommand {
  argv_command(
    program: curl_program(),
    arguments: concat(
      [
        "-fsS",
        "--netrc-file", netrc_path as String,
        "--aws-sigv4", curl_aws_sigv4_s3_provider(region: sigv4_region),
        "-o", "/dev/null",
        "-w", curl_s3_write_out_format(report: report),
      ],
      concat(
        curl_put_precondition_arguments(precondition: precondition),
        ["-T", local_path, url],
      ),
    ),
  )
}

fn curl_sigv4_s3_download_command(
  url: String,
  destination: String,
  netrc_path: FilePath,
  sigv4_region: NonEmptyStr,
  report: S3TransferReport,
) -> ArgvCommand {
  argv_command(
    program: curl_program(),
    arguments: [
      "-fsS",
      "--netrc-file", netrc_path as String,
      "--aws-sigv4", curl_aws_sigv4_s3_provider(region: sigv4_region),
      "-o", destination,
      "-w", curl_s3_write_out_format(report: report),
      url,
    ],
  )
}

// DeleteObject OVER THE SAME SIGV4 BRACKET. -X DELETE on the object URL; the store answers 204 for a
// removed key and, on S3 and R2 alike, 204 for a key that was never there, so a 2xx is "the key is
// absent now", never "this call removed it". Status only on stdout, as ReportStatus prints it.
fn curl_sigv4_s3_delete_command(url: String, netrc_path: FilePath, sigv4_region: NonEmptyStr) -> ArgvCommand {
  argv_command(
    program: curl_program(),
    arguments: [
      "-fsS",
      "--netrc-file", netrc_path as String,
      "--aws-sigv4", curl_aws_sigv4_s3_provider(region: sigv4_region),
      "-X", "DELETE",
      "-o", "/dev/null",
      "-w", curl_http_code_write_out_format,
      url,
    ],
  )
}

// ── PARALLEL TRANSFERS IN ONE INVOCATION ────────────────────────────────────────────────────────
//
// -Z, --parallel performs the command line's transfers concurrently rather than in series (curl.se/docs/
// manpage.html, "-Z, --parallel": "Added in 7.66.0"), and --parallel-immediate makes curl open a new
// connection for every transfer at once instead of waiting to multiplex onto the first ("Added in
// 7.68.0"). Both are GLOBAL options. -:, --next starts a fresh option set for the following URL, so
// every per-transfer option -- the netrc, the SigV4 provider, the precondition header, -o and -w -- is
// repeated after it, and every transfer reads the same netrc file.
//
// WHAT THIS GUARANTEES AND WHAT IT DOES NOT. curl starts the transfers in one pass of its event loop; it
// cannot make the requests overlap. Its per-transfer timing variables (%{time_pretransfer} and kin)
// cannot show whether they did either: each is an offset from that transfer's OWN start (the easy
// handle's progress start), so two transfers' timings share no origin. What does share one is the
// trace: --trace-ascii writes every event of every transfer from the one process, --trace-time stamps
// each event line from that process's wall clock ("Added in 7.14.0"), and --trace-ids prefixes each line
// with the transfer and connection it belongs to ("Added in 8.2.0"). All three are GLOBAL options, so
// they are spelled once, before the first transfer.
//
// THE 8.2 PIN IS THE HIGHEST THIS PATH SPELLS, so it is a row of the same family as the SigV4 (7.75) and
// %header (7.84) rows, and the row a racing path observes.
data curl_trace_ids_min_version: VersionConstraint = ">= 8.2"

data curl_trace_ids_cli_tool: CliTool = CliTool {
  program: curl_program(),
  min_version: Present { value: curl_trace_ids_min_version },
  installable_via: [SourceApt { package: package_curl, bin_dir: apt_bin_dir }],
}

// ONE TRANSFER OF A PARALLEL UPLOAD. label is printed at the head of the transfer's write-out line, so
// a status is attributable to the transfer it belongs to even though -Z prints in completion order and
// every transfer may share one URL; a label must be one word.
type S3ParallelUpload {
  label: NonEmptyStr
  url: String
  local_path: String
  precondition: ObjectPutPrecondition
}

// The per-transfer line: label, then status. %{http_code} is 000 when no response was received.
fn curl_parallel_write_out_format(label: NonEmptyStr) -> String {
  join([label as String, " %\{http_code\}\n"], "")
}

fn curl_sigv4_s3_parallel_upload_arguments(upload: S3ParallelUpload, netrc_path: FilePath, sigv4_region: NonEmptyStr) -> List<String> {
  concat(
    [
      "-fsS",
      "--netrc-file", netrc_path as String,
      "--aws-sigv4", curl_aws_sigv4_s3_provider(region: sigv4_region),
      "-o", "/dev/null",
      "-w", curl_parallel_write_out_format(label: upload.label),
    ],
    concat(curl_put_precondition_arguments(precondition: upload.precondition), ["-T", upload.local_path, upload.url]),
  )
}

fn curl_sigv4_s3_parallel_upload_command(uploads: List<S3ParallelUpload>, netrc_path: FilePath, sigv4_region: NonEmptyStr, trace_path: FilePath) -> ArgvCommand {
  argv_command(
    program: curl_program(),
    arguments: concat(
      ["-Z", "--parallel-immediate", "--trace-ascii", trace_path as String, "--trace-time", "--trace-ids"],
      fold(uploads, init: [], f: (acc, u) => concat(
        if length(acc) == 0 { acc } else { concat(acc, ["--next"]) },
        curl_sigv4_s3_parallel_upload_arguments(upload: u, netrc_path: netrc_path, sigv4_region: sigv4_region),
      )),
    ),
  )
}

fn curl_word_at(words: List<String>, index: Int) -> String {
  match words.skip(n: index).first() {
    Present { value: w } => w
    Absent => ""
  }
}

// WHAT ONE LABELLED TRANSFER REPORTED. Exactly one line must carry the label; none, two, a 000 status
// or an unparseable field is unreported, never a guess.
type CurlParallelTransferReport
  = CurlParallelTransferReported { status: HttpStatus }
  | CurlParallelTransferUnreported { cause: NonEmptyStr }

fn curl_parallel_report_of_fields(fields: List<String>) -> CurlParallelTransferReport {
  if length(fields) != 2 {
    CurlParallelTransferUnreported { cause: "the transfer's write-out line does not have two fields" }
  } else {
    let code = curl_word_at(words: fields, index: 1)
    match parse_int(s: code) {
      Absent => CurlParallelTransferUnreported { cause: join(["the transfer printed no HTTP status: ", code], "") as NonEmptyStr }
      Present { value: n } =>
        match http_status_of(n: n) {
          Absent => CurlParallelTransferUnreported { cause: join(["no HTTP status was received (", code, ")"], "") as NonEmptyStr }
          Present { value: status } => CurlParallelTransferReported { status: status }
        }
    }
  }
}

fn curl_parallel_transfer_report(stdout: String, label: NonEmptyStr) -> CurlParallelTransferReport {
  let lines = filter(map(split(s: stdout, delimiter: "\n"), l => split(s: trim(s: l), delimiter: " ")), ws => curl_word_at(words: ws, index: 0) == label as String)
  if length(lines) == 0 {
    CurlParallelTransferUnreported { cause: join(["no write-out line for transfer ", label as String], "") as NonEmptyStr }
  } else if length(lines) > 1 {
    CurlParallelTransferUnreported { cause: join(["more than one write-out line for transfer ", label as String], "") as NonEmptyStr }
  } else {
    match lines.first() {
      Present { value: fields } => curl_parallel_report_of_fields(fields: fields)
      Absent => CurlParallelTransferUnreported { cause: join(["no write-out line for transfer ", label as String], "") as NonEmptyStr }
    }
  }
}

// ── THE TRACE, READ AS EVENTS ON ONE CLOCK ──────────────────────────────────────────────────────
//
// THE SHAPE --trace-ascii WRITES WITH --trace-time AND --trace-ids. Every event opens with a line
// "HH:MM:SS.uuuuuu [X-C] <direction> <what>, N bytes (0xN)" -- or "== Info: <text>" -- where X is the
// transfer id and C the connection id (x before one exists); the event's bytes follow as dump lines
// "OOOO: <text>", OOOO a hex offset, which carry no stamp. The directions this reader names are
// "=> Send header", "=> Send data" and "<= Recv header"; every other event (TLS data, received data,
// info) is kept as an instant and nothing else.
//
// THE CLOCK IS CHECKED ON EVERY STAMPED LINE. A stamp lower than the line before it -- a wall-clock step
// backwards, or midnight passing -- refuses the whole trace: a backwards step between one transfer's
// answer and the other's send is exactly what could fake an overlap, and nothing in the trace can tell
// that step from a real one. A step forwards can only make requests look further apart, so it is not
// refused.
//
// THE CREDENTIAL. With --aws-sigv4 the request carries an Authorization header naming the access key id
// and an HMAC signature; the SigV4 secret itself is never sent, so it is never traced. The header IS
// traced, so a send-header event's bytes are dropped here and never reach an event: only a send-data
// event keeps its bytes, which are the uploaded body. The trace FILE still holds the header, so it lives
// in a directory the caller minted and removes with its custody.
type CurlTraceEventKind
  = CurlTraceSendHeader
  | CurlTraceSendData
  | CurlTraceRecvHeader
  | CurlTraceOtherEvent

type CurlTraceEvent {
  at: Microsecond
  transfer: NonEmptyStr
  kind: CurlTraceEventKind
  body: List<String>
}

type CurlTraceReading
  = CurlTraceRead { events: List<CurlTraceEvent> }
  | CurlTraceRefused { cause: NonEmptyStr }

// "HH:MM:SS.uuuuuu" as microseconds since midnight on the trace's own clock.
fn curl_trace_time_of_day(text: String) -> Microsecond? {
  let hms = split(s: text, delimiter: ":")
  let sec = split(s: curl_word_at(words: hms, index: 2), delimiter: ".")
  if length(hms) != 3 || length(sec) != 2 || string_length(s: curl_word_at(words: sec, index: 1)) != 6 {
    none
  } else {
    match parse_int(s: curl_word_at(words: hms, index: 0)) {
      Absent => none
      Present { value: h } =>
        match parse_int(s: curl_word_at(words: hms, index: 1)) {
          Absent => none
          Present { value: m } =>
            match parse_int(s: curl_word_at(words: sec, index: 0)) {
              Absent => none
              Present { value: s } =>
                match parse_int(s: curl_word_at(words: sec, index: 1)) {
                  Absent => none
                  Present { value: u } =>
                    match checked_int_to_nat(n: ((h * 60 + m) * 60 + s) * 1000000 + u) {
                      Absent => none
                      Present { value: n } => Present { value: microsecond(count: n) }
                    }
                }
            }
        }
    }
  }
}

fn curl_trace_transfer_of_tag(tag: String) -> NonEmptyStr? {
  if starts_with(s: tag, prefix: "[") == false { none } else {
    let id = curl_word_at(words: split(s: substring(s: tag, start: 1, end: string_length(s: tag)), delimiter: "-"), index: 0)
    if id == "" { none } else { Present { value: id as NonEmptyStr } }
  }
}

fn curl_trace_kind_of(rest: String) -> CurlTraceEventKind {
  if starts_with(s: rest, prefix: "=> Send header,") { CurlTraceSendHeader }
  else if starts_with(s: rest, prefix: "=> Send data,") { CurlTraceSendData }
  else if starts_with(s: rest, prefix: "<= Recv header,") { CurlTraceRecvHeader }
  else { CurlTraceOtherEvent }
}

// A dump line: four hex digits then ": ". Its text is everything after that prefix.
fn curl_trace_dump_text(line: String) -> String? {
  if string_length(s: line) >= 6 && substring(s: line, start: 4, end: 6) == ": " { Present { value: substring(s: line, start: 6, end: string_length(s: line)) } } else { none }
}

type CurlTraceScan {
  events: List<CurlTraceEvent>
  open: CurlTraceEvent?
  last_at: Int
  refused: String
}

fn curl_trace_close(scan: CurlTraceScan) -> List<CurlTraceEvent> {
  match scan.open {
    Absent => scan.events
    Present { value: e } => concat(scan.events, [e])
  }
}

fn curl_trace_step(scan: CurlTraceScan, line: String) -> CurlTraceScan {
  if scan.refused != "" || trim(s: line) == "" { scan } else {
    match curl_trace_dump_text(line: line) {
      Present { value: text } =>
        match scan.open {
          Absent => CurlTraceScan { events: scan.events, open: none, last_at: scan.last_at, refused: "a dump line precedes any event" }
          Present { value: e } =>
            match e.kind {
              CurlTraceSendData => CurlTraceScan { events: scan.events, open: Present { value: CurlTraceEvent { at: e.at, transfer: e.transfer, kind: e.kind, body: concat(e.body, [text]) } }, last_at: scan.last_at, refused: "" }
              CurlTraceSendHeader => scan
              CurlTraceRecvHeader => scan
              CurlTraceOtherEvent => scan
            }
        }
      Absent => {
        let words = split(s: line, delimiter: " ")
        match curl_trace_time_of_day(text: curl_word_at(words: words, index: 0)) {
          Absent => CurlTraceScan { events: scan.events, open: scan.open, last_at: scan.last_at, refused: "a trace line is neither a stamped event nor a dump line" }
          Present { value: at } =>
            if microsecond_count(m: at) < scan.last_at {
              CurlTraceScan { events: scan.events, open: scan.open, last_at: scan.last_at, refused: "the trace clock stepped backwards" }
            } else {
              match curl_trace_transfer_of_tag(tag: curl_word_at(words: words, index: 1)) {
                Absent => CurlTraceScan { events: scan.events, open: scan.open, last_at: scan.last_at, refused: "a stamped trace line names no transfer" }
                Present { value: x } => {
                  let prefix_length = string_length(s: curl_word_at(words: words, index: 0)) + string_length(s: curl_word_at(words: words, index: 1)) + 2
                  let rest = if string_length(s: line) > prefix_length { substring(s: line, start: prefix_length, end: string_length(s: line)) } else { "" }
                  CurlTraceScan {
                    events: curl_trace_close(scan: scan),
                    open: Present { value: CurlTraceEvent { at: at, transfer: x, kind: curl_trace_kind_of(rest: rest), body: [] } },
                    last_at: microsecond_count(m: at),
                    refused: "",
                  }
                }
              }
            }
        }
      }
    }
  }
}

fn curl_trace_reading(trace: String) -> CurlTraceReading {
  let scan = fold(split(s: trace, delimiter: "\n"), init: CurlTraceScan { events: [], open: none, last_at: 0, refused: "" }, f: (acc, l) => curl_trace_step(scan: acc, line: l))
  if scan.refused != "" { CurlTraceRefused { cause: scan.refused as NonEmptyStr } } else { CurlTraceRead { events: curl_trace_close(scan: scan) } }
}

// The one transfer whose sent body carries text, or absent when none or more than one does.
fn curl_trace_transfer_sending(events: List<CurlTraceEvent>, text: NonEmptyStr) -> NonEmptyStr? {
  let carriers = filter(events, e => match e.kind {
    CurlTraceSendData => length(filter(e.body, b => string_contains(s: b, pattern: text as String))) > 0
    CurlTraceSendHeader => false
    CurlTraceRecvHeader => false
    CurlTraceOtherEvent => false
  })
  let ids = fold(carriers, init: [], f: (acc, e) => if length(filter(acc, i => i == e.transfer as String)) > 0 { acc } else { concat(acc, [e.transfer as String]) })
  if length(ids) != 1 { none } else {
    match ids.first() { Present { value: i } => Present { value: i as NonEmptyStr }  Absent => none }
  }
}

fn curl_trace_kind_is(kind: CurlTraceEventKind, want: CurlTraceEventKind) -> Bool {
  match kind {
    CurlTraceSendHeader => match want { CurlTraceSendHeader => true  CurlTraceSendData => false  CurlTraceRecvHeader => false  CurlTraceOtherEvent => false }
    CurlTraceSendData => match want { CurlTraceSendData => true  CurlTraceSendHeader => false  CurlTraceRecvHeader => false  CurlTraceOtherEvent => false }
    CurlTraceRecvHeader => match want { CurlTraceRecvHeader => true  CurlTraceSendHeader => false  CurlTraceSendData => false  CurlTraceOtherEvent => false }
    CurlTraceOtherEvent => match want { CurlTraceOtherEvent => true  CurlTraceSendHeader => false  CurlTraceSendData => false  CurlTraceRecvHeader => false }
  }
}

// The stamps of one transfer's events of one kind, in trace order (the trace is monotone once read).
fn curl_trace_instants(events: List<CurlTraceEvent>, transfer: NonEmptyStr, kind: CurlTraceEventKind) -> List<Microsecond> {
  map(filter(events, e => e.transfer as String == transfer as String && curl_trace_kind_is(kind: e.kind, want: kind)), e => e.at)
}

// ── THE INSTALLED VERSION, READ ─────────────────────────────────────────────────────────────────
//
// A pin carried on a row and never compared is a decoration. curl --version prints "curl M.m.p (...)"
// on its first line (manpage, "-V, --version"); it is read here, compared against the row's own floor
// through extdeps.version.semver, and the observed version is reported whatever the answer.
fn curl_version_command() -> ArgvCommand {
  argv_command(program: curl_program(), arguments: ["--version"])
}

type CurlVersionStanding
  = CurlVersionMeetsPin { observed: SemVerVersion }
  | CurlVersionBelowPin { observed: SemVerVersion, required: VersionConstraint }
  | CurlVersionUnreadable { cause: NonEmptyStr }

fn curl_installed_version(stdout: String) -> SemVerVersion? {
  let first = curl_word_at(words: split(s: stdout, delimiter: "\n"), index: 0)
  let words = split(s: trim(s: first), delimiter: " ")
  if curl_word_at(words: words, index: 0) != "curl" { none } else {
    semver_core_of_dotted(text: curl_word_at(words: split(s: curl_word_at(words: words, index: 1), delimiter: "-"), index: 0))
  }
}

fn curl_version_standing(tool: CliTool, stdout: String) -> CurlVersionStanding {
  match curl_installed_version(stdout: stdout) {
    Absent => CurlVersionUnreadable { cause: "curl --version printed no 'curl M.m.p' first line" }
    Present { value: observed } =>
      match tool.min_version {
        Absent => CurlVersionUnreadable { cause: "the row carries no version floor to compare against" }
        Present { value: c } =>
          match semver_minimum_of_constraint(constraint: c) {
            Absent => CurlVersionUnreadable { cause: join(["the row's constraint is not a '>= M.m' floor: ", c as String], "") as NonEmptyStr }
            Present { value: floor } =>
              match semver_compare(a: observed, b: floor) {
                Less => CurlVersionBelowPin { observed: observed, required: c }
                Equal => CurlVersionMeetsPin { observed: observed }
                Greater => CurlVersionMeetsPin { observed: observed }
              }
          }
      }
  }
}

// CURL'S EXIT STATUS AS THE UPSTREAM NAMES IT (curl.se/docs/manpage.html, EXIT CODES). Only the
// codes a caller acts on are named; any other nonzero status is carried as the number it was, never
// guessed into a named kind. Zero means curl completed the transfer -- with -f absent, an HTTP
// error status is still a completed transfer, and it is the caller's to read.
type CurlExitOutcome
  = CurlTransferCompleted
  | CurlCouldNotResolveHost
  | CurlCouldNotConnect
  | CurlOperationTimedOut
  | CurlTlsHandshakeFailed
  | CurlEmptyReply
  | CurlReceiveFailed
  | CurlExitUnnamed { code: Int }

fn curl_exit_outcome(code: Int) -> CurlExitOutcome {
  match code {
    0 => CurlTransferCompleted
    6 => CurlCouldNotResolveHost
    7 => CurlCouldNotConnect
    28 => CurlOperationTimedOut
    35 => CurlTlsHandshakeFailed
    52 => CurlEmptyReply
    56 => CurlReceiveFailed
    _ => CurlExitUnnamed { code: code }
  }
}

fn curl_exit_outcome_name(outcome: CurlExitOutcome) -> String {
  match outcome {
    CurlTransferCompleted => "transfer completed"
    CurlCouldNotResolveHost => "could not resolve host (curl exit 6)"
    CurlCouldNotConnect => "could not connect (curl exit 7)"
    CurlOperationTimedOut => "operation timed out (curl exit 28)"
    CurlTlsHandshakeFailed => "TLS handshake failed (curl exit 35)"
    CurlEmptyReply => "server sent an empty reply (curl exit 52)"
    CurlReceiveFailed => "failure receiving data (curl exit 56)"
    CurlExitUnnamed { code: c } => join(["curl exit ", to_string(c)], "")
  }
}
