module extdeps.tools.grep

import std.types { NonEmptyStr, Bool, Unit, List, String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.tools { CliTool, SourceCoreutils }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/grep/manual/grep.html"
  }
}

data grep_cli_tool: CliTool = CliTool {
  name: "grep",
  min_version: none,
  installable_via: [SourceCoreutils],
}

service grep.Grep {
  operation MatchesFixedString {
    input { pattern: NonEmptyStr, path: NonEmptyStr }
    output { matches: Bool from "exit_success" }
    readonly
    transport shell { argv: ["grep", "-qF", "{pattern}", "{path}"] }
    exit {
      0 => Unit "pattern found"
      1 => Unit "pattern not found"
    }
  }
}

// ONE FIXED STRING ACROSS SEVERAL FILES, EACH MATCH NAMED BY ITS FILE. grep(1): `-H` prints the file
// name before each matching line as `FILE:LINE`, `-F` reads the pattern as a fixed string. Exit status
// is 0 when any line matched, 1 when none did, and 2 when an error occurred -- including a file that
// could not be opened -- even if other files matched. So the status speaks for the batch, never for a
// file: a consumer must key each file's answer by its own `FILE:` prefix, and a file with no such line
// is unread, not empty.
fn grep_fixed_string_with_filename_argv(pattern: NonEmptyStr, paths: List<NonEmptyStr>) -> List<String> {
  concat(["grep", "-H", "-F", pattern as String], map(paths, p => p as String))
}
