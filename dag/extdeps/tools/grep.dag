module extdeps.tools.grep

import extdeps.exec.program { ProgramIdentity, cataloged_program }

import std.types { NonEmptyStr, Bool, Unit, List, String }
import std.algebra { list_flat_map }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.tools { CliTool, SourceCoreutils }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/grep/manual/grep.html"
  }
}

fn grep_program() -> ProgramIdentity = cataloged_program(invocation: "grep")

data grep_cli_tool: CliTool = CliTool {
  program: grep_program(),
  min_version: none,
  installable_via: [SourceCoreutils],
}

service grep.Grep {
  operation MatchesFixedString {
    requires none
    input { pattern: NonEmptyStr, path: NonEmptyStr }
    output { matches: Bool from "exit_success" }
    readonly
    transport shell { argv: ["grep", "-qF", "{pattern}", "{path}"] }
    exit {
      0 => Unit "pattern found"
      1 => Unit "pattern not found"
    }
  }
}

// THE SAME FIXED STRING UNDER A DIRECTORY TREE, ONE FILE NAME ONLY. grep(1): `-r` reads each file
// under each directory recursively, `--include=GLOB` searches only files whose base name matches
// GLOB, and `-H` prefixes every match with the file it was found in. The glob is matched by grep
// itself over names it walked, never expanded by a shell, so this argv carries no word a remote
// re-parse would have to survive -- which is what lets one read cover a tree whose own directory
// names a transport refuses to carry.
fn grep_fixed_string_in_tree_argv(pattern: NonEmptyStr, file_name: NonEmptyStr, root: NonEmptyStr) -> List<String> {
  ["grep", "-r", "-H", "-F", pattern as String, concat("--include=", file_name as String), root as String]
}

// EVERY NONEMPTY LINE OF THE NAMED FILES UNDER A TREE, as `path:line` rows. `-E .` matches any line
// holding a character, so a cgroup interface file that holds one value prints exactly one row per file,
// keyed by the file's real path -- including a systemd-escaped one, which is printed output here and
// never an argv word. The same walk as grep_fixed_string_in_tree_argv with a pattern that selects the
// file's content rather than a needle.
fn grep_nonempty_lines_in_tree_argv(file_names: List<NonEmptyStr>, root: NonEmptyStr) -> List<String> {
  concat(["grep", "-r", "-H", "-E", "."], concat(map(file_names, n => concat("--include=", n as String)), [root as String]))
}

// WHICH OF THE NAMED FILES HOLD ANY OF THE FIXED STRINGS. grep(1): `-l` prints the name of each file with a
// match instead of the lines, `-F` reads every pattern as a fixed string, and each `-e` adds one. Exit 0:
// some file matched (names printed); 1: none matched; 2: an error, which includes a named file that could
// not be read, so an unread file is never reported as a non-match. `--` ends the options, so a path
// cannot be read as one.
fn grep_files_with_fixed_strings_argv(patterns: List<NonEmptyStr>, paths: List<NonEmptyStr>) -> List<String> {
  concat(concat(["grep", "-l", "-F"], list_flat_map(patterns, p => ["-e", p as String])), concat(["--"], map(paths, p => p as String)))
}
