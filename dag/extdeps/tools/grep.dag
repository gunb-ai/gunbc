module extdeps.tools.grep


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.gnu.org/software/grep/manual/grep.html"
  }
}

data grep_cli_tool: extdeps.tools.CliTool = extdeps.tools.CliTool {
  name: "grep",
  min_version: none,
  installable_via: [extdeps.tools.SourceCoreutils],
}

service grep.Grep {
  operation MatchesFixedString {
    input { pattern: std.types.NonEmptyStr, path: std.types.NonEmptyStr }
    output { matches: Bool from "exit_success" }
    readonly
    transport shell { argv: ["grep", "-qF", "{pattern}", "{path}"] }
    exit {
      0 => Unit "pattern found"
      1 => Unit "pattern not found"
    }
  }
}
