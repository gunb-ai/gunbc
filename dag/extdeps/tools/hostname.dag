module extdeps.tools.hostname

import std.types { String, List, Bool }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.dns.domain_name { DnsLabel }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/hostname.1.html"
  }
}

data extdeps_hostnamectl_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.freedesktop.org/software/systemd/man/latest/hostnamectl.html"
  }
}

fn hostname_short_read_argv() -> List<String> {
  ["hostname", "-s"]
}

fn hostname_set_argv(desired: DnsLabel) -> List<String> {
  ["hostnamectl", "set-hostname", desired as String]
}

service os.Hostname {
  operation ReadShort {
    input {}
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["hostname", "-s"] }
    exit {
      0 => Unit
      nonzero => String "hostname -s failed"
    }
    mock_response {
      0 => { value: "localhost", success: true } "hermetic os.Hostname.ReadShort"
    }
  }

  operation Set {
    input { desired: DnsLabel }
    output {
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["hostnamectl", "set-hostname", "{desired}"] }
    exit {
      0 => Unit
      nonzero => String "hostnamectl set-hostname failed"
    }
    mock_response {
      0 => { success: true, stderr: "" } "hermetic os.Hostname.Set"
    }
  }
}

// PATH-RESOLVED PROGRAM NAME, DELIBERATELY, AND NOT A DECLINE TO SAY WHICH BINARY. An absolute path
// is a CLAIM ABOUT AN OBSERVED FILESYSTEM: extdeps.tools.mkdir and extdeps.tools.chmod record theirs
// because a sudoers NOPASSWD rule names those commands by path on hosts this repository provisions,
// which is an observation with a consumer. This repository has made no such observation for the
// hosts these commands run on -- fleet members, runner images, a BMC -- so writing one here would
// replace a vague spelling with a confident false host fact, which is the fabrication DESIGN section
// 5 forbids rather than an improvement on it. The name is resolved by the target's own PATH, and
// that is what the previous hand-spelled call sites did too: this conversion changes WHERE the
// spelling lives, not WHICH program runs.
data hostname_program: NonEmptyStr = "hostname"

// TWO BUILDERS BECAUSE THEY ANSWER DIFFERENT QUESTIONS. `hostname` prints whatever the host is
// configured to call itself, which may be fully qualified; `hostname -s` prints the first label
// only. A receipt that records identity wants the former, a converge that matches a fleet member's
// short name wants the latter, and collapsing them would silently change which one a caller got.
fn hostname_read_command() -> ArgvCommand {
  argv_command(program: hostname_program, arguments: [])
}

fn hostname_short_read_command() -> ArgvCommand {
  argv_command(program: hostname_program, arguments: ["-s"])
}
