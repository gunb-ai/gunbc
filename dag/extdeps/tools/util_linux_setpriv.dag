module extdeps.tools.util_linux_setpriv

import std.types { NonEmptyStr, String, List, Bool }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// setpriv(1), util-linux: "Sets or queries various Linux privilege settings that are inherited
// across execve(2)." --reuid/--regid set the real and effective uid/gid; --init-groups "initialize
// supplementary groups using initgroups(3)", which is only valid together with --ruid/--reuid; with
// none of --keep-groups, --clear-groups, --init-groups or --groups the caller's supplementary list
// is inherited unchanged. (man7.org, util-linux, read 2026-10-03.) Only the uid/gid drop is modeled.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/setpriv.1.html"
  }
}

// `setpriv --reuid=U --regid=G [--init-groups] -- CMD`. Whether to initialise the supplementary
// groups is the caller's decision; false inherits the caller's list, as upstream documents.
fn setpriv_reuid_regid_argv(user: NonEmptyStr, group: NonEmptyStr, init_groups: Bool, command_argv: List<String>) -> List<String> {
  let ids = ["setpriv", "--reuid=" + (user as String), "--regid=" + (group as String)]
  let with_groups = if init_groups { list_push(ids, "--init-groups") } else { ids }
  let with_separator = list_push(with_groups, "--")
  fold(command_argv, init: with_separator, f: (acc, arg) => list_push(acc, arg))
}
