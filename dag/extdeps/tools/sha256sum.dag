module extdeps.tools.sha256sum

import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.tools { CliTool, SourceCoreutils }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/coreutils/manual/coreutils.html"
  }
}

data sha256sum_cli_tool: CliTool = CliTool {
  name: "sha256sum",
  min_version: none,
  installable_via: [SourceCoreutils],
}

service sha256sum.Sha256 {
  operation CheckFile {
    input { checksum_file: NonEmptyStr }
    output { matches: Bool from "exit_success" }
    readonly
    transport shell { argv: ["sha256sum", "--check", "--status", "{checksum_file}"] }
    exit {
      0 => Unit "checksum matches"
      nonzero => Unit "checksum mismatch or file missing"
    }
  }
}
