module extdeps.tools.chmod


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/chmod.html"
  }
}

// The absolute path exists for the same reason it does in extdeps.tools.chown and
// extdeps.tools.mkdir: a sudoers NOPASSWD rule names a command by path. chmod sits at /bin rather
// than /usr/bin on the hosts this actuator targets, and that is a fact about those hosts recorded
// here rather than assumed at a call site.
data chmod_binary_path: std.types.NonEmptyStr = "/bin/chmod"

// THE SECOND SPELLING WAS NOT A STYLE VARIANT, IT WAS A DISAGREEMENT. gunbc.roadmap_dashboard_
// instance_apply carried "/usr/bin/chmod" twice -- once as the program its install step executes,
// once in the required-executable roster its preflight tests for existence -- while this module,
// the tool's authority, recorded /bin/chmod for the same fleet. Two absolute paths for one binary,
// neither able to see the other, and they coincide today only because these hosts are usrmerged:
// a host fact nobody declared, quietly holding both claims up. Both sites now read this row, so
// the preflight gates the path the actuator actually runs by construction rather than by two
// authors agreeing.
//
// The PATH-resolved name is a different fact and is declared as one, for the reason spelled out at
// length in extdeps.tools.env: an absolute path is a claim about an observed filesystem, and
// asserting one for a remote target this repository has not observed would fabricate it. A caller
// reaching a host we do not model cites this row; a caller reaching one we do cites the path above.
data chmod_path_resolved_program: std.types.NonEmptyStr = "chmod"

// THE SYMBOLIC MODE, NOT AN OCTAL LITERAL. `+x` adds the execute bit to whatever permissions the
// file already carries; an octal mode REPLACES them, so the two are not interchangeable spellings
// of "make it executable" -- one preserves the other bits and one silently decides them. POSIX
// specifies both forms; this module offers the one whose meaning is additive, because that is what
// an ensure means.
fn chmod_add_executable_args(path: String) -> List<String> {
  ["+x", path]
}

// The full argv is DERIVED from the binary path and the argument tail rather than spelled beside
// them, so a caller that needs the two halves separately -- a transport whose shape splits
// bin_path from args -- reaches the same authority as one that needs the whole vector, and the
// mode flag has exactly one home.
fn chmod_add_executable_argv(path: String) -> List<String> {
  concat([chmod_binary_path as String], chmod_add_executable_args(path: path))
}

// THE OCTAL MODE IS ITS OWN OPERATION, not a parameter on the symbolic one. `+x` adds a bit and a
// numeric mode REPLACES every bit, so one builder taking a "mode" string would let a caller write
// the replacing form where the additive one was meant -- the same reason the teardown rm rows are
// three names rather than a flags argument. The caller that needs 0755 on a generated script is
// deciding all nine bits deliberately, and says so by reaching for this name.
// THE PROGRAM IS A PARAMETER BECAUSE THIS MODULE NOW CARRIES TWO SPELLINGS AND THEY ARE TWO FACTS,
// not a default and an override: the row above records the observed /bin/chmod that a sudoers rule
// and a preflight name, and chmod_path_resolved_program records the honest not-knowing for a host
// this repository has not read. A builder that silently picked one would decide that question on
// every caller's behalf and would have changed a live actuation the moment it was introduced --
// gunbc.fleet_converge_plan_cli writes its apply script on a fleet host and cites the resolved row.
// The caller says which claim it is making; neither spelling is this builder's to assume.
fn chmod_set_mode_command(chmod_program: std.types.NonEmptyStr, mode: std.types.NonEmptyStr, path: String) -> extdeps.exec.command.ArgvCommand {
  extdeps.exec.command.argv_command(program: chmod_program, arguments: [mode as String, path])
}
