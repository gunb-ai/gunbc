module extdeps.tools.gnu_coreutils



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.gnu.org/software/coreutils/manual/coreutils.html"
  }
}

data grep_recursive_quiet_flags: std.types.NonEmptyStr = "-rqE"
data grep_recursive_numbered_flags: std.types.NonEmptyStr = "-rnE"

data rm_force_recursive_flags: std.types.NonEmptyStr = "-rf"

data coreutils_docs: std.types.NonEmptyStr = "https://www.gnu.org/software/coreutils/manual/coreutils.html"

data min_coreutils_version: extdeps.version.VersionConstraint = ">= 8.0"

data gnu_coreutils_diff_flags_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "dissolve-on: gnu_coreutils.diff_recursive_flags — deleted fork of diff argv literals; sole authority is extdeps.tools.diffutils shell.Diff.Recursive transport (diff -r \\\{left\\} \\\{right\\}).")
