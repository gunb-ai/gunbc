module extdeps.tools.ldd

import std.types { String, NonEmptyStr, List }
import std.algebra { trim, list_append }
import v2.std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

// glibc's ldd(1): prints each shared object an ELF executable depends on and where the dynamic
// linker resolves it. A dependency the linker cannot find prints as `<soname> => not found`, and
// ldd still exits zero in that case -- so "a library is missing" is read from the OUTPUT, never from
// the exit status.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man1/ldd.1.html"
  }
}

data ldd_program: NonEmptyStr = "ldd"

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tools.ldd",
      decl_name: "ldd_program",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

fn ldd_command(binary: String) -> ArgvCommand {
  argv_command(program: ldd_program, arguments: [binary])
}

data ldd_not_found_marker: String = "=> not found"

// The soname of every `<soname> => not found` line, in output order. A line is read by its marker
// and its first whitespace-separated word, which is exactly the shape glibc prints.
fn ldd_unresolved_sonames(output: String) -> List<String> {
  fold(
    split(output, "\n"),
    init: [],
    f: (acc, line) =>
      if string_contains(s: line, pattern: ldd_not_found_marker) {
        match first(split(trim(s: line), " ")) {
          Present { value: soname } => if trim(s: soname) == "" { acc } else { list_append(left: acc, right: [trim(s: soname)]) }
          Absent => acc
        }
      } else {
        acc
      },
  )
}
