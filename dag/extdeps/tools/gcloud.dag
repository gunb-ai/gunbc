module extdeps.tools.gcloud


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/sdk/docs/install-sdk"
  }
}

data gcloud_pinned_version: VersionConstraint = ">= 470.0.0"

data gcloud_cli_tool: CliTool = CliTool {
  name: "gcloud",
  min_version: Present { value: gcloud_pinned_version },
  installable_via: [SourceApt { package: package_google_cloud_cli }],
}
