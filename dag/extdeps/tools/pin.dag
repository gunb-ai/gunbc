module extdeps.tools.pin

import std.types { NonEmptyStr, String, Bool, Int, ContentHash }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.version { VersionIdentity, VersionConstraint }
import extdeps.tools { CliTool }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/tools"
  }
}

data tool_pin_authority_note: String = "P1 of the hermetic tool-provisioning lane (docs/plans/hermetic-tool-provisioning-design.md). A mechanical tool dependency is a PIN — an exact version identity plus the expected content identity of the binary — never a location and never a range. Both fields are REQUIRED, so a digest-less or range-only pin is unwritable rather than validated (DESIGN section 5 construction, not a post-check). This module deliberately mints NO new digest concept: expected_identity is the same std.types.ContentHash that extdeps.realization.emit_on_demand_host's ResolvedBuildContext.toolchain_identity already carries for the OBSERVED side (#7388, which digests logical name + executable bytes + version-probe output). Pin declares expected, #7388 observes actual, and P2's membership_reconcile value_eq is the comparison between them — one identity concept with two ends, not a second authority. No consumer reads this module yet; P1 is model-before-implement."

data tool_pin_selection_note: String = "The refresh axis, which keeps a pin from being a freeze. Execution ALWAYS resolves an exact identity — there is no moving reference at run time, because resolving 'latest' at execution is nondeterminism at the substrate boundary (v2.std.determinism) and would make two runs of one spec disagree. How the exact identity was CHOSEN is the separable fact: ExactPin is authored directly; TrackedChannel records that the identity was resolved FROM a moving reference (a release channel, 'latest', a semver range) on a stated date, with a declared refresh window. Re-resolution is an explicit action producing a reviewable diff — the Cargo.lock / flake.lock shape. Staleness therefore refuses loudly and countably instead of either floating forward silently (nondeterminism) or sitting unnoticed at a years-old version (the freeze this axis exists to prevent). refresh_window_days is a bare Int day count; dissolve-on: ground it as a calendar Duration beside std.measure's Time magnitudes when a second consumer needs day arithmetic — do not mint a second day wrapper (same discipline as std.measure amortization_months_dissolve_on)."

data tracked_channel_resolution_date_absent_note: String = "TrackedChannel carries the refresh WINDOW but NOT the resolution DATE, and that is a declared gap rather than a design choice — see pin_freshness_fail_closed_note below for why the window is consequently unusable today. An earlier version of this note argued the date was rightly omitted because no fold read it; review 44242 showed that reasoning was backwards. The date is the EVIDENCE, and the correct response to nothing reading it was to make the fold read it, not to drop it. Without the date there is no fact against which currency can be established, which is exactly why every TrackedChannel pin now refuses instead of being decided by a caller-supplied number. Dissolve-on: resolved_on lands here grounded on v2.std.datetime.CalendarDate (a Refined<CalendarDateFields>, so it arrives with a real constructor and validity, never a bare date string) together with the day arithmetic that module still lacks; the window then becomes load-bearing and pin_freshness returns a real fresh/stale decision."

type PinSelection
  = ExactPin
  | TrackedChannel {
      channel: NonEmptyStr
      refresh_window_days: Int
    }

type ToolPin {
  tool_name: NonEmptyStr
  version: VersionIdentity
  expected_identity: ContentHash
  selection: PinSelection
}

type PinFreshness
  = PinFresh
  | PinFreshnessUnderivable { channel: NonEmptyStr }

data pin_freshness_fail_closed_note: String = "CORRECTED after review 44242, which found a real fail-open in the first shape and was right. That version stored no resolution evidence on TrackedChannel and took age_days as a CALLER-SUPPLIED parameter, so the freshness verdict was entirely at the caller's discretion: passing 0 forever admitted a permanently-stale pin, and the design note meanwhile claimed the resolution was 'recorded'. That is DESIGN section 5's exact tell — a check satisfiable by editing the caller while the model lies — and deleting the resolution date as an 'unread field' was the wrong correction; the right one is to make the fold READ it. Grounding it properly needs two things this tree does not have: a carried resolution date, and calendar day arithmetic to derive an age from it. v2.std.datetime models CalendarDate but has NO day-difference, epoch-day, or days-between fn, and has ZERO constructors in use anywhere in the corpus, so deriving an age here would mean both becoming that type's first consumer and forking calendar arithmetic into extdeps — a section 3 fork of a std concern. So P1 does NOT offer a verdict it cannot ground: the fabricable parameter is deleted outright and a TrackedChannel pin is UNDERIVABLE, never fresh, so it can never be admitted. ExactPin is unaffected and remains fully usable (P3's Rust toolchain is an exact pin). Dissolve-on: v2.std.datetime gains day arithmetic and TrackedChannel carries resolved_on: CalendarDate, at which point this arm becomes a real fresh/stale decision derived from stored evidence and an observed date."

fn pin_freshness(pin: ToolPin) -> PinFreshness {
  match pin.selection {
    ExactPin => PinFresh
    TrackedChannel { channel: c, refresh_window_days: _ } =>
      PinFreshnessUnderivable { channel: c }
  }
}

type PinRefusalCause
  = ConstraintIsNotIdentity { constraint: VersionConstraint }
  | PinAbsent
  | FreshnessEvidenceUnavailable { channel: NonEmptyStr }
  | ObservedIdentityMismatch { expected: ContentHash, observed: ContentHash }

type PinAdmission
  = PinAdmitted { pin: ToolPin }
  | PinRefused { tool_name: NonEmptyStr, cause: PinRefusalCause }

data legacy_ingest_none_spelling_blocker_note: String = "DISCOVERED BY EXECUTION while witnessing admit_legacy_cli_tool, and declared rather than dodged (DESIGN section 5: noticing a workaround IS the line-stop signal). The Absent arm below does NOT match a field written with the `none` literal: a `none`-valued optional evaluates to Value::Null and the match reports `non-exhaustive pattern match on: null`, while a field written `Absent` matches fine. This is a live instance of the documented Value::Null open thread — Value::Null is the overloaded None/Absent/miss sentinel — surfaced here by a new consumer. It MATTERS because the corpus overwhelmingly uses the `none` spelling: roughly 568 `: none,` fields against 98 `: Absent,` in dag/ at authoring, and every shipped CliTool row with no version (extdeps.tools.jq, .grep, .sed, .sha256sum, .sleep) is spelled `none`. So this fn is correct on the model and CANNOT yet be run against the real rows: the witness beside it exercises the Absent spelling only, and that limit is stated rather than papered over — a green witness here does not claim corpus coverage. P2 BLOCKER, not P1 debt: ingesting the actual roster needs the Value::Null carrier split (docs/plans/value-null-split.md) or an equivalent grounding of the two spellings onto one representation. Dissolve-on: that split lands, at which point the witness extends to a `none`-spelled row and this note deletes."

data legacy_cli_tool_ingest_note: String = "The discriminating RED for P1, and the migration frontier made countable. EVERY CliTool row in the corpus today refuses conversion to a ToolPin, and that is the correct answer rather than a gap: min_version is extdeps.version.VersionConstraint — a RANGE brand ('>= 7.68') — and a range is not an identity. Two hosts satisfying one range run two different binaries, which is precisely the variance a pin exists to remove, so widening the range into a fabricated identity here would be the absorbing fallback DESIGN section 5 forbids. Absent refuses for the same reason with a distinct cause: no version stated at all is a different deficit from a stated range, and collapsing the two would be a state-space conflation. Each refusal is typed, names its tool, and is countable, so the migration burns down visibly under P4 instead of being silently assumed complete."

fn admit_legacy_cli_tool(tool: CliTool) -> PinAdmission {
  match tool.min_version {
    Present { value: c } =>
      PinRefused {
        tool_name: tool.name,
        cause: ConstraintIsNotIdentity { constraint: c }
      }
    Absent =>
      PinRefused { tool_name: tool.name, cause: PinAbsent }
  }
}

data pin_admission_note: String = "The admission a P2 consumer calls: a pin is admitted only when its freshness is DERIVABLE and its identity matches the observed digest. Freshness is decided before identity deliberately — a pin whose currency cannot be established is refused even when its binary happens to match, because admitting on a coincidental digest match would zero the very signal the refresh axis exists to raise. Today that means every TrackedChannel pin refuses (see pin_freshness_fail_closed_note); ExactPin proceeds to the identity check. Both arms refuse rather than widen; neither substitutes a superset, silently re-resolves, or proceeds on mismatch."

fn admit_pin(pin: ToolPin, observed_identity: ContentHash) -> PinAdmission {
  match pin_freshness(pin: pin) {
    PinFreshnessUnderivable { channel: c } =>
      PinRefused {
        tool_name: pin.tool_name,
        cause: FreshnessEvidenceUnavailable { channel: c }
      }
    PinFresh =>
      if pin.expected_identity == observed_identity {
        PinAdmitted { pin: pin }
      } else {
        PinRefused {
          tool_name: pin.tool_name,
          cause: ObservedIdentityMismatch {
            expected: pin.expected_identity,
            observed: observed_identity
          }
        }
      }
  }
}

data pin_value_eq_note: String = "The bundle member P2 hands to gunbc.membership_reconcile as value_eq. Identity-vs-content split per that spine's authority note: key_of is the TOOL NAME (stable identity), so a version or digest change is a Modified hunk and re-upserts — an ensure that reinstalls in place — rather than a Removed plus Added pair that would tear the tool down and reinstall it. value_eq is therefore presence-plus-content over the pinned version AND the expected identity together: a same-name drift in either field must re-upsert."

fn pin_value_eq(a: ToolPin, b: ToolPin) -> Bool {
  (a.version == b.version) && (a.expected_identity == b.expected_identity)
}

fn pin_key_of(pin: ToolPin) -> NonEmptyStr {
  pin.tool_name
}
