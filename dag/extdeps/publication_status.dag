module extdeps.publication_status

import std.types { Bool, NonEmptyStr, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Publication"
  }
}

data publication_status_hub_note: String = "AN AGNOSTIC SHAPE, AND DELIBERATELY NOTHING ELSE. This hub defines what publication status a cited upstream document can have. It enumerates no documents, names no vendor, dispatches to no authority and stores no consumer coverage: each document module carries its own status VALUE beside its other facts, because whether a document is publicly published is a fact about THAT document — recording that one Ampere specification is public must not require editing a file every other module imports. The rule mapping a status to what this repository may carry is NOT here either: that is a gunbc policy decision rather than an upstream fact, and it lives in the gunbc layer with the operator ruling as its provenance. Fusing either half into the citation vocabulary would put a gunbc decision inside the modules that model other people's authorities."

data publication_status_axis_note: String = "PUBLICATION IS NOT THE SAME QUESTION AS WHERE A FACT SITS INSIDE A DOCUMENT. A module may also classify each fact it needs as stated in running text, stated only inside a figure, or absent — that axis is about a document's interior and belongs to the module reading it. This axis is about the document's exterior: can anyone reach it. The two are kept apart because a fact can be figure-only inside a perfectly public document, and an absent fact stays absent no matter how public the document is."

// The three states are distinguished because they differ in KIND, not only in
// permission. An explicit open licence is a grant the publisher wrote down; a
// public-but-proprietary document is reachable by anyone while carrying a
// restrictive marking that grants nothing; and an access-gated document is
// neither. Two of them map to the same disposition today, and collapsing them
// for that reason would destroy the distinction the day the mapping changes.
type DocumentPublicationStatus
  = PubliclyPublishedUnderOpenLicense {
      license: NonEmptyStr
    }
  | PubliclyPublishedWithRestrictiveMarking {
      marking: NonEmptyStr
    }
  | AccessGatedNotPubliclyPublished {
      gate: NonEmptyStr
    }

fn publication_status_is_publicly_published(status: DocumentPublicationStatus) -> Bool {
  match status {
    PubliclyPublishedUnderOpenLicense { license } => true
    PubliclyPublishedWithRestrictiveMarking { marking } => true
    AccessGatedNotPubliclyPublished { gate } => false
  }
}

// A restrictive marking is a RECORDED ATTRIBUTE that decides nothing on its
// own; this projection exists so a consumer can report the marking without any
// path by which the marking becomes a verdict.
fn publication_status_restrictive_marking(status: DocumentPublicationStatus) -> NonEmptyStr? {
  match status {
    PubliclyPublishedUnderOpenLicense { license } => Absent
    PubliclyPublishedWithRestrictiveMarking { marking } => Present { value: marking }
    AccessGatedNotPubliclyPublished { gate } => Absent
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.publication_status",
      decl_name: "DocumentPublicationStatus",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
