module extdeps.zhipu.glm_5_3_flash

import std.types { NonEmptyStr, String, Bool, List }
import std.nat { Nat }
import std.measure { TokenCount, token_count, token_count_value,
  ByteSize, byte_size, byte_size_count,
  Gibibyte, gibibyte, Mebibyte, mebibyte, Second, second,
  gibibyte_scale_factor_bytes,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import v2.std.optional { Present, Absent }

// THE GLM-5.3-FLASH FAMILY, as its own extdeps authority for the reason extdeps.deepseek.deepseek_v4
// is one: an independently versioned upstream model, governed by Z.ai, is not a property of whatever
// happens to serve it. The two modules are peers and neither may answer for the other -- which is the
// whole point of authoring this one rather than repointing the harness's DeepSeek import, since a
// repointed import is the same fork under a new name.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "huggingface.co/zai-org/GLM-5.3-Flash",
  }
}

// THE MODEL IDENTITY, from the vLLM recipe's own --served-model-name. This is the single spelling of
// WHICH MODEL; a serving realization that wants a different alias declares an alias beside this row
// rather than a second name for the same subject.
data glm_5_3_flash_model_id: NonEmptyStr = "zai-org/GLM-5.3-Flash" as NonEmptyStr

// THE CONTEXT CEILING AND THE EVALUATED DEPTH ARE TWO FACTS, and carrying only the first is how a
// ceiling gets read as a capability -- the same distinction deepseek_v4 draws between its 1M scaled
// ceiling and its 64K native window. The model card states a 1,048,576-token input context; its
// published long-context evaluations run to 300,000 tokens. A consumer sizing a working window is
// entitled to the ceiling and is NOT entitled to treat the span above the evaluated depth as
// characterised.
data glm_5_3_flash_context_length: TokenCount = token_count(count: 1048576)

// THE REASONING WIRE.
//
// THINKING IS UNCONDITIONAL ON THIS MODEL, WHICH IS THE STRUCTURAL DIFFERENCE FROM DEEPSEEK V4 AND
// THE REASON A HARNESS MUST ASK A SEAM RATHER THAN A LITERAL. DeepSeek's three modes include a
// non-think mode reached by SENDING NOTHING; GLM-5.3-Flash's generation prompt opens the think block
// unconditionally and reasoning_effort DEFAULTS TO max when the key is absent. So the two models
// give the empty request opposite meanings: on DeepSeek, omission is the fast path; here, omission is
// the deepest one. A harness carrying DeepSeek's "send nothing for non-think" rule to this model
// would silently request maximum reasoning while believing it had turned it off -- the exact class of
// error that produced twenty-three zero-thinking rounds in the other direction on 2026-09-04.
//
// THERE IS NO OFF. `low` is the floor, and the model card states it as a reduction rather than a
// disable. A consumer wanting no reasoning at all must be refused, not approximated.
type GlmReasoningEffort = GlmEffortLow | GlmEffortHigh | GlmEffortMax

fn glm_5_3_flash_reasoning_effort_wire(effort: GlmReasoningEffort) -> NonEmptyStr {
  match effort {
    GlmEffortLow => "low" as NonEmptyStr
    GlmEffortHigh => "high" as NonEmptyStr
    GlmEffortMax => "max" as NonEmptyStr
  }
}

// THE REQUEST KEYS THE CHAT TEMPLATE RECOGNISES, carried under chat_template_kwargs on the OpenAI
// chat-completions shape exactly as the vLLM recipe sends them. Note that GLM has no boolean
// thinking switch at all: where DeepSeek carries `thinking`, this model carries only an effort and a
// history control. The two kwarg vocabularies are disjoint, which is why they cannot share a row.
data glm_5_3_flash_reasoning_effort_kwarg: NonEmptyStr = "reasoning_effort" as NonEmptyStr

data glm_5_3_flash_clear_thinking_kwarg: NonEmptyStr = "clear_thinking" as NonEmptyStr

data glm_5_3_flash_thinking_end_token: NonEmptyStr = "</think>" as NonEmptyStr

data glm_5_3_flash_chat_reasoning_field: NonEmptyStr = "reasoning_content" as NonEmptyStr

// WHAT THE vLLM RECIPE PRESCRIBES.
//
// These are upstream's own serving prescriptions for this model, cited to recipes.vllm.ai, and they
// are facts about the model's shape rather than tuning this repository chose.
//
// THE KV DTYPE IS A WIRE VALUE AND NOT A STORAGE FORMAT, AND AN EARLIER REVISION HERE CONFUSED THE
// TWO IN THE MOST INSTRUCTIVE POSSIBLE DIRECTION. It reasoned FROM this flag TO the architecture:
// `fp8` is not `fp8_ds_mla`, `fp8_ds_mla` is the Multi-head Latent Attention layout, therefore this
// model is not MLA. The flag was right and the inference was backwards. Measured on the running
// canary 2026-09-08, the engine is launched with `--kv-cache-dtype fp8` and then reports
// `Using fp8_ds_mla KV cache format for FLASHINFER_MLA_SPARSE_SM120 backend` -- it DERIVES the MLA
// storage format from the architecture it found in the checkpoint, and the wire value never named it.
//
// SO THE VALUE BELOW IS CORRECT AND ITS OLD JUSTIFICATION WAS NOT, which is the more dangerous
// failure of the two: a wrong row is caught the first time it is used, while a right row resting on
// a wrong reason silently licenses every further conclusion drawn from that reason -- as it did one
// declaration further down, where it was read off as a claim about the attention mechanism itself.
// The two facts are separated here so no future reader can travel between them again: this is what
// is PASSED, and what the engine SELECTS is a realization fact recorded where the runtime is.
data glm_5_3_flash_vllm_kv_cache_dtype_wire: NonEmptyStr = "fp8" as NonEmptyStr

data glm_5_3_flash_vllm_tool_call_parser: NonEmptyStr = "glm47" as NonEmptyStr

// THE RECIPE NAMES A REASONING PARSER, AND WHETHER A GIVEN ENGINE BUILD HAS IT IS A DIFFERENT FACT.
// This row records what upstream prescribes; it is NOT a claim that any particular deployment can
// honour it. Measured 2026-09-08 on this fleet's pinned image (vLLM 0.21.1rc1.dev339+g1967a5627bc3):
// no GLM reasoning parser is present, while the glm47 tool parser is. The consumer that must decide
// what a completion looks like therefore asks the SERVING UNIT
// (gunbc.harness.harness_reasoning_wire harness_unit_server_parses_reasoning), never this row.
data glm_5_3_flash_vllm_reasoning_parser: NonEmptyStr = "glm45" as NonEmptyStr

data glm_5_3_flash_vllm_integration_commit: NonEmptyStr = "385dce36bcee42309924a5ece951a96db3dce7f2" as NonEmptyStr

// THE ENGINE READY TIMEOUT IS UPSTREAM'S BASE ENVIRONMENT FOR THIS MODEL, not a tuning knob, and it
// is carried because its absence is independently fatal on a cold multi-node start. torch's
// distributed rendezvous defaults to 601 seconds; a four-rank group whose members are still
// materialising exceeds that and dies with "Timed out waiting for clients", which is a different
// failure from anything about the model and reports nothing about it.
data glm_5_3_flash_vllm_engine_ready_timeout: Second = second(count: 3600)

// A COMPATIBILITY GUARD FOR THIS HARDWARE, CITED TO AN UPSTREAM REPORT RATHER THAN TO THE RECIPE.
// vllm-project/vllm#55569 reports unified-memory exhaustion on a GB10 at roughly 230K context, from
// sparse-indexer logits allocation, with two independent mitigations offered. That report used a
// different GLM quantisation and tensor-parallel shape, so it is a RELEVANT RISK for this arm and not a
// measurement of it -- which is why the figure is carried here as an upstream observation and the
// decision to apply it is a deployment's own.
data glm_5_3_flash_gb10_sparse_indexer_max_logits: Mebibyte = mebibyte(count: 64)

// ── THE CHECKPOINT MANIFEST AT AN EXACT REVISION, WHICH IS UPSTREAM'S OWN STATEMENT ───────────
//
// THE SAME SIZE WAS SPELLED IN THREE PLACES BEFORE THIS ROW EXISTED: the serving selector carried
// 328,337,455,672 bytes in an artifact footprint, the acquisition module carried the identical
// literal as a disk requirement, and the serving-arm authority carried 306 as GiB. They agreed after
// rounding, which is the most dangerous state for a fork -- nothing was wrong, so nothing would have
// caught the first divergence. That is the section 3 violation, and it is mine: I added the second
// and third spellings while repairing other findings.
//
// THE MANIFEST BELONGS HERE RATHER THAN IN gunbc BECAUSE IT IS NOT AN OBSERVATION OF THIS FLEET. The
// byte sizes at a content-addressed revision are what the publishing Hub says about its own files,
// re-readable by anyone from the cited authority. What a Spark's disk holds after a download IS a
// fleet observation and stays in the gunbc layer, which is exactly the distinction the selector's
// FootprintObservedOnFleet and FootprintDeclaredByUpstreamAtRevision arms draw.
//
// THE REVISION IS PART OF THE FACT, not a note beside it. A manifest without its revision is a claim
// about a branch, and this repository is moving: the same API response that gave these sizes reported
// lastModified 2026-09-07T12:13:47Z, so `main` for this repo demonstrably shifts under a reader.
// THE ACQUISITION FOOTPRINT AND THE WEIGHT FOOTPRINT ARE DIFFERENT QUESTIONS ABOUT ONE MANIFEST, and
// a consumer that confuses them sizes a disk against the wrong number. `safetensors_bytes` is what
// the RANKS must hold -- the shards a tensor-parallel replica divides among itself. What a DOWNLOAD
// must hold is the repository snapshot: config, tokenizer, generation config and the rest travel with
// the shards, and the Hub cache fetches the snapshot rather than a hand-picked subset.
//
// The gap is 28,717,797 bytes for this artifact, which changes no eligibility decision on a
// multi-terabyte disk. It is separated anyway, because the carrier's job is to say which quantity a
// consumer is asking for, and a 28 MB coincidence today is not a reason to conflate two questions
// that will diverge on the next artifact.
type GlmCheckpointManifest sole_constructor {
  revision: NonEmptyStr
  safetensors_shard_count: Nat
  safetensors_bytes: ByteSize
  repository_total_bytes: ByteSize
  read_by: NonEmptyStr
}

data glm_5_3_flash_native_manifest: GlmCheckpointManifest = GlmCheckpointManifest {
  revision: "eb9eb208eb0d988989d07a6a12d0fdeb5f52574a" as NonEmptyStr,
  safetensors_shard_count: 62,
  safetensors_bytes: byte_size(count: 328337455672),
  repository_total_bytes: byte_size(count: 328366173469),
  read_by: "the Hub model API for zai-org/GLM-5.3-Flash at that exact revision with blobs enabled, summed over the safetensors siblings, read 2026-09-08. The response's own sha matched the revision and its lastModified was 2026-09-07T12:13:47Z" as NonEmptyStr,
}

// GiB IS DERIVED FOR PROSE AND IS NOT A SECOND AUTHORITY. The serving-arm row that carried 306 was a
// rounded restatement of these bytes; a consumer wanting a human-sized number computes it here rather
// than authoring one, so the rounding can never drift from the figure it rounds.
//
// AND IT ROUNDS UP, WHICH IS THE ONLY SAFE DIRECTION FOR A CONSUMER THAT SCREENS ON IT. The first
// version of this helper used integer division, yielding 305 for a 305.79 GiB artifact -- and
// gunbc.spark.serving_arm feeds exactly this value into a positive fit check. Rounding DOWN
// understates the weights, which makes that check more permissive: it is the wrong direction for a
// bound whose entire purpose is to refuse. A ceiling can only refuse a candidate that a byte-exact
// test would have admitted, never admit one it would have refused.
//
// A CONSUMER THAT NEEDS EXACTNESS READS THE BYTES. This helper exists for screening and for prose,
// and both are served by the conservative direction; feasibility arithmetic that must be exact takes
// `safetensors_bytes` and does not round at all.
fn glm_manifest_gibibytes(m: GlmCheckpointManifest) -> Gibibyte {
  let scale = gibibyte_scale_factor_bytes()
  gibibyte(count: (byte_size_count(b: m.safetensors_bytes) + (scale - 1)) / scale)
}
