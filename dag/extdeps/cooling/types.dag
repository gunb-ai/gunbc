module extdeps.cooling.types


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Computer_cooling"
  }
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.cooling.types",
      decl_name: "CpuCoolerCatalogRow",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// supported_motherboards is grounded on the existing BaseboardModel authority rather than a bare
// string: a cooler's supported-board population is a set of the same board identities the fleet
// already binds, so comparing them must not route through label spelling. It was
// List<NonEmptyStr> carrying "ALTRAD8UD-1L2T", which matched neither the BaseboardModel arm nor
// the catalog model_label "ASRock Rack ALTRAD8UD-1L2T" — a String leaf hiding a named part,
// decomposed here at its first consumer, product.cooling_qualification.
type CpuCoolerCatalogRow {
  model: std.types.NonEmptyStr
  manufacturer: extdeps.vendor.Vendor<extdeps.hardware.Hardware>
  socket: extdeps.cpu.types.CpuSocket
  active_passive_switchable: Bool
  minimum_rack_units: std.measure.RackUnit
  max_design_power: std.measure.Watt
  supported_motherboards: List<extdeps.boards.types.BaseboardModel>
}
