module extdeps.illumination.minions

import std.types { List, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// The named Minions of Illumination's Despicable Me franchise, as the fan wiki's "Minions" category
// enumerates them. The studio publishes no roster, so the wiki category is the authority cited; it was
// read 2026-10-08 through the MediaWiki API (list=categorymembers, cmtitle=Category:Minions,
// cmlimit=500), which returned 485 members with no continuation, so the read is the whole category.
//
// WHAT IS VENDORED: one entry per distinct first name, in the category's own order. Pages that name
// no individual Minion (the species page, "Evil Minions", "Mega Minions", "Pit Crew", "Holiday
// Minion", "Traveling Sales Minion", "Unnamed Referee Minion", "Minionese", trivia, biography and
// group pages, subcategories) are excluded; a disambiguating suffix such as "(Despicable Me 2)" or
// "Jr." is dropped, so several Minions sharing a name are one entry. Spellings are folded to
// lowercase ASCII letters -- accents removed, punctuation and spaces dropped ("Francois" from
// François, "jeanluc" from Jean-Luc) -- so every entry is a legal DNS label. A later read is a new
// list beside this one, never an edit to it.

data minions_fandom_category_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "despicableme.fandom.com/wiki/Category:Minions"
  }
}

