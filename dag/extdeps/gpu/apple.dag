module extdeps.gpu.apple



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.apple.com/macbook-pro/specs/"
  }
}

data apple_m5_gpu_catalog: GpuModelCatalogRow = GpuModelCatalogRow {
  vendor: apple,
  model: "Apple M5 GPU",
  microarchitecture: "Apple GPU",
  execution_lane_count: hardware_thread_count(10),
  memory: MemoryFacts {
    capacity: gibibyte_to_byte_size(g: gibibyte(count: 16)),
    memory_kind: UnifiedShared,
  },
  memory_bandwidth: bandwidth(count: 153000000000),
  boost_clock: none,
  tdp_watts: none,
  compute_capability: none,
  supported_runtimes: [Metal],
  interconnect: none,
  sm_cache: none,
  sm_cache_citations: [],
}
