module extdeps.gpu.apple

import extdeps.gpu.types { GpuModelCatalogRow, GpuRuntime, Metal }
import extdeps.memory.types { MemoryFacts, UnifiedShared }
import extdeps.vendor.apple { apple }
import std.measure { hardware_thread_count, bandwidth, gibibyte, gibibyte_to_byte_size }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.apple.com/macbook-pro/specs/"
  }
}

data apple_m5_gpu_capacity_grounding_note: String = "Apple M5 GPU shares system unified memory (no dedicated VRAM); capacity is configurable. 16 GiB is the published BASE unified-memory configuration of the M5 MacBook Pro. TDP is not separately published for the integrated GPU, so tdp_watts is omitted (none) rather than fabricated. Boost clock is not published, so boost_clock is omitted (none). Apple publishes no CUDA compute-capability level, so compute_capability is none."

data apple_m5_gpu_catalog: GpuModelCatalogRow = GpuModelCatalogRow {
  vendor: apple,
  model: "Apple M5 GPU",
  microarchitecture: "Apple GPU",
  execution_lane_count: hardware_thread_count(10),
  memory: MemoryFacts {
    capacity: gibibyte_to_byte_size(g: gibibyte(count: 16)),
    memory_kind: UnifiedShared,
  },
  memory_bandwidth: bandwidth(count: 153000000000),
  boost_clock: none,
  tdp_watts: none,
  compute_capability: none,
  supported_runtimes: [Metal],
}
