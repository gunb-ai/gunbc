module extdeps.gpu.apple



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.apple.com/macbook-pro/specs/"
  }
}

data apple_m5_gpu_catalog: extdeps.gpu.types.GpuModelCatalogRow = extdeps.gpu.types.GpuModelCatalogRow {
  vendor: extdeps.vendor.apple.apple,
  model: "Apple M5 GPU",
  microarchitecture: "Apple GPU",
  execution_lane_count: std.measure.hardware_thread_count(10),
  memory: extdeps.memory.types.MemoryFacts {
    capacity: std.measure.gibibyte_to_byte_size(g: std.measure.gibibyte(count: 16)),
    memory_kind: extdeps.memory.types.UnifiedShared,
  },
  memory_bandwidth: std.measure.bandwidth(count: 153000000000),
  boost_clock: none,
  tdp_watts: none,
  compute_capability: none,
  supported_runtimes: [extdeps.gpu.types.Metal],
  interconnect: none,
  sm_cache: none,
  sm_cache_citations: [],
}
