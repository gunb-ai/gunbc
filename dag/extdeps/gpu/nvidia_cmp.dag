  gpu: nvidia_cmp_40hx_catalog,
  composition: SingleGpu,
  attachment: PcieAddInBoard { link: none },
  board_power: Present { value: RatedBoardPower { rated: watt(count: 185) } },
  zero_power: none,
  thermal: none,
  pci_device_id: Present { value: "1f0b" as PciDeviceId },
  driver_listed_name: Present { value: "NVIDIA CMP 40HX" },
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_cmp", decl_name: "nvidia_cmp_40hx_board_facts", field_name: "board_power"), authority: cmp_product_page_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_cmp", decl_name: "nvidia_cmp_40hx_board_facts", field_name: "pci_device_id"), authority: nvidia_linux_driver_supported_chips_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_cmp", decl_name: "nvidia_cmp_40hx_board_facts", field_name: "driver_listed_name"), authority: nvidia_linux_driver_supported_chips_authority },
