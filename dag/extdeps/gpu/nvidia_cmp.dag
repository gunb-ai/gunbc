module extdeps.gpu.nvidia_cmp

import std.types { List, NonEmptyStr }
import std.optional { Present }
import std.measure { watt, gibibyte, gibibyte_to_byte_size }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_field_ref }
import extdeps.gpu.types { GpuDeviceCatalogRow, GpuBoardCatalogFacts, GpuBoardAdmission, admit_gpu_board, Cuda, PcieAddInBoard, RatedBoardPower, SingleGpu }
import extdeps.memory.types { MemoryFacts, Dram }
import extdeps.pci.identity { PciDeviceId }
import extdeps.vendor.nvidia { nvidia }
import extdeps.nvidia.linux_driver_supported_chips { nvidia_linux_driver_supported_chips_authority }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, FactCitation }
import extdeps.uri { Uri, Https }

// NVIDIA CMP (Cryptocurrency Mining Processor) boards. NVIDIA's CMP page, specifications table, read
// 2026-10-28, states for the 30HX / 40HX / 50HX / 90HX: rated power 125 / 185 / 250 / 320 W, power connectors
// 1x / 1x / 2x / 2x 8-pin, and memory 6 / 8 / 10 / 10 GB. Its footnote says the rated power and connectors
// are "specified for the reference design. Partner board designs may choose a different configuration",
// and the page says the boards are "available from authorized partners". So each board below is NVIDIA's
// REFERENCE design; a partner board is its own board row when one is read. The page states no bandwidth,
// core count, memory type or PCIe link, so those are Absent (memory_kind is Dram, the class of every CMP
// part, not a cited GDDR generation). The die is the PCI ID Repository's (pci.ids at commit 6bf2473:
// 2189 TU116, 1f0b TU106, 1e09 TU102, 220d GA102); the architecture is the die prefix's (TU Turing, GA
// Ampere), which no page read states. Power connectors are not modelled on the board yet, so the page's
// connector column is read here and not carried.
//
// NOT HERE: the CMP 70HX (driver device 248a, GA104) and the CMP 170HX (pci.ids 20c2, GA100) are on no NVIDIA
// page read, so they have no catalog row; the 170HX's factory memory is not stated anywhere read. A
// community firmware modification that exposes more of its memory is a receipt about a modified board,
// never a property of NVIDIA's product, and is not a row here either.

data cmp_product_page_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nvidia.com/en-us/cmp/"
  }
}

data pci_ids_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "raw.githubusercontent.com/pciutils/pciids/6bf2473e60693bcc2d8e778da53034678f4ace55/pci.ids"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.gpu.nvidia_cmp", decl_name: "nvidia_cmp_board_catalogs", field: WholeDeclaration
  } },
  first_citation: cmp_product_page_authority,
  further_citations: [pci_ids_authority]
}

data nvidia_cmp_30hx_catalog: GpuDeviceCatalogRow = GpuDeviceCatalogRow {
  vendor: nvidia,
  model: "CMP 30HX",
  microarchitecture: "Turing",
  execution_lane_count: none,
  memory: MemoryFacts { capacity: gibibyte_to_byte_size(g: gibibyte(count: 6)), memory_kind: Dram },
  memory_bandwidth: none,
  boost_clock: none,
  compute_capability: none,
  supported_runtimes: [Cuda],
  sm_cache: none,
  sm_cache_citations: [],
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_cmp", decl_name: "nvidia_cmp_30hx_catalog", field_name: "memory"), authority: cmp_product_page_authority },
  ],
  dense_tensor_throughput: [],
}

data nvidia_cmp_30hx_board_facts: GpuBoardCatalogFacts = GpuBoardCatalogFacts {
  vendor: nvidia,
  model: "CMP 30HX reference design",
  gpu: nvidia_cmp_30hx_catalog,
  composition: SingleGpu,
  attachment: PcieAddInBoard { link: none },
  board_power: Present { value: RatedBoardPower { rated: watt(count: 125) } },
  zero_power: none,
  thermal: none,
  pci_device_id: Present { value: "2189" as PciDeviceId },
  driver_listed_name: Present { value: "NVIDIA CMP 30HX" },
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_cmp", decl_name: "nvidia_cmp_30hx_board_facts", field_name: "board_power"), authority: cmp_product_page_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_cmp", decl_name: "nvidia_cmp_30hx_board_facts", field_name: "pci_device_id"), authority: nvidia_linux_driver_supported_chips_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_cmp", decl_name: "nvidia_cmp_30hx_board_facts", field_name: "driver_listed_name"), authority: nvidia_linux_driver_supported_chips_authority },
  ],
}

data nvidia_cmp_30hx_board_catalog: GpuBoardAdmission = admit_gpu_board(facts: nvidia_cmp_30hx_board_facts)

