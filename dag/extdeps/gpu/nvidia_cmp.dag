// Every board this module declares, in declaration order: the roster test.claim.gpu_board_catalog_witness
// requires to be admitted, and this module's model-scope subject.
data nvidia_cmp_board_catalogs: List<GpuBoardAdmission> = [nvidia_cmp_30hx_board_catalog, nvidia_cmp_40hx_board_catalog, nvidia_cmp_50hx_board_catalog, nvidia_cmp_90hx_board_catalog]
