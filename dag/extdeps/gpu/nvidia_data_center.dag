module extdeps.gpu.nvidia_data_center

import std.types { List, NonEmptyStr }
import std.measure { hardware_thread_count, bandwidth, hertz, watt, gibibyte, gibibyte_to_byte_size }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_field_ref }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, FactCitation, TranscribedUncited }
import extdeps.gpu.types { GpuModelCatalogRow, GpuCatalogTranscription, GpuOnMultiGpuBoard, PcieAddInCard, SxmModule, GpuComputeCapability, Cuda }
import extdeps.memory.types { MemoryFacts, Dram, Hbm }
import extdeps.storage.types { PcieLink, Gen1, Gen2, Gen3, Gen4, Gen5 }
import extdeps.vendor.nvidia { nvidia }
import extdeps.gpu.nvidia { nvidia_b200_sxm_catalog, nvidia_b300_sxm_catalog, nvidia_h200_nvl_catalog, nvidia_rtx_pro_6000_server_catalog }
import extdeps.gpu.nvidia_a16 { nvidia_a16_gpu_catalog }

// THE NVIDIA DATA-CENTER ACCELERATORS (TESLA, A/H/L/B SERIES, CMP MINING BOARDS) THIS REPOSITORY KNOWS OF: ONE ROW PER CARD, the census a market or capacity analysis
// reads instead of the handful of cards someone happened to look at. Selection rule, applied to every
// source the same way: released 2011 or later, at least 8 GB of memory PER GPU (a multi-GPU board's row
// is one of its GPUs, package GpuOnMultiGpuBoard), and a discrete card or accelerator module -- not a
// laptop part, console, SoC, MXM or Apple MPX module, vGPU profile, or unreleased engineering name.
//
// WHERE EACH FIGURE CAME FROM, and the standing it therefore has:
//   - Enumeration and the figures no citation names: the dbgpu 2025.12 Python package's snapshot of
//     TechPowerUp's GPU database (MIT-licensed code; TechPowerUp blocks scripted reads, so the pages
//     themselves were not read). Those figures are second-hand and each row's GpuCatalogTranscription
//     entry below says so, with the page that would ground it.
//   - memory, memory_bandwidth and tdp_watts are CitedToAuthority to a Wikipedia revision (permalink
//     by oldid, so the citation cannot drift) ONLY where that revision states the same figure as the
//     snapshot. Where the two disagree, the field is Absent (bandwidth, TDP) and the transcription
//     entry records both readings: two sources disagreeing is not a figure, and a datasheet decides it.
//   - Rows already modeled elsewhere in extdeps.gpu are imported, never re-authored.
// Compute capability on NVIDIA rows is the CUDA programming guide's per-architecture table read by
// GPU die (extdeps.gpu.types cuda_compute_capabilities_authority), as the RTX 5090 row reads it.
// supported_runtimes is [Cuda] on NVIDIA rows and empty elsewhere: ROCm, oneAPI and Vulkan support is
// per-SKU and per-release, and no support matrix has been read into this module.

data wikipedia_list_of_nvidia_gpus_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/w/index.php?title=List_of_Nvidia_graphics_processing_units&oldid=1382053701"
  }
}

data rtx_pro_4500_server_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nvidia.com/en-us/data-center/rtx-pro-4500-blackwell-server-edition/"
  }
}

data extdeps_external_authority_anchor: ExternalAuthority = wikipedia_list_of_nvidia_gpus_authority

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.gpu.nvidia_data_center", decl_name: "nvidia_data_center_catalog_rows", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data nvidia_rtx_pro_4500_blackwell_server_edition_catalog: GpuModelCatalogRow = GpuModelCatalogRow {
  vendor: nvidia,
  model: "RTX PRO 4500 Blackwell Server Edition",
  microarchitecture: "Blackwell",
  package: PcieAddInCard,
  execution_lane_count: Present { value: hardware_thread_count(10496) },
  memory: MemoryFacts {
    capacity: gibibyte_to_byte_size(g: gibibyte(count: 32)),
    memory_kind: Dram,
  },
  memory_bandwidth: Present { value: bandwidth(count: 800000000000) },
  boost_clock: none,
  tdp_watts: Present { value: watt(count: 165) },
  compute_capability: Present { value: GpuComputeCapability { vendor: nvidia, major: 12, minor: 0 } },
  supported_runtimes: [Cuda],
  interconnect: Present { value: PcieLink { generation: Gen5, lane_count: 16 } },
  sm_cache: none,
  sm_cache_citations: [],
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_data_center", decl_name: "nvidia_rtx_pro_4500_blackwell_server_edition_catalog", field_name: "execution_lane_count"), authority: rtx_pro_4500_server_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_data_center", decl_name: "nvidia_rtx_pro_4500_blackwell_server_edition_catalog", field_name: "memory"), authority: rtx_pro_4500_server_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_data_center", decl_name: "nvidia_rtx_pro_4500_blackwell_server_edition_catalog", field_name: "memory_bandwidth"), authority: rtx_pro_4500_server_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_data_center", decl_name: "nvidia_rtx_pro_4500_blackwell_server_edition_catalog", field_name: "tdp_watts"), authority: rtx_pro_4500_server_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_data_center", decl_name: "nvidia_rtx_pro_4500_blackwell_server_edition_catalog", field_name: "interconnect"), authority: rtx_pro_4500_server_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_data_center", decl_name: "nvidia_rtx_pro_4500_blackwell_server_edition_catalog", field_name: "microarchitecture"), authority: rtx_pro_4500_server_authority },
