  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_workstation", decl_name: "nvidia_quadro_k6000_catalog", field_name: "memory"), authority: wikipedia_list_of_nvidia_gpus_authority },
