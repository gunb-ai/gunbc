module extdeps.gpu.nvidia_k80

import std.types { List, NonEmptyStr }
import std.optional { Present }
import std.measure { hardware_thread_count, bandwidth, watt, gibibyte, gibibyte_to_byte_size }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_field_ref }
import extdeps.gpu.types { GpuDeviceCatalogRow, GpuBoardCatalogFacts, GpuBoardAdmission, admit_gpu_board, Cuda, PassiveThermalSolution, PcieAddInBoard, RatedBoardPower }
import extdeps.memory.types { MemoryFacts, Dram }
import extdeps.storage.types { Gen3, PcieLink }
import extdeps.pci.identity { PciDeviceId }
import extdeps.vendor.nvidia { nvidia }
import extdeps.nvidia.linux_driver_supported_chips { nvidia_linux_driver_supported_chips_authority }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, FactCitation }
import extdeps.uri { Uri, Https }

// NVIDIA Tesla K80 board specification BD-07317-001_v05, read 2026-10-28: ONE board carrying "2x Tesla
// GK210B" GPUs behind an on-board PLX switch, 2,496 processor cores per GPU, 12 GB GDDR5 per GPU (24 GB per
// board), "Memory bandwidth: 480 GB/sec (cumulative)", PCI Express Gen3 x16, a 300 W board power cap, and a
// passive heat sink. The device row is ONE GK210B at its own figures: 240 GB/s is the stated cumulative
// 480 divided over the two identical GPUs, each on its own memory. The board owns the power, link and
// thermal solution, once. "Kepler" is the architecture of the GK die prefix; the specification states
// the die, not the architecture name.

data k80_board_specification_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nvidia.com/content/dam/en-zz/Solutions/Data-Center/tesla-product-literature/Tesla-K80-BoardSpec-07317-001-v05.pdf"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_k80_board_catalogs", field: WholeDeclaration
  } },
  first_citation: k80_board_specification_authority,
  further_citations: []
}

data nvidia_tesla_k80_catalog: GpuDeviceCatalogRow = GpuDeviceCatalogRow {
  vendor: nvidia,
  model: "Tesla K80 GPU (GK210B)",
  microarchitecture: "Kepler",
  execution_lane_count: Present { value: hardware_thread_count(2496) },
  memory: MemoryFacts { capacity: gibibyte_to_byte_size(g: gibibyte(count: 12)), memory_kind: Dram },
  memory_bandwidth: Present { value: bandwidth(count: 240000000000) },
  boost_clock: none,
  compute_capability: none,
  supported_runtimes: [Cuda],
  sm_cache: none,
  sm_cache_citations: [],
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_catalog", field_name: "memory"), authority: k80_board_specification_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_catalog", field_name: "memory_bandwidth"), authority: k80_board_specification_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_catalog", field_name: "execution_lane_count"), authority: k80_board_specification_authority },
  ],
  dense_tensor_throughput: [],
}

data nvidia_tesla_k80_board_facts: GpuBoardCatalogFacts = GpuBoardCatalogFacts {
  vendor: nvidia,
  model: "Tesla K80",
  gpu: nvidia_tesla_k80_catalog,
  gpu_count: 2,
  attachment: PcieAddInBoard { link: Present { value: PcieLink { generation: Gen3, lane_count: 16 } } },
  board_power: Present { value: RatedBoardPower { rated: watt(count: 300) } },
  zero_power: none,
  thermal: Present { value: PassiveThermalSolution },
  pci_device_id: Present { value: "102d" as PciDeviceId },
  driver_listed_name: Present { value: "Tesla K80" },
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_board_facts", field_name: "gpu_count"), authority: k80_board_specification_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_board_facts", field_name: "attachment"), authority: k80_board_specification_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_board_facts", field_name: "board_power"), authority: k80_board_specification_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_board_facts", field_name: "thermal"), authority: k80_board_specification_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_board_facts", field_name: "pci_device_id"), authority: nvidia_linux_driver_supported_chips_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_k80", decl_name: "nvidia_tesla_k80_board_facts", field_name: "driver_listed_name"), authority: nvidia_linux_driver_supported_chips_authority },
  ],
}

data nvidia_tesla_k80_board_catalog: GpuBoardAdmission = admit_gpu_board(facts: nvidia_tesla_k80_board_facts)

// Every board this module declares, in declaration order: the roster test.claim.gpu_board_catalog_witness
// requires to be admitted, and this module's model-scope subject.
data nvidia_k80_board_catalogs: List<GpuBoardAdmission> = [nvidia_tesla_k80_board_catalog]
