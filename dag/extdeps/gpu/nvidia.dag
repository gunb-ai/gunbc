  },
]

data nvidia_rtx_5090_catalog: GpuModelCatalogRow = GpuModelCatalogRow {
  vendor: nvidia,
  model: "GeForce RTX 5090",
  microarchitecture: "Blackwell",
  package: PcieAddInCard,
  execution_lane_count: hardware_thread_count(21760),
  memory: MemoryFacts {
    capacity: gibibyte_to_byte_size(g: gibibyte(count: 32)),
    memory_kind: Dram,
  },
  memory_bandwidth: Present { value: bandwidth(count: 1792000000000) },
  boost_clock: hertz(count: 2410000000),
  tdp_watts: watt(count: 575),
  compute_capability: Present {
    value: GpuComputeCapability {
      vendor: nvidia,
      major: 12,
      minor: 0,
    }
  },
  supported_runtimes: [Cuda],
  interconnect: Present { value: rtx_5090_interconnect },
  sm_cache: Present { value: rtx_5090_sm_cache_geometry },
  sm_cache_citations: rtx_5090_sm_cache_citations,
  figure_citations: [],
}

// THE RTX PRO 6000 BLACKWELL FAMILY: THREE NVIDIA PRODUCTS, THREE ROWS, AND THE BANDWIDTH FIGURE IS
// THE REASON THEY ARE NOT ONE. Read 2026-10-11 from NVIDIA's own pages: the Workstation Edition
// (600 W) and Max-Q Workstation Edition (300 W) pages each state 1792 GB/s; the Server Edition
// (passive, up to 600 W configurable) page states 1597 GB/s on a 512-bit interface. All three state
// 96 GB GDDR7 with ECC. A session briefly held "1792 vs 1597" as a disagreement about one card; it
// is two correct figures for two editions, so merging them into one row would have made one of them
// a lie. The Max-Q is the card extdeps.pricing.hetzner_dedicated names in hetzner_gex131_listed's
// gpu_description; the row's model below is that string without the leading vendor word, and
// test.claim.rtx_pro_6000_catalog_witness joins the two.
//
// CUDA CORES. The Workstation Edition datasheet (document 3519208) and the Server Edition page both
// state 24,064. The Max-Q product page still states no count, so that row keeps TranscribedUncited.
// INTERCONNECT IS THE BOARD ENDPOINT, NOT A HOST OBSERVATION. The Workstation datasheet and the
// family table both state PCIe 5.0 x16; that is the add-in-card endpoint capability. Boost clock is
// Absent (no page states one). Compute capability 12.0 is the GB202 value this module already cites
// for the RTX 5090 (cuda_compute_capabilities_authority), listed by architecture, not by board.
// CONSUMER: P4 home-serving feasibility (measured weight+KV fit per rank, engine-on-arch).

data rtx_pro_6000_workstation_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nvidia.com/en-us/products/workstations/professional-desktop-gpus/rtx-pro-6000/"
  }
}

data rtx_pro_6000_workstation_datasheet_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nvidia.com/content/dam/en-zz/Solutions/design-visualization/quadro-product-literature/workstation-datasheet-blackwell-rtx-pro6000-x-nvidia-us-3519208-web.pdf"
  }
}

