// The figures each page states, as FactCitations on the row fields they ground. The CUDA core count
// is deliberately absent from the first two lists: see the standing rows above.
data rtx_pro_6000_workstation_figure_citations: List<FactCitation> = [
  FactCitation {
    fact: decl_field_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_catalog", field_name: "memory_bandwidth"),
    authority: rtx_pro_6000_workstation_authority,
  },
  FactCitation {
    fact: decl_field_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_catalog", field_name: "tdp_watts"),
    authority: rtx_pro_6000_workstation_authority,
  },
  FactCitation {
    fact: decl_field_ref(module_path: "extdeps.gpu.nvidia", decl_name: "nvidia_rtx_pro_6000_workstation_catalog", field_name: "memory"),
    authority: rtx_pro_6000_workstation_authority,
  },
]

