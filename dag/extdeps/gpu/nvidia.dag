// B200/B300 are SXM modules on HGX trays with NVLink. interconnect stays Absent: a rental
// listing's PCIe Gen5 label is the host link of that system, not an add-in-card endpoint.
// CUDA-core counts are unpublished; execution_lane_count is none rather than a blog figure.
// HGX pages state HBM bandwidth as "up to 8 TB/s" and B200 power as "configurable up to 1 kW";
// those are ceilings, not exact TDP/rate, so memory_bandwidth and tdp_watts stay none.
// CONSUMER: P4 treats these as references, not purchase candidates.
data nvidia_b200_sxm_catalog: GpuModelCatalogRow = GpuModelCatalogRow {
  vendor: nvidia,
  model: "NVIDIA B200 SXM",
  microarchitecture: "Blackwell",
  package: SxmModule,
  execution_lane_count: none,
  memory: MemoryFacts {
    capacity: gibibyte_to_byte_size(g: gibibyte(count: 180)),
    memory_kind: Hbm,
  },
  memory_bandwidth: none,
  boost_clock: none,
  tdp_watts: none,
  compute_capability: Present {
    value: GpuComputeCapability {
      vendor: nvidia,
      major: 10,
      minor: 0,
    }
  },
  supported_runtimes: [Cuda],
  interconnect: none,
  sm_cache: none,
  sm_cache_citations: [],
  figure_citations: nvidia_b200_sxm_figure_citations,
  dense_tensor_throughput: nvidia_b200_sxm_dense_tensor_throughput,
}

