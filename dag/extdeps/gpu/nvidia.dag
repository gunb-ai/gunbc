data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nvidia.com/en-us/geforce/graphics-cards/50-series/rtx-5090/"
  }
}

data rtx_5090_interconnect: PcieLink = PcieLink { generation: Gen5, lane_count: 16 }

data rtx_5090_sm_shared_memory: ByteSize = byte_size(count: 102400)
data rtx_5090_sm_register_file: ByteSize = byte_size(count: 262144)

data rtx_5090_sm_cache_geometry: GpuSmCacheGeometry = GpuSmCacheGeometry {
  shared_memory_per_sm: rtx_5090_sm_shared_memory,
  register_file_per_sm: rtx_5090_sm_register_file,
}

data rtx_5090_sm_cache_citations: List<FactCitation> = [
