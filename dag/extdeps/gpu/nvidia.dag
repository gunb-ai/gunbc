data rtx_pro_6000_cuda_core_uncited_obligation: NonEmptyStr = "Read the CUDA core count off NVIDIA's RTX PRO 6000 Blackwell Max-Q product page or a Max-Q datasheet for this edition. The Workstation Edition datasheet (document 3519208) and the Server Edition page both state 24,064; the Max-Q product page states no count, and the equal value is assumed from the shared GB202 die, not read."

data rtx_pro_6000_workstation_cuda_core_standing: CitedFigureStanding = CitedToAuthority {
  authority: rtx_pro_6000_workstation_datasheet_authority
}

data rtx_pro_pcie5_x16_endpoint: PcieLink = PcieLink { generation: Gen5, lane_count: 16 }

data rtx_pro_6000_max_q_cuda_core_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: rtx_pro_6000_cuda_core_uncited_obligation
}

data rtx_pro_6000_server_cuda_core_standing: CitedFigureStanding = CitedToAuthority {
  authority: rtx_pro_6000_server_authority
}

