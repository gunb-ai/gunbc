module extdeps.gpu.machine_shape


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#compute-capabilities"
  }
}

type ShapeFromCatalogInput
  = FromGpuModelCatalog {
      domain: std.machine_shape.DomainId
      register_level: std.machine_shape.LevelId
      shared_level: std.machine_shape.LevelId
      device_level: std.machine_shape.LevelId
      row: extdeps.gpu.types.GpuModelCatalogRow
    }

fn memory_level_from_gpu_device_dram(level_id: std.machine_shape.LevelId, row: extdeps.gpu.types.GpuModelCatalogRow) -> std.machine_shape.MemoryLevel {
  std.machine_shape.MemoryLevel {
    id: level_id
    capacity: row.memory.capacity
    transfer_grain: none
    bandwidth: Present { value: row.memory_bandwidth }
    latency: none
  }
}

fn memory_level_from_sm_register_file(level_id: std.machine_shape.LevelId, geometry: extdeps.gpu.types.GpuSmCacheGeometry) -> std.machine_shape.MemoryLevel {
  std.machine_shape.MemoryLevel {
    id: level_id
    capacity: geometry.register_file_per_sm
    transfer_grain: none
    bandwidth: none
    latency: none
  }
}

fn memory_level_from_sm_shared_memory(level_id: std.machine_shape.LevelId, geometry: extdeps.gpu.types.GpuSmCacheGeometry) -> std.machine_shape.MemoryLevel {
  std.machine_shape.MemoryLevel {
    id: level_id
    capacity: geometry.shared_memory_per_sm
    transfer_grain: none
    bandwidth: none
    latency: none
  }
}

fn memory_shape_from_gpu_catalog(
  register_level: std.machine_shape.LevelId,
  shared_level: std.machine_shape.LevelId,
  device_level: std.machine_shape.LevelId,
  row: extdeps.gpu.types.GpuModelCatalogRow
) -> std.machine_shape.MemoryShape {
  let device_dram = memory_level_from_gpu_device_dram(level_id: device_level, row: row)
  match row.sm_cache {
    Present { value: geometry } =>
      concat(
        [
          memory_level_from_sm_register_file(level_id: register_level, geometry: geometry),
          memory_level_from_sm_shared_memory(level_id: shared_level, geometry: geometry),
        ],
        [device_dram]
      )
    Absent => [device_dram]
  }
}

fn gpu_shape_from_catalog(input: ShapeFromCatalogInput) -> std.machine_shape.MachineShapeConstruction {
  match input {
    FromGpuModelCatalog {
      domain: domain,
      register_level: register_level,
      shared_level: shared_level,
      device_level: device_level,
      row: row,
    } =>
      std.machine_shape.MachineShapeOk {
        shape: std.machine_shape.MachineShape {
          domains: [
            std.machine_shape.ExecutionDomain {
              id: domain
              execution: std.machine_shape.execution_shape_independent_lanes(lane_count: row.execution_lane_count)
              memory: memory_shape_from_gpu_catalog(
                register_level: register_level,
                shared_level: shared_level,
                device_level: device_level,
                row: row
              )
            }
          ]
          edges: []
        }
      }
  }
}
