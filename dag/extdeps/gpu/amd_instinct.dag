data amd_instinct_catalog_transcriptions: List<GpuCatalogTranscription> = [
  GpuCatalogTranscription { vendor: amd, model: "Radeon Instinct MI6", standing: TranscribedUncited { read_obligation: "Fields of this row that its figure_citations do not name were transcribed from the dbgpu 2025.12 snapshot of TechPowerUp (www.techpowerup.com/gpu-specs/radeon-instinct-mi6.c2927), not read from AMD; read them off the vendor datasheet. memory: the snapshot states 8 GB and the cited Wikipedia revision 16 GB; the row carries the cited figure." } },
  GpuCatalogTranscription { vendor: amd, model: "Radeon Instinct MI25", standing: TranscribedUncited { read_obligation: "Fields of this row that its figure_citations do not name were transcribed from the dbgpu 2025.12 snapshot of TechPowerUp (www.techpowerup.com/gpu-specs/radeon-instinct-mi25.c2983), not read from AMD; read them off the vendor datasheet. memory_bandwidth: the snapshot states 436.2 GB/s and the Wikipedia revision 484 GB/s; the field is Absent until a datasheet decides." } },
  GpuCatalogTranscription { vendor: amd, model: "Radeon Instinct MI50", standing: TranscribedUncited { read_obligation: "Fields of this row that its figure_citations do not name were transcribed from the dbgpu 2025.12 snapshot of TechPowerUp (www.techpowerup.com/gpu-specs/radeon-instinct-mi50.c3335), not read from AMD; read them off the vendor datasheet." } },
  GpuCatalogTranscription { vendor: amd, model: "Radeon Instinct MI60", standing: TranscribedUncited { read_obligation: "Fields of this row that its figure_citations do not name were transcribed from the dbgpu 2025.12 snapshot of TechPowerUp (www.techpowerup.com/gpu-specs/radeon-instinct-mi60.c3233), not read from AMD; read them off the vendor datasheet." } },
