module extdeps.gpu.amd_instinct

import std.types { List, NonEmptyStr }
import std.measure { hardware_thread_count, bandwidth, hertz, watt, gibibyte, gibibyte_to_byte_size }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_field_ref }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, FactCitation, TranscribedUncited }
import extdeps.gpu.types { GpuModelCatalogRow, GpuCatalogTranscription, OamModule, PcieAddInCard }
import extdeps.memory.types { MemoryFacts, Dram, Hbm }
import extdeps.storage.types { PcieLink, Gen3, Gen4, Gen5 }
import extdeps.vendor.amd { amd }

// THE AMD INSTINCT ACCELERATORS THIS REPOSITORY KNOWS OF: ONE ROW PER CARD, the census a market or capacity analysis
// reads instead of the handful of cards someone happened to look at. Selection rule, applied to every
// source the same way: released 2011 or later, at least 8 GB of memory PER GPU (a multi-GPU board's row
// is one of its GPUs, package GpuOnMultiGpuBoard), and a discrete card or accelerator module -- not a
// laptop part, console, SoC, MXM or Apple MPX module, vGPU profile, or unreleased engineering name.
//
// WHERE EACH FIGURE CAME FROM, and the standing it therefore has:
//   - Enumeration and the figures no citation names: the dbgpu 2025.12 Python package's snapshot of
//     TechPowerUp's GPU database (MIT-licensed code; TechPowerUp blocks scripted reads, so the pages
//     themselves were not read). Those figures are second-hand and each row's GpuCatalogTranscription
//     entry below says so, with the page that would ground it.
//   - memory, memory_bandwidth and tdp_watts are CitedToAuthority to a Wikipedia revision (permalink
//     by oldid, so the citation cannot drift) ONLY where that revision states the same figure as the
//     snapshot. Where the two disagree, the field is Absent (bandwidth, TDP) and the transcription
//     entry records both readings: two sources disagreeing is not a figure, and a datasheet decides it.
//   - Rows already modeled elsewhere in extdeps.gpu are imported, never re-authored.
// Compute capability on NVIDIA rows is the CUDA programming guide's per-architecture table read by
// GPU die (extdeps.gpu.types cuda_compute_capabilities_authority), as the RTX 5090 row reads it.
// supported_runtimes is [Cuda] on NVIDIA rows and empty elsewhere: ROCm, oneAPI and Vulkan support is
// per-SKU and per-release, and no support matrix has been read into this module.

data wikipedia_amd_instinct_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/w/index.php?title=AMD_Instinct&oldid=1380954529"
  }
}

data extdeps_external_authority_anchor: ExternalAuthority = wikipedia_amd_instinct_authority

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.gpu.amd_instinct", decl_name: "amd_instinct_catalog_rows", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

