module extdeps.gpu.nvidia_a2

import std.types { List, NonEmptyStr }
import std.optional { Present }
import std.measure { bandwidth, watt, gibibyte, gibibyte_to_byte_size }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_field_ref }
import extdeps.gpu.types { GpuDeviceCatalogRow, GpuBoardCatalogFacts, GpuBoardAdmission, admit_gpu_board, Cuda, ConfigurableBoardPower, GpuComputeCapability, PcieAddInBoard, SingleGpu, cuda_gpus_page_authority }
import extdeps.memory.types { MemoryFacts, Dram }
import extdeps.storage.types { Gen4, PcieLink }
import extdeps.pci.identity { PciDeviceId }
import extdeps.vendor.nvidia { nvidia }
import extdeps.nvidia.linux_driver_supported_chips { nvidia_linux_driver_supported_chips_authority }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, FactCitation }
import extdeps.uri { Uri, Https }

// NVIDIA A2 product page, specifications table, read 2026-10-28: 16GB GDDR6 at 200GB/s, PCIe Gen4 x8,
// "1-slot, low-profile PCIe", "Max thermal design power (TDP) 40–60W (configurable)" with no default, and
// "Inside the NVIDIA Ampere Architecture". No core count and no thermal solution are stated. Compute
// capability 8.6 is the CUDA GPUs page's ("NVIDIA A2"). The driver lists "NVIDIA A2" as device 25b6,
// subsystem 10de:157e -- the A16's device id with another subsystem, so the device id alone does not
// tell the two boards apart and the driver-listed name does.

data a2_product_page_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nvidia.com/en-us/data-center/products/a2/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_board_catalogs", field: WholeDeclaration
  } },
  first_citation: a2_product_page_authority,
  further_citations: []
}

data nvidia_a2_catalog: GpuDeviceCatalogRow = GpuDeviceCatalogRow {
  vendor: nvidia,
  model: "A2",
  microarchitecture: "Ampere",
  execution_lane_count: none,
  memory: MemoryFacts { capacity: gibibyte_to_byte_size(g: gibibyte(count: 16)), memory_kind: Dram },
  memory_bandwidth: Present { value: bandwidth(count: 200000000000) },
  boost_clock: none,
  compute_capability: Present { value: GpuComputeCapability { vendor: nvidia, major: 8, minor: 6 } },
  supported_runtimes: [Cuda],
  sm_cache: none,
  sm_cache_citations: [],
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_catalog", field_name: "memory"), authority: a2_product_page_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_catalog", field_name: "memory_bandwidth"), authority: a2_product_page_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_catalog", field_name: "microarchitecture"), authority: a2_product_page_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_catalog", field_name: "compute_capability"), authority: cuda_gpus_page_authority },
  ],
  dense_tensor_throughput: [],
}

data nvidia_a2_board_facts: GpuBoardCatalogFacts = GpuBoardCatalogFacts {
  vendor: nvidia,
  model: "A2",
  gpu: nvidia_a2_catalog,
  composition: SingleGpu,
  attachment: PcieAddInBoard { link: Present { value: PcieLink { generation: Gen4, lane_count: 8 } } },
  board_power: Present { value: ConfigurableBoardPower { default: none, minimum: watt(count: 40), maximum: watt(count: 60), named_points: [] } },
  zero_power: none,
  thermal: none,
  pci_device_id: Present { value: "25b6" as PciDeviceId },
  driver_listed_name: Present { value: "NVIDIA A2" },
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_board_facts", field_name: "attachment"), authority: a2_product_page_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_board_facts", field_name: "board_power"), authority: a2_product_page_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_board_facts", field_name: "pci_device_id"), authority: nvidia_linux_driver_supported_chips_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_a2", decl_name: "nvidia_a2_board_facts", field_name: "driver_listed_name"), authority: nvidia_linux_driver_supported_chips_authority },
  ],
}

data nvidia_a2_board_catalog: GpuBoardAdmission = admit_gpu_board(facts: nvidia_a2_board_facts)

// Every board this module declares, in declaration order: the roster test.claim.gpu_board_catalog_witness
// requires to be admitted, and this module's model-scope subject.
data nvidia_a2_board_catalogs: List<GpuBoardAdmission> = [nvidia_a2_board_catalog]
