module extdeps.gpu.nvidia_t4

import std.types { List, NonEmptyStr }
import std.optional { Present }
import std.measure { hardware_thread_count, bandwidth, watt, gibibyte, gibibyte_to_byte_size, micrometer }
import std.decl_ref { DeclarationRef, WholeDeclaration, decl_field_ref }
import extdeps.gpu.types { GpuDeviceCatalogRow, GpuBoardCatalogFacts, GpuBoardAdmission, admit_gpu_board, Cuda, GpuComputeCapability, PassiveThermalSolution, PcieAddInBoard, RatedBoardPower, cuda_gpus_page_authority }
import extdeps.memory.types { MemoryFacts, Dram }
import extdeps.storage.types { Gen3, PcieLink }
import extdeps.pci.identity { PciDeviceId }
import extdeps.vendor.nvidia { nvidia }
import extdeps.nvidia.linux_driver_supported_chips { nvidia_linux_driver_supported_chips_authority }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, FactCitation, CitedFigureStanding, CitedToAuthority }
import extdeps.gpu.passive_card_row {
  CardRow, FromCitedFigure, NeedsReading, CardLength, LengthFromBracketFace, AirflowBidirectional,
}
import extdeps.standards.pcie_cem { CemLowProfile, CemLowProfileBracket, CemFullHeightBracket }
import extdeps.uri { Uri, Https }

// NVIDIA T4 Tensor Core GPU datasheet 951643 (2019), read 2026-10-28: 2,560 CUDA cores, 16 GB GDDR6 at
// 300 GB/s, x16 PCIe Gen3, low-profile PCIe, passive thermal solution, 70 W. Compute capability 7.5 is the
// CUDA GPUs page's ("NVIDIA T4"); the driver lists the board as "Tesla T4", device 1eb8.

data t4_datasheet_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nvidia.com/content/dam/en-zz/Solutions/Data-Center/tesla-t4/t4-tensor-core-datasheet-951643.pdf"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_board_catalogs", field: WholeDeclaration
  } },
  first_citation: t4_datasheet_authority,
  further_citations: [t4_product_brief_authority]
}

data nvidia_t4_catalog: GpuDeviceCatalogRow = GpuDeviceCatalogRow {
  vendor: nvidia,
  model: "T4",
  microarchitecture: "Turing",
  execution_lane_count: Present { value: hardware_thread_count(2560) },
  memory: MemoryFacts { capacity: gibibyte_to_byte_size(g: gibibyte(count: 16)), memory_kind: Dram },
  memory_bandwidth: Present { value: bandwidth(count: 300000000000) },
  boost_clock: none,
  compute_capability: Present { value: GpuComputeCapability { vendor: nvidia, major: 7, minor: 5 } },
  supported_runtimes: [Cuda],
  sm_cache: none,
  sm_cache_citations: [],
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_catalog", field_name: "memory"), authority: t4_datasheet_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_catalog", field_name: "memory_bandwidth"), authority: t4_datasheet_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_catalog", field_name: "execution_lane_count"), authority: t4_datasheet_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_catalog", field_name: "microarchitecture"), authority: t4_datasheet_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_catalog", field_name: "compute_capability"), authority: cuda_gpus_page_authority },
  ],
  dense_tensor_throughput: [],
}

data nvidia_t4_board_facts: GpuBoardCatalogFacts = GpuBoardCatalogFacts {
  vendor: nvidia,
  model: "T4",
  gpu: nvidia_t4_catalog,
  gpu_count: 1,
  attachment: PcieAddInBoard { link: Present { value: PcieLink { generation: Gen3, lane_count: 16 } } },
  board_power: Present { value: RatedBoardPower { rated: watt(count: 70) } },
  zero_power: none,
  thermal: Present { value: PassiveThermalSolution },
  pci_device_id: Present { value: "1eb8" as PciDeviceId },
  driver_listed_name: Present { value: "Tesla T4" },
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_board_facts", field_name: "attachment"), authority: t4_datasheet_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_board_facts", field_name: "board_power"), authority: t4_datasheet_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_board_facts", field_name: "thermal"), authority: t4_datasheet_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_board_facts", field_name: "pci_device_id"), authority: nvidia_linux_driver_supported_chips_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.nvidia_t4", decl_name: "nvidia_t4_board_facts", field_name: "driver_listed_name"), authority: nvidia_linux_driver_supported_chips_authority },
  ],
}

data nvidia_t4_board_catalog: GpuBoardAdmission = admit_gpu_board(facts: nvidia_t4_board_facts)

// Every board this module declares, in declaration order: the roster test.claim.gpu_board_catalog_witness
// requires to be admitted, and this module's model-scope subject.
data nvidia_t4_board_catalogs: List<GpuBoardAdmission> = [nvidia_t4_board_catalog]

// ═══ THE CARD'S MECHANICAL ROW (extdeps.gpu.passive_card_row CardRow) ═══
//
// The datasheet above states the board; the product brief below draws it. Both are NVIDIA's.
// NVIDIA T4 70W Low Profile PCIe GPU Accelerator, product brief PB-09256-001_v05 (April 2020), fetched
// 2026-10-29 from NVIDIA's own server, sha256
// 4b94dfc3eb3e94ae06f20d4aa1a4d2d7fbd9115bf5c12d3136f08eec761da698. Read from the PDF text layer and
// from Figure 2 rendered (the drawing's figures are vector paths, not text):
//   Overview: "a single-slot, low-profile, 6.6-inch PCI Express Gen3" accelerator, "a 70 W maximum
//     power limit", "passively cooled ... requires system air flow".
//   Table 1: total board power 70 W (default); thermal cooling solution Passive; order part numbers
//     900-2G183-0000-000 (low-profile bracket installed, full-height "ATX" bracket as an accessory) and
//     -001 (the reverse); a full-height and a half-height bracket are both listed by weight.
//   Airflow Direction Support: "bi-directional airflow either from left to right, or from right to
//     left. CFM requirements are identical for both airflow directions." No CFM figure is given.
//   Figure 2, NVIDIA T4 Board Dimensions: 169.53 from the bracket's inner mounting face to the far end;
//     height "68.90 MAX" (68.08 +/- 0.52 nominal); edge connector 59.04 +/- 0.40 from the bracket face.
//   The brief has no power-connector section, Table 1 lists no auxiliary input, and Figure 2 draws
//     none: the card is powered from the slot, within the 75 W a x16 slot supplies.
data t4_product_brief_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "www.nvidia.com/content/dam/en-zz/Solutions/Data-Center/tesla-t4/t4-tensor-core-product-brief.pdf" }
}

data t4_brief_sha256: NonEmptyStr = "4b94dfc3eb3e94ae06f20d4aa1a4d2d7fbd9115bf5c12d3136f08eec761da698"

data t4_brief_standing: CitedFigureStanding = CitedToAuthority { authority: t4_product_brief_authority }

// The height is the drawing's MAX, not its nominal: a part fitted around the card has to clear the
// largest card the drawing admits.
data t4_card_row: CardRow = CardRow {
  id: "t4",
  product: "NVIDIA T4 70W Low Profile (PG183 SKU 200)",
  height_class: FromCitedFigure { value: CemLowProfile, standing: t4_brief_standing },
  slot_count: FromCitedFigure { value: 1, standing: t4_brief_standing },
  length: FromCitedFigure { value: CardLength { length: micrometer(count: 169530), reference: LengthFromBracketFace }, standing: t4_brief_standing },
  height: FromCitedFigure { value: micrometer(count: 68900), standing: t4_brief_standing },
  brackets: FromCitedFigure { value: [CemLowProfileBracket, CemFullHeightBracket], standing: t4_brief_standing },
  auxiliary_power: FromCitedFigure { value: [], standing: t4_brief_standing },
  board_power: FromCitedFigure { value: watt(count: 70), standing: t4_brief_standing },
  required_airflow: NeedsReading { read_obligation: "NVIDIA document, not read by this repository: the T4's required airflow. PB-09256-001_v05 states only that CFM requirements are identical in both directions and refers system design to the System Design Guide for NVIDIA Enterprise GPU Products (DG-07562-001). Read the figure (CFM or m3/h, with the inlet temperature and static pressure it is stated at) from that guide and convert to ml/s." },
  airflow_direction: FromCitedFigure { value: AirflowBidirectional, standing: t4_brief_standing },
  sources: [
    "NVIDIA T4 70W Low Profile PCIe GPU Accelerator product brief PB-09256-001_v05 (April 2020), www.nvidia.com/content/dam/en-zz/Solutions/Data-Center/tesla-t4/t4-tensor-core-product-brief.pdf, sha256 4b94dfc3eb3e94ae06f20d4aa1a4d2d7fbd9115bf5c12d3136f08eec761da698, read 2026-10-29: Overview, Table 1, Airflow Direction Support, Figure 2",
  ],
}
