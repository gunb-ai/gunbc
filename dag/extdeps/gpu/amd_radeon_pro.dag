  sm_cache: none,
  sm_cache_citations: [],
  figure_citations: [
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.amd_radeon_pro", decl_name: "amd_firepro_w9100_catalog", field_name: "memory"), authority: wikipedia_list_of_amd_gpus_authority },
    FactCitation { fact: decl_field_ref(module_path: "extdeps.gpu.amd_radeon_pro", decl_name: "amd_firepro_w9100_catalog", field_name: "memory_bandwidth"), authority: wikipedia_list_of_amd_gpus_authority },
