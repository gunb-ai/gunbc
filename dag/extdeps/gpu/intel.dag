  GpuCatalogTranscription { vendor: intel, model: "Data Center GPU Flex 170", standing: TranscribedUncited { read_obligation: "Fields of this row that its figure_citations do not name were transcribed from the dbgpu 2025.12 snapshot of TechPowerUp (www.techpowerup.com/gpu-specs/data-center-gpu-flex-170.c4071), not read from Intel; read them off the vendor datasheet." } },
