module extdeps.gpu.nvidia_passive_rows

import std.types {NonEmptyStr, String, List}
import std.measure {Micrometer, micrometer}
import std.optional {Present, Absent}
import extdeps.gpu.passive_card_row {CardRow, RowField, FromCitedFigure, NeedsReading, row_display, row_is_sealed, row_unread_fields}
import extdeps.external_authority {TranscribedUncited}

// ═══ THE ROWS BEYOND THE A16: T10 AND A2, AND THE SHAPE A FOURTH CARD ADDS ═══
//
// The operator is buying about 60 Tesla T10 cards and their chassis takes A2s too; all of them are
// passive and all of them need the SAME duct (product.printed_chassis.card_cooling_route), so the cards
// are rows here and nothing in the product layer names one. The A16 is row one because it is the only
// card this repository has measured; T10 and A2 are rows two and three.
//
// EVERY FIELD IN THESE TWO ROWS IS AN OBLIGATION. That is not laziness, it is the state of the evidence:
// the probe below is recorded with the date it ran and what it returned, and a number typed in "from
// memory" of a datasheet is exactly the failure the model-before-implement rule exists to stop. The
// NVIDIA documents a T10/A2 row needs -- the T10 product brief and the A2 datasheet -- do not answer at
// any nvidia.com or images.nvidia.com path this repository could reach on 2026-10-26, and the archive was
// unavailable. So the rows say what to read and on which physical feature, and the operator measures the
// cards when they arrive -- which is the same route the A16 took, and the fit ring that came out of it
// (artifacts/printing/a16-plug-fit-ring/manual-start-2026-10-26.json).
//
// THE PROBE, 2026-10-26 (run from this repository's own runner; HTTP status recorded verbatim):
//   images.nvidia.com/content/technologies/virtualization/tesla-t10-virtualgpu-product-brief-170910a.pdf  404
//   images.nvidia.com/content/technologies/virtualization/tesla_t10_virtualgpu_datasheet-170910a.pdf       404
//   images.nvidia.com/content/technologies/virtualization/tesla-t10-virtual-gpu-brief.pdf                  404
//   www.nvidia.com/content/dam/en-zz/Solutions/Data-Center/tesla-t10/pdf/nvidia-tesla-t10-datasheet-web.pdf 404
//   www.nvidia.com/content/dam/en-zz/Solutions/Data-Center/a2/pdf/nvidia-a2-datasheet-us-web-v2-1.pdf       404
//   www.nvidia.com/en-us/data-center/tesla-t10/  404    www.nvidia.com/en-us/data-center/products/a2-gpu/  404
//   docs.nvidia.com/datacenter/tesla/tesla-t10/index.html  404  (and the A2 equivalents)
//   resources.nvidia.com/en-us-virtual-gpu-infrastructure/vgpu-t10  200 -- serves the generic NVIDIA
//     site shell (42,613 bytes of navigation), the same bytes as .../en-us-virtual-gpu/a2, and neither
//     carries a form-factor, TDP, dimension or airflow figure. A 200 with no spec is not a source.
// A T10 or A2 row seals when someone reads a real NVIDIA document into these fields -- or, for the
// physical features the briefs never drew (end face, fins), when the operator reads a real card.

// The obligation every one of these cards shares: the vendor publishes no end-face drawing, so the
// caliper reading is what seals the row. Same wording as the A16's, because it is the same act.
fn face_obligation(card: NonEmptyStr) -> NonEmptyStr {
  join(["operator, on a physical ", card as String, ": with a caliper, the OUTER FACE of the card's far end (the end opposite the I/O bracket) -- its overall length and overall height to 0.02 mm, the corner radius if the ends are rounded, and where the PCI Express x16 edge connector sits on that face (distance from each end to each outer pin, and the connector's own length). The duct's plug and screw flange seat against THIS face; NVIDIA's briefs publish no end-face drawing for this card, so no vendor document can seal it (the A16 was sealed the same way)."], "")
}

fn fin_obligation(card: NonEmptyStr) -> NonEmptyStr {
  join(["operator, on a physical ", card as String, ": the cooler's FIN OPENING at the far end -- the rectangle of exposed fin tips (extent, to 0.1 mm), how far the fins sit behind that opening, the fin pitch if it can be judged, and whether any shroud or label overhangs the opening. The duct's outlet turns into THIS opening; the outlet has to reach past the fins' leading edge and must not bear on a shroud."], "")
}

fn thickness_obligation(card: NonEmptyStr) -> NonEmptyStr {
  join(["operator, on a physical ", card as String, ": the card's THICKNESS across the slot, measured at the far end away from the components and the heatsink's tallest point, plus the bracket's own width. A slot-count statement ('single-slot', 'dual-slot') names an envelope class, not a thickness, and the duct's housing depth is set against a thickness."], "")
}

fn airflow_obligation(card: NonEmptyStr) -> NonEmptyStr {
  join(["NVIDIA document, not yet read by this repository: the ", card as String, " product brief or datasheet (PB number and version), its thermal/cooling section -- TDP, the airflow the passive heatsink needs (CFM or m3/h, and at what static pressure if the document gives it), and the maximum inlet air temperature. The figure lands in this row's required_airflow field, which carries std.measure.MillilitrePerSecond -- convert CFM or m3/h to ml/s when transcribing, do not store the raw number under the field's name. The card is passive: forced air is the ONLY cooling path, so the duct's blower is sized from this figure and from nothing else. Record the document's exact URL, its version, and the page/section the figures are on."], "")
}

fn bracket_obligation(card: NonEmptyStr) -> NonEmptyStr {
  join(["operator or NVIDIA document: the bracket's form (full-height, low-profile/low-height, or single/two-slot bracket) and its height. A low-profile bracket changes where the duct's flange can sit relative to the chassis deck, so the row cannot print without it. If it comes from a document, the standing is CitedToAuthority naming that document; a ruler reading cannot be minted here -- extdeps.external_authority observed_receipt admits four named privileged callers, so the reading has to be recorded where one of them owns it and cited from there."], "")
}

// ═══ ROW 2: TESLA T10 (TURING, PASSIVE, THE 60-CARD FLEET) ═══
//
// The T10 is the row that has to work before 60 cards ship. Its envelope is what the duct is built
// around, and this repository has read nothing about it. The T10 is also, unlike the A16, a SINGLE card
// per board -- so it IS a row of its own, where the A16 is one board carrying four GPUs and cannot be
// treated as four rows (extdeps.gpu.nvidia_a16: it is deliberately not a quad of independent GPUs).
data t10_row: CardRow = CardRow {
  id: "nvidia-tesla-t10",
  end_face_length: NeedsReading {read_obligation: face_obligation(card: "Tesla T10")},
  end_face_width: NeedsReading {read_obligation: face_obligation(card: "Tesla T10")},
  card_thickness: NeedsReading {read_obligation: thickness_obligation(card: "Tesla T10")},
  fin_face_extent: NeedsReading {read_obligation: fin_obligation(card: "Tesla T10")},
  fin_face_depth: NeedsReading {read_obligation: fin_obligation(card: "Tesla T10")},
  tdp: NeedsReading {read_obligation: airflow_obligation(card: "Tesla T10")},
  required_airflow: NeedsReading {read_obligation: airflow_obligation(card: "Tesla T10")},
  bracket: NeedsReading {read_obligation: bracket_obligation(card: "Tesla T10")},
  sources: [
    "probe 2026-10-26: no NVIDIA product brief or datasheet reachable (nvidia.com and images.nvidia.com 404; resources.nvidia.com serves the site shell without spec content; archive.org unavailable) -- see the module header for the verbatim statuses",
  ],
}

// ═══ ROW 3: NVIDIA A2 (TURING, PASSIVE, LOW-PROFILE) ═══
//
// The A2 is described to this repository by the operator as low-profile and passive. That is a
// description, not a figure: "low-profile" is an envelope class and the duct needs millimetres, and the
// low bracket is precisely the thing that changes where a flange may sit, so the row refuses until the
// bracket's height is read. The A2's small TDP is not assumed to mean "less air" -- a smaller heatsink
// can need MORE airflow per watt, and only the vendor's thermal figure says.
data a2_row: CardRow = CardRow {
  id: "nvidia-a2",
  end_face_length: NeedsReading {read_obligation: face_obligation(card: "A2")},
  end_face_width: NeedsReading {read_obligation: face_obligation(card: "A2")},
  card_thickness: NeedsReading {read_obligation: thickness_obligation(card: "A2")},
  fin_face_extent: NeedsReading {read_obligation: fin_obligation(card: "A2")},
  fin_face_depth: NeedsReading {read_obligation: fin_obligation(card: "A2")},
  tdp: NeedsReading {read_obligation: airflow_obligation(card: "A2")},
  required_airflow: NeedsReading {read_obligation: airflow_obligation(card: "A2")},
  bracket: NeedsReading {read_obligation: bracket_obligation(card: "A2")},
  sources: [
    "operator, 2026-10-26: 'NVIDIA A2: low-profile, passive' -- an envelope class and a cooling method, no millimetres; recorded so the row is not mistaken for unsourced, and it seals nothing",
    "probe 2026-10-26: no NVIDIA datasheet reachable (see the module header for the verbatim statuses)",
  ],
}

// ═══ ROW 1: THE A16, THE ONLY SEALED ROW ═══
//
// The A16's physical figures are CALIPER READINGS by the operator of a physical card, and its fan is
// Delta's cited datasheet (extdeps.fans.delta). The vendor brief behind it (extdeps.gpu.nvidia_a16)
// publishes the FHFL 10.5 class and a 266.7 mm length and nothing else, which is why the end face had to
// be measured. Its airflow figure is still an obligation: the brief gives no CFM, and this row's fan was
// chosen from the blower's own cited curve, not from an A107-per-GPU thermal requirement.
data a16_row: CardRow = CardRow {
  id: "nvidia-a16",
  end_face_length: a16_transcribed(field: "face_length", value: micrometer(count: 97840)),
  end_face_width: a16_transcribed(field: "face_thickness", value: micrometer(count: 38600)),
  card_thickness: a16_transcribed(field: "face_thickness", value: micrometer(count: 38600)),
  fin_face_extent: a16_transcribed(field: "window_length", value: micrometer(count: 88030)),
  fin_face_depth: a16_transcribed(field: "fin_setback", value: micrometer(count: 6000)),
  tdp: NeedsReading {read_obligation: "NVIDIA A16 product brief PB-10518-001 v02: the brief is read (extdeps.gpu.nvidia_a16) and publishes no TDP; the TDP has to come from a document that does, or from the card's own label"},
  required_airflow: NeedsReading {read_obligation: airflow_obligation(card: "A16")},
  bracket: NeedsReading {read_obligation: "operator or document: the A16's bracket height and form. The brief says full-height full-length and no drawing backs it (extdeps.gpu.nvidia_a16 states the ambiguity rather than resolving it)"},
  sources: [
    "extdeps.gpu.nvidia_a16 -- NVIDIA A16 product brief PB-10518-001 v02, images.nvidia.com/content/Solutions/data-center/vgpu-a16-product-brief.pdf, read 2026-10-19: FHFL 10.5 dual-slot class, 266.70 mm stated length, no dimension drawing, no TDP, no airflow",
    "operator caliper readings of a physical A16, 2026-10 (product.printed_chassis.gpu_duct a16_end_face, a16_duct_design): end face 97.84 x 38.60 mm, cooler window 88.03 x 23.94 mm, band 13.09 mm",
    "operator fit observation 2026-10-26: the printed plug fit ring FITS the A16 (artifacts/printing/a16-plug-fit-ring/manual-start-2026-10-26.json), which is what confirms the end face is usable as the duct's datum",
  ],
}

// The A16's millimetres are the operator's caliper readings, recorded once in
// product.printed_chassis.gpu_duct a16_end_face. Carrying them here makes this a TRANSCRIPTION, and the
// corpus is emphatic about what an observation standing means: extdeps.external_authority
// observed_receipt admits four named privileged callers and test.claim.observed_receipt_seal_witness
// proves a literal minted outside one is a forgery. So the honest standing for a copy of someone else's
// reading is TranscribedUncited, with the obligation to read it back against the record it was copied
// from -- and this row is therefore NOT sealed, exactly as it should be: its figures are trusted one
// step removed until the reading is verified against a16_end_face and the fit ring that fits.
fn a16_transcribed(field: NonEmptyStr, value: Micrometer) -> RowField<Micrometer> {
  FromCitedFigure {value: value, standing: TranscribedUncited {read_obligation: join(["read this back against product.printed_chassis.gpu_duct a16_end_face field ", field as String, ", the operator's caliper record it was copied from (2026-10-23), and against the physical fit: the printed plug fit ring FITS the A16 (artifacts/printing/a16-plug-fit-ring/manual-start-2026-10-26.json)"], "")}}
}

data card_rows: List<CardRow> = [a16_row, t10_row, a2_row]

fn card_row(id: NonEmptyStr) -> CardRow? {
  fold(card_rows, init: Absent, f: (found, r) => match found { Present { value: v } => Present { value: v } Absent => if r.id == id { Present { value: r } } else { Absent } })
}

fn card_rows_display() -> String {
  join(map(card_rows, r => row_display(row: r)), "\n")
}

// The bench list for every row that is not yet printable -- what the operator measures when the cards
// arrive, in row order, one line per field. A fourth card added to card_rows appears here with no other
// change anywhere.
fn all_rows_bench_list() -> List<String> {
  fold(card_rows, init: [], f: (acc, r) => if row_is_sealed(row: r) { acc } else { concat(concat(acc, [join(["== ", r.id as String], "")]), map(row_unread_fields(row: r), line => line)) })
}
