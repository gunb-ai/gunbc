module extdeps.gpu.types



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#compute-capabilities"
  }
}

data cuda_compute_capabilities_authority: extdeps.external_authority.ExternalAuthority = extdeps_external_authority_anchor

type GpuRuntime = Cuda | Rocm | Metal | OpenCl

type GpuComputeCapability {
  vendor: Vendor<extdeps.hardware.Hardware>
  major: Int
  minor: Int
}

type UnsubstantiatedGpuCapabilityLabel { vendor: Vendor<extdeps.hardware.Hardware> }

type GpuCapabilityLabelOutcome
  = GpuCapabilityLabelOk { label: String }
  | GpuCapabilityLabelRejected { reason: UnsubstantiatedGpuCapabilityLabel }

fn gpu_compute_capability_sm_label(cap: GpuComputeCapability) -> GpuCapabilityLabelOutcome {
  if cap.vendor == nvidia {
    GpuCapabilityLabelOk {
      label: concat("sm_", concat(to_string(cap.major), concat("_", to_string(cap.minor))))
    }
  } else {
    if cap.vendor == amd {
      GpuCapabilityLabelOk {
        label: concat("gfx", concat(to_string(cap.major), to_string(cap.minor)))
      }
    } else {
      GpuCapabilityLabelRejected {
        reason: UnsubstantiatedGpuCapabilityLabel { vendor: cap.vendor }
      }
    }
  }
}

type GpuFacts {
  vendor: Vendor<extdeps.hardware.Hardware>
  model: std.types.NonEmptyStr
  compute_capability: GpuComputeCapability?
  memory: extdeps.memory.types.MemoryFacts
  supported_runtimes: List<GpuRuntime>
}

type AcceleratorFacts {
  vendor: Vendor<extdeps.hardware.Hardware>
  model: std.types.NonEmptyStr
}

type GpuSmCacheGeometry {
  shared_memory_per_sm: std.measure.ByteSize
  register_file_per_sm: std.measure.ByteSize
}

type GpuModelCatalogRow {
  vendor: Vendor<extdeps.hardware.Hardware>
  model: std.types.NonEmptyStr
  microarchitecture: std.types.NonEmptyStr
  execution_lane_count: std.measure.HardwareThreadCount
  memory: extdeps.memory.types.MemoryFacts
  memory_bandwidth: std.measure.Bandwidth
  boost_clock: std.measure.Hertz?
  tdp_watts: std.measure.Watt?
  compute_capability: GpuComputeCapability?
  supported_runtimes: List<GpuRuntime>
  interconnect: extdeps.storage.types.PcieLink?
  sm_cache: GpuSmCacheGeometry?
  sm_cache_citations: List<extdeps.cpu.types.CacheGeometryCitation>
}
