module extdeps.gpu.types

import std.types { Int, NonEmptyStr, String, List, Bool }
import std.nat { Nat }
import std.optional { Present, Absent }
import std.measure { ByteSize, HardwareThreadCount, Hertz, Watt, Bandwidth, bandwidth_count, Micrometer }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.memory.types { MemoryFacts }
import extdeps.vendor.nvidia { nvidia }
import extdeps.vendor.amd { amd }
import extdeps.storage.types { PcieLink }

import extdeps.external_authority { ExternalAuthority, FactCitation }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#compute-capabilities"
  }
}

data cuda_compute_capabilities_authority: ExternalAuthority = extdeps_external_authority_anchor

type GpuRuntime = Cuda | Rocm | Metal | OpenCl

// THE ONE PLACE THE RUNTIME VARIANTS ARE ENUMERATED, so a consumer comparing two runtimes reads this
// rather than matching the coproduct against itself. A second enumeration beside it would let a
// fifth runtime compile against half the corpus: the projection would fail to build while every
// hand-rolled equality quietly answered false for the new arm.
fn gpu_runtime_wire(runtime: GpuRuntime) -> String {
  match runtime {
    Cuda => "cuda"
    Rocm => "rocm"
    Metal => "metal"
    OpenCl => "opencl"
  }
}

fn gpu_runtime_eq(a: GpuRuntime, b: GpuRuntime) -> Bool {
  gpu_runtime_wire(runtime: a) == gpu_runtime_wire(runtime: b)
}

type GpuComputeCapability {
  vendor: Vendor<Hardware>
  major: Int
  minor: Int
}

type UnsubstantiatedGpuCapabilityLabel { vendor: Vendor<Hardware> }

type GpuCapabilityLabelOutcome
  = GpuCapabilityLabelOk { label: String }
  | GpuCapabilityLabelRejected { reason: UnsubstantiatedGpuCapabilityLabel }

fn gpu_compute_capability_sm_label(cap: GpuComputeCapability) -> GpuCapabilityLabelOutcome {
  if cap.vendor == nvidia {
    GpuCapabilityLabelOk {
      label: concat("sm_", concat(to_string(cap.major), concat("_", to_string(cap.minor))))
    }
  } else {
    if cap.vendor == amd {
      GpuCapabilityLabelOk {
        label: concat("gfx", concat(to_string(cap.major), to_string(cap.minor)))
      }
    } else {
      GpuCapabilityLabelRejected {
        reason: UnsubstantiatedGpuCapabilityLabel { vendor: cap.vendor }
      }
    }
  }
}

type GpuFacts {
  vendor: Vendor<Hardware>
  model: NonEmptyStr
  compute_capability: GpuComputeCapability?
  memory: MemoryFacts
  supported_runtimes: List<GpuRuntime>
}

type AcceleratorFacts {
  vendor: Vendor<Hardware>
  model: NonEmptyStr
}

type GpuSmCacheGeometry {
  shared_memory_per_sm: ByteSize
  register_file_per_sm: ByteSize
}

// PACKAGE IS NOT THE HOST LINK. PcieAddInCard names the board; interconnect is that board's
// endpoint capability (generation × width). An SXM module in an HGX tray is SxmModule: its
// GPU-to-GPU fabric is NVLink, and a rental listing's "PCIe Gen5" is an observed host link of
// that system, never an add-in-card fact. IntegratedComputePackage is a GPU nested in an SoC
// or superchip. The three stay separate so P4 feasibility can refuse to treat a B200 as a
// purchasable dual-slot card.
type GpuPackageForm
  = PcieAddInCard
  | SxmModule
  | IntegratedComputePackage

// figure_citations cites the row's other published figures (bandwidth, power, memory, lane count),
// each naming the row field it grounds; sm_cache_citations grounds sm_cache only.
// execution_lane_count is absent when the cited datasheet does not state a CUDA-core / lane
// count (NVIDIA unpublished B200/B300 SM counts); a consumer that needs lanes reads Present
// or stops, never a fabricated zero.
// memory_bandwidth is absent when the cited page only states a ceiling ("up to"), not an
// exact rate; a consumer that needs bandwidth reads Present or stops.
type GpuModelCatalogRow {
  vendor: Vendor<Hardware>
  model: NonEmptyStr
  microarchitecture: NonEmptyStr
  package: GpuPackageForm
  execution_lane_count: HardwareThreadCount?
  memory: MemoryFacts
  memory_bandwidth: Bandwidth?
  boost_clock: Hertz?
  tdp_watts: Watt?
  compute_capability: GpuComputeCapability?
  supported_runtimes: List<GpuRuntime>
  interconnect: PcieLink?
  sm_cache: GpuSmCacheGeometry?
  sm_cache_citations: List<FactCitation>
  figure_citations: List<FactCitation>
}

// Identity of a catalog row is the cited vendor plus the cited SKU name (NVIDIA's edition
// spellings distinguish Workstation / Max-Q / Server). Package×VRAM×TDP is not enough: the
// Workstation and Server PRO 6000 rows share those three and differ in model and bandwidth.
fn gpu_catalog_row_eq(a: GpuModelCatalogRow, b: GpuModelCatalogRow) -> Bool {
  (a.vendor.legal_name as String) == (b.vendor.legal_name as String)
    && (a.model as String) == (b.model as String)
}

fn gpu_catalog_bandwidth_count(row: GpuModelCatalogRow) -> Nat? {
  match row.memory_bandwidth {
    Present { value: b } => Present { value: bandwidth_count(b: b) }
    Absent => none
  }
}

// THE SIDE OUTLINE OF A PCIe ADD-IN CARD, as a vendor's side-view drawing dimensions it. Length is
// carried twice because vendors dimension it twice: with the I/O bracket and without it, and a
// consumer placing the card in a chassis needs the first while one fitting a duct to the far end
// needs the second. Thickness is NOT a field: a side view does not dimension it, and a slot-count
// statement ("dual-slot") names an envelope class rather than a measured thickness.
type PcieCardSideOutline {
  length_without_bracket: Micrometer
  length_with_bracket: Micrometer
  height: Micrometer
}
