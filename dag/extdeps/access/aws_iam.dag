module extdeps.access.aws_iam


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_grammar.html"
  }
}

type Effect
  = Allow
  | Deny

type Principal
  = AnyPrincipal
  | AwsPrincipal { arns: List<std.types.NonEmptyStr> }
  | ServicePrincipal { services: List<std.types.NonEmptyStr> }
  | FederatedPrincipal { providers: List<std.types.NonEmptyStr> }
  | CanonicalUserPrincipal { ids: List<std.types.NonEmptyStr> }

type ConditionEntry {
  operator: std.types.NonEmptyStr
  key: std.types.NonEmptyStr
  values: List<std.types.NonEmptyStr>
}

type Statement {
  sid: std.types.NonEmptyStr?
  effect: Effect
  principal: Principal?
  actions: List<std.types.NonEmptyStr>
  resources: List<std.types.NonEmptyStr>
  conditions: List<ConditionEntry>
}

type PolicyDocument {
  version: std.types.NonEmptyStr
  id: std.types.NonEmptyStr?
  statements: List<Statement>
}
