module extdeps.access.rbac

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "csrc.nist.gov/projects/role-based-access-control"
  }
}

type Permission {
  operation: NonEmptyStr
  object: NonEmptyStr
}

type UserAssignment {
  user: NonEmptyStr
  role: NonEmptyStr
}

type PermissionAssignment {
  permission: Permission
  role: NonEmptyStr
}

type RoleInheritance {
  senior: NonEmptyStr
  junior: NonEmptyStr
}

type Session {
  user: NonEmptyStr
  active_roles: List<NonEmptyStr>
}

type RbacPolicy {
  users: List<NonEmptyStr>
  roles: List<NonEmptyStr>
  user_assignments: List<UserAssignment>
  permission_assignments: List<PermissionAssignment>
  role_hierarchy: List<RoleInheritance>
}
