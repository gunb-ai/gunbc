module extdeps.access.rbac


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "csrc.nist.gov/projects/role-based-access-control"
  }
}

type Permission {
  operation: std.types.NonEmptyStr
  object: std.types.NonEmptyStr
}

type UserAssignment {
  user: std.types.NonEmptyStr
  role: std.types.NonEmptyStr
}

type PermissionAssignment {
  permission: Permission
  role: std.types.NonEmptyStr
}

type RoleInheritance {
  senior: std.types.NonEmptyStr
  junior: std.types.NonEmptyStr
}

type Session {
  user: std.types.NonEmptyStr
  active_roles: List<std.types.NonEmptyStr>
}

type RbacPolicy {
  users: List<std.types.NonEmptyStr>
  roles: List<std.types.NonEmptyStr>
  user_assignments: List<UserAssignment>
  permission_assignments: List<PermissionAssignment>
  role_hierarchy: List<RoleInheritance>
}
