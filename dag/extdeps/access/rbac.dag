module extdeps.access.rbac


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { List, NonEmptyStr }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "csrc.nist.gov/projects/role-based-access-control"
  }
}

// Reading: csrc.nist.gov owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its type declaration Permission, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.access.rbac",
      decl_name: "Permission",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type Permission {
  operation: NonEmptyStr
  object: NonEmptyStr
}

type UserAssignment {
  user: NonEmptyStr
  role: NonEmptyStr
}

type PermissionAssignment {
  permission: Permission
  role: NonEmptyStr
}

type RoleInheritance {
  senior: NonEmptyStr
  junior: NonEmptyStr
}

type Session {
  user: NonEmptyStr
  active_roles: List<NonEmptyStr>
}

type RbacPolicy {
  users: List<NonEmptyStr>
  roles: List<NonEmptyStr>
  user_assignments: List<UserAssignment>
  permission_assignments: List<PermissionAssignment>
  role_hierarchy: List<RoleInheritance>
}
