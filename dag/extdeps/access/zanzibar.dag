module extdeps.access.zanzibar


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.usenix.org/conference/atc19/presentation/pang"
  }
}

type Object {
  namespace: NonEmptyStr
  id: NonEmptyStr
}

type Userset {
  object: Object
  relation: NonEmptyStr
}

type User
  = UserId { id: NonEmptyStr }
  | UsersetUser { userset: Userset }

type RelationTuple {
  object: Object
  relation: NonEmptyStr
  user: User
}

type UsersetRewrite
  = This
  | ComputedUserset { relation: NonEmptyStr }
  | TupleToUserset { tupleset: NonEmptyStr, computed: NonEmptyStr }
  | Union { children: List<UsersetRewrite> }
  | Intersection { children: List<UsersetRewrite> }
  | Exclusion { base: UsersetRewrite, subtract: UsersetRewrite }

type RelationConfig {
  relation: NonEmptyStr
  rewrite: UsersetRewrite
}

type NamespaceConfig {
  namespace: NonEmptyStr
  relations: List<RelationConfig>
}

type Zookie {
  token: NonEmptyStr
}

type CheckRequest {
  object: Object
  relation: NonEmptyStr
  user: User
  at: Zookie
}
