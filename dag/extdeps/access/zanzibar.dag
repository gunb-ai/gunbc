module extdeps.access.zanzibar


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.usenix.org/conference/atc19/presentation/pang"
  }
}

type Object {
  namespace: std.types.NonEmptyStr
  id: std.types.NonEmptyStr
}

type Userset {
  object: Object
  relation: std.types.NonEmptyStr
}

type User
  = UserId { id: std.types.NonEmptyStr }
  | UsersetUser { userset: Userset }

type RelationTuple {
  object: Object
  relation: std.types.NonEmptyStr
  user: User
}

type UsersetRewrite
  = This
  | ComputedUserset { relation: std.types.NonEmptyStr }
  | TupleToUserset { tupleset: std.types.NonEmptyStr, computed: std.types.NonEmptyStr }
  | Union { children: List<UsersetRewrite> }
  | Intersection { children: List<UsersetRewrite> }
  | Exclusion { base: UsersetRewrite, subtract: UsersetRewrite }

type RelationConfig {
  relation: std.types.NonEmptyStr
  rewrite: UsersetRewrite
}

type NamespaceConfig {
  namespace: std.types.NonEmptyStr
  relations: List<RelationConfig>
}

type Zookie {
  token: std.types.NonEmptyStr
}

type CheckRequest {
  object: Object
  relation: std.types.NonEmptyStr
  user: User
  at: Zookie
}
