module extdeps.access.posix_effective_principal



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/whoami.html"
  }
}

// Read the effective POSIX user name (whoami utility semantics). Interface shape and result decoding live here; typed argv transport lives in extdeps.access.posix_effective_principal_read_op at the realization edge. EffectivePosixPrincipalName is opaque outside this authority, so downstream principal projections can consume only a successful, non-empty decoded read observation rather than pairing the request token with an authored name.
type EffectivePosixPrincipalRead {}

type EffectivePosixPrincipalReadOutcome {
  read: EffectivePosixPrincipalRead
  exit_code: Int
  success: Bool
  stdout: String
  stderr: String
}

type EffectivePosixPrincipalName nominal_opaque = std.types.NonEmptyStr

type EffectivePosixPrincipalObservation {
  read: EffectivePosixPrincipalRead
  effective_name: EffectivePosixPrincipalName
}

type EffectivePosixPrincipalObservationResult
  = EffectivePosixPrincipalObserved { observation: EffectivePosixPrincipalObservation }
  | EffectivePosixPrincipalObservationRefused { read: EffectivePosixPrincipalRead, reason: String }

fn effective_posix_principal_observation(
  outcome: EffectivePosixPrincipalReadOutcome,
) -> EffectivePosixPrincipalObservationResult {
  let name = std.algebra.trim(s: outcome.stdout)
  if !outcome.success || outcome.exit_code != 0 {
    EffectivePosixPrincipalObservationRefused { read: outcome.read, reason: outcome.stderr }
  } else if name == "" {
    EffectivePosixPrincipalObservationRefused {
      read: outcome.read,
      reason: "successful effective-principal read returned no name",
    }
  } else {
    EffectivePosixPrincipalObserved { observation: EffectivePosixPrincipalObservation {
      read: outcome.read,
      effective_name: (name as std.types.NonEmptyStr) as EffectivePosixPrincipalName,
    } }
  }
}

fn effective_posix_principal_name(
  observation: EffectivePosixPrincipalObservation,
) -> std.types.NonEmptyStr {
  observation.effective_name as std.types.NonEmptyStr
}
