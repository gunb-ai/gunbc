module extdeps.access.posix_effective_principal_read_op


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/whoami.html"
  }
}

data posix_effective_principal_read_op_note: String = "Typed argv transport for access.PosixEffectivePrincipal.Read — program+args dispatch at the realization edge without shell.Exec.Run (Wave C5 / bash-emit #5828 slice). Hermetic realization refuses this external identity observation; its mock response is a failed read and cannot become principal evidence."

fn posix_effective_principal_read_argv() -> List<String> {
  ["whoami"]
}

func effective_posix_principal_read(
  read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead,
) -> extdeps.access.posix_effective_principal.EffectivePosixPrincipalReadOutcome {
  let result = access.PosixEffectivePrincipal.Read(read: read)
  return extdeps.access.posix_effective_principal.EffectivePosixPrincipalReadOutcome {
    read: read,
    exit_code: result.exit_code,
    success: result.success,
    stdout: result.stdout,
    stderr: result.stderr,
  }
}

service access.PosixEffectivePrincipal {
  operation Read {
    input { read: extdeps.access.posix_effective_principal.EffectivePosixPrincipalRead }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly

    transport shell { argv: ["whoami"] }
    exit {
      0 => Unit
      nonzero => String "whoami failed"
    }
    mock_response {
      0 => { exit_code: 1, success: false, stdout: "", stderr: "hermetic effective-principal observation unavailable" } "hermetic access.PosixEffectivePrincipal.Read refuses external identity observation"
    }
  }
}
