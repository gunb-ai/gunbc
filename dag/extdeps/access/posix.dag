module extdeps.access.posix


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/basedefs/sys_stat.h.html"
  }
}

type PermissionBits {
  read: Bool
  write: Bool
  execute: Bool
}

type FileMode {
  owner: PermissionBits
  group: PermissionBits
  other: PermissionBits
  setuid: Bool
  setgid: Bool
  sticky: Bool
}

type FileOwnership {
  uid: Int
  gid: Int
}

type FilePermissions {
  ownership: FileOwnership
  mode: FileMode
}

// THE LOGIN-NAME LEXICAL AUTHORITY, cited rather than conventional. POSIX defines a user name as a
// string; portability constrains it to the PORTABLE FILENAME CHARACTER SET -- A-Z a-z 0-9 period
// underscore hyphen -- and a name should not begin with a hyphen, because a leading hyphen is
// indistinguishable from an option to the utilities that consume it (Open Group Base
// Specifications, Definitions: User Name, Portable Filename Character Set).
//
// This exists as its OWN type because NonEmptyStr plus an informal convention is not a lexical
// authority: it admits a name with a space, a slash, or a leading hyphen, and the first place that
// fails is an argv on a live host. It is deliberately NOT shared with DnsLabel -- DNS labels and
// POSIX login names have different grammars, different length limits and different external
// authorities, so one string validator over both would be a nickname for two concepts.
type PosixLoginName = std.types.NonEmptyStr where brand("PosixLoginName")

fn posix_login_name_code_point_admitted(cp: Int) -> Bool {
  (cp >= 97 && cp <= 122)
    || (cp >= 65 && cp <= 90)
    || (cp >= 48 && cp <= 57)
    || cp == 46
    || cp == 95
    || cp == 45
}

// The login shell is part of the passwd entry and it is LOAD-BEARING, not cosmetic: sshd refuses
// remote command execution for an account whose shell is a nologin binary, so an account can exist,
// carry the right key, and still be unusable for the exact thing automation needs. A model without
// this field cannot express the difference between "the account is present" and "the account can
// run a command", which is a wall a fleet session hit live rather than a hypothetical.
//
// It is an OBSERVATION, not a required literal, because most rows in this repository were authored
// without anyone reading /etc/passwd. Forcing a value would have made three unobserved shells get
// invented to satisfy the type, which is how the uid rows beside them went wrong.
type PosixLoginShell
  = LoginShellObserved { path: std.types.NonEmptyStr }
  | LoginShellUnobserved

// The nologin family exits immediately, so sshd cannot run a command under it. Cited by behaviour
// rather than by path convention: the check is against the known refusing binaries, and an
// unobserved shell answers false because "we did not look" is not "it works".
fn posix_shell_permits_command_execution(shell: PosixLoginShell) -> Bool {
  match shell {
    LoginShellUnobserved => false
    LoginShellObserved { path: p } =>
      (p as String) != "/usr/sbin/nologin"
        && (p as String) != "/sbin/nologin"
        && (p as String) != "/bin/false"
        && (p as String) != "/usr/bin/false"
  }
}

type PosixUser {
  name: std.types.NonEmptyStr
  uid: Int
  gid: Int
  shell: PosixLoginShell
}


data posix_root_uid: Int = 0

fn posix_user_is_root(user: PosixUser) -> Bool {
  user.uid == posix_root_uid
}

data file_mode_octal_note: String = "The octal spelling is a SERIALIZATION of FileMode, not a second representation of it — the same relation hex has to an sRGB triple. chmod's numeric mode is four octal digits, most significant first: setuid/setgid/sticky, then the owner, group, and other classes, each digit the sum read=4 + write=2 + execute=1 (Open Group sys/stat.h, the authority this module is anchored to). All four digits are rendered rather than the three this repo's callers happen to need today, because a serializer that silently dropped the special-bits digit would emit a mode that means something else the moment setgid is set — the leading digit is 0 here by computation, never by assumption. This exists because FilePermissions had no way to reach a host argv, which is a large part of why it sat modeled and unconsumed."

fn permission_bits_octal_digit(bits: PermissionBits) -> Int {
  let r = if bits.read { 4 } else { 0 }
  let w = if bits.write { 2 } else { 0 }
  let x = if bits.execute { 1 } else { 0 }
  r + w + x
}

fn file_mode_special_octal_digit(mode: FileMode) -> Int {
  let s = if mode.setuid { 4 } else { 0 }
  let g = if mode.setgid { 2 } else { 0 }
  let t = if mode.sticky { 1 } else { 0 }
  s + g + t
}

fn file_mode_octal(mode: FileMode) -> String {
  join([
    to_string(file_mode_special_octal_digit(mode: mode)),
    to_string(permission_bits_octal_digit(bits: mode.owner)),
    to_string(permission_bits_octal_digit(bits: mode.group)),
    to_string(permission_bits_octal_digit(bits: mode.other)),
  ], "")
}
