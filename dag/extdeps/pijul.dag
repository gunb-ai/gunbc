module extdeps.pijul

import std.types { NonEmptyStr, Bytes, Timestamp, Map }
import std.integer { NonNegativeInt, UInt8 }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "static.crates.io/crates/pijul/pijul-1.0.0-beta.20.crate#pijul-1.0.0-beta.20/README.md"
  }
}

data pijul_channels_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "static.crates.io/crates/pijul/pijul-1.0.0-beta.20.crate#pijul-1.0.0-beta.20/src/commands/channel.rs"
  }
}

data pijul_theory_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "static.crates.io/crates/pijul-core/pijul-core-1.0.0-beta.20.crate#pijul-core-1.0.0-beta.20/src/change.rs"
  }
}

data pijul_conflicts_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "static.crates.io/crates/pijul-core/pijul-core-1.0.0-beta.20.crate#pijul-core-1.0.0-beta.20/src/alive/output.rs"
  }
}

data pijul_apply_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "static.crates.io/crates/pijul-core/pijul-core-1.0.0-beta.20.crate#pijul-core-1.0.0-beta.20/src/apply.rs"
  }
}

data pijul_partial_clone_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "static.crates.io/crates/pijul/pijul-1.0.0-beta.20.crate#pijul-1.0.0-beta.20/src/commands/clone.rs"
  }
}

type PijulUpstreamVersion {
  major: NonNegativeInt
  minor: NonNegativeInt
  patch: NonNegativeInt
  beta: NonNegativeInt
}

data pijul_upstream_version: PijulUpstreamVersion = PijulUpstreamVersion {
  major: 1
  minor: 0
  patch: 0
  beta: 20
}

data pijul_upstream_cli_version: NonEmptyStr = "pijul 1.0.0-beta.20"

data pijul_upstream_version_note: NonEmptyStr = "This R0 authority models Pijul CLI and pijul-core 1.0.0-beta.20. Every external anchor resolves into an immutable exact-version crates.io archive, and the wet receipt refuses any CLI version other than pijul 1.0.0-beta.20."

data pijul_timestamp_non_authority_note: NonEmptyStr = "Pijul change timestamps are retained as authored metadata and provenance only. They never order delivery, choose a channel state, satisfy a dependency, or break a tie."

type PijulChangeHash = NonEmptyStr where brand("PijulChangeHash")
type PijulStateHash = NonEmptyStr where brand("PijulStateHash")
type PijulChannelName = NonEmptyStr where brand("PijulChannelName")
type PijulInode = NonEmptyStr where brand("PijulInode")

type PijulPath {
  octets: List<UInt8>
}

type PijulVertexPosition {
  value: NonNegativeInt
}

type PijulVertexId {
  introduced_by: PijulChangeHash
  position: PijulVertexPosition
}

type PijulChangeIdentityProducer
  = PijulChangeFileObserved { pijul_version: PijulUpstreamVersion }

type PijulChangeIdentity {
  hash: PijulChangeHash
  producer: PijulChangeIdentityProducer
}

type PijulDependencyKind
  = PijulStructuralDependency
  | PijulExtraDependency

type PijulDependency {
  change: PijulChangeHash
  kind: PijulDependencyKind
}

type PijulContext {
  vertex: PijulVertexId
}

type PijulEdgeDisposition
  = PijulAliveEdge
  | PijulDeletedEdge

type PijulGraphEdge {
  source: PijulVertexId
  target: PijulVertexId
  introduced_by: PijulChangeHash
  disposition: PijulEdgeDisposition
}

type PijulChangeAction
  = PijulNewVertex {
      vertex: PijulVertexId,
      up_context: List<PijulContext>,
      down_context: List<PijulContext>,
      content: Bytes,
    }
  | PijulMapEdge {
      edge: PijulGraphEdge,
      from: PijulEdgeDisposition,
      to: PijulEdgeDisposition,
    }

type PijulChangeActionFold<R> {
  new_vertex: fn(
    PijulVertexId,
    List<PijulContext>,
    List<PijulContext>,
    Bytes,
  ) -> R
  map_edge: fn(
    PijulGraphEdge,
    PijulEdgeDisposition,
    PijulEdgeDisposition,
  ) -> R
}

fn pijul_change_action_fold<R>(
  action: PijulChangeAction,
  fold: PijulChangeActionFold<R>,
) -> R {
  match action {
    PijulNewVertex { vertex, up_context, down_context, content } =>
      fold.new_vertex(vertex, up_context, down_context, content)
    PijulMapEdge { edge, from, to } =>
      fold.map_edge(edge, from, to)
  }
}

type PijulRecordedChange {
  identity: PijulChangeIdentity
  dependencies: List<PijulDependency>
  actions: List<PijulChangeAction>
  authors: List<NonEmptyStr>
  message: NonEmptyStr
  recorded_at: Timestamp
}

type PijulGraphVertex {
  id: PijulVertexId
  content: Bytes
}

type PijulConflictFact
  = PijulOrderConflict {
      left: PijulChangeHash,
      right: PijulChangeHash,
      at: PijulVertexId,
    }
  | PijulCycleConflict {
      changes: List<PijulChangeHash>,
      vertices: List<PijulVertexId>,
    }
  | PijulZombieConflict {
      introduced_by: PijulChangeHash,
      vertex: PijulVertexId,
    }
  | PijulNameConflict {
      left: PijulChangeHash,
      right: PijulChangeHash,
      path: PijulPath,
    }
  | PijulMoveConflict {
      changes: List<PijulChangeHash>,
      inode: PijulInode,
      paths: List<PijulPath>,
    }

type PijulConflictFactFold<R> {
  order: fn(PijulChangeHash, PijulChangeHash, PijulVertexId) -> R
  cycle: fn(List<PijulChangeHash>, List<PijulVertexId>) -> R
  zombie: fn(PijulChangeHash, PijulVertexId) -> R
  name: fn(PijulChangeHash, PijulChangeHash, PijulPath) -> R
  move: fn(List<PijulChangeHash>, PijulInode, List<PijulPath>) -> R
}

fn pijul_conflict_fact_fold<R>(
  conflict: PijulConflictFact,
  fold: PijulConflictFactFold<R>,
) -> R {
  match conflict {
    PijulOrderConflict { left, right, at } =>
      fold.order(left, right, at)
    PijulCycleConflict { changes, vertices } =>
      fold.cycle(changes, vertices)
    PijulZombieConflict { introduced_by, vertex } =>
      fold.zombie(introduced_by, vertex)
    PijulNameConflict { left, right, path } =>
      fold.name(left, right, path)
    PijulMoveConflict { changes, inode, paths } =>
      fold.move(changes, inode, paths)
  }
}

type PijulPristineState {
  vertices: List<PijulGraphVertex>
  edges: List<PijulGraphEdge>
  conflicts: List<PijulConflictFact>
}

type PijulTreeEntryKind
  = PijulDirectoryEntry
  | PijulFileEntry
  | PijulSymlinkEntry

type PijulTreeEntry {
  inode: PijulInode
  path: PijulPath
  kind: PijulTreeEntryKind
  introduced_by: PijulChangeHash
}

type PijulTree {
  entries: List<PijulTreeEntry>
}

type PijulWorkingCopyDisposition
  = PijulWorkingCopyClean
  | PijulWorkingCopyModified
  | PijulWorkingCopyUntracked

type PijulWorkingCopyEntry {
  path: PijulPath
  content: Bytes
  disposition: PijulWorkingCopyDisposition
}

type PijulWorkingCopy {
  entries: List<PijulWorkingCopyEntry>
}

type PijulStateIdentityProducer
  = PijulLogStateObserved { pijul_version: PijulUpstreamVersion }

type PijulChannelStateIdentity {
  state: PijulStateHash
  changes: List<PijulChangeHash>
  producer: PijulStateIdentityProducer
}

type PijulChannel {
  name: PijulChannelName
  state_identity: PijulChannelStateIdentity
}

type PijulRepositoryState {
  changes: List<PijulRecordedChange>
  pristine: PijulPristineState
  tree: PijulTree
  working_copy: PijulWorkingCopy
  channels: List<PijulChannel>
  current_channel: PijulChannelName
}

type PijulRepositoryProjection
  = PijulCompleteProjection {
      candidate: PijulRepositoryState,
    }
  | PijulPartialProjection {
      candidate: PijulRepositoryState,
      missing_changes: List<PijulChangeHash>,
      missing_vertices: List<PijulVertexId>,
      missing_paths: List<PijulPath>,
    }
  | PijulInaccessibleProjection { reason: NonEmptyStr }

type PijulRepositoryProjectionFold<R> {
  complete: fn(PijulRepositoryState) -> R
  partial: fn(
    PijulRepositoryState,
    List<PijulChangeHash>,
    List<PijulVertexId>,
    List<PijulPath>,
  ) -> R
  inaccessible: fn(NonEmptyStr) -> R
}

fn pijul_repository_projection_fold<R>(
  projection: PijulRepositoryProjection,
  fold: PijulRepositoryProjectionFold<R>,
) -> R {
  match projection {
    PijulCompleteProjection { candidate } => fold.complete(candidate)
    PijulPartialProjection {
      candidate,
      missing_changes,
      missing_vertices,
      missing_paths,
    } => fold.partial(
      candidate,
      missing_changes,
      missing_vertices,
      missing_paths,
    )
    PijulInaccessibleProjection { reason } => fold.inaccessible(reason)
  }
}

type PijulDecodedAvailability
  = PijulDecodedComplete
  | PijulDecodedPartial {
      missing_changes: List<PijulChangeHash>,
      missing_vertices: List<PijulVertexId>,
      missing_paths: List<PijulPath>,
    }

type PijulDecodedRepository {
  state: PijulRepositoryState
  availability: PijulDecodedAvailability
}

type PijulReferenceOrigin
  = PijulDependencyReference { owner: PijulChangeHash }
  | PijulContextChangeReference { owner: PijulChangeHash }
  | PijulChannelMemberReference { channel: PijulChannelName }
  | PijulTreeChangeReference { path: PijulPath }
  | PijulConflictChangeReference

type PijulProjectionRefusal
  = PijulDuplicateChange { change: PijulChangeHash }
  | PijulDuplicateChannel { channel: PijulChannelName }
  | PijulDuplicateChannelMember {
      channel: PijulChannelName,
      change: PijulChangeHash,
    }
  | PijulMissingChange {
      change: PijulChangeHash,
      origin: PijulReferenceOrigin,
    }
  | PijulSelfDependency { change: PijulChangeHash }
  | PijulMissingContext {
      owner: PijulChangeHash,
      vertex: PijulVertexId,
    }
  | PijulDuplicateVertex { vertex: PijulVertexId }
  | PijulDuplicateTreePath { path: PijulPath }
  | PijulDuplicateTreeInode { inode: PijulInode }
  | PijulDuplicateWorkingCopyPath { path: PijulPath }
  | PijulPresentChangeDeclaredMissing { change: PijulChangeHash }
  | PijulPresentVertexDeclaredMissing { vertex: PijulVertexId }
  | PijulPresentPathDeclaredMissing { path: PijulPath }
  | PijulStateIdentityCollision {
      state: PijulStateHash,
      left: PijulChannelName,
      right: PijulChannelName,
    }
  | PijulStateIdentityDivergence {
      left_state: PijulStateHash,
      right_state: PijulStateHash,
      left: PijulChannelName,
      right: PijulChannelName,
    }
  | PijulCurrentChannelMissing { channel: PijulChannelName }
  | PijulInaccessible { reason: NonEmptyStr }

type PijulRepositoryDecodeOutcome
  = PijulDecoded { repository: PijulDecodedRepository }
  | PijulDecodeRefused { cause: PijulProjectionRefusal }

type PijulProjectionOutcome
  = PijulProjected { projection: PijulRepositoryProjection }
  | PijulProjectionRefused { cause: PijulProjectionRefusal }

fn pijul_change_hash(change: PijulRecordedChange) -> PijulChangeHash {
  change.identity.hash
}

fn pijul_change_hashes(changes: List<PijulRecordedChange>) -> List<PijulChangeHash> {
  changes |> map(change => pijul_change_hash(change: change))
}

fn pijul_hash_count(
  changes: List<PijulChangeHash>,
  target: PijulChangeHash,
) -> NonNegativeInt {
  changes |> filter(change => change == target) |> count
}

fn pijul_hash_present(
  changes: List<PijulChangeHash>,
  target: PijulChangeHash,
) -> Bool {
  pijul_hash_count(changes: changes, target: target) > 0
}

type PijulUniqueScan<K> {
  seen: Map<K, Bool>
  ordered: List<K>
  duplicate: K?
}

fn pijul_unique_scan_step<K>(
  scan: PijulUniqueScan<K>,
  item: K,
) -> PijulUniqueScan<K> {
  if map_contains_key(scan.seen, item) {
    PijulUniqueScan {
      seen: scan.seen,
      ordered: scan.ordered,
      duplicate: match scan.duplicate {
        Present { value } => Present { value: value }
        Absent => Present { value: item }
      },
    }
  } else {
    PijulUniqueScan {
      seen: map_insert(scan.seen, item, true),
      ordered: list_push(scan.ordered, item),
      duplicate: scan.duplicate,
    }
  }
}

fn pijul_scan_unique<K>(items: List<K>) -> PijulUniqueScan<K> {
  fold(
    items,
    init: PijulUniqueScan {
      seen: empty_map(),
      ordered: [],
      duplicate: Absent,
    },
    f: pijul_unique_scan_step,
  )
}

fn pijul_change_sets_equal(
  left: List<PijulChangeHash>,
  right: List<PijulChangeHash>,
) -> Bool {
  let left_scan = pijul_scan_unique(items: left)
  let right_scan = pijul_scan_unique(items: right)
  count(left) == count(right)
    && left_scan.duplicate == Absent
    && right_scan.duplicate == Absent
    && all(
      left,
      change => map_contains_key(right_scan.seen, change),
    )
}

fn pijul_change_set_union(
  left: List<PijulChangeHash>,
  right: List<PijulChangeHash>,
) -> List<PijulChangeHash> {
  pijul_scan_unique(items: concat(left, right)).ordered
}

fn pijul_change_known_or_declared_missing(
  state: PijulRepositoryState,
  missing_changes: List<PijulChangeHash>,
  change: PijulChangeHash,
) -> Bool {
  pijul_hash_present(
    changes: pijul_change_hashes(changes: state.changes),
    target: change,
  )
    || pijul_hash_present(
      changes: missing_changes,
      target: change,
    )
}

fn pijul_vertex_present(
  pristine: PijulPristineState,
  vertex: PijulVertexId,
) -> Bool {
  pristine.vertices |> filter(found => found.id == vertex) |> count > 0
}

fn pijul_vertex_known_or_declared_missing(
  state: PijulRepositoryState,
  missing_vertices: List<PijulVertexId>,
  vertex: PijulVertexId,
) -> Bool {
  pijul_vertex_present(pristine: state.pristine, vertex: vertex)
    || missing_vertices
      |> filter(missing => missing == vertex)
      |> count > 0
}

type PijulDuplicateChangeIssue {
  change: PijulChangeHash
}

fn pijul_duplicate_change(
  changes: List<PijulRecordedChange>,
) -> PijulDuplicateChangeIssue? {
  match pijul_scan_unique(
    items: pijul_change_hashes(changes: changes),
  ).duplicate {
    Present { value } =>
      Present { value: PijulDuplicateChangeIssue { change: value } }
    Absent => Absent
  }
}

type PijulDuplicateChannelIssue {
  channel: PijulChannelName
}

fn pijul_duplicate_channel(
  channels: List<PijulChannel>,
) -> PijulDuplicateChannelIssue? {
  match pijul_scan_unique(
    items: channels |> map(channel => channel.name),
  ).duplicate {
    Present { value } =>
      Present { value: PijulDuplicateChannelIssue { channel: value } }
    Absent => Absent
  }
}

type PijulDuplicateChannelMemberIssue {
  channel: PijulChannelName
  change: PijulChangeHash
}

fn pijul_duplicate_channel_member(
  channels: List<PijulChannel>,
) -> PijulDuplicateChannelMemberIssue? {
  fold(
    channels,
    init: Absent,
    f: fn(found, channel) {
      match found {
        Present { value } => Present { value: value }
        Absent =>
          match pijul_scan_unique(
            items: channel.state_identity.changes,
          ).duplicate {
            Present { value } => Present {
              value: PijulDuplicateChannelMemberIssue {
                channel: channel.name,
                change: value,
              },
            }
            Absent => Absent
          }
      }
    },
  )
}

type PijulMissingChangeIssue {
  change: PijulChangeHash
  origin: PijulReferenceOrigin
}

fn pijul_missing_dependency_issue(
  state: PijulRepositoryState,
  missing_changes: List<PijulChangeHash>,
) -> PijulMissingChangeIssue? {
  state.changes
    |> flat_map(change =>
      change.dependencies
        |> filter(dependency =>
          !pijul_change_known_or_declared_missing(
            state: state,
            missing_changes: missing_changes,
            change: dependency.change,
          )
        )
        |> map(dependency => PijulMissingChangeIssue {
          change: dependency.change,
          origin: PijulDependencyReference {
            owner: pijul_change_hash(change: change)
          },
        })
    )
    |> first
}

type PijulSelfDependencyIssue {
  change: PijulChangeHash
}

fn pijul_self_dependency(
  changes: List<PijulRecordedChange>,
) -> PijulSelfDependencyIssue? {
  changes
    |> filter(change =>
      change.dependencies
        |> filter(dependency => dependency.change == pijul_change_hash(change: change))
        |> count > 0
    )
    |> map(change => PijulSelfDependencyIssue {
      change: pijul_change_hash(change: change)
    })
    |> first
}

fn pijul_action_contexts(action: PijulChangeAction) -> List<PijulContext> {
  pijul_change_action_fold(
    action: action,
    fold: PijulChangeActionFold {
      new_vertex: pijul_new_vertex_contexts,
      map_edge: pijul_map_edge_contexts,
    },
  )
}

fn pijul_new_vertex_contexts(
  vertex: PijulVertexId,
  up_context: List<PijulContext>,
  down_context: List<PijulContext>,
  content: Bytes,
) -> List<PijulContext> {
  append(up_context, items: down_context)
}

fn pijul_map_edge_contexts(
  edge: PijulGraphEdge,
  from: PijulEdgeDisposition,
  to: PijulEdgeDisposition,
) -> List<PijulContext> {
  [
    PijulContext { vertex: edge.source },
    PijulContext { vertex: edge.target },
  ]
}

type PijulMissingContextIssue {
  owner: PijulChangeHash
  vertex: PijulVertexId
}

fn pijul_missing_context_issue(
  state: PijulRepositoryState,
  missing_vertices: List<PijulVertexId>,
) -> PijulMissingContextIssue? {
  state.changes
    |> flat_map(change =>
      change.actions
        |> flat_map(action => pijul_action_contexts(action: action))
        |> filter(context =>
          !pijul_vertex_known_or_declared_missing(
            state: state,
            missing_vertices: missing_vertices,
            vertex: context.vertex,
          )
        )
        |> map(context => PijulMissingContextIssue {
          owner: pijul_change_hash(change: change),
          vertex: context.vertex,
        })
    )
    |> first
}

type PijulDuplicateVertexIssue {
  vertex: PijulVertexId
}

fn pijul_duplicate_vertex(
  pristine: PijulPristineState,
) -> PijulDuplicateVertexIssue? {
  match pijul_scan_unique(
    items: pristine.vertices |> map(vertex => vertex.id),
  ).duplicate {
    Present { value } =>
      Present { value: PijulDuplicateVertexIssue { vertex: value } }
    Absent => Absent
  }
}

type PijulDuplicateTreePathIssue {
  path: PijulPath
}

fn pijul_duplicate_tree_path(tree: PijulTree) -> PijulDuplicateTreePathIssue? {
  match pijul_scan_unique(
    items: tree.entries |> map(entry => entry.path),
  ).duplicate {
    Present { value } =>
      Present { value: PijulDuplicateTreePathIssue { path: value } }
    Absent => Absent
  }
}

type PijulDuplicateTreeInodeIssue {
  inode: PijulInode
}

fn pijul_duplicate_tree_inode(tree: PijulTree) -> PijulDuplicateTreeInodeIssue? {
  match pijul_scan_unique(
    items: tree.entries |> map(entry => entry.inode),
  ).duplicate {
    Present { value } =>
      Present { value: PijulDuplicateTreeInodeIssue { inode: value } }
    Absent => Absent
  }
}

type PijulDuplicateWorkingCopyPathIssue {
  path: PijulPath
}

fn pijul_duplicate_working_copy_path(
  working_copy: PijulWorkingCopy,
) -> PijulDuplicateWorkingCopyPathIssue? {
  match pijul_scan_unique(
    items: working_copy.entries |> map(entry => entry.path),
  ).duplicate {
    Present { value } =>
      Present { value: PijulDuplicateWorkingCopyPathIssue { path: value } }
    Absent => Absent
  }
}

fn pijul_missing_channel_member_issue(
  state: PijulRepositoryState,
  missing_changes: List<PijulChangeHash>,
) -> PijulMissingChangeIssue? {
  state.channels
    |> flat_map(channel =>
      channel.state_identity.changes
        |> filter(change =>
          !pijul_change_known_or_declared_missing(
            state: state,
            missing_changes: missing_changes,
            change: change,
          )
        )
        |> map(change => PijulMissingChangeIssue {
          change: change,
          origin: PijulChannelMemberReference { channel: channel.name },
        })
    )
    |> first
}

fn pijul_conflict_changes(conflict: PijulConflictFact) -> List<PijulChangeHash> {
  pijul_conflict_fact_fold(
    conflict: conflict,
    fold: PijulConflictFactFold {
      order: fn(left, right, _) { [left, right] },
      cycle: fn(changes, _) { changes },
      zombie: fn(introduced_by, _) { [introduced_by] },
      name: fn(left, right, _) { [left, right] },
      move: fn(changes, _, _) { changes },
    },
  )
}

fn pijul_missing_conflict_change_issue(
  state: PijulRepositoryState,
  missing_changes: List<PijulChangeHash>,
) -> PijulMissingChangeIssue? {
  state.pristine.conflicts
    |> flat_map(conflict => pijul_conflict_changes(conflict: conflict))
    |> filter(change =>
      !pijul_change_known_or_declared_missing(
        state: state,
        missing_changes: missing_changes,
        change: change,
      )
    )
    |> map(change => PijulMissingChangeIssue {
      change: change,
      origin: PijulConflictChangeReference,
    })
    |> first
}

fn pijul_missing_tree_change_issue(
  state: PijulRepositoryState,
  missing_changes: List<PijulChangeHash>,
) -> PijulMissingChangeIssue? {
  state.tree.entries
    |> filter(entry =>
      !pijul_change_known_or_declared_missing(
        state: state,
        missing_changes: missing_changes,
        change: entry.introduced_by,
      )
    )
    |> map(entry => PijulMissingChangeIssue {
      change: entry.introduced_by,
      origin: PijulTreeChangeReference { path: entry.path },
    })
    |> first
}

fn pijul_find_channel(
  channels: List<PijulChannel>,
  name: PijulChannelName,
) -> PijulChannel? {
  channels |> filter(channel => channel.name == name) |> first
}

type PijulStateIdentityIssue
  = PijulStateCollisionIssue {
      state: PijulStateHash,
      left: PijulChannelName,
      right: PijulChannelName,
    }
  | PijulStateDivergenceIssue {
      left_state: PijulStateHash,
      right_state: PijulStateHash,
      left: PijulChannelName,
      right: PijulChannelName,
    }

fn pijul_state_identity_issue(
  channels: List<PijulChannel>,
) -> PijulStateIdentityIssue? {
  channels
    |> flat_map(left =>
      channels
        |> filter(right => !(right.name == left.name))
        |> filter(right =>
          (
            left.state_identity.state == right.state_identity.state
              && !pijul_change_sets_equal(
                left: left.state_identity.changes,
                right: right.state_identity.changes,
              )
          )
            || (
              !(left.state_identity.state == right.state_identity.state)
                && pijul_change_sets_equal(
                  left: left.state_identity.changes,
                  right: right.state_identity.changes,
                )
            )
        )
        |> map(right =>
          if left.state_identity.state == right.state_identity.state {
            PijulStateCollisionIssue {
              state: left.state_identity.state,
              left: left.name,
              right: right.name,
            }
          } else {
            PijulStateDivergenceIssue {
              left_state: left.state_identity.state,
              right_state: right.state_identity.state,
              left: left.name,
              right: right.name,
            }
          }
        )
    )
    |> first
}

type PijulPresentChangeDeclaredMissingIssue {
  change: PijulChangeHash
}

type PijulPresentVertexDeclaredMissingIssue {
  vertex: PijulVertexId
}

type PijulPresentPathDeclaredMissingIssue {
  path: PijulPath
}

fn pijul_present_change_declared_missing(
  state: PijulRepositoryState,
  missing_changes: List<PijulChangeHash>,
) -> PijulPresentChangeDeclaredMissingIssue? {
  missing_changes
    |> filter(missing =>
      pijul_hash_present(
        changes: pijul_change_hashes(changes: state.changes),
        target: missing,
      )
    )
    |> map(change => PijulPresentChangeDeclaredMissingIssue { change: change })
    |> first
}

fn pijul_present_vertex_declared_missing(
  state: PijulRepositoryState,
  missing_vertices: List<PijulVertexId>,
) -> PijulPresentVertexDeclaredMissingIssue? {
  missing_vertices
    |> filter(missing =>
      pijul_vertex_present(pristine: state.pristine, vertex: missing)
    )
    |> map(vertex => PijulPresentVertexDeclaredMissingIssue { vertex: vertex })
    |> first
}

fn pijul_present_path_declared_missing(
  state: PijulRepositoryState,
  missing_paths: List<PijulPath>,
) -> PijulPresentPathDeclaredMissingIssue? {
  let present_paths = append(
    state.tree.entries |> map(entry => entry.path),
    items: state.working_copy.entries |> map(entry => entry.path),
  )
  missing_paths
    |> filter(missing =>
      present_paths |> filter(present => present == missing) |> count > 0
    )
    |> map(path => PijulPresentPathDeclaredMissingIssue { path: path })
    |> first
}

fn pijul_decode_accessible_projection(
  candidate: PijulRepositoryState,
  availability: PijulDecodedAvailability,
  missing_changes: List<PijulChangeHash>,
  missing_vertices: List<PijulVertexId>,
) -> PijulRepositoryDecodeOutcome {
  match pijul_duplicate_change(changes: candidate.changes) {
      Present { value: issue } =>
        PijulDecodeRefused {
          cause: PijulDuplicateChange { change: issue.change }
        }
      Absent => match pijul_duplicate_channel(channels: candidate.channels) {
        Present { value: issue } =>
          PijulDecodeRefused {
            cause: PijulDuplicateChannel { channel: issue.channel }
          }
        Absent => match pijul_duplicate_channel_member(channels: candidate.channels) {
          Present { value: issue } => PijulDecodeRefused {
            cause: PijulDuplicateChannelMember {
              channel: issue.channel,
              change: issue.change,
            }
          }
          Absent => match pijul_duplicate_vertex(pristine: candidate.pristine) {
            Present { value: issue } =>
              PijulDecodeRefused {
                cause: PijulDuplicateVertex { vertex: issue.vertex }
              }
            Absent => match pijul_duplicate_tree_path(tree: candidate.tree) {
              Present { value: issue } =>
                PijulDecodeRefused {
                  cause: PijulDuplicateTreePath { path: issue.path }
                }
              Absent => match pijul_duplicate_tree_inode(tree: candidate.tree) {
                Present { value: issue } =>
                  PijulDecodeRefused {
                    cause: PijulDuplicateTreeInode { inode: issue.inode }
                  }
                Absent => match pijul_duplicate_working_copy_path(
                  working_copy: candidate.working_copy,
                ) {
                  Present { value: issue } => PijulDecodeRefused {
                    cause: PijulDuplicateWorkingCopyPath { path: issue.path }
                  }
                  Absent => match pijul_self_dependency(changes: candidate.changes) {
                    Present { value: issue } => PijulDecodeRefused {
                      cause: PijulSelfDependency { change: issue.change }
                    }
                    Absent => match pijul_missing_dependency_issue(
                      state: candidate,
                      missing_changes: missing_changes,
                    ) {
                      Present { value: issue } => PijulDecodeRefused {
                        cause: PijulMissingChange {
                          change: issue.change,
                          origin: issue.origin,
                        }
                      }
                      Absent => match pijul_missing_context_issue(
                        state: candidate,
                        missing_vertices: missing_vertices,
                      ) {
                        Present { value: issue } => PijulDecodeRefused {
                          cause: PijulMissingContext {
                            owner: issue.owner,
                            vertex: issue.vertex,
                          }
                        }
                        Absent => match pijul_missing_channel_member_issue(
                          state: candidate,
                          missing_changes: missing_changes,
                        ) {
                          Present { value: issue } => PijulDecodeRefused {
                            cause: PijulMissingChange {
                              change: issue.change,
                              origin: issue.origin,
                            }
                          }
                          Absent => match pijul_missing_tree_change_issue(
                            state: candidate,
                            missing_changes: missing_changes,
                          ) {
                            Present { value: issue } => PijulDecodeRefused {
                              cause: PijulMissingChange {
                                change: issue.change,
                                origin: issue.origin,
                              }
                            }
                            Absent => match pijul_missing_conflict_change_issue(
                              state: candidate,
                              missing_changes: missing_changes,
                            ) {
                              Present { value: issue } => PijulDecodeRefused {
                                cause: PijulMissingChange {
                                  change: issue.change,
                                  origin: issue.origin,
                                }
                              }
                              Absent => match pijul_state_identity_issue(
                                channels: candidate.channels,
                              ) {
                                Present { value: issue } => match issue {
                                  PijulStateCollisionIssue {
                                    state,
                                    left,
                                    right,
                                  } => PijulDecodeRefused {
                                    cause: PijulStateIdentityCollision {
                                      state: state,
                                      left: left,
                                      right: right,
                                    }
                                  }
                                  PijulStateDivergenceIssue {
                                    left_state,
                                    right_state,
                                    left,
                                    right,
                                  } => PijulDecodeRefused {
                                    cause: PijulStateIdentityDivergence {
                                      left_state: left_state,
                                      right_state: right_state,
                                      left: left,
                                      right: right,
                                    }
                                  }
                                }
                                Absent => match pijul_find_channel(
                                  channels: candidate.channels,
                                  name: candidate.current_channel,
                                ) {
                                  Present { value: _ } => PijulDecoded {
                                    repository: PijulDecodedRepository {
                                      state: candidate,
                                      availability: availability,
                                    }
                                  }
                                  Absent => PijulDecodeRefused {
                                    cause: PijulCurrentChannelMissing {
                                      channel: candidate.current_channel
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
}

fn pijul_decode_partial_projection(
  candidate: PijulRepositoryState,
  missing_changes: List<PijulChangeHash>,
  missing_vertices: List<PijulVertexId>,
  missing_paths: List<PijulPath>,
) -> PijulRepositoryDecodeOutcome {
  match pijul_present_change_declared_missing(
    state: candidate,
    missing_changes: missing_changes,
  ) {
    Present { value: issue } => PijulDecodeRefused {
      cause: PijulPresentChangeDeclaredMissing { change: issue.change }
    }
    Absent => match pijul_present_vertex_declared_missing(
      state: candidate,
      missing_vertices: missing_vertices,
    ) {
      Present { value: issue } => PijulDecodeRefused {
        cause: PijulPresentVertexDeclaredMissing { vertex: issue.vertex }
      }
      Absent => match pijul_present_path_declared_missing(
        state: candidate,
        missing_paths: missing_paths,
      ) {
        Present { value: issue } => PijulDecodeRefused {
          cause: PijulPresentPathDeclaredMissing { path: issue.path }
        }
        Absent => pijul_decode_accessible_projection(
          candidate: candidate,
          availability: PijulDecodedPartial {
            missing_changes: missing_changes,
            missing_vertices: missing_vertices,
            missing_paths: missing_paths,
          },
          missing_changes: missing_changes,
          missing_vertices: missing_vertices,
        )
      }
    }
  }
}

fn pijul_decode_projection(
  projection: PijulRepositoryProjection,
) -> PijulRepositoryDecodeOutcome {
  pijul_repository_projection_fold(
    projection: projection,
    fold: PijulRepositoryProjectionFold {
      complete: fn(candidate) {
        pijul_decode_accessible_projection(
          candidate: candidate,
          availability: PijulDecodedComplete,
          missing_changes: [],
          missing_vertices: [],
        )
      },
      partial: fn(candidate, missing_changes, missing_vertices, missing_paths) {
        pijul_decode_partial_projection(
          candidate: candidate,
          missing_changes: missing_changes,
          missing_vertices: missing_vertices,
          missing_paths: missing_paths,
        )
      },
      inaccessible: fn(reason) {
        PijulDecodeRefused {
          cause: PijulInaccessible { reason: reason }
        }
      },
    },
  )
}

fn pijul_project_repository(
  repository: PijulRepositoryState,
) -> PijulProjectionOutcome {
  let projection = PijulCompleteProjection { candidate: repository }
  match pijul_decode_projection(projection: projection) {
    PijulDecoded { repository: _ } => PijulProjected { projection: projection }
    PijulDecodeRefused { cause } => PijulProjectionRefused { cause: cause }
  }
}

fn pijul_channels_equivalent(
  left: List<PijulChannel>,
  right: List<PijulChannel>,
) -> Bool {
  count(left) == count(right)
    && all(left, channel =>
      match pijul_find_channel(channels: right, name: channel.name) {
        Present { value: other } =>
          channel.state_identity.state == other.state_identity.state
            && pijul_change_sets_equal(
              left: channel.state_identity.changes,
              right: other.state_identity.changes,
            )
        Absent => false
      }
    )
}

type PijulLogHeadWire {
  change: PijulChangeHash
  state: PijulStateHash
}

type PijulLogWireRefusal
  = PijulLogHeadChangeMissing
  | PijulLogHeadChangeDuplicate
  | PijulLogHeadStateMissing
  | PijulLogHeadStateDuplicate
  | PijulLogHashSetEmpty
  | PijulLogHashSetDuplicate { change: PijulChangeHash }

type PijulLogHeadDecodeOutcome
  = PijulLogHeadDecoded { head: PijulLogHeadWire }
  | PijulLogHeadDecodeRefused { cause: PijulLogWireRefusal }

type PijulLogHashSetDecodeOutcome
  = PijulLogHashSetDecoded { changes: List<PijulChangeHash> }
  | PijulLogHashSetDecodeRefused { cause: PijulLogWireRefusal }

type PijulPrefixedLine {
  value: NonEmptyStr
}

fn pijul_prefixed_lines(
  text: String,
  prefix: NonEmptyStr,
) -> List<PijulPrefixedLine> {
  split(s: text, delimiter: "\n")
    |> map(line => trim(s: line))
    |> filter(line =>
      starts_with(s: line, prefix: prefix)
        && line.length() > prefix.length()
    )
    |> map(line => PijulPrefixedLine {
      value: substring(
        s: line,
        start: prefix.length(),
        end: line.length(),
      ) as NonEmptyStr,
    })
}

fn pijul_decode_log_head_plaintext(text: String) -> PijulLogHeadDecodeOutcome {
  let changes = pijul_prefixed_lines(text: text, prefix: "Change ")
  let states = pijul_prefixed_lines(text: text, prefix: "State: ")
  if count(changes) == 0 {
    PijulLogHeadDecodeRefused { cause: PijulLogHeadChangeMissing }
  } else if count(changes) > 1 {
    PijulLogHeadDecodeRefused { cause: PijulLogHeadChangeDuplicate }
  } else if count(states) == 0 {
    PijulLogHeadDecodeRefused { cause: PijulLogHeadStateMissing }
  } else if count(states) > 1 {
    PijulLogHeadDecodeRefused { cause: PijulLogHeadStateDuplicate }
  } else {
    match changes.first() {
      Absent => PijulLogHeadDecodeRefused { cause: PijulLogHeadChangeMissing }
      Present { value: change } => match states.first() {
        Absent => PijulLogHeadDecodeRefused { cause: PijulLogHeadStateMissing }
        Present { value: state } => PijulLogHeadDecoded {
          head: PijulLogHeadWire {
            change: change.value as PijulChangeHash,
            state: state.value as PijulStateHash,
          }
        }
      }
    }
  }
}

fn pijul_decode_hash_only_log(text: String) -> PijulLogHashSetDecodeOutcome {
  let changes = split(s: text, delimiter: "\n")
    |> map(line => trim(s: line))
    |> filter(line => line != "")
    |> map(line => line as PijulChangeHash)
  let unique = pijul_scan_unique(items: changes)
  if count(changes) == 0 {
    PijulLogHashSetDecodeRefused { cause: PijulLogHashSetEmpty }
  } else {
    match unique.duplicate {
      Present { value } => PijulLogHashSetDecodeRefused {
        cause: PijulLogHashSetDuplicate { change: value }
      }
      Absent => PijulLogHashSetDecoded { changes: changes }
    }
  }
}

type PijulChannelLogObservation {
  pijul_version: PijulUpstreamVersion
  channel: PijulChannelName
  head: PijulLogHeadWire
  changes: List<PijulChangeHash>
}

type PijulChannelLogDecodeOutcome
  = PijulChannelLogObserved { observation: PijulChannelLogObservation }
  | PijulChannelLogInvalid { cause: PijulLogWireRefusal }

fn pijul_decode_channel_log_observation(
  pijul_version: PijulUpstreamVersion,
  channel: PijulChannelName,
  head_plaintext: String,
  hash_only: String,
) -> PijulChannelLogDecodeOutcome {
  match pijul_decode_log_head_plaintext(text: head_plaintext) {
    PijulLogHeadDecodeRefused { cause } =>
      PijulChannelLogInvalid { cause: cause }
    PijulLogHeadDecoded { head } =>
      match pijul_decode_hash_only_log(text: hash_only) {
        PijulLogHashSetDecodeRefused { cause } =>
          PijulChannelLogInvalid { cause: cause }
        PijulLogHashSetDecoded { changes } =>
          if !pijul_hash_present(changes: changes, target: head.change) {
            PijulChannelLogInvalid { cause: PijulLogHeadChangeMissing }
          } else {
            PijulChannelLogObserved {
              observation: PijulChannelLogObservation {
                pijul_version: pijul_version,
                channel: channel,
                head: head,
                changes: changes,
              }
            }
          }
      }
  }
}

type PijulChannelLogMismatchAxis
  = PijulChannelLogStateMismatch
  | PijulChannelLogChangeSetMismatch

type PijulChannelLogReadBackOutcome
  = PijulChannelLogReadBackMatches {
      observation: PijulChannelLogObservation,
    }
  | PijulChannelLogReadBackMismatch {
      axis: PijulChannelLogMismatchAxis,
    }

fn pijul_assess_channel_log_read_back(
  expected: PijulChannelStateIdentity,
  observation: PijulChannelLogObservation,
) -> PijulChannelLogReadBackOutcome {
  if !(expected.state == observation.head.state) {
    PijulChannelLogReadBackMismatch { axis: PijulChannelLogStateMismatch }
  } else if !pijul_change_sets_equal(
    left: expected.changes,
    right: observation.changes,
  ) {
    PijulChannelLogReadBackMismatch {
      axis: PijulChannelLogChangeSetMismatch,
    }
  } else {
    PijulChannelLogReadBackMatches { observation: observation }
  }
}

type PijulRenderedOrderConflictObservation {
  path: PijulPath
  left: PijulChangeHash
  right: PijulChangeHash
  rendered_working_copy: String
}

type PijulRenderedConflictAssessment
  = PijulRenderedOrderConflictGrounded {
      path: PijulPath,
      left: PijulChangeHash,
      right: PijulChangeHash,
    }
  | PijulRenderedConflictNotGrounded

fn pijul_assess_rendered_order_conflict(
  observation: PijulRenderedOrderConflictObservation,
) -> PijulRenderedConflictAssessment {
  let left = observation.left as String
  let right = observation.right as String
  if left.length() < 8 || right.length() < 8 {
    PijulRenderedConflictNotGrounded
  } else if string_contains(
    s: observation.rendered_working_copy,
    pattern: ">>>>>>>",
  )
    && string_contains(s: observation.rendered_working_copy, pattern: "=======")
    && string_contains(s: observation.rendered_working_copy, pattern: "<<<<<<<")
    && string_contains(
      s: observation.rendered_working_copy,
      pattern: substring(s: left, start: 0, end: 8),
    )
    && string_contains(
      s: observation.rendered_working_copy,
      pattern: substring(s: right, start: 0, end: 8),
    ) {
    PijulRenderedOrderConflictGrounded {
      path: observation.path,
      left: observation.left,
      right: observation.right,
    }
  } else {
    PijulRenderedConflictNotGrounded
  }
}

type PijulDependencyTextObservation {
  change: PijulChangeHash
  dependency: PijulChangeHash
  change_text: String
}

type PijulDependencyTextAssessment
  = PijulDependencyMentionGrounded {
      change: PijulChangeHash,
      dependency: PijulChangeHash,
    }
  | PijulDependencyMentionNotGrounded

fn pijul_assess_dependency_text(
  observation: PijulDependencyTextObservation,
) -> PijulDependencyTextAssessment {
  let pieces = split(s: observation.change_text, delimiter: "# Dependencies")
  if count(pieces) != 2 {
    PijulDependencyMentionNotGrounded
  } else {
    match pieces.skip(n: 1).first() {
      Absent => PijulDependencyMentionNotGrounded
      Present { value: after_heading } =>
        match split(s: after_heading, delimiter: "# Hunks").first() {
          Absent => PijulDependencyMentionNotGrounded
          Present { value: dependency_section } =>
            if string_contains(
              s: dependency_section,
              pattern: observation.dependency as String,
            ) {
              PijulDependencyMentionGrounded {
                change: observation.change,
                dependency: observation.dependency,
              }
            } else {
              PijulDependencyMentionNotGrounded
            }
        }
    }
  }
}

type PijulReadBackObservation {
  pijul_version: PijulUpstreamVersion
  projection: PijulRepositoryProjection
}

type PijulReadBackMismatchAxis
  = PijulReadBackChangesMismatch
  | PijulReadBackPristineMismatch
  | PijulReadBackTreeMismatch
  | PijulReadBackWorkingCopyMismatch
  | PijulReadBackChannelsMismatch
  | PijulReadBackCurrentChannelMismatch
  | PijulReadBackAvailabilityMismatch

type PijulReadBackOutcome
  = PijulReadBackMatches { observation: PijulReadBackObservation }
  | PijulReadBackMismatch { axis: PijulReadBackMismatchAxis }
  | PijulReadBackInvalid { cause: PijulProjectionRefusal }

fn pijul_assess_read_back(
  expected: PijulRepositoryProjection,
  observation: PijulReadBackObservation,
) -> PijulReadBackOutcome {
  match pijul_decode_projection(projection: expected) {
    PijulDecodeRefused { cause } => PijulReadBackInvalid { cause: cause }
    PijulDecoded { repository: expected_repository } =>
      match pijul_decode_projection(projection: observation.projection) {
        PijulDecodeRefused { cause } => PijulReadBackInvalid { cause: cause }
        PijulDecoded { repository: observed_repository } =>
          if !(expected_repository.state.changes == observed_repository.state.changes) {
            PijulReadBackMismatch { axis: PijulReadBackChangesMismatch }
          } else if !(expected_repository.state.pristine == observed_repository.state.pristine) {
            PijulReadBackMismatch { axis: PijulReadBackPristineMismatch }
          } else if !(expected_repository.state.tree == observed_repository.state.tree) {
            PijulReadBackMismatch { axis: PijulReadBackTreeMismatch }
          } else if !(expected_repository.state.working_copy == observed_repository.state.working_copy) {
            PijulReadBackMismatch { axis: PijulReadBackWorkingCopyMismatch }
          } else if !pijul_channels_equivalent(
            left: expected_repository.state.channels,
            right: observed_repository.state.channels,
          ) {
            PijulReadBackMismatch { axis: PijulReadBackChannelsMismatch }
          } else if !(expected_repository.state.current_channel == observed_repository.state.current_channel) {
            PijulReadBackMismatch { axis: PijulReadBackCurrentChannelMismatch }
          } else if !(expected_repository.availability == observed_repository.availability) {
            PijulReadBackMismatch { axis: PijulReadBackAvailabilityMismatch }
          } else {
            PijulReadBackMatches { observation: observation }
          }
      }
  }
}

type PijulDeliveryRefusal
  = PijulDeliveryRepositoryInvalid { cause: PijulProjectionRefusal }
  | PijulDeliveryTargetMissing { channel: PijulChannelName }
  | PijulDeliveryChangeUnavailable { change: PijulChangeHash }
  | PijulDeliveryMissingDependency {
      change: PijulChangeHash,
      dependency: PijulChangeHash,
    }

type PijulDeliveryOutcome
  = PijulDeliveryAdmissible {
      channel: PijulChannelName,
      resulting_changes: List<PijulChangeHash>,
    }
  | PijulDeliveryRefused { cause: PijulDeliveryRefusal }

fn pijul_recorded_change_index(
  changes: List<PijulRecordedChange>,
) -> Map<PijulChangeHash, PijulRecordedChange> {
  fold(
    changes,
    init: empty_map(),
    f: fn(index, change) {
      map_insert(
        index,
        pijul_change_hash(change: change),
        change,
      )
    },
  )
}

type PijulDeliveryDependencyIssue {
  change: PijulChangeHash
  dependency: PijulChangeHash
}

type PijulDeliveryUnavailableIssue {
  change: PijulChangeHash
}

fn pijul_delivery_dependency_issue(
  available: Map<PijulChangeHash, PijulRecordedChange>,
  resulting: List<PijulChangeHash>,
) -> PijulDeliveryDependencyIssue? {
  let resulting_index = pijul_scan_unique(items: resulting).seen
  resulting
    |> flat_map(hash =>
      match map_get(available, hash) {
        Present { value: change } =>
          change.dependencies
            |> filter(dependency =>
              !map_contains_key(resulting_index, dependency.change)
                || !map_contains_key(available, dependency.change)
            )
            |> map(dependency => PijulDeliveryDependencyIssue {
              change: hash,
              dependency: dependency.change,
            })
        Absent => []
      }
    )
    |> first
}

fn pijul_delivery_unavailable_issue(
  available: Map<PijulChangeHash, PijulRecordedChange>,
  changes: List<PijulChangeHash>,
) -> PijulDeliveryUnavailableIssue? {
  changes
    |> filter(change => !map_contains_key(available, change))
    |> map(change => PijulDeliveryUnavailableIssue { change: change })
    |> first
}

fn pijul_plan_delivery(
  projection: PijulRepositoryProjection,
  channel_name: PijulChannelName,
  delivered: List<PijulChangeHash>,
) -> PijulDeliveryOutcome {
  match pijul_decode_projection(projection: projection) {
    PijulDecodeRefused { cause } => PijulDeliveryRefused {
      cause: PijulDeliveryRepositoryInvalid { cause: cause }
    }
    PijulDecoded { repository } => match pijul_find_channel(
      channels: repository.state.channels,
      name: channel_name,
    ) {
    Absent => PijulDeliveryRefused {
      cause: PijulDeliveryTargetMissing { channel: channel_name }
    }
    Present { value: channel } =>
      let available = pijul_recorded_change_index(
        changes: repository.state.changes,
      )
      match pijul_delivery_unavailable_issue(
        available: available,
        changes: delivered,
      ) {
        Present { value: issue } => PijulDeliveryRefused {
          cause: PijulDeliveryChangeUnavailable { change: issue.change }
        }
        Absent => {
          let unique_delivered = pijul_scan_unique(
            items: delivered,
          ).ordered
          let resulting = pijul_change_set_union(
            left: channel.state_identity.changes,
            right: unique_delivered,
          )
          match pijul_delivery_dependency_issue(
            available: available,
            resulting: resulting,
          ) {
            Present { value: issue } => PijulDeliveryRefused {
              cause: PijulDeliveryMissingDependency {
                change: issue.change,
                dependency: issue.dependency,
              }
            }
            Absent =>
              match pijul_delivery_unavailable_issue(
                available: available,
                changes: resulting,
              ) {
                Present { value: issue } => PijulDeliveryRefused {
                  cause: PijulDeliveryChangeUnavailable {
                    change: issue.change,
                  }
                }
                Absent => PijulDeliveryAdmissible {
                  channel: channel_name,
                  resulting_changes: resulting,
                }
              }
          }
        }
      }
    }
  }
}

type PijulConditionalAdvanceCapability
  = PijulConditionalAdvanceUnavailable { reason: NonEmptyStr }

fn pijul_r0_conditional_advance() -> PijulConditionalAdvanceCapability {
  PijulConditionalAdvanceUnavailable {
    reason: "R0 models bounded Pijul capture, projection, dependency closure, and read-back only. No executing upstream operation has yet established the target policy's conditional-advance guarantee."
  }
}

data pijul_conflict_boundary_note: NonEmptyStr = "Pijul graph conflicts are preserved as upstream facts. Their presence proves neither Daglang semantic contradiction nor a user preference; later source-intent admission must assess its own claims."

data pijul_execution_boundary_note: NonEmptyStr = "PijulRepositoryProjection is the raw availability boundary: complete and partial arms carry accessible facts, while the inaccessible arm cannot carry them; partial present/missing overlap is refused. PijulDecodedRepository is an informational decode result, never an admission token. pijul_plan_delivery consumes and re-decodes the raw projection itself, and a dependency must be both a resulting-channel member and an available recorded change. pijul_project_repository and pijul_plan_delivery remain pure R0 models: they mint no applied or independent-execution receipt. Only a separately executed upstream Pijul fixture may establish observation, and managed target advance remains unavailable."
