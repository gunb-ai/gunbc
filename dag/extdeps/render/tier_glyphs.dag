module extdeps.render.tier_glyphs


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.unicode.org/versions/latest/"
  }
}

type TierGlyphs {
  ascii: extdeps.render.glyph.Glyph
  unicode: extdeps.render.glyph.Glyph
  emoji: extdeps.render.glyph.Glyph
}

fn glyphs_for_tiers(emoji: extdeps.render.glyph.Glyph, unicode: extdeps.render.glyph.Glyph, ascii: extdeps.render.glyph.Glyph) -> TierGlyphs {
  { emoji: emoji, unicode: unicode, ascii: ascii }
}

fn glyph_at(glyphs: TierGlyphs, tier: std.symbols.Tier) -> String {
  match tier {
    Emoji   => extdeps.render.glyph.glyph_text(g: glyphs.emoji)
    Unicode => extdeps.render.glyph.glyph_text(g: glyphs.unicode)
    Ascii   => extdeps.render.glyph.glyph_text(g: glyphs.ascii)
  }
}
