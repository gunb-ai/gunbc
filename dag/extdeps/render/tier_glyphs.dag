module extdeps.render.tier_glyphs

import extdeps.render.glyph { Glyph, glyph_text }
import std.symbols { Tier }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.unicode.org/versions/latest/"
  }
}

type TierGlyphs {
  ascii: Glyph
  unicode: Glyph
  emoji: Glyph
}

fn glyphs_for_tiers(emoji: Glyph, unicode: Glyph, ascii: Glyph) -> TierGlyphs {
  { emoji: emoji, unicode: unicode, ascii: ascii }
}

fn glyph_at(glyphs: TierGlyphs, tier: Tier) -> String {
  match tier {
    Emoji   => glyph_text(g: glyphs.emoji)
    Unicode => glyph_text(g: glyphs.unicode)
    Ascii   => glyph_text(g: glyphs.ascii)
  }
}
