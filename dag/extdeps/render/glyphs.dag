fn lookup_symbol_entry(id: std.symbols.SymbolId) -> SymbolEntry? {
  fold(standard_symbols,
    init: none,
    f: (acc, e) => match acc {
      Present { value: _ } => acc
      Absent =>
        if e.id == id {
          Present { value: e }
        } else {
          none
        }
    }
  )
}

fn resolve_symbol(id: std.symbols.SymbolId, tier: std.symbols.Tier) -> String? {
  match lookup_symbol_entry(id: id) {
    Present { value: entry } => Present { value: extdeps.render.tier_glyphs.glyph_at(glyphs: entry.glyphs, tier: tier) }
    Absent => none
  }
}

fn symbol_color(id: std.symbols.SymbolId) -> std.symbols.SemanticColor? {
  match lookup_symbol_entry(id: id) {
    Present { value: entry } => Present { value: entry.color }
    Absent => none
  }
}

data reward_animal_note: String = "The reward animal shown on a terminal success lands as ROWS in the one glyph authority, never as a hardcoded function in a renderer — the reference implementation studied for this lane keeps its emoji table mirrored by hand between Go and shell, which is the maintained dual representation we are here to not have. Selection is DETERMINISTIC: the index is derived from the run's own identity, so replaying a captured run reproduces its animal exactly and the event stream stays replayable by construction. A random draw would make the stream unreplayable and would be a non-determinism root of precisely the kind the determinism gate walls."

data reward_animals: List<extdeps.render.tier_glyphs.TierGlyphs> = [
  extdeps.render.tier_glyphs.glyphs_for_tiers(emoji: extdeps.render.glyph.glyph(text: "🦦"), unicode: extdeps.render.glyph.glyph(text: "✦"), ascii: extdeps.render.glyph.glyph(text: "otter")),
  extdeps.render.tier_glyphs.glyphs_for_tiers(emoji: extdeps.render.glyph.glyph(text: "🦊"), unicode: extdeps.render.glyph.glyph(text: "✦"), ascii: extdeps.render.glyph.glyph(text: "fox")),
  extdeps.render.tier_glyphs.glyphs_for_tiers(emoji: extdeps.render.glyph.glyph(text: "🦉"), unicode: extdeps.render.glyph.glyph(text: "✦"), ascii: extdeps.render.glyph.glyph(text: "owl")),
  extdeps.render.tier_glyphs.glyphs_for_tiers(emoji: extdeps.render.glyph.glyph(text: "🐢"), unicode: extdeps.render.glyph.glyph(text: "✦"), ascii: extdeps.render.glyph.glyph(text: "turtle")),
  extdeps.render.tier_glyphs.glyphs_for_tiers(emoji: extdeps.render.glyph.glyph(text: "🦫"), unicode: extdeps.render.glyph.glyph(text: "✦"), ascii: extdeps.render.glyph.glyph(text: "beaver")),
  extdeps.render.tier_glyphs.glyphs_for_tiers(emoji: extdeps.render.glyph.glyph(text: "🐋"), unicode: extdeps.render.glyph.glyph(text: "✦"), ascii: extdeps.render.glyph.glyph(text: "whale"))
]

type RewardPick {
  idx: Int
  found: extdeps.render.tier_glyphs.TierGlyphs?
}

fn reward_animal_at(index: Int, tier: std.symbols.Tier) -> String? {
  let n = count(reward_animals)
  if n == 0 {
    none
  } else {
    let target = index % n
    let picked = fold(reward_animals,
      init: RewardPick { idx: 0, found: none },
      f: (acc, g) =>
        if acc.idx == target {
          RewardPick { idx: acc.idx + 1, found: Present { value: g } }
        } else {
          RewardPick { idx: acc.idx + 1, found: acc.found }
        }
    )
    match picked.found {
      Present { value: g } => Present { value: extdeps.render.tier_glyphs.glyph_at(glyphs: g, tier: tier) }
      Absent => none
    }
  }
}
