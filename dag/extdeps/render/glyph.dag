module extdeps.render.glyph


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.unicode.org/versions/latest/"
  }
}

type Glyph = String where brand("Glyph")

fn glyph(text: String) -> Glyph {
  text
}

fn glyph_text(g: Glyph) -> String {
  g
}
