module extdeps.render.terminal_capability



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/functions/isatty.html"
  }
}

type TerminalEnvironment {
  is_tty: Bool
  ci: Bool
  no_color: Bool
  dumb_term: Bool
}

fn cursor_addressable_for(env: TerminalEnvironment) -> Bool {
  if env.dumb_term {
    false
  } else if env.ci {
    false
  } else {
    env.is_tty
  }
}

fn color_for(env: TerminalEnvironment) -> Bool {
  if env.no_color {
    false
  } else if env.dumb_term {
    false
  } else {
    env.is_tty || env.ci
  }
}

fn tier_for(env: TerminalEnvironment) -> Tier {
  if env.dumb_term {
    Ascii
  } else if env.is_tty {
    Unicode
  } else {
    Ascii
  }
}

fn detect_capability(env: TerminalEnvironment) -> RenderCapability {
  RenderCapability {
    color: color_for(env: env),
    tier: tier_for(env: env),
    cursor_addressable: cursor_addressable_for(env: env)
  }
}
