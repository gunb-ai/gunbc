module extdeps.render.terminal_capability



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/functions/isatty.html"
  }
}

type TerminalEnvironment {
  is_tty: Bool
  ci: Bool
  no_color: Bool
  dumb_term: Bool
}

fn cursor_addressable_for(env: TerminalEnvironment) -> Bool {
  if env.dumb_term {
    false
  } else if env.ci {
    false
  } else {
    env.is_tty
  }
}

fn color_for(env: TerminalEnvironment) -> Bool {
  if env.no_color {
    false
  } else if env.dumb_term {
    false
  } else {
    env.is_tty || env.ci
  }
}

fn tier_for(env: TerminalEnvironment) -> std.symbols.Tier {
  if env.dumb_term {
    std.symbols.Ascii
  } else if env.is_tty {
    std.symbols.Unicode
  } else {
    std.symbols.Ascii
  }
}

fn detect_capability(env: TerminalEnvironment) -> std.render.RenderCapability {
  std.render.RenderCapability {
    color: color_for(env: env),
    tier: tier_for(env: env),
    cursor_addressable: cursor_addressable_for(env: env)
  }
}
