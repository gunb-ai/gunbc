module extdeps.render.ansi



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "ecma-international.org/publications-and-standards/standards/ecma-48/"
  }
}

data csi_esc: String = "\x1b["
data csi_end: String = "m"
data ansi_escape: String = "\x1b"
data ansi_carriage_return: String = "\x0d"
data ansi_line_feed: String = "\n"
data ansi_horizontal_tab: String = "\x09"

data ansi_c0_controls: List<String> = [
  "\x00",
  "\x01",
  "\x02",
  "\x03",
  "\x04",
  "\x05",
  "\x06",
  "\x07",
  "\x08",
  ansi_horizontal_tab,
  ansi_line_feed,
  "\x0b",
  "\x0c",
  ansi_carriage_return,
  "\x0e",
  "\x0f",
  "\x10",
  "\x11",
  "\x12",
  "\x13",
  "\x14",
  "\x15",
  "\x16",
  "\x17",
  "\x18",
  "\x19",
  "\x1a",
  ansi_escape,
  "\x1c",
  "\x1d",
  "\x1e",
  "\x1f",
  "\x7f",
]

data ansi_c1_controls: List<String> = [
  "\u{0080}",
  "\u{0081}",
  "\u{0082}",
  "\u{0083}",
  "\u{0084}",
  "\u{0085}",
  "\u{0086}",
  "\u{0087}",
  "\u{0088}",
  "\u{0089}",
  "\u{008a}",
  "\u{008b}",
  "\u{008c}",
  "\u{008d}",
  "\u{008e}",
  "\u{008f}",
  "\u{0090}",
  "\u{0091}",
  "\u{0092}",
  "\u{0093}",
  "\u{0094}",
  "\u{0095}",
  "\u{0096}",
  "\u{0097}",
  "\u{0098}",
  "\u{0099}",
  "\u{009a}",
  "\u{009b}",
  "\u{009c}",
  "\u{009d}",
  "\u{009e}",
  "\u{009f}",
]

data ansi_terminal_controls: List<String> = concat(
  ansi_c0_controls,
  ansi_c1_controls
)

fn ansi_erase_entire_line() -> String {
  concat(csi_esc, "2K")
}

data ansi_content_admissible_control_note: String = "LF and TAB are C0 controls but they are not CURSOR controls, and conflating the two cost a located diagnosis. The predicate this replaces (ansi_text_contains_terminal_control, deleted with its last consumer rather than left dead) refused on ANY roster member, so it refused on any multi-line or tab-bearing text — and a captured `systemctl status` diagnostic is multi-line by construction. The srv1 deploy refusal of 2026-07-29 therefore rendered as 'rendered text cannot contain terminal cursor-control bytes' INSTEAD of the ServiceNotReady it had located, which reads as corrupt output rather than as a stale deployment (diagnosed in docs/plans/srv1-deploy-serialization-and-false-greens.md §3.3). The roster is NOT edited — it is the cited ECMA-48 C0/C1 set and stays whole, one authority — so the exclusion is expressed as a predicate over it rather than as a second list, which would fork the citation (§3). TAB is admissible everywhere: it moves the cursor horizontally within a line and cannot escape the erase-line invariant. LF is admissible CONDITIONALLY, and the condition is derived rather than chosen — see terminal.dag's admit-against-projection rule."

fn ansi_control_is_content_admissible(c: String) -> Bool {
  c == ansi_horizontal_tab || c == ansi_line_feed
}

fn ansi_text_contains_cursor_control(text: String) -> Bool {
  fold(ansi_terminal_controls, init: false, f: (found, control) =>
    if ansi_control_is_content_admissible(c: control) {
      found
    } else {
      found || string_contains(s: text, pattern: control)
    }
  )
}

fn ansi_text_contains_line_feed(text: String) -> Bool {
  string_contains(s: text, pattern: ansi_line_feed)
}


type PaletteIndex = Int

type SgrStyle
  = SgrReset {}
  | SgrDim {}
  | SgrIndexedForeground { index: PaletteIndex }

type AnsiMapping {
  color: std.symbols.SemanticColor
  style: SgrStyle
}

data ansi_mappings: List<AnsiMapping> = [
  { color: Default, style: SgrReset {} },
  { color: Success, style: SgrIndexedForeground { index: 34 } },
  { color: Warning, style: SgrIndexedForeground { index: 208 } },
  { color: Error,   style: SgrIndexedForeground { index: 196 } },
  { color: Info,    style: SgrIndexedForeground { index: 39 } },
  { color: Dim,     style: SgrDim {} },
  { color: Active,  style: SgrIndexedForeground { index: 208 } },
  { color: Accent,  style: SgrIndexedForeground { index: 75 } }
]

fn format_sgr_params(style: SgrStyle) -> String {
  match style {
    SgrReset {} => "0"
    SgrDim {} => "2"
    SgrIndexedForeground { index: n } => concat("38;5;", to_string(n))
  }
}

fn emit_sgr_csi(style: SgrStyle) -> String {
  concat(concat(csi_esc, format_sgr_params(style: style)), csi_end)
}

fn ansi_code(c: std.symbols.SemanticColor) -> String? {
  fold(ansi_mappings,
    init: none,
    f: (acc, m) => match acc {
      Present { value: _ } => acc
      Absent =>
        if m.color == c {
          Present { value: emit_sgr_csi(style: m.style) }
        } else {
          none
        }
    }
  )
}
