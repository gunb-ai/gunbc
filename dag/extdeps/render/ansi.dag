fn terminal_control_character(control: TerminalControl) -> String {
  from_code_point(cp: control.code_point)
}

data ansi_c0_control_rows: List<TerminalControl> = concat(
  ecma48_c0_controls,
  [ascii_delete_control]
)

data ansi_terminal_control_rows: List<TerminalControl> = concat(
  ansi_c0_control_rows,
  ecma48_c1_controls
)

data ansi_c0_controls: List<String> = list_map(
  xs: ansi_c0_control_rows,
  f: control => terminal_control_character(control: control)
)

data ansi_c1_controls: List<String> = list_map(
  xs: ecma48_c1_controls,
  f: control => terminal_control_character(control: control)
)

data ansi_terminal_controls: List<String> = list_map(
  xs: ansi_terminal_control_rows,
  f: control => terminal_control_character(control: control)
)

fn ansi_erase_entire_line() -> String {
  concat(csi_esc, "2K")
}

data ansi_content_admissible_control_note: String = "LF and TAB are C0 controls but they are not CURSOR controls, and conflating the two cost a located diagnosis. The predicate this replaces (ansi_text_contains_terminal_control, deleted with its last consumer rather than left dead) refused on ANY roster member, so it refused on any multi-line or tab-bearing text — and a captured `systemctl status` diagnostic is multi-line by construction. The srv1 deploy refusal of 2026-07-29 therefore rendered as 'rendered text cannot contain terminal cursor-control bytes' INSTEAD of the ServiceNotReady it had located, which reads as corrupt output rather than as a stale deployment (diagnosed in docs/plans/srv1-deploy-serialization-and-false-greens.md §3.3). The roster is NOT edited — it is the cited ECMA-48 C0/C1 set and stays whole, one authority — so the exclusion is expressed as a predicate over it rather than as a second list, which would fork the citation (§3). TAB is admissible everywhere: it moves the cursor horizontally within a line and cannot escape the erase-line invariant. LF is admissible CONDITIONALLY, and the condition is derived rather than chosen — see terminal.dag's admit-against-projection rule."

fn ansi_control_is_content_admissible(c: String) -> Bool {
  c == ansi_horizontal_tab || c == ansi_line_feed
}

fn ansi_text_contains_cursor_control(text: String) -> Bool {
  fold(ansi_terminal_controls, init: false, f: (found, control) =>
    if ansi_control_is_content_admissible(c: control) {
      found
    } else {
      found || string_contains(s: text, pattern: control)
    }
  )
}

fn ansi_text_contains_line_feed(text: String) -> Bool {
  string_contains(s: text, pattern: ansi_line_feed)
}

data terminal_diagnostic_projection_note: String = "A FAILURE TO RENDER THE PREFERRED FORM MUST NEVER REPLACE THE PRIMARY DIAGNOSTIC, and that rule is the whole reason this function is TOTAL rather than fallible. The incident it answers: a live GitHub 401 arrived with a CRLF-bearing body, the REST realization embedded that body in a diagnostic, the write guard found a real CR and refused, and 'HTTP 401: Bad credentials' was replaced by 'rendered text cannot contain terminal cursor-control bytes'. The located cause was destroyed by the mechanism protecting the terminal, which is a worse outcome than either the raw bytes or a plain refusal. Because this projection has no failure arm, there is no path by which rendering can lose the message it was given.\\n\\nWHY CR IS NOT SIMPLY ADMITTED, which was the tempting one-line fix: LF and TAB are admissible because neither can escape the erase-line invariant, and CR is admissible under no such argument - it moves the cursor to column zero and lets subsequent text overwrite what was already written, which is exactly the smuggled-overwrite the wall exists to stop. Adding CR to the admissible set would buy this one diagnostic at the cost of the guarantee. So the bytes are TRANSFORMED before they reach the guard instead, and the guard is left exactly as strict as it was.\\n\\nCRLF COLLAPSES TO LF RATHER THAN BEING ESCAPED because it is a line ending and not a cursor movement - every CRLF in a diagnostic is a line break some remote chose to spell in the network convention, and rendering it as a visible escape would make ordinary multi-line output unreadable to serve a distinction no reader wants. A LONE CR is the opposite case and stays visible: it has no line-ending reading, and it is the byte that actually performs the overwrite.\\n\\nTHE MARKERS COME FROM THE AUTHORITY, not from this module. A named control renders as its ECMA-48 acronym, so a reader sees <CR> or <ESC> rather than a hex code they must look up. The three code points the standard does not assign render with a trailing question mark on the Unicode annotation - <PAD?> - so the projection never silently presents an uncited draft name as though the cited standard had blessed it.\\n\\nTHE RAW BODY IS NOT DISCARDED. This produces a safe rendering and a list of what it changed; the original stays in whatever typed evidence carried it. A projection that destroyed its input would reproduce the failure it exists to prevent, one layer further in."

type DiagnosticTextTransformation
  = CrLfNormalizedToLineFeed { count: Int }
  | ControlRenderedVisible { marker: NonEmptyStr, count: Int }

type TerminalDiagnosticProjection {
  safe_text: String
  transformations: List<DiagnosticTextTransformation>
}

type DiagnosticProjectionStep {
  text: String
  transformations: List<DiagnosticTextTransformation>
}

fn terminal_control_marker(control: TerminalControl) -> String {
  match control.name {
    ControlNamed { acronym } => join(["<", acronym, ">"], "")
    ControlUnassignedInEcma48 { unicode_annotation } => join(["<", unicode_annotation, "?>"], "")
  }
}

fn render_control_visible(step: DiagnosticProjectionStep, control: TerminalControl) -> DiagnosticProjectionStep {
  let character = terminal_control_character(control: control)
  if ansi_control_is_content_admissible(c: character) {
    step
  } else {
    let marker = terminal_control_marker(control: control)
    let replaced = replace(step.text, character, marker)
    let unit = length(marker) - length(character)
    let delta = length(replaced) - length(step.text)
    if delta == 0 {
      step
    } else {
      DiagnosticProjectionStep {
        text: replaced,
        transformations: concat(
          step.transformations,
          [ControlRenderedVisible { marker: marker as NonEmptyStr, count: delta / unit }]
        ),
      }
    }
  }
}

fn project_diagnostic_text_for_terminal(text: String) -> TerminalDiagnosticProjection {
  let normalized = replace(text, concat(ansi_carriage_return, ansi_line_feed), ansi_line_feed)
  let crlf_count = length(text) - length(normalized)
  let projected = fold(
    ansi_terminal_control_rows,
    init: DiagnosticProjectionStep {
      text: normalized,
      transformations: if crlf_count == 0 {
        []
      } else {
        [CrLfNormalizedToLineFeed { count: crlf_count }]
      },
    },
    f: (step, control) => render_control_visible(step: step, control: control)
  )
  TerminalDiagnosticProjection {
    safe_text: projected.text,
    transformations: projected.transformations,
  }
}


type PaletteIndex = Int

type SgrStyle
  = SgrReset {}
  | SgrDim {}
  | SgrIndexedForeground { index: PaletteIndex }

type AnsiMapping {
  color: SemanticColor
  style: SgrStyle
}

data ansi_mappings: List<AnsiMapping> = [
  { color: Default, style: SgrReset {} },
  { color: Success, style: SgrIndexedForeground { index: 34 } },
  { color: Warning, style: SgrIndexedForeground { index: 208 } },
  { color: Error,   style: SgrIndexedForeground { index: 196 } },
  { color: Info,    style: SgrIndexedForeground { index: 39 } },
  { color: Dim,     style: SgrDim {} },
  { color: Active,  style: SgrIndexedForeground { index: 208 } },
  { color: Accent,  style: SgrIndexedForeground { index: 75 } }
]

fn format_sgr_params(style: SgrStyle) -> String {
  match style {
    SgrReset {} => "0"
    SgrDim {} => "2"
    SgrIndexedForeground { index: n } => concat("38;5;", to_string(n))
  }
}

fn emit_sgr_csi(style: SgrStyle) -> String {
  concat(concat(csi_esc, format_sgr_params(style: style)), csi_end)
}

fn ansi_code(c: SemanticColor) -> String? {
  fold(ansi_mappings,
    init: none,
    f: (acc, m) => match acc {
      Present { value: _ } => acc
      Absent =>
        if m.color == c {
          Present { value: emit_sgr_csi(style: m.style) }
        } else {
          none
        }
    }
  )
}
