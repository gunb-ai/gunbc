module extdeps.render.ansi

import std.symbols { SemanticColor }
import std.types { Int, NonEmptyStr }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "ecma-international.org/publications-and-standards/standards/ecma-48/"
  }
}

data csi_esc: String = "\x1b["
data csi_end: String = "m"
data ansi_escape: String = "\x1b"
data ansi_carriage_return: String = "\x0d"
data ansi_line_feed: String = "\n"
data ansi_horizontal_tab: String = "\x09"

data terminal_control_roster_note: String = "THE ROSTER CARRIES CODE POINTS AND THE AUTHORITY'S OWN NAMES, AND BOTH CHANGES FIX A DEFECT THE FLAT LIST HID. It was two List<String> of bare characters, and the C1 half was written as \\u{0080}..\\u{009f} - an escape the language does not implement, so those thirty-two rows were thirty-two strings of LITERAL TEXT and the C1 half of this roster detected nothing. Every consumer that believed it was scanning for C1 controls was scanning for the eight-character sequence backslash-u-brace-0-0-8-0-brace. The C0 half used \\x and was real, which is why CR was still caught and why the gap went unnoticed.\\n\\nThe repair is not to respell the escape but to stop transcribing the character at all. A control IS its code point - that is the grounded fact the standard assigns - so the row carries an Int and the character is DERIVED by from_code_point. A transcription can be wrong while looking right; a derivation cannot. This also makes the roster independent of which string escapes the language happens to implement, which is what let the original defect exist.\\n\\nNAMING FORCED THREE FACTS INTO THE OPEN THAT THE FLAT LIST CONCEALED, and each is a citation question the bare characters made unaskable. ECMA-48 does not assign 0x80, 0x81, or 0x99; the names usually seen for them (PAD, HOP, and SGC) come from early drafts preserved in Unicode's annotations, not from the standard this module cites, so they are recorded as unassigned-with-annotation rather than given a citation they do not have. DEL at 0x7F is not a C0 control in ECMA-48 - it is a separate delete character - so it carries its own band instead of being filed silently among the C0 rows, where it sat before. And 0x1C-0x1F are IS4/IS3/IS2/IS1 here rather than the ASCII spellings FS/GS/RS/US, because the cited authority names them that way.\\n\\nThe derived flat lists below preserve the exact character sets their consumers already depend on, including DEL's membership in the C0 projection, so this decomposition changes what the roster KNOWS without changing what any existing reader SEES."

type ControlAuthorityName
  = ControlNamed { acronym: NonEmptyStr }
  | ControlUnassignedInEcma48 { unicode_annotation: NonEmptyStr }

type ControlBand
  = C0Control
  | C1Control
  | DeleteCharacter

type TerminalControl {
  code_point: Int
  name: ControlAuthorityName
  band: ControlBand
}

