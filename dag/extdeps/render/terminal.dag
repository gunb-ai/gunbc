module extdeps.render.terminal

import extdeps.render.glyphs { resolve_symbol }
import extdeps.render.ansi { ansi_code, csi_esc }
import std.render { RenderFrame, Line, RenderCapability, Span, Viewport, CursorAction, Overwrite, Append, Clear, cursor_action_under }
import std.types { String, NonEmptyStr }
import std.render_repeat_string_bootstrap { repeat_string }
import std.symbols { Tier }
import extdeps.unicode.display { string_display_width, truncate_text }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.unicode.org/reports/tr11/"
  }
}

fn span_width(span: Span, tier: Tier) -> Int? {
  let text_w = string_display_width(s: span.text)
  match span.style.symbol {
    null => Present { value: text_w }
    sym  => match resolve_symbol(id: sym, tier: tier) {
      Present { value: s } => Present { value: text_w + string_display_width(s: s) }
      Absent => none
    }
  }
}

fn truncate_spans(spans: List<Span>, budget: Int, tier: Tier) -> List<Span>? {
  let state = fold(spans,
    init: Present { value: { kept: [], remaining: budget } },
    f: (acc, span) => match acc {
      Absent => none
      Present { value: st } =>
        if st.remaining <= 0 {
          acc
        } else {
          match span_width(span: span, tier: tier) {
            Present { value: w } =>
              if w <= st.remaining {
                Present { value: { kept: concat(st.kept, [span]), remaining: st.remaining - w } }
              } else {
                Present { value: { kept: concat(st.kept, [Span { text: truncate_text(text: span.text, max_width: st.remaining), style: span.style }]), remaining: 0 } }
              }
            Absent => none
          }
        }
    }
  )
  match state {
    Present { value: s } => Present { value: s.kept }
    Absent => none
  }
}

fn constrain_line(line: Line, max_width: Int, tier: Tier) -> Line? {
  let indent_width = line.indent * 4
  let budget = max_width - indent_width
  if budget <= 0 { return Present { value: Line { spans: [], indent: line.indent, max_width: max_width } } }
  match truncate_spans(spans: line.spans, budget: budget, tier: tier) {
    Present { value: spans } => Present { value: Line { spans: spans, indent: line.indent, max_width: max_width } }
    Absent => none
  }
}

fn constrain_frame(frame: std.render.RenderFrame, viewport: Viewport, tier: Tier) -> std.render.RenderFrame? {
  let result = fold(frame.lines,
    init: Present { value: [] },
    f: (acc, line) => match acc {
      Absent => none
      Present { value: lines } =>
        match constrain_line(line: line, max_width: viewport.width, tier: tier) {
          Present { value: l } => Present { value: concat(lines, [l]) }
          Absent => none
        }
    }
  )
  match result {
    Present { value: lines } => Present { value: RenderFrame { lines: lines, cursor_action: frame.cursor_action } }
    Absent => none
  }
}

fn project_frame(frame: std.render.RenderFrame, viewport: Viewport, cap: RenderCapability) -> std.render.RenderFrame? {
  match constrain_frame(frame: frame, viewport: viewport, tier: cap.tier) {
    Present { value: f } => Present { value: RenderFrame { lines: f.lines, cursor_action: cursor_action_under(requested: f.cursor_action, cap: cap) } }
    Absent => none
  }
}

fn serialize_span(span: Span, cap: RenderCapability) -> String {
  let glyph = match span.style.symbol {
    null => ""
    sym  => match resolve_symbol(id: sym, tier: cap.tier) {
      Present { value: s } => s
      Absent => ""
    }
  }
  let body = concat(glyph, span.text)
  if cap.color {
    match span.style.color {
      null => body
      c    => match ansi_code(c: c) {
        Present { value: code } => concat(code, concat(body, "\x1b[0m"))
        Absent => body
      }
    }
  } else {
    body
  }
}

fn serialize_line(line: Line, cap: RenderCapability) -> String {
  let pad = repeat_string(s: " ", n: line.indent * 4)
  let body = fold(line.spans,
    init: "",
    f: (acc, span) => concat(acc, serialize_span(span: span, cap: cap))
  )
  concat(pad, body)
}

fn serialize_frame(frame: std.render.RenderFrame, cap: RenderCapability) -> String {
  let rendered = map(frame.lines, line => serialize_line(line: line, cap: cap))
  join(rendered, "\n")
}

type DynamicLineState = DynamicLineClosed | DynamicLineOpen

type TerminalWriteProjection
  = TerminalWriteProjected { bytes: String, next: DynamicLineState }
  | TerminalWriteRefused { cause: NonEmptyStr }

data terminal_wire_projection_note: String = "Stateful terminal projection owns every terminal control byte. Callers supply rendered text only; overwrite, append, and clear are projected through the ECMA-48 CSI authority in extdeps.render.ansi. DynamicLineOpen means the previous write deliberately omitted LF and therefore may only be continued by an addressable terminal. A non-addressable capability paired with Open is contradictory and refuses before downgrade. Overwrite downgrades to Append when cursor addressing is absent; Clear becomes a no-op. Clear also requires empty rendered text, making caller-owned control payloads and ambiguous clear-plus-content states unwritable."

fn terminal_erase_line_2() -> String {
  concat(csi_esc, "2K")
}

fn dynamic_line_is_open(state: DynamicLineState) -> Bool {
  match state {
    DynamicLineOpen => true
    DynamicLineClosed => false
  }
}

fn cursor_action_is_clear(action: CursorAction) -> Bool {
  match action {
    Clear => true
    Overwrite => false
    Append => false
  }
}

fn project_terminal_write(
  prior: DynamicLineState,
  requested: CursorAction,
  capability: RenderCapability,
  rendered: String
) -> TerminalWriteProjection {
  if !capability.cursor_addressable && dynamic_line_is_open(state: prior) {
    TerminalWriteRefused { cause: "non-addressable terminal cannot continue an open dynamic line" as NonEmptyStr }
  } else {
    if string_contains(s: rendered, pattern: "\r") || string_contains(s: rendered, pattern: terminal_erase_line_2()) {
      TerminalWriteRefused { cause: "rendered text cannot contain terminal cursor-control bytes" as NonEmptyStr }
    } else if cursor_action_is_clear(action: requested) && rendered != "" {
      TerminalWriteRefused { cause: "Clear requires empty rendered text" as NonEmptyStr }
    } else {
      let action = cursor_action_under(requested: requested, cap: capability)
      match action {
        Overwrite =>
          TerminalWriteProjected {
            bytes: concat("\r", concat(terminal_erase_line_2(), rendered)),
            next: DynamicLineOpen
          }
        Append =>
          match prior {
            DynamicLineOpen =>
              TerminalWriteProjected {
                bytes: concat("\r", concat(terminal_erase_line_2(), concat(rendered, "\n"))),
                next: DynamicLineClosed
              }
            DynamicLineClosed =>
              TerminalWriteProjected { bytes: concat(rendered, "\n"), next: DynamicLineClosed }
          }
        Clear =>
          match prior {
            DynamicLineOpen =>
              TerminalWriteProjected {
                bytes: concat("\r", terminal_erase_line_2()),
                next: DynamicLineClosed
              }
            DynamicLineClosed =>
              TerminalWriteProjected { bytes: "", next: DynamicLineClosed }
          }
      }
    }
  }
}
