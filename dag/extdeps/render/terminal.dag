module extdeps.render.terminal



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.unicode.org/reports/tr11/"
  }
}

fn span_width(span: std.render.Span, tier: std.symbols.Tier) -> Int? {
  let text_w = string_display_width(s: span.text)
  match span.style.symbol {
    null => Present { value: text_w }
    sym  => match resolve_symbol(id: sym, tier: tier) {
      Present { value: s } => Present { value: text_w + string_display_width(s: s) }
      Absent => none
    }
  }
}

fn truncate_spans(spans: List<std.render.Span>, budget: Int, tier: std.symbols.Tier) -> List<std.render.Span>? {
  let state = fold(spans,
    init: Present { value: { kept: [], remaining: budget } },
    f: (acc, span) => match acc {
      Absent => none
      Present { value: st } =>
        if st.remaining <= 0 {
          acc
        } else {
          match span_width(span: span, tier: tier) {
            Present { value: w } =>
              if w <= st.remaining {
                Present { value: { kept: concat(st.kept, [span]), remaining: st.remaining - w } }
              } else {
                Present { value: { kept: concat(st.kept, [std.render.Span { text: truncate_text(text: span.text, max_width: st.remaining), style: span.style }]), remaining: 0 } }
              }
            Absent => none
          }
        }
    }
  )
  match state {
    Present { value: s } => Present { value: s.kept }
    Absent => none
  }
}

fn constrain_line(line: std.render.Line, max_width: Int, tier: std.symbols.Tier) -> std.render.Line? {
  let indent_width = line.indent * 4
  let budget = max_width - indent_width
  if budget <= 0 { return Present { value: std.render.Line { spans: [], indent: line.indent, max_width: max_width } } }
  match truncate_spans(spans: line.spans, budget: budget, tier: tier) {
    Present { value: spans } => Present { value: std.render.Line { spans: spans, indent: line.indent, max_width: max_width } }
    Absent => none
  }
}

fn constrain_frame(frame: std.render.RenderFrame, viewport: std.render.Viewport, tier: std.symbols.Tier) -> std.render.RenderFrame? {
  let result = fold(frame.lines,
    init: Present { value: [] },
    f: (acc, line) => match acc {
      Absent => none
      Present { value: lines } =>
        match constrain_line(line: line, max_width: viewport.width, tier: tier) {
          Present { value: l } => Present { value: concat(lines, [l]) }
          Absent => none
        }
    }
  )
  match result {
    Present { value: lines } => Present { value: std.render.RenderFrame { lines: lines, cursor_action: frame.cursor_action } }
    Absent => none
  }
}

fn project_frame(frame: std.render.RenderFrame, viewport: std.render.Viewport, cap: std.render.RenderCapability) -> std.render.RenderFrame? {
  match constrain_frame(frame: frame, viewport: viewport, tier: cap.tier) {
    Present { value: f } => Present { value: std.render.RenderFrame { lines: f.lines, cursor_action: cursor_action_under(requested: f.cursor_action, cap: cap) } }
    Absent => none
  }
}

fn serialize_span(span: std.render.Span, cap: std.render.RenderCapability) -> String {
  let glyph = match span.style.symbol {
    null => ""
    sym  => match resolve_symbol(id: sym, tier: cap.tier) {
      Present { value: s } => s
      Absent => ""
    }
  }
  let body = concat(glyph, span.text)
  if cap.color {
    match span.style.color {
      null => body
      c    => match ansi_code(c: c) {
        Present { value: code } => concat(code, concat(body, "\x1b[0m"))
        Absent => body
      }
    }
  } else {
    body
  }
}

fn serialize_line(line: std.render.Line, cap: std.render.RenderCapability) -> String {
  let pad = repeat_string(s: " ", n: line.indent * 4)
  let body = fold(line.spans,
    init: "",
    f: (acc, span) => concat(acc, serialize_span(span: span, cap: cap))
  )
  concat(pad, body)
}

fn serialize_frame(frame: std.render.RenderFrame, cap: std.render.RenderCapability) -> String {
  let rendered = map(frame.lines, line => serialize_line(line: line, cap: cap))
  join(rendered, "\n")
}

type DynamicLineState = DynamicLineClosed | DynamicLineOpen

type TerminalWriteProjection
  = TerminalWriteProjected { bytes: String, next: DynamicLineState }
  | TerminalWriteRefused { cause: std.types.NonEmptyStr }

data terminal_wire_projection_note: String = "Stateful terminal projection owns every terminal control byte. Callers supply rendered text only; overwrite, append, and clear are projected through the ECMA-48 CSI authority in extdeps.render.ansi. DynamicLineOpen means the previous write deliberately omitted LF and therefore may only be continued by an addressable terminal. A non-addressable capability paired with Open is contradictory and refuses before downgrade. Overwrite downgrades to Append when cursor addressing is absent; Clear becomes a no-op. Clear also requires empty rendered text, making caller-owned control payloads and ambiguous clear-plus-content states unwritable."

// LF admission is DERIVED from the arm's own postcondition, not chosen per CursorAction. DynamicLineOpen means this write deliberately omitted LF so a later Overwrite can reclaim the line with CR + erase-entire-line — and erase-entire-line clears ONE line, so an embedded LF would leave every earlier line of the payload permanently on screen. That is the whole hazard, and it is exactly co-extensive with `next == DynamicLineOpen`. So the rule is: admit LF iff the projection closes the line. Reading it off the produced state rather than matching on the requested action means the downgrade paths (Overwrite-under-non-addressable becomes an Append that terminates with LF) get the right answer for free, and a future arm cannot forget to be listed. Cursor controls proper (ESC/CSI, CR, and the rest of C0/C1) stay refused on every arm — the wall's real purpose is that callers may not smuggle their own overwrite/erase payloads, and project_terminal_write_admitted owns those bytes.
fn admit_line_feed_against_projection(projection: TerminalWriteProjection, rendered: String) -> TerminalWriteProjection {
  match projection {
    TerminalWriteRefused { cause: c } => TerminalWriteRefused { cause: c }
    TerminalWriteProjected { bytes: b, next: n } =>
      match n {
        DynamicLineOpen =>
          if ansi_text_contains_line_feed(text: rendered) {
            TerminalWriteRefused {
              cause: "rendered text cannot contain a line feed on a write that leaves the dynamic line open" as std.types.NonEmptyStr
            }
          } else {
            TerminalWriteProjected { bytes: b, next: n }
          }
        DynamicLineClosed => TerminalWriteProjected { bytes: b, next: n }
      }
  }
}

fn project_terminal_write_admitted(
  prior: DynamicLineState,
  requested: std.render.CursorAction,
  capability: std.render.RenderCapability,
  rendered: String
) -> TerminalWriteProjection {
  if ansi_text_contains_cursor_control(text: rendered) {
    TerminalWriteRefused { cause: "rendered text cannot contain terminal cursor-control bytes" as std.types.NonEmptyStr }
  } else {
    admit_line_feed_against_projection(
      rendered: rendered,
      projection: project_terminal_write_line_admitted(
        prior: prior,
        requested: requested,
        capability: capability,
        rendered: rendered
      )
    )
  }
}

fn project_terminal_write_line_admitted(
  prior: DynamicLineState,
  requested: std.render.CursorAction,
  capability: std.render.RenderCapability,
  rendered: String
) -> TerminalWriteProjection {
  match requested {
      Clear =>
        if rendered != "" {
          TerminalWriteRefused { cause: "Clear requires empty rendered text" as std.types.NonEmptyStr }
        } else {
          match prior {
            DynamicLineOpen =>
              TerminalWriteProjected {
                bytes: concat(ansi_carriage_return, ansi_erase_entire_line()),
                next: DynamicLineClosed
              }
            DynamicLineClosed =>
              TerminalWriteProjected { bytes: "", next: DynamicLineClosed }
          }
        }
      Overwrite =>
        match cursor_action_under(requested: Overwrite, cap: capability) {
          Overwrite =>
            TerminalWriteProjected {
              bytes: concat(ansi_carriage_return, concat(ansi_erase_entire_line(), rendered)),
              next: DynamicLineOpen
            }
          Append =>
            match prior {
              DynamicLineOpen =>
                TerminalWriteProjected {
                  bytes: concat(
                    ansi_carriage_return,
                    concat(ansi_erase_entire_line(), concat(rendered, ansi_line_feed))
                  ),
                  next: DynamicLineClosed
                }
              DynamicLineClosed =>
                TerminalWriteProjected {
                  bytes: concat(rendered, ansi_line_feed),
                  next: DynamicLineClosed
                }
            }
          Clear =>
            TerminalWriteRefused { cause: "Overwrite cannot project to Clear" as std.types.NonEmptyStr }
        }
      Append =>
        match prior {
          DynamicLineOpen =>
            TerminalWriteProjected {
              bytes: concat(
                ansi_carriage_return,
                concat(ansi_erase_entire_line(), concat(rendered, ansi_line_feed))
              ),
              next: DynamicLineClosed
            }
          DynamicLineClosed =>
            TerminalWriteProjected {
              bytes: concat(rendered, ansi_line_feed),
              next: DynamicLineClosed
            }
        }
  }
}

fn project_terminal_write(
  prior: DynamicLineState,
  requested: std.render.CursorAction,
  capability: std.render.RenderCapability,
  rendered: String
) -> TerminalWriteProjection {
  match prior {
    DynamicLineOpen =>
      if capability.cursor_addressable {
        project_terminal_write_admitted(
          prior: prior,
          requested: requested,
          capability: capability,
          rendered: rendered
        )
      } else {
        TerminalWriteRefused { cause: "non-addressable terminal cannot continue an open dynamic line" as std.types.NonEmptyStr }
      }
    DynamicLineClosed =>
      project_terminal_write_admitted(
        prior: prior,
        requested: requested,
        capability: capability,
        rendered: rendered
      )
  }
}
