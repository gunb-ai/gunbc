module extdeps.package

import std.types { NonEmptyStr, String, Bool, List, Int }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.pin { Pin }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Package_format"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.package",
      decl_name: "PackageLockGraph",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data package_scope_subject_note: String = "THE SUBJECT IS THE PACKAGE — an archive plus the metadata a package manager needs (en.wikipedia.org/wiki/Package_format). A PackageLockGraph is the exact closed set of those packages a resolver admitted: nodes are package selections, edges are dependency relations at the manager's node grain.\\n\\nWHY NOT REPRODUCIBLE BUILDS HERE (operator, 2026-08-04): that definition already anchors extdeps.pin for a single subject's exact version + content identity. Re-citing it for the package hub would nickname one authority across two modules and blur what this citation may carry. Package_format grounds what a package *is*; pin grounds how one subject is pinned.\\n\\nTHE CITATION BOUNDS WHAT MAY LIVE HERE. Package_format does NOT ground JavaScript module formats, npm lifecycle-script policy, artifact-admission outcomes, or gunbc's chosen materialization receipt — those live in extdeps.npm (upstream manager facts) and gunbc.package_delivery (product policy and mechanism)."

data package_hub_agnostic_note: String = "THE AGNOSTIC SHAPE OF A DEPENDENCY GRAPH. The hub parameterizes Selection — ecosystems define their own selection shapes. The hub never enumerates package managers."

data package_lock_node_grain_note: String = "THE LOCK NODE, NOT name@version, IS THE IDENTITY. NodeKey is a type parameter from the ecosystem. Edges name keys; selections live on nodes."

type PackageCoordinate<Ecosystem> {
  ecosystem: Ecosystem
  name: NonEmptyStr
}

type PackageRequirement<Ecosystem, RequirementSpec> {
  package: PackageCoordinate<Ecosystem>
  spec: RequirementSpec
}

data package_artifact_source_note: String = "WHERE THE BYTES CAME FROM IS EVIDENCE, NOT A FALLBACK LADDER. One locator, never an ordered mirror list."

type PackageArtifactSource {
  locator: NonEmptyStr
}

data pinned_package_artifact_selection_note: String = "PINNED RELEASE ARTIFACT SELECTION — optional hub convenience for ecosystems whose lock nodes are downloaded name@version releases with one content identity and one locator. It is NOT required of every PackageLockNode: Selection is a type parameter. npm roots, links, and git artifacts use npm-local selection arms instead (operator portfolio 2026-08-04). Formerly named PackageSelection; renamed so the hub does not pretend every lock node is a pinned registry artifact."

type PinnedPackageArtifactSelection<Ecosystem> {
  pin: Pin<PackageCoordinate<Ecosystem>>
  source: PackageArtifactSource
}

fn pinned_package_artifact_name<Ecosystem>(
  selection: PinnedPackageArtifactSelection<Ecosystem>
) -> NonEmptyStr {
  selection.pin.subject.name
}

type PackageLockNode<NodeKey, Selection, Metadata> {
  key: NodeKey
  selection: Selection
  metadata: Metadata
}

type PackageDependencyEdge<NodeKey, EdgeKind> {
  consumer: NodeKey
  dependency: NodeKey
  kind: EdgeKind
}

type PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind> {
  manager: ManagerIdentity
  roots: List<NodeKey>
  nodes: List<PackageLockNode<NodeKey, Selection, Metadata>>
  edges: List<PackageDependencyEdge<NodeKey, EdgeKind>>
}

data package_graph_identity_absent_note: String = "NO authored lock_identity field. Canonical graph digest is a fold over parts, computed by the consumer."

type PackageLockNodeLookup<NodeKey, Selection, Metadata>
  = PackageLockNodeAbsent { key: NodeKey }
  | PackageLockNodeUnique {
      node: PackageLockNode<NodeKey, Selection, Metadata>
    }
  | PackageLockNodeDuplicate {
      key: NodeKey
      count: Int
    }

data package_lock_lookup_note: String = "EXACT CARDINALITY, NOT BOOLEAN MEMBERSHIP (operator portfolio 2026-08-04). any(key==) was fail-open on duplicates: one key and three duplicate keys both returned true, so roots and edges resolved against an ambiguous graph. Lookup is 0 / 1 / many."

fn package_lock_lookup_node<NodeKey, Selection, Metadata, EdgeKind, ManagerIdentity>(
  graph: PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>,
  key: NodeKey,
) -> PackageLockNodeLookup<NodeKey, Selection, Metadata> {
  let hits = graph.nodes |> filter(n => n.key == key)
  let n = count(hits)
  if n == 0 {
    PackageLockNodeAbsent { key: key }
  } else if n == 1 {
    fold(
      hits,
      init: PackageLockNodeAbsent { key: key },
      f: (_acc, node) => PackageLockNodeUnique { node: node },
    )
  } else {
    PackageLockNodeDuplicate { key: key, count: n }
  }
}

type PackageLockGraphAdmission<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>
  = PackageLockGraphAdmitted {
      graph: PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>
    }
  | PackageLockGraphDuplicateNode {
      key: NodeKey
      count: Int
    }
  | PackageLockGraphMissingRoot { key: NodeKey }
  | PackageLockGraphMissingEdgeConsumer { key: NodeKey }
  | PackageLockGraphMissingEdgeDependency { key: NodeKey }

data package_lock_admission_note: String = "PRODUCTION CONSUMERS TAKE THE ADMITTED CARRIER, NEVER THE RAW GRAPH. Admission is exact-cardinality: duplicate keys refuse before roots or edges are trusted; missing roots and missing edge endpoints refuse with typed causes. Boolean membership is not an admission path."

fn package_lock_admit_graph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>(
  graph: PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>,
) -> PackageLockGraphAdmission<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind> {
  let after_nodes = fold(
    graph.nodes,
    init: PackageLockGraphAdmitted { graph: graph },
    f: (acc, node) => match acc {
      PackageLockGraphAdmitted { graph: g } =>
        match package_lock_lookup_node(graph: g, key: node.key) {
          PackageLockNodeUnique { node: _ } => PackageLockGraphAdmitted { graph: g }
          PackageLockNodeDuplicate { key, count } =>
            PackageLockGraphDuplicateNode { key: key, count: count }
          PackageLockNodeAbsent { key } => PackageLockGraphMissingRoot { key: key }
        }
      other => other
    },
  )
  let after_roots = match after_nodes {
    PackageLockGraphAdmitted { graph: g } =>
      fold(
        g.roots,
        init: PackageLockGraphAdmitted { graph: g },
        f: (acc, root_key) => match acc {
          PackageLockGraphAdmitted { graph: g2 } =>
            match package_lock_lookup_node(graph: g2, key: root_key) {
              PackageLockNodeUnique { node: _ } => PackageLockGraphAdmitted { graph: g2 }
              PackageLockNodeAbsent { key } => PackageLockGraphMissingRoot { key: key }
              PackageLockNodeDuplicate { key, count } =>
                PackageLockGraphDuplicateNode { key: key, count: count }
            }
          other => other
        },
      )
    other => other
  }
  match after_roots {
    PackageLockGraphAdmitted { graph: g3 } =>
      fold(
        g3.edges,
        init: PackageLockGraphAdmitted { graph: g3 },
        f: (acc, edge) => match acc {
          PackageLockGraphAdmitted { graph: g4 } =>
            match package_lock_lookup_node(graph: g4, key: edge.consumer) {
              PackageLockNodeAbsent { key } =>
                PackageLockGraphMissingEdgeConsumer { key: key }
              PackageLockNodeDuplicate { key, count } =>
                PackageLockGraphDuplicateNode { key: key, count: count }
              PackageLockNodeUnique { node: _ } =>
                match package_lock_lookup_node(graph: g4, key: edge.dependency) {
                  PackageLockNodeUnique { node: _ } =>
                    PackageLockGraphAdmitted { graph: g4 }
                  PackageLockNodeAbsent { key } =>
                    PackageLockGraphMissingEdgeDependency { key: key }
                  PackageLockNodeDuplicate { key, count } =>
                    PackageLockGraphDuplicateNode { key: key, count: count }
                }
            }
          other => other
        },
      )
    other => other
  }
}

data package_delivery_placement_note: String = "First delivery mechanism lands as a CONSUMED handler in gunbc.package_delivery; promote to std only after a second real consumer."
