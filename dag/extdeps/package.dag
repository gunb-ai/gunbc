module extdeps.package


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "reproducible-builds.org/docs/definition/"
  }
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.package",
      decl_name: "PackageLockGraph",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data package_scope_subject_note: String = "THE SUBJECT IS THE EXACT DEPENDENCY / LOCK-GRAPH RELATION — PackageLockGraph: nodes are package selections at the manager's node grain; edges are consumer→dependency relations at that same grain. Grounded on the Reproducible Builds definition (dependencies and their versions as build-environment attributes), the same external citation extdeps.pin spells for Pin — two DISTINCT CITATIONS of one upstream page, not duplicated semantic authority (extdeps.pin pin_citation_note: the structural authority lens reads each module's anchor locally, so neither module may alias the other's anchor declaration).\\n\\nNOT Package_format: an archive-plus-metadata subject is a different external fact. Defer a generic package-artifact module until a second ecosystem needs it; do not leave PackageLockGraph cited as a package archive.\\n\\nTHE CITATION BOUNDS WHAT MAY LIVE HERE. It does NOT ground JavaScript module formats, npm lifecycle-script policy, artifact-admission outcomes, or gunbc materialization — those live in extdeps.npm (upstream manager facts) and gunbc.package_delivery (product policy and mechanism). Exact package/version/content identity for a downloaded release is Pin<PackageCoordinate<Ecosystem>> (extdeps.pin); ecosystems derive that pin from native observations — they do not mint a parallel selection carrier beside it."

data package_hub_agnostic_note: String = "THE AGNOSTIC SHAPE OF A DEPENDENCY GRAPH. The hub parameterizes Selection — ecosystems define their own selection shapes. The hub never enumerates package managers. No synthetic PinnedPackageArtifactSelection convenience: the first real consumer (npm) derives Pin from native lock observations."

data package_lock_node_grain_note: String = "THE LOCK NODE, NOT name@version, IS THE IDENTITY. NodeKey is a type parameter from the ecosystem. Edges name keys; selections live on nodes."

type PackageCoordinate<Ecosystem> {
  ecosystem: Ecosystem
  name: std.types.NonEmptyStr
}

type PackageRequirement<Ecosystem, RequirementSpec> {
  package: PackageCoordinate<Ecosystem>
  spec: RequirementSpec
}

data package_artifact_source_note: String = "WHERE THE BYTES CAME FROM IS EVIDENCE, NOT A FALLBACK LADDER. One locator, never an ordered mirror list. Ecosystem modules own typed source identities; this hub does not mint a parallel selection record."

type PackageLockNode<NodeKey, Selection, Metadata> {
  key: NodeKey
  selection: Selection
  metadata: Metadata
}

type PackageDependencyEdge<NodeKey, EdgeKind> {
  consumer: NodeKey
  dependency: NodeKey
  kind: EdgeKind
}

type PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind> {
  manager: ManagerIdentity
  roots: List<NodeKey>
  nodes: List<PackageLockNode<NodeKey, Selection, Metadata>>
  edges: List<PackageDependencyEdge<NodeKey, EdgeKind>>
}

data package_graph_identity_absent_note: String = "NO authored lock_identity field. Canonical graph digest is a fold over parts, computed by the consumer."

type PackageLockNodeLookup<NodeKey, Selection, Metadata>
  = PackageLockNodeAbsent { key: NodeKey }
  | PackageLockNodeUnique {
      node: PackageLockNode<NodeKey, Selection, Metadata>
    }
  | PackageLockNodeDuplicate {
      key: NodeKey
      count: Int
    }

data package_lock_lookup_note: String = "EXACT CARDINALITY, NOT BOOLEAN MEMBERSHIP (operator portfolio 2026-08-04). any(key==) was fail-open on duplicates: one key and three duplicate keys both returned true, so roots and edges resolved against an ambiguous graph. Lookup is 0 / 1 / many."

fn package_lock_lookup_node<NodeKey, Selection, Metadata, EdgeKind, ManagerIdentity>(
  graph: PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>,
  key: NodeKey,
) -> PackageLockNodeLookup<NodeKey, Selection, Metadata> {
  fold(
    graph.nodes,
    init: PackageLockNodeAbsent { key: key },
    f: (acc, node) =>
      if node.key != key {
        acc
      } else {
        match acc {
          PackageLockNodeAbsent { key: _ } => PackageLockNodeUnique { node: node }
          PackageLockNodeUnique { node: _ } =>
            PackageLockNodeDuplicate { key: key, count: 2 }
          PackageLockNodeDuplicate { key: dup_key, count: c } =>
            PackageLockNodeDuplicate { key: dup_key, count: c + 1 }
        }
      },
  )
}

type PackageLockGraphAdmission<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>
  = PackageLockGraphAdmitted {
      graph: PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>
    }
  | PackageLockGraphDuplicateNode {
      key: NodeKey
      count: Int
    }
  | PackageLockGraphMissingRoot { key: NodeKey }
  | PackageLockGraphMissingEdgeConsumer { key: NodeKey }
  | PackageLockGraphMissingEdgeDependency { key: NodeKey }
  | PackageLockGraphLookupInconsistency { key: NodeKey }

data package_lock_admission_note: String = "EVERY PRODUCTION EFFECT BOUNDARY RE-ADJUDICATES the raw/parser-derived graph and proceeds only through the admitted arm — do not persist an independently supplied PackageLockGraphAdmitted as proof (the admitted arm is publicly constructible today; constructor confinement is the dissolve-on). Admission is exact-cardinality: duplicate keys refuse before roots or edges are trusted; missing roots and missing edge endpoints refuse with typed causes. Looking up a key while iterating graph.nodes cannot honestly be Absent — that is PackageLockGraphLookupInconsistency, not MissingRoot. Boolean membership is not an admission path."

fn package_lock_admit_graph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>(
  graph: PackageLockGraph<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind>,
) -> PackageLockGraphAdmission<ManagerIdentity, NodeKey, Selection, Metadata, EdgeKind> {
  let after_nodes = fold(
    graph.nodes,
    init: PackageLockGraphAdmitted { graph: graph },
    f: (acc, node) => match acc {
      PackageLockGraphAdmitted { graph: g } =>
        match package_lock_lookup_node(graph: g, key: node.key) {
          PackageLockNodeUnique { node: _ } => PackageLockGraphAdmitted { graph: g }
          PackageLockNodeDuplicate { key, count } =>
            PackageLockGraphDuplicateNode { key: key, count: count }
          PackageLockNodeAbsent { key } =>
            PackageLockGraphLookupInconsistency { key: key }
        }
      other => other
    },
  )
  let after_roots = match after_nodes {
    PackageLockGraphAdmitted { graph: g } =>
      fold(
        g.roots,
        init: PackageLockGraphAdmitted { graph: g },
        f: (acc, root_key) => match acc {
          PackageLockGraphAdmitted { graph: g2 } =>
            match package_lock_lookup_node(graph: g2, key: root_key) {
              PackageLockNodeUnique { node: _ } => PackageLockGraphAdmitted { graph: g2 }
              PackageLockNodeAbsent { key } => PackageLockGraphMissingRoot { key: key }
              PackageLockNodeDuplicate { key, count } =>
                PackageLockGraphDuplicateNode { key: key, count: count }
            }
          other => other
        },
      )
    other => other
  }
  match after_roots {
    PackageLockGraphAdmitted { graph: g3 } =>
      fold(
        g3.edges,
        init: PackageLockGraphAdmitted { graph: g3 },
        f: (acc, edge) => match acc {
          PackageLockGraphAdmitted { graph: g4 } =>
            match package_lock_lookup_node(graph: g4, key: edge.consumer) {
              PackageLockNodeAbsent { key } =>
                PackageLockGraphMissingEdgeConsumer { key: key }
              PackageLockNodeDuplicate { key, count } =>
                PackageLockGraphDuplicateNode { key: key, count: count }
              PackageLockNodeUnique { node: _ } =>
                match package_lock_lookup_node(graph: g4, key: edge.dependency) {
                  PackageLockNodeUnique { node: _ } =>
                    PackageLockGraphAdmitted { graph: g4 }
                  PackageLockNodeAbsent { key } =>
                    PackageLockGraphMissingEdgeDependency { key: key }
                  PackageLockNodeDuplicate { key, count } =>
                    PackageLockGraphDuplicateNode { key: key, count: count }
                }
            }
          other => other
        },
      )
    other => other
  }
}

data package_delivery_placement_note: String = "First delivery mechanism lands as a CONSUMED handler in gunbc.package_delivery (product policy + materialization); promote to std only after a second real consumer. That boundary re-calls package_lock_admit_graph on raw graphs."
