module extdeps.docker.container_stats


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.docker.com/engine/api/v1.47"
  }
}

type CpuStats {
  cpu_usage: CpuUsage
  system_cpu_usage: std.measure.Nanosecond
  online_cpus: std.nat.Nat
  cpu_percent: Float?
}

type CpuUsage {
  total_usage: std.measure.Nanosecond
  percpu_usage: List<std.measure.Nanosecond>?
  usage_in_kernelmode: std.measure.Nanosecond
  usage_in_usermode: std.measure.Nanosecond
}

type MemoryStats {
  usage: std.measure.ByteSize
  max_usage: std.measure.ByteSize
  limit: std.measure.ByteSize
  failcnt: std.nat.Nat?
}

type PidStats {
  current: std.nat.Nat?
}

type ContainerStats {
  read: std.types.Timestamp
  pids_stats: PidStats?
  blkio_stats: BlkioStats?
  cpu_stats: CpuStats
  memory_stats: MemoryStats
  networks: Networks?
}

type BlkioStats {
  io_service_bytes_recursive: List<BlkioValue>?
  io_service_time_recursive: List<BlkioValue>?
  io_serviced_recursive: List<BlkioValue>?
  io_time_recursive: List<BlkioValue>?
  sectors_recursive: List<BlkioValue>?
}

type BlkioValue {
  op: String
  value: std.nat.Nat
}

type NetworkStats {
  rx_bytes: std.measure.ByteSize
  rx_packets: std.nat.Nat
  rx_errors: std.nat.Nat
  rx_dropped: std.nat.Nat
  tx_bytes: std.measure.ByteSize
  tx_packets: std.nat.Nat
  tx_errors: std.nat.Nat
  tx_dropped: std.nat.Nat
}

type DockerContainerNetworkInterfaceStats {
  name: String
  stats: NetworkStats
}

type Networks {
  interfaces: List<DockerContainerNetworkInterfaceStats>
}

service docker.ContainerStats {
  config {
    endpoint: docker_default_endpoint
    auth: None

    retry: { max_attempts: 3, backoff: exponential, retry_on: [500, 502, 503, 504] }
  }

  operation GetStats {
    input {
      container_id: String
      stream: Bool = false
    }
    output {
      stats: ContainerStats
    }
    readonly
    transport rest {
      method: GET,
      path: "/containers/\{container_id\}/stats",
      query: { stream: stream }
    }
    response {
      200 => ContainerStats
      404 => String
      500 => String
    }
  }
}

data cpu_percent_ratio_carrier_frontier_rows: List<std.roster_frontier.FrontierRow> = [
  std.roster_frontier.frontier_row_decl(
    ref: decl_field_ref(
      module_path: "extdeps.docker.container_stats",
      decl_name: "ContainerStats",
      field_name: "cpu_percent",
    ),
    reason: "cpu_percent: Float? is a percentage/ratio without a Measure<Quantity, Scale, M> carrier; bare Float cannot encode unit semantics (is it 0–1 normalized or 0–100 scale?); fail-closed violation on unit-modeling",
    dissolution: unbound_dissolution(description: "Ratio or PercentagePoint typed alias lands in std/measure"),
  )
]

data container_stats_error_responses_frontier_rows: List<std.roster_frontier.FrontierRow> = [
  std.roster_frontier.frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.docker.container_stats", decl_name: "Stats"),
    reason: "Error responses (404 => String, 500 => String) collapse distinct error shapes (not-found vs server error) to opaque string, violating fail-closed (errors must be typed and located with structured diagnostics). Docker API returns JSON error objects with reason/message; should be modeled as ErrorDetail coproduct or structured record (NotFound | ServerError variants with message and optional retry info)",
    dissolution: unbound_dissolution(description: "typed error response variants land in extdeps/docker or extdeps/github.errors pattern applied here"),
  )
]

fn container_stats_error_closure_frontier_rows() -> List<std.roster_frontier.FrontierRow> {
  container_stats_error_responses_frontier_rows
}

fn container_stats_memory_usage(stats: ContainerStats) -> std.measure.ByteSize {
  stats.memory_stats.usage
}

fn container_stats_cpu_usage_total(stats: ContainerStats) -> std.measure.Nanosecond {
  stats.cpu_stats.cpu_usage.total_usage
}

fn container_stats_online_cpus(stats: ContainerStats) -> std.nat.Nat {
  stats.cpu_stats.online_cpus
}

data memory_stats_working_set_frontier_rows: List<std.roster_frontier.FrontierRow> = [
  std.roster_frontier.frontier_row_decl(
    ref: decl_field_ref(
      module_path: "extdeps.docker.container_stats",
      decl_name: "MemoryStats",
      field_name: "usage",
    ),
    reason: "MemoryStats.usage includes page cache (inactive_file); true working-set = usage - stats.inactive_file from Docker stats sub-map",
    dissolution: unbound_dissolution(description: "B2 models stats sub-map with inactive_file and policy uses working_set not raw usage"),
  )
]

data blkio_value_unit_ambiguity_frontier_rows: List<std.roster_frontier.FrontierRow> = [
  std.roster_frontier.frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.docker.container_stats", decl_name: "BlkioValue"),
    reason: "BlkioValue.value: Nat carries parent-dependent units (bytes under io_service_bytes_recursive, time under io_service_time_recursive, count under io_serviced_recursive); flat Nat smuggles unit invisible to type system (fail-closed unit-modeling); Docker wire format is the constraint; remedy = typed per-list accessors returning ByteSize|Nanosecond|Nat or parent-tagged union",
    dissolution: unbound_dissolution(description: "typed or tagged union models for BlkioValue land in extdeps/docker"),
  )
]
