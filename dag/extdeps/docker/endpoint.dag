module extdeps.docker.endpoint


data docker_default_endpoint: String = "unix:///var/run/docker.sock"

data dissolve_on_endpoint_string_type: List<String> = [
  "closure:ground_endpoint_uri_type|docker_default_endpoint is typed String but the module imports Uri; endpoint should be grounded as Uri variant (anemic-leaf §2/§5 — bare String cannot encode union of schemes, socket paths, host:port; same file uses Uri for authority anchor)|trigger:B3 grounds docker endpoint with Uri type carrying socket/http/https/fd schemes"
]

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.docker.com/engine/api/v1.47"
  }
}
