module extdeps.docker.endpoint

import std.types { String, Int }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.decl_ref { decl_ref }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data docker_default_endpoint: String = "unix:///var/run/docker.sock"

// Docker CLI's cited locator for which daemon to talk to. The rootful default above is the
// system socket; rootless mode (extdeps.container.docker_engine's first citation) listens at
// $XDG_RUNTIME_DIR/docker.sock, which for a logged-in uid is /run/user/<uid>/docker.sock.
data docker_host_env_var: String = "DOCKER_HOST"

fn docker_rootless_unix_endpoint(uid: Int) -> String {
  join(["unix:///run/user/", to_string(uid), "/docker.sock"], "")
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.docker.com/reference/cli/docker/"
  }
}

// Reading: Docker's CLI reference owns the daemon-selection surface: it documents the rootful default unix:///var/run/docker.sock for macOS/Linux. Data docker_default_endpoint is that documented default, so the datum is the surface this citation owns. The DOCKER_HOST override is a sibling datum (docker_host_env_var), not part of this one.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.docker.endpoint", decl_name: "docker_default_endpoint", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
