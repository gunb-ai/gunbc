module extdeps.docker.images.gitcommit90_glm_53_one_spark

import std.types { String, List, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "ghcr.io/gitcommit90/glm-5.3-one-spark"
  },
}

// THE COMMUNITY SM121 IMAGE THE GLM-5.3 ARM RUNS, PINNED BY REGISTRY DIGEST. It had no module of its
// own while the DeepSeek runtime did, so the arm carried its identity as a bare string. This module
// is the image's upstream identity in the shape extdeps.docker.images already uses, and it carries
// ONLY what the publisher declares: what this repository has OBSERVED about the image -- which
// architectures its registry answers for -- is a receipt of ours and lives in
// gunbc.spark.runtime_architecture_registry_reading, keyed by this digest.
data gitcommit90_glm_53_one_spark_repository: NonEmptyStr = "ghcr.io/gitcommit90/glm-5.3-one-spark" as NonEmptyStr
data gitcommit90_glm_53_one_spark_digest_sha256_hex: NonEmptyStr = "ba6db0547b24162854948fb16cda68dd4408360e03aeba480edb8d3d876eaeef" as NonEmptyStr
data gitcommit90_glm_53_one_spark_vllm_version: NonEmptyStr = "0.1.dev20051+g487ecf187" as NonEmptyStr
data gitcommit90_glm_53_one_spark_python: NonEmptyStr = "python3" as NonEmptyStr
data gitcommit90_glm_53_one_spark_hub_cli_path: NonEmptyStr = "/usr/local/bin/hf" as NonEmptyStr

// THE IMAGE IS BUILT FOR ONE COMPUTE CAPABILITY AND SAYS SO IN ITS OWN ENVIRONMENT.
// `docker image inspect` on this digest reports TORCH_CUDA_ARCH_LIST=12.1a and
// FLASHINFER_CUDA_ARCH_LIST=12.1a, read on spark-a3ee 2026-09-11. Torch inside it reports a compiled
// arch list of sm_80, sm_90, sm_100, sm_110, sm_120 -- sm_121 runs the sm_120 binaries, so the
// declared 12.1a build target and the absence of a literal sm_121 entry are consistent rather than
// in conflict, and neither is evidence about any particular kernel.
data gitcommit90_glm_53_one_spark_torch_cuda_arch_list: NonEmptyStr = "12.1a" as NonEmptyStr

fn gitcommit90_glm_53_one_spark_pinned_reference() -> NonEmptyStr {
  join([gitcommit90_glm_53_one_spark_repository as String, "@sha256:", gitcommit90_glm_53_one_spark_digest_sha256_hex as String], "") as NonEmptyStr
}
