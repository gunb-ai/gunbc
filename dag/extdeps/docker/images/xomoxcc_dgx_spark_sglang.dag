module extdeps.docker.images.xomoxcc_dgx_spark_sglang

import std.types { String, List, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "hub.docker.com/r/xomoxcc/dgx-spark-sglang"
  },
}

// AN SGLANG BUILD FOR GB10, pinned by registry digest, carried for the same reason as the
// timothystewart6 row: it is a probed candidate in the DeepSeek V4.1 runtime search, and a search
// that only ever probed vLLM images would be answering a narrower question than it claims to.
//
// ITS REGISTRY IS SGLANG'S OWN AND IS READ BY SGLANG'S OWN CALL, which is why this list is a fact
// about this image and not a translation of a vLLM one. Executed inside this exact digest on
// spark-a3ee (NVIDIA GB10, compute capability 12.1) on 2026-09-11: 247 entries, including
// DeepseekV4ForCausalLM and DeepseekV4ForCausalLMDSpark, and not DeepseekV41ForCausalLM.
//
// THE VERSION IS THE IMAGE TAG AND NOT A DISTRIBUTION VERSION: `importlib.metadata.version("sglang")`
// inside the image returns 0.0.0, which is the build's own metadata rather than a usable fact, so the
// tag is what is recorded and it is labelled as a tag.

data xomoxcc_dgx_spark_sglang_repository: NonEmptyStr = "xomoxcc/dgx-spark-sglang" as NonEmptyStr
data xomoxcc_dgx_spark_sglang_digest_sha256_hex: NonEmptyStr = "6f578ee2eaccb594891b5ff409612e27841cd72bb7237b96cf079a5ba90712c5" as NonEmptyStr
data xomoxcc_dgx_spark_sglang_framework_version: NonEmptyStr = "0.5.18-sm121 (image tag; the installed distribution reports 0.0.0)" as NonEmptyStr
data xomoxcc_dgx_spark_sglang_tag: NonEmptyStr = "0.5.18-sm121" as NonEmptyStr

// The pinned reference every probe and every create names: repository@sha256:digest, never the tag.
fn xomoxcc_dgx_spark_sglang_pinned_reference() -> NonEmptyStr {
  join([xomoxcc_dgx_spark_sglang_repository as String, "@sha256:", xomoxcc_dgx_spark_sglang_digest_sha256_hex as String], "") as NonEmptyStr
}

