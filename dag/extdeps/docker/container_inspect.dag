module extdeps.docker.container_inspect

import std.types { Timestamp, String, Int, FilePath }
import std.nat { Nat }
import std.measure { ByteSize, byte_size, byte_size_count, Microsecond, microsecond_count }
import extdeps.docker.endpoint { docker_default_endpoint }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.docker.container_inspect_contracts { container_state_wire_contract }

type ContainerState
  = Running
  | Paused
  | Exited
  | Dead
  | Restarting

type ErrorMessage = String

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.docker.com/engine/api/v1.47"
  }
}

type ContainerStateDetail {
  status: ContainerState
  running: Bool
  paused: Bool
  restarting: Bool
  oom_killed: Bool
  dead: Bool
  pid: Nat?
  exit_code: Int?
  error: ErrorMessage?
  started_at: Timestamp?
  finished_at: Timestamp?
}

data dissolve_on_container_state_detail_redundant_bools: List<String> = [
  "closure:ground_container_state_via_coproduct_not_bools|ContainerStateDetail carries status: ContainerState coproduct AND parallel running/paused/restarting/dead bools, allowing illegal states (status=Running, running=false). Faithful to Docker wire shape at extdeps boundary, but redundancy should be resolved inward — callers should derive bool predicates from status coproduct, not trust duplicated bools (§2 horizontal DRY)|trigger:wire-deserialization layer is added that reconstructs ContainerState authority from the wire status string, dropping the parallel bool fields from the internal model"
]

type HostConfig {
  cpu_shares: Nat?
  memory: ByteSize?
  memory_reservation: ByteSize?
  memory_swap: ByteSize?
  cpu_period: Microsecond?
  cpu_quota: Microsecond?
  cpuset_cpus: String?
  cpuset_mems: String?
  blkio_weight: Nat?
  blkio_weight_device: List<String>?
  network_mode: String?
  pid_mode: String?
  ipc_mode: String?
  uts_mode: String?
  cap_add: List<String>?
  cap_drop: List<String>?
  exposed_ports: List<String>?
  port_bindings: List<String>?
  volumes: List<String>?
  volumes_from: List<String>?
  device_requests: List<String>?
}

data dissolve_on_memory_swap_unlimited_convention: List<String> = [
  "closure:ground_unlimited_memory_via_special_variant|HostConfig.memory_swap: ByteSize? loses Docker wire convention where -1 encodes 'unlimited'; ByteSize is Measure<Memory, One, Nat> (Nat-backed, non-negative only), so wire value -1 cannot round-trip (fidelity gap at extdeps boundary). Callers cannot distinguish 'swap disabled' (-1) from 'swap zero bytes' (0) without special handling|trigger:Unlimited variant or tagged union for ByteSize-like fields lands in std/measure or extdeps/docker"
]

type ContainerConfig {
  hostname: String?
  domainname: String?
  user: String?
  attach_stdin: Bool?
  attach_stdout: Bool?
  attach_stderr: Bool?
  tty: Bool?
  open_stdin: Bool?
  stdin_once: Bool?
  env: List<String>?
  cmd: List<String>?
  image: String?
  volumes: List<String>?
  working_dir: String?
  entrypoint: List<String>?
  labels: List<String>?
  mac_address: String?
  exposed_ports: List<String>?
  network_disabled: Bool?
}

data dissolve_on_hostconfig_containerconfig_anemic_leaves: List<String> = [
  "closure:decompose_hostconfig_containerconfig_string_lists|HostConfig carries structured concepts as List<String>?: cap_add/cap_drop (privilege names), exposed_ports/port_bindings (host:container port specs), volumes/volumes_from (mount source:target:mode), device_requests (structured device specs); ContainerConfig similar: env (KEY=VALUE pairs), cmd/entrypoint (command args), labels (KEY=VALUE metadata), volumes (mount specs), exposed_ports (port specs). All anemic-leaf §2 violations (structured wire shapes flattened to bare strings)|trigger:typed port/env/volume carrier types land in extdeps/docker"
]

type ContainerInspect {
  id: String
  created: Timestamp
  path: FilePath?
  args: List<String>?
  state: ContainerStateDetail
  image: String
  resolv_conf_path: FilePath?
  hostname: String?
  name: String?
  restart_count: Nat?
  driver: String?
  platform: String?
  config: ContainerConfig?
  network_settings: NetworkSettings?
  host_config: HostConfig?
}

type NetworkSettings {
  bridge: String?
  gateway: String?
  ip_address: String?
  ip_prefix_len: Nat?
  mac_address: String?
  networks: List<String>?
}

data dissolve_on_network_settings_bare_strings: List<String> = [
  "closure:ground_network_address_types|NetworkSettings.gateway/ip_address/mac_address are bare String?, should be typed with IP/MAC carriers (e.g. IpAddress, MacAddress, IpCidr); lower stakes since std/network primitives don't exist yet, but structured type system would catch malformed/invalid addresses (§5 fail-closed)|trigger:network address carriers (IpAddress, MacAddress) land in std/ or extdeps/network"
]

service docker.Container {
  config {
    endpoint: docker_default_endpoint
    auth: None

    retry: { max_attempts: 3, backoff: exponential, retry_on: [500, 502, 503, 504] }
  }

  operation Inspect {
    input {
      container_id: String
      size: Bool = false
    }
    output {
      container: ContainerInspect
    }
    readonly
    transport rest {
      method: GET,
      path: "/containers/\{container_id\}/json",
      query: { size: size }
    }
    response {
      200 => ContainerInspect
      404 => String
      500 => String
    }
  }
}

data dissolve_on_error_responses_opaque_strings: List<String> = [
  "closure:typed_error_responses|Error responses (404 => String, 500 => String) collapse two distinct error shapes (not-found vs server error) to opaque string, violating §5 fail-closed (errors must be typed and located with structured diagnostics). Docker API returns JSON error objects with reason/message; should be modeled as ErrorDetail coproduct or structured record (NotFound | ServerError variants with message and optional retry info)|trigger:typed error response variants land in extdeps/docker or extdeps/github.errors pattern applied here"
]

fn container_inspect_memory_limit(inspect: ContainerInspect) -> ByteSize? {
  match inspect.host_config {
    Present { value: hc } => hc.memory
    Absent => none
  }
}

fn container_inspect_cpu_quota(inspect: ContainerInspect) -> Microsecond? {
  match inspect.host_config {
    Present { value: hc } => hc.cpu_quota
    Absent => none
  }
}

fn container_inspect_cpu_period(inspect: ContainerInspect) -> Microsecond? {
  match inspect.host_config {
    Present { value: hc } => hc.cpu_period
    Absent => none
  }
}

fn parse_container_state(raw: String) -> ContainerState? {
  match raw {
    "running" => Present { value: Running }
    "paused" => Present { value: Paused }
    "exited" => Present { value: Exited }
    "dead" => Present { value: Dead }
    "restarting" => Present { value: Restarting }
    _ => none
  }
}

fn container_state_wire_label(state: ContainerState) -> String {
  match state {
    Running => "running"
    Paused => "paused"
    Exited => "exited"
    Dead => "dead"
    Restarting => "restarting"
  }
}

data structural_coverage_gap_container_state_codec_hand_rolled: List<String> = [
  "closure:consolidate_variant_string_mapping|parse_container_state and container_state_wire_label hand-roll the SnakeCase mapping already declared in container_state_wire_contract. Dissolve when the codec-from-contract bridge derives decode and encode from CoproductWireContract rows directly."
]
