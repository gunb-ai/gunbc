module extdeps.docker.cli

import std.types { String, Bool, List, NonEmptyStr, FilePath }
import std.nat { Nat }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.docker { DockerMount, BindMount, VolumeMount, TmpfsMount }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.docker.com/reference/cli/docker/container/create/"
  },
}

// docker 29.2.1 on the Sparks (2026-09-05). The program is spelled absolute because a systemd
// ExecStart= requires an absolute path and the same argv is what the unit renders.
data docker_binary_path: NonEmptyStr = "/usr/bin/docker" as NonEmptyStr

type DockerRestartPolicy = RestartNo | RestartUnlessStopped | RestartAlways | RestartOnFailure

fn docker_restart_policy_wire(p: DockerRestartPolicy) -> NonEmptyStr {
  match p {
    RestartNo => "no" as NonEmptyStr
    RestartUnlessStopped => "unless-stopped" as NonEmptyStr
    RestartAlways => "always" as NonEmptyStr
    RestartOnFailure => "on-failure" as NonEmptyStr
  }
}

type DockerNamespaceMode = NamespaceHost | NamespacePrivate

fn docker_namespace_mode_wire(m: DockerNamespaceMode) -> NonEmptyStr {
  match m {
    NamespaceHost => "host" as NonEmptyStr
    NamespacePrivate => "private" as NonEmptyStr
  }
}

type DockerDeviceMapping {
  host_path: FilePath
  container_path: FilePath
  cgroup_permissions: NonEmptyStr
}

type DockerEnvAssignment {
  name: NonEmptyStr
  value: String
}

// Everything `docker create` is told for one container, as the fields the engine exposes back
// through `docker inspect` (HostConfig, Config, Mounts), so an observation and a desired spec are
// comparable field by field.
type DockerCreateSpec {
  name: NonEmptyStr
  image: NonEmptyStr
  network: DockerNamespaceMode
  ipc: DockerNamespaceMode
  shm_size_bytes: Nat
  memlock_unlimited: Bool
  gpus_all: Bool
  devices: List<DockerDeviceMapping>
  cap_add: List<NonEmptyStr>
  restart: DockerRestartPolicy
  mounts: List<DockerMount>
  env: List<DockerEnvAssignment>
  command: List<String>
}

fn docker_mount_flag(m: DockerMount) -> List<String> {
  match m {
    BindMount { host_path: h, container_path: c, readonly: ro } =>
      ["--mount", join(["type=bind,src=", h as String, ",dst=", c as String, if ro { ",ro" } else { "" }], "")]
    VolumeMount { volume: v, container_path: c, readonly: ro } =>
      ["--mount", join(["type=volume,src=", v as String, ",dst=", c as String, if ro { ",ro" } else { "" }], "")]
    TmpfsMount { container_path: c, size_bytes: n } =>
      ["--mount", join(["type=tmpfs,dst=", c as String, ",tmpfs-size=", to_string(n)], "")]
  }
}

fn docker_create_arguments(spec: DockerCreateSpec) -> List<String> {
  concat(
    concat(
      concat(
        concat(
          concat(
            [
              "create",
              "--name", spec.name as String,
              "--network", docker_namespace_mode_wire(m: spec.network) as String,
              "--ipc", docker_namespace_mode_wire(m: spec.ipc) as String,
              "--shm-size", to_string(spec.shm_size_bytes),
              "--restart", docker_restart_policy_wire(p: spec.restart) as String,
            ],
            if spec.memlock_unlimited { ["--ulimit", "memlock=-1:-1"] } else { [] },
          ),
          if spec.gpus_all { ["--gpus", "all"] } else { [] },
        ),
        flat_map(spec.devices, d => ["--device", join([d.host_path as String, ":", d.container_path as String, ":", d.cgroup_permissions as String], "")]),
      ),
      concat(
        flat_map(spec.cap_add, c => ["--cap-add", c as String]),
        concat(
          flat_map(spec.mounts, m => docker_mount_flag(m: m)),
          flat_map(spec.env, e => ["--env", join([e.name as String, "=", e.value], "")]),
        ),
      ),
    ),
    concat([spec.image as String], spec.command),
  )
}

fn docker_create_command(spec: DockerCreateSpec) -> ArgvCommand {
  argv_command(program: docker_binary_path, arguments: docker_create_arguments(spec: spec))
}

fn docker_start_command(name: NonEmptyStr) -> ArgvCommand {
  argv_command(program: docker_binary_path, arguments: ["start", name as String])
}

fn docker_remove_force_command(name: NonEmptyStr) -> ArgvCommand {
  argv_command(program: docker_binary_path, arguments: ["rm", "-f", name as String])
}

fn docker_stop_command(name: NonEmptyStr) -> ArgvCommand {
  argv_command(program: docker_binary_path, arguments: ["stop", name as String])
}

// `docker exec` runs argv inside a running container; env assignments ride `--env`, never the
// container's baked environment, so the caller decides every value the process sees.
fn docker_exec_command(name: NonEmptyStr, env: List<DockerEnvAssignment>, argv: List<String>) -> ArgvCommand {
  argv_command(
    program: docker_binary_path,
    arguments: concat(
      concat(["exec"], flat_map(env, e => ["--env", join([e.name as String, "=", e.value], "")])),
      concat([name as String], argv),
    ),
  )
}

fn docker_build_command(tag: NonEmptyStr, context_dir: FilePath) -> ArgvCommand {
  argv_command(program: docker_binary_path, arguments: ["build", "--tag", tag as String, context_dir as String])
}

// A BUILD IS NOT ALWAYS A TAG AND A DIRECTORY. docker_build_command above is the whole invocation for
// a context whose Dockerfile takes no arguments -- which is what the Spark pair runtime is, one FROM
// and one RUN. An upstream Dockerfile that publishes ARGs answers differently depending on what it
// is told, and a build that cannot say --build-arg, --target, --platform or --file cannot reach any
// of those answers: it gets the defaults, whatever they happen to be at that revision.
//
// THE TWO ARE ONE OPERATION AT DIFFERENT WIDTHS, NOT TWO OPERATIONS, so this spec carries the same
// tag-and-context pair and adds the fields the flags name. It is spelled as a record rather than as
// more positional parameters for the reason DockerCreateSpec is: a desired build and a rendered
// invocation stay comparable field by field, and a caller cannot silently omit one by miscounting
// arguments.
type DockerBuildArg {
  name: NonEmptyStr
  value: String
}

type DockerBuildSpec {
  tag: NonEmptyStr
  context_dir: FilePath
  dockerfile: NonEmptyStr
  target: NonEmptyStr
  platform: NonEmptyStr
  build_args: List<DockerBuildArg>
}

// `--build-arg NAME=VALUE` is ONE argv element carrying an equals sign, exactly as `--env` is for
// docker_create_arguments, and splitting it into two would be a different command line that the
// engine reads differently. The context directory is last, after every flag, which is where the CLI
// requires it.
fn docker_build_arg_flag(a: DockerBuildArg) -> List<String> {
  ["--build-arg", join([a.name as String, "=", a.value], "")]
}

fn docker_build_spec_arguments(spec: DockerBuildSpec) -> List<String> {
  concat(
    concat(
      [
        "build",
        "--file", spec.dockerfile as String,
        "--target", spec.target as String,
        "--platform", spec.platform as String,
        "--tag", spec.tag as String,
      ],
      flat_map(spec.build_args, a => docker_build_arg_flag(a: a)),
    ),
    [spec.context_dir as String],
  )
}

fn docker_build_spec_command(spec: DockerBuildSpec) -> ArgvCommand {
  argv_command(program: docker_binary_path, arguments: docker_build_spec_arguments(spec: spec))
}

// THE TAGGED QUESTION AND THE DIGEST-PINNED QUESTION ARE THE SAME IDENTITY READBACK, rendered
// two ways because Docker's listing and inspect APIs do not answer both spellings.
//
// A TAG uses `docker images --no-trunc --quiet <tag>`. That prints the local config id, or prints
// NOTHING and exits zero when the tag names no image, so converge_vllm_image can keep "not present"
// apart from "the query did not run". `docker images <ref>` matches REPOSITORY[:TAG] only.
//
// A DIGEST-PINNED REFERENCE (`repo@sha256:<hex>`) is invisible to that listing. fleet-converge
// run 34642398773 executed `--filter=reference=<repo>@sha256:<hex> --digests` on srv9 against an
// image the preceding pull had just accepted, and stdout was still empty. Inspect is the CLI
// that names a digest reference: `docker image inspect --format {{.Id}} <ref>`.
//
// BRACES ARE ASSEMBLED, NOT SPELLED. A Go template cannot inhabit a .dag string literal (the
// interpolator eats `{.Id}`), and the same braces sit outside gunbc.typed_argv_exec's portable-word
// allowlist. The probe's actual transport is spark_remote_run, which shell-quotes every word, so
// the template reaches the daemon. The tagged listing stays the listing, so inspect's non-zero
// exit on absence cannot collapse converge_vllm_image's "need to build" into "the query failed".
data docker_template_open: NonEmptyStr = "{" as NonEmptyStr
data docker_template_close: NonEmptyStr = "}" as NonEmptyStr

fn docker_inspect_id_format() -> String {
  join([
    docker_template_open as String, docker_template_open as String,
    ".Id",
    docker_template_close as String, docker_template_close as String,
  ], "")
}

fn docker_image_digest_arguments(image: NonEmptyStr) -> List<String> {
  if string_contains(s: image as String, pattern: "@sha256:") {
    ["image", "inspect", "--format", docker_inspect_id_format(), image as String]
  } else {
    ["images", "--no-trunc", "--quiet", image as String]
  }
}

fn docker_image_digest_command(image: NonEmptyStr) -> ArgvCommand {
  argv_command(program: docker_binary_path, arguments: docker_image_digest_arguments(image: image))
}

// THE SHORT MOUNT SPELLING, AND THE ONE REASON IT EXISTS BESIDE docker_mount_flag. `--mount` takes
// its fields as a COMMA-separated list, and a comma is not in the portable-word allowlist
// gunbc.typed_argv_exec enforces at the ssh seam, so a `--mount` argument cannot cross that seam at
// all -- it is refused before it reaches a host. `-v src:dst[:ro]` and `--tmpfs dst` are the CLI's
// own documented short forms of the same three mount kinds, spelled with colons and equals signs
// that the allowlist admits. This is one fact with two renderings chosen by what the transport can
// carry, not two answers to what a mount is: both fold the same DockerMount coproduct, exhaustively.
fn docker_short_mount_flag(m: DockerMount) -> List<String> {
  match m {
    BindMount { host_path: h, container_path: c, readonly: ro } =>
      ["-v", join([h as String, ":", c as String, if ro { ":ro" } else { "" }], "")]
    VolumeMount { volume: v, container_path: c, readonly: ro } =>
      ["-v", join([v as String, ":", c as String, if ro { ":ro" } else { "" }], "")]
    TmpfsMount { container_path: c, size_bytes: n } =>
      ["--tmpfs", join([c as String, ":size=", to_string(n)], "")]
  }
}

// `docker run --rm` executes argv in a throwaway container from an image, which is how a question
// about what an image CONTAINS is asked inside it rather than inferred from its provenance. The
// container is removed on exit, so asking twice asks the same question of the same bytes.
// THE ENTRYPOINT MUST BE NAMED, NOT INHERITED, AND A REFUSAL TAUGHT THIS. An image built to serve a
// model carries a serving entrypoint, so `docker run <image> python3 script.py` does not run python --
// it passes those words to the server as arguments, which answered `unrecognized arguments:
// .../v41_capability_probe.py`. A question about what an image CONTAINS is not a question its
// entrypoint is equipped to answer, so the caller supplies the program and the image supplies only
// the filesystem.
fn docker_run_ephemeral_command(image: NonEmptyStr, gpus_all: Bool, mounts: List<DockerMount>, entrypoint: NonEmptyStr, argv: List<String>) -> ArgvCommand {
  argv_command(
    program: docker_binary_path,
    arguments: concat(
      concat(
        concat(
          concat(["run", "--rm"], if gpus_all { ["--gpus", "all"] } else { [] }),
          flat_map(mounts, m => docker_short_mount_flag(m: m)),
        ),
        ["--entrypoint", entrypoint as String],
      ),
      concat([image as String], argv),
    ),
  )
}

fn docker_image_pull_command(image: NonEmptyStr) -> ArgvCommand {
  argv_command(program: docker_binary_path, arguments: ["image", "pull", image as String])
}
