module extdeps.docker.create_spec

import std.types { String, Bool, List, NonEmptyStr, FilePath, Int }
import std.measure { ByteSize, byte_size_count }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.docker { DockerMount, BindMount, VolumeMount, TmpfsMount }

// WHAT `docker create` IS TOLD FOR ONE CONTAINER, and the flags that spell it. This is the container plan's
// interface, split out of extdeps.docker.cli (which keeps the argv commands, the JSON readers and the
// program identity) so a program that only renders a plan -- a native claim starting containers through
// extdeps.docker.cli_service DockerCli -- does not take the command module's closure with it. One
// renderer still spells every flag; extdeps.docker.cli builds its commands from these functions.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.docker.com/reference/cli/docker/container/create/"
  },
}

type DockerRestartPolicy = RestartNo | RestartUnlessStopped | RestartAlways | RestartOnFailure

fn docker_restart_policy_wire(p: DockerRestartPolicy) -> NonEmptyStr {
  match p {
    RestartNo => "no" as NonEmptyStr
    RestartUnlessStopped => "unless-stopped" as NonEmptyStr
    RestartAlways => "always" as NonEmptyStr
    RestartOnFailure => "on-failure" as NonEmptyStr
  }
}

type DockerNamespaceMode = NamespaceHost | NamespacePrivate

fn docker_namespace_mode_wire(m: DockerNamespaceMode) -> NonEmptyStr {
  match m {
    NamespaceHost => "host" as NonEmptyStr
    NamespacePrivate => "private" as NonEmptyStr
  }
}

type DockerDeviceMapping {
  host_path: FilePath
  container_path: FilePath
  cgroup_permissions: NonEmptyStr
}

type DockerEnvAssignment {
  name: NonEmptyStr
  value: String
}

// Everything `docker create` is told for one container, as the fields the engine exposes back
// through `docker inspect` (HostConfig, Config, Mounts), so an observation and a desired spec are
// comparable field by field.
type DockerCreateSpec {
  name: NonEmptyStr
  image: NonEmptyStr
  network: DockerNamespaceMode
  ipc: DockerNamespaceMode
  // `HostConfig.ShmSize` reads back in bytes, so the spec holds the same quantity as std.measure's
  // ByteSize -- the same carrier docker_memory_limit_flags uses in extdeps.docker.cli -- and the
  // renderer below spells `--shm-size` from its count. A bare Nat here would stand in for that fact.
  shm_size: ByteSize
  memlock_unlimited: Bool
  gpus_all: Bool
  devices: List<DockerDeviceMapping>
  cap_add: List<NonEmptyStr>
  restart: DockerRestartPolicy
  mounts: List<DockerMount>
  env: List<DockerEnvAssignment>
  command: List<String>
}

fn docker_mount_flag(m: DockerMount) -> List<String> {
  match m {
    BindMount { host_path: h, container_path: c, readonly: ro } =>
      ["--mount", join(["type=bind,src=", h as String, ",dst=", c as String, if ro { ",ro" } else { "" }], "")]
    VolumeMount { volume: v, container_path: c, readonly: ro } =>
      ["--mount", join(["type=volume,src=", v as String, ",dst=", c as String, if ro { ",ro" } else { "" }], "")]
    TmpfsMount { container_path: c, size_bytes: n } =>
      ["--mount", join(["type=tmpfs,dst=", c as String, ",tmpfs-size=", to_string(n)], "")]
  }
}

// THE WORD SHAPES, ONE AUTHORITY. docker create's structured renderer and the raw word-list
// renderers (the GLM native arm's systemd Exec line) must spell a device mapping, a capability
// and the memlock ulimit identically; extracted 2026-09-17 when the native arm took the RoCE
// collective-transport plan and would otherwise have re-typed the three literals.
fn docker_memlock_unlimited_words() -> List<String> { ["--ulimit", "memlock=-1:-1"] }

fn docker_device_words(d: DockerDeviceMapping) -> List<String> {
  ["--device", join([d.host_path as String, ":", d.container_path as String, ":", d.cgroup_permissions as String], "")]
}

// A CDI DEVICE IS NOT A DEVICE NODE, AND THE DIFFERENCE IS THE WORD SHAPE. docker_device_words above
// renders the `host:container:perms` triple, which is correct for a path like /dev/nvidia0 and
// REJECTED for a CDI name: measured on srv1 2026-10-25 as the job user over its own rootless daemon,
// `docker run --rm --device nvidia.com/gpu=all:nvidia.com/gpu=all:rwm ubuntu:24.04 nvidia-smi -L`
// exits 125 with `docker: nvidia.com/gpu=all is not an absolute path`, while the same run with the
// bare name `--device nvidia.com/gpu=all` lists the GPU and exits 0. Docker resolves a CDI name
// through the generated spec and applies the spec's own permissions, so a caller that passed a triple
// would be quoting the acceptance path with a syntax that cannot work — and would then be tempted to
// conclude the host lacks the capability. Kept separate from docker_device_words rather than widened
// into it, because a DockerDeviceMapping's fields are FilePath-typed and a CDI name is not a path.
fn docker_cdi_device_words(device: NonEmptyStr) -> List<String> { ["--device", device as String] }

fn docker_cap_add_words(c: NonEmptyStr) -> List<String> { ["--cap-add", c as String] }

// ── ONE CONTAINER PLAN, TWO VERB PROJECTIONS ─────────────────────────────────────────────────
//
// A CONTAINER IS CREATED TWO WAYS IN THIS FLEET AND THEY ARE THE SAME CONTAINER. The relaunch
// transaction runs `docker create` then `docker start`, because it needs a handle it can rename and
// restore; a systemd unit runs `docker run --rm` in the foreground, because a unit stays active
// exactly while its exec does. Those are two REALIZATION handlers for one plan (DESIGN section 3:
// transport is a handler bound to a shape, never a fork of the shape), so the flags they spell come
// from one body here and neither may hand-assemble its own.
//
// WHAT THIS CLOSED. Until 2026-09-18 the GLM native arm's systemd unit built its own word list, and
// the two renderings of ONE Group-B launch had already drifted on three fields -- the create spec
// carried a --shm-size the unit did not, the two read their environment values from different
// authorities, and only the unit declared the usage-stats reporter off. Nothing could report the
// disagreement, because there was no shared value for a comparison to be against.
//
// THE RESTART FLAG IS THE ONE FIELD THE TWO PROJECTIONS DO NOT SHARE, and it is a refusal rather
// than an omission. `docker run --rm` conflicts with a restart policy: under systemd the supervisor
// IS systemd, so the container's own policy must be RestartNo, and a spec asking for anything else
// has asked for two supervisors. Dropping the field silently would be exactly the widen DESIGN
// section 5 forbids.
fn docker_container_identity_flags(spec: DockerCreateSpec) -> List<String> {
  [
    "--name", spec.name as String,
    "--network", docker_namespace_mode_wire(m: spec.network) as String,
    "--ipc", docker_namespace_mode_wire(m: spec.ipc) as String,
    "--shm-size", to_string(byte_size_count(b: spec.shm_size)),
  ]
}

fn docker_container_resource_flags(spec: DockerCreateSpec) -> List<String> {
  concat(
    concat(
      concat(
        if spec.memlock_unlimited { docker_memlock_unlimited_words() } else { [] },
        if spec.gpus_all { ["--gpus", "all"] } else { [] },
      ),
      flat_map(spec.devices, d => docker_device_words(d: d)),
    ),
    concat(
      flat_map(spec.cap_add, c => docker_cap_add_words(c: c)),
      concat(
        flat_map(spec.mounts, m => docker_mount_flag(m: m)),
        flat_map(spec.env, e => ["--env", join([e.name as String, "=", e.value], "")]),
      ),
    ),
  )
}

fn docker_container_image_and_command(spec: DockerCreateSpec) -> List<String> {
  concat([spec.image as String], spec.command)
}

fn docker_create_arguments_without_verb(spec: DockerCreateSpec) -> List<String> {
  concat(
    concat(
      concat(
        docker_container_identity_flags(spec: spec),
        ["--restart", docker_restart_policy_wire(p: spec.restart) as String],
      ),
      docker_container_resource_flags(spec: spec),
    ),
    docker_container_image_and_command(spec: spec),
  )
}

fn docker_create_arguments(spec: DockerCreateSpec) -> List<String> {
  concat(["create"], docker_create_arguments_without_verb(spec: spec))
}
