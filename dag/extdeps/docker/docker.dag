module extdeps.docker


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.docker.com/engine/storage/"
  }
}

type DockerImage {
  repository: std.types.NonEmptyStr
  tag: std.types.NonEmptyStr
  digest: std.content_hash.ContentHash?
}

type DockerMount
  = BindMount { host_path: std.types.FilePath, container_path: std.types.FilePath, readonly: Bool }
  | VolumeMount { volume: std.types.NonEmptyStr, container_path: std.types.FilePath, readonly: Bool }
  | TmpfsMount { container_path: std.types.FilePath, size_bytes: Int }
