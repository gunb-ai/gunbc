module extdeps.docker


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.docker.com/engine/storage/"
  }
}

type DockerImage {
  repository: NonEmptyStr
  tag: NonEmptyStr
  digest: ContentHash?
}

type DockerMount
  = BindMount { host_path: std.types.FilePath, container_path: std.types.FilePath, readonly: Bool }
  | VolumeMount { volume: NonEmptyStr, container_path: std.types.FilePath, readonly: Bool }
  | TmpfsMount { container_path: std.types.FilePath, size_bytes: Int }
