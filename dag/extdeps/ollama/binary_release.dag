module extdeps.ollama.binary_release

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.crypto.hash { Digest, sha256_digest }
import std.types { NonEmptyStr, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_ollama_binary_release_note: String = "CITED UPSTREAM FACTS ONLY. Install and extract live in gunbc.package_delivery once #8225 lands (Ollama as the second runtime-bundle consumer beside Codex). This module owns the pinned release row the closure digest derives from — never a shell leaf that would fork a parallel install path."

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ollama/ollama/releases"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ollama.binary_release",
      decl_name: "OllamaBinaryRelease",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type OllamaBinaryRelease {
  version: NonEmptyStr
  digest_linux_arm64: Digest
}

data ollama_v0_11_0_gpt_oss_support_note: String = "First upstream release listing OpenAI gpt-oss models (20B and 120B): github.com/ollama/ollama/releases/tag/v0.11.0 published 2025-08-05, release title 'Welcome OpenAI's gpt-oss models'."

data ollama_v0_11_0_release: OllamaBinaryRelease = OllamaBinaryRelease {
  version: "v0.11.0" as NonEmptyStr,
  digest_linux_arm64: sha256_digest(hex: "2b271bf318924cccb281f31cf06b1f8f723c5a2d146c629d83a4b35822c480de" as NonEmptyStr),
}

data ollama_required_release: OllamaBinaryRelease = ollama_v0_11_0_release
