data ollama_release_catalog: List<OllamaBinaryRelease> = [
  ollama_v0_32_9_release,
  ollama_v0_32_9_jetpack5_release,
  ollama_v0_32_9_jetpack6_release,
]

fn ollama_binary_release_for_observed_asset_digest(digest_hex: String) -> OllamaBinaryRelease? {
  fold(
    ollama_release_catalog,
    init: none,
    f: (acc, rel) => {
      match acc {
        Present { value: _ } => acc
        Absent =>
          if (rel.digest.hex as String) == digest_hex {
            Present { value: rel }
          } else {
            none
          }
      }
    },
  )
}

data ollama_required_release: OllamaBinaryRelease = ollama_v0_32_9_release
