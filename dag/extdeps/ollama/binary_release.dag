module extdeps.ollama.binary_release

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.crypto.hash { Digest, sha256_digest }
import std.types { NonEmptyStr, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_ollama_binary_release_note: String = "CITED UPSTREAM FACTS ONLY. Install and extract live in gunbc.package_delivery once #8225 lands (Ollama as the second runtime-bundle consumer beside Codex). This module owns the pinned release row the closure digest derives from — never a shell leaf that would fork a parallel install path."

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ollama/ollama/releases"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ollama.binary_release",
      decl_name: "OllamaBinaryRelease",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type OllamaArchiveFormat = TarZst | TarGz

type OllamaLinuxArchitecture = OllamaLinuxArm64 | OllamaLinuxAmd64

type OllamaBinaryRelease {
  version: NonEmptyStr
  release_page: NonEmptyStr
  asset_name: NonEmptyStr
  download_locator: NonEmptyStr
  architecture: OllamaLinuxArchitecture
  archive_format: OllamaArchiveFormat
  archive_layout_note: NonEmptyStr
  executable_relative_path: NonEmptyStr
  digest: Digest
}

data ollama_v0_11_0_feature_floor_note: String = "Feature-introduction floor for OpenAI gpt-oss model support — NOT the deployment artifact. Cited release: https://github.com/ollama/ollama/releases/tag/v0.11.0 published 2025-08-05."

data ollama_v0_11_0_release: OllamaBinaryRelease = OllamaBinaryRelease {
  version: "v0.11.0" as NonEmptyStr,
  release_page: "https://github.com/ollama/ollama/releases/tag/v0.11.0" as NonEmptyStr,
  asset_name: "ollama-linux-arm64.tgz" as NonEmptyStr,
  download_locator: "https://github.com/ollama/ollama/releases/download/v0.11.0/ollama-linux-arm64.tgz" as NonEmptyStr,
  architecture: OllamaLinuxArm64,
  archive_format: TarGz,
  archive_layout_note: "gzip tar root contains bin/ollama and lib/ entries per upstream linux-arm64.tgz layout" as NonEmptyStr,
  executable_relative_path: "bin/ollama" as NonEmptyStr,
  digest: sha256_digest(hex: "2b271bf318924cccb281f31cf06b1f8f723c5a2d146c629d83a4b35822c480de" as NonEmptyStr),
}

data ollama_v0_32_9_release: OllamaBinaryRelease = OllamaBinaryRelease {
  version: "v0.32.9" as NonEmptyStr,
  release_page: "https://github.com/ollama/ollama/releases/tag/v0.32.9" as NonEmptyStr,
  asset_name: "ollama-linux-arm64.tar.zst" as NonEmptyStr,
  download_locator: "https://github.com/ollama/ollama/releases/download/v0.32.9/ollama-linux-arm64.tar.zst" as NonEmptyStr,
  architecture: OllamaLinuxArm64,
  archive_format: TarZst,
  archive_layout_note: "zstd tar root contains bin/ollama and lib/ entries per upstream linux-arm64.tar.zst layout" as NonEmptyStr,
  executable_relative_path: "bin/ollama" as NonEmptyStr,
