type OllamaLinuxArchitecture = OllamaLinuxArm64 | OllamaLinuxAmd64

type OllamaLinuxAssetVariant = OllamaLinuxGenericCuda | OllamaLinuxJetPack5 | OllamaLinuxJetPack6

type OllamaBinaryRelease {
  version: std.types.NonEmptyStr
  release_page: std.types.NonEmptyStr
  architecture: OllamaLinuxArchitecture
  variant: OllamaLinuxAssetVariant
  archive_format: extdeps.archive.format.ArchiveFormat
  distribution_suffix_style: extdeps.archive.format.ArchiveDistributionSuffixStyle
  archive_layout_note: std.types.NonEmptyStr
  executable_relative_path: std.types.NonEmptyStr
  digest: extdeps.crypto.hash.Digest
  published_at: std.types.NonEmptyStr
  byte_size: std.measure.ByteSize
}

fn ollama_linux_arch_key(architecture: OllamaLinuxArchitecture) -> String {
  match architecture {
    OllamaLinuxArm64 => "arm64"
    OllamaLinuxAmd64 => "amd64"
  }
}

fn ollama_linux_asset_variant_infix(variant: OllamaLinuxAssetVariant) -> String {
  match variant {
    OllamaLinuxGenericCuda => ""
    OllamaLinuxJetPack5 => "-jetpack5"
    OllamaLinuxJetPack6 => "-jetpack6"
  }
}

fn ollama_linux_asset_variant_closure_key(variant: OllamaLinuxAssetVariant) -> String {
  match variant {
    OllamaLinuxGenericCuda => "generic-cuda"
    OllamaLinuxJetPack5 => "jetpack5"
    OllamaLinuxJetPack6 => "jetpack6"
  }
}

fn ollama_reported_version_matches_release(version: String, rel: OllamaBinaryRelease) -> Bool {
  let cited = rel.version as String
  let cited_bare = if starts_with(s: cited, prefix: "v") {
    substring(s: cited, start: 1, end: length(cited))
  } else {
    cited
  }
  version == cited || version == cited_bare
}

fn ollama_binary_release_asset_name(binary_release: OllamaBinaryRelease) -> std.types.NonEmptyStr {
  let suffix = archive_format_distribution_suffix(
    format: binary_release.archive_format,
    style: binary_release.distribution_suffix_style,
  )
  join(
    [
      "ollama-linux-",
      ollama_linux_arch_key(architecture: binary_release.architecture),
      ollama_linux_asset_variant_infix(variant: binary_release.variant),
      suffix,
    ],
    "",
  ) as std.types.NonEmptyStr
}

fn ollama_binary_release_download_locator(binary_release: OllamaBinaryRelease) -> std.types.NonEmptyStr {
  join(
    [
      "https://github.com/ollama/ollama/releases/download/",
      binary_release.version as String,
      "/",
      ollama_binary_release_asset_name(binary_release: binary_release) as String,
    ],
    "",
  ) as std.types.NonEmptyStr
}

fn ollama_binary_release_eq(a: OllamaBinaryRelease, b: OllamaBinaryRelease) -> Bool {
  (a.version as String) == (b.version as String)
    && a.architecture == b.architecture
    && a.variant == b.variant
    && archive_format_eq(a: a.archive_format, b: b.archive_format)
    && a.distribution_suffix_style == b.distribution_suffix_style
    && (a.digest.hex as String) == (b.digest.hex as String)
}

data ollama_v0_11_0_feature_floor_note: String = "Feature-introduction floor for OpenAI gpt-oss model support is ollama_gpt_oss_feature_introduction_floor in extdeps.ollama.capability — a semantic-version relation, not a materialisable binary-release row in this module. Cited release: https://github.com/ollama/ollama/releases/tag/0 published 2025-08-05."

