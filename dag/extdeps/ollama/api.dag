module extdeps.ollama.api

import std.types { String, Bool, List, NonEmptyStr, Port }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.content_hash { ContentHash, Sha256Digest, sha256_hex_digest, as_content_hash_cryptographic }
import extdeps.coverage { CoverageClosureEntry, CoverageClosureFact }
import extdeps.llm.anthropic_messages_api {
  MessagesApiImplementation,
  VersionHeaderAcceptedUnused,
  current_api_version
}

// OLLAMA AS ITS OWN UPSTREAM AUTHORITY, per the external-upstream-decomposition rule: an
// independently versioned product gets its own extdeps module rather than a variant in a generic
// serving-runtime enum. Adding vLLM or a NIM container later must not require editing this file, and
// must not widen a central product enum -- each is its own module citing its own API.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ollama/ollama/blob/main/docs/api.md"
  }
}

// THE SUBJECT IS THE HTTP API SURFACE -- the endpoints, their request shapes, and the response
// fields this repository consumes. NOT the serving policy (which model, which host, which endpoint
// binding: those are gunbc facts), and NOT the model artifacts themselves, which are separate
// upstream subjects with their own publishers.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ollama.api",
      decl_name: "OllamaEndpoint",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// The endpoints this repository reaches or has declared it will reach. Deliberately NOT the full
// API surface: modeling endpoints with no bearing here would be inventory rather than grounding.
// ApiV1Messages is the one row whose gunbc caller does not exist yet — it is named by
// ollama_messages_api_conformance, which is what makes it a modeled fact rather than inventory, and
// its caller is the harness the dedicated-coding-harness plan builds at its own gate.
type OllamaEndpoint
  = ApiVersion
  | ApiTags
  | ApiShow
  | ApiPull
  | ApiGenerate
  | ApiPs
  | ApiV1Messages

fn ollama_endpoint_path(endpoint: OllamaEndpoint) -> String {
  match endpoint {
    ApiVersion => "/api/version"
    ApiTags => "/api/tags"
    ApiShow => "/api/show"
    ApiPull => "/api/pull"
    ApiGenerate => "/api/generate"
    ApiPs => "/api/ps"
    ApiV1Messages => "/v1/messages"
  }
}

// GET vs POST is an upstream fact, not a caller's choice, so it lives on the endpoint rather than at
// each call site.
type OllamaHttpMethod = OllamaGet | OllamaPost

fn ollama_endpoint_method(endpoint: OllamaEndpoint) -> OllamaHttpMethod {
  match endpoint {
    ApiVersion => OllamaGet
    ApiTags => OllamaGet
    ApiShow => OllamaPost
    ApiPull => OllamaPost
    ApiGenerate => OllamaPost
    ApiPs => OllamaGet
    ApiV1Messages => OllamaPost
  }
}

// THE DEFAULT PORT IS AN UPSTREAM FACT and is cited as one. The BIND ADDRESS is not: ollama listens
// on 127.0.0.1 by default and OLLAMA_HOST changes it, but which address a given deployment binds is
// a gunbc policy decision about reachability -- exactly the interface/policy split the extdeps rule
// draws, and putting a bind address here would be the layer inversion it names.
data ollama_default_port: Port = 11434

// A MODEL REFERENCE AS OLLAMA SPELLS IT: name plus tag, colon-separated on the wire. The two parts
// are modeled separately because they are separate facts -- `gpt-oss` is the model, `20b` is the
// variant -- and a single string would hide the join the way every other anemic leaf in this corpus
// did before decomposition.
type OllamaModelRef {
  name: NonEmptyStr
  tag: NonEmptyStr
}

fn ollama_model_ref_wire(ref: OllamaModelRef) -> String {
  join([ref.name as String, ":", ref.tag as String], "")
}

// THE DIGEST IS WHAT IDENTIFIES A MODEL, NOT THE TAG, and this distinction is the reason the whole
// artifact-identity carrier exists. A tag is a MOVING POINTER: upstream can repoint `gpt-oss:20b` at
// different bytes, exactly as a container `latest` tag moves, so a deployment pinned to a tag is
// pinned to nothing. /api/tags and /api/show both return a sha256 digest, and that is the identity
// this repository stores and compares.
//
// This is the same rule the corpus already reached for secret versions -- evidence must name a
// version, never the moving `latest` alias -- applied to a different upstream.
type OllamaModelDigest {
  ref: OllamaModelRef
  digest: Sha256Digest
}

// The bridge from wire hex to a typed digest. Partial and refusing, never fabricating: an
// unparseable digest yields Absent rather than a zero or a placeholder, because a model identity
// that is wrong is worse than one that is missing.
fn ollama_model_digest_from_wire(ref: OllamaModelRef, hex: String) -> OllamaModelDigest? {
  match sha256_hex_digest(hex: strip_sha256_prefix(text: hex)) {
    Present { value: d } => Present { value: OllamaModelDigest { ref: ref, digest: d } }
    Absent => none
  }
}

// Ollama returns digests both bare and `sha256:`-prefixed depending on endpoint. The prefix is wire
// serialization, not part of the identity -- the same conclusion std.content_hash reached for OCI
// descriptors -- so it is stripped here rather than stored.
fn strip_sha256_prefix(text: String) -> String {
  if starts_with(s: text, prefix: "sha256:") {
    substring(s: text, start: 7, end: length(text))
  } else {
    text
  }
}

fn ollama_model_content_hash(digest: OllamaModelDigest) -> ContentHash {
  as_content_hash_cryptographic(digest: digest.digest)
}

// OLLAMA SERVES THE ANTHROPIC MESSAGES SPECIFICATION, AND THE SHAPE IS NOT RE-MODELED HERE. The
// request and response bodies at this endpoint are extdeps.llm.anthropic_messages_api's subject;
// this module owns only the fact that this product serves them, at which of its own endpoints, and
// under which version binding. Restating the content blocks here would fork the shape the way
// modeling them inside a vendor module did before they were hoisted.
//
// The version binding is the arm that matters to a caller: upstream documents that the
// anthropic-version header is ACCEPTED BUT NOT USED, so an accepted request carries no evidence
// that the revision asked for is the revision served. VersionHeaderAcceptedUnused is that fact, and
// it is why the axis is a coproduct rather than a header string every implementation restates.
data ollama_messages_api_conformance: MessagesApiImplementation = MessagesApiImplementation {
  implementation: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ollama.api",
      decl_name: "OllamaEndpoint",
      field: WholeDeclaration
    }
  },
  spec_version: current_api_version,
  version_binding: VersionHeaderAcceptedUnused {},
  citation: ExternalAuthority {
    uri: Uri {
      scheme: Https
      locator: "github.com/ollama/ollama/blob/main/docs/api/anthropic-compatibility.mdx"
    }
  }
}

// CONFORMANCE IS NOT COVERAGE, and this row keeps the difference readable rather than letting the
// row above be read as "the whole specification is served". Upstream's compatibility page lists the
// request fields and features it supports; which parts of the modeled shape fall outside that list
// is unmodeled, so a caller cannot yet be refused structurally for sending one.
data structural_coverage_gap_ollama_messages_api_supported_surface: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "ollama_messages_api_conformance" },
      Residue { description: "supported_request_field_and_content_block_subset_not_modeled_per_implementation" }
    ],
    trigger: "the messages specification carries a per-implementation supported-surface projection that refuses an unsupported field at construction rather than at the wire"
  }
]
