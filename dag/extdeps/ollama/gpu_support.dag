module extdeps.ollama.gpu_support


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.ollama.com/gpu"
  }
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.ollama.gpu_support",
      decl_name: "OllamaGpuSupportRow",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type OllamaGpuSupportRow {
  gpu_model: std.types.NonEmptyStr
  compute_capability: extdeps.gpu.types.GpuComputeCapability
}

data ollama_gb10_gpu_support_row: OllamaGpuSupportRow = OllamaGpuSupportRow {
  gpu_model: "GB10" as std.types.NonEmptyStr,
  compute_capability: extdeps.gpu.types.GpuComputeCapability {
    vendor: nvidia,
    major: 12,
    minor: 1,
  },
}

type OllamaNvidiaDriverVersion {
  major: std.nat.Nat
}

data ollama_gb10_minimum_nvidia_driver: OllamaNvidiaDriverVersion = OllamaNvidiaDriverVersion {
  major: 550,
}

data ollama_gb10_driver_requirement_note: String = "docs.ollama.com/gpu documents GB10 (DGX Spark) at compute capability 12.1 with NVIDIA driver 550 or newer. An old driver does not refuse install — Ollama falls back to CPU — so an unobserved driver must not read as satisfied."

type OllamaNvidiaDriverRequirementVerdict
  = OllamaNvidiaDriverRequirementSatisfied
  | OllamaNvidiaDriverRequirementUnmet {
      observed: OllamaNvidiaDriverVersion,
      minimum: OllamaNvidiaDriverVersion,
    }
  | OllamaNvidiaDriverRequirementUnobserved { cause: std.types.NonEmptyStr }

fn ollama_nvidia_driver_version_from_wire_text(raw: String) -> OllamaNvidiaDriverVersion? {
  let trimmed = trim(s: raw)
  if trimmed == "" {
    none
  } else {
    let parts = split(s: trimmed, delimiter: ".")
    match parse_int(s: parts.first()) {
      Absent => none
      Present { value: major } =>
        if major < 0 {
          none
        } else {
          Present { value: OllamaNvidiaDriverVersion { major: major } }
        }
    }
  }
}

fn ollama_nvidia_driver_version_at_least(
  observed: OllamaNvidiaDriverVersion,
  minimum: OllamaNvidiaDriverVersion,
) -> Bool {
  observed.major >= minimum.major
}

fn ollama_nvidia_driver_requirement_verdict(
  observed: OllamaNvidiaDriverVersion?,
  minimum: OllamaNvidiaDriverVersion,
) -> OllamaNvidiaDriverRequirementVerdict {
  match observed {
    Absent =>
      OllamaNvidiaDriverRequirementUnobserved {
        cause: "nvidia driver version is unobserved; GB10 GPU acceleration cannot be admitted" as std.types.NonEmptyStr,
      }
    Present { value: driver } =>
      if ollama_nvidia_driver_version_at_least(observed: driver, minimum: minimum) {
        OllamaNvidiaDriverRequirementSatisfied
      } else {
        OllamaNvidiaDriverRequirementUnmet {
          observed: driver,
          minimum: minimum,
        }
      }
  }
}
