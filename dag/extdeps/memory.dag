module extdeps.memory


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Computer_memory"
  }
}

fn memory_population_row_bytes(row: MemoryPopulationRow) -> ByteSize {
  byte_size(
    byte_size_count(row.module.capacity_bytes) * row.stick_count,
  )
}

fn host_memory_population_nominal_bytes(pop: HostMemoryPopulation) -> ByteSize {
  byte_size(
    pop.rows
      |> fold(
        init: 0,
        f: (acc, row) => acc + byte_size_count(memory_population_row_bytes(row)),
      ),
  )
}
