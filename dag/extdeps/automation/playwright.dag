data playwright_browser_provisioning_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "playwright.dev/docs/browsers"
  }
}

type Playwright
  = | PlaywrightAutomationProject

data playwright: Playwright = PlaywrightAutomationProject

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.automation.playwright",
      decl_name: "playwright",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [playwright_browser_provisioning_authority]
}

type PlaywrightVersion = std.types.NonEmptyStr where brand("PlaywrightVersion")
type PlaywrightSourceRevision = std.types.NonEmptyStr where brand("PlaywrightSourceRevision")

type PlaywrightBuild {
  version: PlaywrightVersion
  source_revision: PlaywrightSourceRevision
}

data playwright_1_62_1: PlaywrightBuild = PlaywrightBuild {
  version: "1.62.1" as PlaywrightVersion,
  source_revision: "26a9e470a7b3c7822084b09fb7f13902c5f37b51" as PlaywrightSourceRevision,
}

type PlaywrightBrowserBinaryProvenance
  = | PlaywrightManagedChromiumDownload

data playwright_identity_boundary_note: std.types.NonEmptyStr = "PlaywrightBuild names the automation dependency. PlaywrightManagedChromiumDownload says only that Playwright provisioned and launched the tested Chromium binary; it does not reclassify that binary as Google Chrome or establish behavior for any browser distribution." as std.types.NonEmptyStr
