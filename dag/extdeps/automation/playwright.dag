fn playwright_package_in(rows: List<PlaywrightSonamePackage>, soname: String) -> PlaywrightHostLibraryPackage? {
  match rows {
    Empty => none
    Cons { head: row, tail: rest } =>
      if (row.soname as String) == soname { Present { value: row.package } } else { playwright_package_in(rows: rest, soname: soname) }
  }
}

fn playwright_package_for_soname(soname: String) -> PlaywrightHostLibraryPackage? {
  playwright_package_in(rows: playwright_chromium_lib2package_ubuntu2404_arm64, soname: soname)
}
