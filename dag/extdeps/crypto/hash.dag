module extdeps.crypto.hash

import std.types { NonEmptyStr, String }
import std.content_hash { as_content_hash_cryptographic, ContentHash, sha256_hex_digest }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "csrc.nist.gov/pubs/fips/180-4/upd1/final"
  }
}

type HashAlgorithm =
  | Sha256

data sha256_authority_note: NonEmptyStr = "SHA-256 per FIPS 180-4 (Secure Hash Standard, anchor above); the hex form is the lowercase hexadecimal rendering of the 32-byte output as sha256sum(1) prints it. A digest value carries its algorithm explicitly (Digest.algorithm) so an artifact pin is never an anonymous hex string fused into a field name."

type Digest {
  algorithm: HashAlgorithm
  hex: NonEmptyStr
}

fn sha256_digest(hex: NonEmptyStr) -> Digest {
  Digest { algorithm: Sha256, hex: hex }
}

fn digest_shell_verify_line(digest: Digest, file_path: NonEmptyStr) -> String {
  match digest.algorithm {
    Sha256 => join(["echo '", digest.hex as String, "  ", file_path as String, "' | sha256sum -c -"], "")
  }
}

data sha256_digest_content_hash_convergence_note: String = "THE BRIDGE from extdeps.crypto.hash.Digest to std.types.ContentHash for artifact pins — NOT a merge with std.content_hash's fnv1a64 structural fingerprint (dag/std/content_hash.dag, dag/extdeps/provisioning/ubuntu_install_media_fetch.dag install_media_fetch_hash_convergence_note). Digest is a cited cryptographic SHA-256 authority value; ContentHash is the branded carrier Pin and OCI descriptors use for expected_identity. sha256_digest_content_hash renders the cited hex into the OCI-style sha256:<hex> wire form already used by extdeps.container.oci.descriptor and extdeps.container.oci.ctrl_session_witness — one rendering rule, not a second digest concept and not a silent cast between unrelated hash families."

fn sha256_digest_content_hash(digest: Digest) -> ContentHash? {
  match digest.algorithm {
    Sha256 =>
      match sha256_hex_digest(hex: digest.hex as String) {
        Present { value: d } => Present { value: as_content_hash_cryptographic(digest: d) }
        Absent => none
      }
  }
}
