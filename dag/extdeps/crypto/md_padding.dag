module extdeps.crypto.md_padding

import std.types { Int, List }
import std.power_of_two { bitwise_pow2 }
import std.algebra { collection_count_shape, collection_map_shape, list_push }

// FIPS 180-4 section 5.1.1 padding and section 5.2.1 block parsing, ONE fact shared by every
// 512-bit-block member of the SHA family (SHA-1, SHA-256) and by the SHA-512 length suffix: the
// message, 0x80, the fewest zero octets leaving the length congruent to 56 (mod 64), then the bit
// length as a 64-bit big-endian integer. Only the compression function differs per hash.
fn md_zero_octets(n: Int, acc: List<Int>) -> List<Int> {
  if n <= 0 { acc } else { md_zero_octets(n: n - 1, acc: acc |> list_push(0)) }
}

fn md_length_octets(bits: Int) -> List<Int> {
  [0, 7, 6, 5, 4, 3, 2, 1] |> map(i => if i == 0 { 0 } else { (bits / bitwise_pow2(n: 8 * (i - 1))) % 256 })
}

fn md_append_octets(left: List<Int>, right: List<Int>) -> List<Int> {
  fold(right, init: left, f: (acc, o) => acc |> list_push(o))
}

fn md_padded_64(message: List<Int>) -> List<Int> {
  let len = count(message)
  let zeros = (119 - len % 64) % 64
  md_append_octets(left: md_append_octets(left: message |> list_push(128), right: md_zero_octets(n: zeros, acc: [])), right: md_length_octets(bits: len * 8))
}

type MdBlocks {
  done: List<List<Int>>
  block: List<Int>
}

// The padded message cut into its 64-octet blocks, in order.
fn md_blocks_64(message: List<Int>) -> List<List<Int>> {
  fold(md_padded_64(message: message), init: MdBlocks { done: [], block: [] }, f: (acc, octet) => {
    let block = acc.block |> list_push(octet)
    if count(block) == 64 {
      MdBlocks { done: acc.done |> list_push(block), block: [] }
    } else {
      MdBlocks { done: acc.done, block: block }
    }
  }).done
}
