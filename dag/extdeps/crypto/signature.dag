module extdeps.crypto.signature

import std.types { NonEmptyStr, String, Int, List }
import std.logic { Bool }
import std.decl_ref { DeclarationRef, decl_ref }
import std.measure { ByteSize, byte_size, byte_size_count }
import std.encoding { base64_decode, UrlSafe }
import std.bytes { bytes_octets, utf8_encode_bytes }
import extdeps.crypto.nist_p256 { p256_ecdsa_verify_octets }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// ECDSA per FIPS 186-5 (Digital Signature Standard), over the NIST P-256 curve (SP 800-186) with
// SHA-256 (FIPS 180-4, cited by extdeps.crypto.hash). The anchor is the standard, not Apple and not
// a crate: the Secure Enclave is one PRODUCER of this signature (extdeps.apple.secure_enclave) and a
// server-side verifier is another realization of the same shape. §3: the interface is modeled once.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "csrc.nist.gov/pubs/fips/186-5/final"
  }
}

// THE ASYMMETRIC TWIN OF extdeps.crypto.mac, and the reason it exists is the note that module
// carries: with a MAC, whoever can verify can mint. A verifier that must NOT be able to issue -- a
// server that records which device decided, and must not be able to forge that device's decision --
// needs a public-key construction. That is the only property this module adds, and the only one a
// consumer may rely on it for.

// ONE FIXED SUITE, closed for the same algorithm-confusion reason as MacSuite: the verifier picks
// the suite from its enrolled key, never from the message it is checking.
type SignatureSuite =
  | EcdsaP256Sha256

// THE PUBLIC KEY SPELLING IS SEC 1 §2.3.3 UNCOMPRESSED POINT: 0x04 || X || Y, 65 octets for P-256.
// It is also ANSI X9.63's spelling, which is the name Apple's CryptoKit exposes it under
// (x963Representation). One spelling on the wire, so a key cannot be enrolled under one encoding
// and compared under another.
fn signature_suite_public_key_size(s: SignatureSuite) -> ByteSize {
  match s {
    EcdsaP256Sha256 => byte_size(count: 65)
  }
}

// THE SIGNATURE SPELLING IS THE FIXED-WIDTH r || s, 64 octets for P-256 (IEEE P1363 form; CryptoKit
// rawRepresentation). DER (CryptoKit derRepresentation) is the other common spelling; it is not
// admitted, because a verifier that accepts two encodings of one signature has a malleability
// surface it did not need.
fn signature_suite_signature_size(s: SignatureSuite) -> ByteSize {
  match s {
    EcdsaP256Sha256 => byte_size(count: 64)
  }
}

type PublicKeyEncoding =
  | Sec1Uncompressed

type SignatureEncoding =
  | P1363FixedWidth

// The key a verifier holds. Not Secret: a public key is published by design, and wrapping it would
// stop it reaching the audit record where it belongs.
type VerifyingKey {
  suite: SignatureSuite
  encoding: PublicKeyEncoding
  point_b64url: NonEmptyStr
}

type SignatureBytes {
  suite: SignatureSuite
  encoding: SignatureEncoding
  b64url: NonEmptyStr
}

// ── Verification ─────────────────────────────────────────────────────────────────────────────
// THE SUCCESS CARRIES THE MESSAGE AND THE KEY, for the reason extdeps.crypto.mac VerifiedMessage
// does: a success detached from its message authenticates every message. sole_constructor makes the
// only mint the realization seam below.
type SignedMessage sole_constructor {
  key: VerifyingKey
  message: NonEmptyStr
}

type SignatureVerification
  = SignatureVerified { verified: SignedMessage }
  | SignatureInvalid { suite: SignatureSuite }
  | SignatureMalformed { declared: ByteSize, expected: ByteSize }
  | VerifyingKeyMalformed { declared: ByteSize, expected: ByteSize }
  | SignatureSuiteMismatch { key_suite: SignatureSuite, signature_suite: SignatureSuite }
  | VerifyingKeyUndecodable { point_b64url: NonEmptyStr }
  | SignatureUndecodable { b64url: NonEmptyStr }

// THE BOUND IMPLEMENTATION IS extdeps.crypto.nist_p256 p256_ecdsa_verify_octets, IN .dag: the
// host-Rust primitive this note once named as missing was refused by the operator (gunbc#11588/
// #11592), and verify_signature below is the join. The consumer is the /approve device route's
// signature check (gunbc.auth.approval_device_redemption); what that route still lacks is an
// execution route in usable time -- one interpreted verification is minutes and gigabytes
// (gunbc#11645) -- which is the declared frontier gunbc.auth.approval_device_redemption
// ecdsa_verification_realization_frontier names, not a missing binding.
//
// ── The realization seam ─────────────────────────────────────────────────────────────────────
// Same boundary as mac_verification_from_implementation, stated the same way: evidence cannot exist
// without naming its message and key (structural), and whether the bound implementation actually ran
// ECDSA verification over those bytes is the realization's trust, not this module's (not
// structural). Length checks happen HERE, before the implementation is consulted, because they are
// facts of the suite and not of the curve arithmetic.
// THE CARRIER REFUSALS, the suite facts alone: a suite mismatch or a wrong key or signature size.
// They are one function so the seam below and the join that feeds it read ONE authority for them,
// and the join can ask before it consults the implementation at all.
fn signature_carrier_refusal(
  key: VerifyingKey,
  key_size: ByteSize,
  signature: SignatureBytes,
  signature_size: ByteSize,
) -> SignatureVerification? {
  if key.suite != signature.suite {
    Present { value: SignatureSuiteMismatch { key_suite: key.suite, signature_suite: signature.suite } }
  } else if byte_size_count(b: key_size) != byte_size_count(b: signature_suite_public_key_size(s: key.suite)) {
    Present { value: VerifyingKeyMalformed { declared: key_size, expected: signature_suite_public_key_size(s: key.suite) } }
  } else if byte_size_count(b: signature_size) != byte_size_count(b: signature_suite_signature_size(s: signature.suite)) {
    Present { value: SignatureMalformed { declared: signature_size, expected: signature_suite_signature_size(s: signature.suite) } }
  } else {
    none
  }
}

// THE SUCCESS MINT IS SEALED (review 5289941544). Its admitted callers are ITS ONE REAL SUPPLIER
// and, beside it, the named fixture declarations of test.claim.approval_device_redemption_witness_test,
// which supply verified evidence to redemption admission at THAT interface (DESIGN section 3), and
// the wire witness's claim that a false verdict mints SignatureInvalid, which exercises this seam. Every
// non-supplier entry is a test.* declaration; a module not on this roster cannot mint a success at
// all, and is refused at compile time. THE PAIRING OBLIGATION, stated so a reader sees that supplying
// the evidence did not remove the last real execution: verify_signature's P-256 verification of real carriers (test.claim.signature_verify_join_witness_test the_rfc6979_sample_verifies_through_the_seam) is the declared frontier gunbc.auth.approval_device_redemption ecdsa_verification_realization_frontier, triggered by MachineWidth<N> reification letting this closure emit; on the floor today the join executes to its carrier refusals.
fn signature_verification_from_implementation(
  key: VerifyingKey,
  key_size: ByteSize,
  signature: SignatureBytes,
  signature_size: ByteSize,
  message: NonEmptyStr,
  implementation_verified: Bool,
) -> SignatureVerification
  admit_callers: [
    decl_ref(module_path: "extdeps.crypto.signature", decl_name: "verify_signature"),
    decl_ref(module_path: "test.claim.approval_device_redemption_witness_test", decl_name: "verdict"),
    decl_ref(module_path: "test.claim.approval_device_wire_witness_test", decl_name: "witness_false_verdict_is_invalid"),
  ]
{
  match signature_carrier_refusal(key: key, key_size: key_size, signature: signature, signature_size: signature_size) {
    Present { value: r } => r
    Absent =>
      if implementation_verified {
        SignatureVerified { verified: SignedMessage { key: key, message: message } }
      } else {
        SignatureInvalid { suite: signature.suite }
      }
  }
}

// ── The join ─────────────────────────────────────────────────────────────────────────────────
// Decodes the wire carriers, hands their measured sizes to the seam (which refuses a wrong size
// before any arithmetic), and supplies the curve verifier's answer as the implementation verdict.
// The message is signed as its UTF-8 octets, hashed by the suite (CryptoKit hashes the data it is
// given; extdeps.apple.secure_enclave fixes that spelling). A carrier that does not base64-decode
// has NO measured size, so it refuses as VerifyingKeyUndecodable / SignatureUndecodable naming the
// carrier -- never as Malformed with a size that was not observed (review 70731). A carrier that
// decodes to zero octets was measured, and refuses as Malformed with declared 0. A key of the right
// size that is not an admitted point (off the curve, coordinate >= p) is answered SignatureInvalid
// -- typed, located at the suite, and never a verification.
fn verify_signature(key: VerifyingKey, signature: SignatureBytes, message: NonEmptyStr) -> SignatureVerification {
  match base64_decode(s: key.point_b64url as String, variant: UrlSafe) {
    Absent => VerifyingKeyUndecodable { point_b64url: key.point_b64url }
    Present { value: key_octets } =>
      match base64_decode(s: signature.b64url as String, variant: UrlSafe) {
        Absent => SignatureUndecodable { b64url: signature.b64url }
        Present { value: signature_octets } => {
          let key_size = byte_size(count: count(key_octets))
          let signature_size = byte_size(count: count(signature_octets))
          match signature_carrier_refusal(key: key, key_size: key_size, signature: signature, signature_size: signature_size) {
            Present { value: r } => r
            Absent => {
              let implementation_verified = match key.suite {
                EcdsaP256Sha256 =>
                  match p256_ecdsa_verify_octets(key: key_octets, signature: signature_octets, message: bytes_octets(b: utf8_encode_bytes(s: message as String))) {
                    Present { value: v } => v
                    Absent => false
                  }
              }
              signature_verification_from_implementation(
                key: key, key_size: key_size,
                signature: signature, signature_size: signature_size,
                message: message, implementation_verified: implementation_verified,
              )
            }
          }
        }
      }
  }
}
