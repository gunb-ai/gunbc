module extdeps.sec.issuer.rollins_facts



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "data.sec.gov/api/xbrl/companyfacts/CIK0000084839.json"
  }
}

data rollins_facts_subject: extdeps.sec.types.IssuerCatalogRow = rollins_issuer_catalog

data rollins_facts_provenance_note: String = "Every amount is a live pull from data.sec.gov companyfacts (2026-07-21, session snappy-carp-882). CIK 0000084839 verified against the SEC company_tickers.json ticker-to-CIK map and the EDGAR submissions API (tickers: [\"ROL\"], exchanges: [\"NYSE\"]). Fiscal year ended 2025-12-31, form 10-K, accession 0000084839-26-000008, filed 2026-02-12. Rollins' FY2025 10-K does not tag GrossProfit or CostOfRevenue on the us-gaap axis — it tags CostOfGoodsAndServiceExcludingDepreciationDepletionAndAmortization instead (the element-substitution case: the issuer's actually-filed tag is the authority, not a normalized nickname), with depreciation/amortization reported as a separate line. Revenue + cost + SG&A + D&A reconciles exactly to the filed OperatingIncomeLoss (3,761,050,000 - 1,777,006,000 - 1,133,232,000 - 124,744,000 = 726,068,000), so the profitability witness below derives operating margin rather than gross margin."

data rollins_fy2025_citation: extdeps.sec.facts.FiledFactCitation = extdeps.sec.facts.FiledFactCitation {
  accession: "0000084839-26-000008",
  fiscal_year: 2025,
  fiscal_period: "FY",
  form: AnnualReport,
  period: extdeps.sec.facts.FiledDuration { start: "2025-01-01", end: "2025-12-31" },
  filed_date: "2026-02-12",
}

data rollins_fy2025_revenue: extdeps.sec.facts.FiledMonetaryFact = extdeps.sec.facts.FiledMonetaryFact {
  element: us_gaap_revenue_from_contract_with_customer_excluding_assessed_tax,
  amount: Filed { amount: usd_whole_dollars(count: 3761050000) },
  citation: rollins_fy2025_citation,
}

data rollins_fy2025_cost_of_goods_and_services: extdeps.sec.facts.FiledMonetaryFact = extdeps.sec.facts.FiledMonetaryFact {
  element: us_gaap_cost_of_goods_and_service_excluding_depreciation_depletion_and_amortization,
  amount: Filed { amount: usd_whole_dollars(count: 1777006000) },
  citation: rollins_fy2025_citation,
}

data rollins_fy2025_sga: extdeps.sec.facts.FiledMonetaryFact = extdeps.sec.facts.FiledMonetaryFact {
  element: us_gaap_selling_general_and_administrative_expense,
  amount: Filed { amount: usd_whole_dollars(count: 1133232000) },
  citation: rollins_fy2025_citation,
}

data rollins_fy2025_operating_income: extdeps.sec.facts.FiledMonetaryFact = extdeps.sec.facts.FiledMonetaryFact {
  element: us_gaap_operating_income_loss,
  amount: Filed { amount: usd_whole_dollars(count: 726068000) },
  citation: rollins_fy2025_citation,
}

data rollins_fy2025_filed_facts: List<extdeps.sec.facts.FiledMonetaryFact> = [
  rollins_fy2025_revenue,
  rollins_fy2025_cost_of_goods_and_services,
  rollins_fy2025_sga,
  rollins_fy2025_operating_income,
]
