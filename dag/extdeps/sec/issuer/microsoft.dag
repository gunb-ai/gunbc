module extdeps.sec.issuer.microsoft



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.sec.gov/cgi-bin/browse-edgar?CIK=0000789019"
  }
}

data microsoft_cik_digits: NonEmptyStr = "789019"

data microsoft_cik: extdeps.sec.types.Cik = extdeps.sec.types.Cik { digits: microsoft_cik_digits }

data microsoft_ticker: extdeps.sec.types.StockTicker = extdeps.sec.types.StockTicker { symbol: "MSFT" }

data microsoft_issuer_catalog: extdeps.sec.types.IssuerCatalogRow = extdeps.sec.types.IssuerCatalogRow {
  cik: microsoft_cik,
  registrant_name: "MICROSOFT CORP",
  primary_ticker: microsoft_ticker,
  exchange: extdeps.sec.types.Nasdaq,
  vendor: extdeps.vendor.microsoft.microsoft,
}
