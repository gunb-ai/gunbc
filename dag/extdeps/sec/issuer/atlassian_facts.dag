import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "data.sec.gov/api/xbrl/companyconcept/CIK0001650372"
  }
}

data atlassian_facts_subject: IssuerCatalogRow = atlassian_issuer_catalog

data atlassian_facts_provenance_note: String = "Every amount is a live pull from data.sec.gov companyconcept (2026-07-25, session gitlab-10k-scm-costs-baz90x). CIK 0001650372 verified on the EDGAR submissions API (ticker TEAM, Nasdaq, SIC 7372 Services-Prepackaged Software). Four fiscal years modeled, FY2022 through FY2025; Atlassian fiscal years end June 30. The nearest pure-play comparable to GitLab in the corpus: a developer-collaboration vendor whose products (Jira, Confluence, Bitbucket) include an SCM, sold on the same per-seat subscription shape. The face statement cross-foots exactly in all four years: Revenue - cost of revenue = GrossProfit; ResearchAndDevelopment + SellingAndMarketing + GeneralAndAdministrative = OperatingExpenses; GrossProfit - OperatingExpenses = OperatingIncomeLoss."

data atlassian_comparative_period_note: String = "The FY2022 rows are the comparative period presented in the FY2023 10-K (accession 0001650372-23-000040). Atlassian re-domiciled to the United States in 2022; before that it filed as a foreign private issuer, so the FY2023 10-K is the earliest annual-report authority on this CIK for the FY2022 period. Same shape as the GitLab comparatives: EDGAR labels every row with the FILING's fiscal-year focus, so the citation carries fiscal_year 2023 while the FiledDuration bounds the fact's own fiscal year."

data atlassian_cost_element_substitution_note: String = "Atlassian SWITCHED cost-of-revenue elements mid-series: the FY2023 and FY2024 10-Ks tag CostOfRevenue, and the FY2025 10-K tags CostOfGoodsAndServicesSold. Each row below carries the element ITS OWN filing used -- the actually-filed tag is the authority per filing (DESIGN section 3), never normalized to one nickname for series convenience. This is the same element-substitution case as Rollins/Chemed/Microsoft, but observed WITHIN one issuer across time rather than across issuers, which is why a per-row element field (not a per-issuer one) is the right grain."

data atlassian_fy2022_comparative_citation: FiledFactCitation = FiledFactCitation {
  accession: "0001650372-23-000040",
  fiscal_year: 2023,
  fiscal_period: "FY",
  form: AnnualReport,
  period: FiledDuration { start: "2021-07-01", end: "2022-06-30" },
  filed_date: "2023-08-18",
}

data atlassian_fy2023_citation: FiledFactCitation = FiledFactCitation {
  accession: "0001650372-23-000040",
  fiscal_year: 2023,
  fiscal_period: "FY",
  form: AnnualReport,
  period: FiledDuration { start: "2022-07-01", end: "2023-06-30" },
  filed_date: "2023-08-18",
}

