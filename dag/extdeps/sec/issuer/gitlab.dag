module extdeps.sec.issuer.gitlab



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.sec.gov/cgi-bin/browse-edgar?CIK=0001653482"
  }
}

data gitlab_cik_digits: std.types.NonEmptyStr = "1653482"

data gitlab_cik: extdeps.sec.types.Cik = extdeps.sec.types.Cik { digits: gitlab_cik_digits }

data gitlab_ticker: extdeps.sec.types.StockTicker = extdeps.sec.types.StockTicker { symbol: "GTLB" }

data gitlab_issuer_catalog: extdeps.sec.types.IssuerCatalogRow = extdeps.sec.types.IssuerCatalogRow {
  cik: gitlab_cik,
  registrant_name: "Gitlab Inc.",
  primary_ticker: gitlab_ticker,
  exchange: Nasdaq,
  vendor: extdeps.vendor.gitlab,
}
