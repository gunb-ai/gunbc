data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "data.sec.gov/api/xbrl/companyconcept/CIK0000789019"
  }
}

data microsoft_facts_subject: IssuerCatalogRow = microsoft_issuer_catalog

data microsoft_facts_provenance_note: String = "Every amount is a live pull from data.sec.gov companyconcept (2026-07-25, session gitlab-10k-scm-costs-baz90x). CIK 0000789019 verified on the EDGAR submissions API (ticker MSFT, Nasdaq, SIC 7372 Services-Prepackaged Software -- the same SIC as GitLab and Atlassian). Four fiscal years modeled, FY2022 through FY2025; Microsoft fiscal years end June 30. Element substitution (the Rollins/Chemed case): Microsoft does NOT tag CostOfRevenue -- it tags CostOfGoodsAndServicesSold, and that actually-filed tag is the authority here, never a normalized nickname. The face statement cross-foots exactly in all four years: Revenue - CostOfGoodsAndServicesSold = GrossProfit; ResearchAndDevelopment + SellingAndMarketing + GeneralAndAdministrative = OperatingExpenses; GrossProfit - OperatingExpenses = OperatingIncomeLoss."

data microsoft_github_disaggregation_gap_note: String = "Microsoft acquired GitHub in 2018, and GitHub is the reason this issuer is in the corpus at all -- but GitHub revenue, cost of revenue, and infrastructure spend are NOT separately disclosed in any Microsoft 10-K. Microsoft reports three segments (Productivity and Business Processes, Intelligent Cloud, More Personal Computing); GitHub sits inside a segment without its own filed line, and segment facts are dimensional so they are stripped from the companyconcept/companyfacts APIs regardless (the chemed_segment_gap_note API boundary). No GitHub-level estimate is stored: the consolidated rows below are what is filed, and the honest read for SCM economics is the pure-play issuers (GitLab, Atlassian), with Microsoft as the scale contrast. Dissolve-on: a filed disaggregation naming GitHub, or ingesting the SEC Financial Statement Data Sets for segment members."

data microsoft_operating_expenses_element_gap_note: String = "Microsoft's FY2022 10-K does not tag OperatingExpenses on the us-gaap axis (the element first appears in the FY2025 filing, which carries FY2023-FY2025). The FY2022 total is therefore Unfiled with a stated cause rather than back-computed from its three components -- deriving it and storing it as filed would fabricate a filed fact (DESIGN section 5). The FY2022 components and OperatingIncomeLoss below are all filed, so the component-sum identity is still witnessed for that year without inventing the total."

data microsoft_fy2022_citation: FiledFactCitation = FiledFactCitation {
  accession: "0001564590-22-026876",
  fiscal_year: 2022,
  fiscal_period: "FY",
  form: AnnualReport,
  period: FiledDuration { start: "2021-07-01", end: "2022-06-30" },
  filed_date: "2022-07-28",
}

