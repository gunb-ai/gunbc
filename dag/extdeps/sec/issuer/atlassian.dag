module extdeps.sec.issuer.atlassian



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.sec.gov/cgi-bin/browse-edgar?CIK=0001650372"
  }
}

data atlassian_cik_digits: std.types.NonEmptyStr = "1650372"

data atlassian_cik: extdeps.sec.types.Cik = extdeps.sec.types.Cik { digits: atlassian_cik_digits }

data atlassian_ticker: extdeps.sec.types.StockTicker = extdeps.sec.types.StockTicker { symbol: "TEAM" }

data atlassian_issuer_catalog: extdeps.sec.types.IssuerCatalogRow = extdeps.sec.types.IssuerCatalogRow {
  cik: atlassian_cik,
  registrant_name: "Atlassian Corp",
  primary_ticker: atlassian_ticker,
  exchange: Nasdaq,
  vendor: atlassian,
}
