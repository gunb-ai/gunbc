  accession: "0001628280-22-008836",
  fiscal_year: 2022,
  fiscal_period: "FY",
  form: AnnualReport,
  period: FiledDuration { start: "2019-02-01", end: "2020-01-31" },
  filed_date: "2022-04-08",
}

