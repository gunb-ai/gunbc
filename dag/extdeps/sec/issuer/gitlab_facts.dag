data gitlab_operating_metrics_note: String = "Dollar-Based Net Retention Rate and ARR-threshold customer counts are Item 7 MD&A operating metrics (extdeps.sec.operating_metrics shapes), quoted from each fiscal year's own 10-K. GitLab disclosed DBNRR only as a floor ('above N%') through the FY2023 10-K and as an exact point from the FY2024 10-K on; the typed lower-bound arm keeps that distinction. The FY2020 floor (above 175 percent) and the FY2021/FY2022 year-end customer counts are disclosed in the FY2022 10-K."

data gitlab_fy2020_dbnrr: DollarBasedNetRetentionRow = DollarBasedNetRetentionRow {
  rate: RateLowerBoundPercent { floor_percent: 175 },
  citation: gitlab_fy2020_year_end_citation,
}

data gitlab_fy2021_dbnrr: DollarBasedNetRetentionRow = DollarBasedNetRetentionRow {
  rate: RateLowerBoundPercent { floor_percent: 145 },
  citation: gitlab_fy2021_year_end_citation,
}

data gitlab_fy2022_dbnrr: DollarBasedNetRetentionRow = DollarBasedNetRetentionRow {
  rate: RateLowerBoundPercent { floor_percent: 152 },
  citation: gitlab_fy2022_year_end_citation,
}

data gitlab_fy2023_dbnrr: DollarBasedNetRetentionRow = DollarBasedNetRetentionRow {
  rate: RateLowerBoundPercent { floor_percent: 130 },
  citation: gitlab_fy2023_year_end_citation,
}

data gitlab_fy2024_dbnrr: DollarBasedNetRetentionRow = DollarBasedNetRetentionRow {
