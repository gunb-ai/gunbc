module extdeps.sec.issuer.chemed



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.sec.gov/cgi-bin/browse-edgar?CIK=0000019584"
  }
}

data chemed_cik_digits: NonEmptyStr = "19584"

data chemed_cik: extdeps.sec.types.Cik = extdeps.sec.types.Cik { digits: chemed_cik_digits }

data chemed_ticker: extdeps.sec.types.StockTicker = extdeps.sec.types.StockTicker { symbol: "CHE" }

data chemed_issuer_catalog: extdeps.sec.types.IssuerCatalogRow = extdeps.sec.types.IssuerCatalogRow {
  cik: chemed_cik,
  registrant_name: "CHEMED CORP",
  primary_ticker: chemed_ticker,
  exchange: extdeps.sec.types.Nyse,
  vendor: extdeps.vendor.chemed.chemed,
}
