module extdeps.sec.edgar



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.sec.gov/edgar/sec-api-documentation"
  }
}

data edgar_data_api_base: NonEmptyStr = "https://data.sec.gov"

data edgar_shape_transport_split_note: String = "§3 shape/transport split: this module owns the EDGAR XBRL JSON response shapes and the agnostic operation contract (inputs → outputs, exit/error semantics). extdeps.sec.edgar_rest binds ONE transport handler (`transport rest`) to that shape; extdeps.http.client (curl argv) is a peer handler — N handlers, one shape, dispatch peripheral. Business policy (SEC User-Agent fair-access, request pacing) is workflow-layer, not extdeps."

type EdgarErrorEnvelope {
  status: Int?
  error: String?
}

type CompanyConceptResponse {
  cik: Cik
  taxonomy: String
  tag: String
  label: String
  description: String?
  entityName: String
  units: Map<String, List<XbrlFact>>
}

type CompanyFactsTaxonomyFacts {
  label: String?
  description: String?
  units: Map<String, List<XbrlFact>>
}

type CompanyFactsResponse {
  cik: Cik
  entityName: String
  facts: Map<String, Map<String, CompanyFactsTaxonomyFacts>>
}

data structural_coverage_gap_company_facts_residual: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "CompanyFactsResponse" },
      JsonPending { field: ".facts.* (full taxonomy map depth)" }
    ],
    trigger: "consumer needs full taxonomy/concept enumeration beyond the top-level entityName projection"
  }
]

data structural_coverage_gap_company_concept_residual: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "CompanyConceptResponse" },
      JsonPending { field: ".units (all measure axes)" }
    ],
    trigger: "consumer needs every unit-of-measure axis, not the first-fact projection"
  }
]

fn cik_url_segment(cik: Cik) -> NonEmptyStr {
  concat("CIK", cik_padded_digits(cik: cik))
}

fn cik_padded_digits(cik: Cik) -> NonEmptyStr {
  pad_cik_digits_loop(remaining: cik_digit_width - string_length(cik.digits), acc: cik.digits)
}

fn pad_cik_digits_loop(remaining: Int, acc: NonEmptyStr) -> NonEmptyStr {
  if remaining <= 0 {
    acc
  } else {
    pad_cik_digits_loop(remaining: remaining - 1, acc: concat("0", acc))
  }
}

fn xbrl_concept_path_segment(ref: XbrlConceptRef) -> NonEmptyStr {
  concat(xbrl_taxonomy_wire(taxonomy: ref.taxonomy), "/", ref.tag, ".json")
}
