module extdeps.sec.edgar_rest

import std.types { NonEmptyStr, AuthScheme }
import extdeps.sec.edgar {
  CompanyConceptResponse,
  CompanyFactsResponse,
  EdgarErrorEnvelope,
  edgar_data_api_base,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.ietf.http_semantics { HttpMethod }
import std.resources { Network }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.sec.gov/edgar/sec-api-documentation"
  }
}

// Reading: SEC's EDGAR API documentation owns the companyfacts endpoint (data.sec.gov, CIK##########.json); service sec.Edgar is the dispatched REST client whose GetCompanyFacts operation and entityName output transcribe that documented endpoint, so the service is the surface this citation owns.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.sec.edgar_rest", decl_name: "sec.Edgar", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// Path templates interpolate operation inputs by name (the current `transport rest` machinery). Upstream requires CIK##########.json segments — derive `cik_path_segment` via extdeps.sec.edgar.cik_url_segment(cik) at the call site; the helper is the single authority for zero-padding and the CIK prefix, not a second transport fork.
service sec.Edgar {
  config {
    endpoint: edgar_data_api_base
  }

  operation GetCompanyFacts {
    requires Network
    input {
      cik_path_segment: NonEmptyStr
    }
    output {
      entity_name: String from "entityName"
    }
    readonly
    transport rest {
      method: GET,
      path: "/api/xbrl/companyfacts/\{cik_path_segment\}.json"
    }
    response {
      200 => CompanyFactsResponse
      404 => EdgarErrorEnvelope
      5xx => EdgarErrorEnvelope
    }
  }

  operation GetCompanyConcept {
    requires Network
    input {
      cik_path_segment: NonEmptyStr
      taxonomy: NonEmptyStr
      concept_tag: NonEmptyStr
    }
    output {
      entity_name: String from "entityName"
      label: String from "label"
      taxonomy: String from "taxonomy"
      tag: String from "tag"
    }
    readonly
    transport rest {
      method: GET,
      path: "/api/xbrl/companyconcept/\{cik_path_segment\}/\{taxonomy\}/\{concept_tag\}.json"
    }
    response {
      200 => CompanyConceptResponse
      404 => EdgarErrorEnvelope
      5xx => EdgarErrorEnvelope
    }
  }
}
