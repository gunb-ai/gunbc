module extdeps.dhcp.v4

import std.types { NonEmptyStr, String, Bool }
import std.nat { Nat }
import std.measure { Second, second, second_count }
import std.error_primitives { Result, Ok, Err }
import extdeps.dns.domain_name { HostName, DomainNameParseError, parse_host_name }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc2132#section-3.14"
  }
}

// BOTH ANEMIC BRANDS THIS MODULE CARRIED ARE CLOSED, AND THE SECOND IS CLOSED IN THE WAY ITS OWN
// frontier row demanded. The Ipv4Address brand went first, 2026-07-24, into the structured four-octet
// carrier in extdeps.network.ipv4; consumers import that directly, because ipv4 is a network concept
// rather than a DHCP one and re-homing it through this module was a layering artifact. The
// MacAddress brand followed on 2026-10-26, under plan gunbc.plans.site_segment_anchor_bmc_reach
// phase S1: the brand is DELETED and every consumer site is re-homed onto extdeps.network.mac
// Eui48Address, the six grounded octets. That is the conjunction the row's unbound reason carried in
// words -- deletion PLUS migration -- which is exactly what no trigger could encode, so the row left
// with the brand instead of being left behind to assert a closure nobody had done.
//
// WHAT THIS MODULE IS NOW, SEEN FROM THE DELETION: nothing in it spells a MAC. A lease fact carries
// an `Eui48Address` from its owner module (extdeps.router.verizon_cr1000a Cr1000aDhcpLeaseRow is the
// row shape that took the type), and the brand is gone rather than reimplemented, which is the §3
// refusal the row existed to enforce. The remaining vocabulary is genuinely DHCP-shaped -- lease
// status, address origin, assignment policy, the option-12 hostname -- and none of it needs a string
// standing in for six octets again.
type DhcpClientHostNameOption12 = HostName

type DhcpLeaseAssignment =
    DynamicLease
  | StaticReservation

type DhcpLeaseStatus =
    Active
  | Inactive
  | Expired

type DhcpAddressOrigin =
    DhcpClient
  | StaticConfig

type DhcpLeaseObservation
  = DynamicDhcpLease {
      client_hostname: DhcpClientHostNameOption12?
      lease_time_remaining: Second
      status: DhcpLeaseStatus
    }
  | StaticDhcpReservation {
      reservation_label: NonEmptyStr
      status: DhcpLeaseStatus
    }

fn dhcp_lease_remaining_from_cited_minutes(minutes: Nat) -> Second {
  second(minutes * 60)
}

fn dhcp_lease_remaining_cited_minutes(remaining: Second) -> Nat {
  second_count(remaining) / 60
}

fn dhcp_mac_pinned_reservation_not_contradictory(
  address_origin: DhcpAddressOrigin,
  assignment_policy: DhcpLeaseAssignment,
) -> Bool {
  match address_origin {
    DhcpClient =>
      match assignment_policy {
        DynamicLease => true
        StaticReservation => true
      }
    StaticConfig =>
      match assignment_policy {
        StaticReservation => true
        DynamicLease => false
      }
  }
}

fn parse_dhcp_client_hostname_option12(raw: String) -> Result<DhcpClientHostNameOption12, DomainNameParseError> {
  match parse_host_name(raw: raw) {
    Ok { value: host } => Ok { value: host }
    Err { value: e } => Err { value: e }
  }
}
