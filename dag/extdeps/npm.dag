module extdeps.npm

import std.types { NonEmptyStr, String, Bool, List, Int }
import std.integer { UInt8 }
import std.encoding { base64_decode, base64_encode, Standard }
import std.content_hash {
  ContentHash,
  Sha512Digest,
  Sha1Digest,
  sha512_hex_digest,
  sha1_hex_digest,
}
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.numeric.base16 { byte_hex_lower }
import extdeps.version { VersionIdentity }
import extdeps.package { PackageCoordinate }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.npmjs.com/cli/v10/configuring-npm/package-lock-json"
  }
}

data npm_sri_w3c_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.w3.org/TR/SRI/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.npm",
      decl_name: "NpmPackageLockFormat",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [npm_sri_w3c_authority]
}

data npm_scope_subject_note: String = "THE SUBJECT IS the npm package-lock format — path keys, node metadata, declared dependency maps, and integrity wire — not the npm registry HTTP API and not gunbc Codex product policy. Citation pins the v10 package-lock docs matching the measured Codex npm 10.x line; lockfileVersion is observed as an integer and closed to NpmPackageLockV3 by typed decode."

data npm_integrity_decode_note: String = "W3C SRI permits one or more hash expressions, SHA-256/384/512, and per-expression options. npm package-lock integrity may be SHA-512 or SHA-1 SRI. This decoder is honest about that grammar: typed outcomes, never Option that erases the refusal cause. A narrow first cut admits single sha512 and single sha1 expressions without options; multiple expressions and options refuse with typed causes. After decode, the base64 payload must re-encode to the admitted canonical form — shared base64_decode accepts arbitrary trailing '=', so overpadding is an npm-local canonicality refusal (operator portfolio 2026-08-04). Decoding the lock's EXPECTED digest is not artifact verification — observed digest over acquired archive bytes is gunbc.package_delivery."

data npm_resolved_graph_boundary_note: String = "TWO npm-owned facts, do not fuse. NpmParsedPackageRoster carries path-keyed nodes and declared dependency maps from the lock JSON. Exact consumer→dependency PackageLockGraph edges require an npm-owned realization receipt (resolver / Arborist / post-npm-ci read-back) — never name→first-matching-node inventing inside gunbc. npm remains the resolver; gunbc models and verifies its result."

type NpmPackageLockFormat
  = | NpmPackageLockV3

type NpmPackageLockFormatDecode
  = NpmPackageLockFormatDecoded {
      format: NpmPackageLockFormat
    }
  | NpmPackageLockFormatUnsupported {
      observed: Int
    }

fn npm_decode_package_lock_format(observed: Int) -> NpmPackageLockFormatDecode {
  if observed == 3 {
    NpmPackageLockFormatDecoded { format: NpmPackageLockV3 }
  } else {
    NpmPackageLockFormatUnsupported { observed: observed }
  }
}

type NpmRegistry {
  registry: NonEmptyStr
}

type NpmLockPathKey
  = NpmRootLockPath
  | NpmRelativeLockPath {
      key: NonEmptyStr
    }

data npm_lock_path_key_note: String = "npm package-lock packages map uses the empty string \"\" for the root project — NpmRootLockPath is derived only from that exact empty JSON object key. Every other key is an opaque upstream lock key (NpmRelativeLockPath.key). It is NOT automatically a safe filesystem-relative host path; materialization later decides whether and how to project it."

type NpmDependencyKind
  = NpmRuntimeDependency
  | NpmOptionalDependency
  | NpmPeerDependency

data npm_dependency_kind_note: String = "Declared edge kinds come from the lock's dependency maps once an npm realization supplies exact node-key endpoints. A node marked dev/optional is NODE METADATA, not a second edge category invented as NpmDevDependency."

type NpmLockNodeFlags {
  dev: Bool
  optional: Bool
  dev_optional: Bool
  in_bundle: Bool
  has_install_script: Bool
  has_shrinkwrap: Bool
}

type NpmPlatformConstraint {
  os: List<NonEmptyStr>
  cpu: List<NonEmptyStr>
}

type NpmLockNodeMetadata {
  flags: NpmLockNodeFlags
  platform: NpmPlatformConstraint
}

type NpmManagerIdentity {
  format: NpmPackageLockFormat
  npm_version: VersionIdentity
}

type NpmResolvedRegistryArtifact {
  locator: NonEmptyStr
}

type NpmResolvedGitArtifact {
  locator: NonEmptyStr
}

type NpmRegistryIntegrity
  = NpmRegistrySha512Integrity {
      digest: Sha512Digest
    }
  | NpmRegistrySha1Integrity {
      digest: Sha1Digest
    }

type NpmLockNodeSelection
  = NpmRootProject {
      manifest_identity: ContentHash
    }
  | NpmRegistryArtifact {
      package: PackageCoordinate<NpmRegistry>
      version: VersionIdentity
      resolved: NpmResolvedRegistryArtifact
      expected_integrity: NpmRegistryIntegrity
    }
  | NpmGitArtifact {
      package: PackageCoordinate<NpmRegistry>
      revision: NonEmptyStr
      resolved: NpmResolvedGitArtifact
    }
  | NpmLink {
      target: NpmLockPathKey
    }

data npm_lock_node_selection_note: String = "Selection is an npm-local coproduct. Root, link, git, and registry nodes are different shapes. Registry expected_integrity is npm-native (SHA-1 or SHA-512) — Codex product narrowing lives in gunbc.package_delivery, not here. The first production Codex lock may support only root + registry-artifact nodes and refuse other forms — it must not pretend those forms cannot exist."

type NpmIntegrityDecode
  = NpmSingleSha512Integrity {
      digest: Sha512Digest
    }
  | NpmSingleSha1Integrity {
      digest: Sha1Digest
    }
  | NpmIntegrityUnsupportedAlgorithm {
      algorithm: NonEmptyStr
    }
  | NpmIntegrityMultipleExpressionsUnsupported {
      count: Int
    }
  | NpmIntegrityOptionsUnsupported
  | NpmIntegrityMalformed {
      reason: NonEmptyStr
    }

fn npm_octets_to_lower_hex(octets: List<UInt8>) -> String {
  map(octets, octet => byte_hex_lower(v: octet)) |> join(separator: "")
}

fn npm_sri_base64_payload_is_canonical(encoded: String, octets: List<UInt8>) -> Bool {
  encoded == base64_encode(octets: octets, variant: Standard)
}

fn npm_decode_integrity_expression(expression: String) -> NpmIntegrityDecode {
  if expression |> contains("?") {
    NpmIntegrityOptionsUnsupported
  } else if expression.starts_with(prefix: "sha512-") {
    let encoded = expression.substring(start: 7, end: expression.length())
    match base64_decode(s: encoded, variant: Standard) {
      Present { value: octets } =>
        if count(octets) == 64 {
          if npm_sri_base64_payload_is_canonical(encoded: encoded, octets: octets) {
            match sha512_hex_digest(hex: npm_octets_to_lower_hex(octets: octets)) {
              Present { value: digest } => NpmSingleSha512Integrity { digest: digest }
              Absent =>
                NpmIntegrityMalformed {
                  reason: "sha512 hex refinement refused" as NonEmptyStr,
                }
            }
          } else {
            NpmIntegrityMalformed {
              reason: "sha512 base64 payload is noncanonical" as NonEmptyStr,
            }
          }
        } else {
          NpmIntegrityMalformed {
            reason: "sha512 decoded length is not 64 octets" as NonEmptyStr,
          }
        }
      Absent =>
        NpmIntegrityMalformed {
          reason: "sha512 base64 decode refused" as NonEmptyStr,
        }
    }
  } else if expression.starts_with(prefix: "sha1-") {
    let encoded = expression.substring(start: 5, end: expression.length())
    match base64_decode(s: encoded, variant: Standard) {
      Present { value: octets } =>
        if count(octets) == 20 {
          if npm_sri_base64_payload_is_canonical(encoded: encoded, octets: octets) {
            match sha1_hex_digest(hex: npm_octets_to_lower_hex(octets: octets)) {
              Present { value: digest } => NpmSingleSha1Integrity { digest: digest }
              Absent =>
                NpmIntegrityMalformed {
                  reason: "sha1 hex refinement refused" as NonEmptyStr,
                }
            }
          } else {
            NpmIntegrityMalformed {
              reason: "sha1 base64 payload is noncanonical" as NonEmptyStr,
            }
          }
        } else {
          NpmIntegrityMalformed {
            reason: "sha1 decoded length is not 20 octets" as NonEmptyStr,
          }
        }
      Absent =>
        NpmIntegrityMalformed {
          reason: "sha1 base64 decode refused" as NonEmptyStr,
        }
    }
  } else if expression.starts_with(prefix: "sha256-") {
    NpmIntegrityUnsupportedAlgorithm { algorithm: "sha256" as NonEmptyStr }
  } else if expression.starts_with(prefix: "sha384-") {
    NpmIntegrityUnsupportedAlgorithm { algorithm: "sha384" as NonEmptyStr }
  } else {
    NpmIntegrityMalformed {
      reason: "missing or unknown SRI algorithm prefix" as NonEmptyStr,
    }
  }
}

fn npm_decode_integrity(wire: String) -> NpmIntegrityDecode {
  let expressions = split(s: wire, delimiter: " ") |> filter(part => part != "")
  let n = count(expressions)
  if n == 0 {
    NpmIntegrityMalformed {
      reason: "empty integrity wire" as NonEmptyStr,
    }
  } else if n == 1 {
    match expressions |> first {
      Present { value: expression } => npm_decode_integrity_expression(expression: expression)
      Absent =>
        NpmIntegrityMalformed {
          reason: "empty integrity wire" as NonEmptyStr,
        }
    }
  } else {
    NpmIntegrityMultipleExpressionsUnsupported { count: n }
  }
}

fn npm_registry_integrity_from_decode(decoded: NpmIntegrityDecode) -> NpmRegistryIntegrity? {
  match decoded {
    NpmSingleSha512Integrity { digest } =>
      Present { value: NpmRegistrySha512Integrity { digest: digest } }
    NpmSingleSha1Integrity { digest } =>
      Present { value: NpmRegistrySha1Integrity { digest: digest } }
    _ => none
  }
}
