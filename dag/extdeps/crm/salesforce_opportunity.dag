module extdeps.crm.salesforce_opportunity




data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "developer.salesforce.com/docs/atlas.en-us.object_reference.meta/object_reference/sforce_api_objects_opportunitystage.htm"
  }
}

data salesforce_opportunity_subject: Vendor<extdeps.securities.Securities> = salesforce

data salesforce_opportunity_provenance_note: String = "Vocabulary facts live-fetched 2026-08-01 from the Salesforce Platform object reference (en-us, API version 252.0, read through the docs content endpoint get_document_content because the doc site shell is client-rendered): the Opportunity object page for StageName and the OpportunityStage object page (the anchor) for the stage row schema and the ForecastCategory value set. These are vocabulary facts about the upstream product's published surface -- no sales-process opinion lives in this module."

// The load-bearing upstream fact: StageName is a required picklist on Opportunity that the reference says controls ForecastCategoryName, IsClosed, IsWon, and Probability, and the reference directs, quoted: 'To obtain the stage name values in the picklist, query the OpportunityStage object.' The stage VOCABULARY is therefore org-configurable DATA in the vendor's own model, not a published universal roster -- what Salesforce publishes as vocabulary is the stage row SCHEMA and the closed ForecastCategory value set, both modeled here under their real names. OpportunityStage is read-only via the API upstream.
type SalesforceForecastCategory
  = SalesforceForecastBestCase
  | SalesforceForecastClosed
  | SalesforceForecastForecast
  | SalesforceForecastMostLikely
  | SalesforceForecastOmitted
  | SalesforceForecastPipeline

type SalesforceForecastCategoryRow {
  category: SalesforceForecastCategory
  wire_value: std.types.NonEmptyStr
  citation: std.types.NonEmptyStr
}

data salesforce_forecast_best_case: SalesforceForecastCategoryRow = SalesforceForecastCategoryRow {
  category: SalesforceForecastBestCase,
  wire_value: "BestCase",
  citation: "sforce_api_objects_opportunitystage#ForecastCategory",
}

data salesforce_forecast_closed: SalesforceForecastCategoryRow = SalesforceForecastCategoryRow {
  category: SalesforceForecastClosed,
  wire_value: "Closed",
  citation: "sforce_api_objects_opportunitystage#ForecastCategory",
}

data salesforce_forecast_forecast: SalesforceForecastCategoryRow = SalesforceForecastCategoryRow {
  category: SalesforceForecastForecast,
  wire_value: "Forecast",
  citation: "sforce_api_objects_opportunitystage#ForecastCategory",
}

data salesforce_forecast_most_likely: SalesforceForecastCategoryRow = SalesforceForecastCategoryRow {
  category: SalesforceForecastMostLikely,
  wire_value: "MostLikely",
  citation: "sforce_api_objects_opportunitystage#ForecastCategory",
}

data salesforce_forecast_omitted: SalesforceForecastCategoryRow = SalesforceForecastCategoryRow {
  category: SalesforceForecastOmitted,
  wire_value: "Omitted",
  citation: "sforce_api_objects_opportunitystage#ForecastCategory",
}

data salesforce_forecast_pipeline: SalesforceForecastCategoryRow = SalesforceForecastCategoryRow {
  category: SalesforceForecastPipeline,
  wire_value: "Pipeline",
  citation: "sforce_api_objects_opportunitystage#ForecastCategory",
}

fn salesforce_forecast_category_catalog() -> List<SalesforceForecastCategoryRow> {
  [
    salesforce_forecast_best_case,
    salesforce_forecast_closed,
    salesforce_forecast_forecast,
    salesforce_forecast_most_likely,
    salesforce_forecast_omitted,
    salesforce_forecast_pipeline,
  ]
}

type SalesforceOpportunityStageRow {
  master_label: std.types.NonEmptyStr
  api_name: std.types.NonEmptyStr
  default_probability_bp: std.measure.BasisPoint
  forecast_category: SalesforceForecastCategory
  is_closed: Bool
  is_won: Bool
  sort_order: std.nat.Nat
}

// Field-by-field mirror of the upstream OpportunityStage object under its real names: MasterLabel ('the internal label that does not get translated'), ApiName ('uniquely identifies a picklist value so it can be retrieved without using an id or master label'), DefaultProbability ('the default percentage estimate of the confidence in closing a specific opportunity for this opportunity stage value'), ForecastCategory, IsClosed, IsWon, and SortOrder ('number used to sort this value in the opportunity stage picklist'). DefaultProbability is a percent field upstream and is carried here on the std.measure BasisPoint carrier -- 60 percent is basis_point_count 6000 -- so a bare scalar with an implicit scale is unwritable.
type SalesforceDefaultStageRoster
  = DefaultStageRosterCited { rows: List<SalesforceOpportunityStageRow>, citation: std.types.NonEmptyStr }
  | DefaultStageRosterUnavailable { cause: std.types.NonEmptyStr }

data salesforce_default_stage_roster: SalesforceDefaultStageRoster = DefaultStageRosterUnavailable {
  cause: "the machine-facing object reference deliberately does not enumerate the shipped default stage values (it directs callers to query OpportunityStage, per the configurability note), and the help article that lists the defaults (help.salesforce.com articleView sales.opportunity_stages) renders as a client-side shell this fetch cannot read (2026-08-01) -- refused, never filled from memory",
}
