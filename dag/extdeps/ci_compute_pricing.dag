  evidence: ubicloud_docs_read,
}

// The relayed table names x64 alone as withdrawn. Arm64 is therefore NOT recorded as closed, and
// NOT recorded as confirmed open either: the wording is our only basis, and an inference from
// silence is not an observation. The note names the check that would settle it.
data ubicloud_standard_arm64: ComputeOfferObservation = ComputeOfferObservation {
  identity: ComputeOfferIdentity { provider: "Ubicloud", sku: "standard-runner-arm64" },
  product: "standard CI runner, arm64",
  market_class: HostedCiProduct,
  architecture: ArchitectureKnown { arch: Aarch64 },
  entitlement: SmtHardwareThread,
  dedication: DedicationUnread { obligation: "Runner entitlement not read." },
  interruption: NonPreemptible { note: "Hosted runner." },
  availability: AvailabilityUnread { obligation: "Runner SLA not read." },
  purchase: NoPurchaseRestrictionObserved {
    note: "The withdrawal notice names x64 only, and the live pricing documentation lists arm64 without restriction. No purchase restriction observed on this tier.",
  },
  region: region_unread_default,
  included_traffic: traffic_unread_default,
  tax: TaxStandingUnread { obligation: "Tax treatment of the quoted runner rate not read." },
  shape_provenance: ShapePublished { note: "Published arm64 shape is 2 vCPU / 6 GB - NOT the 8 GB of the x64 tier. An earlier revision of this row carried 8 GB, which silently changed the unit count the whole table normalizes on." },
  performance: performance_unmeasured_default,
  spill_admission: CompetitorNotSpill { note: "A competitor's retail runner is not somewhere we send overflow." },
  vcpu_count: 2, memory_gib: 6,
  rate: usd_per_minute(micros: 1250),
  evidence: ubicloud_docs_read,
