data circleci_caveat_note: NonEmptyStr = "CircleCI is priced in credits and its bill also carries per-platform-user and per-feature charges. The rate carried here is the compute class alone, at 10 credits per minute against $15 per 25,000 credits, so it understates the total a customer actually pays and is not directly comparable to a flat per-minute runner."

data ubicloud_premium_note: NonEmptyStr = "Ubicloud's premium-2 tier had no row and a PriceUnread obligation for one revision of this file, because the relayed price-adjustment table said premium was UNCHANGED without saying what it was. It is now a priced row, read from the vendor's live pricing documentation. The refusal was discharged by READING the number, never by inferring it: a secondary summary had put premium at double the standard rate, which would have given 0.0025 against the documented 0.002 - so the plausible inference was wrong by 25 percent in the single most decision-relevant cell of the table, and carrying it would have looked exactly as confident as the correct figure does now."

data namespace_unread: PriceEvidence = PriceUnread {
  obligation: "Namespace publishes shapes and offers custom pricing without a clean public rate for the standard profile. Obtain a quote or a published rate; do not infer one from the shapes.",
}

data namespace_note: NonEmptyStr = "Namespace belongs in the competitor set and has no row here, because a competitor with no readable price is an unread price and not an absent one. Inventing a plausible figure for it would be the exact defect this tree exists to refuse."

// A unit-minute is one CPU entitlement plus 4 GiB. Whichever of CPU and memory runs out first is
// what the shape can actually deliver, so this takes the MINIMUM of the two. A 2-vCPU shape with
// 4 GiB delivers one unit, not two: the second vCPU has no memory to work with.
//
// The count is carried in PERMILLE so a 6 GiB shape reads as 1.5 units instead of truncating to 1.
fn offer_unit_count_permille(o: ComputeOfferObservation) -> Nat {
  nat_min(a: o.vcpu_count * 1000, b: o.memory_gib * 1000 / 4)
}

// A price whose currency is not the table's currency is NOT comparable, and a foreign figure shown
// in a comparison column is worse than no figure at all. The division happens once, at the end, so
// the hourly-to-per-minute step does not truncate before the per-unit step.
// The pricing unit of this module: one isolated CPU entitlement plus 4 GiB, for one minute. It is a
// phantom period marker in std.measure's open MoneyRate<P> family, so no new money carrier is
// minted - the same §2-horizontal move PerMinute and PerKilowattHour already use.
type PerComputeUnitMinute

type MoneyPerComputeUnitMinute = MoneyRate<PerComputeUnitMinute>

type UnitPriceStanding
  = UnitPriceUsd { rate: MoneyPerComputeUnitMinute }
  | UnitPriceForeign { rate: MoneyPerComputeUnitMinute, obligation: NonEmptyStr }

fn offer_unit_price(o: ComputeOfferObservation) -> UnitPriceStanding {
  let micro = vendor_rate_micros_per_hour(r: o.rate) * 1000 / (60 * offer_unit_count_permille(o: o))
  match vendor_rate_currency(r: o.rate) {
    Usd => UnitPriceUsd { rate: MoneyPerComputeUnitMinute { amount: money_amount_micro(count: micro), currency: Usd } },
    Eur => UnitPriceForeign {
      rate: MoneyPerComputeUnitMinute { amount: money_amount_micro(count: micro), currency: Eur },
      obligation: "No exchange-rate reading is held. Converting at a rate nobody recorded would make a euro figure look like a dollar one; the row stays in its own currency until an FX observation with a timestamp exists.",
    },
  }
}

fn unit_price_is_usd(p: UnitPriceStanding) -> Bool {
  match p {
    UnitPriceUsd { rate } => true,
    UnitPriceForeign { rate, obligation } => false,
  }
}

// ---------------------------------------------------------------------------------------------
// RESOLUTION WITH CARDINALITY. A lookup that folds to a default of zero makes a missing provider
// look free, and a lookup that keeps the last match silently picks one of several. Both are how a
// renamed product turns into a zero-cost fallback that no gate refuses.
// ---------------------------------------------------------------------------------------------

type ComputeOfferResolution
  = ComputeOfferResolved { offer: ComputeOfferObservation }
  | ComputeOfferMissing { identity: ComputeOfferIdentity }
  | ComputeOfferAmbiguous { identity: ComputeOfferIdentity, match_count: Int }

fn resolve_offer(id: ComputeOfferIdentity) -> ComputeOfferResolution {
  fold(ci_compute_offers, init: ComputeOfferMissing { identity: id }, f: fn(acc, o) {
    if offer_identity_equal(a: o.identity, b: id) {
      match acc {
        ComputeOfferMissing { identity } => ComputeOfferResolved { offer: o },
        ComputeOfferResolved { offer } => ComputeOfferAmbiguous { identity: id, match_count: 2 },
        ComputeOfferAmbiguous { identity, match_count } =>
          ComputeOfferAmbiguous { identity: id, match_count: match_count + 1 },
      }
    } else { acc }
  })
}

// The catalog's own integrity: no two rows may share an identity, or every lookup against that
// identity refuses and the table silently loses a route.
fn offer_identities_are_unique() -> Bool {
  all(ci_compute_offers, o => match resolve_offer(id: o.identity) {
    ComputeOfferResolved { offer } => true,
    ComputeOfferMissing { identity } => false,
    ComputeOfferAmbiguous { identity, match_count } => false,
  })
}

// The only spendable form of a route's price. Missing and ambiguous both refuse; neither becomes a
// number, and in particular neither becomes zero.
type RouteCostStanding
  = RouteCostKnown { rate: MoneyPerComputeUnitMinute, offer: ComputeOfferObservation }
  | RouteCostRefused { identity: ComputeOfferIdentity, reason: NonEmptyStr }

fn route_cost(id: ComputeOfferIdentity) -> RouteCostStanding {
  match resolve_offer(id: id) {
    ComputeOfferResolved { offer } =>
      match offer_unit_price(o: offer) {
        UnitPriceUsd { rate } => RouteCostKnown { rate: rate, offer: offer },
        UnitPriceForeign { rate, obligation } =>
          RouteCostRefused { identity: id, reason: obligation },
      },
    ComputeOfferMissing { identity } =>
      RouteCostRefused {
        identity: identity,
        reason: "no offer carries this identity. A missing price is not a free price, so this refuses instead of returning zero.",
      },
    ComputeOfferAmbiguous { identity, match_count } =>
      RouteCostRefused {
        identity: identity,
        reason: "more than one offer carries this identity. The catalog must not silently pick one of them.",
      },
  }
}

fn entitlement_label(e: CpuEntitlement) -> NonEmptyStr {
  match e {
    PhysicalCore => "physical core",
    SmtHardwareThread => "SMT thread",
    ProviderVcpuUnspecified => "vCPU, unstated",
    SharedBurstableVcpu => "shared burstable",
  }
}

fn dedication_label(d: ResourceDedication) -> NonEmptyStr {
  match d {
    DedicatedResource { note } => "dedicated",
    SharedResource { note } => "shared",
    DedicationUnread { obligation } => "unread",
  }
}

fn interruption_label(i: InterruptionStanding) -> NonEmptyStr {
  match i {
    NonPreemptible { note } => "durable",
    Preemptible { note } => "preemptible",
    InterruptionUnread { obligation } => "unread",
  }
}

fn spill_admission_label(s: SpillAdmission) -> NonEmptyStr {
  match s {
    SpillAdmitted { note } => "spill route",
    CompetitorNotSpill { note } => "competitor",
    ExperimentalNotAdmitted { obligation } => "experimental",
  }
}

fn offer_is_spill_admitted(o: ComputeOfferObservation) -> Bool {
  match o.spill_admission {
    SpillAdmitted { note } => true,
    CompetitorNotSpill { note } => false,
    ExperimentalNotAdmitted { obligation } => false,
  }
}

fn admitted_spill_offers() -> List<ComputeOfferObservation> {
  filter(ci_compute_offers, o => offer_is_spill_admitted(o: o))
}

// WHAT A NEW CUSTOMER COULD ACTUALLY CHOOSE INSTEAD OF US. This, not competitor_offers, is the set
// a competitive frontier should rank: a withdrawn tier still appears in competitor_offers because it
// records what the vendor was willing to serve, and it must not be deleted - but it cannot undercut
// a price a new customer is unable to buy.
fn purchasable_competitor_offers() -> List<ComputeOfferObservation> {
  filter(competitor_offers(), o => offer_is_purchasable_by_new_customer(o: o))
}

fn competitor_offers() -> List<ComputeOfferObservation> {
  filter(ci_compute_offers, o => match o.market_class {
    HostedCiProduct => true,
    RawInfrastructure => false,
  })
}
