data deepseek_v4_1_flash_dspark_noise_token_id: Nat = 128799

// config.json `dspark_target_layer_ids` is an integer array. Carried as List so a later pin can
// change length without a type edit.
data deepseek_v4_1_flash_dspark_target_layer_ids: List<Nat> = [37, 38, 39]

// THE LAYERS THAT COMPRESS THEIR OWN KV. config.json `kv_source_layer_ids` is an integer array;
// the rest of the stack reads that cache.
data deepseek_v4_1_flash_kv_source_layer_ids: List<Nat> = [2, 8, 14, 20]

// THE CONFIG DOES NOT SPLIT THE 40 LAYERS INTO ENCODER AND DECODER. The card's CED 20+20 is
// prose; `text_config.num_hidden_layers` is 40 and there is no encoder_layers / decoder_layers key.
data deepseek_v4_1_flash_config_declares_encoder_decoder_split: Bool = false

data deepseek_v4_1_flash_vision_num_hidden_layers: Nat = 32
data deepseek_v4_1_flash_vision_hidden_size: Nat = 1024
data deepseek_v4_1_flash_vision_patch_size: Nat = 14
data deepseek_v4_1_flash_vision_max_image_tokens: TokenCount = token_count(count: 1024)
data deepseek_v4_1_flash_image_token_id: Nat = 129264
data deepseek_v4_1_flash_accepts_image_input: Bool = true

type DeepseekV41EngramTables {
  layer_ids: List<Nat>
  unpadded_embeddings: List<Nat>
  max_ngram_size: Nat
  vocab_size: Nat
  n_heads: Nat
  head_dim: Nat
  compressed_vocab_size: Nat
}

data deepseek_v4_1_flash_engram: DeepseekV41EngramTables = DeepseekV41EngramTables {
  layer_ids: [1, 14],
  unpadded_embeddings: [384006168, 384016682],
  max_ngram_size: 4,
  vocab_size: 16000000,
  n_heads: 8,
  head_dim: 256,
  compressed_vocab_size: 99092,
}

// ENGRAM OFF-ACCELERATOR PLACEMENT IS NOT A PUBLISHER CONFIG KEY. config.json carries table sizes
// and layer ids; it does not declare host/UVA offload. The reference inference allocates the
// tables as parameters. Whether a serving runtime can park them in host memory is a runtime fact
// (DSV41-1 / DSV41-2). On GB10, host and GPU are one unified pool, so offload cannot add capacity
// there even if a runtime offers it — that evaluation belongs to DSV41-2, not this module.
data deepseek_v4_1_flash_config_declares_engram_off_accelerator: Bool = false

// THE CONTEXT CEILING AND THE NATIVE WINDOW ARE TWO KEYS IN THE SAME CONFIG. The card's "up to
// one million tokens" and its 64K sparse-attn training sentence contradict each other if read as
// one native length. `text_config.max_position_embeddings` is 1048576; `rope_scaling` is yarn with
// `original_max_position_embeddings` 65536 and `factor` 16. The 1M figure is a SCALED ceiling
// over a 64K native window. Declared frontier for the working-window constraint: DSV41-2.
data deepseek_v4_1_flash_context_length: TokenCount = token_count(count: 1048576)
data deepseek_v4_1_flash_native_context_length: TokenCount = token_count(count: 65536)
data deepseek_v4_1_flash_yarn_factor: Nat = 16

fn deepseek_v4_1_flash_yarn_scaled_positions() -> TokenCount {
  token_count(count: token_count_value(t: deepseek_v4_1_flash_native_context_length) * deepseek_v4_1_flash_yarn_factor)
}

// NO OUTPUT CEILING IN CONFIG.JSON. The card's sampling table is not this module's authority.
// Remaining room in a window after input is `std.measure` `token_count_remaining_in_window`, not a
// product fact.

// ===========================================================================================
// FOOTPRINT FROM THE SAFETENSORS INDEX, not from the card. The card self-contradicts (552B
// backbone + 196B Engram, also "763B total"); this module does not transcribe those figures.
// Component bytes are the sum of each tensor's data_offsets span in the 48-shard headers at this
// revision, partitioned by name: `vision.`/`aligner.`/`image_*` = vision; `.engram.` = Engram;
// `mtp.` = DSpark/MTP draft; everything else = backbone. The index metadata.total_size equals
// that sum. This is an upstream-reported payload size until someone reads the bytes on the fleet
// (ArtifactFootprint FootprintReportedExternally). Declared frontier: DSV41-2
// (crisp-crane-661) gunbc.spark.serving_deployment_selection ArtifactFootprint.
// ===========================================================================================

data deepseek_v4_1_flash_safetensors_shard_count: Nat = 48

type DeepseekV41SafetensorsPayloadFootprint {
  backbone_bytes: ByteSize
  engram_bytes: ByteSize
  vision_bytes: ByteSize
  draft_bytes: ByteSize
}

data deepseek_v4_1_flash_safetensors_payload_footprint: DeepseekV41SafetensorsPayloadFootprint = DeepseekV41SafetensorsPayloadFootprint {
  backbone_bytes: byte_size(count: 298309535168),
  engram_bytes: byte_size(count: 203073076240),
  vision_bytes: byte_size(count: 970536960),
  draft_bytes: byte_size(count: 7932874632),
}

// PUBLISHER-REPORTED, NOT FLEET-READ. The standing is the Hub authority; DSV41-2 maps this onto
// ArtifactFootprint.FootprintReportedExternally until a Spark reading exists. Trigger: a
// FootprintObservedOnFleet row keyed at this revision.
data deepseek_v4_1_flash_payload_footprint_standing: CitedFigureStanding = CitedToAuthority {
  authority: extdeps_external_authority_anchor,
}

// CARD-REPORTED PARAMETER COUNTS, labelled as such because the card contradicts itself (552B
// backbone + 196B Engram, also "763B total") and is not the fit authority. Kept beside the bytes so
// the two sources cannot be confused. Not a consumer of serving memory.
type DeepseekV41CardReportedParameters {
  backbone: ParameterCount
  engram: ParameterCount
  activated_prefill: ParameterCount
  activated_decode: ParameterCount
}

data deepseek_v4_1_flash_card_reported_parameters: DeepseekV41CardReportedParameters = DeepseekV41CardReportedParameters {
  backbone: parameter_count(millions: 552000),
  engram: parameter_count(millions: 196000),
  activated_prefill: parameter_count(millions: 8000),
  activated_decode: parameter_count(millions: 16000),
}

data deepseek_v4_1_flash_safetensors_index_total_size: ByteSize = byte_size(count: 510286023000)

// HUB TREE FILE SIZE, a different quantity from the payload above. Observed via
// `hub_repo_tree_api_url` at this revision: 48 `*.safetensors` files totalling 510296708312
// bytes. That is file size on the publisher's object store (headers plus tensors), not serving
// memory and not the index metadata.total_size. Declared frontier: DSV41-2 must not treat this as
// GB10 resident bytes.
data deepseek_v4_1_flash_safetensors_tree_file_bytes: ByteSize = byte_size(count: 510296708312)

fn deepseek_v4_1_flash_safetensors_payload_total(f: DeepseekV41SafetensorsPayloadFootprint) -> ByteSize {
  let n = byte_size_count(b: f.backbone_bytes)
    + byte_size_count(b: f.engram_bytes)
    + byte_size_count(b: f.vision_bytes)
    + byte_size_count(b: f.draft_bytes)
  byte_size(count: n)
}

// THE MODULE PATH, ONCE. The frontier delegation below needs it. It was introduced when a fact
// builder here also spelled this module's name inline; that builder is gone (review 66128: the lift
// to std.roster_frontier frontier_rows_for_decls left it with zero call sites, which is the DESIGN
// 3c dangling state), so this constant now has exactly one consumer rather than two. It stays a
// named constant because the alternative is a bare literal inside the delegation, and two spellings
// of one module's own name is the DESIGN 3 fork in miniature.
data deepseek_v4_1_flash_module_path: String = "extdeps.deepseek.deepseek_v4_1_flash"

// DELEGATES TO THE LIFTED FOLD. This body was the only instance of "one shared reason and one shared
// dissolution mapped over a list of decl names"; product.data_category needed the same shape, so it
// was lifted to std.roster_frontier frontier_rows_for_decls rather than copied (review 65996, DESIGN
// 2: net concepts must not grow by re-invention). The name stays because this module's callers cite
// it and the module path is this module's fact to supply.
fn deepseek_v4_1_flash_frontier_rows(
  decl_names: List<NonEmptyStr>,
  reason: String,
  dissolution: DissolutionCondition,
) -> List<FrontierRow> {
  frontier_rows_for_decls(
    module_path: deepseek_v4_1_flash_module_path,
    decl_names: decl_names,
    reason: reason,
    dissolution: dissolution,
  )
}

