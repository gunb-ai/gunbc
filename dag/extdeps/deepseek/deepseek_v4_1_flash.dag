    deepseek_v4_1_flash_fact(decl_name: "deepseek_v4_1_flash_config_declares_kv_cache_dtype" as NonEmptyStr),
    deepseek_v4_1_flash_fact(decl_name: "deepseek_v4_1_flash_vllm_tokenizer_mode" as NonEmptyStr),
    deepseek_v4_1_flash_fact(decl_name: "deepseek_v4_1_flash_vllm_tool_call_parser" as NonEmptyStr),
    deepseek_v4_1_flash_fact(decl_name: "deepseek_v4_1_flash_vllm_reasoning_parser" as NonEmptyStr),
  ],
}

data deepseek_v4_1_flash_frontier_dsv41_2: DeepseekV41DeclaredFrontier = DeepseekV41DeclaredFrontier {
  lane: "DSV41-2 crisp-crane-661 serving_deployment_selection" as NonEmptyStr,
  trigger: "ArtifactFootprint.FootprintReportedExternally rows keyed at this revision, until FootprintObservedOnFleet exists" as NonEmptyStr,
  facts: [
