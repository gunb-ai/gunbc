// One line per shard, path then digest then size, in path order: the canonical text of the
// manifest, so its digest is a function of exactly these rows.
fn deepseek_v4_1_flash_weight_manifest_text() -> String {
  join(map(deepseek_v4_1_flash_weight_manifest, r => join([r.path as String, " ", r.sha256.hex as String, " ", to_string(byte_size_count(b: r.file_bytes))], "")), "\n")
}

// THE TOKENIZER FILES at this revision, digested over the bytes the Hub served for
// `hub_resolve_url` at dba1be0a on 2026-09-21 (they are not LFS objects, so the tree API carries
// only their git blob id; the sha256 was taken over the resolved bytes). Same standing as the
// weight manifest: declared here, verified fleet-side.
type DeepseekV41TokenizerFile sole_constructor {
  path: NonEmptyStr
  file_bytes: ByteSize
  sha256: Sha256Digest
}

data deepseek_v4_1_flash_tokenizer_files: List<DeepseekV41TokenizerFile> = [
  DeepseekV41TokenizerFile { path: "tokenizer.json" as NonEmptyStr, file_bytes: byte_size(count: 6367257), sha256: Sha256Digest { hex: "c90dfa01249db1be4245780a052ede752e1361c612ac6d08e2bdada7d599476b" as Sha256DigestHex } },
  DeepseekV41TokenizerFile { path: "tokenizer_config.json" as NonEmptyStr, file_bytes: byte_size(count: 801), sha256: Sha256Digest { hex: "6ac8c8dc065ed118161d02dd532749ae3f52c243deac27872134fae2f50d8547" as Sha256DigestHex } },
]

fn deepseek_v4_1_flash_tokenizer_manifest_text() -> String {
  join(map(deepseek_v4_1_flash_tokenizer_files, r => join([r.path as String, " ", r.sha256.hex as String, " ", to_string(byte_size_count(b: r.file_bytes))], "")), "\n")
}

// THE SHARD FILES REACH THE POPULATION FOLD, so the tensor extents are bounded by the payload each
// shard's own header declares rather than only by each other.
data deepseek_v4_1_flash_engram_shard_files: List<SafetensorsShardFile> = map(deepseek_v4_1_flash_engram_shards, s => s.file)

// THE TOTAL, DERIVED. Every byte comes from a named tensor's declared span. This is the quantity
// `deepseek_v4_1_flash_safetensors_payload_footprint.engram_bytes` reports, and the witness module
// asserts the two agree -- which is the check that the partition summary above covered exactly
// this population and no other tensor.
fn deepseek_v4_1_flash_engram_derived_bytes() -> ByteSize? {
  safetensors_population_declared_bytes(s: deepseek_v4_1_flash_engram_population)
}

// ── THE WEIGHT/SCALE RELATION, DERIVED FROM THE SHAPES RATHER THAN ASSERTED ────────────────────
//
// The fp8 tensors are block-scaled: an F8_E4M3 payload tensor is paired with an F8_E8M0 scale
// tensor, and `deepseek_v4_1_flash_weight_block_size` is 32. THE BLOCKING IS NOT UNIFORM ACROSS
// AXES and that is a real fact about this checkpoint, not a tolerance: `embed` is scaled per row
// along its last axis only (384006168 rows unchanged, 256 -> 8), while `wkv` is blocked along both
// (25600 -> 800, 6144 -> 192). A relation that demanded every axis be blocked would refuse the
// real embed pair; one that demanded none would admit an arbitrary scale shape. So each axis is
// classified, and a pair whose axis is NEITHER equal NOR the blocked quotient has no arm.
type EngramScaleAxisRelation
  = ScaleAxisUnblocked
  | ScaleAxisBlockedBy { block: Nat }
  | ScaleAxisUnrelated { payload_dim: Nat, scale_dim: Nat }

fn deepseek_v4_1_flash_scale_axis_relation(payload_dim: Nat, scale_dim: Nat, block: Nat) -> EngramScaleAxisRelation {
  if payload_dim == scale_dim {
    ScaleAxisUnblocked
  } else {
    if block > 0 && scale_dim > 0 && payload_dim == scale_dim * block {
      ScaleAxisBlockedBy { block: block }
    } else {
      ScaleAxisUnrelated { payload_dim: payload_dim, scale_dim: scale_dim }
    }
  }
}

fn deepseek_v4_1_flash_scale_axis_is_related(r: EngramScaleAxisRelation) -> Bool {
  match r {
    ScaleAxisUnblocked => true
    ScaleAxisBlockedBy { block: _ } => true
    ScaleAxisUnrelated { payload_dim: _, scale_dim: _ } => false
  }
}

type EngramScalePairing sole_constructor {
  payload_name: NonEmptyStr
  scale_name: NonEmptyStr
  axis_relations: List<EngramScaleAxisRelation>
}

fn deepseek_v4_1_flash_entry_named(name: NonEmptyStr) -> SafetensorsEntry? {
  (filter(
    safetensors_population_entries(s: deepseek_v4_1_flash_engram_population),
    e => (e.name as String) == (name as String))).first()
}

// A ZERO DIMENSION IS THE ABSENT ANSWER, and the relation fold below classifies zero against any
// payload dimension as Unrelated -- so an out-of-range index cannot silently read as a match.
fn deepseek_v4_1_flash_dim_at(shape: List<Nat>, index: Nat) -> Nat {
  match (shape.skip(index)).first() {
    Absent => 0
    Present { value: d } => d
  }
}

// THE RANK GUARD IS LOCAL RATHER THAN INHERITED. `hi: count(p.shape) - 1` underflows on a Nat if the
// shape is empty, and equal ranks do not exclude BOTH being empty. An empty shape is separately an
// EntryShapeEmpty defect at population establishment, so the underflow is not reachable from an
// established standing today -- but this fold reads the module's declared entries directly, so that
// safety is inherited from a distant invariant rather than enforced here. DESIGN section 5 prefers
// construction over validation, so the rank is required to be non-zero at the site: a pairing over no
// axes is not a pairing, which `deepseek_v4_1_flash_scale_pairing_holds` already says by requiring a
// non-empty relation list.
fn deepseek_v4_1_flash_scale_pairing(payload_name: NonEmptyStr, scale_name: NonEmptyStr) -> EngramScalePairing? {
  match deepseek_v4_1_flash_entry_named(name: payload_name) {
    Absent => none
    Present { value: p } => match deepseek_v4_1_flash_entry_named(name: scale_name) {
      Absent => none
      Present { value: s } =>
        if count(p.shape) == count(s.shape) && count(p.shape) > 0 {
          Present { value: EngramScalePairing {
            payload_name: payload_name,
            scale_name: scale_name,
            axis_relations: map(
              nat_range_inclusive(lo: 0, hi: count(p.shape) - 1),
              i => deepseek_v4_1_flash_scale_axis_relation(
                payload_dim: deepseek_v4_1_flash_dim_at(shape: p.shape, index: i),
                scale_dim: deepseek_v4_1_flash_dim_at(shape: s.shape, index: i),
                block: deepseek_v4_1_flash_weight_block_size)),
          } }
        } else { none }
    }
  }
}

fn deepseek_v4_1_flash_scale_pairing_holds(p: EngramScalePairing) -> Bool {
  count(p.axis_relations) > 0 && all(p.axis_relations, r => deepseek_v4_1_flash_scale_axis_is_related(r: r))
}

// THE FOUR PAIRS THIS POPULATION CONTAINS. A fifth fp8 tensor without a scale, or a scale without
// its payload, does not appear here and would leave the pairing fold with an unmatched tensor --
// which the witness module checks by counting the scale-dtype tensors against these rows.
data deepseek_v4_1_flash_engram_scale_pair_names: List<List<NonEmptyStr>> = [
  ["layers.1.engram.embed.weight" as NonEmptyStr, "layers.1.engram.embed.scale" as NonEmptyStr],
  ["layers.1.engram.wkv.weight" as NonEmptyStr, "layers.1.engram.wkv.scale" as NonEmptyStr],
  ["layers.14.engram.embed.weight" as NonEmptyStr, "layers.14.engram.embed.scale" as NonEmptyStr],
  ["layers.14.engram.wkv.weight" as NonEmptyStr, "layers.14.engram.wkv.scale" as NonEmptyStr],
]

// ── THE CONFIG DIMENSIONS AND THE TENSOR SHAPES ARE TWO SOURCES THAT MUST AGREE ────────────────
//
// `deepseek_v4_1_flash_engram.unpadded_embeddings` and the embed tensors' row counts are read from
// DIFFERENT FILES -- config.json and the shard headers -- so their agreement is evidence rather
// than a tautology. Same for the n-gram projections: q_weight and k_weight are [max_ngram_size,
// hidden_size], both config keys. head_dim is the embed tensors' last axis.
fn deepseek_v4_1_flash_engram_embed_rows() -> List<Nat> {
  flat_map(
    ["layers.1.engram.embed.weight" as NonEmptyStr, "layers.14.engram.embed.weight" as NonEmptyStr],
    n => match deepseek_v4_1_flash_entry_named(name: n) {
      Absent => []
      Present { value: e } => match e.shape.first() {
        Absent => []
        Present { value: rows } => [rows]
      }
    })
}

fn deepseek_v4_1_flash_engram_ngram_projection_shape() -> List<Nat> {
  [deepseek_v4_1_flash_engram.max_ngram_size, deepseek_v4_1_flash_hidden_size]
}

// INDEPENDENTLY RE-DERIVED, WHICH IS THE ONE CHECK A TRANSCRIPTION CANNOT PERFORM ON ITSELF.
//
// These twelve entries and two shard rows were read from the Hub shard headers at the pinned revision
// and written down here, and a transcription can be internally consistent while being wrong about its
// source. Review 65049 re-derived all twelve tensor spans from shape x dtype width, computed both shard
// payload totals as file_bytes minus the 8-byte length prefix minus header_bytes, and reports that every
// offset chains exactly and both shards close to the byte -- by a reader that did not copy the numbers.
//
// That is corroboration of the ARITHMETIC and of internal consistency. It is NOT a second reading of the
// Hub, so it does not discharge the standing below: these remain publisher-declared figures cited to the
// upstream authority, and the fleet-side obligation that would turn them into a local materialisation
// receipt is the DSV41-10 frontier row's trigger, unchanged by this.
data deepseek_v4_1_flash_engram_population_standing: CitedFigureStanding = CitedToAuthority {
  authority: extdeps_external_authority_anchor,
}

data deepseek_v4_1_flash_frontier_dsv41_10: List<FrontierRow> = deepseek_v4_1_flash_frontier_rows(
  decl_names: [
    "deepseek_v4_1_flash_engram_entries_layer_1" as NonEmptyStr,
    "deepseek_v4_1_flash_engram_entries_layer_14" as NonEmptyStr,
    "deepseek_v4_1_flash_engram_population" as NonEmptyStr,
    "deepseek_v4_1_flash_engram_shards" as NonEmptyStr,
    "deepseek_v4_1_flash_engram_derived_bytes" as NonEmptyStr,
    "deepseek_v4_1_flash_engram_scale_pair_names" as NonEmptyStr,
    "deepseek_v4_1_flash_engram_population_standing" as NonEmptyStr,
    "deepseek_v4_1_flash_index_tensor_count" as NonEmptyStr,
    "deepseek_v4_1_flash_engram_tensor_count" as NonEmptyStr,
  ],
  reason: "DSV41-10 gunbc.fabric.engram_materialization consumes this exact population as its component subject",
  dissolution: unbound_dissolution(description: "TRIGGER: a fleet-side reading that verifies these two shard sha256 digests over bytes present on a Spark and relates the header-declared population to them. SUFFICIENT FOR: the component subject's realization evidence stops being publisher-declared structure plus publisher-declared digests and becomes a local materialization receipt." as NonEmptyStr),
)
