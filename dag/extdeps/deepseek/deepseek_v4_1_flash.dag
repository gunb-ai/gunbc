// DEEPSEEK-V4.1-FLASH, as its own extdeps authority because it is an independently versioned
// upstream product, not a revision of DeepSeek-V4-Flash and not a property of whatever happens to
// serve it. The V4 family lives in extdeps.deepseek.deepseek_v4; this module must not import that
// one, and a caller that wants V4.1 facts must ask here. A repointed V4 import would be the same
// fork under a new name: the encoder file, the DSML tags, the effort algebra, and the KV
// footprint are all different facts.

// THE WEIGHTS' IDENTITY IS THE HUB REPO AT THE PIN. The hosted API string `deepseek-flash` is a
// dated provider mapping (2026-09-10 cutover; legacy `deepseek-v4-flash` names also route there).
// No hosted route in this repository consumes it, so it is not declared here.
data deepseek_v4_1_flash_hub_repo: HubRepoId = HubRepoId {
  kind: HubModelRepo,
  path: "deepseek-ai/DeepSeek-V4.1-Flash" as NonEmptyStr,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: hub_repo_https_uri(repo: deepseek_v4_1_flash_hub_repo),
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.deepseek.deepseek_v4_1_flash",
      decl_name: "deepseek_v4_1_flash_hub_repo",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

// THE PIN. Every config, footprint, and encoder row below is read from this Hub commit, not from
// `main` and not from a serving runtime's copy. The commit is the 2026-09-10 encoder namespace
// fix (`fix(encoding): preserve tool namespaces in prompts and completions`), which is also HEAD
// of the repository at the time of this transcription.
data deepseek_v4_1_flash_revision: NonEmptyStr = "dba1be0a40aa45a94ad051997016db3960a90277" as NonEmptyStr
data deepseek_v4_1_flash_revision_committed: NonEmptyStr = "2026-09-10T08:18:10Z" as NonEmptyStr

data deepseek_v4_1_flash_config_path: NonEmptyStr = "config.json" as NonEmptyStr
data deepseek_v4_1_flash_encoder_path: NonEmptyStr = "encoding/encoding.py" as NonEmptyStr
// LICENSE FILE AT THE PIN, SPDX MIT. DSV41-1 is the consumer: a serving image that redistributes
// these weights must carry this source, not a guessed license.
data deepseek_v4_1_flash_license_path: NonEmptyStr = "LICENSE" as NonEmptyStr
data deepseek_v4_1_flash_license_spdx: NonEmptyStr = "MIT" as NonEmptyStr
data deepseek_v4_1_flash_safetensors_index_path: NonEmptyStr = "model.safetensors.index.json" as NonEmptyStr
data deepseek_v4_1_flash_inference_model_path: NonEmptyStr = "inference/model.py" as NonEmptyStr

// Blob and tree URLs for this pin are `extdeps.huggingface.hub` `hub_blob_url` /
// `hub_repo_tree_api_url` applied to `deepseek_v4_1_flash_hub_repo` and the path/revision rows
// below. This module does not re-mint the Hub URL shape.

// ===========================================================================================
// CONFIG, transcribed from config.json at the pinned revision.
// ===========================================================================================

// ARCHITECTURE CLASS NAME, the string DSV41-1's registry probe must look for. Cited from
// config.json `architectures[0]`. Declared frontier: DSV41-1 (loyal-ram-346).
data deepseek_v4_1_flash_architecture_class: NonEmptyStr = "DeepseekV41ForCausalLM" as NonEmptyStr
data deepseek_v4_1_flash_model_type: NonEmptyStr = "deepseek_v41" as NonEmptyStr
data deepseek_v4_1_flash_quant_method: NonEmptyStr = "fp8" as NonEmptyStr
data deepseek_v4_1_flash_quant_activation_scheme: NonEmptyStr = "dynamic" as NonEmptyStr
data deepseek_v4_1_flash_quant_scale_fmt: NonEmptyStr = "ue8m0" as NonEmptyStr
data deepseek_v4_1_flash_expert_dtype: NonEmptyStr = "fp4" as NonEmptyStr
data deepseek_v4_1_flash_weight_block_size: Nat = 32

// KV CACHE DTYPE IS NOT A CONFIG.JSON KEY. The card's "FP4 main KV / E2M1 / 890 bytes per token"
// is prose; this module does not transcribe it. The reference inference at the same revision
// quantizes compressed KV with fp4_act_quant(..., scale_dtype=float8_e4m3fn) in
// inference/model.py; window KV has no dtype key in config.json. Declared frontier: DSV41-1 may
// observe what a given engine actually selects.
data deepseek_v4_1_flash_config_declares_kv_cache_dtype: Bool = false
data deepseek_v4_1_flash_inference_compresses_kv_as_fp4: Bool = true

data deepseek_v4_1_flash_hidden_size: Nat = 5120
data deepseek_v4_1_flash_num_hidden_layers: Nat = 40
data deepseek_v4_1_flash_num_attention_heads: Nat = 64
data deepseek_v4_1_flash_vocab_size: Nat = 129280
data deepseek_v4_1_flash_n_routed_experts: Nat = 384
data deepseek_v4_1_flash_n_shared_experts: Nat = 1
data deepseek_v4_1_flash_num_experts_per_tok: Nat = 6
data deepseek_v4_1_flash_sliding_window: TokenCount = token_count(count: 128)
data deepseek_v4_1_flash_index_topk: TokenCount = token_count(count: 512)
data deepseek_v4_1_flash_candidate_topk_blocks: Nat = 2048
data deepseek_v4_1_flash_candidate_block_size: Nat = 8
data deepseek_v4_1_flash_num_nextn_predict_layers: Nat = 3
