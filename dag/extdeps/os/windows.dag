module extdeps.os.windows



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "learn.microsoft.com/en-us/windows/release-health/windows11-release-information"
  }
}

data windows_11_24h2_catalog: WindowsDistributionCatalogRow = WindowsDistributionCatalogRow {
  distribution: Windows1124H2Build26100,
  release_label: "24H2",
  os_build: "26100",
  package_manager: Winget,
  libc: Ucrt,
  libc_version: none,
  end_of_servicing: "2026-10-13",
}

fn windows_distribution_catalog_row(distro: WindowsDistribution) -> WindowsDistributionCatalogRow {
  match distro {
    Windows1124H2Build26100 => windows_11_24h2_catalog
  }
}
