module extdeps.os.windows

import std.os.types {
  Ucrt,
  Windows1124H2Build26100,
  WindowsDistribution,
  WindowsDistributionCatalogRow,
  Winget,
}

import extdeps.external_authority { ExternalAuthority }
import std.types { String, List }
import std.workspace_artifact { WorkspaceFootprint, WorkspaceArtifact, CitedUpstream, HostOsMetadata }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "learn.microsoft.com/en-us/windows/release-health/windows11-release-information"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.os.windows", decl_name: "windows_11_24h2_catalog", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data windows_11_24h2_catalog: WindowsDistributionCatalogRow = WindowsDistributionCatalogRow {
  distribution: Windows1124H2Build26100,
  release_label: "24H2",
  os_build: "26100",
  package_manager: Winget,
  libc: Ucrt,
  libc_version: none,
  end_of_servicing: "2026-10-13",
}

fn windows_distribution_catalog_row(distro: WindowsDistribution) -> WindowsDistributionCatalogRow {
  match distro {
    Windows1124H2Build26100 => windows_11_24h2_catalog
  }
}

// WORKSPACE FOOTPRINT. Explorer writes thumbnail caches into browsed directories.
fn explorer_thumbnail_footprint() -> WorkspaceFootprint {
  WorkspaceFootprint {
    provenance: CitedUpstream { display: "Windows Explorer cache", upstream: "microsoft.com (Explorer thumbnail cache)" },
    artifacts: [
      WorkspaceArtifact { pattern: "Thumbs.db", meaning: "Explorer thumbnail cache", reason: HostOsMetadata }
    ]
  }
}
