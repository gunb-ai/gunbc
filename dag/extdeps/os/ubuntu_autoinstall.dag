module extdeps.os.ubuntu_autoinstall

import std.types { Int, NonEmptyStr, Bool, List, String }
import std.os.types { UbuntuDistribution }
import std.optional { Optional, Present, Absent }
import extdeps.ssh.keys { SshPublicKey }
import extdeps.uri { Uri, Https, uri_wire }
import extdeps.firmware.kernel_cmdline { KernelCmdlineArg, KernelKeyValue }
import extdeps.external_authority { ExternalAuthority }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html"
  }
}

type AutoinstallDeliveryMethod =
    NoCloudNet { seed_url: Uri }
  | NoCloudLocal

type AutoinstallIdentity {
  hostname: NonEmptyStr
  username: NonEmptyStr
  realname: NonEmptyStr
  hashed_password: NonEmptyStr
}

// THE KEY-ONLY ENTRY, LANDED IN THE CLOUD-INIT USER TABLE INSTEAD OF THE AUTOINSTALL IDENTITY.
// WHY THIS EXISTS AT ALL is the Canonical autoinstall reference's own ruling on the identity section,
// verbatim at its `identity` heading
// (https://canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html):
//   "This is the only configuration key that must be present (unless the user-data section is present,
//   in which case it is optional)."
// So a key-only posture is not a workaround around the schema -- upstream provides the door. And because the
// identity section's own schema (subiquity server/controllers/identity.py, IdentityData) declares
// `required: ["username", "hostname", "password"]`, an identity mapping WITHOUT a password is what upstream
// refuses; the only upstream-legal no-password posture is therefore to omit identity and carry the user in
// cloud-init's user-data, which this type models. The per-user key spellings are cloud-init's own schema
// (cloud-init/config/schemas/schema-cloud-config-v1.json): `name`, `gecos`, `ssh_authorized_keys`,
// `lock_passwd`. NO `passwd` AND NO `hashed_passwd` KEY IS REPRESENTABLE HERE ON PURPOSE: a key-only entry
// is defined as one that carries no password at all, so the type cannot state the thing the operator's
// condition forbids. `lock_passwd` stays settable because a user with keys and an unlocked empty password
// field is a different machine than one with keys and a locked password field.
//
// `shell` is a CLOSED TYPE, not a string, for the same reason `passwd` is missing: cloud-init cc_users_groups
// admits a named login shell, and gunbc.provisioning.public_nocloud_seed admits exactly two spellings
// (/bin/bash, /bin/sh) at that leaf, so the type stores the choice from that closed list rather than text a
// caller could get wrong and a seed publisher would have to re-audit. `sudo` is NOT a field at all: with
// lock_passwd true, a passwordless account can only have the NOPASSWD rule, so the closed seed schema admits
// exactly one string there and there is no choice to store. gunbc.os_install_emit emits that one rule.
//
// NO `gecos`: it is a cosmetic comment and the closed seed schema does not admit it. Dropping it is the honest
// direction (a field this fleet's seed cannot publish is a field the type should not offer), not a loss --
// the account's identity is its name and its keys.
type CloudInitUserShell = BashLoginShell | PosixShell

type CloudInitUserEntry {
  name: NonEmptyStr
  ssh_authorized_keys: List<SshPublicKey>
  lock_passwd: Bool
  shell: CloudInitUserShell
}

type AutoinstallStoragePolicy
  = StoragePolicyAbsent
  | StoragePolicyDirectLayout

data nocloud_datasource_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloudinit.readthedocs.io/en/latest/reference/datasources/nocloud.html"
  }
}

// The ds= kernel-cmdline token grammar (ds=nocloud;s=<seedfrom> / ds=nocloud-net;s=<url>) is owned
// by cloud-init's NoCloud datasource (anchor above) — a DISTINCT upstream from subiquity's
// autoinstall reference (the module anchor), which owns the autoinstall payload the seed delivers.
// The ';' in this token forced grub_cmdline_arg_render's quoting rule: unquoted, grub treats ';' as
// a command separator and silently truncates the seedfrom, degrading autoinstall to interactive
// (root-caused live on srv3/srv4).
//
// THE TOKEN, ONCE: `ds=<datasource>;s=<seedfrom>` as one kernel argument. Quoting it for a grub.cfg is
// extdeps.bootloader.grub grub_cmdline_arg_render's job, not this builder's, so every consumer that renders it through
// the GRUB model gets the one quoting rule.
fn nocloud_seedfrom_kernel_arg(datasource: NonEmptyStr, seedfrom: String) -> KernelCmdlineArg {
  KernelKeyValue { key: "ds", value: join([datasource as String, ";s=", seedfrom], "") }
}

// The network delivery's argument, from its carrier: NoCloudNet names the seed URL; NoCloudLocal names none, so it has
// no network argument.
fn nocloud_net_ds_kernel_arg(delivery: AutoinstallDeliveryMethod) -> KernelCmdlineArg? {
  match delivery {
    NoCloudNet { seed_url: u } => Present { value: nocloud_seedfrom_kernel_arg(datasource: "nocloud-net", seedfrom: uri_wire(uri: u) as String) }
    NoCloudLocal => Absent
  }
}
// The autoinstall `ssh` section: present means the installer installs openssh-server and these two settings
// apply to it; absent means no server is installed, so there are no keys or password policy to carry.
type AutoinstallSshServer {
  authorized_keys: List<SshPublicKey>
  password_auth: Bool
}

// THE IDENTITY AND THE USER TABLE ARE ONE CHOICE, NOT TWO FIELDS.
// WHY THERE ARE TWO AT ALL is Canonical's own ruling on the identity section, verbatim at its `identity`
// heading (https://canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html):
//   "This is the only configuration key that must be present (unless the user-data section is present,
//   in which case it is optional)."
// So exactly one of the two must be present, and that is what this coproduct states: WithIdentity carries
// subiquity's identity mapping, and UserDataOnly carries the operator's entry in cloud-init's user-data
// instead. The invalid pair — NEITHER — is not a value here at all, because a payload that renders a
// document upstream refuses is not a document shape this fleet should be able to assemble (DESIGN.md §5:
// "Stronger than catching a wrong state is making it unwritable — correctness by construction, not
// validation."). Two independent Optionals said "the emitter will notice"; the emitter is a serializer and
// a serializer that drops both keys emits a document subiquity rejects, which is §5's fabricated plausible
// output. With the choice declared, the emitter has nothing left to notice: every value it can be handed
// renders a document upstream accepts, and the branches below are the two upstream-legal ones.
type AutoinstallIdentityPosture
  = WithIdentity { identity: AutoinstallIdentity, user_data: Optional<List<CloudInitUserEntry>> }
  | UserDataOnly { users: List<CloudInitUserEntry> }

// THE IDENTITY, IF THE SEED TOOK THAT ROUTE. Consumers that legitimately need the identity (a hostname for a
// seeded image's label, an instance-id for a staged meta-data file) read it through here instead of reaching
// into a field that no longer exists as an Optional: the choice says whether there is one, and this function
// only ever hands back what the choice contains — it cannot be asked for the case that was never legal.
fn autoinstall_identity_of(payload: UbuntuAutoinstallPayload) -> Optional<AutoinstallIdentity> {
  match payload.identity_posture {
    WithIdentity { identity: id, user_data: _ } => Present { value: id }
    UserDataOnly { users: _ } => Absent
  }
}

type UbuntuAutoinstallPayload {
  autoinstall_version: Int
  delivery: AutoinstallDeliveryMethod
  fully_automated: Bool
  target_distribution: UbuntuDistribution
  // WHICH OF THE TWO UPSTREAM-LEGAL ENTRY ROUTES this seed takes. WithIdentity renders today's document
  // byte-for-byte: subiquity's identity schema (server/controllers/identity.py, IdentityData) declares
  // required ["username","hostname","password"], so a mapping without a password is what upstream refuses,
  // and the passwordless posture has to come through UserDataOnly. See CloudInitUserEntry for the key-only
  // entry's own type, which cannot express a password field at all.
  identity_posture: AutoinstallIdentityPosture
  locale: NonEmptyStr
  keyboard_layout: NonEmptyStr
  ssh: Optional<AutoinstallSshServer>
  storage_policy: AutoinstallStoragePolicy
}

// A LIVE-SESSION autoinstall: upstream's `early-commands` run in the live installer environment
// before any other autoinstall step, and `interactive-sections: ["*"]` hands every section after them
// to a human. So the commands are the whole unattended content of the seed, and nothing that writes
// storage runs unless someone at the console drives it. Both keys and their semantics are the
// autoinstall reference's (module anchor); the type carries no identity or storage because an
// all-interactive session asks for them at the console instead.
type UbuntuAutoinstallLiveCommands {
  autoinstall_version: Int
  early_commands: List<NonEmptyStr>
}
