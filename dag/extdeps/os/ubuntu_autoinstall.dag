module extdeps.os.ubuntu_autoinstall


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html"
  }
}

type AutoinstallDeliveryMethod =
    NoCloudNet { seed_url: extdeps.uri.Uri }
  | NoCloudLocal

type AutoinstallIdentity {
  hostname: std.types.NonEmptyStr
  username: std.types.NonEmptyStr
  realname: std.types.NonEmptyStr
  hashed_password: std.types.NonEmptyStr
}

type AutoinstallStoragePolicy
  = StoragePolicyAbsent
  | StoragePolicyDirectLayout

data nocloud_datasource_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "cloudinit.readthedocs.io/en/latest/reference/datasources/nocloud.html"
  }
}

// The ds= kernel-cmdline token grammar (ds=nocloud;s=<seedfrom> / ds=nocloud-net;s=<url>) is owned by cloud-init's NoCloud datasource (anchor above) — a DISTINCT upstream from subiquity's autoinstall reference (the module anchor), which owns the autoinstall payload the seed delivers. The ';' inside this token is the character that forced grub_cmdline_arg_render's quoting rule: unquoted, grub treats ';' as a command separator and silently truncates the seedfrom, degrading autoinstall to interactive (root-caused live on srv3/srv4).
type UbuntuAutoinstallPayload {
  autoinstall_version: Int
  delivery: AutoinstallDeliveryMethod
  fully_automated: Bool
  target_distribution: std.os.types.UbuntuDistribution
  identity: AutoinstallIdentity
  locale: std.types.NonEmptyStr
  keyboard_layout: std.types.NonEmptyStr
  install_openssh_server: Bool
  ssh_authorized_keys: List<extdeps.ssh.SshPublicKey>
  ssh_password_auth: Bool
  storage_policy: AutoinstallStoragePolicy
}
