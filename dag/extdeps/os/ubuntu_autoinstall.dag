module extdeps.os.ubuntu_autoinstall

import std.types { Int, NonEmptyStr, Bool, List }
import std.os.types { UbuntuDistribution }
import extdeps.access.ssh { SshPublicKey }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalAuthority }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html"
  }
}

type AutoinstallDeliveryMethod =
    NoCloudNet { seed_url: Uri }
  | NoCloudLocal

type AutoinstallIdentity {
  hostname: NonEmptyStr
  username: NonEmptyStr
  realname: NonEmptyStr
  hashed_password: NonEmptyStr
}

type AutoinstallStoragePolicy
  = StoragePolicyAbsent
  | StoragePolicyDirectLayout

data nocloud_datasource_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloudinit.readthedocs.io/en/latest/reference/datasources/nocloud.html"
  }
}

data nocloud_datasource_note: String = "The ds= kernel-cmdline token grammar (ds=nocloud;s=<seedfrom> / ds=nocloud-net;s=<url>) is owned by cloud-init's NoCloud datasource (anchor above) — a DISTINCT upstream from subiquity's autoinstall reference (the module anchor), which owns the autoinstall payload the seed delivers. The ';' inside this token is the character that forced grub_cmdline_arg_render's quoting rule: unquoted, grub treats ';' as a command separator and silently truncates the seedfrom, degrading autoinstall to interactive (root-caused live on srv3/srv4)."

type UbuntuAutoinstallPayload {
  autoinstall_version: Int
  delivery: AutoinstallDeliveryMethod
  fully_automated: Bool
  target_distribution: UbuntuDistribution
  identity: AutoinstallIdentity
  locale: NonEmptyStr
  keyboard_layout: NonEmptyStr
  install_openssh_server: Bool
  ssh_authorized_keys: List<SshPublicKey>
  ssh_password_auth: Bool
  storage_policy: AutoinstallStoragePolicy
}
