fn install_media_remaster_reconcile(artifact: UbuntuSeededInstallMediaArtifactRow) -> InstallMediaRemasterOutcome {
  let final_path = ubuntu_seeded_install_media_install_path(artifact: artifact)
  match observe_install_media_remaster(artifact: artifact) {
    InstallMediaRemasterValid => InstallMediaRemasterAlreadyPresent { path: final_path }
    InstallMediaRemasterAbsent => install_media_remaster_apply(artifact: artifact)
    InstallMediaRemasterStale => install_media_remaster_apply(artifact: artifact)
    InstallMediaRemasterVerifyInfraFailure { reason: r } => InstallMediaRemasterRefused {
      reason: concat("VerifyInfraFailureRefusal: ", r as String) as NonEmptyStr
