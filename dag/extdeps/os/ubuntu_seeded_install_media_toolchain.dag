module extdeps.os.ubuntu_seeded_install_media_toolchain


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gnu.org/software/xorriso/"
  }
}

type InstallMediaRemasterToolchainRequirement {
  required_tools: List<CliTool>
}

data install_media_remaster_toolchain_requirement: InstallMediaRemasterToolchainRequirement = InstallMediaRemasterToolchainRequirement {
  required_tools: [xorriso_cli_tool],
}

fn install_media_remaster_toolchain_includes_xorriso(
  requirement: InstallMediaRemasterToolchainRequirement,
) -> Bool {
  fold(
    requirement.required_tools,
    init: false,
    f: (acc, tool) => acc || tool.name == xorriso_cli_tool.name
  )
}

fn install_media_remaster_toolchain_is_complete(
  requirement: InstallMediaRemasterToolchainRequirement,
) -> Bool {
  install_media_remaster_toolchain_includes_xorriso(requirement: requirement)
}
