module extdeps.os.exec_arg_limit

import std.measure { ByteSize, byte_size }
import std.types { String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man2/execve.2.html"
  }
}

data host_exec_arg_max_strlen_note: String = "Linux execve(2) MAX_ARG_STRLEN = 32 * PAGE_SIZE (4096) = 131072 bytes: a single argument (or environment) string longer than this makes execve fail with E2BIG (\"Argument list too long\"). This is the per-argument ceiling that turns a large `sh -c <script>` into an opaque OS error — distinct from ARG_MAX (~2 MiB total argv+envp, `getconf ARG_MAX`), which is a larger, separate limit and is NOT modeled here (modeling it as this value would be an over-approximation). Single authority for the argv-size wall realized in the v1 interpreter's shell dispatch (src/v1/stage0/src/v1_interpreter.rs — const HOST_ARG_MAX_STRLEN_BYTES mirrors this value; the floor witness exec_arg_limit_witness_test reads the interpreter source and asserts that const line carries THIS authority's byte value — a cross-check derived from the authority, not a second independent literal — and v1_interpreter argv_arg_limit_test::mirror_matches_extdeps_authority pins the Rust side, so the two representations cannot drift): an invocation whose largest single argv token exceeds this refuses with a typed, located InterpError::ArgvExceedsHostArgMax rather than letting execve die with os error 7. The deploy fix routes large shell scripts through stdin instead of argv so they never reach this ceiling; this authority is the general host-boundary guard for every remaining argv-embedding site, so the next over-embed fails loud and typed instead of opaque E2BIG."

data host_exec_arg_max_strlen: ByteSize = byte_size(131072)
