module extdeps.os.macos

import std.os.types {
  HomebrewDeFacto,
  LibSystem,
  MacosDistribution,
  MacosDistributionCatalogRow,
  Sequoia15,
}

import extdeps.external_authority { ExternalAuthority }
import std.types { String, List }
import std.workspace_artifact { WorkspaceFootprint, WorkspaceArtifact, CitedUpstream, HostOsMetadata }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.apple.com/documentation/macos-release-notes/macos-15-release-notes"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.os.macos", decl_name: "sequoia_15_catalog", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data sequoia_15_catalog: MacosDistributionCatalogRow = MacosDistributionCatalogRow {
  distribution: Sequoia15,
  release_label: "macOS 15 Sequoia",

  darwin_version: none,

  package_manager: HomebrewDeFacto,
  libc: LibSystem,
  libc_version: none,
  annual_release_label: "15",
}

fn macos_distribution_catalog_row(distro: MacosDistribution) -> MacosDistributionCatalogRow {
  match distro {
    Sequoia15 => sequoia_15_catalog
  }
}

// WORKSPACE FOOTPRINT. Finder writes per-directory metadata into any tree it browses.
fn finder_metadata_footprint() -> WorkspaceFootprint {
  WorkspaceFootprint {
    provenance: CitedUpstream { display: "macOS Finder metadata", upstream: "developer.apple.com (Finder metadata)" },
    artifacts: [
      WorkspaceArtifact { pattern: ".DS_Store", meaning: "Finder folder-view metadata", reason: HostOsMetadata }
    ]
  }
}
