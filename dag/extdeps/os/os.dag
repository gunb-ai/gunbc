module extdeps.os.os


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Operating_system"
  }
}

fn cited_operating_system_surface(product: OperatingSystemProduct) -> OperatingSystemSurface {
  match product {
    UbuntuOs { distro: d } => operating_system_surface_ubuntu(ubuntu_distribution_catalog_row(d))
    WindowsOs { distro: d } => operating_system_surface_windows(windows_distribution_catalog_row(d))
    MacosOs { distro: d } => operating_system_surface_macos(macos_distribution_catalog_row(d))
  }
}

data ubuntu_24_04: OperatingSystemSurface = cited_operating_system_surface(UbuntuOs { distro: NobleNumbat2404Lts })
data windows_11: OperatingSystemSurface = cited_operating_system_surface(WindowsOs { distro: Windows1124H2Build26100 })
data macos_15_sequoia: OperatingSystemSurface = cited_operating_system_surface(MacosOs { distro: Sequoia15 })

data os_catalog: List<OperatingSystemSurface> = [
  ubuntu_24_04,
  windows_11,
  macos_15_sequoia,
]
