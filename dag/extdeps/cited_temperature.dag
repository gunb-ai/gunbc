module extdeps.cited_temperature

import std.types { NonEmptyStr }
import std.measure { Celsius }
import extdeps.external_authority { CitedFigureStanding }

// Its own module, not extdeps.external_authority: std.measure reaches external_authority, so importing
// Celsius there is an import cycle (the acyclicity law of DESIGN 3).
// A COMPONENT TEMPERATURE LIMIT IS ONE SHAPE, whatever the component (a DIMM band edge, a regulator
// ceiling, a CPU junction figure): a Celsius figure carrying its standing, or an honest statement that the
// documentation has not been read for it. LimitUnstated carries NO number, because inventing one to fill
// the field is the cautionary specimen of DESIGN 4d (a typed bet consumed as a wall); it names what would
// ground it. Consumers: the declared P5 decision subject of gunbc.plans.host_thermal_operating_point
// (hard constraints) and the B5 guard, which today reads Absent for DimmChannel and VoltageRegulator in
// gunbc.machine_intake.megarac_fan_thermal_guard megarac_guard_component_ceiling.
type CitedCelsiusFigure {
  value: Celsius
  standing: CitedFigureStanding
}

type CelsiusLimit
  = LimitStated { figure: CitedCelsiusFigure }
  | LimitUnstated { read_obligation: NonEmptyStr }
