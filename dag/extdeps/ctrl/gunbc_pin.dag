module extdeps.ctrl.gunbc_pin


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/ctrl/blob/main/scripts/session-dashboard/lib/gunbc_run.mjs"
  }
}

fn gunbc_pin_match(read_pin: String, desired_pin: String) -> Bool {
  read_pin != "" && desired_pin != "" && read_pin == desired_pin
}

fn gunbc_pin_skewed(host_pin: String, ctrl_pin: String) -> Bool {
  host_pin != "" && ctrl_pin != "" && host_pin != ctrl_pin
}
