// Supermicro R12SPD-A, read 2026-08-18 from the vendor product surface and quick-reference:
// SINGLE-socket LGA 4926 for Ampere Altra AND Altra Max (up to 250 W TDP), with SIXTEEN
// DDR4-3200 DIMM slots - eight channels at two DIMMs per channel on one socket, the
// memory-richest single-socket geometry in this census. The form factor is PROPRIETARY
// (Supermicro MegaDC), not ATX-family: chassis compatibility is a per-build obligation, not
// an assumption. Module-local record on the mt_collins/asrock pattern.
type SupermicroR12spdAMechanical {
  board_label: std.types.NonEmptyStr
  form_factor_label: std.types.NonEmptyStr
  processor_socket_count: std.nat.Nat
  socket: extdeps.cpu.types.CpuSocket
  processor_support_label: std.types.NonEmptyStr
  dimm_slots_total: std.nat.Nat
  dimms_per_channel: std.nat.Nat
  ddr4_max_data_rate: std.measure.MegatransfersPerSecond
  citation: std.types.NonEmptyStr
}

data supermicro_r12spd_a_mechanical: SupermicroR12spdAMechanical = SupermicroR12spdAMechanical {
  board_label: "Supermicro R12SPD-A",
  form_factor_label: "proprietary (Supermicro MegaDC family), not ATX-compatible",
  processor_socket_count: 1,
  socket: extdeps.cpu.ampere.ampere_lga4926_socket,
  processor_support_label: "LGA 4926, Ampere Altra / Altra Max up to 250 W TDP",
  dimm_slots_total: 16,
  dimms_per_channel: 2,
  ddr4_max_data_rate: std.measure.megatransfers_per_second(count: 3200),
  citation: "supermicro.com R12SPD-A product page and quick-reference QRG-2483, read 2026-08-18",
}

data supermicro_r12spd_single_socket_note: std.types.NonEmptyStr = "The R12 name reads like a dual-socket family but the board is SINGLE socket - a pairing plan written as one board with two processors does not fit it; two processors means two boards. Recorded because exactly that misread occurred in planning before the vendor surface was checked."
