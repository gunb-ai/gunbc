// The bytes the BMC UpdateService actually consumes: the OpenBMC-packaged tar
// INSIDE the distribution zip above, carrying its own MANIFEST. Modeled apart
// from the zip because the push artifact and the download artifact are two
// different byte sequences with two different digests, and pushing the zip
// (or the raw .ROM) to the UpdateService is a different act from pushing this.
data asrock_altrad8ud_bios_3_10_obmc_push_artifact_name: NonEmptyStr = "obmc-bios-altrad8ud-1l2t-3.10.all.tar"

