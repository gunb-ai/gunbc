// Authenticated read-only observations on srv3 (OpenBMC 2.07.00) and srv4 (OpenBMC 3.22.00),
// 2026-07-27: both select /usr/share/swampd/config-asrr.json through /usr/share/swampd/config.json
// and run /usr/bin/swampd under phosphor-pid-control.service. Both factory images carried the same
// TEMP_SOC curve. That curve is an observation owned here, not fleet intent. What changed between
// versions is the PID-entry topology and Redfish resource shape, not the five factory points. The
// 3.22 web UI /Managers/bmc/FanControl resource exposes InitialDuty; it does not own these thermal
// curve points.

data asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint: BmcwebNbdProxyEndpointVariant = VmSlotIndexEndpoint

data asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_absent_endpoints: List<BmcwebNbdProxyEndpointVariant> = [NbdSlotEndpoint]

type BmcReadOnlyProbeVerdict = ProbePresent | ProbeAbsent | ProbeInconclusive

type BmcLiveReadOnlyProbeRow {
  locator: NonEmptyStr
  verdict: BmcReadOnlyProbeVerdict
  probed_at: NonEmptyStr
}

data asrock_srv3_live_bmc_host: NonEmptyStr = "192.168.1.192"

data asrock_srv3_live_readonly_probe_rows: List<BmcLiveReadOnlyProbeRow> = [
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Managers/bmc FirmwareVersion",
    verdict: ProbePresent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Systems/system/VirtualMedia",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Managers/bmc/VirtualMedia",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/vm/0/0 non-upgrade GET",
    verdict: ProbeInconclusive,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/vm/0/0 ws-upgrade",
    verdict: ProbePresent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/nbd/0 non-upgrade GET",
    verdict: ProbeInconclusive,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/nbd/0 ws-upgrade",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
]

data asrock_srv3_live_probe_firmware_version: FirmwareSemanticVersion = firmware_semantic_version(
  major: 2,
  minor: 7,
  patch: 0,
)

fn live_probe_confirms_shipped_firmware_version() -> Bool {
  asrock_srv3_live_probe_firmware_version == asrock_altrad8ud_shipped_bmc_firmware_capabilities.firmware.version
}

fn live_probe_row_is_redfish_vm_absent(row: BmcLiveReadOnlyProbeRow) -> Bool {
  if row.locator == ("/redfish/v1/Systems/system/VirtualMedia" as NonEmptyStr)
      || row.locator == ("/redfish/v1/Managers/bmc/VirtualMedia" as NonEmptyStr) {
    row.verdict == ProbeAbsent
  } else {
    true
  }
}

fn live_probe_confirms_redfish_virtual_media_absent() -> Bool {
  fold(
    asrock_srv3_live_readonly_probe_rows,
    init: true,
    f: (acc, row) => acc && live_probe_row_is_redfish_vm_absent(row: row)
  )
}

fn live_probe_row_matches(locator: NonEmptyStr, verdict: BmcReadOnlyProbeVerdict, row: BmcLiveReadOnlyProbeRow) -> Bool {
  row.locator == locator && row.verdict == verdict
}

fn live_probe_has_ws_upgrade_row(locator: NonEmptyStr, verdict: BmcReadOnlyProbeVerdict) -> Bool {
  fold(
    asrock_srv3_live_readonly_probe_rows,
    init: false,
    f: (acc, row) => acc || live_probe_row_matches(locator: locator, verdict: verdict, row: row)
  )
}

fn live_probe_confirms_nbd_proxy_vm_slot_ws_present() -> Bool {
  live_probe_has_ws_upgrade_row(
    locator: "/vm/0/0 ws-upgrade" as NonEmptyStr,
    verdict: ProbePresent
  )
    && asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint == VmSlotIndexEndpoint
}

fn live_probe_confirms_nbd_slot_ws_absent() -> Bool {
  live_probe_has_ws_upgrade_row(
    locator: "/nbd/0 ws-upgrade" as NonEmptyStr,
    verdict: ProbeAbsent
  )
}

