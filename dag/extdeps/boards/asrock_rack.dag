data altrad8ud_fan_profile_observation_note: NonEmptyStr = "OpenBMC phosphor-pid-control fan profiles per firmware line, live-read from each host's /usr/share/swampd/config.json (-> config-asrr.json) on 2026-07-30. altrad8ud_openbmc_2_07_00_fan_profile is srv3's ORIGINAL vendor config (config-asrr.json mtime 2018). altrad8ud_srv4_asfound_stripped_fan_profile was srv4's config-asrr.json (mtime 2026-07-27, an onboarding overwrite of the vendor file, not the 2018 original); srv4 was remediated 2026-07-30 by writing the 2.07.00 curve."

data altrad8ud_openbmc_2_07_00_fan_profile: FanControlZoneProfile = FanControlZoneProfile {
  min_thermal_output: percent(30),
  failsafe: percent(30),
  curve: StepwiseFanCurve {
    sensor: "TEMP_SOC",
    failsafe: percent(75),
    points: [
      FanCurvePoint { reading: celsius(40), output: percent(30) },
      FanCurvePoint { reading: celsius(55), output: percent(40) },
      FanCurvePoint { reading: celsius(65), output: percent(50) },
      FanCurvePoint { reading: celsius(75), output: percent(75) },
      FanCurvePoint { reading: celsius(85), output: percent(100) },
    ],
  },
}

data altrad8ud_srv4_asfound_stripped_fan_profile: FanControlZoneProfile = FanControlZoneProfile {
  min_thermal_output: percent(30),
  failsafe: percent(75),
  curve: StepwiseFanCurve {
    sensor: "TEMP_SOC",
    failsafe: percent(75),
    points: [
      FanCurvePoint { reading: celsius(40), output: percent(30) },
      FanCurvePoint { reading: celsius(75), output: percent(30) },
      FanCurvePoint { reading: celsius(90), output: percent(30) },
      FanCurvePoint { reading: celsius(93), output: percent(55) },
      FanCurvePoint { reading: celsius(95), output: percent(70) },
      FanCurvePoint { reading: celsius(97), output: percent(85) },
      FanCurvePoint { reading: celsius(98), output: percent(100) },
    ],
  },
}

data altrad8ud_fleet_fan_profile: FanControlZoneProfile = altrad8ud_openbmc_2_07_00_fan_profile

data altrad8ud_known_good_fan_bmc_version: BmcFirmwareVersion = BmcFirmwareVersion {
  family: OpenBmc,
  version: "2.07.00",
}

data altrad8ud_bmc_upgrade_fan_regression_note: NonEmptyStr = "BMC 'newer is better' does NOT hold for fan control on ALTRAD8UD-1L2T: srv3 (OpenBMC 2.07.00) carries the original vendor phosphor-pid-control curve (ramps from 40C, SoC ~65C, ~4800 RPM inaudible); the 3.x-era srv4 was found 2026-07-30 with a stripped config-asrr.json (mtime 2026-07-27, an onboarding overwrite of the vendor file) that idled fans at 30% until 90C then panic-ramped, letting the SoC ride ~90C hot+loud. OPEN ITEM: whether the 3.x FIRMWARE IMAGE itself ships a degraded config-asrr.json is UNCONFIRMED — srv4's had been overwritten, obscuring the shipped default. Policy: pin altrad8ud_fleet_fan_profile on every BMC and gate any BMC firmware upgrade on re-applying + re-verifying it — do not upgrade fleet BMCs off 2.07.00 for its own sake."

type BmcReadOnlyProbeVerdict = ProbePresent | ProbeAbsent | ProbeInconclusive

type BmcLiveReadOnlyProbeRow {
  locator: NonEmptyStr
  verdict: BmcReadOnlyProbeVerdict
  probed_at: NonEmptyStr
}

data asrock_srv3_live_bmc_host: NonEmptyStr = "192.168.1.192"

data asrock_srv3_live_readonly_probe_rows: List<BmcLiveReadOnlyProbeRow> = [
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Managers/bmc FirmwareVersion",
    verdict: ProbePresent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Systems/system/VirtualMedia",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Managers/bmc/VirtualMedia",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/vm/0/0 non-upgrade GET",
    verdict: ProbeInconclusive,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/vm/0/0 ws-upgrade",
    verdict: ProbePresent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/nbd/0 non-upgrade GET",
    verdict: ProbeInconclusive,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/nbd/0 ws-upgrade",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
]

data asrock_srv3_live_probe_firmware_version: NonEmptyStr = "2.07.00"

fn live_probe_confirms_shipped_firmware_version() -> Bool {
  asrock_srv3_live_probe_firmware_version == asrock_altrad8ud_shipped_bmc_firmware_capabilities.firmware.version
}

fn live_probe_row_is_redfish_vm_absent(row: BmcLiveReadOnlyProbeRow) -> Bool {
  if row.locator == ("/redfish/v1/Systems/system/VirtualMedia" as NonEmptyStr)
      || row.locator == ("/redfish/v1/Managers/bmc/VirtualMedia" as NonEmptyStr) {
    row.verdict == ProbeAbsent
  } else {
    true
  }
}

fn live_probe_confirms_redfish_virtual_media_absent() -> Bool {
  fold(
    asrock_srv3_live_readonly_probe_rows,
    init: true,
    f: (acc, row) => acc && live_probe_row_is_redfish_vm_absent(row: row)
  )
}

fn live_probe_row_matches(locator: NonEmptyStr, verdict: BmcReadOnlyProbeVerdict, row: BmcLiveReadOnlyProbeRow) -> Bool {
  row.locator == locator && row.verdict == verdict
}

fn live_probe_has_ws_upgrade_row(locator: NonEmptyStr, verdict: BmcReadOnlyProbeVerdict) -> Bool {
  fold(
    asrock_srv3_live_readonly_probe_rows,
    init: false,
    f: (acc, row) => acc || live_probe_row_matches(locator: locator, verdict: verdict, row: row)
  )
}

fn live_probe_confirms_nbd_proxy_vm_slot_ws_present() -> Bool {
  live_probe_has_ws_upgrade_row(
    locator: "/vm/0/0 ws-upgrade" as NonEmptyStr,
    verdict: ProbePresent
  )
    && asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint == VmSlotIndexEndpoint
}

fn live_probe_confirms_nbd_slot_ws_absent() -> Bool {
  live_probe_has_ws_upgrade_row(
    locator: "/nbd/0 ws-upgrade" as NonEmptyStr,
    verdict: ProbeAbsent
  )
}
