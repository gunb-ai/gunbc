  firmware: asrock_altrad8ud_openbmc_2_07_00_capabilities.firmware,
  shape: extdeps.bmc.types.BmcRedfishSurfaceShape {
    thermal_surface: RedfishThermalSubsystemSensorCollection,
    fan_control_surface: RedfishFanControlResourceAbsent,
  },
}

