  observed_at: 1786582800000,
}

data asrock_altrad8ud_bios_openbmc_prerequisite_evidence: List<extdeps.firmware.types.FirmwarePrerequisiteObservation> = [
  asrock_altrad8ud_bios_310_push_refused_at_bmc_207,
  asrock_altrad8ud_bios_310_push_accepted_at_bmc_322,
]

data asrock_altrad8ud_bios_openbmc_prerequisite_receipt: String = "Irreducible rationale only; the executed pair itself is carried as FirmwarePrerequisiteObservation rows above, and prerequisite_evidence_verdict checks the declared minimum against them. What those rows cannot express: the vendor product page states NO such dependency, so the minimum is an executed finding rather than a documented one; the refusal on srv3 arrived only AFTER a 33 MB upload and a host power-off, and Redfish reported TaskState=Exception with no machine-readable cause, so the vendor diagnostic in the refusal row was readable only from the BMC journal over authenticated SSH; and the Instant Flash ROM packaging carries NoFirmwarePrerequisite because it never passes through the BMC at all, which is why the prerequisite belongs to the PACKAGING rather than to the release."

// The DOCUMENTED DIMM populations. A population absent from this list is an
// unsupported configuration whose boot failure proves nothing about the
// modules installed in it — note in particular that the four-module
// population is A1+B1+E1+F1 and is NOT one module per channel.
data asrock_altrad8ud_documented_dimm_populations: List<extdeps.boards.types.DimmPopulation> = [
  extdeps.boards.types.DimmPopulation { board: AsrockRackAltrad8ud1l2t, slots: ["A1"], authority: extdeps_external_authority_anchor },
  extdeps.boards.types.DimmPopulation { board: AsrockRackAltrad8ud1l2t, slots: ["A1", "E1"], authority: extdeps_external_authority_anchor },
  extdeps.boards.types.DimmPopulation { board: AsrockRackAltrad8ud1l2t, slots: ["A1", "B1", "E1", "F1"], authority: extdeps_external_authority_anchor },
  extdeps.boards.types.DimmPopulation {
    board: AsrockRackAltrad8ud1l2t,
    slots: ["A1", "B1", "C1", "D1", "E1", "F1", "G1", "H1"],
    authority: extdeps_external_authority_anchor,
  },
]

// Board integration facts only: HOW the Ampere consoles are routed. The board
// does not own the meanings of Ampere SCP tokens, and its ordinary AMI POST
// code table is a different namespace that does not decode P012/E588/P029.
data asrock_altrad8ud_scp_console_tcp_port: std.nat.Nat = 2202
