data asrock_altrad8ud_bios_3_10_obmc_push_artifact_digest: Digest = sha256_digest(
  hex: "e3bb2a26b863f24045e9e3bc950a89cbe3f8a86d7dc1c6c7a243f3afe35416ec",
)

data asrock_altrad8ud_bios_3_10_obmc_manifest_purpose: NonEmptyStr = "xyz.openbmc_project.Software.Version.VersionPurpose.Host"

data asrock_altrad8ud_bios_3_10_obmc_manifest_machine_name: NonEmptyStr = "altrad8ud-1l2t"

