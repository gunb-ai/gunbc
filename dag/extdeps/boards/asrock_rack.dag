  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/blob/main/docs/runbooks/srv3-nbd-proxy-ws-upgrade-dry-run.md"
  }
}

data asrock_altrad8ud_1l2t_catalog: BaseboardCatalogRow = BaseboardCatalogRow {
  model: AsrockRackAltrad8ud1l2t,
  model_label: "ASRock Rack ALTRAD8UD-1L2T",
  vendor: asrock_rack,
  bmc_firmware: OpenBmc,
}

data asrock_altrad8ud_redfish_system_id: NonEmptyStr = "system"
data asrock_altrad8ud_redfish_chassis_id: NonEmptyStr = "ALTRAD8UD_1L2T"

data altrad8ud_fan_header_note: String = "Fan subsystem facts cited to the board manual (extdeps_external_authority_anchor; layout p.6/p.13 Nos.17-21, pinout p.37, LEDs p.16, hardware monitor p.10): FIVE 6-pin System Fan Connectors FAN1..FAN5, each carrying TWO tach inputs (FAN_SPEED_SENSOR1 + FAN_SPEED_SENSOR2 — dual-rotor support; a single-rotor fan drives SENSOR1 only, so the BMC's FANx_1 sensors read absent by design under single-rotor population), one FAN_SPEED_CONTROL line, FAN_VOLTAGE and GND. Per-header red fan-fail LEDs LED_FAN1..LED_FAN5 on the board. Fan control model: per-header initial duty plus chassis-fan auto-adjust driven by CPU temperature ('CPU Quiet Fan'); the BMC WebUI Fan Control page (initial duty settings) is a 3.x BMC firmware feature, absent on 2.07."

data altrad8ud_fan_header_count: Int = 5

data altrad8ud_fan_tach_inputs_per_header: Int = 2

data altrad8ud_openbmc_base_capabilities: List<BmcCapability> = [
  CapabilityPowerControl,
  CapabilityBootSourceOverride,
  CapabilityAccountManagement,
  CapabilityFirmwareUpdate,
]

data altrad8ud_openbmc_2_07_00_capabilities_list: List<BmcCapability> = [
  CapabilityPowerControl,
  CapabilityBootSourceOverride,
  CapabilityAccountManagement,
  CapabilityFirmwareUpdate,
  CapabilityNbdProxyVirtualMedia,
  CapabilitySerialConsole,
]

data altrad8ud_openbmc_2_07_00_serial_console_probe: NonEmptyStr = "IPMI SOL Enabled=true, Privilege=ADMINISTRATOR, Payload Port=623 — confirmed live 2026-07-21 via ipmitool -I lanplus sol info against srv4 (192.168.1.195, OpenBMC 2.07.00)"

data asrock_altrad8ud_openbmc_2_07_00_capabilities: BmcFirmwareCapabilityRow = BmcFirmwareCapabilityRow {
  firmware: BmcFirmwareVersion {
    family: OpenBmc,
    version: "2.07.00",
  },
  capabilities: altrad8ud_openbmc_2_07_00_capabilities_list,
}

data asrock_altrad8ud_openbmc_3_06_00_capabilities: BmcFirmwareCapabilityRow = BmcFirmwareCapabilityRow {
  firmware: BmcFirmwareVersion {
    family: OpenBmc,
    version: "3.06.00",
  },
  capabilities: altrad8ud_openbmc_base_capabilities,
}

data asrock_altrad8ud_openbmc_3_06_00_catalog_authority: ExternalAuthority = asrock_altrad8ud_bmc_manual_authority

data asrock_altrad8ud_1l2t_bmc_firmware_capability_catalog: List<BmcFirmwareCapabilityRow> = [
  asrock_altrad8ud_openbmc_2_07_00_capabilities,
  asrock_altrad8ud_openbmc_3_06_00_capabilities,
]

data asrock_altrad8ud_shipped_bmc_firmware_capabilities: BmcFirmwareCapabilityRow = asrock_altrad8ud_openbmc_2_07_00_capabilities

data asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint: BmcwebNbdProxyEndpointVariant = VmSlotIndexEndpoint

data asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_absent_endpoints: List<BmcwebNbdProxyEndpointVariant> = [NbdSlotEndpoint]

type BmcReadOnlyProbeVerdict = ProbePresent | ProbeAbsent | ProbeInconclusive

type BmcLiveReadOnlyProbeRow {
  locator: NonEmptyStr
  verdict: BmcReadOnlyProbeVerdict
  probed_at: NonEmptyStr
}

data asrock_srv3_live_bmc_host: NonEmptyStr = "192.168.1.192"

data asrock_srv3_live_readonly_probe_rows: List<BmcLiveReadOnlyProbeRow> = [
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Managers/bmc FirmwareVersion",
    verdict: ProbePresent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Systems/system/VirtualMedia",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/redfish/v1/Managers/bmc/VirtualMedia",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/vm/0/0 non-upgrade GET",
    verdict: ProbeInconclusive,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/vm/0/0 ws-upgrade",
    verdict: ProbePresent,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/nbd/0 non-upgrade GET",
    verdict: ProbeInconclusive,
    probed_at: "2026-07-01",
  },
  BmcLiveReadOnlyProbeRow {
    locator: "/nbd/0 ws-upgrade",
    verdict: ProbeAbsent,
    probed_at: "2026-07-01",
  },
]

data asrock_srv3_live_probe_firmware_version: NonEmptyStr = "2.07.00"

fn live_probe_confirms_shipped_firmware_version() -> Bool {
  asrock_srv3_live_probe_firmware_version == asrock_altrad8ud_shipped_bmc_firmware_capabilities.firmware.version
}

fn live_probe_row_is_redfish_vm_absent(row: BmcLiveReadOnlyProbeRow) -> Bool {
  if row.locator == ("/redfish/v1/Systems/system/VirtualMedia" as NonEmptyStr)
      || row.locator == ("/redfish/v1/Managers/bmc/VirtualMedia" as NonEmptyStr) {
    row.verdict == ProbeAbsent
  } else {
    true
  }
}

fn live_probe_confirms_redfish_virtual_media_absent() -> Bool {
  fold(
    asrock_srv3_live_readonly_probe_rows,
    init: true,
    f: (acc, row) => acc && live_probe_row_is_redfish_vm_absent(row: row)
  )
}

fn live_probe_row_matches(locator: NonEmptyStr, verdict: BmcReadOnlyProbeVerdict, row: BmcLiveReadOnlyProbeRow) -> Bool {
  row.locator == locator && row.verdict == verdict
}

fn live_probe_has_ws_upgrade_row(locator: NonEmptyStr, verdict: BmcReadOnlyProbeVerdict) -> Bool {
  fold(
    asrock_srv3_live_readonly_probe_rows,
    init: false,
    f: (acc, row) => acc || live_probe_row_matches(locator: locator, verdict: verdict, row: row)
  )
}

fn live_probe_confirms_nbd_proxy_vm_slot_ws_present() -> Bool {
  live_probe_has_ws_upgrade_row(
    locator: "/vm/0/0 ws-upgrade" as NonEmptyStr,
    verdict: ProbePresent
  )
    && asrock_altrad8ud_openbmc_2_07_00_nbd_proxy_primary_endpoint == VmSlotIndexEndpoint
}

fn live_probe_confirms_nbd_slot_ws_absent() -> Bool {
  live_probe_has_ws_upgrade_row(
    locator: "/nbd/0 ws-upgrade" as NonEmptyStr,
    verdict: ProbeAbsent
  )
}
