module extdeps.boards.gigabyte

import std.types { NonEmptyStr, List }
import std.nat { Nat }
import extdeps.boards.types { BaseboardCatalogRow }
import extdeps.vendor.gigabyte { gigabyte }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gigabyte.com/Enterprise/Server-Motherboard/MP72-HB0-rev-30"
  }
}

data gigabyte_mp72_hb0_reseller_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.shi.com/product/46338341/AMPERE-MOTHERBOARD"
  }
}

data gigabyte_mp72_hb0_marketplace_listing_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.alibaba.com/product-detail/For-Gigabyte-MP72-HB0-Ampere-Altra_1600826005324.html"
  }
}

data gigabyte_mp72_hb0_catalog: BaseboardCatalogRow = BaseboardCatalogRow {
  model: GigabyteMp72Hb0,
  model_label: "Gigabyte MP72-HB0 (rev. 3.0)",
  vendor: gigabyte,
  bmc_firmware: OpenBmc,
}

// bmc_firmware is the WEAKEST field in the row above. OpenBmc is asserted from family convention
// for an Ampere Altra server baseboard and is NOT read from a vendor manual; the ASRock row earned
// its OpenBmc through authenticated live probes against srv3 and srv4, and this row has no such
// receipt. Treat it as a placeholder that a first boot replaces, not as a catalog fact.
data gigabyte_mp72_hb0_bmc_firmware_standing_note: NonEmptyStr = "BMC firmware family is convention-asserted, not observed. No MP72-HB0 has been powered by this operator."

// Vendor-page facts, independently verified 2026-08-11 against the Gigabyte product page and
// reseller listings rather than accepted from a routed review that asserted them. Every field here
// is a READING, never a measurement: no MP72-HB0 has been held, powered, or measured by this
// operator, and none is cited by any PhysicalAsset.
type BaseboardPhysicalProfile {
  model_label: NonEmptyStr
  socket_count: Nat
  max_tdp_per_socket_w: Nat
  form_factor_label: NonEmptyStr
  width_mm: Nat
  depth_mm: Nat
  dimm_slots: Nat
  max_data_rate_mt_s: Nat
  atx_24pin_count: Nat
  eps_8pin_count: Nat
  onboard_10gbe_ports: Nat
  dedicated_management_ports: Nat
  pcie_slots: Nat
}

data gigabyte_mp72_hb0_physical_profile: BaseboardPhysicalProfile = BaseboardPhysicalProfile {
  model_label: "Gigabyte MP72-HB0 (rev. 3.0)",
  socket_count: 2,
  max_tdp_per_socket_w: 250,
  form_factor_label: "E-ATX",
  width_mm: 305,
  depth_mm: 330,
  dimm_slots: 16,
  max_data_rate_mt_s: 3200,
  atx_24pin_count: 1,
  eps_8pin_count: 2,
  onboard_10gbe_ports: 2,
  dedicated_management_ports: 1,
  pcie_slots: 4,
}

data asrock_altrad8ud_1l2t_physical_profile: BaseboardPhysicalProfile = BaseboardPhysicalProfile {
  model_label: "ASRock Rack ALTRAD8UD-1L2T",
  socket_count: 1,
