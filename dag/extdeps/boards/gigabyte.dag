module extdeps.boards.gigabyte

import std.types { NonEmptyStr, List }
import std.nat { Nat }
import std.measure {
  Watt, watt, watt_count,
  Millimeter, millimeter, millimeter_count,
  SquareMillimeter, square_millimeter, square_millimeter_count,
  MegatransfersPerSecond, megatransfers_per_second,
}
import extdeps.boards.types {
  BaseboardCatalogRow,
  BaseboardPhysicalProfile,
  board_profile_power_headers_match, board_profile_area,
  board_profile_sockets_per_area_permille, board_profile_max_socket_power,
}
import extdeps.vendor.gigabyte { gigabyte }

import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.gigabyte.com/Enterprise/Server-Motherboard/MP72-HB0-rev-30"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.boards.gigabyte",
      decl_name: "gigabyte_mp72_hb0_catalog",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data gigabyte_mp72_hb0_reseller_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.shi.com/product/46338341/AMPERE-MOTHERBOARD"
  }
}

data gigabyte_mp72_hb0_marketplace_listing_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.alibaba.com/product-detail/For-Gigabyte-MP72-HB0-Ampere-Altra_1600826005324.html"
  }
}

data gigabyte_mp72_hb0_catalog: BaseboardCatalogRow = BaseboardCatalogRow {
  model: GigabyteMp72Hb0,
  model_label: "Gigabyte MP72-HB0 (rev. 3.0)",
  vendor: gigabyte,
  bmc_firmware: OpenBmc,
}

// bmc_firmware is the WEAKEST field in the row above. OpenBmc is asserted from family convention
// for an Ampere Altra server baseboard, NOT read from a vendor manual; the ASRock row earned its
// OpenBmc through authenticated live probes against srv3 and srv4, and this row has no such
// receipt. A placeholder a first boot replaces, not a catalog fact.
data gigabyte_mp72_hb0_bmc_firmware_standing_note: NonEmptyStr = "BMC firmware family is convention-asserted, not observed. No MP72-HB0 has been powered by this operator."

// Vendor-page facts, independently verified 2026-08-11 against the Gigabyte product page and
// reseller listings rather than accepted from a routed review that asserted them. Every field is a
// READING, never a measurement: no MP72-HB0 has been held, powered, or measured by this operator,
// and none is cited by any PhysicalAsset. The profile SHAPE now lives in extdeps.boards.types.
data gigabyte_mp72_hb0_physical_profile: BaseboardPhysicalProfile = BaseboardPhysicalProfile {
  model_label: "Gigabyte MP72-HB0 (rev. 3.0)",
  socket_count: 2,
  max_tdp_per_socket: watt(count: 250),
  form_factor_label: "E-ATX",
  width: millimeter(count: 305),
  depth: millimeter(count: 330),
  dimm_slots: 16,
  max_data_rate: megatransfers_per_second(count: 3200),
  atx_24pin_count: 1,
  eps_8pin_count: 2,
  onboard_10gbe_ports: 2,
  dedicated_management_ports: 1,
  pcie_slots: 4,
}

// THE ASROCK ROW MOVED TO extdeps.boards.asrock_rack on 2026-10-04, the day a second consumer
// arrived and the day the vendor manual was finally read first-party. The correction history that
// stood here (a false 24-pin reading, then a provenance that claimed a manual nobody had opened) is
// carried with the row in its own module, where the manual read now grounds it.

type BoardProcurementStanding
  = CatalogReadOnly
  | ListingObserved
  | UnitReceiptHeld

// The marketplace listing reached ListingObserved and no further on 2026-08-11. What the listing
// photograph DOES establish, read directly from the image: the silkscreen carries "GIGABYTE
// MP72-HB0 DDR4" beside the regulatory marks, and the board shows two LGA4926 sockets with white
// retention frames, sixteen DIMM slots in four banks, a 24-pin connector at the upper left, two
// 8-pin connectors along the top edge, four PCIe slots, two SlimSAS ports, one M.2 socket, and a
// rear I/O panel carrying VGA, USB, two RJ45 ports and a management port — consistent with the
// vendor profile above on every countable field.
//
// CORRECTION, recorded because it was routed to this operator as a purchase refusal: a review
// asserted the photograph shows a proprietary "MT JADE SYSTEM BOARD" silkscreen and therefore
// different inventory. Read directly, the silkscreen says MP72-HB0. The refusal as stated does not
// hold.
//
// The real caveat is duller and still binding: the image is a watermarked reseller stock
// photograph. It establishes what the listing DEPICTS, never what any unit IS, so it cannot advance
// standing past ListingObserved. Price, condition, revision, firmware, included items, and landed
// duty remain unread, and no board may enter a fleet carrier from a stock photograph.
data gigabyte_mp72_hb0_procurement_standing: BoardProcurementStanding = ListingObserved

data gigabyte_mp72_hb0_purchase_gate: List<NonEmptyStr> = [
  "timestamped photographs of the exact shipped unit, front and back, not vendor or reseller stock imagery",
  "close photograph of the model and revision label with an ordering number matching the vendor scheme",
  "both socket pin fields photographed with protective covers removed and then replaced",
  "a BMC or BIOS screen showing both processors and every populated DIMM position detected",
  "exact included-items list: I/O shield, socket covers, processors, memory, coolers, cables",
  "BIOS, BMC and CPLD versions as shipped",
  "serial number and country of origin",
  "DOA, return and warranty terms in writing",
  "declared customs description and a broker-confirmed tariff classification before payment",
]

// Landed cost is UNMODELLED and deliberately so. A routed review offered a 25 percent duty reserve
// drawn from a comparable classification, not this part's confirmed code, and quoted domestic
// prices near USD 1445 that this session has not verified. Authoring either here would launder a
// hypothesis into the catalog. The gate row above says what must be read first.
data gigabyte_mp72_hb0_landed_cost_standing_note: NonEmptyStr = "Landed cost unmodelled: no confirmed tariff classification, no verified quote, no freight or brokerage figure."
