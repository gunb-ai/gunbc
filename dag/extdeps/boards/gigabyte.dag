// The ASRock profile above is authored in THIS module rather than beside the ASRock catalog row on
// purpose and against the usual placement rule: it exists only so the two boards can be compared by
// the same shape in one place. If a second consumer ever needs it, move it to
// extdeps.boards.asrock_rack and leave a reference — do not copy it.
data asrock_profile_placement_note: NonEmptyStr = "Co-located for comparison only; migrate to extdeps.boards.asrock_rack on second consumer."

type BoardProcurementStanding
  = CatalogReadOnly
  | ListingObserved
  | UnitReceiptHeld

// The marketplace listing reached ListingObserved and no further on 2026-08-11. What the listing
// photograph DOES establish, read directly from the image: the silkscreen carries "GIGABYTE
// MP72-HB0 DDR4" beside the regulatory marks, and the board shows two LGA4926 sockets with white
// retention frames, sixteen DIMM slots in four banks, a 24-pin connector at the upper left, two
// 8-pin connectors along the top edge, four PCIe slots, two SlimSAS ports, one M.2 socket, and a
// rear I/O panel carrying VGA, USB, two RJ45 ports and a management port. Those are consistent with
// the vendor profile above on every countable field.
//
// CORRECTION, recorded because it was routed to this operator as a purchase refusal: a review
// asserted that this listing's photograph shows a proprietary "MT JADE SYSTEM BOARD" silkscreen and
// therefore depicts different inventory. Read directly, the image does not support that — the
// silkscreen says MP72-HB0. The refusal as stated does not hold.
//
// The real caveat is duller and still binding: the image is a watermarked reseller stock photograph.
// It establishes what the listing DEPICTS, never what any particular unit IS, so it cannot advance
// standing past ListingObserved. Price, condition, revision, firmware, included items, and landed
// duty remain unread, and no board may enter a fleet carrier from a stock photograph.
data gigabyte_mp72_hb0_procurement_standing: BoardProcurementStanding = ListingObserved

data gigabyte_mp72_hb0_purchase_gate: List<NonEmptyStr> = [
  "timestamped photographs of the exact shipped unit, front and back, not vendor or reseller stock imagery",
  "close photograph of the model and revision label with an ordering number matching the vendor scheme",
  "both socket pin fields photographed with protective covers removed and then replaced",
  "a BMC or BIOS screen showing both processors and every populated DIMM position detected",
  "exact included-items list: I/O shield, socket covers, processors, memory, coolers, cables",
  "BIOS, BMC and CPLD versions as shipped",
  "serial number and country of origin",
  "DOA, return and warranty terms in writing",
  "declared customs description and a broker-confirmed tariff classification before payment",
]

// Landed cost is UNMODELLED and deliberately so. A routed review offered a 25 percent duty reserve
// drawn from a comparable classification, not from this part's confirmed code, and quoted domestic
// prices near USD 1445 that this session has not verified. Authoring either as a number here would
// launder a hypothesis into the catalog. The gate row above says what must be read first.
data gigabyte_mp72_hb0_landed_cost_standing_note: NonEmptyStr = "Landed cost unmodelled: no confirmed tariff classification, no verified quote, no freight or brokerage figure."

fn board_profile_power_headers_match(a: BaseboardPhysicalProfile, b: BaseboardPhysicalProfile) -> Bool {
  a.atx_24pin_count == b.atx_24pin_count && a.eps_8pin_count == b.eps_8pin_count
}

fn board_profile_area_mm2(p: BaseboardPhysicalProfile) -> Nat {
  p.width_mm * p.depth_mm
}

fn board_profile_sockets_per_area_permille(p: BaseboardPhysicalProfile) -> Nat {
  p.socket_count * 1000000 / board_profile_area_mm2(p: p)
}

fn board_profile_max_socket_power_w(p: BaseboardPhysicalProfile) -> Nat {
  p.socket_count * p.max_tdp_per_socket_w
}
