module extdeps.boards.types

import std.bmc { BmcFirmwareFamily }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.asrockrack.com/general/productdetail.asp?Model=ALTRAD8UD-1L2T"
  }
}

type BaseboardManufacturer = | AsrockRack

type BaseboardModel = | AsrockRackAltrad8ud1l2t

fn baseboard_manufacturer(model: BaseboardModel) -> BaseboardManufacturer {
  match model {
    AsrockRackAltrad8ud1l2t => AsrockRack
  }
}
