module extdeps.boards.types

import std.types { Bool, Int, List, NonEmptyStr }
import std.nat { Nat }
import std.measure {
  Watt, watt, watt_count,
  Millimeter, millimeter_count,
  SquareMillimeter, square_millimeter, square_millimeter_count,
  MegatransfersPerSecond,
}
import extdeps.bmc.endpoint { BmcFirmwareFamily, BmcEndpoint }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.board_authority { BoardAuthorityRef }
import extdeps.standards.motherboard_mounting_location { MountingLocationId }
import extdeps.standards.motherboard_mounting_grid { StandardMountingGrid, standard_mounting_grid_locations }
import std.optional { Present, Absent }

import extdeps.external_authority { ExternalAuthority, CitedFigureStanding }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Motherboard"
  }
}

// A BOARD'S EXPANSION SLOTS, AS POSITIONS ALONG THE REAR EDGE. A slot is named by the vendor's
// designator; its position is counted in expansion-slot pitches along the rear I/O edge, so two slots
// whose positions differ by N sit N pitches apart, centre to centre. The pitch itself is not a board
// fact: it is the PCIe CEM slot width (extdeps.standards.pcie_cem cem_slot_width), and a product
// multiplies the position difference by it. The positions carry ONE standing for the whole list,
// because they are read together, from one drawing or one ruler pass; a board whose drawing gives no
// dimensions carries the read that would settle them.
type BoardExpansionSlot {
  designator: NonEmptyStr
  position: Nat
}

type BoardExpansionSlots {
  slots: List<BoardExpansionSlot>
  positions: CitedFigureStanding
}

// A vendor manual copy a board model was read from. Title and sha256 are optional: a reading
// that did not record them says so with Absent rather than carrying a placeholder.
type HeldManualRevision {
  title: NonEmptyStr?
  version_label: NonEmptyStr
  published_label: NonEmptyStr
  page_count: Nat
  sha256_hex: NonEmptyStr?
  authority: ExternalAuthority
}

type BaseboardCatalogRow {
  model: BoardAuthorityRef
  model_label: NonEmptyStr
  vendor: Vendor<Hardware>
  bmc_firmware: BmcFirmwareFamily
  onboard_ethernet_ports: OnboardEthernetPortRows
}

type ServerBaseboard {
  catalog: BaseboardCatalogRow
  bmc: BmcEndpoint
}

// The documented DIMM populations for a board. A population that is not on
// this list is not a smaller version of a supported one — it is an
// unsupported configuration whose failure proves nothing about the modules.
type DimmPopulation {
  board: BoardAuthorityRef
  slots: List<NonEmptyStr>
  authority: ExternalAuthority
}

type PopulationAdmission
  = PopulationSupported
  | PopulationUnsupported { slots: List<NonEmptyStr> }

fn slot_occurrence_count(slots: List<NonEmptyStr>, slot: NonEmptyStr) -> Int {
  fold(slots, init: 0, f: (acc, s) => if s == slot { acc + 1 } else { acc })
}

// MULTISET EQUALITY, not equal-length-plus-subset. The previous form folded
// the DOCUMENTED row over the candidate, which happens to refuse a duplicated
// candidate slot — a duplicate shrinks the candidate's distinct set, so the
// subset test fails. But it relied on an unstated precondition that no
// documented row carries a duplicate: documented ["A1","A1"] would admit
// candidate ["A1","B1"], since both documented entries are found and the
// lengths agree. No documented row has a duplicate today, so this was latent
// rather than live; comparing occurrence counts removes the precondition
// instead of leaving correctness resting on it.
fn population_slots_match(a: List<NonEmptyStr>, b: List<NonEmptyStr>) -> Bool {
  count(a) == count(b)
    && fold(
      a,
      init: true,
      f: (acc, s) => acc && (slot_occurrence_count(slots: a, slot: s) == slot_occurrence_count(slots: b, slot: s)),
    )
}

// Fail-closed: a population absent from the documented list is REFUSED rather
// than assumed workable. Testing an unsupported population and reading its
// failure as a verdict on the modules is a fabricated conclusion, and the
// original plan for this incident — "four modules, one per channel" — was
// exactly such a population.
fn admit_population(
  candidate: List<NonEmptyStr>,
  documented: List<DimmPopulation>,
) -> PopulationAdmission {
  if any(documented, p => population_slots_match(a: p.slots, b: candidate)) {
    PopulationSupported
  } else {
    PopulationUnsupported { slots: candidate }
  }
}

// A BOARD'S PHYSICAL PROFILE, the one shape two boards are compared by. Authored in
// extdeps.boards.gigabyte while it had one consumer; moved here on its second (the printed-chassis
// power feed reads the ASRock row), exactly as the co-location note there said to do. Every field
// is a READING of a vendor surface, never a measurement of a held board.
type BaseboardPhysicalProfile {
  model_label: NonEmptyStr
  socket_count: Nat
  max_tdp_per_socket: Watt
  form_factor_label: NonEmptyStr
  width: Millimeter
  depth: Millimeter
  dimm_slots: Nat
  max_data_rate: MegatransfersPerSecond
  atx_24pin_count: Nat
  eps_8pin_count: Nat
  onboard_10gbe_ports: Nat
  dedicated_management_ports: Nat
  pcie_slots: Nat
}

fn board_profile_power_headers_match(a: BaseboardPhysicalProfile, b: BaseboardPhysicalProfile) -> Bool {
  a.atx_24pin_count == b.atx_24pin_count && a.eps_8pin_count == b.eps_8pin_count
}

fn board_profile_area(p: BaseboardPhysicalProfile) -> SquareMillimeter {
  square_millimeter(count: millimeter_count(m: p.width) * millimeter_count(m: p.depth))
}

fn board_profile_sockets_per_area_permille(p: BaseboardPhysicalProfile) -> Nat {
  p.socket_count * 1000000 / square_millimeter_count(m: board_profile_area(p: p))
}

fn board_profile_max_socket_power(p: BaseboardPhysicalProfile) -> Watt {
  watt(count: p.socket_count * watt_count(w: p.max_tdp_per_socket))
}

// HOW MANY 12 V INPUTS A BOARD NEEDS POPULATED, graded by what the vendor actually said.
//
// Three arms because the vendor manual answers three different questions. Specified: the manual
// states a number for the configuration. MinimumOneStated: the manual says ANY ONE input suffices
// under its lowest-power condition and says nothing about the rule above it, so one is a floor
// and the ceiling is the consumer's derivation from connector ratings, never a vendor number.
// Unresolved: nothing read says anything, and a cable diagram may not draw a count.
type PowerInputPopulationStanding
  = PowerInputPopulationSpecified { required_inputs: Nat }
  | PowerInputMinimumOneStated { available_inputs: Nat, stated_condition: NonEmptyStr }
  | PowerInputPopulationUnresolved { available_inputs: Nat }

// A FUNCTION A BOARD PROVIDES THAT A HOST CAN COME TO DEPEND ON -- an onboard device or link, or a
// firmware behaviour -- named agnostically, so each board module can state how ITS manual says the
// function is switched off. Which functions the fleet admits is policy and lives in the consuming
// layer (gunbc.fleet.board_function_admission); this hub enumerates no product and dispatches among
// none. A new arm does not compile until every board module states its switch for it.
type BoardFunction
  = BmcManagementFunction
  | BmcGraphicsController
  | PcieErrorFirmwareFirstHandling
  | OnboardEthernetPort { port: OnboardEthernetPortRow }

// AN ONBOARD ETHERNET PORT AS ITS BOARD'S MANUAL NAMES IT: the rear-panel designator, the controller
// behind it, whether the manual states that the BMC may share the port, and how the manual says the
// port is switched off -- on the row, so the port and its switch are one fact. A shared port is one
// function serving two consumers (the host's network and the BMC's sideband), so a consumer may not
// switch it off on the host's account alone. Silence about sharing is BmcSharingNotStated, a fact
// about the manual.
type OnboardEthernetBmcSharing = BmcSharingStated | BmcSharingNotStated

type OnboardEthernetPortRow {
  designator: NonEmptyStr
  controller: NonEmptyStr
  bmc_sharing: OnboardEthernetBmcSharing
  switch: BoardFunctionSwitch
  citation: NonEmptyStr
}

// A CATALOG ROW STATES ITS BOARD'S PORTS OR SAYS THEY ARE UNREAD, so a board cannot be catalogued with
// its ports silently missing: an unread port list is a typed refusal in every plan for that board.
type OnboardEthernetPortRows
  = PortRowsStated { rows: List<OnboardEthernetPortRow> }
  | PortRowsNotRead { obligation: NonEmptyStr }

// HOW A BOARD'S HELD MANUAL SAYS A FUNCTION IS SWITCHED OFF. Silence is SwitchNotStated, a fact about
// the manual, not a claim that the board has no switch; `coarser` names a stated switch that removes
// the function only by also removing more than it (a whole-controller disable), which a consumer
// that admits the rest of that controller may not use as this function's switch.
type BoardFunctionSwitch
  = JumperSwitch { designator: NonEmptyStr, off_position: NonEmptyStr, citation: NonEmptyStr }
  | FirmwareSetupSwitch { menu: NonEmptyStr, item: NonEmptyStr, off_meaning: NonEmptyStr, citation: NonEmptyStr }
  | SwitchNotStated { coarser: NonEmptyStr? }

// Moved here from extdeps.boards.asrock_rack when the Supermicro H11SSL-i became the second board to
// need it. HoleCorrespondenceInferred is a correspondence read off a board-specific vendor figure (the
// ALTRAD8UD's section 1.4 layout, the H11SSL's Figure 2-1 "Motherboard Mounting Holes"). A vendor's
// bare form-factor claim is deliberately NOT a standing: a board labelled ATX may omit or move a
// standard hole -- the H11SSL moves J -- so a label never admits a standoff (review 5775062390).
//
// WHAT IS KNOWN about a standard location on this specific board. Every arm names its evidence
// route, so the grade is readable from the constructor rather than from prose beside it.
// Image-position estimates (used by Jade review) do not establish a location; unlike
// a correspondence to exact standard coordinates, they cannot admit a standoff.
type BoardLocationStanding
  = HoleCorrespondenceInferred
  | HolePositionEstimatedFromImage
  | HoleAbsenceExplicitlyDirected
  | HoleNotObservedInDrawing
  | HolePhysicallyConfirmedPresent
  | HolePhysicallyConfirmedAbsent

// WHY a location must stay empty. Distinct from the standing that established it.
type StandoffProhibitionCause
  = ProductSaysRemove
  | NoAdmittedBoardHole

// WHAT IS DONE at a standard location by a chassis built for this board.
type StandoffPlacementDecision
  = StandoffAdmitted
  | StandoffProhibited { cause: StandoffProhibitionCause }

// The join, and the reason the two types are worth separating: this is total, so a new standing arm
// cannot be added without deciding what a chassis does about it. FIT will add exactly that — the
// physically-confirmed arms below are unpopulated today and are the shape the measurement lands in.
fn standoff_placement(standing: BoardLocationStanding) -> StandoffPlacementDecision {
  match standing {
    HolePositionEstimatedFromImage => StandoffProhibited { cause: NoAdmittedBoardHole }
    HoleCorrespondenceInferred => StandoffAdmitted
    HolePhysicallyConfirmedPresent => StandoffAdmitted
    HoleAbsenceExplicitlyDirected => StandoffProhibited { cause: ProductSaysRemove }
    HoleNotObservedInDrawing => StandoffProhibited { cause: NoAdmittedBoardHole }
    HolePhysicallyConfirmedAbsent => StandoffProhibited { cause: NoAdmittedBoardHole }
  }
}

type BoardStandardLocationCorrespondence sole_constructor {
  location: MountingLocationId
  standing: BoardLocationStanding
}

fn board_location_correspondence(
  location: MountingLocationId,
  standing: BoardLocationStanding,
) -> BoardStandardLocationCorrespondence {
  BoardStandardLocationCorrespondence { location: location, standing: standing }
}

// A BOARD'S HOLE ROSTER, bound to the standard grid its letters are read against. The grid is part of
// the board's fact, not of whatever consumes it: pairing a correspondence with a grid at each use site
// let a microATX board be read against ATX's grid, where R, S and B have no coordinate, and the review
// emitter then admitted standoffs with no position (review 90795). So the pair is constructed once,
// in the board's module, and only through the checked constructor below, which refuses -- returns
// Absent -- unless the list is nonempty, names each letter once, and every letter resolves to exactly
// one location in the grid. A roster that exists therefore has a coordinate for every row.
// The grid is a nominal standard identity (extdeps.standards.motherboard_mounting_grid), resolved by
// that module's one total resolver, so no authored list can stand in for a standard's population.
type BoardStandardLocationRoster sole_constructor {
  grid: StandardMountingGrid
  locations: List<BoardStandardLocationCorrespondence>
}

fn board_standard_location_roster(
  grid: StandardMountingGrid,
  locations: List<BoardStandardLocationCorrespondence>,
) -> BoardStandardLocationRoster? {
  let population = standard_mounting_grid_locations(grid: grid)
  if count(locations) > 0
    && all(locations, r => count(filter(population, m => m.id == r.location)) == 1)
    && all(locations, r => count(filter(locations, x => x.location == r.location)) == 1) {
    Present { value: BoardStandardLocationRoster { grid: grid, locations: locations } }
  } else {
    Absent
  }
}
