module extdeps.boards.types

import std.types { Bool, Int, List, NonEmptyStr }
import std.nat { Nat }
import std.measure {
  Watt, watt, watt_count,
  Millimeter, millimeter_count,
  SquareMillimeter, square_millimeter, square_millimeter_count,
  MegatransfersPerSecond,
}
import extdeps.bmc.endpoint { BmcFirmwareFamily, BmcEndpoint }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Motherboard"
  }
}

// GigabyteMp72Hb0 is a CANDIDATE reference board with no fleet instance: no PhysicalAsset cites it
// and no host resolves to it. It exists so the private machine-tile carrier can compare a
// dual-socket profile against a vendor-grounded row rather than against prose. An arm with no
// instantiation carries a dissolution trigger: if no asset cites it once the procurement gate
// closes either way, delete the arm.
type BaseboardModel
  = AsrockRackAltrad8ud1l2t
  | GigabyteMp72Hb0
  | AmpereMtCollins

type BaseboardCatalogRow {
  model: BaseboardModel
  model_label: NonEmptyStr
  vendor: Vendor<Hardware>
  bmc_firmware: BmcFirmwareFamily
}

type ServerBaseboard {
  catalog: BaseboardCatalogRow
  bmc: BmcEndpoint
}

// The documented DIMM populations for a board. A population that is not on
// this list is not a smaller version of a supported one — it is an
// unsupported configuration whose failure proves nothing about the modules.
type DimmPopulation {
  board: BaseboardModel
  slots: List<NonEmptyStr>
  authority: ExternalAuthority
}

type PopulationAdmission
  = PopulationSupported
  | PopulationUnsupported { slots: List<NonEmptyStr> }

fn slot_occurrence_count(slots: List<NonEmptyStr>, slot: NonEmptyStr) -> Int {
  fold(slots, init: 0, f: (acc, s) => if s == slot { acc + 1 } else { acc })
}

// MULTISET EQUALITY, not equal-length-plus-subset. The previous form folded
// the DOCUMENTED row over the candidate, which happens to refuse a duplicated
// candidate slot — a duplicate shrinks the candidate's distinct set, so the
// subset test fails. But it relied on an unstated precondition that no
// documented row carries a duplicate: documented ["A1","A1"] would admit
// candidate ["A1","B1"], since both documented entries are found and the
// lengths agree. No documented row has a duplicate today, so this was latent
// rather than live; comparing occurrence counts removes the precondition
// instead of leaving correctness resting on it.
fn population_slots_match(a: List<NonEmptyStr>, b: List<NonEmptyStr>) -> Bool {
  count(a) == count(b)
    && fold(
      a,
      init: true,
      f: (acc, s) => acc && (slot_occurrence_count(slots: a, slot: s) == slot_occurrence_count(slots: b, slot: s)),
    )
}

// Fail-closed: a population absent from the documented list is REFUSED rather
// than assumed workable. Testing an unsupported population and reading its
// failure as a verdict on the modules is a fabricated conclusion, and the
// original plan for this incident — "four modules, one per channel" — was
// exactly such a population.
fn admit_population(
  candidate: List<NonEmptyStr>,
  documented: List<DimmPopulation>,
) -> PopulationAdmission {
  if any(documented, p => population_slots_match(a: p.slots, b: candidate)) {
    PopulationSupported
  } else {
    PopulationUnsupported { slots: candidate }
  }
}

// A BOARD'S PHYSICAL PROFILE, the one shape two boards are compared by. Authored in
// extdeps.boards.gigabyte while it had one consumer; moved here on its second (the printed-chassis
// power feed reads the ASRock row), exactly as the co-location note there said to do. Every field
// is a READING of a vendor surface, never a measurement of a held board.
type BaseboardPhysicalProfile {
  model_label: NonEmptyStr
  socket_count: Nat
  max_tdp_per_socket: Watt
  form_factor_label: NonEmptyStr
  width: Millimeter
  depth: Millimeter
  dimm_slots: Nat
  max_data_rate: MegatransfersPerSecond
  atx_24pin_count: Nat
  eps_8pin_count: Nat
  onboard_10gbe_ports: Nat
  dedicated_management_ports: Nat
  pcie_slots: Nat
}

fn board_profile_power_headers_match(a: BaseboardPhysicalProfile, b: BaseboardPhysicalProfile) -> Bool {
  a.atx_24pin_count == b.atx_24pin_count && a.eps_8pin_count == b.eps_8pin_count
}

fn board_profile_area(p: BaseboardPhysicalProfile) -> SquareMillimeter {
  square_millimeter(count: millimeter_count(m: p.width) * millimeter_count(m: p.depth))
}

fn board_profile_sockets_per_area_permille(p: BaseboardPhysicalProfile) -> Nat {
  p.socket_count * 1000000 / square_millimeter_count(m: board_profile_area(p: p))
}

fn board_profile_max_socket_power(p: BaseboardPhysicalProfile) -> Watt {
  watt(count: p.socket_count * watt_count(w: p.max_tdp_per_socket))
}

// HOW MANY 12 V INPUTS A BOARD NEEDS POPULATED, graded by what the vendor actually said.
//
// Three arms because the vendor manual answers three different questions. Specified: the manual
// states a number for the configuration. MinimumOneStated: the manual says ANY ONE input suffices
// under its lowest-power condition and says nothing about the rule above it, so one is a floor
// and the ceiling is the consumer's derivation from connector ratings, never a vendor number.
// Unresolved: nothing read says anything, and a cable diagram may not draw a count.
type PowerInputPopulationStanding
  = PowerInputPopulationSpecified { required_inputs: Nat }
  | PowerInputMinimumOneStated { available_inputs: Nat, stated_condition: NonEmptyStr }
  | PowerInputPopulationUnresolved { available_inputs: Nat }
