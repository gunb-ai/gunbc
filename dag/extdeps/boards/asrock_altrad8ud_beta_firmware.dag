    listed_on: 1776124800000,
    packages: [
      AsrockBetaFirmwarePackage { image_kind: InstantFlashRom, displayed_size: "5.11MB" },
      AsrockBetaFirmwarePackage { image_kind: OpenBmcWebUiTar, displayed_size: "5.11MB" },
    ],
    description: "Updated RC to 0ACRB_022",
  },
  AsrockAltrad8udBetaFirmwareListing {
    target: BmcController,
