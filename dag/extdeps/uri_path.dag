module extdeps.uri_path

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.http_path { PathTemplate, UrlPathToken, LiteralToken, ParamToken, PathParamBinding }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc3986#section-3.3"
  }
}

type PathSegmentTokensResult
  = ParsedSegmentTokens { tokens: List<UrlPathToken> }
  | MalformedPathSegment { segment: String, reason: String }

type PathTemplateParseResult
  = ParsedPathTemplate { template: PathTemplate }
  | MalformedPathTemplate { raw: String, segment: String, reason: String }

fn parse_segment_tokens(seg: String) -> PathSegmentTokensResult {
  if !(seg |> contains("{")) {
    if seg |> contains("}") {
      MalformedPathSegment { segment: seg, reason: "stray closing brace" }
    } else {
      ParsedSegmentTokens { tokens: [LiteralToken { text: seg }] }
    }
  } else {
    let before_and_rest = seg |> split(delimiter: "{")
    if count(before_and_rest) != 2 {
      return MalformedPathSegment { segment: seg, reason: "multiple opening braces in one segment" }
    }

    let prefix = match before_and_rest |> first {
      Present { value: p } => p
      Absent => return MalformedPathSegment { segment: seg, reason: "internal: missing prefix after opening-brace split" }
    }
    let after_open = match before_and_rest |> skip(1) |> first {
      Present { value: r } => r
      Absent => return MalformedPathSegment { segment: seg, reason: "internal: missing tail after opening-brace split" }
    }
    let name_and_suffix = after_open |> split(delimiter: "}")
    if prefix |> contains("}") || count(name_and_suffix) != 2 {
      return MalformedPathSegment { segment: seg, reason: "missing closing brace or extra closing brace" }
    }
    let param_name = match name_and_suffix |> first {
      Present { value: p } => p
      Absent => return MalformedPathSegment { segment: seg, reason: "internal: missing parameter name after closing-brace split" }
    }
    let suffix = match name_and_suffix |> skip(1) |> first {
      Present { value: s } => s
      Absent => return MalformedPathSegment { segment: seg, reason: "internal: missing suffix after closing-brace split" }
    }
    let prefix_tokens = if prefix != "" {
      [LiteralToken { text: prefix }]
    } else { [] }
    let param_tokens = if param_name != "" {
      [ParamToken { name: param_name }]
    } else { [] }
    let suffix_tokens = if suffix != "" {
      [LiteralToken { text: suffix }]
    } else { [] }
    if param_name == "" || suffix |> contains("{") || suffix |> contains("}") {
      MalformedPathSegment { segment: seg, reason: "invalid parameter segment structure" }
    } else {
      ParsedSegmentTokens { tokens: concat(prefix_tokens, param_tokens, suffix_tokens) }
    }
  }
}

type PathTemplateMatch
  = PathMatched { params: List<PathParamBinding> }
  | PathNotMatched

data match_path_template_note: String = "The FORWARD reading of the same PathTemplate rows gunbc.node_http_server_emit.emit_path_template_regex_source reads BACKWARD into a JS regex, and std.http_path.render_path_template reads backward into a rendered path — three directions, one row set, never parallel authorities (DESIGN 4); the binding record is std.http_path.PathParamBinding, the single binding authority (a local duplicate here briefly shadowed it and broke no-import name resolution for test.claim.uri_path_parse_witness — the §3 nickname caught by execution). Parity contract with the emitted regex, kept strict so the two realizations agree on every input: one token = one path segment joined by '/' (LiteralToken == segment text; ParamToken binds any NON-EMPTY segment, the [^/]+ class); the empty template matches exactly the root path '/'; a trailing slash is a mismatch (the regex anchors with $); an interior empty segment ('//') never matches any token (a Literal is never empty by parse construction, a Param requires non-empty). Query strings are stripped before matching, mirroring parse_path_template's own '?' strip."

fn match_path_segments(path_only: String) -> List<String> {
  if path_only == "/" || path_only == "" {
    []
  } else {
    let raw_segs = path_only |> split(delimiter: "/")
    match raw_segs |> first {
      Present { value: lead } =>
        if lead == "" { raw_segs |> skip(1) } else { raw_segs }
      Absent => raw_segs
    }
  }
}

fn match_path_tokens(tokens: List<UrlPathToken>, segs: List<String>) -> PathTemplateMatch {
  match tokens |> first {
    Absent =>
      match segs |> first {
        Absent => PathMatched { params: [] }
        Present { value: _ } => PathNotMatched
      }
    Present { value: tok } =>
      match segs |> first {
        Absent => PathNotMatched
        Present { value: seg } =>
          match match_path_tokens(tokens: tokens |> skip(1), segs: segs |> skip(1)) {
            PathNotMatched => PathNotMatched
            PathMatched { params: ps } =>
              match tok {
                LiteralToken { text: t } =>
                  if t == seg { PathMatched { params: ps } } else { PathNotMatched }
                ParamToken { name: n } =>
                  if seg == "" {
                    PathNotMatched
                  } else {
                    PathMatched { params: concat([PathParamBinding { name: n, value: seg }], ps) }
                  }
              }
          }
      }
  }
}

fn match_path_template(template: PathTemplate, path: String) -> PathTemplateMatch {
  let path_only = match path |> split(delimiter: "?") |> first {
    Present { value: p } => p
    Absent => path
  }
  match_path_tokens(tokens: template.tokens, segs: match_path_segments(path_only: path_only))
}

fn parse_path_template(raw: String) -> PathTemplateParseResult {
  let path_only = match raw |> split(delimiter: "?") |> first {
    Present { value: p } => p
    Absent => raw
  }
  let segments = path_only |> split(delimiter: "/") |> filter(s => s != "")
  match segments |> first {
    Absent => ParsedPathTemplate { template: PathTemplate { tokens: [] } }
    Present { value: first_seg } =>
      match parse_segment_tokens(seg: first_seg) {
        MalformedPathSegment { segment: s, reason: r } =>
          MalformedPathTemplate { raw: raw, segment: s, reason: r }
        ParsedSegmentTokens { tokens: first_tokens } => {
          let parsed = fold(segments |> skip(1),
            init: ParsedPathTemplate { template: PathTemplate { tokens: first_tokens } },
            f: (acc, seg) => match acc {
              MalformedPathTemplate => acc
              ParsedPathTemplate { template: path } =>
                match parse_segment_tokens(seg: seg) {
                  MalformedPathSegment { segment: s, reason: r } =>
                    MalformedPathTemplate { raw: raw, segment: s, reason: r }
                  ParsedSegmentTokens { tokens: seg_tokens } =>
                    ParsedPathTemplate {
                      template: PathTemplate { tokens: concat(path.tokens, seg_tokens) }
                    }
                }
            }
          )
          parsed
        }
      }
  }
}

data uri_query_param_note: String = "Query-string parsing, the URI concern's single home (§3) — mirror of the '?' strip match_path_template/parse_path_template already do. uri_query_string returns everything after the first '?' (empty if none); uri_query_param returns the value for a key over the '&'-separated 'k=v' pairs (empty if the key is absent). Kept minimal: no percent-decoding yet (the one consumer, the /sandbox/echo status label, is an ASCII enum), so a decode pass is a named follow-on when a consumer needs it."

fn uri_query_string(path: String) -> String {
  match path |> split(delimiter: "?") |> skip(1) |> first {
    Present { value: q } => q
    Absent => ""
  }
}

fn uri_query_param(path: String, key: String) -> String {
  let pairs = uri_query_string(path: path) |> split(delimiter: "&")
  fold(pairs, init: "", f: (acc, pair) => {
    let k = match pair |> split(delimiter: "=") |> first {
      Present { value: x } => x
      Absent => ""
    }
    let v = match pair |> split(delimiter: "=") |> skip(1) |> first {
      Present { value: x } => x
      Absent => ""
    }
    if k == key { v } else { acc }
  })
}
