module extdeps.languages.css.values

import std.types { Int, String, Bool, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.w3.org/TR/css-values-4"
  }
}

data css_length_note: String = "Cited upstream: W3C CSS Values and Units Module Level 4. A <length> is a magnitude PLUS a unit (section 6 Distance Units): px an absolute unit, rem and ch font-relative units — so a length literal like \"4px\" is a SERIALIZATION of that structure (DESIGN section 2, decompress the string), never the stored fact. The zero-length rule (section 6.2: for a zero length the unit identifier is optional) is why css_length_wire renders a zero magnitude as bare \"0\" regardless of unit — grounded spec behavior, not a special case, and the reason authored \"0\" round-trips byte-exact. <percentage> (section 5) rides the same wire for the register's dimension needs. Forward reading (parsing a CSS value through these rows) is the NAMED later direction (DESIGN section 4, one grammar both ways), not built here."

type CssLengthUnit
  = Px
  | Rem
  | Ch
  | Percent

fn css_length_unit_token(u: CssLengthUnit) -> String {
  match u {
    Px => "px"
    Rem => "rem"
    Ch => "ch"
    Percent => "%"
  }
}

type CssLength {
  n: Int
  unit: CssLengthUnit
}

fn css_length_wire(l: CssLength) -> String {
  if l.n == 0 {
    "0"
  } else {
    join([to_string(l.n), css_length_unit_token(u: l.unit)], "")
  }
}

fn css_px(n: Int) -> CssLength {
  CssLength { n: n, unit: Px }
}

fn css_ch(n: Int) -> CssLength {
  CssLength { n: n, unit: Ch }
}

data css_font_family_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.w3.org/TR/css-fonts-4/#font-family-prop"
  }
}

data css_font_family_note: String = "Cited upstream: W3C CSS Fonts Module Level 4, font-family property. A font-family value is a LIST of families: quoted <family-name> strings (NamedFamily, e.g. 'Noto Sans') and bare <generic-family> keywords (GenericFamily: serif/sans-serif/monospace/cursive/fantasy/system-ui), joined by \", \". The stringly \"'Noto Sans', system-ui, sans-serif\" is the serialization of this list, decompressed here (DESIGN section 2)."

type CssGenericFamily
  = GenericSerif
  | GenericSansSerif
  | GenericMonospace
  | GenericCursive
  | GenericFantasy
  | GenericSystemUi

fn css_generic_family_token(g: CssGenericFamily) -> String {
  match g {
    GenericSerif => "serif"
    GenericSansSerif => "sans-serif"
    GenericMonospace => "monospace"
    GenericCursive => "cursive"
    GenericFantasy => "fantasy"
    GenericSystemUi => "system-ui"
  }
}

type CssFontFamily
  = NamedFamily { name: String }
  | GenericFamily { kind: CssGenericFamily }

fn css_font_family_wire(f: CssFontFamily) -> String {
  match f {
    NamedFamily { name: n } => join(["'", n, "'"], "")
    GenericFamily { kind: g } => css_generic_family_token(g: g)
  }
}

type CssFontStack {
  families: List<CssFontFamily>
}

fn css_font_stack_wire(s: CssFontStack) -> String {
  join(map(s.families, f => css_font_family_wire(f: f)), ", ")
}
