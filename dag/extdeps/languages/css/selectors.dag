module extdeps.languages.css.selectors

import std.types { String, Bool, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.w3.org/TR/selectors-4"
  }
}

// Cited upstream: W3C Selectors Level 4. The BOUNDED grain (D5): a rule's subject is a typed
// SelectorSubject, not a raw string inside an otherwise-typed rule. Three modeled shapes cover the
// register's simple subjects — ClassSelector (a single .class), ElementSelector (a type/tag
// selector), PseudoSuffix (a compound of a base selector and one pseudo-class, e.g. a:hover) — and
// RawSelector is the COUNTED frontier for everything else (descendant combinators like
// '.frontier-bucket h2', compound type.class like 'li.node', functional pseudo-classes like
// :not()/:is(), the universal '*'). :root is NOT in that residue: it is a pseudo-class with no
// base, which PseudoSuffix already models — see root_selector below. RawSelector carries the exact text so emission is
// byte-identical, and its COUNT is the honest residue number: the fraction of the register still
// expressed as raw selector text. dissolve_on: the combinator / compound / functional-pseudo
// grammar lands (Selectors 4 has the structure — descendant/child combinators, compound selectors,
// :not()/:is()), at which point each RawSelector row migrates to a modeled shape and the count
// falls. The full CSS VALUE grammar (decl right-hand sides) stays a separate named arc, out of
// scope.

type SelectorSubject
  = ClassSelector { name: String }
  | ElementSelector { tag: String }
  | PseudoSuffix { base: String, pseudo: String }
  | RawSelector { text: String }

// The document root, ONCE. Selectors Level 4 §13.1 (#the-root-pseudo) defines :root as a
// pseudo-class matching the root element, with the same specificity as a type selector — and
// that specificity is load-bearing for more than one layer: gunbc.site.gunb_ai_tokens emits the
// unconditional custom properties on it, and gunbc.site.gunb_ai_layout's light variant emits its
// @media (prefers-color-scheme: light) override on the SAME subject, so the override wins purely
// by coming later in the sheet. That argument only holds if both sides genuinely name the same
// selector; two hand-typed PseudoSuffix rows that happen to match today can drift apart
// tomorrow and silently make light mode unwinnable. One row, both readers.
data root_selector: SelectorSubject = PseudoSuffix { base: "", pseudo: "root" }

fn selector_subject_wire(s: SelectorSubject) -> String {
  match s {
    ClassSelector { name: n } => join([".", n], "")
    ElementSelector { tag: t } => t
    PseudoSuffix { base: b, pseudo: p } => join([b, ":", p], "")
    RawSelector { text: t } => t
  }
}

fn selector_subject_is_raw(s: SelectorSubject) -> Bool {
  match s {
    ClassSelector { name: _ } => false
    ElementSelector { tag: _ } => false
    PseudoSuffix { base: _, pseudo: _ } => false
    RawSelector { text: _ } => true
  }
}

fn raw_selector_count(subjects: List<SelectorSubject>) -> Int {
  fold(subjects, init: 0, f: (acc, s) => if selector_subject_is_raw(s: s) { acc + 1 } else { acc })
}
