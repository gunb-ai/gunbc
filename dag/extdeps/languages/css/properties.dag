module extdeps.languages.css.properties

import std.types { String, Bool, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.w3.org/Style/CSS/all-properties.en.html"
  }
}

// Cited upstream: the W3C CSS property index (the union of the CSS module specs — box, fonts,
// flexbox, backgrounds-and-borders, ...). This is the BOUNDED grain (D5): CssPropertyName
// enumerates EXACTLY the properties the register emits today (upstream spellings), so a property
// name is a typed row, not a raw string inside an otherwise-typed rule — a misspelled property is
// unwritable for the modeled set. Deliberately NOT the whole CSS property ocean (DESIGN section 6,
// priced by displaced cost, not completeness). Two honest escapes: CustomProperty carries a
// --custom-property author-defined name (CSS Custom Properties / cascading variables, the register's
// token/theme vars — an open namespace, correctly not enumerable); RawProperty is a COUNTED frontier
// for a name outside the modeled set (today: the single non-standard 'code-spacing' in the accent
// study — a flag that its name is unmodeled or invalid, dissolving as the set grows or the site lane
// fixes it). The full CSS VALUE grammar (a decl's right-hand side) stays a named arc, out of scope.

type CssPropertyName
  = AlignItems
  | Animation
  | AnimationDelay
  | AnimationDuration
  | TransformOrigin
  | WebkitFontSmoothing
  | WebkitOverflowScrolling
  | Background
  | Border
  | BorderBottom
  | BorderBottomColor
  | BorderCollapse
  | BorderColor
  | BorderLeft
  | BorderRadius
  | BorderStyle
  | BorderTop
  | BoxShadow
  | BoxSizing
  | ClipPath
  | Color
  | ColorScheme
  | Content
  | Cursor
  | Display
  | Fill
  | FillOpacity
  | Flex
  | FlexBasis
  | FlexDirection
  | FlexWrap
  | FontFamily
  | FontSize
  | FontStyle
  | FontVariantNumeric
  | FontWeight
  | Gap
  | GridArea
  | GridColumn
  | GridTemplateColumns
  | Height
  | Inset
  | JustifyContent
  | LetterSpacing
  | LineHeight
  | ListStyle
  | Margin
  | MarginBottom
  | MarginInline
  | MarginLeft
  | MarginRight
  | MarginTop
  | MaxHeight
  | MaxWidth
  | MinHeight
  | MinWidth
  | Opacity
  | Outline
  | OutlineOffset
  | Overflow
  | OverflowX
  | ScrollSnapAlign
  | ScrollSnapType
  | ScrollbarWidth
  | Padding
  | PaddingBlock
  | PaddingBottom
  | PaddingLeft
  | PaddingTop
  | Position
  | Stroke
  | StrokeDasharray
  | StrokeLinecap
  | StrokeLinejoin
  | StrokeOpacity
  | StrokeWidth
  | TextAlign
  | TextDecoration
  | TextOverflow
  | TextTransform
  | TextWrap
  | Transform
  | Transition
  | UserSelect
  | VerticalAlign
  | WhiteSpace
  | Width
  | CustomProperty { name: String }
  | RawProperty { name: String }

fn css_property_wire(p: CssPropertyName) -> String {
  match p {
    AlignItems => "align-items"
    Animation => "animation"
    AnimationDelay => "animation-delay"
    AnimationDuration => "animation-duration"
    TransformOrigin => "transform-origin"
    WebkitFontSmoothing => "-webkit-font-smoothing"
    WebkitOverflowScrolling => "-webkit-overflow-scrolling"
    Background => "background"
    Border => "border"
    BorderBottom => "border-bottom"
    BorderBottomColor => "border-bottom-color"
    BorderCollapse => "border-collapse"
    BorderColor => "border-color"
    BorderLeft => "border-left"
    BorderRadius => "border-radius"
    BorderStyle => "border-style"
    BorderTop => "border-top"
    BoxShadow => "box-shadow"
    BoxSizing => "box-sizing"
    ClipPath => "clip-path"
    Color => "color"
    ColorScheme => "color-scheme"
    Content => "content"
    Cursor => "cursor"
    Display => "display"
    Fill => "fill"
    FillOpacity => "fill-opacity"
    Flex => "flex"
    FlexBasis => "flex-basis"
    FlexDirection => "flex-direction"
    FlexWrap => "flex-wrap"
    FontFamily => "font-family"
    FontSize => "font-size"
    FontStyle => "font-style"
    FontVariantNumeric => "font-variant-numeric"
    FontWeight => "font-weight"
    Gap => "gap"
    GridArea => "grid-area"
    GridColumn => "grid-column"
    GridTemplateColumns => "grid-template-columns"
    Height => "height"
    Inset => "inset"
    JustifyContent => "justify-content"
    LetterSpacing => "letter-spacing"
    LineHeight => "line-height"
    ListStyle => "list-style"
    Margin => "margin"
    MarginBottom => "margin-bottom"
    MarginInline => "margin-inline"
    MarginLeft => "margin-left"
    MarginRight => "margin-right"
    MarginTop => "margin-top"
    MaxHeight => "max-height"
    MaxWidth => "max-width"
    MinHeight => "min-height"
    MinWidth => "min-width"
    Opacity => "opacity"
    Outline => "outline"
    OutlineOffset => "outline-offset"
    Overflow => "overflow"
    OverflowX => "overflow-x"
    ScrollSnapAlign => "scroll-snap-align"
    ScrollSnapType => "scroll-snap-type"
    ScrollbarWidth => "scrollbar-width"
    Padding => "padding"
    PaddingBlock => "padding-block"
    PaddingBottom => "padding-bottom"
    PaddingLeft => "padding-left"
    PaddingTop => "padding-top"
    Position => "position"
    Stroke => "stroke"
    StrokeDasharray => "stroke-dasharray"
    StrokeLinecap => "stroke-linecap"
    StrokeLinejoin => "stroke-linejoin"
    StrokeOpacity => "stroke-opacity"
    StrokeWidth => "stroke-width"
    TextAlign => "text-align"
    TextDecoration => "text-decoration"
    TextOverflow => "text-overflow"
    TextTransform => "text-transform"
    TextWrap => "text-wrap"
    Transform => "transform"
    Transition => "transition"
    UserSelect => "user-select"
    VerticalAlign => "vertical-align"
    WhiteSpace => "white-space"
    Width => "width"
    CustomProperty { name: n } => join(["--", n], "")
    RawProperty { name: n } => n
  }
}
