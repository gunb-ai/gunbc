module extdeps.languages.ptx.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https,
    locator: "docs.nvidia.com/cuda/parallel-thread-execution/"
  }
}

data ptx_language_subject_note: String = "PTX, cited to the NVIDIA Parallel Thread Execution ISA (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched document is titled 'Parallel Thread Execution ISA Version 9.3', published by NVIDIA, and describes PTX as 'a low-level parallel thread execution virtual machine and instruction set architecture' that is 'a stable ISA that spans multiple GPU generations'. PTX is a VIRTUAL ISA translated at install time to a target-specific instruction set, which is why it is a language-target subject here and not a machine architecture subject — the physical GPU ISA it lowers to is a different upstream fact."

type Ptx
  = | PtxTarget

data ptx_language: Ptx = PtxTarget

data ptx_language_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.languages.ptx.subject",
      decl_name: "ptx_language",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = ptx_language_model_scope
