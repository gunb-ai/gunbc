module extdeps.languages.riscv.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "riscv.org/technical/specifications/"
  }
}

data riscv_isa_further_authority_1: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "docs.riscv.org/"
  }
}

data riscv_isa_subject_note: String = "THE RISC-V ISA, cited to RISC-V International (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched page states the specifications are 'collaboratively developed, ratified, and maintained by contributing members of RISC-V International' and lists 'The RISC-V Instruction Set Manual, Volume I' (unprivileged/user-level ISA) and 'Volume II: Privileged Architecture', available through the ratified specification library at docs.riscv.org. WHY THIS SUBJECT EXISTS ALONE AMONG THE THREE ISAs: v2.extdeps.languages.machine_code carries one Isa coproduct with three arms — X86_64Isa, Aarch64Isa, RiscV64Isa — which are three independently governed upstreams fused into one surface, the exact shape DESIGN section 3 forbids a generic hub from taking. RISC-V is registered because its specification authority verified; x86-64 and Aarch64 are NOT registered because their authorities refused this fetch, and that refusal is recorded rather than papered over with a plausible locator."

type RiscV
  = | RiscVTarget

data riscv_isa: RiscV = RiscVTarget

data riscv_isa_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.languages.riscv.subject",
      decl_name: "riscv_isa",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.languages.riscv.subject.extdeps_external_authority_anchor,
  further_citations: [riscv_isa_further_authority_1]
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = riscv_isa_model_scope
