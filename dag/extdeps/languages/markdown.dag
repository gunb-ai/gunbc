module extdeps.languages.markdown


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "spec.commonmark.org/0.31.2/"
  }
}

type MarkdownSpellings {
  heading_marker: String
  heading_sep: String
  unordered_bullet: String
  ordered_suffix: String
  task_checked: String
  task_unchecked: String
  emphasis_delim: String
  strong_delim: String
  code_span_delim: String
  code_fence: String
  link_text_open: String
  link_text_close: String
  link_url_open: String
  link_url_close: String
  image_marker: String
  table_pipe: String
  table_cell_pad: String
  table_align_none: String
  table_align_left: String
  table_align_center: String
  table_align_right: String
  blockquote_marker: String
  list_indent: String
  block_separator: String
  thematic_break: String
}

data commonmark_gfm_spellings: extdeps.languages.markdown.MarkdownSpellings = {
  heading_marker: "#",
  heading_sep: " ",
  unordered_bullet: "- ",
  ordered_suffix: ". ",
  task_checked: "[x] ",
  task_unchecked: "[ ] ",
  emphasis_delim: "*",
  strong_delim: "**",
  code_span_delim: "`",
  code_fence: "```",
  link_text_open: "[",
  link_text_close: "]",
  link_url_open: "(",
  link_url_close: ")",
  image_marker: "!",
  table_pipe: "|",
  table_cell_pad: " ",
  table_align_none: "---",
  table_align_left: ":--",
  table_align_center: ":-:",
  table_align_right: "--:",
  blockquote_marker: "> ",
  list_indent: "  ",
  block_separator: "\n\n",
  thematic_break: "---",
}

fn md_link_form(text: String, url: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  join(
    [sp.link_text_open, text, sp.link_text_close, sp.link_url_open, url, sp.link_url_close],
    ""
  )
}

fn markdown_markup_medium(sp: extdeps.languages.markdown.MarkdownSpellings) -> std.markup.MarkupMedium {
  std.markup.MarkupMedium {
    tag_overrides: [
      std.markup.TagDelimiter { tag: "em", open: sp.emphasis_delim, close: sp.emphasis_delim },
      std.markup.TagDelimiter { tag: "strong", open: sp.strong_delim, close: sp.strong_delim },
      std.markup.TagDelimiter { tag: "code", open: sp.code_span_delim, close: sp.code_span_delim },
    ],
    bracket: canonical_html_spellings,
    text_escape: EscapeRaw,
    void_tags: [],
    void_rendering: OmitClose,
    raw_text_tags: [],
  }
}

fn md_inline_to_fragment(inline: std.markdown.MarkdownInline, sp: extdeps.languages.markdown.MarkdownSpellings) -> std.markup.Fragment {
  match inline {
    TextInline { text } =>
      std.markup.FragmentText { content: text }
    EmphasisInline { inlines } =>
      extdeps.browser.Element { tag: "em", attributes: [], children: md_inlines_to_fragments(inlines: inlines, sp: sp) }
    StrongInline { inlines } =>
      extdeps.browser.Element { tag: "strong", attributes: [], children: md_inlines_to_fragments(inlines: inlines, sp: sp) }
    CodeInline { text } =>
      extdeps.browser.Element { tag: "code", attributes: [], children: [ std.markup.FragmentText { content: text } ] }
    LinkInline { inlines, url } =>
      std.markup.RawNode { content: md_link_form(text: md_render_inlines(inlines: inlines, sp: sp), url: url, sp: sp) }
    ImageInline { alt, url } =>
      std.markup.RawNode { content: join([sp.image_marker, md_link_form(text: alt, url: url, sp: sp)], "") }
  }
}

fn md_inlines_to_fragments(inlines: List<std.markdown.MarkdownInline>, sp: extdeps.languages.markdown.MarkdownSpellings) -> List<std.markup.Fragment> {
  map(inlines, i => md_inline_to_fragment(inline: i, sp: sp))
}

fn md_render_inlines(inlines: List<std.markdown.MarkdownInline>, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  fold(
    md_inlines_to_fragments(inlines: inlines, sp: sp),
    init: "",
    f: (acc, fr) => concat(acc, serialize_fragment_with(frag: fr, medium: markdown_markup_medium(sp: sp)))
  )
}

fn md_item(marker: String, blocks: List<std.markdown.MarkdownBlock>, sp: extdeps.languages.markdown.MarkdownSpellings, depth: Int) -> String {
  let pad = repeat_string(s: sp.list_indent, n: depth)
  fold(blocks, init: { idx: 0, out: "" }, f: (acc, b) => {
    if acc.idx == 0 {
      let lead = match b {
        ParagraphBlock { inlines } =>
          join([pad, marker, md_render_inlines(inlines: inlines, sp: sp)], "")
        _ =>
          join([pad, marker, md_block(block: b, sp: sp)], "")
      }
      { idx: 1, out: lead }
    } else {
      let cont = match b {
        UnorderedListBlock { items: _ } => concat("\n", md_nested(block: b, sp: sp, depth: depth + 1))
        OrderedListBlock { items: _ } => concat("\n", md_nested(block: b, sp: sp, depth: depth + 1))
        TaskListBlock { items: _ } => concat("\n", md_nested(block: b, sp: sp, depth: depth + 1))
        HeadingBlock { level: _, inlines: _ } => concat("\n\n", concat(repeat_string(s: sp.list_indent, n: depth + 1), md_block(block: b, sp: sp)))
        ParagraphBlock { inlines: _ } => concat("\n\n", concat(repeat_string(s: sp.list_indent, n: depth + 1), md_block(block: b, sp: sp)))
        CodeBlock { code: _ } => concat("\n\n", concat(repeat_string(s: sp.list_indent, n: depth + 1), md_block(block: b, sp: sp)))
        TableBlock { header: _, alignments: _, rows: _ } => concat("\n\n", concat(repeat_string(s: sp.list_indent, n: depth + 1), md_block(block: b, sp: sp)))
        BlockquoteBlock { blocks: _ } => concat("\n\n", concat(repeat_string(s: sp.list_indent, n: depth + 1), md_block(block: b, sp: sp)))
        ThematicBreak => concat("\n\n", concat(repeat_string(s: sp.list_indent, n: depth + 1), md_block(block: b, sp: sp)))
      }
      { idx: acc.idx + 1, out: concat(acc.out, cont) }
    }
  }).out
}

fn md_unordered(items: List<std.markdown.MarkdownListItem>, sp: extdeps.languages.markdown.MarkdownSpellings, depth: Int) -> String {
  join(map(items, it => md_item(marker: sp.unordered_bullet, blocks: it.blocks, sp: sp, depth: depth)), "\n")
}

fn md_ordered(items: List<std.markdown.MarkdownListItem>, sp: extdeps.languages.markdown.MarkdownSpellings, depth: Int) -> String {
  fold(items, init: { n: 1, out: "" }, f: (acc, it) => {
    let marker = concat(to_string(acc.n), sp.ordered_suffix)
    let line = md_item(marker: marker, blocks: it.blocks, sp: sp, depth: depth)
    {
      n: acc.n + 1,
      out: if acc.out == "" { line } else { concat(acc.out, concat("\n", line)) }
    }
  }).out
}

fn md_task_box(state: std.markdown.CheckboxState, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  match state {
    Checked => sp.task_checked
    Unchecked => sp.task_unchecked
  }
}

fn md_tasklist(items: List<std.markdown.MarkdownTaskItem>, sp: extdeps.languages.markdown.MarkdownSpellings, depth: Int) -> String {
  join(map(items, it => {
    let marker = concat(sp.unordered_bullet, md_task_box(state: it.state, sp: sp))
    md_item(marker: marker, blocks: it.blocks, sp: sp, depth: depth)
  }), "\n")
}

fn md_nested(block: std.markdown.MarkdownBlock, sp: extdeps.languages.markdown.MarkdownSpellings, depth: Int) -> String {
  match block {
    UnorderedListBlock { items } => md_unordered(items: items, sp: sp, depth: depth)
    OrderedListBlock { items } => md_ordered(items: items, sp: sp, depth: depth)
    TaskListBlock { items } => md_tasklist(items: items, sp: sp, depth: depth)
    _ => md_block(block: block, sp: sp)
  }
}

fn md_table_cell(cell: std.markdown.MarkdownTableCell, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  md_render_inlines(inlines: cell.inlines, sp: sp)
}

fn md_table_row(row: std.markdown.MarkdownTableRow, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  fold(row.cells, init: sp.table_pipe, f: (acc, c) =>
    join([acc, sp.table_cell_pad, md_table_cell(cell: c, sp: sp), sp.table_cell_pad, sp.table_pipe], ""))
}

fn md_align_cell(a: std.markdown.MarkdownAlignment, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  match a {
    AlignNone => sp.table_align_none
    AlignLeft => sp.table_align_left
    AlignCenter => sp.table_align_center
    AlignRight => sp.table_align_right
  }
}

fn md_table_delim(alignments: List<std.markdown.MarkdownAlignment>, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  fold(alignments, init: sp.table_pipe, f: (acc, a) =>
    join([acc, sp.table_cell_pad, md_align_cell(a: a, sp: sp), sp.table_cell_pad, sp.table_pipe], ""))
}

fn md_table(
  header: std.markdown.MarkdownTableRow,
  alignments: List<std.markdown.MarkdownAlignment>,
  rows: List<std.markdown.MarkdownTableRow>,
  sp: extdeps.languages.markdown.MarkdownSpellings
) -> String {
  let head = md_table_row(row: header, sp: sp)
  let delim = md_table_delim(alignments: alignments, sp: sp)
  let body = join(map(rows, r => md_table_row(row: r, sp: sp)), "\n")
  if body == "" {
    join([head, "\n", delim], "")
  } else {
    join([head, "\n", delim, "\n", body], "")
  }
}

fn md_prefix_lines(text: String, prefix: String) -> String {
  join(map(split(s: text, delimiter: "\n"), line => concat(prefix, line)), "\n")
}

fn md_blockquote(blocks: List<std.markdown.MarkdownBlock>, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  let inner = join(map(blocks, b => md_block(block: b, sp: sp)), "\n")
  md_prefix_lines(text: inner, prefix: sp.blockquote_marker)
}

fn heading_level_to_int(level: std.markdown.HeadingLevel) -> Int {
  match level {
    H1 => 1
    H2 => 2
    H3 => 3
    H4 => 4
    H5 => 5
    H6 => 6
  }
}

fn md_code_block(code: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  if ends_with(s: code, suffix: "\n") {
    join([sp.code_fence, "\n", code, sp.code_fence], "")
  } else {
    join([sp.code_fence, "\n", code, "\n", sp.code_fence], "")
  }
}

fn md_block(block: std.markdown.MarkdownBlock, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  match block {
    HeadingBlock { level, inlines } =>
      join([
        repeat_string(s: sp.heading_marker, n: heading_level_to_int(level: level)),
        sp.heading_sep,
        md_render_inlines(inlines: inlines, sp: sp)
      ], "")
    ParagraphBlock { inlines } =>
      md_render_inlines(inlines: inlines, sp: sp)
    UnorderedListBlock { items } =>
      md_unordered(items: items, sp: sp, depth: 0)
    OrderedListBlock { items } =>
      md_ordered(items: items, sp: sp, depth: 0)
    TaskListBlock { items } =>
      md_tasklist(items: items, sp: sp, depth: 0)
    CodeBlock { code } =>
      md_code_block(code: code, sp: sp)
    TableBlock { header, alignments, rows } =>
      md_table(header: header, alignments: alignments, rows: rows, sp: sp)
    BlockquoteBlock { blocks } =>
      md_blockquote(blocks: blocks, sp: sp)
    ThematicBreak =>
      sp.thematic_break
  }
}

fn serialize_markdown_source_with(doc: std.markdown.MarkdownDocument, sp: extdeps.languages.markdown.MarkdownSpellings) -> String {
  concat(
    join(map(doc.blocks, b => md_block(block: b, sp: sp)), sp.block_separator),
    "\n"
  )
}

fn serialize_markdown_source(doc: std.markdown.MarkdownDocument) -> String {
  serialize_markdown_source_with(doc: doc, sp: commonmark_gfm_spellings)
}

type RepeatStrip { count: Int, rest: String }

fn int_to_heading_level(n: Int) -> std.markdown.HeadingLevel {
  if n == 1 { H1 }
  else if n == 2 { H2 }
  else if n == 3 { H3 }
  else if n == 4 { H4 }
  else if n == 5 { H5 }
  else { H6 }
}

fn md_drop_prefix(s: String, prefix: String) -> String {
  substring(s: s, start: prefix.length(), end: s.length())
}

fn md_strip_repeated(s: String, unit: String, n: Int) -> extdeps.languages.markdown.RepeatStrip {
  if (unit != "") && starts_with(s: s, prefix: unit) {
    md_strip_repeated(s: md_drop_prefix(s: s, prefix: unit), unit: unit, n: n + 1)
  } else {
    RepeatStrip { count: n, rest: s }
  }
}

fn md_is_digit(c: String) -> Bool {
  (c != "") && string_contains(s: "0123456789", pattern: c)
}

fn md_strip_digits(s: String, n: Int) -> extdeps.languages.markdown.RepeatStrip {
  let c = char_at(s, 0)
  if md_is_digit(c: c) {
    md_strip_digits(s: substring(s: s, start: 1, end: s.length()), n: n + 1)
  } else {
    RepeatStrip { count: n, rest: s }
  }
}

fn md_ingest_inlines(text: String) -> List<std.markdown.MarkdownInline> {
  [ std.markdown.TextInline { text: text } ]
}

fn md_split_blocks(src: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> List<String> {
  let trimmed = if ends_with(s: src, suffix: "\n") {
    substring(s: src, start: 0, end: src.length() - 1)
  } else {
    src
  }
  split(s: trimmed, delimiter: sp.block_separator)
}

fn md_is_heading(line: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> Bool {
  let h = md_strip_repeated(s: line, unit: sp.heading_marker, n: 0)
  (h.count >= 1) && (h.count <= 6) && starts_with(s: h.rest, prefix: sp.heading_sep)
}

fn md_is_task_line(line: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> Bool {
  if starts_with(s: line, prefix: sp.unordered_bullet) {
    let after = md_drop_prefix(s: line, prefix: sp.unordered_bullet)
    starts_with(s: after, prefix: sp.task_checked) || starts_with(s: after, prefix: sp.task_unchecked)
  } else {
    false
  }
}

fn md_is_ordered_line(line: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> Bool {
  let d = md_strip_digits(s: line, n: 0)
  (d.count >= 1) && starts_with(s: d.rest, prefix: sp.ordered_suffix)
}

fn md_parse_heading(line: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> std.markdown.MarkdownBlock {
  let h = md_strip_repeated(s: line, unit: sp.heading_marker, n: 0)
  std.markdown.HeadingBlock {
    level: int_to_heading_level(n: h.count),
    inlines: md_ingest_inlines(text: md_drop_prefix(s: h.rest, prefix: sp.heading_sep)),
  }
}

fn md_unordered_item(line: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> std.markdown.MarkdownListItem {
  std.markdown.MarkdownListItem {
    blocks: [ std.markdown.ParagraphBlock { inlines: md_ingest_inlines(text: md_drop_prefix(s: line, prefix: sp.unordered_bullet)) } ],
  }
}

fn md_ordered_item(line: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> std.markdown.MarkdownListItem {
  let d = md_strip_digits(s: line, n: 0)
  std.markdown.MarkdownListItem {
    blocks: [ std.markdown.ParagraphBlock { inlines: md_ingest_inlines(text: md_drop_prefix(s: d.rest, prefix: sp.ordered_suffix)) } ],
  }
}

fn md_task_item(line: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> std.markdown.MarkdownTaskItem {
  let after = md_drop_prefix(s: line, prefix: sp.unordered_bullet)
  if starts_with(s: after, prefix: sp.task_checked) {
    std.markdown.MarkdownTaskItem {
      state: Checked,
      blocks: [ std.markdown.ParagraphBlock { inlines: md_ingest_inlines(text: md_drop_prefix(s: after, prefix: sp.task_checked)) } ],
    }
  } else {
    std.markdown.MarkdownTaskItem {
      state: Unchecked,
      blocks: [ std.markdown.ParagraphBlock { inlines: md_ingest_inlines(text: md_drop_prefix(s: after, prefix: sp.task_unchecked)) } ],
    }
  }
}

fn md_parse_code(block_lines: List<String>) -> std.markdown.MarkdownBlock {
  let inner = block_lines.skip(n: 1).take(n: block_lines.length() - 2)
  std.markdown.CodeBlock {
    code: if inner == [] { "" } else { concat(join(inner, "\n"), "\n") },
  }
}

fn md_parse_block(block_src: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> std.markdown.MarkdownBlock {
  let lines = split(s: block_src, delimiter: "\n")
  let first = lines.first()
  if starts_with(s: block_src, prefix: sp.code_fence) {
    md_parse_code(block_lines: lines)
  } else if md_is_heading(line: first, sp: sp) {
    md_parse_heading(line: first, sp: sp)
  } else if md_is_task_line(line: first, sp: sp) {
    std.markdown.TaskListBlock { items: map(lines, l => md_task_item(line: l, sp: sp)) }
  } else if md_is_ordered_line(line: first, sp: sp) {
    std.markdown.OrderedListBlock { items: map(lines, l => md_ordered_item(line: l, sp: sp)) }
  } else if starts_with(s: first, prefix: sp.unordered_bullet) {
    std.markdown.UnorderedListBlock { items: map(lines, l => md_unordered_item(line: l, sp: sp)) }
  } else {

    std.markdown.ParagraphBlock { inlines: md_ingest_inlines(text: block_src) }
  }
}

fn ingest_markdown_source_with(src: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> std.markdown.MarkdownDocument {
  std.markdown.MarkdownDocument {
    blocks: map(md_split_blocks(src: src, sp: sp), b => md_parse_block(block_src: b, sp: sp)),
  }
}

fn ingest_markdown_source(src: String) -> std.markdown.MarkdownDocument {
  ingest_markdown_source_with(src: src, sp: commonmark_gfm_spellings)
}

fn markdown_medium_lossless(doc: std.markdown.MarkdownDocument) -> Medium<std.markdown.MarkdownDocument> {
  extdeps.communication.medium.Medium { carried: doc, fidelity: Lossless }
}

fn markdown_url_validation(url: String) -> extdeps.uri_validation.RejectedUrlScheme? {
  match validate_href(url: url) {
    SafeHref { url: _ } => Absent
    RejectedHref { reason: r } => Present { value: r }
  }
}

fn find_first_rejected_url_in_inlines(inlines: List<std.markdown.MarkdownInline>) -> extdeps.uri_validation.RejectedUrlScheme? {
  fold(inlines,
    init: Absent,
    f: (acc, inline) => match acc {
      Present { value: r } => Present { value: r }
      Absent => find_first_rejected_url_in_inline(inline: inline)
    }
  )
}

fn find_first_rejected_url_in_inline(inline: std.markdown.MarkdownInline) -> extdeps.uri_validation.RejectedUrlScheme? {
  match inline {
    TextInline { text: _ } => Absent
    CodeInline { text: _ } => Absent
    ImageInline { alt: _, url } => markdown_url_validation(url: url)
    LinkInline { inlines, url } =>
      match markdown_url_validation(url: url) {
        Present { value: r } => Present { value: r }
        Absent => find_first_rejected_url_in_inlines(inlines: inlines)
      }
    EmphasisInline { inlines } =>
      find_first_rejected_url_in_inlines(inlines: inlines)
    StrongInline { inlines } =>
      find_first_rejected_url_in_inlines(inlines: inlines)
  }
}

fn find_first_rejected_url_in_blocks(blocks: List<std.markdown.MarkdownBlock>) -> extdeps.uri_validation.RejectedUrlScheme? {
  fold(blocks,
    init: Absent,
    f: (acc, block) => match acc {
      Present { value: r } => Present { value: r }
      Absent => find_first_rejected_url_in_block(block: block)
    }
  )
}

fn find_first_rejected_url_in_cells(cells: List<std.markdown.MarkdownTableCell>) -> extdeps.uri_validation.RejectedUrlScheme? {
  fold(cells,
    init: Absent,
    f: (acc, cell) => match acc {
      Present { value: r } => Present { value: r }
      Absent => find_first_rejected_url_in_inlines(inlines: cell.inlines)
    }
  )
}

fn find_first_rejected_url_in_rows(rows: List<std.markdown.MarkdownTableRow>) -> extdeps.uri_validation.RejectedUrlScheme? {
  fold(rows,
    init: Absent,
    f: (acc, row) => match acc {
      Present { value: r } => Present { value: r }
      Absent => find_first_rejected_url_in_cells(cells: row.cells)
    }
  )
}

fn find_first_rejected_url_in_block(block: std.markdown.MarkdownBlock) -> extdeps.uri_validation.RejectedUrlScheme? {
  match block {
    CodeBlock { code: _ } => Absent
    HeadingBlock { level: _, inlines } =>
      find_first_rejected_url_in_inlines(inlines: inlines)
    ParagraphBlock { inlines } =>
      find_first_rejected_url_in_inlines(inlines: inlines)
    UnorderedListBlock { items } =>
      fold(items,
        init: Absent,
        f: (acc, item) => match acc {
          Present { value: r } => Present { value: r }
          Absent => find_first_rejected_url_in_blocks(blocks: item.blocks)
        }
      )
    OrderedListBlock { items } =>
      fold(items,
        init: Absent,
        f: (acc, item) => match acc {
          Present { value: r } => Present { value: r }
          Absent => find_first_rejected_url_in_blocks(blocks: item.blocks)
        }
      )
    TaskListBlock { items } =>
      fold(items,
        init: Absent,
        f: (acc, item) => match acc {
          Present { value: r } => Present { value: r }
          Absent => find_first_rejected_url_in_blocks(blocks: item.blocks)
        }
      )
    TableBlock { header, alignments: _, rows } =>
      match find_first_rejected_url_in_cells(cells: header.cells) {
        Present { value: r } => Present { value: r }
        Absent => find_first_rejected_url_in_rows(rows: rows)
      }
    BlockquoteBlock { blocks } =>
      find_first_rejected_url_in_blocks(blocks: blocks)
    ThematicBreak => Absent
  }
}

fn find_first_rejected_url_in_document(doc: std.markdown.MarkdownDocument) -> extdeps.uri_validation.RejectedUrlScheme? {
  find_first_rejected_url_in_blocks(blocks: doc.blocks)
}

fn serialize_markdown_document(doc: std.markdown.MarkdownDocument) -> String {
  serialize_fragment(frag: markdown_document_to_fragment(doc: doc))
}

fn try_serialize_markdown_document(doc: std.markdown.MarkdownDocument) -> std.markup.MarkupSerializeResult {
  match find_first_rejected_url_in_document(doc: doc) {
    Present { value: _ } =>
      Rejected { reason: "URL scheme not allowlisted for markdown link/image" }
    Absent =>
      std.markup.Serialized { html: serialize_markdown_document(doc: doc) }
  }
}

type InlineSplit {
  before: String
  inner: String
  after: String
}

type InlineSplitResult
  = FoundSplit { parts: extdeps.languages.markdown.InlineSplit }
  | NoSplit

fn md_split_on_delim_pair(text: String, delim: String) -> extdeps.languages.markdown.InlineSplitResult {
  let parts = split(s: text, delimiter: delim)
  if parts.length() >= 3 {
    let before = parts.first()
    let tail = parts.skip(n: 1)
    let inner = tail.first()
    let after = join(tail.skip(n: 1), delim)
    FoundSplit { parts: extdeps.languages.markdown.InlineSplit { before: before, inner: inner, after: after } }
  } else {
    NoSplit
  }
}

fn md_text_inline_if_nonempty(s: String) -> List<std.markdown.MarkdownInline> {
  if s == "" { [] } else { [ std.markdown.TextInline { text: s } ] }
}

fn md_parse_inline_rest(text: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> List<std.markdown.MarkdownInline> {
  if text == "" {
    []
  } else {
    match md_split_on_delim_pair(text: text, delim: sp.strong_delim) {
      FoundSplit { parts: p } =>
        concat(
          md_parse_inline_rest(text: p.before, sp: sp),
          concat(
            [ std.markdown.StrongInline { inlines: md_parse_inline_rest(text: p.inner, sp: sp) } ],
            md_parse_inline_rest(text: p.after, sp: sp)
          )
        )
      NoSplit =>
        match md_split_on_delim_pair(text: text, delim: sp.code_span_delim) {
          FoundSplit { parts: p } =>
            concat(
              md_parse_inline_rest(text: p.before, sp: sp),
              concat(
                [ std.markdown.CodeInline { text: p.inner } ],
                md_parse_inline_rest(text: p.after, sp: sp)
              )
            )
          NoSplit =>
            match md_split_on_delim_pair(text: text, delim: sp.emphasis_delim) {
              FoundSplit { parts: p } =>
                concat(
                  md_parse_inline_rest(text: p.before, sp: sp),
                  concat(
                    [ std.markdown.EmphasisInline { inlines: md_parse_inline_rest(text: p.inner, sp: sp) } ],
                    md_parse_inline_rest(text: p.after, sp: sp)
                  )
                )
              NoSplit =>
                md_parse_inline_link(text: text, sp: sp)
            }
        }
    }
  }
}

fn md_parse_inline_link(text: String, sp: extdeps.languages.markdown.MarkdownSpellings) -> List<std.markdown.MarkdownInline> {
  let open_parts = split(s: text, delimiter: sp.link_text_open)
  if open_parts.length() < 2 {
    [ std.markdown.TextInline { text: text } ]
  } else {
    let before_bracket = open_parts.first()
    let after_bracket = join(open_parts.skip(n: 1), sp.link_text_open)
    let close_open_pat = join([sp.link_text_close, sp.link_url_open], "")
    let inner_parts = split(s: after_bracket, delimiter: close_open_pat)
    if inner_parts.length() < 2 {
      [ std.markdown.TextInline { text: text } ]
    } else {
      let label_text = inner_parts.first()
      let url_and_rest = join(inner_parts.skip(n: 1), close_open_pat)
      let url_parts = split(s: url_and_rest, delimiter: sp.link_url_close)
      if url_parts.length() < 2 {
        [ std.markdown.TextInline { text: text } ]
      } else {
        let url = url_parts.first()
        let after_link = join(url_parts.skip(n: 1), sp.link_url_close)
        concat(
          md_text_inline_if_nonempty(s: before_bracket),
          concat(
            [ std.markdown.LinkInline {
                inlines: md_parse_inline_rest(text: label_text, sp: sp),
                url: url,
              }
            ],
            md_parse_inline_rest(text: after_link, sp: sp)
          )
        )
      }
    }
  }
}

fn parse_inline_markdown_minimal(text: String) -> List<std.markdown.MarkdownInline> {
  md_parse_inline_rest(text: text, sp: commonmark_gfm_spellings)
}

data parse_inline_markdown_minimal_scaffold: std.disposition.Disposition = std.disposition.Scaffold {
  dissolves_to: SingleAuthority,
  bind: std.decl_ref.DeclarationRef {
    module_path: "extdeps.languages.markdown",
    decl_name: "parse_inline_markdown_minimal",
    field: WholeDeclaration
  }
}
