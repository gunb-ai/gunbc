module extdeps.languages.go.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "go.dev/ref/spec"
  }
}

data go_language_subject_note: String = "GO, cited to The Go Programming Language Specification (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched document is titled 'The Go Programming Language Specification', self-describes as 'the reference manual for the Go programming language', and carries an explicit language version in its header. Go is one of the few targets here whose upstream publishes a single normative specification document for the language proper, which is why this subject needs only one citation."

type Go
  = | GoTarget

data go_language_subject: Go = GoTarget

data go_language_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.languages.go.subject",
      decl_name: "go_language_subject",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.languages.go.subject.extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = go_language_model_scope
