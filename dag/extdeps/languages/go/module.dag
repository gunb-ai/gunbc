module extdeps.languages.go.module



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "go.dev/ref/mod"
  }
}

type GoSemVer {
  major: Int
  minor: Int
  patch: Int
  prerelease: String?
  build: String?
}

fn go_semver_label(v: GoSemVer) -> String {
  let base = concat("v", concat(to_string(v.major), concat(".", concat(to_string(v.minor), concat(".", to_string(v.patch))))))
  let with_pre = match v.prerelease {
    Present { value: pre } => concat(base, concat("-", pre))
    Absent => base
  }
  match v.build {
    Present { value: bld } => concat(with_pre, concat("+", bld))
    Absent => with_pre
  }
}

fn go_semver_to_version_identity(v: GoSemVer) -> extdeps.version.VersionIdentity {
  go_semver_label(v: v)
}

fn go_semver_compare(a: GoSemVer, b: GoSemVer) -> std.algebra.Ordering {
  let mc = if a.major < b.major { std.algebra.Less } else { if a.major > b.major { std.algebra.Greater } else { std.algebra.Equal } }
  let nc = if a.minor < b.minor { std.algebra.Less } else { if a.minor > b.minor { std.algebra.Greater } else { std.algebra.Equal } }
  let pc = if a.patch < b.patch { std.algebra.Less } else { if a.patch > b.patch { std.algebra.Greater } else { std.algebra.Equal } }
  let pre = match a.prerelease {
    Absent => match b.prerelease {
      Absent => std.algebra.Equal
      Present { value: _bp } => std.algebra.Greater
    }
    Present { value: _ap } => match b.prerelease {
      Absent => std.algebra.Less
      Present { value: _bp } => std.algebra.Equal
    }
  }
  match mc {
    std.algebra.Less => std.algebra.Less
    std.algebra.Greater => std.algebra.Greater
    std.algebra.Equal => match nc {
      std.algebra.Less => std.algebra.Less
      std.algebra.Greater => std.algebra.Greater
      std.algebra.Equal => match pc {
        std.algebra.Less => std.algebra.Less
        std.algebra.Greater => std.algebra.Greater
        std.algebra.Equal => pre
      }
    }
  }
}

data go_module_version_scheme: extdeps.version.VersionScheme = {
  compare: (a, b) => if a == b { std.algebra.Equal } else { std.algebra.Less }
}

type GoModulePath = std.types.NonEmptyStr where brand("GoModulePath")

type GoMajorVersionSuffix
  = MajorV0OrV1
  | MajorV2Plus { major: Int where range(min: 2) }

fn go_major_suffix_str(suffix: GoMajorVersionSuffix) -> String {
  match suffix {
    MajorV0OrV1 => ""
    MajorV2Plus { major: m } => concat("/v", to_string(m))
  }
}

type GoLanguageVersion = std.types.NonEmptyStr where brand("GoLanguageVersion")

type GoToolchainName = std.types.NonEmptyStr where brand("GoToolchainName")

type GoRequireEntry {
  module_path: GoModulePath
  version: GoSemVer
  indirect: Bool
}

type GoReplaceTarget
  = ModuleRedirect { path: GoModulePath, version: GoSemVer }
  | LocalDirRedirect { path: std.types.NonEmptyStr }

type GoReplaceEntry {
  source_path: GoModulePath
  source_version: GoSemVer?
  target: GoReplaceTarget
}

type GoExcludeEntry {
  module_path: GoModulePath
  version: GoSemVer
}

type GoRetractRange
  = RetractSingle { version: GoSemVer }
  | RetractRange  { low: GoSemVer, high: GoSemVer }

type GoRetractEntry {
  range: GoRetractRange
  rationale: std.types.NonEmptyStr?
}

type GoModFile {
  module_path: GoModulePath
  go_version: GoLanguageVersion
  toolchain: GoToolchainName?
  require: List<GoRequireEntry>
  replace: List<GoReplaceEntry>
  exclude: List<GoExcludeEntry>
  retract: List<GoRetractEntry>
}

type GoMvsProperty
  = DeterministicMinimal
  | ContentHashLocked
  | MainModuleOnly

data go_mvs_properties: List<GoMvsProperty> = [
  DeterministicMinimal,
  ContentHashLocked,
  MainModuleOnly
]

data emit_host_min_go_language_version: GoLanguageVersion = "1.22"
data emit_host_bootstrap_toolchain: GoToolchainName = "go1.22.5"
