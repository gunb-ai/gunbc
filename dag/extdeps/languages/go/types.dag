module extdeps.languages.go.types

import std.coercion {
  TypeCheckpoint, InhabitantDecl, CallableRepr, CastSyntax, CastRule
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "go.dev/ref/spec"
  }
}

data go_type_checkpoints: List<TypeCheckpoint> = [
  { dag_name: "Int",    target_type: "int64",       default_expr: "0",          is_copy: none, literal_suffix: none },
  { dag_name: "Float",  target_type: "float64",     default_expr: "0.0",        is_copy: none, literal_suffix: none },
  { dag_name: "Bool",   target_type: "bool",        default_expr: "false",      is_copy: none, literal_suffix: none },
  { dag_name: "Unit",   target_type: "struct{}",    default_expr: "struct{}{}", is_copy: none, literal_suffix: none },
  { dag_name: "String", target_type: "string",      default_expr: "\"\"",       is_copy: none, literal_suffix: none },
  { dag_name: "Bytes",  target_type: "[]byte",      default_expr: "nil",        is_copy: none, literal_suffix: none },
  { dag_name: "Secret", target_type: "string",      default_expr: "\"\"",       is_copy: none, literal_suffix: none },
  { dag_name: "Json",   target_type: "interface{}", default_expr: "nil",        is_copy: none, literal_suffix: none }
]

data go_algebra_inhabitants: List<InhabitantDecl> = [

  { algebra: "FreeMonoid",
    template: "[]\{0\}",
    arity: 1,
    identity_expr: "nil",
    import_path: none,
    is_copy: none },

  { algebra: "BooleanAlgebra",
    template: "map[\{0\}]struct{}",
    arity: 1,
    identity_expr: "nil",
    import_path: none,
    is_copy: none },

  { algebra: "PointwisePower",
    template: "map[\{0\}]struct{}",
    arity: 1,
    identity_expr: "nil",
    import_path: none,
    is_copy: none },

  { algebra: "PartialFunction",
    template: "map[\{0\}]\{1\}",
    arity: 2,
    identity_expr: "nil",
    import_path: none,
    is_copy: none },

  { algebra: "OrderedRing",
    template: "int64",
    arity: 0,
    identity_expr: "0",
    import_path: none,
    is_copy: none },

  { algebra: "ApproximateField",
    template: "float64",
    arity: 0,
    identity_expr: "0.0",
    import_path: none,
    is_copy: none }
]

data go_callable: CallableRepr = CallableRepr {
  template: "func(\{params\}) \{return\}",
  param_separator: ", ",
  return_separator: " ",
  import_path: none
}

data pointer_template: String = "*\{0\}"
data go_optional_template: String = "*\{0\}"
data address_of_template: String = "&\{value\}"
data nil_literal: String = "nil"
data visibility_by_case: Bool = true
data embedded_field_syntax: String = "\{type\}"
data empty_interface: String = "interface{}"
data any_type: String = "any"
data interface_def_template: String = "type \{name\} interface \{\n\{methods\}\n\}"

data integer_types: List<String> = [
  "int", "int8", "int16", "int32", "int64",
  "uint", "uint8", "uint16", "uint32", "uint64", "uintptr"
]

data float_types: List<String> = ["float32", "float64"]

data type_conversion_template: String = "\{type\}(\{expr\})"

data go_cast_syntax: CastSyntax = {
  template: "\{type\}(\{expr\})",
  cast_rules: [
    { from_type: "int64", to_type: "int64" },
    { from_type: "int64", to_type: "float64" },
    { from_type: "float64", to_type: "int64" },
    { from_type: "float64", to_type: "float64" },
    { from_type: "string", to_type: "[]byte" },
    { from_type: "[]byte", to_type: "string" }
  ]
}
