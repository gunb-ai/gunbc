module extdeps.languages.typescript.program


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.typescriptlang.org/docs/handbook/2/basic-types.html"
  }
}

type TsStringQuote
  = SingleQuote
  | DoubleQuote
  | Backtick

type TsExpr
  = LitStr { value: String, quote: TsStringQuote }
  | LitNum { text: String }
  | LitRegex { source: String }
  | Ident { name: String }
  | Member { object: TsExpr, property: String }
  | Index { object: TsExpr, index: TsExpr }
  | Call { callee: TsExpr, args: List<TsExpr> }
  | New { callee: TsExpr, args: List<TsExpr> }
  | ArrowFn { params: List<String>, body: TsStmt }
  | BinOp { left: TsExpr, op: String, right: TsExpr }
  | Prefix { op: String, expr: TsExpr }
  | ArrayLit { elements: List<TsExpr> }
  | ObjectLit { fields: List<TsObjectField> }
  | Spread { expr: TsExpr }
  | Cond { test: TsExpr, consequent: TsExpr, alternate: TsExpr }

type TsObjectField
  = Field { key: String, value: TsExpr, quote_key: Bool }

type TsStmt
  = Const { name: String, value: TsExpr }
  | Let { name: String, value: TsExpr }
  | ExprStmt { expr: TsExpr }
  | If { cond: TsExpr, then: TsStmt, else_stmt: TsStmt? }
  | ForOf { var_name: String, iterable: TsExpr, body: TsStmt }
  | Return { expr: TsExpr? }
  | Block { stmts: List<TsStmt> }
  | Try { body: TsStmt, catch_param: String, handler: TsStmt }

type TsProgram {
  ts_nocheck: Bool
  header_lines: List<String>
  statements: List<TsStmt>
}

fn ts_ident(name: String) -> TsExpr {
  Ident { name: name }
}

fn ts_lit_str(value: String) -> TsExpr {
  LitStr { value: value, quote: SingleQuote }
}

fn ts_lit_str_double(value: String) -> TsExpr {
  LitStr { value: value, quote: DoubleQuote }
}

fn ts_lit_backtick(value: String) -> TsExpr {
  LitStr { value: value, quote: Backtick }
}

fn ts_lit_num(text: String) -> TsExpr {
  LitNum { text: text }
}

fn ts_lit_regex(source: String) -> TsExpr {
  LitRegex { source: source }
}

fn ts_member(object: TsExpr, property: String) -> TsExpr {
  Member { object: object, property: property }
}

fn ts_call(callee: TsExpr, args: List<TsExpr>) -> TsExpr {
  Call { callee: callee, args: args }
}

data ts_new_note: String = "`new C(args)` — the NewExpression production, part of the cited language and previously absent from this grammar, so a constructor call had no representation at all. The gap is worth naming because the tempting alternative was Ident { name: \"new AudioContext()\" }: a hand-authored JS string smuggled through an identifier, which would have type-checked, serialized correctly, and defeated the entire point of modeling the program as a tree. That is the unmarked-workaround shape DESIGN rules a line-stop, so the production was added instead. Serialization does NOT parenthesize the callee, so a callee that is itself an operator expression (`new (a || b)()`) must be bound to a name first — the grammar has no Paren production and one is not minted speculatively (DESIGN section 6: priced by displaced cost, and no consumer needs it)."

fn ts_new(callee: TsExpr, args: List<TsExpr>) -> TsExpr {
  New { callee: callee, args: args }
}

fn ts_binop(left: TsExpr, op: String, right: TsExpr) -> TsExpr {
  BinOp { left: left, op: op, right: right }
}

fn ts_field(key: String, value: TsExpr) -> TsObjectField {
  Field { key: key, value: value, quote_key: false }
}

fn ts_quoted_field(key: String, value: TsExpr) -> TsObjectField {
  Field { key: key, value: value, quote_key: true }
}

fn ts_object(fields: List<TsObjectField>) -> TsExpr {
  ObjectLit { fields: fields }
}

fn ts_array(elements: List<TsExpr>) -> TsExpr {
  ArrayLit { elements: elements }
}

fn ts_arrow(params: List<String>, body: TsStmt) -> TsExpr {
  ArrowFn { params: params, body: body }
}

fn ts_index(object: TsExpr, index: TsExpr) -> TsExpr {
  Index { object: object, index: index }
}

fn ts_cond(test: TsExpr, consequent: TsExpr, alternate: TsExpr) -> TsExpr {
  Cond { test: test, consequent: consequent, alternate: alternate }
}

fn ts_prefix(op: String, expr: TsExpr) -> TsExpr {
  Prefix { op: op, expr: expr }
}

fn ts_spread(expr: TsExpr) -> TsExpr {
  Spread { expr: expr }
}

fn ts_block(stmts: List<TsStmt>) -> TsStmt {
  Block { stmts: stmts }
}

fn ts_const(name: String, value: TsExpr) -> TsStmt {
  Const { name: name, value: value }
}

fn ts_let(name: String, value: TsExpr) -> TsStmt {
  Let { name: name, value: value }
}

fn ts_expr_stmt(expr: TsExpr) -> TsStmt {
  ExprStmt { expr: expr }
}

fn ts_return(expr: TsExpr?) -> TsStmt {
  Return { expr: expr }
}

fn ts_if(cond: TsExpr, then: TsStmt, else_stmt: TsStmt?) -> TsStmt {
  If { cond: cond, then: then, else_stmt: else_stmt }
}

fn ts_for_of(var_name: String, iterable: TsExpr, body: TsStmt) -> TsStmt {
  ForOf { var_name: var_name, iterable: iterable, body: body }
}

data try_statement_grounding_note: String = "ECMAScript TryStatement, in the shape this emitter can actually construct: a block, one binding catch parameter, one handler block. The optional finally clause and the parameter-less catch form are NOT admitted, because nothing constructs them and an arm nobody builds is an arm nobody has proven serializes.

WHY IT LANDED: a constructor can throw. The Generic Sensor specification says so by name — constructing a sensor outside a secure context, or where the permissions policy forbids it, raises SecurityError, and there is no interrogable property that answers the question first. Without a catch the emitted probe would fault mid-handler and the page would keep displaying 'not yet run': an unanswered question standing where a REFUSAL was observed. That is the empty-observation narrow (DESIGN §5) at the exact seam this lane exists to keep honest, so the grammar grows one arm rather than the probe pretending the throw cannot happen."

fn ts_try(body: TsStmt, catch_param: String, handler: TsStmt) -> TsStmt {
  Try { body: body, catch_param: catch_param, handler: handler }
}

fn escape_single_quoted(s: String) -> String {
  let s1 = join(split(s: s, delimiter: "\\"), "\\\\")
  join(split(s: s1, delimiter: "'"), "\\'")
}

fn escape_double_quoted(s: String) -> String {
  let s1 = join(split(s: s, delimiter: "\\"), "\\\\")
  join(split(s: s1, delimiter: "\""), "\\\"")
}

fn escape_backtick(s: String) -> String {
  let s1 = join(split(s: s, delimiter: "\\"), "\\\\")
  let s2 = join(split(s: s1, delimiter: "`"), "\\`")
  let s3 = join(split(s: s2, delimiter: "$"), "\\$")
  s3
}

fn serialize_string_literal(value: String, quote: TsStringQuote) -> String {
  match quote {
    SingleQuote => concat("'", concat(escape_single_quoted(s: value), "'"))
    DoubleQuote => concat("\"", concat(extdeps.languages.typescript.program.escape_double_quoted(s: value), "\""))
    Backtick => concat("`", concat(escape_backtick(s: value), "`"))
  }
}

fn join_expr_args(args: List<TsExpr>) -> String {
  fold(args, init: "", f: (acc, a) => {
    let part = serialize_ts_expr(e: a)
    if acc == "" { part } else { concat(acc, concat(", ", part)) }
  })
}

fn serialize_object_field(f: TsObjectField) -> String {
  match f {
    Field { key: k, value: v, quote_key: qk } =>
      if qk {
        concat(serialize_string_literal(value: k, quote: SingleQuote), concat(": ", serialize_ts_expr(e: v)))
      } else {
        concat(k, concat(": ", serialize_ts_expr(e: v)))
      }
  }
}

fn join_object_fields(fields: List<TsObjectField>) -> String {
  fold(fields, init: "", f: (acc, field) => {
    let part = serialize_object_field(f: field)
    if acc == "" { part } else { concat(acc, concat(", ", part)) }
  })
}

fn join_array_elements(elements: List<TsExpr>) -> String {
  fold(elements, init: "", f: (acc, el) => {
    let part = serialize_ts_expr(e: el)
    if acc == "" { part } else { concat(acc, concat(", ", part)) }
  })
}

data ts_operator_precedence_note: String = "THE SERIALIZER USED TO EMIT OPERAND TEXT WITHOUT REGARD FOR PRECEDENCE, which made it possible to build a well-typed TsExpr that serializes to syntactically valid JavaScript computing something ELSE. That is the sharpest failure shape a translator has: not a crash, not a refusal, a silent semantic substitution downstream of a green typecheck (DESIGN section 5). Every consumer of this module inherited it, because the defect is in the printer, not in any one program.\\n\\nFOUR LIVE PRODUCERS, found by reading the emitted asset rather than the model (2026-07-30, gunbc.roadmap_component). Every one of them was in a REASON channel — a tooltip, an accessible name, a refusal string — which is not a coincidence: a reason channel is read by a person on a bad day, never by a test, so it is exactly where a silent substitution survives longest.\\n  BinOp('+') over Cond -> `seg.label + ': ' + seg.state + seg.detail ? ' — ' + seg.detail : ''`, which parses as `(a+b+c+d) ? e : f`. A concatenation is a non-empty string, so the test was ALWAYS true and the workflow stage's accessible name became the bare detail, losing its label and state.\\n  BinOp('+') over Cond again, on the workflow tooltip: same shape, same always-true test.\\n  BinOp('+') over BinOp('||') -> `'workflow observation refused: ' + wj.reason || 'no reason on the wire'`, which parses as `('...' + wj.reason) || '...'`. The left side is truthy even when wj.reason is undefined, so the fallback could never fire and a reasonless refusal rendered as the word undefined.\\n  BinOp('+') over BinOp('||') -> `'host ' + ij.host_identity || 'unknown' + ' · repo ' + ij.repo_root || 'unknown'`, same mechanism, and here the entire repo half of the instance label was unreachable.\\n\\nThe model was never wrong in any of the four. The printer was. That is why the fix is a precedence-aware printer and not parentheses hand-added at four call sites: hand-parenthesizing concedes that the next author can write the same shape and get the same substitution, which is a validation standing where a construction was available. Grouping is now DERIVED from the table below.\\n\\nWHAT THE CHANGE COSTS, stated precisely because the tempting claim — 'only the defects move' — is FALSE and was written here before the diff was read. A group is emitted when an operand binds looser than its parent demands, AND when it ties under a parent that is not associative. The second case moves bytes at expressions that were already correct: right-nested `+` now renders as `a + (b + c)`, which appeared at seven sites in the roadmap client. That is not avoidable by declaring `+` associative, because it is not — `1 + (2 + 'x')` is '12x' and `(1 + 2) + 'x'` is '3x' — and a printer that cannot see operand types must therefore preserve the model's own grouping. Extra parentheses around a correct expression are noise; dropped parentheses around one are a wrong answer, so the trade is not close.\\n\\nAssociativity is honored where it is real: `||` and `&&` are associative, so a same-precedence right operand needs no group, and `=` is right-associative, which is exactly why the extremely common `x = c ? a : b` keeps its bare form rather than growing parentheses at every assignment in the corpus.\\n\\nUNRECOGNIZED OPERATORS FAIL CLOSED IN BOTH ROLES, and the two roles need opposite answers, which is why one table is read through two functions. As a PARENT an unknown operator claims the tightest binding, so any compound operand under it is grouped; as a CHILD it claims the loosest, so it is grouped inside its parent. Both directions over-parenthesize, which is the safe direction — the alternative is to guess a binding and silently re-associate, which is the defect this note exists to close. An ATOM operand is still left bare under an unknown parent, because an identifier or a literal has no internal structure to re-associate and grouping it would be noise standing in for a property."

data ts_atom_precedence: Int = 20

data ts_conditional_precedence: Int = 3

data ts_prefix_precedence: Int = 14

data ts_unrecognized_operator_as_child_precedence: Int = 1

fn ts_operator_precedence_or(op: String, unrecognized: Int) -> Int {
  if op == "=" {
    2
  } else if op == "||" {
    4
  } else if op == "&&" {
    5
  } else if op == "===" || op == "!==" || op == "==" || op == "!=" {
    9
  } else if op == "<" || op == ">" || op == "<=" || op == ">=" {
    10
  } else if op == "+" || op == "-" {
    12
  } else if op == "*" || op == "/" || op == "%" {
    13
  } else {
    unrecognized
  }
}

fn ts_precedence_as_parent(op: String) -> Int {
  ts_operator_precedence_or(op: op, unrecognized: ts_atom_precedence)
}

fn ts_precedence_as_child(op: String) -> Int {
  ts_operator_precedence_or(op: op, unrecognized: ts_unrecognized_operator_as_child_precedence)
}

fn ts_operator_is_associative(op: String) -> Bool {
  op == "||" || op == "&&"
}

fn ts_operator_is_right_associative(op: String) -> Bool {
  op == "="
}

fn ts_expr_precedence(e: TsExpr) -> Int {
  match e {
    BinOp { left: _, op: o, right: _ } => ts_precedence_as_child(op: o)
    Cond { test: _, consequent: _, alternate: _ } => ts_conditional_precedence
    Prefix { op: _, expr: _ } => ts_prefix_precedence
    LitStr { value: _, quote: _ } => ts_atom_precedence
    LitNum { text: _ } => ts_atom_precedence
    LitRegex { source: _ } => ts_atom_precedence
    Ident { name: _ } => ts_atom_precedence
    Member { object: _, property: _ } => ts_atom_precedence
    Index { object: _, index: _ } => ts_atom_precedence
    Call { callee: _, args: _ } => ts_atom_precedence
    New { callee: _, args: _ } => ts_atom_precedence
    ArrowFn { params: _, body: _ } => ts_atom_precedence
    ArrayLit { elements: _ } => ts_atom_precedence
    ObjectLit { fields: _ } => ts_atom_precedence
    Spread { expr: _ } => ts_atom_precedence
  }
}

fn ts_group_if(text: String, needed: Bool) -> String {
  if needed { concat("(", concat(text, ")")) } else { text }
}

fn ts_operand_tie_needs_group(parent_op: String, is_right: Bool) -> Bool {
  if is_right {
    !ts_operator_is_associative(op: parent_op) && !ts_operator_is_right_associative(op: parent_op)
  } else {
    ts_operator_is_right_associative(op: parent_op)
  }
}

data atom_operand_never_grouped_note: String = "An operand that is already an atom — an identifier, a literal, a call, a member access — is NEVER grouped, and this guard states that invariant directly rather than letting it fall out of the arithmetic. Without it the numbers produce a genuinely wrong answer at one corner: an unrecognized parent operator claims atom precedence so that compound operands get grouped, which makes it TIE with atom operands, and the left-associative tie rule then parenthesized the right-hand atom — `a ?? (c)` — while leaving the left one bare. Asymmetric, pointless, and a sign the rule was being read off a number instead of the property. The property is that grouping exists to stop RE-ASSOCIATION, and an expression with no internal operator has nothing to re-associate."

fn serialize_ts_operand(e: TsExpr, parent_op: String, is_right: Bool) -> String {
  let parent = ts_precedence_as_parent(op: parent_op)
  let child = ts_expr_precedence(e: e)
  let tie = ts_operand_tie_needs_group(parent_op: parent_op, is_right: is_right)
  let atom = child == ts_atom_precedence
  let needed = !atom && ((child < parent) || ((child == parent) && tie))
  ts_group_if(text: serialize_ts_expr(e: e), needed: needed)
}

data receiver_grouping_note: String = "A member access, index, or call binds tighter than any operator, so a receiver that IS an operator expression must be grouped or the emitted bytes re-associate: `ts_member(ts_binop(a, '||', b), 'forEach')` serialized as `a || b.forEach(...)`, which is not a syntax error but a SILENT no-op when `a` is truthy — the fabricated-plausible-output shape at the emitter layer, found live when the roadmap client's `(attempt.segments || []).forEach` ledger fill appended nothing and no console error fired. The receiver is grouped exactly when it is not an atom: atoms (identifiers, literals, calls, members) have nothing to re-associate, per atom_operand_never_grouped_note."

fn serialize_ts_receiver(e: TsExpr) -> String {
  ts_group_if(
    text: serialize_ts_expr(e: e),
    needed: ts_expr_precedence(e: e) != ts_atom_precedence)
}

fn serialize_ts_expr(e: TsExpr) -> String {
  match e {
    LitStr { value: v, quote: q } => serialize_string_literal(value: v, quote: q)
    LitNum { text: t } => t
    LitRegex { source: s } => concat("/", concat(s, "/"))
    Ident { name: n } => n
    Member { object: o, property: p } => concat(serialize_ts_receiver(e: o), concat(".", p))
    Index { object: o, index: i } =>
      concat(serialize_ts_receiver(e: o), concat("[", concat(serialize_ts_expr(e: i), "]")))
    Call { callee: c, args: a } =>
      concat(serialize_ts_receiver(e: c), concat("(", concat(join_expr_args(args: a), ")")))
    New { callee: c, args: a } =>
      concat("new ", concat(serialize_ts_receiver(e: c), concat("(", concat(join_expr_args(args: a), ")"))))
    ArrowFn { params: ps, body: b } =>
      concat("(", concat(join(ps, ", "), concat(") => ", serialize_ts_stmt_body(s: b))))
    BinOp { left: l, op: o, right: r } =>
      concat(
        serialize_ts_operand(e: l, parent_op: o, is_right: false),
        concat(concat(" ", o), concat(" ", serialize_ts_operand(e: r, parent_op: o, is_right: true))))
    Prefix { op: o, expr: x } =>
      concat(o, ts_group_if(
        text: serialize_ts_expr(e: x),
        needed: ts_expr_precedence(e: x) < ts_prefix_precedence))
    ArrayLit { elements: els } => concat("[", concat(join_array_elements(elements: els), "]"))
    ObjectLit { fields: fs } => concat("{ ", concat(join_object_fields(fields: fs), " }"))
    Spread { expr: x } => concat("...", serialize_ts_expr(e: x))
    Cond { test: t, consequent: c, alternate: a } =>
      concat(
        ts_group_if(
          text: serialize_ts_expr(e: t),
          needed: ts_expr_precedence(e: t) <= ts_conditional_precedence),
        concat(" ? ", concat(
          serialize_ts_expr(e: c),
          concat(" : ", ts_group_if(
            text: serialize_ts_expr(e: a),
            needed: ts_expr_precedence(e: a) < ts_conditional_precedence)))))
  }
}

fn serialize_ts_stmt_body(s: TsStmt) -> String {
  match s {
    Block { stmts: ss } => concat("{ ", concat(serialize_ts_stmts_indented(stmts: ss, indent: "  "), " }"))
    ExprStmt { expr: e } => serialize_ts_expr(e: e)
    Const { name: _, value: _ } => serialize_ts_stmt(s: s)
    Let { name: _, value: _ } => serialize_ts_stmt(s: s)
    If { cond: _, then: _, else_stmt: _ } => serialize_ts_stmt(s: s)
    ForOf { var_name: _, iterable: _, body: _ } => serialize_ts_stmt(s: s)
    Return { expr: _ } => serialize_ts_stmt(s: s)
    Try { body: _, catch_param: _, handler: _ } => serialize_ts_stmt(s: s)
  }
}

fn serialize_ts_stmt(s: TsStmt) -> String {
  match s {
    Const { name: n, value: v } => concat("const ", concat(n, concat(" = ", concat(serialize_ts_expr(e: v), ";"))))
    Let { name: n, value: v } => concat("let ", concat(n, concat(" = ", concat(serialize_ts_expr(e: v), ";"))))
    ExprStmt { expr: e } => concat(serialize_ts_expr(e: e), ";")
    If { cond: c, then: t, else_stmt: e } =>
      match e {
        Present { value: es } =>
          concat("if (", concat(serialize_ts_expr(e: c), concat(") ", concat(serialize_ts_stmt_body(s: t), concat(" else ", serialize_ts_stmt_body(s: es))))))
        Absent =>
          concat("if (", concat(serialize_ts_expr(e: c), concat(") ", serialize_ts_stmt_body(s: t))))
      }
    ForOf { var_name: vn, iterable: it, body: b } =>
      concat("for (const ", concat(vn, concat(" of ", concat(serialize_ts_expr(e: it), concat(") ", serialize_ts_stmt_body(s: b))))))
    Return { expr: e } =>
      match e {
        Present { value: x } => concat("return ", concat(serialize_ts_expr(e: x), ";"))
        Absent => "return;"
      }
    Block { stmts: ss } => concat("{\n", concat(serialize_ts_stmts_indented(stmts: ss, indent: "  "), "\n}"))
    Try { body: b, catch_param: cp, handler: h } =>
      concat("try ", concat(
        serialize_ts_stmt_body(s: b),
        concat(" catch (", concat(cp, concat(") ", serialize_ts_stmt_body(s: h))))))
  }
}

fn serialize_ts_stmts_indented(stmts: List<TsStmt>, indent: String) -> String {
  fold(stmts, init: "", f: (acc, s) => {
    let line = concat(indent, serialize_ts_stmt(s: s))
    if acc == "" { line } else { concat(acc, concat("\n", line)) }
  })
}

fn serialize_typescript_program(p: TsProgram) -> String {
  let header = fold(p.header_lines, init: "", f: (acc, line) => {
    let part = concat("// ", line)
    if acc == "" { part } else { concat(acc, concat("\n", part)) }
  })
  let nocheck = if p.ts_nocheck { "// @ts-nocheck\n" } else { "" }
  let body = fold(p.statements, init: "", f: (acc, s) => {
    let part = serialize_ts_stmt(s: s)
    if acc == "" { part } else { concat(acc, concat("\n", part)) }
  })
  if header == "" {
    concat(nocheck, body)
  } else {
    concat(nocheck, concat(header, concat("\n", body)))
  }
}
