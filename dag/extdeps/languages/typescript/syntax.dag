data ts_operators: List<std.syntax.OperatorSpec> = [
  std.syntax.OperatorSpec { symbol: "??",  left_bp: 3,  right_bp: 4,  binop: std.syntax.NullCoalesce, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "||",  left_bp: 5,  right_bp: 6,  binop: std.syntax.Or,           algebra_field: none },
  std.syntax.OperatorSpec { symbol: "&&",  left_bp: 7,  right_bp: 8,  binop: std.syntax.And,          algebra_field: none },
  std.syntax.OperatorSpec { symbol: "===", left_bp: 9,  right_bp: 10, binop: std.syntax.Eq,           algebra_field: none },
  std.syntax.OperatorSpec { symbol: "!==", left_bp: 9,  right_bp: 10, binop: std.syntax.Ne,           algebra_field: none },
  std.syntax.OperatorSpec { symbol: "<",   left_bp: 11, right_bp: 12, binop: std.syntax.Lt,           algebra_field: none },
  std.syntax.OperatorSpec { symbol: ">",   left_bp: 11, right_bp: 12, binop: std.syntax.Gt,           algebra_field: none },
  std.syntax.OperatorSpec { symbol: "<=",  left_bp: 11, right_bp: 12, binop: std.syntax.Le,           algebra_field: none },
  std.syntax.OperatorSpec { symbol: ">=",  left_bp: 11, right_bp: 12, binop: std.syntax.Ge,           algebra_field: none },
  std.syntax.OperatorSpec { symbol: "+",   left_bp: 13, right_bp: 14, binop: std.syntax.Add,          algebra_field: none },
  std.syntax.OperatorSpec { symbol: "-",   left_bp: 13, right_bp: 14, binop: std.syntax.Sub,          algebra_field: none },
  std.syntax.OperatorSpec { symbol: "*",   left_bp: 15, right_bp: 16, binop: std.syntax.Mul,          algebra_field: none },
  std.syntax.OperatorSpec { symbol: "/",   left_bp: 15, right_bp: 16, binop: std.syntax.Div,          algebra_field: none },
  std.syntax.OperatorSpec { symbol: "%",   left_bp: 15, right_bp: 16, binop: std.syntax.Mod,          algebra_field: none }
]
