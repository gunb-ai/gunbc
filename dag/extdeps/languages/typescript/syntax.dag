module extdeps.languages.typescript.syntax


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.typescriptlang.org/docs/handbook/2/basic-types.html"
  }
}

data ts_item_forms: List<std.syntax.ItemForm> = [
  std.syntax.ItemForm { kind: std.syntax.FuncForm, keyword: "function", has_type_params: true, has_params: true,
    has_return_type: true, return_required: false,
    has_uses: false, body_kind: std.syntax.BlockBody },
  std.syntax.ItemForm { kind: std.syntax.StructForm, keyword: "interface", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: std.syntax.TypeBody },
  std.syntax.ItemForm { kind: std.syntax.EnumForm, keyword: "enum", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: std.syntax.TypeBody },
  std.syntax.ItemForm { kind: std.syntax.TypeAliasForm, keyword: "type", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: std.syntax.NoBody },
  std.syntax.ItemForm { kind: std.syntax.ModuleForm, keyword: "namespace", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: std.syntax.BlockBody }
]

data ts_keyword_literals: Map<String, std.syntax.LiteralValue> = {
  "true": std.syntax.LitBool { value: true },
  "false": std.syntax.LitBool { value: false }
}

