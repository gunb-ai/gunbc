  "continue": true, "switch": true, "case": true, "default": true,
  "throw": true, "try": true, "catch": true, "finally": true,
  "new": true, "delete": true, "typeof": true, "instanceof": true,
  "in": true, "of": true, "async": true, "await": true,
  "true": true, "false": true, "null": true, "undefined": true,
  "void": true, "never": true, "any": true, "unknown": true,
