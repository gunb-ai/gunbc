module extdeps.languages.cpp.subject

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.open-std.org/jtc1/sc22/wg21/"
  }
}

data cpp_language_subject_note: String = "THE C++ LANGUAGE, cited to ISO/IEC JTC1/SC22/WG21 (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched committee page identifies itself as 'the international standardization working group for the programming language C++' and designates the standard as 'ISO/IEC 14882: Programming Language C++'. Same iso.org 403 caveat as the C subject. NOTE ON PROFILE, not decided here: DESIGN's open decision 2 asks whether this repository targets bounded system/kernel C++ or general-purpose C++; the disposition on this subject's registration reflects that the decision is open, and whichever profile is chosen must be named honestly rather than labelled 'full C++ support'."

type Cpp
  = | CppTarget

data cpp_language: Cpp = CppTarget

data cpp_language_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.languages.cpp.subject",
      decl_name: "cpp_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data cpp_language_mandated_scope_name_scaffold_note: String = "DECLARED SCAFFOLD — the shared explanation and both dissolution triggers live once at gunbc.language_subject_scope_scaffold mandated_scope_name_scaffold, and are deliberately not repeated inside an upstream subject carrier (cursor review 48122)."

data extdeps_model_scope: ExternalModelScope = cpp_language_model_scope
