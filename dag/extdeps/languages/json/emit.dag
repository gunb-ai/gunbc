module extdeps.languages.json.emit

import extdeps.external_authority { ExternalAuthority }
import extdeps.languages.json.grammar { JsonNumberLexeme, json_int_lexeme, json_number_lexeme }
import extdeps.numeric.base16 { int_to_upper_hex }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc8259"
  }
}

type JsonKeyValue {
  key: String
  value: JsonValue
}

type JsonValue
  = JsonNull
  | JsonBool { value: Bool }
  | JsonNumber { lexeme: JsonNumberLexeme }
  | JsonString { value: String }
  | JsonArray { elements: List<JsonValue> }
  | JsonObject { members: List<JsonKeyValue> }

fn json_kv(key: String, value: JsonValue) -> JsonKeyValue {
  JsonKeyValue { key: key, value: value }
}

fn json_null() -> JsonValue {
  JsonNull
}

fn json_bool(b: Bool) -> JsonValue {
  JsonBool { value: b }
}

fn json_int(n: Int) -> JsonValue {
  JsonNumber { lexeme: json_int_lexeme(n: n) }
}

fn json_number_from_lexeme_string(s: String) -> JsonValue? {
  match json_number_lexeme(s: s) {
    Present { value: l } => Present { value: JsonNumber { lexeme: l } }
    none => Absent
  }
}

fn json_string(s: String) -> JsonValue {
  JsonString { value: s }
}

fn json_array(elements: List<JsonValue>) -> JsonValue {
  JsonArray { elements: elements }
}

fn json_object(members: List<JsonKeyValue>) -> JsonValue {
  JsonObject { members: members }
}

fn json_unicode_escape_hex4(cp: Int) -> String {
  let h = int_to_upper_hex(n: cp)
  let len = h.length()
  if len == 1 { concat("000", h) }
  else if len == 2 { concat("00", h) }
  else if len == 3 { concat("0", h) }
  else { h }
}

fn json_escape_code_point(cp: Int) -> String {
  if cp == 8 { "\\b" }
  else if cp == 9 { "\\t" }
  else if cp == 10 { "\\n" }
  else if cp == 12 { "\\f" }
  else if cp == 13 { "\\r" }
  else if cp == 34 { "\\\"" }
  else if cp == 92 { "\\\\" }
  else if cp >= 0 && cp <= 31 { concat("\\u", json_unicode_escape_hex4(cp: cp)) }
  else { from_code_point(cp: cp) }
}

fn escape_json_string(s: String) -> String {
  json_emit_finish(acc: fold(
    chars(s: s),
    init: JsonEmitAcc { out: "", parts: [] },
    f: (acc, cp) => json_emit_push(acc: acc, part: json_escape_code_point(cp: cp)),
  ))
}

// SERIALIZATION IS CHUNK-FLUSHED, NOT CONCAT-ACCUMULATED (measured 2026-09-21 on the srv2-deploy
// instance: saving a project envelope -- ~7,050 authored sources, ~140MB of JSON -- never
// completed, because folding `concat(acc, part)` copies the whole accumulator per element and a
// whole-corpus document made every save quadratic in its own size; the belt's capture could stage
// but could never PERSIST). The flush accumulator keeps a small pending list and concatenates it
// once per granularity window, so the copy work stays proportional to the document size times a
// small factor instead of to its square. Output bytes are identical; only the building cost
// changes (DESIGN section 6: a proven cost-shape defect is always fixed).
data json_emit_flush_granularity: Int = 128

type JsonEmitAcc {
  out: String
  parts: List<String>
}

fn json_emit_push(acc: JsonEmitAcc, part: String) -> JsonEmitAcc {
  if count(acc.parts) >= json_emit_flush_granularity {
    JsonEmitAcc {
      out: concat(acc.out, join(reverse(acc.parts), "")),
      parts: [part],
    }
  } else {
    JsonEmitAcc { out: acc.out, parts: concat([part], acc.parts) }
  }
}

fn json_emit_finish(acc: JsonEmitAcc) -> String {
  concat(acc.out, join(reverse(acc.parts), ""))
}

fn quote_json_string(s: String) -> String {
  concat("\"", concat(escape_json_string(s: s), "\""))
}

fn serialize_json_string(s: String) -> String {
  quote_json_string(s: s)
}

fn join_json_values(items: List<JsonValue>) -> String {
  json_emit_finish(acc: fold(
    items,
    init: JsonEmitAcc { out: "", parts: [] },
    f: (acc, v) =>
      json_emit_push(
        acc: acc,
        part: if count(acc.parts) == 0 && acc.out == "" {
          serialize_json(v: v)
        } else {
          concat(", ", serialize_json(v: v))
        },
      ),
  ))
}

fn serialize_json_array(elements: List<JsonValue>) -> String {
  concat("[", concat(join_json_values(items: elements), "]"))
}

fn serialize_json_object_members(members: List<JsonKeyValue>) -> String {
  json_emit_finish(acc: fold(
    members,
    init: JsonEmitAcc { out: "", parts: [] },
    f: (acc, kv) =>
      json_emit_push(
        acc: acc,
        part: if count(acc.parts) == 0 && acc.out == "" {
          concat(concat(quote_json_string(s: kv.key), ": "), serialize_json(v: kv.value))
        } else {
          concat(", ", concat(concat(quote_json_string(s: kv.key), ": "), serialize_json(v: kv.value)))
        },
      ),
  ))
}

// serialize_json_object_prefix is the canonical serialization of an object's OPENING plus its
// leading members, no closing brace — the exact byte prefix every document beginning with those
// members must carry. A consumer can thus identify a document by its leading members POSITIONALLY
// (starts_with) instead of scanning for a fragment: a nested value can carry any fragment a scan
// looks for, but none can occupy the document's prefix. serialize_json_object is defined as this
// prefix plus the closing brace, so the two cannot drift.

fn serialize_json_object_prefix(members: List<JsonKeyValue>) -> String {
  concat("{", serialize_json_object_members(members: members))
}

fn serialize_json_object(members: List<JsonKeyValue>) -> String {
  concat(serialize_json_object_prefix(members: members), "}")
}

fn serialize_json(v: JsonValue) -> String {
  match v {
    JsonNull => "null"
    JsonBool { value: b } => if b { "true" } else { "false" }
    JsonNumber { lexeme: l } => l
    JsonString { value: s } => quote_json_string(s: s)
    JsonArray { elements: els } => serialize_json_array(elements: els)
    JsonObject { members: m } => serialize_json_object(members: m)
  }
}

fn json_int_list(nums: List<Int>) -> String {
  serialize_json_array(elements: nums |> map(n => json_int(n: n)))
}

fn json_str_list(items: List<String>) -> String {
  serialize_json_array(elements: items |> map(s => json_string(s: s)))
}
