module extdeps.languages.json.grammar

import std.types { String }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc8259"
  }
}

type JsonProductionRow {
  rfc_section: String
  lhs: String
  rhs: String
  value_variant: String
}

data json_production_rows: List<JsonProductionRow> = [
  JsonProductionRow { rfc_section: "3", lhs: "JSON-text", rhs: "ws value ws", value_variant: "JsonValue" },
  JsonProductionRow { rfc_section: "3", lhs: "value", rhs: "object | array | string | number | literal", value_variant: "JsonValue" },
  JsonProductionRow { rfc_section: "3", lhs: "object", rhs: "'{' ws member (',' ws member)* '}' | '{' ws '}'", value_variant: "JsonObject" },
  JsonProductionRow { rfc_section: "3", lhs: "member", rhs: "string ws ':' ws value", value_variant: "JsonKeyValue" },
  JsonProductionRow { rfc_section: "3", lhs: "array", rhs: "'[' ws value (',' ws value)* ']' | '[' ws ']'", value_variant: "JsonArray" },
  JsonProductionRow { rfc_section: "3", lhs: "string", rhs: "'\"' char* '\"'", value_variant: "JsonString" },
  JsonProductionRow { rfc_section: "3", lhs: "number", rhs: "minus? int frac? exp?", value_variant: "JsonNumber" },
  JsonProductionRow { rfc_section: "3", lhs: "literal", rhs: "'null' | 'true' | 'false'", value_variant: "JsonNull|JsonBool" },
]

type JsonNumberLexeme = String where brand("JsonNumberLexeme")

type JsonNumberParseRest {
  rest: String
  ok: Bool
}

fn is_json_digit_char(c: String) -> Bool {
  (c != "") && string_contains(s: "0123456789", pattern: c)
}

fn is_json_digit1_char(c: String) -> Bool {
  (c != "") && string_contains(s: "123456789", pattern: c)
}

fn json_number_consume_digit_run(s: String) -> JsonNumberParseRest {
  if s.length() == 0 {
    JsonNumberParseRest { rest: "", ok: true }
  } else {
    let first = char_at(s, 0)
    if !is_json_digit_char(c: first) {
      JsonNumberParseRest { rest: s, ok: true }
    } else {
      let inner = json_number_consume_digit_run(s: substring(s: s, start: 1, end: s.length()))
      JsonNumberParseRest { rest: inner.rest, ok: inner.ok }
    }
  }
}

fn json_number_consume_int(s: String) -> JsonNumberParseRest {
  if s.length() == 0 {
    JsonNumberParseRest { rest: s, ok: false }
  } else if char_at(s, 0) == "0" {
    JsonNumberParseRest { rest: substring(s: s, start: 1, end: s.length()), ok: true }
  } else if !is_json_digit1_char(c: char_at(s, 0)) {
    JsonNumberParseRest { rest: s, ok: false }
  } else {
    json_number_consume_digit_run(s: s)
  }
}

fn json_number_consume_frac_digits(s: String) -> JsonNumberParseRest {
  if s.length() == 0 {
    JsonNumberParseRest { rest: "", ok: false }
  } else {
    let first = char_at(s, 0)
    if !is_json_digit_char(c: first) {
      JsonNumberParseRest { rest: s, ok: false }
    } else {
      json_number_consume_digit_run(s: s)
    }
  }
}

fn json_number_consume_optional_frac(s: String) -> JsonNumberParseRest {
  if s.length() == 0 {
    JsonNumberParseRest { rest: "", ok: true }
  } else if char_at(s, 0) != "." {
    JsonNumberParseRest { rest: s, ok: true }
  } else {
    let after = substring(s: s, start: 1, end: s.length())
    let parsed = json_number_consume_frac_digits(s: after)
    JsonNumberParseRest { rest: parsed.rest, ok: parsed.ok }
  }
}

fn json_number_consume_optional_exp(s: String) -> Bool {
  if s.length() == 0 {
    true
  } else {
    let marker = char_at(s, 0)
    if marker != "E" && marker != "e" {
      false
    } else {
      let after = substring(s: s, start: 1, end: s.length())
      let signed = if after.length() > 0 && (char_at(after, 0) == "+" || char_at(after, 0) == "-") {
        substring(s: after, start: 1, end: after.length())
      } else {
        after
      }
      let parsed = json_number_consume_frac_digits(s: signed)
      parsed.ok && parsed.rest.length() == 0
    }
  }
}

fn json_number_lexeme_valid(s: String) -> Bool {
  if s.length() == 0 {
    false
  } else {
    let body = if starts_with(s: s, prefix: "-") {
      substring(s: s, start: 1, end: s.length())
    } else {
      s
    }
    if starts_with(s: s, prefix: "-") && body.length() == 0 {
      false
    } else {
      let int_parsed = json_number_consume_int(s: body)
      if !int_parsed.ok {
        false
      } else {
        let frac_parsed = json_number_consume_optional_frac(s: int_parsed.rest)
        if !frac_parsed.ok {
          false
        } else {
          json_number_consume_optional_exp(s: frac_parsed.rest)
        }
      }
    }
  }
}

fn json_number_lexeme_unchecked(s: String) -> JsonNumberLexeme {
  s as JsonNumberLexeme
}

fn json_number_lexeme(s: String) -> JsonNumberLexeme? {
  if json_number_lexeme_valid(s: s) {
    Present { value: json_number_lexeme_unchecked(s: s) }
  } else {
    none
  }
}

fn json_int_lexeme(n: Int) -> JsonNumberLexeme {
  json_number_lexeme_unchecked(s: to_string(n))
}

type JsonTextParseResult
  = JsonTextParseOk { end: Int }
  | JsonTextParseFail { end: Int }

type JsonWhitespaceChar
  = JsonWsSpace
  | JsonWsNewline
  | JsonWsCarriageReturn
  | JsonWsTab

fn json_text_trim_trailing_lf(body: String) -> String {
  if ends_with(s: body, suffix: "\n") {
    substring(s: body, start: 0, end: body.length() - 1)
  } else {
    body
  }
}

fn json_text_parse_fail(end: Int) -> JsonTextParseResult {
  JsonTextParseFail { end: end }
}

fn json_text_parse_ok(end: Int) -> JsonTextParseResult {
  JsonTextParseOk { end: end }
}

fn json_text_whitespace_char(c: String) -> JsonWhitespaceChar? {
  if c == " " {
    Present { value: JsonWsSpace }
  } else if c == "\n" {
    Present { value: JsonWsNewline }
  } else if c == "\r" {
    Present { value: JsonWsCarriageReturn }
  } else if c == "\t" {
    Present { value: JsonWsTab }
  } else {
    none
  }
}

fn json_text_skip_ws(s: String, i: Int) -> Int {
  if i >= s.length() {
    i
  } else {
    match json_text_whitespace_char(c: char_at(s: s, pos: i)) {
      Absent => i
      Present { value: _ } => json_text_skip_ws(s: s, i: i + 1)
    }
  }
}

fn json_text_starts_with_at(s: String, i: Int, lit: String) -> Bool {
  substring(s: s, start: i, end: i + lit.length()) == lit
}

// RFC 8259 section 7: escape = %x22 / %x5C / %x2F / %x62 / %x66 / %x6E / %x72 / %x74 / %x75
// 4HEXDIG. The set is CLOSED and \u carries exactly four hex digits. This scanner previously
// consumed the backslash and whatever followed it without deciding whether that character named an
// escape at all, so every unknown escape was accepted (review 45642 RED). The consequence was not
// cosmetic and not confined to the scanner: the unescaper's unknown-escape arm dropped the
// backslash, so `"p\assed"` - which is not JSON - decoded to the string `passed` and satisfied the
// validation receipt's verdict identity. A malformed document fabricated a pass, which is the
// fail-open DESIGN 5 forbids at exactly the boundary that exists to prevent it.\n\nThe refusal
// belongs HERE rather than in the unescaper because the escape set is a grammar production, and
// deciding it at the span scan means the invalid state never reaches the value builder -
// construction over validation. It also fixes both readings in one place: parse_json's strings come
// through this scanner, and so does the span question extdeps.llm.cli asks, so the two cannot
// disagree about what an escape is.\n\nNOT closed here, declared rather than left silent: RFC 8259
// also forbids UNESCAPED control characters (%x00-1F) inside a string, and this scanner still
// admits them. That gap cannot fabricate an identity the way an unknown escape can - a raw control
// character inside `passed` makes the string unequal to `passed` rather than equal to it - so it is
// a lesser member of the same family. Dissolve-on: the char production is scanned as a closed set
// rather than as everything-but-quote-and-backslash.

fn is_json_hex_digit_char(c: String) -> Bool {
  (c != "") && string_contains(s: "0123456789abcdefABCDEF", pattern: c)
}

fn json_hex_nibble(c: String) -> Int {
  if c == "0" { 0 }
  else if c == "1" { 1 }
  else if c == "2" { 2 }
  else if c == "3" { 3 }
  else if c == "4" { 4 }
  else if c == "5" { 5 }
  else if c == "6" { 6 }
  else if c == "7" { 7 }
  else if c == "8" { 8 }
  else if c == "9" { 9 }
  else if c == "a" || c == "A" { 10 }
  else if c == "b" || c == "B" { 11 }
  else if c == "c" || c == "C" { 12 }
  else if c == "d" || c == "D" { 13 }
  else if c == "e" || c == "E" { 14 }
  else if c == "f" || c == "F" { 15 }
  else { 0 - 1 }
}

fn json_hex4_at(s: String, i: Int) -> Int {
  if i + 4 > s.length() {
    0 - 1
  } else {
    let h0 = json_hex_nibble(c: char_at(s: s, pos: i))
    let h1 = json_hex_nibble(c: char_at(s: s, pos: i + 1))
    let h2 = json_hex_nibble(c: char_at(s: s, pos: i + 2))
    let h3 = json_hex_nibble(c: char_at(s: s, pos: i + 3))
    if h0 < 0 || h1 < 0 || h2 < 0 || h3 < 0 {
      0 - 1
    } else {
      h0 * 4096 + h1 * 256 + h2 * 16 + h3
    }
  }
}

// THE SHORT-ESCAPE SET, ONE SPELLING (RFC 8259 section 7: escape = %x22 / %x5C / %x2F / %x62 /
// %x66 / %x6E / %x72 / %x74 / %x75 4HEXDIG). The position walker below and the split-based
// piece validator in json_text_escape_piece_valid both consume this predicate, so the set cannot
// drift between the two scans.
fn json_text_short_escape_char(c: String) -> Bool {
  c == "\"" || c == "\\" || c == "/" || c == "b" || c == "f" || c == "n" || c == "r" || c == "t"
}

fn json_text_escape_end(s: String, i: Int) -> Int {
  if i >= s.length() {
    0 - 1
  } else {
    let e = char_at(s: s, pos: i)
    if json_text_short_escape_char(c: e) {
      i + 1
    } else if e == "u" {
      if i + 5 <= s.length()
        && is_json_hex_digit_char(c: char_at(s: s, pos: i + 1))
        && is_json_hex_digit_char(c: char_at(s: s, pos: i + 2))
        && is_json_hex_digit_char(c: char_at(s: s, pos: i + 3))
        && is_json_hex_digit_char(c: char_at(s: s, pos: i + 4)) {
        i + 5
      } else {
        0 - 1
      }
    } else {
      0 - 1
    }
  }
}

// THE STRING BODY SCAN IS THE NATIVE scan_string_end PRIMITIVE — one Rust pass over the bytes,
// escapes honored — in place of the per-character interpreted recursion, which was the read wall
// at envelope scale (measured 2026-09-23: roughly fourteen interpreter-minutes per megabyte of
// document, so the 104 MB project envelope's parse alone outran every other phase of the read
// put together). The scan's return keeps this production's convention: the position one past the
// closing quote. The two things the recursion used to decide on its walk are decided here
// without it: whether the scan actually TERMINATED on a quote (a final quote that is itself
// escaped is an unterminated string, refused — decided by pairing backslashes at the span
// boundary, one native replace, not a body re-walk), and whether every escape is in the RFC set
// (review 45642: the set is a grammar production and an unknown escape refuses before a value
// is built — validated over one native split, one interpreted step per escape rather than one
// per character).
fn json_text_parse_string_inner(s: String, i: Int) -> JsonTextParseResult {
  let end = scan_string_end(s: s, start: i)
  if end <= i || char_at(s: s, pos: end - 1) != "\"" {
    json_text_parse_fail(end: end)
  } else {
    if json_text_string_scan_terminated(s: s, body_start: i, end: end)
      && json_text_escape_set_valid(body: substring(s: s, start: i, end: end - 1)) {
      json_text_parse_ok(end: end)
    } else {
      json_text_parse_fail(end: end)
    }
  }
}

// TERMINATED MEANS THE QUOTE AT end-1 IS NOT ESCAPED. When the scan stopped before the end of
// the document it can only have stopped on an unescaped quote, so the question arises only when
// the scan ran to the document's end — where a terminated string and an escaped-final-quote both
// leave end == length. There the body is ambiguous only if the character before the quote is a
// backslash, and pairing backslashes from the left decides it: removing every non-overlapping
// pair is one native replace pass, preserves the parity of every run, and leaves a trailing
// backslash exactly when the run before the quote was odd.
fn json_text_string_scan_terminated(s: String, body_start: Int, end: Int) -> Bool {
  if end < s.length() {
    true
  } else {
    let before_quote = substring(s: s, start: body_start, end: end - 1)
    if !ends_with(s: before_quote, suffix: "\\") {
      true
    } else {
      !ends_with(s: replace(before_quote, "\\\\", ""), suffix: "\\")
    }
  }
}

// ONE NATIVE SPLIT, ONE INTERPRETED STEP PER ESCAPE. Splitting the body on the backslash yields
// a piece per escape: the first piece is literal text, an EMPTY piece is the escaped backslash
// (the two-backslash run resolves to a boundary between nothing), and any other piece begins
// with its escape letter — so the RFC set is exactly: empty, one of the eight short escapes, or
// u followed by four hex digits (json_hex4_at's own rule, including the length guard).
fn json_text_escape_piece_valid(piece: String) -> Bool {
  if piece == "" {
    true
  } else {
    let c = char_at(s: piece, pos: 0)
    if c == "u" {
      json_hex4_at(s: piece, i: 1) >= 0
    } else {
      json_text_short_escape_char(c: c)
    }
  }
}

// THE VALIDATOR WALKS THE SAME PARITY AS THE UNESCAPER: an empty piece is a \\ pair and the
// piece after it is literal — checking its head as an escape letter would refuse valid
// documents such as `\\q` (an escaped backslash followed by plain text), which the
// envelope-scale corpora genuinely contain.
fn json_text_escape_pieces_valid(pieces: List<String>, literal_next: Bool) -> Bool {
  match pieces.first() {
    Absent => true
    Present { value: head } =>
      if literal_next {
        json_text_escape_pieces_valid(pieces: drop_string_one(xs: pieces), literal_next: false)
      } else if head == "" {
        json_text_escape_pieces_valid(pieces: drop_string_one(xs: pieces), literal_next: true)
      } else {
        json_text_escape_piece_valid(piece: head)
          && json_text_escape_pieces_valid(pieces: drop_string_one(xs: pieces), literal_next: false)
      }
  }
}

fn json_text_escape_set_valid(body: String) -> Bool {
  match split(s: body, delimiter: "\\").first() {
    Absent => true
    Present { value: _ } =>
      json_text_escape_pieces_valid(pieces: drop_string_one(xs: split(s: body, delimiter: "\\")), literal_next: false)
  }
}

// DROPPING THE FIRST PIECE WITHOUT RE-TRAVERSING IT AS AN ESCAPE: the split's head is the
// literal text before the first backslash and is never an escape.
fn drop_string_one(xs: List<String>) -> List<String> {
  (fold(xs, init: PairAcc { skipped: false, kept: [] }, f: fn(acc, x) {
    if acc.skipped { PairAcc { skipped: true, kept: concat(acc.kept, [x]) } } else { PairAcc { skipped: true, kept: [] } }
  })).kept
}

type PairAcc { skipped: Bool, kept: List<String> }

fn json_text_parse_string(s: String, i: Int) -> JsonTextParseResult {
  if char_at(s: s, pos: i) != "\"" {
    json_text_parse_fail(end: i)
  } else {
    json_text_parse_string_inner(s: s, i: i + 1)
  }
}

fn json_text_parse_number_digits(s: String, i: Int) -> Int {
  if i >= s.length() || !is_json_digit_char(c: char_at(s: s, pos: i)) {
    i
  } else {
    json_text_parse_number_digits(s: s, i: i + 1)
  }
}

// RFC 8259 number = [minus] int [frac] [exp], and exp = (e/E) [minus/plus] 1*DIGIT — the exponent's
// digits are REQUIRED. This branch previously consumed the marker and optional sign and then
// accepted whatever json_text_parse_number_digits returned, so `1e` and `1e+` parsed as complete
// numbers; a receipt carrying one read as well-formed JSON (review 44043). The guard now mirrors
// the fraction branch directly above it: no digits means the exponent was never part of the number,
// so the scan backtracks to after_frac and the stray marker surfaces as unconsumed trailing input,
// which json_text_parseable and every enclosing production refuse. The sibling lexeme surface
// json_number_consume_optional_exp always required the digit — the two readings of one RFC
// production had forked (DESIGN 3), and this restores them to agreement.

fn json_text_parse_number(s: String, i: Int) -> JsonTextParseResult {
  let start = i
  let after_minus = if char_at(s: s, pos: i) == "-" { i + 1 } else { i }
  let after_int = json_text_parse_number_digits(s: s, i: after_minus)
  if after_int == after_minus && char_at(s: s, pos: after_minus) != "-" {
    json_text_parse_fail(end: start)
  } else {
    let after_frac = if char_at(s: s, pos: after_int) == "." {
      let d = json_text_parse_number_digits(s: s, i: after_int + 1)
      if d == after_int + 1 { after_int } else { d }
    } else {
      after_int
    }
    let end = if char_at(s: s, pos: after_frac) == "e" || char_at(s: s, pos: after_frac) == "E" {
      let exp = after_frac + 1
      let signed = if char_at(s: s, pos: exp) == "+" || char_at(s: s, pos: exp) == "-" { exp + 1 } else { exp }
      let exp_digits = json_text_parse_number_digits(s: s, i: signed)
      if exp_digits == signed { after_frac } else { exp_digits }
    } else {
      after_frac
    }
    if end > after_minus { json_text_parse_ok(end: end) } else { json_text_parse_fail(end: start) }
  }
}

fn json_text_parse_literal(s: String, i: Int, lit: String) -> JsonTextParseResult {
  if json_text_starts_with_at(s: s, i: i, lit: lit) {
    json_text_parse_ok(end: i + lit.length())
  } else {
    json_text_parse_fail(end: i)
  }
}

fn json_text_parse_array_values(s: String, i: Int) -> JsonTextParseResult {
  let p = json_text_skip_ws(s: s, i: i)
  if char_at(s: s, pos: p) == "]" {
    json_text_parse_ok(end: p + 1)
  } else {
    match json_text_parse_value(s: s, i: p) {
      JsonTextParseFail { end: e } => JsonTextParseFail { end: e }
      JsonTextParseOk { end: end } => {
        let q = json_text_skip_ws(s: s, i: end)
        if char_at(s: s, pos: q) == "]" {
          json_text_parse_ok(end: q + 1)
        } else if char_at(s: s, pos: q) == "," {
          let next = json_text_skip_ws(s: s, i: q + 1)
          if char_at(s: s, pos: next) == "]" {
            json_text_parse_fail(end: next)
          } else {
            json_text_parse_array_values(s: s, i: next)
          }
        } else {
          json_text_parse_fail(end: q)
        }
      }
    }
  }
}

fn json_text_parse_array(s: String, i: Int) -> JsonTextParseResult {
  if char_at(s: s, pos: i) != "[" {
    json_text_parse_fail(end: i)
  } else {
    json_text_parse_array_values(s: s, i: i + 1)
  }
}

fn json_text_parse_object_members(s: String, i: Int) -> JsonTextParseResult {
  let p = json_text_skip_ws(s: s, i: i)
  if char_at(s: s, pos: p) == "}" {
    json_text_parse_ok(end: p + 1)
  } else {
    match json_text_parse_string(s: s, i: p) {
      JsonTextParseFail { end: e } => JsonTextParseFail { end: e }
      JsonTextParseOk { end: key_end } => {
        let c = json_text_skip_ws(s: s, i: key_end)
        if char_at(s: s, pos: c) != ":" {
          json_text_parse_fail(end: c)
        } else {
          match json_text_parse_value(s: s, i: c + 1) {
            JsonTextParseFail { end: e } => JsonTextParseFail { end: e }
            JsonTextParseOk { end: val_end } => {
              let q = json_text_skip_ws(s: s, i: val_end)
              if char_at(s: s, pos: q) == "}" {
                json_text_parse_ok(end: q + 1)
              } else if char_at(s: s, pos: q) == "," {
                let next = json_text_skip_ws(s: s, i: q + 1)
                if char_at(s: s, pos: next) == "}" {
                  json_text_parse_fail(end: next)
                } else {
                  json_text_parse_object_members(s: s, i: next)
                }
              } else {
                json_text_parse_fail(end: q)
              }
            }
          }
        }
      }
    }
  }
}

fn json_text_parse_object(s: String, i: Int) -> JsonTextParseResult {
  if char_at(s: s, pos: i) != "{" {
    json_text_parse_fail(end: i)
  } else {
    json_text_parse_object_members(s: s, i: i + 1)
  }
}

// json_text_parseable used to live here, deciding on the span scanner alone whether a whole
// document was JSON. That is the same question extdeps.languages.json.parse answers by CONSTRUCTING
// the value, so the corpus had one procedure deciding whether text is JSON and another deciding
// what it contains - two readings of one RFC that can disagree (DESIGN 3; review 44043 was that
// disagreement, on the exponent production, found only because a witness pinned the surfaces
// together). The whole-document reading now derives from parse_json and lives beside it. What stays
// here is the SPAN question, which is a different question and has its own consumer:
// json_text_parse_value answers where a value ends at an offset INSIDE a larger text, which
// extdeps.llm.cli needs to walk a config document and which parse_json cannot answer because it
// requires full consumption. RESIDUAL FORK, declared rather than left silent:
// json_text_parse_object/_array and their counterparts in parse.dag still decide object and array
// syntax independently - parse.dag reuses the string and number scanners here but recurses on its
// own for the two container productions. Dissolve-on: extdeps.llm.cli takes its span from
// parse_json_value_at's next field, at which point
// json_text_parse_value/_object/_object_members/_array/_array_values/_literal have no consumer and
// delete, leaving one reading of every production.

fn json_text_parse_value(s: String, i: Int) -> JsonTextParseResult {
  let p = json_text_skip_ws(s: s, i: i)
  if p >= s.length() {
    json_text_parse_fail(end: p)
  } else {
    let c = char_at(s: s, pos: p)
    if c == "{" { json_text_parse_object(s: s, i: p) }
    else if c == "[" { json_text_parse_array(s: s, i: p) }
    else if c == "\"" { json_text_parse_string(s: s, i: p) }
    else if c == "t" { json_text_parse_literal(s: s, i: p, lit: "true") }
    else if c == "f" { json_text_parse_literal(s: s, i: p, lit: "false") }
    else if c == "n" { json_text_parse_literal(s: s, i: p, lit: "null") }
    else if c == "-" || is_json_digit_char(c: c) { json_text_parse_number(s: s, i: p) }
    else { json_text_parse_fail(end: p) }
  }
}
