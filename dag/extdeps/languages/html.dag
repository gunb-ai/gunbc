module extdeps.languages.html

import std.algebra { trim }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.communication.medium { Medium, Lossless }
import std.types { NonEmptyStr }
import std.markup {
  Fragment, Element, FragmentText, RawNode, Attribute, attr, MarkupDocument,
  MarkupBracket, MarkupMedium, CommentGrammar, DocumentGrammar, DeclaresDocument, EscapeHtml,
  VoidTagRendering, OmitClose,
  serialize_fragment_with, tag_in_set,
  unescape_text, unescape_attribute, unescape_url,
  attr_is_url_attr,
  HazardFree, HazardFound,
  fragment_hazard, document_hazard, serialize_document_with, MarkupSerializeResult, Serialized, Rejected,
}
import extdeps.uri_validation {
  validate_href, SafeHref, RejectedHref,
  find_first_rejected_url,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "html.spec.whatwg.org/"
  }
}

// Comment and document-type SPELLINGS of this language. They live here, not in whichever module emits a
// comment, because they are facts about HTML (§4: "a new target language is rows in extdeps/languages/,
// never an edit to the fold"), and they are governed by an upstream with its own version, which is where
// extdeps exists for (§122).
//
// One home, read rather than restated: std.languages' html_format and markdown_format now READ these rows
// instead of typing their own "<!-- " / " -->", so the characters exist once. They stay String? there
// because "this language has no block comment" is a real state of a generator's comment syntax, and the
// narrowing to Present is safe here because these rows are NonEmptyStr -- no fallback was chosen, because
// there is no absent case to fall back to. The two kinds of fact are still different: std.languages
// describes a language to a code GENERATOR (what to emit when commenting generated output); these rows are
// the tokenizer's own grammar, which a MARKUP SERIALIZER consults and the hazard walk checks -- including
// the terminator, which CommentSyntax does not carry and cannot, because "what stops a comment" is not a
// delimiting pair.
//
data html_comment_open_sequence: NonEmptyStr = "<!-- " as NonEmptyStr
data html_comment_close_sequence: NonEmptyStr = " -->" as NonEmptyStr
// The sequence the TOKENIZER ends a comment at has no leading space. The delimiter we EMIT does, for
// readability. They are deliberately two rows: a body must not contain the former, and what we write
// is the latter. Collapsing them would let a body ending in "--" close the comment while a guard
// looking only for " -->" found nothing.
// The tokenizer's "comment end state" is reached from "--" and requires no space (HTML §13.1.1),
// so this is NOT html_comment_close_sequence with the space dropped: a body of "a-->b" contains the
// terminator but not the close delimiter, and closing on one while checking for the other is how a
// comment escapes into the document. Feeds BOTH the guard and CommentGrammar.terminator, so the
// emitter and the checker read the same grammar and cannot disagree about what ends a comment.
data html_comment_terminator: NonEmptyStr = "-->" as NonEmptyStr

// Whether a body ENDING in "-" closes this medium's comment. True here: the emitter's own close
// delimiter contributes a "-", so "--" + that "-" reaches the comment end state.
data html_comment_trailing_dash_closes: Bool = true
// "<!DOCTYPE " with the trailing space the tokenizer requires between keyword and name.
data html_doctype_open_sequence: NonEmptyStr = "<!DOCTYPE " as NonEmptyStr
// The document type every HTML page in this repo declares. "html" is the only name a conforming
// parser understands; anything else puts the document in quirks mode. std.markup's
// doctype_name_hazard is what refuses a name that is not one bare token, and the Document arm of
// fragment_hazard runs it on the way down, so a page cannot be serialized with a malformed declaration.
data html_doctype_name: NonEmptyStr = "html" as NonEmptyStr

// The character that ends the token after "<!DOCTYPE" (HTML Living Standard §13.1.1, the "before the
// name" state: a space moves the tokenizer out of the keyword and into the name). A doctype name holding
// it would end the declaration early and push the document's first text into the declaration. The two
// angle brackets that also end it are NOT restated here -- the walk reads those off MarkupBracket, the
// same pair the serializer writes, so there is nothing here for them to drift from.
data html_doctype_name_end_whitespace: NonEmptyStr = " " as NonEmptyStr

data canonical_html_spellings: MarkupBracket = MarkupBracket {
  tag_open: "<",
  end_tag_open: "</",
  tag_close: ">",
  attr_sep: " ",
  attr_assign: "=",
  attr_quote: "\"",
}

type HtmlIngestResult
  = IngestedNode { node: Fragment }
  | IngestRejected { reason: String }

type HtmlSplitResult {
  children: String
  rest: String
}

type HtmlCloseState {
  depth: Int
  found: Bool
  child_chunks: List<String>
  rest_chunks: List<String>
  idx: Int
  total: Int
}

type HtmlAttrFoldState {
  attributes: List<Attribute>
  pending_name: String
  is_value: Bool
  rejected: Bool
  reject_reason: String
}

type HtmlParseOneResult
  = ParsedOne { node: Fragment, rest: String }
  | ParseOneRejected { reason: String }

type HtmlChildrenResult
  = ParsedChildren { nodes: List<Fragment> }
  | ChildrenRejected { reason: String }

fn html_count_str(s: String, pattern: String) -> Int {
  split(s: s, delimiter: pattern).length() - 1
}

fn html_strip_prefix(s: String, prefix: String) -> String {
  if starts_with(s: s, prefix: prefix) {
    substring(s: s, start: prefix.length(), end: s.length())
  } else {
    s
  }
}

fn html_strip_suffix(s: String, suffix: String) -> String {
  if ends_with(s: s, suffix: suffix) {
    substring(s: s, start: 0, end: s.length() - suffix.length())
  } else {
    s
  }
}

fn find_matching_close_with(s: String, tag: String, sp: MarkupBracket) -> HtmlSplitResult {
  let close_tag = join([sp.end_tag_open, tag, sp.tag_close], "")
  let open_pat = join([sp.tag_open, tag], "")
  let chunks = split(s: s, delimiter: close_tag)
  let n = chunks.length()
  let state = fold(chunks, init: HtmlCloseState {
    depth: 1,
    found: false,
    child_chunks: [],
    rest_chunks: [],
    idx: 0,
    total: n,
  }, f: (acc, chunk) => {
    if acc.found {
      HtmlCloseState {
        depth: acc.depth,
        found: true,
        child_chunks: acc.child_chunks,
        rest_chunks: concat(acc.rest_chunks, [chunk]),
        idx: acc.idx + 1,
        total: acc.total,
      }
    } else {
      let opens = html_count_str(s: chunk, pattern: open_pat)
      let has_delim = acc.idx < acc.total - 1
      let post_depth = if has_delim { acc.depth + opens - 1 } else { acc.depth + opens }
      let found_now = has_delim && (post_depth == 0)
      HtmlCloseState {
        depth: post_depth,
        found: found_now,
        child_chunks: concat(acc.child_chunks, [chunk]),
        rest_chunks: [],
        idx: acc.idx + 1,
        total: acc.total,
      }
    }
  })
  HtmlSplitResult {
    children: join(state.child_chunks, close_tag),
    rest: join(state.rest_chunks, close_tag),
  }
}

fn parse_attrs_with(attrs_str: String, sp: MarkupBracket) -> HtmlAttrFoldState {
  let pieces = split(s: attrs_str, delimiter: sp.attr_quote)
  fold(pieces, init: HtmlAttrFoldState {
    attributes: [],
    pending_name: "",
    is_value: false,
    rejected: false,
    reject_reason: "",
  }, f: (acc, piece) => {
    if acc.rejected {
      acc
    } else if acc.is_value {
      let name = acc.pending_name
      let raw_val = piece
      let is_url = attr_is_url_attr(name: name)
      let unescaped = if is_url { unescape_url(s: raw_val) } else { unescape_attribute(s: raw_val) }
      if is_url {
        match validate_href(url: unescaped) {
          RejectedHref { reason: _ } =>
            HtmlAttrFoldState {
              attributes: acc.attributes,
              pending_name: "",
              is_value: false,
              rejected: true,
              reject_reason: join(["rejected href: ", unescaped], ""),
            }
          SafeHref { url: safe } =>
            HtmlAttrFoldState {
              attributes: concat(acc.attributes, [attr(name: name, value: safe )]),
              pending_name: "",
              is_value: false,
              rejected: false,
              reject_reason: "",
            }
        }
      } else {
        HtmlAttrFoldState {
          attributes: concat(acc.attributes, [attr(name: name, value: unescaped )]),
          pending_name: "",
          is_value: false,
          rejected: false,
          reject_reason: "",
        }
      }
    } else {
      let stripped = html_strip_suffix(
        s: html_strip_prefix(s: piece, prefix: sp.attr_sep),
        suffix: sp.attr_assign
      )
      if stripped == "" {
        acc
      } else {
        HtmlAttrFoldState {
          attributes: acc.attributes,
          pending_name: stripped,
          is_value: true,
          rejected: false,
          reject_reason: "",
        }
      }
    }
  })
}

fn parse_one_with(s: String, sp: MarkupBracket) -> HtmlParseOneResult {
  if starts_with(s: s, prefix: sp.end_tag_open) {
    ParseOneRejected { reason: "unexpected end tag" }
  } else if starts_with(s: s, prefix: sp.tag_open) {
    match split(s: s, delimiter: sp.tag_close).first() {
      Absent => ParseOneRejected { reason: "open tag has no content" }
      Present { value: open_content } =>
        let after_open_tag = html_strip_prefix(s: s, prefix: join([open_content, sp.tag_close], ""))
        let tag_and_attrs = html_strip_prefix(s: open_content, prefix: sp.tag_open)
        let tag_parts = split(s: tag_and_attrs, delimiter: sp.attr_sep)
        match tag_parts.first() {
          Absent => ParseOneRejected { reason: "open tag has no name" }
          Present { value: tag } =>
            let attrs_raw = join(tag_parts.skip(n: 1), sp.attr_sep)
            let attr_result = parse_attrs_with(attrs_str: attrs_raw, sp: sp)
            if attr_result.rejected {
              ParseOneRejected { reason: attr_result.reject_reason }
            } else {
              let split_result = find_matching_close_with(s: after_open_tag, tag: tag, sp: sp)
              let children_result = parse_children_with(s: split_result.children, sp: sp)
              match children_result {
                ChildrenRejected { reason } => ParseOneRejected { reason: reason }
                ParsedChildren { nodes } =>
                  ParsedOne {
                    node: Element { tag: tag, attributes: attr_result.attributes, children: nodes },
                    rest: split_result.rest,
                  }
              }
            }
        }
    }
  } else {
    match split(s: s, delimiter: sp.tag_open).first() {
      Absent => ParseOneRejected { reason: "text fragment has no content" }
      Present { value: text_raw } =>
        let rest = html_strip_prefix(s: s, prefix: text_raw)
        ParsedOne { node: FragmentText { content: unescape_text(s: text_raw) }, rest: rest }
    }
  }
}

fn parse_children_with(s: String, sp: MarkupBracket) -> HtmlChildrenResult {
  if s == "" {
    ParsedChildren { nodes: [] }
  } else if starts_with(s: s, prefix: sp.end_tag_open) {
    ParsedChildren { nodes: [] }
  } else {
    let one = parse_one_with(s: s, sp: sp)
    match one {
      ParseOneRejected { reason } => ChildrenRejected { reason: reason }
      ParsedOne { node, rest } =>
        let tail = parse_children_with(s: rest, sp: sp)
        match tail {
          ChildrenRejected { reason } => ChildrenRejected { reason: reason }
          ParsedChildren { nodes } => ParsedChildren { nodes: concat([node], nodes) }
        }
    }
  }
}

data html5_void_tags: List<String> = [
  "area", "base", "br", "col", "embed", "hr", "img",
  "input", "link", "meta", "param", "source", "track", "wbr",
]

// The HTML spec's raw-text elements (HTML Standard section 13.1.2, 'Raw text elements'): script and
// style. Their text content is NOT entity-decoded by browsers, so entity-ESCAPING it at
// serialization corrupts it — a CSS child combinator '>' emitted as '&gt;' silently kills the rule
// in every browser (the roadmap strikethrough incident, 2026-07-24; same escape class as the
// dispatch-button inline-script incident). Serialization emits their text raw; the one hazard —
// content containing the element's own close sequence — REFUSES at try_serialize_html_source
// (typed, located), never emits corrupted output. textarea/title are the spec's escapable-raw-text
// class (entities ARE decoded there) and deliberately stay in the escaping default.

data html5_raw_text_tags: List<String> = ["script", "style"]

fn html_medium_with(sp: MarkupBracket) -> MarkupMedium {
  MarkupMedium {
    tag_overrides: [],
    bracket: sp,
    text_escape: EscapeHtml,
    void_tags: html5_void_tags,
    void_rendering: OmitClose,
    raw_text_tags: html5_raw_text_tags,
    // ONE value carries the whole comment grammar, and the serializer's delimiters and the checker's
    // terminator come from the same rows in this module -- so a language that spells its terminator
    // differently is a different medium, never a medium with two constants that disagree.
    comment_grammar: CommentGrammar {
      open: html_comment_open_sequence,
      close: html_comment_close_sequence,
      terminator: html_comment_terminator,
      trailing_dash_closes: html_comment_trailing_dash_closes,
    },
    document_grammar: DeclaresDocument {
      open: html_doctype_open_sequence,
      name_end_whitespace: html_doctype_name_end_whitespace,
    },
  }
}

fn serialize_html_source_with(node: Fragment, sp: MarkupBracket) -> String {
  serialize_fragment_with(frag: node, medium: html_medium_with(sp: sp))
}

fn serialize_html_source(node: Fragment) -> String {
  serialize_html_source_with(node: node, sp: canonical_html_spellings)
}

fn ingest_html_source_with(src: String, sp: MarkupBracket) -> HtmlIngestResult {
  let s = trim(src)
  let one = parse_one_with(s: s, sp: sp)
  match one {
    ParseOneRejected { reason } => IngestRejected { reason: reason }
    ParsedOne { node, rest: _ } => IngestedNode { node: node }
  }
}

fn ingest_html_source(src: String) -> HtmlIngestResult {
  ingest_html_source_with(src: src, sp: canonical_html_spellings)
}

fn html_medium_lossless(node: Fragment) -> Medium<Fragment> {
  Medium { carried: node, fidelity: Lossless }
}

type HtmlEmitResult
  = EmitOk { html: String }
  | EmitRejected { reason: String }

// ── HAZARDS: THERE ARE NO HAZARD FUNCTIONS HERE ANY MORE ─────────────────────────────────────────
// This module used to own seven of them (raw_text_hazard, raw_text_children_hazard,
// raw_text_children_text, comment_hazard, comment_children_hazard, comment_hazard_in, doctype_hazard),
// each returning String with "" meaning clean. Review 82181 on #14351 found the cost of that shape
// twice over. First, duplication: the JSX guarded route had NO counterpart, so a JSX comment holding
// "*/" closed early and the remainder was parsed as TSX, and a Document inside a JSX expression emitted
// "<!DOCTYPE html>" where no parser reads it — both returned JsxOk. A hazard written per language
// guards the languages someone remembered to write it for (§6b: "a repeated pattern is rejected until
// the author answers why it should not be generalized"). Second, the sentinel: `if hazard == ""` is a
// string test standing in for a type test, so a check that ever returned "" passed.
//
// Both are answered from one place. std.markup's fragment_hazard walks a Fragment and consults the
// MEDIUM for the language's comment grammar (comment_terminator, comment_trailing_dash_closes), so
// HTML, JSX, Markdown and SVG are covered by filling in the medium's own rows — which is also why
// html_medium_with now carries them, and why the emitter's close delimiter and the checker's
// terminator come from the same module's data rather than two constants that can drift.
// The closed sum (HazardFree | HazardFound) replaces the empty-string convention.
//
// The order is preserved and still deliberate: the URL pass runs FIRST, because a comment body may
// legitimately contain a URL-looking string ("<!-- see https://x -->") and find_first_rejected_url
// already skips comments; anything the URL pass rejects is refused before its text is examined.

fn try_serialize_html_source(node: Fragment) -> HtmlEmitResult {
  match find_first_rejected_url(node: node) {
    Present { value: r } =>
      EmitRejected { reason: r.url }
    Absent =>
      match fragment_hazard(node: node, medium: html_markup_medium()) {
        HazardFree => EmitOk { html: serialize_html_source(node: node) }
        HazardFound { reason: why } => EmitRejected { reason: why }
      }
  }
}

// A WHOLE PAGE, doctype included. Before this, the two sites that serve a page concatenated
// "<!DOCTYPE html>\n" onto the serialized string, so the doctype line sat OUTSIDE every guard and its
// spelling was one more hand-typed copy of "<!DOCTYPE" (§6b). It now rides the model to the one function
// allowed to write a document, and passes the same three guards as a fragment -- the URL pass over the
// root, the doctype-name check, and the comment/raw-text walk. The URL pass does not look at the doctype
// NAME: find_first_rejected_url flags attributes that carry URLs, and a doctype name is not one (a
// name holding "<", ">" or a space is refused by doctype_name_hazard before anything is written).
fn try_serialize_html_document(doc: MarkupDocument) -> HtmlEmitResult {
  match find_first_rejected_url(node: doc.root) {
    Present { value: r } =>
      EmitRejected { reason: r.url }
    Absent =>
      match document_hazard(doc: doc, medium: html_markup_medium()) {
        HazardFree => match serialize_document_with(doc: doc, medium: html_markup_medium()) {
          Serialized { html: out } => EmitOk { html: out }
          Rejected { reason: why } => EmitRejected { reason: why }
        }
        HazardFound { reason: why } => EmitRejected { reason: why }
      }
  }
}
fn html_markup_medium() -> MarkupMedium {
  html_medium_with(sp: canonical_html_spellings)
}
