module extdeps.languages.html

import std.algebra { trim }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.communication.medium { Medium, Lossless }
import std.markup {
  Fragment, Element, FragmentText, RawNode, Attribute, attr,
  MarkupBracket, MarkupMedium, EscapeHtml,
  VoidTagRendering, OmitClose,
  serialize_fragment_with, tag_in_set,
  unescape_text, unescape_attribute, unescape_url,
  attr_is_url_attr,
}
import extdeps.uri_validation {
  validate_href, SafeHref, RejectedHref,
  find_first_rejected_url,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "html.spec.whatwg.org/"
  }
}

// Comment and document-type SPELLINGS of this language. They live here, not in whichever module
// emits a comment, because they are facts about HTML (§4: "a new target language is rows in
// extdeps/languages/, never an edit to the fold"). std.languages already records a language's block
// comment delimiters for the text-generation path; these are the same characters, read once and
// placed on the medium, which is the object a serializer is allowed to consult.
data html_comment_open_sequence: String = "<!-- "
data html_comment_close_sequence: String = " -->"
// The sequence the TOKENIZER ends a comment at has no leading space. The delimiter we EMIT does, for
// readability. They are deliberately two rows: a body must not contain the former, and what we write
// is the latter. Collapsing them would let a body ending in "--" close the comment while a guard
// looking only for " -->" found nothing.
data html_comment_terminator: String = "-->"
// "<!DOCTYPE " with the trailing space the tokenizer requires between keyword and name.
data html_doctype_open_sequence: String = "<!DOCTYPE "
// The document type every HTML page in this repo declares. "html" is the only name a conforming
// parser understands; anything else puts the document in quirks mode, which doctype_hazard refuses.
data html_doctype_name: String = "html"

data canonical_html_spellings: MarkupBracket = MarkupBracket {
  tag_open: "<",
  end_tag_open: "</",
  tag_close: ">",
  attr_sep: " ",
  attr_assign: "=",
  attr_quote: "\"",
}

type HtmlIngestResult
  = IngestedNode { node: Fragment }
  | IngestRejected { reason: String }

type HtmlSplitResult {
  children: String
  rest: String
}

type HtmlCloseState {
  depth: Int
  found: Bool
  child_chunks: List<String>
  rest_chunks: List<String>
  idx: Int
  total: Int
}

type HtmlAttrFoldState {
  attributes: List<Attribute>
  pending_name: String
  is_value: Bool
  rejected: Bool
  reject_reason: String
}

type HtmlParseOneResult
  = ParsedOne { node: Fragment, rest: String }
  | ParseOneRejected { reason: String }

type HtmlChildrenResult
  = ParsedChildren { nodes: List<Fragment> }
  | ChildrenRejected { reason: String }

fn html_count_str(s: String, pattern: String) -> Int {
  split(s: s, delimiter: pattern).length() - 1
}

fn html_strip_prefix(s: String, prefix: String) -> String {
  if starts_with(s: s, prefix: prefix) {
    substring(s: s, start: prefix.length(), end: s.length())
  } else {
    s
  }
}

fn html_strip_suffix(s: String, suffix: String) -> String {
  if ends_with(s: s, suffix: suffix) {
    substring(s: s, start: 0, end: s.length() - suffix.length())
  } else {
    s
  }
}

fn find_matching_close_with(s: String, tag: String, sp: MarkupBracket) -> HtmlSplitResult {
  let close_tag = join([sp.end_tag_open, tag, sp.tag_close], "")
  let open_pat = join([sp.tag_open, tag], "")
  let chunks = split(s: s, delimiter: close_tag)
  let n = chunks.length()
  let state = fold(chunks, init: HtmlCloseState {
    depth: 1,
    found: false,
    child_chunks: [],
    rest_chunks: [],
    idx: 0,
    total: n,
  }, f: (acc, chunk) => {
    if acc.found {
      HtmlCloseState {
        depth: acc.depth,
        found: true,
        child_chunks: acc.child_chunks,
        rest_chunks: concat(acc.rest_chunks, [chunk]),
        idx: acc.idx + 1,
        total: acc.total,
      }
    } else {
      let opens = html_count_str(s: chunk, pattern: open_pat)
      let has_delim = acc.idx < acc.total - 1
      let post_depth = if has_delim { acc.depth + opens - 1 } else { acc.depth + opens }
      let found_now = has_delim && (post_depth == 0)
      HtmlCloseState {
        depth: post_depth,
        found: found_now,
        child_chunks: concat(acc.child_chunks, [chunk]),
        rest_chunks: [],
        idx: acc.idx + 1,
        total: acc.total,
      }
    }
  })
  HtmlSplitResult {
    children: join(state.child_chunks, close_tag),
    rest: join(state.rest_chunks, close_tag),
  }
}

fn parse_attrs_with(attrs_str: String, sp: MarkupBracket) -> HtmlAttrFoldState {
  let pieces = split(s: attrs_str, delimiter: sp.attr_quote)
  fold(pieces, init: HtmlAttrFoldState {
    attributes: [],
    pending_name: "",
    is_value: false,
    rejected: false,
    reject_reason: "",
  }, f: (acc, piece) => {
    if acc.rejected {
      acc
    } else if acc.is_value {
      let name = acc.pending_name
      let raw_val = piece
      let is_url = attr_is_url_attr(name: name)
      let unescaped = if is_url { unescape_url(s: raw_val) } else { unescape_attribute(s: raw_val) }
      if is_url {
        match validate_href(url: unescaped) {
          RejectedHref { reason: _ } =>
            HtmlAttrFoldState {
              attributes: acc.attributes,
              pending_name: "",
              is_value: false,
              rejected: true,
              reject_reason: join(["rejected href: ", unescaped], ""),
            }
          SafeHref { url: safe } =>
            HtmlAttrFoldState {
              attributes: concat(acc.attributes, [attr(name: name, value: safe )]),
              pending_name: "",
              is_value: false,
              rejected: false,
              reject_reason: "",
            }
        }
      } else {
        HtmlAttrFoldState {
          attributes: concat(acc.attributes, [attr(name: name, value: unescaped )]),
          pending_name: "",
          is_value: false,
          rejected: false,
          reject_reason: "",
        }
      }
    } else {
      let stripped = html_strip_suffix(
        s: html_strip_prefix(s: piece, prefix: sp.attr_sep),
        suffix: sp.attr_assign
      )
      if stripped == "" {
        acc
      } else {
        HtmlAttrFoldState {
          attributes: acc.attributes,
          pending_name: stripped,
          is_value: true,
          rejected: false,
          reject_reason: "",
        }
      }
    }
  })
}

fn parse_one_with(s: String, sp: MarkupBracket) -> HtmlParseOneResult {
  if starts_with(s: s, prefix: sp.end_tag_open) {
    ParseOneRejected { reason: "unexpected end tag" }
  } else if starts_with(s: s, prefix: sp.tag_open) {
    match split(s: s, delimiter: sp.tag_close).first() {
      Absent => ParseOneRejected { reason: "open tag has no content" }
      Present { value: open_content } =>
        let after_open_tag = html_strip_prefix(s: s, prefix: join([open_content, sp.tag_close], ""))
        let tag_and_attrs = html_strip_prefix(s: open_content, prefix: sp.tag_open)
        let tag_parts = split(s: tag_and_attrs, delimiter: sp.attr_sep)
        match tag_parts.first() {
          Absent => ParseOneRejected { reason: "open tag has no name" }
          Present { value: tag } =>
            let attrs_raw = join(tag_parts.skip(n: 1), sp.attr_sep)
            let attr_result = parse_attrs_with(attrs_str: attrs_raw, sp: sp)
            if attr_result.rejected {
              ParseOneRejected { reason: attr_result.reject_reason }
            } else {
              let split_result = find_matching_close_with(s: after_open_tag, tag: tag, sp: sp)
              let children_result = parse_children_with(s: split_result.children, sp: sp)
              match children_result {
                ChildrenRejected { reason } => ParseOneRejected { reason: reason }
                ParsedChildren { nodes } =>
                  ParsedOne {
                    node: Element { tag: tag, attributes: attr_result.attributes, children: nodes },
                    rest: split_result.rest,
                  }
              }
            }
        }
    }
  } else {
    match split(s: s, delimiter: sp.tag_open).first() {
      Absent => ParseOneRejected { reason: "text fragment has no content" }
      Present { value: text_raw } =>
        let rest = html_strip_prefix(s: s, prefix: text_raw)
        ParsedOne { node: FragmentText { content: unescape_text(s: text_raw) }, rest: rest }
    }
  }
}

fn parse_children_with(s: String, sp: MarkupBracket) -> HtmlChildrenResult {
  if s == "" {
    ParsedChildren { nodes: [] }
  } else if starts_with(s: s, prefix: sp.end_tag_open) {
    ParsedChildren { nodes: [] }
  } else {
    let one = parse_one_with(s: s, sp: sp)
    match one {
      ParseOneRejected { reason } => ChildrenRejected { reason: reason }
      ParsedOne { node, rest } =>
        let tail = parse_children_with(s: rest, sp: sp)
        match tail {
          ChildrenRejected { reason } => ChildrenRejected { reason: reason }
          ParsedChildren { nodes } => ParsedChildren { nodes: concat([node], nodes) }
        }
    }
  }
}

data html5_void_tags: List<String> = [
  "area", "base", "br", "col", "embed", "hr", "img",
  "input", "link", "meta", "param", "source", "track", "wbr",
]

// The HTML spec's raw-text elements (HTML Standard section 13.1.2, 'Raw text elements'): script and
// style. Their text content is NOT entity-decoded by browsers, so entity-ESCAPING it at
// serialization corrupts it — a CSS child combinator '>' emitted as '&gt;' silently kills the rule
// in every browser (the roadmap strikethrough incident, 2026-07-24; same escape class as the
// dispatch-button inline-script incident). Serialization emits their text raw; the one hazard —
// content containing the element's own close sequence — REFUSES at try_serialize_html_source
// (typed, located), never emits corrupted output. textarea/title are the spec's escapable-raw-text
// class (entities ARE decoded there) and deliberately stay in the escaping default.

data html5_raw_text_tags: List<String> = ["script", "style"]

fn html_medium_with(sp: MarkupBracket) -> MarkupMedium {
  MarkupMedium {
    tag_overrides: [],
    bracket: sp,
    text_escape: EscapeHtml,
    void_tags: html5_void_tags,
    void_rendering: OmitClose,
    raw_text_tags: html5_raw_text_tags,
    comment_open: html_comment_open_sequence,
    comment_close: html_comment_close_sequence,
    doctype_open: html_doctype_open_sequence,
  }
}

fn serialize_html_source_with(node: Fragment, sp: MarkupBracket) -> String {
  serialize_fragment_with(frag: node, medium: html_medium_with(sp: sp))
}

fn serialize_html_source(node: Fragment) -> String {
  serialize_html_source_with(node: node, sp: canonical_html_spellings)
}

fn ingest_html_source_with(src: String, sp: MarkupBracket) -> HtmlIngestResult {
  let s = trim(src)
  let one = parse_one_with(s: s, sp: sp)
  match one {
    ParseOneRejected { reason } => IngestRejected { reason: reason }
    ParsedOne { node, rest: _ } => IngestedNode { node: node }
  }
}

fn ingest_html_source(src: String) -> HtmlIngestResult {
  ingest_html_source_with(src: src, sp: canonical_html_spellings)
}

fn html_medium_lossless(node: Fragment) -> Medium<Fragment> {
  Medium { carried: node, fidelity: Lossless }
}

type HtmlEmitResult
  = EmitOk { html: String }
  | EmitRejected { reason: String }

fn raw_text_children_text(children: List<Fragment>) -> String {
  fold(children, init: "", f: (acc, c) => match c {
    FragmentText { content: t } => concat(acc, t)
    RawNode { content: t } => concat(acc, t)
    // A comment is not character data of the raw-text element, and a Document inside one is not
    // legitimate HTML; neither contributes text to the close-sequence check, which is about what the
    // raw-text element's own content would terminate early.
    MarkupComment { body: _ } => acc
    Document { doctype: _, root: _ } => acc
    Element { tag: _, attributes: _, children: _ } => acc
  })
}

fn raw_text_hazard(node: Fragment) -> String {
  match node {
    FragmentText { content: _ } => ""
    RawNode { content: _ } => ""
    // A comment is opaque text that decodes nothing, so it has no close sequence to collide with a
    // raw-text element's; its OWN early-termination hazard is a different check (comment_hazard).
    MarkupComment { body: _ } => ""
    // Walked, not skipped: same reason as find_first_rejected_url — a page reaches these guards as a
    // Document, and skipping it would certify an unchecked page.
    Document { doctype: _, root: r } => raw_text_hazard(node: r)
    Element { tag: t, attributes: _, children: kids } =>
      if tag_in_set(tag: t, tags: html5_raw_text_tags) {
        if string_contains(s: raw_text_children_text(children: kids), pattern: concat("</", t)) {
          join(["raw-text element <", t, "> content contains its own close sequence '</", t, "' — refusing to serialize (corruption otherwise); restructure the content"], "")
        } else {
          raw_text_children_hazard(children: kids)
        }
      } else {
        raw_text_children_hazard(children: kids)
      }
  }
}

// A comment ends at the first "-->" ("comment state": the tokenizer consumes to the first terminator
// and decodes nothing), so a body holding that sequence closes the comment early and the remainder
// is parsed as MARKUP in the served page — the same defect class raw_text_hazard refuses for
// <script>. Refused, never filtered: escaping cannot help (a comment decodes nothing) and stripping
// the sequence would change what the comment says.
// Returns the OFFENDING TEXT, or "" when clean. The "" sentinel is not a fail-open risk and not a
// second path beside the typed refusals: a hazard can only be reported by the caller that refuses,
// and refusals are each consumer's own closed sum (std.markup's Rejected, a page module's own). One
// shared refusal type here would put every consumer's causes in the language module and make this
// module depend on them. So these fns answer one question — "would serializing corrupt the output,
// and what text is at fault" — and return the text the consumer must quote, which no consumer can
// misread as clean because no hazard message is empty.
fn comment_hazard(body: String) -> String {
  if string_contains(s: body, pattern: html_comment_terminator) {
    join(["markup comment body contains the comment terminator '", html_comment_terminator, "' — refusing to serialize (the remainder would be parsed as markup); restructure the comment"], "")
  } else if ends_with(s: body, suffix: "-") {
    // The other abrupt-close the tokenizer accepts: "--" immediately before the delimiter's own "-"
    // also ends a comment (comment end state). Named separately because its remedy differs — shorten
    // the body, rather than remove a sequence from the middle of it.
    join(["markup comment body ends in '-' — adjacent to the close delimiter this forms an abrupt '-->' close; restructure the comment"], "")
  } else {
    ""
  }
}

// A <!DOCTYPE> name is a production, not free text: the tokenizer reads at most ONE token after the
// keyword, so a name holding whitespace or angle brackets makes the declaration swallow text and the
// document parse in the wrong mode (a page can silently land in quirks mode). Refusing anything but a
// single bare token is construction-side, so a malformed doctype cannot be written.
fn doctype_hazard(keyword: String) -> String {
  if keyword == "" {
    "doctype declares no document type — the name after <!DOCTYPE is what selects the parsing mode"
  } else if string_contains(s: keyword, pattern: "<") || string_contains(s: keyword, pattern: ">") || string_contains(s: keyword, pattern: " ") {
    join(["doctype name '", keyword, "' is not a single bare token — the tokenizer reads one token after <!DOCTYPE; anything else changes how the document parses"], "")
  } else {
    ""
  }
}

fn comment_children_hazard(children: List<Fragment>) -> String {
  fold(children, init: "", f: (acc, c) => if acc == "" { comment_hazard_in(node: c) } else { acc })
}

fn comment_hazard_in(node: Fragment) -> String {
  match node {
    MarkupComment { body: b } => comment_hazard(body: b)
    Document { doctype: d, root: r } => {
      let bad_doctype = doctype_hazard(keyword: d)
      if bad_doctype == "" { comment_hazard_in(node: r) } else { bad_doctype }
    }
    FragmentText { content: _ } => ""
    RawNode { content: _ } => ""
    Element { tag: _, attributes: _, children: kids } => comment_children_hazard(children: kids)
  }
}

fn raw_text_children_hazard(children: List<Fragment>) -> String {
  fold(children, init: "", f: (acc, c) => if acc == "" { raw_text_hazard(node: c) } else { acc })
}

fn try_serialize_html_source(node: Fragment) -> HtmlEmitResult {
  match find_first_rejected_url(node: node) {
    Present { value: r } =>
      EmitRejected { reason: r.url }
    Absent => {
      let hazard = raw_text_hazard(node: node)
      if hazard == "" {
        // Comment and doctype checks run last, not first, and the order is deliberate: a comment body
        // may legitimately contain a URL-looking string ("<!-- see https://x -->") and must not be
        // accused of carrying a reference it does not (find_first_rejected_url already skips comments),
        // while anything the URL pass rejects is refused before its text is examined at all.
        let comment_bad = comment_hazard_in(node: node)
        if comment_bad == "" {
          EmitOk { html: serialize_html_source(node: node) }
        } else {
          EmitRejected { reason: comment_bad }
        }
      } else {
        EmitRejected { reason: hazard }
      }
    }
  }
}

fn html_markup_medium() -> MarkupMedium {
  html_medium_with(sp: canonical_html_spellings)
}
