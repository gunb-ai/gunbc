module extdeps.languages.rust.syntax

import std.syntax {
  ItemForm, ItemFormKind, FuncForm, StructForm, EnumForm, TypeAliasForm, ModuleForm, OtherForm,
  BodyKind,
  ExprBody, BlockBody, TypeBody, NoBody,
  OperatorSpec, PrefixOperatorSpec, PostfixOperatorSpec, SyntaxSpec,
  BinOp, Add, Sub, Mul, Div, Mod,
  Eq, Ne, Lt, Gt, Le, Ge, And, Or,
  LiteralValue, LitBool
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/reference/"
  }
}

data rust_item_forms: List<ItemForm> = [
  ItemForm { kind: FuncForm, keyword: "fn", has_type_params: true, has_params: true,
    has_return_type: true, return_required: false,
    has_uses: false, body_kind: BlockBody },
  ItemForm { kind: StructForm, keyword: "struct", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: TypeBody },
  ItemForm { kind: EnumForm, keyword: "enum", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: TypeBody },
  ItemForm { kind: TypeAliasForm, keyword: "type", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: NoBody },
  ItemForm { kind: OtherForm, keyword: "trait", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: BlockBody },
  ItemForm { kind: OtherForm, keyword: "impl", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: BlockBody },
  ItemForm { kind: OtherForm, keyword: "const", has_type_params: false, has_params: false,
    has_return_type: true, return_required: true,
    has_uses: false, body_kind: ExprBody },
  ItemForm { kind: OtherForm, keyword: "static", has_type_params: false, has_params: false,
    has_return_type: true, return_required: true,
    has_uses: false, body_kind: ExprBody },
  ItemForm { kind: ModuleForm, keyword: "mod", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: BlockBody }
]

data rust_keyword_literals: Map<String, LiteralValue> = {
  "true": LitBool { value: true },
  "false": LitBool { value: false }
}

data rust_keyword_set: Map<String, Bool> = {
  "fn": true, "struct": true, "enum": true, "type": true, "trait": true,
  "impl": true, "const": true, "static": true, "mod": true, "use": true,
  "let": true, "mut": true, "return": true, "match": true, "if": true,
  "else": true, "for": true, "in": true, "while": true, "loop": true,
  "break": true, "continue": true, "pub": true, "self": true, "super": true,
  "crate": true, "as": true, "where": true, "ref": true, "move": true,
  "async": true, "await": true, "dyn": true, "unsafe": true, "extern": true,
  "true": true, "false": true
}

data rust_operators: List<OperatorSpec> = [
  OperatorSpec { symbol: "||", left_bp: 5, right_bp: 6, binop: Or, algebra_field: none },
  OperatorSpec { symbol: "&&", left_bp: 7, right_bp: 8, binop: And, algebra_field: none },
  OperatorSpec { symbol: "==", left_bp: 9, right_bp: 10, binop: Eq, algebra_field: none },
  OperatorSpec { symbol: "!=", left_bp: 9, right_bp: 10, binop: Ne, algebra_field: none },
  OperatorSpec { symbol: "<", left_bp: 11, right_bp: 12, binop: Lt, algebra_field: none },
  OperatorSpec { symbol: ">", left_bp: 11, right_bp: 12, binop: Gt, algebra_field: none },
  OperatorSpec { symbol: "<=", left_bp: 11, right_bp: 12, binop: Le, algebra_field: none },
  OperatorSpec { symbol: ">=", left_bp: 11, right_bp: 12, binop: Ge, algebra_field: none },
  OperatorSpec { symbol: "+", left_bp: 13, right_bp: 14, binop: Add, algebra_field: none },
  OperatorSpec { symbol: "-", left_bp: 13, right_bp: 14, binop: Sub, algebra_field: none },
  OperatorSpec { symbol: "*", left_bp: 15, right_bp: 16, binop: Mul, algebra_field: none },
  OperatorSpec { symbol: "/", left_bp: 15, right_bp: 16, binop: Div, algebra_field: none },
  OperatorSpec { symbol: "%", left_bp: 15, right_bp: 16, binop: Mod, algebra_field: none },
  OperatorSpec { symbol: ".", left_bp: 19, right_bp: 20, binop: none, algebra_field: none }
]

// Prefix (unary) rows of this language's table, beside the infix rows. 18 sits above every infix
// row the prefix must not absorb and below `.` at 19, which the operand's postfix layer consumes.
data rust_prefix_operators: List<PrefixOperatorSpec> = [
  PrefixOperatorSpec { symbol: "-", binding_power: 18 },
  PrefixOperatorSpec { symbol: "!", binding_power: 18 }
]

// See dag_postfix_operators in extdeps.languages.dag.syntax; this realization's expressions pass
// the same parser, so its rows carry the same thresholds.
data rust_postfix_operators: List<PostfixOperatorSpec> = [
  PostfixOperatorSpec { symbol: "(", binding_power: 21 },
  PostfixOperatorSpec { symbol: "[", binding_power: 21 },
  PostfixOperatorSpec { symbol: "as", binding_power: 19 },
  // The record-literal arm's threshold. Declared at 18 beside its dag sibling: at 13 the
  // consume-iff read moved a record literal OUT of a unary operand the prefix row at 18 used to
  // keep it inside (review 84349; measured over both routes, invocation jd1752ffb). See
  // dag_postfix_operators in extdeps.languages.dag.syntax for the full receipt.
  PostfixOperatorSpec { symbol: "{", binding_power: 18 }
]

data rust_syntax_spec: SyntaxSpec = SyntaxSpec {
  item_forms: rust_item_forms,
  operators: rust_operators,
  prefix_operators: rust_prefix_operators,
  postfix_operators: rust_postfix_operators,
  keyword_literals: rust_keyword_literals,
  keyword_set: rust_keyword_set
}
