module extdeps.languages.rust.types

import std.coercion {
  TypeCheckpoint, InhabitantDecl, CallableRepr, CastSyntax, CastRule
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/reference/types.html"
  }
}

data rust_type_checkpoints: List<TypeCheckpoint> = [
  { dag_name: "Int",    target_type: "i64",    default_expr: "0",              is_copy: true,  literal_suffix: none },
  { dag_name: "Float",  target_type: "f64",    default_expr: "0.0",            is_copy: true,  literal_suffix: none },
  { dag_name: "Bool",   target_type: "bool",   default_expr: "false",          is_copy: true,  literal_suffix: none },
  { dag_name: "Symbol", target_type: "String", default_expr: "String::new()",  is_copy: false, literal_suffix: ".to_string()" },
  { dag_name: "Unit",   target_type: "()",     default_expr: "()",             is_copy: true,  literal_suffix: none },
  { dag_name: "String", target_type: "String", default_expr: "String::new()",  is_copy: false, literal_suffix: ".to_string()" },
  { dag_name: "Bytes",  target_type: "Vec<u8>",           default_expr: "Vec::new()",           is_copy: false, literal_suffix: none },
  { dag_name: "Secret", target_type: "String",             default_expr: "String::new()",         is_copy: false, literal_suffix: ".to_string()" },
  { dag_name: "Json",   target_type: "serde_json::Value",  default_expr: "serde_json::Value::Null", is_copy: false, literal_suffix: none },
  { dag_name: "Hash",   target_type: "v1_rt::Hash",        default_expr: none,                    is_copy: false, literal_suffix: ".to_string()" },
  { dag_name: "Witness", target_type: "Witness",           default_expr: none,                    is_copy: false, literal_suffix: none },
  { dag_name: "witness", target_type: "Witness",           default_expr: none,                    is_copy: false, literal_suffix: none }
]

data rust_algebra_inhabitants: List<InhabitantDecl> = [

  { algebra: "FreeMonoid",
    template: "Vec<\{0\}>",
    arity: 1,
    identity_expr: "Vec::new()",
    import_path: none,
    is_copy: false },

  { algebra: "BooleanAlgebra",
    template: "std::collections::BTreeSet<\{0\}>",
    arity: 1,
    identity_expr: "BTreeSet::new()",
    import_path: "use std::collections::BTreeSet;",
    is_copy: false },

  { algebra: "PartialFunction",
    template: "HashMap<\{0\}, \{1\}>",
    arity: 2,
    identity_expr: "HashMap::new()",
    import_path: "use std::collections::HashMap;",
    is_copy: false },

  { algebra: "OrderedRing",
    template: "i64",
    arity: 0,
    identity_expr: "0i64",
    import_path: none,
    is_copy: true },

  { algebra: "ApproximateField",
    template: "f64",
    arity: 0,
    identity_expr: "0.0f64",
    import_path: none,
    is_copy: true }
]

data rust_optional_template: String = "Option<\{0\}>"
data rust_none_expr: String = "None"
data rust_some_template: String = "Some(\{0\})"

data rust_callable: CallableRepr = CallableRepr {
  template: "fn(\{params\}) -> \{return\}",
  param_separator: ", ",
  return_separator: " -> ",
  import_path: none
}

type OwnershipKind
  = Owned
  | SharedRef
  | MutRef
  | RawPtr

data pass_copy_by_value: Bool = true
data pass_non_copy_by_ref: Bool = true
data ref_prefix: String = "&"
data mut_ref_prefix: String = "&mut "

type SmartPointerKind
  = BoxPtr
  | RcPtr
  | ArcPtr

data box_template: String = "Box<\{0\}>"
data rc_template: String = "Rc<\{0\}>"
data arc_template: String = "Arc<\{0\}>"

data common_trait_bounds: List<String> = [
  "Clone", "Debug", "Send", "Sync", "Serialize", "Deserialize"
]

data where_clause_template: String = "where\n    \{constraints\}"
data trait_bound_template: String = "\{type\}: \{bound\}"

data integer_types: List<String> = [
  "i8", "i16", "i32", "i64", "i128", "isize",
  "u8", "u16", "u32", "u64", "u128", "usize"
]

data float_types: List<String> = ["f32", "f64"]

data rust_cast_syntax: CastSyntax = {
  template: "\{expr\} as \{type\}",
  cast_rules: [

    { from_type: "i64", to_type: "i64" },

    { from_type: "i64", to_type: "f64" },

    { from_type: "f64", to_type: "i64" },

    { from_type: "f64", to_type: "f64" },

    { from_type: "bool", to_type: "i64" }
  ]
}

data serde_enum_tag_attribute: String = "#[serde(tag = \"_variant\")]"
data serde_rename_template: String = "#[serde(rename = \"\{key\}\")]"
