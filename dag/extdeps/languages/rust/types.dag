module extdeps.languages.rust.types

data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "doc.rust-lang.org/reference/types.html"
  }
}

data rust_type_checkpoints: List<std.coercion.TypeCheckpoint> = [
  { dag_name: "Int",    target_type: "i64", grounding_type: "i64",    default_expr: "0",              is_copy: true,  literal_suffix: none },
  { dag_name: "Float",  target_type: "f64", grounding_type: "f64",    default_expr: "0.0",            is_copy: true,  literal_suffix: none },
  { dag_name: "Bool",   target_type: "bool", grounding_type: "bool",   default_expr: "false",          is_copy: true,  literal_suffix: none },
  { dag_name: "Symbol", target_type: "String", grounding_type: "String", default_expr: "String::new()",  is_copy: false, literal_suffix: ".to_string()" },
  { dag_name: "Unit",   target_type: "()", grounding_type: "()",     default_expr: "()",             is_copy: true,  literal_suffix: none },
  { dag_name: "String", target_type: "String", grounding_type: "std::string::String", default_expr: "String::new()",  is_copy: false, literal_suffix: ".to_string()" },
  { dag_name: "Bytes",  target_type: "Vec<u8>", grounding_type: "Vec<u8>",           default_expr: "Vec::new()",           is_copy: false, literal_suffix: none },
  { dag_name: "Secret", target_type: "String", grounding_type: "String",             default_expr: "String::new()",         is_copy: false, literal_suffix: ".to_string()" },
  { dag_name: "Json",   target_type: "serde_json::Value", grounding_type: "serde_json::Value",  default_expr: "serde_json::Value::Null", is_copy: false, literal_suffix: none }
]

data rust_checkpoint_hash_row_retired_note: String = "The Hash row is RETIRED, not rebound, and the distinction is the rule it follows: a target row survives only where some exact source declaration genuinely realizes that way. A census of every `type Hash` declaration in the corpus finds exactly ONE -- v2.std.node.Hash = Fnv1a64Structural (src/v2/std/node.dag) -- and it must NOT realize as v1_rt::Hash. Every remaining occurrence of that spelling in the seed is inside a STRING LITERAL in v1.runtime_rust, which is generated v1_rt.rs text rather than a .dag type reference, so no declaration is left for the row to bind. WHAT THE ROW COST WHILE IT STOOD, measured rather than predicted: Fnv1a64Structural's public record constructors are deleted precisely so the `where lower_hex_16` refinement IS its construction wall (std.content_hash content_hash_family_constructor_note), and this row rendered that carrier away as a bare String alias, taking the wall with it -- a DESIGN 4b construction rung demoted with no diagnostic anywhere. The live specimen is the emitted 05_eval closure: v2_std_node.rs carried `pub type Hash = v1_rt::Hash` while functions in the SAME file returned Rc<Fnv1a64Structural>, and the two disagreed at 70 distinct E0308 sites. checkpoint_table_bypasses_identity_note recorded this class from declarations at both ends and stated that no live site had been produced by anyone; that emission is the site. Retiring the row is INDEPENDENT of keying the remaining rows on declaration identity: those rows still bypass identity, still answer one spelling for two declarations, and the emitter's type renderer carries no module plumbing to key them on -- see checkpoint_table_bypasses_identity_note for that residue, which this change does not close."

data rust_checkpoint_scalar_arity_note: String = "A TypeCheckpoint row states one thing: how a target SPELLS a dag type whose Rust arity is zero. It cannot express arity, so membership of this table IS the emitter's arity-0 claim — v1.compiler.05_emit_rust rust_scalar_checkpoint_reference_base reads it, and rust_render_checkpoint_scalar_bare strips every type argument from any leaf it matches (the E0109 wall, rust_checkpoint_scalar_phantom_params_note). Witness/witness rows were removed here 2026-08-16: Witness is the generic enum v2.std.witness.Witness<C> (src/v2/std/witness.dag), arity 1 by its single authority std.types container_type_arity, so the rows made the emitter drop the argument of every Witness<T> in type position and emit `Rc<Witness>` — rustc E0107 'missing generics for enum Witness', 4 sites in the 06_translate closure alone (docs/probes/root_d_generic_arity_2026-08-16.md). Nothing else was lost with them: coerce_primitive_type renders the bare leaf name 'Witness' through qualified_last_segment either way, and is_copy's Absent arm and Present\{false\} arm are the same decision at every consumer. A generic type may not be added to this table; its spelling is not the missing fact, its arity is."

// THE TYPE-NAME CATALOG IS NOT HERE. `integer_types` and `float_types` — bare `List<String>`
// name lists with no consumers — once sat in this module and were deleted; the single
// authority for how a Rust primitive is spelled is `extdeps.languages.rust.primitives`
// `rust_grounding_primitives`, through its `target_name` rows. A name list here would be
// a second spelling authority for one fact.
data rust_algebra_inhabitants: List<InhabitantDecl> = [

  { algebra: "FreeMonoid",
    template: "Vec<\{0\}>",
    arity: 1,
    identity_expr: "Vec::new()",
    import_path: none,
    is_copy: false },

  { algebra: "BooleanAlgebra",
    template: "BTreeSet<\{0\}>",
    arity: 1,
    identity_expr: "BTreeSet::new()",
    import_path: none,
    is_copy: false },

  { algebra: "PointwisePower",
    template: "BTreeSet<\{0\}>",
    arity: 1,
    identity_expr: "BTreeSet::new()",
    import_path: none,
    is_copy: false },

  { algebra: "PartialFunction",
    template: "HashMap<\{0\}, \{1\}>",
    arity: 2,
    identity_expr: "HashMap::new()",
    import_path: none,
    is_copy: false },

  { algebra: "OrderedRing",
    template: "i64",
    arity: 0,
    identity_expr: "0i64",
    import_path: none,
    is_copy: true },

  { algebra: "ApproximateField",
    template: "f64",
    arity: 0,
    identity_expr: "0.0f64",
    import_path: none,
    is_copy: true }
]

data rust_optional_template: String = "Option<\{0\}>"
data rust_none_expr: String = "None"
data rust_some_template: String = "Some(\{0\})"

data rust_callable: std.coercion.CallableRepr = std.coercion.CallableRepr {
  template: "fn(\{params\}) -> \{return\}",
  param_separator: ", ",
  return_separator: " -> ",
  import_path: none
}

type OwnershipKind
  = Owned
  | SharedRef
  | MutRef
  | RawPtr

data pass_copy_by_value: Bool = true
data pass_non_copy_by_ref: Bool = true
data ref_prefix: String = "&"
data mut_ref_prefix: String = "&mut "

type SmartPointerKind
  = BoxPtr
  | RcPtr
  | ArcPtr

data box_template: String = "Box<\{0\}>"
data rc_template: String = "Rc<\{0\}>"
data arc_template: String = "Arc<\{0\}>"

data common_trait_bounds: List<String> = [
  "Clone", "Debug", "Send", "Sync", "Serialize", "Deserialize"
]

data where_clause_template: String = "where\n    \{constraints\}"
data trait_bound_template: String = "\{type\}: \{bound\}"

data rust_cast_syntax: std.coercion.CastSyntax = {
  template: "\{expr\} as \{type\}",
  cast_rules: [

    { from_type: "i64", to_type: "i64" },

    { from_type: "i64", to_type: "f64" },

    { from_type: "f64", to_type: "i64" },

    { from_type: "f64", to_type: "f64" },

    { from_type: "bool", to_type: "i64" }
  ]
}

data serde_enum_tag_attribute: String = "#[serde(tag = \"_variant\")]"
data serde_rename_template: String = "#[serde(rename = \"\{key\}\")]"

data rust_types_name_catalog_dissolve_on: std.dissolution.DissolutionCondition = unbound_dissolution(description: "dissolve-on: rust.types.integer_types/float_types — deleted bare String name lists with zero consumers; sole type-name catalog authority is extdeps.languages.rust.primitives rust_grounding_primitives.target_name rows.")
