data rust_vec_freemonoid_supplemental_generic_bound_rows_note: String = "SINGLE AUTHORITY for the trait -> supplemental-generic-bound facts of the FreeMonoid/Vec realization (im-15.1.0 im::Vector): deriving Debug, PartialEq, Serialize or Deserialize for an item carrying an im::Vector<P> field additionally requires P: Clone, because each of those upstream impls is conditional on A: Clone (cited per row). Clone itself is deliberately NOT a row: derive(Clone) emits a conditional impl whose own A: Clone requirement is exactly im::Vector's, so no supplemental fact exists for it (im_15_1_0_vector_clone_impl_authority documents the upstream impl, consumed by the v2 contract map's requirement-free Clone entry). This module is dag-rooted so BOTH pools read one authority: the v1 seed emitter (regen pool [src/v1, dag]) consumes these rows in v1.compiler.trait_derive_emit, and v2.extdeps.languages.rust builds its typed target_model contract map (rust_vec_supplemental_generic_bound_contracts) by folding these same rows — the mapping formerly restated there is collapsed onto this list (coordinating-session ruling, smart-ram-730 (a session, not the operator) 2026-08-19: consume, do not mint a second copy or a witness to police one)."

type RustVecSupplementalGenericBoundRow {
  derive_trait: ReprGroundingDeriveTrait
  required: ReprGroundingDeriveTrait
  authority: ExternalAuthority
}

data rust_vec_freemonoid_supplemental_generic_bound_rows: List<RustVecSupplementalGenericBoundRow> = [
  RustVecSupplementalGenericBoundRow {
    derive_trait: ReprDeriveDebug
    required: ReprDeriveClone
    authority: im_15_1_0_vector_debug_impl_authority
  },
  RustVecSupplementalGenericBoundRow {
    derive_trait: ReprDerivePartialEq
    required: ReprDeriveClone
    authority: im_15_1_0_vector_partial_eq_impl_authority
  },
  RustVecSupplementalGenericBoundRow {
    derive_trait: ReprDeriveSerialize
    required: ReprDeriveClone
    authority: im_15_1_0_vector_serialize_impl_authority
  },
  RustVecSupplementalGenericBoundRow {
    derive_trait: ReprDeriveDeserialize
    required: ReprDeriveClone
    authority: im_15_1_0_vector_deserialize_impl_authority
  },
]

data rust_btree_set_supplemental_generic_bound_rows_note: String = "SINGLE AUTHORITY for the trait -> supplemental-generic-bound facts of the Set/BTreeSet realization (rustc 1.93 std::collections::BTreeSet): BTreeSet<T>'s own Debug, Clone, PartialEq and Serialize impls need only T's natural per-field bound (cited to rust_1_93_btree_set_trait_implementations_authority / serde_1_0_228_btree_set_serialize_authority in the v2 contract map, which does not fold this row list because those four require no element-type SUPPLEMENT beyond the derive's natural bound). Only Deserialize is conditional on an extra bound past its natural Deserialize<'de> requirement: impl<'de, T: Deserialize<'de> + Ord> Deserialize<'de> for BTreeSet<T> — BTreeSet must reconstruct its ordering invariant during deserialization, so Ord is required even though no derived Deserialize impl would otherwise ask for it. This module is dag-rooted so both pools read one authority: the v1 seed emitter (regen pool [src/v1, dag]) consumes this row in v1.compiler.trait_derive_emit, and v2.extdeps.languages.rust folds it into rust_btree_set_supplemental_generic_bound_contracts's Deserialize entry — mirroring rust_vec_freemonoid_supplemental_generic_bound_rows's row-authority split rather than restating the requirement inline a second time."

data rust_btree_set_supplemental_generic_bound_rows: List<RustVecSupplementalGenericBoundRow> = [
  RustVecSupplementalGenericBoundRow {
    derive_trait: ReprDeriveDeserialize
    required: ReprDeriveOrd
    authority: serde_1_0_228_btree_set_deserialize_authority
  },
]

type RustSupplementalGenericBoundContractCoverageDisposition {
  owner: DeclarationRef
  lane: DeclarationRef
  dissolution: Disposition
}

data rust_hash_set_supplemental_generic_bound_contract_coverage_disposition: RustSupplementalGenericBoundContractCoverageDisposition = RustSupplementalGenericBoundContractCoverageDisposition {
  owner: DeclarationRef {
    module_path: "v2.std.compilers.target_model",
    decl_name: "TargetDeriveSupplementalGenericBoundRequirementSet",
    field: WholeDeclaration
  },
  lane: DeclarationRef {
    module_path: "v2.std.compilers.target_model",
    decl_name: "RequiredTraitWitness",
    field: WholeDeclaration
  },
  dissolution: Scaffold {
    dissolves_to: SingleAuthority,
    bind: DeclarationRef {
      module_path: "v2.std.compilers.target_model",
      decl_name: "RequiredTraitWitness",
      field: WholeDeclaration
    }
  }
}
