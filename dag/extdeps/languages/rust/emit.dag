data rust_struct_derives: String = rust_trait_derive_attr_from_traits(record_derive_traits_heap())

data rust_struct_derives_copy: String = rust_trait_derive_attr_from_traits(record_derive_traits_copy())
data rust_enum_derives: String = rust_trait_derive_attr_from_traits(payload_coproduct_derive_traits())

data rust_enum_derives_copy: String = rust_trait_derive_attr_from_traits(nullary_coproduct_derive_traits())

fn rust_trait_derive_spelling(derive_trait: ReprGroundingDeriveTrait) -> String {
  match derive_trait {
    ReprDeriveDebug => "Debug"
    ReprDeriveClone => "Clone"
    ReprDeriveCopy => "Copy"
    ReprDerivePartialEq => "PartialEq"
    ReprDeriveEq => "Eq"
    ReprDerivePartialOrd => "PartialOrd"
    ReprDeriveOrd => "Ord"
    ReprDeriveSerialize => "serde::Serialize"
    ReprDeriveDeserialize => "serde::Deserialize"
    ReprDeriveAdd => "std::ops::Add"
    ReprDeriveSub => "std::ops::Sub"
    ReprDeriveMul => "std::ops::Mul"
    ReprDeriveDiv => "std::ops::Div"
    ReprDeriveRem => "std::ops::Rem"
    ReprDeriveNeg => "std::ops::Neg"
  }
}

fn rust_trait_derive_attr_from_traits(traits: List<ReprGroundingDeriveTrait>) -> String {
  concat(
    "#[derive(",
    traits |> map(t => rust_trait_derive_spelling(t)) |> join(separator: ", "),
    ")]"
  )
}

