module extdeps.languages.rust.subject

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "doc.rust-lang.org/reference/"
  }
}

data rust_language_further_authority_1: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.rust-lang.org/"
  }
}

data rust_language_subject_note: String = "THE RUST LANGUAGE, cited to The Rust Reference (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched document self-describes as 'the primary reference for the Rust programming language', is published by the Rust project at github.com/rust-lang/reference, and tracks each six-week language release. Rust has no ISO-style specification, so the Reference is the authority rather than a standard document — that is a fact about Rust's governance, not a gap in this citation. SUBJECT SCOPE: this is the LANGUAGE. Cargo and rustc are separate upstream products with their own governance and belong in their own subject declarations if they are ever registered as targets; the RuntimeChecker census row for extdeps.rust.cargo is deliberately NOT joined to this subject for that reason."

type Rust
  = | RustTarget

data rust_language: Rust = RustTarget

data rust_language_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.languages.rust.subject",
      decl_name: "rust_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [rust_language_further_authority_1]
}

data rust_language_mandated_scope_name_scaffold_note: String = "DECLARED SCAFFOLD — the shared explanation and both dissolution triggers live once at gunbc.language_subject_scope_scaffold mandated_scope_name_scaffold, and are deliberately not repeated inside an upstream subject carrier (cursor review 48122)."

data extdeps_model_scope: ExternalModelScope = rust_language_model_scope
