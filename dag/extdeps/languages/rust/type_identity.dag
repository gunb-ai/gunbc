module extdeps.languages.rust.type_identity

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.languages.rust.primitives { RustPrimitive, IntegerPrimitive, NonIntegerPrimitive, rust_grounding_primitives }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/reference/types.html"
  }
}

// A Rust type's IDENTITY, distinct from the text Rust spells it with. The distinction is
// load-bearing rather than fastidious: a realization binding that pointed at final text would make
// the rendered string the identity under a more respectable field name, which is the same
// text-as-fact defect the binding exists to remove. Text is a projection of this carrier
// (render_rust_type_identity), never its definition, and the projection is deliberately one-way.
//
// Three arms, because Rust distinguishes three things a TypeCheckpoint row fuses into one String:
// a primitive whose facts are already grounded in rust_grounding_primitives; a named or path type
// with no primitive row, spelled by its path; and an applied type whose base and arguments are
// separate facts. `Vec<u8>` is not a name -- it is a base applied to an argument, and a carrier
// unable to say so cannot express arity. That is the exact gap rust_checkpoint_scalar_arity_note
// records as the cause of the emitted `Rc<Witness>` E0107 class.
type RustTypeIdentity
  = RustPrimitiveType { target_name: String }
  | RustNamedType { path: String }
  | RustAppliedType { base: String, args: List<RustTypeIdentity> }

fn rust_primitive_target_name(p: RustPrimitive) -> String {
  match p {
    IntegerPrimitive { target_name: n, algebra: _, carrier: _, range_min_inclusive: _, range_max_inclusive: _, is_copy: _, overflow: _ } => n
    NonIntegerPrimitive { target_name: n, algebra: _, carrier: _, is_copy: _ } => n
  }
}

// The join that keeps RustPrimitiveType honest. A primitive arm names a row in the cited grounding
// table; if no row carries that name the arm is not a primitive, and this refuses with Absent
// rather than fabricating one. Without it `RustPrimitiveType { target_name: "i65" }` would be
// writable and would render as plausible Rust.
fn rust_primitive_row(target_name: String) -> RustPrimitive? {
  rust_grounding_primitives
    |> filter(p => rust_primitive_target_name(p: p) == target_name)
    |> first
}

fn rust_type_identity_is_grounded(id: RustTypeIdentity) -> Bool {
  match id {
    RustPrimitiveType { target_name: n } =>
      match rust_primitive_row(target_name: n) {
        Present { value: _ } => true
        Absent => false
      }
    RustNamedType { path: p } => string_length(s: p) > 0
    RustAppliedType { base: b, args: a } => string_length(s: b) > 0 && list_length(a) > 0
  }
}

fn render_rust_type_identity(id: RustTypeIdentity) -> String {
  match id {
    RustPrimitiveType { target_name: n } => n
    RustNamedType { path: p } => p
    RustAppliedType { base: b, args: a } =>
      concat(b, "<", a |> map(x => render_rust_type_identity(id: x)) |> join(separator: ", "), ">")
  }
}
