module extdeps.languages.yaml.emit


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "yaml.org/spec/1.2.2/"
  }
}

data yaml_protocol: std.layout.LayoutProtocol = std.layout.LayoutProtocol { indent_unit: "  " }

fn is_expression(s: String) -> Bool {
  starts_with(s: s, prefix: "${{")
}

fn is_reserved_yaml_scalar(s: String) -> Bool {
  (s == "true") ||
    (s == "false") ||
    (s == "null") ||
    (s == "yes") ||
    (s == "no") ||
    (s == "~")
}

fn starts_with_yaml_indicator(s: String) -> Bool {
  starts_with(s: s, prefix: "- ") ||
    starts_with(s: s, prefix: "?") ||
    starts_with(s: s, prefix: ":") ||
    starts_with(s: s, prefix: ",") ||
    starts_with(s: s, prefix: "[") ||
    starts_with(s: s, prefix: "]") ||
    starts_with(s: s, prefix: "{") ||
    starts_with(s: s, prefix: "}") ||
    starts_with(s: s, prefix: "#") ||
    starts_with(s: s, prefix: "&") ||
    starts_with(s: s, prefix: "*") ||
    starts_with(s: s, prefix: "!") ||
    starts_with(s: s, prefix: "|") ||
    starts_with(s: s, prefix: ">") ||
    starts_with(s: s, prefix: "'") ||
    starts_with(s: s, prefix: "\"") ||
    starts_with(s: s, prefix: "%") ||
    starts_with(s: s, prefix: "@") ||
    starts_with(s: s, prefix: "`")
}

fn needs_double_quotes(s: String) -> Bool {
  is_reserved_yaml_scalar(s: s) ||
    starts_with_yaml_indicator(s: s) ||
    string_contains(s: s, pattern: ": ") ||
    string_contains(s: s, pattern: " #")
}

fn escape_double_quoted(s: String) -> String {
  replace(replace(s, "\\", "\\\\"), "\"", "\\\"")
}

fn emit_inline_scalar_text(s: String) -> String {
  if s == "" {
    "''"
  } else if is_expression(s: s) {
    s
  } else if needs_double_quotes(s: s) {
    concat(concat("\"", escape_double_quoted(s: s)), "\"")
  } else {
    s
  }
}

fn emit_scalar(v: extdeps.languages.yaml.types.YamlValue) -> String {
  match v {
    extdeps.languages.yaml.types.YamlNull => ""
    extdeps.languages.yaml.types.YamlBool { value: b } => if b { "true" } else { "false" }
    extdeps.languages.yaml.types.YamlInt { lexeme: l } => l
    extdeps.languages.yaml.types.YamlFloat { lexeme: l } => l
    extdeps.languages.yaml.types.YamlString { value: s } => emit_inline_scalar_text(s: s)
    extdeps.languages.yaml.types.YamlSequence { elements: _ } => ""
    extdeps.languages.yaml.types.YamlMapping { entries: _ } => ""
  }
}

fn all_scalars_flowable(elements: List<extdeps.languages.yaml.types.YamlValue>) -> Bool {
  fold(elements, init: true, f: (acc, e) => acc && match e {
    extdeps.languages.yaml.types.YamlString { value: s } => !string_contains(s: s, pattern: "\n")
    extdeps.languages.yaml.types.YamlInt { lexeme: _ } => true
    extdeps.languages.yaml.types.YamlBool { value: _ } => true
    _ => false
  })
}

fn emit_flow_sequence(elements: List<extdeps.languages.yaml.types.YamlValue>) -> String {
  concat(
    concat(
      "[",
      fold(elements, init: "", f: (acc, e) => {
        let part = emit_scalar(v: e)
        if acc == "" { part } else { concat(concat(acc, ", "), part) }
      })
    ),
    "]"
  )
}

fn nested_body_doc(body: std.layout.Doc) -> std.layout.Doc {
  std.layout.doc_nest(levels: 1, body: std.layout.doc_concat(parts: [std.layout.DocLine, body]))
}

fn multiline_block_doc(prefix: String, s: String) -> std.layout.Doc {
  let lines = filter(split(s: s, delimiter: "\n"), l => l != "")
  let content = fold(lines, init: [], f: (acc, l) => append(acc, items: [std.layout.DocLine, std.layout.doc_text(text: l)]))
  std.layout.doc_concat(parts: [
    std.layout.doc_text(text: concat(prefix, "|")),
    std.layout.doc_nest(levels: 1, body: std.layout.doc_concat(parts: content)),
    std.layout.DocLine
  ])
}

fn entry_doc(entry: extdeps.languages.yaml.types.YamlKeyValue) -> std.layout.Doc {
  let key = entry.key
  let val = entry.value
  match val {
    extdeps.languages.yaml.types.YamlNull => std.layout.doc_line_of(text: concat(key, ":"))
    extdeps.languages.yaml.types.YamlMapping { entries: nested } =>
      std.layout.doc_concat(parts: [std.layout.doc_text(text: concat(key, ":")), nested_body_doc(body: mapping_body_doc(entries: nested))])
    extdeps.languages.yaml.types.YamlSequence { elements: els } =>
      if all_scalars_flowable(elements: els) {
        std.layout.doc_line_of(text: concat(concat(key, ": "), emit_flow_sequence(elements: els)))
      } else {
        std.layout.doc_concat(parts: [std.layout.doc_text(text: concat(key, ":")), nested_body_doc(body: block_sequence_doc(elements: els))])
      }
    extdeps.languages.yaml.types.YamlString { value: s } =>
      if string_contains(s: s, pattern: "\n") {
        multiline_block_doc(prefix: concat(key, ": "), s: s)
      } else {
        std.layout.doc_line_of(text: concat(concat(key, ": "), emit_inline_scalar_text(s: s)))
      }
    _ => std.layout.doc_line_of(text: concat(concat(key, ": "), emit_scalar(v: val)))
  }
}

fn mapping_body_doc(entries: List<extdeps.languages.yaml.types.YamlKeyValue>) -> std.layout.Doc {
  std.layout.doc_concat(parts: map(entries, e => entry_doc(entry: e)))
}

fn block_sequence_element_doc(e: extdeps.languages.yaml.types.YamlValue) -> std.layout.Doc {
  match e {
    extdeps.languages.yaml.types.YamlMapping { entries: ents } =>
      std.layout.doc_concat(parts: [std.layout.doc_text(text: "- "), std.layout.doc_nest(levels: 1, body: mapping_body_doc(entries: ents))])
    extdeps.languages.yaml.types.YamlString { value: s } =>
      if string_contains(s: s, pattern: "\n") {
        multiline_block_doc(prefix: "- ", s: s)
      } else {
        std.layout.doc_line_of(text: concat("- ", emit_inline_scalar_text(s: s)))
      }
    extdeps.languages.yaml.types.YamlNull => std.layout.doc_line_of(text: concat("- ", emit_scalar(v: e)))
    extdeps.languages.yaml.types.YamlBool { value: _ } => std.layout.doc_line_of(text: concat("- ", emit_scalar(v: e)))
    extdeps.languages.yaml.types.YamlInt { lexeme: _ } => std.layout.doc_line_of(text: concat("- ", emit_scalar(v: e)))
    extdeps.languages.yaml.types.YamlFloat { lexeme: _ } => std.layout.doc_line_of(text: concat("- ", emit_scalar(v: e)))
    extdeps.languages.yaml.types.YamlSequence { elements: _ } => std.layout.doc_line_of(text: concat("- ", emit_scalar(v: e)))
  }
}

fn block_sequence_doc(elements: List<extdeps.languages.yaml.types.YamlValue>) -> std.layout.Doc {
  std.layout.doc_concat(parts: map(elements, e => block_sequence_element_doc(e: e)))
}

fn project_yaml_to_doc(v: extdeps.languages.yaml.types.YamlValue) -> std.layout.Doc {
  match v {
    extdeps.languages.yaml.types.YamlMapping { entries: ents } => mapping_body_doc(entries: ents)
    extdeps.languages.yaml.types.YamlSequence { elements: els } =>
      if all_scalars_flowable(elements: els) {
        std.layout.doc_line_of(text: emit_flow_sequence(elements: els))
      } else {
        block_sequence_doc(elements: els)
      }
    extdeps.languages.yaml.types.YamlString { value: s } =>
      if string_contains(s: s, pattern: "\n") {
        multiline_block_doc(prefix: "", s: s)
      } else {
        std.layout.doc_line_of(text: emit_inline_scalar_text(s: s))
      }
    extdeps.languages.yaml.types.YamlNull => std.layout.doc_line_of(text: emit_scalar(v: v))
    extdeps.languages.yaml.types.YamlBool { value: _ } => std.layout.doc_line_of(text: emit_scalar(v: v))
    extdeps.languages.yaml.types.YamlInt { lexeme: _ } => std.layout.doc_line_of(text: emit_scalar(v: v))
    extdeps.languages.yaml.types.YamlFloat { lexeme: _ } => std.layout.doc_line_of(text: emit_scalar(v: v))
  }
}

fn serialize_yaml(v: extdeps.languages.yaml.types.YamlValue) -> String {
  std.layout.render(doc: project_yaml_to_doc(v: v), proto: yaml_protocol)
}
