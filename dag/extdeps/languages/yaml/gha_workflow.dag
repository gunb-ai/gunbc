module extdeps.languages.yaml.gha_workflow

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.languages.yaml.types {
  YamlValue, YamlKeyValue,
  yaml_string, yaml_int, yaml_bool, yaml_mapping, yaml_sequence, kv,
  empty_yaml_values
}
import extdeps.cron.schedule_model { render_cron_schedule }
import extdeps.github.actions {
  Workflow, Job, Step, RunStep, UsesStep, ActionRef,
  WorkflowTrigger, Push, PullRequest, WorkflowDispatch, Schedule, MergeGroup,
  PullRequestActivity, Opened, Synchronize, Reopened, ReadyForReview, Closed,
  WorkflowPermissions, PermissionLevel, PermRead, PermWrite, PermNone,
  ConcurrencySpec, ConcurrencyScalar, ConcurrencyMappingQueueMax, ConcurrencyMappingQueueNotMax,
  CancelInProgressSpec, CancelInProgressBool, CancelInProgressExpression,
  CancelInProgressWhenQueueMax, QueueMaxCancelInProgressFalse, QueueMaxCancelInProgressExpression,
  RunnerSpec, SelfHosted, RunsOnExpression, HostedRunner, RunnerLabel,
  UbuntuLatest, ShellType, Bash
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/using-workflows/workflow-syntax-for-github-actions"
  }
}

fn permission_level_yaml(level: PermissionLevel) -> YamlValue {
  match level {
    PermRead => yaml_string(s: "read")
    PermWrite => yaml_string(s: "write")
    PermNone => yaml_string(s: "none")
  }
}

fn optional_permission_key(key: String, level: PermissionLevel?) -> List<YamlKeyValue> {
  match level {
    Absent => []
    Present { value: l } => [kv(key: key, value: permission_level_yaml(level: l))]
  }
}

fn workflow_permissions_yaml(perms: WorkflowPermissions) -> YamlValue {
  yaml_mapping(entries: concat(
    optional_permission_key(key: "contents", level: perms.contents),
    concat(
      optional_permission_key(key: "pull-requests", level: perms.pull_requests),
      concat(
        optional_permission_key(key: "issues", level: perms.issues),
        concat(
          optional_permission_key(key: "actions", level: perms.actions),
          optional_permission_key(key: "id-token", level: perms.id_token)
        )
      )
    )
  ))
}

fn pr_activity_string(a: PullRequestActivity) -> String {
  match a {
    Opened => "opened"
    Synchronize => "synchronize"
    Reopened => "reopened"
    ReadyForReview => "ready_for_review"
    Closed => "closed"
  }
}

fn string_list_flow(items: List<String>) -> YamlValue {
  yaml_sequence(elements: fold(items, init: empty_yaml_values, f: (acc, s) => concat(acc, [yaml_string(s: s)])))
}

fn pr_activities_flow(types: List<PullRequestActivity>) -> YamlValue {
  yaml_sequence(elements: fold(types, init: empty_yaml_values, f: (acc, t) => concat(acc, [yaml_string(s: pr_activity_string(a: t))])))
}

fn push_trigger_yaml(branches: List<String>, paths: List<String>) -> YamlKeyValue {
  let entries = if paths.length() == 0 {
    [kv(key: "branches", value: string_list_flow(items: branches))]
  } else {
    concat(
      [kv(key: "branches", value: string_list_flow(items: branches))],
      [kv(key: "paths", value: string_list_flow(items: paths))]
    )
  }
  kv(key: "push", value: yaml_mapping(entries: entries))
}

fn workflow_trigger_entry(trigger: WorkflowTrigger) -> YamlKeyValue {
  match trigger {
    WorkflowDispatch { inputs: _ } =>
      kv(key: "workflow_dispatch", value: YamlNull)
    Push { branches: bs, paths: ps } =>
      push_trigger_yaml(branches: bs, paths: ps)
    PullRequest { branches: bs, types: ts } =>
      kv(key: "pull_request", value: yaml_mapping(entries: [
        kv(key: "branches", value: string_list_flow(items: bs)),
        kv(key: "types", value: pr_activities_flow(types: ts))
      ]))
    Schedule { cron: c } =>
      kv(key: "schedule", value: yaml_sequence(elements: [
        yaml_mapping(entries: [kv(key: "cron", value: yaml_string(s: render_cron_schedule(s: c)))])
      ]))
    WorkflowCall { inputs: _ } =>
      kv(key: "workflow_call", value: YamlNull)
    MergeGroup =>
      kv(key: "merge_group", value: YamlNull)
  }
}

fn workflow_triggers_yaml(triggers: List<WorkflowTrigger>) -> YamlValue {
  yaml_mapping(entries: fold(triggers, init: [], f: (acc, t) => concat(acc, [workflow_trigger_entry(trigger: t)])))
}

fn cancel_in_progress_yaml(spec: CancelInProgressSpec) -> YamlValue {
  match spec {
    CancelInProgressBool { value: b } => yaml_bool(b: b)
    CancelInProgressExpression { expression: e } => yaml_string(s: e)
  }
}

fn cancel_in_progress_when_queue_max_yaml(spec: CancelInProgressWhenQueueMax) -> YamlValue {
  match spec {
    QueueMaxCancelInProgressFalse => yaml_bool(b: false)
    QueueMaxCancelInProgressExpression { expression: e } => yaml_string(s: e)
  }
}

data concurrency_queue_max_value: String = "max"

data concurrency_queue_max_emission_note: String = "ConcurrencyMappingQueueMax exists to say `queue: max`, and until now it did not say it: this serializer emitted only group and cancel-in-progress, byte-identical to ConcurrencyMappingQueueNotMax. A coproduct whose two arms project to the same bytes is not a distinction — it is a declared field the serializer discards, which is worse than not modelling it at all, because a fix can be authored, typecheck, and have no realized effect (DESIGN §5 specification-without-execution). The arms differ in behaviour that matters: default queueing keeps at most ONE pending job per group and cancels the previously pending one as each new arrival supersedes it, whereas `queue: max` admits multiple pending runs and only cancels past the cap — which is the difference between 'block on the previous deploy' and 'drop every deploy but the newest'. GitHub constrains cancel-in-progress to false under queue: max, and CancelInProgressWhenQueueMax already models exactly that constraint, so the type was right and only the projection was missing. Diagnosed in docs/plans/srv1-deploy-serialization-and-false-greens.md §4."

fn concurrency_mapping_queue_max(group: String, cip: CancelInProgressWhenQueueMax?) -> YamlValue {
  let base = [
    kv(key: "group", value: yaml_string(s: group)),
    kv(key: "queue", value: yaml_string(s: concurrency_queue_max_value))
  ]
  let with_cancel = match cip {
    Absent => base
    Present { value: c } => concat(base, [kv(key: "cancel-in-progress", value: cancel_in_progress_when_queue_max_yaml(spec: c))])
  }
  yaml_mapping(entries: with_cancel)
}

fn concurrency_mapping_with_cancel(group: String, cip: CancelInProgressSpec?) -> YamlValue {
  let base = [kv(key: "group", value: yaml_string(s: group))]
  let with_cancel = match cip {
    Absent => base
    Present { value: c } => concat(base, [kv(key: "cancel-in-progress", value: cancel_in_progress_yaml(spec: c))])
  }
  yaml_mapping(entries: with_cancel)
}

fn concurrency_yaml(spec: ConcurrencySpec) -> YamlValue {
  match spec {
    ConcurrencyScalar { group: g } => yaml_string(s: g)
    ConcurrencyMappingQueueMax { group: g, cancel_in_progress: cip } =>
      concurrency_mapping_queue_max(group: g, cip: cip)
    ConcurrencyMappingQueueNotMax { group: g, cancel_in_progress: cip, explicit_single: _ } =>
      concurrency_mapping_with_cancel(group: g, cip: cip)
  }
}

fn runner_label_string(label: RunnerLabel) -> String {
  match label {
    UbuntuLatest => "ubuntu-latest"
    Ubuntu2404 => "ubuntu-24.04"
    Ubuntu2404Arm => "ubuntu-24.04-arm"
    Ubuntu2204 => "ubuntu-22.04"
    UbuntuSlim => "ubuntu-slim"
    MacosLatest => "macos-latest"
    Macos14 => "macos-14"
    WindowsLatest => "windows-latest"
  }
}

fn runner_yaml(spec: RunnerSpec) -> YamlValue {
  match spec {
    HostedRunner { label: l } => yaml_string(s: runner_label_string(label: l))
    SelfHosted { labels: ls } => string_list_flow(items: ls)
    RunsOnExpression { expression: e } => yaml_string(s: e)
  }
}

fn action_ref_uses(ref: ActionRef) -> String {
  concat(concat(concat(concat(ref.owner, "/"), ref.repo), "@"), ref.ref)
}

fn yaml_key_values(entries: List<YamlKeyValue>?) -> List<YamlKeyValue> {
  match entries {
    Absent => []
    Present { value: es } => es
  }
}

data optional_named_mapping_consolidation_note: String = "with / env / outputs were three byte-identical copies of one shape differing only in their key, and adding a fourth for Job.outputs is exactly the redundancy §2 forbids — one concept, derived per use, not copied per use. They now project through optional_named_mapping; the two original names are kept as key-bound projections because their call sites read better with the key implied, and they are one line each rather than one body each. Byte-identical by construction: same guard, same yaml_mapping, key supplied instead of literal."

fn optional_named_mapping(key: String, entries: List<YamlKeyValue>?) -> List<YamlKeyValue> {
  match entries {
    Absent => []
    Present { value: es } => if es.length() == 0 { [] } else { [kv(key: key, value: yaml_mapping(entries: es))] }
  }
}

fn optional_kv_mapping(entries: List<YamlKeyValue>?) -> List<YamlKeyValue> {
  optional_named_mapping(key: "with", entries: entries)
}

fn optional_env_mapping(entries: List<YamlKeyValue>?) -> List<YamlKeyValue> {
  optional_named_mapping(key: "env", entries: entries)
}

fn optional_string_kv(key: String, value: String?) -> List<YamlKeyValue> {
  match value {
    Absent => []
    Present { value: s } => [kv(key: key, value: yaml_string(s: s))]
  }
}

fn optional_int_kv(key: String, value: Int?) -> List<YamlKeyValue> {
  match value {
    Absent => []
    Present { value: n } => [kv(key: key, value: yaml_int(n: n))]
  }
}

fn optional_bool_kv(key: String, value: Bool?) -> List<YamlKeyValue> {
  match value {
    Absent => []
    Present { value: b } => if b { [kv(key: key, value: yaml_bool(b: true))] } else { [] }
  }
}

fn shell_type_string(shell: ShellType) -> String {
  match shell {
    Bash => "bash"
    Sh => "sh"
    Pwsh => "pwsh"
    Python => "python"
    Cmd => "cmd"
  }
}

fn optional_shell_kv(shell: ShellType?) -> List<YamlKeyValue> {
  match shell {
    Absent => []
    Present { value: s } => [kv(key: "shell", value: yaml_string(s: shell_type_string(shell: s)))]
  }
}

fn run_step_yaml(n: String?, i: String?, r: String, sh: ShellType?, e: List<YamlKeyValue>?, wd: String?, ic: String?, coe: Bool?, tm: Int?) -> YamlValue {
  yaml_mapping(entries: concat(
    optional_string_kv(key: "name", value: n),
    concat(
      optional_string_kv(key: "id", value: i),
      concat(
        [kv(key: "run", value: yaml_string(s: r))],
        concat(
          optional_shell_kv(shell: sh),
          concat(
            optional_env_mapping(entries: e),
            concat(
              optional_string_kv(key: "working-directory", value: wd),
              concat(
                optional_string_kv(key: "if", value: ic),
                concat(
                  optional_bool_kv(key: "continue-on-error", value: coe),
                  optional_int_kv(key: "timeout-minutes", value: tm)
                )
              )
            )
          )
        )
      )
    )
  ))
}

fn uses_step_yaml(n: String?, i: String?, u: ActionRef, w: List<YamlKeyValue>?, e: List<YamlKeyValue>?, ic: String?, coe: Bool?, tm: Int?) -> YamlValue {
  yaml_mapping(entries: concat(
    optional_string_kv(key: "name", value: n),
    concat(
      optional_string_kv(key: "id", value: i),
      concat(
        [kv(key: "uses", value: yaml_string(s: action_ref_uses(ref: u)))],
        concat(
          optional_kv_mapping(entries: w),
          concat(
            optional_env_mapping(entries: e),
            concat(
              optional_string_kv(key: "if", value: ic),
              concat(
                optional_bool_kv(key: "continue-on-error", value: coe),
                optional_int_kv(key: "timeout-minutes", value: tm)
              )
            )
          )
        )
      )
    )
  ))
}

fn step_yaml(step: Step) -> YamlValue {
  match step {
    RunStep { name: n, id: i, run: r, shell: sh, env: e, working_directory: wd, if_condition: ic, continue_on_error: coe, timeout_minutes: tm } =>
      run_step_yaml(n: n, i: i, r: r, sh: sh, e: e, wd: wd, ic: ic, coe: coe, tm: tm)
    UsesStep { name: n, id: i, uses: u, with: w, env: e, if_condition: ic, continue_on_error: coe, timeout_minutes: tm } =>
      uses_step_yaml(n: n, i: i, u: u, w: w, e: e, ic: ic, coe: coe, tm: tm)
  }
}

fn steps_yaml(steps: List<Step>) -> YamlValue {
  yaml_sequence(elements: fold(steps, init: empty_yaml_values, f: (acc, s) => concat(acc, [step_yaml(step: s)])))
}

fn optional_string_list_kv(key: String, items: List<String>) -> List<YamlKeyValue> {
  if items.length() == 0 {
    []
  } else {
    [kv(key: key, value: string_list_flow(items: items))]
  }
}

fn optional_job_permissions_kv(perms: WorkflowPermissions?) -> List<YamlKeyValue> {
  match perms {
    Absent => []
    Present { value: p } => [kv(key: "permissions", value: workflow_permissions_yaml(perms: p))]
  }
}

data job_yaml_dropped_field_note: String = "job_yaml emitted eight of Job's twelve fields and SILENTLY DISCARDED name, outputs, strategy and concurrency. The cost is not the missing YAML — it is that setting one of them is a no-op that looks like a fix: srv1 deploy serialization needs job-level `concurrency`, and a row authoring it would have typechecked, regenerated ci.yml byte-identically, and changed nothing on GitHub (DESIGN §5 specification-without-execution; diagnosed in docs/plans/srv1-deploy-serialization-and-false-greens.md §4). name, outputs and concurrency are now emitted through the projections that already existed for them. Emitting them is provably drift-free: no Job in the corpus sets any of the four, so generated ci.yml and falsifier.yml are byte-unchanged, and the discriminating REDs assert presence on synthetic Jobs that DO set them rather than on the live workflows. strategy is the residue — see job_strategy_unemitted_note."

data job_strategy_unemitted_note: String = "🟡 dissolve-on: Job.strategy is declared MatrixStrategy? and is STILL not emitted, and this note is the difference between a marked gap and the silent drop this change removed. Two reasons it is not fixed here rather than one: MatrixStrategy has zero construction sites in the corpus, so any serializer would be speculative with no consumer to prove it by execution; and its dimensions/include/exclude fields are Map-typed, where v2 Maps are closures rather than wire-serializable values, so a faithful projection is real work with a known hazard and not a line of glue. DISSOLVES WHEN a Job actually needs a matrix — at which point the serializer lands WITH that consumer and a discriminating RED, the same bar the three fields above just met. Until then the field is honestly unemitted and counted here, not quietly dropped."

fn optional_job_concurrency_kv(spec: ConcurrencySpec?) -> List<YamlKeyValue> {
  match spec {
    Absent => []
    Present { value: c } => [kv(key: "concurrency", value: concurrency_yaml(spec: c))]
  }
}

fn job_yaml(job: Job) -> YamlValue {
  yaml_mapping(entries: concat(
    optional_string_kv(key: "name", value: job.name),
    concat(
    [kv(key: "runs-on", value: runner_yaml(spec: job.runner))],
    concat(
      optional_string_list_kv(key: "needs", items: job.needs),
      concat(
        optional_int_kv(key: "timeout-minutes", value: job.timeout_minutes),
        concat(
          optional_string_kv(key: "if", value: job.if_condition),
          concat(
            optional_job_permissions_kv(perms: job.permissions),
            concat(
              optional_job_concurrency_kv(spec: job.concurrency),
              concat(
                [kv(key: "steps", value: steps_yaml(steps: job.steps))],
                concat(
                  optional_env_mapping(entries: job.env),
                  concat(
                    optional_named_mapping(key: "outputs", entries: job.outputs),
                    optional_bool_kv(key: "continue-on-error", value: job.continue_on_error)
                  )
                )
              )
            )
          )
        )
      )
    )
    )
  ))
}

fn jobs_yaml(jobs: List<Job>) -> YamlValue {
  yaml_mapping(entries: fold(jobs, init: [], f: (acc, j) => concat(acc, [kv(key: j.id, value: job_yaml(job: j))])))
}

fn optional_env_top(entries: List<YamlKeyValue>?) -> List<YamlKeyValue> {
  match entries {
    Absent => []
    Present { value: es } => if es.length() == 0 { [] } else { [kv(key: "env", value: yaml_mapping(entries: es))] }
  }
}

fn project_workflow_to_yaml(workflow: Workflow) -> YamlValue {
  yaml_mapping(entries: concat(
    [kv(key: "name", value: yaml_string(s: workflow.name))],
    concat(
      [kv(key: "on", value: workflow_triggers_yaml(triggers: workflow.on))],
      concat(
        match workflow.permissions {
          Absent => []
          Present { value: p } => [kv(key: "permissions", value: workflow_permissions_yaml(perms: p))]
        },
        concat(
          match workflow.concurrency {
            Absent => []
            Present { value: c } => [kv(key: "concurrency", value: concurrency_yaml(spec: c))]
          },
          concat(
            optional_env_top(entries: workflow.env),
            [kv(key: "jobs", value: jobs_yaml(jobs: workflow.jobs))]
          )
        )
      )
    )
  ))
}
