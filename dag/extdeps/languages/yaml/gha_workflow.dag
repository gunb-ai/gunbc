module extdeps.languages.yaml.gha_workflow


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/actions/using-workflows/workflow-syntax-for-github-actions"
  }
}

fn permission_level_yaml(level: extdeps.github.actions.PermissionLevel) -> extdeps.languages.yaml.types.YamlValue {
  match level {
    extdeps.github.actions.PermRead => extdeps.languages.yaml.types.yaml_string(s: "read")
    extdeps.github.actions.PermWrite => extdeps.languages.yaml.types.yaml_string(s: "write")
    extdeps.github.actions.PermNone => extdeps.languages.yaml.types.yaml_string(s: "none")
  }
}

fn optional_permission_key(key: String, level: extdeps.github.actions.PermissionLevel?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match level {
    Absent => []
    Present { value: l } => [extdeps.languages.yaml.types.kv(key: key, value: permission_level_yaml(level: l))]
  }
}

fn workflow_permissions_yaml(perms: extdeps.github.actions.WorkflowPermissions) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_mapping(entries: concat(
    optional_permission_key(key: "contents", level: perms.contents),
    concat(
      optional_permission_key(key: "pull-requests", level: perms.pull_requests),
      concat(
        optional_permission_key(key: "issues", level: perms.issues),
        concat(
          optional_permission_key(key: "actions", level: perms.actions),
          optional_permission_key(key: "id-token", level: perms.id_token)
        )
      )
    )
  ))
}

fn pr_activity_string(a: extdeps.github.actions.PullRequestActivity) -> String {
  match a {
    extdeps.github.actions.Opened => "opened"
    extdeps.github.actions.Synchronize => "synchronize"
    extdeps.github.actions.Reopened => "reopened"
    extdeps.github.actions.ReadyForReview => "ready_for_review"
    extdeps.github.actions.Closed => "closed"
  }
}

fn string_list_flow(items: List<String>) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_sequence(elements: fold(items, init: extdeps.languages.yaml.types.empty_yaml_values, f: (acc, s) => concat(acc, [extdeps.languages.yaml.types.yaml_string(s: s)])))
}

fn pr_activities_flow(types: List<extdeps.github.actions.PullRequestActivity>) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_sequence(elements: fold(types, init: extdeps.languages.yaml.types.empty_yaml_values, f: (acc, t) => concat(acc, [extdeps.languages.yaml.types.yaml_string(s: pr_activity_string(a: t))])))
}

fn push_trigger_yaml(branches: List<String>, paths: List<String>) -> extdeps.languages.yaml.types.YamlKeyValue {
  let entries = if paths.length() == 0 {
    [extdeps.languages.yaml.types.kv(key: "branches", value: string_list_flow(items: branches))]
  } else {
    concat(
      [extdeps.languages.yaml.types.kv(key: "branches", value: string_list_flow(items: branches))],
      [extdeps.languages.yaml.types.kv(key: "paths", value: string_list_flow(items: paths))]
    )
  }
  extdeps.languages.yaml.types.kv(key: "push", value: extdeps.languages.yaml.types.yaml_mapping(entries: entries))
}

fn dispatch_input_type_label(t: extdeps.github.actions.DispatchInputType) -> String {
  match t {
    extdeps.github.actions.InputString => "string"
    extdeps.github.actions.InputBoolean => "boolean"
    extdeps.github.actions.InputChoice { options: _ } => "choice"
    extdeps.github.actions.InputEnvironment => "environment"
  }
}

fn dispatch_input_type_extra_fields(t: extdeps.github.actions.DispatchInputType) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match t {
    extdeps.github.actions.InputChoice { options: opts } =>
      [extdeps.languages.yaml.types.kv(key: "options", value: string_list_flow(items: opts))]
    extdeps.github.actions.InputString => []
    extdeps.github.actions.InputBoolean => []
    extdeps.github.actions.InputEnvironment => []
  }
}

fn dispatch_input_optional_string(key: String, value: String?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match value {
    Present { value: s } => [extdeps.languages.yaml.types.kv(key: key, value: extdeps.languages.yaml.types.yaml_string(s: s))]
    Absent => []
  }
}

fn dispatch_input_yaml(input: extdeps.github.actions.DispatchInput) -> extdeps.languages.yaml.types.YamlKeyValue {
  extdeps.languages.yaml.types.kv(
    key: input.name,
    value: extdeps.languages.yaml.types.yaml_mapping(entries: concat(
      dispatch_input_optional_string(key: "description", value: input.description),
      concat(
        [extdeps.languages.yaml.types.kv(key: "required", value: extdeps.languages.yaml.types.yaml_bool(b: input.required))],
        concat(
          dispatch_input_optional_string(key: "default", value: input.default),
          concat(
            dispatch_input_type_extra_fields(t: input.type),
            [extdeps.languages.yaml.types.kv(key: "type", value: extdeps.languages.yaml.types.yaml_string(s: dispatch_input_type_label(t: input.type)))]
          )
        )
      )
    ))
  )
}

fn workflow_dispatch_yaml(inputs: List<extdeps.github.actions.DispatchInput>) -> extdeps.languages.yaml.types.YamlValue {
  if length(inputs) == 0 {
    YamlNull
  } else {
    extdeps.languages.yaml.types.yaml_mapping(entries: [
      extdeps.languages.yaml.types.kv(
        key: "inputs",
        value: extdeps.languages.yaml.types.yaml_mapping(entries: map(inputs, input => dispatch_input_yaml(input: input)))
      )
    ])
  }
}

data workflow_dispatch_input_projection_note: String = "WorkflowDispatch.inputs was modeled in extdeps.github.actions but this serializer discarded the entire list and emitted workflow_dispatch: null. That specification-without-execution gap is now closed: every modeled input is projected into the workflow syntax, while the empty list deliberately retains the compact null form. InputChoice carries a non-empty options list and projects it as the required GitHub Actions options: mapping entry — a type: choice input without options is undispatchable. The CI heal revalidation input is the first production consumer and its witness reads the projected YamlValue rather than trusting generated text."

fn workflow_trigger_entry(trigger: extdeps.github.actions.WorkflowTrigger) -> extdeps.languages.yaml.types.YamlKeyValue {
  match trigger {
    extdeps.github.actions.WorkflowDispatch { inputs: inputs } =>
      extdeps.languages.yaml.types.kv(key: "workflow_dispatch", value: workflow_dispatch_yaml(inputs: inputs))
    extdeps.github.actions.Push { branches: bs, paths: ps } =>
      push_trigger_yaml(branches: bs, paths: ps)
    extdeps.github.actions.PullRequest { branches: bs, types: ts } =>
      extdeps.languages.yaml.types.kv(key: "pull_request", value: extdeps.languages.yaml.types.yaml_mapping(entries: [
        extdeps.languages.yaml.types.kv(key: "branches", value: string_list_flow(items: bs)),
        extdeps.languages.yaml.types.kv(key: "types", value: pr_activities_flow(types: ts))
      ]))
    extdeps.github.actions.Schedule { cron: c } =>
      extdeps.languages.yaml.types.kv(key: "schedule", value: extdeps.languages.yaml.types.yaml_sequence(elements: [
        extdeps.languages.yaml.types.yaml_mapping(entries: [extdeps.languages.yaml.types.kv(key: "cron", value: extdeps.languages.yaml.types.yaml_string(s: extdeps.cron.schedule_model.render_cron_schedule(s: c)))])
      ]))
    WorkflowCall { inputs: _ } =>
      extdeps.languages.yaml.types.kv(key: "workflow_call", value: YamlNull)
    extdeps.github.actions.WorkflowRunCompleted { workflows: ws, branches: bs } =>
      extdeps.languages.yaml.types.kv(key: "workflow_run", value: extdeps.languages.yaml.types.yaml_mapping(entries: [
        extdeps.languages.yaml.types.kv(key: "workflows", value: string_list_flow(items: ws)),
        extdeps.languages.yaml.types.kv(key: "branches", value: string_list_flow(items: bs)),
        extdeps.languages.yaml.types.kv(key: "types", value: string_list_flow(items: [extdeps.github.actions.workflow_run_activity_completed]))
      ]))
    extdeps.github.actions.MergeGroup =>
      extdeps.languages.yaml.types.kv(key: "merge_group", value: YamlNull)
  }
}

fn workflow_triggers_yaml(triggers: List<extdeps.github.actions.WorkflowTrigger>) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_mapping(entries: fold(triggers, init: [], f: (acc, t) => concat(acc, [workflow_trigger_entry(trigger: t)])))
}

fn cancel_in_progress_yaml(spec: extdeps.github.actions.CancelInProgressSpec) -> extdeps.languages.yaml.types.YamlValue {
  match spec {
    extdeps.github.actions.CancelInProgressBool { value: b } => extdeps.languages.yaml.types.yaml_bool(b: b)
    extdeps.github.actions.CancelInProgressExpression { expression: e } => extdeps.languages.yaml.types.yaml_string(s: e)
  }
}

fn cancel_in_progress_when_queue_max_yaml(spec: extdeps.github.actions.CancelInProgressWhenQueueMax) -> extdeps.languages.yaml.types.YamlValue {
  match spec {
    extdeps.github.actions.QueueMaxCancelInProgressFalse => extdeps.languages.yaml.types.yaml_bool(b: false)
    extdeps.github.actions.QueueMaxCancelInProgressExpression { expression: e } => extdeps.languages.yaml.types.yaml_string(s: e)
  }
}

data workflow_run_branches_emission_note: String = "GitHub filters workflow_run by the branch of the TRIGGERING run, documented as `You can use the branches or branches-ignore filter to specify what branches the triggering workflow must run on in order to trigger your workflow` (docs.github.com Events that trigger workflows, workflow_run, read 2026-08-21). That is the same fact a job-level `head_branch ==` condition tests, one grain earlier: the condition skips the job AFTER the run has been created and has entered its concurrency group, while the filter stops the event creating a run at all. The distinction is load-bearing rather than cosmetic -- a created-then-skipped run still occupies a concurrency slot, and in the default group an arriving entry evicts the pending one, so an irrelevant branch could cancel a real pending admission and then do nothing. The member is REQUIRED and emitted unconditionally, matching the Push and PullRequest siblings: a caller declaring this trigger must decide which branches it answers to, and an omitted filter meaning `every branch` is exactly the state that produced the eviction."

data concurrency_queue_max_emission_note: String = "ConcurrencyMappingQueueMax exists to express GitHub's `queue: max`, and until this row it emitted NO queue key — so it serialized byte-identically to ConcurrencyMappingQueueNotMax and the modeled distinction had no realization difference at all (srv1-deploy-serialization-and-false-greens.md §4, second drop). That matters because the two variants mean DIFFERENT THINGS on the platform: the default (QueueNotMax) holds at most one running and one pending entry, and a newly-arriving entry CANCELS the existing pending one, whereas `queue: max` permits multiple pending up to a documented cap of 100 with cancel-in-progress forced false. A caller reaching for QueueMax is asking for the no-cancel queue and was silently getting pending-replacement. `queue` is emitted FIRST so the mapping reads queue-then-group-then-cancel; CancelInProgressWhenQueueMax already models the platform's constraint that cancel-in-progress cannot be true here, so that arm needs no extra guard. Witness: gha_job_projection_witness_test asserts the emitted mapping CONTAINS the queue key and that the two variants no longer serialize identically."

fn concurrency_mapping_queue_max(group: String, cip: extdeps.github.actions.CancelInProgressWhenQueueMax?) -> extdeps.languages.yaml.types.YamlValue {
  let base = [
    extdeps.languages.yaml.types.kv(key: "queue", value: extdeps.languages.yaml.types.yaml_string(s: "max")),
    extdeps.languages.yaml.types.kv(key: "group", value: extdeps.languages.yaml.types.yaml_string(s: group))
  ]
  let with_cancel = match cip {
    Absent => base
    Present { value: c } => concat(base, [extdeps.languages.yaml.types.kv(key: "cancel-in-progress", value: cancel_in_progress_when_queue_max_yaml(spec: c))])
  }
  extdeps.languages.yaml.types.yaml_mapping(entries: with_cancel)
}

fn concurrency_mapping_with_cancel(group: String, cip: extdeps.github.actions.CancelInProgressSpec?) -> extdeps.languages.yaml.types.YamlValue {
  let base = [extdeps.languages.yaml.types.kv(key: "group", value: extdeps.languages.yaml.types.yaml_string(s: group))]
  let with_cancel = match cip {
    Absent => base
    Present { value: c } => concat(base, [extdeps.languages.yaml.types.kv(key: "cancel-in-progress", value: cancel_in_progress_yaml(spec: c))])
  }
  extdeps.languages.yaml.types.yaml_mapping(entries: with_cancel)
}

fn concurrency_yaml(spec: extdeps.github.actions.ConcurrencySpec) -> extdeps.languages.yaml.types.YamlValue {
  match spec {
    extdeps.github.actions.ConcurrencyScalar { group: g } => extdeps.languages.yaml.types.yaml_string(s: g)
    extdeps.github.actions.ConcurrencyMappingQueueMax { group: g, cancel_in_progress: cip } =>
      concurrency_mapping_queue_max(group: g, cip: cip)
    extdeps.github.actions.ConcurrencyMappingQueueNotMax { group: g, cancel_in_progress: cip, explicit_single: _ } =>
      concurrency_mapping_with_cancel(group: g, cip: cip)
  }
}

fn runner_label_string(label: extdeps.github.actions.RunnerLabel) -> String {
  match label {
    extdeps.github.actions.UbuntuLatest => "ubuntu-latest"
    Ubuntu2404 => "ubuntu-24.04"
    Ubuntu2404Arm => "ubuntu-24.04-arm"
    Ubuntu2204 => "ubuntu-22.04"
    UbuntuSlim => "ubuntu-slim"
    MacosLatest => "macos-latest"
    Macos14 => "macos-14"
    WindowsLatest => "windows-latest"
  }
}

fn runner_yaml(spec: extdeps.github.actions.RunnerSpec) -> extdeps.languages.yaml.types.YamlValue {
  match spec {
    extdeps.github.actions.HostedRunner { label: l } => extdeps.languages.yaml.types.yaml_string(s: runner_label_string(label: l))
    extdeps.github.actions.SelfHosted { labels: ls } => string_list_flow(items: ls)
    extdeps.github.actions.RunsOnExpression { expression: e } => extdeps.languages.yaml.types.yaml_string(s: e)
  }
}

fn action_ref_uses(ref: extdeps.github.actions.ActionRef) -> String {
  concat(concat(concat(concat(ref.owner, "/"), ref.repo), "@"), ref.ref)
}

fn yaml_key_values(entries: List<extdeps.languages.yaml.types.YamlKeyValue>?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match entries {
    Absent => []
    Present { value: es } => es
  }
}

fn optional_kv_mapping(entries: List<extdeps.languages.yaml.types.YamlKeyValue>?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match entries {
    Absent => []
    Present { value: es } => if es.length() == 0 { [] } else { [extdeps.languages.yaml.types.kv(key: "with", value: extdeps.languages.yaml.types.yaml_mapping(entries: es))] }
  }
}

fn optional_env_mapping(entries: List<extdeps.languages.yaml.types.YamlKeyValue>?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match entries {
    Absent => []
    Present { value: es } => if es.length() == 0 { [] } else { [extdeps.languages.yaml.types.kv(key: "env", value: extdeps.languages.yaml.types.yaml_mapping(entries: es))] }
  }
}

fn optional_string_kv(key: String, value: String?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match value {
    Absent => []
    Present { value: s } => [extdeps.languages.yaml.types.kv(key: key, value: extdeps.languages.yaml.types.yaml_string(s: s))]
  }
}

fn optional_int_kv(key: String, value: Int?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match value {
    Absent => []
    Present { value: n } => [extdeps.languages.yaml.types.kv(key: key, value: extdeps.languages.yaml.types.yaml_int(n: n))]
  }
}

fn optional_bool_kv(key: String, value: Bool?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match value {
    Absent => []
    Present { value: b } => if b { [extdeps.languages.yaml.types.kv(key: key, value: extdeps.languages.yaml.types.yaml_bool(b: true))] } else { [] }
  }
}

fn shell_type_string(shell: extdeps.github.actions.ShellType) -> String {
  match shell {
    extdeps.github.actions.Bash => "bash"
    Sh => "sh"
    Pwsh => "pwsh"
    Python => "python"
    Cmd => "cmd"
  }
}

fn optional_shell_kv(shell: extdeps.github.actions.ShellType?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match shell {
    Absent => []
    Present { value: s } => [extdeps.languages.yaml.types.kv(key: "shell", value: extdeps.languages.yaml.types.yaml_string(s: shell_type_string(shell: s)))]
  }
}

fn run_step_yaml(n: String?, i: String?, r: String, sh: extdeps.github.actions.ShellType?, e: List<extdeps.languages.yaml.types.YamlKeyValue>?, wd: String?, ic: String?, coe: Bool?, tm: Int?) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_mapping(entries: concat(
    optional_string_kv(key: "name", value: n),
    concat(
      optional_string_kv(key: "id", value: i),
      concat(
        [extdeps.languages.yaml.types.kv(key: "run", value: extdeps.languages.yaml.types.yaml_string(s: r))],
        concat(
          optional_shell_kv(shell: sh),
          concat(
            optional_env_mapping(entries: e),
            concat(
              optional_string_kv(key: "working-directory", value: wd),
              concat(
                optional_string_kv(key: "if", value: ic),
                concat(
                  optional_bool_kv(key: "continue-on-error", value: coe),
                  optional_int_kv(key: "timeout-minutes", value: tm)
                )
              )
            )
          )
        )
      )
    )
  ))
}

fn uses_step_yaml(n: String?, i: String?, u: extdeps.github.actions.ActionRef, w: List<extdeps.languages.yaml.types.YamlKeyValue>?, e: List<extdeps.languages.yaml.types.YamlKeyValue>?, ic: String?, coe: Bool?, tm: Int?) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_mapping(entries: concat(
    optional_string_kv(key: "name", value: n),
    concat(
      optional_string_kv(key: "id", value: i),
      concat(
        [extdeps.languages.yaml.types.kv(key: "uses", value: extdeps.languages.yaml.types.yaml_string(s: action_ref_uses(ref: u)))],
        concat(
          optional_kv_mapping(entries: w),
          concat(
            optional_env_mapping(entries: e),
            concat(
              optional_string_kv(key: "if", value: ic),
              concat(
                optional_bool_kv(key: "continue-on-error", value: coe),
                optional_int_kv(key: "timeout-minutes", value: tm)
              )
            )
          )
        )
      )
    )
  ))
}

fn step_yaml(step: extdeps.github.actions.Step) -> extdeps.languages.yaml.types.YamlValue {
  match step {
    extdeps.github.actions.RunStep { name: n, id: i, run: r, shell: sh, env: e, working_directory: wd, if_condition: ic, continue_on_error: coe, timeout_minutes: tm } =>
      run_step_yaml(n: n, i: i, r: r, sh: sh, e: e, wd: wd, ic: ic, coe: coe, tm: tm)
    extdeps.github.actions.UsesStep { name: n, id: i, uses: u, with: w, env: e, if_condition: ic, continue_on_error: coe, timeout_minutes: tm } =>
      uses_step_yaml(n: n, i: i, u: u, w: w, e: e, ic: ic, coe: coe, tm: tm)
  }
}

fn steps_yaml(steps: List<extdeps.github.actions.Step>) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_sequence(elements: fold(steps, init: extdeps.languages.yaml.types.empty_yaml_values, f: (acc, s) => concat(acc, [step_yaml(step: s)])))
}

fn optional_string_list_kv(key: String, items: List<String>) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  if items.length() == 0 {
    []
  } else {
    [extdeps.languages.yaml.types.kv(key: key, value: string_list_flow(items: items))]
  }
}

fn optional_job_permissions_kv(perms: extdeps.github.actions.WorkflowPermissions?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match perms {
    Absent => []
    Present { value: p } => [extdeps.languages.yaml.types.kv(key: "permissions", value: workflow_permissions_yaml(perms: p))]
  }
}

data job_field_projection_completeness_note: String = "job_yaml projected SEVEN of the Job type's eleven emittable fields and silently dropped four — concurrency, name, outputs, and strategy — so setting any of them was a no-op that still typechecked. That is the specification-without-execution trap (DESIGN §5) at the emitter seam, and it is worse than an unsupported field: the model reads as configured while the running workflow has nothing, and the ci.yml drift gate cannot catch it because BOTH sides agree the key does not appear. Named as the first of two drops in srv1-deploy-serialization-and-false-greens.md §4, whose §7 item 4 rules them closable INDEPENDENTLY of any deploy decision, because a declared field the serializer discards is a fail-open in every future consumer. THE FIELD-BY-FIELD DISPOSITION, because 'project everything' and 'delete everything' are both wrong here: concurrency, name, and outputs are now PROJECTED — each is a real GitHub job key, each is cheap (a String or a List<YamlKeyValue>), and concurrency is load-bearing for the srv1 lane. strategy is DELETED from the model instead, along with the MatrixStrategy type it referenced: no site anywhere in the corpus ever set a MatrixStrategy VALUE — every one of the eight occurrences was a field initializer supplying the empty optional — and realizing it would require iterating MatrixStrategy.dimensions (a Map), which std offers no order-stable traversal for — a bare map_keys reach is exactly what v2.lens.determinism.determinism_compile_gate reds, so the honest options were an unrealizable declaration or removal, and DESIGN §5 picks removal. It returns as a modeled field when a real matrix consumer arrives WITH a determinism-safe map projection, not before. BYTE-STABILITY: every Job in the corpus currently sets name/outputs/concurrency to none, so adding these three projections changes no generated artifact — the new keys are proven to work by a synthetic all-fields job in gha_job_projection_witness_test rather than by any change to ci.yml or falsifier.yml, and that witness also pins that an absent field stays absent so the projections cannot start emitting empty keys."

fn optional_job_concurrency_kv(spec: extdeps.github.actions.ConcurrencySpec?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match spec {
    Absent => []
    Present { value: c } => [extdeps.languages.yaml.types.kv(key: "concurrency", value: concurrency_yaml(spec: c))]
  }
}

fn optional_job_outputs_kv(entries: List<extdeps.languages.yaml.types.YamlKeyValue>?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match entries {
    Absent => []
    Present { value: es } => if es.length() == 0 { [] } else { [extdeps.languages.yaml.types.kv(key: "outputs", value: extdeps.languages.yaml.types.yaml_mapping(entries: es))] }
  }
}

fn job_yaml(job: extdeps.github.actions.Job) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_mapping(entries: concat(
    optional_string_kv(key: "name", value: job.name),
    concat(
      [extdeps.languages.yaml.types.kv(key: "runs-on", value: runner_yaml(spec: job.runner))],
      concat(
        optional_string_list_kv(key: "needs", items: job.needs),
        concat(
          optional_int_kv(key: "timeout-minutes", value: job.timeout_minutes),
          concat(
            optional_string_kv(key: "if", value: job.if_condition),
            concat(
              optional_job_permissions_kv(perms: job.permissions),
              concat(
                optional_job_concurrency_kv(spec: job.concurrency),
                concat(
                  optional_job_outputs_kv(entries: job.outputs),
                  concat(
                    [extdeps.languages.yaml.types.kv(key: "steps", value: steps_yaml(steps: job.steps))],
                    concat(
                      optional_env_mapping(entries: job.env),
                      optional_bool_kv(key: "continue-on-error", value: job.continue_on_error)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  ))
}

fn jobs_yaml(jobs: List<extdeps.github.actions.Job>) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_mapping(entries: fold(jobs, init: [], f: (acc, j) => concat(acc, [extdeps.languages.yaml.types.kv(key: j.id, value: job_yaml(job: j))])))
}

fn optional_env_top(entries: List<extdeps.languages.yaml.types.YamlKeyValue>?) -> List<extdeps.languages.yaml.types.YamlKeyValue> {
  match entries {
    Absent => []
    Present { value: es } => if es.length() == 0 { [] } else { [extdeps.languages.yaml.types.kv(key: "env", value: extdeps.languages.yaml.types.yaml_mapping(entries: es))] }
  }
}

fn project_workflow_to_yaml(workflow: extdeps.github.actions.Workflow) -> extdeps.languages.yaml.types.YamlValue {
  extdeps.languages.yaml.types.yaml_mapping(entries: concat(
    [extdeps.languages.yaml.types.kv(key: "name", value: extdeps.languages.yaml.types.yaml_string(s: workflow.name))],
    concat(
      [extdeps.languages.yaml.types.kv(key: "on", value: workflow_triggers_yaml(triggers: workflow.on))],
      concat(
        match workflow.permissions {
          Absent => []
          Present { value: p } => [extdeps.languages.yaml.types.kv(key: "permissions", value: workflow_permissions_yaml(perms: p))]
        },
        concat(
          match workflow.concurrency {
            Absent => []
            Present { value: c } => [extdeps.languages.yaml.types.kv(key: "concurrency", value: concurrency_yaml(spec: c))]
          },
          concat(
            optional_env_top(entries: workflow.env),
            [extdeps.languages.yaml.types.kv(key: "jobs", value: jobs_yaml(jobs: workflow.jobs))]
          )
        )
      )
    )
  ))
}
