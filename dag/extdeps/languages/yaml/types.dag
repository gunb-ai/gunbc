module extdeps.languages.yaml.types

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import v2.std.optional { Present, Absent }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "yaml.org/spec/1.2.2/"
  }
}

type YamlKeyValue {
  key: String
  value: YamlValue
}

type YamlValue
  = YamlNull
  | YamlBool { value: Bool }
  | YamlInt { lexeme: String }
  | YamlFloat { lexeme: String }
  | YamlString { value: String }
  | YamlSequence { elements: List<YamlValue> }
  | YamlMapping { entries: List<YamlKeyValue> }

type YamlValueKind
  = YamlNullKind
  | YamlBoolKind
  | YamlIntKind
  | YamlFloatKind
  | YamlStringKind
  | YamlSequenceKind
  | YamlMappingKind

fn yaml_value_kind(v: YamlValue) -> YamlValueKind {
  match v {
    YamlNull => YamlNullKind
    YamlBool { value: _ } => YamlBoolKind
    YamlInt { lexeme: _ } => YamlIntKind
    YamlFloat { lexeme: _ } => YamlFloatKind
    YamlString { value: _ } => YamlStringKind
    YamlSequence { elements: _ } => YamlSequenceKind
    YamlMapping { entries: _ } => YamlMappingKind
  }
}

fn yaml_value_kind_token(k: YamlValueKind) -> String {
  match k {
    YamlNullKind => "null"
    YamlBoolKind => "bool"
    YamlIntKind => "int"
    YamlFloatKind => "float"
    YamlStringKind => "str"
    YamlSequenceKind => "seq"
    YamlMappingKind => "map"
  }
}

data empty_yaml_values: List<YamlValue> = []

fn yaml_string(s: String) -> YamlValue {
  YamlString { value: s }
}

fn yaml_int(n: Int) -> YamlValue {
  YamlInt { lexeme: to_string(n) }
}

fn yaml_bool(b: Bool) -> YamlValue {
  YamlBool { value: b }
}

fn yaml_mapping(entries: List<YamlKeyValue>) -> YamlValue {
  YamlMapping { entries: entries }
}

fn yaml_sequence(elements: List<YamlValue>) -> YamlValue {
  YamlSequence { elements: elements }
}

fn kv(key: String, value: YamlValue) -> YamlKeyValue {
  YamlKeyValue { key: key, value: value }
}

// THE VALUE AT `key` IN A MAPPING'S ENTRIES. Keys of an ingested or emitted mapping are unique (both
// directions refuse a duplicate), so there is at most one.
type YamlKeyLookup
  = YamlKeyPresent { value: YamlValue }
  | YamlKeyAbsent

fn yaml_lookup(entries: List<YamlKeyValue>, key: String) -> YamlKeyLookup {
  match get(xs: filter(entries, e => e.key == key), index: 0) {
    Present { value: e } => YamlKeyPresent { value: e.value }
    Absent => YamlKeyAbsent
  }
}
