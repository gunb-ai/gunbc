module extdeps.languages.yaml.types

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "yaml.org/spec/1.2.2/"
  }
}

type YamlKeyValue {
  key: String
  value: YamlValue
}

type YamlValue
  = YamlNull
  | YamlBool { value: Bool }
  | YamlInt { lexeme: String }
  | YamlFloat { lexeme: String }
  | YamlString { value: String }
  | YamlSequence { elements: List<YamlValue> }
  | YamlMapping { entries: List<YamlKeyValue> }

type YamlValueKind
  = YamlNullKind
  | YamlBoolKind
  | YamlIntKind
  | YamlFloatKind
  | YamlStringKind
  | YamlSequenceKind
  | YamlMappingKind

fn yaml_value_kind(v: YamlValue) -> YamlValueKind {
  match v {
    YamlNull => YamlNullKind
    YamlBool { value: _ } => YamlBoolKind
    YamlInt { lexeme: _ } => YamlIntKind
    YamlFloat { lexeme: _ } => YamlFloatKind
    YamlString { value: _ } => YamlStringKind
    YamlSequence { elements: _ } => YamlSequenceKind
    YamlMapping { entries: _ } => YamlMappingKind
  }
}

fn yaml_value_kind_token(k: YamlValueKind) -> String {
  match k {
    YamlNullKind => "null"
    YamlBoolKind => "bool"
    YamlIntKind => "int"
    YamlFloatKind => "float"
    YamlStringKind => "str"
    YamlSequenceKind => "seq"
    YamlMappingKind => "map"
  }
}

data empty_yaml_values: List<YamlValue> = []

fn yaml_string(s: String) -> YamlValue {
  YamlString { value: s }
}

fn yaml_int(n: Int) -> YamlValue {
  YamlInt { lexeme: to_string(n) }
}

fn yaml_bool(b: Bool) -> YamlValue {
  YamlBool { value: b }
}

fn yaml_mapping(entries: List<YamlKeyValue>) -> YamlValue {
  YamlMapping { entries: entries }
}

fn yaml_sequence(elements: List<YamlValue>) -> YamlValue {
  YamlSequence { elements: elements }
}

fn kv(key: String, value: YamlValue) -> YamlKeyValue {
  YamlKeyValue { key: key, value: value }
}

// STRUCTURAL EQUALITY OF TWO NODES, the relation a consumer comparing YAML values means - mapping
// entries compared in order, because this model keeps a mapping as its ordered entry list and two
// orderings are two different values of it. Scalars compare by their typed payload: the int 22 and
// the string "22" are different nodes.
fn yaml_value_eq(a: YamlValue, b: YamlValue) -> Bool {
  match a {
    YamlNull => match b { YamlNull => true  _ => false }
    YamlBool { value: x } => match b { YamlBool { value: y } => x == y  _ => false }
    YamlInt { lexeme: x } => match b { YamlInt { lexeme: y } => x == y  _ => false }
    YamlFloat { lexeme: x } => match b { YamlFloat { lexeme: y } => x == y  _ => false }
    YamlString { value: x } => match b { YamlString { value: y } => x == y  _ => false }
    YamlSequence { elements: xs } => match b {
      YamlSequence { elements: ys } => yaml_values_eq(a: xs, b: ys)
      _ => false
    }
    YamlMapping { entries: xs } => match b {
      YamlMapping { entries: ys } => yaml_key_values_eq(a: xs, b: ys)
      _ => false
    }
  }
}

fn yaml_values_eq(a: List<YamlValue>, b: List<YamlValue>) -> Bool {
  (a.length() == b.length())
    && fold(enumerate(a), init: true, f: (acc, pair) => acc && match b.get(n: pair.first) {
      Present { value: y } => yaml_value_eq(a: pair.second, b: y)
      Absent => false
    })
}

fn yaml_key_values_eq(a: List<YamlKeyValue>, b: List<YamlKeyValue>) -> Bool {
  (a.length() == b.length())
    && fold(enumerate(a), init: true, f: (acc, pair) => acc && match b.get(n: pair.first) {
      Present { value: y } => (pair.second.key == y.key) && yaml_value_eq(a: pair.second.value, b: y.value)
      Absent => false
    })
}

// The value under a key, or Absent. A mapping with the key twice is not a YAML document the
// specification admits, and this answers the first occurrence rather than pretending to decide it.
fn yaml_mapping_lookup(entries: List<YamlKeyValue>, key: String) -> YamlValue? {
  match filter(entries, e => e.key == key).first() {
    Present { value: e } => Present { value: e.value }
    Absent => none
  }
}
