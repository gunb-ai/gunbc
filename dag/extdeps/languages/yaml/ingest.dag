module extdeps.languages.yaml.ingest

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.languages.yaml.types {
  YamlValue, YamlKeyValue,
  YamlNull, YamlBool, YamlInt, YamlFloat, YamlString, YamlSequence, YamlMapping,
  kv
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "yaml.org/spec/1.2.2/"
  }
}

type YamlIngestResult
  = IngestedYaml { value: YamlValue }
  | YamlIngestRejected { reason: String }

type YamlBlockResult
  = ParsedYamlBlock { value: YamlValue, next_index: Int }
  | YamlBlockRejected { reason: String }

type YamlEntryResult
  = ParsedYamlEntry { entry: YamlKeyValue, next_index: Int }
  | YamlEntryRejected { reason: String }

type YamlSeqItemResult
  = ParsedYamlSeqItem { value: YamlValue, next_index: Int }
  | YamlSeqItemRejected { reason: String }

type YamlLiteralCollectResult {
  text: String
  next_index: Int
}

data yaml_digit_chars: String = "0123456789"

fn yaml_all_digits(s: String) -> Bool {
  if s == "" {
    true
  } else {
    string_contains(s: yaml_digit_chars, pattern: substring(s: s, start: 0, end: 1)) &&
      yaml_all_digits(s: substring(s: s, start: 1, end: s.length()))
  }
}

fn yaml_looks_like_int(s: String) -> Bool {
  if s == "" {
    false
  } else if starts_with(s: s, prefix: "-") {
    let rest = substring(s: s, start: 1, end: s.length())
    (rest != "") && yaml_all_digits(s: rest)
  } else {
    yaml_all_digits(s: s)
  }
}

fn yaml_indent_of(line: String) -> Int {
  if starts_with(s: line, prefix: " ") {
    1 + yaml_indent_of(line: substring(s: line, start: 1, end: line.length()))
  } else {
    0
  }
}

fn yaml_strip_indent(line: String, indent: Int) -> String {
  substring(s: line, start: indent, end: line.length())
}

fn yaml_lines_from_source(src: String) -> List<String> {
  let raw = split(s: src, delimiter: "\n")
  let n = raw.length()
  if (n > 0) && (raw.skip(n: n - 1).first() == "") {
    raw.take(n: n - 1)
  } else {
    raw
  }
}

fn yaml_has_line_at(lines: List<String>, index: Int) -> Bool {
  index < lines.length()
}

fn yaml_line_at(lines: List<String>, index: Int) -> String {
  lines.skip(n: index).first()
}

fn yaml_indent_at(lines: List<String>, index: Int) -> Int {
  if yaml_has_line_at(lines: lines, index: index) {
    yaml_indent_of(line: yaml_line_at(lines: lines, index: index))
  } else {
    -1
  }
}

fn yaml_line_is_full_comment_at_indent(lines: List<String>, index: Int, indent: Int) -> Bool {
  if !yaml_has_line_at(lines: lines, index: index) {
    false
  } else if yaml_indent_at(lines: lines, index: index) != indent {
    false
  } else {
    starts_with(
      s: yaml_strip_indent(line: yaml_line_at(lines: lines, index: index), indent: indent),
      prefix: "#"
    )
  }
}

fn yaml_skip_full_comments_at_indent(lines: List<String>, index: Int, indent: Int) -> Int {
  if yaml_line_is_full_comment_at_indent(lines: lines, index: index, indent: indent) {
    yaml_skip_full_comments_at_indent(lines: lines, index: index + 1, indent: indent)
  } else {
    index
  }
}

// Inline comment separation is not yet modeled. Refuse the recognizable unquoted value form
// instead of silently ingesting its comment as scalar content. This intentionally errs toward
// refusal for richer scalar forms this bounded parser does not model; double-quoted scalars are
// excluded, and block-literal content never passes through this predicate.
fn yaml_has_unmodeled_inline_comment(text: String) -> Bool {
  let double_quoted = starts_with(s: text, prefix: "\"") && ends_with(s: text, suffix: "\"")
  !double_quoted && (
    string_contains(s: text, pattern: " #")
      || string_contains(s: text, pattern: "\t#")
  )
}

fn yaml_unescape_double_quoted(s: String) -> String {
  if s == "" {
    ""
  } else if starts_with(s: s, prefix: "\\\"") {
    concat("\"", yaml_unescape_double_quoted(s: substring(s: s, start: 2, end: s.length())))
  } else if starts_with(s: s, prefix: "\\\\") {
    concat("\\", yaml_unescape_double_quoted(s: substring(s: s, start: 2, end: s.length())))
  } else {
    concat(substring(s: s, start: 0, end: 1), yaml_unescape_double_quoted(s: substring(s: s, start: 1, end: s.length())))
  }
}

fn yaml_is_flow_sequence_text(text: String) -> Bool {
  starts_with(s: text, prefix: "[") && ends_with(s: text, suffix: "]")
}

fn yaml_parse_flow_sequence(text: String) -> YamlValue {
  let inner = substring(s: text, start: 1, end: text.length() - 1)
  if inner == "" {
    YamlSequence { elements: [] }
  } else {
    YamlSequence { elements: map(split(s: inner, delimiter: ", "), t => yaml_parse_scalar_text(text: t)) }
  }
}

fn yaml_parse_scalar_text(text: String) -> YamlValue {
  if text == "''" {
    YamlString { value: "" }
  } else if starts_with(s: text, prefix: "\"") && ends_with(s: text, suffix: "\"") && (text.length() >= 2) {
    YamlString { value: yaml_unescape_double_quoted(s: substring(s: text, start: 1, end: text.length() - 1)) }
  } else if text == "true" {
    YamlBool { value: true }
  } else if text == "false" {
    YamlBool { value: false }
  } else if yaml_looks_like_int(s: text) {
    YamlInt { lexeme: text }
  } else {
    YamlString { value: text }
  }
}

fn yaml_collect_literal_lines_from(lines: List<String>, index: Int, content_indent: Int, acc: List<String>) -> YamlLiteralCollectResult {
  if yaml_has_line_at(lines: lines, index: index) && (yaml_line_at(lines: lines, index: index) == "") {
    yaml_collect_literal_lines_from(lines: lines, index: index + 1, content_indent: content_indent, acc: concat(acc, [""]))
  } else if yaml_has_line_at(lines: lines, index: index) && (yaml_indent_at(lines: lines, index: index) >= content_indent) {
    let stripped = yaml_strip_indent(line: yaml_line_at(lines: lines, index: index), indent: content_indent)
    yaml_collect_literal_lines_from(lines: lines, index: index + 1, content_indent: content_indent, acc: concat(acc, [stripped]))
  } else {
    YamlLiteralCollectResult { text: join(acc, "\n"), next_index: index }
  }
}

// THE Absent ARMS BELOW ARE UNREACHABLE, AND THEY REFUSE RATHER THAN SUBSTITUTE.
// Every optional here is `split(...).first()`, and `split` cannot return an empty
// list -- on the empty string it returns [""] -- so Absent cannot occur. That
// non-emptiness is a property of split's IMPLEMENTATION that its return type
// `List<T>` does not carry, which is exactly why these positions are diagnosed at
// all: nothing enforces the property the code relies on.
//
// The arms therefore refuse instead of substituting a plausible value. The choice
// is only free while the unreachability argument holds, so it is made for the case
// where that argument is WRONG -- a reimplemented split, a different producer, a
// caller passing something that is not a split result. A refusal stops the line
// loudly and located; a fabricated empty value would be the absorbing fallback
// (DESIGN 5). Dissolves when split's return type carries non-emptiness AND these
// callers consume it -- see gunbc.guarantee_stall split_non_emptiness_unmodelled_stall.
fn yaml_parse_mapping_entry(lines: List<String>, index: Int, indent: Int) -> YamlEntryResult {
  let content = yaml_strip_indent(line: yaml_line_at(lines: lines, index: index), indent: indent)
  let parts = split(s: content, delimiter: ": ")
  if parts.length() > 1 {
    match parts.first() {
      Absent => YamlEntryRejected { reason: concat("malformed mapping entry: ", content) }
      Present { value: key } =>
    let rest = join(parts.skip(n: 1), ": ")
    if yaml_has_unmodeled_inline_comment(text: rest) {
      YamlEntryRejected { reason: "inline YAML comments after values are not modeled" }
    } else if rest == "|" {
      let lit = yaml_collect_literal_lines_from(lines: lines, index: index + 1, content_indent: indent + 2, acc: [])
      ParsedYamlEntry { entry: kv(key: key, value: YamlString { value: lit.text }), next_index: lit.next_index }
    } else if yaml_is_flow_sequence_text(text: rest) {
      ParsedYamlEntry { entry: kv(key: key, value: yaml_parse_flow_sequence(text: rest)), next_index: index + 1 }
    } else {
      ParsedYamlEntry { entry: kv(key: key, value: yaml_parse_scalar_text(text: rest)), next_index: index + 1 }
    }
    }
  } else if ends_with(s: content, suffix: ":") {
    let key = substring(s: content, start: 0, end: content.length() - 1)
    if yaml_has_line_at(lines: lines, index: index + 1) && (yaml_indent_at(lines: lines, index: index + 1) == indent + 2) {
      match yaml_parse_block(lines: lines, index: index + 1, indent: indent + 2) {
        ParsedYamlBlock { value: nested, next_index: ni } =>
          ParsedYamlEntry { entry: kv(key: key, value: nested), next_index: ni }
        YamlBlockRejected { reason: r } => YamlEntryRejected { reason: r }
      }
    } else {
      ParsedYamlEntry { entry: kv(key: key, value: YamlNull), next_index: index + 1 }
    }
  } else {
    YamlEntryRejected { reason: concat("malformed mapping entry: ", content) }
  }
}

fn yaml_parse_mapping_entry_from_text(text: String, lines: List<String>, index: Int, indent: Int) -> YamlEntryResult {
  let parts = split(s: text, delimiter: ": ")
  if parts.length() > 1 {
    match parts.first() {
      Absent => YamlEntryRejected { reason: concat("malformed mapping entry: ", text) }
      Present { value: key } =>
    let rest = join(parts.skip(n: 1), ": ")
    if yaml_has_unmodeled_inline_comment(text: rest) {
      YamlEntryRejected { reason: "inline YAML comments after values are not modeled" }
    } else if rest == "|" {
      let lit = yaml_collect_literal_lines_from(lines: lines, index: index + 1, content_indent: indent + 4, acc: [])
      ParsedYamlEntry { entry: kv(key: key, value: YamlString { value: lit.text }), next_index: lit.next_index }
    } else if yaml_is_flow_sequence_text(text: rest) {
      ParsedYamlEntry { entry: kv(key: key, value: yaml_parse_flow_sequence(text: rest)), next_index: index + 1 }
    } else {
      ParsedYamlEntry { entry: kv(key: key, value: yaml_parse_scalar_text(text: rest)), next_index: index + 1 }
    }
    }
  } else if ends_with(s: text, suffix: ":") {
    let key = substring(s: text, start: 0, end: text.length() - 1)
    if yaml_has_line_at(lines: lines, index: index + 1) && (yaml_indent_at(lines: lines, index: index + 1) == indent + 4) {
      match yaml_parse_block(lines: lines, index: index + 1, indent: indent + 4) {
        ParsedYamlBlock { value: nested, next_index: ni } =>
          ParsedYamlEntry { entry: kv(key: key, value: nested), next_index: ni }
        YamlBlockRejected { reason: r } => YamlEntryRejected { reason: r }
      }
    } else {
      ParsedYamlEntry { entry: kv(key: key, value: YamlNull), next_index: index + 1 }
    }
  } else {
    YamlEntryRejected { reason: concat("malformed sequence-item mapping entry: ", text) }
  }
}

fn yaml_parse_mapping_entries(lines: List<String>, index: Int, indent: Int, acc: List<YamlKeyValue>) -> YamlBlockResult {
  let current = yaml_skip_full_comments_at_indent(lines: lines, index: index, indent: indent)
  if !yaml_has_line_at(lines: lines, index: current) {
    ParsedYamlBlock { value: YamlMapping { entries: acc }, next_index: current }
  } else if yaml_indent_at(lines: lines, index: current) != indent {
    ParsedYamlBlock { value: YamlMapping { entries: acc }, next_index: current }
  } else if starts_with(s: yaml_strip_indent(line: yaml_line_at(lines: lines, index: current), indent: indent), prefix: "- ") {
    ParsedYamlBlock { value: YamlMapping { entries: acc }, next_index: current }
  } else {
    match yaml_parse_mapping_entry(lines: lines, index: current, indent: indent) {
      ParsedYamlEntry { entry: e, next_index: ni } =>
        yaml_parse_mapping_entries(lines: lines, index: ni, indent: indent, acc: concat(acc, [e]))
      YamlEntryRejected { reason: r } => YamlBlockRejected { reason: r }
    }
  }
}

fn yaml_parse_seq_item(lines: List<String>, index: Int, indent: Int) -> YamlSeqItemResult {
  let content = yaml_strip_indent(line: yaml_line_at(lines: lines, index: index), indent: indent)
  let item_text = substring(s: content, start: 2, end: content.length())
  if item_text == "|" {
    let lit = yaml_collect_literal_lines_from(lines: lines, index: index + 1, content_indent: indent + 2, acc: [])
    ParsedYamlSeqItem { value: YamlString { value: lit.text }, next_index: lit.next_index }
  } else if yaml_is_flow_sequence_text(text: item_text) {
    ParsedYamlSeqItem { value: yaml_parse_flow_sequence(text: item_text), next_index: index + 1 }
  } else if string_contains(s: item_text, pattern: ": ") || ends_with(s: item_text, suffix: ":") {
    match yaml_parse_mapping_entry_from_text(text: item_text, lines: lines, index: index, indent: indent) {
      ParsedYamlEntry { entry: first_entry, next_index: ni } =>
        match yaml_parse_mapping_entries(lines: lines, index: ni, indent: indent + 2, acc: [first_entry]) {
          ParsedYamlBlock { value: v, next_index: fi } => ParsedYamlSeqItem { value: v, next_index: fi }
          YamlBlockRejected { reason: r } => YamlSeqItemRejected { reason: r }
        }
      YamlEntryRejected { reason: r } => YamlSeqItemRejected { reason: r }
    }
  } else if yaml_has_unmodeled_inline_comment(text: item_text) {
    YamlSeqItemRejected { reason: "inline YAML comments after values are not modeled" }
  } else {
    ParsedYamlSeqItem { value: yaml_parse_scalar_text(text: item_text), next_index: index + 1 }
  }
}

fn yaml_parse_seq_items(lines: List<String>, index: Int, indent: Int, acc: List<YamlValue>) -> YamlBlockResult {
  let current = yaml_skip_full_comments_at_indent(lines: lines, index: index, indent: indent)
  if !yaml_has_line_at(lines: lines, index: current) {
    ParsedYamlBlock { value: YamlSequence { elements: acc }, next_index: current }
  } else if yaml_indent_at(lines: lines, index: current) != indent {
    ParsedYamlBlock { value: YamlSequence { elements: acc }, next_index: current }
  } else if !starts_with(s: yaml_strip_indent(line: yaml_line_at(lines: lines, index: current), indent: indent), prefix: "- ") {
    ParsedYamlBlock { value: YamlSequence { elements: acc }, next_index: current }
  } else {
    match yaml_parse_seq_item(lines: lines, index: current, indent: indent) {
      ParsedYamlSeqItem { value: v, next_index: ni } =>
        yaml_parse_seq_items(lines: lines, index: ni, indent: indent, acc: concat(acc, [v]))
      YamlSeqItemRejected { reason: r } => YamlBlockRejected { reason: r }
    }
  }
}

fn yaml_parse_block(lines: List<String>, index: Int, indent: Int) -> YamlBlockResult {
  let current = yaml_skip_full_comments_at_indent(lines: lines, index: index, indent: indent)
  if !yaml_has_line_at(lines: lines, index: current) {
    YamlBlockRejected { reason: "expected a YAML block, found end of input" }
  } else if yaml_indent_at(lines: lines, index: current) != indent {
    YamlBlockRejected { reason: concat("indentation mismatch at line ", to_string(current)) }
  } else {
    let content = yaml_strip_indent(line: yaml_line_at(lines: lines, index: current), indent: indent)
    if starts_with(s: content, prefix: "- ") {
      yaml_parse_seq_items(lines: lines, index: current, indent: indent, acc: [])
    } else {
      yaml_parse_mapping_entries(lines: lines, index: current, indent: indent, acc: [])
    }
  }
}

fn ingest_yaml_source(src: String) -> YamlIngestResult {
  let lines = yaml_lines_from_source(src: src)
  if lines.length() == 0 {
    YamlIngestRejected { reason: "empty document" }
  } else {
    match yaml_parse_block(lines: lines, index: 0, indent: 0) {
      ParsedYamlBlock { value: v, next_index: ni } =>
        if ni == lines.length() {
          IngestedYaml { value: v }
        } else {
          YamlIngestRejected { reason: concat("trailing content at line ", to_string(ni)) }
        }
      YamlBlockRejected { reason: r } => YamlIngestRejected { reason: r }
    }
  }
}

fn yaml_source_parses(src: String) -> Bool {
  match ingest_yaml_source(src: src) {
    IngestedYaml { value: _ } => true
    YamlIngestRejected { reason: _ } => false
  }
}
