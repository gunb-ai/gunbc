module extdeps.languages.spice.subject

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "ngspice.sourceforge.io/docs.html"
  }
}

data ngspice_simulator_subject_note: String = "NGSPICE, THE IMPLEMENTATION, cited to the Ngspice user's manual (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched page describes ngspice as 'the open source Spice circuit simulator', a 'mixed mode - mixed level circuit simulator - based on Berkeley's Spice3f5', with the current release manual at version 46. WHY THE SUBJECT IS NGSPICE AND NOT 'SPICE': SPICE originates as Berkeley's simulator family and has no single governing specification for the netlist language; the concrete artifact this repository would emit for and execute against is ngspice, which is independently versioned and maintained, so ngspice is the honest subject per DESIGN section 3. Berkeley Spice3f5 is named by the upstream as ngspice's ancestor and would be a separate historical subject if it were ever needed. PLACEMENT: this carrier sits under languages/ with the other target subjects while the surface it grounds lives at v2.extdeps.formats.spice — paths are discriminators, not gospel (DESIGN section 3), and the subject's home is its layer."

type Ngspice
  = | NgspiceTarget

data ngspice_simulator: Ngspice = NgspiceTarget

data ngspice_simulator_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.languages.spice.subject",
      decl_name: "ngspice_simulator",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data ngspice_simulator_mandated_scope_name_scaffold_note: String = "DECLARED SCAFFOLD, with its dissolution triggers — why the scope is authored under a unique name and the mandated name is bound to it. The authored value is the one above; 'extdeps_model_scope' is a BINDING to that same value, not a second authority, and it cannot drift from its source because it IS its source. It exists because two independent mechanisms collide. (1) gunbc.extdeps_scope_frontier's carrier_content_declares_scope text-scans every scope carrier for the literal 'data extdeps_model_scope:', so the name is mandatory. (2) The resolver offers no way to name two same-named imports apart: MEASURED 2026-08-04 against the real binary, a qualified reference (extdeps.languages.rust.subject.rust_language_model_scope) fails with 'undefined variable', module projection after an import fails the same way, no import aliasing exists in the grammar, and — the reason this is not merely inconvenient — importing one name from two modules does NOT refuse, it SILENTLY BINDS THE LAST ONE with exit 0. So a registry importing the mandated name from every carrier would ground 22 of 23 targets in the WRONG upstream scope and, because registration_subject derives the subject from the grounding, report the wrong subject for each — green and materially false. The unique name is what keeps that unwritable. DISSOLVE-ON, either trigger suffices: the resolver gains import aliasing or module projection (then the registry imports the mandated name directly and this binding deletes), OR the v2.lens.mandatory_tag region promotion retires the carrier_content_declares_scope text scan (then the mandated name is no longer required and the unique name stands alone). This is a scaffold pinned to a scaffold — carrier_content_declares_scope calls itself a declared scaffold in its own note — and they retire together. The resolver defect itself is corpus-wide and is being raised as its own lane; it is not a language-support fact."

data extdeps_model_scope: ExternalModelScope = ngspice_simulator_model_scope
