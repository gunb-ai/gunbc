module extdeps.languages.spice.subject

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "ptolemy.berkeley.edu/projects/embedded/pubs/downloads/spice/index.htm"
  }
}

data spice_netlist_dialect_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "ngspice.sourceforge.io/docs.html"
  }
}

data spice_netlist_language_subject_note: String = "THE SPICE NETLIST LANGUAGE — THE TARGET MEDIUM, SPLIT FROM THE SIMULATOR THAT EXECUTES IT (cursor review 48122, P0; the split IS this file's reason to exist). An earlier revision registered ngspice as the target itself, which collapsed an interface into one of its implementations — the same fusion this registry refuses for machine_code, committed one row over. The surface being modelled makes the split obvious once looked at: v2.extdeps.formats.spice carries a generic SpiceNetlist with a generic spice_emit AND a separate spice_emit_ngspice, which is exactly the shape of a medium plus a per-implementation realization. So the medium is the target and ngspice is a RUNTIME bound to it, carried at gunbc.language_target_registry as a TargetRuntimeBinding rather than as a second language. VERIFIED LIVE 2026-08-04: the cited Berkeley page states SPICE was developed at UC Berkeley and describes the 1972 release as the industry-standard tool for integrated circuit design. THE HONEST WEAKNESS OF THIS CITATION, stated rather than smoothed over: SPICE has NO single normative netlist specification. Berkeley is the origin authority, the fetched page references a Spice3 README and Postscript documentation without naming a formal netlist grammar, and there is no SPICE standards committee. That is a real property of this target, not a gap in the lookup — and it is exactly why the ngspice manual is carried as a SECOND CITATION of this subject: it is the readable authority for the concrete DIALECT this repository would actually emit. A support claim for SPICE must therefore name the dialect it implements, for the same reason the CommonMark subject must not be called 'Markdown'."

type SpiceNetlistLanguage
  = | SpiceNetlistLanguageTarget

data spice_netlist_language: SpiceNetlistLanguage = SpiceNetlistLanguageTarget

data spice_netlist_language_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.languages.spice.subject",
      decl_name: "spice_netlist_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [spice_netlist_dialect_authority]
}

data spice_netlist_language_mandated_scope_name_scaffold_note: String = "DECLARED SCAFFOLD — the shared explanation and both dissolution triggers live once at gunbc.language_subject_scope_scaffold mandated_scope_name_scaffold, and are deliberately not repeated inside an upstream subject carrier (cursor review 48122)."

data extdeps_model_scope: ExternalModelScope = spice_netlist_language_model_scope
