module extdeps.languages.spice.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "ptolemy.berkeley.edu/projects/embedded/pubs/downloads/spice/index.htm"
  }
}

data spice_netlist_language_subject_note: String = "THE SPICE NETLIST LANGUAGE — THE TARGET MEDIUM, SPLIT FROM THE SIMULATOR THAT EXECUTES IT (cursor review 48122, P0; the split IS this file's reason to exist). An earlier revision registered ngspice as the target itself, which collapsed an interface into one of its implementations — the same fusion this registry refuses for machine_code, committed one row over. The surface being modelled makes the split obvious once looked at: v2.extdeps.formats.spice carries a generic SpiceNetlist with a generic spice_emit AND a separate spice_emit_ngspice, which is exactly the shape of a medium plus a per-implementation realization. So the medium is the target and ngspice is a RUNTIME bound to it, carried at gunbc.language_target_registry as a TargetRuntimeBinding rather than as a second language. VERIFIED LIVE 2026-08-04: the cited Berkeley page states SPICE was developed at UC Berkeley and describes the 1972 release as the industry-standard tool for integrated circuit design. THE HONEST WEAKNESS OF THIS CITATION, stated rather than smoothed over: SPICE has NO single normative netlist specification. Berkeley is the origin authority, the fetched page references a Spice3 README and Postscript documentation without naming a formal netlist grammar, and there is no SPICE standards committee. That is a real property of this target, not a gap in the lookup. A support claim for SPICE must therefore name the dialect it implements, for the same reason the CommonMark subject must not be called 'Markdown'. THE DIALECT AUTHORITY IS DELIBERATELY NOT CITED HERE, AND AN EARLIER REVISION OF THIS FILE GOT IT WRONG (cursor review 48361). That revision carried the ngspice manual as a second citation of this subject, reasoning that a weak origin citation should be shored up by the readable authority for the concrete dialect. That is the exact violation this same PR wrote the rule against one file over: extdeps.languages.bash.subject records that a citation grounds THIS subject and that a second independently governed subject is never a citation of the first, which is why the POSIX specification is its own subject with conformance joined at the product layer. The ngspice manual is not a document about the SPICE netlist medium — it is ngspice's OWN governing document, and it is literally the authority anchor of extdeps.simulators.ngspice.subject. Borrowing it here claimed ngspice's upstream grounds this one, and it re-forked the single fact the medium/runtime split had just separated. The self-contradiction is the tell: the split was made BECAUSE the two are independently governed, so the citation could not consistently treat them as one. WHERE THE DIALECT FACT LIVES INSTEAD: gunbc.language_target_registry's TargetRuntimeBinding already relates this medium to ngspice as the runtime that would execute it, which is the product-layer join the Bash/POSIX case uses for the same shape. A weak citation stated honestly is better than a strong one belonging to somebody else."

type SpiceNetlistLanguage
  = | SpiceNetlistLanguageTarget

data spice_netlist_language: SpiceNetlistLanguage = SpiceNetlistLanguageTarget

data spice_netlist_language_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.languages.spice.subject",
      decl_name: "spice_netlist_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.languages.spice.subject.extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = spice_netlist_language_model_scope
