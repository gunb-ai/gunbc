module extdeps.languages.c.emit


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.iso.org/standard/74528.html"
  }
}

data c_header_extension: String = ".h"
data c_source_extension: String = ".c"
data c_object_extension: String = ".o"

data c_include_directive_open: String = "#include \""
data c_include_directive_close: String = "\""

fn c_path_with_extension(basename: String, extension: String) -> String {
  concat(basename, extension)
}

fn c_include_directive_for_header_path(header_path: String) -> String {
  concat(
    c_include_directive_open,
    concat(header_path, c_include_directive_close)
  )
}
