module extdeps.languages.dag.syntax

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

import std.syntax {
  ParseEnvironment,
  ItemForm, ItemFormKind, FuncForm, StructForm, EnumForm, TypeAliasForm, ModuleForm, OtherForm,
  BodyKind,
  ExprBody, BlockBody, TypeBody, ValueBody, NoBody,
  ResourceBody, ServiceBody,
  OperatorSpec, SyntaxSpec,
  BinOp, Add, Sub, Mul, Div, Mod,
  Eq, Ne, Lt, Gt, Le, Ge, And, Or, NullCoalesce,
  LiteralValue, LitBool, LitNull
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/blob/main/DESIGN.md#4-the-closed-grounded-substrate"
  }
}

data dag_item_forms: List<ItemForm> = [
  ItemForm { kind: OtherForm, keyword: "alias", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: AliasBody },
  ItemForm { kind: TypeAliasForm, keyword: "type", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: TypeBody },
  ItemForm { kind: FuncForm, keyword: "fn", has_type_params: true, has_params: true,
    has_return_type: true, return_required: true,
    has_uses: true, body_kind: ExprBody },
  ItemForm { kind: OtherForm, keyword: "resource", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: ResourceBody },
  ItemForm { kind: OtherForm, keyword: "service", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: ServiceBody },
  ItemForm { kind: OtherForm, keyword: "data", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: ValueBody },
  ItemForm { kind: OtherForm, keyword: "pattern", has_type_params: false, has_params: true,
    has_return_type: true, return_required: false,
    has_uses: true, body_kind: BlockBody },
  ItemForm { kind: OtherForm, keyword: "interface", has_type_params: false, has_params: true,
    has_return_type: true, return_required: false,
    has_uses: false, body_kind: BlockBody }
]

data dag_keyword_literals: Map<String, LiteralValue> = {
  "true": LitBool { value: true },
  "false": LitBool { value: false },
  "none": LitNull,
  "null": LitNull
}

data dag_keyword_set: Map<String, Bool> = {
  "module": true, "import": true, "alias": true, "type": true, "fn": true,
  "resource": true, "service": true, "data": true,
  "interface": true, "pipeline": true, "profile": true, "pattern": true,
  "let": true, "return": true, "match": true, "if": true, "then": true, "else": true,
  "for": true, "in": true, "where": true, "with": true,
  "true": true, "false": true, "none": true, "null": true,
  "acquire": true, "release": true, "capability": true, "operation": true,
  "input": true, "output": true,
  "idempotent": true, "readonly": true, "hermetic": true
}

data dag_non_name_keywords: Map<String, Bool> = {
  "true": true, "false": true, "none": true, "null": true,
  "acquire": true, "release": true
}

// Name-admissible keywords that still may not bind as pattern names.
// keyword_may_bind_as_pattern_name refuses if the spelling is in dag_non_name_keywords
// (true/false/none/null/acquire/release) OR in this row. This row is only the
// name-admissible residue; acquire/release are not repeated here.
data dag_non_pattern_binder_keywords: Map<String, Bool> = {
  "match": true
}

data dag_operators: List<OperatorSpec> = [
  OperatorSpec { symbol: "||", left_bp: 5, right_bp: 6, binop: Or, algebra_field: none },
  OperatorSpec { symbol: "&&", left_bp: 7, right_bp: 8, binop: And, algebra_field: none },
  OperatorSpec { symbol: "??", left_bp: 8, right_bp: 9, binop: NullCoalesce, algebra_field: none },
  OperatorSpec { symbol: "==", left_bp: 9, right_bp: 10, binop: Eq, algebra_field: none },
  OperatorSpec { symbol: "!=", left_bp: 9, right_bp: 10, binop: Ne, algebra_field: none },
  OperatorSpec { symbol: "<", left_bp: 11, right_bp: 12, binop: Lt, algebra_field: none },
  OperatorSpec { symbol: ">", left_bp: 11, right_bp: 12, binop: Gt, algebra_field: none },
  OperatorSpec { symbol: "<=", left_bp: 11, right_bp: 12, binop: Le, algebra_field: none },
  OperatorSpec { symbol: ">=", left_bp: 11, right_bp: 12, binop: Ge, algebra_field: none },
  OperatorSpec { symbol: "+", left_bp: 13, right_bp: 14, binop: Add, algebra_field: none },
  OperatorSpec { symbol: "-", left_bp: 13, right_bp: 14, binop: Sub, algebra_field: none },
  OperatorSpec { symbol: "*", left_bp: 15, right_bp: 16, binop: Mul, algebra_field: none },
  OperatorSpec { symbol: "/", left_bp: 15, right_bp: 16, binop: Div, algebra_field: none },
  OperatorSpec { symbol: "%", left_bp: 15, right_bp: 16, binop: Mod, algebra_field: none },
  OperatorSpec { symbol: "|>", left_bp: 17, right_bp: 18, binop: none, algebra_field: none },
  OperatorSpec { symbol: ".", left_bp: 19, right_bp: 20, binop: none, algebra_field: none }
]

data v3_supported_dag_operators: Map<String, Bool> = {
  "||": true, "&&": true,
  "==": true, "!=": true, "<": true, ">": true, "<=": true, ">=": true,
  "+": true, "-": true, "*": true, "/": true,
  "|>": true, ".": true
}

data dag_syntax_spec: SyntaxSpec = SyntaxSpec {
  item_forms: dag_item_forms,
  operators: dag_operators,
  keyword_literals: dag_keyword_literals,
  keyword_set: dag_keyword_set
}

// THE HEAD REVISION'S OWN DECLARATIVE PARSE ENVIRONMENT, named so that "the grammar this binary was
// built with" is a VALUE a caller passes rather than an ambient fact a callee reaches for. Every
// ordinary parse passes this one; a cross-revision read passes the environment it decoded from the
// revision it is reading. The two are the same shape, which is what makes the base route a
// different ARGUMENT rather than a different code path -- and a second code path is precisely how
// the base side came to be read under head rules in the first place.
data dag_parse_environment: ParseEnvironment = ParseEnvironment {
  syntax_spec: dag_syntax_spec,
  non_name_keywords: dag_non_name_keywords,
  non_pattern_binder_keywords: dag_non_pattern_binder_keywords,
}

// THE .dag ANNOTATION SPELLING: the `//` delimiter stripped and rendered, once, for every realization that captures .dag comments -- v1.compiler.annotation_bind and v2.compiler.parse attach through it. render_annotation_block's consumer is the round trip in v1.tests.claim.annotation_gap_round_trip_test, which renders a parsed graph back into source and re-parses it. No production .dag-source renderer exists yet; one that rewrites authored .dag from the semantic graph must write prose back through this spelling or it drops it.

// The single place `//` is removed, and it is here rather than in the tokenizer on purpose. A capture carries RAW syntax so the lexer reports what it saw; normalization into durable text is a language fact, and .dag's fact is that the delimiter is two slashes optionally followed by one space.

// Exactly one space is consumed, never a run, because `//   indented` is authored indentation the writer chose and swallowing it would silently rewrite the prose. A lexeme not starting with the delimiter passes through unchanged rather than being truncated by a fixed offset — that arm is unreachable through the .dag annotation rule today, and the alternative is a normalizer that corrupts content when it is wrong about its input.
fn strip_line_comment_delimiter(lexeme: String) -> String {
  let len = string_length(s: lexeme)
  if starts_with(s: lexeme, prefix: "// ") {
    substring(s: lexeme, start: 3, end: len)
  } else if starts_with(s: lexeme, prefix: "//") {
    substring(s: lexeme, start: 2, end: len)
  } else {
    lexeme
  }
}

// THE CANONICAL .dag SPELLING, and the inverse of strip_line_comment_delimiter directly above. It sits beside its inverse deliberately: the delimiter is stated once, and a change to what .dag strips is in the same edit as what .dag writes. Two functions in two modules agreeing about `//` by coincidence is the fork this lane removes.

// The form is a single `//` followed by one space, then the line's normalized text. The empty line renders as a bare `//` with NO trailing space, and that is a correctness case rather than tidiness: `// ` and `//` both normalize to the empty string, so either round-trips, but a trailing space is the character formatters and editors strip on save — so choosing the spelling that survives contact with a text editor is choosing the one that keeps the fixed point stable. An empty line inside a block is reachable: an author writing a bare `//` between two commented lines produces one block whose middle line is empty.

// Text is NOT re-indented, re-wrapped, or trimmed. `//   indented` normalizes to two spaces plus `indented` and renders back to `//   indented`, because the authored indentation is content — the strip step consumes exactly one space for exactly this reason, and a renderer that trimmed would delete authored structure on the first round trip.
fn render_line_comment_delimiter(line: String) -> String {
  if string_length(s: line) == 0 { "//" } else { concat("// ", line) }
}

// One row becomes one BLOCK: its embedded line breaks become adjacent annotation lines with nothing between them. Adjacency is what the grouping fold reads back as `one block`, so the joiner here and the blank-line rule below are the two halves of one law stated in std.source_annotation.
fn render_annotation_block(text: String) -> String {
  split(s: text, delimiter: "\n")
    |> map(line => render_line_comment_delimiter(line: line))
    |> join(separator: "\n")
}
