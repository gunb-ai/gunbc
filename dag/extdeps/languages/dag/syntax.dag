module extdeps.languages.dag.syntax



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/gunb-ai/gunbc/blob/main/DESIGN.md#4-the-closed-grounded-substrate"
  }
}

data dag_item_forms: List<std.syntax.ItemForm> = [
  std.syntax.ItemForm { kind: std.syntax.OtherForm, keyword: "alias", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: AliasBody },
  std.syntax.ItemForm { kind: std.syntax.TypeAliasForm, keyword: "type", has_type_params: true, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: std.syntax.TypeBody },
  std.syntax.ItemForm { kind: std.syntax.FuncForm, keyword: "fn", has_type_params: true, has_params: true,
    has_return_type: true, return_required: true,
    has_uses: false, body_kind: std.syntax.ExprBody },
  std.syntax.ItemForm { kind: std.syntax.FuncForm, keyword: "func", has_type_params: false, has_params: true,
    has_return_type: true, return_required: false,
    has_uses: true, body_kind: std.syntax.BlockBody },
  std.syntax.ItemForm { kind: std.syntax.OtherForm, keyword: "resource", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: std.syntax.ResourceBody },
  std.syntax.ItemForm { kind: std.syntax.OtherForm, keyword: "service", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: std.syntax.ServiceBody },
  std.syntax.ItemForm { kind: std.syntax.OtherForm, keyword: "data", has_type_params: false, has_params: false,
    has_return_type: false, return_required: false,
    has_uses: false, body_kind: std.syntax.ValueBody },
  std.syntax.ItemForm { kind: std.syntax.OtherForm, keyword: "pattern", has_type_params: false, has_params: true,
    has_return_type: true, return_required: false,
    has_uses: true, body_kind: std.syntax.BlockBody },
  std.syntax.ItemForm { kind: std.syntax.OtherForm, keyword: "interface", has_type_params: false, has_params: true,
    has_return_type: true, return_required: false,
    has_uses: false, body_kind: std.syntax.BlockBody }
]

data dag_keyword_literals: Map<String, std.syntax.LiteralValue> = {
  "true": std.syntax.LitBool { value: true },
  "false": std.syntax.LitBool { value: false },
  "none": std.syntax.LitNull,
  "null": std.syntax.LitNull
}

data dag_keyword_set: Map<String, Bool> = {
  "module": true, "import": true, "alias": true, "type": true, "fn": true, "func": true,
  "resource": true, "service": true, "data": true,
  "interface": true, "pipeline": true, "profile": true, "pattern": true,
  "let": true, "return": true, "match": true, "if": true, "then": true, "else": true,
  "for": true, "in": true, "where": true, "with": true,
  "true": true, "false": true, "none": true, "null": true,
  "acquire": true, "release": true, "capability": true, "operation": true,
  "input": true, "output": true,
  "idempotent": true, "readonly": true, "hermetic": true
}

data dag_non_name_keywords: Map<String, Bool> = {
  "true": true, "false": true, "none": true, "null": true,
  "acquire": true, "release": true
}

data dag_operators: List<std.syntax.OperatorSpec> = [
  std.syntax.OperatorSpec { symbol: "||", left_bp: 5, right_bp: 6, binop: std.syntax.Or, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "&&", left_bp: 7, right_bp: 8, binop: std.syntax.And, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "??", left_bp: 8, right_bp: 9, binop: std.syntax.NullCoalesce, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "==", left_bp: 9, right_bp: 10, binop: std.syntax.Eq, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "!=", left_bp: 9, right_bp: 10, binop: std.syntax.Ne, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "<", left_bp: 11, right_bp: 12, binop: std.syntax.Lt, algebra_field: none },
  std.syntax.OperatorSpec { symbol: ">", left_bp: 11, right_bp: 12, binop: std.syntax.Gt, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "<=", left_bp: 11, right_bp: 12, binop: std.syntax.Le, algebra_field: none },
  std.syntax.OperatorSpec { symbol: ">=", left_bp: 11, right_bp: 12, binop: std.syntax.Ge, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "+", left_bp: 13, right_bp: 14, binop: std.syntax.Add, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "-", left_bp: 13, right_bp: 14, binop: std.syntax.Sub, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "*", left_bp: 15, right_bp: 16, binop: std.syntax.Mul, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "/", left_bp: 15, right_bp: 16, binop: std.syntax.Div, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "%", left_bp: 15, right_bp: 16, binop: std.syntax.Mod, algebra_field: none },
  std.syntax.OperatorSpec { symbol: "|>", left_bp: 17, right_bp: 18, binop: none, algebra_field: none },
  std.syntax.OperatorSpec { symbol: ".", left_bp: 19, right_bp: 20, binop: none, algebra_field: none }
]

data v3_supported_dag_operators: Map<String, Bool> = {
  "||": true, "&&": true,
  "==": true, "!=": true, "<": true, ">": true, "<=": true, ">=": true,
  "+": true, "-": true, "*": true, "/": true,
  "|>": true, ".": true
}

data dag_syntax_spec: std.syntax.SyntaxSpec = std.syntax.SyntaxSpec {
  item_forms: dag_item_forms,
  operators: dag_operators,
  keyword_literals: dag_keyword_literals,
  keyword_set: dag_keyword_set
}
