module extdeps.languages.simd.kernel

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.communication.medium { Medium, Lossless }
import std.types { NonEmptyStr, Int, List, Float }
import std.numerical_contract {
  FmaContractionPolicy,
  FmaContractionRefused,
  FmaContractionPermitted,
}
import std.bytes { pure_dag_seam_unreachable }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "gcc.gnu.org/onlinedocs/gcc/Vector-Extensions.html"
  }
}

data simd_kernel_target_medium_name: NonEmptyStr = "simd-contiguous-loop"

type SimdKernelBufferLayout
  = ContiguousSoa
  | ArrayOfStructures

type SimdKernelEmitSurface {
  fused_op_count: Int
  buffer_layout: SimdKernelBufferLayout
}

fn simd_kernel_medium(surface: SimdKernelEmitSurface) -> Medium<SimdKernelEmitSurface> {
  Medium {
    carried: surface
    fidelity: Lossless
  }
}

fn simd_relu_mul_add_kernel_surface() -> SimdKernelEmitSurface {
  SimdKernelEmitSurface {
    fused_op_count: 3
    buffer_layout: ContiguousSoa
  }
}

fn witness_relu_mul_add_kernel_surface_shape() -> Bool {
  let surface = simd_relu_mul_add_kernel_surface()
  match surface.buffer_layout {
    ContiguousSoa => surface.fused_op_count == 3
    ArrayOfStructures => false
  }
}

data elemwise_mul_wire_op_code: Int = 1
data elemwise_add_wire_op_code: Int = 2
data elemwise_relu_wire_op_code: Int = 3

data relu_mul_add_wire_op_codes: List<Int> = [
  elemwise_mul_wire_op_code,
  elemwise_add_wire_op_code,
  elemwise_relu_wire_op_code,
]


data host_kernel_relu_mul_add_op_codes_scaffold_note: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.languages.simd.kernel",
    decl_name: "relu_mul_add_wire_op_codes",
    field: WholeDeclaration
  }
}

fn witness_relu_mul_add_wire_op_codes_are_locked_triplet() -> Bool {
  if relu_mul_add_wire_op_codes.length() != 3 {
    false
  } else {
    match relu_mul_add_wire_op_codes.first() {
      Present { value: c0 } =>
        match relu_mul_add_wire_op_codes.skip(n: 1).first() {
          Present { value: c1 } =>
            match relu_mul_add_wire_op_codes.skip(n: 2).first() {
              Present { value: c2 } =>
                c0 == elemwise_mul_wire_op_code
                  && c1 == elemwise_add_wire_op_code
                  && c2 == elemwise_relu_wire_op_code
              Absent => false
            }
          Absent => false
        }
      Absent => false
    }
  }
}

fn contiguous_loop_elementwise_kernel(
  op_codes: List<Int>,
  a: List<Int>,
  b: List<Int>,
  c: List<Int>
) -> List<Int> {
  [pure_dag_seam_unreachable()]
}

fn contiguous_loop_elementwise_float_kernel(
  op_codes: List<Int>,
  fma_contraction_policy: FmaContractionPolicy,
  a: List<Float>,
  b: List<Float>,
  c: List<Float>
) -> List<Float> {
  [pure_dag_seam_unreachable()]
}

data simd_kernel_int_execution_host_realization_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.languages.simd.kernel",
    decl_name: "contiguous_loop_elementwise_kernel",
    field: WholeDeclaration
  }
}

data simd_kernel_float_execution_host_realization_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.languages.simd.kernel",
    decl_name: "contiguous_loop_elementwise_float_kernel",
    field: WholeDeclaration
  }
}
