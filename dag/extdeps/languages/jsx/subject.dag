module extdeps.languages.jsx.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "github.com/facebook/jsx"
  }
}

data jsx_language_subject_note: String = "JSX, cited to the JSX Specification (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched repository hosts 'DRAFT: JSX Specification', maintained by Meta, defining JSX as 'an XML-like syntax extension to ECMAScript without any defined semantics'. THREE FACTS FROM THE UPSTREAM THAT THE REGISTRY NEEDS: it is explicitly a DRAFT; it is explicitly NOT intended to be implemented by engines or browsers and NOT a proposal to add JSX to ECMAScript; and it is independent of React. That last point is why this subject is jsx and not react — React is a separate library with separate governance, and the census surface named extdeps.languages.react_jsx fuses the two names in one module path. The syntax this repository emits is JSX; React would be a distinct subject if it is ever modelled."

type Jsx
  = | JsxTarget

data jsx_language: Jsx = JsxTarget

data jsx_language_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.languages.jsx.subject",
      decl_name: "jsx_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.languages.jsx.subject.extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = jsx_language_model_scope
