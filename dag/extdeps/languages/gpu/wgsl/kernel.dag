  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.languages.gpu.wgsl.kernel",
    decl_name: "wgsl_relu_mul_add_int_kernel_execute",
    field: WholeDeclaration
  }
}

data wgsl_kernel_float_execution_host_realization_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.languages.gpu.wgsl.kernel",
    decl_name: "wgsl_relu_mul_add_float_kernel_execute",
    field: WholeDeclaration
  }
}


data wgsl_relu_mul_add_int_kernel_source_grammar_scaffold_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.languages.gpu.wgsl.kernel",
