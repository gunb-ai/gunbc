data wgsl_relu_mul_add_float_kernel_source_grammar_scaffold_marker: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.languages.gpu.wgsl.kernel",
