module extdeps.languages.gpu.wgsl.kernel


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.w3.org/TR/WGSL/"
  }
}

data wgsl_kernel_target_medium_name: NonEmptyStr = "wgsl-compute-relu-mul-add"

data wgsl_relu_mul_add_int_kernel_source: String = "@group(0) @binding(0) var<storage, read> a: array<i32>;\n@group(0) @binding(1) var<storage, read> b: array<i32>;\n@group(0) @binding(2) var<storage, read> c: array<i32>;\n@group(0) @binding(3) var<storage, read_write> result: array<i32>;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let i = gid.x;\n  result[i] = max(a[i] * b[i] + c[i], 0);\n}\n"

data wgsl_relu_mul_add_float_kernel_source: String = "@group(0) @binding(0) var<storage, read> a: array<f32>;\n@group(0) @binding(1) var<storage, read> b: array<f32>;\n@group(0) @binding(2) var<storage, read> c: array<f32>;\n@group(0) @binding(3) var<storage, read_write> result: array<f32>;\n@compute @workgroup_size(64)\nfn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n  let i = gid.x;\n  result[i] = max(a[i] * b[i] + c[i], 0.0);\n}\n"

type WgslKernelEmitSurface {
  fused_op_count: Int
  workgroup_size: Int
}

fn wgsl_kernel_medium(surface: WgslKernelEmitSurface) -> Medium<WgslKernelEmitSurface> {
  Medium {
    carried: surface
    fidelity: Lossless
  }
}

fn wgsl_relu_mul_add_kernel_surface() -> WgslKernelEmitSurface {
  WgslKernelEmitSurface {
    fused_op_count: 3
    workgroup_size: 64
  }
}

fn witness_wgsl_relu_mul_add_kernel_surface_shape() -> Bool {
  let surface = wgsl_relu_mul_add_kernel_surface()
  surface.fused_op_count == 3 && surface.workgroup_size == 64
}

fn witness_wgsl_reuses_simd_op_code_authority() -> Bool {
  relu_mul_add_wire_op_codes.length() == 3
    && match relu_mul_add_wire_op_codes.first() {
      Present { value: c0 } => c0 == elemwise_mul_wire_op_code
      Absent => false
    }
}

fn witness_wgsl_int_kernel_source_shape() -> Bool {
  string_contains(s: wgsl_relu_mul_add_int_kernel_source, pattern: "array<i32>")
    && string_contains(s: wgsl_relu_mul_add_int_kernel_source, pattern: "max(a[i] * b[i] + c[i], 0)")
    && string_contains(s: wgsl_relu_mul_add_int_kernel_source, pattern: "@compute @workgroup_size(64)")
}

fn witness_wgsl_float_kernel_source_shape() -> Bool {
  string_contains(s: wgsl_relu_mul_add_float_kernel_source, pattern: "array<f32>")
    && string_contains(s: wgsl_relu_mul_add_float_kernel_source, pattern: "max(a[i] * b[i] + c[i], 0.0)")
}

fn wgsl_relu_mul_add_int_kernel_execute(
  op_codes: List<Int>,
  a: List<Int>,
  b: List<Int>,
  c: List<Int>
) -> List<Int> {
  [pure_dag_seam_unreachable()]
}

fn wgsl_relu_mul_add_float_kernel_execute(
  op_codes: List<Int>,
  a: List<Float>,
  b: List<Float>,
  c: List<Float>
) -> List<Float> {
  [pure_dag_seam_unreachable()]
}

