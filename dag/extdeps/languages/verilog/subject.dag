module extdeps.languages.verilog.subject

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "standards.ieee.org/ieee/1364/3641/"
  }
}

data verilog_language_further_authority_1: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "standards.ieee.org/ieee/1800/7743/"
  }
}

data verilog_language_subject_note: String = "VERILOG, cited to IEEE Std 1364-2005 (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched standard page gives 'IEEE Standard for Verilog Hardware Description Language', IEEE 1364-2005, published 2006. THE SUPERSESSION IS PART OF THE FACT AND IS WHY THERE ARE TWO CITATIONS: that same page records 1364-2005 as superseded by IEEE Std 1800-2009, the SystemVerilog unified language, and the further citation is IEEE 1800-2023, 'IEEE Standard for SystemVerilog--Unified Hardware Design, Specification, and Verification Language' (also fetched and confirmed). Both are carried because this repository's verilog surface models plain Verilog — a scan for SystemVerilog-only vocabulary (always_ff, always_comb, the 1800 designation) found none in it — while the living upstream standard is now 1800. A target modelling a superseded standard is a real support fact that belongs in the registry's evidence, not a detail to smooth over."

type Verilog
  = | VerilogTarget

data verilog_language: Verilog = VerilogTarget

data verilog_language_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.languages.verilog.subject",
      decl_name: "verilog_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [verilog_language_further_authority_1]
}

data verilog_language_mandated_scope_name_scaffold_note: String = "DECLARED SCAFFOLD, with its dissolution triggers — why the scope is authored under a unique name and the mandated name is bound to it. The authored value is the one above; 'extdeps_model_scope' is a BINDING to that same value, not a second authority, and it cannot drift from its source because it IS its source. It exists because two independent mechanisms collide. (1) gunbc.extdeps_scope_frontier's carrier_content_declares_scope text-scans every scope carrier for the literal 'data extdeps_model_scope:', so the name is mandatory. (2) The resolver offers no way to name two same-named imports apart: MEASURED 2026-08-04 against the real binary, a qualified reference (extdeps.languages.rust.subject.rust_language_model_scope) fails with 'undefined variable', module projection after an import fails the same way, no import aliasing exists in the grammar, and — the reason this is not merely inconvenient — importing one name from two modules does NOT refuse, it SILENTLY BINDS THE LAST ONE with exit 0. So a registry importing the mandated name from every carrier would ground 22 of 23 targets in the WRONG upstream scope and, because registration_subject derives the subject from the grounding, report the wrong subject for each — green and materially false. The unique name is what keeps that unwritable. DISSOLVE-ON, either trigger suffices: the resolver gains import aliasing or module projection (then the registry imports the mandated name directly and this binding deletes), OR the v2.lens.mandatory_tag region promotion retires the carrier_content_declares_scope text scan (then the mandated name is no longer required and the unique name stands alone). This is a scaffold pinned to a scaffold — carrier_content_declares_scope calls itself a declared scaffold in its own note — and they retire together. The resolver defect itself is corpus-wide and is being raised as its own lane; it is not a language-support fact."

data extdeps_model_scope: ExternalModelScope = verilog_language_model_scope
