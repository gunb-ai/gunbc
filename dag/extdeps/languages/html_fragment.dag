module extdeps.languages.html_fragment


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "html.spec.whatwg.org/"
  }
}

fn serialize_fragment(frag: Fragment) -> String {
  serialize_fragment_with(frag: frag, medium: html_markup_medium())
}
