module extdeps.languages.html_fragment


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "html.spec.whatwg.org/"
  }
}

fn serialize_fragment(frag: std.markup.Fragment) -> String {
  std.markup.serialize_fragment_with(frag: frag, medium: extdeps.languages.html.html_markup_medium())
}
