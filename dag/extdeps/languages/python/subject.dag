module extdeps.languages.python.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "docs.python.org/3/reference/index.html"
  }
}

data python_language_further_authority_1: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "peps.python.org/"
  }
}

data python_language_subject_note: String = "PYTHON, cited to The Python Language Reference (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched document is titled 'The Python Language Reference', is published by the Python Software Foundation, and states that it 'describes the syntax and core semantics of the language'. SUBJECT SCOPE: this is the LANGUAGE as specified by the PSF, not CPython the implementation, which is a separate upstream product and would take its own cited subject declaration if it were ever registered as a target in its own right. THE RUNTIME-CHECKER CENSUS ROW FOR THE INTERPRETER IS NEVERTHELESS JOINED TO THIS SUBJECT, and an earlier revision of this sentence said the opposite and named the wrong module besides (cursor review 48393). It argued the row was deliberately unidentified because an interpreter is a separate product. That argument is true and irrelevant: a census row's subject answers WHICH TARGET THIS SURFACE REALIZES, not whether the tool IS the language. The interpreter realizes Python. The authority for that policy is one place, gunbc.language_target_registry runtime_checker_subject_note, and this carrier should never have carried a second, contradicting copy of it. The row's module path is extdeps.python; the extdeps.python.interpreter this sentence used to name is not a module at all — it was the file path dag/extdeps/python/python.dag transcribed as a module path, one of three such phantoms corrected in the registry's census_path_resolution_note, so the stale sentence was handing a reader both the wrong join fact and a module that does not exist."

type Python
  = | PythonTarget

data python_language_subject: Python = PythonTarget

data python_language_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.languages.python.subject",
      decl_name: "python_language_subject",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.languages.python.subject.extdeps_external_authority_anchor,
  further_citations: [python_language_further_authority_1]
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = python_language_model_scope
