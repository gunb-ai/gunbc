module extdeps.languages.python.subject

import std.types { String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "docs.python.org/3/reference/index.html"
  }
}

data python_language_further_authority_1: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "peps.python.org/"
  }
}

data python_language_subject_note: String = "PYTHON, cited to The Python Language Reference (verified live 2026-08-04 by fetching the cited locator and confirming its title and publisher from the response, per the D0 verify-or-refuse rule): the fetched document is titled 'The Python Language Reference', is published by the Python Software Foundation, and states that it 'describes the syntax and core semantics of the language'. SUBJECT SCOPE: this is the LANGUAGE as specified by the PSF, not CPython the implementation. The census RuntimeChecker row extdeps.python.interpreter names an interpreter, which is a separate upstream product, and is deliberately not joined to this subject."

type Python
  = | PythonTarget

data python_language: Python = PythonTarget

data python_language_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.languages.python.subject",
      decl_name: "python_language",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [python_language_further_authority_1]
}

data python_language_mandated_scope_name_scaffold_note: String = "DECLARED SCAFFOLD — the shared explanation and both dissolution triggers live once at gunbc.language_subject_scope_scaffold mandated_scope_name_scaffold, and are deliberately not repeated inside an upstream subject carrier (cursor review 48122)."

data extdeps_model_scope: ExternalModelScope = python_language_model_scope
