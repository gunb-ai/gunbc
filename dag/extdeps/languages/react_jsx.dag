module extdeps.languages.react_jsx

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.markup {
  Fragment, MarkupMedium, EscapeHtml, SelfClose,
  serialize_fragment_with,
}
import extdeps.languages.html {
  html_markup_medium,
  html5_void_tags,
  canonical_html_spellings,
}
import extdeps.uri_validation {
  find_first_rejected_url,
}
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "react.dev/learn/writing-markup-with-jsx"
  }
}

data react_jsx_keep_mark_note: String = "KEEP with mark (#7272 A3 re-ruling; gpu/wgsl treatment). Not dead vocabulary: enrolled CI keystone corpus_ci_gate_row_react_jsx_emit_keystone (claim_witness_corpus_ci_runner), hostile-href XSS control witness_hostile_href_rejected, and second executing consumer void_element_test (serialize_jsx_component). No production consumer today. First-consumer candidates: gunb.ai site-subsumption (gunbc.site.markup) or belt-B dashboard (gunbc.roadmap_serve) if either adopts JSX emission. Failing that, the next census sweep re-raises deletion with the full removal set: this module, dag/test/claim/react_jsx_emit_test.dag, corpus_ci_gate_row_react_jsx_emit_keystone enrollment (+ roster row at :580), and the void_element_test import of serialize_jsx_component."

data react_jsx_awaiting_production_consumer: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "gunbc.site.markup",
    decl_name: "el",
    field: WholeDeclaration
  }
}

fn jsx_component_prefix(fn_name: String) -> String {
  join(["export function ", fn_name, "(): JSX.Element { return "], "")
}

fn jsx_markup_medium() -> MarkupMedium {
  MarkupMedium {
    tag_overrides: [],
    bracket: canonical_html_spellings,
    text_escape: EscapeHtml,
    void_tags: html5_void_tags,
    void_rendering: SelfClose,
    raw_text_tags: [],
  }
}

fn serialize_jsx_fragment(node: Fragment) -> String {
  serialize_fragment_with(frag: node, medium: jsx_markup_medium())
}

fn serialize_jsx_component(fn_name: String, node: Fragment) -> String {
  join([jsx_component_prefix(fn_name: fn_name), serialize_jsx_fragment(node: node), "; }"], "")
}

type JsxEmitResult
  = JsxOk { tsx: String }
  | JsxRejected { reason: String }

fn try_serialize_jsx_component(fn_name: String, node: Fragment) -> JsxEmitResult {
  match find_first_rejected_url(node: node) {
    Present { value: r } => JsxRejected { reason: r.url }
    Absent => JsxOk { tsx: serialize_jsx_component(fn_name: fn_name, node: node) }
  }
}
