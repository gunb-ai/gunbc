module extdeps.languages.react_jsx

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { NonEmptyStr }
import std.markup {
  Fragment, MarkupMedium, CommentGrammar, DocumentGrammar, NoDocumentGrammar, EscapeHtml, SelfClose,
  serialize_fragment_with,
  HazardFree, HazardFound,
  fragment_hazard,
}
import extdeps.languages.html {
  html_markup_medium,
  html5_void_tags,
  canonical_html_spellings,
}
import extdeps.uri_validation {
  find_first_rejected_url,
}
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "react.dev/learn/writing-markup-with-jsx"
  }
}

// KEEP with mark (#7272 A3; gpu/wgsl treatment). Live CI keystone
// corpus_ci_gate_row_react_jsx_emit_keystone + hostile-href XSS control + void_element_test
// consumer — not dead vocabulary. No production consumer today. Sole owner: gunb.ai
// site-subsumption. Dissolution is react_jsx_site_subsumption_jsx_page_emission below — not an
// already-landed HTML helper, not belt-B, not an unnamed census. If that lane closes without
// adopting JSX, delete the removal set: this module, dag/test/claim/react_jsx_emit.dag,
// corpus_ci_gate_row_react_jsx_emit_keystone enrollment (+ roster row at :580), and the
// void_element_test import of serialize_jsx_component.

data react_jsx_site_subsumption_jsx_page_emission: String = "dissolve-on: gunb.ai site-subsumption emits ≥1 production page through serialize_jsx_component (a non-test import under gunbc.site.*). That call is the dissolution event for react_jsx_awaiting_production_consumer."

data react_jsx_awaiting_production_consumer: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "extdeps.languages.react_jsx",
    decl_name: "react_jsx_site_subsumption_jsx_page_emission",
    field: WholeDeclaration
  }
}

fn jsx_component_prefix(fn_name: String) -> String {
  join(["export function ", fn_name, "(): JSX.Element { return "], "")
}

// JSX's own comment delimiters, in JSX's own module. Deliberately NOT the HTML rows: a comment
// written "<!-- -->" inside JSX is parsed as text, so the two languages genuinely differ here and
// each needs a home of its own.
data jsx_comment_open_sequence: NonEmptyStr = "{/* " as NonEmptyStr
data jsx_comment_close_sequence: NonEmptyStr = " */}" as NonEmptyStr
// The sequence that ENDS a JSX comment is "*/" — and it is not " */}" minus the brace. A comment
// closes at the first "*/", so "*/}" contains the terminator and the trailing brace becomes code.
// That distinction is why the medium carries the terminator separately from comment_close: the emitter
// writes " */}", the checker must look for "*/". Both rows sit here, in JSX's own module, because both
// are facts about JSX.
data jsx_comment_terminator: NonEmptyStr = "*/" as NonEmptyStr
// A body ending in "-" does NOT close a JSX comment: "- */}" is an ordinary comment in JSX, whose
// comment grammar has no abrupt-close state. Contrast the HTML medium, where the same shape reaches
// the tokenizer's comment end state. This is the per-language fact the medium field exists for.
data jsx_comment_trailing_dash_closes: Bool = false

fn jsx_markup_medium() -> MarkupMedium {
  MarkupMedium {
    tag_overrides: [],
    bracket: canonical_html_spellings,
    text_escape: EscapeHtml,
    void_tags: html5_void_tags,
    void_rendering: SelfClose,
    raw_text_tags: [],
    // Inside JSX the comment form is {/* … */}. An HTML comment there is parsed as TEXT, which is
    // exactly why the medium requires the field instead of defaulting it to the HTML spelling. Rows,
    // not literals: these are JSX's comment syntax, a fact about this language, named once and read.
    comment_grammar: CommentGrammar {
      open: jsx_comment_open_sequence,
      close: jsx_comment_close_sequence,
      terminator: jsx_comment_terminator,
      trailing_dash_closes: jsx_comment_trailing_dash_closes,
    },
    // NO doctype field exists to fill. The previous shape had `doctype_open: html_doctype_open_sequence`
    // beside `document_declaration_allowed: false`, i.e. the medium was forced to carry a spelling its own
    // comment called "not applicable" — a sum written as a flag (review 82209 on #14351). A JSX file is
    // an ECMAScript module and has no document type to declare, so this medium states that once, as the
    // value of document_grammar, rather than as a Bool beside a spelling it has to deny using.
    // The single comment_grammar above is what makes JSX covered without a JSX-specific hazard function
    // of its own — the gap review 82181 found (a comment holding "*/" closed early and the rest was
    // parsed as TSX; a Document emitted "<!DOCTYPE html>" inside a JSX expression; both came back JsxOk).
    document_grammar: NoDocumentGrammar,
  }
}

fn serialize_jsx_fragment(node: Fragment) -> String {
  serialize_fragment_with(frag: node, medium: jsx_markup_medium())
}

fn serialize_jsx_component(fn_name: String, node: Fragment) -> String {
  join([jsx_component_prefix(fn_name: fn_name), serialize_jsx_fragment(node: node), "; }"], "")
}

type JsxEmitResult
  = JsxOk { tsx: String }
  | JsxRejected { reason: String }

// THE GUARDED JSX ROUTE, guarding the same three things the HTML one does. Before review 82181 it
// checked URLs and nothing else, because the comment and doctype checks had been written per language
// and only HTML got one; the walk they now share lives in std.markup and reads this medium's comment
// grammar, so JSX is covered by the same code path rather than by someone remembering to add it.
//
// What it refuses, and why each is not merely filtered:
//   - a comment body holding "*/" closes the comment and the remainder is parsed as TSX — a comment
//     that changes the meaning of the file it is in, which is not a comment;
//   - a Document emits "<!DOCTYPE html>" inside a JSX expression container, which is not valid TSX;
//     the name check and the walk run on the root, so the declaration itself is checked too;
//   - raw-text content carrying its own close sequence, for the same early-termination reason.
// An empty medium terminator is itself refused by the walk, so a medium cannot opt out by omission.
fn try_serialize_jsx_component(fn_name: String, node: Fragment) -> JsxEmitResult {
  match find_first_rejected_url(node: node) {
    Present { value: r } => JsxRejected { reason: r.url }
    Absent =>
      match fragment_hazard(node: node, medium: jsx_markup_medium()) {
        HazardFree => JsxOk { tsx: serialize_jsx_component(fn_name: fn_name, node: node) }
        HazardFound { reason: why } => JsxRejected { reason: why }
      }
  }
}
