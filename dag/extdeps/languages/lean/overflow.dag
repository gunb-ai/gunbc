module extdeps.languages.lean.overflow


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "lean-lang.org/doc/reference/latest/Basic-Types/Fixed-Precision-Integers/"
  }
}

data lean_fixed_width_overflow_provenance_note: String = "Upstream Lean 4 fixed-precision integer overflow (extdeps_external_authority_anchor, cited 2026-08-01): literals that overflow their type's precision are interpreted modulo the precision; signed types use twos-complement (lean-lang Fixed-Precision-Integers). Init.Data.UInt.Basic documents UInt8.add, UInt8.mul, UInt8.pow, and width conversions as wrapping around on overflow. Catalog fixed-width scalars ground on ReturnWrapping — not saturating, trap, or undefined."

data lean_upstream_fixed_width_overflow_returns_rule: std.integer.OverflowReturnValueRule = std.integer.ReturnWrapping
