module extdeps.object_storage.content_addressed


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Object_storage#Content-addressable_storage"
  }
}

type CasObjectId {
  hash: ContentHash
}

type CasAddressingConfig {
  container: ObjectContainer
  key_derivation: KeyDerivationClass
  write_mode: CacheWriteSemantics
}
