module extdeps.object_storage.content_addressed


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Object_storage#Content-addressable_storage"
  }
}

type CasObjectId {
  hash: std.content_hash.ContentHash
}

type CasAddressingConfig {
  container: extdeps.object_storage.ObjectContainer
  key_derivation: std.cache_interface.KeyDerivationClass
  write_mode: std.cache_interface.CacheWriteSemantics
}
