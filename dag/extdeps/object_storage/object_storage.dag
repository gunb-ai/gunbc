module extdeps.object_storage


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Object_storage"
  }
}

type StorageArchitecture
  = FileStorage
  | BlockStorage
  | ObjectStorage

type ObjectContainer {
  name: std.types.NonEmptyStr
}

type ObjectId {
  value: std.types.NonEmptyStr
}

type ObjectMetadataEntry {
  key: std.types.NonEmptyStr
  value: String
}

type ObjectAttributes {
  size: std.measure.ByteSize
  metadata: List<ObjectMetadataEntry>
}

type ObjectOperation
  = GetObject
  | PutObject
  | DeleteObject
  | HeadObject
  | ListObjects
  | CopyObject

type ObjectGetResult
  = ObjectGetFound { id: ObjectId, attributes: ObjectAttributes }
  | ObjectGetNotFound
