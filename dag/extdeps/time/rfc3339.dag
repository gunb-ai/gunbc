module extdeps.time.rfc3339

import std.types { Bool, String, NonEmptyStr, Int, brand }
import std.optional { Present, Absent }
import std.decimal { decimal_digit_char }
import std.checked_arithmetic { CheckedInt, CheckedIntReady, checked_add_results, checked_int_multiply }
import extdeps.units.iso8601_calendar {
  Iso8601CivilDate, iso8601_gregorian_days_in_month, iso8601_seconds_since_midnight, iso8601_unix_seconds_at,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc3339"
  }
}

// Reading: RFC 3339 owns the date-time grammar including the 'Z' UTC designator; data rfc3339_utc_designator is that designator's rule, so the datum is the surface this citation owns.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.time.rfc3339", decl_name: "rfc3339_utc_designator", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// RFC 3339 is the interchange form for a timestamp — 2026-07-30T03:10:31Z — and it is an IETF concept rather than any vendor's. std.types.Timestamp is a bare String alias, which is enough to move a value around and not enough to say what is in it: a Timestamp holding an epoch integer, a locale-formatted date and an RFC 3339 instant are all equally valid Strings.\n\nSTRING ORDERING IS NOT SAFE AT THE SAME OFFSET, and an earlier revision of this row said it was. Two conditions are needed, not one. The offset condition is real — the format permits a numeric offset in place of Z, and 03:10:31+01:00 sorts before 03:10:31Z while being an hour later — but SUB-SECOND PRECISION breaks ordering on its own, at a single offset, with no timezone involved. The fractional part is introduced by a dot, and dot sorts below every digit and below Z: so 03:10:31.1Z compares LESS THAN 03:10:31Z while being a tenth of a second later. Any producer that omits a fractional component when it happens to be zero — which is common, and which RFC 3339 permits — emits a stream that lexical comparison orders wrongly at exactly those instants.\n\nThat contradiction was visible inside this row's own evidence. It asserted same-offset lexical ordering and then recorded that the codex auth file carries THREE different timestamp lengths — 25, 30 and 32 characters — across fields written by one tool at one offset. Those are precisely the mixed-precision values the ordering claim cannot survive, so the row refuted itself two paragraphs apart.\n\nWhat actually holds: lexical comparison is sound only when the offset AND the number of fractional digits are identical across the values compared, which is a property of a single producer's output format rather than of RFC 3339. Anything ordering instants across producers needs a real parse. Equality is worse and was already stated: it can never be string equality across producers, because the same instant has several conforming spellings.\n\nDeliberately NOT modeled: parsing, arithmetic, conversion to epoch seconds. This exists so a field can declare WHAT IT HOLDS instead of that it is textual; the operations land with the consumer that needs them.
type Rfc3339Timestamp = NonEmptyStr where brand("Rfc3339Timestamp")

data rfc3339_utc_designator: String = "Z"

// RFC 3339 PERMITS LOWERCASE, AND LOWERCASE REVERSES LEXICAL ORDER. The grammar's own note says the
// "T" and "Z" characters may alternatively be lower case "t" or "z". So 2026-09-04t16:04:06Z and
// 2026-09-04T16:04:06Z are the SAME INSTANT spelled two admissible ways - and 't' is code point
// 0x74 against 'T' at 0x54, so lexical comparison puts the lowercase one AFTER every uppercase one
// regardless of its date.
//
// That is not a rounding error, it is a reversal: an older lowercase stamp sorts as newer. A
// consumer using this to decide whether a snapshot pre-dates an observation would flip a coverage
// obligation into a finding about somebody else's repository - precisely the confusion the
// three-valued standing in gunbc.runner.runner_label_resolution exists to prevent.
//
// SECTION 5.1's PRECONDITION IS "expressed using the same string", AND CASE IS PART OF THE STRING.
// The comparator requires the canonical uppercase spelling of BOTH designators and refuses anything
// else - including a pair that is internally consistent but lowercase, because admitting that would
// mean admitting the mixed pair.
data rfc3339_date_time_separator: String = "T"

// THE COMPARATOR THE ROW ABOVE ALREADY DESCRIBES, WITH ITS PRECONDITIONS CHECKED RATHER THAN
// ASSUMED. RFC 3339 section 5.1 states the property and its conditions in one sentence:
// "Assuming that the time zones of the dates and times are the same (e.g., all in UTC),
// expressed using the same string (e.g., all "Z" or all "+00:00"), and all times have the same
// number of fractional second digits, then the date and time strings may be sorted as strings
// (e.g., using the strcmp() function in C) and a time-ordered sequence will result."
//
// So lexical comparison is not a trick and it is not general: it is a CONDITIONAL property, and
// the conditions are the whole content. This function answers the ordering question only where
// they hold and refuses where they do not, which is the difference between using the RFC's
// property and using the coincidence that strings compare.
//
// The two conditions are checked as: both values carry the "Z" designator, and both are the same
// length. Equal length is a sufficient stand-in for "the same number of fractional second
// digits" among Z-designated values, because the fixed part of the format is fixed-width and the
// fractional part is the only thing that can vary it. It is deliberately sufficient rather than
// exact: a stricter reading refuses more, and every refusal here is a caller who must supply a
// real parse rather than a caller who gets a wrong answer.
//
// THE ORDER IS NOT A Bool, because "not before" fuses two facts a caller acts on differently:
// the instants are ordered the other way, and the comparison could not be made at all.
type Rfc3339Comparison
  = Rfc3339Precedes
  | Rfc3339Follows
  | Rfc3339Simultaneous
  | Rfc3339OrderUndecidable { cause: NonEmptyStr }

fn rfc3339_is_canonically_spelled(value: Rfc3339Timestamp) -> Bool {
  let len = string_length(s: value)
  len > 11
    && substring(s: value, start: len - 1, end: len) == rfc3339_utc_designator
    && substring(s: value, start: 10, end: 11) == rfc3339_date_time_separator
}

fn rfc3339_lexically_comparable(left: Rfc3339Timestamp, right: Rfc3339Timestamp) -> Bool {
  rfc3339_is_canonically_spelled(value: left)
    && rfc3339_is_canonically_spelled(value: right)
    && string_length(s: left) == string_length(s: right)
}

fn rfc3339_compare(left: Rfc3339Timestamp, right: Rfc3339Timestamp) -> Rfc3339Comparison {
  if rfc3339_lexically_comparable(left: left, right: right) == false {
    Rfc3339OrderUndecidable {
      cause: join(["RFC 3339 section 5.1 admits string sorting only at one time-zone spelling and one fractional precision, and CASE IS PART OF THAT SPELLING - the grammar permits lowercase t and z, which sort AFTER every uppercase form and reverse chronology; '",
        left, "' and '", right,
        "' do not both carry the Z designator at the same total length, so ordering them lexically would be reading the format's coincidence rather than its stated property. A caller that must order these needs a real parse."], "")
    }
  } else {
    if left < right { Rfc3339Precedes }
    else if left == right { Rfc3339Simultaneous }
    else { Rfc3339Follows }
  }
}

// ── PARSING AN INSTANT (RFC 3339 section 5.6) ─────────────────────────────────────────────────
// THE REAL PARSE THE COMPARATOR ABOVE TELLS ITS CALLERS TO SUPPLY. A provider that issues a credential
// states its expiry in this format, and a consumer must order that expiry against its own clock, so
// lexical comparison is unavailable: Google's IAM Credentials generateAccessToken documents expireTime
// as a protobuf Timestamp, which "uses RFC 3339, where generated output will always be Z-normalized and
// use 0, 3, 6 or 9 fractional digits" and whose input "offsets other than Z are also accepted". So the
// spelling varies with the value, and only the instant is stable.
//
// THE INSTANT AND THE SPELLING ARE RETURNED SEPARATELY, because some consumers need the second. A
// protocol may prescribe one spelling (gunbc.auth.approval_capability signs the original text and
// accepts only whole-second uppercase-Z instants); that is a fact of that protocol, not of RFC 3339,
// so it is read off Rfc3339Spelling by its owner rather than built into this parse.
//
// THE CALENDAR IS NOT RE-DERIVED HERE: extdeps.units.iso8601_calendar owns the proleptic Gregorian day
// count and the month-length rule, and this parse consumes both.
//
// THE DOMAIN IS (unix seconds, nanoseconds within the second), NOT EPOCH NANOSECONDS. A four-digit year
// spans 0000..9999, and nanoseconds since 1970 overflow a 64-bit integer after 2262; seconds do not, so
// every instant this grammar can spell is representable and no caller loses range. Spans between two
// instants are computed with checked arithmetic and refuse rather than wrap.
type Rfc3339Instant sole_constructor {
  unix_seconds: Int
  nanos: Int
}

type Rfc3339Offset
  = Rfc3339UtcDesignator { uppercase: Bool }
  | Rfc3339NumericOffset { minutes_east: Int }

type Rfc3339Spelling {
  fraction_digits: Int
  offset: Rfc3339Offset
  separator_uppercase: Bool
  width: Int
}

// One arm per distinct way the text fails, located by what was wrong, so a refusal never has to be
// re-read from a message. Leap seconds are refused rather than accepted: RFC 3339 admits :60 only in a
// positive leap second, and an instant that cannot be ordered against its neighbours has no place in a
// comparison contract; a fraction finer than a nanosecond is refused rather than truncated, because
// truncation would move a deadline earlier or later than the provider stated.
type Rfc3339ParseRefusal
  = Rfc3339TooShort { width: Int }
  | Rfc3339PunctuationRefused { position: Int }
  | Rfc3339DigitsRefused { field: NonEmptyStr }
  | Rfc3339FieldOutOfRange { field: NonEmptyStr, value: Int }
  | Rfc3339DayNotInMonth { year: Int, month: Int, day: Int }
  | Rfc3339LeapSecondUnorderable
  | Rfc3339FractionEmpty
  | Rfc3339FractionBeyondNanoseconds { digits: Int }
  | Rfc3339OffsetRefused { position: Int }
  | Rfc3339TrailingText { position: Int }

type Rfc3339InstantParse
  = Rfc3339InstantParsed { instant: Rfc3339Instant, spelling: Rfc3339Spelling }
  | Rfc3339InstantRefused { cause: Rfc3339ParseRefusal }

fn rfc3339_digit_value(c: String) -> Int {
  if c == "1" { 1 } else if c == "2" { 2 } else if c == "3" { 3 }
  else if c == "4" { 4 } else if c == "5" { 5 } else if c == "6" { 6 }
  else if c == "7" { 7 } else if c == "8" { 8 } else if c == "9" { 9 } else { 0 }
}

fn rfc3339_digits_in(t: String, start: Int, end: Int) -> Bool {
  if start >= end { true }
  else { decimal_digit_char(ch: char_at(s: t, pos: start)) && rfc3339_digits_in(t: t, start: start + 1, end: end) }
}

fn rfc3339_number_in(t: String, start: Int, end: Int, acc: Int) -> Int {
  if start >= end { acc }
  else { rfc3339_number_in(t: t, start: start + 1, end: end, acc: acc * 10 + rfc3339_digit_value(c: char_at(s: t, pos: start))) }
}

// The index one past the last consecutive digit from start.
fn rfc3339_digit_run_end(t: String, start: Int) -> Int {
  if start >= string_length(s: t) { start }
  else if decimal_digit_char(ch: char_at(s: t, pos: start)) { rfc3339_digit_run_end(t: t, start: start + 1) }
  else { start }
}

fn rfc3339_pow10(n: Int) -> Int {
  if n <= 0 { 1 } else { 10 * rfc3339_pow10(n: n - 1) }
}

// The fixed 19-character prefix date-fullyear "-" date-month "-" date-mday T time-hour ":" time-minute
// ":" time-second, with the separator in either case (section 5.6 NOTE).
data rfc3339_fixed_prefix_width: Int = 19

fn rfc3339_prefix_punctuation_refusal(t: String) -> Int? {
  if char_at(s: t, pos: 4) != "-" { Present { value: 4 } }
  else if char_at(s: t, pos: 7) != "-" { Present { value: 7 } }
  else if char_at(s: t, pos: 10) != "T" && char_at(s: t, pos: 10) != "t" { Present { value: 10 } }
  else if char_at(s: t, pos: 13) != ":" { Present { value: 13 } }
  else if char_at(s: t, pos: 16) != ":" { Present { value: 16 } }
  else { none }
}

fn rfc3339_prefix_digits_refusal(t: String) -> NonEmptyStr? {
  if !rfc3339_digits_in(t: t, start: 0, end: 4) { Present { value: "date-fullyear" as NonEmptyStr } }
  else if !rfc3339_digits_in(t: t, start: 5, end: 7) { Present { value: "date-month" as NonEmptyStr } }
  else if !rfc3339_digits_in(t: t, start: 8, end: 10) { Present { value: "date-mday" as NonEmptyStr } }
  else if !rfc3339_digits_in(t: t, start: 11, end: 13) { Present { value: "time-hour" as NonEmptyStr } }
  else if !rfc3339_digits_in(t: t, start: 14, end: 16) { Present { value: "time-minute" as NonEmptyStr } }
  else if !rfc3339_digits_in(t: t, start: 17, end: 19) { Present { value: "time-second" as NonEmptyStr } }
  else { none }
}

fn rfc3339_parse_instant(text: String) -> Rfc3339InstantParse {
  let width = string_length(s: text)
  if width < rfc3339_fixed_prefix_width + 1 {
    Rfc3339InstantRefused { cause: Rfc3339TooShort { width: width } }
  } else {
    match rfc3339_prefix_punctuation_refusal(t: text) {
      Present { value: p } => Rfc3339InstantRefused { cause: Rfc3339PunctuationRefused { position: p } }
      Absent =>
        match rfc3339_prefix_digits_refusal(t: text) {
          Present { value: f } => Rfc3339InstantRefused { cause: Rfc3339DigitsRefused { field: f } }
          Absent => rfc3339_parse_fields(text: text, width: width)
        }
    }
  }
}

fn rfc3339_parse_fields(text: String, width: Int) -> Rfc3339InstantParse {
  let year = rfc3339_number_in(t: text, start: 0, end: 4, acc: 0)
  let month = rfc3339_number_in(t: text, start: 5, end: 7, acc: 0)
  let day = rfc3339_number_in(t: text, start: 8, end: 10, acc: 0)
  let hour = rfc3339_number_in(t: text, start: 11, end: 13, acc: 0)
  let minute = rfc3339_number_in(t: text, start: 14, end: 16, acc: 0)
  let second = rfc3339_number_in(t: text, start: 17, end: 19, acc: 0)
  if month < 1 || month > 12 {
    Rfc3339InstantRefused { cause: Rfc3339FieldOutOfRange { field: "date-month" as NonEmptyStr, value: month } }
  } else if day < 1 || day > iso8601_gregorian_days_in_month(y: year, m: month) {
    Rfc3339InstantRefused { cause: Rfc3339DayNotInMonth { year: year, month: month, day: day } }
  } else if hour > 23 {
    Rfc3339InstantRefused { cause: Rfc3339FieldOutOfRange { field: "time-hour" as NonEmptyStr, value: hour } }
  } else if minute > 59 {
    Rfc3339InstantRefused { cause: Rfc3339FieldOutOfRange { field: "time-minute" as NonEmptyStr, value: minute } }
  } else if second == 60 {
    Rfc3339InstantRefused { cause: Rfc3339LeapSecondUnorderable }
  } else if second > 59 {
    Rfc3339InstantRefused { cause: Rfc3339FieldOutOfRange { field: "time-second" as NonEmptyStr, value: second } }
  } else {
    let local_seconds = iso8601_unix_seconds_at(
      date: Iso8601CivilDate { year: year, month: month, day: day },
      since_midnight: iso8601_seconds_since_midnight(hour: hour, minute: minute, second: second),
    )
    let separator_uppercase = char_at(s: text, pos: 10) == "T"
    rfc3339_parse_fraction(text: text, width: width, local_seconds: local_seconds, separator_uppercase: separator_uppercase)
  }
}

data rfc3339_max_fraction_digits: Int = 9

fn rfc3339_parse_fraction(text: String, width: Int, local_seconds: Int, separator_uppercase: Bool) -> Rfc3339InstantParse {
  if char_at(s: text, pos: rfc3339_fixed_prefix_width) == "." {
    let start = rfc3339_fixed_prefix_width + 1
    let end = rfc3339_digit_run_end(t: text, start: start)
    let digits = end - start
    if digits == 0 {
      Rfc3339InstantRefused { cause: Rfc3339FractionEmpty }
    } else if digits > rfc3339_max_fraction_digits {
      Rfc3339InstantRefused { cause: Rfc3339FractionBeyondNanoseconds { digits: digits } }
    } else {
      let nanos = rfc3339_number_in(t: text, start: start, end: end, acc: 0) * rfc3339_pow10(n: rfc3339_max_fraction_digits - digits)
      rfc3339_parse_offset(text: text, width: width, at: end, local_seconds: local_seconds, nanos: nanos, fraction_digits: digits, separator_uppercase: separator_uppercase)
    }
  } else {
    rfc3339_parse_offset(text: text, width: width, at: rfc3339_fixed_prefix_width, local_seconds: local_seconds, nanos: 0, fraction_digits: 0, separator_uppercase: separator_uppercase)
  }
}

// time-offset = "Z" / time-numoffset ; time-numoffset = ("+" / "-") time-hour ":" time-minute. The
// local time minus the offset is UTC (section 4.2).
fn rfc3339_parse_offset(text: String, width: Int, at: Int, local_seconds: Int, nanos: Int, fraction_digits: Int, separator_uppercase: Bool) -> Rfc3339InstantParse {
  let c = if at < width { char_at(s: text, pos: at) } else { "" }
  if c == "Z" || c == "z" {
    if at + 1 != width {
      Rfc3339InstantRefused { cause: Rfc3339TrailingText { position: at + 1 } }
    } else {
      Rfc3339InstantParsed {
        instant: Rfc3339Instant { unix_seconds: local_seconds, nanos: nanos },
        spelling: Rfc3339Spelling { fraction_digits: fraction_digits, offset: Rfc3339UtcDesignator { uppercase: c == "Z" }, separator_uppercase: separator_uppercase, width: width },
      }
    }
  } else if c == "+" || c == "-" {
    if at + 6 > width || char_at(s: text, pos: at + 3) != ":" || !rfc3339_digits_in(t: text, start: at + 1, end: at + 3) || !rfc3339_digits_in(t: text, start: at + 4, end: at + 6) {
      Rfc3339InstantRefused { cause: Rfc3339OffsetRefused { position: at } }
    } else if at + 6 != width {
      Rfc3339InstantRefused { cause: Rfc3339TrailingText { position: at + 6 } }
    } else {
      let oh = rfc3339_number_in(t: text, start: at + 1, end: at + 3, acc: 0)
      let om = rfc3339_number_in(t: text, start: at + 4, end: at + 6, acc: 0)
      if oh > 23 || om > 59 {
        Rfc3339InstantRefused { cause: Rfc3339OffsetRefused { position: at } }
      } else {
        let magnitude = oh * 60 + om
        let minutes_east = if c == "+" { magnitude } else { 0 - magnitude }
        Rfc3339InstantParsed {
          instant: Rfc3339Instant { unix_seconds: local_seconds - minutes_east * 60, nanos: nanos },
          spelling: Rfc3339Spelling { fraction_digits: fraction_digits, offset: Rfc3339NumericOffset { minutes_east: minutes_east }, separator_uppercase: separator_uppercase, width: width },
        }
      }
    }
  } else {
    Rfc3339InstantRefused { cause: Rfc3339OffsetRefused { position: at } }
  }
}

fn rfc3339_instant_unix_seconds(i: Rfc3339Instant) -> Int { i.unix_seconds }
fn rfc3339_instant_nanos(i: Rfc3339Instant) -> Int { i.nanos }

// TOTAL, because both operands are parsed instants: there is no undecidable arm here, unlike the
// lexical comparator above.
fn rfc3339_instant_compare(left: Rfc3339Instant, right: Rfc3339Instant) -> Rfc3339Comparison {
  if left.unix_seconds < right.unix_seconds { Rfc3339Precedes }
  else if left.unix_seconds > right.unix_seconds { Rfc3339Follows }
  else if left.nanos < right.nanos { Rfc3339Precedes }
  else if left.nanos > right.nanos { Rfc3339Follows }
  else { Rfc3339Simultaneous }
}

// The signed span later - earlier in nanoseconds, CHECKED: a span wider than a 64-bit nanosecond count
// (about 292 years) refuses rather than wraps.
fn rfc3339_instant_nanoseconds_after(later: Rfc3339Instant, earlier: Rfc3339Instant) -> CheckedInt {
  checked_add_results(
    a: checked_int_multiply(a: later.unix_seconds - earlier.unix_seconds, b: 1000000000),
    b: CheckedIntReady { value: later.nanos - earlier.nanos },
  )
}

// An instant at unix seconds plus nanoseconds, for a reading this repository took itself (a wall clock
// read as epoch milliseconds). A nanos value outside one second is not an instant and refuses.
fn rfc3339_instant_of_unix(unix_seconds: Int, nanos: Int) -> Rfc3339Instant? {
  if nanos < 0 || nanos > 999999999 { none }
  else { Present { value: Rfc3339Instant { unix_seconds: unix_seconds, nanos: nanos } } }
}
