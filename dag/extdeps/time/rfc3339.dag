module extdeps.time.rfc3339

import std.types { Bool, String, NonEmptyStr }
import std.algebra { Less, Equal, Greater }
import std.string_type { string_lex_compare }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc3339"
  }
}

// RFC 3339 is the interchange form for a timestamp — 2026-07-30T03:10:31Z — and it is an IETF concept rather than any vendor's. std.types.Timestamp is a bare String alias, which is enough to move a value around and not enough to say what is in it: a Timestamp holding an epoch integer, a locale-formatted date and an RFC 3339 instant are all equally valid Strings.\n\nSTRING ORDERING IS NOT SAFE AT THE SAME OFFSET, and an earlier revision of this row said it was. Two conditions are needed, not one. The offset condition is real — the format permits a numeric offset in place of Z, and 03:10:31+01:00 sorts before 03:10:31Z while being an hour later — but SUB-SECOND PRECISION breaks ordering on its own, at a single offset, with no timezone involved. The fractional part is introduced by a dot, and dot sorts below every digit and below Z: so 03:10:31.1Z compares LESS THAN 03:10:31Z while being a tenth of a second later. Any producer that omits a fractional component when it happens to be zero — which is common, and which RFC 3339 permits — emits a stream that lexical comparison orders wrongly at exactly those instants.\n\nThat contradiction was visible inside this row's own evidence. It asserted same-offset lexical ordering and then recorded that the codex auth file carries THREE different timestamp lengths — 25, 30 and 32 characters — across fields written by one tool at one offset. Those are precisely the mixed-precision values the ordering claim cannot survive, so the row refuted itself two paragraphs apart.\n\nWhat actually holds: lexical comparison is sound only when the offset AND the number of fractional digits are identical across the values compared, which is a property of a single producer's output format rather than of RFC 3339. Anything ordering instants across producers needs a real parse. Equality is worse and was already stated: it can never be string equality across producers, because the same instant has several conforming spellings.\n\nDeliberately NOT modeled: parsing, arithmetic, conversion to epoch seconds. This exists so a field can declare WHAT IT HOLDS instead of that it is textual; the operations land with the consumer that needs them.
type Rfc3339Timestamp = NonEmptyStr where brand("Rfc3339Timestamp")

data rfc3339_utc_designator: String = "Z"

// RFC 3339 PERMITS LOWERCASE, AND LOWERCASE REVERSES LEXICAL ORDER. The grammar's own note says the
// "T" and "Z" characters may alternatively be lower case "t" or "z". So 2026-09-04t16:04:06Z and
// 2026-09-04T16:04:06Z are the SAME INSTANT spelled two admissible ways - and 't' is code point
// 0x74 against 'T' at 0x54, so lexical comparison puts the lowercase one AFTER every uppercase one
// regardless of its date.
//
// That is not a rounding error, it is a reversal: an older lowercase stamp sorts as newer. A
// consumer using this to decide whether a snapshot pre-dates an observation would flip a coverage
// obligation into a finding about somebody else's repository - precisely the confusion the
// three-valued standing in gunbc.runner_label_resolution exists to prevent.
//
// SECTION 5.1's PRECONDITION IS "expressed using the same string", AND CASE IS PART OF THE STRING.
// The comparator requires the canonical uppercase spelling of BOTH designators and refuses anything
// else - including a pair that is internally consistent but lowercase, because admitting that would
// mean admitting the mixed pair.
data rfc3339_date_time_separator: String = "T"

// THE COMPARATOR THE ROW ABOVE ALREADY DESCRIBES, WITH ITS PRECONDITIONS CHECKED RATHER THAN
// ASSUMED. RFC 3339 section 5.1 states the property and its conditions in one sentence:
// "Assuming that the time zones of the dates and times are the same (e.g., all in UTC),
// expressed using the same string (e.g., all "Z" or all "+00:00"), and all times have the same
// number of fractional second digits, then the date and time strings may be sorted as strings
// (e.g., using the strcmp() function in C) and a time-ordered sequence will result."
//
// So lexical comparison is not a trick and it is not general: it is a CONDITIONAL property, and
// the conditions are the whole content. This function answers the ordering question only where
// they hold and refuses where they do not, which is the difference between using the RFC's
// property and using the coincidence that strings compare.
//
// The two conditions are checked as: both values carry the "Z" designator, and both are the same
// length. Equal length is a sufficient stand-in for "the same number of fractional second
// digits" among Z-designated values, because the fixed part of the format is fixed-width and the
// fractional part is the only thing that can vary it. It is deliberately sufficient rather than
// exact: a stricter reading refuses more, and every refusal here is a caller who must supply a
// real parse rather than a caller who gets a wrong answer.
//
// THE ORDER IS NOT A Bool, because "not before" fuses two facts a caller acts on differently:
// the instants are ordered the other way, and the comparison could not be made at all.
type Rfc3339Comparison
  = Rfc3339Precedes
  | Rfc3339Follows
  | Rfc3339Simultaneous
  | Rfc3339OrderUndecidable { cause: NonEmptyStr }

fn rfc3339_is_canonically_spelled(value: Rfc3339Timestamp) -> Bool {
  let len = string_length(s: value)
  len > 11
    && substring(s: value, start: len - 1, end: len) == rfc3339_utc_designator
    && substring(s: value, start: 10, end: 11) == rfc3339_date_time_separator
}

fn rfc3339_lexically_comparable(left: Rfc3339Timestamp, right: Rfc3339Timestamp) -> Bool {
  rfc3339_is_canonically_spelled(value: left)
    && rfc3339_is_canonically_spelled(value: right)
    && string_length(s: left) == string_length(s: right)
}

fn rfc3339_compare(left: Rfc3339Timestamp, right: Rfc3339Timestamp) -> Rfc3339Comparison {
  if rfc3339_lexically_comparable(left: left, right: right) == false {
    Rfc3339OrderUndecidable {
      cause: join(["RFC 3339 section 5.1 admits string sorting only at one time-zone spelling and one fractional precision, and CASE IS PART OF THAT SPELLING - the grammar permits lowercase t and z, which sort AFTER every uppercase form and reverse chronology; '",
        left, "' and '", right,
        "' do not both carry the Z designator at the same total length, so ordering them lexically would be reading the format's coincidence rather than its stated property. A caller that must order these needs a real parse."], "")
    }
  } else {
    match string_lex_compare(left: left, right: right) {
      Less => Rfc3339Precedes
      Greater => Rfc3339Follows
      Equal => Rfc3339Simultaneous
    }
  }
}
