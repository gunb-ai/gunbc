module extdeps.http.client

import std.types { NonEmptyStr, Bool, Int, List, Unit }
import std.string_type { String }
import std.measure { Second, second_count }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.tools.curl {
  curl_localhost_connect_timeout,
  curl_localhost_max_time,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc9110"
  }
}

data http_client_handler_layering_note: String = "§3 shape/transport split: this module is the agnostic HTTP *client* interface (the client half of extdeps.http; extdeps.http.server is the serving half). The shell/curl argv rows below are ONE bound transport handler of the shape (the tool authority is extdeps.tools.curl); the declarative `transport rest` machinery (config modeled in extdeps.transports.rest) is the peer handler - N handlers, one shape, dispatch peripheral. REST itself is a behavioral refinement of HTTP (method semantics honored: GET safe/readonly, PUT idempotent; stateless requests over URI-named resources), not a different client - `transport rest` today carries nothing REST-specific and is honestly the native HTTP-client transport. GetFollowRedirectsBoundedWithHeaderFile is the registry GET: Accept is an argv header, Authorization is curl -H @file so the bearer is not an argv word (gunbc.credential_argv_exposure), -L follows a blob redirect, deadline is the caller."

fn http_client_localhost_connect_timeout_flag() -> String {
  to_string(second_count(s: curl_localhost_connect_timeout))
}

fn http_client_localhost_max_time_flag() -> String {
  to_string(second_count(s: curl_localhost_max_time))
}

fn http_client_max_time_flag(max_time: Second) -> NonEmptyStr {
  to_string(second_count(s: max_time)) as NonEmptyStr
}

fn http_client_get_argv(url: NonEmptyStr) -> List<String> {
  [
    "curl",
    "-fsS",
    "--connect-timeout",
    http_client_localhost_connect_timeout_flag(),
    "--max-time",
    http_client_localhost_max_time_flag(),
    url as String,
  ]
}

// THE DEADLINE IS AN INPUT, NOT A LITERAL IN THIS ARGV, and the distinction is the one DESIGN
// section 3 draws between an interface fact and a policy fact. How long a caller is willing to wait
// for ITS backend is the caller's business; curl's ability to bound a request is ours. A number
// written here would be this module answering a question it cannot know, and every caller with a
// different backend would then need a second operation.
//
// WITHOUT IT THE WAIT WAS UNBOUNDED, which is not a slow path but a missing refusal: DESIGN section
// 5 rules that a bounded "forever" is not an "unknown" error. Measured on this deployment, a wedged
// backend held one harness POST open for over thirty minutes while the router answered an unrelated
// probe in 0.15ms -- so the turn was neither progressing nor failing, and no arm existed to say so.
// StatusWithin -- A STATUS IS AN ANSWER; ONLY NO STATUS IS SILENCE. Every GET carries -f, which
// turns a 4xx or 5xx into a failed operation -- right for a caller that wants a body, wrong for a
// caller asking whether anything is THERE: a front door returning 401 or 500 answered. That
// operation asks only for the status line, within the caller's deadline, and fails only when no
// HTTP response was received at all -- and WHY is carried as curl's exit code, because "no
// response" is not one fact: a failed connect (curl 7) and a deadline (curl 28) are different
// readings for a caller asking whether anything is THERE, and neither proves absence on its own.
// The consumer maps the code; the transport reports it. curl_exit_connect_failed /
// curl_exit_deadline below are the cited codes.
// curl's exit codes for the two arms a presence reading must tell apart (curl(1) EXIT CODES):
// 7 "Failed to connect to host or proxy" -- connect() did not complete, for ANY reason (refused,
// unreachable, proxy), which is why the row is not named "refused"; 28 "Operation timeout" -- the
// deadline passed. Every other nonzero code is a transport the caller could not read.
data curl_exit_connect_failed: Int = 7
data curl_exit_deadline: Int = 28

service http.Client {
  operation Get {
    input { url: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-fsS", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client GET failed"
    }
  }

  operation GetLocalhostBounded {
    input { url: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: [
        "curl",
        "-fsS",
        "--connect-timeout",
        http_client_localhost_connect_timeout_flag(),
        "--max-time",
        http_client_localhost_max_time_flag(),
        "{url}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "http client bounded localhost GET failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live HTTP endpoint; readiness probe refuses rather than fabricate a body"
    }
  }

  operation GetBounded {
    input { url: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: [
        "curl",
        "-fsS",
        "--connect-timeout",
        http_client_localhost_connect_timeout_flag(),
        "--max-time",
        http_client_localhost_max_time_flag(),
        "{url}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "http client bounded GET failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live HTTP endpoint; routed observation refuses rather than fabricate a body"
    }
  }

  operation GetWithin {
    input { url: NonEmptyStr, max_seconds: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-fsS", "--max-time", "{max_seconds}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client GET within a caller deadline failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live HTTP endpoint; a bounded observation refuses rather than fabricate a body"
    }
  }

  operation StatusWithin {
    input { url: NonEmptyStr, max_seconds: NonEmptyStr }
    output { status: String from "stdout", success: Bool from "exit_success", exit_code: Int from "exit_code" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-o", "/dev/null", "-w", "%\{http_code}", "--max-time", "{max_seconds}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client status GET within a caller deadline received no response"
    }
    mock_response {
      0 => { status: "", success: false, exit_code: 28 } "hermetic: no live HTTP endpoint; a bounded presence reading refuses rather than fabricate a status"
    }
  }

  operation PostJsonFromFile {
    input { url: NonEmptyStr, request_body_file: NonEmptyStr, max_seconds: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: [
        "curl",
        "--fail-with-body",
        "-sk",
        "--max-time", "{max_seconds}",
        "-X", "POST",
        "{url}",
        "-H", "Content-Type: application/json",
        "--data", "@{request_body_file}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "curl POST JSON from file failed"
    }
  }

  operation DownloadToFile {
    input { url: NonEmptyStr, destination: NonEmptyStr }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["curl", "-fL", "{url}", "-o", "{destination}"] }
    exit {
      0 => Unit
      nonzero => String "curl download failed"
    }
  }

  operation GetFollowRedirectsBoundedWithHeaderFile {
    input { url: NonEmptyStr, max_seconds: NonEmptyStr, accept: NonEmptyStr, header_file: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: [
        "curl",
        "-fsSL",
        "--max-time", "{max_seconds}",
        "-H", "{accept}",
        "-H", "@{header_file}",
        "{url}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "http client bounded GET with header file failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live registry; observation refuses rather than fabricate a body"
    }
  }
}
