module extdeps.http.client
import std.resources { Network }

import std.types { NonEmptyStr, Bool, List, Unit, Int }
import std.measure { Second, second_count }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.tools.curl {
  curl_localhost_connect_timeout,
  curl_localhost_max_time,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc9110"
  }
}

data http_client_handler_layering_note: String = "§3 shape/transport split: this module is the agnostic HTTP *client* interface (the client half of extdeps.http; extdeps.http.server is the serving half). The shell/curl argv rows below are ONE bound transport handler of the shape (the tool authority is extdeps.tools.curl); the declarative `transport rest` machinery (config modeled in extdeps.transports.rest) is the peer handler - N handlers, one shape, dispatch peripheral. REST itself is a behavioral refinement of HTTP (method semantics honored: GET safe/readonly, PUT idempotent; stateless requests over URI-named resources), not a different client - `transport rest` today carries nothing REST-specific and is honestly the native HTTP-client transport. GetFollowRedirectsBoundedWithHeaderFile is the registry GET: Accept is an argv header, Authorization is curl -H @file so the bearer is not an argv word (gunbc.credential_argv_exposure), -L follows a blob redirect, deadline is the caller."

fn http_client_localhost_connect_timeout_flag() -> String {
  to_string(second_count(s: curl_localhost_connect_timeout))
}

fn http_client_localhost_max_time_flag() -> String {
  to_string(second_count(s: curl_localhost_max_time))
}

fn http_client_max_time_flag(max_time: Second) -> NonEmptyStr {
  to_string(second_count(s: max_time)) as NonEmptyStr
}

// THE ONE GET ARGV BUILDER FOR CALLERS THAT RUN CURL OVER A REMOTE SHELL, taking the caller's
// deadline (the GetWithin operation is the local-transport twin): the deadline is the caller's
// policy, never this module's number. A builder that baked curl_localhost_max_time in was the
// second authority on the probe bound (review 67443).
fn http_client_get_argv(url: NonEmptyStr, max_time: Second) -> List<String> {
  [
    "curl",
    "-fsS",
    "--connect-timeout",
    http_client_localhost_connect_timeout_flag(),
    "--max-time",
    http_client_max_time_flag(max_time: max_time) as String,
    url as String,
  ]
}

// The same bounded GET over a unix socket (curl --unix-socket, curl(1)): the URL names the path the
// server routes on and the connection is made to the socket file. GetWithinUnixSocket is its
// local-transport twin.
fn http_client_get_unix_socket_argv(socket: NonEmptyStr, url: NonEmptyStr, max_time: Second) -> List<String> {
  [
    "curl",
    "-fsS",
    "--unix-socket",
    socket as String,
    "--connect-timeout",
    http_client_localhost_connect_timeout_flag(),
    "--max-time",
    http_client_max_time_flag(max_time: max_time) as String,
    url as String,
  ]
}

service http.Client {
  operation Get {
    requires Network
    input { url: NonEmptyStr }
    output { body: String, success: Bool }
    readonly
    transport rest {
      method: GET,
      path: "{url}"
    }
    response {
      2xx => String
      4xx => String
      5xx => String
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live HTTP endpoint; the GET refuses rather than fabricate a body"
    }
  }

  operation GetLocalhostBounded {
    requires Network
    input { url: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: [
        "curl",
        "-fsS",
        "--connect-timeout",
        http_client_localhost_connect_timeout_flag(),
        "--max-time",
        http_client_localhost_max_time_flag(),
        "{url}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "http client bounded localhost GET failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live HTTP endpoint; readiness probe refuses rather than fabricate a body"
    }
  }

  operation GetBounded {
    requires Network
    input { url: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: [
        "curl",
        "-fsS",
        "--connect-timeout",
        http_client_localhost_connect_timeout_flag(),
        "--max-time",
        http_client_localhost_max_time_flag(),
        "{url}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "http client bounded GET failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live HTTP endpoint; routed observation refuses rather than fabricate a body"
    }
  }

  operation GetWithin {
    requires Network
    input { url: NonEmptyStr, max_seconds: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-fsS", "--max-time", "{max_seconds}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client GET within a caller deadline failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live HTTP endpoint; a bounded observation refuses rather than fabricate a body"
    }
  }

  operation GetWithinUnixSocket {
    requires Network
    input { socket: NonEmptyStr, url: NonEmptyStr, max_seconds: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-fsS", "--unix-socket", "{socket}", "--max-time", "{max_seconds}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client GET over a unix socket within a caller deadline failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live socket; a bounded observation refuses rather than fabricate a body"
    }
  }

  operation StatusWithin {
    requires Network
    input { url: NonEmptyStr, max_seconds: NonEmptyStr }
    output { status: String from "stdout", success: Bool from "exit_success", exit_code: Int from "exit_code" }
    readonly
    transport shell {
      argv: ["curl", "-sS", "-o", "/dev/null", "-w", "%\{http_code}", "--max-time", "{max_seconds}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client status GET within a caller deadline received no response"
    }
    mock_response {
      0 => { status: "", success: false, exit_code: 28 } "hermetic: no live HTTP endpoint; a bounded presence reading refuses rather than fabricate a status"
    }
  }

  operation GetQueryStdinWithin {
    requires Network
    input { url: NonEmptyStr, query: String, connect_seconds: NonEmptyStr, max_seconds: NonEmptyStr }
    output {
      success: Bool
      body: String
    }
    readonly
    transport shell {
      argv: ["curl", "--disable", "-fsS", "--connect-timeout", "{connect_seconds}", "--max-time", "{max_seconds}", "--get", "--data-binary", "@-", "{url}"]
    }
    stdin: query
    exit {
      0 => Unit
      nonzero => String "http client GET with query within deadlines failed"
    }
    mock_response {
      0 => { success: false, body: "" } "hermetic: no live HTTP endpoint"
    }
  }

  operation PostStdinWithin {
    requires Network
    input { url: NonEmptyStr, request_body: String, connect_seconds: NonEmptyStr, max_seconds: NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      body: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["curl", "--disable", "-sS", "--connect-timeout", "{connect_seconds}", "--max-time", "{max_seconds}", "-X", "POST", "--data-binary", "@-", "-w", "\n%{http_code}", "{url}"]
    }
    stdin: request_body
    exit {
      0 => Unit
      nonzero => Unit
    }
    mock_response {
      0 => { exit_code: 7, success: false, body: "", stderr: "hermetic: no live HTTP endpoint" } "hermetic: a transport that never connects, so a caller answers unreachable rather than fabricating a reply"
    }
  }

  operation PostStdinWithinUnixSocket {
    requires Network
    input { socket: NonEmptyStr, url: NonEmptyStr, request_body: String, connect_seconds: NonEmptyStr, max_seconds: NonEmptyStr }
    output {
      exit_code: Int from "exit_code"
      success: Bool from "exit_success"
      body: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: ["curl", "--disable", "-sS", "--unix-socket", "{socket}", "--connect-timeout", "{connect_seconds}", "--max-time", "{max_seconds}", "--data-binary", "@-", "-w", "\n%{http_code}", "{url}"]
    }
    stdin: request_body
    exit {
      0 => Unit
      nonzero => Unit
    }
    mock_response {
      0 => { exit_code: 7, success: false, body: "", stderr: "hermetic: no live socket" } "hermetic: a transport that never connects, so a caller answers unreachable rather than fabricating a reply"
    }
  }

  operation PostJsonFromFile {
    requires Network
    input { url: NonEmptyStr, request_body_file: NonEmptyStr, max_seconds: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    readonly
    transport shell {
      argv: ["curl", "-fsS", "--max-time", "{max_seconds}", "-X", "POST", "-H", "Content-Type: application/json", "--data", "@{request_body_file}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client POST JSON from file failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live HTTP endpoint; the POST from file refuses rather than fabricate a body"
    }
  }

  operation PostFormFromFile {
    input { url: NonEmptyStr, request_body_file: NonEmptyStr, max_seconds: NonEmptyStr }
    output { body: String from "stdout", success: Bool from "exit_success" }
    transport shell {
      argv: ["curl", "-fsS", "--max-time", "{max_seconds}", "-X", "POST", "-H", "Content-Type: application/x-www-form-urlencoded", "--data", "@{request_body_file}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client POST form from file failed"
    }
    mock_response {
      0 => { body: "", success: false } "hermetic: no live token endpoint; the code exchange refuses rather than fabricate a response"
    }
  }

  operation DownloadToFile {
    requires Network
    input { url: NonEmptyStr, destination: NonEmptyStr }
    output { success: Bool }
    transport shell {
      argv: ["curl", "-fsS", "-o", "{destination}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client download failed"
    }
  }

  operation GetFollowRedirectsBoundedWithHeaderFile {
    requires Network
    input { url: NonEmptyStr, max_seconds: NonEmptyStr, accept: NonEmptyStr, header_file: NonEmptyStr }
    output { body: String }
    readonly
    transport shell {
      argv: ["curl", "-fL", "--max-time", "{max_seconds}", "-H", "Accept: {accept}", "-H", "@{header_file}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => String "http client GET with redirects and header file failed"
    }
    mock_response {
      0 => { body: "" } "hermetic: no live registry; observation refuses rather than fabricate a body"
    }
  }

  operation Probe {
    requires Network
    input { url: NonEmptyStr, connect_time: Second, max_time: Second }
    output {
      status: String from "stdout",
      answered: Bool from "exit_success",
      exit_code: Int from "exit_code"
    }
    readonly
    transport shell {
      argv: ["curl", "-sS", "--connect-timeout", http_client_max_time_flag(max_time: connect_time), "--max-time", http_client_max_time_flag(max_time: max_time), "-o", "/dev/null", "-w", "%\{http_code}", "{url}"]
    }
    exit {
      0 => Unit
      nonzero => Unit
    }
    mock_response {
      0 => { status: "000", answered: false, exit_code: 7 } "hermetic: no live endpoint; a probe replay records that nothing answered"
    }
  }
}