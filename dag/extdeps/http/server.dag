module extdeps.http.server

import std.http_path { PathTemplate }
import std.types { HttpMethod, HttpStatus, Port }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc9110"
  }
}

type HttpContentType
  = TextHtmlUtf8
  | TextPlainUtf8
  | ApplicationJsonUtf8
  | ApplicationOctetStream

fn http_content_type_wire_label(content_type: HttpContentType) -> String {
  match content_type {
    TextHtmlUtf8 => "text/html; charset=utf-8"
    TextPlainUtf8 => "text/plain; charset=utf-8"
    ApplicationJsonUtf8 => "application/json; charset=utf-8"
    ApplicationOctetStream => "application/octet-stream"
  }
}

type HttpRequestBodyKind
  = NoRequestBody
  | JsonRequestBody
  | TextRequestBody
  | BinaryRequestBody
  | FormRequestBody

type HttpInputLocation
  = PathInput
  | QueryInput
  | HeaderInput
  | BodyInput

type HttpServerParameter {
  name: String
  location: HttpInputLocation
  required: Bool
}

type HttpStatusResponse {
  status: HttpStatus
  body_kind: HttpRequestBodyKind
}

type HttpServerRoute {
  operation_name: String
  method: HttpMethod
  path_template: PathTemplate
  request_body: HttpRequestBodyKind
  parameters: List<HttpServerParameter>
  responses: List<HttpStatusResponse>
}

type HttpServerEmissionTarget {
  service_name: String
  routes: List<HttpServerRoute>
}

type NodeHttpRequestListener {
  handler_name: String
}

type HttpServerListenConfig {
  host: String
  port: Port
}

type NodeHttpServerRouteBinding {
  route: HttpServerRoute
  listener: NodeHttpRequestListener
}

type NodeHttpCreateServerServe {
  route_bindings: List<NodeHttpServerRouteBinding>
}

type NodeHttpCreateServerEffectChain {
  serve: NodeHttpCreateServerServe
  listen: HttpServerListenConfig
}

type NodeHttpCreateServerEmissionTarget {
  service_name: String
  effects: NodeHttpCreateServerEffectChain
}

type ServedDynamicRouteArgvSegment
  = LiteralArgvSegment { text: String }
  | PathParamArgvSegment { param_name: String }

type ServedDynamicRouteExec {
  command: String
  argv: List<ServedDynamicRouteArgvSegment>
}

type ServedDynamicRoute {
  binding: NodeHttpServerRouteBinding
  exec: ServedDynamicRouteExec
  success_status: HttpStatus
}

type ServedStaticRoute {
  method: HttpMethod
  path_pattern: PathTemplate
  body: String
  content_type: HttpContentType
  status_on_hit: HttpStatus
}

type ServedStaticRouteTable {
  routes: List<ServedStaticRoute>
}
