module extdeps.pricing.gitlab_subscription



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "about.gitlab.com/pricing"
  }
}

data pricing_subject_edge_note: String = "Subject and source are ORTHOGONAL axes and a filename encodes neither (operator ruling 2026-07-25): this module's ExternalAuthority anchor above is the SOURCE (the vendor's own pricing page — unchanged), and the subject row below is the typed edge naming the ENTITY these prices are about. It is the same entity node extdeps.sec.issuer.gitlab_facts reaches through its IssuerCatalogRow, so the two fact families (filed financials from EDGAR, list prices from the vendor site) are correlated by an edge in the graph rather than by a shared filename prefix. KNOWN MISMATCH, filed not fixed: the subject row's type reads Vendor<Securities> because Vendor parameterizes the ENTITY by domain, and GitLab is the tree's first two-domain entity (SEC issuer and SaaS vendor) -- one company cannot inhabit two domains without forking the entity row. The edge is correct on identity and wrong on domain; the fix (domain moves onto the relationship rows, Vendor un-parameterized) is a ~14-file migration filed on the grounding-inventory lane with this module as its discriminating receipt. dissolve-on: that migration landing, after which this row's type names no domain."

data gitlab_subscription_subject: extdeps.vendor.Vendor<extdeps.securities.Securities> = extdeps.vendor.gitlab.gitlab

data gitlab_subscription_pricing_provenance_note: String = "Tier list prices and usage meters live-fetched 2026-07-25 from the pricing page (anchor above; session gitlab-10k-scm-costs-baz90x). SaaS (gitlab.com) list pricing; self-managed uses the same tiers and Dedicated/enterprise terms are sales-negotiated. The 10-Ks describe the three-tier open-core model qualitatively but publish no dollar prices (FY2023 10-K: 'we recently announced a price increase in our Premium tier product offering'; FY2024 10-K: 'during fiscal year 2024 we implemented a price increase in our Premium tier'), so the pricing page and GitLab's own announcements are the price authorities, and extdeps.sec.issuer.gitlab_facts carries the filed financial consequences."

// Per-seat-month price on a tier row follows the extdeps.pricing precedent of the implicit billing unit living on the row (github_actions per_minute is per runner-minute; here per_seat_month is per user-month). Ultimate has NO public list price on the live page ('Get custom pricing -- Contact us for custom pricing'): CustomNegotiatedPricing keeps that a typed fact instead of fabricating a number (the pre-2026 99 USD list price is not on the page and is deliberately absent here). FreeOfCharge keeps the Free tier's 0 USD out of the listed arm so a billing term is never asserted for an unbilled tier.
type GitlabSubscriptionTier
  = GitlabFree
  | GitlabPremium
  | GitlabUltimate

type GitlabSeatPricing
  = FreeOfCharge
  | ListedPerSeatMonth { per_seat_month: std.measure.MoneyPerMonth, billed_annually: Bool }
  | CustomNegotiatedPricing

type GitlabTierPriceRow {
  tier: GitlabSubscriptionTier
  tier_wire_label: std.types.NonEmptyStr
  seat_pricing: GitlabSeatPricing
  included_duo_credits_per_seat_month: std.measure.MoneyPerMonth
  pricing_citation: std.types.NonEmptyStr
}

// GitLab Duo Agent Platform usage is metered in GitLab Credits at 1 USD per credit (volume discounts with annual commitment). Paid tiers bundle a monthly per-seat credit allowance denominated in dollars-worth of credits on the live page ('Includes 12 in GitLab Credits per user per month' on Premium, 24 on Ultimate), modeled as MoneyPerMonth per seat. Additional meters on the page: compute minutes sold in 1,000-minute packs at 10 USD one-time (the MoneyPerMinute row below is that pack price normalized per minute), and storage at 5 USD per month per 10 GiB.
data gitlab_free_price: GitlabTierPriceRow = GitlabTierPriceRow {
  tier: GitlabFree,
  tier_wire_label: "free",
  seat_pricing: FreeOfCharge,
  included_duo_credits_per_seat_month: std.measure.MoneyPerMonth {
    amount: std.measure.money_amount_micro(count: 0),
    currency: std.currency.Usd,
  },
  pricing_citation: "pricing#free",
}

data gitlab_premium_price: GitlabTierPriceRow = GitlabTierPriceRow {
  tier: GitlabPremium,
  tier_wire_label: "premium",
  seat_pricing: ListedPerSeatMonth {
    per_seat_month: std.measure.MoneyPerMonth {
      amount: std.measure.money_amount_micro(count: 29000000),
      currency: std.currency.Usd,
    },
    billed_annually: true,
  },
  included_duo_credits_per_seat_month: std.measure.MoneyPerMonth {
    amount: std.measure.money_amount_micro(count: 12000000),
    currency: std.currency.Usd,
  },
  pricing_citation: "pricing#premium",
}

data gitlab_ultimate_price: GitlabTierPriceRow = GitlabTierPriceRow {
  tier: GitlabUltimate,
  tier_wire_label: "ultimate",
  seat_pricing: CustomNegotiatedPricing,
  included_duo_credits_per_seat_month: std.measure.MoneyPerMonth {
    amount: std.measure.money_amount_micro(count: 24000000),
    currency: std.currency.Usd,
  },
  pricing_citation: "pricing#ultimate",
}

fn gitlab_tier_price_catalog() -> List<GitlabTierPriceRow> {
  [
    gitlab_free_price,
    gitlab_premium_price,
    gitlab_ultimate_price,
  ]
}

data gitlab_compute_minute_overage_price: std.measure.MoneyPerMinute = std.measure.MoneyPerMinute {
  amount: std.measure.money_amount_micro(count: 10000),
  currency: std.currency.Usd,
}

type GitlabPremiumListPriceChange {
  effective_date: std.types.NonEmptyStr
  prior_per_seat_month: std.measure.MoneyPerMonth
  new_per_seat_month: std.measure.MoneyPerMonth
  announcement_citation: std.types.NonEmptyStr
}

// The one Premium list-price change since IPO, from GitLab's own announcement (citation below): 'Effective April 3, 2023, GitLab is increasing the list price of GitLab Premium from 19 to 29 USD per user per month.' The FY2023 and FY2024 10-K sentences quoted in the provenance note are the SEC-filed references to this same event. effective_date is an ISO 8601 calendar date.
data gitlab_premium_2023_price_increase: GitlabPremiumListPriceChange = GitlabPremiumListPriceChange {
  effective_date: "2023-04-03",
  prior_per_seat_month: std.measure.MoneyPerMonth {
    amount: std.measure.money_amount_micro(count: 19000000),
    currency: std.currency.Usd,
  },
  new_per_seat_month: std.measure.MoneyPerMonth {
    amount: std.measure.money_amount_micro(count: 29000000),
    currency: std.currency.Usd,
  },
  announcement_citation: "about.gitlab.com/blog/2023/03/01/gitlab-premium-update",
}
