fn aws_ec2_m7a_on_demand_catalog() -> List<AwsEc2OnDemandPriceRow> {
  [
    aws_ec2_m7a_medium_us_east_1,
    aws_ec2_m7a_large_us_east_1,
    aws_ec2_m7a_xlarge_us_east_1,
    aws_ec2_m7a_2xlarge_us_east_1,
    aws_ec2_m7a_4xlarge_us_east_1,
  ]
}
