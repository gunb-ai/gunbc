data aws_ec2_m7a_4xlarge_us_east_1: AwsEc2OnDemandPriceRow = AwsEc2OnDemandPriceRow {
  instance_type: "m7a.4xlarge",
  family: M7a,
  region: UsEast1,
  vcpus: hardware_thread_count(16),
  per_hour: MoneyPerHour {
