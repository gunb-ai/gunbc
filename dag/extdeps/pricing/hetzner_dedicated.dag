module extdeps.pricing.hetzner_dedicated

import extdeps.cpu { cpu_facts_threads }
import extdeps.cpu.amd {
  ryzen_5_3600_facts,
  ryzen_7_pro_8700ge_facts,
  ryzen_9_7950x3d_facts,
}
import std.currency { Eur }
import std.measure {
  ByteSize,
  HardwareThreadCount,
  byte_size,
  MoneyOnce,
  MoneyPerMonth,
  money_amount_micro,
  money_once_micros,
}
import std.nat { Nat }
import std.types { NonEmptyStr, List }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.roster_frontier {
  FrontierRow,
  TriggerProse,
  decl_field_ref,
  frontier_row_decl,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.hetzner.com/general/infrastructure-and-availability/price-adjustment/"
  }
}

data hetzner_dedicated_pricing_provenance_note: String = "Monthly prices excl. VAT live-fetched 2026-07-21 from Hetzner price-adjustment doc GE-D9256 (anchor above, Limited offerings table). Hardware specs cross-checked against robot.hetzner.com/order (same date). EUR only — no currency conversion."

data cpu_description_string_leaf_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_field_ref(
      module_path: "extdeps.pricing.hetzner_dedicated",
      decl_name: "HetznerDedicatedServerPriceRow",
      field_name: "cpu_description",
    ),
    reason: "cpu_description: NonEmptyStr is a cited-boundary locator string at current catalog size; decompose into extdeps.cpu CpuModelCatalogRow (vendor, codename, core count, architecture) when rows grow beyond price-only facts",
    trigger: TriggerProse {
      text: "hetzner_dedicated rows carry CpuFacts catalog instead of cpu_description",
    },
  )
]

type HetznerDedicatedServerType
  = Ax41_1_Ltd
  | Ax42_1_Ltd
  | Ax42_1
  | Ax102_1_Ltd

type HetznerDedicatedServerPriceRow {
  server_type: HetznerDedicatedServerType
  server_type_wire_label: NonEmptyStr
  cpu: CpuFacts
  cpu_description: NonEmptyStr
  memory_bytes: ByteSize
  storage_bytes: ByteSize
  monthly: MoneyPerMonth
  setup_fee: MoneyOnce
  pricing_citation: NonEmptyStr
}

