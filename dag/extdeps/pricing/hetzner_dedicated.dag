fn hetzner_dedicated_price_catalog() -> List<HetznerDedicatedServerPriceRow> {
  [
    hetzner_ax41_1_ltd_price,
    hetzner_ax42_1_ltd_price,
    hetzner_ax42_1_price,
    hetzner_ax102_1_ltd_price,
  ]
}

fn hetzner_dedicated_setup_fee_micros(row: HetznerDedicatedServerPriceRow) -> Nat {
  money_once_micros(q: row.setup_fee)
}

fn hetzner_dedicated_server_threads(row: HetznerDedicatedServerPriceRow) -> HardwareThreadCount {
  cpu_facts_threads(cpu: row.cpu)
}
