// ---------------------------------------------------------------------------------------------
// DERIVATIONS OVER THE LISTING. Every one of these is arithmetic on the rows above and none of
// them introduces a figure. They live here, beside the rows, because the mapping from this
// vendor's listing shape to a comparable rate is a fact about this vendor's surface.
// ---------------------------------------------------------------------------------------------

fn hetzner_listed_monthly_micros(row: HetznerListedServerRow) -> Int {
  money_per_month_micros(q: row.monthly)
}

fn hetzner_listed_hourly_micros(row: HetznerListedServerRow) -> Int {
  money_per_hour_micros(q: row.hourly)
}

fn hetzner_listed_setup_micros(row: HetznerListedServerRow) -> Int {
  money_once_micros(q: row.setup_fee)
}

// A SETUP FEE IS NOT A MONTHLY COST AND BECOMES ONE ONLY OVER A DECLARED HOLDING PERIOD. The
// period is a parameter rather than a constant because it is a fact about the BUYER's intent and
// not about the vendor: a machine held for three months and a machine held for three years spread
// the same fee very differently, and burying a choice of horizon inside a rate would make two
// incomparable numbers look like one.
fn hetzner_listed_effective_monthly(row: HetznerListedServerRow, holding: AmortizationMonths) -> ListedRateStanding {
  let months = amortization_months_count(m: holding)
  if months <= 0 {
    RateNotMeaningful {
      reason: "a holding period of zero months spreads a setup fee over nothing. There is no monthly figure to report and the caller must be told so rather than handed a number.",
    }
  } else {
    ListedRate {
      rate: MoneyPerMonth {
        amount: money_amount_micro(
          count: hetzner_listed_monthly_micros(row: row) + hetzner_listed_setup_micros(row: row) / months,
        ),
        currency: row.monthly.currency,
      },
    }
  }
}

// PER PHYSICAL CORE, and physical rather than thread deliberately. A thread is not a core, the
// listing states both, and every arm64 product this repository compares against sells whole cores
// - so a per-thread figure would compare a half-core against a whole one. GPU rows refuse: the
// price is mostly not buying cores, so dividing it by cores would manufacture a comparison.
// A RATE THAT SURVIVES DIVISION KEEPS ITS CURRENCY. A bare micro Int would erase both the unit
// and the currency, and a euro figure that has forgotten it is a euro is exactly the input that
// manufactured this repository's retired currency-premium claim.
type ListedRateStanding
  = ListedRate { rate: MoneyPerMonth }
  | RateNotMeaningful { reason: NonEmptyStr }

// DIVIDING A REFUSAL IS STILL A REFUSAL. The cause propagates unchanged rather than being
// absorbed into a number, so a caller cannot mistake an unpriceable row for a cheap one.
fn listed_rate_divided(s: ListedRateStanding, divisor: Int) -> ListedRateStanding {
  match s {
    RateNotMeaningful { reason } => RateNotMeaningful { reason: reason },
    ListedRate { rate } => ListedRate {
      rate: MoneyPerMonth {
        amount: money_amount_micro(count: money_per_month_micros(q: rate) / divisor),
        currency: rate.currency,
      },
    },
  }
}

fn hetzner_listed_per_physical_core(row: HetznerListedServerRow, holding: AmortizationMonths) -> ListedRateStanding {
  let cores = physical_core_count_value(c: listed_cpu_physical_cores(c: row.cpu))
  if listing_is_cpu_only(w: row.workload) == false {
    RateNotMeaningful {
      reason: "this row's price includes a discrete GPU, so most of what it buys is not cores and a per-core rate derived from it would be an artifact of the division rather than a price",
    }
  } else if cores <= 0 {
    RateNotMeaningful { reason: "no physical core count on this row" }
  } else {
    listed_rate_divided(s: hetzner_listed_effective_monthly(row: row, holding: holding), divisor: cores)
  }
}

// PER DECIMAL GIGABYTE OF THE BASE CONFIGURATION. Both the numerator and the denominator are read
// from the base end of the range, per the ListedPriceBasis note above.
fn hetzner_listed_per_base_gb(row: HetznerListedServerRow, holding: AmortizationMonths) -> ListedRateStanding {
  let gb = gigabyte_count(g: row.base_memory_gb)
  if listing_is_cpu_only(w: row.workload) == false {
    RateNotMeaningful {
      reason: "this row's price includes a discrete GPU, so a per-gigabyte rate derived from it would be an artifact of the division rather than a price",
    }
  } else if gb <= 0 {
    RateNotMeaningful { reason: "no base memory figure on this row" }
  } else {
    listed_rate_divided(s: hetzner_listed_effective_monthly(row: row, holding: holding), divisor: gb)
  }
}

fn listed_rate_cheaper(a: ListedRateStanding, b: ListedRateStanding) -> ListedRateStanding {
  match a {
    RateNotMeaningful { reason } => b,
    ListedRate { rate } => {
      let a_micros = money_per_month_micros(q: rate)
      match b {
        RateNotMeaningful { reason } => a,
        ListedRate { rate } => if money_per_month_micros(q: rate) < a_micros { b } else { a },
      }
    },
  }
}

data listed_rate_none_meaningful: ListedRateStanding = RateNotMeaningful {
  reason: "no row on the listing carries a meaningful rate on this axis - every row either refused or the listing is empty",
}

// THE CHEAPEST CPU-ONLY CORE ON THE LISTING, folded rather than transcribed, so that adding a row
// moves the answer instead of leaving a stale number in prose beside a fresh roster.
fn hetzner_listed_cheapest_per_core(holding: AmortizationMonths) -> ListedRateStanding {
  fold(
    hetzner_listed_catalog(),
    init: listed_rate_none_meaningful,
    f: (acc, row) => listed_rate_cheaper(
      a: acc,
      b: hetzner_listed_per_physical_core(row: row, holding: holding),
    ),
  )
}

fn hetzner_listed_cheapest_per_base_gb(holding: AmortizationMonths) -> ListedRateStanding {
  fold(
    hetzner_listed_catalog(),
    init: listed_rate_none_meaningful,
    f: (acc, row) => listed_rate_cheaper(
      a: acc,
      b: hetzner_listed_per_base_gb(row: row, holding: holding),
    ),
  )
}

// ---------------------------------------------------------------------------------------------
// WHAT THE LISTING DID NOT CONTAIN. An absence observed on a complete listing is a fact about
// supply, and it is the single most consequential thing in this module - so it is a typed row and
// not a sentence in an annotation, because an annotation cannot be read by any accepted program.
// ---------------------------------------------------------------------------------------------

type ArchitectureOfferingStanding
  = ArchitectureOffered { labels: List<NonEmptyStr> }
  | ArchitectureAbsentFromListing {
      architecture_sought: NonEmptyStr
      labels_present: List<NonEmptyStr>
      competing_explanations: NonEmptyStr
      source: NonEmptyStr
    }

data hetzner_dedicated_arm_standing_2026_09_05: ArchitectureOfferingStanding = ArchitectureAbsentFromListing {
  architecture_sought: "aarch64 - Ampere Altra or Altra Max class, the silicon family the gunbc fleet is built from",
  labels_present: [
    "AX41", "SX65", "AX42", "EX63", "GEX45", "AX102", "SX135",
    "EX131", "AX162", "DX154", "DX182", "SX295", "DX294", "GEX131",
  ],
  competing_explanations: "FOURTEEN ROWS, ALL AMD OR INTEL, NO ARM PRODUCT OF ANY KIND. Read alongside the operator's 2026-09-05 Hetzner Cloud console observation that the arm/Ampere COST OPTIMIZED tier was greyed out and unselectable, this is the same architecture unavailable in both of the vendor's product lines on the same day. WHAT IT DOES NOT ESTABLISH, and these are load-bearing: this is ONE account's view of ONE listing at ONE moment; no region or location filter state was recorded, and this vendor does not offer every product in every location; the listing may be filtered by account tier, by a control the reader did not set, or by a sort or pagination that truncated it; and an absent product line may never have existed on this surface rather than having sold out of it. THE WEAKEST READING THAT STILL HOLDS is the one this repository may use: no purchasable arm64 dedicated price from this vendor is in evidence, so this vendor may not be cited as an arm64 cost floor, in either direction. It does NOT establish that arm capacity is scarce, that a competitor's costs have risen, or that a price increase elsewhere was caused by this. THE OBSERVATION THAT WOULD SETTLE IT is a listing read with the location filter recorded and any architecture filter explicitly cleared.",
  source: "operator reading relayed into session quiet-cat-23, 2026-09-05",
}

fn architecture_is_offered(s: ArchitectureOfferingStanding) -> Bool {
  match s {
    ArchitectureOffered { labels } => true,
    ArchitectureAbsentFromListing { architecture_sought, labels_present, competing_explanations, source } => false,
  }
}

// THE CONSEQUENCE, STATED AS A PREDICATE RATHER THAN AS PROSE, so a consumer that wants to cite
// this vendor as an arm64 floor has to confront the arm instead of reading a silent absence as
// permission.
fn hetzner_admissible_as_arm64_cost_floor() -> Bool {
  architecture_is_offered(s: hetzner_dedicated_arm_standing_2026_09_05)
}
