  cpu_facts_threads(cpu: row.cpu)
}

// ---------------------------------------------------------------------------------------------
// THE PUBLIC DEDICATED-SERVER LISTING AS OBSERVED ON 2026-09-05, kept as its own row type and its
// own roster rather than appended to the rows above. Those are LIMITED offerings read from price
// doc GE-D9256 on 2026-07-21; these are the standard catalogue read from the order page on a
// different date by a different route. Merging two observation events into one roster would make
// the join between a price and the moment it was true unrecoverable, and the two disagree on the
// same wire label - AX41 is 57.30 in the limited table and 59.00 here - which is exactly the
// disagreement a merged roster would silently pick a winner for.
//
// WHY A SEPARATE CPU CARRIER. The rows above bind extdeps.cpu CpuFacts, which carries socket,
// cache geometry and TDP with citations. The listing observed here states only what the order page
// prints: a model name, a codename, a core and thread count, and a clock. Binding these rows to
// CpuFacts would require authoring socket and cache rows for ten processors from no source, so the
// vendor's own words are carried as vendor's own words and the absence is a typed arm rather than
// a fabricated catalog. A row is promoted by replacing VendorStatedCpu with CpuFactsCited once the
// processor genuinely lands in extdeps/cpu.

type ListedCpuStanding
  = CpuFactsCited { facts: CpuFacts }
  | VendorStatedCpu {
      model: NonEmptyStr
      codename: NonEmptyStr
      physical_cores: PhysicalCoreCount
      threads: HardwareThreadCount
      stated_clock: Hertz
      obligation: NonEmptyStr
    }

fn listed_cpu_physical_cores(c: ListedCpuStanding) -> PhysicalCoreCount {
  match c {
    CpuFactsCited { facts } => physical_core_count(count: facts.catalog.cores),
    VendorStatedCpu { model, codename, physical_cores, threads, stated_clock, obligation } => physical_cores,
  }
}

fn listed_cpu_is_grounded(c: ListedCpuStanding) -> Bool {
  match c {
    CpuFactsCited { facts } => true,
    VendorStatedCpu { model, codename, physical_cores, threads, stated_clock, obligation } => false,
  }
}

// WHAT THE PRICE ON THE LISTING ACTUALLY IS. The order page prints "starting from" beside a
// monthly figure and a RAM RANGE, so the printed price belongs to the SMALLEST configuration in
// that family and not to the largest. A per-gibibyte figure computed from the printed price and
// the top of the memory range would divide the cheapest config's price by the dearest config's
// memory and understate the rate, sometimes by a factor of four. The two fields below are
// therefore both taken from the same end of the range - the base configuration - and the type
// says so rather than leaving a reader to assume it.
type ListedPriceBasis
  = StartingFromBaseConfiguration { variants_offered: Int, note: NonEmptyStr }
  | SingleConfiguration

// A GPU IN THE BOX MAKES A PER-CORE PRICE MEANINGLESS, because most of what is being bought is not
// the cores. GPU rows are recorded so the catalogue is complete and are excluded by construction
// from every CPU-price derivation below, rather than being left in for a caller to remember.
type ListedWorkloadClass
  = CpuOnly
  | CpuWithGpu { gpu_description: NonEmptyStr }

fn listing_is_cpu_only(w: ListedWorkloadClass) -> Bool {
  match w {
    CpuOnly => true,
    CpuWithGpu { gpu_description } => false,
  }
}

type HetznerListedServerRow {
  wire_label: NonEmptyStr
  cpu: ListedCpuStanding
  workload: ListedWorkloadClass
  base_memory_gb: Gigabyte
  ecc: Bool
  monthly: MoneyPerMonth
  hourly: MoneyPerHour
  setup_fee: MoneyOnce
  basis: ListedPriceBasis
  observation: NonEmptyStr
}

data hetzner_listing_observation_2026_09_05: NonEmptyStr = "Operator reading of the Hetzner dedicated-server order listing, 2026-09-05, relayed into session quiet-cat-23. Prices excl. VAT, EUR, no region recorded on the listing and none assumed here. Storage configuration is printed on the listing and is deliberately not modelled: no consumer needs it, and a range carried without a consumer is another uncertainty to maintain."

