fn regional_compute_catalog() -> List<RegionalComputeRow> {
  [
    aws_us_east_1, aws_ap_south_1, aws_eu_central_1, aws_me_central_1,
    aws_ap_southeast_1, aws_ap_northeast_1, aws_me_south_1, aws_af_south_1,
    aws_ap_east_1, aws_sa_east_1,
    azure_eastus, azure_centralindia, azure_southindia, azure_israelcentral,
    azure_uaenorth, azure_qatarcentral, azure_koreacentral, azure_southeastasia,
    azure_japaneast, azure_southafricanorth, azure_brazilsouth, azure_westeurope,
    sakura_japan_vps, e2e_networks_india, magalu_cloud_brazil,
    afrihost_south_africa, alibaba_cloud_asia, contabo_global,
  ]
}

fn hourly_micros(row: RegionalComputeRow) -> Nat? {
  match row.hourly {
    HourlyCited { hourly: h } => Present { value: money_rate_micros(q: h) }
    HourlyUnavailable { cause: _ } => none
    HourlyUnrepresentable { observed: _, cause: _ } => none
  }
}

fn compute_provider_eq(a: ComputeProvider, b: ComputeProvider) -> Bool {
  compute_provider_label(p: a) == compute_provider_label(p: b)
}

fn geography_eq(a: Geography, b: Geography) -> Bool {
  geography_label(g: a) == geography_label(g: b)
}
