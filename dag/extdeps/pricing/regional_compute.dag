module extdeps.pricing.regional_compute

import std.currency { Usd }
import std.measure {
  ByteSize,
  HardwareThreadCount,
  MoneyPerHour,
  byte_size,
  hardware_thread_count,
  money_amount_micro,
  money_rate_micros,
}
import std.nat { Nat }
import std.types { NonEmptyStr, List }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "prices.azure.com/api/retail/prices"
  }
}

data regional_compute_provenance_note: String = "Live-fetched 2026-07-25 (session gitlab-10k-scm-costs-baz90x). Two machine-readable authorities, one SKU each, held constant across every geography so a price difference is a REGION fact and not a hardware fact: AWS m7i.large (2 vCPU / 8 GiB, on-demand Linux, shared tenancy, no pre-installed software) streamed from the AWS Price List API regional CSVs -- the same authority extdeps.pricing.aws_ec2 already cites -- and Azure Standard_D2s_v5 (2 vCPU / 8 GiB, Linux pay-as-you-go) from the unauthenticated Azure retail price API (anchor above). Holding the SKU fixed is what makes the comparison honest; the one place it could not be held is recorded on its own row (Bahrain, below)."

data local_provider_readability_note: String = "A structural finding about this market, recorded as rows rather than prose: the HYPERSCALERS publish machine-readable price APIs covering every geography, and essentially no regional or local provider does. Attempted and refused on 2026-07-25: E2E Networks (India) serves a GPU-only fragment and 404s its compute page; Magalu Cloud (Brazil) 404; Afrihost (South Africa) 404; Contabo 403s a non-browser fetch; Alibaba Cloud renders prices client-side; Oracle's price-list API returns an HTML error page. Sakura Internet (Japan) is the one local provider whose ladder IS readable, and it is blocked on a different axis (currency, below). Consequence for anyone building on this: a regionally-diverse cost model can be CITED only for the hyperscalers; local-provider quotes are hand-entered facts with a human in the loop, and should be typed as such rather than silently trusted."

type Geography
  = NorthAmerica
  | SouthAmerica
  | Europe
  | Africa
  | MiddleEast
  | SouthAsia
  | EastAsia
  | SoutheastAsia

fn geography_label(g: Geography) -> NonEmptyStr {
  match g {
    NorthAmerica => "North America"
    SouthAmerica => "South America"
    Europe => "Europe"
    Africa => "Africa"
    MiddleEast => "Middle East"
    SouthAsia => "South Asia"
    EastAsia => "East Asia"
    SoutheastAsia => "Southeast Asia"
  }
}

type ComputeProvider
  = AwsEc2
  | AzureVirtualMachines
  | SakuraInternet
  | E2ENetworks
  | MagaluCloud
  | Afrihost
  | Contabo
  | AlibabaCloud

fn compute_provider_label(p: ComputeProvider) -> NonEmptyStr {
  match p {
    AwsEc2 => "AWS EC2"
    AzureVirtualMachines => "Azure Virtual Machines"
    SakuraInternet => "Sakura Internet"
    E2ENetworks => "E2E Networks"
    MagaluCloud => "Magalu Cloud"
    Afrihost => "Afrihost"
    Contabo => "Contabo"
    AlibabaCloud => "Alibaba Cloud"
  }
}

data hourly_rate_availability_note: String = "Same refusal discipline as extdeps.pricing.object_storage StorageRateAvailability: a rate this fetch could not read is a typed row with a stated cause, never a remembered number. HourlyUnrepresentable is a DISTINCT third arm from HourlyUnavailable because the obstacle is different in kind -- the price was read successfully but cannot be written down in the carrier (Sakura quotes JPY and std.currency admits only Eur and Usd today). Collapsing 'could not read it' and 'read it but cannot represent it' into one arm would hide a modeling gap behind a fetch failure."

type HourlyRateAvailability
  = HourlyCited { hourly: MoneyPerHour }
  | HourlyUnavailable { cause: NonEmptyStr }
  | HourlyUnrepresentable { observed: NonEmptyStr, cause: NonEmptyStr }

type RegionalComputeRow {
  provider: ComputeProvider
  region_code: NonEmptyStr
  region_label: NonEmptyStr
  geography: Geography
  instance_label: NonEmptyStr
  vcpus: HardwareThreadCount
  memory_bytes: ByteSize
  hourly: HourlyRateAvailability
  pricing_citation: NonEmptyStr
}

fn usd_per_hour(micros: Nat) -> HourlyRateAvailability {
  HourlyCited {
    hourly: MoneyPerHour { amount: money_amount_micro(count: micros), currency: Usd },
  }
}

fn two_vcpu() -> HardwareThreadCount {
  hardware_thread_count(2)
}

fn eight_gibibytes() -> ByteSize {
  byte_size(count: 8589934592)
}

