data sakura_japan_vps: RegionalComputeRow = RegionalComputeRow {
  provider: SakuraInternet,
  region_code: "jp-tokyo-ishikari-osaka",
  region_label: "Japan (Tokyo / Ishikari / Osaka)",
  geography: EastAsia,
  instance_label: "VPS 2 GB (3 virtual cores, 100 GB SSD)",
  vcpus: hardware_thread_count(3),
  memory_bytes: byte_size(count: 2147483648),
  hourly: HourlyUnrepresentable {
    observed: "1594 JPY per month (annual 19118 JPY), 3 virtual cores / 2 GB / 100 GB SSD, from the published VPS specification table",
    cause: "std.currency CurrencyCode admits only Eur and Usd, so a JPY-quoted rate cannot be written into MoneyPerHour without either inventing a currency code or folding an undeclared FX rate into the amount. Both are refused. dissolve-on: Jpy added to std.currency (a legitimate std addition -- ISO 4217 is universal-framework vocabulary, unlike a vendor billing unit), after which this row carries the quoted monthly rate and cross-currency comparison takes a DECLARED FX assumption the way gunbc.econ.knowable_wedge already declares eur_to_usd.",
  },
  pricing_citation: "vps.sakura.ad.jp/specification#2GB-plan",
}

