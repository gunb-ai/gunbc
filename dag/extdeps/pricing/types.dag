module extdeps.pricing.types

import std.currency { CurrencyCode }
import std.measure { MoneyAmountMicro, money_amount_micro, money_amount_micro_count }
import std.nat { Nat }

data pricing_billing_unit_note: String = "Billing unit is part of the fact: per-minute, per-hour, and per-month are distinct carriers — never folded into a bare amount with the unit in the field name. Cross-vendor normalization (per-hour equivalents, umbrella ratios) is a DERIVED projection at read time, never a stored catalog field."

type MoneyPerMinute { amount: MoneyAmountMicro, currency: CurrencyCode }

type MoneyPerHour { amount: MoneyAmountMicro, currency: CurrencyCode }

type MoneyPerMonth { amount: MoneyAmountMicro, currency: CurrencyCode }

fn money_per_minute_micros(q: MoneyPerMinute) -> Nat {
  money_amount_micro_count(m: q.amount)
}

fn money_per_hour_micros(q: MoneyPerHour) -> Nat {
  money_amount_micro_count(m: q.amount)
}

fn money_per_month_micros(q: MoneyPerMonth) -> Nat {
  money_amount_micro_count(m: q.amount)
}

data hours_per_billing_month: Nat = 730

data hours_per_billing_month_note: String = "Derived monthly→hourly divisor: 730 hours (365×24/12), the conventional cloud billing month used for cross-vendor hourly equivalence only — not a vendor quote."

fn per_hour_equivalent_from_per_minute(q: MoneyPerMinute) -> MoneyPerHour {
  MoneyPerHour {
    amount: money_amount_micro(count: money_per_minute_micros(q: q) * 60),
    currency: q.currency,
  }
}

fn per_hour_equivalent_from_per_month(q: MoneyPerMonth) -> MoneyPerHour {
  MoneyPerHour {
    amount: money_amount_micro(count: money_per_month_micros(q: q) / hours_per_billing_month),
    currency: q.currency,
  }
}
