module extdeps.pricing.github_actions

import extdeps.toolchain.types { Architecture, Aarch64, X86_64 }
import extdeps.currency.currency { CurrencyCode, Usd }
import std.measure {
  HardwareThreadCount,
  hardware_thread_count,
  MoneyPerMinute,
  money_amount_micro,
}
import std.types { NonEmptyStr, List }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/billing/reference/actions-runner-pricing"
  }
}

// Per-minute rates live-fetched 2026-07-21 from the Actions runner pricing reference (anchor
// above). Baseline hosted-runner SKUs only; larger-runner tables extend on demand as rows.

type GithubActionsBillingSku
  = ActionsLinuxSlim
  | ActionsLinux
  | ActionsLinuxArm
  | Linux4Core
  | Linux8Core
  | Linux16Core

type GithubActionsRunnerPriceRow {
  billing_sku: GithubActionsBillingSku
  sku_wire_label: NonEmptyStr
  vcpus: HardwareThreadCount
  cpu_architecture: Architecture
  per_minute: MoneyPerMinute
  pricing_citation: NonEmptyStr
}

data github_actions_linux_slim_price: GithubActionsRunnerPriceRow = GithubActionsRunnerPriceRow {
  billing_sku: ActionsLinuxSlim,
  sku_wire_label: "actions_linux_slim",
  vcpus: hardware_thread_count(1),
  cpu_architecture: X86_64,
  per_minute: MoneyPerMinute {
    amount: money_amount_micro(count: 2000),
    currency: Usd,
  },
  pricing_citation: "actions-runner-pricing#actions_linux_slim",
}

data github_actions_linux_2core_price: GithubActionsRunnerPriceRow = GithubActionsRunnerPriceRow {
  billing_sku: ActionsLinux,
