module extdeps.pricing.github_actions



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/billing/reference/actions-runner-pricing"
  }
}

data github_actions_pricing_provenance_note: String = "Per-minute rates live-fetched 2026-07-21 from the Actions runner pricing reference (anchor above). Baseline hosted-runner SKUs only; larger-runner tables extend on demand as rows."

type GithubActionsBillingSku
  = ActionsLinuxSlim
  | ActionsLinux
  | ActionsLinuxArm
  | Linux4Core
  | Linux8Core
  | Linux16Core

type GithubActionsRunnerPriceRow {
  billing_sku: GithubActionsBillingSku
  sku_wire_label: std.types.NonEmptyStr
  vcpus: std.measure.HardwareThreadCount
  cpu_architecture: extdeps.toolchain.types.Architecture
  per_minute: std.measure.MoneyPerMinute
  pricing_citation: std.types.NonEmptyStr
}

data github_actions_linux_slim_price: GithubActionsRunnerPriceRow = GithubActionsRunnerPriceRow {
  billing_sku: ActionsLinuxSlim,
  sku_wire_label: "actions_linux_slim",
  vcpus: std.measure.hardware_thread_count(1),
  cpu_architecture: extdeps.toolchain.types.X86_64,
  per_minute: std.measure.MoneyPerMinute {
    amount: std.measure.money_amount_micro(count: 2000),
    currency: std.currency.Usd,
  },
  pricing_citation: "actions-runner-pricing#actions_linux_slim",
}

data github_actions_linux_2core_price: GithubActionsRunnerPriceRow = GithubActionsRunnerPriceRow {
