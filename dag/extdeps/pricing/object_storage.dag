    quoted_unit_label: "GiB replicated (default, North America / Europe dual- and multi-region)",
    byte_basis: BinaryGibibyte,
  },
  tier_lower_bound_gb: 0,
  pricing_citation: "cloud.google.com/storage/pricing#inter-region-replication-default",
}

