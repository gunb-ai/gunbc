module extdeps.pricing.object_storage

import std.currency { CurrencyCode, Usd }
import std.measure {
  MoneyPerMillionRequests,
  MoneyPerStoredUnitMonth,
  MoneyPerTransferredUnit,
  money_amount_micro,
  money_per_stored_unit_month_micros,
  money_per_transferred_unit_micros,
}
import std.nat { Nat }
import std.types { NonEmptyStr, List }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pricing.us-east-1.amazonaws.com/offers/v1.0/aws/AmazonS3/current/us-east-1/index.csv"
  }
}

data object_storage_pricing_provenance_note: String = "Live-fetched 2026-07-25 (session gitlab-10k-scm-costs-baz90x). Machine-readable sources are cited exactly: AWS S3 storage tiers and the durability attribute come from the AWS Price List API regional CSV (anchor above -- the SAME authority extdeps.pricing.aws_ec2 already cites), and internet egress tiers from the AWSDataTransfer price list (us-east-1 to External). Google Cloud Storage rates come from the published pricing page tables; Cloudflare R2 from its pricing docs tables. Backblaze B2 and Hetzner Object Storage quote their headline rates through client-rendered markup that this fetch cannot read, so those rates are RateUnavailable rows with a stated cause -- not remembered numbers (DESIGN section 5: a plausible price fabricated from training data is exactly the wrong answer, and a vendor rate is precisely the kind of fact that goes stale)."

data byte_basis_note: String = "The unit word is not the unit. AWS S3 bills 'GB-Mo', Google Cloud Storage bills '1 gibibyte hour', Cloudflare R2 bills 'GB-month' -- and none of these pricing surfaces states whether its G is 10^9 or 2^30 bytes. The difference is 7.4 percent, which is larger than the spread between several of these vendors, so a model that silently picked one basis would produce comparisons that are wrong in a way no test would catch. Each row therefore carries the vendor's quoted unit label VERBATIM plus a typed ByteBasis, and every row here is ByteBasisUnstated because none of the cited surfaces states it. Cross-vendor comparison is only possible under a DECLARED basis assumption (gunbc.econ.scm_serving_model), never silently. Dissolve-on: citing each vendor's own definition page where one exists."

type ByteBasis
  = BinaryGibibyte
  | DecimalGigabyte
  | ByteBasisUnstated

type StorageVendor
  = AwsS3
  | GoogleCloudStorage
  | CloudflareR2
  | BackblazeB2
  | HetznerObjectStorage

fn storage_vendor_label(v: StorageVendor) -> NonEmptyStr {
  match v {
    AwsS3 => "AWS S3"
    GoogleCloudStorage => "Google Cloud Storage"
    CloudflareR2 => "Cloudflare R2"
    BackblazeB2 => "Backblaze B2"
    HetznerObjectStorage => "Hetzner Object Storage"
  }
}

data durability_standard_note: String = "The industry 'normal standard' for replicated object storage is ELEVEN NINES of annual durability, and for AWS this is not folklore -- it is a machine-readable attribute on the price-list row itself (Durability=99.999999999% on S3 Standard AND Standard-Infrequent-Access; the same file carries 99.99% rows for reduced-redundancy classes). Durability at that level is achieved by erasure-coding each object across multiple facilities, which is WHY the price already includes redundancy: an S3 Standard GB-month is not one copy, so multiplying a cited object-storage rate by a replica count double-counts the redundancy the vendor already sells. That is the modeling trap this row exists to name -- replica multiplication belongs on SELF-MANAGED block storage (the Hetzner dedicated rows in extdeps.pricing.hetzner_dedicated), never on a durability-priced object-storage rate."

type DurabilityClaim
  = DurabilityNines { nines: Nat }
  | DurabilityUnstated

type StorageRateAvailability
  = RateCited {
      rate: MoneyPerStoredUnitMonth,
      quoted_unit_label: NonEmptyStr,
      byte_basis: ByteBasis,
    }
  | RateUnavailable { cause: NonEmptyStr }

type TransferRateAvailability
  = TransferCited {
      rate: MoneyPerTransferredUnit,
      quoted_unit_label: NonEmptyStr,
      byte_basis: ByteBasis,
    }
  | TransferIncludedAtNoCharge { terms: NonEmptyStr }
  | TransferUnavailable { cause: NonEmptyStr }

type ObjectStorageClassRow {
  vendor: StorageVendor
  storage_class_label: NonEmptyStr
  storage_rate: StorageRateAvailability
  durability: DurabilityClaim
  tier_lower_bound_gb: Nat
  pricing_citation: NonEmptyStr
}

type ObjectStorageEgressRow {
  vendor: StorageVendor
  egress_rate: TransferRateAvailability
  tier_lower_bound_gb: Nat
  pricing_citation: NonEmptyStr
}

type ObjectStorageRequestRow {
  vendor: StorageVendor
  operation_class_label: NonEmptyStr
  per_million: MoneyPerMillionRequests
  pricing_citation: NonEmptyStr
}

