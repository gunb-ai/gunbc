data gcs_standard_regional_note: String = "Google Cloud Storage quotes Standard storage as 0.000027397 USD per gibibyte HOUR, which is a different billing period as well as a different byte word from AWS's GB-Mo. The row below carries the monthly equivalent at the conventional 730-hour billing month (std.measure billing_month_as_hour_count): 0.000027397 * 730 = 0.0200 USD, i.e. 20000 micro-USD. That multiplication is a period conversion within ONE vendor's own quote, not a cross-vendor byte-basis conversion -- the latter still refuses without a declared assumption."

data gcs_standard_regional: ObjectStorageClassRow = ObjectStorageClassRow {
  vendor: GoogleCloudStorage,
  storage_class_label: "Standard storage",
  storage_rate: RateCited {
    rate: MoneyPerStoredUnitMonth { amount: money_amount_micro(count: 20000), currency: Usd },
    quoted_unit_label: "1 gibibyte hour (x730h billing month)",
    byte_basis: ByteBasisUnstated,
  },
  durability: DurabilityUnstated,
  tier_lower_bound_gb: 0,
  pricing_citation: "cloud.google.com/storage/pricing#standard-storage",
}

