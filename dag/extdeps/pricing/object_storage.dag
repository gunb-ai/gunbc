    s3_egress_first_10tb,
    s3_egress_next_40tb,
    s3_egress_next_100tb,
    s3_egress_over_150tb,
    r2_egress_free,
    b2_egress_beyond_free_allowance,
    gcs_default_replication,
  ]
}

fn storage_rate_micros(row: ObjectStorageClassRow) -> Nat? {
  match row.storage_rate {
    RateCited { rate: r, quoted_unit_label: _, byte_basis: _ } =>
      Present { value: money_per_stored_unit_month_micros(q: r) }
    RateUnavailable { cause: _ } => none
  }
}

fn egress_rate_micros(row: ObjectStorageEgressRow) -> Nat? {
  match row.egress_rate {
    TransferCited { rate: r, quoted_unit_label: _, byte_basis: _ } =>
      Present { value: money_per_transferred_unit_micros(q: r) }
    TransferIncludedAtNoCharge { terms: _ } => Present { value: 0 }
    TransferUnavailable { cause: _ } => none
  }
}

fn storage_vendor_eq(a: StorageVendor, b: StorageVendor) -> Bool {
  storage_vendor_label(v: a) == storage_vendor_label(v: b)
}

fn durability_nines(row: ObjectStorageClassRow) -> Nat? {
  match row.durability {
    DurabilityNines { nines: n } => Present { value: n }
    DurabilityUnstated => none
  }
}
