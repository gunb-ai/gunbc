fn storage_rate_micros(row: ObjectStorageClassRow) -> Nat? {
  match row.storage_rate {
    RateCited { rate: r, quoted_unit_label: _, byte_basis: _ } =>
      Present { value: money_per_stored_unit_month_micros(q: r) }
    RateUnavailable { cause: _ } => none
  }
}

fn egress_rate_micros(row: ObjectStorageEgressRow) -> Nat? {
  match row.egress_rate {
    TransferCited { rate: r, quoted_unit_label: _, byte_basis: _ } =>
      Present { value: money_per_transferred_unit_micros(q: r) }
    TransferIncludedAtNoCharge { terms: _ } => Present { value: 0 }
    TransferUnavailable { cause: _ } => none
  }
}

fn storage_vendor_eq(a: StorageVendor, b: StorageVendor) -> Bool {
  storage_vendor_label(v: a) == storage_vendor_label(v: b)
}

fn durability_nines(row: ObjectStorageClassRow) -> Nat? {
  match row.durability {
    DurabilityNines { nines: n } => Present { value: n }
    DurabilityUnstated => none
  }
}

data azure_redundancy_ladder_note: String = "Azure is the one vendor in this set that prices REDUNDANCY as an explicit product axis rather than folding it into a single rate, and it publishes the whole ladder through an unauthenticated retail price API (prices.azure.com/api/retail/prices, eastus, General Block Blob v2, Hot access tier, live-fetched 2026-07-25). Reading the ladder answers 'what does more redundancy cost' directly: locally redundant 0.0208, zone redundant 0.026 (+25 percent), geo redundant 0.0458 (+120 percent), geo-zone redundant 0.0468, read-access geo-zone redundant 0.0585 (+181 percent) USD per GB-month at the first tier. Each also steps down at 50 TB and 500 TB, so the rows below carry all three tiers for the ladder positions a serving model actually chooses between."

