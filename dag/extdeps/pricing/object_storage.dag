  vendor: AwsS3,
  storage_class_label: "Standard",
  storage_rate: RateCited {
    rate: MoneyPerStoredUnitMonth { amount: money_amount_micro(count: 23000), currency: Usd },
    quoted_unit_label: "GB-Mo",
    byte_basis: ByteBasisUnstated,
  },
  durability: DurabilityNines { nines: 11 },
  tier_lower_bound_gb: 0,
  pricing_citation: "AmazonS3/us-east-1#TimedStorage-ByteHrs[0-51200]",
}

