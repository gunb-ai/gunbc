data reliability_requirement_note: String = "The operator's framing: decide the reliability posture FIRST, then price only what satisfies it. A requirement is a floor on two independent axes (durability nines, redundancy scope), and the verdict is three-valued on purpose -- Meets, Fails, or RequirementUnknown when the vendor's cited surface does not state the axis at all. Unknown is NOT a pass: a vendor that says nothing about geo-redundancy has not satisfied a geo-redundancy requirement, and collapsing that into a pass is the absorbing fallback DESIGN section 5 forbids. It is also not a fail -- the vendor may well qualify, the pricing surface simply does not say -- so the verdict names what is missing and the operator resolves it with a citation, not a guess."

type ReliabilityRequirement {
  min_durability_nines: Nat
  min_redundancy: RedundancyScope
}

type ReliabilityVerdict
  = MeetsRequirement
  | FailsRequirement { axis: NonEmptyStr }
  | RequirementUnknown { unstated_axis: NonEmptyStr }

fn redundancy_rank(scope: RedundancyScope) -> Nat? {
  match scope {
    SingleFacility => Present { value: 1 }
    MultiFacilityOneRegion => Present { value: 2 }
    MultiRegion => Present { value: 3 }
    ReadAccessMultiRegion => Present { value: 4 }
    GloballyDistributed => Present { value: 3 }
    RedundancyUnstated => none
  }
}

fn evaluate_reliability(row: ObjectStorageClassRow, req: ReliabilityRequirement) -> ReliabilityVerdict {
  match durability_nines(row: row) {
    Present { value: nines } =>
      if nines < req.min_durability_nines {
        FailsRequirement { axis: "durability" }
      } else {
        evaluate_redundancy_only(row: row, req: req)
      }
    _ =>
      if req.min_durability_nines > 0 {
        RequirementUnknown { unstated_axis: "durability" }
      } else {
        evaluate_redundancy_only(row: row, req: req)
      }
  }
}

fn evaluate_redundancy_only(row: ObjectStorageClassRow, req: ReliabilityRequirement) -> ReliabilityVerdict {
  match redundancy_rank(scope: req.min_redundancy) {
    Present { value: required } =>
      match redundancy_rank(scope: row.redundancy) {
        Present { value: offered } =>
          if offered >= required {
            MeetsRequirement
          } else {
            FailsRequirement { axis: "redundancy" }
          }
        _ => RequirementUnknown { unstated_axis: "redundancy" }
      }
    _ => MeetsRequirement
  }
}

data azure_operation_rate_note: String = "Azure quotes blob operations per 10,000, not per million, so these rows carry the vendor figure multiplied by 100 into the shared per-million carrier (a within-vendor unit conversion). Note the redundancy ladder reaches operations too, not just capacity: a Hot LRS write is 0.05 per 10K while the geo-zone-redundant write is 0.1175 -- writes cost more when every write must reach more places, which is the mechanism the storage ladder prices showing up on a second axis. Reads do not vary by redundancy."

