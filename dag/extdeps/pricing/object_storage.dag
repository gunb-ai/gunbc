    gcs_standard_regional,
    r2_standard,
    r2_infrequent_access,
    b2_storage_rate_unavailable,
    hetzner_object_storage_rate_unavailable,
  ]
}

fn object_storage_egress_catalog() -> List<ObjectStorageEgressRow> {
