data archive_format_decomposition_note: String = "ArchiveFormat is container x compression codec (DESIGN section 2 deep decomposition). A .tar.zst distribution is PosixPaxUstarContainer with Zstd codec — not one opaque TarZst enum member or a literal .tar.zst string. .tar.gz and .tgz are the same axes with different distribution suffix conventions."

type PosixPaxUstarContainer {}

data posix_pax_ustar_container: PosixPaxUstarContainer = PosixPaxUstarContainer {}

type ArchiveCompressionCodec = Gzip | Zstd

type ArchiveFormat {
  container: PosixPaxUstarContainer
  codec: ArchiveCompressionCodec
}

type ArchiveDistributionSuffixStyle = TarDotCodec | TgzShort

data archive_format_tar_zstd: ArchiveFormat = ArchiveFormat {
  container: posix_pax_ustar_container,
  codec: Zstd,
}

data archive_format_tar_gzip: ArchiveFormat = ArchiveFormat {
  container: posix_pax_ustar_container,
  codec: Gzip,
}

fn archive_format_distribution_suffix(
  format: ArchiveFormat,
  style: ArchiveDistributionSuffixStyle,
) -> String {
  match format.codec {
    Zstd => ".tar.zst"
    Gzip =>
      match style {
        TarDotCodec => ".tar.gz"
        TgzShort => ".tgz"
      }
  }
}

fn archive_format_eq(a: ArchiveFormat, b: ArchiveFormat) -> Bool {
  a.container == b.container && a.codec == b.codec
}
