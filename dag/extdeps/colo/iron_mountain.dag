module extdeps.colo.iron_mountain

import std.types { NonEmptyStr }
import std.measure { watt }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressUnread, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityMarketedAirOnly, DensityUnread, CabinetPowerFigure, PublishedRealPower,
  RetailGrainStanding, SingleCabinetOffered,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.ironmountain.com/data-centers/locations/new-jersey-data-center"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.iron_mountain",
      decl_name: "iron_mountain_nje1",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data iron_mountain_nje1: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Iron Mountain Data Centers",
  facility_label: "Iron Mountain NJE-1 Edison",
  address: AddressUnread {
    obligation: "The operator's page (read 2026-08-18) places NJE-1 in Edison on a 43-acre campus, about 830,000 square feet and 30 MW, roughly 30 miles from Manhattan, but the sweep did not capture the street address; read the spec sheet before treating this as a candidate.",
  },
  municipality: "Edison",
  region_code: "NJ",
  facility_note: "Enterprise and compliance-weighted operator; retail cabinets exist but the motion targets regulated enterprise. Middlesex County drive from the Hudson waterfront.",
}

data iron_mountain_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "ironmountain.com sales",
  obligation: "No published cabinet pricing on the pages read 2026-08-18.",
}

// THE FIRST DENSE CABINET CLAIM IN THIS CENSUS, and the reason the CabinetDensityClaim carrier
// exists. Every priced plan modelled in this metro tops out at 2.5 kW for twenty rack units, which
// made colocation look physically incapable of holding a 650 W-per-node fleet. It is not: this
// operator markets an order of magnitude more per rack, at a grain that includes single cabinets.
data iron_mountain_nje1_density: CabinetDensityClaim = DensityMarketedAirOnly {
  air_cooled: PublishedRealPower { power: watt(count: 30000) },
  claim_wording: "high-density up to 30 kW/rack",
  citation: "ironmountain.com NJE-1 solution guide, read 2026-09-08 through a summarizing fetch. Raw fetch 2026-09-09 HTTP 429 Vercel Security Checkpoint, 32 KB interstitial, no facility content. Figure retained; wording unverified as page text.",
}

data iron_mountain_nje1_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "private suites, secure cages, and individual cabinets",
  citation: "ironmountain.com NJE-1 solution guide, read 2026-09-08",
}

// A SECOND FACILITY, CARRIED FOR ITS NEGATIVE READING AS MUCH AS ITS POSITIVE ONE. A review
// relayed into this session asserted that this operator advertises cabinets up to 20 kW in
// Pennsylvania. The page was read and states no per-rack or per-cabinet density at all, so the
// claim is UNCONFIRMED and the row records the absence rather than the assertion. That is the
// whole point of a typed unread arm: a density nobody published must not enter the census because
// a secondary source said it existed.
data iron_mountain_wpa1: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Iron Mountain Data Centers",
  facility_label: "Iron Mountain WPA-1 Boyers",
  address: AddressListed {
    street: "1137 Branchton Rd, Boyers, PA 16020",
    citation: "ironmountain.com Pennsylvania data center page, read 2026-09-08",
  },
  municipality: "Boyers",
  region_code: "PA",
  facility_note: "15.5 MW underground facility cooled by natural geothermal exchange with a 100-acre underground reservoir, N+1. Colocation cabinets, dedicated cages and private suites are offered. Western Pennsylvania - far outside the operator-burden distance this census prices, and carried as a market reference rather than a live candidate.",
}

data iron_mountain_wpa1_density: CabinetDensityClaim = DensityUnread {
  obligation: "The operator's Pennsylvania page, read 2026-09-08, states 15.5 MW facility capacity and the cooling design but NO per-rack or per-cabinet density. A secondary review asserted 20 kW cabinets here; that figure was not found on the page and is not carried. Read the facility spec sheet or obtain a quote before any density is attributed to this site.",
}

data iron_mountain_wpa1_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Colocation cabinets, dedicated cages and private suites",
  citation: "ironmountain.com Pennsylvania data center page, read 2026-09-08",
}
