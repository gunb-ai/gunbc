module extdeps.colo.telehouse

import std.types { NonEmptyStr, List }
import std.measure { watt, volt_ampere }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityMarketedAirOnly,
  PublishedRealPower, PublishedApparentPower,
  RetailGrainStanding, SingleCabinetOffered, CageOrSuiteMinimum,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.telehouse.com/global-data-centers/america/new-york-datacenters/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.telehouse",
      decl_name: "telehouse_chelsea",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data telehouse_chelsea: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Telehouse America",
  facility_label: "Telehouse New York Chelsea",
  address: AddressListed {
    street: "85 10th Avenue, New York, NY 10011",
    citation: "telehouse.com New York Chelsea page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "60,000 square feet of Tier 3 colocation in Chelsea with NYIIX on-net, 60-plus carriers and 160-plus connectivity members per the operator page read 2026-09-08. 365 Data Centers lists a 7th-floor suite in this building under its own module.",
}

data telehouse_chelsea_density: CabinetDensityClaim = DensityMarketedAirOnly {
  air_cooled: PublishedApparentPower { power: volt_ampere(count: 5000) },
  claim_wording: "Standard power to rack at 3.5kVA with scalable options to 5kVA",
  citation: "telehouse.com New York Chelsea page; raw fetch 2026-09-09 HTTP 200, 159840 bytes, claim_wording occurs verbatim. The figure is the stated 5 kVA scalable option, not the 3.5 kVA standard. Apparent power is not converted to watts: no power factor is published.",
}

data telehouse_chelsea_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "from half a cabinet up to full racks and private cages",
  citation: "telehouse.com New York Chelsea page, read 2026-09-08",
}

data telehouse_teleport: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Telehouse America",
  facility_label: "Telehouse New York Teleport",
  address: AddressListed {
    street: "7 Teleport Drive, Staten Island, NY 10311",
    citation: "telehouse.com New York Teleport page, read 2026-09-08",
  },
  municipality: "Staten Island",
  region_code: "NY",
  facility_note: "162,000 square feet on the Port Authority Teleport campus, opened 1989, home of NYIIX, with diverse NY and NJ utility feeds and 10 MW available power per the operator page read 2026-09-08. The only independently cited building-operator colo found in Staten Island in this sweep. 365 Data Centers lists an in-building POP here under its own module.",
}

data telehouse_teleport_density: CabinetDensityClaim = DensityMarketedAirOnly {
  air_cooled: PublishedRealPower { power: watt(count: 20000) },
  claim_wording: "Up to 20kW per cabinet maximum capacity",
  citation: "telehouse.com New York Teleport page; raw fetch 2026-09-09 HTTP 200, 164583 bytes, claim_wording occurs verbatim.",
}

data telehouse_teleport_retail_grain: RetailGrainStanding = CageOrSuiteMinimum {
  wording: "Common and caged colocation space (minimum 3 cabinets)",
  citation: "telehouse.com New York Teleport page, read 2026-09-08",
}

data telehouse_facilities: List<ColoFacilityRow> = [telehouse_chelsea, telehouse_teleport]

data telehouse_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "telehouse.com sales / facility tour request",
  obligation: "Cross-connect fees are described as low on the Chelsea page but no cabinet or power prices are published on the pages read 2026-09-08.",
}
