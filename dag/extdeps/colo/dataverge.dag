module extdeps.colo.dataverge



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "dataverge.com/dataverge-colocation/"
  }
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.colo.dataverge",
      decl_name: "dataverge_jersey_city",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data dataverge_provenance_note: std.types.NonEmptyStr = "DataVerge operates colocation in Brooklyn (882 3rd Ave, Industry City) and Jersey City. Facts read 2026-08-18 from dataverge.com pages and the Inflect marketplace profile for the Jersey City site (CGNJ1 designation appears on Inflect). Space is sold from single rack units through quarter and half racks to private cabinets and cages, which makes this the retail-granular operator physically closest to Jersey City in this census."

data dataverge_jersey_city: extdeps.colo.types.ColoFacilityRow = extdeps.colo.types.ColoFacilityRow {
  operator_label: "DataVerge",
  facility_label: "DataVerge Jersey City (CGNJ1)",
  address: extdeps.colo.types.AddressListed {
    street: "111 Town Square Place, Suite 705, Jersey City, NJ 07310",
    citation: "dataverge.com backup-disaster-recovery-data-center-jersey-city page, read 2026-08-18",
  },
  municipality: "Jersey City",
  region_code: "NJ",
  facility_note: "Inflect profile (read 2026-08-18): 0.6 MW total power, 2N power with N+1 UPS, N+1 cooling, PCI DSS / SOC 2 / HIPAA claimed; on-site carriers listed AT&T, Cogent, Crown Castle, Lightpath, Lumen; DataVerge marketing claims 30-plus carriers across its footprint. Located in the Newport office tower district.",
}

data dataverge_retail_rates: extdeps.colo.types.RetailRateStanding = extdeps.colo.types.RatesQuoteOnly {
  contact_route: "quote request or tour scheduling via dataverge.com",
  obligation: "No cabinet, power, or transit price is published on any page read 2026-08-18. A written quote for the reference load is required before any cost comparison can include this facility.",
}
