module extdeps.colo.dataverge

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityUnread, RetailGrainStanding, SingleCabinetOffered }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "dataverge.com/dataverge-colocation/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.dataverge",
      decl_name: "dataverge_jersey_city",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data dataverge_provenance_note: NonEmptyStr = "DataVerge operates colocation in Brooklyn (882 3rd Ave, Industry City) and Jersey City. Facts read 2026-08-18 from dataverge.com pages and the Inflect marketplace profile for the Jersey City site (CGNJ1 designation appears on Inflect). Space is sold from single rack units through quarter and half racks to private cabinets and cages, which makes this the retail-granular operator physically closest to Jersey City in this census."

data dataverge_jersey_city: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataVerge",
  facility_label: "DataVerge Jersey City (CGNJ1)",
  address: AddressListed {
    street: "111 Town Square Place, Suite 705, Jersey City, NJ 07310",
    citation: "dataverge.com backup-disaster-recovery-data-center-jersey-city page, read 2026-08-18",
  },
  municipality: "Jersey City",
  region_code: "NJ",
  facility_note: "Inflect profile (read 2026-08-18): 0.6 MW total power, 2N power with N+1 UPS, N+1 cooling, PCI DSS / SOC 2 / HIPAA claimed; on-site carriers listed AT&T, Cogent, Crown Castle, Lightpath, Lumen; DataVerge marketing claims 30-plus carriers across its footprint. Located in the Newport office tower district.",
}

data dataverge_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "quote request or tour scheduling via dataverge.com",
  obligation: "No cabinet, power, or transit price is published on any page read 2026-08-18. A written quote for the reference load is required before any cost comparison can include this facility.",
}

data dataverge_brooklyn: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataVerge",
  facility_label: "DataVerge Brooklyn (Industry City)",
  address: AddressListed {
    street: "882 3rd Avenue, Brooklyn, NY 11232",
    citation: "dataverge.com interconnected-data-center-brooklyn page, read 2026-09-08",
  },
  municipality: "Brooklyn",
  region_code: "NY",
  facility_note: "50,000 square feet with 40,000 raised floor and 35,000 available for expansion; locking cabinets, cages and private suites; N+1 cooling; 1.75 MW generator backup; 40-plus carriers named including AT&T, Charter, Cogent, Crown Castle, Lightpath, Lumen, Verizon, Zayo, Zenfi per the operator page read 2026-09-08. The page claims this MMR underpins Brooklyn, Queens and Long Island.",
}

data dataverge_brooklyn_density: CabinetDensityClaim = DensityUnread {
  obligation: "The Brooklyn page read 2026-09-08 publishes raised-floor area, N+1/2N distribution and 1.75 MW generator backup, not a marketed kilowatts-per-cabinet ceiling.",
}

data dataverge_brooklyn_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Private Cabinet Colocation; racks, locking cabinets, cages and private suites",
  citation: "dataverge.com interconnected-data-center-brooklyn page, read 2026-09-08",
}

data dataverge_facilities: List<ColoFacilityRow> = [dataverge_brooklyn, dataverge_jersey_city]

data dataverge_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "1/2 cabinet, full cabinet, private cages from 100-5,000+ square feet",
  citation: "dataverge.com interconnected-colocation-services page, read 2026-09-08",
}

data dataverge_cabinet_density: CabinetDensityClaim = DensityUnread {
  obligation: "dataverge.com pages read 2026-09-08 (interconnected-colocation-services and ai-colocation) publish \"High-density deployments up to 300 watts per square foot\", a 10 MW facility figure, and a 100 kW to 1 MW deployment range - and no per-cabinet or per-rack kW figure for either the Jersey City or the Brooklyn site. The operator does not break any figure out by site. Resolve by asking specifically for the air-cooled per-cabinet maximum at 111 Town Square Place.",
}
