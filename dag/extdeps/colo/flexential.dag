data flexential_allentown: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Flexential",
  facility_label: "Flexential Allentown",
  address: AddressUnread {
    obligation: "flexential.com/data-centers/pa/allentown/data-center and its parent path both returned HTTP 403 on 2026-09-08; no address was read first-hand. Secondary listings additionally report that the operator no longer lists this facility, which would make the site's very existence as a Flexential product the first thing to confirm. Retry the fetch from a client the site admits, or ask sales.",
  },
  municipality: "Allentown",
  region_code: "PA",
  facility_note: "Carried as an unresolved coverage obligation in the Lehigh Valley rather than as a confirmed facility: every fetch of the operator's own page was refused on 2026-09-08, so no square footage, power, grain or status is first-hand here.",
}

data flexential_allentown_density: CabinetDensityClaim = DensityUnread {
  obligation: "No page was successfully read (HTTP 403, 2026-09-08). A search summary quoted '150+ watts per square foot' for this site; that is a room-average power intensity, NOT a per-cabinet density, and it is recorded here as the thing not to convert rather than as a reading.",
}

data flexential_allentown_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "No page was successfully read (HTTP 403, 2026-09-08), so nothing is known first-hand about the smallest unit sold at this site.",
