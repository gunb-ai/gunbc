module extdeps.colo.nyi

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim,
  RetailGrainStanding, RetailGrainUnread, DensityUnread,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.nyi.net/solutions/colocation-data-centers/new-york/long-island/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.nyi",
      decl_name: "nyi_long_island",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// NYI SELLS AT AN ADDRESS ANOTHER OPERATOR IN THIS CENSUS ALSO SELLS AT. The Long Island page
// carries 1025 Old Country Road, Westbury - the building Long Island Interconnect operates under
// extdeps.colo.long_island_interconnect - and repeats the same 3 kW-per-cabinet cooling wording
// verbatim. Directory writeups describe NYI's Long Island presence as a partnership rather than
// an owned facility. Which entity the colocation contract is actually with, and whether the
// products differ between the two surfaces, is a quote question this module cannot answer, and
// it is exactly the question the Summit / Evocative pair in Secaucus already forced once.
data nyi_long_island: ColoFacilityRow = ColoFacilityRow {
  operator_label: "NYI",
  facility_label: "NYI Long Island (1025 Old Country Road)",
  address: AddressListed {
    street: "1025 Old Country Road, Westbury, NY 11590",
    citation: "nyi.net Long Island data centers page, read 2026-09-08",
  },
  municipality: "Westbury",
  region_code: "NY",
  facility_note: "Nassau County. NYI's own page states generator-backed AC, UPS AC, DC, N+1/2N and 99.982% availability for the site. It is the same street address as the Long Island Interconnect row; both are carried because the operator is the upstream authority each row cites, not the building.",
}

data nyi_long_island_density: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumUnspecified,
      quantity: PublishedAverage { average: PublishedRealPower { power: watt(count: 3000) } },
      wording: "Cooling level average is 3kW per cabinet; plans to support higher kW per cabinet are established for an adjacent campus property owned by building",
      citation: "nyi.net Long Island page, re-read from raw HTML 2026-09-09. No cooling medium is named anywhere on the page - unspecified BY EVIDENCE, not by default.",
      verification: WordingVerbatim {
        retrieval: "An AVERAGE and not a bound in either direction. This row and the Long Island Interconnect row are two operators publishing the same 3 kW average about the SAME Westbury building; the wordings differ in their tail, so these are two readings rather than one copied twice. \"Cooling level average\" names the system and not the coolant.",
      },
    },
    tail: [],
  },
}

data nyi_long_island_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The NYI Long Island page names no product grain - it describes power, cooling and availability but does not say whether a single cabinet is sold, or only cages and suites. The Long Island Interconnect page for the same address does say cabinets; that is a reading of a DIFFERENT operator's surface and may not be transferred here. Read nyi.net's colocation product pages or ask.",
}

data nyi_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "nyi.net contact form",
  obligation: "No price is published on the Long Island page read 2026-09-08. The quote must first establish who the contracting party at 1025 Old Country Road is - NYI or Long Island Interconnect - because the two surfaces market the same building.",
}
