module extdeps.colo.types

import std.types { NonEmptyStr, List, Bool, Int }
import v2.std.optional { Optional, Present, Absent }
import std.nat { Nat }
import std.measure {
  MoneyPerMonth, MoneyOnce, MoneyPerHour,
  Watt, VoltAmpere, Ampere, Volt, RackUnit, Bandwidth, ByteSize,
  watt, watt_count, volt_ampere_count,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Colocation_centre"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.types",
      decl_name: "ColoFacilityRow",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// AGNOSTIC SHAPES ONLY, per the external-upstream-decomposition rule: this hub defines the
// vocabulary a colocation provider's cited rows inhabit and enumerates NO concrete provider,
// facility, or plan. Each independently governed operator has its own extdeps.colo module
// beside this one; rosters of candidates and any selection over them are consumer facts and
// live with the consumer, never here.

// The domain tag for Vendor<Domain> when a colocation operator is referenced as a company.
// A pure type tag, never construction-reached, on the extdeps.hardware.Hardware pattern.
type ColocationServices

// A street address is a listing claim until someone stands at the door. Rows whose source
// did not carry the address say so instead of carrying a fabricated one.
type AddressStanding
  = AddressListed { street: NonEmptyStr, citation: NonEmptyStr }
  | AddressUnread { obligation: NonEmptyStr }

// One physical colocation facility as one operator's cited row. A multi-operator carrier
// hotel appears once per operator that sells space in it, because the operator is the
// upstream authority the row cites, not the building.
type ColoFacilityRow {
  operator_label: NonEmptyStr
  facility_label: NonEmptyStr
  address: AddressStanding
  municipality: NonEmptyStr
  region_code: NonEmptyStr
  facility_note: NonEmptyStr
}

// Power as a retail colocation offer states it. Watt allocations and breakered feeds are
// different commercial objects: an allocation is a cap the provider meters or polices, a
// feed is a circuit whose usable share is set by the continuous-load derating the consumer
// applies. An offer that states neither is PowerUnread, never a guessed figure; an offer
// stating amps with no voltage keeps its amp reading and carries the voltage as a typed
// obligation, because multiplying by an assumed voltage would fabricate the wattage.
type PowerAllocation
  = AllocatedWatts { allocation: Watt }
  | FeedAmps { amps: Ampere, volts: Volt }
  | FeedAmpsVoltsUnstated { amps: Ampere, voltage_obligation: NonEmptyStr }
  | PowerUnread { obligation: NonEmptyStr }

type TransitAllocation
  = UnmeteredPort { port_speed: Bandwidth }
  | MeteredTransfer { port_speed: Bandwidth, included_transfer_per_month: ByteSize }
  | TransitUnread { obligation: NonEmptyStr }

type Ipv4Allocation
  = Ipv4Usable { usable_addresses: Nat, block_note: NonEmptyStr }
  | Ipv4Unread { obligation: NonEmptyStr }

type SetupCharge
  = SetupFee { fee: MoneyOnce }
  | SetupWaived
  | SetupUnread { obligation: NonEmptyStr }

// A published retail plan row, cited. Every field is a READING of the cited source at the
// capture date in the citation; a plan the provider has since withdrawn is recorded by the
// withdrawal note on the provider module, not by deleting the reading's history.
type RetailPlanRow {
  plan_label: NonEmptyStr
  rack_units: RackUnit
  power: PowerAllocation
  transit: TransitAllocation
  ipv4: Ipv4Allocation
  monthly: MoneyPerMonth
  setup: SetupCharge
  term_note: NonEmptyStr
  citation: NonEmptyStr
}

// WHAT A CABINET MAY DRAW, WHICH IS A THIRD THING BESIDE FACILITY CAPACITY AND A PRICED PLAN.
//
// The census already carried two power facts and neither answers the question a deployment asks.
// A facility's marketed capacity - 80 MW at a carrier hotel, 25.6 MW at an enterprise campus - is
// a fact about a BUILDING, and reading it as density is the same category error as reading a
// substation's rating as a house's service. A RetailPlanRow's PowerAllocation is the right grain
// but exists for only two operators in this metro, because almost nobody publishes retail power.
//
// Between them sits the fact operators DO publish: a marketed maximum per cabinet. It is the
// cheapest available discriminator - it is on a public page, it needs no quote, and it separates
// a 2.5 kW shared-rack product from a 35 kW cabinet before anyone spends a phone call.
//
// IT IS A CLAIM AND THE TYPE SAYS SO. A marketed maximum is not a quote, not currently available
// capacity, and not a commitment: it states what the facility is engineered to support somewhere
// within it, which is why the arms carry the marketing wording verbatim rather than a normalized
// number alone. A candidate may be screened IN on this and may never be screened as PRICED on it.
// A MARKETED CABINET MAXIMUM, IN THE QUANTITY THE OPERATOR ACTUALLY PUBLISHED.
//
// TWO REVIEWS ARRIVED AT THIS FROM OPPOSITE ENDS AND MET. The first cut carried air_cooled_kw and
// liquid_cooled_kw as bare Int. A census lane reading Telehouse Chelsea - "standard power to rack
// at 3.5kVA with scalable options to 5kVA" - had no correct arm for it, put 5 in the kw field and
// documented the mismatch in the citation; the documentation was right and the FIELD was wrong,
// because a note cannot stop a consumer reading a number out of a field named for the quantity it
// is not. Independently, a reviewer observed that a unit baked into a field name is a second
// representation of a fact std.measure already owns, and that THIS FILE ALREADY IMPORTS Watt for
// PowerAllocation - so the census was answering "how much power" two ways at once.
//
// Both objections have one repair, and std.measure had already made the distinction structurally:
// Watt is Measure<Power, One, Nat> and VoltAmpere is Measure<ApparentPower, One, Nat>, carried on
// SEPARATE dimensions with a note in that module saying that putting both on Power would conflate
// them. So the kVA arm here is not a new concept - re-minting one would be the re-invention DESIGN
// section 2 forbids - it is that existing dimension used where an operator published on it.
//
// WHY THE DISTINCTION IS LOAD-BEARING RATHER THAN PEDANTIC. kW = kVA x power factor with PF <= 1,
// so kW <= kVA always, and reading a kVA publication as kilowatts OVERSTATES real capacity - it
// fails in the flattering direction, which here means putting more nodes in a cabinet than its
// breaker will carry. Colocation states kVA precisely because the facility sizes to apparent
// power, so this is the common case.
type CabinetPowerFigure
  = PublishedRealPower { power: Watt }
  | PublishedApparentPower { power: VoltAmpere }

// A PUBLISHED NUMBER IS NOT A PUBLISHED BOUND, AND UNTIL THIS TYPE EXISTED NOTHING COULD TELL THEM
// APART. CabinetPowerFigure answers WHAT UNIT the operator published. Nothing answered WHICH
// DIRECTION the number bounds - and both directions occur verbatim in this corpus, in the same
// field, distinguishable only by a plus sign an author had to notice: "high-density up to 30 kW/rack"
// is a CAP; "35kW+ Cab Density Air" is a FLOOR the operator advertises being able to exceed.
//
// THE QUANTIFIER IS ORTHOGONAL TO EVERYTHING ELSE ABOUT THE FIGURE, so it is one type applied at
// every figure site rather than a new arm per combination. An operator may publish a floor for air
// and a cap for liquid; a per-combination arm set would need one arm per pairing and would fork the
// quantifier concept across them, which is the re-invention that fails DESIGN section 2's test.
//
// WHY THE CONFLATION SURVIVED, WHICH IS THE PART WORTH KEEPING: it failed in the SAFE direction. A
// floor read as a cap makes the screen REFUSE a facility that may well allow far more - a candidate
// lost silently. The reverse, a cap read as a floor, ADMITS a cabinet the breaker cannot carry. One
// costs an opportunity, the other trips a rack, and a single field carrying both means which one you
// get is decided by the wording an author happened to paste rather than by the type.
//
// TWO REVIEWS FOUND THIS INDEPENDENTLY ON THE SAME DAY FROM OPPOSITE ENDS. A design review named the
// conflation abstractly - lower bounds, ceilings, ranges and averages sharing one carrier. A census
// lane hit it concretely: seven Equinix per-IBX pages publish a row labelled MINIMUM Cabinet Density,
// and having no arm for it the lane left all seven DensityUnread rather than file a floor as a
// maximum. That was the right call and it cost seven real readings; this type is what makes it
// unnecessary.
//
// AN AVERAGE IS AN ARM, AND THE REASON IS THE DISTINCTION BETWEEN READ AND USABLE. "Cooling level
// average is 3kW per cabinet" bounds NOTHING about a particular cabinet in either direction - half
// of them may exceed it - so it supports no admission and no refusal. The first cut of this type
// left it out, which forced a lane holding two such rows to file them as DensityUnread: a claim
// that WAS read, recorded as never looked at. Those are different facts, and collapsing them makes
// the census understate its own coverage while hiding a real reading in an obligation string.
//
// So the arm exists and NO OPERATION CONSUMES IT. That is the whole design: the quantity is
// representable, countable and citable, and there is no function into which it can be fed to
// produce a bound. Representability is not permission.
// AN INTERVAL IS TWO NUMBERS ON ONE DIMENSION, AND THE FIRST CUT LET THEM BE ON TWO. The arm used to
// be MarketedInterval { lower: CabinetPowerFigure, upper: CabinetPowerFigure }, and because each
// figure carries its OWN unit tag, `lower: PublishedRealPower` beside `upper: PublishedApparentPower`
// was constructible - a real-power floor under an apparent-power cap. That is not a wide interval,
// it is not an interval at all: kW and kVA are separate dimensions in std.measure precisely so they
// cannot be compared, so the two endpoints of such a value have no ordering between them, and every
// operation over it - ceiling from the upper, coverage from the lower - would silently mix them.
//
// SO THE INTERVAL SPLITS BY DIMENSION AND THE MIXED STATE HAS NO CONSTRUCTOR. This is not a fork of
// the interval concept into two: it is the dimension split std.measure ALREADY made, applied where a
// pair of endpoints has to live on one side of it. A per-dimension arm is what a homogeneous pair
// costs when the dimensions are genuinely distinct types, and the alternative - one arm plus a check
// that the tags agree - is validation standing where construction was available, satisfiable by
// editing the check while the literal still lies.
//
// The two single-ended arms need no such split: one endpoint carries one tag and cannot disagree
// with itself, so CabinetPowerFigure stays exactly where it is sound.
//
// THE INVERTED-INTERVAL GAP SURVIVES THIS AND IS RESTATED RATHER THAN QUIETLY CARRIED FORWARD.
// Nothing here prevents `lower` exceeding `upper` within one dimension, so an inverted interval whose
// ceiling sits BELOW what its own lower end covers is still writable. Rung: mitigatable - no live row
// constructs an interval at all, and the only instances are this carrier's fixtures. CEILING:
// structurally impossible, reachable because the invalid state is an ordering between two fields of
// one constructor and needs no external fact. NEXT-RUNG TRIGGER: field visibility sufficient to make
// a variant's direct literal unconstructible outside its declaring module, so the arm can be reached
// only through a refusing constructor - the SAME capability CabinetPowerCeiling's residue note names.
// Two classes, one capability; neither climbs before it lands, and naming a smaller artifact as the
// trigger would retire the drop while the capability stayed dead.
type PublishedPowerQuantity
  = CapabilityAtLeast { lower: CabinetPowerFigure }
  | MarketedAtMost { upper: CabinetPowerFigure }
  | MarketedRealInterval { lower: Watt, upper: Watt }
  | MarketedApparentInterval { lower: VoltAmpere, upper: VoltAmpere }
  | PublishedAverage { average: CabinetPowerFigure }

// COOLING MEDIUM IS THE THIRD COORDINATE AND IT WAS BEING INFERRED FROM SILENCE. The arms above used
// to name it - DensityMarketedMax meant air-and-liquid, DensityMarketedAirOnly meant air - so a page
// that published a figure and named NO medium had no true arm. Six live rows across three lanes hit
// this: NJFX and Digital Fortress state a figure with no medium, csr_orny1 and hivelocity_ogb1 the
// same, and the operator named Netrality and Telehouse independently. Every one of them sat in the
// air arm with a citation CONFESSING the inference in words - the prose-beside-a-type shape, where
// the sentence is true, adjacent, and unable to stop a consumer reading air out of the arm.
//
// ABSENCE OF A LIQUID FIGURE DOES NOT ESTABLISH AIR-COOLED CAPABILITY. That is the whole content of
// the defect and it fails in the ADMITTING direction, which makes it worse than the quantifier bug
// this file fixed one axis over: a 20 kW electrical claim with no stated medium would satisfy a hard
// requirement for a 20 kW AIR-COOLED cabinet on evidence that never mentioned cooling.
//
// SO MEDIUM BECOMES A FIELD AND THE ARMS STOP MENTIONING IT. A third arm was the tempting repair and
// it is wrong in shape: three arms for two coordinates, needing a fourth the moment an operator
// publishes liquid-only. Medium is orthogonal to direction exactly as direction is orthogonal to
// unit, so it gets the same treatment - one type applied at the figure, never folded into an arm.
type CoolingMediumStanding
  = AirCoolingPublished
  | LiquidCoolingPublished
  | CoolingMediumUnspecified

// WHETHER THE WORDING BESIDE A FIGURE IS THE OPERATOR'S OR A TOOL'S, WHICH IS NOT THE SAME QUESTION
// AS WHETHER THE FIGURE WAS PUBLISHED. Both live rows in this census carry a number that survived
// verification; only one carries a SENTENCE that did. DataBank's cells were read raw at HTTP 200 and
// the wording is the literal spec-table text. Iron Mountain's 30 kW came through a summarizing fetch
// tool, and the raw re-fetch that would confirm it verbatim was blocked at HTTP 429 behind a security
// checkpoint - so the sentence in `wording` there may be the tool's prose rather than the operator's.
//
// UNTIL THIS TYPE EXISTED THE DIFFERENCE WAS CARRIED IN THE CITATION STRING, IN WORDS, and a reader
// scanning rows saw two figures that looked equally established. That is the prose-beside-a-type
// shape this file has now removed three times on three different axes, and it is the reason a
// coverage census must keep at least three separate facts: a figure is MODELLED, its representation
// is VERIFIED, and it is USEFUL for some particular requirement. The first two are properties of the
// reading and live here; the third depends on the requirement and belongs with the consumer.
//
// A summarized reading is retained rather than discarded because a summarizing read is still a read
// and dropping it would lose a real observation - but it is retained VISIBLY, with the discharge
// route beside it, so nothing can cite it as verbatim evidence by mistake.
type FigureVerificationStanding
  = WordingVerbatim { retrieval: NonEmptyStr }
  | WordingSummarized { retrieval: NonEmptyStr, discharge: NonEmptyStr }

// EVIDENCE BELONGS TO THE FIGURE IT ESTABLISHES, NOT TO THE CLAIM THAT COLLECTS THEM. The first cut
// put `claim_wording` and `citation` on the DensityPublished arm, one each, above a LIST of figures.
// DataBank is the counterexample that was already in the corpus when the arm was written: its page
// carries two separately authored cells, "35kW+ Cab Density Air" and "100kW+ Cab Density Liq", and
// the row stored a synthetic slash-joined sentence fusing them beside a single citation. Nothing
// joined either number to the text that established it, so a consumer could add, delete or swap a
// figure while the evidence above it stayed byte-identical - the join was doing no work at all.
//
// It is the same defect as the fused wording silent-heron-303 found across the census, one level up:
// there a tool fused two cells into one sentence, here the TYPE did. Moving the evidence down to the
// figure is what makes the fusion unwritable rather than merely discouraged.
type PublishedDensityFigure {
  medium: CoolingMediumStanding
  quantity: PublishedPowerQuantity
  wording: NonEmptyStr
  citation: NonEmptyStr
  verification: FigureVerificationStanding
}

// A PUBLISHED CLAIM WITH NO FIGURES IS A CONSTRUCTOR CALLING ITSELF PUBLISHED WHILE ITS OWN PREDICATE
// SAYS FALSE, and `List<PublishedDensityFigure>` admitted exactly that. DensityUnread already exists
// for the nothing-was-read case, so an empty DensityPublished is not a second meaning - it is the
// same meaning reachable through the wrong arm, which is the state that makes a census disagree with
// itself depending on which question it asks.
//
// The shape is std.source_annotation's NonEmptyAnnotationAttachmentRefusals verbatim - head plus
// tail, with one accessor flattening it - and it is reused rather than re-coined because a second
// spelling of "non-empty list" is the nicknaming defect this corpus removes on sight.
type NonEmptyDensityFigures {
  head: PublishedDensityFigure
  tail: List<PublishedDensityFigure>
}

fn density_figures_all(figures: NonEmptyDensityFigures) -> List<PublishedDensityFigure> {
  concat([figures.head], figures.tail)
}

type CabinetDensityClaim
  = DensityPublished {
      figures: NonEmptyDensityFigures
    }
  | DensityUnread {
      obligation: NonEmptyStr
    }

// THE ESTABLISHED-READING ACCESSOR IS GONE RATHER THAN REWRITTEN, AND THE QUANTIFIER SPLIT IS WHY.
// `cabinet_density_air_established` returned a Watt reading whenever the published figure was in
// real power. Once a figure carries its DIRECTION, no arm can honestly answer: a cap is not a
// measurement because the cabinet may deliver less; a floor is not one in the other direction; and
// a range names two real numbers while saying nothing about where between them the cabinet sits.
// Every arm would be Absent, so the function becomes a constant dressed as an accessor - a
// decoration that gets cited as coverage, which DESIGN section 4b rules worse than absent.
//
// IT HAD NO PRODUCTION CONSUMER TO BREAK: on main its only caller was its own witness, so deleting
// it costs nothing and that is itself the finding. The accessor had been answering a question
// nothing asked, and carrying the quantifier is what made that legible. A consumer that needs what
// a cabinet WILL supply is asking for a quote or a metered reading; neither is a marketing page,
// and it must go get one rather than find a plausible number here.

// A CEILING IS NOT A READING, AND AFTER THIS IT CANNOT BE HANDED TO ANYTHING THAT WANTS ONE.
// Because kW <= kVA, an apparent-power publication bounds real power from above, so a candidate too
// small even at this bound can be REJECTED without a power factor. It must never ADMIT one - the
// bound is what the cabinet certainly cannot exceed, not what it can deliver.
//
// That distinction used to be carried by this comment while the function returned `Watt?`, the same
// type as the established reading. Review 62791: a consumer could not tell the two apart, and the
// only thing standing between them was prose telling callers what not to do - which is the exact
// shape the accessor two functions above was rewritten to escape, one function later. Same axis,
// same defence, and the crossing at `watt(count: volt_ampere_count(...))` is the constructor of the
// confusable value.
//
// So the ceiling now has its OWN carrier. Passing it where a reading is wanted is ill-typed rather
// than discouraged, and the sound use is the only operation offered: ask whether a requirement is
// refused, never what the cabinet can supply. RESIDUE, STATED RATHER THAN CLAIMED AWAY: `at_most`
// is still reachable by a caller who destructures the arm, so this is a distinct TYPE and not yet
// an inaccessible one. Next capability: field visibility sufficient to make the Watt unreadable
// outside this module, at which point admitting on a ceiling has no constructor at all.
type CabinetPowerCeiling = CeilingAt { at_most: Watt }

// A LOOKUP THAT PICKS IS A LOOKUP THAT WIDENS, AND THE FIRST CUT SHIPPED ONE KNOWINGLY. `air_figure`
// filtered to air and took `.first()`, so a claim carrying TWO air figures - "up to 30 kW" in one
// cell and "35kW+" in another - answered with whichever an author happened to type first, and the
// contradiction left no trace. That is DESIGN section 5's rule inverted: the arm WIDENS where it
// should refuse, and absorption destroys the only signal that the row needs a human. The previous
// note declared it as a future construction rung and shipped it anyway; the honest reading is that
// the query widened on contradiction TODAY, so it is fixed today.
//
// THE MITIGATION NEEDS NO NEW CAPABILITY BECAUSE std.pareto ALREADY OWNS THIS SHAPE. ReadingLookup
// answers Found, Absent or Duplicated over a list of axis readings, with a count-first fold that
// refuses before it selects. This is that, over media instead of axes - reused rather than re-coined,
// and the count-first structure is what makes a mutation adding a second air figure go red by
// producing the Duplicated arm rather than by changing list ORDER, which is what a `.first()` test
// would actually have been measuring.
//
// One-slot-per-medium construction remains the ceiling and would make a duplicate unconstructible
// rather than merely refused. NEXT-RUNG TRIGGER: the medium-slot record landing in the same motion as
// identity closure, which is gunbc.colo_census_coverage's lane to take. Until then this refuses, and
// a refusal is a rung the previous arm did not hold at all.
type DensityFigureLookup
  = FigureFound { figure: PublishedDensityFigure }
  | FigureAbsent { absent_medium: CoolingMediumStanding }
  | FigureDuplicated { duplicated_medium: CoolingMediumStanding }

// THE REQUESTED MEDIUM IS A PARAMETER, NOT A FUNCTION NAME. The carrier introduced
// CoolingMediumStanding as a coordinate and then exported only `air_figure` - baking the first
// consumer back into the shared authority and inviting a second, slightly different liquid traversal
// the moment someone needs one. Two traversals of one coordinate is the fork DESIGN section 3
// removes; one function taking the coordinate is the same code doing both jobs.
//
// UNSPECIFIED SATISFIES NOTHING IN EITHER DIRECTION, AND THAT IS ONE LINE RATHER THAN TWO RULES. A
// figure the operator never labelled matches no request, and a REQUEST for CoolingMediumUnspecified
// matches no figure - so the value stays countable as a census fact while being unable to answer an
// air or a liquid question, which is exactly what it means for a page to have named no medium.
fn medium_matches(f: PublishedDensityFigure, requested: CoolingMediumStanding) -> Bool {
  match requested {
    AirCoolingPublished => figure_is_air(f: f),
    LiquidCoolingPublished => figure_is_liquid(f: f),
    CoolingMediumUnspecified => false,
  }
}

fn figure_is_air(f: PublishedDensityFigure) -> Bool {
  match f.medium {
    AirCoolingPublished => true,
    LiquidCoolingPublished => false,
    CoolingMediumUnspecified => false,
  }
}

fn figure_is_liquid(f: PublishedDensityFigure) -> Bool {
  match f.medium {
    AirCoolingPublished => false,
    LiquidCoolingPublished => true,
    CoolingMediumUnspecified => false,
  }
}

fn figure_matches_count(figures: List<PublishedDensityFigure>, requested: CoolingMediumStanding) -> Int {
  fold(figures, init: 0, f: fn(acc, f) {
    if medium_matches(f: f, requested: requested) { acc + 1 } else { acc }
  })
}

fn figure_lookup(figures: List<PublishedDensityFigure>, requested: CoolingMediumStanding) -> DensityFigureLookup {
  if figure_matches_count(figures: figures, requested: requested) > 1 {
    FigureDuplicated { duplicated_medium: requested }
  } else {
    fold(figures, init: FigureAbsent { absent_medium: requested }, f: fn(acc, f) {
      match acc {
        FigureFound { figure } => acc,
        FigureDuplicated { duplicated_medium } => acc,
        FigureAbsent { absent_medium } =>
          if medium_matches(f: f, requested: absent_medium) { FigureFound { figure: f } } else { acc },
      }
    })
  }
}

fn density_figure_for_medium(d: CabinetDensityClaim, requested: CoolingMediumStanding) -> DensityFigureLookup {
  match d {
    DensityPublished { figures } =>
      figure_lookup(figures: density_figures_all(figures: figures), requested: requested),
    DensityUnread { obligation } => FigureAbsent { absent_medium: requested },
  }
}

fn cabinet_power_ceiling(f: CabinetPowerFigure) -> CabinetPowerCeiling {
  match f {
    PublishedRealPower { power } => CeilingAt { at_most: power },
    PublishedApparentPower { power } => CeilingAt { at_most: watt(count: volt_ampere_count(v: power)) },
  }
}

// A FLOOR YIELDS NO CEILING AND THAT IS THE ENTIRE POINT. CapabilityAtLeast says the operator will
// go at least this high and places no upper bound at all, so there is nothing here for a ceiling to
// be. Returning the lower value would produce a number of the right unit and the right magnitude
// POINTING THE WRONG WAY - the shape that survives a careful reading, because every check on it
// passes. An interval ceilings at its UPPER end and discards its lower, since only the upper bounds
// from above. An average bounds nothing and has no arm into this function's answer.
fn quantity_ceiling(q: PublishedPowerQuantity) -> CabinetPowerCeiling? {
  match q {
    MarketedAtMost { upper } => Present { value: cabinet_power_ceiling(f: upper) },
    CapabilityAtLeast { lower } => Absent,
    MarketedRealInterval { lower, upper } => Present { value: CeilingAt { at_most: upper } },
    MarketedApparentInterval { lower, upper } =>
      Present { value: CeilingAt { at_most: watt(count: volt_ampere_count(v: upper)) } },
    PublishedAverage { average } => Absent,
  }
}

// THE OPPOSITE DIRECTION, WHICH THE FIRST CUT OF THIS SPLIT THREW AWAY. Sending a floor to Absent
// makes it harmless and also useless, and that is a real loss rather than a safe default: a
// marketed floor is exactly the evidence that covers. "35kW+ Cab Density Air" against a 27.3 kW
// requirement says the requirement sits below what the operator advertises being able to do, which
// is the cheapest possible screen and the whole reason a census reads these pages. An interval
// covers up to its LOWER end for the same reason - everything up to there is inside what was
// published - and a cap covers nothing, because a marketed maximum is a product statement and not
// a guarantee that any particular cabinet is available at it.
//
// THE FUNCTION IS NAMED FOR WHAT IT MEASURES RATHER THAN FOR WHAT A CALLER MIGHT DO WITH IT, and the
// rename from `quantity_admits` is the whole of a review finding. A published marketing claim must
// not construct physical placement admission: the operator has said this much is within what they
// build, and nothing more. It is not a quote, not an allocation, not availability, and a function
// called `admits` invites precisely the read that it is. The prose saying so was already here and
// was already the wrong instrument - a sentence cannot stop a consumer reading admission out of a
// name, which is the same argument that moved medium out of the arm names one axis over.
//
// False means UNDETERMINED in exactly the way `ceiling_refuses` returning false does; the two are
// duals and neither ever answers the other's question.
fn quantity_wording_covers(q: PublishedPowerQuantity, required: Watt) -> Bool {
  match q {
    CapabilityAtLeast { lower } => figure_covers(f: lower, required: required),
    MarketedRealInterval { lower, upper } => watt_count(w: required) <= watt_count(w: lower),
    MarketedApparentInterval { lower, upper } => false,
    MarketedAtMost { upper } => false,
    PublishedAverage { average } => false,
  }
}

// The crossing is the conservative one and it goes the other way from the ceiling's. There kW <= kVA
// let an apparent figure bound real power from ABOVE; here a floor must be read as REAL watts to
// cover, and an apparent figure is a weaker claim than the same numeral in watts - so an apparent
// floor covers nothing rather than being converted. Refusing to cross is what keeps the coverage
// from being one power factor more generous than the operator's sentence. The apparent interval arm
// above is the same refusal for the same reason.
fn figure_covers(f: CabinetPowerFigure, required: Watt) -> Bool {
  match f {
    PublishedRealPower { power } => watt_count(w: required) <= watt_count(w: power),
    PublishedApparentPower { power } => false,
  }
}

// THE ONE OPERATION A CEILING SOUNDLY SUPPORTS. True means the requirement exceeds what the cabinet
// can possibly draw, so the candidate is refused on published evidence alone. FALSE MEANS
// UNDETERMINED, NEVER ADMITTED: a requirement under the ceiling has not been shown to fit, because
// the ceiling is an inequality and not a measurement.
fn ceiling_refuses(c: CabinetPowerCeiling, required: Watt) -> Bool {
  match c {
    CeilingAt { at_most } => watt_count(w: required) > watt_count(w: at_most),
  }
}

// A DUPLICATED FIGURE IS NEITHER A YES NOR A NO, AND A BOOLEAN HAS NOWHERE TO PUT IT. Every route
// from a claim to a screen used to flatten through an Optional, so FigureDuplicated would arrive at
// a consumer as Absent - the refusal computed one function down, discarded one function up, and the
// lookup's whole point lost at the seam. THE ARM IS PROPAGATED, NOT COLLAPSED.
//
// ONE CARRIER SERVES BOTH DIRECTIONS BECAUSE THEY ARE DUALS AND NOT TWO CONCEPTS. ScreenHolds means
// the proposition ASKED holds - the published wording covers this requirement, or the published
// ceiling refuses it - and ScreenUndetermined means the evidence did not decide, which for coverage
// is "not shown to fit" and for refusal is "not shown to be impossible". Minting DensityAdmission
// beside DensityRefusal would fork one three-state answer across two questions that already document
// each other as duals.
//
// ScreenNeedsEvidence is std.pareto's needs-evidence outcome under a different name for a different
// subject, and it is the arm that makes the contradiction actionable: it names the medium whose
// figures disagree, so a reader knows which cell to go re-read rather than seeing a silent nothing.
type DensityScreen
  = ScreenHolds
  | ScreenUndetermined
  | ScreenNeedsEvidence { contested_medium: CoolingMediumStanding }

fn density_wording_covers(
  d: CabinetDensityClaim,
  requested: CoolingMediumStanding,
  required: Watt
) -> DensityScreen {
  match density_figure_for_medium(d: d, requested: requested) {
    FigureFound { figure } =>
      if quantity_wording_covers(q: figure.quantity, required: required) {
        ScreenHolds
      } else {
        ScreenUndetermined
      },
    FigureAbsent { absent_medium } => ScreenUndetermined,
    FigureDuplicated { duplicated_medium } => ScreenNeedsEvidence { contested_medium: duplicated_medium },
  }
}

fn density_ceiling_refuses(
  d: CabinetDensityClaim,
  requested: CoolingMediumStanding,
  required: Watt
) -> DensityScreen {
  match density_figure_for_medium(d: d, requested: requested) {
    FigureFound { figure } => match quantity_ceiling(q: figure.quantity) {
      Present { value } =>
        if ceiling_refuses(c: value, required: required) { ScreenHolds } else { ScreenUndetermined },
      Absent => ScreenUndetermined,
    },
    FigureAbsent { absent_medium } => ScreenUndetermined,
    FigureDuplicated { duplicated_medium } => ScreenNeedsEvidence { contested_medium: duplicated_medium },
  }
}

// WHETHER A FIGURE WAS MODELLED AT ALL, WHICH IS A DIFFERENT QUESTION FROM EVERY OTHER ONE HERE AND
// IS THE ONE A COVERAGE CENSUS ACTUALLY ASKS. Every accessor above answers "can this claim bound or
// cover a load", and each correctly returns nothing for a floor, an average, or an unlabelled medium.
// A census asking "did the operator publish a density" through any of them therefore counts a
// verified reading as absent, and its consequence is that a census keyed on the ceiling accessor
// reports a collapse toward zero at the moment the data improves.
//
// IT IS NAMED `contains` AND NOT `publishes`, WHICH IS A REVIEW FINDING AND A REAL NARROWING. The
// implementation can prove that this modelled arm holds a figure. It cannot prove the operator
// published it, that a representation was retrieved, or that the wording resolved - Iron Mountain is
// the live counterexample, a modelled figure resting on a summarizing read whose exact wording is
// unverified. That second fact now has its own carrier in FigureVerificationStanding, and this
// function deliberately does not consult it: model occupancy and retrieval verification are two of
// the three facts a census keeps, and one function answering both would be the fusion this file has
// spent three axes removing.
//
// THE BODY IS NOW AN ARM TEST, AND THAT COLLAPSE IS THE RECEIPT FOR A CLIMB RATHER THAN A REGRESSION.
// It used to be `figures.first()` over a plain list, because an empty DensityPublished was writable
// and the predicate had to check for it at runtime. NonEmptyDensityFigures made that state
// unconstructible, so the check had nothing left to check - the validation dissolved into the
// construction that replaced it, which is what DESIGN section 4b's dissolution-on-climb rule looks
// like when it fires. The discriminating evidence does not dissolve with it: the witness that used
// to red on an empty published claim is now a compile-time refusal, and the mutation that would
// construct one no longer parses.
//
// IT LIVES IN THE CARRIER RATHER THAN IN EACH WITNESS BECAUSE FIVE LANES ASK IT. One of them was
// about to write it as a witness-local predicate and asked first, which is the only reason it is here
// once instead of five times; a region sentinel asserting "this facility published no figure" is the
// same question a coverage roster asks, and DESIGN section 3 does not care that one caller is a test.
fn density_claim_contains_figure(d: CabinetDensityClaim) -> Bool {
  match d {
    DensityPublished { figures } => true,
    DensityUnread { obligation } => false,
  }
}

// Whether the operator sells at a grain this fleet can buy. A campus marketing 25 MW that takes
// only private-suite commitments is not a candidate for one cabinet, and that is a different
// refusal from an unread density - so it is a different fact.
type RetailGrainStanding
  = SingleCabinetOffered { wording: NonEmptyStr, citation: NonEmptyStr }
  | CageOrSuiteMinimum { wording: NonEmptyStr, citation: NonEmptyStr }
  | RetailGrainUnread { obligation: NonEmptyStr }

// Whether ordinary retail pricing is published at all. Most facility operators in this
// market price by quote; that is a fact about the provider worth a typed arm, because a
// consumer computing over prices must treat quote-only as absent-with-an-obligation and
// never as zero or as an average of the published ones.
type RetailRateStanding
  = RatesPublished { plans_note: NonEmptyStr }
  | RatesQuoteOnly { contact_route: NonEmptyStr, obligation: NonEmptyStr }

type CrossConnectFee {
  monthly: MoneyPerMonth
  install: MoneyOnce
  fee_note: NonEmptyStr
  citation: NonEmptyStr
}

type RemoteHandsWindowRate {
  window_label: NonEmptyStr
  hourly: MoneyPerHour
  minimum_note: NonEmptyStr
  citation: NonEmptyStr
}

// THE VERIFICATION COORDINATE'S CONSUMER, WITHOUT WHICH THE FIELD WOULD BE WELL-MODELLED AND DEAD.
// FigureVerificationStanding is written by every row and every fixture in this census and, until this
// function, READ BY NOTHING - a declaration with no fold over it, which DESIGN section 3c calls
// dangling regardless of how well it is shaped. It is the failure mode this file has now hit twice
// from opposite directions: an accessor answering a question nothing asked, and a field answering
// nothing at all.
//
// IT IS THE SECOND OF THE THREE FACTS A COVERAGE CENSUS KEEPS, and it is a separate function from
// `density_claim_contains_figure` on purpose. Occupancy asks whether the model holds a figure;
// this asks whether the operator's own words were retrieved. Iron Mountain answers YES to the first
// and NO to this one, which is exactly the row that would be miscounted by any single predicate -
// and the third fact, whether the figure is useful for a particular requirement, depends on the
// requirement and stays with the consumer where DESIGN section 3 puts it.
fn figure_wording_is_verified(f: PublishedDensityFigure) -> Bool {
  match f.verification {
    WordingVerbatim { retrieval } => true,
    WordingSummarized { retrieval, discharge } => false,
  }
}

// THE FOLD IS OVER EVERY FIGURE AND NOT OVER A REQUESTED MEDIUM, WHICH IS THE ONLY WAY IT REACHES
// THE ROW IT MOST NEEDS TO ANSWER FOR. Iron Mountain's single figure is CoolingMediumUnspecified,
// and an unspecified medium satisfies no request by construction - so a per-medium verification
// accessor cannot see that figure at all, and would answer false for the same reason it answers
// false for a claim with no figures. Two different facts, one indistinguishable answer, which is the
// conflation this file keeps removing; retrieval standing is a property of the READING and must not
// be asked through the screening coordinate.
//
// FALSE FOR DensityUnread IS HONEST RATHER THAN CONFLATED: there is no wording to have verified. It
// is `density_claim_contains_figure` that separates unread from read-but-unverified, and the two are
// asked together precisely because neither answers alone.
fn density_claim_wording_is_verified(d: CabinetDensityClaim) -> Bool {
  match d {
    DensityPublished { figures } =>
      all(density_figures_all(figures: figures), f => figure_wording_is_verified(f: f)),
    DensityUnread { obligation } => false,
  }
}
