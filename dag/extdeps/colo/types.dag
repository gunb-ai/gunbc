module extdeps.colo.types

import std.types { NonEmptyStr, List, Bool }
import v2.std.optional { Optional, Present, Absent }
import std.nat { Nat }
import std.measure {
  MoneyPerMonth, MoneyOnce, MoneyPerHour,
  Watt, VoltAmpere, Ampere, Volt, RackUnit, Bandwidth, ByteSize,
  watt, watt_count, volt_ampere_count,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Colocation_centre"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.types",
      decl_name: "ColoFacilityRow",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// AGNOSTIC SHAPES ONLY, per the external-upstream-decomposition rule: this hub defines the
// vocabulary a colocation provider's cited rows inhabit and enumerates NO concrete provider,
// facility, or plan. Each independently governed operator has its own extdeps.colo module
// beside this one; rosters of candidates and any selection over them are consumer facts and
// live with the consumer, never here.

// The domain tag for Vendor<Domain> when a colocation operator is referenced as a company.
// A pure type tag, never construction-reached, on the extdeps.hardware.Hardware pattern.
type ColocationServices

// A street address is a listing claim until someone stands at the door. Rows whose source
// did not carry the address say so instead of carrying a fabricated one.
type AddressStanding
  = AddressListed { street: NonEmptyStr, citation: NonEmptyStr }
  | AddressUnread { obligation: NonEmptyStr }

// One physical colocation facility as one operator's cited row. A multi-operator carrier
// hotel appears once per operator that sells space in it, because the operator is the
// upstream authority the row cites, not the building.
type ColoFacilityRow {
  operator_label: NonEmptyStr
  facility_label: NonEmptyStr
  address: AddressStanding
  municipality: NonEmptyStr
  region_code: NonEmptyStr
  facility_note: NonEmptyStr
}

// Power as a retail colocation offer states it. Watt allocations and breakered feeds are
// different commercial objects: an allocation is a cap the provider meters or polices, a
// feed is a circuit whose usable share is set by the continuous-load derating the consumer
// applies. An offer that states neither is PowerUnread, never a guessed figure; an offer
// stating amps with no voltage keeps its amp reading and carries the voltage as a typed
// obligation, because multiplying by an assumed voltage would fabricate the wattage.
type PowerAllocation
  = AllocatedWatts { allocation: Watt }
  | FeedAmps { amps: Ampere, volts: Volt }
  | FeedAmpsVoltsUnstated { amps: Ampere, voltage_obligation: NonEmptyStr }
  | PowerUnread { obligation: NonEmptyStr }

type TransitAllocation
  = UnmeteredPort { port_speed: Bandwidth }
  | MeteredTransfer { port_speed: Bandwidth, included_transfer_per_month: ByteSize }
  | TransitUnread { obligation: NonEmptyStr }

type Ipv4Allocation
  = Ipv4Usable { usable_addresses: Nat, block_note: NonEmptyStr }
  | Ipv4Unread { obligation: NonEmptyStr }

type SetupCharge
  = SetupFee { fee: MoneyOnce }
  | SetupWaived
  | SetupUnread { obligation: NonEmptyStr }

// A published retail plan row, cited. Every field is a READING of the cited source at the
// capture date in the citation; a plan the provider has since withdrawn is recorded by the
// withdrawal note on the provider module, not by deleting the reading's history.
type RetailPlanRow {
  plan_label: NonEmptyStr
  rack_units: RackUnit
  power: PowerAllocation
  transit: TransitAllocation
  ipv4: Ipv4Allocation
  monthly: MoneyPerMonth
  setup: SetupCharge
  term_note: NonEmptyStr
  citation: NonEmptyStr
}

// WHAT A CABINET MAY DRAW, WHICH IS A THIRD THING BESIDE FACILITY CAPACITY AND A PRICED PLAN.
//
// The census already carried two power facts and neither answers the question a deployment asks.
// A facility's marketed capacity - 80 MW at a carrier hotel, 25.6 MW at an enterprise campus - is
// a fact about a BUILDING, and reading it as density is the same category error as reading a
// substation's rating as a house's service. A RetailPlanRow's PowerAllocation is the right grain
// but exists for only two operators in this metro, because almost nobody publishes retail power.
//
// Between them sits the fact operators DO publish: a marketed maximum per cabinet. It is the
// cheapest available discriminator - it is on a public page, it needs no quote, and it separates
// a 2.5 kW shared-rack product from a 35 kW cabinet before anyone spends a phone call.
//
// IT IS A CLAIM AND THE TYPE SAYS SO. A marketed maximum is not a quote, not currently available
// capacity, and not a commitment: it states what the facility is engineered to support somewhere
// within it, which is why the arms carry the marketing wording verbatim rather than a normalized
// number alone. A candidate may be screened IN on this and may never be screened as PRICED on it.
// A MARKETED CABINET MAXIMUM, IN THE QUANTITY THE OPERATOR ACTUALLY PUBLISHED.
//
// TWO REVIEWS ARRIVED AT THIS FROM OPPOSITE ENDS AND MET. The first cut carried air_cooled_kw and
// liquid_cooled_kw as bare Int. A census lane reading Telehouse Chelsea - "standard power to rack
// at 3.5kVA with scalable options to 5kVA" - had no correct arm for it, put 5 in the kw field and
// documented the mismatch in the citation; the documentation was right and the FIELD was wrong,
// because a note cannot stop a consumer reading a number out of a field named for the quantity it
// is not. Independently, a reviewer observed that a unit baked into a field name is a second
// representation of a fact std.measure already owns, and that THIS FILE ALREADY IMPORTS Watt for
// PowerAllocation - so the census was answering "how much power" two ways at once.
//
// Both objections have one repair, and std.measure had already made the distinction structurally:
// Watt is Measure<Power, One, Nat> and VoltAmpere is Measure<ApparentPower, One, Nat>, carried on
// SEPARATE dimensions with a note in that module saying that putting both on Power would conflate
// them. So the kVA arm here is not a new concept - re-minting one would be the re-invention DESIGN
// section 2 forbids - it is that existing dimension used where an operator published on it.
//
// WHY THE DISTINCTION IS LOAD-BEARING RATHER THAN PEDANTIC. kW = kVA x power factor with PF <= 1,
// so kW <= kVA always, and reading a kVA publication as kilowatts OVERSTATES real capacity - it
// fails in the flattering direction, which here means putting more nodes in a cabinet than its
// breaker will carry. Colocation states kVA precisely because the facility sizes to apparent
// power, so this is the common case.
type CabinetPowerFigure
  = PublishedRealPower { power: Watt }
  | PublishedApparentPower { power: VoltAmpere }

// A PUBLISHED NUMBER IS NOT A PUBLISHED BOUND, AND UNTIL THIS TYPE EXISTED NOTHING COULD TELL THEM
// APART. CabinetPowerFigure answers WHAT UNIT the operator published. Nothing answered WHICH
// DIRECTION the number bounds - and both directions occur verbatim in this corpus, in the same
// field, distinguishable only by a plus sign an author had to notice: "high-density up to 30 kW/rack"
// is a CAP; "35kW+ Cab Density Air" is a FLOOR the operator advertises being able to exceed.
//
// THE QUANTIFIER IS ORTHOGONAL TO EVERYTHING ELSE ABOUT THE FIGURE, so it is one type applied at
// every figure site rather than a new arm per combination. An operator may publish a floor for air
// and a cap for liquid; a per-combination arm set would need one arm per pairing and would fork the
// quantifier concept across them, which is the re-invention that fails DESIGN section 2's test.
//
// WHY THE CONFLATION SURVIVED, WHICH IS THE PART WORTH KEEPING: it failed in the SAFE direction. A
// floor read as a cap makes the screen REFUSE a facility that may well allow far more - a candidate
// lost silently. The reverse, a cap read as a floor, ADMITS a cabinet the breaker cannot carry. One
// costs an opportunity, the other trips a rack, and a single field carrying both means which one you
// get is decided by the wording an author happened to paste rather than by the type.
//
// TWO REVIEWS FOUND THIS INDEPENDENTLY ON THE SAME DAY FROM OPPOSITE ENDS. A design review named the
// conflation abstractly - lower bounds, ceilings, ranges and averages sharing one carrier. A census
// lane hit it concretely: seven Equinix per-IBX pages publish a row labelled MINIMUM Cabinet Density,
// and having no arm for it the lane left all seven DensityUnread rather than file a floor as a
// maximum. That was the right call and it cost seven real readings; this type is what makes it
// unnecessary.
//
// AN AVERAGE IS AN ARM, AND THE REASON IS THE DISTINCTION BETWEEN READ AND USABLE. "Cooling level
// average is 3kW per cabinet" bounds NOTHING about a particular cabinet in either direction - half
// of them may exceed it - so it supports no admission and no refusal. The first cut of this type
// left it out, which forced a lane holding two such rows to file them as DensityUnread: a claim
// that WAS read, recorded as never looked at. Those are different facts, and collapsing them makes
// the census understate its own coverage while hiding a real reading in an obligation string.
//
// So the arm exists and NO OPERATION CONSUMES IT. That is the whole design: the quantity is
// representable, countable and citable, and there is no function into which it can be fed to
// produce a bound. Representability is not permission.
// THE INTERVAL ARM SITS ONE RUNG BELOW THE REST OF THIS TYPE AND THE GAP IS DECLARED RATHER THAN
// LEFT TO BE FOUND. The other three arms are structurally impossible to misuse: there is no
// constructor that puts a floor where a cap belongs, because the arms ARE the distinction.
// MarketedInterval carries two figures and nothing prevents `lower` exceeding `upper` - an inverted
// interval whose `quantity_ceiling` would sit BELOW its `quantity_admits`, so the same requirement
// could be both covered by the published wording and above the published bound. Rung: mitigatable,
// since no live row constructs one and the sole instance is the carrier's own fixture.
//
// CEILING: structurally impossible, and it is genuinely reachable rather than aspirational - the
// invalid state is an ordering between two fields of one constructor, which is decidable from the
// values at hand and needs no external fact. NEXT-RUNG TRIGGER: a refusing constructor for this arm,
// which requires the capability to make a variant's direct literal unconstructible outside its
// module - the SAME field-visibility capability CabinetPowerCeiling's residue note already names as
// its trigger. Two classes, one capability; neither climbs before it lands.
//
// A validator is deliberately NOT the answer here. Checking the ordering after construction is the
// validation-beside-construction shape DESIGN section 5 warns about, and it would be satisfiable by
// editing the check while the literal still lies - so it would buy a rung on paper and none in fact.
type PublishedPowerQuantity
  = CapabilityAtLeast { lower: CabinetPowerFigure }
  | MarketedAtMost { upper: CabinetPowerFigure }
  | MarketedInterval { lower: CabinetPowerFigure, upper: CabinetPowerFigure }
  | PublishedAverage { average: CabinetPowerFigure }

// COOLING MEDIUM IS THE THIRD COORDINATE AND IT WAS BEING INFERRED FROM SILENCE. The arms above used
// to name it - DensityMarketedMax meant air-and-liquid, DensityMarketedAirOnly meant air - so a page
// that published a figure and named NO medium had no true arm. Six live rows across three lanes hit
// this: NJFX and Digital Fortress state a figure with no medium, csr_orny1 and hivelocity_ogb1 the
// same, and the operator named Netrality and Telehouse independently. Every one of them sat in the
// air arm with a citation CONFESSING the inference in words - the prose-beside-a-type shape, where
// the sentence is true, adjacent, and unable to stop a consumer reading air out of the arm.
//
// ABSENCE OF A LIQUID FIGURE DOES NOT ESTABLISH AIR-COOLED CAPABILITY. That is the whole content of
// the defect and it fails in the ADMITTING direction, which makes it worse than the quantifier bug
// this file fixed one axis over: a 20 kW electrical claim with no stated medium would satisfy a hard
// requirement for a 20 kW AIR-COOLED cabinet on evidence that never mentioned cooling.
//
// SO MEDIUM BECOMES A FIELD AND THE ARMS STOP MENTIONING IT. A third arm was the tempting repair and
// it is wrong in shape: three arms for two coordinates, needing a fourth the moment an operator
// publishes liquid-only. Medium is orthogonal to direction exactly as direction is orthogonal to
// unit, so it gets the same treatment - one type applied at the figure, never folded into an arm.
//
// AND A CLAIM CARRIES A LIST OF FIGURES RATHER THAN ONE PER MEDIUM. DataBank publishes 35kW+ air and
// 100kW+ liquid: that is TWO published figures, not one figure with a fused medium, and there is no
// AirAndLiquidPublished arm for the same reason there is no arm per combination anywhere else here.
type CoolingMediumStanding
  = AirCoolingPublished
  | LiquidCoolingPublished
  | CoolingMediumUnspecified

type PublishedDensityFigure {
  medium: CoolingMediumStanding
  quantity: PublishedPowerQuantity
}

type CabinetDensityClaim
  = DensityPublished {
      figures: List<PublishedDensityFigure>
      claim_wording: NonEmptyStr
      citation: NonEmptyStr
    }
  | DensityUnread {
      obligation: NonEmptyStr
    }

// THE ESTABLISHED-READING ACCESSOR IS GONE RATHER THAN REWRITTEN, AND THE SPLIT ABOVE IS WHY.
// `cabinet_density_air_established` returned a Watt reading whenever the published figure was in
// real power. Once a figure carries its DIRECTION, no arm can honestly answer: a cap is not a
// measurement because the cabinet may deliver less; a floor is not one in the other direction; and
// a range names two real numbers while saying nothing about where between them the cabinet sits.
// Every arm would be Absent, so the function becomes a constant dressed as an accessor - a
// decoration that gets cited as coverage, which DESIGN section 4b rules worse than absent.
//
// IT HAD NO PRODUCTION CONSUMER TO BREAK: on main its only caller was its own witness, so deleting
// it costs nothing and that is itself the finding. The accessor had been answering a question
// nothing asked, and carrying the quantifier is what made that legible. A consumer that needs what
// a cabinet WILL supply is asking for a quote or a metered reading; neither is a marketing page,
// and it must go get one rather than find a plausible number here.

// A CEILING IS NOT A READING, AND AFTER THIS IT CANNOT BE HANDED TO ANYTHING THAT WANTS ONE.
// Because kW <= kVA, an apparent-power publication bounds real power from above, so a candidate too
// small even at this bound can be REJECTED without a power factor. It must never ADMIT one - the
// bound is what the cabinet certainly cannot exceed, not what it can deliver.
//
// That distinction used to be carried by this comment while the function returned `Watt?`, the same
// type as the established reading. Review 62791: a consumer could not tell the two apart, and the
// only thing standing between them was prose telling callers what not to do - which is the exact
// shape the accessor two functions above was rewritten to escape, one function later. Same axis,
// same defence, and the crossing at `watt(count: volt_ampere_count(...))` is the constructor of the
// confusable value.
//
// So the ceiling now has its OWN carrier. Passing it where a reading is wanted is ill-typed rather
// than discouraged, and the sound use is the only operation offered: ask whether a requirement is
// refused, never what the cabinet can supply. RESIDUE, STATED RATHER THAN CLAIMED AWAY: `at_most`
// is still reachable by a caller who destructures the arm, so this is a distinct TYPE and not yet
// an inaccessible one. Next capability: field visibility sufficient to make the Watt unreadable
// outside this module, at which point admitting on a ceiling has no constructor at all.
type CabinetPowerCeiling = CeilingAt { at_most: Watt }

fn cabinet_density_air_ceiling(d: CabinetDensityClaim) -> CabinetPowerCeiling? {
  match cabinet_density_air_quantity(d: d) {
    Present { value } => quantity_ceiling(q: value),
    Absent => Absent,
  }
}

// AN UNSPECIFIED MEDIUM DOES NOT ANSWER AN AIR QUESTION, and that single line is the repair. This
// selects only figures the operator actually labelled air; CoolingMediumUnspecified and
// LiquidCoolingPublished both fall through to Absent, so a claim whose page never mentioned cooling
// can no longer satisfy an air-cooled requirement by sitting in an arm named for one.
// A SECOND AIR FIGURE IS SILENTLY DISCARDED HERE AND THAT IS AN ABSORBING FALLBACK, DECLARED RATHER
// THAN LEFT FOR A REVIEWER. `List<PublishedDensityFigure>` does not stop a claim carrying TWO figures
// labelled air - say a page stating "up to 30 kW" in one cell and "35kW+" in another - and `.first()`
// then answers with whichever was authored first, with no signal that a contradiction existed. That
// is DESIGN section 5's rule inverted: the arm WIDENS to an arbitrary pick where it should refuse,
// and absorption destroys the only evidence that the row needs a human.
//
// It is not the same defect as the medium confusion this function exists to fix - that one answered
// an air question from an unlabelled page, this one answers it from a contradicted page - but it is
// the same family, and shipping the fix for one while leaving the other unstated would be the
// annotation-asserting-coverage shape filed twice tonight.
//
// RUNG: mitigatable. No live row constructs two figures of one medium, and DataBank's two figures are
// air and liquid. CEILING: structurally impossible, and reachable by CONSTRUCTION rather than by a
// check - a record with one optional slot per medium makes a duplicate air figure unconstructible,
// where the list plus a validator would be satisfiable by editing the validator while the literal
// still lies. That candidate is named rather than taken because the list shape is already committed
// to three lanes and swapping it now costs them a second migration for a state no row occupies.
// NEXT-RUNG TRIGGER: the first row that needs two figures of one medium, or the medium-slot record
// landing in the same motion as identity closure, whichever comes first - both are decided in
// gunbc.colo_census_coverage's lane and neither should be taken unilaterally here.
//
// The honest reading of the current arm: it answers for a WELL-FORMED claim and picks arbitrarily for
// a malformed one, and nothing yet makes malformed unwritable.
fn air_figure(figures: List<PublishedDensityFigure>) -> PublishedDensityFigure? {
  let air = figures |> filter(f => figure_is_air(f: f))
  air.first()
}

fn figure_is_air(f: PublishedDensityFigure) -> Bool {
  match f.medium {
    AirCoolingPublished => true,
    LiquidCoolingPublished => false,
    CoolingMediumUnspecified => false,
  }
}

fn cabinet_power_ceiling(f: CabinetPowerFigure) -> CabinetPowerCeiling {
  match f {
    PublishedRealPower { power } => CeilingAt { at_most: power },
    PublishedApparentPower { power } => CeilingAt { at_most: watt(count: volt_ampere_count(v: power)) },
  }
}

// A FLOOR YIELDS NO CEILING AND THAT IS THE ENTIRE POINT. CapabilityAtLeast says the operator will
// go at least this high and places no upper bound at all, so there is nothing here for a ceiling to
// be. Returning the lower value would produce a number of the right unit and the right magnitude
// POINTING THE WRONG WAY - the shape that survives a careful reading, because every check on it
// passes. An interval ceilings at its UPPER end and discards its lower, since only the upper bounds
// from above. An average bounds nothing and has no arm into this function's answer.
fn quantity_ceiling(q: PublishedPowerQuantity) -> CabinetPowerCeiling? {
  match q {
    MarketedAtMost { upper } => Present { value: cabinet_power_ceiling(f: upper) },
    CapabilityAtLeast { lower } => Absent,
    MarketedInterval { lower, upper } => Present { value: cabinet_power_ceiling(f: upper) },
    PublishedAverage { average } => Absent,
  }
}

// THE OPPOSITE DIRECTION, WHICH THE FIRST CUT OF THIS SPLIT THREW AWAY. Sending a floor to Absent
// makes it harmless and also useless, and that is a real loss rather than a safe default: a
// marketed floor is exactly the evidence that ADMITS. "35kW+ Cab Density Air" against a 27.3 kW
// requirement says the requirement sits below what the operator advertises being able to do, which
// is the cheapest possible screen and the whole reason a census reads these pages. An interval
// admits on its LOWER end for the same reason - everything up to there is inside what was
// published - and a cap admits nothing, because a marketed maximum is a product statement and not
// a guarantee that any particular cabinet is available at it.
//
// TRUE MEANS THE PUBLISHED WORDING COVERS THE REQUIREMENT. IT IS NOT A QUOTE, NOT AN ALLOCATION AND
// NOT AVAILABILITY - the operator has said this much is within what they build, and nothing more.
// False means UNDETERMINED in exactly the way `ceiling_refuses` returning false does; the two are
// duals and neither ever answers the other's question.
// WHETHER A FIGURE WAS PUBLISHED AT ALL, WHICH IS A DIFFERENT QUESTION FROM EVERY OTHER ONE HERE AND
// IS THE ONE A COVERAGE CENSUS ACTUALLY ASKS. Every accessor above answers "can this claim bound or
// admit a load", and each correctly returns nothing for a floor, an average, or an unlabelled medium.
// A census asking "did the operator publish a density" through any of them therefore counts a
// VERIFIED reading as absent - the operator's ruling on density_claim_is_read names exactly this, and
// its consequence is that a census keyed on the ceiling accessor reports a collapse toward zero at
// the moment the data improves.
//
// IT LIVES IN THE CARRIER RATHER THAN IN EACH WITNESS BECAUSE FIVE LANES ASK IT. One of them was
// about to write it as a witness-local predicate and asked first, which is the only reason it is here
// once instead of five times; a region sentinel asserting "this facility published no figure" is the
// same question a coverage roster asks, and DESIGN section 3 does not care that one caller is a test.
//
// It is deliberately NOT the same function as a coverage count: this says what the CLAIM carries, and
// what a census does with that - retrieval coverage, per-region rosters, decision utility - is a
// consumer fact that belongs with the consumer.
fn density_claim_publishes_a_figure(d: CabinetDensityClaim) -> Bool {
  match d {
    DensityPublished { figures, claim_wording, citation } => match figures.first() {
      Present { value } => true,
      Absent => false,
    },
    DensityUnread { obligation } => false,
  }
}

// THE ROUTE FROM A CLAIM TO THE ADMITTING DIRECTION, WHICH THE CEILING SIDE ALREADY HAD. Without
// it `quantity_admits` is reachable only by a caller that has already destructured the claim, which
// is the shape DESIGN section 3c calls dangling: a well-formed declaration with no route by which a
// consumer arrives at it. This is that route, and it is deliberately the same shape as
// `cabinet_density_air_ceiling` so the two directions are asked the same way.
fn cabinet_density_air_quantity(d: CabinetDensityClaim) -> PublishedPowerQuantity? {
  match d {
    DensityPublished { figures, claim_wording, citation } => match air_figure(figures: figures) {
      Present { value } => Present { value: value.quantity },
      Absent => Absent,
    },
    DensityUnread { obligation } => Absent,
  }
}

fn quantity_admits(q: PublishedPowerQuantity, required: Watt) -> Bool {
  match q {
    CapabilityAtLeast { lower } => figure_covers(f: lower, required: required),
    MarketedInterval { lower, upper } => figure_covers(f: lower, required: required),
    MarketedAtMost { upper } => false,
    PublishedAverage { average } => false,
  }
}

// The crossing is the conservative one and it goes the other way from the ceiling's. There kW <= kVA
// let an apparent figure bound real power from ABOVE; here a floor must be read as REAL watts to
// admit, and an apparent figure is a weaker claim than the same numeral in watts - so an apparent
// floor admits nothing rather than being converted. Refusing to cross is what keeps the admission
// from being one power factor more generous than the operator's sentence.
fn figure_covers(f: CabinetPowerFigure, required: Watt) -> Bool {
  match f {
    PublishedRealPower { power } => watt_count(w: required) <= watt_count(w: power),
    PublishedApparentPower { power } => false,
  }
}

// THE ONE OPERATION A CEILING SOUNDLY SUPPORTS. True means the requirement exceeds what the cabinet
// can possibly draw, so the candidate is refused on published evidence alone. FALSE MEANS
// UNDETERMINED, NEVER ADMITTED: a requirement under the ceiling has not been shown to fit, because
// the ceiling is an inequality and not a measurement.
fn ceiling_refuses(c: CabinetPowerCeiling, required: Watt) -> Bool {
  match c {
    CeilingAt { at_most } => watt_count(w: required) > watt_count(w: at_most),
  }
}

// Whether the operator sells at a grain this fleet can buy. A campus marketing 25 MW that takes
// only private-suite commitments is not a candidate for one cabinet, and that is a different
// refusal from an unread density - so it is a different fact.
type RetailGrainStanding
  = SingleCabinetOffered { wording: NonEmptyStr, citation: NonEmptyStr }
  | CageOrSuiteMinimum { wording: NonEmptyStr, citation: NonEmptyStr }
  | RetailGrainUnread { obligation: NonEmptyStr }

// Whether ordinary retail pricing is published at all. Most facility operators in this
// market price by quote; that is a fact about the provider worth a typed arm, because a
// consumer computing over prices must treat quote-only as absent-with-an-obligation and
// never as zero or as an average of the published ones.
type RetailRateStanding
  = RatesPublished { plans_note: NonEmptyStr }
  | RatesQuoteOnly { contact_route: NonEmptyStr, obligation: NonEmptyStr }

type CrossConnectFee {
  monthly: MoneyPerMonth
  install: MoneyOnce
  fee_note: NonEmptyStr
  citation: NonEmptyStr
}

type RemoteHandsWindowRate {
  window_label: NonEmptyStr
  hourly: MoneyPerHour
  minimum_note: NonEmptyStr
  citation: NonEmptyStr
}
