module extdeps.colo.colocation_america

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityUnread, RetailGrainStanding, RetailGrainUnread }

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.colocationamerica.com/data-center-locations/new-jersey"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.colocation_america",
      decl_name: "colocation_america_njdc1",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data colocation_america_njdc1: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Colocation America",
  facility_label: "Colocation America NJDC1 (in-building at 100 Delawanna)",
  address: AddressListed {
    street: "100 Delawanna Avenue, Suite 200, Clifton, NJ 07014",
    citation: "colocationamerica.com New Jersey page, read 2026-08-18 (page fetched directly)",
  },
  municipality: "Clifton",
  region_code: "NJ",
  facility_note: "Retail reseller operating inside the Digital Realty EWR20 building (building rows under extdeps.colo.digital_realty). Sells 1U, 2U, 4U, quarter, half and full cabinets per its navigation and directory profiles read 2026-08-18 - the finest published retail granularity in the Clifton building.",
}

data colocation_america_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "quote form on colocationamerica.com",
  obligation: "Granularity is published but prices are not on the pages read 2026-08-18; per-U and quarter-cabinet quotes required.",
}

// A REGISTRY ENTRY THE OPERATOR'S OWN PAGES DO NOT CLAIM, so it is recorded here rather than
// carried as a facility row - the same treatment extdeps.colo.qts gives QTS Jersey City, and for
// the same reason: a row would assert a live site the operator does not.
//
// PeeringDB carries "NJDC2 - Colocation America Corporation" at 275 Hartz Way, Suite 1, Secaucus -
// the building this census already models as Equinix NY2. The operator's own New Jersey page and
// its locations index, both read 2026-09-09 from raw bytes, name ONE New Jersey site: 100 Delawanna
// Avenue, Clifton. Neither page contains the string "Secaucus" or "Hartz" at all. So the registry
// and the operator disagree, and the disagreement is the fact.
//
// WHAT MUST BE READ TO RESOLVE IT: whether Colocation America still sells from 275 Hartz Way. If it
// does, this becomes a facility row in the corridor; if it exited, the PeeringDB entry is what a
// later sweep will trip over, so record the resolution here rather than silently dropping it.
//
// THE EARLIER 403 ON THIS OPERATOR WAS MY CLIENT, NOT THEIR EDGE, and the correction matters
// because the row it justified was wrong in the flattering direction. Two fetches on 2026-09-08
// were refused, and the obligations below said the operator refused them. Re-fetching on 2026-09-09
// with an ordinary browser user-agent returned 200 and 178 KB. An operator that blocks readers and
// an operator whose pages I failed to reach are different facts, and only one of them is about the
// operator.
data colocation_america_cabinet_density: CabinetDensityClaim = DensityUnread {
  obligation: "THE PAGES WERE READ AND THEY PUBLISH NO DENSITY, which is a stronger and different fact from the refusal this obligation used to assert. The operator's New Jersey page and its locations index were fetched 2026-09-09 with an ordinary browser user-agent (HTTP 200, 178 KB) and read from raw bytes after tag-stripping; no per-cabinet kW figure appears for the one New Jersey site those pages name, 100 Delawanna Avenue in Clifton. The earlier 403 was this reader's client, not the operator's edge, so 'resolve by a route the operator's edge admits' was discharged by fixing the fetch and is withdrawn as an obligation. What remains to be read is a quote: ask what a cabinet at Clifton may draw. NJDC2 Secaucus is deliberately not named here - the operator's own pages do not claim that site at all, and the registry disagreement is recorded in the annotation above rather than carried as a density obligation for a facility this census does not model.",
}

data colocation_america_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "Read, not refused: the operator's New Jersey page and locations index were fetched 2026-09-09 with an ordinary browser user-agent (HTTP 200, 178 KB) and state no minimum footprint for the Clifton site. The 2026-08-18 pass recorded granularity as published without a wording, and no minimum-footprint sentence appears in the bytes read on 2026-09-09 either, so the grain stays unread against the operator's own surface rather than against a refusal. Resolve by asking the quote whether a single cabinet, or a fraction of one, is contractable at 100 Delawanna Avenue.",
}
