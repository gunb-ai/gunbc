data halsey_165_newark: extdeps.colo.types.ColoFacilityRow = extdeps.colo.types.ColoFacilityRow {
  operator_label: "165 Halsey Street (building colocation)",
  facility_label: "165 Halsey Street carrier hotel, Newark",
  address: extdeps.colo.types.AddressListed {
    street: "165 Halsey Street, Newark, NJ 07102",
    citation: "165halsey.com, read 2026-08-18",
  },
  municipality: "Newark",
  region_code: "NJ",
  facility_note: "The building's own carrier-neutral colocation business: a roughly 1.2 million square foot carrier hotel marketing over 80 MW, about 360,000 square feet of colocation, and direct access to sixty-plus networks per 165halsey.com read 2026-08-18. Other operators (Hivelocity under its own module; historically zColo, later DataBank) sell from suites in the same building - the building operator and the in-building resellers are separate upstream authorities.",
}

data halsey_165_cross_connect: extdeps.colo.types.CrossConnectFee = extdeps.colo.types.CrossConnectFee {
  monthly: std.measure.MoneyPerMonth { amount: std.measure.money_amount_micro(count: 0), currency: std.currency.Usd },
  install: std.measure.MoneyOnce { amount: std.measure.money_amount_micro(count: 500000000), currency: std.currency.Usd },
  fee_note: "No monthly recurring charge on cross-connects; 500 dollars non-recurring per install after capacity is in place. The zero-MRC cross-connect policy is the building's stated differentiator against metro incumbents.",
  citation: "165halsey.com connectivity page, read 2026-08-18",
}

