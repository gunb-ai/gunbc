module extdeps.colo.three_sixty_five

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, AddressUnread, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityUnread,
  RetailGrainStanding, RetailGrainUnread,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "365datacenters.com/facilities-network/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.three_sixty_five",
      decl_name: "three_sixty_five_facilities",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data three_sixty_five_note: NonEmptyStr = "365 Data Centers sells retail colocation from rack units through quarter and half cabinets per its company overview PDF (read 2026-08-18). Its footprint in this census carries the Atlantic Metro and Sungard Availability Services lineages: the small Weehawken site appears in directories as Atlantic Metro EWR1, and the Philadelphia floor at 1500 Spring Garden joined via the 2022 Sungard AS colocation sale. An InterServer expansion into a 365 New Jersey site is press-released (datacenterdynamics, read 2026-08-18), which is a live example of the operator hosting retail hosts."

data three_sixty_five_carlstadt: ColoFacilityRow = ColoFacilityRow {
  operator_label: "365 Data Centers",
  facility_label: "365 NJ3 Carlstadt",
  address: AddressListed {
    street: "410 Commerce Boulevard, Carlstadt, NJ 07072",
    citation: "datacenters.com 365 NJ3 profile and 365datacenters.com Carlstadt page, read 2026-08-18",
  },
  municipality: "Carlstadt",
  region_code: "NJ",
  facility_note: "Meadowlands-corridor retail site roughly ten miles west of Manhattan per the operator's page, read 2026-08-18.",
}

data three_sixty_five_bridgewater: ColoFacilityRow = ColoFacilityRow {
  operator_label: "365 Data Centers",
  facility_label: "365 NJ1 Bridgewater",
  address: AddressListed {
    street: "999 Frontier Road, Bridgewater, NJ 08807",
    citation: "365datacenters.com New Jersey data center page, read 2026-09-09 - the operator states 999 Frontier Rd, Bridgewater, NJ 08807 itself, which replaces the earlier directory-profile citation for the same street.",
  },
  municipality: "Bridgewater",
  region_code: "NJ",
  facility_note: "About 20 MW marketed per datacentermap, read 2026-08-18; roughly forty miles west of the Hudson waterfront, so it trades operator travel for suburban cost.",
}

// THE LAST CENTRAL-NEW-JERSEY FACILITY IN THE CENSUS WITHOUT THESE TWO FACTS, and it refuses on
// both. Two operator surfaces were read on 2026-09-09 - the New Jersey facility page and the
// operator's own Bridgewater cutsheet PDF - and neither carries a kilowatt figure of any kind:
// not per cabinet, not per rack, not per square foot. The page's power section names voltages
// (120V, 208V, 208V three-phase) and its cooling section names tonnage, which are the two facts
// operators publish INSTEAD of density and neither of which is one.
data three_sixty_five_bridgewater_density: CabinetDensityClaim = DensityUnread {
  obligation: "Neither the operator's New Jersey facility page nor its Bridgewater cutsheet PDF states any per-cabinet or per-rack kilowatt figure. Counted in RAW BYTES 2026-09-09, not through a tag-stripper, because a stripper was found elsewhere in this census to swallow 21 of 22 occurrences of a token and turn a miss into a finding. Page, 200,238 bytes, identical under no user-agent and a full browser one: positive controls chosen to be SUBJECT tokens - Bridgewater=18, the facility's own municipality, and 'New Jersey'=12 - establish that the instrument reached this facility's own surface rather than an index that was never going to carry the figure; kW=0, kVA=0, kilowatt=0, density=0, 'per cabinet'=0. Cutsheet PDF, text layer flattened of whitespace because its kerning splits words: controls Bridgewater=5 and cabinets=2; the same tokens all zero. An earlier check of this PDF reported a FAILING control and proceeded anyway on the assumption it was kerning - it was, but that was not known until the kern-tolerant control was actually run. Ask the quote for the marketed cabinet maximum. The 20 MW that directories attribute to this site is a building total and must not be read as a density, and neither may the cooling tonnage.",
}

// A CABINET INVENTORY IS NOT A RETAIL GRAIN, and this row exists to keep the two apart. The page
// says the facility CONTAINS nearly 300 cabinets; it does not say the operator will sell one. A
// count of cabinets in a building is a fact about the building, exactly as its megawatts are, and
// reading it as an offer would be the same move this census refuses on the density axis.
data three_sixty_five_bridgewater_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The operator's wording, identical on the New Jersey page and the Bridgewater cutsheet read 2026-09-09, is \"Nearly 300 combination-locking cabinets, custom cages and suites\" - a facility inventory bullet rather than a statement of what is sold at what minimum. No minimum commitment appears on either surface. Establish whether a single cabinet is sold before ranking this site.",
}

data three_sixty_five_weehawken: ColoFacilityRow = ColoFacilityRow {
  operator_label: "365 Data Centers",
  facility_label: "365 Weehawken (legacy Atlantic Metro EWR1)",
  address: AddressUnread {
    obligation: "Directories place a small 365 site in Weehawken at about 0.281 MW (datacentermap, read 2026-08-18) but no street address was captured; read the operator's facility sheet before treating this as a candidate.",
  },
  municipality: "Weehawken",
  region_code: "NJ",
  facility_note: "Smallest site in this census by marketed power; retained because it is inside the near-Jersey-City radius and the operator sells retail granularity.",
}

data three_sixty_five_philadelphia: ColoFacilityRow = ColoFacilityRow {
  operator_label: "365 Data Centers",
  facility_label: "365 PHL-1500 Philadelphia",
  address: AddressListed {
    street: "1500 Spring Garden Street, Philadelphia, PA 19130",
    citation: "datacenterhawk 365 PHL-1500 profile, read 2026-08-18",
  },
  municipality: "Philadelphia",
  region_code: "PA",
  facility_note: "Roughly 135,000 square feet with about 70,000 square feet of raised floor and 10 MW marketed per datacenterhawk, read 2026-08-18; multi-operator building shared with an H5 floor.",
}

data three_sixty_five_facilities: List<ColoFacilityRow> = [
  three_sixty_five_carlstadt,
  three_sixty_five_bridgewater,
  three_sixty_five_weehawken,
  three_sixty_five_philadelphia,
]

data three_sixty_five_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "365datacenters.com sales",
  obligation: "Company overview lists rack-unit, quarter and half cabinet products but publishes no prices (read 2026-08-18); quotes required per site.",
}
