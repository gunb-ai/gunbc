data three_sixty_five_nyc_density_unread: CabinetDensityClaim = DensityUnread {
  obligation: "The facilities-network map read 2026-09-08 is an address roster. Company caged-colocation pages name a high-density power tier at 6 kW-plus, which is a product tier not a per-site marketed maximum, so it is not copied onto these rows. Per-site density stays unread until a site cut sheet states a cabinet ceiling.",
}

data three_sixty_five_nyc_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "cabinets, racks, custom cages, and suites; high-density power (6kW+)",
  citation: "365datacenters.com caged-colocation page, read 2026-09-08",
}

data three_sixty_five_philadelphia_university_city: ColoFacilityRow = ColoFacilityRow {
  operator_label: "365 Data Centers",
  facility_label: "365 PH2 Philadelphia (University City)",
  address: AddressListed {
    street: "3701 Market Street, Philadelphia, PA 19104",
    citation: "365datacenters.com Philadelphia location page and Philadelphia data center page, read 2026-09-08",
  },
  municipality: "Philadelphia",
  region_code: "PA",
  facility_note: "20,500 square foot data center in the Penn Medicine science building in University City, with four 180 kW UPS modules and a 1,000 kW diesel generator and a stated 400 lb per square foot floor loading (read 2026-09-08). Materially smaller in power than the operator's Spring Garden floor, and the smaller of this census's two Philadelphia rows for this operator.",
}

data three_sixty_five_philadelphia_density: CabinetDensityClaim = DensityUnread {
  obligation: "365datacenters.com Philadelphia pages read 2026-09-08 publish no per-cabinet or per-rack density for the Spring Garden site. Request the facility spec sheet named on the page.",
}

data three_sixty_five_philadelphia_university_city_density: CabinetDensityClaim = DensityUnread {
  obligation: "365datacenters.com Philadelphia data center page read 2026-09-08 states four 180 kW UPS modules and a 1,000 kW generator for the 3701 Market site and NO per-cabinet density. UPS module kilowatts are room capacity and must not be divided into a cabinet figure. Raw-byte confirmed 2026-09-09 (HTTP 200, 200,372 bytes): the only two 'kW' occurrences in the served HTML are '4 x 180 kW' and 'Dedicated onsite 1000 kW', both plant. Request the downloadable facility specification the page references.",
}

data three_sixty_five_philadelphia_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The operator's company overview (read 2026-08-18) sells rack units, quarter and half cabinets, but neither Philadelphia page read 2026-09-08 states the grain for these two buildings specifically. The company-level product list is not carried onto the site rows, because which products a given floor sells is a per-site fact. Confirm per site with sales.",
}

data three_sixty_five_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Compact and Standard Cabinets, Two and Four-Post Racks, Custom Cages, Custom Suites",
  citation: "365datacenters.com colocation-services page, read 2026-09-08. Operator-level wording; it names no minimum footprint and is not stated per facility.",
}

data three_sixty_five_cabinet_density: CabinetDensityClaim = DensityUnread {
  obligation: "No per-cabinet or per-rack kW figure appears on the operator's colocation-services page or its Carlstadt facility page (both read 2026-09-08). The operator publishes a Carlstadt cutsheet PDF at 365datacenters.com/wp-content/uploads/2023/05/365_CUTSHEET_FINAL_CARLSTADT410_V3.pdf which was fetched 2026-09-08 and did not yield extractable text; that PDF is the specific artifact to read to resolve NJ3 Carlstadt, and the 235,500 sqft building figure is not a substitute for it.",
}
