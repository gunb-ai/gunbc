module extdeps.colo.digital_realty

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityUnread,
  RetailGrainStanding, SingleCabinetOffered, RetailGrainUnread,
  RetailGrainStanding, SingleCabinetOffered,
}
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityUnread, RetailGrainStanding, RetailGrainUnread }
  RetailGrainStanding, SingleCabinetOffered,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.digitalrealty.com/data-centers/americas/new-york"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.digital_realty",
      decl_name: "digital_realty_ewr10",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data digital_realty_ewr10: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty EWR10 Weehawken",
  address: AddressListed {
    street: "300 John F. Kennedy Boulevard East, Weehawken, NJ 07086",
    citation: "digitalrealty.com New York metro pages and UPSTACK profile, read 2026-08-18",
  },
  municipality: "Weehawken",
  region_code: "NJ",
  facility_note: "Roughly 370,000 square feet with about 14 MW per the profiles read 2026-08-18; the Digital Realty portion of the multi-operator 300 JFK Boulevard East building (Centersquare EWR2 under its own module). Legacy Telx NJR1 lineage. Interconnection-dense; walking distance to the Lincoln Harbor light-rail and ferry stops.",
}

data digital_realty_ewr20: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty EWR20 Clifton",
  address: AddressListed {
    street: "100 Delawanna Avenue, Clifton, NJ 07014",
    citation: "digitalrealty.com EWR20 page, read 2026-08-18",
  },
  municipality: "Clifton",
  region_code: "NJ",
  facility_note: "Seven-story roughly 183,000 square foot building with about 33 MW marketed per directory profiles read 2026-08-18; legacy Telx NJR2/NJR3 lineage. Multi-operator building: Colocation America resells retail space here under its own module.",
}

// THE PISCATAWAY CAMPUS, ABSENT FROM THE CENSUS UNTIL NOW. This operator was carried by its two
// Hudson-waterfront-adjacent buildings only, which read as though Digital Realty's New Jersey
// footprint stopped at Clifton. It does not: the campus below is in Middlesex County, and one of
// its two modelled buildings is larger than either northern site.
data digital_realty_ewr11: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty EWR11 Piscataway",
  address: AddressListed {
    street: "3 Corporate Place, Piscataway Township, NJ 08854",
    citation: "digitalrealty.com EWR11 page, read 2026-09-08",
  },
  municipality: "Piscataway",
  region_code: "NJ",
  facility_note: "Operator page (read 2026-09-08): 207,500 square feet across three stories, marketed as versatile and scalable colocation environments. The page states no critical IT load and no carrier list. Part of the operator's Piscataway campus alongside EWR12; a third building, EWR19, is named in campus material and has no readable operator page (see digital_realty_ewr19_obligation).",
}

data digital_realty_ewr11_density: CabinetDensityClaim = DensityUnread {
  obligation: "The EWR11 page read 2026-09-08 states no per-cabinet or per-rack kilowatt figure. Read the building's spec sheet or ask the quote for the marketed cabinet maximum. Do not read the campus square footage as a density.",
}

data digital_realty_ewr11_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The EWR11 page read 2026-09-08 names colocation environments without stating a minimum commitment. Its campus sibling EWR12 explicitly offers single cabinets, which is a fact about EWR12 and not about this building; establish EWR11's own minimum before assuming the campus sells uniformly.",
}

data digital_realty_ewr12: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty EWR12 Piscataway",
  address: AddressListed {
    street: "365 S. Randolphville Road, Piscataway Township, NJ 08854",
    citation: "digitalrealty.com EWR12 page, read 2026-09-08",
  },
  municipality: "Piscataway",
  region_code: "NJ",
  facility_note: "Operator page (read 2026-09-08): 323,000 square feet total building size, the largest Digital Realty building carried in this census. The page states no critical IT load. This is the address directory profiles attach to the legacy Atlantic Metro Piscataway facility, so a quote should establish who sells what at 365 S. Randolphville Road today - the same multi-operator-building question the census already carries for 300 JFK Boulevard East and 1 Enterprise Avenue N.",
}

data digital_realty_ewr12_density: CabinetDensityClaim = DensityUnread {
  obligation: "The EWR12 page read 2026-09-08 states no per-cabinet or per-rack kilowatt figure, only building square footage. Read the spec sheet or ask the quote. The 323,000 square feet is a fact about the building and must not be read as a density.",
}

// THE ONLY DIGITAL REALTY BUILDING IN THIS CENSUS THAT STATES ITS RETAIL GRAIN, and it flatly
// contradicts the operator-level rate note below, which had recorded a lean toward interconnection
// and multi-cabinet deployments. A single-cabinet offer is published for this building; whether it
// is published for the others is unread rather than answered by this one.
data digital_realty_ewr12_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "From single cabinets to full suites, we have space solutions as diverse as your needs.",
  citation: "digitalrealty.com EWR12 page, read 2026-09-08",
}


// A THIRD BUILDING ON THIS CAMPUS THAT CONTRIBUTES NO ROW. Digital Realty campus material names
// EWR19 alongside the two buildings above. The operator page under the EWR19 path on the same URL
// pattern that serves EWR11 and EWR12 returned HTTP 404 on 2026-09-08, so no address, size, density
// or grain is readable and no row is written from the campus material alone. This operator's
// Piscataway campus is therefore modelled at two buildings of three, and the missing one needs a
// live page or a spec sheet rather than an inference from its siblings.
data digital_realty_jfk10: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty JFK10",
  address: AddressListed {
    street: "111 8th Avenue, New York, NY 10011",
    citation: "digitalrealty.com JFK10 page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "15-story 111,000 square foot carrier hotel floorplate with N+1 UPS and cooling per the operator page read 2026-09-08. Markets New York's first Quantum-AI colocation (OQC plus NVIDIA) inside the same building Equinix NY9 and DataBank LGA2 also sell from - distinct operator rows, one building.",
}

data digital_realty_jfk10_density: CabinetDensityClaim = DensityUnread {
  obligation: "The JFK10 page read 2026-09-08 publishes building size and UPS redundancy but no per-cabinet kilowatt ceiling.",
}

data digital_realty_jfk10_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "From single cabinets to private data center suites",
  citation: "digitalrealty.com JFK10 page, read 2026-09-08",
}

data digital_realty_jfk12: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty JFK12",
  address: AddressListed {
    street: "60 Hudson Street, New York, NY 10013",
    citation: "digitalrealty.com JFK12 page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "24-story 163,500 square foot presence in the 60 Hudson carrier hotel with N+1 UPS and cooling per the operator page read 2026-09-08. DataBank LGA1 and Colocation America NYDC1 sell from the same building under their own modules.",
}

data digital_realty_jfk12_density: CabinetDensityClaim = DensityUnread {
  obligation: "The JFK12 page read 2026-09-08 names multi-megawatt suites through single cabinet deployments as a product range but states no marketed kilowatts per cabinet.",
}

data digital_realty_jfk12_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "From multi-megawatt suites to single cabinet deployments",
  citation: "digitalrealty.com JFK12 page, read 2026-09-08",
}

data digital_realty_jfk13: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty JFK13",
  address: AddressListed {
    street: "32 Avenue of the Americas, New York, NY 10013",
    citation: "digitalrealty.com JFK13 page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "27-story 132,500 square foot multi-floor colocation in the 32 Avenue of the Americas carrier hotel per the operator page read 2026-09-08. CoreSite NY1 occupies the same building under its own module.",
}

data digital_realty_jfk13_density: CabinetDensityClaim = DensityUnread {
  obligation: "The JFK13 page read 2026-09-08 publishes building size and redundancy, not a per-cabinet density.",
}

data digital_realty_jfk13_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "From single cabinets to private data center suites",
  citation: "digitalrealty.com JFK13 page, read 2026-09-08",
}

data digital_realty_facilities: List<ColoFacilityRow> = [
  digital_realty_ewr10,
  digital_realty_ewr20,
  digital_realty_ewr11,
  digital_realty_ewr12,
  digital_realty_jfk10,
  digital_realty_jfk12,
  digital_realty_jfk13,
]

data digital_realty_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "digitalrealty.com sales",
  obligation: "No published cabinet pricing on pages read 2026-08-18. Digital Realty's retail motion in this metro leans to interconnection and multi-cabinet deployments; single-cabinet terms need a quote and may route to a reseller.",
}

// EWR10 IS NO LONGER IN THIS OPERATOR'S FOOTPRINT, and two independent surfaces say so on
// 2026-09-08. The operator's own New York and New Jersey page enumerates seven facilities - EWR11
// and EWR12 in Piscataway, EWR20 and EWR21 in Clifton, JFK10, JFK12 and JFK13 in Manhattan - and
// 300 Boulevard East, Weehawken is not among them. The operator-maintained PeeringDB entry for the
// same address is titled "Digital Realty New Jersey EWR10 (closed)". The row above is KEPT as the
// reading it was on 2026-08-18 rather than deleted, per the module doctrine that a withdrawn offer
// is recorded by a withdrawal note and not by erasing the history; but no quote should be sought
// for EWR10, and the Weehawken building at 300 JFK Boulevard East is reachable in this census
// through Centersquare EWR2-A,B, which is still listed by its operator.
// EWR10 Weehawken is absent from digitalrealty.com's New York/New Jersey facility list read
// 2026-09-08 and is marked (closed) on its PeeringDB facility entry read the same day. Treat the
// EWR10 row as history. The Clifton pair EWR20 and EWR21 and the Piscataway pair EWR11 and EWR12
// are the operator's live New Jersey sites, none of which is in the Hudson-Bergen-Essex corridor.

data digital_realty_cabinet_density: CabinetDensityClaim = DensityUnread {
  obligation: "The operator's New York and New Jersey facility list, read 2026-09-08, publishes no per-cabinet or per-rack kW figure for any facility; it publishes a 133.5k square-foot colocation footprint, which is a portfolio fact and not a density. Resolve per facility from a spec sheet or a quote.",
}

data digital_realty_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "No cabinet-versus-cage minimum is stated on the operator's New York and New Jersey pages read 2026-09-08. Ask the quote whether a single cabinet is contractable at EWR20 Clifton, the nearest live site to this corridor.",
}
