module extdeps.colo.digital_realty



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.digitalrealty.com/data-centers/americas/new-york"
  }
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.colo.digital_realty",
      decl_name: "digital_realty_ewr10",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data digital_realty_ewr10: extdeps.colo.types.ColoFacilityRow = extdeps.colo.types.ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty EWR10 Weehawken",
  address: extdeps.colo.types.AddressListed {
    street: "300 John F. Kennedy Boulevard East, Weehawken, NJ 07086",
    citation: "digitalrealty.com New York metro pages and UPSTACK profile, read 2026-08-18",
  },
  municipality: "Weehawken",
  region_code: "NJ",
  facility_note: "Roughly 370,000 square feet with about 14 MW per the profiles read 2026-08-18; the Digital Realty portion of the multi-operator 300 JFK Boulevard East building (Centersquare EWR2 under its own module). Legacy Telx NJR1 lineage. Interconnection-dense; walking distance to the Lincoln Harbor light-rail and ferry stops.",
}

data digital_realty_ewr20: extdeps.colo.types.ColoFacilityRow = extdeps.colo.types.ColoFacilityRow {
  operator_label: "Digital Realty",
  facility_label: "Digital Realty EWR20 Clifton",
  address: extdeps.colo.types.AddressListed {
    street: "100 Delawanna Avenue, Clifton, NJ 07014",
    citation: "digitalrealty.com EWR20 page, read 2026-08-18",
  },
  municipality: "Clifton",
  region_code: "NJ",
  facility_note: "Seven-story roughly 183,000 square foot building with about 33 MW marketed per directory profiles read 2026-08-18; legacy Telx NJR2/NJR3 lineage. Multi-operator building: Colocation America resells retail space here under its own module.",
}

data digital_realty_facilities: List<extdeps.colo.types.ColoFacilityRow> = [digital_realty_ewr10, digital_realty_ewr20]

data digital_realty_retail_rates: extdeps.colo.types.RetailRateStanding = extdeps.colo.types.RatesQuoteOnly {
  contact_route: "digitalrealty.com sales",
  obligation: "No published cabinet pricing on pages read 2026-08-18. Digital Realty's retail motion in this metro leans to interconnection and multi-cabinet deployments; single-cabinet terms need a quote and may route to a reseller.",
}
