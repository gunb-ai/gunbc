  },
  municipality: "Breinigsville",
  region_code: "PA",
  facility_note: "Purpose-built Lehigh Valley site on the TEK Park campus; the operator publishes a spec sheet PDF for it.",
}

data tierpoint_bethlehem: ColoFacilityRow = ColoFacilityRow {
  operator_label: "TierPoint",
  facility_label: "TierPoint Bethlehem",
