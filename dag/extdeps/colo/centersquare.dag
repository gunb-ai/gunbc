module extdeps.colo.centersquare

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityUnread, RetailGrainStanding, SingleCabinetOffered, NoPublishedSurface }

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.csquare.com/data-centers/new-york-new-jersey"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.centersquare",
      decl_name: "centersquare_weehawken",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data centersquare_lineage_note: NonEmptyStr = "Centersquare (marketed Csquare) is the operator formed from the Cyxtera colocation estate after Cyxtera's 2023 bankruptcy sale; the Weehawken campus appears in older directories under Cyxtera EWR2 and originally CenturyLink/Savvis. One upstream entity, three historical names - recorded so a reader reconciling directories does not count three operators."

data centersquare_weehawken: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Centersquare",
  facility_label: "Centersquare EWR2 A/B/E Weehawken campus",
  address: AddressListed {
    street: "300 J.F. Kennedy Boulevard East, Weehawken, NJ 07086",
    citation: "Inflect and datacenters.com Centersquare EWR2 profiles, read 2026-08-18",
  },
  municipality: "Weehawken",
  region_code: "NJ",
  facility_note: "Directory profiles read 2026-08-18 describe the 300 JFK Boulevard East building at roughly 802,000 square feet with about 105 MW marketed across its operators, 2N UPS and N+1 cooling on the Centersquare floors, roughly 32 on-site network providers, and colocation sold as secure cabinets and cages beside DIA and bare-metal products. Digital Realty EWR10 occupies the same building under its own module.",
}

data centersquare_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "sales contact via csquare.com",
  obligation: "No cabinet pricing published on the pages read 2026-08-18; single-cabinet retail is sold but priced by quote.",
}

// A THIRD CORRIDOR SITE FROM THIS OPERATOR, missed in 2026-08-18 because the census took the
// Weehawken campus and stopped. The operator's own New York/New Jersey index (read 2026-09-08)
// names three sites: Weehawken EWR2, Piscataway EWR3, and Secaucus EWR5. EWR5 is in the corridor
// and is modelled here; EWR3 is Middlesex County and is out of this pass's region.
data centersquare_ewr5_secaucus: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Centersquare",
  facility_label: "Centersquare EWR5 Secaucus",
  address: AddressListed {
    street: "15 Enterprise Avenue N, Secaucus, NJ 07094",
    citation: "PeeringDB facility Centersquare New Jersey (EWR5), read 2026-09-08; the operator's own csquare.com New York/New Jersey index names the Secaucus EWR5 site but prints no street address",
  },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Operator index read 2026-09-08: 59,572 sqft of raised floor. One street north of Evocative EWR1 and Summit at 1 Enterprise Avenue N, so the Enterprise Avenue block now carries three selling surfaces in this census.",
}

// THE TRAP THIS CARRIER EXISTS FOR, caught in the wild. The operator's index states, for Secaucus,
// "Standard cage density: Up to 300W/sq. ft." A watt-per-square-foot figure is a room fact: turning
// it into a cabinet figure requires assuming how many square feet a cabinet is allotted, which the
// operator does not state and this census will not invent. So the density is UNREAD and the
// operator's actual sentence is preserved in the obligation for whoever resolves it.
data centersquare_cabinet_density: CabinetDensityClaim = DensityUnread {
  cause: NoPublishedSurface {
    obligation: "csquare.com New York/New Jersey index, read 2026-09-08, publishes for Secaucus \"Standard cage density: Up to 300W/sq. ft.\" and no per-cabinet or per-rack kW figure for any of EWR2, EWR3 or EWR5. Watts per square foot is not cabinet density and may not be converted into one here. Resolve by asking each facility for its air-cooled per-cabinet maximum.",
  },
}

data centersquare_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Secure Cabinets and dedicated Secure Cages, including half and full cabinet colocation",
  citation: "Centersquare EWR2 Weehawken campus description, read 2026-09-08. Read for the Weehawken campus; whether the same half-cabinet grain is sold at EWR5 Secaucus is not separately stated.",
}
