module extdeps.colo.h5

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityUnread,
  RetailGrainStanding, SingleCabinetOffered,
}
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityUnread, RetailGrainStanding, RetailGrainUnread }

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "h5datacenters.com/new-jersey-colocation.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.h5",
      decl_name: "h5_secaucus",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data h5_secaucus: ColoFacilityRow = ColoFacilityRow {
  operator_label: "H5 Data Centers",
  facility_label: "H5 New Jersey (Secaucus)",
  address: AddressListed {
    street: "200B Meadowlands Parkway, Secaucus, NJ 07094",
    citation: "h5datacenters.com New Jersey pages and datacentermap profile, read 2026-08-18",
  },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Retail colocation operator; the profile read 2026-08-18 lists roughly 38,000 square feet and 5 MW at the Secaucus site, marketed Tier III. Sits on the same Meadowlands Parkway corridor as InterServer TEB2.",
}

data h5_philadelphia: ColoFacilityRow = ColoFacilityRow {
  operator_label: "H5 Data Centers",
  facility_label: "H5 Philadelphia (1500 Spring Garden, 5th floor)",
  address: AddressListed {
    street: "1500 Spring Garden St., Suite 520, Philadelphia, PA 19130",
    citation: "h5datacenters.com Philadelphia data center page, read 2026-09-08. The 2026-08-18 sweep carried this address from a directory profile as '5th Floor'; the operator's own page states Suite 520, and the operator is the authority for its own address.",
  },
  municipality: "Philadelphia",
  region_code: "PA",
  facility_note: "H5 floor in the multi-operator 1500 Spring Garden building (the former vXchnge footprint, roughly 72,000 square feet); 365 Data Centers also operates in the same building under its own module.",
}

data h5_nyc_325_hudson: ColoFacilityRow = ColoFacilityRow {
  operator_label: "H5 Data Centers",
  facility_label: "H5 New York (325 Hudson)",
  address: AddressListed {
    street: "325 Hudson Street, New York, NY 10013",
    citation: "h5datacenters.com New York colocation page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "Operator page read 2026-09-08: 240,000 square feet a few blocks from 60 Hudson; 40-plus on-net networks; DE-CIX New York and NetIX; 100 percent uptime claimed since 2012. 365 Data Centers lists a 9th-floor-west POP in the same building under its own module. Building square footage is not cabinet density.",
}

data h5_nyc_325_hudson_density: CabinetDensityClaim = DensityUnread {
  obligation: "The New York colocation page read 2026-09-08 names A/B UPS, N+1 generators and in-row cooling, not a marketed kilowatts-per-cabinet figure. Do not read 240,000 square feet as density.",
}

data h5_nyc_325_hudson_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "private suites, secure cages and individual cabinets",
  citation: "h5datacenters.com New York colocation page, read 2026-09-08",
}

data h5_facilities: List<ColoFacilityRow> = [h5_secaucus, h5_philadelphia, h5_nyc_325_hudson]

data h5_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "quote request via h5datacenters.com",
  obligation: "No cabinet or power pricing published on the pages read 2026-08-18; a written quote for the reference load is required.",
}

// BOTH FIELDS UNREAD FROM BOTH OF THE OPERATOR'S OWN PAGES. The Secaucus facility page and the
// New Jersey colocation page were fetched separately on 2026-09-08; between them they carry a
// building size, a redundancy topology and a diesel runtime, and neither a cabinet density nor a
// minimum footprint. A directory profile asserts individual cabinets are available at this site;
// that is a secondary claim about an operator's commercial policy and is not promoted to a reading.
data h5_secaucus_density: CabinetDensityClaim = DensityUnread {
  obligation: "h5datacenters.com new-jersey-data-center and new-jersey-colocation pages, both read 2026-09-08: no per-cabinet or per-rack kW figure, and no watts-per-square-foot figure either. The 38,000 SF Tier III figure is a building fact. Resolve by quote for 200B Meadowlands Parkway.",
}

data h5_secaucus_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "Neither H5 page read 2026-09-08 states whether space is sold as individual cabinets, cages or suites. A directory profile claims individual cabinets are offered; confirm with the operator before treating this site as reachable at cabinet grain, because H5's stated motion elsewhere in its portfolio is wholesale.",
// THE PHILADELPHIA FLOOR PUBLISHES ITS PLANT AND NOT ITS CABINET. 72,000 square feet and 7.5 MW of
// generator backup are stated by the operator; a per-cabinet figure is not, and the megawatts are
// a building fact that says nothing about what one cabinet may draw.
data h5_philadelphia_density: CabinetDensityClaim = DensityUnread {
  obligation: "h5datacenters.com Philadelphia page, read 2026-09-08, states 72,000 SF and 7.5 MW generator backup and NO per-cabinet or per-rack density. The absence is raw-byte confirmed: a curl fetch on 2026-09-09 (HTTP 200, 68,972 bytes) contains ZERO case-insensitive occurrences of 'kw' anywhere in the served HTML. Request the facility spec sheet or a quote naming the cabinet draw.",
}

data h5_philadelphia_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Customers can license cages and cabinets",
  citation: "h5datacenters.com Philadelphia data center page, read 2026-09-08; the phrase occurs verbatim in the raw served HTML re-fetched 2026-09-09 (HTTP 200, 68,972 bytes), inside one <p> under the h1 'Philadelphia Data Center Overview' with no promotional banner above it.",
}
