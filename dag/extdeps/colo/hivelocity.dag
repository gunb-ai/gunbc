module extdeps.colo.hivelocity

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, AddressUnread, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityUnread,
  RetailGrainStanding, RetailGrainUnread,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.datacenters.com/hivelocity-jfk1-newark-nj"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.hivelocity",
      decl_name: "hivelocity_jfk1",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data hivelocity_jfk1: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Hivelocity",
  facility_label: "Hivelocity JFK1 (in-building at 165 Halsey)",
  address: AddressListed {
    street: "165 Halsey Street, Floor 9, Suite 9053, Newark, NJ 07102",
    citation: "datacenters.com Hivelocity JFK1 profile, read 2026-08-18",
  },
  municipality: "Newark",
  region_code: "NJ",
  facility_note: "Dedicated-server and colocation host operating a suite inside the 165 Halsey carrier hotel (building modeled under extdeps.colo.halsey_165). Useful as a smaller-commitment retail route into the same meet-me rooms.",
}

data hivelocity_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "phone per the directory profile, read 2026-08-18",
  obligation: "Hivelocity publishes instant pricing for dedicated servers but its Newark colocation is quote-only on the pages read 2026-08-18.",
}

// A ROCKLAND COUNTY PRESENCE THIS OPERATOR ACQUIRED RATHER THAN BUILT, and the acquisition is why
// the census nearly missed it. The Orangeburg facility marketed by ColoHouse at 1 Ramland Road -
// the building 1547 operates as ORNY1 (extdeps.colo.critical_systems_realty) - now answers as
// Hivelocity: colohouse.com/data-centers/new-york/ returns a 301 permanent redirect to
// hivelocity.net (read 2026-09-08), so the ColoHouse rows a directory still shows are this
// operator's rows. Hivelocity's own location list names OGB1 Orangeburg as a CORE site.
data hivelocity_ogb1_orangeburg: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Hivelocity",
  facility_label: "Hivelocity OGB1 Orangeburg (legacy ColoHouse)",
  address: AddressUnread {
    obligation: "Hivelocity's location list names OGB1 Orangeburg but publishes no street address for it (read 2026-09-08). The predecessor ColoHouse marketed 1 Ramland Road, Orangeburg with roughly 15,000 square feet and over 1 MW; that is a pre-acquisition claim from a press release, not a current operator reading, and the building it names is 1547's ORNY1. Confirm the street address and whether the suite survived the acquisition.",
  },
  municipality: "Orangeburg",
  region_code: "NY",
  facility_note: "Rockland County, in-building retail on the same pattern as this operator's JFK1 suite at 165 Halsey. It is the only route found in this survey by which a Rockland County cabinet might be bought from a host with published dedicated-server pricing rather than from a multi-megawatt landlord.",
}

data hivelocity_ogb1_density: CabinetDensityClaim = DensityUnread {
  obligation: "No per-cabinet power figure appears on hivelocity.net's location list or data-center pages for OGB1 (read 2026-09-08). The landlord's ORNY1 page claims 10 kW+ per cabinet for the building; a landlord's building claim is not this tenant's sellable density and is not transferred here.",
}

data hivelocity_ogb1_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "Hivelocity's location list marks OGB1 as offering dedicated servers, while its NYC1 entry additionally names colocation (read 2026-09-08). Whether a colocation cabinet is sellable at OGB1 at all is therefore genuinely open, and reading the NYC1 product set onto OGB1 would be exactly the peer-site inference this census refuses.",
}
