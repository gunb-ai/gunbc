module extdeps.colo.summit

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityUnread, RetailGrainStanding, SingleCabinetOffered }

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "summithq.com/data-centers/secaucus-new-jersey-data-center/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.summit",
      decl_name: "summit_secaucus",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data summit_provenance_note: NonEmptyStr = "Summit (summithq.com) markets a Secaucus, NJ data center, read 2026-08-18. Every infrastructure figure below is the operator page's own claim. See summit_evocative_shared_address_note: the street address and the equipment fingerprint on this page match Evocative EWR1's, and neither operator's page mentions the other, so which operator sells what in the building on a given day is a quote question, not a fact this module can carry."

data summit_secaucus: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Summit",
  facility_label: "Summit Secaucus",
  address: AddressListed {
    street: "1 Enterprise Avenue N, Secaucus, NJ 07094",
    citation: "summithq.com Secaucus data center page, read 2026-08-18",
  },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Operator page (read 2026-08-18): 101.5k sqft; 20 MW expandable with 5 MW provisioned; four 1.4 MW UPS units in N+1; four 2 MW diesel generators; four 400-ton chillers in N+1; VRLA battery backup rated ten minutes at full load; two diverse entrance vaults; carriers listed AT&T, Verizon, Zayo, NTT, Lumen, Cogent, Comcast, Lightpath; SOC 2 Type II, SOC 3, PCI-DSS, HIPAA, HECVAT claimed. Private suites and custom deployments named; single-cabinet retail grain not stated.",
}

data summit_evocative_shared_address_note: NonEmptyStr = "Summit's page lists 1 Enterprise Avenue N, Secaucus - the same street address directory sources give for Evocative EWR1 - and the two operators' infrastructure claims are a near-exact fingerprint match (four 1.4 MW UPS units, four 2 MW generators, four 400-ton N+1 chillers, ~101.5k vs ~105k sqft). Neither page names the other, and no acquisition or sublease relationship was readable from either surface on 2026-08-18. One building appears to stand behind both selling surfaces, on the 300 JFK Blvd East Weehawken pattern (Digital Realty and Centersquare). The RFQ to either operator must ask who operates the facility today and who the colocation contract is actually with."

data summit_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "contact form via summithq.com",
  obligation: "No pricing is published on any page read 2026-08-18, and the page markets suites and custom deployments rather than per-cabinet retail. The quote must establish whether a small reversible footprint (2U to one cabinet) is sold at all, and who the contracting operator at 1 Enterprise Avenue N is.",
}

// THE DENSITY I REPORTED HERE IS WITHDRAWN, AND THE RAW BYTES ARE WHAT WITHDREW IT. Two rendered
// reads of the operator's colocation product page gave me "12 kW of 2x 208V/50A A+B redundant
// power in a 42U configuration" and I recorded it as this corridor's second read density. Fetching
// the same URL as bytes on 2026-09-09 - which is what the fleet-wide verification rule asks for -
// reproduced that string exactly AND showed what sits immediately above it: a promotional block
// headed "Limited Time: Chicago-Area Facility". The 5 kW Standard and 12 kW High-Density packages
// are inside that block, under its "Valid for new customers only" terms.
//
// So the figure is real, published, and about a facility in another metro. Reading it as a Secaucus
// cabinet density would be the peer-facility inference this carrier exists to make unwritable - the
// same error as carrying Hivelocity's Orangeburg 20 kW to Newark, arrived at by a subtler route,
// because here the two facilities share one operator and one page rather than two pages. A
// rendered capture cannot show you the banner a figure sits under; only the byte order can.
data summit_secaucus_density: CabinetDensityClaim = DensityUnread {
  obligation: "summithq.com publishes exactly two per-cabinet kW figures - \"42U rack space 5 kW of 208V/30A A+B redundant power\" at 1,600 USD a month and \"42U rack space 12 kW of 2x 208V/50A A+B redundant power\" at 3,600 USD a month, both confirmed in raw bytes 2026-09-09 - and both sit inside a promotional block headed \"Limited Time: Chicago-Area Facility\". Neither is stated for Secaucus, and summithq.com's Secaucus facility page read 2026-09-08 states no per-cabinet figure at all. Resolve by asking whether the High-Density package is orderable at 1 Enterprise Avenue N and at what price; if it is, this becomes the corridor's first PRICED dense cabinet and the answer matters more than any other quote in this census.",
}

// AND THE PRICED PACKAGES ARE RECORDED WITHOUT BEING CLAIMED FOR THIS CORRIDOR. They are the
// densest priced colocation product this census has seen anywhere - 12 kW in one 42U cabinet, where
// the densest priced product previously modelled in the metro is InterServer's 2,500 W across 20U -
// so the reading is worth keeping even though the facility it applies to is out of region. It is
// deliberately NOT a RetailPlanRow: a plan row here would assert this operator sells that plan at
// its modelled facility, which is the thing the banner says it does not.
data summit_chicago_area_package_note: NonEmptyStr = "Read from raw bytes 2026-09-09 under the banner \"Limited Time: Chicago-Area Facility\": Standard Colo Package, 1,600 USD a month, 42U rack space, 5 kW of 208V/30A A+B redundant power, 100 Mbps unmetered bandwidth, 1 carrier cross-connect, 2 managed PDUs, free 1 hr/month basic remote hands, free setup and installation. High-Density Colo Package, 3,600 USD a month, same specification but 12 kW of 2x 208V/50A A+B redundant power. Both marked valid for new customers only. Whoever models the Chicago metro owns these as plan rows; they are held here as a note because this module's facility is Secaucus and no page ties these prices to it."

// AND THIS SUPERSEDES THE 2026-08-18 READING OF THE GRAIN. The facility page's suites-and-custom
// wording, which the facility note above records, made this operator look cage-or-suite only. The
// product page sells quarter, third, half and full 42U cabinets, which is finer than a cabinet and
// makes Summit retail-grain relevant after all. Two surfaces of one operator disagreed in emphasis;
// the one that names orderable units wins, and the disagreement is why both are cited.
data summit_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "High-Density Cabinets: 1/4, 1/3, 1/2, or full 42U configurations to match your current density and room to grow",
  citation: "summithq.com services/data-center-services/colocation page, confirmed in raw bytes 2026-09-09. Unlike the priced packages, this sentence is in the page's Flexible Solutions section and carries no facility banner, so it reads as an operator-level grain rather than one metro's promotion. The same operator's Secaucus facility page, read 2026-09-08, markets \"Private suites and custom deployments\" and names no cabinet grain; the product page is the one that enumerates orderable units.",
}
