module extdeps.colo.summit

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityMarketedAirOnly, RetailGrainStanding, SingleCabinetOffered }

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "summithq.com/data-centers/secaucus-new-jersey-data-center/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.summit",
      decl_name: "summit_secaucus",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data summit_provenance_note: NonEmptyStr = "Summit (summithq.com) markets a Secaucus, NJ data center, read 2026-08-18. Every infrastructure figure below is the operator page's own claim. See summit_evocative_shared_address_note: the street address and the equipment fingerprint on this page match Evocative EWR1's, and neither operator's page mentions the other, so which operator sells what in the building on a given day is a quote question, not a fact this module can carry."

data summit_secaucus: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Summit",
  facility_label: "Summit Secaucus",
  address: AddressListed {
    street: "1 Enterprise Avenue N, Secaucus, NJ 07094",
    citation: "summithq.com Secaucus data center page, read 2026-08-18",
  },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Operator page (read 2026-08-18): 101.5k sqft; 20 MW expandable with 5 MW provisioned; four 1.4 MW UPS units in N+1; four 2 MW diesel generators; four 400-ton chillers in N+1; VRLA battery backup rated ten minutes at full load; two diverse entrance vaults; carriers listed AT&T, Verizon, Zayo, NTT, Lumen, Cogent, Comcast, Lightpath; SOC 2 Type II, SOC 3, PCI-DSS, HIPAA, HECVAT claimed. Private suites and custom deployments named; single-cabinet retail grain not stated.",
}

data summit_evocative_shared_address_note: NonEmptyStr = "Summit's page lists 1 Enterprise Avenue N, Secaucus - the same street address directory sources give for Evocative EWR1 - and the two operators' infrastructure claims are a near-exact fingerprint match (four 1.4 MW UPS units, four 2 MW generators, four 400-ton N+1 chillers, ~101.5k vs ~105k sqft). Neither page names the other, and no acquisition or sublease relationship was readable from either surface on 2026-08-18. One building appears to stand behind both selling surfaces, on the 300 JFK Blvd East Weehawken pattern (Digital Realty and Centersquare). The RFQ to either operator must ask who operates the facility today and who the colocation contract is actually with."

data summit_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "contact form via summithq.com",
  obligation: "No pricing is published on any page read 2026-08-18, and the page markets suites and custom deployments rather than per-cabinet retail. The quote must establish whether a small reversible footprint (2U to one cabinet) is sold at all, and who the contracting operator at 1 Enterprise Avenue N is.",
}

// A READ DENSITY, AND THE ONLY ONE IN THIS CORRIDOR THAT ARRIVES ATTACHED TO A PRODUCT. The
// operator's colocation product page markets a High-Density Cabinet at 12 kW delivered as two
// 208V/50A A+B redundant feeds in a 42U cabinet. That is a per-cabinet figure on the operator's own
// page, so it is READ - with two honesty marks kept beside it. It is an OPERATOR-LEVEL product
// claim: the Secaucus facility page read the same day states no density, so whether the 12 kW
// cabinet is orderable at 1 Enterprise Avenue N specifically is a quote question. And 12 kW is the
// PRODUCT figure, not a hall maximum; a request for more is a different conversation.
data summit_high_density_cabinet: CabinetDensityClaim = DensityMarketedAirOnly {
  air_cooled_kw: 12,
  claim_wording: "High-Density Cabinets: 12 kW of 2x 208V/50A A+B redundant power in a 42U configuration",
  citation: "summithq.com services/data-center-services/colocation page, read 2026-09-08. Operator product page, not the Secaucus facility page - summithq.com's Secaucus page, read the same day, states no per-cabinet figure.",
}

// AND THIS SUPERSEDES THE 2026-08-18 READING OF THE GRAIN. The facility page's suites-and-custom
// wording, which the facility note above records, made this operator look cage-or-suite only. The
// product page sells quarter, third, half and full 42U cabinets, which is finer than a cabinet and
// makes Summit retail-grain relevant after all. Two surfaces of one operator disagreed in emphasis;
// the one that names orderable units wins, and the disagreement is why both are cited.
data summit_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "1/4, 1/3, 1/2, or full 42U configurations to match your current density and room to grow",
  citation: "summithq.com services/data-center-services/colocation page, read 2026-09-08. The same operator's Secaucus facility page, read the same day, markets \"Private suites and custom deployments\" and names no cabinet grain; the product page is the one that enumerates orderable units.",
}
