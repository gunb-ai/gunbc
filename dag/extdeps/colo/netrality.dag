module extdeps.colo.netrality

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.algebra { FreeSemigroup }
import std.measure { watt }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityPublished, PublishedDensityFigure, PublishedRealPower,
  FigureVerificationStanding, WordingVerbatim,
  CoolingMediumStanding, CoolingMediumUnspecified,
  PublishedPowerQuantity, MarketedAtMost,
  RetailGrainStanding, SingleCabinetOffered,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "netrality.com/data-center/401-north-broad-philadelphia/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.netrality",
      decl_name: "netrality_401_n_broad",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data netrality_401_n_broad: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Netrality Data Centers",
  facility_label: "Netrality 401 North Broad, Philadelphia",
  address: AddressListed {
    street: "401 North Broad Street, Philadelphia, PA 19108",
    citation: "netrality.com 401 North Broad pages, read 2026-08-18",
  },
  municipality: "Philadelphia",
  region_code: "PA",
  facility_note: "Philadelphia's principal carrier hotel: roughly 1.3 million square feet with about 283,000 square feet of raised floor per directory profiles read 2026-08-18; retail cabinets and cages beside wholesale; 73-plus networks, several exchanges, AWS and Google cloud on-ramps claimed by the operator. The eastern-PA anchor row of this census.",
}

data netrality_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "netrality.com sales",
  obligation: "No published cabinet pricing on pages read 2026-08-18.",
}

// THE DENSEST READ CABINET IN PENNSYLVANIA IN THIS CENSUS, AND THE ONLY ONE IN PHILADELPHIA. The
// 2026-08-18 sweep carried this facility with no density at all; the operator publishes one, and
// it is 30 kW - twelve times the 2.5 kW that every PRICED plan in the census tops out at, and the
// same figure Iron Mountain NJE-1 markets across the river. Read against a fleet drawing 650 W per
// node, one such cabinet holds the whole fleet with room over, so the constraint moves off density
// entirely and onto what a 30 kW cabinet costs - which this operator does not publish.
// THE MEDIUM CHANGED IN THE CARRIER MIGRATION AND THE PAGE DID NOT. This row carried the air-only arm,
// and its citation used to state the reason in the evidence payload itself: that no liquid-cooled
// figure was stated, so the air-only arm carried it. That sentence is DELETED rather than merely
// contradicted here, because a reader or renderer quoting the citation would otherwise still be told
// the retracted inference. That inference is the defect the medium coordinate exists to remove - ABSENCE OF A
// LIQUID FIGURE DOES NOT ESTABLISH AIR-COOLED CAPABILITY, and it fails in the admitting direction, so a
// 30 kW electrical claim would have satisfied a requirement for a 30 kW AIR-COOLED cabinet on evidence
// that never mentioned cooling. The page says "Cabinet density up to 30kW" and names no medium; the row
// now says the same. Nothing about the reading changed - the figure, the wording, the byte-level
// verification and the "up to" ceiling are all exactly as read. Only the inference is gone.
data netrality_401_n_broad_density: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumUnspecified,
      quantity: MarketedAtMost { upper: PublishedRealPower { power: watt(count: 30000) } },
      wording: "Cabinet density up to 30kW",
      citation: "netrality.com Philadelphia colocation page, read 2026-09-08 and RE-READ AS RAW BYTES 2026-09-09 (curl, HTTP 200, 757,846 bytes) under a subject control: 'Philadelphia' occurs 57 times and 'cabinet' 20 times, so the instrument reached this facility's own surface, and 'kW' occurs exactly once - this cell. WORDING: 'Cabinet density up to 30kW' occurs verbatim as ONE contiguous <p> inside ONE <li>, so it is an authored cell rather than adjacent cells fused, and nothing is truncated off it. SCOPE: the nearest headings above it in byte order are '401 N Broad' and 'Philadelphia Colocation Specifications', and the served bytes contain NO promotional or limited-time banner anywhere before it, so the figure belongs to this facility and not to another metro's offer. The page says kW, so this is REAL power and takes the PublishedRealPower arm; had it said kVA no conversion would have been possible. NO COOLING MEDIUM IS NAMED ANYWHERE ON THE PAGE, so the medium is unspecified and this figure answers no air or liquid question; 'up to' makes it a marketed ceiling rather than a per-cabinet commitment.",
      verification: WordingVerbatim {
        retrieval: "Raw-byte re-read 2026-09-09 (curl, HTTP 200, 757,846 bytes) under a subject control, with the wording confirmed as one contiguous <p> inside one <li> rather than adjacent cells fused. That is the strongest retrieval standing in this census and is why this row is verbatim rather than summarized.",
      },
    },
    tail: [],
  },
}

data netrality_401_n_broad_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "single cabinets, cages, private suites, and dedicated floor",
  citation: "netrality.com Philadelphia colocation page, read 2026-09-08; the wording occurs verbatim in the raw served HTML re-fetched 2026-09-09 (HTTP 200, 757,846 bytes), as one contiguous <p> in one <li> of the same 'Philadelphia Colocation Specifications' list that carries the density cell.",
}
