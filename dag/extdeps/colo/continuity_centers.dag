module extdeps.colo.continuity_centers

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityUnread,
  RetailGrainStanding, RetailGrainUnread,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.continuitycenters.com/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.continuity_centers",
      decl_name: "continuity_centers_woodbury",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// AN OPERATOR WHOSE DIRECTORY LISTINGS AND WHOSE OWN SITE DISAGREE ABOUT WHAT IT SELLS, which is
// why this row exists rather than being dropped. Colocation directories describe a Long Island
// facility here selling single server, half and full cabinets, shared and dedicated locking
// cabinets, caged space and private suites - the finest grain claimed by any operator in this
// census after Stafford Associates. The operator's OWN site, read 2026-09-09, markets disaster
// recovery, backup and Veeam-partnered cloud protection and carries NO colocation product page at
// all. A directory is not the operator, so nothing here inherits the directory's product list; the
// disagreement itself is the fact worth carrying, so that the next reader does not spend the
// afternoon rediscovering it.
data continuity_centers_woodbury: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Continuity Centers",
  facility_label: "Continuity Centers Woodbury",
  address: AddressListed {
    street: "1000 Woodbury Rd, Suite 104, Woodbury, NY 11797",
    citation: "continuitycenters.com, confirmed against raw HTML 2026-09-09. The page labels the block HEADQUARTERS verbatim. THE OPERATOR PUBLISHES THIS AS ITS HEADQUARTERS ADDRESS, not explicitly as a data center address; directory listings give the same street for the facility, which is consistent but is a directory's claim. Whether the hall is in this building is the first thing a quote must settle.",
  },
  municipality: "Woodbury",
  region_code: "NY",
  facility_note: "Nassau County, on the Suffolk line. Founded 1999 per the operator. Directory profiles describe a Tier III facility with oversized freight elevators and roof rights, and SSAE 16 SOC 2 standing with HIPAA and PCI compliance claimed for the disaster-recovery product. FETCH NOTE, CORRECTED: an early attempt recorded this operator as answering HTTP 403 to a plain client, and that was this client rather than the operator - a full browser user-agent returns HTTP 200 and 176 KB. The readings here are therefore at the RAW-BYTES grade, not the rendered one, and the correction strengthens the grain obligation below rather than weakening it: the word colocation does not occur anywhere in the page bytes.",
}

data continuity_centers_density: CabinetDensityClaim = DensityUnread {
  obligation: "No per-cabinet power figure appears on the operator's site (read 2026-09-09), and no directory profile found for it states one either - so this is unread at both evidence grades rather than merely unconfirmed.",
}

data continuity_centers_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "THE PRIOR QUESTION IS WHETHER COLOCATION IS SOLD AT ALL, and the raw bytes make that question sharper rather than softer: THE WORD COLOCATION DOES NOT OCCUR IN THE PAGE (176 KB, HTTP 200, read 2026-09-09 with a browser user-agent). The operator markets disaster recovery, backup and Veeam-partnered cloud protection; directories describe single-server through full-cabinet, cage and private-suite colocation. Ask whether the colocation product still exists, and if it does, ask for the grain and the price - a live single-server product on Long Island would be the second-finest grain in this census and would matter out of proportion to this operator's size.",
}

data continuity_centers_westchester_obligation: NonEmptyStr = "A SECOND SITE IN THIS REGION IS DIRECTORY-ONLY AND IS DELIBERATELY NOT A ROW. Directory listings place a Continuity Centers facility in Westchester County under two different names, Chappaqua and Hawthorne, and the operator's own site names neither. One operator with two directory names for one unconfirmed site is exactly the shape that produces a phantom facility, so nothing is modelled: confirm from the operator whether a Westchester hall exists, what its address is, and whether the two directory names are one building or two."

data continuity_centers_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "continuitycenters.com contact form or the published Woodbury phone number",
  obligation: "No price is published for any product on the pages read 2026-09-09.",
}
