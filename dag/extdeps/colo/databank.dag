module extdeps.colo.databank

import std.types { NonEmptyStr, List }
import std.measure { watt }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityMarketedMax, DensityMarketedAirOnly,
  CabinetPowerFigure, PublishedRealPower,
  CabinetDensityClaim, DensityMarketedMax, DensityUnread,
  PublishedRealPower,
  RetailGrainStanding, SingleCabinetOffered,
  RetailGrainStanding, SingleCabinetOffered, RetailGrainUnread,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.databank.com/data-centers/new-york-city/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.databank",
      decl_name: "databank_facilities",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [
    ExternalAuthority {
      uri: Uri {
        scheme: Https
        locator: "www.databank.com/data-centers/new-york-city/orangeburg-campus/lga4/"
      }
    }
  ]
}

// DATABANK WAS ABSENT FROM THE 2026-08-18 CENSUS ENTIRELY, and its absence hid two things at
// once. It is a multi-site operator in this metro, so a missing operator is several missing
// candidates rather than one. And its Orangeburg campus is in NEW YORK - the census as it stood
// carried twenty-three New Jersey facilities and seven Pennsylvania ones and not a single New
// York site, which had been read as a consequence of the Equinix refusal. It was not: the Equinix
// campus that ruling names is itself in Secaucus, New Jersey. New York was never refused. It was
// never surveyed, and this row is the first one.
data databank_lga4_orangeburg: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank LGA4 Orangeburg",
  address: AddressListed {
    street: "2000 Corporate Dr., Orangeburg, NY 10962",
    citation: "databank.com Orangeburg campus LGA4 page, read 2026-09-08",
  },
  municipality: "Orangeburg",
  region_code: "NY",
  facility_note: "10 MW critical IT load with N+1 redundancy, marketed for high-density deployments including liquid cooling. Rockland County, north of the Hudson waterfront - the distance axis has no measured route for it and the census's planning estimates were drawn from Jersey City, so this candidate owes a route reading before it can be ranked against the Secaucus corridor.",
}

// THE DENSEST CABINET CLAIM IN THE CENSUS BY AN ORDER OF MAGNITUDE. Read against a fleet drawing
// 650 W per 1U node, a 35 kW air-cooled cabinet is not a constraint at all - it would hold the
// entire twenty-one node fleet twice over on air alone, where the densest PRICED product modelled
// in this metro holds three. That gap between what is marketed and what is published for retail
// sale is the census's central finding, and it is a reason to obtain quotes rather than a reason
// to believe a quote will be affordable: nothing here says what 35 kW costs.
data databank_lga4_density: CabinetDensityClaim = DensityMarketedMax {
  air_cooled: PublishedRealPower { power: watt(count: 35000) },
  liquid_cooled: PublishedRealPower { power: watt(count: 100000) },
  claim_wording: "35kW+ Cab Density Air / 100kW+ Cab Density Liq",
  citation: "databank.com Orangeburg campus LGA4 page, raw fetch 2026-09-09 (HTTP 200). THE WORDING ABOVE IS NOW THE LITERAL SPEC-TABLE CELLS AND WAS NOT BEFORE. The first cut read '35kW+ air-cooled, 100kW+ liquid-cooled' - a fused, invented sentence produced by a summarizing fetch tool, not text on the page. The page carries three separate cells: 'N+1 Cooling Design', '35kW+ Cab Density Air', '100kW+ Cab Density Liq'. The FIGURES survived verification and the WORDING did not, which is the general shape silent-heron-303 found across the census. The plus signs are the operator's own, so these are marketed floors on a maximum rather than exact ceilings; the integers are the stated numerals."
  claim_wording: "35kW+ air-cooled, 100kW+ liquid-cooled",
  citation: "databank.com Orangeburg campus LGA4 page, read 2026-09-08. The figures carry a plus sign in the operator's own wording, so they are marketed floors on a maximum rather than exact ceilings; the integers here are the stated numerals and the wording is retained beside them.",
}

data databank_lga4_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Cabinets & Cages Colocation",
  citation: "databank.com Orangeburg campus LGA4 page, read 2026-09-08",
}

data databank_lga1_hudson: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank LGA1 Downtown New York City",
  address: AddressListed {
    street: "60 Hudson Street, Suite 1903, New York, NY 10013",
    citation: "databank.com Hudson Street LGA1 page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "23,940 IT square feet, 0.74 MW critical IT load, 92 on-site carriers, 2N power and N+1 cooling per the operator page read 2026-09-08. Digital Realty JFK12 and Colocation America NYDC1 sell from the same building under their own modules. Five-borough site; density is a separate marketed claim, not the building's 0.74 MW.",
}

data databank_lga1_density: CabinetDensityClaim = DensityUnread {
  obligation: "The LGA1 page read 2026-09-08 states '5kW+ Cab Density Air' - a marketed floor, not a marketed maximum. The same disposition as Equinix NY9's minimum cabinet density: do not place 5000 W in DensityMarketedAirOnly. A quote or a spec that names a ceiling is required.",
}

data databank_lga1_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Cabinets Colocation",
  citation: "databank.com Hudson Street LGA1 page, read 2026-09-08",
}

data databank_lga2_eighth: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank LGA2 Downtown New York City",
  address: AddressListed {
    street: "111 Eighth Avenue, Suite 311A, New York, NY 10011",
    citation: "databank.com Eighth Avenue LGA2 page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "10,200 IT square feet, 0.68 MW critical IT load, 50 on-site carriers, N+1 power and cooling per the operator page read 2026-09-08. Equinix NY9 and Digital Realty JFK10 occupy the same building under their own modules.",
}

data databank_lga2_density: CabinetDensityClaim = DensityUnread {
  obligation: "The LGA2 page read 2026-09-08 states '5kW+ Cab Density Air' - the same marketed floor as LGA1, not a cabinet maximum. Unread until a ceiling is published.",
}

data databank_lga2_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Cabinets Colocation",
  citation: "databank.com Eighth Avenue LGA2 page, read 2026-09-08",
}

data databank_facilities: List<ColoFacilityRow> = [
  databank_lga4_orangeburg,
  databank_lga1_hudson,
  databank_lga2_eighth,
]

data databank_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "databank.com sales",
  obligation: "No cabinet or power pricing is published on the facility pages read 2026-09-08. A quote is required, and the density claims above are what make the quote worth requesting.",
}

// A SECOND SITE THIS OPERATOR RUNS IN NEW JERSEY, NAMED BUT NOT MODELLED. A review relayed into
// this session cited an 85 kW-per-cabinet deployment at a Piscataway campus for a university HPC
// tenant. Two fetches of the campus and facility pages under the paths that claim implies both
// returned 404 on 2026-09-08, so no address, capacity or density is carried for it. A tailored
// deployment for one named tenant would in any case be a different fact from a marketed cabinet
// maximum, and would need its own arm rather than being read as retail density.
data databank_ewr2_piscataway_obligation: NonEmptyStr = "Locate DataBank's current New Jersey facility pages - the Piscataway campus URLs derived from a secondary citation 404 as of 2026-09-08 - and model each site with its address, critical IT load, marketed cabinet density and retail grain. Until then this operator contributes exactly one modelled facility despite operating several in this metro, which understates it."

// THE OTHER BUILDING ON THE SAME CAMPUS, and it is the larger one. LGA4 was modelled first because
// it was the row that broke the census's New York blindness; LGA3 is the operational sibling at the
// same street address, and the campus reads as one site in directories while the operator prices
// two facilities. Both are carried, because a cabinet is bought in a building.
data databank_lga3_orangeburg: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank LGA3 Orangeburg",
  address: AddressListed {
    street: "2000 Corporate Dr., Orangeburg, NY 10962",
    citation: "databank.com Orangeburg campus LGA3 page, read 2026-09-08",
  },
  municipality: "Orangeburg",
  region_code: "NY",
  facility_note: "Rockland County, the first building of the Orangeburg campus: 20 MW critical IT load across 110,000 IT square feet, against LGA4's 10 MW. Same campus, same address, same density claim, twice the load - so a quote that fails on capacity at one building has not failed at the campus.",
}

data databank_lga3_density: CabinetDensityClaim = DensityMarketedMax {
  air_cooled: PublishedRealPower { power: watt(count: 35000) },
  liquid_cooled: PublishedRealPower { power: watt(count: 100000) },
  claim_wording: "35kW+ Cab Density Air / 100kW+ Cab Density Liquid",
  citation: "databank.com Orangeburg campus LGA3 page, confirmed against raw HTML 2026-09-09. THE TWO FIGURES ARE SEPARATE SPEC CELLS, NOT ONE SENTENCE: the page emits '35kW+ Cab Density Air' and '100kW+ Cab Density Liquid' as adjacent cells, and the slash here is this row's separator rather than the operator's punctuation. Recorded that way because a wording field whose job is to let a later reader re-derive the number is worthless if it holds a sentence the operator never wrote. Identical figures to LGA4, and this is a SECOND facility carrying the claim rather than a second reading of the same one - the two buildings are separately marketed with separate critical loads. SCOPE CHECKED IN BYTE ORDER: the nearest heading above the two cells is the page's own LGA3 Orangeburg, New York City title, and the page carries no promotional block; the figures are this facility's and not a banner's. ELEMENT BOUNDARY, which is what settles the fusion rather than the sentence: the markup is <li><strong>35kW+</strong> Cab Density Air</li> and <li><strong>100kW+</strong> Cab Density Liquid</li> - TWO list items, each with its numeral in its own <strong>. Joining them is invention. Note the numeral emphasis also means a contiguous raw-byte grep for the full string FAILS on a true row, so the wording above was matched against tag-stripped text while ownership was decided on the markup.",
}

data databank_lga3_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Cabinets & Cages Colocation",
  citation: "databank.com Orangeburg campus LGA3 page, read 2026-09-08",
// THIS OPERATOR HAS MORE SITES IN THIS METRO THAN THE TWO MODELLED HERE. Its New Jersey index also
// names a Newark facility at the 165 Halsey Street carrier hotel, which this census already carries
// as a BUILDING under extdeps.colo.halsey_165 with no DataBank row in it. Reading
// databank.com/data-centers/new-jersey/newark-165-halsey-street-suite/ and modelling that suite
// here - one row per operator selling in a multi-operator building, per this carrier's own rule -
// is what would make the operator's coverage complete; until then two of at least three are read.
//
// THE SECOND SITE, NOW READ. The obligation this module carried - locate DataBank's New Jersey
// facility pages, whose URLs derived from a secondary citation 404ed - is discharged here. The
// live path is databank.com/data-centers/new-jersey/piscataway/, and the facility is EWR2.
//
// THE 85 kW CLAIM THAT PROMPTED THE SEARCH IS NOT REFUTED BY THIS ROW; IT IS A DIFFERENT QUANTITY.
// A review relayed an 85 kW-per-cabinet figure for the university HPC environment this building
// hosts. That is a tailored deployment built for one named tenant. The 10kW+ below is what the
// operator MARKETS to any buyer. Both can be true of one building at once, and reading the first
// as the second would be the same category error as reading facility megawatts as cabinet density
// - the error this carrier exists to prevent, wearing a different costume. So the row carries the
// marketed figure because that is what CabinetDensityClaim is for, and the tenant-specific figure
// gets no arm here until something consumes it. What was wrong was never the source's number; it
// was the quantity it would have been filed under.
data databank_ewr2_piscataway: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank EWR2 Piscataway",
  address: AddressListed {
    street: "25 Corporate Place South, Piscataway, NJ 08854",
    citation: "databank.com New Jersey Piscataway data center page, read 2026-09-08",
  },
  municipality: "Piscataway",
  region_code: "NJ",
  facility_note: "Operator page (read 2026-09-08): 3 MW critical IT load, 22,590 IT square feet, N+1 power and cooling, nine onsite carriers, 100 percent renewable sourcing claimed. Middlesex County - the same township as QTS PNJ1, Digital Fortress PNJ and the Digital Realty Piscataway campus. Home to the New Jersey Institute of Technology's Wulver HPC environment per the operator's own press material, which is why a dense-cabinet claim for this building circulates; see the density row for what the facility page actually states.",
}

// TEN KILOWATTS, NOT EIGHTY-FIVE. The plus sign is the operator's, so this is a marketed floor on
// a maximum in the same wording style as LGA4's 35kW+. Against a 650 W node it is thirteen nodes
// of air-cooled headroom - four times the densest PRICED product in this census and a third of
// what LGA4 markets. It is the reading that makes EWR2 a real candidate and the reading that
// stops it from being ranked as the dense one.
data databank_ewr2_density: CabinetDensityClaim = DensityMarketedAirOnly {
  air_cooled: PublishedRealPower { power: watt(count: 10000) },
  claim_wording: "10kW+ Cab Density Air",
  citation: "databank.com New Jersey Piscataway data center page, read 2026-09-08 and verified against the raw bytes 2026-09-09 (HTTP 200, 126833 bytes, the string occurs literally, as the cell markup 10kW+ in bold followed by Cab Density Air). Scope check: the cell is in the Power info-table directly under the page's h1, Piscataway Data Center (EWR2), 25 Corporate Place South, alongside 3MW Critical IT Load - the same spec strip, the same facility, no promotion banner. Element boundary, which is what settles fusion for this operator's template: the wording is ONE <li> element whose numeral is emphasized - 10kW+ in strong tags followed by the text Cab Density Air - so it is an authored cell and not two cells joined. The same page's sibling facilities have been found emitting two adjacent cells that summarizing reads fuse into one comma'd sentence; this row is the other failure of the same template, a cell truncated at its emphasis boundary. Matching was done against tag-stripped text because the emphasis tags mean no contiguous byte run carries the wording. Positive control in the same pass: 25 Corporate Place South is present in the same stripped text. The wording is the operator's whole spec-strip cell: an earlier reading of this row carried only the leading \"10kW+\", which was a truncation of it. The plus sign is the operator's own, so the integer is a marketed floor rather than a ceiling - and the operator's own word AIR is what selects the air-only arm here, rather than the arm being inferred from the absence of a liquid figure. Unlike LGA4 this facility's strip carries no liquid cell at all.",
}

data databank_ewr2_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "cabinets, cages",
  citation: "databank.com New Jersey Piscataway data center page, read 2026-09-08. The page lists cabinets alongside cages as the space products for this facility, on the same pattern as LGA4; it does not state a minimum commitment, so the quote still owes the answer for a one-cabinet order.",
}
data databank_ewr2_piscataway_obligation: NonEmptyStr = "Locate DataBank's current New Jersey facility pages - the Piscataway campus URLs derived from a secondary citation 404 as of 2026-09-08 - and model each site with its address, critical IT load, marketed cabinet density and retail grain. Until then this operator's New Jersey footprint remains an unread obligation."
// PARTIALLY DISCHARGED 2026-09-08. The operator's New Jersey index at databank.com/data-
// centers/new-jersey/ resolves and names exactly two sites: EWR1 Downtown Newark, now modelled
// above, and EWR2 Piscataway at 25 Corporate Place South, Piscataway, NJ 08854 with no density
// figure on the index. The Piscataway facility page beneath it still 404s, and Piscataway is
// Middlesex County, outside the Hudson-Bergen-Essex corridor this pass surveyed, so EWR2 remains
// unmodelled: read its facility page and carry its address, critical IT load, cabinet density and
// retail grain. The 85 kW-per-cabinet claim a secondary review attached to a Piscataway HPC tenant
// is still unconfirmed by any operator page and is still not a marketed retail density.
//
// THE OPERATOR'S NEW JERSEY SITE IN THE HUDSON-BERGEN-ESSEX CORRIDOR, read 2026-09-08 from the
// operator's own New Jersey index and the EWR1 facility page beneath it. DataBank sells from a
// suite inside the 165 Halsey carrier hotel, which the census already carries as a building under
// extdeps.colo.halsey_165 and as a Hivelocity suite under extdeps.colo.hivelocity: one building,
// three upstream authorities, three rows, exactly as the building-versus-operator rule requires.
data databank_ewr1_newark: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank EWR1 Downtown Newark",
  address: AddressListed {
    street: "165 Halsey Street Suite #500, Newark, NJ 07102",
    citation: "databank.com New Jersey index and the Newark 165 Halsey Street suite page, read 2026-09-08; the same address and suite are carried by the operator's own PeeringDB facility entry for DataBank Newark (EWR1), read 2026-09-08",
  },
  municipality: "Newark",
  region_code: "NJ",
  facility_note: "Operator page read 2026-09-08: 34,360 IT square feet, 1.7 MW critical IT load, 2N power design, 120V and 208V three-phase AC with DC available, 21 on-site carriers. The zColo suite Zayo sold to DataBank in 2020 per the operator's own history. Essex County, on the Newark side of the corridor rather than the Secaucus cluster.",
}

// A READ DENSITY, AND IT IS THE COOLING SENTENCE RATHER THAN A POWER SENTENCE. The facility page
// states an N+1 cooling design with 10kW+ cabinet density capability. That is a per-cabinet figure
// on the operator's own facility page, so it is read rather than unread - but the plus sign and
// the cooling framing are both retained in the wording, because a cooling capability is what the
// room can remove, not a commitment that a cabinet may draw it. The 1.7 MW critical IT load on the
// same page is a BUILDING fact and is not a second reading of this one.
data databank_ewr1_density: CabinetDensityClaim = DensityMarketedAirOnly {
  air_cooled: PublishedRealPower { power: watt(count: 10000) },
  claim_wording: "10kW+ Cab Density Air",
  citation: "databank.com Newark 165 Halsey Street suite page, read 2026-09-08 and verified in raw HTML 2026-09-09 at markup grain: the page emits <li><strong>10kW+</strong> Cab Density Air</li> as ONE list item inside the column whose heading is Cooling, beside a sibling item reading N+1 Cooling Design. So this wording is a single authored cell rather than two cells fused - the distinction matters because an earlier summarized capture of this row DID fuse the two into one invented sentence, and the same fusion has now been found on three DataBank facilities by three readers. SCOPE IS VERIFIED TOO, which is the separate question a string check does not answer: the nearest heading above this cell is the facility's own address line, \"(EWR1) 165 Halsey Street Suite #500 - Newark, NJ 07102\", under an h1 of \"Downtown Newark Data Center\", and EWR1 is the only facility code appearing anywhere in the page bytes. So this figure is not sitting under another metro's banner and not shared with a second site. And the qualifier is intact rather than truncated - the cell says Air, and the operator's own word is what SELECTS the air-only arm rather than it being inferred from an absent liquid cell. The operator's own word is AIR, which is why this is DensityMarketedAirOnly and not a maximum with a liquid arm.",
}

data databank_ewr1_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The EWR1 page names Cabinets among its colocation platforms but states no minimum, so whether one cabinet is sellable on its own at this site is unread. Ask the quote whether a single cabinet is contractable at 165 Halsey Suite 500, and whether the 10 kW cooling figure is available to a one-cabinet order or only inside a larger footprint.",
}

