module extdeps.colo.databank

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.algebra { FreeSemigroup }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityPublished, DensityUnread, PublishedDensityFigure, CabinetPowerFigure, PublishedRealPower,
  FigureVerificationStanding, WordingVerbatim,
  CoolingMediumStanding, CoolingMediumPublished, CoolingMedium, AirCooling, LiquidCooling,
  PublishedPowerQuantity, CapabilityAtLeast,
  RetailGrainStanding, SingleCabinetOffered, RetailGrainUnread,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.databank.com/data-centers/new-york-city/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.databank",
      decl_name: "databank_facilities",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [
    ExternalAuthority {
      uri: Uri {
        scheme: Https
        locator: "www.databank.com/data-centers/new-york-city/orangeburg-campus/lga4/"
      }
    }
  ]
}

// DATABANK WAS ABSENT FROM THE 2026-08-18 CENSUS ENTIRELY, and its absence hid two things at
// once. It is a multi-site operator in this metro, so a missing operator is several missing
// candidates rather than one. And its Orangeburg campus is in NEW YORK - the census as it stood
// carried twenty-three New Jersey facilities and seven Pennsylvania ones and not a single New
// York site, which had been read as a consequence of the Equinix refusal. It was not: the Equinix
// campus that ruling names is itself in Secaucus, New Jersey. New York was never refused. It was
// never surveyed, and this row is the first one.
data databank_lga4_orangeburg: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank LGA4 Orangeburg",
  address: AddressListed {
    street: "2000 Corporate Dr., Orangeburg, NY 10962",
    citation: "databank.com Orangeburg campus LGA4 page, read 2026-09-08",
  },
  municipality: "Orangeburg",
  region_code: "NY",
  facility_note: "10 MW critical IT load with N+1 redundancy, marketed for high-density deployments including liquid cooling. Rockland County, north of the Hudson waterfront - the distance axis has no measured route for it and the census's planning estimates were drawn from Jersey City, so this candidate owes a route reading before it can be ranked against the Secaucus corridor.",
}

// THE DENSEST CABINET CLAIM IN THE CENSUS BY AN ORDER OF MAGNITUDE. Read against a fleet drawing
// 650 W per 1U node, a 35 kW air-cooled cabinet is not a constraint at all - it would hold the
// entire twenty-one node fleet twice over on air alone, where the densest PRICED product modelled
// in this metro holds three. That gap between what is marketed and what is published for retail
// sale is the census's central finding, and it is a reason to obtain quotes rather than a reason
// to believe a quote will be affordable: nothing here says what 35 kW costs.
// DEMOTED ON MAIN AND RESTORED HERE BY THE TRIGGER THE DEMOTION ITSELF NAMED. #10862 demoted this row
// to DensityUnread, and it was right to: on that carrier the only figure-bearing arms were marketed
// MAXIMA, so "35kW+ Cab Density Air" was typed as an at-most and the census asserted that a cabinet
// advertised at thirty-five kilowatts OR MORE refuses 35,001 W. That was the LIVE instance rather than
// a latent one - the positive control that exists to prove the accessor works was asserting
// established_watts == 35000 over a floor, so a wrong reading executed under a green witness.
//
// The obligation that demotion left said in terms: "RESOLVE by re-typing both as floor-carrying
// figures once the carrier expresses a quantity's direction; the numerals and wording above are the
// reading and no re-fetch is required." This carrier expresses direction - CapabilityAtLeast carries
// a floor as a floor - so the trigger has fired and the row is retyped from the reading it already
// had. No re-fetch was needed and none was done.
//
// THE WORDING IS THE CORRECTED ONE, PER CELL. The first cut read "35kW+ air-cooled, 100kW+
// liquid-cooled", a fused sentence produced by a summarizing fetch tool and not text on the page. The
// page carries three separate cells: "N+1 Cooling Design", "35kW+ Cab Density Air", "100kW+ Cab
// Density Liq". The figures survived verification and the fused wording did not, which is why wording
// now sits on the figure it establishes rather than once above both.
data databank_lga4_density: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: CapabilityAtLeast { lower: PublishedRealPower { power: watt(count: 35000) } },
      wording: "35kW+ Cab Density Air",
      citation: "databank.com Orangeburg campus LGA4 page, spec table, raw fetch 2026-09-09 (HTTP 200)",
      verification: WordingVerbatim {
        retrieval: "Raw fetch of the LGA4 facility page on 2026-09-09 returned HTTP 200 and the wording above is the literal spec-table cell. The plus sign is the operator's own, which is what makes this a marketed floor on a maximum rather than an exact ceiling.",
      },
    },
    tail: [
      PublishedDensityFigure {
        medium: CoolingMediumPublished { medium: LiquidCooling },
        quantity: CapabilityAtLeast { lower: PublishedRealPower { power: watt(count: 100000) } },
        wording: "100kW+ Cab Density Liq",
        citation: "databank.com Orangeburg campus LGA4 page, spec table, raw fetch 2026-09-09 (HTTP 200)",
        verification: WordingVerbatim {
          retrieval: "Same raw fetch and same spec table as the air cell, and a SEPARATE cell in it. The first cut of this row read '35kW+ air-cooled, 100kW+ liquid-cooled' - a fused, invented sentence produced by a summarizing fetch tool and not text on the page - and stored it once above both figures. The page carries three separate cells: 'N+1 Cooling Design', '35kW+ Cab Density Air', '100kW+ Cab Density Liq'. The FIGURES survived verification and the fused WORDING did not, which is why wording now sits on the figure it establishes.",
        },
      },
    ],
  },
}

data databank_lga4_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Cabinets & Cages Colocation",
  citation: "databank.com Orangeburg campus LGA4 page, read 2026-09-08",
}

data databank_lga1_hudson: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank LGA1 Downtown New York City",
  address: AddressListed {
    street: "60 Hudson Street, Suite 1903, New York, NY 10013",
    citation: "databank.com Hudson Street LGA1 page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "23,940 IT square feet, 0.74 MW critical IT load, 92 on-site carriers, 2N power and N+1 cooling per the operator page read 2026-09-08. Digital Realty JFK12 and Colocation America NYDC1 sell from the same building under their own modules. Five-borough site; density is a separate marketed claim, not the building's 0.74 MW.",
}

data databank_lga1_density: CabinetDensityClaim = DensityUnread {
  obligation: "databank.com/data-centers/new-york-city/hudson-street/ from db_data_center-sitemap (not a constructed /lga1/ path: that URL is HTTP 404 with a 116829-byte styled body). Raw fetch 2026-09-09: both UAs HTTP 200, 127107 bytes. Subject control LGA1=84. RAW '5kW+'=1 is the marketed floor sentence, not a ceiling; not treated as DensityMarketedAirOnly. A quote or a spec that names a ceiling is required.",
}

data databank_lga1_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "databank.com/data-centers/new-york-city/hudson-street/ full-UA HTTP 200, 127107 bytes, subject LGA1=84. RAW wording 'Cabinets Colocation' names a cabinet product and does not establish a single-cabinet minimum. No CabinetProductNamed arm on this carrier; unread until a quote or a sentence that names the smallest sellable unit.",
}

data databank_lga2_eighth: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank LGA2 Downtown New York City",
  address: AddressListed {
    street: "111 Eighth Avenue, Suite 311A, New York, NY 10011",
    citation: "databank.com Eighth Avenue LGA2 page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "10,200 IT square feet, 0.68 MW critical IT load, 50 on-site carriers, N+1 power and cooling per the operator page read 2026-09-08. Equinix NY9 and Digital Realty JFK10 occupy the same building under their own modules.",
}

data databank_lga2_density: CabinetDensityClaim = DensityUnread {
  obligation: "databank.com/data-centers/new-york-city/eighth-avenue/ from db_data_center-sitemap. Raw fetch 2026-09-09: both UAs HTTP 200, 127126 bytes. Subject control LGA2=85. RAW '5kW+'=1 is the same marketed floor as LGA1, not a cabinet maximum. Unread until a ceiling is published.",
}

data databank_lga2_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "databank.com/data-centers/new-york-city/eighth-avenue/ full-UA HTTP 200, 127126 bytes, subject LGA2=85. Same 'Cabinets Colocation' product label as LGA1, not a demonstrated single-cabinet offer.",
}

// A SECOND SITE THIS OPERATOR RUNS IN NEW JERSEY, NAMED BUT NOT MODELLED. A review relayed into
// this session cited an 85 kW-per-cabinet deployment at a Piscataway campus for a university HPC
// tenant. Two fetches of the campus and facility pages under the paths that claim implies both
// returned 404 on 2026-09-08, so no address, capacity or density is carried for it. A tailored
// deployment for one named tenant would in any case be a different fact from a marketed cabinet
// maximum, and would need its own arm rather than being read as retail density.
// PARTIALLY DISCHARGED 2026-09-08. The operator's New Jersey index at databank.com/data-
// centers/new-jersey/ resolves and names exactly two sites: EWR1 Downtown Newark, now modelled
// above, and EWR2 Piscataway at 25 Corporate Place South, Piscataway, NJ 08854 with no density
// figure on the index. The Piscataway facility page beneath it still 404s, and Piscataway is
// Middlesex County, outside the Hudson-Bergen-Essex corridor this pass surveyed, so EWR2 remains
// unmodelled: read its facility page and carry its address, critical IT load, cabinet density and
// retail grain. The 85 kW-per-cabinet claim a secondary review attached to a Piscataway HPC tenant
// is still unconfirmed by any operator page and is still not a marketed retail density.
//
// THE OPERATOR'S NEW JERSEY SITE IN THE HUDSON-BERGEN-ESSEX CORRIDOR, read 2026-09-08 from the
// operator's own New Jersey index and the EWR1 facility page beneath it. DataBank sells from a
// suite inside the 165 Halsey carrier hotel, which the census already carries as a building under
// extdeps.colo.halsey_165 and as a Hivelocity suite under extdeps.colo.hivelocity: one building,
// three upstream authorities, three rows, exactly as the building-versus-operator rule requires.
data databank_ewr1_newark: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank EWR1 Downtown Newark",
  address: AddressListed {
    street: "165 Halsey Street Suite #500, Newark, NJ 07102",
    citation: "databank.com New Jersey index and the Newark 165 Halsey Street suite page, read 2026-09-08; the same address and suite are carried by the operator's own PeeringDB facility entry for DataBank Newark (EWR1), read 2026-09-08",
  },
  municipality: "Newark",
  region_code: "NJ",
  facility_note: "Operator page read 2026-09-08: 34,360 IT square feet, 1.7 MW critical IT load, 2N power design, 120V and 208V three-phase AC with DC available, 21 on-site carriers. The zColo suite Zayo sold to DataBank in 2020 per the operator's own history. Essex County, on the Newark side of the corridor rather than the Secaucus cluster.",
}

// DEMOTED 2026-09-09 BY OPERATOR RULING, AND THE FRAMING I BROUGHT TO IT WAS WRONG. I argued this as
// a question about the census headline: demoting drops the corridor from one read density to zero,
// and the page WAS read, so calling it unread looked like trading a wrong ceiling for a wrong
// coverage reading. Seven reviews said otherwise and the ruling settled it on a different axis
// entirely. "10kW+" is a capability FLOOR carried in a MAXIMUM arm - the only figure-bearing arms
// this carrier has are maxima - so the row does not overstate a headline, it answers a bounding
// question BACKWARDS. DESIGN section 5 puts silent wrongness outside the ladder rather than low on
// it, and no amount of correct prose beside a typed value changes what a consumer computes from it.
// Demotion replaces a wrong answer with a refusal naming what must be re-read, which is the
// fail-closed direction and needs no headline argument to justify it.
//
// THE EVIDENCE DID NOT MOVE, WHICH IS WHY THIS COSTS NOTHING IT LOOKED LIKE IT WOULD COST. The
// obligation below carries the operator's verbatim wording and the full retrieval citation, so what
// the demotion gives up is the TYPED AXIS and not the reading. That is the argument that changed my
// own recommendation, and it was available from the first review: I spent seven of them defending
// evidence that was never at risk. The reading is recoverable without a re-fetch the moment the
// carrier can express a quantity's direction.
//
// WHY IT DID NOT WAIT FOR THE CARRIER. "The fix is one rebase away" had been true long enough that
// seven reviewers were correct while nothing moved, and the carrier change is itself under rework.
// Demote-then-convert is two cheap edits; a wrong-direction figure standing another day is not.
//
// WHAT THE SEVEN EQUINIX ROWS DO AND DO NOT SHOW. They are DensityUnread for a second, independent
// reason: they publish kVA, this carrier's figures are Watt, and no power factor is published, so
// they are unrepresentable in any published arm regardless of direction. They were never evidence
// that the right arm existed for EWR1 - they only show the same destination reached by another road.
// RESTORED BY THE TRIGGER ITS OWN OBLIGATION NAMED, FOR THE SAME REASON AS LGA4 ABOVE. #10862 demoted
// this row because "10kW+ Cab Density Air" is a capability FLOOR and that carrier's only figure-bearing
// arms were marketed MAXIMA, so a census over it would have answered that a cabinet advertised at ten
// kilowatts OR MORE refuses 10,001 W. The obligation said: "RESOLVE by re-typing this row as a
// floor-carrying figure once the carrier expresses a quantity's direction, at which point the numeral
// and wording above are the reading and no re-fetch is required." CapabilityAtLeast is that direction.
// No re-fetch was needed and none was done; the numeral, the wording, the markup-grain verification
// and the scope check are carried across verbatim from what that obligation already held.
//
// IT IS RESTORED WITH LGA4 AND NOT AFTER IT, BECAUSE ONE ROW WITHOUT ITS NEIGHBOUR IS THE DEFECT THIS
// FILE WAS ALREADY CORRECTED FOR. Review 62991 caught #10862 applying the demotion to one DataBank row
// and not the other; doing the restoration to one and not the other is the same inconsistency running
// backwards.
//
// THE SEVEN EQUINIX ROWS ARE NOT RESTORED HERE AND THAT IS DELIBERATE. Their figures are published
// kVA MINIMUMS, which this carrier can now hold - CapabilityAtLeast over PublishedApparentPower - so
// their trigger has fired too. They are another reader's readings in another module, and converting
// seven readings I did not take, off an annotation rather than off the pages, is how a wrong numeral
// enters a census. That conversion belongs to whoever owns equinix.dag.
data databank_ewr1_density: CabinetDensityClaim = DensityPublished {
  figures: FreeSemigroup {
    head: PublishedDensityFigure {
      medium: CoolingMediumPublished { medium: AirCooling },
      quantity: CapabilityAtLeast { lower: PublishedRealPower { power: watt(count: 10000) } },
      wording: "10kW+ Cab Density Air",
      citation: "databank.com Newark 165 Halsey Street suite page, read 2026-09-08 and verified in raw HTML 2026-09-09 at markup grain: the page emits <li><strong>10kW+</strong> Cab Density Air</li> as ONE list item inside the column headed Cooling, beside a sibling item reading N+1 Cooling Design",
      verification: WordingVerbatim {
        retrieval: "Markup-grain verification 2026-09-09: the wording is a single authored <li> rather than two cells fused, which matters because an earlier summarized capture of this row DID fuse two cells into one invented sentence and the same fusion was found on three DataBank facilities by three readers. SCOPE was verified separately, which a string check does not answer: the nearest heading above the cell is the facility's own address line, \"(EWR1) 165 Halsey Street Suite #500 - Newark, NJ 07102\", under an h1 of \"Downtown Newark Data Center\", and EWR1 is the only facility code in the page bytes - so the figure is not under another metro's banner and not shared with a second site. The qualifier is intact rather than truncated: the cell says Air, and the operator's own word is what selects the medium rather than it being inferred from an absent liquid cell.",
      },
    },
    tail: [],
  },
}

data databank_ewr1_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The EWR1 page names Cabinets among its colocation platforms but states no minimum, so whether one cabinet is sellable on its own at this site is unread. Ask the quote whether a single cabinet is contractable at 165 Halsey Suite 500, and whether the 10 kW cooling figure is available to a one-cabinet order or only inside a larger footprint.",
}

data databank_ewr2_piscataway_obligation: NonEmptyStr = "Locate DataBank's current New Jersey facility pages - the Piscataway campus URLs derived from a secondary citation 404 as of 2026-09-08 - and model each site with its address, critical IT load, marketed cabinet density and retail grain. Until then this operator contributes exactly one modelled facility despite operating several in this metro, which understates it."

// THE SAME OPERATOR IN PENNSYLVANIA, ADDED BY THE PHILADELPHIA AND LEHIGH VALLEY LANE. DataBank
// sells from 401 North Broad, the Philadelphia carrier hotel Netrality owns - so this census now
// carries that one building three times under three sellers (Netrality's own retail, this suite,
// and LightWave Networks), each citing its own operator. The contrast with LGA4 above is the
// finding: the same operator markets 35 kW+ air-cooled cabinets in Orangeburg and publishes no
// density at all for its Philadelphia suite, so an operator-level density claim is not a thing
// that exists. Density is a per-facility reading or it is unread.
data databank_phl1_philadelphia: ColoFacilityRow = ColoFacilityRow {
  operator_label: "DataBank",
  facility_label: "DataBank PHL1 Downtown Philadelphia",
  address: AddressListed {
    street: "401 North Broad Street, Suite 240, Philadelphia, PA 19108",
    citation: "databank.com Philadelphia data centers page, read 2026-09-08",
  },
  municipality: "Philadelphia",
  region_code: "PA",
  facility_note: "0.34 MW critical IT load across 7,760 IT square feet with 22 onsite carriers (read 2026-09-08) - by critical load the smallest facility in this census, a suite inside the region's premier carrier hotel rather than a building. Its value is interconnection, not capacity: 0.34 MW is under a tenth of what the same operator's LGA4 carries.",
}

data databank_phl1_density: CabinetDensityClaim = DensityUnread {
  obligation: "databank.com Philadelphia page, read 2026-09-08, states critical IT load, IT square footage and carrier count, and NO per-cabinet density. Raw-byte confirmed 2026-09-09 under a subject control (HTTP 200, full browser user-agent): 'Philadelphia' occurs 26 times, so the instrument reached this facility's surface, and 'kW', 'kVA' and even 'cabinet' occur zero times. The operator's 35 kW+ claim belongs to the Orangeburg campus and may not be carried to this suite - a 0.34 MW suite and a 10 MW campus are different plant. Request a PHL1 spec sheet or a quote.",
}

data databank_phl1_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The Philadelphia page read 2026-09-08 describes interconnection and location and does not itemise cabinets, cages or suites for this site. The spec-strip wording carried on the LGA4 row above is that page's, not this one's - and that strip is exactly the template whose adjacent cells four independent readers fused into invented sentences, so nothing is carried across from it. Confirm the smallest sellable unit at PHL1 with sales.",
}

data databank_facilities: List<ColoFacilityRow> = [
  databank_lga4_orangeburg,
  databank_lga1_hudson,
  databank_lga2_eighth,
  databank_ewr1_newark,
  databank_phl1_philadelphia,
]

data databank_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "databank.com sales",
  obligation: "No cabinet or power pricing is published on the facility pages read 2026-09-08. A quote is required, and the density claims above are what make the quote worth requesting.",
}
