module extdeps.colo.equinix

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim,
  DensityUnread, RetailGrainStanding, RetailGrainUnread,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.equinix.com/data-centers/americas-colocation/united-states-colocation/new-york-data-centers"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.equinix",
      decl_name: "equinix_secaucus_campus",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data equinix_ny2: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY2",
  address: AddressListed { street: "275 Hartz Way, Secaucus, NJ 07094", citation: "Equinix New York campus pages and PeeringDB fac 36, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Part of the four-building Secaucus campus interconnected by campus cross-connects.",
}

data equinix_ny4: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY4",
  address: AddressListed { street: "755 Secaucus Road, Secaucus, NJ 07094", citation: "Equinix NY4 page, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "The financial-ecosystem flagship of the campus; the deepest carrier and exchange density in the metro.",
}

data equinix_ny5: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY5",
  address: AddressListed { street: "800 Secaucus Road, Secaucus, NJ 07094", citation: "Equinix NY5 page, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Campus building adjacent to NY4.",
}

data equinix_ny6: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY6",
  address: AddressListed { street: "105 Enterprise Avenue, Secaucus, NJ 07094", citation: "Equinix campus listings, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Campus building; newest of the four in most directory listings.",
}

data equinix_secaucus_campus: List<ColoFacilityRow> = [equinix_ny2, equinix_ny4, equinix_ny5, equinix_ny6]

data equinix_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "equinix.com sales",
  obligation: "No published cabinet pricing; the operator sells retail cabinets by quote and market surveys consistently place it at the premium end of the metro. Whether to solicit a quote at all is a consumer decision, not a fact about the operator.",
}

// THE OPERATOR'S ONE NEW YORK-STATE IBX IN THIS REGION, and the census's Equinix rows were until
// now entirely Secaucus. NY13 sits in Westchester County, which matters because the module's
// existing quote-only note reasons about a New Jersey campus and a Westchester cabinet is a
// different route, a different power market and a different latency to Manhattan.
//
// FETCH NOTE: equinix.com refuses the ordinary fetch path with HTTP 403. The reading below was
// taken directly from the operator's own NY13 page over a plain HTTP client on 2026-09-08 - it is
// an operator reading, not a directory's, and the 403 is recorded so the next reader does not
// conclude the page is gone.
data equinix_ny13: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY13",
  address: AddressListed {
    street: "401 Fieldcrest Drive, Elmsford, NY 10523",
    citation: "equinix.com NY13 IBX page, read 2026-09-08",
  },
  municipality: "Elmsford",
  region_code: "NY",
  facility_note: "Westchester County. The operator's own page describes NY13 as serving large financial, media and enterprise companies with premium interconnection - the same wording family as the Secaucus rows, and the same absence of any retail-grain or density statement.",
}

data equinix_ny13_density: CabinetDensityClaim = DensityUnread {
  obligation: "The NY13 page states no kW-per-cabinet figure (read 2026-09-08). Equinix publishes density elsewhere in its marketing; nothing on this facility's page does, and a corporate figure is not a facility reading. Ask for the per-cabinet ceiling at NY13 specifically.",
}

data equinix_ny13_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The NY13 page names colocation and interconnection but does not state whether a single cabinet is a sellable unit at this IBX. The module's existing rate note asserts the operator sells retail cabinets by quote across the metro; that is an operator-level belief and this row does not convert it into a NY13 reading.",
}

// THREE CORRIDOR IBXs THE 2026-08-18 PASS MISSED, all three read 2026-09-08 from the operator's
// own PeeringDB facility entries rather than from equinix.com, because two fetches of the operator's
// New York colocation pages from two different paths were refused with HTTP 403 on 2026-09-08. A
// PeeringDB facility row is maintained by the operator itself, which is why it carries an address
// here; it carries no density and no minimum, which is why the two rows below are unread.
data equinix_ny1: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY1",
  address: AddressListed {
    street: "165 Halsey St, Floor 8, Newark, NJ 07102",
    citation: "PeeringDB facility Equinix NY1 - New York, Newark, read 2026-09-08",
  },
  municipality: "Newark",
  region_code: "NJ",
  facility_note: "An Equinix IBX inside the 165 Halsey carrier hotel, on the eighth floor. The census already carries this building three other ways - the building operator (extdeps.colo.halsey_165), a Hivelocity suite, and DataBank EWR1 on floor 5 - so 165 Halsey now stands as the corridor's clearest instance of one building with four separate upstream authorities selling inside it.",
}

data equinix_ny3: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY3",
  address: AddressListed {
    street: "600 Jefferson Avenue, Secaucus, NJ 07094",
    citation: "PeeringDB facility Equinix NY3 - New York, Secaucus, read 2026-09-08",
  },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "A fifth Secaucus IBX, separate from the four-building 800 Secaucus Road campus that equinix_secaucus_campus enumerates - a different street, and a different PeeringDB facility. The 2026-08-18 pass carried the campus and missed this one, which is the failure shape a registry sweep catches and a campus page does not.",
}

data equinix_ny7: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY7",
  address: AddressListed {
    street: "5851 Westside Ave, North Bergen, NJ 07047",
    citation: "PeeringDB facility Equinix NY7 - New York, North Bergen, read 2026-09-08",
  },
  municipality: "North Bergen",
  region_code: "NJ",
  facility_note: "The operator's North Bergen site, in Hudson County between the Secaucus cluster and the Weehawken waterfront. No operator-page reading exists for it; everything beyond name and address is unread.",
}

// THE REFUSAL WAS MINE, NOT THEIRS, AND THE CORRECTION IS THE POINT. This row first recorded two
// HTTP 403s as the operator refusing readers, and built an obligation on it. Re-fetching from raw
// bytes with an ordinary browser user-agent on 2026-09-09 returned 200 - the operator blocks
// nothing, my client was being refused, and the two paths I had tried answer 404 rather than 403.
//
// An operator that blocks readers and an operator whose pages I failed to reach are DIFFERENT
// FACTS, and only one of them is about the operator. Recording the first when the second is true
// puts a claim about someone else's behaviour into an upstream module on the strength of my own
// tooling, and it fails in the flattering direction: it makes an unread density look like the
// operator's choice rather than my gap. The density stays unread either way; what changes is that
// the obligation now names something a later reader can actually act on.
// SEVEN FACILITIES, SEVEN DIFFERENT PUBLISHED FIGURES - SO ONE SHARED DENSITY ROW WAS ITSELF A FUSION.
// This module carried a single equinix_cabinet_density for all seven corridor IBXs, which was defensible
// only while nothing had been read for any of them. The operator publishes a per-facility figure and the
// values genuinely differ - 2, 2, 8, 5, 5, 5 and 4 kVA - so a shared row would have asserted one fact
// where the operator states seven. Split, one row per facility, on the same rule the address rows follow.
//
// HOW THE FIGURES WERE FOUND, because the earlier obligation said they did not exist. The index this
// module first read publishes nothing and names no facility; it passed a SITE control (Equinix 61) and
// would have passed forever. The per-IBX pages are named in the operator's own sitemap-core.xml, and each
// one passes a SUBJECT control (its own IBX code, 13 to 19 occurrences). The distinction between those two
// controls is the whole difference between "the operator publishes no density" and "I was reading the
// wrong page", and this module asserted the first for a day on the evidence of the second.
//
// THE kW COUNT ON THESE PAGES IS A TRAP AND IS RECORDED SO NOBODY RE-TRIPS IT: a search for kW returns one
// hit per page and every one is inside a base64 blob in an inline script, not a unit. The published unit
// is kVA throughout.
//
// WHY A PUBLISHED FIGURE STILL LEAVES THESE ROWS Unread, stated ONCE here rather than seven times in
// seven obligations. The figure is a MINIMUM - the operator's own row label is "Minimum Cabinet
// Density" - and it is a floor a cabinet must commit to, not a ceiling on what one may draw. The two
// arms that could hold a figure, DensityMarketedMax and DensityMarketedAirOnly, are MAXIMA, and a
// minimum in a maximum's field would make cabinet_density_air_ceiling start answering: a consumer
// screening "can this cabinet hold 5 kW" would read a 2 kVA FLOOR as a 2 kVA CAP and exclude a
// facility that may well allow far more. That is strictly worse than an absence, because an absence
// refuses and a wrong ceiling admits a wrong answer confidently. The figure is also APPARENT power -
// kW = kVA x power factor, none published - so 2kVA does not establish 2kW either.
//
// THE FIGURES ARE THEREFORE CARRIED IN PROSE AND THAT IS A KNOWN DEFECT WITH A NAMED REPLACEMENT
// ALREADY BUILT. Review 62872 is right that a read numeric fact living in a NonEmptyStr is DESIGN
// section 2's anemic decomposition: types.dag already carries the quantity as PublishedApparentPower
// over VoltAmpere, and these seven readings are unreachable by any fold, including density_claim_is_read.
//
// THE REPLACEMENT IS A DIRECTION-CARRYING FIGURE, AND IT IS NOT THE SHAPE THIS ANNOTATION FIRST NAMED.
// It is stated as a capability rather than as a pull request because the wording here first named
// gunbc#10885, which is now closed without landing - a trigger naming a dead pull request can never be
// satisfied by anything. I recommended a
// DensityMinimumCommitted arm on CabinetDensityClaim. The carrier owner declined that shape and was
// right to: a fourth arm for a floor needs a fifth for an interval, a sixth for an average, and a
// seventh the first time an operator publishes a floor for air beside a cap for liquid - the
// quantifier forked once per combination, which is the re-invention section 2 forbids. The direction
// of a published figure is ORTHOGONAL to its unit and to its cooling medium, so it becomes one type
// applied at every figure site, PublishedPowerQuantity, with CapabilityAtLeast carrying exactly what
// these seven rows have read. DensityMarketedMax and DensityMarketedAirOnly keep their names and
// their meaning narrows to which COOLINGS were published, never which direction.
//
// TWO PROPERTIES OF THAT DESIGN BEAR ON THESE ROWS. The one this module needed is preserved and
// enforced by execution rather than by this paragraph: cabinet_density_air_ceiling returns Absent for
// CapabilityAtLeast, so these figures can be carried at full precision and still contribute nothing
// to a ceiling. The one neither this module nor its escalation had is that A FLOOR ADMITS - a 2 kVA
// minimum admits a 2 kVA requirement and refuses nothing, which is a real screen and is precisely
// what a prose obligation could never supply. Sending a floor to Absent would have been harmless and
// useless; that is a better answer than the one asked for.
//
// WHEN THE CARRIER CAN HOLD A FIGURE'S DIRECTION AND ITS APPARENT-POWER UNIT, these seven rows move
// from DensityUnread to a floor-shaped published figure carrying the
// wording they already hold, and the resolve step below stays owed, because a floor is genuinely not
// a maximum and the maximum is still unread.

data equinix_ny1_density: CabinetDensityClaim = DensityUnread {
  obligation: "The operator's own NY1 page, www.equinix.com/data-centers/americas-colocation/united-states-colocation/new-york-data-centers/ny1, fetched 2026-09-09 with a full browser user-agent (HTTP 200) and read from RAW HTML against a SUBJECT control (NY1 occurs 19 times), emits a spec-table row labelled exactly \"Minimum Cabinet Density\" with the value \"2kVA\". That is a commitment FLOOR in apparent power, not a maximum and not real power; the annotation above this block states once why neither existing figure arm may hold it. RESOLVE by asking the quote for the per-cabinet air-cooled MAXIMUM at NY1 (165 Halsey Street, Newark)."
}

data equinix_ny2_density: CabinetDensityClaim = DensityUnread {
  obligation: "The operator's own NY2 page, www.equinix.com/data-centers/americas-colocation/united-states-colocation/new-york-data-centers/ny2, fetched 2026-09-09 with a full browser user-agent (HTTP 200) and read from RAW HTML against a SUBJECT control (NY2 occurs 13 times), emits a spec-table row labelled exactly \"Minimum Cabinet Density\" with the value \"2kVA\". That is a commitment FLOOR in apparent power, not a maximum and not real power; the annotation above this block states once why neither existing figure arm may hold it. RESOLVE by asking the quote for the per-cabinet air-cooled MAXIMUM at NY2 (275 Hartz Way, Secaucus)."
}

