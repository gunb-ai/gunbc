  further_citations: []
}

data equinix_ny2: extdeps.colo.types.ColoFacilityRow = extdeps.colo.types.ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY2",
  address: extdeps.colo.types.AddressListed { street: "275 Hartz Way, Secaucus, NJ 07094", citation: "Equinix New York campus pages and PeeringDB fac 36, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Part of the four-building Secaucus campus interconnected by campus cross-connects.",
}

