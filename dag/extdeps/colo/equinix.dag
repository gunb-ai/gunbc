module extdeps.colo.equinix

import std.types { NonEmptyStr, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityUnread, RetailGrainStanding, RetailGrainUnread, SingleCabinetOffered }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.equinix.com/data-centers/americas-colocation/united-states-colocation/new-york-data-centers"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.equinix",
      decl_name: "equinix_secaucus_campus",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data equinix_ny2: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY2",
  address: AddressListed { street: "275 Hartz Way, Secaucus, NJ 07094", citation: "Equinix New York campus pages and PeeringDB fac 36, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Part of the four-building Secaucus campus interconnected by campus cross-connects.",
}

data equinix_ny4: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY4",
  address: AddressListed { street: "755 Secaucus Road, Secaucus, NJ 07094", citation: "Equinix NY4 page, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "The financial-ecosystem flagship of the campus; the deepest carrier and exchange density in the metro.",
}

data equinix_ny5: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY5",
  address: AddressListed { street: "800 Secaucus Road, Secaucus, NJ 07094", citation: "Equinix NY5 page, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Campus building adjacent to NY4.",
}

data equinix_ny6: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY6",
  address: AddressListed { street: "105 Enterprise Avenue, Secaucus, NJ 07094", citation: "Equinix campus listings, read 2026-08-18" },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "Campus building; newest of the four in most directory listings.",
}

data equinix_secaucus_campus: List<ColoFacilityRow> = [equinix_ny2, equinix_ny4, equinix_ny5, equinix_ny6]

data equinix_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "equinix.com sales",
  obligation: "No published cabinet pricing; the operator sells retail cabinets by quote and market surveys consistently place it at the premium end of the metro. Whether to solicit a quote at all is a consumer decision, not a fact about the operator.",
}

data equinix_ny13: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY13",
  address: AddressListed {
    street: "401 Fieldcrest Drive, Elmsford, NY 10523",
    citation: "equinix.com NY13 IBX page, read 2026-09-08",
  },
  municipality: "Elmsford",
  region_code: "NY",
  facility_note: "Westchester County. The operator's own page describes NY13 as serving large financial, media and enterprise companies with premium interconnection - the same wording family as the Secaucus rows, and the same absence of any retail-grain or density statement.",
}

data equinix_ny13_density: CabinetDensityClaim = DensityUnread {
  obligation: "The NY13 page states no kW-per-cabinet figure (read 2026-09-08). Equinix publishes density elsewhere in its marketing; nothing on this facility's page does, and a corporate figure is not a facility reading. Ask for the per-cabinet ceiling at NY13 specifically.",
}

data equinix_ny13_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The NY13 page names colocation and interconnection but does not state whether a single cabinet is a sellable unit at this IBX. The module's existing rate note asserts the operator sells retail cabinets by quote across the metro; that is an operator-level belief and this row does not convert it into a NY13 reading.",
}

data equinix_ny9: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY9",
  address: AddressListed {
    street: "111 8th Avenue, New York, NY 10011",
    citation: "equinix.com NY9 page, read 2026-09-08",
  },
  municipality: "New York",
  region_code: "NY",
  facility_note: "35,898 square feet of colocation, N+1 UPS and generators, N+2 cooling, 120/208 V distribution per the New York campus listing read 2026-09-08. Adjacent IBX NY8 is named on a 2021 spec sheet as also at a Manhattan carrier hotel but is absent from that live campus listing.",
}

data equinix_ny9_density: CabinetDensityClaim = DensityUnread {
  obligation: "The NY9 spec table read 2026-09-08 states a Minimum Cabinet Density of 2 kVA, which is a floor not a marketed maximum, and states no air-cooled or liquid-cooled cabinet ceiling. Do not read 2 kVA as density. A quote or a later spec that names a maximum is required.",
}

data equinix_ny9_retail_grain: RetailGrainStanding = SingleCabinetOffered {
  wording: "Secure Cabinet Express",
  citation: "equinix.com NY9 products table, read 2026-09-08",
}

data equinix_facilities: List<ColoFacilityRow> = [
  equinix_ny2,
  equinix_ny4,
  equinix_ny5,
  equinix_ny6,
  equinix_ny9,
]

data equinix_ny1: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY1",
  address: AddressListed {
    street: "165 Halsey St, Floor 8, Newark, NJ 07102",
    citation: "PeeringDB facility Equinix NY1 - New York, Newark, read 2026-09-08",
  },
  municipality: "Newark",
  region_code: "NJ",
  facility_note: "An Equinix IBX inside the 165 Halsey carrier hotel, on the eighth floor. The census already carries this building three other ways - the building operator (extdeps.colo.halsey_165), a Hivelocity suite, and DataBank EWR1 on floor 5 - so 165 Halsey now stands as the corridor's clearest instance of one building with four separate upstream authorities selling inside it.",
}

data equinix_ny3: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY3",
  address: AddressListed {
    street: "600 Jefferson Avenue, Secaucus, NJ 07094",
    citation: "PeeringDB facility Equinix NY3 - New York, Secaucus, read 2026-09-08",
  },
  municipality: "Secaucus",
  region_code: "NJ",
  facility_note: "A fifth Secaucus IBX, separate from the four-building 800 Secaucus Road campus that equinix_secaucus_campus enumerates - a different street, and a different PeeringDB facility. The 2026-08-18 pass carried the campus and missed this one, which is the failure shape a registry sweep catches and a campus page does not.",
}

data equinix_ny7: ColoFacilityRow = ColoFacilityRow {
  operator_label: "Equinix",
  facility_label: "Equinix NY7",
  address: AddressListed {
    street: "5851 Westside Ave, North Bergen, NJ 07047",
    citation: "PeeringDB facility Equinix NY7 - New York, North Bergen, read 2026-09-08",
  },
  municipality: "North Bergen",
  region_code: "NJ",
  facility_note: "The operator's North Bergen site, in Hudson County between the Secaucus cluster and the Weehawken waterfront. No operator-page reading exists for it; everything beyond name and address is unread.",
}

data equinix_cabinet_density: CabinetDensityClaim = DensityUnread {
  obligation: "CORRECTED 2026-09-09: the 2026-09-08 refusals were my client, not this operator's edge. Re-fetched from raw bytes with an ordinary browser user-agent, equinix.com/data-centers answers HTTP 200 with 225 KB and contains no occurrence of kW or cabinet; the two colocation paths tried on 2026-09-08 answer 404, so they were wrong paths rather than blocked ones. So no per-cabinet kW figure has been read for any corridor IBX, and the reason is that the reachable index does not publish one - not that the operator refuses readers. Resolve by locating the operator's current per-IBX pages, or by asking the quote for the per-cabinet air-cooled maximum at the named IBX; do not import a figure from a directory or from another operator's campus.",
}

data equinix_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "Same correction as the density obligation: the operator's reachable index carries no cabinet, cage or suite wording, so no minimum footprint has been read from its own surface. Whether a single cabinet is contractable, and at which of the seven corridor IBXs, is a quote question.",
}
