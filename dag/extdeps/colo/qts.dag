module extdeps.colo.qts

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types {
  ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly,
  CabinetDensityClaim, DensityUnread,
  RetailGrainStanding, RetailGrainUnread,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "q.com/data-centers/piscataway/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.qts",
      decl_name: "qts_piscataway",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data qts_piscataway: ColoFacilityRow = ColoFacilityRow {
  operator_label: "QTS Data Centers",
  facility_label: "QTS Piscataway (PNJ1)",
  address: AddressListed {
    street: "101 Possumtown Road, Piscataway, NJ 08854",
    citation: "q.com Piscataway 1 data center page (q.com/data-centers/piscataway/), read 2026-09-08. This replaces the earlier directory-profile citation: the operator's own page states the same street address, so the address is now the operator's claim rather than a third party's.",
  },
  municipality: "Piscataway",
  region_code: "NJ",
  facility_note: "Large campus - the operator's own page (read 2026-09-08) states 65 MW+ critical power capacity plus an additional two-story 50,000 square foot 15 MW expansion, which confirms the figure previously carried from a directory with a hybrid retail-plus-hyperscale motion. Roughly a Middlesex County drive from the Hudson waterfront, so it prices against the operator-travel axis rather than the proximity one.",
}

data qts_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "q.com sales",
  obligation: "No published cabinet pricing on pages read 2026-08-18.",
}

// SIXTY-FIVE MEGAWATTS AND NOT ONE KILOWATT PER CABINET. This is the census's cleanest instance of
// the error the density carrier was built to make unwritable: the largest marketed capacity of any
// facility in the roster sits beside a page that never states what one cabinet can draw. Facility
// megawatts are a fact about a building. Dividing 65 MW by any cabinet count would fabricate a
// density, and the row below refuses instead.
data qts_piscataway_density: CabinetDensityClaim = DensityUnread {
  obligation: "The operator's Piscataway 1 page (q.com/data-centers/piscataway/, read 2026-09-08) states 65 MW+ critical power capacity and no per-cabinet or per-rack kilowatt figure anywhere. Counted in RAW BYTES 2026-09-09 rather than through a tag-stripper, because a stripper was found elsewhere in this census to swallow 21 of 22 occurrences of a token and turn a miss into a finding: 308,417 bytes, identical under no user-agent and under a full browser one; positive controls chosen to be SUBJECT tokens rather than site tokens - Piscataway=19 and '65 MW'=1, the facility's own municipality and its own headline capacity, beside the site token QTS=57 which on its own would prove only that the fetch reached q.com - so the instrument reached this FACILITY's surface and not an index of facilities and the megawatt figure is present exactly where the kilowatt one is not; kW=0, kVA=0, kilowatt=0, 'per cabinet'=0, 'per rack'=0. Read a spec sheet or ask the quote for the marketed cabinet maximum. Do not derive one from the 65 MW.",
}

data qts_piscataway_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "The page read 2026-09-08 states no minimum commitment and names no cabinet-grain product. The census's standing read of this operator is a hybrid retail-plus-hyperscale motion, which is precisely the case where the grain question decides whether a one-cabinet order is possible at all; the quote must answer it before this campus is ranked.",
}
