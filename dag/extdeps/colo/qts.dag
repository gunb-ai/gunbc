module extdeps.colo.qts

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.colo.types { ColoFacilityRow, AddressListed, RetailRateStanding, RatesQuoteOnly, CabinetDensityClaim, DensityUnread, RetailGrainStanding, RetailGrainUnread, NoPublishedSurface }

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "q.com/data-centers/piscataway/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.colo.qts",
      decl_name: "qts_piscataway",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data qts_piscataway: ColoFacilityRow = ColoFacilityRow {
  operator_label: "QTS Data Centers",
  facility_label: "QTS Piscataway (PNJ1)",
  address: AddressListed {
    street: "101 Possumtown Road, Piscataway, NJ 08854",
    citation: "datacentermap QTS Piscataway profile, read 2026-08-18",
  },
  municipality: "Piscataway",
  region_code: "NJ",
  facility_note: "Large campus (about 65 MW marketed per datacentermap, read 2026-08-18) with a hybrid retail-plus-hyperscale motion. Roughly a Middlesex County drive from the Hudson waterfront, so it prices against the operator-travel axis rather than the proximity one.",
}

data qts_retail_rates: RetailRateStanding = RatesQuoteOnly {
  contact_route: "q.com sales",
  obligation: "No published cabinet pricing on pages read 2026-08-18.",
}

// A CORRIDOR FACILITY IN THE REGISTRY THAT THE OPERATOR NO LONGER LISTS, recorded as an obligation
// rather than as a facility row, because a row would assert a live site this operator's own surface
// does not claim. PeeringDB carries "QTS Jersey City (JCY1)", 95 Christopher Columbus Drive, Floor
// 16, Jersey City. The operator's own data-centers index, read 2026-09-08, names exactly two New
// Jersey sites - Piscataway and East Windsor - and no Jersey City. Two fetches of Jersey City
// facility paths on q.com returned 404 the same day. The honest state is that the registry entry
// and the operator's index disagree, and the disagreement is what needs reading.
// Establish whether QTS still operates at 95 Christopher Columbus Drive, Jersey City. Its
// PeeringDB facility entry QTS Jersey City (JCY1) was read 2026-09-08 and names floor 16; q.com's
// own facility index read the same day lists only Piscataway and East Windsor in New Jersey, and
// jersey-city paths under q.com 404. Until an operator surface names it, this census carries no
// Jersey City row for QTS - and if the site was exited, the registry entry is what a later sweep
// will trip over, so record the resolution here rather than silently dropping it.
//
// DECLARED FRONTIER, NOT A CONSUMER (DESIGN 3c). Nothing reads this row and nothing can yet: the
// corridor coverage roster joins densities to facilities, and this operator has no facility in the
// corridor - qts_piscataway is Middlesex County, and QTS Jersey City is recorded above as a
// registry-versus-operator disagreement rather than a row. So the density is an orphan by the same
// rule that removed and later restored Colocation America's: a density is a claim ABOUT a facility
// and joins to nothing without one. NAMED CONSUMER: the region roster in gunbc.colo_census_coverage.
// TRIGGER: QTS Jersey City resolving into a facility row, or a Middlesex region row existing for
// Piscataway. Until one of those, this is state two of 3c and not state three.
data qts_cabinet_density: CabinetDensityClaim = DensityUnread {
  cause: NoPublishedSurface {
    obligation: "q.com's data-centers index read 2026-09-08 publishes acreage and site megawatts - 38 acres and 65 MW+ at Piscataway - and no per-cabinet or per-rack kW figure at any site. Site megawatts is not cabinet density. Resolve by quote; note that this operator has no facility in the Hudson-Bergen-Essex corridor that it currently claims.",
  },
}

data qts_retail_grain: RetailGrainStanding = RetailGrainUnread {
  obligation: "No minimum-footprint wording is published on the operator's index read 2026-09-08. The operator's motion is hybrid retail-plus-hyperscale, so whether a single cabinet is contractable is exactly the question a quote must answer rather than one to assume either way.",
}
