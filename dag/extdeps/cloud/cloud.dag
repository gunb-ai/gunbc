module extdeps.cloud.cloud


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.aws.amazon.com/general/latest/gr/"
  }
}

type AwsRegion
  = UsEast1
  | UsEast2
  | UsWest1
  | UsWest2
  | EuWest1
  | EuCentral1
  | ApSoutheast1
  | ApNortheast1

type AwsService
  = S3
  | Iam
  | Sts
  | Ec2
  | Lambda
  | Dynamodb
  | Sqs
  | Sns
  | Kms
  | Secretsmanager

fn aws_region_wire_label(region: AwsRegion) -> String {
  match region {
    UsEast1 => "us-east-1"
    UsEast2 => "us-east-2"
    UsWest1 => "us-west-1"
    UsWest2 => "us-west-2"
    EuWest1 => "eu-west-1"
    EuCentral1 => "eu-central-1"
    ApSoutheast1 => "ap-southeast-1"
    ApNortheast1 => "ap-northeast-1"
  }
}

fn aws_service_wire_label(service: AwsService) -> String {
  match service {
    S3 => "s3"
    Iam => "iam"
    Sts => "sts"
    Ec2 => "ec2"
    Lambda => "lambda"
    Dynamodb => "dynamodb"
    Sqs => "sqs"
    Sns => "sns"
    Kms => "kms"
    Secretsmanager => "secretsmanager"
  }
}

type ServiceEndpoint {
  base_url: String
  version: String
  regional: Bool
}

type RateLimitPolicy {
  requests_per_minute: Int
  burst: Int?
  scope: String
}

type CloudAuthScheme
  = Protocol { scheme: AuthScheme }
  | SigV4 { region: AwsRegion, service: AwsService }
  | OidcToken { audience: String }

type CloudCredential {
  scheme: CloudAuthScheme
  scopes: List<String>?
  expires_seconds: Int?
}

type IdempotencyToken {
  header: String
  format: String
}

type CloudQuota {
  resource: String
  limit: Int
  scope: String
}

type CloudRegion {
  provider: String
  name: String
  display_name: String
}
