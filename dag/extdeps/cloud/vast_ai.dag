module extdeps.cloud.vast_ai

import std.resources { Network }
import std.types { Int, Bool, NonEmptyStr, String, Secret, List }
import std.nat { Nat }
import std.algebra { trim, list_head }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.decimal { ExactDecimal }
import std.measure {
  MoneyAmountMicro,
  money_amount_micro,
  DecimalMoneyPerHourConversion,
  exact_decimal_to_money_per_hour_ceil,
}
import extdeps.currency.currency { CurrencyCode, Usd }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

// VAST.AI, THE GPU MARKETPLACE INTERFACE: what its REST API returns for rentable offers. Read
// 2026-10-11 from docs.vast.ai (search-offers, create-instance). Vast is a marketplace of
// independently operated hosts, so an offer is a host's ask, not a catalog SKU: price, reliability
// and verification vary per machine. This module owns the wire SHAPE only. Which offers this
// repository will rent, and for what role, is supplier policy in product.supplier.vast_ai.
//
// gpu_arch is the host machine's GPU architecture as a string (docs.vast.ai search-offers: "Host machine
// GPU architecture (e.g. nvidia, amd)"). It is optional here because an offer that omits it states no
// architecture; absence is an unread fact, not NVIDIA.
//
// gpu_arch AND verification STAY String ON PURPOSE: the cited text gives gpu_arch as "(e.g. nvidia, amd)",
// an example list rather than a closed set, and the documents read name no verification enumeration. A
// closed enum here would assert a set the upstream does not state; the supplier layer therefore matches
// only the one word it can ground ("nvidia" yields Cuda) and refuses every other or absent value by name.
//
// is_bid marks an interruptible (bid-priced) offer: search-offers `type` is ondemand | bid | reserved and
// bid "may be interrupted if outbid", so an interruptible offer is a different availability fact from an
// on-demand one. Absence is an unread fact.
//
// MONEY WIRE FIELDS ARE ExactDecimal, NEVER Float: search-offers min_bid, dph_total, storage_cost,
// inet_up_cost and inet_down_cost arrive as JSON numbers. min_bid and dph_total convert with
// std.measure exact_decimal_to_money_per_hour_ceil (round up). storage_cost ($/GB-month) and
// inet_up_cost / inet_down_cost ($/GB) stay ExactDecimal: a MoneyAmountMicro wrapper would drop
// the quantity axis. gpu_ram is an Int of megabytes on the REST wire (docs.vast.ai: CLI GB,
// REST MB). search-offers driver_version is a host NVIDIA driver string (e.g. "580.65.06");
// ingest is vast_ai_driver_version_from_search_offers_text. num_gpus is an Int and
// IS a request axis: an offer is a machine with that many GPUs, rented whole.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.vast.ai/api-reference/search/search-offers" }
}

data vast_ai_create_instance_page: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.vast.ai/api-reference/instances/create-instance" }
}

data vast_ai_show_instances_page: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.vast.ai/api-reference/instances/show-instances" }
}

data vast_ai_show_charges_page: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.vast.ai/api-reference/billing/show-charges" }
}

data vast_ai_destroy_instance_page: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.vast.ai/api-reference/instances/destroy-instance" }
}

data vast_ai_change_bid_page: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.vast.ai/api-reference/instances/change-bid" }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cloud.vast_ai",
      decl_name: "vast_ai_api_base",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [
    vast_ai_create_instance_page,
    vast_ai_show_instances_page,
    vast_ai_show_charges_page,
    vast_ai_destroy_instance_page,
    vast_ai_change_bid_page,
  ]
}

data vast_ai_api_base: NonEmptyStr = "https://console.vast.ai/api/v0"

// show instances is documented at GET /api/v1/instances, not under the v0 base SearchOffers uses.
data vast_ai_api_v1_base: NonEmptyStr = "https://console.vast.ai/api/v1"

type VastAiApiError {
  success: Bool
  error: String
  msg: String
}

// ONE OFFER from POST /bundles: id is the ask contract a rental names (PUT /asks/{id}).
type VastAiOffer {
  id: Int
  machine_id: Int
  gpu_name: String
  num_gpus: Int
  compute_cap: Int
  gpu_arch: String?
  verification: String
  geolocation: String
  rentable: Bool
  rented: Bool
  is_bid: Bool?
  min_bid: ExactDecimal
  dph_total: ExactDecimal
  storage_cost: ExactDecimal
  inet_up_cost: ExactDecimal
  inet_down_cost: ExactDecimal
  gpu_ram: Int
  driver_version: String?
  cuda_max_good: ExactDecimal?
  inet_down: ExactDecimal?
}

// THE HOST-RESOURCE FIELDS OF THE SAME search-offers OFFER OBJECT, read 2026-10-17 from
// docs.vast.ai/api-reference/search/search-offers. The page declares each offer additionalProperties: true
// and gives no response descriptions, so the meaning of each field is the page's request-filter text, and
// the types are those of its example values: cpu_arch string, example amd64, "Host machine CPU
// architecture (Default is amd64)"; cpu_cores integer, "Number of virtual CPUs"; cpu_ram integer, "CPU RAM
// in MB"; disk_space number, "Disk storage space in GB". The page states MB and GB and not whether they are
// decimal or binary, so those are carried as the quantities the page prints and the byte basis is a
// separate standing at the consumer. show-instances (docs.vast.ai/api-reference/instances/show-instances)
// lists the same names with NO units, so it is deliberately not a source for cpu_ram or disk_space.
// This is a separate type from VastAiOffer, not extra fields on it, because it is the same wire object read
// for a different question (what a rented guest is entitled to). id is the offer (ask) id of that row, the
// same id VastAiOffer.id carries, and no VastAiOffer constructor owes it.
type VastAiOfferHostResources {
  id: Int
  cpu_arch: String
  cpu_cores: Int
  cpu_ram: Int
  disk_space: ExactDecimal
}

// search-offers JSON driver_version is a string or null. Unread is JSON null/omitted.
// Malformed is a present string that is not dotted decimal with a non-negative major.
// Parse at vast_ai_ingest_search_offer_driver; the Search consumer must call that ingest.
type VastAiDriverVersion {
  major: Nat
}

type VastAiDriverVersionStanding
  = VastAiDriverVersionRead { version: VastAiDriverVersion }
  | VastAiDriverVersionUnread
  | VastAiDriverVersionMalformed { raw: String }

fn vast_ai_driver_version_read(major: Nat) -> VastAiDriverVersionStanding {
  VastAiDriverVersionRead { version: VastAiDriverVersion { major: major } }
}

fn vast_ai_ingest_search_offer_driver(offer: VastAiOffer) -> VastAiDriverVersionStanding {
  vast_ai_driver_version_from_search_offers_text(raw: offer.driver_version)
}

fn vast_ai_driver_version_from_search_offers_text(raw: String?) -> VastAiDriverVersionStanding {
  match raw {
    Absent => VastAiDriverVersionUnread
    Present { value: text } =>
      if trim(s: text) == "" {
        VastAiDriverVersionMalformed { raw: text }
      } else {
        match list_head(xs: split(s: trim(s: text), delimiter: ".")) {
          Absent => VastAiDriverVersionMalformed { raw: text }
          Present { value: head } =>
            match parse_int(s: head) {
              Absent => VastAiDriverVersionMalformed { raw: text }
              Present { value: major } =>
                if (major < 0) {
                  VastAiDriverVersionMalformed { raw: text }
                } else {
                  vast_ai_driver_version_read(major: major)
                }
            }
        }
      }
  }
}

data vast_ai_quote_currency: CurrencyCode = Usd

// Adapter product.fabric.flex_vast_shadow flex_shadow_bid calls this wrapper. DECLARED FRONTIER
// (DESIGN §3c): a non-test executing route that remains if the witness is deleted. TRIGGER: an
// instrument or wet readonly Search that calls flex_shadow_bid. Until then the executing consumer
// is test.claim.fabric.flex_vast_shadow_witness (and the inhabitance arm of
// vast_min_bid_rounds_up_a_seventh_fraction_digit).
fn vast_ai_min_bid_money_per_hour(offer: VastAiOffer) -> DecimalMoneyPerHourConversion {
  exact_decimal_to_money_per_hour_ceil(d: offer.min_bid, currency: vast_ai_quote_currency)
}

// DECLARED FRONTIER (DESIGN §3c): production consumer is the on-demand acquisition fold that
// prices from dph_total rather than min_bid. TRIGGER: that fold calls this wrapper. Until then
// the executing consumer is the inhabitance arm of vast_min_bid_rounds_up_a_seventh_fraction_digit.
fn vast_ai_dph_total_money_per_hour(offer: VastAiOffer) -> DecimalMoneyPerHourConversion {
  exact_decimal_to_money_per_hour_ceil(d: offer.dph_total, currency: vast_ai_quote_currency)
}

type VastAiOffers {
  offers: List<VastAiOffer>
}

service vast_ai.SearchOffers {
  config {
    endpoint: vast_ai_api_base
    auth: Bearer
    auth_input: api_key
  }

  operation Search {
    requires Network
    input {
      api_key: Secret
      search_type: String
      limit: Int
    }
    output {
      offers: List<VastAiOffer> from "offers"
    }
    readonly
    transport rest {
      method: POST,
      path: "/bundles/",
      body: { type: search_type, limit: limit }
    }
    response {
      200 => VastAiOffers
      401 => VastAiApiError
      429 => VastAiApiError
      5xx => VastAiApiError
    }
  }
}

// search-offers `type` is ondemand | bid | reserved (docs.vast.ai search-offers). Flex interruptible
// screening asks for bid. The string is the vendor's token, not a closed enum: the document gives
// examples rather than a finite set.
data vast_ai_search_type_bid: String = "bid"
data vast_ai_search_type_ondemand: String = "ondemand"
data vast_ai_search_limit_default: Int = 100

// ONE INSTANCE from GET /api/v1/instances. id is the contract (create-instance returns it as
// new_contract). machine_id is the host the offer named. gpu_ram is MB. min_bid / dph_total are
// ExactDecimal for the same reason offers are. actual_status is optional: the document types it
// string | null. No create or destroy operation is declared in this module.
type VastAiInstance {
  id: Int
  machine_id: Int
  actual_status: String?
  gpu_name: String
  gpu_ram: Int
  num_gpus: Int
  image_uuid: String
  is_bid: Bool?
  min_bid: ExactDecimal
  dph_total: ExactDecimal
  label: String?
}

fn vast_ai_instance_dph_total_money_per_hour(instance: VastAiInstance) -> DecimalMoneyPerHourConversion {
  exact_decimal_to_money_per_hour_ceil(d: instance.dph_total, currency: vast_ai_quote_currency)
}

type VastAiInstances {
  success: Bool
  instances_found: Int
  total_instances: Int
  next_token: String?
  instances: List<VastAiInstance>
}

data vast_ai_keyset_page_limit: Int = 25

service vast_ai.Instances {
  config {
    endpoint: vast_ai_api_v1_base
    auth: Bearer
    auth_input: api_key
  }

  operation Show {
    requires Network
    input {
      api_key: Secret
      select_filters: String
      limit: Int
      after_token: String?
    }
    output {
      instances: List<VastAiInstance> from "instances"
      next_token: String? from "next_token"
      total_instances: Int from "total_instances"
    }
    readonly
    transport rest {
      method: GET,
      path: "/instances",
      query: { select_filters: select_filters, limit: limit, after_token: after_token }
    }
    response {
      200 => VastAiInstances
      400 => VastAiApiError
      401 => VastAiApiError
      429 => VastAiApiError
    }
  }
}

// ONE CONTRACT CHARGE from GET /api/v0/charges. amount is ExactDecimal (the document's float).
// select_filters is the documented JSON string; day.gte and day.lte are required by the vendor.
type VastAiChargeItem {
  start: Int
  end: Int
  type: String
  amount: ExactDecimal
  description: String
}

type VastAiCharge {
  start: Int
  end: Int
  type: String
  source: String
  description: String
  amount: ExactDecimal
  items: List<VastAiChargeItem>
}

type VastAiCharges {
  success: Bool
  count: Int
  total: Int
  next_token: String?
  results: List<VastAiCharge>
}

// WHO A CHARGE ROW BELONGS TO, AS VAST DOCUMENTS IT. docs.vast.ai/api-reference/billing/show-charges
// (operationId showCharges, GET /api/v0/charges): results[].source is "Identifier in the form
// {type}-{id}. For tree-format serverless wrappers, uses endpoint-<id> or workergroup-<id>", and
// results[].type is instance, volume or serverless. items[].source is nullable, so attribution is read
// from the contract row only. Nothing else in a row names an instance: metadata carries template_id,
// label, endpoint_id and workergroup_id, none of which is one. A source that matches no documented
// prefix is Unrecognized, never read as an instance.
type VastAiChargeSourceKind
  = VastAiChargeFromInstance
  | VastAiChargeFromVolume
  | VastAiChargeFromServerless
  | VastAiChargeFromEndpoint
  | VastAiChargeFromWorkergroup
  | VastAiChargeSourceUnrecognized

data vast_ai_charge_instance_prefix: String = "instance-"

fn vast_ai_charge_source_kind(source: String) -> VastAiChargeSourceKind {
  if starts_with(s: source, prefix: vast_ai_charge_instance_prefix) {
    VastAiChargeFromInstance
  } else if starts_with(s: source, prefix: "volume-") {
    VastAiChargeFromVolume
  } else if starts_with(s: source, prefix: "serverless-") {
    VastAiChargeFromServerless
  } else if starts_with(s: source, prefix: "endpoint-") {
    VastAiChargeFromEndpoint
  } else if starts_with(s: source, prefix: "workergroup-") {
    VastAiChargeFromWorkergroup
  } else {
    VastAiChargeSourceUnrecognized
  }
}

// The source string Vast writes for one instance contract. Compared whole, so instance-10 never matches
// instance-100.
fn vast_ai_instance_charge_source(instance_id: NonEmptyStr) -> String {
  concat(vast_ai_charge_instance_prefix, instance_id as String)
}

// The REQUIRED select_filters day range of GET /charges: day.gte and day.lte, unix seconds UTC (same
// page). A request without it is the documented 400 missing_date_range.
type VastAiChargesDayRange {
  gte: Int
  lte: Int
}

type VastAiChargesRefusal
  = VastAiChargesMissingDateRange
  | VastAiChargesRefusedStatus { status: Int }

// The page documents 400 with error code missing_date_range for an absent day range; any other
// non-200 is a refusal that names only its status.
fn vast_ai_charges_refusal(status: Int, error: String) -> VastAiChargesRefusal {
  if status == 400 && error == "missing_date_range" {
    VastAiChargesMissingDateRange
  } else {
    VastAiChargesRefusedStatus { status: status }
  }
}

// amount is a float "rounded to 3 decimals" (same page): each row is within half of one thousandth of a
// dollar of the contract's true total, which is 500 micro-dollars.
data vast_ai_charge_amount_rounding: MoneyAmountMicro = money_amount_micro(count: 500)

service vast_ai.Charges {
  config {
    endpoint: vast_ai_api_base
    auth: Bearer
    auth_input: api_key
  }

  operation Show {
    requires Network
    input {
      api_key: Secret
      select_filters: String
      limit: Int
      after_token: String?
    }
    output {
      results: List<VastAiCharge> from "results"
      next_token: String? from "next_token"
      total: Int from "total"
    }
    readonly
    transport rest {
      method: GET,
      path: "/charges",
      query: { select_filters: select_filters, limit: limit, after_token: after_token }
    }
    response {
      200 => VastAiCharges
      400 => VastAiApiError
      401 => VastAiApiError
      403 => VastAiApiError
      404 => VastAiApiError
      429 => VastAiApiError
    }
  }
}

// WRITE SHAPES. Transport binding and execution belong to the wet consumer
// (product.fabric.flex_market frontiers / bright-moth-475). label is REQUIRED on
// this model's Create so an unlabelled rent is unwritable; Vast's OpenAPI lists
// label as optional.

type VastAiCreateAskRequest {
  price: ExactDecimal
  disk: Int
  template_hash_id: NonEmptyStr
  label: NonEmptyStr
}

type VastAiCreateAskResult {
  success: Bool
  new_contract: Int
}

type VastAiDestroyResult {
  success: Bool
  msg: String
}

type VastAiChangeBidRequest {
  price: ExactDecimal
}

type VastAiChangeBidResult {
  success: Bool
}

service vast_ai.Asks {
  config {
    endpoint: vast_ai_api_base
    auth: Bearer
    auth_input: api_key
  }

  operation Create {
    requires Network
    input {
      api_key: Secret
      offer_id: Int
      price: ExactDecimal
      disk: Int
      template_hash_id: NonEmptyStr
      label: NonEmptyStr
    }
    output {
      success: Bool from "success"
      new_contract: Int from "new_contract"
    }
    transport rest {
      method: PUT,
      path: "/asks/\{offer_id\}/",
      body: { price: price, disk: disk, template_hash_id: template_hash_id, label: label }
    }
    response {
      200 => VastAiCreateAskResult
      400 => VastAiApiError
      401 => VastAiApiError
      403 => VastAiApiError
      404 => VastAiApiError
      410 => VastAiApiError
      429 => VastAiApiError
      5xx => VastAiApiError
    }
  }
}

service vast_ai.InstanceLifecycle {
  config {
    endpoint: vast_ai_api_base
    auth: Bearer
    auth_input: api_key
  }

  operation Destroy {
    requires Network
    input {
      api_key: Secret
      instance_id: Int
    }
    output {
      success: Bool from "success"
    }
    transport rest {
      method: DELETE,
      path: "/instances/\{instance_id\}/"
    }
    response {
      200 => VastAiDestroyResult
      400 => VastAiApiError
      404 => VastAiApiError
      429 => VastAiApiError
      5xx => VastAiApiError
    }
  }

  operation ChangeBid {
    requires Network
    input {
      api_key: Secret
      instance_id: Int
      price: ExactDecimal
    }
    output {
      success: Bool from "success"
    }
    idempotent
    transport rest {
      method: PUT,
      path: "/instances/bid_price/\{instance_id\}/",
      body: { price: price }
    }
    response {
      200 => VastAiChangeBidResult
      400 => VastAiApiError
      401 => VastAiApiError
      404 => VastAiApiError
      429 => VastAiApiError
      5xx => VastAiApiError
    }
  }
}
