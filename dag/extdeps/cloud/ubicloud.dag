data ubicloud_standard_4_arm_catalog: UbicloudRunnerCatalogRow = UbicloudRunnerCatalogRow {
  runner_type: Standard4Arm,
  runs_on_label: "ubicloud-standard-4-arm",
  vcpus: hardware_thread_count(4),
  memory_bytes: byte_size(12000000000),
  disk_bytes: byte_size(150000000000),
