fn ubicloud_runner_catalog() -> List<UbicloudRunnerCatalogRow> {
  [
    ubicloud_standard_2_catalog,
    ubicloud_standard_4_catalog,
    ubicloud_standard_8_catalog,
    ubicloud_standard_16_catalog,
    ubicloud_standard_30_catalog,
    ubicloud_standard_2_arm_catalog,
    ubicloud_standard_4_arm_catalog,
    ubicloud_standard_8_arm_catalog,
    ubicloud_standard_16_arm_catalog,
    ubicloud_standard_30_arm_catalog
  ]
}

// THE vCPU-TO-PHYSICAL-CORE MAPPING, lifted out of the catalog citation note
// and into a typed carrier. The vendor states it as a per-architecture fact:
// x64 runners map every two vCPUs onto one physical core, arm64 runners back
// each vCPU with a dedicated physical core. It was prose until a consumer
// needed it, and a machine-consumed fact living only in a String is exactly
// the modeling debt DESIGN section 4c names.
//
// Why this is load-bearing rather than trivia: the vendor's published
// memory-per-vCPU figures are 4GB on x64 and 3GB on arm64, and those two
// numbers are NOT comparable until the denominator is named. Read per
// PHYSICAL CORE the same rows say 8GB on x64 against 3GB on arm64 — a
// different ordering and a different ratio. A provisioning decision that
// compares 3 with 4 without carrying this mapping is comparing across two
// measurement frames.
//
// The partial projection is deliberate: the vendor publishes runner rows for
// exactly two architectures, so the arms this returns are the ones the cited
// surface actually states. Every other architecture REFUSES rather than
// receiving a fabricated default.
type UbicloudThreadsPerPhysicalCore
  = ThreadsPerPhysicalCore { count: std.nat.Nat }
  | ThreadsPerCoreUnpublished { architecture: extdeps.toolchain.types.Architecture }

fn ubicloud_threads_per_physical_core(architecture: extdeps.toolchain.types.Architecture) -> UbicloudThreadsPerPhysicalCore {
  match architecture {
    X86_64 => ThreadsPerPhysicalCore { count: 2 }
    Aarch64 => ThreadsPerPhysicalCore { count: 1 }
    X86 => ThreadsPerCoreUnpublished { architecture: architecture }
    Arm => ThreadsPerCoreUnpublished { architecture: architecture }
    Armv7 => ThreadsPerCoreUnpublished { architecture: architecture }
    Mips => ThreadsPerCoreUnpublished { architecture: architecture }
    Mipsel => ThreadsPerCoreUnpublished { architecture: architecture }
    Mips64 => ThreadsPerCoreUnpublished { architecture: architecture }
    Mips64el => ThreadsPerCoreUnpublished { architecture: architecture }
    Riscv64 => ThreadsPerCoreUnpublished { architecture: architecture }
    Wasm32 => ThreadsPerCoreUnpublished { architecture: architecture }
  }
}

// THIS MODULE'S ROWS PROJECTED INTO THE AGNOSTIC CI-RUNNER SHAPE, so a
// cross-provider comparison can consume them without re-citing this page or
// forking these figures. The projection lives here, beside the rows it reads,
// rather than in the consumer: the mapping from this vendor's catalog to the
// shared contract is a fact about THIS vendor's surface.
//
// Two axes are stated here that most providers leave unstated, and both come
// from the citation note above rather than from a default: the entitlement
// (an arm64 vCPU is a dedicated physical core; an x64 vCPU is one of two
// threads on one core), and the byte basis (this module records the vendor's
// decimal-suffixed figure read as decimal GB, so its rows take the DECIMAL
// arm where every other surveyed provider takes the basis-less one).
fn ubicloud_shape_entitlement(architecture: extdeps.toolchain.types.Architecture) -> CpuEntitlement {
  match ubicloud_threads_per_physical_core(architecture: architecture) {
    ThreadsPerPhysicalCore { count } =>
      if count == 1 { DedicatedPhysicalCore } else { SmtSharedVcpu { threads_per_core: count } }
    ThreadsPerCoreUnpublished { architecture } => EntitlementUnstated
  }
}

data ubicloud_provider_identity: DeclarationRef = decl_ref(
  module_path: "extdeps.cloud.ubicloud",
  decl_name: "ubicloud_runner_types_authority",
)

fn ubicloud_runner_shape(row: UbicloudRunnerCatalogRow) -> RunnerShapeRow {
  RunnerShapeRow {
    provider: ubicloud_provider_identity,
    label: row.runs_on_label,
    architecture: row.cpu_architecture,
    entitlement: ubicloud_shape_entitlement(architecture: row.cpu_architecture),
    vcpus: row.vcpus,
    memory: QuotedDecimalGigabytes {
      value: gigabyte(count: byte_size_count(b: row.memory_bytes) / 1000000000),
    },
  }
}

data ubicloud_runner_catalog_shapes: RunnerCatalogAvailability = RunnerShapesCited {
  rows: map(ubicloud_runner_catalog(), r => ubicloud_runner_shape(row: r)),
}
