data ubicloud_standard_30_catalog: UbicloudRunnerCatalogRow = UbicloudRunnerCatalogRow {
  runner_type: Standard30,
  runs_on_label: "ubicloud-standard-30",
  vcpus: hardware_thread_count(30),
  memory_bytes: byte_size(120000000000),
  disk_bytes: byte_size(400000000000),
  cpu_architecture: X86_64
