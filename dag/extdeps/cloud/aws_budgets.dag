module extdeps.cloud.aws_budgets

import std.types { Int, NonEmptyStr, String, List }
import std.decimal { ExactDecimal }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

// AWS BUDGETS, the shapes of the backstop the flex plan uses: a cost budget and a budget action that
// attaches an IAM policy (a deny of ec2:RunInstances) to the flex principal when actual cost crosses a
// threshold. API version 2016-10-20. Read 2026-10-23. A budget is evaluated on billing data that lags
// usage, so the action is a backstop behind the loop's own liability ceiling, never the ceiling itself.
// This module owns the shapes only; the amount, threshold and principal are policy (product.fabric).
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.aws.amazon.com/aws-cost-management/latest/APIReference/API_budgets_CreateBudgetAction.html" }
}

data aws_budgets_create_budget_page: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.aws.amazon.com/aws-cost-management/latest/APIReference/API_budgets_CreateBudget.html" }
}

data aws_budgets_controls_page: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.aws.amazon.com/cost-management/latest/userguide/budgets-controls.html" }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cloud.aws_budgets",
      decl_name: "aws_budgets_api_version",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [aws_budgets_create_budget_page, aws_budgets_controls_page]
}

data aws_budgets_api_version: NonEmptyStr = "2016-10-20"

type AwsBudgetTimeUnit
  = AwsBudgetDaily
  | AwsBudgetMonthly
  | AwsBudgetQuarterly
  | AwsBudgetAnnually

// Spend: amount as a decimal string on the wire, with its unit (a currency code such as USD).
type AwsBudgetSpend {
  amount: ExactDecimal
  unit: NonEmptyStr
}

// Cost filters narrow the budget, e.g. to a cost-allocation tag (`user:<key>$<value>`) so the budget
// counts only the flex owner tag's spend.
type AwsBudgetCostFilter {
  name: NonEmptyStr
  values: List<String>
}

type AwsBudget {
  budget_name: NonEmptyStr
  budget_limit: AwsBudgetSpend
  time_unit: AwsBudgetTimeUnit
  cost_filters: List<AwsBudgetCostFilter>
}

type AwsBudgetNotificationType
  = AwsBudgetActual
  | AwsBudgetForecasted

type AwsBudgetThresholdType
  = AwsBudgetPercentage
  | AwsBudgetAbsoluteValue

type AwsBudgetActionThreshold {
  value: ExactDecimal
  threshold_type: AwsBudgetThresholdType
}

type AwsBudgetApprovalModel
  = AwsBudgetAutomatic
  | AwsBudgetManual

// ActionType APPLY_IAM_POLICY with an IamActionDefinition: the managed policy to attach and the roles or
// users to attach it to. The other two action types (SCP, RUN_SSM_DOCUMENTS) are not used and not modeled.
type AwsBudgetIamActionDefinition {
  policy_arn: NonEmptyStr
  roles: List<NonEmptyStr>
  users: List<NonEmptyStr>
}

type AwsBudgetSubscriber {
  subscription_type: NonEmptyStr
  address: NonEmptyStr
}

type AwsCreateBudgetActionRequest {
  budget_name: NonEmptyStr
  notification_type: AwsBudgetNotificationType
  action_threshold: AwsBudgetActionThreshold
  definition: AwsBudgetIamActionDefinition
  execution_role_arn: NonEmptyStr
  approval_model: AwsBudgetApprovalModel
  subscribers: List<AwsBudgetSubscriber>
}

type AwsCreateBudgetActionResponse {
  budget_name: NonEmptyStr
  action_id: NonEmptyStr
}
