// THE CURRENT EUR TARIFF, and its USD sibling below, both read from the vendor's price-adjustment
// document on 2026-09-06. Carrying both currencies as separate rows rather than one row plus a
// conversion is the point: the vendor publishes each, so neither has to be derived, and a reader
// wanting dollars is never handed an exchange-rate estimate labelled as a quote.
data cax41_catalog: HetznerCloudServerCatalogRow = HetznerCloudServerCatalogRow {
  server_type: Cax41,
  vcpus: hardware_thread_count(16),
  memory_bytes: byte_size(34359738368),
  disk_bytes: byte_size(343597383680),
  hourly: money_amount_micro(count: 65700),
  monthly_cap: money_amount_micro(count: 40990000),
  currency: Eur,
  tariff: TariffEffectiveFrom {
    date: "2026-06-15 08:00 CEST",
    citation: "new-price column, price-adjustment document GE-D9256",
  },
  pricing_citation: "GE-D9256 (new-price column, EUR)",
  cpu_architecture: Aarch64,
}

data cax41_catalog_usd: HetznerCloudServerCatalogRow = HetznerCloudServerCatalogRow {
  server_type: Cax41,
  vcpus: hardware_thread_count(16),
  memory_bytes: byte_size(34359738368),
  disk_bytes: byte_size(343597383680),
  hourly: money_amount_micro(count: 77700),
  monthly_cap: money_amount_micro(count: 48490000),
  currency: Usd,
  tariff: TariffEffectiveFrom {
