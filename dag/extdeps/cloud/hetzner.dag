  wire_label: "cax11", cpu_architecture: Aarch64,
  vcpus: hardware_thread_count(2), memory_bytes: byte_size(4294967296), disk_bytes: byte_size(42949672960),
  hourly: MoneyPerHour { amount: money_amount_micro(count: 11000), currency: Usd },
  monthly: MoneyPerMonth { amount: money_amount_micro(count: 6990000), currency: Usd },
  regions_observed: hetzner_regions_read,
  observation: hetzner_cloud_console_observation,
}

