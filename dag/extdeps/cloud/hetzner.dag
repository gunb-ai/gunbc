fn hetzner_approved_subcontractors() -> List<HetznerApprovedSubcontractor> {
  [
    hetzner_subcontractor_finland,
    hetzner_subcontractor_us_server_rental,
    hetzner_subcontractor_us_colocation_sacramento,
    hetzner_subcontractor_us_colocation_hillsboro,
