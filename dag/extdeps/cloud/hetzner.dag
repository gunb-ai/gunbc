  ]
}

fn hetzner_subcontractors_for_server_location(location: NonEmptyStr) -> List<HetznerApprovedSubcontractor> {
  filter(hetzner_approved_subcontractors(), s => s.server_location == location)
}

// THE LOCATION ROWS, WHICH ARE WHAT A ROUTE'S REGION AND A PATH'S JURISDICTION CITE. HetznerCloudRegion
// above is a closed coproduct of the two regions this repository has read prices for; these rows add
// the facts a route needs and a price list does not carry -- the wire code, the country the vendor
// itself names, the network zone that bounds where a snapshot may be placed, and who operates the park.
//
// country IS THE VENDOR'S OWN WORD AND NOT A LOOKUP FROM THE CITY. The locations page writes
// Helsinki (Finland) and Nuremberg (Germany) in the same sentence as owns and operates, so the
// country is transcribed from upstream rather than derived from a place name -- which is the
// difference between a citation and a guess.

type HetznerServerLocationRow {
  region: HetznerCloudRegion
  location_code: NonEmptyStr
  country: NonEmptyStr
  network_zone: NonEmptyStr
  operated_by: HetznerLegalEntity
  reading: HetznerPublishedReading
}

data hetzner_location_helsinki: HetznerServerLocationRow = HetznerServerLocationRow {
  region: Helsinki,
  location_code: "hel1",
  country: "Finland",
  network_zone: "eu-central",
  operated_by: hetzner_online_gmbh,
  reading: hetzner_locations_reading,
}

data hetzner_location_nuremberg: HetznerServerLocationRow = HetznerServerLocationRow {
  region: Nuremberg,
  location_code: "nbg1",
  country: "Germany",
  network_zone: "eu-central",
  operated_by: hetzner_online_gmbh,
  reading: hetzner_locations_reading,
}

// SUPPORT IS AN ORGANISATION, NOT A LOCATION, and it is a separate row for exactly that reason. The
// tempting shortcut is to answer a support-access question with the server's location row, which is
// the vendor-region-label error the route model exists to refuse: the technicians are where upstream
// says they are, which for this vendor is Germany for every location it serves.

type HetznerSupportOrganisation {
  provided_by: HetznerLegalEntity
  country: NonEmptyStr
  reading: HetznerPublishedReading
}

data hetzner_customer_support_organisation: HetznerSupportOrganisation = HetznerSupportOrganisation {
  provided_by: hetzner_online_gmbh,
  country: "Germany",
  reading: hetzner_locations_reading,
}
