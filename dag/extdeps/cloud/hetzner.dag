  uri: Uri {
    scheme: Https
    locator: "docs.hetzner.com/cloud/servers/overview"
  }
}

type HetznerCloudServerType = Cax11 | Cax21 | Cax31 | Cax41

data hetzner_money_rate_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.cloud.hetzner", decl_name: "HetznerCloudServerCatalogRow"),
    reason: "hourly/monthly_cap: MoneyAmountMicro + separate currency forks std.measure MoneyRate<P> (MoneyPerHour/MoneyPerMonth); parallel representation fork",
    dissolution: unbound_dissolution(description: "next hetzner-cloud catalog edit routes hourly and monthly_cap through MoneyPerHour/MoneyPerMonth"),
  )
]

// A PRICE WITHOUT THE DATE IT APPLIES FROM IS NOT A PRICE, IT IS A PRICE-SHAPED HOLE. This field
// was added after the row below was found carrying the SUPERSEDED tariff - cited, correctly, to a
// document whose entire subject is that the figure changed. The citation was to the right page and
// to the wrong column, and nothing in the type could tell the two apart, because the row recorded
// WHAT the vendor charged and never WHEN.
//
// The damage was not the stale number itself. A consumer joined this row's EUR figure to a
// separately observed USD figure and concluded the vendor charged about a third more in dollars
// than its own euro price converted - a currency premium that does not exist. Old EUR against new
// USD is not a currency comparison at all. Both tariffs are internally FX-consistent to within a
// couple of per cent.
type TariffStanding
  = TariffEffectiveFrom { date: NonEmptyStr, citation: NonEmptyStr }
  | TariffSuperseded { superseded_on: NonEmptyStr, successor: NonEmptyStr, citation: NonEmptyStr }

fn tariff_is_current(t: TariffStanding) -> Bool {
  match t {
    TariffEffectiveFrom { date, citation } => true,
    TariffSuperseded { superseded_on, successor, citation } => false,
  }
}

type HetznerCloudServerCatalogRow {
  server_type: HetznerCloudServerType
  vcpus: HardwareThreadCount
  memory_bytes: ByteSize
  disk_bytes: ByteSize
  hourly: MoneyAmountMicro
  monthly_cap: MoneyAmountMicro
  currency: CurrencyCode
  tariff: TariffStanding
  pricing_citation: NonEmptyStr
  cpu_architecture: Architecture
}

