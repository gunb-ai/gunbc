// ---------------------------------------------------------------------------------------------
// WHAT THIS VENDOR PUBLISHES ABOUT ITS DATA PATHS, AS OPPOSED TO ITS PRICES.
//
// Everything above this line is catalog and tariff. A route admission asks a different question --
// where the execution, the storage, the backups, the logs, the support and the administrators of a
// given location actually sit -- and the answer is in a different set of the vendor's documents.
// They are read here rather than in the product layer for the reason DESIGN section 3 gives: an
// independently governed upstream owns its own facts, and what we are willing to do with them is a
// fact about us.
//
// EACH ROW CARRIES THE DOCUMENT, THE DATE IT WAS READ, AND THE SENTENCE IT WAS READ FOR. The
// statement field is a TRANSCRIPTION of upstream's own words, not commentary about them: it is the
// fact, and the authority beside it is where a later reader re-reads it. A reading is therefore
// dated and never silently refreshed -- upstream edits a page without telling anyone, so a
// statement that no longer appears at its URI is a NEW reading with a later date, exactly as
// TariffStanding above keeps a superseded tariff rather than overwriting it.

type HetznerPublishedReading {
  authority: ExternalAuthority
  read_on: NonEmptyStr
  statement: NonEmptyStr
}

data hetzner_locations_reading: HetznerPublishedReading = HetznerPublishedReading {
  authority: ExternalAuthority { uri: Uri { scheme: Https, locator: "docs.hetzner.com/cloud/general/locations/" } },
  read_on: "2026-09-12",
  statement: "The location table maps network zone eu-central to fsn1 (DE Falkenstein), nbg1 (DE Nuremberg) and hel1 (FI Helsinki); us-east to ash (US Ashburn, VA), us-west to hil (US Hillsboro, OR) and ap-southeast to sin (SG Singapore). The page states: Hetzner owns and operates three data center parks located in Nuremberg (Germany), Falkenstein (Germany) and Helsinki (Finland). It also states: Hetzner's own team of technicians in Germany provides customer support for the Hetzner Cloud servers in Europe, the USA, and Singapore. The zone and location roster is introduced as the CURRENT one, so its closure is a fact about the read date and not a permanent one.",
}

data hetzner_backup_snapshot_reading: HetznerPublishedReading = HetznerPublishedReading {
  authority: ExternalAuthority { uri: Uri { scheme: Https, locator: "docs.hetzner.com/cloud/servers/backups-snapshots/faq/" } },
  read_on: "2026-09-12",
  statement: "Backups are in the same location as the cloud server they were created from, but usually in a different data center. In Hillsboro and in Singapore only one data center is in use, which is why those locations are a little bit different. There, Backups are always saved in the same data center as the server. Snapshots are automatically in a different location than the cloud server they were created from. The location itself is allocated randomly and cannot be changed. The location has to be in the same network zone, which is why Ashburn, Hillsboro and Singapore are a little bit different. There Snapshots are in the same location as the server.",
}

data hetzner_subcontractor_appendix_reading: HetznerPublishedReading = HetznerPublishedReading {
  authority: ExternalAuthority { uri: Uri { scheme: Https, locator: "www.hetzner.com/AV/DPA_en.pdf" } },
  read_on: "2026-09-12",
  statement: "Appendix 3 of the Data Protection Agreement: Approved Subcontractors, classification Open, Date and Version 1.0, - August 08, 2024. Hetzner Online GmbH (the Supplier) uses services of third parties (subcontractors) while processing data on behalf of its customers (the Client). These subcontractors process data on behalf of Hetzner Online GmbH. The following is a list of approved subcontractors. The table is keyed by SERVER LOCATION and its columns are Server location, Subcontractor, Subcontractor's address, Type of service. The document closes: If you have chosen a server location within the EU, your data will only be processed within the EU. The technical and customer support services for all server locations are provided within the EU.",
}

data hetzner_technical_organizational_measures_reading: HetznerPublishedReading = HetznerPublishedReading {
  authority: ExternalAuthority { uri: Uri { scheme: Https, locator: "docs.hetzner.com/general/security-and-identify/technical-and-organizational-measures/" } },
  read_on: "2026-09-12",
  statement: "Only authorized Hetzner employees have administrative access, within the scope of the agreed service; via multi-level authentication and cryptographic protection. Our log system saves logins and administrative changes within the customer account. We store and save these in accordance with our company deletion plan and in compliance with the GDPR. Our data centers are staffed 24/7/365 by our own technical support employees. WHAT THE PAGE DOES NOT SAY, read for and not found: it names no country for the log system, states no jurisdiction from which administrative access is exercised, and does not mention Finland or Helsinki anywhere.",
}

data hetzner_terms_and_conditions_reading: HetznerPublishedReading = HetznerPublishedReading {
  authority: ExternalAuthority { uri: Uri { scheme: Https, locator: "www.hetzner.com/legal/terms-and-conditions/" } },
  read_on: "2026-09-12",
  statement: "Terms and Conditions of Hetzner Online GmbH, version 2.0.0, last updated 27 October 2021. These Terms and Conditions and the contractual relationship between us and the Customer are governed by the laws of the Federal Republic of Germany, excluding the UN Convention on Contracts for the International Sale of Goods and international private law. The international and exclusive place of jurisdiction for all disputes arising from this contractual relationship is our registered office in Gunzenhausen.",
}

data hetzner_data_protection_overview_reading: HetznerPublishedReading = HetznerPublishedReading {
  authority: ExternalAuthority { uri: Uri { scheme: Https, locator: "docs.hetzner.com/general/company-and-policy/data-protection-at-hetzner/" } },
  read_on: "2026-09-12",
  statement: "The page names Falkenstein, Nuremberg and Helsinki as EU locations and Ashburn, Hillsboro and Singapore as non-EU ones; Hetzner US LLC operates the US locations and Hetzner Singapore Pte. Ltd. the Singapore one, while Hetzner Online GmbH remains the contractual partner. Only the data stored on a cloud server transfers to a non-EU location when one is selected; customer master data is processed exclusively within the EU. The subcontractor overview is referenced rather than reproduced, at www.hetzner.com/AV/subunternehmer.pdf.",
}

// THE LEGAL ENTITIES THE DOCUMENTS NAME. A route's operator slot needs a party, and a party is a
// company with a seat and a register entry, not a brand. The German-language Appendix 3 carries the
// supplier's own letterhead, which is where the register court and number below were read.

type HetznerLegalEntity {
  legal_name: NonEmptyStr
  registered_address: NonEmptyStr
  country: NonEmptyStr
  reading: HetznerPublishedReading
}

