type HetznerCloudServerType = Cax11 | Cax21 | Cax31 | Cax41

data dissolve_on_anemic_money_rate_carrier: List<String> = [
  "closure:migrate_to_money_rate|hourly/monthly_cap: MoneyAmountMicro + separate currency forks std.measure MoneyRate<P> (MoneyPerHour/MoneyPerMonth); §3 parallel representation|trigger:next hetzner-cloud catalog edit routes hourly and monthly_cap through MoneyPerHour/MoneyPerMonth"
]

type HetznerCloudServerCatalogRow {
  server_type: HetznerCloudServerType
  vcpus: HardwareThreadCount
  memory_bytes: ByteSize
  disk_bytes: ByteSize
  hourly: MoneyAmountMicro
  monthly_cap: MoneyAmountMicro
