module extdeps.cloud.hetzner

import extdeps.toolchain.types { Architecture }
import std.currency { CurrencyCode, Eur }
import std.measure {
  MoneyAmountMicro,
  money_amount_micro,
  ByteSize,
  byte_size,
  HardwareThreadCount,
  hardware_thread_count,
}
import std.types { NonEmptyStr }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.hetzner.com/cloud/servers/overview"
  }
}

type HetznerCloudServerType = Cax11 | Cax21 | Cax31 | Cax41

type HetznerCloudServerCatalogRow {
  server_type: HetznerCloudServerType
  vcpus: HardwareThreadCount
  memory_bytes: ByteSize
  disk_bytes: ByteSize
  hourly: MoneyAmountMicro
  monthly_cap: MoneyAmountMicro
  currency: CurrencyCode
  pricing_citation: NonEmptyStr
  cpu_architecture: Architecture
}

data cax41_catalog: HetznerCloudServerCatalogRow = HetznerCloudServerCatalogRow {
  server_type: Cax41,
  vcpus: hardware_thread_count(16),
  memory_bytes: byte_size(34359738368),
  disk_bytes: byte_size(343597383680),
  hourly: money_amount_micro(count: 50500),
  monthly_cap: money_amount_micro(count: 31490000),
  currency: Eur,
  pricing_citation: "GE-D9256",
  cpu_architecture: Aarch64,
}
