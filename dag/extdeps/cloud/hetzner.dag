fn hetzner_cloud_listed_catalog() -> List<HetznerCloudListedRow> {
  [ cax11_listed, cax21_listed, cax31_listed, cax41_listed,
    cx23_listed, cx33_listed, cx43_listed, cx53_listed ]
}

fn hetzner_cloud_orderable_rows() -> List<HetznerCloudListedRow> {
  filter(hetzner_cloud_listed_catalog(), r => availability_is_orderable(a: r.availability))
}

// A RATE BOUNDS A COMPETITOR'S COSTS ONLY IF THE CAPACITY CAN BE BOUGHT. This predicate is the
// whole content of the supply observations above: every arm row in this module currently answers
// false, so nothing may cite this vendor's arm pricing as a purchasable floor.
fn admissible_as_purchasable_floor(r: HetznerCloudListedRow) -> Bool {
  availability_is_orderable(a: r.availability)
}

fn hetzner_cloud_arm_rows_orderable() -> Bool {
  any(hetzner_cloud_listed_catalog(), r => match r.cpu_architecture {
    Aarch64 => availability_is_orderable(a: r.availability),
    X86_64 => false, X86 => false, Arm => false, Armv7 => false, Mips => false,
    Mipsel => false, Mips64 => false, Mips64el => false, Riscv64 => false, Wasm32 => false,
  })
}
