// THE APPROVED-SUBCONTRACTOR TABLE, KEYED THE WAY UPSTREAM KEYS IT. The first column is SERVER
// LOCATION, so this roster is per-location and not per-company, and a location with no row is a
// location upstream lists no approved subcontractor for. What that ABSENCE means is deliberately
// not decided here: the document says which companies are approved, and it does not say that an
// unlisted location has none. A consumer that needs the negative reads the coverage question in its
// own layer rather than finding it pre-answered in this one.

type HetznerApprovedSubcontractor {
  server_location: NonEmptyStr
  entity: HetznerLegalEntity
  service: NonEmptyStr
}

data hetzner_subcontractor_finland: HetznerApprovedSubcontractor = HetznerApprovedSubcontractor {
  server_location: "Finland",
  entity: hetzner_finland_oy,
  service: "Building rental, technical support",
}

