module extdeps.cloud.hetzner



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.hetzner.com/cloud/servers/overview"
  }
}

type HetznerCloudServerType = Cax11 | Cax21 | Cax31 | Cax41

data hetzner_money_rate_frontier_rows: List<std.roster_frontier.FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.cloud.hetzner", decl_name: "HetznerCloudServerCatalogRow"),
    reason: "hourly/monthly_cap: MoneyAmountMicro + separate currency forks std.measure MoneyRate<P> (MoneyPerHour/MoneyPerMonth); parallel representation fork",
    dissolution: unbound_dissolution(description: "next hetzner-cloud catalog edit routes hourly and monthly_cap through MoneyPerHour/MoneyPerMonth"),
  )
]

type HetznerCloudServerCatalogRow {
  server_type: HetznerCloudServerType
  vcpus: std.measure.HardwareThreadCount
  memory_bytes: std.measure.ByteSize
  disk_bytes: std.measure.ByteSize
  hourly: std.measure.MoneyAmountMicro
  monthly_cap: std.measure.MoneyAmountMicro
  currency: std.currency.CurrencyCode
  pricing_citation: std.types.NonEmptyStr
  cpu_architecture: extdeps.toolchain.types.Architecture
}

data cax41_catalog: HetznerCloudServerCatalogRow = HetznerCloudServerCatalogRow {
  server_type: Cax41,
  vcpus: hardware_thread_count(16),
  memory_bytes: byte_size(34359738368),
  disk_bytes: byte_size(343597383680),
  hourly: money_amount_micro(count: 50500),
  monthly_cap: money_amount_micro(count: 31490000),
  currency: Eur,
  pricing_citation: "GE-D9256",
  cpu_architecture: Aarch64,
}
