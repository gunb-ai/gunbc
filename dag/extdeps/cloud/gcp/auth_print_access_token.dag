module extdeps.cloud.gcp.auth_print_access_token

import std.types { List, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/sdk/gcloud/reference/auth/print-access-token"
  }
}

type GcloudAuthDeficit
  = GcloudReauthenticationRequired
  | GcloudNoActiveAccountSelected
  | GcloudAdcLoadFailure
  | GcloudAdcMissing
  | GcloudInvalidGrant
  | GcloudRefreshError
  | GcloudNotLoggedIn

type GcloudAuthDeficitPatternRow {
  deficit: GcloudAuthDeficit
  stderr_substring: String
  observation_note: String
}

data gcloud_auth_print_access_token_deficit_patterns: List<GcloudAuthDeficitPatternRow> = [
  GcloudAuthDeficitPatternRow {
    deficit: GcloudReauthenticationRequired,
    stderr_substring: "Reauthentication",
    observation_note: "gcloud auth print-access-token interactive reauthentication prompt",
  },
  GcloudAuthDeficitPatternRow {
    deficit: GcloudNoActiveAccountSelected,
    stderr_substring: "not currently have an active account",
    observation_note: "gcloud reports no active account selected",
  },
  GcloudAuthDeficitPatternRow {
    deficit: GcloudAdcLoadFailure,
    stderr_substring: "Could not load the default credentials",
    observation_note: "ADC load failure on stderr",
  },
  GcloudAuthDeficitPatternRow {
    deficit: GcloudAdcMissing,
    stderr_substring: "default credentials were not found",
    observation_note: "ADC missing on stderr",
  },
  GcloudAuthDeficitPatternRow {
    deficit: GcloudInvalidGrant,
    stderr_substring: "invalid_grant",
    observation_note: "OAuth2 invalid_grant token refresh failure",
  },
  GcloudAuthDeficitPatternRow {
    deficit: GcloudRefreshError,
    stderr_substring: "RefreshError",
    observation_note: "google-auth RefreshError wrapper on stderr",
  },
  GcloudAuthDeficitPatternRow {
    deficit: GcloudNotLoggedIn,
    stderr_substring: "not logged in",
    observation_note: "gcloud reports operator not logged in",
  },
]

fn gcloud_auth_deficit_for_pattern(
  stderr: String,
  row: GcloudAuthDeficitPatternRow,
) -> GcloudAuthDeficit? {
  if string_contains(s: stderr, pattern: row.stderr_substring) {
    Present { value: row.deficit }
  } else {
    none
  }
}

fn gcloud_stderr_auth_deficit(stderr: String) -> GcloudAuthDeficit? {
  fold(
    gcloud_auth_print_access_token_deficit_patterns,
    init: none,
    f: (selected, row) =>
      match selected {
        Present { value: _ } => selected
        Absent => gcloud_auth_deficit_for_pattern(stderr: stderr, row: row)
      },
  )
}
