module extdeps.cloud.gcp.secret_manager

import std.encoding { Standard, base64_decode }
import std.bytes { octets_bytes }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/secret-manager/docs"
  }
}

type SmReplica {
  location: String
}

type SmReplication
  = Automatic
  | UserManaged { replicas: List<SmReplica> }

type GcpSecret {
  name: String
  project: String
  replication: SmReplication
  labels: Map<String, String>?
  create_time: String
}

type SmVersionState = SmEnabled | SmDisabled | SmDestroyed

// The etag and destroy_time fields are carried because the version LIFECYCLE
// operations need them and the access path did not. Disable and destroy both
// accept an etag for optimistic concurrency, so a caller that never reads one
// cannot express "disable the version I actually observed" — only "disable
// whatever is there now", which is a different operation against a moving
// subject. destroy_time distinguishes a version scheduled for destruction from
// one already gone; SmDestroyed alone cannot.
type GcpSecretVersion {
  name: SmResolvedVersionIdentity
  state: SmVersionState
  create_time: String
  etag: String?
  destroy_time: String?
}

// Pagination is part of this response's MEANING, not a transport detail to
// drop: a version list read without following next_page_token is a PREFIX of
// the versions, and a caller that treats a prefix as the whole population has
// observed "no other consumers of this secret exist" from data that could not
// have shown them. extdeps carries the token so that incompleteness is
// representable upstream of any policy that would otherwise silently narrow.
type ListSecretVersionsResponse {
  versions: List<GcpSecretVersion>
  next_page_token: String?
  total_size: Int?
}

type SecretPayload {
  data: Bytes
}

type SmRotationSchedule {
  next_rotation_time: String?
  rotation_period_seconds: Int?
}

type SmResolvedVersionIdentity = NonEmptyStr where brand("SmResolvedVersionIdentity")

type SmAccessVersionPayloadRefusal
  = SmAccessVersionPayloadEmpty
  | SmAccessVersionPayloadInvalidBase64

type SmAccessVersionPayloadDecodeOutcome
  = SmAccessVersionPayloadDecoded { payload: Bytes }
  | SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadRefusal }

type SmResolvedVersionIdentityRefusal
  = SmResolvedVersionIdentityEmpty
  | SmResolvedVersionIdentityMalformed

type SmResolvedVersionIdentityDecodeOutcome
  = SmResolvedVersionIdentityDecoded { identity: SmResolvedVersionIdentity }
  | SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityRefusal }

data max_secret_size_bytes: Int = 65536

data max_versions: Int = 1000

fn sm_resolved_version_secret_path_is_well_formed(secret_path: String) -> Bool {
  if !starts_with(s: secret_path, prefix: "projects/") {
    false
  } else {
    let secret_split = split(s: secret_path, delimiter: "/secrets/")
    if count(secret_split) != 2 {
      false
    } else {
      match secret_split |> skip(n: 1) |> first {
        Present { value: secret_id } =>
          secret_id != ""
            && match secret_split |> first {
              Present { value: project_prefix } =>
                project_prefix != "projects"
                  && !string_contains(s: project_prefix, pattern: "/secrets/")
              Absent => false
            }
        Absent => false
      }
    }
  }
}

fn sm_resolved_version_identity_is_well_formed(name: String) -> Bool {
  let version_split = split(s: name, delimiter: "/versions/")
  if count(version_split) != 2 {
    false
  } else {
    match version_split |> first {
      Present { value: secret_path } =>
        sm_resolved_version_secret_path_is_well_formed(secret_path: secret_path)
          && match version_split |> skip(n: 1) |> first {
            Present { value: version_id } =>
              version_id != "" && !string_contains(s: version_id, pattern: "/")
            Absent => false
          }
      Absent => false
    }
  }
}

fn decode_sm_access_version_payload_wire(data_b64: String) -> SmAccessVersionPayloadDecodeOutcome {
  if data_b64.length() == 0 {
    SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadEmpty }
  } else {
    match base64_decode(s: data_b64, variant: Standard) {
      Present { value: octets } =>
        if octets.length() == 0 {
          SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadEmpty }
        } else {
          SmAccessVersionPayloadDecoded { payload: octets_bytes(o: octets) }
        }
      Absent =>
        SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadInvalidBase64 }
    }
  }
}

fn decode_sm_resolved_version_identity_wire(name: String) -> SmResolvedVersionIdentityDecodeOutcome {
  if name.length() == 0 {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityEmpty }
  } else if !sm_resolved_version_identity_is_well_formed(name: name) {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityMalformed }
  } else {
    SmResolvedVersionIdentityDecoded { identity: name as SmResolvedVersionIdentity }
  }
}

fn utf8_secret_from_access_payload(payload: Bytes) -> Secret {
  utf8_decode_bytes(payload: payload) as Secret
}

type SmAccessVersionSecretDecodeOutcome
  = SmAccessVersionSecretDecoded { credential: Secret }
  | SmAccessVersionSecretDecodeRefused { cause: SmAccessVersionPayloadRefusal }

fn decode_sm_access_version_secret_wire(data_b64: String) -> SmAccessVersionSecretDecodeOutcome {
  match decode_sm_access_version_payload_wire(data_b64: data_b64) {
    SmAccessVersionPayloadDecoded { payload: payload } =>
      SmAccessVersionSecretDecoded { credential: utf8_secret_from_access_payload(payload: payload) }
    SmAccessVersionPayloadDecodeRefused { cause: cause } =>
      SmAccessVersionSecretDecodeRefused { cause: cause }
  }
}

type SmAccessVersionWireDecodeOutcome
  = SmAccessVersionWireDecoded {
      identity: SmResolvedVersionIdentity
      payload: Bytes
    }
  | SmAccessVersionWireDecodeRefused {
      identity_cause: SmResolvedVersionIdentityRefusal?
      payload_cause: SmAccessVersionPayloadRefusal?
    }

fn decode_sm_access_version_wire_response(name: String, data_b64: String) -> SmAccessVersionWireDecodeOutcome {
  match decode_sm_resolved_version_identity_wire(name: name) {
    SmResolvedVersionIdentityDecoded { identity: identity } =>
      match decode_sm_access_version_payload_wire(data_b64: data_b64) {
        SmAccessVersionPayloadDecoded { payload: payload } =>
          SmAccessVersionWireDecoded { identity: identity, payload: payload }
        SmAccessVersionPayloadDecodeRefused { cause: payload_cause } =>
          SmAccessVersionWireDecodeRefused { identity_cause: none, payload_cause: Present { value: payload_cause } }
      }
    SmResolvedVersionIdentityDecodeRefused { cause: identity_cause } =>
      match decode_sm_access_version_payload_wire(data_b64: data_b64) {
        SmAccessVersionPayloadDecoded { payload: _ } =>
          SmAccessVersionWireDecodeRefused { identity_cause: Present { value: identity_cause }, payload_cause: none }
        SmAccessVersionPayloadDecodeRefused { cause: payload_cause } =>
          SmAccessVersionWireDecodeRefused {
            identity_cause: Present { value: identity_cause },
            payload_cause: Present { value: payload_cause }
          }
      }
  }
}

service gcp.SecretManager {
  config {
    endpoint: "https://secretmanager.googleapis.com"
    auth: Bearer
    auth_input: access_token

    rate_limit: { requests: 1000, per: minute, scope: secret_manager }

    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 503] }
  }

  operation AccessVersion {
    input {
      access_token: Secret
      project_id: GcpProjectId
      secret: NonEmptyStr
      version: NonEmptyStr = "latest"
    }
    output {
      data_b64: String from "payload/data"
      name: SmResolvedVersionIdentity
    }
    readonly
    transport rest { method: GET, path: "/v1/projects/\{project_id\}/secrets/\{secret\}/versions/\{version\}:access" }
    response {
      200 => SecretPayload
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation CreateSecret {
    input { access_token: Secret, project_id: GcpProjectId, secret_id: NonEmptyStr }
    output { name: String }
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/secrets",
      query: { secretId: secret_id },
      body: { replication: { automatic: {} } }
    }
    response {
      200 => GcpSecret
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation AddVersion {
    input { access_token: Secret, secret_name: String, payload_b64: String }
    output { name: SmResolvedVersionIdentity }

    transport rest {
      method: POST,
      path: "/v1/\{secret_name\}:addVersion",
      body: { payload: { data: payload_b64 } }
    }
    response {
      200 => GcpSecretVersion
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  // The version lifecycle, cited from
  // cloud.google.com/secret-manager/docs/reference/rest/v1/projects.secrets.versions.
  // Upstream names four state-changing verbs (enable, disable, destroy) and two
  // reads (get, list); this module models the ones a rotation has to reach.
  // Enable is modeled because it is what makes DISABLE a reversible step, which
  // is the entire reason a rotation disables before it destroys — the reversal
  // must be expressible, or "reversible" is a claim with no operation behind it.
  operation ListVersions {
    input {
      access_token: Secret
      secret_name: String
      page_size: Int = 100
      page_token: String = ""
    }
    output {
      versions: List<GcpSecretVersion>
      next_page_token: String from "nextPageToken"
    }
    readonly
    transport rest {
      method: GET,
      path: "/v1/\{secret_name\}/versions",
      query: { pageSize: page_size, pageToken: page_token }
    }
    response {
      200 => ListSecretVersionsResponse
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation GetVersion {
    input { access_token: Secret, version_name: SmResolvedVersionIdentity }
    output { name: SmResolvedVersionIdentity, state: SmVersionState, etag: String from "etag" }
    readonly
    transport rest { method: GET, path: "/v1/\{version_name\}" }
    response {
      200 => GcpSecretVersion
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation DisableVersion {
    input { access_token: Secret, version_name: SmResolvedVersionIdentity, etag: String = "" }
    output { name: SmResolvedVersionIdentity, state: SmVersionState }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/\{version_name\}:disable",
      body: { etag: etag }
    }
    response {
      200 => GcpSecretVersion
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation EnableVersion {
    input { access_token: Secret, version_name: SmResolvedVersionIdentity, etag: String = "" }
    output { name: SmResolvedVersionIdentity, state: SmVersionState }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/\{version_name\}:enable",
      body: { etag: etag }
    }
    response {
      200 => GcpSecretVersion
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  // NOT marked idempotent, and the asymmetry with disable and enable is the
  // point: those two converge on re-issue, so a retried disable reaches the
  // state the caller asked for. Destroy erases payload bytes with no upstream
  // inverse, and a destroy replayed against a version some other actor re-added
  // is a different subject wearing the same name. AddVersion is likewise not
  // idempotent, for the opposite reason — every successful call MINTS a new
  // version, so a retry does not converge, it sprawls. Only the two operations
  // that genuinely converge carry the marker that makes them retryable.
  operation DestroyVersion {
    input { access_token: Secret, version_name: SmResolvedVersionIdentity, etag: String = "" }
    output { name: SmResolvedVersionIdentity, state: SmVersionState, destroy_time: String from "destroyTime" }

    transport rest {
      method: POST,
      path: "/v1/\{version_name\}:destroy",
      body: { etag: etag }
    }
    response {
      200 => GcpSecretVersion
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation SetSecretIamPolicy {
    input {
      access_token: Secret
      project_id: GcpProjectId
      secret: NonEmptyStr
      bindings: List<GcpBinding>
    }
    output { ok_etag: String from "etag" }

    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/secrets/\{secret\}:setIamPolicy",
      body: { policy: { bindings: bindings } }
    }
    response {
      200 => GcpPolicy
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      409 => GcpErrorShape
      412 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}
