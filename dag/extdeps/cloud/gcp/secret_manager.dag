module extdeps.cloud.gcp.secret_manager

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/secret-manager/docs"
  }
}

type SmReplica {
  location: String
}

type SmReplication
  = Automatic
  | UserManaged { replicas: List<SmReplica> }

type GcpSecret {
  name: String
  project: String
  replication: SmReplication
  labels: Map<String, String>?
  create_time: String
}

type SmVersionState = SmEnabled | SmDisabled | SmDestroyed

type GcpSecretVersion {
  name: String
  state: SmVersionState
  create_time: String
}

type SecretPayload {
  data: Bytes
}

type SmRotationSchedule {
  next_rotation_time: String?
  rotation_period_seconds: Int?
}

data max_secret_size_bytes: Int = 65536

data max_versions: Int = 1000

fn utf8_secret_from_access_payload(payload: Bytes) -> Secret {
  utf8_decode_bytes(payload: payload) as Secret
}

service gcp.SecretManager {
  config {
    endpoint: "https://secretmanager.googleapis.com"
    auth: Bearer
    auth_input: access_token

    rate_limit: { requests: 1000, per: minute, scope: secret_manager }

    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 503] }
  }

  operation AccessVersion {
    input {
      access_token: Secret
      project_id: GcpProjectId
      secret: NonEmptyStr
      version: NonEmptyStr = "latest"
    }
    output {
      payload: Bytes
      data_b64: String from "payload/data"
      name: String
    }
    readonly
    transport rest { method: GET, path: "/v1/projects/\{project_id\}/secrets/\{secret\}/versions/\{version\}:access" }
    response {
      200 => SecretPayload
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation CreateSecret {
    input { access_token: Secret, project_id: GcpProjectId, secret_id: NonEmptyStr }
    output { name: String }
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/secrets",
      query: { secretId: secret_id },
      body: { replication: { automatic: {} } }
    }
    response {
      200 => GcpSecret
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation AddVersion {
    input { access_token: Secret, secret_name: String, payload_b64: String }
    output { name: String }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/\{secret_name\}:addVersion",
      body: { payload: { data: payload_b64 } }
    }
    response {
      200 => GcpSecretVersion
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation SetSecretIamPolicy {
    input {
      access_token: Secret
      project_id: GcpProjectId
      secret: NonEmptyStr
      bindings: List<GcpBinding>
    }
    output { ok_etag: String from "etag" }

    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/secrets/\{secret\}:setIamPolicy",
      body: { policy: { bindings: bindings } }
    }
    response {
      200 => GcpPolicy
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      409 => GcpErrorShape
      412 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}
