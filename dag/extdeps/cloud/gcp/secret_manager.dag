module extdeps.cloud.gcp.secret_manager

// GcpProjectId and GcpErrorShape were reached as BARE references before this
// import existed, which resolves only when some unrelated module in the assembled
// closure happens to have dragged their definers into the pool -- accidental
// coverage, not a binding. Named explicitly so this module carries its own edges.

data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "cloud.google.com/secret-manager/docs"
  }
}

type SmReplica {
  location: String
}

type SmReplication
  = Automatic
  | UserManaged { replicas: List<SmReplica> }

type GcpSecret {
  name: String
  project: String
  replication: SmReplication
  labels: Map<String, String>?
  create_time: String
}

type SmVersionState = SmEnabled | SmDisabled | SmDestroyed

// The etag and destroy_time fields are carried because the version LIFECYCLE
// operations need them and the access path did not. Disable and destroy both
// accept an etag for optimistic concurrency, so a caller that never reads one
// cannot express "disable the version I actually observed" — only "disable
// whatever is there now", which is a different operation against a moving
// subject. destroy_time distinguishes a version scheduled for destruction from
// one already gone; SmDestroyed alone cannot.
type GcpSecretVersion {
  name: SmResolvedVersionIdentity
  state: SmVersionState
  create_time: String
  etag: String?
  destroy_time: String?
}

// Pagination is part of this response's MEANING, not a transport detail to
// drop: a version list read without following next_page_token is a PREFIX of
// the versions, and a caller that treats a prefix as the whole population has
// observed "no other consumers of this secret exist" from data that could not
// have shown them. extdeps carries the token so that incompleteness is
// representable upstream of any policy that would otherwise silently narrow.
type ListSecretVersionsResponse {
  versions: List<GcpSecretVersion>
  next_page_token: String?
  total_size: Int?
}

type SecretPayload {
  data: Bytes
}

type SmRotationSchedule {
  next_rotation_time: String?
  rotation_period_seconds: Int?
}

type SmResolvedVersionIdentity = std.types.NonEmptyStr where brand("SmResolvedVersionIdentity")

type SmAccessVersionPayloadRefusal
  = SmAccessVersionPayloadEmpty
  | SmAccessVersionPayloadInvalidBase64

type SmAccessVersionPayloadDecodeOutcome
  = SmAccessVersionPayloadDecoded { payload: Bytes }
  | SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadRefusal }

type SmResolvedVersionIdentityRefusal
  = SmResolvedVersionIdentityEmpty
  | SmResolvedVersionIdentityMalformed

type SmResolvedVersionIdentityDecodeOutcome
  = SmResolvedVersionIdentityDecoded { identity: SmResolvedVersionIdentity }
  | SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityRefusal }

type SmTestPermissionsResponse {
  permissions: List<String>
}

// The decoded reading of a testIamPermissions response, at one-permission grain.
// THERE IS NO "PermissionNotHeld" CONSTRUCTOR, and that omission is the whole
// point: this instrument cannot produce evidence of absence, so the type does not
// let a caller write it down. A permission that comes back is Held; a permission
// that does not is Undetermined and carries why.
type SmPermissionProbeCell
  = SmPermissionHeld { permission: std.types.NonEmptyStr }
  | SmPermissionUndetermined { permission: std.types.NonEmptyStr, cause: std.types.NonEmptyStr }

data sm_permission_probe_undetermined_cause: std.types.NonEmptyStr = "testIamPermissions omits a permission when it is not held, when the resource does not exist, and when the caller lacks visibility; the response cannot distinguish these"

data no_probe_cells: List<SmPermissionProbeCell> = []

// Project the probe's answer over the permissions that were ASKED. A permission
// outside `requested` is not classified at all, because the probe was never asked
// about it -- silently reporting it as Undetermined would suggest the instrument
// had considered it.
fn sm_probe_cells(requested: List<String>, returned: List<String>) -> List<SmPermissionProbeCell> {
  v2.std.algebra.fold_list(
    xs: requested,
    empty: no_probe_cells,
    cons: fn(acc, p) {
      if sm_list_has(xs: returned, needle: p) {
        acc |> list_push(SmPermissionHeld { permission: p })
      } else {
        acc |> list_push(SmPermissionUndetermined { permission: p, cause: sm_permission_probe_undetermined_cause })
      }
    }
  )
}

fn sm_list_has(xs: List<String>, needle: String) -> Bool {
  v2.std.algebra.fold_list(xs: xs, empty: false, cons: fn(acc, x) { acc || x == needle })
}

data max_secret_size_bytes: Int = 65536

data max_versions: Int = 1000

fn sm_resolved_version_secret_path_is_well_formed(secret_path: String) -> Bool {
  if !starts_with(s: secret_path, prefix: "projects/") {
    false
  } else {
    let secret_split = split(s: secret_path, delimiter: "/secrets/")
    if count(secret_split) != 2 {
      false
    } else {
      match secret_split |> skip(n: 1) |> first {
        Present { value: secret_id } =>
          secret_id != ""
            && match secret_split |> first {
              Present { value: project_prefix } =>
                project_prefix != "projects"
                  && !project_prefix.contains("/secrets/")
              Absent => false
            }
        Absent => false
      }
    }
  }
}

fn sm_resolved_version_identity_is_well_formed(name: String) -> Bool {
  let version_split = split(s: name, delimiter: "/versions/")
  if count(version_split) != 2 {
    false
  } else {
    match version_split |> first {
      Present { value: secret_path } =>
        sm_resolved_version_secret_path_is_well_formed(secret_path: secret_path)
          && match version_split |> skip(n: 1) |> first {
            Present { value: version_id } =>
              version_id != "" && !version_id.contains("/")
            Absent => false
          }
      Absent => false
    }
  }
}

fn encode_sm_access_version_payload_wire(credential: Secret) -> String {
  base64_encode(
    octets: bytes_octets(b: utf8_encode_bytes(s: credential as String)),
    variant: std.encoding.Standard
  )
}

fn decode_sm_access_version_payload_wire(data_b64: String) -> SmAccessVersionPayloadDecodeOutcome {
  if data_b64.length() == 0 {
    SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadEmpty }
  } else {
    match base64_decode(s: data_b64, variant: std.encoding.Standard) {
      Present { value: octets } =>
        if octets.length() == 0 {
          SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadEmpty }
        } else {
          SmAccessVersionPayloadDecoded { payload: octets_bytes(o: octets) }
        }
      Absent =>
        SmAccessVersionPayloadDecodeRefused { cause: SmAccessVersionPayloadInvalidBase64 }
    }
  }
}

fn decode_sm_resolved_version_identity_wire(name: String) -> SmResolvedVersionIdentityDecodeOutcome {
  if name.length() == 0 {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityEmpty }
  } else if !sm_resolved_version_identity_is_well_formed(name: name) {
    SmResolvedVersionIdentityDecodeRefused { cause: SmResolvedVersionIdentityMalformed }
  } else {
    SmResolvedVersionIdentityDecoded { identity: name as SmResolvedVersionIdentity }
  }
}

fn utf8_secret_from_access_payload(payload: Bytes) -> Secret {
  utf8_decode_bytes(payload: payload) as Secret
}

type SmAccessVersionSecretDecodeOutcome
  = SmAccessVersionSecretDecoded { credential: Secret }
  | SmAccessVersionSecretDecodeRefused { cause: SmAccessVersionPayloadRefusal }

fn decode_sm_access_version_secret_wire(data_b64: String) -> SmAccessVersionSecretDecodeOutcome {
  match decode_sm_access_version_payload_wire(data_b64: data_b64) {
    SmAccessVersionPayloadDecoded { payload: payload } =>
      SmAccessVersionSecretDecoded { credential: utf8_secret_from_access_payload(payload: payload) }
    SmAccessVersionPayloadDecodeRefused { cause: cause } =>
      SmAccessVersionSecretDecodeRefused { cause: cause }
  }
}

type SmAccessVersionWireDecodeOutcome
  = SmAccessVersionWireDecoded {
      identity: SmResolvedVersionIdentity
      payload: Bytes
    }
  | SmAccessVersionWireDecodeRefused {
      identity_cause: SmResolvedVersionIdentityRefusal?
      payload_cause: SmAccessVersionPayloadRefusal?
    }

fn decode_sm_access_version_wire_response(name: String, data_b64: String) -> SmAccessVersionWireDecodeOutcome {
  match decode_sm_resolved_version_identity_wire(name: name) {
    SmResolvedVersionIdentityDecoded { identity: identity } =>
      match decode_sm_access_version_payload_wire(data_b64: data_b64) {
        SmAccessVersionPayloadDecoded { payload: payload } =>
          SmAccessVersionWireDecoded { identity: identity, payload: payload }
        SmAccessVersionPayloadDecodeRefused { cause: payload_cause } =>
          SmAccessVersionWireDecodeRefused { identity_cause: none, payload_cause: Present { value: payload_cause } }
      }
    SmResolvedVersionIdentityDecodeRefused { cause: identity_cause } =>
      match decode_sm_access_version_payload_wire(data_b64: data_b64) {
        SmAccessVersionPayloadDecoded { payload: _ } =>
          SmAccessVersionWireDecodeRefused { identity_cause: Present { value: identity_cause }, payload_cause: none }
        SmAccessVersionPayloadDecodeRefused { cause: payload_cause } =>
          SmAccessVersionWireDecodeRefused {
            identity_cause: Present { value: identity_cause },
            payload_cause: Present { value: payload_cause }
          }
      }
  }
}

// The version lifecycle, cited from
// cloud.google.com/secret-manager/docs/reference/rest/v1/projects.secrets.versions.
// Upstream names four state-changing verbs (enable, disable, destroy) and two
// reads (get, list); this module models the ones a rotation has to reach.
// Enable is modeled because it is what makes DISABLE a reversible step, which
// is the entire reason a rotation disables before it destroys — the reversal
// must be expressible, or "reversible" is a claim with no operation behind it.
// NOT marked idempotent, and the asymmetry with disable and enable is the
// point: those two converge on re-issue, so a retried disable reaches the
// state the caller asked for. Destroy erases payload bytes with no upstream
// inverse, and a destroy replayed against a version some other actor re-added
// is a different subject wearing the same name. AddVersion is likewise not
// idempotent, for the opposite reason — every successful call MINTS a new
// version, so a retry does not converge, it sprawls. Only the two operations
// that genuinely converge carry the marker that makes them retryable.
// SECRET MANAGER OPERATION NOTES, hoisted here because annotations attach at
// module-item grain and a service body is a declaration body.
//
// GetSecretIamPolicy is the ONLY operation in this module that can settle what a
// secret's policy contains. It is the read half of the read-modify-write that
// setIamPolicy requires, and the only instrument here that can answer an ABSENCE
// or OVERBREADTH question, because it returns the whole policy rather than an
// answer about a supplied list.
//
// TestSecretIamPermissions is DIAGNOSTIC ONLY. Google documents it as a helper for
// building permission-aware UIs, not as an authorization check. Three properties
// make it unusable as an absence oracle, and all three are modelled rather than
// noted: it returns the EMPTY set for a resource that does not exist, so empty
// cannot distinguish "not permitted" from "no such secret"; it answers only about
// the permissions the caller SUPPLIED, so it can never find a binding nobody asked
// about and overbreadth is out of its reach; and it is documented as potentially
// permissive. So SmPermissionProbeCell has NO "absent" constructor -- a permission
// that does not come back is Undetermined, and the other answer cannot be written
// from this instrument's output at all.
//
// SetSecretIamPolicy REPLACES the whole policy. The prior shape here took a bare
// binding list with NO etag and returned only an etag, which is wrong three ways at
// once: without a read-modify-write over the CURRENT policy it silently drops every
// binding the caller did not author; without an etag there is no optimistic
// concurrency, so a concurrent edit is clobbered rather than refused with 412; and
// returning just an etag means the caller never sees the policy it actually
// installed and has to assume its request was applied verbatim. It now takes the
// full policy including the etag it was read at, carries updateMask, and returns
// the RESULTING policy so the write is checked against what landed rather than
// against what was sent.
service gcp.SecretManager {
  config {
    endpoint: "https://secretmanager.googleapis.com"
    auth: Bearer
    auth_input: access_token

    rate_limit: { requests: 1000, per: minute, scope: secret_manager }
  }

  operation AccessVersion {
    input {
      access_token: Secret
      project_id: extdeps.cloud.gcp.gcp.GcpProjectId
      secret: std.types.NonEmptyStr
      version: std.types.NonEmptyStr = "latest"
    }
    output {
      data_b64: String from "payload/data"
      name: SmResolvedVersionIdentity
    }
    readonly
    transport rest { method: GET, path: "/v1/projects/\{project_id\}/secrets/\{secret\}/versions/\{version\}:access" }
    response {
      200 => SecretPayload
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation CreateSecret {
    input { access_token: Secret, project_id: extdeps.cloud.gcp.gcp.GcpProjectId, secret_id: std.types.NonEmptyStr }
    output { name: String }
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/secrets",
      query: { secretId: secret_id },
      body: { replication: { automatic: {} } }
    }
    response {
      200 => GcpSecret
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation AddVersion {
    input { access_token: Secret, secret_name: String, payload_b64: String }
    output { name: SmResolvedVersionIdentity }

    transport rest {
      method: POST,
      path: "/v1/\{secret_name\}:addVersion",
      body: { payload: { data: payload_b64 } }
    }
    response {
      200 => GcpSecretVersion
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation ListVersions {
    input {
      access_token: Secret
      secret_name: String
      page_size: Int = 100
      page_token: String = ""
    }
    output {
      versions: List<GcpSecretVersion>
      next_page_token: String from "nextPageToken"
    }
    readonly
    transport rest {
      method: GET,
      path: "/v1/\{secret_name\}/versions",
      query: { pageSize: page_size, pageToken: page_token }
    }
    response {
      200 => ListSecretVersionsResponse
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation GetVersion {
    input { access_token: Secret, version_name: SmResolvedVersionIdentity }
    output { name: SmResolvedVersionIdentity, state: SmVersionState, etag: String from "etag" }
    readonly
    transport rest { method: GET, path: "/v1/\{version_name\}" }
    response {
      200 => GcpSecretVersion
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation DisableVersion {
    input { access_token: Secret, version_name: SmResolvedVersionIdentity, etag: String = "" }
    output { name: SmResolvedVersionIdentity, state: SmVersionState }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/\{version_name\}:disable",
      body: { etag: etag }
    }
    response {
      200 => GcpSecretVersion
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation EnableVersion {
    input { access_token: Secret, version_name: SmResolvedVersionIdentity, etag: String = "" }
    output { name: SmResolvedVersionIdentity, state: SmVersionState }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/\{version_name\}:enable",
      body: { etag: etag }
    }
    response {
      200 => GcpSecretVersion
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation DestroyVersion {
    input { access_token: Secret, version_name: SmResolvedVersionIdentity, etag: String = "" }
    output { name: SmResolvedVersionIdentity, state: SmVersionState, destroy_time: String from "destroyTime" }

    transport rest {
      method: POST,
      path: "/v1/\{version_name\}:destroy",
      body: { etag: etag }
    }
    response {
      200 => GcpSecretVersion
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation GetSecret {
    input { access_token: Secret, project_id: extdeps.cloud.gcp.gcp.GcpProjectId, secret: std.types.NonEmptyStr }
    output { name: String, create_time: String from "createTime" }
    readonly
    transport rest { method: GET, path: "/v1/projects/\{project_id\}/secrets/\{secret\}" }
    response {
      200 => GcpSecret
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation GetSecretIamPolicy {
    input { access_token: Secret, project_id: extdeps.cloud.gcp.gcp.GcpProjectId, secret: std.types.NonEmptyStr }
    output { bindings: List<extdeps.cloud.gcp.iam.GcpBinding>, etag: String, version: Int }
    readonly
    transport rest { method: GET, path: "/v1/projects/\{project_id\}/secrets/\{secret\}:getIamPolicy" }
    response {
      200 => GcpPolicy
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation TestSecretIamPermissions {
    input { access_token: Secret, project_id: extdeps.cloud.gcp.gcp.GcpProjectId, secret: std.types.NonEmptyStr, permissions: List<String> }
    output { permissions: List<String> }
    readonly
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/secrets/\{secret\}:testIamPermissions",
      body: { permissions: permissions }
    }
    response {
      200 => SmTestPermissionsResponse
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation SetSecretIamPolicy {
    input {
      access_token: Secret
      project_id: extdeps.cloud.gcp.gcp.GcpProjectId
      secret: std.types.NonEmptyStr
      policy: extdeps.cloud.gcp.iam.GcpPolicy
      update_mask: String = "bindings,etag"
    }
    output { bindings: List<extdeps.cloud.gcp.iam.GcpBinding>, etag: String, version: Int }

    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/secrets/\{secret\}:setIamPolicy",
      body: { policy: policy, updateMask: update_mask }
    }
    response {
      200 => GcpPolicy
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      409 => GcpErrorShape
      412 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}


// ── The effect leaf, its operation identity, and its permission requirement ────────────────
// WHICH PERMISSIONS AN OPERATION REQUIRES IS AN UPSTREAM FACT, so it lives here with the cited
// dependency rather than in a consumer's policy module. A workflow that authored its own
// "this probably needs accessor + version-adder" roster would be guessing at Google's contract
// and would drift from it silently; extdeps states it once, per operation.
//
// Each effect carries the EXACT resource it acts on, so a demand derived from it names one
// resource -- never an operations x resources cross product, which grants every listed operation
// on every listed resource and is how a read-only workflow acquires destroy authority.
//
// The OperationRef is minted HERE, beside the operation declaration it names, so a consumer never
// authors service/operation strings of its own. That keeps the identity single-authority even
// though the generic declaration index cannot yet resolve a service operation as a DeclarationRef
// (measured 2026-08-09: gcp.SecretManager resolves, GetSecret does not, as field or declaration).
type SecretManagerEffect
  = SmAccessVersionEffect { secret: std.types.NonEmptyStr }
  | SmAddVersionEffect { secret: std.types.NonEmptyStr }
  | SmGetSecretEffect { secret: std.types.NonEmptyStr }
  | SmGetSecretIamPolicyEffect { secret: std.types.NonEmptyStr }
  | SmSetSecretIamPolicyEffect { secret: std.types.NonEmptyStr }
  | SmDisableVersionEffect { secret: std.types.NonEmptyStr }
  | SmDestroyVersionEffect { secret: std.types.NonEmptyStr }

data sm_service_path: String = "extdeps.cloud.gcp.secret_manager"

data sm_service_name: String = "gcp.SecretManager"

fn sm_operation_ref(operation: String) -> v2.std.operation_argv.OperationRef {
  v2.std.operation_argv.OperationRef { path: sm_service_path, service: sm_service_name, operation: operation }
}

fn secret_manager_effect_operation(e: SecretManagerEffect) -> v2.std.operation_argv.OperationRef {
  match e {
    SmAccessVersionEffect { secret: _ } => sm_operation_ref(operation: "AccessVersion")
    SmAddVersionEffect { secret: _ } => sm_operation_ref(operation: "AddVersion")
    SmGetSecretEffect { secret: _ } => sm_operation_ref(operation: "GetSecret")
    SmGetSecretIamPolicyEffect { secret: _ } => sm_operation_ref(operation: "GetSecretIamPolicy")
    SmSetSecretIamPolicyEffect { secret: _ } => sm_operation_ref(operation: "SetSecretIamPolicy")
    SmDisableVersionEffect { secret: _ } => sm_operation_ref(operation: "DisableVersion")
    SmDestroyVersionEffect { secret: _ } => sm_operation_ref(operation: "DestroyVersion")
  }
}

fn secret_manager_effect_resource(e: SecretManagerEffect) -> std.types.NonEmptyStr {
  match e {
    SmAccessVersionEffect { secret: s } => s
    SmAddVersionEffect { secret: s } => s
    SmGetSecretEffect { secret: s } => s
    SmGetSecretIamPolicyEffect { secret: s } => s
    SmSetSecretIamPolicyEffect { secret: s } => s
    SmDisableVersionEffect { secret: s } => s
    SmDestroyVersionEffect { secret: s } => s
  }
}

// An operation with no permission mapping is NOT an empty requirement -- an empty list would read
// as "needs nothing", which admits actuation with no grant at all. Every arm below states its
// requirement, and the consumer refuses on an empty projection rather than proceeding.
fn secret_manager_effect_required_permissions(e: SecretManagerEffect) -> List<String> {
  match e {
    SmAccessVersionEffect { secret: _ } => ["secretmanager.versions.access"]
    SmAddVersionEffect { secret: _ } => ["secretmanager.versions.add"]
    SmGetSecretEffect { secret: _ } => ["secretmanager.secrets.get"]
    SmGetSecretIamPolicyEffect { secret: _ } => ["secretmanager.secrets.getIamPolicy"]
    SmSetSecretIamPolicyEffect { secret: _ } => ["secretmanager.secrets.setIamPolicy"]
    SmDisableVersionEffect { secret: _ } => ["secretmanager.versions.disable"]
    SmDestroyVersionEffect { secret: _ } => ["secretmanager.versions.destroy"]
  }
}
