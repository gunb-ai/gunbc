module extdeps.cloud.gcp.iam


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.cloud.gcp.gcp { GcpProjectId, ServiceAccountEmail }
import std.types { Bool, Int, Json, List, NonEmptyStr, Secret, String }
import v2.std.algebra { filter, fold_list }
import v2.std.network { GET, POST }
import v2.std.optional { Present }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/iam/docs/overview"
  }
}

type GcpRole {
  name: String
  title: String
  permissions: List<String>?
  predefined: Bool
}

data role_secretmanager_secret_accessor: String = "roles/secretmanager.secretAccessor"

data role_secretmanager_secret_version_adder: String = "roles/secretmanager.secretVersionAdder"

data common_roles: List<GcpRole> = [
  { name: "roles/viewer", title: "Viewer", permissions: null, predefined: true },
  { name: "roles/editor", title: "Editor", permissions: null, predefined: true },
  { name: "roles/owner", title: "Owner", permissions: null, predefined: true },
  { name: "roles/storage.objectViewer", title: "Storage Object Viewer", permissions: null, predefined: true },
  { name: "roles/storage.objectAdmin", title: "Storage Object Admin", permissions: null, predefined: true },
  { name: role_secretmanager_secret_accessor, title: "Secret Manager Secret Accessor", permissions: null, predefined: true },
  { name: role_secretmanager_secret_version_adder, title: "Secret Manager Secret Version Adder", permissions: null, predefined: true },
  { name: "roles/iam.serviceAccountTokenCreator", title: "Service Account Token Creator", permissions: null, predefined: true },
  { name: "roles/run.invoker", title: "Cloud Run Invoker", permissions: null, predefined: true }
]

type IamCondition {
  title: String
  expression: String
  description: String?
}

type GcpBinding {
  role: String
  members: List<String>
  condition: IamCondition?
}

type GcpPolicy {
  bindings: List<GcpBinding>
  etag: String
  version: Int
}

// A GcpBinding is the WIRE shape: one role carrying a LIST of members. It is the
// wrong grain to reconcile at, because a diff over bindings answers "did this
// role's member list change" when the question is always "does THIS principal
// hold THIS role under THIS condition". Reconciling at binding grain is how a
// desired binding for one member overwrites the other members sharing its role.
//
// GcpIamBindingCell is that same fact at the grain a policy decision is actually
// made on: one role x one member x one condition. Cells are what a reconcile
// compares, and the binding list is recovered by grouping cells back by (role,
// condition) at the wire boundary -- so a cell nobody authored survives the round
// trip instead of being dropped by a role-level replacement.
type GcpIamBindingCell {
  role: String
  member: String
  condition: IamCondition?
}

// POLICY ASSEMBLY LIVES WITH THE POLICY TYPE, not in a consumer. setIamPolicy replaces the whole
// document, so every caller needs the same read-modify-write; if each one assembled its own, the
// preserve rule would be re-implemented per site and would drift.
//
// ONE RECONCILIATION MECHANISM, at cell grain, for every caller. An earlier revision of this file
// carried merge_policy_bindings, which replaced the whole member population of every role the
// caller authored. That was a SECOND semantics beside the cell-grain reconcile the Spark module
// already had -- the dual representation this work exists to remove -- and its failure mode is
// concrete: an unrelated member under a role the caller also uses is dropped without a diagnostic,
// because whole-role replacement cannot see members it does not author. It is deleted rather than
// kept beside this, and the callers that used it now pass an explicit owned-cell universe.
type GcpIamOwnedCellUniverse {
  cells: List<GcpIamBindingCell>
}

type GcpPolicyReconciliation
  = GcpPolicyAlreadyConverged { policy: GcpPolicy }
  | GcpPolicyDeltaRequired {
      policy: GcpPolicy
      added: List<GcpIamBindingCell>
      removed: List<GcpIamBindingCell>
      preserved: List<GcpIamBindingCell>
    }

fn gcp_condition_eq(a: IamCondition?, b: IamCondition?) -> Bool {
  match a {
    Absent =>
      match b {
        Absent => true
        Present { value: _ } => false
      }
    Present { value: ca } =>
      match b {
        Absent => false
        Present { value: cb } => ca.title == cb.title && ca.expression == cb.expression
      }
  }
}

fn gcp_cell_eq(a: GcpIamBindingCell, b: GcpIamBindingCell) -> Bool {
  a.role == b.role && a.member == b.member && gcp_condition_eq(a: a.condition, b: b.condition)
}

fn gcp_cell_in(c: GcpIamBindingCell, xs: List<GcpIamBindingCell>) -> Bool {
  fold(xs, init: false, f: (acc, x) => acc || gcp_cell_eq(a: c, b: x))
}

data no_gcp_cells: List<GcpIamBindingCell> = []

data no_gcp_bindings: List<GcpBinding> = []

// A wire binding is one role carrying MANY members; a cell is one role and one member. Flattening
// is what makes the diff answer the question a policy decision is actually made on.
fn gcp_binding_cells(b: GcpBinding) -> List<GcpIamBindingCell> {
  fold(b.members, init: no_gcp_cells, f: (acc, m) =>
    acc |> list_push(GcpIamBindingCell { role: b.role, member: m, condition: b.condition }))
}

fn gcp_policy_cells(p: GcpPolicy) -> List<GcpIamBindingCell> {
  fold(p.bindings, init: no_gcp_cells, f: (acc, b) =>
    fold(gcp_binding_cells(b: b), init: acc, f: (inner, c) => inner |> list_push(c)))
}

// Regroup cells into the wire shape. Cells sharing a (role, condition) rejoin one binding, so a
// cell nobody authored survives the round trip instead of being dropped by a role-level replace.
fn gcp_bindings_add_cell(bs: List<GcpBinding>, c: GcpIamBindingCell) -> List<GcpBinding> {
  let matched = fold(bs, init: false, f: (acc, b) =>
    acc || (b.role == c.role && gcp_condition_eq(a: b.condition, b: c.condition)))
  if matched {
    fold(bs, init: no_gcp_bindings, f: (acc, b) =>
      if b.role == c.role && gcp_condition_eq(a: b.condition, b: c.condition) {
        acc |> list_push(GcpBinding { role: b.role, members: b.members |> list_push(c.member), condition: b.condition })
      } else {
        acc |> list_push(b)
      })
  } else {
    bs |> list_push(GcpBinding { role: c.role, members: [c.member], condition: c.condition })
  }
}

fn gcp_cells_bindings(cs: List<GcpIamBindingCell>) -> List<GcpBinding> {
  fold(cs, init: no_gcp_bindings, f: (acc, c) => gcp_bindings_add_cell(bs: acc, c: c))
}

// reconcile_gcp_policy returns GcpPolicyAlreadyConverged as its OWN arm rather than a delta that
// happens to be empty, so a caller cannot write an unnecessary setIamPolicy and read the resulting
// etag bump as progress.
// Ownership is asked per CELL. Owning (member M, role accessor) does not confer authority over
// (member M, role admin): that grant may exist for a reason this caller cannot see, so it is
// preserved even though the member is one the caller recognises.
fn reconcile_gcp_policy(
  observed: GcpPolicy,
  desired_owned: List<GcpIamBindingCell>,
  owned_universe: GcpIamOwnedCellUniverse
) -> GcpPolicyReconciliation {
  let observed_cells = gcp_policy_cells(p: observed)
  let added = desired_owned |> filter(c => !gcp_cell_in(c: c, xs: observed_cells))
  let removed = observed_cells |> filter(c =>
    gcp_cell_in(c: c, xs: owned_universe.cells) && !gcp_cell_in(c: c, xs: desired_owned))
  let preserved = observed_cells |> filter(c => !gcp_cell_in(c: c, xs: owned_universe.cells))
  if count(added) == 0 && count(removed) == 0 {
    GcpPolicyAlreadyConverged { policy: observed }
  } else {
    let kept = observed_cells |> filter(c => !gcp_cell_in(c: c, xs: removed))
    let final_cells = fold(added, init: kept, f: (acc, c) => acc |> list_push(c))
    GcpPolicyDeltaRequired {
      policy: GcpPolicy {
        bindings: gcp_cells_bindings(cs: final_cells),
        etag: observed.etag,
        version: observed.version
      },
      added: added,
      removed: removed,
      preserved: preserved
    }
  }
}

// The permission set of a predefined role is a GOOGLE-OWNED fact that changes
// without our involvement, so it is observed from roles.get, never transcribed.
// There is deliberately no hand-authored permission roster in this module: a
// role->permission table written from memory is authored data wearing a citation,
// and it decays silently as Google edits the role.
type GcpPredefinedRole {
  name: String
  title: String
  included_permissions: List<String> from "includedPermissions"
  stage: String
}

type RolePermissionAuthority
  = RolePermissionsObserved { role: GcpPredefinedRole, observed_at_revision: NonEmptyStr }
  | RolePermissionsUnobserved { role_name: NonEmptyStr, cause: NonEmptyStr }

// Whether a role grants a permission is answerable ONLY from an observation. The
// unobserved arm returns no Bool at all rather than false, because "we did not
// look" and "the role does not grant it" have different remedies and collapsing
// them is the absorbing fallback in the direction that under-reports reach.
type RoleGrantsPermissionVerdict
  = RoleGrantsPermission
  | RoleDoesNotGrantPermission
  | RoleGrantUndetermined { cause: NonEmptyStr }

fn role_grants_permission(authority: RolePermissionAuthority, permission: String) -> RoleGrantsPermissionVerdict {
  match authority {
    RolePermissionsUnobserved { cause: c } => RoleGrantUndetermined { cause: c }
    RolePermissionsObserved { role: r } =>
      if list_contains_string(xs: r.included_permissions, needle: permission) {
        RoleGrantsPermission
      } else {
        RoleDoesNotGrantPermission
      }
  }
}

fn list_contains_string(xs: List<String>, needle: String) -> Bool {
  fold_list(xs: xs, empty: false, cons: fn(acc, x) { acc || x == needle })
}

type ImpersonationChain {
  source: String
  target: String
  delegates: List<String>
}

type TokenLifetime {
  default_seconds: Int
  max_seconds: Int
}

data default_token_lifetime: TokenLifetime = {
  default_seconds: 3600,
  max_seconds: 43200
}

type GcpGenerateAccessToken200Body {
  access_token: Secret from "accessToken"
  expire_time: String from "expireTime"
}

service gcp.IAM {
  config {
    endpoint: "https://iamcredentials.googleapis.com"
    auth: Bearer
    auth_input: access_token

    rate_limit: { requests: 60, per: minute, scope: iam_credentials }
  }

  operation GenerateAccessToken {
    input {
      access_token: Secret
      target_sa: ServiceAccountEmail
      lifetime_seconds: Int where range(min: 1, max: 3600)= 3600
    }
    output {
      access_token: Secret from "accessToken"
      expire_time: String from "expireTime"
    }

    idempotent
    transport rest { method: POST, path: "/v1/projects/-/serviceAccounts/\{target_sa\}:generateAccessToken" }
    response {
      200 => GcpGenerateAccessToken200Body
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

}

// SEPARATE SERVICE, not another operation on gcp.IAM: role reads live on
// iam.googleapis.com while token minting lives on iamcredentials.googleapis.com.
// Two hosts are two dependencies, and hanging GetRole off the credentials service
// would have had it inherit that service's endpoint and silently request the
// wrong host.
// GetRole is the citation behind RolePermissionsObserved. Predefined roles are
// readable without any project scope, so it is the cheapest possible grounding for
// "what does roles/secretmanager.secretAccessor actually permit" -- and the reason
// no permission roster is authored in this module.
service gcp.IamRoles {
  config { endpoint: "https://iam.googleapis.com", auth: Bearer, auth_input: access_token }

  operation GetRole {
    input { access_token: Secret, role_name: NonEmptyStr }
    output {
      name: String
      title: String
      included_permissions: List<String> from "includedPermissions"
      stage: String
    }
    readonly
    transport rest { method: GET, path: "/v1/\{role_name\}" }
    response {
      200 => GcpPredefinedRole
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}

service gcp.ResourceManager {
  config { endpoint: "https://cloudresourcemanager.googleapis.com", auth: Bearer, auth_input: access_token }

  operation GetIamPolicy {
    input { access_token: Secret, project_id: GcpProjectId }
    output { bindings: Json, etag: String }
    readonly
    transport rest { method: POST, path: "/v1/projects/\{project_id\}:getIamPolicy" }
    response {
      200 => GcpPolicy
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation SetIamPolicy {
    input {
      access_token: Secret
      project_id: GcpProjectId
      bindings: Json
      etag: NonEmptyStr
    }
    output { ok: Bool }
    transport rest { method: POST, path: "/v1/projects/\{project_id\}:setIamPolicy" }
    response {
      200 => GcpPolicy
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      409 => GcpErrorShape
      412 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}
