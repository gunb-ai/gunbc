module extdeps.cloud.gcp.storage

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { Bool, Int, List, String, NonEmptyStr, Secret }
import std.resources { Network }
import extdeps.ietf.http_semantics { GET, POST, PUT }
import extdeps.cloud.gcp.errors { GcpErrorShape }
import extdeps.cloud.gcp.iam { GcpPolicy, GcpBinding }
import extdeps.cloud.gcp.gcp { GcpService, GcpStorage, GcpProjectId }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/storage/docs/json_api/v1/objects"
  }
}

// GOOGLE CLOUD STORAGE JSON API v1 -- THE INTERFACE FACTS A MATERIALIZATION-STORE REALIZATION
// WOULD BIND TO, AND NOTHING ELSE. This module owns the upstream's shape (DESIGN section 3: the
// interface is extdeps', the transport handler is one realization bound to it, the policy is the
// workflow's). It carries no handler and no dispatch: the handler lands when the operator says
// (operator provider ruling, 2026-09-11). These rows are therefore a DECLARED FRONTIER in DESIGN
// section 3c's middle state -- consumed by a NAMED consumer in a NAMED later change. The consumer is the GCS
// realization handler, extdeps.realization.materialization_store_gcs, the sibling of
// extdeps.realization.materialization_store_local: it binds these rows to
// std.materialization_object's observations exactly as the local handler binds the filesystem
// operations. The change is dispatch step 5 of the ruled order (1 recut #10940, 2 ancestry, 3
// provider spine -- this change, 4 route integration, 5 NFS/GCS realization, 6 incubation), not an
// open-ended discretion. GCS-readiness TODAY is carried by std.materialization_object's path-free
// observation types, which are consumed now; these rows are the upstream facts (cited, upstream's
// own names, API version v1) that the handler binds, so that nothing re-coins them when it lands.
//
// What the rows establish, cited:
//   objects.get with alt=media returns the object's bytes; 404 is a typed absent object
//     (cloud.google.com/storage/docs/json_api/v1/objects/get) -- the exact-read semantics, with no
//     listing and no prefix fallback;
//   objects.insert with ifGenerationMatch=0 succeeds only if no live object has that name and
//     answers 412 Precondition Failed otherwise (cloud.google.com/storage/docs/request-preconditions)
//     -- put-if-absent; an object becomes visible only when the upload completes, so a reader never
//     observes a partial object;
//   read-after-write and read-after-metadata-update are strongly consistent for objects
//     (cloud.google.com/storage/docs/consistency) -- a commit's exact read-back is meaningful;
//   401/403 are authorization refusals and 429/5xx are availability refusals
//     (cloud.google.com/storage/docs/json_api/v1/status-codes) -- neither is ever an absent object.
// The object NAME is the only locator; there is no rename and no directory, which is exactly why the
// store's interface names neither.

type GcsObjectOperation
  = GcsObjectsGet
  | GcsObjectsInsert

// WHICH ENDPOINT, WITHOUT RESTATING ONE. objects.get is served by the JSON API, whose base URL is
// already owned by extdeps.cloud.gcp.gcp api_endpoints (the GcpStorage row) -- so the fact here
// names that authority and carries only the resource path relative to it (review 63888: the base
// literal is not re-minted). objects.insert with uploadType=media is served by the MEDIA UPLOAD
// endpoint, a distinct upstream URL that api_endpoints does not carry; it lives once, on this
// variant, cited to the upload documentation.
type GcsRequestEndpoint
  = GcsJsonApiEndpoint { service: GcpService }
  | GcsMediaUploadEndpoint { base_url: String, citation: String }

type GcsObjectOperationFacts {
  operation: GcsObjectOperation
  method: String
  endpoint: GcsRequestEndpoint
  resource_path: String
  required_query: List<String>
  citation: String
}

data gcs_objects_get: GcsObjectOperationFacts = GcsObjectOperationFacts {
  operation: GcsObjectsGet,
  method: "GET",
  endpoint: GcsJsonApiEndpoint { service: GcpStorage },
  resource_path: "/b/\{bucket\}/o/\{object\}",
  required_query: ["alt=media"],
  citation: "cloud.google.com/storage/docs/json_api/v1/objects/get"
}

data gcs_objects_insert_if_absent: GcsObjectOperationFacts = GcsObjectOperationFacts {
  operation: GcsObjectsInsert,
  method: "POST",
  endpoint: GcsMediaUploadEndpoint {
    base_url: "https://storage.googleapis.com/upload/storage/v1",
    citation: "cloud.google.com/storage/docs/uploading-objects"
  },
  resource_path: "/b/\{bucket\}/o",
  required_query: ["uploadType=media", "name=\{object\}", "ifGenerationMatch=0"],
  citation: "cloud.google.com/storage/docs/request-preconditions"
}

// The status codes the two operations answer, each with the upstream's own meaning. The mapping
// of these meanings onto a store observation is the HANDLER's, not this module's.
type GcsObjectStatusMeaning
  = GcsObjectReturned
  | GcsObjectNotFound
  | GcsPreconditionFailed
  | GcsUnauthenticated
  | GcsForbidden
  | GcsRateLimited
  | GcsServerError

type GcsObjectStatusFact {
  status: Int
  meaning: GcsObjectStatusMeaning
}

data gcs_object_status_facts: List<GcsObjectStatusFact> = [
  GcsObjectStatusFact { status: 200, meaning: GcsObjectReturned },
  GcsObjectStatusFact { status: 404, meaning: GcsObjectNotFound },
  GcsObjectStatusFact { status: 412, meaning: GcsPreconditionFailed },
  GcsObjectStatusFact { status: 401, meaning: GcsUnauthenticated },
  GcsObjectStatusFact { status: 403, meaning: GcsForbidden },
  GcsObjectStatusFact { status: 429, meaning: GcsRateLimited },
  GcsObjectStatusFact { status: 500, meaning: GcsServerError },
  GcsObjectStatusFact { status: 503, meaning: GcsServerError },
]

// ── THE JSON API v1 OPERATIONS THE BOOTSTRAP JOURNAL USES ───────────────────────────────────────
// Read from the upstream's Discovery document (storage.googleapis.com/$discovery/rest?version=v1,
// revision 20261013, read 2026-10-19): buckets.get GET b/{bucket}; buckets.insert POST b?project=;
// buckets.getIamPolicy GET b/{bucket}/iam; buckets.setIamPolicy PUT b/{bucket}/iam; objects.get GET
// b/{bucket}/o/{object} (metadata; `generation` is an int64 rendered as a string); objects.insert POST on
// the simple-upload path /upload/storage/v1/b/{bucket}/o with uploadType=media, name and
// ifGenerationMatch=0, which "succeeds only if no live object has that name" (gcs_objects_insert_if_absent)
// and answers 412 otherwise; objects.list GET b/{bucket}/o?prefix= answers items and a nextPageToken
// (a page holds at most 1000 by default). The uploaded bytes are the request body as sent.
type GcsObjectMetadataWire { name: String, bucket: String, generation: String }

// THE BUCKET AS THE JSON API ANSWERS IT (buckets resource, Discovery revision 20261013): projectNumber is a
// uint64 rendered as a string, location is the region (the API answers it upper-cased), and
// iamConfiguration carries uniformBucketLevelAccess.enabled and publicAccessPrevention ("inherited" or
// "enforced").
type GcsUniformBucketLevelAccessWire { enabled: Bool? }

type GcsBucketIamConfigurationWire { uniform_bucket_level_access: GcsUniformBucketLevelAccessWire? from "uniformBucketLevelAccess", public_access_prevention: String? from "publicAccessPrevention" }

type GcsBucketWire { name: String, project_number: String? from "projectNumber", location: String?, iam_configuration: GcsBucketIamConfigurationWire? from "iamConfiguration" }

type GcsObjectListWire { items: List<GcsObjectMetadataWire>?, next_page_token: String? from "nextPageToken" }

type GcsBucketPolicyWire { bindings: List<GcpBinding>?, etag: String, version: Int? }

service gcp.Storage {
  config { endpoint: "https://storage.googleapis.com", auth: Bearer, auth_input: access_token }

  operation GetBucket {
    requires Network
    input { access_token: Secret, bucket: NonEmptyStr }
    output { name: String, project_number: String? from "projectNumber", location: String?, iam_configuration: GcsBucketIamConfigurationWire? from "iamConfiguration" }
    readonly
    transport rest { method: GET, path: "/storage/v1/b/\{bucket\}" }
    response {
      200 => GcsBucketWire
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation InsertBucket {
    requires Network
    input { access_token: Secret, project_id: GcpProjectId, bucket: NonEmptyStr, location: NonEmptyStr, uniform_bucket_level_access: Bool, public_access_prevention: NonEmptyStr }
    output { name: String }
    idempotent
    transport rest { method: POST, path: "/storage/v1/b", query: { project: project_id }, body: { name: bucket, location: location, iamConfiguration: { uniformBucketLevelAccess: { enabled: uniform_bucket_level_access }, publicAccessPrevention: public_access_prevention } } }
    response {
      200 => GcsBucketWire
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation GetBucketIamPolicy {
    requires Network
    input { access_token: Secret, bucket: NonEmptyStr }
    output { bindings: List<GcpBinding>?, etag: String, version: Int? }
    readonly
    transport rest { method: GET, path: "/storage/v1/b/\{bucket\}/iam", query: { optionsRequestedPolicyVersion: 3 } }
    response {
      200 => GcsBucketPolicyWire
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation SetBucketIamPolicy {
    requires Network
    input { access_token: Secret, bucket: NonEmptyStr, bindings: List<GcpBinding>, etag: String, version: Int }
    output { bindings: List<GcpBinding>?, etag: String, version: Int? }
    transport rest { method: PUT, path: "/storage/v1/b/\{bucket\}/iam", body: GcpPolicy { bindings: bindings, etag: etag, version: version } }
    response {
      200 => GcsBucketPolicyWire
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      412 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation GetObjectMetadata {
    requires Network
    input { access_token: Secret, bucket: NonEmptyStr, object: NonEmptyStr }
    output { name: String, bucket: String, generation: String }
    readonly
    transport rest { method: GET, path: "/storage/v1/b/\{bucket\}/o/\{object\}" }
    response {
      200 => GcsObjectMetadataWire
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation ListObjects {
    requires Network
    input { access_token: Secret, bucket: NonEmptyStr, prefix: NonEmptyStr }
    output { items: List<GcsObjectMetadataWire>?, next_page_token: String? from "nextPageToken" }
    readonly
    transport rest { method: GET, path: "/storage/v1/b/\{bucket\}/o", query: { prefix: prefix } }
    response {
      200 => GcsObjectListWire
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation InsertObjectIfAbsent {
    requires Network
    input { access_token: Secret, bucket: NonEmptyStr, object: NonEmptyStr, kind: String, subject: String, consent: String }
    output { name: String, bucket: String, generation: String }
    transport rest { method: POST, path: "/upload/storage/v1/b/\{bucket\}/o", query: { uploadType: "media", name: object, ifGenerationMatch: 0 }, body: { kind: kind, subject: subject, consent: consent } }
    response {
      200 => GcsObjectMetadataWire
      400 => GcpErrorShape
      401 => GcpErrorShape
      403 => GcpErrorShape
      412 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}
