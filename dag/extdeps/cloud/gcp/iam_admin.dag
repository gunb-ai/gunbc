module extdeps.cloud.gcp.iam_admin


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "cloud.google.com/iam/docs/reference/rest"
  }
}

service gcp.IamAdmin {
  config {
    endpoint: "https://iam.googleapis.com"
    auth: Bearer
    auth_input: access_token

    rate_limit: { requests: 60, per: minute, scope: iam_admin }
  }

  operation CreateServiceAccount {
    input {
      access_token: Secret
      project_id: extdeps.cloud.gcp.gcp.GcpProjectId
      account_id: std.types.NonEmptyStr
      display_name: std.types.NonEmptyStr
    }
    output {
      email: extdeps.cloud.gcp.gcp.ServiceAccountEmail
      sa_name: String from "name"
    }

    idempotent
    transport rest {
      method: v2.std.network.POST,
      path: "/v1/projects/\{project_id\}/serviceAccounts",
      body: { accountId: account_id, serviceAccount: { displayName: display_name } }
    }
    response {
      200 => GcpServiceAccount
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation CreateWorkloadIdentityPool {
    input {
      access_token: Secret
      project_id: extdeps.cloud.gcp.gcp.GcpProjectId
      pool_id: std.types.NonEmptyStr
      display_name: std.types.NonEmptyStr
    }
    output { operation_name: String from "name" }

    idempotent
    transport rest {
      method: v2.std.network.POST,
      path: "/v1/projects/\{project_id\}/locations/global/workloadIdentityPools",
      query: { workloadIdentityPoolId: pool_id },
      body: { displayName: display_name, disabled: false }
    }
    response {
      200 => GcpOperation
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation CreateWorkloadIdentityPoolProvider {
    input {
      access_token: Secret
      project_id: extdeps.cloud.gcp.gcp.GcpProjectId
      pool_id: std.types.NonEmptyStr
      provider_id: std.types.NonEmptyStr
      issuer_uri: std.types.NonEmptyStr
      attribute_mapping: Map<String, String>
      attribute_condition: std.types.NonEmptyStr
    }
    output { operation_name: String from "name" }

    idempotent
    transport rest {
      method: v2.std.network.POST,
      path: "/v1/projects/\{project_id\}/locations/global/workloadIdentityPools/\{pool_id\}/providers",
      query: { workloadIdentityPoolProviderId: provider_id },
      body: {
        oidc: { issuerUri: issuer_uri },
        attributeMapping: attribute_mapping,
        attributeCondition: attribute_condition
      }
    }
    response {
      200 => GcpOperation
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}
