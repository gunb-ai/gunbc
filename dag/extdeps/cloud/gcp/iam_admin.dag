module extdeps.cloud.gcp.iam_admin


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.cloud.gcp.gcp { GcpProjectId, ServiceAccountEmail }
import extdeps.cloud.gcp.iam { GcpPolicy, GcpBinding }
import std.types { Int, List, Map, NonEmptyStr, Secret, String }
import extdeps.transports.rest { RestOutcome }
import v2.std.network { POST }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/iam/docs/reference/rest"
  }
}

// THE TWO SERVICE-ACCOUNT POLICY OPERATIONS READ AND WRITE WHO MAY ACT AS AN ACCOUNT, which is a
// different resource from the project policy that says what the account may do
// (cloud.google.com/iam/docs/reference/rest, projects.serviceAccounts getIamPolicy / setIamPolicy).
// Both are POST on the account resource, and getIamPolicy is a POST rather than a GET because the
// upstream declares it so, and getIamPolicy carries an EMPTY BODY on purpose: Google's frontend
// answers 411 Length Required to a POST with no body at all, so a bodyless POST never reaches the
// API. Observed 2026-09-17 against the live endpoint, during the run that created the heal
// publisher's account. The policy version is requested as a QUERY parameter, matching the shape
// gcp.SecretManager GetSecretIamPolicy already uses -- and it is not decoration: reading at
// version 1 mangles conditional bindings, which reconcile_gcp_policy refuses as
// GcpPolicyRepresentationLossy rather than replacing somebody's restricted access.
//
// EVERY OPERATION HERE CARRIES A RestOutcome, INCLUDING THE CREATES, and the reason is 409. A
// provisioning run that creates a pool, a provider and an account performs three writes that cannot
// be one request, so a failure at the third leaves the first two committed; without an outcome the
// rerun aborts at the first 409 and can never reach the step that failed, which is precisely the
// pressure that turns a modelled provisioning route into an operator doing the rest by hand. A 409
// is a fact the caller must be able to read and decide about -- it establishes that a resource with
// that id exists, and NOT that its configuration is the desired one, so the honest consumer treats
// it as an unverified presence and refuses to call the run converged on the strength of it.
// TWO CONSTRAINTS THIS MODULE LEARNED THE EXPENSIVE WAY, both observed against the live API on
// 2026-09-17 during the run that provisioned the heal publisher's identity, and both recorded at
// module-item grain because that is the only grain source annotations have (DESIGN section 4c).
//
// CreateWorkloadIdentityPool caps display_name at 32 CHARACTERS: a longer one answers 400
// INVALID_ARGUMENT, "The WorkloadIdentityPool's display name must be less than or equal to 32
// characters." Nothing here enforces it -- NonEmptyStr carries no length -- so consumers hold the
// bound with a claim over their own declared name. That gap is rostered as
// gunbc.recurring_failure_mode upstream_input_constraint_held_only_by_prose, whose ceiling is a
// length-refined carrier on this input, after which an over-long literal has no constructor.
//
// BOTH POLICY OPERATIONS declare bindings and version OPTIONAL because an empty policy omits them:
// an account created seconds earlier answers 200 with an etag alone. Declaring them required made
// that ordinary state undecodable. They are optional because the WIRE is; what an absent array MEANS
// is answered once by extdeps.cloud.gcp.iam gcp_policy_of, which every reader of a policy response
// goes through. The WRITE carries the same optionality for the same reason and one nobody had hit:
// setIamPolicy returns the policy it stored, so revoking the LAST binding answers with an etag alone.
// Rostered as gunbc.recurring_failure_mode required_output_field_absent_for_an_empty_upstream_resource.
service gcp.IamAdmin {
  config {
    endpoint: "https://iam.googleapis.com"
    auth: Bearer
    auth_input: access_token
  }

  operation CreateServiceAccount {
    input {
      access_token: Secret
      project_id: GcpProjectId
      account_id: NonEmptyStr
      display_name: NonEmptyStr
    }
    output {
      email: ServiceAccountEmail
      sa_name: String from "name"
      outcome: RestOutcome
    }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/serviceAccounts",
      body: { accountId: account_id, serviceAccount: { displayName: display_name } }
    }
    response {
      200 => GcpServiceAccount
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation GetServiceAccountIamPolicy {
    input {
      access_token: Secret
      project_id: GcpProjectId
      service_account: ServiceAccountEmail
    }
    output { bindings: List<GcpBinding>?, etag: String, version: Int?, outcome: RestOutcome }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/serviceAccounts/\{service_account\}:getIamPolicy",
      query: { "options.requestedPolicyVersion": 3 },
      body: { }
    }
    response {
      200 => GcpPolicy
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation SetServiceAccountIamPolicy {
    input {
      access_token: Secret
      project_id: GcpProjectId
      service_account: ServiceAccountEmail
      policy: GcpPolicy
    }
    output { bindings: List<GcpBinding>?, etag: String, version: Int?, outcome: RestOutcome }

    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/serviceAccounts/\{service_account\}:setIamPolicy",
      body: { policy: policy }
    }
    response {
      200 => GcpPolicy
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      409 => GcpErrorShape
      412 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation CreateWorkloadIdentityPool {
    input {
      access_token: Secret
      project_id: GcpProjectId
      pool_id: NonEmptyStr
      display_name: NonEmptyStr
    }
    output { operation_name: String from "name", outcome: RestOutcome }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/locations/global/workloadIdentityPools",
      query: { workloadIdentityPoolId: pool_id },
      body: { displayName: display_name, disabled: false }
    }
    response {
      200 => GcpOperation
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation CreateWorkloadIdentityPoolProvider {
    input {
      access_token: Secret
      project_id: GcpProjectId
      pool_id: NonEmptyStr
      provider_id: NonEmptyStr
      issuer_uri: NonEmptyStr
      attribute_mapping: Map<String, String>
      attribute_condition: NonEmptyStr
    }
    output { operation_name: String from "name", outcome: RestOutcome }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/locations/global/workloadIdentityPools/\{pool_id\}/providers",
      query: { workloadIdentityPoolProviderId: provider_id },
      body: {
        oidc: { issuerUri: issuer_uri },
        attributeMapping: attribute_mapping,
        attributeCondition: attribute_condition
      }
    }
    response {
      200 => GcpOperation
      401 => GcpErrorShape
      403 => GcpErrorShape
      409 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}
