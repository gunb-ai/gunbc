module extdeps.cloud.gcp.serviceusage


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.cloud.gcp.gcp { GcpProjectId }
import std.types { List, Secret, String }
import v2.std.network { POST, GET }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/service-usage/docs/reference/rest/v1/services/batchEnable"
  }
}

service gcp.ServiceUsage {
  config {
    endpoint: "https://serviceusage.googleapis.com"
    auth: Bearer
    auth_input: access_token
  }

  operation BatchEnableServices {
    input {
      access_token: Secret
      project_id: GcpProjectId
      service_ids: List<String>
    }
    output { operation_name: String from "name" }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/services:batchEnable",
      body: { serviceIds: service_ids }
    }
    response {
      200 => GcpOperation
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation EnableService {
    input {
      access_token: Secret
      project_id: GcpProjectId
      service_id: String
    }
    output { operation_name: String from "name" }

    idempotent
    transport rest {
      method: POST,
      path: "/v1/projects/\{project_id\}/services/\{service_id\}:enable"
    }
    response {
      200 => GcpOperation
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }

  operation GetService {
    input {
      access_token: Secret
      project_id: GcpProjectId
      service_id: String
    }
    output {
      name: String from "name"
      state: String from "state"
    }
    readonly
    transport rest {
      method: GET,
      path: "/v1/projects/\{project_id\}/services/\{service_id\}"
    }
    response {
      200 => GcpServiceUsageService
      401 => GcpErrorShape
      403 => GcpErrorShape
      404 => GcpErrorShape
      429 => GcpErrorShape
      5xx => GcpErrorShape
    }
  }
}

type GcpServiceUsageState
  = ServiceUsageStateUnspecified
  | ServiceUsageStateDisabled
  | ServiceUsageStateEnabled

// REST v1 services.State: STATE_UNSPECIFIED | DISABLED | ENABLED
// (cloud.google.com/service-usage/docs/reference/rest/v1/services#State). GetService still
// projects the JSON string; this sum is the closed set, and from_wire is Absent on anything else.

fn gcp_service_usage_state_wire(s: GcpServiceUsageState) -> String {
  match s {
    ServiceUsageStateUnspecified => "STATE_UNSPECIFIED"
    ServiceUsageStateDisabled => "DISABLED"
    ServiceUsageStateEnabled => "ENABLED"
  }
}

fn gcp_service_usage_state_from_wire(raw: String) -> GcpServiceUsageState? {
  if raw == gcp_service_usage_state_wire(s: ServiceUsageStateEnabled) {
    Present { value: ServiceUsageStateEnabled }
  } else {
    if raw == gcp_service_usage_state_wire(s: ServiceUsageStateDisabled) {
      Present { value: ServiceUsageStateDisabled }
    } else {
      if raw == gcp_service_usage_state_wire(s: ServiceUsageStateUnspecified) {
        Present { value: ServiceUsageStateUnspecified }
      } else {
        none
      }
    }
  }
}

type GcpServiceUsageService {
  name: String
  state: String
}
