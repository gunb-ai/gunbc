module extdeps.cloud.gcp.gcp


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.optional { Present, Absent }
import std.types { Bool, FilePath, Int, List, Map, NonEmptyStr, Secret, Unit, string_non_empty }
import std.algebra { non_empty }
import extdeps.ietf.http_semantics { POST }
import std.resources { Network }
import extdeps.transports.rest { RestResult }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/apis/design"
  }
}

type GcpProjectId = String where string_non_empty

type ServiceAccountEmail = String

type GcpProject {
  project_id: GcpProjectId
  project_number: Int
  name: String
}

type GcpServiceAccount {
  email: ServiceAccountEmail
  unique_id: String from "uniqueId"
  display_name: String? from "displayName"
  disabled: Bool
}

// THE LONG-RUNNING OPERATION a create answers with (google.longrunning.Operation,
// cloud.google.com/iam/docs/reference/rest/v1/projects.locations.workloadIdentityPools.providers.operations/get
// and cloud.google.com/iam/docs/reference/rest/v1/projects.locations.workloadIdentityPools.operations/get;
// the Operation and google.rpc.Status resources, read 2026-10-16). proto3 JSON OMITS a false `done`
// and a zero `code`, so absence on the wire is the proto3 default and never an unknown. `error` is
// set only on a finished operation that failed; `metadata` and `response` are not modeled because
// no consumer reads them (the created resource is read back by its own get).
type GoogleRpcStatus {
  code: Int?
  message: String?
}

type GcpOperation {
  name: String
  done: Bool?
  error: GoogleRpcStatus?
}

// THE STANDING OF AN OPERATION, decided once. Absent `done` is false (proto3), so it is Running.
// A present `error` is a failure whatever `done` says: the upstream sets it only on a finished,
// failed operation, and a status riding a not-done operation is not evidence of success. Absent
// `code` is proto3 zero and absent `message` is empty, kept as such so a refusal always carries
// what the upstream said.
type GcpOperationStanding
  = OperationRunning
  | OperationDone
  | OperationFailed { code: Int, message: String }

fn gcp_operation_standing(done: Bool?, error: GoogleRpcStatus?) -> GcpOperationStanding {
  match error {
    Present { value: status } => OperationFailed {
      code: match status.code { Present { value: c } => c  Absent => 0 },
      message: match status.message { Present { value: m } => m  Absent => "" }
    }
    Absent => match done {
      Present { value: d } => if d { OperationDone } else { OperationRunning }
      Absent => OperationRunning
    }
  }
}

// WHICH SUBJECT AN OPERATION NAME IS ABOUT. The service answers a create with the operation's full
// name, projects/{number}/locations/global/workloadIdentityPools/{pool}[/providers/{provider}]/operations/{id},
// carrying the project NUMBER. Each segment is parsed out so a path hole receives one segment, never
// a slash-bearing name (RFC 6570 simple expansion encodes "/"). A name that does not name the subject
// just created is a typed mismatch, not something to poll.
type WifOperationSubject
  = WifPoolOperation { pool_id: String }
  | WifProviderOperation { pool_id: String, provider_id: String }

type WifOperationName
  = WifOperationNamed { operation_id: String }
  | WifOperationNameMismatch { reason: String }

fn wif_operation_name_prefix(project_number: String, subject: WifOperationSubject) -> List<String> {
  match subject {
    WifPoolOperation { pool_id: p } => ["projects", project_number, "locations", "global", "workloadIdentityPools", p, "operations"]
    WifProviderOperation { pool_id: p, provider_id: v } => ["projects", project_number, "locations", "global", "workloadIdentityPools", p, "providers", v, "operations"]
  }
}

fn wif_operation_name_parse(name: String, project_number: String, subject: WifOperationSubject) -> WifOperationName {
  let parts = split(s: name, delimiter: "/")
  let prefix = wif_operation_name_prefix(project_number: project_number, subject: subject)
  if parts.length() != prefix.length() + 1 {
    WifOperationNameMismatch { reason: concat("operation name does not have the shape of the subject just created: ", name) }
  } else {
    if join(parts.take(n: prefix.length()), "/") != join(prefix, "/") {
      WifOperationNameMismatch { reason: concat("operation name does not name the subject just created: ", name) }
    } else {
      match parts.skip(n: prefix.length()).first() {
        Present { value: id } => if id == "" { WifOperationNameMismatch { reason: concat("operation name has an empty operation id: ", name) } } else { WifOperationNamed { operation_id: id } }
        Absent => WifOperationNameMismatch { reason: concat("operation name has no operation id: ", name) }
      }
    }
  }
}

type GcpOAuth2AccessTokenStrategy
  = AdcRefresh { adc_path: FilePath? }
  | GcloudCli

type GcpCredentialFlow
  = WorkloadIdentity {
      audience: NonEmptyStr
      service_account: ServiceAccountEmail?
      scopes: List<String>
    }
  | InteractiveAuth { scopes: List<String> }
  | OAuth2AccessToken { strategy: GcpOAuth2AccessTokenStrategy }

type OAuth2Scope {
  scope: String
  description: String
}

data common_scopes: List<OAuth2Scope> = [
  { scope: "https://www.googleapis.com/auth/cloud-platform", description: "Full access to all GCP resources" },
  { scope: "https://www.googleapis.com/auth/devstorage.read_write", description: "Read/write access to GCS" },
  { scope: "https://www.googleapis.com/auth/iam", description: "IAM management" },
  { scope: "https://www.googleapis.com/auth/pubsub", description: "Pub/Sub access" },
  { scope: "https://www.googleapis.com/auth/secretmanager", description: "Secret Manager access" }
]

type WifPool {
  name: String
  project: String
  display_name: String?
  disabled: Bool
}

type WifProvider {
  name: String
  pool: String
  issuer_uri: String
  attribute_mapping: Map<String, String>?
  attribute_condition: String?
}

// THE WIRE SHAPES A READ OF A POOL AND ITS PROVIDERS RETURNS (cloud.google.com/iam/docs/reference/rest,
// projects.locations.workloadIdentityPools get and .providers list, read 2026-09-23; resources
// WorkloadIdentityPool and WorkloadIdentityPoolProvider, re-read 2026-09-24). A provisioning
// run that finds a pool, provider or account already present must READ what is there before it
// grants anything through it; these are what it reads. Names are the full resource names the service
// answers in; state is ACTIVE or DELETED. The service answers in proto3 JSON, so every multi-word
// field is lowerCamelCase on the wire (issuerUri, attributeMapping, attributeCondition,
// displayName, workloadIdentityPoolProviders); each carries its real key as `from`, or it decodes
// as absent.
type WifOidcWire {
  issuer_uri: String from "issuerUri"
}

type WifProviderWire {
  name: String
  disabled: Bool?
  state: String?
  attribute_mapping: Map<String, String>? from "attributeMapping"
  attribute_condition: String? from "attributeCondition"
  oidc: WifOidcWire?
}

type WifPoolWire {
  name: String
  display_name: String? from "displayName"
  disabled: Bool?
  state: String?
}

type WifProviderListWire {
  workload_identity_pool_providers: List<WifProviderWire>? from "workloadIdentityPoolProviders"
}

fn wif_pool_resource(project_number: String, pool_id: String) -> String {
  concat(
    concat(concat("projects/", project_number), "/locations/global/workloadIdentityPools/"),
    pool_id
  )
}

fn wif_provider_resource(project_number: String, provider: WifProvider) -> String {
  concat(
    concat(wif_pool_resource(project_number: project_number, pool_id: provider.pool), "/providers/"),
    provider.name
  )
}

fn wif_principal_set_for_repo(project_number: String, pool_id: String, repository: String) -> String {
  concat(
    concat(
      concat("principalSet://iam.googleapis.com/", wif_pool_resource(project_number: project_number, pool_id: pool_id)),
      "/attribute.repository/"
    ),
    repository
  )
}

type GcpService
  = GcpStorage
  | GcpIam
  | GcpIamCredentials
  | GcpServiceUsage
  | GcpSecretManager
  | GcpCloudRun
  | GcpPubsub
  | GcpSts

fn gcp_service_wire_label(service: GcpService) -> String {
  match service {
    GcpStorage => "storage"
    GcpIam => "iam"
    GcpIamCredentials => "iamcredentials"
    GcpServiceUsage => "serviceusage"
    GcpSecretManager => "secretmanager"
    GcpCloudRun => "run"
    GcpPubsub => "pubsub"
    GcpSts => "sts"
  }
}

fn gcp_service_api_id(service: GcpService) -> String {
  concat(gcp_service_wire_label(service: service), ".googleapis.com")
}

type GcpApiEndpoint {
  service: GcpService
  base_url: String
  version: String
}

data api_endpoints: List<GcpApiEndpoint> = [
  { service: GcpStorage, base_url: "https://storage.googleapis.com/storage/v1", version: "v1" },
  { service: GcpIam, base_url: "https://iam.googleapis.com/v1", version: "v1" },
  { service: GcpSecretManager, base_url: "https://secretmanager.googleapis.com/v1", version: "v1" },
  { service: GcpCloudRun, base_url: "https://run.googleapis.com/v2", version: "v2" },
  { service: GcpPubsub, base_url: "https://pubsub.googleapis.com/v1", version: "v1" },
  { service: GcpSts, base_url: "https://sts.googleapis.com/v1", version: "v1" }
]

type GcpRegion {
  name: String
  zones: List<String>
  multi_region: Bool
}

data regions: List<GcpRegion> = [
  { name: "us-central1", zones: ["us-central1-a", "us-central1-b", "us-central1-c", "us-central1-f"], multi_region: false },
  { name: "us-east1", zones: ["us-east1-b", "us-east1-c", "us-east1-d"], multi_region: false },
  { name: "us-east4", zones: ["us-east4-a", "us-east4-b", "us-east4-c"], multi_region: false },
  { name: "europe-west1", zones: ["europe-west1-b", "europe-west1-c", "europe-west1-d"], multi_region: false },
  { name: "us", zones: [], multi_region: true },
  { name: "eu", zones: [], multi_region: true }
]

service gcloud.Auth {
  operation Login {
    requires Network
    input {}
    output { ok: Bool from "exit_success" }
    transport shell { argv: ["gcloud", "auth", "login", "--update-adc"] }
    exit {
      0 => Unit
      nonzero => String "Authentication failed"
    }
  }
}

type GoogleOAuth2Refresh200Body {
  access_token: Secret
  expires_in: Int
  token_type: String
  scope: String?
}

service oauth2.Google {
  config { endpoint: "https://oauth2.googleapis.com" }

  operation Refresh {
    requires Network
    input {
      client_id: String
      client_secret: Secret
      refresh_token: Secret
    }
    output {
      access_token: Secret from "access_token"
      expires_in: Int from "expires_in"
    }

    idempotent
    transport rest { method: POST, path: "/token" }
    response {
      200 => GoogleOAuth2Refresh200Body
      400 => GcpOAuth2ErrorShape
      401 => GcpOAuth2ErrorShape
      5xx => GcpOAuth2ErrorShape
    }
  }
}
