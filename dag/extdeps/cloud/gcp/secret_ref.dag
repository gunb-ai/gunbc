module extdeps.cloud.gcp.secret_ref

import std.types { String, NonEmptyStr, Bool }
import std.content_hash { ContentHash }
import extdeps.cloud.gcp.gcp { GcpProjectId }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.cloud.gcp.secret_manager {
  SmResolvedVersionIdentity,
  SmVersionSecretProjected,
  SmVersionSecretNotAVersionResource,
  sm_resolved_version_secret_resource,
  SmVersionIdProjected,
  SmVersionIdNotAVersionResource,
  sm_resolved_version_id,
  sm_version_id_is_number,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cloud.google.com/secret-manager/docs/reference/rest/v1/projects.secrets.versions"
  }
}

type SecretRefHashState
  = HashKnown { content_hash: ContentHash }
  | HashPending

type SecretRef {
  project: GcpProjectId
  secret: NonEmptyStr
  version: NonEmptyStr
  hash_state: SecretRefHashState
}

// THE CANONICAL SECRET RESOURCE, REACHABLE WITHOUT A SecretRef. A caller that has a project and a
// secret id but no version -- which is every caller standing BEFORE the write that mints one -- had
// to either invent a placeholder version to borrow this spelling or concatenate its own. The second
// is what happened, and a second spelling of a resource name is exactly the drift DESIGN section 3
// forbids: the two sides disagree the moment either learns about a new segment.
fn gcp_secret_resource(project: GcpProjectId, secret: NonEmptyStr) -> String {
  concat(
    concat(concat("projects/", project as String), "/secrets/"),
    secret as String
  )
}

// GCP ANSWERS IN PROJECT NUMBERS WHILE CALLERS ADDRESS BY PROJECT ID, and a comparison that does not
// know this refuses every real response. Secret Manager canonicalizes a resource name to
// "projects/<number>/secrets/<id>" regardless of which spelling the request used, so an exact-string
// join against the requested name is correct in intent and wrong in fact -- it was measured refusing
// a live GetSecret whose only difference was 582015116396 in place of gunbai-secrets.
//
// THE FIX IS TWO ACCEPTED SPELLINGS, NOT A LOOSER COMPARISON. Falling back to a suffix or to the
// secret segment alone would re-open the cross-project hole that a full-resource join was introduced
// to close: both accepted forms are FULLY QUALIFIED and name THIS project, so a foreign project in
// either spelling is still refused. The caller supplies the number because the ID-to-number binding
// is a fact about a specific project, not something this module can derive.
fn gcp_secret_resource_by_number(project_number: String, secret: NonEmptyStr) -> String {
  concat(
    concat(concat("projects/", project_number), "/secrets/"),
    secret as String
  )
}

fn gcp_resource_names_this_secret(
  returned: String,
  project: GcpProjectId,
  project_number: String,
  secret: NonEmptyStr,
) -> Bool {
  returned == gcp_secret_resource(project: project, secret: secret)
    || returned == gcp_secret_resource_by_number(project_number: project_number, secret: secret)
}

fn secret_ref_secret_resource(ref: SecretRef) -> String {
  gcp_secret_resource(project: ref.project, secret: ref.secret)
}

// THE VERSION RESOURCE IN THE SPELLING THE SERVICE ANSWERS IN. Measured: AccessVersion returns
// "projects/582015116396/secrets/<id>/versions/<n>" for a request addressed by project ID, so a join
// against the ID-built name refuses every real response.
fn gcp_version_resource_by_number(project_number: String, secret: NonEmptyStr, version: NonEmptyStr) -> String {
  concat(
    concat(gcp_secret_resource_by_number(project_number: project_number, secret: secret), "/versions/"),
    version as String
  )
}

// THE VERSION SEGMENT OF A REQUEST IS NOT ONE KIND OF VALUE, AND TREATING IT AS ONE SHIPPED A
// CREDENTIAL PATH THAT REFUSED EVERY REAL RESPONSE. Secret Manager admits exactly two things in the
// version segment of an AccessVersion request -- a version number, or the moving alias `latest`
// (cloud.google.com/secret-manager/docs/reference/rest/v1/projects.secrets.versions/access: "the
// version can be a version number as a string (e.g. "5") or an alias (e.g. "latest")") -- and the
// service ANSWERS in resolved numbers either way. An exact-string join built from the REQUESTED
// segment therefore compares a numeric answer against ".../versions/latest" and is false on every
// run, which is what both rows of the host credential custody roster were doing.
//
// THE REPAIR IS A SELECTOR, NOT A SPECIAL CASE FOR ONE STRING. A number denotes ONE immutable
// payload forever; `latest` denotes whatever the most recent enabled version happens to be at the
// instant it is resolved, so the same string means a different secret before and after an
// add-version. Those are two different questions to ask of a response, and a string equality that
// knows about "latest" inside it would be one question pretending to be two. Two arms and no third:
// a malformed selector is not a state this classifier can helpfully invent, because the identity
// decoder in extdeps.cloud.gcp.secret_manager already refuses a malformed resolved name with a
// located, typed cause, and a second weaker validator here would be a fork of that decision.
//
// IT LIVES HERE, BESIDE THE RESOURCE-NAME BUILDER, because the alias rule is a fact about how this
// upstream addresses a version -- the same fact secret_ref_version_resource realizes -- and not a
// fact about any workflow that happens to rotate a secret. It was previously declared in
// gunbc.auth.secret_rotation, one layer up and reachable only by a rotation; that placement is why
// the credential fetch, which is the other consumer of exactly this distinction, did not have it.
type SecretVersionSelector
  = ExactVersion { number: NonEmptyStr }
  | AliasLatest

data latest_alias_literal: NonEmptyStr = "latest"

fn classify_version_selector(version: NonEmptyStr) -> SecretVersionSelector {
  if (version as String) == (latest_alias_literal as String) {
    AliasLatest
  } else {
    ExactVersion { number: version }
  }
}

fn secret_ref_selector(ref: SecretRef) -> SecretVersionSelector {
  classify_version_selector(version: ref.version)
}

fn selector_is_alias(selector: SecretVersionSelector) -> Bool {
  match selector {
    AliasLatest => true
    ExactVersion { number: _ } => false
  }
}

fn selector_version_label(selector: SecretVersionSelector) -> NonEmptyStr {
  match selector {
    ExactVersion { number: n } => n
    AliasLatest => latest_alias_literal
  }
}

// THE ANSWER SAYS WHICH VERSION WAS SERVED, WHICH A BOOL COULD NOT. The predicate this replaces
// returned true or false, so an alias request that resolved correctly had nowhere to put the number
// it resolved TO, and the caller's receipt could only repeat the alias back -- a receipt that names
// a moving target is not a record of what was served. The resolved arm carries the projected
// numeric version, read out of the response rather than carried beside it.
//
// THE ORDER OF THE PROOF IS THE CONTENT. Project and secret are established FIRST, from the fully
// qualified resource in either accepted spelling of THIS project, and only then does the selector
// decide about the version. That order is what keeps the alias arm from being a hole: `latest` never
// relaxes WHICH secret answered, it relaxes only which generation of it, so a foreign project or a
// foreign secret is refused identically in both spellings. An exact request stays exactly as
// fail-closed as it was -- a different number is refused -- and an alias resolving to anything that
// is not an upstream version number is refused too, including the alias echoed back at us, because
// an unresolved answer establishes nothing about what the bytes are.
type SecretRefVersionResolution
  = SecretRefVersionResolvedExact { version: NonEmptyStr }
  | SecretRefVersionResolvedAlias { alias: NonEmptyStr, version: NonEmptyStr }
  | SecretRefVersionResolutionRefused { requested: String, returned: String }

fn secret_ref_version_resolution_refusal(ref: SecretRef, returned: SmResolvedVersionIdentity) -> SecretRefVersionResolution {
  SecretRefVersionResolutionRefused {
    requested: secret_ref_version_resource(ref: ref),
    returned: returned as String,
  }
}

fn resolve_returned_version(
  returned: SmResolvedVersionIdentity,
  ref: SecretRef,
  project_number: String,
) -> SecretRefVersionResolution {
  match sm_resolved_version_secret_resource(identity: returned) {
    SmVersionSecretNotAVersionResource { supplied: _ } =>
      secret_ref_version_resolution_refusal(ref: ref, returned: returned)
    SmVersionSecretProjected { secret_resource: secret_resource } =>
      if !gcp_resource_names_this_secret(
           returned: secret_resource as String,
           project: ref.project,
           project_number: project_number,
           secret: ref.secret) {
        secret_ref_version_resolution_refusal(ref: ref, returned: returned)
      } else {
        match sm_resolved_version_id(identity: returned) {
          SmVersionIdNotAVersionResource { supplied: _ } =>
            secret_ref_version_resolution_refusal(ref: ref, returned: returned)
          SmVersionIdProjected { version: served } =>
            match secret_ref_selector(ref: ref) {
              ExactVersion { number: requested_number } =>
                if (served as String) == (requested_number as String) {
                  SecretRefVersionResolvedExact { version: served }
                } else {
                  secret_ref_version_resolution_refusal(ref: ref, returned: returned)
                }
              AliasLatest =>
                if sm_version_id_is_number(version: served as String) {
                  SecretRefVersionResolvedAlias { alias: latest_alias_literal, version: served }
                } else {
                  secret_ref_version_resolution_refusal(ref: ref, returned: returned)
                }
            }
        }
      }
  }
}

fn secret_ref_version_resource(ref: SecretRef) -> String {
  concat(
    concat(secret_ref_secret_resource(ref: ref), "/versions/"),
    ref.version as String
  )
}

// THE ACCESS URL, BUILT FROM THE REF AND NOTHING ELSE. Two call sites were spelling this by hand
// -- the fleet key's fetch and the administrator credential's -- and a second builder for one
// construction is the nicknaming DESIGN §3 forbids: the day a project moves or a version pins, one
// of them is edited and the other silently fetches something else. Project, secret and version all
// come from the one authority the caller already holds.
fn secret_ref_access_url(ref: SecretRef) -> String {
  join([
    "https://secretmanager.googleapis.com/v1/",
    secret_ref_version_resource(ref: ref),
    ":access",
  ], "")
}

fn secret_ref_hash_known(ref: SecretRef) -> Bool {
  match ref.hash_state {
    HashKnown { content_hash: _ } => true
    HashPending => false
  }
}
