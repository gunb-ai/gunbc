module extdeps.cloud.aws_ec2

import std.types { Int, Bool, NonEmptyStr, String, List }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.currency.currency { CurrencyCode, Usd }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.measure { Gigabyte, Gibibyte, Mebibyte, Bandwidth, HardwareThreadCount, MoneyPerHour, gigabyte, gibibyte, bandwidth, hardware_thread_count }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// AMAZON EC2, THE CONTROL-PLANE CALLS THE FLEX LOOP USES, at EC2 API version 2016-11-15 (the Query API
// version every current EC2 action is published under). Read 2026-10-23 from the Amazon EC2 API Reference
// and the EC2 User Guide pages cited below. This module owns the request and response SHAPE only: no
// transport (the Query protocol, SigV4 signing), no policy (which type, which region, what MaxPrice) and
// no observation of this repository's account. Only the members the loop reads or sets are modeled; an
// unmodeled member is unread, not absent upstream.
//
// NAMES ARE THE API MEMBER NAMES in snake_case, mechanically (instanceId -> instance_id,
// spotPriceHistorySet -> spot_price_history). Wire enumerations whose documented value set is closed are
// closed sums here; free-text members stay String.
//
// THE SPOT MODEL IS NOT A BID MARKET. A spot instance is charged the current Spot price for its type and
// availability zone; MaxPrice only caps what the requester will pay, and an instance whose cap falls
// below the Spot price may be interrupted (User Guide, using-spot-instances). So there is no bid level
// here, only an observed price (DescribeSpotPriceHistory) and an optional cap (SpotMarketOptions).
//
// MONEY ON THE WIRE IS A DECIMAL STRING ("spotPrice", "maxPrice") in US dollars per instance-hour. Here it
// is std.measure MoneyPerHour, the SAME carrier extdeps.pricing.aws_ec2 AwsEc2OnDemandPriceRow uses for
// the on-demand hourly price, so a spot and an on-demand quote are one type and compare directly. The
// parse from the wire string is the ingest step and is not in this module; it refuses a string with more
// fractional digits than the micro carrier holds rather than rounding a price. Timestamps on the wire are ISO 8601 dateTime strings and stay String here for the
// same reason.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.aws.amazon.com/AWSEC2/latest/APIReference/Welcome.html" }
}

