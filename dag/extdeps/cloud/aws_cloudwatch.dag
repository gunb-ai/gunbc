module extdeps.cloud.aws_cloudwatch

import std.types { Bool, Int, NonEmptyStr, String, List }
import std.decimal { ExactDecimal }
import std.measure { Second }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// AMAZON CLOUDWATCH, the one read the flex loop uses: GetMetricData for the account-wide usage metric a
// Service Quotas quota names (extdeps.cloud.aws_service_quotas AwsQuotaMetricInfo; namespace AWS/Usage for
// EC2 vCPU quotas). A separately versioned AWS service (API version 2010-08-01), read 2026-10-23. Only the
// members that read one statistic of one metric over one window are modeled. A result whose status is
// not Complete, or with no value in the window, is unread usage: the consumer refuses, never reads 0.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.aws.amazon.com/AmazonCloudWatch/latest/APIReference/API_GetMetricData.html" }
}

data aws_cloudwatch_service_quotas_usage_page: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-Service-Quota-Integration.html" }
}

// The subject is the service; aws_cloudwatch_api_version is its revision fact.
data amazon_cloudwatch_api: NonEmptyStr = "Amazon CloudWatch API"

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cloud.aws_cloudwatch",
      decl_name: "amazon_cloudwatch_api",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [aws_cloudwatch_service_quotas_usage_page]
}

data aws_cloudwatch_api_version: NonEmptyStr = "2010-08-01"

// DECLARED FRONTIER (DESIGN 3c): nothing imports this module yet. Its consumer is the account-wide quota
// usage read of the flex AWS supplier row, PR 4 of gunbc.plans.flex_supplier_generalization.
data aws_cloudwatch_flex_consumer_frontier: DissolutionCondition = unbound_dissolution(description: "Dissolves when product.fabric imports extdeps.cloud.aws_cloudwatch for the quota usage read of the flex AWS supplier row (gunbc.plans.flex_supplier_generalization PR 4) and a Plan-mode pass executes over these shapes.")

type AwsCloudWatchDimension {
  name: NonEmptyStr
  value: String
}

type AwsCloudWatchMetric {
  namespace: NonEmptyStr
  metric_name: NonEmptyStr
  dimensions: List<AwsCloudWatchDimension>
}

// MetricStat: the metric, the period (std.measure Second; seconds on the wire) and the statistic (the quota's
// metric_statistic_recommendation, e.g. Maximum).
type AwsCloudWatchMetricStat {
  metric: AwsCloudWatchMetric
  period: Second
  stat: NonEmptyStr
}

type AwsCloudWatchMetricDataQuery {
  id: NonEmptyStr
  metric_stat: AwsCloudWatchMetricStat
  return_data: Bool
}

type AwsCloudWatchGetMetricDataRequest {
  metric_data_queries: List<AwsCloudWatchMetricDataQuery>
  start_time: String
  end_time: String
  next_token: String?
}

// StatusCode: Complete, InternalError, PartialData, Forbidden. Only Complete is a reading.
type AwsCloudWatchStatusCode
  = AwsCloudWatchComplete
  | AwsCloudWatchInternalError
  | AwsCloudWatchPartialData
  | AwsCloudWatchForbidden

type AwsCloudWatchMetricDataResult {
  id: NonEmptyStr
  label: String
  timestamps: List<String>
  values: List<ExactDecimal>
  status_code: AwsCloudWatchStatusCode
}

type AwsCloudWatchGetMetricDataResponse {
  metric_data_results: List<AwsCloudWatchMetricDataResult>
  next_token: String?
}
