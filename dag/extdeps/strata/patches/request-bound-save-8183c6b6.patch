diff --git a/serve/test_request_bound_save.py b/serve/test_request_bound_save.py
new file mode 100644
index 00000000..55d2ef8a
--- /dev/null
+++ b/serve/test_request_bound_save.py
@@ -0,0 +1,205 @@
+"""Request-bound SAVE through the real HTTP/FIFO path; scripted engine, no GPU or model."""
+import json
+from pathlib import Path
+import tempfile
+import unittest
+import urllib.error
+import urllib.request
+
+from serve.frontend import ChatTemplate
+from serve.server import ByteTokenizer, EngineDied, MockEngine, Service, serve
+from serve.test_vision_elastic import ElasticVision
+
+
+class SavingEngine(MockEngine):
+    def __init__(self, tok):
+        super().__init__(tok, "answer")
+        self.proc = object()
+        self.saved = []
+        self.after_save = lambda: None
+        self.fail_next = False
+        self.cancel_next = False
+
+    def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+        if self.fail_next:
+            self.fail_next = False
+            raise EngineDied("scripted inference failure")
+        if self.cancel_next:
+            self.cancel_next = False
+            cancel.set()
+            return
+        yield from super().generate(ids, max_new, sampling, cancel, embeddings)
+
+    def session_file(self, action, path):
+        if action == "save":
+            self.saved.append(path)
+            Path(path).write_bytes(b"scripted checkpoint")
+            self.after_save()
+        return {"tokens": len(self.last_prompt), "bytes": 19, "ms": 1.0}
+
+    def vram(self, reserve_mib):
+        return {"reserve_mib": reserve_mib}
+
+
+class RequestBoundSave(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        tok = ByteTokenizer()
+        self.engine = SavingEngine(tok)
+        self.svc = Service(self.engine, tok, ChatTemplate(Path(__file__).with_name("chat_template.jinja")))
+        self.svc.slot_save_path = self.directory.name
+        self.httpd = serve(self.svc, port=0)
+        self.addCleanup(self.httpd.server_close)
+        self.addCleanup(self.httpd.shutdown)
+        self.base = f"http://127.0.0.1:{self.httpd.server_address[1]}"
+
+    def post(self, path, body):
+        req = urllib.request.Request(self.base + path, data=json.dumps(body).encode(),
+                                     headers={"Content-Type": "application/json"})
+        try:
+            response = urllib.request.urlopen(req, timeout=10)
+        except urllib.error.HTTPError as error:
+            response = error
+        with response:
+            return response.status, json.loads(response.read())
+
+    def chat(self, text="first", **kwargs):
+        status, body = self.post("/v1/chat/completions", {
+            "model": "strata", "messages": [{"role": "user", "content": text}],
+            "max_tokens": 32, "chat_template_kwargs": {"enable_thinking": False},
+            **kwargs,
+        })
+        self.assertEqual(status, 200, body)
+        self.assertEqual(self.svc.wait_for_drain(2), 0)
+        return body["id"]
+
+    def save(self, request_id, filename="request.bin"):
+        return self.post("/slots/0?action=save", {"filename": filename,
+                                                "expected_request_id": request_id})
+
+    def test_completed_response_id_saves_and_is_echoed(self):
+        request_id = self.chat()
+        status, body = self.save(request_id)
+        self.assertEqual(status, 200, body)
+        self.assertEqual(body["request_id"], request_id)
+        self.assertEqual(len(self.engine.saved), 1)
+
+    def test_unsent_request_cannot_save_the_previous_conversation(self):
+        self.chat()
+        status, body = self.save("chatcmpl-never-forwarded")
+        self.assertEqual(status, 409, body)
+        self.assertEqual(body["error"]["condition"], "request_not_current")
+        self.assertEqual(self.engine.saved, [])
+
+    def test_a_later_request_invalidates_the_previous_id(self):
+        first = self.chat()
+        second = self.chat("second")
+        self.assertNotEqual(first, second)
+        self.assertEqual(self.save(first)[0], 409)
+        self.assertEqual(self.save(second)[0], 200)
+        self.assertEqual(len(self.engine.saved), 1)
+
+    def test_failed_inference_does_not_leave_the_previous_owner(self):
+        request_id = self.chat()
+        self.engine.fail_next = True
+        status, _ = self.post("/v1/chat/completions", {
+            "messages": [{"role": "user", "content": "failure"}], "max_tokens": 8,
+        })
+        self.assertNotEqual(status, 200)
+        self.assertEqual(self.svc.wait_for_drain(2), 0)
+        self.assertEqual(self.save(request_id)[0], 409)
+        self.assertEqual(self.engine.saved, [])
+
+    def test_cancelled_inference_does_not_bind_a_response_id(self):
+        self.engine.cancel_next = True
+        request_id = self.chat()
+        self.assertEqual(self.save(request_id)[0], 409)
+        self.assertEqual(self.engine.saved, [])
+
+    def test_request_disabling_checkpoints_does_not_bind_a_response_id(self):
+        request_id = self.chat(strata_checkpoint=False)
+        self.assertEqual(self.save(request_id)[0], 409)
+        self.assertEqual(self.engine.saved, [])
+
+    def test_streamed_response_uses_the_same_request_binding(self):
+        req = urllib.request.Request(self.base + "/v1/chat/completions", data=json.dumps({
+            "messages": [{"role": "user", "content": "stream"}], "max_tokens": 32,
+            "stream": True, "chat_template_kwargs": {"enable_thinking": False},
+        }).encode(), headers={"Content-Type": "application/json"})
+        with urllib.request.urlopen(req, timeout=10) as response:
+            chunks = [json.loads(line[6:]) for line in response.read().decode().splitlines()
+                      if line.startswith("data: ") and line != "data: [DONE]"]
+        self.assertEqual(self.svc.wait_for_drain(2), 0)
+        self.assertTrue(chunks)
+        self.assertEqual({c["id"] for c in chunks}, {chunks[0]["id"]})
+        self.assertEqual(self.save(chunks[0]["id"])[0], 200)
+
+    def test_native_restart_under_the_same_service_refuses(self):
+        request_id = self.chat()
+        self.engine.proc = object()
+        status, body = self.save(request_id)
+        self.assertEqual(status, 409, body)
+        self.assertEqual(body["error"]["condition"], "engine_changed")
+        self.assertEqual(self.engine.saved, [])
+
+    def test_restore_invalidates_the_completed_request_even_without_restart(self):
+        request_id = self.chat()
+        self.assertEqual(self.save(request_id)[0], 200)
+        self.assertEqual(self.post("/slots/0?action=restore", {"filename": "request.bin"})[0], 200)
+        self.assertEqual(self.save(request_id, "stale.bin")[0], 409)
+        self.assertEqual(len(self.engine.saved), 1)
+
+    def test_vram_resize_invalidates_the_completed_request(self):
+        request_id = self.chat()
+        self.assertEqual(self.post("/v1/vram", {"reserve_mib": 2048})[0], 200)
+        self.assertEqual(self.save(request_id)[0], 409)
+        self.assertEqual(self.engine.saved, [])
+
+    def test_elastic_encoder_resize_invalidates_the_completed_request(self):
+        self.svc.vision = ElasticVision(self.directory.name)
+        request_id = self.chat()
+        with self.svc.fifo:
+            self.svc._vision_up()
+        self.assertEqual(self.save(request_id)[0], 409)
+        request_id = self.chat("with encoder loaded")
+        self.assertEqual(self.svc._vision_idle_down(force=True), "down")
+        self.assertEqual(self.save(request_id)[0], 409)
+        self.assertEqual(self.engine.saved, [])
+
+    def test_an_http_request_still_in_flight_prevents_conditional_save(self):
+        request_id = self.chat()
+        self.assertTrue(self.svc.reserve_inference())
+        try:
+            status, body = self.save(request_id)
+            self.assertEqual(status, 409, body)
+            self.assertEqual(body["error"]["condition"], "request_in_flight")
+            self.assertEqual(self.engine.saved, [])
+        finally:
+            self.svc.release_inference()
+
+    def test_process_change_during_save_does_not_report_a_verified_file(self):
+        request_id = self.chat()
+        self.engine.after_save = lambda: setattr(self.engine, "proc", object())
+        status, body = self.save(request_id)
+        self.assertEqual(status, 409, body)
+        self.assertEqual(body["error"]["condition"], "engine_changed")
+        self.assertTrue(body["error"]["published"])
+
+    def test_invalid_condition_and_restore_condition_do_not_touch_the_engine(self):
+        for value in (None, "", 1, True, [], {}, "x" * 257):
+            with self.subTest(value=value):
+                self.assertEqual(self.save(value)[0], 400)
+        self.assertEqual(self.post("/slots/0?action=restore", {
+            "filename": "request.bin", "expected_request_id": "chatcmpl-any",
+        })[0], 400)
+        self.assertEqual(self.engine.saved, [])
+
+    def test_unconditional_save_keeps_the_existing_response_shape(self):
+        status, body = self.post("/slots/0?action=save", {"filename": "legacy.bin"})
+        self.assertEqual(status, 200, body)
+        self.assertEqual(set(body), {"id_slot", "filename", "n_saved", "n_written", "timings"})
+
+
+if __name__ == "__main__":
+    unittest.main()
