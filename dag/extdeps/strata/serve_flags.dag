module extdeps.strata.serve_flags

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { TokenCount, token_count_value, Mebibyte, mebibyte_count, PositiveSlotCount, positive_slot_count_value }
import std.optional { Present, Absent }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, CitedFigureStanding, CitedToAuthority, TranscribedUncited, ObservedByReceipt, cited_figure_read_obligation }

// THE STRATA ENGINE'S SERVING FLAGS, as the upstream documents them at commit
// 8183c6b67162340c09b67360860177c577a65f2e of https://github.com/Niko1221/Strata (README.md "Good to
// know", docs/BATCHING.md option table, docs/DETAILS.md KV cache, expert-mapping and CPU worker
// sections). Only the flags a serving cell pins are modeled; the rest of the CLI is not, and a flag
// added here is added with its citation. The ARM forward-port this repository builds from is an
// observation of ours and lives in gunbc.serving.strata_arm_port, never here (gunbc.design_argument::single_authority,
// external upstream decomposition).

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/Niko1221/Strata/tree/8183c6b67162340c09b67360860177c577a65f2e/docs" as NonEmptyStr
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.strata.serve_flags",
      decl_name: "StrataServeFlags",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

// `--kv` (docs/DETAILS.md): 4-bit q4_0 (engine 0.1.8), 8-bit int8, and the hybrid k8v4 (engine
// 0.1.25, PR #120). Leaving the flag off keeps the engine's default format, which these docs do not
// name, so it has no arm here rather than a guessed one.
type StrataKvFormat
  = StrataKvQ4_0
  | StrataKvInt8
  | StrataKvK8v4

// `--kv-resident N` (docs/DETAILS.md, docs/BATCHING.md): only the attention's last N tokens of KV
// stay in VRAM and the rest streams from a pinned host copy. Without the flag the whole KV cache is
// resident.
type StrataKvResidency
  = StrataKvResidentWindow { tokens: TokenCount }
  | StrataKvFullyResident

// `--batch-groups` (docs/BATCHING.md option table): with a layer split, the slots flow through the
// GPU stages in G pipelined groups, G dividing the slot count; `auto` is one group per stage.
type StrataBatchGroups
  = StrataBatchGroupsAuto
  | StrataBatchGroupsCount { groups: PositiveSlotCount }

// `--layer-split` (docs/BATCHING.md): `auto`, or explicit stage boundaries such as `12,24,36`, one
// boundary fewer than the GPU count. `--trim-stage-weights` needs the explicit form.
type StrataLayerSplit
  = StrataLayerSplitAuto
  | StrataLayerSplitAt { boundaries: List<Nat> }

// `--trim-stage-weights` (docs/BATCHING.md): every GPU loads only the dense weights of its own layers;
// it applies only with an explicit `--layer-split`, so it is an arm of the explicit split rather than
// a free Bool beside a split it cannot follow.
type StrataStagePlacement
  = StrataSingleStage
  | StrataSplitStages { split: StrataLayerSplit, trim_stage_weights: Bool }

// `--mmap-experts` (docs/DETAILS.md): the experts are mapped from one file and shared by every engine
// on the host; otherwise each engine holds its own copy.
type StrataExpertResidency
  = StrataExpertsPrivate
  | StrataExpertsMapped

// `--conversation-cache-mib N` and `--conversation-cache-slots K` (docs/DETAILS.md, "Multiple
// conversations (opt-in)"): a bounded host-RAM cache in which the engine PARKS the conversations it is
// not running, so the next turn of each one reuses its prompt instead of re-reading it cold. THIS IS THE
// ENGINE'S ONLY WAY TO KEEP ANY CONVERSATION OTHER THAN THE LIVE ONE WARM: with nothing parked, every
// other conversation pays a full cold re-read on its next turn.
//
// WHY THE ARM IS REQUIRED AND NOT AN ABSENT OPTIONAL: what the ENGINE does when the pair is absent is a
// fact of the release, not of the flag. The docs at the anchor commit size the budget from the RAM that
// is free once the model is loaded from 0.2.3 (#3493) -- 40% of what is left above
// --conversation-cache-min-free-mib, at most 8192, in steps of 256, and OFF when that is under 1024 --
// while the build the fleet ran on h11 (Strata 0.1.38 HIP) is REPORTED by the operator to have parked
// nothing with the pair unset (2026-11-24; strata_conversation_cache_unset_standing below). So "the flag
// is absent" is not a policy the author chose and not even a stable fact: it is the build deciding.
// Carrying it as an absent optional field would let a launch row silently inherit that decision, which
// is the fail-open default gunbc.design_argument::declared_intent refuses; making it a required arm
// means every modeled launch names which of the three it is, and `Unset` -- legal as the transcription
// of an argv as read -- is the arm a serving launch must refuse (gunbc.serving.serving_replica_profile
// strata_launch_parking_agreement).
type StrataConversationCache
  = StrataConversationCacheBudget { budget: Mebibyte, slots: PositiveSlotCount } // a bounded cache: K conversations inside N Mebibyte of host RAM
  // The engine parks nothing. Spelled ON THE COMMAND LINE as the docs' own off word, so a launch that
  // chose it says so in its argv instead of relying on a build default; the reason names why a launch
  // would choose it (a benchmark cell measuring the cold path, for instance).
  | StrataConversationCacheOff { reason: NonEmptyStr }
  // The argv as READ carries neither flag, so this build's default decides and this row does not claim
  // to know what that default is. This is a transcription of someone else's argv, never a policy a plan
  // picks; `detail` names the argv and the read. READ IS NOT SILENCE: a launch whose argv nobody has read
  // is the arm below, not this one (gunbc.recurring_failure_mode::absent_reads_identically_to_never_looked
  // is the same confusion on the reading side, and the two arms are what keeps them apart here).
  | StrataConversationCacheUnset { detail: NonEmptyStr }
  // The argv has NEVER BEEN READ, so this row holds no claim about whether the pair is in it: the launch may
  // carry a budget, and nothing has looked. `detail` names what would settle it -- for a cell that has never
  // run, whose image is still pending, that is the argv it will be launched with. It renders no word, like
  // the arm above, and the two differ only where a judgement is asked: silence is the build deciding a policy
  // nobody stated, unread is this repository not knowing yet.
  | StrataConversationCacheUnread { detail: NonEmptyStr }

type StrataServeFlags {
  kv_format: StrataKvFormat
  kv_residency: StrataKvResidency
  // `--max-context N`
  max_context: TokenCount
  // `--parallel N` (README.md): slots answered at once; one by default.
  parallel: PositiveSlotCount
  batch_groups: StrataBatchGroups?
  // `--pool-workers N` (docs/DETAILS.md): CPU expert-pool worker threads, used as given; absent lets
  // the engine pick.
  pool_workers: Nat?
  stages: StrataStagePlacement
  experts: StrataExpertResidency
  // `--vram-reserve-mib N` (docs/DETAILS.md)
  vram_reserve: Mebibyte?
  // `--conversation-cache-mib N --conversation-cache-slots K` (docs/DETAILS.md). REQUIRED, not an
  // optional beside the others: its absence is not "no opinion", it is the build's default deciding a
  // policy -- see StrataConversationCache above.
  conversation_cache: StrataConversationCache
}

// WHAT THE DOCUMENTATION SAYS THE ENGINE DOES WHEN THE PAIR IS UNSET, with the release it says it for.
// It is a standing and not a byte figure because the answer is a policy the release chose, and it CHANGED
// between releases (0.2.3, #3493), which is the whole reason the flag cannot be left absent.
data strata_conversation_cache_unset_standing: CitedFigureStanding = CitedToAuthority {
  authority: extdeps_external_authority_anchor,
}

// The same question for a build this repository has NOT read the release notes of: the fleet's h11 engines
// run Strata 0.1.38 (HIP build), which PREDATES the auto-sizing the anchor commit's docs describe for
// 0.2.3. The operator reported on 2026-11-24 that with the pair unset those engines kept only the live
// conversation warm (both were 0% prompt-cache warm, and both went warm after the pair was added by hand
// -- the measurement is the operator's ad-hoc read, not an instrument of this repository, so it is carried
// as a transcription with its read obligation and never as a deduced default).
data strata_conversation_cache_unset_standing_pre_0_2_3: CitedFigureStanding = TranscribedUncited {
  read_obligation: "read what Strata 0.1.38 (the HIP build on h11) does with --conversation-cache-mib unset: its own docs/CHANGELOG at that tag, or the engine log line the docs promise names the budget it chose; the operator's 2026-11-24 report (0% warm with the pair unset, warm within minutes of setting it) is consistent with off and is the only evidence held today" as NonEmptyStr,
}

// WHAT TO TELL SOMETHING THAT ASKS WHAT AN UNNAMED PAIR PARKS. Both standings above are READ here, by the
// serving agreement that asks (gunbc.serving.serving_replica_profile::strata_launch_parking_agreement): a
// consumer cannot know which release the engine is, so it is given the cited answer for the release the docs
// cover and the open read for a build this repository has not read. The standings are the policy the build
// chose, carried as standings and never as a figure a verdict could compute from
// (gunbc.design_argument::epistemic_humility: what is only transcribed never enters as a number).
fn strata_conversation_cache_unset_ask() -> NonEmptyStr {
  match strata_conversation_cache_unset_standing {
    CitedToAuthority { authority: _ } =>
      match cited_figure_read_obligation(standing: strata_conversation_cache_unset_standing_pre_0_2_3) {
        Present { value: o } =>
          (("what a build whose argv names neither cache flag parks is that build's own policy, not a fact of" +
          " this repository: for the release the citation above documents the answer is cited, and for a build" +
          " this repository has not read the release notes of -- which is every build whose launched argv it" +
          " has not read either -- the open read is: " + o) as NonEmptyStr)
        Absent =>
          "what a build whose argv names neither cache flag parks is that build's own policy, not a fact of this repository; the answer above is cited only for the release its citation covers, and nothing may be assumed for any other release" as NonEmptyStr
      }
    TranscribedUncited { read_obligation: o } =>
      (("what a build whose argv names neither cache flag parks is that build's own policy, not a fact of this" +
      " repository, and this repository has not read even the release it points at: " + o) as NonEmptyStr)
    ObservedByReceipt { observed: _ } =>
      "what a build whose argv names neither cache flag parks is that build's own policy; what this repository holds about it is a receipt of its own observation, not the engine's documentation" as NonEmptyStr
  }
}

// ── THE FLAGS AS ARGV WORDS, spelled as the docs above spell them ───────────────────────────────

// `--parallel N` (README.md): slots answered at once, ONE by default. This is the flag's documented
// floor, and it agrees with the type's own floor (`PositiveSlotCount` has no zero). A consumer that has NOT
// read a launch's argv can still bound how many of its conversations can need parking: at most
// `held - strata_parallel_minimum_slots` of them. It is carried here, beside the flag it describes, because
// the number is the flag's -- a consumer that hardcoded a 1 of its own would be choosing a policy the flag
// owns (gunbc.design_argument::declared_intent).
data strata_parallel_minimum_slots: Nat = 1

fn strata_kv_format_word(f: StrataKvFormat) -> String {
  match f {
    StrataKvQ4_0 => "q4_0"
    StrataKvInt8 => "int8"
    StrataKvK8v4 => "k8v4"
  }
}

fn strata_optional_words(present: Bool, words: List<String>) -> List<String> {
  if present { words } else { [] as List<String> }
}

// THE CONVERSATION-CACHE WORDS, one per arm. A budget emits the docs' pair; an explicit off emits the
// docs' own off word (`--conversation-cache-mib 0`, docs/DETAILS.md) so a launch that chose to park
// nothing SAYS so in its argv rather than leaving it to a build default; an `Unset` transcription emits
// nothing, because emitting something would be inventing an argv nobody launched. That empty answer is
// why a SERVING launch refuses the `Unset` arm instead of rendering it (gunbc.serving.serving_replica_profile
// strata_launch_parking_agreement): argv is the last place the choice is still visible, and silence there is
// the build deciding again.
fn strata_conversation_cache_words(cache: StrataConversationCache) -> List<String> {
  match cache {
    StrataConversationCacheBudget { budget: n, slots: k } =>
      ["--conversation-cache-mib", to_string(mebibyte_count(m: n)), "--conversation-cache-slots", to_string(positive_slot_count_value(slots: k))]
    StrataConversationCacheOff { reason: _ } => ["--conversation-cache-mib", "0"]
    // Neither silence nor unread renders a word: to emit one would be to write an argv nobody launched
    // (gunbc.design_argument::fail_closed -- no plausible text for a fact never read).
    StrataConversationCacheUnset { detail: _ } => [] as List<String>
    StrataConversationCacheUnread { detail: _ } => [] as List<String>
  }
}

// Does this flag row give the engine any word about parked conversations at all? A serving consumer asks
// this before it launches, because a launch whose argv carries no cache word leaves the policy to the
// build -- the state the fleet found on h11 on 2026-11-24.
fn strata_names_a_conversation_cache(flags: StrataServeFlags) -> Bool {
  strata_conversation_cache_words(cache: flags.conversation_cache).length() > 0
}

fn strata_serve_flag_words(flags: StrataServeFlags) -> List<String> {
  let kv_resident = match flags.kv_residency {
    StrataKvResidentWindow { tokens: t } => ["--kv-resident", to_string(token_count_value(t: t))]
    StrataKvFullyResident => [] as List<String>
  }
  let batch_groups = match flags.batch_groups {
    Absent => [] as List<String>
    Present { value: StrataBatchGroupsAuto } => ["--batch-groups", "auto"]
    Present { value: StrataBatchGroupsCount { groups: g } } => ["--batch-groups", to_string(positive_slot_count_value(slots: g))]
  }
  let pool = match flags.pool_workers { Absent => [] as List<String>, Present { value: n } => ["--pool-workers", to_string(n)] }
  let stages = match flags.stages {
    StrataSingleStage => [] as List<String>
    StrataSplitStages { split: s, trim_stage_weights: trim } => concat(
      match s {
        StrataLayerSplitAuto => ["--layer-split", "auto"]
        StrataLayerSplitAt { boundaries: bs } => ["--layer-split", join(map(bs, b => to_string(b)), ",")]
      },
      strata_optional_words(present: trim, words: ["--trim-stage-weights"]),
    )
  }
  let experts = match flags.experts { StrataExpertsMapped => ["--mmap-experts"], StrataExpertsPrivate => [] as List<String> }
  let reserve = match flags.vram_reserve { Absent => [] as List<String>, Present { value: m } => ["--vram-reserve-mib", to_string(mebibyte_count(m: m))] }
  // THE CACHE WORDS (strata_conversation_cache_words), appended last. An `Unset` transcription renders
  // nothing here -- which is exactly why a SERVING launch refuses that arm instead of rendering it
  // (gunbc.serving.serving_replica_profile strata_launch_parking_agreement): argv is the last place the
  // choice is still visible, and an empty answer is the build deciding again.
  concat(concat(concat(concat(concat(concat(concat(concat(
    ["--kv", strata_kv_format_word(f: flags.kv_format)],
    kv_resident),
    ["--max-context", to_string(token_count_value(t: flags.max_context)), "--parallel", to_string(positive_slot_count_value(slots: flags.parallel))]),
    batch_groups),
    pool),
    stages),
    experts),
    reserve),
    strata_conversation_cache_words(cache: flags.conversation_cache))
}
