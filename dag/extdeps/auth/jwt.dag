module extdeps.auth.jwt
// THIS MODULE DESCRIBES CLAIMS; IT DOES NOT VERIFY THEM. Decoding a JWT payload is base64url and JSON, requiring no key and proving nothing — a token whose claims decode cleanly may be entirely forged. Verification means fetching the issuer's JWKS and checking the signature over the header and payload, which is a network operation with its own failure modes and cache semantics.
//
// The boundary is stated because the two are trivially confusable once claims are sitting in a typed record that looks authoritative. Reading unverified claims is legitimate for display and for deciding which account a credential names; it is NOT legitimate for authorization. Nothing here should be read as making the second safe, and a verification surface lands as its own module with the JWKS fetch it requires.


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc7519"
  }
}


// NumericDate is RFC 7519 section 2: a JSON numeric value counting seconds from the UNIX epoch,
// explicitly not milliseconds, and explicitly ignoring leap seconds. The unit matters enough to be
// typed rather than left as a bare Int — a millisecond value read as seconds lands in the year 58000
// and passes every not-yet-expired check forever, which is a plausible wrong answer rather than an
// error.
//
// IT IS NOT AN INTEGER, and the first cut said it was. Section 2 defines the value as POSIX Seconds
// Since the Epoch 'other than that non-integer values can be represented' — the clause exists
// precisely to admit a fractional component. An Int carrier silently rounds a conforming exp, and
// rounding an expiry DOWN shortens a credential's life while rounding it UP extends it past the
// instant the issuer named; neither is a refusal, both are wrong answers.
//
// So the carrier is a coproduct and the fractional case is a distinct arm rather than a lossy cast.
// Whole seconds stay exact Ints, which is what every arithmetic consumer here actually wants and what
// every token observed on this fleet carries. A fractional value keeps its digits verbatim, because
// converting them would need a decimal parse this module deliberately does not do — the same
// describe-do-not-parse boundary it keeps everywhere else, reading what a token says without ever
// resolving or verifying it. The consequence is that arithmetic must MATCH, so a fractional date
// cannot be quietly truncated into a whole-second subtraction; it refuses instead.
type NumericDate
  = NumericDateWholeSeconds { seconds: Int }
  | NumericDateFractionalSeconds {
      whole_seconds: Int,
      fractional_digits: std.types.NonEmptyStr,
    }

// The lifetime of two dates is only a whole number of seconds when BOTH are whole seconds, so the
// fractional arms refuse rather than truncating. A caller that genuinely needs sub-second resolution
// needs the decimal parse this module does not provide, and giving it a rounded value instead would
// answer a question it did not ask. The refusal names which side was fractional, so the diagnostic
// locates the token rather than reporting that arithmetic was unavailable.
//
// THE ANSWER IS A std.measure.Second, NOT A BARE Int. A seconds-valued duration returned as Int is
// the unit-modeling fork DESIGN forbids: the unit lives in the parameter's NAME, where nothing can
// check it, and the next consumer is free to read it as milliseconds. The wire-level NumericDate
// above stays a raw JSON-shaped value because that is genuinely what RFC 7519 puts on the wire — the
// extdeps boundary describes the artifact — but a DERIVED duration is an ordinary magnitude and
// belongs on the canonical carrier like every other one in the tree.
//
// Second counts a Nat, which forces the third arm. A token whose expiry precedes its issuance has no
// non-negative lifetime, and the honest answer is a refusal rather than a wrapped negative or a clamp
// to zero — clamping would report a just-expired credential and a malformed one identically.
type NumericDateLifetime
  = LifetimeWholeSeconds { seconds: std.measure.Second }
  | LifetimeNotWholeSeconds { reason: String }
  | LifetimeExpiryPrecedesIssuance { issued_at: Int, expires_at: Int }

fn numeric_date_lifetime(
  issued: NumericDate,
  expires: NumericDate,
) -> NumericDateLifetime {
  match issued {
    NumericDateFractionalSeconds { whole_seconds: _, fractional_digits: _ } =>
      LifetimeNotWholeSeconds {
        reason: "issued-at carries a fractional-seconds component; a whole-second lifetime would round it",
      }
    NumericDateWholeSeconds { seconds: from } =>
      match expires {
        NumericDateFractionalSeconds { whole_seconds: _, fractional_digits: _ } =>
          LifetimeNotWholeSeconds {
            reason: "expiry carries a fractional-seconds component; a whole-second lifetime would round it",
          }
        NumericDateWholeSeconds { seconds: until } =>
          if until < from {
            LifetimeExpiryPrecedesIssuance { issued_at: from, expires_at: until }
          } else {
            LifetimeWholeSeconds { seconds: second(count: until - from) }
          }
      }
  }
}

// RFC 7515 section 3.1: three base64url segments joined by dots — header, payload, signature. Branded
// so that a value carrying an opaque bearer token cannot be passed where a decodable one is expected.
// That distinction is load-bearing in practice rather than pedantic: an OAuth refresh token is
// frequently NOT a JWT, so code that decodes every token it is handed to read an expiry works on the
// access token and fails on the refresh token, and the failure looks like a corrupt credential rather
// than a category error.
type JwtCompactSerialization = std.types.NonEmptyStr where brand("JwtCompactSerialization")

// RFC 7519 section 2 defines StringOrURI as any JSON string, with the added requirement that a value
// containing a colon MUST be a URI. THE FIRST CUT BRANDED THAT RULE WITHOUT ENFORCING IT: a brand over
// NonEmptyStr accepts urn:openai:amr:passkey and the malformed 9:30 identically, so the type asserted
// a constraint every cast was free to violate. A brand that states a rule it cannot check is the
// validation-standing-where-construction-was-available shape — it concedes the bad value is writable
// and then does not even flag it.
//
// The rule is DECIDABLE, so it becomes shape. A value with no colon is a bare string and always
// admissible; a value with a colon is admissible only when the text before the first colon is a valid
// RFC 3986 scheme — ALPHA followed by any of ALPHA, DIGIT, plus, minus or dot. Everything else is
// refused with the raw value named. The two admissible cases are different arms, so a consumer that
// needs to know which it has reads the constructor instead of re-running string_contains.
//
// WHY NOT extdeps.uri.Uri: that model's scheme is a closed enum of http, https, file, ftp, javascript,
// data, vbscript and mailto. StringOrURI admits ANY registered or private scheme, and the values this
// fleet actually observes are urn: — so reusing that type would refuse a conforming token. The scheme
// is kept as decoded text rather than forced into an enum that does not span the space.
type JwtStringOrUri
  = JwtBareString { value: std.types.NonEmptyStr }
  | JwtUriString { value: std.types.NonEmptyStr, scheme: std.types.NonEmptyStr }

type JwtStringOrUriDecode
  = StringOrUriDecoded { value: JwtStringOrUri }
  | StringOrUriRefused { raw: std.types.NonEmptyStr, reason: String }

type JwtColonPosition
  = NoColonPresent
  | ColonAt { index: Int }

data jwt_colon_code_point: Int = 58

fn jwt_scheme_first_char_allowed(cp: Int) -> Bool {
  (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122)
}

fn jwt_scheme_char_allowed(cp: Int) -> Bool {
  jwt_scheme_first_char_allowed(cp: cp)
    || (cp >= 48 && cp <= 57)
    || cp == 43
    || cp == 45
    || cp == 46
}

fn jwt_first_colon_from(s: String, i: Int, len: Int) -> JwtColonPosition {
  if i >= len {
    NoColonPresent
  } else if code_point(ch: char_at(s, i)) == jwt_colon_code_point {
    ColonAt { index: i }
  } else {
    jwt_first_colon_from(s: s, i: i + 1, len: len)
  }
}

fn jwt_first_colon(s: String) -> JwtColonPosition {
  jwt_first_colon_from(s: s, i: 0, len: string_length(s: s))
}

fn jwt_scheme_tail_valid(s: String, i: Int, end: Int) -> Bool {
  if i >= end {
    true
  } else if !jwt_scheme_char_allowed(cp: code_point(ch: char_at(s, i))) {
    false
  } else {
    jwt_scheme_tail_valid(s: s, i: i + 1, end: end)
  }
}

fn jwt_scheme_valid(s: String, end: Int) -> Bool {
  if end <= 0 {
    false
  } else if !jwt_scheme_first_char_allowed(cp: code_point(ch: char_at(s, 0))) {
    false
  } else {
    jwt_scheme_tail_valid(s: s, i: 1, end: end)
  }
}

// This decoder is not an exception to the module's describe-not-verify boundary. It checks SYNTAX, which is decidable from the value alone; it does not check that the URI resolves, that the issuer is trusted, or that anyone signed anything.
fn jwt_string_or_uri_of_wire(raw: std.types.NonEmptyStr) -> JwtStringOrUriDecode {
  let s = raw as String
  match jwt_first_colon(s: s) {
    NoColonPresent =>
      StringOrUriDecoded { value: JwtBareString { value: raw } }
    ColonAt { index } =>
      if jwt_scheme_valid(s: s, end: index) {
        StringOrUriDecoded {
          value: JwtUriString {
            value: raw,
            scheme: substring(s: s, start: 0, end: index) as std.types.NonEmptyStr,
          },
        }
      } else {
        StringOrUriRefused {
          raw: raw,
          reason: "RFC 7519 section 2: a StringOrURI containing a colon must be a URI, and the text before the first colon is not a valid RFC 3986 scheme",
        }
      }
  }
}

fn jwt_string_or_uri_wire(value: JwtStringOrUri) -> std.types.NonEmptyStr {
  match value {
    JwtBareString { value: raw } => raw
    JwtUriString { value: raw, scheme: _ } => raw
  }
}

// aud IS A WIRE UNION AND THE FIRST CUT NORMALIZED IT AWAY. Section 4.1.3 states both forms: in the
// general case aud is an ARRAY of StringOrURI, and in the special case of a single audience it MAY be
// a single StringOrURI string. Modeling it as List only was not a simplification, it was a claim the
// spec does not make — that the array form is canonical and the string form is a degenerate encoding
// of it.
//
// The difference is observable at the boundary this module exists to describe. A verifier that
// re-serializes a token it decoded must emit the form it received or the signature no longer covers
// the bytes, and a receiver comparing raw JSON sees a string where an array was written. Collapsing
// the two at ingest makes that round trip impossible to express, which is the same information loss
// the DecodeFidelity boundary is drawn to prevent.
//
// jwt_audience_values exists for the consumers that genuinely only need membership — most audience
// checks are 'is my identifier among these' and do not care about the encoding. That projection is a
// DERIVED read over a faithful carrier, which is the right order; deriving it was never the problem,
// storing only the derived form was.
type JwtAudience
  = JwtAudienceSingle { value: JwtStringOrUri }
  | JwtAudienceMultiple { values: std.types.List<JwtStringOrUri> }

fn jwt_audience_values(audience: JwtAudience) -> List<JwtStringOrUri> {
  match audience {
    JwtAudienceSingle { value } => [value]
    JwtAudienceMultiple { values } => values
  }
}

// RFC 7519 REGISTERED CLAIMS BELONG TO THE IETF, NOT TO WHOEVER ISSUED THE TOKEN. Every provider that emits a JWT emits iss, sub, aud, exp and iat with the same meanings, so modeling them inside a vendor's module would coin the seventh copy of a concept the RFC already owns.
//
// EVERY ONE OF THEM IS OPTIONAL, and the first cut of this record got that exactly backwards. Section 4.1 says it in the registry's own preamble — none of the registered claims are intended to be mandatory to use or implement — and then repeats 'Use of this claim is OPTIONAL' under each individual claim. The earlier record made all six required, which encoded ONE OBSERVED TOKEN as the definition of the standard: the codex id_token happens to carry all of them, so a shape derived from it refuses every conforming JWT that omits a claim the RFC never demanded. A signed token with no jti is not malformed, and a model that cannot represent one is not describing RFC 7519.
//
// WHERE REQUIREMENT ACTUALLY LIVES IS THE PROFILE. OIDC Core section 2 requires iss, sub, aud, exp and iat in an ID Token — that is a real obligation, and it belongs to OIDC rather than to the JWT layer. Pushing it down here would make the base type unable to describe the many conforming JWTs that are not ID Tokens. So this record stays fully optional and extdeps.auth.oidc declares its own required core, which is the single-authority reading: the RFC owns the vocabulary, the profile owns the obligation.
type JwtRegisteredClaims {
  issuer: JwtStringOrUri?
  subject: JwtStringOrUri?
  audience: JwtAudience?
  expires_at: NumericDate?
  not_before: NumericDate?
  issued_at: NumericDate?
  jwt_id: std.types.NonEmptyStr?
}

