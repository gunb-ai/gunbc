module extdeps.auth.jwks
// THE KEY SET, AND THE SEAM WHERE VERIFICATION WOULD HAPPEN — which this module models and
// deliberately cannot perform. extdeps.auth.jwt states the boundary for claims: decoding a payload
// is base64url and JSON, requires no key, and proves nothing. This module is the other half of that
// sentence — the public keys an issuer publishes so a signature CAN be checked — and it stops
// exactly where the arithmetic begins.
//
// WHY IT STOPS THERE. RSASSA-PKCS1-v1_5 verification is s^e mod n over a 2048-bit modulus followed
// by a padding and digest comparison. This corpus has no bignum and no modular exponentiation, so
// the check cannot be computed here. That is a capability gap, not a modeling gap, and the two have
// different remedies: a modeling gap is closed by writing more .dag, while this one is closed by
// binding a realization handler to a host primitive (§2 — pure spec, N handlers) or by grounding
// bignum arithmetic in the substrate.
//
// WHAT THAT MEANS FOR THIS FILE'S SHAPE. There is no fn returning Bool for "is this signature
// valid", because such a function could only answer by fabricating. The verdict carrier exists, it
// has no arm that can be reached without a handler, and jws_verification_unavailable is what every
// caller gets today — typed, located, and counted, never a silent pass. A consumer that needs an
// authenticated claim gets a refusal it can report; it does not get an unverified claim wearing a
// verified type.

import std.types { String, NonEmptyStr, Int, Bool, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.languages.json.parse {
  JsonMemberLookup, JsonMemberFound, JsonMemberAbsent,
  JsonMemberDuplicated, JsonMemberNotAnObject,
  json_object_unique_member,
}
import extdeps.languages.json.emit { JsonValue, JsonString, JsonArray }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc7517"
  }
}

data jwks_subject_note: String = "THE SUBJECT IS RFC 7517 (JSON Web Key) plus the two sections of RFC 7518 that give an RSA verification key its parameters (section 6.3.1, `n` and `e`) and name the RS256 algorithm (section 3.3, RSASSA-PKCS1-v1_5 with SHA-256). RFC 7515 owns the JWS compact serialization those keys verify.\\n\\nThey are cited as three documents rather than merged into one local vocabulary because they are independently versioned and independently extended: a new key type is an RFC 7518 registry entry, a new serialization is RFC 7515's business, and a JWK's own membership rules are RFC 7517's. Collapsing them would put this repository's convenience where three standards bodies' authority stands."

// RFC 7517 section 4.1: `kty` is REQUIRED and its values come from the JSON Web Key Types registry.
// The registry is open — RFC 7518 section 6.1 defines EC, RSA and oct, and later documents add more
// (OKP arrived in RFC 8037) — so an unrecognized value is a named arm rather than a decode failure.
// A closed enum here would refuse a key set the day an issuer publishes a type this build predates,
// and refusing the whole SET because one key in it is unfamiliar is the wrong granularity: the key
// we need may be sitting beside it.
type JwkKeyType
  = JwkRsa
  | JwkEllipticCurve
  | JwkOctetSequence
  | JwkUnsupportedKeyType { name: NonEmptyStr }

fn jwk_key_type_of_wire(raw: String) -> JwkKeyType {
  if raw == "RSA" {
    JwkRsa
  } else if raw == "EC" {
    JwkEllipticCurve
  } else if raw == "oct" {
    JwkOctetSequence
  } else {
    JwkUnsupportedKeyType { name: raw as NonEmptyStr }
  }
}

data jwk_rsa_public_key_note: String = "RFC 7518 section 6.3.1 gives an RSA public key exactly two required members, `n` (modulus) and `e` (exponent), each a base64url-encoded big-endian unsigned integer with no leading zero octets.\\n\\nTHEY STAY BASE64URL STRINGS HERE, and that is a statement about this module's reach rather than laziness. Decoding them to integers would require the bignum arithmetic named in the header — the same arithmetic the verification itself needs — so a carrier holding `Int` would be claiming a capability the module does not have. Holding the encoded form says precisely what was read off the wire and hands an unambiguous input to whichever realization eventually does the exponentiation.\\n\\nSection 6.3.1 also forbids leading zero octets, which is a wire-validity rule this module does not enforce, because enforcing it means decoding. A handler that decodes is the right place for that refusal."
type JwkRsaPublicKey {
  modulus_b64u: NonEmptyStr
  exponent_b64u: NonEmptyStr
}

type JwkMaterial
  = JwkRsaMaterial { key: JwkRsaPublicKey }
  | JwkMaterialUnmodeled { key_type: JwkKeyType }

// RFC 7517 section 4.5: `kid` is OPTIONAL. It is the member a JWS header points at to say which key
// signed it, so a key set whose keys carry no kid can still be correct and simply cannot be indexed
// that way — hence an arm rather than a required field. A caller that needs kid selection against a
// set without kids gets a refusal that names the reason instead of an empty result.
type JwkKeyId
  = JwkKeyIdPresent { kid: NonEmptyStr }
  | JwkKeyIdAbsent

type Jwk {
  key_id: JwkKeyId
  key_type: JwkKeyType
  material: JwkMaterial
}

type JwkSet {
  keys: List<Jwk>
}

data jwk_member_key_names: String = "RFC 7517 member names, quoted verbatim so a reader can check them against section 4 and RFC 7518 section 6.3.1 rather than against this repository's spelling."
data jwk_set_keys_key: NonEmptyStr = "keys" as NonEmptyStr
data jwk_key_type_key: NonEmptyStr = "kty" as NonEmptyStr
data jwk_key_id_key: NonEmptyStr = "kid" as NonEmptyStr
data jwk_rsa_modulus_key: NonEmptyStr = "n" as NonEmptyStr
data jwk_rsa_exponent_key: NonEmptyStr = "e" as NonEmptyStr

// RFC 7518 section 3.3. The token header's `alg` names this; a verifier must not take the header's
// word for which algorithm to use without checking it against what the key permits — the classic
// JWS confusion attack substitutes `none` or an HMAC alg and gets a forged token accepted. This
// module carries the name so a handler can enforce that match; it cannot enforce it itself.
data jws_algorithm_rs256: NonEmptyStr = "RS256" as NonEmptyStr

type JwkDecode
  = JwkDecoded { jwk: Jwk }
  | JwkDecodeRefused { reason: NonEmptyStr }

fn jwk_string_member(v: JsonValue, key: NonEmptyStr) -> JwkStringRead {
  match json_object_unique_member(v: v, key: key as String) {
    JsonMemberFound { value: found } =>
      match found {
        JsonString { value: s } =>
          if s.length() == 0 {
            JwkStringRefused { reason: "member present but empty" as NonEmptyStr }
          } else {
            JwkStringRead_ { value: s as NonEmptyStr }
          }
        _ => JwkStringRefused { reason: "member present but not a JSON string" as NonEmptyStr }
      }
    JsonMemberAbsent => JwkStringAbsent
    JsonMemberDuplicated { count: _ } =>
      JwkStringRefused { reason: "member appears more than once; the intended value is undecidable" as NonEmptyStr }
    JsonMemberNotAnObject =>
      JwkStringRefused { reason: "JWK is not a JSON object" as NonEmptyStr }
  }
}

type JwkStringRead
  = JwkStringRead_ { value: NonEmptyStr }
  | JwkStringAbsent
  | JwkStringRefused { reason: NonEmptyStr }

fn jwk_decode(v: JsonValue) -> JwkDecode {
  match jwk_string_member(v: v, key: jwk_key_type_key) {
    JwkStringRefused { reason: r } => JwkDecodeRefused { reason: r }
    JwkStringAbsent =>
      JwkDecodeRefused { reason: "kty is REQUIRED (RFC 7517 section 4.1) and was absent" as NonEmptyStr }
    JwkStringRead_ { value: kty } => {
      let key_type = jwk_key_type_of_wire(raw: kty as String)
      let key_id = match jwk_string_member(v: v, key: jwk_key_id_key) {
        JwkStringRead_ { value: k } => JwkKeyIdPresent { kid: k }
        _ => JwkKeyIdAbsent
      }
      match key_type {
        JwkRsa =>
          match jwk_string_member(v: v, key: jwk_rsa_modulus_key) {
            JwkStringRead_ { value: n } =>
              match jwk_string_member(v: v, key: jwk_rsa_exponent_key) {
                JwkStringRead_ { value: e } =>
                  JwkDecoded {
                    jwk: Jwk {
                      key_id: key_id,
                      key_type: key_type,
                      material: JwkRsaMaterial {
                        key: JwkRsaPublicKey { modulus_b64u: n, exponent_b64u: e },
                      },
                    },
                  }
                _ =>
                  JwkDecodeRefused {
                    reason: "RSA JWK missing required exponent e (RFC 7518 section 6.3.1)" as NonEmptyStr,
                  }
              }
            _ =>
              JwkDecodeRefused {
                reason: "RSA JWK missing required modulus n (RFC 7518 section 6.3.1)" as NonEmptyStr,
              }
          }
        _ =>
          JwkDecoded {
            jwk: Jwk {
              key_id: key_id,
              key_type: key_type,
              material: JwkMaterialUnmodeled { key_type: key_type },
            },
          }
      }
    }
  }
}

data jwk_selection_note: String = "0/1/MANY, BECAUSE A KEY IS AN AUTHORIZATION INPUT. RFC 7517 section 4.5 does not require kid values to be unique within a set, so two keys can carry the same kid — and picking the first would silently decide which key authenticates a credential, on list order. That is the failure this repository already refuses elsewhere for identities; a signing key is a strictly worse place to make it, because the wrong key does not error, it simply fails to verify a token that should have verified, or verifies one that should not have.\\n\\nAmbiguity is therefore its own arm and names the count. Absent is distinct from ambiguous because their remedies differ: absent means refresh the key set (the issuer may have rotated), ambiguous means the key set itself is malformed and refreshing will not help."
type JwkSelection
  = JwkSelected { jwk: Jwk }
  | JwkSelectionAbsent { kid: NonEmptyStr }
  | JwkSelectionAmbiguous { kid: NonEmptyStr, count: Int }

fn jwk_has_kid(jwk: Jwk, kid: NonEmptyStr) -> Bool {
  match jwk.key_id {
    JwkKeyIdPresent { kid: k } => k == kid
    JwkKeyIdAbsent => false
  }
}

fn jwk_select_by_kid(set: JwkSet, kid: NonEmptyStr) -> JwkSelection {
  let matched = filter(set.keys, k => jwk_has_kid(jwk: k, kid: kid))
  let n = count(matched)
  if n == 0 {
    JwkSelectionAbsent { kid: kid }
  } else if n > 1 {
    JwkSelectionAmbiguous { kid: kid, count: n }
  } else {
    match matched.first() {
      Present { value: k } => JwkSelected { jwk: k }
      Absent => JwkSelectionAbsent { kid: kid }
    }
  }
}

data jws_verification_seam_note: String = "THE SEAM, AND WHY IT HAS NO SUCCESS ARM A CALLER CAN REACH TODAY.\\n\\nVerification needs s^e mod n over a 2048-bit modulus, then a PKCS#1 v1.5 padding check and a SHA-256 digest comparison. No bignum, no modular exponentiation and no RSA primitive exists in this corpus, so the computation cannot happen in .dag as it stands. The honest options are a realization handler bound to a host primitive (§2 — one pure spec, N handlers, exactly as transports work elsewhere) or grounding bignum arithmetic in the substrate; both are real work and neither is done.\\n\\nSO THIS CARRIER REFUSES. JwsVerificationUnavailable is what every caller gets, it names the missing capability, and it is counted rather than absorbed. There is no fn here returning Bool for signature validity, because that function could only lie — and a `verified: Bool` that is always true because nothing checked it is precisely the fabricated-plausible-output failure aimed at a security decision.\\n\\nWHAT A HANDLER MUST DO WHEN ONE LANDS, recorded now so the requirement is not rediscovered later: it must check the JWS header `alg` against what the selected key permits rather than trusting the header, because substituting `none` or an HMAC algorithm against an RSA public key is the standard JWS confusion attack; it must reject an unsupported key type instead of skipping the check; and its failure arm must be a refusal, never a pass.\\n\\nDISSOLVE-ON: a bound verification handler with an executed positive control (a token that verifies against a known key) AND a discriminating negative control (the same token with one payload byte changed, refused). Until both execute, no consumer may treat a claim from this path as authenticated."

type JwsVerificationVerdict
  = JwsVerificationUnavailable { reason: NonEmptyStr, algorithm: NonEmptyStr }
  | JwsVerificationRefused { reason: NonEmptyStr }

data jws_verification_capability_absent_reason: NonEmptyStr = "no signature-verification handler is bound: this corpus carries no bignum, modular exponentiation or RSA primitive, so RSASSA-PKCS1-v1_5 cannot be computed" as NonEmptyStr

fn jws_verification_unavailable() -> JwsVerificationVerdict {
  JwsVerificationUnavailable {
    reason: jws_verification_capability_absent_reason,
    algorithm: jws_algorithm_rs256,
  }
}

fn jws_verification_is_authenticated(verdict: JwsVerificationVerdict) -> Bool {
  match verdict {
    JwsVerificationUnavailable { reason: _, algorithm: _ } => false
    JwsVerificationRefused { reason: _ } => false
  }
}
