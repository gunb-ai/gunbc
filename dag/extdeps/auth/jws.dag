    declaration: DeclarationRef {
      module_path: "extdeps.auth.jws",
      decl_name: "jws_rs256_signing_input",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.auth.jws.extdeps_external_authority_anchor,
  further_citations: [extdeps.auth.jws.jwa_rs256_citation]
