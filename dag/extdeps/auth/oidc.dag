module extdeps.auth.oidc


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "openid.net/specs/openid-connect-core-1_0.html"
  }
}

data oidc_amr_external_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc8176"
  }
}

data oidc_standard_claims_note: String = "OpenID Connect Core 1.0 section 5.1 STANDARD CLAIMS, which are the OIDF's and not any provider's. email, email_verified and name mean the same thing in every id_token that carries them, so a vendor module redefining them would fork a concept with a specification.\\n\\nALL THREE ARE OPTIONAL AND THE FIRST CUT REQUIRED THEM. Section 5.1 defines standard claims that MAY be returned, and section 5.4 makes their presence contingent on the requested scope — email and email_verified arrive with the email scope, name with profile. An ID Token issued for the openid scope alone carries none of them and is perfectly conforming. Requiring them encoded one observed token's scope grant as though it were the specification.\\n\\nemail_verified is still the one worth naming explicitly: section 5.1 says it is a BOOLEAN, and that when true the provider asserts it took affirmative steps to verify the address at some point — a claim about the provider's past diligence, not a guarantee the address is currently reachable or still controlled by the subject. Treating it as proof of present control is the standard misreading, and the spec says so in the claim's own definition. Its absence is a third state and now representable: 'the provider did not say' is not 'the provider said false'."

type OidcStandardClaims {
  email: std.types.Email?
  email_verified: Bool?
  name: String?
}

// amr IS A LIST OF AUTHENTICATION METHODS AND IT MIXES REGISTERED SHORT NAMES WITH URI VALUES IN ONE ARRAY. RFC 8176 establishes an IANA registry of short names — pwd, mfa, otp, pop, hwk, sms and others — and OIDC Core section 2 types the entries as StringOrURI, so a value may legitimately be either.\n\nWHAT RFC 8176 DOES NOT SAY IS THAT A URI MEANS PRIVATE, and the first cut's AmrPrivateUri arm asserted exactly that. The registry governs short names; it does not reserve the URI space, forbid a URI from ever being registered, or define 'private' as the complement of its own contents. What is actually decidable from the value alone is its SHAPE — registered short name this model enumerates, unregistered short name, or URI-valued — and provenance is not recoverable from shape. So the arm is named for what it is. That the observed urn:openai: values happen to be OpenAI's is a fact about that provider, recorded in the codex module that observed them, not a rule this one may state.\n\nThe classification now routes through the RFC 7519 StringOrURI decoder rather than a local colon test, which is the same rule read once instead of twice — and it means a colon-bearing value that is NOT a valid URI is REFUSED here rather than silently filed as a vendor method. The registered arm is deliberately not exhaustive over the IANA registry: it names the values actually encountered, and an unrecognized short name lands in AmrUnregisteredName rather than being forced into a URI arm it does not belong in.
type OidcAuthMethodReference
  = AmrProofOfPossession
  | AmrMultiFactor
  | AmrPassword
  | AmrOneTimePassword
  | AmrUnregisteredName { name: std.types.NonEmptyStr }
  | AmrUriValuedMethod { value: extdeps.auth.jwt.JwtStringOrUri }

type OidcAmrDecode
  = AmrDecoded { method: OidcAuthMethodReference }
  | AmrRefused { raw: std.types.NonEmptyStr, reason: String }

data amr_pop_wire: String = "pop"
data amr_mfa_wire: String = "mfa"
data amr_pwd_wire: String = "pwd"
data amr_otp_wire: String = "otp"

fn oidc_amr_of_wire(raw: std.types.NonEmptyStr) -> OidcAmrDecode {
  let s = raw as String
  if s == amr_pop_wire {
    AmrDecoded { method: AmrProofOfPossession }
  } else if s == amr_mfa_wire {
    AmrDecoded { method: AmrMultiFactor }
  } else if s == amr_pwd_wire {
    AmrDecoded { method: AmrPassword }
  } else if s == amr_otp_wire {
    AmrDecoded { method: AmrOneTimePassword }
  } else {
    match jwt_string_or_uri_of_wire(raw: raw) {
      StringOrUriRefused { raw: bad, reason } =>
        AmrRefused { raw: bad, reason: reason }
      StringOrUriDecoded { value } =>
        match value {
          JwtBareString { value: name } =>
            AmrDecoded { method: AmrUnregisteredName { name: name } }
          JwtUriString { value: _, scheme: _ } =>
            AmrDecoded { method: AmrUriValuedMethod { value: value } }
        }
    }
  }
}

data oidc_id_token_claims_note: String = "THE ID TOKEN IS WHERE REQUIREMENT LIVES, which is why this record has a required core while extdeps.auth.jwt's registered claims are all optional. Section 2 lists iss, sub, aud, exp and iat as REQUIRED in an ID Token — a real obligation the JWT layer does not impose on JWTs generally — so those five are non-optional fields here and nowhere else. That split is the single-authority reading: the RFC owns the claim vocabulary, the profile owns the obligation, and neither restates the other.\\n\\nEVERYTHING ELSE ON THIS RECORD IS OPTIONAL, and the first cut required six claims that no specification universally demands. auth_time is REQUIRED only when the request carried max_age or asked for auth_time as an Essential Claim, and section 2 says so in the claim's own definition; acr and amr are explicitly OPTIONAL there; nonce is required only if it was sent in the request; azp is OPTIONAL and applies to a specific multi-audience case. sid is not in section 2 at all — it comes from Session Management and the logout specs, and is OPTIONAL there. An ID Token carrying none of them is conforming, and the earlier shape could not represent one.\\n\\nauth_time and iat remain DIFFERENT INSTANTS and the distinction still matters for any freshness decision. iat is when this token was issued — which a silent refresh updates — while auth_time is when the human last actually authenticated, which a refresh does not. A max-age policy written against iat would be satisfied forever by automatic refreshes without the user ever proving presence again. The claim being optional makes that worse rather than better: a policy needing auth_time must handle its ABSENCE, and absence is now a state it must match instead of a value it may assume."

type OidcIdTokenClaims {
  issuer: extdeps.auth.jwt.JwtStringOrUri
  subject: extdeps.auth.jwt.JwtStringOrUri
  audience: extdeps.auth.jwt.JwtAudience
  expires_at: extdeps.auth.jwt.NumericDate
  issued_at: extdeps.auth.jwt.NumericDate
  auth_time: extdeps.auth.jwt.NumericDate?
  nonce: std.types.NonEmptyStr?
  acr: std.types.NonEmptyStr?
  amr: List<OidcAuthMethodReference>?
  azp: extdeps.auth.jwt.JwtStringOrUri?
  session_id: std.types.NonEmptyStr?
  standard: OidcStandardClaims
}

// The ID Token's required core PROJECTED back onto the RFC 7519 shape, for consumers that handle JWTs generically and do not know this token is an ID Token. It is a derived read over the profile's stricter carrier — the direction that loses nothing — and never the storage form. Going the other way is what the earlier model did by embedding an all-required JwtRegisteredClaims, and that is what made the base type unable to describe a conforming JWT.
fn oidc_id_token_registered_claims(claims: OidcIdTokenClaims) -> extdeps.auth.jwt.JwtRegisteredClaims {
  extdeps.auth.jwt.JwtRegisteredClaims {
    issuer: Present { value: claims.issuer },
    subject: Present { value: claims.subject },
    audience: Present { value: claims.audience },
    expires_at: Present { value: claims.expires_at },
    not_before: none,
    issued_at: Present { value: claims.issued_at },
    jwt_id: none,
  }
}
