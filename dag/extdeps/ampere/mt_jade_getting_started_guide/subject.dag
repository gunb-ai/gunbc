}

data mt_jade_gsg_publication_status: DocumentPublicationStatus = PubliclyPublishedWithRestrictiveMarking {
  marking: "Ampere Computing Proprietary, Document Issue 1.00",
}

data mt_jade_gsg_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ampere.mt_jade_getting_started_guide.subject",
