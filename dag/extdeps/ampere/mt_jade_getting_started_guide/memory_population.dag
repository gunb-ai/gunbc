  MtJadeGsgChannelConnectorPair { processor_socket: 0, memory_controller: 2, table_left_connector: 5, table_right_connector: 6 },
  MtJadeGsgChannelConnectorPair { processor_socket: 0, memory_controller: 3, table_left_connector: 7, table_right_connector: 8 },
  MtJadeGsgChannelConnectorPair { processor_socket: 0, memory_controller: 7, table_left_connector: 16, table_right_connector: 15 },
