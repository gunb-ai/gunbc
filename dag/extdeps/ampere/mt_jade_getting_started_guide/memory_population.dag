// Table 11, page 11, Document Issue 1.00. Printed slot labels are hash-numbers (#1..#32), not a
// J-prefix. Each MCU has two columns. Socket 0 columns left-to-right: #1 #2 #3 #4 #5 #6 #7 #8
// then #16 #15 #14 #13 #12 #11 #10 #9 under MCU0 MCU1 MCU2 MCU3 MCU7 MCU6 MCU5 MCU4.
// Socket 1: #17..#24 then #32..#25 under the same MCU order.

type MtJadeGsgChannelConnectorPair {
  processor_socket: Nat
  memory_controller: Nat
  table_left_connector: Nat
  table_right_connector: Nat
}

