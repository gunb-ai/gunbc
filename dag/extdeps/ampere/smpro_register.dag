// THE SUBJECT IS THE AMPERE SMpro's I2C REGISTER INTERFACE as Ampere's own Linux drivers use it:
// smpro-core (the regmap over I2C) and smpro-misc (the boot-progress registers), with the ABI
// document that states what the boot-progress fields mean. Every name, offset and code below is
// transcribed from those three files at the pinned commits, under the drivers' own names.
//
// THE PROTOCOL (smpro-core: smpro_regmap_config, smpro_core_read, smpro_regmap_bus). Register
// addresses are 8 bits and values 16 bits. A read is a two-message transfer: WRITE the register
// address and the value size in bytes, [reg, 0x02], then READ two bytes. The bus is declared
// REGMAP_ENDIAN_BIG, so the FIRST byte on the wire is the value's HIGH byte.
//
// WHAT A READ IS KNOWN TO DO (DESIGN §4d, three standings kept apart by type). Ampere's
// documentation of these registers (the Altra Family SoC BMC Interface Specification, which the ABI
// file cites for its sections 5.11 and 6) has not been obtained. So the read-safety of every
// register here is a CITED INFERENCE from how the upstream driver uses it, not a vendor statement,
// and it is typed that way so an Ampere source can confirm or correct each row without rewriting
// any receipt.

data smpro_value_size_bytes: Int = 2

// smpro-core probe: regmap_read(MANUFACTURER_ID_REG) must equal AMPERE_MANUFACTURER_ID or the device
// is refused with -ENODEV. That makes it a known-answer read: a transport that returns this word
// from this register has reached an SMpro.
data smpro_manufacturer_id_expected: Int = 52538

// HOW THE UPSTREAM DRIVER USES A REGISTER, which is all the read-safety claim below rests on.
// ReadOnlyInDriver: the driver only ever reads it. WrittenBackByDriver: the driver reads it AND
// writes it, and the write is what has an effect; the raw read is inferred to be a plain read
// because the driver's read path is an ordinary regmap_read.
type SmproDriverUse
  = ReadOnlyInDriver { function: NonEmptyStr }
  | WrittenBackByDriver { function: NonEmptyStr, write: NonEmptyStr }

type SmproReadSafety
  = ReadSafetyCitedInference { driver_use: SmproDriverUse, basis: ExternalAuthority, would_confirm: NonEmptyStr }

type SmproRegister {
  name: NonEmptyStr
  offset: Int
  read_safety: SmproReadSafety
}

data smpro_read_safety_confirmation: NonEmptyStr = "Ampere's Altra Family SoC BMC Interface Specification register definitions (section 5.11) stating the register's read side-effects"

data smpro_manufacturer_id_reg: SmproRegister = SmproRegister {
  name: "MANUFACTURER_ID_REG",
  offset: 2,
  read_safety: ReadSafetyCitedInference {
    driver_use: ReadOnlyInDriver { function: "smpro_core_probe" },
    basis: extdeps_external_authority_anchor,
    would_confirm: smpro_read_safety_confirmation,
  },
}

data smpro_bootstage_lo_reg: SmproRegister = SmproRegister {
  name: "BOOTSTAGE_LO",
  offset: 177,
  read_safety: ReadSafetyCitedInference {
    driver_use: ReadOnlyInDriver { function: "boot_progress_show" },
    basis: smpro_misc_authority,
    would_confirm: smpro_read_safety_confirmation,
  },
}

data smpro_cur_bootstage_reg: SmproRegister = SmproRegister {
  name: "CUR_BOOTSTAGE",
  offset: 178,
  read_safety: ReadSafetyCitedInference {
    driver_use: ReadOnlyInDriver { function: "boot_progress_show" },
    basis: smpro_misc_authority,
    would_confirm: smpro_read_safety_confirmation,
  },
}

data smpro_bootstage_hi_reg: SmproRegister = SmproRegister {
  name: "BOOTSTAGE_HI",
  offset: 179,
  read_safety: ReadSafetyCitedInference {
    driver_use: ReadOnlyInDriver { function: "boot_progress_show" },
    basis: smpro_misc_authority,
    would_confirm: smpro_read_safety_confirmation,
  },
}

// THE ONE REGISTER THE DRIVER WRITES. boot_progress_show reads BOOTSTAGE, and when the reported stage
// is behind the current one it writes ((bootstage & 0xff00) | 0x1) back "for firmware to report new
// boot stage next time". That WRITE advances what the register reports; nothing in the driver says
// the read does. So a reader that never writes is inferred not to consume it, and this row is the
// place an Ampere source would correct that.
data smpro_bootstage_reg: SmproRegister = SmproRegister {
  name: "BOOTSTAGE",
  offset: 176,
  read_safety: ReadSafetyCitedInference {
    driver_use: WrittenBackByDriver { function: "boot_progress_show", write: "regmap_write(BOOTSTAGE, (bootstage & 0xff00) | 0x1) when the reported stage is behind CUR_BOOTSTAGE" },
    basis: smpro_misc_authority,
    would_confirm: smpro_read_safety_confirmation,
  },
}

fn smpro_word(first_byte: Int, second_byte: Int) -> Int {
  first_byte * 256 + second_byte
}

// ── the boot-progress fields (the ABI file's boot_progress description) ────────────────────────

// A code with no row in the ABI's table is carried as its number.
type SmproStageReading
  = SmproStageDefined { stage: AmpereBootStage }
  | SmproStageUndefined { code: Int }

type SmproStatusReading
  = SmproStatusDefined { status: AmpereBootStatus }
  | SmproStatusUndefined { code: Int }

fn smpro_stage_of(code: Int) -> SmproStageReading {
  if code == 0 { SmproStageDefined { stage: Smpro } }
  else if code == 1 { SmproStageDefined { stage: Pmpro } }
  else if code == 2 { SmproStageDefined { stage: AtfBl1 } }
  else if code == 3 { SmproStageDefined { stage: DdrInitialization } }
  else if code == 4 { SmproStageDefined { stage: DdrTraining } }
  else if code == 5 { SmproStageDefined { stage: AtfBl2 } }
  else if code == 6 { SmproStageDefined { stage: AtfBl31 } }
  else if code == 7 { SmproStageDefined { stage: AtfBl32 } }
  else if code == 8 { SmproStageDefined { stage: Uefi } }
  else if code == 9 { SmproStageDefined { stage: OperatingSystem } }
  else { SmproStageUndefined { code: code } }
}

fn smpro_status_of(code: Int) -> SmproStatusReading {
  if code == 0 { SmproStatusDefined { status: NotStarted } }
  else if code == 1 { SmproStatusDefined { status: Started } }
  else if code == 2 { SmproStatusDefined { status: Completed } }
  else if code == 3 { SmproStatusDefined { status: Failed } }
  else { SmproStatusUndefined { code: code } }
}

// BOOTSTAGE: boot_progress_show takes the stage as (bootstage >> 8) & 0xff, the value's high byte;
// the ABI's "AABB" puts the status beside it, so the low byte is the status.
type SmproBootStage {
  stage: SmproStageReading
  status: SmproStatusReading
}

fn smpro_bootstage_of(word: Int) -> SmproBootStage {
  SmproBootStage { stage: smpro_stage_of(code: (word / 256) % 256), status: smpro_status_of(code: word % 256) }
}

// CUR_BOOTSTAGE: boot_progress_show takes cur_stage = reg & 0xff, the value's low byte.
fn smpro_cur_bootstage_of(word: Int) -> SmproStageReading {
  smpro_stage_of(code: word % 256)
}

fn smpro_stage_text(r: SmproStageReading) -> String {
  match r {
    SmproStageUndefined { code: c } => concat("stage code ", to_string(c), " (no row in the ABI table)")
    SmproStageDefined { stage: s } => match s {
      Smpro => "SMpro firmware booting"
      Pmpro => "PMpro firmware booting"
      AtfBl1 => "ATF BL1 firmware booting"
      DdrInitialization => "DDR initialization"
      DdrTraining => "DDR training report status"
      AtfBl2 => "ATF BL2 firmware booting"
      AtfBl31 => "ATF BL31 firmware booting"
      AtfBl32 => "ATF BL32 firmware booting"
      Uefi => "UEFI firmware booting"
      OperatingSystem => "OS booting"
    }
  }
}

fn smpro_status_text(r: SmproStatusReading) -> String {
  match r {
    SmproStatusUndefined { code: c } => concat("status code ", to_string(c), " (no row in the ABI table)")
    SmproStatusDefined { status: s } => match s {
      NotStarted => "not started"
      Started => "started"
      Completed => "completed without error"
      Failed => "failed"
    }
  }
}
