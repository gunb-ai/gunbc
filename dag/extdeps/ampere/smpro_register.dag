fn smpro_word(first_byte: Int, second_byte: Int) -> Int {
  first_byte * 256 + second_byte
}

// ── the boot-progress fields (the ABI file's boot_progress description) ────────────────────────

// A code with no row in the ABI's table is carried as its number.
type SmproStageReading
  = SmproStageDefined { stage: AmpereBootStage }
  | SmproStageUndefined { code: Int }

type SmproStatusReading
  = SmproStatusDefined { status: AmpereBootStatus }
  | SmproStatusUndefined { code: Int }

fn smpro_stage_of(code: Int) -> SmproStageReading {
  if code == 0 { SmproStageDefined { stage: Smpro } }
  else if code == 1 { SmproStageDefined { stage: Pmpro } }
  else if code == 2 { SmproStageDefined { stage: AtfBl1 } }
  else if code == 3 { SmproStageDefined { stage: DdrInitialization } }
  else if code == 4 { SmproStageDefined { stage: DdrTraining } }
  else if code == 5 { SmproStageDefined { stage: AtfBl2 } }
  else if code == 6 { SmproStageDefined { stage: AtfBl31 } }
  else if code == 7 { SmproStageDefined { stage: AtfBl32 } }
  else if code == 8 { SmproStageDefined { stage: Uefi } }
  else if code == 9 { SmproStageDefined { stage: OperatingSystem } }
  else { SmproStageUndefined { code: code } }
}

fn smpro_status_of(code: Int) -> SmproStatusReading {
  if code == 0 { SmproStatusDefined { status: NotStarted } }
  else if code == 1 { SmproStatusDefined { status: Started } }
  else if code == 2 { SmproStatusDefined { status: Completed } }
  else if code == 3 { SmproStatusDefined { status: Failed } }
  else { SmproStatusUndefined { code: code } }
}

// BOOTSTAGE: boot_progress_show takes the stage as (bootstage >> 8) & 0xff, the value's high byte;
// the ABI's "AABB" puts the status beside it, so the low byte is the status.
type SmproBootStage {
  stage: SmproStageReading
  status: SmproStatusReading
}

fn smpro_bootstage_of(word: Int) -> SmproBootStage {
  SmproBootStage { stage: smpro_stage_of(code: (word / 256) % 256), status: smpro_status_of(code: word % 256) }
}

// CUR_BOOTSTAGE: boot_progress_show takes cur_stage = reg & 0xff, the value's low byte.
fn smpro_cur_bootstage_of(word: Int) -> SmproStageReading {
  smpro_stage_of(code: word % 256)
}

// THE PAIR, READ TOGETHER. boot_progress_show reads CUR_BOOTSTAGE and BOOTSTAGE as one record and
// returns -EINVAL when the reported stage is ahead of the current one; such a pair is refused here
// rather than decoded, so no consumer re-derives the byte layout or the rule.
type SmproBootProgress
  = SmproBootProgressRead { current: SmproStageReading, reported: SmproBootStage }
  | SmproBootProgressRefused { cur_bootstage_word: Int, bootstage_word: Int }

fn smpro_boot_progress_of(cur_bootstage_word: Int, bootstage_word: Int) -> SmproBootProgress {
  if (bootstage_word / 256) % 256 > cur_bootstage_word % 256 { SmproBootProgressRefused { cur_bootstage_word: cur_bootstage_word, bootstage_word: bootstage_word } }
  else { SmproBootProgressRead { current: smpro_cur_bootstage_of(word: cur_bootstage_word), reported: smpro_bootstage_of(word: bootstage_word) } }
}

fn smpro_stage_text(r: SmproStageReading) -> String {
  match r {
    SmproStageUndefined { code: c } => concat("stage code ", to_string(c), " (no row in the ABI table)")
    SmproStageDefined { stage: s } => match s {
      Smpro => "SMpro firmware booting"
      Pmpro => "PMpro firmware booting"
      AtfBl1 => "ATF BL1 firmware booting"
      DdrInitialization => "DDR initialization"
      DdrTraining => "DDR training report status"
      AtfBl2 => "ATF BL2 firmware booting"
      AtfBl31 => "ATF BL31 firmware booting"
      AtfBl32 => "ATF BL32 firmware booting"
      Uefi => "UEFI firmware booting"
      OperatingSystem => "OS booting"
    }
  }
}

fn smpro_status_text(r: SmproStatusReading) -> String {
  match r {
    SmproStatusUndefined { code: c } => concat("status code ", to_string(c), " (no row in the ABI table)")
    SmproStatusDefined { status: s } => match s {
      NotStarted => "not started"
      Started => "started"
      Completed => "completed without error"
      Failed => "failed"
    }
  }
}
