// THE SUBJECT IS THE AMPERE SMpro's I2C REGISTER INTERFACE as Ampere's own Linux drivers use it:
// smpro-core (the regmap over I2C), smpro-misc (the boot-progress registers) and smpro-errmon (the
// internal error, warning and event registers), with the ABI
// document that states what the boot-progress fields mean. Every name, offset and code below is
// transcribed from those four files at the pinned commits, under the drivers' own names.
//
// THE PROTOCOL (smpro-core: smpro_regmap_config, smpro_core_read, smpro_regmap_bus). Register
// addresses are 8 bits and values 16 bits. A read is a two-message transfer: WRITE the register
// address and the value size in bytes, [reg, 0x02], then READ two bytes. The bus is declared
// REGMAP_ENDIAN_BIG, so the FIRST byte on the wire is the value's HIGH byte.
//
// WHAT A READ IS KNOWN TO DO (DESIGN §4d, three standings kept apart by type). Ampere's
// documentation of these registers (the Altra Family SoC BMC Interface Specification, which the ABI
// file cites for its sections 5.11 and 6) has not been obtained. So the read-safety of every
// register here is a CITED INFERENCE from how the upstream driver uses it, not a vendor statement,
// and it is typed that way so an Ampere source can confirm or correct each row without rewriting
// any receipt.

data smpro_value_size_bytes: Int = 2

// smpro-core probe: regmap_read(MANUFACTURER_ID_REG) must equal AMPERE_MANUFACTURER_ID or the device
// is refused with -ENODEV. That makes it a known-answer read: a transport that returns this word
// from this register has reached an SMpro.
data smpro_manufacturer_id_expected: Int = 52538

// HOW THE UPSTREAM DRIVER USES A REGISTER, which is all the read-safety claim below rests on.
// ReadOnlyInDriver: the driver only ever reads it. WrittenBackByDriver: the driver reads it AND
// writes it, and the write is what has an effect; the raw read is inferred to be a plain read
// because the driver's read path is an ordinary regmap_read.
type SmproDriverUse
  = ReadOnlyInDriver { function: NonEmptyStr }
  | WrittenBackByDriver { function: NonEmptyStr, write: NonEmptyStr }

type SmproReadSafety
  = ReadSafetyCitedInference { driver_use: SmproDriverUse, basis: ExternalAuthority, would_confirm: NonEmptyStr }

type SmproRegister {
  name: NonEmptyStr
  offset: Int
  read_safety: SmproReadSafety
}

data smpro_read_safety_confirmation: NonEmptyStr = "Ampere's Altra Family SoC BMC Interface Specification register definitions (section 5.11) stating the register's read side-effects"

data smpro_manufacturer_id_reg: SmproRegister = SmproRegister {
  name: "MANUFACTURER_ID_REG",
  offset: 2,
  read_safety: ReadSafetyCitedInference {
    driver_use: ReadOnlyInDriver { function: "smpro_core_probe" },
    basis: extdeps_external_authority_anchor,
    would_confirm: smpro_read_safety_confirmation,
  },
}

