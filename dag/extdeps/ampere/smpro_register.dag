}

// THE ONE REGISTER THE DRIVER WRITES. boot_progress_show reads BOOTSTAGE, and when the reported stage
// is behind the current one it writes ((bootstage & 0xff00) | 0x1) back "for firmware to report new
// boot stage next time". That WRITE advances what the register reports; nothing in the driver says
// the read does. So a reader that never writes is inferred not to consume it, and this row is the
// place an Ampere source would correct that.
data smpro_bootstage_reg: SmproRegister = SmproRegister {
  name: "BOOTSTAGE",
  offset: 176,
  read_safety: ReadSafetyCitedInference {
    driver_use: WrittenBackByDriver { function: "boot_progress_show", write: "regmap_write(BOOTSTAGE, (bootstage & 0xff00) | 0x1) when the reported stage is behind CUR_BOOTSTAGE" },
    basis: smpro_misc_authority,
    would_confirm: smpro_read_safety_confirmation,
  },
}


// ── the internal error, warning and event registers (smpro-errmon) ────────────────────────────

// WHAT A RAW READ OF THESE DOES. smpro-errmon never clears by reading: every clear is a WRITE the
// driver issues after it has read. The two TYPE registers are write-one-to-clear --
// smpro_internal_err_read writes back the error bit it found (BIT(1) or BIT(2)) and
// smpro_internal_warn_read writes BIT(0) -- and smpro_event_data_read writes a nonzero event value
// back to its own register ("Clear event after read"). So a reader that only reads is inferred to
// leave every record in place, while the BMC's own sysfs attributes over the same driver DO clear
// on read: whatever else polls them can empty the record before this reader sees it.
data smpro_errmon_read_safety_confirmation: NonEmptyStr = "Ampere's Altra Family SoC BMC Interface Specification sections 5.7 and 5.10 (GPI status, RAS internal error registers) stating the registers' read side-effects"

data smpro_gpi_ras_err_reg: SmproRegister = SmproRegister {
  name: "GPI_RAS_ERR",
  offset: 126,
  read_safety: ReadSafetyCitedInference {
    driver_use: ReadOnlyInDriver { function: "smpro_internal_err_read" },
    basis: smpro_errmon_authority,
    would_confirm: smpro_errmon_read_safety_confirmation,
  },
}

data smpro_err_smpro_type_reg: SmproRegister = SmproRegister {
  name: "ERR_SMPRO_TYPE",
  offset: 160,
  read_safety: ReadSafetyCitedInference {
    driver_use: WrittenBackByDriver { function: "smpro_internal_err_read", write: "regmap_write(ERR_SMPRO_TYPE, <the TYPE bit just read>): write-one-to-clear of the record the read reported" },
    basis: smpro_errmon_authority,
    would_confirm: smpro_errmon_read_safety_confirmation,
  },
}

data smpro_err_pmpro_type_reg: SmproRegister = SmproRegister {
