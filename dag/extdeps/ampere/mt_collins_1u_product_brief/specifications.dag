// THE COLLATERAL SAYS REDFISH AND THE HELD UNIT REFUSES IT. This document lists Redfish among
// the systems-management interfaces. The private held-unit receipt records that this unit's
// firmware serves an SP-X-style REST API at /api/* and has NO endpoint at /redfish/v1. A
// platform-level capability claim and a firmware-level observation are different facts and both
// stand: the platform is specified for Redfish, the shipped firmware on the held unit does not
// implement it. Anything planning to drive these machines over Redfish must treat the collateral
// as a specification and the unit as the authority, and re-observe per firmware revision.
type MtCollins1UChassisDimensions {
  length: Millimeter
  width: Millimeter
  height: Millimeter
  rack_units_from_height: RackUnit
}

data mt_collins_1u_dimensions: MtCollins1UChassisDimensions = MtCollins1UChassisDimensions {
  length: millimeter(count: 847),
  width: millimeter(count: 438),
  height: millimeter(count: 43),
  rack_units_from_height: rack_unit(count: 1),
}

// THE FORM-FACTOR DISCREPANCY IS RESOLVED AT THE COLLATERAL LEVEL, AND NOT IN THE DIRECTION THE
// EARLIER ROW GUESSED. The 2U brief's platform note recorded a marketplace listing offering a 1U
// Mt. Collins as contradicting "the 2U form factor every public document states", and treated
// holding the unit as the only way to settle it. An official Ampere document titled "Mt. Collins
// 1U Product Brief" now stands, so the 1U variant is vendor-documented rather than a listing
// error.
//
// The sharper finding is that the two briefs state THE SAME DIMENSIONS - 33.36 in length,
// 17.24 in width, 1.7 in height - and 1.7 inches IS ONE RACK UNIT. So the 2U-titled document
// carries a height its own form-factor label contradicts, which means the discrepancy was never
// listing-versus-specification: it is internal to the vendor's collateral. Depth is unaffected
// and remains the load-bearing rack-planning figure at ~847 mm for both.
data mt_collins_1u_specifications_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ampere.mt_collins_1u_product_brief.specifications",
      decl_name: "mt_collins_1u_onboard_data_network",
      field: WholeDeclaration,
    }
  },
  first_citation: mt_collins_1u_brief_authority,
  further_citations: [],
}

data extdeps_model_scope: ExternalModelScope = mt_collins_1u_specifications_model_scope
