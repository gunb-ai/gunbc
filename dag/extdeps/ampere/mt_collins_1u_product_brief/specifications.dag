data extdeps_external_authority_anchor: ExternalAuthority = mt_collins_1u_brief_authority

data mt_collins_1u_specifications_subject: MtCollins1UPublicProductBrief = mt_collins_1u_public_product_brief

// THE NETWORKING FACT THIS MODULE EXISTS TO SETTLE, and it reverses a claim this repository
// briefly held. ONBOARD NETWORKING ON MT. COLLINS IS ONE INTEL i350 DUAL 1 GbE CONTROLLER, plus
// a Realtek RTL8211E port dedicated to BMC manageability. THERE IS NO ONBOARD 10 GIGABIT
// INTERFACE. Ten-gigabit connectivity on this platform is reached only through the OCP 3.0
// mezzanine slot, which the same page lists separately as "OCP 3.0 mezzanine card with
// multi-host support" - a SLOT, not a populated card.
//
// The retracted claim, recorded because it was acted on: a session reading dual 10GbE from the
// ASRock Rack ALTRAD8UD-1L2T row in the private mobo_x candidate concluded the held Foxconn
// Mt. Collins already carried 10GbE onboard and that fitting NICs would be redundant. Those are
// two different boards on two different procurement tracks; the ASRock part number's trailing
// 2T denotes its two 10GBase-T ports and says nothing about this platform. The consequence of
// the error was a recommendation NOT to buy NICs, which is backwards: a 10G fleet built on this
// platform needs one OCP 3.0 card per node that requires 10G.
//
// WHAT THIS ROW STILL DOES NOT ESTABLISH: whether the HELD unit has a card in that slot. The
// slot's presence is a platform fact from collateral; occupancy is a per-unit observation and
// belongs in the private held-unit receipts, where BMC sensor names OCP_Temp, OCP_Zone_Temp,
// OCP_OPT1_Temp and OCP_OPT2_Temp were read on 2026-09-06 - sensors that name a slot and an
// optical zone, which is evidence the chassis is wired for one, not evidence a card is fitted.

type OnboardNetworkController {
  controller: NonEmptyStr
  port_count: Nat
  per_port_bandwidth: Bandwidth
  purpose: NonEmptyStr
}

data mt_collins_1u_onboard_data_network: OnboardNetworkController = OnboardNetworkController {
  controller: "Intel i350",
  port_count: 2,
  per_port_bandwidth: bandwidth(count: 1000000000),
  purpose: "host data networking",
}

data mt_collins_1u_bmc_manageability_network: OnboardNetworkController = OnboardNetworkController {
  controller: "Realtek RTL8211E",
  port_count: 1,
  per_port_bandwidth: bandwidth(count: 1000000000),
  purpose: "BMC manageability port",
}

type OcpSlotStanding
  = OcpMezzanineSlotPresent { generation: NonEmptyStr, multi_host: Bool, occupancy_note: NonEmptyStr }
  | NoOcpSlot

data mt_collins_1u_ocp_slot: OcpSlotStanding = OcpMezzanineSlotPresent {
  generation: "OCP 3.0",
  multi_host: true,
  occupancy_note: "The brief states the slot and its multi-host support. It states no bundled card, so a populated NIC is not a platform fact and any 10G capability on a given unit is an observation about that unit.",
}

data ten_gigabit_ethernet_rate: Bandwidth = bandwidth(count: 10000000000)

fn mt_collins_1u_has_onboard_ten_gigabit() -> Bool {
  measure_le(
    a: ten_gigabit_ethernet_rate,
    b: mt_collins_1u_onboard_data_network.per_port_bandwidth,
  )
}

fn mt_collins_1u_ten_gigabit_requires_ocp_card() -> Bool {
  match mt_collins_1u_ocp_slot {
    NoOcpSlot => false,
    OcpMezzanineSlotPresent { generation: _, multi_host: _, occupancy_note: _ } =>
      !mt_collins_1u_has_onboard_ten_gigabit(),
  }
}

type MtCollins1UProcessorConfiguration {
  socket_count: Nat
  cores_per_socket: Nat
  architecture_label: NonEmptyStr
  max_core_clock: Hertz
}

data mt_collins_1u_processors: MtCollins1UProcessorConfiguration = MtCollins1UProcessorConfiguration {
  socket_count: 2,
  cores_per_socket: 80,
  architecture_label: "Ampere Altra, Arm v8.2+ 64-bit",
  max_core_clock: hertz(count: 3300000000),
}

// SEVENTY-TWO BITS IS SIXTY-FOUR PLUS EIGHT, and the carrier is what keeps that readable. The
// brief states "8x 72-bit DDR4-3200 channels": a 72-bit channel is a 64-bit datapath plus 8 bits
// of ECC, not a 72-bit datapath, so a consumer sizing bandwidth from this figure must divide by
// 64 and not by 72. Carried as std.measure BitWidth rather than a bare Nat because a count of
// bits is a unit-bearing quantity and the shared carrier already exists - minting a second
// spelling for it at this field is the re-invention DESIGN section 2 forbids.
type MtCollins1UMemoryConfiguration {
  channels_per_socket: Nat
  channel_width: BitWidth
  max_data_rate: MegatransfersPerSecond
  max_dimms_per_socket: Nat
  dimms_per_channel: Nat
  max_capacity: ByteSize
}

data mt_collins_1u_memory: MtCollins1UMemoryConfiguration = MtCollins1UMemoryConfiguration {
  channels_per_socket: 8,
  channel_width: bit_width(count: 72),
  max_data_rate: megatransfers_per_second(count: 3200),
  max_dimms_per_socket: 16,
  dimms_per_channel: 2,
  max_capacity: byte_size(count: 4398046511104),
}

