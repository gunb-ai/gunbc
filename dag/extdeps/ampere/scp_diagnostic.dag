data scp_diagnostic_scope_subject_note: String = "THE SUBJECT IS THE AMPERE SCP/SMpro/PMpro DIAGNOSTIC TOKEN STREAM AND ITS STRUCTURED BOOT-PROGRESS INTERFACE, as an upstream surface only. Deliberately NO token-to-meaning function exists: no codebook has been obtained, so a token is an identity this repository may compare and count and may not interpret. The read-effect axis is part of the subject because the interface is an acknowledged queue rather than a sampled register, which decides whether a reader may poll it. NOT gunbc receipts about a host, NOT any verdict about fatality."

// AMPERE owns the SCP / SMpro / PMpro diagnostic interfaces and the token
// namespace. This module models that upstream shape; it does NOT record what
// any particular host did, which is a fleet observation and lives downstream.
//
// The board vendor owns only how these consoles are ROUTED, and an AMI POST
// code table — the ordinary x86-style one printed in board manuals — is a
// different namespace that does not decode these tokens at all.

// A console token is a CLASS and a NUMBER, and the class carries no verdict.
// An earlier revision of this model treated the E prefix as meaning "error"
// and therefore "fatal". That is refuted: E559 and E571 are observed on a
// same-family machine that continues booting normally. Fatality is a property
// of the TRANSITION observed after a token, never of the lexeme.
type AmpereScpTokenClass
  = ScpPCode
  | ScpECode

type AmpereScpConsoleToken {
  class: AmpereScpTokenClass
  number: std.nat.Nat
}

// Whether this repository can say what a token MEANS. Separated from the
// token itself so a future vendor codebook upgrades the meaning without
// rewriting a single historical receipt.
// On MeaningUndecoded:
// No codebook obtained. The token may be compared and counted; its
// semantics may NOT be asserted. Construction of a description from an
// undecoded token is therefore impossible rather than merely discouraged.
type AmpereDiagnosticMeaning
  = MeaningDecoded {
      description: std.types.NonEmptyStr
      authority: extdeps.external_authority.ExternalAuthority
    }
  | MeaningUndecoded {
      required_codebook: extdeps.external_authority.ExternalAuthority?
    }

// The structured boot-progress interface, which is a DIFFERENT and richer
// surface than the console token stream: it separates status, stage, and a
// stage-specific payload, where the console emits only an opaque lexeme.
type AmpereBootStage
  = Smpro
  | Pmpro
  | AtfBl1
  | DdrInitialization
  | DdrTraining
  | AtfBl2
  | AtfBl31
  | AtfBl32
  | Uefi
  | OperatingSystem

type AmpereBootStatus
  = NotStarted
  | Started
  | Completed
  | Failed

// The decoded projection is Optional against the raw bytes, and the raw is
// REQUIRED. A reading whose field layout this repository has not established
// from a cited ABI must be storable in full without a decode: recording
// "stage 4, failed" from an unverified byte split would manufacture a
// semantic claim out of an arithmetic guess.
type AmpereStructuredBootProgress {
  raw: std.types.NonEmptyStr
  decoded_stage: AmpereBootStage?
  decoded_status: AmpereBootStatus?
  decoded_payload: std.nat.Nat?
  decode_authority: extdeps.external_authority.ExternalAuthority?
  observed_at: std.types.EpochMs
}

// READING IS NOT ALWAYS OBSERVING. Several of these interfaces mutate the
// state they report: error queues pop their oldest record, event registers
// clear on read, and the boot-progress read participates in progress
// acknowledgement. A convergence that polls them as if they were immutable
// files destroys evidence it was sent to collect — which happened during the
// 2026-08-11 incident, where the error registers were read repeatedly before
// their clear-on-read semantics were modeled.
type DiagnosticReadEffect
  = ReadSnapshot
  | ReadAcknowledgesBootProgress
  | ReadConsumesOldestRecord
  | ReadClearsReportedEvent

type AmpereDiagnosticInterface {
  sysfs_attribute: std.types.NonEmptyStr
  read_effect: DiagnosticReadEffect
}

// The interfaces observed present on the ALTRAD8UD BMC's smpro drivers.
// read_effect values are declared conservatively: where the effect is not
// established from a cited ABI, the SAFER assumption is that the read is
// destructive, because treating a destructive read as a snapshot loses data
// while treating a snapshot as destructive only costs a re-read.
data ampere_smpro_boot_progress_interface: AmpereDiagnosticInterface = AmpereDiagnosticInterface {
  sysfs_attribute: "boot_progress",
  read_effect: ReadAcknowledgesBootProgress,
}

// On AmpereDiagnosticInterface:
// Overflow counters are the one genuinely non-destructive group: they
// report whether records were LOST, which is what makes an empty queue
// interpretable at all.
data ampere_smpro_error_queue_interfaces: List<AmpereDiagnosticInterface> = [
  AmpereDiagnosticInterface { sysfs_attribute: "error_smpro", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_pmpro", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "warn_smpro", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "warn_pmpro", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_mem_ce", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_mem_ue", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_core_ce", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_core_ue", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_other_ce", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_other_ue", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_pcie_ce", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "error_pcie_ue", read_effect: ReadConsumesOldestRecord },
  AmpereDiagnosticInterface { sysfs_attribute: "event_dimm_hot", read_effect: ReadClearsReportedEvent },
  AmpereDiagnosticInterface { sysfs_attribute: "event_dimm_2x_refresh", read_effect: ReadClearsReportedEvent },
  AmpereDiagnosticInterface { sysfs_attribute: "event_vrd_hot", read_effect: ReadClearsReportedEvent },
  AmpereDiagnosticInterface { sysfs_attribute: "event_vrd_warn_fault", read_effect: ReadClearsReportedEvent },
  AmpereDiagnosticInterface { sysfs_attribute: "overflow_mem_ce", read_effect: ReadSnapshot },
  AmpereDiagnosticInterface { sysfs_attribute: "overflow_mem_ue", read_effect: ReadSnapshot },
]

fn scp_token_is_error_class(token: AmpereScpConsoleToken) -> Bool {
  token.class == ScpECode
}

// Deliberately absent: any function from a token to a verdict, a severity, or
// a description. There is no codebook, so no such function can be honest.
data ampere_scp_token_class_is_not_a_verdict_note: String = "The E prefix classifies a token's NAMESPACE, not its consequence. Public boot output from an ALTRAD8UD-1L2T / Altra Max M128-30 machine that boots successfully contains E559 and E571, so an E token is routinely non-fatal. Conversely P012 appears in that same successful progression immediately after 'PMpro output complete', so it is ordinary progress context rather than a stall marker. Any claim that a specific token is fatal must come from an observed transition on an observed host — token, then reset — and belongs in a fleet receipt, never in this upstream module. scp_token_is_error_class answers which NAMESPACE a token belongs to and nothing else; there is intentionally no token-to-meaning function here, because with no codebook obtained every implementation of one would be invention."
