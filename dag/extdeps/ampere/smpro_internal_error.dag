  SmproErrorCodeName { code: 129, led_default: "N/A", name: "IPP_FAULT_LOAD_AP_IMAGE" },
  SmproErrorCodeName { code: 130, led_default: "N/A", name: "IPP_FAULT_LOAD_PMPRO" },
  SmproErrorCodeName { code: 131, led_default: "N/A", name: "IPP_FAULT_PMD0DFT_FAIL" },
  SmproErrorCodeName { code: 132, led_default: "N/A", name: "ERR_DDR_GET_DIMM_INFO" },
  SmproErrorCodeName { code: 133, led_default: "N/A", name: "IPP_FAULT_OB2P_SLAVE_NOT_RDY" },
  SmproErrorCodeName { code: 134, led_default: "N/A", name: "IPP_FAULT_PCP_PMPRO_INIT_FAIL" },
  SmproErrorCodeName { code: 135, led_default: "N/A", name: "IPP_FAULT_TPM_INIT_FAIL" },
  SmproErrorCodeName { code: 136, led_default: "N/A", name: "ERR_HOB_UPDATE_FAIL" },
  SmproErrorCodeName { code: 137, led_default: "N/A", name: "SKU_NOT_VALID" },
  SmproErrorCodeName { code: 138, led_default: "N/A", name: "IPP_FAULT_TPM_EXTEND_FAIL" },
  SmproErrorCodeName { code: 139, led_default: "N/A", name: "ERR_BMC_OVERFLOW" },
  SmproErrorCodeName { code: 140, led_default: "N/A", name: "ERR_MESH_FAIL" },
  SmproErrorCodeName { code: 141, led_default: "N/A", name: "ERR_DDR_INVALID_MCU_MASK" },
  SmproErrorCodeName { code: 142, led_default: "N/A", name: "IPP_FAULT_EFUSE_WR_TIMEOUT" },
  SmproErrorCodeName { code: 143, led_default: "N/A", name: "IPP_FUSE_WR_DATA_MISTMATCH" },
  SmproErrorCodeName { code: 144, led_default: "N/A", name: "IPP_FUSE_UNSUPPORTED_OPERATION" },
  SmproErrorCodeName { code: 145, led_default: "N/A", name: "ERR_DDR_TRAINING_FAILED" },
]

type SmproNamedCode
  = SmproCodeDefined { code: Int, name: NonEmptyStr }
  | SmproCodeUndefined { code: Int }

fn smpro_code_named(table: List<SmproCodeName>, code: Int) -> SmproNamedCode {
  match filter(table, r => r.code == code).first() {
    Present { value: r } => SmproCodeDefined { code: code, name: r.name }
    Absent => SmproCodeUndefined { code: code }
  }
}

fn smpro_error_code_named(code: Int) -> SmproNamedCode {
  match filter(smpro_error_codes, r => r.code == code).first() {
    Present { value: r } => SmproCodeDefined { code: code, name: r.name }
    Absent => SmproCodeUndefined { code: code }
  }
}

// ── the record ─────────────────────────────────────────────────────────────────────────────────

// directions[] = {"ENTER", "EXIT"}: one bit, so both values are defined.
type SmproDirection
  = SmproEnter
  | SmproExit

// Which record TYPE reports, as the driver's bit tests name it: BIT(0) a warning (read from the
// WARN registers by smpro_internal_warn_read), BIT(1) an error, BIT(2) an error with data;
// smpro_internal_err_read takes BIT(1) before BIT(2).
type SmproRecordKind
  = SmproWarning
  | SmproErrorWithoutData
  | SmproErrorWithData

type SmproInternalRecord {
  kind: SmproRecordKind
  image: SmproNamedCode
  direction: SmproDirection
  location: SmproNamedCode
  error: SmproNamedCode
  info_hi_unparsed_bits: Int
  data_hi: Int
  data_lo: Int
}

fn smpro_error_kind_of(type_word: Int) -> SmproRecordKind? {
  if (type_word / 2) % 2 == 1 { Present { value: SmproErrorWithoutData } }
  else if (type_word / 4) % 2 == 1 { Present { value: SmproErrorWithData } }
  else { none }
}

// One record from its INFO words. DATA is carried only for an error with data; otherwise it is the
// zero the parser substitutes.
fn smpro_internal_record_of(kind: SmproRecordKind, info_hi: Int, info_lo: Int, data_hi: Int, data_lo: Int) -> SmproInternalRecord {
  let with_data = match kind { SmproErrorWithData => true SmproErrorWithoutData => false SmproWarning => false }
  SmproInternalRecord {
    kind: kind,
    image: smpro_code_named(table: smpro_image_codes, code: (info_hi / 4096) % 16),
    direction: if (info_hi / 2048) % 2 == 1 { SmproExit } else { SmproEnter },
    location: smpro_code_named(table: smpro_location_codes, code: info_hi % 256),
    error: smpro_error_code_named(code: info_lo % 65536),
    info_hi_unparsed_bits: (info_hi / 256) % 8,
    data_hi: if with_data { data_hi } else { 0 },
    data_lo: if with_data { data_lo } else { 0 },
  }
}

// The error record TYPE reports, or Absent when neither error bit is set.
fn smpro_internal_error_of(type_word: Int, info_hi: Int, info_lo: Int, data_hi: Int, data_lo: Int) -> SmproInternalRecord? {
  match smpro_error_kind_of(type_word: type_word) {
    Absent => none
    Present { value: k } => Present { value: smpro_internal_record_of(kind: k, info_hi: info_hi, info_lo: info_lo, data_hi: data_hi, data_lo: data_lo) }
  }
}

// The warning record TYPE reports, or Absent when BIT(0) is clear.
fn smpro_internal_warning_of(type_word: Int, warn_hi: Int, warn_lo: Int) -> SmproInternalRecord? {
  if type_word % 2 == 1 {
    Present { value: smpro_internal_record_of(kind: SmproWarning, info_hi: warn_hi, info_lo: warn_lo, data_hi: 0, data_lo: 0) }
  } else { none }
}

fn smpro_named_code_text(c: SmproNamedCode) -> String {
  match c {
    SmproCodeDefined { code: n, name: s } => concat(s as String, " (", to_string(n), ")")
    SmproCodeUndefined { code: n } => concat("code ", to_string(n), " (no row in internalErrors.hpp)")
  }
}

fn smpro_internal_record_text(r: SmproInternalRecord) -> String {
  concat(
    match r.kind { SmproWarning => "warning" SmproErrorWithoutData => "error" SmproErrorWithData => "error with data" },
    ": ", smpro_named_code_text(c: r.error),
    " at ", smpro_named_code_text(c: r.location),
    ", ", match r.direction { SmproEnter => "ENTER" SmproExit => "EXIT" },
    ", image ", smpro_named_code_text(c: r.image),
    match r.kind { SmproErrorWithData => concat(", data_hi ", to_string(r.data_hi), " data_lo ", to_string(r.data_lo)) SmproErrorWithoutData => "" SmproWarning => "" },
  )
}

// ── THE PENDING GATE (smpro-errmon smpro_internal_err_read / smpro_internal_warn_read) ──────────

// The driver reads GPI_RAS_ERR first and returns NO record unless that processor's pending bit is set
// -- bit 0 for the SMpro, bit 1 for the PMpro -- and only then reads TYPE, INFO and DATA. A record is
// therefore the driver's only when its gate was read and set. Every other combination is kept as its
// own arm rather than folded into "a record" or "no record":
//   NotPending                      the gate was read clear and TYPE reports nothing;
//   GpiUnavailable                  the gate was not read in the same window: a record TYPE reports is
//                                   carried UNGATED, never promoted to the driver's record;
//   PendingWithClearOrMissingType   the gate says pending but TYPE reports nothing or was not read;
//   TypePresentWithoutPending       TYPE reports a record while the gate was read clear.
type SmproProcessor
  = SmproProcessorSmpro
  | SmproProcessorPmpro

type SmproRecordGate
  = PendingAndDecoded { error: SmproInternalRecord?, warning: SmproInternalRecord? }
  | NotPending
  | GpiUnavailable { ungated_error: SmproInternalRecord?, ungated_warning: SmproInternalRecord? }
  | PendingWithClearOrMissingType
  | TypePresentWithoutPending { error: SmproInternalRecord?, warning: SmproInternalRecord? }

fn smpro_pending_bit(gpi: Int, p: SmproProcessor) -> Bool {
  match p {
    SmproProcessorSmpro => gpi % 2 == 1
    SmproProcessorPmpro => (gpi / 2) % 2 == 1
  }
}

fn smpro_any_record(error: SmproInternalRecord?, warning: SmproInternalRecord?) -> Bool {
  (match error { Present { value: _ } => true Absent => false }) || (match warning { Present { value: _ } => true Absent => false })
}

// gpi: the GPI_RAS_ERR word read in the same window, if read. error/warning: what TYPE/INFO/DATA
// decode to, Absent when TYPE reports nothing or its words were not read (type_read says which).
fn smpro_record_gate(gpi: Int?, processor: SmproProcessor, type_read: Bool, error: SmproInternalRecord?, warning: SmproInternalRecord?) -> SmproRecordGate {
  let any = smpro_any_record(error: error, warning: warning)
  match gpi {
    Absent => GpiUnavailable { ungated_error: error, ungated_warning: warning }
    Present { value: g } => if smpro_pending_bit(gpi: g, p: processor) {
      if type_read && any { PendingAndDecoded { error: error, warning: warning } } else { PendingWithClearOrMissingType }
    } else {
      if any { TypePresentWithoutPending { error: error, warning: warning } } else { NotPending }
    }
  }
}

fn smpro_record_gate_lines(g: SmproRecordGate) -> List<String> {
  let empty: List<String> = []
  match g {
    PendingAndDecoded { error: e, warning: w } => concat(
      match e { Present { value: r } => [smpro_internal_record_text(r: r)] Absent => empty },
      match w { Present { value: r } => [smpro_internal_record_text(r: r)] Absent => empty })
    NotPending => empty
    GpiUnavailable { ungated_error: e, ungated_warning: w } => concat(
      match e { Present { value: r } => [concat("UNGATED (GPI_RAS_ERR not read in this window) ", smpro_internal_record_text(r: r))] Absent => empty },
      match w { Present { value: r } => [concat("UNGATED (GPI_RAS_ERR not read in this window) ", smpro_internal_record_text(r: r))] Absent => empty })
    PendingWithClearOrMissingType => ["pending in GPI_RAS_ERR, but TYPE reports no record or was not read"]
    TypePresentWithoutPending { error: e, warning: w } => concat(
      match e { Present { value: r } => [concat("TYPE reports a record while GPI_RAS_ERR is clear: ", smpro_internal_record_text(r: r))] Absent => empty },
      match w { Present { value: r } => [concat("TYPE reports a record while GPI_RAS_ERR is clear: ", smpro_internal_record_text(r: r))] Absent => empty })
  }
}
