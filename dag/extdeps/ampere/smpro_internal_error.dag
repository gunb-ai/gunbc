module extdeps.ampere.smpro_internal_error

import v2.std.algebra { filter }
import std.types { Bool, Int, List, NonEmptyStr, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import v2.std.optional { Present }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.ampere.smpro_register { smpro_errmon_authority }

// THE SUBJECT IS THE SMpro/PMpro INTERNAL ERROR RECORD: the word set an SMpro exposes in its TYPE,
// INFO and DATA registers (extdeps.ampere.smpro_register, smpro-errmon), and what Ampere's own
// OpenBMC host-error monitor says each field means. The record's normative definition is section
// 5.10 of Ampere's Altra Family SoC BMC Interface Specification, which this corpus does not hold;
// everything here is transcribed from two OPEN sources at pinned commits, under their own names:
//
//   - the Linux driver (smpro_errmon_authority), which reads TYPE, then INFO_HI/INFO_LO and, for an
//     error with data, DATA_HI/DATA_LO, and prints them as %*phN over the u32 array
//     {INFO_HI, INFO_LO, DATA_HI, DATA_LO} -- each word's low byte first;
//   - ampere-misc altra-host-error-monitor (altra_host_error_monitor_authority), whose
//     prepareInternalErrData parses that line and whose include/internalErrors.hpp names the codes.
//
// THE FIELDS, as that parser takes them from the driver's line, restated on the register words:
// location is the first byte of the line, INFO_HI's low byte; the software image is the next hex
// digit, INFO_HI bits 15:12; the direction is bit 3 of that byte, INFO_HI bit 11; the error code is
// the second group byte-reversed (utils.hpp reverseStr = swap2Byte then reverse), which is INFO_LO
// as the register holds it. INFO_HI bits 10:8 are not read by the parser and are carried raw.
//
// AN UNLISTED CODE IS ITS NUMBER. The parser prints 'Unknown location' for a code past its table;
// here that is an explicit Undefined arm carrying the code, never the nearest name.

data altra_host_error_monitor_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ampere-openbmc/ampere-misc/blob/1ecb51edb5b2c44fe1b51f151c53def4536406a4/subprojects/altra-host-error-monitor/altra-host-error-monitor.cpp"
  }
}

data altra_internal_errors_table_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ampere-openbmc/ampere-misc/blob/1ecb51edb5b2c44fe1b51f151c53def4536406a4/subprojects/altra-host-error-monitor/include/internalErrors.hpp"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ampere.smpro_internal_error",
      decl_name: "SmproInternalRecord",
      field: WholeDeclaration
    }
  },
  first_citation: smpro_errmon_authority,
  further_citations: [altra_host_error_monitor_authority, altra_internal_errors_table_authority]
}

