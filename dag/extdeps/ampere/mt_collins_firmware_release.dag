module extdeps.ampere.mt_collins_firmware_release

import std.types { Int, NonEmptyStr, List }
import std.measure { ByteSize, byte_size, Second, second }
import extdeps.crypto.hash { sha256_digest }
import v2.std.optional { Present }
import extdeps.boards.types { AmpereMtCollins }
import extdeps.firmware.types {
  FirmwareReleaseRow, FirmwareTarget, FirmwareSemanticVersion,
  BmcController, HostBios, ScpFirmware, MainboardCpld,
  PicmgHpmImage, NoFirmwarePrerequisite, firmware_semantic_version,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// THE FOXCONN MT. COLLINS FIRMWARE RELEASES DELIVERED ON AMPERE SUPPORT TICKET #7426 (2026-09-18), AND
// THE VENDOR'S UPGRADE PROCEDURE FOR THEM. Two bundles: mt-collins-srp-mgmt-mgr-bin-r1.12-0.45_3 (BMC,
// CPLD/VRD, and the SOPs) and mt.collins-fw-aptv-bin-r2.10c-0ACOD014 (BIOS and SCP). The bundles and
// their own digests are recorded where the bytes are held (gunbc-private strategy.vendor_correspondence
// delivery_mt_collins_bmc_management and delivery_mt_collins_bios_scp); this module states the
// upstream facts about the .hpm members a flash consumes.
//
// THE DIGESTS ARE MEASURED, NOT TRANSCRIBED. Each image_digest below is sha256 over the .hpm member,
// computed 2026-10-02 from bundles whose own sha256 matched the private rows. The vendor manifests
// publish MD5 only, which std.content_hash does not carry, so they corroborate the members without
// being restated here.
//
// image_uri IS THE VENDOR'S DISTRIBUTION SURFACE, NOT A FETCH ROUTE. Ampere delivered these through a
// temporary upload on the ticket, which has since been removed; no public locator exists for these
// bytes, so the row names the portal they were delivered through. A realization fetches from the
// private route and accepts the bytes only when their digest matches the row.
//
// VERSIONS ARE THE VENDOR'S, PROJECTED ONTO THE TRIPLE. BMC 0.45.3 and SCP 2.10 are already triples. The
// BIOS release note states "BIOS Version : 0ACOD 0.14.0" for build 0ACOD014, so 0.14.0 is the vendor's
// own projection -- and it DISCARDS THE FAMILY LETTER: mtcollins1 shipped with 0ACOC017, which projects
// to 0.17.0 and so orders ABOVE 0ACOD014. Ordering on BIOS triples across families is meaningless; the
// convergence compares them for equality only. The MB CPLD release is "Revision : V06", carried as 6.0.0; that projection is ours,
// stated here so a readback parser has one place to agree with -- and BMC 0.45.3 reports that CPLD as
// "4.00 00000000", so no parser agrees with it yet.
data mt_collins_firmware_delivery_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "connect.amperecomputing.com" }
}

data mt_collins_bmc_0_45_3_hpm: FirmwareReleaseRow = FirmwareReleaseRow {
  board: AmpereMtCollins,
  target: BmcController,
  version: firmware_semantic_version(major: 0, minor: 45, patch: 3),
  released_on: 1703635200000,
  image_kind: PicmgHpmImage,
  image_uri: mt_collins_firmware_delivery_authority.uri,
  image_bytes: byte_size(count: 67109015),
  image_digest: Present { value: sha256_digest(hex: "8efa56a952e4c92c740f1ab22fe964c08bedd094cb82506d6b41a5856a7458c3") },
  release_notes: "MtCollinsBmc0_45_3.hpm, BMC_Release_Note.txt 12/27/2023: Basic Auth on every system interface (CVE-2023-34329, CVE-2023-34330), requiring a BIOS that supports it; Yafuflash unsupported from 0.45.2.",
  prerequisite: NoFirmwarePrerequisite,
  authority: mt_collins_firmware_delivery_authority,
}

data mt_collins_bios_0acod014_hpm: FirmwareReleaseRow = FirmwareReleaseRow {
  board: AmpereMtCollins,
  target: HostBios,
  version: firmware_semantic_version(major: 0, minor: 14, patch: 0),
  released_on: 1702339200000,
  image_kind: PicmgHpmImage,
  image_uri: mt_collins_firmware_delivery_authority.uri,
  image_bytes: byte_size(count: 14419791),
  image_digest: Present { value: sha256_digest(hex: "e250802973e2301a8773de8f59163ac5aa36b17ff37f8b19cddcd88f27eecb2e") },
  release_notes: "collins_aptiov_atf_signed_2.10c_0ACOD014.hpm, Mt.Collins-BIOS-0ACOD014-ReleaseNote.txt 2023/12/12: SRP 2.10c; BMC Redfish Basic Auth mode. Note 1: BIOS reference code and SCP versions must match. Note 4: reflash SCP and BIOS when changing CPU.",
  prerequisite: NoFirmwarePrerequisite,
  authority: mt_collins_firmware_delivery_authority,
}

data mt_collins_scp_2_10_hpm: FirmwareReleaseRow = FirmwareReleaseRow {
  board: AmpereMtCollins,
  target: ScpFirmware,
  version: firmware_semantic_version(major: 2, minor: 10, patch: 0),
  released_on: 1674691200000,
  image_kind: PicmgHpmImage,
  image_uri: mt_collins_firmware_delivery_authority.uri,
  image_bytes: byte_size(count: 261221),
  image_digest: Present { value: sha256_digest(hex: "75b59a873fe4941d1289791fa799d4b83cdf97f18493ed4024534bcfd0a3d56d") },
  release_notes: "altra_scp_signed_2.10.20230126.hpm, shipped in the r2.10c BIOS bundle beside 0ACOD014.",
