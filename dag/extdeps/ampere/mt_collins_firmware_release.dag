}

data mt_collins_mb_cpld_v06_hpm: FirmwareReleaseRow = FirmwareReleaseRow {
  board: AmpereMtCollins,
  target: MainboardCpld,
  version: firmware_semantic_version(major: 6, minor: 0, patch: 0),
  released_on: 1654560000000,
  image_kind: PicmgHpmImage,
  image_uri: mt_collins_firmware_delivery_authority.uri,
  image_bytes: byte_size(count: 1477347),
  image_digest: Present { value: sha256_digest(hex: "86fea80cab30dc43907966e8762a979bdfa4aa74cd0e88bcb86d9631cc89371e") },
  release_notes: "Mt.Collins_MB_CPLD_v06_20220607.hpm, MB_CPLD_Release Notes_20220607.txt: Mt.Collins MB CPLD (U3), LCMXO3LF-4300C-5BG400C, revision V06, PVT.",
  prerequisite: NoFirmwarePrerequisite,
  authority: mt_collins_firmware_delivery_authority,
}

// ── THE VENDOR PROCEDURE (System_FW_Upgrade_Guide.txt and the SOP_BMC_HPM_Out-Band, SOP_BIOS_HPM_Out-Band
// and SOP_SCP_Out-Band documents in the BMC bundle). The MB CPLD step's facts are NOT taken from its SOP:
// they are what the 2026-10-02 manual run on mtcollins1 did and observed. These are Foxconn's statements, so they are upstream facts here;
// whether a fleet FOLLOWS them is gunbc's policy and is decided there.
//
// THE RECOMMENDED ORDER is "1) BMC 2) BIOS 3) SCP 4) MB CPLD". A list, because the order is the fact.
data mt_collins_vendor_upgrade_order: List<FirmwareTarget> = [BmcController, HostBios, ScpFirmware, MainboardCpld]

// THE PER-STEP CONDITIONS THE BMC, BIOS AND SCP SOPs STATE, read 2026-10-02. Each first confirms the
// host is powered off (`chassis power off`, `chassis status`); each runs `hpm upgrade <file> force` with
// an upload block size of 30000 for the BMC and 8196 for BIOS and SCP, and answers a Y/y confirmation;
// each ends "AC power cycle the system by removing power from the server for at least 10 seconds". The
// MB CPLD step has no row here: its facts were observed on the manual run, not read from a vendor
// procedure, so its binding lives downstream in gunbc.fleet.mtcollins_firmware_converge.
//
// THE SCP SOP'S BANK SELECT IS THE SOP'S INSTRUCTION AND IS NOT CARRIED, because it does not work: the SOP first sends OEM command
// `raw 0x3c 0x0B` with 0x00 (primary) or 0x02 (secondary), and BMC 0.45.3 REFUSES it with completion
// code 0xc9 (mtcollins1, 2026-10-02). The upgrade that followed wrote the default image and the SMpro
// version register r0x01 read 0x0a02 (2.10) afterwards. A procedure row that told a realization to send
// a command the controller refuses would be a vendor statement standing where an observation
// contradicts it (§4d). The SCP SOP's upgrade line also reads `hpm <file> force` with no `upgrade`
// verb, taken as a typo for the line every sibling SOP prints.
type MtCollinsHpmStepProcedure {
  firmware_release: FirmwareReleaseRow
  upload_block: ByteSize
}

data mt_collins_minimum_ac_off: Second = second(count: 10)

data mt_collins_hpm_procedures: List<MtCollinsHpmStepProcedure> = [
  MtCollinsHpmStepProcedure { firmware_release: mt_collins_bmc_0_45_3_hpm, upload_block: byte_size(count: 30000) },
  MtCollinsHpmStepProcedure { firmware_release: mt_collins_bios_0acod014_hpm, upload_block: byte_size(count: 8196) },
  MtCollinsHpmStepProcedure { firmware_release: mt_collins_scp_2_10_hpm, upload_block: byte_size(count: 8196) },
]

// ── WHICH BIOS AND SCP VERSIONS ARE A PAIR. BIOS release note 1: "The BIOS Reference code version and
// the SCP F/W version should be matched." The vendor publishes no table, so the pairs stated here are
// the ones the vendor SHIPPED TOGETHER in one SRP bundle -- 0ACOD014 (SRP 2.10c) beside SCP 2.10 --
// and a pair not on this list is unknown, never assumed compatible.
type BiosScpPair {
  bios: FirmwareSemanticVersion
  scp: FirmwareSemanticVersion
}

data mt_collins_bios_scp_pairs: List<BiosScpPair> = [
  BiosScpPair {
    bios: firmware_semantic_version(major: 0, minor: 14, patch: 0),
    scp: firmware_semantic_version(major: 2, minor: 10, patch: 0),
  },
]

// ── BMC 0.45.3 NEEDS A BASIC-AUTH BIOS. BMC release note: "This change required users upgrading latest
// BIOS which support 'Basic Auth' feature, otherwise Redfish communication between BMC and BIOS will
// not function." The BIOS that adds it is 0ACOD014 (change list 1). This is an interoperation
// requirement between two running images, not a flash prerequisite: the BMC flashes fine without it.
// requires_one_of is a SET OF RELEASE ROWS, joined by their own image digests (each row owns its digest),
// never a version bound: BIOS triples do
// not order across families (0ACOC017 projects ABOVE 0ACOD014 and lacks Basic Auth), so the only honest
// question is membership in the releases the vendor states support the feature. A release not in the
// set -- including any of an unknown family -- does not meet it.
type InteropRequirement {
  when_target: FirmwareTarget
  at_least: FirmwareSemanticVersion
  requires_target: FirmwareTarget
  requires_one_of: List<FirmwareReleaseRow>
  consequence: NonEmptyStr
}

data mt_collins_interop_requirements: List<InteropRequirement> = [
  InteropRequirement {
    when_target: BmcController,
    at_least: firmware_semantic_version(major: 0, minor: 45, patch: 3),
    requires_target: HostBios,
    requires_one_of: [mt_collins_bios_0acod014_hpm],
    consequence: "Redfish over the BMC-BIOS HTTP-over-USB host interface does not function; WebUI and Redfish lose host inventory.",
  },
]

// ── WHICH SILICON THE BIOS FAMILY STATES IT SUPPORTS. The 0ACOD release notes say from 0ACOD006 on that
// the BIOS "supports Altra and Altra Max"; they say nothing about engineering-sample parts. Both halves
// are the vendor's statement: the named production lines are stated, and an engineering sample is
// UNSTATED -- not unsupported, not supported. A consumer may not read the silence as either (§4d).
type BiosSiliconSupportStatement {
  bios_family: NonEmptyStr
  from_build: NonEmptyStr
  stated_production_lines: List<NonEmptyStr>
  engineering_samples_stated: Bool
}

data mt_collins_0acod_silicon_support: BiosSiliconSupportStatement = BiosSiliconSupportStatement {
  bios_family: "0ACOD",
  from_build: "0ACOD006",
  stated_production_lines: ["Altra", "Altra Max"],
  engineering_samples_stated: false,
}
