      module_path: "extdeps.ampere.mt_collins_product_brief.memory_population",
      decl_name: "mt_collins_population_rows",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

data extdeps_model_scope: ExternalModelScope = mt_collins_memory_population_model_scope
