module extdeps.ampere.mt_collins_product_brief.subject

import std.types { String, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.vendor.ampere { ampere_vendor, ampere_customer_reference_boards_authority }

// MT. COLLINS IS NOT AN OCP CONTRIBUTION. The public artifact is a dual-socket 2U marketing
// brief; the engineering design package sits behind Ampere Customer Connect under NDA. Recording
// the public brief here closes the search without pretending marketing collateral establishes
// board-design facts this public repository may carry.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "uawartifacts.blob.core.windows.net/upload-files/data/uawbrochures/cloud_native_demo/Mt._Collins_2U_2022_V2.pdf",
  }
}

data mt_collins_product_brief_subject_note: String = "PUBLIC MARKETING COLLATERAL ONLY. Mt. Collins is dual-socket 2U reference hardware whose engineering documents are NDA-gated through Customer Connect; this brief is recorded so the lane does not repeat the search. The locator returned HTTP 200 on 2026-08-14, but no engineering fact from inside the PDF is modelled — establishing those facts would require the NDA route, which this public repository does not carry."

type MtCollinsProductBriefRevision
  = | MtCollinsBrief2022V2

type PublicBriefReadProvenance
  = DocumentLocatorFetchRefused { http_status: Int, detail: NonEmptyStr }
  | DocumentLocatorFetchedButTextUnread { http_status: Int, detail: NonEmptyStr }
  | OperatorSuppliedDocumentText

type EngineeringFactsRoute
  = EngineeringFactsUnderNda { access_route: ExternalAuthority }
  | EngineeringFactsPubliclyIngested

data mt_collins_product_brief_title: NonEmptyStr = "Mt. Collins 2U product brief"

data mt_collins_product_brief_version_label: NonEmptyStr = "2022 V2"

data mt_collins_product_brief_citation_read_provenance: PublicBriefReadProvenance = DocumentLocatorFetchedButTextUnread {
  http_status: 200,
  detail: "public marketing PDF fetched successfully; no interior engineering fact is modelled because the authoritative design package is NDA-gated",
}

data mt_collins_engineering_facts_route: EngineeringFactsRoute = EngineeringFactsUnderNda {
  access_route: ampere_customer_reference_boards_authority,
}

type MtCollinsPublicProductBrief {
  marketing_name: NonEmptyStr
  revision: MtCollinsProductBriefRevision
  version_label: NonEmptyStr
  publisher: Vendor<Hardware>
  citation_read_provenance: PublicBriefReadProvenance
  engineering_facts_route: EngineeringFactsRoute
}

data mt_collins_public_product_brief: MtCollinsPublicProductBrief = MtCollinsPublicProductBrief {
  marketing_name: "Mt. Collins",
  revision: MtCollinsBrief2022V2,
  version_label: mt_collins_product_brief_version_label,
  publisher: ampere_vendor,
  citation_read_provenance: mt_collins_product_brief_citation_read_provenance,
  engineering_facts_route: mt_collins_engineering_facts_route,
}

data mt_collins_product_brief_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ampere.mt_collins_product_brief.subject",
      decl_name: "mt_collins_public_product_brief",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

data extdeps_model_scope: ExternalModelScope = mt_collins_product_brief_model_scope
