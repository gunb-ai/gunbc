module extdeps.ampere.mt_collins_product_brief.subject

import std.types { String, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.publication { DocumentPublicationStatus, PubliclyPublishedWithRestrictiveMarking }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.vendor.ampere { ampere_vendor, ampere_customer_reference_boards_authority }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "uawartifacts.blob.core.windows.net/upload-files/data/uawbrochures/cloud_native_demo/Mt._Collins_2U_2022_V2.pdf",
  }
}

// PUBLIC MARKETING COLLATERAL ONLY. Mt. Collins is dual-socket 2U reference hardware whose
// engineering documents are NDA-gated through Customer Connect; this brief is recorded so the lane
// does not repeat the search. HOW THIS REPOSITORY READ THE LOCATOR IS RECORDED AS A GUNBC RECEIPT
// WITH A DeclarationRef TO mt_collins_public_product_brief, NOT AS A FIELD ON THIS RECORD.

type MtCollinsBrief2022V2 {}

type MtCollinsProductBriefRevision = MtCollinsBrief2022V2

type EngineeringFactsRoute
  = EngineeringFactsUnderNda { access_route: ExternalAuthority }
  | EngineeringFactsPubliclyIngested

data mt_collins_product_brief_title: NonEmptyStr = "Mt. Collins 2U product brief"

data mt_collins_product_brief_version_label: NonEmptyStr = "2022 V2"

// THE NDA ROUTE COVERS THE DESIGN PACKAGE, NOT EVERY ENGINEERING DOCUMENT. What is gated is the
// reference-BOARD collateral -- the motherboard design package, UEFI, OpenBMC and CPLD source --
// which is the population extdeps.cpu.ampere_altra_package names as barred. The getting started
// guide is a different document on a different route: it is publicly retrievable, and this module
// used to imply otherwise. Keeping one route row answer for both documents was a meaning fork, and
// it held a lane for hours on a premise a sibling module already contradicted.
data mt_collins_design_package_route: EngineeringFactsRoute = EngineeringFactsUnderNda {
  access_route: ampere_customer_reference_boards_authority,
}

data mt_collins_engineering_facts_route: EngineeringFactsRoute = mt_collins_design_package_route

// THE GETTING STARTED GUIDE, AND ITS PUBLICATION STATUS AS A DECLARED FACT RATHER THAN A SILENCE.
// The locator below was fetched with NO credentials -- no Customer Connect session, no cookie --
// returning HTTP 200, 9409569 bytes of application/pdf whose SHA-256 equals the digest
// memory_population cites, so the retrieved bytes are the same Issue 1.05 document the tables were
// read from. That is the discriminating observation the carriage axis turns on: the guide is
// PUBLICLY PUBLISHED. Its every page is footed proprietary and confidential, and per
// extdeps.publication that marking is recorded and decides nothing.
//
// The status is declared here because gunbc.upstream_document_carriage reads a status it does not
// own, and a module that declares none never enters the rule's domain at all -- which is how facts
// from this guide reached the public tree without the carriage question ever being asked.
data mt_collins_gsg_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "connect-admin.amperecomputing.com/api/secure-file-download/download-regular/?file=Mt_Collins_DVT_PVT_MP_GSG_v1_05_20260720_52a0348e87.pdf&type=technical-document&documentId=z6zenr250qdpa8eq4irolgds",
  }
}

data mt_collins_gsg_publication_status: DocumentPublicationStatus = PubliclyPublishedWithRestrictiveMarking {
  marking: "Ampere Computing Proprietary and Confidential, document AMP 2021-00511",
}

type MtCollinsPublicProductBrief {
  marketing_name: NonEmptyStr
  revision: MtCollinsProductBriefRevision
  version_label: NonEmptyStr
  publisher: Vendor<Hardware>
  engineering_facts_route: EngineeringFactsRoute
}

data mt_collins_public_product_brief: MtCollinsPublicProductBrief = MtCollinsPublicProductBrief {
  marketing_name: "Mt. Collins",
  revision: MtCollinsBrief2022V2 {},
  version_label: mt_collins_product_brief_version_label,
  publisher: ampere_vendor,
  engineering_facts_route: mt_collins_engineering_facts_route,
}

data mt_collins_product_brief_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ampere.mt_collins_product_brief.subject",
      decl_name: "mt_collins_public_product_brief",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

data extdeps_model_scope: ExternalModelScope = mt_collins_product_brief_model_scope
