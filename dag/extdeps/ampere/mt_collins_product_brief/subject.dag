module extdeps.ampere.mt_collins_product_brief.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "uawartifacts.blob.core.windows.net/upload-files/data/uawbrochures/cloud_native_demo/Mt._Collins_2U_2022_V2.pdf",
  }
}

data mt_collins_product_brief_subject_note: String = "PUBLIC MARKETING COLLATERAL ONLY. Mt. Collins is dual-socket 2U reference hardware whose engineering documents are NDA-gated through Customer Connect; this brief is recorded so the lane does not repeat the search. HOW THIS REPOSITORY READ THE LOCATOR IS RECORDED AS A GUNBC RECEIPT WITH A DeclarationRef TO mt_collins_public_product_brief, NOT AS A FIELD ON THIS RECORD."

type MtCollinsBrief2022V2 {}

type MtCollinsProductBriefRevision = MtCollinsBrief2022V2

type EngineeringFactsRoute
  = EngineeringFactsUnderNda { access_route: extdeps.external_authority.ExternalAuthority }
  | EngineeringFactsPubliclyIngested

data mt_collins_product_brief_title: std.types.NonEmptyStr = "Mt. Collins 2U product brief"

data mt_collins_product_brief_version_label: std.types.NonEmptyStr = "2022 V2"

data mt_collins_engineering_facts_route: EngineeringFactsRoute = EngineeringFactsUnderNda {
  access_route: ampere_customer_reference_boards_authority,
}

type MtCollinsPublicProductBrief {
  marketing_name: std.types.NonEmptyStr
  revision: MtCollinsProductBriefRevision
  version_label: std.types.NonEmptyStr
  publisher: Vendor<extdeps.hardware.Hardware>
  engineering_facts_route: EngineeringFactsRoute
}

data mt_collins_public_product_brief: MtCollinsPublicProductBrief = MtCollinsPublicProductBrief {
  marketing_name: "Mt. Collins",
  revision: MtCollinsBrief2022V2 {},
  version_label: mt_collins_product_brief_version_label,
  publisher: ampere_vendor,
  engineering_facts_route: mt_collins_engineering_facts_route,
}

data mt_collins_product_brief_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.ampere.mt_collins_product_brief.subject",
      decl_name: "mt_collins_public_product_brief",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps.ampere.mt_collins_product_brief.subject.extdeps_external_authority_anchor,
  further_citations: [],
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = mt_collins_product_brief_model_scope
