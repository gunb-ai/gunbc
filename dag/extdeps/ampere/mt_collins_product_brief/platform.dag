module extdeps.ampere.mt_collins_product_brief.platform

import std.types { String, NonEmptyStr, Int }
import std.nat { Nat }
import std.measure { MegatransfersPerSecond, megatransfers_per_second, Millimeter, millimeter, RackUnit, rack_unit }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.ampere.mt_collins_product_brief.subject { MtCollinsPublicProductBrief, mt_collins_public_product_brief }
import extdeps.ampere.mt_collins_getting_started_guide.subject { mt_collins_gsg_authority }

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "uawartifacts.blob.core.windows.net/upload-files/data/uawbrochures/cloud_native_demo/Mt._Collins_2U_2022_V2.pdf",
  }
}

// A NAMED alias for the anchor, so a consumer cites this platform's authority by
// a symbol naming the platform rather than by the generic per-module anchor name.
data mt_collins_product_brief_authority: ExternalAuthority = extdeps_external_authority_anchor

data platform_subject_edge_note: String = "PLATFORM FACTS JOIN THE ENTITY THEY DESCRIBE, on the extdeps.ocp.mt_jade.platform pattern: extdeps.ampere.mt_collins_product_brief.subject owns mt_collins_public_product_brief, and this row is the typed subject edge binding the mechanical facts below to that declaration."

data mt_collins_platform_subject: MtCollinsPublicProductBrief = mt_collins_public_product_brief


data platform_note: String = "MECHANICAL FACTS FROM PUBLIC MT. COLLINS COLLATERAL, read 2026-08-18: the 2022 V2 product brief (anchor above) and the publicly downloadable Mt. Collins DVT/PVT/MP getting-started guide describe a dual-socket 2U rack server for Altra and Altra Max with thirty-two DDR4 DIMM connectors - sixteen per socket, two DIMMs per channel - at DDR4-3200. Everything here is a READING of marketing and getting-started collateral, never a measurement, and the getting started guide is publicly retrievable - it is cited structurally in further_citations below, and its publication status lives on extdeps.ampere.mt_collins_getting_started_guide.subject. The access-gated population is the reference-board DESIGN PACKAGE, named by extdeps.cpu.ampere_altra_package, and nothing here is read from it. MARKET DISCREPANCY WORTH A ROW: at least one 2026 marketplace listing offers a Mt. Collins chassis described as 1U, which contradicts the 2U form factor every public document states; a listing-versus-specification conflict is resolved by holding the unit, not by trusting either page."

type MtCollinsPlatformMechanical {
  form_factor_label: NonEmptyStr
  processor_socket_count: Nat
  ddr4_dimms_total: Nat
  ddr4_dimms_per_socket: Nat
  dimms_per_channel: Nat
  ddr4_max_data_rate: MegatransfersPerSecond
}

data mt_collins_platform_mechanical: MtCollinsPlatformMechanical = MtCollinsPlatformMechanical {
  form_factor_label: "2U rack server",
  processor_socket_count: 2,
  ddr4_dimms_total: 32,
  ddr4_dimms_per_socket: 16,
  dimms_per_channel: 2,
  ddr4_max_data_rate: megatransfers_per_second(count: 3200),
}

data mt_collins_platform_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ampere.mt_collins_product_brief.platform",
      decl_name: "mt_collins_platform_mechanical",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [mt_collins_gsg_authority],
}

data extdeps_model_scope: ExternalModelScope = mt_collins_platform_model_scope

// ---------------------------------------------------------------------------------------------
// CHASSIS VARIANTS AND DEPTH. The public 2022 V2 collateral states one 2U chassis at
// 33.36 x 17.24 x 1.7 inches; the liquidation market ships a 1U variant (chassis part
// 1A624RA00-600-G, FRU-read from a held unit). Depth is the load-bearing figure for rack
// planning: both variants are ~850mm-class - far deeper than commodity 1U - so cabinet
// admission needs 42-48in / 1200mm depth, and sliding rail kits capped near 29in chassis
// length are excluded. Each row declares its provenance grade; the measured row is an
// operator tape measure, approximate to roughly a centimetre, superseded by a datasheet
// figure for the 1U chassis if one ever surfaces.
// ---------------------------------------------------------------------------------------------

type MtCollinsDimensionProvenance
  = CitedCollateral
  | OperatorMeasuredApproximate

type MtCollinsChassisVariant {
  chassis_part_number: NonEmptyStr
  rack_units: RackUnit
  overall_depth: Millimeter
  depth_provenance: MtCollinsDimensionProvenance
}

data mt_collins_chassis_2u: MtCollinsChassisVariant = MtCollinsChassisVariant {
  chassis_part_number: "unstated in the public collateral",
  rack_units: rack_unit(count: 2),
  overall_depth: millimeter(count: 847),
  depth_provenance: CitedCollateral,
}

// The 2U depth is the collateral's 33.36in converted (847mm). The 1U depth is ~33.75in (857mm) by
// operator tape measure 2026-08-29 on the held unit - approximate, not a datasheet figure, and
// within 10mm of the 2U depth: the 1U variant is the same very deep chassis, not a shortened one.
// Mounting-ear positions and rail-member part numbers remain unmeasured.

data mt_collins_chassis_1u: MtCollinsChassisVariant = MtCollinsChassisVariant {
  chassis_part_number: "1A624RA00-600-G",
  rack_units: rack_unit(count: 1),
  overall_depth: millimeter(count: 857),
  depth_provenance: OperatorMeasuredApproximate,
}
