module extdeps.ampere.mt_collins_product_brief.platform



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https,
    locator: "uawartifacts.blob.core.windows.net/upload-files/data/uawbrochures/cloud_native_demo/Mt._Collins_2U_2022_V2.pdf",
  }
}

data platform_subject_edge_note: String = "PLATFORM FACTS JOIN THE ENTITY THEY DESCRIBE, on the extdeps.ocp.mt_jade.platform pattern: extdeps.ampere.mt_collins_product_brief.subject owns extdeps.ampere.mt_collins_product_brief.subject.mt_collins_public_product_brief, and this row is the typed subject edge binding the mechanical facts below to that declaration."

data mt_collins_platform_subject: extdeps.ampere.mt_collins_product_brief.subject.MtCollinsPublicProductBrief = extdeps.ampere.mt_collins_product_brief.subject.mt_collins_public_product_brief

data platform_note: String = "MECHANICAL FACTS FROM PUBLIC MT. COLLINS COLLATERAL, read 2026-08-18: the 2022 V2 product brief (anchor above) and the publicly downloadable Mt. Collins DVT/PVT/MP getting-started guide describe a dual-socket 2U rack server for Altra and Altra Max with thirty-two DDR4 DIMM connectors - sixteen per socket, two DIMMs per channel - at DDR4-3200. Everything here is a READING of marketing and getting-started collateral, never a measurement, and the NDA route on the subject row still gates engineering-grade facts. MARKET DISCREPANCY WORTH A ROW: at least one 2026 marketplace listing offers a Mt. Collins chassis described as 1U, which contradicts the 2U form factor every public document states; a listing-versus-specification conflict is resolved by holding the unit, not by trusting either page."

type MtCollinsPlatformMechanical {
  form_factor_label: std.types.NonEmptyStr
  processor_socket_count: std.nat.Nat
  ddr4_dimms_total: std.nat.Nat
  ddr4_dimms_per_socket: std.nat.Nat
  dimms_per_channel: std.nat.Nat
  ddr4_max_data_rate: std.measure.MegatransfersPerSecond
}

data mt_collins_platform_mechanical: MtCollinsPlatformMechanical = MtCollinsPlatformMechanical {
  form_factor_label: "2U rack server",
  processor_socket_count: 2,
  ddr4_dimms_total: 32,
  ddr4_dimms_per_socket: 16,
  dimms_per_channel: 2,
  ddr4_max_data_rate: std.measure.megatransfers_per_second(count: 3200),
}

data mt_collins_platform_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.ampere.mt_collins_product_brief.platform",
      decl_name: "mt_collins_platform_mechanical",
      field: std.decl_ref.WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = mt_collins_platform_model_scope
