// A key the header does not define is its number, never the nearest name.
type NvParamKeyReading
  = NvParamKeyDefined { key: NvParamKey }
  | NvParamKeyUndefined { key: Int }

fn nvparam_key_text(r: NvParamKeyReading) -> String {
  match r {
    NvParamKeyDefined { key: k } => k.name as String
    NvParamKeyUndefined { key: n } => concat("key ", to_string(n), " (not defined in NVParamDef.h)")
  }
}

// The key table as an index -- the one key-to-name route: built once per caller and queried per key,
// rather than scanning all rows for every key.
fn nvparam_key_index() -> Map<Int, NvParamKey> {
  fold(nvparam_keys, init: empty_map(), f: (acc, k) => map_insert(m: acc, key: k.key, value: k))
}

fn nvparam_key_in(index: Map<Int, NvParamKey>, key: Int) -> NvParamKeyReading {
  match map_lookup(m: index, key: key) {
    Present { value: k } => NvParamKeyDefined { key: k }
    Absent => NvParamKeyUndefined { key: key }
  }
}
