module extdeps.ampere.nvparam

import v2.std.collection { empty_map, map_insert, map_lookup }
import std.types { Int, List, Map, NonEmptyStr, String }
import std.measure { ByteSize, byte_size }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.optional { Present }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

// THE SUBJECT IS THE AMPERE ALTRA NON-VOLATILE PARAMETER (NVPARAM) KEY SPACE, as Ampere publishes it
// in edk2-platforms Silicon/Ampere/AmpereAltraPkg/Include/NVParamDef.h (BSD-2-Clause-Patent) at the
// pinned commit. Every key below is transcribed mechanically from that header's
// `#define NV_SI_<name> ((<n> * 8) + <REGION>_START)` lines, under the header's own names: a key is
// the parameter's byte offset, 8 bytes per parameter, inside one of four regions whose bases the
// header declares (NV_PREBOOT_PARAM_START 0x0000, NV_MANU_PARAM_START 0x4000, NV_USER_PARAM_START
// 0x8000, NV_BOARD_PARAM_START 0xC000).
//
// THE HEADER ALSO STATES THE SPI-NOR LAYOUT: a Master copy the user may change and a "Last Known
// Copy" that "is handled by the fail safe" -- "a last know bootable copy" -- each holding a 16KB
// pre-boot region and a 32KB manufacturing-and-user region; and that the pre-boot parameters "will
// reset to default value on failsafe". NV_SI_FAILSAFE_RETRY (key 0x10) is one of them. What value a
// key holds, and what a value means, is NOT stated by the header and is not modeled here.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/tianocore/edk2-platforms/blob/2170c80c622ed5353ac09e3335aafbbab8e40e4d/Silicon/Ampere/AmpereAltraPkg/Include/NVParamDef.h"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ampere.nvparam",
      decl_name: "NvParamKey",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// The four regions, named by the header's *_PARAM_START defines.
type NvParamRegion
  = NvPreboot
  | NvManufacturing
  | NvUser
  | NvBoard

type NvParamKey {
  key: Int
  name: NonEmptyStr
  region: NvParamRegion
}

// NVPARAM_SIZE (Silicon/Ampere/AmpereAltraPkg/Include/Library/NVParamLib.h `#define NVPARAM_SIZE 0x8`):
// the stride between keys, under the header's own name.
data nvparam_size: ByteSize = byte_size(count: 8)

// Each region's first and last key, as the header defines them: NV_PREBOOT_PARAM_START 0x0000 and
// NV_PREBOOT_PARAM_MAX (86 * 8) + start; NV_MANU_PARAM_START 0x4000 and NV_MANU_PARAM_MAX (66 * 8) +
// start; NV_USER_PARAM_START 0x8000 and NV_USER_PARAM_MAX = NV_SI_PCIE_S1_RC7_AER_CE_INTERVAL;
// NV_BOARD_PARAM_START 0xC000 and NV_BOARD_PARAM_MAX (255 * 8) + start. PrintNVRAM walks each region
// from START to MAX inclusive in NVPARAM_SIZE steps, so these bound every key a dump can print.
fn nvparam_region_start(r: NvParamRegion) -> Int {
  match r { NvPreboot => 0 NvManufacturing => 16384 NvUser => 32768 NvBoard => 49152 }
}

fn nvparam_region_max(r: NvParamRegion) -> Int {
  match r { NvPreboot => 688 NvManufacturing => 16912 NvUser => 33584 NvBoard => 51192 }
}

