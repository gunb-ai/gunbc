module extdeps.ampere.mt_collins_board

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.board_authority { BoardAuthorityRef }
import extdeps.ampere.mt_collins_getting_started_guide.subject { mt_collins_gsg_authority }
import extdeps.ampere.mt_collins_product_brief.subject { MtCollinsPublicProductBrief, mt_collins_public_product_brief }
import extdeps.ampere.mt_collins_product_brief.platform { mt_collins_product_brief_authority }
import extdeps.board_soc { BoardSocEdge }
import extdeps.cpu.ampere { ampere_altra_soc_family, ampere_altra_max_soc_family }
import std.decl_ref { decl_ref }
import extdeps.external_authority { FactCitation }
import std.algebra { FreeSemigroup }

data extdeps_external_authority_anchor: ExternalAuthority = mt_collins_gsg_authority

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ampere.mt_collins_board",
      decl_name: "mt_collins_board",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE MT. COLLINS BOARD AS A SUBJECT, joining the two Ampere documents that already own its facts
// rather than restating either: the Getting Started Guide (figures, orientation) and the public
// product brief. A board-grain subject exists so a bound host's board can reach its per-board
// authority by reference instead of through a closed enum.
type MtCollinsBoard {
  getting_started_guide: ExternalAuthority
  product_brief: MtCollinsPublicProductBrief
}

data mt_collins_board: MtCollinsBoard = MtCollinsBoard {
  getting_started_guide: mt_collins_gsg_authority,
  product_brief: mt_collins_public_product_brief,
}

data mt_collins_board_authority: BoardAuthorityRef = BoardAuthorityRef {
  subject: DeclarationRef {
    module_path: "extdeps.ampere.mt_collins_board",
    decl_name: "mt_collins_board",
    field: WholeDeclaration
  }
}

// THE BOARD -> SoC EDGE. The Mt. Collins board is designed for the Ampere Altra and Altra Max SoC
// families. It is a grouping fact cited to the public product brief (whose platform note states the
// board is "for Altra and Altra Max"), not an inference, and it names BOTH families: the board
// admits two, and the firmware architecture it establishes is derived from whether the two agree
// (extdeps.board_soc.board_soc_architecture), never defaulted to the first.
data mt_collins_board_soc_edge: BoardSocEdge = BoardSocEdge {
  board: mt_collins_board_authority,
  soc_families: FreeSemigroup {
    head: ampere_altra_soc_family,
    tail: [ampere_altra_max_soc_family],
  },
  citations: [
    FactCitation {
      fact: decl_ref(module_path: "extdeps.ampere.mt_collins_product_brief.platform", decl_name: "platform_note"),
      authority: mt_collins_product_brief_authority,
    },
  ],
}
