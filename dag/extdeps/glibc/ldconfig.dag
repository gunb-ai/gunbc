module extdeps.glibc.ldconfig

import extdeps.exec.program { ProgramIdentity, uncataloged_program }

import std.types { NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }

// ldconfig(8), shipped with the GNU C Library. `-r ROOT` treats ROOT as the root directory: it reads
// ROOT/etc/ld.so.conf and writes ROOT/etc/ld.so.cache for the libraries in ROOT's trusted and
// configured directories -- the effect dpkg's libc ldconfig trigger has on an installed system.
// The program is named by path, so a caller runs the TARGET tree's own ldconfig, whose cache format is
// the one that tree's dynamic loader reads.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man8/ldconfig.8.html"
  }
}

fn ldconfig_program_at(path: NonEmptyStr) -> ProgramIdentity = uncataloged_program(invocation: path)

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.glibc.ldconfig",
      decl_name: "ldconfig_program_at",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

fn ldconfig_root_command(ldconfig: String, root: String) -> ArgvCommand {
  argv_command(program: ldconfig_program_at(path: ldconfig as NonEmptyStr), arguments: ["-r", root])
}
