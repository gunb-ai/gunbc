module extdeps.uri.percent_encoding

import std.optional { Absent, Optional, Present }
import std.types { NonEmptyStr, List }
import std.error_primitives { Ok, Err }
import std.unicode.scalar { from_code_point, scalar_of_code_point, not_unicode_scalar_code_point, SurrogateCodePoint, CodePointOutOfRange }
import std.bytes { bytes_octets, utf8_encode_bytes }
import std.encoding { utf8_decode_octets }
import std.coercion { unicode_scalar_fold }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.host_text { chars }
import std.algebra { collection_concat_shape, collection_map_shape, collection_join_shape, list_push }

// RFC 3986 (STD 66, January 2005), section 2.1 Percent-Encoding.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc3986#section-2.1"
  }
}

// This module is NOT imported by extdeps.uri: that root carries the Uri anchor type every extdeps
// authority cites, so std.encoding reaches it, and this module imports std.encoding. extdeps.uri
// importing this module would close the cycle.

// RFC 3986 section 2.1 percent-encoding (https://www.rfc-editor.org/rfc/rfc3986#section-2.1)
// realized by extdeps.uri.percent_encoding uri_percent_encode_* over UriUnicodeScalar / UriUtf8Octet. RFC 3986
// section 3.3 path grammar is cited at extdeps.uri_path extdeps_external_authority_anchor — same
// specification, distinct section facts, no parallel section module. UriUnicodeScalar { cp } is the
// raw carrier; UriValidatedScalar is sole_constructor with admitted_cp: Int and is minted only by
// uri_validated_scalar_construction (scalar-range and surrogate checks live in that constructor).
// uri_percent_encode_admitted_scalar_wire accepts UriValidatedScalar only.

type UriHexNibble
  = UriNibble0
  | UriNibble1
  | UriNibble2
  | UriNibble3
  | UriNibble4
  | UriNibble5
  | UriNibble6
  | UriNibble7
  | UriNibble8
  | UriNibble9
  | UriNibbleA
  | UriNibbleB
  | UriNibbleC
  | UriNibbleD
  | UriNibbleE
  | UriNibbleF

type UriHexNibbleConstruction
  = UriHexNibbleConstructed(UriHexNibble)
  | UriHexNibbleOutOfRange { digit: Int }

type UriUnicodeScalar { cp: Int }

type UriValidatedScalar sole_constructor { admitted_cp: Int }

type UriValidatedScalarConstruction
  = UriValidatedScalarConstructed(UriValidatedScalar)
  | UriValidatedScalarSurrogateRefused { cp: Int }
  | UriValidatedScalarOutOfRangeRefused { cp: Int }

type UriUnicodeScalarConstruction
  = UriUnicodeScalarConstructed(UriValidatedScalar)
  | UriUnicodeScalarSurrogateRefused { cp: Int }
  | UriUnicodeScalarOutOfRangeRefused { cp: Int }

type UriUtf8Octet { byte: Int }

type UriUtf8OctetConstruction
  = UriUtf8OctetConstructed(UriUtf8Octet)
  | UriUtf8OctetOutOfRangeRefused { value: Int }

type UriPercentOctetWire
  = UriPercentOctetEncoded { wire: String }
  | UriPercentOctetNibbleOutOfRange { digit: Int }

type UriPercentEncodeFoldState
  = UriPercentEncodeBuilding { wire: String }
  | UriPercentEncodeRefused { cause: UriPercentEncodeRefusalCause }

type UriPercentEncodeRefusalCause
  = UriPercentEncodeHexNibbleOutOfRange { digit: Int }
  | UriPercentEncodeSurrogateScalarRefused { cp: Int }
  | UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: Int }
  | UriPercentEncodeUtf8OctetOutOfRangeRefused { value: Int }
  | UriPercentEncodeEmptyInputRefused

type UriPercentEncodeComponent
  = UriPercentComponentEncoded(NonEmptyStr)
  | UriPercentComponentRefused { cause: UriPercentEncodeRefusalCause }

fn uri_component_is_unreserved(cp: Int) -> Bool {
  (cp >= 48 && cp <= 57)
    || (cp >= 65 && cp <= 90)
    || (cp >= 97 && cp <= 122)
    || cp == 45
    || cp == 46
    || cp == 95
    || cp == 126
}

fn uri_hex_nibble_construction(d: Int) -> UriHexNibbleConstruction {
  if d == 0 {
    UriHexNibbleConstructed(UriNibble0)
  } else if d == 1 {
    UriHexNibbleConstructed(UriNibble1)
  } else if d == 2 {
    UriHexNibbleConstructed(UriNibble2)
  } else if d == 3 {
    UriHexNibbleConstructed(UriNibble3)
  } else if d == 4 {
    UriHexNibbleConstructed(UriNibble4)
  } else if d == 5 {
    UriHexNibbleConstructed(UriNibble5)
  } else if d == 6 {
    UriHexNibbleConstructed(UriNibble6)
  } else if d == 7 {
    UriHexNibbleConstructed(UriNibble7)
  } else if d == 8 {
    UriHexNibbleConstructed(UriNibble8)
  } else if d == 9 {
    UriHexNibbleConstructed(UriNibble9)
  } else if d == 10 {
    UriHexNibbleConstructed(UriNibbleA)
  } else if d == 11 {
    UriHexNibbleConstructed(UriNibbleB)
  } else if d == 12 {
    UriHexNibbleConstructed(UriNibbleC)
  } else if d == 13 {
    UriHexNibbleConstructed(UriNibbleD)
  } else if d == 14 {
    UriHexNibbleConstructed(UriNibbleE)
  } else if d == 15 {
    UriHexNibbleConstructed(UriNibbleF)
  } else {
    UriHexNibbleOutOfRange { digit: d }
  }
}

fn uri_hex_nibble_wire(nibble: UriHexNibble) -> String {
  match nibble {
    UriNibble0 => "0"
    UriNibble1 => "1"
    UriNibble2 => "2"
    UriNibble3 => "3"
    UriNibble4 => "4"
    UriNibble5 => "5"
    UriNibble6 => "6"
    UriNibble7 => "7"
    UriNibble8 => "8"
    UriNibble9 => "9"
    UriNibbleA => "A"
    UriNibbleB => "B"
    UriNibbleC => "C"
    UriNibbleD => "D"
    UriNibbleE => "E"
    UriNibbleF => "F"
  }
}

// THE SCALAR PREDICATE IS std.unicode.scalar's, NOT RESTATED HERE: a second range test would be a
// second authority for the Unicode scalar values (section 3.9, D76), so the two refusals below map
// that one authority's NotUnicodeScalar arms.
fn uri_validated_scalar_construction(cp: Int) -> UriValidatedScalarConstruction {
  match scalar_of_code_point(cp: cp) {
    Ok { value: c } => UriValidatedScalarConstructed(UriValidatedScalar { admitted_cp: c })
    Err { value: SurrogateCodePoint { code_point: c } } => UriValidatedScalarSurrogateRefused { cp: c }
    Err { value: CodePointOutOfRange { code_point: c } } => UriValidatedScalarOutOfRangeRefused { cp: c }
  }
}

fn uri_unicode_scalar_construction(cp: Int) -> UriUnicodeScalarConstruction {
  match uri_validated_scalar_construction(cp: cp) {
    UriValidatedScalarSurrogateRefused { cp: c } =>
      UriUnicodeScalarSurrogateRefused { cp: c }
    UriValidatedScalarOutOfRangeRefused { cp: c } =>
      UriUnicodeScalarOutOfRangeRefused { cp: c }
    UriValidatedScalarConstructed(scalar) =>
      UriUnicodeScalarConstructed(scalar)
  }
}

fn uri_utf8_octet_construction(byte: Int) -> UriUtf8OctetConstruction {
  if byte >= 0 && byte <= 255 {
    UriUtf8OctetConstructed(UriUtf8Octet { byte: byte })
  } else {
    UriUtf8OctetOutOfRangeRefused { value: byte }
  }
}

fn uri_percent_octet_wire(octet: UriUtf8Octet) -> UriPercentOctetWire {
  match uri_hex_nibble_construction(d: octet.byte / 16) {
    UriHexNibbleOutOfRange { digit: d } => UriPercentOctetNibbleOutOfRange { digit: d }
    UriHexNibbleConstructed(hi) =>
      match uri_hex_nibble_construction(d: octet.byte % 16) {
        UriHexNibbleOutOfRange { digit: d } => UriPercentOctetNibbleOutOfRange { digit: d }
        UriHexNibbleConstructed(lo) =>
          UriPercentOctetEncoded {
            wire: concat("%", concat(uri_hex_nibble_wire(nibble: hi), uri_hex_nibble_wire(nibble: lo))),
          }
      }
  }
}

// One octet of a scalar's UTF-8 form (from the one UTF-8 encoder, std.bytes utf8_encode_bytes) appended
// to the accumulated wire as "%" HEXDIG HEXDIG; a refused state stays refused.
fn uri_percent_encode_octet_step(state: UriPercentEncodeFoldState, o: Int) -> UriPercentEncodeFoldState {
  match state {
    UriPercentEncodeRefused { cause: k } => UriPercentEncodeRefused { cause: k }
    UriPercentEncodeBuilding { wire: prefix } =>
      match uri_utf8_octet_construction(byte: o) {
        UriUtf8OctetOutOfRangeRefused { value: v } =>
          UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
        UriUtf8OctetConstructed(octet) =>
          match uri_percent_octet_wire(octet: octet) {
            UriPercentOctetEncoded { wire: w } => UriPercentEncodeBuilding { wire: concat(prefix, w) }
            UriPercentOctetNibbleOutOfRange { digit: d } =>
              UriPercentEncodeRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: d } }
          }
      }
  }
}

fn uri_percent_encode_unicode_scalar(scalar: UriUnicodeScalar) -> UriPercentEncodeFoldState {
  match uri_unicode_scalar_construction(cp: scalar.cp) {
    UriUnicodeScalarSurrogateRefused { cp: c } =>
      UriPercentEncodeRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: c } }
    UriUnicodeScalarOutOfRangeRefused { cp: c } =>
      UriPercentEncodeRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: c } }
    UriUnicodeScalarConstructed(validated) =>
      uri_percent_encode_admitted_scalar_wire(scalar: validated)
  }
}

fn uri_validated_scalar_code_point(scalar: UriValidatedScalar) -> Int {
  scalar.admitted_cp
}

fn uri_percent_encode_admitted_scalar_wire(scalar: UriValidatedScalar) -> UriPercentEncodeFoldState {
  let cp = uri_validated_scalar_code_point(scalar: scalar)
  match from_code_point(cp: cp) {
    Err { value: SurrogateCodePoint { code_point: c } } =>
      UriPercentEncodeRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: c } }
    Err { value: CodePointOutOfRange { code_point: c } } =>
      UriPercentEncodeRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: c } }
    Ok { value: text } =>
      if uri_component_is_unreserved(cp: cp) {
        UriPercentEncodeBuilding { wire: text }
      } else {
        fold(
          bytes_octets(b: utf8_encode_bytes(s: text)),
          init: UriPercentEncodeBuilding { wire: "" },
          f: (acc, o) => uri_percent_encode_octet_step(state: acc, o: o)
        )
      }
  }
}

fn uri_percent_encode_code_point(cp: Int) -> UriPercentEncodeComponent {
  match uri_unicode_scalar_construction(cp: cp) {
    UriUnicodeScalarSurrogateRefused { cp: c } =>
      UriPercentComponentRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: c } }
    UriUnicodeScalarOutOfRangeRefused { cp: c } =>
      UriPercentComponentRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: c } }
    UriUnicodeScalarConstructed(validated) =>
      match uri_percent_encode_admitted_scalar_wire(scalar: validated) {
        UriPercentEncodeRefused { cause: cause } => UriPercentComponentRefused { cause: cause }
        UriPercentEncodeBuilding { wire: wire } => UriPercentComponentEncoded(wire as NonEmptyStr)
      }
  }
}

fn uri_percent_encode_component(value: NonEmptyStr) -> UriPercentEncodeComponent {
  uri_percent_encode_code_points(code_points: (value as String) |> chars)
}

fn uri_percent_encode_scalar_fragment(cp: Int) -> UriPercentEncodeFoldState {
  match uri_unicode_scalar_construction(cp: cp) {
    UriUnicodeScalarSurrogateRefused { cp: c } =>
      UriPercentEncodeRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: c } }
    UriUnicodeScalarOutOfRangeRefused { cp: c } =>
      UriPercentEncodeRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: c } }
    UriUnicodeScalarConstructed(scalar) =>
      uri_percent_encode_admitted_scalar_wire(scalar: scalar)
  }
}

type UriPercentEncodeScalarOutcome
  = UriPercentEncodeScalarEncoded { wire: String }
  | UriPercentEncodeScalarRefused { cause: UriPercentEncodeRefusalCause }

fn uri_percent_encode_scalar_outcome(cp: Int) -> UriPercentEncodeScalarOutcome {
  match uri_percent_encode_scalar_fragment(cp: cp) {
    UriPercentEncodeRefused { cause: cause } =>
      UriPercentEncodeScalarRefused { cause: cause }
    UriPercentEncodeBuilding { wire: wire } =>
      UriPercentEncodeScalarEncoded { wire: wire }
  }
}

fn uri_percent_encode_outcomes_first_refusal(
  outcomes: List<UriPercentEncodeScalarOutcome>,
) -> Optional<UriPercentEncodeRefusalCause> {
  fold(
    outcomes,
    init: Absent,
    f: fn(acc, outcome) {
      match acc {
        Present { value: _ } => acc
        Absent =>
          match outcome {
            UriPercentEncodeScalarRefused { cause: cause } => Present { value: cause }
            UriPercentEncodeScalarEncoded { wire: _ } => Absent
          }
      }
    },
  )
}

fn uri_percent_encode_outcome_wires(outcomes: List<UriPercentEncodeScalarOutcome>) -> List<String> {
  fold(
    outcomes,
    init: [],
    f: fn(wires, outcome) {
      match outcome {
        UriPercentEncodeScalarEncoded { wire: wire } => wires |> list_push(wire)
        UriPercentEncodeScalarRefused { cause: _ } => wires
      }
    },
  )
}

fn uri_percent_encode_code_points(code_points: List<Int>) -> UriPercentEncodeComponent {
  if code_points |> length == 0 {
    UriPercentComponentRefused { cause: UriPercentEncodeEmptyInputRefused }
  } else {
    let outcomes = code_points |> map(cp => uri_percent_encode_scalar_outcome(cp: cp))
    match uri_percent_encode_outcomes_first_refusal(outcomes: outcomes) {
      Present { value: cause } => UriPercentComponentRefused { cause: cause }
      Absent =>
        UriPercentComponentEncoded(
          join(uri_percent_encode_outcome_wires(outcomes: outcomes), "") as NonEmptyStr,
        )
    }
  }
}

// PERCENT-DECODE (RFC 3986 section 2.1), the inverse of uri_percent_encode_code_points. Every
// "%" HEXDIG HEXDIG triplet decodes to one octet -- either hex case, since RFC 3986 section 2.1 makes
// the digits case-insensitive -- and a literal character contributes its own UTF-8 octets. The
// octet sequence is then decoded by THE ONE UTF-8 decoder, std.encoding utf8_decode_octets (RFC
// 3629: shortest form, no surrogate, at most U+10FFFF). There is no second UTF-8 fold here: it was
// local only because extdeps.uri, which std.encoding reaches through its authority anchors, carried
// this codec, and this module is not reachable from std.encoding. A "%" not followed by two hex
// digits, or octets that are not UTF-8, REFUSE with their cause; a value that still carries an
// escape is never returned as decoded. Which characters a consumer admits in the decoded value is
// that consumer's policy, not this one.
type UriPercentDecodeRefusalCause
  = UriPercentDecodeTruncatedEscape
  | UriPercentDecodeNonHexDigit { cp: Int }
  | UriPercentDecodeNotUnicodeScalar { cp: Int }
  | UriPercentDecodeNotUtf8

type UriPercentDecodeComponent
  = UriPercentComponentDecoded { value: String }
  | UriPercentComponentDecodeRefused { cause: UriPercentDecodeRefusalCause }

// Octets are accumulated in REVERSE (one cons each, one reverse at the end), so decoding is linear
// in the input rather than copying the accumulator per character.
type UriPercentDecodeFold
  = UriDecodeText { octets_rev: List<Int> }
  | UriDecodeAfterPercent { octets_rev: List<Int> }
  | UriDecodeAfterHighNibble { octets_rev: List<Int>, high: Int }
  | UriDecodeRefused { cause: UriPercentDecodeRefusalCause }

fn uri_hex_digit_value(cp: Int) -> Int? {
  if cp >= 48 && cp <= 57 { Present { value: cp - 48 } }
  else { if cp >= 65 && cp <= 70 { Present { value: cp - 55 } }
  else { if cp >= 97 && cp <= 102 { Present { value: cp - 87 } }
  else { none } } }
}

// A literal character's UTF-8 octets, from the one UTF-8 encoder (std.bytes utf8_encode_bytes),
// prepended in reverse.
fn uri_decode_literal(octets_rev: List<Int>, cp: Int) -> UriPercentDecodeFold {
  match from_code_point(cp: cp) {
    Err { value: n } => UriDecodeRefused { cause: UriPercentDecodeNotUnicodeScalar { cp: not_unicode_scalar_code_point(n: n) } }
    Ok { value: text } =>
      UriDecodeText { octets_rev: fold(bytes_octets(b: utf8_encode_bytes(s: text)), init: octets_rev, f: (acc, o) => Cons { head: o, tail: acc }) }
  }
}

fn uri_percent_decode_step(state: UriPercentDecodeFold, cp: Int) -> UriPercentDecodeFold {
  match state {
    UriDecodeRefused { cause: k } => UriDecodeRefused { cause: k }
    UriDecodeText { octets_rev: out } =>
      if cp == 37 { UriDecodeAfterPercent { octets_rev: out } }
      else { uri_decode_literal(octets_rev: out, cp: cp) }
    UriDecodeAfterPercent { octets_rev: out } =>
      match uri_hex_digit_value(cp: cp) {
        Absent => UriDecodeRefused { cause: UriPercentDecodeNonHexDigit { cp: cp } }
        Present { value: h } => UriDecodeAfterHighNibble { octets_rev: out, high: h }
      }
    UriDecodeAfterHighNibble { octets_rev: out, high: h } =>
      match uri_hex_digit_value(cp: cp) {
        Absent => UriDecodeRefused { cause: UriPercentDecodeNonHexDigit { cp: cp } }
        Present { value: l } => UriDecodeText { octets_rev: Cons { head: h * 16 + l, tail: out } }
      }
  }
}

fn uri_percent_decode_component(value: String) -> UriPercentDecodeComponent {
  match fold(value |> chars, init: UriDecodeText { octets_rev: [] }, f: (state, cp) => uri_percent_decode_step(state: state, cp: cp)) {
    UriDecodeRefused { cause: k } => UriPercentComponentDecodeRefused { cause: k }
    UriDecodeAfterPercent { octets_rev: _ } => UriPercentComponentDecodeRefused { cause: UriPercentDecodeTruncatedEscape }
    UriDecodeAfterHighNibble { octets_rev: _, high: _ } => UriPercentComponentDecodeRefused { cause: UriPercentDecodeTruncatedEscape }
    UriDecodeText { octets_rev: out } =>
      match utf8_decode_octets(octets: reverse(out)) {
        Absent => UriPercentComponentDecodeRefused { cause: UriPercentDecodeNotUtf8 }
        // utf8_decode_octets yields List<Char> that passed its own admission, so the total
        // unfold spells them; no refusal exists to route here (review 79132).
        Present { value: scalars } => UriPercentComponentDecoded { value: unicode_scalar_fold(xs: scalars) }
      }
  }
}
