// requirements/cuda.txt at 8d09804c877c48165c6ba69bc9dc02d09bae0b83 (2026-09-04) states
// `flashinfer-python==0.6.18` and `flashinfer-cubin==0.6.18`, and docker/Dockerfile at the same
// revision declares `ARG FLASHINFER_VERSION=0.6.18`. The GLM-5.3-Flash SM121 base image's recorded
// build arguments carry exactly this spelling; the .post1 row above is a different pin at a later
// revision, not a correction of this one.
data flashinfer_0_6_18_version: NonEmptyStr = "0.6.18" as NonEmptyStr

// THE 0.7.0.dev20260910 NIGHTLY, WHICH THE GLM-5.3-FLASH SM121 IMAGE FORCE-REINSTALLS OVER THE
// BASE'S 0.6.18. The GLM native arm's serving image (the local build whose base is upstream vLLM
// 8d09804c877c48165c6ba69bc9dc02d09bae0b83) carries these three wheels and pip-installs them
// --no-deps --force-reinstall; the base's 0.6.18 predates the sparse-MLA page-table fix the model
// needs. A nightly is a published build of a dated snapshot, not a release: the channel is the
// nightly index, and the row stays honest about what a nightly is -- it may be pruned upstream, in
// which case the digest-pinned wheel in the image is the surviving artifact and this row's index
// citation is its provenance, not its availability guarantee.
data flashinfer_0_7_0_dev20260910_version: NonEmptyStr = "0.7.0.dev20260910" as NonEmptyStr

data flashinfer_0_7_0_dev20260910: FlashInferAcquisition = FlashInferPublishedRelease {
