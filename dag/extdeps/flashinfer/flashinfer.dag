// runtime parameter, including the 32-token extra pages a DeepSeek V4.1 ratio-2 layer takes once the
// kernel page is 64 tokens (vllm-project/vllm#57292, #56461, #59203). v0.7.0 and v0.7.0.post1 predate it
// (compare eb5f05be1f...v0.7.0.post1: diverged); v0.7.1rc1 (GitHub release, published 2026-09-30) contains
// it (compare eb5f05be1f...v0.7.1rc1: ahead 221, behind 0), read 2026-10-01. It is a RELEASE CANDIDATE,
// adopted by operator ruling 2026-10-01 for the V4.1 GB10 launch; 0.7.1 final replaces it when published.
data flashinfer_0_7_1rc1_version: NonEmptyStr = "0.7.1rc1" as NonEmptyStr

data flashinfer_0_7_1rc1: FlashInferAcquisition = FlashInferPublishedRelease {
