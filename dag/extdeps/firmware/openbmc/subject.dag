module extdeps.firmware.openbmc.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https,
    locator: "www.openbmc.org/"
  }
}

data openbmc_subject_note: String = "OPENBMC, THE BASEBOARD MANAGEMENT FIRMWARE STACK. Fetched live 2026-08-12: the page states the project community 'is supporting an open source BMC firmware stack that will work across heterogeneous systems, including enterprise, HPC, telco, and cloud-scale data centers'. It is the management controller's own software, running on its own processor, updated on its own schedule and reachable while the host is off — which is why it is a separate role in the board's firmware contract rather than a stage of host boot. This repository already carries OpenBMC-shaped facts under extdeps.bmc; this module is the SUBJECT those facts are about. NAMING, AND A PRE-EXISTING FORK THIS MODULE DOES NOT DEEPEN: the type here is OpenBmcProject, and std.bmc separately carries OpenBmc as the sole arm of BmcFirmwareFamily — a closed enum arm naming the very project this module cites, which is the section 3 nickname pattern and which predates this module by a long way. The two are not two spellings of one thing in this file: this is a subject marker, in the shape every cited subject in extdeps uses, and that is an enum arm standing in for the subject that now exists. The consolidation is real work with roughly thirty-five call sites across fifteen files and it changes a content-hash atom, so it is named here as debt already in the tree rather than introduced by it, and no dissolution obligation is minted for something this module did not create. What IS fixed here is that nothing gained a third spelling."

type OpenBmcProject
  = | OpenBmcStack

data openbmc_stack: OpenBmcProject = OpenBmcStack

data openbmc_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.firmware.openbmc.subject",
      decl_name: "openbmc_stack",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = openbmc_model_scope
