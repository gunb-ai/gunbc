module extdeps.firmware.trusted_firmware_a.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https,
    locator: "www.trustedfirmware.org/projects/tf-a/"
  }
}

data trusted_firmware_a_subject_note: String = "TRUSTED FIRMWARE-A, THE SECURE-WORLD BOOT CHAIN. Fetched live 2026-08-12: the project page states TF-A 'provides a reference implementation of secure world software for Armv7-A, Armv8-A and Armv9-A processors'. WHY IT IS ITS OWN SUBJECT: it is separately governed and separately versioned from the UEFI implementation that runs after it and from the system control processor firmware that runs before it, so an Ampere platform's boot chain is several upstreams in sequence rather than one 'firmware version'. The board article references this as a ROLE; what version a given host runs is a fleet observation and is not a fact this module owns. NOT MODELLED HERE: the boot-stage decomposition (BL1/BL2/BL31) — the cited page names no stages, and naming them from memory would be exactly the fabricated citation this repository refuses."

type TrustedFirmwareA
  = | TrustedFirmwareASecureWorld

data trusted_firmware_a_secure_world: TrustedFirmwareA = TrustedFirmwareASecureWorld

data trusted_firmware_a_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.firmware.trusted_firmware_a.subject",
      decl_name: "trusted_firmware_a_secure_world",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = trusted_firmware_a_model_scope
