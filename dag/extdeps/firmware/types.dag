module extdeps.firmware.types

import std.nat { Nat }
import std.types { EpochMs, NonEmptyStr }
import extdeps.crypto.hash { Digest }
import extdeps.boards.types { BaseboardModel }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Firmware"
  }
}

// A version triple is one concept. It was previously spelled
// BmcFirmwareSemanticVersion inside the BMC module, which made the SAME
// concept unnameable for host firmware without minting a second name for
// it (DESIGN section 3, the CpuArchitecture/TargetArchitecture class).
// The BMC carrier now imports this one.
type FirmwareSemanticVersion {
  major: Nat
  minor: Nat
  patch: Nat
}

fn firmware_semantic_version(
  major: Nat,
  minor: Nat,
  patch: Nat,
) -> FirmwareSemanticVersion {
  FirmwareSemanticVersion {
    major: major,
    minor: minor,
    patch: patch,
  }
}

// The two independently versioned, independently flashed firmware subjects
// on one baseboard. They are NOT one subject at two versions: the BMC runs
// continuously and serves the update surface, while host firmware executes
// only during host boot and owns DRAM training. A single "firmware version"
// field cannot express "BMC 3.22.00 and BIOS 3.10" and that is exactly the
// state srv4 is in.
type FirmwareTarget
  = BmcController
  | HostBios

// How a release artifact is applied. The distinction is load-bearing rather
// than cosmetic: the OpenBMC web-UI tar is pushed to the BMC's UpdateService
// over the network, while the Instant Flash ROM is applied from host firmware
// setup and is unreachable while a host fails to POST.
type FirmwareImageKind
  = OpenBmcWebUiTar
  | InstantFlashRom

// A vendor release, cited. image_digest is Optional because a digest this
// repository has not COMPUTED must not be authored: an unverified hex would
// be a fabricated plausible value at exactly the boundary where the wrong
// bytes brick a controller (DESIGN section 5). It is filled by measuring the
// acquired file, never transcribed.
type FirmwareReleaseRow {
  board: BaseboardModel
  target: FirmwareTarget
  version: FirmwareSemanticVersion
  released_on: EpochMs
  image_kind: FirmwareImageKind
  image_uri: Uri
  image_bytes: Nat
  image_digest: Digest?
  release_notes: NonEmptyStr
  // What must already be running before these bytes can be applied. Carried
  // ON the release row so an unappliable push is refused from the catalog,
  // not discovered from a vendor shell script after the upload.
  prerequisite: FirmwarePrerequisite
  authority: ExternalAuthority
}

// A release is not universally applicable to its own board. Vendor packaging
// carries manifest fields that only a NEWER controller understands, so
// "correct image for this board" and "appliable to this host right now" are
// different facts and fusing them is what let a valid image be pushed at a
// host that could never accept it.
//
// RECEIPT (2026-08-11, srv3 192.168.1.192): the BIOS 3.10 OpenBMC tar was
// accepted for transfer by BMC 2.07.00, untarred, and then refused by the
// vendor flash script with "Invalid ExtendedVersion: primary-all. Please check
// MANIFEST file!" — phosphor-image-updater reported "Bios upgrade failed."
// The refusal was clean (no flash write), but it arrived only after a 33 MB
// upload, a host power-off, and a Redfish task that reports Exception with no
// machine-readable cause. srv4 on BMC 3.22.00 accepted the same bytes.
type FirmwarePrerequisite
  = NoFirmwarePrerequisite
  | RequiresMinimumTargetFirmware {
      target: FirmwareTarget,
      minimum: FirmwareSemanticVersion,
    }

type FirmwareApplicabilityVerdict
  = FirmwareApplicable
  | FirmwarePrerequisiteUnmet {
      target: FirmwareTarget,
      minimum: FirmwareSemanticVersion,
      observed: FirmwareSemanticVersion,
    }
  // Fail-closed third arm. An unobserved prerequisite is NOT met: srv3 reports
  // its BIOS version as null through Redfish, so "we could not read it" must
  // refuse rather than collapse into either pole (DESIGN section 5).
  | FirmwarePrerequisiteUnobserved {
      target: FirmwareTarget,
      minimum: FirmwareSemanticVersion,
    }

fn firmware_semantic_version_at_least(
  observed: FirmwareSemanticVersion,
  minimum: FirmwareSemanticVersion,
) -> Bool {
  if observed.major != minimum.major {
    observed.major > minimum.major
  } else if observed.minor != minimum.minor {
    observed.minor > minimum.minor
  } else {
    observed.patch >= minimum.patch
  }
}

fn firmware_release_applicability(
  prerequisite: FirmwarePrerequisite,
  observed: FirmwareSemanticVersion?,
) -> FirmwareApplicabilityVerdict {
  match prerequisite {
    NoFirmwarePrerequisite => FirmwareApplicable
    RequiresMinimumTargetFirmware { target: t, minimum: m } =>
      match observed {
        Absent => FirmwarePrerequisiteUnobserved { target: t, minimum: m }
        Present { value: v } =>
          if firmware_semantic_version_at_least(observed: v, minimum: m) {
            FirmwareApplicable
          } else {
            FirmwarePrerequisiteUnmet { target: t, minimum: m, observed: v }
          }
      }
  }
}
