module extdeps.firmware.kernel_cmdline

import std.types { NonEmptyStr, String, List }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.kernel.org/doc/html/latest/admin-guide/kernel-parameters.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.firmware.kernel_cmdline",
      decl_name: "KernelCmdlineArg",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type KernelCmdlineArg
  = KernelFlag { name: NonEmptyStr }
  | KernelKeyValue { key: NonEmptyStr, value: String }

fn kernel_cmdline_arg_wire(arg: KernelCmdlineArg) -> String {
  match arg {
    KernelFlag { name: n } => n as String
    KernelKeyValue { key: k, value: v } => concat(k as String, concat("=", v))
  }
}

fn kernel_cmdline_render(args: List<KernelCmdlineArg>) -> String {
  join(map(args, a => kernel_cmdline_arg_wire(arg: a)), " ")
}

