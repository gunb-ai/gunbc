module extdeps.firmware.supermicro_ami_aptio_v_post_codes_guide

import std.types { Int, List, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority {
  ExternalAuthority, ExternalModelScope, ExternalSubjectRef, CitedFigureStanding, CitedToAuthority,
}
import extdeps.uri { Uri, Https }
import extdeps.firmware.ami_aptio_status_codes {
  StatusCodeTable, StatusRow, StatusMeaning, Described, OemDefined, ReservedForAmi, ReservedForAsl,
  CheckpointRange, ProgressCode, ErrorCode,
  SecPhase, PeiUpToMemoryDetection, PeiAfterMemoryDetection, DxeUpToBds, BdsPhase, S3ResumePei, RecoveryPei,
}

// SUBJECT: Supermicro's reprint "AMI Aptio V BIOS POST Codes for Supermicro Motherboards User's Guide",
// Manual Revision 1.0b, released August 06, 2024, 14 pages. Its Acknowledgement and p.7 note state that
// the tables are adapted, under AMI's permission, from AMI's "Aptio 5.x Status Codes" Revision 2.04
// dated April 20, 2024; AMI is the sole owner of that content, and the vocabulary and decode live in
// extdeps.firmware.ami_aptio_status_codes. This module is the reprint: one revisioned table.
//
// READ 2026-10-22 from the PDF at the anchor below (text extracted from its page streams). Every row
// is CitedToAuthority through the table's standing; page is the number printed in the page header
// (the PDF's 1-based page index is the same). The document is board-agnostic: it names no board, so
// nothing here says that any Supermicro board's manual points to it, and which board and firmware
// build emits which table is an observation of the consuming layer.
//
// WHAT A ROW IS. A code the extraction shows with an EMPTY description cell (for example 0x12-0x14,
// 0x16-0x18, 0x1A-0x1C, 0x2E, 0x38-0x3A, 0x3C-0x3E, 0x64-0x67, 0x6B-0x6F, 0x73-0x77, 0xB7) is
// NOT a row: the extraction does not establish whether the cell is merged with the row above, so no
// meaning is assigned and the decode refuses NoRowInRange. Neither is 0x00 ("Not used", outside every
// range of the Checkpoint Ranges table), 0x5C kept as its described row with the reserved row
// starting at 0x5D (the source prints 0x5C-0x5F), and 0xDE-0xDF (inside the DXE error range, no row printed).
// The source's own inconsistencies are kept, not resolved: 0xE8 and 0xF8 are printed under the
// S3-resume and recovery ERROR headings but fall in the range table's progress ranges.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.supermicro.com/manuals/other/AMI_AptioV_BIOS_POST_Codes_for_SM_Motherboards.pdf"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.firmware.supermicro_ami_aptio_v_post_codes_guide",
      decl_name: "supermicro_ami_aptio_v_post_codes_guide_table",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data supermicro_aptio_v_guide_standing: CitedFigureStanding = CitedToAuthority {
  authority: extdeps_external_authority_anchor
}

fn described(code: Int, text: NonEmptyStr, page: Int) -> StatusRow {
  StatusRow { first: code, last: code, meaning: Described { description: text }, page: page }
}

fn described_range(first: Int, last: Int, text: NonEmptyStr, page: Int) -> StatusRow {
  StatusRow { first: first, last: last, meaning: Described { description: text }, page: page }
}

fn oem_range(first: Int, last: Int, label: NonEmptyStr, page: Int) -> StatusRow {
  StatusRow { first: first, last: last, meaning: OemDefined { label: label }, page: page }
}

fn ami_reserved_range(first: Int, last: Int, page: Int) -> StatusRow {
  StatusRow { first: first, last: last, meaning: ReservedForAmi, page: page }
}

fn asl_reserved_range(first: Int, last: Int, page: Int) -> StatusRow {
  StatusRow { first: first, last: last, meaning: ReservedForAsl, page: page }
}

// p.7 "Checkpoint Ranges".
data supermicro_aptio_v_guide_ranges: List<CheckpointRange> = [
  CheckpointRange { first: 1, last: 11, phase: SecPhase, kind: ProgressCode },
  CheckpointRange { first: 12, last: 15, phase: SecPhase, kind: ErrorCode },
  CheckpointRange { first: 16, last: 47, phase: PeiUpToMemoryDetection, kind: ProgressCode },
  CheckpointRange { first: 48, last: 79, phase: PeiAfterMemoryDetection, kind: ProgressCode },
  CheckpointRange { first: 80, last: 95, phase: PeiAfterMemoryDetection, kind: ErrorCode },
  CheckpointRange { first: 96, last: 143, phase: DxeUpToBds, kind: ProgressCode },
  CheckpointRange { first: 144, last: 207, phase: BdsPhase, kind: ProgressCode },
  CheckpointRange { first: 208, last: 223, phase: DxeUpToBds, kind: ErrorCode },
  CheckpointRange { first: 224, last: 232, phase: S3ResumePei, kind: ProgressCode },
  CheckpointRange { first: 233, last: 239, phase: S3ResumePei, kind: ErrorCode },
  CheckpointRange { first: 240, last: 248, phase: RecoveryPei, kind: ProgressCode },
  CheckpointRange { first: 249, last: 255, phase: RecoveryPei, kind: ErrorCode },
]

