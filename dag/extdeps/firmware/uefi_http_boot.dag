module extdeps.firmware.uefi_http_boot


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "uefi.org/specs/UEFI/2.10/24_Network_Protocols_HTTP_Boot.html"
  }
}

type UefiHttpBootEntry {
  description: std.types.NonEmptyStr
  boot_file_uri: extdeps.uri.Uri
  interface_name: std.types.NonEmptyStr
}

fn uefi_http_boot_uri_wire(entry: UefiHttpBootEntry) -> String {
  extdeps.uri.uri_wire(uri: entry.boot_file_uri)
}

type UefiHttpBootProvisioning
  = FirmwareHttpBootDhcp
  | BcfgUriDevicePath { device_path: std.types.NonEmptyStr }
