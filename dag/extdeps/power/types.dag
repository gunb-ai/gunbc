type PduCatalogRow {
  model_family: std.types.NonEmptyStr
  manufacturer: Vendor<extdeps.hardware.Hardware>
  rack_units: std.measure.RackUnit
  nominal_supply_voltage: std.measure.Volt
  rated_current: std.measure.Ampere
  outlet_count: Int
  front_outlet_count: Int
  rear_outlet_count: Int
  cord_length: std.measure.Millimeter
}
