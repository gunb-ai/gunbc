module extdeps.power.ti_tps53688


// The TPS53688 datasheet, read 2026-08-14 for its mechanical pages only. The package drawing it
// reprints is RSB0040A, stamped 4215000/A, 08/2016.
data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.ti.com/lit/ds/symlink/tps53688.pdf"
  }
}

// THE SECOND SOURCE THAT ESTABLISHES THE JOIN, cited rather than described. Read 2026-08-14: the
// vendor's orderable part-details listing for TPS53688RSBR gives its package as "WQFN (RSB) 40".
data tps53688rsbr_part_details_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "www.ti.com/product/TPS53688/part-details/TPS53688RSBR"
  }
}

data ti_tps53688_note: String = "THIS ROW IS A MECHANICAL CANDIDATE AND NOT A SELECTED PART. Nothing here says the device suits any board role; a selection is a functional-compatibility join done at the product layer, and this row supplies only the package authority that join consumes. THE PACKAGE IDENTITY IS ESTABLISHED BY TWO CITED READINGS, NOT BY WHERE THE FILE WAS FOUND. The fetched datasheet yielded its mechanical pages cleanly but not its title page, so binding drawing RSB0040A to this device on the strength of the URL alone would have been a fact established by a file's location. The vendor's orderable part-details listing gives TPS53688RSBR as WQFN (RSB) 40, which is the package that drawing describes, and it is carried as a second authority in this module's scope rather than recounted in prose — an earlier revision of this note asserted the confirmation while the scope row listed no second citation, which left the load-bearing part-number-to-drawing join prose-backed. What this row carries is mechanical only: the multiphase controller's electrical facts, its phase count and its SVID and PMBus interfaces are not modelled here and are not implied by its presence."

data tps53688_rsb0040a_drawing: extdeps.land_pattern.types.PackageDrawingRef = extdeps.land_pattern.types.PackageDrawingRef {
  drawing_number: "4215000/A",
  revision_date: "08/2016",
  reprinted_in: extdeps.power.ti_tps53688.extdeps_external_authority_anchor,
}

data tps53688_rsb0040a_body: extdeps.land_pattern.types.PackageBodyDimensions = extdeps.land_pattern.types.PackageBodyDimensions {
  designator: "RSB0040A",
  drawing: tps53688_rsb0040a_drawing,
  terminal_count: 40,
  terminal_pitch: micrometer(count: 400),
  body_length_min: micrometer(count: 4900),
  body_length_max: micrometer(count: 5100),
  body_width_min: micrometer(count: 4900),
  body_width_max: micrometer(count: 5100),
  height_max: micrometer(count: 800),
}

data tps53688_rsb0040a_land_pattern: extdeps.land_pattern.types.VendorRecommendedLandPattern = extdeps.land_pattern.types.VendorRecommendedLandPattern {
  package_designator: "RSB0040A",
  drawing: tps53688_rsb0040a_drawing,
  geometry: extdeps.land_pattern.types.QuadRowLandGeometry {
    lands_per_side: 10,
    pitch: micrometer(count: 400),
    side_span_centre_to_centre: micrometer(count: 4800),
    land_length: micrometer(count: 600),
    land_width: micrometer(count: 200),
    thermal_land_side: Present { value: micrometer(count: 3600) },
  },
}

data tps53688rsbr: extdeps.land_pattern.types.PartMechanicalCandidate = extdeps.land_pattern.types.PartMechanicalCandidate {
  ordering_part_number: "TPS53688RSBR",
  vendor: extdeps.vendor.texas_instruments.texas_instruments,
  body: tps53688_rsb0040a_body,
  land_pattern: tps53688_rsb0040a_land_pattern,
  terminal_indexing: extdeps.land_pattern.types.TerminalIndexingObligation {
    what_is_missing: "the pin-one location, the numbering direction, the top-versus-bottom view convention the drawing is stated in, the terminal-to-land identity relation and the electrical role of any exposed pad, for package RSB0040A. None of those were transcribed and this repository carries no pin-map model to receive them, so this candidate cannot be admitted for footprint realization and a consumer cannot mistake matching counts and pitch for a known pin map",
  },
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.power.ti_tps53688",
      decl_name: "tps53688rsbr",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.power.ti_tps53688.extdeps_external_authority_anchor,
  further_citations: [tps53688rsbr_part_details_authority]
}
