module extdeps.power.eaton_tripp_lite


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "tripplite.eaton.com/product/RS-1215"
  }
}

// The datasheet states the RS-1215 cord length as 15 ft. It is carried as 4572 mm, which is
// exact (1 ft = 304.8 mm). std.measure has one canonical Length carrier and no non-decimal
// foot scale: Measure<Dimension, Scale, Carrier> expresses only decimal and binary scales, so
// a Foot alias at scale One was structurally identical to Millimeter and silently
// interchangeable with it (review 50310).
// RS-1215 and RS-1215-RA differ in outlet geometry. Which one pdu-01 is must come from
// the physical label on the unit; it is an observation of the owned instance, not a fact
// this catalog may author.
data eaton_tripp_lite_rs_1215_family_catalog: extdeps.power.types.PduCatalogRow = extdeps.power.types.PduCatalogRow {
  model_family: "RS-1215",
  manufacturer: extdeps.vendor.eaton.eaton,
  rack_units: std.measure.rack_unit(1),
  nominal_supply_voltage: std.measure.volt(120),
  rated_current: std.measure.ampere(15),
  outlet_count: 12,
  front_outlet_count: 6,
  rear_outlet_count: 6,
  cord_length: std.measure.millimeter(4572),
}

