module extdeps.apple.app_attest

import std.types { NonEmptyStr, String, Int, List, Timestamp }
import std.logic { Bool }
import std.integer { UInt8, QualifiedOctetsReady, QualifiedOctetsRefused }
import std.measure { byte_size_count }
import std.encoding { base64_decode, base64_encode, base64_octets, Standard, UrlSafe }
import std.bytes { bytes_octets, utf8_encode_bytes }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.crypto.sha2 { sha256, sha384 }
import extdeps.crypto.nist_prime_curve { PrimeCurve, curve_ecdsa_verify_octets }
import extdeps.crypto.nist_p256 { p256_curve }
import extdeps.crypto.nist_p384 { p384_curve }
import extdeps.standards.rfc_8949 {
  CborValue, CborDocumentDecoded, CborDocumentRefused, cbor_decode_document, cbor_decode_item, CborDecoded, CborRefused,
  CborMemberFound, CborMemberAbsent, CborMemberDuplicated, CborMemberNotAMap, cbor_map_unique_text_member,
  cbor_byte_string_octets, cbor_text_string_value, cbor_array_items, cbor_unsigned_value,
}
import extdeps.standards.webauthn_authenticator_data {
  AuthenticatorData, AuthenticatorDataDecoded, AuthenticatorDataRefused, decode_authenticator_data,
  AuthenticatorDataPrefix, AuthenticatorDataPrefixDecoded, AuthenticatorDataPrefixRefused, decode_authenticator_data_prefix,
  authenticator_data_prefix_size,
}
import extdeps.standards.x690_der {
  DerContextSpecific, DerElementRead, DerRefused, der_read_element, der_expect_sequence, der_expect, der_value, der_tag_octet_string,
}
import extdeps.standards.rfc_5280 {
  X509Certificate, X509Decoded, X509Refused, decode_certificate,
  x509_extension, X509ExtensionFound, X509ExtensionAbsent, X509ExtensionDuplicated,
  ecdsa_sig_value, EcdsaSigValueRead, EcdsaSigValueRefused, EcdsaSigValueTooWide,
  x509_validity_at, X509ValidAt, X509NotYetValid, X509Expired, X509ValidityUndecodable,
  oid_ecdsa_with_sha256, oid_ecdsa_with_sha384, oid_prime256v1, oid_secp384r1,
}
import extdeps.standards.rfc_7468 { pem_decode, PemDecoded, PemRefused, pem_certificate_label }

// DeviceCheck DCAppAttestService, and Apple's server-side validation procedure for its attestation
// objects. Cited pages: "Establishing your app's integrity", "Validating apps that connect to your
// server", "DCAppAttestService".
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developer.apple.com/documentation/devicecheck/validating-apps-that-connect-to-your-server"
  }
}

// ── What an attestation establishes, and what it does not ────────────────────────────────────
// App Attest generates its OWN P-256 key in the Secure Enclave (generateKey), separate from any
// CryptoKit key, and Apple certifies that key as belonging to a genuine instance of the app with a
// named team id and bundle id on genuine Apple hardware. Two things it does NOT give:
//
//   * It cannot be gated by biometrics -- DCAppAttestService exposes no access-control policy -- so
//     it proves the APP, not the operator. The decision-signing key is the CryptoKit enclave key
//     under extdeps.apple.secure_enclave BiometryCurrentSet.
//   * It certifies nothing about any other key. The link from the attested app to the decision key
//     is made by the enrolment protocol: the clientDataHash the app attests over commits to the
//     decision key and the one-time enrolment code (gunbc.auth.approval_device_redemption).

type AttestKeyId = NonEmptyStr where brand("AttestKeyId")

// Two environments by entitlement (com.apple.developer.devicecheck.appattest-environment), visible
// to the server as the authenticator data's AAGUID: "appattestdevelop" or "appattest" followed by
// seven zero bytes. TestFlight and App Store builds attest in production.
type AppAttestEnvironment
  = AppAttestDevelopment
  | AppAttestProduction

// ── Validation, in Apple's order ─────────────────────────────────────────────────────────────
// The attestation object is CBOR { fmt: "apple-appattest", attStmt: { x5c, receipt }, authData }.
// Apple's current procedure; each failure is its own refusal because each is a different incident.
//
//   1. x5c chains to the Apple App Attestation Root CA
//   2. nonce = SHA256(authData || clientDataHash)
//   3. nonce equals the credential certificate extension OID 1.2.840.113635.100.8.2
//   4. SHA256(credential public key) equals the key id
//   5. authData RP ID hash equals SHA256(App ID) -- App ID prefix, ".", bundle id
//   6. authData counter is 0
//   7. AAGUID names the expected environment
//   8. authData credentialId equals the key id
//   9. apple_validation_category_01 (UInt32, extensions CBOR) names an admitted launch category
//  10. apple_bundle_version_01 (String, extensions CBOR) is the distributed app version
//
// The server then STORES the credential public key and the receipt: the key verifies every later
// assertion, and the receipt is the handle for Apple's fraud-metric call.
type AttestationRefusal
  = AttestationFormatUnexpected { declared: String }
  | AttestationChainUntrusted { detail: String }
  | AttestationNonceMismatch
  | AttestationKeyIdMismatch { declared: AttestKeyId }
  | AttestationAppIdMismatch { expected_app_id: NonEmptyStr }
  | AttestationCounterNonZero { counter: Int }
  | AttestationEnvironmentUnexpected { expected: AppAttestEnvironment }
  | AttestationCredentialIdMismatch { declared: AttestKeyId }
  | AttestationValidationCategoryRefused { category: Int }
  | AttestationValidationCategoryAbsent
  | AttestationBundleVersionAbsent
  | AttestationBundleVersionUnexpected { declared: String }
  | AttestationUndecodable { cause: String }


data app_attest_nonce_extension_oid: NonEmptyStr = "1.2.840.113635.100.8.2"


// ── The trust anchor ─────────────────────────────────────────────────────────────────────────
// Apple App Attestation Root CA, published at apple.com/certificateauthority as PEM and pinned
// here byte for byte: CN=Apple App Attestation Root CA, O=Apple Inc., ST=California; secp384r1
// key; ecdsa-with-SHA384 self-signature. Step 1 of the validation chains x5c to THIS certificate
// and no other; a rotation is a new pinned row, never a fetch. ITS IDENTITY IS A DATA ROW, NOT
// PROSE: apple_app_attestation_root_ca_sha256_hex below is the SHA-256 of the DER these lines
// decode to, and test.claim.x509_rfc5280_witness_test computes the digest over the decoded PEM and
// compares (review 69660 of gunbc#11975), so an edited line reds a claim rather than a comment.
data apple_app_attestation_root_ca_pem_lines: List<String> = [
  "-----BEGIN CERTIFICATE-----",
  "MIICITCCAaegAwIBAgIQC/O+DvHN0uD7jG5yH2IXmDAKBggqhkjOPQQDAzBSMSYw",
  "JAYDVQQDDB1BcHBsZSBBcHAgQXR0ZXN0YXRpb24gUm9vdCBDQTETMBEGA1UECgwK",
  "QXBwbGUgSW5jLjETMBEGA1UECAwKQ2FsaWZvcm5pYTAeFw0yMDAzMTgxODMyNTNa",
  "Fw00NTAzMTUwMDAwMDBaMFIxJjAkBgNVBAMMHUFwcGxlIEFwcCBBdHRlc3RhdGlv",
  "biBSb290IENBMRMwEQYDVQQKDApBcHBsZSBJbmMuMRMwEQYDVQQIDApDYWxpZm9y",
  "bmlhMHYwEAYHKoZIzj0CAQYFK4EEACIDYgAERTHhmLW07ATaFQIEVwTtT4dyctdh",
  "NbJhFs/Ii2FdCgAHGbpphY3+d8qjuDngIN3WVhQUBHAoMeQ/cLiP1sOUtgjqK9au",
  "Yen1mMEvRq9Sk3Jm5X8U62H+xTD3FE9TgS41o0IwQDAPBgNVHRMBAf8EBTADAQH/",
  "MB0GA1UdDgQWBBSskRBTM72+aEH/pwyp5frq5eWKoTAOBgNVHQ8BAf8EBAMCAQYw",
  "CgYIKoZIzj0EAwMDaAAwZQIwQgFGnByvsiVbpTKwSga0kP0e8EeDS4+sQmTvb7vn",
  "53O5+FRXgeLhpJ06ysC5PrOyAjEAp5U4xDgEgllF7En3VcE3iexZZtKeYnpqtijV",
  "oyFraWVIyd/dganmrduC1bmTBGwD",
  "-----END CERTIFICATE-----",
]

fn apple_app_attestation_root_ca_pem() -> String {
  join(apple_app_attestation_root_ca_pem_lines, "\n")
}

// SHA-256 of the root's DER, as `openssl x509 -outform der | sha256sum` reads it from Apple's PEM.
data apple_app_attestation_root_ca_sha256_hex: NonEmptyStr = "1cb9823ba28ba6ad2d33a006941de2ae4f513ef1d4e831b9f7e0fa7b6242c932"

// The credential certificate's nonce extension value is DER: SEQUENCE { [1] EXPLICIT OCTET
// STRING nonce } (Apple, step 3: "the single octet string ... under the sequence"), so the
// extension's OCTET STRING carries a SEQUENCE carrying a context tag carrying the 32 octets.
data app_attest_nonce_extension_context_tag: Int = 1

// THE APP ID IS "<App ID prefix>.<bundle id>". Apple: the prefix is USUALLY the 10-character team
// identifier, and is read from the app's Identifier entry in the developer account -- so it is its
// own fact, not a second name for the team id, and the verifier is configured with it directly.
type AppIdPrefix = NonEmptyStr where brand("AppIdPrefix")

fn app_attest_app_id(prefix: AppIdPrefix, bundle_id: NonEmptyStr) -> NonEmptyStr {
  join([prefix as String, bundle_id as String], ".") as NonEmptyStr
}

// ── Verified facts, minted only at the seam ──────────────────────────────────────────────────
// Same boundary as extdeps.crypto.mac VerifiedMessage: nothing outside this module constructs a
// verified attestation or assertion, and each names what it was verified OVER, so a success cannot
// be paired afterwards with another enrolment's or another request's bytes.
type VerifiedAttestation sole_constructor {
  key_id: AttestKeyId
  public_key_point_b64url: NonEmptyStr
  receipt_b64: NonEmptyStr
  environment: AppAttestEnvironment
  client_data: NonEmptyStr
}

type AttestationVerification
  = AttestationVerified { verified: VerifiedAttestation }
  | AttestationRefused { cause: AttestationRefusal }

fn attestation_verification_from_implementation(
  key_id: AttestKeyId,
  public_key_point_b64url: NonEmptyStr,
  receipt_b64: NonEmptyStr,
  environment: AppAttestEnvironment,
  client_data: NonEmptyStr,
  refusal: AttestationRefusal?,
) -> AttestationVerification {
  match refusal {
    Present { value: r } => AttestationRefused { cause: r }
    Absent => AttestationVerified {
      verified: VerifiedAttestation { key_id: key_id, public_key_point_b64url: public_key_point_b64url, receipt_b64: receipt_b64, environment: environment, client_data: client_data }
    }
  }
}


// ── Assertions ───────────────────────────────────────────────────────────────────────────────
// Each later request carries an assertion: CBOR { signature, authenticatorData } produced by
// generateAssertion(keyId, clientDataHash). Apple's procedure: (1) clientDataHash = SHA256(clientData);
// (2) nonce = SHA256(authenticatorData || clientDataHash); (3) the signature verifies for nonce under
// the STORED public key; (4) the RP ID hash equals SHA256(App ID); (5) the counter exceeds the
// previous assertion's; (6) the embedded challenge matches the one issued; (7) validationCategory
// and (8) bundleVersion, from the extensions CBOR. Only after all eight does Apple call it trusted.
//
// THIS MODULE'S SUCCESS IS NAMED FOR LESS, deliberately: AssertionAuthentic covers steps 1-4, 7 and
// 8 -- the parts a verifier can decide from the assertion, the client data and the stored key.
// Step 5 needs the previous counter and step 6 needs the issued challenge; both are the CONSUMER'S
// state, so the counter is carried out for the consumer to compare (or to state why it does not) and
// the client data is carried out for the consumer to join to its challenge. A value named for full
// trust would claim checks this producer cannot make.
type AssertionRefusal
  = AssertionSignatureInvalid
  | AssertionAppIdMismatch { expected_app_id: NonEmptyStr }
  | AssertionValidationCategoryRefused { category: Int }
  | AssertionValidationCategoryAbsent
  | AssertionBundleVersionAbsent
  | AssertionBundleVersionUnexpected { declared: String }
  | AssertionUndecodable { cause: String }

type AuthenticAssertion sole_constructor {
  key_id: AttestKeyId
  public_key_point_b64url: NonEmptyStr
  counter: Int
  client_data: NonEmptyStr
}

type AssertionVerification
  = AssertionAuthentic { authentic: AuthenticAssertion }
  | AssertionRefused { cause: AssertionRefusal }

fn assertion_verification_from_implementation(
  key_id: AttestKeyId,
  public_key_point_b64url: NonEmptyStr,
  counter: Int,
  client_data: NonEmptyStr,
  refusal: AssertionRefusal?,
) -> AssertionVerification {
  match refusal {
    Present { value: r } => AssertionRefused { cause: r }
    Absent => AssertionAuthentic { authentic: AuthenticAssertion { key_id: key_id, public_key_point_b64url: public_key_point_b64url, counter: counter, client_data: client_data } }
  }
}


// ══ THE VERIFIER FOLDS ═══════════════════════════════════════════════════════════════════════
// Apple's procedure above, executed over the readers: CBOR (extdeps.standards.rfc_8949), the
// authenticator data (webauthn_authenticator_data), DER and X.509 (x690_der, rfc_5280), the pinned
// root (rfc_7468 over apple_app_attestation_root_ca_pem_lines), SHA-256/SHA-384 (crypto.sha2) and
// the two NIST curves (crypto.nist_p256, nist_p384). These are the folds that SUPPLY
// attestation_verification_from_implementation and assertion_verification_from_implementation;
// nothing else does, and the seams keep minting VerifiedAttestation / AuthenticAssertion.
//
// ORDER OF THE CHECKS, and why it is not Apple's list order. The verdict is a conjunction, so the
// order changes only which refusal is reported first, and it is chosen by cost: every structural
// check (decode, nonce, key id, RP ID, counter, AAGUID, credentialId, category, version, names
// and validity of the chain) runs before the two ECDSA verifications of the chain, because one
// interpreted P-384 verification is minutes and gigabytes (gunbc#11645, the roadmap row
// v1-interpreter-p256-verify-cost-shape) and an object that fails a cheap check must not pay for
// the expensive one. Apple's step 1 -- the chain signatures -- is therefore the LAST thing to run.
//
// WHAT THE CALLER SUPPLIES, all of it the caller's own fact: the object as received; the key id
// as the app sent it (standard base64 of 32 octets); the client data the app attested over, which
// the caller hashes here (Apple: clientDataHash = SHA-256 of the challenge); the App ID it is
// configured with (app_attest_app_id); the environment it expects; the instant it observes; and
// the launch categories it admits and the bundle version it distributed, for steps 9 and 10.

data app_attest_format: String = "apple-appattest"
data app_attest_aaguid_development: String = "appattestdevelop"
data app_attest_validation_category_extension_key: String = "apple_validation_category_01"
data app_attest_bundle_version_extension_key: String = "apple_bundle_version_01"

fn app_attest_aaguid_octets(environment: AppAttestEnvironment) -> List<UInt8> {
  match environment {
    AppAttestDevelopment => bytes_octets(b: utf8_encode_bytes(s: app_attest_aaguid_development))
    AppAttestProduction => concat(bytes_octets(b: utf8_encode_bytes(s: "appattest")), [0, 0, 0, 0, 0, 0, 0])
  }
}

type AttestationExpectation {
  key_id: AttestKeyId
  client_data: NonEmptyStr
  app_id: NonEmptyStr
  environment: AppAttestEnvironment
  observed_at: Timestamp
  admitted_validation_categories: List<Int>
  expected_bundle_version: NonEmptyStr
}

fn app_attest_undecodable(cause: String) -> AttestationRefusal {
  AttestationUndecodable { cause: cause }
}

fn app_attest_member(v: CborValue, key: String) -> CborValue? {
  match cbor_map_unique_text_member(v: v, key: key) {
    CborMemberFound { value: m } => Present { value: m }
    _ => none
  }
}

fn app_attest_member_octets(v: CborValue, key: String) -> List<UInt8>? {
  match app_attest_member(v: v, key: key) {
    Absent => none
    Present { value: m } => cbor_byte_string_octets(v: m)
  }
}

// The decoded object's parts, once the shape is established.
type AttestationParts {
  leaf: List<UInt8>
  ca: List<UInt8>
  receipt: List<UInt8>
  auth_data: List<UInt8>
}

type AttestationPartsRead
  = AttestationPartsOk { parts: AttestationParts }
  | AttestationPartsRefused { cause: AttestationRefusal }

fn attestation_parts(object: List<UInt8>) -> AttestationPartsRead {
  match cbor_decode_document(octets: object) {
    CborDocumentRefused { cause: _ } => AttestationPartsRefused { cause: app_attest_undecodable(cause: "attestation object is not one CBOR item") }
    CborDocumentDecoded { value: att } => {
      let fmt = match app_attest_member(v: att, key: "fmt") {
        Absent => ""
        Present { value: f } => match cbor_text_string_value(v: f) {
          Present { value: t } => t
          Absent => ""
        }
      }
      if fmt != app_attest_format { AttestationPartsRefused { cause: AttestationFormatUnexpected { declared: fmt } } }
      else {
        match app_attest_member(v: att, key: "attStmt") {
          Absent => AttestationPartsRefused { cause: app_attest_undecodable(cause: "attStmt absent") }
          Present { value: stmt } =>
            match app_attest_member(v: stmt, key: "x5c") {
              Absent => AttestationPartsRefused { cause: app_attest_undecodable(cause: "x5c absent") }
              Present { value: x5c_v } =>
                match cbor_array_items(v: x5c_v) {
                  Absent => AttestationPartsRefused { cause: app_attest_undecodable(cause: "x5c is not an array") }
                  Present { value: x5c } =>
                    if count(x5c) != 2 { AttestationPartsRefused { cause: AttestationChainUntrusted { detail: "x5c carries " + to_string(count(x5c)) + " certificates, not the credential certificate and the intermediate" } } }
                    else {
                      let leaf = match x5c |> get(0) {
                        null => []
                        c => match cbor_byte_string_octets(v: c) {
                          Present { value: o } => o
                          Absent => []
                        }
                      }
                      let ca = match x5c |> get(1) {
                        null => []
                        c => match cbor_byte_string_octets(v: c) {
                          Present { value: o } => o
                          Absent => []
                        }
                      }
                      match app_attest_member_octets(v: stmt, key: "receipt") {
                        Absent => AttestationPartsRefused { cause: app_attest_undecodable(cause: "receipt absent or not a byte string") }
                        Present { value: receipt } =>
                          match app_attest_member_octets(v: att, key: "authData") {
                            Absent => AttestationPartsRefused { cause: app_attest_undecodable(cause: "authData absent or not a byte string") }
                            Present { value: auth_data } =>
                              if count(leaf) == 0 || count(ca) == 0 { AttestationPartsRefused { cause: app_attest_undecodable(cause: "an x5c member is not a byte string") } }
                              else { AttestationPartsOk { parts: AttestationParts { leaf: leaf, ca: ca, receipt: receipt, auth_data: auth_data } } }
                          }
                      }
                    }
                }
            }
        }
      }
    }
  }
}

// Step 3's extension value: DER SEQUENCE { [1] { OCTET STRING nonce } }.
fn credential_certificate_nonce(leaf: X509Certificate) -> List<UInt8>? {
  match x509_extension(cert: leaf, oid: app_attest_nonce_extension_oid as String) {
    X509ExtensionFound { extension: x } =>
      match der_expect_sequence(octets: x.value, at: 0) {
        DerRefused { cause: _ } => none
        DerElementRead { element: seq } =>
          match der_expect(octets: x.value, at: seq.value_at, class: DerContextSpecific, tag_number: app_attest_nonce_extension_context_tag, constructed: true) {
            DerRefused { cause: _ } => none
            DerElementRead { element: ctx } =>
              match der_read_element(octets: x.value, at: ctx.value_at) {
                DerRefused { cause: _ } => none
                DerElementRead { element: inner } => if inner.tag_number == der_tag_octet_string { Present { value: der_value(octets: x.value, e: inner) } } else { none }
              }
          }
      }
    _ => none
  }
}

fn app_attest_decode_certificate(octets: List<UInt8>, which: String) -> AttestationRefusal? {
  match decode_certificate(octets: octets) {
    X509Decoded { certificate: _ } => none
    X509Refused { cause: _ } => Present { value: AttestationChainUntrusted { detail: which + " certificate does not decode as X.509" } }
  }
}

fn app_attest_certificate(octets: List<UInt8>) -> X509Certificate? {
  match decode_certificate(octets: octets) {
    X509Decoded { certificate: c } => Present { value: c }
    X509Refused { cause: _ } => none
  }
}

fn app_attest_root() -> X509Certificate? {
  match pem_decode(text: apple_app_attestation_root_ca_pem(), label: pem_certificate_label) {
    PemRefused { cause: _ } => none
    PemDecoded { der: der } => app_attest_certificate(octets: der)
  }
}

// One chain link: `subject` signed by `issuer`, under the issuer's key, with the digest the
// subject's signature algorithm names. `none` is an encoding refusal -- an algorithm or curve the
// verifier does not carry, or a signature that is not an ECDSA-Sig-Value for the issuer's width --
// and never a verdict. ITS EVIDENCE: the refusing arms are claimed cheaply over the real leaf
// (test.claim.app_attest_verifier_witness_test); the two verifying links are enrolled there and in
// test.claim.p384_dag_ecdsa_witness_test and are NOT executed on the interpreter, because a P-384
// verification at 16 limbs exceeds what a session container holds (one P-256 verify is 15.5 GiB);
// their executing route is the native gunbc test row the frontier names.
fn chain_link_verifies(subject: X509Certificate, issuer: X509Certificate) -> Bool? {
  let digest = if subject.signature_algorithm == oid_ecdsa_with_sha256 { Present { value: sha256(message: subject.tbs.tbs_octets) } }
    else if subject.signature_algorithm == oid_ecdsa_with_sha384 { Present { value: sha384(message: subject.tbs.tbs_octets) } }
    else { none }
  match digest {
    Absent => none
    Present { value: d } =>
      match issuer.tbs.spki_named_curve {
        Absent => none
        Present { value: curve } =>
          match issuer_curve(named_curve: curve) {
            Absent => none
            Present { value: c } => ecdsa_verifies_on(c: c, key: issuer.tbs.spki_public_key, signature_octets: subject.signature_octets, digest: d)
          }
      }
  }
}

// The issuer's key selects the curve, and the curve row is the one authority for the coordinate
// width the DER SIG-VALUE is read at and the verifier checks (review 69750 of gunbc#11989: a
// `width:` literal beside the curve value that owns it was a second authority for one fact).
fn issuer_curve(named_curve: String) -> PrimeCurve? {
  if named_curve == oid_secp384r1 { Present { value: p384_curve } }
  else if named_curve == oid_prime256v1 { Present { value: p256_curve } }
  else { none }
}

fn ecdsa_verifies_on(c: PrimeCurve, key: List<UInt8>, signature_octets: List<UInt8>, digest: List<UInt8>) -> Bool? {
  match ecdsa_sig_value(octets: signature_octets, width: c.coordinate_octets) {
    EcdsaSigValueRead { r_s_fixed: rs } => curve_ecdsa_verify_octets(c: c, key: key, signature: rs, digest: digest)
    _ => none
  }
}

fn chain_link_refusal(subject: X509Certificate, issuer: X509Certificate, which: String) -> AttestationRefusal? {
  match chain_link_verifies(subject: subject, issuer: issuer) {
    Absent => Present { value: AttestationChainUntrusted { detail: which + " signature is not an admitted encoding for the issuer's key" } }
    Present { value: true } => none
    Present { value: false } => Present { value: AttestationChainUntrusted { detail: which + " signature does not verify under its issuer" } }
  }
}

fn validity_refusal(cert: X509Certificate, observed_at: Timestamp, which: String) -> AttestationRefusal? {
  match x509_validity_at(cert: cert, observed_at: observed_at) {
    X509ValidAt => none
    X509NotYetValid { not_before: nb, observed_at: _ } => Present { value: AttestationChainUntrusted { detail: which + " certificate is not valid before " + nb } }
    X509Expired { not_after: na, observed_at: _ } => Present { value: AttestationChainUntrusted { detail: which + " certificate expired at " + na } }
    X509ValidityUndecodable { text: t } => Present { value: AttestationChainUntrusted { detail: which + " certificate carries an undecodable time " + t } }
  }
}

// Steps 9 and 10 read the authenticator data's extensions map.
fn validation_category_refusal(extensions: CborValue?, admitted: List<Int>) -> AttestationRefusal? {
  match extensions {
    Absent => Present { value: AttestationValidationCategoryAbsent }
    Present { value: ext } =>
      match app_attest_member(v: ext, key: app_attest_validation_category_extension_key) {
        Absent => Present { value: AttestationValidationCategoryAbsent }
        Present { value: v } =>
          match cbor_unsigned_value(v: v) {
            Absent => Present { value: app_attest_undecodable(cause: "apple_validation_category_01 is not a CBOR unsigned integer") }
            Present { value: category } =>
              if any(admitted, a => a == category) { none } else { Present { value: AttestationValidationCategoryRefused { category: category } } }
          }
      }
  }
}

fn bundle_version_refusal(extensions: CborValue?, expected: NonEmptyStr) -> AttestationRefusal? {
  match extensions {
    Absent => Present { value: AttestationBundleVersionAbsent }
    Present { value: ext } =>
      match app_attest_member(v: ext, key: app_attest_bundle_version_extension_key) {
        Absent => Present { value: AttestationBundleVersionAbsent }
        Present { value: v } =>
          match cbor_text_string_value(v: v) {
            Absent => Present { value: app_attest_undecodable(cause: "apple_bundle_version_01 is not a CBOR text string") }
            Present { value: declared } => if declared == (expected as String) { none } else { Present { value: AttestationBundleVersionUnexpected { declared: declared } } }
          }
      }
  }
}

fn first_attestation_refusal(rs: List<AttestationRefusal?>) -> AttestationRefusal? {
  fold(rs, init: none, f: (acc, r) => match acc {
    Present { value: a } => Present { value: a }
    Absent => r
  })
}

fn base64_of(octets: List<UInt8>, url_safe: Bool) -> String? {
  match base64_octets(values: octets) {
    QualifiedOctetsRefused { observed: _ } => none
    QualifiedOctetsReady { value: q } => Present { value: base64_encode(octets: q, variant: if url_safe { UrlSafe } else { Standard }) }
  }
}

// The structural steps (2..10 and the chain's names and validity) over decoded parts; the chain
// signatures are step 1 and run last in verify_attestation.
fn attestation_structural_refusal(parts: AttestationParts, leaf: X509Certificate, ca: X509Certificate, root: X509Certificate, auth: AuthenticatorData, e: AttestationExpectation) -> AttestationRefusal? {
  let key_id_octets = match base64_decode(s: e.key_id as String, variant: Standard) {
    Present { value: o } => o
    Absent => []
  }
  let client_data_hash = sha256(message: bytes_octets(b: utf8_encode_bytes(s: e.client_data as String)))
  let nonce = sha256(message: concat(parts.auth_data, client_data_hash))
  let credential = auth.attested_credential
  first_attestation_refusal(rs: [
    if count(key_id_octets) != 32 { Present { value: AttestationKeyIdMismatch { declared: e.key_id } } } else { none },
    match credential_certificate_nonce(leaf: leaf) {
      Absent => Present { value: AttestationNonceMismatch }
      Present { value: n } => if n == nonce { none } else { Present { value: AttestationNonceMismatch } }
    },
    if sha256(message: leaf.tbs.spki_public_key) == key_id_octets { none } else { Present { value: AttestationKeyIdMismatch { declared: e.key_id } } },
    if auth.rp_id_hash == sha256(message: bytes_octets(b: utf8_encode_bytes(s: e.app_id as String))) { none } else { Present { value: AttestationAppIdMismatch { expected_app_id: e.app_id } } },
    if auth.sign_count == 0 { none } else { Present { value: AttestationCounterNonZero { counter: auth.sign_count } } },
    match credential {
      Absent => Present { value: AttestationCredentialIdMismatch { declared: e.key_id } }
      Present { value: c } => if c.aaguid == app_attest_aaguid_octets(environment: e.environment) { none } else { Present { value: AttestationEnvironmentUnexpected { expected: e.environment } } }
    },
    match credential {
      Absent => Present { value: AttestationCredentialIdMismatch { declared: e.key_id } }
      Present { value: c } => if c.credential_id == key_id_octets { none } else { Present { value: AttestationCredentialIdMismatch { declared: e.key_id } } }
    },
    if leaf.tbs.issuer_octets == ca.tbs.subject_octets { none } else { Present { value: AttestationChainUntrusted { detail: "the credential certificate's issuer is not the intermediate" } } },
    if ca.tbs.issuer_octets == root.tbs.subject_octets { none } else { Present { value: AttestationChainUntrusted { detail: "the intermediate's issuer is not the Apple App Attestation Root CA" } } },
    validity_refusal(cert: leaf, observed_at: e.observed_at, which: "credential"),
    validity_refusal(cert: ca, observed_at: e.observed_at, which: "intermediate"),
    validation_category_refusal(extensions: auth.extensions, admitted: e.admitted_validation_categories),
    bundle_version_refusal(extensions: auth.extensions, expected: e.expected_bundle_version),
  ])
}

// EVERYTHING DECODED ONCE, then carried: the parts, both certificates, the pinned root and the
// authenticator data are read here and handed to the refusal fold and to the success mint alike
// (review 69631 of gunbc#11989: an earlier cut re-decoded the object on the success path, which is
// the shared-ancestor duplication DESIGN §2 names).
type AttestationDecoded {
  parts: AttestationParts
  leaf: X509Certificate
  ca: X509Certificate
  root: X509Certificate
  auth: AuthenticatorData
}

type AttestationDecode
  = AttestationDecodeOk { decoded: AttestationDecoded }
  | AttestationDecodeRefused { cause: AttestationRefusal }

fn decode_attestation(object: List<UInt8>) -> AttestationDecode {
  match attestation_parts(object: object) {
    AttestationPartsRefused { cause: c } => AttestationDecodeRefused { cause: c }
    AttestationPartsOk { parts: parts } =>
      match app_attest_certificate(octets: parts.leaf) {
        Absent => AttestationDecodeRefused { cause: AttestationChainUntrusted { detail: "credential certificate does not decode as X.509" } }
        Present { value: leaf } =>
          match app_attest_certificate(octets: parts.ca) {
            Absent => AttestationDecodeRefused { cause: AttestationChainUntrusted { detail: "intermediate certificate does not decode as X.509" } }
            Present { value: ca } =>
              match app_attest_root() {
                Absent => AttestationDecodeRefused { cause: AttestationChainUntrusted { detail: "the pinned root does not decode" } }
                Present { value: root } =>
                  match decode_authenticator_data(octets: parts.auth_data) {
                    AuthenticatorDataRefused { cause: _ } => AttestationDecodeRefused { cause: app_attest_undecodable(cause: "authData does not decode as WebAuthn authenticator data") }
                    AuthenticatorDataDecoded { data: auth } => AttestationDecodeOk { decoded: AttestationDecoded { parts: parts, leaf: leaf, ca: ca, root: root, auth: auth } }
                  }
              }
          }
      }
  }
}

// The two chain links are SEQUENCED, not listed: a list evaluates both elements, and each is the
// most expensive computation in the corpus, so a refused first link must not buy the second
// (review 69668 of gunbc#11989).
fn attestation_refusal(d: AttestationDecoded, e: AttestationExpectation) -> AttestationRefusal? {
  match attestation_structural_refusal(parts: d.parts, leaf: d.leaf, ca: d.ca, root: d.root, auth: d.auth, e: e) {
    Present { value: r } => Present { value: r }
    Absent =>
      match chain_link_refusal(subject: d.leaf, issuer: d.ca, which: "credential certificate") {
        Present { value: r } => Present { value: r }
        Absent => chain_link_refusal(subject: d.ca, issuer: d.root, which: "intermediate")
      }
  }
}

// THE SUPPLIER of attestation_verification_from_implementation. On success the verified facts
// are the credential certificate's public key (SEC 1 point, base64url), the receipt (base64) and
// the environment the AAGUID named, over exactly the client data supplied.
fn verify_attestation(object: List<UInt8>, e: AttestationExpectation) -> AttestationVerification {
  match decode_attestation(object: object) {
    AttestationDecodeRefused { cause: c } => AttestationRefused { cause: c }
    AttestationDecodeOk { decoded: d } =>
      match attestation_refusal(d: d, e: e) {
        Present { value: r } => AttestationRefused { cause: r }
        Absent =>
          match base64_of(octets: d.leaf.tbs.spki_public_key, url_safe: true) {
            Absent => AttestationRefused { cause: app_attest_undecodable(cause: "credential public key octets are not bytes") }
            Present { value: point } =>
              match base64_of(octets: d.parts.receipt, url_safe: false) {
                Absent => AttestationRefused { cause: app_attest_undecodable(cause: "receipt octets are not bytes") }
                Present { value: receipt } =>
                  attestation_verification_from_implementation(key_id: e.key_id, public_key_point_b64url: point as NonEmptyStr, receipt_b64: receipt as NonEmptyStr, environment: e.environment, client_data: e.client_data, refusal: none)
              }
          }
      }
  }
}

// ── Assertions ───────────────────────────────────────────────────────────────────────────────
// The assertion is CBOR { signature, authenticatorData }. Apple's authenticatorData here is the
// 37-octet prefix -- rpIdHash || flags || counter -- with the AT bit set and no attested data
// (extdeps.apple.app_attest_sample_ios_14_4); when the ED bit is set, an extensions CBOR map
// follows and consumes the rest. Anything else is refused.
type AssertionAuthenticatorData {
  prefix: AuthenticatorDataPrefix
  extensions: CborValue?
}

fn apple_assertion_authenticator_data(octets: List<UInt8>) -> AssertionAuthenticatorData? {
  match decode_authenticator_data_prefix(octets: octets |> take(byte_size_count(b: authenticator_data_prefix_size))) {
    AuthenticatorDataPrefixRefused { cause: _ } => none
    AuthenticatorDataPrefixDecoded { prefix: p } =>
      if count(octets) == byte_size_count(b: authenticator_data_prefix_size) { Present { value: AssertionAuthenticatorData { prefix: p, extensions: none } } }
      else if !p.flags.extension_data_included { none }
      else {
        match cbor_decode_item(octets: octets, at: byte_size_count(b: authenticator_data_prefix_size), depth: 0) {
          CborRefused { cause: _ } => none
          CborDecoded { value: v, next: n } => if n == count(octets) { Present { value: AssertionAuthenticatorData { prefix: p, extensions: Present { value: v } } } } else { none }
        }
      }
  }
}

type AssertionExpectation {
  key_id: AttestKeyId
  public_key_point_b64url: NonEmptyStr
  client_data: NonEmptyStr
  app_id: NonEmptyStr
  admitted_validation_categories: List<Int>
  expected_bundle_version: NonEmptyStr
}

type AssertionParts {
  signature: List<UInt8>
  auth: AssertionAuthenticatorData
  auth_octets: List<UInt8>
}

type AssertionPartsRead
  = AssertionPartsOk { parts: AssertionParts }
  | AssertionPartsRefused { cause: AssertionRefusal }

fn assertion_parts(object: List<UInt8>) -> AssertionPartsRead {
  match cbor_decode_document(octets: object) {
    CborDocumentRefused { cause: _ } => AssertionPartsRefused { cause: AssertionUndecodable { cause: "assertion is not one CBOR item" } }
    CborDocumentDecoded { value: v } =>
      match app_attest_member_octets(v: v, key: "signature") {
        Absent => AssertionPartsRefused { cause: AssertionUndecodable { cause: "signature absent or not a byte string" } }
        Present { value: sig } =>
          match app_attest_member_octets(v: v, key: "authenticatorData") {
            Absent => AssertionPartsRefused { cause: AssertionUndecodable { cause: "authenticatorData absent or not a byte string" } }
            Present { value: ad } =>
              match apple_assertion_authenticator_data(octets: ad) {
                Absent => AssertionPartsRefused { cause: AssertionUndecodable { cause: "authenticatorData is not the 37-octet prefix with optional extensions" } }
                Present { value: auth } => AssertionPartsOk { parts: AssertionParts { signature: sig, auth: auth, auth_octets: ad } }
              }
          }
      }
  }
}

// The assertion's steps 7 and 8 share the attestation's readers; every attestation refusal the
// readers can produce maps to its assertion twin BY NAME, and an undecodable member stays
// undecodable with its cause (review 69702 of gunbc#11989: a wildcard had reported a malformed
// category as absent).
fn assertion_category_refusal(extensions: CborValue?, admitted: List<Int>) -> AssertionRefusal? {
  match validation_category_refusal(extensions: extensions, admitted: admitted) {
    Absent => none
    Present { value: AttestationValidationCategoryAbsent } => Present { value: AssertionValidationCategoryAbsent }
    Present { value: AttestationValidationCategoryRefused { category: c } } => Present { value: AssertionValidationCategoryRefused { category: c } }
    Present { value: AttestationUndecodable { cause: c } } => Present { value: AssertionUndecodable { cause: c } }
    Present { value: other } => Present { value: AssertionUndecodable { cause: "validation category reader produced a refusal outside its contract: " + attestation_refusal_name(r: other) } }
  }
}

fn assertion_version_refusal(extensions: CborValue?, expected: NonEmptyStr) -> AssertionRefusal? {
  match bundle_version_refusal(extensions: extensions, expected: expected) {
    Absent => none
    Present { value: AttestationBundleVersionAbsent } => Present { value: AssertionBundleVersionAbsent }
    Present { value: AttestationBundleVersionUnexpected { declared: d } } => Present { value: AssertionBundleVersionUnexpected { declared: d } }
    Present { value: AttestationUndecodable { cause: c } } => Present { value: AssertionUndecodable { cause: c } }
    Present { value: other } => Present { value: AssertionUndecodable { cause: "bundle version reader produced a refusal outside its contract: " + attestation_refusal_name(r: other) } }
  }
}

fn attestation_refusal_name(r: AttestationRefusal) -> String {
  match r {
    AttestationFormatUnexpected { declared: _ } => "AttestationFormatUnexpected"
    AttestationChainUntrusted { detail: _ } => "AttestationChainUntrusted"
    AttestationNonceMismatch => "AttestationNonceMismatch"
    AttestationKeyIdMismatch { declared: _ } => "AttestationKeyIdMismatch"
    AttestationAppIdMismatch { expected_app_id: _ } => "AttestationAppIdMismatch"
    AttestationCounterNonZero { counter: _ } => "AttestationCounterNonZero"
    AttestationEnvironmentUnexpected { expected: _ } => "AttestationEnvironmentUnexpected"
    AttestationCredentialIdMismatch { declared: _ } => "AttestationCredentialIdMismatch"
    AttestationValidationCategoryRefused { category: _ } => "AttestationValidationCategoryRefused"
    AttestationValidationCategoryAbsent => "AttestationValidationCategoryAbsent"
    AttestationBundleVersionAbsent => "AttestationBundleVersionAbsent"
    AttestationBundleVersionUnexpected { declared: _ } => "AttestationBundleVersionUnexpected"
    AttestationUndecodable { cause: _ } => "AttestationUndecodable"
  }
}

fn first_assertion_refusal(rs: List<AssertionRefusal?>) -> AssertionRefusal? {
  fold(rs, init: none, f: (acc, r) => match acc {
    Present { value: a } => Present { value: a }
    Absent => r
  })
}

// Steps 1-4, 7 and 8 (the module's stated scope for AssertionAuthentic); the counter is carried
// out for the consumer's step 5 and the client data for its step 6. As with attestations the
// P-256 verification (step 3) runs after the structural checks.
fn assertion_refusal(parts: AssertionParts, e: AssertionExpectation) -> AssertionRefusal? {
  match first_assertion_refusal(rs: [
    if parts.auth.prefix.rp_id_hash == sha256(message: bytes_octets(b: utf8_encode_bytes(s: e.app_id as String))) { none } else { Present { value: AssertionAppIdMismatch { expected_app_id: e.app_id } } },
    assertion_category_refusal(extensions: parts.auth.extensions, admitted: e.admitted_validation_categories),
    assertion_version_refusal(extensions: parts.auth.extensions, expected: e.expected_bundle_version),
  ]) {
    Present { value: r } => Present { value: r }
    Absent =>
      match assertion_signature_verifies(parts: parts, e: e) {
        Present { value: true } => none
        Present { value: false } => Present { value: AssertionSignatureInvalid }
        Absent => Present { value: AssertionSignatureInvalid }
      }
  }
}

// Steps 1-3 alone: nonce = SHA-256(authenticatorData || SHA-256(clientData)), and the DER
// signature verifies for it under the stored P-256 key. THE NONCE IS THE SIGNED MESSAGE, NOT THE
// DIGEST: Apple's "signature is valid for nonce" is an ECDSA-with-SHA256 signature over the
// 32-octet nonce, so the curve verifier receives SHA-256(nonce). Established on the sample by
// execution -- the fold first supplied the nonce as the digest and Apple's real signature refused,
// while openssl `dgst -sha256 -verify` over the nonce bytes accepted it. Its own producer so it
// can be claimed over real bytes independently of the structural steps (the sample assertion
// predates the extensions steps 7 and 8 read, so the whole fold refuses on it before this runs).
fn assertion_signature_verifies(parts: AssertionParts, e: AssertionExpectation) -> Bool? {
  let client_data_hash = sha256(message: bytes_octets(b: utf8_encode_bytes(s: e.client_data as String)))
  let nonce = sha256(message: concat(parts.auth_octets, client_data_hash))
  match base64_decode(s: e.public_key_point_b64url as String, variant: UrlSafe) {
    Absent => none
    Present { value: key } =>
      ecdsa_verifies_on(c: p256_curve, key: key, signature_octets: parts.signature, digest: sha256(message: nonce))
  }
}

fn assertion_signature_verifies_for(object: List<UInt8>, e: AssertionExpectation) -> Bool? {
  match assertion_parts(object: object) {
    AssertionPartsRefused { cause: _ } => none
    AssertionPartsOk { parts: parts } => assertion_signature_verifies(parts: parts, e: e)
  }
}

// THE SUPPLIER of assertion_verification_from_implementation: the document is decoded once and
// both the counter and the refusal are read from that decode. A refusal is built as the refusal
// arm directly; the seam is reached only with the facts a success carries, so no stand-in counter
// or key ever exists (review 69652 of gunbc#11989).
fn verify_assertion(object: List<UInt8>, e: AssertionExpectation) -> AssertionVerification {
  match assertion_parts(object: object) {
    AssertionPartsRefused { cause: c } => AssertionRefused { cause: c }
    AssertionPartsOk { parts: parts } =>
      match assertion_refusal(parts: parts, e: e) {
        Present { value: r } => AssertionRefused { cause: r }
        Absent => assertion_verification_from_implementation(key_id: e.key_id, public_key_point_b64url: e.public_key_point_b64url, counter: parts.auth.prefix.sign_count, client_data: e.client_data, refusal: none)
      }
  }
}
