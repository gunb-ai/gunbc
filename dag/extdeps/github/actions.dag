module extdeps.github.actions


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/using-workflows/workflow-syntax-for-github-actions"
  }
}

type GitHubActionsRuntime {
  oidc_request_url_env: std.types.NonEmptyStr
  oidc_request_token_env: std.types.NonEmptyStr
}

data github_actions_runtime: GitHubActionsRuntime = {
  oidc_request_url_env: "ACTIONS_ID_TOKEN_REQUEST_URL"
  oidc_request_token_env: "ACTIONS_ID_TOKEN_REQUEST_TOKEN"
}

data github_ci_event_surface_note: String = "GITHUB_EVENT_NAME and GITHUB_BASE_REF are default environment variables GitHub Actions sets on every job (docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables, read 2026-07-24). GITHUB_EVENT_NAME carries the wire name of the triggering event (the runtime projection of WorkflowTrigger: push / pull_request / workflow_dispatch / schedule / merge_group). GITHUB_BASE_REF carries the base (target) branch name of a pull request — set ONLY on pull_request / pull_request_target events, empty for every other event. extdeps owns these names (the shape GitHub provides); the policy that maps them to a diff baseline is a workflow-layer fact (gunbc.diff_baseline), not modeled here (extdeps must not depend upward — DESIGN §3(c))."

data github_event_name_env: std.types.NonEmptyStr = "GITHUB_EVENT_NAME"

data github_base_ref_env: std.types.NonEmptyStr = "GITHUB_BASE_REF"

data github_event_path_env: std.types.NonEmptyStr = "GITHUB_EVENT_PATH"

data github_event_path_home_note: String = "GITHUB_EVENT_PATH is a GitHub Actions DEFAULT ENVIRONMENT VARIABLE — the path to the file holding the full webhook payload for whatever event triggered the run (docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables, read 2026-08-06). It is therefore a fact about the Actions RUNTIME, exactly like github_event_name_env beside it, and not a fact about any one event. It previously lived in extdeps.github.push_event, which made the push payload reader the authority for a variable that carries the pull_request, schedule, and workflow_run payloads just as much. That homing only looked right while push was the sole reader; adding a second event reader made it a §3 fork in waiting — two modules declaring one upstream name, drifting independently. Moved here rather than copied: push_event and workflow_run_event both import it, and there is exactly one declaration of this name in the tree."

data github_event_name_push: String = "push"

data github_event_name_pull_request: String = "pull_request"

data github_event_name_workflow_dispatch: String = "workflow_dispatch"

data github_event_name_merge_group: String = "merge_group"

data github_event_name_schedule: String = "schedule"

data github_event_name_workflow_run: String = "workflow_run"

data workflow_run_activity_completed: String = "completed"

type Workflow {
  name: String
  on: List<WorkflowTrigger>
  concurrency: ConcurrencySpec?
  jobs: List<Job>

  env: List<extdeps.languages.yaml.types.YamlKeyValue>?
  permissions: WorkflowPermissions?
}

type WorkflowPermissions {
  contents: PermissionLevel?
  pull_requests: PermissionLevel?
  issues: PermissionLevel?
  actions: PermissionLevel?
  id_token: PermissionLevel?
}

type PermissionLevel = PermRead | PermWrite | PermNone

type WorkflowTrigger
  = Push { branches: List<String>, paths: List<String> }
  | PullRequest { branches: List<String>, types: List<PullRequestActivity> }
  | Schedule { cron: extdeps.cron.schedule_model.CronSchedule }
  | WorkflowDispatch { inputs: List<DispatchInput> }
  | WorkflowCall { inputs: List<DispatchInput> }
  | WorkflowRunCompleted { workflows: List<String> }
  | MergeGroup

type PullRequestActivity
  = Opened
  | Synchronize
  | Reopened
  | ReadyForReview
  | Closed

data workflow_run_trigger_citation_note: String = "workflow_run is the event GitHub delivers when a workflow run of ANOTHER workflow reaches a listed activity type (docs.github.com/en/actions/writing-workflows/choosing-when-your-workflow-runs/events-that-trigger-workflows#workflow_run, read 2026-08-06). Two facts about the shape, both load-bearing. THE VARIANT IS COMPLETED-ONLY BY NAME, not by a types field. GitHub documents three activity types (requested, in_progress, completed) and the variant admits exactly one of them, so the activity is carried in the CONSTRUCTOR rather than as a list — a workflow that also wanted `requested` is a different trigger with a different admission story, not a longer list on this one, and an alert holding issues: write must not be able to widen its own activation surface by appending to a list. The day this repo needs a second activity, it is a second variant whose admission is argued separately, and every serializer match answers it fail-closed. THE WORKFLOWS FIELD IS List<String> AND NOT A MINTED WorkflowName. Workflow.name in this module is String, and the workflows filter refers to exactly that name, so a WorkflowName alias would be a second name for one carrier that adds no refinement — the hollow-alias class DESIGN carries as an open construction-wall thread. The referent is the name, so it shares the name's carrier. If Workflow.name ever gains a refinement, this field follows it there rather than being refined separately."

data merge_group_event_citation_note: String = "merge_group is the event GitHub delivers when a merge queue needs checks on a queue-constructed tree (docs.github.com/en/actions/writing-workflows/choosing-when-your-workflow-runs/events-that-trigger-workflows#merge_group, read 2026-07-16). The variant is nullary because checks_requested is the ONLY documented activity type and GitHub's default when the types filter is omitted — a types parameter with exactly one inhabitant carries no information (the phantom-parameter collapse ruling); the day upstream documents a second activity, the field returns as a closed modeled enum and every serializer match must answer it, fail-closed."

type DispatchInput {
  name: String
  description: String?
  required: Bool
  default: String?
  type: DispatchInputType
}

type DispatchInputType
  = InputString
  | InputBoolean
  | InputChoice { options: List<String> }
  | InputEnvironment

type SecretScope = StepScope | JobScope | WorkflowScope

type WorkflowSecret {
  name: std.types.SecretName
  scope: SecretScope
}

type Job {
  id: String
  name: String?
  runner: RunnerSpec
  steps: List<Step>
  needs: List<String>

  env: List<extdeps.languages.yaml.types.YamlKeyValue>?

  outputs: List<extdeps.languages.yaml.types.YamlKeyValue>?
  if_condition: String?
  timeout_minutes: Int?
  continue_on_error: Bool?
  concurrency: ConcurrencySpec?

  permissions: WorkflowPermissions?
}

type CancelInProgressSpec
  = CancelInProgressBool { value: Bool }
  | CancelInProgressExpression { expression: String }

type CancelInProgressWhenQueueMax
  = QueueMaxCancelInProgressFalse
  | QueueMaxCancelInProgressExpression { expression: String }

type ConcurrencySpec
  = ConcurrencyScalar { group: String }
  | ConcurrencyMappingQueueMax {
      group: String

      cancel_in_progress: CancelInProgressWhenQueueMax?
    }
  | ConcurrencyMappingQueueNotMax {
      group: String

      cancel_in_progress: CancelInProgressSpec?

      explicit_single: Unit?
    }

type RunnerSpec
  = HostedRunner { label: RunnerLabel }
  | SelfHosted { labels: List<String> }

  | RunsOnExpression { expression: String }

type RunnerLabel
  = UbuntuLatest
  | Ubuntu2404
  | Ubuntu2404Arm
  | Ubuntu2204
  | UbuntuSlim
  | MacosLatest
  | Macos14
  | WindowsLatest

type Step
  = RunStep {
      name: String?,
      id: String?,
      run: String,
      shell: ShellType?,
      env: List<extdeps.languages.yaml.types.YamlKeyValue>?,
      working_directory: String?,
      if_condition: String?,
      continue_on_error: Bool?,
      timeout_minutes: Int?
    }
  | UsesStep {
      name: String?,
      id: String?,
      uses: ActionRef,

      with: List<extdeps.languages.yaml.types.YamlKeyValue>?,
      env: List<extdeps.languages.yaml.types.YamlKeyValue>?,
      if_condition: String?,
      continue_on_error: Bool?,
      timeout_minutes: Int?
    }

type ShellType = Bash | Sh | Pwsh | extdeps.languages.python.subject.Python | Cmd

type ActionRef {
  owner: String
  repo: String
  ref: String
}

type ArtifactOp
  = Upload { name: String, path: String, retention_days: Int?, if_no_files_found: MissingFilesBehavior }
  | Download { name: String, path: String? }

type MissingFilesBehavior = Warn | ErrorOut | Ignore

