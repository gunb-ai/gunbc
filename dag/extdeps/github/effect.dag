  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/authentication/permissions-required-for-github-apps"
  }
}

data contents_write_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/git/refs#update-a-reference"
  }
}

data workflow_dispatch_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/actions/workflows#create-a-workflow-dispatch-event"
  }
}

data organization_runner_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/actions/self-hosted-runners#create-a-registration-token-for-an-organization"
  }
}

data metadata_baseline_note: String = "metadata:read IS NOT AN EFFECT REQUIREMENT AND IS DELIBERATELY ABSENT BELOW. It is a baseline GitHub Apps carry on every installation, so attaching it to the effect made it a requirement of the ACT rather than of the credential kind — and the discriminating witness caught the consequence immediately: the Actions job credential has no metadata scope at all (GitHub's permissions vocabulary omits it because Actions grants that access implicitly), so an effect demanding metadata:read refused every ordinary push GITHUB_TOKEN performs today. The baseline now lives at the App credential layer in gunbc.auth.github_credential, which is the only place it is true."

data effect_to_permission_derivation_note: String = "PERMISSIONS ARE DERIVED FROM THE EFFECT, NOT AUTHORED BESIDE IT. A consumer row carrying a free-text purpose and a hand-written permission list is two restatements of one fact, and the second one drifts: the runner consumer in the first cut of gunbc.auth.github_apps read 'register ephemeral self-hosted runners on a fleet host' while asserting repository `administration: write`, when organization-level runner registration takes the ORGANIZATION permission `organization_self_hosted_runners: write`. The prose and the list disagreed and nothing could tell, because neither was derived from the other.\n\nHere the effect is the single authored fact and the permission set is a projection of it. The projection is where GitHub's rules live — including the one this repository needs: advancing a branch costs `contents: write`, and costs `workflows: write` IN ADDITION exactly when the advanced tree touches .github/workflows/**. A second SCM provider supplies its own projection over the same effect vocabulary; the effect rows do not move."

data reused_identity_types_note: String = "IDENTITY TYPES ARE REUSED, NOT RE-COINED. An earlier draft of this module minted GitHubRepositoryRef \{owner, name} and CommitSha \{value} beside extdeps.github.github Repository and std.types CommitSha — two nicknames for concepts that already had single authorities, and the CommitSha one collided outright, breaking extdeps.git.git's resolution. The repository target is Repository; a commit subject is std.types CommitSha. Only GitBranchRef and GitHubWorkflowRef are declared here, because neither names an entity an existing authority owns: extdeps.git.object_store's GitRefName brands a full ref string and GitRefRecord binds a ref to an object, while what an effect target needs is just which branch is being advanced."

type RepositoryPath { value: NonEmptyStr }

type GitHubOrganizationRef { login: NonEmptyStr }

type GitBranchRef { name: NonEmptyStr }

type GitHubWorkflowRef { file_name: NonEmptyStr }

type GitHubEffect
  = AdvanceRepositoryBranch {
      repository: Repository
      branch: GitBranchRef
      changed_paths: List<RepositoryPath>
    }
  | DispatchWorkflow {
      repository: Repository
      workflow: GitHubWorkflowRef
      subject: CommitSha
    }
  | RegisterOrganizationRunner {
      organization: GitHubOrganizationRef
    }

data workflow_directory_prefix: NonEmptyStr = ".github/workflows/"

fn path_has_prefix(path: NonEmptyStr, prefix: NonEmptyStr) -> Bool {
  let prefix_len = string_length(s: prefix)
  if string_length(s: path) < prefix_len {
    false
  } else {
    substring(s: path, start: 0, end: prefix_len) == prefix
  }
}

fn is_workflow_projection_path(path: RepositoryPath) -> Bool {
  path_has_prefix(path: path.value, prefix: workflow_directory_prefix)
}

fn any_workflow_projection_path(paths: List<RepositoryPath>) -> Bool {
  fold_list(
    xs: paths,
    empty: false,
    cons: fn(found, p) { found || is_workflow_projection_path(path: p) }
  )
}

fn workflow_projection_paths(paths: List<RepositoryPath>) -> List<RepositoryPath> {
  filter(paths, p => is_workflow_projection_path(path: p))
}

data contents_write: GitHubAppPermission = GitHubAppPermission {
  name: GitHubAppPermissionName { wire_name: "contents" },
  access: AppAccessWrite
}

data workflows_write: GitHubAppPermission = GitHubAppPermission {
  name: GitHubAppPermissionName { wire_name: "workflows" },
  access: AppAccessWrite
}

data actions_write: GitHubAppPermission = GitHubAppPermission {
  name: GitHubAppPermissionName { wire_name: "actions" },
  access: AppAccessWrite
}

data metadata_read: GitHubAppPermission = GitHubAppPermission {
  name: GitHubAppPermissionName { wire_name: "metadata" },
  access: AppAccessRead
}

data organization_self_hosted_runners_write: GitHubAppPermission = GitHubAppPermission {
  name: GitHubAppPermissionName { wire_name: "organization_self_hosted_runners" },
  access: AppAccessWrite
}

fn github_effect_required_permissions(effect: GitHubEffect) -> List<GitHubAppPermission> {
  match effect {
    AdvanceRepositoryBranch { repository: _, branch: _, changed_paths } =>
      if any_workflow_projection_path(paths: changed_paths) {
        [contents_write, workflows_write]
      } else {
        [contents_write]
      }
    DispatchWorkflow { repository: _, workflow: _, subject: _ } =>
      [actions_write]
    RegisterOrganizationRunner { organization: _ } =>
      [organization_self_hosted_runners_write]
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.effect",
      decl_name: "GitHubEffect",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.github.effect.extdeps_external_authority_anchor,
  further_citations: [
    extdeps.github.effect.contents_write_citation,
    extdeps.github.effect.workflow_dispatch_citation,
    extdeps.github.effect.organization_runner_citation
  ]
}
