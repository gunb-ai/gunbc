module extdeps.github.effect


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/rest/authentication/permissions-required-for-github-apps"
  }
}

data contents_write_citation: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/rest/git/refs#update-a-reference"
  }
}

data workflow_dispatch_citation: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/rest/actions/workflows#create-a-workflow-dispatch-event"
  }
}

data organization_runner_citation: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/rest/actions/self-hosted-runners#create-a-registration-token-for-an-organization"
  }
}

type RepositoryPath { value: std.types.NonEmptyStr }

type GitHubOrganizationRef { login: std.types.NonEmptyStr }

type GitBranchRef { name: std.types.NonEmptyStr }

type GitHubWorkflowRef { file_name: std.types.NonEmptyStr }

type GitHubEffect
  = AdvanceRepositoryBranch {
      repository: extdeps.github.github.Repository
      branch: GitBranchRef
      changed_paths: List<RepositoryPath>
    }
  | DispatchWorkflow {
      repository: extdeps.github.github.Repository
      workflow: GitHubWorkflowRef
      subject: std.types.CommitSha
    }
  | RegisterOrganizationRunner {
      organization: GitHubOrganizationRef
    }

data workflow_directory_prefix: std.types.NonEmptyStr = ".github/workflows/"

fn path_has_prefix(path: std.types.NonEmptyStr, prefix: std.types.NonEmptyStr) -> Bool {
  let prefix_len = string_length(s: prefix)
  if string_length(s: path) < prefix_len {
    false
  } else {
    substring(s: path, start: 0, end: prefix_len) == prefix
  }
}

fn is_workflow_projection_path(path: RepositoryPath) -> Bool {
  path_has_prefix(path: path.value, prefix: workflow_directory_prefix)
}

fn any_workflow_projection_path(paths: List<RepositoryPath>) -> Bool {
  fold_list(
    xs: paths,
    empty: false,
    cons: fn(found, p) { found || is_workflow_projection_path(path: p) }
  )
}

fn workflow_projection_paths(paths: List<RepositoryPath>) -> List<RepositoryPath> {
  filter(paths, p => is_workflow_projection_path(path: p))
}

data contents_write: extdeps.github.app.GitHubAppPermission = extdeps.github.app.GitHubAppPermission {
  name: extdeps.github.app.ContentsAxis,
  access: extdeps.github.app.AppAccessWrite
}

data workflows_write: extdeps.github.app.GitHubAppPermission = extdeps.github.app.GitHubAppPermission {
  name: extdeps.github.app.WorkflowsAxis,
  access: extdeps.github.app.AppAccessWrite
}

data actions_write: extdeps.github.app.GitHubAppPermission = extdeps.github.app.GitHubAppPermission {
  name: extdeps.github.app.ActionsAxis,
  access: extdeps.github.app.AppAccessWrite
}

data metadata_read: extdeps.github.app.GitHubAppPermission = extdeps.github.app.GitHubAppPermission {
  name: extdeps.github.app.MetadataAxis,
  access: extdeps.github.app.AppAccessRead
}

data organization_self_hosted_runners_write: extdeps.github.app.GitHubAppPermission = extdeps.github.app.GitHubAppPermission {
  name: extdeps.github.app.OrganizationSelfHostedRunnersAxis,
  access: extdeps.github.app.AppAccessWrite
}

fn advance_branch_required_permissions(paths: List<RepositoryPath>) -> List<extdeps.github.app.GitHubAppPermission> {
  if any_workflow_projection_path(paths: paths) {
    [contents_write, workflows_write]
  } else {
    [contents_write]
  }
}

fn github_effect_required_permissions(effect: GitHubEffect) -> List<extdeps.github.app.GitHubAppPermission> {
  match effect {
    AdvanceRepositoryBranch { repository: _, branch: _, changed_paths } =>
      advance_branch_required_permissions(paths: changed_paths)
    DispatchWorkflow { repository: _, workflow: _, subject: _ } =>
      [actions_write]
    RegisterOrganizationRunner { organization: _ } =>
      [organization_self_hosted_runners_write]
  }
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.github.effect",
      decl_name: "GitHubEffect",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [
    contents_write_citation,
    workflow_dispatch_citation,
    organization_runner_citation
  ]
}
