module extdeps.github.expressions
import std.optional { Absent, Optional, Present }


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.communication.medium { Lossless }
import std.algebra { fold_list, list_head, skip, length, trim }
import std.types { Bool, List, String, Int }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/learn-github-actions/expressions"
  }
}

data github_expression_operators_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/writing-workflows/choosing-what-your-workflow-does/evaluate-expressions-in-workflows-and-actions#operators"
  }
}

data github_expression_format_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/writing-workflows/choosing-what-your-workflow-does/evaluate-expressions-in-workflows-and-actions#format"
  }
}

type ExpressionContext
  = Github
  | Env
  | Vars
  | Job
  | Jobs
  | Steps
  | Runner
  | Secrets
  | Strategy
  | Matrix
  | Needs
  | Inputs

type ExpressionFunction
  = Contains
  | StartsWith
  | EndsWith
  | Format
  | Join
  | ToJSON
  | FromJSON
  | HashFiles
  | Success
  | Always
  | Cancelled
  | Failure

type Expression
  = ContextAccess { context: ExpressionContext, path: List<String> }
  | FunctionCall { function: ExpressionFunction, args: List<Expression> }
  | StringLiteral { value: String }
  | LogicalOr { left: Expression, right: Expression }
  | LogicalAnd { left: Expression, right: Expression }
  | Equals { left: Expression, right: Expression }
  | NotEquals { left: Expression, right: Expression }
  | LogicalNot { operand: Expression }
  | LessThan { left: Expression, right: Expression }
  | LessOrEqual { left: Expression, right: Expression }
  | GreaterThan { left: Expression, right: Expression }
  | GreaterOrEqual { left: Expression, right: Expression }
  | BoolLiteral { value: Bool }
  | NullLiteral
  | NumberLiteral { text: String }
  | FilteredContextAccess { context: ExpressionContext, path: List<FilterSegment> }

// THE OBJECT FILTER IS A SEGMENT KIND, NOT A KEY. github_expression_operators_authority lists
// `*` ("object filter") beside `.` and `[ ]`; its example is `fruits.*.name`. A `*` spelled as a
// plain key would be the same text as the literal key `['*']`, which reads a property named `*`
// and not a filter, so the filter is its own constructor and an ordinary ContextAccess path can
// never mean one. A path holding any filter is FilteredContextAccess; one holding none is always
// ContextAccess, so no existing consumer's reading of a plain path moves.
type FilterSegment
  = FilterKey { name: String }
  | FilterAll

type TemplateSegment
  = LiteralText { text: String }
  | Interpolation { expression: Expression }

type ExpressionTemplate {
  segments: List<TemplateSegment>
}

fn context_name(context: ExpressionContext) -> String {
  match context {
    Github => "github"
    Env => "env"
    Vars => "vars"
    Job => "job"
    Jobs => "jobs"
    Steps => "steps"
    Runner => "runner"
    Secrets => "secrets"
    Strategy => "strategy"
    Matrix => "matrix"
    Needs => "needs"
    Inputs => "inputs"
  }
}

fn function_name(function: ExpressionFunction) -> String {
  match function {
    Contains => "contains"
    StartsWith => "startsWith"
    EndsWith => "endsWith"
    Format => "format"
    Join => "join"
    ToJSON => "toJSON"
    FromJSON => "fromJSON"
    HashFiles => "hashFiles"
    Success => "success"
    Always => "always"
    Cancelled => "cancelled"
    Failure => "failure"
  }
}

type ExpressionSpellings {
  path_sep: String
  call_open: String
  call_close: String
  arg_sep: String
  string_quote: String
  or_op: String
  and_op: String
  eq_op: String
  neq_op: String
  not_op: String
  interp_open: String
  interp_close: String
  index_open: String
  index_close: String
  group_open: String
  group_close: String
  lt_op: String
  le_op: String
  gt_op: String
  ge_op: String
  wildcard: String
  true_literal: String
  false_literal: String
  null_literal: String
}

data default_expression_spellings: ExpressionSpellings = {
  path_sep: ".",
  call_open: "(",
  call_close: ")",
  arg_sep: ", ",
  string_quote: "'",
  or_op: " || ",
  and_op: " && ",
  eq_op: " == ",
  neq_op: " != ",
  not_op: "!",
  interp_open: "${{ ",
  interp_close: " }}",
  index_open: "['",
  index_close: "']",
  group_open: "(",
  group_close: ")",
  lt_op: " < ",
  le_op: " <= ",
  gt_op: " > ",
  ge_op: " >= ",
  wildcard: "*",
  true_literal: "true",
  false_literal: "false",
  null_literal: "null",
}

// THIS WRITER HAS A CANONICAL SPELLING FOR PATH SEGMENTS, AND THE CHOICE IS OURS RATHER THAN
// THE GRAMMAR'S.
//
// The cited authority (docs.github.com, this module's anchor) admits two forms for reaching a
// property: index notation `['name']`, and property dereference `.name`. Its rule for the second
// is quoted rather than paraphrased, because an earlier revision of this comment paraphrased it
// wrongly: "In order to use property dereference syntax, the property name must start with a
// letter or `_` and contain only alphanumeric characters, `-`, or `_`."
//
// SO A HYPHEN IS ADMITTED BY THE DOT FORM, AND AN EARLIER REVISION OF THIS COMMENT SAID THE
// OPPOSITE. It read that `-` is the subtraction operator, that `needs.a-b.result` "does not name
// a property at all", and that it evaluates to the empty string. THAT IS FALSE and it was never
// measured -- it was asserted from recall by one session, deferred to by another, and written
// into an authority where a reader would have taken it as established. It is corrected in place
// rather than deleted, because the correction is the more useful record: the two of us AGREEING
// was produced by deference, not by evidence, and an agreement whose generator is deference is
// not corroboration.
//
// WHAT THE POLICY ACTUALLY IS: index notation for anything outside the narrow dereference
// production, dot notation otherwise. That is a claim about US, not about GitHub. It is chosen
// because index notation is explicit, reaches ARBITRARY keys uniformly, and does not depend on
// the narrower production at all -- so a segment this writer has never seen before cannot be
// rendered into a form the consumer might read as an operator expression. Both forms are valid
// for the segments we emit today; this one stays valid for the segments we do not.
//
// WHY IT IS MODELED HERE AND NOT AT A CALL SITE. The production is a fact about the upstream
// language, so a consumer hand-spelling `['...']` for its own case would be a second account of
// the grammar (DESIGN 3). Choosing the form from the SEGMENT means a caller cannot spell it
// wrong -- construction rather than a rule callers must remember (DESIGN 5).
//
// THE PREDICATE IS NARROWER THAN THE PRODUCTION, DELIBERATELY, and its name says which question
// it answers. `path_segment_takes_dot_form` is THIS WRITER'S canonical choice; it is not
// `path_segment_is_valid_with_a_dot`, which would be a different function with `-` admitted. A
// reader who confuses the two will conclude GitHub rejects something GitHub accepts.
fn dot_form_code_point(c: Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c == 95)
}

fn dot_form_leading_code_point(c: Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c == 95)
}

// THE START CHARACTER IS A SEPARATE RULE FROM THE REST, AND THAT SHAPE IS THE UPSTREAM
// PRODUCTION'S, NOT A CONVENIENCE. The cited sentence says the name must START WITH a letter or
// `_` and then CONTAIN ONLY the wider set, so `0a` is excluded by the start rule while every one
// of its characters is individually admitted. Folding the two into one alphabet would admit it,
// and this is the one place where the predicate and the production agree exactly rather than the
// predicate being the narrower canonical choice.
fn path_segment_takes_dot_form(segment: String) -> Bool {
  match segment.chars().first() {
    Absent => false
    Present { value: lead } =>
      dot_form_leading_code_point(c: lead)
        && all(segment.chars(), c => dot_form_code_point(c: c))
  }
}

fn render_path_segment_with(segment: String, sp: ExpressionSpellings) -> String {
  if path_segment_takes_dot_form(segment: segment) {
    concat(sp.path_sep, segment)
  } else {
    join([sp.index_open, segment, sp.index_close], "")
  }
}

fn join_path_with(path: List<String>, sp: ExpressionSpellings) -> String {
  fold(path, init: "", f: (acc, segment) =>
    concat(acc, render_path_segment_with(segment: segment, sp: sp)))
}

fn render_filter_segment_with(segment: FilterSegment, sp: ExpressionSpellings) -> String {
  match segment {
    FilterKey { name: n } => render_path_segment_with(segment: n, sp: sp)
    FilterAll => concat(sp.path_sep, sp.wildcard)
  }
}

fn join_filter_path_with(path: List<FilterSegment>, sp: ExpressionSpellings) -> String {
  fold(path, init: "", f: (acc, segment) =>
    concat(acc, render_filter_segment_with(segment: segment, sp: sp)))
}

fn serialize_args_with(args: List<Expression>, sp: ExpressionSpellings) -> String {
  join(map(args, a => serialize_expression_with(expression: a, sp: sp)), sp.arg_sep)
}

fn serialize_expression_with(expression: Expression, sp: ExpressionSpellings) -> String {
  match expression {
    ContextAccess { context: c, path: p } =>
      concat(context_name(context: c), join_path_with(path: p, sp: sp))
    FunctionCall { function: f, args: a } =>
      join([function_name(function: f), sp.call_open, serialize_args_with(args: a, sp: sp), sp.call_close], "")
    StringLiteral { value: v } =>
      join([sp.string_quote, replace(v, sp.string_quote, concat(sp.string_quote, sp.string_quote)), sp.string_quote], "")
    BoolLiteral { value: b } => if b { sp.true_literal } else { sp.false_literal }
    NullLiteral => sp.null_literal
    NumberLiteral { text: t } => t
    FilteredContextAccess { context: c, path: p } =>
      concat(context_name(context: c), join_filter_path_with(path: p, sp: sp))
    LessThan { left: l, right: r } =>
      join([serialize_operand_with(operand: l, parent: ComparisonPrecedence, sp: sp), serialize_operand_with(operand: r, parent: ComparisonPrecedence, sp: sp)], sp.lt_op)
    LessOrEqual { left: l, right: r } =>
      join([serialize_operand_with(operand: l, parent: ComparisonPrecedence, sp: sp), serialize_operand_with(operand: r, parent: ComparisonPrecedence, sp: sp)], sp.le_op)
    GreaterThan { left: l, right: r } =>
      join([serialize_operand_with(operand: l, parent: ComparisonPrecedence, sp: sp), serialize_operand_with(operand: r, parent: ComparisonPrecedence, sp: sp)], sp.gt_op)
    GreaterOrEqual { left: l, right: r } =>
      join([serialize_operand_with(operand: l, parent: ComparisonPrecedence, sp: sp), serialize_operand_with(operand: r, parent: ComparisonPrecedence, sp: sp)], sp.ge_op)
    LogicalOr { left: l, right: r } =>
      join([serialize_expression_with(expression: l, sp: sp), serialize_expression_with(expression: r, sp: sp)], sp.or_op)
    LogicalAnd { left: l, right: r } =>
      join([serialize_operand_with(operand: l, parent: AndPrecedence, sp: sp), serialize_operand_with(operand: r, parent: AndPrecedence, sp: sp)], sp.and_op)
    Equals { left: l, right: r } =>
      join([serialize_operand_with(operand: l, parent: ComparisonPrecedence, sp: sp), serialize_operand_with(operand: r, parent: ComparisonPrecedence, sp: sp)], sp.eq_op)
    NotEquals { left: l, right: r } =>
      join([serialize_operand_with(operand: l, parent: ComparisonPrecedence, sp: sp), serialize_operand_with(operand: r, parent: ComparisonPrecedence, sp: sp)], sp.neq_op)
    LogicalNot { operand: o } =>
      concat(sp.not_op, serialize_operand_with(operand: o, parent: NotPrecedence, sp: sp))
  }
}

// OPERATOR PRECEDENCE IS THE UPSTREAM GRAMMAR'S, AND THE TREE CARRIES GROUPING THAT TEXT MUST
// RE-STATE. github_expression_operators_authority lists the operators in precedence order:
// comparison (==, !=) binds tighter than &&, which binds tighter than ||. A tree whose LogicalAnd
// holds a LogicalOr operand means (a || b) && c; rendering it bare as `a || b && c` reads back as
// a || (b && c) -- a different expression under the same tree. So an operand whose own operator
// binds LOOSER than its parent's is wrapped in a group; nothing else is, so every tree that never
// nested a looser operator under a tighter one renders byte-for-byte as before. The tree needs no
// Group node: grouping is determined by the tree's shape, and a second representation of it would
// let the two disagree.
// `!` is the unary operator that binds tighter than comparison in the same operator list, so its
// operand is grouped unless it is an atom (`!cancelled()`, `!(a == b)`).
type ExpressionPrecedence = OrPrecedence | AndPrecedence | ComparisonPrecedence | NotPrecedence | AtomPrecedence

fn expression_precedence_rank(p: ExpressionPrecedence) -> Int {
  match p {
    OrPrecedence => 1
    AndPrecedence => 2
    ComparisonPrecedence => 3
    NotPrecedence => 4
    AtomPrecedence => 5
  }
}

fn expression_precedence(expression: Expression) -> ExpressionPrecedence {
  match expression {
    LogicalOr { left: _, right: _ } => OrPrecedence
    LogicalAnd { left: _, right: _ } => AndPrecedence
    Equals { left: _, right: _ } => ComparisonPrecedence
    NotEquals { left: _, right: _ } => ComparisonPrecedence
    LessThan { left: _, right: _ } => ComparisonPrecedence
    LessOrEqual { left: _, right: _ } => ComparisonPrecedence
    GreaterThan { left: _, right: _ } => ComparisonPrecedence
    GreaterOrEqual { left: _, right: _ } => ComparisonPrecedence
    LogicalNot { operand: _ } => NotPrecedence
    ContextAccess { context: _, path: _ } => AtomPrecedence
    FilteredContextAccess { context: _, path: _ } => AtomPrecedence
    FunctionCall { function: _, args: _ } => AtomPrecedence
    StringLiteral { value: _ } => AtomPrecedence
    BoolLiteral { value: _ } => AtomPrecedence
    NullLiteral => AtomPrecedence
    NumberLiteral { text: _ } => AtomPrecedence
  }
}

fn serialize_operand_with(operand: Expression, parent: ExpressionPrecedence, sp: ExpressionSpellings) -> String {
  let text = serialize_expression_with(expression: operand, sp: sp)
  if expression_precedence_rank(p: expression_precedence(expression: operand)) < expression_precedence_rank(p: parent) {
    join([sp.group_open, text, sp.group_close], "")
  } else {
    text
  }
}

fn interpolate_with(expression: Expression, sp: ExpressionSpellings) -> String {
  join([sp.interp_open, serialize_expression_with(expression: expression, sp: sp), sp.interp_close], "")
}

fn serialize_segment_with(segment: TemplateSegment, sp: ExpressionSpellings) -> String {
  match segment {
    LiteralText { text: t } => t
    Interpolation { expression: e } => interpolate_with(expression: e, sp: sp)
  }
}

fn serialize_template_with(template: ExpressionTemplate, sp: ExpressionSpellings) -> String {
  fold(template.segments, init: "", f: (acc, segment) =>
    concat(acc, serialize_segment_with(segment: segment, sp: sp)))
}

fn join_path(path: List<String>) -> String {
  join_path_with(path: path, sp: default_expression_spellings)
}

fn serialize_args(args: List<Expression>) -> String {
  serialize_args_with(args: args, sp: default_expression_spellings)
}

fn serialize_expression(expression: Expression) -> String {
  serialize_expression_with(expression: expression, sp: default_expression_spellings)
}

fn interpolate(expression: Expression) -> String {
  interpolate_with(expression: expression, sp: default_expression_spellings)
}

fn serialize_segment(segment: TemplateSegment) -> String {
  serialize_segment_with(segment: segment, sp: default_expression_spellings)
}

fn serialize_template(template: ExpressionTemplate) -> String {
  serialize_template_with(template: template, sp: default_expression_spellings)
}

data all_expression_contexts: List<ExpressionContext> = [
  Github, Env, Vars, Job, Jobs, Steps, Runner, Secrets, Strategy, Matrix, Needs, Inputs
]

data all_expression_functions: List<ExpressionFunction> = [
  Contains, StartsWith, EndsWith, Format, Join, ToJSON, FromJSON, HashFiles,
  Success, Always, Cancelled, Failure
]

fn context_from_name(name: String) -> ExpressionContext? {
  fold(all_expression_contexts, init: none, f: (acc, c) => match acc {
    Present { value: x } => Present { value: x }
    Absent => if context_name(context: c) == name { Present { value: c } } else { none }
  })
}

fn function_from_name(name: String) -> ExpressionFunction? {
  fold(all_expression_functions, init: none, f: (acc, fn_variant) => match acc {
    Present { value: x } => Present { value: x }
    Absent => if function_name(function: fn_variant) == name { Present { value: fn_variant } } else { none }
  })
}

// THE PARSER IS A TOKENIZER PLUS A PRECEDENCE PARSER OVER THE UPSTREAM GRAMMAR, READ FROM THE SAME
// ExpressionSpellings ROWS THE WRITER USES (DESIGN 4: one grammar, both directions).
//
// Upstream (github_expression_operators_authority, "Operators") tabulates, tightest first: logical
// grouping `( )`, index `[ ]`, property dereference `.`, `!`, `<` `<=` `>` `>=` `==` `!=`, `&&`,
// `||`. Comparison operators share one level and associate left, as `&&` and `||` do. Literals
// (same page, "Literals"): `true`, `false`, `null`, "any number format supported by JSON", and
// strings in single quotes with `''` as the escape; "wrapping with double quotes (`"`) will throw
// an error", so a double quote is not a token here and the input is refused. Whitespace between
// tokens is insignificant. The page states no case rule for context or property names (it says
// only that string COMPARISON and contains/startsWith/endsWith ignore case), so names are matched
// exactly, as before; this module does not invent a case-folding the cited page does not state.
//
// WHAT IS REFUSED, AS A TYPED Absent AND NEVER A PARTIAL PARSE: any unrecognized character, an
// unterminated string, unbalanced grouping, trailing tokens, a numeric or expression index
// (`a[0]`, `a[b.c]`), `[*]`, a dot followed by a non-name, an unknown context or function.
type ExpressionToken
  = TokName { text: String }
  | TokString { value: String }
  | TokNumber { text: String }
  | TokOr
  | TokAnd
  | TokEq
  | TokNeq
  | TokLt
  | TokLe
  | TokGt
  | TokGe
  | TokNot
  | TokDot
  | TokStar
  | TokComma
  | TokOpenParen
  | TokCloseParen
  | TokOpenBracket
  | TokCloseBracket

type PunctRow {
  spelling: String
  token: ExpressionToken
}

type PunctMatch {
  token: ExpressionToken
  width: Int
}

type StringScan {
  value: String
  next: Int
}

fn punct_rows(sp: ExpressionSpellings) -> List<PunctRow> {
  [
    PunctRow { spelling: trim(s: sp.or_op), token: TokOr },
    PunctRow { spelling: trim(s: sp.and_op), token: TokAnd },
    PunctRow { spelling: trim(s: sp.neq_op), token: TokNeq },
    PunctRow { spelling: trim(s: sp.eq_op), token: TokEq },
    PunctRow { spelling: trim(s: sp.le_op), token: TokLe },
    PunctRow { spelling: trim(s: sp.ge_op), token: TokGe },
    PunctRow { spelling: trim(s: sp.lt_op), token: TokLt },
    PunctRow { spelling: trim(s: sp.gt_op), token: TokGt },
    PunctRow { spelling: trim(s: sp.not_op), token: TokNot },
    PunctRow { spelling: sp.path_sep, token: TokDot },
    PunctRow { spelling: sp.wildcard, token: TokStar },
    PunctRow { spelling: trim(s: sp.arg_sep), token: TokComma },
    PunctRow { spelling: trim(s: sp.call_open), token: TokOpenParen },
    PunctRow { spelling: trim(s: sp.call_close), token: TokCloseParen },
    PunctRow { spelling: "[", token: TokOpenBracket },
    PunctRow { spelling: "]", token: TokCloseBracket },
  ]
}

fn code_at(s: String, i: Int) -> Int {
  match substring(s: s, start: i, end: i + 1).chars().first() {
    Absent => 0 - 1
    Present { value: c } => c
  }
}

fn is_digit_code(c: Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_letter_code(c: Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn is_name_code(c: Int) -> Bool {
  dot_form_code_point(c: c) || c == 45
}

fn is_number_run_code(c: Int) -> Bool {
  is_digit_code(c: c) || is_letter_code(c: c) || c == 46 || c == 43 || c == 45
}

fn is_space_code(c: Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

// A spelling that begins with a letter (a word operator) only matches as a whole word; a symbolic
// one matches wherever it starts.
fn punct_row_matches(rest: String, row: PunctRow, allow_words: Bool) -> Bool {
  let w = string_length(s: row.spelling)
  if w == 0 || !starts_with(s: rest, prefix: row.spelling) {
    false
  } else if is_letter_code(c: code_at(s: row.spelling, i: 0)) {
    allow_words && (string_length(s: rest) == w || is_space_code(c: code_at(s: rest, i: w)))
  } else {
    true
  }
}

fn punct_match(rest: String, sp: ExpressionSpellings, allow_words: Bool) -> PunctMatch? {
  fold(punct_rows(sp: sp), init: none, f: (acc, row) => match acc {
    Present { value: m } => Present { value: m }
    Absent =>
      if punct_row_matches(rest: rest, row: row, allow_words: allow_words) {
        Present { value: PunctMatch { token: row.token, width: string_length(s: row.spelling) } }
      } else {
        none
      }
  })
}

fn name_run_end(s: String, j: Int, n: Int, sp: ExpressionSpellings) -> Int {
  if j >= n {
    n
  } else if !is_name_code(c: code_at(s: s, i: j)) {
    j
  } else {
    match punct_match(rest: substring(s: s, start: j, end: n), sp: sp, allow_words: false) {
      Present { value: _ } => j
      Absent => name_run_end(s: s, j: j + 1, n: n, sp: sp)
    }
  }
}

fn number_run_end(s: String, j: Int, n: Int) -> Int {
  if j >= n || !is_number_run_code(c: code_at(s: s, i: j)) {
    j
  } else {
    number_run_end(s: s, j: j + 1, n: n)
  }
}

fn all_digit_codes(text: String) -> Bool {
  text != "" && all(text.chars(), c => is_digit_code(c: c))
}

fn all_hex_codes(text: String) -> Bool {
  text != "" && all(text.chars(), c => is_digit_code(c: c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102))
}

fn unsigned_exponent_digits(text: String) -> String {
  if starts_with(s: text, prefix: "+") || starts_with(s: text, prefix: "-") {
    substring(s: text, start: 1, end: string_length(s: text))
  } else {
    text
  }
}

fn decimal_mantissa_admitted(text: String) -> Bool {
  let parts = split(s: text, delimiter: ".")
  if parts.length() == 1 {
    all_digit_codes(text: text)
  } else if parts.length() == 2 {
    match parts.first() {
      Absent => false
      Present { value: whole } =>
        match parts.skip(n: 1).first() {
          Absent => false
          Present { value: frac } => all_digit_codes(text: whole) && all_digit_codes(text: frac)
        }
    }
  } else {
    false
  }
}

// The cited page: "any number format supported by JSON", and its examples add hexadecimal.
// Admitted: `-?(0[xX]hex+ | digits(.digits)?([eE][+-]?digits)?)`.
fn number_text_admitted(text: String) -> Bool {
  let body = if starts_with(s: text, prefix: "-") { substring(s: text, start: 1, end: string_length(s: text)) } else { text }
  if starts_with(s: body, prefix: "0x") || starts_with(s: body, prefix: "0X") {
    all_hex_codes(text: substring(s: body, start: 2, end: string_length(s: body)))
  } else {
    let parts = split(s: replace(body, "E", "e"), delimiter: "e")
    if parts.length() == 1 {
      decimal_mantissa_admitted(text: body)
    } else if parts.length() == 2 {
      match parts.first() {
        Absent => false
        Present { value: mant } =>
          match parts.skip(n: 1).first() {
            Absent => false
            Present { value: exp } => decimal_mantissa_admitted(text: mant) && all_digit_codes(text: unsigned_exponent_digits(text: exp))
          }
      }
    } else {
      false
    }
  }
}

// Single-quoted string with `''` as the escape for one quote; none other.
fn scan_string_body(s: String, j: Int, n: Int, q: String, acc: String) -> StringScan? {
  let qw = string_length(s: q)
  if j >= n {
    none
  } else {
    let rest = substring(s: s, start: j, end: n)
    if starts_with(s: rest, prefix: concat(q, q)) {
      scan_string_body(s: s, j: j + 2 * qw, n: n, q: q, acc: concat(acc, q))
    } else if starts_with(s: rest, prefix: q) {
      Present { value: StringScan { value: acc, next: j + qw } }
    } else {
      scan_string_body(s: s, j: j + 1, n: n, q: q, acc: concat(acc, substring(s: s, start: j, end: j + 1)))
    }
  }
}

fn tokenize_from(s: String, i: Int, n: Int, sp: ExpressionSpellings, acc: List<ExpressionToken>) -> List<ExpressionToken>? {
  if i >= n {
    Present { value: acc }
  } else if is_space_code(c: code_at(s: s, i: i)) {
    tokenize_from(s: s, i: i + 1, n: n, sp: sp, acc: acc)
  } else {
    let rest = substring(s: s, start: i, end: n)
    if starts_with(s: rest, prefix: sp.string_quote) {
      match scan_string_body(s: s, j: i + string_length(s: sp.string_quote), n: n, q: sp.string_quote, acc: "") {
        Absent => none
        Present { value: scan } => tokenize_from(s: s, i: scan.next, n: n, sp: sp, acc: concat(acc, [TokString { value: scan.value }]))
      }
    } else {
      match punct_match(rest: rest, sp: sp, allow_words: true) {
        Present { value: m } => tokenize_from(s: s, i: i + m.width, n: n, sp: sp, acc: concat(acc, [m.token]))
        Absent => {
          let c = code_at(s: s, i: i)
          if is_digit_code(c: c) || (c == 45 && is_digit_code(c: code_at(s: s, i: i + 1))) {
            let stop = number_run_end(s: s, j: i + 1, n: n)
            let text = substring(s: s, start: i, end: stop)
            if number_text_admitted(text: text) {
              tokenize_from(s: s, i: stop, n: n, sp: sp, acc: concat(acc, [TokNumber { text: text }]))
            } else {
              none
            }
          } else if dot_form_leading_code_point(c: c) {
            let stop = name_run_end(s: s, j: i + 1, n: n, sp: sp)
            tokenize_from(s: s, i: stop, n: n, sp: sp, acc: concat(acc, [TokName { text: substring(s: s, start: i, end: stop) }]))
          } else {
            none
          }
        }
      }
    }
  }
}

fn tokenize_expression_with(s: String, sp: ExpressionSpellings) -> List<ExpressionToken>? {
  tokenize_from(s: s, i: 0, n: string_length(s: s), sp: sp, acc: [])
}

type ParsedExpression {
  expression: Expression
  rest: List<ExpressionToken>
}

type ParsedArgs {
  args: List<Expression>
  rest: List<ExpressionToken>
}

type ParsedPath {
  path: List<FilterSegment>
  rest: List<ExpressionToken>
}

fn filter_path_is_plain(path: List<FilterSegment>) -> Bool {
  all(path, seg => match seg {
    FilterKey { name: _ } => true
    FilterAll => false
  })
}

fn filter_path_keys(path: List<FilterSegment>) -> List<String> {
  map(path, seg => match seg {
    FilterKey { name: n } => n
    FilterAll => ""
  })
}

fn context_access_from_path(ctx: ExpressionContext, path: List<FilterSegment>) -> Expression {
  if filter_path_is_plain(path: path) {
    ContextAccess { context: ctx, path: filter_path_keys(path: path) }
  } else {
    FilteredContextAccess { context: ctx, path: path }
  }
}

fn parse_path_tail(toks: List<ExpressionToken>, sofar: List<FilterSegment>) -> ParsedPath? {
  match toks.first() {
    Present { value: TokDot } =>
      match toks.skip(n: 1).first() {
        Present { value: TokName { text: name } } =>
          parse_path_tail(toks: toks.skip(n: 2), sofar: concat(sofar, [FilterKey { name: name }]))
        Present { value: TokStar } =>
          parse_path_tail(toks: toks.skip(n: 2), sofar: concat(sofar, [FilterAll]))
        _ => none
      }
    Present { value: TokOpenBracket } =>
      match toks.skip(n: 1).first() {
        Present { value: TokString { value: key } } =>
          match toks.skip(n: 2).first() {
            Present { value: TokCloseBracket } =>
              parse_path_tail(toks: toks.skip(n: 3), sofar: concat(sofar, [FilterKey { name: key }]))
            _ => none
          }
        _ => none
      }
    _ => Present { value: ParsedPath { path: sofar, rest: toks } }
  }
}

fn parse_call_args(toks: List<ExpressionToken>, sofar: List<Expression>, sp: ExpressionSpellings) -> ParsedArgs? {
  match parse_or_level(toks: toks, sp: sp) {
    Absent => none
    Present { value: p } => {
      let args = concat(sofar, [p.expression])
      match p.rest.first() {
        Present { value: TokComma } => parse_call_args(toks: p.rest.skip(n: 1), sofar: args, sp: sp)
        Present { value: TokCloseParen } => Present { value: ParsedArgs { args: args, rest: p.rest.skip(n: 1) } }
        _ => none
      }
    }
  }
}

fn parse_call(fn_variant: ExpressionFunction, toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match toks.first() {
    Present { value: TokCloseParen } =>
      Present { value: ParsedExpression { expression: FunctionCall { function: fn_variant, args: [] }, rest: toks.skip(n: 1) } }
    _ =>
      match parse_call_args(toks: toks, sofar: [], sp: sp) {
        Absent => none
        Present { value: a } =>
          Present { value: ParsedExpression { expression: FunctionCall { function: fn_variant, args: a.args }, rest: a.rest } }
      }
  }
}

fn parse_name_primary(name: String, toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  if name == sp.true_literal {
    Present { value: ParsedExpression { expression: BoolLiteral { value: true }, rest: toks } }
  } else if name == sp.false_literal {
    Present { value: ParsedExpression { expression: BoolLiteral { value: false }, rest: toks } }
  } else if name == sp.null_literal {
    Present { value: ParsedExpression { expression: NullLiteral, rest: toks } }
  } else {
    match toks.first() {
      Present { value: TokOpenParen } =>
        match function_from_name(name: name) {
          Absent => none
          Present { value: fn_variant } => parse_call(fn_variant: fn_variant, toks: toks.skip(n: 1), sp: sp)
        }
      _ =>
        match context_from_name(name: name) {
          Absent => none
          Present { value: ctx } =>
            match parse_path_tail(toks: toks, sofar: []) {
              Absent => none
              Present { value: p } =>
                Present { value: ParsedExpression { expression: context_access_from_path(ctx: ctx, path: p.path), rest: p.rest } }
            }
        }
    }
  }
}

fn parse_primary(toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match toks.first() {
    Absent => none
    Present { value: TokString { value: v } } =>
      Present { value: ParsedExpression { expression: StringLiteral { value: v }, rest: toks.skip(n: 1) } }
    Present { value: TokNumber { text: t } } =>
      Present { value: ParsedExpression { expression: NumberLiteral { text: t }, rest: toks.skip(n: 1) } }
    Present { value: TokName { text: name } } => parse_name_primary(name: name, toks: toks.skip(n: 1), sp: sp)
    Present { value: TokOpenParen } =>
      match parse_or_level(toks: toks.skip(n: 1), sp: sp) {
        Absent => none
        Present { value: inner } =>
          match inner.rest.first() {
            Present { value: TokCloseParen } =>
              Present { value: ParsedExpression { expression: inner.expression, rest: inner.rest.skip(n: 1) } }
            _ => none
          }
      }
    _ => none
  }
}

fn parse_unary_level(toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match toks.first() {
    Present { value: TokNot } =>
      match parse_unary_level(toks: toks.skip(n: 1), sp: sp) {
        Absent => none
        Present { value: p } =>
          Present { value: ParsedExpression { expression: LogicalNot { operand: p.expression }, rest: p.rest } }
      }
    _ => parse_primary(toks: toks, sp: sp)
  }
}

fn comparison_node(token: ExpressionToken, left: Expression, right: Expression) -> Expression? {
  match token {
    TokEq => Present { value: Equals { left: left, right: right } }
    TokNeq => Present { value: NotEquals { left: left, right: right } }
    TokLt => Present { value: LessThan { left: left, right: right } }
    TokLe => Present { value: LessOrEqual { left: left, right: right } }
    TokGt => Present { value: GreaterThan { left: left, right: right } }
    TokGe => Present { value: GreaterOrEqual { left: left, right: right } }
    _ => none
  }
}

fn parse_comparison_tail(left: Expression, toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match toks.first() {
    Present { value: op } =>
      match comparison_node(token: op, left: left, right: left) {
        Absent => Present { value: ParsedExpression { expression: left, rest: toks } }
        Present { value: _ } =>
          match parse_unary_level(toks: toks.skip(n: 1), sp: sp) {
            Absent => none
            Present { value: r } =>
              match comparison_node(token: op, left: left, right: r.expression) {
                Absent => none
                Present { value: node } => parse_comparison_tail(left: node, toks: r.rest, sp: sp)
              }
          }
      }
    Absent => Present { value: ParsedExpression { expression: left, rest: toks } }
  }
}

fn parse_comparison_level(toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match parse_unary_level(toks: toks, sp: sp) {
    Absent => none
    Present { value: l } => parse_comparison_tail(left: l.expression, toks: l.rest, sp: sp)
  }
}

fn parse_and_tail(left: Expression, toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match toks.first() {
    Present { value: TokAnd } =>
      match parse_comparison_level(toks: toks.skip(n: 1), sp: sp) {
        Absent => none
        Present { value: r } => parse_and_tail(left: LogicalAnd { left: left, right: r.expression }, toks: r.rest, sp: sp)
      }
    _ => Present { value: ParsedExpression { expression: left, rest: toks } }
  }
}

fn parse_and_level(toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match parse_comparison_level(toks: toks, sp: sp) {
    Absent => none
    Present { value: l } => parse_and_tail(left: l.expression, toks: l.rest, sp: sp)
  }
}

fn parse_or_tail(left: Expression, toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match toks.first() {
    Present { value: TokOr } =>
      match parse_and_level(toks: toks.skip(n: 1), sp: sp) {
        Absent => none
        Present { value: r } => parse_or_tail(left: LogicalOr { left: left, right: r.expression }, toks: r.rest, sp: sp)
      }
    _ => Present { value: ParsedExpression { expression: left, rest: toks } }
  }
}

fn parse_or_level(toks: List<ExpressionToken>, sp: ExpressionSpellings) -> ParsedExpression? {
  match parse_and_level(toks: toks, sp: sp) {
    Absent => none
    Present { value: l } => parse_or_tail(left: l.expression, toks: l.rest, sp: sp)
  }
}

fn parse_expression_with(s: String, sp: ExpressionSpellings) -> Expression? {
  match tokenize_expression_with(s: s, sp: sp) {
    Absent => none
    Present { value: toks } =>
      match parse_or_level(toks: toks, sp: sp) {
        Absent => none
        Present { value: p } =>
          match p.rest.first() {
            Absent => Present { value: p.expression }
            Present { value: _ } => none
          }
      }
  }
}

fn ingest_expression_with(src: String, sp: ExpressionSpellings) -> Expression? {
  parse_expression_with(s: src, sp: sp)
}

fn ingest_expression(src: String) -> Expression? {
  ingest_expression_with(src: src, sp: default_expression_spellings)
}

// Index of the closing delimiter at or after j that lies outside every string literal, so a
// `}}` inside a quoted string does not close the interpolation. No close: Absent.
fn find_interpolation_close(s: String, j: Int, n: Int, close: String, q: String) -> Int? {
  if j >= n {
    none
  } else {
    let rest = substring(s: s, start: j, end: n)
    if starts_with(s: rest, prefix: q) {
      match scan_string_body(s: s, j: j + string_length(s: q), n: n, q: q, acc: "") {
        Absent => none
        Present { value: scan } => find_interpolation_close(s: s, j: scan.next, n: n, close: close, q: q)
      }
    } else if starts_with(s: rest, prefix: close) {
      Present { value: j }
    } else {
      find_interpolation_close(s: s, j: j + 1, n: n, close: close, q: q)
    }
  }
}

fn literal_segments(text: String) -> List<TemplateSegment> {
  if text == "" { [] } else { [ LiteralText { text: text } ] }
}

// The delimiters are upstream's bare `${{` and `}}`: the spaces a writer puts inside them are
// whitespace the tokenizer skips, not part of the delimiter. A `${{` with no close is Absent.
fn ingest_segments_from(s: String, i: Int, n: Int, sp: ExpressionSpellings, open: String, close: String, acc: List<TemplateSegment>) -> List<TemplateSegment>? {
  let parts = split(s: substring(s: s, start: i, end: n), delimiter: open)
  let lead = match parts.first() {
    Present { value: l } => l
    Absent => ""
  }
  if parts.length() < 2 {
    Present { value: concat(acc, literal_segments(text: lead)) }
  } else {
    let body_start = i + string_length(s: lead) + string_length(s: open)
    match find_interpolation_close(s: s, j: body_start, n: n, close: close, q: sp.string_quote) {
      Absent => none
      Present { value: c } =>
        match parse_expression_with(s: substring(s: s, start: body_start, end: c), sp: sp) {
          Absent => none
          Present { value: e } =>
            ingest_segments_from(s: s, i: c + string_length(s: close), n: n, sp: sp, open: open, close: close,
              acc: concat(concat(acc, literal_segments(text: lead)), [ Interpolation { expression: e } ]))
        }
    }
  }
}

fn ingest_template_with(src: String, sp: ExpressionSpellings) -> ExpressionTemplate? {
  match ingest_segments_from(s: src, i: 0, n: string_length(s: src), sp: sp, open: trim(s: sp.interp_open), close: trim(s: sp.interp_close), acc: []) {
    Absent => none
    Present { value: segs } => Present { value: ExpressionTemplate { segments: segs } }
  }
}

fn ingest_template(src: String) -> ExpressionTemplate? {
  ingest_template_with(src: src, sp: default_expression_spellings)
}

fn runner_os() -> Expression { ContextAccess { context: Runner, path: ["os"] } }
fn runner_arch() -> Expression { ContextAccess { context: Runner, path: ["arch"] } }
fn runner_temp() -> Expression { ContextAccess { context: Runner, path: ["temp"] } }

data runner_provided_env_var_names: List<String> = [
  "RUNNER_NAME",
  "RUNNER_OS",
  "RUNNER_ARCH",
  "RUNNER_TEMP",
  "RUNNER_TOOL_CACHE",
  "RUNNER_DEBUG",
  "RUNNER_ENVIRONMENT"
]

fn string_in_list(needle: String, haystack: List<String>) -> Bool {
  fold(haystack, init: false, f: (acc, candidate) => acc || (candidate == needle))
}

fn expression_accesses_runner_var_via_env(expression: Expression) -> Bool {
  match expression {
    ContextAccess { context: c, path: p } =>
      match c {
        Env => string_in_list(needle: join_path(path: p), haystack: runner_provided_env_var_names)
        Github => false
        Vars => false
        Job => false
        Jobs => false
        Steps => false
        Runner => false
        Secrets => false
        Strategy => false
        Matrix => false
        Needs => false
        Inputs => false
      }
    FunctionCall { function: _, args: a } =>
      fold(a, init: false, f: (acc, arg) => acc || expression_accesses_runner_var_via_env(expression: arg))
    LogicalOr { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    LogicalAnd { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    Equals { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    NotEquals { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    LessThan { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    LessOrEqual { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    GreaterThan { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    GreaterOrEqual { left: l, right: r } =>
      expression_accesses_runner_var_via_env(expression: l) ||
        expression_accesses_runner_var_via_env(expression: r)
    LogicalNot { operand: o } => expression_accesses_runner_var_via_env(expression: o)
    FilteredContextAccess { context: _, path: _ } => false
    StringLiteral { value: _ } => false
    BoolLiteral { value: _ } => false
    NullLiteral => false
    NumberLiteral { text: _ } => false
  }
}

fn expression_uses_context(expression: Expression, target: ExpressionContext) -> Bool {
  match expression {
    ContextAccess { context: c, path: _ } => context_name(context: c) == context_name(context: target)
    FunctionCall { function: _, args: a } =>
      fold(a, init: false, f: (acc, arg) => acc || expression_uses_context(expression: arg, target: target))
    LogicalOr { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    LogicalAnd { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    Equals { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    NotEquals { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    LessThan { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    LessOrEqual { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    GreaterThan { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    GreaterOrEqual { left: l, right: r } =>
      expression_uses_context(expression: l, target: target) ||
        expression_uses_context(expression: r, target: target)
    LogicalNot { operand: o } => expression_uses_context(expression: o, target: target)
    FilteredContextAccess { context: c, path: _ } => context_name(context: c) == context_name(context: target)
    StringLiteral { value: _ } => false
    BoolLiteral { value: _ } => false
    NullLiteral => false
    NumberLiteral { text: _ } => false
  }
}

fn template_accesses_runner_var_via_env(template: ExpressionTemplate) -> Bool {
  fold(template.segments, init: false, f: (acc, segment) => acc || match segment {
    Interpolation { expression: e } => expression_accesses_runner_var_via_env(expression: e)
    LiteralText { text: _ } => false
  })
}

fn template_uses_context(template: ExpressionTemplate, target: ExpressionContext) -> Bool {
  fold(template.segments, init: false, f: (acc, segment) => acc || match segment {
    Interpolation { expression: e } => expression_uses_context(expression: e, target: target)
    LiteralText { text: _ } => false
  })
}

// LogicalAnd and Equals were added because a consumer needed to LOWER a job condition rather than
// concatenate one (review 49400 on gunbc#7903: the falsifier alert's trust-wall condition was being
// built by nested concat of raw expression text — a foreign-language executable string in normal
// form, authored outside the module that owns that language, in the very change that declares that
// class as residue to shrink). Both are ordinary GitHub Actions expression syntax
// (docs.github.com/en/actions/writing-workflows/choosing-what-your-workflow-does/evaluate-expressions-in-workflows-and-actions#operators,
// read 2026-08-06), so this models what upstream already has.
//
// NO GROUPING CONSTRUCT WAS ADDED, AND THAT IS THE LOAD-BEARING DECISION. GitHub binds && tighter
// than ||, so an Or nested under an And needs parentheses to keep its meaning, and the first
// attempt here made LogicalOr parenthesize unconditionally. review 49430 refused it, correctly and
// on the strongest possible ground: this module is READ IN BOTH DIRECTIONS — parse_expression_with
// is the inverse of serialize_expression_with — and the change added a construct to emission that
// ingest could not read, so `(a || b)` serialized out and would not parse back. That is precisely
// the one-grammar-both-directions invariant DESIGN §4 states, broken by editing one direction
// alone. Three round-trip witnesses and an emission golden would have caught it; they were not run,
// and the earlier claim on the PR that they had been was wrong.
//
// So emission is UNCHANGED from before this row, and the precedence hazard is answered where it
// actually arises — at the authoring site, by choosing a shape that needs no grouping.
// gunbc.falsifier_alert_admission builds its condition in DISTRIBUTED form, `A && B && s || A && B
// && d`, which under GitHub's own precedence already parses as the intended `(A && B && s) || (A &&
// B && d)`. Adding parentheses to this grammar remains legitimate future work, but it is a change
// to BOTH directions plus the goldens that pin them, not a serializer edit.
//
// ASYMMETRY CLOSED: parse_expression_with now reads the full documented grammar (the ingest
// direction of the same ExpressionSpellings rows the serializer writes): &&, ||, comparisons, !,
// parentheses, literals, calls and context paths. Parentheses are ingest-only; the serializer
// still emits a grouping-free spelling, so a right-nested tree reads back left-associated.

fn any_template_accesses_runner_var_via_env(templates: List<ExpressionTemplate>) -> Bool {
  fold(templates, init: false, f: (acc, template) =>
    acc || template_accesses_runner_var_via_env(template: template))
}

// GITHUB ACTIONS TRUTHINESS (github_expression_operators_authority, operators): the falsy
// values are the boolean false, the numbers 0 and -0, empty string, and null. Non-empty strings
// are truthy, including the strings "false" and "0" — `${{ 'false' && 'x' }}` is `'x'`. This
// evaluator is string-only; Equals/NotEquals encode a boolean false as the empty string, so
// treating the string "false" as falsy would invent a string-typed boolean GitHub does not have.
// format() substitution is github_expression_format_authority `format` with replaceValue0 as `{0}`.
fn gha_value_is_truthy(s: String) -> Bool {
  s != ""
}

fn github_path_key(path: List<String>) -> String {
  fold_list(
    xs: path,
    empty: "",
    cons: fn(acc, s) {
      if acc == "" {
        s
      } else {
        concat(concat(acc, "."), s)
      }
    }
  )
}

type GithubPathResolution
  = GithubPathValue { value: String }
  | GithubPathUnmodeled

type FormatEvaluationRefusal
  = FormatTemplateNotLiteral
  | FormatArityNotOneSubstitution { argument_count: Int }
  | FormatPlaceholderNotArg0 { template: String }

type ExpressionEvaluationRefusal
  = UnmodeledContext { context: ExpressionContext, path: List<String> }
  | UnmodeledFunction { function: ExpressionFunction }
  | UnmodeledFormat { cause: FormatEvaluationRefusal }
  | UnmodeledNonStringForm

type ExpressionEvaluation
  = ExpressionValue { value: String }
  | ExpressionEvaluationRefused { cause: ExpressionEvaluationRefusal }

fn apply_format_arg0(template: String, arg0: String) -> ExpressionEvaluation {
  let n = string_length(s: template)
  let m = string_length(s: "{0}")
  if string_contains(template, "{1}") || !(n >= m && substring(s: template, start: n - m, end: n) == "{0}") {
    ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatPlaceholderNotArg0 { template: template } } }
  } else {
    ExpressionValue { value: concat(substring(s: template, start: 0, end: n - m), arg0) }
  }
}

fn eval_format_args(args: List<Expression>, github_path: fn(List<String>) -> GithubPathResolution) -> ExpressionEvaluation {
  let n = length(xs: args)
  if n != 2 {
    ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatArityNotOneSubstitution { argument_count: n } } }
  } else {
    match list_head(xs: args) {
      Absent => ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatArityNotOneSubstitution { argument_count: 0 } } }
      Present { value: tmpl } =>
        match tmpl {
          StringLiteral { value: t } =>
            match list_head(xs: skip(xs: args, n: 1)) {
              Absent => ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatArityNotOneSubstitution { argument_count: n } } }
              Present { value: arg } =>
                match evaluate_expression(expression: arg, github_path: github_path) {
                  ExpressionEvaluationRefused { cause: c } => ExpressionEvaluationRefused { cause: c }
                  ExpressionValue { value: arg0 } => apply_format_arg0(template: t, arg0: arg0)
                }
            }
          ContextAccess { context: _, path: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          FunctionCall { function: _, args: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          LogicalOr { left: _, right: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          LogicalAnd { left: _, right: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          Equals { left: _, right: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          NotEquals { left: _, right: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          LogicalNot { operand: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          LessThan { left: _, right: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          LessOrEqual { left: _, right: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          GreaterThan { left: _, right: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          GreaterOrEqual { left: _, right: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          FilteredContextAccess { context: _, path: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          BoolLiteral { value: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          NullLiteral =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
          NumberLiteral { text: _ } =>
            ExpressionEvaluationRefused { cause: UnmodeledFormat { cause: FormatTemplateNotLiteral } }
        }
    }
  }
}

fn evaluate_expression(expression: Expression, github_path: fn(List<String>) -> GithubPathResolution) -> ExpressionEvaluation {
  match expression {
    ContextAccess { context: Github, path: p } =>
      match github_path(p) {
        GithubPathValue { value: v } => ExpressionValue { value: v }
        GithubPathUnmodeled => ExpressionEvaluationRefused { cause: UnmodeledContext { context: Github, path: p } }
      }
    ContextAccess { context: c, path: p } =>
      ExpressionEvaluationRefused { cause: UnmodeledContext { context: c, path: p } }
    FunctionCall { function: Format, args: a } => eval_format_args(args: a, github_path: github_path)
    FunctionCall { function: f, args: _ } =>
      ExpressionEvaluationRefused { cause: UnmodeledFunction { function: f } }
    StringLiteral { value: v } => ExpressionValue { value: v }
    LogicalOr { left: l, right: r } =>
      match evaluate_expression(expression: l, github_path: github_path) {
        ExpressionEvaluationRefused { cause: c } => ExpressionEvaluationRefused { cause: c }
        ExpressionValue { value: lv } =>
          if gha_value_is_truthy(s: lv) {
            ExpressionValue { value: lv }
          } else {
            evaluate_expression(expression: r, github_path: github_path)
          }
      }
    LogicalAnd { left: l, right: r } =>
      match evaluate_expression(expression: l, github_path: github_path) {
        ExpressionEvaluationRefused { cause: c } => ExpressionEvaluationRefused { cause: c }
        ExpressionValue { value: lv } =>
          if gha_value_is_truthy(s: lv) {
            evaluate_expression(expression: r, github_path: github_path)
          } else {
            ExpressionValue { value: lv }
          }
      }
    Equals { left: l, right: r } =>
      match evaluate_expression(expression: l, github_path: github_path) {
        ExpressionEvaluationRefused { cause: c } => ExpressionEvaluationRefused { cause: c }
        ExpressionValue { value: lv } =>
          match evaluate_expression(expression: r, github_path: github_path) {
            ExpressionEvaluationRefused { cause: c } => ExpressionEvaluationRefused { cause: c }
            ExpressionValue { value: rv } =>
              if lv == rv {
                ExpressionValue { value: "true" }
              } else {
                ExpressionValue { value: "" }
              }
          }
      }
    NotEquals { left: l, right: r } =>
      match evaluate_expression(expression: l, github_path: github_path) {
        ExpressionEvaluationRefused { cause: c } => ExpressionEvaluationRefused { cause: c }
        ExpressionValue { value: lv } =>
          match evaluate_expression(expression: r, github_path: github_path) {
            ExpressionEvaluationRefused { cause: c } => ExpressionEvaluationRefused { cause: c }
            ExpressionValue { value: rv } =>
              if lv == rv {
                ExpressionValue { value: "" }
              } else {
                ExpressionValue { value: "true" }
              }
          }
      }
    LogicalNot { operand: o } =>
      match evaluate_expression(expression: o, github_path: github_path) {
        ExpressionEvaluationRefused { cause: c } => ExpressionEvaluationRefused { cause: c }
        ExpressionValue { value: v } => if gha_value_is_truthy(s: v) { ExpressionValue { value: "" } } else { ExpressionValue { value: "true" } }
      }
    LessThan { left: _, right: _ } => ExpressionEvaluationRefused { cause: UnmodeledNonStringForm }
    LessOrEqual { left: _, right: _ } => ExpressionEvaluationRefused { cause: UnmodeledNonStringForm }
    GreaterThan { left: _, right: _ } => ExpressionEvaluationRefused { cause: UnmodeledNonStringForm }
    GreaterOrEqual { left: _, right: _ } => ExpressionEvaluationRefused { cause: UnmodeledNonStringForm }
    FilteredContextAccess { context: _, path: _ } => ExpressionEvaluationRefused { cause: UnmodeledNonStringForm }
    BoolLiteral { value: _ } => ExpressionEvaluationRefused { cause: UnmodeledNonStringForm }
    NullLiteral => ExpressionEvaluationRefused { cause: UnmodeledNonStringForm }
    NumberLiteral { text: _ } => ExpressionEvaluationRefused { cause: UnmodeledNonStringForm }
  }
}
