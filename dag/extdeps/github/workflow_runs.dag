module extdeps.github.workflow_runs

import extdeps.github.github { GitHubUser, default_api_base, default_per_page, max_per_page }
import extdeps.github.errors { GitHubErrorShape }
import extdeps.transports.rest { RestOutcome }
import std.types { CommitSha, List, NonEmptyStr, String, Timestamp }
import std.credentials { EnvVar }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.github.workflow_runs_contracts {
  workflow_run_status_wire_contract,
  workflow_run_conclusion_wire_contract
}
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import std.decl_ref { decl_ref }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/actions/workflow-runs"
  }
}

type WorkflowRunStatus
  = Queued
  | InProgress
  | Completed
  | Waiting
  | Requested
  | Pending

type WorkflowRunConclusion
  = Success
  | Failure
  | Cancelled
  | Neutral
  | Skipped
  | TimedOut
  | ActionRequired
  | StartupFailure

// DECLARED FRONTIER for the two fields this change adds to WorkflowJobRun. They are not consumed
// in this change: the census that reads WorkflowJobRun today asks about starvation and has no use
// for either, and filling its fixtures with labels: [] and run_attempt: 1 is padding rather than
// consumption. Section 3c admits that state only with the trigger stated beside it, so it is
// stated rather than left for a reader to infer from the fields' own rationale.
data workflow_job_run_observed_runner_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.github.workflow_runs", decl_name: "WorkflowJobRun"),
    reason: "labels and run_attempt are added for a runtime-observation carrier that does not exist in this change: a row recording what a job's run ACTUALLY selected, joined to the workflow-source identity the file was read at, so a declared runner label and an observed one stay separable. The census that reads WorkflowJobRun today (gunbc.superseded_run_starvation_census) asks a different question and reads neither, so the fixture entries this change adds are shape-completion and not consumption. The fields are modelled here rather than in the consumer because they are what the upstream job resource returns",
    dissolution: unbound_dissolution(description: "a production fold outside test.claim reads WorkflowJobRun.labels and WorkflowJobRun.run_attempt - the capability being that an OBSERVED runner label and attempt reach a consumer that can tell them apart from the declared ones. NOT satisfied by a witness constructing a WorkflowJobRun, nor by a fixture carrying the fields, nor by a consumer that reads one of the two"),
  )
]

data conclusion_authority_consolidation_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.github.workflow_runs", decl_name: "WorkflowRunConclusion"),
    reason: "WorkflowRunConclusion (workflow runs REST API) and CheckConclusion (checks REST API, extdeps.github.checks) share 7 of 8 variants: WorkflowRunConclusion adds StartupFailure, CheckConclusion adds Stale. These are genuinely different API shapes today",
    dissolution: unbound_dissolution(description: "GitHub API unifies conclusion values across both APIs, or std gains a tagged-union type allowing a shared core with API-specific extensions"),
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.github.actions_runs", decl_name: "RunConclusion"),
    reason: "UNLIKE THE ROW ABOVE, THIS IS NOT TWO APIS SHARING VARIANTS -- IT IS ONE API WITH TWO AUTHORITIES IN THIS TREE. extdeps.github.actions_runs and extdeps.github.workflow_runs both declare extdeps_external_authority_anchor with the locator docs.github.com/en/rest/actions/workflow-runs, character for character, and each then models that upstream independently. The conclusion vocabulary is forked (RunConclusion carries RunStale and a RunConclusionUnknown { spelling } fail-closed arm; WorkflowRunConclusion has neither and handles an unknown spelling as an optional parse), and so is the record (WorkflowRunRecord holds status and conclusion as String with epoch Ints; WorkflowRun holds WorkflowRunStatus, WorkflowRunConclusion?, CommitSha and Timestamp). By DESIGN section 3 that is a meaning fork over one cited spec rather than two shapes, and by section 2's deep direction the stringly record is the anemic side. This row DECLARES the fork so it is countable; it does not consolidate it, and consolidating it is a change against this upstream's authority with its own review",
    dissolution: unbound_dissolution(description: "one of the two modules stops answering for the workflow-runs REST API: its run-conclusion vocabulary and run record are deleted and every consumer resolves through the surviving module, so a reader asking what a workflow run IS reaches exactly one authority"),
  )
]

// THE DEPLOYED PULL REQUEST EMBEDDING. GitHub's workflow runs API embeds a pull_requests array
// when the run was triggered by a pull_request event; each element carries the PR number and
// head repository. Only the number is modeled here because that is what every consumer in this tree
// asks of it — adding head_repo/full_name and url would be modeling fields no consumer reads,
// which is a maintenance burden without a consumer, and the DESIGN §3 authority rule forbids
// modeling an upstream field that no code asks a question of (it is either dead code or a future
// question waiting to be answered with no one to falsify it).
type WorkflowRunPullRequest {
  number: Int
}

// FIVE FIELDS THE RESPONSE CARRIES THAT NO CONSUMER COULD READ. actor, triggering_actor,
// event, head_branch and run_attempt are all in GitHub's workflow-run response and were absent
// from this projection, so a .dag consumer asking "which actor triggered this, on what event,
// and which attempt am I looking at" had to leave the provider model entirely -- gh api, raw
// JSON, or a status word copied out of the UI.
//
// THE RUN_ATTEMPT FIELD IS THE LOAD-BEARING ONE. A run object reports created_at from attempt 1
// and run_started_at from the LATEST attempt, naming neither, so a consumer that does not know
// which attempt it holds can compute a start delay that never happened. Without run_attempt the
// object cannot even say which attempt it describes.
//
// ACTOR AND TRIGGERING_ACTOR ARE TWO FACTS. The first is who the run is attributed to; the
// second is who caused this particular attempt. They diverge exactly when a human releases a
// withheld run: the actor stays the bot that pushed, and the triggering actor becomes the
// person who approved. A model carrying only one of them cannot distinguish an ordinary
// execution from a released one.
type WorkflowRun {
  id: Int
  name: String?
  path: String?
  head_sha: CommitSha
  head_branch: String?
  event: String
  status: WorkflowRunStatus
  conclusion: WorkflowRunConclusion?
  workflow_id: Int
  run_number: Int
  run_attempt: Int
  actor: GitHubUser?
  triggering_actor: GitHubUser?
  html_url: NonEmptyStr
  created_at: Timestamp
  updated_at: Timestamp
  pull_requests: List<WorkflowRunPullRequest>
}

type WorkflowRunList {
  total_count: Int
  workflow_runs: List<WorkflowRun>
}

// THE JOB-RUN RESOURCE, separate from the job SYNTAX (type Job in extdeps.github.actions).
// The API returns a list of job runs — each is one execution of a workflow job against a
// specific commit — with timestamps and conclusion. The `steps` field is excluded because
// no census consumer reads individual step data; if a future consumer needs it, adding it
// here is a backward-compatible extension (the field is optional in the API response and
// would become an optional field here).
// WHY THE TWO ADDED FIELDS ARE NOT OPTIONAL RICHNESS.
//
// labels is THE OBSERVED RUNNER LABEL, and it is a different fact from the label the workflow
// file declared. A `runs-on` written as an expression resolves at dispatch, so the YAML can
// establish an architecture while leaving the provider open - that is a real row in this
// fleet's workload census, where a job whose workflow offers a Ubicloud alternative was observed
// running on GitHub-hosted ubuntu-24.04-arm. Only the job resource settles it, and a consumer
// with no field to put it in has to treat the declaration as the observation.
//
// run_attempt is what makes a job identity re-findable. A re-run reuses run_id and mints new job
// ids, so (run_id, job_id) alone cannot say which attempt an observation belonged to, and a
// duration compared across attempts is comparing a cold run to a warm one.
//
// A THIRD FIELD WAS HERE AND IS NOT. runner_name was added in the same motion because the vendor's
// machine name is corroborating - the Biome baseline job reports "depot-1mw2k81zm2" - and then
// nothing read it, in this change or in the one that consumes the other two. Interesting is not a
// consumer. It is deleted rather than parked behind a frontier, because a frontier admits a
// declaration whose consumer LANDS IN A NAMED LATER CHANGE and there is no such change for it.
type WorkflowJobRun {
  id: Int
  run_id: Int
  run_attempt: Int
  name: String
  status: WorkflowRunStatus
  conclusion: WorkflowRunConclusion?
  labels: List<String>
  created_at: Timestamp?
  started_at: Timestamp?
  completed_at: Timestamp?
}

type WorkflowJobRunList {
  total_count: Int
  jobs: List<WorkflowJobRun>
}

fn parse_workflow_run_status(raw: String) -> WorkflowRunStatus? {
  match raw {
    "queued" => Present { value: Queued }
    "in_progress" => Present { value: InProgress }
    "completed" => Present { value: Completed }
    "waiting" => Present { value: Waiting }
    "requested" => Present { value: Requested }
    "pending" => Present { value: Pending }
    _ => none
  }
}

fn workflow_run_status_wire_label(status: WorkflowRunStatus) -> String {
  match status {
    Queued => "queued"
    InProgress => "in_progress"
    Completed => "completed"
    Waiting => "waiting"
    Requested => "requested"
    Pending => "pending"
  }
}

fn parse_workflow_run_conclusion(raw: String) -> WorkflowRunConclusion? {
  match raw {
    "success" => Present { value: Success }
    "failure" => Present { value: Failure }
    "cancelled" => Present { value: Cancelled }
    "neutral" => Present { value: Neutral }
    "skipped" => Present { value: Skipped }
    "timed_out" => Present { value: TimedOut }
    "action_required" => Present { value: ActionRequired }
    "startup_failure" => Present { value: StartupFailure }
    _ => none
  }
}

fn workflow_run_conclusion_wire_label(conclusion: WorkflowRunConclusion) -> String {
  match conclusion {
    Success => "success"
    Failure => "failure"
    Cancelled => "cancelled"
    Neutral => "neutral"
    Skipped => "skipped"
    TimedOut => "timed_out"
    ActionRequired => "action_required"
    StartupFailure => "startup_failure"
  }
}

data structural_coverage_gap_workflow_run_codec_hand_rolled: List<String> = [
  "closure:consolidate_variant_string_mapping|parse_workflow_run_status/workflow_run_status_wire_label and parse_workflow_run_conclusion/workflow_run_conclusion_wire_label hand-roll the SnakeCase mapping already declared in the wire contracts. Dissolve when the codec-from-contract bridge derives decode and encode from CoproductWireContract rows directly."
]

// LISTATTEMPTJOBS EXISTS BECAUSE LISTJOBS PINS filter=latest INTO ITS QUERY, and that default is
// not a nuance. A withheld run that a human later releases has ZERO jobs on attempt 1 and a full
// set on attempt 2, so a latest-filtered read reports the release and calls it the original
// execution. Every question of the form "did this run actually execute when it was created" is a
// question about ONE attempt, and ListAttemptJobs is the only operation here that can ask it.
// GitHub documents the attempt-scoped path separately from the run-scoped one because they answer
// different questions: the attempt number is part of the resource, not a filter.
//
// THE ANNOTATION SITS ON THE SERVICE RATHER THAN THE OPERATION because an `operation` lives inside
// this declaration's body, and section 4c admits annotations only at module-item grain. An
// operation is not a module item, so per-operation rationale is not expressible; it belongs here
// or nowhere.
service github.WorkflowRuns {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_source: EnvVar { name: "GITHUB_TOKEN" }
  }

  operation GetRun {
    input {
      auth_token: Secret
      owner: String
      repo: String
      run_id: String
    }
    output {
      run: WorkflowRun
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}"
    }
    response {
      200 => WorkflowRun
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      500 => GitHubErrorShape
    }
  }

  operation ListForRef {
    input {
      auth_token: Secret
      owner: String
      repo: String
      head_sha: CommitSha
      per_page: Int = default_per_page
    }
    output {
      runs: WorkflowRunList
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/actions/runs",
      query: { head_sha: head_sha, per_page: per_page }
    }
    response {
      200 => WorkflowRunList
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      500 => GitHubErrorShape
    }
  }

  operation ListWorkflowRuns {
    input {
      auth_token: Secret
      owner: String
      repo: String
      workflow_name: String
      event: String
      created_range: String
      per_page: Int = max_per_page
      page: Int = 1
    }
    output {
      result: WorkflowRunList
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/actions/workflows/\{workflow_name\}/runs",
      query: {
        event: event,
        per_page: per_page,
        page: page,
        created: created_range
      }
    }
    response {
      200 => WorkflowRunList
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      500 => GitHubErrorShape
    }
  }

  operation ListAttemptJobs {
    input {
      auth_token: Secret
      owner: String
      repo: String
      run_id: String
      attempt_number: Int
      per_page: Int = max_per_page
    }
    output {
      result: WorkflowJobRunList
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/attempts/\{attempt_number\}/jobs",
      query: { per_page: per_page }
    }
    response {
      200 => WorkflowJobRunList
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      500 => GitHubErrorShape
    }
  }

  operation ListJobs {
    input {
      auth_token: Secret
      owner: String
      repo: String
      run_id: String
      per_page: Int = max_per_page
    }
    output {
      result: WorkflowJobRunList
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/jobs",
      query: { per_page: per_page, filter: "latest" }
    }
    response {
      200 => WorkflowJobRunList
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      500 => GitHubErrorShape
    }
  }
}
