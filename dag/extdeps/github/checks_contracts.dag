module extdeps.github.checks_contracts


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/checks/runs"
  }
}

data check_status_wire_contract: std.serialization.CoproductWireContract = {
  coproduct: "CheckStatus",
  encoding: StringVariant { naming: SnakeCase }
}

data check_conclusion_wire_contract: std.serialization.CoproductWireContract = {
  coproduct: "CheckConclusion",
  encoding: StringVariant { naming: SnakeCase }
}
