module extdeps.github.errors


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/rest/overview/resources-in-the-rest-api#client-errors"
  }
}

type GitHubErrorShape {
  message: String
  documentation_url: String?
}

data github_error_example: GitHubErrorShape = {
  message: "Not Found",
  documentation_url: "https://docs.github.com/rest"
}
