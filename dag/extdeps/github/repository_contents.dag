module extdeps.github.repository_contents

import std.types { Int, List, NonEmptyStr, String, Secret }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.github.github { default_api_base }
import extdeps.github.errors { GitHubErrorShape }
import extdeps.transports.rest { RestOutcome, RestOk }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/repos/contents#get-repository-content"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.repository_contents",
      decl_name: "github.RepositoryContents",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// READING ONE FILE AT AN EXACT REF, WHICH IS WHAT TURNS A SEARCH HINT INTO AN IDENTITY.
//
// A code-search hit names a repository, a path and a blob sha at whatever revision GitHub's index
// held. That is not something a later reader can return to: the index moves, the default branch
// moves, and neither is recorded in the hit. This operation is what fixes the observation - the
// ref is a REQUIRED input, so there is no arm of this interface that reads "whatever the default
// branch says today", and the response carries the blob sha of exactly what came back.
//
// THE RETURNED sha IS THE ONE THAT MATTERS AND IT IS NOT THE COMMIT. GitHub returns the git BLOB
// sha of the file content, which is the identity a workflow-source observation is keyed by:
// two repositories with byte-identical workflow files share it, and a commit that does not touch
// the file does not change it. Measured 2026-09-10: biomejs/biome at commit
// 47d7383d049b36ff8eaba50912176928143dd9e9 returns .github/workflows/main.yml at blob
// 99f1255bbfa20a11197716a8fdb4c4e3359a588b, 5172 bytes, base64-encoded.
//
// ENCODING IS CARRIED RATHER THAN ASSUMED. The documented encoding for a file this size is
// base64, and the endpoint answers differently above one megabyte - it returns an empty content
// string with encoding "none" and expects the caller to use the blob or raw endpoint instead. A
// consumer that assumed base64 would silently decode an empty file into an empty workflow and
// find no jobs in it, which is a fabricated observation rather than a refusal. The field is here
// so that arm is representable and can be refused by whoever reads it.
type RepositoryFileContent {
  name: String
  path: String
  sha: String
  size: Int
  encoding: String
  content: String
}

data contents_base64_encoding: String = "base64"
data contents_absent_encoding: String = "none"

data hermetic_repository_file_path: String = ".github/workflows/main.yml"
data hermetic_repository_file_name: String = "main.yml"
data hermetic_repository_file_blob_sha: String = "99f1255bbfa20a11197716a8fdb4c4e3359a588b"
data hermetic_repository_file_size: Int = 5172
data hermetic_repository_file_encoding: String = "base64"
data hermetic_repository_file_content: String = "aGVybWV0aWMtZml4dHVyZS1ub3QtdGhlLXJlYWwtZmlsZQ=="
data hermetic_repository_file_outcome: RestOutcome = RestOk

service github.RepositoryContents {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_input: auth_token
  }

  operation GetContent {
    input {
      auth_token: Secret
      owner: String
      repo: String
      path: String
      ref: String
    }
    output {
      file: RepositoryFileContent
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/contents/\{path\}",
      query: { ref: ref }
    }
    response {
      200 => RepositoryFileContent
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      500 => GitHubErrorShape
    }
    mock_response {
      200 => {
        file: {
          name: hermetic_repository_file_name,
          path: hermetic_repository_file_path,
          sha: hermetic_repository_file_blob_sha,
          size: hermetic_repository_file_size,
          encoding: hermetic_repository_file_encoding,
          content: hermetic_repository_file_content
        },
        outcome: hermetic_repository_file_outcome
      } "hermetic decoded-200 shape for the repository-contents read. The path, blob sha and size are the real 2026-09-10 reading for biomejs/biome at 47d7383d; the CONTENT is deliberately a fixture marker rather than the real file, because a mock that carried 5172 real bytes would make a workflow reader look as if it had read GitHub when it had read a constant"
    }
  }
}
