module extdeps.github.auth

import extdeps.github.github { GitHubAuthToken, GitHubScope, ScopeGist, ScopeRepo }
import std.credentials { CredentialSource, EnvVar }
import extdeps.shell.credentials { env_credential }
import std.types { NonEmptyStr, Timestamp, Secret }
import extdeps.transports.rest { RestResult, RestRefused, RestRefusal, rest_credential_absent }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.coverage { CoverageClosureEntry, CoverageClosureFact }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/authentication"
  }
}

type GitHubTokenMetadataAuthority
  = DeclaredGitHubTokenMetadata { scopes: List<GitHubScope>, expires_at: Timestamp? }

type GitHubAuthSource {
  credential_source: CredentialSource
  token_metadata: GitHubTokenMetadataAuthority
}

data default_github_auth_source: GitHubAuthSource = {
  credential_source: EnvVar { name: "GITHUB_TOKEN" },
  token_metadata: DeclaredGitHubTokenMetadata {
    scopes: [ScopeRepo, ScopeGist],
    expires_at: none
  }
}

data structural_coverage_gap_github_token_metadata_verification: List<CoverageClosureEntry> = [
  {
    facts: [
      Subject { path: "GitHubAuthToken" },
      DeclaredMetadata { field: "scopes" },
      DeclaredMetadata { field: "expires_at" }
    ],
    trigger: "GitHub token introspection or installation-token issuance surface"
  }
]

// A TOKEN READ IS AN OBSERVATION, AND MAY FIND NOTHING. `env_credential` answers `token: Secret?`
// because the variable may be unset; this func used to reach the secret with a cast, so an unset
// GITHUB_TOKEN produced a `GitHubAuthToken` whose secret was the literal text `Absent` -- a forged
// credential indistinguishable from a real one at every later boundary.
//
// The absence is answered here, not carried further, so `GitHubAuthToken.token` KEEPS its
// non-optional `Secret`: that type still means a token was actually read. The refusal names the
// variable, because "no token" and "the wrong variable" are different problems for the caller and
// only the second is fixable by editing the auth source.
type GitHubAuthTokenRead
  = GitHubAuthTokenObserved { token: GitHubAuthToken }
  | GitHubAuthTokenUnavailable { variable: NonEmptyStr }

fn github_token() -> GitHubAuthTokenRead
{
  cred = match default_github_auth_source.credential_source {
    EnvVar { name } => env_credential(env_var: name as NonEmptyStr)
  }
  return match cred.token {
    Absent =>
      GitHubAuthTokenUnavailable {
        variable: match default_github_auth_source.credential_source {
          EnvVar { name } => name as NonEmptyStr
        }
      }
    Present { value: secret } =>
      GitHubAuthTokenObserved {
        token: {
          token: secret,
          scopes: match default_github_auth_source.token_metadata {
            DeclaredGitHubTokenMetadata { scopes, expires_at } => scopes
          },
          expires_at: match default_github_auth_source.token_metadata {
            DeclaredGitHubTokenMetadata { scopes, expires_at } => expires_at
          }
        }
      }
  }
}

// THE AMBIENT TOKEN IS SELECTED BY ITS CALLER, NOT BY THE TRANSPORT. A service that takes its token
// as an operation input once also declared `auth_source: EnvVar { name: "GITHUB_TOKEN" }`, and the
// interpreter fell back to that variable whenever the input was empty -- so `auth_token: ""` meant
// "whatever this process's environment holds", decided in the realization where no caller could see
// it, while the emitter for the same declaration ignored the input altogether. A caller that means
// the workflow's own token now says so by reading it here, and an unset variable is refused before
// any request is built: the refusal is the access decision's, so it reaches the caller as the typed
// RestCredentialRefused arm its existing RestRefused handling already eliminates.
fn github_token_absent_refusal(variable: NonEmptyStr) -> RestRefusal {
  rest_credential_absent(evidence: variable, profile: "extdeps.github.auth", action: "present a GitHub token")
}

// ONE PLACE A CALLER PRESENTS THE AMBIENT TOKEN. A caller passes the operation as a function of the
// token; the variable is read here and the refusal for an unset one is built here, so every call site
// is `github_rest(call: token => github.X.Op(auth_token: token, ...))` and the rule is written once.
fn github_rest<T>(call: fn(Secret) -> RestResult<T>) -> RestResult<T> {
  match github_token() {
    GitHubAuthTokenObserved { token } => call(token.token)
    GitHubAuthTokenUnavailable { variable } => RestRefused { refusal: github_token_absent_refusal(variable: variable) }
  }
}
