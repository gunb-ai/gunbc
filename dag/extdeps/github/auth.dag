module extdeps.github.auth



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/authentication"
  }
}

type GitHubTokenMetadataAuthority
  = DeclaredGitHubTokenMetadata { scopes: List<extdeps.github.github.GitHubScope>, expires_at: std.types.Timestamp? }

type GitHubAuthSource {
  credential_source: std.credentials.CredentialSource
  token_metadata: GitHubTokenMetadataAuthority
}

data default_github_auth_source: GitHubAuthSource = {
  credential_source: std.credentials.EnvVar { name: "GITHUB_TOKEN" },
  token_metadata: DeclaredGitHubTokenMetadata {
    scopes: [ScopeRepo, ScopeGist],
    expires_at: none
  }
}

data structural_coverage_gap_github_token_metadata_verification: List<extdeps.coverage.CoverageClosureEntry> = [
  {
    facts: [
      extdeps.coverage.Subject { path: "GitHubAuthToken" },
      extdeps.coverage.DeclaredMetadata { field: "scopes" },
      extdeps.coverage.DeclaredMetadata { field: "expires_at" }
    ],
    trigger: "GitHub token introspection or installation-token issuance surface"
  }
]

// A TOKEN READ IS AN OBSERVATION, AND MAY FIND NOTHING. `env_credential` answers `token: Secret?`
// because the environment variable it reads may be unset; this func used to reach the secret with a
// cast, so an unset GITHUB_TOKEN produced a `GitHubAuthToken` whose secret was the literal text
// `Absent` -- a forged credential indistinguishable from a real one at every later boundary.
//
// The absence is answered here rather than carried further, so `GitHubAuthToken.token` KEEPS its
// non-optional `Secret`: a value of that type still means a token was actually read. The refusal
// names the variable, because "no token" and "the wrong variable" are different problems for the
// caller and only the second is fixable by editing the auth source.
type GitHubAuthTokenRead
  = GitHubAuthTokenObserved { token: GitHubAuthToken }
  | GitHubAuthTokenUnavailable { variable: NonEmptyStr }

func github_token() -> GitHubAuthTokenRead
{
  cred = match default_github_auth_source.credential_source {
    EnvVar { name } => env_credential(env_var: name as std.types.NonEmptyStr)
  }
  return match cred.token {
    Absent =>
      GitHubAuthTokenUnavailable {
        variable: match default_github_auth_source.credential_source {
          EnvVar { name } => name as NonEmptyStr
        }
      }
    Present { value: secret } =>
      GitHubAuthTokenObserved {
        token: {
          token: secret,
          scopes: match default_github_auth_source.token_metadata {
            DeclaredGitHubTokenMetadata { scopes, expires_at } => scopes
          },
          expires_at: match default_github_auth_source.token_metadata {
            DeclaredGitHubTokenMetadata { scopes, expires_at } => expires_at
          }
        }
      }
  }
}
