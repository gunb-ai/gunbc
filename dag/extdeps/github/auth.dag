module extdeps.github.auth



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/authentication"
  }
}

type GitHubTokenMetadataAuthority
  = DeclaredGitHubTokenMetadata { scopes: List<extdeps.github.github.GitHubScope>, expires_at: std.types.Timestamp? }

type GitHubAuthSource {
  credential_source: std.credentials.CredentialSource
  token_metadata: GitHubTokenMetadataAuthority
}

data default_github_auth_source: GitHubAuthSource = {
  credential_source: std.credentials.EnvVar { name: "GITHUB_TOKEN" },
  token_metadata: DeclaredGitHubTokenMetadata {
    scopes: [ScopeRepo, ScopeGist],
    expires_at: none
  }
}

data structural_coverage_gap_github_token_metadata_verification: List<extdeps.coverage.CoverageClosureEntry> = [
  {
    facts: [
      extdeps.coverage.Subject { path: "GitHubAuthToken" },
      extdeps.coverage.DeclaredMetadata { field: "scopes" },
      extdeps.coverage.DeclaredMetadata { field: "expires_at" }
    ],
    trigger: "GitHub token introspection or installation-token issuance surface"
  }
]

func github_token() -> extdeps.github.github.GitHubAuthToken
{
  cred = match default_github_auth_source.credential_source {
    std.credentials.EnvVar { name } => env_credential(env_var: name as std.types.NonEmptyStr)
  }
  return {
    token: cred.token,
    scopes: match default_github_auth_source.token_metadata {
      DeclaredGitHubTokenMetadata { scopes, expires_at } => scopes
    },
    expires_at: match default_github_auth_source.token_metadata {
      DeclaredGitHubTokenMetadata { scopes, expires_at } => expires_at
    }
  }
}
