module extdeps.github.log_annotations

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/using-workflows/workflow-commands-for-github-actions"
  }
}

// THERE IS NO WARNING ARM, and its absence is the construction rather than a rule.
//
// AnnotationWarning was declared here with zero production constructors anywhere in the
// tree, which is exactly the state in which a variant costs nothing to delete and
// everything to keep: it stood available as the cheap way to report something that
// nobody would then have to act on. A GitHub warning annotation cannot fail a step —
// only exit codes can — and annotations cap at ten warnings and ten errors per step, so
// a warning is neither blocking nor reliably visible. The receipt is in the tree's own
// history: an output-policy probe named a function outside its entry closure, warned on
// every run from the day it landed, and the feature it gated never once executed,
// because the arm kept the run green.
//
// A NOTICE IS NOT A QUIETER WARNING. A failure, refusal, degraded execution, unreadable
// policy, incomplete observation or exhausted retry may NOT realize as AnnotationNotice.
// Without that invariant the deleted arm returns one rung down under a non-blocking
// spelling and nothing has changed. A notice reports something true and non-terminal
// that requires no action; anything requiring action is an error and exits nonzero.
type LogAnnotation
  = AnnotationError { message: String, file: String?, line: Int?, col: Int? }
  | AnnotationNotice { message: String, file: String?, line: Int?, col: Int? }
  | AnnotationGroup { title: String }
  | AnnotationEndGroup
  | SetOutput { name: String, value: String }
  | AddMask { value: String }
  | StopCommands { token: String }

data gha_log_command_error: String = "error"
data gha_log_command_notice: String = "notice"

fn gha_param_command_prefix(command: String) -> String {
  concat("::", concat(command, " "))
}

fn gha_message_command_prefix(command: String) -> String {
  concat("::", concat(command, "::"))
}

data annotation_error_prefix: String = gha_param_command_prefix(command: gha_log_command_error)
data annotation_notice_prefix: String = gha_param_command_prefix(command: gha_log_command_notice)
data annotation_group_prefix: String = "::group::"
data annotation_endgroup: String = "::endgroup::"
data annotation_set_output_prefix: String = "::set-output name="
data annotation_add_mask_prefix: String = "::add-mask::"
data annotation_stop_commands_prefix: String = "::stop-commands::"

// GitHub reads a LOG LINE as a workflow command when the line begins with '::' — the same syntax the annotation prefixes above are built from. So any text this repo relays from a SUBJECT process (a child's captured stdout/stderr) can mint annotations in the parent run that no gunbc code authored: a red-control child whose stderr legitimately carries '::error::build verification: ...' annotates the parent as failing while the control PASSED. Neutralization is unconditional, not gated on a GitHub-target probe: a guard line-prefix is inert and readable on a plain terminal, so making it unconditional leaves no target-detection branch that could be wrong (DESIGN 5 — construction over validation). The guard is a PREFIX, not an escape of '::', because only the line-initial position is command-bearing; prefixing therefore neutralizes every command in the cited table at once, including ones GitHub adds later, without editing the subject's bytes.
data subject_text_line_guard: String = "| "

fn neutralize_workflow_commands(text: String) -> String {
  concat(subject_text_line_guard, replace(text, "\n", concat("\n", subject_text_line_guard)))
}

fn shell_single_quote(s: String) -> String {

  concat("'", replace(s, "'", "'\\''"), "'")
}

fn emit_line_shell(line: String) -> String {
  concat("printf '%s\\n' ", shell_single_quote(s: line))
}
