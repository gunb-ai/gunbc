module extdeps.github.log_annotations

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/using-workflows/workflow-commands-for-github-actions"
  }
}

type LogAnnotation
  = AnnotationError { message: String, file: String?, line: Int?, col: Int? }
  | AnnotationWarning { message: String, file: String?, line: Int?, col: Int? }
  | AnnotationNotice { message: String, file: String?, line: Int?, col: Int? }
  | AnnotationGroup { title: String }
  | AnnotationEndGroup
  | SetOutput { name: String, value: String }
  | AddMask { value: String }
  | StopCommands { token: String }

data gha_log_command_error: String = "error"
data gha_log_command_warning: String = "warning"
data gha_log_command_notice: String = "notice"

fn gha_param_command_prefix(command: String) -> String {
  concat("::", concat(command, " "))
}

fn gha_message_command_prefix(command: String) -> String {
  concat("::", concat(command, "::"))
}

data annotation_error_prefix: String = gha_param_command_prefix(command: gha_log_command_error)
data annotation_warning_prefix: String = gha_param_command_prefix(command: gha_log_command_warning)
data annotation_notice_prefix: String = gha_param_command_prefix(command: gha_log_command_notice)
data annotation_group_prefix: String = "::group::"
data annotation_endgroup: String = "::endgroup::"
data annotation_set_output_prefix: String = "::set-output name="
data annotation_add_mask_prefix: String = "::add-mask::"
data annotation_stop_commands_prefix: String = "::stop-commands::"

// GitHub reads a LOG LINE as a workflow command when the line begins with '::' — the same syntax the annotation prefixes above are built from. So any text this repo relays from a SUBJECT process (a child's captured stdout/stderr) can mint annotations in the parent run that no gunbc code authored: a red-control child whose stderr legitimately carries '::error::build verification: ...' annotates the parent as failing while the control PASSED. Neutralization is unconditional, not gated on a GitHub-target probe: a guard line-prefix is inert and readable on a plain terminal, so making it unconditional leaves no target-detection branch that could be wrong (DESIGN 5 — construction over validation). The guard is a PREFIX, not an escape of '::', because only the line-initial position is command-bearing; prefixing therefore neutralizes every command in the cited table at once, including ones GitHub adds later, without editing the subject's bytes.
data subject_text_line_guard: String = "| "

fn neutralize_workflow_commands(text: String) -> String {
  concat(subject_text_line_guard, replace(text, "\n", concat("\n", subject_text_line_guard)))
}

fn shell_single_quote(s: String) -> String {

  concat("'", replace(s, "'", "'\\''"), "'")
}

fn emit_line_shell(line: String) -> String {
  concat("printf '%s\\n' ", shell_single_quote(s: line))
}

// THE WORKFLOW-COMMAND LINE, ENCODED AS THE RUNNER PARSES IT (actions/toolkit packages/core
// src/command.ts: escapeData escapes %, CR and LF in the message; escapeProperty additionally escapes
// ':' and ','). One annotation is one line, so a multi-line message stays one command. Only the three
// message-bearing annotation arms are encoded here; the others carry no free text a relayed notice
// needs, and they refuse by returning Absent rather than minting a command this row has not modeled.
fn gha_escape_data(s: String) -> String {
  replace(replace(replace(s, "%", "%25"), "\r", "%0D"), "\n", "%0A")
}

fn gha_escape_property(s: String) -> String {
  replace(replace(gha_escape_data(s: s), ":", "%3A"), ",", "%2C")
}

fn gha_location_properties(file: String?, line: Int?, col: Int?) -> String {
  let f = match file { Present { value: v } => [concat("file=", gha_escape_property(s: v))]  Absent => [] }
  let l = match line { Present { value: v } => [concat("line=", to_string(v))]  Absent => [] }
  let c = match col { Present { value: v } => [concat("col=", to_string(v))]  Absent => [] }
  join(f.concat(l).concat(c), ",")
}

fn gha_message_command_line(command: String, message: String, file: String?, line: Int?, col: Int?) -> String {
  let props = gha_location_properties(file: file, line: line, col: col)
  concat(if props == "" { gha_message_command_prefix(command: command) } else { concat(gha_param_command_prefix(command: command), concat(props, "::")) }, gha_escape_data(s: message))
}

fn log_annotation_message_line(annotation: LogAnnotation) -> String? {
  match annotation {
    AnnotationError { message: m, file: f, line: l, col: c } => Present { value: gha_message_command_line(command: gha_log_command_error, message: m, file: f, line: l, col: c) }
    AnnotationWarning { message: m, file: f, line: l, col: c } => Present { value: gha_message_command_line(command: gha_log_command_warning, message: m, file: f, line: l, col: c) }
    AnnotationNotice { message: m, file: f, line: l, col: c } => Present { value: gha_message_command_line(command: gha_log_command_notice, message: m, file: f, line: l, col: c) }
    AnnotationGroup { title: _ } => Absent
    AnnotationEndGroup => Absent
    SetOutput { name: _, value: _ } => Absent
    AddMask { value: _ } => Absent
    StopCommands { token: _ } => Absent
  }
}
