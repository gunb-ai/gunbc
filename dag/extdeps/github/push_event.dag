module extdeps.github.push_event


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/webhooks/webhook-events-and-payloads#push"
  }
}

data push_event_note: String = "The push webhook payload's `before` member: the full commit SHA of the branch tip immediately before this push. GitHub documents that this is the zero SHA when a branch or tag is created. extdeps owns the wire shape; gunbc.diff_baseline owns the policy that maps it to an affected-set baseline."

data push_event_before_member: String = "before"

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.github.push_event",
      decl_name: "push_event_before_member",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type PushBeforeObservation
  = PushBeforeObserved { sha: std.types.CommitSha }
  | PushBeforeAbsent { detail: String }
  | PushBeforeZeroSha
  | PushBeforeMalformed { detail: String }
  | PushEventPayloadReadRefused { path: String, cause: String }

fn push_before_commit_sha_from_hex(hex: String) -> PushBeforeObservation {
  match extdeps.git.object_store.git_sha1_object_id(hex: hex) {
    Present { value: oid } =>
      PushBeforeObserved { sha: extdeps.git.object_store.git_object_id_wire_hex(oid: oid) as std.types.CommitSha }
    Absent =>
      PushBeforeMalformed { detail: "push event before member is not a valid git object id" }
  }
}

fn push_before_from_event_json(text: String) -> PushBeforeObservation {
  match extdeps.languages.json.parse.parse_json(s: text) {
    Absent =>
      PushBeforeMalformed { detail: "GITHUB_EVENT_PATH payload is not valid JSON" }
    Present { value: doc } =>
      match extdeps.languages.json.parse.json_object_unique_member(v: doc, key: push_event_before_member) {
        extdeps.languages.json.parse.JsonMemberAbsent =>
          PushBeforeAbsent { detail: "push event payload has no before member" }
        extdeps.languages.json.parse.JsonMemberDuplicated { count: _ } =>
          PushBeforeMalformed { detail: "push event payload before member is duplicated" }
        extdeps.languages.json.parse.JsonMemberNotAnObject =>
          PushBeforeMalformed { detail: "push event payload root is not a JSON object" }
        extdeps.languages.json.parse.JsonMemberFound { value: v } =>
          match v {
            extdeps.languages.json.emit.JsonString { value: sha } =>
              if sha == "" {
                PushBeforeAbsent { detail: "push event before member is empty" }
              } else if sha == extdeps.git.hooks.zero_sha {
                PushBeforeZeroSha
              } else {
                push_before_commit_sha_from_hex(hex: sha)
              }
            JsonNull => PushBeforeAbsent { detail: "push event before member is null" }
            JsonBool { value: _ } => PushBeforeMalformed { detail: "push event before member is not a string" }
            JsonNumber { lexeme: _ } => PushBeforeMalformed { detail: "push event before member is not a string" }
            JsonArray { elements: _ } => PushBeforeMalformed { detail: "push event before member is not a string" }
            JsonObject { members: _ } => PushBeforeMalformed { detail: "push event before member is not a string" }
          }
      }
  }
}

fn push_before_from_event_path(path: String) -> PushBeforeObservation {
  let read = extdeps.filesystem.filesystem_io.Filesystem.Read(path: path)
  if read.success {
    push_before_from_event_json(text: read.content)
  } else {
    PushEventPayloadReadRefused {
      path: path,
      cause: read.error
    }
  }
}

fn push_before_sha_is_zero(sha: String) -> Bool {
  sha == extdeps.git.hooks.zero_sha
}
