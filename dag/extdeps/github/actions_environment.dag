module extdeps.github.actions_environment


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/actions/reference/variables-reference"
  }
}

data actions_environment_note: String = "GitHub Actions default environment variables, modeled as the upstream contract rather than read ad hoc. Only the fact this lane needs is carried: GITHUB_SHA, which the cited reference defines as the commit SHA that triggered the workflow run.\n\nWHY THIS EXISTS AS AN UPSTREAM FACT AND NOT A git READ. A liveness claim of the form 'the observation reached the exact revision under test' is only evidence if the EXPECTED revision comes from somewhere other than the thing being tested. Deriving it with git rev-parse and then comparing it to an observation that also ran git rev-parse compares git to itself: it is true by construction, cannot fail, and would be reflection evidence standing in for the structural proof (DESIGN recurring failure modes). GITHUB_SHA is supplied by the workflow runner, independently of the repository checkout, so the comparison can actually fail -- which is what makes it a control.\n\nEVENT SEMANTICS, STATED BECAUSE THEY DECIDE WHETHER THE COMPARISON IS EVEN WELL-FORMED. For a pull_request event the cited reference defines GITHUB_SHA as the LAST MERGE COMMIT of the pull request merge branch, which is exactly what actions/checkout leaves at HEAD under its default ref. For a push event it is the pushed commit, likewise HEAD. So on both events the runner-supplied value and the checked-out HEAD denote the same commit, and a mismatch is a real defect (a shallow or pinned-ref checkout, a mid-run mutation, or an observation that read a different tree) rather than an expected difference. Any event whose checkout ref is configured away from the default breaks that correspondence, and the honest response there is a typed refusal rather than a relaxed comparison."

type ActionsShaObservation
  = ActionsShaObserved { sha: std.types.CommitSha }
  | ActionsShaMissing { detail: String }
  | ActionsShaEmpty { detail: String }

data github_sha_variable_name: String = "GITHUB_SHA"

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.github.actions_environment",
      decl_name: "github_sha_variable_name",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
