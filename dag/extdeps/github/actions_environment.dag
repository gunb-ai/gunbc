module extdeps.github.actions_environment

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { CommitSha, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/reference/variables-reference"
  }
}

data actions_environment_note: String = "GitHub Actions default environment variables, modeled as the upstream contract rather than read ad hoc. Only the fact this lane needs is carried: GITHUB_SHA, which the cited reference defines as the commit SHA that triggered the workflow run.\n\nWHY THIS EXISTS AS AN UPSTREAM FACT AND NOT A git READ. A liveness claim of the form 'the observation reached the exact revision under test' is only evidence if the EXPECTED revision comes from somewhere other than the thing being tested. Deriving it with git rev-parse and then comparing it to an observation that also ran git rev-parse compares git to itself: it is true by construction, cannot fail, and would be reflection evidence standing in for the structural proof (DESIGN recurring failure modes). GITHUB_SHA is supplied by the workflow runner, independently of the repository checkout, so the comparison can actually fail -- which is what makes it a control.\n\nEVENT SEMANTICS, STATED BECAUSE THEY DECIDE WHETHER THE COMPARISON IS EVEN WELL-FORMED. For a pull_request event the cited reference defines GITHUB_SHA as the LAST MERGE COMMIT of the pull request merge branch, which is exactly what actions/checkout leaves at HEAD under its default ref. For a push event it is the pushed commit, likewise HEAD. So on both events the runner-supplied value and the checked-out HEAD denote the same commit, and a mismatch is a real defect (a shallow or pinned-ref checkout, a mid-run mutation, or an observation that read a different tree) rather than an expected difference. Any event whose checkout ref is configured away from the default breaks that correspondence, and the honest response there is a typed refusal rather than a relaxed comparison."

type ActionsShaObservation
  = ActionsShaObserved { sha: CommitSha }
  | ActionsShaMissing { detail: String }
  | ActionsShaEmpty { detail: String }

data github_sha_variable_name: String = "GITHUB_SHA"

// THE RUN COORDINATES, carried here for the same reason GITHUB_SHA is: they are facts the RUNNER
// supplies, defined by the cited reference, and a consumer that reads them ad hoc is reading an
// upstream contract through a second, uncited naming scheme.
//
// THREE VARIABLES AND NOT ONE COMPOSED KEY. `gunbc.merge_admission_subject` composes run id,
// attempt and job into a single `WalkAttemptId` string, which is right for a path segment and
// wrong here: fusing them answers "are these the same attempt" while destroying "are these two
// attempts OF THE SAME RUN". A consumer needing to distinguish a re-run from a different run
// cannot recover the parts from the composite, so the parts are what this module carries and
// composition stays the caller's business.
//
// RUNNER_NAME IS NOT A RUN COORDINATE and is modeled separately below for that reason: the same
// run attempt can be dispatched to a different runner, and a runner is a machine rather than an
// identity of the work. It is carried because an observation's cost figures are only comparable
// across runs executed on comparable hardware.
data github_run_id_variable_name: String = "GITHUB_RUN_ID"
data github_run_attempt_variable_name: String = "GITHUB_RUN_ATTEMPT"
data github_runner_name_variable_name: String = "RUNNER_NAME"

// Missing and present-but-empty stay separate arms, exactly as they do for the sha above. Outside
// Actions every one of these is legitimately absent, which is a different fact from a runner that
// set the variable to nothing, and only the second is a defect in the environment.
type ActionsRunCoordinate
  = ActionsRunCoordinateObserved { value: String }
  | ActionsRunCoordinateMissing { variable: String }
  | ActionsRunCoordinateEmpty { variable: String }

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.actions_environment",
      decl_name: "github_sha_variable_name",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.github.actions_environment.extdeps_external_authority_anchor,
  further_citations: []
}
