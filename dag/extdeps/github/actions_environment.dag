module extdeps.github.actions_environment

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { CommitSha, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/reference/variables-reference"
  }
}

// GitHub Actions default environment variables, modeled as the upstream contract rather than read
// ad hoc. Only the fact this lane needs is carried: GITHUB_SHA, which the cited reference defines
// as the commit SHA that triggered the workflow run.
//
// WHY THIS EXISTS AS AN UPSTREAM FACT AND NOT A git READ. A liveness claim of the form 'the
// observation reached the exact revision under test' is only evidence if the EXPECTED revision
// comes from somewhere other than the thing being tested. Deriving it with git rev-parse and then
// comparing it to an observation that also ran git rev-parse compares git to itself: it is true by
// construction, cannot fail, and would be reflection evidence standing in for the structural proof
// (DESIGN recurring failure modes). GITHUB_SHA is supplied by the workflow runner, independently of
// the repository checkout, so the comparison can actually fail -- which is what makes it a control.
//
// EVENT SEMANTICS, STATED BECAUSE THEY DECIDE WHETHER THE COMPARISON IS EVEN WELL-FORMED. For a
// pull_request event the cited reference defines GITHUB_SHA as the LAST MERGE COMMIT of the pull
// request merge branch, which is exactly what actions/checkout leaves at HEAD under its default
// ref. For a push event it is the pushed commit, likewise HEAD. So on both events the
// runner-supplied value and the checked-out HEAD denote the same commit, and a mismatch is a real
// defect (a shallow or pinned-ref checkout, a mid-run mutation, or an observation that read a
// different tree) rather than an expected difference. Any event whose checkout ref is configured
// away from the default breaks that correspondence, and the honest response there is a typed
// refusal rather than a relaxed comparison.

type ActionsShaObservation
  = ActionsShaObserved { sha: CommitSha }
  | ActionsShaMissing { detail: String }
  | ActionsShaEmpty { detail: String }

data github_sha_variable_name: String = "GITHUB_SHA"

// THE RUN COORDINATES, carried here for the same reason GITHUB_SHA is: they are facts the RUNNER
// supplies, defined by the cited reference, and a consumer that reads them ad hoc is reading an
// upstream contract through a second, uncited naming scheme.
//
// THREE VARIABLES AND NOT ONE COMPOSED KEY. `gunbc.merge_admission_subject` composes run id,
// attempt and job into a single `WalkAttemptId` string, which is right for a path segment and
// wrong here: fusing them answers "are these the same attempt" while destroying "are these two
// attempts OF THE SAME RUN". A consumer needing to distinguish a re-run from a different run
// cannot recover the parts from the composite, so the parts are what this module carries and
// composition stays the caller's business.
//
// RUNNER_NAME IS NOT A RUN COORDINATE and is modeled separately below for that reason: the same
// run attempt can be dispatched to a different runner, and a runner is a machine rather than an
// identity of the work. It is carried because an observation's cost figures are only comparable
// across runs executed on comparable hardware.
data github_run_id_variable_name: String = "GITHUB_RUN_ID"
data github_run_attempt_variable_name: String = "GITHUB_RUN_ATTEMPT"
data github_runner_name_variable_name: String = "RUNNER_NAME"

// THE RUN'S REPOSITORY AND WORKFLOW REFERENCE, carried for the same reason the coordinates above
// are. GITHUB_REPOSITORY is `owner/repo`; GITHUB_WORKFLOW_REF is
// `owner/repo/.github/workflows/<file>@<ref>`, the one runner-supplied variable that names the
// workflow FILE a run executes -- the same path the reviewed fleet-desired admission binds through
// the workflow_run event's `path` member. A consumer proving "this run executed THIS workflow"
// reads it here rather than re-deriving the file from a workflow display name.
data github_repository_variable_name: String = "GITHUB_REPOSITORY"
data github_workflow_ref_variable_name: String = "GITHUB_WORKFLOW_REF"

// Missing and present-but-empty stay separate arms, exactly as they do for the sha above. Outside
// Actions every one of these is legitimately absent, which is a different fact from a runner that
// set the variable to nothing, and only the second is a defect in the environment.
type ActionsRunCoordinate
  = ActionsRunCoordinateObserved { value: String }
  | ActionsRunCoordinateMissing { variable: String }
  | ActionsRunCoordinateEmpty { variable: String }

// THE THREE OBSERVATIONS TOGETHER, BECAUSE TWO CONSUMERS ALREADY CARRIED THEM AS ONE FACT AND
// SPELLED IT TWICE. `gunbc.emit_subject_clean_frontier` held them as three loose fields on its
// observation context; the floor's terminal ledger was about to declare a second triple beside it.
// One concept named once, per DESIGN section 2 -- net concepts must not grow by re-invention.
//
// IT IS NAMED FOR WHAT IT OBSERVES AND NOT FOR A COORDINATE, DELIBERATELY. An earlier draft called
// this `ActionsRunLocation`, which would have put RUNNER_NAME inside a type whose name asserts it
// is part of the run coordinate -- contradicting, three declarations below its own comment, the
// rule stated above that RUNNER_NAME IS NOT A RUN COORDINATE. A type name is a claim about what
// its fields mean, and that claim would have licensed exactly the machine-flavored inference the
// separation exists to prevent. The run identity locates an EXECUTION; the runner names a MACHINE.
//
// THE RUNNER IS AN OPAQUE IDENTITY AND NOTHING MAY BE DERIVED FROM ITS SPELLING. A host family is
// not recoverable from a slot name by taking a prefix: `gunbc.build_cache_endpoint_observe` is the
// one place in this repository that decomposes a runner unit name, and it parses only an INDEX
// while taking the host from a CARRIED fact, refusing to `OwnerContextUndecided` rather than
// fabricating one. This type carries no accessor that splits the runner, and a host-family concept,
// if one is ever needed, is a separately modeled fact with its own evidence.
//
// ONE SHAPE, TWO POLICIES, AND THE RULE THAT DECIDES WHICH IS LIFETIME. Consumers legitimately
// differ on what to do about a partial observation, and the difference is not preference. A
// MEASUREMENT CONTEXT is consumed immediately by the thing that produced it, so a partial
// environment merely degrades a reading already in hand and rendering "UNSET:GITHUB_RUN_ID" keeps
// the population alive. A CITATION is consumed later by someone else, so a partial one rots
// silently at a distance and cannot be checked at the point of use -- it must refuse instead. Both
// are correct over this one shape, and neither should be "fixed" into the other.
type ActionsRunEnvironmentObservations {
  run_identity: ActionsRunCoordinate
  run_attempt: ActionsRunCoordinate
  runner: ActionsRunCoordinate
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.actions_environment",
      decl_name: "github_sha_variable_name",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.github.actions_environment.extdeps_external_authority_anchor,
  further_citations: []
}
