  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/graphql/reference/enums#mergestatestatus"
  }
}

type MergeStateStatus
  = Behind
  | Blocked
  | Clean
  | Dirty
  | Draft
  | HasHooks
  | Unknown
  | Unstable

data structural_coverage_gap_merge_state_graphql_transport: List<FrontierRow> = [
