type RunnerLifecycleSignal
  = ShutdownReceived
  | OperationCanceled

fn runner_lifecycle_log_fragment(signal: RunnerLifecycleSignal) -> String {
  match signal {
    ShutdownReceived => "The runner has received a shutdown signal"
    OperationCanceled => "The operation was canceled"
  }
}

type GitHubRunnerRegistrationStatus
  = GitHubRunnerOnline
  | GitHubRunnerOffline

data github_runner_registration_row_wire_note: String = "THE ORG RUNNERS ENDPOINT RETURNS id, name, status, busy, ephemeral, version, AND labels AS SEPARATE FIELDS. status IS online OR offline; busy IS its own boolean. version IS the runner software version string (the incident corpus pinned Actions Runner v2.334.0). None of these are folded into a single synthetic status enum."

type GitHubSelfHostedRunnerRegistration {
  id: std.nat.Nat
  name: std.types.NonEmptyStr
  status: GitHubRunnerRegistrationStatus
  busy: Bool
  ephemeral: Bool
  version: std.types.NonEmptyStr
  os: std.types.NonEmptyStr
  labels: List<std.types.NonEmptyStr>
}

data github_runner_registration_predicate_family_disposition: std.disposition.Disposition = Terminal {
  reason: "github_runner_registration_is_online is a total match over the closed GitHubRunnerRegistrationStatus coproduct; github_runner_registration_is_schedulable composes is_online and not-busy without a wildcard arm. nfr_residue_sites flags only top-level param-scrutinee matches with a wildcard false arm (cli_run green_control_total_fold_is_not_residue); field-scrutinee match reg.status is out of scope for the scan — NFR rows here would stale the roster."
}

fn github_runner_registration_is_online(reg: GitHubSelfHostedRunnerRegistration) -> Bool {
  match reg.status {
    GitHubRunnerOnline => true
    GitHubRunnerOffline => false
  }
}

fn github_runner_registration_is_schedulable(reg: GitHubSelfHostedRunnerRegistration) -> Bool {
  github_runner_registration_is_online(reg: reg) && !reg.busy
}
