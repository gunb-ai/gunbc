  ActionRelease, ActionManifestReading, JavaScriptAction, CompositeAction, DockerAction,
}

// actions/upload-artifact releases this repository has read. v4.6.2 is kept because it is the
// release every workflow here used until GitHub began executing its declared node20 under node24;
// it is the real producer the forced-substitution refusal is exercised against.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/actions/upload-artifact"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.action.upload_artifact",
      decl_name: "upload_artifact_manifest_readings",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data upload_artifact_v4_6_2: ActionRelease = ActionRelease {
  owner: "actions", repo: "upload-artifact", tag: "v4.6.2", commit: "ea165f8d65b6e75b540449e92b4886f43607fa02", subdirectory: none
}

data upload_artifact_v6_0_0: ActionRelease = ActionRelease {
  owner: "actions", repo: "upload-artifact", tag: "v6.0.0", commit: "b7c566a772e6b6bfb58ed0dc250532a479d7789f", subdirectory: none
}

// Each declaration below was read from the action.yml blob at the release's commit
// (extdeps.github.action_release action_manifest_of), 2026-09-18.
data upload_artifact_manifest_readings: List<ActionManifestReading> = [
  ActionManifestReading {
    action_release: upload_artifact_v4_6_2,
    declared: JavaScriptAction { node_major: 20 },
  },
  ActionManifestReading {
    action_release: upload_artifact_v6_0_0,
    declared: JavaScriptAction { node_major: 24 },
  },
]

// THE INPUTS A STEP PASSES TO THE ACTION (`with:`), read from action.yml at v6.0.0
// (github.com/actions/upload-artifact/blob/b7c566a772e6b6bfb58ed0dc250532a479d7789f/action.yml, 2026-11-04).
// Only the inputs this repository sets are modeled: name, path, if-no-files-found, retention-days and
// compression-level. overwrite and include-hidden-files are declared upstream and left at their defaults, so
// they are absent here rather than modeled with a value nobody passes.
//
// if-no-files-found, upstream: `warn` outputs a warning and does not fail the action, `error` fails it,
// `ignore` does neither. Its upstream default is warn, so a step that omits the input passes when nothing
// matched; which value a consumer wants is its own policy, not this module's.
type MissingFilesBehavior = NoFilesWarn | NoFilesError | NoFilesIgnore

fn missing_files_behavior_wire(behavior: MissingFilesBehavior) -> String {
  match behavior {
    NoFilesWarn => "warn"
    NoFilesError => "error"
    NoFilesIgnore => "ignore"
  }
}

// retention-days: 0 means the repository's default; upstream bounds it to 1..90 unless the repository
// raises the maximum. compression-level: 0..9, upstream default 6. Both are absent when not passed.
type UploadArtifactInputs {
  name: String
  path: String
  if_no_files_found: MissingFilesBehavior
  retention_days: Int?
  compression_level: Int?
}

// THE `with:` ENTRIES IN action.yml's INPUT NAMES, in one fixed order (name, path, if-no-files-found,
// retention-days, compression-level), so every step that uploads renders the same keys the same way.
fn upload_artifact_with(inputs: UploadArtifactInputs) -> List<YamlKeyValue> {
  let required = [
    kv(key: "name", value: yaml_string(s: inputs.name)),
    kv(key: "path", value: yaml_string(s: inputs.path)),
    kv(key: "if-no-files-found", value: yaml_string(s: missing_files_behavior_wire(behavior: inputs.if_no_files_found))),
  ]
  let retention = match inputs.retention_days {
    Present { value: d } => [kv(key: "retention-days", value: yaml_int(n: d))]
    Absent => []
  }
  let compression = match inputs.compression_level {
    Present { value: c } => [kv(key: "compression-level", value: yaml_int(n: c))]
    Absent => []
  }
  concat(concat(required, retention), compression)
}
