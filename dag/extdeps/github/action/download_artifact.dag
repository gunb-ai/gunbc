module extdeps.github.action.download_artifact

import std.types { List, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.github.action_release {
  ActionRelease, ActionManifestReading, JavaScriptAction, CompositeAction, DockerAction,
}

// actions/download-artifact releases this repository has read. v6.0.0 is kept as the case that
// proves the declaration must be read from the producer: its release notes announce Node 24
// support, and its action.yml still declares node20 -- node24 is declared first at v7.0.0.

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/actions/download-artifact"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.action.download_artifact",
      decl_name: "download_artifact_manifest_readings",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data download_artifact_v4_3_0: ActionRelease = ActionRelease {
  owner: "actions", repo: "download-artifact", tag: "v4.3.0", commit: "d3f86a106a0bac45b974a628896c90dbdf5c8093", subdirectory: none
}

data download_artifact_v6_0_0: ActionRelease = ActionRelease {
  owner: "actions", repo: "download-artifact", tag: "v6.0.0", commit: "018cc2cf5baa6db3ef3c5f8a56943fffe632ef53", subdirectory: none
}

data download_artifact_v7_0_0: ActionRelease = ActionRelease {
  owner: "actions", repo: "download-artifact", tag: "v7.0.0", commit: "37930b1c2abaa49bbe596cd826c3c89aef350131", subdirectory: none
}

// Each declaration below was read from the action.yml blob at the release's commit
// (extdeps.github.action_release action_manifest_of), 2026-09-18.
data download_artifact_manifest_readings: List<ActionManifestReading> = [
  ActionManifestReading {
    action_release: download_artifact_v4_3_0,
    declared: JavaScriptAction { node_major: 20 },
  },
  ActionManifestReading {
    action_release: download_artifact_v6_0_0,
    declared: JavaScriptAction { node_major: 20 },
  },
  ActionManifestReading {
    action_release: download_artifact_v7_0_0,
    declared: JavaScriptAction { node_major: 24 },
  },
]

// TWO NAMES FROM v7.0.0's action.yml (read at commit 37930b1c, 2026-11-13), the ones a by-id download is written with and read back through.
// `artifact-ids`: "IDs of the artifacts to download, comma-separated. Either inputs `artifact-ids` or `name` can be used, but not both." With `run-id`
// and `github-token`, src/download-artifact.ts lists THAT run's artifacts, keeps those whose id was named, and throws "None of the provided artifact IDs
// were found" when none is, so a completed single-id download fetched exactly that artifact of that run.
// `download-path`: the action's only output, "Path of artifact download", set by core.setOutput after every download in the step has finished, so a
// step that failed or did not run leaves it empty. The action reports no artifact id and no name.
data download_artifact_artifact_ids_input: String = "artifact-ids"
data download_artifact_download_path_output: String = "download-path"
