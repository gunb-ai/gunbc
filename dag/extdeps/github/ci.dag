module extdeps.github.ci


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/using-workflows/workflow-syntax-for-github-actions"
  }
}

data github_actions_workflows_dir: String = ".github/workflows"

type GitHubActionsWorkflowExtension
  = GitHubActionsWorkflowYml
  | GitHubActionsWorkflowYaml

type GitHubActionsWorkflowStemSegment = NonEmptyStr where brand("GitHubActionsWorkflowStemSegment")

type GitHubActionsWorkflowStem {
  segment: GitHubActionsWorkflowStemSegment
}

type GitHubActionsWorkflowFileRef {
  stem: GitHubActionsWorkflowStem
  extension: GitHubActionsWorkflowExtension
}
