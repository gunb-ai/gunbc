module extdeps.github.ci

import std.types { NonEmptyStr, brand }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/using-workflows/workflow-syntax-for-github-actions"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.ci",
      decl_name: "GitHubActionsWorkflowStemSegment",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data github_actions_workflows_dir: String = ".github/workflows"

type GitHubActionsWorkflowExtension
  = GitHubActionsWorkflowYml
  | GitHubActionsWorkflowYaml

type GitHubActionsWorkflowStemSegment = NonEmptyStr where brand("GitHubActionsWorkflowStemSegment")

type GitHubActionsWorkflowStem {
  segment: GitHubActionsWorkflowStemSegment
}

type GitHubActionsWorkflowFileRef {
  stem: GitHubActionsWorkflowStem
  extension: GitHubActionsWorkflowExtension
}
