module extdeps.github.rulesets

import extdeps.github.github { default_api_base, default_per_page }
import extdeps.github.errors { GitHubErrorShape }
import extdeps.external_authority { ExternalAuthority }
import extdeps.transports.rest { RestOutcome }
import extdeps.uri { Uri, Https }
import std.credentials { EnvVar }
import std.measure { Minute, minute, MergeQueueEntryCount, merge_queue_entry_count }
import v2.std.collection { Absent, Present }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/repos/rules"
  }
}

// THIS MODULE OWNS THE INTERFACE SHAPE OF GITHUB'S REPOSITORY RULESETS API AND NOTHING ELSE. Which
// ruleset this repository wants, which contexts it requires, and what to do when the live ruleset
// disagrees are business policy and live in gunbc.repo_ruleset — modelling them here would be the
// layer inversion DESIGN section 3 names, making the upstream authority carry a fact GitHub has no
// opinion about.
//
// THE WIRE RECORDS ARE THE DECODE SURFACE, THE COPRODUCTS ARE THE DOMAIN. GitHub's rule list is
// heterogeneous — a `deletion` rule carries no parameters, a `required_status_checks` rule a nested
// object — and open: GitHub adds rule types without asking. A closed coproduct decoded straight off
// the wire would either refuse on an upstream addition this repository does not care about or
// silently drop it. So the transport decodes into records whose type tag is the String GitHub sent,
// and the projections below carry every recognized tag into a closed type WITH an explicit
// unrecognized arm. An unmodeled rule arrives as a value a consumer must match on, never as an
// absence.

type RulesetEnforcement
  = RulesetDisabled
  | RulesetEvaluate
  | RulesetActive
  | UnrecognizedEnforcement { raw: String }

type RulesetTarget
  = BranchTarget
  | TagTarget
  | PushTarget
  | UnrecognizedTarget { raw: String }

type RulesetRuleType
  = DeletionRule
  | NonFastForwardRule
  | RequiredStatusChecksRule
  | RequiredLinearHistoryRule
  | RequiredSignaturesRule
  | PullRequestRule
  | CreationRule
  | UpdateRule
  | MergeQueueRule
  | UnrecognizedRuleType { raw: String }

// current_user_can_bypass is documented as one of never / pull_requests_only / always, and IT IS A
// FACT ABOUT THE READER, NOT ABOUT THE RULESET. GitHub answers it for the identity that made the
// request. The type is named for that: `ThisReaderCannotBypass` is what the response supports, and
// "nobody can bypass" is a DIFFERENT claim about a DIFFERENT subject -- the bypass_actors roster --
// which this field does not answer at any authorization level.
//
// The former spelling (`RulesetBypassStanding`, `BypassNever`) named the ruleset, and that is
// precisely the confusion that let a reader-relative "I cannot bypass" be read as "no bypass
// exists". The three inhabitants stay separate rather than collapsing the two grants into one arm
// with a mode: review 56496 established that `pull_requests_only` and `always` are different grants
// with different remedies, and an unrecognized standing is a third thing again -- GitHub's
// vocabulary moved and this reading is no longer established.
type ReaderBypassStanding
  = ThisReaderCannotBypass
  | ThisReaderCanBypassPullRequestsOnly
  | ThisReaderCanBypassAlways
  | UnrecognizedReaderBypassStanding { raw: String }

// THE ROSTER IS THE OTHER SUBJECT AND IT HAS AN UNAVAILABLE STATE, WHICH IS THE WHOLE POINT.
//
// bypass_actors answers "who may walk past this ruleset". GitHub OMITS the key when the roster is
// empty AND when the reading credential is not authorized to see it, and the response carries
// nothing that separates those. So an absent key is UNAVAILABLE, never EMPTY -- and only a
// complete, sufficiently authorized observation of an EMPTY roster establishes that no route
// around the ruleset exists.
//
// Collapsing unavailable into empty is the empty-observation narrow: it would let a credential of
// unknown visibility mint the strongest possible claim about a subject it never saw. The reader
// field records WHOSE observation this is, because the answer is relative to it.
type RulesetBypassActor {
  actor_type: String
  actor_id: Int
  bypass_mode: String
}

type BypassActorRosterObservation
  = BypassRosterObserved { actors: List<RulesetBypassActor> }
  | BypassRosterUnavailable { reader: NonEmptyStr, cause: NonEmptyStr }

type RequiredStatusCheckWire {
  context: String
  integration_id: Int
}

// ONE RECORD FOR A KEY GITHUB SENDS WITH DIFFERENT CONTENTS PER RULE TYPE, AND THE REASON IT IS
// NOT A COPRODUCT IS A TRANSPORT FACT RATHER THAN A MODELLING PREFERENCE.
//
// `parameters` is one JSON key whose object differs by the rule's `type`: a required_status_checks
// rule sends a strict policy and a roster, a merge_queue rule sends seven scheduling fields, a
// deletion rule sends nothing. The shape that says that is a coproduct discriminated on the type
// tag -- and it cannot be READ here. The REST realization decodes a nested object into an untagged
// map and the record is a static read-shape over it, so a coproduct arm would have no constructor
// tag to match on and every read would refuse. So the record is the UNION OF THE READABLE SHAPES,
// which is what the transport can actually answer.
//
// THAT IS SAFE ONLY BECAUSE EVERY READ IS GUARDED BY THE TYPE TAG FIRST. required_status_check_standing
// and merge_queue_standing each `filter` on the rule type before touching a field, so no field is
// ever read off a rule whose `parameters` object does not carry it. The guard is the invariant this
// shape depends on: a reader that folded over unfiltered rules would read a key GitHub never sent.
//
// NEXT-RUNG TRIGGER, named as the capability rather than as an artifact: a transport decode that
// carries a discriminator from the enclosing object into a tagged value, so `parameters` can be a
// coproduct selected by `type` and the guard becomes unnecessary rather than load-bearing. Until
// that exists, this is mitigatable-by-guard and is stated as such.
type RulesetRuleParametersWire {
  strict_required_status_checks_policy: Bool
  do_not_enforce_on_create: Bool
  required_status_checks: List<RequiredStatusCheckWire>
  check_response_timeout_minutes: Int
  grouping_strategy: String
  max_entries_to_build: Int
  max_entries_to_merge: Int
  merge_method: String
  min_entries_to_merge: Int
  min_entries_to_merge_wait_minutes: Int
}

type RulesetRuleWire {
  type: String
  parameters: RulesetRuleParametersWire?
}

type RulesetRefNameConditionWire {
  include: List<String>
  exclude: List<String>
}

type RulesetConditionsWire {
  ref_name: RulesetRefNameConditionWire
}

// THE DOCUMENTED 200 SHAPE OF A SINGLE RULESET. The response block below names it; the operations'
// `output` blocks flatten its top-level keys instead of carrying it as one field, for a mechanical
// reason: the REST realization projects a JSON object into the output record BY KEY, so an output
// field named `ruleset` looks for a `ruleset` key GitHub does not send and binds Null. Flattening
// keeps every documented field, in the documented spelling, reachable — and the response block
// keeps the shape itself named in one place.
type RulesetWire {
  id: Int
  name: String
  target: String
  enforcement: String
  current_user_can_bypass: String
  conditions: RulesetConditionsWire
  rules: List<RulesetRuleWire>
}

type RulesetSummaryWire {
  id: Int
  name: String
  target: String
  enforcement: String
}

fn parse_ruleset_enforcement(raw: String) -> RulesetEnforcement {
  if raw == "disabled" { RulesetDisabled }
  else { if raw == "evaluate" { RulesetEvaluate }
  else { if raw == "active" { RulesetActive }
  else { UnrecognizedEnforcement { raw: raw } } } }
}

fn ruleset_enforcement_wire_label(e: RulesetEnforcement) -> String {
  match e {
    RulesetDisabled => "disabled"
    RulesetEvaluate => "evaluate"
    RulesetActive => "active"
    UnrecognizedEnforcement { raw: r } => r
  }
}

fn parse_ruleset_target(raw: String) -> RulesetTarget {
  if raw == "branch" { BranchTarget }
  else { if raw == "tag" { TagTarget }
  else { if raw == "push" { PushTarget }
  else { UnrecognizedTarget { raw: raw } } } }
}

fn ruleset_target_wire_label(t: RulesetTarget) -> String {
  match t {
    BranchTarget => "branch"
    TagTarget => "tag"
    PushTarget => "push"
    UnrecognizedTarget { raw: r } => r
  }
}

fn parse_ruleset_rule_type(raw: String) -> RulesetRuleType {
  if raw == "deletion" { DeletionRule }
  else { if raw == "non_fast_forward" { NonFastForwardRule }
  else { if raw == "required_status_checks" { RequiredStatusChecksRule }
  else { if raw == "required_linear_history" { RequiredLinearHistoryRule }
  else { if raw == "required_signatures" { RequiredSignaturesRule }
  else { if raw == "pull_request" { PullRequestRule }
  else { if raw == "creation" { CreationRule }
  else { if raw == "update" { UpdateRule }
  else { if raw == "merge_queue" { MergeQueueRule }
  else { UnrecognizedRuleType { raw: raw } } } } } } } } } }
}

fn ruleset_rule_type_wire_label(t: RulesetRuleType) -> String {
  match t {
    DeletionRule => "deletion"
    NonFastForwardRule => "non_fast_forward"
    RequiredStatusChecksRule => "required_status_checks"
    RequiredLinearHistoryRule => "required_linear_history"
    RequiredSignaturesRule => "required_signatures"
    PullRequestRule => "pull_request"
    CreationRule => "creation"
    UpdateRule => "update"
    MergeQueueRule => "merge_queue"
    UnrecognizedRuleType { raw: r } => r
  }
}

fn parse_reader_bypass_standing(raw: String) -> ReaderBypassStanding {
  if raw == "never" { ThisReaderCannotBypass }
  else { if raw == "pull_requests_only" { ThisReaderCanBypassPullRequestsOnly }
  else { if raw == "always" { ThisReaderCanBypassAlways }
  else { UnrecognizedReaderBypassStanding { raw: raw } } } }
}

fn reader_bypass_standing_wire_label(b: ReaderBypassStanding) -> String {
  match b {
    ThisReaderCannotBypass => "never"
    ThisReaderCanBypassPullRequestsOnly => "pull_requests_only"
    ThisReaderCanBypassAlways => "always"
    UnrecognizedReaderBypassStanding { raw: r } => r
  }
}

// THE ROSTER IS NOT DECODED FROM THIS RESPONSE, AND THAT IS A REFUSAL RATHER THAN AN OMISSION.
// Adding a `bypass_actors` field to RulesetWire would decode an absent key to an empty list, which
// is exactly the conflation the type above exists to prevent -- and no field in the response says
// whether the reader was authorized to see the roster. So every observation built from this
// endpoint is Unavailable, carrying who asked and why the answer is not established. An
// authorized read is a different observation with its own producer, and it is what may mint
// BypassRosterObserved.
fn bypass_roster_unavailable_from_get(reader: NonEmptyStr) -> BypassActorRosterObservation {
  BypassRosterUnavailable {
    reader: reader,
    cause: "GitHub omits bypass_actors from GET /repos/{owner}/{repo}/rulesets/{id} when the roster is empty AND when the reading credential is not authorized to see it, and the response carries nothing that separates those two",
  }
}

fn ruleset_rule_wire_type(rule: RulesetRuleWire) -> RulesetRuleType {
  parse_ruleset_rule_type(raw: rule.type)
}

fn rule_is_required_status_checks(rule: RulesetRuleWire) -> Bool {
  match ruleset_rule_wire_type(rule: rule) {
    RequiredStatusChecksRule => true
    _ => false
  }
}

// THREE STATES, NOT AN EMPTY LIST. "Requires no status checks", "requires exactly these", and
// "carries more than one required_status_checks rule" are different facts with different remedies,
// and the first and third both render as [] under a projection returning a bare roster. The third
// is a refusal rather than a merge of the two rosters: GitHub admits at most one such rule per
// ruleset today, so two means the upstream shape moved and this module's reading of it is no longer
// established.
type RequiredStatusCheckStanding
  = NoRequiredStatusChecksRule
  | RequiredStatusChecks {
      contexts: List<String>
      strict: Bool
      do_not_enforce_on_create: Bool
    }
  | MultipleRequiredStatusChecksRules { count: Int }

fn required_status_check_standing(rules: List<RulesetRuleWire>) -> RequiredStatusCheckStanding {
  let matched = filter(rules, r => rule_is_required_status_checks(rule: r))
  if length(matched) == 0 {
    NoRequiredStatusChecksRule
  } else {
    if length(matched) > 1 {
      MultipleRequiredStatusChecksRules { count: length(matched) }
    } else {
      fold(matched, init: NoRequiredStatusChecksRule, f: fn(_, rule) {
        RequiredStatusChecks {
          contexts: map(rule.parameters.required_status_checks, c => c.context),
          strict: rule.parameters.strict_required_status_checks_policy,
          do_not_enforce_on_create: rule.parameters.do_not_enforce_on_create,
        }
      })
    }
  }
}

fn ruleset_rule_types(rules: List<RulesetRuleWire>) -> List<RulesetRuleType> {
  map(rules, r => ruleset_rule_wire_type(rule: r))
}

// THE MERGE_QUEUE RULE. GitHub's merge queue is configured as a ruleset rule, not as a repository
// setting, so it is decoded here beside the rule this repository already gates on. Its parameters
// are documented under the same rules API this module anchors on
// (docs.github.com/en/rest/repos/rules, the `merge_queue` entry of the rules array); the two
// enumerated fields carry GitHub's own SCREAMING spellings on the wire and are parsed into closed
// coproducts with an unrecognized arm, exactly as enforcement, target and bypass standing are.
//
// grouping_strategy IS THE FIELD THE WHOLE QUEUE TURNS ON, so it is decoded rather than skipped.
// ALLGREEN admits an entry only when it and every entry ahead of it in the group passed;
// HEADGREEN admits on the head entry's result alone, which re-opens exactly the joint-failure
// class a queue exists to close — two changes independently green and jointly broken. A queue
// running HEADGREEN is therefore a materially different guarantee wearing the same name, and this
// module's job is to make that difference readable rather than to have an opinion about it.
type MergeQueueGroupingStrategy
  = AllGreenGrouping
  | HeadGreenGrouping
  | UnrecognizedGroupingStrategy { raw: String }

// The queue's OWN merge method, which is a separate fact from what the repository allows: a queue
// configured to MERGE composes merge commits onto the default branch whatever
// allow_merge_commit says, because the queue merges as the app rather than as a person.
type MergeQueueMergeMethod
  = QueueMergeCommit
  | QueueSquash
  | QueueRebase
  | UnrecognizedQueueMergeMethod { raw: String }

fn parse_merge_queue_grouping_strategy(raw: String) -> MergeQueueGroupingStrategy {
  if raw == "ALLGREEN" { AllGreenGrouping }
  else { if raw == "HEADGREEN" { HeadGreenGrouping }
  else { UnrecognizedGroupingStrategy { raw: raw } } }
}

fn merge_queue_grouping_strategy_wire_label(g: MergeQueueGroupingStrategy) -> String {
  match g {
    AllGreenGrouping => "ALLGREEN"
    HeadGreenGrouping => "HEADGREEN"
    UnrecognizedGroupingStrategy { raw: r } => r
  }
}

fn parse_merge_queue_merge_method(raw: String) -> MergeQueueMergeMethod {
  if raw == "MERGE" { QueueMergeCommit }
  else { if raw == "SQUASH" { QueueSquash }
  else { if raw == "REBASE" { QueueRebase }
  else { UnrecognizedQueueMergeMethod { raw: raw } } } }
}

fn merge_queue_merge_method_wire_label(m: MergeQueueMergeMethod) -> String {
  match m {
    QueueMergeCommit => "MERGE"
    QueueSquash => "SQUASH"
    QueueRebase => "REBASE"
    UnrecognizedQueueMergeMethod { raw: r } => r
  }
}

fn rule_is_merge_queue(rule: RulesetRuleWire) -> Bool {
  match ruleset_rule_wire_type(rule: rule) {
    MergeQueueRule => true
    _ => false
  }
}

// THE WIRE CARRIES BARE NUMBERS AND THE DOMAIN DOES NOT, which is this module's stated split
// applied to the fields that bear units. GitHub's merge_queue `parameters` object sends plain JSON
// integers and is read as such; the STANDING is the domain, and there those numbers are a duration
// and a count of queue entries. std.measure already owns both, so carrying them as Int here would be a second
// authority for minutes and for cardinality (DESIGN section 2: net concepts must not grow by
// re-invention). The distinction is load-bearing rather than decorative: the two timeouts and the
// four entry counts are all bare integers on the wire, and only the carrier stops a wait in
// minutes being compared against a count of entries. Both carriers are imported from
// std.measure -- MergeQueueEntryCount sits with its Count siblings there rather than being minted
// here, so the count-at-unit-scale axis is not forked once per upstream that counts something.
// THREE STATES FOR THE SAME REASON RequiredStatusCheckStanding HAS THREE. "No queue is configured"
// and "a queue is configured with these settings" are different facts with different remedies, and
// both would render as a default-valued record under a projection returning bare settings. The
// third refuses rather than picking: GitHub admits at most one merge_queue rule per ruleset, so two
// means the upstream shape moved and this module's reading of it is no longer established.
type MergeQueueStanding
  = NoMergeQueueRule
  | MergeQueueConfigured {
      grouping_strategy: MergeQueueGroupingStrategy
      merge_method: MergeQueueMergeMethod
      check_response_timeout: Minute
      max_entries_to_build: MergeQueueEntryCount
      max_entries_to_merge: MergeQueueEntryCount
      min_entries_to_merge: MergeQueueEntryCount
      min_entries_to_merge_wait: Minute
    }
  | MultipleMergeQueueRules { count: Int }

fn merge_queue_standing(rules: List<RulesetRuleWire>) -> MergeQueueStanding {
  let matched = filter(rules, r => rule_is_merge_queue(rule: r))
  if length(matched) == 0 {
    NoMergeQueueRule
  } else {
    if length(matched) > 1 {
      MultipleMergeQueueRules { count: length(matched) }
    } else {
      fold(matched, init: NoMergeQueueRule, f: fn(_, rule) {
        MergeQueueConfigured {
          grouping_strategy: parse_merge_queue_grouping_strategy(raw: rule.parameters.grouping_strategy),
          merge_method: parse_merge_queue_merge_method(raw: rule.parameters.merge_method),
          check_response_timeout: minute(count: rule.parameters.check_response_timeout_minutes),
          max_entries_to_build: merge_queue_entry_count(count: rule.parameters.max_entries_to_build),
          max_entries_to_merge: merge_queue_entry_count(count: rule.parameters.max_entries_to_merge),
          min_entries_to_merge: merge_queue_entry_count(count: rule.parameters.min_entries_to_merge),
          min_entries_to_merge_wait: minute(count: rule.parameters.min_entries_to_merge_wait_minutes),
        }
      })
    }
  }
}

fn required_status_check_row(context: String, integration_id: Int) -> RequiredStatusCheckWire {
  RequiredStatusCheckWire { context: context, integration_id: integration_id }
}

// THE CONSTRUCTOR OMITS THE merge_queue FIELDS AND THAT IS DELIBERATE, NOT AN OVERSIGHT. This
// builds the rule GitHub is SENT, and the PUT body carries exactly the keys present; supplying
// zeroes for seven scheduling fields GitHub does not accept on a required_status_checks rule would
// be a fabricated value on the wire. An omitted field is unwritten rather than defaulted, so a read
// of one refuses -- which is the guard above restated at the write end.
fn required_status_checks_rule(
  checks: List<RequiredStatusCheckWire>,
  strict: Bool,
  do_not_enforce_on_create: Bool,
) -> RulesetRuleWire {
  RulesetRuleWire {
    type: ruleset_rule_type_wire_label(t: RequiredStatusChecksRule),
    parameters: RulesetRuleParametersWire {
      strict_required_status_checks_policy: strict,
      do_not_enforce_on_create: do_not_enforce_on_create,
      required_status_checks: checks,
    },
  }
}

fn parameterless_rule(t: RulesetRuleType) -> RulesetRuleWire {
  RulesetRuleWire { type: ruleset_rule_type_wire_label(t: t), parameters: none }
}

fn ref_name_conditions(include: List<String>, exclude: List<String>) -> RulesetConditionsWire {
  RulesetConditionsWire {
    ref_name: RulesetRefNameConditionWire { include: include, exclude: exclude }
  }
}

// GitHub's documented alias for "whatever this repository's default branch currently is". Naming
// the branch literally would fork the fact with the repository's own default_branch and go silently
// wrong the day it is renamed.
data default_branch_ref_alias: String = "~DEFAULT_BRANCH"

service github.Rulesets {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_source: EnvVar { name: "GITHUB_TOKEN" }

    rate_limit: { requests: 5000, per: hour, scope: core }
  }

  operation List {
    input {
      auth_token: Secret
      owner: String
      repo: String
      per_page: Int = default_per_page
    }
    output {
      rulesets: List<RulesetSummaryWire>
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/rulesets",
      query: { per_page: per_page }
    }
    response {
      200 => List<RulesetSummaryWire>
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation Get {
    input {
      auth_token: Secret
      owner: String
      repo: String
      ruleset_id: Int
    }
    output {
      id: Int
      name: String
      target: String
      enforcement: String
      current_user_can_bypass: String
      conditions: RulesetConditionsWire
      rules: List<RulesetRuleWire>
      outcome: RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/rulesets/\{ruleset_id\}"
    }
    response {
      200 => RulesetWire
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation Update {
    input {
      auth_token: Secret
      owner: String
      repo: String
      ruleset_id: Int
      name: String
      target: String
      enforcement: String
      conditions: RulesetConditionsWire
      rules: List<RulesetRuleWire>
    }
    output {
      id: Int
      name: String
      target: String
      enforcement: String
      current_user_can_bypass: String
      conditions: RulesetConditionsWire
      rules: List<RulesetRuleWire>
      outcome: RestOutcome
    }
    transport rest {
      method: PUT,
      path: "/repos/\{owner\}/\{repo\}/rulesets/\{ruleset_id\}",
      body: {
        name: name,
        target: target,
        enforcement: enforcement,
        conditions: conditions,
        rules: rules,
      }
    }
    response {
      200 => RulesetWire
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }
}
