module extdeps.github.checks


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/checks/runs"
  }
}

type CheckStatus
  = Queued
  | InProgress
  | Completed
  | Waiting
  | Pending
  | Requested

type CheckConclusion
  = ActionRequired
  | Cancelled
  | Failure
  | Neutral
  | Skipped
  | Stale
  | Success
  | TimedOut

data structural_coverage_gap_check_codec_hand_rolled: List<String> = [
  "parse_check_status/check_status_wire_label and parse_check_conclusion/check_conclusion_wire_label",
  "hand-roll the SnakeCase mappings already declared in check_status_wire_contract and",
  "check_conclusion_wire_contract. Dissolve when the codec-from-contract bridge derives",
  "decode and encode from CoproductWireContract rows directly, making these fns redundant."
]

fn parse_check_status(raw: String) -> CheckStatus? {
  if raw == "queued" { v2.std.optional.Present { value: Queued } }
  else { if raw == "in_progress" { v2.std.optional.Present { value: InProgress } }
  else { if raw == "completed" { v2.std.optional.Present { value: Completed } }
  else { if raw == "waiting" { v2.std.optional.Present { value: Waiting } }
  else { if raw == "pending" { v2.std.optional.Present { value: Pending } }
  else { if raw == "requested" { v2.std.optional.Present { value: Requested } }
  else { none } } } } } }
}

fn check_status_wire_label(s: CheckStatus) -> String {
  match s {
    Queued => "queued"
    InProgress => "in_progress"
    Completed => "completed"
    Waiting => "waiting"
    Pending => "pending"
    Requested => "requested"
  }
}

fn parse_check_conclusion(raw: String) -> CheckConclusion? {
  if raw == "action_required" { v2.std.optional.Present { value: ActionRequired } }
  else { if raw == "cancelled" { v2.std.optional.Present { value: Cancelled } }
  else { if raw == "failure" { v2.std.optional.Present { value: Failure } }
  else { if raw == "neutral" { v2.std.optional.Present { value: Neutral } }
  else { if raw == "skipped" { v2.std.optional.Present { value: Skipped } }
  else { if raw == "stale" { v2.std.optional.Present { value: Stale } }
  else { if raw == "success" { v2.std.optional.Present { value: Success } }
  else { if raw == "timed_out" { v2.std.optional.Present { value: TimedOut } }
  else { none } } } } } } } }
}

fn check_conclusion_wire_label(c: CheckConclusion) -> String {
  match c {
    ActionRequired => "action_required"
    Cancelled => "cancelled"
    Failure => "failure"
    Neutral => "neutral"
    Skipped => "skipped"
    Stale => "stale"
    Success => "success"
    TimedOut => "timed_out"
  }
}

fn check_conclusion_wire_optional(c: CheckConclusion?) -> String? {
  match c {
    v2.std.optional.Present { value: v } => v2.std.optional.Present { value: check_conclusion_wire_label(c: v) }
    v2.std.optional.Absent => none
  }
}

fn check_conclusion_is_success(c: CheckConclusion) -> Bool {
  match c {
    Success => true
    ActionRequired => false
    Cancelled => false
    Failure => false
    Neutral => false
    Skipped => false
    Stale => false
    TimedOut => false
  }
}

type CheckOutput {
  title: String?
  summary: String?
  annotations_count: Int
}

type CheckRun {
  id: Int
  name: String
  head_sha: std.types.CommitSha
  status: CheckStatus
  conclusion: CheckConclusion?
  started_at: std.types.Timestamp?
  completed_at: std.types.Timestamp?
  output: CheckOutput
  html_url: std.types.NonEmptyStr
}

type CheckRunList {
  total_count: Int
  check_runs: List<CheckRun>
}

service github.Checks {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_source: std.credentials.EnvVar { name: "GITHUB_TOKEN" }

    rate_limit: { requests: 5000, per: hour, scope: core }
    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 504] }
  }

  operation ListForRef {
    input {
      auth_token: Secret
      owner: String
      repo: String
      ref: String
      per_page: Int = default_per_page
    }
    output {
      result: CheckRunList
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/commits/\{ref\}/check-runs",
      query: { per_page: per_page }
    }
    response {
      200 => CheckRunList
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation CreateRun {
    input {
      auth_token: Secret
      owner: String
      repo: String
      name: String
      head_sha: std.types.CommitSha
      status: CheckStatus
      details_url: String
      external_id: String
    }
    output {
      result: CheckRun
    }
    transport rest {
      method: POST,
      path: "/repos/\{owner\}/\{repo\}/check-runs",
      body: {
        name: name,
        head_sha: head_sha,
        status: check_status_wire_label(s: status),
        details_url: details_url,
        external_id: external_id,
      }
    }
    response {
      201 => CheckRun
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation UpdateRun {
    input {
      auth_token: Secret
      owner: String
      repo: String
      check_run_id: Int
      status: CheckStatus
      conclusion: CheckConclusion?
      details_url: String
      output_title: String
      output_summary: String
    }
    output {
      result: CheckRun
    }
    transport rest {
      method: PATCH,
      path: "/repos/\{owner\}/\{repo\}/check-runs/\{check_run_id\}",
      body: {
        status: check_status_wire_label(s: status),
        conclusion: check_conclusion_wire_optional(c: conclusion),
        details_url: details_url,
        output: { title: output_title, summary: output_summary },
      }
    }
    response {
      200 => CheckRun
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }
}
