module extdeps.github.gists



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/gists/gists"
  }
}

type GistFile {
  filename: String
  content: String
  language: String?
  size: Int
}

type Gist {
  id: String
  description: String?
  public: Bool
  files: Map<String, GistFile>
  owner: extdeps.github.github.GitHubUser
  created_at: std.types.Timestamp
  updated_at: std.types.Timestamp
  html_url: std.types.NonEmptyStr
}

service github.Gist {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_input: auth_token

    rate_limit: { requests: 5000, per: hour, scope: core }
  }

  operation Create {
    input {
      description: String
      filename: String
      content: String
      public: Bool = false
      auth_token: Secret
    }
    output {
      id: std.types.GistId
      html_url: std.types.NonEmptyStr
    }
    transport rest {
      method: POST,
      path: "/gists",
      body: {
        description: description,
        public: public,
        files: { "\{filename\}": { content: content } }
      }
    }
    response {
      201 => Gist
      401 => GitHubErrorShape
      403 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }
}
