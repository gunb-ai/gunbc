module extdeps.github.pulls_contracts

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.serialization { CoproductWireContract, StringVariant, SnakeCase, ScreamingSnakeCase, StripPrefixAndSnakeCase }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/pulls/pulls"
  }
}

data pull_request_state_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.github.pulls", decl_name: "PullRequestState", field: WholeDeclaration },
  encoding: StringVariant { naming: SnakeCase }
}

// "open", "closed", "all" (docs.github.com/en/rest/pulls/pulls#list-pull-requests).
data pull_request_list_state_filter_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.github.pulls", decl_name: "PullRequestListStateFilter", field: WholeDeclaration },
  encoding: StringVariant { naming: StripPrefixAndSnakeCase { prefix: "ListState" } }
}

data review_state_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.github.pulls", decl_name: "ReviewState", field: WholeDeclaration },
  encoding: StringVariant { naming: ScreamingSnakeCase }
}

data review_event_wire_contract: CoproductWireContract = {
  coproduct: DeclarationRef { module_path: "extdeps.github.pulls", decl_name: "ReviewEvent", field: WholeDeclaration },
  encoding: StringVariant { naming: ScreamingSnakeCase }
}
