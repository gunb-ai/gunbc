  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.app",
      decl_name: "GitHubAppRegistration",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.github.app.extdeps_external_authority_anchor,
  further_citations: [
    extdeps.github.app.installation_auth_citation,
    extdeps.github.app.private_key_citation,
    extdeps.github.app.app_webhook_config_citation,
    extdeps.github.app.app_manifest_registration_citation,
    extdeps.github.app.app_install_citation,
    extdeps.github.app.app_manifest_conversion_citation,
    extdeps.github.app.get_an_app_citation,
    extdeps.github.app.list_app_installations_citation,
    extdeps.github.app.webhook_events_citation
  ]
}

// POST /app/installations/{installation_id}/access_tokens, cited by
// extdeps.github.org_admin_auth installation_token_citation. It authenticates AS THE APP -- the
// Bearer is an RS256 App JWT (extdeps.auth.jws), never an installation or user token -- and answers
// 201 with a token valid for one hour. The token is decoded straight into a Secret so it has no
// String life in this process. A mutation: a transport refusal is commit-ambiguous, and the caller
// classifies it through extdeps.transports.rest classify_rest_outcome as RestMutationExchange.
service github.AppInstallationAccessTokens {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_input: app_jwt
  }

  operation Create {
    input {
      app_jwt: Secret
      installation_id: Int
    }
    output {
      token: Secret from "token"
      outcome: RestOutcome
    }
    transport rest {
      method: POST,
      path: "/app/installations/\{installation_id\}/access_tokens",
      body: { }
    }
    response {
      201 => GitHubInstallationAccessTokenBody
    }
  }
}

type GitHubInstallationAccessTokenBody {
  token: String
  expires_at: String
}
