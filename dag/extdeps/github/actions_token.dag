    extdeps.github.app.IdTokenAxis => Present { value: "id-token" }
    extdeps.github.app.IssuesAxis => Present { value: "issues" }
    extdeps.github.app.MetadataAxis => none
    extdeps.github.app.ModelsAxis => Present { value: "models" }
    extdeps.github.app.PackagesAxis => Present { value: "packages" }
    extdeps.github.app.PagesAxis => Present { value: "pages" }
    extdeps.github.app.PullRequestsAxis => Present { value: "pull-requests" }
