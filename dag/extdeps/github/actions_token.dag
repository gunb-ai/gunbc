  match axis {
    extdeps.github.app.ActionsAxis => true
    extdeps.github.app.ContentsAxis => true
    extdeps.github.app.IdTokenAxis => true
    extdeps.github.app.IssuesAxis => true
    extdeps.github.app.PullRequestsAxis => true
    extdeps.github.app.ArtifactMetadataAxis => false
    extdeps.github.app.AttestationsAxis => false
    extdeps.github.app.ChecksAxis => false
    extdeps.github.app.CodeQualityAxis => false
    extdeps.github.app.DeploymentsAxis => false
    extdeps.github.app.DiscussionsAxis => false
    extdeps.github.app.MetadataAxis => false
    extdeps.github.app.ModelsAxis => false
    extdeps.github.app.PackagesAxis => false
    extdeps.github.app.PagesAxis => false
    extdeps.github.app.RepositoryProjectsAxis => false
    extdeps.github.app.SecurityEventsAxis => false
    extdeps.github.app.StatusesAxis => false
    extdeps.github.app.VulnerabilityAlertsAxis => false
    extdeps.github.app.WorkflowsAxis => false
    extdeps.github.app.AdministrationAxis => false
    extdeps.github.app.OrganizationSelfHostedRunnersAxis => false
  }
}

fn declared_level_for_axis(perms: extdeps.github.actions.WorkflowPermissions, axis: extdeps.github.app.GitHubPermissionAxis) -> extdeps.github.actions.PermissionLevel? {
  match axis {
    extdeps.github.app.ActionsAxis => perms.actions
    extdeps.github.app.ContentsAxis => perms.contents
    extdeps.github.app.IdTokenAxis => perms.id_token
    extdeps.github.app.IssuesAxis => perms.issues
    extdeps.github.app.PullRequestsAxis => perms.pull_requests
    extdeps.github.app.ArtifactMetadataAxis => none
    extdeps.github.app.AttestationsAxis => none
    extdeps.github.app.ChecksAxis => none
    extdeps.github.app.CodeQualityAxis => none
    extdeps.github.app.DeploymentsAxis => none
    extdeps.github.app.DiscussionsAxis => none
    extdeps.github.app.MetadataAxis => none
    extdeps.github.app.ModelsAxis => none
    extdeps.github.app.PackagesAxis => none
    extdeps.github.app.PagesAxis => none
    extdeps.github.app.RepositoryProjectsAxis => none
    extdeps.github.app.SecurityEventsAxis => none
    extdeps.github.app.StatusesAxis => none
    extdeps.github.app.VulnerabilityAlertsAxis => none
    extdeps.github.app.WorkflowsAxis => none
    extdeps.github.app.AdministrationAxis => none
    extdeps.github.app.OrganizationSelfHostedRunnersAxis => none
  }
}

type ActionsGrantResolution
  = ActionsGrantResolved { access: extdeps.github.app.GitHubAppPermissionAccess }
  | ActionsGrantNone
  | ActionsGrantScopeUnavailable
  | ActionsGrantAxisNotModeled
  | ActionsGrantDeclaredAccessInvalid {
      axis: extdeps.github.app.GitHubPermissionAxis
      declared: extdeps.github.app.GitHubAppPermissionAccess
      allowed: ActionsAccessSet
    }
  | ActionsGrantForkPolicyUnobserved

type ForkWriteVerdict
  = ForkWriteNotApplicable
  | ForkWriteAllowed
  | ForkWriteDowngradedToRead
  | ForkWritePolicyUnobserved

fn fork_write_verdict(grant: EffectiveActionsJobGrant) -> ForkWriteVerdict {
  match grant.origin {
    SameRepositoryOrigin => ForkWriteNotApplicable
    OriginNotApplicable => ForkWriteNotApplicable
    ForkedRepositoryOrigin => match grant.repository_policy {
      ActionsRepositoryPolicyUnobserved => ForkWritePolicyUnobserved
      ActionsRepositoryPolicyObserved { visibility: _, send_write_tokens_to_fork_pull_requests: _ } =>
        if fork_write_tokens_reachable(policy: grant.repository_policy) {
          ForkWriteAllowed
        } else {
          ForkWriteDowngradedToRead
        }
    }
  }
}

fn resolve_declared_write(grant: EffectiveActionsJobGrant) -> ActionsGrantResolution {
  match fork_write_verdict(grant: grant) {
    ForkWriteNotApplicable => ActionsGrantResolved { access: extdeps.github.app.AppAccessWrite }
    ForkWriteAllowed => ActionsGrantResolved { access: extdeps.github.app.AppAccessWrite }
    ForkWriteDowngradedToRead => ActionsGrantResolved { access: extdeps.github.app.AppAccessRead }
    ForkWritePolicyUnobserved => ActionsGrantForkPolicyUnobserved
  }
}

fn resolve_declared_access(
  grant: EffectiveActionsJobGrant,
  axis: extdeps.github.app.GitHubPermissionAxis,
  declared: extdeps.github.app.GitHubAppPermissionAccess
) -> ActionsGrantResolution {
  if !actions_access_set_admits(set: axis_allowed_actions_access(axis: axis), access: declared) {
    ActionsGrantDeclaredAccessInvalid {
      axis: axis,
      declared: declared,
      allowed: axis_allowed_actions_access(axis: axis)
    }
  } else {
    match declared {
      extdeps.github.app.AppAccessRead => ActionsGrantResolved { access: extdeps.github.app.AppAccessRead }
      extdeps.github.app.AppAccessWrite => resolve_declared_write(grant: grant)
    }
  }
}

fn effective_actions_grant(
  grant: EffectiveActionsJobGrant,
  name: extdeps.github.app.GitHubPermissionAxis
) -> ActionsGrantResolution {
  match axis_actions_permissions_key(axis: name) {
    Absent => match axis_intrinsic_token_grant(axis: name) {
      IntrinsicTokenGrantAbsent => ActionsGrantScopeUnavailable
      IntrinsicTokenGrantRead => ActionsGrantResolved { access: extdeps.github.app.AppAccessRead }
    }
    Present { value: _ } =>
      if !axis_modeled_by_workflow_permissions(axis: name) {
        ActionsGrantAxisNotModeled
      } else {
        match declared_level_for_axis(perms: grant.permissions, axis: name) {
          Absent => ActionsGrantNone
          Present { value: level } => match permission_level_access(level: level) {
            Absent => ActionsGrantNone
            Present { value: declared } =>
              resolve_declared_access(grant: grant, axis: name, declared: declared)
          }
        }
      }
  }
}

