// Two independent facts about one axis, deliberately NOT fused (operator
// correction 2026-08-06). `axis_actions_permissions_key` answers whether an
// axis is DECLARABLE in a workflow `permissions:` block. This answers what the
// job token carries when nothing is declared. Absence of a configurable key is
// therefore not absence of a grant, and conflating the two made the model call
// a grant observed on the live token structurally impossible.
//
// Metadata is the live specimen: it has no configurable `permissions:` key, yet
// the exact-head Actions job reports `Metadata: read`.
//
// Read-only by construction — there is no write variant, so an intrinsic grant
// can never authorize a write, and observing a write-carrying intrinsic axis
// would be a compile error at every consumer rather than a silent widening.
type IntrinsicTokenGrant
  = IntrinsicTokenGrantAbsent
  | IntrinsicTokenGrantRead

fn axis_intrinsic_token_grant(axis: extdeps.github.app.GitHubPermissionAxis) -> IntrinsicTokenGrant {
  match axis {
    extdeps.github.app.MetadataAxis => IntrinsicTokenGrantRead
    extdeps.github.app.ActionsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.ArtifactMetadataAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.AttestationsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.ChecksAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.CodeQualityAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.ContentsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.DeploymentsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.DiscussionsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.IdTokenAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.IssuesAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.ModelsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.PackagesAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.PagesAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.PullRequestsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.RepositoryProjectsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.SecurityEventsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.StatusesAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.VulnerabilityAlertsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.WorkflowsAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.AdministrationAxis => IntrinsicTokenGrantAbsent
    extdeps.github.app.OrganizationSelfHostedRunnersAxis => IntrinsicTokenGrantAbsent
  }
}

type ActionsAccessSet
  = ActionsAccessReadOrWrite
  | ActionsAccessWriteOnly
  | ActionsAccessReadOnly
  | ActionsAccessNotAvailable

fn axis_allowed_actions_access(axis: extdeps.github.app.GitHubPermissionAxis) -> ActionsAccessSet {
  match axis {
    extdeps.github.app.ActionsAxis => ActionsAccessReadOrWrite
    extdeps.github.app.ArtifactMetadataAxis => ActionsAccessReadOrWrite
    extdeps.github.app.AttestationsAxis => ActionsAccessReadOrWrite
    extdeps.github.app.ChecksAxis => ActionsAccessReadOrWrite
    extdeps.github.app.CodeQualityAxis => ActionsAccessReadOrWrite
    extdeps.github.app.ContentsAxis => ActionsAccessReadOrWrite
    extdeps.github.app.DeploymentsAxis => ActionsAccessReadOrWrite
    extdeps.github.app.DiscussionsAxis => ActionsAccessReadOrWrite
    extdeps.github.app.IdTokenAxis => ActionsAccessWriteOnly
    extdeps.github.app.IssuesAxis => ActionsAccessReadOrWrite
    extdeps.github.app.MetadataAxis => ActionsAccessNotAvailable
    extdeps.github.app.ModelsAxis => ActionsAccessReadOnly
    extdeps.github.app.PackagesAxis => ActionsAccessReadOrWrite
    extdeps.github.app.PagesAxis => ActionsAccessReadOrWrite
    extdeps.github.app.PullRequestsAxis => ActionsAccessReadOrWrite
    extdeps.github.app.RepositoryProjectsAxis => ActionsAccessNotAvailable
    extdeps.github.app.SecurityEventsAxis => ActionsAccessReadOrWrite
    extdeps.github.app.StatusesAxis => ActionsAccessReadOrWrite
    extdeps.github.app.VulnerabilityAlertsAxis => ActionsAccessReadOnly
    extdeps.github.app.WorkflowsAxis => ActionsAccessNotAvailable
    extdeps.github.app.AdministrationAxis => ActionsAccessNotAvailable
    extdeps.github.app.OrganizationSelfHostedRunnersAxis => ActionsAccessNotAvailable
  }
}

fn actions_access_set_admits(set: ActionsAccessSet, access: extdeps.github.app.GitHubAppPermissionAccess) -> Bool {
  match set {
    ActionsAccessNotAvailable => false
    ActionsAccessReadOrWrite => match access {
      extdeps.github.app.AppAccessRead => true
      extdeps.github.app.AppAccessWrite => true
    }
    ActionsAccessWriteOnly => match access {
      extdeps.github.app.AppAccessRead => false
      extdeps.github.app.AppAccessWrite => true
    }
    ActionsAccessReadOnly => match access {
      extdeps.github.app.AppAccessRead => true
      extdeps.github.app.AppAccessWrite => false
    }
  }
}

// DECLARABILITY, not possession — renamed from actions_token_can_carry with the
// intrinsic-grant correction. The token carries Metadata: read while Metadata
// is undeclarable, so a single "can carry" predicate answered two questions and
// had to be wrong about one of them. Ask effective_actions_grant for possession.
fn actions_token_may_declare_permission(name: extdeps.github.app.GitHubPermissionAxis) -> Bool {
  match axis_actions_permissions_key(axis: name) {
    Absent => false
    Present { value: _ } => match axis_allowed_actions_access(axis: name) {
      ActionsAccessNotAvailable => false
      ActionsAccessReadOrWrite => true
      ActionsAccessWriteOnly => true
      ActionsAccessReadOnly => true
    }
  }
}

data workflows_permission_name: extdeps.github.app.GitHubPermissionAxis = extdeps.github.app.WorkflowsAxis

// Declarability is sufficient here because an intrinsic grant is read-only by
// construction (IntrinsicTokenGrant has no write variant), so no intrinsic
// grant can authorize a workflow-file write. Workflows carries neither.
fn actions_token_may_write_workflow_files() -> Bool {
  actions_token_may_declare_permission(name: workflows_permission_name)
}

type GitHubWorkflowEvent
  = PullRequestEvent
  | PushEvent
  | WorkflowDispatchEvent
  | MergeGroupEvent
  | ScheduleEvent

type PullRequestOrigin
  = SameRepositoryOrigin
  | ForkedRepositoryOrigin
  | OriginNotApplicable

type RepositoryVisibility
  = PublicRepository
  | PrivateRepository

type ActionsRepositoryPolicyObservation
  = ActionsRepositoryPolicyUnobserved
  | ActionsRepositoryPolicyObserved {
      visibility: RepositoryVisibility
      send_write_tokens_to_fork_pull_requests: Bool
    }

fn fork_write_tokens_reachable(policy: ActionsRepositoryPolicyObservation) -> Bool {
  match policy {
    ActionsRepositoryPolicyUnobserved => false
    ActionsRepositoryPolicyObserved { visibility, send_write_tokens_to_fork_pull_requests: allowed } =>
      match visibility {
        PublicRepository => false
        PrivateRepository => allowed
      }
  }
}

type EffectiveActionsJobGrant {
  workflow: std.decl_ref.DeclarationRef
  job: std.decl_ref.DeclarationRef
  event: GitHubWorkflowEvent
  origin: PullRequestOrigin
  repository_policy: ActionsRepositoryPolicyObservation
  permissions: extdeps.github.actions.WorkflowPermissions
}

fn permission_level_access(level: extdeps.github.actions.PermissionLevel) -> extdeps.github.app.GitHubAppPermissionAccess? {
  match level {
    extdeps.github.actions.PermRead => Present { value: extdeps.github.app.AppAccessRead }
    extdeps.github.actions.PermWrite => Present { value: extdeps.github.app.AppAccessWrite }
    extdeps.github.actions.PermNone => none
  }
}

