  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.github.actions_token",
      decl_name: "EffectiveActionsJobGrant",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.github.actions_token.extdeps_external_authority_anchor,
  further_citations: [
    extdeps.github.actions_token.automatic_token_citation,
    extdeps.github.actions_token.app_permissions_citation
  ]
}
