data github_cli_exact_head_merge_note: String = "GitHub CLI documents --match-head-commit as the commit SHA the pull-request head must match to allow merge and --squash as the repository's squash strategy. The operation exposes termination as data because a nonzero result is a domain refusal the landing workflow must render and receipt, not an interpreter crash. It deliberately carries no --admin and no --auto: landing workflow v1 performs the one operator-clicked merge already admitted by the dashboard summary; merge-queue enqueue remains a later realization."

service github.CliPulls {
  operation ListOpenJson {
    input { repo: std.types.NonEmptyStr }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: [
        "gh", "pr", "list",
        "--repo", "{repo}",
        "--state", "open",
        "--limit", "1000",
        "--json", "number,title,url,headRefName,headRefOid,isDraft,state",
      ]
    }
  }

  operation SquashMergeExactHead {
    input {
      repo: std.types.NonEmptyStr
      pull_number: Int
      expected_head: std.types.CommitSha
    }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "gh", "pr", "merge", "{pull_number}",
        "--repo", "{repo}",
        "--squash",
        "--match-head-commit", "{expected_head}",
      ]
    }
  }
}

service github.Pulls {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_source: std.credentials.EnvVar { name: "GITHUB_TOKEN" }

    rate_limit: { requests: 5000, per: hour, scope: core }
  }

  operation List {
    input {
      auth_token: Secret
      owner: String
      repo: String
      state: PullRequestState = Open
      per_page: Int = default_per_page
    }
    output {
      pulls: List<PullRequest>
      outcome: extdeps.transports.rest.RestOutcome
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls",
      query: { state: state, per_page: per_page }
    }
    response {
      200 => List<PullRequest>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation Get {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      pr: PullRequest
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}"
    }
    response {
      200 => PullRequest
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation Diff {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      diff: String
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}",
      headers: { "Accept": "application/vnd.github.diff" },
      response_format: std.serialization.Text
    }
    response {
      200 => String
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation ListReviews {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      reviews: List<PullReview>
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews"
    }
    response {
      200 => List<PullReview>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation CreateReview {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
      commit_id: std.types.CommitSha
      body: String
      event: ReviewEvent = Comment
      comments: Json
    }
    output {
      id: Int from "id"
      html_url: std.types.NonEmptyStr from "html_url"
    }
    transport rest {
      method: POST,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/reviews",
      body: { commit_id: commit_id, body: body, event: event, comments: comments }
    }
    response {
      200 => PullReview
      401 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation ListComments {
    input {
      auth_token: Secret
      owner: String
      repo: String
      pull_number: Int
    }
    output {
      comments: List<ReviewComment>
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/pulls/\{pull_number\}/comments"
    }
    response {
      200 => List<ReviewComment>
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }
}

type PullReview {
  id: Int
  body: String
  state: ReviewState
  commit_id: std.types.CommitSha
  html_url: std.types.NonEmptyStr
}

data structural_coverage_gap_github_pull_review_response_residual: List<extdeps.coverage.CoverageClosureEntry> = [
  {
    facts: [
      extdeps.coverage.Subject { path: "PullReview" },
      extdeps.coverage.JsonPending { field: "node_id" },
      extdeps.coverage.JsonPending { field: "user" },
      extdeps.coverage.JsonPending { field: "pull_request_url" },
      extdeps.coverage.JsonPending { field: "_links" },
      extdeps.coverage.JsonPending { field: "submitted_at" },
      extdeps.coverage.JsonPending { field: "author_association" }
    ],
    trigger: "GitHub PullReview consumer needs full review response fidelity"
  }
]

type ReviewComment {
  id: Int
  node_id: String
  path: std.types.FilePath
  line: Int?
  original_line: Int?
  body: String
  html_url: std.types.NonEmptyStr
}
