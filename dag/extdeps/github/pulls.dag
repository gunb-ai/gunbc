module extdeps.github.pulls


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/pulls/pulls"
  }
}

data github_cli_pull_merge_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "cli.github.com/manual/gh_pr_merge"
  }
}

type PullRequestState = Open | Closed

type ReviewState = Pending | Commented | Approved | ChangesRequested | Dismissed

type ReviewEvent = Approve | RequestChanges | Comment | PendingEvent

type PullRequestRef {
  ref: std.types.GitRef
  sha: std.types.CommitSha
  label: String
}

type PullRequest {
  number: Int
  title: String
  body: String?
  state: PullRequestState
  html_url: std.types.NonEmptyStr
  user: extdeps.github.github.GitHubUser
  head: PullRequestRef
  base: PullRequestRef
  created_at: std.types.Timestamp
  updated_at: std.types.Timestamp
  merged_at: std.types.Timestamp?
  draft: Bool
}

data pull_timing_observation_provenance_note: String = "One-time GitHub REST pull on 2026-08-01 under this module's existing GET-pull authority. Each row is the PullRequest.created_at and PullRequest.merged_at pair returned by github.Pulls.Get, normalized once from the wire Timestamp strings to Unix epoch milliseconds so arithmetic consumers do not pretend Timestamp is subtractable. The source URL remains on every row and fetched_on makes staleness inspectable. PullRequest stays the one wire-response authority; PullTimingObservation is its cited, immutable arithmetic projection, not a second endpoint or response model."

type PullTimingObservation {
  pull_number: Int
  opened_at: std.types.EpochMs
  merged_at: std.types.EpochMs
  source_url: std.types.NonEmptyStr
  fetched_on: std.types.NonEmptyStr
}

fn pull_timing_observation(
  pull_number: Int,
  opened_at: std.types.EpochMs,
  merged_at: std.types.EpochMs,
  source_url: std.types.NonEmptyStr,
) -> PullTimingObservation {
  PullTimingObservation {
    pull_number: pull_number,
    opened_at: opened_at,
    merged_at: merged_at,
    source_url: source_url,
    fetched_on: "2026-08-01",
  }
}

