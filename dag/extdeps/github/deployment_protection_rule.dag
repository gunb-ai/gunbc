data extdeps_external_authority_anchor: ExternalAuthority = rule_authority

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: review_endpoint_ref
  },
  first_citation: extdeps.github.deployment_protection_rule.extdeps_external_authority_anchor,
  further_citations: [
    extdeps.github.deployment_protection_rule.rest_authority,
    extdeps.github.deployment_protection_rule.webhook_authority,
