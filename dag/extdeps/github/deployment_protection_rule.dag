module extdeps.github.deployment_protection_rule

// GitHub's CUSTOM DEPLOYMENT PROTECTION RULES, modeled from the upstream before any gunbc wiring
// (DESIGN.md §3b "model-before-implement": an upstream claim is authored by reading the upstream,
// and it names the field or endpoint it is about). This file states what GitHub accepts and
// returns when a deployment environment is gated by a GitHub App instead of by RequiredReviewers.
// It states no gunbc policy and grants nothing. That is a boundary it has to keep: DESIGN.md §3
// gives extdeps a dependency's INTERFACE SHAPE and nothing else, and §3b's External facts boundary
// puts product policy and this repository's own observations in the consuming layer. So this file
// says what credential kinds GitHub ACCEPTS, never which kind gunbc PERMITS; it enumerates the
// permission axes upstream exposes, never which set the gate App is allowed to hold; and it has no
// idea that an ntfy capability, a broker, or srv1 exists. Those decisions live in gunbc.auth --
// see gunbc.auth.deployment_gate_authorization.
//
// WHAT THIS FILE CANNOT SAY. Upstream documents no guarantee, either way, that a review is refused for
// a run whose deployment_protection_rule webhook the App never received. That silence is stated here as
// an upstream fact (rule_delivery_documented_guarantee); the inference drawn from it, the trial that
// settles it, and the route selected while it is open are all receipts and policy, and they live in
// gunbc.auth.deployment_gate_authorization (§3: observations this repository makes never become a
// property inside the upstream module).
//
// WHY A SEPARATE MODULE FROM extdeps.github.deployment_environments (which already models
// GitHubEnvironmentProtectionSettings): that file models the ENVIRONMENT side of the boundary —
// what protection is configured on an environment. This file models the DEPLOYMENT-RULE side — the
// webhook GitHub emits when a run reaches such an environment, the REST call that answers it, and
// the poll that shows what is waiting. They dissolve and change on different upstream clocks, and
// folding the rule into the environment file would let a change to the environment projection
// quietly carry a claim about the review API (§3: one authority per subject).
//
// THE ONE THING THIS MODEL MUST KEEP STRAIGHT: there are TWO review endpoints and they are NOT
// interchangeable. POST .../deployment_protection_rule answers a rule published by a GitHub App,
// and an App may answer ONLY its own rule; POST .../pending_deployments answers a human/team
// RequiredReviewers gate. Getting these backwards is this feature's whole failure mode: an App
// calling the human reviewer endpoint either fails, or — worse — succeeds while a human is still
// being asked, which is two authorities for one decision.

import std.types {
  String,
  Int,
  List,
  NonEmptyStr,
  HttpStatus,
}

import std.decl_ref {
  DeclarationRef,
  WholeDeclaration,
}
// Duration: std.measure is the authority. A "30 days" stored as an Int keeps its unit only in its
// name, so the unit rule (ctrl's mechanical blocker) is satisfied by the carrier, not by a comment.
import std.measure {
  Second,
  Minute,
  minute,
  minute_count,
  minute_to_second,
  measure_le,
  second,
  seconds_per_day,
}
// HttpMethod comes from the RFC authority rather than being re-minted per module (§2).
import extdeps.ietf.http_semantics {
  HttpMethod,
  GET,
  POST,
}
import extdeps.external_authority {
  ExternalAuthority,
  ExternalModelScope,
  ExternalSubjectRef,
  FactCitation,
}
import extdeps.uri {
  Uri,
  Https,
}
// The run's own conclusion vocabulary comes from the sibling Actions model rather than being
// re-minted here (§2): the broker verifies a waiting run THROUGH that record.
import extdeps.github.actions_runs {
  RunConclusion,
  RunFailure,
}
// The permission vocabulary is extdeps.github.app's, not re-minted here (§2).
import extdeps.github.app {
  GitHubPermissionAxis,
  ActionsAxis,
  DeploymentsAxis,
  GitHubAppPermissionAccess,
  AppAccessRead,
  AppAccessWrite,
  GitHubAppPermission,
}

// ---------------------------------------------------------------------------
// Authority anchors (each a page read on 2026-10-18)
// ---------------------------------------------------------------------------

// The how-to for building the rule: repository permissions, the webhook contract, and the
// installation-token step.
data rule_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/how-tos/deploy/configure-and-manage-deployments/create-custom-protection-rules"
  }
}

// THE OPENAPI IS READ AT A COMMIT, NOT AT A BRANCH. blob/main moves under the model: a field read
// today would be a different field tomorrow, and every "the schema requires ..." claim below would
// silently be about some other revision. The descriptions are therefore anchored to one commit of
// github/rest-api-description, and every `components/schemas` / `paths` sentence in this file is a
// claim about THAT blob.
data spec_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github/rest-api-description/blob/bb754941722779d8a5b3a2f25a5fbb7ce794e1ea/descriptions/api.github.com/api.github.com.json"
  }
}

// The pinned revision itself, as data so a re-pin is an auditable edit and a witness can read it.
// Pin date 2026-10-18, against descriptions/api.github.com/api.github.com.json, whose sha256 at
// this commit is 3177ad6a86ca04c57a9bef3fc24e28a339efb8eb040c6f950af3d3ed2fee7fa3.
data spec_pinned_commit: NonEmptyStr = "bb754941722779d8a5b3a2f25a5fbb7ce794e1ea"
data spec_pinned_path: NonEmptyStr = "descriptions/api.github.com/api.github.com.json"

fn spec_is_pinned_to_a_commit(commit: NonEmptyStr) -> Bool {
  commit == spec_pinned_commit
}

// The REST reference page carrying both review endpoints and the pending-deployments poll.
data rest_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/actions/workflow-runs"
  }
}

// The webhook event reference for the `deployment_protection_rule` payload.
data webhook_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/webhooks/webhook-events-and-payloads"
  }
}

// The environment REST reference: protection_rules[].type values and the wait_timer range.
data environment_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/deployments/environments"
  }
}

// The machine-readable source the field-level claims below were checked against.
data openapi_authority: ExternalAuthority = spec_authority

// Where the rule is ENABLED on an environment, and where the 30-day wait is stated. Read on
// 2026-10-18; this is the page the operator's UI steps are drawn from.
// The ceiling on ANY gate approval wait is stated once, on the limits reference — it is not a fact
// about custom rules, so it gets its own authority rather than riding on the custom-rule page.
data limits_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/reference/limits"
  }
}

data enablement_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/how-tos/deploy/configure-and-manage-deployments/configure-custom-protection-rules"
  }
}

// ---------------------------------------------------------------------------
// The webhook GitHub emits when a run reaches a rule-gated environment
// ---------------------------------------------------------------------------

// The event and its ONLY published activity type. A receiver that did not filter on the action
// would answer any future activity type with a review.
data rule_webhook_event_name: NonEmptyStr = "deployment_protection_rule"
data rule_webhook_action: NonEmptyStr = "requested"

// THE DELIVERED PAYLOAD, field for field, as the pinned blob describes it. It is typed as a record
// rather than as a bag of names, because that is the difference between a model that can refuse a
// fabricated field and one that cannot: `run_id`, `run_url`, `app_id` and a top-level
// `installation_id` are all PLAINSENSE shapes for this payload and NONE OF THEM EXIST. They were
// what this file asserted before the payload was read; a caller coded against them would have read
// nothing and had nothing to tell it so.
//
// THE SELECTED ROUTE READS NONE OF THIS. Discovery is by an earlier ungated
// job filing the request and a poll of the waiting run (see the plan carrier), so this record is
// the upstream fact AND the documented fallback route -- it is kept so that the fallback has a
// model to be built against, and so that this file cannot re-invent the payload again. The fields
// the fallback would consume are named by rule_webhook_consumed_fields.
// WHAT A TYPED PARSE PRODUCES, not what the wire guarantees. THE PIN GIVES THIS PAYLOAD NO `required`
// LIST AT ALL, so every one of its twelve top-level fields is optional as delivered: a handler that
// treats them as present is a handler that panics on a real delivery. This record is therefore the
// OUTPUT of a parse that has already proved each field arrived — obtainable only through
// rule_webhook_payload_from_wire below, which refuses with the name of what was missing.
type DeploymentProtectionRuleWebhookPayload {
  action: NonEmptyStr,
  environment: NonEmptyStr,
  event: NonEmptyStr,
  deployment_callback_url: NonEmptyStr,
  installation: RuleWebhookInstallation,
}

// WHAT THE WIRE ACTUALLY CARRIES, field by field, with nothing assumed. Optional<T> for every field,
// because that is what the pin says. A parse consumes this and produces the record above or a refusal.
type RuleWebhookWireFields {
  action: NonEmptyStr?,
  environment: NonEmptyStr?,
  event: NonEmptyStr?,
  deployment_callback_url: NonEmptyStr?,
  installation: RuleWebhookInstallation?,
}

// The refusal, named. A field that did not arrive is a fact about the delivery, and the reason has to
// survive to the log — "the payload had no environment" and "the payload was malformed" are different
// incidents, and the second is unactionable.
type RuleWebhookParseFailure {
  missing_field: NonEmptyStr,
}

type RuleWebhookParse
  = RuleWebhookParsed { payload: DeploymentProtectionRuleWebhookPayload }
  | RuleWebhookRefused { failure: RuleWebhookParseFailure }

fn rule_webhook_payload_from_wire(wire: RuleWebhookWireFields) -> RuleWebhookParse {
  match wire.action {
    Present { value: a } => match wire.environment {
      Present { value: e } => match wire.event {
        Present { value: v } => match wire.deployment_callback_url {
          Present { value: u } => match wire.installation {
            Present { value: i } =>
              RuleWebhookParsed {
                payload: DeploymentProtectionRuleWebhookPayload {
                  action: a,
                  environment: e,
                  event: v,
                  deployment_callback_url: u,
                  installation: i,
                },
              }
            Absent =>
              RuleWebhookRefused {
                failure: RuleWebhookParseFailure { missing_field: rule_webhook_field_installation },
              }
          }
          Absent =>
            RuleWebhookRefused {
              failure: RuleWebhookParseFailure { missing_field: rule_webhook_field_deployment_callback_url },
            }
        }
        Absent =>
          RuleWebhookRefused { failure: RuleWebhookParseFailure { missing_field: "event" } }
      }
      Absent =>
        RuleWebhookRefused { failure: RuleWebhookParseFailure { missing_field: rule_webhook_field_environment } }
    }
    Absent => RuleWebhookRefused { failure: RuleWebhookParseFailure { missing_field: "action" } }
  }
}

fn rule_webhook_parse_is_complete(parse: RuleWebhookParse) -> Bool {
  match parse {
    RuleWebhookParsed { payload: _ } => true
    RuleWebhookRefused { failure: _ } => false
  }
}

// `installation` is an OBJECT, not a bare integer — and at the pin it is exactly {id, node_id}, both
// required. It is NOT {id, node_id, account}: this file previously carried an `account_login` there,
// which is a field the pinned schema does not have, and a handler reading it would read nothing while
// looking like it had authenticated the sender. A model that read payload.installation as an Int would
// fail on the real delivery in a different way; both wrong shapes are worth naming.
type RuleWebhookInstallation {
  id: Int,
  node_id: NonEmptyStr,
}

// The fields the fallback route would actually consume. A NAMED SUBSET, and the claim is deliberately
// weaker than the record above: this file asserts the record's fields exist (cited), and asserts
// only that these three are what a webhook-driven rule needs.
data rule_webhook_consumed_fields: List<NonEmptyStr> = [
  rule_webhook_field_installation,
  rule_webhook_field_environment,
  rule_webhook_field_deployment_callback_url,
]

// The three consumed names, as rows so a citation can name one field.
data rule_webhook_field_installation: NonEmptyStr = "installation"
data rule_webhook_field_environment: NonEmptyStr = "environment"
data rule_webhook_field_deployment_callback_url: NonEmptyStr = "deployment_callback_url"

// EVERY top-level field the pinned blob gives this payload, in the upstream's spelling. The record
// above models only what a rule needs; this row is what stops that record from reading as an
// exhaustive list -- the payload also carries deployment, pull_requests, repository, organization and
// sender, which this route never consumes and which are therefore NOT typed (typing fields nobody
// reads is how a model ends up asserting shapes it never checked).
data rule_webhook_documented_field_names: List<NonEmptyStr> = [
  "action",
  "environment",
  "event",
  "sha",
  "ref",
  "deployment_callback_url",
  "deployment",
  "pull_requests",
  "repository",
  "organization",
  "installation",
  "sender",
]

// Fields the payload does NOT have, held as data because the red that matters is the negative one:
// each of these is something a plausible implementation would reach for, and each is absent.
data rule_webhook_absent_fields: List<NonEmptyStr> = [
  "run_id",
  "run_url",
  "app_id",
  "installation_id",
]

fn rule_webhook_payload_field_is_published(name: NonEmptyStr) -> Bool {
  rule_webhook_documented_field_names |> any(f => f == name)
}

// The installation id a webhook-driven rule would mint its token from is a field of the payload's
// installation OBJECT -- not a top-level key. Renaming either half reddens the fold rather than
// leaving a sentence true about nothing.
data rule_installation_id_payload_field: NonEmptyStr = rule_webhook_field_installation
data rule_installation_id_nested_field: NonEmptyStr = "id"

fn rule_installation_id_is_read_from(payload_field: NonEmptyStr) -> Bool {
  payload_field == rule_installation_id_payload_field
}

// THE REVIEW URL ON THE FALLBACK ROUTE. deployment_callback_url is GitHub's own pointer at the
// review endpoint for THAT run, so on the webhook route a review posted there cannot aim itself at a
// different run. On the SELECTED route there is no payload, so the callback is built from the
// verified run id instead -- see review_call. The pair is kept because it is the fallback's shape
// and because it is checkable.
type RuleReviewCallback {
  payload_field: NonEmptyStr,
  addresses: NonEmptyStr,
}

data rule_review_callback: RuleReviewCallback = RuleReviewCallback {
  payload_field: rule_webhook_field_deployment_callback_url,
  addresses: review_endpoint_path,
}

// THE ONE THING UPSTREAM SAYS ABOUT DELIVERY: NOTHING. The review endpoint is documented as a POST
// guarded by token permissions, and the webhook page documents its own delivery; neither states, in
// either direction, that a review is refused for a run whose deployment_protection_rule delivery the
// App never received. THAT SILENCE IS THE UPSTREAM FACT, and it is the only one this file may hold on
// the subject. What anyone concludes from it is an inference, the trial that settles it is an
// OBSERVATION THIS REPOSITORY MAKES, and the route chosen in the meantime is policy — all three live
// in gunbc.auth.deployment_gate_authorization, which is where a receipt can be recorded without
// turning an upstream model into a diary.
data rule_delivery_documented_guarantee: NonEmptyStr = "none: no documented guarantee either way"

fn rule_delivery_guarantee_is_documented() -> Bool {
  (rule_delivery_documented_guarantee as String) == "none: no documented guarantee either way"
}

// A rule is not compatible with a job whose environment is set to `deployment: false`, so an
// environment-bearing job is the only kind this rule can ever gate.
data rule_incompatible_job_setting: NonEmptyStr = "deployment: false"

// ---------------------------------------------------------------------------
// The REST calls
// ---------------------------------------------------------------------------

// The App's review call. Path params owner, repo, run_id. Success is 204 with no body — so "it
// returned 204" is the entire witness, and nothing about the deployment's fate can be read out of
// the response.
data review_endpoint_path: NonEmptyStr = "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/deployment_protection_rule"
data review_endpoint_method: HttpMethod = POST
data review_endpoint_success_status: HttpStatus = 204

// The body, from components/schemas in the OpenAPI description. It is an anyOf of two shapes, and
// the required pair differs between them:
//   review-custom-gates-state-required   required = [environment_name, state]   (comment optional)
//   review-custom-gates-comment-required required = [environment_name, comment] (no state at all)
// Only the FIRST carries a decision, and it is the one that releases a deployment — so the body is
// modelled as
// the record for that alternative, not as a field-name list a caller could build wrongly (§5).
// environment_name is required in BOTH alternatives: it is the environment this review releases, and
// it is never inferable from the run id (the path carries only owner, repo and run_id).
data review_endpoint_body_environment_name_field: NonEmptyStr = "environment_name"
data review_endpoint_body_state_field: NonEmptyStr = "state"
data review_endpoint_body_comment_field: NonEmptyStr = "comment"
data review_endpoint_body_alternatives: List<NonEmptyStr> = [
  "review-custom-gates-state-required",
  "review-custom-gates-comment-required",
]

// THE REQUEST THAT RELEASES A DEPLOYMENT. Three parts, each named: the environment released, the decision, and
// an optional human-readable reason. The two required parts are not optional in the type, so the
// request that "forgets" the environment — the one that would release one environment while the
// environment, or a review at no environment at all — cannot be written. The comment-only
// alternative is deliberately NOT representable here: it is schema-legal upstream but asserts no
// decision, and a caller that sent it would leave the deployment waiting while reading its own 204
// as an approval.
// THE REVIEW DECISION, as a closed sum. GitHub's own `state` enum is exactly these two values on
// BOTH review endpoints (the App's and the human one), so both bodies share this type and there is
// no third outcome to spell — and no validator to forget to call (§5: correctness by construction).
// The wire strings live in review_state_wire so a caller cannot invent one; review_state_from_wire
// is the only way in, and it returns Absent for anything GitHub would not accept.
type ReviewState
  = Approved
  | Rejected

fn review_state_wire(state: ReviewState) -> NonEmptyStr {
  match state {
    Approved => "approved"
    Rejected => "rejected"
  }
}

fn review_state_from_wire(name: NonEmptyStr) -> ReviewState? {
  if name == review_state_wire(state: Approved) {
    Present { value: Approved }
  } else if name == review_state_wire(state: Rejected) {
    Present { value: Rejected }
  } else {
    none
  }
}

type DeploymentProtectionRuleReview {
  environment_name: NonEmptyStr,
  state: ReviewState,
  comment: NonEmptyStr?,
}

fn review_body_field_names(review: DeploymentProtectionRuleReview) -> List<NonEmptyStr> {
  match review.comment {
    Present { value: _ } => [
      review_endpoint_body_environment_name_field,
      review_endpoint_body_state_field,
      review_endpoint_body_comment_field,
    ]
    Absent => [
      review_endpoint_body_environment_name_field,
      review_endpoint_body_state_field,
    ]
  }
}

// The App's fine-grained requirement for that call, from the REST reference's own note: this
// endpoint "works with the following fine-grained token types: GitHub App installation access
// tokens" and "The fine-grained token must have the following permission set: \"Deployments\"
// repository permissions (write)". The rule-creation page states the App's own permission setup,
// verbatim: "To the right of \"Actions,\" click the drop down menu and select Access: Read-only.
// To the right of \"Deployments,\" click the drop down menu and select Access: Read and write."
// Contents is NOT on that list — an App granted Contents:write for this job has been granted
// something the upstream never asked for. The same page's NOTE says GitHub Apps can only review
// their OWN custom deployment protection rules — a rule created by another app is not answerable
// by this identity.
//
// The AXIS and ACCESS vocabulary is extdeps.github.app's existing GitHubPermissionAxis /
// GitHubAppPermissionAccess (§2: one shape, bound by several tables — minting a second list of
// permission strings here would be the failed decomposition that file's own comment names). What is
// NEW here, and what these rows own, is only which axes this feature's App must hold.
data review_required_permission: GitHubAppPermission = GitHubAppPermission {
  name: DeploymentsAxis,
  access: AppAccessWrite,
}

// The documented permission set for the rule App: Actions read-only, Deployments read and write, and
// NOTHING else. Anything wider — Contents, Administration, Pull requests, Secrets — is an
// unrequested grant on a reviewer identity. Because the elements are
// GitHubAppPermission records rather than strings, a widening is a different value of an existing
// closed type, and the refusal below compares axes rather than substrings of a sentence.
data rule_app_permissions: List<GitHubAppPermission> = [
  GitHubAppPermission { name: ActionsAxis, access: AppAccessRead },
  GitHubAppPermission { name: DeploymentsAxis, access: AppAccessWrite },
]

// WHO MAY MAKE THE REVIEW CALL, as UPSTREAM STATES IT — the set of credential kinds GitHub accepts,
// and nothing more. WHICH of them gunbc permits is a §3d selection made in
// gunbc.auth.deployment_gate_authorization, scored by gunbc.auth.authorization_pattern_selection;
// this file takes no position, because a dependency's interface does not get to forbid what the
// dependency itself allows. An arm omitted here would be a false fact about GitHub, so both arms
// stay representable and the refusal lives in the consuming layer where it can change without
// touching an upstream model.
//   InstallationAccessToken — the REST page's own words: the endpoint "works with the following
//     fine-grained token types: GitHub App installation access tokens", needing "Deployments"
//     repository permissions (write).
//   OAuthClassicWithRepoScope — also accepted upstream: "OAuth app tokens and personal access tokens
//     (classic) need the repo scope to use this endpoint with a private repository."
type ReviewCredential
  = InstallationAccessToken
  | OAuthClassicWithRepoScope

data review_accepted_token_type: NonEmptyStr = "GitHub App installation access tokens"
data review_oauth_classic_scope: NonEmptyStr = "repo"

// The credential the model actually endorses, read from the upstream's own label rather than
// restated: a caller that offers a token type other than this one is not making a supported call.
fn review_credential_is_documented(token_type: NonEmptyStr) -> Bool {
  token_type == review_accepted_token_type
}

// GitHub's own worked example for this call, transcribed from the REST reference: the body it posts
// and the 204 it is answered with. A value of DeploymentProtectionRuleReview, so the example is
// checkable rather than describable. Whether its environment is THIS repository's gate is an
// observation gunbc makes, not an upstream fact — see gunbc.auth.deployment_gate_authorization
// .documented_example_is_not_the_gated_environment.
data review_documented_example_body: DeploymentProtectionRuleReview = DeploymentProtectionRuleReview {
  environment_name: "prod-eus",
  state: Approved,
  comment: Present { value: "All health checks passed." },
}

fn review_documented_example_is_complete() -> Bool {
  (review_body_field_names(review: review_documented_example_body) |> count) == 3
}

// The version header the reference sends with the call. Typed as a name/value pair so a fold can
// check the header is the one the docs pinned, rather than matching a whole string by eye.
type ReviewApiVersionHeader {
  name: NonEmptyStr,
  value: NonEmptyStr,
}

data review_documented_api_version_header: ReviewApiVersionHeader = ReviewApiVersionHeader {
  name: "X-GitHub-Api-Version",
  value: "2026-03-10",
}

fn review_api_version_header_is_pinned(header: ReviewApiVersionHeader) -> Bool {
  header.name == review_documented_api_version_header.name
    && header.value == review_documented_api_version_header.value
}

// THE POLL THAT SHOWS WHAT IS WAITING, and the record a caller verifies against before it acts.
// Read access to the repository is enough; no permission grant is needed to SEE the gate. The field
// rows are not decoration: PendingDeploymentWait is built from them, and the pre-answer
// check reads that record — the manager's requirement that the run id and environment are CONFIRMED
// against GitHub rather than taken on trust from the workflow that filed the request.
data pending_deployments_endpoint_path: NonEmptyStr = "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/pending_deployments"
data pending_deployments_endpoint_method: HttpMethod = GET
data pending_deployments_field_environment: NonEmptyStr = "environment"
data pending_deployments_field_wait_timer: NonEmptyStr = "wait_timer"
data pending_deployments_field_wait_timer_started_at: NonEmptyStr = "wait_timer_started_at"
data pending_deployments_field_current_user_can_approve: NonEmptyStr = "current_user_can_approve"
data pending_deployments_field_reviewers: NonEmptyStr = "reviewers"

// A WAITING ENVIRONMENT, as the poll reports it. Every field is required by the pending-deployment
// schema, so a wait that is missing the environment or the reviewer list cannot be constructed — and
// a caller therefore cannot verify a half-read response.
type PendingDeploymentWait {
  // AN OBJECT upstream, so an object here. components/schemas/pending-deployment gives `environment`
  // as {id, node_id, name, url, html_url}; a model that read it as a bare string was guessing. Only
  // the two fields this route consumes are typed (§3: model what is consumed).
  environment: PendingDeploymentEnvironment,
  // MINUTES, not seconds. The wait-timer schema in this module's own environment_authority says so
  // verbatim: "The amount of time to delay a job after the job is initially triggered. The time (in
  // minutes) must be an integer between 0 and 43,200 (30 days)", and pending-deployment carries the
  // same field with example 30. Typing it as Second and reading the wire value straight in would
  // have scaled every wait by 60: the legal maximum, 43,200 minutes, is exactly 30 days, but read as
  // seconds it is 12 hours. std.measure's Minute is the carrier and minute_to_second is the one
  // declared conversion, so the unit is stated by the type and cannot drift from the arithmetic.
  wait_timer: Minute,
  // When the timer BEGAN, if one is running. A Timestamp string as upstream reports it; the elapsed
  // time is this against the clock, NEVER this field confused with wait_timer (see the note on the
  // fold below that replaced the old ceiling check).
  wait_timer_started_at: NonEmptyStr?,
  current_user_can_approve: Bool,
  // WHO MAY ANSWER, as a closed sum over the upstream's own `type` enum (components/schemas/
  // deployment-reviewer-type: exactly User | Team), each arm carrying the identity it is. There is NO
  // App arm and NO installation id anywhere in this projection, because upstream has none: a
  // reviewer is a user or a team and nothing else. Before this was read, this file carried
  // reviewers: List<NonEmptyStr> and asked whether an installation id appeared in it — a question
  // that can only ever be answered "no", which is how a guard ends up permanently closed.
  reviewers: List<PendingDeploymentReviewer>,
}

// The nested environment object.
type PendingDeploymentEnvironment {
  id: Int,
  name: NonEmptyStr,
}

// A reviewer is a user or a team. Nothing else is representable, which is the point: the set is
// upstream's, and the absence of an App arm is a type-level fact rather than a comment.
type PendingDeploymentReviewer
  = UserReviewer { login: NonEmptyStr }
  | TeamReviewer { name: NonEmptyStr }

fn pending_deployment_reviewer_type_wire(reviewer: PendingDeploymentReviewer) -> NonEmptyStr {
  match reviewer {
    UserReviewer { login: _ } => "User"
    TeamReviewer { name: _ } => "Team"
  }
}

// THE RANGE UPSTREAM PUBLISHES, as carriers rather than as prose or as bare counts: "The time (in
// minutes) must be an integer between 0 and 43,200 (30 days)", where the maximum is exactly the 30-day
// ceiling. A count in a row named `_minutes` keeps its unit only in its name, and the field it bounds
// is a Minute -- so the bound is a Minute too and the comparison is carrier to carrier, with no
// minute_count in the middle silently re-labelling one side.
data wait_timer_minimum: Minute = minute(count: 0)
data wait_timer_maximum: Minute = minute(count: 43200)

// Is a read wait_timer a value upstream could actually return? This is where a unit slip has to be
// caught: 43,200 MINUTES is legal and 43,201 is not, while 43,200 SECONDS would be a legal-looking
// number whose meaning is off by sixty. Both comparisons are carrier to carrier through std.measure's
// own ordering, so there is no scalar in sight to mis-scale.
fn wait_timer_is_in_documented_range(timer: Minute) -> Bool {
  measure_le(a: wait_timer_minimum, b: timer) && measure_le(a: timer, b: wait_timer_maximum)
}

// The same quantity in the unit the timeout is counted in, via the one declared conversion. Kept
// because the 30-day ceiling is expressed in seconds; the point of routing through minute_to_second
// is that nobody re-derives the factor of 60 by hand.
fn wait_timer_as_seconds(wait: PendingDeploymentWait) -> Second {
  minute_to_second(m: wait.wait_timer)
}

// The same conversion for a bare configured value, so a consumer can ask "is a timer this large
// inside the ceiling?" without inventing a whole wait record to hold one field.
fn wait_minutes_as_seconds(minutes: Minute) -> Second {
  minute_to_second(m: minutes)
}

// WHY THE CEILING CHECK THAT LIVED HERE IS GONE. It compared wait_timer against the 30-day rule
// timeout. That was wrong twice over. (1) UNITS: it compared a minutes-count against a seconds-count.
// (2) MEANING, which the unit fix alone would have hidden: `wait_timer` is the CONFIGURED delay an
// environment asks GitHub to hold a job — a setting on the environment — not the time the run has
// already spent waiting. Elapsed wait is `wait_timer_started_at` measured against the clock. So the
// old fold asked "is this environment configured to wait longer than GitHub is willing to wait?",
// which is answerable from the environment alone without polling anything, and whose answer is fixed
// by upstream: the maximum configurable value, 43,200 minutes, IS the 30-day ceiling, so the
// predicate could never be true for any value GitHub returns. A guard that cannot fire is not
// fail-closed; it is decoration. §5: a wrong answer is a loud error, never a plausible output.
//
// What a caller needs at break-glass time is ELAPSED wait, and it cannot be computed here:
// the corpus has no timestamp parser (std.types' Timestamp is a String alias), so turning
// `wait_timer_started_at` into a duration would need a clock seam, not a fold. It is therefore named
// here as the consumer still owed, and stage 2 must supply it rather than substitute this one.

// WHAT THE POLL CAN AND CANNOT TELL THE BROKER. It can name the waiting environment and say whether
// a HUMAN is in the reviewer list; it cannot say anything about an App. So the two projections this
// route needs are these, and neither one pretends otherwise:

// The waiting environment's name, as an accessor: the only identity this projection offers for the
// gate, and the one a consumer compares against what it asked about.
fn pending_wait_environment_name(wait: PendingDeploymentWait) -> NonEmptyStr {
  wait.environment.name
}

// Whether any HUMAN reviewer is listed. A wait that names users or teams is a required-reviewer wait,
// and an App has no business answering it — the fail-closed direction is to refuse whenever a human
// is in the list, rather than to assume the wait is ours.
fn pending_wait_carries_a_human_reviewer(wait: PendingDeploymentWait) -> Bool {
  wait.reviewers |> any(r => true)
}

// WHETHER THIS APP OWNS THE RULE THAT IS HOLDING THE JOB. That is NOT readable from the wait (see the
// reviewer note above), so it is established by a separate, independent read: the environment's ENABLED
// custom protection rules, read back, with the rule attributed to an App id and required to be enabled.
// Modelled as a sum so "we did not check" is a value rather than a skipped call.
//
// IT CARRIES AN APP ID, NOT AN INSTALLATION ID. components/schemas/deployment-protection-rule is
// {id, node_id, enabled, app}, and its `app` is a custom-deployment-rule-app {id, slug,
// integration_url, node_id}. There is no installation id anywhere in that response, so a record that
// claimed to have learned one from this readback had invented it. The installation the token is minted
// for is a SEPARATE configured fact (gunbc.auth.deployment_gate_authorization), matched against the
// operator's own record of the App -- not conjured from a response that never carried it.
type EnvironmentRuleOwnership
  = OwnedByGateApp { rule_id: Int, app_id: Int, app_slug: NonEmptyStr, environment_name: NonEmptyStr }
  | NotOwnedByGateApp { because: NonEmptyStr }

fn rule_ownership_is_established(ownership: EnvironmentRuleOwnership) -> Bool {
  match ownership {
    OwnedByGateApp { rule_id: _, app_id: _, app_slug: _, environment_name: _ } => true
    NotOwnedByGateApp { because: _ } => false
  }
}

// THE READBACK THAT ESTABLISHES OWNERSHIP IS THE ENABLED-RULES ENDPOINT, not the integrations
// endpoint. The pin distinguishes them flatly:
//   GET .../deployment_protection_rules        "Gets all custom deployment protection rules that are
//                                              ENABLED for an environment. Anyone with read access..."
//                                              -> {total_count, custom_deployment_protection_rules[]}
//   GET .../deployment_protection_rules/apps   "Gets all custom deployment protection rule
//                                              integrations that are AVAILABLE for an environment"
//                                              -> {total_count, available_custom_..._integrations[]}
// The second is an app-CATALOGUE list: its items carry no rule id and no `enabled`, so it cannot say a
// rule is enabled, and a guard built on it would pass for an integration that exists but is switched
// off. Read access suffices for the first, which is the one that answers the question being asked.
data enabled_rule_readback_endpoint_path: NonEmptyStr = "/repos/\{owner\}/\{repo\}/environments/\{environment_name\}/deployment_protection_rules"
data enabled_rule_readback_endpoint_method: HttpMethod = GET
data enabled_rule_readback_items_field: NonEmptyStr = "custom_deployment_protection_rules"

// The rule record itself, as the pin types it: all four fields required, and `enabled` is the one that
// makes ownership a claim about the gate rather than about an installation existing somewhere.
type EnabledDeploymentProtectionRule {
  id: Int,
  node_id: NonEmptyStr,
  enabled: Bool,
  app: RuleOwningApp,
}

type RuleOwningApp {
  id: Int,
  slug: NonEmptyStr,
}

// OWNERSHIP IS ESTABLISHED ONLY FROM A RULE THAT IS ENABLED AND ATTRIBUTED TO THIS APP. An enabled=false
// row, or a row whose app id is not the recorded gate App, is a refusal — never an ownership.
fn rule_ownership_from_readback(
  rules: List<EnabledDeploymentProtectionRule>,
  environment_name: NonEmptyStr,
  gate_app_id: Int
) -> EnvironmentRuleOwnership {
  let matches = rules |> filter(r => r.enabled && r.app.id == gate_app_id)
  if (matches |> count) == 0 {
    NotOwnedByGateApp {
      because: "the enabled-rules readback carried no enabled rule attributed to this App id",
    }
  } else {
    OwnedByGateApp {
      rule_id: (matches |> first |> map(r => r.id) |> or_else(0 as Int)) as Int,
      app_id: gate_app_id,
      app_slug: (matches
        |> first
        |> map(r => r.app.slug)
        |> or_else("unattributed" as NonEmptyStr)) as NonEmptyStr,
      environment_name: environment_name,
    }
  }
}

fn pending_deployment_wait_field_names() -> List<NonEmptyStr> {
  [
    pending_deployments_field_environment,
    pending_deployments_field_wait_timer,
    pending_deployments_field_wait_timer_started_at,
    pending_deployments_field_current_user_can_approve,
    pending_deployments_field_reviewers,
  ]
}

// The HUMAN/team reviewer endpoint, named so it is never confused with the App's. A GitHub App does
// not use this to answer its own rule, and its body shape is genuinely different: it names
// environments by NUMERIC ID rather than by name, and comment is required rather than optional.
// Typed separately so the two authorities cannot share a value (§3: two authorities, one per
// decision-maker). The REST reference gives the required triple [environment_ids, state, comment].
data human_review_endpoint_path: NonEmptyStr = "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/pending_deployments"
data human_review_endpoint_method: HttpMethod = POST

type HumanDeploymentReview {
  environment_ids: List<Int>,
  state: ReviewState,
  comment: NonEmptyStr,
}

// Only three protection-rule types exist in the environment projection, and they are GitHub's own
// names. Modelled as a sum so a fold cannot carry a fourth; the wire strings come from the type.
type EnvironmentProtectionRuleKind
  = RequiredReviewersKind
  | WaitTimerKind
  | BranchPolicyKind

fn environment_protection_rule_kind_wire(kind: EnvironmentProtectionRuleKind) -> NonEmptyStr {
  match kind {
    RequiredReviewersKind => "required_reviewers"
    WaitTimerKind => "wait_timer"
    BranchPolicyKind => "branch_policy"
  }
}

fn environment_protection_rule_kind_from_wire(value: NonEmptyStr) -> EnvironmentProtectionRuleKind? {
  if value == environment_protection_rule_kind_wire(kind: RequiredReviewersKind) {
    Present { value: RequiredReviewersKind }
  } else if value == environment_protection_rule_kind_wire(kind: WaitTimerKind) {
    Present { value: WaitTimerKind }
  } else if value == environment_protection_rule_kind_wire(kind: BranchPolicyKind) {
    Present { value: BranchPolicyKind }
  } else {
    none
  }
}

// The environment projection's protection-rule types: the REST enum carries only these three
// built-in kinds. An enabled custom App rule is NOT a fourth `type` value here; it is a separate
// resource under .../deployment_protection_rules. Claiming a `custom_deployment_protection_rules`
// type would be inventing a field the upstream does not have. The list is derived from the sum, so
// there is one authority for the names (§2) — widening the sum is the only way to widen this list.
data environment_protection_rule_type_values: List<NonEmptyStr> = [
  environment_protection_rule_kind_wire(kind: RequiredReviewersKind),
  environment_protection_rule_kind_wire(kind: WaitTimerKind),
  environment_protection_rule_kind_wire(kind: BranchPolicyKind),
]
data environment_protection_type_field: NonEmptyStr = "type"

// THE CEILING ON A GATE WAIT, AND ITS AUTHORITY. The limits reference carries the general row —
// "Gate approval time | 30 days | A workflow may wait for up to 30 days on environment approvals" —
// and both a required-reviewer wait and a custom-rule wait are environment approvals. Stated ONCE,
// in the duration carrier rather than in an Int whose unit survives only in its name (a row named
// rule_timeout_days holding 30 still reads 30 if someone meant hours). std.measure is the authority
// for Second and seconds_per_day; the precedent for a GitHub-side day-count is
// extdeps.cache.github_actions' gha_actions_cache_idle_release(), exactly this shape.
fn rule_gate_approval_ceiling() -> Second {
  second(count: 30 * seconds_per_day())
}

// THE CUSTOM RULE'S OWN WAIT, WHICH IS THAT CEILING. The custom-rule page states it in its own words:
// "When a custom deployment protection rule is triggered it will wait for up to 30 days for a webhook
// event response before it times out and the workflow job fails." Derived from the single magnitude
// above (§3) but cited to its own authority, so the two independent upstream statements stay
// separately attributable and a divergence between them is visible in the citation table.
fn custom_rule_response_timeout() -> Second {
  rule_gate_approval_ceiling()
}

// THE ONE OUTCOME, AND THE STATE THAT CANNOT BE WRITTEN AT ALL. Upstream names a single consequence
// and it is not a choice: the job FAILS. So the consequence is a fact typed in GitHub's own
// run-conclusion vocabulary (extdeps.github.actions_runs.RunConclusion), not a private two-arm sum
// minted to give a Bool predicate something to reject. An invented JobApproved arm would ADD the very
// state it then checks for — DESIGN §5's "make it unwritable" and §4b's top rung, given up for free.
// With no such constructor, no value exists that reads a timeout as an approval.
data custom_rule_timeout_run_conclusion: RunConclusion = RunFailure

// ---------------------------------------------------------------------------
// Discriminating fns — the upstream facts a witness mutates. The tests live in
// dag/test/claim/github_deployment_protection_rule_witness.dag, where every other
// witness in this repository lives.
// ---------------------------------------------------------------------------

// The two review calls differ by one path segment. A refactor that collapsed them would silently
// send an App review to the human queue, so the distinction is asserted, not assumed.
fn the_two_review_endpoints_are_distinct() -> Bool {
  review_endpoint_path != human_review_endpoint_path
}

// The environment this review releases, as an ACCESSOR returning NonEmptyStr — not a check, and not
// Optional. That is the construction guarantee: a review with no environment cannot be built, so
// there is no "did you remember to set it" validator left to forget (§5).
fn review_releases_environment(review: DeploymentProtectionRuleReview) -> NonEmptyStr {
  review.environment_name
}

// The decision, as the value the body carries rather than as a search for the word "state". The field
// is required in the App's body, so this returns a ReviewState and CANNOT return nothing — which is
// why the human body is a separate type: a caller cannot "forget" to decide, and cannot send
// something that reads as a review while releasing the deployment either way.
fn review_decision(review: DeploymentProtectionRuleReview) -> ReviewState {
  review.state
}

// A receiver that ignored the action would answer any future activity type with a review.
fn rule_webhook_is_an_answerable_request(event: String, action: String) -> Bool {
  event == (rule_webhook_event_name as String)
    && action == (rule_webhook_action as String)
}

// A timeout must be read as a job failure, never as an approval. A fold that let a timeout answer
// `approved` would approve a deployment nobody tapped — and unlike a prose check, this cannot be
// satisfied by a sentence that happens to contain the word "fails".

// Whether the App may answer at all: only its own rule, and only with the axes it is supposed to
// hold. A forbidden axis on the App means the reviewer identity is broader than this feature asked
// for, which is a reason to refuse to run rather than to run carefully. Compared by AXIS, not by
// substring of a description.

// Every row of the App's declared permission set is admissible. A single widened axis makes this
// false, and an activation check reads this rather than a description.

// The App must hold Deployments at write, or the review call is refused by GitHub and every gated
// deploy stalls until the rule times out. Stated as a positive requirement so the two checks
// together pin the set exactly.
fn rule_app_permission_set_is_complete() -> Bool {
  rule_app_permissions |> any(p => p.name == DeploymentsAxis && p.access == AppAccessWrite)
    && rule_app_permissions |> any(p => p.name == ActionsAxis && p.access == AppAccessRead)
}

// ---------------------------------------------------------------------------
// The three REST calls, as RECORDS — path, method and success status read together
// ---------------------------------------------------------------------------

// WHY A RECORD AND NOT THREE LOOSE ROWS PER CALL. A path with no method is a string, and a 204 with
// no method is trivia: the fact that matters is the TRIPLE, and the discriminating claim ("the App's
// review call answers 204 and nothing else") is a claim about one call, not about three unrelated
// numbers. Each row below is consumed by exactly one fold, named beside it.
type RestCall {
  path: NonEmptyStr,
  method: HttpMethod,
  // The ONLY status that means success. For the App's review call this is 204 alone; the two
  // pending_deployments calls answer 200, and conflating them is the failure in which a caller reads
  // a poll's 200-with-body as an accepted review.
  success_status: HttpStatus,
}

data review_call: RestCall = RestCall {
  path: review_endpoint_path,
  method: review_endpoint_method,
  success_status: review_endpoint_success_status,
}

data pending_deployments_poll_call: RestCall = RestCall {
  path: pending_deployments_endpoint_path,
  method: pending_deployments_endpoint_method,
  success_status: poll_success_status,
}

data human_review_call: RestCall = RestCall {
  path: human_review_endpoint_path,
  method: human_review_endpoint_method,
  success_status: poll_success_status,
}

// The poll and the human review answer 200; the App's review answers 204. Named once because two
// calls share it, and the witness asserts the two values are DIFFERENT rather than repeating them.
data poll_success_status: HttpStatus = 200

// THE DISCRIMINATING SUCCESS TEST. 204 on the App's review call is the entire witness that GitHub
// took the review — there is no body to read, and the deployment's fate cannot be inferred from the
// response. A caller that treated any non-error, or a 200 from the poll, as success would report an
// approval it never received. This fold is what stage 2 calls on the response.
fn review_call_succeeded(status: HttpStatus) -> Bool {
  status == review_call.success_status
}

// The two authorities answer with different codes, so a caller cannot tell them apart by "was it a
// 2xx". Asserting the difference here rather than leaving two rows that happen to differ.
fn the_two_success_statuses_are_not_the_same() -> Bool {
  review_call.success_status != human_review_call.success_status
}

// The review call and the poll are DIFFERENT CALLS even though the poll's path and the human
// reviewer's path are the same resource reached by different methods. Method is part of the fact:
// GET pending_deployments is a read any repo reader may make; POST pending_deployments is a human
// decision; POST deployment_protection_rule is the App answering its own rule.
fn the_three_calls_are_distinguishable() -> Bool {
  review_call.path != pending_deployments_poll_call.path
    && review_call.method == POST
    && pending_deployments_poll_call.method == GET
    && human_review_call.method == POST
    && human_review_call.path == pending_deployments_poll_call.path
    && human_review_call.method != pending_deployments_poll_call.method
}

// ---------------------------------------------------------------------------
// Consumers for the rows that would otherwise be data with no reader (§3c: an added
// declaration with no consumer is dangling, and dangling is the one structural red)
// ---------------------------------------------------------------------------

// THE CALLBACK PAIR IS CHECKABLE, NOT DESCRIPTIVE. A webhook-driven caller posts to the URL GitHub
// put in the
// payload's `deployment_callback_url` field, and that field is the one whose name upstream publishes;
// reading any other field, or posting anywhere else, is refused here. This is the consumer that makes
// the callback relation a fact rather than a sentence.
fn rule_review_is_answerable_at(payload_field: NonEmptyStr, target_path: NonEmptyStr) -> Bool {
  payload_field == rule_review_callback.payload_field
    && target_path == rule_review_callback.addresses
    && rule_webhook_payload_field_is_published(name: payload_field)
}

// THE TOKEN IDENTITY IS READ FROM THE PAYLOAD, not from a configured constant — the upstream's own

// THE PERMISSION THIS CALL NEEDS, as one typed row (axis + level) rather than two strings that have
// to be kept in step. Consumed by the activation check: an App that lacks it cannot answer, and the
// operator's registration step is checked against this rather than against a description.
fn review_permission_is_satisfied(permissions: List<GitHubAppPermission>) -> Bool {
  permissions |> any(p => p.name == review_required_permission.name
    && p.access == review_required_permission.access)
}

// The environment projection keys its protection rules on a field named `type`. Named as a row
// because the read-back that gates activation reads THAT key; the consumer is the lookup below.
fn environment_protection_types_are_read_from(key: NonEmptyStr) -> Bool {
  key == environment_protection_type_field
}

// THE FAIL-CLOSED READING, as the value the model asserts rather than a claim about prose. The fold
// that decides what happens when the App never answers reads this; a change to the wrong arm is a
// change of value, caught by the witness, not an edit to a sentence.

// ---------------------------------------------------------------------------
// Cited scope rows: every fact above points at the authority that states it
// ---------------------------------------------------------------------------

// THE CITATION TABLE, following extdeps.cpu.ampere's shape: a FactCitation per upstream fact, each
// naming the declaration and the authority that publishes it. This is the consumer for the reference
// rows — a DeclarationRef that nothing cites is a pointer to nothing — and it is what makes §3b's
// "external facts must be cited" checkable per row rather than asserted once for the module.
data deployment_protection_rule_fact_citations: List<FactCitation> = [
  FactCitation { fact: review_endpoint_ref, authority: rest_authority },
  FactCitation { fact: review_state_enum_ref, authority: openapi_authority },
  FactCitation { fact: pending_deployments_endpoint_ref, authority: rest_authority },
  FactCitation { fact: human_review_endpoint_ref, authority: rest_authority },
  FactCitation { fact: rule_webhook_fields_ref, authority: webhook_authority },
  FactCitation { fact: environment_protection_types_ref, authority: environment_authority },
  FactCitation { fact: custom_rule_timeout_ref, authority: enablement_authority },
  FactCitation { fact: gate_ceiling_ref, authority: limits_authority },
  FactCitation { fact: wait_timer_field_ref, authority: environment_authority },
  FactCitation { fact: reviewer_types_ref, authority: openapi_authority },
  FactCitation { fact: rule_app_permissions_ref, authority: rule_authority },
  FactCitation { fact: spec_pin_ref, authority: spec_authority },
]

fn deployment_protection_rule_citation_count() -> Int {
  deployment_protection_rule_fact_citations |> count
}

// Every cited fact points at a declaration that EXISTS in this module, and every authority cited is
// one this module publishes. A rename that leaves a citation pointing at a retired name reddens this
// rather than quietly dropping the citation — the failure mode where a model keeps its authority rows
// while the facts they covered have moved on. The list below is the live-name census; adding a cited
// fact without adding it here fails, which is the point.
data deployment_protection_rule_live_fact_names: List<NonEmptyStr> = [
  "review_endpoint_path",
  "review_state_wire",
  "pending_deployments_endpoint_path",
  "human_review_endpoint_path",
  "rule_webhook_field_environment",
  "environment_protection_rule_type_values",
  "custom_rule_response_timeout",
  "rule_gate_approval_ceiling",
  "wait_timer_maximum",
  "pending_deployment_reviewer_type_wire",
  "rule_app_permissions",
  "spec_pinned_commit",
]

fn every_citation_names_a_live_declaration() -> Bool {
  (deployment_protection_rule_fact_citations |> count)
    == (deployment_protection_rule_live_fact_names |> count)
    && (deployment_protection_rule_fact_citations
        |> all(c => c.fact.module_path == "extdeps.github.deployment_protection_rule"))
    && (deployment_protection_rule_fact_citations
        |> all(c => deployment_protection_rule_live_fact_names
             |> any(n => n == c.fact.decl_name)))
}

fn rule_webhook_field_names_include(name: NonEmptyStr) -> Bool {
  rule_webhook_documented_field_names |> any(f => f == name)
}

// The scope rows, each pointing at a declaration by name. Kept as DeclarationRef values because the
// citation table above is what reads them; a ref with no citation is dangling and gets deleted.
fn gate_ref(decl_name: NonEmptyStr) -> DeclarationRef {
  DeclarationRef {
    module_path: "extdeps.github.deployment_protection_rule",
    decl_name: decl_name,
    field: WholeDeclaration,
  }
}

data review_endpoint_ref: DeclarationRef = gate_ref(decl_name: "review_endpoint_path")
data review_state_enum_ref: DeclarationRef = gate_ref(decl_name: "review_state_wire")
data pending_deployments_endpoint_ref: DeclarationRef = gate_ref(decl_name: "pending_deployments_endpoint_path")
data human_review_endpoint_ref: DeclarationRef = gate_ref(decl_name: "human_review_endpoint_path")
data rule_webhook_fields_ref: DeclarationRef = gate_ref(decl_name: "rule_webhook_field_environment")
data environment_protection_types_ref: DeclarationRef = gate_ref(decl_name: "environment_protection_rule_type_values")
data custom_rule_timeout_ref: DeclarationRef = gate_ref(decl_name: "custom_rule_response_timeout")
data gate_ceiling_ref: DeclarationRef = gate_ref(decl_name: "rule_gate_approval_ceiling")
data wait_timer_field_ref: DeclarationRef = gate_ref(decl_name: "wait_timer_maximum")
data reviewer_types_ref: DeclarationRef = gate_ref(decl_name: "pending_deployment_reviewer_type_wire")
data rule_app_permissions_ref: DeclarationRef = gate_ref(decl_name: "rule_app_permissions")
data spec_pin_ref: DeclarationRef = gate_ref(decl_name: "spec_pinned_commit")

data extdeps_external_authority_anchor: ExternalAuthority = rule_authority

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: review_endpoint_ref
  },
  first_citation: extdeps.github.deployment_protection_rule.extdeps_external_authority_anchor,
  further_citations: [
    extdeps.github.deployment_protection_rule.rest_authority,
    extdeps.github.deployment_protection_rule.webhook_authority,
    extdeps.github.deployment_protection_rule.environment_authority,
    extdeps.github.deployment_protection_rule.openapi_authority,
    extdeps.github.deployment_protection_rule.enablement_authority,
    extdeps.github.deployment_protection_rule.limits_authority,
    extdeps.github.deployment_protection_rule.spec_authority
  ]
}
