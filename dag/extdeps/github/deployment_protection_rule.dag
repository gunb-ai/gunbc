module extdeps.github.deployment_protection_rule

// GitHub's CUSTOM DEPLOYMENT PROTECTION RULES, modeled from the upstream before any gunbc wiring
// (DESIGN.md §3b "model-before-implement": an upstream claim is authored by reading the upstream,
// and it names the field or endpoint it is about). This file states what GitHub accepts and
// returns when a deployment environment is gated by a GitHub App instead of by RequiredReviewers.
// It states no gunbc policy and grants nothing.
//
// WHY A SEPARATE MODULE FROM extdeps.github.deployment_environments (which already models
// GitHubEnvironmentProtectionSettings): that file models the ENVIRONMENT side of the boundary —
// what protection is configured on an environment. This file models the DEPLOYMENT-RULE side — the
// webhook GitHub emits when a run reaches such an environment, the REST call that answers it, and
// the poll that shows what is waiting. They dissolve and change on different upstream clocks, and
// folding the rule into the environment file would let a change to the environment projection
// quietly carry a claim about the review API (§3: one authority per subject).
//
// THE ONE THING THIS MODEL MUST KEEP STRAIGHT: there are TWO review endpoints and they are NOT
// interchangeable. POST .../deployment_protection_rule answers a rule published by a GitHub App,
// and an App may answer ONLY its own rule; POST .../pending_deployments answers a human/team
// RequiredReviewers gate. Getting these backwards is this feature's whole failure mode: an App
// calling the human reviewer endpoint either fails, or — worse — succeeds while a human is still
// being asked, which is two authorities for one decision.

import std.types { String, Int, List, NonEmptyStr, HttpStatus }
import std.decl_ref { DeclarationRef, WholeDeclaration }
// Duration: std.measure is the authority. A "30 days" stored as an Int keeps its unit only in its
// name, so the unit rule (ctrl's mechanical blocker) is satisfied by the carrier, not by a comment.
import std.measure { Second, second, second_count, seconds_per_day, seconds_per_minute }
// HttpMethod comes from the RFC authority rather than being re-minted per module (§2).
import extdeps.ietf.http_semantics { HttpMethod, GET, POST }
import extdeps.external_authority {
  ExternalAuthority,
  ExternalModelScope,
  ExternalSubjectRef,
  FactCitation,
}
import extdeps.uri { Uri, Https }
// The permission vocabulary is extdeps.github.app's, not re-minted here (§2).
import extdeps.github.app {
  GitHubPermissionAxis,
  ActionsAxis,
  ContentsAxis,
  DeploymentsAxis,
  PullRequestsAxis,
  AdministrationAxis,
  SecurityEventsAxis,
  WorkflowsAxis,
  IdTokenAxis,
  GitHubAppPermissionAccess,
  AppAccessRead,
  AppAccessWrite,
  GitHubAppPermission,
}

// ---------------------------------------------------------------------------
// Authority anchors (each a page read on 2026-10-18)
// ---------------------------------------------------------------------------

// The how-to for building the rule: repository permissions, the webhook contract, and the
// installation-token step.
data rule_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/how-tos/deploy/configure-and-manage-deployments/create-custom-protection-rules"
  }
}

// The REST reference page carrying both review endpoints and the pending-deployments poll.
data rest_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/actions/workflow-runs"
  }
}

// The webhook event reference for the `deployment_protection_rule` payload.
data webhook_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/webhooks/webhook-events-and-payloads"
  }
}

// The environment REST reference: protection_rules[].type values and the wait_timer range.
data environment_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/deployments/environments"
  }
}

// The machine-readable source the field-level claims below were checked against.
data openapi_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/github/rest-api-description/blob/main/descriptions/api.github.com/api.github.com.json"
  }
}

// Where the rule is ENABLED on an environment, and where the 30-day wait is stated. Read on
// 2026-10-18; this is the page the operator's UI steps are drawn from.
data enablement_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/how-tos/deploy/configure-and-manage-deployments/configure-custom-protection-rules"
  }
}

// ---------------------------------------------------------------------------
// The webhook GitHub emits when a run reaches a rule-gated environment
// ---------------------------------------------------------------------------

// The event and its ONLY published activity type. A receiver that did not filter on the action
// would answer any future activity type with a review.
data rule_webhook_event_name: NonEmptyStr = "deployment_protection_rule"
data rule_webhook_action: NonEmptyStr = "requested"

// The payload's field names in the upstream's own spelling, as a PUBLISHED SET rather than eight
// loose strings. A receiver may read only these, and rule_webhook_payload_field_is_published() is
// what says so: a receiver coded against a field GitHub never documents is refused here instead of
// silently reading nothing. Keeping them as individual rows (rather than one list) is what lets a
// citation name one field, and the list below is DERIVED from the rows so the set cannot drift.
data rule_webhook_field_repository: NonEmptyStr = "repository"
data rule_webhook_field_run_id: NonEmptyStr = "run_id"
data rule_webhook_field_run_url: NonEmptyStr = "run_url"
data rule_webhook_field_environment: NonEmptyStr = "environment"
data rule_webhook_field_deployment_callback_url: NonEmptyStr = "deployment_callback_url"
data rule_webhook_field_deployment: NonEmptyStr = "deployment"
data rule_webhook_field_app_id: NonEmptyStr = "app_id"
data rule_webhook_field_installation_id: NonEmptyStr = "installation_id"

data rule_webhook_published_fields: List<NonEmptyStr> = [
  rule_webhook_field_repository,
  rule_webhook_field_run_id,
  rule_webhook_field_run_url,
  rule_webhook_field_environment,
  rule_webhook_field_deployment_callback_url,
  rule_webhook_field_deployment,
  rule_webhook_field_app_id,
  rule_webhook_field_installation_id,
]

fn rule_webhook_payload_field_is_published(name: NonEmptyStr) -> Bool {
  rule_webhook_published_fields |> any(f => f == name)
}

// BOTH PREVIOUSLY STRING ROWS OF PROSE, now typed facts with a consumer. Their old shapes —
// `rule_webhook_callback_url_meaning: String` and `rule_installation_id_source: String` — were
// sentences nothing read (§4c: a String whose only purpose is commentary is misplaced data). What
// was true in them is now carried as a relation between two named upstream fields, and
// rule_review_is_answerable_at() below is the consumer that reads it.

// WHERE THE TOKEN IDENTITY COMES FROM. Upstream directs the App to mint its installation token from
// the installation id IN THE PAYLOAD for the rule that fired, rather than from a configured
// constant. Typed as a payload-field reference so the claim is about a field, and a rename of that
// field reddens the fold rather than leaving the sentence true about nothing.
data rule_installation_id_payload_field: NonEmptyStr = rule_webhook_field_installation_id

// THE CALLBACK IS NOT A URL THE BROKER CHOOSES. deployment_callback_url is GitHub's own pointer at
// the review endpoint FOR THIS RUN, so posting there cannot aim the review at a different run. That
// is why it is modelled as the pair (the payload's callback field, the endpoint it must address)
// rather than as a description: the pair is checkable, and rule_review_is_answerable_at() checks it.
type RuleReviewCallback {
  payload_field: NonEmptyStr,
  addresses: NonEmptyStr,
}

data rule_review_callback: RuleReviewCallback = RuleReviewCallback {
  payload_field: rule_webhook_field_deployment_callback_url,
  addresses: review_endpoint_path,
}

// A rule is not compatible with a job whose environment is set to `deployment: false`, so an
// environment-bearing job is the only kind this rule can ever gate.
data rule_incompatible_job_setting: NonEmptyStr = "deployment: false"

// ---------------------------------------------------------------------------
// The REST calls
// ---------------------------------------------------------------------------

// The App's review call. Path params owner, repo, run_id. Success is 204 with no body — so "it
// returned 204" is the entire witness, and nothing about the deployment's fate can be read out of
// the response.
data review_endpoint_path: NonEmptyStr = "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/deployment_protection_rule"
data review_endpoint_method: HttpMethod = POST
data review_endpoint_success_status: HttpStatus = 204

// The body, from components/schemas in the OpenAPI description. It is an anyOf of two shapes, and
// the required pair differs between them:
//   review-custom-gates-state-required   required = [environment_name, state]   (comment optional)
//   review-custom-gates-comment-required required = [environment_name, comment] (no state at all)
// Only the FIRST carries a decision, and it is the one a broker sends — so the body is modelled as
// the record for that alternative, not as a field-name list a caller could build wrongly (§5).
// environment_name is required in BOTH alternatives: it is the environment this review releases, and
// it is never inferable from the run id (the path carries only owner, repo and run_id).
data review_endpoint_body_environment_name_field: NonEmptyStr = "environment_name"
data review_endpoint_body_state_field: NonEmptyStr = "state"
data review_endpoint_body_comment_field: NonEmptyStr = "comment"
data review_endpoint_body_alternatives: List<NonEmptyStr> = [
  "review-custom-gates-state-required",
  "review-custom-gates-comment-required",
]

// THE REQUEST A BROKER BUILDS. Three parts, each named: the environment released, the decision, and
// an optional human-readable reason. The two required parts are not optional in the type, so the
// request that "forgets" the environment — the one that would aim a srv1 approval at another
// environment, or a review at no environment at all — cannot be written. The comment-only
// alternative is deliberately NOT representable here: it is schema-legal upstream but asserts no
// decision, and a broker that sent it would leave the deployment waiting while reading its own 204
// as an approval.
// THE REVIEW DECISION, as a closed sum. GitHub's own `state` enum is exactly these two values on
// BOTH review endpoints (the App's and the human one), so both bodies share this type and there is
// no third outcome to spell — and no validator to forget to call (§5: correctness by construction).
// The wire strings live in review_state_wire so a caller cannot invent one; review_state_from_wire
// is the only way in, and it returns Absent for anything GitHub would not accept.
type ReviewState
  = Approved
  | Rejected

fn review_state_wire(state: ReviewState) -> NonEmptyStr {
  match state {
    Approved => "approved"
    Rejected => "rejected"
  }
}

fn review_state_from_wire(name: NonEmptyStr) -> ReviewState? {
  if name == review_state_wire(state: Approved) {
    Present { value: Approved }
  } else if name == review_state_wire(state: Rejected) {
    Present { value: Rejected }
  } else {
    none
  }
}

type DeploymentProtectionRuleReview {
  environment_name: NonEmptyStr,
  state: ReviewState,
  comment: NonEmptyStr?,
}

fn review_body_field_names(review: DeploymentProtectionRuleReview) -> List<NonEmptyStr> {
  match review.comment {
    Present { value: _ } => [
      review_endpoint_body_environment_name_field,
      review_endpoint_body_state_field,
      review_endpoint_body_comment_field,
    ]
    Absent => [
      review_endpoint_body_environment_name_field,
      review_endpoint_body_state_field,
    ]
  }
}

// The App's fine-grained requirement for that call, from the REST reference's own note: this
// endpoint "works with the following fine-grained token types: GitHub App installation access
// tokens" and "The fine-grained token must have the following permission set: \"Deployments\"
// repository permissions (write)". The rule-creation page states the App's own permission setup,
// verbatim: "To the right of \"Actions,\" click the drop down menu and select Access: Read-only.
// To the right of \"Deployments,\" click the drop down menu and select Access: Read and write."
// Contents is NOT on that list — an App granted Contents:write for this job has been granted
// something the upstream never asked for. The same page's NOTE says GitHub Apps can only review
// their OWN custom deployment protection rules — a rule created by another app is not answerable
// by this identity.
//
// The AXIS and ACCESS vocabulary is extdeps.github.app's existing GitHubPermissionAxis /
// GitHubAppPermissionAccess (§2: one shape, bound by several tables — minting a second list of
// permission strings here would be the failed decomposition that file's own comment names). What is
// NEW here, and what these rows own, is only which axes this feature's App must hold.
data review_required_permission: GitHubAppPermission = GitHubAppPermission {
  name: DeploymentsAxis,
  access: AppAccessWrite,
}

// The documented permission set for the rule App: Actions read-only, Deployments read and write, and
// NOTHING else. Anything wider — Contents, Administration, Pull requests, Secrets — is an
// unrequested grant on the identity that releases the srv1 root boundary. Because the elements are
// GitHubAppPermission records rather than strings, a widening is a different value of an existing
// closed type, and the refusal below compares axes rather than substrings of a sentence.
data rule_app_permissions: List<GitHubAppPermission> = [
  GitHubAppPermission { name: ActionsAxis, access: AppAccessRead },
  GitHubAppPermission { name: DeploymentsAxis, access: AppAccessWrite },
]

// Axes an operator must NOT grant this App. Deployments is required and so is absent; these are the
// ones that would turn a reviewer identity into something broader. MetadataAxis is excluded on
// purpose: a GitHub App needs it to exist at all, and refusing it would refuse the App. IdTokenAxis
// is the sharpest of them — an App that can mint OIDC id tokens can federate into a cloud role,
// which is exactly the escalation the mtcollins1 WIF condition is built to constrain.
data rule_app_forbidden_axes: List<GitHubPermissionAxis> = [
  ContentsAxis,
  AdministrationAxis,
  PullRequestsAxis,
  SecurityEventsAxis,
  WorkflowsAxis,
  IdTokenAxis,
]

// WHO MAY MAKE THE REVIEW CALL, as the upstream states it and as this design restricts it. The REST
// page accepts two credential kinds; only ONE is permitted here.
//   InstallationAccessToken — "works with the following fine-grained token types: GitHub App
//     installation access tokens", needing "Deployments" repository permissions (write).
//   OAuthClassicWithRepoScope — "OAuth app tokens and personal access tokens (classic) need the
//     repo scope to use this endpoint with a private repository." Upstream ALLOWS it. It is the
//     broker holding the operator's own GitHub token, and it is the second rejected alternative in
//     the plan carrier; naming it as a value that this fold REFUSES is what keeps it out, rather than
//     a paragraph hoping nobody implements it. An operator credential sitting where a service can
//     reach it is the shape authorization_pattern_selection's hard constraints exclude.
type ReviewCredential
  = InstallationAccessToken
  | OAuthClassicWithRepoScope

data review_accepted_token_type: NonEmptyStr = "GitHub App installation access tokens"
data review_oauth_classic_scope: NonEmptyStr = "repo"

fn review_credential_is_permitted(credential: ReviewCredential) -> Bool {
  match credential {
    InstallationAccessToken => true
    OAuthClassicWithRepoScope => false
  }
}

// The credential the model actually endorses, read from the upstream's own label rather than
// restated: a caller that offers a token type other than this one is not making a supported call.
fn review_credential_is_documented(token_type: NonEmptyStr) -> Bool {
  token_type == review_accepted_token_type
}

// GitHub's own worked example for this call, as the RECORD a broker should build: environment_name,
// state and comment, answered 204. It is a value of DeploymentProtectionRuleReview, so the example is
// checkable — and it deliberately names prod-eus, an environment that is NOT this repository's gate,
// which is why review_documented_example_releases_a_different_environment() below is a red that must
// hold: copying GitHub's example verbatim into a broker would release nothing we care about.
data review_documented_example_body: DeploymentProtectionRuleReview = DeploymentProtectionRuleReview {
  environment_name: "prod-eus",
  state: Approved,
  comment: Present { value: "All health checks passed." },
}

fn review_documented_example_is_complete() -> Bool {
  (review_body_field_names(review: review_documented_example_body) |> count) == 3
}

// The example names a DIFFERENT environment than the one this feature gates. If this ever reads
// true, the example and the gate have been conflated somewhere.
fn review_documented_example_releases_a_different_environment(gated: NonEmptyStr) -> Bool {
  review_releases_environment(review: review_documented_example_body) != gated
}

// The version header the reference sends with the call. Typed as a name/value pair so a fold can
// check the header is the one the docs pinned, rather than matching a whole string by eye.
type ReviewApiVersionHeader {
  name: NonEmptyStr,
  value: NonEmptyStr,
}

data review_documented_api_version_header: ReviewApiVersionHeader = ReviewApiVersionHeader {
  name: "X-GitHub-Api-Version",
  value: "2026-03-10",
}

fn review_api_version_header_is_pinned(header: ReviewApiVersionHeader) -> Bool {
  header.name == review_documented_api_version_header.name
    && header.value == review_documented_api_version_header.value
}

// THE POLL THAT SHOWS WHAT IS WAITING, and the record the broker verifies against before it answers.
// Read access to the repository is enough; no permission grant is needed to SEE the gate. The field
// rows are not decoration: PendingDeploymentWait is built from them, and the broker's pre-answer
// check reads that record — the manager's requirement that the run id and environment are CONFIRMED
// against GitHub rather than taken on trust from the workflow that filed the request.
data pending_deployments_endpoint_path: NonEmptyStr = "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/pending_deployments"
data pending_deployments_endpoint_method: HttpMethod = GET
data pending_deployments_field_environment: NonEmptyStr = "environment"
data pending_deployments_field_wait_timer: NonEmptyStr = "wait_timer"
data pending_deployments_field_wait_timer_started_at: NonEmptyStr = "wait_timer_started_at"
data pending_deployments_field_current_user_can_approve: NonEmptyStr = "current_user_can_approve"
data pending_deployments_field_reviewers: NonEmptyStr = "reviewers"

// A WAITING ENVIRONMENT, as the poll reports it. Every field is required by the pending-deployment
// schema, so a wait that is missing the environment or the reviewer list cannot be constructed — and
// the broker therefore cannot verify a half-read response.
type PendingDeploymentWait {
  environment: NonEmptyStr,
  // A DURATION, not an Int whose unit survives only in a name. Upstream calls the field
  // `wait_timer` and counts it in seconds; std.measure's Second is the authority for that quantity,
  // and the precedent for a GitHub-side day-scale duration is extdeps.cache.github_actions'
  // gha_actions_cache_idle_release() = second(count: 7 * seconds_per_day()).
  wait_timer: Second,
  wait_timer_started_at: NonEmptyStr?,
  current_user_can_approve: Bool,
  reviewers: List<NonEmptyStr>,
}

// THE ONE FIELD AN APP ACTS ON, and the one it must not. `reviewers` is who may answer the wait; if
// it names a person, the wait is a required-reviewer wait and an App CANNOT answer it ("GitHub Apps
// can only review their own custom deployment protection rules"). `current_user_can_approve` is a
// HUMAN-FACING field — true for the operator's own session tells you nothing about whether the App
// may post. A broker that gated on current_user_can_approve instead of reviewers would approve a
// deployment it has no authority over, so the distinction is a value, not a paragraph.
fn pending_deployment_wait_is_answerable_by_app(
  wait: PendingDeploymentWait,
  app_installation_id: NonEmptyStr
) -> Bool {
  wait.reviewers |> any(r => r == app_installation_id)
}


fn pending_deployment_wait_field_names() -> List<NonEmptyStr> {
  [
    pending_deployments_field_environment,
    pending_deployments_field_wait_timer,
    pending_deployments_field_wait_timer_started_at,
    pending_deployments_field_current_user_can_approve,
    pending_deployments_field_reviewers,
  ]
}

// THE BROKER'S PRE-ANSWER CHECK: the environment the submission named, AND the environment the
// capability named, AND the environment GitHub reports as waiting for this run, must all be the same
// environment; and the wait must be one this App may answer. A submission naming an environment the
// poll does not report is refused and the deployment stays waiting.
fn broker_may_answer(
  wait: PendingDeploymentWait,
  submitted_environment: NonEmptyStr,
  capability_environment: NonEmptyStr,
  app_installation_id: NonEmptyStr
) -> Bool {
  wait.environment == submitted_environment
    && wait.environment == capability_environment
    && pending_deployment_wait_is_answerable_by_app(
         wait: wait, app_installation_id: app_installation_id
       )
}

// Whether the wait has already run past the ceiling the gate is allowed. Not a policy decision —
// the arithmetic the operator's break-glass sits behind, stated so a fold can ask it. Compared as
// counts on the two Second values, the way every other duration comparison in the corpus does it.
fn pending_wait_is_over_ceiling(wait: PendingDeploymentWait) -> Bool {
  second_count(s: wait.wait_timer) > second_count(s: rule_timeout())
}

// The HUMAN/team reviewer endpoint, named so it is never confused with the App's. A GitHub App does
// not use this to answer its own rule, and its body shape is genuinely different: it names
// environments by NUMERIC ID rather than by name, and comment is required rather than optional.
// Typed separately so the two authorities cannot share a value (§3: two authorities, one per
// decision-maker). The REST reference gives the required triple [environment_ids, state, comment].
data human_review_endpoint_path: NonEmptyStr = "/repos/\{owner\}/\{repo\}/actions/runs/\{run_id\}/pending_deployments"
data human_review_endpoint_method: HttpMethod = POST

type HumanDeploymentReview {
  environment_ids: List<Int>,
  state: ReviewState,
  comment: NonEmptyStr,
}

// Only three protection-rule types exist in the environment projection, and they are GitHub's own
// names. Modelled as a sum so a fold cannot carry a fourth; the wire strings come from the type.
type EnvironmentProtectionRuleKind
  = RequiredReviewersKind
  | WaitTimerKind
  | BranchPolicyKind

fn environment_protection_rule_kind_wire(kind: EnvironmentProtectionRuleKind) -> NonEmptyStr {
  match kind {
    RequiredReviewersKind => "required_reviewers"
    WaitTimerKind => "wait_timer"
    BranchPolicyKind => "branch_policy"
  }
}

fn environment_protection_rule_kind_from_wire(value: NonEmptyStr) -> EnvironmentProtectionRuleKind? {
  if value == environment_protection_rule_kind_wire(kind: RequiredReviewersKind) {
    Present { value: RequiredReviewersKind }
  } else if value == environment_protection_rule_kind_wire(kind: WaitTimerKind) {
    Present { value: WaitTimerKind }
  } else if value == environment_protection_rule_kind_wire(kind: BranchPolicyKind) {
    Present { value: BranchPolicyKind }
  } else {
    none
  }
}

// The environment projection's protection-rule types: the REST enum carries only these three
// built-in kinds. An enabled custom App rule is NOT a fourth `type` value here; it is a separate
// resource under .../deployment_protection_rules. Claiming a `custom_deployment_protection_rules`
// type would be inventing a field the upstream does not have. The list is derived from the sum, so
// there is one authority for the names (§2) — widening the sum is the only way to widen this list.
data environment_protection_rule_type_values: List<NonEmptyStr> = [
  environment_protection_rule_kind_wire(kind: RequiredReviewersKind),
  environment_protection_rule_kind_wire(kind: WaitTimerKind),
  environment_protection_rule_kind_wire(kind: BranchPolicyKind),
]
data environment_protection_type_field: NonEmptyStr = "type"

// What happens when the App never answers. Modelled as a closed outcome, NOT as a sentence to grep:
// a contains("fails") check passes for "the job fails over and is approved later", which is exactly
// the reading this row exists to forbid. The upstream says it plainly (configure-custom-protection-
// rules page): "When a custom deployment protection rule is triggered it will wait for up to 30 days
// for a webhook event response before it times out and the workflow job fails."
type RuleTimeoutOutcome
  = JobFails
  | JobApproved

data rule_timeout_outcome: RuleTimeoutOutcome = JobFails

// THE STALL ITSELF, AS A DURATION — not a bare Int whose unit survives only in its name. A row
// named rule_timeout_days holding 30 would still read 30 if someone meant 30 hours, and a witness
// asserting `== 30` could not tell the difference. std.measure is the authority for Second and
// seconds_per_day; the precedent for a GitHub-side day-count is extdeps.cache.github_actions'
// gha_actions_cache_idle_release(), which is exactly this shape (7 * seconds_per_day()).
fn rule_timeout() -> Second {
  second(count: 30 * seconds_per_day())
}

// THE SAME CEILING APPLIES TO THE GATE WE ARE REPLACING. The limits reference gives ONE general row
// — "Gate approval time — 30 days — A workflow may wait for up to 30 days on environment approvals"
// — and a required-reviewer wait is an environment approval. So the two gates share a ceiling, and
// the shared value is stated once rather than re-typed: this is not a second fact, it is evidence
// that the fact above is not specific to custom rules. Nothing here would need to change if GitHub
// raised the number; the witness mutates it, not this line.
fn rule_gate_approval_ceiling() -> Second {
  rule_timeout()
}

// ---------------------------------------------------------------------------
// Discriminating fns — the upstream facts a witness mutates. The tests live in
// dag/test/claim/github_deployment_protection_rule_witness.dag, where every other
// witness in this repository lives.
// ---------------------------------------------------------------------------

// The two review calls differ by one path segment. A refactor that collapsed them would silently
// send an App review to the human queue, so the distinction is asserted, not assumed.
fn the_two_review_endpoints_are_distinct() -> Bool {
  review_endpoint_path != human_review_endpoint_path
}

// The environment this review releases, as an ACCESSOR returning NonEmptyStr — not a check, and not
// Optional. That is the construction guarantee: a review with no environment cannot be built, so
// there is no "did you remember to set it" validator left to forget (§5).
fn review_releases_environment(review: DeploymentProtectionRuleReview) -> NonEmptyStr {
  review.environment_name
}

// Whether the review is the one the operator's tap authorised. `capability_environment` is what the
// REDEEMED CAPABILITY names. A broker that lifts environment_name from the waiting run instead of
// from the capability is caught here — and nowhere else, because the run's URL never mentions an
// environment. This is the discriminating red's hinge.
fn review_matches_capability(
  review: DeploymentProtectionRuleReview,
  capability_environment: NonEmptyStr
) -> Bool {
  review.environment_name == capability_environment
}

// Whether the DECISION matches the tap. Same shape as the environment check, so a broker that
// approved where the operator rejected is caught by the same kind of comparison against the
// capability rather than against whatever the run happened to be doing.
fn review_matches_decision(
  review: DeploymentProtectionRuleReview,
  capability_state: ReviewState
) -> Bool {
  review.state == capability_state
}

// A receiver that ignored the action would answer any future activity type with a review.
fn rule_webhook_is_an_answerable_request(event: String, action: String) -> Bool {
  event == (rule_webhook_event_name as String)
    && action == (rule_webhook_action as String)
}

// A timeout must be read as a job failure, never as an approval. A fold that let a timeout answer
// `approved` would approve a deployment nobody tapped — and unlike a prose check, this cannot be
// satisfied by a sentence that happens to contain the word "fails".
fn rule_timeout_is_a_refusal(outcome: RuleTimeoutOutcome) -> Bool {
  match outcome {
    JobFails => true
    JobApproved => false
  }
}

// Whether the App may answer at all: only its own rule, and only with the axes it is supposed to
// hold. A forbidden axis on the App means the reviewer identity is broader than this feature asked
// for, which is a reason to refuse to run rather than to run carefully. Compared by AXIS, not by
// substring of a description.
fn rule_app_permission_is_admissible(permission: GitHubAppPermission) -> Bool {
  !(rule_app_forbidden_axes |> any(a => a == permission.name))
}

// Every row of the App's declared permission set is admissible. A single widened axis makes this
// false, and the broker's activation check reads this rather than a description.
fn rule_app_permission_set_is_admissible() -> Bool {
  rule_app_permissions |> all(p => rule_app_permission_is_admissible(permission: p))
}

// The App must hold Deployments at write, or the review call is refused by GitHub and every gated
// deploy stalls until the rule times out. Stated as a positive requirement so the two checks
// together pin the set exactly.
fn rule_app_permission_set_is_complete() -> Bool {
  rule_app_permissions |> any(p => p.name == DeploymentsAxis && p.access == AppAccessWrite)
    && rule_app_permissions |> any(p => p.name == ActionsAxis && p.access == AppAccessRead)
}

// ---------------------------------------------------------------------------
// The three REST calls, as RECORDS — path, method and success status read together
// ---------------------------------------------------------------------------

// WHY A RECORD AND NOT THREE LOOSE ROWS PER CALL. A path with no method is a string, and a 204 with
// no method is trivia: the fact that matters is the TRIPLE, and the discriminating claim ("the App's
// review call answers 204 and nothing else") is a claim about one call, not about three unrelated
// numbers. Each row below is consumed by exactly one fold, named beside it.
type RestCall {
  path: NonEmptyStr,
  method: HttpMethod,
  // The ONLY status that means success. For the App's review call this is 204 alone; the two
  // pending_deployments calls answer 200, and conflating them is the failure in which a broker reads
  // a poll's 200-with-body as an accepted review.
  success_status: HttpStatus,
}

data review_call: RestCall = RestCall {
  path: review_endpoint_path,
  method: review_endpoint_method,
  success_status: review_endpoint_success_status,
}

data pending_deployments_poll_call: RestCall = RestCall {
  path: pending_deployments_endpoint_path,
  method: pending_deployments_endpoint_method,
  success_status: poll_success_status,
}

data human_review_call: RestCall = RestCall {
  path: human_review_endpoint_path,
  method: human_review_endpoint_method,
  success_status: poll_success_status,
}

// The poll and the human review answer 200; the App's review answers 204. Named once because two
// calls share it, and the witness asserts the two values are DIFFERENT rather than repeating them.
data poll_success_status: HttpStatus = 200

// THE DISCRIMINATING SUCCESS TEST. 204 on the App's review call is the entire witness that GitHub
// took the review — there is no body to read, and the deployment's fate cannot be inferred from the
// response. A broker that treated any non-error, or a 200 from the poll, as success would report an
// approval it never received. This fold is what stage 2 calls on the response.
fn review_call_succeeded(status: HttpStatus) -> Bool {
  status == review_call.success_status
}

// The two authorities answer with different codes, so a broker cannot tell them apart by "was it a
// 2xx". Asserting the difference here rather than leaving two rows that happen to differ.
fn the_two_success_statuses_are_not_the_same() -> Bool {
  review_call.success_status != human_review_call.success_status
}

// The review call and the poll are DIFFERENT CALLS even though the poll's path and the human
// reviewer's path are the same resource reached by different methods. Method is part of the fact:
// GET pending_deployments is a read any repo reader may make; POST pending_deployments is a human
// decision; POST deployment_protection_rule is the App answering its own rule.
fn the_three_calls_are_distinguishable() -> Bool {
  review_call.path != pending_deployments_poll_call.path
    && review_call.method == POST
    && pending_deployments_poll_call.method == GET
    && human_review_call.method == POST
    && human_review_call.path == pending_deployments_poll_call.path
    && human_review_call.method != pending_deployments_poll_call.method
}

// ---------------------------------------------------------------------------
// Consumers for the rows that would otherwise be data with no reader (§3c: an added
// declaration with no consumer is dangling, and dangling is the one structural red)
// ---------------------------------------------------------------------------

// THE CALLBACK PAIR IS CHECKABLE, NOT DESCRIPTIVE. The broker posts to the URL GitHub put in the
// payload's `deployment_callback_url` field, and that field is the one whose name upstream publishes;
// reading any other field, or posting anywhere else, is refused here. This is the consumer that makes
// the callback relation a fact rather than a sentence.
fn rule_review_is_answerable_at(payload_field: NonEmptyStr, target_path: NonEmptyStr) -> Bool {
  payload_field == rule_review_callback.payload_field
    && target_path == rule_review_callback.addresses
    && rule_webhook_payload_field_is_published(name: payload_field)
}

// THE TOKEN IDENTITY IS READ FROM THE PAYLOAD, not from a configured constant — the upstream's own
// instruction, as a fold. A receiver that reads a different field for the installation id is refused.
fn rule_installation_id_is_read_from(payload_field: NonEmptyStr) -> Bool {
  payload_field == rule_installation_id_payload_field
    && rule_webhook_payload_field_is_published(name: payload_field)
}

// THE PERMISSION THIS CALL NEEDS, as one typed row (axis + level) rather than two strings that have
// to be kept in step. Consumed by the activation check: an App that lacks it cannot answer, and the
// operator's registration step is checked against this rather than against a description.
fn review_permission_is_satisfied(permissions: List<GitHubAppPermission>) -> Bool {
  permissions |> any(p => p.name == review_required_permission.name
    && p.access == review_required_permission.access)
}

// The environment projection keys its protection rules on a field named `type`. Named as a row
// because the read-back that gates activation reads THAT key; the consumer is the lookup below.
fn environment_protection_types_are_read_from(key: NonEmptyStr) -> Bool {
  key == environment_protection_type_field
}

// THE FAIL-CLOSED READING, as the value the model asserts rather than a claim about prose. The fold
// that decides what happens when the App never answers reads this; a change to the wrong arm is a
// change of value, caught by the witness, not an edit to a sentence.
fn rule_timeout_fails_the_job() -> Bool {
  rule_timeout_is_a_refusal(outcome: rule_timeout_outcome)
}

// ---------------------------------------------------------------------------
// Cited scope rows: every fact above points at the authority that states it
// ---------------------------------------------------------------------------

// THE CITATION TABLE, following extdeps.cpu.ampere's shape: a FactCitation per upstream fact, each
// naming the declaration and the authority that publishes it. This is the consumer for the reference
// rows — a DeclarationRef that nothing cites is a pointer to nothing — and it is what makes §3b's
// "external facts must be cited" checkable per row rather than asserted once for the module.
data deployment_protection_rule_fact_citations: List<FactCitation> = [
  FactCitation {
    fact: review_endpoint_ref,
    authority: rest_authority,
  },
  FactCitation {
    fact: review_state_enum_ref,
    authority: openapi_authority,
  },
  FactCitation {
    fact: pending_deployments_endpoint_ref,
    authority: rest_authority,
  },
  FactCitation {
    fact: human_review_endpoint_ref,
    authority: rest_authority,
  },
  FactCitation {
    fact: rule_webhook_fields_ref,
    authority: webhook_authority,
  },
  FactCitation {
    fact: environment_protection_types_ref,
    authority: environment_authority,
  },
  FactCitation {
    fact: rule_timeout_ref,
    authority: enablement_authority,
  },
]

// Every cited fact points at a declaration that EXISTS in this module. A rename that leaves a citation
// pointing at a retired name reddens this rather than quietly dropping the citation — the failure mode
// where a model keeps its five authority rows while the facts they covered have moved on.
fn every_citation_names_a_live_declaration() -> Bool {
  (deployment_protection_rule_fact_citations |> count) == 7
    && (deployment_protection_rule_fact_citations
        |> all(c => c.fact.module_path == "extdeps.github.deployment_protection_rule"))
    && (deployment_protection_rule_fact_citations
        |> all(c => rule_webhook_field_names_include(c.fact.decl_name)
          || c.fact.decl_name == "rule_webhook_field_environment"
          || c.fact.decl_name == "review_endpoint_path"
          || c.fact.decl_name == "review_state_wire"
          || c.fact.decl_name == "pending_deployments_endpoint_path"
          || c.fact.decl_name == "human_review_endpoint_path"
          || c.fact.decl_name == "environment_protection_rule_type_values"
          || c.fact.decl_name == "rule_timeout"))
}

fn rule_webhook_field_names_include(name: NonEmptyStr) -> Bool {
  rule_webhook_published_fields |> any(f => f == name)
}

// The scope rows, each pointing at a declaration by name. Kept as DeclarationRef values because the
// citation table above is what reads them; a ref with no citation is dangling and gets deleted.
data review_endpoint_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.github.deployment_protection_rule",
  decl_name: "review_endpoint_path",
  field: WholeDeclaration
}

data review_state_enum_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.github.deployment_protection_rule",
  decl_name: "review_state_wire",
  field: WholeDeclaration
}

data pending_deployments_endpoint_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.github.deployment_protection_rule",
  decl_name: "pending_deployments_endpoint_path",
  field: WholeDeclaration
}

data human_review_endpoint_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.github.deployment_protection_rule",
  decl_name: "human_review_endpoint_path",
  field: WholeDeclaration
}

data rule_webhook_fields_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.github.deployment_protection_rule",
  decl_name: "rule_webhook_field_environment",
  field: WholeDeclaration
}

data environment_protection_types_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.github.deployment_protection_rule",
  decl_name: "environment_protection_rule_type_values",
  field: WholeDeclaration
}

data rule_timeout_ref: DeclarationRef = DeclarationRef {
  module_path: "extdeps.github.deployment_protection_rule",
  decl_name: "rule_timeout",
  field: WholeDeclaration
}

data extdeps_external_authority_anchor: ExternalAuthority = rule_authority

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: review_endpoint_ref
  },
  first_citation: extdeps.github.deployment_protection_rule.extdeps_external_authority_anchor,
  further_citations: [
    extdeps.github.deployment_protection_rule.rest_authority,
    extdeps.github.deployment_protection_rule.webhook_authority,
    extdeps.github.deployment_protection_rule.environment_authority,
    extdeps.github.deployment_protection_rule.openapi_authority,
    extdeps.github.deployment_protection_rule.enablement_authority
  ]
}
