module extdeps.github.github

import std.types { NonEmptyStr, Timestamp }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.github.github_contracts { user_type_wire_contract }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest"
  }
}

type UserType = User | Bot | Organization

type GitHubUser {
  login: String
  id: Int
  type: UserType
}

type Repository {
  owner: String
  name: String
  full_name: String
  private: Bool
  default_branch: String
}

// GitHub's documented HTTPS clone URL for a repository is https://github.com/OWNER/REPO.git
// (docs.github.com/en/get-started/git-basics/about-remote-repositories, read 2026-08-01). It is
// projected from owner and name rather than stored, because storing it would be a second
// representation of a fact those two fields already fix, free to disagree with them.\n\nWHY THIS
// PROJECTION IS WORTH HAVING AT ALL, since git will equally accept the local alias `origin`. An
// alias is a fact about one checkout's configuration, not about a repository: two checkouts can
// point `origin` at different repositories and the same repository can be reached under a different
// alias or none. A caller that reads refs from `origin` and pull requests from an owner/name pair
// has performed two reads that are only COINCIDENTALLY about the same repository, and nothing in
// either result would reveal it if they were not. Projecting the remote from the same Repository
// that names the API target makes them the same subject by construction.

fn github_https_clone_url(repo: Repository) -> NonEmptyStr {
  join(["https://github.com/", repo.owner, "/", repo.name, ".git"], "") as NonEmptyStr
}

// AN ORGANIZATION'S URL IS https://github.com/ORG, one path segment and no more, and that is the
// whole discriminator: a repository URL under the same owner is https://github.com/ORG/REPO, so the
// two scopes differ only in what follows the login. A self-hosted runner's .runner records the scope
// it registered into as one of these URLs, and GitHub admits registrations at both scopes, so a
// consumer that must know WHICH cannot reduce the question to the final path segment -- under that
// reading https://github.com/another-owner/ORG passes, and so does anything at all ending in the
// login. Comparing the whole URL against this projection is what separates them.
fn github_organization_url(login: NonEmptyStr) -> NonEmptyStr {
  join(["https://github.com/", login as String], "") as NonEmptyStr
}

type GitHubAuthToken {
  token: Secret
  scopes: List<GitHubScope>
  expires_at: Timestamp?
}

type GitHubScope
  = ScopeRepo
  | ScopeGist
  | ScopeWorkflow
  | ScopeReadOrg
  | ScopeReadUser

type GitHubPermission = PermRead | PermWrite | PermAdmin

data default_api_base: NonEmptyStr = "https://api.github.com"

data default_per_page: Int = 30

data max_per_page: Int = 100
