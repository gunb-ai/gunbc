module extdeps.github.actions_runner

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.crypto.hash { Digest, sha256_digest, digest_shell_verify_line }
import extdeps.toolchain.types {
  Architecture,
  Aarch64,
  X86_64,
  X86,
  Arm,
  Armv7,
  Mips,
  Mipsel,
  Mips64,
  Mips64el,
  Riscv64,
  Wasm32,
}
import std.types { NonEmptyStr, String, List }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/actions/runner/releases"
  }
}

type ActionsRunnerRelease {
  version: NonEmptyStr
  digest_aarch64: Digest
  digest_x86_64: Digest
}

type ActionsRunnerPublishedLinuxArch = ActionsRunnerLinuxArm64 | ActionsRunnerLinuxX64

fn actions_runner_published_linux_arch_key_of(arch: ActionsRunnerPublishedLinuxArch) -> NonEmptyStr {
  match arch {
    ActionsRunnerLinuxArm64 => "arm64" as NonEmptyStr
    ActionsRunnerLinuxX64 => "x64" as NonEmptyStr
  }
}

fn actions_runner_published_linux_arch_of(arch: Architecture) -> ActionsRunnerPublishedLinuxArch? {
  match arch {
    Aarch64 => Present { value: ActionsRunnerLinuxArm64 }
    X86_64 => Present { value: ActionsRunnerLinuxX64 }
    X86 => none
    Arm => none
    Armv7 => none
    Mips => none
    Mipsel => none
    Mips64 => none
    Mips64el => none
    Riscv64 => none
    Wasm32 => none
  }
}

type ActionsRunnerBinaryArtifact {
  binary_release: ActionsRunnerRelease
  arch: ActionsRunnerPublishedLinuxArch
}

fn actions_runner_binary_artifact_for_arch(
  binary_release: ActionsRunnerRelease,
  arch: Architecture,
) -> ActionsRunnerBinaryArtifact? {
  match actions_runner_published_linux_arch_of(arch: arch) {
    Present { value: published } =>
      Present {
        value: ActionsRunnerBinaryArtifact {
          binary_release: binary_release,
          arch: published,
        }
      }
    Absent => none
  }
}

fn actions_runner_release_digest(artifact: ActionsRunnerBinaryArtifact) -> Digest {
  match artifact.arch {
    ActionsRunnerLinuxArm64 => artifact.binary_release.digest_aarch64
    ActionsRunnerLinuxX64 => artifact.binary_release.digest_x86_64
  }
}

fn actions_runner_tarball_filename(artifact: ActionsRunnerBinaryArtifact) -> String {
  let arch_key = actions_runner_published_linux_arch_key_of(arch: artifact.arch)
  join(
    ["actions-runner-linux-", arch_key as String, "-", artifact.binary_release.version as String, ".tar.gz"],
    "",
  )
}

fn actions_runner_download_url(artifact: ActionsRunnerBinaryArtifact) -> String {
  let file = actions_runner_tarball_filename(artifact: artifact)
  join(
    [
      "https://github.com/actions/runner/releases/download/v",
      artifact.binary_release.version as String,
      "/",
      file,
    ],
    "",
  )
}

data actions_runner_release_2_334_0: ActionsRunnerRelease = ActionsRunnerRelease {
  version: "2.334.0",
  digest_aarch64: sha256_digest(hex: "f44255bd3e80160eb25f71bc83d06ea025f6908748807a584687b3184759f7e4"),
  digest_x86_64: sha256_digest(hex: "048024cd2c848eb6f14d5646d56c13a4def2ae7ee3ad12122bee960c56f3d271"),
}

data actions_runner_base_dir: String = "/opt/actions-runner"

data actions_runner_cache_dir: String = "/opt/actions-runner-cache"

data actions_runner_slot_extract_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "host_effect_apply",
    field: WholeDeclaration,
  }
}

// PRIVILEGE IS SPENT ONCE, TO SET OWNERSHIP -- everything downstream of that runs as the caller.
// The prior form ran the whole sequence under sudo: rm, install -d, tar, then a recursive chown to
// undo the root ownership tar had just created. That is privilege held across four operations to
// reach a state one of them could have established directly, and the chown existed only because
// the extract before it was privileged for no reason.
//
// It was also not a preference. The runner principal's NOPASSWD roster
// (gunbc.fleet_posix_accounts fleet_posix_ci_runner_sudo_grants) grants install, rm, systemctl,
// apt-get, visudo and tailscale -- it does not grant tar or chown, and never did. So the emitted
// script named two binaries the principal executing it could not sudo, and nothing joined the two
// authorities: the mismatch was discoverable only by running a wet apply on a real host, which is
// the most expensive place a repository can learn what its own grant roster says. Measured on
// srv3, an add-only materialization apply refused at the first ungranted sudo with zero slots
// mutated.
//
// install -d -o/-g creates the directory already owned by job_user, so tar and the tarball cleanup
// need no privilege at all, and the surviving sudo verbs are exactly two roster members.

fn actions_runner_slot_extract_script(
  artifact: ActionsRunnerBinaryArtifact,
  slot_dir: NonEmptyStr,
  job_user: NonEmptyStr,
) -> String {
  let url = actions_runner_download_url(artifact: artifact)
  let digest = actions_runner_release_digest(artifact: artifact)
  let tarball = actions_runner_tarball_filename(artifact: artifact)
  join([
    "set -e",
    join(["curl -fsSL '", url, "' -o /tmp/actions-runner.tar.gz"], ""),
    digest_shell_verify_line(digest: digest, file_path: "/tmp/actions-runner.tar.gz"),
    join(["sudo rm -rf '", slot_dir as String, "'"], ""),
    join([
      "sudo install -d -m 755 -o ",
      job_user as String,
      " -g ",
      job_user as String,
      " '",
      slot_dir as String,
      "'",
    ], ""),
    join(["tar xzf /tmp/actions-runner.tar.gz -C '", slot_dir as String, "'"], ""),
    "rm -f /tmp/actions-runner.tar.gz",
    "",
  ], "\n")
}

data actions_runner_base_dir_ensure_script_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "gunbc.host_effect",
    decl_name: "host_effect_apply",
    field: WholeDeclaration,
  }
}

fn actions_runner_base_dir_ensure_script(runner_user: NonEmptyStr) -> String {
  join([
    "set -e",
    join(["sudo install -d -m 755 -o ", runner_user as String, " -g ", runner_user as String, " ", actions_runner_base_dir], ""),
    join(["sudo install -d -m 755 -o ", runner_user as String, " -g ", runner_user as String, " ", actions_runner_cache_dir], ""),
    "",
  ], "\n")
}

