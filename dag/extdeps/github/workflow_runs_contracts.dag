module extdeps.github.workflow_runs_contracts


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/actions/workflow-runs"
  }
}

data workflow_run_status_wire_contract: std.serialization.CoproductWireContract = {
  coproduct: "WorkflowRunStatus"
  encoding: std.serialization.StringVariant { naming: std.serialization.SnakeCase }
}

data workflow_run_conclusion_wire_contract: std.serialization.CoproductWireContract = {
  coproduct: "WorkflowRunConclusion"
  encoding: std.serialization.StringVariant { naming: std.serialization.SnakeCase }
}
