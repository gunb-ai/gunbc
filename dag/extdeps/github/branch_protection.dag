module extdeps.github.branch_protection

import extdeps.github.github { default_api_base }
import extdeps.github.errors { GitHubErrorShape }
import std.credentials { EnvVar }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/rest/branches/branch-protection"
  }
}

data branch_protection_managed_subset_note: String = "This models the SUBSET of GitHub's branch-protection resource that gunbc.branch_protection authors and reconciles — required status checks, required review count, admin enforcement, and the push-restriction allowance list (the classic branch-protection `restrictions` object: users/teams/apps permitted to push when the branch is push-restricted). It is NOT the full protection resource (signatures, linear-history, conversation-resolution, lock, etc. are unmodeled and left untouched by the reconciler — the authority declares only what it owns). GitHub semantics captured faithfully: required_status_checks.strict = require branch up to date before merge; required_status_checks.contexts = the check names that must pass (e.g. the `ci` job); enforce_admins = protection also applies to admins; required_approving_review_count under required_pull_request_reviews; push allowance = the `restrictions` object (present = only these actors push; absent = anyone with write pushes). A GitHub App that direct-pushes heal commits to a push-restricted main appears here as an entry in push_allowance.apps."

type RequiredStatusChecks {
  strict: Bool
  contexts: List<String>
}

type PushAllowance {
  users: List<String>
  teams: List<String>
  apps: List<String>
}

type BranchProtectionState {
  required_status_checks: RequiredStatusChecks
  enforce_admins: Bool
  required_approving_review_count: Int
  push_restricted: Bool
  push_allowance: PushAllowance
}

service github.BranchProtection {
  config {
    endpoint: default_api_base
    auth: Bearer
    auth_source: EnvVar { name: "GITHUB_TOKEN" }

    rate_limit: { requests: 5000, per: hour, scope: core }

    retry: { max_attempts: 3, backoff: exponential, retry_on: [429, 500, 502, 503, 504] }
  }

  operation Get {
    input {
      auth_token: Secret
      owner: String
      repo: String
      branch: String
    }
    output {
      protection: BranchProtectionState
    }
    readonly
    transport rest {
      method: GET,
      path: "/repos/\{owner\}/\{repo\}/branches/\{branch\}/protection"
    }
    response {
      200 => BranchProtectionState
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }

  operation Update {
    input {
      auth_token: Secret
      owner: String
      repo: String
      branch: String
      required_status_checks: RequiredStatusChecks
      enforce_admins: Bool
      required_approving_review_count: Int
      push_allowance: PushAllowance
    }
    output {
      protection: BranchProtectionState
    }
    transport rest {
      method: PUT,
      path: "/repos/\{owner\}/\{repo\}/branches/\{branch\}/protection",
      body: {
        required_status_checks: required_status_checks,
        enforce_admins: enforce_admins,
        required_approving_review_count: required_approving_review_count,
        push_allowance: push_allowance
      }
    }
    response {
      200 => BranchProtectionState
      401 => GitHubErrorShape
      404 => GitHubErrorShape
      422 => GitHubErrorShape
      5xx => GitHubErrorShape
    }
  }
}
