module extdeps.github.org_actions

import std.types { NonEmptyStr, String, Bool, Int, List }

// ORG-LEVEL GITHUB ACTIONS SETTINGS - the upstream surface, cited. These are the org
// settings that decide whether a repository's workflows can reach the org's self-hosted
// runners at all: the runner GROUP is the access-control object, not the runner
// (docs.github.com/en/rest/actions/self-hosted-runner-groups, read 2026-08-30). This
// module owns the SHAPE the API returns; which groups our org should have and which
// repositories they must admit is a fleet policy fact and lives in gunbc.fleet, never
// here.

type RunnerGroupVisibility
  = AllRepositories
  | SelectedRepositories

// The request/response wire spelling of a visibility, as the docs name it.
fn runner_group_visibility_wire(v: RunnerGroupVisibility) -> NonEmptyStr {
  match v {
    AllRepositories => "all" as NonEmptyStr
    SelectedRepositories => "selected" as NonEmptyStr
  }
}

// The runner_groups[] element shape. selected_repositories_url is populated only when
// visibility is selected; allows_public_repositories gates whether public-repo workflows
// may use the group (public forks running on self-hosted hardware is the canonical
// self-hosted security trap, which is why it defaults false upstream). restricted_to_workflows
// (default false) limits the group to the workflows named in selected_workflows, each identified
// as `<owner>/<repo>/<workflow path>@<ref>`; workflow_restrictions_read_only reports that an
// enterprise policy fixes the restriction (REST API version 2022-11-28, read 2026-09-23). The list
// and get responses carry the same element schema.
type OrgRunnerGroup {
  id: Int
  name: NonEmptyStr
  visibility: RunnerGroupVisibility
  allows_public_repositories: Bool
  restricted_to_workflows: Bool
  selected_workflows: List<String>
  workflow_restrictions_read_only: Bool
}

// THE CLI TRANSPORT, one of N realizations and not a fact about the dependency -
// consistent with extdeps.github.actions_runs github.CliActionsRuns. Both operations are
// readonly observations; the repositories read exists because per-repo admission is only
// decidable by joining a selected-visibility group to its repository list.
service github.CliOrgRunnerGroups {
  operation ListRunnerGroupsJson {
    input {
      org: NonEmptyStr
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["gh", "api", "orgs/{org}/actions/runner-groups"]
    }
  }

  operation ListRunnerGroupRepositoriesJson {
    input {
      org: NonEmptyStr
      runner_group_id: Int
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["gh", "api", "orgs/{org}/actions/runner-groups/{runner_group_id}/repositories"]
    }
  }

  // POST /orgs/{org}/actions/runner-groups (REST API version 2022-11-28, read 2026-09-23): name is
  // required; visibility is one of selected | all | private (default all); selected_repository_ids,
  // allows_public_repositories (default false), restricted_to_workflows (default false) and
  // selected_workflows are optional. 201 returns the created group in the OrgRunnerGroup shape.
  // Every body member is an INPUT: which group, which repository and which workflow are the
  // caller's policy, never a literal of this interface. `-F` sends JSON-typed values (integers and
  // booleans) and `-f` sends strings; the `[]` suffix sends a one-element array.
  operation CreateRunnerGroupJson {
    input {
      org: NonEmptyStr
      name: NonEmptyStr
      visibility: NonEmptyStr
      selected_repository_id: Int
      allows_public_repositories: Bool
      restricted_to_workflows: Bool
      selected_workflow: NonEmptyStr
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell {
      argv: [
        "gh", "api", "--method", "POST", "orgs/{org}/actions/runner-groups",
        "-f", "name={name}",
        "-f", "visibility={visibility}",
        "-F", "selected_repository_ids[]={selected_repository_id}",
        "-F", "allows_public_repositories={allows_public_repositories}",
        "-F", "restricted_to_workflows={restricted_to_workflows}",
        "-f", "selected_workflows[]={selected_workflow}"
      ]
    }
  }
}
