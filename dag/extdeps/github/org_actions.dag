module extdeps.github.org_actions

import std.types { NonEmptyStr, String, Bool, Int, List }

// ORG-LEVEL GITHUB ACTIONS SETTINGS - the upstream surface, cited. These are the org
// settings that decide whether a repository's workflows can reach the org's self-hosted
// runners at all: the runner GROUP is the access-control object, not the runner
// (docs.github.com/en/rest/actions/self-hosted-runner-groups, read 2026-08-30). This
// module owns the SHAPE the API returns; which groups our org should have and which
// repositories they must admit is a fleet policy fact and lives in gunbc.fleet, never
// here.

type RunnerGroupVisibility
  = AllRepositories
  | SelectedRepositories

// The runner_groups[] element shape. selected_repositories_url is populated only when
// visibility is selected; allows_public_repositories gates whether public-repo workflows
// may use the group (public forks running on self-hosted hardware is the canonical
// self-hosted security trap, which is why it defaults false upstream).
type OrgRunnerGroup {
  id: Int
  name: NonEmptyStr
  visibility: RunnerGroupVisibility
  allows_public_repositories: Bool
}

// THE CLI TRANSPORT, one of N realizations and not a fact about the dependency -
// consistent with extdeps.github.actions_runs github.CliActionsRuns. Both operations are
// readonly observations; the repositories read exists because per-repo admission is only
// decidable by joining a selected-visibility group to its repository list.
service github.CliOrgRunnerGroups {
  operation ListRunnerGroupsJson {
    input {
      org: NonEmptyStr
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["gh", "api", "orgs/{org}/actions/runner-groups"]
    }
  }

  operation ListRunnerGroupRepositoriesJson {
    input {
      org: NonEmptyStr
      runner_group_id: Int
    }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: ["gh", "api", "orgs/{org}/actions/runner-groups/{runner_group_id}/repositories"]
    }
  }
}
