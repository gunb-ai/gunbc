type ChromiumVersion = std.types.NonEmptyStr where brand("ChromiumVersion")
type ChromiumSourceRevision = std.types.NonEmptyStr where brand("ChromiumSourceRevision")

type ChromiumSourceIdentity
  = ChromiumSourceRevisionObserved { revision: ChromiumSourceRevision }
  | ChromiumSourceRevisionUnobserved

type ChromiumBuild {
  version: ChromiumVersion
  source_identity: ChromiumSourceIdentity
}

data chromium_151_0_7922_34: ChromiumBuild = ChromiumBuild {
  version: "151.0.7922.34" as ChromiumVersion,
  source_identity: ChromiumSourceRevisionUnobserved,
}

type ChromiumNavigationError
  = ChromiumErrConnectionRefused
  | ChromiumErrHttpResponseCodeFailure

type ChromiumInternalDocument
  = | ChromiumWebDataErrorDocument

type ChromiumInternalUrl
  = | ChromiumWebDataErrorUrl

data chromium_identity_boundary_note: std.types.NonEmptyStr = "ChromiumBuild names the Chromium project build grounded by its reported version. The tested binary did not report its source revision, so ChromiumSourceRevisionUnobserved keeps that identity gap explicit; the pinned authority revision grounds the modeled Chromium vocabulary but is not attributed to the binary. ChromiumBuild is not a Google Chrome, Opera, Edge, or Playwright identity. ChromiumWebDataErrorUrl denotes the exact chrome-error://chromewebdata/ internal URL observed by the downstream receipt without reclassifying the binary as another browser distribution." as NonEmptyStr
