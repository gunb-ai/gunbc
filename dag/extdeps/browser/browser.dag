module extdeps.browser

data extdeps_browser_non_precedent_disposition: String = "NON-PRECEDENT — DO NOT COPY THIS MODULE'S SHAPE FOR NEW BROWSER-PRODUCT MODELING (operator verdict on gunbc#7556; DESIGN §3 'External upstream decomposition'). This module conflates three independently governed things into one authority: the Playwright automation interface (its anchor cites playwright.dev while the module is named 'browser'), a generic browser abstraction (BrowserContext/Page/Element as bare brands), and a shell transport realization (every operation hardwired to a playwright-runner argv — the §3 interface/transport fusion). Its eventual split, staged behind the ExternalModelScope enrollment frontier (gunbc.extdeps_scope_frontier): extdeps.automation.playwright owns the Playwright dependency's real cited interface; the agnostic browser interaction shape lives as a shared standard/interface module with no product enumeration; the shell transport becomes a bound realization handler, one of N, beside the SDK/CDP handlers. Until that split lands, new browser-product facts go in one-module-per-subject authorities (extdeps.browser.chromium, extdeps.browser.google_chrome, ...), never here."

data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "playwright.dev/docs/api/class-browsercontext"
  }
}

type BrowserConfig {
  headless: Bool = false
  profile_path: std.types.FilePath
  viewport_width: Int = 1280
  viewport_height: Int = 900
}

type BrowserContext = String where brand("BrowserContext")
type Page           = String where brand("Page")
type Element        = String where brand("Element")

service browser.Context {
  operation Launch {
    input { headless: String = "false", profile_path: std.types.FilePath }
    output { context: BrowserContext from "stdout" }
    transport shell { argv: ["playwright-runner", "launch", "--headless", "{headless}", "--profile", "{profile_path}"] }
  }

  operation Close {
    input { context: BrowserContext }
    output {}
    transport shell { argv: ["playwright-runner", "close", "{context}"] }
  }
}

service browser.Page {

  operation Goto {

    input { url: String, wait_until: String = "domcontentloaded" }
    output { final_url: String from "stdout" }
    transport shell { argv: ["playwright-runner", "goto", "{url}", "--wait-until", "{wait_until}"] }
  }

  operation CurrentUrl {

    input {}
    output { url: String from "stdout" }
    transport shell { argv: ["playwright-runner", "url"] }
  }

  operation Title {
    input {}
    output { title: String from "stdout" }
    transport shell { argv: ["playwright-runner", "title"] }
  }

  operation WaitForSelector {
    input { selector: String, timeout_ms: Int = 30000 }
    output { found: String from "stdout" }
    transport shell { argv: ["playwright-runner", "wait-for", "{selector}", "--timeout", "{timeout_ms}"] }
  }

  operation QueryAll {
    input { selector: String }
    output { count: String from "stdout" }
    transport shell { argv: ["playwright-runner", "query-all", "{selector}"] }
  }

  operation Click {
    input { selector: String }
    output {}
    transport shell { argv: ["playwright-runner", "click", "{selector}"] }
  }

  operation Fill {
    input { selector: String, text: String }
    output {}
    transport shell { argv: ["playwright-runner", "fill", "{selector}", "{text}"] }
  }

  operation Evaluate {
    input { expression: String }
    output { result: String from "stdout" }
    transport shell { argv: ["playwright-runner", "evaluate", "{expression}"] }
  }

  operation UploadFile {
    input { selector: String, path: std.types.FilePath }
    output {}
    transport shell { argv: ["playwright-runner", "upload", "{selector}", "{path}"] }
  }

  operation Screenshot {
    input { path: std.types.FilePath }
    output {}
    transport shell { argv: ["playwright-runner", "screenshot", "{path}"] }
  }

  operation Wait {
    input { ms: Int }
    output {}
    transport shell { argv: ["playwright-runner", "wait", "{ms}"] }
  }
}

service browser.Element {

  operation IsVisible {
    input { selector: String }
    output { visible: String from "stdout" }
    transport shell { argv: ["playwright-runner", "is-visible", "{selector}"] }
  }

  operation InnerText {
    input { selector: String }
    output { text: String from "stdout" }
    transport shell { argv: ["playwright-runner", "inner-text", "{selector}"] }
  }

  operation EvaluateOn {
    input { selector: String, expression: String }
    output { result: String from "stdout" }
    transport shell { argv: ["playwright-runner", "evaluate-on", "{selector}", "{expression}"] }
  }
}
