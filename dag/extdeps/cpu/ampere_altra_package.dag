module extdeps.cpu.ampere_altra_package

import std.types { String, NonEmptyStr, List, Map }
import extdeps.cpu.types { CpuSocket }
import extdeps.cpu.ampere { altra_max_m12830_catalog, ampere_altra_rev_a1_datasheet_authority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor.ampere { ampere_customer_reference_boards_authority }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "amperecomputing.com/briefs/ampere-altra-family-product-brief"
  }
}

// VERIFIED LIVE 2026-08-11 by fetching the product brief AND by extracting the text of the
// cited Altra Max Rev A1 datasheet PDF (Issue 1.15). Quoted from the brief: "4926-Pin FCLGA";
// "8 Channels 72-bit DDR4-3200 with ECC"; "Up to 16 DIMMs (2DPC) and 4 TB total memory";
// "128 Lanes PCIe Gen4". Read from the datasheet itself: section 3 Mechanical Data gives the
// package as 77.080 mm x 67.000 mm; section 5 is "Pin Assignment - Sorted by Pin Number",
// Table 4, thirty-five sheets of PIN # to SIGNAL NAME; section 6 carries Signal Descriptions
// with 6.1 Reserved Pins naming all thirty-nine explicitly; section 9 is Power Supply
// Sequencing, split into SoC and PCP domains.
data ampere_altra_package_note: String = "THE ALTRA PACKAGE PINOUT IS PUBLIC, AND AN EARLIER REVISION OF THIS MODULE SAID IT WAS NOT. That revision declared the per-contact map, the power sequencing and the admitted memory topologies to be NDA-only, and refused on that basis. It was wrong, and the way it was wrong is worth keeping: the claim was reasoned from the fact that Ampere's reference board collateral IS under NDA, and never checked against the datasheet this repository was already citing. The refusal was therefore well-typed, executed on the real acceptance path, defended by a passing witness, and false — a fabricated verdict wearing every mark of a grounded one. THE ACTUAL SPLIT, read from the documents. PUBLIC, in the Rev A1 datasheet Issue 1.15: the complete pin assignment table (section 5, Table 4, thirty-five sheets), the signal functional descriptions with widths, directions and I/O types (section 6.2, Table 6), the thirty-nine reserved pins by designator (section 6.1), the pin summary decomposition (Table 5), mechanical data (section 3), electrical specifications (section 7) and power supply sequencing for both the SoC and PCP domains (section 9). NDA, via Customer Connect: the reference BOARD collateral — the Mt. Jade, Mt. Collins, Mt. Bonnell and Mt. Snow motherboard design packages, plus UEFI, OpenBMC and CPLD source. Those are board designs, not package facts, and conflating the two is what produced the error. THE PROPRIETARY FOOTER IS A RECORDED ATTRIBUTE, NOT A CARRIAGE BARRIER: every page of the datasheet is footed 'Ampere Computing Proprietary', but carriage derives from public availability — the locator returns the PDF without login — not from the footer. Transcribing the publicly reachable datasheet tables is therefore admissible on that axis; Customer Connect board collateral remains barred because it is not public, not because it is proprietary. TWO READING TRAPS IN THE SIGNAL NAMES, recorded because both are easy to get backwards. The DDR4_/DDR5_/DDR6_/DDR7_ prefixes are CHANNEL indices four through seven, not memory generations — section 6.2 groups them as 'DDR[0:7]' across eight DDR4 channels and the shared rail is named VDDQ_DDR4567. And Table 4 states it 'does not list the depopulated pins on the package', so a row count taken from that table is not automatically the package population; the completeness authority is Table 5, carried below."

// Table 5, Pin Summary, cited to the datasheet. This is the completeness authority a contact
// map must join against — and it cross-foots exactly, which is why it is carried as its parts
// rather than as the total alone: a transcription that drops a group fails the sum instead of
// silently reducing the population it claims to cover.
data altra_signal_pin_count: Int = 1960

data altra_power_and_ground_pin_count: Int = 2927

data altra_reserved_pin_count: Int = 39

fn altra_pin_summary_total() -> Int {
  altra_signal_pin_count + altra_power_and_ground_pin_count + altra_reserved_pin_count
}

// The package identity and its population are the CpuSocket row extdeps.cpu.ampere already
// carries, consumed rather than re-authored. An earlier revision minted an AltraPackageFamily
// enum and a second 4926 literal beside it, which is the floating-island shape review 51051
// named: a pin-map module with no import edge to the CPU catalog it claims to bound, joining
// its completeness check against a denominator that could drift away from the socket fact
// independently.
data altra_fclga_socket: CpuSocket = altra_max_m12830_catalog.socket

fn altra_declared_contact_count() -> Int {
  altra_fclga_socket.contact_count
}

data altra_ddr4_channel_count: Int = 8

data altra_max_dimms_per_socket: Int = 16

data altra_pcie_gen4_lane_count: Int = 128

// A single land on the package, identified by the designator its vendor authority assigns.
// The electrical function is deliberately NOT a Bool-ish "is power" axis: signal reference,
// power return, chassis bond and protective earth are distinct roles that a board must not
// fuse, and a contact whose function the authority does not state is FunctionUnstated rather
// than defaulted to anything.
type ContactElectricalFunction
  = PowerSupplyContact
  | PowerReturnContact
  | SignalReferenceContact
  | SingleEndedSignalContact
  | DifferentialPairMemberContact { pair: NonEmptyStr }
  | NoConnectContact
  | ReservedContact
  | FunctionUnstated

type PackageContact {
  designator: NonEmptyStr
  function: ContactElectricalFunction
}

type PackageContactMap {
  socket: CpuSocket
  contacts: List<PackageContact>
  authority: ExternalAuthority
}

// The three refusal causes are kept apart because their OWNERS differ. Collateral absence is a
// business prerequisite (someone must obtain access and resolve where the bytes may live); an
// incomplete population is our own unfinished ingestion; a duplicate designator is a defect in
// the map we were given or in how we read it. A single "map not ready" cause would route all
// three to the same reader and make the Altra blocker indistinguishable from a typo.
type PackageContactMapStanding
  = PackageContactMapAdmitted { resolved: Int }
  | ContactMapPubliclyAvailableNotIngested { document: NonEmptyStr, authority: ExternalAuthority }
  | ContactPopulationIncomplete { expected: Int, resolved: Int }
  | DuplicateContactDesignator { designator: NonEmptyStr }

fn contact_designators(map: PackageContactMap) -> List<NonEmptyStr> {
  map.contacts |> map(c => c.designator)
}

fn contact_count(map: PackageContactMap) -> Int {
  fold(map.contacts, init: 0, f: (acc, _) => acc + 1)
}

// TWO LINEAR PASSES, NOT A QUADRATIC ONE. An earlier revision re-counted the whole designator
// list once per element, which is 4926 x 4926 comparisons at the real package population — and
// DESIGN §6's bare-minimum-cost rule is explicit that a proven quadratic fold is fixed whatever
// the realized n, because "n is small here" is not a time-stable fact and this list is sized by
// a vendor's package, not by us.
//
// The maps carry membership ONLY and are never iterated, which is the pattern DESIGN's
// determinism thread sanctions: traversal order of a Map is host-unspecified, so the ORDER this
// answer depends on comes from the designator list itself in the second pass. That is what
// preserves the exact prior semantics — the first designator in SOURCE order whose value occurs
// more than once, not the position where a repeat happens to be noticed.
type DesignatorScan {
  seen: Map<NonEmptyStr, Bool>
  duplicated: Map<NonEmptyStr, Bool>
}

fn scan_designators(designators: List<NonEmptyStr>) -> DesignatorScan {
  fold(designators, init: DesignatorScan { seen: empty_map(), duplicated: empty_map() }, f: fn(acc, d) {
    if map_contains_key(acc.seen, d) {
      DesignatorScan { seen: acc.seen, duplicated: map_insert(acc.duplicated, d, true) }
    } else {
      DesignatorScan { seen: map_insert(acc.seen, d, true), duplicated: acc.duplicated }
    }
  })
}

fn first_duplicate_designator(designators: List<NonEmptyStr>) -> NonEmptyStr? {
  let scan = scan_designators(designators: designators)
  fold(designators, init: none, f: fn(acc, d) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent => if map_contains_key(scan.duplicated, d) { Present { value: d } } else { none }
    }
  })
}

// The admission is a COUNT-AND-IDENTITY JOIN against the declared package population, not a
// presence check on a field. That distinction is the whole point: a stub map naming itself
// "the Altra contact map" cannot pass, because 4926 unique designators is a quantity no
// placeholder carries. HONESTY ABOUT THE RUNG THIS REACHES (DESIGN §4b rung honesty): the
// completeness and uniqueness halves are mechanically preventable — they refuse by execution
// on the acceptance path. The PROVENANCE half is not: a caller who genuinely had 4926 unique
// invented designators would admit, because nothing here can distinguish an authored list
// from a vendor-supplied one. Closing that requires the observation to be independent of the
// party asserting it, which is the same unforgeable-construction frontier DESIGN names, and
// it is stated rather than papered over.
fn admit_package_contact_map(map: PackageContactMap, expected: Int) -> PackageContactMapStanding {
  match first_duplicate_designator(designators: contact_designators(map: map)) {
    Present { value: dup } => DuplicateContactDesignator { designator: dup }
    Absent => {
      let resolved = contact_count(map: map)
      if resolved == expected {
        PackageContactMapAdmitted { resolved: resolved }
      } else {
        ContactPopulationIncomplete { expected: expected, resolved: resolved }
      }
    }
  }
}

// The live standing of the Altra package in THIS repository, today. It still refuses, but for
// the correct reason and to the correct owner: the map is published and this repository has
// not ingested it. That is OUR unfinished work, not a business prerequisite, and the two route
// to different people — which is exactly the distinction the three refusal families exist to
// preserve, and exactly the one the previous revision got backwards.
fn altra_contact_map_standing() -> PackageContactMapStanding {
  ContactMapPubliclyAvailableNotIngested {
    document: "Ampere Altra Max Rev A1 datasheet Issue 1.15, section 5 Table 4 (pin assignment), section 6 Table 6 (signal descriptions), Table 5 (pin summary)",
    authority: ampere_altra_rev_a1_datasheet_authority,
  }
}

// THE NDA-BOUND SUBJECT GETS ITS OWN TYPE, not a variant of the package standing. An earlier
// revision returned MissingUpstreamDesignCollateral AS a PackageContactMapStanding, so the
// absence of a reference BOARD package rendered as a statement about the package contact map —
// the same fusion this lane corrected at the prose level and then re-committed at the type
// level one function down. Reference-board collateral is a different subject with a different
// owner, and now it cannot be mistaken for a package fact because it cannot inhabit that type.
type ReferenceBoardCollateralStanding
  = ReferenceBoardCollateralAvailable
  | ReferenceBoardCollateralUnderNda { subject: NonEmptyStr, access_route: ExternalAuthority }

fn altra_reference_board_collateral_standing() -> ReferenceBoardCollateralStanding {
  ReferenceBoardCollateralUnderNda {
    subject: "Ampere reference motherboard design packages (Mt. Jade, Mt. Collins, Mt. Bonnell, Mt. Snow) with UEFI, OpenBMC and CPLD source",
    access_route: ampere_customer_reference_boards_authority,
  }
}

data ampere_altra_package_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cpu.ampere_altra_package",
      decl_name: "altra_fclga_socket",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [ampere_altra_rev_a1_datasheet_authority, ampere_customer_reference_boards_authority]
}

data extdeps_model_scope: ExternalModelScope = ampere_altra_package_model_scope
