module extdeps.cpu.ampere_altra_package


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "amperecomputing.com/briefs/ampere-altra-family-product-brief"
  }
}

// VERIFIED LIVE 2026-08-11 by fetching the product brief AND by extracting the text of the
// cited Altra Max Rev A1 datasheet PDF (Issue 1.15). Quoted from the brief: "4926-Pin FCLGA";
// "8 Channels 72-bit DDR4-3200 with ECC"; "Up to 16 DIMMs (2DPC) and 4 TB total memory";
// "128 Lanes PCIe Gen4". Read from the datasheet itself: section 3 Mechanical Data gives the
// package as 77.080 mm x 67.000 mm; section 5 is "Pin Assignment - Sorted by Pin Number",
// Table 4, thirty-five sheets of PIN # to SIGNAL NAME; section 6 carries Signal Descriptions
// with 6.1 Reserved Pins naming all thirty-nine explicitly; section 9 is Power Supply
// Sequencing, split into SoC and PCP domains.
data ampere_altra_package_note: String = "THE ALTRA PACKAGE PINOUT IS PUBLIC, AND AN EARLIER REVISION OF THIS MODULE SAID IT WAS NOT. That revision declared the per-contact map, the power sequencing and the admitted memory topologies to be NDA-only, and refused on that basis. It was wrong, and the way it was wrong is worth keeping: the claim was reasoned from the fact that Ampere's reference board collateral IS under NDA, and never checked against the datasheet this repository was already citing. The refusal was therefore well-typed, executed on the real acceptance path, defended by a passing witness, and false — a fabricated verdict wearing every mark of a grounded one. THE ACTUAL SPLIT, read from the documents. PUBLIC, in the Rev A1 datasheet Issue 1.15: the complete pin assignment table (section 5, Table 4, thirty-five sheets), the signal functional descriptions with widths, directions and I/O types (section 6.2, Table 6), the thirty-nine reserved pins by designator (section 6.1), the pin summary decomposition (Table 5), mechanical data (section 3), electrical specifications (section 7) and power supply sequencing for both the SoC and PCP domains (section 9). NDA, via Customer Connect: the reference BOARD collateral — the Mt. Jade, Mt. Collins, Mt. Bonnell and Mt. Snow motherboard design packages, plus UEFI, OpenBMC and CPLD source. Those are board designs, not package facts, and conflating the two is what produced the error. THE PROPRIETARY FOOTER IS A RECORDED ATTRIBUTE, NOT A CARRIAGE BARRIER: every page of the datasheet is footed 'Ampere Computing Proprietary', but carriage derives from public availability — the locator returns the PDF without login — not from the footer. Transcribing the publicly reachable datasheet tables is therefore admissible on that axis; Customer Connect board collateral remains barred because it is not public, not because it is proprietary. TWO READING TRAPS IN THE SIGNAL NAMES, recorded because both are easy to get backwards. The DDR4_/DDR5_/DDR6_/DDR7_ prefixes are CHANNEL indices four through seven, not memory generations — section 6.2 groups them as 'DDR[0:7]' across eight DDR4 channels and the shared rail is named VDDQ_DDR4567. And Table 4 states it 'does not list the depopulated pins on the package', so a row count taken from that table is not automatically the package population; the completeness authority is Table 5, carried below."

// Table 5, extdeps.firmware.uefi_shell.Pin Summary, cited to the datasheet. This is the completeness authority a contact
// map must join against — and it cross-foots exactly, which is why it is carried as its parts
// rather than as the total alone: a transcription that drops a group fails the sum instead of
// silently reducing the population it claims to cover.
data altra_signal_pin_count: Int = 1960

data altra_power_and_ground_pin_count: Int = 2927

data altra_reserved_pin_count: Int = 39

fn altra_pin_summary_total() -> Int {
  altra_signal_pin_count + altra_power_and_ground_pin_count + altra_reserved_pin_count
}

// The package identity and its population are the CpuSocket row extdeps.cpu.ampere already
// carries, consumed rather than re-authored. An earlier revision minted an AltraPackageFamily
// enum and a second 4926 literal beside it, which is the floating-island shape review 51051
// named: a pin-map module with no import edge to the CPU catalog it claims to bound, joining
// its completeness check against a denominator that could drift away from the socket fact
// independently.
// DE-FORKED 2026-08-15. This read altra_max_m12830_catalog.socket — the ALTRA MAX M128-30 row —
// inside a module named for the Altra package, so a family mechanical fact was sourced from one
// specific product of the other family. The value was correct, which is exactly why it survived:
// both families are LGA4926, so every witness passed and nothing could have caught it by
// execution. It now reads the family authority, which is what it always meant.
data altra_fclga_socket: extdeps.cpu.types.CpuSocket = ampere_lga4926_socket

fn altra_declared_contact_count() -> Int {
  altra_fclga_socket.contact_count
}

// THE PACKAGE BODY EXTENT, section 3 Mechanical Data, carried as a typed row rather than as the
// sentence in the comment above it. It was prose here for two revisions, which is the exact shape
// DESIGN §4c forbids for a machine-consumed fact: no accepted program can read a comment, so a
// placement asking how much board area the processor occupies had no answer to join against while
// the number sat four lines away in English. THE UNIT IS EXACT, not rounded: 77.080 mm and 67.000
// mm are whole micrometres, so the datasheet's three decimal places survive the carrier instead of
// being truncated into millimetres and re-expanded later.
//
// THIS IS THE PACKAGE BODY AND NOTHING ELSE. It is not the socket, not the socket's board
// termination, and not the land pattern the board etches — the four are separately governed and
// this module's sibling attachment stack exists to keep them apart. What it legitimately bounds is
// the volume the processor occupies once seated, which is a real constraint on keepout and on
// neighbouring component clearance even while the socket part remains unselected.
data altra_package_body_width: std.measure.Micrometer = micrometer(count: 77080)

data altra_package_body_height: std.measure.Micrometer = micrometer(count: 67000)

// THE LAND PITCH BELONGS TO THE PACKAGE, NOT TO WHICHEVER DOCUMENT TRANSCRIBED IT FIRST. The
// datasheet's package mechanical drawing states e = 0.87 BASIC and f = 0.50 BASIC on the same
// figure as the body extent and the 4926-contact identity, so the hexagonal pitch pair is a
// property of the part. It was previously authored only in the platform-specification module, and
// a fact's ABSENCE from its subject's authority is not what makes it belong somewhere else.
data altra_package_pad_pitch_dx: std.measure.Micrometer = micrometer(count: 870)

data altra_package_pad_pitch_dy: std.measure.Micrometer = micrometer(count: 500)

data altra_package_body_designator: std.types.NonEmptyStr = "FCLGA4926"

data altra_ddr4_channel_count: Int = 8

data altra_max_dimms_per_socket: Int = 16

data altra_pcie_gen4_lane_count: Int = 128

// A single land on the package, identified by the designator its vendor authority assigns.
// The electrical function is deliberately NOT a Bool-ish "is power" axis: signal reference,
// power return, chassis bond and protective earth are distinct roles that a board must not
// fuse, and a contact whose function the authority does not state is FunctionUnstated rather
// than defaulted to anything.
type ContactElectricalFunction
  = PowerSupplyContact
  | PowerReturnContact
  | SignalReferenceContact
  | SingleEndedSignalContact
  | DifferentialPairMemberContact { pair: std.types.NonEmptyStr }
  | IncompleteDifferentialPolarityContact { pair: std.types.NonEmptyStr }
  | NoConnectContact
  | ReservedContact
  | FunctionUnstated

type PackageContact {
  designator: std.types.NonEmptyStr
  function: ContactElectricalFunction
}

// One Table 4 row before classification: the datasheet names a land and its default signal.
type Table4PinRow {
  designator: std.types.NonEmptyStr
  signal_name: std.types.NonEmptyStr
}

data power_supply_signal_prefixes: List<std.types.NonEmptyStr> = [
  "VDD",
  "VCC",
  "VPP",
  "VREF",
  "VTT",
  "VREG",
  "PVDD",
  "AVDD",
  "DVDD",
]

fn signal_has_power_supply_prefix(signal: std.types.NonEmptyStr) -> Bool {
  fold(power_supply_signal_prefixes, init: false, f: fn(acc, prefix) {
    acc || starts_with(s: signal as String, prefix: prefix as String)
  })
}

fn signal_is_reserved_name(signal: std.types.NonEmptyStr) -> Bool {
  starts_with(s: signal as String, prefix: "RESERVED")
    || starts_with(s: signal as String, prefix: "RFU")
}

fn signal_is_power_return_name(signal: std.types.NonEmptyStr) -> Bool {
  (signal as String) == "VSS"
    || (signal as String) == "GND"
    || starts_with(s: signal as String, prefix: "VSS_")
}

fn signal_is_reference_name(signal: std.types.NonEmptyStr) -> Bool {
  (signal as String) == "AGND" || (signal as String) == "DGND"
}

fn signal_has_positive_polarity_suffix(signal: std.types.NonEmptyStr) -> Bool {
  ends_with(s: signal as String, suffix: "_P")
}

fn signal_has_negative_polarity_suffix(signal: std.types.NonEmptyStr) -> Bool {
  ends_with(s: signal as String, suffix: "_N")
    || ends_with(s: signal as String, suffix: "_M")
}

fn differential_pair_base_name(signal: std.types.NonEmptyStr) -> std.types.NonEmptyStr? {
  if signal_has_positive_polarity_suffix(signal: signal) || signal_has_negative_polarity_suffix(signal: signal) {
    let len = (signal as String).length()
    if len > 2 {
      Present {
        value: substring(
          s: signal as String,
          start: 0,
          end: len - 2,
        ) as std.types.NonEmptyStr,
      }
    } else {
      none
    }
  } else {
    none
  }
}

type DifferentialPolarityScan {
  has_positive: Bool
  has_negative: Bool
}

fn scan_table4_differential_polarities(rows: List<Table4PinRow>) -> Map<std.types.NonEmptyStr, DifferentialPolarityScan> {
  fold(rows, init: empty_map(), f: fn(acc, row) {
    match differential_pair_base_name(signal: row.signal_name) {
      Absent => acc
      Present { value: base } => {
        let prior = match map_get(acc, base) {
          Present { value: scan } => scan
          Absent => DifferentialPolarityScan { has_positive: false, has_negative: false }
        }
        let updated = if signal_has_positive_polarity_suffix(signal: row.signal_name) {
          DifferentialPolarityScan { has_positive: true, has_negative: prior.has_negative }
        } else {
          DifferentialPolarityScan { has_positive: prior.has_positive, has_negative: true }
        }
        map_insert(acc, base, updated)
      }
    }
  })
}

fn differential_pair_is_complete(scan: DifferentialPolarityScan) -> Bool {
  scan.has_positive && scan.has_negative
}

// Active-low and other single-ended _N/_M names (WE_N, RAS_N, …) with no _P mate route to
// SingleEndedSignalContact when scan.has_negative && !scan.has_positive.
fn classify_table4_signal(
  signal: std.types.NonEmptyStr,
  polarities: Map<std.types.NonEmptyStr, DifferentialPolarityScan>
) -> ContactElectricalFunction {
  if signal_is_reserved_name(signal: signal) {
    ReservedContact
  } else if (signal as String) == "NC" {
    NoConnectContact
  } else if signal_is_power_return_name(signal: signal) {
    PowerReturnContact
  } else if signal_is_reference_name(signal: signal) {
    SignalReferenceContact
  } else if signal_has_power_supply_prefix(signal: signal) {
    PowerSupplyContact
  } else {
    match differential_pair_base_name(signal: signal) {
      Absent => SingleEndedSignalContact
      Present { value: base } => match map_get(polarities, base) {
        Present { value: scan } =>
          if differential_pair_is_complete(scan: scan) {
            DifferentialPairMemberContact { pair: base }
          } else if scan.has_negative && !scan.has_positive {
            SingleEndedSignalContact
          } else {
            IncompleteDifferentialPolarityContact { pair: base }
          }
        Absent => IncompleteDifferentialPolarityContact { pair: base }
      }
    }
  }
}

fn table4_row_to_contact(
  row: Table4PinRow,
  polarities: Map<std.types.NonEmptyStr, DifferentialPolarityScan>
) -> PackageContact {
  PackageContact {
    designator: row.designator,
    function: classify_table4_signal(signal: row.signal_name, polarities: polarities),
  }
}

fn contacts_from_table4(rows: List<Table4PinRow>) -> List<PackageContact> {
  let polarities = scan_table4_differential_polarities(rows: rows)
  rows |> map(row => table4_row_to_contact(row: row, polarities: polarities))
}

type PackageContactMap {
  socket: extdeps.cpu.types.CpuSocket
  contacts: List<PackageContact>
  authority: extdeps.external_authority.ExternalAuthority
}

// The three refusal causes are kept apart because their OWNERS differ. Collateral absence is a
// business prerequisite (someone must obtain access and resolve where the bytes may live); an
// incomplete population is our own unfinished ingestion; a duplicate designator is a defect in
// the map we were given or in how we read it. A single "map not ready" cause would route all
// three to the same reader and make the Altra blocker indistinguishable from a typo.
type PackageContactMapStanding
  = PackageContactMapAdmitted { resolved: Int }
  | ContactMapPubliclyAvailableNotIngested { document: std.types.NonEmptyStr, authority: extdeps.external_authority.ExternalAuthority }
  | ContactPopulationIncomplete { expected: Int, resolved: Int }
  | DuplicateContactDesignator { designator: std.types.NonEmptyStr }
  | IncompleteDifferentialPolarity { pair: std.types.NonEmptyStr }

fn contact_designators(map: PackageContactMap) -> List<std.types.NonEmptyStr> {
  map.contacts |> map(c => c.designator)
}

fn contact_count(map: PackageContactMap) -> Int {
  fold(map.contacts, init: 0, f: (acc, _) => acc + 1)
}

fn classified_signal_pin_count(contacts: List<PackageContact>) -> Int {
  fold(contacts, init: 0, f: fn(acc, c) {
    match c.function {
      SingleEndedSignalContact => acc + 1
      DifferentialPairMemberContact { pair: _ } => acc + 1
      _ => acc
    }
  })
}

fn classified_power_and_ground_pin_count(contacts: List<PackageContact>) -> Int {
  fold(contacts, init: 0, f: fn(acc, c) {
    match c.function {
      PowerSupplyContact => acc + 1
      PowerReturnContact => acc + 1
      SignalReferenceContact => acc + 1
      _ => acc
    }
  })
}

fn classified_reserved_pin_count(contacts: List<PackageContact>) -> Int {
  fold(contacts, init: 0, f: fn(acc, c) {
    match c.function {
      ReservedContact => acc + 1
      _ => acc
    }
  })
}

// A differential pair is COMPLETE when its pair name names exactly two member contacts in the
// map — one for each polarity the datasheet assigns. Members are classified as differential
// only when BOTH polarities exist under the same base name. Active-low _N names with no _P mate
// (WE_N, RAS_N, …) stay single-ended; PCIe lanes use _M as the negative leg beside _P.
type DifferentialPairPopulationScan {
  counts: Map<std.types.NonEmptyStr, Int>
}

fn scan_differential_pair_population(contacts: List<PackageContact>) -> DifferentialPairPopulationScan {
  fold(contacts, init: DifferentialPairPopulationScan { counts: empty_map() }, f: fn(acc, c) {
    match c.function {
      DifferentialPairMemberContact { pair: p } => {
        let prior = match map_get(acc.counts, p) {
          Present { value: n } => n
          Absent => 0
        }
        DifferentialPairPopulationScan {
          counts: map_insert(acc.counts, p, prior + 1),
        }
      }
      _ => acc
    }
  })
}

type DifferentialPairStanding
  = AllDifferentialPairsComplete
  | IncompleteDifferentialPair { pair: std.types.NonEmptyStr, member_count: Int }

fn first_incomplete_polarity_pair(contacts: List<PackageContact>) -> std.types.NonEmptyStr? {
  fold(contacts, init: none, f: fn(acc, c) {
    match acc {
      Present { value: _ } => acc
      Absent => match c.function {
        IncompleteDifferentialPolarityContact { pair: p } => Present { value: p }
        _ => none
      }
    }
  })
}

fn differential_pair_standing(contacts: List<PackageContact>) -> DifferentialPairStanding {
  match first_incomplete_polarity_pair(contacts: contacts) {
    Present { value: pair } => IncompleteDifferentialPair { pair: pair, member_count: 1 }
    Absent => {
      let scan = scan_differential_pair_population(contacts: contacts)
      fold(contacts, init: AllDifferentialPairsComplete, f: fn(acc, c) {
        match acc {
          IncompleteDifferentialPair { pair: _, member_count: _ } => acc
          AllDifferentialPairsComplete => match c.function {
            DifferentialPairMemberContact { pair: p } => {
              let members = match map_get(scan.counts, p) {
                Present { value: n } => n
                Absent => 0
              }
              if members == 2 {
                AllDifferentialPairsComplete
              } else {
                IncompleteDifferentialPair { pair: p, member_count: members }
              }
            }
            _ => AllDifferentialPairsComplete
          }
        }
      })
    }
  }
}

// TWO LINEAR PASSES, NOT A QUADRATIC ONE. An earlier revision re-counted the whole designator
// list once per element, which is 4926 x 4926 comparisons at the real package population — and
// DESIGN §6's bare-minimum-cost rule is explicit that a proven quadratic fold is fixed whatever
// the realized n, because "n is small here" is not a time-stable fact and this list is sized by
// a vendor's package, not by us.
//
// The maps carry membership ONLY and are never iterated, which is the pattern DESIGN's
// determinism thread sanctions: traversal order of a Map is host-unspecified, so the ORDER this
// answer depends on comes from the designator list itself in the second pass. That is what
// preserves the exact prior semantics — the first designator in SOURCE order whose value occurs
// more than once, not the position where a repeat happens to be noticed.
type DesignatorScan {
  seen: Map<std.types.NonEmptyStr, Bool>
  duplicated: Map<std.types.NonEmptyStr, Bool>
}

fn scan_designators(designators: List<std.types.NonEmptyStr>) -> DesignatorScan {
  fold(designators, init: DesignatorScan { seen: empty_map(), duplicated: empty_map() }, f: fn(acc, d) {
    if map_contains_key(acc.seen, d) {
      DesignatorScan { seen: acc.seen, duplicated: map_insert(acc.duplicated, d, true) }
    } else {
      DesignatorScan { seen: map_insert(acc.seen, d, true), duplicated: acc.duplicated }
    }
  })
}

fn first_duplicate_designator(designators: List<std.types.NonEmptyStr>) -> std.types.NonEmptyStr? {
  let scan = scan_designators(designators: designators)
  fold(designators, init: none, f: fn(acc, d) {
    match acc {
      Present { value: found } => Present { value: found }
      Absent => if map_contains_key(scan.duplicated, d) { Present { value: d } } else { none }
    }
  })
}

// The admission is a COUNT-AND-IDENTITY JOIN against the declared package population, not a
// presence check on a field. That distinction is the whole point: a stub map naming itself
// "the Altra contact map" cannot pass, because 4926 unique designators is a quantity no
// placeholder carries. HONESTY ABOUT THE RUNG THIS REACHES (DESIGN §4b rung honesty): the
// completeness and uniqueness halves are mechanically preventable — they refuse by execution
// on the acceptance path. The PROVENANCE half is not: a caller who genuinely had 4926 unique
// invented designators would admit, because nothing here can distinguish an authored list
// from a vendor-supplied one. Closing that requires the observation to be independent of the
// party asserting it, which is the same unforgeable-construction frontier DESIGN names, and
// it is stated rather than papered over.
fn admit_package_contact_map(map: PackageContactMap, expected: Int) -> PackageContactMapStanding {
  match first_incomplete_polarity_pair(contacts: map.contacts) {
    Present { value: pair } => IncompleteDifferentialPolarity { pair: pair }
    Absent => match first_duplicate_designator(designators: contact_designators(map: map)) {
      Present { value: dup } => DuplicateContactDesignator { designator: dup }
      Absent => {
        let resolved = contact_count(map: map)
        if resolved == expected {
          PackageContactMapAdmitted { resolved: resolved }
        } else {
          ContactPopulationIncomplete { expected: expected, resolved: resolved }
        }
      }
    }
  }
}

// THE NDA-BOUND SUBJECT GETS ITS OWN TYPE, not a variant of the package standing. An earlier
// revision returned MissingUpstreamDesignCollateral AS a PackageContactMapStanding, so the
// absence of a reference BOARD package rendered as a statement about the package contact map —
// the same fusion this lane corrected at the prose level and then re-committed at the type
// level one function down. Reference-board collateral is a different subject with a different
// owner, and now it cannot be mistaken for a package fact because it cannot inhabit that type.
type ReferenceBoardCollateralStanding
  = ReferenceBoardCollateralAvailable
  | ReferenceBoardCollateralUnderNda { subject: std.types.NonEmptyStr, access_route: extdeps.external_authority.ExternalAuthority }

fn altra_reference_board_collateral_standing() -> ReferenceBoardCollateralStanding {
  ReferenceBoardCollateralUnderNda {
    subject: "Ampere reference motherboard design packages (Mt. Jade, Mt. Collins, Mt. Bonnell, Mt. Snow) with UEFI, OpenBMC and CPLD source",
    access_route: ampere_customer_reference_boards_authority,
  }
}

data ampere_altra_package_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.cpu.ampere_altra_package",
      decl_name: "altra_fclga_socket",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [ampere_altra_rev_a1_datasheet_authority, ampere_customer_reference_boards_authority]
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = ampere_altra_package_model_scope
