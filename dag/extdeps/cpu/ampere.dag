data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Ampere_Altra"
  }
}

data ampere_altra_rev_a1_datasheet_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "amperecomputing.com/assets/Altra_Max_Rev_A1_DS_v1_15_20230809_b7cdce449e_424d129849.pdf"
  }
}

data ampere_altra_l1_data_capacity_per_core: ByteSize = byte_size(65536)
data ampere_altra_l1_instruction_capacity_per_core: ByteSize = byte_size(65536)
data ampere_altra_l1_line_size: ByteSize = byte_size(64)

data ampere_altra_l1_cache_geometry: CpuL1CacheGeometry = CpuL1CacheGeometry {
  data_capacity_per_core: ampere_altra_l1_data_capacity_per_core,
  instruction_capacity_per_core: ampere_altra_l1_instruction_capacity_per_core,
  line_size: ampere_altra_l1_line_size,
}

data ampere_altra_l1_cache_citations: List<CpuCacheGeometryCitation> = [
  {
    field: "data_capacity_per_core"
    authority: ampere_altra_rev_a1_datasheet_authority
  },
  {
    field: "instruction_capacity_per_core"
