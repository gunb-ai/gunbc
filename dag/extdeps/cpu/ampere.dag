  socket: ampere_lga4926_socket,
  tdp_watts: watt(161),
  l1_cache: ampere_altra_l1_cache_geometry,
  l1_cache_citations: ampere_altra_l1_cache_citations,
  l2_cache: ampere_altra_l2_cache_geometry,
  l2_cache_citations: ampere_altra_l2_cache_citations,
  l3_cache: ampere_altra_classic_l3_cache_geometry,
  l3_cache_citations: ampere_altra_classic_l3_cache_citations,
}

// THE MODULE'S OWN ROSTER OF CATALOG ROWS, for the same reason as the AMD side: one authority for
// "every Ampere processor modelled here", edited beside the rows it names.
data ampere_cpu_catalog_rows: List<CpuModelCatalogRow> = [
  altra_max_m12830_catalog,
  altra_q6430_catalog,
  altra_q8030_catalog,
]

// THE AMPERE ALTRA SOC FAMILY: the Q-series Altra line. Each model's upstream-attested
// architecture already lives in its catalog row; the family groups the models a board may admit.
// Grouping is an upstream grouping fact, not an inference: it cites the same models the per-model
// catalog rows cite, and the family's architecture is DERIVED from them (soc_family_architecture),
// never asserted separately.
data ampere_altra_soc_family: SoCFamily = SoCFamily {
  name: "Altra",
  models: FreeSemigroup { head: altra_q6430_catalog, tail: [altra_q8030_catalog] },
}

// THE AMPERE ALTRA MAX SOC FAMILY: the M-series Altra Max line. A dual-socket Altra/Altra Max board
// (Mt. Collins) admits BOTH families; whether such a board establishes one firmware architecture is
// then derived from whether both families agree, never defaulted.
data ampere_altra_max_soc_family: SoCFamily = SoCFamily {
  name: "Altra Max",
  models: FreeSemigroup { head: altra_max_m12830_catalog, tail: [] },
}

// WHICH SoC FAMILIES CARRY SMpro. SMpro is the Ampere Altra-family SoC's own out-of-band register
// interface, and the family set that carries it is a NAMED UPSTREAM SET, not an inference: the SSIF
// patch readme "names Altra and Altra Max" (extdeps.ampere.altra_ssif_patch.altra_ssif_v6_purpose,
// whose subject is those two processors), and the register documentation behind the SMpro sysfs ABI is
// "Ampere's Altra Family SoC BMC Interface Specification" (extdeps.ampere.smpro_register). Listing the
// families here is that cited set in the corpus's own SoCFamily terms.
//
// Membership is tested by FAMILY IDENTITY, not by name and never by the instruction-set architecture.
// A family is its cited model rows (extdeps.cpu.types.soc_family_eq), so a row that merely spells its
// name "Altra" while grouping different models does NOT carry SMpro — the earlier name comparison let it
// (review 81149, finding 3). And aarch64 does not imply SMpro: an AWS Graviton or an NVIDIA Grace is
// aarch64 silicon with no SMpro interface at all, so keying on the architecture would assert a facility
// these machines do not have.
// ONE FAMILY THE UPSTREAM SET NAMES, WITH THE CITATION THAT NAMES IT, in one row. The citation cannot
// sit beside the set as a separate list: a row no fold reads is dangling, and a reader who takes
// ampere_smpro_carrying_soc_families without its companion gets an uncited claim about silicon. Carrying
// the citation inside the row is the corpus's own shape for exactly this — CpuModelCatalogRow keeps
// l1_cache_citations next to the facts they ground.
type SmproCarryingSocFamily {
  family: SoCFamily
  citations: List<FactCitation>
}

data ampere_smpro_carrying_soc_families: List<SmproCarryingSocFamily> = [
  SmproCarryingSocFamily {
    family: ampere_altra_soc_family,
    citations: [
      FactCitation {
        fact: decl_ref(module_path: "extdeps.ampere.altra_ssif_patch", decl_name: "altra_ssif_v6_purpose"),
        authority: altra_ssif_patch_authority,
      },
    ],
  },
  SmproCarryingSocFamily {
    family: ampere_altra_max_soc_family,
    citations: [
      FactCitation {
        fact: decl_ref(module_path: "extdeps.ampere.altra_ssif_patch", decl_name: "altra_ssif_v6_purpose"),
        authority: altra_ssif_patch_authority,
      },
    ],
  },
]

// WHETHER AN SoC FAMILY CARRIES SMpro, read off the cited family set above. True only for a family the
// upstream names; every other family — any family the set does not name — is False, which the consumer
// reads as a NAMED family that does not carry the facility. "We do not know the family" is a different
// answer and is not expressible here: the caller passes a family it has, or none
// (gunbc.host.smpro_platform_capability.smpro_facility).
fn ampere_soc_family_carries_smpro(family: SoCFamily) -> Bool {
  // THE CANONICAL MEMBERSHIP PREDICATE, not a hand-built one. This used to be
  // `|> filter(...) |> first() { Present => true / Absent => false }`: a Bool helper that reconstructs an
  // Optional and answers one variant true and the other false, which is the predicate/walker dissolution
  // the review policy names -- the same fact as `row.capabilities |> any(c => c == cap)` two modules over
  // (extdeps.bmc.capability), and DESIGN §2's "must not grow by re-invention" applies to walkers as much
  // as to types. Membership is `any` over an identity test; there is nothing else it could mean.
  ampere_smpro_carrying_soc_families |> any(c => soc_family_eq(a: c.family, b: family))
}

// Processor Mass Specification, section 4, p.17 of Altra Max Rev A1 issues
// 1.15/1.25/1.30. Typical package mass, not a guaranteed tolerance interval.
// The non-Max Altra's 112 g must not be substituted for this installed family.
data ampere_altra_max_typical_package_mass: Gram = gram(count:114)
data ampere_altra_max_package_mass_citation: FactCitation = FactCitation {
  authority: ampere_altra_max_rev_a1_datasheet_authority,
  fact: decl_ref(module_path:"extdeps.cpu.ampere",decl_name:"ampere_altra_max_typical_package_mass"),
}
