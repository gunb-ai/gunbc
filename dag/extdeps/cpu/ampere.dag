// THE IDENTITY TEST IS IMPORTED, NOT RELIED ON BY NAME. ampere_soc_family_carries_smpro calls it, and a
// name that resolves only because nothing else in scope shadows it is not a resolved name. Review 81471
// caught that this import list was written BEFORE the membership test was rewritten to use any(...) over
// soc_family_eq, so the call was added and the import never was -- and the function's one consumer
// (gunbc.host.smpro_platform_capability) sits outside the required emitted-subject rows, which is exactly
// the CI blind spot DESIGN Sec 3 names: "a dependent can stop resolving while the required job reports
// SUCCESS". The comment sits ABOVE the block, not inside it: no file in this corpus carries a comment
// inside an import block, so it is not a position the parser is known to accept.
import extdeps.cpu.types {
  ProcessorCoolingMount,
  SocketedLandGrid, CpuL1CacheGeometry, CpuL2CacheGeometry, CpuL3CacheGeometry, CpuModelCatalogRow, CpuSocket, LandGridArray, ProcessorThermalLimits, SoCFamily,
  soc_family_eq,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Ampere_Altra"
  }
}

// THE UNQUALIFIED NAME USED TO DENOTE THE QUALIFIED PRODUCT, WHICH IS A MEANING FORK. This was
// named ampere_altra_rev_a1_datasheet_authority while its locator is the Altra MAX datasheet, and
// its sibling below carries the explicit `classic` qualifier for the non-Max part. So the bare
// family name denoted the narrower product and the qualified-sounding name denoted the broader
// one -- one spelling suggesting a meaning it does not carry, which 3 forbids independently of
// whether any fact was misattributed.
//
// NO FACT MOVED, AND THE DISCRIMINATING PAIR IS WHY THAT IS CHECKABLE RATHER THAN ASSERTED. Altra
// and Altra Max differ in last-level cache, so the two L3 rows below are a natural discriminator:
// ampere_altra_max_l3_capacity is 16 MiB and cites this authority, ampere_altra_classic_l3_capacity
// is 32 MiB and cites the classic one. Both were already correct, so this rename is a pure
// spelling change over 30 references and changes no citation, no value and no authority.
data ampere_altra_max_rev_a1_datasheet_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "amperecomputing.com/assets/Altra_Max_Rev_A1_DS_v1_15_20230809_b7cdce449e_424d129849.pdf"
  }
}

data ampere_altra_classic_rev_a1_datasheet_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "amperecomputing.com/assets/Altra_Rev_A1_DS_v1_50_20240130_3375c3dec5_1c5d4604fa.pdf"
  }
}

// AMPERE SERVES ITS DATASHEETS FROM MORE THAN ONE SURFACE, AND THEY DISAGREE. This block was first
// written on 2026-09-02 from the family product brief alone, which links Altra v1.50 and Altra Max
// v1.25, and it concluded that v1.50 was current. That conclusion was WRONG, and the error is worth
// naming because the measurement itself was sound: the brief was fetched, its links read, and each
// PDF confirmed to resolve. What failed was reading ONE publication surface as the publisher's
// current serving state. The brief is a stale index. Ampere's customer-connect device-documentation
// surface serves newer revisions of both documents.
//
// SO THE INDEX IS PART OF THE FACT, NOT A CONVENIENCE. A supersession standing is relative to what
// the publisher serves NOW, so naming which surface was consulted is what makes the standing
// falsifiable; collapsing two disagreeing pages into "the Ampere page" would conceal exactly the
// stale-index condition this vocabulary exists to expose.
//
// AND THE SURFACE NAMED MUST BE ONE THAT SERVES THE ROSTER. An earlier revision named
// products/altra#device-documentation, which was measured on 2026-09-02 to redirect to
// amperecomputing.com/auth/login and serve no document roster anonymously at all. A field whose
// entire purpose is to name the page actually read is defeated by naming a login redirect. The
// dedicated family surface below resolves directly, 152047 bytes, no redirect.
data ampere_altra_device_documentation_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "amperecomputing.com/customer-connect/products/altra-family-device-documentation"
  }
}

// THE NON-MAX ALTRA CITATION IS SUPERSEDED BY ISSUE 1.55, VERIFIED BY RETRIEVAL. The locator below
// was fetched on 2026-09-02: HTTP 200, 6630790 bytes, a valid PDF whose own content stream carries
// the string "Issue 1.55". This row exists because an earlier revision of this block recorded the
// OPPOSITE -- HeldRevisionIsCurrentPublicCopy -- on the strength of 1.55 being absent from the
// product brief. Absence from one index is not absence from the publisher.
//
// The standard that produced the wrong answer is nevertheless the right standard, and it is kept:
// a supersession is recorded only for a revision actually retrieved, never for one merely listed.
// 1.55 now meets it. Retiring this standing means ingesting 1.55 and re-deriving the rows that
// cite the datasheet -- section 2.10's active-channel facts are reported unchanged there, but
// "reported unchanged" is not a reading, and no row here is restated from it.
data ampere_altra_classic_rev_a1_v1_55_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "connect-admin.amperecomputing.com/api/secure-file-download/download-regular/?documentId=h51y6okvdig3i4u3lst6n120&file=Altra_Rev_A1_DS_v1_55_20250408_e814f50701.pdf&type=technical-document"
  }
}

data ampere_altra_classic_rev_a1_datasheet_supersession_standing: HeldSpecificationSupersessionStanding = NewerRevisionPubliclyServed {
  newer_version_label: "v1.55",
  newer_authority: ampere_altra_classic_rev_a1_v1_55_authority,
  index_authority: ampere_altra_device_documentation_authority,
  held_version_label: "v1.50",
  detail: "retrieved 2026-09-02: HTTP 200, 6630790 bytes, PDF self-identifying as Issue 1.55 dated 2025-04-08, while the cited locator pins v1.50 dated 2024-01-30; the family product brief still links v1.50 and is a stale index",
}

// THE ALTRA MAX CITATION IS SUPERSEDED BY v1.30, VERIFIED BY RETRIEVAL. An earlier revision of
// this block recorded the debt as "AT LEAST v1.25", because v1.30 was reported on the
// device-documentation surface but no locator for it had been retrieved, and citing a document
// nobody has held is the precise error the non-Max row above corrects in the other direction.
// That reasoning was right and the conclusion is now simply superseded by evidence: the v1.30
// locator was supplied, fetched on 2026-09-02, and measured at HTTP 200, 6613878 bytes, a valid
// PDF of 89 pages whose decompressed content streams carry "1.30" 94 times against "1.25" four.
// v1.25 remains a true historical observation; it is no longer the furthest revision held.
data ampere_altra_max_rev_a1_v1_30_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "connect-admin.amperecomputing.com/api/secure-file-download/download-regular/?documentId=z7tgvww8kuqd9ofrrwq381df&file=Altra_Max_Rev_A1_DS_v1_30_20250408_99487b8f45.pdf&type=technical-document"
  }
}

data ampere_altra_max_rev_a1_datasheet_supersession_standing: HeldSpecificationSupersessionStanding = NewerRevisionPubliclyServed {
  newer_version_label: "v1.30",
  newer_authority: ampere_altra_max_rev_a1_v1_30_authority,
  index_authority: ampere_altra_device_documentation_authority,
  held_version_label: "v1.15",
  detail: "retrieved 2026-09-02: Altra Max Rev A1 DS v1.30 dated 2025-04-08 resolves HTTP 200 at 6613878 bytes over 89 pages while the cited locator pins v1.15 dated 2023-08-09; v1.25 was also retrieved and is superseded in turn, so this debt is retired only by ingesting v1.30",
}

data ampere_altra_max_m12830_thermal_limits: ProcessorThermalLimits = ProcessorThermalLimits {
  maximum_continuous_junction_temperature: celsius(100),
  thermal_throttle_temperature: celsius(105),
  thermal_shutdown_temperature: celsius(120),
  authority: ampere_altra_max_rev_a1_datasheet_authority,
}

// Ampere Altra Max Rev A1 datasheet issue 1.25, table 14: M128-30 maximum continuous junction temperature TCJ=100C, SoC thermal throttling TM1=105C, and thermal shutdown TM2=120C. These are processor facts. A fleet fan policy may derive its emergency ramp from them, but must not rewrite them as operator preference.
// THERMAL LIMITS BY CATALOG ROW. Only the row the datasheet table above names has limits; every other
// Altra row (the Q80-30 mtcollins1 carries included) is Absent, a datasheet read obligation, so a
// consumer fails closed instead of borrowing the M128-30 figures. The key is the catalog row's vendor
// AND model number (a model number alone is only unique within one vendor), which a host's CpuFacts
// carries; it is not a free string.
fn ampere_altra_thermal_limits_for_catalog(row: CpuModelCatalogRow) -> ProcessorThermalLimits? {
  if row.vendor == altra_max_m12830_catalog.vendor
    && (row.model_number as String) == (altra_max_m12830_catalog.model_number as String) {
    Present { value: ampere_altra_max_m12830_thermal_limits }
  } else {
    Absent
  }
}

