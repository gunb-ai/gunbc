module extdeps.cpu.ampere_altra_package_contact_map


data extdeps_external_authority_anchor: ExternalAuthority = ampere_altra_rev_a1_datasheet_authority

data extdeps_model_scope: ExternalModelScope = ampere_altra_package_model_scope

fn altra_package_contact_map() -> PackageContactMap {
  PackageContactMap {
    socket: altra_fclga_socket,
    contacts: altra_package_contacts(),
    authority: ampere_altra_rev_a1_datasheet_authority,
  }
}

fn altra_contact_map_standing() -> PackageContactMapStanding {
  admit_package_contact_map(
    map: altra_package_contact_map(),
    expected: altra_declared_contact_count()
  )
}
