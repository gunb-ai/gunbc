module extdeps.cpu.ampere_altra_platform_hw_design.subject

import std.types { String, NonEmptyStr }
import std.integer { Int }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import extdeps.vendor.ampere { ampere_vendor }

// THE PLATFORM DESIGN SPECIFICATION IS A DIFFERENT DOCUMENT CLASS FROM THE PACKAGE DATASHEET
// AND FROM OCP REFERENCE-BOARD COLLATERAL. It is the guide for designing a custom motherboard
// around Altra — socket land pattern, keepout, DDR4 routing rules, impedance targets and stackup
// guidance — and is publicly reachable on Ampere's CDN without login.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "d1o0i0v5q5lp8h.cloudfront.net/ampere/live/assets/processor_families/design_specifications/Altra_Platform_HW_Design_Specification_v1.00_20210120.pdf",
  }
}

data ampere_technical_document_index_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "amperecomputing.com/products/processors/altra",
  }
}

data altra_platform_hw_design_subject_note: String = "THE HIGHEST-VALUE PUBLIC DOCUMENT THIS MOTHERBOARD LANE HAS FOUND. extdeps.cpu.ampere_altra_package carries the processor package pinout; extdeps.ocp.mt_jade carries one OCP reference-board specification; this module is the third axis — the vendor's platform hardware design guide for boards built around Altra rather than around a named reference platform. THE ANCHOR CITES THE PUBLIC CDN v1.00 COPY; AMPERE'S TECHNICAL-DOCUMENT INDEX LISTS A NEWER v1.20 REVISION DATED 2025-07-15 THAT THIS REPOSITORY HAS NOT RETRIEVED. PLATFORM FACTS LIVE IN extdeps.cpu.ampere_altra_platform_hw_design.platform, INGESTED FROM THE v1.00 PDF BY A PEER SESSION — NOT BY THIS MODULE FETCHING THE LOCATOR."

type AltraPlatformHwDesignRev1_00
type AltraPlatformHwDesignRevision = AltraPlatformHwDesignRev1_00

type SpecificationDocumentDate {
  year: Int
  month: Int
  day: Int
}

type SpecificationCitationReadProvenance
  = DocumentLocatorFetchRefused { http_status: Int, detail: NonEmptyStr }
  | DocumentLocatorFetchedButTextUnread { http_status: Int, detail: NonEmptyStr }
  | PeerSessionPdfTextIngested { peer_session: NonEmptyStr, detail: NonEmptyStr }
  | OperatorSuppliedDocumentText

type HeldSpecificationSupersessionStanding
  = HeldRevisionIsCurrentPublicCopy
  | NewerRevisionExistsUnretrieved {
      newer_version_label: NonEmptyStr,
      newer_publication_date: SpecificationDocumentDate,
      index_authority: ExternalAuthority,
      held_version_label: NonEmptyStr,
      detail: NonEmptyStr,
    }

data altra_platform_hw_design_title: NonEmptyStr = "Ampere Altra Platform Hardware Design Specification"

data altra_platform_hw_design_version_label: NonEmptyStr = "v1.00"

data altra_platform_hw_design_publication_date: SpecificationDocumentDate = SpecificationDocumentDate {
  year: 2021,
  month: 1,
  day: 20,
}

data altra_platform_hw_design_citation_read_provenance: SpecificationCitationReadProvenance = PeerSessionPdfTextIngested {
  peer_session: "neat-hawk-428",
  detail: "full PDF text of the public CDN v1.00 locator was decoded by peer session neat-hawk-428 (zlib content-stream decompression with per-font ToUnicode CMap decoding); this subject module did not perform the fetch",
}

data altra_platform_hw_design_supersession_standing: HeldSpecificationSupersessionStanding = NewerRevisionExistsUnretrieved {
  newer_version_label: "v1.20",
  newer_publication_date: SpecificationDocumentDate {
    year: 2025,
    month: 7,
    day: 15,
  },
  index_authority: ampere_technical_document_index_authority,
  held_version_label: altra_platform_hw_design_version_label,
  detail: "Ampere technical-document index lists revision 1.20 dated 2025-07-15; the public CDN locator cited here still serves v1.00 dated 2021-01-20",
}

type AltraPlatformHwDesignSpecification {
  title: NonEmptyStr
  revision: AltraPlatformHwDesignRevision
  version_label: NonEmptyStr
  publication_date: SpecificationDocumentDate
  publisher: Vendor<Hardware>
  citation_read_provenance: SpecificationCitationReadProvenance
  supersession_standing: HeldSpecificationSupersessionStanding
}

data altra_platform_hw_design_specification: AltraPlatformHwDesignSpecification = AltraPlatformHwDesignSpecification {
  title: altra_platform_hw_design_title,
  revision: AltraPlatformHwDesignRev1_00,
  version_label: altra_platform_hw_design_version_label,
  publication_date: altra_platform_hw_design_publication_date,
  publisher: ampere_vendor,
  citation_read_provenance: altra_platform_hw_design_citation_read_provenance,
  supersession_standing: altra_platform_hw_design_supersession_standing,
}

data altra_platform_hw_design_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cpu.ampere_altra_platform_hw_design.subject",
