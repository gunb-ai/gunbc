module extdeps.cpu.ampere_altra_memory_controller


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = ampere_altra_classic_rev_a1_datasheet_authority

// THE MODEL SCOPE, naming what this module is the authority FOR. The subject is the admitted
// module classes rather than any single scalar, because that is the fact the rest of the module
// exists to qualify: the withdrawal, the board-down standing and the density ceiling are all
// statements about which memory this controller accepts.
data ampere_altra_memory_controller_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.cpu.ampere_altra_memory_controller",
      decl_name: "altra_admitted_module_classes",
      field: WholeDeclaration
    }
  },
  first_citation: ampere_altra_classic_rev_a1_datasheet_authority,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = ampere_altra_memory_controller_model_scope

// READ FROM THE PDF, NOT RECALLED. Every row below is transcribed from section 2.10 "Eight
// DDR4-3200 SDRAM Memory Controllers" of the Ampere Altra Rev A1 Processor Datasheet, Issue 1.50
// dated 2024-01-30, whose content streams were inflated and decoded on 2026-08-15. The feature
// list reads, verbatim modulo the PDF's letter spacing: eight 72-bit DDR4 channels featuring up
// to DDR4-3200; up to 2 DPC; up to 4 TB of memory; support for x4 and x8, and for 8 Gb and 16 Gb,
// DRAM devices; support for RDIMMs, LRDIMMs, and Stacked (3DS) RDIMMs; support for 1/2/4/6/8
// active channels (1 and 2 only for engineering debug / bring-up); hashed memory interleave
// across active channels.
//
// THIS IS ALTRA, NOT ALTRA MAX. They are separately versioned datasheets for separately governed
// products and their memory sections are not assumed to agree — the Max part has its own document
// and would need its own row set. That distinction is load-bearing here rather than pedantic: see
// the UDIMM withdrawal below, which is a fact about THIS document's revision history.
data altra_memory_controller_ingestion_note: String = "Section 2.10 only. Deliberately NOT carried: the DDR electrical specifications, the training sequence, the RAS feature list beyond its existence, and the signal tables — an ingestion-scope boundary, not a carriage refusal. The document is publicly reachable at the cited locator without a login, so gunbc.upstream_document_carriage permits its facts; the proprietary page footer is a recorded attribute that decides nothing. Also deliberately NOT carried: the maximum transfer rate the section states as DDR4-3200. It has no consumer here, and the corpus has no carrier for it — transfer rate is a bare Int named data_rate_mts at 30 references across 11 files, so authoring it would mint a 31st instance of a representation that is already forked rather than ground the fact. MT/s is not Hertz: DDR4-3200 transfers 3200 megatransfers per second on a 1600 MHz clock, so the existing Hertz carrier is the wrong grounding and a correct one is a std.measure dimension plus the migration of the whole existing population, at that grain and not this one."

data altra_memory_generation: extdeps.memory.types.DramGeneration = dram_generation_ddr4

data altra_memory_channel_width: std.measure.BitWidth = bit_width(count: 72)

// DPC IS CONSUMED AS THE CLOSED TOPOLOGY, not as a bare 2. The platform authority already models
// this as a coproduct rather than a count, which is the stronger shape: "up to 2 DPC" names an
// admitted set of arrangements, and an std.integer.Int lets a 3 be written that no authority admits.
data altra_memory_max_dimms_per_channel_topology: extdeps.cpu.ampere_altra_platform_hw_design.platform.DimmsPerChannelTopology = TwoDimmsPerChannel

// Four terabytes, as the datasheet states it for the whole processor rather than per channel.
data altra_memory_max_capacity: std.measure.ByteSize = byte_size(count: 4398046511104)

// DEVICE ORGANIZATION. Both admitted widths, as BitWidth rather than a bare std.integer.Int, because the
// datasheet's "x4 and x8" names the device's data width and the corpus already grounds widths on
// that carrier.
data altra_admitted_device_widths: List<std.measure.BitWidth> = [bit_width(count: 4), bit_width(count: 8)]

// DENSITY AS ByteSize, WHICH IS THE CORPUS CONVENTION FOR DRAM DIE DENSITY. The datasheet quotes
// "8 Gb and 16 Gb" -- gigaBITS -- and an earlier revision of this module made the gigabit figure
// primary as a List<std.integer.Int> with a derived byte value, on the reasoning that the source unit should
// lead. That was wrong for a reason worth recording: extdeps.memory.jedec already carries DRAM
// die density as ByteSize (JedecDdrGenerationCatalogRow max_monolithic_die_density), so a bare
// std.integer.Int gigabit row here was not carrying the source unit faithfully, it was forking the carrier an
// existing authority had already chosen for this exact quantity.
//
// The quoted unit is not lost by this. It is recorded below as the conversion basis, and the
// agreement between the two authorities is asserted by execution rather than by comment: see
// w_admitted_densities_respect_the_jedec_monolithic_ceiling.
data altra_device_density_conversion_basis: std.types.NonEmptyStr = "Datasheet quotes 8 Gb and 16 Gb (gigabits). JEDEC DRAM density convention: 1 Gb = 2^30 bits, so 8 Gb = 2^30 bytes and 16 Gb = 2^31 bytes. Carried as ByteSize to match extdeps.memory.jedec, which is the existing authority for DRAM die density."

data altra_admitted_device_densities: List<std.measure.ByteSize> = [
  byte_size(count: 1073741824),
  byte_size(count: 2147483648),
]

// THE ADMITTED MODULE CLASSES, AND THE ONE THAT WAS TAKEN AWAY. All three admitted classes carry
// a register or a buffer; none is unbuffered. That is the fact a board-down DRAM proposal must
// confront, so it is carried as data a consumer can fold rather than as a sentence.
data altra_admitted_module_classes: List<extdeps.memory.types.DramModuleClass> = [
  extdeps.memory.types.DramModuleClass { buffering: Registered, stacking: MonolithicDie },
  extdeps.memory.types.DramModuleClass { buffering: LoadReduced, stacking: MonolithicDie },
  extdeps.memory.types.DramModuleClass { buffering: Registered, stacking: ThreeDimensionalStacked },
]

fn altra_admits_module_class(c: extdeps.memory.types.DramModuleClass) -> Bool {
  any(altra_admitted_module_classes, k => dram_module_class_eq(a: k, b: c))
}

// A WITHDRAWAL IS NOT AN ABSENCE, and collapsing the two would lose the strongest signal this
// document carries. Issue 1.50's own revision history reads: "Deleted unbuffered DIMM (UDIMM)
// from Eight DDR4-3200 SDRAM Memory Controllers on page 10". So an earlier revision of THIS
// datasheet listed UDIMM among the admitted classes and Ampere removed it.
//
// The distinction decides what a designer may infer. An unmentioned class might simply be
// untested, and a test could establish it. A class the vendor listed and then struck is a
// position the vendor moved away from, and the honest reading of a withdrawal is that the
// capability was found not to hold or not to be supportable — not that nobody looked.
type ModuleClassWithdrawal {
  buffering: extdeps.memory.types.DimmBuffering
  withdrawn_in_issue: std.types.NonEmptyStr
  withdrawn_on: std.types.NonEmptyStr
  revision_history_text: std.types.NonEmptyStr
}

data altra_udimm_withdrawal: ModuleClassWithdrawal = ModuleClassWithdrawal {
  buffering: Unbuffered,
  withdrawn_in_issue: "1.50",
  withdrawn_on: "2024-01-30",
  revision_history_text: "Deleted unbuffered DIMM (UDIMM) from Eight DDR4-3200 SDRAM Memory Controllers on page 10",
}

// ACTIVE CHANNEL POPULATIONS, AS A CLOSED COPRODUCT. The datasheet lists 1/2/4/6/8 and then
// qualifies two of them: "(1 and 2 only for engineering debug / bring-up)".
//
// THIS TYPE WAS RE-HOMED HERE FROM product.altra_motherboard.minimal_design, where it was
// authored first. It is a cited vendor fact -- section 2.10's admitted populations and its
// parenthetical qualifier -- so its home is the authority that cites the datasheet, and the
// product layer consumes it. An earlier revision of this module authored a SECOND representation
// of the same contract as two std.integer.Int lists plus a three-state standing, which is the parallel
// authority §3 forbids: two rows free to drift on the next datasheet edit, each with its own
// witness and no join between them.
//
// The coproduct is kept and the std.integer.Int lists deleted rather than the reverse, because it is the
// stronger shape. Three, five and seven active channels are not slow configurations, they are
// unsupported ones -- and here they are UNREPRESENTABLE rather than classified. That is why the
// deleted standing needed a NotSupported arm at all: it existed only to carry a state this type
// cannot express, so consolidating removed the arm and the classifier together.
type ActiveDdrChannelCount
  = OneChannel
  | TwoChannels
  | FourChannels
  | SixChannels
  | EightChannels

fn active_channel_count(c: ActiveDdrChannelCount) -> std.integer.Int {
  match c {
    OneChannel => 1
    TwoChannels => 2
    FourChannels => 4
    SixChannels => 6
    EightChannels => 8
  }
}

// The vendor documents one- and two-channel operation as debug and bring-up. That is a property
// of the CONFIGURATION, carried so a consumer's refusal reads off a fact rather than repeating a
// threshold.
fn channel_count_is_production_qualified(c: ActiveDdrChannelCount) -> Bool {
  match c {
    OneChannel => false
    TwoChannels => false
    FourChannels => true
    SixChannels => true
    EightChannels => true
  }
}

// Stated because it constrains what a partial population MEANS. Interleave is hashed across the
// ACTIVE channels, so reducing the active count is not merely a capacity reduction — it changes
// the address distribution, and a board that populates fewer channels is a different memory
// system rather than a smaller one.
data altra_memory_interleave_note: String = "Section 2.10 states hashed memory interleave across active channels."

// The full-population data width, DERIVED from the channel facts rather than authored beside
// them, so a corrected channel count cannot leave a stale aggregate behind. It returns BitWidth
// rather than Int: both inputs carry the unit, and dropping it at the aggregate would make the
// one row a consumer actually reads the only one whose unit is implicit.
//
// CHANNEL COUNT IS CONSUMED HERE, NOT RE-MINTED. Eight DDR4 channels is a family fact already
// owned by the package authority, which grounds it on the Altra family product brief; section
// 2.10 states the same number for classic Altra, and a second literal in this module would be two
// rows free to drift with no join between them. The classic-vs-Max separation this module insists
// on is about facts the two documents state DIFFERENTLY -- the UDIMM withdrawal -- not about
// every number they happen to share.
fn altra_total_memory_data_width() -> std.measure.BitWidth {
  bit_width(count: altra_ddr4_channel_count * bit_width_count(b: altra_memory_channel_width))
}

// WHETHER THIS CONTROLLER ADMITS DRAM SOLDERED DIRECTLY TO THE BOARD, answered from the admitted
// classes rather than asserted — and answered PER TOPOLOGY, because "board-down" is not one
// arrangement. An earlier revision of this module reasoned that every admitted class carries a
// register or buffer while "a board-down topology has neither", and concluded the withdrawal
// answered for all soldered DRAM. That premise is false: nothing prevents a board from mounting
// the register or data buffer itself, and such a design presents the controller with the same
// buffered load a module would. The withdrawal is evidence about UNBUFFERED devices on the bus,
// so it answers only the topology that is actually unbuffered.
//
// The distinction is load-bearing rather than pedantic. Collapsing it makes the model report a
// buffered soldered design as refused on evidence that never examined it — foreclosing, by an
// over-broad reading of one revision-history line, exactly the arrangement a design might choose.
//
// The states are kept apart because they route differently. Unestablished invites someone to find
// a document. NotAdmitted says the authority was read and does not permit it. Withdrawn says the
// authority once permitted the nearest thing and stopped — the state Altra is in for the
// unbuffered case, and the one that should stop such a proposal rather than start a test campaign.
type BoardDownBuffering
  = BoardProvidesNoRegisterOrBuffer
  | BoardProvidesRegisterOrBuffer
type BoardDownDramStanding
  = BoardDownAdmitted { authority: extdeps.external_authority.ExternalAuthority }
  | BoardDownNotAdmittedByController { authority: extdeps.external_authority.ExternalAuthority, because: std.types.NonEmptyStr }
  | BoardDownNearestClassWithdrawn { authority: extdeps.external_authority.ExternalAuthority, withdrawal: ModuleClassWithdrawal }
  | BoardDownSupportUnestablished { required_authority: std.types.NonEmptyStr }

fn altra_board_down_dram_standing(topology: BoardDownBuffering) -> BoardDownDramStanding {
  match topology {
    BoardProvidesNoRegisterOrBuffer => BoardDownNearestClassWithdrawn {
      authority: ampere_altra_classic_rev_a1_datasheet_authority,
      withdrawal: altra_udimm_withdrawal,
    }
    BoardProvidesRegisterOrBuffer => BoardDownSupportUnestablished {
      required_authority: "An Ampere authority addressing DRAM soldered to the board behind a board-mounted register or data buffer. The UDIMM withdrawal does not answer this: it is evidence about unbuffered devices on the bus, and this topology is buffered. No document read so far admits or refuses it.",
    }
  }
}

// The residue this module does NOT close, stated so its silence is never read as permission.
// The datasheet settles which MODULE classes the controller admits. It does not describe a
// connector-less topology at all, in either direction, and firmware acceptance of a board-owned
// SPD source is a separate question this document does not reach. So the standing above is a
// controller-authority verdict, not a proof of electrical impossibility.
data altra_board_down_residue_note: String = "The datasheet admits module classes and never addresses direct-attach topology, so BoardDownNearestClassWithdrawn reports what the controller authority establishes and nothing more. What remains unestablished, and would need a different authority: whether Ampere firmware trains a channel whose SPD is board-provided rather than module-resident, and whether any Ampere reference design has ever done so. Neither is answered by absence here."
