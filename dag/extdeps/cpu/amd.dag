  },
]

data amd_zen2_l3_cache_geometry: extdeps.cpu.types.CpuL3CacheGeometry = extdeps.cpu.types.CpuL3CacheGeometry {
  capacity: std.measure.byte_size(33554432),
  line_size: std.measure.byte_size(64),
}

data amd_zen2_l3_cache_citations: List<extdeps.external_authority.FactCitation> = [
  extdeps.external_authority.FactCitation {
    fact: std.decl_ref.decl_field_ref(module_path: "extdeps.cpu.amd", decl_name: "amd_zen2_l3_cache_geometry", field_name: "capacity"),
    authority: amd_ryzen_5_3600_authority,
  },
]

// THE AM5 TERMINATION IS CITED, not asserted. Both Zen 4 rows previously read PinGridArray at the
// correct 1718 count; an uncited socket field is what let a wrong termination sit beside a right
// number without anything to check it against.
//
// THE SOCKET IS A PLATFORM FACT AND NOW HAS ONE HOME PER PLATFORM, the shape extdeps.cpu.ampere
// already uses for LGA4926. Each row previously minted its own CpuSocket literal, so the citation
// lists beside them could name no declaration at all -- which is how a citation ends up keyed by a
// field SPELLING ("package", a name CpuSocket has not carried since termination and attachment were
// split) instead of by the declaration the containment tree already names.
data amd_socket_am4: CpuSocket = CpuSocket {
  platform_owner: amd,
  termination: SocketedPinGrid,
  contact_count: 1331,
  cooling_mount: amd_am4_cooling_mount,
}

data amd_socket_am5: CpuSocket = CpuSocket {
  platform_owner: amd,
  termination: SocketedLandGrid,
  contact_count: 1718,
  cooling_mount: amd_am4_cooling_mount,
}

data socket_am4_citations: List<extdeps.external_authority.FactCitation> = [
  extdeps.external_authority.FactCitation {
    fact: std.decl_ref.decl_field_ref(module_path: "extdeps.cpu.amd", decl_name: "amd_socket_am4", field_name: "termination"),
    authority: amd_ryzen_5_3600_authority,
  },
  extdeps.external_authority.FactCitation {
    fact: std.decl_ref.decl_field_ref(module_path: "extdeps.cpu.amd", decl_name: "amd_socket_am4", field_name: "contact_count"),
    authority: amd_ryzen_5_3600_authority,
  },
]

data socket_am5_citations: List<extdeps.external_authority.FactCitation> = [
  extdeps.external_authority.FactCitation {
    fact: std.decl_ref.decl_field_ref(module_path: "extdeps.cpu.amd", decl_name: "amd_socket_am5", field_name: "termination"),
    authority: socket_am5_authority,
