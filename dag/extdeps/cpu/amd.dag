// SOCKET AM5 IS LGA, NOT PGA. Both Zen 4 rows below recorded PinGridArray at 1718 contacts — the
// termination AMD used through AM4 and abandoned at AM5: the socket is a zero insertion force
// flip-chip land grid array, so the processor presents lands and the socket the springs. The count
// was right; the termination was carried over from the AM4 rows. AM5 KEEPS AM4'S COOLER MOUNTING,
// WHICH IS WHY THE MOUNT IS NOT THE SOCKET. AM4 and AM5 are different sockets by every socket fact
// — 1331 pin-grid against 1718 land-grid — yet AMD retained the AM4 retention geometry on AM5 so
// AM4 coolers fit. A compatibility rule reading socket identity gets a real, common case WRONG in
// the refusing direction: it rejects a cooler that physically fits and that the vendor says fits.
// This is the discriminating pair for the whole correction, and why both rows below name one mount.
data amd_am4_cooling_mount: ProcessorCoolingMount = ProcessorCoolingMount {
  platform_owner: amd,
  designation: "AM4",
}

data amd_ryzen_9_7950x3d_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.amd.com/en/products/cpu/amd-ryzen-9-7950x3d"
  }
}

// cores and threads are cited from each model's AMD product page (authorities above). threads is
// stored as HardwareThreadCount — the comparable unit for hosted-runner vcpus in pricing extdeps.
data amd_zen2_l1_cache_geometry: CpuL1CacheGeometry = CpuL1CacheGeometry {
  data_capacity_per_core: byte_size(32768),
  instruction_capacity_per_core: byte_size(32768),
  line_size: byte_size(64),
}

// The Zen 2 L1/L2 citations were a Ryzen product page that states no cache geometry; they now cite the
// Family 17h Models 30h+ guide that does, in place, for every model sharing these rows (Ryzen and EPYC).
data amd_zen2_l1_cache_citations: List<FactCitation> = [
  FactCitation {
    fact: decl_field_ref(module_path: "extdeps.cpu.amd", decl_name: "amd_zen2_l1_cache_geometry", field_name: "data_capacity_per_core"),
    authority: amd_family_17h_zen2_sog_authority,
  },
  FactCitation {
    fact: decl_field_ref(module_path: "extdeps.cpu.amd", decl_name: "amd_zen2_l1_cache_geometry", field_name: "instruction_capacity_per_core"),
    authority: amd_family_17h_zen2_sog_authority,
  },
]

