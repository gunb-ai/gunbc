// THE AM5 TERMINATION IS CITED, not asserted. Both Zen 4 rows previously read PinGridArray at the
// correct 1718 count; an uncited socket field let a wrong termination sit beside a right number
// with nothing to check against.
//
// THE SOCKET IS A PLATFORM FACT AND NOW HAS ONE HOME PER PLATFORM, the shape extdeps.cpu.ampere
// already uses for LGA4926. Each row previously minted its own CpuSocket literal, so the citation
// lists beside them could name no declaration — which is how a citation ends up keyed by a field
// SPELLING ("package", a name CpuSocket has not carried since termination and attachment were
// split) instead of by the declaration the containment tree already names.
data amd_socket_am4_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "Read AM4's termination (PGA) and contact count (1331) from an AMD platform document or the AM4 socket vendor datasheet; en.wikipedia.org/wiki/Socket_AM4 is secondary." as NonEmptyStr
}

data amd_socket_am5_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "Read AM5's termination (LGA) and contact count (1718) from an AMD platform document or the AM5 socket vendor datasheet; en.wikipedia.org/wiki/Socket_AM5 is secondary." as NonEmptyStr
}

data amd_socket_am4: CpuSocket = CpuSocket {
  platform_owner: amd,
  termination: SocketedPinGrid,
  contact_count: 1331,
  cooling_mount: amd_am4_cooling_mount,
  figure_standing: amd_socket_am4_standing,
}

data amd_socket_am5: CpuSocket = CpuSocket {
  platform_owner: amd,
  termination: SocketedLandGrid,
  contact_count: 1718,
  cooling_mount: amd_am4_cooling_mount,
  figure_standing: amd_socket_am5_standing,
}

