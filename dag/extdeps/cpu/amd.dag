data amd_zen2_l2_cache_citations: List<extdeps.external_authority.FactCitation> = [
  extdeps.external_authority.FactCitation {
    fact: std.decl_ref.decl_field_ref(module_path: "extdeps.cpu.amd", decl_name: "amd_zen2_l2_cache_geometry", field_name: "capacity_per_core"),
