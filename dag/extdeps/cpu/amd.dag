// ---- EPYC (Naples, Rome) ------------------------------------------------------------------------
// FETCHED 2026-10-21. The two AMD product pages below embed their spec table as page JSON; the
// cores, threads, base clock, L3 capacity, default TDP and "Platform: SP3" read here are that
// table's values for each model. The pages state NO L1/L2 geometry and NO socket contact count, so
// those are cited to the figures' real homes below, not to the product page.
data amd_epyc_7551p_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.amd.com/en/products/cpu/amd-epyc-7551p"
  }
}

data amd_epyc_7702p_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.amd.com/en/products/cpu/amd-epyc-7702p"
  }
}

// L1/L2 GEOMETRY IS A PROPERTY OF THE CORE MICROARCHITECTURE, NOT OF A SKU, so it is cited to AMD's
// Software Optimization Guide for that core and the geometry rows are shared by every model of the
// microarchitecture (Zen 2: amd_zen2_l1/l2_cache_geometry above, reused by Rome; Zen: below).
// RETRIEVAL: AMD's own download URL answered 404/302 on 2026-10-21, so the guides were retrieved from
// the kernel-documentation mirror kib.kiev.ua/x86docs/AMD/Optimization, and the cited documents are AMD
// 56305 rev 3.00 'Software Optimization Guide for AMD Family 17h Models 30h and Greater Processors' and
// AMD 55723 rev 3.01 'Software Optimization Guide for AMD Family 17h Processors'; ExternalAuthority
// carries only a URI, so the title, number and revision live here and the locator is where it was retrieved. Held copies: 56305 rev 3.00 PDF sha256
// 9ac888ea13f03e7491dd330dbef346b23a4865d7596ad8d32cc3f99b8aec7f28 (section 2.6: 32-Kbyte 8-way L1
// instruction cache, 32-Kbyte 8-way L1 data cache, 512-Kbyte L2, 64-byte instruction cache line);
// 55723 rev 3.01 zip sha256 d9c3a7daacab554e5ec8c1801301d7bccc9253488c4fad517886849a1c78de6e (key
// features: 64-Kbyte L1 instruction cache, 32-Kbyte L1 data cache, 512-Kbyte unified L2 per core;
// section 2.6.1: 64-byte line). The mirror is not AMD, so a corrected AMD-hosted URL replaces these
// locators without changing any figure.
data amd_family_17h_zen2_sog_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "kib.kiev.ua/x86docs/AMD/Optimization/56305_3.00_Software%20Optimization%20Guide%20for%20AMD%20Family%2017h%20Models%2030h%20and%20Greater%20Processors.pdf"
  }
}

data amd_family_17h_zen1_sog_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "kib.kiev.ua/x86docs/AMD/Optimization/55723_3.01_Software%20Optimization%20Guide%20for%20AMD%20Family%2017h%20Processors.zip"
  }
}

data amd_zen1_l1_cache_geometry: CpuL1CacheGeometry = CpuL1CacheGeometry {
  data_capacity_per_core: byte_size(32768),
  instruction_capacity_per_core: byte_size(65536),
  line_size: byte_size(64),
}

