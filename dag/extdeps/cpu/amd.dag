// SOCKET SP3 IS CARRIED UNCITED. No AMD or socket-vendor document stating the LGA termination or the 4094
// contact count was retrievable on 2026-10-21 (the AMD EPYC 7002 data sheet and product brief state the
// socket name only). en.wikipedia.org/wiki/Socket_SP3 reads "Type LGA - ZIF", "Contacts 4094" but a
// secondary page is not an authority (DESIGN 4d), so no FactCitation is minted; the standing is the
// read obligation below. The cooling-mount designation is the socket's own name, the identity the AMD
// product pages carry as "Platform", and is likewise not cited.
data socket_sp3_standing: CitedFigureStanding = TranscribedUncited {
  read_obligation: "Read the SP3 socket's termination (LGA) and contact count (4094) from an AMD platform document or the SP3 socket vendor datasheet (e.g. Lotes or Foxconn); en.wikipedia.org/wiki/Socket_SP3 was the transcription source on 2026-10-21." as NonEmptyStr
}

data amd_sp3_cooling_mount: ProcessorCoolingMount = ProcessorCoolingMount {
  platform_owner: amd,
  designation: "SP3",
}

data amd_socket_sp3: CpuSocket = CpuSocket {
  platform_owner: amd,
  termination: SocketedLandGrid,
  contact_count: 4094,
  cooling_mount: amd_sp3_cooling_mount,
  figure_standing: socket_sp3_standing,
}

