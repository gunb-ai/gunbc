// SOCKET AM5 IS LGA, NOT PGA. Both Zen 4 rows below recorded PinGridArray at 1718 contacts, which
// is the termination AMD used through AM4 and abandoned at AM5 -- the socket is a zero insertion
// force flip-chip land grid array, so the processor presents lands and the socket presents the
// springs. The count was already right; the termination was carried over from the AM4 rows.
// AM5 KEEPS AM4'S COOLER MOUNTING, AND THAT IS WHY THE MOUNT IS NOT THE SOCKET. AM4 and AM5 are
// different sockets by every socket fact -- 1331 pin-grid against 1718 land-grid -- yet AMD retained
// the AM4 retention geometry on AM5 so that AM4 coolers fit. A compatibility rule reading socket
// identity therefore gets a real, common case WRONG in the refusing direction: it rejects a cooler
// that physically fits and that the vendor says fits. This is the discriminating pair for the whole
// correction, and it is why both rows below name one mount.
data amd_am4_cooling_mount: extdeps.cpu.types.ProcessorCoolingMount = extdeps.cpu.types.ProcessorCoolingMount {
  platform_owner: extdeps.vendor.amd.amd,
  designation: "AM4",
}

data socket_am5_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Socket_AM5"
  }
}

data amd_ryzen_9_7950x3d_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
