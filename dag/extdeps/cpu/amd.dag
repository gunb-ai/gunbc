// THE EPYC SoC FAMILIES: the grouping a board admits. A family is its cited model rows, so each
// family here holds exactly the one model this module cites; a further 7001/7002 model is a row added
// to its family's tail, and soc_family_eq (identity over the model rows) then distinguishes it.
data amd_epyc_7001_soc_family: SoCFamily = SoCFamily {
  name: "EPYC 7001",
  models: FreeSemigroup { head: epyc_7551p_catalog, tail: [] },
}

data amd_epyc_7002_soc_family: SoCFamily = SoCFamily {
  name: "EPYC 7002",
  models: FreeSemigroup { head: epyc_7702p_catalog, tail: [] },
}

// THE MODULE'S OWN ROSTER OF CATALOG ROWS, here rather than in a witness so a consumer asking
// "every AMD processor this repository models" reads one authority, and an author adding a row
// edits the roster in the same file. The roster is still hand-authored — a genuinely closed
// denominator would have to be discovered from the module tree, which is lens work — so this
// narrows the gap rather than closing it, and says so.
data amd_cpu_catalog_rows: List<CpuModelCatalogRow> = [
  ryzen_5_3600_catalog,
  ryzen_7_pro_8700ge_catalog,
  ryzen_9_7950x3d_catalog,
  epyc_7551p_catalog,
  epyc_7702p_catalog,
]
