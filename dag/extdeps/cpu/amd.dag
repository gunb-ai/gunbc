  }
}

// cores and threads are cited from each model's AMD product page (authorities above). threads is stored as HardwareThreadCount — the comparable unit for hosted-runner vcpus in pricing extdeps.
data amd_zen2_l1_cache_geometry: extdeps.cpu.types.CpuL1CacheGeometry = extdeps.cpu.types.CpuL1CacheGeometry {
  data_capacity_per_core: std.measure.byte_size(32768),
  instruction_capacity_per_core: std.measure.byte_size(32768),
  line_size: std.measure.byte_size(64),
}

data amd_zen2_l1_cache_citations: List<extdeps.external_authority.FactCitation> = [
  extdeps.external_authority.FactCitation {
    fact: std.decl_ref.decl_field_ref(module_path: "extdeps.cpu.amd", decl_name: "amd_zen2_l1_cache_geometry", field_name: "data_capacity_per_core"),
    authority: amd_ryzen_5_3600_authority,
  },
]

