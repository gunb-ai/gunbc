module extdeps.cpu.ampere_altra_package_contacts


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = ampere_altra_rev_a1_datasheet_authority

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = ampere_altra_package_model_scope

// Classified contacts are DERIVED from the transcribed Table 4 rows by the classifier in
// extdeps.cpu.ampere_altra_package — not pre-baked in a generator.
fn altra_package_contacts() -> List<extdeps.cpu.ampere_altra_package.PackageContact> {
  contacts_from_table4(rows: extdeps.cpu.ampere_altra_package_table4_raw.altra_table4_pin_rows)
}
