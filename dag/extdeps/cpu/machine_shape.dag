module extdeps.cpu.machine_shape


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/CPU_cache"
  }
}

type ShapeFromCatalogInput
  = FromCpuModelCatalog {
      domain: std.machine_shape.DomainId
      l1_level: std.machine_shape.LevelId
      l2_level: std.machine_shape.LevelId
      l3_level: std.machine_shape.LevelId
      row: extdeps.cpu.types.CpuModelCatalogRow
    }

fn memory_level_from_l1_cache(level_id: std.machine_shape.LevelId, row: extdeps.cpu.types.CpuModelCatalogRow) -> std.machine_shape.MemoryLevel {
  std.machine_shape.MemoryLevel {
    id: level_id
    capacity: row.l1_cache.data_capacity_per_core
    transfer_grain: v2.std.optional.Present { value: row.l1_cache.line_size }
    bandwidth: none
    latency: none
  }
}

fn memory_level_from_l2_cache(level_id: std.machine_shape.LevelId, row: extdeps.cpu.types.CpuModelCatalogRow) -> std.machine_shape.MemoryLevel {
  std.machine_shape.MemoryLevel {
    id: level_id
    capacity: row.l2_cache.capacity_per_core
    transfer_grain: v2.std.optional.Present { value: row.l2_cache.line_size }
    bandwidth: none
    latency: none
  }
}

fn memory_level_from_l3_cache(level_id: std.machine_shape.LevelId, row: extdeps.cpu.types.CpuModelCatalogRow) -> std.machine_shape.MemoryLevel {
  std.machine_shape.MemoryLevel {
    id: level_id
    capacity: row.l3_cache.capacity
    transfer_grain: v2.std.optional.Present { value: row.l3_cache.line_size }
    bandwidth: none
    latency: none
  }
}

fn memory_shape_from_cpu_catalog(
  l1_level: std.machine_shape.LevelId,
  l2_level: std.machine_shape.LevelId,
  l3_level: std.machine_shape.LevelId,
  row: extdeps.cpu.types.CpuModelCatalogRow
) -> std.machine_shape.MemoryShape {
  [
    memory_level_from_l1_cache(level_id: l1_level, row: row),
    memory_level_from_l2_cache(level_id: l2_level, row: row),
    memory_level_from_l3_cache(level_id: l3_level, row: row),
  ]
}

fn cpu_shape_from_catalog(input: ShapeFromCatalogInput) -> std.machine_shape.MachineShapeConstruction {
  match input {
    FromCpuModelCatalog { domain: domain, l1_level: l1_level, l2_level: l2_level, l3_level: l3_level, row: row } =>
      MachineShapeOk {
        shape: std.machine_shape.MachineShape {
          domains: [
            std.machine_shape.ExecutionDomain {
              id: domain
              execution: std.machine_shape.execution_shape_independent_lanes(lane_count: row.threads)
              memory: memory_shape_from_cpu_catalog(
                l1_level: l1_level,
                l2_level: l2_level,
                l3_level: l3_level,
                row: row
              )
            }
          ]
          edges: []
        }
      }
  }
}
