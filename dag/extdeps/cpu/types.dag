module extdeps.cpu.types

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/CPU_socket"
  }
}

type SocketPackage = LandGridArray | PinGridArray | BallGridArray

type CpuSocket {
  package: SocketPackage
  contact_count: Int
}

type CpuL1CacheGeometry {
  data_capacity_per_core: ByteSize
  instruction_capacity_per_core: ByteSize
  line_size: ByteSize
}

type CpuL2CacheGeometry {
  capacity_per_core: ByteSize
  line_size: ByteSize
}

type CpuL3CacheGeometry {
  capacity: ByteSize
  line_size: ByteSize
}

type CacheGeometryCitation {
  field: NonEmptyStr
  authority: ExternalAuthority
}

type CpuModelCatalogRow {
  model_number: NonEmptyStr
  oem_listing_id: NonEmptyStr?
  vendor: Vendor<Hardware>
  architecture: Architecture
  cores: Int
  threads: HardwareThreadCount
  nominal_sustained_per_thread_hz: Hertz
  socket: CpuSocket
  tdp_watts: Watt
  l1_cache: CpuL1CacheGeometry
  l1_cache_citations: List<CacheGeometryCitation>
  l2_cache: CpuL2CacheGeometry
  l2_cache_citations: List<CacheGeometryCitation>
  l3_cache: CpuL3CacheGeometry
  l3_cache_citations: List<CacheGeometryCitation>
}

type CpuDeploymentFacts {
  sustained_per_thread_hz: Hertz
}

type CpuFacts {
  catalog: CpuModelCatalogRow
  deployment: CpuDeploymentFacts
}
