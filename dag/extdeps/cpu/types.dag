module extdeps.cpu.types


import extdeps.external_authority { ExternalAuthority, FactCitation, CitedFigureStanding }
import extdeps.uri { Uri, Https }
import extdeps.toolchain.types { Architecture }
import extdeps.vendor { Vendor }
import extdeps.hardware { Hardware }
import std.measure { ByteSize, Celsius, HardwareThreadCount, Hertz, Watt }
import std.types { Bool, Int, List, NonEmptyStr }
import std.algebra { FreeSemigroup, non_empty_to_list }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/CPU_socket"
  }
}

// TERMINATION AND ATTACHMENT ARE TWO AXES, AND FUSING THEM MADE A CONTRADICTION WRITABLE. The
// previous SocketPackage listed BallGridArray beside the two socketable terminations, inside a type
// named CpuSocket -- but a BGA part is SOLDERED to the board. It has no socket at all, so
// CpuSocket { package: BallGridArray } named a thing that cannot exist, and nothing refused it.
//
// The split is by what the fact is ABOUT. A termination is a property of the PACKAGE: it says how
// the die's carrier presents its contacts, and every part has one whether or not a socket is
// involved. An attachment is a property of the BOARD RELATIONSHIP: it says how the part is held.
// Grounding both on one enum made a package property answer a board question.
type ProcessorPackageTermination = LandGridArray | PinGridArray | BallGridArray

// THE SOCKETABLE SUBSET. A socket accepts a land grid or a pin grid; it cannot accept a ball grid,
// because balls are reflowed onto pads and a reflowed joint is not a socket. So the socketable
// terminations are their own closed set and BallGridArray is not among them.
//
// RUNG HONESTY, MEASURED RATHER THAN ASSUMED, AND IT IS LOWER THAN THIS SHAPE SUGGESTS. The intent
// was structural impossibility: a ball-grid socket with no representation. IT IS NOT ACHIEVED, and
// the probe that says so was run before this comment was written. Constructing
// CpuSocket { platform_owner: amd, termination: BallGridArray, contact_count: 1718 } inside a
// witness module was ACCEPTED and executed green, even though BallGridArray belongs to
// ProcessorPackageTermination and the field is declared SocketTermination -- and even though
// BallGridArray was not imported by that module at all. The control that makes this a finding rather
// than a mistaken probe: an invented name in the same position refuses with
// "undefined variable 'NotARealTerminationXyz'". So the checker resolves a bare variant name from
// the pool and then does not test which coproduct it belongs to.
//
// WHERE THE ERROR DOES SURFACE, measured separately, because the bound matters more than the alarm.
// Passing BallGridArray to socket_termination_as_package_termination -- argument position rather
// than a record field -- is also accepted statically, but it fails at RUNTIME with "non-exhaustive
// pattern match on: BallGridArray" as soon as that function matches. So a total match over the
// coproduct is a real runtime guard: any value that reaches one is checked. What is silent is a
// wrong variant that is only STORED or COMPARED and never matched, which is exactly the record-field
// probe above -- it read contact_count and never looked at the termination.
//
// The blast radius is therefore narrower than a count of enums would suggest, and two neighbouring
// walls were confirmed to HOLD rather than assumed: sole_constructor refuses cross-module
// construction and cast, and a missing required field refuses at every site (nine socket literals
// refused until they named a cooling mount). This finding implicates claims that rest on variant
// membership alone, not those resting on construction sealing or record shape.
//
// WHAT THIS TYPE THEREFORE DELIVERS: the two concepts are separated and every socket row in the
// corpus names a socketable termination, so the corpus is correct and a reader can no longer mistake
// a package property for a board one. WHAT IT DOES NOT DELIVER: a wall. The rung is MITIGATABLE, not
// structurally impossible, and no lens detects the cross-coproduct assignment either.
//
// NEXT-RUNG TRIGGER: variant-to-coproduct membership checked at the assignment site. That is a
// substrate capability rather than a modelling change, and it is not specific to sockets -- every
// closed enum in this corpus that is described as making a state unwritable rests on the same
// unverified premise, so this note is evidence about the checker and not only about this type.
type SocketTermination = SocketedLandGrid | SocketedPinGrid

// The one direction that is total: every socket termination IS a package termination. The reverse
// is deliberately absent -- there is no ball-grid socket to map to, and a partial function back
// would reintroduce the refusal this type exists to make unnecessary.
fn socket_termination_as_package_termination(t: SocketTermination) -> ProcessorPackageTermination {
  match t {
    SocketedLandGrid => LandGridArray
    SocketedPinGrid => PinGridArray
  }
}

// A SOCKET IS NOT IDENTIFIED BY ITS TERMINATION AND CONTACT COUNT. Those are attributes two
// unrelated platforms can share: a hypothetical 4926-contact AMD socket would have been
// structurally identical to Ampere's, and the corpus already carried a live collision -- AMD
// Socket AM5 and the Zen 4 rows both read PinGridArray at 1718 while naming different sockets,
// which is exactly the reading that let an AM4 termination survive on AM5 parts.
//
// THE IDENTIFYING AXIS IS THE PLATFORM OWNER, NOT THE MANUFACTURER. The company that stamps the
// connector does not identify the socket: Lotes manufactures Socket AM5 for AMD and the LGA4926
// retention hardware for Ampere, so a manufacturer axis would make those two the same socket
// while making one socket from two suppliers into two. What fixes a socket is the platform whose
// processors it accepts, so this is the CPU vendor that defines the platform -- and the connector
// maker stays where it belongs, on the part rows in extdeps.cpu_attachment.
//
// Contact count and package remain as attributes because a board still needs them; they are just
// no longer permitted to answer the identity question on their own.
// A COOLER DOES NOT ATTACH TO THE CONTACTS. It attaches to the retention hardware around them -- the
// loading mechanism, the backplate, the mounting-hole pattern and the load the assembly is rated to
// apply. Those are mechanical facts about the SOCKET'S RETENTION SYSTEM, and the contact count is
// not among them. The two happen to correlate because a platform defines both together, which is
// precisely why a compatibility rule reading contacts LOOKS right and is not: it fits any part that
// coincidentally shares a count, and coolers labelled for a foreign platform at a matching count
// already exist in the market.
//
// So a mount is its own identity, and it is carried BY the socket rather than derived from it: a
// socket cannot be authored without naming the mount it presents, which is the completeness a
// separate join table would have had to check for.
type ProcessorCoolingMount {
  platform_owner: Vendor<Hardware>
  designation: NonEmptyStr
}

fn cooling_mount_eq(a: ProcessorCoolingMount, b: ProcessorCoolingMount) -> Bool {
  a.platform_owner == b.platform_owner && a.designation == b.designation
}

type CpuSocket {
  platform_owner: Vendor<Hardware>

  termination: SocketTermination
  contact_count: Int

  cooling_mount: ProcessorCoolingMount

  figure_standing: CitedFigureStanding
}

// WHY THE ATTACHMENT-MODE HALF IS NOT HERE. Splitting termination from attachment is one correction
// with two halves, and this is the half that is fully consumed today: every socket row in the corpus
// now names a SocketTermination, so a ball-grid socket is unwritable at every existing site. The
// other half - ProcessorBoardAttachment, the Socketed-versus-DirectSoldered axis - has no consumer
// until CpuModelCatalogRow carries an attachment instead of a socket, and that migration lands with
// the cooling-mount correction because both change the same path. Landing the type here would put a
// coproduct in the corpus whose only caller is its own witness, which is the decorative-carrier
// failure this repository keeps catching in review.

// figure_standing is the evidentiary standing of termination and contact_count, carried with the socket they
// are facts about rather than restated per SKU. It is NOT part of a socket's identity: a citation is not
// the socket, so cpu_socket_eq ignores it.
//
// SAME SOCKET means same platform owner AND same termination AND same count. Equal counts across
// platforms are a coincidence of scale, not a compatibility fact, and a cooler or a footprint that
// decided on the count alone would fit a part it was never made for.
fn cpu_socket_eq(a: CpuSocket, b: CpuSocket) -> Bool {
  a.platform_owner == b.platform_owner
    && a.termination == b.termination
    && a.contact_count == b.contact_count
}

type CpuL1CacheGeometry {
  data_capacity_per_core: ByteSize
  instruction_capacity_per_core: ByteSize
  line_size: ByteSize
}

type CpuL2CacheGeometry {
  capacity_per_core: ByteSize
  line_size: ByteSize
}

type CpuL3CacheGeometry {
  capacity: ByteSize
  line_size: ByteSize
}

type ProcessorThermalLimits {
  maximum_continuous_junction_temperature: Celsius
  thermal_throttle_temperature: Celsius
  thermal_shutdown_temperature: Celsius
  authority: ExternalAuthority
}

type CpuModelCatalogRow {
  model_number: NonEmptyStr
  oem_listing_id: NonEmptyStr?
  vendor: Vendor<Hardware>
  architecture: Architecture
  cores: Int
  threads: HardwareThreadCount
  nominal_sustained_per_thread_hz: Hertz
  socket: CpuSocket
  tdp_watts: Watt
  l1_cache: CpuL1CacheGeometry
  l1_cache_citations: List<FactCitation>
  l2_cache: CpuL2CacheGeometry
  l2_cache_citations: List<FactCitation>
  l3_cache: CpuL3CacheGeometry
  l3_cache_citations: List<FactCitation>
}

// A SOC FAMILY IS THE GROUPING OF CATALOG MODELS THAT SHARE ONE SO SILICON LINE.
//
// The per-model CpuModelCatalogRow rows already carry the upstream-attested architecture of each
// model. What is missing is the grouping a BOARD admits: a board is designed for a set of SoC
// families (a dual-socket Altra/Altra Max board admits BOTH the Altra and the Altra Max lines), and
// the firmware architecture of such a board is only a PLATFORM FACT when every admitted family maps
// to the same architecture. Grouping the per-model rows into families lets the board edge name the
// families it admits and lets the architecture be DERIVED from the models it cites, never inferred.
type SoCFamily {
  name: NonEmptyStr
  // NON-EMPTY BY CONSTRUCTION (review 81340 F1). This was List<CpuModelCatalogRow>, which let an
  // EMPTY family be written and then caught it at run time: soc_family_architecture answered `none`
  // on Absent, and the refusal read the same as "the models disagree". DESIGN.md Sec 5 -- "stronger
  // than catching a wrong state is making it unwritable" -- and Sec 3b's ruling
  // gunbc.design_ruling nonemptiness_is_constructed_or_proved, which names FreeSemigroup as the
  // carrier for exactly this: "Nonemptiness is constructed or proved, then consumed". A family with
  // no model rows is not a family, so it now has no representation rather than a runtime veto.
  models: FreeSemigroup<CpuModelCatalogRow>
}

// WHETHER TWO FAMILY ROWS ARE THE SAME SILICON LINE, tested by IDENTITY — never by name.
//
// A family IS the grouping of its catalog model rows ("the grouping of catalog models that share one So
// silicon line", above), so two rows name one family exactly when they group the same models. Comparing
// `name` would let any unrelated row that spells its name "Altra" inherit everything cited about Altra —
// review 81149, finding 3, which was exactly how SMpro carrying was decided here. The name stays on the
// type because upstream names families in prose and a refusal must be readable, but it decides nothing.
//
// The model-row comparison is on the row's IDENTITY — vendor + model number + OEM listing — which is the
// key an OEM lists a part under. Architecture, core counts and cache geometry are cited ATTRIBUTES of
// that key, not part of what makes the part itself; two rows agreeing on the key but disagreeing on an
// attribute are a contradiction to fix at the citation, not two different parts.
fn cpu_model_catalog_row_eq(a: CpuModelCatalogRow, b: CpuModelCatalogRow) -> Bool {
  (a.vendor.legal_name as String) == (b.vendor.legal_name as String)
    && (a.model_number as String) == (b.model_number as String)
    // OPTIONAL EQUALITY IS COMPARISON, not a match. This used to unfold both optionals by hand --
    // Present/Present compare, Present/Absent false, Absent/Present false, Absent/Absent true -- which is
    // the canonical surface for Option re-derived inside an extdeps file (review 81287 F3; DESIGN §2, "net
    // concepts must not grow by re-invention"). `==` on two Options of a comparable leaf is that surface,
    // and it is used elsewhere in the corpus; four arms of prose became one comparison.
    && a.oem_listing_id == b.oem_listing_id
}

fn soc_family_eq(a: SoCFamily, b: SoCFamily) -> Bool {
  // Read through the canonical accessor, as every other FreeSemigroup field in the corpus is
  // (extdeps.colo.types, std.goal_assessment, gunbc.witness.witness_floor_lanes): the non-emptiness is
  // carried by the TYPE, and the folds below run on the ordinary list once that guarantee is had.
  let am = non_empty_to_list(xs: a.models)
  let bm = non_empty_to_list(xs: b.models)
  count(am) == count(bm)
    && all(am, m => any(bm, n => cpu_model_catalog_row_eq(a: m, b: n)))
    && all(bm, m => any(am, n => cpu_model_catalog_row_eq(a: m, b: n)))
}

// THE FIRMWARE ARCHITECTURE A FAMILY ESTABLISHES, OR NONE.
//
// A family establishes an architecture only when every model in it reports the SAME one. A family
// whose models disagree establishes nothing, and the answer is `none`, never "first wins". This is the
// platform fact a board edge composes over, and the refusal is typed as "unestablished" downstream, not
// collapsed to an absent selection.
//
// THE EMPTY FAMILY HAS NO ARM HERE ANY MORE (review 81340 F1). It used to: `first()` on a List could
// answer Absent, so the function needed a branch for it and callers had to wonder whether "none" meant
// "disagreeing models" or "nobody said anything". `models` is now FreeSemigroup, so there is always a
// lead and the only remaining reason to refuse is the one that is a real fact.
fn soc_family_architecture(family: SoCFamily) -> Architecture? {
  let models = non_empty_to_list(xs: family.models)
  let lead = family.models.head
  if models |> all(m => m.architecture == lead.architecture) {
    Present { value: lead.architecture }
  } else {
    none
  }
}

type CpuDeploymentFacts {
  sustained_per_thread_hz: Hertz
}

type CpuFacts {
  catalog: CpuModelCatalogRow
  deployment: CpuDeploymentFacts
}
