module extdeps.jobserver


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.gnu.org/software/make/manual/html_node/POSIX-Jobserver.html"
  }
}

type JobserverConfig {
  margin: std.measure.HardwareThreadCount
  mem_reserve: std.measure.ByteSize
  mib_per_job: std.measure.ByteSize
}

fn derive_jobserver_tokens(nproc: std.measure.HardwareThreadCount, mem_total: std.measure.ByteSize, cfg: JobserverConfig) -> std.measure.HardwareThreadCount {
  let cpu_bound = std.measure.hardware_thread_count_value(t: std.realization_width.cpu_cores_available(nproc: nproc, margin: cfg.margin))
  let mem_for_builds = std.realization_width.byte_size_saturating_sub(total: mem_total, reserved: cfg.mem_reserve)
  let mem_bound = std.measure.measure_fit_count_floor(capacity: mem_for_builds, each: cfg.mib_per_job)
  std.measure.hardware_thread_count(count: std.nat.nat_min(a: cpu_bound, b: mem_bound))
}

fn jobserver_build_pool_bytes(nproc: std.measure.HardwareThreadCount, mem_total: std.measure.ByteSize, cfg: JobserverConfig) -> std.measure.ByteSize {
  let tokens = derive_jobserver_tokens(nproc: nproc, mem_total: mem_total, cfg: cfg)
  std.measure.measure_scale_fraction_floor(m: cfg.mib_per_job, num: std.measure.hardware_thread_count_value(t: tokens), den: 1)
}

type JobserverCitation
  = JobserverCited { config: JobserverConfig, provenance: String }
  | JobserverAbsent

data jobserver_config_citation_note: String = "CITED 2026-08-06 from the installed jobserver on srv1, replacing JobserverAbsent. The three knobs are read from /usr/local/sbin/ctrl-jobserver's own defaults — CTRL_JOBSERVER_MARGIN=8, CTRL_JOBSERVER_MEM_RESERVE_GIB=16, CTRL_JOBSERVER_MIB_PER_JOB=1792 — and the script documents its derivation as tokens = max(1, min(cores - MARGIN, floor(usable_mib / MIB_PER_JOB))) with usable_mib = (MemTotal_gib - MEM_RESERVE_GIB) * 1024.\n\nThat is derive_jobserver_tokens above, term for term, which is why this is a citation rather than an approximation: the model was already carrying the installer's formula and lacked only its inputs. The absence was never a modeling gap — it was a reach gap, and it closed the moment the host became readable.\n\nWHAT CITING DOES AND DOES NOT CHANGE: it does not move any current number. gunbc_compile_pool_placement is CompilePoolInRunnerSlots, so compile_pool_bytes_for still derives zero regardless of this citation; what it unblocks is the flip to CompilePoolSliceDeclared, which previously refused with CompilePoolUnresolved and made the whole runner_deployment_plan PlanUnsound. That refusal was correct and is now discharged.\n\nPLACEMENT CAVEAT, stated rather than silently accepted: these are facts about THIS FLEET's installed jobserver, not about the GNU make jobserver protocol this module cites, so a stricter section 3 reading puts the row in a gunbc module and leaves the protocol shape here. It stays put because every consumer already reads it here and moving it is a rename across a live seam — the same class of migration whose hazards are recorded in gunbc.host_converge. Dissolve-on: the row moves when a gunbc-owned jobserver replaces ctrl-jobserver and the citation follows it."

data jobserver_config: JobserverCitation = JobserverCited {
  config: JobserverConfig {
    margin: std.measure.hardware_thread_count(count: 8),
    mem_reserve: std.measure.byte_size(17179869184),
    mib_per_job: std.measure.byte_size(1879048192),
  },
  provenance: "srv1 /usr/local/sbin/ctrl-jobserver defaults read 2026-08-06: CTRL_JOBSERVER_MARGIN=8 cores, CTRL_JOBSERVER_MEM_RESERVE_GIB=16 (17179869184 bytes), CTRL_JOBSERVER_MIB_PER_JOB=1792 (1879048192 bytes); same unit installed on srv1 and srv2",
}

