module extdeps.communication.fidelity_carriers


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Means_of_communication"
  }
}

fn decode_fidelity_merge(left: extdeps.communication.medium.DecodeFidelity, right: extdeps.communication.medium.DecodeFidelity) -> extdeps.communication.medium.DecodeFidelity {
  match left {
    Lossy => Lossy
    Lossless => right
  }
}

fn decode_fidelity_from_step_fidelities(steps: List<extdeps.communication.medium.DecodeFidelity>) -> extdeps.communication.medium.DecodeFidelity {
  fold(
    steps,
    init: Lossless,
    f: (acc, step) => decode_fidelity_merge(left: acc, right: step)
  )
}

fn source_medium_carried<R>(carried: R, fidelity: extdeps.communication.medium.DecodeFidelity) -> extdeps.communication.medium.Medium<R> {
  extdeps.communication.medium.Medium { carried: carried, fidelity: fidelity }
}

fn medium_section_equal<R>(left: extdeps.communication.medium.Medium<R>, right: extdeps.communication.medium.Medium<R>) -> Bool {
  left.carried == right.carried
}
