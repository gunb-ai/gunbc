module extdeps.communication.numerical_fidelity


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.communication.medium { DecodeFidelity }
import std.numerical_contract { FloatApproximate, NumericalContract }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#floating-point"
  }
}

// Reading: docs.nvidia.com owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its type declaration LoweringRefusalReason, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.communication.numerical_fidelity",
      decl_name: "LoweringRefusalReason",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type LoweringRefusalReason
  = FmaContractionRefusedByContract
  | UnsupportedNumericalDomain

type LoweringFidelityVerdict
  = LoweringAccepted { fidelity: DecodeFidelity }
  | LoweringRefused { reason: LoweringRefusalReason }

fn decode_fidelity_for_contract(contract: NumericalContract) -> DecodeFidelity {
  match contract {
    IntegerExact => Lossless
    FloatApproximate { fma_contraction: fma, rounding: _ } =>
      match fma {
        FmaContractionRefused => Lossless
        FmaContractionPermitted => Lossy
      }
  }
}

fn lowering_fidelity_verdict_for_contract(contract: NumericalContract) -> LoweringFidelityVerdict {
  LoweringAccepted {
    fidelity: decode_fidelity_for_contract(contract: contract)
  }
}
