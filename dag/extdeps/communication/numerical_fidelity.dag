module extdeps.communication.numerical_fidelity


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#floating-point"
  }
}

type LoweringRefusalReason
  = FmaContractionRefusedByContract
  | UnsupportedNumericalDomain

type LoweringFidelityVerdict
  = LoweringAccepted { fidelity: extdeps.communication.medium.DecodeFidelity }
  | LoweringRefused { reason: LoweringRefusalReason }

fn decode_fidelity_for_contract(contract: std.numerical_contract.NumericalContract) -> extdeps.communication.medium.DecodeFidelity {
  match contract {
    IntegerExact => Lossless
    FloatApproximate { fma_contraction: fma, rounding: _ } =>
      match fma {
        FmaContractionRefused => Lossless
        FmaContractionPermitted => Lossy
      }
  }
}

fn lowering_fidelity_verdict_for_contract(contract: std.numerical_contract.NumericalContract) -> LoweringFidelityVerdict {
  LoweringAccepted {
    fidelity: decode_fidelity_for_contract(contract: contract)
  }
}
