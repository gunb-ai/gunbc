module extdeps.communication.numerical_fidelity

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.communication.medium { DecodeFidelity, Lossless, Lossy }
import std.numerical_contract {
  NumericalContract,
  IntegerExact,
  FloatApproximate,
  FmaContractionPermitted,
  FmaContractionRefused,
  ReductionOrderPermitted,
  ReductionOrderRefused,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#floating-point"
  }
}

type LoweringRefusalReason
  = FmaContractionRefusedByContract
  | ReductionOrderRefusedByContract
  | UnsupportedNumericalDomain

type LoweringFidelityVerdict
  = LoweringAccepted { fidelity: DecodeFidelity }
  | LoweringRefused { reason: LoweringRefusalReason }

fn decode_fidelity_for_contract(contract: NumericalContract) -> DecodeFidelity {
  match contract {
    IntegerExact => Lossless
    FloatApproximate { fma_contraction: fma, rounding: _, reduction_order: reduction } =>
      match fma {
        FmaContractionPermitted => Lossy
        FmaContractionRefused =>
          match reduction {
            ReductionOrderPermitted => Lossy
            ReductionOrderRefused => Lossless
          }
      }
  }
}

fn lowering_fidelity_verdict_for_contract(contract: NumericalContract) -> LoweringFidelityVerdict {
  match contract {
    IntegerExact => LoweringAccepted {
      fidelity: decode_fidelity_for_contract(contract: contract)
    }
    FloatApproximate { fma_contraction: fma, rounding: _, reduction_order: reduction } =>
      match fma {
        FmaContractionRefused =>
          match reduction {
            ReductionOrderRefused => LoweringAccepted {
              fidelity: decode_fidelity_for_contract(contract: contract)
            }
            ReductionOrderPermitted => LoweringAccepted {
              fidelity: decode_fidelity_for_contract(contract: contract)
            }
          }
        FmaContractionPermitted => LoweringAccepted {
          fidelity: decode_fidelity_for_contract(contract: contract)
        }
      }
  }
}
