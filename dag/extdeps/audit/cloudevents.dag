module extdeps.audit.cloudevents

import std.types { NonEmptyStr, Timestamp }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/cloudevents/spec/blob/v1.0.2/cloudevents/spec.md"
  }
}

type CloudEventId = NonEmptyStr where brand("CloudEventId")
type CloudEventSource = NonEmptyStr where brand("CloudEventSource")
type CloudEventSpecVersion = NonEmptyStr where brand("CloudEventSpecVersion")
type CloudEventType = NonEmptyStr where brand("CloudEventType")
type CloudEventSubject = NonEmptyStr where brand("CloudEventSubject")
type CloudEventExtensionName = NonEmptyStr where brand("CloudEventExtensionName")
type CloudEventExtensionValue = NonEmptyStr where brand("CloudEventExtensionValue")

type AuditActorKind
  = HumanActor
  | ServiceActor
  | SystemActor

type AuditOutcome
  = AuditSucceeded
  | AuditDenied
  | AuditFailed

type AuditActor {
  kind: AuditActorKind
  id: NonEmptyStr
}

type AuditEventField {
  key: CloudEventExtensionName
  value: CloudEventExtensionValue
}

type AuditEventRecord {
  id: CloudEventId
  source: CloudEventSource
  specversion: CloudEventSpecVersion
  type: CloudEventType
  subject: CloudEventSubject
  actor: AuditActor
  outcome: AuditOutcome
  time: Timestamp
  fields: List<AuditEventField>
}

type AuditEventEmissionTarget {
  stream_name: NonEmptyStr
  events: List<AuditEventRecord>
}
