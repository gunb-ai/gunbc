module extdeps.audit.cloudevents


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "github.com/cloudevents/spec/blob/v1.0.2/cloudevents/spec.md"
  }
}

type CloudEventId = std.types.NonEmptyStr where brand("CloudEventId")
type CloudEventSource = std.types.NonEmptyStr where brand("CloudEventSource")
type CloudEventSpecVersion = std.types.NonEmptyStr where brand("CloudEventSpecVersion")
type CloudEventType = std.types.NonEmptyStr where brand("CloudEventType")
type CloudEventSubject = std.types.NonEmptyStr where brand("CloudEventSubject")
type CloudEventExtensionName = std.types.NonEmptyStr where brand("CloudEventExtensionName")
type CloudEventExtensionValue = std.types.NonEmptyStr where brand("CloudEventExtensionValue")

type AuditActorKind
  = HumanActor
  | ServiceActor
  | SystemActor

type AuditOutcome
  = AuditSucceeded
  | AuditDenied
  | AuditFailed

type AuditActor {
  kind: AuditActorKind
  id: std.types.NonEmptyStr
}

type AuditEventField {
  key: CloudEventExtensionName
  value: CloudEventExtensionValue
}

type AuditEventRecord {
  id: CloudEventId
  source: CloudEventSource
  specversion: CloudEventSpecVersion
  type: CloudEventType
  subject: CloudEventSubject
  actor: AuditActor
  outcome: AuditOutcome
  time: std.types.Timestamp
  fields: List<AuditEventField>
}

type AuditEventEmissionTarget {
  stream_name: std.types.NonEmptyStr
  events: List<AuditEventRecord>
}
