module extdeps.audit.cloudevents


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { List, NonEmptyStr, Timestamp, brand }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/cloudevents/spec/blob/v1.0.2/cloudevents/spec.md"
  }
}

// Reading: github.com owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its type declaration CloudEventId, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.audit.cloudevents",
      decl_name: "CloudEventId",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type CloudEventId = NonEmptyStr where brand("CloudEventId")
type CloudEventSource = NonEmptyStr where brand("CloudEventSource")
type CloudEventSpecVersion = NonEmptyStr where brand("CloudEventSpecVersion")
type CloudEventType = NonEmptyStr where brand("CloudEventType")
type CloudEventSubject = NonEmptyStr where brand("CloudEventSubject")
type CloudEventExtensionName = NonEmptyStr where brand("CloudEventExtensionName")
type CloudEventExtensionValue = NonEmptyStr where brand("CloudEventExtensionValue")

type AuditActorKind
  = HumanActor
  | ServiceActor
  | SystemActor

type AuditOutcome
  = AuditSucceeded
  | AuditDenied
  | AuditFailed

type AuditActor {
  kind: AuditActorKind
  id: NonEmptyStr
}

type AuditEventField {
  key: CloudEventExtensionName
  value: CloudEventExtensionValue
}

type AuditEventRecord {
  id: CloudEventId
  source: CloudEventSource
  specversion: CloudEventSpecVersion
  type: CloudEventType
  subject: CloudEventSubject
  actor: AuditActor
  outcome: AuditOutcome
  time: Timestamp
  fields: List<AuditEventField>
}

type AuditEventEmissionTarget {
  stream_name: NonEmptyStr
  events: List<AuditEventRecord>
}
