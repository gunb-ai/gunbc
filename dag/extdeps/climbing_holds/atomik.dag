module extdeps.climbing_holds.atomik

import std.types { NonEmptyStr, List }
import std.nat { Nat }
import std.measure { millimeter }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.climbing_holds.types {
  ClimbingHoldCatalogRow, HoldLocalFrameStanding, HoldLocalFrameIncomplete, ProductNameStanding, ProductSkuUnread,
  HoldFixationInterface, ConservativeClearanceEnvelope, HoldGraspProfile,
  CatalogLengthReading, SourceNativeLength, Inch, RoundedUpFromSourceReading,
  HoldMaterialUnread, FastenerThreadUnread, HoldMountingFaceUnread,
  Jug, OperatorRelayedDocument, ShapeArtifactAbsent,
}
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.atomikclimbingholds.com/xl-arrow-shaped-down-climb-jug"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.climbing_holds.atomik",
      decl_name: "atomik_xl_arrow_down_climb_jug",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// PROVENANCE, and it is the most important line in this file.
//
// These figures came from a ROUTED REVIEW that reports having reached the official product page.
// They are NOT stamped VendorPageRead, and the difference is not fussiness. Every outbound fetch
// from this environment is refused by egress policy, so this session cannot open that page. A
// reviewer's report of a page is a relayed reading: better than a search summary because it is a
// direct report of the document, and not a first-party read because the chain runs through
// someone else.
//
// Stamping VendorPageRead here would be the third instance of one failure in a single session.
// The first invented a fact — the ALTRAD8UD power headers. The second invented that fact's
// authority, writing "verified against the vendor manual" over a manual that was never opened.
// Writing VendorPageRead over a reviewer's relay would be the same move a third time, and it is
// especially tempting here because the reviewer is right and the numbers are almost certainly
// correct. Being correct is not the same as being read, and the row records how it was obtained.
data atomik_provenance_note: NonEmptyStr = "Figures relayed by a routed review reporting a first-party read of the official product page. Not read by this session: outbound fetches are refused by egress policy. Recorded as OperatorRelayedDocument, never as VendorPageRead."

// WHAT THE CORRECTION CHANGED, kept because it is the strongest evidence in this file that the
// refusal was worth its cost.
//
// The previous version of this row carried search-summary figures of 6-7/8 in wide, 3-1/4 in
// projection, and a 5 in lip width. The relayed page reading gives 6-1/2 in wide, 3 in projection,
// and a 4-1/2 in usable internal width. Every one of those is WRONG in the earlier reading, and
// two are wrong in the unsafe direction: the hold is SMALLER than the summary claimed, so a
// clearance box built from the summary would have been generous while a grip-room estimate built
// from the "5 in lip" would have overstated the room a hand actually gets.
//
// The search summary was not stale or ambiguous. It was simply incorrect, and it read as
// authoritative. Had those numbers been spendable, they would have been spent — into a clearance
// reservation, a keep-out and a drawing — and nothing downstream would have flagged them, because
// nothing downstream can tell a wrong number from a right one. The refusal is what stopped it.
data atomik_search_summary_was_wrong_note: NonEmptyStr = "The earlier search-summary reading gave 6-7/8 in width, 3-1/4 in projection and a 5 in lip. The relayed page reading gives 6-1/2 in, 3 in and a 4-1/2 in usable internal width. The summary was wrong on every one, and overstated grip room. This is the concrete payoff of refusing unspendable provenance rather than merely labelling it."

data atomik_page_relay: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.atomikclimbingholds.com/xl-arrow-shaped-down-climb-jug"
  }
}

data atomik_relayed_evidence_note: NonEmptyStr = "Relayed by routed review 2026-08-11; not fetched by this session."

// Source readings in the vendor's own units, stored EXACTLY. 6-1/2 in is 13/2, 7-1/2 in is 15/2,
// 3 in is 3/1. Nothing here is converted, so the conversion below can always be re-derived and
// re-checked against the reading rather than replacing it.
data atomik_source_width: CatalogLengthReading = CatalogLengthReading {
  value: SourceNativeLength { numerator: 13, denominator: 2, unit: Inch },
  evidence: OperatorRelayedDocument {
    authority: atomik_page_relay,
    relay_note: atomik_relayed_evidence_note,
  },
}

data atomik_source_height: CatalogLengthReading = CatalogLengthReading {
  value: SourceNativeLength { numerator: 15, denominator: 2, unit: Inch },
  evidence: OperatorRelayedDocument {
    authority: atomik_page_relay,
    relay_note: atomik_relayed_evidence_note,
  },
}

data atomik_source_projection: CatalogLengthReading = CatalogLengthReading {
  value: SourceNativeLength { numerator: 3, denominator: 1, unit: Inch },
  evidence: OperatorRelayedDocument {
    authority: atomik_page_relay,
    relay_note: atomik_relayed_evidence_note,
  },
}

// The derived clearance box: 13/2 in = 165.1 mm to 166, 15/2 in = 190.5 mm to 191, 3 in = 76.2 mm
// to 77. Rounded UP, so the reserved space always contains the part. This may reserve space and
// may never be dimensioned from.
data atomik_clearance_envelope: ConservativeClearanceEnvelope = ConservativeClearanceEnvelope {
  width_mm: millimeter(count: 166),
  height_mm: millimeter(count: 191),
  projection_mm: millimeter(count: 77),
  derivation: RoundedUpFromSourceReading {
    source_note: "Rounded up from 13/2 in = 165.1 mm, 15/2 in = 190.5 mm, 3/1 in = 76.2 mm. Conservative for reservation; invalid as a datum.",
  },
  evidence: OperatorRelayedDocument {
    authority: atomik_page_relay,
    relay_note: atomik_relayed_evidence_note,
  },
}

// The frame, and still the only part of this row that is not a reading. It is a definition, so it
// needs no vendor confirmation and holds while the sculpt is unknown.
// The frame standing is INCOMPLETE, and saying so is the correction. The previous version of this
// declaration was four sentences describing where the origin and axes would be, which read as a
// defined frame while defining nothing. Nothing here has been measured: the bolt axis position on
// this SKU's mounting face is unread, and the anti-rotation fixing's direction relative to it is
// unread. Both are cheap to obtain from a sample and neither may be invented.
data atomik_bolt_on_frame: HoldLocalFrameStanding = HoldLocalFrameIncomplete {
  obligations: [
    "Measure the primary bolt axis position on the mounting face of a sample, or read it from vendor CAD.",
    "Measure the anti-rotation fixing direction relative to the bolt axis; it defines +x and is currently unread.",
    "Confirm the mounting face is a single flat before treating its normal as +z.",
  ],
}

// The thread stays UNREAD. Atomik publishes 3/8-16 T-nuts, and 3/8-16 is the ordinary bolt-on
// convention, so the answer is very probably 3/8-16 — which is exactly the reasoning that must not
// be written into the row. A vendor selling a compatible T-nut is not a statement that THIS hold's
// selected hardware option uses that stack. The general reference describes the whole practice and
// states no thread at all, so nothing in general knowledge can close this either. It closes when
// one complete stack is selected: exact hold, exact bolt option, exact T-nut, exact anti-spin
// fasteners, exact panel stock.
data atomik_xl_arrow_down_climb_jug_fixation: HoldFixationInterface = HoldFixationInterface {
  primary_bolt_thread: FastenerThreadUnread {
    obligation: "Ground the SELECTED hardware option, not the market convention and not the vendor's separately-sold T-nut range. Atomik's 3/8-16 T-nuts are candidate mounting hardware, not proof this hold package uses that stack.",
  },
  primary_bolt_count: 1,
  anti_rotation_fixing_count: 1,
  anti_rotation_fixing_note: "A spinner-screw location is reported. Its position relative to the bolt axis defines +x and is UNMEASURED, so the frame's rotation about z is defined but not numerically placed.",
  mounting_face: HoldMountingFaceUnread {
    obligation: "Confirm the mounting face is a single flat. A contoured back changes both the seating and the bolt's effective grip length, and polyester cracks when tightened against a face that is not flat.",
  },
  local_frame: atomik_bolt_on_frame,
}

// Grasp, with the correction that matters most for a two-handed carry: the page gives a 4-1/2 in
// USABLE INTERNAL WIDTH, which is the room a hand actually gets, and a 1-1/2 in lip. The earlier
// row recorded a 5 in "lip width" from the summary and thereby overstated the grip room.
data atomik_xl_arrow_down_climb_jug_grasp: HoldGraspProfile = HoldGraspProfile {
  kind: Jug,
  usable_internal_width: CatalogLengthReading {
    value: SourceNativeLength { numerator: 9, denominator: 2, unit: Inch },
    evidence: OperatorRelayedDocument {
      authority: atomik_page_relay,
      relay_note: atomik_relayed_evidence_note,
    },
  },
  lip_thickness: CatalogLengthReading {
    value: SourceNativeLength { numerator: 3, denominator: 2, unit: Inch },
    evidence: OperatorRelayedDocument {
      authority: atomik_page_relay,
      relay_note: atomik_relayed_evidence_note,
    },
  },
  incut_note: "A 70-degree incut is reported. That figure describes behaviour on an overhung wall, where the hand pulls outward against the lip. A carried tile loads the hold roughly parallel to the mounting face instead, and the page says nothing about that direction - the incut angle is a reading about a different load case, not a weaker reading about this one.",
}

// Naming, corrected. The two spellings are the page title and a reversed-word-order restatement in
// the same page's own description: one product with a marketing alias. The earlier row recorded
// them as SkuAmbiguous, which asserts two orderable products - a strong claim about the vendor's
// catalog, made from a wording difference. The manufacturer SKU stays unread because no order code
// has been seen, and only an order code can establish one.
data atomik_xl_arrow_down_climb_jug: ClimbingHoldCatalogRow = ClimbingHoldCatalogRow {
  naming: ProductNameStanding {
    canonical_page_title: "XL Arrow-Shaped Down Climb Jug",
    marketing_aliases: ["XL Down Climb Arrow Jug"],
    manufacturer_sku: ProductSkuUnread {
      obligation: "No manufacturer order code has been observed. Capture it from a cart, invoice, or packing list; a page title is not an order code.",
    },
  },
  material: HoldMaterialUnread {
    obligation: "Read the vendor material statement. Polyurethane and polyester differ in exactly the failure modes that matter for a repeatedly re-tightened carrying handle: soft PU lets the bolt pull through, and PE cracks when tightened against a non-flat face.",
  },
  fixation: atomik_xl_arrow_down_climb_jug_fixation,
  source_width: atomik_source_width,
  source_height: atomik_source_height,
  source_projection: atomik_source_projection,
  clearance_envelope: atomik_clearance_envelope,
  grasp: atomik_xl_arrow_down_climb_jug_grasp,
  shape: ShapeArtifactAbsent {
    obligation: "The page gives an envelope and a grasp description, not a mesh or a dimensioned mounting drawing. Request vendor CAD; failing that, buy one sample and produce a calibrated scan. An envelope box may appear in an engineering clearance view when labelled ENVELOPE, and may never stand in for the visible hold body.",
  },
}
