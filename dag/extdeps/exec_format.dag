module extdeps.exec_format

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Comparison_of_executable_file_formats"
  }
}


type ExecutableFormatFamily
  = Elf
  | Pe
  | MachO

type ExecutableFormat {
  family: ExecutableFormatFamily
}

type SegmentPermission {
  readable: Bool
  writable: Bool
  executable: Bool
}

type LoadSegment {
  file_offset: Int
  virtual_address: Int
  file_size: Int
  memory_size: Int
  permissions: SegmentPermission
  alignment: Int
}

type EntryPoint {
  virtual_address: Int
}

type Relocation {
  offset: Int
  symbol_index: Int
  relocation_type: Int
}
