module extdeps.simulators.icarus_verilog.subject


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "steveicarus.github.io/iverilog/"
  }
}

data icarus_verilog_subject_note: String = "ICARUS VERILOG, THE SIMULATOR — a runtime, deliberately not a language target, for the same reason ngspice is not one: it EXECUTES the Verilog medium and is independently governed and versioned, so under external-upstream decomposition it gets its own module rather than becoming an arm of the language. The distinction is the one this repository already drew for SPICE: what we emit and what runs it are separate facts, joined by a runtime binding rather than fused into one subject. IT IS ALSO NOT THE ONLY ONE — Verilator is a second implementation of the same relationship, and adding it must not require editing this file, which is the test of whether the decomposition was real."

type IcarusVerilog
  = | IcarusVerilogSimulator

data icarus_verilog_simulator: IcarusVerilog = IcarusVerilogSimulator

data icarus_verilog_simulator_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.simulators.icarus_verilog.subject",
      decl_name: "icarus_verilog_simulator",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.simulators.icarus_verilog.subject.extdeps_external_authority_anchor,
  further_citations: []
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = icarus_verilog_simulator_model_scope
