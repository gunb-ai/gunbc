module extdeps.prometheus.client

import std.types { NonEmptyStr, String, Int, Bool }
import std.decimal { ExactDecimal, ExactDecimalAdmitted, ExactDecimalScaleRefused, admit_exact_decimal, decimal_pow10 }
import std.checked_arithmetic { checked_int_multiply, CheckedIntReady, CheckedIntOverflow }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.algebra { trim }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

