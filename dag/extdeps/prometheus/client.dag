  uri: Uri {
    scheme: Https
    locator: "github.com/prometheus/client_python/blob/master/prometheus_client/process_collector.py"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.prometheus.client",
      decl_name: "PrometheusProcessSeries",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE PROCESS COLLECTOR IS THE CLIENT LIBRARY'S, NOT THE SERVING ENGINE'S.
//
// Anything exporting through prometheus_client on Linux also exports a small population of series
// about the exporting PROCESS itself, registered by the library rather than by the application. It
// is modelled here and not in extdeps.vllm.metrics for the reason external decomposition already
// fixes: prometheus_client is independently versioned upstream, and a vLLM upgrade does not move
// its rows. A serving engine is one exporter among several this fleet will read.
//
// WHY ONLY ONE SERIES IS HERE. process_start_time_seconds is the one this repository consumes, and
// it is consumed for an unobvious reason: it is the cheapest fact that DISTINGUISHES ONE LAUNCH OF
// A SERVER FROM ITS SUCCESSOR over an ordinary unprivileged HTTP read. The other process series --
// resident memory, cpu seconds, open file descriptors -- have no consumer, so they are not written
// down. Adding one is a row here.
//
// WHAT THE SERIES ESTABLISHES AND WHAT IT DOES NOT, because the gap is where a reader would build a
// wrong join. It is the exporting process's start time, in seconds since the epoch, as the kernel
// reports it. Two readings that differ establish that the process was REPLACED between them, which
// is what makes it usable as launch discrimination. Two readings that agree establish only that the
// same process is answering: they say nothing about what that process loaded, which image it was
// created from, or whether its model weights changed underneath it. It is a discriminator, never a
// provenance.
type PrometheusProcessSeries
  = | ProcessStartTimeSeconds

// THE SERIES IS EXPORTED WITHOUT LABELS, so its exposition line carries no brace section and a
// reader that finds a metric by matching `name{` will not find it. Stated here because the
// serving gauges beside it DO carry labels, so one reader over one body meets both shapes.
fn prometheus_process_series_name(s: PrometheusProcessSeries) -> NonEmptyStr {
  match s {
    ProcessStartTimeSeconds => "process_start_time_seconds" as NonEmptyStr
  }
}

data prometheus_client_float_rendering_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/prometheus/client_python/blob/master/prometheus_client/utils.py"
  }
}

// HOW THE CLIENT RENDERS A SAMPLE VALUE, AND WHY A CONSUMER MUST READ IT EXACTLY. client_python
// exposes every sample through floatToGoString: a finite value is rendered by Python's repr -- the
// shortest decimal that round-trips to the same IEEE-754 double -- and, when the integer part has
// more than six digits, re-spelled in Go's exponent form, `d.ddd...e+0N`, with trailing zeros
// stripped from the mantissa. So process_start_time_seconds arrives as `1.78934488391e+09` and
// denotes exactly 1789344883.91: a decimal with twelve significant digits, never a rounded or
// truncated reading. The value the collector computed was boot time plus starttime divided by the
// clock tick rate, in double arithmetic; at epoch magnitudes a double resolves about 2.4e-7 s, so
// a tick of 1/100 s survives the rendering intact and repr reproduces the tick-grained decimal.
//
// A consumer that parses this into a float and compares within an epsilon has thrown away the one
// property that makes the field usable as an identity: two readings are of the same launch exactly
// when their decimals are equal. So the reading is an ExactDecimal, and the exponent form is folded
// into the scale rather than refused -- the exclusion extdeps.languages.json.number makes for JSON
// does not apply here, because this exponent is bounded by the renderer (it is the digit count of
// the integer part) and cannot name a magnitude the mantissa did not carry.
type PrometheusSampleValueReading
  = SampleValueExact { value: ExactDecimal }
  | SampleValueNotFinite { lexeme: String }
  | SampleValueUnreadable { lexeme: String }

data prometheus_positive_infinity_lexeme: String = "+Inf"
data prometheus_negative_infinity_lexeme: String = "-Inf"
data prometheus_nan_lexeme: String = "NaN"

type SampleLexemeScan {
  mantissa_digits: String
  fraction_digits: Int
  exponent_text: String
  exponent_sign_negative: Bool
  in_fraction: Bool
  in_exponent: Bool
  ok: Bool
}

fn prometheus_is_digit(ch: String) -> Bool {
  let cp = code_point(ch: ch)
  cp >= 48 && cp <= 57
}

fn prometheus_scan_step(acc: SampleLexemeScan, ch: String) -> SampleLexemeScan {
  if !acc.ok {
    acc
  } else if acc.in_exponent {
    if prometheus_is_digit(ch: ch) {
      SampleLexemeScan { mantissa_digits: acc.mantissa_digits, fraction_digits: acc.fraction_digits, exponent_text: concat(acc.exponent_text, ch), exponent_sign_negative: acc.exponent_sign_negative, in_fraction: acc.in_fraction, in_exponent: true, ok: true }
    } else if acc.exponent_text == "" && (ch == "+" || ch == "-") {
      SampleLexemeScan { mantissa_digits: acc.mantissa_digits, fraction_digits: acc.fraction_digits, exponent_text: "", exponent_sign_negative: ch == "-", in_fraction: acc.in_fraction, in_exponent: true, ok: true }
    } else {
      SampleLexemeScan { mantissa_digits: acc.mantissa_digits, fraction_digits: acc.fraction_digits, exponent_text: acc.exponent_text, exponent_sign_negative: acc.exponent_sign_negative, in_fraction: acc.in_fraction, in_exponent: true, ok: false }
    }
  } else if ch == "e" || ch == "E" {
    SampleLexemeScan { mantissa_digits: acc.mantissa_digits, fraction_digits: acc.fraction_digits, exponent_text: "", exponent_sign_negative: false, in_fraction: acc.in_fraction, in_exponent: true, ok: acc.mantissa_digits != "" }
  } else if ch == "." {
    if acc.in_fraction {
      SampleLexemeScan { mantissa_digits: acc.mantissa_digits, fraction_digits: acc.fraction_digits, exponent_text: "", exponent_sign_negative: false, in_fraction: true, in_exponent: false, ok: false }
    } else {
      SampleLexemeScan { mantissa_digits: acc.mantissa_digits, fraction_digits: 0, exponent_text: "", exponent_sign_negative: false, in_fraction: true, in_exponent: false, ok: true }
    }
  } else if prometheus_is_digit(ch: ch) {
    SampleLexemeScan { mantissa_digits: concat(acc.mantissa_digits, ch), fraction_digits: if acc.in_fraction { acc.fraction_digits + 1 } else { 0 }, exponent_text: "", exponent_sign_negative: false, in_fraction: acc.in_fraction, in_exponent: false, ok: true }
  } else {
    SampleLexemeScan { mantissa_digits: acc.mantissa_digits, fraction_digits: acc.fraction_digits, exponent_text: "", exponent_sign_negative: false, in_fraction: acc.in_fraction, in_exponent: false, ok: false }
  }
}

fn prometheus_scan_lexeme(body: String) -> SampleLexemeScan {
  fold(chars(body), init: SampleLexemeScan { mantissa_digits: "", fraction_digits: 0, exponent_text: "", exponent_sign_negative: false, in_fraction: false, in_exponent: false, ok: true }, f: (acc, cp) =>
    prometheus_scan_step(acc: acc, ch: from_code_point(cp: cp)))
}

// The scale after the exponent is folded in: fraction digits minus the exponent. A non-negative
// result is the ExactDecimal scale directly; a negative one means the mantissa must be multiplied
// out, which decimal_pow10 does exactly, and the scale becomes zero.
fn prometheus_exact_from_scan(lexeme: String, negative: Bool, scan: SampleLexemeScan) -> PrometheusSampleValueReading {
  if !scan.ok || scan.mantissa_digits == "" || (scan.in_exponent && scan.exponent_text == "") {
    SampleValueUnreadable { lexeme: lexeme }
  } else {
    match parse_int(s: scan.mantissa_digits) {
      Absent => SampleValueUnreadable { lexeme: lexeme }
      Present { value: magnitude } => {
        let exponent = if scan.in_exponent {
          match parse_int(s: scan.exponent_text) {
            Absent => 0 - 1
            Present { value: e } => if scan.exponent_sign_negative { 0 - e } else { e }
          }
        } else { 0 }
        let scale = scan.fraction_digits - exponent
        let units = if negative { 0 - magnitude } else { magnitude }
        if scan.in_exponent && scan.exponent_text != "" && exponent == 0 - 1 && scan.exponent_text != "1" && !scan.exponent_sign_negative {
          SampleValueUnreadable { lexeme: lexeme }
        } else if scale < 0 {
          match admit_exact_decimal(units: units * decimal_pow10(exponent: 0 - scale), fraction_digits: 0) {
            ExactDecimalAdmitted { canonical } => SampleValueExact { value: canonical }
            ExactDecimalScaleRefused { observed_fraction_digits: _ } => SampleValueUnreadable { lexeme: lexeme }
          }
        } else {
          match admit_exact_decimal(units: units, fraction_digits: scale) {
            ExactDecimalAdmitted { canonical } => SampleValueExact { value: canonical }
            ExactDecimalScaleRefused { observed_fraction_digits: _ } => SampleValueUnreadable { lexeme: lexeme }
          }
        }
      }
    }
  }
}

fn prometheus_sample_value_reading(field: String) -> PrometheusSampleValueReading {
  let lexeme = trim(s: field)
  if lexeme == prometheus_positive_infinity_lexeme || lexeme == prometheus_negative_infinity_lexeme || lexeme == prometheus_nan_lexeme {
    SampleValueNotFinite { lexeme: lexeme }
  } else {
    let negative = starts_with(s: lexeme, prefix: "-")
    let body = if negative || starts_with(s: lexeme, prefix: "+") { substring(s: lexeme, start: 1, end: string_length(lexeme)) } else { lexeme }
    prometheus_exact_from_scan(lexeme: lexeme, negative: negative, scan: prometheus_scan_lexeme(body: body))
  }
}
