module extdeps.python


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.python.org/3/using/cmdline.html"
  }
}

service python.Interpreter {
  operation RunFile {
    input { workdir: std.types.FilePath, script_path: std.types.FilePath, args: List<String> = [] }
    output {
      success: Bool from "exit_success"
      exit_code: Int from "exit_code"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["env", "-C", "{workdir}", "python3", "{script_path}", args] }
    exit {
      0 => Unit
      nonzero => String "python3 script exited nonzero"
    }
  }
}
