module extdeps.cloudflare.client_v4

import std.types { NonEmptyStr, String, Int, Secret }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developers.cloudflare.com/fundamentals/api"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cloudflare.client_v4",
      decl_name: "cloudflare_client_v4_base",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE SUBJECT IS THE CLIENT/V4 HTTP API, not Cloudflare the company and not any one product
// (R2, Workers, DNS). Those are independently versioned products that speak this envelope.
data cloudflare_client_v4_base: NonEmptyStr = "https://api.cloudflare.com/client/v4"

data cloudflare_client_v4_edition: NonEmptyStr = "v4"

data bearer_authorization_scheme: NonEmptyStr = "Bearer"

fn cloudflare_bearer_authorization_header_value(token: Secret) -> String {
  join([bearer_authorization_scheme as String, " ", token as String], "")
}

type CloudflareApiError {
  code: Int
  message: String
}
