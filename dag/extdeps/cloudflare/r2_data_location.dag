// EACH ROW CARRIES THE DOCUMENT, THE DATE IT WAS READ, AND THE SENTENCE IT WAS READ FOR. The
// statement field is a TRANSCRIPTION of upstream's own words, not commentary about them. A reading
// is dated and never silently refreshed: upstream edits a page without telling anyone, so a
// statement that no longer appears at its URI is a NEW reading with a later date.
type CloudflarePublishedReading {
  authority: ExternalAuthority
  read_on: NonEmptyStr
  statement: NonEmptyStr
}

data r2_data_location_reading: CloudflarePublishedReading = CloudflarePublishedReading {
  authority: extdeps_external_authority_anchor,
  read_on: "2026-09-12",
  statement: "When you create a new bucket, the data location is set to Automatic by default. Currently, this option chooses a bucket location in the closest available region to the create bucket request based on the location of the caller. Location Hints are optional parameters you can provide during bucket creation to indicate the primary geographical location you expect data will be accessed from. Location Hints are a best effort and not a guarantee, and they should only be used as a way to optimize performance. Available hints: wnam Western North America, enam Eastern North America, weur Western Europe, eeur Eastern Europe, apac Asia-Pacific, oc Oceania. Jurisdictional Restrictions guarantee objects in a bucket are stored within a specific jurisdiction. Use Jurisdictional Restrictions when you need to ensure data is stored and processed within a jurisdiction to meet data residency requirements. Available jurisdictions: eu European Union, fedramp FedRAMP, us United States. Once an R2 bucket is created, the jurisdiction cannot be changed. Page last updated Aug 19, 2026.",
}

data r2_how_r2_works_reading: CloudflarePublishedReading = CloudflarePublishedReading {
  authority: r2_how_r2_works_authority,
  read_on: "2026-09-12",
  statement: "R2 Gateway: The entry point for all API requests that handles authentication and routing logic. This service is deployed across Cloudflare's global network via Cloudflare Workers. Metadata Service: A distributed layer built on Durable Objects used to store and manage object metadata. Distributed Storage Infrastructure: The underlying infrastructure that persistently stores encrypted object data. On write, the Gateway determines which storage cluster to write the encrypted data to within the location set for the bucket. The encrypted data is written and stored in the distributed storage infrastructure, and replicated within the region (e.g. ENAM) for durability. On read, if the object is not in the tiered read cache, it retrieves the object from one of the distributed storage data centers within the region that holds the object data. Page last updated Apr 21, 2026.",
}

data r2_us_jurisdiction_changelog_reading: CloudflarePublishedReading = CloudflarePublishedReading {
  authority: r2_us_jurisdiction_changelog_authority,
  read_on: "2026-09-12",
  statement: "New us jurisdiction for R2. R2 now supports a us jurisdiction, which guarantees that bucket data is stored and processed within the United States. Use this jurisdiction when you need explicit US data residency guarantees. Use the jurisdiction-specific S3 endpoint https://<ACCOUNT_ID>.us.r2.cloudflarestorage.com. Once an R2 bucket is created, its jurisdiction cannot be changed. Posted 2026-08-17.",
}

data r2_tokens_default_jurisdiction_reading: CloudflarePublishedReading = CloudflarePublishedReading {
  authority: r2_tokens_jurisdiction_default_authority,
  read_on: "2026-09-12",
  statement: "A specific bucket is represented as com.cloudflare.edge.r2.bucket.<ACCOUNT_ID>_<JURISDICTION>_<BUCKET_NAME>. JURISDICTION: The jurisdiction where the R2 bucket lives. For buckets not created in a specific jurisdiction this value will be default.",
}

data cloudflare_subprocessors_reading: CloudflarePublishedReading = CloudflarePublishedReading {
  authority: cloudflare_subprocessors_authority,
  read_on: "2026-09-12",
  statement: "Last Updated: October 1, 2025. Cloudflare uses a handful of sub-processors to support the Cloudflare service. Some of these sub-processors are members of the Cloudflare Group (Cloudflare, Inc. and its subsidiaries) and some are third parties. Third-party entities include Slack Technologies, Inc. (Customer support communications, United States); Zendesk, Inc. (Customer support and account management, United States, the European Economic Area, Japan, and Australia); Salesforce, Inc. (Customer support and account management, United States); Google LLC (Cloudflare Developer Platform, Cloudflare Zero Trust and AI Gateway; European Economic Area, United States, Australia, India); Oracle America, Inc. (Cloudflare Developer Platform and Cache Reserve; United States, European Economic Area, UK, Japan, Australia, Canada, Singapore); Amazon Web Services (Cloudflare Email Security; United States, European Economic Area); CoreWeave, Inc., Nebius BV (Workers AI); Anthropic PBC, OpenAI, Inc., X.AI Corp., Groq, Inc. (AI Gateway). The page lists Cloudflare Group subsidiaries by location and does not key any row to a named R2 bucket or to the default jurisdiction.",
}

data cloudflare_customer_dpa_reading: CloudflarePublishedReading = CloudflarePublishedReading {
  authority: cloudflare_customer_dpa_authority,
  read_on: "2026-09-12",
  statement: "Cloudflare, Inc. Data Processing Addendum, Version 6.4 April 3, 2026. The Customer grants a general written authorization: (a) to Cloudflare to appoint other members of the Cloudflare Group as sub-Processors, and (b) to Cloudflare and other members of the Cloudflare Group to appoint third party data center operators, and business, engineering and customer support providers as sub-Processors to support the performance of the Service. Cloudflare will maintain a list of sub-Processors at https://www.cloudflare.com/gdpr/subprocessors/. This DPA and any action related thereto shall be governed by and construed in accordance with the laws as specified in the Main Agreement, and the parties consent to the personal jurisdiction of, and venue in, the courts specified in the Main Agreement.",
}

// THE LEGAL ENTITY THE DOCUMENTS NAME. A route's operator slot needs a party. The legal name is
// the same spelling already declared as extdeps.vendor.cloudflare cloudflare; the address is
// transcribed from the data-location page's publisher Organization on the same read date.
type CloudflareLegalEntity {
  legal_name: NonEmptyStr
  registered_address: NonEmptyStr
  country: NonEmptyStr
  reading: CloudflarePublishedReading
}

data cloudflare_inc: CloudflareLegalEntity = CloudflareLegalEntity {
  legal_name: "Cloudflare, Inc.",
  registered_address: "101 Townsend St, San Francisco, CA 94107, US",
  country: "United States",
  reading: r2_data_location_reading,
}

// LOCATION HINTS ARE A CLOSED COPRODUCT OF CHOICES, NOT A ROSTER OF PLACES THE BYTES ARE.
// Upstream names them hints, says they are a best effort and not a guarantee, and uses them to
// optimize performance. The tag set lives here because extdeps.cloudflare.r2 does not declare it;
// the wire spelling is produced from the coproduct rather than stored as a second stringly name.
type R2LocationHint
  = R2HintWnam
  | R2HintEnam
  | R2HintWeur
  | R2HintEeur
  | R2HintApac
  | R2HintOc

fn r2_location_hint_wire(hint: R2LocationHint) -> String {
  match hint {
    R2HintWnam => "wnam"
    R2HintEnam => "enam"
    R2HintWeur => "weur"
    R2HintEeur => "eeur"
    R2HintApac => "apac"
    R2HintOc => "oc"
  }
}

fn r2_location_hint_is_residency_guarantee(hint: R2LocationHint) -> Bool {
  match hint {
    R2HintWnam => false
    R2HintEnam => false
    R2HintWeur => false
    R2HintEeur => false
    R2HintApac => false
    R2HintOc => false
  }
}

type R2LocationHintRow {
  hint: R2LocationHint
  description: NonEmptyStr
  reading: CloudflarePublishedReading
}

data r2_hint_wnam: R2LocationHintRow = R2LocationHintRow {
  hint: R2HintWnam,
  description: "Western North America",
  reading: r2_data_location_reading,
}

data r2_hint_enam: R2LocationHintRow = R2LocationHintRow {
  hint: R2HintEnam,
  description: "Eastern North America",
  reading: r2_data_location_reading,
}

data r2_hint_weur: R2LocationHintRow = R2LocationHintRow {
  hint: R2HintWeur,
  description: "Western Europe",
  reading: r2_data_location_reading,
}

data r2_hint_eeur: R2LocationHintRow = R2LocationHintRow {
  hint: R2HintEeur,
  description: "Eastern Europe",
  reading: r2_data_location_reading,
}

data r2_hint_apac: R2LocationHintRow = R2LocationHintRow {
  hint: R2HintApac,
  description: "Asia-Pacific",
  reading: r2_data_location_reading,
}

data r2_hint_oc: R2LocationHintRow = R2LocationHintRow {
  hint: R2HintOc,
  description: "Oceania",
  reading: r2_data_location_reading,
}

// JURISDICTIONAL RESTRICTIONS CITE extdeps.cloudflare.r2 R2Jurisdiction, WHICH IS THE CONSUMED
// AUTHORITY FOR THE FOUR WIRE VALUES. Re-spelling them as NonEmptyStr here would be a second name
// for one concept (DESIGN section 3). Default is in that coproduct and is NOT a restriction;
// the guarantee is derived by matching the existing type, so a fifth arm fails to compile rather
// than silently inheriting a string.
fn r2_jurisdiction_is_residency_guarantee(jurisdiction: R2Jurisdiction) -> Bool {
  match jurisdiction {
    R2JurisdictionDefault => false
    R2JurisdictionEu => true
    R2JurisdictionFedramp => true
    R2JurisdictionUs => true
  }
}

type R2JurisdictionRestrictionRow {
  jurisdiction: R2Jurisdiction
  reading: CloudflarePublishedReading
}

data r2_jurisdiction_eu: R2JurisdictionRestrictionRow = R2JurisdictionRestrictionRow {
  jurisdiction: R2JurisdictionEu,
  reading: r2_data_location_reading,
}

data r2_jurisdiction_fedramp: R2JurisdictionRestrictionRow = R2JurisdictionRestrictionRow {
  jurisdiction: R2JurisdictionFedramp,
  reading: r2_data_location_reading,
}

data r2_jurisdiction_us: R2JurisdictionRestrictionRow = R2JurisdictionRestrictionRow {
  jurisdiction: R2JurisdictionUs,
  reading: r2_us_jurisdiction_changelog_reading,
}

data r2_jurisdiction_default_standing: R2JurisdictionRestrictionRow = R2JurisdictionRestrictionRow {
  jurisdiction: R2JurisdictionDefault,
  reading: r2_tokens_default_jurisdiction_reading,
}

// AUTOMATIC IS A CHOICE MECHANISM, AND THAT IS WHAT THIS ROW RECORDS. It is the region a route
// cites when a bucket was created without a jurisdictional restriction: not a country, not a
// data-center park, and not a residency commitment. Treating R2JurisdictionDefault, a dashboard
// Location label, or a Location Hint as the place the bytes live is the reading this row exists
// to make unusable as a location fact. Automatic is not an arm of R2Jurisdiction — that type's
// corresponding non-guarantee is R2JurisdictionDefault, cited above.
type R2PlacementModeRow {
  reading: CloudflarePublishedReading
}

data r2_placement_automatic: R2PlacementModeRow = R2PlacementModeRow {
  reading: r2_data_location_reading,
}
