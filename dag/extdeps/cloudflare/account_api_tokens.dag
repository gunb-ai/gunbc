  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.cloudflare.account_api_tokens", decl_name: "create_account_token_api_as_of"),
    reason: "as-of pin has no reader; ExternalAuthority has no as-of field",
    dissolution: unbound_dissolution(
      description: "dissolves when ExternalAuthority or FactCitation carries an as-of date and this pin inhabits that field, or a gunbc executing fold reads create_account_token_api_as_of as the cited document date"
    )
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.cloudflare.account_api_tokens", decl_name: "account_owned_tokens_doc_as_of"),
    reason: "as-of pin has no reader; ExternalAuthority has no as-of field",
    dissolution: unbound_dissolution(
      description: "dissolves when ExternalAuthority or FactCitation carries an as-of date and this pin inhabits that field, or a gunbc executing fold reads account_owned_tokens_doc_as_of as the cited document date"
    )
  )
]

type AccountTokenMintRoute
  = HumanDashboardOnly
  | AccountTokensCreateApi

fn account_token_mint_route(shape: CloudflareAccountTokenShape) -> AccountTokenMintRoute {
  match shape.acquisition {
    HumanDashboardAcquired => HumanDashboardOnly
    CreatedViaAccountTokensApi => AccountTokensCreateApi
  }
}

fn permission_groups_from_grants(
  grants: List<CloudflarePermissionGrant>
) -> List<PermissionGroupRef> {
  flat_map(grants, g => match g {
    PermissionGroupGrant { group: grp } => [grp]
    AccountApiTokensWrite => []
  })
}

fn permission_groups_from_policies(
  policies: List<AccountTokenPolicy>
) -> List<PermissionGroupRef> {
  flat_map(policies, p => p.permission_groups)
}

fn permission_group_ids_agree(
  left: List<PermissionGroupRef>,
  right: List<PermissionGroupRef>
) -> Bool {
  all(left, l => any(right, r => r.id == l.id))
    && all(right, r => any(left, l => l.id == r.id))
}

fn mint_grant_policy_permission_groups_agree(
  shape: CloudflareAccountTokenShape,
  request: CreateAccountTokenRequest
) -> Bool {
  permission_group_ids_agree(
    left: permission_groups_from_grants(grants: shape.grants),
    right: permission_groups_from_policies(policies: request.policies)
  )
}

fn mint_lifetime_agrees(
  shape: CloudflareAccountTokenShape,
  request: CreateAccountTokenRequest
) -> Bool {
  match shape.lifetime {
    NoExpiryUntilRevoked => request.expires_on == none
    OptionalTokenExpiry { expires_on: t } =>
      match request.expires_on {
        Present { value: e } => e == t
        none => false
      }
  }
}

type AccountTokenApiMintStanding
  = AccountTokenApiMintAdmitted {
      shape: CloudflareAccountTokenShape
      request: CreateAccountTokenRequest
    }
  | AccountTokenApiMintRefusedHumanDashboardOnly { shape: CloudflareAccountTokenShape }
  | AccountTokenApiMintRefusedGrantPolicyMismatch {
      shape: CloudflareAccountTokenShape
      request: CreateAccountTokenRequest
    }
  | AccountTokenApiMintRefusedLifetimeMismatch {
      shape: CloudflareAccountTokenShape
      request: CreateAccountTokenRequest
    }

fn admit_account_token_api_mint(
  shape: CloudflareAccountTokenShape,
  request: CreateAccountTokenRequest
) -> AccountTokenApiMintStanding {
  match account_token_mint_route(shape: shape) {
    AccountTokensCreateApi =>
      if !mint_grant_policy_permission_groups_agree(shape: shape, request: request) {
        AccountTokenApiMintRefusedGrantPolicyMismatch { shape: shape, request: request }
      } else {
        if !mint_lifetime_agrees(shape: shape, request: request) {
          AccountTokenApiMintRefusedLifetimeMismatch { shape: shape, request: request }
        } else {
          AccountTokenApiMintAdmitted { shape: shape, request: request }
        }
      }
    HumanDashboardOnly =>
      AccountTokenApiMintRefusedHumanDashboardOnly { shape: shape }
  }
}

service cloudflare.AccountTokens {
  config {
    endpoint: cloudflare_client_v4_base
    auth: Bearer
    auth_input: auth_token
  }

  operation ListPermissionGroupsRaw {
    input {
      auth_token: Secret
      account_id: String
    }
    output {
      body: String from "body"
    }
    readonly
    transport rest {
      method: GET,
      path: "/accounts/\{account_id\}/tokens/permission_groups"
    }
    response {
      200 => String
      401 => CloudflareApiError
      403 => CloudflareApiError
      5xx => CloudflareApiError
    }
  }

  operation Create {
    input {
      auth_token: Secret
      account_id: String
      name: String
      policies: List<AccountTokenPolicy>
      not_before: Timestamp?
      expires_on: Timestamp?
    }
    output {
      id: NonEmptyStr from "result.id"
      value: Secret from "result.value"
      name: String from "result.name"
      status: String from "result.status"
      expires_on: Timestamp? from "result.expires_on"
      not_before: Timestamp? from "result.not_before"
    }
    transport rest {
      method: POST,
      path: "/accounts/\{account_id\}/tokens",
      body: {
        name: name,
        policies: account_token_policies_create_wire(policies: policies),
        not_before: not_before,
        expires_on: expires_on
      }
    }
    response {
      200 => CreatedAccountTokenCreateResponse
      401 => CloudflareApiError
      403 => CloudflareApiError
      422 => CloudflareApiError
      5xx => CloudflareApiError
    }
  }
}
