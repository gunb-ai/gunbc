// ACCOUNT-OWNED TOKENS ARE SERVICE PRINCIPALS. They do not inherit a user's permissions and stay
// valid after the configuring user leaves. Creating or updating one in the dashboard requires Super
// Administrator on the account (account-owned-tokens citation). Creating via API requires the
// Account API Tokens Write permission on the calling token (create-token API citation).
//
// SHAPE, NOT A BOOL. The GitHub org-admin pattern (extdeps.github.org_admin_auth OrgAdminCredentialShape)
// is kind × grants × acquisition × lifetime × revocation. Cloudflare's arms are Cloudflare's; they
// are not GitHub's HumanWebAcquired / ProgrammaticallyMintedFromGitHubAppKey.
data account_api_tokens_write_permission_name: NonEmptyStr = "Account API Tokens Write"

data account_token_value_prefix: NonEmptyStr = "cfat_"
data user_token_value_prefix: NonEmptyStr = "cfut_"
data global_api_key_value_prefix: NonEmptyStr = "cfk_"

type PermissionGroupRef {
  id: NonEmptyStr
}

type CloudflareCredentialKind
  = AccountOwnedApiToken
  | UserOwnedApiToken
  | GlobalApiKey

type CloudflarePermissionGrant
  = AccountApiTokensWrite
  | PermissionGroupGrant { group: PermissionGroupRef }

type CloudflareCredentialAcquisition
  = HumanDashboardAcquired
  | CreatedViaAccountTokensApi

type CloudflareCredentialLifetime
  = NoExpiryUntilRevoked
  | OptionalTokenExpiry { expires_on: Timestamp }

type CloudflareCredentialRevocation
  = AccountApiTokensSurface
  | UserApiTokensSurface
  | GlobalApiKeySurface

type CloudflareAccountTokenShape {
  kind: CloudflareCredentialKind
  grants: List<CloudflarePermissionGrant>
  acquisition: CloudflareCredentialAcquisition
  lifetime: CloudflareCredentialLifetime
  revocation: CloudflareCredentialRevocation
}

type CloudflareCredentialFormat
  = ScannableAccountApiToken
  | ScannableUserApiToken
  | ScannableGlobalApiKey
  | Pre2026Unprefixed

fn classify_cloudflare_credential_format(value: String) -> CloudflareCredentialFormat {
  if starts_with(s: value, prefix: account_token_value_prefix as String) {
    ScannableAccountApiToken
  } else {
    if starts_with(s: value, prefix: user_token_value_prefix as String) {
      ScannableUserApiToken
    } else {
      if starts_with(s: value, prefix: global_api_key_value_prefix as String) {
        ScannableGlobalApiKey
      } else {
        Pre2026Unprefixed
      }
    }
  }
}

type AccountTokenStatus
  = TokenActive
  | TokenDisabled
  | TokenExpired

fn parse_account_token_status(raw: String) -> AccountTokenStatus? {
  if raw == "active" {
    Present { value: TokenActive }
  } else {
    if raw == "disabled" {
      Present { value: TokenDisabled }
    } else {
      if raw == "expired" {
        Present { value: TokenExpired }
      } else {
        none
      }
    }
  }
}

type TokenPolicyEffect
  = PolicyAllow
  | PolicyDeny

fn token_policy_effect_wire(effect: TokenPolicyEffect) -> String {
  match effect {
    PolicyAllow => "allow"
    PolicyDeny => "deny"
  }
}

type AccountTokenPolicy {
  effect: TokenPolicyEffect
  permission_groups: List<PermissionGroupRef>
  resources: Map<String, String>
}

type AccountTokenPolicyCreateWire {
  effect: String
  permission_groups: List<PermissionGroupRef>
  resources: Map<String, String>
}

fn account_token_policy_create_wire(policy: AccountTokenPolicy) -> AccountTokenPolicyCreateWire {
  AccountTokenPolicyCreateWire {
    effect: token_policy_effect_wire(effect: policy.effect),
    permission_groups: policy.permission_groups,
    resources: policy.resources
  }
}

fn account_token_policies_create_wire(
  policies: List<AccountTokenPolicy>
) -> List<AccountTokenPolicyCreateWire> {
  map(policies, p => account_token_policy_create_wire(policy: p))
}

type CreateAccountTokenRequest {
  name: String
  policies: List<AccountTokenPolicy>
  not_before: Timestamp?
  expires_on: Timestamp?
}

// THE TOKEN SECRET IS RETURNED ON CREATE AND NEVER AGAIN. A later GET of the same token id has
// metadata only. Modeling value as optional on one type would let a caller treat a list-response
// row as a create-response and mint R2 S3 secrets from nothing.
type CreatedAccountToken {
  id: NonEmptyStr
  name: String
  status: AccountTokenStatus
  value: Secret
  expires_on: Timestamp?
  not_before: Timestamp?
}

type CreatedAccountTokenCreateResponse {
  id: NonEmptyStr
  name: String
  status: String
  value: Secret
  expires_on: Timestamp?
  not_before: Timestamp?
}

fn created_account_token_from_create_response(
  response: CreatedAccountTokenCreateResponse
) -> CreatedAccountToken? {
  match parse_account_token_status(raw: response.status) {
    Present { value: status } =>
      Present {
        value: CreatedAccountToken {
          id: response.id,
          name: response.name,
          status: status,
          value: response.value,
          expires_on: response.expires_on,
          not_before: response.not_before
        }
      }
    none => none
  }
}

type AccountTokenMetadata {
  id: NonEmptyStr
  name: String
  status: AccountTokenStatus
  expires_on: Timestamp?
  not_before: Timestamp?
}

