  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.cloudflare.account_api_tokens", decl_name: "AccountTokenMetadata"),
    reason: "list/get response shape has no executing consumer; Create returns CreatedAccountToken",
    dissolution: unbound_dissolution(
      description: "dissolves when a gunbc declaration consumes AccountTokenMetadata as the list or get response on an executing converge or gunbc-run entry; a witness that the type exists does not fire this"
    )
  ),
  frontier_row_path(
    path: "extdeps.cloudflare.account_api_tokens.ListPermissionGroupsRaw",
    reason: "ListPermissionGroupsRaw has no executing caller in this change",
    dissolution: unbound_dissolution(
      description: "dissolves when a gunbc declaration invokes cloudflare.AccountTokens.ListPermissionGroupsRaw on an executing converge or gunbc-run entry; a witness that the operation exists does not fire this"
    )
  ),
  frontier_row_decl(
