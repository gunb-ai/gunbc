  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.cloudflare.account_api_tokens", decl_name: "account_owned_tokens_doc_as_of"),
    reason: "as-of pin has no reader; ExternalAuthority has no as-of field",
    dissolution: unbound_dissolution(
