// THE READINGS ARE ONE CLOSURE. product.supplier.cloudflare_r2 hashes these lists (and
// r2_tokens_doc_as_of) into ProviderRouteFacts.facts_revision, so a changed transcription would
// be a different facts row rather than a silent edit behind a pinned string. That hash is not
// a production consumer of the pin: no origin ProviderRoute is minted, so the as-of frontier
// row remains. Automatic placement is recorded IN r2_data_location_reading; it is not a second
// model-scope subject and not a value of ProviderRoute.region.
fn r2_published_location_readings() -> List<NonEmptyStr> {
  [
    r2_data_location_reading,
    r2_how_r2_works_reading,
    r2_us_jurisdiction_changelog_reading,
    r2_tokens_default_jurisdiction_reading,
    r2_create_bucket_location_hint_reading,
    r2_get_bucket_location_reading,
  ]
}

fn r2_published_location_citations() -> List<FactCitation> {
  [
    r2_data_location_citation,
    r2_how_r2_works_citation,
    r2_us_jurisdiction_changelog_citation,
    r2_tokens_default_jurisdiction_citation,
    r2_create_bucket_location_hint_citation,
    r2_get_bucket_location_citation,
