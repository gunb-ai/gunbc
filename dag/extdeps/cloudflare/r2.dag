module extdeps.cloudflare.r2

import std.types { NonEmptyStr, String, List, Timestamp, Map }
import std.decl_ref { DeclarationRef, WholeDeclaration, NamedField, decl_ref }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, FactCitation }
import extdeps.uri { Uri, Https }
import extdeps.cloudflare.account_api_tokens {
  CreatedAccountToken,
  AccountTokenPolicy,
  PermissionGroupRef,
  PermissionGroupGrant,
  PolicyAllow,
  CreateAccountTokenRequest,
  CloudflarePermissionGrant,
  permission_groups_from_grants
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developers.cloudflare.com/r2/api/tokens"
  }
}

data r2_s3_api_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "developers.cloudflare.com/r2/api/s3/api"
  }
}

data r2_tokens_doc_as_of: Timestamp = "2026-08-18"

// THE READ ID IS THE ONE PERMISSION GROUP ID THIS MODULE PINS, AND THE WRITE ID IS DELIBERATELY NOT
// A SECOND ONE. The write half -- Cloudflare names the groups "Workers R2 Storage Read" and "Workers
// R2 Storage Edit" on its public permission reference -- has no id here: THAT PAGE PUBLISHES NO IDS
// (retrieved 2026-09-10), so there is no doc citation to make, and an uncited id would be worse than
// an absent one because it would be indistinguishable from a checked fact at every later reading.
// r2_object_write_grant below therefore takes the write group AS A PARAMETER, and the observing
// layer supplies it.
//
// IT IS RESOLVED BY OBSERVATION, AND THE OPERATION THAT RESOLVES IT IS ALREADY MODELED.
// cloudflare.AccountTokens.ListPermissionGroupsRaw answers GET
// /accounts/{account_id}/tokens/permission_groups, and its response rows carry both "id" and "name"
// (developers.cloudflare.com/api/resources/accounts/subresources/tokens/subresources/permission_groups/methods/list,
// retrieved 2026-09-10 -- the modeled path was checked against that document and agrees with it).
// So the write grant lands as an OBSERVATION recorded with its retrieval date, in the observing
// workflow layer, never as a doc-cited fact authored here.
//
// A THIRD ID IS IN CIRCULATION AND IS NOT WRITTEN DOWN ANYWHERE IN THIS TREE ON PURPOSE. The
// operator's existing account token carries permission group 5bc3f8b21c554832afc660159ab75fa4, which
// is NOT the read id below and is not identified by any published document. Until the listing above
// is performed, nobody can say whether it is a read grant, a write grant, or the Account API Tokens
// Write grant the mint model expects of a bootstrap token -- and reshaping the model to whichever
// answer would make the plan work is the fabrication this note exists to prevent.
//
// THE SCOPE AXIS IS A SECOND, INDEPENDENT GAP. r2_bucket_item_resources builds a BUCKET-scoped
// resource map; that operator token grants at ACCOUNT scope ("com.cloudflare.api.account.<id>": "*"),
// which r2_account_resource_name can already spell and which no policy builder here consumes. Those
// are materially different grants -- one names a bucket, the other names everything in the account --
// and the difference is recorded rather than smoothed into the bucket-scoped builder.
data workers_r2_storage_bucket_item_read_permission_group_id: NonEmptyStr = "6a018a9f2fc74eb6b293b0c548f38b39"

data r2_s3_access_key_is_created_token_id_citation: FactCitation = FactCitation {
  fact: DeclarationRef {
    module_path: "extdeps.cloudflare.r2",
    decl_name: "R2S3AccessPair",
    field: NamedField { field_name: "access_key_id" }
  },
  authority: extdeps_external_authority_anchor
}

data r2_s3_secret_is_sha256_of_create_value_citation: FactCitation = FactCitation {
  fact: DeclarationRef {
    module_path: "extdeps.cloudflare.r2",
    decl_name: "R2S3AccessPair",
    field: NamedField { field_name: "secret_derivation" }
  },
  authority: extdeps_external_authority_anchor
}

data workers_r2_storage_bucket_item_read_permission_group_id_citation: FactCitation = FactCitation {
  fact: DeclarationRef {
    module_path: "extdeps.cloudflare.r2",
    decl_name: "workers_r2_storage_bucket_item_read_permission_group_id",
    field: WholeDeclaration
  },
  authority: extdeps_external_authority_anchor
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cloudflare.r2",
      decl_name: "R2S3Endpoint",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [r2_s3_api_citation]
}
type R2Jurisdiction
  = R2JurisdictionDefault
  | R2JurisdictionEu
  | R2JurisdictionFedramp
  | R2JurisdictionUs

fn r2_jurisdiction_wire(jurisdiction: R2Jurisdiction) -> String {
  match jurisdiction {
    R2JurisdictionDefault => "default"
    R2JurisdictionEu => "eu"
    R2JurisdictionFedramp => "fedramp"
    R2JurisdictionUs => "us"
  }
}

type R2S3Endpoint {
  account_id: String
  jurisdiction: R2Jurisdiction
}

fn r2_s3_endpoint_host(endpoint: R2S3Endpoint) -> String {
  match endpoint.jurisdiction {
    R2JurisdictionDefault => join([endpoint.account_id, ".r2.cloudflarestorage.com"], "")
    R2JurisdictionEu => join([endpoint.account_id, ".eu.r2.cloudflarestorage.com"], "")
    R2JurisdictionFedramp => join([endpoint.account_id, ".fedramp.r2.cloudflarestorage.com"], "")
    R2JurisdictionUs => join([endpoint.account_id, ".us.r2.cloudflarestorage.com"], "")
  }
}

fn r2_s3_endpoint_url(endpoint: R2S3Endpoint) -> String {
  join(["https://", r2_s3_endpoint_host(endpoint: endpoint)], "")
}

fn r2_bucket_resource_name(
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> String {
  join(
    [
      "com.cloudflare.edge.r2.bucket.",
      account_id,
      "_",
      r2_jurisdiction_wire(jurisdiction: jurisdiction),
      "_",
      bucket_name
    ],
    ""
  )
}

fn r2_account_resource_name(account_id: String) -> String {
  join(["com.cloudflare.api.account.", account_id], "")
}

type R2S3SecretDerivation
  = Sha256OfApiTokenValue {}

type R2S3AccessPair {
  access_key_id: NonEmptyStr
  secret_derivation: R2S3SecretDerivation
}

fn r2_s3_access_pair_from_created_token(token: CreatedAccountToken) -> R2S3AccessPair {
  R2S3AccessPair {
    access_key_id: token.id,
    secret_derivation: Sha256OfApiTokenValue {}
  }
}

fn r2_bucket_item_read_permission_group() -> PermissionGroupRef {
  PermissionGroupRef { id: workers_r2_storage_bucket_item_read_permission_group_id }
}

fn r2_object_read_grant() -> CloudflarePermissionGrant {
  PermissionGroupGrant { group: r2_bucket_item_read_permission_group() }
}

// THE WRITE GRANT IS BUILT FROM AN OBSERVED GROUP, NEVER FROM AN ID AUTHORED HERE. The reasoning
// above workers_r2_storage_bucket_item_read_permission_group_id is the whole of it: Cloudflare
// publishes the write group's NAME and no ID, so the id is a fact the observing workflow layer
// records with its retrieval moment (gunbc.cloudflare.r2_permission_group_observe
// cloudflare_r2_bucket_item_write_observed_permission_group_id) and this module receives it as a
// PermissionGroupRef. The grant SHAPE -- one bucket-item permission group over one bucket resource
// -- is upstream's and lives here; which id inhabits it is an observation and does not.
fn r2_object_write_grant(write_group: PermissionGroupRef) -> CloudflarePermissionGrant {
  PermissionGroupGrant { group: write_group }
}

// ONE BUCKET-ITEM RESOURCE MAP, READ AND WRITE ALIKE. Both grants scope to the same bucket resource
// name with the same wildcard; the resource is a property of the BUCKET, and the permission group is
// what distinguishes a reader from a writer. The previous read-specific name was a fork waiting to
// happen the moment a second grant arrived, which is now.
fn r2_bucket_item_resources(
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> Map<String, String> {
  map_insert(
    empty_map(),
    r2_bucket_resource_name(
      account_id: account_id,
      jurisdiction: jurisdiction,
      bucket_name: bucket_name
    ),
    "*"
  )
}

fn r2_bucket_item_resources_policy(
  grant: CloudflarePermissionGrant,
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> AccountTokenPolicy {
  AccountTokenPolicy {
    effect: PolicyAllow,
    permission_groups: permission_groups_from_grants(grants: [grant]),
    resources: r2_bucket_item_resources(
      account_id: account_id,
      jurisdiction: jurisdiction,
      bucket_name: bucket_name
    )
  }
}

fn r2_bucket_item_create_request(
  name: String,
  policy: AccountTokenPolicy
) -> CreateAccountTokenRequest {
  CreateAccountTokenRequest {
    name: name,
    policies: [policy],
    not_before: none,
    expires_on: none
  }
}

fn r2_object_read_token_policy(
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> AccountTokenPolicy {
  r2_bucket_item_resources_policy(
    grant: r2_object_read_grant(),
    account_id: account_id,
    jurisdiction: jurisdiction,
    bucket_name: bucket_name
  )
}

fn r2_object_read_create_request(
  name: String,
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> CreateAccountTokenRequest {
  r2_bucket_item_create_request(
    name: name,
    policy: r2_object_read_token_policy(
      account_id: account_id,
      jurisdiction: jurisdiction,
      bucket_name: bucket_name
    )
  )
}

fn r2_object_write_token_policy(
  write_group: PermissionGroupRef,
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> AccountTokenPolicy {
  r2_bucket_item_resources_policy(
    grant: r2_object_write_grant(write_group: write_group),
    account_id: account_id,
    jurisdiction: jurisdiction,
    bucket_name: bucket_name
  )
}

fn r2_object_write_create_request(
  name: String,
  write_group: PermissionGroupRef,
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> CreateAccountTokenRequest {
  r2_bucket_item_create_request(
    name: name,
    policy: r2_object_write_token_policy(
      write_group: write_group,
      account_id: account_id,
      jurisdiction: jurisdiction,
      bucket_name: bucket_name
    )
  )
}

// THE S3 OBJECT ADDRESS AND THE SIGNATURE REGION, CITED TO THE R2 S3 API DOCUMENT
// (developers.cloudflare.com/r2/api/s3/api, r2_s3_api_citation above). R2 serves the S3 API at
// <account_id>.r2.cloudflarestorage.com and addresses objects PATH-STYLE, /<bucket>/<key>, so the
// URL is the endpoint host followed by the bucket then the key. SigV4 requests are signed under
// the region "auto" -- R2 has no region axis and the documented value is the literal word -- and a
// signature computed under any other region is refused. Both are shape facts of the store and are
// received by the transport builder (extdeps.tools.curl curl_aws_sigv4_s3_provider) rather than
// spelled there.
//
// THE KEY IS CARRIED AS GIVEN. No percent-encoding is applied: the keys this repository writes are
// the commit-slot keys gunbc.fabric_m0_commit derives (a namespace, a slash, an attempt identity)
// and content-hash names, none of which carries a character that needs escaping in a URL path. A
// key that did would need a modeled encoder, not a heuristic here, and until one exists a caller
// that passes one gets a signature the store refuses rather than an object at a different name.
data r2_s3_sigv4_region: NonEmptyStr = "auto"

type R2ObjectLocator {
  endpoint: R2S3Endpoint
  bucket_name: NonEmptyStr
  key: NonEmptyStr
}

fn r2_object_url(locator: R2ObjectLocator) -> String {
  join(
    [r2_s3_endpoint_url(endpoint: locator.endpoint), "/", locator.bucket_name as String, "/", locator.key as String],
    ""
  )
}

// THE r2_s3_endpoint_url ROW IS RETIRED: gunbc.cloudflare.r2_origin_object reaches it through
// r2_object_url on the executing put_origin_object and fetch_origin_object entries, which is the
// consumer the row named. The list is the membership of what remains.
data cloudflare_r2_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.cloudflare.r2", decl_name: "r2_account_resource_name"),
    reason: "account IAM resource name has no executing consumer; object-read policy uses the bucket resource name",
    dissolution: unbound_dissolution(
      description: "dissolves when a gunbc declaration consumes r2_account_resource_name in an executing token policy or S3 IAM grant; a witness that the fold exists does not fire this"
    )
  ),
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.cloudflare.r2", decl_name: "r2_tokens_doc_as_of"),
    reason: "as-of pin is unread outside the claim witness; ExternalAuthority has no as-of field",
    dissolution: unbound_dissolution(
      description: "dissolves when ExternalAuthority or FactCitation carries an as-of date and this pin inhabits that field, or a gunbc executing fold reads r2_tokens_doc_as_of as the cited document date"
    )
  )
]
