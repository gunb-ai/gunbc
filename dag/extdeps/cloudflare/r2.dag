// THE FIVE ARMS ARE THE CREATE/GET BUCKET JURISDICTION VALUE SET (r2_create_bucket_location_hint_reading,
// r2_get_bucket_location_reading). Host suffixes follow the same wire token as eu/us/fedramp.
type R2Jurisdiction
  = R2JurisdictionDefault
  | R2JurisdictionEu
  | R2JurisdictionFedramp
  | R2JurisdictionFedrampHigh
  | R2JurisdictionUs

fn r2_jurisdiction_wire(jurisdiction: R2Jurisdiction) -> String {
  match jurisdiction {
    R2JurisdictionDefault => "default"
    R2JurisdictionEu => "eu"
    R2JurisdictionFedramp => "fedramp"
    R2JurisdictionFedrampHigh => "fedramp-high"
    R2JurisdictionUs => "us"
  }
}

// THE INHABITANTS, SO THE INVERSE IS READ FROM THE SAME TABLE RATHER THAN RE-SPELLED. An exhaustive
// match owes an arm per inhabitant, so a sixth jurisdiction must be added here to compile, and the
// parse below then recognises it without a second edit.
fn r2_jurisdictions() -> List<R2Jurisdiction> {
  [R2JurisdictionDefault, R2JurisdictionEu, R2JurisdictionFedramp, R2JurisdictionFedrampHigh, R2JurisdictionUs]
}

// ONE GRAMMAR READ BACKWARD (DESIGN section 4): the wire token is spelled once, by
// r2_jurisdiction_wire, and the parse selects from those same rows rather than carrying a second
// copy of the five literals. A corrected spelling therefore moves both directions together; a
// hand-written parse would have gone silently unrecognising instead.
fn parse_r2_jurisdiction(raw: String) -> R2Jurisdiction? {
  fold(
    r2_jurisdictions(),
    init: none,
    f: (acc, j) => match acc {
      Present { value: found } => Present { value: found }
      Absent => if r2_jurisdiction_wire(jurisdiction: j) == raw { Present { value: j } } else { none }
    },
  )
}

type R2S3Endpoint {
  account_id: String
  jurisdiction: R2Jurisdiction
}

fn r2_s3_endpoint_host(endpoint: R2S3Endpoint) -> String {
  match endpoint.jurisdiction {
    R2JurisdictionDefault => join([endpoint.account_id, ".r2.cloudflarestorage.com"], "")
    R2JurisdictionEu => join([endpoint.account_id, ".eu.r2.cloudflarestorage.com"], "")
    R2JurisdictionFedramp => join([endpoint.account_id, ".fedramp.r2.cloudflarestorage.com"], "")
    R2JurisdictionFedrampHigh => join([endpoint.account_id, ".fedramp-high.r2.cloudflarestorage.com"], "")
    R2JurisdictionUs => join([endpoint.account_id, ".us.r2.cloudflarestorage.com"], "")
  }
}

fn r2_s3_endpoint_url(endpoint: R2S3Endpoint) -> String {
  join(["https://", r2_s3_endpoint_host(endpoint: endpoint)], "")
}

fn r2_bucket_resource_name(
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> String {
  join(
    [
      "com.cloudflare.edge.r2.bucket.",
      account_id,
      "_",
      r2_jurisdiction_wire(jurisdiction: jurisdiction),
      "_",
      bucket_name
    ],
    ""
  )
}

fn r2_account_resource_name(account_id: String) -> String {
  join(["com.cloudflare.api.account.", account_id], "")
}

type R2S3SecretDerivation
  = Sha256OfApiTokenValue {}

type R2S3AccessPair {
  access_key_id: NonEmptyStr
  secret_derivation: R2S3SecretDerivation
}

fn r2_s3_access_pair_from_created_token(token: CreatedAccountToken) -> R2S3AccessPair {
  R2S3AccessPair {
    access_key_id: token.id,
    secret_derivation: Sha256OfApiTokenValue {}
  }
}

fn r2_bucket_item_read_permission_group() -> PermissionGroupRef {
  PermissionGroupRef { id: workers_r2_storage_bucket_item_read_permission_group_id }
}

fn r2_object_read_grant() -> CloudflarePermissionGrant {
  PermissionGroupGrant { group: r2_bucket_item_read_permission_group() }
}

// THE WRITE GRANT IS BUILT FROM AN OBSERVED GROUP, NEVER FROM AN ID AUTHORED HERE. The reasoning
// above workers_r2_storage_bucket_item_read_permission_group_id is the whole of it: Cloudflare
// publishes the write group's NAME and no ID, so the id is a fact the observing workflow layer
// records with its retrieval moment (gunbc.cloudflare.r2_permission_group_observe
// cloudflare_r2_bucket_item_write_observed_permission_group_id) and this module receives it as a
// PermissionGroupRef. The grant SHAPE -- one bucket-item permission group over one bucket resource
// -- is upstream's and lives here; which id inhabits it is an observation and does not.
fn r2_object_write_grant(write_group: PermissionGroupRef) -> CloudflarePermissionGrant {
  PermissionGroupGrant { group: write_group }
}

// ONE BUCKET-ITEM RESOURCE MAP, READ AND WRITE ALIKE. Both grants scope to the same bucket resource
// name with the same wildcard; the resource is a property of the BUCKET, and the permission group is
// what distinguishes a reader from a writer. The previous read-specific name was a fork waiting to
// happen the moment a second grant arrived, which is now.
fn r2_bucket_item_resources(
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> Map<String, String> {
  map_insert(
    empty_map(),
    r2_bucket_resource_name(
      account_id: account_id,
      jurisdiction: jurisdiction,
      bucket_name: bucket_name
    ),
    "*"
  )
}

fn r2_bucket_item_resources_policy(
  grant: CloudflarePermissionGrant,
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> AccountTokenPolicy {
  AccountTokenPolicy {
    effect: PolicyAllow,
    permission_groups: permission_groups_from_grants(grants: [grant]),
    resources: r2_bucket_item_resources(
      account_id: account_id,
      jurisdiction: jurisdiction,
      bucket_name: bucket_name
    )
  }
}

fn r2_bucket_item_create_request(
  name: String,
  policy: AccountTokenPolicy
) -> CreateAccountTokenRequest {
  CreateAccountTokenRequest {
    name: name,
    policies: [policy],
    not_before: none,
    expires_on: none
  }
}

fn r2_object_read_token_policy(
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> AccountTokenPolicy {
  r2_bucket_item_resources_policy(
    grant: r2_object_read_grant(),
    account_id: account_id,
    jurisdiction: jurisdiction,
    bucket_name: bucket_name
  )
}

fn r2_object_read_create_request(
  name: String,
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> CreateAccountTokenRequest {
  r2_bucket_item_create_request(
    name: name,
    policy: r2_object_read_token_policy(
      account_id: account_id,
      jurisdiction: jurisdiction,
      bucket_name: bucket_name
    )
  )
}

fn r2_object_write_token_policy(
  write_group: PermissionGroupRef,
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> AccountTokenPolicy {
  r2_bucket_item_resources_policy(
    grant: r2_object_write_grant(write_group: write_group),
    account_id: account_id,
    jurisdiction: jurisdiction,
    bucket_name: bucket_name
  )
}

fn r2_object_write_create_request(
  name: String,
  write_group: PermissionGroupRef,
  account_id: String,
  jurisdiction: R2Jurisdiction,
  bucket_name: String
) -> CreateAccountTokenRequest {
  r2_bucket_item_create_request(
    name: name,
    policy: r2_object_write_token_policy(
      write_group: write_group,
      account_id: account_id,
      jurisdiction: jurisdiction,
      bucket_name: bucket_name
    )
  )
}

// THE ACCOUNT-SCOPED STORAGE GRANT: BUCKET MANAGEMENT IS AN ACCOUNT OPERATION. Creating or reading a
// bucket's metadata is not an item operation on a bucket that may not yet exist, so no bucket-scoped
// resource can carry it; the grant names the ACCOUNT resource (r2_account_resource_name). Like the
// item-write grant, the group id is an observation the workflow layer supplies
// (gunbc.cloudflare.r2_permission_group_observe), never an id authored here.
fn r2_account_storage_grant(storage_group: PermissionGroupRef) -> CloudflarePermissionGrant {
  PermissionGroupGrant { group: storage_group }
}

fn r2_account_resources(account_id: String) -> Map<String, String> {
  map_insert(empty_map(), r2_account_resource_name(account_id: account_id), "*")
}

fn r2_account_storage_create_request(
  name: String,
  storage_group: PermissionGroupRef,
  account_id: String
) -> CreateAccountTokenRequest {
  CreateAccountTokenRequest {
    name: name,
    policies: [
      AccountTokenPolicy {
        effect: PolicyAllow,
        permission_groups: permission_groups_from_grants(grants: [r2_account_storage_grant(storage_group: storage_group)]),
        resources: r2_account_resources(account_id: account_id)
      }
    ],
    not_before: none,
    expires_on: none
  }
}

// THE S3 OBJECT ADDRESS AND THE SIGNATURE REGION, CITED TO THE R2 S3 API DOCUMENT
// (developers.cloudflare.com/r2/api/s3/api, r2_s3_api_citation above). R2 serves the S3 API at
// <account_id>.r2.cloudflarestorage.com and addresses objects PATH-STYLE, /<bucket>/<key>, so the
// URL is the endpoint host followed by the bucket then the key. SigV4 requests are signed under
// the region "auto" -- R2 has no region axis and the documented value is the literal word -- and a
// signature computed under any other region is refused. Both are shape facts of the store and are
// received by the transport builder (extdeps.tools.curl curl_aws_sigv4_s3_provider) rather than
// spelled there.
//
// THE KEY IS CARRIED AS GIVEN. No percent-encoding is applied: the keys this repository writes are
// the commit-slot keys gunbc.fabric_m0_commit derives (a namespace, a slash, an attempt identity)
// and content-hash names, none of which carries a character that needs escaping in a URL path. A
// key that did would need a modeled encoder, not a heuristic here, and until one exists a caller
// that passes one gets a signature the store refuses rather than an object at a different name.
data r2_s3_sigv4_region: NonEmptyStr = "auto"

type R2ObjectLocator {
  endpoint: R2S3Endpoint
  bucket_name: NonEmptyStr
  key: NonEmptyStr
}

fn r2_object_url(locator: R2ObjectLocator) -> String {
  join(
    [r2_s3_endpoint_url(endpoint: locator.endpoint), "/", locator.bucket_name as String, "/", locator.key as String],
    ""
  )
}

// LOCATION AND RESIDENCY TRANSCRIPTIONS FOR THIS SAME PRODUCT. They were briefly a second module
// (extdeps.cloudflare.r2_data_location) whose subject was a wrapper around one reading. R2 is one
// independently versioned product; DESIGN section 3's external-upstream rule does not mint a
// second module authority per documentation page. The tokens-page default-jurisdiction sentence
// cites this module's existing anchor rather than a parallel ExternalAuthority for the same URI.
//
// THERE IS NO CloudflarePublishedReading. Dated attestation is FactCitation (fact + authority);
// the transcription is the cited NonEmptyStr. A second as-of record would remint the carrier
// r2_tokens_doc_as_of's frontier already named. Company DPA and subprocessors live on
// extdeps.vendor.cloudflare, not under R2S3Endpoint.
data r2_data_location_reading: NonEmptyStr = "When you create a new bucket, the data location is set to Automatic by default. Currently, this option chooses a bucket location in the closest available region to the create bucket request based on the location of the caller. Location Hints are optional parameters you can provide during bucket creation to indicate the primary geographical location you expect data will be accessed from. Location Hints are a best effort and not a guarantee, and they should only be used as a way to optimize performance. Available hints: wnam Western North America, enam Eastern North America, weur Western Europe, eeur Eastern Europe, apac Asia-Pacific, oc Oceania. Jurisdictional Restrictions guarantee objects in a bucket are stored within a specific jurisdiction. Use Jurisdictional Restrictions when you need to ensure data is stored and processed within a jurisdiction to meet data residency requirements. Available jurisdictions: eu European Union, fedramp FedRAMP, us United States. The following services do not interact with R2 resources with assigned jurisdictions: Logpush. Once an R2 bucket is created, the jurisdiction cannot be changed. Page last updated Aug 19, 2026. Read 2026-09-12."

data r2_data_location_citation: FactCitation = FactCitation {
  fact: DeclarationRef {
    module_path: "extdeps.cloudflare.r2",
    decl_name: "r2_data_location_reading",
    field: WholeDeclaration
  },
  authority: r2_data_location_authority,
}

data r2_how_r2_works_reading: NonEmptyStr = "R2 Gateway: The entry point for all API requests that handles authentication and routing logic. This service is deployed across Cloudflare's global network via Cloudflare Workers. Metadata Service: A distributed layer built on Durable Objects used to store and manage object metadata. Distributed Storage Infrastructure: The underlying infrastructure that persistently stores encrypted object data. On write, the Gateway determines which storage cluster to write the encrypted data to within the location set for the bucket. The encrypted data is written and stored in the distributed storage infrastructure, and replicated within the region (e.g. ENAM) for durability. On read, if the object is not in the tiered read cache, it retrieves the object from one of the distributed storage data centers within the region that holds the object data. Page last updated Apr 21, 2026. Read 2026-09-12."

data r2_how_r2_works_citation: FactCitation = FactCitation {
  fact: DeclarationRef {
    module_path: "extdeps.cloudflare.r2",
    decl_name: "r2_how_r2_works_reading",
    field: WholeDeclaration
  },
  authority: r2_how_r2_works_authority,
}

data r2_us_jurisdiction_changelog_reading: NonEmptyStr = "New us jurisdiction for R2. R2 now supports a us jurisdiction, which guarantees that bucket data is stored and processed within the United States. Use this jurisdiction when you need explicit US data residency guarantees. Use the jurisdiction-specific S3 endpoint https://<ACCOUNT_ID>.us.r2.cloudflarestorage.com. Once an R2 bucket is created, its jurisdiction cannot be changed. Posted 2026-08-17. Read 2026-09-12."

data r2_us_jurisdiction_changelog_citation: FactCitation = FactCitation {
  fact: DeclarationRef {
    module_path: "extdeps.cloudflare.r2",
    decl_name: "r2_us_jurisdiction_changelog_reading",
    field: WholeDeclaration
  },
  authority: r2_us_jurisdiction_changelog_authority,
}

data r2_tokens_default_jurisdiction_reading: NonEmptyStr = "A specific bucket is represented as com.cloudflare.edge.r2.bucket.<ACCOUNT_ID>_<JURISDICTION>_<BUCKET_NAME>. JURISDICTION: The jurisdiction where the R2 bucket lives. For buckets not created in a specific jurisdiction this value will be default. Read 2026-09-12."

data r2_tokens_default_jurisdiction_citation: FactCitation = FactCitation {
