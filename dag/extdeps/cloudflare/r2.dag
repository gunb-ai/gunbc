  }
}

data r2_tokens_doc_as_of: Timestamp = "2026-08-18"

data workers_r2_storage_bucket_item_read_permission_group_id: NonEmptyStr = "6a018a9f2fc74eb6b293b0c548f38b39"

data r2_s3_access_key_is_created_token_id_citation: FactCitation = FactCitation {
