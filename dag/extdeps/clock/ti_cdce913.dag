module extdeps.clock.ti_cdce913

import std.types { String }
import std.measure { micrometer }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vendor.texas_instruments { texas_instruments }
import extdeps.land_pattern.types {
  DualRowLandGeometry,
  MountablePart,
  PackageDrawingRef,
  PackageOutline,
  VendorRecommendedLandPattern,
}

// The CDCE913 datasheet, read 2026-08-14 for its mechanical pages only. The package drawing it
// reprints is PW0014A, stamped 4220202/B, 12/2023.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.ti.com/lit/ds/symlink/cdce913.pdf"
  }
}

data ti_cdce913_note: String = "MECHANICAL FACTS ONLY, FROM ONE DOCUMENT. The CDCE913 is a programmable clock generator and none of that is modelled here — no output count, no frequency range, no PLL fact. The package outline and the vendor's recommended land pattern are what the drawing states and what were read. The document also carries the sibling part CDCEL913 on the same pages; the ordering part number recorded here is the one whose package this drawing describes, and a reader wanting the low-voltage sibling adds a row rather than editing this one, because they are separately ordered parts even where they share a drawing."

data cdce913_pw0014a_drawing: PackageDrawingRef = PackageDrawingRef {
  drawing_number: "4220202/B",
  revision_date: "12/2023",
  reprinted_in: extdeps_external_authority_anchor,
}

data cdce913_pw0014a_outline: PackageOutline = PackageOutline {
  designator: "PW0014A",
  drawing: cdce913_pw0014a_drawing,
  terminal_count: 14,
  terminal_pitch: micrometer(count: 650),
  body_length_min: micrometer(count: 4900),
  body_length_max: micrometer(count: 5100),
  body_width_min: micrometer(count: 4300),
  body_width_max: micrometer(count: 4500),
  height_max: micrometer(count: 1200),
}

data cdce913_pw0014a_land_pattern: VendorRecommendedLandPattern = VendorRecommendedLandPattern {
  package_designator: "PW0014A",
  drawing: cdce913_pw0014a_drawing,
  geometry: DualRowLandGeometry {
    lands_per_row: 7,
    pitch: micrometer(count: 650),
    row_span_centre_to_centre: micrometer(count: 5800),
    land_length: micrometer(count: 1500),
    land_width: micrometer(count: 450),
  },
}

data cdce913pwr: MountablePart = MountablePart {
  ordering_part_number: "CDCE913PWR",
  vendor: texas_instruments,
  outline: cdce913_pw0014a_outline,
  land_pattern: cdce913_pw0014a_land_pattern,
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.clock.ti_cdce913",
      decl_name: "cdce913pwr",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
