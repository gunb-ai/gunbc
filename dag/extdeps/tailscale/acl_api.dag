module extdeps.tailscale.acl_api

import std.types { Secret, NonEmptyStr, AuthScheme, HttpStatus }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.ietf.http_semantics { HttpMethod }
import std.resources { Network }
import extdeps.transports.rest { RestResult }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "tailscale.com/api"
  }
}

// The subject is the service, not a payload type: tailscale.AclAdmin is the module's bound
// realization of Tailscale's ACL Admin API (GetPolicy reads GET /api/v2/tailnet/{tailnet}/acl,
// UpsertPolicy writes PUT /api/v2/tailnet/{tailnet}/acl), which is the upstream surface this
// module models. TailscaleAclApiError is this module's own error shape carried in the service's
// response map, not the upstream.

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.tailscale.acl_api",
      decl_name: "tailscale.AclAdmin",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type TailscaleAclApiError {
  message: String
  status: HttpStatus
}

service tailscale.AclAdmin {
  config {
    endpoint: "https://api.tailscale.com"
    auth: Bearer
    auth_input: api_key
  }

  operation GetPolicy {
    requires Network
    input {
      api_key: Secret
      tailnet: NonEmptyStr
    }
    output {
      policy_json: String from "acl"
      etag: String?
    }
    readonly
    transport rest { method: GET, path: "/api/v2/tailnet/\{tailnet\}/acl" }
    response {
      200 => String
      401 => TailscaleAclApiError
      403 => TailscaleAclApiError
      404 => TailscaleAclApiError
      5xx => TailscaleAclApiError
    }
  }

  operation UpsertPolicy {
    requires Network
    input {
      api_key: Secret
      tailnet: NonEmptyStr
      policy_json: String
    }
    output {
      policy_json: String from "acl"
    }

    transport rest {
      method: PUT,
      path: "/api/v2/tailnet/\{tailnet\}/acl",
      body: { acl: policy_json }
    }
    response {
      200 => String
      401 => TailscaleAclApiError
      403 => TailscaleAclApiError
      409 => TailscaleAclApiError
      5xx => TailscaleAclApiError
    }
  }
}
