module extdeps.tailscale.join

// UPSTREAM FACTS AND TYPED argv FOR THE ONE THING A HOST MUST DO TO BE ON THE TAILNET AT ALL: JOIN IT.
//
// @ref(gunbc.tailscale_join_converge::tailscale_join_host) is the fleet-side converge that reads these
// rows; this module is the
// upstream surface only -- what `tailscale up` takes, what a join's success is made of, and what an auth
// key is allowed to be. Nothing here names a host, a tag the fleet happens to use, a Secret Manager
// secret, or a window: those are product facts (gunbc.tailscale_fleet_auth_key, gunbc.fleet.fleet_tailnet).
//
// WHY A JOIN IS MODELLED AT ALL, WHEN A MACHINE NAME MODULE ALREADY EXISTS. extdeps.tailscale.machine_name
// covers a device that is ALREADY a member: `status`, `set --hostname`. Neither works on a host that has
// never joined -- `tailscale set` on an unjoined node has no prefs to change, and `status` reports a
// backend that is not logged in. Membership itself is a different upstream verb with different inputs
// (`up`, with an authorization credential), and the fleet has hosts that are not members while the router
// is meant to reach its upstreams by tailnet name. So this is the join half of the same tailnet.
//
// THE CREDENTIAL NEVER TRAVELS IN argv. That is the load-bearing rule of this module, and it is why the
// argv rows below take a TailscaleAuthKeyFile -- a PATH -- and no function here takes key material at all.
// Tailscale documents the credential as a bearer secret ("Treat the auth key like a password, because that
// is what it is") and its own examples interpolate it into the command line; an argv is readable on the
// host for the lifetime of the process, and this fleet's own custody module refuses to write a secret's
// material into an argument for the same reason (gunbc.fleet.host_credential_custody_converge: THE ONE
// ARGUMENT THAT IS NOT A PATH). Upstream gives the safe route, and it is the only one modelled here -- the
// `--auth-key` value may be a file reference, spelled `file:<path>` (cmd/tailscale/cli/up.go, the
// `--auth-key` flag registration: `node authorization key; if it begins with "file:", then it's a path to
// a file containing the authkey`). What this fleet does to GET the key into that file is custody's
// business (gunbc.fleet.host_credential_custody_converge), not this module's.

import extdeps.dns.domain_name { DnsLabel }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.languages.json.parse {
  FieldAbsent,
  FieldMalformed,
  FieldRead,
  JsonDocumentMalformedAt,
  JsonDocumentParsed,
  JsonDocumentTrailingContentAt,
  JsonDocumentUnreadable,
  json_field_string,
  parse_json_document,
}
import extdeps.tailscale.serve { tailscale_program }
import extdeps.uri { Https, Uri }
import std.measure { Second, second_count, seconds_per_day }
import extdeps.units.iso8601_calendar {
  Iso8601CivilDate,
  iso8601_days_from_civil,
  iso8601_utc_instant_parts_are_valid,
}
import std.optional { Absent, Optional, Present }
import std.types { Bool, Int, List, NonEmptyStr, String, string_non_empty }

