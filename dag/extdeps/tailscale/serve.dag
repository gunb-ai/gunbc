module extdeps.tailscale.serve



// Phantom relation brand (std.key_relation key_relation_brand_type_tag_note): keeps this relation distinct from other TailscaleServeEndpoint x ScopedKey rows that share carriers — orthogonal to scope correctness (see the // block above tailscale_serve_route_key_relation).
type TailscaleServeRouteKeyRelation

data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "tailscale.com/kb/1242/tailscale-serve"
  }
}

// THE CONFIGURATION KEY, which this module previously did not carry. EnableBackground took a local port and nothing else, so two deployments on one node were indistinguishable to the model while being indistinguishable to tailscale for a different reason: a bare `serve --bg <port>` binds the DEFAULT HTTPS listener at the ROOT mount path, so the second one issued rebinds `/` from the first backend to the second. The model could not express the difference because it did not carry the thing tailscale actually keys on.\n\nThe upstream tells you what the key is by what `off` requires. Per tailscale.com/kb/1242, turning one mapping off is the original command with `off` appended, and 'in off commands, the <target> argument is optional, but all original flags are required' — so the identity is (listener port x mount path x service), not the backend. That is why the backend is a field here rather than the identity: two endpoints differing only in backend are the SAME endpoint being reassigned, which is exactly the collision.\n\nThe root mount is a distinct VARIANT rather than a path string of \"/\", because the upstream spells them differently — the root is the absence of --set-path, not --set-path=/ — and the docs do not state that --set-path=/ is accepted at all. Inventing that equivalence would be the same uncited capability claim this module is being corrected for.
type TailscaleServeMount
  = ServeRootMount
  | ServeSetPath { path: std.types.NonEmptyStr }

type TailscaleServeEndpoint {
  https_port: std.types.Port
  mount: TailscaleServeMount
  backend: std.types.NonEmptyStr
}

fn tailscale_serve_mount_argv(mount: TailscaleServeMount) -> std.types.List<String> {
  match mount {
    ServeRootMount => []
    ServeSetPath { path } => [concat("--set-path=", path as String)]
  }
}

fn tailscale_serve_endpoint_flags(endpoint: TailscaleServeEndpoint) -> std.types.List<String> {
  concat(
    [concat("--https=", to_string(endpoint.https_port))],
    tailscale_serve_mount_argv(mount: endpoint.mount),
  )
}

// OFF IS THE SAME COMMAND WITH off APPENDED, which is why this projects from the same endpoint value rather than being authored beside it. The upstream requires every original flag on the off form, so an off argv built from a second spelling of the endpoint would silently fail to match the mapping it meant to remove — removing nothing, reporting success. Deriving both directions from one value makes that unwritable.\n\nThe target is omitted deliberately: the docs state it is optional on off commands, and including it would add a second thing that has to agree.
fn tailscale_serve_enable_argv(endpoint: TailscaleServeEndpoint) -> std.types.List<String> {
  concat(
    concat(["serve", "--bg"], tailscale_serve_endpoint_flags(endpoint: endpoint)),
    [endpoint.backend as String],
  )
}

fn tailscale_serve_off_argv(endpoint: TailscaleServeEndpoint) -> std.types.List<String> {
  concat(
    concat(["serve"], tailscale_serve_endpoint_flags(endpoint: endpoint)),
    ["off"],
  )
}

fn tailscale_serve_status_json_argv() -> std.types.List<String> {
  ["serve", "status", "--json"]
}

fn tailscale_serve_proxy_url(endpoint: TailscaleServeEndpoint) -> String {
  concat("http://127.0.0.1:", endpoint.backend as String)
}

fn tailscale_serve_mount_status_key(mount: TailscaleServeMount) -> String {
  match mount {
    ServeRootMount => "/"
    ServeSetPath { path } => path as String
  }
}

fn json_unique_member_value(v: extdeps.languages.json.emit.JsonValue, key: String) -> extdeps.languages.json.emit.JsonValue? {
  match extdeps.languages.json.parse.json_object_unique_member(v: v, key: key) {
    JsonMemberFound { value } => Present { value: value }
    extdeps.languages.json.parse.JsonMemberAbsent => none
    JsonMemberDuplicated { count: _ } => none
    extdeps.languages.json.parse.JsonMemberNotAnObject => none
  }
}

fn tailscale_status_handler_proxy(handler: extdeps.languages.json.emit.JsonValue) -> std.types.List<String> {
  match json_unique_member_value(v: handler, key: "Proxy") {
    Present { value: extdeps.languages.json.emit.JsonString { value: proxy } } => [proxy]
    Present { value: _ } => []
    Absent => []
  }
}

fn tailscale_status_web_entry_proxies(entry: extdeps.languages.json.emit.JsonValue, mount: TailscaleServeMount) -> std.types.List<String> {
  match json_unique_member_value(v: entry, key: "Handlers") {
    Present { value: handlers } =>
      match json_unique_member_value(v: handlers, key: tailscale_serve_mount_status_key(mount: mount)) {
        Present { value: handler } => tailscale_status_handler_proxy(handler: handler)
        Absent => []
      }
    Absent => []
  }
}

fn tailscale_status_web_proxies(web: extdeps.languages.json.emit.JsonValue, mount: TailscaleServeMount) -> std.types.List<String> {
  match web {
    JsonObject { members } => flat_map(members, member => tailscale_status_web_entry_proxies(entry: member.value, mount: mount))
    extdeps.languages.json.emit.JsonNull => []
    JsonBool { value: _ } => []
    JsonNumber { lexeme: _ } => []
    JsonString { value: _ } => []
    JsonArray { elements: _ } => []
  }
}

data serve_status_json_projection_note: String = "Tailscale documents `serve status --json` as the machine-readable status surface. For the legacy node Serve configuration used by srv1, Web.<dns:port>.Handlers.<mount>.Proxy names the currently routed backend. DNS is intentionally not treated as identity here: it is a map key derived by tailscaled and the owned endpoint is listener x mount. Duplicate or wrong-shaped members yield no proxy, which the blue/green selector refuses before mutation; they never select a plausible slot."

fn tailscale_serve_status_proxy_targets(status_json: String, mount: TailscaleServeMount) -> std.types.List<String> {
  match extdeps.languages.json.parse.parse_json(s: status_json) {
    Present { value: doc } =>
      match json_unique_member_value(v: doc, key: "Web") {
        Present { value: web } => tailscale_status_web_proxies(web: web, mount: mount)
        Absent => []
      }
    Absent => []
  }
}

data serve_scoped_removal_capability_note: String = "SCOPED REMOVAL IS A VERSION-OBSERVED CAPABILITY, NOT A CONSTANT — and the constant it replaces was wrong. This module's consumer previously asserted that tailscale serve has no per-port removal and only a node-global reset, built a refusal arm on that premise, and cited nothing. The upstream documents scoped removal via `off`, and separately notes that the Serve CLI CHANGED in client 1.52 (review, 2026-07-30; tailscale.com/kb/1242).\\n\\nSo the capability is a fact about the client installed on a particular host at a particular time, which is why it is a function of an observed version rather than a row. The verdict is three-valued because an unobserved version is neither capable nor incapable, and collapsing that to either pole is what produced the false claim above. A consumer must refuse BEFORE mutating rather than after, because the failure this guards is a teardown that silently removes nothing and reports success.\\n\\nThe boundary is stated as the version the upstream itself names, not as a version this repo picked."

data tailscale_scoped_serve_off_minimum: extdeps.version.semver.SemVerVersion = extdeps.version.semver.SemVerVersion {
  major: 1,
  minor: 52,
  patch: 0,
  pre_release: [],
  build: [],
}

type TailscaleServeCapability
  = ScopedRemovalSupported { observed: extdeps.version.semver.SemVerVersion }
  | ScopedRemovalUnsupported { observed: extdeps.version.semver.SemVerVersion }
  | ScopedRemovalUnobserved { reason: String }

// THE VERDICT CARRIES WHAT IT WAS COMPUTED FROM. A Bool capability cannot be re-derived when the boundary moves or the host is upgraded, and cannot say WHICH client it is describing — so the observed version rides on both decided arms and only the undecided arm carries prose.\n\nIt is a SemVerVersion rather than the version string tailscale prints, grounded on extdeps.version.semver, because an earlier draft of this row held both a display string and a parsed major/minor pair — two representations of one fact, free to disagree, which is the exact defect class this module is being repaired for. The label is a projection (semver_version_label), so there is nothing to keep in sync.\n\nComparison is semver_compare rather than a hand-written major/minor ladder, for the same reason: the ordering is already modeled, and a second ladder would be a second answer.
fn tailscale_scoped_removal_capability(observed: extdeps.version.semver.SemVerVersion) -> TailscaleServeCapability {
  match extdeps.version.semver.semver_compare(a: observed, b: tailscale_scoped_serve_off_minimum) {
    std.algebra.Less => ScopedRemovalUnsupported { observed: observed }
    std.algebra.Equal => ScopedRemovalSupported { observed: observed }
    std.algebra.Greater => ScopedRemovalSupported { observed: observed }
  }
}

fn tailscale_serve_endpoint_key(endpoint: TailscaleServeEndpoint) -> std.types.NonEmptyStr {
  join(tailscale_serve_endpoint_flags(endpoint: endpoint), " ") as std.types.NonEmptyStr
}

// PER-DEVICE SERVE CONFIGURATION (tailscale.com/kb/1242): route identity is unique within one tailnet device's `serve` surface, not universe-wide. `node` is grounded on product.network_topology NetworkEndpoint with role TailscaleEndpoint — the fleet tailnet device rows in gunbc.fleet_intent_network (srv1_tailscale_endpoint, srv2_tailscale_endpoint, …), not a minted parallel identity. `service` names the upstream Serve CLI surface on that device.
type TailscaleServeService
  = | ServeCli

type TailscaleServeScope {
  node: product.network_topology.NetworkEndpoint
  service: TailscaleServeService
}

type TailscaleServeRouteSubject {
  scope: TailscaleServeScope
  endpoint: TailscaleServeEndpoint
}

fn tailscale_serve_service() -> TailscaleServeService {
  ServeCli
}

fn tailscale_serve_scope(node: product.network_topology.NetworkEndpoint) -> TailscaleServeScope {
  TailscaleServeScope { node: node, service: tailscale_serve_service() }
}

fn tailscale_serve_route_subject(
  scope: TailscaleServeScope,
  endpoint: TailscaleServeEndpoint,
) -> TailscaleServeRouteSubject {
  TailscaleServeRouteSubject { scope: scope, endpoint: endpoint }
}

// Scope identity keys on NetworkEndpoint.label only: fleet tailnet device rows are singleton authorities per label (gunbc.fleet_intent_network). If endpoint rows at the same label can diverge on host/address/role/locality, widen equality here before call sites depend on label alone.
fn tailscale_network_endpoint_label_eq(a: product.network_topology.NetworkEndpoint, b: product.network_topology.NetworkEndpoint) -> Bool {
  a.label == b.label
}

fn tailscale_serve_scope_eq(a: TailscaleServeScope, b: TailscaleServeScope) -> Bool {
  tailscale_network_endpoint_label_eq(a: a.node, b: b.node)
    && match a.service {
      ServeCli =>
        match b.service {
          ServeCli => true
        }
    }
}

fn tailscale_serve_route_scope_of(subject: TailscaleServeRouteSubject) -> TailscaleServeScope {
  subject.scope
}

fn tailscale_serve_route_key_of(subject: TailscaleServeRouteSubject) -> TailscaleServeRouteKey {
  tailscale_serve_route_key(endpoint: subject.endpoint)
}

fn tailscale_serve_route_member_path(endpoint: TailscaleServeEndpoint) -> std.types.NonEmptyStr {
  tailscale_serve_route_key_label(key: tailscale_serve_route_key(endpoint: endpoint))
}

// THE UPSTREAM KEY IS LISTENER x MOUNT, NOT BACKEND AND NOT A RENDERED ARGV STRING. tailscale_serve_route_key projects the two discriminants the `off` form requires; backend changes are re-points of the same route, which is why it is excluded from the key. tailscale_serve_route_key_label is a display locator for membership carriers that still spell a NonEmptyStr path — it is NOT the identity and must not be confused with tailscale_serve_endpoint_flags.
type TailscaleServeRouteKey {
  https_port: std.types.Port
  mount: TailscaleServeMount
}

fn tailscale_serve_route_key(endpoint: TailscaleServeEndpoint) -> TailscaleServeRouteKey {
  TailscaleServeRouteKey {
    https_port: endpoint.https_port,
    mount: endpoint.mount,
  }
}

fn tailscale_serve_mount_eq(a: TailscaleServeMount, b: TailscaleServeMount) -> std.types.Bool {
  match a {
    ServeRootMount =>
      match b {
        ServeRootMount => true
        ServeSetPath { path: _ } => false
      }
    ServeSetPath { path: pa } =>
      match b {
        ServeRootMount => false
        ServeSetPath { path: pb } => pa as String == pb as String
      }
  }
}

fn tailscale_serve_route_key_eq(a: TailscaleServeRouteKey, b: TailscaleServeRouteKey) -> std.types.Bool {
  a.https_port == b.https_port && tailscale_serve_mount_eq(a: a.mount, b: b.mount)
}

fn tailscale_serve_route_key_label(key: TailscaleServeRouteKey) -> std.types.NonEmptyStr {
  join(
    [
      to_string(key.https_port),
      ":",
      tailscale_serve_mount_status_key(mount: key.mount),
    ],
    "",
  ) as std.types.NonEmptyStr
}

fn tailscale_endpoint_state_of(endpoint: TailscaleServeEndpoint) -> std.types.NonEmptyStr {
  endpoint.backend
}

fn tailscale_endpoint_state_eq(a: std.types.NonEmptyStr, b: std.types.NonEmptyStr) -> std.types.Bool {
  a == b
}

fn tailscale_endpoint_value_eq(a: TailscaleServeEndpoint, b: TailscaleServeEndpoint) -> std.types.Bool {
  tailscale_endpoint_state_eq(
    a: tailscale_endpoint_state_of(endpoint: a),
    b: tailscale_endpoint_state_of(endpoint: b),
  )
}

// KEYING-0 follow-on (node://adhoc-907f1da5-c20): tailscale_serve_route_key_relation scopes route keys by TailscaleServeScope { node, service } instead of GlobalKeyScope. Two nodes may each own the same listener×mount route as distinct scoped keys; collapsing them was the DeploymentArtifactStep poison class reached from the scope axis. Witness: test.claim.tailscale_serve_route_key_witness w_per_device_scope_preserves_distinct_nodes_same_route and its GlobalKeyScope RED control.
data tailscale_serve_route_key_relation: KeyRelation<TailscaleServeRouteKeyRelation, TailscaleServeRouteSubject, TailscaleServeScope, TailscaleServeRouteKey> = std.key_relation.KeyRelation {
  scope_of: tailscale_serve_route_scope_of,
  key_of: tailscale_serve_route_key_of,
  scope_eq: tailscale_serve_scope_eq,
  key_eq: tailscale_serve_route_key_eq,
}

fn tailscale_serve_route_endpoint_state_of(subject: TailscaleServeRouteSubject) -> std.types.NonEmptyStr {
  tailscale_endpoint_state_of(endpoint: subject.endpoint)
}

fn tailscale_serve_route_subject_value_eq(a: TailscaleServeRouteSubject, b: TailscaleServeRouteSubject) -> Bool {
  tailscale_endpoint_value_eq(a: a.endpoint, b: b.endpoint)
}

data tailscale_serve_resource_relation: KeyedResourceRelation<TailscaleServeRouteKeyRelation, TailscaleServeRouteSubject, TailscaleServeScope, TailscaleServeRouteKey, NonEmptyStr> = std.key_relation.KeyedResourceRelation {
  key: tailscale_serve_route_key_relation,
  state: std.key_relation.StateRelation {
    state_of: tailscale_serve_route_endpoint_state_of,
    state_eq: tailscale_endpoint_state_eq,
  },
}

// EnableBackground IS DELETED RATHER THAN CORRECTED. It took a local port and shaped the literal argv `serve --bg {local_port}`, which is precisely the unscoped root-mount rebind described above — the operation whose every invocation on a second deployment silently steals `/` from the first. Correcting it in place would have meant a template with a conditional flag, which the argv template form cannot express; carrying it beside the endpoint fns would have left two spellings of one operation, the fork this module is being repaired for.\n\nSo the enable argv is a fn (the established form for conditional argv — see extdeps.llm.cursor_cli), and the collision shape is unwritable because it no longer exists. It had zero consumers at deletion: the one caller that mattered hand-built the same string in the emitter instead of consuming this module at all.
service tailscale.Serve {
  operation Status {
    input {}
    output { stdout: String from "stdout" }
    readonly
    transport shell { argv: ["tailscale", "serve", "status"] }
    exit {
      0 => Unit
      nonzero => String "tailscale serve status failed"
    }
  }

  operation StatusJson {
    input {}
    output { stdout: String from "stdout" }
    readonly
    transport shell { argv: ["tailscale", "serve", "status", "--json"] }
    exit {
      0 => Unit
      nonzero => String "tailscale serve status --json failed"
    }
  }
}
