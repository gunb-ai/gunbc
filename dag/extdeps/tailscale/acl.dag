module extdeps.tailscale.acl


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "tailscale.com/kb/1018"
  }
}

fn tailscale_grants_external_authority_holds() -> Bool {
  uri_wire(uri: Uri {
    scheme: Https,
    locator: "tailscale.com/kb/1018",
  }) == "https://tailscale.com/kb/1018"
}

data tailscale_acl_policy_language_uri: String = "tailscale.com/kb/1337/acl-syntax"

data dashboard_cutover_mac_ip: NonEmptyStr = "100.65.94.55"

data dashboard_cutover_mac_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.tailscale.acl",
    decl_name: "dashboard_cutover_mac_ip",
    field: WholeDeclaration
  }
}

data tag_ci: NonEmptyStr = "tag:ci"
data tag_dashboard: NonEmptyStr = "tag:dashboard"
data dashboard_tcp_port: NonEmptyStr = "tcp:3737"
data ssh_tcp_port: NonEmptyStr = "tcp:22"

type TailscaleAclSelector
  = AclTag { label: NonEmptyStr }
  | AclAutogroup { group: NonEmptyStr }
  | AclIpv4 { address: NonEmptyStr }
  | AclProtoPort { spec: NonEmptyStr }
  | AclLiteralUser { name: NonEmptyStr }
  | AclWildcard

fn render_tailscale_acl_selector(s: TailscaleAclSelector) -> NonEmptyStr {
  match s {
    AclTag { label: l } => concat("tag:", l)
    AclAutogroup { group: g } => concat("autogroup:", g)
    AclIpv4 { address: a } => a
    AclProtoPort { spec: p } => p
    AclLiteralUser { name: n } => n
    AclWildcard => "*" as NonEmptyStr
  }
}

fn sel_tag(label: NonEmptyStr) -> TailscaleAclSelector {
  AclTag { label: label }
}

fn sel_autogroup(group: NonEmptyStr) -> TailscaleAclSelector {
  AclAutogroup { group: group }
}

fn sel_ipv4(address: NonEmptyStr) -> TailscaleAclSelector {
  AclIpv4 { address: address }
}

fn sel_proto_port(spec: NonEmptyStr) -> TailscaleAclSelector {
  AclProtoPort { spec: spec }
}

fn sel_literal_user(name: NonEmptyStr) -> TailscaleAclSelector {
  AclLiteralUser { name: name }
}

fn sel_wildcard() -> TailscaleAclSelector {
  AclWildcard
}

data tag_ci_label: NonEmptyStr = "ci"
data tag_dashboard_label: NonEmptyStr = "dashboard"

fn sel_tag_ci() -> TailscaleAclSelector {
  sel_tag(label: tag_ci_label)
}

fn sel_tag_dashboard() -> TailscaleAclSelector {
  sel_tag(label: tag_dashboard_label)
}

fn tailscale_acl_selector_eq(a: TailscaleAclSelector, b: TailscaleAclSelector) -> Bool {
  render_tailscale_acl_selector(s: a) == render_tailscale_acl_selector(s: b)
}

type TailscaleGrant {
  src: List<TailscaleAclSelector>
  dst: List<TailscaleAclSelector>
  ip: List<TailscaleAclSelector>
}

type TailscaleSshRule {
  action: NonEmptyStr
  src: List<TailscaleAclSelector>
  dst: List<TailscaleAclSelector>
  users: List<TailscaleAclSelector>
}

type TailscaleNodeAttr {
  target: List<NonEmptyStr>
  attr: List<NonEmptyStr>
}

type TailscaleTagOwnerRow {
  tag: NonEmptyStr
  owners: List<NonEmptyStr>
}

type TailscaleAclPolicy {
  grants: List<TailscaleGrant>
  ssh: List<TailscaleSshRule>
  node_attrs: List<TailscaleNodeAttr>
  tag_owners: List<TailscaleTagOwnerRow>
}

fn member_baseline_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_autogroup(group: "member" as NonEmptyStr)],
    dst: [sel_wildcard()],
    ip: [sel_wildcard()],
  }
}

fn tag_ci_quarantine_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_ci()],
    dst: [sel_ipv4(address: dashboard_cutover_mac_ip), sel_tag_dashboard()],
    ip: [sel_proto_port(spec: dashboard_tcp_port)],
  }
}

fn tag_dashboard_self_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_dashboard()],
    dst: [sel_tag_dashboard()],
    ip: [sel_wildcard()],
  }
}

fn tag_dashboard_to_ci_ssh_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_dashboard()],
    dst: [sel_tag_ci()],
    ip: [sel_proto_port(spec: ssh_tcp_port)],
  }
}

fn operator_tailscale_acl_grants() -> List<TailscaleGrant> {
  [
    member_baseline_grant(),
    tag_ci_quarantine_grant(),
    tag_dashboard_self_grant(),
    tag_dashboard_to_ci_ssh_grant(),
  ]
}

fn operator_tailscale_acl_ssh() -> List<TailscaleSshRule> {
  [
    TailscaleSshRule {
      action: "accept" as NonEmptyStr,
      src: [sel_autogroup(group: "member" as NonEmptyStr)],
      dst: [sel_autogroup(group: "self" as NonEmptyStr)],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr), sel_literal_user(name: "root" as NonEmptyStr)],
    },
    TailscaleSshRule {
      action: "accept" as NonEmptyStr,
      src: [sel_autogroup(group: "member" as NonEmptyStr)],
      dst: [sel_tag_ci()],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr)],
    },
    TailscaleSshRule {
      action: "accept" as NonEmptyStr,
      src: [sel_tag_dashboard()],
      dst: [sel_tag_ci()],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr), sel_literal_user(name: "root" as NonEmptyStr)],
    },
  ]
}

fn operator_tailscale_acl_node_attrs() -> List<TailscaleNodeAttr> {
  [
    TailscaleNodeAttr {
      target: ["autogroup:member" as NonEmptyStr],
      attr: ["funnel" as NonEmptyStr],
    },
  ]
}

fn operator_tailscale_acl_tag_owners() -> List<TailscaleTagOwnerRow> {
  [
    TailscaleTagOwnerRow { tag: tag_ci, owners: ["autogroup:admin" as NonEmptyStr] },
    TailscaleTagOwnerRow { tag: tag_dashboard, owners: ["autogroup:admin" as NonEmptyStr] },
  ]
}

data operator_tailscale_acl_policy: TailscaleAclPolicy = {
  grants: operator_tailscale_acl_grants(),
  ssh: operator_tailscale_acl_ssh(),
  node_attrs: operator_tailscale_acl_node_attrs(),
  tag_owners: operator_tailscale_acl_tag_owners(),
}

fn selector_list_contains(items: List<TailscaleAclSelector>, needle: TailscaleAclSelector) -> Bool {
  fold(items, init: false, f: (acc, x) => acc || tailscale_acl_selector_eq(a: x, b: needle))
}

fn grant_src_is_tag_ci(g: TailscaleGrant) -> Bool {
  selector_list_contains(items: g.src, needle: sel_tag_ci())
}

fn grant_is_tag_ci_quarantine(g: TailscaleGrant) -> Bool {
  grant_src_is_tag_ci(g: g)
    && selector_list_contains(items: g.dst, needle: sel_ipv4(address: dashboard_cutover_mac_ip))
    && selector_list_contains(items: g.dst, needle: sel_tag_dashboard())
    && (length(g.dst) == 2)
    && selector_list_contains(items: g.ip, needle: sel_proto_port(spec: dashboard_tcp_port))
    && (length(g.ip) == 1)
}

fn tag_ci_quarantine_holds(policy: TailscaleAclPolicy) -> Bool {
  let ci_grants = policy.grants |> filter(g => grant_src_is_tag_ci(g: g))
  (length(ci_grants) == 1) && grant_is_tag_ci_quarantine(g: ci_grants.first())
}

fn grant_is_tag_dashboard_self_all_ports(g: TailscaleGrant) -> Bool {
  selector_list_contains(items: g.src, needle: sel_tag_dashboard())
    && selector_list_contains(items: g.dst, needle: sel_tag_dashboard())
    && (length(g.dst) == 1)
    && selector_list_contains(items: g.ip, needle: sel_wildcard())
    && (length(g.ip) == 1)
}

fn grant_is_tag_dashboard_to_ci_ssh(g: TailscaleGrant) -> Bool {
  selector_list_contains(items: g.src, needle: sel_tag_dashboard())
    && selector_list_contains(items: g.dst, needle: sel_tag_ci())
    && (length(g.dst) == 1)
    && selector_list_contains(items: g.ip, needle: sel_proto_port(spec: ssh_tcp_port))
    && (length(g.ip) == 1)
}

fn tag_dashboard_admin_plane_holds(policy: TailscaleAclPolicy) -> Bool {
  let self_grants = policy.grants |> filter(g => grant_is_tag_dashboard_self_all_ports(g: g))
  let ssh_grants = policy.grants |> filter(g => grant_is_tag_dashboard_to_ci_ssh(g: g))
  (length(self_grants) == 1) && (length(ssh_grants) == 1)
}

fn dashboard_cutover_ip_is_transient_in_tag_ci_grant(policy: TailscaleAclPolicy) -> Bool {
  let ci_grants = policy.grants |> filter(g => grant_src_is_tag_ci(g: g))
  (length(ci_grants) == 1)
    && selector_list_contains(
      items: ci_grants.first().dst,
      needle: sel_ipv4(address: dashboard_cutover_mac_ip)
    )
}

fn ssh_rule_matches(
  rule: TailscaleSshRule,
  src: List<TailscaleAclSelector>,
  dst: List<TailscaleAclSelector>,
  users: List<TailscaleAclSelector>
) -> Bool {
  rule.action == ("accept" as NonEmptyStr)
    && rule.src == src
    && rule.dst == dst
    && rule.users == users
}

fn ssh_members_reach_ci_nonroot_only(policy: TailscaleAclPolicy) -> Bool {
  any(
    policy.ssh,
    r => ssh_rule_matches(
      rule: r,
      src: [sel_autogroup(group: "member" as NonEmptyStr)],
      dst: [sel_tag_ci()],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr)]
    )
  )
}

fn ssh_dashboard_reaches_ci_root_and_nonroot(policy: TailscaleAclPolicy) -> Bool {
  any(
    policy.ssh,
    r => ssh_rule_matches(
      rule: r,
      src: [sel_tag_dashboard()],
      dst: [sel_tag_ci()],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr), sel_literal_user(name: "root" as NonEmptyStr)]
    )
  )
}

fn operator_acl_security_spine_holds(policy: TailscaleAclPolicy) -> Bool {
  tag_ci_quarantine_holds(policy: policy)
    && tag_dashboard_admin_plane_holds(policy: policy)
    && dashboard_cutover_ip_is_transient_in_tag_ci_grant(policy: policy)
    && ssh_members_reach_ci_nonroot_only(policy: policy)
    && ssh_dashboard_reaches_ci_root_and_nonroot(policy: policy)
}
