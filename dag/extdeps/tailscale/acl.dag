module extdeps.tailscale.acl

import std.types { String, NonEmptyStr, List, Bool }
import std.disposition { Disposition, Scaffold, SingleAuthority }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https, uri_wire }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "tailscale.com/kb/1018"
  }
}

fn tailscale_grants_external_authority_holds() -> Bool {
  uri_wire(uri: Uri {
    scheme: Https,
    locator: "tailscale.com/kb/1018",
  }) == "https://tailscale.com/kb/1018"
}

data tailscale_acl_policy_language_uri: String = "tailscale.com/kb/1337/acl-syntax"

data dashboard_cutover_mac_ip: NonEmptyStr = "100.65.94.55"

data dashboard_cutover_mac_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.tailscale.acl",
    decl_name: "dashboard_cutover_mac_ip",
    field: WholeDeclaration
  }
}

data tag_ci: NonEmptyStr = "tag:ci"
data tag_dashboard: NonEmptyStr = "tag:dashboard"
// THE SERVING TAG, the identity the serving plane is keyed on. See tag_serving_label for the operator's
// ruling that the fleet's both_participation hosts carry this alongside tag:ci (2026-11-18, chat).
data tag_serving: NonEmptyStr = "tag:serving"
// THE CI-DISPATCH TAG: ephemeral hosted-runner nodes that drive the remote build over the tailnet.
// Operator ruling (@ref
// gunbc.design_ruling::hosted_ci_bridges_to_remote_builds_and_adopts_work_execution_redesign):
// "OK for ci-dispatch, as long as its all modeled/recorded for tailscale
// convergence." The node is ephemeral (self-expires), tagged by the OAuth client, and reaches only the
// remote-build hosts on ssh_tcp_port. It is NOT tag:ci: tag:ci is quarantined (reaches only the dashboard
// on tcp:3737); a hosted runner joining as tag:ci would reach no build host.
data tag_ci_dispatch: NonEmptyStr = "tag:ci-dispatch"
data dashboard_tcp_port: NonEmptyStr = "tcp:3737"
data ssh_tcp_port: NonEmptyStr = "tcp:22"

// dusk-1 is the operator's desktop (WSL) serving an OpenAI-compatible inference API while the
// Sparks are sold. It is an untagged member device, so no tag grant reaches it; this admits only
// the dashboard plane to its API port. tag:ci stays quarantined to the dashboard port.
data dusk_serving_ip: NonEmptyStr = "100.127.39.77"
data dusk_serving_api_tcp_port: NonEmptyStr = "tcp:8080"
// THE SERVING PLANE'S PORT RANGE. The live tailnet grants the dashboard plane reach to nodes carrying
// tag:serving on these ports (added in the admin console 2026-11-18; the operator ruled the fleet's
// both_participation hosts ken and dan carry tag:serving alongside tag:ci on the same date). This is the
// REAL declaration the fleet's auth key cites -- gunbc.tailscale_fleet_auth_key points here for "where
// the ACL's view of that tag lives". Before this row it was a dangling citation (the symbol did not exist).
data tailscale_serving_port_grants: List<NonEmptyStr> = ["tcp:18081-18083"]

type TailscaleAclSelector
  = AclTag { label: NonEmptyStr }
  | AclAutogroup { group: NonEmptyStr }
  | AclIpv4 { address: NonEmptyStr }
  | AclProtoPort { spec: NonEmptyStr }
  | AclLiteralUser { name: NonEmptyStr }
  | AclWildcard

fn render_tailscale_acl_selector(s: TailscaleAclSelector) -> NonEmptyStr {
  match s {
    AclTag { label: l } => concat("tag:", l)
    AclAutogroup { group: g } => concat("autogroup:", g)
    AclIpv4 { address: a } => a
    AclProtoPort { spec: p } => p
    AclLiteralUser { name: n } => n
    AclWildcard => "*" as NonEmptyStr
  }
}

fn sel_tag(label: NonEmptyStr) -> TailscaleAclSelector {
  AclTag { label: label }
}

fn sel_autogroup(group: NonEmptyStr) -> TailscaleAclSelector {
  AclAutogroup { group: group }
}

fn sel_ipv4(address: NonEmptyStr) -> TailscaleAclSelector {
  AclIpv4 { address: address }
}

fn sel_proto_port(spec: NonEmptyStr) -> TailscaleAclSelector {
  AclProtoPort { spec: spec }
}

fn sel_literal_user(name: NonEmptyStr) -> TailscaleAclSelector {
  AclLiteralUser { name: name }
}

fn sel_wildcard() -> TailscaleAclSelector {
  AclWildcard
}

data tag_ci_label: NonEmptyStr = "ci"
data tag_dashboard_label: NonEmptyStr = "dashboard"
// THE SERVING IDENTITY. Nodes carrying tag:serving expose the inference-serving ports. Per the operator's
// ruling of 2026-11-18 ("C both tags is fine"; operator, in chat to smart-crane-730), the fleet's
// both_participation hosts (ken, dan/h11-a16) carry it ALONGSIDE tag:ci, so the fleet converge reaches
// them over the tailnet AND the serving grants still apply. Owner: autogroup:admin (see the tag-owner row).
data tag_serving_label: NonEmptyStr = "serving"
data tag_ci_dispatch_label: NonEmptyStr = "ci-dispatch"

fn sel_tag_ci() -> TailscaleAclSelector {
  sel_tag(label: tag_ci_label)
}

fn sel_tag_dashboard() -> TailscaleAclSelector {
  sel_tag(label: tag_dashboard_label)
}

fn sel_tag_serving() -> TailscaleAclSelector {
  sel_tag(label: tag_serving_label)
}

fn sel_tag_ci_dispatch() -> TailscaleAclSelector {
  sel_tag(label: tag_ci_dispatch_label)
}

fn tailscale_acl_selector_eq(a: TailscaleAclSelector, b: TailscaleAclSelector) -> Bool {
  render_tailscale_acl_selector(s: a) == render_tailscale_acl_selector(s: b)
}

type TailscaleGrant {
  src: List<TailscaleAclSelector>
  dst: List<TailscaleAclSelector>
  ip: List<TailscaleAclSelector>
}

type TailscaleSshRule {
  action: NonEmptyStr
  src: List<TailscaleAclSelector>
  dst: List<TailscaleAclSelector>
  users: List<TailscaleAclSelector>
}

type TailscaleNodeAttr {
  target: List<NonEmptyStr>
  attr: List<NonEmptyStr>
}

type TailscaleTagOwnerRow {
  tag: NonEmptyStr
  owners: List<NonEmptyStr>
}

type TailscaleAclPolicy {
  grants: List<TailscaleGrant>
  ssh: List<TailscaleSshRule>
  node_attrs: List<TailscaleNodeAttr>
  tag_owners: List<TailscaleTagOwnerRow>
}

fn member_baseline_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_autogroup(group: "member" as NonEmptyStr)],
    dst: [sel_wildcard()],
    ip: [sel_wildcard()],
  }
}

fn tag_ci_quarantine_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_ci()],
    dst: [sel_ipv4(address: dashboard_cutover_mac_ip), sel_tag_dashboard()],
    ip: [sel_proto_port(spec: dashboard_tcp_port)],
  }
}

fn tag_dashboard_self_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_dashboard()],
    dst: [sel_tag_dashboard()],
    ip: [sel_wildcard()],
  }
}

fn tag_dashboard_to_ci_ssh_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_dashboard()],
    dst: [sel_tag_ci()],
    ip: [sel_proto_port(spec: ssh_tcp_port)],
  }
}

fn tag_dashboard_to_dusk_serving_api_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_dashboard()],
    dst: [sel_ipv4(address: dusk_serving_ip)],
    ip: [sel_proto_port(spec: dusk_serving_api_tcp_port)],
  }
}

// THE DASHBOARD -> SERVING PLANE. The live tailnet's grant src [tag:dashboard] -> dst [tag:serving], ip
// [tcp:18081-18083], added in the admin console 2026-11-18 (the operator's hand change). dst is the TAG,
// not a pinned IP, so it reaches whichever host carries tag:serving -- the both_participation hosts the
// operator ruled on 2026-11-18 ("C both tags is fine") carry it alongside tag:ci. The port ranges come
// from the single declaration tailscale_serving_port_grants, not a literal, so the ports have one home.
fn tag_dashboard_to_serving_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_dashboard()],
    dst: [sel_tag_serving()],
    ip: map(tailscale_serving_port_grants, p => sel_proto_port(spec: p)),
  }
}

// THE CI-DISPATCH -> BUILD-HOSTS GRANT. The ephemeral hosted-runner (tag:ci-dispatch) may reach SSH
// (tcp:22) on the fleet build hosts (tag:ci, the tailscale_fleet_node_tag carried by srv1/srv3/srv4)
// and nothing else. The security boundary is the forced-command SSH key (gunbc.compute.remote_build
// authorized_keys), not the network: the key restricts to the gunbc-build account's forced command.
// srv1/srv3/srv4 do NOT run Tailscale SSH (tailscale_up_join_argv carries no --ssh flag, join.dag),
// so the regular sshd with its authorized_keys forced_command governs the connection. No Tailscale SSH
// rule for src tag:ci-dispatch is emitted; the network grant is sufficient and the key is the control.
fn tag_ci_dispatch_to_build_hosts_ssh_grant() -> TailscaleGrant {
  TailscaleGrant {
    src: [sel_tag_ci_dispatch()],
    dst: [sel_tag_ci()],
    ip: [sel_proto_port(spec: ssh_tcp_port)],
  }
}

// #gunbc.design_ruling::tailnet_serving_acl_admin_console_additions_2026_11_18
fn operator_tailscale_acl_grants() -> List<TailscaleGrant> {
  [
    member_baseline_grant(),
    tag_ci_quarantine_grant(),
    tag_dashboard_self_grant(),
    tag_dashboard_to_ci_ssh_grant(),
    tag_dashboard_to_dusk_serving_api_grant(),
    tag_dashboard_to_serving_grant(),
    tag_ci_dispatch_to_build_hosts_ssh_grant(),
  ]
}

fn operator_tailscale_acl_ssh() -> List<TailscaleSshRule> {
  [
    TailscaleSshRule {
      action: "accept" as NonEmptyStr,
      src: [sel_autogroup(group: "member" as NonEmptyStr)],
      dst: [sel_autogroup(group: "self" as NonEmptyStr)],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr), sel_literal_user(name: "root" as NonEmptyStr)],
    },
    TailscaleSshRule {
      action: "accept" as NonEmptyStr,
      src: [sel_autogroup(group: "member" as NonEmptyStr)],
      dst: [sel_tag_ci()],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr)],
    },
    TailscaleSshRule {
      action: "accept" as NonEmptyStr,
      src: [sel_tag_dashboard()],
      dst: [sel_tag_ci()],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr), sel_literal_user(name: "root" as NonEmptyStr)],
    },
  ]
}

fn operator_tailscale_acl_node_attrs() -> List<TailscaleNodeAttr> {
  [
    TailscaleNodeAttr {
      target: ["autogroup:member" as NonEmptyStr],
      attr: ["funnel" as NonEmptyStr],
    },
  ]
}

// #gunbc.design_ruling::tailnet_serving_acl_admin_console_additions_2026_11_18
fn operator_tailscale_acl_tag_owners() -> List<TailscaleTagOwnerRow> {
  [
    TailscaleTagOwnerRow { tag: tag_ci, owners: ["autogroup:admin" as NonEmptyStr] },
    TailscaleTagOwnerRow { tag: tag_dashboard, owners: ["autogroup:admin" as NonEmptyStr] },
    // tag:serving is owned by autogroup:admin, matching the live tailnet (added in the admin console
    // 2026-11-18). It governs who may apply the tag to a node; it is NOT a reach grant.
    TailscaleTagOwnerRow { tag: tag_serving, owners: ["autogroup:admin" as NonEmptyStr] },
    TailscaleTagOwnerRow { tag: tag_ci_dispatch, owners: ["autogroup:admin" as NonEmptyStr] },
  ]
}

data operator_tailscale_acl_policy: TailscaleAclPolicy = {
  grants: operator_tailscale_acl_grants(),
  ssh: operator_tailscale_acl_ssh(),
  node_attrs: operator_tailscale_acl_node_attrs(),
  tag_owners: operator_tailscale_acl_tag_owners(),
}

fn selector_list_contains(items: List<TailscaleAclSelector>, needle: TailscaleAclSelector) -> Bool {
  fold(items, init: false, f: (acc, x) => acc || tailscale_acl_selector_eq(a: x, b: needle))
}

fn grant_src_is_tag_ci(g: TailscaleGrant) -> Bool {
  selector_list_contains(items: g.src, needle: sel_tag_ci())
}

fn grant_is_tag_ci_quarantine(g: TailscaleGrant) -> Bool {
  grant_src_is_tag_ci(g: g)
    && selector_list_contains(items: g.dst, needle: sel_ipv4(address: dashboard_cutover_mac_ip))
    && selector_list_contains(items: g.dst, needle: sel_tag_dashboard())
    && (length(g.dst) == 2)
    && selector_list_contains(items: g.ip, needle: sel_proto_port(spec: dashboard_tcp_port))
    && (length(g.ip) == 1)
}

fn tag_ci_quarantine_holds(policy: TailscaleAclPolicy) -> Bool {
  let ci_grants = policy.grants |> filter(g => grant_src_is_tag_ci(g: g))
  match first(ci_grants) {
    Present { value: g } => (length(ci_grants) == 1) && grant_is_tag_ci_quarantine(g: g)
    Absent => false
  }
}

fn grant_is_tag_dashboard_self_all_ports(g: TailscaleGrant) -> Bool {
  selector_list_contains(items: g.src, needle: sel_tag_dashboard())
    && selector_list_contains(items: g.dst, needle: sel_tag_dashboard())
    && (length(g.dst) == 1)
    && selector_list_contains(items: g.ip, needle: sel_wildcard())
    && (length(g.ip) == 1)
}

fn grant_is_tag_dashboard_to_ci_ssh(g: TailscaleGrant) -> Bool {
  selector_list_contains(items: g.src, needle: sel_tag_dashboard())
    && selector_list_contains(items: g.dst, needle: sel_tag_ci())
    && (length(g.dst) == 1)
    && selector_list_contains(items: g.ip, needle: sel_proto_port(spec: ssh_tcp_port))
    && (length(g.ip) == 1)
}

fn tag_dashboard_admin_plane_holds(policy: TailscaleAclPolicy) -> Bool {
  let self_grants = policy.grants |> filter(g => grant_is_tag_dashboard_self_all_ports(g: g))
  let ssh_grants = policy.grants |> filter(g => grant_is_tag_dashboard_to_ci_ssh(g: g))
  (length(self_grants) == 1) && (length(ssh_grants) == 1)
}

fn dashboard_cutover_ip_is_transient_in_tag_ci_grant(policy: TailscaleAclPolicy) -> Bool {
  let ci_grants = policy.grants |> filter(g => grant_src_is_tag_ci(g: g))
  match first(ci_grants) {
    Present { value: g } => (length(ci_grants) == 1) && selector_list_contains(items: g.dst, needle: sel_ipv4(address: dashboard_cutover_mac_ip))
    Absent => false
  }
}

fn ssh_rule_matches(
  rule: TailscaleSshRule,
  src: List<TailscaleAclSelector>,
  dst: List<TailscaleAclSelector>,
  users: List<TailscaleAclSelector>
) -> Bool {
  rule.action == ("accept" as NonEmptyStr)
    && rule.src == src
    && rule.dst == dst
    && rule.users == users
}

fn ssh_members_reach_ci_nonroot_only(policy: TailscaleAclPolicy) -> Bool {
  any(
    policy.ssh,
    r => ssh_rule_matches(
      rule: r,
      src: [sel_autogroup(group: "member" as NonEmptyStr)],
      dst: [sel_tag_ci()],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr)]
    )
  )
}

fn ssh_dashboard_reaches_ci_root_and_nonroot(policy: TailscaleAclPolicy) -> Bool {
  any(
    policy.ssh,
    r => ssh_rule_matches(
      rule: r,
      src: [sel_tag_dashboard()],
      dst: [sel_tag_ci()],
      users: [sel_autogroup(group: "nonroot" as NonEmptyStr), sel_literal_user(name: "root" as NonEmptyStr)]
    )
  )
}

fn grant_reaches_dusk_serving(g: TailscaleGrant) -> Bool {
  selector_list_contains(items: g.dst, needle: sel_ipv4(address: dusk_serving_ip))
}

fn dusk_serving_reached_by_dashboard_api_only(policy: TailscaleAclPolicy) -> Bool {
  let tagged = policy.grants |> filter(g => grant_reaches_dusk_serving(g: g))
  match first(tagged) {
    Present { value: g } =>
      (length(tagged) == 1)
        && (g.src == [sel_tag_dashboard()])
        && (length(g.dst) == 1)
        && (g.ip == [sel_proto_port(spec: dusk_serving_api_tcp_port)])
    Absent => false
  }
}

fn operator_acl_security_spine_holds(policy: TailscaleAclPolicy) -> Bool {
  tag_ci_quarantine_holds(policy: policy)
    && tag_dashboard_admin_plane_holds(policy: policy)
    && dashboard_cutover_ip_is_transient_in_tag_ci_grant(policy: policy)
    && ssh_members_reach_ci_nonroot_only(policy: policy)
    && ssh_dashboard_reaches_ci_root_and_nonroot(policy: policy)
    && dusk_serving_reached_by_dashboard_api_only(policy: policy)
}
