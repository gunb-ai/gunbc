// ── A DEVICE-MEMORY QUERY THAT CAN REFUSE, MODELLED SO THE REFUSAL CANNOT BECOME A NUMBER ─────
//
// WHY THIS MODULE EXISTS, AND IT IS NOT INVENTORY. `nvmlDeviceGetMemoryInfo` is not total on the
// GB10: the memory is UNIFIED, there is no discrete VRAM partition for it to report, and the call
// returns NVML_ERROR_NOT_SUPPORTED. Read on the group A head 2026-09-07 inside the serving
// container:
//
//     current_platform.get_device_name()          -> "NVIDIA GB10"
//     current_platform.get_device_total_memory()  -> NVMLError_NotSupported
//     torch.cuda.get_device_properties(0).total_memory -> 130663231488
//
// So the device HAS 121.7 GiB, a different authority reports it correctly, and only the NVML path
// refuses. A consumer that treats the refusal as an observation gets a device with no memory.
//
// THE CONSTRUCTOR SET IS THE WHOLE POINT. There is deliberately NO way to write a zero-byte
// observation for an unsupported query. DESIGN section 4b(4): the invalid state has no constructor,
// so `device_memory = 0` cannot be authored here at all -- not transiently, not as a default, not
// as a placeholder while a caller decides what to do. What the caller gets is a variant it must
// eliminate exhaustively, and the unsupported arm carries no bytes to accidentally read.
//
// THIS MODULE OWNS THE QUERY, NOT THE CONSEQUENCE. What a downstream does when the query refuses --
// fall back to another authority, refuse itself, or select a conservative default -- is that
// consumer's policy and belongs in its own module. extdeps.vllm.batch_defaults models one such
// consumer and the harm its choice caused.
type DeviceMemoryObservation
  = NvmlDeviceMemoryObserved { bytes: Nat }
  | NvmlDeviceMemoryUnsupportedOnUnifiedMemory { device_name: NonEmptyStr, error: NonEmptyStr }
  | TorchDeviceMemoryObserved { bytes: Nat }
  | DeviceMemoryUnread { because: NonEmptyStr }

// THE OBSERVED ROWS, both from the same device and the same instant, which is what makes the pair
// evidence rather than two anecdotes.
data gb10_nvml_device_memory: DeviceMemoryObservation = NvmlDeviceMemoryUnsupportedOnUnifiedMemory {
  device_name: "NVIDIA GB10" as NonEmptyStr,
  error: "NVMLError_NotSupported raised by nvmlDeviceGetMemoryInfo; the GB10 pool is unified and has no discrete VRAM partition to report" as NonEmptyStr,
}

data gb10_torch_device_memory: DeviceMemoryObservation = TorchDeviceMemoryObserved { bytes: 130663231488 }

// A refusal is not a small number and a fallback is not an observation. This is the predicate a
// consumer must pass before it may use bytes at all.
// A BOOL BESIDE THE BYTES IS TWO REPRESENTATIONS OF ONE FACT, AND THE BOOL HAD NO CONSUMERS. This
// stood as `device_memory_bytes_known`, answering whether a caller MAY read the bytes while leaving
// the caller to read them separately -- so nothing structural stopped a consumer from skipping the
// predicate, and the predicate could not hand back what it had just proved existed. Returning the
// bytes as an option IS the predicate: an arm that carries no measurement cannot produce one, and a
// caller that wants a number has to face the absence to get it.
fn device_memory_observed_bytes(o: DeviceMemoryObservation) -> Nat? {
  match o {
    NvmlDeviceMemoryObserved { bytes: b } => Present { value: b }
    TorchDeviceMemoryObserved { bytes: b } => Present { value: b }
    NvmlDeviceMemoryUnsupportedOnUnifiedMemory { device_name: _, error: _ } => none
    DeviceMemoryUnread { because: _ } => none
  }
}

fn device_memory_note(o: DeviceMemoryObservation) -> NonEmptyStr {
  match o {
    NvmlDeviceMemoryObserved { bytes: _ } =>
      "NVML reported a byte count for a device it can partition" as NonEmptyStr
    TorchDeviceMemoryObserved { bytes: _ } =>
      "the CUDA runtime reported the unified pool's size; on a GB10 this is the authority that answers, and NVML is the one that refuses" as NonEmptyStr
    NvmlDeviceMemoryUnsupportedOnUnifiedMemory { device_name: _, error: _ } =>
      "UNSUPPORTED IS NOT ZERO AND NOT SMALL. A consumer selecting a capacity-dependent default from this arm is selecting it from the absence of an answer, and the arm carries no bytes precisely so that cannot be written" as NonEmptyStr
    DeviceMemoryUnread { because: _ } =>
      "nobody asked, which is distinct from asking and being refused" as NonEmptyStr
  }
}

// ── WHY THE CLOCKS ARE BELOW THEIR MAXIMUM: NVML'S CLOCKS EVENT REASONS ────────────────────────
//
// nvmlDeviceGetCurrentClocksEventReasons returns a bit mask (nvml.h nvmlClocksEventReason*, the
// group linked above; nvidia-smi prints the same mask as clocks_event_reasons.active, formerly
// clocks_throttle_reasons.active). One arm per documented bit, the bit value beside it. A mask bit no
// arm names is kept as a residue, never dropped: a newer driver's reason is still a reason.
type NvmlClocksEventReason
  = NvmlClocksEventGpuIdle
  | NvmlClocksEventApplicationsClocksSetting
  | NvmlClocksEventSwPowerCap
  | NvmlClocksEventHwSlowdown
  | NvmlClocksEventSyncBoost
  | NvmlClocksEventSwThermalSlowdown
  | NvmlClocksEventHwThermalSlowdown
  | NvmlClocksEventHwPowerBrakeSlowdown
  | NvmlClocksEventDisplayClockSetting

fn nvml_clocks_event_reason_bit(r: NvmlClocksEventReason) -> Nat {
  match r {
    NvmlClocksEventGpuIdle => 1
    NvmlClocksEventApplicationsClocksSetting => 2
    NvmlClocksEventSwPowerCap => 4
    NvmlClocksEventHwSlowdown => 8
    NvmlClocksEventSyncBoost => 16
    NvmlClocksEventSwThermalSlowdown => 32
    NvmlClocksEventHwThermalSlowdown => 64
    NvmlClocksEventHwPowerBrakeSlowdown => 128
    NvmlClocksEventDisplayClockSetting => 256
  }
}

data nvml_clocks_event_reasons: List<NvmlClocksEventReason> = [
  NvmlClocksEventGpuIdle,
  NvmlClocksEventApplicationsClocksSetting,
  NvmlClocksEventSwPowerCap,
  NvmlClocksEventHwSlowdown,
  NvmlClocksEventSyncBoost,
  NvmlClocksEventSwThermalSlowdown,
  NvmlClocksEventHwThermalSlowdown,
  NvmlClocksEventHwPowerBrakeSlowdown,
  NvmlClocksEventDisplayClockSetting,
]

type NvmlClocksEventMask {
  reasons: List<NvmlClocksEventReason>
  unmodeled_bits: Nat
}

fn nvml_mask_has_bit(mask: Nat, bit: Nat) -> Bool {
  (mask / bit) - ((mask / bit) / 2) * 2 == 1
}

fn nvml_clocks_event_mask(mask: Nat) -> NvmlClocksEventMask {
  let set = nvml_clocks_event_reasons |> filter(r => nvml_mask_has_bit(mask: mask, bit: nvml_clocks_event_reason_bit(r: r)))
  let named = fold(set, init: 0, f: (acc, r) => acc + nvml_clocks_event_reason_bit(r: r))
  NvmlClocksEventMask { reasons: set, unmodeled_bits: mask - named }
}
