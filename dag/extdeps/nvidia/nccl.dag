module extdeps.nvidia.nccl

import std.types { String, List, NonEmptyStr }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/NVIDIA/nccl/blob/v2.30.4-1/src/transport/net_ib/connect.cc"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.nvidia.nccl",
      decl_name: "NcclRoceGidSelection",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// The NCCL release these semantics were read from. The engine images on the Sparks load
// nccl==2.30.4 (vLLM logs `vLLM is using nccl==2.30.4`).
data nccl_semantics_release: NonEmptyStr = "v2.30.4-1" as NonEmptyStr

// ── HOW NCCL CHOOSES THE GID IT SPEAKS RoCE FROM ────────────────────────────────────────────────
//
// `ncclIbGetGidIndex` has two arms for a RoCE port. A non-negative NCCL_IB_GID_INDEX is returned as
// given, unchecked, and the caller then queries that slot. The default -1 walks the port's GID table
// and keeps the slot whose address family matches NCCL_IB_ADDR_FAMILY (default AF_INET) and whose
// RoCE version matches NCCL_IB_ROCE_VERSION_NUM (default 2).
//
// The fixed arm names a table SLOT, and the kernel is free to renumber slots: a link flap deletes and
// re-adds GIDs, and the re-added IPv4 RoCE v2 entry need not land where it was. A slot left empty
// answers `ibv_query_gid` with EINVAL, which NCCL reports as `unhandled system error` from
// ncclCommInitRank. So a fixed index is a fact about one moment of one port's table, and the
// selection arm is the one that names the thing actually wanted.
type NcclAddressFamily = NcclAfInet | NcclAfInet6

type NcclRoceVersion = NcclRoceV1 | NcclRoceV2

type NcclRoceGidSelection
  = NcclGidByAddressFamily { family: NcclAddressFamily, version: NcclRoceVersion }
  | NcclGidFixedIndex { index: String }

data nccl_ib_gid_index_env: NonEmptyStr = "NCCL_IB_GID_INDEX" as NonEmptyStr
data nccl_ib_addr_family_env: NonEmptyStr = "NCCL_IB_ADDR_FAMILY" as NonEmptyStr
data nccl_ib_roce_version_num_env: NonEmptyStr = "NCCL_IB_ROCE_VERSION_NUM" as NonEmptyStr

// The index value that selects the scanning arm.
data nccl_ib_gid_index_select_by_attributes: String = "-1"

fn nccl_address_family_wire(f: NcclAddressFamily) -> String {
  match f {
    NcclAfInet => "AF_INET"
    NcclAfInet6 => "AF_INET6"
  }
}

fn nccl_roce_version_wire(v: NcclRoceVersion) -> String {
  match v {
    NcclRoceV1 => "1"
    NcclRoceV2 => "2"
  }
}

type NcclEnvAssignment {
  name: NonEmptyStr
  value: String
}

// Every variable the selection is spelled with, all set explicitly. The scanning arm sets the index
// to -1 as well as the two attributes, because a runtime environment that already carries a fixed
// index (a baked image default) would otherwise win over the attributes.
fn nccl_roce_gid_selection_env(s: NcclRoceGidSelection) -> List<NcclEnvAssignment> {
  match s {
    NcclGidByAddressFamily { family: f, version: v } => [
      NcclEnvAssignment { name: nccl_ib_gid_index_env, value: nccl_ib_gid_index_select_by_attributes },
      NcclEnvAssignment { name: nccl_ib_addr_family_env, value: nccl_address_family_wire(f: f) },
      NcclEnvAssignment { name: nccl_ib_roce_version_num_env, value: nccl_roce_version_wire(v: v) },
    ]
    NcclGidFixedIndex { index: i } => [
      NcclEnvAssignment { name: nccl_ib_gid_index_env, value: i },
    ]
  }
}

// ── WHICH TRANSPORT A COMMUNICATOR ACTUALLY BUILT, WHICH NCCL ITSELF ANNOUNCES ──────────────────
//
// WHY THIS IS A SEPARATE FACT FROM THE ENVIRONMENT THAT ASKED FOR IT. The env assignments above --
// and gunbc.spark.pair_serving_observed's CollectiveTransportEnvObserved -- record what the launch
// REQUESTED. They do not record what NCCL BUILT, and the gap between the two is the whole reason
// this type exists: NCCL falls back to Socket silently whenever the IB path is unavailable, and a
// launch whose NCCL_IB_* variables are all set correctly still runs on TCP if the container carries
// no /dev/infiniband node or no CAP_IPC_LOCK. Reading the request and reporting the transport is the
// authority substitution extdeps.vllm.server refuses for version strings, in a second place.
//
// NCCL PUBLISHES THE VERDICT ITSELF, once per communicator init, as the `NCCL INFO ... Using network
// <name>` line. That line is the producer, and it is the only thing here entitled to answer.
//
// THE FALLBACK ARM IS NOT ATTRIBUTED, AND THAT IS DELIBERATE. `NcclTransportSocket` says the verdict
// line named Socket and nothing else. WHY it named Socket -- an absent device node, a missing
// capability, a GID table with no matching entry, a driver that did not load -- is a separate
// question with its own evidence, and folding a guess into this constructor would make an
// unestablished cause indistinguishable from a read one. A consumer that wants the cause reads the
// container's device and capability observations and says so; it does not get the cause from here.
type NcclRealizedTransport
  = NcclTransportIbVerbs { network_name: NonEmptyStr, read_from: NonEmptyStr }
  | NcclTransportSocket { network_name: NonEmptyStr, read_from: NonEmptyStr }
  | NcclTransportUnread { because: NonEmptyStr }

// THE PROJECTION IS THE EQUALITY, as everywhere else a coproduct is compared. The unread arm
// projects to a name no verdict line can produce, so an unread transport can never compare EQUAL to
// a read one: two subjects whose transport nobody looked at are not thereby the same subject.
fn nccl_realized_transport_wire(t: NcclRealizedTransport) -> NonEmptyStr {
  match t {
    NcclTransportIbVerbs { network_name: n, read_from: _ } => n
    NcclTransportSocket { network_name: n, read_from: _ } => n
    NcclTransportUnread { because: _ } => "<transport-unread>" as NonEmptyStr
  }
}

// The literal NCCL emits for each of the two networks it builds on this fleet, so a reader that has
// the log line does not have to guess which spelling the verdict uses.
data nccl_network_name_socket: NonEmptyStr = "Socket" as NonEmptyStr
data nccl_network_name_ib: NonEmptyStr = "IB" as NonEmptyStr
