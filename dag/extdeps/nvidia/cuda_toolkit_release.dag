module extdeps.nvidia.cuda_toolkit_release

import std.types { Bool, List, NonEmptyStr }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef, CitedFigureStanding, CitedToAuthority }
import extdeps.uri { Uri, Https }

// THE MINIMUM LINUX DRIVER A CUDA TOOLKIT RELEASE NEEDS, as NVIDIA's CUDA toolkit release notes state it
// (table "CUDA Toolkit and Minimum Required Driver Version for CUDA Minor Version Compatibility"; CUDA 13.0 GA
// requires driver >= 580.65.06). Only the driver MAJOR is carried: a host's driver is read as a major
// (extdeps.cloud.vast_ai VastAiDriverVersion). A host that reports it can run CUDA N (Vast: cuda_max_good >= N)
// has a driver at or above that release's floor, so a serving recipe derives its driver floor from the CUDA
// major it needs instead of restating a driver number.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.nvidia.com/cuda/cuda-toolkit-release-notes/index.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.nvidia.cuda_toolkit_release",
      decl_name: "CudaToolkitDriverRequirement",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [cuda_12_0_release_notes_authority]
}

type CudaToolkitDriverRequirement {
  toolkit_major: Nat
  min_driver_major: Nat
  standing: CitedFigureStanding
}

data cuda_13_0_driver_requirement: CudaToolkitDriverRequirement = CudaToolkitDriverRequirement {
  toolkit_major: 13,
  min_driver_major: 580,
  standing: CitedToAuthority { authority: extdeps_external_authority_anchor },
}

// ── WHICH GPU ARCHITECTURES A TOOLKIT MAJOR STILL BUILDS FOR ──────────────────────────────────────
//
// A toolkit release removes whole architectures, and it states the removal by compute capability: the CUDA
// 12.0 release notes (archived) say "Support for the following compute capabilities is removed for all
// libraries: sm_35 (Kepler) sm_37 (Kepler)"; the CUDA 13 release notes say "Removed support for Maxwell,
// Pascal, and Volta GPUs, corresponding to compute capabilities earlier than Turing" (Turing is 7.5). Read
// 2026-10-29. So each row is the LOWEST compute capability a toolkit major supports, and a device whose
// compute capability is below it cannot run that toolkit's binaries, whatever the driver says: the driver
// appendix (extdeps.nvidia.linux_driver_supported_chips) still lists Maxwell under the 580 unified driver
// while CUDA 13 no longer targets it. The two are different facts of different upstream documents and a
// consumer reads both (gunbc.gpu_market.software_support).
data cuda_12_0_release_notes_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.nvidia.com/cuda/archive/12.0.0/cuda-toolkit-release-notes/index.html"
  }
}

type CudaToolkitArchitectureFloor {
  toolkit_major: Nat
  minimum_compute_capability_major: Nat
  minimum_compute_capability_minor: Nat
  removed_as_stated: NonEmptyStr
  standing: CitedFigureStanding
}

data cuda_12_architecture_floor: CudaToolkitArchitectureFloor = CudaToolkitArchitectureFloor {
  toolkit_major: 12,
  minimum_compute_capability_major: 5,
  minimum_compute_capability_minor: 0,
  removed_as_stated: "Kepler architecture support is removed from CUDA 12.0. Support for the following compute capabilities is removed for all libraries: sm_35 (Kepler) sm_37 (Kepler)",
  standing: CitedToAuthority { authority: cuda_12_0_release_notes_authority },
}

data cuda_13_architecture_floor: CudaToolkitArchitectureFloor = CudaToolkitArchitectureFloor {
  toolkit_major: 13,
  minimum_compute_capability_major: 7,
  minimum_compute_capability_minor: 5,
  removed_as_stated: "Removed support for Maxwell, Pascal, and Volta GPUs, corresponding to compute capabilities earlier than Turing.",
  standing: CitedToAuthority { authority: extdeps_external_authority_anchor },
}

// Every floor this module states, newest first: a consumer asking "which toolkit majors run this device"
// folds over it.
data cuda_architecture_floors: List<CudaToolkitArchitectureFloor> = [cuda_13_architecture_floor, cuda_12_architecture_floor]

// Whether a device of the given compute capability is at or above a toolkit's floor.
fn cuda_toolkit_targets_capability(floor: CudaToolkitArchitectureFloor, major: Nat, minor: Nat) -> Bool {
  major > floor.minimum_compute_capability_major
    || (major == floor.minimum_compute_capability_major && minor >= floor.minimum_compute_capability_minor)
}
