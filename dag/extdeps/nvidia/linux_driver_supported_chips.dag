module extdeps.nvidia.linux_driver_supported_chips

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.pci.identity { PciDeviceId, PciVendorId }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }

// THE NVIDIA LINUX DRIVER README'S APPENDIX A, "SUPPORTED NVIDIA GPU PRODUCTS", for one pinned release,
// as the README states it. Every table of the appendix is recorded, in document order, and every row of
// every table, so the appendix is a closed population: a product the appendix lists is a row here, and
// one it does not list is absent from every row. That second half is the reason the whole appendix is
// carried rather than the rows a consumer happens to want: absence can only be read off a complete list.
//
// WHAT THE APPENDIX IS, IN ITS OWN WORDS. It lists "which GPUs are supported by a particular driver
// version", and it names the download page's Supported Products List as "the most complete and accurate
// listing". So a device the appendix does not list is not listed as supported by this release's README;
// whether the driver binds to such a device is a reading of the device, not a fact of this module.
//
// IDS ARE CARRIED IN THE LOWERCASE SPELLING extdeps.pci.identity uses (the README prints them uppercase):
// the device id, and where a row states three ids, the subsystem vendor and subsystem device. A row
// stating one id names the device for every subsystem. vdpau_features is the README's VDPAU column as
// stated, a letter naming a feature set or "-".
//
// THE NAME IS THE PRODUCT NAME THE DRIVER USES, the one nvidia-smi prints, so it is the identity a
// receipt's observed GPU name joins through (extdeps.gpu.types GpuBoardCatalogFacts driver_listed_name).

data nvidia_linux_driver_supported_chips_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "download.nvidia.com/XFree86/Linux-x86_64/580.95.05/README/supportedchips.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.nvidia.linux_driver_supported_chips", decl_name: "NvidiaSupportedChipsAppendix", field: WholeDeclaration
  } },
  first_citation: nvidia_linux_driver_supported_chips_authority,
  further_citations: []
}

// The unified driver's own table, or one of the legacy branches the README lists after it ("The 470.xx
// driver supports the following set of GPUs").
type NvidiaDriverBranch = CurrentUnifiedDriver | LegacyDriverBranch { branch: NonEmptyStr }

type NvidiaSupportedChipRow {
  ordinal: Nat
  name: NonEmptyStr
  device_id: PciDeviceId
  subsystem_vendor_id: PciVendorId?
  subsystem_device_id: PciDeviceId?
  vdpau_features: String
}

type NvidiaSupportedChipTable {
  ordinal: Nat
  branch: NvidiaDriverBranch
  row_count: Nat
  rows: List<NvidiaSupportedChipRow>
}

// One release's appendix. html_sha256 is the digest of the README page as fetched.
type NvidiaSupportedChipsAppendix {
  driver_release: NonEmptyStr
  source: ExternalAuthority
  html_sha256: NonEmptyStr
  table_count: Nat
  tables: List<NvidiaSupportedChipTable>
}

// Exactly count_declared ordinals, each below it, none repeated: by pigeonhole that is exactly 0..n-1.
fn nvidia_supported_chips_ordinals_dense(ordinals: List<Nat>, count_declared: Nat) -> Bool {
  count(ordinals) == count_declared
    && ordinals |> all(o => o < count_declared && count(ordinals |> filter(p => p == o)) == 1)
}

// THE APPENDIX IS CLOSED: every table ordinal appears once and every table carries exactly its declared
// rows. A row or table dropped from the module, or recorded twice, makes this false.
fn nvidia_supported_chips_complete(appendix: NvidiaSupportedChipsAppendix) -> Bool {
  nvidia_supported_chips_ordinals_dense(ordinals: appendix.tables |> map(t => t.ordinal), count_declared: appendix.table_count)
    && appendix.tables |> all(t => nvidia_supported_chips_ordinals_dense(ordinals: t.rows |> map(r => r.ordinal), count_declared: t.row_count))
}

fn nvidia_supported_chip_rows(appendix: NvidiaSupportedChipsAppendix) -> List<NvidiaSupportedChipRow> {
  appendix.tables |> flat_map(t => t.rows)
}

// Every row listing this PCI device id, in any table. Empty is a reading: the appendix does not list it.
fn nvidia_supported_chip_rows_for_device(appendix: NvidiaSupportedChipsAppendix, device_id: PciDeviceId) -> List<NvidiaSupportedChipRow> {
  nvidia_supported_chip_rows(appendix: appendix) |> filter(r => (r.device_id as String) == (device_id as String))
}

// Every row listing this product name, exactly as the driver spells it.
fn nvidia_supported_chip_rows_named(appendix: NvidiaSupportedChipsAppendix, name: NonEmptyStr) -> List<NvidiaSupportedChipRow> {
  nvidia_supported_chip_rows(appendix: appendix) |> filter(r => (r.name as String) == (name as String))
}


