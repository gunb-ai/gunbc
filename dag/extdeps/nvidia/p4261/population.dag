// The K1's designator-named positions, read off the silkscreen on the K1 this repository holds.
data p4261_k1_positions: List<P4261DesignPosition> = [
  reconstructed(revision: p4261_k1, designator: "F1", part: fuse(amperes: 12, volts: Absent)),
  reconstructed(revision: p4261_k1, designator: "F300", part: fuse(amperes: 100, volts: Present { value: 75 })),
  unclaimed(revision: p4261_k1, designator: "D2"),
  unclaimed(revision: p4261_k1, designator: "C10_P5"),
  unclaimed(revision: p4261_k1, designator: "C12_P5"),
  reconstructed(revision: p4261_k1, designator: "U1_P5", part: PartRow { row: lm5066i_pwp }),
  unclaimed(revision: p4261_k1, designator: "J68"),
  unclaimed(revision: p4261_k1, designator: "S1"),
  unclaimed(revision: p4261_k1, designator: "S2"),
  unclaimed(revision: p4261_k1, designator: "J30"),
  unclaimed(revision: p4261_k1, designator: "U100"),
  reconstructed(revision: p4261_k1, designator: "U10_P2", part: PartRow { row: mp2333cgtl }),
  unclaimed(revision: p4261_k1, designator: "U2_P2"),
]

// A revision's design positions: the catalogue whose positions name that revision.
fn p4261_positions_of(revision: P4261AssemblyRevision) -> List<P4261DesignPosition> {
  filter(concat(p4261_e1_positions, p4261_k1_positions), d => p4261_revision_eq(a: d.position.revision, b: revision))
}
