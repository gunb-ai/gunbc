import extdeps.electronic_component.nxp_pca9617a { pca9617adp }
import extdeps.electronic_component.mps_mp2333c { mp2333cgtl }
import extdeps.electronic_component.micron_mt25qu01g { mt25qu01gbbb8e12 }
import extdeps.electronic_component.infineon_ipb017n10n5lf { ipb017n10n5lf }
import extdeps.electronic_component.diodes_bss138 { bss138 }
