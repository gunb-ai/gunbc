import extdeps.electronic_component.ti_lm5066i { lm5066i_pwp }
import extdeps.electronic_component.ti_sn74lv165a { sn74lv165a_pw }
import extdeps.electronic_component.ti_sn74avc4t774 { sn74avc4t774_rsv }
import extdeps.electronic_component.ti_sn74lv1t08 { sn74lv1t08_dck }
import std.measure { ampere, volt }
import product.electrical.identification { PrintedRating, PrintedFuseRating }
import extdeps.nvidia.p4261 { P4261AssemblyRevision, p4261_e1, p4261_k1, p4261_revision_eq }

// WHICH PART NVIDIA'S P4261 CARRIES AT EACH DESIGN POSITION, PER ASSEMBLY REVISION. A design position
// is NVIDIA's: the silkscreen designator a revision's layout gives a footprint. Which part the position
// is populated with is NVIDIA's design fact too, whoever reads it. No NVIDIA bill of materials or
// assembly drawing for the P4261 has been found, so every claim here is RECONSTRUCTED from the parts
// this repository read on the boards it holds, and its standing is TranscribedUncited, naming what
// would ground it. Whether a held board's own readings support a claim -- and on which board -- is the
// observing layer's assessment (product.p4261.evidence), never a property authored here.
//
// A POSITION IS LISTED WHETHER OR NOT ITS POPULATION IS KNOWN. Not knowing which part sits at a
// position is our coverage gap, so it is the ABSENCE of a claim, never a claim of its own. Nor does an
// empty footprint read on one board become a claim that the revision leaves the position unpopulated:
// a footprint emptied by us, or one this unit happens to lack, says nothing about NVIDIA's design
// intent, so there is no unpopulated arm.
//
// A position names its revision and its designator and nothing else: its revision is the only source
// of the revision a claim is about, so a claim cannot name one revision and sit in another's list.
//
// The extdeps -> product import (PrintedRating) reuses the generic electrical vocabulary in place
// (approved for Stage B): acyclicity is the import graph's only law (DESIGN 3).
// A position IS its revision plus its designator's exact spelling: the field carries the `Designator`
// authority, so a position cannot be built from text that was tidied on the way in.
type P4261Position {
  revision: P4261AssemblyRevision
  designator: Designator
}

// What a reconstructed claim says the position is populated with. PartConstrainedToRows says the part
// is ONE of these rows -- the reconstruction cannot yet tell which -- not that NVIDIA permits them as
// interchangeable production alternatives.
type PopulatedPart
  = PartRow { row: ElectronicComponentRow }
  | PartConstrainedToRows { rows: List<ElectronicComponentRow> }
  | PrintedRatedPart { rating: PrintedRating }

type PopulationClaim {
  part: PopulatedPart
  standing: CitedFigureStanding
}

type P4261DesignPosition {
  position: P4261Position
  population: PopulationClaim?
}

// The only way a position is minted: from the text as read, lifted into the identity type unchanged.
fn p4261_position(revision: P4261AssemblyRevision, designator: NonEmptyStr) -> P4261Position {
  P4261Position { revision: revision, designator: designator_of(verbatim: designator) }
}

// What our reconstruction says about one designator, looked up by EXACT spelling. Consumers ask this
// instead of casting a designator to text and comparing: a search by a tidied key (underscores gone,
// case folded) would answer for a position NVIDIA may not have, and an invented position is a
// fabricated design fact. A miss is Absent, and the caller says so rather than guessing.
fn p4261_position_at(
  positions: List<P4261DesignPosition>,
  verbatim: NonEmptyStr
) -> P4261DesignPosition? {
  (filter(
    positions,
    p => designator_eq(a: p.position.designator, b: designator_of(verbatim: verbatim))
  )).first()
}

fn bom_obligation(revision: P4261AssemblyRevision, designator: NonEmptyStr) -> NonEmptyStr {
  join(["an NVIDIA bill of materials or assembly drawing for P4261 assembly ", revision.assembly_part_number as String, " revision ", revision.revision_code as String, " naming the part at ", designator as String], "") as NonEmptyStr
}

fn reconstructed(revision: P4261AssemblyRevision, designator: NonEmptyStr, part: PopulatedPart) -> P4261DesignPosition {
  P4261DesignPosition {
    position: p4261_position(revision: revision, designator: designator),
    population: Present { value: PopulationClaim { part: part, standing: TranscribedUncited { read_obligation: bom_obligation(revision: revision, designator: designator) } } },
  }
}

fn unclaimed(revision: P4261AssemblyRevision, designator: NonEmptyStr) -> P4261DesignPosition {
  P4261DesignPosition { position: p4261_position(revision: revision, designator: designator), population: Absent }
}

fn e1_part(designator: NonEmptyStr, row: ElectronicComponentRow) -> P4261DesignPosition {
  reconstructed(revision: p4261_e1, designator: designator, part: PartRow { row: row })
}

fn e1_unclaimed(designator: NonEmptyStr) -> P4261DesignPosition {
  unclaimed(revision: p4261_e1, designator: designator)
}

fn fuse(amperes: Nat, volts: Nat?) -> PopulatedPart {
  PrintedRatedPart { rating: PrintedFuseRating { current: ampere(count: amperes), interrupt_voltage: match volts { Absent => Absent, Present { value: v } => Present { value: volt(count: v) } } } }
}

