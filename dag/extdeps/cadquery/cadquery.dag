module extdeps.cadquery.cadquery

import std.types { Bool, String, NonEmptyStr, List }
import std.measure { Micrometer, micrometer_count }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand, argv_command }
import extdeps.opencascade.ocp { OcpDistribution, OcpWithoutVtk }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "cadquery.readthedocs.io/en/latest/"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cadquery.cadquery",
      decl_name: "cadquery_version",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data cadquery_distribution_name: NonEmptyStr = "cadquery"
data cadquery_version: NonEmptyStr = "2.8.0"

// WHICH KERNEL BUILD THIS PROJECT ASKS FOR. Nothing in this repository renders, so the VTK stack is
// weight with no consumer. The choice is declared here rather than left to pip's default because a
// resolver default is not a decision anyone made, and DESIGN section 2 prices an unexamined default
// the same as an authored one once it is load-bearing.
data cadquery_ocp_distribution: OcpDistribution = OcpWithoutVtk

// PATH-resolved, for the reason extdeps.exec.command program_spelling_is_an_observation_claim
// records: an absolute path is a claim about a filesystem this repository has not observed.
data python_program: NonEmptyStr = "python3"

// RUN ONE EMITTED PROGRAM. The script path is the caller's -- this module has no authority to
// enumerate the programs a consumer might run, exactly as extdeps.tools.make refuses to enumerate
// Makefiles. What this builder owns is that CadQuery programs are executed by the PYTHON
// INTERPRETER and not by a shell, so a path carrying a space or a metacharacter cannot become two
// operands or a second command.
fn cadquery_run_program_command(script_path: String) -> ArgvCommand {
  argv_command(program: python_program, arguments: [script_path])
}

// THE EXPORT KNOBS ARE UPSTREAM'S, AND THEY ARE CARRIED AS UPSTREAM SPELLS THEM.
//
// cq.exporters.export takes `tolerance` in millimetres and `angularTolerance` in RADIANS. gunbc has
// no radian carrier and std.measure declines to mint one on purpose: a turn is exactly divisible
// into degrees and arcseconds, a radian is not, and a total integer conversion would floor and
// invent precision at the unit boundary. So the angular knob is NOT retyped into a gunbc angle
// here. It stays what it is -- an opaque numeric parameter of a third-party exporter -- and the
// safety of a particular setting is established downstream by MEASURING the chord error it produces,
// in a unit this substrate does have. Retyping it would have looked more principled and would have
// asserted an exactness that does not exist.
// THE TWO KNOBS ARE NOT THE SAME KIND OF THING, and an earlier revision typed them alike as text,
// which read as consistency and was a modelling loss on one of them. The ANGULAR knob is genuinely
// an opaque upstream number for the reason above. The LINEAR knob is a LENGTH -- upstream documents
// it in millimetres -- and this substrate carries lengths. Spelling a length as a string merges the
// quantity with its textual realization, which DESIGN section 3 separates: the interface here is a
// length, and the Python spelling is one realization of it.
// RELATIVE IS EXPLICIT BECAUSE IT CHANGES WHAT THE LINEAR NUMBER MEANS. Upstream's `relative` flag
// switches linear deflection between an absolute length and a fraction of the shape's size, so a
// tolerance measured under one interpretation is not a tolerance under the other. Leaving it to the
// default meant every deviation recorded downstream was CONDITIONAL on a value nothing declared --
// the measurement would still have been taken, and would silently have been about a different
// policy than the one being authorized.
type DeflectionInterpretation = AbsoluteDeflection | RelativeDeflection

fn deflection_is_relative(d: DeflectionInterpretation) -> Bool {
  match d {
    AbsoluteDeflection => false
    RelativeDeflection => true
  }
}

fn render_python_bool(b: Bool) -> String {
  if b { "True" } else { "False" }
}

type StlExportKnobs sole_constructor {
  linear_tolerance: Micrometer
  angular_tolerance_text: NonEmptyStr
  deflection: DeflectionInterpretation
}

fn stl_export_knobs(
  linear_tolerance: Micrometer,
  angular_tolerance_text: NonEmptyStr,
  deflection: DeflectionInterpretation,
) -> StlExportKnobs {
  StlExportKnobs {
    linear_tolerance: linear_tolerance,
    angular_tolerance_text: angular_tolerance_text,
    deflection: deflection,
  }
}

// EQUALITY OVER EVERY FIELD, so a consumer asking whether two measurements share a profile cannot be
// answered yes by two profiles that differ in the field it forgot to compare.
fn stl_export_knobs_eq(a: StlExportKnobs, b: StlExportKnobs) -> Bool {
  micrometer_count(m: a.linear_tolerance) == micrometer_count(m: b.linear_tolerance)
  && (a.angular_tolerance_text as String) == (b.angular_tolerance_text as String)
  && deflection_is_relative(d: a.deflection) == deflection_is_relative(d: b.deflection)
}

// RENDERED IN EXPONENT FORM RATHER THAN AS A DECIMAL FRACTION, because a micrometre is exactly one
// thousandth of the millimetre upstream expects, so `<count>e-3` is an EXACT restatement of the
// modelled integer. Emitting "0.001" instead would require zero-padding a fractional field, and a
// padding bug there produces a silently different tolerance rather than a syntax error.
fn render_millimetre_tolerance(t: Micrometer) -> String {
  concat(to_string(micrometer_count(m: t)), "e-3")
}

// THE CALL IS Shape.exportStl AND NOT exporters.export, AND THAT IS FORCED BY THE MODEL RATHER THAN
// PREFERRED. exporters.export takes no `relative` parameter at all: it forwards to exportStl
// positionally and lets relative and parallel fall to their defaults, so relative is True and the
// linear tolerance is a FRACTION OF SHAPE SIZE. This module types that tolerance as a Micrometer --
// an absolute length -- so routing through export would have the emission mean something the model
// does not say, which is the model/emission disagreement class in its purest form.
//
// Measured rather than argued. At one micrometre with relative deflection every hole tessellates to
// the same 126 segments and the deviation SCALES with diameter: 932 nm on a 3 mm hole and 23622 nm
// on a 76 mm bore. Under absolute deflection the segment count adapts -- 126, 141, 148, 613 -- and
// every deviation converges on the tolerance itself, near 1000 nm, which is what an absolute linear
// bound is supposed to do. The earlier claim that the linear knob was inert on these shapes was true
// only under the relative interpretation that nothing had declared.
//
// Every remaining parameter is passed explicitly for the same reason: a default not written down is
// a policy nobody chose, and the measurement above is only about the policy it actually ran under.
fn stl_export_call(destination: String, knobs: StlExportKnobs) -> String {
  join([
    "result.val().exportStl(\"", destination, "\"",
    ", tolerance=", render_millimetre_tolerance(t: knobs.linear_tolerance),
    ", angularTolerance=", knobs.angular_tolerance_text as String,
    ", ascii=False",
    ", relative=", render_python_bool(b: deflection_is_relative(d: knobs.deflection)),
    ", parallel=True",
    ")\n",
  ], "")
}
