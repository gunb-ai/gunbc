module extdeps.git.publication_transport


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "git-scm.com/docs/git-push"
  }
}

data git_commit_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "git-scm.com/docs/git-commit"
  }
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.git.publication_transport",
      decl_name: "PublicationTransport",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.git.publication_transport.extdeps_external_authority_anchor,
  further_citations: [git_commit_external_authority_anchor]
}

// Modeled upstream publication write operations de-fused from git.Core. GitPushRequest and GitCommitRequest are the interface shapes; shell argv lives only in git.PublicationTransport service transport rows — no parallel free-fn argv surface. Slice 1 is model + shadow only — consumers route through tools.publication_publisher before binding a transport handler in the live slice.
type GitRefUpdateSpec {
  local_ref: std.types.GitRef
  remote_ref: std.types.GitRef
}

type GitPushRequest {
  remote: std.types.NonEmptyStr
  ref_updates: List<GitRefUpdateSpec>
}

type GitCommitRequest {
  message: std.types.NonEmptyStr
  allow_empty: Bool
}

// GitCommitRequest.allow_empty selects RecordEmptyCommit vs RecordCommit at transport bind — two operations, because shell argv templates cannot branch on Bool.
service git.PublicationTransport {
  operation PushRefUpdate {
    input {
      remote: std.types.NonEmptyStr
      refspec: std.types.NonEmptyStr
    }
    output {
      exit_code: Int from "exit_code"
      stderr: String from "stderr"
      success: Bool from "exit_success"
    }
    transport shell { argv: ["git", "push", "{remote}", "{refspec}"] }
    exit {
      0 => Unit
      nonzero => String "Push failed"
    }
  }

  operation RecordCommit {
    input {
      message: std.types.NonEmptyStr
    }
    output {
      sha: std.types.CommitSha from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["git", "commit", "-m", "{message}"] }
    exit {
      0 => Unit
      nonzero => String "Commit failed"
    }
  }

  operation RecordEmptyCommit {
    input {
      message: std.types.NonEmptyStr
    }
    output {
      sha: std.types.CommitSha from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["git", "commit", "--allow-empty", "-m", "{message}"] }
    exit {
      0 => Unit
      nonzero => String "Commit failed"
    }
  }
}
