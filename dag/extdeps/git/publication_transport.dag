module extdeps.git.publication_transport

import std.types { Bool, CommitSha, GitRef, Int, List, NonEmptyStr, String }
import extdeps.git.object_store { GitObjectId, GitRefName, git_object_id_wire_hex }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "git-scm.com/docs/git-push"
  }
}

data git_commit_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "git-scm.com/docs/git-commit"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.git.publication_transport",
      decl_name: "PublicationTransport",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [git_commit_external_authority_anchor]
}

// Modeled upstream publication write operations de-fused from git.Core. GitPushRequest and GitCommitRequest are the interface shapes; shell argv lives only in git.PublicationTransport service transport rows — no parallel free-fn argv surface. Slice 1 is model + shadow only — consumers route through tools.publication_publisher before binding a transport handler in the live slice.
type GitRefUpdateSpec {
  local_ref: GitRef
  remote_ref: GitRef
}

type GitPushRequest {
  remote: NonEmptyStr
  ref_updates: List<GitRefUpdateSpec>
}

type GitCommitRequest {
  message: NonEmptyStr
  allow_empty: Bool
}

// A REMOTE REF ADVANCE IS A COMPARE-AND-SWAP, AND PushRefUpdate ABOVE CANNOT EXPRESS ONE.
// Its argv is `git push {remote} {refspec}`, which refuses only non-fast-forwards -- a weaker
// and DIFFERENT guarantee than naming the prior. Two advances racing on one ref are both
// fast-forwards, so both succeed and the later silently discards the earlier's decision.
// `--force-with-lease=<ref>:<expect>` refuses unless the remote ref still holds <expect>, which
// is what makes the loser of a race refuse instead of overwrite.
//
// CREATION IS THE SAME OPERATION WITH AN EMPTY <expect> -- git's documented spelling for "the
// ref must not already exist" -- so ref creation stays a compare-and-swap rather than falling
// back to an unconditional push. That is why the expectation is a closed sum here and not a
// GitObjectId? : `none` on an option is one value doing two jobs, and the job it silently
// acquires is "I could not observe the ref", which must never render as "therefore create it".
// RemoteRefMustBeAbsent is a claim about the remote; an unobserved remote is not that claim.
type GitRemoteRefExpectation
  = RemoteRefMustBeAbsent
  | RemoteRefMustEqual { oid: GitObjectId }

type GitRemoteRefCasRequest {
  remote: NonEmptyStr
  ref_name: GitRefName
  new_oid: GitObjectId
  expected: GitRemoteRefExpectation
}

// The lease and refspec are rendered HERE, in the model, and reach the transport as opaque
// words. This is the same constraint RecordCommit/RecordEmptyCommit resolves by splitting into
// two operations -- a shell argv template cannot branch -- but the branch is over a closed sum
// whose arms differ only in one rendered value, so collapsing it in a pure function keeps ONE
// operation and one argv template. Splitting into CreateRemoteRefIfAbsent /
// UpdateRemoteRefIfCurrent would fork one upstream operation into two rows that git does not
// distinguish.
fn git_remote_ref_lease_word(request: GitRemoteRefCasRequest) -> NonEmptyStr {
  let expected_text = match request.expected {
    RemoteRefMustBeAbsent => ""
    RemoteRefMustEqual { oid: prior } => git_object_id_wire_hex(oid: prior) as String
  }
  concat("--force-with-lease=", concat(request.ref_name as String, concat(":", expected_text)))
}

fn git_remote_ref_cas_refspec(request: GitRemoteRefCasRequest) -> NonEmptyStr {
  concat(git_object_id_wire_hex(oid: request.new_oid) as String, concat(":", request.ref_name as String))
}

// PushRefUpdateWithLease -- the compare-and-swap publication. `lease` and `refspec` are meant to
// come from git_remote_ref_lease_word / git_remote_ref_cas_refspec over ONE
// GitRemoteRefCasRequest, which is what keeps this template literal.
//
// THE ROW DOES NOT ENFORCE THAT, AND AN EARLIER REVISION OF THIS COMMENT SAID THEY "ARRIVE
// PRE-RENDERED" AS THOUGH IT DID. The inputs are three independent NonEmptyStr, so nothing at
// this boundary requires the lease and the refspec to have been derived from the same request,
// or from those functions at all: a caller can pair a lease naming one ref with a refspec
// moving another, and the transport will run it (raised in side-chat review, 2026-08-21).
//
// RUNG: mitigatable, and this row is a WIRE CAPABILITY rather than a safe operation. The
// invariant is real and is currently carried by nothing -- there are no consumers yet, so
// nothing is misled today, which is the only reason this is not a defect in production.
// NEXT TRIGGER: the first production consumer, which must reach this row through one binder
//   push_remote_ref_compare_and_swap(request) ->
//     PushRefUpdateWithLease(remote: request.remote,
//                            lease: git_remote_ref_lease_word(request),
//                            refspec: git_remote_ref_cas_refspec(request))
// and no gunbc consumer may supply `lease` or `refspec` independently. The binder lands with
// that consumer rather than here, because a binder with no caller is the unconsumed capability
// this PR already removed once.
//
// THIS OPERATION DOES NOT DISTINGUISH A REFUSED LEASE FROM A FAILED PUSH, and the distinction
// is real: a refused lease is an ANSWER -- the remote moved under us, the caller's observed
// prior is stale, retry after re-observing -- while a transport failure is an absence of any
// answer, whose remedy is not retrying with a fresh prior. Both arrive here as `nonzero` and
// one `String`. An earlier revision of this comment asserted that the two "must not be
// collapsed" while the exit block below collapsed them, which is a claim the code does not
// carry (raised in review 54192); it is corrected rather than deleted, because a consumer
// reading only the warning would have believed the transport separated them.
//
// WHY IT IS NOT FIXED HERE: git reports both as exit 1, and the discriminating evidence is
// the "(stale info)" / "[rejected]" text on stderr. Deciding an outcome by matching upstream
// human-readable output is its own modeling job with its own cited authority, and guessing at
// it inside this row would fabricate a distinction rather than ground one.
//
// RUNG: mitigatable. The evidence is retained -- `exit_code` and `stderr` are both output
// fields -- so a caller CAN recover the distinction; nothing here derives it for them, and no
// caller exists yet to be misled. NEXT TRIGGER: the first consumer that must retry on a stale
// prior, which needs a cited decoder for git's push-rejection output before this arm can
// carry a typed outcome.
//
// GitCommitRequest.allow_empty selects RecordEmptyCommit vs RecordCommit at transport bind — two operations, because shell argv templates cannot branch on Bool.
service git.PublicationTransport {
  operation PushRefUpdate {
    input {
      remote: NonEmptyStr
      refspec: NonEmptyStr
    }
    output {
      exit_code: Int from "exit_code"
      stderr: String from "stderr"
      success: Bool from "exit_success"
    }
    transport shell { argv: ["git", "push", "{remote}", "{refspec}"] }
    exit {
      0 => Unit
      nonzero => String "Push failed"
    }
  }

  operation PushRefUpdateWithLease {
    input {
      remote: NonEmptyStr
      refspec: NonEmptyStr
      lease: NonEmptyStr
    }
    output {
      exit_code: Int from "exit_code"
      stderr: String from "stderr"
      success: Bool from "exit_success"
    }
    transport shell { argv: ["git", "push", "{lease}", "{remote}", "{refspec}"] }
    exit {
      0 => Unit
      nonzero => String "Leased push refused or failed"
    }
  }

  operation RecordCommit {
    input {
      message: NonEmptyStr
    }
    output {
      sha: CommitSha from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["git", "commit", "-m", "{message}"] }
    exit {
      0 => Unit
      nonzero => String "Commit failed"
    }
  }

  operation RecordEmptyCommit {
    input {
      message: NonEmptyStr
    }
    output {
      sha: CommitSha from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    transport shell { argv: ["git", "commit", "--allow-empty", "-m", "{message}"] }
    exit {
      0 => Unit
      nonzero => String "Commit failed"
    }
  }
}
