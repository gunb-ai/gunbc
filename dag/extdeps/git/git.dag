module extdeps.git

import std.types { CommitSha, Email, FilePath, GitRef, NonEmptyStr, Timestamp }
import std.measure { Percent, percent }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "git-scm.com/docs"
  }
}

data git_diff_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "git-scm.com/docs/git-diff"
  }
}

type ObjectType = BlobObj | TreeObj | CommitObj | TagObj

type GitAuthor {
  name: String
  email: Email
  timestamp: Timestamp
}

type GitBranch {
  name: String
  upstream: String?
  is_head: Bool
}

type GitRemote {
  name: String
  url: NonEmptyStr
  fetch_refspec: String
}

type GitWorktreeHead
  = WorktreeOnBranch { branch: GitBranch }
  | WorktreeDetached { sha: CommitSha }

type GitWorktree {
  path: FilePath
  head: GitWorktreeHead
  is_main: Bool
  locked: Bool
}

type DiffStat {
  files_changed: Int
  insertions: Int
  deletions: Int
}

type DiffLine
  = DiffAdded { content: String }
  | DiffRemoved { content: String }
  | DiffContext { content: String }

type DiffHunk {
  file_path: String
  old_start: Int
  new_start: Int
  lines: List<DiffLine>
}

type GitDiffChangeStatus
  = DiffAddedStatus
  | DiffCopiedStatus { similarity: Percent }
  | DiffDeletedStatus
  | DiffModifiedStatus
  | DiffPairingBrokenStatus
  | DiffRenamedStatus { similarity: Percent }
  | DiffTypeChangedStatus
  | DiffUnmergedStatus
  | DiffUnknownGitStatus { raw: String }

type GitDiffStatusEntry {
  status: GitDiffChangeStatus
  path: FilePath
  old_path: FilePath?
}

type GitDiffNameStatusParsePending
  = AwaitingStatusToken
  | AwaitingSinglePath { status: GitDiffChangeStatus }
  | AwaitingOldPath { status: GitDiffChangeStatus }
  | AwaitingNewPath { status: GitDiffChangeStatus, old_path: FilePath }

type GitDiffNameStatusParseState {
  pending: GitDiffNameStatusParsePending
  entries: List<GitDiffStatusEntry>
}

data git_diff_name_status_field_separator: String = from_code_point(0)

fn git_diff_change_status_from_token(token: String) -> GitDiffChangeStatus {
  let letter = substring(s: token, start: 0, end: 1)
  let rest = substring(s: token, start: 1, end: string_length(s: token))
  if letter == "A" { DiffAddedStatus }
  else if letter == "D" { DiffDeletedStatus }
  else if letter == "M" { DiffModifiedStatus }
  else if letter == "T" { DiffTypeChangedStatus }
  else if letter == "U" { DiffUnmergedStatus }
  else if letter == "B" { DiffPairingBrokenStatus }
  else if letter == "R" {
    match parse_int(s: rest) {
      Present { value: score } => DiffRenamedStatus { similarity: percent(score) }
      Absent => DiffUnknownGitStatus { raw: token }
    }
  }
  else if letter == "C" {
    match parse_int(s: rest) {
      Present { value: score } => DiffCopiedStatus { similarity: percent(score) }
      Absent => DiffUnknownGitStatus { raw: token }
    }
  }
  else { DiffUnknownGitStatus { raw: token } }
}

fn git_diff_name_status_pending_after_status(status: GitDiffChangeStatus) -> GitDiffNameStatusParsePending {
  match status {
    DiffRenamedStatus { similarity: _ } => AwaitingOldPath { status: status }
    DiffCopiedStatus { similarity: _ } => AwaitingOldPath { status: status }
    _ => AwaitingSinglePath { status: status }
  }
}

fn git_diff_name_status_advance(state: GitDiffNameStatusParseState, token: String) -> GitDiffNameStatusParseState {
  if token == "" {
    state
  } else {
    match state.pending {
      AwaitingStatusToken => GitDiffNameStatusParseState {
        pending: git_diff_name_status_pending_after_status(status: git_diff_change_status_from_token(token: token)),
        entries: state.entries
      }
      AwaitingSinglePath { status: status } => GitDiffNameStatusParseState {
        pending: AwaitingStatusToken,
        entries: append(state.entries, items: [GitDiffStatusEntry { status: status, path: token, old_path: Absent }])
      }
      AwaitingOldPath { status: status } => GitDiffNameStatusParseState {
        pending: AwaitingNewPath { status: status, old_path: token },
        entries: state.entries
      }
      AwaitingNewPath { status: status, old_path: old_path } => GitDiffNameStatusParseState {
        pending: AwaitingStatusToken,
        entries: append(state.entries, items: [GitDiffStatusEntry { status: status, path: token, old_path: Present { value: old_path } }])
      }
    }
  }
}

fn parse_git_diff_name_status_z(raw: String) -> List<GitDiffStatusEntry> {
  let tokens = split(s: raw, delimiter: git_diff_name_status_field_separator)
  let final_state = fold(
    tokens,
    init: GitDiffNameStatusParseState { pending: AwaitingStatusToken, entries: [] },
    f: git_diff_name_status_advance
  )
  final_state.entries
}

fn git_diff_status_entry_touched_paths(entry: GitDiffStatusEntry) -> List<FilePath> {
  match entry.old_path {
    Present { value: old } => [entry.path, old]
    Absent => [entry.path]
  }
}

fn git_diff_status_touched_paths_step(acc: List<FilePath>, entry: GitDiffStatusEntry) -> List<FilePath> {
  append(acc, items: git_diff_status_entry_touched_paths(entry: entry))
}

fn git_diff_status_entries_touched_paths(entries: List<GitDiffStatusEntry>) -> List<FilePath> {
  fold(entries, init: [], f: git_diff_status_touched_paths_step)
}

fn git_diff_status_entry_departed_path(entry: GitDiffStatusEntry) -> FilePath? {
  match entry.status {
    DiffDeletedStatus => Present { value: entry.path }
    DiffRenamedStatus { similarity: _ } => entry.old_path
    _ => Absent
  }
}

fn git_diff_status_departed_paths_step(acc: List<FilePath>, entry: GitDiffStatusEntry) -> List<FilePath> {
  match git_diff_status_entry_departed_path(entry: entry) {
    Present { value: path } => append(acc, items: [path])
    Absent => acc
  }
}

fn git_diff_status_entries_departed_paths(entries: List<GitDiffStatusEntry>) -> List<FilePath> {
  fold(entries, init: [], f: git_diff_status_departed_paths_step)
}

fn git_diff_status_entry_is_unknown(entry: GitDiffStatusEntry) -> Bool {
  match entry.status {
    DiffUnknownGitStatus { raw: _ } => true
    _ => false
  }
}

fn git_diff_status_unknown_step(acc: Bool, entry: GitDiffStatusEntry) -> Bool {
  acc || git_diff_status_entry_is_unknown(entry: entry)
}

fn git_diff_status_entries_any_unknown(entries: List<GitDiffStatusEntry>) -> Bool {
  fold(entries, init: false, f: git_diff_status_unknown_step)
}

data default_remote: String = "origin"

data default_branch_names: List<String> = ["main", "master"]

service git.Core {
  operation CurrentBranch {
    input {}
    output { branch: String from "stdout" }
    readonly
    transport shell { argv: ["git", "rev-parse", "--abbrev-ref", "HEAD"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
  }

  operation HeadCommit {
    input {}
    output {
      sha: CommitSha from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["git", "rev-parse", "HEAD"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
  }

  operation RemoteBranches {
    input {}
    output { branches: List<String> from "stdout_lines" }
    readonly
    transport shell { argv: ["git", "branch", "-r", "--format=%(refname:short)"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
  }

  operation LsFiles {
    input {}
    output { files: List<FilePath> from "stdout_lines" }
    readonly
    transport shell { argv: ["git", "ls-files"] }
    exit {
      0 => Unit
      128 => String "Not a git repository"
    }
  }

  operation Diff {
    input { base: GitRef, head: GitRef = "HEAD" }
    output { diff: String from "stdout" }
    readonly
    transport shell { argv: ["git", "diff", "{base}", "{head}"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation DiffNameOnly {
    input { base: GitRef, head: GitRef = "HEAD" }
    output {
      paths: List<FilePath> from "stdout_lines"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["git", "diff", "--name-only", "{base}", "{head}"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation DiffNameOnlyMerge {
    input { base: GitRef, head: GitRef = "HEAD" }
    output {
      paths: List<FilePath> from "stdout_lines"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["git", "diff", "--name-only", "{base}...{head}"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation DiffNameStatus {
    input { base: GitRef, head: GitRef = "HEAD" }
    output {
      raw: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["git", "diff", "--name-status", "-z", "{base}", "{head}"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation DiffNameStatusMerge {
    input { base: GitRef, head: GitRef = "HEAD" }
    output {
      raw: String from "stdout"
      success: Bool from "exit_success"
    }
    readonly
    transport shell { argv: ["git", "diff", "--name-status", "-z", "{base}...{head}"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation RevList {
    input { since: String }
    output { commits: List<CommitSha> from "stdout_lines" }
    readonly
    transport shell { argv: ["git", "rev-list", "{since}..HEAD"] }
    exit {
      0 => Unit
      128 => String "Invalid ref or not a git repository"
    }
  }

  operation RevListBefore {
    input { before: String }
    output { base_ref: CommitSha from "stdout" }
    readonly
    transport shell { argv: ["git", "rev-list", "-1", "--before={before}", "HEAD"] }
    exit {
      0 => Unit
      128 => String "Invalid date expression or not a git repository"
    }
  }

  operation Show {
    input { ref: GitRef, path: FilePath }
    output { content: String from "stdout" }
    readonly
    transport shell { argv: ["git", "show", "{ref}:{path}"] }
    exit {
      0 => Unit
      128 => String "File not found or invalid ref"
    }
  }
}

fn shape_git_worktree_add_argv(path: FilePath, branch: NonEmptyStr, remote_ref: GitRef) -> List<String> {
  ["worktree", "add", path as String, "-b", branch as String, remote_ref as String]
}

service git.Worktree {
  operation Add {
    input { path: FilePath, branch: NonEmptyStr, remote_ref: GitRef }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    transport shell { argv: ["git", "worktree", "add", "{path}", "-b", "{branch}", "{remote_ref}"] }
    exit {
      0 => Unit
      nonzero => String "Worktree add failed"
    }
  }
}
