module extdeps.git.versioning

import std.types { NonEmptyStr, brand }
import std.integer { NonNegativeInt }
import std.algebra { Ordering, Equal, Greater }
import std.nat { nat_compare }
import extdeps.version { VersionIdentity, VersionComparison, VersionCompared, VersionComparisonRefused, VersionScheme, VersionConstraint, ComparisonSide, LeftOperand, RightOperand }
import extdeps.version.semver { semver_core_parse }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "git-scm.com/docs/BreakingChanges.html"
  }
}

type GitReleaseVersion {
  major: NonNegativeInt
  minor: NonNegativeInt
  patch: NonNegativeInt
}

type GitVersionPlatformSuffix
  = GitVersionPlain
  | GitVersionWindows { build: NonNegativeInt }

type GitCliReportedVersion {
  git_release: GitReleaseVersion
  suffix: GitVersionPlatformSuffix
}

data git_2_0_release: GitReleaseVersion = {
  major: 2,
  minor: 0,
  patch: 0
}

data git_release_versioning_spec_url: NonEmptyStr = "https://git-scm.com/docs/BreakingChanges.html"

type GitVersionConstraint = VersionConstraint where brand("GitVersionConstraint")

data min_git_version: GitVersionConstraint = ">= 2.0.0"

fn git_release_version_label(v: GitReleaseVersion) -> String {
  concat(
    to_string(v.major),
    concat(".", concat(to_string(v.minor), concat(".", to_string(v.patch))))
  )
}

fn git_release_to_version_identity(v: GitReleaseVersion) -> VersionIdentity {
  git_release_version_label(v: v)
}

fn git_release_version_compare(a: GitReleaseVersion, b: GitReleaseVersion) -> Ordering {
  match nat_compare(a: a.major, b: b.major) {
    Equal => match nat_compare(a: a.minor, b: b.minor) {
      Equal => nat_compare(a: a.patch, b: b.patch)
      other => other
    }
    other => other
  }
}

// ---- identity compare -----------------------------------------------------------------------
// The label is a VersionScheme's only handle, so the comparison parses the label back into the
// typed form and routes through git_release_version_compare — the ONE implementation of the cited
// numeric rule for this scheme. The LABEL GRAMMAR is not re-invented here: a git release version
// is a bare MAJOR.MINOR.PATCH triple, which is exactly the SemVer 2.0.0 core, so the parse
// consumes extdeps.version.semver's core parse (three dot-separated digit runs, no leading
// zeroes) and refuses anything else. A label outside that grammar is a located refusal: the
// carrier names the failing side, the label, and the cause.

fn git_release_identity_parse(identity: VersionIdentity) -> GitReleaseVersion? {
  match semver_core_parse(cps: chars(s: identity as String)) {
    Absent => none
    Present { value: v } =>
      Present { value: GitReleaseVersion { major: v.major, minor: v.minor, patch: v.patch } }
  }
}

fn git_release_compare_identity(a: VersionIdentity, b: VersionIdentity) -> VersionComparison {
  match git_release_identity_parse(identity: a) {
    Absent => VersionComparisonRefused { side: LeftOperand, identity: a as String, cause: "label is not a git release version: a bare MAJOR.MINOR.PATCH triple of digit runs without leading zeroes is required" }
    Present { value: va } =>
      match git_release_identity_parse(identity: b) {
        Absent => VersionComparisonRefused { side: RightOperand, identity: b as String, cause: "label is not a git release version: a bare MAJOR.MINOR.PATCH triple of digit runs without leading zeroes is required" }
        Present { value: vb } => VersionCompared { ordering: git_release_version_compare(a: va, b: vb) }
      }
  }
}

data git_release_version_scheme: VersionScheme = VersionScheme {
  compare: git_release_compare_identity
}
