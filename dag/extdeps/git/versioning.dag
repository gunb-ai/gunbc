=======
// THE ANCHOR IS DERIVED THROUGH THE PARSER, never raw lists: the fields come from parsing
// the literal release text, so the confined constructor's admission is the only producer.
// The fallback is unreachable for a parsable literal, and the round-trip witness pins the
// label to "2.0.0" by execution, so a forged or control-character field cannot pass.
data git_2_0_release: GitReleaseVersion = match semver_core_parse(cps: chars(s: "2.0.0")) {
  Present { value: v } => GitReleaseVersion { major: v.major, minor: v.minor, patch: v.patch }
  other => GitReleaseVersion { major: semver_numeric_field(cps: chars(s: "0")).?, minor: semver_numeric_field(cps: chars(s: "0")).?, patch: semver_numeric_field(cps: chars(s: "0")).? }
