module extdeps.git.versioning


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "git-scm.com/docs/BreakingChanges.html"
  }
}

type GitReleaseVersion {
  major: std.integer.NonNegativeInt
  minor: std.integer.NonNegativeInt
  patch: std.integer.NonNegativeInt
}

type GitVersionPlatformSuffix
  = GitVersionPlain
  | GitVersionWindows { build: std.integer.NonNegativeInt }

type GitCliReportedVersion {
  git_release: GitReleaseVersion
  suffix: GitVersionPlatformSuffix
}

data git_2_0_release: GitReleaseVersion = {
  major: 2,
  minor: 0,
  patch: 0
}

data git_release_versioning_spec_url: std.types.NonEmptyStr = "https://git-scm.com/docs/BreakingChanges.html"

type GitVersionConstraint = extdeps.version.VersionConstraint where brand("GitVersionConstraint")

data min_git_version: GitVersionConstraint = ">= 2.0.0"

fn git_release_version_label(v: GitReleaseVersion) -> String {
  concat(
    to_string(v.major),
    concat(".", concat(to_string(v.minor), concat(".", to_string(v.patch))))
  )
}

fn git_release_to_version_identity(v: GitReleaseVersion) -> extdeps.version.VersionIdentity {
  git_release_version_label(v: v)
}

fn git_release_version_compare(a: GitReleaseVersion, b: GitReleaseVersion) -> std.algebra.Ordering {
  match std.nat.nat_compare(a: a.major, b: b.major) {
    Equal => match std.nat.nat_compare(a: a.minor, b: b.minor) {
      Equal => std.nat.nat_compare(a: a.patch, b: b.patch)
      other => other
    }
    other => other
  }
}

fn git_release_compare_identity(a: extdeps.version.VersionIdentity, b: extdeps.version.VersionIdentity) -> std.algebra.Ordering {
  if a == b { Equal } else { Greater }
}

data git_release_version_scheme: extdeps.version.VersionScheme = {
  compare: git_release_compare_identity
}
