module extdeps.uuid

import std.types { String, NonEmptyStr, Int, List, Bool, brand }
import std.optional { Present }
import std.unicode.scalar { ascii_lowercase }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc9562"
  }
}

// Reading: RFC 9562 owns the canonical UUID string form (8-4-4-4-12, 36 chars); data uuid_canonical_length and its sibling group-lengths datum transcribe exactly that canonical form.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef { declaration: DeclarationRef {
    module_path: "extdeps.uuid", decl_name: "uuid_canonical_length", field: WholeDeclaration
  } },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// RFC 9562 (obsoletes RFC 4122) defines the UUID and its canonical textual form: 32 hexadecimal
// digits in five hyphen-separated groups of 8-4-4-4-12, thirty-six characters. It is an IETF
// concept, so a vendor field holding one is not thereby a vendor type — several unrelated
// dependencies here carry account and session identifiers in exactly this shape, and re-typing each
// as its own NonEmptyStr would coin the concept once per consumer.
//
// The brand makes the shape claim checkable: a 36-character string is not a UUID; one matching the
// canonical layout is. Section 4 also fixes the reading order — big-endian textual form, version
// and variant at fixed positions — so a UUID must never be compared case-sensitively or reordered
// as bytes without consulting that section.
//
// Deliberately NOT modeled: version extraction, variant bits, generation. This module lets
// consumers say a field IS a UUID rather than a string that looks like one; minting and inspecting
// land with the consumer that needs them.

type Uuid = NonEmptyStr where brand("Uuid")

data uuid_canonical_length: Int = 36
data uuid_canonical_group_lengths: List<Int> = [8, 4, 4, 4, 12]

// DECODE: a text is a Uuid exactly when it is the canonical 8-4-4-4-12 form of RFC 9562 section 4, in
// any hex case (section 4 lets a consumer read upper and mixed case; the decode folds to lowercase, the
// producer spelling, so text comparison is case-stable). A stricter spelling belongs at the boundary that
// compares text. A text of any other shape is no Uuid: the brand alone never checked the layout, so
// a consumer that reads a Uuid from text goes through here and refuses on Absent.
fn uuid_hex_digit(c: String) -> Bool {
  (c >= "0" && c <= "9") || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
}

fn uuid_group_holds(t: String, start: Int, length: Int, i: Int) -> Bool {
  if i >= length { true } else { uuid_hex_digit(c: char_at(s: t, pos: start + i)) && uuid_group_holds(t: t, start: start, length: length, i: i + 1) }
}

fn uuid_canonical_text(t: String) -> Bool {
  string_length(s: t) == uuid_canonical_length
    && char_at(s: t, pos: 8) == "-" && char_at(s: t, pos: 13) == "-" && char_at(s: t, pos: 18) == "-" && char_at(s: t, pos: 23) == "-"
    && uuid_group_holds(t: t, start: 0, length: 8, i: 0) && uuid_group_holds(t: t, start: 9, length: 4, i: 0)
    && uuid_group_holds(t: t, start: 14, length: 4, i: 0) && uuid_group_holds(t: t, start: 19, length: 4, i: 0)
    && uuid_group_holds(t: t, start: 24, length: 12, i: 0)
}

fn uuid_of(text: String) -> Uuid? {
  if uuid_canonical_text(t: text) { Present { value: ascii_lowercase(s: text) as Uuid } } else { none }
}
