module extdeps.uri

import std.types { NonEmptyStr }

type UriScheme
  = Http
  | Https
  | File
  | Ftp
  | Javascript
  | Data
  | Vbscript
  | Mailto

type Uri {
  scheme: UriScheme
  locator: NonEmptyStr
}

fn uri_scheme_is_http(s: UriScheme) -> Bool {
  match s {
    Http => true
    Https => true
    File => false
    Ftp => false
    Javascript => false
    Data => false
    Vbscript => false
    Mailto => false
  }
}

fn uri_is_url(uri: Uri) -> Bool {
  uri_scheme_is_http(s: uri.scheme)
}

fn uri_scheme_wire(s: UriScheme) -> NonEmptyStr {
  match s {
    Http => "http://"
    Https => "https://"
    File => "file://"
    Ftp => "ftp://"
    Javascript => "javascript:"
    Data => "data:"
    Vbscript => "vbscript:"
    Mailto => "mailto:"
  }
}

fn uri_wire(uri: Uri) -> NonEmptyStr {
  concat(uri_scheme_wire(s: uri.scheme), uri.locator)
}

type ParsedHrefScheme
  = HrefScheme { scheme: UriScheme }
  | RelativeHref
  | UnknownHref

fn href_is_relative_reference(s: String) -> Bool {
  starts_with(s, prefix: "/")
    || starts_with(s, prefix: "#")
    || starts_with(s, prefix: "./")
    || starts_with(s, prefix: "../")
    || !(s |> contains(":"))
}

fn parse_href_scheme(url: String) -> ParsedHrefScheme {
  let s = trim(url)
  if starts_with(s, prefix: "//") {
    UnknownHref
  } else if href_is_relative_reference(s: s) {
    RelativeHref
  } else if starts_with(s, prefix: "javascript:") || starts_with(s, prefix: "JAVASCRIPT:") {
    HrefScheme { scheme: Javascript }
  } else if starts_with(s, prefix: "data:") || starts_with(s, prefix: "DATA:") {
    HrefScheme { scheme: Data }
  } else if starts_with(s, prefix: "vbscript:") || starts_with(s, prefix: "VBSCRIPT:") {
    HrefScheme { scheme: Vbscript }
  } else if starts_with(s, prefix: "https://") || starts_with(s, prefix: "HTTPS://") {
    HrefScheme { scheme: Https }
  } else if starts_with(s, prefix: "http://") || starts_with(s, prefix: "HTTP://") {
    HrefScheme { scheme: Http }
  } else if starts_with(s, prefix: "mailto:") || starts_with(s, prefix: "MAILTO:") {
    HrefScheme { scheme: Mailto }
  } else {
    UnknownHref
  }
}

data uri_component_encode_authority_note: String = "RFC 3986 URI-component percent-encoding for extdeps.uri. Unreserved ALPHA / DIGIT / -._~ pass through; reserved and non-ASCII scalars encode as UTF-8 octets percent-encoded with UPPERCASE hex. UriUnicodeScalar and UriUtf8Octet are distinct domains — UTF-8 decomposition never re-enters the scalar encoder with octet values."

type UriHexNibble
  = UriNibble0
  | UriNibble1
  | UriNibble2
  | UriNibble3
  | UriNibble4
  | UriNibble5
  | UriNibble6
  | UriNibble7
  | UriNibble8
  | UriNibble9
  | UriNibbleA
  | UriNibbleB
  | UriNibbleC
  | UriNibbleD
  | UriNibbleE
  | UriNibbleF

type UriHexNibbleConstruction
  = UriHexNibbleConstructed(UriHexNibble)
  | UriHexNibbleOutOfRange { digit: Int }

type UriUnicodeScalar { cp: Int }

type UriUnicodeScalarConstruction
  = UriUnicodeScalarConstructed(UriUnicodeScalar)
  | UriUnicodeScalarSurrogateRefused { cp: Int }
  | UriUnicodeScalarOutOfRangeRefused { cp: Int }

type UriUtf8Octet { byte: Int }

type UriUtf8OctetConstruction
  = UriUtf8OctetConstructed(UriUtf8Octet)
  | UriUtf8OctetOutOfRangeRefused { value: Int }

type UriPercentOctetWire
  = UriPercentOctetEncoded { wire: String }
  | UriPercentOctetNibbleOutOfRange { digit: Int }

type UriPercentEncodeFoldState
  = UriPercentEncodeBuilding { wire: String }
  | UriPercentEncodeRefused { cause: UriPercentEncodeRefusalCause }

type UriPercentEncodeRefusalCause
  = UriPercentEncodeHexNibbleOutOfRange { digit: Int }
  | UriPercentEncodeSurrogateScalarRefused { cp: Int }
  | UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: Int }
  | UriPercentEncodeUtf8OctetOutOfRangeRefused { value: Int }

type UriPercentEncodeComponent
  = UriPercentComponentEncoded(NonEmptyStr)
  | UriPercentComponentRefused { cause: UriPercentEncodeRefusalCause }

fn uri_component_is_unreserved(cp: Int) -> Bool {
  (cp >= 48 && cp <= 57)
    || (cp >= 65 && cp <= 90)
    || (cp >= 97 && cp <= 122)
    || cp == 45
    || cp == 46
    || cp == 95
    || cp == 126
}

fn uri_hex_nibble_construction(d: Int) -> UriHexNibbleConstruction {
  if d == 0 {
    UriHexNibbleConstructed(UriNibble0)
  } else if d == 1 {
    UriHexNibbleConstructed(UriNibble1)
  } else if d == 2 {
    UriHexNibbleConstructed(UriNibble2)
  } else if d == 3 {
    UriHexNibbleConstructed(UriNibble3)
  } else if d == 4 {
    UriHexNibbleConstructed(UriNibble4)
  } else if d == 5 {
    UriHexNibbleConstructed(UriNibble5)
  } else if d == 6 {
    UriHexNibbleConstructed(UriNibble6)
  } else if d == 7 {
    UriHexNibbleConstructed(UriNibble7)
  } else if d == 8 {
    UriHexNibbleConstructed(UriNibble8)
  } else if d == 9 {
    UriHexNibbleConstructed(UriNibble9)
  } else if d == 10 {
    UriHexNibbleConstructed(UriNibbleA)
  } else if d == 11 {
    UriHexNibbleConstructed(UriNibbleB)
  } else if d == 12 {
    UriHexNibbleConstructed(UriNibbleC)
  } else if d == 13 {
    UriHexNibbleConstructed(UriNibbleD)
  } else if d == 14 {
    UriHexNibbleConstructed(UriNibbleE)
  } else if d == 15 {
    UriHexNibbleConstructed(UriNibbleF)
  } else {
    UriHexNibbleOutOfRange { digit: d }
  }
}

fn uri_hex_nibble_wire(nibble: UriHexNibble) -> String {
  match nibble {
    UriNibble0 => "0"
    UriNibble1 => "1"
    UriNibble2 => "2"
    UriNibble3 => "3"
    UriNibble4 => "4"
    UriNibble5 => "5"
    UriNibble6 => "6"
    UriNibble7 => "7"
    UriNibble8 => "8"
    UriNibble9 => "9"
    UriNibbleA => "A"
    UriNibbleB => "B"
    UriNibbleC => "C"
    UriNibbleD => "D"
    UriNibbleE => "E"
    UriNibbleF => "F"
  }
}

fn uri_unicode_scalar_construction(cp: Int) -> UriUnicodeScalarConstruction {
  if cp > 1114111 {
    UriUnicodeScalarOutOfRangeRefused { cp: cp }
  } else if cp >= 55296 && cp <= 57343 {
    UriUnicodeScalarSurrogateRefused { cp: cp }
  } else {
    UriUnicodeScalarConstructed(UriUnicodeScalar { cp: cp })
  }
}

fn uri_utf8_octet_construction(byte: Int) -> UriUtf8OctetConstruction {
  if byte >= 0 && byte <= 255 {
    UriUtf8OctetConstructed(UriUtf8Octet { byte: byte })
  } else {
    UriUtf8OctetOutOfRangeRefused { value: byte }
  }
}

fn uri_percent_octet_wire(octet: UriUtf8Octet) -> UriPercentOctetWire {
  match uri_hex_nibble_construction(d: octet.byte / 16) {
    UriHexNibbleOutOfRange { digit: d } => UriPercentOctetNibbleOutOfRange { digit: d }
    UriHexNibbleConstructed(hi) =>
      match uri_hex_nibble_construction(d: octet.byte % 16) {
        UriHexNibbleOutOfRange { digit: d } => UriPercentOctetNibbleOutOfRange { digit: d }
        UriHexNibbleConstructed(lo) =>
          UriPercentOctetEncoded {
            wire: concat("%", concat(uri_hex_nibble_wire(nibble: hi), uri_hex_nibble_wire(nibble: lo))),
          }
      }
  }
}

fn uri_percent_encode_two_octets(lead: UriUtf8Octet, trail: UriUtf8Octet) -> UriPercentEncodeFoldState {
  match uri_percent_octet_wire(octet: lead) {
    UriPercentOctetEncoded { wire: w0 } =>
      match uri_percent_octet_wire(octet: trail) {
        UriPercentOctetEncoded { wire: w1 } => UriPercentEncodeBuilding { wire: concat(w0, w1) }
        UriPercentOctetNibbleOutOfRange { digit: d } =>
          UriPercentEncodeRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: d } }
      }
    UriPercentOctetNibbleOutOfRange { digit: d } =>
      UriPercentEncodeRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: d } }
  }
}

fn uri_percent_encode_three_octets(b0: UriUtf8Octet, b1: UriUtf8Octet, b2: UriUtf8Octet) -> UriPercentEncodeFoldState {
  match uri_percent_encode_two_octets(lead: b0, trail: b1) {
    UriPercentEncodeRefused { cause: cause } => UriPercentEncodeRefused { cause: cause }
    UriPercentEncodeBuilding { wire: prefix } =>
      match uri_percent_octet_wire(octet: b2) {
        UriPercentOctetEncoded { wire: w2 } => UriPercentEncodeBuilding { wire: concat(prefix, w2) }
        UriPercentOctetNibbleOutOfRange { digit: d } =>
          UriPercentEncodeRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: d } }
      }
  }
}

fn uri_percent_encode_four_octets(b0: UriUtf8Octet, b1: UriUtf8Octet, b2: UriUtf8Octet, b3: UriUtf8Octet) -> UriPercentEncodeFoldState {
  match uri_percent_encode_three_octets(b0: b0, b1: b1, b2: b2) {
    UriPercentEncodeRefused { cause: cause } => UriPercentEncodeRefused { cause: cause }
    UriPercentEncodeBuilding { wire: prefix } =>
      match uri_percent_octet_wire(octet: b3) {
        UriPercentOctetEncoded { wire: w3 } => UriPercentEncodeBuilding { wire: concat(prefix, w3) }
        UriPercentOctetNibbleOutOfRange { digit: d } =>
          UriPercentEncodeRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: d } }
      }
  }
}

fn uri_percent_encode_unicode_scalar(scalar: UriUnicodeScalar) -> UriPercentEncodeFoldState {
  let cp = scalar.cp
  if uri_component_is_unreserved(cp: cp) {
    UriPercentEncodeBuilding { wire: from_code_point(cp: cp) }
  } else if cp < 128 {
    match uri_utf8_octet_construction(byte: cp) {
      UriUtf8OctetOutOfRangeRefused { value: v } =>
        UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
      UriUtf8OctetConstructed(octet) =>
        match uri_percent_octet_wire(octet: octet) {
          UriPercentOctetEncoded { wire: w } => UriPercentEncodeBuilding { wire: w }
          UriPercentOctetNibbleOutOfRange { digit: d } =>
            UriPercentEncodeRefused { cause: UriPercentEncodeHexNibbleOutOfRange { digit: d } }
        }
    }
  } else if cp < 2048 {
    match uri_utf8_octet_construction(byte: 192 + (cp / 64)) {
      UriUtf8OctetOutOfRangeRefused { value: v } =>
        UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
      UriUtf8OctetConstructed(b0) =>
        match uri_utf8_octet_construction(byte: 128 + (cp % 64)) {
          UriUtf8OctetOutOfRangeRefused { value: v } =>
            UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
          UriUtf8OctetConstructed(b1) => uri_percent_encode_two_octets(lead: b0, trail: b1)
        }
    }
  } else if cp < 65536 {
    match uri_utf8_octet_construction(byte: 224 + (cp / 4096)) {
      UriUtf8OctetOutOfRangeRefused { value: v } =>
        UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
      UriUtf8OctetConstructed(b0) =>
        match uri_utf8_octet_construction(byte: 128 + ((cp / 64) % 64)) {
          UriUtf8OctetOutOfRangeRefused { value: v } =>
            UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
          UriUtf8OctetConstructed(b1) =>
            match uri_utf8_octet_construction(byte: 128 + (cp % 64)) {
              UriUtf8OctetOutOfRangeRefused { value: v } =>
                UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
              UriUtf8OctetConstructed(b2) => uri_percent_encode_three_octets(b0: b0, b1: b1, b2: b2)
            }
        }
    }
  } else {
    match uri_utf8_octet_construction(byte: 240 + (cp / 262144)) {
      UriUtf8OctetOutOfRangeRefused { value: v } =>
        UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
      UriUtf8OctetConstructed(b0) =>
        match uri_utf8_octet_construction(byte: 128 + ((cp / 4096) % 64)) {
          UriUtf8OctetOutOfRangeRefused { value: v } =>
            UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
          UriUtf8OctetConstructed(b1) =>
            match uri_utf8_octet_construction(byte: 128 + ((cp / 64) % 64)) {
              UriUtf8OctetOutOfRangeRefused { value: v } =>
                UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
              UriUtf8OctetConstructed(b2) =>
                match uri_utf8_octet_construction(byte: 128 + (cp % 64)) {
                  UriUtf8OctetOutOfRangeRefused { value: v } =>
                    UriPercentEncodeRefused { cause: UriPercentEncodeUtf8OctetOutOfRangeRefused { value: v } }
                  UriUtf8OctetConstructed(b3) =>
                    uri_percent_encode_four_octets(b0: b0, b1: b1, b2: b2, b3: b3)
                }
            }
        }
    }
  }
}

fn uri_percent_encode_code_point(cp: Int) -> UriPercentEncodeComponent {
  match uri_unicode_scalar_construction(cp: cp) {
    UriUnicodeScalarSurrogateRefused { cp: c } =>
      UriPercentComponentRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: c } }
    UriUnicodeScalarOutOfRangeRefused { cp: c } =>
      UriPercentComponentRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: c } }
    UriUnicodeScalarConstructed(scalar) =>
      match uri_percent_encode_unicode_scalar(scalar: scalar) {
        UriPercentEncodeRefused { cause: cause } => UriPercentComponentRefused { cause: cause }
        UriPercentEncodeBuilding { wire: wire } => UriPercentComponentEncoded(wire as NonEmptyStr)
      }
  }
}

fn uri_percent_encode_component(value: NonEmptyStr) -> UriPercentEncodeComponent {
  uri_percent_encode_code_points(code_points: (value as String) |> chars)
}

fn uri_percent_encode_code_points(code_points: List<Int>) -> UriPercentEncodeComponent {
  match fold(
    code_points,
    init: UriPercentEncodeBuilding { wire: "" },
    f: fn(acc, cp) {
      match acc {
        UriPercentEncodeRefused { cause: _ } => acc
        UriPercentEncodeBuilding { wire: prefix } =>
          match uri_unicode_scalar_construction(cp: cp) {
            UriUnicodeScalarSurrogateRefused { cp: c } =>
              UriPercentEncodeRefused { cause: UriPercentEncodeSurrogateScalarRefused { cp: c } }
            UriUnicodeScalarOutOfRangeRefused { cp: c } =>
              UriPercentEncodeRefused { cause: UriPercentEncodeUnicodeScalarOutOfRangeRefused { cp: c } }
            UriUnicodeScalarConstructed(scalar) =>
              match uri_percent_encode_unicode_scalar(scalar: scalar) {
                UriPercentEncodeRefused { cause: cause } => UriPercentEncodeRefused { cause: cause }
                UriPercentEncodeBuilding { wire: encoded } =>
                  UriPercentEncodeBuilding { wire: concat(prefix, encoded) }
              }
          }
      }
    },
  ) {
    UriPercentEncodeRefused { cause: cause } => UriPercentComponentRefused { cause: cause }
    UriPercentEncodeBuilding { wire: wire } => UriPercentComponentEncoded(wire as NonEmptyStr)
  }
}
