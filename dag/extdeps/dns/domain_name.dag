module extdeps.dns.domain_name

import std.unicode.scalar { ascii_lowercase }
import std.types { NonEmptyStr, String, List, Bool, Int, brand }
import std.error_primitives { Result, Ok, Err }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.algebra { collection_concat_shape, list_push, zip_eq }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc1035"
  }
}

data rfc1123_host_name_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rfc-editor.org/rfc/rfc1123#section-2.1"
  }
}

type DnsLabel = NonEmptyStr where brand("DnsLabel")

data empty_dns_labels: List<DnsLabel> = []

type DomainName {
  labels: List<DnsLabel>
}

type NameQualification =
    FullyQualified
  | PartiallyQualified

type HostName {
  name: DomainName
  qualification: NameQualification
}

type DomainNameParseError =
    EmptyName
  | LabelTooLong
  | NameTooLong
  | BadLabelChar
  | EdgeHyphen

fn code_point_int(ch: String) -> Int {
  code_point(ch)
}

fn is_letter_code_point(cp: Int) -> Bool {
  (cp >= 97 && cp <= 122) || (cp >= 65 && cp <= 90)
}

fn is_ldh_leading_code_point(cp: Int) -> Bool {
  is_letter_code_point(cp: cp) || (cp >= 48 && cp <= 57)
}

fn is_ldh_trailing_code_point(cp: Int) -> Bool {
  is_ldh_leading_code_point(cp: cp)
}

fn is_ldh_code_point(cp: Int) -> Bool {
  is_ldh_leading_code_point(cp: cp) || cp == 45
}

fn fold_dns_case_string_at(s: String, i: Int, acc: String) -> String {
  if i >= string_length(s: s) {
    acc
  } else {
    let ch = char_at(s, i)
    fold_dns_case_string_at(s: s, i: i + 1, acc: concat(acc, ascii_lowercase(s: ch)))
  }
}

fn fold_dns_case_string(s: String) -> String {
  fold_dns_case_string_at(s: s, i: 0, acc: "")
}

fn label_has_invalid_ldh_at(s: String, i: Int, len: Int) -> Bool {
  if i >= len {
    false
  } else {
    let cp = code_point_int(ch: char_at(s, i))
    if !is_ldh_code_point(cp: cp) {
      true
    } else {
      label_has_invalid_ldh_at(s: s, i: i + 1, len: len)
    }
  }
}

fn parse_dns_label_raw(raw: String) -> Result<DnsLabel, DomainNameParseError> {
  let folded = fold_dns_case_string(s: raw)
  let len = string_length(s: folded)
  if len == 0 {
    Err { value: EmptyName }
  } else if len > 63 {
    Err { value: LabelTooLong }
  } else {
    let first_cp = code_point_int(ch: char_at(folded, 0))
    let last_cp = code_point_int(ch: char_at(folded, len - 1))
    if !is_ldh_leading_code_point(cp: first_cp) {
      Err { value: BadLabelChar }
    } else if !is_ldh_trailing_code_point(cp: last_cp) {
      Err { value: EdgeHyphen }
    } else if label_has_invalid_ldh_at(s: folded, i: 0, len: len) {
      Err { value: BadLabelChar }
    } else {
      Ok { value: folded as DnsLabel }
    }
  }
}

fn domain_name_wire_octet_count(labels: List<DnsLabel>) -> Int {
  fold(
    labels,
    init: 1,
    f: (acc, label) => acc + 1 + string_length(s: label),
  )
}

fn parse_dns_label_list(segments: List<String>) -> Result<List<DnsLabel>, DomainNameParseError> {
  fold(
    segments,
    init: Ok { value: empty_dns_labels },
    f: (acc, seg) =>
      match acc {
        Err { value: e } => Err { value: e }
        Ok { value: labels } =>
          if seg == "" {
            Err { value: EmptyName }
          } else {
            match parse_dns_label_raw(raw: seg) {
              Err { value: e } => Err { value: e }
              Ok { value: label } => Ok { value: labels |> list_push(label) }
            }
          }
      },
  )
}

fn parse_host_name(raw: String) -> Result<HostName, DomainNameParseError> {
  if raw == "" {
    Err { value: EmptyName }
  } else if ends_with(s: raw, suffix: ".") {
    let body = substring(s: raw, start: 0, end: string_length(s: raw) - 1)
    if body == "" {
      Err { value: EmptyName }
    } else {
      match parse_dns_label_list(segments: body |> split(delimiter: ".")) {
        Err { value: e } => Err { value: e }
        Ok { value: labels } =>
          if domain_name_wire_octet_count(labels: labels) > 255 {
            Err { value: NameTooLong }
          } else {
            Ok {
              value: HostName {
                name: DomainName { labels: labels },
                qualification: FullyQualified,
              },
            }
          }
      }
    }
  } else {
    match parse_dns_label_list(segments: raw |> split(delimiter: ".")) {
      Err { value: e } => Err { value: e }
      Ok { value: labels } =>
        if domain_name_wire_octet_count(labels: labels) > 255 {
          Err { value: NameTooLong }
        } else {
          Ok {
            value: HostName {
              name: DomainName { labels: labels },
              qualification: PartiallyQualified,
            },
          }
        }
    }
  }
}

fn hostname_short(host: HostName) -> DnsLabel? {
  match host.name.labels.first() {
    Present { value: label } => Present { value: label }
    Absent => none
  }
}

fn parent_domain(host: HostName) -> DomainName? {
  if host.name.labels.length() <= 1 {
    none
  } else {
    Present {
      value: DomainName { labels: host.name.labels |> skip(n: 1) },
    }
  }
}

fn domain_name_wire(name: DomainName) -> String {
  fold(
    name.labels,
    init: "",
    f: (acc, label) =>
      if acc == "" {
        label as String
      } else {
        concat(acc, ".", label as String)
      },
  )
}

fn qualify(host: DnsLabel, zone: DomainName) -> HostName {
  HostName {
    name: DomainName { labels: [host] |> concat(zone.labels) },
    qualification: FullyQualified,
  }
}

// A HOST'S LABEL JOINED TO A ZONE, with the qualification the composition actually has. `qualify` above
// asserts `FullyQualified`, which is the trailing-dot claim — "ask exactly this" — and a name assembled from
// a host and a zone was never written with a trailing dot, so claiming it would make the composed name a
// DIFFERENT name from the one `parse_host_name` returns for the same labels (`host_name_eq` checks
// qualification). This is the arm that agrees with the parser: same labels, same qualification, one answer.
//
// WHY THIS EXISTS RATHER THAN A CALLER SPELLING THE WIRE: a host row whose zone is a parameter must derive
// its name FROM that zone, or the two can drift the moment the zone is re-configured (review 87319, finding
// 2 — the zone was a parameter and the name was still the literal "srv2.mynetworksettings.com", so the
// parameter only moved the suffix test and not the name the resolver is asked about).
fn host_name_joined_with_zone(host: DnsLabel, zone: DomainName) -> HostName {
  HostName {
    name: DomainName { labels: [host] |> concat(zone.labels) },
    qualification: PartiallyQualified,
  }
}

// ONE LABEL, COMPARED. The widening cast is the corpus's idiom for comparing a branded string (precedent:
// gunbc.serving.caller_backlog logical_work_eq compares branded LogicalWorkIds the same way, and
// gunbc.design.reference_instrument citation_is_contained widens branded module paths), and it belongs HERE,
// beside the brand, rather than in each consumer that needs it. `DnsLabel` is `NonEmptyStr where
// brand("DnsLabel")` at the top of this file, so this is the module that owns what two labels being equal
// means.
fn dns_label_eq(a: DnsLabel, b: DnsLabel) -> Bool {
  (a as String) == (b as String)
}

// TWO DOMAIN NAMES, THE SAME LABELS? Labels, in order, same length — compared as the structure the parser
// produced, never by rendering both sides and comparing the strings. Rendering makes the boundary between
// "srv2.example" and "srv2example" a character rule nobody wrote down, and it re-derives what
// `parse_dns_label_list` already settled.
//
// THIS IS THE LABEL-WISE EQUALITY, and it deliberately says nothing about qualification: it answers "same
// labels", which is what a suffix test and a share row's agreement with its own filed name both need. The
// question that ALSO cares about qualification is `host_name_eq` below, which asks this and then asks the
// separate, named question. One rule, one place; the qualification conjunct is not folded into it, so a
// caller cannot get the two mixed up by accident.
fn domain_name_eq(a: DomainName, b: DomainName) -> Bool {
  zip_eq(a: a.labels, b: b.labels, eq: dns_label_eq)
}

// THE QUALIFICATION QUESTION, asked on its own so `host_name_eq` can be a conjunction of two named facts
// rather than one blur. Whether a name was written with a trailing dot is a fact about the SPELLING, not
// about the labels — which is why `zone_admit` drops it and why a suffix test must not check it.
fn name_qualification_eq(a: NameQualification, b: NameQualification) -> Bool {
  a == b
}

// THE FULL CONTRACT: same labels AND the same qualification. It used to compare `domain_name_wire` of each
// side, which is the rendering the label comparison exists to avoid — the repair belongs here rather than in
// a parallel equality beside it, because two equalities that answer one question differently is the defect
// (§3: one name, two materially different meanings).
fn host_name_eq(a: HostName, b: HostName) -> Bool {
  name_qualification_eq(a: a.qualification, b: b.qualification) && domain_name_eq(a: a.name, b: b.name)
}

fn host_name_label_count(host: HostName) -> Int {
  host.name.labels.length()
}
