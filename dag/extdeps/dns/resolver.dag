module extdeps.dns.resolver

// A HOST NAME ASKED OF A RESOLVER: the question, the servers it may be asked of, and the answer.
//
// WHAT THIS MODULE OWNS, AND WHAT IT DELIBERATELY DOES NOT. It owns only the RESOLVER SHAPE — a
// non-empty ordered server list, the question, the reply, and the four states between them. Everything
// else is borrowed, because the corpus already grounds it and a second authority is the §2 meaning-fork:
//   - the name GRAMMAR (label form, LDH rule, qualification): extdeps.dns.domain_name;
//   - what counts as a NAME versus an ADDRESS literal: extdeps.network.endpoint `parse_network_host`
//     (RFC 3986 §3.2.2, `host = IP-literal / IPv4address / reg-name`), which is where the digits-and-
//     dots test already lives and why it lives there;
//   - what an IPv4 literal IS: extdeps.network.ipv4.
// The DNS record types and wire formats themselves are the zone operator's (RFC 1034 §3.2.2, RFC 1035
// §3.2/§3.3) and are modelled here only as far as a host stub resolver is observable: it either gave
// you addresses, or it gave you a reason it did not.
//
// WHY A SEPARATE MODULE FROM domain_name. Grammar and lookup answer different questions and change for
// different reasons — a grammar rule changes when the RFC does; a lookup shape changes when a consumer
// needs to tell "no such name" apart from "nobody answered". Fusing them would force every grammar
// consumer to carry resolver states it never inspects (§2, least moving part).
//
// WHY THE DISTINCTION IS NOT MERELY HYGIENE. The trigger this model was written for: a boot refused at
// media attach because the BMC's NFS server address named a host that had moved. An address in a row
// cannot be looked up, cannot be checked before it is used, and cannot be moved when the host moves; a
// name can be all three. That is the operator ruling of 2026-10-24 ("do not rely on IP addresses; every
// host gets a STABLE HOSTNAME"), and the refusal below is that ruling enforced at the one place a
// spelling becomes a lookup.

import std.types { String, Bool, List, Int, Present, Absent, Optional, list_length }
import std.algebra { Cons, Empty }
import extdeps.network.ipv4 { Ipv4Address, render_ipv4_address }
import extdeps.network.address { IpAddress, IpV4, IpV6 }
import extdeps.network.endpoint {
  NetworkHostParsed,
  NetworkHostRefused,
  HostByName,
  HostByAddress,
  NetworkHostIpv4Malformed,
  NetworkHostIpv6LiteralUnparsed,
  NetworkHostNameMalformed,
  parse_network_host,
}
import extdeps.dns.domain_name {
  HostName,
  DomainNameParseError,
  FullyQualified,
  PartiallyQualified,
  domain_name_wire,
}

// ── THE SERVERS ──────────────────────────────────────────────────────────────────────────────

// A RESOLVER IS A NON-EMPTY ORDERED LIST OF SERVERS AND NOTHING ELSE. No search list is carried: a
// search list turns one name into N questions, so "does this name resolve?" stops having an answer
// until the suffix is guessed — a meaning-fork (§3). A consumer that wants suffix behaviour asks for a
// fully-qualified name and gets a definite answer or a definite refusal.
//
// sole_constructor: `resolver_admit` is the ONLY way to hold one. A zero-server resolver is not a
// resolver that answers nothing — it is a row that LOOKS configured while nothing can be deduced from
// it, and every consumer would then have to re-check for the empty case, with the one that forgets
// treating "nobody answered" as "it resolved" (§5, a missing check is the failure mode).
type Resolver sole_constructor {
  servers: List<Ipv4Address>
}

type ResolverAdmission
  = ResolverAdmitted { resolver: Resolver }
  | ResolverRefused { cause: String }

// THE ONE ADMISSION: it refuses the empty server list, so the check exists once at the boundary rather
// than at every consumer. Duplicates are NOT refused — a repeated server is a redundant query, not a
// lie (resolv.conf permits it), and refusing it would forbid more of the world than the variables
// support (§4d).
fn resolver_admit(servers: List<Ipv4Address>) -> ResolverAdmission {
  if list_length(items: servers) == 0 {
    ResolverRefused {
      cause: "a resolver with no servers answers nothing, and a row that looks configured while answering nothing is the fail-open trap this type closes. Remedy: name the zone's authoritative server — the LAN zone is served by the router, the tailnet zone by the tailnet's own resolver",
    }
  } else {
    ResolverAdmitted { resolver: Resolver { servers: servers } }
  }
}

// THE SERVERS AS SPELLINGS, for the one surface that needs text: a resolver settings row. A BMC's own
// network settings name their DNS servers by spelling, and reading them back compares spellings.
// Rendered through extdeps.network.ipv4's single renderer (§3).
fn resolver_server_texts(resolver: Resolver) -> List<String> {
  resolver.servers.map(s => render_ipv4_address(addr: s))
}

// ── THE QUESTION ─────────────────────────────────────────────────────────────────────────────

// A NAME SOMEONE INTENDS TO ASK A RESOLVER ABOUT. sole_constructor because the admission below is what
// makes the question safe to ask, and the thing it must catch is one the GRAMMAR cannot catch: digits
// are valid LDH characters, so an IPv4 literal is a grammatical four-label name. extdeps.dns.domain_name
// is correctly permissive about that (RFC 1123 §2.1 allows all-digit labels), which is precisely why
// "is this a name I can look up?" is not a grammar question. It is decided by the one function that
// already separates the two readings — `parse_network_host`, whose own comment records the hazard: an
// all-digit spelling must never be handed to the name parser.
type ResolvableName sole_constructor {
  name: HostName
}

// THE THREE WAYS A SPELLING FAILS TO BE A QUESTION, each with its own remedy (§5: a failure mode names
// its own remedy, and one blended string would make every reader re-derive which applies). The IPv4 and
// IPv6 arms are NOT grammar failures — they are addresses that were authored where a name belongs, and
// the fix is to author the host's name, not to fix the spelling. Keeping them distinct from NameMalformed
// is what stops "typo in a name" from being diagnosed on a row that was never a name to begin with.
type ResolvableNameRefusal
  = NotANameIsIpv4Literal { raw: String, address: Optional<Ipv4Address> }
  | NotANameIsIpv6Literal { raw: String }
  | NameMalformed { raw: String, error: DomainNameParseError }

type ResolvableNameAdmission
  = ResolvableNameAdmitted { name: ResolvableName }
  | ResolvableNameRefused { refusal: ResolvableNameRefusal }

// THE ONE ADMISSION OF A QUESTION. It asks extdeps.network.endpoint what the text is — the single
// authority on name-versus-address — and admits ONLY the name arm. An address arm is refused rather than
// coerced: a literal has no zone, so no server can be asked about it, so the row could never be checked
// and would fail at the moment it is used instead of the moment it is authored (the authorable boundary;
// the boot-attach failure this lane exists to close).
//
// QUALIFICATION IS DELIBERATELY NOT CHECKED HERE. A partially-qualified name resolves perfectly well
// wherever a search list is configured, so refusing it in the resolver would forbid more of the world
// than these variables support (§4d). Consumers that require the FQDN state it at their own gate — the
// BMC media share does, because the controller's own field validator refuses a single label (measured
// 2026-10-27 against the firmware's served bundle, cited in extdeps.bmc.megarac).
fn resolvable_name_admit(spelling: String) -> ResolvableNameAdmission {
  match parse_network_host(raw: spelling) {
    NetworkHostParsed { host: HostByName { name: n } } => ResolvableNameAdmitted { name: ResolvableName { name: n } }
    NetworkHostParsed { host: HostByAddress { address: a } } =>
      // Only the v4 arm is reachable: `parse_network_host` refuses any spelling containing ':' before
      // it can produce an address, so an IPv6 literal never arrives as HostByAddress. The arm exists
      // because the product type admits it, and it answers with the refusal that fits the spelling.
      match address_is_ipv4(a: a) {
        Present { value: v4 } => ResolvableNameRefused { refusal: NotANameIsIpv4Literal { raw: spelling, address: Present { value: v4 } } }
        Absent => ResolvableNameRefused { refusal: NotANameIsIpv6Literal { raw: spelling } }
      }
    NetworkHostRefused { refusal: r } =>
      match r {
        NetworkHostIpv4Malformed { raw: _, error: _ } =>
          // A digits-and-dots spelling that is not even a valid address: it was meant as one, and the
          // name parser must not be allowed to bless it as a name. Refused for what it is, without
          // claiming an address it does not have.
          ResolvableNameRefused { refusal: NotANameIsIpv4Literal { raw: spelling, address: Absent } }
        NetworkHostIpv6LiteralUnparsed { raw: _ } =>
          ResolvableNameRefused { refusal: NotANameIsIpv6Literal { raw: spelling } }
        NetworkHostNameMalformed { raw: _, error: e } =>
          ResolvableNameRefused { refusal: NameMalformed { raw: spelling, error: e } }
      }
  }
}

// IS THE ADDRESS THE v4 ARM, told without re-deriving the address grammar: the carrier is asked, not
// re-parsed. Private to this module because no consumer needs the test — they need the refusal.
fn address_is_ipv4(a: IpAddress) -> Ipv4Address? {
  match a {
    IpV4 { v4: v } => Present { value: v }
    IpV6 { v6: _ } => Absent
  }
}

// THE SPELLING SENT TO A SERVER, in wire form (labels joined by '.'), from the grammar module's single
// renderer. No trailing dot is appended: the absolute and relative spellings ask different questions
// (searched versus not searched), so this function does not choose between them for its callers.
fn resolvable_name_wire(name: ResolvableName) -> String {
  domain_name_wire(name: name.name.name)
}

fn resolvable_name_is_fully_qualified(name: ResolvableName) -> Bool {
  match name.name.qualification {
    FullyQualified => true
    PartiallyQualified => false
  }
}

// THE LABEL COUNT, for gates that must refuse a single label — the BMC media leg's own requirement,
// where the firmware's field validator rejects a one-label spelling.
fn resolvable_name_label_count(name: ResolvableName) -> Int {
  list_length(items: name.name.name.labels)
}

// ── THE ANSWER ───────────────────────────────────────────────────────────────────────────────

// WHY FOUR CAUSES AND NOT ONE FAILURE STRING: each arm has a different remedy, and a blended "failed"
// would push the reader to re-derive which applies (§5). The separation is load-bearing in both
// directions:
//   ServerUnreachable — asked, no reply. The remedy is the server or the cable, NOT the name. Merging
//     this with NameUnknown would let a network outage license rewriting a correct name — the exact
//     wrong inference to draw in the middle of a failed boot.
//   NameUnknown — a server answered authoritatively that the name does not exist. The ONLY arm that
//     licenses changing the name.
//   AnswerEmpty — the name exists but carries no record of the type asked (NODATA). Reading it as
//     NameUnknown would delete a live name because one record type is absent; the LAN router shows this
//     shape directly, answering an AAAA query for srv2 with NOERROR and one answer where the same name's
//     A query answers with a different count (measured 2026-10-27 against 192.168.1.1).
//   NameRefusedByGrammar — the question was never sendable; the defect sits in the row that authored the
//     spelling, upstream of any server.
type NameResolution
  = Resolved { name: ResolvableName, addresses: List<Ipv4Address> }
  | Unresolved { name: ResolvableName, cause: ResolutionCause }

type ResolutionCause
  = NameRefusedByGrammar { detail: String }
  | ServerUnreachable { server: Ipv4Address }
  | NameUnknown { server: Ipv4Address }
  | AnswerEmpty { server: Ipv4Address }

// WHAT A SERVER REPLIED, before any state is derived from it. sole_constructor over the raw reply
// because the NameResolution is DERIVED from it and never asserted beside it: a claim that a name
// "resolves" that does not pass through a carrier of this type cannot be built, which is the point.
// `asked == Absent` is "no reply"; `asked == Present([])` is "a reply carrying no address". They are
// different facts and the type keeps them apart.
type ResolverAnswer sole_constructor {
  server: Ipv4Address
  asked: Optional<List<Ipv4Address>>
  // Authoritative-negative flag, set only by the reader that saw the header — the only place NODATA and
  // NXDOMAIN can be told apart.
  name_known: Bool
}

type ResolverAnswerAdmission
  = ResolverAnswerAdmitted { answer: ResolverAnswer }
  | ResolverAnswerRefused { cause: String }

// THE ONE ADMISSION OF A REPLY. Two shapes are refused because no header can carry them: a reply that
// says the name is unknown AND carries addresses, and a reply with no server to have replied.
fn resolver_answer_admit(
  server: Ipv4Address,
  asked: Optional<List<Ipv4Address>>,
  name_known: Bool,
) -> ResolverAnswerAdmission {
  match asked {
    Present { value: addrs } =>
      if name_known == false && list_length(items: addrs) > 0 {
        ResolverAnswerRefused {
          cause: "a reply cannot say the name is unknown and carry addresses at once; report the state the server actually returned",
        }
      } else {
        ResolverAnswerAdmitted {
          answer: ResolverAnswer { server: server, asked: asked, name_known: name_known },
        }
      }
    Absent =>
      ResolverAnswerAdmitted {
        answer: ResolverAnswer { server: server, asked: asked, name_known: name_known },
      }
  }
}

// THE DERIVATION, in the one place. Every NameResolution in the corpus comes through here, so the
// ordering of the checks is not re-decided per call site (§3): no reply outranks everything (we do not
// know), then the authoritative negative, then the empty answer, then a real answer.
fn resolution_from_answer(name: ResolvableName, answer: ResolverAnswer) -> NameResolution {
  match answer.asked {
    Absent => Unresolved { name: name, cause: ServerUnreachable { server: answer.server } }
    Present { value: addrs } =>
      if answer.name_known == false {
        Unresolved { name: name, cause: NameUnknown { server: answer.server } }
      } else if list_length(items: addrs) == 0 {
        Unresolved { name: name, cause: AnswerEmpty { server: answer.server } }
      } else {
        Resolved { name: name, addresses: addrs }
      }
  }
}

// THE SERVERS ASKED IN ORDER, first definite answer wins — the stub-resolver behaviour a host actually
// has (RFC 1035 §6, and the host's own resolv.conf semantics). THE FAIL-CLOSED HALF (§5): a server that
// never replies is NOT success, and a silent server cannot be buried by a later row, so no consumer can
// read "nobody answered" as "it resolved". `ask` is a PARAMETER, not an effect: this module stays pure
// and hermetically testable, and the real query is supplied by the observing layer that cites the packet
// (§4d — the witness carries its own observation, the model never invents one). An empty server list
// cannot reach here, because `resolver_admit` refuses it; the exhaustion arm therefore names a server
// that was actually tried rather than inventing one.
fn resolve_name(
  name: ResolvableName,
  resolver: Resolver,
  ask: fn(Ipv4Address, ResolvableName) -> ResolverAnswer,
) -> NameResolution {
  ask_in_order(name: name, remaining: resolver.servers, first: resolver.servers.first(), ask: ask)
}

fn ask_in_order(
  name: ResolvableName,
  remaining: List<Ipv4Address>,
  first: Optional<Ipv4Address>,
  ask: fn(Ipv4Address, ResolvableName) -> ResolverAnswer,
) -> NameResolution {
  match remaining {
    Empty {} =>
      // Every server was silent. Report the FIRST: it is the one the host would have asked first, which
      // is the one a reader goes to check.
      match first {
        Present { value: first_server } => Unresolved { name: name, cause: ServerUnreachable { server: first_server } }
        Absent => Unresolved { name: name, cause: NameRefusedByGrammar { detail: "the resolver carried no server to ask; such a row cannot be admitted by resolver_admit, so reaching this arm means a Resolver was built without it" } }
      }
    Cons { head: server, tail: rest } =>
      match ask(server, name) {
        answer =>
          match resolution_from_answer(name: name, answer: answer) {
            // The arm binds the derived answer's own data, so the classifier above stays the SINGLE
            // authority on what a reply means (§3): nothing here re-reads the reply to decide its state.
            Resolved { name: _, addresses: addrs } => Resolved { name: name, addresses: addrs }
            Unresolved { name: _, cause: ServerUnreachable { server: _ } } =>
              ask_in_order(name: name, remaining: rest, first: first, ask: ask)
            Unresolved { name: _, cause: c } => Unresolved { name: name, cause: c }
          }
      }
  }
}

// IS THE NAME RESOLVABLE, for a gate that needs only the verdict. IT IS DERIVED FROM A RESOLUTION and
// never from the name alone: there is deliberately no function here that takes a name and answers true,
// because "does it resolve?" is a question about a server's behaviour, not about a spelling (§4d).
fn name_resolves(resolution: NameResolution) -> Bool {
  match resolution {
    Resolved { name: _, addresses: _ } => true
    Unresolved { name: _, cause: _ } => false
  }
}
