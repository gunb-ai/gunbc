module extdeps.uuid

import std.types { String, NonEmptyStr, Int, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "datatracker.ietf.org/doc/html/rfc9562"
  }
}

// RFC 9562 (obsoletes RFC 4122) defines the UUID and its canonical textual form: 32 hexadecimal
// digits in five hyphen-separated groups of 8-4-4-4-12, thirty-six characters. It is an IETF
// concept, so a vendor field holding one is not thereby a vendor type — several unrelated
// dependencies here carry account and session identifiers in exactly this shape, and re-typing each
// as its own NonEmptyStr would coin the concept once per consumer.
//
// The brand makes the shape claim checkable: a 36-character string is not a UUID; one matching the
// canonical layout is. Section 4 also fixes the reading order — big-endian textual form, version
// and variant at fixed positions — so a UUID must never be compared case-sensitively or reordered
// as bytes without consulting that section.
//
// Deliberately NOT modeled: version extraction, variant bits, generation. This module lets
// consumers say a field IS a UUID rather than a string that looks like one; minting and inspecting
// land with the consumer that needs them.

type Uuid = NonEmptyStr where brand("Uuid")

data uuid_canonical_length: Int = 36
data uuid_canonical_group_lengths: List<Int> = [8, 4, 4, 4, 12]
