module extdeps.ray.threshold_memory_monitor

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.measure { Percent, percent, ByteSize, Millisecond, millisecond, millisecond_count, Gibibyte, gibibyte, gibibyte_to_byte_size }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

// RAY'S THRESHOLD MEMORY MONITOR, NAMED FOR THE IMPLEMENTATION AND NOT FOR THE FACTORY.
//
// THE OBVIOUS NAME WOULD HAVE BEEN A MEANING FORK. Upstream has no single `memory_monitor` any more:
// `src/ray/common/monitors/` holds THREE implementations -- threshold, pressure and event -- behind
// `memory_monitor_factory.h`. A module called `extdeps.ray.memory_monitor` would be one name over
// three materially different behaviours, which is exactly what DESIGN section 3 forbids, and the
// reader would have no way to tell which one a cited default belongs to.
//
// AND THE PRESSURE MONITOR IS NOT REACHABLE THROUGH THAT FACTORY AT ALL, which is the second and
// stronger reason for the narrow name: it lives in the same directory and is never selected by
// `Create`. A module named for the directory would have implied coverage of something upstream does
// not run on this path.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ray-project/ray/blob/ray-2.58.0/src/ray/common/ray_config_def.h"
  }
}

// THE AUTHORITY IS PARTITIONED BY SOURCE FILE, BECAUSE ONE ANCHOR OVER FIVE FILES IS NOT A CITATION.
//
// An earlier revision pointed a single scope at `ray_config_def.h` with no further citations, while
// the module asserted facts read from the factory body and the monitor implementation as well. That
// gap is not cosmetic: it is WHY fifteen green witnesses did not catch a `master` diagnostic literal
// sitting under a 2.58.0 pin. The witnesses compare authored values against authored expectations;
// nothing in them establishes external-source fidelity, so the only thing that can is a citation
// naming the file each fact came from.
data ray_factory_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ray-project/ray/blob/ray-2.58.0/src/ray/common/monitors/multi_memory_monitor_factory.cc"
  }
}

data ray_config_macro_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ray-project/ray/blob/ray-2.58.0/src/ray/common/ray_config.h"
  }
}

// THE ABSENCE ROW ASSERTS ONE REVISION, BECAUSE THE OTHER END WAS NEVER PINNABLE.
// An earlier revision of this module carried a second authority pointing at
// `blob/master/src/ray/common/ray_config_def.h` so that `ray_config_absences` could assert a field
// is present on master AND absent at the tag. That authority was deleted and the positive half of
// the contrast with it. `master` is not a revision: it is whichever commit occupies the branch when
// a reader follows the link, so the cited end could change while this authored row stayed fixed --
// which is the same "wrong about one field, and undetectably so" failure the pin below exists to
// prevent, re-entering through the citation instead of through the defaults.
//
// The exact master commit that was read is NOT recoverable after the fact, and reconstructing a
// plausible one would be a fabricated citation rather than a repair. So the row keeps only the half
// that is grounded at a pinned revision -- absent from `ray_config_def.h` at `ray-2.58.0` -- which
// is also the only half any consumer needs.

data ray_threshold_monitor_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/ray-project/ray/blob/ray-2.58.0/src/ray/common/monitors/threshold_memory_monitor.cc"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ray.threshold_memory_monitor",
      decl_name: "RayThresholdMonitorDefaults",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data ray_built_monitors_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ray.threshold_memory_monitor",
      decl_name: "ray_linux_built_monitors",
      field: WholeDeclaration
    }
  },
  first_citation: ray_factory_authority,
  further_citations: []
}

data ray_config_env_spelling_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ray.threshold_memory_monitor",
      decl_name: "ray_config_env_spelling",
      field: WholeDeclaration
    }
  },
  first_citation: ray_config_macro_authority,
  further_citations: []
}

data ray_config_absences_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ray.threshold_memory_monitor",
