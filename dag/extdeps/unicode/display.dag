module extdeps.unicode.display



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.unicode.org/reports/tr11/"
  }
}

fn char_display_width(c: Char) -> std.unicode.types.DisplayWidth {
  let cp = c
  let is_zero_width = contains(extdeps.unicode.blocks.zero_width_codepoints, item: cp) || any(extdeps.unicode.blocks.zero_width_blocks, predicate: b => std.unicode.types.in_block(cp: cp, block: b))
  if is_zero_width { return std.unicode.types.ZeroWidth }
  if any(extdeps.unicode.blocks.wide_blocks, predicate: b => std.unicode.types.in_block(cp: cp, block: b)) { return std.unicode.types.Wide }
  return std.unicode.types.Narrow
}

fn char_width(c: Char) -> Int {
  std.unicode.types.display_width_columns(w: char_display_width(c: c))
}

fn string_display_width(s: String) -> Int {
  let char_list = chars(s)
  let widths = char_list |> map(c => char_width(c: c))
  widths |> fold(init: 0, f: fn(acc, w) { acc + w })
}

fn truncate_text(text: String, max_width: Int) -> String {
  let char_list = chars(text)
  let state = fold(char_list,
    init: { result: "", used: 0 },
    f: (acc, c) => if acc.used + char_width(c: c) > max_width {
      acc
    } else {
      { result: concat(acc.result, from_code_point(c)), used: acc.used + char_width(c: c) }
    }
  )
  state.result
}
