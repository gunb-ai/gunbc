module extdeps.bmc


import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.bmc.redfish { bmc_ground_host_observations }
import extdeps.bmc.types { BmcGroundedHostObservations, BmcTelemetrySnapshot }
import std.measure { ByteSize, HardwareThreadCount }
import std.types { NonEmptyStr }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Baseboard_management_controller"
  }
}

// Reading: en.wikipedia.org owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its fn declaration bmc_observed_processor_model, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.bmc",
      decl_name: "bmc_observed_processor_model",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

fn bmc_observed_processor_model(obs: BmcGroundedHostObservations) -> NonEmptyStr {
  obs.processor_model
}

fn bmc_observed_processor_core_count(obs: BmcGroundedHostObservations) -> HardwareThreadCount {
  obs.processor_core_count
}

fn bmc_observed_total_memory_bytes(obs: BmcGroundedHostObservations) -> ByteSize {
  obs.total_memory_bytes
}

fn bmc_observed_power_consumed_watts(obs: BmcGroundedHostObservations) -> Watt? {
  obs.power_consumed_watts
}

fn bmc_ground_snapshot(snapshot: BmcTelemetrySnapshot) -> BmcGroundedHostObservations {
  bmc_ground_host_observations(snapshot: snapshot)
}
