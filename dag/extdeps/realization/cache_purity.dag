module extdeps.realization.cache_purity



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

type CachePurityViolation {
  content_key: std.content_hash.ContentHash
  unkeyed_axis: std.types.NonEmptyStr
  warm_digest: std.content_hash.ContentHash
  cold_digest: std.content_hash.ContentHash
}

type CachePurityVerdict
  = Pure
  | Impure { violation: CachePurityViolation }

fn cache_purity_verdict(warm_equals_cold: Bool, violation: CachePurityViolation) -> CachePurityVerdict {
  match std.perturbation.perturbation_verdict(
    reading: std.perturbation.ForwardSameInSameOut,
    output_responded: warm_equals_cold == false
  ) {
    std.perturbation.ResponseConsistent => Pure
    std.perturbation.ResponseViolation => Impure { violation: violation }
  }
}
