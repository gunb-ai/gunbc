module extdeps.realization.emit_on_demand_host

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { ContentHash, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/"
  }
}

data emit_on_demand_host_note: String = "P3 host-transport helpers (witness-realization kernel): the effective cache path is root / emit_on_demand_key(NativeArtifact) / artifact_realization_digest(materialized workspace files + build argv) / resolved_build_toolchain_identity. The outer closure key groups one authored computation; the input-realization digest makes changed emitted source, dispatcher suffix, manifest, or build argv select a cold workspace even when the inferred tree is byte-identical; the final host-observed segment makes a changed resolved compiler select a cold workspace even when files and argv are identical. run_emit_host_cached supplies the first three segments and the HAND-RUST emit_host_run_transport_cached boundary derives and appends the resolved toolchain identity before consulting .native_ready. Warm hits skip cargo build via extdeps.cargo and set compile_skipped. Eviction targets the outer workspace through emit_host_native_cache_evict — NOT raw shell.Remove — so it removes every realization and toolchain child and shares the durable rebase authority with the transport."

data emit_on_demand_host_concurrent_same_key_note: String = "Concurrent same-key story for persistent workspaces: identical outer closure key, input-realization digest, AND resolved build-toolchain identity share a workspace — benign-by-identity because those segments cover the exact materialized workspace files, build argv, and host tools that realize them. A changed emitter/dispatcher realization or resolved compiler cannot share the ready marker even when its inferred-tree closure digest is unchanged. Concurrent cold builds of identical inputs may still race before .native_ready; no atomic claim exists in the seed HAND-RUST transport yet. Dissolve-on: the self-emitted transport adds flock/claim when witness-family concurrency requires it."

fn native_cache_workspace_root(cache_root: String, key: ContentHash) -> String {
  concat(cache_root, "/", key as String)
}

fn native_cache_realization_workspace_root(
  workspace_root: String,
  realization_digest: ContentHash
) -> String {
  concat(workspace_root, "/", realization_digest as String)
}

fn native_cache_resolved_toolchain_workspace_root(
  realization_workspace_root: String,
  resolved_toolchain_identity: ContentHash
) -> String {
  concat(realization_workspace_root, "/", resolved_toolchain_identity as String)
}

fn emit_on_demand_evict_native_cache(cache_root: String, key: ContentHash) -> Bool {
  let workspace = native_cache_workspace_root(cache_root: cache_root, key: key)
  emit_host_native_cache_evict(workspace_dir: workspace)
}
