module extdeps.realization.emit_on_demand_host


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/"
  }
}

data emit_on_demand_host_note: String = "P3 host-transport helpers (witness-realization kernel): the effective cache path is root / emit_on_demand_key(NativeArtifact) / artifact_realization_digest(materialized workspace files + build argv) / resolved_build_context_identity. The outer closure key groups one authored computation; the input-realization digest makes changed emitted source, dispatcher suffix, manifest, or build argv select a cold workspace even when the inferred tree is byte-identical. The final host-observed segment combines the resolved build tools, the exact constructed subprocess environment, and every Cargo configuration file Cargo can discover from the workspace. run_emit_host_cached supplies the first three segments. The HAND-RUST emit_host_run_transport_cached boundary materializes the exact files at that input-realization root, constructs and hashes the only environment admitted to build/run commands, resolves and probes the build toolchain with that root as current_dir (so workspace rust-toolchain selection is observed), observes Cargo configuration, and appends the context identity before consulting .native_ready. Warm hits skip cargo build via extdeps.cargo and set compile_skipped. Eviction targets the outer workspace through emit_host_native_cache_evict — NOT raw shell.Remove — so it removes every realization and context child and shares the durable rebase authority with the transport."

data emit_on_demand_host_concurrent_same_key_note: String = "Concurrent same-key story for persistent workspaces: identical outer closure key, input-realization digest, AND resolved build-context identity share a workspace — benign-by-identity because those segments cover the exact materialized workspace files, build argv, resolved tools, constructed environment, and Cargo configuration that realize them. A changed emitter/dispatcher realization, compiler, admitted environment row, or Cargo configuration cannot share the ready marker even when its inferred-tree closure digest is unchanged. Concurrent cold builds of identical inputs may still race before .native_ready; no atomic claim exists in the seed HAND-RUST transport yet. Dissolve-on: the self-emitted transport adds flock/claim when witness-family concurrency requires it."

data emit_on_demand_host_seed_deferral_note: String = "Pure Bootstrap receipt for the bounded existing HAND-RUST boundary: no new Rust file or parallel key authority is admitted. This seed observation/apply arm is explicitly deferred to ROADMAP row 'Make native materialization the shared execution kernel' (docs/plans/witness-realization-plan.md P3/P6) and the concrete dag/gunbc/v1_deletion_plan.dag ^witness_realization_kernel deletion row. Delete it when the self-emitted transport consumes ResolvedBuildContext and the dispatcher-change, environment-change, and cold/warm agreement witnesses stay green with the Rust helpers removed."

type ObservedToolIdentity {
  tool_name: std.types.NonEmptyStr
  observed_identity: std.content_hash.ContentHash
}

type ObservedToolIdentityLookup
  = ObservedToolIdentityFound { row: ObservedToolIdentity }
  | ObservedToolIdentityMissing { tool_name: std.types.NonEmptyStr }
  | ObservedToolIdentityDuplicate { tool_name: std.types.NonEmptyStr, count: std.integer.NonNegativeInt }

type ResolvedBuildContext {
  observed_tool_identities: List<ObservedToolIdentity>
  environment_identity: std.content_hash.ContentHash
  cargo_configuration_identity: std.content_hash.ContentHash
}

type EmitHostStructuralIdentityOutcome
  = EmitHostStructuralIdentityPresent { structural: std.content_hash.Fnv1a64Structural }
  | EmitHostStructuralIdentityRefusedCrypto {
      component: std.types.NonEmptyStr
      identity: std.content_hash.ContentHash
    }

type ResolvedBuildContextIdentityOutcome
  = ResolvedBuildContextIdentityPresent { identity: std.content_hash.ContentHash }
  | ResolvedBuildContextIdentityRefusedCrypto {
      component: std.types.NonEmptyStr
      identity: std.content_hash.ContentHash
    }

type ToolchainIdentityOutcome
  = ToolchainIdentityPresent { identity: std.content_hash.ContentHash }
  | ToolchainIdentityRefusedCrypto {
      component: std.types.NonEmptyStr
      identity: std.content_hash.ContentHash
    }

data emit_host_structural_identity_refusal_note: String = "emit_host_structural_identity_outcome refuses cryptographic ContentHash families at the structural projection boundary (review 45661). Sha256Hash, Sha1Hash, and Sha512Hash cannot collapse to a shared fnv1a64 sentinel — that was an absorbing fallback hiding distinct digests behind one cache key. Structural-only inputs proceed; crypto arms return EmitHostStructuralIdentityRefusedCrypto with component and identity (family is derived via content_hash_family, not stored in parallel — review 45721)."

fn emit_host_structural_identity_outcome(
  component: std.types.NonEmptyStr,
  identity: std.content_hash.ContentHash,
) -> EmitHostStructuralIdentityOutcome {
  match identity {
    Fnv1a64(s) => EmitHostStructuralIdentityPresent { structural: s }
    Sha256Hash(_) =>
      EmitHostStructuralIdentityRefusedCrypto {
        component: component,
        identity: identity
      }
    Sha1Hash(_) =>
      EmitHostStructuralIdentityRefusedCrypto {
        component: component,
        identity: identity
      }
    Sha512Hash(_) =>
      EmitHostStructuralIdentityRefusedCrypto {
        component: component,
        identity: identity
      }
  }
}

fn toolchain_identity_structural_outcome(
  context: ResolvedBuildContext,
) -> EmitHostStructuralIdentityOutcome {
  fold(
    context.observed_tool_identities,
    init: EmitHostStructuralIdentityPresent {
      structural: content_hash_atom(value: "emit-host-resolved-build-toolchain-v1")
    },
    f: (acc, observed_tool_identity) => match acc {
      EmitHostStructuralIdentityPresent { structural: acc_structural } =>
        match emit_host_structural_identity_outcome(
          component: observed_tool_identity.tool_name,
          identity: observed_tool_identity.observed_identity,
        ) {
          EmitHostStructuralIdentityPresent { structural: right } =>
            EmitHostStructuralIdentityPresent {
              structural: content_hash_combine_structural(
                left: acc_structural,
                right: right
              )
            }
          EmitHostStructuralIdentityRefusedCrypto { component: c, identity: i } =>
            EmitHostStructuralIdentityRefusedCrypto {
              component: c,
              identity: i
            }
        }
      EmitHostStructuralIdentityRefusedCrypto { component: c, identity: i } =>
        EmitHostStructuralIdentityRefusedCrypto {
          component: c,
          identity: i
        }
    }
  )
}

fn toolchain_identity_outcome(context: ResolvedBuildContext) -> ToolchainIdentityOutcome {
  match toolchain_identity_structural_outcome(context: context) {
    EmitHostStructuralIdentityPresent { structural: s } =>
      ToolchainIdentityPresent {
        identity: as_content_hash_structural(structural: s)
      }
    EmitHostStructuralIdentityRefusedCrypto { component: c, identity: i } =>
      ToolchainIdentityRefusedCrypto {
        component: c,
        identity: i
      }
  }
}

fn observed_tool_identity(
  context: ResolvedBuildContext,
  tool_name: std.types.NonEmptyStr,
) -> ObservedToolIdentityLookup {
  let matching = context.observed_tool_identities |> filter(row => row.tool_name == tool_name)
  if count(matching) == 0 {
    ObservedToolIdentityMissing { tool_name: tool_name }
  } else if count(matching) == 1 {
    match matching |> first {
      Present { value: row } => ObservedToolIdentityFound { row: row }
      Absent => ObservedToolIdentityMissing { tool_name: tool_name }
    }
  } else {
    ObservedToolIdentityDuplicate { tool_name: tool_name, count: count(matching) }
  }
}

fn resolved_build_context_identity_outcome(
  context: ResolvedBuildContext,
) -> ResolvedBuildContextIdentityOutcome {
  match toolchain_identity_structural_outcome(context: context) {
    EmitHostStructuralIdentityPresent { structural: toolchain } =>
      match emit_host_structural_identity_outcome(
        component: "constructed-build-environment",
        identity: context.environment_identity,
      ) {
        EmitHostStructuralIdentityPresent { structural: environment } =>
          match emit_host_structural_identity_outcome(
            component: "cargo-configuration",
            identity: context.cargo_configuration_identity,
          ) {
            EmitHostStructuralIdentityPresent { structural: cargo_configuration } =>
              ResolvedBuildContextIdentityPresent {
                identity: artifact_realization_digest(inputs: [
                  std.artifact_store.ArtifactRealizationInput {
                    identity: "resolved-build-toolchain",
                    content_digest: toolchain
                  },
                  std.artifact_store.ArtifactRealizationInput {
                    identity: "constructed-build-environment",
                    content_digest: environment
                  },
                  std.artifact_store.ArtifactRealizationInput {
                    identity: "cargo-configuration",
                    content_digest: cargo_configuration
                  },
                ])
              }
            EmitHostStructuralIdentityRefusedCrypto { component: c, identity: i } =>
              ResolvedBuildContextIdentityRefusedCrypto {
                component: c,
                identity: i
              }
          }
        EmitHostStructuralIdentityRefusedCrypto { component: c, identity: i } =>
          ResolvedBuildContextIdentityRefusedCrypto {
            component: c,
            identity: i
          }
      }
    EmitHostStructuralIdentityRefusedCrypto { component: c, identity: i } =>
      ResolvedBuildContextIdentityRefusedCrypto {
        component: c,
        identity: i
      }
  }
}

fn native_cache_workspace_root(cache_root: String, key: std.content_hash.ContentHash) -> String {
  concat(cache_root, "/", serialize_content_hash(hash: key) as String)
}

fn native_cache_realization_workspace_root(
  workspace_root: String,
  realization_digest: std.content_hash.ContentHash
) -> String {
  concat(workspace_root, "/", serialize_content_hash(hash: realization_digest) as String)
}

fn native_cache_resolved_build_context_workspace_root(
  realization_workspace_root: String,
  resolved_build_context_identity: std.content_hash.ContentHash
) -> String {
  concat(
    realization_workspace_root,
    "/",
    serialize_content_hash(hash: resolved_build_context_identity) as String
  )
}

fn emit_on_demand_evict_native_cache(cache_root: String, key: std.content_hash.ContentHash) -> Bool {
  let workspace = native_cache_workspace_root(cache_root: cache_root, key: key)
  emit_host_native_cache_evict(workspace_dir: workspace)
}
