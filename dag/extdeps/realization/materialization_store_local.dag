// THE FIRST REAL REALIZATION OF THE MATERIALIZATION STORE: a local persistent filesystem.
//
// This module is a TRANSPORT HANDLER and nothing more (DESIGN section 3: interface, realization and
// policy are three facts). The store's semantics -- object format, lookup and commit decisions,
// integrity, completeness, kind, the miss/refuse partition -- live in std.materialization_object
// over std.materialization_provider. What lives here is only what is true of THIS realization:
//
//   WHERE -- the store root is a std.materialization_store_grant MaterializationStoreRoot, and every
//     effect is admitted by that grant before it runs; an object is <root>/<store_object_name>.
//   HOW A READ IS OBSERVED -- Filesystem.Read's typed failure channel: NotFound is an absent
//     object, every other kind is an unavailable one. No listing is consulted, ever.
//   HOW A PUBLISH IS OBSERVED -- Filesystem.WriteCreateNew, whose realization stages the bytes,
//     fsyncs them and publishes with a hard link, so the name appears complete or not at all and a
//     second writer of the same name gets AlreadyExists: put-if-absent by construction. No rename,
//     no overwrite, no temp file visible under the object's name.
//   WHICH STORE -- a store is OPENED by reading its identity marker; the marker's content hash is the
//     store INSTANCE on every receipt. A root with no marker is not a store: open refuses as
//     unavailable, so a missing volume can never be misread as an empty store full of misses, and
//     nothing is ever written to a substitute location (no shadow store).
//
// Initialization is the one act that creates a store, and it is create-new too, so two
// initializers converge on one marker.

data materialization_store_local_id: CacheInterfaceId = "materialization_store_local"

data materialization_store_marker_name: String = "materialization-store.identity"

data materialization_store_marker_magic: String = "gunbc-materialization-store v1"

fn store_path(root_path: String, name: String) -> String {
  if ends_with(s: root_path, suffix: "/") { concat(root_path, name) } else { concat(root_path, "/", name) }
}

fn store_marker_content(root: MaterializationStoreRoot, instance_label: NonEmptyStr) -> String {
  join([
    materialization_store_marker_magic,
    concat("durability ", materialization_store_durability_name(d: materialization_store_durability(root: root))),
    concat("instance ", instance_label as String),
    "",
  ], "\n")
}

fn store_marker_recognized(root: MaterializationStoreRoot, content: String) -> Bool {
  starts_with(
    s: content,
    prefix: join([
      materialization_store_marker_magic,
      concat("durability ", materialization_store_durability_name(d: materialization_store_durability(root: root))),
      "instance ",
    ], "\n")
  )
}

// ---------------------------------------------------------------------------------------------
// Transport observations -> the realization-agnostic observations.

// The detail names the host's KIND beside its message (filesystem_failure_kind_name), so a
// refusal read by a person or a later classifier carries the classification the channel made rather
// than only the host's free text.
fn filesystem_fault(kind: FilesystemFailureKind, error: String) -> StoreFault {
  let detail = join([filesystem_failure_kind_name(kind: kind), ": ", error], "")
  match kind {
    FilesystemPermissionDenied => StoreFault { class: StoreFaultUnauthorized, detail: detail }
    FilesystemNotFound => StoreFault { class: StoreFaultUnreachable, detail: detail }
    FilesystemAlreadyExists => StoreFault { class: StoreFaultUnreachable, detail: detail }
    FilesystemNotDirectory => StoreFault { class: StoreFaultUnreachable, detail: detail }
    FilesystemCrossDevice => StoreFault { class: StoreFaultUnreachable, detail: detail }
    FilesystemOtherFailure => StoreFault { class: StoreFaultUnreachable, detail: detail }
  }
}

fn store_read_observation(read: FilesystemExactRead) -> StoreObjectRead {
  match read {
    FilesystemExactPathRead { path: _, content: c } => StoreObjectPresent { content: c }
    FilesystemExactPathAbsent { path: _ } => StoreObjectAbsent
    FilesystemExactPathUnreadable { path: p, kind: k, error: e } =>
      StoreObjectUnavailable { fault: filesystem_fault(kind: k, error: concat(p, ": ", e)) }
    FilesystemExactPathKindUnrecognized { path: p, observed: o, error: e } =>
      StoreObjectUnavailable { fault: StoreFault { class: StoreFaultTransportVocabulary, detail: join([p, ": unrecognized error_kind ", o, ": ", e], "") } }
  }
}

fn store_publish_observation(create: FilesystemCreateNew) -> StoreObjectPublish {
  match create {
    FilesystemCreated { path: _ } => StoreObjectPublished
    FilesystemCreateTargetOccupied { path: _ } => StoreObjectOccupied
    FilesystemCreateRefused { path: p, kind: k, error: e } =>
      StoreObjectPublishRefused { fault: filesystem_fault(kind: k, error: concat(p, ": ", e)) }
    FilesystemCreateKindUnrecognized { path: p, observed: o, error: e } =>
      StoreObjectPublishRefused { fault: StoreFault { class: StoreFaultTransportVocabulary, detail: join([p, ": unrecognized error_kind ", o, ": ", e], "") } }
  }
}

// ---------------------------------------------------------------------------------------------
// Open.

type LocalStoreUnavailableCause
  = LocalStoreGrantRefused { verb: Verb, target: NamespacePosition, frame: Frame }
  | LocalStoreNotInitialized { marker_path: String }
  | LocalStoreMarkerUnrecognized { marker_path: String }
  | LocalStoreMarkerUnavailable { fault: StoreFault }

type LocalStoreOpening
  = LocalStoreOpened { root: MaterializationStoreRoot, store: OpenedMaterializationStore, durability: MaterializationStoreDurability, sweep: LocalStoreSweep }
  | LocalStoreUnavailable { root_path: String, cause: LocalStoreUnavailableCause }

// PURE: the open decision over the marker read. Hermetic controls call this directly.
fn local_store_open_decide(root: MaterializationStoreRoot, marker_read: FilesystemExactRead) -> LocalStoreOpening {
  let root_path = materialization_store_root_path(root: root)
  let marker_path = store_path(root_path: root_path, name: materialization_store_marker_name)
  match marker_read {
    FilesystemExactPathAbsent { path: _ } =>
      LocalStoreUnavailable { root_path: root_path, cause: LocalStoreNotInitialized { marker_path: marker_path } }
    FilesystemExactPathUnreadable { path: _, kind: k, error: e } =>
      LocalStoreUnavailable { root_path: root_path, cause: LocalStoreMarkerUnavailable { fault: filesystem_fault(kind: k, error: e) } }
    FilesystemExactPathKindUnrecognized { path: _, observed: o, error: e } =>
      LocalStoreUnavailable { root_path: root_path, cause: LocalStoreMarkerUnavailable { fault: StoreFault { class: StoreFaultTransportVocabulary, detail: concat(o, ": ", e) } } }
    FilesystemExactPathRead { path: _, content: c } =>
      if store_marker_recognized(root: root, content: c) {
        LocalStoreOpened {
          root: root,
          store: OpenedMaterializationStore {
            provider: materialization_store_local_id,
            instance: content_hash_of_value(value: c as NonEmptyStr)
          },
          durability: materialization_store_durability(root: root),
          sweep: LocalStoreSweepNotRun
        }
      } else {
        LocalStoreUnavailable { root_path: root_path, cause: LocalStoreMarkerUnrecognized { marker_path: marker_path } }
      }
  }
}

fn local_store_read(path: String) -> FilesystemExactRead {
  let r = Filesystem.Read(path: path)
  filesystem_exact_read(path: path, content: r.content, success: r.success, error: r.error, error_kind: r.error_kind)
}

fn local_store_create_new(path: String, content: String) -> FilesystemCreateNew {
  let w = Filesystem.WriteCreateNew(path: path, content: content)
  filesystem_create_new(path: path, success: w.success, error: w.error, error_kind: w.error_kind)
}

fn local_store_open(root: MaterializationStoreRoot) -> LocalStoreOpening {
  let root_path = materialization_store_root_path(root: root)
  match materialization_store_admissible(root: root, verb: Read) {
    Deny { refusal: _ } =>
      LocalStoreUnavailable {
        root_path: root_path,
        cause: LocalStoreGrantRefused { verb: Read, target: absolute_path_position(path: root_path), frame: materialization_store_frame }
      }
    Permit =>
      match local_store_open_decide(
        root: root,
        marker_read: local_store_read(path: store_path(root_path: root_path, name: materialization_store_marker_name))
      ) {
        LocalStoreUnavailable { root_path: p, cause: c } => LocalStoreUnavailable { root_path: p, cause: c }
        LocalStoreOpened { root: r, store: st, durability: d, sweep: _ } =>
          LocalStoreOpened { root: r, store: st, durability: d, sweep: local_store_sweep(root: r) }
      }
  }
}

type LocalStoreInitialization
  = LocalStoreInitialized { opening: LocalStoreOpening }
  | LocalStoreInitializationRefused { root_path: String, cause: LocalStoreUnavailableCause }

// Initialization publishes the marker create-new and then OPENS the store it created, so the
// returned opening is the same observation every later open makes -- a marker written by a
// concurrent initializer with a different label opens as THAT store, never as ours.
fn local_store_initialize(root: MaterializationStoreRoot, instance_label: NonEmptyStr) -> LocalStoreInitialization {
  let root_path = materialization_store_root_path(root: root)
  match materialization_store_admissible(root: root, verb: Write) {
    Deny { refusal: _ } =>
      LocalStoreInitializationRefused {
        root_path: root_path,
        cause: LocalStoreGrantRefused { verb: Write, target: absolute_path_position(path: root_path), frame: materialization_store_frame }
      }
    Permit =>
      match store_publish_observation(create: local_store_create_new(
        path: store_path(root_path: root_path, name: materialization_store_marker_name),
        content: store_marker_content(root: root, instance_label: instance_label)
      )) {
        StoreObjectPublishRefused { fault: f } =>
          LocalStoreInitializationRefused { root_path: root_path, cause: LocalStoreMarkerUnavailable { fault: f } }
        StoreObjectPublished => LocalStoreInitialized { opening: local_store_open(root: root) }
        StoreObjectOccupied => LocalStoreInitialized { opening: local_store_open(root: root) }
      }
  }
}

// ---------------------------------------------------------------------------------------------
// BOUNDED RETENTION: each request FAMILY has its own declared byte budget inside the one root, and the
// host ceiling is their declared sum (operator ruling via royal-moth-86, 2026-10-03, after an earlier
// on-disk cache with no ceiling or cleanup filled the CI runners' disks). The budget is not a number
// this module enforces by itself: it is a std.materialization_ladder CacheProvider row per family, and
// the store is CONSTRUCTED from that row by std.artifact_store store_over_provider, which refuses an
// unbounded or unobserved row and realizes ReplaceExisting { LeastRecentlyUsed } with a fit test
// before any eviction. So an unbounded family cannot be written here, an artifact larger than its
// family's budget refuses (StoreCommitDidNotFit) without evicting anything, and no family evicts
// another's entries -- each family's accounting is its own index.
//
// ONE ROOT PER HOST is structural: DurableHostVolumeRoot is a nullary arm naming one path
// (std.materialization_store_grant materialization_store_durable_root_path), so the host-wide ceiling
// is local_store_host_ceiling_bytes and nothing else; WitnessScratchRoot is the fixture arm and
// carries the fixture budgets below.

type LocalStoreFamilyBudget {
  family: ArtifactKindId
  budget: ByteSize
}

// POLICY, NAMED AS POLICY: 4 GiB for typed-module results per host. It is not derived from a
// measurement -- the only measured predecessor stored closure snapshots of ~3.65 GB each, which is not
// the per-module grain this store holds -- and its REVISION TRIGGER is the TypecheckModuleRequest
// consumer (PR C2) measuring real per-module entries on the durable root.
data local_store_typed_module_budget_policy: ByteSize = byte_size(count: 4294967296)

// THE COMPUTE FAMILY'S BUDGET IS RETAINED RECORDS x RECORD SIZE, and both factors are named.
// Retained records: a build's record must stay served for as long as a dependent compile or claim run
// of the same tree is in flight, and a host runs at most gunbc.compute.host_capacity compute_pool_slots
// (2) compute units at once, so at most two builds can be under an outstanding dependent obligation.
// Record size: one release build of the default bins -- gunbc 38814272 + claim_batch 36982312 bytes
// under rustc 1.93.0, measured 2026-10-03 by `cargo build --release -p v1-compiler --bin gunbc --bin
// claim_batch` + `stat -c %s` on a BuildBuddy runner. The text parts (outcome, log, output manifest)
// are a rounding error beside them. The binaries become byte parts of this record when the staged
// byte-part realization lands (C1b); until then the budget over-reserves for text-only records, which
// is the direction a ceiling may err. REVISION TRIGGER: the compute family's own commits measured
// on the durable root (occupancy index), or a change to compute_pool_slots.
data local_store_compute_work_record_bytes_measured: Nat = 75796584

data local_store_compute_work_retained_records: Nat = 2

data local_store_compute_work_budget_policy: ByteSize = byte_size(count: local_store_compute_work_record_bytes_measured * local_store_compute_work_retained_records)

data local_store_durable_family_budgets: List<LocalStoreFamilyBudget> = [
  LocalStoreFamilyBudget { family: typed_module_artifact_kind, budget: local_store_typed_module_budget_policy },
  LocalStoreFamilyBudget { family: compute_work_artifact_kind, budget: local_store_compute_work_budget_policy },
]

// Fixture budgets for WitnessScratchRoot: small enough that a wet witness overruns them in a few
// commits, so eviction and the fit refusal are reached by execution.
data local_store_witness_family_budgets: List<LocalStoreFamilyBudget> = [
  LocalStoreFamilyBudget { family: native_module_verdict_bundle_artifact_kind, budget: byte_size(count: 4096) },
  LocalStoreFamilyBudget { family: typed_module_artifact_kind, budget: byte_size(count: 4096) },
  LocalStoreFamilyBudget { family: compute_work_artifact_kind, budget: byte_size(count: 4096) },
]

// The budgets are a fact of the ROOT, derived from it rather than passed in by a caller.
fn local_store_family_budgets(root: MaterializationStoreRoot) -> List<LocalStoreFamilyBudget> {
  match root {
    DurableHostVolumeRoot => local_store_durable_family_budgets
    WitnessScratchRoot { root: _ } => local_store_witness_family_budgets
  }
}

fn local_store_budget_sum(budgets: List<LocalStoreFamilyBudget>) -> ByteSize {
  byte_size(count: fold(budgets, init: 0, f: (acc, b) => acc + measure_count(m: b.budget)))
}

// The one host-wide figure: the sum of the durable root's declared family budgets.
data local_store_host_ceiling_bytes: ByteSize = local_store_budget_sum(budgets: local_store_durable_family_budgets)

fn local_store_family_provider(family: ArtifactKindId, budget: ByteSize) -> CacheProvider {
  provider_row(
    id: concat("materialization_store_local:", family as String),
    scope: [materialization_store_frame],
    coverage: CoversIdentities { identities: [family as String] },
    tier: ArtifactTier { keying: ContentKeyed },
    retention: persistent_retention(capacity: CapacityBounded {
      limit: ByteCapacity { limit: ExactLimit { value: budget } },
      at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed }
    })
  )
}

fn local_store_family_budget(root: MaterializationStoreRoot, family: ArtifactKindId) -> LocalStoreFamilyBudget? {
  local_store_family_budgets(root: root) |> filter(b => b.family == family) |> first
}

// The object's size is its UTF-8 byte count, the same quantity std.materialization_object payload_part
// puts in a ByteSize -- never string_length, which counts code points.
fn local_store_object_bytes(object: String) -> ByteSize {
  byte_size(count: bytes_octets(b: utf8_encode_bytes(s: object)) |> count())
}

// ---------------------------------------------------------------------------------------------
// THE OCCUPANCY INDEX: one CAS slot per family in the store root, retained as a generation WINDOW
// (gunbc.durable_cas_file_store KeepGenerationWindow, k = 2) because its history is not evidence --
// its only fact is the head. Its canonical, versioned encoding is one header, the next ordinal, one
// row per live object sorted by name, then one `doomed` row per evicted object whose delete the host
// has not yet confirmed. A slot that does not decode REFUSES as corrupt, never reads as empty
// (docs/plans/demand-engine-program.md section 2.8, EvaluationIndexCorrupt). The recovery is the
// operator's: delete the family's occupancy slot files; the next open's sweep then removes every
// object the empty index no longer names, so a quarantine never leaves unaccounted bytes behind.
//
// DOOMED BYTES ARE CHARGED. An evicted row leaves the live set in the same CAS that admits the new
// row, and enters `doomed` with its size; it leaves `doomed` only in a later CAS made after the host
// CONFIRMED the object is gone (deleted, or absent). Live plus doomed bytes never exceed the family
// budget, so a host that refuses deletes fills the budget with doomed bytes and the store's writes
// refuse -- disk never grows past the ceiling by way of a delete that did not happen.

data local_store_index_magic: String = "gunbc-store-occupancy v2"

data local_store_index_window_k: Int = 2

fn local_store_index_key(family: ArtifactKindId) -> NonEmptyStr {
  concat("occupancy-", family as String) as NonEmptyStr
}

type LocalStoreIndexRow {
  name: String
  bytes: ByteSize
  ordinal: Int
}

type LocalStoreDoomedRow {
  name: String
  bytes: ByteSize
}

type LocalStoreIndex {
  next_ordinal: Int
  rows: List<LocalStoreIndexRow>
  doomed: List<LocalStoreDoomedRow>
}

type LocalStoreIndexDecode
  = LocalStoreIndexDecoded { index: LocalStoreIndex }
  | LocalStoreIndexCorrupt { detail: String }

data local_store_empty_index: LocalStoreIndex = LocalStoreIndex { next_ordinal: 1, rows: [], doomed: [] }

// THE ONE DELETION AUTHORITY. A name is this store's object exactly when it is what
// store_object_name produces: a serialized content hash that parses (std.content_hash
// parse_content_hash, the inverse at the same home) and re-serializes to itself, followed by the
// object format suffix. No other name -- a path with a separator, a traversal, a foreign file that
// merely contains the suffix -- is ever indexed, swept or deleted.
fn local_store_object_suffix() -> String {
  concat(".materialization.", store_object_format_version)
}

fn local_store_is_object_name(name: String) -> Bool {
  let suffix = local_store_object_suffix()
  let n = string_length(s: name)
  let k = string_length(s: suffix)
  if n <= k || !ends_with(s: name, suffix: suffix) { false } else {
    let prefix = substring(s: name, start: 0, end: n - k)
    match parse_content_hash(wire: prefix) {
      Absent => false
      Present { value: h } => serialize_content_hash(hash: h) as String == prefix
    }
  }
}

// A record's byte part is <record>.part.<output id>: the record must itself be a canonical object
// name and the id a declared output identifier ([a-z0-9_]+, the std.judgment_contract spelling), so a
// part name can never carry a separator, a traversal or a second ".part.". A STORE FILE is a record
// or one of its parts; nothing else in the root is ever a deletion candidate.
fn local_store_is_output_id_text(id: String) -> Bool {
  id != "" && (id |> chars |> all(c => (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95))
}

fn local_store_is_part_name(name: String) -> Bool {
  let pieces: List<String> = name.split(delimiter: ".part.")
  count(pieces) == 2
    && local_store_is_object_name(name: match first(pieces) { Present { value: v } => v Absent => "" })
    && local_store_is_output_id_text(id: match first(skip(pieces, 1)) { Present { value: v } => v Absent => "" })
}

fn local_store_is_store_file_name(name: String) -> Bool {
  local_store_is_object_name(name: name) || local_store_is_part_name(name: name)
}

fn local_store_index_row_line(r: LocalStoreIndexRow) -> String {
  join([r.name, measure_count(m: r.bytes) as String, r.ordinal as String], " ")
}

fn local_store_doomed_row_line(r: LocalStoreDoomedRow) -> String {
  join(["doomed", r.name, measure_count(m: r.bytes) as String], " ")
}

fn local_store_index_encode(index: LocalStoreIndex) -> String {
  let rows = index.rows |> sort_by(r => r.name) |> map(r => local_store_index_row_line(r: r))
  let doomed = index.doomed |> sort_by(r => r.name) |> map(r => local_store_doomed_row_line(r: r))
  join(concat(concat([local_store_index_magic, concat("next ", index.next_ordinal as String)], rows), doomed), "\n")
}

fn local_store_digits_int(s: String) -> Int? {
  if s == "" || !decimal_digits_only(s: s) { none } else {
    fold(s |> chars, init: Present { value: 0 }, f: (acc, c) => match acc {
      Absent => none
      Present { value: n } => if n > (int_inclusive_max() - (c - 48)) / 10 { none } else { Present { value: n * 10 + (c - 48) } }
    })
  }
}

type LocalStoreIndexLine
  = LocalStoreLiveLine { row: LocalStoreIndexRow }
  | LocalStoreDoomedLine { row: LocalStoreDoomedRow }
  | LocalStoreUndecodableLine

fn local_store_index_line_decode(line: String) -> LocalStoreIndexLine {
  let parts: List<String> = line.split(delimiter: " ")
  if count(parts) != 3 { LocalStoreUndecodableLine } else {
    let p0 = match first(parts) { Present { value: v } => v Absent => "" }
    let p1 = match first(skip(parts, 1)) { Present { value: v } => v Absent => "" }
    let p2 = match first(skip(parts, 2)) { Present { value: v } => v Absent => "" }
    if p0 == "doomed" {
      match local_store_digits_int(s: p2) {
        Absent => LocalStoreUndecodableLine
        Present { value: b } =>
          if local_store_is_object_name(name: p1) { LocalStoreDoomedLine { row: LocalStoreDoomedRow { name: p1, bytes: byte_size(count: b) } } } else { LocalStoreUndecodableLine }
      }
    } else {
      match local_store_digits_int(s: p1) {
        Absent => LocalStoreUndecodableLine
        Present { value: b } => match local_store_digits_int(s: p2) {
          Absent => LocalStoreUndecodableLine
          Present { value: o } =>
            if local_store_is_object_name(name: p0) { LocalStoreLiveLine { row: LocalStoreIndexRow { name: p0, bytes: byte_size(count: b), ordinal: o } } } else { LocalStoreUndecodableLine }
        }
      }
    }
  }
}

type LocalStoreIndexLines {
  ok: Bool
  rows: List<LocalStoreIndexRow>
  doomed: List<LocalStoreDoomedRow>
}

fn local_store_index_decode(content: String) -> LocalStoreIndexDecode {
  let lines: List<String> = content.split(delimiter: "\n")
  let magic = match first(lines) { Present { value: v } => v Absent => "" }
  let next_line = match first(skip(lines, 1)) { Present { value: v } => v Absent => "" }
  if magic != local_store_index_magic {
    LocalStoreIndexCorrupt { detail: "the occupancy index does not start with its format header" }
  } else if !starts_with(s: next_line, prefix: "next ") {
    LocalStoreIndexCorrupt { detail: "the occupancy index has no next-ordinal line" }
  } else {
    match local_store_digits_int(s: substring(s: next_line, start: 5, end: string_length(s: next_line))) {
      Absent => LocalStoreIndexCorrupt { detail: "the occupancy index's next ordinal is not a number" }
      Present { value: next } => {
        let decoded = fold(skip(lines, 2), init: LocalStoreIndexLines { ok: true, rows: [], doomed: [] }, f: (acc, l) => match local_store_index_line_decode(line: l) {
          LocalStoreLiveLine { row: r } => LocalStoreIndexLines { ok: acc.ok, rows: acc.rows |> list_push(r), doomed: acc.doomed }
          LocalStoreDoomedLine { row: d } => LocalStoreIndexLines { ok: acc.ok, rows: acc.rows, doomed: acc.doomed |> list_push(d) }
          LocalStoreUndecodableLine => LocalStoreIndexLines { ok: false, rows: acc.rows, doomed: acc.doomed }
        })
        if !decoded.ok {
          LocalStoreIndexCorrupt { detail: "an occupancy index row does not decode as a canonical object name with its bytes" }
        } else {
          LocalStoreIndexDecoded { index: LocalStoreIndex { next_ordinal: next, rows: decoded.rows, doomed: decoded.doomed } }
        }
      }
    }
  }
}

fn local_store_doomed_bytes(index: LocalStoreIndex) -> Int {
  fold(index.doomed, init: 0, f: (acc, d) => acc + measure_count(m: d.bytes))
}

fn local_store_row_key(name: String) -> ContentHash {
  content_hash_of_value(value: name as NonEmptyStr)
}

// The index as the std.artifact_store fold sees it, with the budget from the family's provider row.
fn local_store_artifact_store(budget: ByteSize, index: LocalStoreIndex) -> ArtifactStore {
  ArtifactStore {
    budget: budget,
    next_ordinal: index.next_ordinal,
    rows: index.rows |> map(r => ArtifactRow { key: local_store_row_key(name: r.name), artifact_bytes: r.bytes, last_use_ordinal: r.ordinal })
  }
}

// Back from the fold: each surviving row keeps its name, found through the key it was given.
// Each name is hashed ONCE into a key -> name map, and each surviving row finds its name by one
// lookup -- never by re-hashing every name per row (a quadratic fold, DESIGN section 6).
fn local_store_name_by_key(names: List<String>) -> Map<String, String> {
  fold(names, init: empty_map(), f: (m, n) => map_insert(m, serialize_content_hash(hash: local_store_row_key(name: n)) as String, n))
}

fn local_store_index_of(store: ArtifactStore, names: List<String>, doomed: List<LocalStoreDoomedRow>) -> LocalStoreIndex {
  let by_key = local_store_name_by_key(names: names)
  LocalStoreIndex {
    next_ordinal: store.next_ordinal,
    doomed: doomed,
    rows: store.rows |> fold(init: [], f: (acc, row) => match map_get(by_key, serialize_content_hash(hash: row.key) as String) {
      Absent => acc
      Present { value: n } => acc |> list_push(LocalStoreIndexRow { name: n, bytes: row.artifact_bytes, ordinal: row.last_use_ordinal })
    })
  }
}

fn local_store_name_set(names: List<String>) -> Set<String> {
  fold(names, init: empty_set(), f: (acc, n) => set_insert(acc, n))
}

fn local_store_index_retention() -> CasSlotRetention? {
  match cas_generation_window(k: local_store_index_window_k) {
    CasGenerationWindowAdmitted { window: w } => Present { value: KeepGenerationWindow { window: w } }
    CasGenerationWindowTooNarrow { k: _ } => none
  }
}

type LocalStoreIndexRead
  = LocalStoreIndexAt { index: LocalStoreIndex, expected: CasExpectation }
  | LocalStoreIndexUnavailable { cause: String }

fn local_store_read_index(root_path: String, family: ArtifactKindId) -> LocalStoreIndexRead {
  match local_store_index_retention() {
    Absent => LocalStoreIndexUnavailable { cause: "the occupancy index window is narrower than its floor" }
    Present { value: retention } =>
      match observe_cas_slot_state(root: root_path as NonEmptyStr, key: local_store_index_key(family: family), retention: retention) {
        CasObservedUnreadable { cause: c } => LocalStoreIndexUnavailable { cause: concat("the occupancy index could not be read: ", cas_unreadable_slot_detail(cause: c)) }
        CasObservedReadable { readable: r } => match r {
          CasReadableAbsent => LocalStoreIndexAt { index: local_store_empty_index, expected: ExpectSlotAbsent }
          CasReadablePresent { version: v } => match local_store_index_decode(content: v.value as String) {
            LocalStoreIndexCorrupt { detail: d } => LocalStoreIndexUnavailable { cause: concat("the occupancy index is corrupt: ", d) }
            LocalStoreIndexDecoded { index: i } => LocalStoreIndexAt { index: i, expected: ExpectSlotGeneration { generation: v.generation } }
          }
        }
      }
  }
}

type LocalStoreIndexWrite
  = LocalStoreIndexWritten { reclamation: CasWindowReclamation }
  | LocalStoreIndexLostRace
  | LocalStoreIndexWriteRefused { cause: String }

fn local_store_write_index(root_path: String, family: ArtifactKindId, expected: CasExpectation, index: LocalStoreIndex) -> LocalStoreIndexWrite {
  let content = local_store_index_encode(index: index) as NonEmptyStr
  match local_store_index_retention() {
    Absent => LocalStoreIndexWriteRefused { cause: "the occupancy index window is narrower than its floor" }
    Present { value: retention } =>
      match admit_cas_attempt(attempt: cas_attempt(key: local_store_index_key(family: family), expected: expected, proposed: content, proposed_content: content_hash_of_value(value: content))) {
        CasAttemptDigestMismatch { claimed: _, actual: _ } => LocalStoreIndexWriteRefused { cause: "the occupancy index digest did not match its bytes" }
        CasAttemptDigestIncomparable { claimed: _, actual: _ } => LocalStoreIndexWriteRefused { cause: "the occupancy index digest was incomparable" }
        CasAttemptKeyNotSlotAddressable { key: _ } => LocalStoreIndexWriteRefused { cause: "the occupancy index key is not slot-addressable" }
        CasAttemptAdmitted { verified: v } => {
          let write = file_compare_and_set(root: root_path as NonEmptyStr, publication: DefaultAccessCreateOnly, retention: retention, verified: v)
          match write.outcome {
            CasCommitted { committed: _ } => LocalStoreIndexWritten { reclamation: write.reclamation }
            CasPreconditionFailed { expected: _, observed: _ } => LocalStoreIndexLostRace
            CasStoreRefused { cause: c } => LocalStoreIndexWriteRefused { cause: "the occupancy index write was refused by the store" }
          }
        }
      }
  }
}

// ---------------------------------------------------------------------------------------------
// CONFIRMED DELETION. A name leaves `doomed` only when the host CONFIRMS the bytes are gone: the
// delete succeeded, or the target was already absent. A refused or unrecognized delete leaves the
// name doomed and its bytes charged. Every path below is store_path(root, name) for a name the
// recognizer admitted, so a delete never reaches outside the root.

fn local_store_delete_confirmed(root_path: String, name: String) -> Bool {
  let path = store_path(root_path: root_path, name: name)
  let d = Filesystem.Delete(path: path)
  match filesystem_delete(path: path, success: d.success, error: d.error, error_kind: d.error_kind) {
    FilesystemDeleted { path: _ } => true
    FilesystemDeleteTargetAbsent { path: _ } => true
    FilesystemDeleteRefused { path: _, kind: _, error: _ } => false
    FilesystemDeleteKindUnrecognized { path: _, observed: _, error: _ } => false
  }
}

// One delete, observed once, so a receipt splits its results instead of searching for them.
type LocalStoreDeleteAttempt {
  name: String
  confirmed: Bool
}

fn local_store_delete_attempts(root_path: String, names: List<String>) -> List<LocalStoreDeleteAttempt> {
  names |> map(n => LocalStoreDeleteAttempt { name: n, confirmed: local_store_delete_confirmed(root_path: root_path, name: n) })
}

// ---------------------------------------------------------------------------------------------
// RESERVATION: the index row is committed BEFORE the object is published. One CAS does three things:
// it retires the doomed names whose delete the host has now confirmed, it admits the new row against
// the budget LESS the doomed bytes still charged, and it moves the rows that admission evicted into
// `doomed`. An artifact larger than the whole budget refuses as did-not-fit and evicts nothing; one
// that fits the budget but not what the undeleted bytes leave of it refuses as cleanup outstanding.
// A loser of the index CAS re-reads and retries, never overwrites; past the bound it refuses. An
// object already live is not re-reserved (put-if-absent is idempotent). Reserving is necessary but
// not sufficient for an object to stay accounted: the commit re-reads the index after publishing
// (local_store_commit), because another writer may evict this row while this one is publishing.

data local_store_reservation_attempt_bound: Int = 8

type LocalStoreReservation
  = LocalStoreReserved { evicted: List<LocalStoreDoomedRow>, retired: List<String>, reclamation: CasWindowReclamation }
  | LocalStoreReservationRefused { refusal: StoreCommitRefusal }

fn local_store_reserve(root: MaterializationStoreRoot, family: ArtifactKindId, name: String, bytes: ByteSize, attempt: Int) -> LocalStoreReservation {
  let root_path = materialization_store_root_path(root: root)
  if attempt > local_store_reservation_attempt_bound {
    LocalStoreReservationRefused { refusal: StoreCommitOccupancyUnavailable { cause: "the occupancy index kept moving under concurrent writers past the attempt bound" } }
  } else {
    match local_store_family_budget(root: root, family: family) {
      Absent => LocalStoreReservationRefused { refusal: StoreCommitBudgetUndeclared { family: family } }
      Present { value: b } =>
        match store_over_provider(provider: local_store_family_provider(family: family, budget: b.budget)) {
          StoreRefusedRetention { provider_id: _, declared: _, cause: _ } =>
            LocalStoreReservationRefused { refusal: StoreCommitOccupancyUnavailable { cause: "the family's provider row does not construct a bounded store" } }
          StoreReady { store: ready } =>
            match local_store_read_index(root_path: root_path, family: family) {
              LocalStoreIndexUnavailable { cause: c } => LocalStoreReservationRefused { refusal: StoreCommitOccupancyUnavailable { cause: c } }
              LocalStoreIndexAt { index: index, expected: expected } => {
                let cleanup = local_store_delete_records_confirmed(root_path: root_path, records: index.doomed |> map(d => d.name))
                let gone = local_store_name_set(names: cleanup |> filter(t => t.confirmed) |> map(t => t.name))
                let still_doomed = index.doomed |> filter(d => !set_contains(gone, d.name))
                let undeleted = fold(still_doomed, init: 0, f: (acc, d) => acc + measure_count(m: d.bytes))
                let budget_total = measure_count(m: ready.budget)
                let artifact = measure_count(m: bytes)
                let live_names = local_store_name_set(names: index.rows |> map(r => r.name))
                if artifact > budget_total {
                  LocalStoreReservationRefused { refusal: StoreCommitDidNotFit { artifact_bytes: bytes, budget: ready.budget } }
                } else if set_contains(live_names, name) {
                  LocalStoreReserved { evicted: [], retired: [], reclamation: CasReclamationNotCommitted }
                } else if artifact > budget_total - undeleted {
                  LocalStoreReservationRefused { refusal: StoreCommitCleanupOutstanding { artifact_bytes: bytes, budget: ready.budget, undeleted: byte_size(count: undeleted) } }
                } else {
                  let cleaned = LocalStoreIndex { next_ordinal: index.next_ordinal, rows: index.rows, doomed: still_doomed }
                  match store_put(store: local_store_artifact_store(budget: byte_size(count: budget_total - undeleted), index: cleaned), key: local_store_row_key(name: name), artifact_bytes: bytes) {
                    StorePutDidNotFit { artifact_bytes: a, budget: _ } =>
                      LocalStoreReservationRefused { refusal: StoreCommitCleanupOutstanding { artifact_bytes: a, budget: ready.budget, undeleted: byte_size(count: undeleted) } }
                    StorePutAdmitted { store: packed, evicted: _ } => {
                      let names = concat(index.rows |> map(r => r.name), [name])
                      let survivors = local_store_index_of(store: packed, names: names, doomed: []).rows
                      let kept = local_store_name_set(names: survivors |> map(k => k.name))
                      let evicted_rows = index.rows |> filter(r => !set_contains(kept, r.name))
                      let next_index = LocalStoreIndex {
                        next_ordinal: packed.next_ordinal,
                        rows: survivors,
                        doomed: concat(still_doomed, evicted_rows |> map(r => LocalStoreDoomedRow { name: r.name, bytes: r.bytes }))
                      }
                      match local_store_write_index(root_path: root_path, family: family, expected: expected, index: next_index) {
                        LocalStoreIndexWritten { reclamation: rc } =>
                          LocalStoreReserved { evicted: evicted_rows |> map(r => LocalStoreDoomedRow { name: r.name, bytes: r.bytes }), retired: cleanup |> filter(t => t.confirmed) |> map(t => t.name), reclamation: rc }
                        LocalStoreIndexLostRace => local_store_reserve(root: root, family: family, name: name, bytes: bytes, attempt: attempt + 1)
                        LocalStoreIndexWriteRefused { cause: c } => LocalStoreReservationRefused { refusal: StoreCommitOccupancyUnavailable { cause: c } }
                      }
                    }
                  }
                }
              }
            }
        }
    }
  }
}

// AFTER PUBLISHING, a writer re-reads its family's index. If its row is still live the object is
// accounted. If another writer evicted it meanwhile -- the evictor's delete ran before this publish,
// so it found nothing -- the published bytes are unaccounted, and this writer removes them; if the
// host refuses that delete, the name is added to `doomed` so its bytes are charged until a later
// reservation confirms them gone.
type LocalStorePostPublish
  = LocalStoreStillLive
  | LocalStoreEvictedAndRemoved
  | LocalStoreEvictedAndDoomed
  | LocalStorePostPublishUnavailable { cause: String }

fn local_store_doom(root_path: String, family: ArtifactKindId, name: String, bytes: ByteSize, attempt: Int) -> LocalStorePostPublish {
  if attempt > local_store_reservation_attempt_bound {
    LocalStorePostPublishUnavailable { cause: "the occupancy index kept moving under concurrent writers past the attempt bound" }
  } else {
    match local_store_read_index(root_path: root_path, family: family) {
      LocalStoreIndexUnavailable { cause: c } => LocalStorePostPublishUnavailable { cause: c }
      LocalStoreIndexAt { index: index, expected: expected } =>
        if index.rows |> any(r => r.name == name) {
          LocalStoreStillLive
        } else if index.doomed |> any(d => d.name == name) {
          LocalStoreEvictedAndDoomed
        } else {
          let next_index = LocalStoreIndex { next_ordinal: index.next_ordinal, rows: index.rows, doomed: index.doomed |> list_push(LocalStoreDoomedRow { name: name, bytes: bytes }) }
          match local_store_write_index(root_path: root_path, family: family, expected: expected, index: next_index) {
            LocalStoreIndexWritten { reclamation: _ } => LocalStoreEvictedAndDoomed
            LocalStoreIndexLostRace => local_store_doom(root_path: root_path, family: family, name: name, bytes: bytes, attempt: attempt + 1)
            LocalStoreIndexWriteRefused { cause: c } => LocalStorePostPublishUnavailable { cause: c }
          }
        }
    }
  }
}

fn local_store_post_publish(root_path: String, family: ArtifactKindId, name: String, bytes: ByteSize) -> LocalStorePostPublish {
  match local_store_read_index(root_path: root_path, family: family) {
    LocalStoreIndexUnavailable { cause: c } => LocalStorePostPublishUnavailable { cause: c }
    LocalStoreIndexAt { index: index, expected: _ } =>
      if index.rows |> any(r => r.name == name) {
        LocalStoreStillLive
      } else if local_store_delete_records_confirmed(root_path: root_path, records: [name]) |> all(t => t.confirmed) {
        LocalStoreEvictedAndRemoved
      } else {
        local_store_doom(root_path: root_path, family: family, name: name, bytes: bytes, attempt: 1)
      }
  }
}

// A record's byte parts are files named <record>.part.<output id> beside it, and they leave WITH it:
// the record first (so no reader can serve a record whose parts are going), then every part the root
// lists under its name. A refused delete is reported like any other and swept on the next open.
fn local_store_part_name(record: String, id: ArtifactOutputId) -> String {
  concat(concat(record, ".part."), id as String)
}

// The record a part file belongs to: the name before its ".part." separator, or the name itself for
// a record, so sweep membership is ONE set lookup per listed name.
fn local_store_record_of(name: String) -> String {
  match first(name.split(delimiter: ".part.")) {
    Present { value: r } => r
    Absent => name
  }
}

fn local_store_is_part_of(name: String, record: String) -> Bool {
  starts_with(s: name, prefix: concat(record, ".part."))
}

// A RECORD IS GONE only when the record file and every part file the root lists under it are gone,
// each confirmed by the host. The record goes first, so no reader serves a record whose parts are
// going; one listing serves every record in the call. A listing the host refuses confirms nothing, so
// every record in the call stays doomed and charged rather than being assumed partless.
fn local_store_delete_records_confirmed(root_path: String, records: List<String>) -> List<LocalStoreDeleteAttempt> {
  if count(records) == 0 { [] } else {
    let record_attempts = local_store_delete_attempts(root_path: root_path, names: records)
    let listing = Filesystem.List(path: root_path)
    match filesystem_listing_observation(directory: root_path, success: listing.success, entries: listing.entries, error: listing.error) {
      FilesystemDirectoryListed(listed) => {
        let wanted = local_store_name_set(names: records)
        let part_attempts = local_store_delete_attempts(
          root_path: root_path,
          names: filesystem_listing_entry_names(listing: listed) |> filter(n => local_store_is_part_name(name: n) && set_contains(wanted, local_store_record_of(name: n)))
        )
        let parts_left = local_store_name_set(names: part_attempts |> filter(t => !t.confirmed) |> map(t => local_store_record_of(name: t.name)))
        record_attempts |> map(t => LocalStoreDeleteAttempt { name: t.name, confirmed: t.confirmed && !set_contains(parts_left, t.name) })
      }
      FilesystemDirectoryListingRefused { directory: _, error: _ } => records |> map(r => LocalStoreDeleteAttempt { name: r, confirmed: false })
      FilesystemDirectorySubjectRefused { directory: _, cause: _ } => records |> map(r => LocalStoreDeleteAttempt { name: r, confirmed: false })
    }
  }
}

// ---------------------------------------------------------------------------------------------
// SELF-CLEAN ON OPEN. The listing is taken FIRST and the family indexes are read AFTER it: an object
// in the listing was published after its reservation, so an index read after the listing names it
// unless it was since evicted -- in which case deleting it is right. Only this realization's object
// names (<digest>.materialization.<version>) are candidates; the marker, the index slots and any
// other file are never touched, nothing is recursed into, and an index that cannot be read stops the
// sweep (nothing is deleted on a guess).

// LocalStoreSweepNotRun: the pure open decision never touches the filesystem, so it reports the
// sweep as not run; the effectful local_store_open runs it once the marker has opened the store.
type LocalStoreSweep
  = LocalStoreSwept { removed: List<String>, delete_refused: List<String> }
  | LocalStoreSweepUnavailable { cause: String }
  | LocalStoreSweepNotRun

fn local_store_indexed_names(root: MaterializationStoreRoot) -> List<String>? {
  let root_path = materialization_store_root_path(root: root)
  fold(local_store_family_budgets(root: root), init: Present { value: [] }, f: (acc, b) => match acc {
    Absent => none
    Present { value: names } => match local_store_read_index(root_path: root_path, family: b.family) {
      LocalStoreIndexUnavailable { cause: _ } => none
      LocalStoreIndexAt { index: i, expected: _ } => Present { value: concat(concat(names, i.rows |> map(r => r.name)), i.doomed |> map(d => d.name)) }
    }
  })
}

fn local_store_sweep(root: MaterializationStoreRoot) -> LocalStoreSweep {
  let root_path = materialization_store_root_path(root: root)
  let listing = Filesystem.List(path: root_path)
  match filesystem_listing_observation(directory: root_path, success: listing.success, entries: listing.entries, error: listing.error) {
    FilesystemDirectorySubjectRefused { directory: _, cause: c } => LocalStoreSweepUnavailable { cause: c }
    FilesystemDirectoryListingRefused { directory: _, error: e } => LocalStoreSweepUnavailable { cause: e }
    FilesystemDirectoryListed(listed) =>
      match local_store_indexed_names(root: root) {
        Absent => LocalStoreSweepUnavailable { cause: "a family's occupancy index could not be read, so no object is swept" }
        Present { value: indexed } => {
          let indexed_set = local_store_name_set(names: indexed)
          let orphans = filesystem_listing_entry_names(listing: listed)
            |> filter(n => local_store_is_store_file_name(name: n) && !set_contains(indexed_set, local_store_record_of(name: n)))
          let attempts = local_store_delete_attempts(root_path: root_path, names: orphans)
          LocalStoreSwept { removed: attempts |> filter(t => t.confirmed) |> map(t => t.name), delete_refused: attempts |> filter(t => !t.confirmed) |> map(t => t.name) }
        }
      }
  }
}

// ---------------------------------------------------------------------------------------------
// RECENCY IS ADVISORY. A lookup never writes. A process records the names it served ONCE, at the end
// of its run, as one CAS per family index; losing that CAS, or failing to read the index, only makes
// the next eviction less precise, so this function cannot fail a lookup or a commit and has no
// refusal arm -- its outcome is reported and nothing branches on it for correctness.

type LocalStoreRecency
  = LocalStoreRecencyRecorded { family: ArtifactKindId, bumped: Int }
  | LocalStoreRecencyNothingToRecord { family: ArtifactKindId }
  | LocalStoreRecencyLost { family: ArtifactKindId, cause: String }

fn local_store_record_recency(root: MaterializationStoreRoot, family: ArtifactKindId, served: List<String>) -> LocalStoreRecency {
  let root_path = materialization_store_root_path(root: root)
  match local_store_read_index(root_path: root_path, family: family) {
    LocalStoreIndexUnavailable { cause: c } => LocalStoreRecencyLost { family: family, cause: c }
    LocalStoreIndexAt { index: index, expected: expected } => {
      let names = index.rows |> map(r => r.name)
      let held = local_store_name_set(names: names)
      let hits = served |> filter(n => set_contains(held, n))
      if count(hits) == 0 { LocalStoreRecencyNothingToRecord { family: family } } else {
        let bumped = fold(hits, init: local_store_artifact_store(budget: byte_size(count: 0), index: index), f: (st, n) => match store_get(store: st, key: local_store_row_key(name: n)) {
          StoreHit { store: s2, row: _ } => s2
          StoreMiss { store: s2 } => s2
        })
        match local_store_write_index(root_path: root_path, family: family, expected: expected, index: local_store_index_of(store: bumped, names: names, doomed: index.doomed)) {
          LocalStoreIndexWritten { reclamation: _ } => LocalStoreRecencyRecorded { family: family, bumped: count(hits) }
          LocalStoreIndexLostRace => LocalStoreRecencyLost { family: family, cause: "another writer moved the index first" }
          LocalStoreIndexWriteRefused { cause: c } => LocalStoreRecencyLost { family: family, cause: c }
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------------------------
// Lookup and commit over an opened store.

fn local_store_record_lookup(root: MaterializationStoreRoot, store: OpenedMaterializationStore, req: ArtifactRequest) -> StoreLookup {
  let root_path = materialization_store_root_path(root: root)
  match materialization_store_admissible(root: root, verb: Read) {
    Deny { refusal: _ } =>
      StoreLookupRefused {
        key: request_key(req: req),
        refusal: StoreLookupObjectUnavailable { fault: StoreFault { class: StoreFaultUnauthorized, detail: concat("read grant refused for ", root_path) } }
      }
    Permit => {
      let read = match evaluation_store_address(req: req) {
        FamilyRefused { family: f, scope: sc } =>
          StoreLookupRefused {
            key: request_key(req: req),
            refusal: StoreLookupStoreFamilyRefused { family: f, scope: sc }
          }
        Admitted { address: addr } =>
          store_lookup_from_address(
            store: store,
            req: req,
            address: addr,
            read: store_read_observation(read: local_store_read(path: store_path(root_path: root_path, name: store_object_name(address: addr))))
          )
      }
      read
    }
  }
}

// A HIT IS SERVED ONLY WITH ITS BYTE PARTS VERIFIED. Each part the record names is read afresh from
// the store root through std.fabric_blob read_staged_fabric_blob -- the one sealed SHA-256 + size
// reading -- and must agree with the record's (sha256, size). A part that is missing, unreadable or
// different REFUSES the lookup as malformed: it is never a miss, so nothing recomputes past a store
// that holds a record whose bytes have gone. The verified readings travel with the hit, and their
// paths are what a consumer executes: only bytes this read verified.
type LocalStorePartsLookup {
  lookup: StoreLookup
  parts: List<FabricBlobReading>
}

type LocalStorePartCheck
  = LocalStorePartVerified { reading: FabricBlobReading }
  | LocalStorePartRefused { cause: String }

fn local_store_check_part(root_path: String, record: String, part: ArtifactBlobPart) -> LocalStorePartCheck {
  let path = store_path(root_path: root_path, name: local_store_part_name(record: record, id: part.id))
  match read_staged_fabric_blob(path: path as NonEmptyStr) {
    FabricBlobReadRefused { fault: f } => LocalStorePartRefused { cause: concat(concat("byte part ", part.id as String), concat(" could not be read: ", fabric_blob_fault_text(fault: f))) }
    FabricBlobRead { reading: r } =>
      if (fabric_blob_reading_digest(reading: r).hex as String) == (part.digest.hex as String)
        && measure_count(m: fabric_blob_reading_size(reading: r)) == measure_count(m: part.size) {
        LocalStorePartVerified { reading: r }
      } else {
        LocalStorePartRefused { cause: concat(concat("byte part ", part.id as String), " does not hold the bytes its record names") }
      }
  }
}

fn local_store_lookup_parts(root: MaterializationStoreRoot, store: OpenedMaterializationStore, req: ArtifactRequest) -> LocalStorePartsLookup {
  let root_path = materialization_store_root_path(root: root)
  let lookup = local_store_record_lookup(root: root, store: store, req: req)
  let blobs = store_lookup_blob_parts(l: lookup)
  if count(blobs) == 0 { LocalStorePartsLookup { lookup: lookup, parts: [] } } else {
    match evaluation_store_address(req: req) {
      FamilyRefused { family: _, scope: _ } => LocalStorePartsLookup { lookup: lookup, parts: [] }
      Admitted { address: addr } => {
        let record = store_object_name(address: addr)
        let checks = blobs |> map(b => local_store_check_part(root_path: root_path, record: record, part: b))
        let refusal = checks |> fold(init: none, f: (acc, c) => match acc {
          Present { value: _ } => acc
          Absent => match c { LocalStorePartRefused { cause: why } => Present { value: why } LocalStorePartVerified { reading: _ } => none }
        })
        match refusal {
          Present { value: why } =>
            LocalStorePartsLookup { lookup: StoreLookupRefused { key: request_key(req: req), refusal: StoreLookupObjectMalformed { cause: why } }, parts: [] }
          Absent =>
            LocalStorePartsLookup {
              lookup: lookup,
              parts: checks |> flat_map(c => match c { LocalStorePartVerified { reading: r } => [r] LocalStorePartRefused { cause: _ } => [] })
            }
        }
      }
    }
  }
}

// The record lookup with its byte parts verified: a record whose parts do not hold their bytes is
// refused here too, so every caller -- including a commit's read-back -- judges the whole artifact.
fn local_store_lookup(root: MaterializationStoreRoot, store: OpenedMaterializationStore, req: ArtifactRequest) -> StoreLookup {
  local_store_lookup_parts(root: root, store: store, req: req).lookup
}

// THE COMMIT RECEIPT carries what the bound did beside the store-level commit: the names this commit
// evicted, the evicted names whose delete the host did not confirm (they stay doomed and CHARGED until
// a later reservation confirms them gone), the doomed names this commit's reservation retired, and the
// index slot's own generation reclamation.
type LocalStoreCommit {
  commit: StoreCommit
  evicted: List<String>
  eviction_delete_refused: List<String>
  retired: List<String>
  index_reclamation: CasWindowReclamation
}

fn local_store_commit_refused(commit: StoreCommit) -> LocalStoreCommit {
  LocalStoreCommit { commit: commit, evicted: [], eviction_delete_refused: [], retired: [], index_reclamation: CasReclamationNotCommitted }
}

// THE SECOND HALF OF A COMMIT, after its reservation: delete what the reservation evicted, and ONLY
// IF THE HOST CONFIRMED EVERY ONE OF THOSE DELETES publish -- otherwise refuse as cleanup outstanding,
// leaving the evicted names doomed and charged, so on-disk bytes never exceed the budget because a
// delete did not happen. Then re-read the index before settling. It is its own function so a control can interleave a second
// writer between a reservation and its publish, which is exactly the window the re-read closes.
fn local_store_publish_reserved(
  root: MaterializationStoreRoot,
  store: OpenedMaterializationStore,
  req: ArtifactRequest,
  prepared: StoreCommitPreparation,
  reservation: LocalStoreReservation,
  parts: List<LocalStoreStagedPart>,
  blobs: List<ArtifactBlobPart>
) -> LocalStoreCommit {
  let root_path = materialization_store_root_path(root: root)
  match prepared {
    StoreCommitNotPrepared { commit: c } => local_store_commit_refused(commit: c)
    StoreCommitPrepared { key: k, object_name: name, object: object, offered_digest: offered, offered_result: offered_result } =>
      match reservation {
        LocalStoreReservationRefused { refusal: r } => local_store_commit_refused(commit: StoreCommitRefused { key: k, refusal: r })
        LocalStoreReserved { evicted: evicted, retired: retired, reclamation: rc } => {
          let bytes = byte_size(count: measure_count(m: local_store_object_bytes(object: object)) + local_store_parts_bytes(parts: blobs))
          let deletes = local_store_delete_records_confirmed(root_path: root_path, records: evicted |> map(e => e.name))
          let unconfirmed = deletes |> filter(t => !t.confirmed) |> map(t => t.name)
          let unconfirmed_set = local_store_name_set(names: unconfirmed)
          if count(unconfirmed) > 0 {
            let undeleted = fold(evicted |> filter(e => set_contains(unconfirmed_set, e.name)), init: 0, f: (acc, e) => acc + measure_count(m: e.bytes))
            let budget = match local_store_family_budget(root: root, family: request_kind(req: req)) { Present { value: b } => b.budget Absent => byte_size(count: 0) }
            LocalStoreCommit {
              commit: StoreCommitRefused { key: k, refusal: StoreCommitCleanupOutstanding { artifact_bytes: bytes, budget: budget, undeleted: byte_size(count: undeleted) } },
              evicted: evicted |> map(e => e.name),
              eviction_delete_refused: unconfirmed,
              retired: retired,
              index_reclamation: rc
            }
          } else {
            let link_refusal = parts |> fold(init: none, f: (acc, p) => match acc {
              Present { value: _ } => acc
              Absent => local_store_link_part(root_path: root_path, record: name, part: p)
            })
            let parts_hold = match link_refusal {
              Present { value: _ } => false
              Absent => {
                let linked = parts |> map(p => local_store_read_part(id: p.id, path: store_path(root_path: root_path, name: local_store_part_name(record: name, id: p.id)) as NonEmptyStr))
                !local_store_any_unreadable(readings: linked) && local_store_blob_parts_agree(a: blobs, b: local_store_read_parts(readings: linked))
              }
            }
            let settled = match link_refusal {
              Present { value: why } => StoreCommitRefused { key: k, refusal: StoreCommitPublishRefused { fault: StoreFault { class: StoreFaultUnreachable, detail: why } } }
              Absent =>
                if !parts_hold {
                  StoreCommitRefused { key: k, refusal: StoreCommitResultIdentityUnverifiable { cause: "a linked byte part does not hold the bytes that were staged" } }
                } else {
                  store_commit_settle(
                    store: store,
                    prepared_key: k,
                    offered_digest: offered,
                    offered_result: offered_result,
                    publish: store_publish_observation(create: local_store_create_new(path: store_path(root_path: root_path, name: name), content: object)),
                    read_back: local_store_lookup(root: root, store: store, req: req)
                  )
                }
            }
            let post = local_store_post_publish(root_path: root_path, family: request_kind(req: req), name: name, bytes: bytes)
            let verdict = match post {
              LocalStoreStillLive => settled
              LocalStoreEvictedAndRemoved => StoreCommitRefused { key: k, refusal: StoreCommitEvictedDuringPublish { name: name, removed: true } }
              LocalStoreEvictedAndDoomed => StoreCommitRefused { key: k, refusal: StoreCommitEvictedDuringPublish { name: name, removed: false } }
              LocalStorePostPublishUnavailable { cause: c } =>
                StoreCommitRefused { key: k, refusal: StoreCommitOccupancyUnavailable { cause: concat("after publishing, the occupancy index could not be re-read: ", c) } }
            }
            LocalStoreCommit { commit: verdict, evicted: evicted |> map(e => e.name), eviction_delete_refused: [], retired: retired, index_reclamation: rc }
          }
        }
      }
  }
}

fn local_store_reserve_prepared(root: MaterializationStoreRoot, req: ArtifactRequest, prepared: StoreCommitPreparation, part_bytes: Int) -> LocalStoreReservation {
  let root_path = materialization_store_root_path(root: root)
  match prepared {
    StoreCommitNotPrepared { commit: _ } => LocalStoreReserved { evicted: [], retired: [], reclamation: CasReclamationNotCommitted }
    StoreCommitPrepared { key: _, object_name: name, object: object, offered_digest: _, offered_result: _ } =>
      match materialization_store_admissible(root: root, verb: Write) {
        Deny { refusal: _ } =>
          LocalStoreReservationRefused { refusal: StoreCommitPublishRefused { fault: StoreFault { class: StoreFaultUnauthorized, detail: concat("write grant refused for ", root_path) } } }
        Permit => local_store_reserve(root: root, family: request_kind(req: req), name: name, bytes: byte_size(count: measure_count(m: local_store_object_bytes(object: object)) + part_bytes), attempt: 1)
      }
  }
}

// A BYTE PART TO COMMIT: an output id and a file the producer staged ON THE STORE ROOT'S FILESYSTEM.
// It is linked into the root create-only (a link across filesystems is not a copy, so a staged file
// elsewhere refuses), and the reading the record carries is minted from the LINKED path.
type LocalStoreStagedPart {
  id: ArtifactOutputId
  staged: NonEmptyStr
}

type LocalStoreStagedReading
  = LocalStoreStagedRead { part: ArtifactBlobPart }
  | LocalStoreStagedUnreadable { cause: String }

fn local_store_blob_part_of(id: ArtifactOutputId, r: FabricBlobReading) -> ArtifactBlobPart {
  ArtifactBlobPart { id: id, digest: fabric_blob_reading_digest(reading: r), size: fabric_blob_reading_size(reading: r) }
}

fn local_store_read_part(id: ArtifactOutputId, path: NonEmptyStr) -> LocalStoreStagedReading {
  match read_staged_fabric_blob(path: path) {
    FabricBlobRead { reading: r } => LocalStoreStagedRead { part: local_store_blob_part_of(id: id, r: r) }
    FabricBlobReadRefused { fault: f } => LocalStoreStagedUnreadable { cause: concat(concat("byte part ", id as String), concat(" could not be read: ", fabric_blob_fault_text(fault: f))) }
  }
}

fn local_store_first_unreadable(readings: List<LocalStoreStagedReading>) -> String? {
  readings |> fold(init: none, f: (acc, r) => match acc {
    Present { value: _ } => acc
    Absent => match r { LocalStoreStagedUnreadable { cause: c } => Present { value: c } LocalStoreStagedRead { part: _ } => none }
  })
}

fn local_store_any_unreadable(readings: List<LocalStoreStagedReading>) -> Bool {
  readings |> any(r => match r { LocalStoreStagedUnreadable { cause: _ } => true LocalStoreStagedRead { part: _ } => false })
}

fn local_store_read_parts(readings: List<LocalStoreStagedReading>) -> List<ArtifactBlobPart> {
  readings |> flat_map(r => match r { LocalStoreStagedRead { part: p } => [p] LocalStoreStagedUnreadable { cause: _ } => [] })
}

// One part linked into the root: linked now, or already there from an earlier identical commit
// (create-only answers occupied; the reading below decides whether it holds the same bytes).
fn local_store_link_part(root_path: String, record: String, part: LocalStoreStagedPart) -> String? {
  let target = store_path(root_path: root_path, name: local_store_part_name(record: record, id: part.id))
  let l = Filesystem.LinkCreateNew(source: part.staged as String, path: target)
  match filesystem_link_create_new(source: part.staged as String, path: target, success: l.success, error: l.error, error_kind: l.error_kind) {
    FilesystemLinked { path: _ } => none
    FilesystemLinkTargetOccupied { path: _ } => none
    FilesystemLinkCrossDevice { source: src, path: _ } => Present { value: concat(concat("byte part ", part.id as String), concat(" is staged on another filesystem than the store root: ", src)) }
    FilesystemLinkRefused { path: _, kind: _, error: e } => Present { value: concat(concat("byte part ", part.id as String), concat(" could not be linked: ", e)) }
    FilesystemLinkKindUnrecognized { path: _, observed: o, error: _ } => Present { value: concat(concat("byte part ", part.id as String), concat(" link failed with an unrecognized kind: ", o)) }
  }
}

fn local_store_blob_parts_agree(a: List<ArtifactBlobPart>, b: List<ArtifactBlobPart>) -> Bool {
  count(a) == count(b) && a |> all(x => b |> any(y => y.id == x.id && (y.digest.hex as String) == (x.digest.hex as String) && measure_count(m: y.size) == measure_count(m: x.size)))
}

fn local_store_parts_bytes(parts: List<ArtifactBlobPart>) -> Int {
  fold(parts, init: 0, f: (acc, p) => acc + measure_count(m: p.size))
}

// THE COMMIT ORDER, and why: (1) read every staged part (its SHA-256 and size shape the record and
// its budget); (2) prepare the record over those parts; (3) RESERVE record + parts in the family's
// index, evicting (record first, then its parts) -- so every file the next steps publish is already
// named by an index and the open-time sweep cannot take it; (4) link each part into the root
// create-only and re-read it from the LINKED path, which must agree with step (1); (5) publish the
// record create-only and read the whole artifact back, parts included. Any part refusal refuses the
// commit; a reserved row whose publish then fails occupies budget until evicted, bounded and named.
fn local_store_commit(
  root: MaterializationStoreRoot,
  store: OpenedMaterializationStore,
  req: ArtifactRequest,
  payloads: List<ArtifactPayload>,
  parts: List<LocalStoreStagedPart>
) -> LocalStoreCommit {
  let staged = parts |> map(p => local_store_read_part(id: p.id, path: p.staged))
  match local_store_first_unreadable(readings: staged) {
    Present { value: why } =>
      local_store_commit_refused(commit: StoreCommitRefused { key: request_key(req: req), refusal: StoreCommitResultIdentityUnverifiable { cause: why } })
    Absent => {
      let blobs = local_store_read_parts(readings: staged)
      let prepared = store_commit_prepare(req: req, payloads: payloads, blobs: blobs)
      local_store_publish_reserved(
        root: root,
        store: store,
        req: req,
        prepared: prepared,
        reservation: local_store_reserve_prepared(root: root, req: req, prepared: prepared, part_bytes: local_store_parts_bytes(parts: blobs)),
        parts: parts,
        blobs: blobs
      )
    }
  }
}

// BATCH: one open, then one exact read per request. The open is the only store-level observation;
// if it refuses, EVERY request in the batch is refused with the same cause -- none is answered as a
// miss, and none is answered from anywhere else.
type LocalStoreBatchLookup
  = LocalStoreBatchLooked { store: OpenedMaterializationStore, lookups: List<StoreLookup> }
  | LocalStoreBatchUnavailable { root_path: String, cause: LocalStoreUnavailableCause }

fn local_store_lookup_batch(root: MaterializationStoreRoot, reqs: List<ArtifactRequest>) -> LocalStoreBatchLookup {
  match local_store_open(root: root) {
    LocalStoreUnavailable { root_path: p, cause: c } => LocalStoreBatchUnavailable { root_path: p, cause: c }
    LocalStoreOpened { root: r, store: s, durability: _, sweep: _ } =>
      LocalStoreBatchLooked { store: s, lookups: reqs |> map(req => local_store_lookup(root: r, store: s, req: req)) }
  }
}

// ---------------------------------------------------------------------------------------------
// The cache-interface row this realization's receipts name.

data materialization_store_local_facts: CacheInterfaceCatalogFacts = {
  identity: materialization_store_local_id
  backing_surface: "gunbc-materialization-store-persistent-host-volume"
  transport_encoding: CatalogCasContentEncoding
  key_derivation: {
    key_inputs: ContentAddressed
    overwritable: false
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: Org
    invalidation_triggers: [ToolchainChange, ManualPurge]
  }
  io: {
    lookup_semantics: ContentAddressLookup
    write_semantics: WriteOnce
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: StructuredArtifact
    locality: PerHostFilesystem
    retention: { release_policy: ReleasedNever, capacity: CapacityBounded { limit: ByteCapacity { limit: ExactLimit { value: local_store_host_ceiling_bytes } }, at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed } } }
    atomicity: WriteThenCommit
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: Strong
  }
  evidence: [
    {
      field: "atomicity"
      evidence: OperatorObserved {
        note: "Filesystem.WriteCreateNew stages, fsyncs, and publishes with hard_link (extdeps.filesystem.rust_realization rust_file_write_create_new_fn_def): the object name appears complete or not at all, and a second writer receives AlreadyExists"
        observed_at: Absent
      }
    },
    {
      field: "retention"
      evidence: OperatorObserved {
        note: "the host-wide ceiling is local_store_host_ceiling_bytes, the declared sum of the durable root's per-family budgets (local_store_durable_family_budgets); each family's store is constructed by std.artifact_store store_over_provider from its own CapacityBounded/ExactLimit/LeastRecentlyUsed provider row, so one family never evicts another's entries and an artifact over its family's budget refuses before any eviction. Occupancy is the family's windowed CAS index slot; recency is advisory and recorded once per process, and losing that write only makes eviction less precise. An open sweeps objects no index names."
        observed_at: Absent
      }
    },
  ]
}
