  placement: {
    value_shape: StructuredArtifact
    locality: PerHostFilesystem
    retention: { release_policy: ReleasedNever, capacity: CapacityBounded { limit: ByteCapacity { limit: ExactLimit { value: local_store_host_ceiling_bytes } }, at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed } } }
    atomicity: WriteThenCommit
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: Strong
  }
  evidence: [
    {
      field: "atomicity"
      evidence: OperatorObserved {
        note: "Filesystem.WriteCreateNew stages, fsyncs, and publishes with hard_link (extdeps.filesystem.rust_realization rust_file_write_create_new_fn_def): the object name appears complete or not at all, and a second writer receives AlreadyExists"
        observed_at: Absent
      }
    },
    {
      field: "retention"
      evidence: OperatorObserved {
        note: "the host-wide ceiling is local_store_host_ceiling_bytes, the declared sum of the durable root's per-family budgets (local_store_durable_family_budgets); each family's store is constructed by std.artifact_store store_over_provider from its own CapacityBounded/ExactLimit/LeastRecentlyUsed provider row, so one family never evicts another's entries and an artifact over its family's budget refuses before any eviction. Occupancy is the family's windowed CAS index slot; recency is advisory and recorded once per process, and losing that write only makes eviction less precise. An open sweeps objects no index names."
