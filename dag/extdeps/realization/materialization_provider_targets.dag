module extdeps.realization.materialization_provider_targets

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

import std.types { Bool, Int, List, String }
import std.cache_identity { CacheInterfaceId }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.realization.reconcile_in_process { parse_cache_id, typed_module_cache_id }
import extdeps.realization.resolved_graph { resolved_graph_cache_id }
import extdeps.realization.compile_stage_memo { compile_stage_memo_id }
import extdeps.realization.parse_table_memo { parse_table_memo_id }
import extdeps.realization.eval_memo { eval_memo_id }
import extdeps.realization.native_artifact_cache { native_artifact_cache_id }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data materialization_provider_targets_note: String = "The consumer-target frontier of std.materialization_provider (parent mandate 6B, model-only): each row names an EXISTING cited cache row (by its CacheInterfaceId — grounding, never a second description of the cache) that today serves lookups through an ad-hoc carrier and later consumes the contract's provider_serve / provider_admit instead. The rows are a DeclaredFrontier (registered in gunbc.roster_registry): countable, prioritizable, each with its own reason and dissolve_on; a consumer flip retires its row, and the roster deletes when empty. This module declares TARGETS only — no consumer flips, no Rust, per the mandate."

type ProviderContractTarget {
  cache: CacheInterfaceId
  reason: String
  dissolve_on: String
}

data materialization_provider_targets: List<ProviderContractTarget> = [
  ProviderContractTarget {
    cache: parse_cache_id,
    reason: "cli_run MultiEntryIndex.parse_cache keys on file path, not content — the standing cache-impurity witness (reconcile_in_process Phase 2c); parse_module_request keys on source content + compiler identity",
    dissolve_on: "parse lookups route through provider_serve with parse_module_request and the path-keyed map retires"
  },
  ProviderContractTarget {
    cache: typed_module_cache_id,
    reason: "cli_run typed-module memo already keys on the typed_module_key facts this contract's typecheck_module_request models; the carrier is still an exposed in-process map",
    dissolve_on: "typecheck lookups route through provider_serve with typecheck_module_request and the map carrier retires"
  },
  ProviderContractTarget {
    cache: resolved_graph_cache_id,
    reason: "the FIRST NAMED CONSUMER TARGET: the disk-hit refuse arm (artifacts carry graph+source_indices without the compile-clean diagnostic union) is this contract's ProviderRefusedIncomplete, hand-rolled",
    dissolve_on: "resolved_graph_cache FORMAT_VERSION persists the diagnostic union, resolve_closure_request's required_outputs are satisfiable, and the hand refuse arm deletes (resolved_graph_cache_compile_clean_diagnostic_union_dissolve_trigger)"
  },
  ProviderContractTarget {
    cache: compile_stage_memo_id,
    reason: "v2 compile_ingest_staging cached_stage is content-addressed done right but answers through its own lookup shape rather than the contract's typed outcomes",
    dissolve_on: "cached_stage lookups project through provider_serve outcomes (the DESIGN section 2 ParseTable/cached_stage grounding lane)"
  },
  ProviderContractTarget {
    cache: parse_table_memo_id,
    reason: "the v2 ParseTable memo is the standing DESIGN section 2 hand-rolled-cache debt; its lookup answers are untyped hits/misses on an in-process map",
    dissolve_on: "ParseTable grounds on the Realization carrier and its lookups adopt the contract's typed outcomes"
  },
  ProviderContractTarget {
    cache: eval_memo_id,
    reason: "the interpreter eval-frame memo (extdeps.realization.eval_memo) serves verified hits with its own ad-hoc verify-on-serve arm — the contract's wrong-content refusal, hand-rolled",
    dissolve_on: "eval-memo serves through provider_serve so the verify-on-serve arm is the shared ProviderRefusedWrongContent, not a private one"
  },
  ProviderContractTarget {
    cache: native_artifact_cache_id,
    reason: "the emit-on-demand warm tier trusts its .native_ready marker without content re-verification on read (declared false in its cited row) — a wrong-content refusal the contract makes expressible",
    dissolve_on: "warm serves route through provider_serve with a read-back digest, upgrading content_verified_on_read to true on the cited row"
  },
]

fn materialization_provider_target_count() -> Int {
  materialization_provider_targets |> count()
}

fn materialization_provider_targets_contain(id: CacheInterfaceId) -> Bool {
  materialization_provider_targets |> fold(init: false, f: (acc, t) => acc || (t.cache == id))
}

data materialization_provider_first_consumer_binding: DeclarationRef = DeclarationRef {
  module_path: "extdeps.realization.resolved_graph",
  decl_name: "resolved_graph_cache_compile_clean_diagnostic_union_dissolve_trigger",
  field: WholeDeclaration
}

data materialization_provider_first_consumer_note: String = "The binding above points at the live refuse arm's own dissolve trigger rather than restating it (section 3: one authority). When that trigger fires, the resolved_graph_cache row here is the first to retire, and the contract's completeness witnesses (dag/test/claim/materialization_provider_witness_test.dag, the v1-shape incomplete-artifact refusal) are the modeled form of the receipt."
