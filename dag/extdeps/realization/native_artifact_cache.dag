module extdeps.realization.native_artifact_cache



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data native_artifact_cache_note: String = "The durable native-artifact cache (witness-realization P3 warm tier made DECLARED): emit-on-demand cargo workspaces keyed workspace = root/<emit_on_demand_key hash>, warm-skipped by the .native_ready marker (v1_interpreter emit_host_run_transport_cached — compile_skipped receipts). First PerRunnerFilesystem realization row in the tree: self-hosted runners wipe only RUNNER_TEMP, so the root persists across runs; the scope frame is UnboundedSiblingsFrame (recurring CI invocations over time, gunbc.ci_materialization github-actions-ci-runs). Root authority: std.emit_on_demand emit_on_demand_native_cache_root (/tmp/gunbc_ scratch prefix), rebased onto GUNBC_NATIVE_CACHE_ROOT when set (the re-root changes WHERE, never WHAT — the content hash stays the identity, toolchain included, so cross-branch sharing on one runner is benign-by-identity). Cold control: GUNBC_CI_NATIVE_CACHE_COLD_CONTROL on the falsifier cadence forces full cold rebuilds, widen-only. HONEST SCOPE (named gap, not a silent widen): eviction is Manual today — the only evictor is emit_on_demand_evict_native_cache (witness-local) and ManualPurge; nothing enforces a byte cap on the persistent tier. Dissolve-on: the P2 store budget realization (store_over_provider SpacePacked) reaches this tier, then eviction upgrades to SizeBounded and this note's gap clause deletes."

data native_artifact_cache_id: CacheInterfaceId = "native_artifact_cache"

data native_artifact_cache_facts: CacheInterfaceCatalogFacts = {
  identity: native_artifact_cache_id
  backing_surface: "gunbc-native-artifact-per-runner-cache"
  transport_encoding: CatalogCasContentEncoding
  key_derivation: {

    key_inputs: ContentAddressed
    overwritable: false
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Repo
    invalidation_triggers: [ToolchainChange, ManualPurge]
  }
  io: {
    lookup_semantics: ContentAddressLookup
    write_semantics: WriteOnce
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: FileTree
    locality: PerRunnerFilesystem
    eviction: Manual
    atomicity: WriteThenCommit
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: ReadYourWrites
  }
  evidence: [
    {
      field: "atomicity"
      evidence: OperatorObserved {
        note: ".native_ready marker written ONLY after a successful cold build+run (v1_interpreter emit_host_run_transport_cached_in_workspace) — the marker IS the commit record; a half-written workspace is never warm-served"
        observed_at: 0
      }
    },
    {
      field: "key_inputs"
      evidence: OperatorObserved {
        note: "workspace path component = emit_on_demand_key hash over ArtifactKey { closure_digest, emitter_identity, target_language, toolchain } (std.emit_on_demand cache-key-authority note); content change -> new key -> cold rebuild, witnessed by emit_on_demand_*_native_content_change_cold_rebuild_holds"
        observed_at: 0
      }
    },
    {
      field: "content_verified_on_read"
      evidence: OperatorObserved {
        note: "warm path trusts the marker without re-hashing the workspace (no digest re-verification on read) — declared false; the falsifier cold control is the standing falsifier for a poisoned warm entry"
        observed_at: 0
      }
    },
  ]
}
