data eviction_step_reader_contract: Disposition = Terminal {
  reason: "eviction_step_fold is the only match over ArtifactEvictionStep; the predicates and counters below derive from it and contain no match of their own, so a fourth outcome is a type error at exactly one site. Same discipline this module's consumer applies to ProviderLookup / ProviderAdmission (std.materialization_provider reader contract) — a new coproduct does not get an exemption for being small (review 44258). Discriminating corpus: dag/test/claim/artifact_store_fs_witness_test.dag."
}

fn eviction_step_fold<T>(
  step: ArtifactEvictionStep,
  deleted: fn(ContentHash) -> T,
  refused: fn(ContentHash, Verb, NamespacePosition, Frame) -> T,
  failed: fn(ContentHash, String) -> T
) -> T {
  match step {
    EvictionDeleted { key: k } => deleted(k)
    EvictionRefused { key: k, verb: v, target: t, frame: f } => refused(k, v, t, f)
    EvictionFailed { key: k, path: p } => failed(k, p)
  }
}

fn eviction_step_is_deleted(s: ArtifactEvictionStep) -> Bool {
  eviction_step_fold(
    step: s,
    deleted: k => true,
    refused: (k, v, t, f) => false,
    failed: (k, p) => false
  )
}

fn eviction_step_is_refused(s: ArtifactEvictionStep) -> Bool {
  eviction_step_fold(
    step: s,
    deleted: k => false,
    refused: (k, v, t, f) => true,
    failed: (k, p) => false
  )
}

fn eviction_deleted_count(steps: List<ArtifactEvictionStep>) -> Int {
  steps |> filter(s => eviction_step_is_deleted(s: s)) |> count()
}

fn eviction_refusal_count(steps: List<ArtifactEvictionStep>) -> Int {
  steps |> filter(s => eviction_step_is_refused(s: s)) |> count()
}

fn eviction_all_applied(steps: List<ArtifactEvictionStep>) -> Bool {
  steps |> fold(init: true, f: (acc, s) => acc && eviction_step_is_deleted(s: s))
}
