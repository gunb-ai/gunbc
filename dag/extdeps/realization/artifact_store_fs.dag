type ArtifactEvictionStep
  = EvictionDeleted { key: ContentHash }
  | EvictionRefused { key: ContentHash, verb: Verb, target: NamespacePosition, frame: Frame }
  | EvictionFailed { key: ContentHash, path: String }

func evict_one(store_root: String, key: ContentHash) -> ArtifactEvictionStep {
  match artifact_fs_delete(store_root: store_root, key: key) {
    ArtifactFsDeleteOk => EvictionDeleted { key: key }
    ArtifactFsDeleteRefused { verb: v, target: t, frame: f } =>
      EvictionRefused { key: key, verb: v, target: t, frame: f }
    ArtifactFsDeleteFailed { path: p } => EvictionFailed { key: key, path: p }
  }
}

