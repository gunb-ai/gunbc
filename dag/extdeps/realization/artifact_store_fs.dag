fn artifact_fs_path(store_root: String, key: ContentHash) -> String {
  concat(store_root, "/", key, ".artifact")
}

type ArtifactFsLookup
  = ArtifactFsHit { payload: String }
  | ArtifactFsMiss { path: String }
  | ArtifactFsRefused { verb: Verb, target: NamespacePosition, frame: Frame }

type ArtifactFsPutResult
  = ArtifactFsPutOk
  | ArtifactFsPutRefused { verb: Verb, target: NamespacePosition, frame: Frame }
  | ArtifactFsPutFailed { path: String }

type ArtifactFsDeleteResult
  = ArtifactFsDeleteOk
  | ArtifactFsDeleteRefused { verb: Verb, target: NamespacePosition, frame: Frame }
  | ArtifactFsDeleteFailed { path: String }

type ArtifactFsListResult
  = ArtifactFsListOk { entries: List<String> }
  | ArtifactFsListRefused { verb: Verb, target: NamespacePosition, frame: Frame }
  | ArtifactFsListFailed { path: String }

func artifact_fs_put(store_root: String, key: ContentHash, payload: String) -> ArtifactFsPutResult {
  match artifact_store_scratch_write_admissible(store_root: store_root) {
    EffectOutsideGrant { verb: v, target: t, frame: f } =>
      ArtifactFsPutRefused { verb: v, target: t, frame: f }
    Admitted { via_root: r } => {
      let path = artifact_fs_path(store_root: store_root, key: key)
      let w = Filesystem.Write(path: path, content: payload)
      if w.success {
        return ArtifactFsPutOk
      }
      return ArtifactFsPutFailed { path: path }
    }
  }
}

func artifact_fs_get(store_root: String, key: ContentHash) -> ArtifactFsLookup {
  match artifact_store_scratch_read_admissible(store_root: store_root) {
    EffectOutsideGrant { verb: v, target: t, frame: f } =>
      ArtifactFsRefused { verb: v, target: t, frame: f }
    Admitted { via_root: _ } => {
      let path = artifact_fs_path(store_root: store_root, key: key)
      let read_out = Filesystem.Read(path: path)
      if read_out.success {
        return ArtifactFsHit { payload: read_out.content }
      }
      return ArtifactFsMiss { path: path }
    }
  }
}

func artifact_fs_delete(store_root: String, key: ContentHash) -> ArtifactFsDeleteResult {
  match artifact_store_scratch_write_admissible(store_root: store_root) {
    EffectOutsideGrant { verb: v, target: t, frame: f } =>
      ArtifactFsDeleteRefused { verb: v, target: t, frame: f }
    Admitted { via_root: r } => {
      let path = artifact_fs_path(store_root: store_root, key: key)
      let d = Filesystem.Delete(path: path)
      if d.success {
        return ArtifactFsDeleteOk
      }
      return ArtifactFsDeleteFailed { path: path }
    }
  }
}

func artifact_fs_list(store_root: String) -> ArtifactFsListResult {
  match artifact_store_scratch_read_admissible(store_root: store_root) {
    EffectOutsideGrant { verb: v, target: t, frame: f } =>
      ArtifactFsListRefused { verb: v, target: t, frame: f }
    Admitted { via_root: r } => {
      let l = Filesystem.List(path: store_root)
      if l.success {
        if l.entries == "" {
          return ArtifactFsListOk { entries: [] }
        }
        return ArtifactFsListOk { entries: split(l.entries, separator: "\n") }
      }
      return ArtifactFsListFailed { path: store_root }
    }
  }
}

