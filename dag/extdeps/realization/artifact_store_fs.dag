module extdeps.realization.artifact_store_fs

import extdeps.filesystem.filesystem_io
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { ContentHash, String, Bool }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data artifact_store_fs_transport_note: String = "P2 host-transport half (witness-realization plan): the filesystem realization of std.artifact_store's persistent tier. The keyed path ENCODES identity - store_root/<content-hash>.artifact - so presence-at-path is a ContentKeyed hit for exactly that identity, which is NOT the #6352 existence-keying (that red keyed on OUTPUT presence while the INPUTS went unhashed; here the path IS the input hash). Layering: this module is one transport handler bound to the pure spec (std.artifact_store, the single authority); a second handler (e.g. remote CAS) binds the same shape. SCOPE (honest): put/get only - the Filesystem service exposes Write/Read but no Delete/List, so SpacePacked budget enforcement on the persistent tier is unrealizable until those operations are added to the cited service surface; until then the disk tier grows unbounded and the in-process std.artifact_store fold is the only packed tier. That gap is the named next rung, not a silent widen."

fn artifact_fs_path(store_root: String, key: ContentHash) -> String {
  concat(store_root, "/", key, ".artifact")
}

type ArtifactFsLookup
  = ArtifactFsHit { payload: String }
  | ArtifactFsMiss { path: String }

func artifact_fs_put(store_root: String, key: ContentHash, payload: String) -> Bool {
  let w = Filesystem.Write(path: artifact_fs_path(store_root: store_root, key: key), content: payload)
  return w.success
}

func artifact_fs_get(store_root: String, key: ContentHash) -> ArtifactFsLookup {
  let path = artifact_fs_path(store_root: store_root, key: key)
  let r = Filesystem.Read(path: path)
  if r.success {
    return ArtifactFsHit { payload: r.content }
  }
  return ArtifactFsMiss { path: path }
}

func artifact_fs_delete(store_root: String, key: ContentHash) -> Bool {
  let d = Filesystem.Delete(path: artifact_fs_path(store_root: store_root, key: key))
  return d.success
}

func artifact_fs_list(store_root: String) -> List<String> {
  let l = Filesystem.List(path: store_root)
  if l.success {
    if l.entries == "" {
      return []
    }
    return split(l.entries, separator: "\n")
  }
  return []
}
