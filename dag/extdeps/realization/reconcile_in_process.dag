module extdeps.realization.reconcile_in_process

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import v2.std.optional { Absent }

import extdeps.cache.types {
  CacheInterfaceCatalogFacts,
  HandAuthored,
  NativeInternal,
  FilePaths,
  UpsertSubject,
  ToolchainSpec,
  CatalogOpaqueStringEncoding,
}
import std.cache_identity { CacheInterfaceId }
import std.decl_ref { WholeDeclaration }
import std.cache_interface {
  ExactKeyOnly,
  OverwriteAllowed,
  MissThenCreate,
  StructuredArtifact,
  InProcess,
  PerFile,
  None,
  InProcessNs,
  Strong,
  OperatorObserved,
  ManualPurge,
  DependencyChange,
  ToolchainChange,
  Repo,
  CapacityBounded,
  CapacityUnbounded,
  EntryCountCapacity,
  ProviderNativeReplacement,
  ReleasedAtProviderScopeExit,
  ReplaceExisting,
  RuntimeDerivedLimit,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data parse_cache_id: CacheInterfaceId = "parse_cache"
data typed_module_cache_id: CacheInterfaceId = "typed_module_cache"

data parse_cache_facts: CacheInterfaceCatalogFacts = {
  identity: parse_cache_id
  backing_surface: "gunbc-cli-run-parse-in-process"
  transport_encoding: CatalogOpaqueStringEncoding
  key_derivation: {

    key_inputs: HandAuthored { cited_inputs: [FilePaths] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Repo
    invalidation_triggers: [ManualPurge]
  }
  io: {
    lookup_semantics: ExactKeyOnly
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: StructuredArtifact
    locality: InProcess
    retention: { release_policy: ReleasedAtProviderScopeExit, capacity: CapacityUnbounded }
    atomicity: PerFile
    auth: None
    read_latency: InProcessNs
    consistency: Strong
  }
  evidence: [
    {
      field: "key_derivation"
      evidence: OperatorObserved {
        note: "cli_run.rs MultiEntryIndex.parse_cache keys on source.path (file path string), not content digest — cache-impurity witness; converge in Phase 2c"
        observed_at: Absent
      }
    },
    {
      field: "locality"
      evidence: OperatorObserved {
        note: "scoped to MultiEntryIndex; shared across entry resolves in one batch; drops when index is dropped"
        observed_at: Absent
      }
    },
  ]
}

data typed_module_cache_facts: CacheInterfaceCatalogFacts = {
  identity: typed_module_cache_id
  backing_surface: "gunbc-cli-run-typed-module-in-process"
  transport_encoding: CatalogOpaqueStringEncoding
  key_derivation: {

    key_inputs: NativeInternal { cited_inputs: [UpsertSubject, ToolchainSpec] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Repo
    invalidation_triggers: [DependencyChange, ToolchainChange]
  }
  io: {
    lookup_semantics: ExactKeyOnly
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: StructuredArtifact
    locality: InProcess
    retention: { release_policy: ReleasedAtProviderScopeExit, capacity: CapacityBounded { limit: EntryCountCapacity { limit: RuntimeDerivedLimit { authority: { module_path: "gunbc.typed_module_cache_capacity", decl_name: "typed_module_cache_entry_cap", field: WholeDeclaration } } }, at_capacity: ReplaceExisting { strategy: ProviderNativeReplacement } } }
    atomicity: PerFile
    auth: None
    read_latency: InProcessNs
    consistency: Strong
  }
  evidence: [
    {
      field: "key_derivation"
      evidence: OperatorObserved {
        note: "cli_run.rs reconcile_with_typed_cache keys on std.interface_summary.typed_module_key — module source hash + direct-import interface hashes (UpsertSubject) + compiler-binary identity via resolved_graph_cache::transform_content_digest (ToolchainSpec); the former authored-name key (the Phase-2c cache-impurity witness) is dissolved (cross-entry-typed-module-memo-sketch.md stage PR-alpha)"
        observed_at: Absent
      }
    },
    {
      field: "locality"
      evidence: OperatorObserved {
        note: "scoped to MultiEntryIndex.typed_module_cache; warms across batch entry resolves; drops when index is dropped"
        observed_at: Absent
      }
    },
  ]
}
