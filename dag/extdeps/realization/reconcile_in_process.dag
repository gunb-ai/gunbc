module extdeps.realization.reconcile_in_process



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data parse_cache_id: std.cache_identity.CacheInterfaceId = "parse_cache"
data typed_module_cache_id: std.cache_identity.CacheInterfaceId = "typed_module_cache"

data parse_cache_facts: extdeps.cache.types.CacheInterfaceCatalogFacts = {
  identity: parse_cache_id
  backing_surface: "gunbc-cli-run-parse-in-process"
  transport_encoding: extdeps.cache.types.CatalogOpaqueStringEncoding
  key_derivation: {

    key_inputs: extdeps.cache.types.HandAuthored { cited_inputs: [extdeps.cache.types.FilePaths] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: std.cache_interface.Repo
    invalidation_triggers: [std.cache_interface.ManualPurge]
  }
  io: {
    lookup_semantics: std.cache_interface.ExactKeyOnly
    write_semantics: std.cache_interface.OverwriteAllowed
    miss_semantics: std.cache_interface.MissThenCreate
  }
  placement: {
    value_shape: std.cache_interface.StructuredArtifact
    locality: std.cache_interface.InProcess
    retention: { release_policy: std.cache_interface.ReleasedAtProviderScopeExit, capacity: std.cache_interface.CapacityUnbounded }
    atomicity: std.cache_interface.PerFile
    auth: std.cache_interface.None
    read_latency: std.cache_interface.InProcessNs
    consistency: std.cache_interface.Strong
  }
  evidence: [
    {
      field: "key_derivation"
      evidence: std.cache_interface.OperatorObserved {
        note: "cli_run.rs MultiEntryIndex.parse_cache keys on source.path (file path string), not content digest — cache-impurity witness; converge in Phase 2c"
        observed_at: v2.std.optional.Absent
      }
    },
    {
      field: "locality"
      evidence: std.cache_interface.OperatorObserved {
        note: "scoped to MultiEntryIndex; shared across entry resolves in one batch; drops when index is dropped"
        observed_at: v2.std.optional.Absent
      }
    },
  ]
}

data typed_module_cache_facts: extdeps.cache.types.CacheInterfaceCatalogFacts = {
  identity: typed_module_cache_id
  backing_surface: "gunbc-cli-run-typed-module-in-process"
  transport_encoding: extdeps.cache.types.CatalogOpaqueStringEncoding
  key_derivation: {

    key_inputs: extdeps.cache.types.NativeInternal { cited_inputs: [extdeps.cache.types.UpsertSubject, extdeps.cache.types.ToolchainSpec] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: std.cache_interface.Repo
    invalidation_triggers: [std.cache_interface.DependencyChange, std.cache_interface.ToolchainChange]
  }
  io: {
    lookup_semantics: std.cache_interface.ExactKeyOnly
    write_semantics: std.cache_interface.OverwriteAllowed
    miss_semantics: std.cache_interface.MissThenCreate
  }
  placement: {
    value_shape: std.cache_interface.StructuredArtifact
    locality: std.cache_interface.InProcess
    retention: { release_policy: std.cache_interface.ReleasedAtProviderScopeExit, capacity: std.cache_interface.CapacityBounded { limit: std.cache_interface.EntryCountCapacity { limit: std.cache_interface.RuntimeDerivedLimit { authority: { module_path: "gunbc.typed_module_cache_capacity", decl_name: "typed_module_cache_entry_cap", field: std.decl_ref.WholeDeclaration } } }, at_capacity: std.cache_interface.ReplaceExisting { strategy: std.cache_interface.ProviderNativeReplacement } } }
    atomicity: std.cache_interface.PerFile
    auth: std.cache_interface.None
    read_latency: std.cache_interface.InProcessNs
    consistency: std.cache_interface.Strong
  }
  evidence: [
    {
      field: "key_derivation"
      evidence: std.cache_interface.OperatorObserved {
        note: "cli_run.rs reconcile_with_typed_cache keys on std.interface_summary.typed_module_key — module source hash + direct-import interface hashes (UpsertSubject) + compiler-binary identity via resolved_graph_cache::transform_content_digest (ToolchainSpec); the former authored-name key (the Phase-2c cache-impurity witness) is dissolved (cross-entry-typed-module-memo-sketch.md stage PR-alpha)"
        observed_at: v2.std.optional.Absent
      }
    },
    {
      field: "locality"
      evidence: std.cache_interface.OperatorObserved {
        note: "scoped to MultiEntryIndex.typed_module_cache; warms across batch entry resolves; drops when index is dropped"
        observed_at: v2.std.optional.Absent
      }
    },
  ]
}
