module extdeps.realization.resolved_graph



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data resolved_graph_cache_cap_bytes: ByteSize = byte_size(count: 10737418240)

data resolved_graph_cache_id: CacheInterfaceId = "resolved_graph_cache"

data resolved_graph_cache_facts: CacheInterfaceCatalogFacts = {
  identity: resolved_graph_cache_id
  backing_surface: "gunbc-resolved-graph-per-host-cache"
  transport_encoding: CatalogCasContentEncoding
  key_derivation: {

    key_inputs: ContentAddressed
    overwritable: false
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: Org
    invalidation_triggers: [ToolchainChange, ManualPurge]
  }
  io: {
    lookup_semantics: ContentAddressLookup
    write_semantics: WriteOnce
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: StructuredArtifact
    locality: PerHostFilesystem
    eviction: SizeBounded { cap_bytes: resolved_graph_cache_cap_bytes }
    atomicity: WriteThenRename
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: ReadYourWrites
  }
  evidence: [
    {
      field: "atomicity"
      evidence: OperatorObserved {
        note: "resolved_graph_cache.rs temp-file + rename write path (WriteOnce under race)"
        observed_at: 0
      }
    },
    {
      field: "lookup_semantics"
      evidence: OperatorObserved {
        note: "subject_digest content-addresses the closure content AND the resolve transform via the ToolchainSpec input (content(toolchain)) — NOT hand-authored resolve-logic/intern-seed version strings (cache-key-by-construction)"
        observed_at: 0
      }
    },
  ]
}

data resolved_graph_cache_compile_clean_diagnostic_union_dissolve_trigger: String = "dissolve-on: resolved_graph_cache_compile_clean_diagnostic_union_disk_hit_refusal — v1 disk artifacts carry graph+source_indices only; the compile-clean gate reads a resolve→normalize→typed→ownership diagnostic union. Until the union is serialized into the artifact, cross-process hits are refused and cold assembly runs (cli_run.rs resolved_graph_from_sources_with_index). DISSOLVES WHEN resolved_graph_cache FORMAT_VERSION persists compile_clean_diagnostic_union alongside the graph and the hit path installs the full union into the in-process memo (delete the refuse arm)."

data resolved_graph_cache_compile_clean_diagnostic_union_scaffold: Disposition = Scaffold {
  dissolves_to: SingleAuthority,
  bind: DeclarationRef {
    module_path: "extdeps.realization.resolved_graph",
    decl_name: "resolved_graph_cache_compile_clean_diagnostic_union_dissolve_trigger",
    field: WholeDeclaration
  }
}
