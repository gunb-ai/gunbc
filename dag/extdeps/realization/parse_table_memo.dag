module extdeps.realization.parse_table_memo

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

import extdeps.cache.types { CacheInterfaceCatalogFacts, ContentAddressed, CatalogCasContentEncoding }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  ContentAddressLookup,
  OverwriteAllowed,
  MissThenCreate,
  StructuredArtifact,
  InProcess,
  Never,
  PerFile,
  None,
  InProcessNs,
  Strong,
  OperatorObserved,
  ManualPurge,
  Repo,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data parse_table_memo_id: CacheInterfaceId = "parse_table_memo_cache"

data parse_table_memo_facts: CacheInterfaceCatalogFacts = {
  identity: parse_table_memo_id
  backing_surface: "gunbc-parse-table-in-process"
  transport_encoding: CatalogCasContentEncoding
  key_derivation: {

    key_inputs: ContentAddressed
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Repo
    invalidation_triggers: [ManualPurge]
  }
  io: {
    lookup_semantics: ContentAddressLookup
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: StructuredArtifact
    locality: InProcess
    eviction: Never
    atomicity: PerFile
    auth: None
    read_latency: InProcessNs
    consistency: Strong
  }
  evidence: [
    {
      field: "locality"
      evidence: OperatorObserved {
        note: "scoped to InterpContext; drops with evaluation — within-run memo (design-recompute-memoization §4.1)"
        observed_at: 0
      }
    },
    {
      field: "key_derivation"
      evidence: OperatorObserved {
        note: "ParseTableSubject = grammar_digest + token_stream_digest (full stream content-address incl. lexemes) + position + production"
        observed_at: 0
      }
    },
  ]
}
