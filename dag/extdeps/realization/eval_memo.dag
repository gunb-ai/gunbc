module extdeps.realization.eval_memo

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

import extdeps.cache.types { CacheInterfaceCatalogFacts, ContentAddressed, CatalogCasContentEncoding }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  ContentAddressLookup,
  OverwriteAllowed,
  MissThenCreate,
  StructuredArtifact,
  InProcess,
  Never,
  PerFile,
  None,
  InProcessNs,
  Strong,
  OperatorObserved,
  ManualPurge,
  Repo,
}
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data eval_memo_note: String = "The eval-frame memo: the ladder's single-site discharge provider, realized in the seed interpreter (v1_interpreter.rs eval_pure_named_call / EvalCallMemo). Serves every repeated pure named-fn demand from its first evaluation within one InterpContext. SOUNDNESS IS CONSTRUCTION, NOT PROBABILITY: buckets by the demand-ledger key (fn identity x argument content identity) but serves ONLY after the stored call's argument names AND values verify equal (Value equality, the one equality authority) — a hash collision degrades to recompute, never to a wrong value. A memo hit still records the DEMAND in the ledger: plurality is the fact the receipt counts; the provider changes its cost, never its count (so the multi-site rewire worklist survives discharge intact). Eviction is ScopeExit (ctx lifetime); admission stops at the entry cap with the refusal COUNTED (memo_overflow), never silent. Default ON in every binary; GUNBC_EVAL_MEMO=0 is a diagnostic realization switch (recompute instead of serve, semantics identical) and the receipt discloses memo_hits/memo_misses so a disabled or ineffective memo is visible, never assumed working. The switch is PER-CTX (read at InterpContext construction; set_eval_call_memo_enabled), because a covering provider at an outer frame legitimately quiets an inner provider's hit counters: an inner door's by-execution receipt suite (the parse-table MemoTier amortization tests) pins this provider off on its own ctxs so pass-2 demands re-execute and the door's counters keep discriminating — provider-attribution receipts select their realization explicitly, they do not race a process latch. MEASURED (2026-07-10, artifact-regen workload): single-site duplicated keys 7285 -> 505 (93.1 percent discharged), wasted_ms 586 -> 57, misses == distinct keys (every distinct computation evaluated exactly once), regenerated artifacts byte-identical with the memo on and off — the purity oracle by execution."

data eval_memo_seed_handler_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "std.materialization_ladder",
    decl_name: "materialization_ladder",
    field: WholeDeclaration
  }
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data eval_memo_id: CacheInterfaceId = "eval_call_memo_cache"

data eval_memo_facts: CacheInterfaceCatalogFacts = {
  identity: eval_memo_id
  backing_surface: "gunbc-eval-call-in-process"
  transport_encoding: CatalogCasContentEncoding
  key_derivation: {

    key_inputs: ContentAddressed
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: Repo
    invalidation_triggers: [ManualPurge]
  }
  io: {
    lookup_semantics: ContentAddressLookup
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: StructuredArtifact
    locality: InProcess
    eviction: Never
    atomicity: PerFile
    auth: None
    read_latency: InProcessNs
    consistency: Strong
  }
  evidence: [
    {
      field: "locality"
      evidence: OperatorObserved {
        note: "scoped to InterpContext; drops with evaluation — ScopeExit eviction at the eval frame; entry-cap refusals counted as memo_overflow in the floor materialization receipt"
        observed_at: 0
      }
    },
    {
      field: "key_derivation"
      evidence: OperatorObserved {
        note: "EvalRecomputeKey = fn identity x per-argument identity (scalars exact; composites recursive content hash, allocation-memoized with Weak liveness); content_verified_on_read is TRUE structurally: a hit serves only after stored argument names and values verify equal via Value equality, so a collision recomputes rather than lies"
        observed_at: 0
      }
    },
  ]
}
