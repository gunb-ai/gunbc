module extdeps.realization.eval_memo

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import v2.std.optional { Absent }

import extdeps.cache.types { CacheInterfaceCatalogFacts, ContentAddressed, CatalogCasContentEncoding }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  ContentAddressLookup,
  OverwriteAllowed,
  MissThenCreate,
  StructuredArtifact,
  InProcess,
  PerFile,
  None,
  InProcessNs,
  Strong,
  OperatorObserved,
  ManualPurge,
  Repo,
  CapacityBounded,
  EntryCountCapacity,
  ExactLimit,
  RefuseNewStore,
  ReleasedAtProviderScopeExit,
}
import std.disposition { Disposition, Scaffold, RealizationDispatch }
import std.decl_ref { DeclarationRef, WholeDeclaration }

// The eval-frame memo: the ladder's single-site discharge provider, realized in the seed
// interpreter (v1_interpreter.rs eval_pure_named_call / EvalCallMemo). Serves every repeated pure
// named-fn demand from its first evaluation within one InterpContext. SOUNDNESS IS CONSTRUCTION,
// NOT PROBABILITY: buckets by the demand-ledger key (fn identity x argument content identity) but
// serves ONLY after the stored call's argument names AND values verify equal (Value equality, the
// one equality authority) — a hash collision degrades to recompute, never to a wrong value. A memo
// hit still records the DEMAND in the ledger: plurality is the fact the receipt counts; the
// provider changes its cost, never its count (so the multi-site rewire worklist survives discharge
// intact). Release is ReleasedAtProviderScopeExit and the provider scope is the WITNESS FRAME
// (corrected 2026-07-10, same-day regression owned at confession grade: the first landing evicted
// at ctx lifetime while batch surfaces share one ctx across an entry's witnesses, so retained
// argument+result values were byte-unbounded by construction — measured single-witness plateau
// ~3.4GiB vs six-witness climb past ~20GiB to SIGKILL on a quiet host, eager-ram-612's A/B; batch
// surfaces now call eval_call_memo_frame_exit after each claim fn, counters cumulative).
// Cross-witness serving is an outer-frame promotion that must arrive as a conscious provider row
// with byte-bounded admission, never a default; the count cap (1M entries) is admission at the
// wrong unit and is slated to become a DECLARED byte cap consuming the single value-size authority
// (one fn beside Value; merry-owl-649's space-lens predictor binds to the same authority).
// Admission stops at the cap with the refusal COUNTED (memo_overflow), never silent. COUNTER
// INVARIANT (review-pinned 2026-07-10): a miss means the call was NOT served, so it evaluated — a
// cap-refused store attempt is still a miss; overflow is a subset of misses, and hits + misses
// equals the keyed Ok-resulting calls through the memo path, including under overflow (misses is
// NOT entries-stored).
//
// ADMISSION IS BY DERIVED REUSE OBLIGATION, NEVER A DEFAULT (DESIGN section 2, ruling of
// 2026-09-27 on the 02_parse list-literal cost). A call is keyed only when its RESOLVED fn node is
// admitted on its ctx (v1_interpreter.rs install_eval_call_memo_admission), and admission may be
// installed only from a modeled obligation that std.materialization_ladder discharges to this
// provider -- never a hand-typed list of fn names. No modeled obligation discharges here today
// (per-declaration demand identity is the keys-row frontier, docs/plans/demand-engine-program.md),
// so the admitted population is EMPTY and every call recomputes; a call whose cost needs reuse is
// named with its missing obligation, not re-admitted wholesale. The GUNBC_EVAL_MEMO switch is
// deleted with the default it toggled: a switch whose only effect is to restore default admission
// is the escape hatch of DESIGN section 5. WHY THE DEFAULT WAS REMOVED: keying is a recursive
// content hash of the arguments, allocation-memoized only at the root, so a threaded accumulator
// rebuilt per step -- 02_parse's ParseTable, whose memo map is a new allocation after every insert
// -- was rehashed whole on every call: O(n) per call, O(n^2) per parse, under a key that could
// never recur (the table's per-call counters), with every table version kept alive. Measured on
// the llv probe (probe/calm-pike-745-llv) the list-literal parse went quadratic -> linear;
// v2.test.parse.list_literal_parse_cost lpc_long_list_literal_parses is the enrolled control
// (default admission puts it several times over the per-claim budget). The receipt still discloses
// memo_hits/memo_misses, so an empty admission shows as memo_hits=0, never assumed working.
//
// SCAFFOLD STANDING: this NARROWS the scaffold toward its dissolution. The seed handler stays (its
// verified-serve arm is the provider a derived admission will bind), but it no longer answers for
// any demand the ladder has not discharged to it; it dissolves into RealizationDispatch when the
// ladder's discharge is what installs admission. HISTORY: the 2026-07-10 measurement below was
// taken under the retired default admission, and so were the hit counts it cites; the per-ctx
// switch that attribution tests used to pin the provider off is subsumed by the empty default.
// MEASURED under the retired default admission (2026-07-10, artifact-regen workload): single-site duplicated keys 7285
// -> 505 (93.1 percent discharged), wasted_ms 586 -> 57, misses == distinct keys (every distinct
// computation evaluated exactly once), regenerated artifacts byte-identical with the memo on and
// off — the purity oracle by execution.

data eval_memo_seed_handler_dissolution_trigger: Disposition = Scaffold {
  dissolves_to: RealizationDispatch,
  bind: DeclarationRef {
    module_path: "std.materialization_ladder",
    decl_name: "materialization_ladder",
    field: WholeDeclaration
  }
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/realization"
  }
}

data eval_memo_id: CacheInterfaceId = "eval_call_memo_cache"

data eval_memo_facts: CacheInterfaceCatalogFacts = {
  identity: eval_memo_id
  backing_surface: "gunbc-eval-call-in-process"
  transport_encoding: CatalogCasContentEncoding
  key_derivation: {

    key_inputs: ContentAddressed
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: Repo
    invalidation_triggers: [ManualPurge]
  }
  io: {
    lookup_semantics: ContentAddressLookup
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: StructuredArtifact
    locality: InProcess
    retention: { release_policy: ReleasedAtProviderScopeExit, capacity: CapacityBounded { limit: EntryCountCapacity { limit: ExactLimit { value: 1000000 } }, at_capacity: RefuseNewStore } }
    atomicity: PerFile
    auth: None
    read_latency: InProcessNs
    consistency: Strong
  }
  evidence: [
    {
      field: "locality"
      evidence: OperatorObserved {
        note: "scoped to InterpContext for the resolve-side share, but EVICTED at the witness frame (eval_call_memo_frame_exit after each claim fn on batch surfaces — ctx-lifetime retention across witnesses was the 2026-07-10 20GiB-class regression); entry-cap refusals counted as memo_overflow in the floor materialization receipt"
        observed_at: Absent
      }
    },
    {
      field: "key_derivation"
      evidence: OperatorObserved {
        note: "EvalRecomputeKey = fn identity x per-argument identity (scalars exact; composites recursive content hash, allocation-memoized with Weak liveness); content_verified_on_read is TRUE structurally: a hit serves only after stored argument names and values verify equal via Value equality, so a collision recomputes rather than lies"
        observed_at: Absent
      }
    },
  ]
}
