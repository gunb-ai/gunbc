module extdeps.chassis.types


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Computer_case"
  }
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.chassis.types",
      decl_name: "ChassisCatalogRow",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.chassis.types.extdeps_external_authority_anchor,
  further_citations: []
}

type MotherboardFormFactor = Atx | MicroAtx | MiniItx

type ChassisCatalogRow {
  model: std.types.NonEmptyStr
  manufacturer: Vendor<extdeps.hardware.Hardware>
  rack_units: std.measure.RackUnit
  motherboard_support: List<MotherboardFormFactor>
  internal_35_bay_count: Int
  internal_525_bay_count: Int
  expansion_slot_count: Int
  included_fan_count: Int
  max_gpu_length: std.measure.Millimeter?
  max_cooler_height: std.measure.Millimeter?
}
