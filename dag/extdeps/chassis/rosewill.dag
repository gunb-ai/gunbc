module extdeps.chassis.rosewill

import std.types { NonEmptyStr, List }
import std.measure { millimeter, rack_unit }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.chassis.types {
  ChassisCatalogRow,
  Atx,
  MicroAtx,
  MiniItx,
}
import extdeps.vendor.rosewill { rosewill }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rosewill.com/product-group/Rackmount-Cases/213-rosewill-rsv-r4000u-4u-rackmount-server-chassis-case"
  }
}

data rsv_r4000u_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rosewill.com/product-group/Rackmount-Cases/213-rosewill-rsv-r4000u-4u-rackmount-server-chassis-case"
  }
}

data rsv_z2600u_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.rosewill.com/product-group/Rackmount-Cases/214-rosewill-rsv-z2600u-2u-rackmount-server-chassis-case"
  }
}

// The R4000U publishes its cooling row explicitly - "Front - 2 x 120mm fans (2 x 120mm fan
// included)" and "Rear - 2 x 80mm fans (2 x 80mm fan included)" - so bays and included are the
// same number and the chassis ships fully populated. max_cooler_height was `none` until
// 2026-08-26; the page states 117mm with the GPU holder fitted and 152mm without, and the
// smaller figure is taken because it is the one that holds in the shipped configuration.
data rosewill_rsv_r4000u_catalog: ChassisCatalogRow = ChassisCatalogRow {
  model: "RSV-R4000U",
  manufacturer: rosewill,
  rack_units: rack_unit(4),
  motherboard_support: [Atx, MicroAtx, MiniItx],
  internal_35_bay_count: 8,
  internal_525_bay_count: 3,
  expansion_slot_count: 7,
  included_fan_count: 4,
  max_gpu_length: Present { value: millimeter(270) },
  max_cooler_height: Present { value: millimeter(117) },
}

// included_fan_count WAS 0 AND THAT WAS WRONG. Rosewill's title row and every retailer listing
// state "3 x 80mm PWM Fans", and the product page's feature bullet reads "3 pre-installed
// cooling fans". Corrected 2026-08-26. The zero was load-bearing in the wrong direction: it made
// the installed fan population underivable, so the fan-controller tach list was hand-authored
// against no authority and drifted from the hardware on both 2U hosts without anything
// refusing. With the true count the population falls out - three chassis fans plus one processor
// cooler header is four headers, which is exactly what srv3 and srv4 report.
//
// TWO THINGS THIS ROW STILL DOES NOT SETTLE, recorded rather than smoothed over:
// FAN BAY COUNT IS NOT PUBLISHED for this model. Unlike its 4U sibling the Z2600U spec table
// carries no Cooling System row at all, on Rosewill's own page or any retailer, so "three
// mounting positions" is an inference from the included count and not a published fact - there
// may be further empty positions. included_fan_count is therefore the honest field to carry and
// a bay count is deliberately NOT authored here.
// AND ROSEWILL CONTRADICTS ITSELF: the same product page also carries a bullet reading "2
// pre-installed 80mm front cooling fans". The 3 figure is taken because it is echoed by the
// product title and by every retailer listing, and because it is what the fleet measures; the 2
// appears in one bullet only and reads as copy inherited from the older non-U RSV-Z2600.
data rosewill_rsv_z2600u_catalog: ChassisCatalogRow = ChassisCatalogRow {
  model: "RSV-Z2600U",
  manufacturer: rosewill,
  rack_units: rack_unit(2),
  motherboard_support: [MicroAtx, MiniItx],
  internal_35_bay_count: 4,
  internal_525_bay_count: 0,
  expansion_slot_count: 4,
  included_fan_count: 3,
  max_gpu_length: Present { value: millimeter(150) },
  max_cooler_height: Present { value: millimeter(70) },
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.chassis.rosewill",
      decl_name: "rosewill_rsv_r4000u_catalog",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [rsv_r4000u_authority, rsv_z2600u_authority]
}
