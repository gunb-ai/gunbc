module extdeps.toolchain.architecture_profile


data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Instruction_set_architecture"
  }
}

type Endianness = LittleEndian | BigEndian

type ArchitectureProfile {
  architecture: Architecture

  word_width: BitWidth
  pointer_width: BitWidth
  endianness: Endianness
  page_size: ByteSize
  default_alignment: ByteSize
  register_file: List<ArchitecturalRegister>
  calling_convention: CallingConvention
  stack_layout: StackLayout
}

type DeploymentTarget {
  profile: ArchitectureProfile
  invocation: StableInvocationSurface
}
