module extdeps.toolchain.architecture_profile

import extdeps.toolchain.types { Architecture }
import extdeps.abi { ArchitecturalRegister, CallingConvention, StackLayout }
import std.measure { BitWidth, ByteSize }
import std.types { NonEmptyStr }
import std.os.invocation { StableInvocationSurface }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Instruction_set_architecture"
  }
}

type Endianness = LittleEndian | BigEndian

fn endianness_token(e: Endianness) -> NonEmptyStr {
  match e {
    LittleEndian => "little" as NonEmptyStr
    BigEndian => "big" as NonEmptyStr
  }
}

type ArchitectureProfile {
  architecture: Architecture

  word_width: BitWidth
  pointer_width: BitWidth
  endianness: Endianness
  page_size: ByteSize
  default_alignment: ByteSize
  register_file: List<ArchitecturalRegister>
  calling_convention: CallingConvention
  stack_layout: StackLayout
}

type DeploymentTarget {
  profile: ArchitectureProfile
  invocation: StableInvocationSurface
}
