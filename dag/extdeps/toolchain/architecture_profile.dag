module extdeps.toolchain.architecture_profile


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "en.wikipedia.org/wiki/Instruction_set_architecture"
  }
}

type Endianness = LittleEndian | BigEndian

type ArchitectureProfile {
  architecture: extdeps.toolchain.types.Architecture

  word_width: std.measure.BitWidth
  pointer_width: std.measure.BitWidth
  endianness: Endianness
  page_size: std.measure.ByteSize
  default_alignment: std.measure.ByteSize
  register_file: List<std.abi.ArchitecturalRegister>
  calling_convention: std.abi.CallingConvention
  stack_layout: std.abi.StackLayout
}

type DeploymentTarget {
  profile: ArchitectureProfile
  invocation: std.os.invocation.StableInvocationSurface
}
