module extdeps.toolchain.types

import std.types { String, NonEmptyStr }
import std.cache_identity { CacheInterfaceId }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "wiki.debian.org/ArchitectureSpecificsMemo"
  }
}

type Architecture = X86_64 | X86 | Aarch64 | Arm | Armv7 | Mips | Mipsel | Mips64 | Mips64el | Riscv64 | Wasm32

// A total variant name for Architecture, for DIAGNOSTICS ONLY — a refusal that cannot say which architecture it refused is typed but not located (§5). Deliberately NOT a wire label: every upstream that names architectures does so differently (debian arm64, Go GOARCH, sccache's musl tarball token, grub EFI filenames), and each of those already lives with its own upstream as a partial projection that REFUSES the arches that upstream does not publish. Reusing this name as a wire label would re-coin those authorities and defeat their fail-closed arms, so it is named for its purpose.
fn architecture_diagnostic_name(arch: Architecture) -> NonEmptyStr {
  match arch {
    X86_64 => "X86_64" as NonEmptyStr
    X86 => "X86" as NonEmptyStr
    Aarch64 => "Aarch64" as NonEmptyStr
    Arm => "Arm" as NonEmptyStr
    Armv7 => "Armv7" as NonEmptyStr
    Mips => "Mips" as NonEmptyStr
    Mipsel => "Mipsel" as NonEmptyStr
    Mips64 => "Mips64" as NonEmptyStr
    Mips64el => "Mips64el" as NonEmptyStr
    Riscv64 => "Riscv64" as NonEmptyStr
    Wasm32 => "Wasm32" as NonEmptyStr
  }
}

type TripleVendor = UnknownVendor | Pc | Apple | W64
type Os = Linux | Macos | Windows | Freebsd | Android | Ios | Wasi
type AbiEnv = NoneAbi | Gnu | GnuEabi | GnuEabihf | Musl | Msvc | AndroidAbi | Eabi | Eabihf
type ExecutionEnv = Native | Wsl | Container | Ci | Emulator

// Total variant names for the remaining TargetTriple axes, carrying architecture_diagnostic_name's restriction verbatim: DIAGNOSTICS ONLY, never a wire label. The same argument applies unchanged — every upstream spells these differently (Rust's platform-support triples, Debian's arch names, Go's GOOS) and each such spelling belongs with its own upstream as a partial projection that refuses what that upstream does not publish.
//
// They exist because a refusal or an identity that cannot distinguish Gnu from Musl is not merely unlocated, it is WRONG: those two differ in exactly the axis that decides whether a produced binary runs on a given host, so a key blind to AbiEnv would let a musl artifact satisfy a request for a gnu one. That is the false-sharing failure a build subject exists to prevent.
fn triple_vendor_diagnostic_name(vendor: TripleVendor) -> NonEmptyStr {
  match vendor {
    UnknownVendor => "UnknownVendor" as NonEmptyStr
    Pc => "Pc" as NonEmptyStr
    Apple => "Apple" as NonEmptyStr
    W64 => "W64" as NonEmptyStr
  }
}

fn os_diagnostic_name(os: Os) -> NonEmptyStr {
  match os {
    Linux => "Linux" as NonEmptyStr
    Macos => "Macos" as NonEmptyStr
    Windows => "Windows" as NonEmptyStr
    Freebsd => "Freebsd" as NonEmptyStr
    Android => "Android" as NonEmptyStr
    Ios => "Ios" as NonEmptyStr
    Wasi => "Wasi" as NonEmptyStr
  }
}

fn abi_env_diagnostic_name(env: AbiEnv) -> NonEmptyStr {
  match env {
    NoneAbi => "NoneAbi" as NonEmptyStr
    Gnu => "Gnu" as NonEmptyStr
    GnuEabi => "GnuEabi" as NonEmptyStr
    GnuEabihf => "GnuEabihf" as NonEmptyStr
    Musl => "Musl" as NonEmptyStr
    Msvc => "Msvc" as NonEmptyStr
    AndroidAbi => "AndroidAbi" as NonEmptyStr
    Eabi => "Eabi" as NonEmptyStr
    Eabihf => "Eabihf" as NonEmptyStr
  }
}

type TargetTriple {
  arch: Architecture
  vendor: TripleVendor
  os: Os
  env: AbiEnv?
}

type RuntimePlatform {
  host: TargetTriple
  env: ExecutionEnv
}

type ToolchainEnvIsolation
  = SharedHomeAcrossJobs
  | PerJobCargoHome { cargo_home_var: NonEmptyStr, rustup_home_var: NonEmptyStr }
  | HermeticContainer

type BuildWrapperKind = CtrlBuild | BakedInImage | NoBuildWrapper

type ToolchainCapability {
  name: NonEmptyStr
  version: NonEmptyStr
  env_isolation: ToolchainEnvIsolation
  build_wrapper: BuildWrapperKind?
  linked_cache_interface: CacheInterfaceId?
}

type ToolchainRequirement {
  name: NonEmptyStr
  version: NonEmptyStr
}
