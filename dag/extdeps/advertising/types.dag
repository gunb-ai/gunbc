module extdeps.advertising.types

import std.types { NonEmptyStr }

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "en.wikipedia.org/wiki/Online_advertising"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.advertising.types",
      decl_name: "AdPriceDetermination",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// Auction ad platforms publish the pricing MECHANISM, not a rate card: the amount charged per
// billable event is determined per-auction and no citable numeric rate exists upstream.
// AuctionDetermined is therefore the true upstream fact (an answer, with the mechanism page as its
// citation), while RateUnavailable marks a figure the vendor DOES publish but this fetch could not
// read (ignorance) -- the DESIGN section 5 distinction between top-as-answer and top-as-ignorance,
// kept as two typed arms so neither can masquerade as the other. A listed-rate arm is deliberately
// absent: neither modeled vendor publishes a citable numeric rate today, and that arm is minted
// when the first citable listed figure appears, never before -- a fabricated plausible rate from
// training data is exactly the wrong answer, and a vendor rate is precisely the kind of fact that
// goes stale.

type AdPriceDetermination
  = AuctionDetermined { mechanism_citation: NonEmptyStr }
  | RateUnavailable { cause: NonEmptyStr }
