data meta_bill_listing_interaction: MetaBillingEventRow = MetaBillingEventRow {
  event: MetaBillListingInteraction,
  wire_value: "LISTING_INTERACTION",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

fn meta_billing_event_catalog() -> List<MetaBillingEventRow> {
  [
    meta_bill_app_installs,
    meta_bill_clicks,
    meta_bill_impressions,
    meta_bill_link_clicks,
    meta_bill_none,
    meta_bill_offer_claims,
    meta_bill_page_likes,
    meta_bill_post_engagement,
    meta_bill_thruplay,
    meta_bill_purchase,
    meta_bill_listing_interaction,
  ]
}

type MetaBidStrategy
  = MetaLowestCostWithoutCap
  | MetaLowestCostWithBidCap
  | MetaCostCap
  | MetaLowestCostWithMinRoas

type MetaBidStrategyRow {
  strategy: MetaBidStrategy
  wire_value: std.types.NonEmptyStr
  citation: std.types.NonEmptyStr
}

data meta_strategy_lowest_cost_without_cap: MetaBidStrategyRow = MetaBidStrategyRow {
  strategy: MetaLowestCostWithoutCap,
  wire_value: "LOWEST_COST_WITHOUT_CAP",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_strategy_lowest_cost_with_bid_cap: MetaBidStrategyRow = MetaBidStrategyRow {
  strategy: MetaLowestCostWithBidCap,
  wire_value: "LOWEST_COST_WITH_BID_CAP",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_strategy_cost_cap: MetaBidStrategyRow = MetaBidStrategyRow {
  strategy: MetaCostCap,
  wire_value: "COST_CAP",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_strategy_lowest_cost_with_min_roas: MetaBidStrategyRow = MetaBidStrategyRow {
  strategy: MetaLowestCostWithMinRoas,
  wire_value: "LOWEST_COST_WITH_MIN_ROAS",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

fn meta_bid_strategy_catalog() -> List<MetaBidStrategyRow> {
  [
    meta_strategy_lowest_cost_without_cap,
    meta_strategy_lowest_cost_with_bid_cap,
    meta_strategy_cost_cap,
    meta_strategy_lowest_cost_with_min_roas,
  ]
}

data meta_optimization_goal_note: String = "optimization_goal wire values transcribed verbatim from the anchor reference 2026-08-01. Kept as a wire-value roster rather than a closed enum: this is the coarse-grain record that the axis EXISTS and is distinct from billing_event; per-goal modeling waits for a consumer that needs it (second-consumer discipline), and a 33-variant enum nobody eliminates over would be roster theater."

