module extdeps.advertising.meta_ads




data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "developers.facebook.com/docs/marketing-api/reference/ad-campaign"
  }
}

data meta_ads_subject: Vendor<extdeps.securities.Securities> = meta_platforms

data meta_ads_provenance_note: String = "Interface facts live-fetched 2026-08-01 from the Meta Marketing API developer docs: the anchor page (which, per the API's legacy object naming, is the AD SET reference -- billing_event, bid_strategy, and optimization_goal are ad-set-level fields) and the bidding overview at developers.facebook.com/docs/marketing-api/bidding, which states the billing-event concept verbatim: the system 'defines events you want to pay for, including impressions, clicks, or various actions.' Two Business Help Center pages were attempted and are client-rendered (this fetch reads only their titles): 'About Ad Auctions | Meta Business Help Center' (facebook.com/business/help/430291176997542) and 'Best Practices for Minimum Budgets | Meta Business Help Center' (facebook.com/business/help/203183363050448) -- the latter is why the minimum-budget row below is RateUnavailable with that cause, never a remembered number."

type MetaBillingEvent
  = MetaBillAppInstalls
  | MetaBillClicks
  | MetaBillImpressions
  | MetaBillLinkClicks
  | MetaBillNone
  | MetaBillOfferClaims
  | MetaBillPageLikes
  | MetaBillPostEngagement
  | MetaBillThruplay
  | MetaBillPurchase
  | MetaBillListingInteraction

type MetaBillingEventRow {
  event: MetaBillingEvent
  wire_value: std.types.NonEmptyStr
  citation: std.types.NonEmptyStr
}

// billing_event is the published API enum naming what the advertiser is CHARGED for; wire values verbatim from the anchor reference. It is a separate axis from optimization_goal (optimize delivery for one event while being billed on another) -- fusing the two would misstate the documented interface, so the optimization-goal roster lands as its own row below.
data meta_bill_app_installs: MetaBillingEventRow = MetaBillingEventRow {
  event: MetaBillAppInstalls,
  wire_value: "APP_INSTALLS",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_bill_clicks: MetaBillingEventRow = MetaBillingEventRow {
  event: MetaBillClicks,
  wire_value: "CLICKS",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_bill_impressions: MetaBillingEventRow = MetaBillingEventRow {
  event: MetaBillImpressions,
  wire_value: "IMPRESSIONS",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_bill_link_clicks: MetaBillingEventRow = MetaBillingEventRow {
