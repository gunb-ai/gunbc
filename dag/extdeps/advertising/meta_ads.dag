data meta_bill_none: MetaBillingEventRow = MetaBillingEventRow {
  event: MetaBillNone,
  wire_value: "NONE",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_bill_offer_claims: MetaBillingEventRow = MetaBillingEventRow {
  event: MetaBillOfferClaims,
  wire_value: "OFFER_CLAIMS",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_bill_page_likes: MetaBillingEventRow = MetaBillingEventRow {
  event: MetaBillPageLikes,
  wire_value: "PAGE_LIKES",
  citation: "developers.facebook.com/docs/marketing-api/reference/ad-campaign",
}

data meta_bill_post_engagement: MetaBillingEventRow = MetaBillingEventRow {
  event: MetaBillPostEngagement,
  wire_value: "POST_ENGAGEMENT",
