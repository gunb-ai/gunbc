import extdeps.exec.program { uncataloged_program }

import std.types { String, NonEmptyStr, List, FilePath }
import extdeps.shell
import extdeps.shell.exec { ProcessOutcome, ProcessOutputPresent, ProcessOutputAbsent, ProcessRefused }
import extdeps.tools.sha256sum { sha256sum_file_digest_via_shell, Sha256FileDigest, Sha256FileDigestUnavailable }
import extdeps.tools.chmod { chmod_set_mode_command, chmod_path_resolved_program }
import gunbc.command_runner { run_shell_command_capture }
import extdeps.exec.command { LocalExec }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.gnu.libc { GlibcVersion, glibc_version }
import extdeps.exec.command { ArgvCommand, argv_command }
import std.measure { Micrometer, micrometer_count, MicrometrePerSecond, micrometre_per_second_count, MicrometrePerSecondSquared, micrometre_per_second_squared_count, Percent, percent_count }
import std.decimal { ExactDecimal, exact_decimal_wire }
import extdeps.languages.json.emit { JsonKeyValue, json_kv, json_string }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/SoftFever/OrcaSlicer/releases/tag/v2.4.2"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.printing.orca_slicer",
      decl_name: "orca_slicer_version",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// WHY THIS SLICER AND NOT A DEBIAN-PACKAGED ONE, which is a real choice with a real loser.
//
// Debian bookworm main carries prusa-slicer, cura-engine, slic3r and slic3r-prusa for arm64. Any of
// them installs in one apt transaction. None of them can drive the machines this repository
// actually owns: extdeps.printing.bambu_lab_a1_mini is a Bambu Lab printer, gunbc.fleet.fleet_printer_access
// models it in LAN Mode with an MQTT control channel and an FTPS file channel, and that firmware
// consumes a sliced Bambu project file. A generic slicer's g-code is not that artifact. Choosing the
// easy install would have produced a toolchain that runs end to end and emits something the printer
// does not accept -- the fabricated plausible output DESIGN section 5 forbids, arrived at by picking
// the dependency that was convenient rather than the one that closes the loop.
//
// OrcaSlicer is a PrusaSlicer derivative that carries first-party Bambu machine profiles and can
// export the project format, which is why it is the modelled dependency despite being the harder
// one to obtain.

data orca_slicer_version: NonEmptyStr = "2.4.2"

// THE SELECTED ARTIFACT, AND THE CLAIM IS ABOUT THE APPIMAGE ROUTE ONLY. An earlier revision said
// "aarch64 support appears at v2.4.0", which is false: upstream published an aarch64 FLATPAK at
// v2.3.1. The narrow true statement is the one that bears on the choice made here -- the aarch64
// AppImage, which is the no-root route, appears at v2.4.0, and every aarch64 AppImage upstream ships
// is built on Ubuntu 24.04, so there is no AppImage built against an older toolchain to fall back
// to. The flatpak does not help independently, because this environment has neither flatpak nor
// bubblewrap; it is named so the census is not read as broader than it is.
data orca_slicer_linux_aarch64_appimage: NonEmptyStr = "OrcaSlicer_Linux_AppImage_Ubuntu2404_aarch64_V2.4.2.AppImage"

// THE CONTENT DIGEST OF THE ARTIFACT THAT WAS ACTUALLY FETCHED AND EXAMINED. A version alone does
// not identify bytes: a release asset can be replaced in place, and every measurement recorded in
// this module was made against THIS content and is a claim about nothing else.
data orca_slicer_linux_aarch64_appimage_sha256: NonEmptyStr = "e1a07275a25f176626c55a5df39e91bc4476d8c28ee4a3192ff758e29dd5c3ba"

// The release asset the digest above was taken from (upstream release v2.4.2, asset list).
data orca_slicer_linux_aarch64_appimage_url: NonEmptyStr = "https://github.com/SoftFever/OrcaSlicer/releases/download/v2.4.2/OrcaSlicer_Linux_AppImage_Ubuntu2404_aarch64_V2.4.2.AppImage"

// THE ABI FLOOR, MEASURED FROM THE ARTIFACT AND NOT INFERRED FROM ITS FILENAME.
//
// The AppImage was extracted and symbol versions read across its WHOLE ELF CLOSURE -- 150 objects,
// executables and shared libraries alike -- not from the main binary alone. The highest versioned
// reference is GLIBC_2.38. Censusing only the entry binary was the first shape of this measurement
// and it is the wrong denominator: a bundled plugin may reference a newer symbol than the executable
// that loads it, and the floor that decides executability is the maximum over the closure.
//
// The Ubuntu 24.04 in the asset name would have SUGGESTED 2.39, and that guess would have been WRONG
// IN THE DIRECTION THAT REFUSES A WORKING HOST -- a build host's glibc is an upper bound on what a
// binary may reference, never the floor it actually requires. extdeps.gnu.libc exists because a
// target triple does not carry this fact; a codename in a filename does not carry it either.
//
// AND THE FLOOR IS NECESSARY, NOT SUFFICIENT. Meeting it says the loader will not reject the binary
// for a missing glibc symbol. It says nothing about the rest of the artifact's runtime closure, and
// this was demonstrated rather than reasoned: on a host at 2.39, well above the floor, the artifact
// still refused to start for want of libOpenGL, libGLU, libEGL and WebKitGTK. Any model that treats
// clearing the floor as "runs" is overstating its own measurement.
data orca_slicer_required_glibc: GlibcVersion = glibc_version(major: 2, minor: 38)

// Direct Ubuntu 24.04 package roots for the selected AppImage's host runtime.
// AppRun names WebKitGTK 4.1, JavaScriptCoreGTK 4.1, OpenGL, GLU and EGL as
// external libraries. Ubuntu owns their transitive dependencies; --help is still
// required to establish that the effective runtime loads, not just that dpkg knows it.
// Package mapping: https://packages.ubuntu.com/noble/libwebkit2gtk-4.1-0
// and https://packages.ubuntu.com/noble/libopengl0 (read 2026-10-05).
// The 2026-10-05 srv1 ELF inspection additionally found libSM.so.6 and
// libICE.so.6 unresolved; their Ubuntu providers are libsm6 and libice6.
data orca_ubuntu2404_runtime_packages: List<NonEmptyStr> = [
 "libopengl0", "libglu1-mesa", "libegl1", "libwebkit2gtk-4.1-0", "libjavascriptcoregtk-4.1-0",
 "libsm6", "libice6",
]

// A capability may be spent only inside with_verified_orca's private-copy lifetime.
// The archive is copied first and the copy is checked against the selected asset's digest.
// The callback can return only a process result, never the capability. Both probe and slice
// execute that same copy through AppImage's extract-and-run runtime, which removes its extraction.
// The private realization protects against replacing the caller's original archive. Like the
// printer payload bracket, it does not defend against a hostile process running as this user.
type OrcaExecutable sole_constructor { program: NonEmptyStr }

fn orca_executable_program(e: OrcaExecutable) -> NonEmptyStr { e.program }

// THE VERSION PROBE IS THE INVOCATION A CONSUMER USES TO ESTABLISH THAT THE BINARY RUNS. It is the
// cheapest Orca-shaped command there is, it needs no display, and it exits zero only if the runtime
// closure resolved -- which is exactly the fact a would-be slicer needs before a slice is planned.
fn orca_version_probe_command(executable: OrcaExecutable) -> ArgvCommand {
  argv_command(program: uncataloged_program(invocation: executable.program), arguments: ["--appimage-extract-and-run", "--help"])
}

// THE CLI, WHICH IS THE ONLY INTERFACE THIS REPOSITORY USES. The desktop application is the same
// binary; nothing here launches it, and nothing here needs a display.
fn orca_slice_to_project_command(
  executable: OrcaExecutable,
  input_model: String,
  output_project: String,
  printer_profile: String,
  filament_profile: String,
  process_profile: String,
) -> ArgvCommand {
  argv_command(
    program: uncataloged_program(invocation: executable.program),
    arguments: [
      "--appimage-extract-and-run",
      "--arrange", "1", "--orient", "0", "--ensure-on-bed",
      "--slice", "0",
      "--load-settings", concat(concat(printer_profile, ";"), process_profile),
      "--load-filaments", filament_profile,
      "--export-3mf", output_project,
      input_model,
    ],
  )
}

// The caller's copy is never executed, and a failed digest cannot mint the capability.
fn with_verified_orca(appimage: FilePath, use: fn(OrcaExecutable) -> ProcessOutcome) -> ProcessOutcome {
  let temp = shell.Mktemp.Dir()
  if !temp.success { return ProcessRefused { exit_code: 1, stderr: "Cannot create private Orca realization" } }
  let path = join([temp.path as String, "/", orca_slicer_linux_aarch64_appimage_sha256 as String, ".AppImage"], "")
  let result = if !shell.Copy.File(source: appimage, destination: path as FilePath).success {
    ProcessRefused { exit_code: 1, stderr: "Cannot copy Orca archive" }
  } else {
    match sha256sum_file_digest_via_shell(path: path as NonEmptyStr) {
      Sha256FileDigestUnavailable { path: _, reason: r } => ProcessRefused { exit_code: 1, stderr: r as String }
      Sha256FileDigest { digest: d } =>
        if (d.hex as String) != (orca_slicer_linux_aarch64_appimage_sha256 as String) {
          ProcessRefused { exit_code: 1, stderr: "Orca archive differs from the selected upstream digest; not executed" }
        } else {
          match run_shell_command_capture(command: chmod_set_mode_command(chmod_program: chmod_path_resolved_program, mode: "0500", path: path), transport: LocalExec) {
            ProcessRefused { exit_code: c, stderr: e } => ProcessRefused { exit_code: c, stderr: e }
            ProcessOutputAbsent=>use(OrcaExecutable { program: path as NonEmptyStr }) ProcessOutputPresent {text:_}=>use(OrcaExecutable { program: path as NonEmptyStr })
          }
        }
    }
  }
  if shell.Remove.RecursiveForce(path: temp.path as FilePath).success { result }
  else { ProcessRefused { exit_code: 1, stderr: concat("Orca realization cleanup failed at ", temp.path as String) } }
}

// THE SYSTEM PROFILES SHIP INSIDE THE PINNED ARCHIVE, so a profile named here is a fact of that one
// release and needs no second digest. Upstream layout (resources/profiles/BBL/<kind>/<name>.json):
// each file's `name` equals its file stem; `inherits` names the parent of the same kind; a child's
// keys replace the parent's; `instantiation` marks whether the profile is user-selectable.
// AppImage's runtime extracts a glob into ./squashfs-root of its working directory.
type OrcaProfileKind = OrcaMachineProfile | OrcaFilamentProfile | OrcaProcessProfile
fn orca_profile_kind_directory(k: OrcaProfileKind) -> String {
  match k { OrcaMachineProfile => "machine" OrcaFilamentProfile => "filament" OrcaProcessProfile => "process" }
}
data orca_bbl_profile_glob: NonEmptyStr = "resources/profiles/BBL/*"
fn orca_bbl_profile_path(extracted_into: String, kind: OrcaProfileKind, name: String) -> String {
  join([extracted_into, "/squashfs-root/resources/profiles/BBL/", orca_profile_kind_directory(k: kind), "/", name, ".json"], "")
}
fn orca_extract_bbl_profiles_command(executable: OrcaExecutable) -> ArgvCommand {
  argv_command(program: uncataloged_program(invocation: executable.program), arguments: ["--appimage-extract", orca_bbl_profile_glob as String])
}

// PROCESS SETTINGS AS ORCA READS THEM. Orca's process profile is a flat JSON object of strings; each
// key below has one physical meaning and unit, so a setting carries a measured value and the
// rendering to Orca's text lives here, beside the upstream it serializes for. Speeds are mm/s,
// accelerations mm/s^2, lengths mm, densities a percent with a trailing '%', layer counts integers.
type OrcaSpeedKey = OrcaOuterWallSpeed | OrcaInnerWallSpeed | OrcaSparseInfillSpeed | OrcaInternalSolidInfillSpeed | OrcaBridgeSpeed
type OrcaAccelerationKey = OrcaDefaultAcceleration | OrcaOuterWallAcceleration | OrcaInnerWallAcceleration
type OrcaLengthKey = OrcaBrimWidth | OrcaRaftFirstLayerExpansion
type OrcaCountKey = OrcaWallLoops | OrcaBottomShellLayers
type OrcaInfillPattern = OrcaGyroidInfill | OrcaCrosshatchInfill
type OrcaBrimType = OrcaOuterOnlyBrim | OrcaNoBrim
type OrcaBedType = OrcaTexturedPeiPlate | OrcaCoolPlate

type OrcaProcessSetting
  = OrcaSpeedSetting { key: OrcaSpeedKey, speed: MicrometrePerSecond }
  | OrcaAccelerationSetting { key: OrcaAccelerationKey, acceleration: MicrometrePerSecondSquared }
  | OrcaLengthSetting { key: OrcaLengthKey, length: Micrometer }
  | OrcaCountSetting { key: OrcaCountKey, count: Nat }
  | OrcaSparseInfillDensity { density: Percent }
  | OrcaSparseInfillPattern { pattern: OrcaInfillPattern }
  | OrcaBrimTypeSetting { brim: OrcaBrimType }
  | OrcaBedTypeSetting { bed: OrcaBedType }

fn orca_speed_key(k: OrcaSpeedKey) -> String {
  match k { OrcaOuterWallSpeed => "outer_wall_speed" OrcaInnerWallSpeed => "inner_wall_speed" OrcaSparseInfillSpeed => "sparse_infill_speed" OrcaInternalSolidInfillSpeed => "internal_solid_infill_speed" OrcaBridgeSpeed => "bridge_speed" }
}
fn orca_acceleration_key(k: OrcaAccelerationKey) -> String {
  match k { OrcaDefaultAcceleration => "default_acceleration" OrcaOuterWallAcceleration => "outer_wall_acceleration" OrcaInnerWallAcceleration => "inner_wall_acceleration" }
}
fn orca_length_key(k: OrcaLengthKey) -> String { match k { OrcaBrimWidth => "brim_width" OrcaRaftFirstLayerExpansion => "raft_first_layer_expansion" } }
fn orca_count_key(k: OrcaCountKey) -> String { match k { OrcaWallLoops => "wall_loops" OrcaBottomShellLayers => "bottom_shell_layers" } }

// Micro-unit counts render as exact decimals of the milli unit Orca reads (25000 um/s -> "25").
fn orca_milli_text(micro: Nat) -> String { exact_decimal_wire(d: ExactDecimal { units: micro as Int, fraction_digits: 3 }) }

fn orca_process_setting_kv(s: OrcaProcessSetting) -> JsonKeyValue {
  match s {
    OrcaSpeedSetting { key: k, speed: v } => json_kv(key: orca_speed_key(k: k), value: json_string(s: orca_milli_text(micro: micrometre_per_second_count(v: v))))
    OrcaAccelerationSetting { key: k, acceleration: a } => json_kv(key: orca_acceleration_key(k: k), value: json_string(s: orca_milli_text(micro: micrometre_per_second_squared_count(a: a))))
    OrcaLengthSetting { key: k, length: l } => json_kv(key: orca_length_key(k: k), value: json_string(s: orca_milli_text(micro: micrometer_count(m: l))))
    OrcaCountSetting { key: k, count: n } => json_kv(key: orca_count_key(k: k), value: json_string(s: to_string(n)))
    OrcaSparseInfillDensity { density: p } => json_kv(key: "sparse_infill_density", value: json_string(s: concat(to_string(percent_count(p: p)), "%")))
    OrcaSparseInfillPattern { pattern: p } => json_kv(key: "sparse_infill_pattern", value: json_string(s: match p { OrcaGyroidInfill => "gyroid" OrcaCrosshatchInfill => "crosshatch" }))
    OrcaBrimTypeSetting { brim: b } => json_kv(key: "brim_type", value: json_string(s: match b { OrcaOuterOnlyBrim => "outer_only" OrcaNoBrim => "no_brim" }))
    OrcaBedTypeSetting { bed: b } => json_kv(key: "curr_bed_type", value: json_string(s: match b { OrcaTexturedPeiPlate => "Textured PEI Plate" OrcaCoolPlate => "Cool Plate" }))
  }
}
