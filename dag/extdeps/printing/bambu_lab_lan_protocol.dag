module extdeps.printing.bambu_lab_lan_protocol

import std.types { Bool, String, NonEmptyStr, Port }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.oasis.mqtt { MqttEndpoint, MqttTopic, MqttOverTls, MqttQos, ExactlyOnce, AtLeastOnce }

// THE LAN CONTROL PROTOCOL OF BAMBU LAB PRINTERS IN LAN-ONLY MODE, modeled because the delivery leg
// already speaks FTPS and the leg that STARTS a job speaks MQTT -- and that second leg was
// previously actuated by a hand-written client outside the substrate, which is the out-of-band
// actuation DESIGN section 6 names.
//
// THIS IS NOT A PUBLISHED SPECIFICATION AND THE CITATION SAYS SO. Bambu documents LAN mode as a
// feature; the request topic and command payloads are established by the community-maintained
// reference and by observation of the machines this repository owns. Citing the vendor page as
// though it specified the wire format would attribute to a source a fact it does not contain, which
// is the nicknaming failure aimed at an authority rather than a symbol.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "wiki.bambulab.com/en/general/lan-mode"
  }
}

data bambu_lan_wire_reference: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/Doridian/OpenBambuAPI/blob/main/mqtt.md"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.printing.bambu_lab_lan_protocol",
      decl_name: "bambu_request_topic",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.printing.bambu_lab_lan_protocol.extdeps_external_authority_anchor,
  further_citations: [extdeps.printing.bambu_lab_lan_protocol.bambu_lan_wire_reference],
}

// THE TOPIC IS DERIVED FROM THE SERIAL, NEVER AUTHORED. A printer's request topic is
// "device/<serial>/request", so carrying the topic as its own datum would be a second spelling of
// the serial that drifts the moment a machine is replaced. The serial already lives in the fleet's
// physical inventory as an observed fact about a specific machine.
fn bambu_request_topic(serial: NonEmptyStr) -> MqttTopic {
  concat(concat("device/", serial as String), "/request") as MqttTopic
}

fn bambu_report_topic(serial: NonEmptyStr) -> MqttTopic {
  concat(concat("device/", serial as String), "/report") as MqttTopic
}

// THE LAN BROKER IS TLS ON 8883 WITH A CERTIFICATE THAT CANNOT BE CHAIN-VERIFIED, and that is stated
// rather than silently worked around. The printer presents a self-signed certificate for an IP
// address, so a verifying client refuses; this is the same peer-verification situation the FTPS leg
// already models and records, and it is a property of the DEVICE, not a preference of the caller.
data bambu_lan_mqtt_port: Port = 8883
data bambu_lan_mqtt_user: NonEmptyStr = "bblp"

fn bambu_lan_mqtt_endpoint(host: NonEmptyStr) -> MqttEndpoint {
  MqttEndpoint { host: host, port: bambu_lan_mqtt_port, security: MqttOverTls }
}

// THE START COMMAND NAMES A FILE ALREADY ON THE MACHINE. project_file does not carry the payload --
// the .3mf must already have been transferred, which is what the FTPS leg does -- so this command is
// meaningless unless delivery has completed, and the sequencing is a real dependency rather than a
// convention.
//
// use_ams IS FALSE BECAUSE THESE MACHINES HAVE NO AMS BOUND TO THIS PRINT. The operator's constraint
// is one filament per printer -- printer-01 white, printer-02 black -- which is exactly what the
// design wants, since the logo is a slot-in insert rather than a multi-colour feature.
type BambuPrintStartCommand {
  file_url: NonEmptyStr
  plate_gcode: NonEmptyStr
  subtask_name: NonEmptyStr
  use_ams: Bool
  bed_leveling: Bool
}

fn bambu_sd_file_url(remote_name: NonEmptyStr) -> NonEmptyStr {
  concat("file:///sdcard/", remote_name as String) as NonEmptyStr
}

// ONE PLATE, NAMED EXPLICITLY. A sliced Bambu project can carry several plates; the command must say
// which, and defaulting silently to the first would start whichever plate the slicer happened to
// order first rather than the one the caller meant.
data bambu_first_plate_gcode: NonEmptyStr = "Metadata/plate_1.gcode"

fn bambu_start_command(remote_name: NonEmptyStr) -> BambuPrintStartCommand {
  BambuPrintStartCommand {
    file_url: bambu_sd_file_url(remote_name: remote_name),
    plate_gcode: bambu_first_plate_gcode,
    subtask_name: remote_name,
    use_ams: false,
    bed_leveling: true,
  }
}

// A START COMMAND IS PUBLISHED AT LEAST ONCE, AND THE CHOICE IS ARGUED RATHER THAN INHERITED.
// AtMostOnce may be dropped silently by the broker, so a start command would never arrive and
// nothing would report why. ExactlyOnce is what a caller reaches for to avoid a duplicate job, but
// QoS 2 governs delivery of the PACKET and not the semantics of the ACTION, so choosing it would
// buy a guarantee that does not exist at the layer that matters -- and would read, at every call
// site, as an exactly-once print guarantee. AtLeastOnce is therefore the honest selection.
//
// THE DUPLICATE RISK IS REAL AND UNRESOLVED, AND SAYING OTHERWISE IS WHAT THIS PARAGRAPH USED TO DO.
// It claimed duplicate-start protection came from "the PRINTER's state machine refusing a second job
// while one is running, which is an external fact this module observes rather than assumes." Nothing
// here observed it. The cited wire reference establishes only that sequence_id is incremented and
// echoed back; it does not establish sequence-id deduplication or a refused second start. That was a
// justification supplied beside the thing it was meant to justify -- the same failure the netrc
// module records one directory over -- and it would have hardened into an accidental exactly-once
// guarantee that no layer provides.
//
// Nor is it cheaply measurable: the only test is to publish a second project_file while a job runs
// and watch, which IS the duplicated actuation the claim was supposed to rule out. So the two facts
// stay separate and the second stays open:
//   SUPPORTED -- one publish was accepted by the MQTT receiver.
//   NOT SUPPORTED -- that this publication can cause at most one project_file action.
// gunbc.fleet.printer_job_start therefore has no automatic retry on any arm, and its
// start_may_be_replayed is false everywhere. Reading device/<serial>/report can establish what the
// printer says happened; it cannot retroactively un-duplicate an actuation, which is why the wall is
// "never republish" rather than "republish if the report looks wrong".
data bambu_start_command_qos: MqttQos = AtLeastOnce

fn bambu_start_payload_json(command: BambuPrintStartCommand, sequence_id: NonEmptyStr) -> String {
  join([
    "{\"print\":{\"sequence_id\":\"", sequence_id as String,
    "\",\"command\":\"project_file\",\"param\":\"", command.plate_gcode as String,
    "\",\"url\":\"", command.file_url as String,
    "\",\"subtask_name\":\"", command.subtask_name as String,
    "\",\"use_ams\":", bool_json(b: command.use_ams),
    ",\"bed_leveling\":", bool_json(b: command.bed_leveling),
    ",\"flow_cali\":false,\"vibration_cali\":true,\"layer_inspect\":false,\"timelapse\":false,\"profile_id\":\"0\",\"project_id\":\"0\",\"subtask_id\":\"0\",\"task_id\":\"0\"}}"
  ], "")
}

fn bool_json(b: Bool) -> String {
  if b { "true" } else { "false" }
}

// THE PRINTER'S CERTIFICATE IS ISSUED BY A REAL CA, AND THE FIRST DRAFT OF THIS LEG ASSUMED
// OTHERWISE. The note above the endpoint said the machine presents a self-signed certificate that
// cannot be chain-verified, so the transport should skip verification the way the FTPS leg does.
// That was inference from the shape of the situation -- a consumer device on a LAN, addressed by IP
// -- and it is wrong. Measured: the leaf is CN=<serial>, its issuer is
// C=CN, O=BBL Technologies Co., Ltd, CN=BBL CA, and the printer serves the CA alongside it. What
// openssl reports as "self-signed certificate in certificate chain" is the ROOT being self-signed,
// which is true of every root CA and is not a statement about the leaf.
//
// So the honest transport VERIFIES, and the CA is pinned rather than trusted from the connection it
// is meant to verify. Trusting the CA the printer itself served would be circular: it would accept
// any peer that presented a consistent chain of its own making. The bundle is fetched from an
// independent distributor -- OrcaSlicer ships Bambu's printer CAs so its own LAN transport can
// verify them -- and the two were compared: the CA the printer served has SHA-256 fingerprint
// 03:0B:CA:81:CE:CE:18:B7:EF:F3:CF:D2:B7:5D:09:D3:EF:CA:89:3B:C0:69:60:9E:37:FA:04:25:7F:E4:D8:40,
// and a certificate with that exact fingerprint is present in the upstream bundle. The corroboration
// is what makes the pin real; without it the digest below would only record what this repository
// downloaded.
//
// THE REF IS A COMMIT, NOT A BRANCH. A raw URL naming `main` resolves to different bytes over time,
// so a digest pinned against it is a check that goes red on any upstream edit and tells the reader
// nothing about whether the change mattered. The commit is the last one to touch this path, and
// re-pinning is then a deliberate act with a diff to look at.
data bambu_printer_ca_bundle_source: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "raw.githubusercontent.com/OrcaSlicer/OrcaSlicer/4e99a042bb53694353bca343783f1c35c3c94656/resources/cert/printer.cer"
  }
}

data bambu_printer_ca_bundle_sha256: NonEmptyStr = "36f2bcee347ec7adce719b5fd350099591a4d3d0ec4e039c7019890d78e152a0"

data bambu_ca_measured_fingerprint_sha256: NonEmptyStr = "030BCA81CECE18B7EFF3CFD2B75D09D3EFCA893BC069609E37FA04257FE4D840"
