data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/mozilla/sccache/blob/main/docs/Configuration.md"
  }
}

data sccache_local_id: CacheInterfaceId = "sccache_local"

data sccache_releases_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "github.com/mozilla/sccache/releases" }
}

type SccacheBinaryRelease {
  version: NonEmptyStr
  digest_aarch64: Digest
  digest_x86_64: Digest
}

data sccache_release_0_15_0: SccacheBinaryRelease = SccacheBinaryRelease {
  version: "v0.15.0",
  digest_aarch64: sha256_digest(hex: "3a6a3712b49da3d263bf2d30d702de4302793016019e800bfb81c0c69401d8f8"),
  digest_x86_64: sha256_digest(hex: "782d2b5dd7ae0a55ebe368ab258114d0928d019ac2d949ab85d5d02f3926709e"),
}

data sccache_toolchain_capability: ToolchainCapability = ToolchainCapability {
  name: "sccache",
  version: "0.15.0",
  env_isolation: SharedHomeAcrossJobs,
  build_wrapper: Present { value: CtrlBuild },
  linked_cache_interface: Present { value: sccache_local_id },
}

data sccache_install_dissolution_trigger: String = "🟡 dissolve-on: sccache_install_script — the sccache binary install (curl release tarball + sha256sum -c verify + tar + mv to /usr/local/bin, cited to github.com/mozilla/sccache/releases with pinned v0.15.0 and per-arch sha256) is rendered as a POSIX shell provisioning sequence (medium-as-string); the SccacheBinaryRelease row is the typed authority for version and digests. DISSOLVES WHEN host_effect_apply binds a verified-download-plus-install effect (FetchAndVerify then InstallBinary) without the shell leaf."

data sccache_installed_binary_path_note: String = "Single authority for WHERE the cited release lands on a host. sccache_install_script writes it and every downstream consumer (the host-standup P1b systemd unit ExecStart, the PATH-shadow read-back check) reads it — so 'which sccache is the modeled one' has exactly one answer. Before this row the P1b provisioning path hand-rolled `apt-get install -y sccache` and a unit with ExecStart=/usr/bin/sccache while this module installed the pinned v0.15.0 tarball to /usr/local/bin: a §3 fork of one concept across two authorities, disagreeing on source, version, digest verification AND path, both firing on the same host (P1:runner-deploy-slot then P1b:build-cache-provision)."

data sccache_installed_binary_path: String = "/usr/local/bin/sccache"

fn sccache_install_script(rel: SccacheBinaryRelease, arch: NonEmptyStr, digest: Digest) -> String {
  let dir = join(["sccache-", rel.version as String, "-", arch as String, "-unknown-linux-musl"], "")
  let url = join(["https://github.com/mozilla/sccache/releases/download/", rel.version as String, "/", dir, ".tar.gz"], "")
  join([
    "set -e",
    join(["curl -fsSL '", url, "' -o /tmp/sccache.tar.gz"], ""),
    digest_shell_verify_line(digest: digest, file_path: "/tmp/sccache.tar.gz"),
    "tar -xzf /tmp/sccache.tar.gz -C /tmp",
    join(["sudo mv '/tmp/", dir, "/sccache' ", sccache_installed_binary_path], ""),
    join(["sudo chmod +x ", sccache_installed_binary_path], ""),
    join(["rm -rf /tmp/sccache.tar.gz '/tmp/", dir, "'"], ""),
    "",
  ], "\n")
}

data sccache_release_arch_selection_note: String = "The release row carries per-arch digests as two named fields, so selecting one by hand is how a caller pins an arch (runner_host_sccache_provision_aarch64). These two selectors make the choice a total function of the modeled Architecture coproduct instead: every arch the cited release does NOT publish a musl tarball for returns Absent, so an unsupported host REFUSES rather than silently receiving an aarch64 binary. Fail-closed by construction (§5) — there is no default arm."

fn sccache_release_arch_token(arch: Architecture) -> NonEmptyStr? {
  match arch {
    Aarch64 => Present { value: "aarch64" as NonEmptyStr }
    X86_64 => Present { value: "x86_64" as NonEmptyStr }
    X86 => none
    Arm => none
    Armv7 => none
    Mips => none
    Mipsel => none
    Mips64 => none
    Mips64el => none
    Riscv64 => none
    Wasm32 => none
  }
}

fn sccache_release_digest(rel: SccacheBinaryRelease, arch: Architecture) -> Digest? {
  match arch {
    Aarch64 => Present { value: rel.digest_aarch64 }
    X86_64 => Present { value: rel.digest_x86_64 }
    X86 => none
    Arm => none
    Armv7 => none
    Mips => none
    Mipsel => none
    Mips64 => none
    Mips64el => none
    Riscv64 => none
    Wasm32 => none
  }
}

data sccache_fatal_error_log_fragment: String = "sccache: encountered fatal error"

data sccache_rustc_wrapper_exit_254_log_fragment: String = "(exit status: 254)"

data sccache_failed_to_execute_compile_log_fragment: String = "sccache: error: failed to execute compile"

data sccache_misconfigured_log_fragments_note: String = "The cited roster of stdout/stderr fragments that mean 'the daemon answered, but it is misconfigured' — as a LIST, so a consumer classifying an observation folds over it. The three rows above were previously read one-by-one by a hand-unrolled if/elif chain in the host-standup provisioning emitter, which meant citing a fourth fragment here required an edit there too (the emitter naming a concept it does not own). Consumers iterate this roster; adding a row costs zero emitter edits."

data sccache_misconfigured_log_fragments: List<String> = [
  sccache_fatal_error_log_fragment,
  sccache_rustc_wrapper_exit_254_log_fragment,
  sccache_failed_to_execute_compile_log_fragment,
]

data sccache_server_lifetime_note: String = "sccache's server EXITS ON ITS OWN. Three environment knobs, all documented by the module's cited authority extdeps_external_authority_anchor (github.com/mozilla/sccache/blob/main/docs/Configuration.md), decide the process lifetime a supervisor sees, and they are modeled here because they are facts about SCCACHE — not about systemd, and not about gunbc. Before 2026-07-25 the P1b unit emitter spelled SCCACHE_START_SERVER=1 / SCCACHE_NO_DAEMON=1 as bare literals of its own, which made gunbc.host_build_cache_provision_script a SECOND authority for sccache's environment vocabulary (§3) — and the knob that was missing from that second authority is exactly the one that broke: SCCACHE_IDLE_TIMEOUT. Cited text: 'how long the local daemon process waits for more client requests before exiting, in seconds. Set to 0 to run sccache permanently.' The default is 600 seconds, confirmed by execution rather than read off the doc: on srv3 2026-07-25 the foreground-supervised unit started at 06:28:47 UTC, served no compile request, and EXITED 0 after `Duration: 10min 8.215s`, leaving `inactive (dead)` — Restart=on-failure could not fire because the exit was a success. Consequence for any supervisor: a Type=simple unit whose ExecStart is sccache is only durable when the idle timeout is disabled; otherwise it dies on the first quiet ten minutes and the host reverts to sccache's own unsupervised per-invocation auto-start (the very no-op state the foreground form was introduced to remove). The srv1/srv2 production ctrl-sccache.service does not set this knob either — its month-plus uptime is CI traffic keeping the daemon below the idle threshold, i.e. accidental coverage, not a durable unit; that is a fact about the observed hosts, so this row is a DEDUCTION from the cited doc and the srv3 receipt, not a swap toward production."

data sccache_start_server_env_var: String = "SCCACHE_START_SERVER"

data sccache_no_daemon_env_var: String = "SCCACHE_NO_DAEMON"

data sccache_idle_timeout_env_var: String = "SCCACHE_IDLE_TIMEOUT"

data sccache_idle_timeout_never_value_note: String = "The value whose MEANING is 'never exit', which is why it is a named row rather than a literal inside the assignment: '0' is not an ordinary duration on this axis (a zero-second idle timeout would mean the opposite), it is the cited doc's sentinel for running permanently. A future consumer that wants a bounded lifetime supplies its own seconds value; a consumer that wants a supervised daemon reads THIS row."

data sccache_idle_timeout_never_value: String = "0"

fn sccache_start_server_env_assignment() -> String {
  join([sccache_start_server_env_var, "=1"], "")
}

fn sccache_no_daemon_env_assignment() -> String {
  join([sccache_no_daemon_env_var, "=1"], "")
}

fn sccache_idle_timeout_never_env_assignment() -> String {
  join([sccache_idle_timeout_env_var, "=", sccache_idle_timeout_never_value], "")
}

data sccache_local_facts: CacheInterfaceCatalogFacts = {
  identity: sccache_local_id
  backing_surface: "sccache-local-disk"
  transport_encoding: SccacheInternalEncoding
  key_derivation: {

    key_inputs: NativeInternal { cited_inputs: [RustcInvocation, ToolchainSpec] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Org
    invalidation_triggers: [ManualPurge, ToolchainChange]
  }
  io: {
    lookup_semantics: NativeInternalLookup
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: RawBytes
    locality: PerHostFilesystem

    eviction: Lru
    atomicity: WriteThenRename
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: ReadYourWrites
  }
  evidence: [
    {
      field: "lookup_semantics"
      evidence: VendorCitation {
        source: "sccache storage backends"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md"
      }
    },
    {
      field: "eviction"
      evidence: VendorCitation {
        source: "sccache cache size and LRU eviction policy"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md#cache-size"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: VendorCitation {
        source: "sccache src/cache/disk.rs DiskCache::get/get_raw read the file at make_key_path(key) and return it as Cache::Hit with no hash/checksum/size check against the cache key or a stored digest. The gap is a FORMAT gap, not a missing check: src/cache/cache_io.rs's CacheWrite/CacheRead archive (a ZipWriter/ZipArchive of zstd-compressed per-object entries) carries no digest/checksum field anywhere in its write or read path, so content_verified_on_read cannot be made true for this backend by any read-side config change alone; it would require a store-time digest to be added to the entry format first. ZIP central-directory parsing at ZipArchive::new() validates archive-level structure and fails loudly on a torn archive, but a single entry whose payload is a well-formed zero-length zstd stream deserializes cleanly — the exact shape that lets a build exit 0 while one served object is silently empty, nested inside an otherwise well-formed archive"
        url: "https://github.com/mozilla/sccache/blob/main/src/cache/disk.rs"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: VendorCitation {
        source: "sccache issue #916 (lru_disk_cache footgun: files can be silently corrupted with no enforcement) and #2122 (sccache-dist: cache can end up somehow corrupted, no read-time detection) corroborate the missing read verification observed in gunbc CI as a zero-byte artifact served on a reported cache hit (runs 29855292758 et al)"
        url: "https://github.com/mozilla/sccache/issues/916"
      }
    },
    {
      field: "atomicity"
      evidence: VendorCitation {
        source: "CONFIRMED: DiskCache::put_raw (src/cache/disk.rs) calls LruDiskCache::prepare_add, which stages the write via tempfile::Builder::tempfile_in(&self.root); LruDiskCache::commit finalizes with NamedTempFile::persist(path) (a rename()) — write-to-tempfile-then-rename, genuinely atomic for the put/put_raw path sccache's DiskCache uses. (The underlying lru_disk_cache crate also exposes a separate direct-write insert_by/insert_bytes/insert_file/insert_with API with no tempfile staging, but DiskCache::put_raw does not call it.) Atomicity on write is real and is not the source of the zero-byte-serve defect — the defect is the missing store-time digest (see content_verified_on_read evidence above), which a torn write would not explain since ZIP-open validates archive structure and fails loudly on truncation"
        url: "https://github.com/mozilla/sccache/blob/main/src/lru_disk_cache/mod.rs"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: RunnerObserved {
        receipt: "Hermetic scratch-SCCACHE_DIR reproduction (2026-07-21, sccache 0.15.0, local disk backend): `sccache cc -c trivial.c -o trivial.o` on a fresh scratch cache produced a real cache miss and wrote a well-formed cache entry (a single-member ZIP, member 'obj', ZIP_STORED, holding zstd-compressed object bytes). The 'obj' member's stored payload was spliced (via libzstd.so.1 ZSTD_compress of a zero-length input, producing the genuine 9-byte empty zstd frame 28b52ffd2000010000) for a well-formed empty object, leaving the ZIP container itself untouched and structurally valid. Re-running the IDENTICAL `sccache cc` invocation against this doctored entry reported `Cache hits: 1`, `Cache misses: 0`, exit code 0, and wrote a genuine 0-byte trivial.o — reproducing exactly the CI incident (runs 29855292758 et al: content_verified_on_read=true falsified by a zero-byte artifact served on a reported cache hit). No SCCACHE server restart or config change was needed to make the read path serve it; confirms content_verified_on_read: false is correct, not merely plausible from source reading"
        observed_at: "2026-07-21"
      }
    },
  ]
}
