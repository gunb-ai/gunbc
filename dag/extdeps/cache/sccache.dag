module extdeps.cache.sccache

import extdeps.cache.types {
  CacheInterfaceCatalogFacts,
  NativeInternal,
  RustcInvocation,
  ToolchainSpec,
  SccacheInternalEncoding,
}
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  NativeInternalLookup,
  OverwriteAllowed,
  WriteThenRename,
  MissThenCreate,
  RawBytes,
  PerHostFilesystem,
  Lru,
  FilesystemPerms,
  LocalDiskUs,
  ReadYourWrites,
  VendorCitation,
  CacheEvidence,
  RunnerObserved,
  ManualPurge,
  ToolchainChange,
  Org,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/mozilla/sccache/blob/main/docs/Configuration.md"
  }
}

data sccache_local_id: CacheInterfaceId = "sccache_local"

data sccache_server_process_model_doc: String = "sccache is a client/server tool: the client auto-spawns a server on first use if none is listening, the server survives the client that spawned it, and CACHE MISSES ARE COMPILED BY THE SERVER — rustc runs as a CHILD OF THE SERVER PROCESS, not of the invoking client. Consequence (load-bearing for host budgeting): the server's cgroup IS the cgroup every cache-miss compile on the host executes in, so a server that was lazily spawned inside some job's cgroup makes that job's memory caps bound EVERY subsequent compile on the host, including compiles issued by other jobs. SCCACHE_IDLE_TIMEOUT=0 disables the idle shutdown, so such a mis-placed server survives indefinitely."

data sccache_server_port_doc: String = "The sccache SERVER listens on a TCP port on loopback, configured by SCCACHE_SERVER_PORT (default 4226). This is the only precise way to identify the server process: the sccache BINARY is also the client, so when it is used as RUSTC_WRAPPER every in-flight compile has a process named 'sccache' too. Selecting by process name alone cannot distinguish server from client and would read a transient client's cgroup."

data sccache_server_default_port: Int = 4226

type SccacheServerSpawn
  = ClientAutoSpawned
  | UnitStarted

type SccacheServerProcessFacts {
  spawn: SccacheServerSpawn
  idle_timeout_zero_disables_shutdown: Bool
  compiles_execute_as_server_children: Bool
  server_port: Int
  evidence: List<CacheEvidence>
}

data sccache_server_process_facts: SccacheServerProcessFacts = {
  spawn: ClientAutoSpawned
  idle_timeout_zero_disables_shutdown: true
  compiles_execute_as_server_children: true
  server_port: sccache_server_default_port
  evidence: [
    {
      field: "spawn"
      evidence: VendorCitation {
        source: "sccache client starts a server process if one is not already running"
        url: "https://github.com/mozilla/sccache/blob/main/README.md#usage"
      }
    },
    {
      field: "idle_timeout_zero_disables_shutdown"
      evidence: VendorCitation {
        source: "SCCACHE_IDLE_TIMEOUT: seconds the server waits before shutting down; 0 disables shutdown entirely"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md"
      }
    },
    {
      field: "compiles_execute_as_server_children"
      evidence: VendorCitation {
        source: "sccache server performs the compilation on a cache miss; the compiler subprocess is a child of the server"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Architecture.md"
      }
    },
    {
      field: "server_port"
      evidence: VendorCitation {
        source: "SCCACHE_SERVER_PORT sets the port the sccache server listens on; defaults to 4226"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md"
      }
    },
  ]
}

data sccache_fatal_error_log_fragment: String = "sccache: encountered fatal error"

data sccache_rustc_wrapper_exit_254_log_fragment: String = "(exit status: 254)"

data sccache_failed_to_execute_compile_log_fragment: String = "sccache: error: failed to execute compile"

data sccache_local_facts: CacheInterfaceCatalogFacts = {
  identity: sccache_local_id
  backing_surface: "sccache-local-disk"
  transport_encoding: SccacheInternalEncoding
  key_derivation: {

    key_inputs: NativeInternal { cited_inputs: [RustcInvocation, ToolchainSpec] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Org
    invalidation_triggers: [ManualPurge, ToolchainChange]
  }
  io: {
    lookup_semantics: NativeInternalLookup
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: RawBytes
    locality: PerHostFilesystem

    eviction: Lru
    atomicity: WriteThenRename
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: ReadYourWrites
  }
  evidence: [
    {
      field: "lookup_semantics"
      evidence: VendorCitation {
        source: "sccache storage backends"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md"
      }
    },
    {
      field: "eviction"
      evidence: VendorCitation {
        source: "sccache cache size and LRU eviction policy"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md#cache-size"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: VendorCitation {
        source: "sccache src/cache/disk.rs DiskCache::get/get_raw read the file at make_key_path(key) and return it as Cache::Hit with no hash/checksum/size check against the cache key or a stored digest. The gap is a FORMAT gap, not a missing check: src/cache/cache_io.rs's CacheWrite/CacheRead archive (a ZipWriter/ZipArchive of zstd-compressed per-object entries) carries no digest/checksum field anywhere in its write or read path, so content_verified_on_read cannot be made true for this backend by any read-side config change alone; it would require a store-time digest to be added to the entry format first. ZIP central-directory parsing at ZipArchive::new() validates archive-level structure and fails loudly on a torn archive, but a single entry whose payload is a well-formed zero-length zstd stream deserializes cleanly — the exact shape that lets a build exit 0 while one served object is silently empty, nested inside an otherwise well-formed archive"
        url: "https://github.com/mozilla/sccache/blob/main/src/cache/disk.rs"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: VendorCitation {
        source: "sccache issue #916 (lru_disk_cache footgun: files can be silently corrupted with no enforcement) and #2122 (sccache-dist: cache can end up somehow corrupted, no read-time detection) corroborate the missing read verification observed in gunbc CI as a zero-byte artifact served on a reported cache hit (runs 29855292758 et al)"
        url: "https://github.com/mozilla/sccache/issues/916"
      }
    },
    {
      field: "atomicity"
      evidence: VendorCitation {
        source: "CONFIRMED: DiskCache::put_raw (src/cache/disk.rs) calls LruDiskCache::prepare_add, which stages the write via tempfile::Builder::tempfile_in(&self.root); LruDiskCache::commit finalizes with NamedTempFile::persist(path) (a rename()) — write-to-tempfile-then-rename, genuinely atomic for the put/put_raw path sccache's DiskCache uses. (The underlying lru_disk_cache crate also exposes a separate direct-write insert_by/insert_bytes/insert_file/insert_with API with no tempfile staging, but DiskCache::put_raw does not call it.) Atomicity on write is real and is not the source of the zero-byte-serve defect — the defect is the missing store-time digest (see content_verified_on_read evidence above), which a torn write would not explain since ZIP-open validates archive structure and fails loudly on truncation"
        url: "https://github.com/mozilla/sccache/blob/main/src/lru_disk_cache/mod.rs"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: RunnerObserved {
        receipt: "Hermetic scratch-SCCACHE_DIR reproduction (2026-07-21, sccache 0.15.0, local disk backend): `sccache cc -c trivial.c -o trivial.o` on a fresh scratch cache produced a real cache miss and wrote a well-formed cache entry (a single-member ZIP, member 'obj', ZIP_STORED, holding zstd-compressed object bytes). The 'obj' member's stored payload was spliced (via libzstd.so.1 ZSTD_compress of a zero-length input, producing the genuine 9-byte empty zstd frame 28b52ffd2000010000) for a well-formed empty object, leaving the ZIP container itself untouched and structurally valid. Re-running the IDENTICAL `sccache cc` invocation against this doctored entry reported `Cache hits: 1`, `Cache misses: 0`, exit code 0, and wrote a genuine 0-byte trivial.o — reproducing exactly the CI incident (runs 29855292758 et al: content_verified_on_read=true falsified by a zero-byte artifact served on a reported cache hit). No SCCACHE server restart or config change was needed to make the read path serve it; confirms content_verified_on_read: false is correct, not merely plausible from source reading"
        observed_at: "2026-07-21"
      }
    },
  ]
}
