module extdeps.cache.sccache

import extdeps.cache.types {
  CacheInterfaceCatalogFacts,
  NativeInternal,
  RustcInvocation,
  ToolchainSpec,
  SccacheInternalEncoding,
}
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  NativeInternalLookup,
  OverwriteAllowed,
  WriteThenRename,
  MissThenCreate,
  RawBytes,
  PerHostFilesystem,
  Lru,
  FilesystemPerms,
  LocalDiskUs,
  ReadYourWrites,
  VendorCitation,
  ManualPurge,
  ToolchainChange,
  Org,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.types { NonEmptyStr, String, List }
import extdeps.toolchain.types { ToolchainCapability, SharedHomeAcrossJobs, CtrlBuild }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/mozilla/sccache/blob/main/docs/Configuration.md"
  }
}

data sccache_local_id: CacheInterfaceId = "sccache_local"

data sccache_releases_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "github.com/mozilla/sccache/releases" }
}

type SccacheBinaryRelease {
  version: NonEmptyStr
  sha256_aarch64: NonEmptyStr
  sha256_x86_64: NonEmptyStr
}

data sccache_release_0_15_0: SccacheBinaryRelease = SccacheBinaryRelease {
  version: "v0.15.0",
  sha256_aarch64: "3a6a3712b49da3d263bf2d30d702de4302793016019e800bfb81c0c69401d8f8",
  sha256_x86_64: "782d2b5dd7ae0a55ebe368ab258114d0928d019ac2d949ab85d5d02f3926709e",
}

data sccache_toolchain_capability: ToolchainCapability = ToolchainCapability {
  name: "sccache",
  version: "0.15.0",
  env_isolation: SharedHomeAcrossJobs,
  build_wrapper: Present { value: CtrlBuild },
  linked_cache_interface: Present { value: sccache_local_id },
}

data sccache_install_dissolution_trigger: String = "🟡 dissolve-on: sccache_install_script — the sccache binary install (curl release tarball + sha256sum -c verify + tar + mv to /usr/local/bin, cited to github.com/mozilla/sccache/releases with pinned v0.15.0 and per-arch sha256) is rendered as a POSIX shell provisioning sequence (medium-as-string); the SccacheBinaryRelease row is the typed authority for version and digests. DISSOLVES WHEN host_effect_apply binds a verified-download-plus-install effect (FetchAndVerify then InstallBinary) without the shell leaf."

fn sccache_install_script(rel: SccacheBinaryRelease, arch: NonEmptyStr, sha256: NonEmptyStr) -> String {
  let dir = join(["sccache-", rel.version as String, "-", arch as String, "-unknown-linux-musl"], "")
  let url = join(["https://github.com/mozilla/sccache/releases/download/", rel.version as String, "/", dir, ".tar.gz"], "")
  join([
    "set -e",
    join(["curl -fsSL '", url, "' -o /tmp/sccache.tar.gz"], ""),
    join(["echo '", sha256 as String, "  /tmp/sccache.tar.gz' | sha256sum -c -"], ""),
    "tar -xzf /tmp/sccache.tar.gz -C /tmp",
    join(["sudo mv '/tmp/", dir, "/sccache' /usr/local/bin/sccache"], ""),
    "sudo chmod +x /usr/local/bin/sccache",
    join(["rm -rf /tmp/sccache.tar.gz '/tmp/", dir, "'"], ""),
    "",
  ], "\n")
}

data sccache_fatal_error_log_fragment: String = "sccache: encountered fatal error"

data sccache_rustc_wrapper_exit_254_log_fragment: String = "(exit status: 254)"

data sccache_failed_to_execute_compile_log_fragment: String = "sccache: error: failed to execute compile"

data sccache_local_facts: CacheInterfaceCatalogFacts = {
  identity: sccache_local_id
  backing_surface: "sccache-local-disk"
  transport_encoding: SccacheInternalEncoding
  key_derivation: {

    key_inputs: NativeInternal { cited_inputs: [RustcInvocation, ToolchainSpec] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: Org
    invalidation_triggers: [ManualPurge, ToolchainChange]
  }
  io: {
    lookup_semantics: NativeInternalLookup
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: RawBytes
    locality: PerHostFilesystem

    eviction: Lru
    atomicity: WriteThenRename
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: ReadYourWrites
  }
  evidence: [
    {
      field: "lookup_semantics"
      evidence: VendorCitation {
        source: "sccache storage backends"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md"
      }
    },
    {
      field: "eviction"
      evidence: VendorCitation {
        source: "sccache cache size and LRU eviction policy"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md#cache-size"
      }
    },
  ]
}
