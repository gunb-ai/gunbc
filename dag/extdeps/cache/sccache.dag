data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/mozilla/sccache/blob/main/docs/Configuration.md"
  }
}

data sccache_local_id: CacheInterfaceId = "sccache_local"

data sccache_releases_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "github.com/mozilla/sccache/releases" }
}

type SccacheBinaryRelease {
  version: NonEmptyStr
  digest_aarch64: Digest
  digest_x86_64: Digest
}

// For multi-artifact releases the pin SUBJECT is the ARTIFACT (release x platform), not the release
// row alone (review 44662, feature:pin-artifact-grain). SccacheBinaryRelease carries two cited
// digests because one GitHub release publishes two musl tarballs; Pin.expected_identity is one
// ContentHash, so Pin<SccacheBinaryRelease> was ambiguous about which tarball it pinned.
// SccacheBinaryArtifact is the release x published-musl-arch product: one cited digest per row,
// projected from the release's named digest_aarch64 / digest_x86_64 fields — never re-minted.
// SccachePublishedMuslArch is a CLOSED two-arm coproduct (SccacheMuslAarch64 | SccacheMuslX86_64)
// so unsupported extdeps.toolchain.types.Architecture variants are UNWRITABLE on the carrier rather
// than admitted and refused later (review 44866, DESIGN section 5 construction). Distinct variant
// names avoid the typechecker fork where reusing Aarch64 | X86_64 as a separate coproduct collided
// with Architecture; sccache_published_musl_arch_of is the Architecture→SccachePublishedMuslArch
// projection (Present only for published musl arches) used by sccache_binary_artifact_for_arch and
// sccache_release_digest consumers. CpuArchitecture and TargetArchitecture in std are
// byte-identical forks (DESIGN section 3) and are deliberately NOT imported here.

type SccachePublishedMuslArch = SccacheMuslAarch64 | SccacheMuslX86_64

fn sccache_published_musl_arch_key_of(arch: SccachePublishedMuslArch) -> NonEmptyStr {
  match arch {
    SccacheMuslAarch64 => "aarch64" as NonEmptyStr
    SccacheMuslX86_64 => "x86_64" as NonEmptyStr
  }
}

fn sccache_published_musl_arch_of(arch: Architecture) -> SccachePublishedMuslArch? {
  match arch {
    Aarch64 => Present { value: SccacheMuslAarch64 }
    X86_64 => Present { value: SccacheMuslX86_64 }
    X86 => none
    Arm => none
    Armv7 => none
    Mips => none
    Mipsel => none
    Mips64 => none
    Mips64el => none
    Riscv64 => none
    Wasm32 => none
  }
}

type SccacheBinaryArtifact {
  binary_release: SccacheBinaryRelease
  arch: SccachePublishedMuslArch
}

fn sccache_binary_artifact_for_arch(
  binary_release: SccacheBinaryRelease,
  arch: Architecture,
) -> SccacheBinaryArtifact? {
  match sccache_published_musl_arch_of(arch: arch) {
    Present { value: published } =>
      Present {
        value: SccacheBinaryArtifact {
          binary_release: binary_release,
          arch: published,
        }
      }
    Absent => none
  }
}

fn sccache_binary_artifact_authority_digest(artifact: SccacheBinaryArtifact) -> Digest {
  match artifact.arch {
    SccacheMuslAarch64 => artifact.binary_release.digest_aarch64
    SccacheMuslX86_64 => artifact.binary_release.digest_x86_64
  }
}

fn sccache_binary_artifact_content_identity(artifact: SccacheBinaryArtifact) -> ContentHash? {
  sha256_digest_content_hash(
    digest: sccache_binary_artifact_authority_digest(artifact: artifact),
  )
}

data sccache_release_0_15_0: SccacheBinaryRelease = SccacheBinaryRelease {
  version: "v0.15.0",
  digest_aarch64: sha256_digest(hex: "3a6a3712b49da3d263bf2d30d702de4302793016019e800bfb81c0c69401d8f8"),
  digest_x86_64: sha256_digest(hex: "782d2b5dd7ae0a55ebe368ab258114d0928d019ac2d949ab85d5d02f3926709e"),
}

data sccache_toolchain_capability: ToolchainCapability = ToolchainCapability {
  name: "sccache",
  version: "0.15.0",
  env_isolation: SharedHomeAcrossJobs,
  linked_cache_interface: Present { value: sccache_local_id },
}

// THE RETIREMENT OBLIGATION IS DISCHARGED, NOT CARRIED. The installer this module used to expose
// (`sccache_install_script`) is deleted from this tree, and its trigger went with the declaration --
// a retirement obligation whose declaration no longer exists is complete, and a trigger citing an
// absent declaration is exactly the dead vocabulary this repository removes (same disposition as
// `configfs_op_render_dissolution_trigger` in e52f9d20e3f). The effect the trigger named is now
// what runs: gunbc.host.verified_binary_install performs FetchAndVerify (extdeps.tools.curl
// `curl_download_command`, then the digest observation `sha256sum_file_command` gated by
// `verified_binary_install_admission`) and only then InstallBinary (extdeps.tools.tar
// `tar_extract_command`, the move and mode through extdeps.tools.gnu_coreutils /
// extdeps.tools.chmod, elevated by extdeps.sudo.elevation's non-interactive sudo, then
// extdeps.tools.gnu_coreutils `rm_recursive_force_command` cleanup), with the binary-presence
// precondition kept as a `test -x` OBSERVATION (extdeps.posix.test_utility). Sccache's url, digest,
// archive member, destination, mode and privilege are PARAMETERS supplied by
// gunbc.host.sccache_verified_install, which composes them from the `SccacheBinaryRelease` row and
// `sccache_installed_binary_path` below -- so this module still owns sccache's values and now owns
// no shell text. The discharge is recorded in
// dag/test/claim/dissolution_census_mechanism_witness.dag rather than silently dropped.

// Single authority for WHERE the cited release lands on a host. The verified download-plus-install
// effect writes it (via its `dest_path` parameter, supplied by gunbc.host.sccache_verified_install);
// and every downstream consumer (the host-standup P1b systemd unit ExecStart, the PATH-shadow
// read-back check) reads it — so 'which sccache is the modeled one' has exactly one answer. Before
// this row the P1b provisioning path hand-rolled `apt-get install -y sccache` and a unit with
// ExecStart=/usr/bin/sccache while this module installed the pinned v0.15.0 tarball to
// /usr/local/bin: a §3 fork of one concept across two authorities, disagreeing on source, version,
// digest verification AND path, both firing on the same host (P1:runner-deploy-slot then
// P1b:build-cache-provision).

data sccache_installed_binary_path: String = "/usr/local/bin/sccache"

// These names are part of sccache's cited configuration interface, not facts invented by the
// systemd renderer or by the readiness observer. Keeping the names here lets both consumers compose
// assignments and reads from one authority.
data sccache_cache_dir_env_var: NonEmptyStr = "SCCACHE_DIR" as NonEmptyStr
data sccache_cache_size_env_var: NonEmptyStr = "SCCACHE_CACHE_SIZE" as NonEmptyStr
data sccache_server_uds_env_var: NonEmptyStr = "SCCACHE_SERVER_UDS" as NonEmptyStr

// The release row carries per-arch digests as two named fields, so selecting one by hand is how a
// caller pins an arch (runner_host_sccache_provision_aarch64). These two selectors make the choice
// a total function of the modeled Architecture coproduct instead: every arch the cited release does
// NOT publish a musl tarball for returns Absent, so an unsupported host REFUSES rather than
// silently receiving an aarch64 binary. Fail-closed by construction (§5) — there is no default arm.

fn sccache_release_arch_token(arch: Architecture) -> NonEmptyStr? {
  match arch {
    Aarch64 => Present { value: "aarch64" as NonEmptyStr }
    X86_64 => Present { value: "x86_64" as NonEmptyStr }
    X86 => none
    Arm => none
    Armv7 => none
    Mips => none
    Mipsel => none
    Mips64 => none
    Mips64el => none
    Riscv64 => none
    Wasm32 => none
  }
}

fn sccache_release_digest(rel: SccacheBinaryRelease, arch: Architecture) -> Digest? {
  match arch {
    Aarch64 => Present { value: rel.digest_aarch64 }
    X86_64 => Present { value: rel.digest_x86_64 }
    X86 => none
    Arm => none
    Armv7 => none
    Mips => none
    Mipsel => none
    Mips64 => none
    Mips64el => none
    Riscv64 => none
    Wasm32 => none
  }
}

// sccache is a client/server tool: the client auto-spawns a server on first use if none is
// listening, the server survives the client that spawned it, and CACHE MISSES ARE COMPILED BY THE
// SERVER — rustc runs as a CHILD OF THE SERVER PROCESS, not of the invoking client. Consequence
// (load-bearing for host budgeting): the server's cgroup IS the cgroup every cache-miss compile on
// the host executes in, so a server that was lazily spawned inside some job's cgroup makes that
// job's memory caps bound EVERY subsequent compile on the host, including compiles issued by other
// jobs. SCCACHE_IDLE_TIMEOUT=0 disables the idle shutdown, so such a mis-placed server survives
// indefinitely.

// The SERVER is identified positively as the process HOLDING THE LISTEN on the configured endpoint
// — never by process name. The sccache binary is both client and server, so under RUSTC_WRAPPER
// every in-flight compile also runs a process named 'sccache'; selecting by name samples a
// transient client and reads the WRONG cgroup. Upstream exposes two mutually exclusive endpoint
// realizations: SCCACHE_SERVER_PORT (loopback TCP, default 4226) and SCCACHE_SERVER_UDS (a
// Unix-domain socket path). Modeling only the port would be a nickname for one realization (DESIGN
// section 3): the gunbc fleet configures the UDS form, so a port-only probe finds no listener at
// all. Observed live on srv1 2026-08-01: no TCP 4226 listener exists, while
// /var/lib/ctrl/sccache-ci/server.sock is held LISTEN by the CI server and
// /var/lib/ctrl/sccache/server.sock by the session server — endpoint ownership is what
// distinguished them.

data sccache_server_default_tcp_port: Int = 4226

type SccacheServerEndpoint
  = SccacheServerTcpPort { port: Int }
  | SccacheServerUnixSocket { path: NonEmptyStr }

type SccacheServerSpawn
  = ClientAutoSpawned
  | UnitStarted

data sccache_stats_query_does_not_spawn_note: String = "MEASURED CORRECTION, 2026-08-01: `--show-stats` does NOT auto-start a server, and the widely-repeated claim that 'any sccache invocation auto-starts a server, so --show-stats manufactures the evidence it reports' is FALSE for sccache 0.15.0. Two controls on srv2, each with a PRIVATE cache dir AND a private endpoint so the falsifier could not touch production: with SCCACHE_SERVER_UDS the socket did not exist before or after the call; with a private SCCACHE_SERVER_PORT the listener count was 0 before and 0 after. In both the call returned rc=0 and printed a fully-formed table of ZEROES. A third control isolated what DOES spawn: one real compile (`sccache /usr/bin/gcc -c t.c`) through the same private port took the listener count 0 -> 1, and the new server inherited the INVOKING process's cgroup (observed: the caller's own session scope). THE DEFECT IS REAL BUT DIFFERENTLY SHAPED, and the difference changes the remedy's justification rather than the remedy: --show-stats answers plausibly WITHOUT a server existing at all, so a read-back that converges on it greens over a host with no durable daemon — a fabricated plausible output (DESIGN section 5), which is exactly what srv3 exhibited on 2026-07-25 (a full stats table while the unit had been inactive six hours). The observation there was right; the inference drawn from it — that the call had created a server — was wrong. Consequence for the observer: stats is supplemental data gathered AFTER ownership is independently established, never the thing that establishes it; and the auto-spawn wall belongs on the COMPILE path, which is where a client actually creates a server in its own cgroup."

// THE STATS QUERY AS ONE TYPED ARGV, for the host-effect realizer's build-cache ensure
// (gunbc.host.build_cache_daemon_ensure), which until now could only ask the question by running the
// five-line bash body build_cache_provision_shell_script concatenated. ONE argv, no shell: `test -x`
// and `--show-stats` are the two commands the script's observe phase ran, and both were reachable only
// through `$(...)` capture plus a `printf` receipt that a LATER phase grepped back out of its own
// stdout. That middleman is what put the observation in the shell; the operations themselves never
// needed it.
//
// THE FLAG'S MEANING AND ITS MEASURED BEHAVIOUR ARE DIFFERENT CLAIMS AND ARE CITED SEPARATELY. The
// vendor doc says what the flag is for; what rc it returns and what it prints when NO SERVER EXISTS AT
// ALL is recorded by sccache_stats_query_does_not_spawn_note (RunnerObserved, srv2 2026-08-01, 0.15.0,
// two private-endpoint controls) and by sccache_server_process_facts.stats_query_spawns_server: false.
// The builder deliberately does NOT encode rc semantics: a command builder that returns "success" would
// be asserting a fact the measured note says is unreliable, and it is the CALLER's classification that
// interprets the exit status (and, per the note, must not treat a zero here as ownership).
fn sccache_stats_query_command(binary: NonEmptyStr) -> ArgvCommand {
  argv_command(
    program: uncataloged_program(invocation: binary),
    arguments: [sccache_stats_query_flag as String],
  )
}

// THE FLAG, HOISTED so the three sites that need the same spelling (this builder, the script it
// replaces, and the witness that pins the argv) cannot drift apart by spelling it twice.
data sccache_stats_query_flag: NonEmptyStr = "--show-stats" as NonEmptyStr

type SccacheServerProcessFacts {
  spawn: SccacheServerSpawn
  idle_timeout_zero_disables_shutdown: Bool
  compiles_execute_as_server_children: Bool
  stats_query_spawns_server: Bool
  default_endpoint: SccacheServerEndpoint
  evidence: List<CacheEvidence>
}

data sccache_server_process_facts: SccacheServerProcessFacts = {
  spawn: ClientAutoSpawned
  idle_timeout_zero_disables_shutdown: true
  compiles_execute_as_server_children: true
  stats_query_spawns_server: false
  default_endpoint: SccacheServerTcpPort { port: sccache_server_default_tcp_port }
  evidence: [
    {
      field: "spawn"
      evidence: RunnerObserved {
        receipt: "Private-endpoint control on srv2 (2026-08-01, sccache 0.15.0): with a private SCCACHE_DIR and a private SCCACHE_SERVER_PORT=48223, listeners on that port went 0 -> 1 across a single real compile `sccache /usr/bin/gcc -c t.c -o t.o`, and resolving the new listener's inode through /proc/*/fd showed the server had inherited the INVOKING shell's cgroup (/user.slice/user-1000.slice/session-9219.scope) rather than any managed unit. This is the birth mechanism behind runner-owned servers, reproduced deliberately instead of inferred from the runner hosts."
        observed_at: "2026-08-01"
      }
    },
    {
      field: "stats_query_spawns_server"
      evidence: RunnerObserved {
        receipt: "Two private-endpoint controls on srv2 (2026-08-01, sccache 0.15.0). UDS form: SCCACHE_SERVER_UDS pointed at a fresh temp path; the socket did not exist before the call and did not exist after it; /proc/net/unix LISTEN entries for that path were 0 before and 0 after. TCP form: private SCCACHE_SERVER_PORT=48221; /proc/net/tcp listeners on that port were 0 before and 0 after. Both invocations returned rc=0 and printed a complete stats table reading all zeroes. So `--show-stats` reports plausibly with NO server in existence — it does not manufacture one. Refutes the prior in-tree claim that any sccache invocation auto-starts a server."
        observed_at: "2026-08-01"
      }
    },
    {
      field: "idle_timeout_zero_disables_shutdown"
      evidence: VendorCitation {
        source: "SCCACHE_IDLE_TIMEOUT: seconds the server waits before shutting down; 0 disables shutdown entirely"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/docs/Configuration.md"
      }
    },
    {
      field: "compiles_execute_as_server_children"
      evidence: VendorCitation {
        source: "sccache server performs the compilation on a cache miss; the compiler subprocess is a child of the server"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/docs/Architecture.md"
      }
    },
    {
      field: "default_endpoint"
      evidence: VendorCitation {
        source: "SCCACHE_SERVER_PORT sets the loopback TCP port the server listens on (default 4226); SCCACHE_SERVER_UDS selects a Unix-domain socket endpoint instead"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/docs/Configuration.md"
      }
    },
  ]
}

// THE ROSTER IS NON-EMPTY BY CONSTRUCTION, AND THAT IS THE POINT OF THE TYPE. Each fragment is a
// NON-EMPTY STRING, so an empty fragment is a COMPILE ERROR rather than a state some validator has to
// catch at claim time: `data probe: NonEmptyStr = ""` and `List<NonEmptyStr> = ["ok", ""]` are both
// refused by the strict compile (measured, not assumed -- and the flows this depends on were measured
// too: a NonEmptyStr satisfies a String parameter, a String? field, a String-returning match arm, a
// join list, and `String == NonEmptyStr`). WHY THIS MATTERS HERE: the classifier is a fold whose
// accumulator is `Optional`, and a fragment that matched everything would make a host with nothing
// interesting in its output read as MISCONFIGURED -- a wrong verdict, not a crash. The empty fragment
// was the only way to write that, and it is no longer writable.
//
// THIS REPLACES A VALIDATOR THAT COULD NOT FAIL. gunbc.host.host_effect_realize used to carry
// `build_cache_fragment_words_are_shell_safe`, whose name promised a shell check; review 82053 found
// its body had been repurposed to an emptiness check whose second conjunct (`string_contains(join
// ["prefix", frag, "suffix"], frag)`) is true of every string, i.e. green by construction and cited as
// coverage (DESIGN 3's name/obligation rule, DESIGN 4b's decoration rule). Deleting the check WITHOUT
// typing the row would leave the invariant unenforced; typing the row is what makes the deletion safe
// (DESIGN 5: unwritable beats validated). The shell-era reason the check existed -- fragments were
// single-quoted into a word list -- died with the script this PR retired.
data sccache_fatal_error_log_fragment: NonEmptyStr = "sccache: encountered fatal error"

data sccache_rustc_wrapper_exit_254_log_fragment: NonEmptyStr = "(exit status: 254)"

data sccache_failed_to_execute_compile_log_fragment: NonEmptyStr = "sccache: error: failed to execute compile"

// The cited roster of stdout/stderr fragments that mean 'the daemon answered, but it is
// misconfigured' — as a LIST, so a consumer classifying an observation folds over it. The three
// rows above were previously read one-by-one by a hand-unrolled if/elif chain in the host-standup
// provisioning emitter, which meant citing a fourth fragment here required an edit there too (the
// emitter naming a concept it does not own). Consumers iterate this roster; adding a row costs zero
// emitter edits. ORDER IS PRECEDENCE: the fold keeps the first hit, so this list's order is the
// classifier's priority -- test.claim pins it, and a reordering is a behaviour change.
data sccache_misconfigured_log_fragments: List<NonEmptyStr> = [
  sccache_fatal_error_log_fragment,
  sccache_rustc_wrapper_exit_254_log_fragment,
  sccache_failed_to_execute_compile_log_fragment,
]

// sccache's server EXITS ON ITS OWN. Three environment knobs, all documented by the module's cited
// authority extdeps_external_authority_anchor
// (github.com/mozilla/sccache/blob/main/docs/Configuration.md), decide the process lifetime a
// supervisor sees, and they are modeled here because they are facts about SCCACHE — not about
// systemd, and not about gunbc. Before 2026-07-25 the P1b unit emitter spelled
// SCCACHE_START_SERVER=1 / SCCACHE_NO_DAEMON=1 as bare literals of its own, which made
// gunbc.host_build_cache_provision_script a SECOND authority for sccache's environment vocabulary
// (§3) — and the knob that was missing from that second authority is exactly the one that broke:
// SCCACHE_IDLE_TIMEOUT. Cited text: 'how long the local daemon process waits for more client
// requests before exiting, in seconds. Set to 0 to run sccache permanently.' The default is 600
// seconds, confirmed by execution rather than read off the doc: on srv3 2026-07-25 the
// foreground-supervised unit started at 06:28:47 UTC, served no compile request, and EXITED 0 after
// `Duration: 10min 8.215s`, leaving `inactive (dead)` — Restart=on-failure could not fire because
// the exit was a success. Consequence for any supervisor: a Type=simple unit whose ExecStart is
// sccache is only durable when the idle timeout is disabled; otherwise it dies on the first quiet
// ten minutes and the host reverts to sccache's own unsupervised per-invocation auto-start (the
// very no-op state the foreground form was introduced to remove). Whether the srv1/srv2 production
// ctrl-sccache.service sets this knob is UNVERIFIED — neither host is reachable from a session
// container today, and the only in-tree description of that unit (#7206's note) lists
// SCCACHE_START_SERVER and SCCACHE_NO_DAEMON and no idle-timeout line, which is an absence in a
// summary, not evidence of absence in the file. What its month-plus uptime does NOT establish is
// that the unit is durable: those hosts run CI continuously, so traffic keeps the daemon below the
// idle threshold whether or not the timer is disabled — the uptime is consistent with both. This
// row therefore stands on the cited doc plus the srv3 receipt as a DEDUCTION; it is explicitly NOT
// claimed as a swap toward a production form nobody has read.

data sccache_start_server_env_var: String = "SCCACHE_START_SERVER"

data sccache_no_daemon_env_var: String = "SCCACHE_NO_DAEMON"

data sccache_idle_timeout_env_var: String = "SCCACHE_IDLE_TIMEOUT"

// The value whose MEANING is 'never exit', which is why it is a named row rather than a literal
// inside the assignment: '0' is not an ordinary duration on this axis (a zero-second idle timeout
// would mean the opposite), it is the cited doc's sentinel for running permanently. A future
// consumer that wants a bounded lifetime supplies its own seconds value; a consumer that wants a
// supervised daemon reads THIS row.

data sccache_idle_timeout_never_value: String = "0"

fn sccache_start_server_env_assignment() -> String {
  join([sccache_start_server_env_var, "=1"], "")
}

fn sccache_no_daemon_env_assignment() -> String {
  join([sccache_no_daemon_env_var, "=1"], "")
}

fn sccache_idle_timeout_never_env_assignment() -> String {
  join([sccache_idle_timeout_env_var, "=", sccache_idle_timeout_never_value], "")
}

data sccache_local_facts: CacheInterfaceCatalogFacts = {
  identity: sccache_local_id
  backing_surface: "sccache-local-disk"
  transport_encoding: SccacheInternalEncoding
  key_derivation: {

    key_inputs: NativeInternal { cited_inputs: [RustcInvocation, ToolchainSpec] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Org
    invalidation_triggers: [ManualPurge, ToolchainChange]
  }
  io: {
    lookup_semantics: NativeInternalLookup
    write_semantics: OverwriteAllowed
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: RawBytes
    locality: PerHostFilesystem

    retention: { release_policy: ReleasedNever, capacity: CapacityBounded { limit: ByteCapacity { limit: EffectiveLimitUnobserved }, at_capacity: ReplaceExisting { strategy: LeastRecentlyUsed } } }
    atomicity: WriteThenRename
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: ReadYourWrites
  }
  evidence: [
    {
      field: "lookup_semantics"
      evidence: VendorCitation {
        source: "sccache storage backends"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md"
      }
    },
    {
      field: "retention.capacity"
      evidence: VendorCitation {
        source: "sccache v0.15.0 Configuration.md: SCCACHE_CACHE_SIZE is the maximum size of the local on-disk cache, default 10G. The pinned tag is the modeled binary's version, not main, because a doc read at a moving ref cannot say what THIS binary does. The limit stays ByteCapacity(EffectiveLimitUnobserved) rather than ByteCapacity(ExactLimit(10G)): 10G is the vendor DEFAULT and the effective value may be overridden per runner by env or config, and no runner was read for this row. What the citation establishes is that a finite ceiling EXISTS, which is the fact CapacityBounded asserts"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/docs/Configuration.md#cache-size"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: VendorCitation {
        source: "sccache src/cache/disk.rs DiskCache::get/get_raw read the file at make_key_path(key) and return it as Cache::Hit with no hash/checksum/size check against the cache key or a stored digest. The gap is a FORMAT gap, not a missing check: src/cache/cache_io.rs's CacheWrite/CacheRead archive (a ZipWriter/ZipArchive of zstd-compressed per-object entries) carries no digest/checksum field anywhere in its write or read path, so content_verified_on_read cannot be made true for this backend by any read-side config change alone; it would require a store-time digest to be added to the entry format first. ZIP central-directory parsing at ZipArchive::new() validates archive-level structure and fails loudly on a torn archive, but a single entry whose payload is a well-formed zero-length zstd stream deserializes cleanly — the exact shape that lets a build exit 0 while one served object is silently empty, nested inside an otherwise well-formed archive"
        url: "https://github.com/mozilla/sccache/blob/main/src/cache/disk.rs"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: VendorCitation {
        source: "sccache issue #916 (lru_disk_cache footgun: files can be silently corrupted with no enforcement) and #2122 (sccache-dist: cache can end up somehow corrupted, no read-time detection) corroborate the missing read verification observed in gunbc CI as a zero-byte artifact served on a reported cache hit (runs 29855292758 et al)"
        url: "https://github.com/mozilla/sccache/issues/916"
      }
    },
    {
      field: "atomicity"
      evidence: VendorCitation {
        source: "CONFIRMED: DiskCache::put_raw (src/cache/disk.rs) calls LruDiskCache::prepare_add, which stages the write via tempfile::Builder::tempfile_in(&self.root); LruDiskCache::commit finalizes with NamedTempFile::persist(path) (a rename()) — write-to-tempfile-then-rename, genuinely atomic for the put/put_raw path sccache's DiskCache uses. (The underlying lru_disk_cache crate also exposes a separate direct-write insert_by/insert_bytes/insert_file/insert_with API with no tempfile staging, but DiskCache::put_raw does not call it.) Atomicity on write is real and is not the source of the zero-byte-serve defect — the defect is the missing store-time digest (see content_verified_on_read evidence above), which a torn write would not explain since ZIP-open validates archive structure and fails loudly on truncation"
        url: "https://github.com/mozilla/sccache/blob/main/src/lru_disk_cache/mod.rs"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: RunnerObserved {
        receipt: "Hermetic scratch-SCCACHE_DIR reproduction (2026-07-21, sccache 0.15.0, local disk backend): `sccache cc -c trivial.c -o trivial.o` on a fresh scratch cache produced a real cache miss and wrote a well-formed cache entry (a single-member ZIP, member 'obj', ZIP_STORED, holding zstd-compressed object bytes). The 'obj' member's stored payload was spliced (via libzstd.so.1 ZSTD_compress of a zero-length input, producing the genuine 9-byte empty zstd frame 28b52ffd2000010000) for a well-formed empty object, leaving the ZIP container itself untouched and structurally valid. Re-running the IDENTICAL `sccache cc` invocation against this doctored entry reported `Cache hits: 1`, `Cache misses: 0`, exit code 0, and wrote a genuine 0-byte trivial.o — reproducing exactly the CI incident (runs 29855292758 et al: content_verified_on_read=true falsified by a zero-byte artifact served on a reported cache hit). No SCCACHE server restart or config change was needed to make the read path serve it; confirms content_verified_on_read: false is correct, not merely plausible from source reading"
        observed_at: "2026-07-21"
      }
    },
  ]
}

// WHAT ENTERS sccache's RUST COMPILE KEY, at the pinned v0.15.0. Upstream: src/compiler/rust.rs
// generate_hash_key, step 8 ("Environment variables"), hashes every environment variable whose name
// starts with CARGO_ into the key, except CARGO_MAKEFLAGS, CARGO_REGISTRIES_*, CARGO_BUILD_JOBS and
// CARGO_ENCODED_RUSTFLAGS. Cargo itself sets CARGO_MANIFEST_DIR per package, so a package under a
// checkout carries that checkout's absolute path into its key; any CARGO_* the launcher exports
// (CARGO_TARGET_DIR, CARGO_BUILD_TARGET_DIR) is hashed with its value.
type SccacheRustKeyFacts {
  cargo_prefixed_env_enters_key: Bool
  cargo_env_names_excluded_from_key: List<NonEmptyStr>
  cargo_env_prefix_excluded_from_key: NonEmptyStr
  out_dir_argument_enters_key: Bool
  basedirs_strips_cargo_manifest_dir: Bool
  evidence: List<CacheEvidence>
}

data sccache_rust_key_facts: SccacheRustKeyFacts = {
  cargo_prefixed_env_enters_key: true
  cargo_env_names_excluded_from_key: ["CARGO_MAKEFLAGS" as NonEmptyStr, "CARGO_BUILD_JOBS" as NonEmptyStr, "CARGO_ENCODED_RUSTFLAGS" as NonEmptyStr]
  cargo_env_prefix_excluded_from_key: "CARGO_REGISTRIES_" as NonEmptyStr
  out_dir_argument_enters_key: false
  basedirs_strips_cargo_manifest_dir: false
  evidence: [
    {
      field: "cargo_prefixed_env_enters_key"
      evidence: VendorCitation {
        source: "sccache v0.15.0 src/compiler/rust.rs generate_hash_key, step 8: all environment variables starting with CARGO_ are hashed (name and value), since they are not listed in dep-info but affect cacheability"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/src/compiler/rust.rs"
      }
    },
    {
      field: "cargo_prefixed_env_enters_key"
      evidence: RunnerObserved {
        receipt: "Direct rustc control (2026-10-16, sccache 0.15.0, rustc 1.99.0, private server, one dependency-free crate, identical arguments): varying only CARGO_TARGET_DIR missed, varying only CARGO_MANIFEST_DIR missed, varying only an unrelated CARGO_FOO missed; the same environment twice hit. In the unit, the same effect measured on the real build: gunbc#14156 run 38874802505, arm D (different identity, same checkout path, the first identity's target directory) Rust 111 hits / 0 misses, arm B (own target directory) 0 hits / 111 misses."
        observed_at: "2026-10-16"
      }
    },
    {
      field: "out_dir_argument_enters_key"
      evidence: RunnerObserved {
        receipt: "Direct rustc control (2026-10-16, sccache 0.15.0): the same compile with only --out-dir changed hit, and with only -L dependency= changed hit; cargo build --target-dir (a flag, not CARGO_TARGET_DIR) into two different target directories from one checkout hit."
        observed_at: "2026-10-16"
      }
    },
    {
      field: "basedirs_strips_cargo_manifest_dir"
      evidence: RunnerObserved {
        receipt: "Two-crate path-dependency cargo build (2026-10-16, sccache 0.15.0) with SCCACHE_BASEDIRS set to the common parent of both checkouts, server started with it, --target-dir flag: the second checkout still missed (1 hit / 2 misses overall, identical to the run without it). Configuration.md at v0.15.0 describes basedirs as enabling hits across parallel checkouts and worktrees; it did not do so for Rust here, where CARGO_MANIFEST_DIR is hashed as an environment value."
        observed_at: "2026-10-16"
      }
    },
  ]
}
