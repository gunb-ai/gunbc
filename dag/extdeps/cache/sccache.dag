module extdeps.cache.sccache




data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/mozilla/sccache/blob/main/docs/Configuration.md"
  }
}

data sccache_local_id: std.cache_identity.CacheInterfaceId = "sccache_local"

data sccache_releases_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri { scheme: extdeps.uri.Https, locator: "github.com/mozilla/sccache/releases" }
}

type SccacheBinaryRelease {
  version: std.types.NonEmptyStr
  digest_aarch64: extdeps.crypto.hash.Digest
  digest_x86_64: extdeps.crypto.hash.Digest
}

data sccache_binary_artifact_grain_note: String = "For multi-artifact releases the pin SUBJECT is the ARTIFACT (release x platform), not the release row alone (review 44662, feature:pin-artifact-grain). SccacheBinaryRelease carries two cited digests because one GitHub release publishes two musl tarballs; Pin.expected_identity is one ContentHash, so Pin<SccacheBinaryRelease> was ambiguous about which tarball it pinned. SccacheBinaryArtifact is the release x published-musl-arch product: one cited digest per row, projected from the release's named digest_aarch64 / digest_x86_64 fields — never re-minted. SccachePublishedMuslArch is a CLOSED two-arm coproduct (SccacheMuslAarch64 | SccacheMuslX86_64) so unsupported extdeps.toolchain.types.Architecture variants are UNWRITABLE on the carrier rather than admitted and refused later (review 44866, DESIGN section 5 construction). Distinct variant names avoid the typechecker fork where reusing Aarch64 | X86_64 as a separate coproduct collided with Architecture; sccache_published_musl_arch_of is the Architecture→SccachePublishedMuslArch projection (Present only for published musl arches) used by sccache_binary_artifact_for_arch and sccache_release_digest consumers. CpuArchitecture and TargetArchitecture in std are byte-identical forks (DESIGN section 3) and are deliberately NOT imported here."

type SccachePublishedMuslArch = SccacheMuslAarch64 | SccacheMuslX86_64

fn sccache_published_musl_arch_key_of(arch: SccachePublishedMuslArch) -> std.types.NonEmptyStr {
  match arch {
    SccacheMuslAarch64 => "aarch64" as std.types.NonEmptyStr
    SccacheMuslX86_64 => "x86_64" as std.types.NonEmptyStr
  }
}

fn sccache_published_musl_arch_of(arch: extdeps.toolchain.types.Architecture) -> SccachePublishedMuslArch? {
  match arch {
    extdeps.toolchain.types.Aarch64 => Present { value: SccacheMuslAarch64 }
    extdeps.toolchain.types.X86_64 => Present { value: SccacheMuslX86_64 }
    extdeps.toolchain.types.X86 => none
    extdeps.toolchain.types.Arm => none
    extdeps.toolchain.types.Armv7 => none
    extdeps.toolchain.types.Mips => none
    extdeps.toolchain.types.Mipsel => none
    extdeps.toolchain.types.Mips64 => none
    extdeps.toolchain.types.Mips64el => none
    extdeps.toolchain.types.Riscv64 => none
    extdeps.toolchain.types.Wasm32 => none
  }
}

type SccacheBinaryArtifact {
  binary_release: SccacheBinaryRelease
  arch: SccachePublishedMuslArch
}

fn sccache_binary_artifact_for_arch(
  binary_release: SccacheBinaryRelease,
  arch: extdeps.toolchain.types.Architecture,
) -> SccacheBinaryArtifact? {
  match sccache_published_musl_arch_of(arch: arch) {
    Present { value: published } =>
      Present {
        value: SccacheBinaryArtifact {
          binary_release: binary_release,
          arch: published,
        }
      }
    Absent => none
  }
}

fn sccache_binary_artifact_authority_digest(artifact: SccacheBinaryArtifact) -> extdeps.crypto.hash.Digest {
  match artifact.arch {
    SccacheMuslAarch64 => artifact.binary_release.digest_aarch64
    SccacheMuslX86_64 => artifact.binary_release.digest_x86_64
  }
}

fn sccache_binary_artifact_content_identity(artifact: SccacheBinaryArtifact) -> std.content_hash.ContentHash? {
  extdeps.crypto.hash.sha256_digest_content_hash(
    digest: sccache_binary_artifact_authority_digest(artifact: artifact),
  )
}

data sccache_release_0_15_0: SccacheBinaryRelease = SccacheBinaryRelease {
  version: "v0.15.0",
  digest_aarch64: extdeps.crypto.hash.sha256_digest(hex: "3a6a3712b49da3d263bf2d30d702de4302793016019e800bfb81c0c69401d8f8"),
  digest_x86_64: extdeps.crypto.hash.sha256_digest(hex: "782d2b5dd7ae0a55ebe368ab258114d0928d019ac2d949ab85d5d02f3926709e"),
}

data sccache_toolchain_capability: extdeps.toolchain.types.ToolchainCapability = extdeps.toolchain.types.ToolchainCapability {
  name: "sccache",
  version: "0.15.0",
  env_isolation: extdeps.toolchain.types.SharedHomeAcrossJobs,
  build_wrapper: Present { value: extdeps.toolchain.types.CtrlBuild },
  linked_cache_interface: Present { value: sccache_local_id },
}

// The sccache binary install — curl the release tarball, `sha256sum -c` verify, tar,
// mv to /usr/local/bin, cited to github.com/mozilla/sccache/releases with a pinned
// version and per-arch sha256 — is rendered as a POSIX shell provisioning sequence
// (medium-as-string). The SccacheBinaryRelease row remains the typed authority for
// version and digests; only the ACTUATION is shell.
//
// It dissolves when host_effect_apply binds a verified-download-plus-install effect
// (FetchAndVerify then InstallBinary) without the shell leaf, at which point
// `sccache_install_script` is deleted rather than edited. The trigger names that
// declaration, so the obligation is answered against the tree rather than by reading
// this paragraph.
data sccache_install_dissolution_trigger: std.dissolution.DissolutionCondition = std.dissolution.retires_dissolution(
  ref: std.decl_ref.decl_ref(module_path: "extdeps.cache.sccache", decl_name: "sccache_install_script")
)

data sccache_installed_binary_path_note: String = "Single authority for WHERE the cited release lands on a host. sccache_install_script writes it and every downstream consumer (the host-standup P1b systemd unit ExecStart, the PATH-shadow read-back check) reads it — so 'which sccache is the modeled one' has exactly one answer. Before this row the P1b provisioning path hand-rolled `apt-get install -y sccache` and a unit with ExecStart=/usr/bin/sccache while this module installed the pinned v0.15.0 tarball to /usr/local/bin: a §3 fork of one concept across two authorities, disagreeing on source, version, digest verification AND path, both firing on the same host (P1:runner-deploy-slot then P1b:build-cache-provision)."

data sccache_installed_binary_path: String = "/usr/local/bin/sccache"

// These names are part of sccache's cited configuration interface, not facts invented by the
// systemd renderer or by the readiness observer. Keeping the names here lets both consumers compose
// assignments and reads from one authority.
data sccache_cache_dir_env_var: std.types.NonEmptyStr = "SCCACHE_DIR" as std.types.NonEmptyStr
data sccache_cache_size_env_var: std.types.NonEmptyStr = "SCCACHE_CACHE_SIZE" as std.types.NonEmptyStr

fn sccache_install_script(rel: SccacheBinaryRelease, arch: std.types.NonEmptyStr, digest: extdeps.crypto.hash.Digest) -> String {
  let dir = join(["sccache-", rel.version as String, "-", arch as String, "-unknown-linux-musl"], "")
  let url = join(["https://github.com/mozilla/sccache/releases/download/", rel.version as String, "/", dir, ".tar.gz"], "")
  join([
    "set -e",
    join(["curl -fsSL '", url, "' -o /tmp/sccache.tar.gz"], ""),
    extdeps.crypto.hash.digest_shell_verify_line(digest: digest, file_path: "/tmp/sccache.tar.gz"),
    "tar -xzf /tmp/sccache.tar.gz -C /tmp",
    join(["sudo mv '/tmp/", dir, "/sccache' ", sccache_installed_binary_path], ""),
    join(["sudo chmod +x ", sccache_installed_binary_path], ""),
    join(["rm -rf /tmp/sccache.tar.gz '/tmp/", dir, "'"], ""),
    "",
  ], "\n")
}

data sccache_release_arch_selection_note: String = "The release row carries per-arch digests as two named fields, so selecting one by hand is how a caller pins an arch (runner_host_sccache_provision_aarch64). These two selectors make the choice a total function of the modeled Architecture coproduct instead: every arch the cited release does NOT publish a musl tarball for returns Absent, so an unsupported host REFUSES rather than silently receiving an aarch64 binary. Fail-closed by construction (§5) — there is no default arm."

fn sccache_release_arch_token(arch: extdeps.toolchain.types.Architecture) -> std.types.NonEmptyStr? {
  match arch {
    extdeps.toolchain.types.Aarch64 => Present { value: "aarch64" as std.types.NonEmptyStr }
    extdeps.toolchain.types.X86_64 => Present { value: "x86_64" as std.types.NonEmptyStr }
    extdeps.toolchain.types.X86 => none
    extdeps.toolchain.types.Arm => none
    extdeps.toolchain.types.Armv7 => none
    extdeps.toolchain.types.Mips => none
    extdeps.toolchain.types.Mipsel => none
    extdeps.toolchain.types.Mips64 => none
    extdeps.toolchain.types.Mips64el => none
    extdeps.toolchain.types.Riscv64 => none
    extdeps.toolchain.types.Wasm32 => none
  }
}

fn sccache_release_digest(rel: SccacheBinaryRelease, arch: extdeps.toolchain.types.Architecture) -> extdeps.crypto.hash.Digest? {
  match arch {
    extdeps.toolchain.types.Aarch64 => Present { value: rel.digest_aarch64 }
    extdeps.toolchain.types.X86_64 => Present { value: rel.digest_x86_64 }
    extdeps.toolchain.types.X86 => none
    extdeps.toolchain.types.Arm => none
    extdeps.toolchain.types.Armv7 => none
    extdeps.toolchain.types.Mips => none
    extdeps.toolchain.types.Mipsel => none
    extdeps.toolchain.types.Mips64 => none
    extdeps.toolchain.types.Mips64el => none
    extdeps.toolchain.types.Riscv64 => none
    extdeps.toolchain.types.Wasm32 => none
  }
}

data sccache_server_process_model_doc: String = "sccache is a client/server tool: the client auto-spawns a server on first use if none is listening, the server survives the client that spawned it, and CACHE MISSES ARE COMPILED BY THE SERVER — rustc runs as a CHILD OF THE SERVER PROCESS, not of the invoking client. Consequence (load-bearing for host budgeting): the server's cgroup IS the cgroup every cache-miss compile on the host executes in, so a server that was lazily spawned inside some job's cgroup makes that job's memory caps bound EVERY subsequent compile on the host, including compiles issued by other jobs. SCCACHE_IDLE_TIMEOUT=0 disables the idle shutdown, so such a mis-placed server survives indefinitely."

data sccache_server_endpoint_doc: String = "The SERVER is identified positively as the process HOLDING THE LISTEN on the configured endpoint — never by process name. The sccache binary is both client and server, so under RUSTC_WRAPPER every in-flight compile also runs a process named 'sccache'; selecting by name samples a transient client and reads the WRONG cgroup. Upstream exposes two mutually exclusive endpoint realizations: SCCACHE_SERVER_PORT (loopback TCP, default 4226) and SCCACHE_SERVER_UDS (a Unix-domain socket path). Modeling only the port would be a nickname for one realization (DESIGN section 3): the gunbc fleet configures the UDS form, so a port-only probe finds no listener at all. Observed live on srv1 2026-08-01: no TCP 4226 listener exists, while /var/lib/ctrl/sccache-ci/server.sock is held LISTEN by the CI server and /var/lib/ctrl/sccache/server.sock by the session server — endpoint ownership is what distinguished them."

data sccache_server_default_tcp_port: Int = 4226

type SccacheServerEndpoint
  = SccacheServerTcpPort { port: Int }
  | SccacheServerUnixSocket { path: std.types.NonEmptyStr }

type SccacheServerSpawn
  = ClientAutoSpawned
  | UnitStarted

data sccache_stats_query_does_not_spawn_note: String = "MEASURED CORRECTION, 2026-08-01: `--show-stats` does NOT auto-start a server, and the widely-repeated claim that 'any sccache invocation auto-starts a server, so --show-stats manufactures the evidence it reports' is FALSE for sccache 0.15.0. Two controls on srv2, each with a PRIVATE cache dir AND a private endpoint so the falsifier could not touch production: with SCCACHE_SERVER_UDS the socket did not exist before or after the call; with a private SCCACHE_SERVER_PORT the listener count was 0 before and 0 after. In both the call returned rc=0 and printed a fully-formed table of ZEROES. A third control isolated what DOES spawn: one real compile (`sccache /usr/bin/gcc -c t.c`) through the same private port took the listener count 0 -> 1, and the new server inherited the INVOKING process's cgroup (observed: the caller's own session scope). THE DEFECT IS REAL BUT DIFFERENTLY SHAPED, and the difference changes the remedy's justification rather than the remedy: --show-stats answers plausibly WITHOUT a server existing at all, so a read-back that converges on it greens over a host with no durable daemon — a fabricated plausible output (DESIGN section 5), which is exactly what srv3 exhibited on 2026-07-25 (a full stats table while the unit had been inactive six hours). The observation there was right; the inference drawn from it — that the call had created a server — was wrong. Consequence for the observer: stats is supplemental data gathered AFTER ownership is independently established, never the thing that establishes it; and the auto-spawn wall belongs on the COMPILE path, which is where a client actually creates a server in its own cgroup."

type SccacheServerProcessFacts {
  spawn: SccacheServerSpawn
  idle_timeout_zero_disables_shutdown: Bool
  compiles_execute_as_server_children: Bool
  stats_query_spawns_server: Bool
  default_endpoint: SccacheServerEndpoint
  evidence: List<std.cache_interface.CacheEvidence>
}

data sccache_server_process_facts: SccacheServerProcessFacts = {
  spawn: ClientAutoSpawned
  idle_timeout_zero_disables_shutdown: true
  compiles_execute_as_server_children: true
  stats_query_spawns_server: false
  default_endpoint: SccacheServerTcpPort { port: sccache_server_default_tcp_port }
  evidence: [
    {
      field: "spawn"
      evidence: std.cache_interface.RunnerObserved {
        receipt: "Private-endpoint control on srv2 (2026-08-01, sccache 0.15.0): with a private SCCACHE_DIR and a private SCCACHE_SERVER_PORT=48223, listeners on that port went 0 -> 1 across a single real compile `sccache /usr/bin/gcc -c t.c -o t.o`, and resolving the new listener's inode through /proc/*/fd showed the server had inherited the INVOKING shell's cgroup (/user.slice/user-1000.slice/session-9219.scope) rather than any managed unit. This is the birth mechanism behind runner-owned servers, reproduced deliberately instead of inferred from the runner hosts."
        observed_at: "2026-08-01"
      }
    },
    {
      field: "stats_query_spawns_server"
      evidence: std.cache_interface.RunnerObserved {
        receipt: "Two private-endpoint controls on srv2 (2026-08-01, sccache 0.15.0). UDS form: SCCACHE_SERVER_UDS pointed at a fresh temp path; the socket did not exist before the call and did not exist after it; /proc/net/unix LISTEN entries for that path were 0 before and 0 after. TCP form: private SCCACHE_SERVER_PORT=48221; /proc/net/tcp listeners on that port were 0 before and 0 after. Both invocations returned rc=0 and printed a complete stats table reading all zeroes. So `--show-stats` reports plausibly with NO server in existence — it does not manufacture one. Refutes the prior in-tree claim that any sccache invocation auto-starts a server."
        observed_at: "2026-08-01"
      }
    },
    {
      field: "idle_timeout_zero_disables_shutdown"
      evidence: std.cache_interface.VendorCitation {
        source: "SCCACHE_IDLE_TIMEOUT: seconds the server waits before shutting down; 0 disables shutdown entirely"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/docs/Configuration.md"
      }
    },
    {
      field: "compiles_execute_as_server_children"
      evidence: std.cache_interface.VendorCitation {
        source: "sccache server performs the compilation on a cache miss; the compiler subprocess is a child of the server"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/docs/Architecture.md"
      }
    },
    {
      field: "default_endpoint"
      evidence: std.cache_interface.VendorCitation {
        source: "SCCACHE_SERVER_PORT sets the loopback TCP port the server listens on (default 4226); SCCACHE_SERVER_UDS selects a Unix-domain socket endpoint instead"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/docs/Configuration.md"
      }
    },
  ]
}

data sccache_fatal_error_log_fragment: String = "sccache: encountered fatal error"

data sccache_rustc_wrapper_exit_254_log_fragment: String = "(exit status: 254)"

data sccache_failed_to_execute_compile_log_fragment: String = "sccache: error: failed to execute compile"

data sccache_misconfigured_log_fragments_note: String = "The cited roster of stdout/stderr fragments that mean 'the daemon answered, but it is misconfigured' — as a LIST, so a consumer classifying an observation folds over it. The three rows above were previously read one-by-one by a hand-unrolled if/elif chain in the host-standup provisioning emitter, which meant citing a fourth fragment here required an edit there too (the emitter naming a concept it does not own). Consumers iterate this roster; adding a row costs zero emitter edits."

data sccache_misconfigured_log_fragments: List<String> = [
  sccache_fatal_error_log_fragment,
  sccache_rustc_wrapper_exit_254_log_fragment,
  sccache_failed_to_execute_compile_log_fragment,
]

data sccache_server_lifetime_note: String = "sccache's server EXITS ON ITS OWN. Three environment knobs, all documented by the module's cited authority extdeps_external_authority_anchor (github.com/mozilla/sccache/blob/main/docs/Configuration.md), decide the process lifetime a supervisor sees, and they are modeled here because they are facts about SCCACHE — not about systemd, and not about gunbc. Before 2026-07-25 the P1b unit emitter spelled SCCACHE_START_SERVER=1 / SCCACHE_NO_DAEMON=1 as bare literals of its own, which made gunbc.host_build_cache_provision_script a SECOND authority for sccache's environment vocabulary (§3) — and the knob that was missing from that second authority is exactly the one that broke: SCCACHE_IDLE_TIMEOUT. Cited text: 'how long the local daemon process waits for more client requests before exiting, in seconds. Set to 0 to run sccache permanently.' The default is 600 seconds, confirmed by execution rather than read off the doc: on srv3 2026-07-25 the foreground-supervised unit started at 06:28:47 UTC, served no compile request, and EXITED 0 after `Duration: 10min 8.215s`, leaving `inactive (dead)` — Restart=on-failure could not fire because the exit was a success. Consequence for any supervisor: a Type=simple unit whose ExecStart is sccache is only durable when the idle timeout is disabled; otherwise it dies on the first quiet ten minutes and the host reverts to sccache's own unsupervised per-invocation auto-start (the very no-op state the foreground form was introduced to remove). Whether the srv1/srv2 production ctrl-sccache.service sets this knob is UNVERIFIED — neither host is reachable from a session container today, and the only in-tree description of that unit (#7206's note) lists SCCACHE_START_SERVER and SCCACHE_NO_DAEMON and no idle-timeout line, which is an absence in a summary, not evidence of absence in the file. What its month-plus uptime does NOT establish is that the unit is durable: those hosts run CI continuously, so traffic keeps the daemon below the idle threshold whether or not the timer is disabled — the uptime is consistent with both. This row therefore stands on the cited doc plus the srv3 receipt as a DEDUCTION; it is explicitly NOT claimed as a swap toward a production form nobody has read."

data sccache_start_server_env_var: String = "SCCACHE_START_SERVER"

data sccache_no_daemon_env_var: String = "SCCACHE_NO_DAEMON"

data sccache_idle_timeout_env_var: String = "SCCACHE_IDLE_TIMEOUT"

data sccache_idle_timeout_never_value_note: String = "The value whose MEANING is 'never exit', which is why it is a named row rather than a literal inside the assignment: '0' is not an ordinary duration on this axis (a zero-second idle timeout would mean the opposite), it is the cited doc's sentinel for running permanently. A future consumer that wants a bounded lifetime supplies its own seconds value; a consumer that wants a supervised daemon reads THIS row."

data sccache_idle_timeout_never_value: String = "0"

fn sccache_start_server_env_assignment() -> String {
  join([sccache_start_server_env_var, "=1"], "")
}

fn sccache_no_daemon_env_assignment() -> String {
  join([sccache_no_daemon_env_var, "=1"], "")
}

fn sccache_idle_timeout_never_env_assignment() -> String {
  join([sccache_idle_timeout_env_var, "=", sccache_idle_timeout_never_value], "")
}

data sccache_local_facts: extdeps.cache.types.CacheInterfaceCatalogFacts = {
  identity: sccache_local_id
  backing_surface: "sccache-local-disk"
  transport_encoding: extdeps.cache.types.SccacheInternalEncoding
  key_derivation: {

    key_inputs: extdeps.cache.types.NativeInternal { cited_inputs: [extdeps.cache.types.RustcInvocation, extdeps.cache.types.ToolchainSpec] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: std.cache_interface.Org
    invalidation_triggers: [std.cache_interface.ManualPurge, std.cache_interface.ToolchainChange]
  }
  io: {
    lookup_semantics: std.cache_interface.NativeInternalLookup
    write_semantics: std.cache_interface.OverwriteAllowed
    miss_semantics: std.cache_interface.MissThenCreate
  }
  placement: {
    value_shape: std.cache_interface.RawBytes
    locality: std.cache_interface.PerHostFilesystem

    retention: { release_policy: std.cache_interface.ReleasedNever, capacity: std.cache_interface.CapacityBounded { limit: std.cache_interface.ByteCapacity { limit: std.cache_interface.EffectiveLimitUnobserved }, at_capacity: std.cache_interface.ReplaceExisting { strategy: std.cache_interface.LeastRecentlyUsed } } }
    atomicity: std.cache_interface.WriteThenRename
    auth: std.cache_interface.FilesystemPerms
    read_latency: std.cache_interface.LocalDiskUs
    consistency: std.cache_interface.ReadYourWrites
  }
  evidence: [
    {
      field: "lookup_semantics"
      evidence: std.cache_interface.VendorCitation {
        source: "sccache storage backends"
        url: "https://github.com/mozilla/sccache/blob/main/docs/Configuration.md"
      }
    },
    {
      field: "retention.capacity"
      evidence: std.cache_interface.VendorCitation {
        source: "sccache v0.15.0 Configuration.md: SCCACHE_CACHE_SIZE is the maximum size of the local on-disk cache, default 10G. The pinned tag is the modeled binary's version, not main, because a doc read at a moving ref cannot say what THIS binary does. The limit stays ByteCapacity(EffectiveLimitUnobserved) rather than ByteCapacity(ExactLimit(10G)): 10G is the vendor DEFAULT and the effective value may be overridden per runner by env or config, and no runner was read for this row. What the citation establishes is that a finite ceiling EXISTS, which is the fact CapacityBounded asserts"
        url: "https://github.com/mozilla/sccache/blob/v0.15.0/docs/Configuration.md#cache-size"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: std.cache_interface.VendorCitation {
        source: "sccache src/cache/disk.rs DiskCache::get/get_raw read the file at make_key_path(key) and return it as Cache::Hit with no hash/checksum/size check against the cache key or a stored digest. The gap is a FORMAT gap, not a missing check: src/cache/cache_io.rs's CacheWrite/CacheRead archive (a ZipWriter/ZipArchive of zstd-compressed per-object entries) carries no digest/checksum field anywhere in its write or read path, so content_verified_on_read cannot be made true for this backend by any read-side config change alone; it would require a store-time digest to be added to the entry format first. ZIP central-directory parsing at ZipArchive::new() validates archive-level structure and fails loudly on a torn archive, but a single entry whose payload is a well-formed zero-length zstd stream deserializes cleanly — the exact shape that lets a build exit 0 while one served object is silently empty, nested inside an otherwise well-formed archive"
        url: "https://github.com/mozilla/sccache/blob/main/src/cache/disk.rs"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: std.cache_interface.VendorCitation {
        source: "sccache issue #916 (lru_disk_cache footgun: files can be silently corrupted with no enforcement) and #2122 (sccache-dist: cache can end up somehow corrupted, no read-time detection) corroborate the missing read verification observed in gunbc CI as a zero-byte artifact served on a reported cache hit (runs 29855292758 et al)"
        url: "https://github.com/mozilla/sccache/issues/916"
      }
    },
    {
      field: "atomicity"
      evidence: std.cache_interface.VendorCitation {
        source: "CONFIRMED: DiskCache::put_raw (src/cache/disk.rs) calls LruDiskCache::prepare_add, which stages the write via tempfile::Builder::tempfile_in(&self.root); LruDiskCache::commit finalizes with NamedTempFile::persist(path) (a rename()) — write-to-tempfile-then-rename, genuinely atomic for the put/put_raw path sccache's DiskCache uses. (The underlying lru_disk_cache crate also exposes a separate direct-write insert_by/insert_bytes/insert_file/insert_with API with no tempfile staging, but DiskCache::put_raw does not call it.) Atomicity on write is real and is not the source of the zero-byte-serve defect — the defect is the missing store-time digest (see content_verified_on_read evidence above), which a torn write would not explain since ZIP-open validates archive structure and fails loudly on truncation"
        url: "https://github.com/mozilla/sccache/blob/main/src/lru_disk_cache/mod.rs"
      }
    },
    {
      field: "content_verified_on_read"
      evidence: std.cache_interface.RunnerObserved {
