module extdeps.cache.buildbuddy



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.buildbuddy.io/docs/remote-cache"
  }
}

data buildbuddy_cas_id: std.cache_identity.CacheInterfaceId = "buildbuddy_cas"

data buildbuddy_cas_facts: extdeps.cache.types.CacheInterfaceCatalogFacts = {
  identity: buildbuddy_cas_id
  backing_surface: "buildbuddy-remote-cas"
  transport_encoding: extdeps.cache.types.CatalogCasContentEncoding
  key_derivation: {

    key_inputs: extdeps.cache.types.ContentAddressed
    overwritable: false
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: std.cache_interface.Network
    invalidation_triggers: [std.cache_interface.ManualPurge]
  }
  io: {
    lookup_semantics: std.cache_interface.ContentAddressLookup
    write_semantics: std.cache_interface.WriteOnce
    miss_semantics: std.cache_interface.MissThenCreate
  }
  placement: {
    value_shape: std.cache_interface.RawBytes
    locality: std.cache_interface.CrossHostNetwork
    retention: { release_policy: std.cache_interface.ReleasedNever, capacity: std.cache_interface.CapacityUnobserved }
    atomicity: std.cache_interface.WriteThenCommit
    auth: std.cache_interface.ApiKey
    read_latency: std.cache_interface.LanMs
    consistency: std.cache_interface.Strong
  }
  evidence: [
    {
      field: "lookup_semantics"
      evidence: std.cache_interface.VendorCitation {
        source: "BuildBuddy remote cache content-addressed artifacts"
        url: "https://www.buildbuddy.io/docs/remote-cache"
      }
    },
    {
      field: "write_semantics"
      evidence: std.cache_interface.VendorCitation {
        source: "BuildBuddy CAS blobs are content-addressed and not overwritten in place"
        url: "https://www.buildbuddy.io/docs/remote-cache"
      }
    },
    {
      field: "atomicity"
      evidence: std.cache_interface.VendorCitation {
        source: "CAS upload commit visibility (orthogonal to write-once key semantics)"
        url: "https://www.buildbuddy.io/docs/remote-cache"
      }
    },
  ]
}
