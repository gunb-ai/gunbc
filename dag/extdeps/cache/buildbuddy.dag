module extdeps.cache.buildbuddy

import extdeps.cache.types { CacheInterfaceCatalogFacts, ContentAddressed, CatalogCasContentEncoding }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  ContentAddressLookup,
  WriteOnce,
  MissThenCreate,
  RawBytes,
  CrossHostNetwork,
  WriteThenCommit,
  ApiKey,
  LanMs,
  Strong,
  VendorCitation,
  ManualPurge,
  Network,
  CapacityUnobserved,
  ReleasedNever,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.buildbuddy.io/docs/remote-cache"
  }
}

// Reading: www.buildbuddy.io owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its data declaration buildbuddy_cas_id, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.cache.buildbuddy",
      decl_name: "buildbuddy_cas_id",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data buildbuddy_cas_id: CacheInterfaceId = "buildbuddy_cas"

data buildbuddy_cas_facts: CacheInterfaceCatalogFacts = {
  identity: buildbuddy_cas_id
  backing_surface: "buildbuddy-remote-cas"
  transport_encoding: CatalogCasContentEncoding
  key_derivation: {

    key_inputs: ContentAddressed
    overwritable: false
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: Network
    invalidation_triggers: [ManualPurge]
  }
  io: {
    lookup_semantics: ContentAddressLookup
    write_semantics: WriteOnce
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: RawBytes
    locality: CrossHostNetwork
    retention: { release_policy: ReleasedNever, capacity: CapacityUnobserved }
    atomicity: WriteThenCommit
    auth: ApiKey
    read_latency: LanMs
    consistency: Strong
  }
  evidence: [
    {
      field: "lookup_semantics"
      evidence: VendorCitation {
        source: "BuildBuddy remote cache content-addressed artifacts"
        url: "https://www.buildbuddy.io/docs/remote-cache"
      }
    },
    {
      field: "write_semantics"
      evidence: VendorCitation {
        source: "BuildBuddy CAS blobs are content-addressed and not overwritten in place"
        url: "https://www.buildbuddy.io/docs/remote-cache"
      }
    },
    {
      field: "atomicity"
      evidence: VendorCitation {
        source: "CAS upload commit visibility (orthogonal to write-once key semantics)"
        url: "https://www.buildbuddy.io/docs/remote-cache"
      }
    },
  ]
}
