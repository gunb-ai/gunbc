module extdeps.cache.cargo

import extdeps.cache.types {
  CacheInterfaceCatalogFacts,
  NativeInternal,
  RustcInvocation,
  ToolchainSpec,
  FilePaths,
  CargoFingerprintEncoding,
}
import std.types { String }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  NativeInternalLookup,
  ProviderInternal,
  MissThenCreate,
  FileTree,
  PerRunnerFilesystem,
  PerFile,
  FilesystemPerms,
  LocalDiskUs,
  ReadYourWrites,
  VendorCitation,
  ManualPurge,
  ToolchainChange,
  DependencyChange,
  Repo,
  CapacityUnobserved,
  ReleasedManually,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "doc.rust-lang.org/cargo/guide/build-cache.html"
  }
}

data cargo_target_dir_id: CacheInterfaceId = "cargo_target_dir"

data cargo_target_dir_facts: CacheInterfaceCatalogFacts = {
  identity: cargo_target_dir_id
  backing_surface: "cargo-target-directory"
  transport_encoding: CargoFingerprintEncoding
  key_derivation: {

    key_inputs: NativeInternal { cited_inputs: [RustcInvocation, FilePaths, ToolchainSpec] }
    overwritable: true
    prefix_fallback_allowed: false
    content_verified_on_read: false
    visibility_scope: Repo
    invalidation_triggers: [ToolchainChange, DependencyChange, ManualPurge]
  }
  io: {
    lookup_semantics: NativeInternalLookup
    write_semantics: ProviderInternal
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: FileTree
    locality: PerRunnerFilesystem
    retention: { release_policy: ReleasedManually, capacity: CapacityUnobserved }
    atomicity: PerFile
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: ReadYourWrites
  }
  evidence: [
    {
      field: "locality"
      evidence: VendorCitation {
        source: "Cargo build artifacts in target/"
        url: "https://doc.rust-lang.org/cargo/guide/build-cache.html"
      }
    },
  ]
}

// The PARTITION of an owned cargo target directory, keyed by its owner (C4): <base>/<owner>/target.
// cargo_target_dir_facts above names the cache; this fn is its path form, so the partition lives in
// ONE home that every owner can consume unchanged. The owners are the per-owner work roots: devboot
// passes its work_root and subject token (devboot_target_dir delegates here), the compute provider
// passes its compute root and the request's identity_hex (its work_dir, so the identity-scoped lease
// bounds the writable target), and the host-seed site adopts the same partition once it stops
// sharing the ambient host target. One fn, one shape -- a second model of this partition would be a
// nickname (DESIGN §3).
fn cargo_target_dir(base_root: String, owner: String) -> String {
  join([base_root, "/", owner, "/target"], "")
}
