module extdeps.cache.rustup



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "rust-lang.github.io/rustup/overrides.html"
  }
}

data rustup_toolchain_store_id: std.cache_identity.CacheInterfaceId = "rustup_toolchain_store"

data rustup_toolchain_store_facts: extdeps.cache.types.CacheInterfaceCatalogFacts = {
  identity: rustup_toolchain_store_id
  backing_surface: "rustup-toolchains-dir"
  transport_encoding: CatalogOpaqueStringEncoding
  key_derivation: {

    key_inputs: extdeps.cache.types.NativeInternal { cited_inputs: [ToolchainSpec] }
    overwritable: false
    prefix_fallback_allowed: false
    content_verified_on_read: true
    visibility_scope: Org
    invalidation_triggers: [ToolchainChange, ManualPurge]
  }
  io: {
    lookup_semantics: NativeInternalLookup
    write_semantics: ProviderInternal
    miss_semantics: MissThenCreate
  }
  placement: {
    value_shape: FileTree
    locality: PerHostFilesystem
    retention: { release_policy: ReleasedNever, capacity: CapacityUnobserved }
    atomicity: PerFile
    auth: FilesystemPerms
    read_latency: LocalDiskUs
    consistency: Strong
  }
  evidence: [
    {
      field: "key_derivation"
      evidence: std.cache_interface.VendorCitation {
        source: "rustup toolchain installation layout"
        url: "https://rust-lang.github.io/rustup/overrides.html"
      }
    },
  ]
}
