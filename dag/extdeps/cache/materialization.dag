module extdeps.cache.materialization



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/cache"
  }
}

data catalog_materialization_note: String = "C0 (operator ruling, 2026-07-09): extdeps stays the ground-truth/interface layer - the catalog cites what a cache system IS - but every USE of a cache goes through materialization, so nobody re-invents memo. This projection is the only door from a catalog row into the ladder: provider = catalog row + role (scope, coverage); tier and keying are DERIVED from the cited facts, never restated at the provider site. RETENTION IS CARRIED, NOT VERDICTED (2026-08-06). The former mapping asserted two things it had not established: InProcess locality => ScopeExit by construction, which DISCARDED the row placement retention outright so an in-process provider could never carry a byte bound; and Ttl/Lru/SizeBounded => SpacePacked, which minted a space guarantee from an age bound and from a replacement ORDER. Both are gone. provider_from_catalog now carries facts.placement.retention through unchanged for EVERY locality, and the boundedness question moved to the role doors provider_for_growth_bounded_role / provider_for_capacity_bounded_role / provider_for_exact_byte_budget_role, whose refusals name the missing axis. That split is deliberate: a witness-frame memo may be scope-released with unbounded capacity and remain legitimate under its frame envelope, while a promoted entry-scoped memo or a cross-run store must show a real ceiling - and only the consumer knows which it is. The EvictionPolicy/EvictionClass homonym the 2026-07-11 ambiguity wall found is dissolved rather than renamed: both vocabularies are now std.cache_interface.ProviderRetention, and required class is the derived predicate retention_growth_is_bounded."

data catalog_keying_note: String = "Keying projection is refuse-leaning (section 5): ContentAddressed and NativeInternal (the tool's internal hash of cited inputs) project to ContentKeyed; HandAuthored projects to ExistenceKeyed — a hand-authored key string is not proven content-complete until a key-completeness receipt upgrades it (extdeps.cache.key_completeness is that oracle's home); and prefix_fallback_allowed forces ExistenceKeyed regardless, because a prefix restore names a bucket, not an identity (the actions-cache staleness class, cousin of the #6352 build-if-absent wall)."

// Refusal reasons name the MISSING AXIS, because the remedy differs: an
// unobserved capacity needs a citation, a known-unbounded one needs a declared
// ceiling. The old pair (NeverEvictionOutsideProcess / ManualEvictionOutside-
// Process) named the old fused variants and could not say which fact was absent.
type CatalogProjectionRefusalReason
  = CapacityUnboundedForRole
  | CapacityUnobservedForRole
  | CapacityUnitMismatchForRole
  | CapacityValueUnobservedForRole
  | CapacityValueUnresolvedForRole

fn catalog_keying(kd: extdeps.cache.types.CatalogKeyDerivationFacts) -> std.materialization_ladder.CacheKeying {
  if kd.prefix_fallback_allowed {
    std.materialization_ladder.ExistenceKeyed
  } else {
    match kd.key_inputs {
      extdeps.cache.types.ContentAddressed => std.materialization_ladder.ContentKeyed
      extdeps.cache.types.NativeInternal { cited_inputs: _ } => std.materialization_ladder.ContentKeyed
      extdeps.cache.types.HandAuthored { cited_inputs: _ } => std.materialization_ladder.ExistenceKeyed
    }
  }
}

fn catalog_tier(p: extdeps.cache.catalog_placement.CacheInterfaceCatalogPlacement, keying: std.materialization_ladder.CacheKeying) -> std.materialization_ladder.ProviderTier {
  match p.locality {
    std.cache_interface.InProcess => std.materialization_ladder.MemoTier { keying: keying }
    std.cache_interface.PerRunnerFilesystem => std.materialization_ladder.ArtifactTier { keying: keying }
    std.cache_interface.PerHostFilesystem => std.materialization_ladder.ArtifactTier { keying: keying }
    std.cache_interface.CrossHostNetwork => std.materialization_ladder.CasTier { keying: keying }
  }
}

// PRESERVE, do not pre-verdict. The former shape answered two questions at
// once and got both wrong: every InProcess row was projected as ScopeExit with
// facts.placement.eviction DISCARDED (so a promoted in-process provider could
// not carry a byte bound at all), and Ttl / Lru / SizeBounded were all mapped
// to SpacePacked (so an age bound and a replacement ORDER each minted a space
// guarantee they never established). Retention now travels through unchanged
// and the CONSUMER's obligation decides what it requires — a witness-frame memo
// may legitimately be scope-released with unbounded capacity, while a promoted
// entry-scoped memo or a cross-run store demands a real ceiling.
fn catalog_retention(facts: extdeps.cache.types.CacheInterfaceCatalogFacts) -> std.cache_interface.ProviderRetention {
  facts.placement.retention
}

// ACCOUNTING IS TOTAL BY TYPE. It returns a CacheProvider, not a union with a
// refusal arm, because classifying a cited row never fails: every catalog row
// has a locality, a key derivation and a retention, so a provider can always be
// built from one. The former shape returned the ELIGIBILITY union here, which
// made "did accounting refuse?" a question you could ask at all — and the
// compiler consumer duly asked it and asserted the answer was zero, a witness
// that is true by construction rather than discriminating.
fn provider_from_catalog(
  facts: extdeps.cache.types.CacheInterfaceCatalogFacts,
  scope: List<std.materialization_ladder.Frame>,
  coverage: std.materialization_ladder.CacheCoverage
) -> std.materialization_ladder.CacheProvider {
  let keying = catalog_keying(kd: facts.key_derivation)
  let tier = catalog_tier(p: facts.placement, keying: keying)
  std.materialization_ladder.provider_row(
    id: facts.identity,
    scope: scope,
    coverage: coverage,
    tier: tier,
    retention: catalog_retention(facts: facts)
  )
}

// ELIGIBILITY is a separate question from ACCOUNTING: a row may be classified
// completely and still be ineligible for a role whose obligation it cannot
// discharge. Accounting asks "is every cache classified?"; eligibility asks
// "does THIS cache have enough facts for THIS role?"; completion asks "is every
// provider the live plan requires eligible?". One predicate answering all three
// is how a refusal count became a copied expected number instead of a finding.

// THE ROLE IS DATA, NOT A CALLER-SUPPLIED BOOLEAN. The former three doors each
// computed their own predicate and handed the RESULT to a shared helper taking
// ok: Bool, which unsealed the relation between role, facts and verdict: any
// caller could mint a refusal for an eligible provider, and the cause was then
// derived from capacity alone with no idea which role had asked. That is how
// ByteCapacity{ExactLimit} came to report CapacityUnitMismatchForRole — a
// perfect byte budget labelled a unit mismatch. Eligibility is now one total
// fold over (role, retention) and the role travels into the refusal.
type CatalogProviderRole
  = GrowthBoundedRole
  | CapacityBoundedRole
  | ExactByteBudgetRole

type CatalogProviderEligibility
  = ProviderEligible { role: CatalogProviderRole, provider: std.materialization_ladder.CacheProvider }
  | ProviderIneligible {
      role: CatalogProviderRole,
      interface: std.cache_identity.CacheInterfaceId,
      reason: CatalogProjectionRefusalReason
    }

fn provider_for_role(
  role: CatalogProviderRole,
  facts: extdeps.cache.types.CacheInterfaceCatalogFacts,
  scope: List<std.materialization_ladder.Frame>,
  coverage: std.materialization_ladder.CacheCoverage
) -> CatalogProviderEligibility {
  let retention = catalog_retention(facts: facts)
  match role_admits(role: role, r: retention) {
    RoleAdmitted =>
      ProviderEligible {
        role: role,
        provider: provider_from_catalog(facts: facts, scope: scope, coverage: coverage)
      }
    RoleRefused { reason: why } =>
      ProviderIneligible { role: role, interface: facts.identity, reason: why }
  }
}

// Carries the reason so no downstream function has to reconstruct it from a
// state that cannot occur — the same correction the ladder's RefusedProvider
// makes. Each arm's cause is true for the role that asked.
type RoleAdmission
  = RoleAdmitted
  | RoleRefused { reason: CatalogProjectionRefusalReason }

// FOLD, DO NOT PREDICATE-THEN-EXPLAIN. Asking a Bool predicate and then
// deriving the cause in a second function is what manufactures impossible arms:
// the second function must be total over states the first has already excluded,
// so it needs a CapacityBounded arm it can never reach and someone fills it
// with a false label. Matching the state once answers both questions at the
// same time, and every arm below is reachable with a cause that is true.
fn role_admits(role: CatalogProviderRole, r: std.cache_interface.ProviderRetention) -> RoleAdmission {
  match role {
    GrowthBoundedRole => growth_admission(r: r)
    CapacityBoundedRole => capacity_admission(c: r.capacity)
    ExactByteBudgetRole => exact_byte_admission(c: r.capacity)
  }
}

// Mirrors std.materialization_ladder.retention_admission: scope release bounds
// growth over time whatever the capacity, otherwise a ceiling must exist.
fn growth_admission(r: std.cache_interface.ProviderRetention) -> RoleAdmission {
  match r.release_policy {
    std.cache_interface.ReleasedAtProviderScopeExit => RoleAdmitted
    std.cache_interface.ReleasedNever => capacity_admission(c: r.capacity)
    std.cache_interface.ReleasedManually => capacity_admission(c: r.capacity)
  }
}

fn capacity_admission(c: std.cache_interface.CapacityPolicy) -> RoleAdmission {
  match c {
    std.cache_interface.CapacityUnbounded => RoleRefused { reason: CapacityUnboundedForRole }
    std.cache_interface.CapacityUnobserved => RoleRefused { reason: CapacityUnobservedForRole }
    std.cache_interface.CapacityBounded { limit: _, at_capacity: _ } => RoleAdmitted
  }
}

// The exact-byte role is the only one that can fail ON A BOUNDED capacity, and
// each way it fails has its own remedy: wrong unit needs a different cache,
// a runtime-derived value needs the deriving authority to be resolved, and an
// unobserved value needs a citation.
fn exact_byte_admission(c: std.cache_interface.CapacityPolicy) -> RoleAdmission {
  match c {
    std.cache_interface.CapacityUnbounded => RoleRefused { reason: CapacityUnboundedForRole }
    std.cache_interface.CapacityUnobserved => RoleRefused { reason: CapacityUnobservedForRole }
    std.cache_interface.CapacityBounded { limit: l, at_capacity: _ } => exact_byte_limit_admission(l: l)
  }
}

fn exact_byte_limit_admission(l: std.cache_interface.CapacityLimit) -> RoleAdmission {
  match l {
    std.cache_interface.EntryCountCapacity { limit: _ } => RoleRefused { reason: CapacityUnitMismatchForRole }
    std.cache_interface.ByteCapacity { limit: v } => match v {
      std.cache_interface.ExactLimit { value: _ } => RoleAdmitted
      std.cache_interface.RuntimeDerivedLimit { authority: _ } => RoleRefused { reason: CapacityValueUnresolvedForRole }
      std.cache_interface.EffectiveLimitUnobserved => RoleRefused { reason: CapacityValueUnobservedForRole }
    }
  }
}

fn provider_for_growth_bounded_role(
  facts: extdeps.cache.types.CacheInterfaceCatalogFacts,
  scope: List<std.materialization_ladder.Frame>,
  coverage: std.materialization_ladder.CacheCoverage
) -> CatalogProviderEligibility {
  provider_for_role(role: GrowthBoundedRole, facts: facts, scope: scope, coverage: coverage)
}

fn provider_for_capacity_bounded_role(
  facts: extdeps.cache.types.CacheInterfaceCatalogFacts,
  scope: List<std.materialization_ladder.Frame>,
  coverage: std.materialization_ladder.CacheCoverage
) -> CatalogProviderEligibility {
  provider_for_role(role: CapacityBoundedRole, facts: facts, scope: scope, coverage: coverage)
}

fn provider_for_exact_byte_budget_role(
  facts: extdeps.cache.types.CacheInterfaceCatalogFacts,
  scope: List<std.materialization_ladder.Frame>,
  coverage: std.materialization_ladder.CacheCoverage
) -> CatalogProviderEligibility {
  provider_for_role(role: ExactByteBudgetRole, facts: facts, scope: scope, coverage: coverage)
}

// The readers now speak eligibility, because that is the only question with a
// refusal in it. The old CatalogProviderProjection union is gone: accounting
// returns a provider outright, so nothing downstream can count "accounting
// refusals" and find zero.
fn eligibility_is_refused(e: CatalogProviderEligibility) -> Bool {
  match e {
    ProviderEligible { role: _, provider: _ } => false
    ProviderIneligible { role: _, interface: _, reason: _ } => true
  }
}

fn eligible_providers(es: List<CatalogProviderEligibility>) -> List<std.materialization_ladder.CacheProvider> {
  es |> flat_map(e => match e {
    ProviderEligible { role: _, provider: prov } => [prov]
    ProviderIneligible { role: _, interface: _, reason: _ } => []
  })
}

fn eligibility_refusal_count(es: List<CatalogProviderEligibility>) -> Int {
  es |> filter(e => eligibility_is_refused(e: e)) |> count()
}
