module extdeps.cache.materialization

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

import std.types { Bool, Int, List, String }
import std.cache_identity { CacheInterfaceId }
import std.cache_interface {
  ProviderRetention, CapacityPolicy,
  CapacityUnbounded, CapacityBounded, CapacityUnobserved,
  retention_growth_is_bounded,
  PersistenceLocality, InProcess, PerRunnerFilesystem, PerHostFilesystem, CrossHostNetwork
}
import std.materialization_ladder {
  CacheProvider, CacheCoverage, Frame,
  ProviderTier, MemoTier, ArtifactTier, CasTier,
  CacheKeying, ContentKeyed, ExistenceKeyed,
  provider_row
}
import extdeps.cache.types {
  CacheInterfaceCatalogFacts,
  CatalogKeyDerivationFacts,
  CatalogKeyInputs, ContentAddressed, NativeInternal, HandAuthored
}
import extdeps.cache.catalog_placement { CacheInterfaceCatalogPlacement }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/cache"
  }
}

data catalog_materialization_note: String = "C0 (operator ruling, 2026-07-09): extdeps stays the ground-truth/interface layer - the catalog cites what a cache system IS - but every USE of a cache goes through materialization, so nobody re-invents memo. This projection is the only door from a catalog row into the ladder: provider = catalog row + role (scope, coverage); tier and keying are DERIVED from the cited facts, never restated at the provider site. RETENTION IS CARRIED, NOT VERDICTED (2026-08-06). The former mapping asserted two things it had not established: InProcess locality => ScopeExit by construction, which DISCARDED the row placement retention outright so an in-process provider could never carry a byte bound; and Ttl/Lru/SizeBounded => SpacePacked, which minted a space guarantee from an age bound and from a replacement ORDER. Both are gone. provider_from_catalog now carries facts.placement.retention through unchanged for EVERY locality, and the boundedness question moved to the role door provider_for_bounded_role, whose refusal names the missing axis. That split is deliberate: a witness-frame memo may be scope-released with unbounded capacity and remain legitimate under its frame envelope, while a promoted entry-scoped memo or a cross-run store must show a real ceiling - and only the consumer knows which it is. The EvictionPolicy/EvictionClass homonym the 2026-07-11 ambiguity wall found is dissolved rather than renamed: both vocabularies are now std.cache_interface.ProviderRetention, and required class is the derived predicate retention_growth_is_bounded."

data catalog_keying_note: String = "Keying projection is refuse-leaning (section 5): ContentAddressed and NativeInternal (the tool's internal hash of cited inputs) project to ContentKeyed; HandAuthored projects to ExistenceKeyed — a hand-authored key string is not proven content-complete until a key-completeness receipt upgrades it (extdeps.cache.key_completeness is that oracle's home); and prefix_fallback_allowed forces ExistenceKeyed regardless, because a prefix restore names a bucket, not an identity (the actions-cache staleness class, cousin of the #6352 build-if-absent wall)."

// Refusal reasons name the MISSING AXIS, because the remedy differs: an
// unobserved capacity needs a citation, a known-unbounded one needs a declared
// ceiling. The old pair (NeverEvictionOutsideProcess / ManualEvictionOutside-
// Process) named the old fused variants and could not say which fact was absent.
type CatalogProjectionRefusalReason
  = CapacityUnboundedForRole
  | CapacityUnobservedForRole
  | CapacityUnitMismatchForRole
  | CapacityValueUnobservedForRole
  | CapacityValueUnresolvedForRole

type CatalogProviderProjection
  = ProjectedProvider { provider: CacheProvider }
  | ProjectionRefused { interface: CacheInterfaceId, reason: CatalogProjectionRefusalReason }

fn catalog_keying(kd: CatalogKeyDerivationFacts) -> CacheKeying {
  if kd.prefix_fallback_allowed {
    ExistenceKeyed
  } else {
    match kd.key_inputs {
      ContentAddressed => ContentKeyed
      NativeInternal { cited_inputs: _ } => ContentKeyed
      HandAuthored { cited_inputs: _ } => ExistenceKeyed
    }
  }
}

fn catalog_tier(p: CacheInterfaceCatalogPlacement, keying: CacheKeying) -> ProviderTier {
  match p.locality {
    InProcess => MemoTier { keying: keying }
    PerRunnerFilesystem => ArtifactTier { keying: keying }
    PerHostFilesystem => ArtifactTier { keying: keying }
    CrossHostNetwork => CasTier { keying: keying }
  }
}

// PRESERVE, do not pre-verdict. The former shape answered two questions at
// once and got both wrong: every InProcess row was projected as ScopeExit with
// facts.placement.eviction DISCARDED (so a promoted in-process provider could
// not carry a byte bound at all), and Ttl / Lru / SizeBounded were all mapped
// to SpacePacked (so an age bound and a replacement ORDER each minted a space
// guarantee they never established). Retention now travels through unchanged
// and the CONSUMER's obligation decides what it requires — a witness-frame memo
// may legitimately be scope-released with unbounded capacity, while a promoted
// entry-scoped memo or a cross-run store demands a real ceiling.
fn catalog_retention(facts: CacheInterfaceCatalogFacts) -> ProviderRetention {
  facts.placement.retention
}

fn provider_from_catalog(
  facts: CacheInterfaceCatalogFacts,
  scope: List<Frame>,
  coverage: CacheCoverage
) -> CatalogProviderProjection {
  let keying = catalog_keying(kd: facts.key_derivation)
  let tier = catalog_tier(p: facts.placement, keying: keying)
  ProjectedProvider {
    provider: provider_row(
      id: facts.identity,
      scope: scope,
      coverage: coverage,
      tier: tier,
      retention: catalog_retention(facts: facts)
    )
  }
}

// ELIGIBILITY is a separate question from ACCOUNTING: a row may be classified
// completely and still be ineligible for a role whose obligation it cannot
// discharge. Accounting asks "is every cache classified?"; eligibility asks
// "does THIS cache have enough facts for THIS role?"; completion asks "is every
// provider the live plan requires eligible?". One predicate answering all three
// is how a refusal count became a copied expected number instead of a finding.
fn provider_for_growth_bounded_role(
  facts: CacheInterfaceCatalogFacts,
  scope: List<Frame>,
  coverage: CacheCoverage
) -> CatalogProviderProjection {
  role_door(facts: facts, scope: scope, coverage: coverage,
            ok: retention_growth_is_bounded(r: catalog_retention(facts: facts)))
}

fn provider_for_capacity_bounded_role(
  facts: CacheInterfaceCatalogFacts,
  scope: List<Frame>,
  coverage: CacheCoverage
) -> CatalogProviderProjection {
  role_door(facts: facts, scope: scope, coverage: coverage,
            ok: retention_has_capacity_bound(r: catalog_retention(facts: facts)))
}

fn provider_for_exact_byte_budget_role(
  facts: CacheInterfaceCatalogFacts,
  scope: List<Frame>,
  coverage: CacheCoverage
) -> CatalogProviderProjection {
  role_door(facts: facts, scope: scope, coverage: coverage,
            ok: retention_has_exact_byte_bound(r: catalog_retention(facts: facts)))
}

fn role_door(
  facts: CacheInterfaceCatalogFacts,
  scope: List<Frame>,
  coverage: CacheCoverage,
  ok: Bool
) -> CatalogProviderProjection {
  if ok {
    provider_from_catalog(facts: facts, scope: scope, coverage: coverage)
  } else {
    ProjectionRefused {
      interface: facts.identity,
      reason: capacity_refusal_reason(c: catalog_retention(facts: facts).capacity)
    }
  }
}

// Folds over the capacity STATE, so the two refusal causes are the only ones
// constructible. A first cut had the CapacityBounded arm return
// CapacityUnobservedForBoundedRole - an unreachable arm returning a FALSE cause,
// which would have mislabelled every future refusal that reached it. A bounded
// capacity that still fails a role fails on the limit's unit or evidence, and
// that is the role door's business, not this fold's.
fn capacity_refusal_reason(c: CapacityPolicy) -> CatalogProjectionRefusalReason {
  match c {
    CapacityUnbounded => CapacityUnboundedForRole
    CapacityUnobserved => CapacityUnobservedForRole
    CapacityBounded { limit: l, at_capacity: _ } => capacity_limit_refusal_reason(l: l)
  }
}

fn capacity_limit_refusal_reason(l: CapacityLimit) -> CatalogProjectionRefusalReason {
  match l {
    EntryCountCapacity { limit: _ } => CapacityUnitMismatchForRole
    ByteCapacity { limit: v } => match v {
      ExactLimit { value: _ } => CapacityUnitMismatchForRole
      RuntimeDerivedLimit { authority: _ } => CapacityValueUnresolvedForRole
      EffectiveLimitUnobserved => CapacityValueUnobservedForRole
    }
  }
}

fn projection_is_refused(p: CatalogProviderProjection) -> Bool {
  match p {
    ProjectedProvider { provider: _ } => false
    ProjectionRefused { interface: _, reason: _ } => true
  }
}

fn projected_providers(ps: List<CatalogProviderProjection>) -> List<CacheProvider> {
  ps |> flat_map(p => match p {
    ProjectedProvider { provider: prov } => [prov]
    ProjectionRefused { interface: _, reason: _ } => []
  })
}

fn projection_refusal_count(ps: List<CatalogProviderProjection>) -> Int {
  ps |> filter(p => projection_is_refused(p: p)) |> count()
}
