module extdeps.cache.github_actions



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/actions/using-workflows/caching-dependencies-to-speed-up-workflows"
  }
}

data gha_actions_cache_id: std.cache_identity.CacheInterfaceId = "gha_actions_cache"

data gha_actions_cache_facts: extdeps.cache.types.CacheInterfaceCatalogFacts = {
  identity: gha_actions_cache_id
  backing_surface: "github-actions-cache-api"
  transport_encoding: extdeps.cache.types.CatalogOpaqueStringEncoding
  key_derivation: {

    key_inputs: extdeps.cache.types.HandAuthored { cited_inputs: [extdeps.cache.types.UpsertSubject, extdeps.cache.types.FilePaths] }
    overwritable: true
    prefix_fallback_allowed: true
    content_verified_on_read: false
    visibility_scope: std.cache_interface.Repo
    invalidation_triggers: [std.cache_interface.ManualPurge, std.cache_interface.ToolchainChange, std.cache_interface.DependencyChange]
  }
  io: {
    lookup_semantics: std.cache_interface.PrefixFallback {
      ordered_prefixes: [
        "exact-subject-digest",
        "toolchain-pinned",
        "lockfile-pinned",
        "runner-scoped",
      ]
    }
    write_semantics: std.cache_interface.OverwriteAllowed
    miss_semantics: std.cache_interface.MissThenCreate
  }
  placement: {
    value_shape: std.cache_interface.TarArchive
    locality: std.cache_interface.CrossHostNetwork
    retention: { release_policy: std.cache_interface.ReleasedNever, capacity: std.cache_interface.CapacityBounded { limit: std.cache_interface.ByteCapacity { limit: std.cache_interface.EffectiveLimitUnobserved }, at_capacity: std.cache_interface.ReplaceExisting { strategy: std.cache_interface.LeastRecentlyUsed } } }
    atomicity: std.cache_interface.WriteThenCommit
    auth: std.cache_interface.ApiKey
    read_latency: std.cache_interface.WanTensMs
    consistency: std.cache_interface.Eventual
  }
  evidence: [
    {
      field: "lookup_semantics"
      evidence: std.cache_interface.VendorCitation {
        source: "GitHub Actions cache restore-key behavior"
        url: "https://docs.github.com/en/actions/using-workflows/caching-dependencies-to-speed-up-workflows"
      }
    },
    {
      field: "key_derivation"
      evidence: std.cache_interface.VendorCitation {
        source: "GitHub Actions cache key input"
        url: "https://docs.github.com/en/actions/using-workflows/caching-dependencies-to-speed-up-workflows#usage-limits-and-eviction-policy"
      }
    },
  ]
}
