module extdeps.cache.catalog_placement



data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/cache"
  }
}

type CacheInterfaceCatalogPlacement {
  value_shape: std.cache_interface.ValueShape
  locality: std.cache_interface.PersistenceLocality
  retention: std.cache_interface.ProviderRetention
  atomicity: std.cache_interface.AtomicityModel
  auth: std.cache_interface.AuthScope
  read_latency: std.cache_interface.ReadLatencyClass
  consistency: std.cache_interface.ConsistencyModel
}
