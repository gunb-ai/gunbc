module extdeps.cache.key_completeness



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/cache"
  }
}

fn cache_key_derivation_complete(facts: extdeps.cache.types.CatalogKeyDerivationFacts) -> Bool {
  match facts.key_inputs {
    extdeps.cache.types.ContentAddressed => true
    extdeps.cache.types.HandAuthored { cited_inputs: _ } => true
    extdeps.cache.types.NativeInternal { cited_inputs: cited } =>
      if extdeps.cache.types.invalidation_triggers_on_toolchain_change(triggers: facts.invalidation_triggers) {
        extdeps.cache.types.catalog_has_vendor_only_key_inputs(inputs: cited)
      } else {
        true
      }
  }
}

fn cache_catalog_key_completeness_holds(catalog: List<extdeps.cache.types.CacheInterfaceCatalogFacts>) -> Bool {
  all(catalog, row => cache_key_derivation_complete(facts: row.key_derivation))
}
