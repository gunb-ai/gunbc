module extdeps.cache.pin

import std.types { NonEmptyStr, String, ContentHash }
import extdeps.pin {
  Pin,
  ExactPin,
  SubjectProjectedPin,
  SubjectProjectedPinAdmission,
  SubjectProjectedPinIntegrityAdmitted,
  PinRefused,
  ObservedIdentityMismatch,
  TrackedResolutionUnrecorded,
  subject_projected_pin_as_pin,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.cache.sccache {
  SccacheBinaryArtifact,
  SccacheMuslAarch64,
  SccacheMuslX86_64,
  sccache_binary_artifact_content_identity,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri { scheme: Https, locator: "github.com/mozilla/sccache/releases" }
}

data sccache_pin_instantiation_note: String = "THE INSTANTIATION for extdeps.cache.sccache's multi-artifact release rows. extdeps.pin owns the pinning DIMENSION as Pin<Subject> or, when the subject fully determines cited digest identity, SubjectProjectedPin<Subject> (review 44999 — no independently writable expected_identity field). SccacheBinaryArtifact carries the cited Digest for its arch; content identity is projected only via sccache_binary_artifact_content_identity, never stored a second time on the pin carrier. Pin<SccacheBinaryRelease> remains unsound — one release row carries two digests — so the subject is the artifact product at sccache_binary_artifact_grain_note. Version lives on subject.binary_release only (Pin.version Absent on the reconcile bridge). P2 membership_reconcile consumes subject_projected_pin_as_pin at the generic boundary when it needs Pin<SccacheBinaryArtifact>. extdeps_external_authority_anchor carries the same locator as sccache_releases_authority; datum-alias form is unwritable for mandatory-tag corpus_scan projection (review 44866)."

fn sccache_binary_artifact_pin(artifact: SccacheBinaryArtifact) -> SubjectProjectedPin<SccacheBinaryArtifact> {
  SubjectProjectedPin {
    subject: artifact,
    selection: ExactPin,
  }
}

fn admit_sccache_binary_artifact_pin_integrity(
  pin: SubjectProjectedPin<SccacheBinaryArtifact>,
  observed_identity: ContentHash,
) -> SubjectProjectedPinAdmission<SccacheBinaryArtifact> {
  let expected = sccache_binary_artifact_content_identity(artifact: pin.subject)
  match pin.selection {
    TrackedChannel { channel: c, refresh_window_days: _ } =>
      PinRefused {
        subject: pin.subject,
        cause: TrackedResolutionUnrecorded { channel: c },
      }
    ExactPin =>
      if expected == observed_identity {
        SubjectProjectedPinIntegrityAdmitted { pin: pin }
      } else {
        PinRefused {
          subject: pin.subject,
          cause: ObservedIdentityMismatch {
            expected: expected,
            observed: observed_identity,
          },
        }
      }
  }
}

fn sccache_binary_artifact_pin_key_of(pin: SubjectProjectedPin<SccacheBinaryArtifact>) -> NonEmptyStr {
  match pin.subject.arch {
    SccacheMuslAarch64 =>
      join([pin.subject.binary_release.version as String, "-aarch64"], "") as NonEmptyStr
    SccacheMuslX86_64 =>
      join([pin.subject.binary_release.version as String, "-x86_64"], "") as NonEmptyStr
  }
}

fn sccache_binary_artifact_subject_projected_pin_value_eq(
  a: SubjectProjectedPin<SccacheBinaryArtifact>,
  b: SubjectProjectedPin<SccacheBinaryArtifact>,
) -> Bool {
  (a.subject == b.subject) && (a.selection == b.selection)
}

fn sccache_binary_artifact_subject_projected_pin_as_pin(
  pin: SubjectProjectedPin<SccacheBinaryArtifact>,
) -> Pin<SccacheBinaryArtifact> {
  subject_projected_pin_as_pin(
    pin: pin,
    expected_identity: sccache_binary_artifact_content_identity(artifact: pin.subject),
  )
}
