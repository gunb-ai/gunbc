module extdeps.cache.pin

import std.types { NonEmptyStr, String, ContentHash }
import extdeps.version { VersionIdentity }
import extdeps.pin {
  Pin,
  ExactPin,
  SubjectProjectedPin,
  SubjectProjectedPinAdmission,
  SubjectProjectedPinIntegrityAdmitted,
  PinRefused,
  ObservedIdentityMismatch,
  TrackedResolutionUnrecorded,
  subject_projected_pin_as_pin,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.cache.sccache {
  SccacheBinaryArtifact,
  SccacheMuslAarch64,
  SccacheMuslX86_64,
  sccache_binary_artifact_content_identity,
  sccache_releases_authority,
}

data extdeps_external_authority_anchor: ExternalAuthority = sccache_releases_authority

data sccache_pin_instantiation_note: String = "THE INSTANTIATION at dag/extdeps/cache/pin.dag for extdeps.cache.sccache multi-artifact release rows. extdeps.pin owns Pin<Subject> or SubjectProjectedPin<Subject> when the subject fully determines cited digest identity (review 44999). SccacheBinaryArtifact carries cited extdeps.crypto.hash.Digest for its arch; sccache_binary_artifact_content_identity converts via extdeps.crypto.hash.sha256_digest_content_hash into std.types.ContentHash — rendering, not a second digest concept (deep-eagle-728 oracle msg_fac61885). Identity is projected at admission and bridge; never stored twice on SubjectProjectedPin. Version is projected from subject.binary_release.version at the reconcile bridge (Pin.version required on Pin<Subject>, msg_fac61885). Pin<SccacheBinaryRelease> remains unsound at release grain. extdeps_external_authority_anchor datum-binds to sccache_releases_authority in extdeps.cache.sccache — one releases URI, consumed not re-spelled (review 45011); the fixed decl name is mandatory-tag machinery, not a second citation."

fn sccache_binary_artifact_pin_version(artifact: SccacheBinaryArtifact) -> VersionIdentity {
  artifact.binary_release.version as VersionIdentity
}

fn sccache_binary_artifact_pin(artifact: SccacheBinaryArtifact) -> SubjectProjectedPin<SccacheBinaryArtifact> {
  SubjectProjectedPin {
    subject: artifact,
    selection: ExactPin,
  }
}

fn admit_sccache_binary_artifact_pin_integrity(
  pin: SubjectProjectedPin<SccacheBinaryArtifact>,
  observed_identity: ContentHash,
) -> SubjectProjectedPinAdmission<SccacheBinaryArtifact> {
  let expected = sccache_binary_artifact_content_identity(artifact: pin.subject)
  match pin.selection {
    TrackedChannel { channel: c, refresh_window_days: _ } =>
      PinRefused {
        subject: pin.subject,
        cause: TrackedResolutionUnrecorded { channel: c },
      }
    ExactPin =>
      if expected == observed_identity {
        SubjectProjectedPinIntegrityAdmitted { pin: pin }
      } else {
        PinRefused {
          subject: pin.subject,
          cause: ObservedIdentityMismatch {
            expected: expected,
            observed: observed_identity,
          },
        }
      }
  }
}

fn sccache_binary_artifact_pin_key_of(pin: SubjectProjectedPin<SccacheBinaryArtifact>) -> NonEmptyStr {
  match pin.subject.arch {
    SccacheMuslAarch64 =>
      join([pin.subject.binary_release.version as String, "-aarch64"], "") as NonEmptyStr
    SccacheMuslX86_64 =>
      join([pin.subject.binary_release.version as String, "-x86_64"], "") as NonEmptyStr
  }
}

fn sccache_binary_artifact_subject_projected_pin_value_eq(
  a: SubjectProjectedPin<SccacheBinaryArtifact>,
  b: SubjectProjectedPin<SccacheBinaryArtifact>,
) -> Bool {
  (a.subject == b.subject) && (a.selection == b.selection)
}

fn sccache_binary_artifact_subject_projected_pin_as_pin(
  pin: SubjectProjectedPin<SccacheBinaryArtifact>,
) -> Pin<SccacheBinaryArtifact> {
  subject_projected_pin_as_pin(
    pin: pin,
    expected_identity: sccache_binary_artifact_content_identity(artifact: pin.subject),
    version: sccache_binary_artifact_pin_version(artifact: pin.subject),
  )
}
