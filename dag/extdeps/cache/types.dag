module extdeps.cache.types



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/cache"
  }
}

type CatalogInputSurface
  = UpsertSubject
  | FilePaths
  | RustcInvocation
  | ToolchainSpec

type CatalogProviderKeyEncoding
  = CatalogOpaqueStringEncoding
  | CatalogCasContentEncoding
  | SccacheInternalEncoding
  | CargoFingerprintEncoding

type CatalogProviderKey
  = CatalogOpaqueStringKey { key: std.types.NonEmptyStr }
  | SccacheInternalHash { digest: std.content_hash.ContentHash }
  | CatalogCasContentDigest { digest: std.content_hash.ContentHash }
  | CargoFingerprint { digest: std.content_hash.ContentHash }

type CatalogBackendCacheKey {
  store: std.cache_identity.CacheInterfaceId
  key: CatalogProviderKey
}

type CatalogKeyInputs
  = ContentAddressed
  | NativeInternal { cited_inputs: List<CatalogInputSurface> }
  | HandAuthored { cited_inputs: List<CatalogInputSurface> }

type CatalogKeyDerivationFacts {
  key_inputs: CatalogKeyInputs
  overwritable: Bool
  prefix_fallback_allowed: Bool
  content_verified_on_read: Bool
  visibility_scope: std.cache_interface.VisibilityScope
  invalidation_triggers: List<std.cache_interface.InvalidationTrigger>
}

fn invalidation_triggers_on_toolchain_change(triggers: List<std.cache_interface.InvalidationTrigger>) -> Bool {
  triggers |> any(trigger => match trigger {
    std.cache_interface.ToolchainChange => true
    std.cache_interface.TtlExpiry { window: _ } => false
    std.cache_interface.ManualPurge => false
    std.cache_interface.DependencyChange => false
  })
}

fn content_addressed_inputs(triggers: List<std.cache_interface.InvalidationTrigger>) -> List<CatalogInputSurface> {
  if invalidation_triggers_on_toolchain_change(triggers: triggers) {
    [UpsertSubject, ToolchainSpec]
  } else {
    [UpsertSubject]
  }
}

fn catalog_inputs_considered(kd: CatalogKeyDerivationFacts) -> List<CatalogInputSurface> {
  match kd.key_inputs {
    ContentAddressed => content_addressed_inputs(triggers: kd.invalidation_triggers)
    NativeInternal { cited_inputs: cited } => cited
    HandAuthored { cited_inputs: cited } => cited
  }
}

fn catalog_key_derivation_classification(kd: CatalogKeyDerivationFacts) -> std.cache_interface.KeyDerivationClass {
  match kd.key_inputs {
    ContentAddressed => std.cache_interface.ContentAddressedByValue
    NativeInternal { cited_inputs: _ } => std.cache_interface.NativeInternalHash
    HandAuthored { cited_inputs: _ } => std.cache_interface.HandAuthoredString
  }
}

type CacheInterfaceCatalogFacts {
  identity: std.cache_identity.CacheInterfaceId
  backing_surface: std.cache_interface.StorageSurface
  transport_encoding: CatalogProviderKeyEncoding
  key_derivation: CatalogKeyDerivationFacts
  io: extdeps.cache.catalog_io.CacheInterfaceCatalogIoSemantics
  placement: extdeps.cache.catalog_placement.CacheInterfaceCatalogPlacement
  evidence: List<std.cache_interface.CacheEvidence>
}

type CatalogCachedArtifactReceipt<T> {
  artifact: std.cache_interface.ArtifactIdentity<T>
  backend_key: CatalogBackendCacheKey
  producer: std.cache_interface.ProducerReceipt<T>
  content_digest: std.content_hash.ContentHash
}

fn catalog_has_vendor_only_key_inputs(inputs: List<CatalogInputSurface>) -> Bool {
  inputs |> any(input => match input {
    RustcInvocation => true
    ToolchainSpec => true
    UpsertSubject => false
    FilePaths => false
  })
}

fn catalog_transport_encoding_collapsed_in_std_projection(encoding: CatalogProviderKeyEncoding) -> Bool {
  match encoding {
    CatalogOpaqueStringEncoding => false
    CatalogCasContentEncoding => false
    SccacheInternalEncoding => false
    CargoFingerprintEncoding => true
  }
}
