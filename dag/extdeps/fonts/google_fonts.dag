module extdeps.fonts.google_fonts

import std.types { String, CommitSha, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https, uri_https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/google/fonts/tree/7085eb89a950e85db5b166b7a58d414544b4140c"
  }
}

data sil_open_font_license_1_1: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "openfontlicense.org/open-font-license-official-text/"
  }
}

// Cited upstream: the google/fonts repository, the distribution this repository reads font
// sources from, pinned at one commit (7085eb89a950e85db5b166b7a58d414544b4140c, committed
// 2026-10-05T18:00:35Z). Both families are read from that one upstream at that one commit, so they
// share this module; each family's own project (googlefonts/roboto-classic, googlefonts/googlesans)
// is the copyright holder named in its OFL.txt, not a source this repository reads.
//
// Both directories sit under ofl/ and carry the SIL Open Font License 1.1 as OFL.txt, whose
// copyright lines declare no Reserved Font Name, so a subset may keep the family name. The two
// licence texts are committed verbatim at the paths in licence_copy. Google Sans additionally
// ships ofl/googlesans/TRADEMARKS.md: the name is a trademark, which the licence does not grant.
//
// What this module states is upstream fact only: the commit, where each family's variable source
// file is, its licence. The faces this repository DERIVES from those files (instance, subset,
// WOFF2, digests) are this repository's receipts and live with their consumer.

type GoogleFontsFamilySource {
  family: String
  commit: CommitSha
  source_path: String
  licence_path: String
  licence: ExternalAuthority
  licence_copy: String
}

data google_fonts_commit: CommitSha = "7085eb89a950e85db5b166b7a58d414544b4140c"

data roboto_source: GoogleFontsFamilySource = GoogleFontsFamilySource {
  family: "Roboto",
  commit: google_fonts_commit,
  source_path: "ofl/roboto/Roboto[wdth,wght].ttf",
  licence_path: "ofl/roboto/OFL.txt",
  licence: sil_open_font_license_1_1,
  licence_copy: "LICENSES/OFL-1.1-Roboto.txt",
}

// The two faces gunb.ai's page asks Google to serve, filed as upstream fact in the same form as the
// rows above. Verified against this module's pinned commit 2026-10-18: ofl/jetbrainsmono/
// JetBrainsMono[wght].ttf and ofl/notosans/NotoSans[wdth,wght].ttf both exist there (HTTP 200 on
// raw.githubusercontent at google/fonts@7085eb8), each with its OFL.txt, whose text is the licence
// copy beside it. Consumer: gunbc.site.gunb_ai_page reads .family and .weights to build the one
// css2 request the page makes (DESIGN §3c — these rows did not exist before that page needed them).
data jetbrains_mono_source: GoogleFontsFamilySource = GoogleFontsFamilySource {
  family: "JetBrains Mono",
  commit: google_fonts_commit,
  source_path: "ofl/jetbrainsmono/JetBrainsMono[wght].ttf",
  licence_path: "ofl/jetbrainsmono/OFL.txt",
  licence: sil_open_font_license_1_1,
  licence_copy: "LICENSES/OFL-1.1-JetBrainsMono.txt",
}

data noto_sans_source: GoogleFontsFamilySource = GoogleFontsFamilySource {
  family: "Noto Sans",
  commit: google_fonts_commit,
  source_path: "ofl/notosans/NotoSans[wdth,wght].ttf",
  licence_path: "ofl/notosans/OFL.txt",
  licence: sil_open_font_license_1_1,
  licence_copy: "LICENSES/OFL-1.1-NotoSans.txt",
}

// The weights a page asks a variable family to serve. A closed row, not a free Int: the css2 API
// rejects a weight the family does not carry, so which weights are requestable is upstream fact.
// Both rows are the weights the live gunb.ai page requests (its stylesheet uses 400/500 for the
// mono face and 400/500/600 for the sans face), verified 2026-10-18 against the served
// assets/site.css and index.html rather than from memory.
data jetbrains_mono_weights: List<Int> = [400, 500]
data noto_sans_weights: List<Int> = [400, 500, 600]

data google_sans_source: GoogleFontsFamilySource = GoogleFontsFamilySource {
  family: "Google Sans",
  commit: google_fonts_commit,
  source_path: "ofl/googlesans/GoogleSans[GRAD,opsz,wght].ttf",
  licence_path: "ofl/googlesans/OFL.txt",
  licence: sil_open_font_license_1_1,
  licence_copy: "LICENSES/OFL-1.1-GoogleSans.txt",
}

// The hosts a page loads Google Fonts from, and the css2 endpoint it requests faces at. Upstream
// interface facts (Google Fonts serves the stylesheet from the API host and the font files from the
// static host; the stylesheet request is the css2 endpoint), declared as Uri values like the
// anchors above. Consumer: gunbc.site.gunb_ai_page, which preconnects to the two hosts and builds
// its one stylesheet request from the endpoint.
data google_fonts_api_host: Uri = uri_https(locator: "fonts.googleapis.com" as NonEmptyStr)
data google_fonts_static_host: Uri = uri_https(locator: "fonts.gstatic.com" as NonEmptyStr)
data google_fonts_css2_endpoint: Uri = uri_https(locator: "fonts.googleapis.com/css2" as NonEmptyStr)

// A row above, spelled as the URL a page's href carries. Every row here is Https, built with
// uri_https, so the scheme prefix is the one this reads.
fn google_fonts_url(uri: Uri) -> String {
  join(["https://", uri.locator as String], "")
}
