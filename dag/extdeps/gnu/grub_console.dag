module extdeps.gnu.grub_console

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.algebra { trim }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// GNU GRUB 2.12, the boot loader the Ubuntu 24.04 install media carry. The statements below are
// GRUB's own console strings, cited to the source files that print them (tag grub-2.12):
// grub-core/normal/menu.c prints "Failed to boot both default and fallback entries." when the
// selected entry and its fallback both return without booting; grub-core/loader/arm64/linux.c
// (via grub_error GRUB_ERR_BAD_ARGUMENT) prints "you need to load the kernel first" when a boot
// command runs before a kernel was loaded; grub-core/kern/disk.c prints "failure reading sector
// 0x%llx from `%s'" when the underlying disk read fails. Read here, NOT in the machine-intake
// layer, because they are GRUB's vocabulary and would be nicknamed if re-coined there.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "git.savannah.gnu.org/cgit/grub.git/tree/?h=grub-2.12"
  }
}

data grub_console_banner_prefix: NonEmptyStr = "GNU GRUB  version "
data grub_failed_default_and_fallback: NonEmptyStr = "Failed to boot both default and fallback entries."
data grub_error_prefix: NonEmptyStr = "error: "
data grub_kernel_not_loaded: NonEmptyStr = "you need to load the kernel first."
data grub_disk_read_failure_prefix: NonEmptyStr = "failure reading sector "

// WHAT A GRUB CONSOLE ESTABLISHED, read from the lines the boot loader printed. Only the
// "failed both entries" statement is TERMINAL: GRUB returns to its menu and waits, so the boot
// has ended without a kernel. A read failure or a kernel-not-loaded error may precede it or
// stand alone while GRUB is still trying (a fallback entry can still succeed), so those are
// carried as the loader's stated cause beside the terminal statement, never promoted to it.
type GrubConsoleReport
  = GrubNothingStated
  | GrubBannerOnly
  | GrubStillTrying { errors: List<NonEmptyStr> }
  | GrubBootFailed { errors: List<NonEmptyStr> }

fn grub_error_statement(line: String) -> NonEmptyStr? {
  let clean = trim(s: line)
  if starts_with(s: clean, prefix: grub_error_prefix as String) {
    Present { value: clean as NonEmptyStr }
  } else {
    none
  }
}

type GrubConsoleFold {
  banner: Bool
  failed: Bool
  errors: List<NonEmptyStr>
}

fn grub_console_step(acc: GrubConsoleFold, line: String) -> GrubConsoleFold {
  let clean = trim(s: line)
  if starts_with(s: clean, prefix: grub_console_banner_prefix as String) {
    GrubConsoleFold { banner: true, failed: acc.failed, errors: acc.errors }
  } else if clean == (grub_failed_default_and_fallback as String) {
    GrubConsoleFold { banner: acc.banner, failed: true, errors: acc.errors }
  } else {
    match grub_error_statement(line: clean) {
      Absent => acc
      Present { value: e } => GrubConsoleFold { banner: acc.banner, failed: acc.failed, errors: append(acc.errors, items: [e]) }
    }
  }
}

fn grub_console_report(lines: List<String>) -> GrubConsoleReport {
  let f = fold(lines, init: GrubConsoleFold { banner: false, failed: false, errors: [] }, f: (acc, l) => grub_console_step(acc: acc, line: l))
  if f.failed {
    GrubBootFailed { errors: f.errors }
  } else if count(f.errors) > 0 {
    GrubStillTrying { errors: f.errors }
  } else if f.banner {
    GrubBannerOnly
  } else {
    GrubNothingStated
  }
}
