module extdeps.census.name_frequency

import std.types { List, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// The U.S. Census Bureau's published name-frequency tables, the public-domain corpus the fleet's
// human host names are drawn from (gunbc.hostname_allocation). Two tables, two vintages, one
// publisher: the given names come from the 1990 decennial census tables, the only given-name
// frequency list the Bureau publishes, and the surnames from the 2010 decennial census table.
// The SSA baby-names list was the operator's first choice (2026-10-07); its download refused an
// automated read, and the Census given-name table is the same kind of fact from the same kind of
// authority, so it stands here rather than a hand-transcribed copy of the SSA list.
//
// WHAT IS VENDORED: lowercase spellings, in published rank order. Given names interleave the
// female and male tables rank by rank (top 100 of each, first occurrence kept); surnames are the
// top 200 alphabetic entries of the 2010 table. Every entry is a lowercase ASCII letter string,
// so each is a legal DNS label on its own. The ORDER is part of the fact: a recorded draw indexes
// these lists, so reordering or extending them changes what an old draw denotes -- a later
// vintage is a new pair of rows beside these, never an edit to them.

data census_1990_given_name_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www2.census.gov/topics/genealogy/1990surnames/dist.female.first"
  }
}

data census_1990_male_given_name_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www2.census.gov/topics/genealogy/1990surnames/dist.male.first"
  }
}

data census_2010_surname_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www2.census.gov/topics/genealogy/2010surnames/names.zip"
  }
}

