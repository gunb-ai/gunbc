module extdeps.container.oci.runtime_config

import extdeps.container.oci.linux {
  LinuxPlatform,
  accept_linux_platform,
  LinuxPlatformAccepted,
  LinuxPlatformRejected,
}
import extdeps.container.oci.types {
  OciRuntimeVersion,
  RuntimeMountKind,
  RuntimeMountSource,
}
import std.types { Bool, FilePath, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/opencontainers/runtime-spec/blob/main/config.md"
  }
}

type RuntimeProcess {
  terminal: Bool?
  cwd: FilePath
  env: List<String>?
  args: List<String>?
}

type RuntimeRoot {
  path: FilePath
  readonly: Bool?
}

type RuntimeMount {
  destination: FilePath
  source: RuntimeMountSource?
  mount_type: RuntimeMountKind?
  options: List<String>?
}

type RuntimeBundleConfig {
  ociVersion: OciRuntimeVersion
  process: RuntimeProcess?
  root: RuntimeRoot?
  mounts: List<RuntimeMount>?
  linux: LinuxPlatform?
}

type RuntimeConfigRejectReason
  = EmptyOciVersion
  | MissingRoot
  | EmptyRootPath
  | MissingProcessCwd
  | LinuxPlatformInvalid { detail: String }

type RuntimeConfigOutcome
  = RuntimeConfigAccepted { value: RuntimeBundleConfig }
  | RuntimeConfigRejected { reason: RuntimeConfigRejectReason }

fn accept_runtime_bundle_config(c: RuntimeBundleConfig) -> RuntimeConfigOutcome {
  if c.ociVersion == "" {
    RuntimeConfigRejected { reason: EmptyOciVersion }
  } else {
    match c.root {
      null => RuntimeConfigRejected { reason: MissingRoot }
      root =>
        if root.path == "" {
          RuntimeConfigRejected { reason: EmptyRootPath }
        } else {
          match c.process {
            null => accept_runtime_linux(c)
            proc =>
              if proc.cwd == "" {
                RuntimeConfigRejected { reason: MissingProcessCwd }
              } else {
                accept_runtime_linux(c)
              }
          }
        }
    }
  }
}

fn accept_runtime_linux(c: RuntimeBundleConfig) -> RuntimeConfigOutcome {
  match c.linux {
    null => RuntimeConfigAccepted { value: c }
    linux =>
      match accept_linux_platform(linux) {
        LinuxPlatformRejected { reason: _ } =>
          RuntimeConfigRejected { reason: LinuxPlatformInvalid { detail: "linux" } }
        LinuxPlatformAccepted { value: _ } =>
          RuntimeConfigAccepted { value: c }
      }
  }
}

fn runtime_mount_count(c: RuntimeBundleConfig) -> Int {
  match c.mounts {
    null => 0
    mounts => count(mounts)
  }
}
