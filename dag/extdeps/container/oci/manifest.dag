module extdeps.container.oci.manifest

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/opencontainers/image-spec/blob/main/manifest.md"
  }
}

type ImageManifest {
  schemaVersion: Int
  mediaType: OciMediaType
  config: OciDescriptor
  layers: List<OciDescriptor>
}

type ManifestRejectReason
  = WrongSchemaVersion { got: Int, expected: Int }
  | WrongMediaType { got: OciMediaType, expected: OciMediaType }
  | ConfigDescriptorRejected { detail: String }
  | LayerDescriptorRejected { index: Int, reason: DescriptorRejectReason }
  | LayerMissing { index: Int }
  | EmptyLayers

type ManifestOutcome
  = ManifestAccepted { value: ImageManifest }
  | ManifestRejected { reason: ManifestRejectReason }

fn accept_image_manifest(m: ImageManifest) -> ManifestOutcome {
  if m.schemaVersion != oci_image_schema_version {
    ManifestRejected {
      reason: WrongSchemaVersion { got: m.schemaVersion, expected: oci_image_schema_version },
    }
  } else if m.mediaType != media_type_oci_image_manifest_v1 {
    ManifestRejected {
      reason: WrongMediaType { got: m.mediaType, expected: media_type_oci_image_manifest_v1 },
    }
  } else {
    match accept_descriptor(m.config) {
      DescriptorRejected { reason: _ } =>
        ManifestRejected { reason: ConfigDescriptorRejected { detail: "config" } }
      DescriptorAccepted { value: cfg } =>
        if cfg.mediaType != media_type_oci_image_config_v1 {
          ManifestRejected {
            reason: ConfigDescriptorRejected { detail: "config.mediaType" },
          }
        } else if count(m.layers) == 0 {
          ManifestRejected { reason: EmptyLayers }
        } else {
          accept_image_manifest_layers(m, index: 0)
        }
    }
  }
}

fn layer_at(layers: List<OciDescriptor>, index: Int) -> OciDescriptor? {
  match layers |> get(index) {
    null => null
    other => other
  }
}

fn accept_image_manifest_layers(m: ImageManifest, index: Int) -> ManifestOutcome {
  if index >= count(m.layers) {
    ManifestAccepted { value: m }
  } else {
    match layer_at(m.layers, index) {
      null =>
        ManifestRejected {
          reason: LayerMissing { index: index },
        }
      layer =>
        match accept_descriptor(layer) {
          DescriptorRejected { reason } =>
            ManifestRejected {
              reason: LayerDescriptorRejected { index: index, reason: reason },
            }
          DescriptorAccepted { value: _ } =>
            accept_image_manifest_layers(m, index: index + 1)
        }
    }
  }
}

fn manifest_layer_count(m: ImageManifest) -> Int {
  count(m.layers)
}

fn manifest_config_size(m: ImageManifest) -> Int {
  m.config.size
}
