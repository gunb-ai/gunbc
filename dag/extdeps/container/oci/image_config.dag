module extdeps.container.oci.image_config

data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "github.com/opencontainers/image-spec/blob/main/config.md"
  }
}

type ContainerImageConfig {
  User: std.types.NonEmptyStr?
  Env: List<String>?
  Entrypoint: List<String>?
  Cmd: List<String>?
  WorkingDir: std.types.FilePath?
  ExposedPorts: List<extdeps.container.oci.types.ContainerExposedPort>?
}

type ImageRootfs
  = RootfsLayers { diff_ids: List<extdeps.container.oci.digest.OciContentDigest> }

type ImageConfiguration {
  architecture: extdeps.toolchain.types.Architecture
  os: extdeps.toolchain.types.Os
  config: ContainerImageConfig?
  rootfs: ImageRootfs
}

type ImageConfigRejectReason
  = EmptyDiffIds
  | ImageConfigRejectUnspecified

type ImageConfigOutcome
  = ImageConfigAccepted { value: ImageConfiguration }
  | ImageConfigRejected { reason: ImageConfigRejectReason }

fn accept_image_configuration(c: ImageConfiguration) -> ImageConfigOutcome {
  match c.rootfs {
    RootfsLayers { diff_ids: ids } =>
      if count(ids) == 0 {
        ImageConfigRejected { reason: EmptyDiffIds }
      } else {
        ImageConfigAccepted { value: c }
      }
  }
}

fn image_config_layer_count(c: ImageConfiguration) -> Int {
  match c.rootfs {
    RootfsLayers { diff_ids: ids } => count(ids)
  }
}

fn image_config_entrypoint(c: ImageConfiguration) -> List<String> {
  match c.config {
    null => []
    cfg =>
      match cfg.Entrypoint {
        null => []
        ep => ep
      }
  }
}

fn image_config_first_exposed_port(c: ImageConfiguration) -> extdeps.container.oci.types.ContainerExposedPort? {
  match c.config {
    null => null
    cfg =>
      match cfg.ExposedPorts {
        null => null
        ports =>
          match ports |> get(0) {
            null => null
            port => port
          }
      }
  }
}

fn container_exposed_port_is(port: extdeps.container.oci.types.ContainerExposedPort, expected_port: Int, protocol: extdeps.container.oci.types.ContainerPortProtocol) -> Bool {
  port.port == expected_port && port.protocol == protocol
}

fn image_config_has_exposed_port(
  c: ImageConfiguration,
  expected_port: Int,
  protocol: extdeps.container.oci.types.ContainerPortProtocol,
) -> Bool {
  match image_config_first_exposed_port(c) {
    null => false
    port => container_exposed_port_is(port: port, expected_port: expected_port, protocol: protocol)
  }
}
