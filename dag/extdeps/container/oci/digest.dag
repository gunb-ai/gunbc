data oci_content_digest_note: String = "OCI digest authority (image-spec descriptor.md; distribution-spec digest): algorithm-qualified content address with wire form algorithm:encoded. Modelled as OciContentDigest coproduct (review 45466) — OciSha256Digest(Sha256Digest) | OciSha512Digest(Sha512Digest) | OciOtherDigest(OciOtherDigestBody) — so algorithm tag and payload cannot be forged independently. Both sha256 and sha512 arms carry std.content_hash digest carriers directly (operator portfolio 2026-08-04: npm is the second validated SHA-512 consumer that dissolved OciSha512DigestHex / OciSha512DigestBody). other body uses OciOtherDigestAlgorithm (String where oci_other_digest_algorithm — construction-walls reserved sha256/sha512 wire tokens and cites image-spec algorithm grammar algorithm-component ([a-z0-9]+) separated by [+._-], review 45505) plus OciOtherDigestEncoded (String where oci_other_digest_encoded — [a-zA-Z0-9=_-]+ per descriptor.md, review 45479/45731). Equality is substrate structural == on the coproduct (no parallel oci_content_digest_eq predicate)."

fn oci_encoded_digest_char_allowed(cp: Int) -> Bool {
  (cp >= 48 && cp <= 57)
    || (cp >= 65 && cp <= 90)
    || (cp >= 97 && cp <= 122)
    || cp == 61
    || cp == 95
    || cp == 45
}

fn oci_encoded_digest_syntax_valid(text: String, index: Int) -> Bool {
  if index >= text.length() {
    text.length() > 0
  } else {
    if oci_encoded_digest_char_allowed(
      cp: code_point(substring(s: text, start: index, end: index + 1)),
    ) {
      oci_encoded_digest_syntax_valid(text: text, index: index + 1)
    } else {
      false
    }
  }
}

fn oci_encoded_digest(text: String) -> OciOtherDigestEncoded? {
  if oci_other_digest_encoded(value: text) {
    Present { value: text as OciOtherDigestEncoded }
  } else {
    none
  }
}

fn oci_digest_algorithm_component_char_allowed(cp: Int) -> Bool {
  (cp >= 48 && cp <= 57) || (cp >= 97 && cp <= 122)
}

fn oci_digest_algorithm_separator_char_allowed(cp: Int) -> Bool {
  cp == 43 || cp == 46 || cp == 95 || cp == 45
}

fn oci_digest_algorithm_syntax_valid(text: String, index: Int, in_component: Bool) -> Bool {
  if index >= text.length() {
    in_component
  } else {
    let cp = code_point(substring(s: text, start: index, end: index + 1))
    if in_component {
      if oci_digest_algorithm_component_char_allowed(cp: cp) {
        oci_digest_algorithm_syntax_valid(
          text: text,
          index: index + 1,
          in_component: true,
        )
      } else if oci_digest_algorithm_separator_char_allowed(cp: cp) {
        oci_digest_algorithm_syntax_valid(
          text: text,
          index: index + 1,
          in_component: false,
        )
      } else {
        false
      }
    } else if oci_digest_algorithm_component_char_allowed(cp: cp) {
      oci_digest_algorithm_syntax_valid(
        text: text,
        index: index + 1,
        in_component: true,
      )
    } else {
      false
    }
  }
}

fn oci_digest_algorithm_wire_holds(algorithm: String) -> Bool {
  length(algorithm) > 0
    && oci_digest_algorithm_syntax_valid(text: algorithm, index: 0, in_component: false)
}

fn oci_other_digest_algorithm(value: String) -> Bool {
  oci_digest_algorithm_wire_holds(algorithm: value)
    && value != "sha256"
    && value != "sha512"
}

fn oci_other_digest_encoded(value: String) -> Bool {
  oci_encoded_digest_syntax_valid(text: value, index: 0)
}

type OciOtherDigestAlgorithm = String where oci_other_digest_algorithm

type OciOtherDigestEncoded = String where oci_other_digest_encoded

type OciOtherDigestBody {
  algorithm: OciOtherDigestAlgorithm
  encoded: OciOtherDigestEncoded
}

type OciContentDigest
  = OciSha256Digest(std.content_hash.Sha256Digest)
  | OciSha512Digest(std.content_hash.Sha512Digest)
  | OciOtherDigest(OciOtherDigestBody)

fn oci_content_digest_wire_algorithm(d: OciContentDigest) -> String {
  match d {
    OciSha256Digest(_) => "sha256"
    OciSha512Digest(_) => "sha512"
    OciOtherDigest(body) => body.algorithm as String
  }
}

fn oci_content_digest_encoded_hex(d: OciContentDigest) -> String {
  match d {
    OciSha256Digest(digest) => digest.hex as String
    OciSha512Digest(digest) => digest.hex as String
    OciOtherDigest(body) => body.encoded as String
  }
}

fn render_oci_content_digest_wire(d: OciContentDigest) -> String {
  concat(
    oci_content_digest_wire_algorithm(d: d),
    ":",
    oci_content_digest_encoded_hex(d: d),
  )
}

type OciWireDigestParts {
  algorithm: String
  encoded: String
}

fn oci_wire_digest_parts_from_split(algorithm: String, encoded: String) -> OciWireDigestParts {
  OciWireDigestParts {
    algorithm: algorithm,
    encoded: encoded,
  }
}

fn oci_wire_digest_parts(raw: String) -> OciWireDigestParts? {
  let parts = split(s: raw, delimiter: ":")
  if length(parts) != 2 {
    none
  } else {
    Present {
      value: oci_wire_digest_parts_from_split(
        algorithm: parts.first(),
        encoded: parts.skip(n: 1).first(),
      )
    }
  }
}

fn parse_oci_content_digest_wire(raw: String) -> OciContentDigest? {
  match oci_wire_digest_parts(raw: raw) {
    Present { value: parts } =>
      if parts.algorithm == "sha256" {
        match std.content_hash.sha256_hex_digest(hex: parts.encoded) {
          Present { value: digest } => Present { value: OciSha256Digest(digest) }
          Absent => none
        }
      } else if parts.algorithm == "sha512" {
        match std.content_hash.sha512_hex_digest(hex: parts.encoded) {
          Present { value: digest } => Present { value: OciSha512Digest(digest) }
          Absent => none
        }
      } else if !(oci_other_digest_algorithm(value: parts.algorithm)) {
        none
      } else {
        match oci_encoded_digest(text: parts.encoded) {
          Present { value: encoded } =>
            Present {
              value: OciOtherDigest(
                OciOtherDigestBody {
                  algorithm: parts.algorithm as OciOtherDigestAlgorithm,
                  encoded: encoded,
                },
              )
            }
          Absent => none
        }
      }
    Absent => none
  }
}

fn oci_sha256_content_digest(hex: String) -> OciContentDigest? {
  match std.content_hash.sha256_hex_digest(hex: hex) {
    Present { value: digest } =>
      Present {
        value: oci_content_digest_from_validated_sha256(digest: digest)
      }
    Absent => none
  }
}

fn oci_content_digest_from_validated_sha256(digest: std.content_hash.Sha256Digest) -> OciContentDigest {
  OciSha256Digest(digest)
}
