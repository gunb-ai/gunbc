module extdeps.container.oci.digest

import std.types { NonEmptyStr, String }
import std.content_hash {
  Sha256Digest,
  sha256_hex_digest,
  content_hash_validate_lower_hex_length,
}
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/opencontainers/image-spec/blob/main/descriptor.md"
  }
}

data oci_content_digest_note: String = "OCI digest authority (image-spec descriptor.md; distribution-spec digest): algorithm-qualified content address with wire form algorithm:encoded. Modelled as OciContentDigest coproduct (review 45466) — OciSha256Digest(Sha256Digest) | OciSha512Digest(OciSha512DigestBody) | OciOtherDigest(OciOtherDigestBody) — so algorithm tag and payload cannot be forged independently. sha256 arm carries std.content_hash.Sha256Digest directly; sha512 body uses OciSha512DigestHex (String where lower_hex_128); other body uses OciOtherDigestAlgorithm (String where oci_other_digest_algorithm — construction-walls reserved sha256/sha512 wire tokens and cites image-spec algorithm grammar algorithm-component ([a-z0-9]+) separated by [+._-], review 45505) plus NonEmptyStr encoded, minted through parse_oci_content_digest_wire with oci_encoded_digest syntax validation ([a-zA-Z0-9=_-]+ per descriptor.md, review 45479). Equality is substrate structural == on the coproduct (no parallel oci_content_digest_eq predicate). dissolve-on: cite digest-length law per algorithm when a second validated sha512 consumer needs more than length-128 wire check."

fn oci_encoded_digest_char_allowed(cp: Int) -> Bool {
  (cp >= 48 && cp <= 57)
    || (cp >= 65 && cp <= 90)
    || (cp >= 97 && cp <= 122)
    || cp == 61
    || cp == 95
    || cp == 45
}

fn oci_encoded_digest_syntax_valid(text: String, index: Int) -> Bool {
  if index >= text.length() {
    text.length() > 0
  } else {
    if oci_encoded_digest_char_allowed(
      cp: code_point(substring(s: text, start: index, end: index + 1)),
    ) {
      oci_encoded_digest_syntax_valid(text: text, index: index + 1)
    } else {
      false
    }
  }
}

fn oci_encoded_digest(text: String) -> NonEmptyStr? {
  if oci_encoded_digest_syntax_valid(text: text, index: 0) {
    Present { value: text as NonEmptyStr }
  } else {
    none
  }
}

fn oci_digest_algorithm_component_char_allowed(cp: Int) -> Bool {
  (cp >= 48 && cp <= 57) || (cp >= 97 && cp <= 122)
}

fn oci_digest_algorithm_separator_char_allowed(cp: Int) -> Bool {
  cp == 43 || cp == 46 || cp == 95 || cp == 45
}

fn oci_digest_algorithm_syntax_valid(text: String, index: Int, in_component: Bool) -> Bool {
  if index >= text.length() {
    in_component
  } else {
    let cp = code_point(substring(s: text, start: index, end: index + 1))
    if in_component {
      if oci_digest_algorithm_component_char_allowed(cp: cp) {
        oci_digest_algorithm_syntax_valid(
          text: text,
          index: index + 1,
          in_component: true,
        )
      } else if oci_digest_algorithm_separator_char_allowed(cp: cp) {
        oci_digest_algorithm_syntax_valid(
          text: text,
          index: index + 1,
          in_component: false,
        )
      } else {
        false
      }
    } else if oci_digest_algorithm_component_char_allowed(cp: cp) {
      oci_digest_algorithm_syntax_valid(
        text: text,
        index: index + 1,
        in_component: true,
      )
    } else {
      false
    }
  }
}

fn oci_digest_algorithm_wire_holds(algorithm: String) -> Bool {
  length(algorithm) > 0
    && oci_digest_algorithm_syntax_valid(text: algorithm, index: 0, in_component: false)
}

fn oci_other_digest_algorithm(value: String) -> Bool {
  oci_digest_algorithm_wire_holds(algorithm: value)
    && value != "sha256"
    && value != "sha512"
}

type OciSha512DigestHex = String where lower_hex_128

type OciOtherDigestAlgorithm = String where oci_other_digest_algorithm

type OciSha512DigestBody {
  hex: OciSha512DigestHex
}

type OciOtherDigestBody {
  algorithm: OciOtherDigestAlgorithm
  hex: NonEmptyStr
}

type OciContentDigest
  = OciSha256Digest(Sha256Digest)
  | OciSha512Digest(OciSha512DigestBody)
  | OciOtherDigest(OciOtherDigestBody)

fn oci_content_digest_wire_algorithm(d: OciContentDigest) -> String {
  match d {
    OciSha256Digest(_) => "sha256"
    OciSha512Digest(body) => "sha512"
    OciOtherDigest(body) => body.algorithm as String
  }
}

fn oci_content_digest_encoded_hex(d: OciContentDigest) -> String {
  match d {
    OciSha256Digest(digest) => digest.hex as String
    OciSha512Digest(body) => body.hex as String
    OciOtherDigest(body) => body.hex as String
  }
}

fn oci_content_digest_hex_is_empty(digest: OciContentDigest) -> Bool {
  oci_content_digest_encoded_hex(d: digest) == ""
}

fn render_oci_content_digest_wire(d: OciContentDigest) -> String {
  concat(
    oci_content_digest_wire_algorithm(d: d),
    ":",
    oci_content_digest_encoded_hex(d: d),
  )
}

fn parse_oci_content_digest_wire(raw: String) -> OciContentDigest? {
  if !(length(split(s: raw, delimiter: ":")) == 2) {
    none
  } else if split(s: raw, delimiter: ":").first() == "sha256" {
    match sha256_hex_digest(hex: split(s: raw, delimiter: ":").skip(n: 1).first()) {
      Present { value: digest } => Present { value: OciSha256Digest(digest) }
      Absent => none
    }
  } else if split(s: raw, delimiter: ":").first() == "sha512" {
    let hex = split(s: raw, delimiter: ":").skip(n: 1).first()
    if content_hash_validate_lower_hex_length(text: hex, expected_hex_digits: 128) {
      Present {
        value: OciSha512Digest(
          OciSha512DigestBody {
            hex: hex as OciSha512DigestHex,
          },
        )
      }
    } else {
      none
    }
  } else {
    let algo = split(s: raw, delimiter: ":").first()
    let encoded = split(s: raw, delimiter: ":").skip(n: 1).first()
    if !(oci_other_digest_algorithm(value: algo)) {
      none
    } else {
      match oci_encoded_digest(text: encoded) {
        Present { value: hex } =>
          Present {
            value: OciOtherDigest(
              OciOtherDigestBody {
                algorithm: algo as OciOtherDigestAlgorithm,
                hex: hex,
              },
            )
          }
        Absent => none
      }
    }
  }
}

fn oci_sha256_content_digest(hex: String) -> OciContentDigest? {
  match sha256_hex_digest(hex: hex) {
    Present { value: digest } =>
      Present {
        value: oci_content_digest_from_validated_sha256(digest: digest)
      }
    Absent => none
  }
}

fn oci_content_digest_from_validated_sha256(digest: Sha256Digest) -> OciContentDigest {
  OciSha256Digest(digest)
}
