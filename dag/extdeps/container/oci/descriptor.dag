module extdeps.container.oci.descriptor

import extdeps.container.oci.digest { OciContentDigest }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.container.oci.types { OciMediaType }
import std.types { Int }
import extdeps.external_authority { ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/opencontainers/image-spec/blob/main/descriptor.md"
  }
}

// Reading: github.com owns the surface this module models, cited by the authority above. The
// module's subject under that citation is its type declaration OciDescriptor, so that is the scope's
// subject and the citation above is its first citation.
data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.container.oci.descriptor",
      decl_name: "OciDescriptor",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

type OciDescriptor {
  mediaType: OciMediaType
  digest: OciContentDigest
  size: Int
}

type DescriptorRejectReason
  = NegativeSize { size: Int }

type DescriptorOutcome
  = DescriptorAccepted { value: OciDescriptor }
  | DescriptorRejected { reason: DescriptorRejectReason }

fn accept_descriptor(d: OciDescriptor) -> DescriptorOutcome {
  if d.size < 0 {
    DescriptorRejected { reason: NegativeSize { size: d.size } }
  } else {
    DescriptorAccepted { value: d }
  }
}
