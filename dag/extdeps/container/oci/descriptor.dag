module extdeps.container.oci.descriptor

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/opencontainers/image-spec/blob/main/descriptor.md"
  }
}

type OciDescriptor {
  mediaType: OciMediaType
  digest: ContentHash
  size: Int
}

type DescriptorRejectReason
  = NegativeSize { size: Int }
  | EmptyDigest

type DescriptorOutcome
  = DescriptorAccepted { value: OciDescriptor }
  | DescriptorRejected { reason: DescriptorRejectReason }

fn accept_descriptor(d: OciDescriptor) -> DescriptorOutcome {
  if d.size < 0 {
    DescriptorRejected { reason: NegativeSize { size: d.size } }
  } else if d.digest == "" {
    DescriptorRejected { reason: EmptyDigest }
  } else {
    DescriptorAccepted { value: d }
  }
}
