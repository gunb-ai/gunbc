  uri: Uri {
    scheme: Https
    locator: "github.com/opencontainers/distribution-spec/blob/main/spec.md"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.container.oci.reference",
      decl_name: "OciImageReference",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps.container.oci.reference.extdeps_external_authority_anchor,
  further_citations: []
