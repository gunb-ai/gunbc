module extdeps.container.oci.reference

import extdeps.container.oci.digest { OciContentDigest, render_oci_content_digest_wire }
import extdeps.dns.domain_name { HostName, domain_name_wire }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Uri, Https }
import std.error_primitives { Result, Ok, Err }
import std.types { Bool, Int, List, Port, String }

