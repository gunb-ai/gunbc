module extdeps.container.oci.pin

import std.types { ContentHash }
import extdeps.pin { Pin, ExactPin }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.container.oci.descriptor { OciDescriptor }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/opencontainers/image-spec/blob/main/descriptor.md"
  }
}

data oci_descriptor_pin_instantiation_note: String = "THE INSTANTIATION for OciDescriptor second-consumer proof (review 44662). extdeps.pin owns Pin<Subject>; this module binds the dimension to a content-addressed blob with no software-version axis. OCI image-spec pins layers by digest alone, so Pin.version is Absent — selection identity is expected_identity projected from descriptor.digest, not a misbranded VersionIdentity (review 44953)."

fn oci_descriptor_pin_expected_identity(descriptor: OciDescriptor) -> ContentHash {
  descriptor.digest
}

fn oci_descriptor_pin(descriptor: OciDescriptor) -> Pin<OciDescriptor> {
  Pin {
    subject: descriptor,
    version: Absent,
    expected_identity: oci_descriptor_pin_expected_identity(descriptor: descriptor),
    selection: ExactPin,
  }
}
