module extdeps.network.ti_dp83867


// The DP83867IR datasheet, read 2026-08-14 for its mechanical pages only. It reprints TWO package
// drawings — PAP0064M, a 64-pin quad flatpack, and RGZ0048B, a 48-pin quad flatpack no-lead. The
// row below is the RGZ one and says so at every field.
data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.ti.com/lit/ds/symlink/dp83867ir.pdf"
  }
}

data ti_dp83867_note: String = "THIS ROW IS A MECHANICAL CANDIDATE AND NOT A SELECTED PART. Nothing here says the device suits any board role; a selection is a functional-compatibility join done at the product layer, and this row supplies only the package authority that join consumes. TWO PACKAGES ON ONE DATASHEET IS THE HAZARD THIS ROW IS SHAPED AROUND. The document reprints PAP0064M and RGZ0048B, each with its own body dimensions and its own land pattern, and nothing about a record field name stops a body from one being bound beside a land pattern from the other — the two would look entirely plausible together and would produce a board with sixteen missing pads. So the designator is carried on BOTH the body and the pattern and joined by extdeps.land_pattern.types, which refuses the mismatch rather than trusting the author's attention. Only the RGZ0048B part is recorded; adding the PAP0064M ordering part number later is a second row, not an edit to this one. Mechanical facts only: this row asserts nothing about the PHY's media interfaces, its speeds or its power rails."

data dp83867_rgz0048b_drawing: extdeps.land_pattern.types.PackageDrawingRef = extdeps.land_pattern.types.PackageDrawingRef {
  drawing_number: "4218795/B",
  revision_date: "02/2017",
  reprinted_in: extdeps_external_authority_anchor,
}

data dp83867_rgz0048b_body: extdeps.land_pattern.types.PackageBodyDimensions = extdeps.land_pattern.types.PackageBodyDimensions {
  designator: "RGZ0048B",
  drawing: dp83867_rgz0048b_drawing,
  terminal_count: 48,
  terminal_pitch: std.measure.micrometer(count: 500),
  body_length_min: std.measure.micrometer(count: 6850),
  body_length_max: std.measure.micrometer(count: 7150),
  body_width_min: std.measure.micrometer(count: 6850),
  body_width_max: std.measure.micrometer(count: 7150),
  height_max: std.measure.micrometer(count: 1000),
}

data dp83867_rgz0048b_land_pattern: extdeps.land_pattern.types.VendorRecommendedLandPattern = extdeps.land_pattern.types.VendorRecommendedLandPattern {
  package_designator: "RGZ0048B",
  drawing: dp83867_rgz0048b_drawing,
  geometry: extdeps.land_pattern.types.QuadRowLandGeometry {
    lands_per_side: 12,
    pitch: std.measure.micrometer(count: 500),
    side_span_centre_to_centre: std.measure.micrometer(count: 6800),
    land_length: std.measure.micrometer(count: 600),
    land_width: std.measure.micrometer(count: 240),
    thermal_land_side: Present { value: std.measure.micrometer(count: 4100) },
  },
}

data dp83867irrgz: extdeps.land_pattern.types.PartMechanicalCandidate = extdeps.land_pattern.types.PartMechanicalCandidate {
  ordering_part_number: "DP83867IRRGZ",
  vendor: extdeps.vendor.texas_instruments.texas_instruments,
  body: dp83867_rgz0048b_body,
  land_pattern: dp83867_rgz0048b_land_pattern,
  terminal_indexing: extdeps.land_pattern.types.TerminalIndexingObligation {
    what_is_missing: "the pin-one location, the numbering direction, the top-versus-bottom view convention the drawing is stated in, the terminal-to-land identity relation and the electrical role of any exposed pad, for package RGZ0048B. None of those were transcribed and this repository carries no pin-map model to receive them, so this candidate cannot be admitted for footprint realization and a consumer cannot mistake matching counts and pitch for a known pin map",
  },
}

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.network.ti_dp83867",
      decl_name: "dp83867irrgz",
      field: std.decl_ref.WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}
