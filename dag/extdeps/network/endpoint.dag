module extdeps.network.endpoint


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https,
    locator: "www.rfc-editor.org/rfc/rfc3986#section-3.2.2",
  }
}

data network_host_note: String = "A reachable host reference is a NAME or a literal ADDRESS — the two ways ssh/connect targets are actually written (an ssh_host is exactly this, today a bare NonEmptyStr). Reuses the already-grounded authorities: extdeps.dns.domain_name.HostName (RFC 1123, with its real label constraints) for the name arm, extdeps.network.address.IpAddress for the address arm — no fresh nickname. This is the leaf the transport model's `ssh_host: NonEmptyStr` grounds onto, and the payload of a network Reach (extdeps.network.reach)."

type NetworkHost =
    HostByName { name: extdeps.dns.domain_name.HostName }
  | HostByAddress { address: extdeps.network.address.IpAddress }

fn host_by_name(name: extdeps.dns.domain_name.HostName) -> NetworkHost {
  HostByName { name: name }
}

fn host_by_ipv4(addr: extdeps.network.ipv4.Ipv4Address) -> NetworkHost {
  HostByAddress { address: extdeps.network.address.ip_v4(addr: addr) }
}

fn render_network_host(host: NetworkHost) -> std.types.NonEmptyStr? {
  match host {
    HostByName { name: n } => Present { value: extdeps.dns.domain_name.domain_name_wire(name: n.name) as std.types.NonEmptyStr }
    HostByAddress { address: a } => extdeps.network.address.render_ip_address(addr: a)
  }
}

// A transport endpoint: a host reference paired with a port. Reuses std.types.Port (the Int-where-range(1,65535) authority) verbatim — the port bound is not re-declared here. A SocketAddress is what a connect() targets; a bare NetworkHost (no port) is the ssh-config-style reference where the port is defaulted by the protocol.
type SocketAddress {
  host: NetworkHost
  port: std.types.Port
}

fn socket_address(host: NetworkHost, port: std.types.Port) -> SocketAddress {
  SocketAddress { host: host, port: port }
}
