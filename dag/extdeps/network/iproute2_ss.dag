  }
}

data min_iproute2_version: VersionConstraint = ">= 4.0"

// WHY ss AND NOT /proc/net/unix. /proc/net/unix names the socket's INODE, never the process
// holding it, so resolving an owner from it needs a scan of /proc/*/fd -- a glob, i.e. a shell,
// i.e. exactly the concat-shell surface this lane is not allowed to grow. ss -p asks the kernel
// the same question through the sock_diag netlink family and answers with the owning process in
// one argv, no shell metacharacter anywhere in the command.
//
// EVERY ARGV HERE IS NON-MUTATING. -l lists listening sockets and -p annotates them with their
// owner; neither creates, binds, or wakes anything. That matters because the alternative probe
// the tree already refuses -- sccache --show-stats -- reports a table whether or not a server
// exists (extdeps.cache.sccache sccache_stats_query_does_not_spawn_note), so it cannot establish
// absence at all.

fn ss_unix_listening_at_path_argv(path: NonEmptyStr) -> List<String> {
  ["ss", "-H", "-l", "-p", "-x", "src", path as String]
}

fn ss_tcp_listening_on_port_argv(port: String) -> List<String> {
  ["ss", "-H", "-l", "-p", "-t", "sport", concat("= :", port)]
}

// THE PROCESS COLUMN IS `users:((\"name\",pid=N,fd=M))` AND THE PARSE KEYS ON `pid=`, which is the
// stable part of that rendering rather than a column offset: the address, state and queue columns
// ahead of it are width-variable, so counting fields would be a positional citation of a moving
// target. A line with no `pid=` at all is a socket ss could annotate no owner for -- typically a
// permission gap, never an absence of owner -- and the decoder must refuse it rather than read it
// as unowned.
data ss_process_column_pid_token: NonEmptyStr = "pid="

