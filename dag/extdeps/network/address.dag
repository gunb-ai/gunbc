module extdeps.network.address

import std.types { String, Bool, NonEmptyStr }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.network.ipv4 { Ipv4Address, render_ipv4_address }
import extdeps.network.ipv6 { Ipv6Address, ipv6_is_loopback, render_ipv6_address }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.iana.org/assignments/address-family-numbers/address-family-numbers.xhtml",
  }
}

// An IP address is v4 OR v6 (RFC 791 / RFC 4291) — the honestly CLOSED coproduct over the two
// grounded address leaves, not a string. Both arms render: v4 as dotted decimal (extdeps.network.ipv4),
// v6 as RFC 5952 canonical text (extdeps.network.ipv6), so render_ip_address is total and no consumer
// carries an absent arm. Only v6 PARSING is staged (extdeps.network.ipv6's frontier row). Constructors
// ip_v4 / ip_v6 are the tagged injections.

type IpAddress =
    IpV4 { v4: Ipv4Address }
  | IpV6 { v6: Ipv6Address }

fn ip_v4(addr: Ipv4Address) -> IpAddress {
  IpV4 { v4: addr }
}

fn ip_v6(addr: Ipv6Address) -> IpAddress {
  IpV6 { v6: addr }
}

fn render_ip_address(addr: IpAddress) -> NonEmptyStr {
  match addr {
    IpV4 { v4: a } => render_ipv4_address(addr: a)
    IpV6 { v6: a } => render_ipv6_address(addr: a)
  }
}

fn ip_address_is_v4(addr: IpAddress) -> Bool {
  match addr {
    IpV4 { v4: _ } => true
    IpV6 { v6: _ } => false
  }
}

fn ip_address_is_loopback(addr: IpAddress) -> Bool {
  match addr {
    IpV4 { v4: a } => a.octet1 == 127
    IpV6 { v6: a } => ipv6_is_loopback(addr: a)
  }
}
