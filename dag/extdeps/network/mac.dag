module extdeps.network.mac

import std.types { Int, String, Bool, NonEmptyStr, List, list_length }
import std.integer { UInt8, qualified_octet_members }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.numeric.base16 { byte_hex_lower, base16_decode_lower }
import std.host_text { chars }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "standards.ieee.org/wp-content/uploads/import/documents/tutorials/eui.pdf",
  }
}

data ieee_802_address_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.ieee802.org/1/files/public/docs2020/yangsters-smansfield-mac-address-format-0420-v01.pdf",
  }
}

// Structured EUI-48 hardware address -- the dissolution of extdeps.dhcp.v4.MacAddress's anemic
// `NonEmptyStr where brand(MacAddress)`, whose declared trigger names THIS module and THIS parse
// function. It follows extdeps.network.ipv4 exactly rather than inventing a second shape: the
// octet is the grounded unit, two entry points split model
// from realization (mac_address(..) for authored literals, parse_mac_address(String) for wire text
// such as `ip link` output), and malformed input REFUSES with a typed located error rather than
// fabricating an address.
//
// THE OCTET IS std.integer.UInt8 RATHER THAN A SECOND 0..255 BOUND, and that is a deliberate
// departure from the sibling module rather than an oversight. extdeps.network.ipv4 declares
// `type Octet = Int where range(min: 0, max: 255)`, and measured across the corpus that is the ONLY
// such refinement -- so a MacOctet declared here would have been the SECOND name for one concept,
// which is exactly the re-invention DESIGN section 2 tests for ("net concepts must not grow by
// re-invention"). std.integer.UInt8 is the universal authority for an 8-bit unsigned integer and
// already exists, so the byte grounds there. Importing ipv4's Octet was the other option and is
// worse: a MAC octet is not an IPv4 octet, and the dependency would ground a link-layer fact on a
// network-layer module for no reason but that the bound was written there first. THIS LEAVES ipv4's
// own Octet as a pre-existing duplicate of UInt8; it is not touched here, because retyping a public
// type in a module this change does not otherwise modify is a separate decision with its own
// consumers.
//
// THE FIRST OCTET IS NOT OPAQUE, and decomposing it is why this module is worth more than a
// validated string. IEEE 802 assigns two flag bits inside it: bit 0 is I/G -- individual (unicast)
// versus group (multicast) -- and bit 1 is U/L -- universally administered (burned in by the
// assignee of the OUI) versus locally administered (set by software). Both are derived here rather
// than stored, so they cannot disagree with the octets they are read from.
//
// WHY THAT MATTERS TO A CONSUMER RATHER THAN BEING TRIVIA: keying a host interface on its address
// is only stable if the address is the PERMANENT one, and a locally-administered address is
// precisely one that software chose and software can change. A branded string cannot express that
// difference, so a consumer keying on it cannot tell a burned-in identity from a temporary one --
// which is the whole reason the DHCP carrier's brand was marked anemic.
//
// SPELLING: the canonical wire form is six lowercase hex pairs separated by colons, which is what
// Linux `ip` emits. Hyphen-separated and dotted-quad forms are NOT accepted and NOT silently
// normalized -- they refuse with MacWrongOctetCount or MacOctetNotHex, because a parser that
// quietly accepts several spellings makes the render/parse round trip untrue and hides which
// spelling a source actually produced.

type Eui48Address {
  octet1: UInt8
  octet2: UInt8
  octet3: UInt8
  octet4: UInt8
  octet5: UInt8
  octet6: UInt8
}

// The two IEEE flag bits carried in the first octet, each named rather than left as a bit test at
// every call site. They are DERIVED from octet1 below, never stored beside it.
type MacAddressScope
  = UniversallyAdministered
  | LocallyAdministered

type MacAddressTransmission
  = IndividualAddress
  | GroupAddress

type MacParseError =
    MacWrongOctetCount { observed_count: Int }
  | MacOctetNotHex { position: Int, raw: String }
  | MacOctetWrongWidth { position: Int, raw: String, observed_width: Int }

type MacParseResult =
    MacParsed { address: Eui48Address }
  | MacParseFailed { error: MacParseError }

fn mac_address(
  octet1: UInt8,
  octet2: UInt8,
  octet3: UInt8,
  octet4: UInt8,
  octet5: UInt8,
  octet6: UInt8,
) -> Eui48Address {
  Eui48Address {
    octet1: octet1,
    octet2: octet2,
    octet3: octet3,
    octet4: octet4,
    octet5: octet5,
    octet6: octet6,
  }
}


// Rendering reads the same alphabet the parser does. This spelled the digits as a sixteen-arm match
// whose default arm totalized every value >= 15 to "f" -- a fifth copy of the alphabet, in the
// module this cut dissolves, and one that answered for values that are not digits at all.
// ONE OCTET IS RENDERED BY THE CODEC'S OWN PER-OCTET PRIMITIVE, not by wrapping it in a list for
// the whole-string encoder. base16_encode_lower now takes std.integer QualifiedOctets, and a
// six-field address would have to mint one carrier per octet -- six admissions, each with a
// refusal arm, to render a value whose width the field already declares. byte_hex_lower is the
// SAME authority the encoder folds over, so this is reuse rather than a second encoder.
//
// THE CROSSING IS NAMED RATHER THAN LEFT IMPLICIT: `value` is UInt8 and byte_hex_lower's formal is
// Int, which is the bounded-natural transparency this substrate does not yet decide -- rostered as
// a named site on gunbc.recurring_failure_mode bounded_natural_arithmetic_evaluated_as_unbounded_int.
fn render_mac_octet(value: UInt8) -> String {
  byte_hex_lower(v: value)
}

fn render_mac_address(addr: Eui48Address) -> NonEmptyStr {
  join([
    render_mac_octet(value: addr.octet1),
    render_mac_octet(value: addr.octet2),
    render_mac_octet(value: addr.octet3),
    render_mac_octet(value: addr.octet4),
    render_mac_octet(value: addr.octet5),
    render_mac_octet(value: addr.octet6),
  ], ":") as NonEmptyStr
}

// THE OUI IS THE FIRST THREE OCTETS (IEEE EUI-48). It is projected rather than stored for the same
// reason the flag bits are: a stored copy could disagree with the address it was taken from.
fn mac_oui(addr: Eui48Address) -> List<UInt8> {
  [addr.octet1, addr.octet2, addr.octet3]
}

// U/L is bit 1 of the first octet. SET means LOCALLY administered -- the sense is inverted relative
// to how the name reads, which is exactly the kind of detail that goes wrong when every consumer
// open-codes the bit test.
fn mac_address_scope(addr: Eui48Address) -> MacAddressScope {
  if (addr.octet1 / 2) % 2 == 1 {
    LocallyAdministered
  } else {
    UniversallyAdministered
  }
}

// I/G is bit 0 of the first octet. SET means GROUP (multicast).
fn mac_address_transmission(addr: Eui48Address) -> MacAddressTransmission {
  if addr.octet1 % 2 == 1 {
    GroupAddress
  } else {
    IndividualAddress
  }
}

// THE NULL ADDRESS IS SIX ZERO OCTETS, and it is not an interface's address at any level of the flags.
// WHAT THE STANDARD ACTUALLY SAYS, stated exactly because the inference matters: the cited IEEE EUI
// tutorial says an all-zero EUI-48 MUST NOT be used as an identifier, and separately recommends the
// all-ones address as the null default where one is needed. So the standard licenses one claim -- six
// zero octets is never a valid identity -- and NOT the stronger one it is tempting to draw, that six
// zero octets PROVES the reader had no address. A stack that failed to read a NIC, a probe that opened
// the wrong file, and a device that genuinely has no MAC can all hand over 00:00:00:00:00:00, and this
// fn cannot tell them apart; it says "this cannot name anything", not "that unit has no NIC". A caller
// that wants the difference must say WHICH by reporting the absence in its own words -- which is why
// `gunbc.fleet.runtime_identity_match` turns this into a located gap naming the side and the count,
// rather than concluding anything about the machine.
//
// WHY IT NEEDS ITS OWN FN AT ALL: the two flag bits say nothing about it. Octet 1 of zero is
// 0b00000000, which is universally administered AND individual, so a consumer filtering on the flags
// alone accepts the address that must never identify anything as the strongest kind of identity. Two
// readers that both failed to read a NIC then hand each other 00:00:00:00:00:00 and a flag-keyed rule
// binds the two sightings as the same machine.
fn mac_address_is_null(addr: Eui48Address) -> Bool {
  addr.octet1 == 0 && addr.octet2 == 0 && addr.octet3 == 0
    && addr.octet4 == 0 && addr.octet5 == 0 && addr.octet6 == 0
}

// A PERMANENT INTERFACE IDENTITY IS NOT NULL, UNICAST AND UNIVERSALLY ADMINISTERED. This is the
// predicate a consumer that keys on those octets actually wants, stated once here rather than re-derived
// from the flags at every call site -- a locally administered address was chosen by software and can be
// changed by software, a group address names no single interface at all, and the null address must never
// identify anything at all (see `mac_address_is_null`, whose null case is precisely the both-sides-quiet
// pair a naive flag filter binds into a false agreement). A consumer that wants only the flag axes
// reads `mac_address_scope` and `mac_address_transmission` directly; this is the conjunction whose three
// exclusions travel together and cannot be split by a caller.
//
// WHAT IT DOES NOT PROVE, stated because the name is tempting: `true` here establishes the NECESSARY address
// properties -- not-null, unicast, universally administered -- and nothing more. It does not establish that
// the address currently identifies a particular machine, that it was read from a source that reports
// burned-in state, or that two sightings carrying it are the same machine; those need the provenance the
// reporter supplies and the fold's own verdict. A caller that reads this `true` as "same machine" has
// imported a conclusion this fn never drew, which is why its consumers take provenance separately.
fn mac_is_permanent_interface_identity(addr: Eui48Address) -> Bool {
  if mac_address_is_null(addr: addr) {
    false
  } else {
    match mac_address_scope(addr: addr) {
      UniversallyAdministered =>
        match mac_address_transmission(addr: addr) {
          IndividualAddress => true
          GroupAddress => false
        }
      LocallyAdministered => false
    }
  }
}

// TWO ADDRESSES ARE THE SAME ADDRESS WHEN ALL SIX OCTETS AGREE, and that is a fact about the address
// type, not about any consumer that compares sightings of one. It lives beside the flag axes and the null
// test for the same reason those do: a consumer that re-derives it at its own call site can derive it
// differently. Octets are compared rather than the record rendered to text and the strings compared,
// because the rendering is a projection -- two addresses that differ can render to strings that differ only
// in a separator a future renderer changes, and a comparison whose truth depends on a display spelling is a
// comparison that can silently widen.
fn mac_addresses_are_equal(left: Eui48Address, right: Eui48Address) -> Bool {
  left.octet1 == right.octet1
    && left.octet2 == right.octet2
    && left.octet3 == right.octet3
    && left.octet4 == right.octet4
    && left.octet5 == right.octet5
    && left.octet6 == right.octet6
}

type MacOctetResult =
    MacOctetOk { value: UInt8 }
  | MacOctetErr { error: MacParseError }

// A two-character component IS a lowercase-hex octet, so the codec decides it: base16_decode_lower
// refuses an uppercase or non-hex spelling by returning absent, which becomes MacOctetNotHex. The
// width is established first, so a component of the wrong length keeps its own MacOctetWrongWidth
// cause rather than arriving at the codec as "not hex".
fn parse_mac_octet_at(parts: List<String>, position: Int) -> MacOctetResult {
  match parts |> get(position) {
    Absent => MacOctetErr { error: MacWrongOctetCount { observed_count: list_length(items: parts) } }
    Present { value: raw } => {
      let points = chars(text: raw)
      if list_length(items: points) != 2 {
        MacOctetErr {
          error: MacOctetWrongWidth { position: position, raw: raw, observed_width: list_length(items: points) },
        }
      } else {
        match base16_decode_lower(hex: raw) {
          Absent => MacOctetErr { error: MacOctetNotHex { position: position, raw: raw } }
          Present { value: qualified } =>
            match qualified_octet_members(q: qualified).first() {
              Present { value: octet } => MacOctetOk { value: octet }
              Absent => MacOctetErr { error: MacOctetNotHex { position: position, raw: raw } }
            }
        }
      }
    }
  }
}

fn parse_mac_address(text: String) -> MacParseResult {
  let parts = split(s: text, delimiter: ":")
  if list_length(items: parts) != 6 {
    MacParseFailed { error: MacWrongOctetCount { observed_count: list_length(items: parts) } }
  } else {
    match parse_mac_octet_at(parts: parts, position: 0) {
      MacOctetErr { error: e0 } => MacParseFailed { error: e0 }
      MacOctetOk { value: o1 } => match parse_mac_octet_at(parts: parts, position: 1) {
        MacOctetErr { error: e1 } => MacParseFailed { error: e1 }
        MacOctetOk { value: o2 } => match parse_mac_octet_at(parts: parts, position: 2) {
          MacOctetErr { error: e2 } => MacParseFailed { error: e2 }
          MacOctetOk { value: o3 } => match parse_mac_octet_at(parts: parts, position: 3) {
            MacOctetErr { error: e3 } => MacParseFailed { error: e3 }
            MacOctetOk { value: o4 } => match parse_mac_octet_at(parts: parts, position: 4) {
              MacOctetErr { error: e4 } => MacParseFailed { error: e4 }
              MacOctetOk { value: o5 } => match parse_mac_octet_at(parts: parts, position: 5) {
                MacOctetErr { error: e5 } => MacParseFailed { error: e5 }
                MacOctetOk { value: o6 } => MacParsed {
                  address: Eui48Address {
                    octet1: o1, octet2: o2, octet3: o3, octet4: o4, octet5: o5, octet6: o6,
                  },
                }
              }
            }
          }
        }
      }
    }
  }
}
