module extdeps.network.ipv6

import std.types { Int, String, Bool, NonEmptyStr, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.roster_frontier { FrontierRow, frontier_row }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.rfc-editor.org/rfc/rfc4291",
  }
}

data ipv6_text_representation_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.rfc-editor.org/rfc/rfc5952",
  }
}

data ipv6_grounding_note: String = "Structured IPv6 address (RFC 4291 §2.5): eight 16-bit groups. The group is the grounded unit — a 0..65535 bound modeled with the same `Int where range` refinement std.types.Port uses (reuses the bound idiom, not a fresh nickname), parallel to extdeps.network.ipv4's octet. STAGED CODEC (deliberate, §6): the TYPE and constructor are grounded, but the string codec (canonical text form, RFC 5952 — lowercase hex groups with :: run-length compression) is NOT built here. It is a decode/encode over extdeps.numeric.base16 (the cited hex authority — render via its int-to-hex, parse via a reverse-fold over base16_digit_rows), and there are ZERO IPv6 addresses in the fleet today, so building a wire parser now would be building for a host that does not diverge. The codec lands when a real v6 address needs (de)serializing — dissolution trigger below. This keeps IpAddress an HONESTLY CLOSED coproduct (an IP is v4 or v6) with a grounded v6 arm, without an anemic string or a speculative parser."

data dissolve_on_ipv6_text_codec_staged: List<FrontierRow> = [
  frontier_row(
    unit: "ipv6_text_codec",
    reason: "Ipv6Address has no RFC 5952 string parse/render yet; it reuses extdeps.numeric.base16 (render) and a reverse-fold over base16_digit_rows (parse), with :: compression",
    dissolve_on: "the first fleet IPv6 address needs ingesting or emitting (parse_ipv6_address / render_ipv6_address land with a round-trip witness)",
  )
]

type Hextet = Int where range(min: 0, max: 65535)

type Ipv6Address {
  group1: Hextet
  group2: Hextet
  group3: Hextet
  group4: Hextet
  group5: Hextet
  group6: Hextet
  group7: Hextet
  group8: Hextet
}

fn ipv6_address(
  group1: Hextet, group2: Hextet, group3: Hextet, group4: Hextet,
  group5: Hextet, group6: Hextet, group7: Hextet, group8: Hextet,
) -> Ipv6Address {
  Ipv6Address {
    group1: group1, group2: group2, group3: group3, group4: group4,
    group5: group5, group6: group6, group7: group7, group8: group8,
  }
}

fn ipv6_is_loopback(addr: Ipv6Address) -> Bool {
  addr.group1 == 0 && addr.group2 == 0 && addr.group3 == 0 && addr.group4 == 0
    && addr.group5 == 0 && addr.group6 == 0 && addr.group7 == 0 && addr.group8 == 1
}
