// IBM's FRU is shared by EC2T and EC2U. The bracket fitted to the ordered card
// is an operator report downstream, not something inferred from the FRU number.
// Consumer: gunbc.machine_intake_mtcollins1_expansion_candidates.candidate_verdicts.
// SFP28 names the port connector; no Ethernet link mode or aggregate is inferred.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority { uri: Uri {
  scheme: Https,
  locator: "www.ibm.com/docs/en/power11/9856-42H?topic=ad-pcie3-2-port-2510-gb-nic-roce-sfp28-adapter-fc-ec2t-fc-ec2u-ccin-58fb",
} }

type Ibm01ft753 {
  attachment: NicAttachmentClass
  host_link: PcieLink
  port_count: Nat
  port_connector: NonEmptyStr
}

data ibm_01ft753: Ibm01ft753 = Ibm01ft753 {
  attachment: PcieCem,
  host_link: PcieLink { generation: Gen3, lane_count: 8 },
  port_count: 2,
  port_connector: "SFP28",
}

