module extdeps.network.ipv4

import std.types { Int, String, Bool, NonEmptyStr, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data ipv4_header_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.rfc-editor.org/rfc/rfc791",
  }
}

data ipv4_dotted_decimal_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "www.rfc-editor.org/rfc/rfc790",
  }
}

data ipv4_grounding_note: String = "Structured IPv4 address — the dissolution of extdeps.dhcp.v4.Ipv4Address's anemic 'NonEmptyStr where brand(Ipv4Address)' (its dissolve_on_ipv4_address_anemic_brand named THIS module and a parse_ipv4_address witness). An IPv4 address is four octets (RFC 791 §3.1 — a 32-bit address), written in dotted-decimal (RFC 790 conventions); the octet is the grounded unit, a 0..255 bound modeled with the same `Int where range` refinement std.types.Port already uses for network numerics (NOT a fresh nickname — reuses the established bound idiom). Two entry points, per the model/realization split: ipv4_address(...) constructs from four octets for AUTHORED literals (byte-known at author time), parse_ipv4_address(String) recovers structure from WIRE text (DHCP tables, ip output) and REFUSES malformed input with a typed, located Ipv4ParseError rather than fabricating an address (§5 fail-closed). Round-trip (parse ∘ render == id on valid; render ∘ parse == id) is the witness."

type Octet = Int where range(min: 0, max: 255)

type Ipv4Address {
  octet1: Octet
  octet2: Octet
  octet3: Octet
  octet4: Octet
}

type Ipv4ParseError =
    Ipv4WrongOctetCount { observed_count: Int }
  | Ipv4OctetNotNumeric { position: Int, raw: String }
  | Ipv4OctetOutOfRange { position: Int, value: Int }

type Ipv4ParseResult =
    Ipv4Parsed { address: Ipv4Address }
  | Ipv4ParseFailed { error: Ipv4ParseError }

fn ipv4_address(octet1: Octet, octet2: Octet, octet3: Octet, octet4: Octet) -> Ipv4Address {
  Ipv4Address {
    octet1: octet1,
    octet2: octet2,
    octet3: octet3,
    octet4: octet4,
  }
}

fn render_ipv4_address(addr: Ipv4Address) -> NonEmptyStr {
  join([
    to_string(addr.octet1),
    to_string(addr.octet2),
    to_string(addr.octet3),
    to_string(addr.octet4),
  ], ".") as NonEmptyStr
}

fn parse_octet_at(parts: List<String>, position: Int) -> Ipv4ParseResult? {
  match parts |> get(position) {
    Absent => Present { value: Ipv4ParseFailed { error: Ipv4WrongOctetCount { observed_count: list_length(items: parts) } } }
    Present { value: raw } =>
      match parse_int(s: raw) {
        Absent => Present { value: Ipv4ParseFailed { error: Ipv4OctetNotNumeric { position: position, raw: raw } } }
        Present { value: n } =>
          if n < 0 || n > 255 {
            Present { value: Ipv4ParseFailed { error: Ipv4OctetOutOfRange { position: position, value: n } } }
          } else {
            none
          }
      }
  }
}

fn octet_value_at(parts: List<String>, position: Int) -> Octet {
  match parts |> get(position) {
    Absent => 0
    Present { value: raw } =>
      match parse_int(s: raw) {
        Absent => 0
        Present { value: n } => if n < 0 || n > 255 { 0 } else { n }
      }
  }
}

fn parse_ipv4_address(text: String) -> Ipv4ParseResult {
  let parts = split(s: text, delimiter: ".")
  if list_length(items: parts) != 4 {
    Ipv4ParseFailed { error: Ipv4WrongOctetCount { observed_count: list_length(items: parts) } }
  } else {
    match parse_octet_at(parts: parts, position: 0) {
      Present { value: fail0 } => fail0
      Absent => match parse_octet_at(parts: parts, position: 1) {
        Present { value: fail1 } => fail1
        Absent => match parse_octet_at(parts: parts, position: 2) {
          Present { value: fail2 } => fail2
          Absent => match parse_octet_at(parts: parts, position: 3) {
            Present { value: fail3 } => fail3
            Absent => Ipv4Parsed {
              address: Ipv4Address {
                octet1: octet_value_at(parts: parts, position: 0),
                octet2: octet_value_at(parts: parts, position: 1),
                octet3: octet_value_at(parts: parts, position: 2),
                octet4: octet_value_at(parts: parts, position: 3),
              }
            }
          }
        }
      }
    }
  }
}
