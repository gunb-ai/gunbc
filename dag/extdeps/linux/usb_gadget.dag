module extdeps.linux.usb_gadget

import std.types { NonEmptyStr, String, Int, Bool, List }
import std.algebra { list_append }
import std.roster_frontier { FrontierRow, frontier_row_decl }
import std.dissolution { unbound_dissolution }
import std.decl_ref { decl_ref }
import extdeps.exec.command { ArgvCommand, shell_command_render }
import extdeps.tools.gnu_coreutils { ln_symbolic_force_into_directory_command, rm_force_command, rmdir_command }
import extdeps.tools.mkdir { mkdir_parents_command_at, mkdir_path_resolved_program }
import gunbc.rust_item_scan { ends_with }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "docs.kernel.org/usb/gadget_configfs.html",
  }
}

type MassStorageLun {
  backing_device: NonEmptyStr
  cdrom: Bool
  read_only: Bool
  removable: Bool
}

type UsbGadget {
  config_root: NonEmptyStr
  name: NonEmptyStr
  id_vendor: NonEmptyStr
  id_product: NonEmptyStr
  manufacturer: NonEmptyStr
  product: NonEmptyStr
  serial: NonEmptyStr
  config_label: NonEmptyStr
  lun: MassStorageLun
  udc: NonEmptyStr
}

type ConfigfsOp
  = ConfigfsMkdir { path: NonEmptyStr }
  | ConfigfsWriteAttr { path: NonEmptyStr, value: String }
  | ConfigfsSymlink { target: NonEmptyStr, link: NonEmptyStr }
  | ConfigfsRemoveLink { link: NonEmptyStr }
  | ConfigfsRmdir { path: NonEmptyStr }

fn usb_gadget_dir(gadget: UsbGadget) -> NonEmptyStr {
  join([gadget.config_root as String, "/", gadget.name as String], "") as NonEmptyStr
}

fn gadget_bool_bit(b: Bool) -> String {
  if b { "1" } else { "0" }
}

fn usb_gadget_setup_ops(gadget: UsbGadget) -> List<ConfigfsOp> {
  let g = usb_gadget_dir(gadget: gadget) as String
  let strings = join([g, "/strings/0x409"], "")
  let func = join([g, "/functions/mass_storage.0"], "")
  let lun = join([func, "/lun.0"], "")
  let config = join([g, "/configs/", gadget.config_label as String], "")
  [
    ConfigfsMkdir { path: g as NonEmptyStr },
    ConfigfsWriteAttr { path: join([g, "/idVendor"], "") as NonEmptyStr, value: gadget.id_vendor as String },
    ConfigfsWriteAttr { path: join([g, "/idProduct"], "") as NonEmptyStr, value: gadget.id_product as String },
    ConfigfsMkdir { path: strings as NonEmptyStr },
    ConfigfsWriteAttr { path: join([strings, "/manufacturer"], "") as NonEmptyStr, value: gadget.manufacturer as String },
    ConfigfsWriteAttr { path: join([strings, "/product"], "") as NonEmptyStr, value: gadget.product as String },
    ConfigfsWriteAttr { path: join([strings, "/serialnumber"], "") as NonEmptyStr, value: gadget.serial as String },
    ConfigfsMkdir { path: func as NonEmptyStr },
    ConfigfsWriteAttr { path: join([lun, "/removable"], "") as NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.removable) },
    ConfigfsWriteAttr { path: join([lun, "/cdrom"], "") as NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.cdrom) },
    ConfigfsWriteAttr { path: join([lun, "/ro"], "") as NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.read_only) },
    ConfigfsWriteAttr { path: join([lun, "/file"], "") as NonEmptyStr, value: gadget.lun.backing_device as String },
    ConfigfsMkdir { path: join([config, "/strings/0x409"], "") as NonEmptyStr },
    ConfigfsWriteAttr { path: join([config, "/strings/0x409/configuration"], "") as NonEmptyStr, value: gadget.config_label as String },
    ConfigfsSymlink { target: func as NonEmptyStr, link: join([config, "/"], "") as NonEmptyStr },
    ConfigfsWriteAttr { path: join([g, "/UDC"], "") as NonEmptyStr, value: gadget.udc as String },
  ]
}

fn usb_gadget_teardown_ops(gadget: UsbGadget) -> List<ConfigfsOp> {
  let g = usb_gadget_dir(gadget: gadget) as String
  let config = join([g, "/configs/", gadget.config_label as String], "")
  [
    ConfigfsWriteAttr { path: join([g, "/UDC"], "") as NonEmptyStr, value: "" },
    ConfigfsRemoveLink { link: join([config, "/mass_storage.0"], "") as NonEmptyStr },
    ConfigfsRmdir { path: join([g, "/functions/mass_storage.0"], "") as NonEmptyStr },
    ConfigfsRmdir { path: join([config, "/strings/0x409"], "") as NonEmptyStr },
    ConfigfsRmdir { path: config as NonEmptyStr },
    ConfigfsRmdir { path: join([g, "/strings/0x409"], "") as NonEmptyStr },
    ConfigfsRmdir { path: g as NonEmptyStr },
  ]
}

// The ConfigfsOp list is the typed authority for the structure; each op ACTS through a typed
// command minted below. The previous realization rendered each op to a POSIX shell line (a single
// per-variant renderer that had replaced 32 scattered concats); that renderer is retired, because
// a shell line is an unchecked serialization exactly as the concats were -- shell syntax embedded
// in decision-making code cannot be checked before it runs and cannot be reused anywhere else.
//
// THE RETIREMENT OBLIGATION IS DISCHARGED, NOT CARRIED: the renderer (`configfs_op_line`) is gone
// from this tree as of the same change that described the transport, and a retirement obligation
// whose declaration no longer exists is complete -- its trigger went with the declaration, because
// a trigger citing an absent declaration is exactly the dead vocabulary this repository removes.
// The obligation the old note described -- ConfigfsOp bound to typed effects over the ssh transport
// rather than to shell text -- is continued, one layer further along, in the host-effect lane,
// which now consumes these typed commands instead of shell text.

// THE DESCRIBED TRANSPORT (roadmap node shell-typed-invocation). One ConfigfsOp's typed command:
// the operation a caller names and the arguments that carry it. This is what a transport consumes
// INSTEAD of shell text -- the instruction is the typed value, and every spelling below is
// derived from a cited builder, not hand-glued.
//
//   - Process-backed ops (mkdir / symlink / unlink / rmdir) run as `ArgvCommand`s minted through
//     the tool's own extdeps builder -- one operation of one tool, admitted by name on
//     extdeps.exec.command argv_command.
//   - `ConfigfsWriteAttr` is a TYPED ATTRIBUTE WRITE, not an argv command: writing a configfs
//     attribute is write(2) on an existing kernel-owned file, which no argv carries without a
//     shell redirect (the old `printf '%s' ... > path` WAS the shell dependence). Its transport
//     is a native file write over the target's transport; modeling that realization is the
//     host-effect lane's work, and this node's bar is only that no shell text is produced.
//   - `ConfigfsWriteAttr`'s named later consumer and trigger are stated in the declared frontier
//     beside this declaration (its realization is a native write, owed to the host-effect lane).
type ConfigfsOpCommand
  = ConfigfsOpRunsArgv { command: ArgvCommand }
  | ConfigfsOpWritesAttr { path: NonEmptyStr, value: String }

// DECLARED FRONTIER (DESIGN §3c) for the attribute-write arm, stated beside the declaration it
// fronts (review 38602, finding 3): the arm is a typed write, not an argv command -- no argv
// program carries a file write without a shell redirect, which is the exact text this migration
// deletes -- so its realization is owed to a named later consumer rather than minted here.
// The debt is a typed DissolutionCondition on the dissolution census roster, not a bare
// commentary String (DESIGN §4c; review 72478 finding 1). UNBOUND, deliberately: the condition
// is the ARRIVAL of a family the host-effect lane has not yet named anywhere in its plan, so a
// bound forward ref would cite a symbol nobody declared -- the fabricated-citation class
// std.dissolution refuses. The census reads this row as unmet until the paying change binds the
// realization and deletes it.
data configfs_attr_write_realization_frontier_rows: List<FrontierRow> = [
  frontier_row_decl(
    ref: decl_ref(module_path: "extdeps.linux.usb_gadget", decl_name: "ConfigfsOpWritesAttr"),
    reason: "ConfigfsOpWritesAttr|realization:native-write-owed-to-host-effect-lane",
    dissolution: unbound_dissolution(
      description: "ConfigfsOpWritesAttr realizes as a native write(2) over the target's transport, and this change mints no realization for it. THE NAMED LATER CONSUMER: the host-effect lane's configfs effect family, the lane that owns host_effect_apply binding typed execution over machine transports. THE NAMED LATER CHANGE: roadmap node rn_TAPSSCRTTBBV274TFK1PAGAP49 (fleet-closed-loop-converge, docs/plans/host-effect-orchestration.md). THE TRIGGER, stated beside the declaration: when that node's configfs effect family lands it consumes this typed write as its requirement and this frontier dissolves; until then the typed write stays the instruction, the witness gates it as a description, and nothing degrades it to a shell redirect.",
    ),
  ),
]

// THE STAGED RESULT of turning described ops into commands (review 38602, finding 1): either the
// commands to run, or the WHOLE staging refused. There is no state in which a refused op sits in
// a list beside runnable commands, so a bad argument cannot act while the ops around it are
// skipped past -- the refusal is a stop at the grain a caller consumes, not a mixed-in arm.
type ConfigfsStaging
  = ConfigfsStagingRan { commands: List<ConfigfsOpCommand> }
  | ConfigfsStagingRefused { reason: NonEmptyStr }

// The gadget's configfs tree root -- the prefix extdeps_external_authority_anchor's cited
// procedure operates on, and the same string the acceptance oracle's positive control asserts
// every op path carries.
data gadget_configfs_root: NonEmptyStr = "/sys/kernel/config/usb_gadget/"

fn configfs_staging_refused_outside_tree(op_path: String) -> ConfigfsStaging {
  ConfigfsStagingRefused {
    reason: join(
      ["configfs op names a path outside the gadget configfs tree: ", op_path],
      "",
    ) as NonEmptyStr,
  }
}

// One op staged alone: the command its cited builder mints, the typed attribute write, or the
// refusal of the staging it would have joined. The guards are the same per-variant prefix checks
// (and the symlink's directory-spelled suffix) as before the staging climb; what changed is the
// GRAIN the refusal lives at -- see configfs_staging_of.
fn configfs_op_staging(op: ConfigfsOp) -> ConfigfsStaging {
  match op {
    ConfigfsMkdir { path: p } =>
      if starts_with(s: p as String, prefix: gadget_configfs_root as String) {
        ConfigfsStagingRan {
          commands: [ConfigfsOpRunsArgv {
            command: mkdir_parents_command_at(
              mkdir_binary: mkdir_path_resolved_program,
              path: p as String,
            ),
          }],
        }
      } else {
        configfs_staging_refused_outside_tree(op_path: p as String)
      }
    ConfigfsWriteAttr { path: p, value: v } =>
      if starts_with(s: p as String, prefix: gadget_configfs_root as String) {
        ConfigfsStagingRan { commands: [ConfigfsOpWritesAttr { path: p, value: v }] }
      } else {
        configfs_staging_refused_outside_tree(op_path: p as String)
      }
    ConfigfsSymlink { target: t, link: l } =>
      if starts_with(s: l as String, prefix: gadget_configfs_root as String)
        && ends_with(s: l as String, suffix: "/") {
        ConfigfsStagingRan {
          commands: [ConfigfsOpRunsArgv {
            command: ln_symbolic_force_into_directory_command(target: t as String, directory: l as String),
          }],
        }
      } else {
        configfs_staging_refused_outside_tree(op_path: l as String)
      }
    ConfigfsRemoveLink { link: l } =>
      if starts_with(s: l as String, prefix: gadget_configfs_root as String) {
        ConfigfsStagingRan {
          commands: [ConfigfsOpRunsArgv { command: rm_force_command(path: l as String) }],
        }
      } else {
        configfs_staging_refused_outside_tree(op_path: l as String)
      }
    ConfigfsRmdir { path: p } =>
      if starts_with(s: p as String, prefix: gadget_configfs_root as String) {
        ConfigfsStagingRan { commands: [ConfigfsOpRunsArgv { command: rmdir_command(path: p as String) }] }
      } else {
        configfs_staging_refused_outside_tree(op_path: p as String)
      }
  }
}

// The staged setup or teardown: fold the ops, refusing the WHOLE staging at the first op that
// does not resolve. Ops before a refusal never become observable -- a refused staging carries no
// command list at all, so a caller cannot act on the good prefix and skip the bad op past it.
fn configfs_staging_of(ops: List<ConfigfsOp>) -> ConfigfsStaging {
  fold(
    ops,
    init: ConfigfsStagingRan { commands: [] },
    f: (acc, op) =>
      match acc {
        ConfigfsStagingRefused { reason: r } => ConfigfsStagingRefused { reason: r },
        ConfigfsStagingRan { commands: cs } =>
          match configfs_op_staging(op: op) {
            ConfigfsStagingRefused { reason: r } => ConfigfsStagingRefused { reason: r },
            ConfigfsStagingRan { commands: minted } =>
              ConfigfsStagingRan { commands: list_append(left: cs, right: minted) },
          },
      },
  )
}

fn usb_gadget_setup_staging(gadget: UsbGadget) -> ConfigfsStaging {
  configfs_staging_of(ops: usb_gadget_setup_ops(gadget: gadget))
}

fn usb_gadget_teardown_staging(gadget: UsbGadget) -> ConfigfsStaging {
  configfs_staging_of(ops: usb_gadget_teardown_ops(gadget: gadget))
}

// One display line per described command. The argv arm goes through the one quoting fact
// (extdeps.exec.command shell_command_render); the attribute-write arm renders as a key/value
// description, which is not shell and carries no shell control word.
fn configfs_op_command_display(cmd: ConfigfsOpCommand) -> String {
  match cmd {
    ConfigfsOpRunsArgv { command: c } => shell_command_render(command: c)
    ConfigfsOpWritesAttr { path: p, value: v } => join(["write-attr ", p as String, " = ", v], "")
  }
}

// What a staging renders to: one line per command, or the refusal with its reason. The DISPLAY
// FOLD IS MODELED ONCE, here, and every caller's display surface derives from this one (review
// 38602, finding 2). Still NOT an instruction: the instruction is the typed staging; this is what
// a log or a witness reads when it asks what the staging renders to.
fn configfs_staging_display(staging: ConfigfsStaging) -> String {
  match staging {
    ConfigfsStagingRan { commands: cs } =>
      fold(cs, init: "", f: (acc, cmd) => join([acc, configfs_op_command_display(cmd: cmd), "\n"], "")),
    ConfigfsStagingRefused { reason: r } => join(["refused: ", r as String, "\n"], ""),
  }
}

fn usb_gadget_setup_display(gadget: UsbGadget) -> String {
  configfs_staging_display(staging: usb_gadget_setup_staging(gadget: gadget))
}

fn usb_gadget_teardown_display(gadget: UsbGadget) -> String {
  configfs_staging_display(staging: usb_gadget_teardown_staging(gadget: gadget))
}
