module extdeps.linux.usb_gadget



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https,
    locator: "docs.kernel.org/usb/gadget_configfs.html",
  }
}

type MassStorageLun {
  backing_device: std.types.NonEmptyStr
  cdrom: Bool
  read_only: Bool
  removable: Bool
}

type UsbGadget {
  config_root: std.types.NonEmptyStr
  name: std.types.NonEmptyStr
  id_vendor: std.types.NonEmptyStr
  id_product: std.types.NonEmptyStr
  manufacturer: std.types.NonEmptyStr
  product: std.types.NonEmptyStr
  serial: std.types.NonEmptyStr
  config_label: std.types.NonEmptyStr
  lun: MassStorageLun
  udc: std.types.NonEmptyStr
}

type ConfigfsOp
  = ConfigfsMkdir { path: std.types.NonEmptyStr }
  | ConfigfsWriteAttr { path: std.types.NonEmptyStr, value: String }
  | ConfigfsSymlink { target: std.types.NonEmptyStr, link: std.types.NonEmptyStr }
  | ConfigfsRemoveLink { link: std.types.NonEmptyStr }
  | ConfigfsRmdir { path: std.types.NonEmptyStr }

fn usb_gadget_dir(gadget: UsbGadget) -> std.types.NonEmptyStr {
  join([gadget.config_root as String, "/", gadget.name as String], "") as std.types.NonEmptyStr
}

fn gadget_bool_bit(b: Bool) -> String {
  if b { "1" } else { "0" }
}

fn usb_gadget_setup_ops(gadget: UsbGadget) -> List<ConfigfsOp> {
  let g = usb_gadget_dir(gadget: gadget) as String
  let strings = join([g, "/strings/0x409"], "")
  let func = join([g, "/functions/mass_storage.0"], "")
  let lun = join([func, "/lun.0"], "")
  let config = join([g, "/configs/", gadget.config_label as String], "")
  [
    ConfigfsMkdir { path: g as std.types.NonEmptyStr },
    ConfigfsWriteAttr { path: join([g, "/idVendor"], "") as std.types.NonEmptyStr, value: gadget.id_vendor as String },
    ConfigfsWriteAttr { path: join([g, "/idProduct"], "") as std.types.NonEmptyStr, value: gadget.id_product as String },
    ConfigfsMkdir { path: strings as std.types.NonEmptyStr },
    ConfigfsWriteAttr { path: join([strings, "/manufacturer"], "") as std.types.NonEmptyStr, value: gadget.manufacturer as String },
    ConfigfsWriteAttr { path: join([strings, "/product"], "") as std.types.NonEmptyStr, value: gadget.product as String },
    ConfigfsWriteAttr { path: join([strings, "/serialnumber"], "") as std.types.NonEmptyStr, value: gadget.serial as String },
    ConfigfsMkdir { path: func as std.types.NonEmptyStr },
    ConfigfsWriteAttr { path: join([lun, "/removable"], "") as std.types.NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.removable) },
    ConfigfsWriteAttr { path: join([lun, "/cdrom"], "") as std.types.NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.cdrom) },
    ConfigfsWriteAttr { path: join([lun, "/ro"], "") as std.types.NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.read_only) },
    ConfigfsWriteAttr { path: join([lun, "/file"], "") as std.types.NonEmptyStr, value: gadget.lun.backing_device as String },
    ConfigfsMkdir { path: join([config, "/strings/0x409"], "") as std.types.NonEmptyStr },
    ConfigfsWriteAttr { path: join([config, "/strings/0x409/configuration"], "") as std.types.NonEmptyStr, value: gadget.config_label as String },
    ConfigfsSymlink { target: func as std.types.NonEmptyStr, link: join([config, "/"], "") as std.types.NonEmptyStr },
    ConfigfsWriteAttr { path: join([g, "/UDC"], "") as std.types.NonEmptyStr, value: gadget.udc as String },
  ]
}

fn usb_gadget_teardown_ops(gadget: UsbGadget) -> List<ConfigfsOp> {
  let g = usb_gadget_dir(gadget: gadget) as String
  let config = join([g, "/configs/", gadget.config_label as String], "")
  [
    ConfigfsWriteAttr { path: join([g, "/UDC"], "") as std.types.NonEmptyStr, value: "" },
    ConfigfsRemoveLink { link: join([config, "/mass_storage.0"], "") as std.types.NonEmptyStr },
    ConfigfsRmdir { path: join([g, "/functions/mass_storage.0"], "") as std.types.NonEmptyStr },
    ConfigfsRmdir { path: join([config, "/strings/0x409"], "") as std.types.NonEmptyStr },
    ConfigfsRmdir { path: config as std.types.NonEmptyStr },
    ConfigfsRmdir { path: join([g, "/strings/0x409"], "") as std.types.NonEmptyStr },
    ConfigfsRmdir { path: g as std.types.NonEmptyStr },
  ]
}

// The ConfigfsOp list is the typed authority for the structure; each op is nonetheless
// rendered to a POSIX shell line because a configfs attribute write is a remote file
// write with no argv-only form (`printf > sysfs` needs a redirect) and the BMC transport
// is SSH. This single per-variant renderer replaced 32 scattered concats.
//
// It dissolves when host_effect_apply binds ConfigfsOp directly to a remote
// Filesystem.Write effect — WriteAttr to Filesystem.Write, Mkdir/Symlink/Rmdir to typed
// FS ops — over the ssh transport. That removal is observable exactly as the
// disappearance of `configfs_op_line`, which is what the trigger names.
data configfs_op_render_dissolution_trigger: DissolutionCondition = retires_dissolution(
  ref: decl_ref(module_path: "extdeps.linux.usb_gadget", decl_name: "configfs_op_line")
)

fn configfs_op_line(op: ConfigfsOp) -> String {
  match op {
    ConfigfsMkdir { path: p } => join(["mkdir -p ", p as String], "")
    ConfigfsWriteAttr { path: p, value: v } => join(["printf '%s' '", v, "' > ", p as String], "")
    ConfigfsSymlink { target: t, link: l } => join(["ln -sf ", t as String, " ", l as String], "")
    ConfigfsRemoveLink { link: l } => join(["rm -f ", l as String, " 2>/dev/null || true"], "")
    ConfigfsRmdir { path: p } => join(["rmdir ", p as String, " 2>/dev/null || true"], "")
  }
}

fn configfs_ops_script(ops: List<ConfigfsOp>) -> String {
  fold(ops, init: "", f: (acc, op) => join([acc, configfs_op_line(op: op), "\n"], ""))
}

fn usb_gadget_setup_script(gadget: UsbGadget) -> String {
  join(["set -e", "\n", configfs_ops_script(ops: usb_gadget_setup_ops(gadget: gadget))], "")
}

fn usb_gadget_teardown_script(gadget: UsbGadget) -> String {
  configfs_ops_script(ops: usb_gadget_teardown_ops(gadget: gadget))
}
