module extdeps.linux.usb_gadget

import std.types { NonEmptyStr, String, Int, Bool, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.exec.command { ArgvCommand }
import extdeps.tools.mkdir { mkdir_path_resolved_program, mkdir_parents_command_at }
import extdeps.tools.gnu_coreutils { ln_symbolic_force_command, rm_force_command, rmdir_command }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "docs.kernel.org/usb/gadget_configfs.html",
  }
}

type MassStorageLun {
  backing_device: NonEmptyStr
  cdrom: Bool
  read_only: Bool
  removable: Bool
}

type UsbGadget {
  config_root: NonEmptyStr
  name: NonEmptyStr
  id_vendor: NonEmptyStr
  id_product: NonEmptyStr
  manufacturer: NonEmptyStr
  product: NonEmptyStr
  serial: NonEmptyStr
  config_label: NonEmptyStr
  lun: MassStorageLun
  udc: NonEmptyStr
}

type ConfigfsOp
  = ConfigfsMkdir { path: NonEmptyStr }
  | ConfigfsWriteAttr { path: NonEmptyStr, value: String }
  | ConfigfsSymlink { target: NonEmptyStr, link: NonEmptyStr }
  | ConfigfsRemoveLink { link: NonEmptyStr }
  | ConfigfsRmdir { path: NonEmptyStr }

fn usb_gadget_dir(gadget: UsbGadget) -> NonEmptyStr {
  join([gadget.config_root as String, "/", gadget.name as String], "") as NonEmptyStr
}

fn gadget_bool_bit(b: Bool) -> String {
  if b { "1" } else { "0" }
}

fn usb_gadget_setup_ops(gadget: UsbGadget) -> List<ConfigfsOp> {
  let g = usb_gadget_dir(gadget: gadget) as String
  let strings = join([g, "/strings/0x409"], "")
  let func = join([g, "/functions/mass_storage.0"], "")
  let lun = join([func, "/lun.0"], "")
  let config = join([g, "/configs/", gadget.config_label as String], "")
  [
    ConfigfsMkdir { path: g as NonEmptyStr },
    ConfigfsWriteAttr { path: join([g, "/idVendor"], "") as NonEmptyStr, value: gadget.id_vendor as String },
    ConfigfsWriteAttr { path: join([g, "/idProduct"], "") as NonEmptyStr, value: gadget.id_product as String },
    ConfigfsMkdir { path: strings as NonEmptyStr },
    ConfigfsWriteAttr { path: join([strings, "/manufacturer"], "") as NonEmptyStr, value: gadget.manufacturer as String },
    ConfigfsWriteAttr { path: join([strings, "/product"], "") as NonEmptyStr, value: gadget.product as String },
    ConfigfsWriteAttr { path: join([strings, "/serialnumber"], "") as NonEmptyStr, value: gadget.serial as String },
    ConfigfsMkdir { path: func as NonEmptyStr },
    ConfigfsWriteAttr { path: join([lun, "/removable"], "") as NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.removable) },
    ConfigfsWriteAttr { path: join([lun, "/cdrom"], "") as NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.cdrom) },
    ConfigfsWriteAttr { path: join([lun, "/ro"], "") as NonEmptyStr, value: gadget_bool_bit(b: gadget.lun.read_only) },
    ConfigfsWriteAttr { path: join([lun, "/file"], "") as NonEmptyStr, value: gadget.lun.backing_device as String },
    ConfigfsMkdir { path: join([config, "/strings/0x409"], "") as NonEmptyStr },
    ConfigfsWriteAttr { path: join([config, "/strings/0x409/configuration"], "") as NonEmptyStr, value: gadget.config_label as String },
    ConfigfsSymlink { target: func as NonEmptyStr, link: join([config, "/"], "") as NonEmptyStr },
    ConfigfsWriteAttr { path: join([g, "/UDC"], "") as NonEmptyStr, value: gadget.udc as String },
  ]
}

fn usb_gadget_teardown_ops(gadget: UsbGadget) -> List<ConfigfsOp> {
  let g = usb_gadget_dir(gadget: gadget) as String
  let config = join([g, "/configs/", gadget.config_label as String], "")
  [
    ConfigfsWriteAttr { path: join([g, "/UDC"], "") as NonEmptyStr, value: "" },
    ConfigfsRemoveLink { link: join([config, "/mass_storage.0"], "") as NonEmptyStr },
    ConfigfsRmdir { path: join([g, "/functions/mass_storage.0"], "") as NonEmptyStr },
    ConfigfsRmdir { path: join([config, "/strings/0x409"], "") as NonEmptyStr },
    ConfigfsRmdir { path: config as NonEmptyStr },
    ConfigfsRmdir { path: join([g, "/strings/0x409"], "") as NonEmptyStr },
    ConfigfsRmdir { path: g as NonEmptyStr },
  ]
}

// THE DESCRIBED FORM OF A CONFIGFS OPERATION. The ConfigfsOp list above is the typed authority for
// the structure; this mapping is what carries it to a transport, and it replaces the per-variant
// shell-line renderer (`configfs_op_line`) that used to sit here — the renderer prefixed the setup
// with `set -e`, joined lines carrying `2>/dev/null || true`, and was the last caller-shaped shell
// text in this module. Each op becomes ONE of two typed things:
//
// - a typed argv invocation (extdeps.exec.command ArgvCommand, minted through the named builders)
//   for the operations that ARE process invocations — mkdir, ln, rm, rmdir; or
// - a typed file write for the attribute writes, which are not process invocations at all. A
//   configfs attribute write has no argv-only form (the shell era spelled it `printf '%s' 'v' >
//   path`, a redirect), so its faithful description is these bytes at this path. That form also
//   removes a class the shell spelling carried: a value containing a single quote broke the
//   hand-rolled `printf '%s' '` … `'` quoting — a latent injection the builders' quoting never
//   saw, because the value never reached them. A file write carries bytes as data; there is no
//   quoting to break, so the class is structurally gone rather than escaped correctly.
//
// THE REFUSAL IS PART OF THE OPERATION. An op naming a path outside the gadget's own configfs
// directory refuses as a typed outcome before any command is built — the same property the
// acceptance oracle asserts positively of the live fixture, enforced here at the mapping instead
// of checked afterwards. Bad arguments therefore never reach a transport, shell or otherwise.
//
// WHAT IS DELIBERATELY NOT CARRIED: the `2>/dev/null || true` suppressions. `rm -f` already makes
// an absent file a success, so its suppression was dead text; `rmdir` genuinely refuses an absent
// directory, and "what to do when it is already gone" is a realization concern for the transport
// that runs the plan — not a property of the argv, and not something to re-bake into rendered
// text. When host_effect_apply binds ConfigfsOp directly to typed remote filesystem effects (the
// dissolution the shell-era note here used to name), that concern gets its typed home.
type ConfigfsOpCommand
  = ConfigfsCommandArgv { command: ArgvCommand }
  | ConfigfsCommandWriteFile { path: NonEmptyStr, content: String }

type ConfigfsOpRefusalCause
  = ConfigfsPathOutsideGadgetRoot { path: NonEmptyStr, root: NonEmptyStr }

type ConfigfsOpCommandOutcome
  = ConfigfsOpCommandBuilt { command: ConfigfsOpCommand }
  | ConfigfsOpCommandRefused { cause: ConfigfsOpRefusalCause }

fn configfs_path_within_root(root: NonEmptyStr, path: NonEmptyStr) -> Bool {
  let p = path as String
  let r = root as String
  p == r || starts_with(s: p, prefix: concat(r, "/"))
}

fn configfs_refuse_outside_root(root: NonEmptyStr, path: NonEmptyStr) -> ConfigfsOpCommandOutcome {
  ConfigfsOpCommandRefused {
    cause: ConfigfsPathOutsideGadgetRoot { path: path, root: root },
  }
}

// THE PROGRAM IS SPELLED PATH-RESOLVED ON PURPOSE, and the reason lives at the call site rather
// than in extdeps.tools.mkdir's default: this plan's target is an unobserved OpenBMC image reached
// over ssh, where mkdir is a BusyBox applet and nobody has read where that image installs it —
// the exact case mkdir_parents_command_at's own note carves out (gunbc.bmc_netboot_serve is its
// precedent). Writing /usr/bin/mkdir here would fabricate a host fact (DESIGN section 5).
fn configfs_op_command(op: ConfigfsOp, root: NonEmptyStr) -> ConfigfsOpCommandOutcome {
  match op {
    ConfigfsMkdir { path: p } =>
      if configfs_path_within_root(root: root, path: p) {
        ConfigfsOpCommandBuilt {
          command: ConfigfsCommandArgv {
            command: mkdir_parents_command_at(mkdir_binary: mkdir_path_resolved_program, path: p as String),
          },
        }
      } else {
        configfs_refuse_outside_root(root: root, path: p)
      }
    ConfigfsWriteAttr { path: p, value: v } =>
      if configfs_path_within_root(root: root, path: p) {
        ConfigfsOpCommandBuilt {
          command: ConfigfsCommandWriteFile { path: p, content: v },
        }
      } else {
        configfs_refuse_outside_root(root: root, path: p)
      }
    ConfigfsSymlink { target: t, link: l } =>
      if configfs_path_within_root(root: root, path: t) {
        if configfs_path_within_root(root: root, path: l) {
          ConfigfsOpCommandBuilt {
            command: ConfigfsCommandArgv {
              command: ln_symbolic_force_command(target: t as String, link: l as String),
            },
          }
        } else {
          configfs_refuse_outside_root(root: root, path: l)
        }
      } else {
        configfs_refuse_outside_root(root: root, path: t)
      }
    ConfigfsRemoveLink { link: l } =>
      if configfs_path_within_root(root: root, path: l) {
        ConfigfsOpCommandBuilt {
          command: ConfigfsCommandArgv {
            command: rm_force_command(path: l as String),
          },
        }
      } else {
        configfs_refuse_outside_root(root: root, path: l)
      }
    ConfigfsRmdir { path: p } =>
      if configfs_path_within_root(root: root, path: p) {
        ConfigfsOpCommandBuilt {
          command: ConfigfsCommandArgv {
            command: rmdir_command(path: p as String),
          },
        }
      } else {
        configfs_refuse_outside_root(root: root, path: p)
      }
  }
}

// The whole-op-list form a caller of a gadget plan reaches for: the root is derived from the
// gadget's own configfs directory, so a caller never hands a root and an op list that disagree.
// Works for the setup ops and the teardown ops alike — the mapping is total over ConfigfsOp.
fn usb_gadget_op_commands(gadget: UsbGadget, ops: List<ConfigfsOp>) -> List<ConfigfsOpCommandOutcome> {
  map(ops, op => configfs_op_command(op: op, root: usb_gadget_dir(gadget: gadget)))
}
