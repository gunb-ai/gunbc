module extdeps.linux.proc_meminfo


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "man7.org/linux/man-pages/man5/proc.5.html#/proc/meminfo"
  }
}

type MemoryMetric {
  key: std.types.NonEmptyStr
  value: std.measure.Kibibyte
}

type ProcMeminfo {
  mem_total: std.measure.Kibibyte
  mem_free: std.measure.Kibibyte
  mem_available: std.measure.Kibibyte
  buffers: std.measure.Kibibyte
  cached: std.measure.Kibibyte
  swap_total: std.measure.Kibibyte
  swap_free: std.measure.Kibibyte
  all_metrics: List<MemoryMetric>
}

data meminfo_field_names: List<std.types.NonEmptyStr> = [
  "MemTotal",
  "MemFree",
  "MemAvailable",
  "Buffers",
  "Cached",
  "SwapTotal",
  "SwapFree",
]
