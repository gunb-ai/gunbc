module extdeps.linux.procfs


data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man5/proc.5.html"
  }
}

// procfs IS A LINUX KERNEL INTERFACE, and modeling that is the whole point of this module. Every host observation this repository takes of its own process or machine — resident set, available memory, swap devices, cgroup membership — reads a file under /proc, and proc.5 describes those files as a pseudo-filesystem the LINUX kernel synthesizes. No other kernel family provides it: macOS reports process residency through Mach task_info and memory through sysctl/vm_stat, Windows through the process API. So the absence of /proc on a Darwin host is not a read that failed, a permission problem, or a host that could not be reached — it is a category error about which kernel is running, and it is decidable in advance from a fact the corpus already carries.
//
// WHY THAT DISTINCTION EARNS A MODULE. std.upsert_decision.ObservationVerdict already separates Inaccessible (we asked and could not reach) from UnknownRefused (we have no way to ask at all), and gunbc.host_phase_status is emphatic that collapsing distinct states is the conflation this corpus keeps paying for. Neither arm fits a Darwin host: the producer exists, the host is reachable and is in fact the machine running the code, and the interface simply is not there. Rendering that as a failure invites the two repairs that are both wrong — fabricating a plausible number, or greening the check on the platform that cannot answer it.
//
// WHAT THIS MODULE DOES NOT OWN: the SHAPE of any particular proc file. extdeps.linux.proc_meminfo owns /proc/meminfo's fields and cites the same authority for them. This module owns the interface — which paths exist and which kernels synthesize them — so a consumer can ask whether an observation is answerable here before trying to take it.
type ProcfsPath
  = ProcMeminfo
  | ProcSelfStatus
  | ProcSelfCgroup
  | ProcNetUnix
  | ProcSwaps
  | ProcSysKernelHostname

fn procfs_path_literal(p: ProcfsPath) -> std.types.NonEmptyStr {
  match p {
    ProcMeminfo => "/proc/meminfo"
    ProcSelfStatus => "/proc/self/status"
    ProcSelfCgroup => "/proc/self/cgroup"
    ProcNetUnix => "/proc/net/unix"
    ProcSwaps => "/proc/swaps"
    ProcSysKernelHostname => "/proc/sys/kernel/hostname"
  }
}

data procfs_paths_read_by_this_repository: List<ProcfsPath> = [
  ProcMeminfo,
  ProcSelfStatus,
  ProcSelfCgroup,
  ProcNetUnix,
  ProcSwaps,
  ProcSysKernelHostname,
]

// Provision is a total match over std.os.types.KernelFamily rather than a roster of platforms that happen to have it, so adding a kernel family to that closed enum forces an answer here instead of silently defaulting. LinuxGuestOnWindows answers TRUE deliberately and is the arm most likely to be got wrong by pattern-matching on the name: WSL2 runs a real Linux kernel and synthesizes a real procfs, so a consumer that treated it as a Windows platform would refuse observations the host can actually serve. Darwin and WindowsNt answer false — each has its own mechanism for the same facts (Mach task_info, sysctl, the Windows process API), and modeling those is a separate job this module does not attempt.
fn kernel_provides_procfs(kernel: std.os.types.KernelFamily) -> Bool {
  match kernel {
    Linux => true
    LinuxGuestOnWindows => true
    Darwin => false
    WindowsNt => false
  }
}

type ProcfsAvailability
  = ProcfsAvailable
  | ProcfsAbsentOnKernel { kernel: std.os.types.KernelFamily, path: ProcfsPath }

fn procfs_availability(kernel: std.os.types.KernelFamily, path: ProcfsPath) -> ProcfsAvailability {
  if kernel_provides_procfs(kernel: kernel) {
    ProcfsAvailable
  } else {
    ProcfsAbsentOnKernel { kernel: kernel, path: path }
  }
}

fn kernel_family_label(kernel: std.os.types.KernelFamily) -> std.types.NonEmptyStr {
  match kernel {
    Linux => "Linux"
    LinuxGuestOnWindows => "LinuxGuestOnWindows"
    Darwin => "Darwin"
    WindowsNt => "WindowsNt"
  }
}

fn procfs_absence_reason(kernel: std.os.types.KernelFamily, path: ProcfsPath) -> std.types.NonEmptyStr {
  concat(
    concat(
      concat("procfs path ", procfs_path_literal(p: path) as String),
      " is not provided by kernel family "
    ),
    concat(
      kernel_family_label(kernel: kernel) as String,
      ": procfs is a Linux kernel pseudo-filesystem (proc.5), so this observation is unanswerable on this platform rather than failed — do not fabricate a value and do not report a source that was never read"
    )
  ) as std.types.NonEmptyStr
}

fn procfs_availability_is_available(a: ProcfsAvailability) -> Bool {
  match a {
    ProcfsAvailable => true
    ProcfsAbsentOnKernel { kernel: _, path: _ } => false
  }
}

