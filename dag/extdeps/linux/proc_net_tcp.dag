module extdeps.linux.proc_net_tcp

import std.types { NonEmptyStr, List, Bool, Int, Port, checked_port }
import std.optional { Present, Absent }
import std.algebra { trim }
import extdeps.numeric.base16 { base16_word_value, base16_word_value_upper }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// THE SHAPE OF /proc/net/tcp AND /proc/net/tcp6 (proc(5), "/proc/net/tcp"): one header line, then
// one row per socket, whitespace-separated. The fields this module reads are the second
// (local_address: hex IP, a colon, a 4-hex-digit port), the fourth (st: the socket state as two
// hex digits, where 0A is TCP_LISTEN -- include/net/tcp_states.h), the eighth (uid: the socket's
// owner's effective uid, decimal) and the tenth (inode: the socket's
// inode, the number /proc/<pid>/fd/N names as `socket:[inode]`). Everything else on the row is
// carried past. The port is the same 16-bit hex field in both files; only the address width
// differs (8 hex digits for v4, 32 for v6), and this parser reads the port from the right of the
// colon so the width is not its business.
//
// WHAT THIS ESTABLISHES: which local ports have a socket in LISTEN state on the host whose procfs
// was read, whatever bound them. It does not say which process owns the socket (that is the inode
// joined through /proc/<pid>/fd, a separate read) and it says nothing about a listener in another
// network namespace -- a container with its own netns has its own /proc/net/tcp. A consumer that
// needs "nothing listens on this port on this host" reads both files and, when containers may
// hold the port, the host's namespace is the one the enrolled address reaches.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man5/proc.5.html#/proc/net/tcp"
  }
}

data tcp_listen_state_hex: String = "0A"

// THE LOCAL PORT IS std.types Port WHERE ONE IS BOUND, AND TWO SEPARATE CHECKS GUARD IT. The field
// is the kernel's fixed-width %04X port column (net/ipv4/tcp_ipv4.c, get_tcp4_sock): exactly four
// uppercase hex digits -- that WIDTH is upstream SYNTAX, this module's own fact (proc(5)), enforced in
// tcp_socket_row by base16's ceiling plus a floor this module adds; it is NOT a stand-in for the port
// range. The DOMAIN bound -- which decoded values are admissible Ports (RFC 793 / RFC 9293's 16-bit
// field, reserved 0 excluded) -- is std.types checked_port (gunbc.design_ruling::
// where_refinements_retire_for_checked_constructors); within four digits it is the only thing that
// refuses, and 0000 stays the kernel's marker for a socket with no bound port (checked_port has no
// constructor for 0, RFC 6335 §6), so the row answers TcpPortUnbound rather than carrying 0 as a port.
type TcpLocalPort
  = TcpPortBound { port: Port }
  | TcpPortUnbound

type TcpSocketRow {
  local_address: String
  local_port: TcpLocalPort
  state: String
  uid: String
  inode: String
}

type ProcNetTcpTable
  = ProcNetTcpParsed { rows: List<TcpSocketRow> }
  | ProcNetTcpUnparseable { line: String }

fn tcp_row_fields(line: String) -> List<String> {
  filter(split(s: trim(s: line), delimiter: " "), f => f != "")
}

fn tcp_socket_row(line: String) -> TcpSocketRow? {
  let fields = tcp_row_fields(line: line)
  match get(xs: fields, index: 1) {
    Absent => none
    Present { value: local } =>
      match get(xs: fields, index: 3) {
        Absent => none
        Present { value: st } => match get(xs: fields, index: 9) {
        Absent => none
        Present { value: inode } => match get(xs: fields, index: 7) {
        Absent => none
        Present { value: uid } => {
          let parts = split(s: local, delimiter: ":")
          if length(parts) != 2 { none } else {
            match get(xs: parts, index: 1) {
              Absent => none
              Present { value: port_hex } =>
                // THE KERNEL PRINTS THIS COLUMN AS %04X (net/ipv4/tcp_ipv4.c, get_tcp4_sock): exactly
                // four UPPERCASE hex digits. That fixed width and case are the upstream's own SYNTAX and
                // this module's concern -- not a stand-in for the port range. base16 gives the hex-digit
                // syntax; its either-case base16_word_value would read '01bb' as 0x01BB = 443, so this
                // column reads through base16_word_value_upper (the rows' UPPER column is the alphabet
                // authority), which refuses the lowercase a-f as the non-canonical spelling. base16 gives
                // a length CEILING (max_digits: 4 refuses a 6-digit word like "0001BB") but no floor, so
                // this module supplies the missing one and refuses a short word like "1BB". The DOMAIN
                // bound is separate and stays std.types checked_port.
                if string_length(s: port_hex) < 4 {
                  none
                } else {
                  match base16_word_value_upper(word: port_hex, max_digits: 4) {
                    Absent => none
                    Present { value: port } =>
                      if port == 0 {
                        Present { value: TcpSocketRow { local_address: local, local_port: TcpPortUnbound, state: st, uid: uid, inode: inode } }
                      } else {
                        match checked_port(n: port) {
                          Absent => none
                          Present { value: bound_port } =>
                            Present { value: TcpSocketRow { local_address: local, local_port: TcpPortBound { port: bound_port }, state: st, uid: uid, inode: inode } }
                        }
                      }
                  }
                }
            }
          }
        }
        }
        }
      }
  }
}

// The table: the header line is skipped by its first field ("sl"), blank lines are skipped, and
// a row that does not carry the two fields this module reads refuses the whole table naming the
// line -- a socket table with an unreadable row is not a table with fewer sockets.
fn proc_net_tcp_table(text: String) -> ProcNetTcpTable {
  let lines = filter(split(s: text, delimiter: "\n"), l => trim(s: l) != "")
  fold(lines, init: ProcNetTcpParsed { rows: [] as List<TcpSocketRow> }, f: (acc, line) =>
    match acc {
      ProcNetTcpUnparseable { line: _ } => acc
      ProcNetTcpParsed { rows: rs } =>
        match get(xs: tcp_row_fields(line: line), index: 0) {
          Absent => acc
          Present { value: first } =>
            if first == "sl" { acc } else {
              match tcp_socket_row(line: line) {
                Absent => ProcNetTcpUnparseable { line: line }
                Present { value: r } => ProcNetTcpParsed { rows: concat(rs, [r]) }
              }
            }
        }
    })
}

// THE IPv4 ADDRESS HALF OF local_address, dotted. The kernel prints the __be32 address with %08X
// read as a host-order word, so on a little-endian host (x86_64, aarch64 -- every machine this
// repository reads) the four octets appear REVERSED: 127.0.0.1 is 0100007F. A 32-digit tcp6
// address is not an IPv4 address and answers none.
fn tcp_local_ipv4_dotted_little_endian(local_address: String) -> String? {
  match get(xs: split(s: local_address, delimiter: ":"), index: 0) {
    Absent => none
    Present { value: hex } =>
      if string_length(s: hex) != 8 { none } else {
        let octets = map([6, 4, 2, 0], i => base16_word_value(word: substring(s: hex, start: i, end: i + 2), max_digits: 2))
        if any(octets, o => match o { Absent => true  Present { value: _ } => false }) { none }
        else { Present { value: join(map(octets, o => match o { Present { value: v } => to_string(v)  Absent => "" }), ".") } }
      }
  }
}

fn tcp_rows_listening_on(rows: List<TcpSocketRow>, port: Port) -> List<TcpSocketRow> {
  filter(rows, r => r.state == tcp_listen_state_hex && (match r.local_port { TcpPortBound { port: p } => p == port  TcpPortUnbound => false }))
}
