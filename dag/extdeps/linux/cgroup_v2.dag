module extdeps.linux.cgroup_v2

import std.types { Bool, NonEmptyStr, String }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Https, Uri }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.kernel.org/admin-guide/cgroup-v2.html"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.linux.cgroup_v2",
      decl_name: "linux.CgroupV2",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE UNIFIED HIERARCHY IS MOUNTED AT ONE PLACE, AND IT IS THE KERNEL'S PLACE, NOT OURS. Every
// consumer that spells this path itself is a second authority for it (DESIGN 3), which is how a
// mount point ends up differing by one character between the reader and the thing it reads.
data cgroup_v2_mount_point: NonEmptyStr = "/sys/fs/cgroup"

// A CHILD CGROUP IS A DIRECTORY; AN INTERFACE FILE IS NOT. The kernel represents the hierarchy in
// the filesystem, so enumerating children is exactly enumerating SUBDIRECTORIES -- and a plain
// listing of the directory would return the interface files (memory.current, cgroup.procs, ...)
// intermixed with the children, which is why this constrains to -type d rather than filtering
// names afterwards. Filtering by name would encode a guess about which prefixes are interface
// files; -type d encodes the kernel's actual representation.
//
// -mindepth 1 excludes the directory itself; -maxdepth 1 keeps it to immediate children, because a
// session's own descendants are that session's internal business and counting them would inflate
// the population. -printf %f yields the bare child name rather than a full path.
//
// PathIsDirectory: A CGROUP THAT DOES NOT EXIST IS NOT A CGROUP THAT COULD NOT BE READ. Both make `find` and
// `cat` exit nonzero, so exit status alone cannot separate "this host has no such slice" from
// "the slice is there and the read failed" -- and those have opposite meanings for a capacity
// question: the first says the host hosts nothing of this kind, the second says we are blind.
// `test -d` is the discriminator the kernel's filesystem representation already affords, and it
// is total: 0 for a directory, 1 for anything else, with no output to parse.
service linux.CgroupV2 {
  operation ListChildCgroups {
    input { cgroup_path: NonEmptyStr }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    transport shell {
      argv: ["find", "{cgroup_path}", "-mindepth", "1", "-maxdepth", "1", "-type", "d", "-printf", "%f\n"]
    }
    exit {
      0 => Unit
      nonzero => String "cgroup child enumeration failed"
    }
  }

  operation ReadInterfaceFile {
    input { file_path: NonEmptyStr }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    transport shell {
      argv: ["cat", "{file_path}"]
    }
    exit {
      0 => Unit
      nonzero => String "cgroup interface file read failed"
    }
  }
  operation PathIsDirectory {
    input { path: NonEmptyStr }
    output {
      value: String from "stdout"
      success: Bool from "exit_success"
    }
    transport shell {
      argv: ["test", "-d", "{path}"]
    }
    exit {
      0 => Unit
      nonzero => String "path is not a directory"
    }
  }
}

// THE PATH IS COMPOSED IN .dag AND INTERPOLATED AS ONE VALUE, NOT ASSEMBLED INSIDE THE ARGV.
// An argv of ["cat", "{cgroup_path}/{interface_file}"] does not concatenate two interpolations
// around a literal slash -- the interpolation grammar reads across it and the `/` becomes a
// DIVISION operator, which fails at evaluation with "unsupported operator Div on String".
// Measured on srv1-07: ListChildCgroups, whose argv interpolates a single value, executed fine;
// this operation was the only one carrying two interpolations separated by an operator character.
// One input, one interpolation, and the composition stays where the type system can see it.
fn cgroup_v2_child_path(parent: NonEmptyStr, child: NonEmptyStr) -> NonEmptyStr {
  concat(parent as String, "/", child as String) as NonEmptyStr
}

fn cgroup_v2_slice_path(slice: NonEmptyStr) -> NonEmptyStr {
  cgroup_v2_child_path(parent: cgroup_v2_mount_point, child: slice)
}
