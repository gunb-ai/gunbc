// AUTOMATIC HELPER ASSIGNMENT, AS A SYSCTL THAT MAY NOT EXIST. nf_conntrack_helper attached a helper
// to a flow by port with no rule saying so. Upstream removed it, so on a current kernel the path is
// ABSENT -- which is a stronger reading than 0, because there is no setting left to turn back on. A
// reader must therefore distinguish absent from 0 from 1, and never treat absence as unreadable.
data nf_conntrack_helper_proc_path: NonEmptyStr = "/proc/sys/net/netfilter/nf_conntrack_helper"
