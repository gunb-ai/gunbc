module extdeps.linux.cgroup_v2_memory

import std.algebra { trim }
import std.checked_arithmetic { nat_magnitude }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.uri { Https, Uri }
import std.measure { ByteSize, byte_size }
import std.types { Int, NonEmptyStr, String }
import v2.std.optional { Present, Absent }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.kernel.org/admin-guide/cgroup-v2.html#memory-interface-files"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.linux.cgroup_v2_memory",
      decl_name: "CgroupMemoryInterfaceFile",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// THE THREE KINDS ARE THE KERNEL'S, NOT OURS. cgroup-v2 documents each memory interface file with a
// distinct temporal meaning; storing every one as a bare ByteSize would erase the distinction that
// decides whether a number may be compared, summed, or differenced at all:
//
//   Instantaneous       -- true at the moment of the read and at no other moment.
//   LifetimeEpochScoped -- an extremum accumulated since the cgroup was created or the value reset.
//                          NOT "the maximum during my observation window" unless the epoch is
//                          carried beside it, which is why the epoch is a field rather than prose.
//   CumulativeCounter   -- monotone since cgroup creation. A single end snapshot is not an interval
//                          measurement; only a start/end pair yields a delta.
//
// Grounding the kinds here rather than in the consumer is DESIGN 3: the upstream spec draws this
// line, so re-coining it downstream would nickname a fact the kernel owns.
type CgroupMemoryMetricKind
  = Instantaneous
  | LifetimeEpochScoped
  | CumulativeCounter

// The interface files this authority models, by their REAL names. Adding a file means adding a
// variant, so the kind judgment stays exhaustive rather than defaulting.
type CgroupMemoryInterfaceFile
  = MemoryCurrent
  | MemoryPeak
  | MemoryMax
  | MemoryHigh
  | MemorySwapCurrent
  | MemoryEvents

fn cgroup_memory_interface_file_name(f: CgroupMemoryInterfaceFile) -> NonEmptyStr {
  match f {
    MemoryCurrent => "memory.current"
    MemoryPeak => "memory.peak"
    MemoryMax => "memory.max"
    MemoryHigh => "memory.high"
    MemorySwapCurrent => "memory.swap.current"
    MemoryEvents => "memory.events"
  }
}

fn cgroup_memory_metric_kind(f: CgroupMemoryInterfaceFile) -> CgroupMemoryMetricKind {
  match f {
    MemoryCurrent => Instantaneous
    MemoryPeak => LifetimeEpochScoped
    MemoryMax => Instantaneous
    MemoryHigh => Instantaneous
    MemorySwapCurrent => Instantaneous
    MemoryEvents => CumulativeCounter
  }
}

// A NEGATIVE BODY IS MALFORMED, NOT A MAGNITUDE. parse_int admits negatives, and every file modeled
// here is documented as a non-negative byte count, so a leading minus is a malformed read, not a
// value to take the absolute value of. nat_magnitude is applied only AFTER the sign is excluded,
// where it is the identity -- as the crossing on an unguarded Int it would silently turn "-1"
// into 1.
fn parse_cgroup_nonnegative_bytes(text: String) -> ByteSize? {
  match parse_int(s: trim(text)) {
    Present { value: n } =>
      if n < 0 {
        none
      } else {
        Present { value: byte_size(count: nat_magnitude(a: n)) }
      }
    Absent => none
  }
}

// THE `max` SENTINEL IS A THIRD STATE, NOT A LARGE NUMBER. memory.max and memory.high hold either a
// byte count or the literal "max", which the kernel documents as "no limit". A huge ByteSize would
// fabricate a limit the host does not have; absent would conflate it with a failed read -- so it is
// its own arm, and an unparseable body is a fourth.
type CgroupMemoryLimitValue
  = CgroupMemoryLimited { bytes: ByteSize }
  | CgroupMemoryUnlimited
  | CgroupMemoryLimitUnparseable { body: String }

fn parse_cgroup_memory_limit(body: String) -> CgroupMemoryLimitValue {
  if trim(body) == "max" {
    CgroupMemoryUnlimited
  } else {
    match parse_cgroup_nonnegative_bytes(text: body) {
      Present { value: b } => CgroupMemoryLimited { bytes: b }
      Absent => CgroupMemoryLimitUnparseable { body: body }
    }
  }
}

// A COUNT FILE HAS NO `max` ARM. memory.current, memory.peak and memory.swap.current are documented
// as byte counts with no sentinel, so admitting one would widen the parse past what the authority
// says the file can hold. Two arms, not three -- a body of "max" in a count file is Unparseable,
// the correct reading of a kernel that should never have written it.
type CgroupMemoryCountValue
  = CgroupMemoryCount { bytes: ByteSize }
  | CgroupMemoryCountUnparseable { body: String }

fn parse_cgroup_memory_count(body: String) -> CgroupMemoryCountValue {
  match parse_cgroup_nonnegative_bytes(text: body) {
    Present { value: b } => CgroupMemoryCount { bytes: b }
    Absent => CgroupMemoryCountUnparseable { body: body }
  }
}
