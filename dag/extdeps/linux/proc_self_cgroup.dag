module extdeps.linux.proc_self_cgroup

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Https, Uri }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import std.types { FilePathParts, Int, List, NonEmptyStr, String }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man7/cgroups.7.html"
  }
}

data proc_self_cgroup_proc_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man5/proc.5.html#/proc/self/cgroup"
  }
}

type ProcSelfCgroupLineRefusal
  = ProcSelfCgroupLineMissingColon
  | ProcSelfCgroupLineMissingSecondColon
  | ProcSelfCgroupLineEmptyHierarchy
  | ProcSelfCgroupLineEmptyPath

type ProcSelfCgroupLineParse
  = ProcSelfCgroupLineParsed {
      hierarchy_id: NonEmptyStr,
      controller_list: String,
      relative_path: NonEmptyStr,
    }
  | ProcSelfCgroupLineRefused { cause: ProcSelfCgroupLineRefusal }

type ProcPidCgroupMembershipRecord
  = CurrentCgroupObserved { relative_path: NonEmptyStr }
  | MembershipMissing
  | MembershipAmbiguous { first: NonEmptyStr, second: NonEmptyStr }
  | MembershipMalformed { cause: ProcSelfCgroupLineRefusal }

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.linux.proc_self_cgroup",
      decl_name: "ProcPidCgroupMembershipRecord",
      field: WholeDeclaration
    }
  },
  first_citation: proc_self_cgroup_proc_authority,
  further_citations: [extdeps_external_authority_anchor]
}

type ProcSelfCgroupMalformedScan
  = NoMalformedLine
  | MalformedFound { cause: ProcSelfCgroupLineRefusal }

data proc_self_cgroup_empty_unified_paths: List<NonEmptyStr> = []

fn proc_self_cgroup_char_index_from(s: String, ch: String, from: Int) -> Int {
  let n = string_length(s: s)
  if from >= n {
    -1
  } else if char_at(s: s, pos: from) == ch {
    from
  } else {
    proc_self_cgroup_char_index_from(s: s, ch: ch, from: from + 1)
  }
}

fn proc_self_cgroup_line_from_wire(line: String) -> ProcSelfCgroupLineParse {
  let trimmed = trim(line)
  if trimmed == "" {
    ProcSelfCgroupLineRefused { cause: ProcSelfCgroupLineEmptyHierarchy }
  } else {
    let first = proc_self_cgroup_char_index_from(s: trimmed, ch: ":", from: 0)
    if first < 0 {
      ProcSelfCgroupLineRefused { cause: ProcSelfCgroupLineMissingColon }
    } else {
      let second = proc_self_cgroup_char_index_from(s: trimmed, ch: ":", from: first + 1)
      if second < 0 {
        ProcSelfCgroupLineRefused { cause: ProcSelfCgroupLineMissingSecondColon }
      } else {
        let hierarchy = substring(s: trimmed, start: 0, end: first)
        let controllers = substring(s: trimmed, start: first + 1, end: second)
        let path = substring(s: trimmed, start: second + 1, end: string_length(s: trimmed))
        if hierarchy == "" {
          ProcSelfCgroupLineRefused { cause: ProcSelfCgroupLineEmptyHierarchy }
        } else if path == "" {
          ProcSelfCgroupLineRefused { cause: ProcSelfCgroupLineEmptyPath }
        } else {
          ProcSelfCgroupLineParsed {
            hierarchy_id: hierarchy as NonEmptyStr,
            controller_list: controllers,
            relative_path: path as NonEmptyStr,
          }
        }
      }
    }
  }
}

fn proc_self_cgroup_is_unified_v2_line(hierarchy_id: NonEmptyStr, controller_list: String) -> Bool {
  (hierarchy_id as String == "0") && (controller_list == "")
}

fn proc_self_cgroup_nonempty_lines(content: String) -> List<String> {
  split(s: content, delimiter: "\n")
    |> filter(line => trim(line) != "")
    |> map(line => trim(line))
}

fn proc_self_cgroup_unified_hierarchy_paths_loop(
  lines: List<String>,
  acc: List<NonEmptyStr>,
) -> List<NonEmptyStr> {
  if list_length(items: lines) == 0 {
    acc
  } else {
    let line = lines.first()
    let rest = lines.skip(n: 1)
    match proc_self_cgroup_line_from_wire(line: line) {
      ProcSelfCgroupLineParsed { hierarchy_id: hid, controller_list: ctl, relative_path: path } =>
        if proc_self_cgroup_is_unified_v2_line(hierarchy_id: hid, controller_list: ctl) {
          proc_self_cgroup_unified_hierarchy_paths_loop(lines: rest, acc: concat(acc, [path]))
        } else {
          proc_self_cgroup_unified_hierarchy_paths_loop(lines: rest, acc: acc)
        }
      ProcSelfCgroupLineRefused { cause: _ } =>
        proc_self_cgroup_unified_hierarchy_paths_loop(lines: rest, acc: acc)
    }
  }
}

fn proc_self_cgroup_unified_hierarchy_paths(content: String) -> List<NonEmptyStr> {
  proc_self_cgroup_unified_hierarchy_paths_loop(
    lines: proc_self_cgroup_nonempty_lines(content: content),
    acc: proc_self_cgroup_empty_unified_paths,
  )
}

fn proc_self_cgroup_first_malformed_cause_loop(lines: List<String>) -> ProcSelfCgroupMalformedScan {
  if list_length(items: lines) == 0 {
    NoMalformedLine
  } else {
    let line = lines.first()
    match proc_self_cgroup_line_from_wire(line: line) {
      ProcSelfCgroupLineRefused { cause: c } => MalformedFound { cause: c }
      ProcSelfCgroupLineParsed { hierarchy_id: _, controller_list: _, relative_path: _ } =>
        proc_self_cgroup_first_malformed_cause_loop(lines: lines.skip(n: 1))
    }
  }
}

fn proc_self_cgroup_first_malformed_cause(content: String) -> ProcSelfCgroupMalformedScan {
  proc_self_cgroup_first_malformed_cause_loop(
    lines: proc_self_cgroup_nonempty_lines(content: content)
  )
}

fn read_unified_cgroup_membership(content: String) -> ProcPidCgroupMembershipRecord {
  match proc_self_cgroup_first_malformed_cause(content: content) {
    MalformedFound { cause: cause } => MembershipMalformed { cause: cause }
    NoMalformedLine =>
      let paths = proc_self_cgroup_unified_hierarchy_paths(content: content)
      if list_length(items: paths) == 0 {
        MembershipMissing
      } else if list_length(items: paths) == 1 {
        CurrentCgroupObserved { relative_path: paths.first() }
      } else {
        MembershipAmbiguous {
          first: paths.first(),
          second: paths.skip(n: 1).first(),
        }
      }
  }
}

data proc_self_cgroup_default_source: String = "/proc/self/cgroup"

fn proc_self_cgroup_mount_root_text(mount_root: FilePathParts) -> String {
  fold(mount_root.segments, init: "", f: fn(acc, seg) {
    let seg_text = seg as String
    if acc == "" { concat("/", seg_text) } else { concat(acc, concat("/", seg_text)) }
  })
}

fn proc_self_cgroup_absolute_path_from_relative(
  relative_path: NonEmptyStr,
  mount_root: FilePathParts,
) -> String {
  concat(proc_self_cgroup_mount_root_text(mount_root: mount_root), relative_path as String)
}

data bash_membership_refuse_malformed_body: String = "echo \"[calibration] cgroup_membership=malformed\" >&2; exit 1"

data bash_membership_refuse_missing_body: String = "echo \"[calibration] cgroup_membership=missing\" >&2; exit 1"

data bash_membership_refuse_ambiguous_body: String = "echo \"[calibration] cgroup_membership=ambiguous\" >&2; exit 1"

fn bash_membership_assign_from_record(
  record: ProcPidCgroupMembershipRecord,
  walk_var: NonEmptyStr,
  mount_root: FilePathParts,
) -> String {
  match record {
    CurrentCgroupObserved { relative_path: rel } =>
      concat(
        walk_var as String,
        "=\"",
        proc_self_cgroup_absolute_path_from_relative(relative_path: rel, mount_root: mount_root),
        "\"",
      )
    MembershipMissing => bash_membership_refuse_missing_body
    MembershipAmbiguous { first: _, second: _ } => bash_membership_refuse_ambiguous_body
    MembershipMalformed { cause: _ } => bash_membership_refuse_malformed_body
  }
}

fn bash_membership_assign_from_content(
  content: String,
  walk_var: NonEmptyStr,
  mount_root: FilePathParts,
) -> String {
  bash_membership_assign_from_record(
    record: read_unified_cgroup_membership(content: content),
    walk_var: walk_var,
    mount_root: mount_root,
  )
}

data bash_membership_runtime_scan_note: String = "Runtime bash scan is the single bash realization of read_unified_cgroup_membership for foreign-executor transport (shell->intent Phase 1). It lives beside the parser in extdeps.linux.proc_self_cgroup — not a second authority in bash_orch_if. Wet witnesses execute fixture files through bash_membership_assign_from_source and prove the scan agrees with read_unified_cgroup_membership on every planted outcome; compile-time witnesses route through bash_membership_assign_from_content instead."

data bash_membership_runtime_scan_loop: String = "_cg_bad=0; _cg_n=0; _cg_rel=\"\"; while IFS= read -r _cg_line || [ -n \"$_cg_line\" ]; do _cg_trim=$(echo \"$_cg_line\" | sed -e 's/^ //' -e 's/ $//'); [ -z \"$_cg_trim\" ] && continue; case \"$_cg_trim\" in *:*:*) ;; *) _cg_bad=1; continue ;; esac; _cg_h=$(echo \"$_cg_trim\" | cut -d: -f1); _cg_ctl=$(echo \"$_cg_trim\" | cut -d: -f2); _cg_path=$(echo \"$_cg_trim\" | cut -d: -f3-); [ -z \"$_cg_h\" ] && _cg_bad=1; [ -z \"$_cg_path\" ] && _cg_bad=1; if [ \"$_cg_h\" = \"0\" ] && [ -z \"$_cg_ctl\" ]; then _cg_n=$((_cg_n + 1)); _cg_rel=\"$_cg_path\"; fi; done"

fn bash_membership_runtime_scan_body(cgroup_source: String) -> String {
  concat(bash_membership_runtime_scan_loop, " < ", cgroup_source)
}

fn bash_membership_assign_from_source(
  cgroup_source: String,
  walk_var: NonEmptyStr,
  mount_root: FilePathParts,
) -> String {
  concat(
    "{ ",
    bash_membership_runtime_scan_body(cgroup_source: cgroup_source),
    "; ",
    "[ \"$_cg_bad\" -eq 1 ] && { ",
    bash_membership_refuse_malformed_body,
    "; }; ",
    "[ \"$_cg_n\" -eq 0 ] && { ",
    bash_membership_refuse_missing_body,
    "; }; ",
    "[ \"$_cg_n\" -gt 1 ] && { ",
    bash_membership_refuse_ambiguous_body,
    "; }; ",
    walk_var as String,
    "=\"",
    proc_self_cgroup_mount_root_text(mount_root: mount_root),
    "$_cg_rel\"; ",
    "} || exit 1",
  )
}
