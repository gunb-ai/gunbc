data proc_self_cgroup_proc_authority: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man5/proc.5.html#/proc/self/cgroup"
  }
}

type ProcSelfCgroupLineRefusal
  = ProcSelfCgroupLineMissingColon
  | ProcSelfCgroupLineMissingSecondColon
  | ProcSelfCgroupLineEmptyHierarchy
  | ProcSelfCgroupLineEmptyPath

type ProcSelfCgroupLineParse
  = ProcSelfCgroupLineParsed {
      hierarchy_id: std.types.NonEmptyStr,
      controller_list: String,
      relative_path: std.types.NonEmptyStr,
    }
  | ProcSelfCgroupLineRefused { cause: ProcSelfCgroupLineRefusal }

type ProcPidCgroupMembershipRecord
  = CurrentCgroupObserved { relative_path: std.types.NonEmptyStr }
  | MembershipMissing
  | MembershipAmbiguous { first: std.types.NonEmptyStr, second: std.types.NonEmptyStr }
  | MembershipMalformed { cause: ProcSelfCgroupLineRefusal }

type UnifiedMembershipOutcomeTag
  = OutcomeTagMissing
  | OutcomeTagAmbiguous
  | OutcomeTagMalformed
  | OutcomeTagObserved { relative_path: std.types.NonEmptyStr }

data extdeps_model_scope: extdeps.external_authority.ExternalModelScope = extdeps.external_authority.ExternalModelScope {
  subject: extdeps.external_authority.ExternalSubjectRef {
    declaration: std.decl_ref.DeclarationRef {
      module_path: "extdeps.linux.proc_self_cgroup",
