module extdeps.linux.kernel_random

import std.types { String }
import std.algebra { trim }
import std.optional { Present, Absent }
import extdeps.uuid { Uuid, uuid_of }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// random(4), the kernel's /proc/sys/kernel/random/boot_id: "a random UUID generated at boot" and constant
// until the next boot, so it names THIS boot of the running kernel and no other. Reading it is the only
// way a process learns the current boot independently of anything a supervisor told it.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man4/random.4.html"
  }
}

data kernel_boot_id_path: String = "/proc/sys/kernel/random/boot_id"

// DECODE: the file is the UUID plus one newline (random(4) prints it with a trailing newline), so the reading is
// trim then extdeps.uuid uuid_of; any other content is no boot id and decodes to Absent, never to a default.
fn kernel_boot_id_of(text: String) -> Uuid? {
  uuid_of(text: trim(s: text))
}
