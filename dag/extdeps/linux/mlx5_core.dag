module extdeps.linux.mlx5_core

import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.linux.kernel { LinuxKernelModuleName }
import extdeps.uri { Uri, Https }

// THE KERNEL MODULE THAT BINDS CONNECTX-4 LX. mlx5_core is the loadable name `lsmod`, modprobe and
// /sys/module key on for the mlx5 Ethernet/RDMA family, cited from the kernel's own Mellanox mlx5
// documentation. This module owns the driver's name, not a PCI device-id table and not any
// observation of a particular card. A seated ConnectX-4 Lx that Linux has not yet enumerated stays
// unobserved in the machine-intake receipt; this row is the instrument that receipt names.
// Consumer: gunbc.machine_intake_mtcollins1_connectx4lx_observation.connectx4lx_host_observation.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https,
    locator: "docs.kernel.org/networking/device_drivers/ethernet/mellanox/mlx5/index.html",
  }
}

data mlx5_core_module_name: LinuxKernelModuleName = "mlx5_core" as LinuxKernelModuleName

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.linux.mlx5_core",
      decl_name: "mlx5_core_module_name",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [],
}
