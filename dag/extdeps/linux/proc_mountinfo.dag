module extdeps.linux.proc_mountinfo

import std.types { NonEmptyStr, String, List, Bool, Int }
import std.optional { Present, Absent }
import std.algebra { trim }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

// /proc/[pid]/mountinfo, proc_pid_mountinfo(5): one line per mount in the process's mount namespace,
// space-separated, whose FIFTH field is the mount point "relative to the process's root directory".
// Fields 1-6 precede an optional-fields list terminated by a single "-", so the mount point's
// position is fixed even when optional fields are present. (man7.org, read 2026-09-23.)
//
// THE KERNEL ESCAPES SPACE, TAB, NEWLINE AND BACKSLASH IN PATH FIELDS AS OCTAL (\040, \011, \012,
// \134). This model does not decode them; a mount-point field carrying a backslash is reported as
// undecodable, so a consumer that must know every mount under a path refuses on it rather than
// comparing an escaped spelling against a real path and missing the mount.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man5/proc_pid_mountinfo.5.html"
  }
}

data mountinfo_mount_point_field_index: Int = 4

type MountinfoMountPoints
  = MountPointsRead { mount_points: List<String> }
  | MountPointsUndecodable { line: String, cause: NonEmptyStr }

type MountinfoFold { points: List<String>, refusal: MountinfoMountPoints? }

fn mountinfo_mount_points(content: String) -> MountinfoMountPoints {
  let folded = fold(
    filter(map(split(s: content, delimiter: "\n"), l => trim(l)), l => l != ""),
    init: MountinfoFold { points: [], refusal: none },
    f: (acc, line) => match acc.refusal {
      Present { value: _ } => acc
      Absent => {
        let fields = split(s: line, delimiter: " ")
        match fields[mountinfo_mount_point_field_index] {
          Absent => MountinfoFold { points: acc.points, refusal: Present { value: MountPointsUndecodable { line: line, cause: "the line has fewer than five fields, so it names no mount point" as NonEmptyStr } } }
          Present { value: point } =>
            if string_contains(s: point, pattern: "\\") {
              MountinfoFold { points: acc.points, refusal: Present { value: MountPointsUndecodable { line: line, cause: "the mount point carries a kernel octal escape, which this model does not decode" as NonEmptyStr } } }
            } else {
              MountinfoFold { points: list_push(acc.points, point), refusal: none }
            }
        }
      }
    },
  )
  match folded.refusal {
    Present { value: r } => r
    Absent => MountPointsRead { mount_points: folded.points }
  }
}

// THE MOUNT THAT HOLDS A PATH, with the filesystem type and the SUPER options the kernel reports for it.
// proc_pid_mountinfo(5): after the optional fields comes a single " - " separator, then the filesystem
// type, the mount source and the per-superblock options (field 6 before the separator is the per-MOUNT
// option list and is not read here: a tmpfs size/mode/noswap setting is a superblock option). The
// separator is " - " with spaces on both sides because every space inside a path field is escaped.
type MountinfoEntry {
  mount_id: Int
  parent_id: Int
  mount_point: String
  fs_type: String
  super_options: List<String>
}

type MountinfoEntries
  = MountEntriesRead { entries: List<MountinfoEntry> }
  | MountEntriesUndecodable { line: String, cause: NonEmptyStr }

type MountinfoEntryReading
  = MountinfoEntryParsed { entry: MountinfoEntry }
  | MountinfoEntryRefused { cause: NonEmptyStr }

data mountinfo_super_options_field_index: Int = 2
data mountinfo_mount_id_field_index: Int = 0
data mountinfo_parent_id_field_index: Int = 1

fn mountinfo_entry_of_fields(before: List<String>, after: List<String>) -> MountinfoEntryReading {
  match before[mountinfo_mount_id_field_index] {
    Absent => MountinfoEntryRefused { cause: "the line has no mount ID" as NonEmptyStr }
    Present { value: id_text } =>
      match before[mountinfo_parent_id_field_index] {
        Absent => MountinfoEntryRefused { cause: "the line has no parent mount ID" as NonEmptyStr }
        Present { value: parent_text } =>
          match parse_int(s: id_text) {
            Absent => MountinfoEntryRefused { cause: "the mount ID is not an integer" as NonEmptyStr }
            Present { value: id } =>
              match parse_int(s: parent_text) {
                Absent => MountinfoEntryRefused { cause: "the parent mount ID is not an integer" as NonEmptyStr }
                Present { value: parent } => mountinfo_entry_over_ids(id: id, parent: parent, before: before, after: after)
              }
          }
      }
  }
}

fn mountinfo_entry_over_ids(id: Int, parent: Int, before: List<String>, after: List<String>) -> MountinfoEntryReading {
  match before[mountinfo_mount_point_field_index] {
    Absent => MountinfoEntryRefused { cause: "the line has fewer than five fields before its separator, so it names no mount point" as NonEmptyStr }
    Present { value: point } =>
      match after[0] {
        Absent => MountinfoEntryRefused { cause: "the line has no filesystem type after its separator" as NonEmptyStr }
        Present { value: fs } =>
          match after[mountinfo_super_options_field_index] {
            Absent => MountinfoEntryRefused { cause: "the line has no super-options field after its separator" as NonEmptyStr }
            Present { value: options } =>
              if string_contains(s: point, pattern: "\\") {
                MountinfoEntryRefused { cause: "the mount point carries a kernel octal escape, which this model does not decode" as NonEmptyStr }
              } else {
                MountinfoEntryParsed { entry: MountinfoEntry { mount_id: id, parent_id: parent, mount_point: point, fs_type: fs, super_options: split(s: options, delimiter: ",") } }
              }
          }
      }
  }
}

fn mountinfo_entry_of_line(line: String) -> MountinfoEntryReading {
  let halves = split(s: line, delimiter: " - ")
  match halves[0] {
    Absent => MountinfoEntryRefused { cause: "the line is empty" as NonEmptyStr }
    Present { value: before } =>
      match halves[1] {
        Absent => MountinfoEntryRefused { cause: "the line has no ' - ' separator between its mount fields and its filesystem fields" as NonEmptyStr }
        Present { value: after } =>
          mountinfo_entry_of_fields(before: split(s: before, delimiter: " "), after: split(s: after, delimiter: " "))
      }
  }
}

type MountinfoEntriesFold { entries: List<MountinfoEntry>, refusal: MountinfoEntries? }

fn mountinfo_entries(content: String) -> MountinfoEntries {
  let folded = fold(
    filter(map(split(s: content, delimiter: "\n"), l => trim(l)), l => l != ""),
    init: MountinfoEntriesFold { entries: [], refusal: none },
    f: (acc, line) => match acc.refusal {
      Present { value: _ } => acc
      Absent =>
        match mountinfo_entry_of_line(line: line) {
          MountinfoEntryRefused { cause: c } => MountinfoEntriesFold { entries: acc.entries, refusal: Present { value: MountEntriesUndecodable { line: line, cause: c } } }
          MountinfoEntryParsed { entry: e } => MountinfoEntriesFold { entries: list_push(acc.entries, e), refusal: none }
        }
    },
  )
  match folded.refusal {
    Present { value: r } => r
    Absent => MountEntriesRead { entries: folded.entries }
  }
}

// THE MOUNT THAT HOLDS A PATH IS FOUND BY DESCENDING THE MOUNT TREE, NOT BY LONGEST SPELLING. proc_pid_mountinfo(5)
// gives every mount its ID and its PARENT's ID, and a mount mounted OVER another at the same mount point has
// that mount as its parent and hides it, together with everything mounted beneath it. So the visible holder of
// a path starts at the one root (the mount whose parent is no listed mount) and repeatedly takes the child
// that holds the path: a child mounted at its parent's own mount point covers the parent and wins outright (the
// parent's other children are beneath it), otherwise the child with the SHORTEST mount point:
// a mount's parent is the mount that held its mount point WHEN IT WAS MOUNTED, so two children of one parent
// whose points nest are in hiding order, the shallower one mounted later and hiding the deeper (a deeper mount
// made after the shallower one would have the shallower as its parent). A longest-path choice over the flat
// list instead picks a noswap mount a later covering mount has hidden.
// VISIBILITY THAT CANNOT BE RESOLVED IS A REFUSAL, never a guess: no unique root, two children tying for the
// same visible position, or a descent that does not settle within one step per listed mount.
fn mountinfo_holds_path(entry: MountinfoEntry, path: String) -> Bool {
  entry.mount_point == path || starts_with(s: path, prefix: if entry.mount_point == "/" { "/" } else { concat(entry.mount_point, "/") })
}

type MountinfoHolding
  = MountHolds { entry: MountinfoEntry }
  | MountHoldsNone
  | MountVisibilityUnresolved { cause: NonEmptyStr }

type MountinfoDescent
  = DescentOn { entry: MountinfoEntry }
  | DescentSettled { entry: MountinfoEntry }
  | DescentUnresolved { cause: NonEmptyStr }

fn mountinfo_child_holding(e: MountinfoEntry, parent: MountinfoEntry, path: String) -> Bool {
  e.parent_id == parent.mount_id && e.mount_id != parent.mount_id && mountinfo_holds_path(entry: e, path: path)
}

fn mountinfo_covers(e: MountinfoEntry, parent: MountinfoEntry) -> Bool {
  e.mount_point == parent.mount_point
}

fn mountinfo_shorter(m: Int, k: MountinfoEntry) -> Int {
  if m < 0 || string_length(s: k.mount_point) < m { string_length(s: k.mount_point) } else { m }
}

fn mountinfo_is_shallowest(k: MountinfoEntry, shallowest: Int) -> Bool {
  string_length(s: k.mount_point) == shallowest
}

fn mountinfo_descent_from(cur: MountinfoEntry, kids: List<MountinfoEntry>) -> MountinfoDescent {
  let covering = filter(kids, k => mountinfo_covers(e: k, parent: cur))
  match covering[0] {
    Present { value: c } =>
      if count(covering) == 1 {
        DescentOn { entry: c }
      } else {
        DescentUnresolved { cause: "two mounts are mounted over the same mount, so which one is visible is not decided" as NonEmptyStr }
      }
    Absent => {
      let shallowest = fold(kids, init: 0 - 1, f: (m, k) => mountinfo_shorter(m: m, k: k))
      let tops = filter(kids, k => mountinfo_is_shallowest(k: k, shallowest: shallowest))
      match tops[0] {
        Absent => DescentSettled { entry: cur }
        Present { value: t } =>
          if count(tops) == 1 {
            DescentOn { entry: t }
          } else {
            DescentUnresolved { cause: "two sibling mounts tie at the same mount point, so which one is visible is not decided" as NonEmptyStr }
          }
      }
    }
  }
}

fn mountinfo_descent_step(state: MountinfoDescent, entries: List<MountinfoEntry>, path: String) -> MountinfoDescent {
  match state {
    DescentOn { entry: cur } => mountinfo_descent_from(cur: cur, kids: filter(entries, e => mountinfo_child_holding(e: e, parent: cur, path: path)))
    other => state
  }
}

fn mountinfo_is_root(e: MountinfoEntry, entries: List<MountinfoEntry>) -> Bool {
  !any(entries, o => o.mount_id == e.parent_id)
}

fn mountinfo_mount_holding(entries: List<MountinfoEntry>, path: String) -> MountinfoHolding {
  let roots = filter(entries, e => mountinfo_is_root(e: e, entries: entries))
  match roots[0] {
    Absent => MountVisibilityUnresolved { cause: "no mount in the table is a root, so the mount tree is not decided" as NonEmptyStr }
    Present { value: root } =>
      if count(roots) != 1 {
        MountVisibilityUnresolved { cause: "more than one mount has no listed parent, so the mount tree is not decided" as NonEmptyStr }
      } else if !mountinfo_holds_path(entry: root, path: path) {
        MountHoldsNone
      } else {
        match fold(entries, init: DescentOn { entry: root }, f: (st, e) => mountinfo_descent_step(state: st, entries: entries, path: path)) {
          DescentSettled { entry: e } => MountHolds { entry: e }
          DescentUnresolved { cause: c } => MountVisibilityUnresolved { cause: c }
          DescentOn { entry: _ } => MountVisibilityUnresolved { cause: "the descent through the mount tree did not settle within one step per mount" as NonEmptyStr }
        }
      }
  }
}
