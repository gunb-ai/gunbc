module extdeps.linux.proc_uptime

import std.types { Int, String }
import std.nat { Nat }
import std.measure { Millisecond, millisecond, milliseconds_per_second }
import std.checked_arithmetic { checked_int_to_nat }
import v2.std.optional { Present, Absent }
import std.algebra { trim }
import v2.std.algebra { filter, skip }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import extdeps.linux.procfs

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "man7.org/linux/man-pages/man5/proc_uptime.5.html"
  }
}

// /proc/uptime's SHAPE. proc_uptime(5): two numbers in seconds, the system's uptime (including time
// spent in suspend) and the time spent idle. The kernel prints each as `%lu.%02lu`
// (fs/proc/uptime.c), so the resolution is one centisecond and the fraction is always two digits.
// The first value comes from the kernel's boot-based clock, which a wall-clock step (NTP, settimeofday)
// does not move. That is why a duration between two readings of it is an elapsed interval, while two
// `date` readings are not. This module owns the file's shape; the read is extdeps.linux.procfs
// ReadUptime, one transport of N (DESIGN §3). The reading is carried as std.measure Millisecond:
// std.measure has no centisecond scale, and the centisecond is a fact of this FORMAT, so the
// conversion happens here, in the parse, and nowhere downstream.
type ProcUptimeRead
  = UptimeObserved { uptime: Millisecond }
  | UptimeRefused { detail: String }

// `%02lu`: the fraction counts hundredths of a second (fs/proc/uptime.c).
data proc_uptime_fraction_units_per_second: Nat = 100

// ANYTHING BUT `digits.two-digits` REFUSES with the text it read; no field is defaulted.
fn proc_uptime_parse(text: String) -> ProcUptimeRead {
  let words = filter(split(s: trim(s: text), delimiter: " "), w => w != "")
  match words.first() {
    Absent => UptimeRefused { detail: concat("/proc/uptime is empty: '", text, "'") }
    Present { value: first } => {
      let parts = split(s: first, delimiter: ".")
      if count(parts) != 2 {
        UptimeRefused { detail: concat("/proc/uptime first field is not seconds.centiseconds: '", first, "'") }
      } else {
        match parts.first() {
          Absent => UptimeRefused { detail: concat("/proc/uptime first field unreadable: '", first, "'") }
          Present { value: whole } =>
            match parts.skip(n: 1).first() {
              Absent => UptimeRefused { detail: concat("/proc/uptime first field unreadable: '", first, "'") }
              Present { value: frac } =>
                if string_length(s: frac) != 2 {
                  UptimeRefused { detail: concat("/proc/uptime fraction is not two digits: '", first, "'") }
                } else {
                  match parse_int(s: whole) {
                    Absent => UptimeRefused { detail: concat("/proc/uptime seconds not an integer: '", first, "'") }
                    Present { value: s } =>
                      match parse_int(s: frac) {
                        Absent => UptimeRefused { detail: concat("/proc/uptime centiseconds not an integer: '", first, "'") }
                        Present { value: c } =>
                          match checked_int_to_nat(n: s) {
                            Absent => UptimeRefused { detail: concat("/proc/uptime is negative: '", first, "'") }
                            Present { value: secs } =>
                              match checked_int_to_nat(n: c) {
                                Absent => UptimeRefused { detail: concat("/proc/uptime is negative: '", first, "'") }
                                Present { value: hundredths } =>
                                  UptimeObserved { uptime: millisecond(count: secs * milliseconds_per_second()
                                    + hundredths * (milliseconds_per_second() / proc_uptime_fraction_units_per_second)) }
                              }
                          }
                      }
                  }
                }
            }
        }
      }
    }
  }
}


// ONE READING THROUGH THE procfs TRANSPORT. A failed read is its own refusal, never a parse of the
// empty text it left behind.
fn proc_uptime_read() -> ProcUptimeRead {
  let r = linux.Procfs.ReadUptime()
  if r.success { proc_uptime_parse(text: r.value) } else { UptimeRefused { detail: concat("/proc/uptime read failed: '", r.value, "'") } }
}
