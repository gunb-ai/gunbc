module extdeps.tools



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/tools"
  }
}

type InstallSource
  = SourceCoreutils
  | SourceRustup
  | SourceBrew { formula: std.types.NonEmptyStr }
  | SourceApt { package: std.types.NonEmptyStr }
  | SourceGitHubRelease {
      repo: std.types.NonEmptyStr
      tag: std.types.NonEmptyStr
      asset_aarch64: std.types.NonEmptyStr
      asset_x86_64: std.types.NonEmptyStr
      install_path: std.types.NonEmptyStr
    }

type CliTool {
  name: std.types.NonEmptyStr
  min_version: extdeps.version.VersionConstraint?
  installable_via: List<InstallSource>
}

type ResolvedTool {
  tool: CliTool
  path: std.types.FilePath
}

type ResolveResult
  = Resolved { resolved: ResolvedTool }
  | NotFound { tool: CliTool, hint: String }

fn one_hint(source: InstallSource) -> String {
  match source {
    SourceCoreutils => "expected from system coreutils (GNU on Linux, BSD on macOS)"
    SourceRustup => concat("install rustup from ", rustup_install_url)
    SourceBrew { formula: f } => concat("brew install ", f)
    SourceApt { package: p } => concat("apt install ", p)
    SourceGitHubRelease { repo: r, tag: t, install_path: p, asset_aarch64: _, asset_x86_64: _ } =>
      concat(
        concat(concat(concat("install ", p as String), " from github.com/"), r as String),
        concat("/releases/tag/", t as String),
      )
  }
}

fn install_hint(sources: List<InstallSource>) -> String {
  sources |> map(s => one_hint(source: s)) |> join(separator: " | ")
}

func resolve(tool: CliTool) -> ResolveResult {
  let check = shell.Which.Check(command: tool.name)
  match check.path {
    Present { value: p } => Resolved { resolved: { tool: tool, path: p } }
    Absent => NotFound { tool: tool, hint: install_hint(sources: tool.installable_via) }
  }
}
