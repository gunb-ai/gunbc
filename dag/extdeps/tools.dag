module extdeps.tools

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

import std.types { FilePath, NonEmptyStr }
import extdeps.shell
import extdeps.tools.gnu_coreutils
import extdeps.rustup { rustup_install_url }
import extdeps.brew   { brew_install_url }
import extdeps.apt
import extdeps.version { VersionConstraint }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/gunb-ai/gunbc/tree/main/dag/extdeps/tools"
  }
}

type InstallSource
  = SourceCoreutils
  | SourceRustup
  | SourceBrew { formula: NonEmptyStr }
  | SourceApt { package: NonEmptyStr }
  | SourceGitHubRelease {
      repo: NonEmptyStr
      tag: NonEmptyStr
      asset_aarch64: NonEmptyStr
      asset_x86_64: NonEmptyStr
      install_path: NonEmptyStr
    }

type CliTool {
  name: NonEmptyStr
  min_version: VersionConstraint?
  installable_via: List<InstallSource>
}

type ResolvedTool {
  tool: CliTool
  path: FilePath
}

type ResolveResult
  = Resolved { resolved: ResolvedTool }
  | NotFound { tool: CliTool, hint: String }

fn one_hint(source: InstallSource) -> String {
  match source {
    SourceCoreutils => "expected from system coreutils (GNU on Linux, BSD on macOS)"
    SourceRustup => concat("install rustup from ", rustup_install_url)
    SourceBrew { formula: f } => concat("brew install ", f)
    SourceApt { package: p } => concat("apt install ", p)
    SourceGitHubRelease { repo: r, tag: t, install_path: p, asset_aarch64: _, asset_x86_64: _ } =>
      concat(
        concat(concat(concat("install ", p as String), " from github.com/"), r as String),
        concat("/releases/tag/", t as String),
      )
  }
}

fn install_hint(sources: List<InstallSource>) -> String {
  sources |> map(s => one_hint(source: s)) |> join(separator: " | ")
}

// THE APT PACKAGE, STRUCTURALLY, BESIDE THE SENTENCE. one_hint renders every InstallSource as
// PROSE for a human, and until now that was the only thing that read the variants -- so a caller
// that wanted to ACT on an install source had nothing to read and would have re-authored the
// package name beside the tool. This is the same fold, asked for the value rather than the wording,
// and it is what lets a convergence consume `installable_via` instead of carrying a second package
// row that could disagree with it (§3).
//
// IT IS OPTIONAL AND NOT A DEFAULT. installable_via is a LIST and a tool may legitimately carry no
// apt source at all -- websocat is a GitHub release, rustfmt comes from rustup, the coreutils tools
// come with the system -- so "no apt package" is a real and correct answer, not a failure of this
// function. Absent is returned rather than a fabricated package name, and the CALLER names the tool
// in its refusal, because the caller is what knows why it wanted one. A default here would be the
// §5 fabricated-plausible-output arm: `apt install <binary name>` is right often enough to look
// correct and wrong exactly where the package and the binary differ (mosquitto_pub from
// mosquitto-clients, busybox from busybox-static -- both already in this corpus).
//
// FIRST MATCH WINS and the order is the roster's. No tool in the corpus declares two apt sources;
// if one ever does, the row is expressing a choice this fold cannot make and the roster is where
// that belongs.
fn apt_package_of(tool: CliTool) -> NonEmptyStr? {
  fold_list(
    xs: tool.installable_via,
    empty: none,
    cons: fn(acc, source) {
      match acc {
        Present { value: found } => Present { value: found }
        Absent =>
          match source {
            SourceApt { package: p } => Present { value: p }
            SourceCoreutils => none
            SourceRustup => none
            SourceBrew { formula: _ } => none
            SourceGitHubRelease {
              repo: _, tag: _, asset_aarch64: _, asset_x86_64: _, install_path: _
            } => none
          }
      }
    },
  )
}

// Migrated off shell.Which.Check to shell.PosixCommandV.Check (crisp-wren-896, PR #8590): no fleet
// host's OperatingSystemSurface carries a package-set authority, our own CI/falsifier runner
// included, so `which`'s external-binary presence was never an established fact here either, and
// command -v's weaker, dominant POSIX-shell assumption holds everywhere `which` did. UNLIKE the
// other four migrated call sites, this function reads .path as a resolved filesystem path rather
// than keying on .exists alone, so TWO hazards genuinely apply here rather than being ruled out:
// (1) command -v prints the bare NAME rather than a resolved path when the probed command is a
// shell builtin or alias, not an external binary -- every tool.name this resolves is expected to be
// an external binary (coreutils, rustup, apt, brew, or a GitHub-release install), so this is not
// believed to bite in practice, but it is not structurally excluded the way it is for the four
// .exists-only sites; (2) under WET execution PosixCommandV.Check.path comes back as a bare stdout
// String rather than a real Optional, so the Present/Absent match below relies on the same
// Value::Null / Optional realization straddle (DESIGN open thread) that gunbc.host_cli_dependency's
// which_path_realization_limit_note and gunbc.roadmap_belt_actuate's belt_program_available_note
// document -- this function has no current live caller in the tree (verified by grep, PR #8590), so
// the straddle is undischarged debt rather than an observed WET failure.

fn resolve(tool: CliTool) -> ResolveResult {
  let check = shell.PosixCommandV.Check(command: tool.name)
  match check.path {
    Present { value: p } => Resolved { resolved: { tool: tool, path: p } }
    Absent => NotFound { tool: tool, hint: install_hint(sources: tool.installable_via) }
  }
}
