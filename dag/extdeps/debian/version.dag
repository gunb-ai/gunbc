module extdeps.debian.version

import std.types { Bool, Int, List, NonEmptyStr, String }
import std.optional { Present, Absent }
import std.algebra { trim }
import std.decimal { decimal_digit_char }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }
import std.integer { parse_int }

// DEBIAN PACKAGE VERSIONS AND THE RELATIONS BETWEEN PACKAGES, as Debian Policy defines them.
//
// A version is [epoch:]upstream_version[-debian_revision] (Policy 5.6.12). Two versions compare
// epoch first (numerically, absent = 0), then upstream, then revision (absent = "0"), each of the
// last two by dpkg's verrevcmp: alternate maximal runs of non-digits and digits; non-digit runs
// compare character by character where letters sort before non-letters and '~' sorts before
// everything, even the end of the string; digit runs compare numerically.
//
// A relationship field (Policy 7.1) is comma-separated relations, each an OR of alternatives
// `name[:arch] [(op version)]` with op one of <<, <=, =, >=, >>.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.debian.org/doc/debian-policy/ch-controlfields.html#version"
  }
}

type DebianVersion {
  epoch: Int
  upstream: String
  revision: String
}

fn version_chars_admitted(s: String, i: Int) -> Bool {
  if i >= string_length(s: s) { true }
  else {
    let c = char_at(s: s, pos: i)
    (decimal_digit_char(ch: c) || c == "~" || rank_in(order: version_letter_order, c: c, i: 0) >= 0 || rank_in(order: version_punctuation_order, c: c, i: 0) >= 0)
      && version_chars_admitted(s: s, i: i + 1)
  }
}

fn parse_debian_version(text: String) -> DebianVersion? {
  let t = trim(s: text)
  if t == "" || !version_chars_admitted(s: t, i: 0) { none } else {
    let colon: List<String> = t.split(delimiter: ":")
    let epoch_and_rest = if count(colon) >= 2 {
      match colon.first() {
        Present { value: e } => match parse_int(s: e) {
          Present { value: n } => Present { value: DebianVersion { epoch: n, upstream: join(skip(colon, 1), ":"), revision: "" } }
          Absent => none
        }
        Absent => none
      }
    } else { Present { value: DebianVersion { epoch: 0, upstream: t, revision: "" } } }
    match epoch_and_rest {
      Absent => none
      Present { value: v } => {
        let dash: List<String> = v.upstream.split(delimiter: "-")
        if count(dash) >= 2 {
          Present { value: DebianVersion { epoch: v.epoch, upstream: join(take(dash, count(dash) - 1), "-"), revision: match skip(dash, count(dash) - 1).first() { Present { value: r } => r  Absent => "" } } }
        } else { Present { value: v } }
      }
    }
  }
}

// dpkg's character order over the characters Policy admits in a version: '~' below everything,
// letters in ASCII order, then the remaining punctuation in ASCII order. A character outside that set
// has no rank, and a version containing one does not parse.
data version_letter_order: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
data version_punctuation_order: String = "+-.:"

fn rank_in(order: String, c: String, i: Int) -> Int {
  if i >= string_length(s: order) { 0 - 1 } else if char_at(s: order, pos: i) == c { i } else { rank_in(order: order, c: c, i: i + 1) }
}

fn char_order(c: String) -> Int {
  if c == "~" { 0 - 1 }
  else {
    let l = rank_in(order: version_letter_order, c: c, i: 0)
    if l >= 0 { l + 1 } else { 100 + rank_in(order: version_punctuation_order, c: c, i: 0) }
  }
}


fn first_char(s: String) -> String {
  if string_length(s: s) == 0 { "" } else { char_at(s: s, pos: 0) }
}

fn rest(s: String) -> String {
  if string_length(s: s) == 0 { "" } else { substring(s: s, start: 1, end: string_length(s: s)) }
}

// The non-digit prefix comparison: '~' below the end of string, the end of string below anything else.
fn cmp_non_digit(a: String, b: String) -> Int {
  let ca = first_char(s: a)
  let cb = first_char(s: b)
  let a_end = ca == "" || decimal_digit_char(ch: ca)
  let b_end = cb == "" || decimal_digit_char(ch: cb)
  if a_end && b_end { 0 }
  else {
    let oa = if a_end { 0 } else { char_order(c: ca) }
    let ob = if b_end { 0 } else { char_order(c: cb) }
    if oa < ob { 0 - 1 } else if oa > ob { 1 } else { cmp_non_digit(a: rest(s: a), b: rest(s: b)) }
  }
}

fn digit_prefix(s: String) -> String {
  let c = first_char(s: s)
  if c != "" && decimal_digit_char(ch: c) { concat(c, digit_prefix(s: rest(s: s))) } else { "" }
}

fn non_digit_prefix_len(s: String) -> Int {
  let c = first_char(s: s)
  if c == "" || decimal_digit_char(ch: c) { 0 } else { 1 + non_digit_prefix_len(s: rest(s: s)) }
}

fn strip_leading_zeros(s: String) -> String {
  if first_char(s: s) == "0" { strip_leading_zeros(s: rest(s: s)) } else { s }
}

// Two digit runs compared as the unbounded integers dpkg reads them as, with no machine-width parse:
// leading zeros dropped (an empty run is zero), then the longer run is the larger, and runs of equal
// length compare digit by digit. Every run compares, so no width limit can turn one into zero.
fn cmp_digit_runs(a: String, b: String) -> Int {
  let x = strip_leading_zeros(s: a)
  let y = strip_leading_zeros(s: b)
  let lx = string_length(s: x)
  let ly = string_length(s: y)
  if lx < ly { 0 - 1 } else if lx > ly { 1 } else if x < y { 0 - 1 } else if x > y { 1 } else { 0 }
}

fn verrevcmp(a: String, b: String) -> Int {
  if a == "" && b == "" { 0 }
  else {
    let nd = cmp_non_digit(a: a, b: b)
    if nd != 0 { nd }
    else {
      let a1 = substring(s: a, start: non_digit_prefix_len(s: a), end: string_length(s: a))
      let b1 = substring(s: b, start: non_digit_prefix_len(s: b), end: string_length(s: b))
      let da = digit_prefix(s: a1)
      let db = digit_prefix(s: b1)
      let nd_cmp = cmp_digit_runs(a: da, b: db)
      if nd_cmp != 0 { nd_cmp }
      else {
        let a2 = substring(s: a1, start: string_length(s: da), end: string_length(s: a1))
        let b2 = substring(s: b1, start: string_length(s: db), end: string_length(s: b1))
        if a2 == a && b2 == b { 0 } else { verrevcmp(a: a2, b: b2) }
      }
    }
  }
}

fn compare_debian_versions(a: DebianVersion, b: DebianVersion) -> Int {
  if a.epoch < b.epoch { 0 - 1 } else if a.epoch > b.epoch { 1 }
  else {
    let u = verrevcmp(a: a.upstream, b: b.upstream)
    if u != 0 { u } else { verrevcmp(a: if a.revision == "" { "0" } else { a.revision }, b: if b.revision == "" { "0" } else { b.revision }) }
  }
}

// ── relations ───────────────────────────────────────────────────────────────────────────────────

type DebianRelationOp = RelEarlier | RelEarlierEqual | RelExact | RelLaterEqual | RelLater

type DebianAlternative {
  package: String
  constraint: DebianVersionConstraint?
}

type DebianVersionConstraint { op: DebianRelationOp, version: String }

fn parse_relation_op(text: String) -> DebianRelationOp? {
  if text == "<<" { Present { value: RelEarlier } }
  else if text == "<=" { Present { value: RelEarlierEqual } }
  else if text == "=" { Present { value: RelExact } }
  else if text == ">=" { Present { value: RelLaterEqual } }
  else if text == ">>" { Present { value: RelLater } }
  else { none }
}

// One alternative: `name[:arch] [(op version)]`. A malformed one is absent, and the caller refuses.
fn parse_debian_alternative(text: String) -> DebianAlternative? {
  let t = trim(s: text)
  let open: List<String> = t.split(delimiter: "(")
  let name_part = trim(s: match open.first() { Present { value: n } => n  Absent => "" })
  let name = trim(s: match name_part.split(delimiter: ":").first() { Present { value: n } => n  Absent => "" })
  if name == "" { none }
  else if count(open) == 1 { Present { value: DebianAlternative { package: name, constraint: none } } }
  else {
    let inner = trim(s: match skip(open, 1).first() { Present { value: i } => i.replace(")", "")  Absent => "" })
    let words = filter(inner.split(delimiter: " "), w => w != "")
    match words.first() {
      Absent => none
      Present { value: op_text } => match parse_relation_op(text: op_text) {
        Absent => none
        Present { value: op } => match skip(words, 1).first() {
          Absent => none
          Present { value: v } => Present { value: DebianAlternative { package: name, constraint: Present { value: DebianVersionConstraint { op: op, version: v } } } }
        }
      }
    }
  }
}

// A relationship field: the list of relations, each a list of alternatives. Absent when any part is
// malformed: a relation that cannot be read is never treated as satisfied.
fn parse_debian_relationships(field: String) -> List<List<DebianAlternative>>? {
  let relations = filter(field.split(delimiter: ","), r => trim(s: r) != "")
  fold(relations, init: Present { value: [] }, f: (acc, relation) => match acc {
    Absent => none
    Present { value: done } => {
      let alts = map(relation.split(delimiter: "|"), a => parse_debian_alternative(text: a))
      if count(filter(alts, a => match a { Absent => true  Present { value: _ } => false })) > 0 { none }
      else { Present { value: done + [flat_map(alts, a => match a { Present { value: x } => [x]  Absent => [] })] } }
    }
  })
}

fn constraint_satisfied(constraint: DebianVersionConstraint, candidate: String) -> Bool {
  match parse_debian_version(text: candidate) {
    Absent => false
    Present { value: have } => match parse_debian_version(text: constraint.version) {
      Absent => false
      Present { value: want } => {
        let c = compare_debian_versions(a: have, b: want)
        match constraint.op {
          RelEarlier => c < 0
          RelEarlierEqual => c <= 0
          RelExact => c == 0
          RelLaterEqual => c >= 0
          RelLater => c > 0
        }
      }
    }
  }
}
