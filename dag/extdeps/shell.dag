module extdeps.shell

import std.types { FilePath, NonEmptyStr, Secret, String, List }
import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html"
  }
}

data find_files_and_symlinks_positional_note: String = "The script body is a FIXED literal owned here, and root arrives as the positional parameter $1 rather than being spliced into it — so no path can escape a quote, which is exactly what a caller-side concat into a single-quoted find string permitted (review 50535). The pipe to sort stays inside the operation because it is load-bearing: find walks directories in filesystem order, and the caller digests the resulting listing into a tree identity, so an unsorted read would make that identity depend on traversal order. It cannot move into the substrate today — std.primitives declares a sort contract but no callable sort exists (probed, 2026-08-08), which is the dissolve-on for folding this ordering back out of the shell. GNU find -printf keeps this operation Linux-only, per the caller's own linux_find_note."


service shell.Find {
  operation ListDirs {
    input { path: FilePath, max_depth: Int = 1, min_depth: Int = 1 }
    output { dirs: List<FilePath> from "stdout_lines" }
    readonly
    transport shell { argv: ["find", "{path}", "-maxdepth", "{max_depth}", "-mindepth", "{min_depth}", "-type", "d"] }
    exit {
      0 => Unit
      nonzero => String "Find command failed"
    }
  }

  operation FilesAndSymlinksWithMode {
    input { root: FilePath }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell {
      argv: [
        "sh", "-c",
        "find \"$1\" \\( -type f -o -type l \\) -printf '%y\\t%m\\t%P\\t%l\\n' | sort",
        "sh", "{root}",
      ]
    }
    exit {
      0 => Unit
      nonzero => String "Find command failed"
    }
  }

  operation Files {
    input { workdir: FilePath, root: FilePath, name_glob: String }
    output {
      success: Bool from "exit_success"
      stdout: String from "stdout"
      stderr: String from "stderr"
    }
    readonly
    transport shell { argv: ["env", "-C", "{workdir}", "find", "{root}", "-name", "{name_glob}"] }
    exit {
      0 => Unit
      nonzero => String "Find command failed"
    }
  }
}

service shell.Env {
  operation Get {
    input { name: NonEmptyStr }
    output { value: String? from "stdout" }
    readonly
    transport shell { argv: ["printenv", "{name}"] }
    exit {
      0 => Unit
      1 => Unit "Variable not set"
    }

  }
}

data shell_which_vs_posix_command_v_selection_note: String = "Two operations answer 'is tool X present on this target': this one and shell.PosixCommandV.Check. Reach for shell.Which.Check ONLY when the target's package set is an established in-tree fact -- an image we provision and hold operational evidence for, such as gunbc.host_cli_dependency's codex_wet_materialization_host_cli_requirements, which records an apt-install incident for the falsifier cadence runner (apt implies the Debian/Ubuntu family, and debianutils -- which ships `which` -- installs by default there). Reach for shell.PosixCommandV.Check for every other target, and always for one whose OperatingSystemSurface carries `distro_or_product: none` with no other package-set evidence beside it -- srv1-4 today (gunbc.fleet_intent), and any host reached the same way (crisp-wren-896 finding, PR #8590). The split tracks a real distinction, established-package-set vs unestablished, not whichever operation an author happened to see first; see posix_command_v_semantic_note for why command -v's own residual assumption is narrower but still not a proof."

service shell.Which {
  operation Check {
    input { command: NonEmptyStr }
    output { exists: Bool from "exit_success", path: FilePath? from "stdout" }
    readonly
    transport shell { argv: ["which", "{command}"] }
    exit {
      0 => Unit "Command found"
      1 => Unit "Command not found"
    }
  }
}

fn shell_which_check_argv(command: NonEmptyStr) -> List<String> {
  ["which", command as String]
}

data posix_command_v_semantic_note: String = "`command -v` is a POSIX shell builtin (IEEE 1003.1-2017 section 2.9.1.1, Command Search and Execution, invoked here through `sh -c` rather than by name), present wherever a POSIX-conforming shell is -- unlike shell.Which.Check's `which`, an EXTERNAL BINARY (part of debianutils on Debian/Ubuntu, not part of POSIX or a base busybox install) that may be absent on stripped appliance images, BMC firmware shells (Dropbear), or minimal containers. This operation's own assumption is not unconditional either: it still requires a POSIX shell at `sh` on the target's PATH. gunbc.fleet_intent's srv1-4 ComputeHost carries `fleet_intent_os_surface: OperatingSystemSurface \{ distro_or_product: none, ... \}` -- no distro or package-set authority for those hosts (crisp-wren-896 finding, PR #8590) -- so neither `which`'s presence NOR a POSIX shell's presence is an established in-tree fact for this fleet. This operation only narrows which external fact the caller is trusting, from 'a specific external binary is installed' to 'a POSIX shell is on PATH', a materially smaller and more portable assumption -- not a proof. If even that narrower assumption cannot be established for a target, the honest realization is a typed refusal, not a silent fall-through inheriting this operation's result as ground truth. See shell_which_vs_posix_command_v_selection_note for the rule choosing between this operation and shell.Which.Check."

data posix_command_v_argv_construction_note: String = "The probed command name is carried in its OWN argv slot (`\{command\}` bound to the shell's trailing positional parameter), never concatenated into the `-c` script text -- the same `-c script scriptname arg1` positional-parameter binding shell.Find.FilesAndSymlinksWithMode already uses. The value never touches the string parsed as shell code, so there is no escaping table to maintain and no quoting authority this operation depends on."

service shell.PosixCommandV {
  operation Check {
    input { command: NonEmptyStr }
    output { exists: Bool from "exit_success", path: FilePath? from "stdout" }
    readonly
    transport shell { argv: ["sh", "-c", "command -v \"$1\"", "sh", "{command}"] }
    exit {
      0 => Unit "Command found"
      1 => Unit "Command not found"
    }
  }
}

fn posix_command_v_check_argv(command: NonEmptyStr) -> List<String> {
  ["sh", "-c", "command -v \"$1\"", "sh", command as String]
}

service shell.Test {
  operation IsExecutable {
    input { path: FilePath }
    output { executable: Bool from "exit_success" }
    readonly
    transport shell { argv: ["test", "-x", "{path}"] }
    exit {
      0 => Unit "Path is executable"
      1 => Unit "Path is not executable"
    }
  }

  operation IsNonEmpty {
    input { path: FilePath }
    output { nonempty: Bool from "exit_success" }
    readonly
    transport shell { argv: ["test", "-s", "{path}"] }
    exit {
      0 => Unit "Path exists with size greater than zero"
      1 => Unit "Path is missing or zero-byte"
    }
  }

  operation IsFile {
    input { path: FilePath }
    output { is_file: Bool from "exit_success" }
    readonly
    transport shell { argv: ["test", "-f", "{path}"] }
    exit {
      0 => Unit "Path is a regular file"
      1 => Unit "Path is missing or not a regular file"
    }
  }

  operation IsDirectory {
    input { path: FilePath }
    output { is_directory: Bool from "exit_success" }
    readonly
    transport shell { argv: ["test", "-d", "{path}"] }
    exit {
      0 => Unit "Path is a directory"
      1 => Unit "Path is missing or not a directory"
    }
  }

  operation IsWritable {
    input { path: FilePath }
    output { writable: Bool from "exit_success" }
    readonly
    transport shell { argv: ["test", "-w", "{path}"] }
    exit {
      0 => Unit "Path is writable by the effective principal"
      1 => Unit "Path is missing or not writable by the effective principal"
    }
  }
}

fn shell_test_is_executable_argv(path: FilePath) -> List<String> {
  ["test", "-x", path as String]
}

service shell.Uname {
  operation KernelName {
    input {}
    output { name: String from "stdout", success: Bool from "exit_success" }
    transport shell { argv: ["uname", "-s"] }
    exit {
      0 => Unit
      nonzero => String "uname -s failed"
    }
  }

  operation Machine {
    input {}
    output { machine: String from "stdout", success: Bool from "exit_success" }
    transport shell { argv: ["uname", "-m"] }
    exit {
      0 => Unit
      nonzero => String "uname -m failed"
    }
  }
}

service shell.Mktemp {
  operation FileInDirectory {
    input { dir: FilePath }
    output { path: FilePath from "stdout", success: Bool from "exit_success" }
    transport shell { argv: ["mktemp", "-p", "{dir}"] }
    exit {
      0 => Unit
      nonzero => String "mktemp -p failed"
    }
  }

  operation Dir {
    input {}
    output { path: FilePath from "stdout", success: Bool from "exit_success" }
    transport shell { argv: ["mktemp", "-d"] }
    exit {
      0 => Unit
      nonzero => String "mktemp -d failed"
    }
  }

  operation DirWithTemplate {
    input { template: FilePath }
    output { path: FilePath from "stdout", success: Bool from "exit_success" }
    transport shell { argv: ["mktemp", "-d", "{template}"] }
    exit {
      0 => Unit
      nonzero => String "mktemp -d with template failed"
    }
  }
}

service shell.Mkdir {
  operation Parents {
    input { path: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["mkdir", "-p", "{path}"] }
    exit {
      0 => Unit
      nonzero => String "mkdir -p failed"
    }
  }
}

service shell.Link {
  operation Hard {
    input { source: FilePath, destination: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["ln", "{source}", "{destination}"] }
    exit {
      0 => Unit "Hardlink created; fails if destination exists, which is the exclusivity this relies on"
      nonzero => String "ln failed"
    }
  }
}

service shell.Symlink {
  operation AtomicReplace {
    input { target: FilePath, link: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["ln", "-sfnT", "{target}", "{link}"] }
    exit {
      0 => Unit "Symlink published; -T treats link as a normal file (no nest into existing dir); -f replaces existing link"
      nonzero => String "ln -sfnT failed"
    }
  }
}

service shell.Remove {
  operation FileForce {
    input { path: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["rm", "-f", "{path}"] }
    exit {
      0 => Unit
      nonzero => String "rm -f failed"
    }
  }

  operation RecursiveForce {
    input { path: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["rm", "-rf", "{path}"] }
    exit {
      0 => Unit
      nonzero => String "rm -rf failed"
    }
  }
}

service shell.Move {
  operation File {
    input { source: FilePath, destination: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["mv", "{source}", "{destination}"] }
    exit {
      0 => Unit
      nonzero => String "mv failed"
    }
  }
}

service shell.Chmod {
  operation OwnerOnlyDirectory {
    input { path: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["chmod", "0700", "{path}"] }
    exit {
      0 => Unit
      nonzero => String "chmod 0700 failed"
    }
  }

  operation OwnerReadWriteFile {
    input { path: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["chmod", "0600", "{path}"] }
    exit {
      0 => Unit
      nonzero => String "chmod 0600 failed"
    }
  }

  operation RecursiveWritable {
    input { path: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["chmod", "-R", "u+w", "{path}"] }
    exit {
      0 => Unit
      nonzero => String "chmod -R u+w failed"
    }
  }

  operation RecursiveReadOnly {
    input { path: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["chmod", "-R", "a-w", "{path}"] }
    exit {
      0 => Unit
      nonzero => String "chmod -R a-w failed"
    }
  }
}

service shell.Copy {
  operation File {
    input { source: FilePath, destination: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["cp", "{source}", "{destination}"] }
    exit {
      0 => Unit
      nonzero => String "cp failed"
    }
  }

  operation Recursive {
    input { source: FilePath, destination: FilePath }
    output { success: Bool from "exit_success" }
    transport shell { argv: ["cp", "-r", "{source}", "{destination}"] }
    exit {
      0 => Unit
      nonzero => String "cp -r failed"
    }
  }
}

service shell.GCloud {
  operation AuthPrintAccessToken {
    input {}
    output {
      access_token: Secret from "stdout"
      success: Bool from "exit_success"
      stderr: String from "stderr"
    }
    readonly
    transport shell { argv: ["gcloud", "auth", "print-access-token"] }
    exit {
      0 => Unit
      nonzero => String "Failed to get access token"
    }
  }
}
