module extdeps.ci_runner.circleci



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "circleci.com/docs/reference/configuration-reference/"
  }
}

data circleci_catalog_authority: extdeps.external_authority.ExternalAuthority = extdeps_external_authority_anchor

data circleci_provider_identity: std.decl_ref.DeclarationRef = std.decl_ref.decl_ref(
  module_path: "extdeps.ci_runner.circleci",
  decl_name: "circleci_catalog_authority",
)

// Live-fetched 2026-08-18 from the configuration reference resource-class
// tables. THE x86 DOCKER CLASSES ARE TWO GB PER vCPU, not four — so a
// four-GB-per-vCPU assumption is not universal on x64 either, and this
// provider is the row that refutes it. The Arm Docker classes are four.
fn circleci_shape(
  label: std.types.NonEmptyStr,
  architecture: extdeps.toolchain.types.Architecture,
  vcpus: std.nat.Nat,
  quoted_numeral: std.nat.Nat,
) -> extdeps.ci_runner.types.RunnerShapeRow {
  extdeps.ci_runner.types.RunnerShapeRow {
    provider: circleci_provider_identity,
    label: label,
    architecture: architecture,
    entitlement: extdeps.ci_runner.types.EntitlementUnstated,
    vcpus: std.measure.hardware_thread_count(vcpus),
    memory: extdeps.ci_runner.types.QuotedWithoutBasis { numeral: quoted_numeral, unit_label: "GB" },
  }
}

data circleci_runner_catalog: extdeps.ci_runner.types.RunnerCatalogAvailability = extdeps.ci_runner.types.RunnerShapesCited {
  rows: [
    circleci_shape(label: "arm.medium", architecture: extdeps.toolchain.types.Aarch64, vcpus: 2, quoted_numeral: 8),
    circleci_shape(label: "arm.large", architecture: extdeps.toolchain.types.Aarch64, vcpus: 4, quoted_numeral: 16),
    circleci_shape(label: "arm.xlarge", architecture: extdeps.toolchain.types.Aarch64, vcpus: 8, quoted_numeral: 32),
    circleci_shape(label: "arm.2xlarge", architecture: extdeps.toolchain.types.Aarch64, vcpus: 16, quoted_numeral: 64),
    circleci_shape(label: "small", architecture: extdeps.toolchain.types.X86_64, vcpus: 1, quoted_numeral: 2),
    circleci_shape(label: "medium", architecture: extdeps.toolchain.types.X86_64, vcpus: 2, quoted_numeral: 4),
    circleci_shape(label: "medium+", architecture: extdeps.toolchain.types.X86_64, vcpus: 3, quoted_numeral: 6),
    circleci_shape(label: "large", architecture: extdeps.toolchain.types.X86_64, vcpus: 4, quoted_numeral: 8),
    circleci_shape(label: "xlarge", architecture: extdeps.toolchain.types.X86_64, vcpus: 8, quoted_numeral: 16),
    circleci_shape(label: "2xlarge", architecture: extdeps.toolchain.types.X86_64, vcpus: 16, quoted_numeral: 32),
    circleci_shape(label: "2xlarge+", architecture: extdeps.toolchain.types.X86_64, vcpus: 20, quoted_numeral: 40),
  ],
}
