module extdeps.ci_runner.github_actions

import std.types { List, NonEmptyStr }
import std.nat { Nat }
import std.measure { hardware_thread_count }
import std.decl_ref { DeclarationRef, decl_ref, WholeDeclaration }
import extdeps.toolchain.types { Aarch64, Architecture, X86_64 }
import extdeps.ci_runner.types {
  CatalogSnapshot,
  EntitlementUnstated,
  label_row_of_shape,
  RunnerLabelCatalog,
  RunnerLabelRow,
  RunnerCatalogAvailability,
  QuotedWithoutBasis,
  RunnerShapeRow,
  RunnerShapesCited,
  runner_shape_rows,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/reference/runners/larger-runners"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ci_runner.github_actions",
      decl_name: "github_actions_runner_catalog",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [github_actions_standard_runners_authority]
}

// THE SECOND PAGE THIS MODULE ANSWERS FOR. The larger-runners reference above publishes the
// sized ubuntu-latest-Ncore families; the STANDARD runners are a different reference, and the
// two together are what "a GitHub-hosted runner label" means. One module, two citations, because
// they are two pages of one product's own documentation and not two products.
data github_actions_standard_runners_authority: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/reference/runners/github-hosted-runners"
  }
}

data github_actions_catalog_authority: ExternalAuthority = extdeps_external_authority_anchor

data github_actions_provider_identity: DeclarationRef = decl_ref(
  module_path: "extdeps.ci_runner.github_actions",
  decl_name: "github_actions_catalog_authority",
)

// Live-fetched 2026-08-18 from the larger-runners machine-sizes reference.
// THE RATIO IS NOT CONSTANT WITHIN THIS PROVIDER, which is why the rows are
// modelled per SIZE rather than collapsed to one memory-per-vCPU figure: most
// sizes are four GB per vCPU, but the arm64 5-vCPU size is 14 GB (2.8) and
// the arm64 64-vCPU size is 208 GB (3.25), and on x64 the 12-vCPU size is
// 30 GB (2.5). A provider-level constant would have had to pick one of these
// and silently discard the rest.
//
// The page states no basis for "GB" and states no per-vCPU core entitlement.
fn github_actions_shape(
  label: NonEmptyStr,
  architecture: Architecture,
  vcpus: Nat,
  quoted_numeral: Nat,
) -> RunnerShapeRow {
  RunnerShapeRow {
    provider: github_actions_provider_identity,
    label: label,
    architecture: architecture,
    entitlement: EntitlementUnstated,
    vcpus: hardware_thread_count(vcpus),
    memory: QuotedWithoutBasis { numeral: quoted_numeral, unit_label: "GB" },
  }
}

data github_actions_runner_catalog: RunnerCatalogAvailability = RunnerShapesCited {
  rows: [
    github_actions_shape(label: "ubuntu-latest-arm-2core", architecture: Aarch64, vcpus: 2, quoted_numeral: 8),
    github_actions_shape(label: "ubuntu-latest-arm-4core", architecture: Aarch64, vcpus: 4, quoted_numeral: 16),
    github_actions_shape(label: "ubuntu-latest-arm-5core", architecture: Aarch64, vcpus: 5, quoted_numeral: 14),
    github_actions_shape(label: "ubuntu-latest-arm-8core", architecture: Aarch64, vcpus: 8, quoted_numeral: 32),
    github_actions_shape(label: "ubuntu-latest-arm-16core", architecture: Aarch64, vcpus: 16, quoted_numeral: 64),
    github_actions_shape(label: "ubuntu-latest-arm-32core", architecture: Aarch64, vcpus: 32, quoted_numeral: 128),
    github_actions_shape(label: "ubuntu-latest-arm-64core", architecture: Aarch64, vcpus: 64, quoted_numeral: 208),
    github_actions_shape(label: "ubuntu-latest-2core", architecture: X86_64, vcpus: 2, quoted_numeral: 8),
    github_actions_shape(label: "ubuntu-latest-4core", architecture: X86_64, vcpus: 4, quoted_numeral: 16),
    github_actions_shape(label: "ubuntu-latest-8core", architecture: X86_64, vcpus: 8, quoted_numeral: 32),
    github_actions_shape(label: "ubuntu-latest-12core", architecture: X86_64, vcpus: 12, quoted_numeral: 30),
    github_actions_shape(label: "ubuntu-latest-16core", architecture: X86_64, vcpus: 16, quoted_numeral: 64),
    github_actions_shape(label: "ubuntu-latest-32core", architecture: X86_64, vcpus: 32, quoted_numeral: 128),
    github_actions_shape(label: "ubuntu-latest-64core", architecture: X86_64, vcpus: 64, quoted_numeral: 256),
    github_actions_shape(label: "ubuntu-latest-96core", architecture: X86_64, vcpus: 96, quoted_numeral: 384),
  ],
}

// -------------------------------------------------------------------------------------
// THE STANDARD RUNNERS, AS LABEL ROWS AND DELIBERATELY NOT AS SHAPES.
//
// Live-fetched 2026-09-10 from the github-hosted-runners reference. The page publishes each
// standard label TWICE with different sizes - once for public repositories and once for private
// ones - so ubuntu-24.04-arm is 4 vCPU / 16 GB on a public repository and 2 vCPU / 8 GB on a
// private one. RunnerShapeRow has no visibility axis, so adding these as shapes would mean
// choosing one of the two published numbers and asserting it unconditionally: a fabricated fact,
// and the kind that reads as cited because it sits beside cited ones.
//
// The ARCHITECTURE column does not vary that way. The page states one architecture per label
// across both tables, which is exactly what a runs-on reader needs and all this roster claims.
//
// The two Public-preview families (ubuntu-26.04, ubuntu-26.04-arm, windows-11-vs2026-arm,
// xcode-27) are carried: preview or not, the page publishes them as workflow labels a repository
// can already write, and a scanner that meets one should resolve it rather than report a gap.
fn github_actions_standard_label(label: NonEmptyStr, architecture: Architecture) -> RunnerLabelRow {
  RunnerLabelRow {
    provider: github_actions_provider_identity,
    label: label,
    architecture: architecture,
  }
}

data github_actions_standard_runner_labels: List<RunnerLabelRow> = [
  github_actions_standard_label(label: "ubuntu-slim", architecture: X86_64),
  github_actions_standard_label(label: "ubuntu-latest", architecture: X86_64),
  github_actions_standard_label(label: "ubuntu-24.04", architecture: X86_64),
  github_actions_standard_label(label: "ubuntu-22.04", architecture: X86_64),
  github_actions_standard_label(label: "ubuntu-26.04", architecture: X86_64),
  github_actions_standard_label(label: "ubuntu-24.04-arm", architecture: Aarch64),
  github_actions_standard_label(label: "ubuntu-22.04-arm", architecture: Aarch64),
  github_actions_standard_label(label: "ubuntu-26.04-arm", architecture: Aarch64),
  github_actions_standard_label(label: "windows-latest", architecture: X86_64),
  github_actions_standard_label(label: "windows-2025", architecture: X86_64),
  github_actions_standard_label(label: "windows-2025-vs2026", architecture: X86_64),
  github_actions_standard_label(label: "windows-2022", architecture: X86_64),
  github_actions_standard_label(label: "windows-11-arm", architecture: Aarch64),
  github_actions_standard_label(label: "windows-11-vs2026-arm", architecture: Aarch64),
  github_actions_standard_label(label: "macos-15-intel", architecture: X86_64),
  github_actions_standard_label(label: "macos-26-intel", architecture: X86_64),
  github_actions_standard_label(label: "macos-latest", architecture: Aarch64),
  github_actions_standard_label(label: "macos-14", architecture: Aarch64),
  github_actions_standard_label(label: "macos-15", architecture: Aarch64),
  github_actions_standard_label(label: "macos-26", architecture: Aarch64),
  github_actions_standard_label(label: "xcode-27", architecture: Aarch64),
]

// The only provider whose label roster is not a bare projection of its shape catalog, and the
// concatenation is the whole difference: the sized larger-runner labels come from the shapes,
// the standard labels are authored because no visibility-free shape exists for them. A label
// appears in exactly one of the two.
data github_actions_catalog_snapshot: CatalogSnapshot = CatalogSnapshot {
  fetched_at: "2026-09-10T00:00:00Z",
  declared_scope: "GitHub-hosted runners across BOTH published references: the sized ubuntu-latest-Ncore larger-runner families, and every standard workflow label on the github-hosted-runners page (Linux, Windows and macOS, including the Public-preview 26.04 and vs2026 families). Self-hosted labels are NOT in scope and never will be: a self-hosted label is named by the repository that registered it, so no vendor page can enumerate it and a miss on one is not a coverage gap.",
}

data github_actions_label_catalog: RunnerLabelCatalog = RunnerLabelCatalog {
  provider: github_actions_provider_identity,
  snapshot: github_actions_catalog_snapshot,
  rows: concat(
    map(runner_shape_rows(availability: github_actions_runner_catalog), r => label_row_of_shape(row: r)),
    github_actions_standard_runner_labels,
  ),
}
