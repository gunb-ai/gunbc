module extdeps.ci_runner.github_actions



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "docs.github.com/en/actions/reference/runners/larger-runners"
  }
}

data github_actions_catalog_authority: extdeps.external_authority.ExternalAuthority = extdeps.ci_runner.github_actions.extdeps_external_authority_anchor

data github_actions_provider_identity: std.decl_ref.DeclarationRef = std.decl_ref.decl_ref(
  module_path: "extdeps.ci_runner.github_actions",
  decl_name: "github_actions_catalog_authority",
)

// Live-fetched 2026-08-18 from the larger-runners machine-sizes reference.
// THE RATIO IS NOT CONSTANT WITHIN THIS PROVIDER, which is why the rows are
// modelled per SIZE rather than collapsed to one memory-per-vCPU figure: most
// sizes are four GB per vCPU, but the arm64 5-vCPU size is 14 GB (2.8) and
// the arm64 64-vCPU size is 208 GB (3.25), and on x64 the 12-vCPU size is
// 30 GB (2.5). A provider-level constant would have had to pick one of these
// and silently discard the rest.
//
// The page states no basis for "GB" and states no per-vCPU core entitlement.
fn github_actions_shape(
  label: std.types.NonEmptyStr,
  architecture: extdeps.toolchain.types.Architecture,
  vcpus: std.nat.Nat,
  quoted_numeral: std.nat.Nat,
) -> extdeps.ci_runner.types.RunnerShapeRow {
  extdeps.ci_runner.types.RunnerShapeRow {
    provider: github_actions_provider_identity,
    label: label,
    architecture: architecture,
    entitlement: extdeps.ci_runner.types.EntitlementUnstated,
    vcpus: std.measure.hardware_thread_count(vcpus),
    memory: extdeps.ci_runner.types.QuotedWithoutBasis { numeral: quoted_numeral, unit_label: "GB" },
  }
}

data github_actions_runner_catalog: extdeps.ci_runner.types.RunnerCatalogAvailability = extdeps.ci_runner.types.RunnerShapesCited {
  rows: [
    github_actions_shape(label: "ubuntu-latest-arm-2core", architecture: extdeps.toolchain.types.Aarch64, vcpus: 2, quoted_numeral: 8),
    github_actions_shape(label: "ubuntu-latest-arm-4core", architecture: extdeps.toolchain.types.Aarch64, vcpus: 4, quoted_numeral: 16),
    github_actions_shape(label: "ubuntu-latest-arm-5core", architecture: extdeps.toolchain.types.Aarch64, vcpus: 5, quoted_numeral: 14),
    github_actions_shape(label: "ubuntu-latest-arm-8core", architecture: extdeps.toolchain.types.Aarch64, vcpus: 8, quoted_numeral: 32),
    github_actions_shape(label: "ubuntu-latest-arm-16core", architecture: extdeps.toolchain.types.Aarch64, vcpus: 16, quoted_numeral: 64),
    github_actions_shape(label: "ubuntu-latest-arm-32core", architecture: extdeps.toolchain.types.Aarch64, vcpus: 32, quoted_numeral: 128),
    github_actions_shape(label: "ubuntu-latest-arm-64core", architecture: extdeps.toolchain.types.Aarch64, vcpus: 64, quoted_numeral: 208),
    github_actions_shape(label: "ubuntu-latest-2core", architecture: extdeps.toolchain.types.X86_64, vcpus: 2, quoted_numeral: 8),
    github_actions_shape(label: "ubuntu-latest-4core", architecture: extdeps.toolchain.types.X86_64, vcpus: 4, quoted_numeral: 16),
    github_actions_shape(label: "ubuntu-latest-8core", architecture: extdeps.toolchain.types.X86_64, vcpus: 8, quoted_numeral: 32),
    github_actions_shape(label: "ubuntu-latest-12core", architecture: extdeps.toolchain.types.X86_64, vcpus: 12, quoted_numeral: 30),
    github_actions_shape(label: "ubuntu-latest-16core", architecture: extdeps.toolchain.types.X86_64, vcpus: 16, quoted_numeral: 64),
    github_actions_shape(label: "ubuntu-latest-32core", architecture: extdeps.toolchain.types.X86_64, vcpus: 32, quoted_numeral: 128),
    github_actions_shape(label: "ubuntu-latest-64core", architecture: extdeps.toolchain.types.X86_64, vcpus: 64, quoted_numeral: 256),
    github_actions_shape(label: "ubuntu-latest-96core", architecture: extdeps.toolchain.types.X86_64, vcpus: 96, quoted_numeral: 384),
  ],
}
