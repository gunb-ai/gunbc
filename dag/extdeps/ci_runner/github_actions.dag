module extdeps.ci_runner.github_actions

import std.types { List, NonEmptyStr }
import std.nat { Nat }
import std.decl_ref { DeclarationRef, decl_ref }
import extdeps.toolchain.types { Aarch64, Architecture, X86_64 }
import extdeps.pricing.object_storage { ByteBasisUnstated }
import extdeps.ci_runner.types {
  EntitlementUnstated,
  RunnerCatalogAvailability,
  RunnerShapeRow,
  RunnerShapesCited,
}

import extdeps.external_authority { ExternalAuthority }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.github.com/en/actions/reference/runners/larger-runners"
  }
}

data github_actions_catalog_authority: ExternalAuthority = extdeps_external_authority_anchor

data github_actions_provider_identity: DeclarationRef = decl_ref(
  module_path: "extdeps.ci_runner.github_actions",
  decl_name: "github_actions_catalog_authority",
)

// Live-fetched 2026-08-18 from the larger-runners machine-sizes reference.
// THE RATIO IS NOT CONSTANT WITHIN THIS PROVIDER, which is why the rows are
// modelled per SIZE rather than collapsed to one memory-per-vCPU figure: most
// sizes are four GB per vCPU, but the arm64 5-vCPU size is 14 GB (2.8) and
// the arm64 64-vCPU size is 208 GB (3.25), and on x64 the 12-vCPU size is
// 30 GB (2.5). A provider-level constant would have had to pick one of these
// and silently discard the rest.
//
// The page states no basis for "GB" and states no per-vCPU core entitlement.
fn github_actions_shape(
  label: NonEmptyStr,
  architecture: Architecture,
  vcpus: Nat,
  memory_gb: Nat,
) -> RunnerShapeRow {
  RunnerShapeRow {
    provider: github_actions_provider_identity,
    label: label,
    architecture: architecture,
    entitlement: EntitlementUnstated,
    vcpus: vcpus,
    quoted_memory_amount: memory_gb,
    quoted_memory_unit_label: "GB",
    byte_basis: ByteBasisUnstated,
  }
}

data github_actions_runner_catalog: RunnerCatalogAvailability = RunnerShapesCited {
  rows: [
    github_actions_shape(label: "ubuntu-latest-arm-2core", architecture: Aarch64, vcpus: 2, memory_gb: 8),
    github_actions_shape(label: "ubuntu-latest-arm-4core", architecture: Aarch64, vcpus: 4, memory_gb: 16),
    github_actions_shape(label: "ubuntu-latest-arm-5core", architecture: Aarch64, vcpus: 5, memory_gb: 14),
    github_actions_shape(label: "ubuntu-latest-arm-8core", architecture: Aarch64, vcpus: 8, memory_gb: 32),
    github_actions_shape(label: "ubuntu-latest-arm-16core", architecture: Aarch64, vcpus: 16, memory_gb: 64),
    github_actions_shape(label: "ubuntu-latest-arm-32core", architecture: Aarch64, vcpus: 32, memory_gb: 128),
    github_actions_shape(label: "ubuntu-latest-arm-64core", architecture: Aarch64, vcpus: 64, memory_gb: 208),
    github_actions_shape(label: "ubuntu-latest-2core", architecture: X86_64, vcpus: 2, memory_gb: 8),
    github_actions_shape(label: "ubuntu-latest-4core", architecture: X86_64, vcpus: 4, memory_gb: 16),
    github_actions_shape(label: "ubuntu-latest-8core", architecture: X86_64, vcpus: 8, memory_gb: 32),
    github_actions_shape(label: "ubuntu-latest-12core", architecture: X86_64, vcpus: 12, memory_gb: 30),
    github_actions_shape(label: "ubuntu-latest-16core", architecture: X86_64, vcpus: 16, memory_gb: 64),
    github_actions_shape(label: "ubuntu-latest-32core", architecture: X86_64, vcpus: 32, memory_gb: 128),
    github_actions_shape(label: "ubuntu-latest-64core", architecture: X86_64, vcpus: 64, memory_gb: 256),
    github_actions_shape(label: "ubuntu-latest-96core", architecture: X86_64, vcpus: 96, memory_gb: 384),
  ],
}
