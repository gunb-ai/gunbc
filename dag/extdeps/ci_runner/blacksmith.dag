module extdeps.ci_runner.blacksmith

import std.types { List, NonEmptyStr }
import std.nat { Nat }
import std.measure { MoneyPerMinute, hardware_thread_count, money_amount_micro }
import std.decl_ref { DeclarationRef, decl_ref, WholeDeclaration }
import extdeps.toolchain.types { Aarch64, Architecture, X86_64 }
import extdeps.github.actions { github_actions_runs_on_surface }
import extdeps.currency.currency { Usd }
import extdeps.ci_runner.types {
  ArmSiliconUnread,
  ArmUsdPerMinute,
  CatalogSnapshot,
  label_catalog_of_shapes,
  RunnerLabelCatalog,
  EntitlementUnstated,
  RunnerCatalogAvailability,
  QuotedWithoutBasis,
  RunnerShapeRow,
  RunnerShapesCited,
  SellerArmLinuxOffer,
  SellerOwnMetalStated,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.blacksmith.sh/blacksmith-runners/overview"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ci_runner.blacksmith",
      decl_name: "blacksmith_runner_catalog",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data blacksmith_instance_types_authority: ExternalAuthority = extdeps_external_authority_anchor

data blacksmith_provider_identity: DeclarationRef = decl_ref(
  module_path: "extdeps.ci_runner.blacksmith",
  decl_name: "blacksmith_instance_types_authority",
)

// Live-fetched 2026-08-18 from the instance-types page. Only the Linux
// families are modelled: the subject is arm64-versus-x64 server provisioning,
// and the Windows and macOS families answer a different question. The vendor
// writes memory as a bare "GB" with no basis definition anywhere on the page,
// so every row takes QuotedWithoutBasis.
//
// The vendor describes these runners as bare metal but does not state a
// per-vCPU core entitlement, so the entitlement axis is Unstated rather than
// DedicatedPhysicalCore — "bare metal" is a statement about the host, not
// about what one advertised vCPU is backed by.
fn blacksmith_shape(
  label: NonEmptyStr,
  architecture: Architecture,
  vcpus: Nat,
  quoted_numeral: Nat,
) -> RunnerShapeRow {
  RunnerShapeRow {
    provider: blacksmith_provider_identity,
    label: label,
    architecture: architecture,
    entitlement: EntitlementUnstated,
    vcpus: hardware_thread_count(vcpus),
    memory: QuotedWithoutBasis { numeral: quoted_numeral, unit_label: "GB" },
  }
}

data blacksmith_runner_catalog: RunnerCatalogAvailability = RunnerShapesCited {
  rows: [
    blacksmith_shape(label: "blacksmith-2vcpu-ubuntu-2404-arm", architecture: Aarch64, vcpus: 2, quoted_numeral: 6),
    blacksmith_shape(label: "blacksmith-4vcpu-ubuntu-2404-arm", architecture: Aarch64, vcpus: 4, quoted_numeral: 12),
    blacksmith_shape(label: "blacksmith-8vcpu-ubuntu-2404-arm", architecture: Aarch64, vcpus: 8, quoted_numeral: 24),
    blacksmith_shape(label: "blacksmith-16vcpu-ubuntu-2404-arm", architecture: Aarch64, vcpus: 16, quoted_numeral: 48),
    blacksmith_shape(label: "blacksmith-32vcpu-ubuntu-2404-arm", architecture: Aarch64, vcpus: 32, quoted_numeral: 96),
    blacksmith_shape(label: "blacksmith-2vcpu-ubuntu-2404", architecture: X86_64, vcpus: 2, quoted_numeral: 8),
    blacksmith_shape(label: "blacksmith-4vcpu-ubuntu-2404", architecture: X86_64, vcpus: 4, quoted_numeral: 16),
    blacksmith_shape(label: "blacksmith-8vcpu-ubuntu-2404", architecture: X86_64, vcpus: 8, quoted_numeral: 32),
    blacksmith_shape(label: "blacksmith-16vcpu-ubuntu-2404", architecture: X86_64, vcpus: 16, quoted_numeral: 64),
    blacksmith_shape(label: "blacksmith-32vcpu-ubuntu-2404", architecture: X86_64, vcpus: 32, quoted_numeral: 128),
  ],
}

// The label roster and its snapshot. See extdeps.ci_runner.types CatalogSnapshot for why the
// fetch time and the declared scope both have to be carried: a consumer that meets a label this
// catalog lacks must be able to tell a finding about the observed repository from a gap in ours.
data blacksmith_catalog_snapshot: CatalogSnapshot = CatalogSnapshot {
  fetched_at: "2026-08-18T00:00:00Z",
  declared_scope: "Linux Ubuntu 22.04/24.04 instance types only, both architectures, from the instance-types page cited above. Any other family that page publishes is absent from this catalog because this repository has not read it.",
}

data blacksmith_label_catalog: RunnerLabelCatalog = label_catalog_of_shapes(
  catalog: decl_ref(module_path: "extdeps.ci_runner.blacksmith", decl_name: "blacksmith_label_catalog"),
  provider: blacksmith_provider_identity,
  selection_surface: github_actions_runs_on_surface,
  snapshot: blacksmith_catalog_snapshot,
  availability: blacksmith_runner_catalog,
)

// ARM Linux list price live-fetched 2026-09-13 from www.blacksmith.sh/pricing: Ubuntu ARM
// 2 vCPU is $0.0025/min. Silicon for ARM is unread: the overview names a bare-metal
// gaming-CPU fleet and an own homogenous pool versus hyperscalers, which is a host
// statement, not a named ARM SKU.
data blacksmith_arm_linux_offer: SellerArmLinuxOffer = SellerArmLinuxOffer {
  provider: blacksmith_provider_identity,
  snapshot: blacksmith_catalog_snapshot,
  shapes: blacksmith_runner_catalog,
  silicon: ArmSiliconUnread,
  capacity: SellerOwnMetalStated,
  list_price: ArmUsdPerMinute {
    per_minute: MoneyPerMinute {
      amount: money_amount_micro(count: 2500),
      currency: Usd,
    },
  },
}
