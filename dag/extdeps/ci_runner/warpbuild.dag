module extdeps.ci_runner.warpbuild



data extdeps_external_authority_anchor: extdeps.external_authority.ExternalAuthority = extdeps.external_authority.ExternalAuthority {
  uri: extdeps.uri.Uri {
    scheme: extdeps.uri.Https
    locator: "www.warpbuild.com/docs/ci/cloud-runners"
  }
}

data warpbuild_catalog_authority: extdeps.external_authority.ExternalAuthority = extdeps.ci_runner.warpbuild.extdeps_external_authority_anchor

data warpbuild_provider_identity: std.decl_ref.DeclarationRef = std.decl_ref.decl_ref(
  module_path: "extdeps.ci_runner.warpbuild",
  decl_name: "warpbuild_catalog_authority",
)

// Live-fetched 2026-08-18 from the cloud-runners documentation. Linux
// families only. Four GB per vCPU on both architectures.
//
// The page states no basis for "GB" and states no per-vCPU core entitlement.
fn warpbuild_shape(
  label: std.types.NonEmptyStr,
  architecture: extdeps.toolchain.types.Architecture,
  vcpus: std.nat.Nat,
  quoted_numeral: std.nat.Nat,
) -> extdeps.ci_runner.types.RunnerShapeRow {
  extdeps.ci_runner.types.RunnerShapeRow {
    provider: warpbuild_provider_identity,
    label: label,
    architecture: architecture,
    entitlement: extdeps.ci_runner.types.EntitlementUnstated,
    vcpus: std.measure.hardware_thread_count(vcpus),
    memory: extdeps.ci_runner.types.QuotedWithoutBasis { numeral: quoted_numeral, unit_label: "GB" },
  }
}

data warpbuild_runner_catalog: extdeps.ci_runner.types.RunnerCatalogAvailability = extdeps.ci_runner.types.RunnerShapesCited {
  rows: [
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-2x", architecture: extdeps.toolchain.types.Aarch64, vcpus: 2, quoted_numeral: 8),
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-4x", architecture: extdeps.toolchain.types.Aarch64, vcpus: 4, quoted_numeral: 16),
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-8x", architecture: extdeps.toolchain.types.Aarch64, vcpus: 8, quoted_numeral: 32),
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-16x", architecture: extdeps.toolchain.types.Aarch64, vcpus: 16, quoted_numeral: 64),
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-32x", architecture: extdeps.toolchain.types.Aarch64, vcpus: 32, quoted_numeral: 128),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-2x", architecture: extdeps.toolchain.types.X86_64, vcpus: 2, quoted_numeral: 8),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-4x", architecture: extdeps.toolchain.types.X86_64, vcpus: 4, quoted_numeral: 16),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-8x", architecture: extdeps.toolchain.types.X86_64, vcpus: 8, quoted_numeral: 32),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-16x", architecture: extdeps.toolchain.types.X86_64, vcpus: 16, quoted_numeral: 64),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-32x", architecture: extdeps.toolchain.types.X86_64, vcpus: 32, quoted_numeral: 128),
  ],
}
