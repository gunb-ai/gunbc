module extdeps.ci_runner.warpbuild

import std.types { List, NonEmptyStr }
import std.nat { Nat }
import std.measure { hardware_thread_count }
import std.decl_ref { DeclarationRef, decl_ref, WholeDeclaration }
import extdeps.toolchain.types { Aarch64, Architecture, X86_64 }
import extdeps.github.actions { github_actions_runs_on_surface }
import extdeps.ci_runner.types {
  CatalogSnapshot,
  label_catalog_of_shapes,
  RunnerLabelCatalog,
  EntitlementUnstated,
  RunnerCatalogAvailability,
  QuotedWithoutBasis,
  RunnerShapeRow,
  RunnerShapesCited,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "www.warpbuild.com/docs/ci/cloud-runners"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ci_runner.warpbuild",
      decl_name: "warpbuild_runner_catalog",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data warpbuild_catalog_authority: ExternalAuthority = extdeps_external_authority_anchor

data warpbuild_provider_identity: DeclarationRef = decl_ref(
  module_path: "extdeps.ci_runner.warpbuild",
  decl_name: "warpbuild_catalog_authority",
)

// Live-fetched 2026-08-18 from the cloud-runners documentation. Linux
// families only. Four GB per vCPU on both architectures.
//
// The page states no basis for "GB" and states no per-vCPU core entitlement.
fn warpbuild_shape(
  label: NonEmptyStr,
  architecture: Architecture,
  vcpus: Nat,
  quoted_numeral: Nat,
) -> RunnerShapeRow {
  RunnerShapeRow {
    provider: warpbuild_provider_identity,
    label: label,
    architecture: architecture,
    entitlement: EntitlementUnstated,
    vcpus: hardware_thread_count(vcpus),
    memory: QuotedWithoutBasis { numeral: quoted_numeral, unit_label: "GB" },
  }
}

data warpbuild_runner_catalog: RunnerCatalogAvailability = RunnerShapesCited {
  rows: [
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-2x", architecture: Aarch64, vcpus: 2, quoted_numeral: 8),
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-4x", architecture: Aarch64, vcpus: 4, quoted_numeral: 16),
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-8x", architecture: Aarch64, vcpus: 8, quoted_numeral: 32),
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-16x", architecture: Aarch64, vcpus: 16, quoted_numeral: 64),
    warpbuild_shape(label: "warp-ubuntu-latest-arm64-32x", architecture: Aarch64, vcpus: 32, quoted_numeral: 128),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-2x", architecture: X86_64, vcpus: 2, quoted_numeral: 8),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-4x", architecture: X86_64, vcpus: 4, quoted_numeral: 16),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-8x", architecture: X86_64, vcpus: 8, quoted_numeral: 32),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-16x", architecture: X86_64, vcpus: 16, quoted_numeral: 64),
    warpbuild_shape(label: "warp-ubuntu-latest-x64-32x", architecture: X86_64, vcpus: 32, quoted_numeral: 128),
  ],
}

// The label roster and its snapshot. See extdeps.ci_runner.types CatalogSnapshot for why the
// fetch time and the declared scope both have to be carried: a consumer that meets a label this
// catalog lacks must be able to tell a finding about the observed repository from a gap in ours.
data warpbuild_catalog_snapshot: CatalogSnapshot = CatalogSnapshot {
  fetched_at: "2026-08-18T00:00:00Z",
  declared_scope: "Linux ubuntu-latest cloud-runner families only, both architectures, from the cloud-runners documentation cited above. Any other family that documentation publishes is absent from this catalog because this repository has not read it.",
}

data warpbuild_label_catalog: RunnerLabelCatalog = label_catalog_of_shapes(
  catalog: decl_ref(module_path: "extdeps.ci_runner.warpbuild", decl_name: "warpbuild_label_catalog"),
  provider: warpbuild_provider_identity,
  selection_surface: github_actions_runs_on_surface,
  snapshot: warpbuild_catalog_snapshot,
  availability: warpbuild_runner_catalog,
)
