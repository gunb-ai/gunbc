data google_cloud_build_runner_catalog: RunnerCatalogAvailability = RunnerShapesUnavailable {
  cause: "cloud.google.com/build/docs/api/reference/rest/v1/projects.builds MachineType (read 2026-09-13) enumerates E2_HIGHCPU_8 and E2_HIGHCPU_32. No ARM/Axion/C4A Cloud Build hosted SKU is named on that page.",
