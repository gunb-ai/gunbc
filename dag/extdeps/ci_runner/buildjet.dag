module extdeps.ci_runner.buildjet

import std.decl_ref { DeclarationRef, decl_ref, WholeDeclaration }
import extdeps.ci_runner.types {
  ArmSellerNotOffering,
  ArmSiliconUnread,
  CapacityChannelUnread,
  CatalogSnapshot,
  RunnerCatalogAvailability,
  RunnerShapesUnavailable,
  SellerArmLinuxOffer,
}

import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "buildjet.com/for-github-actions/blog/we-are-shutting-down",
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.ci_runner.buildjet",
      decl_name: "buildjet_runner_catalog",
      field: WholeDeclaration,
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

data buildjet_catalog_authority: ExternalAuthority = extdeps_external_authority_anchor

data buildjet_provider_identity: DeclarationRef = decl_ref(
  module_path: "extdeps.ci_runner.buildjet",
  decl_name: "buildjet_catalog_authority",
)

// Live-fetched 2026-09-13: BuildJet announced shutdown; runners stop 2026-03-31.
// No ARM size table is modelled because the seller no longer offers the product.
data buildjet_runner_catalog: RunnerCatalogAvailability = RunnerShapesUnavailable {
  cause: "BuildJet for GitHub Actions shut down; as of 2026-03-31 runners are no longer available (buildjet.com/for-github-actions/blog/we-are-shutting-down, read 2026-09-13).",
}

data buildjet_catalog_snapshot: CatalogSnapshot = CatalogSnapshot {
  fetched_at: "2026-09-13T00:00:00Z",
  declared_scope: "Shutdown announcement only. Historical ARM labels such as buildjet-2vcpu-ubuntu-2204-arm are not modelled as a live catalog.",
}

data buildjet_arm_linux_offer: SellerArmLinuxOffer = SellerArmLinuxOffer {
  provider: buildjet_provider_identity,
  snapshot: buildjet_catalog_snapshot,
  shapes: buildjet_runner_catalog,
  silicon: ArmSiliconUnread,
  capacity: CapacityChannelUnread,
  list_price: ArmSellerNotOffering {
    cause: "Seller shut down 2026-03-31; no live ARM list price.",
  },
}
