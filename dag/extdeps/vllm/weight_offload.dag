// ── HOW THE ENGINE SPLITS A CHECKPOINT BETWEEN DEVICE AND HOST MEMORY ───────────────────────────
//
// vLLM's weight offloaders (vllm.config.offload OffloadConfig, chosen by
// vllm.model_executor.offloader.base create_offloader) move whole named PARAMETERS. They never
// move part of a tensor. The wrap is in vllm.model_executor.models.utils make_layers, so only the
// decoder-layer stack is eligible. So the unit of a split is one parameter of one layer. For a model
// built on FusedMoE, all routed experts of a layer are one tensor per projection, so a layer's whole
// expert store moves or stays together.
//
// The two backends differ in what stays on the device:
// - UVA (UVAOffloader) moves the parameter into pinned host memory and hands the kernel a device
//   view of it. Nothing of an offloaded parameter stays on the device.
// - prefetch (PrefetchOffloader) keeps the host copy too. Its post_init allocates a
//   StaticBufferPool with slot_capacity = prefetch_step, so the device holds prefetch_step copies
//   of each distinct offloaded parameter, and layers take turns using them (slot = index mod
//   prefetch_step).
//
// Both laws are read at the pinned revision. The UVA law holds only while the MoE backend does not
// re-lay-out the weights after loading. convert_to_fp8_moe_kernel_format allocates new tensors for
// the DeepGEMM, FlashInfer, Marlin and AITER arms, and those land in device memory. That condition
// is the launch's to read back. This row does not assume it.
type VllmWeightOffloadBackend
  = VllmUvaOffload
  | VllmPrefetchOffload { prefetch_step: Nat }

type VllmWeightOffloadSplitLaw {
  backend: VllmWeightOffloadBackend
  device_copies_per_offloaded_parameter: Nat
}

fn vllm_weight_offload_split_law(backend: VllmWeightOffloadBackend) -> VllmWeightOffloadSplitLaw {
  match backend {
    VllmUvaOffload => VllmWeightOffloadSplitLaw { backend: backend, device_copies_per_offloaded_parameter: 0 }
    VllmPrefetchOffload { prefetch_step: s } => VllmWeightOffloadSplitLaw { backend: backend, device_copies_per_offloaded_parameter: s }
  }
}

fn vllm_weight_offload_backend_wire(b: VllmWeightOffloadBackend) -> NonEmptyStr {
  match b {
    VllmUvaOffload => "uva" as NonEmptyStr
    VllmPrefetchOffload { prefetch_step: _ } => "prefetch" as NonEmptyStr
  }
}
