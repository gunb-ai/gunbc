module extdeps.vllm.kv_layout

import std.types { Bool, String, NonEmptyStr, List }
import v2.std.optional { Present, Absent }
import std.measure {
  TokenCount, token_count, token_count_value,
  ConcurrentRequestHundredths, concurrent_request_hundredths, concurrent_request_hundredths_count,
  AllocatorBlockCount, allocator_block_count, allocator_block_count_value,
  AttentionLayerCount, attention_layer_count_value,
  ByteSize, byte_size, byte_size_count, measure_add,
}
import std.dissolution { DissolutionCondition, unbound_dissolution }
import std.nat { Nat, nat_min }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vllm.server { VllmSourceRevision, vllm_source_revision_read }
import extdeps.vllm.kv_cache { VllmObservedKvPool }
import extdeps.vllm.log_lines {
  VllmStartupReading, GpuKvCacheSize, MaximumConcurrency, ResolvedKvCacheFormat,
}

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/vllm-project/vllm/blob/main/vllm/v1/core/kv_cache_utils.py"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.vllm.kv_layout",
      decl_name: "ResolvedKvLayout",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// ── THE LAYOUT IS THE STRUCTURE; EVERY CAPACITY NUMBER IS A PROJECTION OF IT ───────────────────
//
// WHAT THIS MODULE IS FOR. Three different quantities in this deployment have been called "the
// pool", and each is a real number the engine reports:
//
//   ALLOCATOR INVENTORY      num_gpu_blocks -- how many blocks the block pool contains. This is what
//                            the scheduler allocates from and what kv_cache_usage_perc divides by.
//   FULL-CONTEXT EQUIVALENT  the "GPU KV cache size: N tokens" line -- max_concurrency x
//                            max_model_len, i.e. how many max-length requests fit, re-expressed in
//                            tokens. It is a projection, not an inventory.
//   SCHEDULER GRANULARITY    block_size -- the MINIMUM across resolved cache groups, which is not
//                            "the number of tokens every allocator block holds".
//
// Multiplying the first by the third and calling it the second is the error extdeps.vllm.kv_cache
// already refuses at vllm_pool_reconstruction_is_authoritative. This module exists so the three
// stop being three spellings of one field and become projections of one declared structure -- which
// is the only form in which they can be checked against each other.
//
// WHY THE RATIO IS NOT A CONSTANT. Under a hybrid layout the per-request cost is not
// length / block_size: full-attention groups grow with the sequence, sliding-window groups stop
// growing at their window, and a mamba group is a fixed state per sequence. Two engines with the
// same num_gpu_blocks and the same global block_size can therefore admit very different request
// counts. That is precisely why no function here converts an inventory into tokens.
//
// WHAT IS NOT OBSERVABLE YET, stated so the refusal below is not read as a defect in the caller.
// The engine's per-group emission is modelled as types at extdeps.vllm.kv_group_metadata: at the
// pinned revision EngineCore.get_kv_cache_group_metadata (vllm/v1/engine/core.py) carries each
// group's kind, block size and sliding window, and does NOT carry layer count, page size, the
// admission cap, or its calculated blocks-per-max-request. So `groups` is empty for every
// incarnation this repository can currently observe, and every function that needs per-group
// structure refuses. The trigger is a capture that vouches for layer counts and page bytes -- a
// richer engine emission, or another cited authority beside the emission -- at which point
// extdeps.vllm.kv_group_metadata's layout mint constructs from real captured bytes and this
// module's folds stop refusing.

// A CACHE GROUP WITH A ZERO BLOCK SIZE IS NOT A DEGENERATE GROUP, IT IS NOT A GROUP. The seed's
// `where range` checker only decides an int literal, not a Measure constructed by `token_count`,
// so a refinement alias is not a wall (DESIGN section 4b(1): a type name establishes nothing). The
// cost fold therefore refuses a zero block size or a zero layer count rather than dividing by zero
// or charging nothing and calling the request free.

// THE WINDOW LIVES IN THE VARIANT THAT HAS ONE. It was a separate optional field beside the kind,
// which made two states writable that the engine cannot produce: a windowed group with no window,
// and a full-attention group carrying one. The first was the dangerous one -- the cost function met
// it and silently charged full-attention cost, so a malformed layout produced a plausible number
// instead of a refusal, and that number would then have been reproduced against the printed lines
// and possibly agreed. Moving the window into the arm deletes both states rather than checking for
// them (DESIGN section 4b: construction over validation).
//
// KPoolIndex IS THE FOURTH GROWTH SHAPE, and it exists because GLM-5.3-Flash's sparse-attention
// layers keep a compressed index that grows once per pool_every TOKENS, not once per token
// (extdeps.zhipu.glm_5_3_flash glm_5_3_flash_hybrid_shape carries index_kpool = 4). It is a
// different growth LAW from FullAttention: halving the sequence does not halve its entries in
// general, and charging it as per-token cost overstates what a request holds, which is the same
// understatement/overstatement asymmetry the windowed arm exists to refuse. Upstream's
// KVCacheSpecKind list (extdeps.vllm.kv_group_metadata) has no value mapping onto it -- the kpool
// rides inside the sparse layer's allocation rather than a spec kind of its own -- so the
// emission-side kind fold stays partial by construction; this arm is priced by the allocation plan
// and the arm-side roster fold (gunbc.spark.arm_memory_fit), never invented from an upstream kind.
type KvGroupKind
  = FullAttention
  | SlidingWindowAttention { window: TokenCount }
  | MambaState
  | KPoolIndex { pool_every: TokenCount }

fn kv_group_kind_wire(k: KvGroupKind) -> String {
  match k {
    FullAttention => "full-attention"
    SlidingWindowAttention { window: _ } => "sliding-window"
    MambaState => "mamba-state"
    KPoolIndex { pool_every: _ } => "kpool-index"
  }
}

// One resolved cache group. `block_size` is THIS GROUP's, which the global scheduler block_size is
// only the minimum of; `sliding_window` is present exactly on the windowed kind and is what caps
// that group's per-request cost.
//
// page_size_bytes IS THE BYTE-LEVEL PROJECTION OF THIS GROUP'S BLOCK, and it is present because its
// consumer now exists: gunbc.spark.arm_memory_fit cold-admission demand is bytes, not blocks -- the
// unified-memory arm must charge KV residency against the same byte pool as the weights, and a
// block count alone cannot be priced without it. It was removed when nothing read it (the recorded
// field that no operation consumes reads as coverage of an accounting that does not exist); it
// returns WITH the fold that reads it, cold_admission_bytes below, and with the same walls.
type KvGroupLayout {
  kind: KvGroupKind
  layer_count: AttentionLayerCount
  block_size: TokenCount
  page_size_bytes: ByteSize
}

// THE RESOLVED LAYOUT OF ONE ENGINE. It carries no incarnation: this is the upstream SHAPE, and
// binding a shape to the launch that exhibited it is a receipt, which is an observation this
// repository produces and therefore lives in the observing layer, not in extdeps (DESIGN section 3,
// external upstream decomposition). Putting the incarnation here would author it in two places,
// because the receipt has to name it anyway.
type ResolvedKvLayout sole_constructor {
  allocator_blocks: AllocatorBlockCount
  scheduler_block_size: TokenCount
  hash_block_size: TokenCount
  max_model_len: TokenCount
  max_num_batched_tokens: TokenCount
  groups: List<KvGroupLayout>
  established_at_revision: VllmSourceRevision
}

fn resolved_kv_layout(
  allocator_blocks: AllocatorBlockCount,
  scheduler_block_size: TokenCount,
  hash_block_size: TokenCount,
  max_model_len: TokenCount,
  max_num_batched_tokens: TokenCount,
  groups: List<KvGroupLayout>,
  established_at_revision: VllmSourceRevision,
) -> ResolvedKvLayout {
  ResolvedKvLayout {
    allocator_blocks: allocator_blocks,
    scheduler_block_size: scheduler_block_size,
    hash_block_size: hash_block_size,
    max_model_len: max_model_len,
    max_num_batched_tokens: max_num_batched_tokens,
    groups: groups,
    established_at_revision: established_at_revision,
  }
}

// ── WHAT THE ENGINE REPORTED, AS TWO NUMBERS THAT MUST AGREE WITH THE LAYOUT ───────────────────
//
// The pool carrier from extdeps.vllm.kv_cache is the KV-cache-size line, structurally bound to that
// line class. The concurrency figure is its sibling on the next line, and the two are carried
// together here because the recovery below needs both and neither is meaningful alone.
type VllmReportedCapacity sole_constructor {
  pool: VllmObservedKvPool
  max_concurrency: ConcurrentRequestHundredths
  observed_at_revision: VllmSourceRevision
}

type VllmReportedCapacityAdmission
  = ReportedCapacityAdmitted { capacity: VllmReportedCapacity }
  | ReportedCapacityRefused { cause: NonEmptyStr }

fn observed_revisions_agree(a: VllmSourceRevision, b: VllmSourceRevision) -> Bool {
  (a.repository as String) == (b.repository as String)
    && (a.full_revision as String) == (b.full_revision as String)
}

fn vllm_reported_capacity(
  pool: VllmObservedKvPool,
  max_concurrency: ConcurrentRequestHundredths,
  reading: VllmStartupReading,
) -> VllmReportedCapacityAdmission {
  match reading.line {
    MaximumConcurrency =>
      if !observed_revisions_agree(a: reading.observed_at_revision, b: pool.observed_at_revision) {
        ReportedCapacityRefused {
          cause: join([
            "the concurrency reading was taken at ", reading.observed_at_revision.repository as String, "@", reading.observed_at_revision.full_revision as String,
            " but the pool line was taken at ", pool.observed_at_revision.repository as String, "@", pool.observed_at_revision.full_revision as String,
            ", so they do not describe one engine",
          ], "") as NonEmptyStr,
        }
      } else {
        ReportedCapacityAdmitted {
          capacity: VllmReportedCapacity {
            pool: pool,
            max_concurrency: max_concurrency,
            observed_at_revision: pool.observed_at_revision,
          },
        }
      }
    GpuKvCacheSize =>
      ReportedCapacityRefused {
        cause: "the concurrency figure must be bound to the MaximumConcurrency startup line, not the GPU KV cache size line" as NonEmptyStr,
      }
    ResolvedKvCacheFormat =>
      ReportedCapacityRefused {
        cause: "the concurrency figure must be bound to the MaximumConcurrency startup line, not the resolved KV cache format line" as NonEmptyStr,
      }
    MemoryProfileSummary =>
      ReportedCapacityRefused {
        cause: "the concurrency figure must be bound to the MaximumConcurrency startup line, not the memory-profile summary line -- that line carries the residual the KV budget came OUT of, which is a different fact from the concurrency the budget then supports" as NonEmptyStr,
      }
  }
}

// ── THE ONE DERIVATION AVAILABLE FROM TODAY'S EVIDENCE ─────────────────────────────────────────
//
// The engine computes, in this order:
//
//     blocks_per_max_request = (group-aware bytes for one max-length request) / (bytes per block)
//     maximum_concurrency    = num_gpu_blocks / blocks_per_max_request
//     GPU KV cache size      = maximum_concurrency * max_model_len
//
// so the per-request block cost it used is RECOVERABLE by inverting the last two:
//
//     blocks_per_max_request = allocator_blocks * max_model_len / kv_cache_size_tokens
//
// This is the honest derivation available before per-group metadata exists, and it is the ONLY one
// this module offers, because it reads the engine's own group-aware arithmetic back out rather than
// re-deriving it from fields whose reductions differ.
//
// IT IS A RECOVERY, NOT AN IDENTITY. The reported figures are rounded for printing, so the
// recovered cost is exact only to that precision; the recovery therefore returns a refusal when the
// inputs cannot produce a positive integer, instead of a zero that would read as a free request.
type BlocksPerRequest
  = BlocksPerRequestRecovered { blocks: AllocatorBlockCount }
  | BlocksPerRequestUnrecoverable { cause: NonEmptyStr }

fn recovered_blocks_per_max_length_request(
  layout: ResolvedKvLayout,
  reported: VllmReportedCapacity,
) -> BlocksPerRequest {
  let pool_tokens = token_count_value(t: reported.pool.tokens)
  let context = token_count_value(t: layout.max_model_len)
  let inventory = allocator_block_count_value(c: layout.allocator_blocks)
  if pool_tokens == 0 {
    BlocksPerRequestUnrecoverable { cause: "the reported KV cache size is zero, so the engine's per-request block cost cannot be inverted out of it" as NonEmptyStr }
  } else if inventory == 0 {
    BlocksPerRequestUnrecoverable { cause: "the allocator inventory is zero, so there is no pool to divide" as NonEmptyStr }
  } else if context == 0 {
    BlocksPerRequestUnrecoverable { cause: "the context cap is zero, so the full-context request the reported figures describe does not exist" as NonEmptyStr }
  } else {
    let recovered = (inventory * context) / pool_tokens
    if recovered == 0 {
      BlocksPerRequestUnrecoverable { cause: "the inversion produced no whole block, so the reported pool and inventory do not describe the same engine" as NonEmptyStr }
    } else {
      BlocksPerRequestRecovered { blocks: allocator_block_count(count: recovered) }
    }
  }
}

// WHAT THE TWO PRINTED LINES CAN AND CANNOT CHECK, worked out rather than assumed.
//
// The tempting check is "recover the per-request cost, then replay it against the printed
// concurrency". Expand it and the inventory cancels:
//
//     recovered_cost       = A * M / P
//     replayed_concurrency = A / recovered_cost = A * P / (A * M) = P / M
//
// so the replay tests the two PRINTED LINES against each other and never touches the inventory A.
// It is therefore green for any inventory whatsoever -- including one lifted from a different
// engine -- and shipping it as an inventory check would be a permanently-green wall cited as
// coverage (DESIGN section 4b: ask whether the RED is authorable before writing the check). It was
// written that way first, and the witness that was supposed to prove it discriminating is what
// caught it.
//
// So it is named for what it actually decides. The two lines are mutually consistent when the
// implied concurrency from the pool (integer hundredths) is within one hundredth of the printed
// Nx, which the engine rounds. Exact equality of truncated integer hundredths against a rounded print
// is the wrong check. THE INVENTORY REMAINS UNCHECKED BY TODAY'S EVIDENCE, and closing that gap is
// exactly what the per-group layout is needed for.
type PrintedLinesAgreement
  = PrintedLinesAgree
  | PrintedLinesDisagree { implied: ConcurrentRequestHundredths, reported: ConcurrentRequestHundredths }
  | PrintedLinesUncheckable { cause: NonEmptyStr }

fn hundredths_within_printed_precision(predicted: ConcurrentRequestHundredths, reported: ConcurrentRequestHundredths) -> Bool {
  let p = concurrent_request_hundredths_count(c: predicted)
  let r = concurrent_request_hundredths_count(c: reported)
  let delta = if p > r { p - r } else { r - p }
  delta <= 1
}

fn printed_lines_agree(layout: ResolvedKvLayout, reported: VllmReportedCapacity) -> PrintedLinesAgreement {
  let context = token_count_value(t: layout.max_model_len)
  let pool_tokens = token_count_value(t: reported.pool.tokens)
  if context == 0 {
    PrintedLinesUncheckable { cause: "the context cap is zero, so the concurrency the pool line encodes cannot be recovered" as NonEmptyStr }
  } else {
    let implied = concurrent_request_hundredths(count: (pool_tokens * 100) / context)
    if hundredths_within_printed_precision(predicted: implied, reported: reported.max_concurrency) {
      PrintedLinesAgree
    } else {
      PrintedLinesDisagree { implied: implied, reported: reported.max_concurrency }
    }
  }
}

// ── THE COST OF ONE ADMITTED SEQUENCE, WHICH NEEDS THE GROUPS AND SO REFUSES TODAY ─────────────
//
// A lease must charge what the request will actually hold, and that is a function of the WHOLE
// layout: each group contributes ceil(min(sequence, its window) / its block size) * its layer count,
// and only a full-attention group scales with the sequence all the way up. With `groups` empty
// there is no such function to evaluate, and the honest answer is a refusal naming what is missing.
//
// WHY NOT SCALE THE RECOVERED FULL-CONTEXT COST BY length / max_model_len. Because the windowed
// groups do not scale: halving the sequence does not halve their cost, so the scaled figure
// UNDERSTATES what a shorter request holds and would over-admit. An over-approximation that charged
// every request the full-context cost would be safe in the other direction, but it is not offered
// here either -- it belongs to the policy that decides how much conservatism to buy, not to the
// module that reports what the layout says.
type AdmissionCost
  = AdmissionCostBlocks { blocks: AllocatorBlockCount }
  | AdmissionCostUnestablished { cause: NonEmptyStr }

fn cold_admission_blocks(layout: ResolvedKvLayout, sequence_budget: TokenCount) -> AdmissionCost {
  if length(layout.groups) == 0 {
    AdmissionCostUnestablished {
      cause: "the resolved cache groups are unobserved, so the per-request block cost cannot be computed from the layout; the engine's group metadata does not currently emit layer count, page size or its calculated blocks-per-max-request" as NonEmptyStr,
    }
  } else if token_count_value(t: sequence_budget) == 0 {
    AdmissionCostUnestablished { cause: "an empty sequence budget names no admission" as NonEmptyStr }
  } else if token_count_value(t: sequence_budget) > token_count_value(t: layout.max_model_len) {
    AdmissionCostUnestablished { cause: "the sequence budget exceeds the engine's context cap, so no admission of it is representable" as NonEmptyStr }
  } else {
    match fold(layout.groups, init: Present { value: 0 }, f: (acc, g) =>
      match acc {
        Absent => none
        Present { value: n } =>
          match group_blocks_for(group: g, sequence: sequence_budget) {
            Absent => none
            Present { value: c } => Present { value: n + c }
          }
      }
    ) {
      Absent =>
        AdmissionCostUnestablished {
          cause: "a cache group with a zero block size or zero layer count is not a group, so the per-request block cost cannot be computed" as NonEmptyStr,
        }
      Present { value: n } =>
        AdmissionCostBlocks { blocks: allocator_block_count(count: n) }
    }
  }
}

// ── THE BYTE-LEVEL COST OF ONE ADMITTED SEQUENCE, FOR THE UNIFIED-MEMORY ADMISSION ─────────────
//
// cold_admission_blocks answers the SCHEDULER's question -- how many allocator blocks one cold
// sequence holds. The arm's memory fit answers a different one -- how many BYTES of the unified
// pool that sequence keeps resident -- and the two are projections of one structure: each group
// contributes its block cost times ITS OWN page size. A hybrid layout's groups do not in general
// share a page size, so the byte cost is summed per group rather than derived from the global
// block_size, exactly the ratio error the module header warns about.
//
// THE WALLS ARE THE BLOCK FOLD'S OWN, because a byte cost built on a broken block cost would be a
// plausible number standing on a refused one: groups unobserved, an empty budget, a budget past
// the context cap, and a group with a zero block size or zero layer count all refuse here exactly
// as they refuse there. required_kv_bytes is workload x layout; no function here reads a previous
// run's current_kv -- that figure is a readback, and the admission derives its demand from the
// layout and the seat budgets alone.
type AdmissionByteCost
  = AdmissionByteCostBytes { bytes: ByteSize }
  | AdmissionByteCostUnestablished { cause: NonEmptyStr }

fn cold_admission_bytes(layout: ResolvedKvLayout, sequence_budget: TokenCount) -> AdmissionByteCost {
  if length(layout.groups) == 0 {
    AdmissionByteCostUnestablished {
      cause: "the resolved cache groups are unobserved, so the per-request byte cost cannot be computed from the layout; the engine's group metadata does not currently emit layer count, page size or its calculated blocks-per-max-request" as NonEmptyStr,
    }
  } else if token_count_value(t: sequence_budget) == 0 {
    AdmissionByteCostUnestablished { cause: "an empty sequence budget names no admission" as NonEmptyStr }
  } else if token_count_value(t: sequence_budget) > token_count_value(t: layout.max_model_len) {
    AdmissionByteCostUnestablished { cause: "the sequence budget exceeds the engine's context cap, so no admission of it is representable" as NonEmptyStr }
  } else {
    match fold(layout.groups, init: Present { value: byte_size(count: 0) }, f: (acc, g) =>
      match acc {
        Absent => none
        Present { value: n } =>
          match group_bytes_for(group: g, sequence: sequence_budget) {
            Absent => none
            Present { value: c } => Present { value: measure_add(a: n, b: c) }
          }
      }
    ) {
      Absent =>
        AdmissionByteCostUnestablished {
          cause: "a cache group with a zero block size or zero layer count is not a group, so the per-request byte cost cannot be computed" as NonEmptyStr,
        }
      Present { value: n } =>
        AdmissionByteCostBytes { bytes: n }
    }
  }
}

// PER-GROUP BYTE COST, the block fold times the group's own page size. The windowed kind caps at
// its window and the mamba group is one state per sequence, for the same reason the block fold
// says above: halving the sequence does not halve a capped or fixed cost, and a byte-level scaling
// of the full-context figure would understate what a shorter request holds.
fn group_bytes_for(group: KvGroupLayout, sequence: TokenCount) -> ByteSize? {
  match group_blocks_for(group: group, sequence: sequence) {
    Absent => none
    Present { value: blocks } =>
      Present { value: byte_size(count: blocks * byte_size_count(b: group.page_size_bytes)) }
  }
}

// PER-GROUP COST. The windowed kind is capped at its window, which is the whole reason a hybrid
// layout admits more than the full-attention arithmetic predicts; a mamba group is one state per
// sequence regardless of length; a kpool group admits one index entry per pool_every tokens and its
// blocks are counted in ENTRIES (its block_size is entries per block, not tokens per block) -- the
// two ceil steps are written separately because collapsing them into one division would be the
// token-per-block ratio error this module's header warns about, in miniature. Zero block size, zero
// layer count and zero pool interval refuse rather than dividing or reporting a free request; the
// seed does not make those states unwritable.
fn group_blocks_for(group: KvGroupLayout, sequence: TokenCount) -> Nat? {
  let layers = attention_layer_count_value(c: group.layer_count)
  if token_count_value(t: group.block_size) == 0 || layers == 0 {
    none
  } else {
    match group.kind {
      MambaState => Present { value: layers }
      FullAttention =>
        match ceil_div(numerator: token_count_value(t: sequence), denominator: group.block_size) {
          Absent => none
          Present { value: q } => Present { value: q * layers }
        }
      SlidingWindowAttention { window: w } =>
        match ceil_div(numerator: nat_min(a: token_count_value(t: sequence), b: token_count_value(t: w)), denominator: group.block_size) {
          Absent => none
          Present { value: q } => Present { value: q * layers }
        }
      KPoolIndex { pool_every: p } =>
        match ceil_div(numerator: token_count_value(t: sequence), denominator: p) {
          Absent => none
          Present { value: entries } =>
            match ceil_div(numerator: entries, denominator: group.block_size) {
              Absent => none
              Present { value: blocks } => Present { value: blocks * layers }
            }
        }
    }
  }
}

// The denominator is a token count that may be zero: the KvBlockSize-where-range alias did not
// refuse constructed Measures. This arm is the wall that actually runs.
fn ceil_div(numerator: Nat, denominator: TokenCount) -> Nat? {
  let d = token_count_value(t: denominator)
  if d == 0 {
    none
  } else {
    Present { value: (numerator + d - 1) / d }
  }
}

// ── THE ONE NON-CIRCULAR CHECK: THE GROUPS MUST REPRODUCE THE PRINTED CONCURRENCY ─────────────
//
// printed_lines_agree cannot see the inventory, because the inventory cancels out of it. THIS check
// can, and it is the reason the group layout is worth instrumenting at all: the per-group sum knows
// nothing about the printed lines, and the printed concurrency knows nothing about the groups, so
// agreement between them is evidence and disagreement is located -- either the layout was read from
// a different launch than the lines, or the group metadata is wrong, or the engine's arithmetic is
// not what this module models.
//
// IT IS UNAVAILABLE TODAY, and says so rather than passing. With `groups` empty there is nothing to
// push forward, so the check refuses; it does not read an absent second opinion as agreement.
type LayoutReproduction
  = LayoutReproducesReported { blocks_per_max_request: AllocatorBlockCount }
  | LayoutContradictsReported { predicted: ConcurrentRequestHundredths, reported: ConcurrentRequestHundredths }
  | LayoutReproductionUnavailable { cause: NonEmptyStr }

fn revision_is_modelled(r: VllmSourceRevision) -> Bool {
  (r.repository as String) == (vllm_source_revision_read.repository as String)
    && (r.full_revision as String) == (vllm_source_revision_read.full_revision as String)
}

// THE CHECK RUNS FORWARD, NOT AS AN EQUALITY BETWEEN TWO INVERSIONS.
//
// Truncating integer division compared with == against a figure vLLM prints rounded is a knife
// edge: a layout that is exactly right can predict 1121 against a printed 1122. The published
// figure's precision is one hundredth, so the band is ±1 hundredth, not invented.
//
// BOTH SIDES CARRY A REVISION. The reported capacity carries the revision of its reading; the
// layout carries the revision its group arithmetic was established against. A foreign layout
// joined to a modelled reading is the same class as a foreign reading: a law about code nobody
// read.
fn layout_reproduces_reported(layout: ResolvedKvLayout, reported: VllmReportedCapacity) -> LayoutReproduction {
  if !revision_is_modelled(r: reported.observed_at_revision) {
    LayoutReproductionUnavailable {
      cause: join([
        "the reading was taken at ", reported.observed_at_revision.repository as String, "@", reported.observed_at_revision.full_revision as String,
        " but the capacity arithmetic modelled here was established against ", vllm_source_revision_read.repository as String, "@", vllm_source_revision_read.full_revision as String,
        "; the reproduction is not valid across revisions",
      ], "") as NonEmptyStr,
    }
  } else if !revision_is_modelled(r: layout.established_at_revision) {
    LayoutReproductionUnavailable {
      cause: join([
        "the layout's group arithmetic was established at ", layout.established_at_revision.repository as String, "@", layout.established_at_revision.full_revision as String,
        " but the capacity arithmetic modelled here was established against ", vllm_source_revision_read.repository as String, "@", vllm_source_revision_read.full_revision as String,
        "; the reproduction is not valid across revisions",
      ], "") as NonEmptyStr,
    }
  } else {
    match cold_admission_blocks(layout: layout, sequence_budget: layout.max_model_len) {
      AdmissionCostUnestablished { cause: c } => LayoutReproductionUnavailable { cause: c }
      AdmissionCostBlocks { blocks: derived } => {
        let cost = allocator_block_count_value(c: derived)
        if cost == 0 {
          LayoutReproductionUnavailable { cause: "the groups sum to no blocks for a full-context request, so no concurrency can be predicted from them" as NonEmptyStr }
        } else {
          let predicted = concurrent_request_hundredths(count: (allocator_block_count_value(c: layout.allocator_blocks) * 100) / cost)
          if hundredths_within_printed_precision(predicted: predicted, reported: reported.max_concurrency) {
            LayoutReproducesReported { blocks_per_max_request: derived }
          } else {
            LayoutContradictsReported { predicted: predicted, reported: reported.max_concurrency }
          }
        }
      }
    }
  }
}

// ── THE USAGE GAUGE IS OVER THE INVENTORY, AND IT IS NOT OCCUPANCY ─────────────────────────────
//
// kv_cache_usage_perc is 1 - free_blocks / allocator_blocks, and a block holding a RETAINED
// PREFIX-CACHE entry is not free. So the gauge rises with cache retention on an engine serving
// nothing: gunbc.spark.pair_serving_observed recorded 96.5% at zero requests running, and the group
// B head read 53% with zero running on 2026-09-06. Any reading of this number as saturation, or any
// attempt to divide it into a per-request cost, is measuring the cache and calling it the load.
type AllocatorUsage sole_constructor {
  referenced_or_retained_blocks: AllocatorBlockCount
  allocator_blocks: AllocatorBlockCount
}

// A FREE COUNT LARGER THAN THE INVENTORY IS NOT A FULL POOL, IT IS TWO ENGINES. The previous shape
// clamped it with a min, so an impossible reading reported "nothing free" -- the most alarming
// possible answer, arrived at by fabrication, and indistinguishable from a genuinely saturated
// engine. That is the absorbing fallback section 5 forbids: the widen destroys the only signal that
// the inventory and the free count came from different launches.
type UsageReading
  = UsageRead { usage: AllocatorUsage }
  | FreeCountImpossible { free_blocks: AllocatorBlockCount, allocator_blocks: AllocatorBlockCount }

fn allocator_usage(layout: ResolvedKvLayout, free_blocks: AllocatorBlockCount) -> UsageReading {
  let inventory = allocator_block_count_value(c: layout.allocator_blocks)
  let free = allocator_block_count_value(c: free_blocks)
  if free > inventory {
    FreeCountImpossible { free_blocks: free_blocks, allocator_blocks: layout.allocator_blocks }
  } else {
    UsageRead {
      usage: AllocatorUsage {
        referenced_or_retained_blocks: allocator_block_count(count: inventory - free),
        allocator_blocks: layout.allocator_blocks,
      },
    }
  }
}

// There is deliberately no function from AllocatorUsage to a request count or a token count. The
// numerator mixes live references with evictable retention, and nothing here can separate them.
// A constant predicate claiming "this is not occupancy" would be a decoration whose RED is
// unauthorable; the absence of the conversion is the wall.

// ── THE RESOLVED ALLOCATION PLAN: THE EMISSION THAT CLOSES THE GROUP-METADATA GAP ────────────────
//
// THE ALLOCATION PLAN IS THE DURABLE INSTRUMENT the owner directive names: a patched or wrapped
// engine emits its own allocation plan -- introspection, not tuning -- and the plan reproduces the
// engine's printed capacity as an independent control. extdeps.vllm.kv_group_metadata documents the
// gap this closes: today's get_kv_cache_group_metadata emission carries kind, block size and window
// per group, and NOT the layer identities, page bytes, tokens per state, per-group memory usage or
// the blocks the engine calculated at the requested length. THE PLAN IS THAT RICHER EMISSION,
// modeled here BEFORE any patch exists, so the contract the patch must satisfy is written down
// while the arm's folds still refuse for want of it -- and so the capture leg knows exactly what a
// real capture must carry. THE EMISSION ITSELF IS A FOLLOW-UP: this module owns the shape, the
// mint's walls, and the reproduction control law; nothing here claims a live engine emitted one.
//
// THE PLAN IS NOT A LAYOUT WITH EXTRA FIELDS, for the reason ResolvedKvLayout is not a receipt: the
// layout is the upstream SHAPE, and binding a shape to the launch that exhibited it is an act of
// observation, which lives in the gunbc layer. The plan record below is likewise the emission's
// shape; a captured plan bound to a launch is a receipt the observing layer mints, exactly parallel
// to gunbc.spark.vllm_kv_layout_observe's receipt over ResolvedKvLayout.
//
// GROUPING/PADDING IS A FIRST-CLASS FIELD, not an inference: the hybrid allocator's decision how
// groups share blocks (and what each group's ceil-to-block padding costs) is part of the plan the
// engine must vouch for. A consumer that re-derived padding from its own arithmetic would be
// pricing a different allocator than the one that ran.
// THE PER-GROUP BYTE FIELD IS THE GROUP SPEC'S PAGE, NOT THE POOL BLOCK. The shared-pool byte
// correction (docs/plans/shared-pool-byte-correction.md, owner directive 2026-09-26) renamed this
// field group_spec_page_size_bytes because reading it as the byte cost of taking one block ID from
// the shared pool underpriced a request by ~106x: vLLM constructs ONE backing tensor at startup
// whose block size is _get_kv_cache_bytes_per_block (vllm/v1/core/kv_cache_utils.py at the pinned
// 8d09804c8), every cache group overlays that allocation, and a block ID owned by any group consumes
// one block of it. The page this group spec prices (blocks_at_requested_length x
// group_spec_page_size_bytes = the group's max_memory_usage_bytes) is the logical charge that
// reproduces the printed capacity; the PHYSICAL pool block bytes ride the plan below, and the two
// must never be read as one figure again.
type KvAllocationPlanGroup {
  identity: NonEmptyStr
  kind: KvGroupKind
  layer_identities: List<NonEmptyStr>
  block_size: TokenCount
  group_spec_page_size_bytes: ByteSize
  tokens_per_state: TokenCount
  max_memory_usage_bytes: ByteSize
  blocks_at_requested_length: AllocatorBlockCount
}

// ONE RESOLVED PLAN. `runtime` is the vLLM source revision the emission self-reports (the upstream
// SHAPE is revision-bound exactly as kv_group_metadata's is); `image_digest` is the deployment
// image's digest riding the same self-report, for the deployment axis the source revision cannot
// name — and it is OPTIONAL, because the patched engine's contract makes it one: the digest is a
// deployment-supplied self-report (VLLM_KV_ALLOCATION_PLAN_IMAGE_DIGEST), present when the launch
// sets it, null when it does not (the real 262144x6 capture carries null, and the corpus mint
// requiring it would refuse every launch that omits the knob — the model was over-specified
// against the emission's documented contract). The authoritative image identity is the receipt's
// launch reading (VllmServingLaunch.executable_digest), which binds every receipt arm; this field
// is the emission's own claim beside it, absent rather than invented when the deployment declined
// to carry it. `cache_format` is the engine's resolved cache format (the ResolvedKvCacheFormat
// startup line is where a capture reads it, e.g. fp8_ds_mla for this checkpoint);
// `requested_length` is the sequence length the engine's blocks_at_requested_length figures were
// computed at (its own max_model_len at capture); `grouping_padding` is the allocator's own
// statement of the grouping and padding decision, quoted, not paraphrased.
//
// THE PHYSICAL POOL BYTES ARE OPTIONAL-UNTIL-EMITTED, and their optionality is the vintage wall
// the byte-conservation check rides (docs/plans/shared-pool-byte-correction.md): the v1 emission
// predates them, so a plan lacking them is a BLOCKS-ONLY plan — the block wall proves against it,
// and no byte conservation is claimed or checkable. `physical_pool_bytes_per_block` is the byte
// size of one block of the engine's single shared backing tensor — vLLM's
// _get_kv_cache_bytes_per_block at the emission's revision, the divisor that turned
// available_memory into allocator_blocks; `allocated_pool_bytes` is the worker's whole-pool
// allocation, allocator_blocks x physical_pool_bytes_per_block, both the engine's own figures. A
// plan carrying exactly one of the two is a partial vintage and refuses: the pair is one fact.
// When both ride, the mint's conservation wall (allocated == blocks x bytes_per_block) is ACTIVE;
// for a v1 plan it is inactive BY CONSTRUCTION, not by leniency.
type ResolvedKvAllocationPlan {
  runtime: VllmSourceRevision
  image_digest: NonEmptyStr?
  cache_format: NonEmptyStr
  allocator_blocks: AllocatorBlockCount
  physical_pool_bytes_per_block: ByteSize?
  allocated_pool_bytes: ByteSize?
  requested_length: TokenCount
  scheduler_block_size: TokenCount
  groups: List<KvAllocationPlanGroup>
  grouping_padding: NonEmptyStr
}

// THE LAYOUT PROJECTION, the bridge the arm-side folds actually consume: drop the plan-only
// fields and the row reads as the ResolvedKvLayout the cost folds price. The projection carries
// no incarnation for the same reason the layout type does not; and it lets a landed plan feed
// cold_admission_blocks/bytes without a second growth taxonomy -- the plan's kinds ARE
// KvGroupKind's arms by construction.
// THE PLAN DOES NOT CARRY THE SCHEDULER BATCH CEILING -- it is a cache allocation plan. The only
// consumers of this projection are the cache folds, which price sequence length and never the
// batch shape, so the projection carries the requested length in the batch field as the neutral
// spelling of "the plan vouches for nothing about it"; a consumer that needs the batch ceiling
// takes it from the launch profile, not from this projection.
fn resolved_kv_layout_from_plan(plan: ResolvedKvAllocationPlan) -> ResolvedKvLayout {
  ResolvedKvLayout {
    allocator_blocks: plan.allocator_blocks,
    scheduler_block_size: plan.scheduler_block_size,
    hash_block_size: plan.scheduler_block_size,
    max_model_len: plan.requested_length,
    max_num_batched_tokens: plan.requested_length,
    groups: map(plan.groups, g => KvGroupLayout {
      kind: g.kind,
      layer_count: attention_layer_count(count: length(g.layer_identities)),
      block_size: g.block_size,
      page_size_bytes: g.group_spec_page_size_bytes,
    }),
    established_at_revision: plan.runtime,
  }
}

// ── THE CAPTURE AND ITS MINT ─────────────────────────────────────────────────────────────────────
//
// THE CAPTURE IS THE RAW EMISSION RECORD, with every field the patched engine owes carried as an
// optional, so the mint below can refuse WHILE NAMING what a given capture still lacks instead of
// guessing defaults for it. An absent field is the typed spelling of "this emission does not
// vouch for this", exactly the wall kv_group_metadata's layout mint erects for layer_count and
// page_size_bytes today; the plan mint is that wall generalized to the whole contract.
type KvAllocationPlanCapture {
  observed_at_revision: VllmSourceRevision
  image_digest: NonEmptyStr?
  cache_format: NonEmptyStr?
  allocator_blocks: AllocatorBlockCount?
  physical_pool_bytes_per_block: ByteSize?
  allocated_pool_bytes: ByteSize?
  requested_length: TokenCount?
  scheduler_block_size: TokenCount?
  groups: List<KvAllocationPlanCaptureGroup>?
  grouping_padding: NonEmptyStr?
}

// ONE CAPTURED GROUP ROW, same optionality discipline as the top-level capture: the emission
// either vouches for a field or the mint names its absence. The spec-page field is renamed
// group_spec_page_size_bytes for the reason KvAllocationPlanGroup states; the WIRE key the
// patched engine emits stays "page_size_bytes" (both emission vintages spell it so — the v2
// extension adds the two pool fields, it does not rename the group rows), and the codec maps it
// onto the renamed field so the old reading cannot recur at the type.
type KvAllocationPlanCaptureGroup {
  identity: NonEmptyStr?
  kind: KvGroupKind?
  layer_identities: List<NonEmptyStr>?
  block_size: TokenCount?
  group_spec_page_size_bytes: ByteSize?
  tokens_per_state: TokenCount?
  max_memory_usage_bytes: ByteSize?
  blocks_at_requested_length: AllocatorBlockCount?
}

type KvAllocationPlanAdmission
  = KvAllocationPlanAdmitted { plan: ResolvedKvAllocationPlan }
  | KvAllocationPlanRefused { cause: NonEmptyStr }

fn kv_allocation_plan_capture_group_missing(g: KvAllocationPlanCaptureGroup) -> List<NonEmptyStr> {
  concat(
    match g.identity {
      Absent => ["identity" as NonEmptyStr]
      Present { value: _ } => [] as List<NonEmptyStr>
    },
    concat(
      match g.kind {
        Absent => ["kind" as NonEmptyStr]
        Present { value: _ } => [] as List<NonEmptyStr>
      },
      concat(
        match g.layer_identities {
          Absent => ["layer_identities" as NonEmptyStr]
          Present { value: _ } => [] as List<NonEmptyStr>
        },
        concat(
          match g.block_size {
            Absent => ["block_size" as NonEmptyStr]
            Present { value: _ } => [] as List<NonEmptyStr>
          },
          concat(
            match g.group_spec_page_size_bytes {
              Absent => ["group_spec_page_size_bytes" as NonEmptyStr]
              Present { value: _ } => [] as List<NonEmptyStr>
            },
            concat(
              match g.tokens_per_state {
                Absent => ["tokens_per_state" as NonEmptyStr]
                Present { value: _ } => [] as List<NonEmptyStr>
              },
              concat(
                match g.max_memory_usage_bytes {
                  Absent => ["max_memory_usage_bytes" as NonEmptyStr]
                  Present { value: _ } => [] as List<NonEmptyStr>
                },
                match g.blocks_at_requested_length {
                  Absent => ["blocks_at_requested_length" as NonEmptyStr]
                  Present { value: _ } => [] as List<NonEmptyStr>
                })))))))
}

// THE PLAN MINT. Four walls, in order: the capture's revision must be the modeled one (the field
// set an emission carries is a property of the upstream revision, unread revisions are not
// trusted); every top-level field and every group row the plan PRICES must be vouched for (no
// invented layer identities, page bytes or block figures beside a real capture) — image_digest is
// deliberately NOT among them, the patched engine's contract making it an optional
// deployment-supplied self-report, and the authoritative image identity binds at the receipt's
// launch carrier instead, and the two PHYSICAL POOL fields are not among them either, being
// optional-until-emitted: a v1 capture without them mints a blocks-only plan, which is a stated
// standing, not a gap; and the zero walls -- a zero inventory, a zero requested length, a
// group with zero layers, zero block size, zero-byte spec page or zero tokens per state is not a
// group, exactly as the layout fold refuses (a zero PHYSICAL pool block size or a zero
// allocated_pool_bytes on a v2 capture is likewise not a pool); and the POOL-BYTE CONSERVATION
// WALL, active only when both physical fields ride — a v2 capture whose allocated_pool_bytes is
// not exactly allocator_blocks x physical_pool_bytes_per_block is refused, because the emission
// then does not describe the engine's own construction (and a capture carrying exactly one of
// the two refuses as a partial vintage above the zero walls). THE MINT DOES NOT CHECK THE PLAN
// AGAINST ANY PRINTED CAPACITY: that is the control below, kept separate so a plan can be observed
// (minted) before it is controlled, and a control failure reads as located evidence about one of
// the two, not as a parse error.
fn resolved_kv_allocation_plan_from_capture(capture: KvAllocationPlanCapture) -> KvAllocationPlanAdmission {
  if !revision_is_modelled(r: capture.observed_at_revision) {
    KvAllocationPlanRefused {
      cause: join([
        "the allocation plan was captured at ", capture.observed_at_revision.repository as String, "@", capture.observed_at_revision.full_revision as String,
        " but the plan shape modelled here was established against ", vllm_source_revision_read.repository as String, "@", vllm_source_revision_read.full_revision as String,
        "; the field set an emission carries is a property of that revision, and an unread revision is not trusted",
      ], "") as NonEmptyStr,
    }
  } else {
    let top_missing = kv_allocation_plan_capture_top_missing(capture: capture)
    match length(top_missing) > 0 {
      true =>
        KvAllocationPlanRefused {
          cause: join([
            "the allocation-plan capture does not vouch for every field the plan prices: missing ",
            join(map(top_missing, f => f as String), ", "),
            ". The emission owes every field or the plan refuses rather than padding the gap with invented values",
          ], "") as NonEmptyStr,
        }
      false =>
        match capture.groups {
          Absent =>
            KvAllocationPlanRefused { cause: "unreachable: the top-level missing-field refusal above already named the absent groups" as NonEmptyStr }
          Present { value: groups } =>
            let group_missing = flat_map(groups, g =>
              map(kv_allocation_plan_capture_group_missing(g: g), f =>
                join(["group: ", (match g.identity { Present { value: i } => i as String  Absent => "<unidentified>" }), " is missing ", f as String], "") as NonEmptyStr))
            match length(group_missing) > 0 {
              true =>
                KvAllocationPlanRefused {
                  cause: join([
                    "the allocation-plan capture leaves group rows unvouched: ",
                    join(map(group_missing, f => f as String), "; "),
                    ". A roster with invented identities, page bytes or block figures is a fixture wearing a receipt's name",
                  ], "") as NonEmptyStr,
                }
              false => kv_allocation_plan_pool_field_vintage_wall(capture: capture, groups: groups)
            }
        }
    }
  }
}

fn kv_allocation_plan_capture_top_missing(capture: KvAllocationPlanCapture) -> List<NonEmptyStr> {
  concat(
    match capture.cache_format {
      Absent => ["cache_format" as NonEmptyStr]
      Present { value: _ } => [] as List<NonEmptyStr>
    },
    concat(
      match capture.allocator_blocks {
        Absent => ["allocator_blocks" as NonEmptyStr]
        Present { value: _ } => [] as List<NonEmptyStr>
      },
      concat(
        match capture.requested_length {
          Absent => ["requested_length" as NonEmptyStr]
          Present { value: _ } => [] as List<NonEmptyStr>
        },
        concat(
          match capture.scheduler_block_size {
            Absent => ["scheduler_block_size" as NonEmptyStr]
            Present { value: _ } => [] as List<NonEmptyStr>
          },
          concat(
            match capture.groups {
              Absent => ["groups" as NonEmptyStr]
              Present { value: _ } => [] as List<NonEmptyStr>
            },
            match capture.grouping_padding {
              Absent => ["grouping_padding" as NonEmptyStr]
              Present { value: _ } => [] as List<NonEmptyStr>
            })))))
}

// THE ZERO WALLS RUN AFTER COMPLETENESS: a complete capture of a broken engine is still broken.
// THE POOL-FIELD VINTAGE WALL, between the completeness walls and the zero walls: the two
// physical pool fields are optional-until-emitted, but they are ONE fact — a capture carrying
// exactly one of them is a partial emission, and a half-known pool construction is worse than an
// unemitted one because it invites exactly the read the field rename above forbids. Both absent
// is the v1 vintage: the plan mints, blocks-only. Both present falls through to the zero walls
// and the conservation wall.
fn kv_allocation_plan_pool_field_vintage_wall(capture: KvAllocationPlanCapture, groups: List<KvAllocationPlanCaptureGroup>) -> KvAllocationPlanAdmission {
  match capture.physical_pool_bytes_per_block {
    Present { value: _ } =>
      match capture.allocated_pool_bytes {
        Present { value: _ } => kv_allocation_plan_zero_walls(capture: capture, groups: groups)
        Absent =>
          KvAllocationPlanRefused {
            cause: "the capture carries physical_pool_bytes_per_block but not allocated_pool_bytes: the two are one fact about the engine's shared pool construction, and a half-emitted pair refuses rather than letting one pool byte figure be read beside a guessed other" as NonEmptyStr,
          }
      }
    Absent =>
      match capture.allocated_pool_bytes {
        Present { value: _ } =>
          KvAllocationPlanRefused {
            cause: "the capture carries allocated_pool_bytes but not physical_pool_bytes_per_block: the two are one fact about the engine's shared pool construction, and a half-emitted pair refuses rather than letting one pool byte figure be read beside a guessed other" as NonEmptyStr,
          }
        Absent => kv_allocation_plan_zero_walls(capture: capture, groups: groups)
      }
  }
}

fn kv_allocation_plan_zero_walls(capture: KvAllocationPlanCapture, groups: List<KvAllocationPlanCaptureGroup>) -> KvAllocationPlanAdmission {
  let zero_group = first(filter(groups, g =>
    (match g.layer_identities { Present { value: ls } => length(ls) == 0  Absent => false })
      || (match g.block_size { Present { value: b } => token_count_value(t: b) == 0  Absent => false })
      || (match g.group_spec_page_size_bytes { Present { value: p } => byte_size_count(b: p) == 0  Absent => false })
      || (match g.tokens_per_state { Present { value: t } => token_count_value(t: t) == 0  Absent => false })))
  match zero_group {
    Present { value: _ } =>
      KvAllocationPlanRefused {
        cause: "an allocation-plan group with zero layer identities, zero block size, zero-byte spec page or zero tokens per state is not a group, so the plan refuses rather than pricing a free or broken one" as NonEmptyStr,
      }
    Absent =>
      match capture.allocator_blocks {
        Present { value: blocks } =>
          match allocator_block_count_value(c: blocks) == 0 {
            true => KvAllocationPlanRefused { cause: "the capture carries a zero allocator inventory, so there is no pool to divide" as NonEmptyStr }
            false =>
              match capture.physical_pool_bytes_per_block {
                Present { value: pool_block } =>
                  match byte_size_count(b: pool_block) == 0 {
                    true => KvAllocationPlanRefused { cause: "the capture carries a zero physical_pool_bytes_per_block: a zero-byte shared pool block is not a pool, and every byte conservation control would divide by it" as NonEmptyStr }
                    false =>
                      match capture.allocated_pool_bytes {
                        Present { value: allocated } =>
                          match byte_size_count(b: allocated) == 0 {
                            true => KvAllocationPlanRefused { cause: "the capture carries a zero allocated_pool_bytes beside a nonzero inventory and block size: the engine's pool construction is broken, and the plan refuses rather than pricing a free pool" as NonEmptyStr }
                            false => kv_allocation_plan_conservation_wall(capture: capture, groups: groups, blocks: blocks)
                          }
                        Absent => KvAllocationPlanRefused { cause: "unreachable: the vintage wall above already refused the half-emitted pair" as NonEmptyStr }
                      }
                  }
                Absent => kv_allocation_plan_zero_walls_tail(capture: capture, groups: groups, blocks: blocks)
              }
          }
        Absent => KvAllocationPlanRefused { cause: "unreachable: the top-level missing-field refusal above already named the absent allocator inventory" as NonEmptyStr }
      }
  }
}

// THE REMAINING ZERO WALLS for the v1 vintage (no pool fields): the requested length must be
// nonzero, and a passed capture assembles.
fn kv_allocation_plan_zero_walls_tail(capture: KvAllocationPlanCapture, groups: List<KvAllocationPlanCaptureGroup>, blocks: AllocatorBlockCount) -> KvAllocationPlanAdmission {
  match capture.requested_length {
    Present { value: requested } =>
      match token_count_value(t: requested) == 0 {
        true => KvAllocationPlanRefused { cause: "the capture carries a zero requested length, so the blocks-per-request figures it vouches for describe no admission" as NonEmptyStr }
        false => kv_allocation_plan_assemble(capture: capture, groups: groups)
      }
    Absent => KvAllocationPlanRefused { cause: "unreachable: the top-level missing-field refusal above already named the absent requested length" as NonEmptyStr }
  }
}

// THE CONSERVATION WALL, active only for the v2 vintage: the emission's own pool figures must
// describe one construction — allocated_pool_bytes exactly equals allocator_blocks x
// physical_pool_bytes_per_block (the worker allocates one backing tensor of that product at
// startup, and cache groups overlay it). A v2 capture whose figures do not conserve is refused:
// either the emission read a different engine than its revision's _get_kv_cache_bytes_per_block
// describes, or the figures were garbled in flight. The block wall and the printed-capacity
// control below are unaffected — a non-conserving POOL BYTE figure is located evidence about the
// pool's construction, not about the block inventory.
fn kv_allocation_plan_conservation_wall(capture: KvAllocationPlanCapture, groups: List<KvAllocationPlanCaptureGroup>, blocks: AllocatorBlockCount) -> KvAllocationPlanAdmission {
  match capture.physical_pool_bytes_per_block {
    Present { value: pool_block } =>
      match capture.allocated_pool_bytes {
        Present { value: allocated } =>
          match byte_size_count(b: allocated) == allocator_block_count_value(c: blocks) * byte_size_count(b: pool_block) {
            true => kv_allocation_plan_zero_walls_tail(capture: capture, groups: groups, blocks: blocks)
            false =>
              KvAllocationPlanRefused {
                cause: join([
                  "the v2 emission's pool figures do not conserve: allocated_pool_bytes is ", to_string(byte_size_count(b: allocated)),
                  " but allocator_blocks x physical_pool_bytes_per_block is ",
                  to_string(allocator_block_count_value(c: blocks) * byte_size_count(b: pool_block)),
                  "; the worker allocates one backing tensor of exactly that product, so the capture does not describe the engine's pool construction",
                ], "") as NonEmptyStr,
              }
          }
        Absent => KvAllocationPlanRefused { cause: "unreachable: the vintage wall above already refused the half-emitted pair" as NonEmptyStr }
      }
    Absent => KvAllocationPlanRefused { cause: "unreachable: the zero walls above only reach the conservation wall with both pool fields present" as NonEmptyStr }
  }
}

// THE ASSEMBLY, reached only past every wall: unwrap the optionals (each absence is unreachable
// from here, and says so rather than defaulting), keep the emission's own figures, and carry the
// capture's revision as the plan's runtime.
fn kv_allocation_plan_assemble(capture: KvAllocationPlanCapture, groups: List<KvAllocationPlanCaptureGroup>) -> KvAllocationPlanAdmission {
  KvAllocationPlanAdmitted {
    plan: ResolvedKvAllocationPlan {
      runtime: capture.observed_at_revision,
      image_digest: capture.image_digest,
      cache_format: match capture.cache_format {
        Present { value: f } => f
        Absent => "unreachable: the missing-field refusal named the absent cache format" as NonEmptyStr
      },
      allocator_blocks: match capture.allocator_blocks {
        Present { value: b } => b
        Absent => allocator_block_count(count: 0)
      },
      physical_pool_bytes_per_block: capture.physical_pool_bytes_per_block,
      allocated_pool_bytes: capture.allocated_pool_bytes,
      requested_length: match capture.requested_length {
        Present { value: l } => l
        Absent => token_count(count: 0)
      },
      scheduler_block_size: match capture.scheduler_block_size {
        Present { value: b } => b
        Absent => token_count(count: 0)
      },
      groups: map(groups, g => KvAllocationPlanGroup {
        identity: match g.identity {
          Present { value: i } => i
          Absent => "unreachable: the missing-field refusal named the absent identity" as NonEmptyStr
        },
        kind: match g.kind {
          Present { value: k } => k
          Absent => FullAttention
        },
        layer_identities: match g.layer_identities {
          Present { value: ls } => ls
          Absent => [] as List<NonEmptyStr>
        },
        block_size: match g.block_size {
          Present { value: b } => b
          Absent => token_count(count: 0)
        },
        group_spec_page_size_bytes: match g.group_spec_page_size_bytes {
          Present { value: p } => p
          Absent => byte_size(count: 0)
        },
        tokens_per_state: match g.tokens_per_state {
          Present { value: t } => t
          Absent => token_count(count: 0)
        },
        max_memory_usage_bytes: match g.max_memory_usage_bytes {
          Present { value: m } => m
          Absent => byte_size(count: 0)
        },
        blocks_at_requested_length: match g.blocks_at_requested_length {
          Present { value: b } => b
          Absent => allocator_block_count(count: 0)
        },
      }),
      grouping_padding: match capture.grouping_padding {
        Present { value: d } => d
        Absent => "unreachable: the missing-field refusal named the absent grouping/padding decision" as NonEmptyStr
      },
    }
  }
}

// ── THE CONTROL LAW: THE PLAN MUST REPRODUCE THE ENGINE'S PRINTED CAPACITY ───────────────────────
//
// THE CONTROL RUNS FORWARD FROM THE EMISSION'S OWN FIGURES, exactly as layout_reproduces_reported
// does for the layout: sum the per-group blocks_at_requested_length the engine vouched for at its
// requested length, divide the allocator inventory by that sum, and compare the predicted
// concurrency (in hundredths) against the printed MaximumConcurrency line within the printed
// precision. THE TWO SIDES KNOW NOTHING ABOUT EACH OTHER -- the plan comes from the patched
// emission, the printed line from the engine's startup stdout -- so agreement is evidence and
// disagreement is located: either the patch read a different engine than the line describes, or
// the grouped figures do not sum to what the engine divided by, or the engine's arithmetic is not
// what this module models. A plan whose capture is still unvouched never reaches the control: the
// mint refuses first, and an absent second opinion is not agreement.
//
// THIS IS THE ONLY CHECK THE DOCTRINE ASKS OF THE PLAN. It is deliberately not a re-derivation
// from group rules: the plan's claim is that IT carries the engine's own arithmetic, and a control
// that silently recomputed the arithmetic from kind and block size would be comparing the model
// with itself -- permanently green, establishing nothing (DESIGN section 4b: ask whether the RED
// is authorable before writing the check).
type AllocationPlanReproduction
  = AllocationPlanReproducesPrinted { blocks_per_max_request: AllocatorBlockCount, predicted_concurrency_hundredths: Nat }
  | AllocationPlanContradictsPrinted { predicted_concurrency_hundredths: Nat, reported_concurrency_hundredths: Nat }
  | AllocationPlanControlUnavailable { cause: NonEmptyStr }

fn allocation_plan_reproduces_reported_capacity(plan: ResolvedKvAllocationPlan, reported: VllmReportedCapacity) -> AllocationPlanReproduction {
  if !revision_is_modelled(r: plan.runtime) {
    AllocationPlanControlUnavailable {
      cause: join([
        "the plan was captured at ", plan.runtime.repository as String, "@", plan.runtime.full_revision as String,
        " but the capacity arithmetic modelled here was established against ", vllm_source_revision_read.repository as String, "@", vllm_source_revision_read.full_revision as String,
        "; the reproduction is not valid across revisions",
      ], "") as NonEmptyStr,
    }
  } else if !observed_revisions_agree(a: plan.runtime, b: reported.observed_at_revision) {
    AllocationPlanControlUnavailable {
      cause: join([
        "the plan was captured at ", plan.runtime.repository as String, "@", plan.runtime.full_revision as String,
        " but the printed capacity lines were read at ", reported.observed_at_revision.repository as String, "@", reported.observed_at_revision.full_revision as String,
        "; a plan and a printed figure from different revisions do not describe one engine",
      ], "") as NonEmptyStr,
    }
  } else if token_count_value(t: plan.requested_length) == 0 {
    AllocationPlanControlUnavailable { cause: "the plan's requested length is zero, so the blocks-per-request figures it carries describe no admission" as NonEmptyStr }
  } else {
    let per_request = fold(plan.groups, init: Present { value: 0 }, f: (acc, g) =>
      match acc {
        Absent => none
        Present { value: n } => Present { value: n + allocator_block_count_value(c: g.blocks_at_requested_length) }
      })
    match per_request {
      Absent => AllocationPlanControlUnavailable { cause: "unreachable: the fold over present groups cannot go absent" as NonEmptyStr }
      Present { value: cost } =>
        match cost == 0 {
          true => AllocationPlanControlUnavailable { cause: "the plan's groups sum to no blocks for a full-context request, so no concurrency can be predicted from them" as NonEmptyStr }
          false => {
            let predicted = (allocator_block_count_value(c: plan.allocator_blocks) * 100) / cost
            let reported_hundredths = concurrent_request_hundredths_count(c: reported.max_concurrency)
            let delta = if predicted > reported_hundredths { predicted - reported_hundredths } else { reported_hundredths - predicted }
            match delta <= 1 {
              true => AllocationPlanReproducesPrinted { blocks_per_max_request: allocator_block_count(count: cost), predicted_concurrency_hundredths: predicted }
              false => AllocationPlanContradictsPrinted { predicted_concurrency_hundredths: predicted, reported_concurrency_hundredths: reported_hundredths }
            }
          }
        }
    }
  }
}

// A CONSUMER-SIDE RE-DERIVATION AT ANOTHER LENGTH, for folds that must price an admission shorter
// than the engine's requested length: the growth parameters are the plan group's own, so the
// evaluation is the same fold the layout prices, with tokens_per_state giving the per-sequence
// group's admission width (one recurrent state unit per sequence for the models this arm serves,
// so a state spans ceil(tokens_per_state / block_size) blocks regardless of sequence length).
// THIS IS NOT THE CONTROL: the control above reads the emission's own figures, this re-derives
// from rules, and the two agreeing is a claim about the plan, not a replacement for the printed
// line.
fn plan_group_blocks_at_length(group: KvAllocationPlanGroup, at: TokenCount) -> Nat? {
  if token_count_value(t: group.block_size) == 0 || length(group.layer_identities) == 0 {
    none
  } else {
    match group.kind {
      MambaState =>
        match ceil_div(numerator: token_count_value(t: group.tokens_per_state), denominator: group.block_size) {
          Absent => none
          Present { value: q } => Present { value: q * length(group.layer_identities) }
        }
      FullAttention =>
        match ceil_div(numerator: token_count_value(t: at), denominator: group.block_size) {
          Absent => none
          Present { value: q } => Present { value: q * length(group.layer_identities) }
        }
      SlidingWindowAttention { window: w } =>
        match ceil_div(numerator: nat_min(a: token_count_value(t: at), b: token_count_value(t: w)), denominator: group.block_size) {
          Absent => none
          Present { value: q } => Present { value: q * length(group.layer_identities) }
        }
      KPoolIndex { pool_every: p } =>
        match ceil_div(numerator: token_count_value(t: at), denominator: p) {
          Absent => none
          Present { value: entries } =>
            match ceil_div(numerator: entries, denominator: group.block_size) {
              Absent => none
              Present { value: blocks } => Present { value: blocks * length(group.layer_identities) }
            }
        }
    }
  }
}

fn plan_admission_blocks_at_length(plan: ResolvedKvAllocationPlan, at: TokenCount) -> AdmissionCost {
  if length(plan.groups) == 0 {
    AdmissionCostUnestablished { cause: "the allocation plan carries no groups, so no admission cost can be computed from it" as NonEmptyStr }
  } else {
    match fold(plan.groups, init: Present { value: 0 }, f: (acc, g) =>
      match acc {
        Absent => none
        Present { value: n } =>
          match plan_group_blocks_at_length(group: g, at: at) {
            Absent => none
            Present { value: c } => Present { value: n + c }
          }
      }) {
      Absent => AdmissionCostUnestablished { cause: "a plan group with a zero block size or zero layer identities is not a group, so the admission cost refuses" as NonEmptyStr }
      Present { value: n } => AdmissionCostBlocks { blocks: allocator_block_count(count: n) }
    }
  }
}

// ── THE SHARED-POOL BYTE CORRECTION: CARVE VS DEMAND, AND THE CONSTRUCTION VERDICT ───────────────
//
// THE TWO NAMED CONCEPTS (docs/plans/shared-pool-byte-correction.md, owner directive 2026-09-26).
// Calling both "KV bytes" is what enabled the 106x mistake, so the two quantities now have two
// names and no function reads one as the other:
//
//   KvAllocatorCarve    — the physical resident pool the engine allocated at startup: one backing
//                         tensor of allocated_pool_bytes, counted in blocks of
//                         physical_pool_bytes_per_block (vLLM's _get_kv_cache_bytes_per_block at
//                         the emission's revision). The cache groups OVERLAY this allocation; a
//                         block ID owned by any group consumes one block of it.
//   KvAdmissionDemand   — the logical blocks the promised population requires: the exact sum of
//                         the group rosters' blocks_at_requested_length, one shared-pool block
//                         each. Its byte spelling, when a carve exists to price it against, is
//                         block-equivalent: request_blocks x physical_pool_bytes_per_block — NEVER
//                         the sum of blocks x group-spec page bytes (the withdrawn 125,010,432-byte
//                         figure priced exactly that wrong sum).
//
// THE VERDICT STRUCTURE IS THE DOCTRINE'S: PoolConstructionProved (the bytes verify the pool's
// CONSTRUCTION — allocated == blocks x bytes_per_block, allocated <= every rank's admitted KV
// arena, and the arena slack under one block modulo named reservations/rounding),
// RequestBlockCostProved (the exact group roster and its blocks per request), and
// CacheAdmissionProved (request blocks <= usable inventory). BYTES NEVER MINT CAPACITY: the block
// wall is the capacity authority; the byte wall is a conservation check on the pool's
// construction.
type KvAllocatorCarve {
  physical_pool_bytes_per_block: ByteSize
  allocated_pool_bytes: ByteSize
  allocator_blocks: AllocatorBlockCount
}

// THE LOGICAL DEMAND, in shared-pool blocks. `population_blocks` is the promised population's
// exact block count (seats x the roster's blocks_at_requested_length sum); it is block-typed so
// no byte figure can ride it unlabeled.
type KvAdmissionDemand {
  population_blocks: AllocatorBlockCount
}

// THE CARVE PROJECTION OF A PLAN: present exactly when the plan carries the v2 pool fields —
// a v1 (blocks-only) plan has no carve, and every byte-level control below says so rather than
// deriving bytes from the group spec pages, which is the withdrawn move.
fn kv_allocator_carve_from_plan(plan: ResolvedKvAllocationPlan) -> KvAllocatorCarve? {
  match plan.physical_pool_bytes_per_block {
    Present { value: pool_block } =>
      match plan.allocated_pool_bytes {
        Present { value: allocated } =>
          Present { value: KvAllocatorCarve {
            physical_pool_bytes_per_block: pool_block,
            allocated_pool_bytes: allocated,
            allocator_blocks: plan.allocator_blocks,
          } }
        Absent => none
      }
    Absent => none
  }
}

// THE CONSTRUCTION VERDICT, MINT-LEVEL. The mint's conservation wall already refused a v2 capture
// whose figures do not conserve, so a constructed plan with a carve passes here by construction —
// this fold is the typed re-statement consumers branch on, and the Unestablished arm is the v1
// vintage's honest standing: blocks proven, no byte conservation claimed.
type PoolConstructionVerdict
  = PoolConstructionProved { physical_pool_block_bytes: ByteSize, allocator_blocks: AllocatorBlockCount, allocated_pool_bytes: ByteSize }
  | PoolConstructionRefused { cause: NonEmptyStr }
  | PoolConstructionUnestablished { cause: NonEmptyStr }

fn pool_construction_verdict(plan: ResolvedKvAllocationPlan) -> PoolConstructionVerdict {
  match kv_allocator_carve_from_plan(plan: plan) {
    Present { value: carve } =>
      match byte_size_count(b: carve.allocated_pool_bytes) == allocator_block_count_value(c: carve.allocator_blocks) * byte_size_count(b: carve.physical_pool_bytes_per_block) {
        true => PoolConstructionProved {
          physical_pool_block_bytes: carve.physical_pool_bytes_per_block,
          allocator_blocks: carve.allocator_blocks,
          allocated_pool_bytes: carve.allocated_pool_bytes,
        }
        false =>
          PoolConstructionRefused {
            cause: join([
              "the plan's pool figures do not conserve: allocated_pool_bytes is ", to_string(byte_size_count(b: carve.allocated_pool_bytes)),
              " but allocator_blocks x physical_pool_bytes_per_block is ",
              to_string(allocator_block_count_value(c: carve.allocator_blocks) * byte_size_count(b: carve.physical_pool_bytes_per_block)),
            ], "") as NonEmptyStr,
          }
      }
    Absent =>
      PoolConstructionUnestablished {
        cause: "the plan carries no physical_pool_bytes_per_block or allocated_pool_bytes (the v1 emission vintage): the block wall proves against it, and no byte conservation is claimed — pool construction stands blocks-only until a v2 capture emits the engine's own pool figures" as NonEmptyStr,
      }
  }
}

// THE BLOCK-EQUIVALENT BYTE SPELLING OF A DEMAND, priced against the carve's physical pool block
// — the only byte figure a capacity question may carry, and named block_equivalent_bytes
// wherever it travels so it is never read as ordinary memory demand or physical headroom.
fn request_block_equivalent_bytes(demand: KvAdmissionDemand, carve: KvAllocatorCarve) -> ByteSize {
  byte_size(count: allocator_block_count_value(c: demand.population_blocks) * byte_size_count(b: carve.physical_pool_bytes_per_block))
}

data kv_layout_receipt_consumer_frontier: DissolutionCondition = unbound_dissolution(description: "TRIGGER: gunbc.spark.vllm_kv_layout_observe admit_kv_layout consumes ResolvedKvLayout. SUFFICIENT FOR: this module is not a dangling type museum; live capacity folds go through the receipt bound to a launch. THE ALLOCATION-PLAN RUNG: ResolvedKvAllocationPlan and its capture mint close the emission gap extdeps.vllm.kv_group_metadata documents -- the patched engine's emission that vouches for layer identities, page bytes, tokens per state, per-group usage and blocks at the requested length, with allocation_plan_reproduces_reported_capacity as the independent control. THE EMISSION PATCH IS A FOLLOW-UP: until a capture of the patched engine exists, every capture through the mint lands on the missing-field or revision wall, and the arm's cache fold keeps refusing for want of the roster." as NonEmptyStr)
