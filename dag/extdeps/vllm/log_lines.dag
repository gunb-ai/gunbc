module extdeps.vllm.log_lines

import std.types { Bool, List, NonEmptyStr, String }
import std.nat { Nat }
import std.algebra { trim }
import std.measure { TokenCount, token_count, ConcurrentRequestHundredths, concurrent_request_hundredths }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vllm.server { VllmSourceRevision, vllm_source_revision_read }

// THE ENGINE'S OWN STARTUP LINES, WHICH ARE THE ONLY AUTHORITY FOR WHAT IT ACTUALLY BUILT.
//
// WHY A MODULE FOR THREE LINES OF STDOUT. Two of the numbers this deployment most needs -- the KV
// pool and the resolved cache format -- are RESIDUALS of the engine's own profiling, not functions
// of the arguments it was given. They are computed after weights load and after an activation
// profile that depends on the checkpoint, the batch shape and the device. There is no formula on
// this side of the boundary that reproduces them, so the engine's report is the primary source and
// anything else is a reconstruction.
//
// THIS WAS LEARNED BY GETTING IT WRONG TWICE. `num_gpu_blocks * block_size` looks like the pool and
// is not: under MLA with the DeepSeek fp8 layout it reported roughly a fourteenth of the logged
// figure. Both times the wrong number was arithmetic over real fields, which is what made it
// convincing -- it is not a typo, it is a different quantity wearing the same units.
data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/vllm-project/vllm"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.vllm.log_lines",
      decl_name: "VllmStartupLine",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: []
}

// The three lines this repository reads. Each is a STABLE PREFIX the engine emits once per launch;
// the module cites the prefix rather than a line number, because a line number is a position in a
// stream that reorders whenever logging changes.
type VllmStartupLine
  = GpuKvCacheSize
  | MaximumConcurrency
  | ResolvedKvCacheFormat
  | MemoryProfileSummary

fn vllm_startup_line_prefix(line: VllmStartupLine) -> NonEmptyStr {
  match line {
    GpuKvCacheSize => "GPU KV cache size:" as NonEmptyStr
    MaximumConcurrency => "Maximum concurrency for" as NonEmptyStr
    ResolvedKvCacheFormat => "Using DeepSeek's fp8_ds_mla KV cache format" as NonEmptyStr
    MemoryProfileSummary => "Free memory on device" as NonEmptyStr
  }
}

data vllm_startup_lines: List<VllmStartupLine> = [
  GpuKvCacheSize,
  MaximumConcurrency,
  ResolvedKvCacheFormat,
  MemoryProfileSummary,
]

// THE MEMORY-PROFILE LINE IS THE ONE THAT MAKES THE KV FIGURE ACCOUNTABLE, and reading only the two
// KV lines above leaves the most important question unanswerable. `GPU KV cache size` says how much
// cache exists; it does not say WHY that much, so a reader who sees 22.02 GiB on a 121.69 GiB machine
// cannot tell an ambient default from a deliberate budget from a leak. This line carries the whole
// residual: free and total at startup, the requested envelope and the fraction that produced it,
// consumed weights-plus-non-torch, peak activation, actual graph memory, and -- the part no other
// line offers -- the engine's own recommended EXPLICIT kv-cache-memory values, both to fit the
// request and to fully use the device.
//
// WITHOUT IT, A KV READING IS A NUMBER WITHOUT A DENOMINATOR. Measured on the GLM canary
// 2026-09-08 at vLLM 0.1.dev20051+g487ecf187: 114.93 free of 121.69 GiB at startup, a 0.92 request
// resolving to 111.95 GiB, 82.52 GiB consumed, 7.42 GiB peak activation, 0.10 GiB graph, 22.02 GiB
// KV -- and a recommendation of 24.75 GiB to fully utilise the device. That last figure is what
// establishes 22.02 as a CONSEQUENCE OF THE AMBIENT FRACTION rather than a hardware ceiling, which
// is precisely the inference the other two lines cannot support and readers were drawing anyway.
//
// THE PREFIX IS THE STABLE HALF. The line's tail is a sentence whose wording upstream may reword;
// `Free memory on device` is what this module cites, for the reason the header already states -- a
// prefix is an upstream surface, a line number is a position in a stream.

// ── THE OBSERVED READING ───────────────────────────────────────────────────────────────────────
//
// A READING CARRIES THE REVISION IT WAS READ AT, because a log prefix is an upstream surface and a
// reading taken against one revision is not evidence about another.
type VllmStartupReading sole_constructor {
  line: VllmStartupLine
  captured_text: NonEmptyStr
  observed_at_revision: VllmSourceRevision
}

// THE REVISION IS OBSERVED, NOT STAMPED. This constructor used to fill observed_at_revision from
// vllm_source_revision_read, the constant naming the revision the LAWS were read from -- so every
// reading asserted it had been taken at the modelled revision no matter which build produced it,
// and the field the carrier's own note calls load-bearing could not disagree with the model. Every
// downstream revision comparison was therefore permanently green: not a weak wall, a decoration.
//
// A reading is evidence about the build that emitted it, so the caller that captured the text
// supplies the revision it captured it from. Agreeing with the modelled revision is then a real
// question a consumer can ask and get "no" to.
fn vllm_startup_reading(
  line: VllmStartupLine,
  captured_text: NonEmptyStr,
  observed_at_revision: VllmSourceRevision,
) -> VllmStartupReading {
  VllmStartupReading {
    line: line,
    captured_text: captured_text,
    observed_at_revision: observed_at_revision
  }
}

// ── THE PRODUCER: READING THESE LINES OFF CAPTURED ENGINE OUTPUT ───────────────────────────────
//
// WHAT THIS CLOSES, AND WHAT IT COSTS TO NOT HAVE IT. extdeps.vllm.kv_cache names this parser by the
// name it expected it to have -- "that parser is gunbc.spark.serving_readback_parse's job and does
// not read this line yet" -- and states that until it exists the token count is AUTHORED beside a
// real line, so a genuine KV-cache-size line paired with a wrong number is admitted and undetected.
// That module was deleted; this fold is the obligation landing at the authority that owns the line
// grammar instead.
//
// THE MARKER IS A SUBSTRING AND NOT A LINE PREFIX, AND THE HEADER ABOVE WAS WRONG ABOUT THAT.
// `vllm_startup_line_prefix` is called a prefix and the header calls each marker "a STABLE PREFIX
// the engine emits" -- but a real line, captured from the Group B arm on 2026-09-16, reads
//
//   (EngineCore pid=273) INFO 09-16 20:00:46 [kv_cache_utils.py:2312] GPU KV cache size: 2,195,189 tokens, ...
//
// so the marker sits behind a process tag, a level, a timestamp and a source location, none of which
// this module models. A reader keyed on `starts_with` would match NOTHING on real output and report
// an engine that printed no startup lines -- green, empty, and wrong. The markers are matched as
// substrings, and the function keeps its name because the STRING it returns is unchanged and is
// still what upstream is cited for; what changes is how a reader is entitled to use it.
//
// AND ONE PHYSICAL LINE CARRIES TWO LINE CLASSES on this build. `GPU KV cache size: 2,195,189
// tokens, Maximum concurrency for 262,144 tokens per request: 8.37x` contains both markers, so it
// yields TWO readings whose captured_text is the same line. That is faithful: the two classes are
// two FACTS, upstream happens to print them together here, and a reader that returned the first
// match and stopped would silently lose the concurrency figure that extdeps.vllm.kv_layout
// cross-checks the pool against.
fn vllm_line_carries(line: String, class: VllmStartupLine) -> Bool {
  string_contains(s: line, pattern: vllm_startup_line_prefix(line: class) as String)
}

fn vllm_readings_in_line(
  line: String,
  observed_at_revision: VllmSourceRevision,
) -> List<VllmStartupReading> {
  let text = trim(s: line)
  if text == "" {
    []
  } else {
    fold(vllm_startup_lines, init: [], f: (acc, class) =>
      if vllm_line_carries(line: text, class: class) {
        concat(acc, [vllm_startup_reading(
          line: class,
          captured_text: text as NonEmptyStr,
          observed_at_revision: observed_at_revision,
        )])
      } else {
        acc
      })
  }
}

// THE REVISION IS THE CALLER'S TO SUPPLY AND THIS FOLD DOES NOT INVENT ONE. The carrier's own note
// states why: a constructor that filled the revision from the modelled constant made every
// downstream revision comparison permanently green. The capture and the revision are read from the
// SAME running container by the route that calls this, and if the route has no revision it has no
// reading either.
fn vllm_startup_readings(
  captured_stdout: String,
  observed_at_revision: VllmSourceRevision,
) -> List<VllmStartupReading> {
  fold(split(s: captured_stdout, delimiter: "\n"), init: [], f: (acc, line) =>
    concat(acc, vllm_readings_in_line(line: line, observed_at_revision: observed_at_revision)))
}

fn vllm_readings_of_class(
  readings: List<VllmStartupReading>,
  class: VllmStartupLine,
) -> List<VllmStartupReading> {
  filter(readings, r => vllm_startup_line_same(a: r.line, b: class))
}

fn vllm_startup_line_same(a: VllmStartupLine, b: VllmStartupLine) -> Bool {
  (vllm_startup_line_prefix(line: a) as String) == (vllm_startup_line_prefix(line: b) as String)
}

// ── THE NUMBERS, PARSED OUT OF THE LINE THEY WERE PRINTED ON ──────────────────────────────────
//
// THIS IS THE HALF THAT WAS MITIGATABLE AND IS NOW STRUCTURAL. kv_cache states the residual plainly:
// the line class was bound by construction and the TOKEN COUNT was not, so "a genuine KV-cache-size
// line paired with a wrong number is admitted, and this module does not detect it". Reading the
// number out of the captured text removes the pairing entirely -- there is no second input to
// disagree with the first.
//
// THE ENGINE PRINTS GROUPED DIGITS. `2,195,189` is one number with two separators, and a reader
// that handed that text to parse_int would get a refusal or, worse, a prefix. The separator is
// removed before parsing and nothing else about the text is altered.
data vllm_digit_group_separator: String = ","

fn vllm_ungrouped_digits(text: String) -> String {
  replace(s: text, pattern: vllm_digit_group_separator, replacement: "")
}

// `GPU KV cache size: 2,195,189 tokens, Maximum concurrency ...`
//
// The value is what sits between the marker and the ` tokens` that follows it. Both delimiters are
// required: taking everything after the marker would swallow the concurrency clause printed on the
// same line, which is the exact shape of the wrong-quantity-in-the-right-units failure this module's
// header was written about.
data vllm_kv_pool_tokens_suffix: String = " tokens"

fn vllm_text_between(text: String, opening: String, closing: String) -> String? {
  let after = split(s: text, delimiter: opening)
  match after |> skip(1) |> first {
    Absent => none
    Present { value: tail } => {
      let before = split(s: tail, delimiter: closing)
      if count(before) < 2 {
        none
      } else {
        match before.first() {
          Absent => none
          Present { value: middle } => Present { value: trim(s: middle) }
        }
      }
    }
  }
}

fn vllm_kv_pool_tokens_in(reading: VllmStartupReading) -> TokenCount? {
  match reading.line {
    GpuKvCacheSize =>
      match vllm_text_between(
        text: reading.captured_text as String,
        opening: vllm_startup_line_prefix(line: GpuKvCacheSize) as String,
        closing: vllm_kv_pool_tokens_suffix,
      ) {
        Absent => none
        Present { value: digits } =>
          match parse_int(s: vllm_ungrouped_digits(text: digits)) {
            Absent => none
            Present { value: n } => if n < 0 { none } else { Present { value: token_count(count: n) } }
          }
      }
    MaximumConcurrency => none
    ResolvedKvCacheFormat => none
    MemoryProfileSummary => none
  }
}

// `Maximum concurrency for 262,144 tokens per request: 8.37x`
//
// THE FIGURE IS PRINTED TO TWO DECIMALS AND IS CARRIED AS HUNDREDTHS, which is what
// std.measure ConcurrentRequestHundredths is and what extdeps.vllm.kv_layout compares against. A
// fraction with any other number of decimal places is REFUSED rather than padded or truncated: the
// printed precision is what makes the cross-check exact, so a three-decimal figure is a different
// print format this reader has not been shown and must not guess the scale of.
data vllm_max_concurrency_opening: String = "tokens per request: "
data vllm_max_concurrency_suffix: String = "x"

fn vllm_max_concurrency_in(reading: VllmStartupReading) -> ConcurrentRequestHundredths? {
  match reading.line {
    MaximumConcurrency =>
      match vllm_text_between(
        text: reading.captured_text as String,
        opening: vllm_max_concurrency_opening,
        closing: vllm_max_concurrency_suffix,
      ) {
        Absent => none
        Present { value: figure } => vllm_hundredths_of_decimal(text: figure)
      }
    GpuKvCacheSize => none
    ResolvedKvCacheFormat => none
    MemoryProfileSummary => none
  }
}

fn vllm_hundredths_of_decimal(text: String) -> ConcurrentRequestHundredths? {
  let parts = split(s: vllm_ungrouped_digits(text: text), delimiter: ".")
  if count(parts) != 2 {
    none
  } else {
    match parts.first() {
      Absent => none
      Present { value: whole } =>
        match parts |> skip(1) |> first {
          Absent => none
          Present { value: fraction } =>
            if string_length(s: fraction) != 2 {
              none
            } else {
              match parse_int(s: whole) {
                Absent => none
                Present { value: w } =>
                  match parse_int(s: fraction) {
                    Absent => none
                    Present { value: f } =>
                      if w < 0 || f < 0 {
                        none
                      } else {
                        Present { value: concurrent_request_hundredths(count: w * 100 + f) }
                      }
                  }
              }
            }
        }
    }
  }
}
