module extdeps.vllm.lil_serving_defects

import std.types { Bool, List, NonEmptyStr }
import std.list { first_where }
import std.dissolution { DissolutionCondition, unbound_dissolution }

// WHAT THE local-inference-lab (lil) vLLM IMAGE ACTUALLY DOES ON srv1 WHEN IT IS ASKED FOR THREE
// CONFIGURATIONS IT HAS NEVER BEEN QUALIFIED FOR — a first-party read of the running image.
//
// WHY IT SITS IN extdeps AND NOT IN gunbc. The local-inference-lab build is an upstream
// (gunbc.design_argument::single_authority): its launcher, the b12x kernels, LMCache and vLLM are not
// this repository's code, so a fact about how they fail on our hardware is an OBSERVATION of an
// external artifact, which is the extdeps meaning ("extdeps is for describing the world outside this
// repository"). This is NOT a build/certification contract (that is extdeps.vllm.local_inference_lab_build,
// which states the source the image is built from) and NOT the arch-keyed image-capability matrix
// (that is gunbc.serving.flash_next_image_capability_observation, whose rows are TranscribedUncited
// operator/peer reports of what the image CAN DO per CUDA arch). What is different here: these four
// rows are readings THIS repository took at srv1 on 2026-11-08 — the exact error strings were read from
// the container's own logs and from the launcher and replica-proxy source inside the running container,
// not relayed — so the receipt is our own observation, and `standing` names where it came from rather
// than a transcribed obligation.
//
// WHY EACH ROW CARRIES ITS EXACT ERROR STRING RATHER THAN A PARAPHRASE. The operator's item list
// arrived with cells truncated; the whole point of these rows is that a gap was filled by READING srv1,
// never by guessing. A witness (test.claim.extdeps.lil_serving_defects_witness) asserts each row still
// carries the verbatim substring that was read, so a later edit that softens or invents the wording is
// refused. The strings are quoted descriptions of an external artifact (like the capability module's
// `b12x_sm120_only` and `ple_needs_b12x` data), naming vLLM/b12x/LMCache source paths — external
// symbols, not repository symbols — which is exactly the kind of report a `data ... : NonEmptyStr` carries.
//
// WHAT IS NOT CLAIMED. These are single-occurrence reads at one host on one image build, not a claim
// that the config is broken on every host. They are also NOT filed under gunbc.recurring_failure_mode:
// that ledger's `RecurringFailureMode` carries a `rung: RungReading` over the compiler's guarantee
// ladder — it enumerates THIS compiler's own defect classes, not fleet serving failures — so a vLLM
// runtime hang has no home there and forcing one would misrepresent the ladder.

type LilServeComponent
  = B12xPcieAllReduce
  | LilLauncher
  | VllmEngine
  | LmCacheRecurrentConnector
  | LilReplicaProxy

// Where a fix is owed and where it would be reported. The report is NOT opened from this repository:
// filing it is outward-facing and is handed back to the operator/parent as a draft.
type LilServingDefect {
  identity: NonEmptyStr
  component: LilServeComponent
  affected_config: NonEmptyStr
  exact_error: NonEmptyStr
  source_line: NonEmptyStr
  on_image: NonEmptyStr
  upstream_repo: NonEmptyStr
  upstream_ask: NonEmptyStr
  receipt: NonEmptyStr
}

// THE RECEIPT, named once. Every row points at this read: the srv1 containers' own log and the source
// read inside the running container, on the 2026-11-03-19-54-02 lil image (vLLM build string
// 0.1.dev22105+g5009fa56b, present verbatim in each defect log).
data srv1_lil_defect_receipt: NonEmptyStr = "srv1 (nvjet1), 2026-11-08: read from ~/lil/serve/serve.log and from /opt/lil/runtime/*.py inside the running lil-flash-next container, image docker.iot-bots.li:5555/local-inference-lab:2026-11-03-19-54-02 (vLLM 0.1.dev22105+g5009fa56b), two RTX PRO 6000 Blackwell SM120 with no GPU P2P" as NonEmptyStr

fn srv1_lil_serving_defect_rows() -> List<LilServingDefect> {
  [
    // F24 — b12x PCIe all-reduce hangs TP=2 init on srv1, which has no GPU P2P. Both ranks logged the
    // all-reduce init failure (each retaining CUDA IPC ownership), the custom all-reduce was then
    // disabled for the missing P2P, and the surviving rank waited on a ONE-ELEMENT NCCL broadcast in
    // b12x's own failure-exchange path until the 600 s NCCL watchdog fired. The lil launcher sets the
    // off-switch only when --disable-custom-all-reduce is passed, so the rtx-pro-6000-pcie profile on a
    // P2P-less host has to be told by hand; the profile does not do it.
    LilServingDefect {
      identity: "srv1-f24-b12x-pcie-allreduce-tp2-hang" as NonEmptyStr,
      component: B12xPcieAllReduce,
      affected_config: "tensor_parallel_size=2 on two RTX PRO 6000 (SM120) over PCIe with no GPU P2P" as NonEmptyStr,
      exact_error: "B12X PCIe all-reduce initialization failed on rank 0: failed to exchange CUDA IPC import-open status; CUDA IPC ownership was retained" as NonEmptyStr,
      source_line: "b12x/integration/vllm/b12x_pcie_all_reduce.py:298; hang in b12x/comm/pcie/pcie_oneshot.py:653 (_exchange_setup_failures -> _broadcast_gather_object), Watchdog caught collective operation timeout OpType=BROADCAST NumelIn=1 NumelOut=1 Timeout(ms)=600000 ran for 600017 milliseconds" as NonEmptyStr,
      on_image: "local-inference-lab:2026-11-03-19-54-02 (vLLM 0.1.dev22105+g5009fa56b)" as NonEmptyStr,
      upstream_repo: "b12x (the image's b12x_pcie_all_reduce / comm.pcie owner); secondary: local-inference-lab launcher profile rtx-pro-6000-pcie" as NonEmptyStr,
      upstream_ask: "When the B12X PCIe all-reduce init fails (CUDA IPC import-open cannot be exchanged and ownership is retained), abort cleanly and let NCCL take the collective immediately instead of entering _exchange_setup_failures, where the rank that retained CUDA IPC ownership never posts and the peer blocks on a one-element broadcast to the watchdog. Separately, the lil rtx-pro-6000-pcie hardware profile should derive VLLM_ENABLE_PCIE_ALLREDUCE=0 when P2P is absent (the launcher sets it to 0 only when --disable-custom-all-reduce is passed) rather than relying on the operator to pass the flag." as NonEmptyStr,
      receipt: srv1_lil_defect_receipt,
    },
    // F25 — NVFP4 main KV cache is not a target for qwen38-flash-next on this image. The launcher's
    // supported-KV allow-list is the literal set {fp8, fp8_e4m3}, so nvfp4 KV is refused before the
    // engine starts; pushed past the allow-list, vLLM itself refuses because the QSA attention path
    // only builds a BF16 or FP8 E4M3 main KV cache. FP8 is the floor, not a preference.
    LilServingDefect {
      identity: "srv1-f25-nvfp4-main-kv-unsupported" as NonEmptyStr,
      component: LilLauncher,
      affected_config: "kv_cache_dtype=nvfp4 on qwen38-flash-next (profile qwen38-flash-next, hardware rtx-pro-6000-pcie)" as NonEmptyStr,
      exact_error: "NotImplementedError: QSA requires BF16 or FP8 E4M3 main KV cache" as NonEmptyStr,
      source_line: "runtime/launcher.py:2011 (supported_kv = {\"fp8\", \"fp8_e4m3\"}) and launcher.py:2019 (\"<model> supports target KV settings ['fp8', 'fp8_e4m3']; other precisions require separate qualification\"); engine refusal raised through vllm/v1/executor/multiproc_executor.py:1073" as NonEmptyStr,
      on_image: "local-inference-lab:2026-11-03-19-54-02 (vLLM 0.1.dev22105+g5009fa56b)" as NonEmptyStr,
      upstream_repo: "local-inference-lab (launcher allow-list); secondary: vLLM QSA main-KV builder" as NonEmptyStr,
      upstream_ask: "Either qualify an NVFP4 main KV cache for the QSA path (the engine currently builds only BF16 or FP8 E4M3, raising NotImplementedError) or document FP8 E4M3 as the FP floor in the launcher's supported-KV allow-list so a request for nvfp4 KV fails at the profile with the reason instead of surfacing a raw NotImplementedError from the engine core." as NonEmptyStr,
      receipt: srv1_lil_defect_receipt,
    },
    // F26a — lil's own REPLICAS=2 mode (one container, two single-GPU servers) crashes the SECOND
    // engine: LMCache's recurrent-checkpoint connector asks the transfer context for checkpoint slot
    // views over a shared-memory region that the second process never registered. The first engine
    // brings up; the replica never does.
    LilServingDefect {
      identity: "srv1-f26a-lmcache-replica-checkpoint-dma-crash" as NonEmptyStr,
      component: LmCacheRecurrentConnector,
      affected_config: "lil-serve replicas=2 (two single-GPU replica servers behind one proxy), LMCache ram-disk, recurrent checkpoint connector on" as NonEmptyStr,
      exact_error: "RuntimeError: Checkpoint DMA requires a registered SHM mapping" as NonEmptyStr,
      source_line: "lmcache/integration/vllm/recurrent_checkpoint_connector.py:253 (bind_boundary_checkpoint_state) -> lmcache/integration/vllm/checkpoint_copy.py:59 -> lmcache/v1/multiprocess/transfer_context/shm.py:227" as NonEmptyStr,
      on_image: "local-inference-lab:2026-11-03-19-54-02 (vLLM 0.1.dev22105+g5009fa56b)" as NonEmptyStr,
      upstream_repo: "LMCache (recurrent checkpoint connector / multiprocess transfer context); secondary: local-inference-lab replica bring-up ordering" as NonEmptyStr,
      upstream_ask: "In replicas>1 bring-up the second replica's engine core reaches bind_boundary_checkpoint_state before its shared-memory checkpoint region is registered, so checkpoint_slot_views raises 'Checkpoint DMA requires a registered SHM mapping' and the replica dies at engine-core init. Either register the SHM mapping per replica before binding checkpoint state, or have the connector fall back to a copy path (or disable checkpoint DMA) when no mapping is registered, instead of raising and taking the whole replica down." as NonEmptyStr,
      receipt: srv1_lil_defect_receipt,
    },
    // F26b — the proxy lil puts in front of the replicas always dials them over plain HTTP. main()
    // accepts only --host/--port/--replica (no TLS material), and build_app hard-codes the http://
    // scheme for every upstream. When the replicas are given --ssl-keyfile/--ssl-certfile (as srv1
    // requires for its serving endpoints) the proxy speaks HTTP to a TLS listener and every forwarded
    // request fails; the proxy's own failure branch renders it as a 502 naming the client-side
    // 'Server disconnected' error.
    LilServingDefect {
      identity: "srv1-f26b-replica-proxy-plain-http-to-tls-replicas" as NonEmptyStr,
      component: LilReplicaProxy,
      affected_config: "lil-serve replicas=2 behind the replica proxy, replicas launched with --ssl-keyfile/--ssl-certfile" as NonEmptyStr,
      exact_error: "replica 0 unavailable: Server disconnected without sending a response." as NonEmptyStr,
      source_line: "runtime/replica_proxy.py:297 (bases = [f\"http://<upstream>\" for upstream in upstreams]); runtime/replica_proxy.py main() accepts only --host/--port/--replica and has no TLS argument; runtime/replicas.py:122 launches the proxy with 127.0.0.1:<port> replicas and passes no TLS to it" as NonEmptyStr,
      on_image: "local-inference-lab:2026-11-03-19-54-02 (vLLM 0.1.dev22105+g5009fa56b)" as NonEmptyStr,
      upstream_repo: "local-inference-lab (runtime/replica_proxy.py + runtime/replicas.py)" as NonEmptyStr,
      upstream_ask: "The replica proxy hard-codes http:// for every upstream and its argument surface carries no TLS material, so a deployment that serves replicas over HTTPS (replicas inherit --ssl-keyfile/--ssl-certfile) breaks every request: the proxy's plaintext call to a TLS listener surfaces as the 502 'replica N unavailable: Server disconnected'. Derive the upstream scheme from whether the replicas were given TLS (thread --ssl-keyfile/--ssl-certfile, or a --replica-scheme/--replica-tls flag, from replicas.py into replica_proxy.py), or serve replicas on the loopback without TLS while keeping the public proxy TLS." as NonEmptyStr,
      receipt: srv1_lil_defect_receipt,
    },
  ]
}

fn defect_component_eq(a: LilServeComponent, b: LilServeComponent) -> Bool {
  match a {
    B12xPcieAllReduce => match b { B12xPcieAllReduce => true, _ => false }
    LilLauncher => match b { LilLauncher => true, _ => false }
    VllmEngine => match b { VllmEngine => true, _ => false }
    LmCacheRecurrentConnector => match b { LmCacheRecurrentConnector => true, _ => false }
    LilReplicaProxy => match b { LilReplicaProxy => true, _ => false }
  }
}

fn defect_by_identity(rows: List<LilServingDefect>, identity: NonEmptyStr) -> LilServingDefect? {
  first_where(xs: rows, keep: fn(r) {
    r.identity == identity
  })
}

// THE ONE FACT THAT MAKES REPAIR WORTH FILING. If REPLICAS=2 worked AND the image could share the PLE
// table, the two replicas would keep one host-RAM PLE table between them instead of one each; the
// launcher's own warning values one replica's copy at about 27 GiB, and the operator's number for the
// second table on srv1 is 26.8 GiB. But the image shares the PLE table only when the installed vLLM
// carries VLLM_PLE_SHARED_TABLE_DIR, which this build does not, so even a repaired REPLICAS=2 keeps one
// copy per replica (launcher.py sets ple_copy_per_replica = True and warns). The saving therefore needs
// BOTH fixes, and the second one is a vLLM capability the image lacks — recorded here so the row is not
// read as "fix the connector and 26.8 GiB is recovered."
data lil_replica_ple_saving_note: NonEmptyStr = "repairing the LMCache checkpoint-DMA crash alone does not share the PLE table: this image lacks VLLM_PLE_SHARED_TABLE_DIR, so launcher.py keeps ple_copy_per_replica = True and warns 'about 27 GiB each' per replica (operator's number for the second replica's PLE table on srv1: 26.8 GiB). The 26.8 GiB is saved only once both the checkpoint-DMA crash and the shared-PLE-table support are present." as NonEmptyStr

data lil_serving_defects_frontier: DissolutionCondition = unbound_dissolution(
  description: "gunbc.design_argument::consumption: the srv1_lil_serving_defect_rows are read by test.claim.extdeps.lil_serving_defects_witness (each row's verbatim error substring) and are the receipts the F24-F26 upstream drafts cite. Declared frontier, trigger: when a newer lil image build is run at srv1, re-read the launcher and replica_proxy source and the container log; a row whose exact_error no longer appears on the new build is retired to history (and its upstream issue, once opened by the operator, is linked rather than restated)." as NonEmptyStr
)
