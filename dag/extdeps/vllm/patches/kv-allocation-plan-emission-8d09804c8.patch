 _R = TypeVar("_R")  # Return type for collective_rpc
 
+# Stable marker for the startup allocation-plan line. A capture route keys on
+# this substring, not on a line number or the log prefix around it.
+KV_ALLOCATION_PLAN_LOG_MARKER = "KV_ALLOCATION_PLAN_JSON "
+
+
+def _build_kv_allocation_plan_record(
+    vllm_config: VllmConfig,
+    scheduler_kv_cache_config: KVCacheConfig,
+) -> dict[str, Any]:
+    """Build the resolved KV allocation plan record.
+
+    Introspection only: every figure is read from the scheduler's resolved
+    config or computed with the engine's own spec methods, so the record
+    reproduces the startup capacity print by construction.
+    """
+    groups: list[dict[str, Any]] = []
+    for group_idx, group in enumerate(scheduler_kv_cache_config.kv_cache_groups):
+        spec = group.kv_cache_spec
+        max_usage = spec.max_memory_usage_bytes(vllm_config)
+        page_bytes = spec.page_size_bytes
+        tokens_per_state = spec.tokens_per_state
+        if not isinstance(tokens_per_state, int) or tokens_per_state <= 0:
+            # Mamba recurrent state is not token-keyed; the engine's
+            # get_num_kernel_states charges one state per block, and the plan
+            # carries that per-sequence unit count.
+            tokens_per_state = 1
+        groups.append(
+            {
+                "identity": f"group-{group_idx}:{get_kv_cache_spec_kind(spec).value}",
+                "kind": get_kv_cache_spec_kind(spec).value,
+                "layer_identities": list(group.layer_names),
+                "block_size": spec.block_size,
+                "page_size_bytes": page_bytes,
+                "tokens_per_state": tokens_per_state,
+                "sliding_window": getattr(spec, "sliding_window", None),
+                "max_memory_usage_bytes": max_usage,
+                "blocks_at_requested_length": (
+                    cdiv(max_usage, page_bytes) if page_bytes > 0 else 0
+                ),
+            }
+        )
+
+    padding_notes = []
+    for group in scheduler_kv_cache_config.kv_cache_groups:
+        spec = group.kv_cache_spec
+        unpadded = getattr(spec, "unpadded_page_size_bytes", None)
+        padded = getattr(spec, "page_size_padded", None)
+        if unpadded is not None and padded is not None and padded != unpadded:
+            padding_notes.append(f"{unpadded}->{padded}B")
+    total_layers = sum(
+        len(group.layer_names)
+        for group in scheduler_kv_cache_config.kv_cache_groups
+    )
+    padding_text = "; ".join(padding_notes) if padding_notes else "none"
+    grouping_padding = (
+        f"{len(groups)} cache groups, one block table per group; "
+        f"{total_layers} layers rostered; page-size padding: {padding_text}"
+    )
+
+    return {
+        "schema": "kv-allocation-plan/v1",
+        "runtime": {"package_version": VLLM_VERSION},
+        "engine_dp_rank": vllm_config.parallel_config.data_parallel_rank,
+        "image_digest": envs.VLLM_KV_ALLOCATION_PLAN_IMAGE_DIGEST,
+        "cache_format": str(vllm_config.cache_config.cache_dtype),
+        "allocator_blocks": scheduler_kv_cache_config.num_blocks,
+        "requested_length": vllm_config.model_config.max_model_len,
+        "scheduler_block_size": vllm_config.cache_config.block_size,
+        "groups": groups,
+        "grouping_padding": grouping_padding,
+    }
+
+
+def _emit_kv_allocation_plan(
+    vllm_config: VllmConfig,
+    scheduler_kv_cache_config: KVCacheConfig,
+) -> None:
+    """Emit the plan once per engine at startup; failures never gate serving."""
+    try:
+        record = _build_kv_allocation_plan_record(
+            vllm_config, scheduler_kv_cache_config
+        )
+    except Exception:
+        logger.exception("Failed to build the KV allocation plan record")
+        return
+    line = json.dumps(record, sort_keys=True, separators=(",", ":"))
+    logger.info("%s%s", KV_ALLOCATION_PLAN_LOG_MARKER, line)
+    path = envs.VLLM_KV_ALLOCATION_PLAN_PATH
+    if path:
+        try:
+            tmp_path = f"{path}.tmp"
+            with open(tmp_path, "w", encoding="utf-8") as f:
+                f.write(line)
+                f.write("\n")
+            os.replace(tmp_path, path)
+        except OSError:
+            logger.exception("Failed to write the KV allocation plan to %s", path)
+
 
 class EngineCore:
     """Inner loop of vLLM's Engine."""
