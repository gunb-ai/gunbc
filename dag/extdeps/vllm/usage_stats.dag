module extdeps.vllm.usage_stats

import v2.std.optional { Present, Absent }
import std.types { NonEmptyStr, List, String }
import std.decl_ref { DeclarationRef, WholeDeclaration }
import extdeps.external_authority { ExternalAuthority, ExternalModelScope, ExternalSubjectRef }
import extdeps.uri { Uri, Https }
import extdeps.vllm.server { VllmSourceRevision, vllm_source_revision_read }

data extdeps_external_authority_anchor: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "docs.vllm.ai/en/latest/usage/usage_stats.html"
  }
}

data vllm_usage_stats_source_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/vllm-project/vllm/blob/main/vllm/usage/usage_lib.py"
  }
}

data vllm_usage_stats_server_default_citation: ExternalAuthority = ExternalAuthority {
  uri: Uri {
    scheme: Https
    locator: "github.com/vllm-project/vllm/blob/main/vllm/envs.py"
  }
}

data extdeps_model_scope: ExternalModelScope = ExternalModelScope {
  subject: ExternalSubjectRef {
    declaration: DeclarationRef {
      module_path: "extdeps.vllm.usage_stats",
      decl_name: "VllmUsageStatsReporting",
      field: WholeDeclaration
    }
  },
  first_citation: extdeps_external_authority_anchor,
  further_citations: [vllm_usage_stats_source_citation, vllm_usage_stats_server_default_citation]
}

// ── THE ONE THING A vLLM SERVER SENDS OFF THE BOX BY DEFAULT ──────────────────────────────────
//
// WHY THIS MODULE EXISTS. Every other fact about our serving route says the material stays where
// the machine is. This is the exception, and it is an exception nobody in this repository had
// written down: vLLM reports usage statistics to an upstream service unless it is switched off, and
// nothing on the Spark serving launch switches it off. A data-path closure that answered "the
// operator's site" for telemetry would have been false about the one path that demonstrably leaves
// it -- and false in the direction that reads as clean.
//
// WHAT IT IS NOT. It is not a leak of route material. The documented payload is configuration and
// hardware metadata; upstream is explicit that request content, prompts and completions are not
// collected, and the field roster below carries no field derived from a request. That distinction
// is the whole reason a consumer can admit this path rather than refuse it, so it is modelled as a
// TYPED CONTENT CLASS rather than asserted in a sentence.
//
// REVISION-BOUND, like every other reading of this upstream. The roster is what upstream documents
// at the cited revision; a later revision that adds a field is a different fact, and the binding to
// vllm_source_revision_read is what makes that decidable instead of a surprise.

// THE TWO CLASSES ARE SEPARATE BECAUSE THEY AUTHORIZE DIFFERENT THINGS. A metadata-only egress can
// support an admission for a route whose material stays home; an egress carrying any request
// material cannot, and would have to refuse rather than be argued about. There is deliberately no
// "probably fine" arm.
type VllmUsageStatsContentClass
  = ConfigurationAndHardwareMetadataOnly
  | CarriesRequestMaterial

// THE DESTINATION IS A THIRD PARTY, AND ITS JURISDICTION IS NOT DOCUMENTED. Upstream publishes the
// default server and nothing about who operates it or under which legal system, so the jurisdiction
// is an UNREAD upstream fact rather than one this module may supply. It is a typed arm rather than
// a missing field for the reason this whole repository keeps repeating: an absent jurisdiction and
// a jurisdiction nobody looked up must not be the same value, and a consumer that needs one must be
// able to see that it does not exist here.
type VllmUsageStatsServiceJurisdiction
  = ServiceJurisdictionDocumented { jurisdiction: NonEmptyStr }
  | ServiceJurisdictionUndocumentedUpstream

// ── HOW UPSTREAM READS THE DISABLE VARIABLES, WHICH IS NOT "IS IT SET" ────────────────────────
//
// THE NAMES ALONE WERE NOT THE FACT, and modelling only the names pushed the reading into the
// consumer, where it was authored rather than cited: gunbc asked whether an assignment's value was
// anything other than "0", and upstream asks whether it EQUALS "1"
// (os.environ.get("VLLM_NO_USAGE_STATS", "0") == "1", and DO_NOT_TRACK the same way, in envs.py).
// Those disagree on VLLM_NO_USAGE_STATS=false, =no, =0.0 and every other spelling a person would
// expect to mean off: upstream keeps reporting and the consumer read "disabled" -- the admitting
// direction, on a launch that is still sending (review 64043).
//
// So the reading lives here, once, with the names it belongs to. A term is a variable AND the exact
// value that disables it, because separating them is what let the pair be recombined wrongly.
type VllmUsageStatsDisableTerm {
  variable: NonEmptyStr
  disabling_value: NonEmptyStr
}

// EXACT EQUALITY ON BOTH COMPONENTS, because that is what upstream performs. There is deliberately
// no truthiness, no case folding and no "anything non-empty": each of those is a consumer's guess
// about a reading this module can state.
//
// THE NAMED CONSUMER. gunbc.spark.serving_usage_stats_observe spark_serving_usage_stats_from_inspect
// feeds this predicate the three projected names from a running-container inspect. The exact-equality
// semantics of envs.py stay here (review 64043).
fn vllm_usage_stats_assignment_disables(term: VllmUsageStatsDisableTerm, name: NonEmptyStr, value: String) -> Bool {
  (name as String) == (term.variable as String) && value == (term.disabling_value as String)
}

type VllmUsageStatsReporting sole_constructor {
  default_server: NonEmptyStr
  server_override_env: NonEmptyStr
  local_copy_path: NonEmptyStr
  content_class: VllmUsageStatsContentClass
  service_jurisdiction: VllmUsageStatsServiceJurisdiction
  collected_fields: List<NonEmptyStr>
  disable_terms: List<VllmUsageStatsDisableTerm>
  vllm_do_not_track_env: NonEmptyStr
  do_not_track_fallback_env: NonEmptyStr
  disable_marker_path: NonEmptyStr
  established_against: VllmSourceRevision
}

// THE ROSTER IS THE DOCUMENTED EXAMPLE PAYLOAD, transcribed as the field NAMES upstream publishes.
// Every one of them is a property of the host, the build or the engine configuration; none is
// derived from a request, which is what the content class above records and what a reader can check
// here rather than take on faith.
data vllm_usage_stats_reporting: VllmUsageStatsReporting = VllmUsageStatsReporting {
  default_server: "https://stats.vllm.ai",
  server_override_env: "VLLM_USAGE_STATS_SERVER",
  local_copy_path: "~/.config/vllm/usage_stats.json",
  content_class: ConfigurationAndHardwareMetadataOnly,
  service_jurisdiction: ServiceJurisdictionUndocumentedUpstream,
  collected_fields: [
    "uuid", "provider", "num_cpu", "cpu_type", "cpu_family_model_stepping",
    "total_memory", "architecture", "platform", "gpu_count", "gpu_type",
    "gpu_memory_per_device", "model_architecture", "vllm_version", "context",
    "log_time", "source", "dtype", "tensor_parallel_size", "block_size",
    "gpu_memory_utilization", "quantization", "kv_cache_dtype", "enable_lora",
    "enable_prefix_caching", "enforce_eager", "disable_custom_all_reduce",
  ],
  disable_terms: [
    VllmUsageStatsDisableTerm { variable: "VLLM_NO_USAGE_STATS", disabling_value: "1" },
  ],
  vllm_do_not_track_env: "VLLM_DO_NOT_TRACK",
  do_not_track_fallback_env: "DO_NOT_TRACK",
  disable_marker_path: "~/.config/vllm/do_not_track",
  established_against: vllm_source_revision_read,
}

// THE THIRD TERM OF UPSTREAM'S DISJUNCTION IS THE MARKER FILE. InspectServingContainer does not
// authorize a filesystem read of disable_marker_path. Unread marker is therefore Unread standing,
// never an authored "enabled" default: upstream is
// `_USAGE_STATS_ENABLED = not (do_not_track or no_usage_stats or do_not_track_file)` at
// vllm_source_revision_read (vllm/usage/usage_lib.py). Treating unread-as-absent would admit.
//
// DO_NOT_TRACK IS NOT AN INDEPENDENT TERM. At that same revision, envs.py computes
// `VLLM_DO_NOT_TRACK = (os.environ.get("VLLM_DO_NOT_TRACK") or os.environ.get("DO_NOT_TRACK") or "0") == "1"`.
// Python `or` skips only unset and empty, so VLLM_DO_NOT_TRACK=0 with DO_NOT_TRACK=1 stays enabled.
// VLLM_NO_USAGE_STATS remains an independent exact-equality term (`== "1"`).
//
// VLLM_USAGE_STATS_SERVER: os.environ.get's default applies only when the name is unset. A present
// empty string stays empty and is not the default server.

data vllm_usage_stats_empty_server_cause: NonEmptyStr = "VLLM_USAGE_STATS_SERVER is present and empty; os.environ.get's default applies only when the name is unset (extdeps.vllm.usage_stats, vllm/envs.py at vllm_source_revision_read)" as NonEmptyStr

type VllmDoNotTrackMarkerStanding
  = DoNotTrackMarkerPresent
  | DoNotTrackMarkerAbsent
  | DoNotTrackMarkerUnread { obligation: NonEmptyStr }

type VllmUsageStatsEnvAssignment {
  name: NonEmptyStr
  value: String
}

type VllmUsageStatsLaunchStanding
  = UsageStatsDisabledByLaunch { mechanism: NonEmptyStr }
  | UsageStatsEnabledByDefault { basis: NonEmptyStr, destination: NonEmptyStr }
  | UsageStatsLaunchUnread { obligation: NonEmptyStr }
  | UsageStatsEnvMalformed { cause: NonEmptyStr }

fn vllm_usage_stats_inspect_env_names() -> List<NonEmptyStr> {
  append(
    append(
      append(
        map(vllm_usage_stats_reporting.disable_terms, t => t.variable),
        items: [vllm_usage_stats_reporting.vllm_do_not_track_env],
      ),
      items: [vllm_usage_stats_reporting.do_not_track_fallback_env],
    ),
    items: [vllm_usage_stats_reporting.server_override_env],
  )
}

fn vllm_usage_stats_named_value(assignments: List<VllmUsageStatsEnvAssignment>, name: NonEmptyStr) -> String? {
  fold(assignments, init: none, f: (acc, a) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        if (a.name as String) == (name as String) {
          Present { value: a.value }
        } else {
          none
        }
    })
}

fn vllm_usage_stats_python_or_env(first: String?, second: String?) -> String {
  match first {
    Present { value: a } =>
      if a.length() == 0 {
        match second {
          Present { value: b } => if b.length() == 0 { "0" } else { b }
          Absent => "0"
        }
      } else {
        a
      }
    Absent =>
      match second {
        Present { value: b } => if b.length() == 0 { "0" } else { b }
        Absent => "0"
      }
  }
}

fn vllm_usage_stats_do_not_track_mechanism(
  assignments: List<VllmUsageStatsEnvAssignment>,
) -> NonEmptyStr? {
  let primary = vllm_usage_stats_named_value(
    assignments: assignments,
    name: vllm_usage_stats_reporting.vllm_do_not_track_env,
  )
  let fallback = vllm_usage_stats_named_value(
    assignments: assignments,
    name: vllm_usage_stats_reporting.do_not_track_fallback_env,
  )
  if vllm_usage_stats_python_or_env(first: primary, second: fallback) == "1" {
    match primary {
      Present { value: a } =>
        if a.length() == 0 {
          Present { value: vllm_usage_stats_reporting.do_not_track_fallback_env }
        } else {
          Present { value: vllm_usage_stats_reporting.vllm_do_not_track_env }
        }
      Absent =>
        Present { value: vllm_usage_stats_reporting.do_not_track_fallback_env }
    }
  } else {
    none
  }
}

fn vllm_usage_stats_term_disables_from_assignments(
  terms: List<VllmUsageStatsDisableTerm>,
  assignments: List<VllmUsageStatsEnvAssignment>,
) -> NonEmptyStr? {
  fold(terms, init: none, f: (acc, term) =>
    match acc {
      Present { value: _ } => acc
      Absent =>
        match vllm_usage_stats_named_value(assignments: assignments, name: term.variable) {
          Absent => none
          Present { value: v } =>
            if vllm_usage_stats_assignment_disables(term: term, name: term.variable, value: v) {
              Present { value: term.variable }
            } else {
              none
            }
        }
    })
}

fn vllm_usage_stats_disable_mechanism_from_assignments(
  assignments: List<VllmUsageStatsEnvAssignment>,
) -> NonEmptyStr? {
  match vllm_usage_stats_term_disables_from_assignments(
    terms: vllm_usage_stats_reporting.disable_terms,
    assignments: assignments,
  ) {
    Present { value: m } => Present { value: m }
    Absent => vllm_usage_stats_do_not_track_mechanism(assignments: assignments)
  }
}

fn vllm_usage_stats_standing_from_effective_config(
  assignments: List<VllmUsageStatsEnvAssignment>,
  marker: VllmDoNotTrackMarkerStanding,
) -> VllmUsageStatsLaunchStanding {
  match vllm_usage_stats_disable_mechanism_from_assignments(assignments: assignments) {
    Present { value: mechanism } =>
      UsageStatsDisabledByLaunch { mechanism: mechanism }
    Absent =>
      match marker {
        DoNotTrackMarkerPresent =>
          UsageStatsDisabledByLaunch { mechanism: vllm_usage_stats_reporting.disable_marker_path }
        DoNotTrackMarkerUnread { obligation: o } =>
          UsageStatsLaunchUnread { obligation: o }
        DoNotTrackMarkerAbsent =>
          match vllm_usage_stats_named_value(
            assignments: assignments,
            name: vllm_usage_stats_reporting.server_override_env,
          ) {
            Present { value: v } =>
              if v.length() == 0 {
                UsageStatsEnvMalformed { cause: vllm_usage_stats_empty_server_cause }
              } else {
                UsageStatsEnabledByDefault {
                  basis: "no disable term equals 1 and the do-not-track marker is absent" as NonEmptyStr,
                  destination: v as NonEmptyStr,
                }
              }
            Absent =>
              UsageStatsEnabledByDefault {
                basis: "no disable term equals 1 and the do-not-track marker is absent" as NonEmptyStr,
                destination: vllm_usage_stats_reporting.default_server,
              }
          }
      }
  }
}
